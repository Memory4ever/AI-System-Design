77.58 -137.8"></path><g stroke-dasharray="none" stroke-dashoffset="0.0pt" stroke-linecap="round" stroke-linejoin="round" stroke-width="0.8pt" transform="matrix(1.0 0.0 0.0 1.0 77.58 -137.8)"><path style="fill:none" d="M -2.41 3.21 C -2.21 2.01 0 0.2 0.6 0 C 0 -0.2 -2.21 -2.01 -2.41 -3.21"></path></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 -17.89 -141.18)"><foreignObject style="--ltx-fo-width:2.03em;--ltx-fo-height:0.68em;--ltx-fo-depth:0.19em;font-size:10pt;" height="12.15" overflow="visible" transform="matrix(1 0 0 -1 0 9.46)" width="28.06"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><span id="S2.F1.sf2.pic1.15" class="ltx_text">Key:</span></span></span></foreignObject></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 18.35 -130.42)"><foreignObject style="--ltx-fo-width:5.88em;--ltx-fo-height:0.68em;--ltx-fo-depth:0em;font-size:10pt;" height="9.46" overflow="visible" transform="matrix(1 0 0 -1 0 9.46)" width="81.41"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><span id="S2.F1.sf2.pic1.16" class="ltx_text">Deterministic</span></span></span></foreignObject></g></g><g stroke-width="1.0pt"><path style="fill:none" d="M 137.8 -137.8 C 151.09 -130.12 163.87 -145.47 176.16 -138.37"></path><g stroke-dasharray="none" stroke-dashoffset="0.0pt" stroke-linecap="round" stroke-linejoin="round" stroke-width="0.8pt" transform="matrix(0.86603 0.5 -0.5 0.86603 176.16 -138.37)"><path style="fill:none" d="M -2.41 3.21 C -2.21 2.01 0 0.2 0.6 0 C 0 -0.2 -2.21 -2.01 -2.41 -3.21"></path></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 126.69 -130.42)"><foreignObject style="--ltx-fo-width:4.45em;--ltx-fo-height:0.69em;--ltx-fo-depth:0em;font-size:10pt;" height="9.61" overflow="visible" transform="matrix(1 0 0 -1 0 9.61)" width="61.58"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><span id="S2.F1.sf2.pic1.17" class="ltx_text">Stochastic</span></span></span></foreignObject></g></g><g stroke-width="1.0pt"><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#EBEBFF;" fill="#EBEBFF" stroke="#000000"><path style="fill:none" d="M -22.51 -148.48 h 215.39 v 32.28 h -215.39 Z"></path></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 -22.51 -132.34)"><foreignObject style="--ltx-fo-width:15.57em;--ltx-fo-height:0em;--ltx-fo-depth:0em;font-size:10pt;" height="0" overflow="visible" transform="matrix(1 0 0 -1 0 0)" width="215.44"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content">
<span id="S2.F1.sf2.pic1.18" class="ltx_inline-block ltx_minipage ltx_align_top" style="width:15.57em;">
<span id="S2.F1.sf2.pic1.18.1" class="ltx_p"></span>
</span></span></span></foreignObject></g></g></g></g></svg></span>
</span></div>
<figcaption class="ltx_caption ltx_centering"><span class="ltx_tag ltx_tag_figure"><span id="S2.F1.sf2.4" class="ltx_text" style="font-size:90%;">(b)</span> </span></figcaption>
</figure></div></div>
<figcaption class="ltx_caption ltx_centering"><span class="ltx_tag ltx_tag_figure"><span id="S2.F1.5" class="ltx_text" style="font-size:90%;">Figure 1</span>: </span><span id="S2.F1.6" class="ltx_text ltx_font_bold" style="font-size:90%;">(a):<span id="S2.F1.6.1" class="ltx_text ltx_font_medium"> Illustration of unfolded optimization architecture. The parameters <math id="S2.F1.m7" class="ltx_Math" alttext="\theta,\vartheta_{0},\dots,\vartheta_{L}" display="inline" intent=":literal"><semantics><mrow><mi>θ</mi><mo>,</mo><msub><mi>ϑ</mi><mn>0</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>ϑ</mi><mi>L</mi></msub></mrow><annotation encoding="application/x-tex">\theta,\vartheta_{0},\dots,\vartheta_{L}</annotation></semantics></math> are trained end-to-end such that the output samples from layers <math id="S2.F1.m8" class="ltx_Math" alttext="\hat{x}_{L}" display="inline" intent=":literal"><semantics><msub><mover accent="true"><mi>x</mi><mo mathsize="1.110em">^</mo></mover><mi>L</mi></msub><annotation encoding="application/x-tex">\hat{x}_{L}</annotation></semantics></math> is a close approximation of <math id="S2.F1.m9" class="ltx_Math" alttext="\mathbb{E}[x|y]" display="inline" intent=":literal"><semantics><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><mi>x</mi><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>y</mi></mrow><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">\mathbb{E}[x|y]</annotation></semantics></math>. </span>(b):<span id="S2.F1.6.2" class="ltx_text ltx_font_medium"> Illustration of the proposed unfolded MCMC architecture. Parameters <math id="S2.F1.m10" class="ltx_Math" alttext="\theta,\vartheta_{0},\dots,\vartheta_{L}" display="inline" intent=":literal"><semantics><mrow><mi>θ</mi><mo>,</mo><msub><mi>ϑ</mi><mn>0</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>ϑ</mi><mi>L</mi></msub></mrow><annotation encoding="application/x-tex">\theta,\vartheta_{0},\dots,\vartheta_{L}</annotation></semantics></math> are trained end-to-end such that the output samples from layers <math id="S2.F1.m11" class="ltx_Math" alttext="\ell\geq L_{0}" display="inline" intent=":literal"><semantics><mrow><mi mathvariant="normal">ℓ</mi><mo>≥</mo><msub><mi>L</mi><mn>0</mn></msub></mrow><annotation encoding="application/x-tex">\ell\geq L_{0}</annotation></semantics></math> closely resemble <math id="S2.F1.m12" class="ltx_Math" alttext="p(x|y)" display="inline" intent=":literal"><semantics><mrow><mi>p</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo lspace="0em" rspace="0em">|</mo><mi>y</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">p(x|y)</annotation></semantics></math> over a training dataset.</span></span></figcaption>
</figure>
</section>
<section id="S2.SS2" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">2.2 </span>Data-Driven Priors</h3>

<div id="S2.SS2.p1" class="ltx_para">
<p id="S2.SS2.p1.1" class="ltx_p">Recent developments in machine learning propose several approaches for modelling data-driven priors. In this work, we consider both plug-and-play denoisers and score based techniques, which are summarised below.
Plug-and-play (PnP) techniques relate the score <math id="S2.SS2.p1.m1" class="ltx_Math" alttext="\nabla\log p_{\theta}" display="inline" intent=":literal"><semantics><mrow><mrow><mo rspace="0.167em">∇</mo><mi>log</mi></mrow><mo lspace="0.167em">⁡</mo><msub><mi>p</mi><mi>θ</mi></msub></mrow><annotation encoding="application/x-tex">\nabla\log p_{\theta}</annotation></semantics></math> to a minimum-mean-square-error (MMSE) denoiser. Introducing <math id="S2.SS2.p1.m2" class="ltx_Math" alttext="\varepsilon\ll 1" display="inline" intent=":literal"><semantics><mrow><mi>ε</mi><mo>≪</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">\varepsilon\ll 1</annotation></semantics></math>, Tweedie’s identity <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib47" title="" class="ltx_ref">14</a>]</cite> approximates the score <math id="S2.SS2.p1.m3" class="ltx_Math" alttext="\nabla_{x}\log p(x)\approx(D_{\varepsilon}(x)-x)/\varepsilon" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mo>∇</mo><mi>x</mi></msub><mo lspace="0.167em" rspace="0em">​</mo><mi>log</mi><mo lspace="0.167em" rspace="0em">​</mo><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo>≈</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mrow><msub><mi>D</mi><mi>ε</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mi>x</mi></mrow><mo stretchy="false">)</mo></mrow><mo>/</mo><mi>ε</mi></mrow></mrow><annotation encoding="application/x-tex">\nabla_{x}\log p(x)\approx(D_{\varepsilon}(x)-x)/\varepsilon</annotation></semantics></math>, where <math id="S2.SS2.p1.m4" class="ltx_math_unparsed" alttext="D_{\varepsilon}(z)=\mathbb{E}_{{\mathbf{x}}\sim p(x)}[{\mathbf{x}}|\{{\mathbf{z}}=z\}]" display="inline" intent=":literal"><semantics><mrow><msub><mi>D</mi><mi>ε</mi></msub><mrow><mo stretchy="false">(</mo><mi>z</mi><mo stretchy="false">)</mo></mrow><mo>=</mo><msub><mi>𝔼</mi><mrow><mi>𝐱</mi><mo>∼</mo><mrow><mi>p</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></msub><mrow><mo stretchy="false">[</mo><mi>𝐱</mi><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mrow><mo stretchy="false">{</mo><mi>𝐳</mi><mo>=</mo><mi>z</mi><mo stretchy="false">}</mo></mrow><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">D_{\varepsilon}(z)=\mathbb{E}_{{\mathbf{x}}\sim p(x)}[{\mathbf{x}}|\{{\mathbf{z}}=z\}]</annotation></semantics></math> is a minimum-mean-square error (MMSE) denoiser of <math id="S2.SS2.p1.m5" class="ltx_Math" alttext="{\mathbf{z}}\sim\mathcal{N}({\mathbf{x}},\varepsilon I)" display="inline" intent=":literal"><semantics><mrow><mi>𝐳</mi><mo>∼</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒩</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝐱</mi><mo>,</mo><mrow><mi>ε</mi><mo lspace="0em" rspace="0em">​</mo><mi>I</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">{\mathbf{z}}\sim\mathcal{N}({\mathbf{x}},\varepsilon I)</annotation></semantics></math>. For structured data-distributions, <math id="S2.SS2.p1.m6" class="ltx_Math" alttext="D_{\varepsilon}" display="inline" intent=":literal"><semantics><msub><mi>D</mi><mi>ε</mi></msub><annotation encoding="application/x-tex">D_{\varepsilon}</annotation></semantics></math> can be well-approximated by a deep networks <math id="S2.SS2.p1.m7" class="ltx_Math" alttext="D_{\varepsilon,\theta}" display="inline" intent=":literal"><semantics><msub><mi>D</mi><mrow><mi>ε</mi><mo>,</mo><mi>θ</mi></mrow></msub><annotation encoding="application/x-tex">D_{\varepsilon,\theta}</annotation></semantics></math> such as a convex ridge-regulariser <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib35" title="" class="ltx_ref">17</a>]</cite>, CNN <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib40" title="" class="ltx_ref">61</a>, <a href="#bib.bib41" title="" class="ltx_ref">67</a>]</cite> or DRUNET <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib71" title="" class="ltx_ref">66</a>]</cite>. The weights <math id="S2.SS2.p1.m8" class="ltx_Math" alttext="\theta" display="inline" intent=":literal"><semantics><mi>θ</mi><annotation encoding="application/x-tex">\theta</annotation></semantics></math> are trained to minimise the mean-square loss over data <math id="S2.SS2.p1.m9" class="ltx_Math" alttext="\mathcal{X}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">𝒳</mi><annotation encoding="application/x-tex">\mathcal{X}</annotation></semantics></math></p>
<table id="S2.E4" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S2.E4.m1" class="ltx_Math" alttext="\theta^{\star}=\argmin_{\theta}\mathbb{E}_{{\mathbf{x}}\sim p(x),{\mathbf{w}}\sim\mathcal{N}(0,1)}\Big[\big\|{\mathbf{x}}-D_{\varepsilon,\theta}({\mathbf{x}}+\sqrt{\varepsilon}{\mathbf{w}})\big\|^{2}\Big]." display="block" intent=":literal"><semantics><mrow><mrow><msup><mi>θ</mi><mo>⋆</mo></msup><mo>=</mo><mrow><mrow><msub><mrow><mi>arg</mi><mo lspace="0.170em" rspace="0em">​</mo><mi>min</mi></mrow><mi>θ</mi></msub><mo>⁡</mo><msub><mi>𝔼</mi><mrow><mrow><mi>𝐱</mi><mo>∼</mo><mrow><mi>p</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>,</mo><mrow><mi>𝐰</mi><mo>∼</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒩</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mn>0</mn><mo>,</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="1.600em" minsize="1.600em">[</mo><msup><mrow><mo maxsize="1.200em" minsize="1.200em" stretchy="true">‖</mo><mrow><mi>𝐱</mi><mo>−</mo><mrow><msub><mi>D</mi><mrow><mi>ε</mi><mo>,</mo><mi>θ</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>𝐱</mi><mo>+</mo><mrow><msqrt><mi>ε</mi></msqrt><mo lspace="0em" rspace="0em">​</mo><mi>𝐰</mi></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo maxsize="1.200em" minsize="1.200em" stretchy="true">‖</mo></mrow><mn>2</mn></msup><mo maxsize="1.600em" minsize="1.600em">]</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\theta^{\star}=\argmin_{\theta}\mathbb{E}_{{\mathbf{x}}\sim p(x),{\mathbf{w}}\sim\mathcal{N}(0,1)}\Big[\big\|{\mathbf{x}}-D_{\varepsilon,\theta}({\mathbf{x}}+\sqrt{\varepsilon}{\mathbf{w}})\big\|^{2}\Big].</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(4)</span></td></tr></tbody>
</table>
<p id="S2.SS2.p1.2" class="ltx_p">This provides an implicit representation of <math id="S2.SS2.p1.m10" class="ltx_Math" alttext="p_{\theta}" display="inline" intent=":literal"><semantics><msub><mi>p</mi><mi>θ</mi></msub><annotation encoding="application/x-tex">p_{\theta}</annotation></semantics></math> by estimating the score, which can be combined within gradient-based optimization/MCMC pipelines.</p>
</div>
</section>
<section id="S2.SS3" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">2.3 </span>Optimization Schemes and Deep Unfolding</h3>

<div id="S2.SS3.p1" class="ltx_para">
<p id="S2.SS3.p1.1" class="ltx_p">Optimization methods can be used to seek a maximiser <math id="S2.SS3.p1.m1" class="ltx_Math" alttext="\hat{x}_{\text{MAP}}" display="inline" intent=":literal"><semantics><msub><mover accent="true"><mi>x</mi><mo>^</mo></mover><mtext>MAP</mtext></msub><annotation encoding="application/x-tex">\hat{x}_{\text{MAP}}</annotation></semantics></math> of <math id="S2.SS3.p1.m2" class="ltx_Math" alttext="\pi_{\theta}(x|y)" display="inline" intent=":literal"><semantics><mrow><msub><mi>π</mi><mi>θ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo lspace="0em" rspace="0em">|</mo><mi>y</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\pi_{\theta}(x|y)</annotation></semantics></math>. A broad class of explicit numerical optimization methods can be expressed through a recurrence of the form</p>
<table id="S2.E5" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S2.E5.m1" class="ltx_Math" alttext="\hat{x}_{\ell+1}=G_{\ell,\vartheta_{\ell},\theta}(\hat{x}_{\ell};y),\qquad\ell\in\mathbb{N}," display="block" intent=":literal"><semantics><mrow><mrow><mrow><msub><mover accent="true"><mi>x</mi><mo>^</mo></mover><mrow><mi mathvariant="normal">ℓ</mi><mo>+</mo><mn>1</mn></mrow></msub><mo>=</mo><mrow><msub><mi>G</mi><mrow><mi mathvariant="normal">ℓ</mi><mo>,</mo><msub><mi>ϑ</mi><mi mathvariant="normal">ℓ</mi></msub><mo>,</mo><mi>θ</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi>x</mi><mo>^</mo></mover><mi mathvariant="normal">ℓ</mi></msub><mo>,</mo><mi>y</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo rspace="2.167em">,</mo><mrow><mi mathvariant="normal">ℓ</mi><mo>∈</mo><mi>ℕ</mi></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\hat{x}_{\ell+1}=G_{\ell,\vartheta_{\ell},\theta}(\hat{x}_{\ell};y),\qquad\ell\in\mathbb{N},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(5)</span></td></tr></tbody>
</table>
<p id="S2.SS3.p1.2" class="ltx_p">with transitions <math id="S2.SS3.p1.m3" class="ltx_Math" alttext="G_{\ell,\vartheta_{\ell},\theta}:\mathbb{R}^{d_{x}}\times\mathbb{R}^{{d_{y}}}\to\mathbb{R}^{d_{x}}" display="inline" intent=":literal"><semantics><mrow><msub><mi>G</mi><mrow><mi mathvariant="normal">ℓ</mi><mo>,</mo><msub><mi>ϑ</mi><mi mathvariant="normal">ℓ</mi></msub><mo>,</mo><mi>θ</mi></mrow></msub><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mrow><msup><mi>ℝ</mi><msub><mi>d</mi><mi>x</mi></msub></msup><mo lspace="0.222em" rspace="0.222em">×</mo><msup><mi>ℝ</mi><msub><mi>d</mi><mi>y</mi></msub></msup></mrow><mo stretchy="false">→</mo><msup><mi>ℝ</mi><msub><mi>d</mi><mi>x</mi></msub></msup></mrow></mrow><annotation encoding="application/x-tex">G_{\ell,\vartheta_{\ell},\theta}:\mathbb{R}^{d_{x}}\times\mathbb{R}^{{d_{y}}}\to\mathbb{R}^{d_{x}}</annotation></semantics></math> at iteration <math id="S2.SS3.p1.m4" class="ltx_Math" alttext="\ell&gt;0" display="inline" intent=":literal"><semantics><mrow><mi mathvariant="normal">ℓ</mi><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\ell&gt;0</annotation></semantics></math> and an initialization <math id="S2.SS3.p1.m5" class="ltx_Math" alttext="G_{0,\vartheta_{0},\theta}:\mathbb{R}^{{d_{y}}}\to\mathbb{R}^{d_{x}}" display="inline" intent=":literal"><semantics><mrow><msub><mi>G</mi><mrow><mn>0</mn><mo>,</mo><msub><mi>ϑ</mi><mn>0</mn></msub><mo>,</mo><mi>θ</mi></mrow></msub><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><msup><mi>ℝ</mi><msub><mi>d</mi><mi>y</mi></msub></msup><mo stretchy="false">→</mo><msup><mi>ℝ</mi><msub><mi>d</mi><mi>x</mi></msub></msup></mrow></mrow><annotation encoding="application/x-tex">G_{0,\vartheta_{0},\theta}:\mathbb{R}^{{d_{y}}}\to\mathbb{R}^{d_{x}}</annotation></semantics></math> for <math id="S2.SS3.p1.m6" class="ltx_Math" alttext="\ell=0" display="inline" intent=":literal"><semantics><mrow><mi mathvariant="normal">ℓ</mi><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\ell=0</annotation></semantics></math>. The transitions <math id="S2.SS3.p1.m7" class="ltx_Math" alttext="G_{\ell,\vartheta_{\ell},\theta}" display="inline" intent=":literal"><semantics><msub><mi>G</mi><mrow><mi mathvariant="normal">ℓ</mi><mo>,</mo><msub><mi>ϑ</mi><mi mathvariant="normal">ℓ</mi></msub><mo>,</mo><mi>θ</mi></mrow></msub><annotation encoding="application/x-tex">G_{\ell,\vartheta_{\ell},\theta}</annotation></semantics></math> often arise naturally as a discretisation of the gradient flow <math id="S2.SS3.p1.m8" class="ltx_Math" alttext="x^{\prime}(t)=-\nabla_{x}(f_{y}(x)+g_{\theta}(x))" display="inline" intent=":literal"><semantics><mrow><mrow><msup><mi>x</mi><mo>′</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mo rspace="0.167em">−</mo><mrow><msub><mo>∇</mo><mi>x</mi></msub><mrow><mo stretchy="false">(</mo><mrow><mrow><msub><mi>f</mi><mi>y</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mrow><msub><mi>g</mi><mi>θ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">x^{\prime}(t)=-\nabla_{x}(f_{y}(x)+g_{\theta}(x))</annotation></semantics></math>, with hyper-parameters <math id="S2.SS3.p1.m9" class="ltx_Math" alttext="\vartheta_{\ell}" display="inline" intent=":literal"><semantics><msub><mi>ϑ</mi><mi mathvariant="normal">ℓ</mi></msub><annotation encoding="application/x-tex">\vartheta_{\ell}</annotation></semantics></math> at iteration <math id="S2.SS3.p1.m10" class="ltx_Math" alttext="\ell" display="inline" intent=":literal"><semantics><mi mathvariant="normal">ℓ</mi><annotation encoding="application/x-tex">\ell</annotation></semantics></math>. Methods of the form (<a href="#S2.E5" title="Equation 5 ‣ 2.3 Optimization Schemes and Deep Unfolding ‣ 2 Background, Notation and Related Works ‣ Deep unfolding of MCMC kernels: scalable, modular &amp; explainable GANs for high-dimensional posterior sampling" class="ltx_ref"><span class="ltx_text ltx_ref_tag">5</span></a>) include (accelerated) gradient descent <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib16" title="" class="ltx_ref">43</a>]</cite> and proximal algorithms <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib36" title="" class="ltx_ref">9</a>]</cite> along with plug-and-play architectures which leverage an pre-trained MMSE denoiser to approximate the score <math id="S2.SS3.p1.m11" class="ltx_Math" alttext="\nabla_{x}\log p_{\theta}(x)" display="inline" intent=":literal"><semantics><mrow><msub><mo>∇</mo><mi>x</mi></msub><mo lspace="0.167em" rspace="0em">​</mo><mi>log</mi><mo lspace="0.167em" rspace="0em">​</mo><msub><mi>p</mi><mi>θ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\nabla_{x}\log p_{\theta}(x)</annotation></semantics></math> <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib38" title="" class="ltx_ref">26</a>, <a href="#bib.bib39" title="" class="ltx_ref">27</a>]</cite>.</p>
</div>
<div id="S2.SS3.p2" class="ltx_para">
<p id="S2.SS3.p2.1" class="ltx_p">Unfolded optimization <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib28" title="" class="ltx_ref">6</a>]</cite> refers to a class of methods whereby an iterative scheme (<a href="#S2.E5" title="Equation 5 ‣ 2.3 Optimization Schemes and Deep Unfolding ‣ 2 Background, Notation and Related Works ‣ Deep unfolding of MCMC kernels: scalable, modular &amp; explainable GANs for high-dimensional posterior sampling" class="ltx_ref"><span class="ltx_text ltx_ref_tag">5</span></a>)</p>
<table id="S2.E6" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S2.E6.m1" class="ltx_math_unparsed" alttext="\mathcal{G}_{\Theta}(\cdot)=G_{L,\vartheta_{L},\theta}\circ\cdots\circ G_{0,\vartheta_{0},\theta}(\cdot)" display="block" intent=":literal"><semantics><mrow><msub><mi class="ltx_font_mathcaligraphic">𝒢</mi><mi mathvariant="normal">Θ</mi></msub><mrow><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo stretchy="false">)</mo></mrow><mo>=</mo><msub><mi>G</mi><mrow><mi>L</mi><mo>,</mo><msub><mi>ϑ</mi><mi>L</mi></msub><mo>,</mo><mi>θ</mi></mrow></msub><mo lspace="0.222em">∘</mo><mo lspace="0.055em" rspace="0.055em">⋯</mo><mo rspace="0.222em">∘</mo><msub><mi>G</mi><mrow><mn>0</mn><mo>,</mo><msub><mi>ϑ</mi><mn>0</mn></msub><mo>,</mo><mi>θ</mi></mrow></msub><mrow><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathcal{G}_{\Theta}(\cdot)=G_{L,\vartheta_{L},\theta}\circ\cdots\circ G_{0,\vartheta_{0},\theta}(\cdot)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(6)</span></td></tr></tbody>
</table>
<p id="S2.SS3.p2.2" class="ltx_p">is viewed as a <math id="S2.SS3.p2.m1" class="ltx_Math" alttext="L+1" display="inline" intent=":literal"><semantics><mrow><mi>L</mi><mo>+</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">L+1</annotation></semantics></math>-layer neural-network <math id="S2.SS3.p2.m2" class="ltx_Math" alttext="\mathcal{G}_{\Theta}:\mathbb{R}^{{d_{y}}}\to\mathbb{R}^{d_{x}}" display="inline" intent=":literal"><semantics><mrow><msub><mi class="ltx_font_mathcaligraphic">𝒢</mi><mi mathvariant="normal">Θ</mi></msub><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><msup><mi>ℝ</mi><msub><mi>d</mi><mi>y</mi></msub></msup><mo stretchy="false">→</mo><msup><mi>ℝ</mi><msub><mi>d</mi><mi>x</mi></msub></msup></mrow></mrow><annotation encoding="application/x-tex">\mathcal{G}_{\Theta}:\mathbb{R}^{{d_{y}}}\to\mathbb{R}^{d_{x}}</annotation></semantics></math>, with trainable weights <math id="S2.SS3.p2.m3" class="ltx_Math" alttext="\Theta=[\vartheta_{0},\dots,\vartheta_{L},\theta]" display="inline" intent=":literal"><semantics><mrow><mi mathvariant="normal">Θ</mi><mo>=</mo><mrow><mo stretchy="false">[</mo><mrow><msub><mi>ϑ</mi><mn>0</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>ϑ</mi><mi>L</mi></msub><mo>,</mo><mi>θ</mi></mrow><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">\Theta=[\vartheta_{0},\dots,\vartheta_{L},\theta]</annotation></semantics></math> <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib42" title="" class="ltx_ref">18</a>]</cite>. During an offline training phase, optimal weights <math id="S2.SS3.p2.m4" class="ltx_Math" alttext="\widehat{\Theta}" display="inline" intent=":literal"><semantics><mover accent="true"><mi mathvariant="normal">Θ</mi><mo>^</mo></mover><annotation encoding="application/x-tex">\widehat{\Theta}</annotation></semantics></math> are computed by minimising a suitable objective function. For example, the mean-square loss</p>
<table id="S2.E7" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S2.E7.m1" class="ltx_Math" alttext="\mathcal{L}_{\text{opt}}(\Theta)=\mathbb{E}_{{\mathbf{x}},{\mathbf{y}}\sim p(x,y)}\Big[\underbrace{\|{\mathbf{x}}-\mathcal{G}_{\Theta}({\mathbf{y}})\|^{2}}_{l_{\text{opt}}({\mathbf{x}},{\mathbf{y}})}\Big]," display="block" intent=":literal"><semantics><mrow><mrow><mrow><msub><mi class="ltx_font_mathcaligraphic">ℒ</mi><mtext>opt</mtext></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi mathvariant="normal">Θ</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><msub><mi>𝔼</mi><mrow><mrow><mi>𝐱</mi><mo>,</mo><mi>𝐲</mi></mrow><mo>∼</mo><mrow><mi>p</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>y</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="1.600em" minsize="1.600em">[</mo><munder><munder accentunder="true"><msup><mrow><mo stretchy="false">‖</mo><mrow><mi>𝐱</mi><mo>−</mo><mrow><msub><mi class="ltx_font_mathcaligraphic">𝒢</mi><mi mathvariant="normal">Θ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐲</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup><mo stretchy="true">⏟</mo></munder><mrow><msub><mi>l</mi><mtext>opt</mtext></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐱</mi><mo>,</mo><mi>𝐲</mi><mo stretchy="false">)</mo></mrow></mrow></munder><mo maxsize="1.600em" minsize="1.600em">]</mo></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\mathcal{L}_{\text{opt}}(\Theta)=\mathbb{E}_{{\mathbf{x}},{\mathbf{y}}\sim p(x,y)}\Big[\underbrace{\|{\mathbf{x}}-\mathcal{G}_{\Theta}({\mathbf{y}})\|^{2}}_{l_{\text{opt}}({\mathbf{x}},{\mathbf{y}})}\Big],</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(7)</span></td></tr></tbody>
</table>
<p id="S2.SS3.p2.3" class="ltx_p">which is minimised over all <math id="S2.SS3.p2.m5" class="ltx_Math" alttext="p_{\mathbf{y}}" display="inline" intent=":literal"><semantics><msub><mi>p</mi><mi>𝐲</mi></msub><annotation encoding="application/x-tex">p_{\mathbf{y}}</annotation></semantics></math>-measurable random variables by the posterior mean of <math id="S2.SS3.p2.m6" class="ltx_Math" alttext="{\mathbf{x}}" display="inline" intent=":literal"><semantics><mi>𝐱</mi><annotation encoding="application/x-tex">{\mathbf{x}}</annotation></semantics></math> given <math id="S2.SS3.p2.m7" class="ltx_Math" alttext="y" display="inline" intent=":literal"><semantics><mi>y</mi><annotation encoding="application/x-tex">y</annotation></semantics></math>. Thus, the optimal <math id="S2.SS3.p2.m8" class="ltx_Math" alttext="\hat{\Theta}" display="inline" intent=":literal"><semantics><mover accent="true"><mi mathvariant="normal">Θ</mi><mo>^</mo></mover><annotation encoding="application/x-tex">\hat{\Theta}</annotation></semantics></math> for the objective (<a href="#S2.E7" title="Equation 7 ‣ 2.3 Optimization Schemes and Deep Unfolding ‣ 2 Background, Notation and Related Works ‣ Deep unfolding of MCMC kernels: scalable, modular &amp; explainable GANs for high-dimensional posterior sampling" class="ltx_ref"><span class="ltx_text ltx_ref_tag">7</span></a>) will learn the mapping <math id="S2.SS3.p2.m9" class="ltx_Math" alttext="y\mapsto\mathbb{E}_{{\mathbf{x}}\sim p(x)}[{\mathbf{x}}|{\mathbf{y}}=y]" display="inline" intent=":literal"><semantics><mrow><mi>y</mi><mo stretchy="false">↦</mo><mrow><msub><mi>𝔼</mi><mrow><mi>𝐱</mi><mo>∼</mo><mrow><mi>p</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mrow><mi>𝐱</mi><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mrow><mi>𝐲</mi><mo>=</mo><mi>y</mi></mrow></mrow><mo stretchy="false">]</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">y\mapsto\mathbb{E}_{{\mathbf{x}}\sim p(x)}[{\mathbf{x}}|{\mathbf{y}}=y]</annotation></semantics></math> for <math id="S2.SS3.p2.m10" class="ltx_Math" alttext="y\sim p(y)" display="inline" intent=":literal"><semantics><mrow><mi>y</mi><mo>∼</mo><mrow><mi>p</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>y</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">y\sim p(y)</annotation></semantics></math>.
In practice, <math id="S2.SS3.p2.m11" class="ltx_Math" alttext="p(x)" display="inline" intent=":literal"><semantics><mrow><mi>p</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">p(x)</annotation></semantics></math> is known only empirically and the loss (<a href="#S2.E7" title="Equation 7 ‣ 2.3 Optimization Schemes and Deep Unfolding ‣ 2 Background, Notation and Related Works ‣ Deep unfolding of MCMC kernels: scalable, modular &amp; explainable GANs for high-dimensional posterior sampling" class="ltx_ref"><span class="ltx_text ltx_ref_tag">7</span></a>) is computed by a Monte Carlo estimate using mini-batches from the dataset <math id="S2.SS3.p2.m12" class="ltx_Math" alttext="\mathcal{D}_{N_{\text{data}}}=\{(x^{(\star,n)},y^{(n)})\}_{n=1}^{N_{\text{data}}}" display="inline" intent=":literal"><semantics><mrow><msub><mi class="ltx_font_mathcaligraphic">𝒟</mi><msub><mi>N</mi><mtext>data</mtext></msub></msub><mo>=</mo><msubsup><mrow><mo stretchy="false">{</mo><mrow><mo stretchy="false">(</mo><msup><mi>x</mi><mrow><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋆</mo><mo>,</mo><mi>n</mi><mo stretchy="false">)</mo></mrow></msup><mo>,</mo><msup><mi>y</mi><mrow><mo stretchy="false">(</mo><mi>n</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow><mo stretchy="false">}</mo></mrow><mrow><mi>n</mi><mo>=</mo><mn>1</mn></mrow><msub><mi>N</mi><mtext>data</mtext></msub></msubsup></mrow><annotation encoding="application/x-tex">\mathcal{D}_{N_{\text{data}}}=\{(x^{(\star,n)},y^{(n)})\}_{n=1}^{N_{\text{data}}}</annotation></semantics></math>.</p>
</div>
<div id="S2.SS3.p3" class="ltx_para">
<p id="S2.SS3.p3.1" class="ltx_p">An illustration of a typical unfolded optimization network is displayed in <a href="#S2.F1.sf1" title="In Figure 1 ‣ 2.1 Setup and notation ‣ 2 Background, Notation and Related Works ‣ Deep unfolding of MCMC kernels: scalable, modular &amp; explainable GANs for high-dimensional posterior sampling" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Figure</span> <span class="ltx_text ltx_ref_tag">1(a)</span></a>. By designing a network architecture in this way, we obtain a model which has a degree of physical interpretability in contrast to standard feed-forward neural networks. From a Bayesian perspective, by jointly optimising the prior weights <math id="S2.SS3.p3.m1" class="ltx_Math" alttext="\theta" display="inline" intent=":literal"><semantics><mi>θ</mi><annotation encoding="application/x-tex">\theta</annotation></semantics></math> with the hyper-parameters <math id="S2.SS3.p3.m2" class="ltx_Math" alttext="\vartheta_{\ell}" display="inline" intent=":literal"><semantics><msub><mi>ϑ</mi><mi mathvariant="normal">ℓ</mi></msub><annotation encoding="application/x-tex">\vartheta_{\ell}</annotation></semantics></math> of the chosen algorithm, the unfolded model balances a delicate trade-off between descriptive prior information and fast algorithm convergence. Given a suitable amount of training data, on average for a new observation <math id="S2.SS3.p3.m3" class="ltx_Math" alttext="(x,y)\sim p_{{\mathbf{x}},{\mathbf{y}}}" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>y</mi><mo stretchy="false">)</mo></mrow><mo>∼</mo><msub><mi>p</mi><mrow><mi>𝐱</mi><mo>,</mo><mi>𝐲</mi></mrow></msub></mrow><annotation encoding="application/x-tex">(x,y)\sim p_{{\mathbf{x}},{\mathbf{y}}}</annotation></semantics></math> the unfolded network (<a href="#S2.E6" title="Equation 6 ‣ 2.3 Optimization Schemes and Deep Unfolding ‣ 2 Background, Notation and Related Works ‣ Deep unfolding of MCMC kernels: scalable, modular &amp; explainable GANs for high-dimensional posterior sampling" class="ltx_ref"><span class="ltx_text ltx_ref_tag">6</span></a>) with optimal weights <math id="S2.SS3.p3.m4" class="ltx_Math" alttext="\widehat{\Theta}" display="inline" intent=":literal"><semantics><mover accent="true"><mi mathvariant="normal">Θ</mi><mo>^</mo></mover><annotation encoding="application/x-tex">\widehat{\Theta}</annotation></semantics></math> will obtain a lower error in the objective <math id="S2.SS3.p3.m5" class="ltx_Math" alttext="l_{\text{opt}}(x,y)" display="inline" intent=":literal"><semantics><mrow><msub><mi>l</mi><mtext>opt</mtext></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>y</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">l_{\text{opt}}(x,y)</annotation></semantics></math> after <math id="S2.SS3.p3.m6" class="ltx_Math" alttext="L" display="inline" intent=":literal"><semantics><mi>L</mi><annotation encoding="application/x-tex">L</annotation></semantics></math> gradient steps. The idea of unfolding iterative procedures in this manner was first used to improve convergence of the iterative soft-thresholding algorithm for problems in sparse coding <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib36" title="" class="ltx_ref">9</a>, <a href="#bib.bib42" title="" class="ltx_ref">18</a>]</cite>. This concept has since been applied to construct efficient optimization solutions in a variety of settings <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib28" title="" class="ltx_ref">6</a>]</cite> including computational imaging <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib50" title="" class="ltx_ref">41</a>, <a href="#bib.bib23" title="" class="ltx_ref">71</a>, <a href="#bib.bib24" title="" class="ltx_ref">49</a>]</cite>. Unfolded PnP algorithms for challenging problems in computational imaging can be found in <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib50" title="" class="ltx_ref">41</a>, <a href="#bib.bib24" title="" class="ltx_ref">49</a>]</cite>.</p>
</div>
</section>
<section id="S2.SS4" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">2.4 </span>Markov Chain Monte Carlo</h3>

<div id="S2.SS4.p1" class="ltx_para">
<p id="S2.SS4.p1.2" class="ltx_p">MCMC methods generate posterior samples recursively by iteratively sampling from a Markov transition kernel</p>
<table id="S2.E8" class="ltx_equationgroup ltx_eqn_table">
<tbody>
<tr id="S2.E8X" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S2.E8X.m2" class="ltx_Math" alttext="\displaystyle\hat{x}_{\ell+1}" display="inline" intent=":literal"><semantics><msub><mover accent="true"><mi>x</mi><mo>^</mo></mover><mrow><mi mathvariant="normal">ℓ</mi><mo>+</mo><mn>1</mn></mrow></msub><annotation encoding="application/x-tex">\displaystyle\hat{x}_{\ell+1}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S2.E8X.m3" class="ltx_Math" alttext="\displaystyle\sim\kappa_{\ell,\vartheta_{\ell},\theta}(\cdot,\hat{x}_{\ell};y),\qquad\ell\in\mathbb{N}," display="inline" intent=":literal"><semantics><mrow><mo>∼</mo><mi>κ</mi><msub><mrow></mrow><mrow><mi mathvariant="normal">ℓ</mi><mo>,</mo><msub><mi>ϑ</mi><mi mathvariant="normal">ℓ</mi></msub><mo>,</mo><mi>θ</mi></mrow></msub><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo>,</mo><mover accent="true"><mi>x</mi><mo>^</mo></mover><msub><mrow></mrow><mi mathvariant="normal">ℓ</mi></msub><mo>;</mo><mi>y</mi><mo stretchy="false">)</mo><mo rspace="2.167em">,</mo><mi mathvariant="normal">ℓ</mi><mo>∈</mo><mi>ℕ</mi><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\sim\kappa_{\ell,\vartheta_{\ell},\theta}(\cdot,\hat{x}_{\ell};y),\qquad\ell\in\mathbb{N},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equationgroup ltx_align_right">(8)</span></td></tr></tbody>
</table>
<p id="S2.SS4.p1.3" class="ltx_p">with the convention that <math id="S2.SS4.p1.m1" class="ltx_Math" alttext="\hat{x}_{0}\sim\kappa_{0,\vartheta_{0},\theta}" display="inline" intent=":literal"><semantics><mrow><msub><mover accent="true"><mi>x</mi><mo>^</mo></mover><mn>0</mn></msub><mo>∼</mo><msub><mi>κ</mi><mrow><mn>0</mn><mo>,</mo><msub><mi>ϑ</mi><mn>0</mn></msub><mo>,</mo><mi>θ</mi></mrow></msub></mrow><annotation encoding="application/x-tex">\hat{x}_{0}\sim\kappa_{0,\vartheta_{0},\theta}</annotation></semantics></math> such that <math id="S2.SS4.p1.m2" class="ltx_Math" alttext="\kappa_{0,\vartheta_{0},\theta}" display="inline" intent=":literal"><semantics><msub><mi>κ</mi><mrow><mn>0</mn><mo>,</mo><msub><mi>ϑ</mi><mn>0</mn></msub><mo>,</mo><mi>θ</mi></mrow></msub><annotation encoding="application/x-tex">\kappa_{0,\vartheta_{0},\theta}</annotation></semantics></math> places an initial distribution for the chain. We assume throughout that for all <math id="S2.SS4.p1.m3" class="ltx_Math" alttext="(x,y)\in\mathbb{R}^{d_{x}}\times\mathbb{R}^{{d_{y}}}" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>y</mi><mo stretchy="false">)</mo></mrow><mo>∈</mo><mrow><msup><mi>ℝ</mi><msub><mi>d</mi><mi>x</mi></msub></msup><mo lspace="0.222em" rspace="0.222em">×</mo><msup><mi>ℝ</mi><msub><mi>d</mi><mi>y</mi></msub></msup></mrow></mrow><annotation encoding="application/x-tex">(x,y)\in\mathbb{R}^{d_{x}}\times\mathbb{R}^{{d_{y}}}</annotation></semantics></math> the kernel <math id="S2.SS4.p1.m4" class="ltx_Math" alttext="\kappa_{\ell,\vartheta_{\ell},\theta}(\cdot;x,y)" display="inline" intent=":literal"><semantics><mrow><msub><mi>κ</mi><mrow><mi mathvariant="normal">ℓ</mi><mo>,</mo><msub><mi>ϑ</mi><mi mathvariant="normal">ℓ</mi></msub><mo>,</mo><mi>θ</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo>,</mo><mi>x</mi><mo>,</mo><mi>y</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\kappa_{\ell,\vartheta_{\ell},\theta}(\cdot;x,y)</annotation></semantics></math> can be sampled with bounded computational cost. Allowing for a burn-in period <math id="S2.SS4.p1.m5" class="ltx_Math" alttext="L_{0}\geq 0" display="inline" intent=":literal"><semantics><mrow><msub><mi>L</mi><mn>0</mn></msub><mo>≥</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">L_{0}\geq 0</annotation></semantics></math>, samples <math id="S2.SS4.p1.m6" class="ltx_Math" alttext="\{\hat{x}_{\ell}\}_{\ell\geq L_{0}}" display="inline" intent=":literal"><semantics><msub><mrow><mo stretchy="false">{</mo><msub><mover accent="true"><mi>x</mi><mo>^</mo></mover><mi mathvariant="normal">ℓ</mi></msub><mo stretchy="false">}</mo></mrow><mrow><mi mathvariant="normal">ℓ</mi><mo>≥</mo><msub><mi>L</mi><mn>0</mn></msub></mrow></msub><annotation encoding="application/x-tex">\{\hat{x}_{\ell}\}_{\ell\geq L_{0}}</annotation></semantics></math> can be viewed as approximate (dependent) samples from <math id="S2.SS4.p1.m7" class="ltx_Math" alttext="\pi_{\theta}(x|y)" display="inline" intent=":literal"><semantics><mrow><msub><mi>π</mi><mi>θ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo lspace="0em" rspace="0em">|</mo><mi>y</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\pi_{\theta}(x|y)</annotation></semantics></math>. Such techniques can often be interpreted as the discretisation of a gradient flow on the space of measures <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib17" title="" class="ltx_ref">64</a>]</cite> through discretization of the Langevin diffusion</p>
<table id="S2.E9" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S2.E9.m1" class="ltx_Math" alttext="\text{d}{\mathbf{x}}_{t}=-\nabla_{x}(f_{y}({\mathbf{x}}_{t})+g_{\theta}({\mathbf{x}}_{t}))\text{d}t+\sqrt{2}\text{d}{\mathbf{w}}_{t}," display="block" intent=":literal"><semantics><mrow><mrow><mrow><mtext>d</mtext><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝐱</mi><mi>t</mi></msub></mrow><mo>=</mo><mrow><mrow><mo rspace="0.167em">−</mo><mrow><mrow><msub><mo>∇</mo><mi>x</mi></msub><mrow><mo stretchy="false">(</mo><mrow><mrow><msub><mi>f</mi><mi>y</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐱</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mrow><msub><mi>g</mi><mi>θ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐱</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><mtext>d</mtext><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></mrow><mo>+</mo><mrow><msqrt><mn>2</mn></msqrt><mo lspace="0em" rspace="0em">​</mo><mtext>d</mtext><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝐰</mi><mi>t</mi></msub></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\text{d}{\mathbf{x}}_{t}=-\nabla_{x}(f_{y}({\mathbf{x}}_{t})+g_{\theta}({\mathbf{x}}_{t}))\text{d}t+\sqrt{2}\text{d}{\mathbf{w}}_{t},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(9)</span></td></tr></tbody>
</table>
<p id="S2.SS4.p1.4" class="ltx_p">where <math id="S2.SS4.p1.m8" class="ltx_Math" alttext="({\mathbf{w}}_{t})_{t\geq 0}" display="inline" intent=":literal"><semantics><msub><mrow><mo stretchy="false">(</mo><msub><mi>𝐰</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow><mrow><mi>t</mi><mo>≥</mo><mn>0</mn></mrow></msub><annotation encoding="application/x-tex">({\mathbf{w}}_{t})_{t\geq 0}</annotation></semantics></math> is an <math id="S2.SS4.p1.m9" class="ltx_Math" alttext="\mathbb{R}^{d_{x}}" display="inline" intent=":literal"><semantics><msup><mi>ℝ</mi><msub><mi>d</mi><mi>x</mi></msub></msup><annotation encoding="application/x-tex">\mathbb{R}^{d_{x}}</annotation></semantics></math>-valued Brownian motion. Examples include the unadjusted Langevin Algorithm <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib34" title="" class="ltx_ref">13</a>]</cite>, which is based on an Euler-Maruyama (E-M) discretisation of (<a href="#S2.E9" title="Equation 9 ‣ 2.4 Markov Chain Monte Carlo ‣ 2 Background, Notation and Related Works ‣ Deep unfolding of MCMC kernels: scalable, modular &amp; explainable GANs for high-dimensional posterior sampling" class="ltx_ref"><span class="ltx_text ltx_ref_tag">9</span></a>), along with proximal extensions <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib54" title="" class="ltx_ref">12</a>, <a href="#bib.bib33" title="" class="ltx_ref">46</a>]</cite>. Kernels of the form (<a href="#S2.E8" title="Equation 8 ‣ 2.4 Markov Chain Monte Carlo ‣ 2 Background, Notation and Related Works ‣ Deep unfolding of MCMC kernels: scalable, modular &amp; explainable GANs for high-dimensional posterior sampling" class="ltx_ref"><span class="ltx_text ltx_ref_tag">8</span></a>) also include splitting MCMC algorithms, for instance the split-Gibbs sampler <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib22" title="" class="ltx_ref">62</a>, <a href="#bib.bib25" title="" class="ltx_ref">45</a>]</cite>. The inclusion of plug-and-play priors within the above MCMC kernels has been studied extensively in <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib30" title="" class="ltx_ref">33</a>, <a href="#bib.bib45" title="" class="ltx_ref">8</a>]</cite>.</p>
</div>
<div id="S2.SS4.p2" class="ltx_para">
<p id="S2.SS4.p2.1" class="ltx_p">Related to PnP-Langevin algorithms, score-based diffusion models (SBMs) <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib57" title="" class="ltx_ref">55</a>, <a href="#bib.bib18" title="" class="ltx_ref">53</a>]</cite> construct a generative model to approximately sample <math id="S2.SS4.p2.m1" class="ltx_Math" alttext="p(x)" display="inline" intent=":literal"><semantics><mrow><mi>p</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">p(x)</annotation></semantics></math> by reversing the forward process</p>
<table id="S2.E10" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S2.E10.m1" class="ltx_Math" alttext="\text{d}{\mathbf{x}}_{t}=-\beta_{t}{\mathbf{x}}_{t}\text{d}t+\sqrt{2\beta_{t}}\text{d}{\mathbf{w}}_{t}" display="block" intent=":literal"><semantics><mrow><mrow><mtext>d</mtext><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝐱</mi><mi>t</mi></msub></mrow><mo>=</mo><mrow><mrow><mo>−</mo><mrow><msub><mi>β</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝐱</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mtext>d</mtext><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></mrow><mo>+</mo><mrow><msqrt><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>β</mi><mi>t</mi></msub></mrow></msqrt><mo lspace="0em" rspace="0em">​</mo><mtext>d</mtext><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝐰</mi><mi>t</mi></msub></mrow></mrow></mrow><annotation encoding="application/x-tex">\text{d}{\mathbf{x}}_{t}=-\beta_{t}{\mathbf{x}}_{t}\text{d}t+\sqrt{2\beta_{t}}\text{d}{\mathbf{w}}_{t}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(10)</span></td></tr></tbody>
</table>
<p id="S2.SS4.p2.2" class="ltx_p">transporting <math id="S2.SS4.p2.m2" class="ltx_Math" alttext="p(x)" display="inline" intent=":literal"><semantics><mrow><mi>p</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">p(x)</annotation></semantics></math> at <math id="S2.SS4.p2.m3" class="ltx_Math" alttext="t=0" display="inline" intent=":literal"><semantics><mrow><mi>t</mi><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">t=0</annotation></semantics></math> to <math id="S2.SS4.p2.m4" class="ltx_Math" alttext="\mathcal{N}(0,I)" display="inline" intent=":literal"><semantics><mrow><mi class="ltx_font_mathcaligraphic">𝒩</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mn>0</mn><mo>,</mo><mi>I</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathcal{N}(0,I)</annotation></semantics></math> as <math id="S2.SS4.p2.m5" class="ltx_Math" alttext="t\to\infty" display="inline" intent=":literal"><semantics><mrow><mi>t</mi><mo stretchy="false">→</mo><mi mathvariant="normal">∞</mi></mrow><annotation encoding="application/x-tex">t\to\infty</annotation></semantics></math>. It follows that <math id="S2.SS4.p2.m6" class="ltx_Math" alttext="{\mathbf{x}}_{t}" display="inline" intent=":literal"><semantics><msub><mi>𝐱</mi><mi>t</mi></msub><annotation encoding="application/x-tex">{\mathbf{x}}_{t}</annotation></semantics></math> is Gaussian with mean <math id="S2.SS4.p2.m7" class="ltx_math_unparsed" alttext="\mu_{t}={\mathbf{x}}_{0}\exp(-\int_{0}^{t}\beta_{s}\text{d}s)" display="inline" intent=":literal"><semantics><mrow><msub><mi>μ</mi><mi>t</mi></msub><mo>=</mo><msub><mi>𝐱</mi><mn>0</mn></msub><mi>exp</mi><mrow><mo stretchy="false">(</mo><mo lspace="0em" rspace="0.055em">−</mo><msubsup><mo>∫</mo><mn>0</mn><mi>t</mi></msubsup><msub><mi>β</mi><mi>s</mi></msub><mtext>d</mtext><mi>s</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mu_{t}={\mathbf{x}}_{0}\exp(-\int_{0}^{t}\beta_{s}\text{d}s)</annotation></semantics></math> and noise level <math id="S2.SS4.p2.m8" class="ltx_Math" alttext="\sigma_{t}^{2}" display="inline" intent=":literal"><semantics><msubsup><mi>σ</mi><mi>t</mi><mn>2</mn></msubsup><annotation encoding="application/x-tex">\sigma_{t}^{2}</annotation></semantics></math>. The reversed process takes the form</p>
<table id="S2.E11" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S2.E11.m1" class="ltx_Math" alttext="\text{d}{{\mathbf{x}}_{t}}=-(\beta_{t}{{\mathbf{x}}_{t}}/2+\beta_{t}\nabla_{x}\log p_{t}({{\mathbf{x}}_{t}}))\text{d}t+\sqrt{\beta_{t}}\text{d}{{\mathbf{w}}_{t}}," display="block" intent=":literal"><semantics><mrow><mrow><mrow><mtext>d</mtext><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝐱</mi><mi>t</mi></msub></mrow><mo>=</mo><mrow><mrow><mo>−</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mrow><mrow><msub><mi>β</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝐱</mi><mi>t</mi></msub></mrow><mo>/</mo><mn>2</mn></mrow><mo>+</mo><mrow><msub><mi>β</mi><mi>t</mi></msub><mo lspace="0.167em" rspace="0em">​</mo><msub><mo>∇</mo><mi>x</mi></msub><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><msub><mi>p</mi><mi>t</mi></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐱</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mtext>d</mtext><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></mrow><mo>+</mo><mrow><msqrt><msub><mi>β</mi><mi>t</mi></msub></msqrt><mo lspace="0em" rspace="0em">​</mo><mtext>d</mtext><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝐰</mi><mi>t</mi></msub></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\text{d}{{\mathbf{x}}_{t}}=-(\beta_{t}{{\mathbf{x}}_{t}}/2+\beta_{t}\nabla_{x}\log p_{t}({{\mathbf{x}}_{t}}))\text{d}t+\sqrt{\beta_{t}}\text{d}{{\mathbf{w}}_{t}},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(11)</span></td></tr></tbody>
</table>
<p id="S2.SS4.p2.3" class="ltx_p">where we introduce the marginal <math id="S2.SS4.p2.m9" class="ltx_Math" alttext="p_{t}(x)=\int_{\mathbb{R}^{d_{x}}}p_{0t}(x_{t}|x_{0})p(x_{0})\text{d}x_{0}" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>p</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo rspace="0.111em">=</mo><mrow><msub><mo>∫</mo><msup><mi>ℝ</mi><msub><mi>d</mi><mi>x</mi></msub></msup></msub><mrow><msub><mi>p</mi><mrow><mn>0</mn><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">|</mo><msub><mi>x</mi><mn>0</mn></msub><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mn>0</mn></msub><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mtext>d</mtext><mo lspace="0em" rspace="0em">​</mo><msub><mi>x</mi><mn>0</mn></msub></mrow></mrow></mrow><annotation encoding="application/x-tex">p_{t}(x)=\int_{\mathbb{R}^{d_{x}}}p_{0t}(x_{t}|x_{0})p(x_{0})\text{d}x_{0}</annotation></semantics></math>. The score <math id="S2.SS4.p2.m10" class="ltx_Math" alttext="\nabla_{x}\log p_{t}({{\mathbf{x}}_{t}})" display="inline" intent=":literal"><semantics><mrow><msub><mo>∇</mo><mi>x</mi></msub><mo lspace="0.167em" rspace="0em">​</mo><mi>log</mi><mo lspace="0.167em" rspace="0em">​</mo><msub><mi>p</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐱</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\nabla_{x}\log p_{t}({{\mathbf{x}}_{t}})</annotation></semantics></math> can be approximated through Tweedie’s identity by training an MMSE denoiser <math id="S2.SS4.p2.m11" class="ltx_Math" alttext="D_{t,\theta}" display="inline" intent=":literal"><semantics><msub><mi>D</mi><mrow><mi>t</mi><mo>,</mo><mi>θ</mi></mrow></msub><annotation encoding="application/x-tex">D_{t,\theta}</annotation></semantics></math> using a score-matching loss based on (<a href="#S2.E4" title="Equation 4 ‣ 2.2 Data-Driven Priors ‣ 2 Background, Notation and Related Works ‣ Deep unfolding of MCMC kernels: scalable, modular &amp; explainable GANs for high-dimensional posterior sampling" class="ltx_ref"><span class="ltx_text ltx_ref_tag">4</span></a>) to learn the noise added to <math id="S2.SS4.p2.m12" class="ltx_Math" alttext="{\mathbf{x}}_{t}" display="inline" intent=":literal"><semantics><msub><mi>𝐱</mi><mi>t</mi></msub><annotation encoding="application/x-tex">{\mathbf{x}}_{t}</annotation></semantics></math>. The reversed diffusion process can then be sampled by E-M discretisation <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib29" title="" class="ltx_ref">24</a>]</cite> or implicit (DDIM) steps <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib55" title="" class="ltx_ref">51</a>]</cite>. More recently, consistency models <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib69" title="" class="ltx_ref">52</a>]</cite> fine-tune <math id="S2.SS4.p2.m13" class="ltx_Math" alttext="D_{t,\theta}" display="inline" intent=":literal"><semantics><msub><mi>D</mi><mrow><mi>t</mi><mo>,</mo><mi>θ</mi></mrow></msub><annotation encoding="application/x-tex">D_{t,\theta}</annotation></semantics></math> to allow accurate sampling within a vastly reduced number of iterations.</p>
</div>
<div id="S2.SS4.p3" class="ltx_para">
<p id="S2.SS4.p3.1" class="ltx_p">By replacing <math id="S2.SS4.p3.m1" class="ltx_Math" alttext="{\nabla_{x}\log p_{t}({{\mathbf{x}}_{t}})}" display="inline" intent=":literal"><semantics><mrow><msub><mo>∇</mo><mi>x</mi></msub><mo lspace="0.167em" rspace="0em">​</mo><mi>log</mi><mo lspace="0.167em" rspace="0em">​</mo><msub><mi>p</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐱</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">{\nabla_{x}\log p_{t}({{\mathbf{x}}_{t}})}</annotation></semantics></math> with the conditional score defined through</p>
<table id="S2.E12" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S2.E12.m1" class="ltx_Math" alttext="{\nabla_{x}\log p_{t}({{\mathbf{x}}_{t}}|y)=\nabla_{x}\log\int_{\mathbb{R}^{d_{x}}}p_{0t}(x_{t}|x_{0})p(x_{0}|y)\text{d}x_{0}}" display="block" intent=":literal"><semantics><mrow><mrow><msub><mo>∇</mo><mi>x</mi></msub><mo lspace="0.167em" rspace="0em">​</mo><mi>log</mi><mo lspace="0.167em" rspace="0em">​</mo><msub><mi>p</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐱</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">|</mo><mi>y</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><msub><mo>∇</mo><mi>x</mi></msub><mo lspace="0.167em" rspace="0em">​</mo><mi>log</mi><mo lspace="0em" rspace="0em">​</mo><mrow><msub><mo>∫</mo><msup><mi>ℝ</mi><msub><mi>d</mi><mi>x</mi></msub></msup></msub><mrow><msub><mi>p</mi><mrow><mn>0</mn><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">|</mo><msub><mi>x</mi><mn>0</mn></msub><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mn>0</mn></msub><mo lspace="0em" rspace="0em">|</mo><mi>y</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mtext>d</mtext><mo lspace="0em" rspace="0em">​</mo><msub><mi>x</mi><mn>0</mn></msub></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">{\nabla_{x}\log p_{t}({{\mathbf{x}}_{t}}|y)=\nabla_{x}\log\int_{\mathbb{R}^{d_{x}}}p_{0t}(x_{t}|x_{0})p(x_{0}|y)\text{d}x_{0}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(12)</span></td></tr></tbody>
</table>
<p id="S2.SS4.p3.2" class="ltx_p">one can guide the reversed diffusion process to approximately sample <math id="S2.SS4.p3.m2" class="ltx_Math" alttext="p(x|y)" display="inline" intent=":literal"><semantics><mrow><mi>p</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo lspace="0em" rspace="0em">|</mo><mi>y</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">p(x|y)</annotation></semantics></math> at time <math id="S2.SS4.p3.m3" class="ltx_Math" alttext="t=0" display="inline" intent=":literal"><semantics><mrow><mi>t</mi><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">t=0</annotation></semantics></math>. In <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib68" title="" class="ltx_ref">72</a>, <a href="#bib.bib64" title="" class="ltx_ref">7</a>]</cite>, this idea is used to construct zero-shot Bayesian sampling algorithms. Similar methodology is employed in <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib63" title="" class="ltx_ref">37</a>]</cite> using a different reverse diffusion process. Note that in general, the integral in (<a href="#S2.E12" title="Equation 12 ‣ 2.4 Markov Chain Monte Carlo ‣ 2 Background, Notation and Related Works ‣ Deep unfolding of MCMC kernels: scalable, modular &amp; explainable GANs for high-dimensional posterior sampling" class="ltx_ref"><span class="ltx_text ltx_ref_tag">12</span></a>) is intractable and the conditional score is typically approximated analytically. For example, in <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib64" title="" class="ltx_ref">7</a>]</cite> the authors impose that <math id="S2.SS4.p3.m4" class="ltx_Math" alttext="p_{t0}(x_{0}|x_{t})=\delta_{\hat{\mathbf{x}}_{0}}" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>p</mi><mrow><mi>t</mi><mo lspace="0em" rspace="0em">​</mo><mn>0</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mn>0</mn></msub><mo lspace="0em" rspace="0em">|</mo><msub><mi>x</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><msub><mi>δ</mi><msub><mover accent="true"><mi>𝐱</mi><mo>^</mo></mover><mn>0</mn></msub></msub></mrow><annotation encoding="application/x-tex">p_{t0}(x_{0}|x_{t})=\delta_{\hat{\mathbf{x}}_{0}}</annotation></semantics></math>, where <math id="S2.SS4.p3.m5" class="ltx_Math" alttext="\hat{\mathbf{x}}_{0}=\mathbb{E}[{\mathbf{x}}_{0}|{\mathbf{x}}_{t}]" display="inline" intent=":literal"><semantics><mrow><msub><mover accent="true"><mi>𝐱</mi><mo>^</mo></mover><mn>0</mn></msub><mo>=</mo><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><msub><mi>𝐱</mi><mn>0</mn></msub><mo fence="false" rspace="0.167em" stretchy="false">|</mo><msub><mi>𝐱</mi><mi>t</mi></msub></mrow><mo stretchy="false">]</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\hat{\mathbf{x}}_{0}=\mathbb{E}[{\mathbf{x}}_{0}|{\mathbf{x}}_{t}]</annotation></semantics></math>. Recent methods <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib51" title="" class="ltx_ref">15</a>, <a href="#bib.bib66" title="" class="ltx_ref">56</a>]</cite> propose related techniques using pre-trained consistency models to generate accurate posterior samples in a small number of diffusion steps. In <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib27" title="" class="ltx_ref">39</a>]</cite>, the authors use a small number of DDIM steps to act as a plug-and-play prior for the Langevin diffusion.</p>
</div>
<div id="S2.SS4.p4" class="ltx_para">
<p id="S2.SS4.p4.1" class="ltx_p">For more accurate performance on a determined class of likelihood models, several works have considered fine-tuning the pre-trained score model over a training set <math id="S2.SS4.p4.m1" class="ltx_Math" alttext="\mathcal{D}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">𝒟</mi><annotation encoding="application/x-tex">\mathcal{D}</annotation></semantics></math> of <math id="S2.SS4.p4.m2" class="ltx_Math" alttext="(x^{\star},y)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><msup><mi>x</mi><mo>⋆</mo></msup><mo>,</mo><mi>y</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(x^{\star},y)</annotation></semantics></math> pairs to model the conditional score for a determined class of likelihood models instead. In <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib62" title="" class="ltx_ref">70</a>]</cite>, the authors approximate <math id="S2.SS4.p4.m3" class="ltx_Math" alttext="\nabla_{x}\log p_{t}({{\mathbf{x}}_{t}}|y)" display="inline" intent=":literal"><semantics><mrow><msub><mo>∇</mo><mi>x</mi></msub><mo lspace="0.167em" rspace="0em">​</mo><mi>log</mi><mo lspace="0.167em" rspace="0em">​</mo><msub><mi>p</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐱</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">|</mo><mi>y</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\nabla_{x}\log p_{t}({{\mathbf{x}}_{t}}|y)</annotation></semantics></math> by fine-tuning a pre-trained score <math id="S2.SS4.p4.m4" class="ltx_Math" alttext="D_{t,\theta}" display="inline" intent=":literal"><semantics><msub><mi>D</mi><mrow><mi>t</mi><mo>,</mo><mi>θ</mi></mrow></msub><annotation encoding="application/x-tex">D_{t,\theta}</annotation></semantics></math> using a control-net <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib53" title="" class="ltx_ref">68</a>]</cite> taking <math id="S2.SS4.p4.m5" class="ltx_Math" alttext="y" display="inline" intent=":literal"><semantics><mi>y</mi><annotation encoding="application/x-tex">y</annotation></semantics></math> as input. The resulting model is thus tailored to fit specific likelihood models. A similar approach is taken in <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib52" title="" class="ltx_ref">40</a>]</cite>, which unfolds the stochastic gradient LATINO algorithm, based on the Langevin diffusion, <a href="#alg1" title="In 4.2.3 Model ‣ 4.2 Radio Interferometry ‣ 4 Numerical Experiments ‣ Deep unfolding of MCMC kernels: scalable, modular &amp; explainable GANs for high-dimensional posterior sampling" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Algorithm</span> <span class="ltx_text ltx_ref_tag">1</span></a> to sample from <math id="S2.SS4.p4.m6" class="ltx_Math" alttext="p_{0}(x)" display="inline" intent=":literal"><semantics><mrow><msub><mi>p</mi><mn>0</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">p_{0}(x)</annotation></semantics></math> given both <math id="S2.SS4.p4.m7" class="ltx_Math" alttext="{\mathbf{x}}_{t}" display="inline" intent=":literal"><semantics><msub><mi>𝐱</mi><mi>t</mi></msub><annotation encoding="application/x-tex">{\mathbf{x}}_{t}</annotation></semantics></math> and <math id="S2.SS4.p4.m8" class="ltx_Math" alttext="y" display="inline" intent=":literal"><semantics><mi>y</mi><annotation encoding="application/x-tex">y</annotation></semantics></math>. We unfold the LATINO kernel in <a href="#S4.SS2" title="4.2 Radio Interferometry ‣ 4 Numerical Experiments ‣ Deep unfolding of MCMC kernels: scalable, modular &amp; explainable GANs for high-dimensional posterior sampling" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Section</span> <span class="ltx_text ltx_ref_tag">4.2</span></a> for a radio interferometry problem.</p>
</div>
</section>
<section id="S2.SS5" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">2.5 </span>Deep Generative Modelling</h3>

<div id="S2.SS5.p1" class="ltx_para">
<p id="S2.SS5.p1.1" class="ltx_p">Generative machine-learning architectures model <math id="S2.SS5.p1.m1" class="ltx_Math" alttext="p(x)" display="inline" intent=":literal"><semantics><mrow><mi>p</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">p(x)</annotation></semantics></math> as the push-forward of a latent measure <math id="S2.SS5.p1.m2" class="ltx_Math" alttext="p_{\mathbf{z}}" display="inline" intent=":literal"><semantics><msub><mi>p</mi><mi>𝐳</mi></msub><annotation encoding="application/x-tex">p_{\mathbf{z}}</annotation></semantics></math> by a deep neural-network ‘generator’ <math id="S2.SS5.p1.m3" class="ltx_Math" alttext="G_{\theta}" display="inline" intent=":literal"><semantics><msub><mi>G</mi><mi>θ</mi></msub><annotation encoding="application/x-tex">G_{\theta}</annotation></semantics></math>. By choosing an easy to sample latent measure, for example <math id="S2.SS5.p1.m4" class="ltx_Math" alttext="p_{\mathbf{z}}\overset{\text{d}}{=}\mathcal{N}(0,I_{d_{z}})" display="inline" intent=":literal"><semantics><mrow><msub><mi>p</mi><mi>𝐳</mi></msub><mo lspace="0em" rspace="0em">​</mo><mover accent="true"><mo>=</mo><mtext mathsize="0.700em">d</mtext></mover><mo lspace="0em" rspace="0em">​</mo><mi class="ltx_font_mathcaligraphic">𝒩</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mn>0</mn><mo>,</mo><msub><mi>I</mi><msub><mi>d</mi><mi>z</mi></msub></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">p_{\mathbf{z}}\overset{\text{d}}{=}\mathcal{N}(0,I_{d_{z}})</annotation></semantics></math>, samples from the distribution <math id="S2.SS5.p1.m5" class="ltx_Math" alttext="p_{\theta}=(G_{\theta})_{\#}p_{\mathbf{z}}" display="inline" intent=":literal"><semantics><mrow><msub><mi>p</mi><mi>θ</mi></msub><mo>=</mo><mrow><msub><mrow><mo stretchy="false">(</mo><msub><mi>G</mi><mi>θ</mi></msub><mo stretchy="false">)</mo></mrow><mi>#</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>p</mi><mi>𝐳</mi></msub></mrow></mrow><annotation encoding="application/x-tex">p_{\theta}=(G_{\theta})_{\#}p_{\mathbf{z}}</annotation></semantics></math> are straightforward to obtain. Examples include variational auto-encoders (VAE) <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib10" title="" class="ltx_ref">31</a>]</cite>, generative adversarial networks <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib49" title="" class="ltx_ref">16</a>]</cite> and normalising flows <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib4" title="" class="ltx_ref">22</a>, <a href="#bib.bib3" title="" class="ltx_ref">20</a>, <a href="#bib.bib5" title="" class="ltx_ref">21</a>]</cite>. VAE’s train an encoder-decoder pair to encode samples from <math id="S2.SS5.p1.m6" class="ltx_Math" alttext="p(x)" display="inline" intent=":literal"><semantics><mrow><mi>p</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">p(x)</annotation></semantics></math> to a latent (Gaussian measure) <math id="S2.SS5.p1.m7" class="ltx_Math" alttext="p_{\mathbf{z}}" display="inline" intent=":literal"><semantics><msub><mi>p</mi><mi>𝐳</mi></msub><annotation encoding="application/x-tex">p_{\mathbf{z}}</annotation></semantics></math> while jointly learning to decode latent variables <math id="S2.SS5.p1.m8" class="ltx_Math" alttext="{\mathbf{z}}\sim p_{\mathbf{z}}" display="inline" intent=":literal"><semantics><mrow><mi>𝐳</mi><mo>∼</mo><msub><mi>p</mi><mi>𝐳</mi></msub></mrow><annotation encoding="application/x-tex">{\mathbf{z}}\sim p_{\mathbf{z}}</annotation></semantics></math> to recover an approximation of the prior <math id="S2.SS5.p1.m9" class="ltx_Math" alttext="p(x)" display="inline" intent=":literal"><semantics><mrow><mi>p</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">p(x)</annotation></semantics></math>. Weights in the encoder and decoder are trained to optimize an evidence lower bound based on the Kullbach-Leibler divergence. An alternative approach for generative modelling includes Generative Adversarial Networks (GANs) <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib49" title="" class="ltx_ref">16</a>]</cite>, discussed in <a href="#S2.SS6" title="2.6 Conditional Generative Adversarial Networks ‣ 2 Background, Notation and Related Works ‣ Deep unfolding of MCMC kernels: scalable, modular &amp; explainable GANs for high-dimensional posterior sampling" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Section</span> <span class="ltx_text ltx_ref_tag">2.6</span></a>.</p>
</div>
<div id="S2.SS5.p2" class="ltx_para">
<p id="S2.SS5.p2.1" class="ltx_p">Such techniques are commonly used for Bayesian inversion, by letting <math id="S2.SS5.p2.m1" class="ltx_Math" alttext="G_{\theta}=G_{\theta}(\cdot,y)" display="inline" intent=":literal"><semantics><mrow><msub><mi>G</mi><mi>θ</mi></msub><mo>=</mo><mrow><msub><mi>G</mi><mi>θ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo>,</mo><mi>y</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">G_{\theta}=G_{\theta}(\cdot,y)</annotation></semantics></math> depend on the measurements <math id="S2.SS5.p2.m2" class="ltx_Math" alttext="y" display="inline" intent=":literal"><semantics><mi>y</mi><annotation encoding="application/x-tex">y</annotation></semantics></math>. Weights <math id="S2.SS5.p2.m3" class="ltx_Math" alttext="\theta" display="inline" intent=":literal"><semantics><mi>θ</mi><annotation encoding="application/x-tex">\theta</annotation></semantics></math> are then optimized such that <math id="S2.SS5.p2.m4" class="ltx_Math" alttext="G_{\theta}(\cdot,y)_{\#}p_{\mathbf{z}}\approx p(x|y)" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>G</mi><mi>θ</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo>,</mo><mi>y</mi><mo stretchy="false">)</mo></mrow><mi>#</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>p</mi><mi>𝐳</mi></msub></mrow><mo>≈</mo><mrow><mi>p</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo lspace="0em" rspace="0em">|</mo><mi>y</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">G_{\theta}(\cdot,y)_{\#}p_{\mathbf{z}}\approx p(x|y)</annotation></semantics></math> for <math id="S2.SS5.p2.m5" class="ltx_Math" alttext="y\sim{\mathbf{y}}" display="inline" intent=":literal"><semantics><mrow><mi>y</mi><mo>∼</mo><mi>𝐲</mi></mrow><annotation encoding="application/x-tex">y\sim{\mathbf{y}}</annotation></semantics></math>. Examples include conditional VAE <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib6" title="" class="ltx_ref">65</a>]</cite> and conditional GANS, discussed below.</p>
</div>
</section>
<section id="S2.SS6" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">2.6 </span>Conditional Generative Adversarial Networks</h3>

<div id="S2.SS6.p1" class="ltx_para">
<p id="S2.SS6.p1.2" class="ltx_p">GANs <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib49" title="" class="ltx_ref">16</a>]</cite> refer to generative networks trained end-to-end through joint optimization with an adversarial discriminator. A GAN targetting <math id="S2.SS6.p1.m1" class="ltx_Math" alttext="p(x)" display="inline" intent=":literal"><semantics><mrow><mi>p</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">p(x)</annotation></semantics></math> can be thought of as a function <math id="S2.SS6.p1.m2" class="ltx_Math" alttext="G_{\theta}:\mathbb{R}^{d_{l}}\to\mathbb{R}^{d_{x}}" display="inline" intent=":literal"><semantics><mrow><msub><mi>G</mi><mi>θ</mi></msub><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><msup><mi>ℝ</mi><msub><mi>d</mi><mi>l</mi></msub></msup><mo stretchy="false">→</mo><msup><mi>ℝ</mi><msub><mi>d</mi><mi>x</mi></msub></msup></mrow></mrow><annotation encoding="application/x-tex">G_{\theta}:\mathbb{R}^{d_{l}}\to\mathbb{R}^{d_{x}}</annotation></semantics></math> such that for an <math id="S2.SS6.p1.m3" class="ltx_Math" alttext="\mathbb{R}^{d_{l}}" display="inline" intent=":literal"><semantics><msup><mi>ℝ</mi><msub><mi>d</mi><mi>l</mi></msub></msup><annotation encoding="application/x-tex">\mathbb{R}^{d_{l}}</annotation></semantics></math>-valued <math id="S2.SS6.p1.m4" class="ltx_Math" alttext="{\mathbf{z}}\sim p_{\text{latent}}" display="inline" intent=":literal"><semantics><mrow><mi>𝐳</mi><mo>∼</mo><msub><mi>p</mi><mtext>latent</mtext></msub></mrow><annotation encoding="application/x-tex">{\mathbf{z}}\sim p_{\text{latent}}</annotation></semantics></math>, <math id="S2.SS6.p1.m5" class="ltx_Math" alttext="G_{\theta}({\mathbf{z}})" display="inline" intent=":literal"><semantics><mrow><msub><mi>G</mi><mi>θ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐳</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">G_{\theta}({\mathbf{z}})</annotation></semantics></math> is approximately a sample from <math id="S2.SS6.p1.m6" class="ltx_Math" alttext="p(x)" display="inline" intent=":literal"><semantics><mrow><mi>p</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">p(x)</annotation></semantics></math>. Wasserstein GANs <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib58" title="" class="ltx_ref">3</a>]</cite> learn <math id="S2.SS6.p1.m7" class="ltx_Math" alttext="\theta" display="inline" intent=":literal"><semantics><mi>θ</mi><annotation encoding="application/x-tex">\theta</annotation></semantics></math> through a loss function related to the Wasserstein-1 loss. Letting <math id="S2.SS6.p1.m8" class="ltx_Math" alttext="(G_{\theta})_{\#}p_{\text{latent}}" display="inline" intent=":literal"><semantics><mrow><msub><mrow><mo stretchy="false">(</mo><msub><mi>G</mi><mi>θ</mi></msub><mo stretchy="false">)</mo></mrow><mi>#</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>p</mi><mtext>latent</mtext></msub></mrow><annotation encoding="application/x-tex">(G_{\theta})_{\#}p_{\text{latent}}</annotation></semantics></math> denote the push-forward measure of <math id="S2.SS6.p1.m9" class="ltx_Math" alttext="p_{\text{latent}}" display="inline" intent=":literal"><semantics><msub><mi>p</mi><mtext>latent</mtext></msub><annotation encoding="application/x-tex">p_{\text{latent}}</annotation></semantics></math> by <math id="S2.SS6.p1.m10" class="ltx_Math" alttext="G_{\theta}" display="inline" intent=":literal"><semantics><msub><mi>G</mi><mi>θ</mi></msub><annotation encoding="application/x-tex">G_{\theta}</annotation></semantics></math>, we have</p>
<table id="S2.E13" class="ltx_equationgroup ltx_eqn_table">
<tbody>
<tr id="S2.E13X" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S2.E13X.m2" class="ltx_Math" alttext="\displaystyle\mathcal{W}_{1}(p_{\mathbf{x}},(G_{\theta})_{\#}p_{\text{latent}})" display="inline" intent=":literal"><semantics><mrow><msub><mi class="ltx_font_mathcaligraphic">𝒲</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>p</mi><mi>𝐱</mi></msub><mo>,</mo><mrow><msub><mrow><mo stretchy="false">(</mo><msub><mi>G</mi><mi>θ</mi></msub><mo stretchy="false">)</mo></mrow><mi>#</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>p</mi><mtext>latent</mtext></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\mathcal{W}_{1}(p_{\mathbf{x}},(G_{\theta})_{\#}p_{\text{latent}})</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S2.E13X.m3" class="ltx_Math" alttext="\displaystyle=\sup_{D\in\mathcal{C}_{1}}\mathbb{E}_{{\mathbf{x}}\sim p(x)}[D({\mathbf{x}})]-\mathbb{E}_{{\mathbf{z}}\sim p(z)}[D(G_{\theta}({\mathbf{z}}))]" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo rspace="0.1389em">=</mo><mrow><mrow><munder><mo lspace="0.1389em" movablelimits="false" rspace="0.167em">sup</mo><mrow><mi>D</mi><mo>∈</mo><msub><mi class="ltx_font_mathcaligraphic">𝒞</mi><mn>1</mn></msub></mrow></munder><mrow><msub><mi>𝔼</mi><mrow><mi>𝐱</mi><mo>∼</mo><mrow><mi>p</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mrow><mi>D</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝐱</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">]</mo></mrow></mrow></mrow><mo>−</mo><mrow><msub><mi>𝔼</mi><mrow><mi>𝐳</mi><mo>∼</mo><mrow><mi>p</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>z</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mrow><mi>D</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>G</mi><mi>θ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐳</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">]</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\sup_{D\in\mathcal{C}_{1}}\mathbb{E}_{{\mathbf{x}}\sim p(x)}[D({\mathbf{x}})]-\mathbb{E}_{{\mathbf{z}}\sim p(z)}[D(G_{\theta}({\mathbf{z}}))]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="2" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equationgroup ltx_align_right">(13)</span></td></tr>
<tr id="S2.E13Xa" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S2.E13Xa.m2" class="ltx_Math" alttext="\displaystyle\approx\sup_{\phi\in C_{1}^{\phi}}\mathbb{E}_{{\mathbf{x}}\sim p(x)}[D_{\phi}({\mathbf{x}})]-\mathbb{E}_{{\mathbf{z}}\sim p_{\text{latent}}}[D_{\phi}(G_{\theta}({\mathbf{z}}))]," display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo rspace="0.1389em">≈</mo><mrow><mrow><munder><mo lspace="0.1389em" movablelimits="false" rspace="0.167em">sup</mo><mrow><mi>ϕ</mi><mo>∈</mo><msubsup><mi>C</mi><mn>1</mn><mi>ϕ</mi></msubsup></mrow></munder><mrow><msub><mi>𝔼</mi><mrow><mi>𝐱</mi><mo>∼</mo><mrow><mi>p</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mrow><msub><mi>D</mi><mi>ϕ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐱</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">]</mo></mrow></mrow></mrow><mo>−</mo><mrow><msub><mi>𝔼</mi><mrow><mi>𝐳</mi><mo>∼</mo><msub><mi>p</mi><mtext>latent</mtext></msub></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mrow><msub><mi>D</mi><mi>ϕ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>G</mi><mi>θ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐳</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">]</mo></mrow></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\approx\sup_{\phi\in C_{1}^{\phi}}\mathbb{E}_{{\mathbf{x}}\sim p(x)}[D_{\phi}({\mathbf{x}})]-\mathbb{E}_{{\mathbf{z}}\sim p_{\text{latent}}}[D_{\phi}(G_{\theta}({\mathbf{z}}))],</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S2.SS6.p1.3" class="ltx_p">where <math id="S2.SS6.p1.m11" class="ltx_Math" alttext="\mathcal{C}_{1}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">𝒞</mi><mn>1</mn></msub><annotation encoding="application/x-tex">\mathcal{C}_{1}</annotation></semantics></math> is the space of 1-Lipschitz functions from <math id="S2.SS6.p1.m12" class="ltx_Math" alttext="\mathbb{R}^{d_{l}}\to\mathbb{R}^{d_{x}}" display="inline" intent=":literal"><semantics><mrow><msup><mi>ℝ</mi><msub><mi>d</mi><mi>l</mi></msub></msup><mo stretchy="false">→</mo><msup><mi>ℝ</mi><msub><mi>d</mi><mi>x</mi></msub></msup></mrow><annotation encoding="application/x-tex">\mathbb{R}^{d_{l}}\to\mathbb{R}^{d_{x}}</annotation></semantics></math>, and <math id="S2.SS6.p1.m13" class="ltx_Math" alttext="C_{1}^{\phi}" display="inline" intent=":literal"><semantics><msubsup><mi>C</mi><mn>1</mn><mi>ϕ</mi></msubsup><annotation encoding="application/x-tex">C_{1}^{\phi}</annotation></semantics></math> is the set of weights <math id="S2.SS6.p1.m14" class="ltx_Math" alttext="\{\phi:D_{\phi}\in\mathcal{C}_{1}\}" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">{</mo><mi>ϕ</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><msub><mi>D</mi><mi>ϕ</mi></msub><mo>∈</mo><msub><mi class="ltx_font_mathcaligraphic">𝒞</mi><mn>1</mn></msub></mrow><mo stretchy="false">}</mo></mrow><annotation encoding="application/x-tex">\{\phi:D_{\phi}\in\mathcal{C}_{1}\}</annotation></semantics></math> for a chosen parametrization <math id="S2.SS6.p1.m15" class="ltx_Math" alttext="\{D_{\phi}:\phi\in\mathcal{C}_{1}^{\phi}\}\subset\mathcal{C}_{1}" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">{</mo><msub><mi>D</mi><mi>ϕ</mi></msub><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi>ϕ</mi><mo>∈</mo><msubsup><mi class="ltx_font_mathcaligraphic">𝒞</mi><mn>1</mn><mi>ϕ</mi></msubsup></mrow><mo stretchy="false">}</mo></mrow><mo>⊂</mo><msub><mi class="ltx_font_mathcaligraphic">𝒞</mi><mn>1</mn></msub></mrow><annotation encoding="application/x-tex">\{D_{\phi}:\phi\in\mathcal{C}_{1}^{\phi}\}\subset\mathcal{C}_{1}</annotation></semantics></math>. Here, <math id="S2.SS6.p1.m16" class="ltx_Math" alttext="D_{\phi}" display="inline" intent=":literal"><semantics><msub><mi>D</mi><mi>ϕ</mi></msub><annotation encoding="application/x-tex">D_{\phi}</annotation></semantics></math> is a discriminator, separating true samples of <math id="S2.SS6.p1.m17" class="ltx_Math" alttext="p_{\mathbf{x}}" display="inline" intent=":literal"><semantics><msub><mi>p</mi><mi>𝐱</mi></msub><annotation encoding="application/x-tex">p_{\mathbf{x}}</annotation></semantics></math> from artificial data sampled through <math id="S2.SS6.p1.m18" class="ltx_Math" alttext="G_{\theta}" display="inline" intent=":literal"><semantics><msub><mi>G</mi><mi>θ</mi></msub><annotation encoding="application/x-tex">G_{\theta}</annotation></semantics></math>. The weights <math id="S2.SS6.p1.m19" class="ltx_Math" alttext="\theta" display="inline" intent=":literal"><semantics><mi>θ</mi><annotation encoding="application/x-tex">\theta</annotation></semantics></math> and <math id="S2.SS6.p1.m20" class="ltx_Math" alttext="\phi" display="inline" intent=":literal"><semantics><mi>ϕ</mi><annotation encoding="application/x-tex">\phi</annotation></semantics></math> are trained by jointly minimising (<a href="#S2.E13" title="Equation 13 ‣ 2.6 Conditional Generative Adversarial Networks ‣ 2 Background, Notation and Related Works ‣ Deep unfolding of MCMC kernels: scalable, modular &amp; explainable GANs for high-dimensional posterior sampling" class="ltx_ref"><span class="ltx_text ltx_ref_tag">13</span></a>) for <math id="S2.SS6.p1.m21" class="ltx_Math" alttext="\theta" display="inline" intent=":literal"><semantics><mi>θ</mi><annotation encoding="application/x-tex">\theta</annotation></semantics></math>, while maximising for <math id="S2.SS6.p1.m22" class="ltx_Math" alttext="\phi" display="inline" intent=":literal"><semantics><mi>ϕ</mi><annotation encoding="application/x-tex">\phi</annotation></semantics></math> over finite batches of samples from <math id="S2.SS6.p1.m23" class="ltx_Math" alttext="p(x)" display="inline" intent=":literal"><semantics><mrow><mi>p</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">p(x)</annotation></semantics></math>. The constraint <math id="S2.SS6.p1.m24" class="ltx_Math" alttext="\sup_{\phi\in C_{1}^{\phi}}" display="inline" intent=":literal"><semantics><msub><mo>sup</mo><mrow><mi>ϕ</mi><mo>∈</mo><msubsup><mi>C</mi><mn>1</mn><mi>ϕ</mi></msubsup></mrow></msub><annotation encoding="application/x-tex">\sup_{\phi\in C_{1}^{\phi}}</annotation></semantics></math> is typically relaxed through imposing a gradient penalty term, which acts as a Lagrangian <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib60" title="" class="ltx_ref">19</a>]</cite>.</p>
</div>
<div id="S2.SS6.p2" class="ltx_para">
<p id="S2.SS6.p2.2" class="ltx_p">Conditional GANs <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib37" title="" class="ltx_ref">28</a>, <a href="#bib.bib48" title="" class="ltx_ref">1</a>, <a href="#bib.bib1" title="" class="ltx_ref">4</a>]</cite> extend this methodology to train a conditional generator <math id="S2.SS6.p2.m1" class="ltx_Math" alttext="{G_{\theta}:\mathbb{R}^{d_{l}}\times\mathbb{R}^{{d_{y}}}\to\mathbb{R}^{d_{x}}}" display="inline" intent=":literal"><semantics><mrow><msub><mi>G</mi><mi>θ</mi></msub><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mrow><msup><mi>ℝ</mi><msub><mi>d</mi><mi>l</mi></msub></msup><mo lspace="0.222em" rspace="0.222em">×</mo><msup><mi>ℝ</mi><msub><mi>d</mi><mi>y</mi></msub></msup></mrow><mo stretchy="false">→</mo><msup><mi>ℝ</mi><msub><mi>d</mi><mi>x</mi></msub></msup></mrow></mrow><annotation encoding="application/x-tex">{G_{\theta}:\mathbb{R}^{d_{l}}\times\mathbb{R}^{{d_{y}}}\to\mathbb{R}^{d_{x}}}</annotation></semantics></math>, embedding the posterior distribution <math id="S2.SS6.p2.m2" class="ltx_Math" alttext="p(x|y)" display="inline" intent=":literal"><semantics><mrow><mi>p</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo lspace="0em" rspace="0em">|</mo><mi>y</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">p(x|y)</annotation></semantics></math>, given both the latent variable <math id="S2.SS6.p2.m3" class="ltx_Math" alttext="{\mathbf{z}}" display="inline" intent=":literal"><semantics><mi>𝐳</mi><annotation encoding="application/x-tex">{\mathbf{z}}</annotation></semantics></math> and <math id="S2.SS6.p2.m4" class="ltx_Math" alttext="y" display="inline" intent=":literal"><semantics><mi>y</mi><annotation encoding="application/x-tex">y</annotation></semantics></math> as input. Letting <math id="S2.SS6.p2.m5" class="ltx_Math" alttext="{\mathbf{x}}_{\theta}^{y}\sim G_{\theta}(\cdot,y)_{\#}p_{\text{latent}}" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>𝐱</mi><mi>θ</mi><mi>y</mi></msubsup><mo>∼</mo><mrow><msub><mi>G</mi><mi>θ</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo>,</mo><mi>y</mi><mo stretchy="false">)</mo></mrow><mi>#</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>p</mi><mtext>latent</mtext></msub></mrow></mrow><annotation encoding="application/x-tex">{\mathbf{x}}_{\theta}^{y}\sim G_{\theta}(\cdot,y)_{\#}p_{\text{latent}}</annotation></semantics></math>, the Wasserstein loss function targeting the joint-distribution becomes</p>
<table id="S2.E14" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S2.E14.m1" class="ltx_Math" alttext="\mathcal{W}_{1}(p_{{\mathbf{x}},{\mathbf{y}}},p_{{\mathbf{x}}_{\theta}^{\mathbf{y}},{\mathbf{y}}})\approx\sup_{\phi\in\mathcal{C}_{1}^{\phi}}\mathbb{E}_{{\mathbf{x}},{\mathbf{y}}\sim p_{{\mathbf{x}},{\mathbf{y}}}}[D_{\phi}({\mathbf{x}},{\mathbf{y}})]-\mathbb{E}_{{\mathbf{z}}\sim p_{\text{latent}},{\mathbf{y}}\sim p_{\mathbf{y}}}[D_{\phi}(G_{\theta}({\mathbf{z}},{\mathbf{y}}),{\mathbf{y}})]," display="block" intent=":literal"><semantics><mrow><mrow><mrow><msub><mi class="ltx_font_mathcaligraphic">𝒲</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>p</mi><mrow><mi>𝐱</mi><mo>,</mo><mi>𝐲</mi></mrow></msub><mo>,</mo><msub><mi>p</mi><mrow><msubsup><mi>𝐱</mi><mi>θ</mi><mi>𝐲</mi></msubsup><mo>,</mo><mi>𝐲</mi></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><mo rspace="0.1389em">≈</mo><mrow><mrow><munder><mo lspace="0.1389em" movablelimits="false" rspace="0.167em">sup</mo><mrow><mi>ϕ</mi><mo>∈</mo><msubsup><mi class="ltx_font_mathcaligraphic">𝒞</mi><mn>1</mn><mi>ϕ</mi></msubsup></mrow></munder><mrow><msub><mi>𝔼</mi><mrow><mrow><mi>𝐱</mi><mo>,</mo><mi>𝐲</mi></mrow><mo>∼</mo><msub><mi>p</mi><mrow><mi>𝐱</mi><mo>,</mo><mi>𝐲</mi></mrow></msub></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mrow><msub><mi>D</mi><mi>ϕ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐱</mi><mo>,</mo><mi>𝐲</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">]</mo></mrow></mrow></mrow><mo>−</mo><mrow><msub><mi>𝔼</mi><mrow><mrow><mi>𝐳</mi><mo>∼</mo><msub><mi>p</mi><mtext>latent</mtext></msub></mrow><mo>,</mo><mrow><mi>𝐲</mi><mo>∼</mo><msub><mi>p</mi><mi>𝐲</mi></msub></mrow></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mrow><msub><mi>D</mi><mi>ϕ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>G</mi><mi>θ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐳</mi><mo>,</mo><mi>𝐲</mi><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mi>𝐲</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">]</mo></mrow></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\mathcal{W}_{1}(p_{{\mathbf{x}},{\mathbf{y}}},p_{{\mathbf{x}}_{\theta}^{\mathbf{y}},{\mathbf{y}}})\approx\sup_{\phi\in\mathcal{C}_{1}^{\phi}}\mathbb{E}_{{\mathbf{x}},{\mathbf{y}}\sim p_{{\mathbf{x}},{\mathbf{y}}}}[D_{\phi}({\mathbf{x}},{\mathbf{y}})]-\mathbb{E}_{{\mathbf{z}}\sim p_{\text{latent}},{\mathbf{y}}\sim p_{\mathbf{y}}}[D_{\phi}(G_{\theta}({\mathbf{z}},{\mathbf{y}}),{\mathbf{y}})],</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(14)</span></td></tr></tbody>
</table>
<p id="S2.SS6.p2.3" class="ltx_p">where the discriminator <math id="S2.SS6.p2.m6" class="ltx_Math" alttext="D_{\phi}:\mathbb{R}^{d_{l}}\times\mathbb{R}^{{d_{y}}}\to\mathbb{R}^{d_{x}}" display="inline" intent=":literal"><semantics><mrow><msub><mi>D</mi><mi>ϕ</mi></msub><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mrow><msup><mi>ℝ</mi><msub><mi>d</mi><mi>l</mi></msub></msup><mo lspace="0.222em" rspace="0.222em">×</mo><msup><mi>ℝ</mi><msub><mi>d</mi><mi>y</mi></msub></msup></mrow><mo stretchy="false">→</mo><msup><mi>ℝ</mi><msub><mi>d</mi><mi>x</mi></msub></msup></mrow></mrow><annotation encoding="application/x-tex">D_{\phi}:\mathbb{R}^{d_{l}}\times\mathbb{R}^{{d_{y}}}\to\mathbb{R}^{d_{x}}</annotation></semantics></math> encodes additionally the observation <math id="S2.SS6.p2.m7" class="ltx_Math" alttext="{\mathbf{y}}" display="inline" intent=":literal"><semantics><mi>𝐲</mi><annotation encoding="application/x-tex">{\mathbf{y}}</annotation></semantics></math> as input. The weights <math id="S2.SS6.p2.m8" class="ltx_Math" alttext="\theta" display="inline" intent=":literal"><semantics><mi>θ</mi><annotation encoding="application/x-tex">\theta</annotation></semantics></math> and <math id="S2.SS6.p2.m9" class="ltx_Math" alttext="\phi" display="inline" intent=":literal"><semantics><mi>ϕ</mi><annotation encoding="application/x-tex">\phi</annotation></semantics></math> for the conditional GAN can be again solved through a min/max optimization process with a Lagrangian to promote the constraint on <math id="S2.SS6.p2.m10" class="ltx_Math" alttext="\phi" display="inline" intent=":literal"><semantics><mi>ϕ</mi><annotation encoding="application/x-tex">\phi</annotation></semantics></math>. Training solely on a conditional adversarial objective in this manner typically leads to mode collapse among posterior samples <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib1" title="" class="ltx_ref">4</a>]</cite>. As a result, it is beneficial to add extra regularisation terms promoting data consistency. In <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib1" title="" class="ltx_ref">4</a>]</cite>, an <math id="S2.SS6.p2.m11" class="ltx_Math" alttext="\mathcal{L}_{1}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">ℒ</mi><mn>1</mn></msub><annotation encoding="application/x-tex">\mathcal{L}_{1}</annotation></semantics></math>-regularisation term is proposed based on the <math id="S2.SS6.p2.m12" class="ltx_Math" alttext="P" display="inline" intent=":literal"><semantics><mi>P</mi><annotation encoding="application/x-tex">P</annotation></semantics></math>-sample posterior mean with a carefully-tuned standard deviation reward of the form</p>
<table id="S2.E15" class="ltx_equationgroup ltx_eqn_table">
<tbody>
<tr id="S2.E15X" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S2.E15X.m2" class="ltx_Math" alttext="\displaystyle\mathcal{L}_{1,\text{SD}}(\theta)=" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi class="ltx_font_mathcaligraphic">ℒ</mi><mrow><mn>1</mn><mo>,</mo><mtext>SD</mtext></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>θ</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mphantom></mphantom></mrow><annotation encoding="application/x-tex">\displaystyle\mathcal{L}_{1,\text{SD}}(\theta)=</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S2.E15X.m3" class="ltx_Math" alttext="\displaystyle\mathbb{E}\left[\left\|{\mathbf{x}}-\frac{1}{P}\sum_{i=1}^{P}G_{\theta}({\mathbf{z}}^{(i)},{\mathbf{y}})\right\|_{1}\right]" display="inline" intent=":literal"><semantics><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><msub><mrow><mo>‖</mo><mrow><mi>𝐱</mi><mo>−</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>P</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>P</mi></munderover></mstyle><mrow><msub><mi>G</mi><mi>θ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>𝐳</mi><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></msup><mo>,</mo><mi>𝐲</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow></mrow><mo>‖</mo></mrow><mn>1</mn></msub><mo>]</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\mathbb{E}\left[\left\|{\mathbf{x}}-\frac{1}{P}\sum_{i=1}^{P}G_{\theta}({\mathbf{z}}^{(i)},{\mathbf{y}})\right\|_{1}\right]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="2" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equationgroup ltx_align_right">(15)</span></td></tr>
<tr id="S2.E15Xa" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S2.E15Xa.m2" class="ltx_Math" alttext="\displaystyle-w_{\text{SD}}\sum_{i=1}^{P}\mathbb{E}\left[\left\|G_{\theta}({\mathbf{z}}^{(i)},{\mathbf{y}})-\frac{1}{P}\sum_{i=1}^{P}G_{\theta}({\mathbf{z}}^{(i)},{\mathbf{y}})\right\|_{1}\right]." display="inline" intent=":literal"><semantics><mrow><mo>−</mo><mi>w</mi><msub><mrow></mrow><mtext>SD</mtext></msub><mstyle displaystyle="true"><mo movablelimits="false">∑</mo></mstyle><msub><mrow></mrow><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow></msub><msup><mrow></mrow><mi>P</mi></msup><mi>𝔼</mi><mo>[</mo><mo>‖</mo><mi>G</mi><msub><mrow></mrow><mi>θ</mi></msub><mo stretchy="false">(</mo><mi>𝐳</mi><msup><mrow></mrow><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></msup><mo>,</mo><mi>𝐲</mi><mo stretchy="false">)</mo><mo>−</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>P</mi></mfrac></mstyle><mstyle displaystyle="true"><mo movablelimits="false">∑</mo></mstyle><msub><mrow></mrow><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow></msub><msup><mrow></mrow><mi>P</mi></msup><mi>G</mi><msub><mrow></mrow><mi>θ</mi></msub><mo stretchy="false">(</mo><mi>𝐳</mi><msup><mrow></mrow><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></msup><mo>,</mo><mi>𝐲</mi><mo stretchy="false">)</mo><mo>‖</mo><msub><mrow></mrow><mn>1</mn></msub><mo>]</mo><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle-w_{\text{SD}}\sum_{i=1}^{P}\mathbb{E}\left[\left\|G_{\theta}({\mathbf{z}}^{(i)},{\mathbf{y}})-\frac{1}{P}\sum_{i=1}^{P}G_{\theta}({\mathbf{z}}^{(i)},{\mathbf{y}})\right\|_{1}\right].</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S2.SS6.p2.4" class="ltx_p">For <math id="S2.SS6.p2.m13" class="ltx_Math" alttext="x,y\sim p_{{\mathbf{x}},{\mathbf{y}}}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>x</mi><mo>,</mo><mi>y</mi></mrow><mo>∼</mo><msub><mi>p</mi><mrow><mi>𝐱</mi><mo>,</mo><mi>𝐲</mi></mrow></msub></mrow><annotation encoding="application/x-tex">x,y\sim p_{{\mathbf{x}},{\mathbf{y}}}</annotation></semantics></math> the first component promotes that the mean of <math id="S2.SS6.p2.m14" class="ltx_Math" alttext="(G_{\theta}(\cdot,y))_{\#}p_{\text{latent}}" display="inline" intent=":literal"><semantics><mrow><msub><mrow><mo stretchy="false">(</mo><mrow><msub><mi>G</mi><mi>θ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo>,</mo><mi>y</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow><mi>#</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>p</mi><mtext>latent</mtext></msub></mrow><annotation encoding="application/x-tex">(G_{\theta}(\cdot,y))_{\#}p_{\text{latent}}</annotation></semantics></math> lies close to <math id="S2.SS6.p2.m15" class="ltx_Math" alttext="x" display="inline" intent=":literal"><semantics><mi>x</mi><annotation encoding="application/x-tex">x</annotation></semantics></math>. The latter component is a standard deviation reward promoting diverse samples. During the training phase, the weight <math id="S2.SS6.p2.m16" class="ltx_Math" alttext="w_{\text{SD}}" display="inline" intent=":literal"><semantics><msub><mi>w</mi><mtext>SD</mtext></msub><annotation encoding="application/x-tex">w_{\text{SD}}</annotation></semantics></math> is carefully tuned online using a moment-matching procedure during frequent validation phases to promote <math id="S2.SS6.p2.m17" class="ltx_Math" alttext="\theta" display="inline" intent=":literal"><semantics><mi>θ</mi><annotation encoding="application/x-tex">\theta</annotation></semantics></math> with an accurate standard deviation. This fine-tuning of <math id="S2.SS6.p2.m18" class="ltx_Math" alttext="w_{\text{SD}}" display="inline" intent=":literal"><semantics><msub><mi>w</mi><mtext>SD</mtext></msub><annotation encoding="application/x-tex">w_{\text{SD}}</annotation></semantics></math> is performed using the observation that if <math id="S2.SS6.p2.m19" class="ltx_Math" alttext="(G_{\theta}(\cdot,y))_{\#}p_{\text{latent}}=p(x|y)" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mrow><mo stretchy="false">(</mo><mrow><msub><mi>G</mi><mi>θ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo>,</mo><mi>y</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow><mi>#</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>p</mi><mtext>latent</mtext></msub></mrow><mo>=</mo><mrow><mi>p</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo lspace="0em" rspace="0em">|</mo><mi>y</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">(G_{\theta}(\cdot,y))_{\#}p_{\text{latent}}=p(x|y)</annotation></semantics></math>, then</p>
<table id="S2.E16" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S2.E16.m1" class="ltx_Math" alttext="\frac{\mathbb{E}[\|{\mathbf{x}}-G_{\theta}({\mathbf{z}},{\mathbf{y}})\|^{2}]}{\mathbb{E}[\|{\mathbf{x}}-{N_{\text{val}}}^{-1}\sum_{i=0}^{N_{\text{val}}}\mathcal{G}_{\theta}({\mathbf{z}}^{(i)},{\mathbf{y}})\|^{2}]}=2\frac{N_{\text{val}}+1}{N_{\text{val}}}." display="block" intent=":literal"><semantics><mrow><mrow><mfrac><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><msup><mrow><mo stretchy="false">‖</mo><mrow><mi>𝐱</mi><mo>−</mo><mrow><msub><mi>G</mi><mi>θ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐳</mi><mo>,</mo><mi>𝐲</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup><mo stretchy="false">]</mo></mrow></mrow><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><msup><mrow><mo stretchy="false">‖</mo><mrow><mi>𝐱</mi><mo>−</mo><mrow><mmultiscripts><mi>N</mi><mtext>val</mtext><mrow></mrow><mrow></mrow><mrow><mo>−</mo><mn>1</mn></mrow></mmultiscripts><mo lspace="0em" rspace="0em">​</mo><mrow><msubsup><mo>∑</mo><mrow><mi>i</mi><mo>=</mo><mn>0</mn></mrow><msub><mi>N</mi><mtext>val</mtext></msub></msubsup><mrow><msub><mi class="ltx_font_mathcaligraphic">𝒢</mi><mi>θ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>𝐳</mi><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></msup><mo>,</mo><mi>𝐲</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup><mo stretchy="false">]</mo></mrow></mrow></mfrac><mo>=</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mfrac><mrow><msub><mi>N</mi><mtext>val</mtext></msub><mo>+</mo><mn>1</mn></mrow><msub><mi>N</mi><mtext>val</mtext></msub></mfrac></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\frac{\mathbb{E}[\|{\mathbf{x}}-G_{\theta}({\mathbf{z}},{\mathbf{y}})\|^{2}]}{\mathbb{E}[\|{\mathbf{x}}-{N_{\text{val}}}^{-1}\sum_{i=0}^{N_{\text{val}}}\mathcal{G}_{\theta}({\mathbf{z}}^{(i)},{\mathbf{y}})\|^{2}]}=2\frac{N_{\text{val}}+1}{N_{\text{val}}}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(16)</span></td></tr></tbody>
</table>
<p id="S2.SS6.p2.5" class="ltx_p">Empirically, the left hand side of the above term with <math id="S2.SS6.p2.m20" class="ltx_Math" alttext="\theta" display="inline" intent=":literal"><semantics><mi>θ</mi><annotation encoding="application/x-tex">\theta</annotation></semantics></math> trained with penalty factor <math id="S2.SS6.p2.m21" class="ltx_Math" alttext="w_{\text{SD}}" display="inline" intent=":literal"><semantics><msub><mi>w</mi><mtext>SD</mtext></msub><annotation encoding="application/x-tex">w_{\text{SD}}</annotation></semantics></math> is found to a monotone in <math id="S2.SS6.p2.m22" class="ltx_Math" alttext="w_{\text{SD}}" display="inline" intent=":literal"><semantics><msub><mi>w</mi><mtext>SD</mtext></msub><annotation encoding="application/x-tex">w_{\text{SD}}</annotation></semantics></math>. A Robbins-Monro step is thus employed during each validation phase to find the root <math id="S2.SS6.p2.m23" class="ltx_Math" alttext="w_{\text{SD}}" display="inline" intent=":literal"><semantics><msub><mi>w</mi><mtext>SD</mtext></msub><annotation encoding="application/x-tex">w_{\text{SD}}</annotation></semantics></math> which satisfies the above inequality.
In <a href="#S3.SS2" title="3.2 Regularised Adversarial Training ‣ 3 Proposed Methodology ‣ Deep unfolding of MCMC kernels: scalable, modular &amp; explainable GANs for high-dimensional posterior sampling" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Section</span> <span class="ltx_text ltx_ref_tag">3.2</span></a>, we leverage this approach to learn weights for efficient posterior sampling through an unfolded Markov kernel (<a href="#S3.E17" title="Equation 17 ‣ 3.1 Architecture ‣ 3 Proposed Methodology ‣ Deep unfolding of MCMC kernels: scalable, modular &amp; explainable GANs for high-dimensional posterior sampling" class="ltx_ref"><span class="ltx_text ltx_ref_tag">17</span></a>).</p>
</div>
</section>
</section>
<section id="S3" class="ltx_section">
<h2 class="ltx_title ltx_title_section"><span class="ltx_tag ltx_tag_section">3 </span>Proposed Methodology</h2>

<section id="S3.SS1" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">3.1 </span>Architecture</h3>

<div id="S3.SS1.p1" class="ltx_para">
<p id="S3.SS1.p1.1" class="ltx_p">Inspired by deep unfolding of iterative optimization schemes, we propose a novel framework for unfolding MCMC chains to obtain efficient sampling of posterior data. Specifically, we view samples from the distribution</p>
<table id="S3.E17" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S3.E17.m1" class="ltx_math_unparsed" alttext="\mathcal{K}_{\Theta,L}(\cdot,y)=(\kappa_{L,\vartheta_{L},\theta}\circ\cdots\circ\kappa_{0,\vartheta_{0},\theta})(\cdot,y)" display="block" intent=":literal"><semantics><mrow><msub><mi class="ltx_font_mathcaligraphic">𝒦</mi><mrow><mi mathvariant="normal">Θ</mi><mo>,</mo><mi>L</mi></mrow></msub><mrow><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo>,</mo><mi>y</mi><mo stretchy="false">)</mo></mrow><mo>=</mo><mrow><mo stretchy="false">(</mo><msub><mi>κ</mi><mrow><mi>L</mi><mo>,</mo><msub><mi>ϑ</mi><mi>L</mi></msub><mo>,</mo><mi>θ</mi></mrow></msub><mo lspace="0.222em">∘</mo><mo lspace="0.055em" rspace="0.055em">⋯</mo><mo rspace="0.222em">∘</mo><msub><mi>κ</mi><mrow><mn>0</mn><mo>,</mo><msub><mi>ϑ</mi><mn>0</mn></msub><mo>,</mo><mi>θ</mi></mrow></msub><mo stretchy="false">)</mo></mrow><mrow><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo>,</mo><mi>y</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathcal{K}_{\Theta,L}(\cdot,y)=(\kappa_{L,\vartheta_{L},\theta}\circ\cdots\circ\kappa_{0,\vartheta_{0},\theta})(\cdot,y)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(17)</span></td></tr></tbody>
</table>
<p id="S3.SS1.p1.2" class="ltx_p">as outputs from a conditional generative network targeting the distribution <math id="S3.SS1.p1.m1" class="ltx_Math" alttext="p(x|y)" display="inline" intent=":literal"><semantics><mrow><mi>p</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo lspace="0em" rspace="0em">|</mo><mi>y</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">p(x|y)</annotation></semantics></math> with trainable weights <math id="S3.SS1.p1.m2" class="ltx_Math" alttext="\Theta=[\vartheta_{0},\dots,\vartheta_{L},\theta]" display="inline" intent=":literal"><semantics><mrow><mi mathvariant="normal">Θ</mi><mo>=</mo><mrow><mo stretchy="false">[</mo><mrow><msub><mi>ϑ</mi><mn>0</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>ϑ</mi><mi>L</mi></msub><mo>,</mo><mi>θ</mi></mrow><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">\Theta=[\vartheta_{0},\dots,\vartheta_{L},\theta]</annotation></semantics></math>. In a crucial difference from unfolded optimisation networks, we promote weights <math id="S3.SS1.p1.m3" class="ltx_Math" alttext="\Theta" display="inline" intent=":literal"><semantics><mi mathvariant="normal">Θ</mi><annotation encoding="application/x-tex">\Theta</annotation></semantics></math> which provide an accurate representation of the entire posterior distribution. In particular, we wish to train <math id="S3.SS1.p1.m4" class="ltx_Math" alttext="\Theta" display="inline" intent=":literal"><semantics><mi mathvariant="normal">Θ</mi><annotation encoding="application/x-tex">\Theta</annotation></semantics></math> to ensure <math id="S3.SS1.p1.m5" class="ltx_Math" alttext="\mathcal{K}_{\Theta,L}(x,y)" display="inline" intent=":literal"><semantics><mrow><msub><mi class="ltx_font_mathcaligraphic">𝒦</mi><mrow><mi mathvariant="normal">Θ</mi><mo>,</mo><mi>L</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>y</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathcal{K}_{\Theta,L}(x,y)</annotation></semantics></math> is a good approximation of the posterior <math id="S3.SS1.p1.m6" class="ltx_Math" alttext="p(x|y)" display="inline" intent=":literal"><semantics><mrow><mi>p</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo lspace="0em" rspace="0em">|</mo><mi>y</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">p(x|y)</annotation></semantics></math> given a new sample <math id="S3.SS1.p1.m7" class="ltx_Math" alttext="y\sim p_{\mathbf{y}}" display="inline" intent=":literal"><semantics><mrow><mi>y</mi><mo>∼</mo><msub><mi>p</mi><mi>𝐲</mi></msub></mrow><annotation encoding="application/x-tex">y\sim p_{\mathbf{y}}</annotation></semantics></math>.
We sample <math id="S3.SS1.p1.m8" class="ltx_Math" alttext="\mathcal{K}_{\Theta,L}(\cdot,y)" display="inline" intent=":literal"><semantics><mrow><msub><mi class="ltx_font_mathcaligraphic">𝒦</mi><mrow><mi mathvariant="normal">Θ</mi><mo>,</mo><mi>L</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo>,</mo><mi>y</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathcal{K}_{\Theta,L}(\cdot,y)</annotation></semantics></math> by generating a Markov chain through the transitions (<a href="#S2.E8" title="Equation 8 ‣ 2.4 Markov Chain Monte Carlo ‣ 2 Background, Notation and Related Works ‣ Deep unfolding of MCMC kernels: scalable, modular &amp; explainable GANs for high-dimensional posterior sampling" class="ltx_ref"><span class="ltx_text ltx_ref_tag">8</span></a>). Allowing for a suitable burn-in period <math id="S3.SS1.p1.m9" class="ltx_Math" alttext="L_{0}\geq 0" display="inline" intent=":literal"><semantics><mrow><msub><mi>L</mi><mn>0</mn></msub><mo>≥</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">L_{0}\geq 0</annotation></semantics></math>, we can treat the output of each layer <math id="S3.SS1.p1.m10" class="ltx_Math" alttext="\ell\geq L_{0}" display="inline" intent=":literal"><semantics><mrow><mi mathvariant="normal">ℓ</mi><mo>≥</mo><msub><mi>L</mi><mn>0</mn></msub></mrow><annotation encoding="application/x-tex">\ell\geq L_{0}</annotation></semantics></math> as an approximate sample from the underlying distribution. Specifically, for a given <math id="S3.SS1.p1.m11" class="ltx_Math" alttext="y\in\mathbb{R}^{{d_{y}}}" display="inline" intent=":literal"><semantics><mrow><mi>y</mi><mo>∈</mo><msup><mi>ℝ</mi><msub><mi>d</mi><mi>y</mi></msub></msup></mrow><annotation encoding="application/x-tex">y\in\mathbb{R}^{{d_{y}}}</annotation></semantics></math>, we then define the <math id="S3.SS1.p1.m12" class="ltx_Math" alttext="\mathbb{R}^{(L+1-L_{0})d_{x}}" display="inline" intent=":literal"><semantics><msup><mi>ℝ</mi><mrow><mrow><mo stretchy="false">(</mo><mrow><mrow><mi>L</mi><mo>+</mo><mn>1</mn></mrow><mo>−</mo><msub><mi>L</mi><mn>0</mn></msub></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>d</mi><mi>x</mi></msub></mrow></msup><annotation encoding="application/x-tex">\mathbb{R}^{(L+1-L_{0})d_{x}}</annotation></semantics></math>-valued random variable <math id="S3.SS1.p1.m13" class="ltx_math_unparsed" alttext="{\mathbf{x}}_{L_{0}:L,\Theta}^{y}=[{\mathbf{x}}_{L_{0},\Theta}^{y},\dots,{\mathbf{x}}_{L,\Theta}^{y}]" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>𝐱</mi><mrow><msub><mi>L</mi><mn>0</mn></msub><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi>L</mi><mo>,</mo><mi mathvariant="normal">Θ</mi></mrow></mrow><mi>y</mi></msubsup><mo>=</mo><mrow><mo stretchy="false">[</mo><msubsup><mi>𝐱</mi><mrow><msub><mi>L</mi><mn>0</mn></msub><mo>,</mo><mi mathvariant="normal">Θ</mi></mrow><mi>y</mi></msubsup><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msubsup><mi>𝐱</mi><mrow><mi>L</mi><mo>,</mo><mi mathvariant="normal">Θ</mi></mrow><mi>y</mi></msubsup><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">{\mathbf{x}}_{L_{0}:L,\Theta}^{y}=[{\mathbf{x}}_{L_{0},\Theta}^{y},\dots,{\mathbf{x}}_{L,\Theta}^{y}]</annotation></semantics></math> such that <math id="S3.SS1.p1.m14" class="ltx_Math" alttext="{\mathbf{x}}_{L_{0},\Theta}^{y}\sim\mathcal{K}_{\Theta,L_{0}}(\cdot,y)" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>𝐱</mi><mrow><msub><mi>L</mi><mn>0</mn></msub><mo>,</mo><mi mathvariant="normal">Θ</mi></mrow><mi>y</mi></msubsup><mo>∼</mo><mrow><msub><mi class="ltx_font_mathcaligraphic">𝒦</mi><mrow><mi mathvariant="normal">Θ</mi><mo>,</mo><msub><mi>L</mi><mn>0</mn></msub></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo>,</mo><mi>y</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">{\mathbf{x}}_{L_{0},\Theta}^{y}\sim\mathcal{K}_{\Theta,L_{0}}(\cdot,y)</annotation></semantics></math> and <math id="S3.SS1.p1.m15" class="ltx_Math" alttext="{\mathbf{x}}_{\ell+1,\Theta}^{y}\sim\kappa_{\ell,\vartheta_{\ell},\theta}(\cdot,{\mathbf{x}}_{\ell+1,\Theta}^{y};y)" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>𝐱</mi><mrow><mrow><mi mathvariant="normal">ℓ</mi><mo>+</mo><mn>1</mn></mrow><mo>,</mo><mi mathvariant="normal">Θ</mi></mrow><mi>y</mi></msubsup><mo>∼</mo><mrow><msub><mi>κ</mi><mrow><mi mathvariant="normal">ℓ</mi><mo>,</mo><msub><mi>ϑ</mi><mi mathvariant="normal">ℓ</mi></msub><mo>,</mo><mi>θ</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo>,</mo><msubsup><mi>𝐱</mi><mrow><mrow><mi mathvariant="normal">ℓ</mi><mo>+</mo><mn>1</mn></mrow><mo>,</mo><mi mathvariant="normal">Θ</mi></mrow><mi>y</mi></msubsup><mo>,</mo><mi>y</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">{\mathbf{x}}_{\ell+1,\Theta}^{y}\sim\kappa_{\ell,\vartheta_{\ell},\theta}(\cdot,{\mathbf{x}}_{\ell+1,\Theta}^{y};y)</annotation></semantics></math> for <math id="S3.SS1.p1.m16" class="ltx_Math" alttext="L_{0}\leq\ell\leq L-1" display="inline" intent=":literal"><semantics><mrow><msub><mi>L</mi><mn>0</mn></msub><mo>≤</mo><mi mathvariant="normal">ℓ</mi><mo>≤</mo><mrow><mi>L</mi><mo>−</mo><mn>1</mn></mrow></mrow><annotation encoding="application/x-tex">L_{0}\leq\ell\leq L-1</annotation></semantics></math>.</p>
</div>
<div id="S3.SS1.p2" class="ltx_para">
<p id="S3.SS1.p2.1" class="ltx_p">The proposed architecture is illustrated in <a href="#S2.F1.sf2" title="In Figure 1 ‣ 2.1 Setup and notation ‣ 2 Background, Notation and Related Works ‣ Deep unfolding of MCMC kernels: scalable, modular &amp; explainable GANs for high-dimensional posterior sampling" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Figure</span> <span class="ltx_text ltx_ref_tag">1(b)</span></a>. Leveraging the interpretability of each Markov transition (<a href="#S2.E8" title="Equation 8 ‣ 2.4 Markov Chain Monte Carlo ‣ 2 Background, Notation and Related Works ‣ Deep unfolding of MCMC kernels: scalable, modular &amp; explainable GANs for high-dimensional posterior sampling" class="ltx_ref"><span class="ltx_text ltx_ref_tag">8</span></a>), the resulting model strikes a careful balance between the computational efficiency and complex embeddings of black-box conditional GANs and the modularity of MCMC techniques. Through aggregating dependent samples along trajectories of this truncated Markov Chain, a numerical study in <a href="#S4" title="4 Numerical Experiments ‣ Deep unfolding of MCMC kernels: scalable, modular &amp; explainable GANs for high-dimensional posterior sampling" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Section</span> <span class="ltx_text ltx_ref_tag">4</span></a> shows the proposed unfolded MCMC method has a natural ability to produce reliable and efficient uncertainty and statistical analyses for new observation data.</p>
</div>
</section>
<section id="S3.SS2" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">3.2 </span>Regularised Adversarial Training</h3>

<div id="S3.SS2.p1" class="ltx_para">
<p id="S3.SS2.p1.1" class="ltx_p">The proposed method adapts ideas from conditional GANs to fit the Markovian nature of the unfolded MCMC network. In summary: we apply conditional adversarial training to promote <math id="S3.SS2.p1.m1" class="ltx_Math" alttext="{\mathbf{x}}_{\ell+1,\Theta}^{y}\sim\kappa_{\ell,\vartheta_{\ell},\theta}" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>𝐱</mi><mrow><mrow><mi mathvariant="normal">ℓ</mi><mo>+</mo><mn>1</mn></mrow><mo>,</mo><mi mathvariant="normal">Θ</mi></mrow><mi>y</mi></msubsup><mo>∼</mo><msub><mi>κ</mi><mrow><mi mathvariant="normal">ℓ</mi><mo>,</mo><msub><mi>ϑ</mi><mi mathvariant="normal">ℓ</mi></msub><mo>,</mo><mi>θ</mi></mrow></msub></mrow><annotation encoding="application/x-tex">{\mathbf{x}}_{\ell+1,\Theta}^{y}\sim\kappa_{\ell,\vartheta_{\ell},\theta}</annotation></semantics></math> to be approximately distributed like <math id="S3.SS2.p1.m2" class="ltx_Math" alttext="p(x|y)" display="inline" intent=":literal"><semantics><mrow><mi>p</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo lspace="0em" rspace="0em">|</mo><mi>y</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">p(x|y)</annotation></semantics></math> for <math id="S3.SS2.p1.m3" class="ltx_Math" alttext="L_{0}\leq\ell\leq L" display="inline" intent=":literal"><semantics><mrow><msub><mi>L</mi><mn>0</mn></msub><mo>≤</mo><mi mathvariant="normal">ℓ</mi><mo>≤</mo><mi>L</mi></mrow><annotation encoding="application/x-tex">L_{0}\leq\ell\leq L</annotation></semantics></math>. Following <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib1" title="" class="ltx_ref">4</a>]</cite>, we add <math id="S3.SS2.p1.m4" class="ltx_Math" alttext="\mathcal{L}_{1}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">ℒ</mi><mn>1</mn></msub><annotation encoding="application/x-tex">\mathcal{L}_{1}</annotation></semantics></math>-regularisation to promote the sample mean</p>
<table id="S3.Ex2" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S3.Ex2.m1" class="ltx_math_unparsed" alttext="\overline{{\mathbf{x}}}_{L_{0}:L,\Theta}^{y}:=\frac{1}{L-L_{0}+1}\sum_{\ell=L_{0}}^{L}{\mathbf{x}}_{\ell,\Theta}^{y}" display="block" intent=":literal"><semantics><mrow><mover accent="true"><mi>𝐱</mi><mo stretchy="true">¯</mo></mover><msub><mrow></mrow><mrow><msub><mi>L</mi><mn>0</mn></msub><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi>L</mi><mo>,</mo><mi mathvariant="normal">Θ</mi></mrow></mrow></msub><msup><mrow></mrow><mi>y</mi></msup><mo>:=</mo><mfrac><mn>1</mn><mrow><mrow><mi>L</mi><mo>−</mo><msub><mi>L</mi><mn>0</mn></msub></mrow><mo>+</mo><mn>1</mn></mrow></mfrac><mo movablelimits="false">∑</mo><msub><mrow></mrow><mrow><mi mathvariant="normal">ℓ</mi><mo>=</mo><msub><mi>L</mi><mn>0</mn></msub></mrow></msub><msup><mrow></mrow><mi>L</mi></msup><mi>𝐱</mi><msub><mrow></mrow><mrow><mi mathvariant="normal">ℓ</mi><mo>,</mo><mi mathvariant="normal">Θ</mi></mrow></msub><msup><mrow></mrow><mi>y</mi></msup></mrow><annotation encoding="application/x-tex">\overline{{\mathbf{x}}}_{L_{0}:L,\Theta}^{y}:=\frac{1}{L-L_{0}+1}\sum_{\ell=L_{0}}^{L}{\mathbf{x}}_{\ell,\Theta}^{y}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S3.SS2.p1.2" class="ltx_p">to lie close to ground-truth data in mean-square error. For unfolded networks, the gradients of a loss function calculated only on the output <math id="S3.SS2.p1.m5" class="ltx_Math" alttext="\hat{x}_{L}" display="inline" intent=":literal"><semantics><msub><mover accent="true"><mi>x</mi><mo>^</mo></mover><mi>L</mi></msub><annotation encoding="application/x-tex">\hat{x}_{L}</annotation></semantics></math> with respect to parameters <math id="S3.SS2.p1.m6" class="ltx_Math" alttext="\vartheta_{\ell}" display="inline" intent=":literal"><semantics><msub><mi>ϑ</mi><mi mathvariant="normal">ℓ</mi></msub><annotation encoding="application/x-tex">\vartheta_{\ell}</annotation></semantics></math> with <math id="S3.SS2.p1.m7" class="ltx_Math" alttext="\ell" display="inline" intent=":literal"><semantics><mi mathvariant="normal">ℓ</mi><annotation encoding="application/x-tex">\ell</annotation></semantics></math> fixed are known to vanish as <math id="S3.SS2.p1.m8" class="ltx_Math" alttext="L" display="inline" intent=":literal"><semantics><mi>L</mi><annotation encoding="application/x-tex">L</annotation></semantics></math> increases. By including the sample mean in the loss calculation, we abate the vanishing gradient problem prevalent in unfolded networks.</p>
</div>
<div id="S3.SS2.p2" class="ltx_para">
<p id="S3.SS2.p2.1" class="ltx_p">The weights <math id="S3.SS2.p2.m1" class="ltx_Math" alttext="\Theta" display="inline" intent=":literal"><semantics><mi mathvariant="normal">Θ</mi><annotation encoding="application/x-tex">\Theta</annotation></semantics></math> are learned to minimise a training loss of the form <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib1" title="" class="ltx_ref">4</a>]</cite></p>
<table id="S3.E18" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S3.E18.m1" class="ltx_Math" alttext="\mathcal{L}(\Theta)=\underbrace{\mathcal{L}_{\text{adv}}(\Theta;\phi)}_{\text{Adversarial Loss}}+\underbrace{w_{1}\mathcal{L}_{1}(\Theta)}_{\text{Data-consistency}}-\underbrace{w_{\text{SD}}\mathcal{L}_{\text{SD}}(\Theta)}_{\text{Sample diversity}}," display="block" intent=":literal"><semantics><mrow><mrow><mrow><mi class="ltx_font_mathcaligraphic">ℒ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi mathvariant="normal">Θ</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mrow><munder><munder accentunder="true"><mrow><msub><mi class="ltx_font_mathcaligraphic">ℒ</mi><mtext>adv</mtext></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi mathvariant="normal">Θ</mi><mo>,</mo><mi>ϕ</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="true">⏟</mo></munder><mtext>Adversarial Loss</mtext></munder><mo>+</mo><munder><munder accentunder="true"><mrow><msub><mi>w</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi class="ltx_font_mathcaligraphic">ℒ</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi mathvariant="normal">Θ</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="true">⏟</mo></munder><mtext>Data-consistency</mtext></munder></mrow><mo>−</mo><munder><munder accentunder="true"><mrow><msub><mi>w</mi><mtext>SD</mtext></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi class="ltx_font_mathcaligraphic">ℒ</mi><mtext>SD</mtext></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi mathvariant="normal">Θ</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="true">⏟</mo></munder><mtext>Sample diversity</mtext></munder></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\mathcal{L}(\Theta)=\underbrace{\mathcal{L}_{\text{adv}}(\Theta;\phi)}_{\text{Adversarial Loss}}+\underbrace{w_{1}\mathcal{L}_{1}(\Theta)}_{\text{Data-consistency}}-\underbrace{w_{\text{SD}}\mathcal{L}_{\text{SD}}(\Theta)}_{\text{Sample diversity}},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(18)</span></td></tr></tbody>
</table>
<p id="S3.SS2.p2.2" class="ltx_p">where <math id="S3.SS2.p2.m2" class="ltx_Math" alttext="w_{1}" display="inline" intent=":literal"><semantics><msub><mi>w</mi><mn>1</mn></msub><annotation encoding="application/x-tex">w_{1}</annotation></semantics></math> and <math id="S3.SS2.p2.m3" class="ltx_Math" alttext="w_{\text{SD}}" display="inline" intent=":literal"><semantics><msub><mi>w</mi><mtext>SD</mtext></msub><annotation encoding="application/x-tex">w_{\text{SD}}</annotation></semantics></math> are positive regularisation weights and the learnable weights <math id="S3.SS2.p2.m4" class="ltx_Math" alttext="\phi" display="inline" intent=":literal"><semantics><mi>ϕ</mi><annotation encoding="application/x-tex">\phi</annotation></semantics></math> parametrise an adversarial discriminator as in <a href="#S2.SS6" title="2.6 Conditional Generative Adversarial Networks ‣ 2 Background, Notation and Related Works ‣ Deep unfolding of MCMC kernels: scalable, modular &amp; explainable GANs for high-dimensional posterior sampling" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Section</span> <span class="ltx_text ltx_ref_tag">2.6</span></a>. We consider each component of this loss separately in detail below.</p>
</div>
<div id="S3.SS2.p3" class="ltx_para">
<p id="S3.SS2.p3.2" class="ltx_p">The adversarial loss <math id="S3.SS2.p3.m1" class="ltx_Math" alttext="\mathcal{L}_{\text{adv}}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">ℒ</mi><mtext>adv</mtext></msub><annotation encoding="application/x-tex">\mathcal{L}_{\text{adv}}</annotation></semantics></math> is designed to move the measures <math id="S3.SS2.p3.m2" class="ltx_Math" alttext="\mathcal{K}_{\ell,\Theta}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">𝒦</mi><mrow><mi mathvariant="normal">ℓ</mi><mo>,</mo><mi mathvariant="normal">Θ</mi></mrow></msub><annotation encoding="application/x-tex">\mathcal{K}_{\ell,\Theta}</annotation></semantics></math> close to <math id="S3.SS2.p3.m3" class="ltx_Math" alttext="p(x|y)" display="inline" intent=":literal"><semantics><mrow><mi>p</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo lspace="0em" rspace="0em">|</mo><mi>y</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">p(x|y)</annotation></semantics></math> for <math id="S3.SS2.p3.m4" class="ltx_Math" alttext="L_{0}\leq\ell\leq L" display="inline" intent=":literal"><semantics><mrow><msub><mi>L</mi><mn>0</mn></msub><mo>≤</mo><mi mathvariant="normal">ℓ</mi><mo>≤</mo><mi>L</mi></mrow><annotation encoding="application/x-tex">L_{0}\leq\ell\leq L</annotation></semantics></math>. We apply a conditional Wasserstein loss (<a href="#S2.E14" title="Equation 14 ‣ 2.6 Conditional Generative Adversarial Networks ‣ 2 Background, Notation and Related Works ‣ Deep unfolding of MCMC kernels: scalable, modular &amp; explainable GANs for high-dimensional posterior sampling" class="ltx_ref"><span class="ltx_text ltx_ref_tag">14</span></a>) to randomly sampled layers <math id="S3.SS2.p3.m5" class="ltx_Math" alttext="{\mathbf{l}}\sim\mathcal{U}(\{L_{0},\dots,L\})" display="inline" intent=":literal"><semantics><mrow><mi>𝐥</mi><mo>∼</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒰</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mo stretchy="false">{</mo><msub><mi>L</mi><mn>0</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mi>L</mi><mo stretchy="false">}</mo></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">{\mathbf{l}}\sim\mathcal{U}(\{L_{0},\dots,L\})</annotation></semantics></math> of the unfolded MCMC network. In particular, we motivate <math id="S3.SS2.p3.m6" class="ltx_Math" alttext="\mathcal{L}_{\text{adv}}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">ℒ</mi><mtext>adv</mtext></msub><annotation encoding="application/x-tex">\mathcal{L}_{\text{adv}}</annotation></semantics></math> through the approximation</p>
<table id="S3.E19" class="ltx_equationgroup ltx_eqn_table">
<tbody>
<tr id="S3.E19X" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S3.E19X.m2" class="ltx_Math" alttext="\displaystyle\sum_{\ell=L_{0}}^{L}\mathcal{W}_{1}\big(p_{{\mathbf{x}},{\mathbf{y}}},\ p_{{\mathbf{x}}_{\ell,\Theta}^{\mathbf{y}},{\mathbf{y}}}\big)" display="inline" intent=":literal"><semantics><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi mathvariant="normal">ℓ</mi><mo>=</mo><msub><mi>L</mi><mn>0</mn></msub></mrow><mi>L</mi></munderover></mstyle><mrow><msub><mi class="ltx_font_mathcaligraphic">𝒲</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><msub><mi>p</mi><mrow><mi>𝐱</mi><mo>,</mo><mi>𝐲</mi></mrow></msub><mo mathsize="1.200em">,</mo><msub><mi>p</mi><mrow><msubsup><mi>𝐱</mi><mrow><mi mathvariant="normal">ℓ</mi><mo>,</mo><mi mathvariant="normal">Θ</mi></mrow><mi>𝐲</mi></msubsup><mo>,</mo><mi>𝐲</mi></mrow></msub><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\sum_{\ell=L_{0}}^{L}\mathcal{W}_{1}\big(p_{{\mathbf{x}},{\mathbf{y}}},\ p_{{\mathbf{x}}_{\ell,\Theta}^{\mathbf{y}},{\mathbf{y}}}\big)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="4" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equationgroup ltx_align_right">(19)</span></td></tr>
<tr id="S3.E19Xa" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S3.E19Xa.m2" class="ltx_Math" alttext="\displaystyle\propto\mathbb{E}_{{\mathbf{l}}\sim\mathcal{U}(\{L_{0},\dots,L\})}\bigg[\mathcal{W}_{1}\big(p_{{\mathbf{x}},{\mathbf{y}}},\ p_{{\mathbf{x}}_{{\mathbf{l}},\Theta}^{\mathbf{y}},{\mathbf{y}}}\big)\bigg]" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>∝</mo><mrow><msub><mi>𝔼</mi><mrow><mi>𝐥</mi><mo>∼</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒰</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mo stretchy="false">{</mo><msub><mi>L</mi><mn>0</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mi>L</mi><mo stretchy="false">}</mo></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="2.100em" minsize="2.100em">[</mo><mrow><msub><mi class="ltx_font_mathcaligraphic">𝒲</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><msub><mi>p</mi><mrow><mi>𝐱</mi><mo>,</mo><mi>𝐲</mi></mrow></msub><mo mathsize="2.100em">,</mo><msub><mi>p</mi><mrow><msubsup><mi>𝐱</mi><mrow><mi>𝐥</mi><mo>,</mo><mi mathvariant="normal">Θ</mi></mrow><mi>𝐲</mi></msubsup><mo>,</mo><mi>𝐲</mi></mrow></msub><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow></mrow><mo maxsize="2.100em" minsize="2.100em">]</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\propto\mathbb{E}_{{\mathbf{l}}\sim\mathcal{U}(\{L_{0},\dots,L\})}\bigg[\mathcal{W}_{1}\big(p_{{\mathbf{x}},{\mathbf{y}}},\ p_{{\mathbf{x}}_{{\mathbf{l}},\Theta}^{\mathbf{y}},{\mathbf{y}}}\big)\bigg]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr>
<tr id="S3.E19Xb" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S3.E19Xb.m2" class="ltx_Math" alttext="\displaystyle=\mathbb{E}_{{\mathbf{l}}\sim\mathcal{U}(\{L_{0},\dots,L\})}\bigg[\sup_{D\in\mathcal{C}_{1}}\left\{\mathbb{E}_{{\mathbf{x}},{\mathbf{y}}\sim p_{{\mathbf{x}},{\mathbf{y}}}}[D({\mathbf{x}},{\mathbf{y}})]-\mathbb{E}_{{\mathbf{x}}_{{\mathbf{l}},\Theta}^{\mathbf{y}},{\mathbf{y}}\sim p_{{\mathbf{x}}_{{\mathbf{l}},\Theta}^{\mathbf{y}},{\mathbf{y}}}}[D({\mathbf{x}}_{{\mathbf{l}},\Theta}^{\mathbf{y}},{\mathbf{y}})]\right\}\bigg]" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><msub><mi>𝔼</mi><mrow><mi>𝐥</mi><mo>∼</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒰</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mo stretchy="false">{</mo><msub><mi>L</mi><mn>0</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mi>L</mi><mo stretchy="false">}</mo></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="2.100em" minsize="2.100em">[</mo><mrow><munder><mo lspace="0em" movablelimits="false" rspace="0em">sup</mo><mrow><mi>D</mi><mo>∈</mo><msub><mi class="ltx_font_mathcaligraphic">𝒞</mi><mn>1</mn></msub></mrow></munder><mrow><mo>{</mo><mrow><mrow><msub><mi>𝔼</mi><mrow><mrow><mi>𝐱</mi><mo>,</mo><mi>𝐲</mi></mrow><mo>∼</mo><msub><mi>p</mi><mrow><mi>𝐱</mi><mo>,</mo><mi>𝐲</mi></mrow></msub></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mrow><mi>D</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝐱</mi><mo mathsize="2.100em">,</mo><mi>𝐲</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">]</mo></mrow></mrow><mo>−</mo><mrow><msub><mi>𝔼</mi><mrow><msubsup><mi>𝐱</mi><mrow><mi>𝐥</mi><mo>,</mo><mi mathvariant="normal">Θ</mi></mrow><mi>𝐲</mi></msubsup><mo>,</mo><mrow><mi>𝐲</mi><mo>∼</mo><msub><mi>p</mi><mrow><msubsup><mi>𝐱</mi><mrow><mi>𝐥</mi><mo>,</mo><mi mathvariant="normal">Θ</mi></mrow><mi>𝐲</mi></msubsup><mo>,</mo><mi>𝐲</mi></mrow></msub></mrow></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mrow><mi>D</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>𝐱</mi><mrow><mi>𝐥</mi><mo>,</mo><mi mathvariant="normal">Θ</mi></mrow><mi>𝐲</mi></msubsup><mo mathsize="2.100em">,</mo><mi>𝐲</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">]</mo></mrow></mrow></mrow><mo>}</mo></mrow></mrow><mo maxsize="2.100em" minsize="2.100em">]</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\mathbb{E}_{{\mathbf{l}}\sim\mathcal{U}(\{L_{0},\dots,L\})}\bigg[\sup_{D\in\mathcal{C}_{1}}\left\{\mathbb{E}_{{\mathbf{x}},{\mathbf{y}}\sim p_{{\mathbf{x}},{\mathbf{y}}}}[D({\mathbf{x}},{\mathbf{y}})]-\mathbb{E}_{{\mathbf{x}}_{{\mathbf{l}},\Theta}^{\mathbf{y}},{\mathbf{y}}\sim p_{{\mathbf{x}}_{{\mathbf{l}},\Theta}^{\mathbf{y}},{\mathbf{y}}}}[D({\mathbf{x}}_{{\mathbf{l}},\Theta}^{\mathbf{y}},{\mathbf{y}})]\right\}\bigg]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr>
<tr id="S3.E19Xc" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S3.E19Xc.m2" class="ltx_Math" alttext="\displaystyle\approx\mathbb{E}_{{\mathbf{l}}\sim\mathcal{U}(\{L_{0},\dots,L\})}\left[\sup_{\phi\in C_{1}^{\phi}}\left\{\mathbb{E}_{{\mathbf{x}},{\mathbf{y}}\sim p_{{\mathbf{x}},{\mathbf{y}}}}[D_{\phi}({\mathbf{x}},{\mathbf{y}})]-\mathbb{E}_{{\mathbf{x}}_{{\mathbf{l}},\Theta}^{\mathbf{y}},{\mathbf{y}}\sim p_{{\mathbf{x}}_{{\mathbf{l}},\Theta}^{\mathbf{y}},{\mathbf{y}}}}[D_{\phi}({\mathbf{x}}_{{\mathbf{l}},\Theta}^{\mathbf{y}},{\mathbf{y}})]\right\}\right]" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≈</mo><mrow><msub><mi>𝔼</mi><mrow><mi>𝐥</mi><mo>∼</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒰</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mo stretchy="false">{</mo><msub><mi>L</mi><mn>0</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mi>L</mi><mo stretchy="false">}</mo></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><mrow><munder><mo lspace="0em" movablelimits="false" rspace="0em">sup</mo><mrow><mi>ϕ</mi><mo>∈</mo><msubsup><mi>C</mi><mn>1</mn><mi>ϕ</mi></msubsup></mrow></munder><mrow><mo>{</mo><mrow><mrow><msub><mi>𝔼</mi><mrow><mrow><mi>𝐱</mi><mo>,</mo><mi>𝐲</mi></mrow><mo>∼</mo><msub><mi>p</mi><mrow><mi>𝐱</mi><mo>,</mo><mi>𝐲</mi></mrow></msub></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mrow><msub><mi>D</mi><mi>ϕ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐱</mi><mo>,</mo><mi>𝐲</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">]</mo></mrow></mrow><mo>−</mo><mrow><msub><mi>𝔼</mi><mrow><msubsup><mi>𝐱</mi><mrow><mi>𝐥</mi><mo>,</mo><mi mathvariant="normal">Θ</mi></mrow><mi>𝐲</mi></msubsup><mo>,</mo><mrow><mi>𝐲</mi><mo>∼</mo><msub><mi>p</mi><mrow><msubsup><mi>𝐱</mi><mrow><mi>𝐥</mi><mo>,</mo><mi mathvariant="normal">Θ</mi></mrow><mi>𝐲</mi></msubsup><mo>,</mo><mi>𝐲</mi></mrow></msub></mrow></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mrow><msub><mi>D</mi><mi>ϕ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>𝐱</mi><mrow><mi>𝐥</mi><mo>,</mo><mi mathvariant="normal">Θ</mi></mrow><mi>𝐲</mi></msubsup><mo>,</mo><mi>𝐲</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">]</mo></mrow></mrow></mrow><mo>}</mo></mrow></mrow><mo>]</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\approx\mathbb{E}_{{\mathbf{l}}\sim\mathcal{U}(\{L_{0},\dots,L\})}\left[\sup_{\phi\in C_{1}^{\phi}}\left\{\mathbb{E}_{{\mathbf{x}},{\mathbf{y}}\sim p_{{\mathbf{x}},{\mathbf{y}}}}[D_{\phi}({\mathbf{x}},{\mathbf{y}})]-\mathbb{E}_{{\mathbf{x}}_{{\mathbf{l}},\Theta}^{\mathbf{y}},{\mathbf{y}}\sim p_{{\mathbf{x}}_{{\mathbf{l}},\Theta}^{\mathbf{y}},{\mathbf{y}}}}[D_{\phi}({\mathbf{x}}_{{\mathbf{l}},\Theta}^{\mathbf{y}},{\mathbf{y}})]\right\}\right]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S3.SS2.p3.3" class="ltx_p">where we use the same terminology as <a href="#S2.SS6" title="2.6 Conditional Generative Adversarial Networks ‣ 2 Background, Notation and Related Works ‣ Deep unfolding of MCMC kernels: scalable, modular &amp; explainable GANs for high-dimensional posterior sampling" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Section</span> <span class="ltx_text ltx_ref_tag">2.6</span></a>. In particular, <math id="S3.SS2.p3.m7" class="ltx_Math" alttext="D_{\phi}" display="inline" intent=":literal"><semantics><msub><mi>D</mi><mi>ϕ</mi></msub><annotation encoding="application/x-tex">D_{\phi}</annotation></semantics></math> is a deep neural-network based discriminator with learnable weights <math id="S3.SS2.p3.m8" class="ltx_Math" alttext="\phi" display="inline" intent=":literal"><semantics><mi>ϕ</mi><annotation encoding="application/x-tex">\phi</annotation></semantics></math> tuned to solve the maximisation problem in (<a href="#S3.E19" title="Equation 19 ‣ 3.2 Regularised Adversarial Training ‣ 3 Proposed Methodology ‣ Deep unfolding of MCMC kernels: scalable, modular &amp; explainable GANs for high-dimensional posterior sampling" class="ltx_ref"><span class="ltx_text ltx_ref_tag">19</span></a>). For a given <math id="S3.SS2.p3.m9" class="ltx_Math" alttext="\phi\in C_{1}^{\phi}" display="inline" intent=":literal"><semantics><mrow><mi>ϕ</mi><mo>∈</mo><msubsup><mi>C</mi><mn>1</mn><mi>ϕ</mi></msubsup></mrow><annotation encoding="application/x-tex">\phi\in C_{1}^{\phi}</annotation></semantics></math>, we thus consider</p>
<table id="S3.Ex3" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S3.Ex3.m1" class="ltx_Math" alttext="\mathcal{L}_{\text{adv}}(\Theta;\phi)=\mathbb{E}_{{\mathbf{l}}\sim\mathcal{U}(\{L_{0},\dots,L\})}\left[\mathbb{E}_{{\mathbf{x}},{\mathbf{y}}\sim p_{{\mathbf{x}},{\mathbf{y}}}}[D_{\phi}({\mathbf{x}},{\mathbf{y}})]-\mathbb{E}_{{\mathbf{x}}_{{\mathbf{l}},\Theta}^{\mathbf{y}},{\mathbf{y}}\sim p_{{\mathbf{x}}_{{\mathbf{l}},\Theta}^{\mathbf{y}},{\mathbf{y}}}}[D_{\phi}({\mathbf{x}}_{{\mathbf{l}},\Theta}^{\mathbf{y}},{\mathbf{y}})]\right]." display="block" intent=":literal"><semantics><mrow><mrow><mrow><msub><mi class="ltx_font_mathcaligraphic">ℒ</mi><mtext>adv</mtext></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi mathvariant="normal">Θ</mi><mo>,</mo><mi>ϕ</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><msub><mi>𝔼</mi><mrow><mi>𝐥</mi><mo>∼</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒰</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mo stretchy="false">{</mo><msub><mi>L</mi><mn>0</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mi>L</mi><mo stretchy="false">}</mo></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><mrow><mrow><msub><mi>𝔼</mi><mrow><mrow><mi>𝐱</mi><mo>,</mo><mi>𝐲</mi></mrow><mo>∼</mo><msub><mi>p</mi><mrow><mi>𝐱</mi><mo>,</mo><mi>𝐲</mi></mrow></msub></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mrow><msub><mi>D</mi><mi>ϕ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐱</mi><mo>,</mo><mi>𝐲</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">]</mo></mrow></mrow><mo>−</mo><mrow><msub><mi>𝔼</mi><mrow><msubsup><mi>𝐱</mi><mrow><mi>𝐥</mi><mo>,</mo><mi mathvariant="normal">Θ</mi></mrow><mi>𝐲</mi></msubsup><mo>,</mo><mrow><mi>𝐲</mi><mo>∼</mo><msub><mi>p</mi><mrow><msubsup><mi>𝐱</mi><mrow><mi>𝐥</mi><mo>,</mo><mi mathvariant="normal">Θ</mi></mrow><mi>𝐲</mi></msubsup><mo>,</mo><mi>𝐲</mi></mrow></msub></mrow></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mrow><msub><mi>D</mi><mi>ϕ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>𝐱</mi><mrow><mi>𝐥</mi><mo>,</mo><mi mathvariant="normal">Θ</mi></mrow><mi>𝐲</mi></msubsup><mo>,</mo><mi>𝐲</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">]</mo></mrow></mrow></mrow><mo>]</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\mathcal{L}_{\text{adv}}(\Theta;\phi)=\mathbb{E}_{{\mathbf{l}}\sim\mathcal{U}(\{L_{0},\dots,L\})}\left[\mathbb{E}_{{\mathbf{x}},{\mathbf{y}}\sim p_{{\mathbf{x}},{\mathbf{y}}}}[D_{\phi}({\mathbf{x}},{\mathbf{y}})]-\mathbb{E}_{{\mathbf{x}}_{{\mathbf{l}},\Theta}^{\mathbf{y}},{\mathbf{y}}\sim p_{{\mathbf{x}}_{{\mathbf{l}},\Theta}^{\mathbf{y}},{\mathbf{y}}}}[D_{\phi}({\mathbf{x}}_{{\mathbf{l}},\Theta}^{\mathbf{y}},{\mathbf{y}})]\right].</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S3.SS2.p3.4" class="ltx_p">Following standard practice for training GANs <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib49" title="" class="ltx_ref">16</a>, <a href="#bib.bib58" title="" class="ltx_ref">3</a>]</cite>, we learn <math id="S3.SS2.p3.m10" class="ltx_Math" alttext="\phi" display="inline" intent=":literal"><semantics><mi>ϕ</mi><annotation encoding="application/x-tex">\phi</annotation></semantics></math> jointly with <math id="S3.SS2.p3.m11" class="ltx_Math" alttext="\Theta" display="inline" intent=":literal"><semantics><mi mathvariant="normal">Θ</mi><annotation encoding="application/x-tex">\Theta</annotation></semantics></math>. Introducing a penalty <math id="S3.SS2.p3.m12" class="ltx_Math" alttext="\mathcal{L}_{\text{GP}}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">ℒ</mi><mtext>GP</mtext></msub><annotation encoding="application/x-tex">\mathcal{L}_{\text{GP}}</annotation></semantics></math> to promote the condition <math id="S3.SS2.p3.m13" class="ltx_Math" alttext="\phi\in C_{1}^{\phi}" display="inline" intent=":literal"><semantics><mrow><mi>ϕ</mi><mo>∈</mo><msubsup><mi>C</mi><mn>1</mn><mi>ϕ</mi></msubsup></mrow><annotation encoding="application/x-tex">\phi\in C_{1}^{\phi}</annotation></semantics></math>, <math id="S3.SS2.p3.m14" class="ltx_Math" alttext="\phi" display="inline" intent=":literal"><semantics><mi>ϕ</mi><annotation encoding="application/x-tex">\phi</annotation></semantics></math> is trained to minimize the loss</p>
<table id="S3.Ex4" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S3.Ex4.m1" class="ltx_Math" alttext="\mathcal{L}_{\text{disc}}(\phi;\Theta)=-\mathcal{L}_{\text{adv}}(\Theta;\phi)+\mathcal{L}_{\text{GP}}(\phi;\Theta)." display="block" intent=":literal"><semantics><mrow><mrow><mrow><msub><mi class="ltx_font_mathcaligraphic">ℒ</mi><mtext>disc</mtext></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>ϕ</mi><mo>,</mo><mi mathvariant="normal">Θ</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mrow><mo>−</mo><mrow><msub><mi class="ltx_font_mathcaligraphic">ℒ</mi><mtext>adv</mtext></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi mathvariant="normal">Θ</mi><mo>,</mo><mi>ϕ</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>+</mo><mrow><msub><mi class="ltx_font_mathcaligraphic">ℒ</mi><mtext>GP</mtext></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>ϕ</mi><mo>,</mo><mi mathvariant="normal">Θ</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\mathcal{L}_{\text{disc}}(\phi;\Theta)=-\mathcal{L}_{\text{adv}}(\Theta;\phi)+\mathcal{L}_{\text{GP}}(\phi;\Theta).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S3.SS2.p3.5" class="ltx_p">As in <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib1" title="" class="ltx_ref">4</a>]</cite>, <math id="S3.SS2.p3.m15" class="ltx_Math" alttext="\mathcal{L}_{\text{GP}}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">ℒ</mi><mtext>GP</mtext></msub><annotation encoding="application/x-tex">\mathcal{L}_{\text{GP}}</annotation></semantics></math> is a gradient penalty adapted from <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib60" title="" class="ltx_ref">19</a>]</cite> to discriminators trained on the joint distribution <math id="S3.SS2.p3.m16" class="ltx_Math" alttext="p_{{\mathbf{x}},{\mathbf{y}}}" display="inline" intent=":literal"><semantics><msub><mi>p</mi><mrow><mi>𝐱</mi><mo>,</mo><mi>𝐲</mi></mrow></msub><annotation encoding="application/x-tex">p_{{\mathbf{x}},{\mathbf{y}}}</annotation></semantics></math></p>
<table id="S3.Ex5" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S3.Ex5.m1" class="ltx_Math" alttext="\mathcal{L}_{\text{GP}}(\phi;\Theta)=\mathbb{E}_{\begin{subarray}{c}\alpha\sim\mathcal{U}([0,1])\\
{\mathbf{l}}\sim\mathcal{U}(\{L_{0},\dots,L\})\\
{\mathbf{x}},{\mathbf{y}}\sim p_{{\mathbf{x}},{\mathbf{y}}}\\
{\mathbf{x}}_{{\mathbf{l}},\Theta}^{y}\sim\mathcal{K}_{{\mathbf{l}},\Theta}(\cdot;{\mathbf{y}})\end{subarray}}\left[\Big(\big\|\nabla_{x}D_{\phi}(\alpha{\mathbf{x}}+(1-\alpha){\mathbf{x}}_{{\mathbf{l}},\Theta}^{\mathbf{y}},{\mathbf{y}})\big\|-1\Big)^{2}\right]," display="block" intent=":literal"><semantics><mrow><mrow><mrow><msub><mi class="ltx_font_mathcaligraphic">ℒ</mi><mtext>GP</mtext></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>ϕ</mi><mo>,</mo><mi mathvariant="normal">Θ</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><msub><mi>𝔼</mi><mtable rowspacing="0pt"><mtr><mtd><mrow><mi>α</mi><mo>∼</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒰</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mo stretchy="false">[</mo><mrow><mn>0</mn><mo>,</mo><mn>1</mn></mrow><mo stretchy="false">]</mo></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mtd></mtr><mtr><mtd><mrow><mi>𝐥</mi><mo>∼</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒰</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mo stretchy="false">{</mo><msub><mi>L</mi><mn>0</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mi>L</mi><mo stretchy="false">}</mo></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mtd></mtr><mtr><mtd><mrow><mrow><mi>𝐱</mi><mo>,</mo><mi>𝐲</mi></mrow><mo>∼</mo><msub><mi>p</mi><mrow><mi>𝐱</mi><mo>,</mo><mi>𝐲</mi></mrow></msub></mrow></mtd></mtr><mtr><mtd><mrow><msubsup><mi>𝐱</mi><mrow><mi>𝐥</mi><mo>,</mo><mi mathvariant="normal">Θ</mi></mrow><mi>y</mi></msubsup><mo>∼</mo><mrow><msub><mi class="ltx_font_mathcaligraphic">𝒦</mi><mrow><mi>𝐥</mi><mo>,</mo><mi mathvariant="normal">Θ</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo>,</mo><mi>𝐲</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mtd></mtr></mtable></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><msup><mrow><mo maxsize="1.600em" minsize="1.600em">(</mo><mrow><mrow><mo maxsize="1.200em" minsize="1.200em" stretchy="true">‖</mo><mrow><mrow><msub><mo rspace="0.167em">∇</mo><mi>x</mi></msub><msub><mi>D</mi><mi>ϕ</mi></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mi>α</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝐱</mi></mrow><mo>+</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>α</mi></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝐱</mi><mrow><mi>𝐥</mi><mo>,</mo><mi mathvariant="normal">Θ</mi></mrow><mi>𝐲</mi></msubsup></mrow></mrow><mo>,</mo><mi>𝐲</mi><mo stretchy="false">)</mo></mrow></mrow><mo maxsize="1.200em" minsize="1.200em" stretchy="true">‖</mo></mrow><mo>−</mo><mn>1</mn></mrow><mo maxsize="1.600em" minsize="1.600em">)</mo></mrow><mn>2</mn></msup><mo>]</mo></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\mathcal{L}_{\text{GP}}(\phi;\Theta)=\mathbb{E}_{\begin{subarray}{c}\alpha\sim\mathcal{U}([0,1])\\
{\mathbf{l}}\sim\mathcal{U}(\{L_{0},\dots,L\})\\
{\mathbf{x}},{\mathbf{y}}\sim p_{{\mathbf{x}},{\mathbf{y}}}\\
{\mathbf{x}}_{{\mathbf{l}},\Theta}^{y}\sim\mathcal{K}_{{\mathbf{l}},\Theta}(\cdot;{\mathbf{y}})\end{subarray}}\left[\Big(\big\|\nabla_{x}D_{\phi}(\alpha{\mathbf{x}}+(1-\alpha){\mathbf{x}}_{{\mathbf{l}},\Theta}^{\mathbf{y}},{\mathbf{y}})\big\|-1\Big)^{2}\right],</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S3.SS2.p3.6" class="ltx_p">which promotes <math id="S3.SS2.p3.m17" class="ltx_Math" alttext="D_{\phi}" display="inline" intent=":literal"><semantics><msub><mi>D</mi><mi>ϕ</mi></msub><annotation encoding="application/x-tex">D_{\phi}</annotation></semantics></math> to be 1-Lipschitz on the space of feasible image pairs. In practice, both <math id="S3.SS2.p3.m18" class="ltx_Math" alttext="\mathcal{L}_{\text{adv}}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">ℒ</mi><mtext>adv</mtext></msub><annotation encoding="application/x-tex">\mathcal{L}_{\text{adv}}</annotation></semantics></math> and <math id="S3.SS2.p3.m19" class="ltx_Math" alttext="\mathcal{L}_{\text{disc}}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">ℒ</mi><mtext>disc</mtext></msub><annotation encoding="application/x-tex">\mathcal{L}_{\text{disc}}</annotation></semantics></math> are approximated using minibatches of data, with randomly sampled layers <math id="S3.SS2.p3.m20" class="ltx_Math" alttext="\ell\sim{\mathbf{l}}" display="inline" intent=":literal"><semantics><mrow><mi mathvariant="normal">ℓ</mi><mo>∼</mo><mi>𝐥</mi></mrow><annotation encoding="application/x-tex">\ell\sim{\mathbf{l}}</annotation></semantics></math> among which we choose to discriminate samples. The weights <math id="S3.SS2.p3.m21" class="ltx_Math" alttext="\theta" display="inline" intent=":literal"><semantics><mi>θ</mi><annotation encoding="application/x-tex">\theta</annotation></semantics></math> are then learned using stochastic optimisation techniques. In <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib59" title="" class="ltx_ref">57</a>]</cite>, it was shown that joint optimization of the objectives <math id="S3.SS2.p3.m22" class="ltx_Math" alttext="\mathcal{L}_{\text{adv}}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">ℒ</mi><mtext>adv</mtext></msub><annotation encoding="application/x-tex">\mathcal{L}_{\text{adv}}</annotation></semantics></math> and <math id="S3.SS2.p3.m23" class="ltx_Math" alttext="\mathcal{L}_{\text{disc}}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">ℒ</mi><mtext>disc</mtext></msub><annotation encoding="application/x-tex">\mathcal{L}_{\text{disc}}</annotation></semantics></math> using mini-batching leads to a heavily biased approximation of the Wasserstein distance. A Lipschitz-continuous discriminator was shown empirically to create an accurate solution landscape for the min-max game (<a href="#S3.E19" title="Equation 19 ‣ 3.2 Regularised Adversarial Training ‣ 3 Proposed Methodology ‣ Deep unfolding of MCMC kernels: scalable, modular &amp; explainable GANs for high-dimensional posterior sampling" class="ltx_ref"><span class="ltx_text ltx_ref_tag">19</span></a>).</p>
</div>
<div id="S3.SS2.p4" class="ltx_para">
<p id="S3.SS2.p4.1" class="ltx_p">As discussed in <a href="#S2.SS6" title="2.6 Conditional Generative Adversarial Networks ‣ 2 Background, Notation and Related Works ‣ Deep unfolding of MCMC kernels: scalable, modular &amp; explainable GANs for high-dimensional posterior sampling" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Section</span> <span class="ltx_text ltx_ref_tag">2.6</span></a>, training solely on an adversarial objective typically leads to mode collapse among posterior samples. To avoid this, as a key development for our method we adapt the regularisation term (<a href="#S2.E15" title="Equation 15 ‣ 2.6 Conditional Generative Adversarial Networks ‣ 2 Background, Notation and Related Works ‣ Deep unfolding of MCMC kernels: scalable, modular &amp; explainable GANs for high-dimensional posterior sampling" class="ltx_ref"><span class="ltx_text ltx_ref_tag">15</span></a>) borrowing from the concept of skip connection components in deep neural networks to fit the Markovian nature of the unrolled measure (<a href="#S3.E17" title="Equation 17 ‣ 3.1 Architecture ‣ 3 Proposed Methodology ‣ Deep unfolding of MCMC kernels: scalable, modular &amp; explainable GANs for high-dimensional posterior sampling" class="ltx_ref"><span class="ltx_text ltx_ref_tag">17</span></a>). The data consistency loss is defined as</p>
<table id="S3.Ex6" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S3.Ex6.m1" class="ltx_math_unparsed" alttext="\mathcal{L}_{1}(\Theta)=\mathbb{E}_{{\mathbf{x}},{\mathbf{y}}\sim p_{{\mathbf{x}},{\mathbf{y}}}}\Big[\big\|{\mathbf{x}}-\overline{{\mathbf{x}}}_{L_{0}:L,\Theta}^{\mathbf{y}}\big\|_{1}\Big]," display="block" intent=":literal"><semantics><mrow><msub><mi class="ltx_font_mathcaligraphic">ℒ</mi><mn>1</mn></msub><mrow><mo stretchy="false">(</mo><mi mathvariant="normal">Θ</mi><mo stretchy="false">)</mo></mrow><mo>=</mo><msub><mi>𝔼</mi><mrow><mrow><mi>𝐱</mi><mo>,</mo><mi>𝐲</mi></mrow><mo>∼</mo><msub><mi>p</mi><mrow><mi>𝐱</mi><mo>,</mo><mi>𝐲</mi></mrow></msub></mrow></msub><mrow><mo maxsize="1.600em" minsize="1.600em">[</mo><mo lspace="0em" mathsize="1.200em" rspace="0.167em">∥</mo><mi>𝐱</mi><mo>−</mo><msubsup><mover accent="true"><mi>𝐱</mi><mo stretchy="true">¯</mo></mover><mrow><msub><mi>L</mi><mn>0</mn></msub><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi>L</mi><mo>,</mo><mi mathvariant="normal">Θ</mi></mrow></mrow><mi>𝐲</mi></msubsup><msub><mo lspace="0em" mathsize="1.200em" rspace="0.167em">∥</mo><mn>1</mn></msub><mo maxsize="1.600em" minsize="1.600em">]</mo></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\mathcal{L}_{1}(\Theta)=\mathbb{E}_{{\mathbf{x}},{\mathbf{y}}\sim p_{{\mathbf{x}},{\mathbf{y}}}}\Big[\big\|{\mathbf{x}}-\overline{{\mathbf{x}}}_{L_{0}:L,\Theta}^{\mathbf{y}}\big\|_{1}\Big],</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S3.SS2.p4.2" class="ltx_p">promoting the property that the (truncated) ergodic average of the unfolded MCMC chain should act as a good point estimate of the ground-truth data. To promote diverse samples along each MCMC trajectory, we further adapt the standard deviation reward to include the standard deviation between dependent MCMC samples</p>
<table id="S3.Ex7" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S3.Ex7.m1" class="ltx_math_unparsed" alttext="\mathcal{L}_{\text{SD}}(\Theta)=\mathbb{E}_{{\mathbf{x}},{\mathbf{y}}\sim p_{{\mathbf{x}},{\mathbf{y}}}}\bigg[\sum_{\ell=L_{0}}^{L}\Big\|{\mathbf{x}}_{\ell,\Theta}^{\mathbf{y}}\ -\overline{{\mathbf{x}}}_{L_{0}:L,\Theta}^{\mathbf{y}}\Big\|_{1}\bigg]." display="block" intent=":literal"><semantics><mrow><msub><mi class="ltx_font_mathcaligraphic">ℒ</mi><mtext>SD</mtext></msub><mrow><mo stretchy="false">(</mo><mi mathvariant="normal">Θ</mi><mo stretchy="false">)</mo></mrow><mo>=</mo><msub><mi>𝔼</mi><mrow><mrow><mi>𝐱</mi><mo>,</mo><mi>𝐲</mi></mrow><mo>∼</mo><msub><mi>p</mi><mrow><mi>𝐱</mi><mo>,</mo><mi>𝐲</mi></mrow></msub></mrow></msub><mrow><mo maxsize="2.100em" minsize="2.100em">[</mo><munderover><mo lspace="0em" movablelimits="false" rspace="0em">∑</mo><mrow><mi mathvariant="normal">ℓ</mi><mo>=</mo><msub><mi>L</mi><mn>0</mn></msub></mrow><mi>L</mi></munderover><mo lspace="0em" mathsize="1.600em" rspace="0.167em">∥</mo><msubsup><mi>𝐱</mi><mrow><mi mathvariant="normal">ℓ</mi><mo>,</mo><mi mathvariant="normal">Θ</mi></mrow><mi>𝐲</mi></msubsup><mo>−</mo><msubsup><mover accent="true"><mi>𝐱</mi><mo stretchy="true">¯</mo></mover><mrow><msub><mi>L</mi><mn>0</mn></msub><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi>L</mi><mo>,</mo><mi mathvariant="normal">Θ</mi></mrow></mrow><mi>𝐲</mi></msubsup><msub><mo lspace="0em" mathsize="1.600em" rspace="0.167em">∥</mo><mn>1</mn></msub><mo maxsize="2.100em" minsize="2.100em">]</mo></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\mathcal{L}_{\text{SD}}(\Theta)=\mathbb{E}_{{\mathbf{x}},{\mathbf{y}}\sim p_{{\mathbf{x}},{\mathbf{y}}}}\bigg[\sum_{\ell=L_{0}}^{L}\Big\|{\mathbf{x}}_{\ell,\Theta}^{\mathbf{y}}\ -\overline{{\mathbf{x}}}_{L_{0}:L,\Theta}^{\mathbf{y}}\Big\|_{1}\bigg].</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S3.SS2.p4.3" class="ltx_p">As discussed in <a href="#S2.SS6" title="2.6 Conditional Generative Adversarial Networks ‣ 2 Background, Notation and Related Works ‣ Deep unfolding of MCMC kernels: scalable, modular &amp; explainable GANs for high-dimensional posterior sampling" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Section</span> <span class="ltx_text ltx_ref_tag">2.6</span></a>, the weight <math id="S3.SS2.p4.m1" class="ltx_Math" alttext="w_{\text{SD}}" display="inline" intent=":literal"><semantics><msub><mi>w</mi><mtext>SD</mtext></msub><annotation encoding="application/x-tex">w_{\text{SD}}</annotation></semantics></math> has to be carefully tuned during training to prevent over-fitting through inducing instabilities in the MCMC chain. The rule (<a href="#S2.E16" title="Equation 16 ‣ 2.6 Conditional Generative Adversarial Networks ‣ 2 Background, Notation and Related Works ‣ Deep unfolding of MCMC kernels: scalable, modular &amp; explainable GANs for high-dimensional posterior sampling" class="ltx_ref"><span class="ltx_text ltx_ref_tag">16</span></a>) used to tune <math id="S3.SS2.p4.m2" class="ltx_Math" alttext="w_{\text{SD}}" display="inline" intent=":literal"><semantics><msub><mi>w</mi><mtext>SD</mtext></msub><annotation encoding="application/x-tex">w_{\text{SD}}</annotation></semantics></math> in <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib1" title="" class="ltx_ref">4</a>]</cite> relies on having independent samples from <math id="S3.SS2.p4.m3" class="ltx_Math" alttext="\pi_{\theta}(x|y)" display="inline" intent=":literal"><semantics><mrow><msub><mi>π</mi><mi>θ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo lspace="0em" rspace="0em">|</mo><mi>y</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\pi_{\theta}(x|y)</annotation></semantics></math>. Therefore, we adapt <math id="S3.SS2.p4.m4" class="ltx_Math" alttext="w_{\text{SD}}" display="inline" intent=":literal"><semantics><msub><mi>w</mi><mtext>SD</mtext></msub><annotation encoding="application/x-tex">w_{\text{SD}}</annotation></semantics></math> using a variation of (<a href="#S2.E16" title="Equation 16 ‣ 2.6 Conditional Generative Adversarial Networks ‣ 2 Background, Notation and Related Works ‣ Deep unfolding of MCMC kernels: scalable, modular &amp; explainable GANs for high-dimensional posterior sampling" class="ltx_ref"><span class="ltx_text ltx_ref_tag">16</span></a>) which based on independent samples <math id="S3.SS2.p4.m5" class="ltx_Math" alttext="\{{\mathbf{x}}_{L,\Theta}^{(y,n)}\}_{i=1}^{N_{\text{val}}}" display="inline" intent=":literal"><semantics><msubsup><mrow><mo stretchy="false">{</mo><msubsup><mi>𝐱</mi><mrow><mi>L</mi><mo>,</mo><mi mathvariant="normal">Θ</mi></mrow><mrow><mo stretchy="false">(</mo><mi>y</mi><mo>,</mo><mi>n</mi><mo stretchy="false">)</mo></mrow></msubsup><mo stretchy="false">}</mo></mrow><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><msub><mi>N</mi><mtext>val</mtext></msub></msubsup><annotation encoding="application/x-tex">\{{\mathbf{x}}_{L,\Theta}^{(y,n)}\}_{i=1}^{N_{\text{val}}}</annotation></semantics></math> be from <math id="S3.SS2.p4.m6" class="ltx_Math" alttext="\mathcal{K}_{L,\Theta}(\cdot;y)" display="inline" intent=":literal"><semantics><mrow><msub><mi class="ltx_font_mathcaligraphic">𝒦</mi><mrow><mi>L</mi><mo>,</mo><mi mathvariant="normal">Θ</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo>,</mo><mi>y</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathcal{K}_{L,\Theta}(\cdot;y)</annotation></semantics></math> for <math id="S3.SS2.p4.m7" class="ltx_Math" alttext="y\in\mathbb{R}^{{d_{y}}}" display="inline" intent=":literal"><semantics><mrow><mi>y</mi><mo>∈</mo><msup><mi>ℝ</mi><msub><mi>d</mi><mi>y</mi></msub></msup></mrow><annotation encoding="application/x-tex">y\in\mathbb{R}^{{d_{y}}}</annotation></semantics></math>. That is, we therefore adapt <math id="S3.SS2.p4.m8" class="ltx_Math" alttext="w_{\text{SD}}" display="inline" intent=":literal"><semantics><msub><mi>w</mi><mtext>SD</mtext></msub><annotation encoding="application/x-tex">w_{\text{SD}}</annotation></semantics></math> using a Robbins-Monro update during a validation stage the term</p>
<table id="S3.Ex8" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S3.Ex8.m1" class="ltx_Math" alttext="\frac{\mathbb{E}_{{\mathbf{x}},{\mathbf{y}}\sim p_{{\mathbf{x}},{\mathbf{y}}}}[\|{\mathbf{x}}-{\mathbf{x}}_{L,\Theta}^{\mathbf{y}}\|^{2}]}{\mathbb{E}_{{\mathbf{x}},{\mathbf{y}}\sim p_{{\mathbf{x}},{\mathbf{y}}}}[\|{\mathbf{x}}-{N_{\text{val}}}^{-1}\sum_{i=0}^{N_{\text{val}}}\mathcal{{\mathbf{x}}}_{L,\Theta}^{({\mathbf{y}},n)}\|^{2}]}=2\frac{N_{\text{val}}+1}{N_{\text{val}}}," display="block" intent=":literal"><semantics><mrow><mrow><mfrac><mrow><msub><mi>𝔼</mi><mrow><mrow><mi>𝐱</mi><mo>,</mo><mi>𝐲</mi></mrow><mo>∼</mo><msub><mi>p</mi><mrow><mi>𝐱</mi><mo>,</mo><mi>𝐲</mi></mrow></msub></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><msup><mrow><mo stretchy="false">‖</mo><mrow><mi>𝐱</mi><mo>−</mo><msubsup><mi>𝐱</mi><mrow><mi>L</mi><mo>,</mo><mi mathvariant="normal">Θ</mi></mrow><mi>𝐲</mi></msubsup></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup><mo stretchy="false">]</mo></mrow></mrow><mrow><msub><mi>𝔼</mi><mrow><mrow><mi>𝐱</mi><mo>,</mo><mi>𝐲</mi></mrow><mo>∼</mo><msub><mi>p</mi><mrow><mi>𝐱</mi><mo>,</mo><mi>𝐲</mi></mrow></msub></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><msup><mrow><mo stretchy="false">‖</mo><mrow><mi>𝐱</mi><mo>−</mo><mrow><mmultiscripts><mi>N</mi><mtext>val</mtext><mrow></mrow><mrow></mrow><mrow><mo>−</mo><mn>1</mn></mrow></mmultiscripts><mo lspace="0em" rspace="0em">​</mo><mrow><msubsup><mo>∑</mo><mrow><mi>i</mi><mo>=</mo><mn>0</mn></mrow><msub><mi>N</mi><mtext>val</mtext></msub></msubsup><msubsup><mi>𝐱</mi><mrow><mi>L</mi><mo>,</mo><mi mathvariant="normal">Θ</mi></mrow><mrow><mo stretchy="false">(</mo><mi>𝐲</mi><mo>,</mo><mi>n</mi><mo stretchy="false">)</mo></mrow></msubsup></mrow></mrow></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup><mo stretchy="false">]</mo></mrow></mrow></mfrac><mo>=</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mfrac><mrow><msub><mi>N</mi><mtext>val</mtext></msub><mo>+</mo><mn>1</mn></mrow><msub><mi>N</mi><mtext>val</mtext></msub></mfrac></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\frac{\mathbb{E}_{{\mathbf{x}},{\mathbf{y}}\sim p_{{\mathbf{x}},{\mathbf{y}}}}[\|{\mathbf{x}}-{\mathbf{x}}_{L,\Theta}^{\mathbf{y}}\|^{2}]}{\mathbb{E}_{{\mathbf{x}},{\mathbf{y}}\sim p_{{\mathbf{x}},{\mathbf{y}}}}[\|{\mathbf{x}}-{N_{\text{val}}}^{-1}\sum_{i=0}^{N_{\text{val}}}\mathcal{{\mathbf{x}}}_{L,\Theta}^{({\mathbf{y}},n)}\|^{2}]}=2\frac{N_{\text{val}}+1}{N_{\text{val}}},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S3.SS2.p4.4" class="ltx_p">with <math id="S3.SS2.p4.m9" class="ltx_Math" alttext="\Theta=\Theta(w_{1})" display="inline" intent=":literal"><semantics><mrow><mi mathvariant="normal">Θ</mi><mo>=</mo><mrow><mi mathvariant="normal">Θ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>w</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\Theta=\Theta(w_{1})</annotation></semantics></math> through (<a href="#S3.E18" title="Equation 18 ‣ 3.2 Regularised Adversarial Training ‣ 3 Proposed Methodology ‣ Deep unfolding of MCMC kernels: scalable, modular &amp; explainable GANs for high-dimensional posterior sampling" class="ltx_ref"><span class="ltx_text ltx_ref_tag">18</span></a>). We find empirically that this term is monotone in <math id="S3.SS2.p4.m10" class="ltx_Math" alttext="w_{\text{SD}}" display="inline" intent=":literal"><semantics><msub><mi>w</mi><mtext>SD</mtext></msub><annotation encoding="application/x-tex">w_{\text{SD}}</annotation></semantics></math> for <math id="S3.SS2.p4.m11" class="ltx_Math" alttext="w_{\text{SD}}" display="inline" intent=":literal"><semantics><msub><mi>w</mi><mtext>SD</mtext></msub><annotation encoding="application/x-tex">w_{\text{SD}}</annotation></semantics></math> sufficiently small. To prevent instabilities arising in the MCMC architecture from promoting excessive variability between Markov iterates, we set <math id="S3.SS2.p4.m12" class="ltx_Math" alttext="w_{\text{SD}}=0" display="inline" intent=":literal"><semantics><mrow><msub><mi>w</mi><mtext>SD</mtext></msub><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">w_{\text{SD}}=0</annotation></semantics></math> whenever the error</p>
<table id="S3.Ex9" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S3.Ex9.m1" class="ltx_Math" alttext="\mathbb{E}_{{\mathbf{x}},{\mathbf{y}}\sim p_{{\mathbf{x}},{\mathbf{y}}}}\left[\big\|{\mathbf{x}}-{\mathbf{x}}_{L,\Theta}^{{\mathbf{y}}}\big\|^{2}\right]" display="block" intent=":literal"><semantics><mrow><msub><mi>𝔼</mi><mrow><mrow><mi>𝐱</mi><mo>,</mo><mi>𝐲</mi></mrow><mo>∼</mo><msub><mi>p</mi><mrow><mi>𝐱</mi><mo>,</mo><mi>𝐲</mi></mrow></msub></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><msup><mrow><mo maxsize="1.200em" minsize="1.200em" stretchy="true">‖</mo><mrow><mi>𝐱</mi><mo>−</mo><msubsup><mi>𝐱</mi><mrow><mi>L</mi><mo>,</mo><mi mathvariant="normal">Θ</mi></mrow><mi>𝐲</mi></msubsup></mrow><mo maxsize="1.200em" minsize="1.200em" stretchy="true">‖</mo></mrow><mn>2</mn></msup><mo>]</mo></mrow></mrow><annotation encoding="application/x-tex">\mathbb{E}_{{\mathbf{x}},{\mathbf{y}}\sim p_{{\mathbf{x}},{\mathbf{y}}}}\left[\big\|{\mathbf{x}}-{\mathbf{x}}_{L,\Theta}^{{\mathbf{y}}}\big\|^{2}\right]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S3.SS2.p4.5" class="ltx_p">is observed to rise above a user-defined threshold.</p>
</div>
</section>
<section id="S3.SS3" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">3.3 </span>Regularised Training with Perceptual Qualities</h3>

<div id="S3.SS3.p1" class="ltx_para">
<p id="S3.SS3.p1.1" class="ltx_p">Perceptual image quality metrics have recently proven effective for the distillation of diffusion models in imaging applications. By promoting a sharper image quality than standard <math id="S3.SS3.p1.m1" class="ltx_Math" alttext="\mathcal{L}_{1}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">ℒ</mi><mn>1</mn></msub><annotation encoding="application/x-tex">\mathcal{L}_{1}</annotation></semantics></math> or <math id="S3.SS3.p1.m2" class="ltx_Math" alttext="\mathcal{L}_{2}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">ℒ</mi><mn>2</mn></msub><annotation encoding="application/x-tex">\mathcal{L}_{2}</annotation></semantics></math> loss functions, the learned perceptual image patch similarity metric (LPIPS) <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib67" title="" class="ltx_ref">69</a>]</cite> has been used to distil diffusion models for prior <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib69" title="" class="ltx_ref">52</a>]</cite> and posterior <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib62" title="" class="ltx_ref">70</a>]</cite> sampling. For problems over distributions of natural images, we therefore extend the loss function (<a href="#S3.E18" title="Equation 18 ‣ 3.2 Regularised Adversarial Training ‣ 3 Proposed Methodology ‣ Deep unfolding of MCMC kernels: scalable, modular &amp; explainable GANs for high-dimensional posterior sampling" class="ltx_ref"><span class="ltx_text ltx_ref_tag">18</span></a>) to</p>
<table id="S3.E20" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S3.E20.m1" class="ltx_Math" alttext="\mathcal{L}_{\text{im}}(\Theta)=\mathcal{L}(\Theta)+\omega_{\text{PS}}\mathbb{E}_{{\mathbf{x}},{\mathbf{y}}\sim p_{{\mathbf{x}},{\mathbf{y}}}}\Big[\text{LPIPS}\big({\mathbf{x}},{\mathbf{x}}_{L,\Theta}^{\mathbf{y}}\big)\Big]," display="block" intent=":literal"><semantics><mrow><mrow><mrow><msub><mi class="ltx_font_mathcaligraphic">ℒ</mi><mtext>im</mtext></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi mathvariant="normal">Θ</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mrow><mi class="ltx_font_mathcaligraphic">ℒ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi mathvariant="normal">Θ</mi><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mrow><msub><mi>ω</mi><mtext>PS</mtext></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝔼</mi><mrow><mrow><mi>𝐱</mi><mo>,</mo><mi>𝐲</mi></mrow><mo>∼</mo><msub><mi>p</mi><mrow><mi>𝐱</mi><mo>,</mo><mi>𝐲</mi></mrow></msub></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="1.600em" minsize="1.600em">[</mo><mrow><mtext>LPIPS</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mi>𝐱</mi><mo>,</mo><msubsup><mi>𝐱</mi><mrow><mi>L</mi><mo>,</mo><mi mathvariant="normal">Θ</mi></mrow><mi>𝐲</mi></msubsup><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow></mrow><mo maxsize="1.600em" minsize="1.600em">]</mo></mrow></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\mathcal{L}_{\text{im}}(\Theta)=\mathcal{L}(\Theta)+\omega_{\text{PS}}\mathbb{E}_{{\mathbf{x}},{\mathbf{y}}\sim p_{{\mathbf{x}},{\mathbf{y}}}}\Big[\text{LPIPS}\big({\mathbf{x}},{\mathbf{x}}_{L,\Theta}^{\mathbf{y}}\big)\Big],</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(20)</span></td></tr></tbody>
</table>
<p id="S3.SS3.p1.2" class="ltx_p">where LPIPS is the learned perceptual image patch similarity metric <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib67" title="" class="ltx_ref">69</a>]</cite>.</p>
</div>
</section>
</section>
<section id="S4" class="ltx_section">
<h2 class="ltx_title ltx_title_section"><span class="ltx_tag ltx_tag_section">4 </span>Numerical Experiments</h2>

<div id="S4.p1" class="ltx_para">
<p id="S4.p1.1" class="ltx_p">We benchmark unfolded MCMC networks as discussed in <a href="#S3" title="3 Proposed Methodology ‣ Deep unfolding of MCMC kernels: scalable, modular &amp; explainable GANs for high-dimensional posterior sampling" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Section</span> <span class="ltx_text ltx_ref_tag">3</span></a> on two imaging inverse problems: a proof of concept experiment on image deblurring of MNIST digits (<a href="#S4.SS1" title="4.1 Image Deblurring on MNIST ‣ 4 Numerical Experiments ‣ Deep unfolding of MCMC kernels: scalable, modular &amp; explainable GANs for high-dimensional posterior sampling" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Section</span> <span class="ltx_text ltx_ref_tag">4.1</span></a>) allowing for extensive tests and accurate computation of comparison metrics due to the small size and relative simplicity of the prior distribution; and Radio interferometry on galaxy images (<a href="#S4.SS2" title="4.2 Radio Interferometry ‣ 4 Numerical Experiments ‣ Deep unfolding of MCMC kernels: scalable, modular &amp; explainable GANs for high-dimensional posterior sampling" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Section</span> <span class="ltx_text ltx_ref_tag">4.2</span></a>) for a realistic benchmark within a target application area where fast, interpretable inference is challenging yet highly desirable. We unfold a different discretisation of the Langevin diffusion (<a href="#S2.E9" title="Equation 9 ‣ 2.4 Markov Chain Monte Carlo ‣ 2 Background, Notation and Related Works ‣ Deep unfolding of MCMC kernels: scalable, modular &amp; explainable GANs for high-dimensional posterior sampling" class="ltx_ref"><span class="ltx_text ltx_ref_tag">9</span></a>) for each problem, illustrating the generality of the proposed approach.
<span id="footnote1" class="ltx_note ltx_role_footnote"><sup class="ltx_note_mark">1</sup><span class="ltx_note_outer"><span class="ltx_note_content"><sup class="ltx_note_mark">1</sup>
            <span class="ltx_tag ltx_tag_note">1</span>
            
            
            
            
            
            
            
          All results were computed using a HPC filesystem equipped with a Nvidia A40 (48GB) GPU and an AMD EPYC 7543 32-Core Processor. The code required to for these experiments uses the DeepInverse Pytorch imaging library <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib21" title="" class="ltx_ref">60</a>]</cite> and can be found at <a href="https://github.com/JSpence97/UMCMC" title="" class="ltx_ref ltx_href">https://github.com/JSpence97/UMCMC</a>.</span></span></span></p>
</div>
<section id="S4.SS1" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">4.1 </span>Image Deblurring on MNIST</h3>

<div id="S4.SS1.p1" class="ltx_para">
<p id="S4.SS1.p1.1" class="ltx_p">We consider a class of inverse problems trained on digits from the MNIST dataset <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib13" title="" class="ltx_ref">34</a>]</cite>. For compatibility with existing deep convolutional neural-network architectures, we add <math id="S4.SS1.p1.m1" class="ltx_Math" alttext="2\times 2" display="inline" intent=":literal"><semantics><mrow><mn>2</mn><mo lspace="0.222em" rspace="0.222em">×</mo><mn>2</mn></mrow><annotation encoding="application/x-tex">2\times 2</annotation></semantics></math> zero-padding to each digit so that <math id="S4.SS1.p1.m2" class="ltx_Math" alttext="d_{x}=32\times 32" display="inline" intent=":literal"><semantics><mrow><msub><mi>d</mi><mi>x</mi></msub><mo>=</mo><mrow><mn>32</mn><mo lspace="0.222em" rspace="0.222em">×</mo><mn>32</mn></mrow></mrow><annotation encoding="application/x-tex">d_{x}=32\times 32</annotation></semantics></math>. The relatively small dimension of this problem allows for efficient training of several configurations and robust ablation comparisons.</p>
</div>
<section id="S4.SS1.SSS1" class="ltx_subsubsection">
<h4 class="ltx_title ltx_title_subsubsection"><span class="ltx_tag ltx_tag_subsubsection">4.1.1 </span>Task</h4>

<div id="S4.SS1.SSS1.p1" class="ltx_para">
<p id="S4.SS1.SSS1.p1.1" class="ltx_p">We consider a linear inverse problem of the form (<a href="#S1.E2" title="Equation 2 ‣ 1 Introduction ‣ Deep unfolding of MCMC kernels: scalable, modular &amp; explainable GANs for high-dimensional posterior sampling" class="ltx_ref"><span class="ltx_text ltx_ref_tag">2</span></a>), with <math id="S4.SS1.SSS1.p1.m1" class="ltx_Math" alttext="Ax=k*x" display="inline" intent=":literal"><semantics><mrow><mrow><mi>A</mi><mo lspace="0em" rspace="0em">​</mo><mi>x</mi></mrow><mo>=</mo><mrow><mi>k</mi><mo lspace="0.222em" rspace="0.222em">∗</mo><mi>x</mi></mrow></mrow><annotation encoding="application/x-tex">Ax=k*x</annotation></semantics></math> representing convolution with a motion-blur kernel <math id="S4.SS1.SSS1.p1.m2" class="ltx_Math" alttext="k" display="inline" intent=":literal"><semantics><mi>k</mi><annotation encoding="application/x-tex">k</annotation></semantics></math>. As remarked above, unfolded MCMC architectures are able to naturally embed model parameters. This allows the training of deep unfolded generative networks robust to small perturbations in the observation model, represented in this instance through the kernel <math id="S4.SS1.SSS1.p1.m3" class="ltx_Math" alttext="k" display="inline" intent=":literal"><semantics><mi>k</mi><annotation encoding="application/x-tex">k</annotation></semantics></math>. To demonstrate this, for each observation <math id="S4.SS1.SSS1.p1.m4" class="ltx_Math" alttext="y" display="inline" intent=":literal"><semantics><mi>y</mi><annotation encoding="application/x-tex">y</annotation></semantics></math> we sample the kernel <math id="S4.SS1.SSS1.p1.m5" class="ltx_Math" alttext="k" display="inline" intent=":literal"><semantics><mi>k</mi><annotation encoding="application/x-tex">k</annotation></semantics></math> randomly as a realisation of <math id="S4.SS1.SSS1.p1.m6" class="ltx_Math" alttext="{\mathbf{k}}\sim\mathcal{GP}(11,\lambda_{\text{Matern}}=0.3,\sigma_{\text{Matern}}=0.25)" display="inline" intent=":literal"><semantics><mrow><mi>𝐤</mi><mo>∼</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒢</mi><mo lspace="0em" rspace="0em">​</mo><mi class="ltx_font_mathcaligraphic">𝒫</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mn>11</mn><mo>,</mo><mrow><msub><mi>λ</mi><mtext>Matern</mtext></msub><mo>=</mo><mn>0.3</mn></mrow><mo>,</mo><mrow><msub><mi>σ</mi><mtext>Matern</mtext></msub><mo>=</mo><mn>0.25</mn></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">{\mathbf{k}}\sim\mathcal{GP}(11,\lambda_{\text{Matern}}=0.3,\sigma_{\text{Matern}}=0.25)</annotation></semantics></math>, representing a random 2-dimensional trajectory embedded on a grid size <math id="S4.SS1.SSS1.p1.m7" class="ltx_Math" alttext="11\times 11" display="inline" intent=":literal"><semantics><mrow><mn>11</mn><mo lspace="0.222em" rspace="0.222em">×</mo><mn>11</mn></mrow><annotation encoding="application/x-tex">11\times 11</annotation></semantics></math>, simulated independently from <math id="S4.SS1.SSS1.p1.m8" class="ltx_Math" alttext="x" display="inline" intent=":literal"><semantics><mi>x</mi><annotation encoding="application/x-tex">x</annotation></semantics></math> and <math id="S4.SS1.SSS1.p1.m9" class="ltx_Math" alttext="y" display="inline" intent=":literal"><semantics><mi>y</mi><annotation encoding="application/x-tex">y</annotation></semantics></math> as a 2-dimensional trajectory from a Gaussian process with a Matérn covariance function with length scale 0.3 and standard deviation <math id="S4.SS1.SSS1.p1.m10" class="ltx_Math" alttext="0.25" display="inline" intent=":literal"><semantics><mn>0.25</mn><annotation encoding="application/x-tex">0.25</annotation></semantics></math>. This procedure for sampling <math id="S4.SS1.SSS1.p1.m11" class="ltx_Math" alttext="{\mathbf{k}}" display="inline" intent=":literal"><semantics><mi>𝐤</mi><annotation encoding="application/x-tex">{\mathbf{k}}</annotation></semantics></math> is described in <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib20" title="" class="ltx_ref">50</a>]</cite>.
We assume that the realisation of <math id="S4.SS1.SSS1.p1.m12" class="ltx_Math" alttext="{\mathbf{k}}" display="inline" intent=":literal"><semantics><mi>𝐤</mi><annotation encoding="application/x-tex">{\mathbf{k}}</annotation></semantics></math> is known at inference time. Therefore, for each tuple <math id="S4.SS1.SSS1.p1.m13" class="ltx_Math" alttext="(x,y,k)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>y</mi><mo>,</mo><mi>k</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(x,y,k)</annotation></semantics></math>, the posterior (<a href="#S1.E3" title="Equation 3 ‣ 1 Introduction ‣ Deep unfolding of MCMC kernels: scalable, modular &amp; explainable GANs for high-dimensional posterior sampling" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3</span></a>) becomes <math id="S4.SS1.SSS1.p1.m14" class="ltx_Math" alttext="\pi_{\theta}(x|y,{\mathbf{k}}=k)\propto p(y|x,{\mathbf{k}}=k)p_{\theta}(x)" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>π</mi><mi>θ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo lspace="0em" rspace="0em">|</mo><mrow><mi>y</mi><mo>,</mo><mrow><mi>𝐤</mi><mo>=</mo><mi>k</mi></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>∝</mo><mrow><mrow><mi>p</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>y</mi><mo lspace="0em" rspace="0em">|</mo><mrow><mi>x</mi><mo>,</mo><mrow><mi>𝐤</mi><mo>=</mo><mi>k</mi></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>p</mi><mi>θ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\pi_{\theta}(x|y,{\mathbf{k}}=k)\propto p(y|x,{\mathbf{k}}=k)p_{\theta}(x)</annotation></semantics></math>.</p>
</div>
</section>
<section id="S4.SS1.SSS2" class="ltx_subsubsection">
<h4 class="ltx_title ltx_title_subsubsection"><span class="ltx_tag ltx_tag_subsubsection">4.1.2 </span>Model</h4>

<div id="S4.SS1.SSS2.p1" class="ltx_para">
<p id="S4.SS1.SSS2.p1.1" class="ltx_p">To model the prior <math id="S4.SS1.SSS2.p1.m1" class="ltx_Math" alttext="p_{\theta}(x)" display="inline" intent=":literal"><semantics><mrow><msub><mi>p</mi><mi>θ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">p_{\theta}(x)</annotation></semantics></math>, we first introduce an auxiliary variable from a Laplace distribution <math id="S4.SS1.SSS2.p1.m2" class="ltx_Math" alttext="{\mathbf{z}}\sim p_{\lambda,{\mathbf{z}}}(z)\propto\exp(-\lambda\|z\|_{1})" display="inline" intent=":literal"><semantics><mrow><mi>𝐳</mi><mo>∼</mo><mrow><msub><mi>p</mi><mrow><mi>λ</mi><mo>,</mo><mi>𝐳</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>z</mi><mo stretchy="false">)</mo></mrow></mrow><mo>∝</mo><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mo>−</mo><mrow><mi>λ</mi><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">‖</mo><mi>z</mi><mo stretchy="false">‖</mo></mrow><mn>1</mn></msub></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">{\mathbf{z}}\sim p_{\lambda,{\mathbf{z}}}(z)\propto\exp(-\lambda\|z\|_{1})</annotation></semantics></math>, depending on parameter <math id="S4.SS1.SSS2.p1.m3" class="ltx_Math" alttext="\lambda" display="inline" intent=":literal"><semantics><mi>λ</mi><annotation encoding="application/x-tex">\lambda</annotation></semantics></math> controlling the desired sparsity level. We assume that the distribution of <math id="S4.SS1.SSS2.p1.m4" class="ltx_Math" alttext="{\mathbf{x}}" display="inline" intent=":literal"><semantics><mi>𝐱</mi><annotation encoding="application/x-tex">{\mathbf{x}}</annotation></semantics></math>, given <math id="S4.SS1.SSS2.p1.m5" class="ltx_Math" alttext="{\mathbf{z}}=z" display="inline" intent=":literal"><semantics><mrow><mi>𝐳</mi><mo>=</mo><mi>z</mi></mrow><annotation encoding="application/x-tex">{\mathbf{z}}=z</annotation></semantics></math> is Gaussian <math id="S4.SS1.SSS2.p1.m6" class="ltx_Math" alttext="p_{W}(x|z)=\mathcal{N}(x;\textnormal{Sig}(Wz),\rho^{2})" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>p</mi><mi>W</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo lspace="0em" rspace="0em">|</mo><mi>z</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒩</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mrow><mtext>Sig</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>W</mi><mo lspace="0em" rspace="0em">​</mo><mi>z</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><msup><mi>ρ</mi><mn>2</mn></msup><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">p_{W}(x|z)=\mathcal{N}(x;\textnormal{Sig}(Wz),\rho^{2})</annotation></semantics></math> where <math id="S4.SS1.SSS2.p1.m7" class="ltx_Math" alttext="W:\mathbb{R}^{dz}\to\mathbb{R}^{d_{x}}" display="inline" intent=":literal"><semantics><mrow><mi>W</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><msup><mi>ℝ</mi><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>z</mi></mrow></msup><mo stretchy="false">→</mo><msup><mi>ℝ</mi><msub><mi>d</mi><mi>x</mi></msub></msup></mrow></mrow><annotation encoding="application/x-tex">W:\mathbb{R}^{dz}\to\mathbb{R}^{d_{x}}</annotation></semantics></math> is a specified linear operator and <math id="S4.SS1.SSS2.p1.m8" class="ltx_Math" alttext="\textnormal{Sig}=(1+\exp(-x))^{-1}" display="inline" intent=":literal"><semantics><mrow><mtext>Sig</mtext><mo>=</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mo>−</mo><mi>x</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow><mrow><mo>−</mo><mn>1</mn></mrow></msup></mrow><annotation encoding="application/x-tex">\textnormal{Sig}=(1+\exp(-x))^{-1}</annotation></semantics></math> denotes the sigmoid function, forcing the mean of <math id="S4.SS1.SSS2.p1.m9" class="ltx_Math" alttext="p_{W}(x|z)" display="inline" intent=":literal"><semantics><mrow><msub><mi>p</mi><mi>W</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo lspace="0em" rspace="0em">|</mo><mi>z</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">p_{W}(x|z)</annotation></semantics></math> to lie within the unit hypercube where MNIST images are contained. Hence, for <math id="S4.SS1.SSS2.p1.m10" class="ltx_Math" alttext="\theta=(\lambda,W)" display="inline" intent=":literal"><semantics><mrow><mi>θ</mi><mo>=</mo><mrow><mo stretchy="false">(</mo><mi>λ</mi><mo>,</mo><mi>W</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\theta=(\lambda,W)</annotation></semantics></math> we have <math id="S4.SS1.SSS2.p1.m11" class="ltx_Math" alttext="p_{\theta}(x)\propto\int_{\mathbb{R}^{d_{z}}}p_{W}(x|z)p_{\lambda,{\mathbf{z}}}(z)\text{d}z" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>p</mi><mi>θ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo rspace="0.111em">∝</mo><mrow><msub><mo>∫</mo><msup><mi>ℝ</mi><msub><mi>d</mi><mi>z</mi></msub></msup></msub><mrow><msub><mi>p</mi><mi>W</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo lspace="0em" rspace="0em">|</mo><mi>z</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>p</mi><mrow><mi>λ</mi><mo>,</mo><mi>𝐳</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>z</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mtext>d</mtext><mo lspace="0em" rspace="0em">​</mo><mi>z</mi></mrow></mrow></mrow><annotation encoding="application/x-tex">p_{\theta}(x)\propto\int_{\mathbb{R}^{d_{z}}}p_{W}(x|z)p_{\lambda,{\mathbf{z}}}(z)\text{d}z</annotation></semantics></math>. Exact computation of <math id="S4.SS1.SSS2.p1.m12" class="ltx_Math" alttext="p_{\theta}(x)" display="inline" intent=":literal"><semantics><mrow><msub><mi>p</mi><mi>θ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">p_{\theta}(x)</annotation></semantics></math> is precluded by this high-dimensional non-standard integral. Instead, we consider a splitting approach <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib25" title="" class="ltx_ref">45</a>]</cite>, which samples <math id="S4.SS1.SSS2.p1.m13" class="ltx_Math" alttext="{\mathbf{x}}" display="inline" intent=":literal"><semantics><mi>𝐱</mi><annotation encoding="application/x-tex">{\mathbf{x}}</annotation></semantics></math> by marginalising the joint distribution <math id="S4.SS1.SSS2.p1.m14" class="ltx_Math" alttext="\pi_{\theta}(x,z|y)\propto p(y|x)p_{W}(x|z)p_{\lambda,{\mathbf{z}}}(z)" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>π</mi><mi>θ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>x</mi><mo>,</mo><mi>z</mi></mrow><mo lspace="0em" rspace="0em">|</mo><mi>y</mi><mo stretchy="false">)</mo></mrow></mrow><mo>∝</mo><mrow><mrow><mi>p</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>y</mi><mo lspace="0em" rspace="0em">|</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>p</mi><mi>W</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo lspace="0em" rspace="0em">|</mo><mi>z</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>p</mi><mrow><mi>λ</mi><mo>,</mo><mi>𝐳</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>z</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\pi_{\theta}(x,z|y)\propto p(y|x)p_{W}(x|z)p_{\lambda,{\mathbf{z}}}(z)</annotation></semantics></math>.</p>
</div>
<div id="S4.SS1.SSS2.p2" class="ltx_para">
<p id="S4.SS1.SSS2.p2.3" class="ltx_p">Within this framework, we consider a split-Gibbs-sampler (SGS) asymptotically sampling <math id="S4.SS1.SSS2.p2.m1" class="ltx_Math" alttext="({\mathbf{x}}_{\ell},{\mathbf{z}}_{\ell})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><msub><mi>𝐱</mi><mi mathvariant="normal">ℓ</mi></msub><mo>,</mo><msub><mi>𝐳</mi><mi mathvariant="normal">ℓ</mi></msub><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">({\mathbf{x}}_{\ell},{\mathbf{z}}_{\ell})</annotation></semantics></math> from the joint distribution <math id="S4.SS1.SSS2.p2.m2" class="ltx_Math" alttext="p_{{\mathbf{x}},{\mathbf{z}}}" display="inline" intent=":literal"><semantics><msub><mi>p</mi><mrow><mi>𝐱</mi><mo>,</mo><mi>𝐳</mi></mrow></msub><annotation encoding="application/x-tex">p_{{\mathbf{x}},{\mathbf{z}}}</annotation></semantics></math> by iteratively sampling <math id="S4.SS1.SSS2.p2.m3" class="ltx_Math" alttext="{\mathbf{z}}_{\ell+1}\sim p(z|{\mathbf{x}}_{\ell})" display="inline" intent=":literal"><semantics><mrow><msub><mi>𝐳</mi><mrow><mi mathvariant="normal">ℓ</mi><mo>+</mo><mn>1</mn></mrow></msub><mo>∼</mo><mrow><mi>p</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>z</mi><mo lspace="0em" rspace="0em">|</mo><msub><mi>𝐱</mi><mi mathvariant="normal">ℓ</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">{\mathbf{z}}_{\ell+1}\sim p(z|{\mathbf{x}}_{\ell})</annotation></semantics></math> and <math id="S4.SS1.SSS2.p2.m4" class="ltx_Math" alttext="{\mathbf{x}}_{\ell+1}\sim p(x|y,{\mathbf{z}}={\mathbf{z}}_{\ell};\rho=\rho_{\ell})" display="inline" intent=":literal"><semantics><mrow><msub><mi>𝐱</mi><mrow><mi mathvariant="normal">ℓ</mi><mo>+</mo><mn>1</mn></mrow></msub><mo>∼</mo><mrow><mi>p</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo lspace="0em" rspace="0em">|</mo><mrow><mi>y</mi><mo>,</mo><mrow><mi>𝐳</mi><mo>=</mo><msub><mi>𝐳</mi><mi mathvariant="normal">ℓ</mi></msub></mrow><mo>;</mo><mrow><mi>ρ</mi><mo>=</mo><msub><mi>ρ</mi><mi mathvariant="normal">ℓ</mi></msub></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">{\mathbf{x}}_{\ell+1}\sim p(x|y,{\mathbf{z}}={\mathbf{z}}_{\ell};\rho=\rho_{\ell})</annotation></semantics></math>. Since <math id="S4.SS1.SSS2.p2.m5" class="ltx_Math" alttext="{\mathbf{x}}" display="inline" intent=":literal"><semantics><mi>𝐱</mi><annotation encoding="application/x-tex">{\mathbf{x}}</annotation></semantics></math> if a Gaussian random variable given <math id="S4.SS1.SSS2.p2.m6" class="ltx_Math" alttext="{\mathbf{z}}={\mathbf{z}}_{\ell}" display="inline" intent=":literal"><semantics><mrow><mi>𝐳</mi><mo>=</mo><msub><mi>𝐳</mi><mi mathvariant="normal">ℓ</mi></msub></mrow><annotation encoding="application/x-tex">{\mathbf{z}}={\mathbf{z}}_{\ell}</annotation></semantics></math>, <math id="S4.SS1.SSS2.p2.m7" class="ltx_Math" alttext="{\mathbf{x}}_{\ell+1}" display="inline" intent=":literal"><semantics><msub><mi>𝐱</mi><mrow><mi mathvariant="normal">ℓ</mi><mo>+</mo><mn>1</mn></mrow></msub><annotation encoding="application/x-tex">{\mathbf{x}}_{\ell+1}</annotation></semantics></math> can be sampled exactly from a Gaussian distribution. The distribution <math id="S4.SS1.SSS2.p2.m8" class="ltx_Math" alttext="p(z|{\mathbf{x}}_{\ell})" display="inline" intent=":literal"><semantics><mrow><mi>p</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>z</mi><mo lspace="0em" rspace="0em">|</mo><msub><mi>𝐱</mi><mi mathvariant="normal">ℓ</mi></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">p(z|{\mathbf{x}}_{\ell})</annotation></semantics></math> is known only up to a normalizing constant and cannot feasibly be sampled exactly. Instead, we replace exact sampling of <math id="S4.SS1.SSS2.p2.m9" class="ltx_Math" alttext="p(z|{\mathbf{x}}_{\ell})" display="inline" intent=":literal"><semantics><mrow><mi>p</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>z</mi><mo lspace="0em" rspace="0em">|</mo><msub><mi>𝐱</mi><mi mathvariant="normal">ℓ</mi></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">p(z|{\mathbf{x}}_{\ell})</annotation></semantics></math> at each step with a single iteration of a Langevin (<a href="#S2.E9" title="Equation 9 ‣ 2.4 Markov Chain Monte Carlo ‣ 2 Background, Notation and Related Works ‣ Deep unfolding of MCMC kernels: scalable, modular &amp; explainable GANs for high-dimensional posterior sampling" class="ltx_ref"><span class="ltx_text ltx_ref_tag">9</span></a>) targeting the invariant measure <math id="S4.SS1.SSS2.p2.m10" class="ltx_Math" alttext="p(z|{\mathbf{x}}_{\ell})" display="inline" intent=":literal"><semantics><mrow><mi>p</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>z</mi><mo lspace="0em" rspace="0em">|</mo><msub><mi>𝐱</mi><mi mathvariant="normal">ℓ</mi></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">p(z|{\mathbf{x}}_{\ell})</annotation></semantics></math>. The resulting sampler leads to the iterates <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib25" title="" class="ltx_ref">45</a>]</cite></p>
<table id="S4.E21" class="ltx_equationgroup ltx_eqn_table">
<tbody>
<tr id="S4.E21X" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S4.E21X.m2" class="ltx_Math" alttext="\displaystyle{\mathbf{z}}_{\ell+1}" display="inline" intent=":literal"><semantics><msub><mi>𝐳</mi><mrow><mi mathvariant="normal">ℓ</mi><mo>+</mo><mn>1</mn></mrow></msub><annotation encoding="application/x-tex">\displaystyle{\mathbf{z}}_{\ell+1}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S4.E21X.m3" class="ltx_Math" alttext="\displaystyle={\mathbf{z}}_{\ell}+\gamma_{\ell}\left(\nabla_{z}\log p({\mathbf{x}}_{\ell}|{\mathbf{z}}={\mathbf{z}}_{\ell};\rho)+\nabla_{z}\log p_{\mathbf{z}}({\mathbf{z}}_{\ell})\right)+\sqrt{2\gamma_{\ell}}\zeta_{\ell}^{z}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><msub><mi>𝐳</mi><mi mathvariant="normal">ℓ</mi></msub><mo>+</mo><mrow><msub><mi>γ</mi><mi mathvariant="normal">ℓ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mrow><msub><mo>∇</mo><mi>z</mi></msub><mo lspace="0.167em" rspace="0em">​</mo><mi>log</mi><mo lspace="0.167em" rspace="0em">​</mo><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐱</mi><mi mathvariant="normal">ℓ</mi></msub><mo lspace="0em" rspace="0em">|</mo><mrow><mrow><mi>𝐳</mi><mo>=</mo><msub><mi>𝐳</mi><mi mathvariant="normal">ℓ</mi></msub></mrow><mo>;</mo><mi>ρ</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mrow><msub><mo>∇</mo><mi>z</mi></msub><mo lspace="0.167em" rspace="0em">​</mo><mi>log</mi><mo lspace="0.167em" rspace="0em">​</mo><msub><mi>p</mi><mi>𝐳</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐳</mi><mi mathvariant="normal">ℓ</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>)</mo></mrow></mrow><mo>+</mo><mrow><msqrt><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>γ</mi><mi mathvariant="normal">ℓ</mi></msub></mrow></msqrt><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>ζ</mi><mi mathvariant="normal">ℓ</mi><mi>z</mi></msubsup></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle={\mathbf{z}}_{\ell}+\gamma_{\ell}\left(\nabla_{z}\log p({\mathbf{x}}_{\ell}|{\mathbf{z}}={\mathbf{z}}_{\ell};\rho)+\nabla_{z}\log p_{\mathbf{z}}({\mathbf{z}}_{\ell})\right)+\sqrt{2\gamma_{\ell}}\zeta_{\ell}^{z}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="2" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equationgroup ltx_align_right">(21)</span></td></tr>
<tr id="S4.E21Xa" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S4.E21Xa.m2" class="ltx_Math" alttext="\displaystyle{\mathbf{x}}_{\ell+1}" display="inline" intent=":literal"><semantics><msub><mi>𝐱</mi><mrow><mi mathvariant="normal">ℓ</mi><mo>+</mo><mn>1</mn></mrow></msub><annotation encoding="application/x-tex">\displaystyle{\mathbf{x}}_{\ell+1}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S4.E21Xa.m3" class="ltx_Math" alttext="\displaystyle\sim p(x|y,{\mathbf{z}}={\mathbf{z}}_{\ell+1};\rho)," display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>∼</mo><mrow><mi>p</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo lspace="0em" rspace="0em">|</mo><mrow><mi>y</mi><mo>,</mo><mrow><mi>𝐳</mi><mo>=</mo><msub><mi>𝐳</mi><mrow><mi mathvariant="normal">ℓ</mi><mo>+</mo><mn>1</mn></mrow></msub></mrow><mo>;</mo><mi>ρ</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\sim p(x|y,{\mathbf{z}}={\mathbf{z}}_{\ell+1};\rho),</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S4.SS1.SSS2.p2.4" class="ltx_p">where <math id="S4.SS1.SSS2.p2.m11" class="ltx_Math" alttext="\zeta_{\ell}^{z}" display="inline" intent=":literal"><semantics><msubsup><mi>ζ</mi><mi mathvariant="normal">ℓ</mi><mi>z</mi></msubsup><annotation encoding="application/x-tex">\zeta_{\ell}^{z}</annotation></semantics></math> are independent <math id="S4.SS1.SSS2.p2.m12" class="ltx_Math" alttext="\mathcal{N}(0,1)" display="inline" intent=":literal"><semantics><mrow><mi class="ltx_font_mathcaligraphic">𝒩</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mn>0</mn><mo>,</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathcal{N}(0,1)</annotation></semantics></math> random variables for <math id="S4.SS1.SSS2.p2.m13" class="ltx_Math" alttext="0\leq\ell\leq L-1" display="inline" intent=":literal"><semantics><mrow><mn>0</mn><mo>≤</mo><mi mathvariant="normal">ℓ</mi><mo>≤</mo><mrow><mi>L</mi><mo>−</mo><mn>1</mn></mrow></mrow><annotation encoding="application/x-tex">0\leq\ell\leq L-1</annotation></semantics></math>. Instead of forcing <math id="S4.SS1.SSS2.p2.m14" class="ltx_Math" alttext="\rho" display="inline" intent=":literal"><semantics><mi>ρ</mi><annotation encoding="application/x-tex">\rho</annotation></semantics></math> to be uniform between iterations, we allow for <math id="S4.SS1.SSS2.p2.m15" class="ltx_Math" alttext="\rho=\rho_{\ell}" display="inline" intent=":literal"><semantics><mrow><mi>ρ</mi><mo>=</mo><msub><mi>ρ</mi><mi mathvariant="normal">ℓ</mi></msub></mrow><annotation encoding="application/x-tex">\rho=\rho_{\ell}</annotation></semantics></math> to depend on the iteration number <math id="S4.SS1.SSS2.p2.m16" class="ltx_Math" alttext="\ell" display="inline" intent=":literal"><semantics><mi mathvariant="normal">ℓ</mi><annotation encoding="application/x-tex">\ell</annotation></semantics></math>. This aligns with the stochastic approximation proximal gradient algorithm <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib25" title="" class="ltx_ref">45</a>, Algorithm 3]</cite>, <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib61" title="" class="ltx_ref">10</a>]</cite>. Such techniques numerically solve for the optimal value of <math id="S4.SS1.SSS2.p2.m17" class="ltx_Math" alttext="\rho" display="inline" intent=":literal"><semantics><mi>ρ</mi><annotation encoding="application/x-tex">\rho</annotation></semantics></math> for the data through an augmented stochastic approximation to find a root of <math id="S4.SS1.SSS2.p2.m18" class="ltx_Math" alttext="\nabla_{\rho}\log p(y|z;\rho)" display="inline" intent=":literal"><semantics><mrow><msub><mo>∇</mo><mi>ρ</mi></msub><mo lspace="0.167em" rspace="0em">​</mo><mi>log</mi><mo lspace="0.167em" rspace="0em">​</mo><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>y</mi><mo lspace="0em" rspace="0em">|</mo><mrow><mi>z</mi><mo>;</mo><mi>ρ</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\nabla_{\rho}\log p(y|z;\rho)</annotation></semantics></math>.
Since the distribution of <math id="S4.SS1.SSS2.p2.m19" class="ltx_Math" alttext="{\mathbf{x}}" display="inline" intent=":literal"><semantics><mi>𝐱</mi><annotation encoding="application/x-tex">{\mathbf{x}}</annotation></semantics></math> given <math id="S4.SS1.SSS2.p2.m20" class="ltx_Math" alttext="{\mathbf{z}}=z" display="inline" intent=":literal"><semantics><mrow><mi>𝐳</mi><mo>=</mo><mi>z</mi></mrow><annotation encoding="application/x-tex">{\mathbf{z}}=z</annotation></semantics></math> is assumed Gaussian with mean <math id="S4.SS1.SSS2.p2.m21" class="ltx_Math" alttext="\textnormal{Sig}(Wz)" display="inline" intent=":literal"><semantics><mrow><mtext>Sig</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>W</mi><mo lspace="0em" rspace="0em">​</mo><mi>z</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\textnormal{Sig}(Wz)</annotation></semantics></math> and variance <math id="S4.SS1.SSS2.p2.m22" class="ltx_Math" alttext="\rho_{\ell}^{2}I_{d_{x}}" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>ρ</mi><mi mathvariant="normal">ℓ</mi><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mi>I</mi><msub><mi>d</mi><mi>x</mi></msub></msub></mrow><annotation encoding="application/x-tex">\rho_{\ell}^{2}I_{d_{x}}</annotation></semantics></math>, with <math id="S4.SS1.SSS2.p2.m23" class="ltx_Math" alttext="\rho=\rho_{\ell}" display="inline" intent=":literal"><semantics><mrow><mi>ρ</mi><mo>=</mo><msub><mi>ρ</mi><mi mathvariant="normal">ℓ</mi></msub></mrow><annotation encoding="application/x-tex">\rho=\rho_{\ell}</annotation></semantics></math>, we can write</p>
<table id="S4.E22" class="ltx_equationgroup ltx_eqn_table">
<tbody>
<tr id="S4.E22X" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S4.E22X.m2" class="ltx_Math" alttext="\displaystyle{\mathbf{z}}_{\ell+1}" display="inline" intent=":literal"><semantics><msub><mi>𝐳</mi><mrow><mi mathvariant="normal">ℓ</mi><mo>+</mo><mn>1</mn></mrow></msub><annotation encoding="application/x-tex">\displaystyle{\mathbf{z}}_{\ell+1}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S4.E22X.m3" class="ltx_Math" alttext="\displaystyle={\mathbf{z}}_{\ell}+\gamma_{\ell}\bigg((\nabla_{z}\textnormal{Sig}(W{\mathbf{z}}_{\ell}))^{T}\bigg(\frac{{\mathbf{x}}_{\ell}-\textnormal{Sig}(W{\mathbf{z}}_{\ell})}{\rho_{\ell}^{2}}\bigg)+\frac{\text{ST}_{\lambda}({\mathbf{z}}_{\ell})-{\mathbf{z}}_{\ell}}{\lambda}\bigg)+\sqrt{2\gamma_{\ell}}\zeta_{\ell}^{z}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><msub><mi>𝐳</mi><mi mathvariant="normal">ℓ</mi></msub><mo>+</mo><mrow><msub><mi>γ</mi><mi mathvariant="normal">ℓ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="2.100em" minsize="2.100em">(</mo><mrow><mrow><msup><mrow><mo stretchy="false">(</mo><mrow><mrow><msub><mo rspace="0.167em">∇</mo><mi>z</mi></msub><mtext>Sig</mtext></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>W</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝐳</mi><mi mathvariant="normal">ℓ</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow><mi>T</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="2.100em" minsize="2.100em">(</mo><mstyle displaystyle="true"><mfrac><mrow><msub><mi>𝐱</mi><mi mathvariant="normal">ℓ</mi></msub><mo>−</mo><mrow><mtext>Sig</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>W</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝐳</mi><mi mathvariant="normal">ℓ</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><msubsup><mi>ρ</mi><mi mathvariant="normal">ℓ</mi><mn>2</mn></msubsup></mfrac></mstyle><mo maxsize="2.100em" minsize="2.100em">)</mo></mrow></mrow><mo>+</mo><mstyle displaystyle="true"><mfrac><mrow><mrow><msub><mtext>ST</mtext><mi>λ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐳</mi><mi mathvariant="normal">ℓ</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><msub><mi>𝐳</mi><mi mathvariant="normal">ℓ</mi></msub></mrow><mi>λ</mi></mfrac></mstyle></mrow><mo maxsize="2.100em" minsize="2.100em">)</mo></mrow></mrow><mo>+</mo><mrow><msqrt><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>γ</mi><mi mathvariant="normal">ℓ</mi></msub></mrow></msqrt><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>ζ</mi><mi mathvariant="normal">ℓ</mi><mi>z</mi></msubsup></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle={\mathbf{z}}_{\ell}+\gamma_{\ell}\bigg((\nabla_{z}\textnormal{Sig}(W{\mathbf{z}}_{\ell}))^{T}\bigg(\frac{{\mathbf{x}}_{\ell}-\textnormal{Sig}(W{\mathbf{z}}_{\ell})}{\rho_{\ell}^{2}}\bigg)+\frac{\text{ST}_{\lambda}({\mathbf{z}}_{\ell})-{\mathbf{z}}_{\ell}}{\lambda}\bigg)+\sqrt{2\gamma_{\ell}}\zeta_{\ell}^{z}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="2" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equationgroup ltx_align_right">(22)</span></td></tr>
<tr id="S4.E22Xa" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S4.E22Xa.m2" class="ltx_Math" alttext="\displaystyle{\mathbf{x}}_{\ell+1}" display="inline" intent=":literal"><semantics><msub><mi>𝐱</mi><mrow><mi mathvariant="normal">ℓ</mi><mo>+</mo><mn>1</mn></mrow></msub><annotation encoding="application/x-tex">\displaystyle{\mathbf{x}}_{\ell+1}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S4.E22Xa.m3" class="ltx_Math" alttext="\displaystyle=\prox_{-\rho_{\ell}^{2}\log p(y|\cdot)}(\textnormal{Sig}(W{\mathbf{z}}_{\ell+1}))+\Big(\sigma^{-2}A^{T}A+\rho_{\ell}^{-2}\Big)^{-1/2}\zeta_{\ell}^{x}." display="inline" intent=":literal"><semantics><mrow><mo>=</mo><mi>prox</mi><msub><mrow></mrow><mrow><mo>−</mo><mi>ρ</mi><msub><mrow></mrow><mi mathvariant="normal">ℓ</mi></msub><msup><mrow></mrow><mn>2</mn></msup><mi>log</mi><mi>p</mi><mo stretchy="false">(</mo><mi>y</mi><mo fence="false" stretchy="false">|</mo><mo lspace="0em" rspace="0em">⋅</mo><mo stretchy="false">)</mo></mrow></msub><mo stretchy="false">(</mo><mtext>Sig</mtext><mo stretchy="false">(</mo><mi>W</mi><mi>𝐳</mi><msub><mrow></mrow><mrow><mi mathvariant="normal">ℓ</mi><mo>+</mo><mn>1</mn></mrow></msub><mo stretchy="false">)</mo><mo stretchy="false">)</mo><mo>+</mo><mo maxsize="1.600em" minsize="1.600em">(</mo><mi>σ</mi><msup><mrow></mrow><mrow><mo>−</mo><mn>2</mn></mrow></msup><mi>A</mi><msup><mrow></mrow><mi>T</mi></msup><mi>A</mi><mo>+</mo><mi>ρ</mi><msub><mrow></mrow><mi mathvariant="normal">ℓ</mi></msub><msup><mrow></mrow><mrow><mo>−</mo><mn>2</mn></mrow></msup><mo maxsize="1.600em" minsize="1.600em">)</mo><msup><mrow></mrow><mrow><mo>−</mo><mn>1</mn><mo>/</mo><mn>2</mn></mrow></msup><mi>ζ</mi><msub><mrow></mrow><mi mathvariant="normal">ℓ</mi></msub><msup><mrow></mrow><mi>x</mi></msup><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle=\prox_{-\rho_{\ell}^{2}\log p(y|\cdot)}(\textnormal{Sig}(W{\mathbf{z}}_{\ell+1}))+\Big(\sigma^{-2}A^{T}A+\rho_{\ell}^{-2}\Big)^{-1/2}\zeta_{\ell}^{x}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S4.SS1.SSS2.p2.5" class="ltx_p">The kernels <math id="S4.SS1.SSS2.p2.m24" class="ltx_Math" alttext="\kappa_{\ell,\vartheta_{\ell},\theta}" display="inline" intent=":literal"><semantics><msub><mi>κ</mi><mrow><mi mathvariant="normal">ℓ</mi><mo>,</mo><msub><mi>ϑ</mi><mi mathvariant="normal">ℓ</mi></msub><mo>,</mo><mi>θ</mi></mrow></msub><annotation encoding="application/x-tex">\kappa_{\ell,\vartheta_{\ell},\theta}</annotation></semantics></math> in (<a href="#S3.E17" title="Equation 17 ‣ 3.1 Architecture ‣ 3 Proposed Methodology ‣ Deep unfolding of MCMC kernels: scalable, modular &amp; explainable GANs for high-dimensional posterior sampling" class="ltx_ref"><span class="ltx_text ltx_ref_tag">17</span></a>) representing the update <math id="S4.SS1.SSS2.p2.m25" class="ltx_Math" alttext="{\mathbf{x}}_{\ell}\mapsto{\mathbf{x}}_{\ell+1}" display="inline" intent=":literal"><semantics><mrow><msub><mi>𝐱</mi><mi mathvariant="normal">ℓ</mi></msub><mo stretchy="false">↦</mo><msub><mi>𝐱</mi><mrow><mi mathvariant="normal">ℓ</mi><mo>+</mo><mn>1</mn></mrow></msub></mrow><annotation encoding="application/x-tex">{\mathbf{x}}_{\ell}\mapsto{\mathbf{x}}_{\ell+1}</annotation></semantics></math> in (<a href="#S4.E22" title="Equation 22 ‣ 4.1.2 Model ‣ 4.1 Image Deblurring on MNIST ‣ 4 Numerical Experiments ‣ Deep unfolding of MCMC kernels: scalable, modular &amp; explainable GANs for high-dimensional posterior sampling" class="ltx_ref"><span class="ltx_text ltx_ref_tag">22</span></a>) take weights <math id="S4.SS1.SSS2.p2.m26" class="ltx_Math" alttext="\theta=\{W,\lambda\}" display="inline" intent=":literal"><semantics><mrow><mi>θ</mi><mo>=</mo><mrow><mo stretchy="false">{</mo><mrow><mi>W</mi><mo>,</mo><mi>λ</mi></mrow><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">\theta=\{W,\lambda\}</annotation></semantics></math> and <math id="S4.SS1.SSS2.p2.m27" class="ltx_Math" alttext="\vartheta_{\ell}=\{\gamma_{\ell},\rho_{\ell}\}" display="inline" intent=":literal"><semantics><mrow><msub><mi>ϑ</mi><mi mathvariant="normal">ℓ</mi></msub><mo>=</mo><mrow><mo stretchy="false">{</mo><msub><mi>γ</mi><mi mathvariant="normal">ℓ</mi></msub><mo>,</mo><msub><mi>ρ</mi><mi mathvariant="normal">ℓ</mi></msub><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">\vartheta_{\ell}=\{\gamma_{\ell},\rho_{\ell}\}</annotation></semantics></math>. Since the Laplace prior enforces sparsity around feasible values of <math id="S4.SS1.SSS2.p2.m28" class="ltx_Math" alttext="z" display="inline" intent=":literal"><semantics><mi>z</mi><annotation encoding="application/x-tex">z</annotation></semantics></math>, we initialize each chain with <math id="S4.SS1.SSS2.p2.m29" class="ltx_Math" alttext="{\mathbf{z}}_{0}={\mathbf{x}}_{0}=0" display="inline" intent=":literal"><semantics><mrow><msub><mi>𝐳</mi><mn>0</mn></msub><mo>=</mo><msub><mi>𝐱</mi><mn>0</mn></msub><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">{\mathbf{z}}_{0}={\mathbf{x}}_{0}=0</annotation></semantics></math>. That is, <math id="S4.SS1.SSS2.p2.m30" class="ltx_Math" alttext="\kappa_{0,\theta_{0},\theta}=\delta_{0}" display="inline" intent=":literal"><semantics><mrow><msub><mi>κ</mi><mrow><mn>0</mn><mo>,</mo><msub><mi>θ</mi><mn>0</mn></msub><mo>,</mo><mi>θ</mi></mrow></msub><mo>=</mo><msub><mi>δ</mi><mn>0</mn></msub></mrow><annotation encoding="application/x-tex">\kappa_{0,\theta_{0},\theta}=\delta_{0}</annotation></semantics></math> is a Dirac measure. In what follows, we refer to the resulting unfolded MCMC chain as Unfolded-split Gibbs sampler (U-SGS).
We train U-SGS with kernels described implicitly through (<a href="#S4.E22" title="Equation 22 ‣ 4.1.2 Model ‣ 4.1 Image Deblurring on MNIST ‣ 4 Numerical Experiments ‣ Deep unfolding of MCMC kernels: scalable, modular &amp; explainable GANs for high-dimensional posterior sampling" class="ltx_ref"><span class="ltx_text ltx_ref_tag">22</span></a>) using the training procedure discussed in <a href="#S4.SS1" title="4.1 Image Deblurring on MNIST ‣ 4 Numerical Experiments ‣ Deep unfolding of MCMC kernels: scalable, modular &amp; explainable GANs for high-dimensional posterior sampling" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Section</span> <span class="ltx_text ltx_ref_tag">4.1</span></a>. Independent models are trained for <math id="S4.SS1.SSS2.p2.m31" class="ltx_Math" alttext="L\in\{4,8,16,32,64\}" display="inline" intent=":literal"><semantics><mrow><mi>L</mi><mo>∈</mo><mrow><mo stretchy="false">{</mo><mrow><mn>4</mn><mo>,</mo><mn>8</mn><mo>,</mo><mn>16</mn><mo>,</mo><mn>32</mn><mo>,</mo><mn>64</mn></mrow><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">L\in\{4,8,16,32,64\}</annotation></semantics></math> iterations. For each model, we use a burn-in of size <math id="S4.SS1.SSS2.p2.m32" class="ltx_Math" alttext="L_{0}=L/4" display="inline" intent=":literal"><semantics><mrow><msub><mi>L</mi><mn>0</mn></msub><mo>=</mo><mrow><mi>L</mi><mo>/</mo><mn>4</mn></mrow></mrow><annotation encoding="application/x-tex">L_{0}=L/4</annotation></semantics></math>. For the adversarial loss, we use a discriminator <math id="S4.SS1.SSS2.p2.m33" class="ltx_Math" alttext="D_{\phi}" display="inline" intent=":literal"><semantics><msub><mi>D</mi><mi>ϕ</mi></msub><annotation encoding="application/x-tex">D_{\phi}</annotation></semantics></math> based on <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib1" title="" class="ltx_ref">4</a>, Appendix I.1.3]</cite>, which is a convolutional network with 2 average-pooling layers which downsample by a factor of <math id="S4.SS1.SSS2.p2.m34" class="ltx_Math" alttext="2\times 2" display="inline" intent=":literal"><semantics><mrow><mn>2</mn><mo lspace="0.222em" rspace="0.222em">×</mo><mn>2</mn></mrow><annotation encoding="application/x-tex">2\times 2</annotation></semantics></math> pixels, with batch-normalization and leaky ReLU activations. The final layer is fully-connected, mapping the output into <math id="S4.SS1.SSS2.p2.m35" class="ltx_Math" alttext="\mathbb{R}" display="inline" intent=":literal"><semantics><mi>ℝ</mi><annotation encoding="application/x-tex">\mathbb{R}</annotation></semantics></math>.</p>
</div>
</section>
<section id="S4.SS1.SSS3" class="ltx_subsubsection">
<h4 class="ltx_title ltx_title_subsubsection"><span class="ltx_tag ltx_tag_subsubsection">4.1.3 </span>Comparisons</h4>

<div id="S4.SS1.SSS3.p1" class="ltx_para">
<p id="S4.SS1.SSS3.p1.1" class="ltx_p">We compare the U-SGS architecture against a zero-shot MCMC method, along with an end-to-end neural network architecture trained to approximately sample <math id="S4.SS1.SSS3.p1.m1" class="ltx_Math" alttext="p(x|y,k)" display="inline" intent=":literal"><semantics><mrow><mi>p</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo lspace="0em" rspace="0em">|</mo><mrow><mi>y</mi><mo>,</mo><mi>k</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">p(x|y,k)</annotation></semantics></math>. Each method is summarized below.</p>
</div>
<div id="S4.SS1.SSS3.p2" class="ltx_para">
<p id="S4.SS1.SSS3.p2.1" class="ltx_p">For the zero-shot MCMC method, we use the same iterates in (<a href="#S4.E21" title="Equation 21 ‣ 4.1.2 Model ‣ 4.1 Image Deblurring on MNIST ‣ 4 Numerical Experiments ‣ Deep unfolding of MCMC kernels: scalable, modular &amp; explainable GANs for high-dimensional posterior sampling" class="ltx_ref"><span class="ltx_text ltx_ref_tag">21</span></a>). Recall that the proposed U-SGS model relies crucially on tuning the weights <math id="S4.SS1.SSS3.p2.m1" class="ltx_Math" alttext="W" display="inline" intent=":literal"><semantics><mi>W</mi><annotation encoding="application/x-tex">W</annotation></semantics></math> in the Laplace prior for <math id="S4.SS1.SSS3.p2.m2" class="ltx_Math" alttext="{\mathbf{z}}" display="inline" intent=":literal"><semantics><mi>𝐳</mi><annotation encoding="application/x-tex">{\mathbf{z}}</annotation></semantics></math>. Since this is not possible for a zero-shot method, we instead compare with a method which uses a pre-trained data-driven prior on <math id="S4.SS1.SSS3.p2.m3" class="ltx_Math" alttext="{\mathbf{z}}" display="inline" intent=":literal"><semantics><mi>𝐳</mi><annotation encoding="application/x-tex">{\mathbf{z}}</annotation></semantics></math> to promote a competitive comparison. Specifically, we parametrise a data-driven prior through a VAE encoder-decoder as in <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib26" title="" class="ltx_ref">25</a>]</cite>: given a latent variable <math id="S4.SS1.SSS3.p2.m4" class="ltx_Math" alttext="{\mathbf{z}}\sim p_{\mathbf{z}}^{\text{latent}}=\mathcal{N}(0,I_{d_{z}})" display="inline" intent=":literal"><semantics><mrow><mi>𝐳</mi><mo>∼</mo><msubsup><mi>p</mi><mi>𝐳</mi><mtext>latent</mtext></msubsup><mo>=</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒩</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mn>0</mn><mo>,</mo><msub><mi>I</mi><msub><mi>d</mi><mi>z</mi></msub></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">{\mathbf{z}}\sim p_{\mathbf{z}}^{\text{latent}}=\mathcal{N}(0,I_{d_{z}})</annotation></semantics></math>, we use a pre-trained VAE encoder-decoder pair designed to encode <math id="S4.SS1.SSS3.p2.m5" class="ltx_Math" alttext="p_{\mathbf{x}}" display="inline" intent=":literal"><semantics><msub><mi>p</mi><mi>𝐱</mi></msub><annotation encoding="application/x-tex">p_{\mathbf{x}}</annotation></semantics></math> into <math id="S4.SS1.SSS3.p2.m6" class="ltx_Math" alttext="p_{\mathbf{z}}^{\text{latent}}" display="inline" intent=":literal"><semantics><msubsup><mi>p</mi><mi>𝐳</mi><mtext>latent</mtext></msubsup><annotation encoding="application/x-tex">p_{\mathbf{z}}^{\text{latent}}</annotation></semantics></math>. Let <math id="S4.SS1.SSS3.p2.m7" class="ltx_Math" alttext="E_{\theta_{e}}^{\text{VAE}}:\mathbb{R}^{d_{x}}\to\mathbb{R}^{d_{z}}" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>E</mi><msub><mi>θ</mi><mi>e</mi></msub><mtext>VAE</mtext></msubsup><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><msup><mi>ℝ</mi><msub><mi>d</mi><mi>x</mi></msub></msup><mo stretchy="false">→</mo><msup><mi>ℝ</mi><msub><mi>d</mi><mi>z</mi></msub></msup></mrow></mrow><annotation encoding="application/x-tex">E_{\theta_{e}}^{\text{VAE}}:\mathbb{R}^{d_{x}}\to\mathbb{R}^{d_{z}}</annotation></semantics></math>, <math id="S4.SS1.SSS3.p2.m8" class="ltx_Math" alttext="D_{\theta_{d}}^{\text{VAE}}:\mathbb{R}^{d_{z}}\to\mathbb{R}^{d_{x}}" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>D</mi><msub><mi>θ</mi><mi>d</mi></msub><mtext>VAE</mtext></msubsup><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><msup><mi>ℝ</mi><msub><mi>d</mi><mi>z</mi></msub></msup><mo stretchy="false">→</mo><msup><mi>ℝ</mi><msub><mi>d</mi><mi>x</mi></msub></msup></mrow></mrow><annotation encoding="application/x-tex">D_{\theta_{d}}^{\text{VAE}}:\mathbb{R}^{d_{z}}\to\mathbb{R}^{d_{x}}</annotation></semantics></math> denote the encoder and decoder, respectively. For this comparison, we use the prior model <math id="S4.SS1.SSS3.p2.m9" class="ltx_Math" alttext="p_{\theta_{d}}(x)=(\text{D}_{\theta_{d}}^{\text{VAE}})_{\#}p_{\mathbf{z}}^{\text{latent}}" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>p</mi><msub><mi>θ</mi><mi>d</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><msub><mrow><mo stretchy="false">(</mo><msubsup><mtext>D</mtext><msub><mi>θ</mi><mi>d</mi></msub><mtext>VAE</mtext></msubsup><mo stretchy="false">)</mo></mrow><mi>#</mi></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>p</mi><mi>𝐳</mi><mtext>latent</mtext></msubsup></mrow></mrow><annotation encoding="application/x-tex">p_{\theta_{d}}(x)=(\text{D}_{\theta_{d}}^{\text{VAE}})_{\#}p_{\mathbf{z}}^{\text{latent}}</annotation></semantics></math>. We use the pre-trained encoder-decoder pair from <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib26" title="" class="ltx_ref">25</a>]</cite> which is a fully-connected network architecture with 2 hidden layers and a latent space of dimension <math id="S4.SS1.SSS3.p2.m10" class="ltx_Math" alttext="d_{z}=12" display="inline" intent=":literal"><semantics><mrow><msub><mi>d</mi><mi>z</mi></msub><mo>=</mo><mn>12</mn></mrow><annotation encoding="application/x-tex">d_{z}=12</annotation></semantics></math> for MNIST data. To sample from <math id="S4.SS1.SSS3.p2.m11" class="ltx_Math" alttext="\pi_{\theta_{d}}(x|y)=\propto p(y|x)p_{\theta_{d}}(x)" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>π</mi><msub><mi>θ</mi><mi>d</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo lspace="0em" rspace="0em">|</mo><mi>y</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mphantom></mphantom><mo>∝</mo><mrow><mrow><mi>p</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>y</mi><mo lspace="0em" rspace="0em">|</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>p</mi><msub><mi>θ</mi><mi>d</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\pi_{\theta_{d}}(x|y)=\propto p(y|x)p_{\theta_{d}}(x)</annotation></semantics></math>, we use the split Gibbs sampler (<a href="#S4.E21" title="Equation 21 ‣ 4.1.2 Model ‣ 4.1 Image Deblurring on MNIST ‣ 4 Numerical Experiments ‣ Deep unfolding of MCMC kernels: scalable, modular &amp; explainable GANs for high-dimensional posterior sampling" class="ltx_ref"><span class="ltx_text ltx_ref_tag">21</span></a>), where <math id="S4.SS1.SSS3.p2.m12" class="ltx_Math" alttext="\rho_{\ell}\equiv\rho&gt;0" display="inline" intent=":literal"><semantics><mrow><msub><mi>ρ</mi><mi mathvariant="normal">ℓ</mi></msub><mo>≡</mo><mi>ρ</mi><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\rho_{\ell}\equiv\rho&gt;0</annotation></semantics></math> is pre-trained on ground truth images <math id="S4.SS1.SSS3.p2.m13" class="ltx_Math" alttext="x" display="inline" intent=":literal"><semantics><mi>x</mi><annotation encoding="application/x-tex">x</annotation></semantics></math> alongside <math id="S4.SS1.SSS3.p2.m14" class="ltx_Math" alttext="\theta_{d}" display="inline" intent=":literal"><semantics><msub><mi>θ</mi><mi>d</mi></msub><annotation encoding="application/x-tex">\theta_{d}</annotation></semantics></math> as part of the evidence lower bound approach <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib65" title="" class="ltx_ref">32</a>]</cite>. The gradients <math id="S4.SS1.SSS3.p2.m15" class="ltx_Math" alttext="\nabla_{z}\log p({\mathbf{x}}_{\ell}|{\mathbf{z}}={\mathbf{z}}_{\ell};\rho=\rho_{\ell})" display="inline" intent=":literal"><semantics><mrow><msub><mo>∇</mo><mi>z</mi></msub><mo lspace="0.167em" rspace="0em">​</mo><mi>log</mi><mo lspace="0.167em" rspace="0em">​</mo><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐱</mi><mi mathvariant="normal">ℓ</mi></msub><mo lspace="0em" rspace="0em">|</mo><mrow><mrow><mi>𝐳</mi><mo>=</mo><msub><mi>𝐳</mi><mi mathvariant="normal">ℓ</mi></msub></mrow><mo>;</mo><mrow><mi>ρ</mi><mo>=</mo><msub><mi>ρ</mi><mi mathvariant="normal">ℓ</mi></msub></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\nabla_{z}\log p({\mathbf{x}}_{\ell}|{\mathbf{z}}={\mathbf{z}}_{\ell};\rho=\rho_{\ell})</annotation></semantics></math> are computed using automatic differentiation. As is typical for zero-shot MCMC methods, we integrate (<a href="#S4.E21" title="Equation 21 ‣ 4.1.2 Model ‣ 4.1 Image Deblurring on MNIST ‣ 4 Numerical Experiments ‣ Deep unfolding of MCMC kernels: scalable, modular &amp; explainable GANs for high-dimensional posterior sampling" class="ltx_ref"><span class="ltx_text ltx_ref_tag">21</span></a>) for a large number of iterations <math id="S4.SS1.SSS3.p2.m16" class="ltx_Math" alttext="\ell\approx 10,000" display="inline" intent=":literal"><semantics><mrow><mi mathvariant="normal">ℓ</mi><mo>≈</mo><mn>10,000</mn></mrow><annotation encoding="application/x-tex">\ell\approx 10,000</annotation></semantics></math> and approximate the ergodic mean as a point estimate of <math id="S4.SS1.SSS3.p2.m17" class="ltx_Math" alttext="x" display="inline" intent=":literal"><semantics><mi>x</mi><annotation encoding="application/x-tex">x</annotation></semantics></math> given <math id="S4.SS1.SSS3.p2.m18" class="ltx_Math" alttext="y" display="inline" intent=":literal"><semantics><mi>y</mi><annotation encoding="application/x-tex">y</annotation></semantics></math>. We refer to this approach as VAE-SGS in what follows.</p>
</div>
<div id="S4.SS1.SSS3.p3" class="ltx_para">
<p id="S4.SS1.SSS3.p3.1" class="ltx_p">For the end-to-end neural network, we train a regularised conditional GAN (RCGAN) using the regularized loss <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib1" title="" class="ltx_ref">4</a>]</cite> described by (<a href="#S2.E14" title="Equation 14 ‣ 2.6 Conditional Generative Adversarial Networks ‣ 2 Background, Notation and Related Works ‣ Deep unfolding of MCMC kernels: scalable, modular &amp; explainable GANs for high-dimensional posterior sampling" class="ltx_ref"><span class="ltx_text ltx_ref_tag">14</span></a>)-(<a href="#S2.E15" title="Equation 15 ‣ 2.6 Conditional Generative Adversarial Networks ‣ 2 Background, Notation and Related Works ‣ Deep unfolding of MCMC kernels: scalable, modular &amp; explainable GANs for high-dimensional posterior sampling" class="ltx_ref"><span class="ltx_text ltx_ref_tag">15</span></a>). For this comparison, we train an end-to-end generator <math id="S4.SS1.SSS3.p3.m1" class="ltx_Math" alttext="G_{\theta}(z,y)" display="inline" intent=":literal"><semantics><mrow><msub><mi>G</mi><mi>θ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>z</mi><mo>,</mo><mi>y</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">G_{\theta}(z,y)</annotation></semantics></math>, <math id="S4.SS1.SSS3.p3.m2" class="ltx_Math" alttext="z\sim\mathcal{N}(0,I_{{d_{y}}})" display="inline" intent=":literal"><semantics><mrow><mi>z</mi><mo>∼</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒩</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mn>0</mn><mo>,</mo><msub><mi>I</mi><msub><mi>d</mi><mi>y</mi></msub></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">z\sim\mathcal{N}(0,I_{{d_{y}}})</annotation></semantics></math>, which has a U-Net architecture <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib12" title="" class="ltx_ref">48</a>]</cite> with two convolutional downsampling and two transpose convolutional upsampling layers with average pooling. The discriminator architecture is identical to the U-SGS model. While this comparison uses a similar training objective to U-SGS; the RCGAN uses a different generative architecture which is a conventional UNet that does not explicitly embed information regarding the Bayesian inverse problem.</p>
</div>
<div id="S4.SS1.SSS3.p4" class="ltx_para">
<p id="S4.SS1.SSS3.p4.1" class="ltx_p">In terms of architecture, VAE-SGS relies upon the same numerical integration scheme (<a href="#S4.E21" title="Equation 21 ‣ 4.1.2 Model ‣ 4.1 Image Deblurring on MNIST ‣ 4 Numerical Experiments ‣ Deep unfolding of MCMC kernels: scalable, modular &amp; explainable GANs for high-dimensional posterior sampling" class="ltx_ref"><span class="ltx_text ltx_ref_tag">21</span></a>) as U-SGS, but uses a different, zero-shot prior on <math id="S4.SS1.SSS3.p4.m1" class="ltx_Math" alttext="{\mathbf{x}}" display="inline" intent=":literal"><semantics><mi>𝐱</mi><annotation encoding="application/x-tex">{\mathbf{x}}</annotation></semantics></math>. RCGAN generates samples from a single evaluation of a UNet, resulting in a more opaque sampler than U-SGS and VAE-SGS. However, like U-SGS, the RCGAN is trained in a few-shot manner from pairs <math id="S4.SS1.SSS3.p4.m2" class="ltx_Math" alttext="(x,y)\sim p_{{\mathbf{x}},{\mathbf{y}}}" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>y</mi><mo stretchy="false">)</mo></mrow><mo>∼</mo><msub><mi>p</mi><mrow><mi>𝐱</mi><mo>,</mo><mi>𝐲</mi></mrow></msub></mrow><annotation encoding="application/x-tex">(x,y)\sim p_{{\mathbf{x}},{\mathbf{y}}}</annotation></semantics></math>.</p>
</div>
</section>
<section id="S4.SS1.SSS4" class="ltx_subsubsection">
<h4 class="ltx_title ltx_title_subsubsection"><span class="ltx_tag ltx_tag_subsubsection">4.1.4 </span>Metrics</h4>

<div id="S4.SS1.SSS4.p1" class="ltx_para">
<p id="S4.SS1.SSS4.p1.1" class="ltx_p">We compare methods with a range of metrics quantifying both the accuracy of point estimates of <math id="S4.SS1.SSS4.p1.m1" class="ltx_Math" alttext="x^{\star}" display="inline" intent=":literal"><semantics><msup><mi>x</mi><mo>⋆</mo></msup><annotation encoding="application/x-tex">x^{\star}</annotation></semantics></math> and the learned posterior distribution. The metrics are computed using a test set of 10,000 MNIST digits and kernels which we label <math id="S4.SS1.SSS4.p1.m2" class="ltx_Math" alttext="\mathcal{D}_{\text{test}}=\{(x_{\text{test}}^{(n)},y_{\text{text}}^{(n)},k_{\text{test}}^{(n)})\}_{n=1}^{10,000}" display="inline" intent=":literal"><semantics><mrow><msub><mi class="ltx_font_mathcaligraphic">𝒟</mi><mtext>test</mtext></msub><mo>=</mo><msubsup><mrow><mo stretchy="false">{</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>x</mi><mtext>test</mtext><mrow><mo stretchy="false">(</mo><mi>n</mi><mo stretchy="false">)</mo></mrow></msubsup><mo>,</mo><msubsup><mi>y</mi><mtext>text</mtext><mrow><mo stretchy="false">(</mo><mi>n</mi><mo stretchy="false">)</mo></mrow></msubsup><mo>,</mo><msubsup><mi>k</mi><mtext>test</mtext><mrow><mo stretchy="false">(</mo><mi>n</mi><mo stretchy="false">)</mo></mrow></msubsup><mo stretchy="false">)</mo></mrow><mo stretchy="false">}</mo></mrow><mrow><mi>n</mi><mo>=</mo><mn>1</mn></mrow><mn>10,000</mn></msubsup></mrow><annotation encoding="application/x-tex">\mathcal{D}_{\text{test}}=\{(x_{\text{test}}^{(n)},y_{\text{text}}^{(n)},k_{\text{test}}^{(n)})\}_{n=1}^{10,000}</annotation></semantics></math>. To quantify data-fidelity, we compute the PSNR (in d.b.) for a single sample and for the ergodic sample average for Markovian methods and the 512-sample mean for the RCGAN. We compare perceptual sample qualities using the structural similarity index measure (SSIM) <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib70" title="" class="ltx_ref">63</a>]</cite> and learned perceptual image patch similarity (LPIPS) <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib67" title="" class="ltx_ref">69</a>]</cite>.</p>
</div>
<div id="S4.SS1.SSS4.p2" class="ltx_para">
<p id="S4.SS1.SSS4.p2.1" class="ltx_p">We draw further comparisons using several metrics designed to compare the posterior approximation quality. In particular, we use the sliced Wasserstein (SW) distance <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib11" title="" class="ltx_ref">5</a>]</cite> between <math id="S4.SS1.SSS4.p2.m1" class="ltx_Math" alttext="p_{{\mathbf{x}},{\mathbf{y}}}" display="inline" intent=":literal"><semantics><msub><mi>p</mi><mrow><mi>𝐱</mi><mo>,</mo><mi>𝐲</mi></mrow></msub><annotation encoding="application/x-tex">p_{{\mathbf{x}},{\mathbf{y}}}</annotation></semantics></math> and <math id="S4.SS1.SSS4.p2.m2" class="ltx_Math" alttext="p_{{\mathbf{x}}_{\theta}^{({\mathbf{y}})},{\mathbf{y}}}" display="inline" intent=":literal"><semantics><msub><mi>p</mi><mrow><msubsup><mi>𝐱</mi><mi>θ</mi><mrow><mo stretchy="false">(</mo><mi>𝐲</mi><mo stretchy="false">)</mo></mrow></msubsup><mo>,</mo><mi>𝐲</mi></mrow></msub><annotation encoding="application/x-tex">p_{{\mathbf{x}}_{\theta}^{({\mathbf{y}})},{\mathbf{y}}}</annotation></semantics></math> (see <a href="#A1.SS1" title="A.1 Sliced Wasserstein ‣ Appendix A Implementation Details ‣ Deep unfolding of MCMC kernels: scalable, modular &amp; explainable GANs for high-dimensional posterior sampling" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Section</span> <span class="ltx_text ltx_ref_tag">A.1</span></a> for details). We further estimate the expected Wasserstein-2 distance, <math id="S4.SS1.SSS4.p2.m3" class="ltx_Math" alttext="\mathcal{W}_{2}^{\text{Latent}}" display="inline" intent=":literal"><semantics><msubsup><mi class="ltx_font_mathcaligraphic">𝒲</mi><mn>2</mn><mtext>Latent</mtext></msubsup><annotation encoding="application/x-tex">\mathcal{W}_{2}^{\text{Latent}}</annotation></semantics></math>, between the true and approximate posterior distributions pushed-forward to a latent Gaussian distribution by the pre-trained VAE encoder <math id="S4.SS1.SSS4.p2.m4" class="ltx_Math" alttext="E_{\theta_{e}}^{\text{VAE}}" display="inline" intent=":literal"><semantics><msubsup><mi>E</mi><msub><mi>θ</mi><mi>e</mi></msub><mtext>VAE</mtext></msubsup><annotation encoding="application/x-tex">E_{\theta_{e}}^{\text{VAE}}</annotation></semantics></math>. The metric is averaged over samples <math id="S4.SS1.SSS4.p2.m5" class="ltx_Math" alttext="y\sim{\mathbf{y}}" display="inline" intent=":literal"><semantics><mrow><mi>y</mi><mo>∼</mo><mi>𝐲</mi></mrow><annotation encoding="application/x-tex">y\sim{\mathbf{y}}</annotation></semantics></math>. We remark that for MNIST data, <math id="S4.SS1.SSS4.p2.m6" class="ltx_Math" alttext="\mathcal{W}_{2}^{\text{Latent}}" display="inline" intent=":literal"><semantics><msubsup><mi class="ltx_font_mathcaligraphic">𝒲</mi><mn>2</mn><mtext>Latent</mtext></msubsup><annotation encoding="application/x-tex">\mathcal{W}_{2}^{\text{Latent}}</annotation></semantics></math> can be viewed as a more robust variant of the (conditional )Fréchet inception metric <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib72" title="" class="ltx_ref">23</a>, <a href="#bib.bib1" title="" class="ltx_ref">4</a>]</cite>. Further details of <math id="S4.SS1.SSS4.p2.m7" class="ltx_Math" alttext="\mathcal{W}_{2}^{\text{Latent}}" display="inline" intent=":literal"><semantics><msubsup><mi class="ltx_font_mathcaligraphic">𝒲</mi><mn>2</mn><mtext>Latent</mtext></msubsup><annotation encoding="application/x-tex">\mathcal{W}_{2}^{\text{Latent}}</annotation></semantics></math> can be found in <a href="#A1.SS2" title="A.2 Frechet Inception Distance with VAE Embedding ‣ Appendix A Implementation Details ‣ Deep unfolding of MCMC kernels: scalable, modular &amp; explainable GANs for high-dimensional posterior sampling" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Section</span> <span class="ltx_text ltx_ref_tag">A.2</span></a>. Since the latent embedding <math id="S4.SS1.SSS4.p2.m8" class="ltx_Math" alttext="E_{\theta_{e}}^{\text{VAE}}" display="inline" intent=":literal"><semantics><msubsup><mi>E</mi><msub><mi>θ</mi><mi>e</mi></msub><mtext>VAE</mtext></msubsup><annotation encoding="application/x-tex">E_{\theta_{e}}^{\text{VAE}}</annotation></semantics></math> was trained jointly with the prior distribution for VAE-SGS, it is expected that <math id="S4.SS1.SSS4.p2.m9" class="ltx_Math" alttext="\mathcal{W}_{2}^{\text{Latent}}" display="inline" intent=":literal"><semantics><msubsup><mi class="ltx_font_mathcaligraphic">𝒲</mi><mn>2</mn><mtext>Latent</mtext></msubsup><annotation encoding="application/x-tex">\mathcal{W}_{2}^{\text{Latent}}</annotation></semantics></math> will contain a small bias in favour of this method. However, we observe empirically in the following section and <a href="#S4.T1" title="In 4.1.5 Results ‣ 4.1 Image Deblurring on MNIST ‣ 4 Numerical Experiments ‣ Deep unfolding of MCMC kernels: scalable, modular &amp; explainable GANs for high-dimensional posterior sampling" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Table</span> <span class="ltx_text ltx_ref_tag">1</span></a> that any such benefits are minor.</p>
</div>
<div id="S4.SS1.SSS4.p3" class="ltx_para">
<p id="S4.SS1.SSS4.p3.1" class="ltx_p">Finally, we compare distributions using the CMMD, which computes the maximum mean discrepancy between the push-forward of <math id="S4.SS1.SSS4.p3.m1" class="ltx_Math" alttext="p_{\mathbf{x}}" display="inline" intent=":literal"><semantics><msub><mi>p</mi><mi>𝐱</mi></msub><annotation encoding="application/x-tex">p_{\mathbf{x}}</annotation></semantics></math> and <math id="S4.SS1.SSS4.p3.m2" class="ltx_Math" alttext="p_{{\mathbf{x}}_{\theta}^{\mathbf{y}}}" display="inline" intent=":literal"><semantics><msub><mi>p</mi><msubsup><mi>𝐱</mi><mi>θ</mi><mi>𝐲</mi></msubsup></msub><annotation encoding="application/x-tex">p_{{\mathbf{x}}_{\theta}^{\mathbf{y}}}</annotation></semantics></math> under a CLIP embedding <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib9" title="" class="ltx_ref">29</a>]</cite>.</p>
</div>
</section>
<section id="S4.SS1.SSS5" class="ltx_subsubsection">
<h4 class="ltx_title ltx_title_subsubsection"><span class="ltx_tag ltx_tag_subsubsection">4.1.5 </span>Results</h4>

<div id="S4.SS1.SSS5.p1" class="ltx_para">
<p id="S4.SS1.SSS5.p1.1" class="ltx_p">Reconstruction metrics for each instance of our model and for both comparisons are shown in <a href="#S4.T1" title="In 4.1.5 Results ‣ 4.1 Image Deblurring on MNIST ‣ 4 Numerical Experiments ‣ Deep unfolding of MCMC kernels: scalable, modular &amp; explainable GANs for high-dimensional posterior sampling" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Table</span> <span class="ltx_text ltx_ref_tag">1</span></a>. After unfolding 8 iterations, our method is comparable to the RCGAN in terms of PSNR and is superior in terms of perceptual and distributional metrics. Increasing <math id="S4.SS1.SSS5.p1.m1" class="ltx_Math" alttext="L" display="inline" intent=":literal"><semantics><mi>L</mi><annotation encoding="application/x-tex">L</annotation></semantics></math> yields greater performance in our model at the expense of longer training and inference times. The model with <math id="S4.SS1.SSS5.p1.m2" class="ltx_Math" alttext="L=64" display="inline" intent=":literal"><semantics><mrow><mi>L</mi><mo>=</mo><mn>64</mn></mrow><annotation encoding="application/x-tex">L=64</annotation></semantics></math> iterations displays the best performance in all metrics, with an exception for SW which saturates (see <a href="#A1.SS1" title="A.1 Sliced Wasserstein ‣ Appendix A Implementation Details ‣ Deep unfolding of MCMC kernels: scalable, modular &amp; explainable GANs for high-dimensional posterior sampling" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Section</span> <span class="ltx_text ltx_ref_tag">A.1</span></a> for an explanation). The VAE-SGS method with 10,000 MCMC transitions exhibits comparable sample quality to the RCGAN but with less sample diversity, resulting in a worse PSNR for the posterior mean. To illustrate the difference in convergence to the true posterior between the U-SGS and VAE-SGS over a small number of iterations, <a href="#S4.F2" title="In 4.1.5 Results ‣ 4.1 Image Deblurring on MNIST ‣ 4 Numerical Experiments ‣ Deep unfolding of MCMC kernels: scalable, modular &amp; explainable GANs for high-dimensional posterior sampling" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Figure</span> <span class="ltx_text ltx_ref_tag">2</span></a> compares the mean-square error and <math id="S4.SS1.SSS5.p1.m3" class="ltx_Math" alttext="\mathcal{W}_{2}^{\text{Latent}}" display="inline" intent=":literal"><semantics><msubsup><mi class="ltx_font_mathcaligraphic">𝒲</mi><mn>2</mn><mtext>Latent</mtext></msubsup><annotation encoding="application/x-tex">\mathcal{W}_{2}^{\text{Latent}}</annotation></semantics></math>, averaged over the MNIST test set, for each method after <math id="S4.SS1.SSS5.p1.m4" class="ltx_Math" alttext="4\leq L\leq 64" display="inline" intent=":literal"><semantics><mrow><mn>4</mn><mo>≤</mo><mi>L</mi><mo>≤</mo><mn>64</mn></mrow><annotation encoding="application/x-tex">4\leq L\leq 64</annotation></semantics></math> iterations. Qualitative results are illustrated in <a href="#S4.F3" title="In 4.1.5 Results ‣ 4.1 Image Deblurring on MNIST ‣ 4 Numerical Experiments ‣ Deep unfolding of MCMC kernels: scalable, modular &amp; explainable GANs for high-dimensional posterior sampling" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Figure</span> <span class="ltx_text ltx_ref_tag">3</span></a> for 3 typical inverse problems from the test set. For each method, we show compare the posterior mean (averaged over 512 posterior samples); the residual error, and the first three principal eigenvectors of the posterior covariance matrix, computed through a PCA expansion. We notice sharp sample quality for both our method and RCGAN. The RCGAN displays some artefacts on the middle and lower reconstructions of the characters ‘0’ and ‘8’. This error is reflected in the principal eigen-directions for RCGAN, which are not contained in the manifold of MNIST data. This is expected since the GAN does not explicitly model the operator <math id="S4.SS1.SSS5.p1.m5" class="ltx_Math" alttext="A" display="inline" intent=":literal"><semantics><mi>A</mi><annotation encoding="application/x-tex">A</annotation></semantics></math> and instead tries to directly learn the mapping <math id="S4.SS1.SSS5.p1.m6" class="ltx_Math" alttext="y\mapsto p_{{\mathbf{x}}|y}" display="inline" intent=":literal"><semantics><mrow><mi>y</mi><mo stretchy="false">↦</mo><msub><mi>p</mi><mrow><mi>𝐱</mi><mo fence="false">|</mo><mi>y</mi></mrow></msub></mrow><annotation encoding="application/x-tex">y\mapsto p_{{\mathbf{x}}|y}</annotation></semantics></math> which causes difficulties in modelling the posterior over a range of kernels <math id="S4.SS1.SSS5.p1.m7" class="ltx_Math" alttext="k\sim{\mathbf{k}}" display="inline" intent=":literal"><semantics><mrow><mi>k</mi><mo>∼</mo><mi>𝐤</mi></mrow><annotation encoding="application/x-tex">k\sim{\mathbf{k}}</annotation></semantics></math>. In contrast, both U-SGS and VAE-SGS have a physical representation of the blur kernel through the likelihood. This allows both methods to adapt naturally to small perturbations in the blurring operation between inversions, exploring more insightful eigen-directions with the posterior samples.
VAE-SGS produces slightly blurry samples, indicating the method is concentrating around the parametrised posterior mean. The residual error and principal eigen-directions contain a lot of background noise, indicating the a significant amount of noise in the VAE-SGS posterior, perturbing samples away from the MNIST manifold. This noise could be diminished by reducing the step-size <math id="S4.SS1.SSS5.p1.m8" class="ltx_Math" alttext="\gamma" display="inline" intent=":literal"><semantics><mi>γ</mi><annotation encoding="application/x-tex">\gamma</annotation></semantics></math> in the VAE-SGS iterations, which comes at a greater inference cost.</p>
</div>
<div id="S4.SS1.SSS5.p2" class="ltx_para">
<p id="S4.SS1.SSS5.p2.1" class="ltx_p">The above experiment shows unfolding an MCMC architecture effectively encodes <math id="S4.SS1.SSS5.p2.m1" class="ltx_Math" alttext="A" display="inline" intent=":literal"><semantics><mi>A</mi><annotation encoding="application/x-tex">A</annotation></semantics></math> into the trained network which is beneficial when working with a range of similar forward operators. To highlight this property further, <a href="#A2.SS1" title="B.1 Out-of-Distribution Performance on MNIST ‣ Appendix B Additional Experimental Results ‣ Deep unfolding of MCMC kernels: scalable, modular &amp; explainable GANs for high-dimensional posterior sampling" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Section</span> <span class="ltx_text ltx_ref_tag">B.1</span></a> shows numerical results when comparing each of the above models on out-of-training-distribution operators <math id="S4.SS1.SSS5.p2.m2" class="ltx_Math" alttext="A" display="inline" intent=":literal"><semantics><mi>A</mi><annotation encoding="application/x-tex">A</annotation></semantics></math>.</p>
</div>
