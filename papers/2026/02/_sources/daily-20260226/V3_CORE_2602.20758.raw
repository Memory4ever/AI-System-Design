or:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 442.52 -56.44)"><foreignObject style="--ltx-fo-width:3.61em;--ltx-fo-height:1.45em;--ltx-fo-depth:0em;font-size:10pt;" height="20" overflow="visible" transform="matrix(1 0 0 -1 0 20)" width="50"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><img src="2602.20758v1/x7.png" id="S4.F4.pic1.g554" class="ltx_graphics ltx_img_landscape" style="width:5.019em; height:2.007em;aspect-ratio:83/35;" width="83" height="35" alt="Refer to caption"></span></span></foreignObject></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 433.07 52.35)"><foreignObject style="--ltx-fo-width:4.98em;--ltx-fo-height:1.32em;--ltx-fo-depth:0.82em;font-size:10pt;" height="29.52" overflow="visible" transform="matrix(1 0 0 -1 0 18.22)" width="68.91"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content">
<span id="S4.F4.pic1.242" class="ltx_inline-block ltx_parbox ltx_align_middle" style="width:4.98em;">
<span id="S4.F4.pic1.242.1" class="ltx_p ltx_align_center">LATINO</span>
