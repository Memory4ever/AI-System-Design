<span id="S4.F3.pic1.42" class="ltx_text">First</span></span></span></foreignObject></g><g style="--ltx-stroke-color:#FFFFFF;" stroke="#FFFFFF" stroke-width="0.8pt"><path style="fill:none" d="M 290.46 -524.96 h 42.28 v 9.61 h -42.28 Z"></path></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" stroke-width="0.8pt" transform="matrix(1.0 0.0 0.0 1.0 290.46 -524.96)"><foreignObject style="--ltx-fo-width:3.06em;--ltx-fo-height:0.69em;--ltx-fo-depth:0em;font-size:10pt;" height="9.61" overflow="visible" transform="matrix(1 0 0 -1 0 9.61)" width="42.28"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><span id="S4.F3.pic1.43" class="ltx_text">Second</span></span></span></foreignObject></g><g style="--ltx-stroke-color:#FFFFFF;" stroke="#FFFFFF" stroke-width="0.8pt"><path style="fill:none" d="M 345.32 -524.96 h 34.63 v 9.61 h -34.63 Z"></path></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" stroke-width="0.8pt" transform="matrix(1.0 0.0 0.0 1.0 345.32 -524.96)"><foreignObject style="--ltx-fo-width:2.5em;--ltx-fo-height:0.69em;--ltx-fo-depth:0em;font-size:10pt;" height="9.61" overflow="visible" transform="matrix(1 0 0 -1 0 9.61)" width="34.63"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><span id="S4.F3.pic1.44" class="ltx_text">Third</span></span></span></foreignObject></g><path style="fill:none" d="M 245.43 -525.36 M 245.43 -528.33 C 245.95 -529.37 247.16 -530.07 248.89 -530.07 L 309.51 -530.14 C 311.24 -530.14 312.45 -530.83 312.96 -531.87 C 313.48 -530.83 314.7 -530.14 316.43 -530.15 L 377.05 -530.21 C 378.78 -530.22 379.99 -529.53 380.51 -528.49"></path><g style="--ltx-stroke-color:#FFFFFF;" stroke="#FFFFFF" stroke-width="0.8pt"><path style="fill:none" d="M 245.25 -547.22 h 135.45 v 12.3 h -135.45 Z"></path></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" stroke-width="0.8pt" transform="matrix(1.0 0.0 0.0 1.0 245.25 -544.53)"><foreignObject style="--ltx-fo-width:9.84em;--ltx-fo-height:0.69em;--ltx-fo-depth:0.19em;font-size:10pt;" height="12.3" overflow="visible" transform="matrix(1 0 0 -1 0 9.61)" width="136.22"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><span id="S4.F3.pic1.45" class="ltx_text">Principal Eigenvectors</span></span></span></foreignObject></g><g style="--ltx-stroke-color:#FFFFFF;" stroke="#FFFFFF" stroke-width="0.8pt"><path style="fill:none" d="M -49.23 -186.42 h 7.91 v 5.96 h -7.91 Z"></path></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" stroke-width="0.8pt" transform="matrix(1.0 0.0 0.0 1.0 -49.23 -186.42)"><foreignObject style="--ltx-fo-width:0.57em;--ltx-fo-height:0.43em;--ltx-fo-depth:0em;font-size:10pt;" height="5.96" overflow="visible" transform="matrix(1 0 0 -1 0 5.96)" width="7.91"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S4.F3.pic1.m1" class="ltx_Math" alttext="x" display="inline" intent=":literal"><semantics><mi>x</mi><annotation encoding="application/x-tex">x</annotation></semantics></math></span></span></foreignObject></g><g style="--ltx-stroke-color:#FFFFFF;" stroke="#FFFFFF" stroke-width="0.8pt"><path style="fill:none" d="M 2.13 -186.42 h 7.28 v 8.65 h -7.28 Z"></path></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" stroke-width="0.8pt" transform="matrix(1.0 0.0 0.0 1.0 2.13 -183.73)"><foreignObject style="--ltx-fo-width:0.53em;--ltx-fo-height:0.43em;--ltx-fo-depth:0.19em;font-size:10pt;" height="8.65" overflow="visible" transform="matrix(1 0 0 -1 0 5.96)" width="7.28"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S4.F3.pic1.m2" class="ltx_Math" alttext="y" display="inline" intent=":literal"><semantics><mi>y</mi><annotation encoding="application/x-tex">y</annotation></semantics></math></span></span></foreignObject></g><g style="--ltx-stroke-color:#FFFFFF;" stroke="#FFFFFF" stroke-width="0.8pt"><path style="fill:none" d="M 52.99 -186.42 h 7.64 v 9.61 h -7.64 Z"></path></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" stroke-width="0.8pt" transform="matrix(1.0 0.0 0.0 1.0 52.99 -186.42)"><foreignObject style="--ltx-fo-width:0.55em;--ltx-fo-height:0.69em;--ltx-fo-depth:0em;font-size:10pt;" height="9.61" overflow="visible" transform="matrix(1 0 0 -1 0 9.61)" width="7.64"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S4.F3.pic1.m3" class="ltx_Math" alttext="k" display="inline" intent=":literal"><semantics><mi>k</mi><annotation encoding="application/x-tex">k</annotation></semantics></math></span></span></foreignObject></g><g style="--ltx-stroke-color:#FFFFFF;" stroke="#FFFFFF" stroke-width="0.8pt"><path style="fill:none" d="M 392.7 -70.4 h 91.55 v 9.49 h -91.55 Z"></path></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" stroke-width="0.8pt" transform="matrix(1.0 0.0 0.0 1.0 392.7 -70.4)"><foreignObject style="--ltx-fo-width:0.69em;--ltx-fo-height:0.69em;--ltx-fo-depth:0em;font-size:10pt;" height="9.49" overflow="visible" transform="matrix(1 0 0 -1 0 9.49)" width="9.55"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content">
