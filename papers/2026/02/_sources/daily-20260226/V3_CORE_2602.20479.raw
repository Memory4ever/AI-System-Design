<td id="S4.T4.7.1.14.8" class="ltx_td ltx_align_center ltx_border_b" style="padding:0.5pt 3.0pt;"><span id="S4.T4.7.1.14.8.1" class="ltx_text ltx_font_bold" style="--ltx-fg-color:#000000;">92.0</span></td>
