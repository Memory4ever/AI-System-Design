le="--ltx-fg-color:#000000;" mathcolor="#000000">1</mn><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">c</mi></msubsup><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\hat{y}=\operatorname*{arg\,min}_{c}\sum_{t=0}^{t^{*}}d_{\scriptscriptstyle\mathbb{L}}(\hat{\bm{x}}_{t},\bm{x}_{1}^{c})</annotation></semantics></math><span id="alg2.l11.6" class="ltx_text" style="--ltx-fg-color:#000000;">
