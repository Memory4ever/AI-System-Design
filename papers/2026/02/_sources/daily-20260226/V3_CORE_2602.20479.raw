<th id="S4.T4.7.1.3.10" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt" style="padding:0.5pt 3.0pt;"><span id="S4.T4.7.1.3.10.1" class="ltx_text" style="--ltx-fg-color:#000000;">68.3</span></th>
