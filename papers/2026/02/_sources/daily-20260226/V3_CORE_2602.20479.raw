              <span class="ltx_tag ltx_tag_listingline"><span id="alg1.l11.1" class="ltx_text" style="font-size:80%;">11:</span></span>
              
              
            <span id="alg1.l11.3" class="ltx_text" style="--ltx-fg-color:#000000;"> </span><span id="alg1.l11.4" class="ltx_text ltx_font_bold" style="--ltx-fg-color:#000000;">until</span><span id="alg1.l11.5" class="ltx_text" style="--ltx-fg-color:#000000;"> converged
</span>
</div>
</div>
</figure>
<figure id="alg2" class="ltx_float ltx_float_algorithm ltx_framed ltx_framed_top">
<figcaption class="ltx_caption" style="--ltx-fg-color:#000000;"><span class="ltx_tag ltx_tag_float"><span id="alg2.5" class="ltx_text ltx_font_bold">Algorithm 2</span> </span> Inference with Diameter-based Stopping</figcaption>
<div id="alg2.6" class="ltx_listing ltx_framed ltx_framed_topbottom ltx_listing">
<div id="alg2.l1" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg2.l1.1" class="ltx_text" style="font-size:80%;">1:</span></span>
              
              
            <span id="alg2.l1.3" class="ltx_text" style="--ltx-fg-color:#000000;"> </span><span id="alg2.l1.4" class="ltx_text ltx_font_bold" style="--ltx-fg-color:#000000;">Input:</span><span id="alg2.l1.5" class="ltx_text" style="--ltx-fg-color:#000000;"> image feature </span><math id="alg2.l1.m1" class="ltx_Math" alttext="\bm{x}_{0}" display="inline" intent=":literal"><semantics><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝒙</mi><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">0</mn></msub><annotation encoding="application/x-tex">\bm{x}_{0}</annotation></semantics></math><span id="alg2.l1.6" class="ltx_text" style="--ltx-fg-color:#000000;">, text prototypes </span><math id="alg2.l1.m2" class="ltx_Math" alttext="\{\bm{x}_{1}^{c}\}" display="inline" intent=":literal"><semantics><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">{</mo><msubsup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝒙</mi><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">1</mn><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">c</mi></msubsup><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">}</mo></mrow><annotation encoding="application/x-tex">\{\bm{x}_{1}^{c}\}</annotation></semantics></math><span id="alg2.l1.7" class="ltx_text" style="--ltx-fg-color:#000000;">, trained flow network </span><math id="alg2.l1.m3" class="ltx_Math" alttext="\mathcal{F}_{\theta}" display="inline" intent=":literal"><semantics><msub><mi style="--ltx-fg-color:#000000;" class="ltx_font_mathcaligraphic" mathcolor="#000000">ℱ</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">θ</mi></msub><annotation encoding="application/x-tex">\mathcal{F}_{\theta}</annotation></semantics></math><span id="alg2.l1.8" class="ltx_text" style="--ltx-fg-color:#000000;">, stepsize </span><math id="alg2.l1.m4" class="ltx_Math" alttext="\delta" display="inline" intent=":literal"><semantics><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">δ</mi><annotation encoding="application/x-tex">\delta</annotation></semantics></math><span id="alg2.l1.9" class="ltx_text" style="--ltx-fg-color:#000000;">, class number </span><math id="alg2.l1.m5" class="ltx_Math" alttext="N" display="inline" intent=":literal"><semantics><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">N</mi><annotation encoding="application/x-tex">N</annotation></semantics></math><span id="alg2.l1.10" class="ltx_text" style="--ltx-fg-color:#000000;">.
</span>
</div>
<div id="alg2.l2" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg2.l2.1" class="ltx_text" style="font-size:80%;">2:</span></span>
              
              
            <span id="alg2.l2.3" class="ltx_text" style="--ltx-fg-color:#000000;"> </span><span id="alg2.l2.4" class="ltx_text ltx_font_bold" style="--ltx-fg-color:#000000;">Initialize:</span><span id="alg2.l2.5" class="ltx_text" style="--ltx-fg-color:#000000;"> </span><math id="alg2.l2.m1" class="ltx_Math" alttext="t\leftarrow 0" display="inline" intent=":literal"><semantics><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">←</mo><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">0</mn></mrow><annotation encoding="application/x-tex">t\leftarrow 0</annotation></semantics></math><span id="alg2.l2.6" class="ltx_text" style="--ltx-fg-color:#000000;">, </span><math id="alg2.l2.m2" class="ltx_Math" alttext="d_{\text{txt}}=\max_{i,j}d_{\scriptscriptstyle\mathbb{L}}(\bm{x}_{1}^{i},\bm{x}_{1}^{j})" display="inline" intent=":literal"><semantics><mrow><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">d</mi><mtext style="--ltx-fg-color:#000000;" mathcolor="#000000">txt</mtext></msub><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">=</mo><mrow><mrow><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">max</mi><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">i</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">,</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">j</mi></mrow></msub><mo lspace="0.167em">⁡</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">d</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000" mathsize="0.710em">𝕃</mi></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">(</mo><msubsup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝒙</mi><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">1</mn><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">i</mi></msubsup><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">,</mo><msubsup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝒙</mi><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">1</mn><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">j</mi></msubsup><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">d_{\text{txt}}=\max_{i,j}d_{\scriptscriptstyle\mathbb{L}}(\bm{x}_{1}^{i},\bm{x}_{1}^{j})</annotation></semantics></math><span id="alg2.l2.7" class="ltx_text" style="--ltx-fg-color:#000000;">.
</span>
</div>
<div id="alg2.l3" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg2.l3.1" class="ltx_text" style="font-size:80%;">3:</span></span>
              
              
            <span id="alg2.l3.3" class="ltx_text" style="--ltx-fg-color:#000000;"> </span><span id="alg2.l3.4" class="ltx_text ltx_font_bold" style="--ltx-fg-color:#000000;">while</span><span id="alg2.l3.5" class="ltx_text" style="--ltx-fg-color:#000000;"> </span><math id="alg2.l3.m1" class="ltx_Math" alttext="t&lt;1" display="inline" intent=":literal"><semantics><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">&lt;</mo><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">1</mn></mrow><annotation encoding="application/x-tex">t&lt;1</annotation></semantics></math><span id="alg2.l3.6" class="ltx_text" style="--ltx-fg-color:#000000;"> </span><span id="alg2.l3.7" class="ltx_text ltx_font_bold" style="--ltx-fg-color:#000000;">do</span><span id="alg2.l3.8" class="ltx_text" style="--ltx-fg-color:#000000;">


</span>
</div>
<div id="alg2.l4" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg2.l4.1" class="ltx_text" style="font-size:80%;">4:</span></span>
              
              
            <span id="alg2.l4.3" class="ltx_text" style="--ltx-fg-color:#000000;">  </span><math id="alg2.l4.m1" class="ltx_Math" alttext="\bm{v}_{t}\leftarrow\Pi_{T_{\hat{\bm{x}}_{t}}\mathbb{L}}(\mathcal{F}_{\theta}(\hat{\bm{x}}_{t},t))" display="inline" intent=":literal"><semantics><mrow><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝒗</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi></msub><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">←</mo><mrow><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000" mathvariant="normal">Π</mi><mrow><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">T</mi><msub><mover accent="true"><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝒙</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">^</mo></mover><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝕃</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">(</mo><mrow><msub><mi style="--ltx-fg-color:#000000;" class="ltx_font_mathcaligraphic" mathcolor="#000000">ℱ</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">θ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">(</mo><msub><mover accent="true"><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝒙</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">^</mo></mover><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi></msub><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">,</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">)</mo></mrow></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\bm{v}_{t}\leftarrow\Pi_{T_{\hat{\bm{x}}_{t}}\mathbb{L}}(\mathcal{F}_{\theta}(\hat{\bm{x}}_{t},t))</annotation></semantics></math><span id="alg2.l4.4" class="ltx_text" style="--ltx-fg-color:#000000;">
</span>
</div>
<div id="alg2.l5" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg2.l5.1" class="ltx_text" style="font-size:80%;">5:</span></span>
              
              
            <span id="alg2.l5.3" class="ltx_text" style="--ltx-fg-color:#000000;">  </span><math id="alg2.l5.m1" class="ltx_Math" alttext="\hat{\bm{x}}_{t+\delta}\leftarrow\exp_{\hat{\bm{x}}_{t}}^{\kappa}(\delta\cdot\bm{v}_{t})" display="inline" intent=":literal"><semantics><mrow><msub><mover accent="true"><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝒙</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">^</mo></mover><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">+</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">δ</mi></mrow></msub><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">←</mo><mrow><msubsup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">exp</mi><msub><mover accent="true"><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝒙</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">^</mo></mover><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi></msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">κ</mi></msubsup><mo>⁡</mo><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">(</mo><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">δ</mi><mo style="--ltx-fg-color:#000000;" lspace="0.222em" mathcolor="#000000" rspace="0.222em">⋅</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝒗</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi></msub></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\hat{\bm{x}}_{t+\delta}\leftarrow\exp_{\hat{\bm{x}}_{t}}^{\kappa}(\delta\cdot\bm{v}_{t})</annotation></semantics></math><span id="alg2.l5.4" class="ltx_text" style="--ltx-fg-color:#000000;">
</span>
</div>
<div id="alg2.l6" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg2.l6.1" class="ltx_text" style="font-size:80%;">6:</span></span>
              
              
            <span id="alg2.l6.3" class="ltx_text" style="--ltx-fg-color:#000000;">  </span><span id="alg2.l6.4" class="ltx_text ltx_font_bold" style="--ltx-fg-color:#000000;">if</span><span id="alg2.l6.5" class="ltx_text" style="--ltx-fg-color:#000000;"> </span><math id="alg2.l6.m1" class="ltx_Math" alttext="\min_{c}d_{\scriptscriptstyle\mathbb{L}}(\hat{\bm{x}}_{t+\delta},\bm{x}_{1}^{c})\leq\phi(N)\cdot d_{\text{txt}}" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">min</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">c</mi></msub><mo lspace="0.167em">⁡</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">d</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000" mathsize="0.710em">𝕃</mi></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">(</mo><msub><mover accent="true"><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝒙</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">^</mo></mover><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">+</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">δ</mi></mrow></msub><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">,</mo><msubsup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝒙</mi><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">1</mn><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">c</mi></msubsup><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">)</mo></mrow></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">≤</mo><mrow><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">ϕ</mi><mo>⁡</mo><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">(</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">N</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" rspace="0.055em" stretchy="false">)</mo></mrow></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" rspace="0.222em">⋅</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">d</mi><mtext style="--ltx-fg-color:#000000;" mathcolor="#000000">txt</mtext></msub></mrow></mrow><annotation encoding="application/x-tex">\min_{c}d_{\scriptscriptstyle\mathbb{L}}(\hat{\bm{x}}_{t+\delta},\bm{x}_{1}^{c})\leq\phi(N)\cdot d_{\text{txt}}</annotation></semantics></math><span id="alg2.l6.6" class="ltx_text" style="--ltx-fg-color:#000000;"> </span><span id="alg2.l6.7" class="ltx_text ltx_font_bold" style="--ltx-fg-color:#000000;">then</span><span id="alg2.l6.8" class="ltx_text" style="--ltx-fg-color:#000000;">


</span>
</div>
<div id="alg2.l7" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg2.l7.1" class="ltx_text" style="font-size:80%;">7:</span></span>
              
              
            <span id="alg2.l7.3" class="ltx_text" style="--ltx-fg-color:#000000;">   </span><math id="alg2.l7.m1" class="ltx_Math" alttext="t^{*}\leftarrow t+\delta" display="inline" intent=":literal"><semantics><mrow><msup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">∗</mo></msup><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">←</mo><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">+</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">δ</mi></mrow></mrow><annotation encoding="application/x-tex">t^{*}\leftarrow t+\delta</annotation></semantics></math><span id="alg2.l7.4" class="ltx_text" style="--ltx-fg-color:#000000;">; </span><span id="alg2.l7.5" class="ltx_text ltx_font_bold" style="--ltx-fg-color:#000000;">break</span><span id="alg2.l7.6" class="ltx_text" style="--ltx-fg-color:#000000;">
</span>
</div>
<div id="alg2.l8" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg2.l8.1" class="ltx_text" style="font-size:80%;">8:</span></span>
              
              
