<td id="S3.T1.2.6.2" class="ltx_td ltx_align_left ltx_border_bb" style="padding-top:1.5pt;padding-bottom:1.5pt;"><span id="S3.T1.2.6.2.1" class="ltx_text" style="font-size:80%;">ECS or network files</span></td>
<td id="S3.T1.2.6.3" class="ltx_td ltx_nopad_r ltx_align_left ltx_align_top ltx_border_bb" style="padding-top:1.5pt;padding-bottom:1.5pt;">
<span id="S3.T1.2.6.3.1" class="ltx_inline-block ltx_align_top" style="width:93.9pt;">
