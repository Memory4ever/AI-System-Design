<span id="S3.T1.4.4.1.2.1.1.1.1.1" class="ltx_p">Aes <math id="S3.T1.m1" class="ltx_Math" alttext="{\color[rgb]{0,0,0.5}4.715}" display="inline" intent=":literal"><semantics><mn style="--ltx-fg-color:#000080;" mathcolor="#000080">4.715</mn><annotation encoding="application/x-tex">{\color[rgb]{0,0,0.5}4.715}</annotation></semantics></math>, Rel <math id="S3.T1.m2" class="ltx_Math" alttext="{\color[rgb]{0,0,0.5}0.347}" display="inline" intent=":literal"><semantics><mn style="--ltx-fg-color:#000080;" mathcolor="#000080">0.347</mn><annotation encoding="application/x-tex">{\color[rgb]{0,0,0.5}0.347}</annotation></semantics></math></span>
</span></span></span>
