<td id="S3.T1.4.4.2" class="ltx_td ltx_align_center" style="padding-left:2.8pt;padding-right:2.8pt;"><span id="S3.T1.4.4.2.1" class="ltx_text"></span><span id="S3.T1.4.4.2.2" class="ltx_text">
<span id="S3.T1.4.4.2.2.1" class="ltx_tabular ltx_align_middle">
