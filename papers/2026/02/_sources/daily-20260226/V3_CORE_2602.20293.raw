<td id="S5.T1.3.3.3" class="ltx_td ltx_align_center">2.8<math id="S5.T1.m4" class="ltx_Math" alttext="\times 10^{-6}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo lspace="0.222em" rspace="0.222em">×</mo><msup><mn>10</mn><mrow><mo>−</mo><mn>6</mn></mrow></msup></mrow><annotation encoding="application/x-tex">\times 10^{-6}</annotation></semantics></math></td></tr>
