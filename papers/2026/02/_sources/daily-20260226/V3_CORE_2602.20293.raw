<th id="S5.T1.3.1.2" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_t"><span id="S5.T1.3.1.2.1" class="ltx_text ltx_font_bold" style="font-size:90%;">Avg. MMD</span></th>
<th id="S5.T1.3.1.3" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_t"><span id="S5.T1.3.1.3.1" class="ltx_text ltx_font_bold" style="font-size:90%;">Avg. Correlation</span></th></tr>
</thead>
