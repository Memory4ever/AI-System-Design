<td id="S5.T1.3.4.3" class="ltx_td ltx_align_center ltx_border_b"><math id="S5.T1.m6" class="ltx_Math" alttext="7.1\times 10^{-6}" display="inline" intent=":literal"><semantics><mrow><mn>7.1</mn><mo lspace="0.222em" rspace="0.222em">×</mo><msup><mn>10</mn><mrow><mo>−</mo><mn>6</mn></mrow></msup></mrow><annotation encoding="application/x-tex">7.1\times 10^{-6}</annotation></semantics></math></td></tr>
</tbody>
</table>
<figcaption class="ltx_caption ltx_centering"><span class="ltx_tag ltx_tag_table"><span id="S5.T1.4" class="ltx_text" style="font-size:90%;">Table 1</span>: </span><span id="S5.T1.5" class="ltx_text" style="font-size:90%;">MNIST Dataset Comparison.</span></figcaption>
</figure>
<figure id="S5.T2" class="ltx_table">
<table id="S5.T2.3" class="ltx_tabular ltx_centering ltx_guessed_headers ltx_align_middle">
<thead class="ltx_thead">
<tr id="S5.T2.3.1" class="ltx_tr">
<th id="S5.T2.3.1.1" class="ltx_td ltx_align_left ltx_th ltx_th_column ltx_th_row ltx_border_t"><span id="S5.T2.3.1.1.1" class="ltx_text ltx_font_bold" style="font-size:90%;">Model</span></th>
<th id="S5.T2.3.1.2" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_t"><span id="S5.T2.3.1.2.1" class="ltx_text ltx_font_bold" style="font-size:90%;">MMD</span></th>
<th id="S5.T2.3.1.3" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_t"><span id="S5.T2.3.1.3.1" class="ltx_text ltx_font_bold" style="font-size:90%;">Avg. Correlation</span></th></tr>
</thead>
<tbody class="ltx_tbody">
<tr id="S5.T2.3.2" class="ltx_tr">
<th id="S5.T2.3.2.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_t">Neurise Diffusion (ours)</th>
<td id="S5.T2.3.2.2" class="ltx_td ltx_align_center ltx_border_t"><math id="S5.T2.m1" class="ltx_Math" alttext="0.016" display="inline" intent=":literal"><semantics><mn>0.016</mn><annotation encoding="application/x-tex">0.016</annotation></semantics></math></td>
<td id="S5.T2.3.2.3" class="ltx_td ltx_align_center ltx_border_t"><math id="S5.T2.m2" class="ltx_Math" alttext="1.18\times 10^{-5}" display="inline" intent=":literal"><semantics><mrow><mn>1.18</mn><mo lspace="0.222em" rspace="0.222em">×</mo><msup><mn>10</mn><mrow><mo>−</mo><mn>5</mn></mrow></msup></mrow><annotation encoding="application/x-tex">1.18\times 10^{-5}</annotation></semantics></math></td></tr>
<tr id="S5.T2.3.3" class="ltx_tr">
<th id="S5.T2.3.3.1" class="ltx_td ltx_align_left ltx_th ltx_th_row">D3PM</th>
<td id="S5.T2.3.3.2" class="ltx_td ltx_align_center"><math id="S5.T2.m3" class="ltx_Math" alttext="0.28" display="inline" intent=":literal"><semantics><mn>0.28</mn><annotation encoding="application/x-tex">0.28</annotation></semantics></math></td>
<td id="S5.T2.3.3.3" class="ltx_td ltx_align_center"><math id="S5.T2.m4" class="ltx_Math" alttext="1.5\times 10^{-5}" display="inline" intent=":literal"><semantics><mrow><mn>1.5</mn><mo lspace="0.222em" rspace="0.222em">×</mo><msup><mn>10</mn><mrow><mo>−</mo><mn>5</mn></mrow></msup></mrow><annotation encoding="application/x-tex">1.5\times 10^{-5}</annotation></semantics></math></td></tr>
<tr id="S5.T2.3.4" class="ltx_tr">
<th id="S5.T2.3.4.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_b">SEDD</th>
<td id="S5.T2.3.4.2" class="ltx_td ltx_align_center ltx_border_b"><math id="S5.T2.m5" class="ltx_Math" alttext="65.03" display="inline" intent=":literal"><semantics><mn>65.03</mn><annotation encoding="application/x-tex">65.03</annotation></semantics></math></td>
<td id="S5.T2.3.4.3" class="ltx_td ltx_align_center ltx_border_b"><math id="S5.T2.m6" class="ltx_Math" alttext="5.81\times 10^{-5}" display="inline" intent=":literal"><semantics><mrow><mn>5.81</mn><mo lspace="0.222em" rspace="0.222em">×</mo><msup><mn>10</mn><mrow><mo>−</mo><mn>5</mn></mrow></msup></mrow><annotation encoding="application/x-tex">5.81\times 10^{-5}</annotation></semantics></math></td></tr>
