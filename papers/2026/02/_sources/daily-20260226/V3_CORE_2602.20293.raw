<td id="S5.T1.3.2.2" class="ltx_td ltx_align_center ltx_border_t">15.17</td>
<td id="S5.T1.3.2.3" class="ltx_td ltx_align_center ltx_border_t"><math id="S5.T1.m1" class="ltx_Math" alttext="1.3\times 10^{-6}" display="inline" intent=":literal"><semantics><mrow><mn>1.3</mn><mo lspace="0.222em" rspace="0.222em">×</mo><msup><mn>10</mn><mrow><mo>−</mo><mn>6</mn></mrow></msup></mrow><annotation encoding="application/x-tex">1.3\times 10^{-6}</annotation></semantics></math></td></tr>
