><span id="lstnumberx54.19" class="ltx_text ltx_font_typewriter" style="font-size:90%;">/</span><span id="lstnumberx54.20" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:90%;">result</span><span id="lstnumberx54.21" class="ltx_text ltx_font_typewriter" style="font-size:90%;">).</span>
