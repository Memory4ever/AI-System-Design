t ltx_lst_identifier ltx_font_typewriter" style="font-size:80%;">Standard</span><span id="lstnumberx15.20" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:80%;"> </span><span id="lstnumberx15.21" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:80%;">graduate</span><span id="lstnumberx15.22" class="ltx_text ltx_font_typewriter" style="font-size:80%;">-</span><span id="lstnumberx15.23" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:80%;">level</span><span id="lstnumberx15.24" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:80%;"> </span><span id="lstnumberx15.25" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:80%;">theorems</span><span id="lstnumberx15.26" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:80%;"> </span><span id="lstnumberx15.27" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:80%;">are</span><span id="lstnumberx15.28" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:80%;"> </span><span id="lstnumberx15.29" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:80%;">allowed</span><span id="lstnumberx15.30" class="ltx_text ltx_font_typewriter" style="font-size:80%;">."</span>
