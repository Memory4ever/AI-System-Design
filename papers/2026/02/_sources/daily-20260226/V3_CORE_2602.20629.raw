_font_typewriter" style="font-size:90%;">the</span><span id="lstnumberx53.19" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:90%;"> </span><span id="lstnumberx53.20" class="ltx_text ltx_font_typewriter" style="font-size:90%;">**</span><span id="lstnumberx53.21" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:90%;">direct</span><span id="lstnumberx53.22" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:90%;"> </span><span id="lstnumberx53.23" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:90%;">URL</span><span id="lstnumberx53.24" class="ltx_text ltx_font_typewriter" style="font-size:90%;">**</span><span id="lstnumberx53.25" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:90%;"> </span><span id="lstnumberx53.26" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:90%;">of</span><span id="lstnumberx53.27" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:90%;"> </span><span id="lstnumberx53.28" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:90%;">the</span><span id="lstnumberx53.29" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:90%;"> </span><span id="lstnumberx53.30" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:90%;">solution</span><span id="lstnumberx53.31" class="ltx_text ltx_font_typewriter" style="font-size:90%;">.</span>
</div>
