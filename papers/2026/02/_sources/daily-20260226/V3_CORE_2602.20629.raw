 ltx_font_typewriter" style="font-size:80%;"> </span><span id="lstnumberx18.38" class="ltx_text ltx_font_typewriter" style="font-size:80%;">0.75,</span><span id="lstnumberx18.39" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:80%;"> </span><span id="lstnumberx18.40" class="ltx_text ltx_font_typewriter" style="font-size:80%;">0.9,</span><span id="lstnumberx18.41" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:80%;"> </span><span id="lstnumberx18.42" class="ltx_text ltx_font_typewriter" style="font-size:80%;">1.0].</span><span id="lstnumberx18.43" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:80%;"> </span><span id="lstnumberx18.44" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:80%;">Return</span><span id="lstnumberx18.45" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:80%;"> </span><span id="lstnumberx18.46" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:80%;">NO</span><span id="lstnumberx18.47" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:80%;"> </span><span id="lstnumberx18.48" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:80%;">other</span><span id="lstnumberx18.49" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:80%;"> </span><span id="lstnumberx18.50" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:80%;">keys</span><span id="lstnumberx18.51" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:80%;"> </span><span id="lstnumberx18.52" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:80%;">and</span><span id="lstnumberx18.53" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:80%;"> </span><span id="lstnumberx18.54" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:80%;">NO</span><span id="lstnumberx18.55" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:80%;"> </span><span id="lstnumberx18.56" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:80%;">extra</span><span id="lstnumberx18.57" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:80%;"> </span><span id="lstnumberx18.58" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:80%;">text</span><span id="lstnumberx18.59" class="ltx_text ltx_font_typewriter" style="font-size:80%;">.</span>
