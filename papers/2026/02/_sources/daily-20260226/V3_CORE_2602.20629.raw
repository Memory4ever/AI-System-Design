riter" style="font-size:90%;">0.5,</span><span id="lstnumberx65.38" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:90%;"> </span><span id="lstnumberx65.39" class="ltx_text ltx_font_typewriter" style="font-size:90%;">0.75,</span><span id="lstnumberx65.40" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:90%;"> </span><span id="lstnumberx65.41" class="ltx_text ltx_font_typewriter" style="font-size:90%;">0.9,</span><span id="lstnumberx65.42" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:90%;"> </span><span id="lstnumberx65.43" class="ltx_text ltx_font_typewriter" style="font-size:90%;">1.0].</span><span id="lstnumberx65.44" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:90%;"> </span><span id="lstnumberx65.45" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:90%;">Return</span><span id="lstnumberx65.46" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:90%;"> </span><span id="lstnumberx65.47" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:90%;">NO</span><span id="lstnumberx65.48" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:90%;"> </span><span id="lstnumberx65.49" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:90%;">other</span><span id="lstnumberx65.50" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:90%;"> </span><span id="lstnumberx65.51" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:90%;">keys</span><span id="lstnumberx65.52" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:90%;"> </span><span id="lstnumberx65.53" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:90%;">and</span><span id="lstnumberx65.54" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:90%;"> </span><span id="lstnumberx65.55" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:90%;">NO</span><span id="lstnumberx65.56" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:90%;"> </span><span id="lstnumberx65.57" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:90%;">extra</span><span id="lstnumberx65.58" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:90%;"> </span><span id="lstnumberx65.59" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:90%;">text</span><span id="lstnumberx65.60" class="ltx_text ltx_font_typewriter" style="font-size:90%;">."</span>
