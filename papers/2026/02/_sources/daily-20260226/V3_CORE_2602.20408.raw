<td id="Ax5.T1.1.4.1" class="ltx_td ltx_align_left">LLM Default + CoT (sequential)</td>
<td id="Ax5.T1.1.4.2" class="ltx_td ltx_align_center">23</td>
<td id="Ax5.T1.1.4.3" class="ltx_td ltx_align_center">105</td>
<td id="Ax5.T1.1.4.4" class="ltx_td ltx_align_center">830</td></tr>
