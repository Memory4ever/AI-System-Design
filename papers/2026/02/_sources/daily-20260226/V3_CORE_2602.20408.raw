<span id="S7.tab1.2.1.2.2" class="ltx_td ltx_align_center ltx_border_t">28</span>
<span id="S7.tab1.2.1.2.3" class="ltx_td ltx_align_center ltx_border_t">197</span>
<span id="S7.tab1.2.1.2.4" class="ltx_td ltx_nopad_r ltx_align_center ltx_border_t">830</span></span>
<span id="S7.tab1.2.1.3" class="ltx_tr">
