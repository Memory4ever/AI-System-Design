<td id="Ax5.T1.1.2.2" class="ltx_td ltx_align_center ltx_border_t">28</td>
<td id="Ax5.T1.1.2.3" class="ltx_td ltx_align_center ltx_border_t">197</td>
<td id="Ax5.T1.1.2.4" class="ltx_td ltx_align_center ltx_border_t">830</td></tr>
<tr id="Ax5.T1.1.3" class="ltx_tr">
<td id="Ax5.T1.1.3.1" class="ltx_td ltx_align_left">LLM Default (Study 1)</td>
