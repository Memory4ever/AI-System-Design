<td id="Ax5.T1.1.1.2" class="ltx_td ltx_align_center ltx_border_t"><span id="Ax5.T1.1.1.2.1" class="ltx_text ltx_font_bold">Total Categories</span></td>
<td id="Ax5.T1.1.1.3" class="ltx_td ltx_align_center ltx_border_t"><span id="Ax5.T1.1.1.3.1" class="ltx_text ltx_font_bold">Unique Combinations</span></td>
<td id="Ax5.T1.1.1.4" class="ltx_td ltx_align_center ltx_border_t"><span id="Ax5.T1.1.1.4.1" class="ltx_text ltx_font_bold">Total Ideas</span></td></tr>
<tr id="Ax5.T1.1.2" class="ltx_tr">
