"ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:80%;--ltx-fg-color:#000000;"> </span><span id="lstnumberx7.62" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:80%;--ltx-fg-color:#000000;">idea</span><span id="lstnumberx7.63" class="ltx_text ltx_font_typewriter" style="font-size:80%;--ltx-fg-color:#000000;">,</span><span id="lstnumberx7.64" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:80%;--ltx-fg-color:#000000;"> </span><span id="lstnumberx7.65" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:80%;--ltx-fg-color:#000000;">labeled</span><span id="lstnumberx7.66" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:80%;--ltx-fg-color:#000000;"> </span><span id="lstnumberx7.67" class="ltx_text ltx_font_typewriter" style="font-size:80%;--ltx-fg-color:#000000;">’</span><span id="lstnumberx7.68" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:80%;--ltx-fg-color:#000000;">idea</span><span id="lstnumberx7.69" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:80%;--ltx-fg-color:#000000;"> </span><span id="lstnumberx7.70" class="ltx_text ltx_font_typewriter" style="font-size:80%;--ltx-fg-color:#000000;">#3.’"],</span>
