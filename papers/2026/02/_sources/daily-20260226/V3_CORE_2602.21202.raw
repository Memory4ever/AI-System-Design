<td id="S6.T1.2.4.2" class="ltx_td ltx_align_center ltx_border_t">35.8</td>
<td id="S6.T1.2.4.3" class="ltx_td ltx_align_center ltx_border_t"><span id="S6.T1.2.4.3.1" class="ltx_text ltx_underline">43.9</span></td>
<td id="S6.T1.2.4.4" class="ltx_td ltx_align_center ltx_border_t">23.5</td>
