<tr id="S6.T1.2.6" class="ltx_tr">
<th id="S6.T1.2.6.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_r" rowspan="2"><span id="S6.T1.2.6.1.1" class="ltx_text ltx_font_smallcaps">MemTok</span></th>
<td id="S6.T1.2.6.2" class="ltx_td ltx_align_center"><span id="S6.T1.2.6.2.1" class="ltx_text ltx_underline">36.3</span></td>
<td id="S6.T1.2.6.3" class="ltx_td ltx_align_center"><span id="S6.T1.2.6.3.1" class="ltx_text ltx_font_bold">45.0</span></td>
<td id="S6.T1.2.6.4" class="ltx_td ltx_align_center">25.0</td>
<td id="S6.T1.2.6.5" class="ltx_td ltx_align_center">54.4</td>
<td id="S6.T1.2.6.6" class="ltx_td ltx_align_center"><span id="S6.T1.2.6.6.1" class="ltx_text ltx_underline">54.2</span></td>
<td id="S6.T1.2.6.7" class="ltx_td ltx_align_center">69.9</td>
