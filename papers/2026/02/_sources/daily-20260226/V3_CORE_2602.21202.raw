<tr id="S6.T1.2.8" class="ltx_tr">
<th id="S6.T1.2.8.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_r" rowspan="2"><span id="S6.T1.2.8.1.1" class="ltx_text ltx_font_smallcaps">H-Pool</span></th>
<td id="S6.T1.2.8.2" class="ltx_td ltx_align_center">35.5</td>
<td id="S6.T1.2.8.3" class="ltx_td ltx_align_center">41.2</td>
<td id="S6.T1.2.8.4" class="ltx_td ltx_align_center"><span id="S6.T1.2.8.4.1" class="ltx_text ltx_underline">26.0</span></td>
<td id="S6.T1.2.8.5" class="ltx_td ltx_align_center"><span id="S6.T1.2.8.5.1" class="ltx_text ltx_underline">56.4</span></td>
<td id="S6.T1.2.8.6" class="ltx_td ltx_align_center">54.1</td>
<td id="S6.T1.2.8.7" class="ltx_td ltx_align_center"><span id="S6.T1.2.8.7.1" class="ltx_text ltx_underline">70.4</span></td>
<td id="S6.T1.2.8.8" class="ltx_td ltx_align_center"><span id="S6.T1.2.8.8.1" class="ltx_text ltx_underline">49.2</span></td>
<td id="S6.T1.2.8.9" class="ltx_td ltx_align_center"><span id="S6.T1.2.8.9.1" class="ltx_text ltx_font_bold">46.5</span></td></tr>
<tr id="S6.T1.2.9" class="ltx_tr">
<td id="S6.T1.2.9.1" class="ltx_td ltx_align_center">95.7%</td>
<td id="S6.T1.2.9.2" class="ltx_td ltx_align_center">89.2%</td>
<td id="S6.T1.2.9.3" class="ltx_td ltx_align_center">93.9%</td>
<td id="S6.T1.2.9.4" class="ltx_td ltx_align_center">94.0%</td>
<td id="S6.T1.2.9.5" class="ltx_td ltx_align_center">97.1%</td>
<td id="S6.T1.2.9.6" class="ltx_td ltx_align_center">97.6%</td>
<td id="S6.T1.2.9.7" class="ltx_td ltx_align_center">N/A</td>
<td id="S6.T1.2.9.8" class="ltx_td ltx_align_center">N/A</td></tr>
<tr id="S6.T1.2.10" class="ltx_tr">
<th id="S6.T1.2.10.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_bb ltx_border_r ltx_border_t" rowspan="2"><span id="S6.T1.2.10.1.1" class="ltx_text"><span id="S6.T1.2.10.1.1.1" class="ltx_text ltx_font_smallcaps">AGC</span> (Ours)</span></th>
<td id="S6.T1.2.10.2" class="ltx_td ltx_align_center ltx_border_t"><span id="S6.T1.2.10.2.1" class="ltx_text ltx_font_bold">37.0</span></td>
<td id="S6.T1.2.10.3" class="ltx_td ltx_align_center ltx_border_t"><span id="S6.T1.2.10.3.1" class="ltx_text ltx_font_bold">45.0</span></td>
<td id="S6.T1.2.10.4" class="ltx_td ltx_align_center ltx_border_t"><span id="S6.T1.2.10.4.1" class="ltx_text ltx_font_bold">26.3</span></td>
<td id="S6.T1.2.10.5" class="ltx_td ltx_align_center ltx_border_t"><span id="S6.T1.2.10.5.1" class="ltx_text ltx_font_bold">56.7</span></td>
<td id="S6.T1.2.10.6" class="ltx_td ltx_align_center ltx_border_t"><span id="S6.T1.2.10.6.1" class="ltx_text ltx_font_bold">56.9</span></td>
