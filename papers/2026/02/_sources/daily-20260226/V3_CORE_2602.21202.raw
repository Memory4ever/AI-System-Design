<th id="S6.T4.2.1.3" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt"><span id="S6.T4.2.1.3.1" class="ltx_text ltx_font_bold">R@1</span></th>
<th id="S6.T4.2.1.4" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt"><span id="S6.T4.2.1.4.1" class="ltx_text ltx_font_bold">R@10</span></th>
