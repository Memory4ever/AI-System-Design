<td id="S6.T4.2.3.5" class="ltx_td ltx_align_center">67.7</td></tr>
<tr id="S6.T4.2.4" class="ltx_tr">
<th id="S6.T4.2.4.1" class="ltx_td ltx_align_center ltx_th ltx_th_row">1702</th>
<th id="S6.T4.2.4.2" class="ltx_td ltx_align_center ltx_th ltx_th_row ltx_border_r">ColQwen-Omni 3B</th>
<td id="S6.T4.2.4.3" class="ltx_td ltx_align_center">40.8</td>
<td id="S6.T4.2.4.4" class="ltx_td ltx_align_center">73.8</td>
<td id="S6.T4.2.4.5" class="ltx_td ltx_align_center">56.3</td></tr>
<tr id="S6.T4.2.5" class="ltx_tr">
