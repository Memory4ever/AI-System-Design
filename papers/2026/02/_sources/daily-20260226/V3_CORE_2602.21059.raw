<span id="S4.T2.3.27.4.1" class="ltx_inline-block ltx_align_top" style="width:17.3pt;">
<span id="S4.T2.3.27.4.1.1" class="ltx_p">-</span>
</span></td></tr>
<tr id="S4.T2.3.28" class="ltx_tr">
<td id="S4.T2.3.28.1" class="ltx_td ltx_align_left ltx_align_top ltx_border_bb">
<span id="S4.T2.3.28.1.1" class="ltx_inline-block ltx_align_top" style="width:5.2pt;">
<span id="S4.T2.3.28.1.1.1" class="ltx_p">20</span>
</span></td>
<td id="S4.T2.3.28.2" class="ltx_td ltx_align_left ltx_align_top ltx_border_bb">
<span id="S4.T2.3.28.2.1" class="ltx_inline-block ltx_align_top" style="width:258.8pt;">
<span id="S4.T2.3.28.2.1.1" class="ltx_p"><span id="S4.T2.3.28.2.1.1.1" class="ltx_text ltx_font_bold">Data structure issues:</span> Problems with internal data organization leaking into system outputs.</span>
</span></td>
<td id="S4.T2.3.28.3" class="ltx_td ltx_align_left ltx_align_top ltx_border_bb">
<span id="S4.T2.3.28.3.1" class="ltx_inline-block ltx_align_top" style="width:17.3pt;">
<span id="S4.T2.3.28.3.1.1" class="ltx_p">0</span>
</span></td>
<td id="S4.T2.3.28.4" class="ltx_td ltx_align_left ltx_align_top ltx_border_bb">
<span id="S4.T2.3.28.4.1" class="ltx_inline-block ltx_align_top" style="width:17.3pt;">
