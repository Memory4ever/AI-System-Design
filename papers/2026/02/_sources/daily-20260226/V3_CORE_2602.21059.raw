<tr id="S4.T2.3.26" class="ltx_tr">
<td id="S4.T2.3.26.1" class="ltx_td ltx_align_left ltx_align_top ltx_border_t">
<span id="S4.T2.3.26.1.1" class="ltx_inline-block ltx_align_top" style="width:5.2pt;">
<span id="S4.T2.3.26.1.1.1" class="ltx_p">18</span>
