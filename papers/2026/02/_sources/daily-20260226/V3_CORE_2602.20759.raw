<td id="S5.F6.2.1.2.3" class="ltx_td ltx_align_center ltx_border_t"><span id="S5.F6.2.1.2.3.1" class="ltx_text" style="--ltx-bg-color:#E6F5FF;">42.3 / 73.3</span></td></tr>
<tr id="S5.F6.2.1.3" class="ltx_tr">
