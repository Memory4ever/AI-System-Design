<td id="A5.T10.2.3.2" class="ltx_td ltx_align_center">0.0518</td>
<td id="A5.T10.2.3.3" class="ltx_td ltx_align_center">0.0433</td></tr>
<tr id="A5.T10.2.4" class="ltx_tr">
<td id="A5.T10.2.4.1" class="ltx_td ltx_align_left ltx_border_bb">OP-GRPO (Llama3-2-3B)</td>
<td id="A5.T10.2.4.2" class="ltx_td ltx_align_center ltx_border_bb">0.0411</td>
