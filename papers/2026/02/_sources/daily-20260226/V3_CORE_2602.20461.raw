<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.Ex4.m2" class="ltx_Math" alttext="\displaystyle\mathrm{softmax}\left(\frac{\bm{S}\bm{W}^{Q}{\bm{W}^{K}}^{\top}\bm{S}^{\top}}{\sqrt{d}}\right)\bm{S}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>softmax</mi><mo>⁡</mo><mrow><mo>(</mo><mstyle displaystyle="true"><mfrac><mrow><mi>𝑺</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝑾</mi><mi>Q</mi></msup><mo lspace="0em" rspace="0em">​</mo><mmultiscripts><mi>𝑾</mi><mrow></mrow><mi>K</mi><mrow></mrow><mo>⊤</mo></mmultiscripts><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝑺</mi><mo>⊤</mo></msup></mrow><msqrt><mi>d</mi></msqrt></mfrac></mstyle><mo>)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><mi>𝑺</mi></mrow><annotation encoding="application/x-tex">\displaystyle\mathrm{softmax}\left(\frac{\bm{S}\bm{W}^{Q}{\bm{W}^{K}}^{\top}\bm{S}^{\top}}{\sqrt{d}}\right)\bm{S}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr>
