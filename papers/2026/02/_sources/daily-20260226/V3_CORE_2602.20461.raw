</span></td>
<td id="A1.T4.2.5.2" class="ltx_td ltx_align_left ltx_align_top">
<span id="A1.T4.2.5.2.1" class="ltx_inline-block ltx_align_top" style="width:284.5pt;">
<span id="A1.T4.2.5.2.1.1" class="ltx_p">The <math id="A1.T4.m11" class="ltx_Math" alttext="s" display="inline" intent=":literal"><semantics><mi>s</mi><annotation encoding="application/x-tex">s</annotation></semantics></math>-th row of <math id="A1.T4.m12" class="ltx_Math" alttext="\bm{S}" display="inline" intent=":literal"><semantics><mi>𝑺</mi><annotation encoding="application/x-tex">\bm{S}</annotation></semantics></math>, representing the feature vector for the <math id="A1.T4.m13" class="ltx_Math" alttext="s" display="inline" intent=":literal"><semantics><mi>s</mi><annotation encoding="application/x-tex">s</annotation></semantics></math>-th element</span>
</span></td></tr>
<tr id="A1.T4.2.6" class="ltx_tr">
<td id="A1.T4.2.6.1" class="ltx_td ltx_align_left ltx_align_top">
<span id="A1.T4.2.6.1.1" class="ltx_inline-block ltx_align_top" style="width:85.4pt;">
<span id="A1.T4.2.6.1.1.1" class="ltx_p"><math id="A1.T4.m14" class="ltx_math_unparsed" alttext="\bm{S}_{(:,i)}" display="inline" intent=":literal"><semantics><mrow><mi>𝑺</mi><msub><mrow></mrow><mrow><mo stretchy="false">(</mo><mo rspace="0em">:</mo><mo>,</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></msub></mrow><annotation encoding="application/x-tex">\bm{S}_{(:,i)}</annotation></semantics></math></span>
</span></td>
<td id="A1.T4.2.6.2" class="ltx_td ltx_align_left ltx_align_top">
<span id="A1.T4.2.6.2.1" class="ltx_inline-block ltx_align_top" style="width:284.5pt;">
<span id="A1.T4.2.6.2.1.1" class="ltx_p">The <math id="A1.T4.m15" class="ltx_Math" alttext="i" display="inline" intent=":literal"><semantics><mi>i</mi><annotation encoding="application/x-tex">i</annotation></semantics></math>-th column of <math id="A1.T4.m16" class="ltx_Math" alttext="\bm{S}" display="inline" intent=":literal"><semantics><mi>𝑺</mi><annotation encoding="application/x-tex">\bm{S}</annotation></semantics></math>, which represents the <math id="A1.T4.m17" class="ltx_Math" alttext="i" display="inline" intent=":literal"><semantics><mi>i</mi><annotation encoding="application/x-tex">i</annotation></semantics></math>-th feature across all elements)</span>
</span></td></tr>
<tr id="A1.T4.2.7" class="ltx_tr">
<td id="A1.T4.2.7.1" class="ltx_td ltx_align_left ltx_align_top">
