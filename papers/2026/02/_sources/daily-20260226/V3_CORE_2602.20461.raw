<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.Ex22.m1" class="ltx_math_unparsed" alttext="\displaystyle\qquad\dots,\resizebox{22142298}{}{${\mathcal{K}_{(:,i)}}^{\top}\mathrm{diag}\Big(\mathrm{softmax}\big(\mathcal{Q}_{(S,i)}{\mathcal{K}_{(:,i)}}^{\top}/\sqrt{d}\big)\Big)\mathcal{V}-{\mathcal{K}_{(:,i)}}^{\top}\big(\mathrm{softmax}\big(\mathcal{Q}_{(S,i)}{\mathcal{K}_{(:,i)}}^{\top}/\sqrt{d}\big)\big)^{\top}\mathrm{softmax}\big(\mathcal{Q}_{(S,i)}{\mathcal{K}_{(:,i)}}^{\top}/\sqrt{d}\big)\mathcal{V}$}\Bigg)\bm{S}/\sqrt{d}~." display="inline" intent=":literal"><semantics><mrow><mi mathvariant="normal">…</mi><mo>,</mo><mpadded style="width:337.9pt;height:12.1pt;vertical-align:-3.0pt;" depth="3.0pt" height="9.1pt" width="337.9pt"><mi class="ltx_font_mathcaligraphic">𝒦</mi><msub><mrow></mrow><mrow><mo stretchy="false">(</mo><mo rspace="0em">:</mo><mo>,</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></msub><msup><mrow></mrow><mo>⊤</mo></msup><mi>diag</mi><mo maxsize="1.600em" minsize="1.600em">(</mo><mi>softmax</mi><mo maxsize="1.200em" minsize="1.200em">(</mo><mi class="ltx_font_mathcaligraphic">𝒬</mi><msub><mrow></mrow><mrow><mo stretchy="false">(</mo><mi>S</mi><mo>,</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></msub><mi class="ltx_font_mathcaligraphic">𝒦</mi><msub><mrow></mrow><mrow><mo stretchy="false">(</mo><mo rspace="0em">:</mo><mo>,</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></msub><msup><mrow></mrow><mo>⊤</mo></msup><mo>/</mo><msqrt><mi>d</mi></msqrt><mo maxsize="1.200em" minsize="1.200em">)</mo><mo maxsize="1.600em" minsize="1.600em">)</mo><mi class="ltx_font_mathcaligraphic">𝒱</mi><mo>−</mo><mi class="ltx_font_mathcaligraphic">𝒦</mi><msub><mrow></mrow><mrow><mo stretchy="false">(</mo><mo rspace="0em">:</mo><mo>,</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></msub><msup><mrow></mrow><mo>⊤</mo></msup><mo maxsize="1.200em" minsize="1.200em">(</mo><mi>softmax</mi><mo maxsize="1.200em" minsize="1.200em">(</mo><mi class="ltx_font_mathcaligraphic">𝒬</mi><msub><mrow></mrow><mrow><mo stretchy="false">(</mo><mi>S</mi><mo>,</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></msub><mi class="ltx_font_mathcaligraphic">𝒦</mi><msub><mrow></mrow><mrow><mo stretchy="false">(</mo><mo rspace="0em">:</mo><mo>,</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></msub><msup><mrow></mrow><mo>⊤</mo></msup><mo>/</mo><msqrt><mi>d</mi></msqrt><mo maxsize="1.200em" minsize="1.200em">)</mo><mo maxsize="1.200em" minsize="1.200em">)</mo><msup><mrow></mrow><mo>⊤</mo></msup><mi>softmax</mi><mo maxsize="1.200em" minsize="1.200em">(</mo><mi class="ltx_font_mathcaligraphic">𝒬</mi><msub><mrow></mrow><mrow><mo stretchy="false">(</mo><mi>S</mi><mo>,</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></msub><mi class="ltx_font_mathcaligraphic">𝒦</mi><msub><mrow></mrow><mrow><mo stretchy="false">(</mo><mo rspace="0em">:</mo><mo>,</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></msub><msup><mrow></mrow><mo>⊤</mo></msup><mo>/</mo><msqrt><mi>d</mi></msqrt><mo maxsize="1.200em" minsize="1.200em">)</mo><mi class="ltx_font_mathcaligraphic">𝒱</mi></mpadded><mo maxsize="2.600em" minsize="2.600em">)</mo><mi>𝑺</mi><mo>/</mo><msqrt><mi>d</mi></msqrt><mo lspace="0.330em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\qquad\dots,\resizebox{22142298}{}{${\mathcal{K}_{(:,i)}}^{\top}\mathrm{diag}\Big(\mathrm{softmax}\big(\mathcal{Q}_{(S,i)}{\mathcal{K}_{(:,i)}}^{\top}/\sqrt{d}\big)\Big)\mathcal{V}-{\mathcal{K}_{(:,i)}}^{\top}\big(\mathrm{softmax}\big(\mathcal{Q}_{(S,i)}{\mathcal{K}_{(:,i)}}^{\top}/\sqrt{d}\big)\big)^{\top}\mathrm{softmax}\big(\mathcal{Q}_{(S,i)}{\mathcal{K}_{(:,i)}}^{\top}/\sqrt{d}\big)\mathcal{V}$}\Bigg)\bm{S}/\sqrt{d}~.</annotation></semantics></math></td>
