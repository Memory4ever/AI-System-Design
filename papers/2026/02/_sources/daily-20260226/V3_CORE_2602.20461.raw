<p id="A1.Ex22.2.3.1.1" class="ltx_p"><math id="A1.EGx24.m2.m1" class="ltx_math_unparsed" alttext="\left[\begin{array}[]{c}d^{-1/2}\underbrace{\bm{S}_{(1,:)}}_{1\times d}\cdot\underbrace{\Bigg(\overbrace{{\mathcal{K}_{(:,i)}}^{\top}}^{1\times S}\overbrace{\mathrm{diag}\Big(\mathrm{softmax}\big(\mathcal{Q}_{(1,i)}{\mathcal{K}_{(:,i)}}^{\top}/\sqrt{d}\big)\Big)}^{S\times S}\overbrace{\mathcal{V}}^{S\times 1}-\overbrace{{\mathcal{K}_{(:,i)}}^{\top}}^{1\times S}\overbrace{\big(\mathrm{softmax}\big(\mathcal{Q}_{(1,i)}{\mathcal{K}_{(:,i)}}^{\top}/\sqrt{d}\big)\big)^{\top}\mathrm{softmax}\big(\mathcal{Q}_{(1,i)}{\mathcal{K}_{(:,i)}}^{\top}/\sqrt{d}\big)}^{S\times S}\overbrace{\mathcal{V}}^{S\times 1}\Bigg)}_{1\times 1}\\
\dots\\
