<td class="ltx_td ltx_align_center ltx_eqn_cell"><math id="A2.Ex78.m1" class="ltx_Math" alttext="\displaystyle\leq" display="inline" intent=":literal"><semantics><mo>≤</mo><annotation encoding="application/x-tex">\displaystyle\leq</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex78.m2" class="ltx_math_unparsed" alttext="\displaystyle\frac{{\eta}^{2}\tau^{2}\gamma^{3}}{NS}\left\langle\left[\frac{1}{NS}\sum_{i=1}^{N}\sum_{j=1}^{S}\partial_{f_{\theta^{t}}}\mathcal{L}(f_{\theta^{t}};{\bm{S}_{i}}_{(j,:)})\right]^{\top}_{N},\bm{1}_{NS}\right\rangle\left\langle\bm{1}_{NS}^{\top},\left[\frac{1}{NS}\sum_{i=1}^{N}\sum_{j=1}^{S}\partial_{f_{\theta^{t}}}\mathcal{L}(f_{\theta^{t}};{\bm{S}_{i}}_{(j,:)})\right]_{N}\right\rangle" display="inline" intent=":literal"><semantics><mrow><mstyle displaystyle="true"><mfrac><mrow><msup><mi>η</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>τ</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>γ</mi><mn>3</mn></msup></mrow><mrow><mi>N</mi><mo lspace="0em" rspace="0em">​</mo><mi>S</mi></mrow></mfrac></mstyle><mrow><mo>⟨</mo><msubsup><mrow><mo>[</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mrow><mi>N</mi><mo lspace="0em" rspace="0em">​</mo><mi>S</mi></mrow></mfrac></mstyle><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>N</mi></munderover></mstyle><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>j</mi><mo>=</mo><mn>1</mn></mrow><mi>S</mi></munderover></mstyle><msub><mo lspace="0em">∂</mo><msub><mi>f</mi><msup><mi>θ</mi><mi>t</mi></msup></msub></msub><mi class="ltx_font_mathcaligraphic">ℒ</mi><mrow><mo stretchy="false">(</mo><msub><mi>f</mi><msup><mi>θ</mi><mi>t</mi></msup></msub><mo>;</mo><mmultiscripts><mi>𝑺</mi><mi>i</mi><mrow></mrow><mrow><mo stretchy="false">(</mo><mi>j</mi><mo>,</mo><mo rspace="0em">:</mo><mo stretchy="false">)</mo></mrow><mrow></mrow></mmultiscripts><mo stretchy="false">)</mo></mrow><mo>]</mo></mrow><mi>N</mi><mo>⊤</mo></msubsup><mo>,</mo><msub><mn>𝟏</mn><mrow><mi>N</mi><mo lspace="0em" rspace="0em">​</mo><mi>S</mi></mrow></msub><mo>⟩</mo></mrow><mrow><mo>⟨</mo><msubsup><mn>𝟏</mn><mrow><mi>N</mi><mo lspace="0em" rspace="0em">​</mo><mi>S</mi></mrow><mo>⊤</mo></msubsup><mo>,</mo><msub><mrow><mo>[</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mrow><mi>N</mi><mo lspace="0em" rspace="0em">​</mo><mi>S</mi></mrow></mfrac></mstyle><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>N</mi></munderover></mstyle><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>j</mi><mo>=</mo><mn>1</mn></mrow><mi>S</mi></munderover></mstyle><msub><mo lspace="0em">∂</mo><msub><mi>f</mi><msup><mi>θ</mi><mi>t</mi></msup></msub></msub><mi class="ltx_font_mathcaligraphic">ℒ</mi><mrow><mo stretchy="false">(</mo><msub><mi>f</mi><msup><mi>θ</mi><mi>t</mi></msup></msub><mo>;</mo><mmultiscripts><mi>𝑺</mi><mi>i</mi><mrow></mrow><mrow><mo stretchy="false">(</mo><mi>j</mi><mo>,</mo><mo rspace="0em">:</mo><mo stretchy="false">)</mo></mrow><mrow></mrow></mmultiscripts><mo stretchy="false">)</mo></mrow><mo>]</mo></mrow><mi>N</mi></msub><mo>⟩</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\frac{{\eta}^{2}\tau^{2}\gamma^{3}}{NS}\left\langle\left[\frac{1}{NS}\sum_{i=1}^{N}\sum_{j=1}^{S}\partial_{f_{\theta^{t}}}\mathcal{L}(f_{\theta^{t}};{\bm{S}_{i}}_{(j,:)})\right]^{\top}_{N},\bm{1}_{NS}\right\rangle\left\langle\bm{1}_{NS}^{\top},\left[\frac{1}{NS}\sum_{i=1}^{N}\sum_{j=1}^{S}\partial_{f_{\theta^{t}}}\mathcal{L}(f_{\theta^{t}};{\bm{S}_{i}}_{(j,:)})\right]_{N}\right\rangle</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr>
<tr class="ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_center ltx_eqn_cell"><math id="A2.E71.m1" class="ltx_Math" alttext="\displaystyle=" display="inline" intent=":literal"><semantics><mo>=</mo><annotation encoding="application/x-tex">\displaystyle=</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.E71.m2" class="ltx_math_unparsed" alttext="\displaystyle\frac{{\eta}^{2}\tau^{2}\gamma^{3}}{NS}\left(\sum_{i=1}^{N}\sum_{j=1}^{S}\partial_{f_{\theta^{t}}}\mathcal{L}(f_{\theta^{t}};{\bm{S}_{i}}_{(j,:)})\right)^{2}." display="inline" intent=":literal"><semantics><mrow><mstyle displaystyle="true"><mfrac><mrow><msup><mi>η</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>τ</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>γ</mi><mn>3</mn></msup></mrow><mrow><mi>N</mi><mo lspace="0em" rspace="0em">​</mo><mi>S</mi></mrow></mfrac></mstyle><msup><mrow><mo>(</mo><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>N</mi></munderover></mstyle><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>j</mi><mo>=</mo><mn>1</mn></mrow><mi>S</mi></munderover></mstyle><msub><mo lspace="0em">∂</mo><msub><mi>f</mi><msup><mi>θ</mi><mi>t</mi></msup></msub></msub><mi class="ltx_font_mathcaligraphic">ℒ</mi><mrow><mo stretchy="false">(</mo><msub><mi>f</mi><msup><mi>θ</mi><mi>t</mi></msup></msub><mo>;</mo><mmultiscripts><mi>𝑺</mi><mi>i</mi><mrow></mrow><mrow><mo stretchy="false">(</mo><mi>j</mi><mo>,</mo><mo rspace="0em">:</mo><mo stretchy="false">)</mo></mrow><mrow></mrow></mmultiscripts><mo stretchy="false">)</mo></mrow><mo>)</mo></mrow><mn>2</mn></msup><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\frac{{\eta}^{2}\tau^{2}\gamma^{3}}{NS}\left(\sum_{i=1}^{N}\sum_{j=1}^{S}\partial_{f_{\theta^{t}}}\mathcal{L}(f_{\theta^{t}};{\bm{S}_{i}}_{(j,:)})\right)^{2}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A2.SS2.p2.6" class="ltx_p">Thus, by combining Equations <a href="#A2.Ex67" title="B.2 Proof of Proposition ‣ Appendix B Detailed Proofs ‣ Nonparametric Teaching of Attention Learners" class="ltx_ref"><span class="ltx_text ltx_ref_tag">B.2</span></a>, <a href="#A2.Ex72" title="B.2 Proof of Proposition ‣ Appendix B Detailed Proofs ‣ Nonparametric Teaching of Attention Learners" class="ltx_ref"><span class="ltx_text ltx_ref_tag">B.2</span></a>, <a href="#A2.E70" title="In B.2 Proof of Proposition ‣ Appendix B Detailed Proofs ‣ Nonparametric Teaching of Attention Learners" class="ltx_ref"><span class="ltx_text ltx_ref_tag">70</span></a>, and <a href="#A2.E71" title="In B.2 Proof of Proposition ‣ Appendix B Detailed Proofs ‣ Nonparametric Teaching of Attention Learners" class="ltx_ref"><span class="ltx_text ltx_ref_tag">71</span></a>, we get</p>
<table id="A2.EGx47" class="ltx_equationgroup ltx_eqn_eqnarray ltx_eqn_table">

<tbody id="A2.E72"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A2.E72.m1" class="ltx_math_unparsed" alttext="\displaystyle\Upsilon\leq-\eta\gamma\left(\frac{3}{4}-{\eta}^{2}\tau^{2}\gamma^{2}\right)\left(\frac{1}{NS}\sum_{i=1}^{N}\sum_{j=1}^{S}\partial_{f_{\theta^{t}}}\mathcal{L}(f_{\theta^{t}};{\bm{S}_{i}}_{(j,:)})\right)^{2}," display="inline" intent=":literal"><semantics><mrow><mi mathvariant="normal">Υ</mi><mo rspace="0em">≤</mo><mo lspace="0em">−</mo><mi>η</mi><mi>γ</mi><mrow><mo>(</mo><mstyle displaystyle="true"><mfrac><mn>3</mn><mn>4</mn></mfrac></mstyle><mo>−</mo><msup><mi>η</mi><mn>2</mn></msup><msup><mi>τ</mi><mn>2</mn></msup><msup><mi>γ</mi><mn>2</mn></msup><mo>)</mo></mrow><msup><mrow><mo>(</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mrow><mi>N</mi><mo lspace="0em" rspace="0em">​</mo><mi>S</mi></mrow></mfrac></mstyle><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>N</mi></munderover></mstyle><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>j</mi><mo>=</mo><mn>1</mn></mrow><mi>S</mi></munderover></mstyle><msub><mo lspace="0em">∂</mo><msub><mi>f</mi><msup><mi>θ</mi><mi>t</mi></msup></msub></msub><mi class="ltx_font_mathcaligraphic">ℒ</mi><mrow><mo stretchy="false">(</mo><msub><mi>f</mi><msup><mi>θ</mi><mi>t</mi></msup></msub><mo>;</mo><mmultiscripts><mi>𝑺</mi><mi>i</mi><mrow></mrow><mrow><mo stretchy="false">(</mo><mi>j</mi><mo>,</mo><mo rspace="0em">:</mo><mo stretchy="false">)</mo></mrow><mrow></mrow></mmultiscripts><mo stretchy="false">)</mo></mrow><mo>)</mo></mrow><mn>2</mn></msup><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\Upsilon\leq-\eta\gamma\left(\frac{3}{4}-{\eta}^{2}\tau^{2}\gamma^{2}\right)\left(\frac{1}{NS}\sum_{i=1}^{N}\sum_{j=1}^{S}\partial_{f_{\theta^{t}}}\mathcal{L}(f_{\theta^{t}};{\bm{S}_{i}}_{(j,:)})\right)^{2},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(72)</span></td></tr></tbody>
</table>
<p id="A2.SS2.p2.7" class="ltx_p">which means</p>
<table id="A2.EGx48" class="ltx_equationgroup ltx_eqn_eqnarray ltx_eqn_table">

<tbody id="A2.E73"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A2.E73.m1" class="ltx_math_unparsed" alttext="\displaystyle\frac{\partial\mathcal{L}}{\partial t}\leq\Upsilon\leq-\eta\gamma\left(\frac{3}{4}-{\eta}^{2}\tau^{2}\gamma^{2}\right)\left(\frac{1}{NS}\sum_{i=1}^{N}\sum_{j=1}^{S}\partial_{f_{\theta^{t}}}\mathcal{L}(f_{\theta^{t}};{\bm{S}_{i}}_{(j,:)})\right)^{2}." display="inline" intent=":literal"><semantics><mrow><mstyle displaystyle="true"><mfrac><mrow><mo>∂</mo><mi class="ltx_font_mathcaligraphic">ℒ</mi></mrow><mrow><mo>∂</mo><mi>t</mi></mrow></mfrac></mstyle><mo>≤</mo><mi mathvariant="normal">Υ</mi><mo rspace="0em">≤</mo><mo lspace="0em">−</mo><mi>η</mi><mi>γ</mi><mrow><mo>(</mo><mstyle displaystyle="true"><mfrac><mn>3</mn><mn>4</mn></mfrac></mstyle><mo>−</mo><msup><mi>η</mi><mn>2</mn></msup><msup><mi>τ</mi><mn>2</mn></msup><msup><mi>γ</mi><mn>2</mn></msup><mo>)</mo></mrow><msup><mrow><mo>(</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mrow><mi>N</mi><mo lspace="0em" rspace="0em">​</mo><mi>S</mi></mrow></mfrac></mstyle><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>N</mi></munderover></mstyle><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>j</mi><mo>=</mo><mn>1</mn></mrow><mi>S</mi></munderover></mstyle><msub><mo lspace="0em">∂</mo><msub><mi>f</mi><msup><mi>θ</mi><mi>t</mi></msup></msub></msub><mi class="ltx_font_mathcaligraphic">ℒ</mi><mrow><mo stretchy="false">(</mo><msub><mi>f</mi><msup><mi>θ</mi><mi>t</mi></msup></msub><mo>;</mo><mmultiscripts><mi>𝑺</mi><mi>i</mi><mrow></mrow><mrow><mo stretchy="false">(</mo><mi>j</mi><mo>,</mo><mo rspace="0em">:</mo><mo stretchy="false">)</mo></mrow><mrow></mrow></mmultiscripts><mo stretchy="false">)</mo></mrow><mo>)</mo></mrow><mn>2</mn></msup><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\frac{\partial\mathcal{L}}{\partial t}\leq\Upsilon\leq-\eta\gamma\left(\frac{3}{4}-{\eta}^{2}\tau^{2}\gamma^{2}\right)\left(\frac{1}{NS}\sum_{i=1}^{N}\sum_{j=1}^{S}\partial_{f_{\theta^{t}}}\mathcal{L}(f_{\theta^{t}};{\bm{S}_{i}}_{(j,:)})\right)^{2}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(73)</span></td></tr></tbody>
</table>
<p id="A2.SS2.p2.8" class="ltx_p">Hence, if <math id="A2.SS2.p2.m6" class="ltx_Math" alttext="\eta\leq\frac{1}{2\tau\gamma}" display="inline" intent=":literal"><semantics><mrow><mi>η</mi><mo>≤</mo><mfrac><mn>1</mn><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>τ</mi><mo lspace="0em" rspace="0em">​</mo><mi>γ</mi></mrow></mfrac></mrow><annotation encoding="application/x-tex">\eta\leq\frac{1}{2\tau\gamma}</annotation></semantics></math>, it follows that</p>
<table id="A2.EGx49" class="ltx_equationgroup ltx_eqn_eqnarray ltx_eqn_table">

<tbody id="A2.E74"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A2.E74.m1" class="ltx_math_unparsed" alttext="\displaystyle\frac{\partial\mathcal{L}}{\partial t}\leq-\frac{\eta\gamma}{2}\left(\frac{1}{NS}\sum_{i=1}^{N}\sum_{j=1}^{S}\partial_{f_{\theta^{t}}}\mathcal{L}(f_{\theta^{t}};{\bm{S}_{i}}_{(j,:)})\right)^{2}=-\frac{\eta\gamma}{2}\left(\frac{1}{NS}\sum_{i=1}^{N}\sum_{j=1}^{S}\frac{\partial\mathcal{L}\left({f_{\theta^{t}}(\bm{S}_{i})}_{(j,:)},{\bm{y}_{i}}_{(j,:)}\right)}{\partial{f_{\theta^{t}}(\bm{S}_{i})}_{(j,:)}}\right)^{2}." display="inline" intent=":literal"><semantics><mrow><mstyle displaystyle="true"><mfrac><mrow><mo>∂</mo><mi class="ltx_font_mathcaligraphic">ℒ</mi></mrow><mrow><mo>∂</mo><mi>t</mi></mrow></mfrac></mstyle><mo rspace="0em">≤</mo><mo lspace="0em">−</mo><mstyle displaystyle="true"><mfrac><mrow><mi>η</mi><mo lspace="0em" rspace="0em">​</mo><mi>γ</mi></mrow><mn>2</mn></mfrac></mstyle><msup><mrow><mo>(</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mrow><mi>N</mi><mo lspace="0em" rspace="0em">​</mo><mi>S</mi></mrow></mfrac></mstyle><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>N</mi></munderover></mstyle><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>j</mi><mo>=</mo><mn>1</mn></mrow><mi>S</mi></munderover></mstyle><msub><mo lspace="0em">∂</mo><msub><mi>f</mi><msup><mi>θ</mi><mi>t</mi></msup></msub></msub><mi class="ltx_font_mathcaligraphic">ℒ</mi><mrow><mo stretchy="false">(</mo><msub><mi>f</mi><msup><mi>θ</mi><mi>t</mi></msup></msub><mo>;</mo><mmultiscripts><mi>𝑺</mi><mi>i</mi><mrow></mrow><mrow><mo stretchy="false">(</mo><mi>j</mi><mo>,</mo><mo rspace="0em">:</mo><mo stretchy="false">)</mo></mrow><mrow></mrow></mmultiscripts><mo stretchy="false">)</mo></mrow><mo>)</mo></mrow><mn>2</mn></msup><mo rspace="0em">=</mo><mo lspace="0em">−</mo><mstyle displaystyle="true"><mfrac><mrow><mi>η</mi><mo lspace="0em" rspace="0em">​</mo><mi>γ</mi></mrow><mn>2</mn></mfrac></mstyle><msup><mrow><mo>(</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mrow><mi>N</mi><mo lspace="0em" rspace="0em">​</mo><mi>S</mi></mrow></mfrac></mstyle><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>N</mi></munderover></mstyle><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>j</mi><mo>=</mo><mn>1</mn></mrow><mi>S</mi></munderover></mstyle><mstyle displaystyle="true"><mfrac><mrow><mo>∂</mo><mi class="ltx_font_mathcaligraphic">ℒ</mi><mo>(</mo><mi>f</mi><msub><mrow></mrow><msup><mi>θ</mi><mi>t</mi></msup></msub><mo stretchy="false">(</mo><mi>𝑺</mi><msub><mrow></mrow><mi>i</mi></msub><mo stretchy="false">)</mo><msub><mrow></mrow><mrow><mo stretchy="false">(</mo><mi>j</mi><mo>,</mo><mo rspace="0em">:</mo><mo stretchy="false">)</mo></mrow></msub><mo>,</mo><mi>𝒚</mi><msub><mrow></mrow><mi>i</mi></msub><msub><mrow></mrow><mrow><mo stretchy="false">(</mo><mi>j</mi><mo>,</mo><mo rspace="0em">:</mo><mo stretchy="false">)</mo></mrow></msub><mo>)</mo></mrow><mrow><mo>∂</mo><mi>f</mi><msub><mrow></mrow><msup><mi>θ</mi><mi>t</mi></msup></msub><mo stretchy="false">(</mo><mi>𝑺</mi><msub><mrow></mrow><mi>i</mi></msub><mo stretchy="false">)</mo><msub><mrow></mrow><mrow><mo stretchy="false">(</mo><mi>j</mi><mo>,</mo><mo rspace="0em">:</mo><mo stretchy="false">)</mo></mrow></msub></mrow></mfrac></mstyle><mo>)</mo></mrow><mn>2</mn></msup><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\frac{\partial\mathcal{L}}{\partial t}\leq-\frac{\eta\gamma}{2}\left(\frac{1}{NS}\sum_{i=1}^{N}\sum_{j=1}^{S}\partial_{f_{\theta^{t}}}\mathcal{L}(f_{\theta^{t}};{\bm{S}_{i}}_{(j,:)})\right)^{2}=-\frac{\eta\gamma}{2}\left(\frac{1}{NS}\sum_{i=1}^{N}\sum_{j=1}^{S}\frac{\partial\mathcal{L}\left({f_{\theta^{t}}(\bm{S}_{i})}_{(j,:)},{\bm{y}_{i}}_{(j,:)}\right)}{\partial{f_{\theta^{t}}(\bm{S}_{i})}_{(j,:)}}\right)^{2}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(74)</span></td></tr></tbody>
</table>
</div>
<div id="A2.SS2.p3" class="ltx_para ltx_noindent">
<p id="A2.SS2.p3.1" class="ltx_p"><math id="A2.SS2.p3.m1" class="ltx_Math" alttext="\blacksquare" display="inline" intent=":literal"><semantics><mi mathvariant="normal">■</mi><annotation encoding="application/x-tex">\blacksquare</annotation></semantics></math></p>
</div>
<div class="ltx_pagination ltx_role_newpage"></div>
</section>
</section>
<section id="A3" class="ltx_appendix">
<h2 class="ltx_title ltx_title_appendix"><span class="ltx_tag ltx_tag_appendix">Appendix C </span>Experiment Details</h2>

<section id="A3.SS1" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">C.1 </span>LLMs Training Setting</h3>

<div id="A3.SS1.p1" class="ltx_para ltx_noindent">
<p id="A3.SS1.p1.1" class="ltx_p">All experiments were conducted on 4 NVIDIA A100 (80GB) GPUs. We employ LoRA fine-tuning following the Alpaca <cite class="ltx_cite ltx_citemacro_citep">(<a href="#bib.bib104" title="" class="ltx_ref">Taori et al., 2023</a>)</cite> and Pizza <cite class="ltx_cite ltx_citemacro_citep">(<a href="#bib.bib114" title="" class="ltx_ref">Meng et al., 2024</a>)</cite> implementation strategy. Specifically, we optimize with AdamW using a batch size of 128, a learning rate of <math id="A3.SS1.p1.m1" class="ltx_Math" alttext="2\text{e}{-5}" display="inline" intent=":literal"><semantics><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mtext>e</mtext></mrow><mo>−</mo><mn>5</mn></mrow><annotation encoding="application/x-tex">2\text{e}{-5}</annotation></semantics></math>, cosine annealing scheduling <cite class="ltx_cite ltx_citemacro_citep">(<a href="#bib.bib106" title="" class="ltx_ref">Loshchilov and Hutter, 2017</a>)</cite>, and a warmup ratio of 0.03, without weight decay. The training objective computes loss only over responses from the selected datasets. We configure LoRA with lora_alpha=lora_r, set lora_dropout, and insert adapters into all linear layers of the base model. Both the backbone and adapters are trained in Float32 precision.</p>
</div>
<section id="A3.SS1.SSS0.Px1" class="ltx_paragraph">
<h4 class="ltx_title ltx_title_paragraph">AtteNT Setting</h4>

<div id="A3.SS1.SSS0.Px1.p1" class="ltx_para ltx_noindent">
<p id="A3.SS1.SSS0.Px1.p1.1" class="ltx_p">In this experiment, we adopt a straightforward variant of AtteNT: the model is trained on the full dataset during the first epoch, after which only the AtteNT selected subset is used in subsequent epochs. Selection is guided by the per-sample loss scores within each epoch, effectively directing the model’s attention toward harder examples. Since pretrained models already perform well on most instances, emphasizing more challenging data in later epochs is expected to yield greater fine-tuning benefits. Following prior findings in Rho-1 <cite class="ltx_cite ltx_citemacro_citep">(<a href="#bib.bib78" title="" class="ltx_ref">Lin et al., 2024</a>)</cite>, we set the selection ratio to 70%.</p>
</div>
</section>
<section id="A3.SS1.SSS0.Px2" class="ltx_paragraph">
<h4 class="ltx_title ltx_title_paragraph">Dataset Building</h4>

<div id="A3.SS1.SSS0.Px2.p1" class="ltx_para ltx_noindent">
<p id="A3.SS1.SSS0.Px2.p1.1" class="ltx_p">The ImageNetS50 dataset is derived from the ImageNet-1k benchmark, and its construction requires access to a local copy of ImageNet-1k. Following the official repository <cite class="ltx_cite ltx_citemacro_citep">(<a href="#bib.bib108" title="" class="ltx_ref">Gao et al., 2021</a>)</cite>, we generate ImageNetS50 by running <span id="A3.SS1.SSS0.Px2.p1.1.1" class="ltx_text ltx_font_typewriter">data_preparation.sh</span> with the option <span id="A3.SS1.SSS0.Px2.p1.1.2" class="ltx_text ltx_font_typewriter">--mode=50</span>. Semantic segmentation annotations are obtained using <span id="A3.SS1.SSS0.Px2.p1.1.3" class="ltx_text ltx_font_typewriter">datapreparation_anno.sh</span>. For depth annotations, we employ the Mask2Former <cite class="ltx_cite ltx_citemacro_citep">(<a href="#bib.bib113" title="" class="ltx_ref">Cheng et al., 2022</a>)</cite> framework, utilizing its released code and pretrained models to generate pseudo-labels. In addition, we directly download the full NYUv2 dataset, where the official semantic segmentation and depth test sets are used for evaluation.</p>
</div>
</section>
</section>
<section id="A3.SS2" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">C.2 </span>ViTs Training Setting</h3>

<div id="A3.SS2.p1" class="ltx_para ltx_noindent">
<p id="A3.SS2.p1.1" class="ltx_p">We adopt ViT-B <cite class="ltx_cite ltx_citemacro_citep">(<a href="#bib.bib65" title="" class="ltx_ref">Dosovitskiy et al., 2020</a>)</cite> with a <math id="A3.SS2.p1.m1" class="ltx_Math" alttext="16\times 16" display="inline" intent=":literal"><semantics><mrow><mn>16</mn><mo lspace="0.222em" rspace="0.222em">×</mo><mn>16</mn></mrow><annotation encoding="application/x-tex">16\times 16</annotation></semantics></math> patch size as the backbone for our MAE experiments and evaluate performance on ImageNet-S50. Training is performed using AdamW with a base learning rate of <math id="A3.SS2.p1.m2" class="ltx_Math" alttext="1\text{e}{-4}" display="inline" intent=":literal"><semantics><mrow><mrow><mn>1</mn><mo lspace="0em" rspace="0em">​</mo><mtext>e</mtext></mrow><mo>−</mo><mn>4</mn></mrow><annotation encoding="application/x-tex">1\text{e}{-4}</annotation></semantics></math> and weight decay of 0.05. The learning rate is linearly warmed up for 40 epochs, followed by cosine decay scheduling <cite class="ltx_cite ltx_citemacro_citep">(<a href="#bib.bib106" title="" class="ltx_ref">Loshchilov and Hutter, 2017</a>)</cite>. We train with a batch size of 2048 on 4 A100 GPUs, leveraging automatic mixed precision for efficiency. Data augmentation is limited to standard transformations: random cropping with scale sampled from [0.2, 1.0] and aspect ratio from [0.75, 1.33], resizing to <math id="A3.SS2.p1.m3" class="ltx_Math" alttext="224\times 224" display="inline" intent=":literal"><semantics><mrow><mn>224</mn><mo lspace="0.222em" rspace="0.222em">×</mo><mn>224</mn></mrow><annotation encoding="application/x-tex">224\times 224</annotation></semantics></math>, and random horizontal flipping with probability 0.5. A full specification of hyperparameters for pretraining and fine-tuning is provided in Tables <a href="#A3.T5" title="Table 5 ‣ C.2 ViTs Training Setting ‣ Appendix C Experiment Details ‣ Nonparametric Teaching of Attention Learners" class="ltx_ref"><span class="ltx_text ltx_ref_tag">5</span></a> and <a href="#A3.T6" title="Table 6 ‣ C.2 ViTs Training Setting ‣ Appendix C Experiment Details ‣ Nonparametric Teaching of Attention Learners" class="ltx_ref"><span class="ltx_text ltx_ref_tag">6</span></a>.</p>
</div>
