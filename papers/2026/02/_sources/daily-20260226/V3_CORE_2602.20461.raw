<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.Ex43.m2" class="ltx_math_unparsed" alttext="\displaystyle-\frac{\eta}{NS}\left[\frac{\partial\mathcal{L}(f_{\theta^{t}}(\bm{S}_{1}),\bm{y}_{1})}{\partial f_{\theta^{t}}(\bm{S}_{1})},\dots,\frac{\partial\mathcal{L}(f_{\theta^{t}}(\bm{S}_{N}),\bm{y}_{N})}{\partial f_{\theta^{t}}(\bm{S}_{N})}\right]\cdot\left[\left\langle\frac{\partial f_{\theta^{t}}(\cdot)}{\partial\theta^{t}},\frac{\partial f_{\theta^{t}}(\bm{S}_{i})}{\partial\theta^{t}}\right\rangle\right]_{N}" display="inline" intent=":literal"><semantics><mrow><mo>−</mo><mstyle displaystyle="true"><mfrac><mi>η</mi><mrow><mi>N</mi><mo lspace="0em" rspace="0em">​</mo><mi>S</mi></mrow></mfrac></mstyle><mrow><mo>[</mo><mstyle displaystyle="true"><mfrac><mrow><mo>∂</mo><mrow><mi class="ltx_font_mathcaligraphic">ℒ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>f</mi><msup><mi>θ</mi><mi>t</mi></msup></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝑺</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><msub><mi>𝒚</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mrow><mo>∂</mo><mrow><msub><mi>f</mi><msup><mi>θ</mi><mi>t</mi></msup></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝑺</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow></mrow></mrow></mfrac></mstyle><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mstyle displaystyle="true"><mfrac><mrow><mo>∂</mo><mrow><mi class="ltx_font_mathcaligraphic">ℒ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>f</mi><msup><mi>θ</mi><mi>t</mi></msup></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝑺</mi><mi>N</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><msub><mi>𝒚</mi><mi>N</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mrow><mo>∂</mo><mrow><msub><mi>f</mi><msup><mi>θ</mi><mi>t</mi></msup></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝑺</mi><mi>N</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow></mfrac></mstyle><mo rspace="0.055em">]</mo></mrow><mo rspace="0.222em">⋅</mo><msub><mrow><mo>[</mo><mrow><mo>⟨</mo><mstyle displaystyle="true"><mfrac><mrow><mo>∂</mo><mrow><msub><mi>f</mi><msup><mi>θ</mi><mi>t</mi></msup></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo stretchy="false">)</mo></mrow></mrow></mrow><mrow><mo>∂</mo><msup><mi>θ</mi><mi>t</mi></msup></mrow></mfrac></mstyle><mo>,</mo><mstyle displaystyle="true"><mfrac><mrow><mo>∂</mo><mrow><msub><mi>f</mi><msup><mi>θ</mi><mi>t</mi></msup></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝑺</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mrow><mo>∂</mo><msup><mi>θ</mi><mi>t</mi></msup></mrow></mfrac></mstyle><mo>⟩</mo></mrow><mo>]</mo></mrow><mi>N</mi></msub></mrow><annotation encoding="application/x-tex">\displaystyle-\frac{\eta}{NS}\left[\frac{\partial\mathcal{L}(f_{\theta^{t}}(\bm{S}_{1}),\bm{y}_{1})}{\partial f_{\theta^{t}}(\bm{S}_{1})},\dots,\frac{\partial\mathcal{L}(f_{\theta^{t}}(\bm{S}_{N}),\bm{y}_{N})}{\partial f_{\theta^{t}}(\bm{S}_{N})}\right]\cdot\left[\left\langle\frac{\partial f_{\theta^{t}}(\cdot)}{\partial\theta^{t}},\frac{\partial f_{\theta^{t}}(\bm{S}_{i})}{\partial\theta^{t}}\right\rangle\right]_{N}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr>
