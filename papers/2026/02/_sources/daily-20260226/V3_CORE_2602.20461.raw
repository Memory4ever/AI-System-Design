<div id="A2.SS2.p2" class="ltx_para ltx_noindent">
<p id="A2.SS2.p2.1" class="ltx_p">Based on the definition of the evaluation functional and the assumption that <math id="A2.SS2.p2.m1" class="ltx_Math" alttext="\mathcal{L}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">ℒ</mi><annotation encoding="application/x-tex">\mathcal{L}</annotation></semantics></math> is Lipschitz smooth with a constant <math id="A2.SS2.p2.m2" class="ltx_Math" alttext="\tau&gt;0" display="inline" intent=":literal"><semantics><mrow><mi>τ</mi><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\tau&gt;0</annotation></semantics></math>, the term <math id="A2.SS2.p2.m3" class="ltx_Math" alttext="\Psi" display="inline" intent=":literal"><semantics><mi mathvariant="normal">Ψ</mi><annotation encoding="application/x-tex">\Psi</annotation></semantics></math> in the final part of Equation <a href="#A2.Ex67" title="B.2 Proof of Proposition ‣ Appendix B Detailed Proofs ‣ Nonparametric Teaching of Attention Learners" class="ltx_ref"><span class="ltx_text ltx_ref_tag">B.2</span></a> is bounded above as follows:</p>
<table id="A2.EGx42" class="ltx_equationgroup ltx_eqn_eqnarray ltx_eqn_table">

<tbody id="A2.Ex72"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A2.Ex68.m1" class="ltx_Math" alttext="\displaystyle\Psi" display="inline" intent=":literal"><semantics><mi mathvariant="normal">Ψ</mi><annotation encoding="application/x-tex">\displaystyle\Psi</annotation></semantics></math></td>
<td class="ltx_td ltx_align_center ltx_eqn_cell"><math id="A2.Ex68.m2" class="ltx_Math" alttext="\displaystyle=" display="inline" intent=":literal"><semantics><mo>=</mo><annotation encoding="application/x-tex">\displaystyle=</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex68.m3" class="ltx_Math" alttext="\displaystyle\left[\partial_{f_{\theta^{t+1}}}\mathcal{L}(f_{\theta^{t+1}};\bm{S}_{i})-\partial_{f_{\theta^{t}}}\mathcal{L}(f_{\theta^{t}};\bm{S}_{i})\right]_{N}^{\top}\bar{\bm{K}}\left[\partial_{f_{\theta^{t+1}}}\mathcal{L}(f_{\theta^{t+1}};\bm{S}_{i})-\partial_{f_{\theta^{t}}}\mathcal{L}(f_{\theta^{t}};\bm{S}_{i})\right]_{N}" display="inline" intent=":literal"><semantics><mrow><msubsup><mrow><mo>[</mo><mrow><mrow><msub><mo lspace="0em">∂</mo><msub><mi>f</mi><msup><mi>θ</mi><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow></msup></msub></msub><mrow><mi class="ltx_font_mathcaligraphic">ℒ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>f</mi><msup><mi>θ</mi><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow></msup></msub><mo>,</mo><msub><mi>𝑺</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo rspace="0.055em">−</mo><mrow><msub><mo>∂</mo><msub><mi>f</mi><msup><mi>θ</mi><mi>t</mi></msup></msub></msub><mrow><mi class="ltx_font_mathcaligraphic">ℒ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>f</mi><msup><mi>θ</mi><mi>t</mi></msup></msub><mo>,</mo><msub><mi>𝑺</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo>]</mo></mrow><mi>N</mi><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mover accent="true"><mi>𝑲</mi><mo>¯</mo></mover><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo>[</mo><mrow><mrow><msub><mo lspace="0em">∂</mo><msub><mi>f</mi><msup><mi>θ</mi><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow></msup></msub></msub><mrow><mi class="ltx_font_mathcaligraphic">ℒ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>f</mi><msup><mi>θ</mi><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow></msup></msub><mo>,</mo><msub><mi>𝑺</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo rspace="0.055em">−</mo><mrow><msub><mo>∂</mo><msub><mi>f</mi><msup><mi>θ</mi><mi>t</mi></msup></msub></msub><mrow><mi class="ltx_font_mathcaligraphic">ℒ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>f</mi><msup><mi>θ</mi><mi>t</mi></msup></msub><mo>,</mo><msub><mi>𝑺</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo>]</mo></mrow><mi>N</mi></msub></mrow><annotation encoding="application/x-tex">\displaystyle\left[\partial_{f_{\theta^{t+1}}}\mathcal{L}(f_{\theta^{t+1}};\bm{S}_{i})-\partial_{f_{\theta^{t}}}\mathcal{L}(f_{\theta^{t}};\bm{S}_{i})\right]_{N}^{\top}\bar{\bm{K}}\left[\partial_{f_{\theta^{t+1}}}\mathcal{L}(f_{\theta^{t+1}};\bm{S}_{i})-\partial_{f_{\theta^{t}}}\mathcal{L}(f_{\theta^{t}};\bm{S}_{i})\right]_{N}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr>
<tr class="ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_center ltx_eqn_cell"><math id="A2.Ex69.m1" class="ltx_Math" alttext="\displaystyle=" display="inline" intent=":literal"><semantics><mo>=</mo><annotation encoding="application/x-tex">\displaystyle=</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex69.m2" class="ltx_Math" alttext="\displaystyle\left[E_{\bm{S}_{i}}\left(\frac{\partial\mathcal{L}(f_{\theta^{t+1}})}{\partial f_{\theta^{t+1}}}-\frac{\partial\mathcal{L}(f_{\theta^{t}})}{\partial f_{\theta^{t}}}\right)\right]^{\top}_{N}\bar{\bm{K}}\left[E_{\bm{S}_{i}}\left(\frac{\partial\mathcal{L}(f_{\theta^{t+1}})}{\partial f_{\theta^{t+1}}}-\frac{\partial\mathcal{L}(f_{\theta^{t}})}{\partial f_{\theta^{t}}}\right)\right]_{N}" display="inline" intent=":literal"><semantics><mrow><msubsup><mrow><mo>[</mo><mrow><msub><mi>E</mi><msub><mi>𝑺</mi><mi>i</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mo>∂</mo><mrow><mi class="ltx_font_mathcaligraphic">ℒ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>f</mi><msup><mi>θ</mi><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow></msup></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mrow><mo>∂</mo><msub><mi>f</mi><msup><mi>θ</mi><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow></msup></msub></mrow></mfrac></mstyle><mo>−</mo><mstyle displaystyle="true"><mfrac><mrow><mo>∂</mo><mrow><mi class="ltx_font_mathcaligraphic">ℒ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>f</mi><msup><mi>θ</mi><mi>t</mi></msup></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mrow><mo>∂</mo><msub><mi>f</mi><msup><mi>θ</mi><mi>t</mi></msup></msub></mrow></mfrac></mstyle></mrow><mo>)</mo></mrow></mrow><mo>]</mo></mrow><mi>N</mi><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mover accent="true"><mi>𝑲</mi><mo>¯</mo></mover><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo>[</mo><mrow><msub><mi>E</mi><msub><mi>𝑺</mi><mi>i</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mo>∂</mo><mrow><mi class="ltx_font_mathcaligraphic">ℒ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>f</mi><msup><mi>θ</mi><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow></msup></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mrow><mo>∂</mo><msub><mi>f</mi><msup><mi>θ</mi><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow></msup></msub></mrow></mfrac></mstyle><mo>−</mo><mstyle displaystyle="true"><mfrac><mrow><mo>∂</mo><mrow><mi class="ltx_font_mathcaligraphic">ℒ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>f</mi><msup><mi>θ</mi><mi>t</mi></msup></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mrow><mo>∂</mo><msub><mi>f</mi><msup><mi>θ</mi><mi>t</mi></msup></msub></mrow></mfrac></mstyle></mrow><mo>)</mo></mrow></mrow><mo>]</mo></mrow><mi>N</mi></msub></mrow><annotation encoding="application/x-tex">\displaystyle\left[E_{\bm{S}_{i}}\left(\frac{\partial\mathcal{L}(f_{\theta^{t+1}})}{\partial f_{\theta^{t+1}}}-\frac{\partial\mathcal{L}(f_{\theta^{t}})}{\partial f_{\theta^{t}}}\right)\right]^{\top}_{N}\bar{\bm{K}}\left[E_{\bm{S}_{i}}\left(\frac{\partial\mathcal{L}(f_{\theta^{t+1}})}{\partial f_{\theta^{t+1}}}-\frac{\partial\mathcal{L}(f_{\theta^{t}})}{\partial f_{\theta^{t}}}\right)\right]_{N}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr>
<tr class="ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_center ltx_eqn_cell"><math id="A2.Ex70.m1" class="ltx_Math" alttext="\displaystyle\leq" display="inline" intent=":literal"><semantics><mo>≤</mo><annotation encoding="application/x-tex">\displaystyle\leq</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex70.m2" class="ltx_Math" alttext="\displaystyle\tau^{2}\left[E_{\bm{S}_{i}}\left(f_{\theta^{t+1}}-f_{\theta^{t}}\right)\right]^{\top}_{N}\bar{\bm{K}}\left[E_{\bm{S}_{i}}\left(f_{\theta^{t+1}}-f_{\theta^{t}}\right)\right]_{N}" display="inline" intent=":literal"><semantics><mrow><msup><mi>τ</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msubsup><mrow><mo>[</mo><mrow><msub><mi>E</mi><msub><mi>𝑺</mi><mi>i</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><msub><mi>f</mi><msup><mi>θ</mi><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow></msup></msub><mo>−</mo><msub><mi>f</mi><msup><mi>θ</mi><mi>t</mi></msup></msub></mrow><mo>)</mo></mrow></mrow><mo>]</mo></mrow><mi>N</mi><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mover accent="true"><mi>𝑲</mi><mo>¯</mo></mover><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo>[</mo><mrow><msub><mi>E</mi><msub><mi>𝑺</mi><mi>i</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><msub><mi>f</mi><msup><mi>θ</mi><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow></msup></msub><mo>−</mo><msub><mi>f</mi><msup><mi>θ</mi><mi>t</mi></msup></msub></mrow><mo>)</mo></mrow></mrow><mo>]</mo></mrow><mi>N</mi></msub></mrow><annotation encoding="application/x-tex">\displaystyle\tau^{2}\left[E_{\bm{S}_{i}}\left(f_{\theta^{t+1}}-f_{\theta^{t}}\right)\right]^{\top}_{N}\bar{\bm{K}}\left[E_{\bm{S}_{i}}\left(f_{\theta^{t+1}}-f_{\theta^{t}}\right)\right]_{N}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr>
<tr class="ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_center ltx_eqn_cell"><math id="A2.Ex71.m1" class="ltx_Math" alttext="\displaystyle=" display="inline" intent=":literal"><semantics><mo>=</mo><annotation encoding="application/x-tex">\displaystyle=</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex71.m2" class="ltx_Math" alttext="\displaystyle\tau^{2}\left\langle\left(f_{\theta^{t+1}}-f_{\theta^{t}}\right),\left[K_{\bm{S}_{i}}\right]^{\top}_{N}\right\rangle_{\mathcal{H}}\cdot\bar{\bm{K}}\cdot\left\langle\left[K_{\bm{S}_{i}}\right]_{N},\left(f_{\theta^{t+1}}-f_{\theta^{t}}\right)\right\rangle_{\mathcal{H}}" display="inline" intent=":literal"><semantics><mrow><mrow><msup><mi>τ</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo>⟨</mo><mrow><mrow><mo>(</mo><mrow><msub><mi>f</mi><msup><mi>θ</mi><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow></msup></msub><mo>−</mo><msub><mi>f</mi><msup><mi>θ</mi><mi>t</mi></msup></msub></mrow><mo>)</mo></mrow><mo>,</mo><msubsup><mrow><mo>[</mo><msub><mi>K</mi><msub><mi>𝑺</mi><mi>i</mi></msub></msub><mo>]</mo></mrow><mi>N</mi><mo>⊤</mo></msubsup></mrow><mo rspace="0.055em">⟩</mo></mrow><mi class="ltx_font_mathcaligraphic">ℋ</mi></msub></mrow><mo rspace="0.222em">⋅</mo><mover accent="true"><mi>𝑲</mi><mo>¯</mo></mover><mo lspace="0.222em" rspace="0.222em">⋅</mo><msub><mrow><mo>⟨</mo><mrow><msub><mrow><mo>[</mo><msub><mi>K</mi><msub><mi>𝑺</mi><mi>i</mi></msub></msub><mo>]</mo></mrow><mi>N</mi></msub><mo>,</mo><mrow><mo>(</mo><mrow><msub><mi>f</mi><msup><mi>θ</mi><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow></msup></msub><mo>−</mo><msub><mi>f</mi><msup><mi>θ</mi><mi>t</mi></msup></msub></mrow><mo>)</mo></mrow></mrow><mo>⟩</mo></mrow><mi class="ltx_font_mathcaligraphic">ℋ</mi></msub></mrow><annotation encoding="application/x-tex">\displaystyle\tau^{2}\left\langle\left(f_{\theta^{t+1}}-f_{\theta^{t}}\right),\left[K_{\bm{S}_{i}}\right]^{\top}_{N}\right\rangle_{\mathcal{H}}\cdot\bar{\bm{K}}\cdot\left\langle\left[K_{\bm{S}_{i}}\right]_{N},\left(f_{\theta^{t+1}}-f_{\theta^{t}}\right)\right\rangle_{\mathcal{H}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr>
<tr class="ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_center ltx_eqn_cell"><math id="A2.Ex72.m1" class="ltx_Math" alttext="\displaystyle=" display="inline" intent=":literal"><semantics><mo>=</mo><annotation encoding="application/x-tex">\displaystyle=</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex72.m2" class="ltx_Math" alttext="\displaystyle{\eta}^{2}\tau^{2}\cdot\left[\partial_{f_{\theta^{t}}}\mathcal{L}(f_{\theta^{t}};\bm{S}_{i})\right]_{N}^{\top}\frac{\left\langle\left[K_{\bm{S}_{i}}\right]_{N},[K_{\bm{S}_{i}}]^{\top}_{N}\right\rangle_{\mathcal{H}}}{NS}\cdot\bar{\bm{K}}\cdot\frac{\left\langle\left[K_{\bm{S}_{i}}\right]_{N},[K_{\bm{S}_{i}}]^{\top}_{N}\right\rangle_{\mathcal{H}}}{NS}\cdot\left[\partial_{f_{\theta^{t}}}\mathcal{L}(f_{\theta^{t}};\bm{S}_{i})\right]_{N}~." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mrow><mrow><msup><mi>η</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>τ</mi><mn>2</mn></msup></mrow><mo lspace="0.222em" rspace="0.222em">⋅</mo><msubsup><mrow><mo>[</mo><mrow><msub><mo lspace="0em">∂</mo><msub><mi>f</mi><msup><mi>θ</mi><mi>t</mi></msup></msub></msub><mrow><mi class="ltx_font_mathcaligraphic">ℒ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>f</mi><msup><mi>θ</mi><mi>t</mi></msup></msub><mo>,</mo><msub><mi>𝑺</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>]</mo></mrow><mi>N</mi><mo>⊤</mo></msubsup></mrow><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><msub><mrow><mo>⟨</mo><mrow><msub><mrow><mo>[</mo><msub><mi>K</mi><msub><mi>𝑺</mi><mi>i</mi></msub></msub><mo>]</mo></mrow><mi>N</mi></msub><mo>,</mo><msubsup><mrow><mo stretchy="false">[</mo><msub><mi>K</mi><msub><mi>𝑺</mi><mi>i</mi></msub></msub><mo stretchy="false">]</mo></mrow><mi>N</mi><mo>⊤</mo></msubsup></mrow><mo>⟩</mo></mrow><mi class="ltx_font_mathcaligraphic">ℋ</mi></msub><mrow><mi>N</mi><mo lspace="0em" rspace="0em">​</mo><mi>S</mi></mrow></mfrac></mstyle></mrow><mo lspace="0.222em" rspace="0.222em">⋅</mo><mover accent="true"><mi>𝑲</mi><mo>¯</mo></mover><mo lspace="0.222em" rspace="0.222em">⋅</mo><mstyle displaystyle="true"><mfrac><msub><mrow><mo>⟨</mo><mrow><msub><mrow><mo>[</mo><msub><mi>K</mi><msub><mi>𝑺</mi><mi>i</mi></msub></msub><mo>]</mo></mrow><mi>N</mi></msub><mo>,</mo><msubsup><mrow><mo stretchy="false">[</mo><msub><mi>K</mi><msub><mi>𝑺</mi><mi>i</mi></msub></msub><mo stretchy="false">]</mo></mrow><mi>N</mi><mo>⊤</mo></msubsup></mrow><mo>⟩</mo></mrow><mi class="ltx_font_mathcaligraphic">ℋ</mi></msub><mrow><mi>N</mi><mo lspace="0em" rspace="0em">​</mo><mi>S</mi></mrow></mfrac></mstyle><mo lspace="0.222em" rspace="0.222em">⋅</mo><msub><mrow><mo>[</mo><mrow><msub><mo lspace="0em">∂</mo><msub><mi>f</mi><msup><mi>θ</mi><mi>t</mi></msup></msub></msub><mrow><mi class="ltx_font_mathcaligraphic">ℒ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>f</mi><msup><mi>θ</mi><mi>t</mi></msup></msub><mo>,</mo><msub><mi>𝑺</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>]</mo></mrow><mi>N</mi></msub></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle{\eta}^{2}\tau^{2}\cdot\left[\partial_{f_{\theta^{t}}}\mathcal{L}(f_{\theta^{t}};\bm{S}_{i})\right]_{N}^{\top}\frac{\left\langle\left[K_{\bm{S}_{i}}\right]_{N},[K_{\bm{S}_{i}}]^{\top}_{N}\right\rangle_{\mathcal{H}}}{NS}\cdot\bar{\bm{K}}\cdot\frac{\left\langle\left[K_{\bm{S}_{i}}\right]_{N},[K_{\bm{S}_{i}}]^{\top}_{N}\right\rangle_{\mathcal{H}}}{NS}\cdot\left[\partial_{f_{\theta^{t}}}\mathcal{L}(f_{\theta^{t}};\bm{S}_{i})\right]_{N}~.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A2.SS2.p2.2" class="ltx_p">Given that the canonical kernel is bounded above by a constant <math id="A2.SS2.p2.m4" class="ltx_Math" alttext="\gamma&gt;0" display="inline" intent=":literal"><semantics><mrow><mi>γ</mi><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\gamma&gt;0</annotation></semantics></math>, we have</p>
<table id="A2.EGx43" class="ltx_equationgroup ltx_eqn_eqnarray ltx_eqn_table">

<tbody id="A2.Ex73"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A2.Ex73.m1" class="ltx_Math" alttext="\displaystyle\left\langle\left[K_{\bm{S}_{i}}\right]_{N},[K_{\bm{S}_{i}}]^{\top}_{N}\right\rangle_{\mathcal{H}}\leq\gamma\left\langle\bm{1}_{NS},\bm{1}_{NS}^{\top}\right\rangle," display="inline" intent=":literal"><semantics><mrow><mrow><msub><mrow><mo>⟨</mo><mrow><msub><mrow><mo>[</mo><msub><mi>K</mi><msub><mi>𝑺</mi><mi>i</mi></msub></msub><mo>]</mo></mrow><mi>N</mi></msub><mo>,</mo><msubsup><mrow><mo stretchy="false">[</mo><msub><mi>K</mi><msub><mi>𝑺</mi><mi>i</mi></msub></msub><mo stretchy="false">]</mo></mrow><mi>N</mi><mo>⊤</mo></msubsup></mrow><mo>⟩</mo></mrow><mi class="ltx_font_mathcaligraphic">ℋ</mi></msub><mo>≤</mo><mrow><mi>γ</mi><mo>⁡</mo><mrow><mo>⟨</mo><mrow><msub><mn>𝟏</mn><mrow><mi>N</mi><mo lspace="0em" rspace="0em">​</mo><mi>S</mi></mrow></msub><mo>,</mo><msubsup><mn>𝟏</mn><mrow><mi>N</mi><mo lspace="0em" rspace="0em">​</mo><mi>S</mi></mrow><mo>⊤</mo></msubsup></mrow><mo>⟩</mo></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\left\langle\left[K_{\bm{S}_{i}}\right]_{N},[K_{\bm{S}_{i}}]^{\top}_{N}\right\rangle_{\mathcal{H}}\leq\gamma\left\langle\bm{1}_{NS},\bm{1}_{NS}^{\top}\right\rangle,</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A2.SS2.p2.3" class="ltx_p">and</p>
<table id="A2.EGx44" class="ltx_equationgroup ltx_eqn_eqnarray ltx_eqn_table">

<tbody id="A2.Ex74"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A2.Ex74.m1" class="ltx_Math" alttext="\displaystyle\bar{\bm{K}}\leq\frac{\gamma}{NS}\left\langle\bm{1}_{NS},\bm{1}_{NS}^{\top}\right\rangle~." display="inline" intent=":literal"><semantics><mrow><mrow><mover accent="true"><mi>𝑲</mi><mo>¯</mo></mover><mo>≤</mo><mrow><mstyle displaystyle="true"><mfrac><mi>γ</mi><mrow><mi>N</mi><mo lspace="0em" rspace="0em">​</mo><mi>S</mi></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mo>⟨</mo><mrow><msub><mn>𝟏</mn><mrow><mi>N</mi><mo lspace="0em" rspace="0em">​</mo><mi>S</mi></mrow></msub><mo>,</mo><msubsup><mn>𝟏</mn><mrow><mi>N</mi><mo lspace="0em" rspace="0em">​</mo><mi>S</mi></mrow><mo>⊤</mo></msubsup></mrow><mo rspace="0.052em">⟩</mo></mrow></mrow></mrow><mo>.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\bar{\bm{K}}\leq\frac{\gamma}{NS}\left\langle\bm{1}_{NS},\bm{1}_{NS}^{\top}\right\rangle~.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A2.SS2.p2.4" class="ltx_p">Therefore, <math id="A2.SS2.p2.m5" class="ltx_Math" alttext="\Phi" display="inline" intent=":literal"><semantics><mi mathvariant="normal">Φ</mi><annotation encoding="application/x-tex">\Phi</annotation></semantics></math> is bounded above by</p>
<table id="A2.EGx45" class="ltx_equationgroup ltx_eqn_eqnarray ltx_eqn_table">

<tbody id="A2.E70"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A2.Ex75.m1" class="ltx_Math" alttext="\displaystyle\Phi" display="inline" intent=":literal"><semantics><mi mathvariant="normal">Φ</mi><annotation encoding="application/x-tex">\displaystyle\Phi</annotation></semantics></math></td>
<td class="ltx_td ltx_align_center ltx_eqn_cell"><math id="A2.Ex75.m2" class="ltx_Math" alttext="\displaystyle\leq" display="inline" intent=":literal"><semantics><mo>≤</mo><annotation encoding="application/x-tex">\displaystyle\leq</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex75.m3" class="ltx_Math" alttext="\displaystyle\frac{\gamma}{NS}\left\langle\left[\partial_{f_{\theta^{t}}}\mathcal{L}(f_{\theta^{t}};\bm{S}_{i})\right]^{\top}_{N},\bm{1}_{NS}\right\rangle\left\langle\bm{1}_{NS}^{\top},\left[\partial_{f_{\theta^{t}}}\mathcal{L}(f_{\theta^{t}};\bm{S}_{i})\right]_{N}\right\rangle" display="inline" intent=":literal"><semantics><mrow><mstyle displaystyle="true"><mfrac><mi>γ</mi><mrow><mi>N</mi><mo lspace="0em" rspace="0em">​</mo><mi>S</mi></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mo>⟨</mo><mrow><msubsup><mrow><mo>[</mo><mrow><msub><mo lspace="0em">∂</mo><msub><mi>f</mi><msup><mi>θ</mi><mi>t</mi></msup></msub></msub><mrow><mi class="ltx_font_mathcaligraphic">ℒ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>f</mi><msup><mi>θ</mi><mi>t</mi></msup></msub><mo>,</mo><msub><mi>𝑺</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>]</mo></mrow><mi>N</mi><mo>⊤</mo></msubsup><mo>,</mo><msub><mn>𝟏</mn><mrow><mi>N</mi><mo lspace="0em" rspace="0em">​</mo><mi>S</mi></mrow></msub></mrow><mo>⟩</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo>⟨</mo><mrow><msubsup><mn>𝟏</mn><mrow><mi>N</mi><mo lspace="0em" rspace="0em">​</mo><mi>S</mi></mrow><mo>⊤</mo></msubsup><mo>,</mo><msub><mrow><mo>[</mo><mrow><msub><mo lspace="0em">∂</mo><msub><mi>f</mi><msup><mi>θ</mi><mi>t</mi></msup></msub></msub><mrow><mi class="ltx_font_mathcaligraphic">ℒ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>f</mi><msup><mi>θ</mi><mi>t</mi></msup></msub><mo>,</mo><msub><mi>𝑺</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>]</mo></mrow><mi>N</mi></msub></mrow><mo>⟩</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\frac{\gamma}{NS}\left\langle\left[\partial_{f_{\theta^{t}}}\mathcal{L}(f_{\theta^{t}};\bm{S}_{i})\right]^{\top}_{N},\bm{1}_{NS}\right\rangle\left\langle\bm{1}_{NS}^{\top},\left[\partial_{f_{\theta^{t}}}\mathcal{L}(f_{\theta^{t}};\bm{S}_{i})\right]_{N}\right\rangle</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="2" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(70)</span></td></tr>
<tr class="ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_center ltx_eqn_cell"><math id="A2.E70.m1" class="ltx_Math" alttext="\displaystyle=" display="inline" intent=":literal"><semantics><mo>=</mo><annotation encoding="application/x-tex">\displaystyle=</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.E70.m2" class="ltx_math_unparsed" alttext="\displaystyle\frac{\gamma}{NS}\left(\sum_{i=1}^{N}\sum_{j=1}^{S}\partial_{f_{\theta^{t}}}\mathcal{L}(f_{\theta^{t}};{\bm{S}_{i}}_{(j,:)})\right)^{2}." display="inline" intent=":literal"><semantics><mrow><mstyle displaystyle="true"><mfrac><mi>γ</mi><mrow><mi>N</mi><mo lspace="0em" rspace="0em">​</mo><mi>S</mi></mrow></mfrac></mstyle><msup><mrow><mo>(</mo><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>N</mi></munderover></mstyle><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>j</mi><mo>=</mo><mn>1</mn></mrow><mi>S</mi></munderover></mstyle><msub><mo lspace="0em">∂</mo><msub><mi>f</mi><msup><mi>θ</mi><mi>t</mi></msup></msub></msub><mi class="ltx_font_mathcaligraphic">ℒ</mi><mrow><mo stretchy="false">(</mo><msub><mi>f</mi><msup><mi>θ</mi><mi>t</mi></msup></msub><mo>;</mo><mmultiscripts><mi>𝑺</mi><mi>i</mi><mrow></mrow><mrow><mo stretchy="false">(</mo><mi>j</mi><mo>,</mo><mo rspace="0em">:</mo><mo stretchy="false">)</mo></mrow><mrow></mrow></mmultiscripts><mo stretchy="false">)</mo></mrow><mo>)</mo></mrow><mn>2</mn></msup><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\frac{\gamma}{NS}\left(\sum_{i=1}^{N}\sum_{j=1}^{S}\partial_{f_{\theta^{t}}}\mathcal{L}(f_{\theta^{t}};{\bm{S}_{i}}_{(j,:)})\right)^{2}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A2.SS2.p2.5" class="ltx_p">Moreover, the last term in Equation <a href="#A2.Ex72" title="B.2 Proof of Proposition ‣ Appendix B Detailed Proofs ‣ Nonparametric Teaching of Attention Learners" class="ltx_ref"><span class="ltx_text ltx_ref_tag">B.2</span></a> is also bounded above:</p>
<table id="A2.EGx46" class="ltx_equationgroup ltx_eqn_eqnarray ltx_eqn_table">

<tbody id="A2.E71"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex76.m2" class="ltx_Math" alttext="\displaystyle{\eta}^{2}\tau^{2}\cdot\left[\partial_{f_{\theta^{t}}}\mathcal{L}(f_{\theta^{t}};\bm{S}_{i})\right]_{N}^{\top}\frac{\left\langle\left[K_{\bm{S}_{i}}\right]_{N},[K_{\bm{S}_{i}}]^{\top}_{N}\right\rangle_{\mathcal{H}}}{NS}\cdot\bar{\bm{K}}\cdot\frac{\left\langle\left[K_{\bm{S}_{i}}\right]_{N},[K_{\bm{S}_{i}}]^{\top}_{N}\right\rangle_{\mathcal{H}}}{NS}\cdot\left[\partial_{f_{\theta^{t}}}\mathcal{L}(f_{\theta^{t}};\bm{S}_{i})\right]_{N}" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mrow><msup><mi>η</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>τ</mi><mn>2</mn></msup></mrow><mo lspace="0.222em" rspace="0.222em">⋅</mo><msubsup><mrow><mo>[</mo><mrow><msub><mo lspace="0em">∂</mo><msub><mi>f</mi><msup><mi>θ</mi><mi>t</mi></msup></msub></msub><mrow><mi class="ltx_font_mathcaligraphic">ℒ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>f</mi><msup><mi>θ</mi><mi>t</mi></msup></msub><mo>,</mo><msub><mi>𝑺</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>]</mo></mrow><mi>N</mi><mo>⊤</mo></msubsup></mrow><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><msub><mrow><mo>⟨</mo><mrow><msub><mrow><mo>[</mo><msub><mi>K</mi><msub><mi>𝑺</mi><mi>i</mi></msub></msub><mo>]</mo></mrow><mi>N</mi></msub><mo>,</mo><msubsup><mrow><mo stretchy="false">[</mo><msub><mi>K</mi><msub><mi>𝑺</mi><mi>i</mi></msub></msub><mo stretchy="false">]</mo></mrow><mi>N</mi><mo>⊤</mo></msubsup></mrow><mo>⟩</mo></mrow><mi class="ltx_font_mathcaligraphic">ℋ</mi></msub><mrow><mi>N</mi><mo lspace="0em" rspace="0em">​</mo><mi>S</mi></mrow></mfrac></mstyle></mrow><mo lspace="0.222em" rspace="0.222em">⋅</mo><mover accent="true"><mi>𝑲</mi><mo>¯</mo></mover><mo lspace="0.222em" rspace="0.222em">⋅</mo><mstyle displaystyle="true"><mfrac><msub><mrow><mo>⟨</mo><mrow><msub><mrow><mo>[</mo><msub><mi>K</mi><msub><mi>𝑺</mi><mi>i</mi></msub></msub><mo>]</mo></mrow><mi>N</mi></msub><mo>,</mo><msubsup><mrow><mo stretchy="false">[</mo><msub><mi>K</mi><msub><mi>𝑺</mi><mi>i</mi></msub></msub><mo stretchy="false">]</mo></mrow><mi>N</mi><mo>⊤</mo></msubsup></mrow><mo>⟩</mo></mrow><mi class="ltx_font_mathcaligraphic">ℋ</mi></msub><mrow><mi>N</mi><mo lspace="0em" rspace="0em">​</mo><mi>S</mi></mrow></mfrac></mstyle><mo lspace="0.222em" rspace="0.222em">⋅</mo><msub><mrow><mo>[</mo><mrow><msub><mo lspace="0em">∂</mo><msub><mi>f</mi><msup><mi>θ</mi><mi>t</mi></msup></msub></msub><mrow><mi class="ltx_font_mathcaligraphic">ℒ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>f</mi><msup><mi>θ</mi><mi>t</mi></msup></msub><mo>,</mo><msub><mi>𝑺</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>]</mo></mrow><mi>N</mi></msub></mrow><annotation encoding="application/x-tex">\displaystyle{\eta}^{2}\tau^{2}\cdot\left[\partial_{f_{\theta^{t}}}\mathcal{L}(f_{\theta^{t}};\bm{S}_{i})\right]_{N}^{\top}\frac{\left\langle\left[K_{\bm{S}_{i}}\right]_{N},[K_{\bm{S}_{i}}]^{\top}_{N}\right\rangle_{\mathcal{H}}}{NS}\cdot\bar{\bm{K}}\cdot\frac{\left\langle\left[K_{\bm{S}_{i}}\right]_{N},[K_{\bm{S}_{i}}]^{\top}_{N}\right\rangle_{\mathcal{H}}}{NS}\cdot\left[\partial_{f_{\theta^{t}}}\mathcal{L}(f_{\theta^{t}};\bm{S}_{i})\right]_{N}</annotation></semantics></math></td>
