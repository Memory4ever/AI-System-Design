<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex52.m2" class="ltx_Math" alttext="\displaystyle-\frac{\eta}{NS}\left[\frac{\partial\mathcal{L}(f_{\theta^{t+1}}(\bm{S}_{1}),\bm{y}_{1})}{\partial f_{\theta^{t+1}}(\bm{S}_{1})},\dots,\frac{\partial\mathcal{L}(f_{\theta^{t+1}}(\bm{S}_{N}),\bm{y}_{N})}{\partial f_{\theta^{t+1}}(\bm{S}_{N})}\right]\bar{\bm{K}}\left[\frac{\partial\mathcal{L}(f_{\theta^{t}}(\bm{S}_{1}),\bm{y}_{1})}{\partial f_{\theta^{t}}(\bm{S}_{1})},\dots,\frac{\partial\mathcal{L}(f_{\theta^{t}}(\bm{S}_{N}),\bm{y}_{N})}{\partial f_{\theta^{t}}(\bm{S}_{N})}\right]^{\top}," display="inline" intent=":literal"><semantics><mrow><mrow><mo>−</mo><mrow><mstyle displaystyle="true"><mfrac><mi>η</mi><mrow><mi>N</mi><mo lspace="0em" rspace="0em">​</mo><mi>S</mi></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mo>∂</mo><mrow><mi class="ltx_font_mathcaligraphic">ℒ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>f</mi><msup><mi>θ</mi><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow></msup></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝑺</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><msub><mi>𝒚</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mrow><mo>∂</mo><mrow><msub><mi>f</mi><msup><mi>θ</mi><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow></msup></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝑺</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow></mrow></mrow></mfrac></mstyle><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mstyle displaystyle="true"><mfrac><mrow><mo>∂</mo><mrow><mi class="ltx_font_mathcaligraphic">ℒ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>f</mi><msup><mi>θ</mi><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow></msup></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝑺</mi><mi>N</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><msub><mi>𝒚</mi><mi>N</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mrow><mo>∂</mo><mrow><msub><mi>f</mi><msup><mi>θ</mi><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow></msup></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝑺</mi><mi>N</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow></mfrac></mstyle></mrow><mo>]</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mover accent="true"><mi>𝑲</mi><mo>¯</mo></mover><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo>[</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mo>∂</mo><mrow><mi class="ltx_font_mathcaligraphic">ℒ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>f</mi><msup><mi>θ</mi><mi>t</mi></msup></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝑺</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><msub><mi>𝒚</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mrow><mo>∂</mo><mrow><msub><mi>f</mi><msup><mi>θ</mi><mi>t</mi></msup></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝑺</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow></mrow></mrow></mfrac></mstyle><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mstyle displaystyle="true"><mfrac><mrow><mo>∂</mo><mrow><mi class="ltx_font_mathcaligraphic">ℒ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>f</mi><msup><mi>θ</mi><mi>t</mi></msup></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝑺</mi><mi>N</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><msub><mi>𝒚</mi><mi>N</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mrow><mo>∂</mo><mrow><msub><mi>f</mi><msup><mi>θ</mi><mi>t</mi></msup></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝑺</mi><mi>N</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow></mfrac></mstyle></mrow><mo>]</mo></mrow><mo>⊤</mo></msup></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle-\frac{\eta}{NS}\left[\frac{\partial\mathcal{L}(f_{\theta^{t+1}}(\bm{S}_{1}),\bm{y}_{1})}{\partial f_{\theta^{t+1}}(\bm{S}_{1})},\dots,\frac{\partial\mathcal{L}(f_{\theta^{t+1}}(\bm{S}_{N}),\bm{y}_{N})}{\partial f_{\theta^{t+1}}(\bm{S}_{N})}\right]\bar{\bm{K}}\left[\frac{\partial\mathcal{L}(f_{\theta^{t}}(\bm{S}_{1}),\bm{y}_{1})}{\partial f_{\theta^{t}}(\bm{S}_{1})},\dots,\frac{\partial\mathcal{L}(f_{\theta^{t}}(\bm{S}_{N}),\bm{y}_{N})}{\partial f_{\theta^{t}}(\bm{S}_{N})}\right]^{\top},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A2.SS2.p1.3" class="ltx_p">where <math id="A2.SS2.p1.m5" class="ltx_Math" alttext="\bar{\bm{K}}=\bm{K}/(NS)" display="inline" intent=":literal"><semantics><mrow><mover accent="true"><mi>𝑲</mi><mo>¯</mo></mover><mo>=</mo><mrow><mi>𝑲</mi><mo>/</mo><mrow><mo stretchy="false">(</mo><mrow><mi>N</mi><mo lspace="0em" rspace="0em">​</mo><mi>S</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\bar{\bm{K}}=\bm{K}/(NS)</annotation></semantics></math>, and <math id="A2.SS2.p1.m6" class="ltx_Math" alttext="\bm{K}" display="inline" intent=":literal"><semantics><mi>𝑲</mi><annotation encoding="application/x-tex">\bm{K}</annotation></semantics></math> is an <math id="A2.SS2.p1.m7" class="ltx_Math" alttext="NS\times NS" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mi>N</mi><mo lspace="0em" rspace="0em">​</mo><mi>S</mi></mrow><mo lspace="0.222em" rspace="0.222em">×</mo><mi>N</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mi>S</mi></mrow><annotation encoding="application/x-tex">NS\times NS</annotation></semantics></math> symmetric, positive definite block matrix with elements <math id="A2.SS2.p1.m8" class="ltx_Math" alttext="K(\bm{S}_{i},\bm{S}_{j})" display="inline" intent=":literal"><semantics><mrow><mi>K</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝑺</mi><mi>i</mi></msub><mo>,</mo><msub><mi>𝑺</mi><mi>j</mi></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">K(\bm{S}_{i},\bm{S}_{j})</annotation></semantics></math> positioned in the <math id="A2.SS2.p1.m9" class="ltx_Math" alttext="i" display="inline" intent=":literal"><semantics><mi>i</mi><annotation encoding="application/x-tex">i</annotation></semantics></math>-th row and <math id="A2.SS2.p1.m10" class="ltx_Math" alttext="j" display="inline" intent=":literal"><semantics><mi>j</mi><annotation encoding="application/x-tex">j</annotation></semantics></math>-th column block. For convenience, we use a simplified column vector notation <math id="A2.SS2.p1.m11" class="ltx_Math" alttext="\left[\partial_{f_{\theta^{\square}}}\mathcal{L}(f_{\theta^{\square}};\bm{S}_{i})\right]_{N}\coloneqq\left[\partial_{f_{\theta^{\square}}}\mathcal{L}(f_{\theta^{\square}};\bm{S}_{1}),\dots,\partial_{f_{\theta^{\square}}}\mathcal{L}(f_{\theta^{\square}};\bm{S}_{N})\right]^{\top}" display="inline" intent=":literal"><semantics><mrow><msub><mrow><mo>[</mo><mrow><msub><mo lspace="0em">∂</mo><msub><mi>f</mi><msup><mi>θ</mi><mi mathvariant="normal">□</mi></msup></msub></msub><mrow><mi class="ltx_font_mathcaligraphic">ℒ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>f</mi><msup><mi>θ</mi><mi mathvariant="normal">□</mi></msup></msub><mo>,</mo><msub><mi>𝑺</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>]</mo></mrow><mi>N</mi></msub><mo>≔</mo><msup><mrow><mo>[</mo><mrow><mrow><msub><mo lspace="0em">∂</mo><msub><mi>f</mi><msup><mi>θ</mi><mi mathvariant="normal">□</mi></msup></msub></msub><mrow><mi class="ltx_font_mathcaligraphic">ℒ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>f</mi><msup><mi>θ</mi><mi mathvariant="normal">□</mi></msup></msub><mo>,</mo><msub><mi>𝑺</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>,</mo><mi mathvariant="normal">…</mi><mo rspace="0em">,</mo><mrow><msub><mo>∂</mo><msub><mi>f</mi><msup><mi>θ</mi><mi mathvariant="normal">□</mi></msup></msub></msub><mrow><mi class="ltx_font_mathcaligraphic">ℒ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>f</mi><msup><mi>θ</mi><mi mathvariant="normal">□</mi></msup></msub><mo>,</mo><msub><mi>𝑺</mi><mi>N</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo>]</mo></mrow><mo>⊤</mo></msup></mrow><annotation encoding="application/x-tex">\left[\partial_{f_{\theta^{\square}}}\mathcal{L}(f_{\theta^{\square}};\bm{S}_{i})\right]_{N}\coloneqq\left[\partial_{f_{\theta^{\square}}}\mathcal{L}(f_{\theta^{\square}};\bm{S}_{1}),\dots,\partial_{f_{\theta^{\square}}}\mathcal{L}(f_{\theta^{\square}};\bm{S}_{N})\right]^{\top}</annotation></semantics></math> with <math id="A2.SS2.p1.m12" class="ltx_Math" alttext="\partial_{f_{\theta^{\square}}}\mathcal{L}(f_{\theta^{\square}};\bm{S}_{i})\coloneqq\frac{\partial\mathcal{L}(f_{\theta^{\square}}(\bm{S}_{i}),\bm{y}_{i})}{\partial f_{\theta^{\square}}(\bm{S}_{i})}" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mo>∂</mo><msub><mi>f</mi><msup><mi>θ</mi><mi mathvariant="normal">□</mi></msup></msub></msub><mrow><mi class="ltx_font_mathcaligraphic">ℒ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>f</mi><msup><mi>θ</mi><mi mathvariant="normal">□</mi></msup></msub><mo>,</mo><msub><mi>𝑺</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>≔</mo><mfrac><mrow><mo>∂</mo><mrow><mi class="ltx_font_mathcaligraphic">ℒ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>f</mi><msup><mi>θ</mi><mi mathvariant="normal">□</mi></msup></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝑺</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><msub><mi>𝒚</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mrow><mo>∂</mo><mrow><msub><mi>f</mi><msup><mi>θ</mi><mi mathvariant="normal">□</mi></msup></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝑺</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow></mfrac></mrow><annotation encoding="application/x-tex">\partial_{f_{\theta^{\square}}}\mathcal{L}(f_{\theta^{\square}};\bm{S}_{i})\coloneqq\frac{\partial\mathcal{L}(f_{\theta^{\square}}(\bm{S}_{i}),\bm{y}_{i})}{\partial f_{\theta^{\square}}(\bm{S}_{i})}</annotation></semantics></math>. The last term in Equation <a href="#A2.Ex52" title="B.2 Proof of Proposition ‣ Appendix B Detailed Proofs ‣ Nonparametric Teaching of Attention Learners" class="ltx_ref"><span class="ltx_text ltx_ref_tag">B.2</span></a> can then be rewritten as</p>
