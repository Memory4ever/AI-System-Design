<span id="A1.T4.2.4.2.1" class="ltx_inline-block ltx_align_top" style="width:284.5pt;">
<span id="A1.T4.2.4.2.1.1" class="ltx_p">Short form for <math id="A1.T4.m9" class="ltx_Math" alttext="[x_{j}]_{d}" display="inline" intent=":literal"><semantics><msub><mrow><mo stretchy="false">[</mo><msub><mi>x</mi><mi>j</mi></msub><mo stretchy="false">]</mo></mrow><mi>d</mi></msub><annotation encoding="application/x-tex">[x_{j}]_{d}</annotation></semantics></math></span>
</span></td></tr>
