<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.Ex30.m2" class="ltx_math_unparsed" alttext="\displaystyle\bm{S}_{(j,:)}\cdot\Bigg(\frac{1}{\sqrt{d}}{\bm{W}^{Q}_{(:,i)}}^{\top}\bm{S}^{\top}\mathrm{diag}\Big(\mathrm{softmax}\big(\bm{S}_{(j,:)}\bm{W}^{Q}_{(:,i)}{\bm{W}^{K}_{(:,i)}}^{\top}\bm{S}^{\top}/\sqrt{d}\big)\Big)\bm{S}\bm{W}^{V}" display="inline" intent=":literal"><semantics><mrow><msub><mi>𝑺</mi><mrow><mo stretchy="false">(</mo><mi>j</mi><mo>,</mo><mo rspace="0em">:</mo><mo stretchy="false">)</mo></mrow></msub><mo lspace="0.222em" rspace="0.222em">⋅</mo><mrow><mo maxsize="2.600em" minsize="2.600em">(</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><msqrt><mi>d</mi></msqrt></mfrac></mstyle><mmultiscripts><mi>𝑾</mi><mrow><mo stretchy="false">(</mo><mo rspace="0em">:</mo><mo>,</mo><mi>i</mi><mo stretchy="false">)</mo></mrow><mi>Q</mi><mrow></mrow><mo>⊤</mo></mmultiscripts><msup><mi>𝑺</mi><mo>⊤</mo></msup><mi>diag</mi><mrow><mo maxsize="1.600em" minsize="1.600em">(</mo><mi>softmax</mi><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><msub><mi>𝑺</mi><mrow><mo stretchy="false">(</mo><mi>j</mi><mo>,</mo><mo rspace="0em">:</mo><mo stretchy="false">)</mo></mrow></msub><msubsup><mi>𝑾</mi><mrow><mo stretchy="false">(</mo><mo rspace="0em">:</mo><mo>,</mo><mi>i</mi><mo stretchy="false">)</mo></mrow><mi>Q</mi></msubsup><mmultiscripts><mi>𝑾</mi><mrow><mo stretchy="false">(</mo><mo rspace="0em">:</mo><mo>,</mo><mi>i</mi><mo stretchy="false">)</mo></mrow><mi>K</mi><mrow></mrow><mo>⊤</mo></mmultiscripts><msup><mi>𝑺</mi><mo>⊤</mo></msup><mo>/</mo><msqrt><mi>d</mi></msqrt><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow><mo maxsize="1.600em" minsize="1.600em">)</mo></mrow><mi>𝑺</mi><msup><mi>𝑾</mi><mi>V</mi></msup></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\bm{S}_{(j,:)}\cdot\Bigg(\frac{1}{\sqrt{d}}{\bm{W}^{Q}_{(:,i)}}^{\top}\bm{S}^{\top}\mathrm{diag}\Big(\mathrm{softmax}\big(\bm{S}_{(j,:)}\bm{W}^{Q}_{(:,i)}{\bm{W}^{K}_{(:,i)}}^{\top}\b