<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.E67.m1" class="ltx_Math" alttext="\displaystyle+\frac{\eta}{4NS}\left[\partial_{f_{\theta^{t}}}\mathcal{L}(f_{\theta^{t}};\bm{S}_{i})\right]^{\top}_{N}\bar{\bm{K}}\left[\partial_{f_{\theta^{t}}}\mathcal{L}(f_{\theta^{t}};\bm{S}_{i})\right]_{N}~." display="inline" intent=":literal"><semantics><mrow><mrow><mo>+</mo><mrow><mstyle displaystyle="true"><mfrac><mi>η</mi><mrow><mn>4</mn><mo lspace="0em" rspace="0em">​</mo><mi>N</mi><mo lspace="0em" rspace="0em">​</mo><mi>S</mi></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msubsup><mrow><mo>[</mo><mrow><msub><mo lspace="0em">∂</mo><msub><mi>f</mi><msup><mi>θ</mi><mi>t</mi></msup></msub></msub><mrow><mi class="ltx_font_mathcaligraphic">ℒ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>f</mi><msup><mi>θ</mi><mi>t</mi></msup></msub><mo>,</mo><msub><mi>𝑺</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>]</mo></mrow><mi>N</mi><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mover accent="true"><mi>𝑲</mi><mo>¯</mo></mover><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo>[</mo><mrow><msub><mo lspace="0em">∂</mo><msub><mi>f</mi><msup><mi>θ</mi><mi>t</mi></msup></msub></msub><mrow><mi class="ltx_font_mathcaligraphic">ℒ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>f</mi><msup><mi>θ</mi><mi>t</mi></msup></msub><mo>,</mo><msub><mi>𝑺</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>]</mo></mrow><mi>N</mi></msub></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle+\frac{\eta}{4NS}\left[\partial_{f_{\theta^{t}}}\mathcal{L}(f_{\theta^{t}};\bm{S}_{i})\right]^{\top}_{N}\bar{\bm{K}}\left[\partial_{f_{\theta^{t}}}\mathcal{L}(f_{\theta^{t}};\bm{S}_{i})\right]_{N}~.</annotation></semantics></math></td>
