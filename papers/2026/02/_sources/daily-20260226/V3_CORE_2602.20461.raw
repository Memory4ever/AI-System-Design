<td class="ltx_td ltx_align_center ltx_eqn_cell"><math id="A1.EGx21.m1" class="ltx_Math" alttext="\displaystyle=" display="inline" intent=":literal"><semantics><mo>=</mo><annotation encoding="application/x-tex">\displaystyle=</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.EGx21.m2" class="ltx_math_unparsed" alttext="\displaystyle\left[\begin{array}[]{c}\frac{\partial\,\mathrm{softmax}\left(\frac{\bm{S}_{(1,:)}\bm{W}^{Q}_{(:,i)}{\bm{W}^{K}_{(:,i)}}^{\top}\bm{S}^{\top}}{\sqrt{d}}\right)\bm{S}\bm{W}^{V}}{\partial\bm{W}^{Q}_{(:,i)}}\\
\dots\\
\frac{\partial\,\mathrm{softmax}\left(\frac{\bm{S}_{(S,:)}\bm{W}^{Q}_{(:,i)}{\bm{W}^{K}_{(:,i)}}^{\top}\bm{S}^{\top}}{\sqrt{d}}\right)\bm{S}\bm{W}^{V}}{\partial\bm{W}^{Q}_{(:,i)}}\\
