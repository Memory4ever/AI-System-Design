<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex48.m2" class="ltx_math_unparsed" alttext="\displaystyle-\frac{\eta}{N^{2}S^{2}}\left\langle\left[\frac{\partial\mathcal{L}(f_{\theta^{t+1}}(\bm{S}_{1}),\bm{y}_{1})}{\partial f_{\theta^{t+1}}(\bm{S}_{1})},\dots,\frac{\partial\mathcal{L}(f_{\theta^{t+1}}(\bm{S}_{N}),\bm{y}_{N})}{\partial f_{\theta^{t+1}}(\bm{S}_{N})}\right]\cdot\left[K_{\bm{S}_{i}}\right]_{N},\right." display="inline" intent=":literal"><semantics><mrow><mo>−</mo><mstyle displaystyle="true"><mfrac><mi>η</mi><mrow><msup><mi>N</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>S</mi><mn>2</mn></msup></mrow></mfrac></mstyle><mrow><mo>⟨</mo><mrow><mo>[</mo><mstyle displaystyle="true"><mfrac><mrow><mo>∂</mo><mrow><mi class="ltx_font_mathcaligraphic">ℒ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>f</mi><msup><mi>θ</mi><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow></msup></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝑺</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><msub><mi>𝒚</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mrow><mo>∂</mo><mrow><msub><mi>f</mi><msup><mi>θ</mi><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow></msup></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝑺</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow></mrow></mrow></mfrac></mstyle><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mstyle displaystyle="true"><mfrac><mrow><mo>∂</mo><mrow><mi class="ltx_font_mathcaligraphic">ℒ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>f</mi><msup><mi>θ</mi><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow></msup></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝑺</mi><mi>N</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><msub><mi>𝒚</mi><mi>N</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mrow><mo>∂</mo><mrow><msub><mi>f</mi><msup><mi>θ</mi><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow></msup></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝑺</mi><mi>N</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow></mfrac></mstyle><mo rspace="0.055em">]</mo></mrow><mo rspace="0.222em">⋅</mo><msub><mrow><mo>[</mo><msub><mi>K</mi><msub><mi>𝑺</mi><mi>i</mi></msub></msub><mo>]</mo></mrow><mi>N</mi></msub><mo>,</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle-\frac{\eta}{N^{2}S^{2}}\left\langle\left[\frac{\partial\mathcal{L}(f_{\theta^{t+1}}(\bm{S}_{1}),\bm{y}_{1})}{\partial f_{\theta^{t+1}}(\bm{S}_{1})},\dots,\frac{\partial\mathcal{L}(f_{\theta^{t+1}}(\bm{S}_{N}),\bm{y}_{N})}{\partial f_{\theta^{t+1}}(\bm{S}_{N})}\right]\cdot\left[K_{\bm{S}_{i}}\right]_{N},\right.</annotation></semantics></math></td>
