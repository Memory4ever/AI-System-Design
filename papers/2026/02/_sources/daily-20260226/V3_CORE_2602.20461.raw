<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.Ex39.m2" class="ltx_math_unparsed" alttext="\displaystyle\mathrm{diag}\Bigg(\resizebox{22142298}{}{${\mathcal{Q}_{(:,i)}}^{\top}\mathrm{diag}\Big(\mathrm{softmax}\big(\mathcal{Q}_{(1,i)}{\mathcal{K}_{(:,i)}}^{\top}/\sqrt{d}\big)\Big)\mathcal{V}-{\mathcal{Q}_{(:,i)}}^{\top}\big(\mathrm{softmax}\big(\mathcal{Q}_{(1,i)}{\mathcal{K}_{(:,i)}}^{\top}/\sqrt{d}\big)\big)^{\top}\mathrm{softmax}\big(\mathcal{Q}_{(1,i)}{\mathcal{K}_{(:,i)}}^{\top}/\sqrt{d}\big)\mathcal{V}$}," display="inline" intent=":literal"><semantics><mrow><mi>diag</mi><mrow><mo maxsize="2.600em" minsize="2.600em">(</mo><mpadded style="width:337.9pt;height:12.3pt;vertical-align:-3.1pt;" depth="3.1pt" height="9.2pt" width="337.9pt"><mi class="ltx_font_mathcaligraphic">𝒬</mi><msub><mrow></mrow><mrow><mo stretchy="false">(</mo><mo rspace="0em">:</mo><mo>,</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></msub><msup><mrow></mrow><mo>⊤</mo></msup><mi>diag</mi><mo maxsize="1.600em" minsize="1.600em">(</mo><mi>softmax</mi><mo maxsize="1.200em" minsize="1.200em">(</mo><mi class="ltx_font_mathcaligraphic">𝒬</mi><msub><mrow></mrow><mrow><mo stretchy="false">(</mo><mn>1</mn><mo>,</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></msub><mi class="ltx_font_mathcaligraphic">𝒦</mi><msub><mrow></mrow><mrow><mo stretchy="false">(</mo><mo rspace="0em">:</mo><mo>,</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></msub><msup><mrow></mrow><mo>⊤</mo></msup><mo>/</mo><msqrt><mi>d</mi></msqrt><mo maxsize="1.200em" minsize="1.200em">)</mo><mo maxsize="1.600em" minsize="1.600em">)</mo><mi class="ltx_font_mathcaligraphic">𝒱</mi><mo>−</mo><mi class="ltx_font_mathcaligraphic">𝒬</mi><msub><mrow></mrow><mrow><mo stretchy="false">(</mo><mo rspace="0em">:</mo><mo>,</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></msub><msup><mrow></mrow><mo>⊤</mo></msup><mo maxsize="1.200em" minsize="1.200em">(</mo><mi>softmax</mi><mo maxsize="1.200em" minsize="1.200em">(</mo><mi class="ltx_font_mathcaligraphic">𝒬</mi><msub><mrow></mrow><mrow><mo stretchy="false">(</mo><mn>1</mn><mo>,</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></msub><mi class="ltx_font_mathcaligraphic">𝒦</mi><msub><mrow></mrow><mrow><mo stretchy="false">(</mo><mo rspace="0em">:</mo><mo>,</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></msub><msup><mrow></mrow><mo>⊤</mo></msup><mo>/</mo><msqrt><mi>d</mi></msqrt><mo maxsize="1.200em" minsize="1.200em">)</mo><mo maxsize="1.200em" minsize="1.200em">)</mo><msup><mrow></mrow><mo>⊤</mo></msup><mi>softmax</mi><mo maxsize="1.200em" minsize="1.200em">(</mo><mi class="ltx_font_mathcaligraphic">𝒬</mi><msub><mrow></mrow><mrow><mo stretchy="false">(</mo><mn>1</mn><mo>,</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></msub><mi class="ltx_font_mathcaligraphic">𝒦</mi><msub><mrow></mrow><mrow><mo stretchy="false">(</mo><mo rspace="0em">:</mo><mo>,</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></msub><msup><mrow></mrow><mo>⊤</mo></msup><mo>/</mo><msqrt><mi>d</mi></msqrt><mo maxsize="1.200em" minsize="1.200em">)</mo><mi class="ltx_font_mathcaligraphic">𝒱</mi></mpadded><mo>,</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\mathrm{diag}\Bigg(\resizebox{22142298}{}{${\mathcal{Q}_{(:,i)}}^{\top}\mathrm{diag}\Big(\mathrm{softmax}\big(\mathcal{Q}_{(1,i)}{\mathcal{K}_{(:,i)}}^{\top}/\sqrt{d}\big)\Big)\mathcal{V}-{\mathcal{Q}_{(:,i)}}^{\top}\big(\mathrm{softmax}\big(\mathcal{Q}_{(1,i)}{\mathcal{K}_{(:,i)}}^{\top}/\sqrt{d}\big)\big)^{\top}\mathrm{softmax}\big(\mathcal{Q}_{(1,i)}{\mathcal{K}_{(:,i)}}^{\top}/\sqrt{d}\big)\mathcal{V}$},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr>
<tr class="ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.Ex40.m1" class="ltx_math_unparsed" alttext="\displaystyle\qquad\dots,\resizebox{22142298}{}{${\mathcal{Q}_{(:,i)}}^{\top}\mathrm{diag}\Big(\mathrm{softmax}\big(\mathcal{Q}_{(S,i)}{\mathcal{K}_{(:,i)}}^{\top}/\sqrt{d}\big)\Big)\mathcal{V}-{\mathcal{Q}_{(:,i)}}^{\top}\big(\mathrm{softmax}\big(\mathcal{Q}_{(S,i)}{\mathcal{K}_{(:,i)}}^{\top}/\sqrt{d}\big)\big)^{\top}\mathrm{softmax}\big(\mathcal{Q}_{(S,i)}{\mathcal{K}_{(:,i)}}^{\top}/\sqrt{d}\big)\mathcal{V}$}\Bigg)\bm{S}/\sqrt{d}~." display="inline" intent=":literal"><semantics><mrow><mi mathvariant="normal">…</mi><mo>,</mo><mpadded style="width:337.9pt;height:12.1pt;vertical-align:-3.0pt;" depth="3.0pt" height="9.1pt" width="337.9pt"><mi class="ltx_font_mathcaligraphic">𝒬</mi><msub><mrow></mrow><mrow><mo stretchy="false">(</mo><mo rspace="0em">:</mo><mo>,</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></msub><msup><mrow></mrow><mo>⊤</mo></msup><mi>diag</mi><mo maxsize="1.600em" minsize="1.600em">(</mo><mi>softmax</mi><mo maxsize="1.200em" minsize="1.200em">(</mo><mi class="ltx_font_mathcaligraphic">𝒬</mi><msub><mrow></mrow><mrow><mo stretchy="false">(</mo><mi>S</mi><mo>,</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></msub><mi class="ltx_font_mathcaligraphic">𝒦</mi><msub><mrow></mrow><mrow><mo stretchy="false">(</mo><mo rspace="0em">:</mo><mo>,</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></msub><msup><mrow></mrow><mo>⊤</mo></msup><mo>/</mo><msqrt><mi>d</mi></msqrt><mo maxsize="1.200em" minsize="1.200em">)</mo><mo maxsize="1.600em" minsize="1.600em">)</mo><mi class="ltx_font_mathcaligraphic">𝒱</mi><mo>−</mo><mi class="ltx_font_mathcaligraphic">𝒬</mi><msub><mrow></mrow><mrow><mo stretchy="false">(</mo><mo rspace="0em">:</mo><mo>,</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></msub><msup><mrow></mrow><mo>⊤</mo></msup><mo maxsize="1.200em" minsize="1.200em">(</mo><mi>softmax</mi><mo maxsize="1.200em" minsize="1.200em">(</mo><mi class="ltx_font_mathcaligraphic">𝒬</mi><msub><mrow></mrow><mrow><mo stretchy="false">(</mo><mi>S</mi><mo>,</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></msub><mi class="ltx_font_mathcaligraphic">𝒦</mi><msub><mrow></mrow><mrow><mo stretchy="false">(</mo><mo rspace="0em">:</mo><mo>,</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></msub><msup><mrow></mrow><mo>⊤</mo></msup><mo>/</mo><msqrt><mi>d</mi></msqrt><mo maxsize="1.200em" minsize="1.200em">)</mo><mo maxsize="1.200em" minsize="1.200em">)</mo><msup><mrow></mrow><mo>⊤</mo></msup><mi>softmax</mi><mo maxsize="1.200em" minsize="1.200em">(</mo><mi class="ltx_font_mathcaligraphic">𝒬</mi><msub><mrow></mrow><mrow><mo stretchy="false">(</mo><mi>S</mi><mo>,</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></msub><mi class="ltx_font_mathcaligraphic">𝒦</mi><msub><mrow></mrow><mrow><mo stretchy="false">(</mo><mo rspace="0em">:</mo><mo>,</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></msub><msup><mrow></mrow><mo>⊤</mo></msup><mo>/</mo><msqrt><mi>d</mi></msqrt><mo maxsize="1.200em" minsize="1.200em">)</mo><mi class="ltx_font_mathcaligraphic">𝒱</mi></mpadded><mo maxsize="2.600em" minsize="2.600em">)</mo><mi>𝑺</mi><mo>/</mo><msqrt><mi>d</mi></msqrt><mo lspace="0.330em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\qquad\dots,\resizebox{22142298}{}{${\mathcal{Q}_{(:,i)}}^{\top}\mathrm{diag}\Big(\mathrm{softmax}\big(\mathcal{Q}_{(S,i)}{\mathcal{K}_{(:,i)}}^{\top}/\sqrt{d}\big)\Big)\mathcal{V}-{\mathcal{Q}_{(:,i)}}^{\top}\big(\mathrm{softmax}\big(\mathcal{Q}_{(S,i)}{\mathcal{K}_{(:,i)}}^{\top}/\sqrt{d}\big)\big)^{\top}\mathrm{softmax}\big(\mathcal{Q}_{(S,i)}{\mathcal{K}_{(:,i)}}^{\top}/\sqrt{d}\big)\mathcal{V}$}\Bigg)\bm{S}/\sqrt{d}~.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="A1.SS3.p6" class="ltx_para ltx_noindent">
<p id="A1.SS3.p6.1" class="ltx_p">From Equations <a href="#A1.E25" title="In A.3 The Derivation of Importance-adaptive Updates in the Parameter Space. ‣ Appendix A Additional Discussions ‣ Nonparametric Teaching of Attention Learners" class="ltx_ref"><span class="ltx_text ltx_ref_tag">25</span></a>, <a href="#A1.Ex22" title="A.3 The Derivation of Importance-adaptive Updates in the Parameter Space. ‣ Appendix A Additional Discussions ‣ Nonparametric Teaching of Attention Learners" class="ltx_ref"><span class="ltx_text ltx_ref_tag">A.3</span></a>, and <a href="#A1.Ex40" title="A.3 The Derivation of Importance-adaptive Updates in the Parameter Space. ‣ Appendix A Additional Discussions ‣ Nonparametric Teaching of Attention Learners" class="ltx_ref"><span class="ltx_text ltx_ref_tag">A.3</span></a>, it can be observed that the ANN gradient for a single sequence resembles that for a batch of feature vector inputs, as the gradient can be decomposed for each element. This demonstrates the parallelization-friendly nature of the attention mechanism from a gradient perspective.</p>
</div>
<div id="A1.SS3.p7" class="ltx_para ltx_noindent">
<p id="A1.SS3.p7.1" class="ltx_p">These results can be directly extended to the case where each component of the output <math id="A1.SS3.p7.m1" class="ltx_math_unparsed" alttext="{f_{\theta^{t}}(\bm{S})}_{(j,:)}" display="inline" intent=":literal"><semantics><mrow><msub><mi>f</mi><msup><mi>θ</mi><mi>t</mi></msup></msub><msub><mrow><mo stretchy="false">(</mo><mi>𝑺</mi><mo stretchy="false">)</mo></mrow><mrow><mo stretchy="false">(</mo><mi>j</mi><mo>,</mo><mo rspace="0em">:</mo><mo stretchy="false">)</mo></mrow></msub></mrow><annotation encoding="application/x-tex">{f_{\theta^{t}}(\bm{S})}_{(j,:)}</annotation></semantics></math> is a vector, by considering a multi-dimensional setting <cite class="ltx_cite ltx_citemacro_citep">(<a href="#bib.bib2" title="" class="ltx_ref">Zhang et al., 2023b</a>)</cite>. The extension to multi-head cases can be done by broadcasting, which involves repeating the derivation in parallel as many times as there are heads.</p>
</div>
</section>
<section id="A1.SS4" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">A.4 </span>Attention Neural Tangent Kernel (ANTK)</h3>

<div id="A1.SS4.p1" class="ltx_para ltx_noindent">
<p id="A1.SS4.p1.1" class="ltx_p">By incorporating the parameter evolution (<em id="A1.SS4.p1.1.1" class="ltx_emph ltx_font_italic">i.e.</em>, Equation <a href="#S4.E7" title="In 4.1 Importance-adaptive Update in the Parameter Space ‣ 4 AtteNT ‣ Nonparametric Teaching of Attention Learners" class="ltx_ref"><span class="ltx_text ltx_ref_tag">7</span></a>)</p>
<table id="A1.EGx29" class="ltx_equationgroup ltx_eqn_eqnarray ltx_eqn_table">

<tbody id="A1.E56"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A1.E56.m1" class="ltx_math_unparsed" alttext="\displaystyle\frac{\partial\theta^{t}}{\partial t}=-\frac{\eta}{NS}\left[\frac{\partial\mathcal{L}(f_{\theta^{t}}(\bm{S}_{1}),\bm{y}_{1})}{\partial f_{\theta^{t}}(\bm{S}_{1})},\dots,\frac{\partial\mathcal{L}(f_{\theta^{t}}(\bm{S}_{N}),\bm{y}_{N})}{\partial f_{\theta^{t}}(\bm{S}_{N})}\right]\cdot\left[\frac{\partial f_{\theta^{t}}(\bm{S}_{i})}{\partial\theta^{t}}\right]_{N}." display="inline" intent=":literal"><semantics><mrow><mstyle displaystyle="true"><mfrac><mrow><mo>∂</mo><msup><mi>θ</mi><mi>t</mi></msup></mrow><mrow><mo>∂</mo><mi>t</mi></mrow></mfrac></mstyle><mo rspace="0em">=</mo><mo lspace="0em">−</mo><mstyle displaystyle="true"><mfrac><mi>η</mi><mrow><mi>N</mi><mo lspace="0em" rspace="0em">​</mo><mi>S</mi></mrow></mfrac></mstyle><mrow><mo>[</mo><mstyle displaystyle="true"><mfrac><mrow><mo>∂</mo><mrow><mi class="ltx_font_mathcaligraphic">ℒ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>f</mi><msup><mi>θ</mi><mi>t</mi></msup></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝑺</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><msub><mi>𝒚</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mrow><mo>∂</mo><mrow><msub><mi>f</mi><msup><mi>θ</mi><mi>t</mi></msup></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝑺</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow></mrow></mrow></mfrac></mstyle><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mstyle displaystyle="true"><mfrac><mrow><mo>∂</mo><mrow><mi class="ltx_font_mathcaligraphic">ℒ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>f</mi><msup><mi>θ</mi><mi>t</mi></msup></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝑺</mi><mi>N</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><msub><mi>𝒚</mi><mi>N</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mrow><mo>∂</mo><mrow><msub><mi>f</mi><msup><mi>θ</mi><mi>t</mi></msup></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝑺</mi><mi>N</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow></mfrac></mstyle><mo rspace="0.055em">]</mo></mrow><mo rspace="0.222em">⋅</mo><msub><mrow><mo>[</mo><mstyle displaystyle="true"><mfrac><mrow><mo>∂</mo><mrow><msub><mi>f</mi><msup><mi>θ</mi><mi>t</mi></msup></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝑺</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mrow><mo>∂</mo><msup><mi>θ</mi><mi>t</mi></msup></mrow></mfrac></mstyle><mo>]</mo></mrow><mi>N</mi></msub><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\frac{\partial\theta^{t}}{\partial t}=-\frac{\eta}{NS}\left[\frac{\partial\mathcal{L}(f_{\theta^{t}}(\bm{S}_{1}),\bm{y}_{1})}{\partial f_{\theta^{t}}(\bm{S}_{1})},\dots,\frac{\partial\mathcal{L}(f_{\theta^{t}}(\bm{S}_{N}),\bm{y}_{N})}{\partial f_{\theta^{t}}(\bm{S}_{N})}\right]\cdot\left[\frac{\partial f_{\theta^{t}}(\bm{S}_{i})}{\partial\theta^{t}}\right]_{N}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(56)</span></td></tr></tbody>
</table>
<p id="A1.SS4.p1.2" class="ltx_p">into the first-order approximation term <math id="A1.SS4.p1.m1" class="ltx_Math" alttext="(*)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">∗</mo><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(*)</annotation></semantics></math> of Equation <a href="#S4.E14" title="In 4.2 The Functional Evolution of ANN ‣ 4 AtteNT ‣ Nonparametric Teaching of Attention Learners" class="ltx_ref"><span class="ltx_text ltx_ref_tag">14</span></a>, we derive</p>
<table id="A1.EGx30" class="ltx_equationgroup ltx_eqn_eqnarray ltx_eqn_table">

<tbody id="A1.E57"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A1.Ex41.m1" class="ltx_Math" alttext="\displaystyle(*)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">∗</mo><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">\displaystyle(*)</annotation></semantics></math></td>
<td class="ltx_td ltx_align_center ltx_eqn_cell"><math id="A1.Ex41.m2" class="ltx_Math" alttext="\displaystyle=" display="inline" intent=":literal"><semantics><mo>=</mo><annotation encoding="application/x-tex">\displaystyle=</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.Ex41.m3" class="ltx_math_unparsed" alttext="\displaystyle\left\langle\frac{\partial f_{\theta^{t}}(\cdot)}{\partial\theta^{t}},-\frac{\eta}{NS}\left[\frac{\partial\mathcal{L}(f_{\theta^{t}}(\bm{S}_{1}),\bm{y}_{1})}{\partial f_{\theta^{t}}(\bm{S}_{1})},\dots,\frac{\partial\mathcal{L}(f_{\theta^{t}}(\bm{S}_{N}),\bm{y}_{N})}{\partial f_{\theta^{t}}(\bm{S}_{N})}\right]\cdot\left[\frac{\partial f_{\theta^{t}}(\bm{S}_{i})}{\partial\theta^{t}}\right]_{N}\right\rangle" display="inline" intent=":literal"><semantics><mrow><mo>⟨</mo><mstyle displaystyle="true"><mfrac><mrow><mo>∂</mo><mrow><msub><mi>f</mi><msup><mi>θ</mi><mi>t</mi></msup></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo stretchy="false">)</mo></mrow></mrow></mrow><mrow><mo>∂</mo><msup><mi>θ</mi><mi>t</mi></msup></mrow></mfrac></mstyle><mo rspace="0em">,</mo><mo lspace="0em">−</mo><mstyle displaystyle="true"><mfrac><mi>η</mi><mrow><mi>N</mi><mo lspace="0em" rspace="0em">​</mo><mi>S</mi></mrow></mfrac></mstyle><mrow><mo>[</mo><mstyle displaystyle="true"><mfrac><mrow><mo>∂</mo><mrow><mi class="ltx_font_mathcaligraphic">ℒ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>f</mi><msup><mi>θ</mi><mi>t</mi></msup></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝑺</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><msub><mi>𝒚</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mrow><mo>∂</mo><mrow><msub><mi>f</mi><msup><mi>θ</mi><mi>t</mi></msup></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝑺</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow></mrow></mrow></mfrac></mstyle><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mstyle displaystyle="true"><mfrac><mrow><mo>∂</mo><mrow><mi class="ltx_font_mathcaligraphic">ℒ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>f</mi><msup><mi>θ</mi><mi>t</mi></msup></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝑺</mi><mi>N</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><msub><mi>𝒚</mi><mi>N</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mrow><mo>∂</mo><mrow><msub><mi>f</mi><msup><mi>θ</mi><mi>t</mi></msup></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝑺</mi><mi>N</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow></mfrac></mstyle><mo rspace="0.055em">]</mo></mrow><mo rspace="0.222em">⋅</mo><msub><mrow><mo>[</mo><mstyle displaystyle="true"><mfrac><mrow><mo>∂</mo><mrow><msub><mi>f</mi><msup><mi>θ</mi><mi>t</mi></msup></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝑺</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mrow><mo>∂</mo><msup><mi>θ</mi><mi>t</mi></msup></mrow></mfrac></mstyle><mo>]</mo></mrow><mi>N</mi></msub><mo>⟩</mo></mrow><annotation encoding="application/x-tex">\displaystyle\left\langle\frac{\partial f_{\theta^{t}}(\cdot)}{\partial\theta^{t}},-\frac{\eta}{NS}\left[\frac{\partial\mathcal{L}(f_{\theta^{t}}(\bm{S}_{1}),\bm{y}_{1})}{\partial f_{\theta^{t}}(\bm{S}_{1})},\dots,\frac{\partial\mathcal{L}(f_{\theta^{t}}(\bm{S}_{N}),\bm{y}_{N})}{\partial f_{\theta^{t}}(\bm{S}_{N})}\right]\cdot\left[\frac{\partial f_{\theta^{t}}(\bm{S}_{i})}{\partial\theta^{t}}\right]_{N}\right\rangle</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="4" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(57)</span></td></tr>
<tr class="ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_center ltx_eqn_cell"><math id="A1.Ex42.m1" class="ltx_Math" alttext="\displaystyle=" display="inline" intent=":literal"><semantics><mo>=</mo><annotation encoding="application/x-tex">\displaystyle=</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.Ex42.m2" class="ltx_math_unparsed" alttext="\displaystyle-\frac{\eta}{NS}\left[\frac{\partial\mathcal{L}(f_{\theta^{t}}(\bm{S}_{1}),\bm{y}_{1})}{\partial f_{\theta^{t}}(\bm{S}_{1})},\dots,\frac{\partial\mathcal{L}(f_{\theta^{t}}(\bm{S}_{N}),\bm{y}_{N})}{\partial f_{\theta^{t}}(\bm{S}_{N})}\right]\cdot\left\langle\frac{\partial f_{\theta^{t}}(\cdot)}{\partial\theta^{t}},\left[\frac{\partial f_{\theta^{t}}(\bm{S}_{i})}{\partial\theta^{t}}\right]_{N}\right\rangle" display="inline" intent=":literal"><semantics><mrow><mo>−</mo><mstyle displaystyle="true"><mfrac><mi>η</mi><mrow><mi>N</mi><mo lspace="0em" rspace="0em">​</mo><mi>S</mi></mrow></mfrac></mstyle><mrow><mo>[</mo><mstyle displaystyle="true"><mfrac><mrow><mo>∂</mo><mrow><mi class="ltx_font_mathcaligraphic">ℒ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>f</mi><msup><mi>θ</mi><mi>t</mi></msup></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝑺</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><msub><mi>𝒚</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mrow><mo>∂</mo><mrow><msub><mi>f</mi><msup><mi>θ</mi><mi>t</mi></msup></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝑺</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow></mrow></mrow></mfrac></mstyle><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mstyle displaystyle="true"><mfrac><mrow><mo>∂</mo><mrow><mi class="ltx_font_mathcaligraphic">ℒ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>f</mi><msup><mi>θ</mi><mi>t</mi></msup></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝑺</mi><mi>N</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><msub><mi>𝒚</mi><mi>N</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mrow><mo>∂</mo><mrow><msub><mi>f</mi><msup><mi>θ</mi><mi>t</mi></msup></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝑺</mi><mi>N</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow></mfrac></mstyle><mo rspace="0.055em">]</mo></mrow><mo rspace="0.222em">⋅</mo><mrow><mo>⟨</mo><mstyle displaystyle="true"><mfrac><mrow><mo>∂</mo><mrow><msub><mi>f</mi><msup><mi>θ</mi><mi>t</mi></msup></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo stretchy="false">)</mo></mrow></mrow></mrow><mrow><mo>∂</mo><msup><mi>θ</mi><mi>t</mi></msup></mrow></mfrac></mstyle><mo>,</mo><msub><mrow><mo>[</mo><mstyle displaystyle="true"><mfrac><mrow><mo>∂</mo><mrow><msub><mi>f</mi><msup><mi>θ</mi><mi>t</mi></msup></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝑺</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mrow><mo>∂</mo><msup><mi>θ</mi><mi>t</mi></msup></mrow></mfrac></mstyle><mo>]</mo></mrow><mi>N</mi></msub><mo>⟩</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle-\frac{\eta}{NS}\left[\frac{\partial\mathcal{L}(f_{\theta^{t}}(\bm{S}_{1}),\bm{y}_{1})}{\partial f_{\theta^{t}}(\bm{S}_{1})},\dots,\frac{\partial\mathcal{L}(f_{\theta^{t}}(\bm{S}_{N}),\bm{y}_{N})}{\partial f_{\theta^{t}}(\bm{S}_{N})}\right]\cdot\left\langle\frac{\partial f_{\theta^{t}}(\cdot)}{\partial\theta^{t}},\left[\frac{\partial f_{\theta^{t}}(\bm{S}_{i})}{\partial\theta^{t}}\right]_{N}\right\rangle</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr>
