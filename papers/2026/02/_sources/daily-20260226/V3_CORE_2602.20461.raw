<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.Ex8.m2" class="ltx_Math" alttext="\displaystyle\frac{\partial\,\mathrm{softmax}\left(\frac{\bm{S}\bm{W}^{Q}\bm{e}_{i}\bm{e}_{i}^{\top}{\bm{W}^{K}}^{\top}\bm{S}^{\top}}{\sqrt{d}}\right)\bm{S}\bm{W}^{V}}{\partial\bm{W}^{Q}_{(:,i)}}" display="inline" intent=":literal"><semantics><mstyle displaystyle="true"><mfrac><mrow><mo rspace="0.170em">∂</mo><mrow><mrow><mi>softmax</mi><mo>⁡</mo><mrow><mo>(</mo><mfrac><mrow><mi>𝑺</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝑾</mi><mi>Q</mi></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝒆</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝒆</mi><mi>i</mi><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mmultiscripts><mi>𝑾</mi><mrow></mrow><mi>K</mi><mrow></mrow><mo>⊤</mo></mmultiscripts><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝑺</mi><mo>⊤</mo></msup></mrow><msqrt><mi>d</mi></msqrt></mfrac><mo>)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><mi>𝑺</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝑾</mi><mi>V</mi></msup></mrow></mrow><mrow><mo>∂</mo><mi>𝑾</mi><msup><mrow></mrow><mi>Q</mi></msup><msub><mrow></mrow><mrow><mo stretchy="false">(</mo><mo rspace="0em">:</mo><mo>,</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></msub></mrow></mfrac></mstyle><annotation encoding="application/x-tex">\displaystyle\frac{\partial\,\mathrm{softmax}\left(\frac{\bm{S}\bm{W}^{Q}\bm{e}_{i}\bm{e}_{i}^{\top}{\bm{W}^{K}}^{\top}\bm{S}^{\top}}{\sqrt{d}}\right)\bm{S}\bm{W}^{V}}{\partial\bm{W}^{Q}_{(:,i)}}</annotation></semantics></math></td>
