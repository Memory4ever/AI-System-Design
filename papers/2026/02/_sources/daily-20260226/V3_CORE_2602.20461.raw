<span id="A1.T4.2.15.1.1.1" class="ltx_p"><math id="A1.T4.m36" class="ltx_Math" alttext="K(\bm{S},\bm{S}^{\prime})" display="inline" intent=":literal"><semantics><mrow><mi>K</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝑺</mi><mo>,</mo><msup><mi>𝑺</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">K(\bm{S},\bm{S}^{\prime})</annotation></semantics></math></span>
</span></td>
