ion/x-tex">\displaystyle\qquad\qquad\cdot\left[\frac{\partial\mathcal{L}(f_{\theta^{t}}(\bm{S}_{1}),\bm{y}_{1})}{\partial f_{\theta^{t}}(\bm{S}_{1})},\dots,\frac{\partial\mathcal{L}(f_{\theta^{t}}(\bm{S}_{N}),\bm{y}_{N})}{\partial f_{\theta^{t}}(\bm{S}_{N})}\right]^{\top}</annotation></semantics></math></td>
