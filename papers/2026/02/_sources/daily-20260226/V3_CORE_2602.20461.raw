b><mo stretchy="false">)</mo></mrow></mrow></mrow><mo rspace="0.055em">−</mo><mrow><msub><mo>∂</mo><msub><mi>f</mi><msup><mi>θ</mi><mi>t</mi></msup></msub></msub><mrow><mi class="ltx_font_mathcaligraphic">ℒ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>f</mi><msup><mi>θ</mi><mi>t</mi></msup></msub><mo>,</mo><msub><mi>𝑺</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo>]</mo></mrow><mi>N</mi></msub></mrow><annotation encoding="application/x-tex">\displaystyle\frac{\eta}{NS}\left[\partial_{f_{\theta^{t+1}}}\mathcal{L}(f_{\theta^{t+1}};\bm{S}_{i})-\partial_{f_{\theta^{t}}}\mathcal{L}(f_{\theta^{t}};\bm{S}_{i})\right]_{N}^{\top}\bar{\bm{K}}\left[\partial_{f_{\theta^{t+1}}}\mathcal{L}(f_{\theta^{t+1}};\bm{S}_{i})-\partial_{f_{\theta^{t}}}\mathcal{L}(f_{\theta^{t}};\bm{S}_{i})\right]_{N}</annotation></semantics></math></td>
