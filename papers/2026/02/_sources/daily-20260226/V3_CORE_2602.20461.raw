<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A2.Ex65.m1" class="ltx_Math" alttext="\frac{\eta}{NS}\left(\left[\partial_{f_{\theta^{t+1}}}\mathcal{L}(f_{\theta^{t+1}};\bm{S}_{i})\right]_{N}-\frac{1}{2}\left[\partial_{f_{\theta^{t}}}\mathcal{L}(f_{\theta^{t}};\bm{S}_{i})\right]_{N}\right)^{\top}\bar{\bm{K}}\left(\left[\partial_{f_{\theta^{t+1}}}\mathcal{L}(f_{\theta^{t+1}};\bm{S}_{i})\right]_{N}-\frac{1}{2}\left[\partial_{f_{\theta^{t}}}\mathcal{L}(f_{\theta^{t}};\bm{S}_{i})\right]_{N}\right)" display="block" intent=":literal"><semantics><mrow><mfrac><mi>η</mi><mrow><mi>N</mi><mo lspace="0em" rspace="0em">​</mo><mi>S</mi></mrow></mfrac><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo>(</mo><mrow><msub><mrow><mo>[</mo><mrow><msub><mo lspace="0em">∂</mo><msub><mi>f</mi><msup><mi>θ</mi><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow></msup></msub></msub><mrow><mi class="ltx_font_mathcaligraphic">ℒ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>f</mi><msup><mi>θ</mi><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow></msup></msub><mo>,</mo><msub><mi>𝑺</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>]</mo></mrow><mi>N</mi></msub><mo>−</mo><mrow><mfrac><mn>1</mn><mn>2</mn></mfrac><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo>[</mo><mrow><msub><mo lspace="0em">∂</mo><msub><mi>f</mi><msup><mi>θ</mi><mi>t</mi></msup></msub></msub><mrow><mi class="ltx_font_mathcaligraphic">ℒ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>f</mi><msup><mi>θ</mi><mi>t</mi></msup></msub><mo>,</mo><msub><mi>𝑺</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>]</mo></mrow><mi>N</mi></msub></mrow></mrow><mo>)</mo></mrow><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mover accent="true"><mi>𝑲</mi><mo>¯</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><msub><mrow><mo>[</mo><mrow><msub><mo lspace="0em">∂</mo><msub><mi>f</mi><msup><mi>θ</mi><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow></msup></msub></msub><mrow><mi class="ltx_font_mathcaligraphic">ℒ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>f</mi><msup><mi>θ</mi><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow></msup></msub><mo>,</mo><msub><mi>𝑺</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>]</mo></mrow><mi>N</mi></msub><mo>−</mo><mrow><mfrac><mn>1</mn><mn>2</mn></mfrac><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo>[</mo><mrow><msub><mo lspace="0em">∂</mo><msub><mi>f</mi><msup><mi>θ</mi><mi>t</mi></msup></msub></msub><mrow><mi class="ltx_font_mathcaligraphic">ℒ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>f</mi><msup><mi>θ</mi><mi>t</mi></msup></msub><mo>,</mo><msub><mi>𝑺</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>]</mo></mrow><mi>N</mi></msub></mrow></mrow><mo>)</mo></mrow></mrow><annotation encoding="application/x-tex">\frac{\eta}{NS}\left(\left[\partial_{f_{\theta^{t+1}}}\mathcal{L}(f_{\theta^{t+1}};\bm{S}_{i})\right]_{N}-\frac{1}{2}\left[\partial_{f_{\theta^{t}}}\mathcal{L}(f_{\theta^{t}};\bm{S}_{i})\right]_{N}\right)^{\top}\bar{\bm{K}}\left(\left[\partial_{f_{\theta^{t+1}}}\mathcal{L}(f_{\theta^{t+1}};\bm{S}_{i})\right]_{N}-\frac{1}{2}\left[\partial_{f_{\theta^{t}}}\mathcal{L}(f_{\theta^{t}};\bm{S}_{i})\right]_{N}\right)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A2.SS2.p1.6" class="ltx_p">is a non-negative term. Therefore, by merging Equations <a href="#A2.Ex52" title="B.2 Proof of Proposition ‣ Appendix B Detailed Proofs ‣ Nonparametric Teaching of Attention Learners" class="ltx_ref"><span class="ltx_text ltx_ref_tag">B.2</span></a>, <a href="#A2.E66" title="In B.2 Proof of Proposition ‣ Appendix B Detailed Proofs ‣ Nonparametric Teaching of Attention Learners" class="ltx_ref"><span class="ltx_text ltx_ref_tag">66</span></a>, and <a href="#A2.E67" title="In B.2 Proof of Proposition ‣ Appendix B Detailed Proofs ‣ Nonparametric Teaching of Attention Learners" class="ltx_ref"><span class="ltx_text ltx_ref_tag">67</span></a>, we derive</p>
<table id="A2.EGx41" class="ltx_equationgroup ltx_eqn_eqnarray ltx_eqn_table">

<tbody id="A2.Ex67"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
