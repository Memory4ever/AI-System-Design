rspace="0em">:</mo><mo>,</mo><mi>i</mi><mo stretchy="false">)</mo></mrow><mi>K</mi><mrow></mrow><mo>⊤</mo></mmultiscripts><msup><mi>𝑺</mi><mo>⊤</mo></msup><mo>/</mo><msqrt><mi>d</mi></msqrt><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow><mi>𝑺</mi><msup><mi>𝑾</mi><mi>V</mi></msup><mo maxsize="2.600em" minsize="2.600em" rspace="0.052em">)</mo><mo>.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\qquad-\frac{1}{\sqrt{d}}{\bm{W}^{K}_{(:,i)}}^{\top}\bm{S}^{\top}\Big(\mathrm{softmax}\big(\bm{S}_{(j,:)}\bm{W}^{Q}_{(:,i)}{\bm{W}^{K}_{(:,i)}}^{\top}\bm{S}^{\top}/\sqrt{d}\big)\Big)^{\top}\mathrm{softmax}\big(\bm{S}_{(j,:)}\bm{W}^{Q}_{(:,i)}{\bm{W}^{K}_{(:,i)}}^{\top}\bm{S}^{\top}/\sqrt{d}\big)\bm{S}\bm{W}^{V}\Bigg)~.</annotation></semantics></math></td>
