<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_center ltx_eqn_cell"><math id="A1.E57.m1" class="ltx_Math" alttext="\displaystyle=" display="inline" intent=":literal"><semantics><mo>=</mo><annotation encoding="application/x-tex">\displaystyle=</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.E57.m2" class="ltx_math_unparsed" alttext="\displaystyle-\frac{\eta}{NS}\left[\frac{\partial\mathcal{L}(f_{\theta^{t}}(\bm{S}_{1}),\bm{y}_{1})}{\partial f_{\theta^{t}}(\bm{S}_{1})},\dots,\frac{\partial\mathcal{L}(f_{\theta^{t}}(\bm{S}_{N}),\bm{y}_{N})}{\partial f_{\theta^{t}}(\bm{S}_{N})}\right]\cdot\left[K_{\theta^{t}}(\bm{S}_{i},\cdot)\right]_{N}," display="inline" intent=":literal"><semantics><mrow><mo>−</mo><mstyle displaystyle="true"><mfrac><mi>η</mi><mrow><mi>N</mi><mo lspace="0em" rspace="0em">​</mo><mi>S</mi></mrow></mfrac></mstyle><mrow><mo>[</mo><mstyle displaystyle="true"><mfrac><mrow><mo>∂</mo><mrow><mi class="ltx_font_mathcaligraphic">ℒ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>f</mi><msup><mi>θ</mi><mi>t</mi></msup></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝑺</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><msub><mi>𝒚</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mrow><mo>∂</mo><mrow><msub><mi>f</mi><msup><mi>θ</mi><mi>t</mi></msup></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝑺</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow></mrow></mrow></mfrac></mstyle><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mstyle displaystyle="true"><mfrac><mrow><mo>∂</mo><mrow><mi class="ltx_font_mathcaligraphic">ℒ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>f</mi><msup><mi>θ</mi><mi>t</mi></msup></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝑺</mi><mi>N</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><msub><mi>𝒚</mi><mi>N</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mrow><mo>∂</mo><mrow><msub><mi>f</mi><msup><mi>θ</mi><mi>t</mi></msup></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝑺</mi><mi>N</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow></mfrac></mstyle><mo rspace="0.055em">]</mo></mrow><mo rspace="0.222em">⋅</mo><msub><mrow><mo>[</mo><msub><mi>K</mi><msup><mi>θ</mi><mi>t</mi></msup></msub><mrow><mo stretchy="false">(</mo><msub><mi>𝑺</mi><mi>i</mi></msub><mo rspace="0em">,</mo><mo lspace="0em" rspace="0em">⋅</mo><mo stretchy="false">)</mo></mrow><mo>]</mo></mrow><mi>N</mi></msub><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle-\frac{\eta}{NS}\left[\frac{\partial\mathcal{L}(f_{\theta^{t}}(\bm{S}_{1}),\bm{y}_{1})}{\partial f_{\theta^{t}}(\bm{S}_{1})},\dots,\frac{\partial\mathcal{L}(f_{\theta^{t}}(\bm{S}_{N}),\bm{y}_{N})}{\partial f_{\theta^{t}}(\bm{S}_{N})}\right]\cdot\left[K_{\theta^{t}}(\bm{S}_{i},\cdot)\right]_{N},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A1.SS4.p1.3" class="ltx_p">which leads to Equation <a href="#S4.E15" title="In 4.2 The Functional Evolution of ANN ‣ 4 AtteNT ‣ Nonparametric Teaching of Attention Learners" class="ltx_ref"><span class="ltx_text ltx_ref_tag">15</span></a> expressed as</p>
<table id="A1.EGx31" class="ltx_equationgroup ltx_eqn_eqnarray ltx_eqn_table">

<tbody id="A1.E58"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A1.E58.m1" class="ltx_math_unparsed" alttext="\displaystyle\frac{\partial f_{\theta^{t}}}{\partial t}=-\frac{\eta}{NS}\left[\frac{\partial\mathcal{L}(f_{\theta^{t}}(\bm{S}_{1}),\bm{y}_{1})}{\partial f_{\theta^{t}}(\bm{S}_{1})},\dots,\frac{\partial\mathcal{L}(f_{\theta^{t}}(\bm{S}_{N}),\bm{y}_{N})}{\partial f_{\theta^{t}}(\bm{S}_{N})}\right]\cdot\left[K_{\theta^{t}}(\bm{S}_{i},\cdot)\right]_{N}+o\left(\frac{\partial\theta^{t}}{\partial t}\right)," display="inline" intent=":literal"><semantics><mrow><mstyle displaystyle="true"><mfrac><mrow><mo>∂</mo><msub><mi>f</mi><msup><mi>θ</mi><mi>t</mi></msup></msub></mrow><mrow><mo>∂</mo><mi>t</mi></mrow></mfrac></mstyle><mo rspace="0em">=</mo><mo lspace="0em">−</mo><mstyle displaystyle="true"><mfrac><mi>η</mi><mrow><mi>N</mi><mo lspace="0em" rspace="0em">​</mo><mi>S</mi></mrow></mfrac></mstyle><mrow><mo>[</mo><mstyle displaystyle="true"><mfrac><mrow><mo>∂</mo><mrow><mi class="ltx_font_mathcaligraphic">ℒ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>f</mi><msup><mi>θ</mi><mi>t</mi></msup></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝑺</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><msub><mi>𝒚</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mrow><mo>∂</mo><mrow><msub><mi>f</mi><msup><mi>θ</mi><mi>t</mi></msup></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝑺</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow></mrow></mrow></mfrac></mstyle><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mstyle displaystyle="true"><mfrac><mrow><mo>∂</mo><mrow><mi class="ltx_font_mathcaligraphic">ℒ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>f</mi><msup><mi>θ</mi><mi>t</mi></msup></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝑺</mi><mi>N</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><msub><mi>𝒚</mi><mi>N</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mrow><mo>∂</mo><mrow><msub><mi>f</mi><msup><mi>θ</mi><mi>t</mi></msup></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝑺</mi><mi>N</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow></mfrac></mstyle><mo rspace="0.055em">]</mo></mrow><mo rspace="0.222em">⋅</mo><msub><mrow><mo>[</mo><msub><mi>K</mi><msup><mi>θ</mi><mi>t</mi></msup></msub><mrow><mo stretchy="false">(</mo><msub><mi>𝑺</mi><mi>i</mi></msub><mo rspace="0em">,</mo><mo lspace="0em" rspace="0em">⋅</mo><mo stretchy="false">)</mo></mrow><mo>]</mo></mrow><mi>N</mi></msub><mo>+</mo><mi>o</mi><mrow><mo>(</mo><mstyle displaystyle="true"><mfrac><mrow><mo>∂</mo><msup><mi>θ</mi><mi>t</mi></msup></mrow><mrow><mo>∂</mo><mi>t</mi></mrow></mfrac></mstyle><mo>)</mo></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\frac{\partial f_{\theta^{t}}}{\partial t}=-\frac{\eta}{NS}\left[\frac{\partial\mathcal{L}(f_{\theta^{t}}(\bm{S}_{1}),\bm{y}_{1})}{\partial f_{\theta^{t}}(\bm{S}_{1})},\dots,\frac{\partial\mathcal{L}(f_{\theta^{t}}(\bm{S}_{N}),\bm{y}_{N})}{\partial f_{\theta^{t}}(\bm{S}_{N})}\right]\cdot\left[K_{\theta^{t}}(\bm{S}_{i},\cdot)\right]_{N}+o\left(\frac{\partial\theta^{t}}{\partial t}\right),</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(58)</span></td></tr></tbody>
</table>
<p id="A1.SS4.p1.4" class="ltx_p">where the symmetric and positive definite <math id="A1.SS4.p1.m2" class="ltx_Math" alttext="K_{\theta^{t}}(\bm{S}_{i},\cdot)\coloneqq\left\langle\frac{\partial f_{\theta^{t}}(\bm{S}_{i})}{\partial\theta^{t}},\frac{\partial f_{\theta^{t}}(\cdot)}{\partial\theta^{t}}\right\rangle" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>K</mi><msup><mi>θ</mi><mi>t</mi></msup></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝑺</mi><mi>i</mi></msub><mo rspace="0em">,</mo><mo lspace="0em" rspace="0em">⋅</mo><mo stretchy="false">)</mo></mrow></mrow><mo>≔</mo><mrow><mo>⟨</mo><mrow><mfrac><mrow><mo>∂</mo><mrow><msub><mi>f</mi><msup><mi>θ</mi><mi>t</mi></msup></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝑺</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mrow><mo>∂</mo><msup><mi>θ</mi><mi>t</mi></msup></mrow></mfrac><mo>,</mo><mfrac><mrow><mo>∂</mo><mrow><msub><mi>f</mi><msup><mi>θ</mi><mi>t</mi></msup></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo stretchy="false">)</mo></mrow></mrow></mrow><mrow><mo>∂</mo><msup><mi>θ</mi><mi>t</mi></msup></mrow></mfrac></mrow><mo>⟩</mo></mrow></mrow><annotation encoding="application/x-tex">K_{\theta^{t}}(\bm{S}_{i},\cdot)\coloneqq\left\langle\frac{\partial f_{\theta^{t}}(\bm{S}_{i})}{\partial\theta^{t}},\frac{\partial f_{\theta^{t}}(\cdot)}{\partial\theta^{t}}\right\rangle</annotation></semantics></math> is called the attention neural tangent kernel (ANTK) <cite class="ltx_cite ltx_citemacro_citep">(<a href="#bib.bib111" title="" class="ltx_ref">Jacot et al., 2018</a>; <a href="#bib.bib54" title="" class="ltx_ref">Yang, 2019</a>; <a href="#bib.bib53" title="" class="ltx_ref">Hron et al., 2020</a>)</cite>. Specifically, ANTK for <math id="A1.SS4.p1.m3" class="ltx_math_unparsed" alttext="{\bm{S}}_{(i,:)}" display="inline" intent=":literal"><semantics><mrow><mi>𝑺</mi><msub><mrow></mrow><mrow><mo stretchy="false">(</mo><mi>i</mi><mo>,</mo><mo rspace="0em">:</mo><mo stretchy="false">)</mo></mrow></msub></mrow><annotation encoding="application/x-tex">{\bm{S}}_{(i,:)}</annotation></semantics></math> and <math id="A1.SS4.p1.m4" class="ltx_math_unparsed" alttext="{\bm{S}^{\prime}}_{(j,:)}" display="inline" intent=":literal"><semantics><mrow><mi>𝑺</mi><msup><mrow></mrow><mo>′</mo></msup><msub><mrow></mrow><mrow><mo stretchy="false">(</mo><mi>j</mi><mo>,</mo><mo rspace="0em">:</mo><mo stretchy="false">)</mo></mrow></msub></mrow><annotation encoding="application/x-tex">{\bm{S}^{\prime}}_{(j,:)}</annotation></semantics></math> is a scalar <math id="A1.SS4.p1.m5" class="ltx_math_unparsed" alttext="K({\bm{S}}_{(i,:)},{\bm{S}^{\prime}}_{(j,:)})=\Big\langle\frac{\partial{f_{\theta^{t}}(\bm{S})}_{(i,:)}}{\partial\theta^{t}},\frac{\partial{f_{\theta^{t}}(\bm{S}^{\prime})}_{(j,:)}}{\partial\theta^{t}}\Big\rangle" display="inline" intent=":literal"><semantics><mrow><mi>K</mi><mrow><mo stretchy="false">(</mo><msub><mi>𝑺</mi><mrow><mo stretchy="false">(</mo><mi>i</mi><mo>,</mo><mo rspace="0em">:</mo><mo stretchy="false">)</mo></mrow></msub><mo>,</mo><mmultiscripts><mi>𝑺</mi><mrow></mrow><mo>′</mo><mrow><mo stretchy="false">(</mo><mi>j</mi><mo>,</mo><mo rspace="0em">:</mo><mo stretchy="false">)</mo></mrow><mrow></mrow></mmultiscripts><mo stretchy="false">)</mo></mrow><mo>=</mo><mrow><mo stretchy="false">⟨</mo><mfrac><mrow><mo>∂</mo><mi>f</mi><msub><mrow></mrow><msup><mi>θ</mi><mi>t</mi></msup></msub><mo stretchy="false">(</mo><mi>𝑺</mi><mo stretchy="false">)</mo><msub><mrow></mrow><mrow><mo stretchy="false">(</mo><mi>i</mi><mo>,</mo><mo rspace="0em">:</mo><mo stretchy="false">)</mo></mrow></msub></mrow><mrow><mo>∂</mo><msup><mi>θ</mi><mi>t</mi></msup></mrow></mfrac><mo>,</mo><mfrac><mrow><mo>∂</mo><mi>f</mi><msub><mrow></mrow><msup><mi>θ</mi><mi>t</mi></msup></msub><mo stretchy="false">(</mo><mi>𝑺</mi><msup><mrow></mrow><mo>′</mo></msup><mo stretchy="false">)</mo><msub><mrow></mrow><mrow><mo stretchy="false">(</mo><mi>j</mi><mo>,</mo><mo rspace="0em">:</mo><mo stretchy="false">)</mo></mrow></msub></mrow><mrow><mo>∂</mo><msup><mi>θ</mi><mi>t</mi></msup></mrow></mfrac><mo stretchy="false">⟩</mo></mrow></mrow><annotation encoding="application/x-tex">K({\bm{S}}_{(i,:)},{\bm{S}^{\prime}}_{(j,:)})=\Big\langle\frac{\partial{f_{\theta^{t}}(\bm{S})}_{(i,:)}}{\partial\theta^{t}},\frac{\partial{f_{\theta^{t}}(\bm{S}^{\prime})}_{(j,:)}}{\partial\theta^{t}}\Big\rangle</annotation></semantics></math>.
Figure <a href="#A1.F3" title="Figure 3 ‣ A.4 Attention Neural Tangent Kernel (ANTK) ‣ Appendix A Additional Discussions ‣ Nonparametric Teaching of Attention Learners" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3</span></a> illustrates the ANTK computation process, where typically, the length of all training sequences is standardized to the maximum length. In simple terms, examining a model’s behavior by focusing on the model itself, rather than its parameters, often involves the use of kernel functions.</p>
</div>
<figure id="A1.F3" class="ltx_figure">
<p id="A1.F3.2" class="ltx_p ltx_align_center ltx_align_center"><span id="A1.F3.2.1" class="ltx_text"><img src="2602.20461v1/ANTK.png" id="A1.F3.g1" class="ltx_graphics ltx_img_landscape" style="aspect-ratio:548/318;" width="548" height="318" alt="Refer to caption"></span></p>
<figcaption class="ltx_caption ltx_centering"><span class="ltx_tag ltx_tag_figure">Figure 3: </span>Graphical depiction of the ANTK computation process: <math id="A1.F3.m2" class="ltx_math_unparsed" alttext="K_{\theta}(\bm{S}_{S},\bm{S}^{\prime}_{S^{\prime}})=\left\langle\frac{\partial f_{\theta}(\bm{S})}{\partial\theta},\frac{\partial f_{\theta}(\bm{S}^{\prime})}{\partial\theta}\right\rangle=\bigg[\frac{\partial{f_{\theta}(\bm{S})}_{(i,:)}}{\partial\bm{W}^{V}_{(1)}}\frac{\partial{f_{\theta}(\bm{S}^{\prime})}_{(j,:)}}{\partial\bm{W}^{V}_{(1)}}+\dots+\frac{\partial{f_{\theta}(\bm{S})}_{(i,:)}}{\partial\bm{W}^{V}_{(d)}}\frac{\partial{f_{\theta}(\bm{S}^{\prime})}_{(j,:)}}{\partial\bm{W}^{V}_{(d)}}+\frac{\partial{f_{\theta}(\bm{S})}_{(i,:)}}{\partial\bm{W}^{Q}_{(1,1)}}\frac{\partial{f_{\theta}(\bm{S}^{\prime})}_{(j,:)}}{\partial\bm{W}^{Q}_{(1,1)}}+\dots+\frac{\partial{f_{\theta}(\bm{S})}_{(i,:)}}{\partial\bm{W}^{Q}_{(d,p)}}\frac{\partial{f_{\theta}(\bm{S}^{\prime})}_{(j,:)}}{\partial\bm{W}^{Q}_{(d,p)}}+\frac{\partial{f_{\theta}(\bm{S})}_{(i,:)}}{\partial\bm{W}^{K}_{(1,1)}}\frac{\partial{f_{\theta}(\bm{S}^{\prime})}_{(j,:)}}{\partial\bm{W}^{K}_{(1,1)}}+\dots+\frac{\partial{f_{\theta}(\bm{S})}_{(i,:)}}{\partial\bm{W}^{K}_{(d,p)}}\frac{\partial{f_{\theta}(\bm{S}^{\prime})}_{(j,:)}}{\partial\bm{W}^{K}_{(d,p)}}\bigg]_{S\times S^{\prime};i\in\mathbb{N}_{S},j\in\mathbb{N}_{S^{\prime}}}" display="inline" intent=":literal"><semantics><mrow><msub><mi>K</mi><mi>θ</mi></msub><mrow><mo stretchy="false">(</mo><msub><mi>𝑺</mi><mi>S</mi></msub><mo>,</mo><msubsup><mi>𝑺</mi><msup><mi>S</mi><mo>′</mo></msup><mo>′</mo></msubsup><mo stretchy="false">)</mo></mrow><mo>=</mo><mrow><mo>⟨</mo><mfrac><mrow><mo>∂</mo><mrow><msub><mi>f</mi><mi>θ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝑺</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mrow><mo>∂</mo><mi>θ</mi></mrow></mfrac><mo>,</mo><mfrac><mrow><mo>∂</mo><mrow><msub><mi>f</mi><mi>θ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>𝑺</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow></mrow></mrow><mrow><mo>∂</mo><mi>θ</mi></mrow></mfrac><mo>⟩</mo></mrow><mo>=</mo><msub><mrow><mo maxsize="2.100em" minsize="2.100em">[</mo><mfrac><mrow><mo>∂</mo><mi>f</mi><msub><mrow></mrow><mi>θ</mi></msub><mo stretchy="false">(</mo><mi>𝑺</mi><mo stretchy="false">)</mo><msub><mrow></mrow><mrow><mo stretchy="false">(</mo><mi>i</mi><mo>,</mo><mo rspace="0em">:</mo><mo stretchy="false">)</mo></mrow></msub></mrow><mrow><mo>∂</mo><msubsup><mi>𝑾</mi><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow><mi>V</mi></msubsup></mrow></mfrac><mfrac><mrow><mo>∂</mo><mi>f</mi><msub><mrow></mrow><mi>θ</mi></msub><mo stretchy="false">(</mo><mi>𝑺</mi><msup><mrow></mrow><mo>′</mo></msup><mo stretchy="false">)</mo><msub><mrow></mrow><mrow><mo stretchy="false">(</mo><mi>j</mi><mo>,</mo><mo rspace="0em">:</mo><mo stretchy="false">)</mo></mrow></msub></mrow><mrow><mo>∂</mo><msubsup><mi>𝑾</mi><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow><mi>V</mi></msubsup></mrow></mfrac><mo>+</mo><mi mathvariant="normal">⋯</mi><mo>+</mo><mfrac><mrow><mo>∂</mo><mi>f</mi><msub><mrow></mrow><mi>θ</mi></msub><mo stretchy="false">(</mo><mi>𝑺</mi><mo stretchy="false">)</mo><msub><mrow></mrow><mrow><mo stretchy="false">(</mo><mi>i</mi><mo>,</mo><mo rspace="0em">:</mo><mo stretchy="false">)</mo></mrow></msub></mrow><mrow><mo>∂</mo><msubsup><mi>𝑾</mi><mrow><mo stretchy="false">(</mo><mi>d</mi><mo stretchy="false">)</mo></mrow><mi>V</mi></msubsup></mrow></mfrac><mfrac><mrow><mo>∂</mo><mi>f</mi><msub><mrow></mrow><mi>θ</mi></msub><mo stretchy="false">(</mo><mi>𝑺</mi><msup><mrow></mrow><mo>′</mo></msup><mo stretchy="false">)</mo><msub><mrow></mrow><mrow><mo stretchy="false">(</mo><mi>j</mi><mo>,</mo><mo rspace="0em">:</mo><mo stretchy="false">)</mo></mrow></msub></mrow><mrow><mo>∂</mo><msubsup><mi>𝑾</mi><mrow><mo stretchy="false">(</mo><mi>d</mi><mo stretchy="false">)</mo></mrow><mi>V</mi></msubsup></mrow></mfrac><mo>+</mo><mfrac><mrow><mo>∂</mo><mi>f</mi><msub><mrow></mrow><mi>θ</mi></msub><mo stretchy="false">(</mo><mi>𝑺</mi><mo stretchy="false">)</mo><msub><mrow></mrow><mrow><mo stretchy="false">(</mo><mi>i</mi><mo>,</mo><mo rspace="0em">:</mo><mo stretchy="false">)</mo></mrow></msub></mrow><mrow><mo>∂</mo><msubsup><mi>𝑾</mi><mrow><mo stretchy="false">(</mo><mn>1</mn><mo>,</mo><mn>1</mn><mo stretchy="false">)</mo></mrow><mi>Q</mi></msubsup></mrow></mfrac><mfrac><mrow><mo>∂</mo><mi>f</mi><msub><mrow></mrow><mi>θ</mi></msub><mo stretchy="false">(</mo><mi>𝑺</mi><msup><mrow></mrow><mo>′</mo></msup><mo stretchy="false">)</mo><msub><mrow></mrow><mrow><mo stretchy="false">(</mo><mi>j</mi><mo>,</mo><mo rspace="0em">:</mo><mo stretchy="false">)</mo></mrow></msub></mrow><mrow><mo>∂</mo><msubsup><mi>𝑾</mi><mrow><mo stretchy="false">(</mo><mn>1</mn><mo>,</mo><mn>1</mn><mo stretchy="false">)</mo></mrow><mi>Q</mi></msubsup></mrow></mfrac><mo>+</mo><mi mathvariant="normal">⋯</mi><mo>+</mo><mfrac><mrow><mo>∂</mo><mi>f</mi><msub><mrow></mrow><mi>θ</mi></msub><mo stretchy="false">(</mo><mi>𝑺</mi><mo stretchy="false">)</mo><msub><mrow></mrow><mrow><mo stretchy="false">(</mo><mi>i</mi><mo>,</mo><mo rspace="0em">:</mo><mo stretchy="false">)</mo></mrow></msub></mrow><mrow><mo>∂</mo><msubsup><mi>𝑾</mi><mrow><mo stretchy="false">(</mo><mi>d</mi><mo>,</mo><mi>p</mi><mo stretchy="false">)</mo></mrow><mi>Q</mi></msubsup></mrow></mfrac><mfrac><mrow><mo>∂</mo><mi>f</mi><msub><mrow></mrow><mi>θ</mi></msub><mo stretchy="false">(</mo><mi>𝑺</mi><msup><mrow></mrow><mo>′</mo></msup><mo stretchy="false">)</mo><msub><mrow></mrow><mrow><mo stretchy="false">(</mo><mi>j</mi><mo>,</mo><mo rspace="0em">:</mo><mo stretchy="false">)</mo></mrow></msub></mrow><mrow><mo>∂</mo><msubsup><mi>𝑾</mi><mrow><mo stretchy="false">(</mo><mi>d</mi><mo>,</mo><mi>p</mi><mo stretchy="false">)</mo></mrow><mi>Q</mi></msubsup></mrow></mfrac><mo>+</mo><mfrac><mrow><mo>∂</mo><mi>f</mi><msub><mrow></mrow><mi>θ</mi></msub><mo stretchy="false">(</mo><mi>𝑺</mi><mo stretchy="false">)</mo><msub><mrow></mrow><mrow><mo stretchy="false">(</mo><mi>i</mi><mo>,</mo><mo rspace="0em">:</mo><mo stretchy="false">)</mo></mrow></msub></mrow><mrow><mo>∂</mo><msubsup><mi>𝑾</mi><mrow><mo stretchy="false">(</mo><mn>1</mn><mo>,</mo><mn>1</mn><mo stretchy="false">)</mo></mrow><mi>K</mi></msubsup></mrow></mfrac><mfrac><mrow><mo>∂</mo><mi>f</mi><msub><mrow></mrow><mi>θ</mi></msub><mo stretchy="false">(</mo><mi>𝑺</mi><msup><mrow></mrow><mo>′</mo></msup><mo stretchy="false">)</mo><msub><mrow></mrow><mrow><mo stretchy="false">(</mo><mi>j</mi><mo>,</mo><mo rspace="0em">:</mo><mo stretchy="false">)</mo></mrow></msub></mrow><mrow><mo>∂</mo><msubsup><mi>𝑾</mi><mrow><mo stretchy="false">(</mo><mn>1</mn><mo>,</mo><mn>1</mn><mo stretchy="false">)</mo></mrow><mi>K</mi></msubsup></mrow></mfrac><mo>+</mo><mi mathvariant="normal">⋯</mi><mo>+</mo><mfrac><mrow><mo>∂</mo><mi>f</mi><msub><mrow></mrow><mi>θ</mi></msub><mo stretchy="false">(</mo><mi>𝑺</mi><mo stretchy="false">)</mo><msub><mrow></mrow><mrow><mo stretchy="false">(</mo><mi>i</mi><mo>,</mo><mo rspace="0em">:</mo><mo stretchy="false">)</mo></mrow></msub></mrow><mrow><mo>∂</mo><msubsup><mi>𝑾</mi><mrow><mo stretchy="false">(</mo><mi>d</mi><mo>,</mo><mi>p</mi><mo stretchy="false">)</mo></mrow><mi>K</mi></msubsup></mrow></mfrac><mfrac><mrow><mo>∂</mo><mi>f</mi><msub><mrow></mrow><mi>θ</mi></msub><mo stretchy="false">(</mo><mi>𝑺</mi><msup><mrow></mrow><mo>′</mo></msup><mo stretchy="false">)</mo><msub><mrow></mrow><mrow><mo stretchy="false">(</mo><mi>j</mi><mo>,</mo><mo rspace="0em">:</mo><mo stretchy="false">)</mo></mrow></msub></mrow><mrow><mo>∂</mo><msubsup><mi>𝑾</mi><mrow><mo stretchy="false">(</mo><mi>d</mi><mo>,</mo><mi>p</mi><mo stretchy="false">)</mo></mrow><mi>K</mi></msubsup></mrow></mfrac><mo maxsize="2.100em" minsize="2.100em">]</mo></mrow><mrow><mrow><mrow><mrow><mi>S</mi><mo lspace="0.222em" rspace="0.222em">×</mo><msup><mi>S</mi><mo>′</mo></msup></mrow><mo>;</mo><mi>i</mi></mrow><mo>∈</mo><msub><mi>ℕ</mi><mi>S</mi></msub></mrow><mo>,</mo><mrow><mi>j</mi><mo>∈</mo><msub><mi>ℕ</mi><msup><mi>S</mi><mo>′</mo></msup></msub></mrow></mrow></msub></mrow><annotation encoding="application/x-tex">K_{\theta}(\bm{S}_{S},\bm{S}^{\prime}_{S^{\prime}})=\left\langle\frac{\partial f_{\theta}(\bm{S})}{\partial\theta},\frac{\partial f_{\theta}(\bm{S}^{\prime})}{\partial\theta}\right\rangle=\bigg[\frac{\partial{f_{\theta}(\bm{S})}_{(i,:)}}{\partial\bm{W}^{V}_{(1)}}\frac{\partial{f_{\theta}(\bm{S}^{\prime})}_{(j,:)}}{\partial\bm{W}^{V}_{(1)}}+\dots+\frac{\partial{f_{\theta}(\bm{S})}_{(i,:)}}{\partial\bm{W}^{V}_{(d)}}\frac{\partial{f_{\theta}(\bm{S}^{\prime})}_{(j,:)}}{\partial\bm{W}^{V}_{(d)}}+\frac{\partial{f_{\theta}(\bm{S})}_{(i,:)}}{\partial\bm{W}^{Q}_{(1,1)}}\frac{\partial{f_{\theta}(\bm{S}^{\prime})}_{(j,:)}}{\partial\bm{W}^{Q}_{(1,1)}}+\dots+\frac{\partial{f_{\theta}(\bm{S})}_{(i,:)}}{\partial\bm{W}^{Q}_{(d,p)}}\frac{\partial{f_{\theta}(\bm{S}^{\prime})}_{(j,:)}}{\partial\bm{W}^{Q}_{(d,p)}}+\frac{\partial{f_{\theta}(\bm{S})}_{(i,:)}}{\partial\bm{W}^{K}_{(1,1)}}\frac{\partial{f_{\theta}(\bm{S}^{\prime})}_{(j,:)}}{\partial\bm{W}^{K}_{(1,1)}}+\dots+\frac{\partial{f_{\theta}(\bm{S})}_{(i,:)}}{\partial\bm{W}^{K}_{(d,p)}}\frac{\partial{f_{\theta}(\bm{S}^{\prime})}_{(j,:)}}{\partial\bm{W}^{K}_{(d,p)}}\bigg]_{S\times S^{\prime};i\in\mathbb{N}_{S},j\in\mathbb{N}_{S^{\prime}}}</annotation></semantics></math>.</figcaption>
</figure>
<div id="A1.SS4.p2" class="ltx_para ltx_noindent">
<p id="A1.SS4.p2.1" class="ltx_p">The quantity <math id="A1.SS4.p2.m1" class="ltx_Math" alttext="\frac{\partial f_{\theta^{t}}(\cdot)}{\partial\theta^{t}}" display="inline" intent=":literal"><semantics><mfrac><mrow><mo>∂</mo><mrow><msub><mi>f</mi><msup><mi>θ</mi><mi>t</mi></msup></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo stretchy="false">)</mo></mrow></mrow></mrow><mrow><mo>∂</mo><msup><mi>θ</mi><mi>t</mi></msup></mrow></mfrac><annotation encoding="application/x-tex">\frac{\partial f_{\theta^{t}}(\cdot)}{\partial\theta^{t}}</annotation></semantics></math>, which represents the partial derivative of the ANN with respect to its parameters and appears in <math id="A1.SS4.p2.m2" class="ltx_Math" alttext="K_{\theta^{t}}(\bm{S}_{i},\cdot)=\left\langle\frac{\partial f_{\theta^{t}}(\bm{S}_{i})}{\partial\theta^{t}},\frac{\partial f_{\theta^{t}}(\cdot)}{\partial\theta^{t}}\right\rangle" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>K</mi><msup><mi>θ</mi><mi>t</mi></msup></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝑺</mi><mi>i</mi></msub><mo rspace="0em">,</mo><mo lspace="0em" rspace="0em">⋅</mo><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mo>⟨</mo><mrow><mfrac><mrow><mo>∂</mo><mrow><msub><mi>f</mi><msup><mi>θ</mi><mi>t</mi></msup></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝑺</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mrow><mo>∂</mo><msup><mi>θ</mi><mi>t</mi></msup></mrow></mfrac><mo>,</mo><mfrac><mrow><mo>∂</mo><mrow><msub><mi>f</mi><msup><mi>θ</mi><mi>t</mi></msup></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo stretchy="false">)</mo></mrow></mrow></mrow><mrow><mo>∂</mo><msup><mi>θ</mi><mi>t</mi></msup></mrow></mfrac></mrow><mo>⟩</mo></mrow></mrow><annotation encoding="application/x-tex">K_{\theta^{t}}(\bm{S}_{i},\cdot)=\left\langle\frac{\partial f_{\theta^{t}}(\bm{S}_{i})}{\partial\theta^{t}},\frac{\partial f_{\theta^{t}}(\cdot)}{\partial\theta^{t}}\right\rangle</annotation></semantics></math>, is determined by both the network architecture and the specific parameters <math id="A1.SS4.p2.m3" class="ltx_Math" alttext="\theta^{t}" display="inline" intent=":literal"><semantics><msup><mi>θ</mi><mi>t</mi></msup><annotation encoding="application/x-tex">\theta^{t}</annotation></semantics></math>, but it is independent of the input sequences. In contrast, the term <math id="A1.SS4.p2.m4" class="ltx_Math" alttext="\frac{\partial f_{\theta^{t}}(\bm{S}_{i})}{\partial\theta^{t}}" display="inline" intent=":literal"><semantics><mfrac><mrow><mo>∂</mo><mrow><msub><mi>f</mi><msup><mi>θ</mi><mi>t</mi></msup></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝑺</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mrow><mo>∂</mo><msup><mi>θ</mi><mi>t</mi></msup></mrow></mfrac><annotation encoding="application/x-tex">\frac{\partial f_{\theta^{t}}(\bm{S}_{i})}{\partial\theta^{t}}</annotation></semantics></math> depends not only on the ANN structure and specific <math id="A1.SS4.p2.m5" class="ltx_Math" alttext="\theta^{t}" display="inline" intent=":literal"><semantics><msup><mi>θ</mi><mi>t</mi></msup><annotation encoding="application/x-tex">\theta^{t}</annotation></semantics></math>, but also on the input sequence <math id="A1.SS4.p2.m6" class="ltx_Math" alttext="\bm{S}" display="inline" intent=":literal"><semantics><mi>𝑺</mi><annotation encoding="application/x-tex">\bm{S}</annotation></semantics></math>. When the input for <math id="A1.SS4.p2.m7" class="ltx_Math" alttext="\frac{\partial f_{\theta^{t}}(\bm{S}_{i})}{\partial\theta^{t}}" display="inline" intent=":literal"><semantics><mfrac><mrow><mo>∂</mo><mrow><msub><mi>f</mi><msup><mi>θ</mi><mi>t</mi></msup></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝑺</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mrow><mo>∂</mo><msup><mi>θ</mi><mi>t</mi></msup></mrow></mfrac><annotation encoding="application/x-tex">\frac{\partial f_{\theta^{t}}(\bm{S}_{i})}{\partial\theta^{t}}</annotation></semantics></math> is unspecified, the ANTK simplifies to a general form <math id="A1.SS4.p2.m8" class="ltx_Math" alttext="K_{\theta^{t}}(\cdot,\cdot)" display="inline" intent=":literal"><semantics><mrow><msub><mi>K</mi><msup><mi>θ</mi><mi>t</mi></msup></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo rspace="0em">,</mo><mo lspace="0em" rspace="0em">⋅</mo><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">K_{\theta^{t}}(\cdot,\cdot)</annotation></semantics></math>. However, when a specific sequence <math id="A1.SS4.p2.m9" class="ltx_Math" alttext="\bm{S}_{j}" display="inline" intent=":literal"><semantics><msub><mi>𝑺</mi><mi>j</mi></msub><annotation encoding="application/x-tex">\bm{S}_{j}</annotation></semantics></math> is provided as the input to <math id="A1.SS4.p2.m10" class="ltx_Math" alttext="\frac{\partial f_{\theta^{t}}(\cdot)}{\partial\theta^{t}}" display="inline" intent=":literal"><semantics><mfrac><mrow><mo>∂</mo><mrow><msub><mi>f</mi><msup><mi>θ</mi><mi>t</mi></msup></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo stretchy="false">)</mo></mrow></mrow></mrow><mrow><mo>∂</mo><msup><mi>θ</mi><mi>t</mi></msup></mrow></mfrac><annotation encoding="application/x-tex">\frac{\partial f_{\theta^{t}}(\cdot)}{\partial\theta^{t}}</annotation></semantics></math>, the ANTK becomes a matrix defined as <math id="A1.SS4.p2.m11" class="ltx_Math" alttext="K_{\theta^{t}}(\bm{S}_{i},\bm{S}_{j})=\left\langle\frac{\partial f_{\theta^{t}}(\bm{S}_{i})}{\partial\theta^{t}},\frac{\partial f_{\theta^{t}}(\bm{S}_{j})}{\partial\theta^{t}}\right\rangle" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>K</mi><msup><mi>θ</mi><mi>t</mi></msup></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝑺</mi><mi>i</mi></msub><mo>,</mo><msub><mi>𝑺</mi><mi>j</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mo>⟨</mo><mrow><mfrac><mrow><mo>∂</mo><mrow><msub><mi>f</mi><msup><mi>θ</mi><mi>t</mi></msup></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝑺</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mrow><mo>∂</mo><msup><mi>θ</mi><mi>t</mi></msup></mrow></mfrac><mo>,</mo><mfrac><mrow><mo>∂</mo><mrow><msub><mi>f</mi><msup><mi>θ</mi><mi>t</mi></msup></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝑺</mi><mi>j</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mrow><mo>∂</mo><msup><mi>θ</mi><mi>t</mi></msup></mrow></mfrac></mrow><mo>⟩</mo></mrow></mrow><annotation encoding="application/x-tex">K_{\theta^{t}}(\bm{S}_{i},\bm{S}_{j})=\left\langle\frac{\partial f_{\theta^{t}}(\bm{S}_{i})}{\partial\theta^{t}},\frac{\partial f_{\theta^{t}}(\bm{S}_{j})}{\partial\theta^{t}}\right\rangle</annotation></semantics></math>. This formulation aligns with the vector-valued kernel used in functional gradient descent <cite class="ltx_cite ltx_citemacro_citep">(<a href="#bib.bib2" title="" class="ltx_ref">Zhang et al., 2023b</a>)</cite>. When the input sequence <math id="A1.SS4.p2.m12" class="ltx_Math" alttext="\bm{S}_{i}" display="inline" intent=":literal"><semantics><msub><mi>𝑺</mi><mi>i</mi></msub><annotation encoding="application/x-tex">\bm{S}_{i}</annotation></semantics></math> is specified, one argument of <math id="A1.SS4.p2.m13" class="ltx_Math" alttext="K_{\theta^{t}}" display="inline" intent=":literal"><semantics><msub><mi>K</mi><msup><mi>θ</mi><mi>t</mi></msup></msub><annotation encoding="application/x-tex">K_{\theta^{t}}</annotation></semantics></math> is fixed, leading the ANN to update along <math id="A1.SS4.p2.m14" class="ltx_Math" alttext="K_{\theta^{t}}(\bm{S}_{i},\cdot)" display="inline" intent=":literal"><semantics><mrow><msub><mi>K</mi><msup><mi>θ</mi><mi>t</mi></msup></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝑺</mi><mi>i</mi></msub><mo rspace="0em">,</mo><mo lspace="0em" rspace="0em">⋅</mo><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">K_{\theta^{t}}(\bm{S}_{i},\cdot)</annotation></semantics></math>, with the magnitude of the update determined by <math id="A1.SS4.p2.m15" class="ltx_Math" alttext="\frac{\partial f_{\theta^{t}}(\bm{S}_{i})}{\partial\theta^{t}}" display="inline" intent=":literal"><semantics><mfrac><mrow><mo>∂</mo><mrow><msub><mi>f</mi><msup><mi>θ</mi><mi>t</mi></msup></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝑺</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mrow><mo>∂</mo><msup><mi>θ</mi><mi>t</mi></msup></mrow></mfrac><annotation encoding="application/x-tex">\frac{\partial f_{\theta^{t}}(\bm{S}_{i})}{\partial\theta^{t}}</annotation></semantics></math>.
This process reflects the core mechanism of functional gradient descent. In summary, the ANTK and the canonical vector-valued kernel share a consistent mathematical framework and exhibit similar effects on the evolution of the associated ANN. Additionally, Theorem <a href="#Thmthm3" title="Theorem 3. ‣ 4.2 The Functional Evolution of ANN ‣ 4 AtteNT ‣ Nonparametric Teaching of Attention Learners" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3</span></a> establishes the asymptotic relationship between the ANTK and the canonical kernel used in functional gradient descent.</p>
</div>
</section>
<section id="A1.SS5" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">A.5 </span>AtteNT Algorithm</h3>

<figure id="algorithm1" class="ltx_float ltx_float_algorithm ltx_framed ltx_framed_top">

<figcaption class="ltx_caption"><span class="ltx_tag ltx_tag_float"><span id="algorithm1.3" class="ltx_text ltx_font_bold">Algorithm 1</span> </span> AtteNT Algorithm</figcaption><div class="ltx_flex_figure">
<div class="ltx_flex_cell ltx_flex_size_1">
<p id="algorithm1.4" class="ltx_p ltx_figure_panel ltx_framed ltx_framed_topbottom"><span id="algorithm1.4.1" class="ltx_text ltx_font_bold">Input:</span> Target mapping <math id="algorithm1.m1" class="ltx_Math" alttext="f^{*}" display="inline" intent=":literal"><semantics><msup><mi>f</mi><mo>∗</mo></msup><annotation encoding="application/x-tex">f^{*}</annotation></semantics></math> realized by a dense set of sequence-property pairs, initial ANN <math id="algorithm1.m2" class="ltx_Math" alttext="f_{\theta^{0}}" display="inline" intent=":literal"><semantics><msub><mi>f</mi><msup><mi>θ</mi><mn>0</mn></msup></msub><annotation encoding="application/x-tex">f_{\theta^{0}}</annotation></semantics></math>, the size of selected training set <math id="algorithm1.m3" class="ltx_Math" alttext="m\leq N" display="inline" intent=":literal"><semantics><mrow><mi>m</mi><mo>≤</mo><mi>N</mi></mrow><annotation encoding="application/x-tex">m\leq N</annotation></semantics></math>, small constant <math id="algorithm1.m4" class="ltx_Math" alttext="\epsilon&gt;0" display="inline" intent=":literal"><semantics><mrow><mi>ϵ</mi><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\epsilon&gt;0</annotation></semantics></math> and maximal iteration number <math id="algorithm1.m5" class="ltx_Math" alttext="T" display="inline" intent=":literal"><semantics><mi>T</mi><annotation encoding="application/x-tex">T</annotation></semantics></math></p></div><div class="ltx_flex_break"></div><div class="ltx_flex_cell ltx_flex_size_1">
<p id="algorithm1.5" class="ltx_p ltx_figure_panel">Set <math id="algorithm1.m6" class="ltx_Math" alttext="f_{\theta^{t}}\leftarrow f_{\theta^{0}}" display="inline" intent=":literal"><semantics><mrow><msub><mi>f</mi><msup><mi>θ</mi><mi>t</mi></msup></msub><mo stretchy="false">←</mo><msub><mi>f</mi><msup><mi>θ</mi><mn>0</mn></msup></msub></mrow><annotation encoding="application/x-tex">f_{\theta^{t}}\leftarrow f_{\theta^{0}}</annotation></semantics></math>, <math id="algorithm1.m7" class="ltx_Math" alttext="t=0" display="inline" intent=":literal"><semantics><mrow><mi>t</mi><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">t=0</annotation></semantics></math></p></div><div class="ltx_flex_break"></div><div class="ltx_flex_cell ltx_flex_size_1">
<p id="algorithm1.6" class="ltx_p ltx_figure_panel"><span id="algorithm1.6.1" class="ltx_text ltx_font_bold">while</span> <em id="algorithm1.6.2" class="ltx_emph ltx_font_italic"><math id="algorithm1.m8" class="ltx_Math" alttext="t\leq T" display="inline" intent=":literal"><semantics><mrow><mi>t</mi><mo>≤</mo><mi>T</mi></mrow><annotation encoding="application/x-tex">t\leq T</annotation></semantics></math> <span id="algorithm1.6.2.1" class="ltx_text ltx_font_upright">and</span> <math id="algorithm1.m9" class="ltx_Math" alttext="\left\|\left[f_{\theta^{t}}(\bm{S}_{i})-f^{*}(\bm{S}_{i})\right]_{N}\right\|_{\mathcal{F}}\geq\epsilon" display="inline" intent=":literal"><semantics><mrow><msub><mrow><mo>‖</mo><msub><mrow><mo>[</mo><mrow><mrow><msub><mi>f</mi><msup><mi>θ</mi><mi>t</mi></msup></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐒</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msup><mi>f</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐒</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>]</mo></mrow><mi>N</mi></msub><mo>‖</mo></mrow><mi class="ltx_font_mathcaligraphic">ℱ</mi></msub><mo>≥</mo><mi>ϵ</mi></mrow><annotation encoding="application/x-tex">\left\|\left[f_{\theta^{t}}(\bm{S}_{i})-f^{*}(\bm{S}_{i})\right]_{N}\right\|_{\mathcal{F}}\geq\epsilon</annotation></semantics></math></em> <span id="algorithm1.6.3" class="ltx_text ltx_font_bold">do</span></p></div><div class="ltx_flex_break"></div>
<div id="algorithm1.7" class="ltx_listingline"> <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span> <span id="algorithm1.7.1" class="ltx_text ltx_font_bold">The teacher</span> selects <math id="algorithm1.m10" class="ltx_Math" alttext="m" display="inline" intent=":literal"><semantics><mi>m</mi><annotation encoding="application/x-tex">m</annotation></semantics></math> teaching sequences:
<span id="algorithm1.7.2" class="ltx_text ltx_font_typewriter">/* </span><span id="algorithm1.7.3" class="ltx_text ltx_font_typewriter">Sequences associated with the <math id="algorithm1.m11" class="ltx_Math" alttext="m" display="inline" intent=":literal"><semantics><mi>m</mi><annotation encoding="application/x-tex">m</annotation></semantics></math> largest <math id="algorithm1.m12" class="ltx_Math" alttext="\|f_{\theta^{t}}(\bm{S}_{i})-f^{*}(\bm{S}_{i})\|_{2}" display="inline" intent=":literal"><semantics><msub><mrow><mo stretchy="false">‖</mo><mrow><mrow><msub><mi>f</mi><msup><mi>θ</mi><mi>t</mi></msup></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝑺</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msup><mi>f</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝑺</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn></msub><annotation encoding="application/x-tex">\|f_{\theta^{t}}(\bm{S}_{i})-f^{*}(\bm{S}_{i})\|_{2}</annotation></semantics></math>  */<math id="algorithm1.m13" class="ltx_Math" alttext="{\{\bm{S}_{i}\}_{m}}^{*}=\underset{\{\bm{S}_{i}\}_{m}\subseteq\{\bm{S}_{i}\}_{N}}{\arg\max}\left\|\left[f_{\theta^{t}}(\bm{S}_{i})-f^{*}(\bm{S}_{i})\right]_{m}\right\|_{\mathcal{F}}" display="inline" intent=":literal"><semantics><mrow><mmultiscripts><mrow><mo stretchy="false">{</mo><msub><mi>𝑺</mi><mi>i</mi></msub><mo stretchy="false">}</mo></mrow><mi>m</mi><mrow></mrow><mrow></mrow><mo>∗</mo></mmultiscripts><mo>=</mo><mrow><munder accentunder="true"><mrow><mi>arg</mi><mo lspace="0.167em">⁡</mo><mi>max</mi></mrow><mrow><msub><mrow><mo stretchy="false">{</mo><msub><mi mathsize="0.700em">𝑺</mi><mi mathsize="0.710em">i</mi></msub><mo stretchy="false">}</mo></mrow><mi mathsize="0.710em">m</mi></msub><mo mathsize="0.700em">⊆</mo><msub><mrow><mo stretchy="false">{</mo><msub><mi mathsize="0.700em">𝑺</mi><mi mathsize="0.710em">i</mi></msub><mo stretchy="false">}</mo></mrow><mi mathsize="0.710em">N</mi></msub></mrow></munder><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo>‖</mo><msub><mrow><mo>[</mo><mrow><mrow><msub><mi>f</mi><msup><mi>θ</mi><mi>t</mi></msup></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝑺</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msup><mi>f</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝑺</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>]</mo></mrow><mi>m</mi></msub><mo>‖</mo></mrow><mi class="ltx_font_mathcaligraphic">ℱ</mi></msub></mrow></mrow><annotation encoding="application/x-tex">{\{\bm{S}_{i}\}_{m}}^{*}=\underset{\{\bm{S}_{i}\}_{m}\subseteq\{\bm{S}_{i}\}_{N}}{\arg\max}\left\|\left[f_{\theta^{t}}(\bm{S}_{i})-f^{*}(\bm{S}_{i})\right]_{m}\right\|_{\mathcal{F}}</annotation></semantics></math></span>
Provide <math id="algorithm1.m14" class="ltx_Math" alttext="{\{\bm{S}_{i}\}_{m}}^{*}" display="inline" intent=":literal"><semantics><mmultiscripts><mrow><mo stretchy="false">{</mo><msub><mi>𝑺</mi><mi>i</mi></msub><mo stretchy="false">}</mo></mrow><mi>m</mi><mrow></mrow><mrow></mrow><mo>∗</mo></mmultiscripts><annotation encoding="application/x-tex">{\{\bm{S}_{i}\}_{m}}^{*}</annotation></semantics></math> to the attention learner
<span id="algorithm1.7.4" class="ltx_text ltx_font_bold">The learner</span> updates <math id="algorithm1.m15" class="ltx_Math" alttext="f_{\theta^{t}}" display="inline" intent=":literal"><semantics><msub><mi>f</mi><msup><mi>θ</mi><mi>t</mi></msup></msub><annotation encoding="application/x-tex">f_{\theta^{t}}</annotation></semantics></math> based on received <math id="algorithm1.m16" class="ltx_Math" alttext="{\{\bm{S}_{i}\}_{m}}^{*}" display="inline" intent=":literal"><semantics><mmultiscripts><mrow><mo stretchy="false">{</mo><msub><mi>𝑺</mi><mi>i</mi></msub><mo stretchy="false">}</mo></mrow><mi>m</mi><mrow></mrow><mrow></mrow><mo>∗</mo></mmultiscripts><annotation encoding="application/x-tex">{\{\bm{S}_{i}\}_{m}}^{*}</annotation></semantics></math>:
<span id="algorithm1.7.5" class="ltx_text ltx_font_typewriter">// </span><span id="algorithm1.7.6" class="ltx_text ltx_font_typewriter">Parameter-based gradient descent <math id="algorithm1.m17" class="ltx_math_unparsed" alttext="\theta^{t}\leftarrow\theta^{t}-\frac{\eta}{mS}\sum_{\bm{S}_{i}\in{\{\bm{S}_{i}\}_{m}}^{*}}\sum_{j=1}^{S}\nabla_{\theta}\mathcal{L}({f_{\theta^{t}}(\bm{S}_{i})}_{(j,:)},{f^{*}(\bm{S}_{i})}_{(j,:)})" display="inline" intent=":literal"><semantics><mrow><msup><mi>θ</mi><mi>t</mi></msup><mo stretchy="false">←</mo><msup><mi>θ</mi><mi>t</mi></msup><mo>−</mo><mfrac><mi>η</mi><mrow><mi>m</mi><mo lspace="0em" rspace="0em">​</mo><mi>S</mi></mrow></mfrac><msub><mo rspace="0em">∑</mo><mrow><msub><mi>𝑺</mi><mi>i</mi></msub><mo>∈</mo><mmultiscripts><mrow><mo stretchy="false">{</mo><msub><mi>𝑺</mi><mi>i</mi></msub><mo stretchy="false">}</mo></mrow><mi>m</mi><mrow></mrow><mrow></mrow><mo>∗</mo></mmultiscripts></mrow></msub><msubsup><mo>∑</mo><mrow><mi>j</mi><mo>=</mo><mn>1</mn></mrow><mi>S</mi></msubsup><msub><mo rspace="0.167em">∇</mo><mi>θ</mi></msub><mi class="ltx_font_mathcaligraphic">ℒ</mi><mrow><mo stretchy="false">(</mo><msub><mi>f</mi><msup><mi>θ</mi><mi>t</mi></msup></msub><msub><mrow><mo stretchy="false">(</mo><msub><mi>𝑺</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow><mrow><mo stretchy="false">(</mo><mi>j</mi><mo>,</mo><mo rspace="0em">:</mo><mo stretchy="false">)</mo></mrow></msub><mo>,</mo><msup><mi>f</mi><mo>∗</mo></msup><msub><mrow><mo stretchy="false">(</mo><msub><mi>𝑺</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow><mrow><mo stretchy="false">(</mo><mi>j</mi><mo>,</mo><mo rspace="0em">:</mo><mo stretchy="false">)</mo></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\theta^{t}\leftarrow\theta^{t}-\frac{\eta}{mS}\sum_{\bm{S}_{i}\in{\{\bm{S}_{i}\}_{m}}^{*}}\sum_{j=1}^{S}\nabla_{\theta}\mathcal{L}({f_{\theta^{t}}(\bm{S}_{i})}_{(j,:)},{f^{*}(\bm{S}_{i})}_{(j,:)})</annotation></semantics></math></span>
Set <math id="algorithm1.m18" class="ltx_Math" alttext="t\leftarrow t+1" display="inline" intent=":literal"><semantics><mrow><mi>t</mi><mo stretchy="false">←</mo><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow></mrow><annotation encoding="application/x-tex">t\leftarrow t+1</annotation></semantics></math>

</div><div class="ltx_flex_break"></div><div class="ltx_flex_cell ltx_flex_size_2">
<div id="algorithm1.8" class="ltx_listingline ltx_figure_panel">end while
</div></div><div class="ltx_flex_cell ltx_flex_size_2">
<div id="algorithm1.9" class="ltx_listingline ltx_figure_panel">
</div></div></div>
</figure>
