<td class="ltx_td ltx_align_center ltx_eqn_cell"><math id="A2.Ex66.m2" class="ltx_Math" alttext="\displaystyle\leq" display="inline" intent=":literal"><semantics><mo>≤</mo><annotation encoding="application/x-tex">\displaystyle\leq</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex66.m3" class="ltx_Math" alttext="\displaystyle-\frac{3\eta}{4NS}\underbrace{\left[\partial_{f_{\theta^{t}}}\mathcal{L}(f_{\theta^{t}};\bm{S}_{i})\right]^{\top}_{N}\bar{\bm{K}}\left[\partial_{f_{\theta^{t}}}\mathcal{L}(f_{\theta^{t}};\bm{S}_{i})\right]_{N}}_{\Phi}" display="inline" intent=":literal"><semantics><mrow><mo>−</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mn>3</mn><mo lspace="0em" rspace="0em">​</mo><mi>η</mi></mrow><mrow><mn>4</mn><mo lspace="0em" rspace="0em">​</mo><mi>N</mi><mo lspace="0em" rspace="0em">​</mo><mi>S</mi></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><munder><munder accentunder="true"><mrow><msubsup><mrow><mo>[</mo><mrow><msub><mo lspace="0em">∂</mo><msub><mi>f</mi><msup><mi>θ</mi><mi>t</mi></msup></msub></msub><mrow><mi class="ltx_font_mathcaligraphic">ℒ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>f</mi><msup><mi>θ</mi><mi>t</mi></msup></msub><mo>,</mo><msub><mi>𝑺</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>]</mo></mrow><mi>N</mi><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mover accent="true"><mi>𝑲</mi><mo>¯</mo></mover><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo>[</mo><mrow><msub><mo lspace="0em">∂</mo><msub><mi>f</mi><msup><mi>θ</mi><mi>t</mi></msup></msub></msub><mrow><mi class="ltx_font_mathcaligraphic">ℒ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>f</mi><msup><mi>θ</mi><mi>t</mi></msup></msub><mo>,</mo><msub><mi>𝑺</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>]</mo></mrow><mi>N</mi></msub></mrow><mo stretchy="true">⏟</mo></munder><mi mathvariant="normal">Φ</mi></munder></mrow></mrow><annotation encoding="application/x-tex">\displaystyle-\frac{3\eta}{4NS}\underbrace{\left[\partial_{f_{\theta^{t}}}\mathcal{L}(f_{\theta^{t}};\bm{S}_{i})\right]^{\top}_{N}\bar{\bm{K}}\left[\partial_{f_{\theta^{t}}}\mathcal{L}(f_{\theta^{t}};\bm{S}_{i})\right]_{N}}_{\Phi}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr>
<tr class="ltx_eqn_row ltx_align_baseline">
