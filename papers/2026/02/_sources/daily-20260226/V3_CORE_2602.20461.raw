<td rowspan="4" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(71)</span></td></tr>
<tr class="ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_center ltx_eqn_cell"><math id="A2.Ex77.m1" class="ltx_Math" alttext="\displaystyle\leq" display="inline" intent=":literal"><semantics><mo>≤</mo><annotation encoding="application/x-tex">\displaystyle\leq</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex77.m2" class="ltx_math_unparsed" alttext="\displaystyle{\eta}^{2}\tau^{2}\left[\frac{\gamma}{NS}\sum_{i=1}^{N}\sum_{j=1}^{S}\partial_{f_{\theta^{t}}}\mathcal{L}(f_{\theta^{t}};{\bm{S}_{i}}_{(j,:)})\right]^{\top}\cdot\bar{\bm{K}}\cdot\left[\frac{\gamma}{NS}\sum_{i=1}^{N}\sum_{j=1}^{S}\partial_{f_{\theta^{t}}}\mathcal{L}(f_{\theta^{t}};{\bm{S}_{i}}_{(j,:)})\right]_{N}" display="inline" intent=":literal"><semantics><mrow><msup><mi>η</mi><mn>2</mn></msup><msup><mi>τ</mi><mn>2</mn></msup><msup><mrow><mo>[</mo><mstyle displaystyle="true"><mfrac><mi>γ</mi><mrow><mi>N</mi><mo lspace="0em" rspace="0em">​</mo><mi>S</mi></mrow></mfrac></mstyle><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>N</mi></munderover></mstyle><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>j</mi><mo>=</mo><mn>1</mn></mrow><mi>S</mi></munderover></mstyle><msub><mo lspace="0em">∂</mo><msub><mi>f</mi><msup><mi>θ</mi><mi>t</mi></msup></msub></msub><mi class="ltx_font_mathcaligraphic">ℒ</mi><mrow><mo stretchy="false">(</mo><msub><mi>f</mi><msup><mi>θ</mi><mi>t</mi></msup></msub><mo>;</mo><mmultiscripts><mi>𝑺</mi><mi>i</mi><mrow></mrow><mrow><mo stretchy="false">(</mo><mi>j</mi><mo>,</mo><mo rspace="0em">:</mo><mo stretchy="false">)</mo></mrow><mrow></mrow></mmultiscripts><mo stretchy="false">)</mo></mrow><mo rspace="0.055em">]</mo></mrow><mo>⊤</mo></msup><mo rspace="0.222em">⋅</mo><mover accent="true"><mi>𝑲</mi><mo>¯</mo></mover><mo lspace="0.222em" rspace="0.222em">⋅</mo><msub><mrow><mo>[</mo><mstyle displaystyle="true"><mfrac><mi>γ</mi><mrow><mi>N</mi><mo lspace="0em" rspace="0em">​</mo><mi>S</mi></mrow></mfrac></mstyle><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>N</mi></munderover></mstyle><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>j</mi><mo>=</mo><mn>1</mn></mrow><mi>S</mi></munderover></mstyle><msub><mo lspace="0em">∂</mo><msub><mi>f</mi><msup><mi>θ</mi><mi>t</mi></msup></msub></msub><mi class="ltx_font_mathcaligraphic">ℒ</mi><mrow><mo stretchy="false">(</mo><msub><mi>f</mi><msup><mi>θ</mi><mi>t</mi></msup></msub><mo>;</mo><mmultiscripts><mi>𝑺</mi><mi>i</mi><mrow></mrow><mrow><mo stretchy="false">(</mo><mi>j</mi><mo>,</mo><mo rspace="0em">:</mo><mo stretchy="false">)</mo></mrow><mrow></mrow></mmultiscripts><mo stretchy="false">)</mo></mrow><mo>]</mo></mrow><mi>N</mi></msub></mrow><annotation encoding="application/x-tex">\displaystyle{\eta}^{2}\tau^{2}\left[\frac{\gamma}{NS}\sum_{i=1}^{N}\sum_{j=1}^{S}\partial_{f_{\theta^{t}}}\mathcal{L}(f_{\theta^{t}};{\bm{S}_{i}}_{(j,:)})\right]^{\top}\cdot\bar{\bm{K}}\cdot\left[\frac{\gamma}{NS}\sum_{i=1}^{N}\sum_{j=1}^{S}\partial_{f_{\theta^{t}}}\mathcal{L}(f_{\theta^{t}};{\bm{S}_{i}}_{(j,:)})\right]_{N}</annotation></semantics></math></td>
