<td id="S4.T1.5.3.6" class="ltx_td ltx_align_center"><math id="S4.T1.m12" class="ltx_Math" alttext="1.03\pm 0.00" display="inline" intent=":literal"><semantics><mrow><mn>1.03</mn><mo>±</mo><mn>0.00</mn></mrow><annotation encoding="application/x-tex">1.03\pm 0.00</annotation></semantics></math></td>
<td id="S4.T1.5.3.7" class="ltx_td ltx_align_center"><math id="S4.T1.m13" class="ltx_Math" alttext="1.08\pm 0.01" display="inline" intent=":literal"><semantics><mrow><mn>1.08</mn><mo>±</mo><mn>0.01</mn></mrow><annotation encoding="application/x-tex">1.08\pm 0.01</annotation></semantics></math></td>
<td id="S4.T1.5.3.8" class="ltx_td ltx_align_center"><math id="S4.T1.m14" class="ltx_Math" alttext="1.05\pm 0.02" display="inline" intent=":literal"><semantics><mrow><mn>1.05</mn><mo>±</mo><mn>0.02</mn></mrow><annotation encoding="application/x-tex">1.05\pm 0.02</annotation></semantics></math></td></tr>
<tr id="S4.T1.5.4" class="ltx_tr">
<th id="S4.T1.5.4.1" class="ltx_td ltx_align_left ltx_th ltx_th_row">10%</th>
<td id="S4.T1.5.4.2" class="ltx_td ltx_align_center"><math id="S4.T1.m15" class="ltx_Math" alttext="1.26\pm 0.04" display="inline" intent=":literal"><semantics><mrow><mn>1.26</mn><mo>±</mo><mn>0.04</mn></mrow><annotation encoding="application/x-tex">1.26\pm 0.04</annotation></semantics></math></td>
<td id="S4.T1.5.4.3" class="ltx_td ltx_align_center"><math id="S4.T1.m16" class="ltx_Math" alttext="1.06\pm 0.02" display="inline" intent=":literal"><semantics><mrow><mn>1.06</mn><mo>±</mo><mn>0.02</mn></mrow><annotation encoding="application/x-tex">1.06\pm 0.02</annotation></semantics></math></td>
<td id="S4.T1.5.4.4" class="ltx_td ltx_align_center"><math id="S4.T1.m17" class="ltx_Math" alttext="1.27\pm 0.04" display="inline" intent=":literal"><semantics><mrow><mn>1.27</mn><mo>±</mo><mn>0.04</mn></mrow><annotation encoding="application/x-tex">1.27\pm 0.04</annotation></semantics></math></td>
<td id="S4.T1.5.4.5" class="ltx_td ltx_align_center"><math id="S4.T1.m18" class="ltx_Math" alttext="0.94\pm 0.02" display="inline" intent=":literal"><semantics><mrow><mn>0.94</mn><mo>±</mo><mn>0.02</mn></mrow><annotation encoding="application/x-tex">0.94\pm 0.02</annotation></semantics></math></td>
<td id="S4.T1.5.4.6" class="ltx_td ltx_align_center"><math id="S4.T1.m19" class="ltx_Math" alttext="1.10\pm 0.02" display="inline" intent=":literal"><semantics><mrow><mn>1.10</mn><mo>±</mo><mn>0.02</mn></mrow><annotation encoding="application/x-tex">1.10\pm 0.02</annotation></semantics></math></td>
<td id="S4.T1.5.4.7" class="ltx_td ltx_align_center"><math id="S4.T1.m20" class="ltx_Math" alttext="1.13\pm 0.02" display="inline" intent=":literal"><semantics><mrow><mn>1.13</mn><mo>±</mo><mn>0.02</mn></mrow><annotation encoding="application/x-tex">1.13\pm 0.02</annotation></semantics></math></td>
<td id="S4.T1.5.4.8" class="ltx_td ltx_align_center"><math id="S4.T1.m21" class="ltx_Math" alttext="1.12\pm 0.01" display="inline" intent=":literal"><semantics><mrow><mn>1.12</mn><mo>±</mo><mn>0.01</mn></mrow><annotation encoding="application/x-tex">1.12\pm 0.01</annotation></semantics></math></td></tr>
<tr id="S4.T1.5.5" class="ltx_tr">
<th id="S4.T1.5.5.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_bb">50%</th>
<td id="S4.T1.5.5.2" class="ltx_td ltx_align_center ltx_border_bb"><math id="S4.T1.m22" class="ltx_Math" alttext="1.45\pm 0.03" display="inline" intent=":literal"><semantics><mrow><mn>1.45</mn><mo>±</mo><mn>0.03</mn></mrow><annotation encoding="application/x-tex">1.45\pm 0.03</annotation></semantics></math></td>
<td id="S4.T1.5.5.3" class="ltx_td ltx_align_center ltx_border_bb"><math id="S4.T1.m23" class="ltx_Math" alttext="1.22\pm 0.05" display="inline" intent=":literal"><semantics><mrow><mn>1.22</mn><mo>±</mo><mn>0.05</mn></mrow><annotation encoding="application/x-tex">1.22\pm 0.05</annotation></semantics></math></td>
<td id="S4.T1.5.5.4" class="ltx_td ltx_align_center ltx_border_bb"><math id="S4.T1.m24" class="ltx_Math" alttext="1.42\pm 0.08" display="inline" intent=":literal"><semantics><mrow><mn>1.42</mn><mo>±</mo><mn>0.08</mn></mrow><annotation encoding="application/x-tex">1.42\pm 0.08</annotation></semantics></math></td>
<td id="S4.T1.5.5.5" class="ltx_td ltx_align_center ltx_border_bb"><math id="S4.T1.m25" class="ltx_Math" alttext="1.09\pm 0.07" display="inline" intent=":literal"><semantics><mrow><mn>1.09</mn><mo>±</mo><mn>0.07</mn></mrow><annotation encoding="application/x-tex">1.09\pm 0.07</annotation></semantics></math></td>
<td id="S4.T1.5.5.6" class="ltx_td ltx_align_center ltx_border_bb"><math id="S4.T1.m26" class="ltx_Math" alttext="1.21\pm 0.04" display="inline" intent=":literal"><semantics><mrow><mn>1.21</mn><mo>±</mo><mn>0.04</mn></mrow><annotation encoding="application/x-tex">1.21\pm 0.04</annotation></semantics></math></td>
<td id="S4.T1.5.5.7" class="ltx_td ltx_align_center ltx_border_bb"><math id="S4.T1.m27" class="ltx_Math" alttext="1.31\pm 0.11" display="inline" intent=":literal"><semantics><mrow><mn>1.31</mn><mo>±</mo><mn>0.11</mn></mrow><annotation encoding="application/x-tex">1.31\pm 0.11</annotation></semantics></math></td>
<td id="S4.T1.5.5.8" class="ltx_td ltx_align_center ltx_border_bb"><math id="S4.T1.m28" class="ltx_Math" alttext="1.27\pm 0.02" display="inline" intent=":literal"><semantics><mrow><mn>1.27</mn><mo>±</mo><mn>0.02</mn></mrow><annotation encoding="application/x-tex">1.27\pm 0.02</annotation></semantics></math></td></tr>
</tbody>
</table>
