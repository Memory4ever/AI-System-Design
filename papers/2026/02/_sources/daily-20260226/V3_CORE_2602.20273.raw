</span></span></span></foreignObject></g><g fill-opacity="1.0" transform="matrix(1.0 0.0 0.0 1.0 16.44 12.5)"><foreignObject style="--ltx-fo-width:15.33em;--ltx-fo-height:5.89em;--ltx-fo-depth:0em;font-size:10pt;" height="81.54" overflow="visible" transform="matrix(1 0 0 -1 0 81.54)" width="212.12"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content">
<span id="A1.SS1.SSS0.Px3.p3.pic1.2" class="ltx_inline-block ltx_minipage ltx_align_bottom" style="width:15.33em;">
<span id="A1.SS1.SSS0.Px3.p3.pic1.2.1" class="ltx_p"><span id="A1.SS1.SSS0.Px3.p3.pic1.2.1.1" class="ltx_text ltx_font_bold" style="font-size:90%;--ltx-fg-color:#000000;">User:<span id="A1.SS1.SSS0.Px3.p3.pic1.2.1.1.1" class="ltx_text ltx_font_medium"> <span id="A1.SS1.SSS0.Px3.p3.pic1.2.1.1.1.1" class="ltx_text ltx_font_italic">[Description of an action]</span> 
<br class="ltx_break" style="--ltx-break-space:5.7pt;">
</span>Assistant:<span id="A1.SS1.SSS0.Px3.p3.pic1.2.1.1.2" class="ltx_text ltx_font_medium"> ”This is wrong.” / ”This is not wrong.”</span></span></span>
</span></span></span></foreignObject></g></g></svg></span>
</div>
          
</div></div></div>
</figure>
<figure id="A1.T1" class="ltx_table">
<table id="A1.T1.3" class="ltx_tabular ltx_centering ltx_guessed_headers ltx_align_middle">
<thead class="ltx_thead">
<tr id="A1.T1.3.1" class="ltx_tr">
<th id="A1.T1.3.1.1" class="ltx_td ltx_align_left ltx_th ltx_th_column ltx_th_row ltx_border_tt"><span id="A1.T1.3.1.1.1" class="ltx_text ltx_font_bold" style="font-size:90%;">Truth Type</span></th>
<th id="A1.T1.3.1.2" class="ltx_td ltx_align_left ltx_th ltx_th_column ltx_th_row ltx_border_tt"><span id="A1.T1.3.1.2.1" class="ltx_text ltx_font_bold" style="font-size:90%;">Negation Type</span></th>
<th id="A1.T1.3.1.3" class="ltx_td ltx_align_left ltx_th ltx_th_column ltx_border_tt">
<span id="A1.T1.3.1.3.1" class="ltx_inline-block ltx_align_top">
<span id="A1.T1.3.1.3.1.1" class="ltx_p"><span id="A1.T1.3.1.3.1.1.1" class="ltx_text ltx_font_bold" style="font-size:90%;">Original Claim</span></span>
</span></th>
<th id="A1.T1.3.1.4" class="ltx_td ltx_nopad_r ltx_align_left ltx_th ltx_th_column ltx_border_tt">
<span id="A1.T1.3.1.4.1" class="ltx_inline-block ltx_align_top">
<span id="A1.T1.3.1.4.1.1" class="ltx_p"><span id="A1.T1.3.1.4.1.1.1" class="ltx_text ltx_font_bold" style="font-size:90%;">Negated Claim</span></span>
</span></th></tr>
</thead>
<tbody class="ltx_tbody">
<tr id="A1.T1.3.2" class="ltx_tr">
<th id="A1.T1.3.2.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_t"><span id="A1.T1.3.2.1.1" class="ltx_text ltx_font_bold" style="font-size:90%;">Empirical</span></th>
<th id="A1.T1.3.2.2" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_t"><span id="A1.T1.3.2.2.1" class="ltx_text" style="font-size:90%;">Direct Negation</span></th>
<td id="A1.T1.3.2.3" class="ltx_td ltx_align_left ltx_border_t">
<span id="A1.T1.3.2.3.1" class="ltx_inline-block ltx_align_top">
<span id="A1.T1.3.2.3.1.1" class="ltx_p"><span id="A1.T1.3.2.3.1.1.1" class="ltx_text" style="font-size:90%;">Gravity is the force that keeps planets in orbit around the Sun.</span></span>
</span></td>
<td id="A1.T1.3.2.4" class="ltx_td ltx_nopad_r ltx_align_left ltx_border_t">
<span id="A1.T1.3.2.4.1" class="ltx_inline-block ltx_align_top">
<span id="A1.T1.3.2.4.1.1" class="ltx_p"><span id="A1.T1.3.2.4.1.1.1" class="ltx_text" style="font-size:90%;">Gravity is not the force that keeps planets in orbit around the Sun.</span></span>
</span></td></tr>
<tr id="A1.T1.3.3" class="ltx_tr">
<th id="A1.T1.3.3.1" class="ltx_td ltx_th ltx_th_row"></th>
<th id="A1.T1.3.3.2" class="ltx_td ltx_align_left ltx_th ltx_th_row"><span id="A1.T1.3.3.2.1" class="ltx_text" style="font-size:90%;">Quantity Change</span></th>
<td id="A1.T1.3.3.3" class="ltx_td ltx_align_left">
<span id="A1.T1.3.3.3.1" class="ltx_inline-block ltx_align_top">
<span id="A1.T1.3.3.3.1.1" class="ltx_p"><span id="A1.T1.3.3.3.1.1.1" class="ltx_text" style="font-size:90%;">Humans have 23 pairs of chromosomes.</span></span>
</span></td>
<td id="A1.T1.3.3.4" class="ltx_td ltx_nopad_r ltx_align_left">
<span id="A1.T1.3.3.4.1" class="ltx_inline-block ltx_align_top">
<span id="A1.T1.3.3.4.1.1" class="ltx_p"><span id="A1.T1.3.3.4.1.1.1" class="ltx_text" style="font-size:90%;">Humans have 24 pairs of chromosomes.</span></span>
</span></td></tr>
<tr id="A1.T1.3.4" class="ltx_tr">
<th id="A1.T1.3.4.1" class="ltx_td ltx_th ltx_th_row"></th>
<th id="A1.T1.3.4.2" class="ltx_td ltx_align_left ltx_th ltx_th_row"><span id="A1.T1.3.4.2.1" class="ltx_text" style="font-size:90%;">Information Substitution</span></th>
<td id="A1.T1.3.4.3" class="ltx_td ltx_align_left">
<span id="A1.T1.3.4.3.1" class="ltx_inline-block ltx_align_top">
<span id="A1.T1.3.4.3.1.1" class="ltx_p"><span id="A1.T1.3.4.3.1.1.1" class="ltx_text" style="font-size:90%;">Paris is the capital of France.</span></span>
</span></td>
<td id="A1.T1.3.4.4" class="ltx_td ltx_nopad_r ltx_align_left">
<span id="A1.T1.3.4.4.1" class="ltx_inline-block ltx_align_top">
<span id="A1.T1.3.4.4.1.1" class="ltx_p"><span id="A1.T1.3.4.4.1.1.1" class="ltx_text" style="font-size:90%;">Berlin is the capital of France.</span></span>
</span></td></tr>
<tr id="A1.T1.3.5" class="ltx_tr">
<th id="A1.T1.3.5.1" class="ltx_td ltx_align_left ltx_th ltx_th_row"><span id="A1.T1.3.5.1.1" class="ltx_text ltx_font_bold" style="font-size:90%;">Definitional</span></th>
<th id="A1.T1.3.5.2" class="ltx_td ltx_align_left ltx_th ltx_th_row"><span id="A1.T1.3.5.2.1" class="ltx_text" style="font-size:90%;">Direct Negation</span></th>
<td id="A1.T1.3.5.3" class="ltx_td ltx_align_left">
<span id="A1.T1.3.5.3.1" class="ltx_inline-block ltx_align_top">
<span id="A1.T1.3.5.3.1.1" class="ltx_p"><span id="A1.T1.3.5.3.1.1.1" class="ltx_text" style="font-size:90%;">An alphabet is a standard set of letters used to write a language.</span></span>
</span></td>
<td id="A1.T1.3.5.4" class="ltx_td ltx_nopad_r ltx_align_left">
<span id="A1.T1.3.5.4.1" class="ltx_inline-block ltx_align_top">
<span id="A1.T1.3.5.4.1.1" class="ltx_p"><span id="A1.T1.3.5.4.1.1.1" class="ltx_text" style="font-size:90%;">An alphabet is not a standard set of letters used to write a language</span></span>
</span></td></tr>
<tr id="A1.T1.3.6" class="ltx_tr">
<th id="A1.T1.3.6.1" class="ltx_td ltx_th ltx_th_row"></th>
<th id="A1.T1.3.6.2" class="ltx_td ltx_align_left ltx_th ltx_th_row"><span id="A1.T1.3.6.2.1" class="ltx_text" style="font-size:90%;">Quantity Change</span></th>
<td id="A1.T1.3.6.3" class="ltx_td ltx_align_left">
