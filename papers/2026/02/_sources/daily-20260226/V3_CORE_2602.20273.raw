<span id="A1.T1.3.7.4.1.1" class="ltx_p"><span id="A1.T1.3.7.4.1.1.1" class="ltx_text" style="font-size:90%;">Water is a chemical compound with the formula CO</span><sub id="A1.T1.3.7.4.1.1.2" class="ltx_sub"><span id="A1.T1.3.7.4.1.1.2.1" class="ltx_text" style="font-size:90%;">2</span></sub><span id="A1.T1.3.7.4.1.1.3" class="ltx_text" style="font-size:90%;">.</span></span>
</span></td></tr>
<tr id="A1.T1.3.8" class="ltx_tr">
<th id="A1.T1.3.8.1" class="ltx_td ltx_align_left ltx_th ltx_th_row"><span id="A1.T1.3.8.1.1" class="ltx_text ltx_font_bold" style="font-size:90%;">Logical</span></th>
<th id="A1.T1.3.8.2" class="ltx_td ltx_align_left ltx_th ltx_th_row"><span id="A1.T1.3.8.2.1" class="ltx_text" style="font-size:90%;">Direct Negation</span></th>
<td id="A1.T1.3.8.3" class="ltx_td ltx_align_left">
<span id="A1.T1.3.8.3.1" class="ltx_inline-block ltx_align_top">
<span id="A1.T1.3.8.3.1.1" class="ltx_p"><span id="A1.T1.3.8.3.1.1.1" class="ltx_text" style="font-size:90%;">If </span><math id="A1.T1.m3" class="ltx_Math" alttext="a=b" display="inline" intent=":literal"><semantics><mrow><mi mathsize="0.900em">a</mi><mo mathsize="0.900em">=</mo><mi mathsize="0.900em">b</mi></mrow><annotation encoding="application/x-tex">a=b</annotation></semantics></math><span id="A1.T1.3.8.3.1.1.2" class="ltx_text" style="font-size:90%;"> and </span><math id="A1.T1.m4" class="ltx_Math" alttext="b=c" display="inline" intent=":literal"><semantics><mrow><mi mathsize="0.900em">b</mi><mo mathsize="0.900em">=</mo><mi mathsize="0.900em">c</mi></mrow><annotation encoding="application/x-tex">b=c</annotation></semantics></math><span id="A1.T1.3.8.3.1.1.3" class="ltx_text" style="font-size:90%;">, then </span><math id="A1.T1.m5" class="ltx_Math" alttext="a" display="inline" intent=":literal"><semantics><mi mathsize="0.900em">a</mi><annotation encoding="application/x-tex">a</annotation></semantics></math><span id="A1.T1.3.8.3.1.1.4" class="ltx_text" style="font-size:90%;"> equals </span><math id="A1.T1.m6" class="ltx_Math" alttext="c" display="inline" intent=":literal"><semantics><mi mathsize="0.900em">c</mi><annotation encoding="application/x-tex">c</annotation></semantics></math><span id="A1.T1.3.8.3.1.1.5" class="ltx_text" style="font-size:90%;">.</span></span>
</span></td>
<td id="A1.T1.3.8.4" class="ltx_td ltx_nopad_r ltx_align_left">
<span id="A1.T1.3.8.4.1" class="ltx_inline-block ltx_align_top">
<span id="A1.T1.3.8.4.1.1" class="ltx_p"><span id="A1.T1.3.8.4.1.1.1" class="ltx_text" style="font-size:90%;">If </span><math id="A1.T1.m7" class="ltx_Math" alttext="a=b" display="inline" intent=":literal"><semantics><mrow><mi mathsize="0.900em">a</mi><mo mathsize="0.900em">=</mo><mi mathsize="0.900em">b</mi></mrow><annotation encoding="application/x-tex">a=b</annotation></semantics></math><span id="A1.T1.3.8.4.1.1.2" class="ltx_text" style="font-size:90%;"> and </span><math id="A1.T1.m8" class="ltx_Math" alttext="b=c" display="inline" intent=":literal"><semantics><mrow><mi mathsize="0.900em">b</mi><mo mathsize="0.900em">=</mo><mi mathsize="0.900em">c</mi></mrow><annotation encoding="application/x-tex">b=c</annotation></semantics></math><span id="A1.T1.3.8.4.1.1.3" class="ltx_text" style="font-size:90%;">, then </span><math id="A1.T1.m9" class="ltx_Math" alttext="a" display="inline" intent=":literal"><semantics><mi mathsize="0.900em">a</mi><annotation encoding="application/x-tex">a</annotation></semantics></math><span id="A1.T1.3.8.4.1.1.4" class="ltx_text" style="font-size:90%;"> never equals </span><math id="A1.T1.m10" class="ltx_Math" alttext="c" display="inline" intent=":literal"><semantics><mi mathsize="0.900em">c</mi><annotation encoding="application/x-tex">c</annotation></semantics></math><span id="A1.T1.3.8.4.1.1.5" class="ltx_text" style="font-size:90%;">.</span></span>
</span></td></tr>
