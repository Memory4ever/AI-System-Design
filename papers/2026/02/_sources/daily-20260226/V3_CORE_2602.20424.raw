<td id="S7.T2.2.1.3" class="ltx_td ltx_align_center ltx_border_r ltx_border_tt"><span id="S7.T2.2.1.3.1" class="ltx_text ltx_font_bold">NSS (%)<math id="S7.T2.m2" class="ltx_Math" alttext="\uparrow" display="inline" intent=":literal"><semantics><mo stretchy="false">↑</mo><annotation encoding="application/x-tex">\uparrow</annotation></semantics></math></span></td>
