<td id="S7.T2.2.4.3" class="ltx_td ltx_align_center ltx_border_r"><span id="S7.T2.2.4.3.1" class="ltx_text" style="--ltx-bg-color:#FFFFFF;">71.4<sub id="S7.T2.2.4.3.1.1" class="ltx_sub"><span id="S7.T2.2.4.3.1.1.1" class="ltx_text ltx_font_italic">±4.2</span></sub></span></td>
