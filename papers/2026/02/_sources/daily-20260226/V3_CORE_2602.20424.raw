<td id="S7.T2.2.6.1" class="ltx_td ltx_align_left"><span id="S7.T2.2.6.1.1" class="ltx_text" style="--ltx-bg-color:#FFFFFF;">GPT-5.2</span></td>
<td id="S7.T2.2.6.2" class="ltx_td ltx_align_center"><span id="S7.T2.2.6.2.1" class="ltx_text" style="--ltx-bg-color:#FFFFFF;">33.7<sub id="S7.T2.2.6.2.1.1" class="ltx_sub"><span id="S7.T2.2.6.2.1.1.1" class="ltx_text ltx_font_italic">±6.6</span></sub></span></td>
<td id="S7.T2.2.6.3" class="ltx_td ltx_align_center ltx_border_r"><span id="S7.T2.2.6.3.1" class="ltx_text" style="--ltx-bg-color:#FFFFFF;">62.3<sub id="S7.T2.2.6.3.1.1" class="ltx_sub"><span id="S7.T2.2.6.3.1.1.1" class="ltx_text ltx_font_italic">±4.5</span></sub></span></td>
<td id="S7.T2.2.6.4" class="ltx_td ltx_align_center"><span id="S7.T2.2.6.4.1" class="ltx_text" style="--ltx-bg-color:#FFFFFF;">24.3</span></td>
<td id="S7.T2.2.6.5" class="ltx_td ltx_align_center"><span id="S7.T2.2.6.5.1" class="ltx_text" style="--ltx-bg-color:#FFFFFF;">39.3</span></td>
<td id="S7.T2.2.6.6" class="ltx_td ltx_align_center"><span id="S7.T2.2.6.6.1" class="ltx_text" style="--ltx-bg-color:#FFFFFF;">37.0</span></td>
