<td id="S4.T2.7.2.2" class="ltx_td ltx_align_center ltx_border_t"><span id="S4.T2.7.2.2.1" class="ltx_text" style="font-size:80%;">✓</span></td>
<td id="S4.T2.7.2.3" class="ltx_td ltx_align_center ltx_border_t" style="--ltx-bg-color:#D2EBFF;"><span id="S4.T2.7.2.3.1" class="ltx_text ltx_font_bold" style="font-size:80%;--ltx-bg-color:#D2EBFF;">82.91</span></td></tr>
