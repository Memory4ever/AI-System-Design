<th id="S4.T2.7.1.1" class="ltx_td ltx_align_left ltx_th ltx_th_column ltx_th_row ltx_border_tt"><span id="S4.T2.7.1.1.1" class="ltx_text" style="font-size:80%;">Model</span></th>
<th id="S4.T2.7.1.2" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt"><span id="S4.T2.7.1.2.1" class="ltx_text" style="font-size:80%;">Local crops at training</span></th>
<th id="S4.T2.7.1.3" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt"><span id="S4.T2.7.1.3.1" class="ltx_text" style="font-size:80%;">ImageNet100 (top-1<math id="S4.T2.m1" class="ltx_Math" alttext="\uparrow" display="inline" intent=":literal"><semantics><mo stretchy="false">↑</mo><annotation encoding="application/x-tex">\uparrow</annotation></semantics></math>)</span></th></tr>
</thead>
