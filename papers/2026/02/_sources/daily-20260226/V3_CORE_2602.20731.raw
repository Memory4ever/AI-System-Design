<th id="A2.T6.3.1.4" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt">Heads</th>
<th id="A2.T6.3.1.5" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt">Global Batch Size</th></tr>
</thead>
