<td id="S8.T2.2.2.5" class="ltx_td ltx_align_center ltx_border_t" style="padding:0.25pt 5.0pt;">+0.0151</td>
<td id="S8.T2.2.2.6" class="ltx_td ltx_align_center ltx_border_t" style="padding:0.25pt 5.0pt;">0.6495</td></tr>
