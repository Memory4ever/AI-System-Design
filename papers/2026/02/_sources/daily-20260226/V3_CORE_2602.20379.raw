<th id="S8.T2.2.1.5" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt" style="padding:0.25pt 5.0pt;"><math id="S8.T2.m1" class="ltx_Math" alttext="\boldsymbol{\Delta}" display="inline" intent=":literal"><semantics><mi>𝚫</mi><annotation encoding="application/x-tex">\boldsymbol{\Delta}</annotation></semantics></math></th>
<th id="S8.T2.2.1.6" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt" style="padding:0.25pt 5.0pt;"><span id="S8.T2.2.1.6.1" class="ltx_text ltx_font_bold">Wilcoxon <math id="S8.T2.m2" class="ltx_Math" alttext="p" display="inline" intent=":literal"><semantics><mi>p</mi><annotation encoding="application/x-tex">p</annotation></semantics></math></span></th></tr>
</thead>
