<td id="A8.T5.2.8.3" class="ltx_td ltx_align_left" style="padding:0.25pt 5.0pt;"><span id="A8.T5.2.8.3.1" class="ltx_text ltx_font_typewriter">case_issue_identification_justification</span></td></tr>
