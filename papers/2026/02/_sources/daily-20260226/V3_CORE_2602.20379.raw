<tr id="S8.T2.2.2" class="ltx_tr">
<th id="S8.T2.2.2.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_t" style="padding:0.25pt 5.0pt;">Short Queries</th>
