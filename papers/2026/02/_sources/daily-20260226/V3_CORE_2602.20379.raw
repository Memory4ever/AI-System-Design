<td id="A11.T6.2.2.2" class="ltx_td ltx_align_center ltx_border_t" style="padding:0.25pt 5.0pt;">70</td>
<td id="A11.T6.2.2.3" class="ltx_td ltx_align_center ltx_border_t" style="padding:0.25pt 5.0pt;">0.515</td></tr>
<tr id="A11.T6.2.3" class="ltx_tr">
