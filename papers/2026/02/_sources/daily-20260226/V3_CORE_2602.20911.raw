<th id="S3.T1.6.2.2" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_r ltx_border_t"><math id="S3.T1.m6" class="ltx_Math" alttext="\mathcal{A}_{T}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">𝒜</mi><mi>T</mi></msub><annotation encoding="application/x-tex">\mathcal{A}_{T}</annotation></semantics></math> (%)</th>
<th id="S3.T1.6.2.3" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_t"><math id="S3.T1.m7" class="ltx_Math" alttext="\bar{\mathcal{A}}" display="inline" intent=":literal"><semantics><mover accent="true"><mi class="ltx_font_mathcaligraphic">𝒜</mi><mo>¯</mo></mover><annotation encoding="application/x-tex">\bar{\mathcal{A}}</annotation></semantics></math> (%)</th>
<th id="S3.T1.6.2.4" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_r ltx_border_t"><math id="S3.T1.m8" class="ltx_Math" alttext="\mathcal{A}_{T}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">𝒜</mi><mi>T</mi></msub><annotation encoding="application/x-tex">\mathcal{A}_{T}</annotation></semantics></math> (%)</th>
<th id="S3.T1.6.2.5" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_t"><math id="S3.T1.m9" class="ltx_Math" alttext="\bar{\mathcal{A}}" display="inline" intent=":literal"><semantics><mover accent="true"><mi class="ltx_font_mathcaligraphic">𝒜</mi><mo>¯</mo></mover><annotation encoding="application/x-tex">\bar{\mathcal{A}}</annotation></semantics></math> (%)</th>
<th id="S3.T1.6.2.6" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_r ltx_border_t"><math id="S3.T1.m10" class="ltx_Math" alttext="\mathcal{A}_{T}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">𝒜</mi><mi>T</mi></msub><annotation encoding="application/x-tex">\mathcal{A}_{T}</annotation></semantics></math> (%)</th>
<th id="S3.T1.6.2.7" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_t"><math id="S3.T1.m11" class="ltx_Math" alttext="\bar{\mathcal{A}}" display="inline" intent=":literal"><semantics><mover accent="true"><mi class="ltx_font_mathcaligraphic">𝒜</mi><mo>¯</mo></mover><annotation encoding="application/x-tex">\bar{\mathcal{A}}</annotation></semantics></math> (%)</th>
<th id="S3.T1.6.2.8" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_t"><math id="S3.T1.m12" class="ltx_Math" alttext="\mathcal{A}_{T}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">𝒜</mi><mi>T</mi></msub><annotation encoding="application/x-tex">\mathcal{A}_{T}</annotation></semantics></math> (%)</th></tr>
