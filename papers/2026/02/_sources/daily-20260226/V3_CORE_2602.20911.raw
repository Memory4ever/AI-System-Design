<td id="S4.T3.6.1.4.4" class="ltx_td ltx_align_center"><span id="S4.T3.6.1.4.4.1" class="ltx_text ltx_font_bold">5.92<math id="S4.T3.m14" class="ltx_Math" alttext="\times" display="inline" intent=":literal"><semantics><mo>×</mo><annotation encoding="application/x-tex">\times</annotation></semantics></math></span></td>
