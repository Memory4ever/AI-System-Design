<th id="S4.T3.6.1.1.1" class="ltx_td ltx_align_left ltx_th ltx_th_column ltx_th_row ltx_border_tt"><span id="S4.T3.6.1.1.1.1" class="ltx_text ltx_font_bold">Configuration</span></th>
<th id="S4.T3.6.1.1.2" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt"><math id="S4.T3.m5" class="ltx_Math" alttext="\bar{\mathcal{A}}" display="inline" intent=":literal"><semantics><mover accent="true"><mi class="ltx_font_mathcaligraphic">𝒜</mi><mo>¯</mo></mover><annotation encoding="application/x-tex">\bar{\mathcal{A}}</annotation></semantics></math><span id="S4.T3.6.1.1.2.1" class="ltx_text ltx_font_bold"> (%) <math id="S4.T3.m6" class="ltx_Math" alttext="\uparrow" display="inline" intent=":literal"><semantics><mo stretchy="false">↑</mo><annotation encoding="application/x-tex">\uparrow</annotation></semantics></math></span></th>
