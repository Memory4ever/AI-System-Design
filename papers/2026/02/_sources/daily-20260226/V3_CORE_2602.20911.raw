<td id="S3.T1.6.6.2" class="ltx_td ltx_align_center">89.11</td>
<td id="S3.T1.6.6.3" class="ltx_td ltx_align_center ltx_border_r">81.96</td>
<td id="S3.T1.6.6.4" class="ltx_td ltx_align_center">77.97</td>
<td id="S3.T1.6.6.5" class="ltx_td ltx_align_center ltx_border_r">72.27</td>
