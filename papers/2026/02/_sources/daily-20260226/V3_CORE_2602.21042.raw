ont-size:8.19pt;" color="#000000" height="6.24" overflow="visible" transform="matrix(1 0 0 -1 0 6.24)" width="27.09"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S0.F1.pic1.m10" class="ltx_Math" alttext="27.41" display="inline" intent=":literal"><semantics><mn style="--ltx-fg-color:#000000;" mathcolor="#000000" mathsize="0.700em">27.41</mn><annotation encoding="application/x-tex">27.41</annotation></semantics></math></span></span></foreignObject></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;--ltx-fg-color:#000000;" color="#000000" fill="#000000" stroke="#000000" transform="matrix(0.0 1.0 -1.0 0.0 41.48 75.21)"><foreignObject style="--ltx-fg-color:#000000;--ltx-fo-width:2.39em;--ltx-fo-height:0.55em;--ltx-fo-depth:0em;font-size:8.19pt;" color="#000000" height="6.24" overflow="visible" transform="matrix(1 0 0 -1 0 6.24)" width="27.09"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S0.F1.pic1.m11" class="ltx_Math" alttext="27.83" display="inline" intent=":literal"><semantics><mn style="--ltx-fg-color:#000000;" mathcolor="#000000" mathsize="0.700em">27.83</mn><annotation encoding="application/x-tex">27.83</annotation></semantics></math></span></span></foreignObject></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;--ltx-fg-color:#000000;" color="#000000" fill="#000000" stroke="#000000" transform="matrix(0.0 1.0 -1.0 0.0 51.07 82.77)"><foreignObject style="--ltx-fg-color:#000000;--ltx-fo-width:2.39em;--ltx-fo-height:0.55em;--ltx-fo-depth:0em;font-size:8.19pt;" color="#000000" height="6.24" overflow="visible" transform="matrix(1 0 0 -1 0 6.24)" width="27.09"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S0.F1.pic1.m12" class="ltx_Math" alttext="30.82" display="inline" intent=":literal"><semantics><mn style="--ltx-fg-color:#000000;" mathcolor="#000000" mathsize="0.700em">30.82</mn><annotation encoding=