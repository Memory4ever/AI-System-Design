</span></td>
<td id="S6.T2.8.7.3" class="ltx_td ltx_align_center" style="padding-left:3.0pt;padding-right:3.0pt;"><span id="S6.T2.8.7.3.1" class="ltx_text ltx_font_bold">270</span></td>
