<tr id="S4.T1.12.4" class="ltx_tr" style="--ltx-bg-color:#EBEBEB;">
<th id="S4.T1.12.4.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_t"><span id="S4.T1.12.4.1.1" class="ltx_text" style="--ltx-bg-color:#EBEBEB;">Duo</span></th>
<td id="S4.T1.12.4.2" class="ltx_td ltx_align_center ltx_border_t"><span id="S4.T1.12.4.2.1" class="ltx_text" style="--ltx-bg-color:#EBEBEB;">28.11</span></td>
<td id="S4.T1.12.4.3" class="ltx_td ltx_align_center ltx_border_t"><span id="S4.T1.12.4.3.1" class="ltx_text" style="--ltx-bg-color:#EBEBEB;">25.43</span></td>
