<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.Ex4Xc.m2" class="ltx_Math" alttext="\displaystyle\stackrel{{\scriptstyle(4)}}{{=}}\kappa_{t}\sum_{\tilde{{\mathbf{z}}}_{t}^{\color[rgb]{0.4688,0.4688,0.4688}\ell}}{\color[rgb]{0.043,0.3242,0.5898}q_{t}}(\tilde{{\mathbf{z}}}_{t}^{\color[rgb]{0.4688,0.4688,0.4688}\ell}|{\mathbf{x}}^{{\color[rgb]{0.4688,0.4688,0.4688}\ell}})q_{s|t}({\mathbf{z}}_{s}^{\color[rgb]{0.4688,0.4688,0.4688}\ell}|{\mathbf{x}}^{{\color[rgb]{0.4688,0.4688,0.4688}\ell}},\tilde{{\mathbf{z}}}_{t}^{\color[rgb]{0.4688,0.4688,0.4688}\ell})+(1-\kappa_{t}){\color[rgb]{0.043,0.3242,0.5898}q_{s}}({\mathbf{z}}_{s}^{\color[rgb]{0.4688,0.4688,0.4688}\ell}|{\mathbf{x}}^{\color[rgb]{0.4688,0.4688,0.4688}\ell})\sum_{\tilde{{\mathbf{z}}}_{t}^{\color[rgb]{0.4688,0.4688,0.4688}\ell}}{\color[rgb]{0.043,0.3242,0.5898}q_{t}}(\tilde{{\mathbf{z}}}_{t}^{\color[rgb]{0.4688,0.4688,0.4688}\ell}|{\mathbf{x}}^{{\color[rgb]{0.4688,0.4688,0.4688}\ell}})" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mover><mo>=</mo><mrow><mo stretchy="false">(</mo><mn>4</mn><mo stretchy="false">)</mo></mrow></mover><mrow><mrow><msub><mi>κ</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><msubsup><mover accent="true"><mi>𝐳</mi><mo>~</mo></mover><mi>t</mi><mi style="--ltx-fg-color:#787878;" mathcolor="#787878" mathvariant="normal">ℓ</mi></msubsup></munder></mstyle><mrow><msub><mi style="--ltx-fg-color:#0B5396;" mathcolor="#0B5396">q</mi><mi style="--ltx-fg-color:#0B5396;" mathcolor="#0B5396">t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msubsup><mover accent="true"><mi>𝐳</mi><mo>~</mo></mover><mi>t</mi><mi style="--ltx-fg-color:#787878;" mathcolor="#787878" mathvariant="normal">ℓ</mi></msubsup><mo lspace="0em" rspace="0em">|</mo><msup><mi>𝐱</mi><mi style="--ltx-fg-color:#787878;" mathcolor="#787878" mathvariant="normal">ℓ</mi></msup><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>q</mi><mrow><mi>s</mi><mo fence="false">|</mo><mi>t</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>𝐳</mi><mi>s</mi><mi style="--ltx-fg-color:#787878;" mathcolor="#787878" mathvariant="normal">ℓ</mi></msubsup><mo lspace="0em" rspace="0em">|</mo><mrow><msup><mi>𝐱</mi><mi style="--ltx-fg-color:#787878;" mathcolor="#787878" mathvariant="normal">ℓ</mi></msup><mo>,</mo><msubsup><mover accent="true"><mi>𝐳</mi><mo>~</mo></mover><mi>t</mi><mi style="--ltx-fg-color:#787878;" mathcolor="#787878" mathvariant="normal">ℓ</mi></msubsup></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo>+</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msub><mi>κ</mi><mi>t</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi style="--ltx-fg-color:#0B5396;" mathcolor="#0B5396">q</mi><mi style="--ltx-fg-color:#0B5396;" mathcolor="#0B5396">s</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>𝐳</mi><mi>s</mi><mi style="--ltx-fg-color:#787878;" mathcolor="#787878" mathvariant="normal">ℓ</mi></msubsup><mo lspace="0em" rspace="0em">|</mo><msup><mi>𝐱</mi><mi style="--ltx-fg-color:#787878;" mathcolor="#787878" mathvariant="normal">ℓ</mi></msup><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><msubsup><mover accent="true"><mi>𝐳</mi><mo>~</mo></mover><mi>t</mi><mi style="--ltx-fg-color:#787878;" mathcolor="#787878" mathvariant="normal">ℓ</mi></msubsup></munder></mstyle><mrow><msub><mi style="--ltx-fg-color:#0B5396;" mathcolor="#0B5396">q</mi><mi style="--ltx-fg-color:#0B5396;" mathcolor="#0B5396">t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msubsup><mover accent="true"><mi>𝐳</mi><mo>~</mo></mover><mi>t</mi><mi style="--ltx-fg-color:#787878;" mathcolor="#787878" mathvariant="normal">ℓ</mi></msubsup><mo lspace="0em" rspace="0em">|</mo><msup><mi>𝐱</mi><mi style="--ltx-fg-color:#787878;" mathcolor="#787878" mathvariant="normal">ℓ</mi></msup><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\stackrel{{\scriptstyle(4)}}{{=}}\kappa_{t}\sum_{\tilde{{\mathbf{z}}}_{t}^{\color[rgb]{0.4688,0.4688,0.4688}\ell}}{\color[rgb]{0.043,0.3242,0.5898}q_{t}}(\tilde{{\mathbf{z}}}_{t}^{\color[rgb]{0.4688,0.4688,0.4688}\ell}|{\mathbf{x}}^{{\color[rgb]{0.4688,0.4688,0.4688}\ell}})q_{s|t}({\mathbf{z}}_{s}^{\color[rgb]{0.4688,0.4688,0.4688}\ell}|{\mathbf{x}}^{{\color[rgb]{0.4688,0.4688,0.4688}\ell}},\tilde{{\mathbf{z}}}_{t}^{\color[rgb]{0.4688,0.4688,0.4688}\ell})+(1-\kappa_{t}){\color[rgb]{0.043,0.3242,0.5898}q_{s}}({\mathbf{z}}_{s}^{\color[rgb]{0.4688,0.4688,0.4688}\ell}|{\mathbf{x}}^{\color[rgb]{0.4688,0.4688,0.4688}\ell})\sum_{\tilde{{\mathbf{z}}}_{t}^{\color[rgb]{0.4688,0.4688,0.4688}\ell}}{\color[rgb]{0.043,0.3242,0.5898}q_{t}}(\tilde{{\mathbf{z}}}_{t}^{\color[rgb]{0.4688,0.4688,0.4688}\ell}|{\mathbf{x}}^{{\color[rgb]{0.4688,0.4688,0.4688}\ell}})</annotation></semantics></math></td>
