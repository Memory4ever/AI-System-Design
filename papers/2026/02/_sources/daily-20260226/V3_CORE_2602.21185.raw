<tbody id="A1.Ex4Xd"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.Ex4Xd.m2" class="ltx_Math" alttext="\displaystyle\stackrel{{\scriptstyle(5)}}{{=}}\kappa_{t}{\color[rgb]{0.043,0.3242,0.5898}q_{s}}({\mathbf{z}}_{s}^{\color[rgb]{0.4688,0.4688,0.4688}\ell}|{\mathbf{x}}^{{\color[rgb]{0.4688,0.4688,0.4688}\ell}})+(1-\kappa_{t}){\color[rgb]{0.043,0.3242,0.5898}q_{s}}({\mathbf{z}}_{s}^{\color[rgb]{0.4688,0.4688,0.4688}\ell}|{\mathbf{x}}^{{\color[rgb]{0.4688,0.4688,0.4688}\ell}})={\color[rgb]{0.043,0.3242,0.5898}q_{s}}({\mathbf{z}}_{s}^{\color[rgb]{0.4688,0.4688,0.4688}\ell}|{\mathbf{x}}^{{\color[rgb]{0.4688,0.4688,0.4688}\ell}})." display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mover><mo>=</mo><mrow><mo stretchy="false">(</mo><mn>5</mn><mo stretchy="false">)</mo></mrow></mover><mrow><mrow><msub><mi>κ</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi style="--ltx-fg-color:#0B5396;" mathcolor="#0B5396">q</mi><mi style="--ltx-fg-color:#0B5396;" mathcolor="#0B5396">s</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>𝐳</mi><mi>s</mi><mi style="--ltx-fg-color:#787878;" mathcolor="#787878" mathvariant="normal">ℓ</mi></msubsup><mo lspace="0em" rspace="0em">|</mo><msup><mi>𝐱</mi><mi style="--ltx-fg-color:#787878;" mathcolor="#787878" mathvariant="normal">ℓ</mi></msup><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msub><mi>κ</mi><mi>t</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi style="--ltx-fg-color:#0B5396;" mathcolor="#0B5396">q</mi><mi style="--ltx-fg-color:#0B5396;" mathcolor="#0B5396">s</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>𝐳</mi><mi>s</mi><mi style="--ltx-fg-color:#787878;" mathcolor="#787878" mathvariant="normal">ℓ</mi></msubsup><mo lspace="0em" rspace="0em">|</mo><msup><mi>𝐱</mi><mi style="--ltx-fg-color:#787878;" mathcolor="#787878" mathvariant="normal">ℓ</mi></msup><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>=</mo><mrow><msub><mi style="--ltx-fg-color:#0B5396;" mathcolor="#0B5396">q</mi><mi style="--ltx-fg-color:#0B5396;" mathcolor="#0B5396">s</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>𝐳</mi><mi>s</mi><mi style="--ltx-fg-color:#787878;" mathcolor="#787878" mathvariant="normal">ℓ</mi></msubsup><mo lspace="0em" rspace="0em">|</mo><msup><mi>𝐱</mi><mi style="--ltx-fg-color:#787878;" mathcolor="#787878" mathvariant="normal">ℓ</mi></msup><mo stretchy="false">)</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\stackrel{{\scriptstyle(5)}}{{=}}\kappa_{t}{\color[rgb]{0.043,0.3242,0.5898}q_{s}}({\mathbf{z}}_{s}^{\color[rgb]{0.4688,0.4688,0.4688}\ell}|{\mathbf{x}}^{{\color[rgb]{0.4688,0.4688,0.4688}\ell}})+(1-\kappa_{t}){\color[rgb]{0.043,0.3242,0.5898}q_{s}}({\mathbf{z}}_{s}^{\color[rgb]{0.4688,0.4688,0.4688}\ell}|{\mathbf{x}}^{{\color[rgb]{0.4688,0.4688,0.4688}\ell}})={\color[rgb]{0.043,0.3242,0.5898}q_{s}}({\mathbf{z}}_{s}^{\color[rgb]{0.4688,0.4688,0.4688}\ell}|{\mathbf{x}}^{{\color[rgb]{0.4688,0.4688,0.4688}\ell}}).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A1.SS2.SSS0.Px3.p1.2" class="ltx_p">Specifically, <math id="A1.SS2.SSS0.Px3.p1.m3" class="ltx_Math" alttext="(1)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(1)</annotation></semantics></math> hold by (<a href="#A1.E16" title="Equation 16 ‣ A.2 Proof that the Ψ-posteriors have the correct marginals ‣ Appendix A Ψ-Posteriors ‣ The Diffusion Duality, Chapter II: Ψ-Samplers and Efficient Curriculum" class="ltx_ref"><span class="ltx_text ltx_ref_tag">16</span></a>), <math id="A1.SS2.SSS0.Px3.p1.m4" class="ltx_Math" alttext="(2)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(2)</annotation></semantics></math> by the induction hypothesis, <math id="A1.SS2.SSS0.Px3.p1.m5" class="ltx_Math" alttext="(3)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mn>3</mn><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(3)</annotation></semantics></math> by definition of the <math id="A1.SS2.SSS0.Px3.p1.m6" class="ltx_Math" alttext="\Psi" display="inline" intent=":literal"><semantics><mi mathvariant="normal">Ψ</mi><annotation encoding="application/x-tex">\Psi</annotation></semantics></math>-posteriors, <math id="A1.SS2.SSS0.Px3.p1.m7" class="ltx_Math" alttext="(4)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mn>4</mn><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(4)</annotation></semantics></math> by distributing <math id="A1.SS2.SSS0.Px3.p1.m8" class="ltx_Math" alttext="{\color[rgb]{0.043,0.3242,0.5898}q_{t}}(\tilde{{\mathbf{z}}}_{t}^{\color[rgb]{0.4688,0.4688,0.4688}\ell}|{\mathbf{x}}^{{\color[rgb]{0.4688,0.4688,0.4688}\ell}})" display="inline" intent=":literal"><semantics><mrow><msub><mi style="--ltx-fg-color:#0B5396;" mathcolor="#0B5396">q</mi><mi style="--ltx-fg-color:#0B5396;" mathcolor="#0B5396">t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msubsup><mover accent="true"><mi>𝐳</mi><mo>~</mo></mover><mi>t</mi><mi style="--ltx-fg-color:#787878;" mathcolor="#787878" mathvariant="normal">ℓ</mi></msubsup><mo lspace="0em" rspace="0em">|</mo><msup><mi>𝐱</mi><mi style="--ltx-fg-color:#787878;" mathcolor="#787878" mathvariant="normal">ℓ</mi></msup><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">{\color[rgb]{0.043,0.3242,0.5898}q_{t}}(\tilde{{\mathbf{z}}}_{t}^{\color[rgb]{0.4688,0.4688,0.4688}\ell}|{\mathbf{x}}^{{\color[rgb]{0.4688,0.4688,0.4688}\ell}})</annotation></semantics></math>, <math id="A1.SS2.SSS0.Px3.p1.m9" class="ltx_Math" alttext="(5)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mn>5</mn><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(5)</annotation></semantics></math> by definition of marginal probability (first term), and by observing that <math id="A1.SS2.SSS0.Px3.p1.m10" class="ltx_Math" alttext="\sum_{\tilde{{\mathbf{z}}}_{t}^{\color[rgb]{0.4688,0.4688,0.4688}\ell}}{\color[rgb]{0.043,0.3242,0.5898}q_{t}}(\tilde{{\mathbf{z}}}_{t}^{\color[rgb]{0.4688,0.4688,0.4688}\ell}|{\mathbf{x}}^{{\color[rgb]{0.4688,0.4688,0.4688}\ell}})=1" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mo>∑</mo><msubsup><mover accent="true"><mi>𝐳</mi><mo>~</mo></mover><mi>t</mi><mi style="--ltx-fg-color:#787878;" mathcolor="#787878" mathvariant="normal">ℓ</mi></msubsup></msub><mrow><msub><mi style="--ltx-fg-color:#0B5396;" mathcolor="#0B5396">q</mi><mi style="--ltx-fg-color:#0B5396;" mathcolor="#0B5396">t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msubsup><mover accent="true"><mi>𝐳</mi><mo>~</mo></mover><mi>t</mi><mi style="--ltx-fg-color:#787878;" mathcolor="#787878" mathvariant="normal">ℓ</mi></msubsup><mo lspace="0em" rspace="0em">|</mo><msup><mi>𝐱</mi><mi style="--ltx-fg-color:#787878;" mathcolor="#787878" mathvariant="normal">ℓ</mi></msup><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>=</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">\sum_{\tilde{{\mathbf{z}}}_{t}^{\color[rgb]{0.4688,0.4688,0.4688}\ell}}{\color[rgb]{0.043,0.3242,0.5898}q_{t}}(\tilde{{\mathbf{z}}}_{t}^{\color[rgb]{0.4688,0.4688,0.4688}\ell}|{\mathbf{x}}^{{\color[rgb]{0.4688,0.4688,0.4688}\ell}})=1</annotation></semantics></math> since <math id="A1.SS2.SSS0.Px3.p1.m11" class="ltx_Math" alttext="{\color[rgb]{0.043,0.3242,0.5898}q_{t}}" display="inline" intent=":literal"><semantics><msub><mi style="--ltx-fg-color:#0B5396;" mathcolor="#0B5396">q</mi><mi style="--ltx-fg-color:#0B5396;" mathcolor="#0B5396">t</mi></msub><annotation encoding="application/x-tex">{\color[rgb]{0.043,0.3242,0.5898}q_{t}}</annotation></semantics></math> is normalized. This concludes the inductive step, and shows that the <math id="A1.SS2.SSS0.Px3.p1.m12" class="ltx_Math" alttext="\Psi" display="inline" intent=":literal"><semantics><mi mathvariant="normal">Ψ</mi><annotation encoding="application/x-tex">\Psi</annotation></semantics></math>-posteriors have the correct marginal.</p>
</div>
</section>
</section>
<section id="A1.SS3" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">A.3 </span>Negative Evidence Lower Bound</h3>

<div id="A1.SS3.p1" class="ltx_para ltx_noindent">
<p id="A1.SS3.p1.1" class="ltx_p">Let <math id="A1.SS3.p1.m1" class="ltx_math_unparsed" alttext="{\mathbf{z}}_{0:1}^{\color[rgb]{0.4688,0.4688,0.4688}\ell}" display="inline" intent=":literal"><semantics><mrow><mi>𝐳</mi><msub><mrow></mrow><mrow><mn>0</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mn>1</mn></mrow></msub><msup><mrow></mrow><mi style="--ltx-fg-color:#787878;" mathcolor="#787878" mathvariant="normal">ℓ</mi></msup></mrow><annotation encoding="application/x-tex">{\mathbf{z}}_{0:1}^{\color[rgb]{0.4688,0.4688,0.4688}\ell}</annotation></semantics></math> denote a reverse trajectory with time indices <math id="A1.SS3.p1.m2" class="ltx_Math" alttext="\{0,\frac{1}{T},\frac{2}{T},\dots,1\}" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">{</mo><mrow><mn>0</mn><mo>,</mo><mfrac><mn>1</mn><mi>T</mi></mfrac><mo>,</mo><mfrac><mn>2</mn><mi>T</mi></mfrac><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mn>1</mn></mrow><mo stretchy="false">}</mo></mrow><annotation encoding="application/x-tex">\{0,\frac{1}{T},\frac{2}{T},\dots,1\}</annotation></semantics></math> for token <math id="A1.SS3.p1.m3" class="ltx_Math" alttext="\ell" display="inline" intent=":literal"><semantics><mi mathvariant="normal">ℓ</mi><annotation encoding="application/x-tex">\ell</annotation></semantics></math>. The joint distribution of <math id="A1.SS3.p1.m4" class="ltx_math_unparsed" alttext="({\mathbf{x}}^{{\color[rgb]{0.4688,0.4688,0.4688}\ell}},{\mathbf{z}}_{0:1}^{\color[rgb]{0.4688,0.4688,0.4688}\ell})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><msup><mi>𝐱</mi><mi style="--ltx-fg-color:#787878;" mathcolor="#787878" mathvariant="normal">ℓ</mi></msup><mo>,</mo><msubsup><mi>𝐳</mi><mrow><mn>0</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mn>1</mn></mrow><mi style="--ltx-fg-color:#787878;" mathcolor="#787878" mathvariant="normal">ℓ</mi></msubsup><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">({\mathbf{x}}^{{\color[rgb]{0.4688,0.4688,0.4688}\ell}},{\mathbf{z}}_{0:1}^{\color[rgb]{0.4688,0.4688,0.4688}\ell})</annotation></semantics></math> under the generative model factorizes as</p>
<table id="A1.E17" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A1.E17.m1" class="ltx_math_unparsed" alttext="p^{\theta}({\mathbf{x}}^{{\color[rgb]{0.4688,0.4688,0.4688}\ell}},{\mathbf{z}}_{0:1}^{\color[rgb]{0.4688,0.4688,0.4688}\ell})=p({\mathbf{x}}^{{\color[rgb]{0.4688,0.4688,0.4688}\ell}}\mid{\mathbf{z}}_{0}^{\color[rgb]{0.4688,0.4688,0.4688}\ell})\Psi_{1}({\mathbf{z}}_{1}^{\color[rgb]{0.4688,0.4688,0.4688}\ell})\prod_{i=1}^{T}\Psi^{\theta}_{s\mid t}({\mathbf{z}}_{s(i)}^{\color[rgb]{0.4688,0.4688,0.4688}\ell}\mid{\mathbf{z}}_{t(i)}^{\color[rgb]{0.4688,0.4688,0.4688}\ell})," display="block" intent=":literal"><semantics><mrow><msup><mi>p</mi><mi>θ</mi></msup><mrow><mo stretchy="false">(</mo><msup><mi>𝐱</mi><mi style="--ltx-fg-color:#787878;" mathcolor="#787878" mathvariant="normal">ℓ</mi></msup><mo>,</mo><msubsup><mi>𝐳</mi><mrow><mn>0</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mn>1</mn></mrow><mi style="--ltx-fg-color:#787878;" mathcolor="#787878" mathvariant="normal">ℓ</mi></msubsup><mo stretchy="false">)</mo></mrow><mo>=</mo><mi>p</mi><mrow><mo stretchy="false">(</mo><msup><mi>𝐱</mi><mi style="--ltx-fg-color:#787878;" mathcolor="#787878" mathvariant="normal">ℓ</mi></msup><mo lspace="0em" rspace="0.167em">∣</mo><msubsup><mi>𝐳</mi><mn>0</mn><mi style="--ltx-fg-color:#787878;" mathcolor="#787878" mathvariant="normal">ℓ</mi></msubsup><mo stretchy="false">)</mo></mrow><msub><mi mathvariant="normal">Ψ</mi><mn>1</mn></msub><mrow><mo stretchy="false">(</mo><msubsup><mi>𝐳</mi><mn>1</mn><mi style="--ltx-fg-color:#787878;" mathcolor="#787878" mathvariant="normal">ℓ</mi></msubsup><mo stretchy="false">)</mo></mrow><munderover><mo movablelimits="false">∏</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>T</mi></munderover><msubsup><mi mathvariant="normal">Ψ</mi><mrow><mi>s</mi><mo fence="false">|</mo><mi>t</mi></mrow><mi>θ</mi></msubsup><mrow><mo stretchy="false">(</mo><msubsup><mi>𝐳</mi><mrow><mi>s</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></mrow><mi style="--ltx-fg-color:#787878;" mathcolor="#787878" mathvariant="normal">ℓ</mi></msubsup><mo lspace="0em" rspace="0.167em">∣</mo><msubsup><mi>𝐳</mi><mrow><mi>t</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></mrow><mi style="--ltx-fg-color:#787878;" mathcolor="#787878" mathvariant="normal">ℓ</mi></msubsup><mo stretchy="false">)</mo></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">p^{\theta}({\mathbf{x}}^{{\color[rgb]{0.4688,0.4688,0.4688}\ell}},{\mathbf{z}}_{0:1}^{\color[rgb]{0.4688,0.4688,0.4688}\ell})=p({\mathbf{x}}^{{\color[rgb]{0.4688,0.4688,0.4688}\ell}}\mid{\mathbf{z}}_{0}^{\color[rgb]{0.4688,0.4688,0.4688}\ell})\Psi_{1}({\mathbf{z}}_{1}^{\color[rgb]{0.4688,0.4688,0.4688}\ell})\prod_{i=1}^{T}\Psi^{\theta}_{s\mid t}({\mathbf{z}}_{s(i)}^{\color[rgb]{0.4688,0.4688,0.4688}\ell}\mid{\mathbf{z}}_{t(i)}^{\color[rgb]{0.4688,0.4688,0.4688}\ell}),</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(17)</span></td></tr></tbody>
</table>
<p id="A1.SS3.p1.2" class="ltx_p">where each pair <math id="A1.SS3.p1.m5" class="ltx_Math" alttext="(s(i),t(i))" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mrow><mi>s</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mrow><mi>t</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(s(i),t(i))</annotation></semantics></math> denotes one reverse transition with <math id="A1.SS3.p1.m6" class="ltx_Math" alttext="s(i)&lt;t(i)" display="inline" intent=":literal"><semantics><mrow><mrow><mi>s</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></mrow><mo>&lt;</mo><mrow><mi>t</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">s(i)&lt;t(i)</annotation></semantics></math>. The marginal likelihood is</p>
<table id="A1.E18" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A1.E18.m1" class="ltx_math_unparsed" alttext="p^{\theta}({\mathbf{x}}^{{\color[rgb]{0.4688,0.4688,0.4688}\ell}})=\sum_{{\mathbf{z}}_{0:1}^{\color[rgb]{0.4688,0.4688,0.4688}\ell}}p^{\theta}({\mathbf{x}}^{{\color[rgb]{0.4688,0.4688,0.4688}\ell}},{\mathbf{z}}_{0:1}^{\color[rgb]{0.4688,0.4688,0.4688}\ell})." display="block" intent=":literal"><semantics><mrow><msup><mi>p</mi><mi>θ</mi></msup><mrow><mo stretchy="false">(</mo><msup><mi>𝐱</mi><mi style="--ltx-fg-color:#787878;" mathcolor="#787878" mathvariant="normal">ℓ</mi></msup><mo stretchy="false">)</mo></mrow><mo rspace="0.111em">=</mo><munder><mo movablelimits="false">∑</mo><mrow><mi>𝐳</mi><msub><mrow></mrow><mrow><mn>0</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mn>1</mn></mrow></msub><msup><mrow></mrow><mi style="--ltx-fg-color:#787878;" mathcolor="#787878" mathvariant="normal">ℓ</mi></msup></mrow></munder><msup><mi>p</mi><mi>θ</mi></msup><mrow><mo stretchy="false">(</mo><msup><mi>𝐱</mi><mi style="--ltx-fg-color:#787878;" mathcolor="#787878" mathvariant="normal">ℓ</mi></msup><mo>,</mo><msubsup><mi>𝐳</mi><mrow><mn>0</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mn>1</mn></mrow><mi style="--ltx-fg-color:#787878;" mathcolor="#787878" mathvariant="normal">ℓ</mi></msubsup><mo stretchy="false">)</mo></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">p^{\theta}({\mathbf{x}}^{{\color[rgb]{0.4688,0.4688,0.4688}\ell}})=\sum_{{\mathbf{z}}_{0:1}^{\color[rgb]{0.4688,0.4688,0.4688}\ell}}p^{\theta}({\mathbf{x}}^{{\color[rgb]{0.4688,0.4688,0.4688}\ell}},{\mathbf{z}}_{0:1}^{\color[rgb]{0.4688,0.4688,0.4688}\ell}).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(18)</span></td></tr></tbody>
</table>
<p id="A1.SS3.p1.3" class="ltx_p">Introducing the variational distribution
<math id="A1.SS3.p1.m7" class="ltx_math_unparsed" alttext="\Psi({\mathbf{z}}_{0:1}^{\color[rgb]{0.4688,0.4688,0.4688}\ell}\mid{\mathbf{x}}^{{\color[rgb]{0.4688,0.4688,0.4688}\ell}})=\Psi_{1}({\mathbf{z}}_{1}^{\color[rgb]{0.4688,0.4688,0.4688}\ell}\mid{\mathbf{x}}^{{\color[rgb]{0.4688,0.4688,0.4688}\ell}})\prod_{i=1}^{T}\Psi_{s\mid t}({\mathbf{z}}_{s(i)}^{\color[rgb]{0.4688,0.4688,0.4688}\ell}\mid{\mathbf{z}}_{t(i)}^{\color[rgb]{0.4688,0.4688,0.4688}\ell},{\mathbf{x}}^{{\color[rgb]{0.4688,0.4688,0.4688}\ell}})" display="inline" intent=":literal"><semantics><mrow><mi mathvariant="normal">Ψ</mi><mrow><mo stretchy="false">(</mo><msubsup><mi>𝐳</mi><mrow><mn>0</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mn>1</mn></mrow><mi style="--ltx-fg-color:#787878;" mathcolor="#787878" mathvariant="normal">ℓ</mi></msubsup><mo lspace="0em" rspace="0.167em">∣</mo><msup><mi>𝐱</mi><mi style="--ltx-fg-color:#787878;" mathcolor="#787878" mathvariant="normal">ℓ</mi></msup><mo stretchy="false">)</mo></mrow><mo>=</mo><msub><mi mathvariant="normal">Ψ</mi><mn>1</mn></msub><mrow><mo stretchy="false">(</mo><msubsup><mi>𝐳</mi><mn>1</mn><mi style="--ltx-fg-color:#787878;" mathcolor="#787878" mathvariant="normal">ℓ</mi></msubsup><mo lspace="0em" rspace="0.167em">∣</mo><msup><mi>𝐱</mi><mi style="--ltx-fg-color:#787878;" mathcolor="#787878" mathvariant="normal">ℓ</mi></msup><mo stretchy="false">)</mo></mrow><msubsup><mo>∏</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>T</mi></msubsup><msub><mi mathvariant="normal">Ψ</mi><mrow><mi>s</mi><mo fence="false">|</mo><mi>t</mi></mrow></msub><mrow><mo stretchy="false">(</mo><msubsup><mi>𝐳</mi><mrow><mi>s</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></mrow><mi style="--ltx-fg-color:#787878;" mathcolor="#787878" mathvariant="normal">ℓ</mi></msubsup><mo lspace="0em" rspace="0.167em">∣</mo><msubsup><mi>𝐳</mi><mrow><mi>t</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></mrow><mi style="--ltx-fg-color:#787878;" mathcolor="#787878" mathvariant="normal">ℓ</mi></msubsup><mo>,</mo><msup><mi>𝐱</mi><mi style="--ltx-fg-color:#787878;" mathcolor="#787878" mathvariant="normal">ℓ</mi></msup><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\Psi({\mathbf{z}}_{0:1}^{\color[rgb]{0.4688,0.4688,0.4688}\ell}\mid{\mathbf{x}}^{{\color[rgb]{0.4688,0.4688,0.4688}\ell}})=\Psi_{1}({\mathbf{z}}_{1}^{\color[rgb]{0.4688,0.4688,0.4688}\ell}\mid{\mathbf{x}}^{{\color[rgb]{0.4688,0.4688,0.4688}\ell}})\prod_{i=1}^{T}\Psi_{s\mid t}({\mathbf{z}}_{s(i)}^{\color[rgb]{0.4688,0.4688,0.4688}\ell}\mid{\mathbf{z}}_{t(i)}^{\color[rgb]{0.4688,0.4688,0.4688}\ell},{\mathbf{x}}^{{\color[rgb]{0.4688,0.4688,0.4688}\ell}})</annotation></semantics></math>,
Jensen’s inequality results in:</p>
<table id="A1.EGx13" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A1.E19"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A1.E19.m1" class="ltx_Math" alttext="\displaystyle-\log p^{\theta}({\mathbf{x}}^{\color[rgb]{0.4688,0.4688,0.4688}\ell})" display="inline" intent=":literal"><semantics><mrow><mo rspace="0.167em">−</mo><mrow><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><msup><mi>p</mi><mi>θ</mi></msup></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>𝐱</mi><mi style="--ltx-fg-color:#787878;" mathcolor="#787878" mathvariant="normal">ℓ</mi></msup><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle-\log p^{\theta}({\mathbf{x}}^{\color[rgb]{0.4688,0.4688,0.4688}\ell})</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.E19.m2" class="ltx_math_unparsed" alttext="\displaystyle\leq\mathbb{E}_{\Psi({\mathbf{z}}_{0:1}^{\color[rgb]{0.4688,0.4688,0.4688}\ell}\mid{\mathbf{x}}^{{\color[rgb]{0.4688,0.4688,0.4688}\ell}})}\big[-\log p({\mathbf{x}}^{{\color[rgb]{0.4688,0.4688,0.4688}\ell}}\mid{\mathbf{z}}_{0}^{\color[rgb]{0.4688,0.4688,0.4688}\ell})\big]+\mathrm{KL}\big(\Psi_{1}(\cdot\mid{\mathbf{x}}^{{\color[rgb]{0.4688,0.4688,0.4688}\ell}})\big\|\Psi_{1}\big)" display="inline" intent=":literal"><semantics><mrow><mo>≤</mo><msub><mi>𝔼</mi><mrow><mi mathvariant="normal">Ψ</mi><mo stretchy="false">(</mo><mi>𝐳</mi><msub><mrow></mrow><mrow><mn>0</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mn>1</mn></mrow></msub><msup><mrow></mrow><mi style="--ltx-fg-color:#787878;" mathcolor="#787878" mathvariant="normal">ℓ</mi></msup><mo lspace="0em" rspace="0.167em">∣</mo><mi>𝐱</mi><msup><mrow></mrow><mi style="--ltx-fg-color:#787878;" mathcolor="#787878" mathvariant="normal">ℓ</mi></msup><mo stretchy="false">)</mo></mrow></msub><mrow><mo maxsize="1.200em" minsize="1.200em">[</mo><mo lspace="0em">−</mo><mi>log</mi><mi>p</mi><mrow><mo stretchy="false">(</mo><msup><mi>𝐱</mi><mi style="--ltx-fg-color:#787878;" mathcolor="#787878" mathvariant="normal">ℓ</mi></msup><mo lspace="0em" rspace="0.167em">∣</mo><msubsup><mi>𝐳</mi><mn>0</mn><mi style="--ltx-fg-color:#787878;" mathcolor="#787878" mathvariant="normal">ℓ</mi></msubsup><mo stretchy="false">)</mo></mrow><mo maxsize="1.200em" minsize="1.200em">]</mo></mrow><mo>+</mo><mi>KL</mi><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><msub><mi mathvariant="normal">Ψ</mi><mn>1</mn></msub><mrow><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo lspace="0em" rspace="0.167em">∣</mo><msup><mi>𝐱</mi><mi style="--ltx-fg-color:#787878;" mathcolor="#787878" mathvariant="normal">ℓ</mi></msup><mo stretchy="false">)</mo></mrow><mo lspace="0em" mathsize="1.200em" rspace="0.167em">∥</mo><msub><mi mathvariant="normal">Ψ</mi><mn>1</mn></msub><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\leq\mathbb{E}_{\Psi({\mathbf{z}}_{0:1}^{\color[rgb]{0.4688,0.4688,0.4688}\ell}\mid{\mathbf{x}}^{{\color[rgb]{0.4688,0.4688,0.4688}\ell}})}\big[-\log p({\mathbf{x}}^{{\color[rgb]{0.4688,0.4688,0.4688}\ell}}\mid{\mathbf{z}}_{0}^{\color[rgb]{0.4688,0.4688,0.4688}\ell})\big]+\mathrm{KL}\big(\Psi_{1}(\cdot\mid{\mathbf{x}}^{{\color[rgb]{0.4688,0.4688,0.4688}\ell}})\big\|\Psi_{1}\big)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(19)</span></td></tr></tbody>
<tbody id="A1.E20"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.E20.m1" class="ltx_math_unparsed" alttext="\displaystyle+\sum_{i=1}^{T}\mathbb{E}_{\Psi({\mathbf{z}}_{t(i)}^{\color[rgb]{0.4688,0.4688,0.4688}\ell}\mid{\mathbf{x}}^{{\color[rgb]{0.4688,0.4688,0.4688}\ell}})}\left[D_{\mathrm{KL}}\Big(\Psi_{s\mid t}(\cdot\mid{\mathbf{z}}_{t(i)}^{\color[rgb]{0.4688,0.4688,0.4688}\ell},{\mathbf{x}}^{{\color[rgb]{0.4688,0.4688,0.4688}\ell}})\,\big\|\,\Psi^{\theta}_{s\mid t}(\cdot\mid{\mathbf{z}}_{t(i)}^{\color[rgb]{0.4688,0.4688,0.4688}\ell})\Big)\right]." display="inline" intent=":literal"><semantics><mrow><mo>+</mo><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>T</mi></munderover></mstyle><msub><mi>𝔼</mi><mrow><mi mathvariant="normal">Ψ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>𝐳</mi><mrow><mi>t</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></mrow><mi style="--ltx-fg-color:#787878;" mathcolor="#787878" mathvariant="normal">ℓ</mi></msubsup><mo fence="true" lspace="0em" rspace="0em">∣</mo><msup><mi>𝐱</mi><mi style="--ltx-fg-color:#787878;" mathcolor="#787878" mathvariant="normal">ℓ</mi></msup><mo stretchy="false">)</mo></mrow></mrow></msub><mrow><mo>[</mo><msub><mi>D</mi><mi>KL</mi></msub><mrow><mo maxsize="1.600em" minsize="1.600em">(</mo><msub><mi mathvariant="normal">Ψ</mi><mrow><mi>s</mi><mo fence="false">|</mo><mi>t</mi></mrow></msub><mrow><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo lspace="0em" rspace="0.167em">∣</mo><msubsup><mi>𝐳</mi><mrow><mi>t</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></mrow><mi style="--ltx-fg-color:#787878;" mathcolor="#787878" mathvariant="normal">ℓ</mi></msubsup><mo>,</mo><msup><mi>𝐱</mi><mi style="--ltx-fg-color:#787878;" mathcolor="#787878" mathvariant="normal">ℓ</mi></msup><mo stretchy="false">)</mo></mrow><mo lspace="0.170em" mathsize="1.200em" rspace="0.337em">∥</mo><msubsup><mi mathvariant="normal">Ψ</mi><mrow><mi>s</mi><mo fence="false">|</mo><mi>t</mi></mrow><mi>θ</mi></msubsup><mrow><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo lspace="0em" rspace="0.167em">∣</mo><msubsup><mi>𝐳</mi><mrow><mi>t</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></mrow><mi style="--ltx-fg-color:#787878;" mathcolor="#787878" mathvariant="normal">ℓ</mi></msubsup><mo stretchy="false">)</mo></mrow><mo maxsize="1.600em" minsize="1.600em">)</mo></mrow><mo>]</mo></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle+\sum_{i=1}^{T}\mathbb{E}_{\Psi({\mathbf{z}}_{t(i)}^{\color[rgb]{0.4688,0.4688,0.4688}\ell}\mid{\mathbf{x}}^{{\color[rgb]{0.4688,0.4688,0.4688}\ell}})}\left[D_{\mathrm{KL}}\Big(\Psi_{s\mid t}(\cdot\mid{\mathbf{z}}_{t(i)}^{\color[rgb]{0.4688,0.4688,0.4688}\ell},{\mathbf{x}}^{{\color[rgb]{0.4688,0.4688,0.4688}\ell}})\,\big\|\,\Psi^{\theta}_{s\mid t}(\cdot\mid{\mathbf{z}}_{t(i)}^{\color[rgb]{0.4688,0.4688,0.4688}\ell})\Big)\right].</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(20)</span></td></tr></tbody>
</table>
<p id="A1.SS3.p1.4" class="ltx_p">This expression is similar to the standard diffusion NELBO, with a reconstruction term, a prior term at <math id="A1.SS3.p1.m8" class="ltx_Math" alttext="t{=}1" display="inline" intent=":literal"><semantics><mrow><mi>t</mi><mo>=</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">t{=}1</annotation></semantics></math>, and a sum of KL divergences. As <math id="A1.SS3.p1.m9" class="ltx_Math" alttext="T\rightarrow\infty" display="inline" intent=":literal"><semantics><mrow><mi>T</mi><mo stretchy="false">→</mo><mi mathvariant="normal">∞</mi></mrow><annotation encoding="application/x-tex">T\rightarrow\infty</annotation></semantics></math>, <math id="A1.SS3.p1.m10" class="ltx_Math" alttext="p({\mathbf{x}}^{{\color[rgb]{0.4688,0.4688,0.4688}\ell}}\mid{\mathbf{z}}_{0}^{\color[rgb]{0.4688,0.4688,0.4688}\ell})" display="inline" intent=":literal"><semantics><mrow><mi>p</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>𝐱</mi><mi style="--ltx-fg-color:#787878;" mathcolor="#787878" mathvariant="normal">ℓ</mi></msup><mo fence="true" lspace="0em" rspace="0em">∣</mo><msubsup><mi>𝐳</mi><mn>0</mn><mi style="--ltx-fg-color:#787878;" mathcolor="#787878" mathvariant="normal">ℓ</mi></msubsup><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">p({\mathbf{x}}^{{\color[rgb]{0.4688,0.4688,0.4688}\ell}}\mid{\mathbf{z}}_{0}^{\color[rgb]{0.4688,0.4688,0.4688}\ell})</annotation></semantics></math> concentrates around <math id="A1.SS3.p1.m11" class="ltx_Math" alttext="{\mathbf{x}}^{{\color[rgb]{0.4688,0.4688,0.4688}\ell}}" display="inline" intent=":literal"><semantics><msup><mi>𝐱</mi><mi style="--ltx-fg-color:#787878;" mathcolor="#787878" mathvariant="normal">ℓ</mi></msup><annotation encoding="application/x-tex">{\mathbf{x}}^{{\color[rgb]{0.4688,0.4688,0.4688}\ell}}</annotation></semantics></math>, hence <math id="A1.SS3.p1.m12" class="ltx_Math" alttext="-\log p({\mathbf{x}}^{{\color[rgb]{0.4688,0.4688,0.4688}\ell}}\mid{\mathbf{z}}_{0}^{\color[rgb]{0.4688,0.4688,0.4688}\ell})\rightarrow 0" display="inline" intent=":literal"><semantics><mrow><mrow><mo rspace="0.167em">−</mo><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mrow><mi>p</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>𝐱</mi><mi style="--ltx-fg-color:#787878;" mathcolor="#787878" mathvariant="normal">ℓ</mi></msup><mo fence="true" lspace="0em" rspace="0em">∣</mo><msubsup><mi>𝐳</mi><mn>0</mn><mi style="--ltx-fg-color:#787878;" mathcolor="#787878" mathvariant="normal">ℓ</mi></msubsup><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo stretchy="false">→</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">-\log p({\mathbf{x}}^{{\color[rgb]{0.4688,0.4688,0.4688}\ell}}\mid{\mathbf{z}}_{0}^{\color[rgb]{0.4688,0.4688,0.4688}\ell})\rightarrow 0</annotation></semantics></math>. Furthermore, the prior term is zero by definition of the <math id="A1.SS3.p1.m13" class="ltx_Math" alttext="\Psi" display="inline" intent=":literal"><semantics><mi mathvariant="normal">Ψ</mi><annotation encoding="application/x-tex">\Psi</annotation></semantics></math>-posteriors in (<a href="#S3.E11" title="Equation 11 ‣ 3 The Ψ-Posteriors ‣ The Diffusion Duality, Chapter II: Ψ-Samplers and Efficient Curriculum" class="ltx_ref"><span class="ltx_text ltx_ref_tag">11</span></a>).</p>
</div>
</section>
<section id="A1.SS4" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">A.4 </span>Recovering Predictor-Corrector Methods for Masked Diffusion</h3>

<div id="A1.SS4.p1" class="ltx_para ltx_noindent">
<p id="A1.SS4.p1.1" class="ltx_p"><cite class="ltx_cite ltx_citemacro_citet"><a href="#bib.bib9" title="" class="ltx_ref">Wang et al. (2025)</a></cite> introduce the ReMDM posterior, which generalizes the MDM posterior (<a href="#S2.E2" title="Equation 2 ‣ 2.1.1 Masked Diffusion Processes ‣ 2.1 Discrete Diffusion Models ‣ 2 Background ‣ The Diffusion Duality, Chapter II: Ψ-Samplers and Efficient Curriculum" class="ltx_ref"><span class="ltx_text ltx_ref_tag">2</span></a>) by allowing previously decoded tokens to be remasked. For a given position <math id="A1.SS4.p1.m1" class="ltx_Math" alttext="\ell" display="inline" intent=":literal"><semantics><mi mathvariant="normal">ℓ</mi><annotation encoding="application/x-tex">\ell</annotation></semantics></math>, the ReMDM posterior is</p>
<table id="A1.E21" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A1.E21.m1" class="ltx_Math" alttext="q_{\sigma}({\mathbf{z}}_{s}^{\color[rgb]{0.4688,0.4688,0.4688}\ell}\mid{\mathbf{z}}_{t}^{\color[rgb]{0.4688,0.4688,0.4688}\ell},{\mathbf{x}}^{{\color[rgb]{0.4688,0.4688,0.4688}\ell}})=\begin{cases}\text{Cat}\bigl(.;\,(1-\sigma_{t})\,{\mathbf{x}}^{{\color[rgb]{0.4688,0.4688,0.4688}\ell}}+\sigma_{t}\,{\mathbf{m}}\bigr),&{\mathbf{z}}_{t}^{\color[rgb]{0.4688,0.4688,0.4688}\ell}\neq{\mathbf{m}},\\[4.0pt]
\text{Cat}\left(.;\,\frac{\alpha_{s}-(1{-}\sigma_{t})\alpha_{t}}{1-\alpha_{t}}\,{\mathbf{x}}^{{\color[rgb]{0.4688,0.4688,0.4688}\ell}}+\frac{1-\alpha_{s}-\sigma_{t}\alpha_{t}}{1-\alpha_{t}}\,{\mathbf{m}}\right),&{\mathbf{z}}_{t}^{\color[rgb]{0.4688,0.4688,0.4688}\ell}={\mathbf{m}},\end{cases}" display="block" intent=":literal"><semantics><mrow><mrow><msub><mi>q</mi><mi>σ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>𝐳</mi><mi>s</mi><mi style="--ltx-fg-color:#787878;" mathcolor="#787878" mathvariant="normal">ℓ</mi></msubsup><mo fence="true" lspace="0em" rspace="0em">∣</mo><mrow><msubsup><mi>𝐳</mi><mi>t</mi><mi style="--ltx-fg-color:#787878;" mathcolor="#787878" mathvariant="normal">ℓ</mi></msubsup><mo>,</mo><msup><mi>𝐱</mi><mi style="--ltx-fg-color:#787878;" mathcolor="#787878" mathvariant="normal">ℓ</mi></msup></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mo>{</mo><mtable columnspacing="5pt" displaystyle="true" rowspacing="0pt"><mtr><mtd class="ltx_align_left" columnalign="left"><mrow><mtext>Cat</mtext><mo maxsize="1.200em" minsize="1.200em">(</mo><mo lspace="0em" rspace="0.167em">.</mo><mo rspace="0.337em">;</mo><mo stretchy="false">(</mo><mn>1</mn><mo>−</mo><mi>σ</mi><msub><mrow></mrow><mi>t</mi></msub><mo rspace="0.170em" stretchy="false">)</mo><mi>𝐱</mi><msup><mrow></mrow><mi style="--ltx-fg-color:#787878;" mathcolor="#787878" mathvariant="normal">ℓ</mi></msup><mo>+</mo><mi>σ</mi><msub><mrow></mrow><mi>t</mi></msub><mi>𝐦</mi><mo maxsize="1.200em" minsize="1.200em">)</mo><mo>,</mo></mrow></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><msubsup><mi>𝐳</mi><mi>t</mi><mi style="--ltx-fg-color:#787878;" mathcolor="#787878" mathvariant="normal">ℓ</mi></msubsup><mo>≠</mo><mi>𝐦</mi></mrow><mo>,</mo></mrow></mtd></mtr><mtr><mtd class="ltx_align_left" columnalign="left"><mrow><mtext>Cat</mtext><mo>(</mo><mo lspace="0em" rspace="0.167em">.</mo><mo rspace="0.337em">;</mo><mstyle displaystyle="false"><mfrac><mrow><msub><mi>α</mi><mi>s</mi></msub><mo>−</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msub><mi>σ</mi><mi>t</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>α</mi><mi>t</mi></msub></mrow></mrow><mrow><mn>1</mn><mo>−</mo><msub><mi>α</mi><mi>t</mi></msub></mrow></mfrac></mstyle><mi>𝐱</mi><msup><mrow></mrow><mi style="--ltx-fg-color:#787878;" mathcolor="#787878" mathvariant="normal">ℓ</mi></msup><mo>+</mo><mstyle displaystyle="false"><mfrac><mrow><mn>1</mn><mo>−</mo><msub><mi>α</mi><mi>s</mi></msub><mo>−</mo><mrow><msub><mi>σ</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>α</mi><mi>t</mi></msub></mrow></mrow><mrow><mn>1</mn><mo>−</mo><msub><mi>α</mi><mi>t</mi></msub></mrow></mfrac></mstyle><mi>𝐦</mi><mo>)</mo><mo>,</mo></mrow></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><msubsup><mi>𝐳</mi><mi>t</mi><mi style="--ltx-fg-color:#787878;" mathcolor="#787878" mathvariant="normal">ℓ</mi></msubsup><mo>=</mo><mi>𝐦</mi></mrow><mo>,</mo></mrow></mtd></mtr></mtable></mrow></mrow><annotation encoding="application/x-tex">q_{\sigma}({\mathbf{z}}_{s}^{\color[rgb]{0.4688,0.4688,0.4688}\ell}\mid{\mathbf{z}}_{t}^{\color[rgb]{0.4688,0.4688,0.4688}\ell},{\mathbf{x}}^{{\color[rgb]{0.4688,0.4688,0.4688}\ell}})=\begin{cases}\text{Cat}\bigl(.;\,(1-\sigma_{t})\,{\mathbf{x}}^{{\color[rgb]{0.4688,0.4688,0.4688}\ell}}+\sigma_{t}\,{\mathbf{m}}\bigr),&amp;{\mathbf{z}}_{t}^{\color[rgb]{0.4688,0.4688,0.4688}\ell}\neq{\mathbf{m}},\\[4.0pt]
\text{Cat}\left(.;\,\frac{\alpha_{s}-(1{-}\sigma_{t})\alpha_{t}}{1-\alpha_{t}}\,{\mathbf{x}}^{{\color[rgb]{0.4688,0.4688,0.4688}\ell}}+\frac{1-\alpha_{s}-\sigma_{t}\alpha_{t}}{1-\alpha_{t}}\,{\mathbf{m}}\right),&amp;{\mathbf{z}}_{t}^{\color[rgb]{0.4688,0.4688,0.4688}\ell}={\mathbf{m}},\end{cases}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(21)</span></td></tr></tbody>
</table>
<p id="A1.SS4.p1.2" class="ltx_p">where <math id="A1.SS4.p1.m2" class="ltx_Math" alttext="\sigma_{t}\in[0,\,\sigma_{t}^{\max}]" display="inline" intent=":literal"><semantics><mrow><msub><mi>σ</mi><mi>t</mi></msub><mo>∈</mo><mrow><mo stretchy="false">[</mo><mrow><mn>0</mn><mo rspace="0.337em">,</mo><msubsup><mi>σ</mi><mi>t</mi><mi>max</mi></msubsup></mrow><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">\sigma_{t}\in[0,\,\sigma_{t}^{\max}]</annotation></semantics></math> is a free parameter that controls the remasking probability. The upper bound <math id="A1.SS4.p1.m3" class="ltx_Math" alttext="\sigma_{t}^{\max}:=\min\{1,\,(1-\alpha_{s})/\alpha_{t}\}" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>σ</mi><mi>t</mi><mi>max</mi></msubsup><mo>:=</mo><mrow><mi>min</mi><mo>⁡</mo><mrow><mo stretchy="false">{</mo><mn>1</mn><mo rspace="0.337em">,</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msub><mi>α</mi><mi>s</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mo>/</mo><msub><mi>α</mi><mi>t</mi></msub></mrow><mo stretchy="false">}</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\sigma_{t}^{\max}:=\min\{1,\,(1-\alpha_{s})/\alpha_{t}\}</annotation></semantics></math> ensures that (<a href="#A1.E21" title="Equation 21 ‣ A.4 Recovering Predictor-Corrector Methods for Masked Diffusion ‣ Appendix A Ψ-Posteriors ‣ The Diffusion Duality, Chapter II: Ψ-Samplers and Efficient Curriculum" class="ltx_ref"><span class="ltx_text ltx_ref_tag">21</span></a>) defines a valid distribution. When <math id="A1.SS4.p1.m4" class="ltx_Math" alttext="\sigma_{t}=0" display="inline" intent=":literal"><semantics><mrow><msub><mi>σ</mi><mi>t</mi></msub><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\sigma_{t}=0</annotation></semantics></math>, the ReMDM posterior reduces to the standard MDM posterior. Below, we show that the <math id="A1.SS4.p1.m5" class="ltx_Math" alttext="\Psi" display="inline" intent=":literal"><semantics><mi mathvariant="normal">Ψ</mi><annotation encoding="application/x-tex">\Psi</annotation></semantics></math>-posteriors recover the ReMDM posterior with the substitution <math id="A1.SS4.p1.m6" class="ltx_Math" alttext="\kappa_{t}=1-\sigma_{t}/(1-\alpha_{s})" display="inline" intent=":literal"><semantics><mrow><msub><mi>κ</mi><mi>t</mi></msub><mo>=</mo><mrow><mn>1</mn><mo>−</mo><mrow><msub><mi>σ</mi><mi>t</mi></msub><mo>/</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msub><mi>α</mi><mi>s</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\kappa_{t}=1-\sigma_{t}/(1-\alpha_{s})</annotation></semantics></math>. Suppose that we work with Masked diffusion, hence <math id="A1.SS4.p1.m7" class="ltx_Math" alttext="\pi={\mathbf{m}}" display="inline" intent=":literal"><semantics><mrow><mi>π</mi><mo>=</mo><mi>𝐦</mi></mrow><annotation encoding="application/x-tex">\pi={\mathbf{m}}</annotation></semantics></math>. The <math id="A1.SS4.p1.m8" class="ltx_Math" alttext="\Psi" display="inline" intent=":literal"><semantics><mi mathvariant="normal">Ψ</mi><annotation encoding="application/x-tex">\Psi</annotation></semantics></math>-posteriors can be expanded as</p>
<table id="A1.EGx14" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A1.Ex5"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.Ex5.m1" class="ltx_math_unparsed" alttext="\displaystyle\Psi_{s|t}(.|{\mathbf{z}}_{t}^{\color[rgb]{0.4688,0.4688,0.4688}\ell})" display="inline" intent=":literal"><semantics><mrow><msub><mi mathvariant="normal">Ψ</mi><mrow><mi>s</mi><mo fence="false">|</mo><mi>t</mi></mrow></msub><mrow><mo stretchy="false">(</mo><mo lspace="0em" rspace="0.167em">.</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><msubsup><mi>𝐳</mi><mi>t</mi><mi style="--ltx-fg-color:#787878;" mathcolor="#787878" mathvariant="normal">ℓ</mi></msubsup><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\Psi_{s|t}(.|{\mathbf{z}}_{t}^{\color[rgb]{0.4688,0.4688,0.4688}\ell})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A1.E22"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.E22.m1" class="ltx_math_unparsed" alttext="\displaystyle=\kappa_{t}{\color[rgb]{0.043,0.3242,0.5898}{q_{s|t}}}(.|{\mathbf{z}}_{t}^{\color[rgb]{0.4688,0.4688,0.4688}\ell},{\mathbf{x}}^{{\color[rgb]{0.4688,0.4688,0.4688}\ell}})+(1-\kappa_{t})\left[\alpha_{s}{\color[rgb]{0.043,0.3242,0.5898}q_{0|t}}(.|{\mathbf{z}}_{t}^{\color[rgb]{0.4688,0.4688,0.4688}\ell},{\mathbf{x}}^{{\color[rgb]{0.4688,0.4688,0.4688}\ell}})+(1-\alpha_{s})\pi\right]" display="inline" intent=":literal"><semantics><mrow><mo>=</mo><msub><mi>κ</mi><mi>t</mi></msub><msub><mi style="--ltx-fg-color:#0B5396;" mathcolor="#0B5396">q</mi><mrow><mi style="--ltx-fg-color:#0B5396;" mathcolor="#0B5396">s</mi><mo style="--ltx-fg-color:#000000;" fence="false" mathcolor="#000000">|</mo><mi style="--ltx-fg-color:#0B5396;" mathcolor="#0B5396">t</mi></mrow></msub><mrow><mo stretchy="false">(</mo><mo lspace="0em" rspace="0.167em">.</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><msubsup><mi>𝐳</mi><mi>t</mi><mi style="--ltx-fg-color:#787878;" mathcolor="#787878" mathvariant="normal">ℓ</mi></msubsup><mo>,</mo><msup><mi>𝐱</mi><mi style="--ltx-fg-color:#787878;" mathcolor="#787878" mathvariant="normal">ℓ</mi></msup><mo stretchy="false">)</mo></mrow><mo>+</mo><mrow><mo stretchy="false">(</mo><mn>1</mn><mo>−</mo><msub><mi>κ</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow><mrow><mo>[</mo><msub><mi>α</mi><mi>s</mi></msub><msub><mi style="--ltx-fg-color:#0B5396;" mathcolor="#0B5396">q</mi><mrow><mn style="--ltx-fg-color:#0B5396;" mathcolor="#0B5396">0</mn><mo style="--ltx-fg-color:#000000;" fence="false" mathcolor="#000000">|</mo><mi style="--ltx-fg-color:#0B5396;" mathcolor="#0B5396">t</mi></mrow></msub><mrow><mo stretchy="false">(</mo><mo lspace="0em" rspace="0.167em">.</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><msubsup><mi>𝐳</mi><mi>t</mi><mi style="--ltx-fg-color:#787878;" mathcolor="#787878" mathvariant="normal">ℓ</mi></msubsup><mo>,</mo><msup><mi>𝐱</mi><mi style="--ltx-fg-color:#787878;" mathcolor="#787878" mathvariant="normal">ℓ</mi></msup><mo stretchy="false">)</mo></mrow><mo>+</mo><mrow><mo stretchy="false">(</mo><mn>1</mn><mo>−</mo><msub><mi>α</mi><mi>s</mi></msub><mo stretchy="false">)</mo></mrow><mi>π</mi><mo>]</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\kappa_{t}{\color[rgb]{0.043,0.3242,0.5898}{q_{s|t}}}(.|{\mathbf{z}}_{t}^{\color[rgb]{0.4688,0.4688,0.4688}\ell},{\mathbf{x}}^{{\color[rgb]{0.4688,0.4688,0.4688}\ell}})+(1-\kappa_{t})\left[\alpha_{s}{\color[rgb]{0.043,0.3242,0.5898}q_{0|t}}(.|{\mathbf{z}}_{t}^{\color[rgb]{0.4688,0.4688,0.4688}\ell},{\mathbf{x}}^{{\color[rgb]{0.4688,0.4688,0.4688}\ell}})+(1-\alpha_{s})\pi\right]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(22)</span></td></tr></tbody>
<tbody id="A1.E23"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.E23.m1" class="ltx_Math" alttext="\displaystyle=\kappa_{t}\begin{cases}\begin{aligned} &amp;\text{Cat}(.;{\mathbf{z}}_{t}^{\color[rgb]{0.4688,0.4688,0.4688}\ell}),&{\mathbf{z}}_{t}^{\color[rgb]{0.4688,0.4688,0.4688}\ell}\neq{\mathbf{m}},\\
&amp;\text{Cat}\left(.;\frac{(1-\alpha_{s}){\mathbf{m}}+(\alpha_{s}-\alpha_{t}){\mathbf{x}}^{{\color[rgb]{0.4688,0.4688,0.4688}\ell}}}{1-\alpha_{t}}\right),&{\mathbf{z}}_{t}^{\color[rgb]{0.4688,0.4688,0.4688}\ell}={\mathbf{m}}\end{aligned}\end{cases}+(1-\kappa_{t})\left[\alpha_{s}{\mathbf{x}}^{{\color[rgb]{0.4688,0.4688,0.4688}\ell}}+(1-\alpha_{s}){\mathbf{m}}\right]" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><msub><mi>κ</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>{</mo><mtable columnspacing="5pt"><mtr><mtd class="ltx_align_left" columnalign="left"><mtable columnspacing="0pt" rowspacing="0pt"><mtr><mtd></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mtext>Cat</mtext><mo stretchy="false">(</mo><mo lspace="0em" rspace="0.167em">.</mo><mo>;</mo><mi>𝐳</mi><msub><mrow></mrow><mi>t</mi></msub><msup><mrow></mrow><mi style="--ltx-fg-color:#787878;" mathcolor="#787878" mathvariant="normal">ℓ</mi></msup><mo stretchy="false">)</mo><mo>,</mo></mrow></mtd><mtd class="ltx_align_right" columnalign="right"><mrow><mrow><msubsup><mi>𝐳</mi><mi>t</mi><mi style="--ltx-fg-color:#787878;" mathcolor="#787878" mathvariant="normal">ℓ</mi></msubsup><mo>≠</mo><mi>𝐦</mi></mrow><mo>,</mo></mrow></mtd></mtr><mtr><mtd></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mtext>Cat</mtext><mo>(</mo><mo lspace="0em" rspace="0.167em">.</mo><mo>;</mo><mstyle displaystyle="true"><mfrac><mrow><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msub><mi>α</mi><mi>s</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>𝐦</mi></mrow><mo>+</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><msub><mi>α</mi><mi>s</mi></msub><mo>−</mo><msub><mi>α</mi><mi>t</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝐱</mi><mi style="--ltx-fg-color:#787878;" mathcolor="#787878" mathvariant="normal">ℓ</mi></msup></mrow></mrow><mrow><mn>1</mn><mo>−</mo><msub><mi>α</mi><mi>t</mi></msub></mrow></mfrac></mstyle><mo>)</mo><mo>,</mo></mrow></mtd><mtd class="ltx_align_right" columnalign="right"><mrow><msubsup><mi>𝐳</mi><mi>t</mi><mi style="--ltx-fg-color:#787878;" mathcolor="#787878" mathvariant="normal">ℓ</mi></msubsup><mo>=</mo><mi>𝐦</mi></mrow></mtd></mtr></mtable></mtd><mtd></mtd></mtr></mtable></mrow></mrow><mo>+</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msub><mi>κ</mi><mi>t</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><mrow><mrow><msub><mi>α</mi><mi>s</mi></msub><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝐱</mi><mi style="--ltx-fg-color:#787878;" mathcolor="#787878" mathvariant="normal">ℓ</mi></msup></mrow><mo>+</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msub><mi>α</mi><mi>s</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>𝐦</mi></mrow></mrow><mo>]</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\kappa_{t}\begin{cases}\begin{aligned} &amp;\text{Cat}(.;{\mathbf{z}}_{t}^{\color[rgb]{0.4688,0.4688,0.4688}\ell}),&amp;{\mathbf{z}}_{t}^{\color[rgb]{0.4688,0.4688,0.4688}\ell}\neq{\mathbf{m}},\\
&amp;\text{Cat}\left(.;\frac{(1-\alpha_{s}){\mathbf{m}}+(\alpha_{s}-\alpha_{t}){\mathbf{x}}^{{\color[rgb]{0.4688,0.4688,0.4688}\ell}}}{1-\alpha_{t}}\right),&amp;{\mathbf{z}}_{t}^{\color[rgb]{0.4688,0.4688,0.4688}\ell}={\mathbf{m}}\end{aligned}\end{cases}+(1-\kappa_{t})\left[\alpha_{s}{\mathbf{x}}^{{\color[rgb]{0.4688,0.4688,0.4688}\ell}}+(1-\alpha_{s}){\mathbf{m}}\right]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(23)</span></td></tr></tbody>
<tbody id="A1.E24"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.E24.m1" class="ltx_Math" alttext="\displaystyle\stackrel{{\scriptstyle(1)}}{{=}}\kappa_{t}\begin{cases}\begin{aligned} &amp;\text{Cat}(.;{\mathbf{x}}^{{\color[rgb]{0.4688,0.4688,0.4688}\ell}}),&{\mathbf{z}}_{t}^{\color[rgb]{0.4688,0.4688,0.4688}\ell}\neq{\mathbf{m}},\\
&amp;\text{Cat}\left(.;\frac{(1-\alpha_{s}){\mathbf{m}}+(\alpha_{s}-\alpha_{t}){\mathbf{x}}^{{\color[rgb]{0.4688,0.4688,0.4688}\ell}}}{1-\alpha_{t}}\right),&{\mathbf{z}}_{t}^{\color[rgb]{0.4688,0.4688,0.4688}\ell}={\mathbf{m}}\end{aligned}\end{cases}+(1-\kappa_{t})\left[\alpha_{s}{\mathbf{x}}^{{\color[rgb]{0.4688,0.4688,0.4688}\ell}}+(1-\alpha_{s}){\mathbf{m}}\right]" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mover><mo>=</mo><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></mover><mrow><mrow><msub><mi>κ</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>{</mo><mtable columnspacing="5pt"><mtr><mtd class="ltx_align_left" columnalign="left"><mtable columnspacing="0pt" rowspacing="0pt"><mtr><mtd></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mtext>Cat</mtext><mo stretchy="false">(</mo><mo lspace="0em" rspace="0.167em">.</mo><mo>;</mo><mi>𝐱</mi><msup><mrow></mrow><mi style="--ltx-fg-color:#787878;" mathcolor="#787878" mathvariant="normal">ℓ</mi></msup><mo stretchy="false">)</mo><mo>,</mo></mrow></mtd><mtd class="ltx_align_right" columnalign="right"><mrow><mrow><msubsup><mi>𝐳</mi><mi>t</mi><mi style="--ltx-fg-color:#787878;" mathcolor="#787878" mathvariant="normal">ℓ</mi></msubsup><mo>≠</mo><mi>𝐦</mi></mrow><mo>,</mo></mrow></mtd></mtr><mtr><mtd></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mtext>Cat</mtext><mo>(</mo><mo lspace="0em" rspace="0.167em">.</mo><mo>;</mo><mstyle displaystyle="true"><mfrac><mrow><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msub><mi>α</mi><mi>s</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>𝐦</mi></mrow><mo>+</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><msub><mi>α</mi><mi>s</mi></msub><mo>−</mo><msub><mi>α</mi><mi>t</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝐱</mi><mi style="--ltx-fg-color:#787878;" mathcolor="#787878" mathvariant="normal">ℓ</mi></msup></mrow></mrow><mrow><mn>1</mn><mo>−</mo><msub><mi>α</mi><mi>t</mi></msub></mrow></mfrac></mstyle><mo>)</mo><mo>,</mo></mrow></mtd><mtd class="ltx_align_right" columnalign="right"><mrow><msubsup><mi>𝐳</mi><mi>t</mi><mi style="--ltx-fg-color:#787878;" mathcolor="#787878" mathvariant="normal">ℓ</mi></msubsup><mo>=</mo><mi>𝐦</mi></mrow></mtd></mtr></mtable></mtd><mtd></mtd></mtr></mtable></mrow></mrow><mo>+</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msub><mi>κ</mi><mi>t</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><mrow><mrow><msub><mi>α</mi><mi>s</mi></msub><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝐱</mi><mi style="--ltx-fg-color:#787878;" mathcolor="#787878" mathvariant="normal">ℓ</mi></msup></mrow><mo>+</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msub><mi>α</mi><mi>s</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>𝐦</mi></mrow></mrow><mo>]</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\stackrel{{\scriptstyle(1)}}{{=}}\kappa_{t}\begin{cases}\begin{aligned} &amp;\text{Cat}(.;{\mathbf{x}}^{{\color[rgb]{0.4688,0.4688,0.4688}\ell}}),&amp;{\mathbf{z}}_{t}^{\color[rgb]{0.4688,0.4688,0.4688}\ell}\neq{\mathbf{m}},\\
&amp;\text{Cat}\left(.;\frac{(1-\alpha_{s}){\mathbf{m}}+(\alpha_{s}-\alpha_{t}){\mathbf{x}}^{{\color[rgb]{0.4688,0.4688,0.4688}\ell}}}{1-\alpha_{t}}\right),&amp;{\mathbf{z}}_{t}^{\color[rgb]{0.4688,0.4688,0.4688}\ell}={\mathbf{m}}\end{aligned}\end{cases}+(1-\kappa_{t})\left[\alpha_{s}{\mathbf{x}}^{{\color[rgb]{0.4688,0.4688,0.4688}\ell}}+(1-\alpha_{s}){\mathbf{m}}\right]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(24)</span></td></tr></tbody>
<tbody id="A1.E25"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.E25.m1" class="ltx_Math" alttext="\displaystyle=\begin{cases}\text{Cat}(.;\kappa_{t}{\mathbf{x}}^{{\color[rgb]{0.4688,0.4688,0.4688}\ell}}+(1-\kappa_{t})[\alpha_{s}{\mathbf{x}}^{{\color[rgb]{0.4688,0.4688,0.4688}\ell}}+(1-\alpha_{s}){\mathbf{m}}]),&{\mathbf{z}}_{t}^{\color[rgb]{0.4688,0.4688,0.4688}\ell}\neq{\mathbf{m}}\\
\text{Cat}\left(.;\kappa_{t}\frac{(1-\alpha_{s}){\mathbf{m}}+(\alpha_{s}-\alpha_{t}){\mathbf{x}}^{{\color[rgb]{0.4688,0.4688,0.4688}\ell}}}{1-\alpha_{t}}+(1-\kappa_{t})[\alpha_{s}{\mathbf{x}}^{{\color[rgb]{0.4688,0.4688,0.4688}\ell}}+(1-\alpha_{s}){\mathbf{m}}]\right),&{\mathbf{z}}_{t}^{\color[rgb]{0.4688,0.4688,0.4688}\ell}={\mathbf{m}}\end{cases}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mo>{</mo><mtable columnspacing="5pt" rowspacing="0pt"><mtr><mtd class="ltx_align_left" columnalign="left"><mrow><mtext>Cat</mtext><mo stretchy="false">(</mo><mo lspace="0em" rspace="0.167em">.</mo><mo>;</mo><mi>κ</mi><msub><mrow></mrow><mi>t</mi></msub><mi>𝐱</mi><msup><mrow></mrow><mi style="--ltx-fg-color:#787878;" mathcolor="#787878" mathvariant="normal">ℓ</mi></msup><mo>+</mo><mo stretchy="false">(</mo><mn>1</mn><mo>−</mo><mi>κ</mi><msub><mrow></mrow><mi>t</mi></msub><mo stretchy="false">)</mo><mo stretchy="false">[</mo><mi>α</mi><msub><mrow></mrow><mi>s</mi></msub><mi>𝐱</mi><msup><mrow></mrow><mi style="--ltx-fg-color:#787878;" mathcolor="#787878" mathvariant="normal">ℓ</mi></msup><mo>+</mo><mo stretchy="false">(</mo><mn>1</mn><mo>−</mo><mi>α</mi><msub><mrow></mrow><mi>s</mi></msub><mo stretchy="false">)</mo><mi>𝐦</mi><mo stretchy="false">]</mo><mo stretchy="false">)</mo><mo>,</mo></mrow></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><msubsup><mi>𝐳</mi><mi>t</mi><mi style="--ltx-fg-color:#787878;" mathcolor="#787878" mathvariant="normal">ℓ</mi></msubsup><mo>≠</mo><mi>𝐦</mi></mrow></mtd></mtr><mtr><mtd class="ltx_align_left" columnalign="left"><mrow><mtext>Cat</mtext><mo>(</mo><mo lspace="0em" rspace="0.167em">.</mo><mo>;</mo><mi>κ</mi><msub><mrow></mrow><mi>t</mi></msub><mfrac><mrow><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msub><mi>α</mi><mi>s</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>𝐦</mi></mrow><mo>+</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><msub><mi>α</mi><mi>s</mi></msub><mo>−</mo><msub><mi>α</mi><mi>t</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝐱</mi><mi style="--ltx-fg-color:#787878;" mathcolor="#787878" mathvariant="normal">ℓ</mi></msup></mrow></mrow><mrow><mn>1</mn><mo>−</mo><msub><mi>α</mi><mi>t</mi></msub></mrow></mfrac><mo>+</mo><mo stretchy="false">(</mo><mn>1</mn><mo>−</mo><mi>κ</mi><msub><mrow></mrow><mi>t</mi></msub><mo stretchy="false">)</mo><mo stretchy="false">[</mo><mi>α</mi><msub><mrow></mrow><mi>s</mi></msub><mi>𝐱</mi><msup><mrow></mrow><mi style="--ltx-fg-color:#787878;" mathcolor="#787878" mathvariant="normal">ℓ</mi></msup><mo>+</mo><mo stretchy="false">(</mo><mn>1</mn><mo>−</mo><mi>α</mi><msub><mrow></mrow><mi>s</mi></msub><mo stretchy="false">)</mo><mi>𝐦</mi><mo stretchy="false">]</mo><mo>)</mo><mo>,</mo></mrow></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><msubsup><mi>𝐳</mi><mi>t</mi><mi style="--ltx-fg-color:#787878;" mathcolor="#787878" mathvariant="normal">ℓ</mi></msubsup><mo>=</mo><mi>𝐦</mi></mrow></mtd></mtr></mtable></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\begin{cases}\text{Cat}(.;\kappa_{t}{\mathbf{x}}^{{\color[rgb]{0.4688,0.4688,0.4688}\ell}}+(1-\kappa_{t})[\alpha_{s}{\mathbf{x}}^{{\color[rgb]{0.4688,0.4688,0.4688}\ell}}+(1-\alpha_{s}){\mathbf{m}}]),&amp;{\mathbf{z}}_{t}^{\color[rgb]{0.4688,0.4688,0.4688}\ell}\neq{\mathbf{m}}\\
\text{Cat}\left(.;\kappa_{t}\frac{(1-\alpha_{s}){\mathbf{m}}+(\alpha_{s}-\alpha_{t}){\mathbf{x}}^{{\color[rgb]{0.4688,0.4688,0.4688}\ell}}}{1-\alpha_{t}}+(1-\kappa_{t})[\alpha_{s}{\mathbf{x}}^{{\color[rgb]{0.4688,0.4688,0.4688}\ell}}+(1-\alpha_{s}){\mathbf{m}}]\right),&amp;{\mathbf{z}}_{t}^{\color[rgb]{0.4688,0.4688,0.4688}\ell}={\mathbf{m}}\end{cases}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(25)</span></td></tr></tbody>
<tbody id="A1.E26"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.E26.m1" class="ltx_Math" alttext="\displaystyle=\begin{cases}\text{Cat}(.;[\kappa_{t}+(1-\kappa_{t})\alpha_{s}]{\mathbf{x}}^{{\color[rgb]{0.4688,0.4688,0.4688}\ell}}+(1-\kappa_{t})(1-\alpha_{s}){\mathbf{m}}),&{\mathbf{z}}_{t}^{\color[rgb]{0.4688,0.4688,0.4688}\ell}\neq{\mathbf{m}}\\
\text{Cat}\left(.;\left[\kappa_{t}\frac{\alpha_{s}-\alpha_{t}}{1-\alpha_{t}}+(1-\kappa_{t})\alpha_{s}\right]{\mathbf{x}}^{{\color[rgb]{0.4688,0.4688,0.4688}\ell}}+\left[\kappa_{t}\frac{1-\alpha_{s}}{1-\alpha_{t}}+(1-\kappa_{t})(1-\alpha_{s})\right]{\mathbf{m}}\right),&{\mathbf{z}}_{t}^{\color[rgb]{0.4688,0.4688,0.4688}\ell}={\mathbf{m}}\end{cases}," display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>=</mo><mrow><mo>{</mo><mtable columnspacing="5pt" rowspacing="0pt"><mtr><mtd class="ltx_align_left" columnalign="left"><mrow><mtext>Cat</mtext><mo stretchy="false">(</mo><mo lspace="0em" rspace="0.167em">.</mo><mo>;</mo><mo stretchy="false">[</mo><mi>κ</mi><msub><mrow></mrow><mi>t</mi></msub><mo>+</mo><mo stretchy="false">(</mo><mn>1</mn><mo>−</mo><mi>κ</mi><msub><mrow></mrow><mi>t</mi></msub><mo stretchy="false">)</mo><mi>α</mi><msub><mrow></mrow><mi>s</mi></msub><mo stretchy="false">]</mo><mi>𝐱</mi><msup><mrow></mrow><mi style="--ltx-fg-color:#787878;" mathcolor="#787878" mathvariant="normal">ℓ</mi></msup><mo>+</mo><mo stretchy="false">(</mo><mn>1</mn><mo>−</mo><mi>κ</mi><msub><mrow></mrow><mi>t</mi></msub><mo stretchy="false">)</mo><mo stretchy="false">(</mo><mn>1</mn><mo>−</mo><mi>α</mi><msub><mrow></mrow><mi>s</mi></msub><mo stretchy="false">)</mo><mi>𝐦</mi><mo stretchy="false">)</mo><mo>,</mo></mrow></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><msubsup><mi>𝐳</mi><mi>t</mi><mi style="--ltx-fg-color:#787878;" mathcolor="#787878" mathvariant="normal">ℓ</mi></msubsup><mo>≠</mo><mi>𝐦</mi></mrow></mtd></mtr><mtr><mtd class="ltx_align_left" columnalign="left"><mrow><mtext>Cat</mtext><mo>(</mo><mo lspace="0em" rspace="0.167em">.</mo><mo>;</mo><mo>[</mo><mi>κ</mi><msub><mrow></mrow><mi>t</mi></msub><mfrac><mrow><msub><mi>α</mi><mi>s</mi></msub><mo>−</mo><msub><mi>α</mi><mi>t</mi></msub></mrow><mrow><mn>1</mn><mo>−</mo><msub><mi>α</mi><mi>t</mi></msub></mrow></mfrac><mo>+</mo><mo stretchy="false">(</mo><mn>1</mn><mo>−</mo><mi>κ</mi><msub><mrow></mrow><mi>t</mi></msub><mo stretchy="false">)</mo><mi>α</mi><msub><mrow></mrow><mi>s</mi></msub><mo>]</mo><mi>𝐱</mi><msup><mrow></mrow><mi style="--ltx-fg-color:#787878;" mathcolor="#787878" mathvariant="normal">ℓ</mi></msup><mo>+</mo><mo>[</mo><mi>κ</mi><msub><mrow></mrow><mi>t</mi></msub><mfrac><mrow><mn>1</mn><mo>−</mo><msub><mi>α</mi><mi>s</mi></msub></mrow><mrow><mn>1</mn><mo>−</mo><msub><mi>α</mi><mi>t</mi></msub></mrow></mfrac><mo>+</mo><mo stretchy="false">(</mo><mn>1</mn><mo>−</mo><mi>κ</mi><msub><mrow></mrow><mi>t</mi></msub><mo stretchy="false">)</mo><mo stretchy="false">(</mo><mn>1</mn><mo>−</mo><mi>α</mi><msub><mrow></mrow><mi>s</mi></msub><mo stretchy="false">)</mo><mo>]</mo><mi>𝐦</mi><mo>)</mo><mo>,</mo></mrow></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><msubsup><mi>𝐳</mi><mi>t</mi><mi style="--ltx-fg-color:#787878;" mathcolor="#787878" mathvariant="normal">ℓ</mi></msubsup><mo>=</mo><mi>𝐦</mi></mrow></mtd></mtr></mtable></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle=\begin{cases}\text{Cat}(.;[\kappa_{t}+(1-\kappa_{t})\alpha_{s}]{\mathbf{x}}^{{\color[rgb]{0.4688,0.4688,0.4688}\ell}}+(1-\kappa_{t})(1-\alpha_{s}){\mathbf{m}}),&amp;{\mathbf{z}}_{t}^{\color[rgb]{0.4688,0.4688,0.4688}\ell}\neq{\mathbf{m}}\\
\text{Cat}\left(.;\left[\kappa_{t}\frac{\alpha_{s}-\alpha_{t}}{1-\alpha_{t}}+(1-\kappa_{t})\alpha_{s}\right]{\mathbf{x}}^{{\color[rgb]{0.4688,0.4688,0.4688}\ell}}+\left[\kappa_{t}\frac{1-\alpha_{s}}{1-\alpha_{t}}+(1-\kappa_{t})(1-\alpha_{s})\right]{\mathbf{m}}\right),&amp;{\mathbf{z}}_{t}^{\color[rgb]{0.4688,0.4688,0.4688}\ell}={\mathbf{m}}\end{cases},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(26)</span></td></tr></tbody>
</table>
<p id="A1.SS4.p1.3" class="ltx_p">where <math id="A1.SS4.p1.m9" class="ltx_Math" alttext="(1)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(1)</annotation></semantics></math> holds since <math id="A1.SS4.p1.m10" class="ltx_Math" alttext="{\mathbf{z}}_{t}^{\color[rgb]{0.4688,0.4688,0.4688}\ell}\neq{\mathbf{m}}" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>𝐳</mi><mi>t</mi><mi style="--ltx-fg-color:#787878;" mathcolor="#787878" mathvariant="normal">ℓ</mi></msubsup><mo>≠</mo><mi>𝐦</mi></mrow><annotation encoding="application/x-tex">{\mathbf{z}}_{t}^{\color[rgb]{0.4688,0.4688,0.4688}\ell}\neq{\mathbf{m}}</annotation></semantics></math> implies that <math id="A1.SS4.p1.m11" class="ltx_Math" alttext="{\mathbf{z}}_{t}^{\color[rgb]{0.4688,0.4688,0.4688}\ell}={\mathbf{x}}^{{\color[rgb]{0.4688,0.4688,0.4688}\ell}}" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>𝐳</mi><mi>t</mi><mi style="--ltx-fg-color:#787878;" mathcolor="#787878" mathvariant="normal">ℓ</mi></msubsup><mo>=</mo><msup><mi>𝐱</mi><mi style="--ltx-fg-color:#787878;" mathcolor="#787878" mathvariant="normal">ℓ</mi></msup></mrow><annotation encoding="application/x-tex">{\mathbf{z}}_{t}^{\color[rgb]{0.4688,0.4688,0.4688}\ell}={\mathbf{x}}^{{\color[rgb]{0.4688,0.4688,0.4688}\ell}}</annotation></semantics></math>, since in Masked diffusion, the latents <math id="A1.SS4.p1.m12" class="ltx_Math" alttext="{\mathbf{z}}_{t}^{\color[rgb]{0.4688,0.4688,0.4688}\ell}" display="inline" intent=":literal"><semantics><msubsup><mi>𝐳</mi><mi>t</mi><mi style="--ltx-fg-color:#787878;" mathcolor="#787878" mathvariant="normal">ℓ</mi></msubsup><annotation encoding="application/x-tex">{\mathbf{z}}_{t}^{\color[rgb]{0.4688,0.4688,0.4688}\ell}</annotation></semantics></math> are either a clean token or the masked token.</p>
</div>
<div id="A1.SS4.p2" class="ltx_para ltx_noindent">
<p id="A1.SS4.p2.1" class="ltx_p">To conclude, if we pick <math id="A1.SS4.p2.m1" class="ltx_Math" alttext="\kappa_{t}=1-\frac{\sigma_{t}}{1-\alpha_{s}}" display="inline" intent=":literal"><semantics><mrow><msub><mi>κ</mi><mi>t</mi></msub><mo>=</mo><mrow><mn>1</mn><mo>−</mo><mfrac><msub><mi>σ</mi><mi>t</mi></msub><mrow><mn>1</mn><mo>−</mo><msub><mi>α</mi><mi>s</mi></msub></mrow></mfrac></mrow></mrow><annotation encoding="application/x-tex">\kappa_{t}=1-\frac{\sigma_{t}}{1-\alpha_{s}}</annotation></semantics></math>, where <math id="A1.SS4.p2.m2" class="ltx_Math" alttext="\sigma_{t}" display="inline" intent=":literal"><semantics><msub><mi>σ</mi><mi>t</mi></msub><annotation encoding="application/x-tex">\sigma_{t}</annotation></semantics></math> is the free parameter in the ReMDM sampler, then the equation reduces to the ReMDM posterior. Therefore, the <math id="A1.SS4.p2.m3" class="ltx_Math" alttext="\Psi" display="inline" intent=":literal"><semantics><mi mathvariant="normal">Ψ</mi><annotation encoding="application/x-tex">\Psi</annotation></semantics></math>-posteriors generalize ReMDM, which itself generalized the FB <cite class="ltx_cite ltx_citemacro_citep">(<a href="#bib.bib49" title="" class="ltx_ref">Campbell et al., 2022</a>)</cite> and DFM <cite class="ltx_cite ltx_citemacro_citep">(<a href="#bib.bib47" title="" class="ltx_ref">Gat et al., 2024</a>)</cite> posteriors. Additionally, the <math id="A1.SS4.p2.m4" class="ltx_Math" alttext="\Psi" display="inline" intent=":literal"><semantics><mi mathvariant="normal">Ψ</mi><annotation encoding="application/x-tex">\Psi</annotation></semantics></math>-posteriors are not limited to Masked diffusion, as we showed in this work. In Table <a href="#A4.T11" title="Table 11 ‣ D.3 Training Efficiency of Our Fast Curriculum ‣ Appendix D Additional Experimental results ‣ The Diffusion Duality, Chapter II: Ψ-Samplers and Efficient Curriculum" class="ltx_ref"><span class="ltx_text ltx_ref_tag">11</span></a>, we sample from the ReMDM-equivalent <math id="A1.SS4.p2.m5" class="ltx_Math" alttext="\Psi" display="inline" intent=":literal"><semantics><mi mathvariant="normal">Ψ</mi><annotation encoding="application/x-tex">\Psi</annotation></semantics></math>-samplers, comparing the official ReMDM implementation and our version, and find obtain similar performance.</p>
</div>
</section>
<section id="A1.SS5" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">A.5 </span>ReMDM Sampling Schedules</h3>

<div id="A1.SS5.p1" class="ltx_para ltx_noindent">
<p id="A1.SS5.p1.1" class="ltx_p"><cite class="ltx_cite ltx_citemacro_citet"><a href="#bib.bib9" title="" class="ltx_ref">Wang et al. (2025)</a></cite> introduce three schedules for the remasking parameter <math id="A1.SS5.p1.m1" class="ltx_Math" alttext="\sigma_{t}" display="inline" intent=":literal"><semantics><msub><mi>σ</mi><mi>t</mi></msub><annotation encoding="application/x-tex">\sigma_{t}</annotation></semantics></math>, which controls how aggressively previously generated tokens are remasked. As shown in Suppl. <a href="#A1.SS4" title="A.4 Recovering Predictor-Corrector Methods for Masked Diffusion ‣ Appendix A Ψ-Posteriors ‣ The Diffusion Duality, Chapter II: Ψ-Samplers and Efficient Curriculum" class="ltx_ref"><span class="ltx_text ltx_ref_tag">A.4</span></a>, the <math id="A1.SS5.p1.m2" class="ltx_Math" alttext="\Psi" display="inline" intent=":literal"><semantics><mi mathvariant="normal">Ψ</mi><annotation encoding="application/x-tex">\Psi</annotation></semantics></math>-samplers recover ReMDM when <span id="A1.SS5.p1.1.1" class="ltx_text"><math id="A1.SS5.p1.m3" class="ltx_Math" alttext="\kappa_{t}=1-\sigma_{t}/(1-\alpha_{s})" display="inline" intent=":literal"><semantics><mrow><msub><mi>κ</mi><mi>t</mi></msub><mo>=</mo><mrow><mn>1</mn><mo>−</mo><mrow><msub><mi>σ</mi><mi>t</mi></msub><mo>/</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msub><mi>α</mi><mi>s</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\kappa_{t}=1-\sigma_{t}/(1-\alpha_{s})</annotation></semantics></math></span>, and <math id="A1.SS5.p1.m4" class="ltx_Math" alttext="(\sigma_{t})_{t=0}^{1}" display="inline" intent=":literal"><semantics><msubsup><mrow><mo stretchy="false">(</mo><msub><mi>σ</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow><mrow><mi>t</mi><mo>=</mo><mn>0</mn></mrow><mn>1</mn></msubsup><annotation encoding="application/x-tex">(\sigma_{t})_{t=0}^{1}</annotation></semantics></math> denotes the ReMDM noise injection schedule. Therefore, each ReMDM <math id="A1.SS5.p1.m5" class="ltx_Math" alttext="\sigma_{t}" display="inline" intent=":literal"><semantics><msub><mi>σ</mi><mi>t</mi></msub><annotation encoding="application/x-tex">\sigma_{t}</annotation></semantics></math> schedule has a direct <math id="A1.SS5.p1.m6" class="ltx_Math" alttext="\Psi" display="inline" intent=":literal"><semantics><mi mathvariant="normal">Ψ</mi><annotation encoding="application/x-tex">\Psi</annotation></semantics></math>-samplers equivalent. Below, we present the three <math id="A1.SS5.p1.m7" class="ltx_Math" alttext="\sigma_{t}" display="inline" intent=":literal"><semantics><msub><mi>σ</mi><mi>t</mi></msub><annotation encoding="application/x-tex">\sigma_{t}</annotation></semantics></math> schedules studied in <cite class="ltx_cite ltx_citemacro_citet"><a href="#bib.bib9" title="" class="ltx_ref">Wang et al. (2025)</a></cite>. The schedules must satisfy <math id="A1.SS5.p1.m8" class="ltx_Math" alttext="0\leq\sigma_{t}\leq\sigma_{t}^{\max}:=\min\{1,\,(1-\alpha_{s})/\alpha_{t}\}" display="inline" intent=":literal"><semantics><mrow><mn>0</mn><mo>≤</mo><msub><mi>σ</mi><mi>t</mi></msub><mo>≤</mo><msubsup><mi>σ</mi><mi>t</mi><mi>max</mi></msubsup><mo>:=</mo><mrow><mi>min</mi><mo>⁡</mo><mrow><mo stretchy="false">{</mo><mn>1</mn><mo rspace="0.337em">,</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msub><mi>α</mi><mi>s</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mo>/</mo><msub><mi>α</mi><mi>t</mi></msub></mrow><mo stretchy="false">}</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">0\leq\sigma_{t}\leq\sigma_{t}^{\max}:=\min\{1,\,(1-\alpha_{s})/\alpha_{t}\}</annotation></semantics></math> to ensure that the reverse posterior remains a valid distribution, and are generally defined in terms of <math id="A1.SS5.p1.m9" class="ltx_Math" alttext="\sigma_{t}^{\max}" display="inline" intent=":literal"><semantics><msubsup><mi>σ</mi><mi>t</mi><mi>max</mi></msubsup><annotation encoding="application/x-tex">\sigma_{t}^{\max}</annotation></semantics></math> and a parameter <math id="A1.SS5.p1.m10" class="ltx_Math" alttext="\eta\in[0,1]" display="inline" intent=":literal"><semantics><mrow><mi>η</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mrow><mn>0</mn><mo>,</mo><mn>1</mn></mrow><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">\eta\in[0,1]</annotation></semantics></math>.</p>
</div>
<section id="A1.SS5.SSS0.Px1" class="ltx_paragraph">
<h5 class="ltx_title ltx_title_paragraph">Cap Schedule</h5>

<div id="A1.SS5.SSS0.Px1.p1" class="ltx_para ltx_noindent">
<p id="A1.SS5.SSS0.Px1.p1.1" class="ltx_p">With the “Cap” schedule, the remasking probability is capped at a constant <math id="A1.SS5.SSS0.Px1.p1.m1" class="ltx_Math" alttext="\eta\in[0,1]" display="inline" intent=":literal"><semantics><mrow><mi>η</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mrow><mn>0</mn><mo>,</mo><mn>1</mn></mrow><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">\eta\in[0,1]</annotation></semantics></math>, as long as it remains in the valid bounds:</p>
<table id="A1.E27" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A1.E27.m1" class="ltx_Math" alttext="\sigma_{t}=\min\bigl\{\eta,\,\sigma_{t}^{\max}\bigr\}." display="block" intent=":literal"><semantics><mrow><mrow><msub><mi>σ</mi><mi>t</mi></msub><mo>=</mo><mrow><mi>min</mi><mo>⁡</mo><mrow><mo stretchy="false">{</mo><mi>η</mi><mo rspace="0.337em">,</mo><msubsup><mi>σ</mi><mi>t</mi><mi>max</mi></msubsup><mo stretchy="false">}</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\sigma_{t}=\min\bigl\{\eta,\,\sigma_{t}^{\max}\bigr\}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(27)</span></td></tr></tbody>
</table>
</div>
</section>
<section id="A1.SS5.SSS0.Px2" class="ltx_paragraph">
<h5 class="ltx_title ltx_title_paragraph">Rescale Schedule</h5>

<div id="A1.SS5.SSS0.Px2.p1" class="ltx_para ltx_noindent">
<p id="A1.SS5.SSS0.Px2.p1.1" class="ltx_p">With the “Rescale” schedule, <math id="A1.SS5.SSS0.Px2.p1.m1" class="ltx_Math" alttext="\sigma_{t}" display="inline" intent=":literal"><semantics><msub><mi>σ</mi><mi>t</mi></msub><annotation encoding="application/x-tex">\sigma_{t}</annotation></semantics></math> is obtained by scaling the upper bound <math id="A1.SS5.SSS0.Px2.p1.m2" class="ltx_Math" alttext="\sigma_{t}^{\max}" display="inline" intent=":literal"><semantics><msubsup><mi>σ</mi><mi>t</mi><mi>max</mi></msubsup><annotation encoding="application/x-tex">\sigma_{t}^{\max}</annotation></semantics></math> by a constant <math id="A1.SS5.SSS0.Px2.p1.m3" class="ltx_Math" alttext="\eta\in[0,1]" display="inline" intent=":literal"><semantics><mrow><mi>η</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mrow><mn>0</mn><mo>,</mo><mn>1</mn></mrow><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">\eta\in[0,1]</annotation></semantics></math>:</p>
<table id="A1.E28" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A1.E28.m1" class="ltx_Math" alttext="\sigma_{t}=\eta\cdot\sigma_{t}^{\max}." display="block" intent=":literal"><semantics><mrow><mrow><msub><mi>σ</mi><mi>t</mi></msub><mo>=</mo><mrow><mi>η</mi><mo lspace="0.222em" rspace="0.222em">⋅</mo><msubsup><mi>σ</mi><mi>t</mi><mi>max</mi></msubsup></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\sigma_{t}=\eta\cdot\sigma_{t}^{\max}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(28)</span></td></tr></tbody>
</table>
</div>
</section>
<section id="A1.SS5.SSS0.Px3" class="ltx_paragraph">
<h5 class="ltx_title ltx_title_paragraph">Loop Schedule</h5>

<div id="A1.SS5.SSS0.Px3.p1" class="ltx_para ltx_noindent">
<p id="A1.SS5.SSS0.Px3.p1.1" class="ltx_p">Unlike the cap and rescale schedules, which only modulate <math id="A1.SS5.SSS0.Px3.p1.m1" class="ltx_Math" alttext="\sigma_{t}" display="inline" intent=":literal"><semantics><msub><mi>σ</mi><mi>t</mi></msub><annotation encoding="application/x-tex">\sigma_{t}</annotation></semantics></math>, the “Loop” schedule also changes the evolution of <math id="A1.SS5.SSS0.Px3.p1.m2" class="ltx_Math" alttext="t" display="inline" intent=":literal"><semantics><mi>t</mi><annotation encoding="application/x-tex">t</annotation></semantics></math> during sampling (see Fig. <a href="#S5.F4" title="Figure 4 ‣ Experimental Settings ‣ 5.1.1 Language Modeling ‣ 5.1 Ψ-Samplers ‣ 5 Experiments ‣ The Diffusion Duality, Chapter II: Ψ-Samplers and Efficient Curriculum" class="ltx_ref"><span class="ltx_text ltx_ref_tag">4</span></a> for an illustration). It is controlled by the time boundaries <math id="A1.SS5.SSS0.Px3.p1.m3" class="ltx_Math" alttext="t_{\text{on}}&gt;t_{\text{off}}" display="inline" intent=":literal"><semantics><mrow><msub><mi>t</mi><mtext>on</mtext></msub><mo>&gt;</mo><msub><mi>t</mi><mtext>off</mtext></msub></mrow><annotation encoding="application/x-tex">t_{\text{on}}&gt;t_{\text{off}}</annotation></semantics></math>. The noise schedule <math id="A1.SS5.SSS0.Px3.p1.m4" class="ltx_Math" alttext="\alpha_{t}" display="inline" intent=":literal"><semantics><msub><mi>α</mi><mi>t</mi></msub><annotation encoding="application/x-tex">\alpha_{t}</annotation></semantics></math> is reparametrized to be piecewise linear. First, <math id="A1.SS5.SSS0.Px3.p1.m5" class="ltx_Math" alttext="\alpha_{t}" display="inline" intent=":literal"><semantics><msub><mi>α</mi><mi>t</mi></msub><annotation encoding="application/x-tex">\alpha_{t}</annotation></semantics></math> increases linearly from <math id="A1.SS5.SSS0.Px3.p1.m6" class="ltx_Math" alttext="0" display="inline" intent=":literal"><semantics><mn>0</mn><annotation encoding="application/x-tex">0</annotation></semantics></math> to <math id="A1.SS5.SSS0.Px3.p1.m7" class="ltx_Math" alttext="\alpha_{t_{\text{on}}}" display="inline" intent=":literal"><semantics><msub><mi>α</mi><msub><mi>t</mi><mtext>on</mtext></msub></msub><annotation encoding="application/x-tex">\alpha_{t_{\text{on}}}</annotation></semantics></math> when <math id="A1.SS5.SSS0.Px3.p1.m8" class="ltx_Math" alttext="t&gt;t_{\text{on}}" display="inline" intent=":literal"><semantics><mrow><mi>t</mi><mo>&gt;</mo><msub><mi>t</mi><mtext>on</mtext></msub></mrow><annotation encoding="application/x-tex">t&gt;t_{\text{on}}</annotation></semantics></math>. Secondly, when <math id="A1.SS5.SSS0.Px3.p1.m9" class="ltx_Math" alttext="t\in[t_{\text{off}},\,t_{\text{on}}]" display="inline" intent=":literal"><semantics><mrow><mi>t</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mrow><msub><mi>t</mi><mtext>off</mtext></msub><mo rspace="0.337em">,</mo><msub><mi>t</mi><mtext>on</mtext></msub></mrow><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">t\in[t_{\text{off}},\,t_{\text{on}}]</annotation></semantics></math>, it is held constant to <math id="A1.SS5.SSS0.Px3.p1.m10" class="ltx_Math" alttext="\alpha_{t_{\text{on}}}" display="inline" intent=":literal"><semantics><msub><mi>α</mi><msub><mi>t</mi><mtext>on</mtext></msub></msub><annotation encoding="application/x-tex">\alpha_{t_{\text{on}}}</annotation></semantics></math>, and finally increases from <math id="A1.SS5.SSS0.Px3.p1.m11" class="ltx_Math" alttext="\alpha_{t_{\text{on}}}" display="inline" intent=":literal"><semantics><msub><mi>α</mi><msub><mi>t</mi><mtext>on</mtext></msub></msub><annotation encoding="application/x-tex">\alpha_{t_{\text{on}}}</annotation></semantics></math> to <math id="A1.SS5.SSS0.Px3.p1.m12" class="ltx_Math" alttext="1" display="inline" intent=":literal"><semantics><mn>1</mn><annotation encoding="application/x-tex">1</annotation></semantics></math> when <math id="A1.SS5.SSS0.Px3.p1.m13" class="ltx_Math" alttext="t&lt;t_{\text{off}}" display="inline" intent=":literal"><semantics><mrow><mi>t</mi><mo>&lt;</mo><msub><mi>t</mi><mtext>off</mtext></msub></mrow><annotation encoding="application/x-tex">t&lt;t_{\text{off}}</annotation></semantics></math>. When <math id="A1.SS5.SSS0.Px3.p1.m14" class="ltx_Math" alttext="t\notin[t_{\text{off}},\,t_{\text{on}}]" display="inline" intent=":literal"><semantics><mrow><mi>t</mi><mo>∉</mo><mrow><mo stretchy="false">[</mo><mrow><msub><mi>t</mi><mtext>off</mtext></msub><mo rspace="0.337em">,</mo><msub><mi>t</mi><mtext>on</mtext></msub></mrow><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">t\notin[t_{\text{off}},\,t_{\text{on}}]</annotation></semantics></math>, ReMDM samples from the MDM posterior (<a href="#S2.E2" title="Equation 2 ‣ 2.1.1 Masked Diffusion Processes ‣ 2.1 Discrete Diffusion Models ‣ 2 Background ‣ The Diffusion Duality, Chapter II: Ψ-Samplers and Efficient Curriculum" class="ltx_ref"><span class="ltx_text ltx_ref_tag">2</span></a>). When <math id="A1.SS5.SSS0.Px3.p1.m15" class="ltx_Math" alttext="t\in[t_{\text{off}},\,t_{\text{on}}]" display="inline" intent=":literal"><semantics><mrow><mi>t</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mrow><msub><mi>t</mi><mtext>off</mtext></msub><mo rspace="0.337em">,</mo><msub><mi>t</mi><mtext>on</mtext></msub></mrow><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">t\in[t_{\text{off}},\,t_{\text{on}}]</annotation></semantics></math>, since <math id="A1.SS5.SSS0.Px3.p1.m16" class="ltx_Math" alttext="\alpha_{t}=\alpha_{s}=\alpha_{t_{\text{on}}}" display="inline" intent=":literal"><semantics><mrow><msub><mi>α</mi><mi>t</mi></msub><mo>=</mo><msub><mi>α</mi><mi>s</mi></msub><mo>=</mo><msub><mi>α</mi><msub><mi>t</mi><mtext>on</mtext></msub></msub></mrow><annotation encoding="application/x-tex">\alpha_{t}=\alpha_{s}=\alpha_{t_{\text{on}}}</annotation></semantics></math>, the model samples from the ReMDM posterior (<a href="#A1.E21" title="Equation 21 ‣ A.4 Recovering Predictor-Corrector Methods for Masked Diffusion ‣ Appendix A Ψ-Posteriors ‣ The Diffusion Duality, Chapter II: Ψ-Samplers and Efficient Curriculum" class="ltx_ref"><span class="ltx_text ltx_ref_tag">21</span></a>) with a constant <math id="A1.SS5.SSS0.Px3.p1.m17" class="ltx_Math" alttext="\sigma_{t}=\eta" display="inline" intent=":literal"><semantics><mrow><msub><mi>σ</mi><mi>t</mi></msub><mo>=</mo><mi>η</mi></mrow><annotation encoding="application/x-tex">\sigma_{t}=\eta</annotation></semantics></math>. In practice, <math id="A1.SS5.SSS0.Px3.p1.m18" class="ltx_Math" alttext="t_{\text{on}}" display="inline" intent=":literal"><semantics><msub><mi>t</mi><mtext>on</mtext></msub><annotation encoding="application/x-tex">t_{\text{on}}</annotation></semantics></math> is chosen so that <math id="A1.SS5.SSS0.Px3.p1.m19" class="ltx_Math" alttext="\alpha_{t_{\text{on}}}" display="inline" intent=":literal"><semantics><msub><mi>α</mi><msub><mi>t</mi><mtext>on</mtext></msub></msub><annotation encoding="application/x-tex">\alpha_{t_{\text{on}}}</annotation></semantics></math> is close to <math id="A1.SS5.SSS0.Px3.p1.m20" class="ltx_Math" alttext="1" display="inline" intent=":literal"><semantics><mn>1</mn><annotation encoding="application/x-tex">1</annotation></semantics></math>, where most tokens have already been decoded.</p>
</div>
</section>
</section>
</section>
<section id="A2" class="ltx_appendix">
<h2 class="ltx_title ltx_title_appendix"><span class="ltx_tag ltx_tag_appendix">Appendix B </span>Fast Curriculum</h2>

<div id="A2.p1" class="ltx_para ltx_noindent">
<p id="A2.p1.1" class="ltx_p">In this section, we expand on the implementation of the efficient curriculum. In Sec. <a href="#A2.SS4" title="B.4 Implementation of the Fast Curriculum ‣ Appendix B Fast Curriculum ‣ The Diffusion Duality, Chapter II: Ψ-Samplers and Efficient Curriculum" class="ltx_ref"><span class="ltx_text ltx_ref_tag">B.4</span></a>, we present the overall design, pseudocode, and the three main implementation challenges.
Our approach relies on several mathematical results, which we present in order of dependency. We first recall inverse transform sampling (Sec. <a href="#A2.SS1.SSS1" title="B.1.1 Inverse Transform Sampling ‣ B.1 Sampling the top-𝑘 values in 𝐰_𝑡^ℓ Without Materializing The Full Vector ‣ Appendix B Fast Curriculum ‣ The Diffusion Duality, Chapter II: Ψ-Samplers and Efficient Curriculum" class="ltx_ref"><span class="ltx_text ltx_ref_tag">B.1.1</span></a>), then derive the distributions of the largest (Sec. <a href="#A2.SS1.SSS2" title="B.1.2 Distribution of the largest uniform random variable out of 𝐾 ‣ B.1 Sampling the top-𝑘 values in 𝐰_𝑡^ℓ Without Materializing The Full Vector ‣ Appendix B Fast Curriculum ‣ The Diffusion Duality, Chapter II: Ψ-Samplers and Efficient Curriculum" class="ltx_ref"><span class="ltx_text ltx_ref_tag">B.1.2</span></a>) and second largest (Sec. <a href="#A2.SS1.SSS3" title="B.1.3 Distribution of the 𝑘 largest uniform random variable out of 𝐾 ‣ B.1 Sampling the top-𝑘 values in 𝐰_𝑡^ℓ Without Materializing The Full Vector ‣ Appendix B Fast Curriculum ‣ The Diffusion Duality, Chapter II: Ψ-Samplers and Efficient Curriculum" class="ltx_ref"><span class="ltx_text ltx_ref_tag">B.1.3</span></a>) uniform order statistics. These results enable generating the <math id="A2.p1.m1" class="ltx_Math" alttext="k" display="inline" intent=":literal"><semantics><mi>k</mi><annotation encoding="application/x-tex">k</annotation></semantics></math> largest Gaussian random variables out of <math id="A2.p1.m2" class="ltx_Math" alttext="K" display="inline" intent=":literal"><semantics><mi>K</mi><annotation encoding="application/x-tex">K</annotation></semantics></math> without materializing the full vector (Sec. <a href="#A2.SS1.SSS4" title="B.1.4 Generating the 𝑘 largest Gaussian random variables out of 𝐾 ‣ B.1 Sampling the top-𝑘 values in 𝐰_𝑡^ℓ Without Materializing The Full Vector ‣ Appendix B Fast Curriculum ‣ The Diffusion Duality, Chapter II: Ψ-Samplers and Efficient Curriculum" class="ltx_ref"><span class="ltx_text ltx_ref_tag">B.1.4</span></a>). We also derive a closed-form expression for the conditional mean of the exponential of a Gaussian random variable (Sec. <a href="#A2.SS2" title="B.2 Approximating the Weighted Sum of the Embeddings ‣ Appendix B Fast Curriculum ‣ The Diffusion Duality, Chapter II: Ψ-Samplers and Efficient Curriculum" class="ltx_ref"><span class="ltx_text ltx_ref_tag">B.2</span></a>), used to estimate the softmax normalizer.</p>
</div>
<div id="A2.p2" class="ltx_para ltx_noindent">
<p id="A2.p2.1" class="ltx_p">Furthermore, although the efficient curriculum could be implemented using the original definition of the Diffusion Transformation Operator <math id="A2.p2.m1" class="ltx_Math" alttext="{\color[rgb]{0.6055,0,0}\mathcal{T}}" display="inline" intent=":literal"><semantics><mi style="--ltx-fg-color:#9A0000;" class="ltx_font_mathcaligraphic" mathcolor="#9A0000">𝒯</mi><annotation encoding="application/x-tex">{\color[rgb]{0.6055,0,0}\mathcal{T}}</annotation></semantics></math>, we show that <math id="A2.p2.m2" class="ltx_Math" alttext="{\color[rgb]{0.6055,0,0}\mathcal{T}}" display="inline" intent=":literal"><semantics><mi style="--ltx-fg-color:#9A0000;" class="ltx_font_mathcaligraphic" mathcolor="#9A0000">𝒯</mi><annotation encoding="application/x-tex">{\color[rgb]{0.6055,0,0}\mathcal{T}}</annotation></semantics></math> admits a convenient series expansion in Sec. <a href="#A2.SS3.SSS1" title="B.3.1 Series Representation of 𝒯 and ∂_𝑡𝒯 ‣ B.3 Efficient computation of 𝒯 During Training ‣ Appendix B Fast Curriculum ‣ The Diffusion Duality, Chapter II: Ψ-Samplers and Efficient Curriculum" class="ltx_ref"><span class="ltx_text ltx_ref_tag">B.3.1</span></a>. This avoids the need to precompute 100k function values, and simplifies the implementation. Finally, in Sec. <a href="#A2.SS3.SSS2" title="B.3.2 Polynomial Approximation of 𝒯 ‣ B.3 Efficient computation of 𝒯 During Training ‣ Appendix B Fast Curriculum ‣ The Diffusion Duality, Chapter II: Ψ-Samplers and Efficient Curriculum" class="ltx_ref"><span class="ltx_text ltx_ref_tag">B.3.2</span></a>, we show that <math id="A2.p2.m3" class="ltx_Math" alttext="{\color[rgb]{0.6055,0,0}\mathcal{T}}" display="inline" intent=":literal"><semantics><mi style="--ltx-fg-color:#9A0000;" class="ltx_font_mathcaligraphic" mathcolor="#9A0000">𝒯</mi><annotation encoding="application/x-tex">{\color[rgb]{0.6055,0,0}\mathcal{T}}</annotation></semantics></math> can be well approximated by a degree-<math id="A2.p2.m4" class="ltx_Math" alttext="9" display="inline" intent=":literal"><semantics><mn>9</mn><annotation encoding="application/x-tex">9</annotation></semantics></math> polynomial, which removes the need to store a large number of coefficients during training.</p>
</div>
<section id="A2.SS1" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">B.1 </span>Sampling the top-<math id="A2.SS1.m1" class="ltx_Math" alttext="k" display="inline" intent=":literal"><semantics><mi>k</mi><annotation encoding="application/x-tex">k</annotation></semantics></math> values in <math id="A2.SS1.m2" class="ltx_Math" alttext="{\mathbf{w}}_{t}^{{\color[rgb]{0.4688,0.4688,0.4688}\ell}}" display="inline" intent=":literal"><semantics><msubsup><mi>𝐰</mi><mi>t</mi><mi style="--ltx-fg-color:#787878;" mathcolor="#787878" mathvariant="normal">ℓ</mi></msubsup><annotation encoding="application/x-tex">{\mathbf{w}}_{t}^{{\color[rgb]{0.4688,0.4688,0.4688}\ell}}</annotation></semantics></math> Without Materializing The Full Vector</h3>

<div id="A2.SS1.p1" class="ltx_para ltx_noindent">
<p id="A2.SS1.p1.1" class="ltx_p">Computing our curriculum step requires access to the <math id="A2.SS1.p1.m1" class="ltx_Math" alttext="k" display="inline" intent=":literal"><semantics><mi>k</mi><annotation encoding="application/x-tex">k</annotation></semantics></math> largest entries of the diffused weight vector <math id="A2.SS1.p1.m2" class="ltx_Math" alttext="{\mathbf{w}}_{t}^{{\color[rgb]{0.4688,0.4688,0.4688}\ell}}\in\mathbb{R}^{K}" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>𝐰</mi><mi>t</mi><mi style="--ltx-fg-color:#787878;" mathcolor="#787878" mathvariant="normal">ℓ</mi></msubsup><mo>∈</mo><msup><mi>ℝ</mi><mi>K</mi></msup></mrow><annotation encoding="application/x-tex">{\mathbf{w}}_{t}^{{\color[rgb]{0.4688,0.4688,0.4688}\ell}}\in\mathbb{R}^{K}</annotation></semantics></math>, but explicitly materializing <math id="A2.SS1.p1.m3" class="ltx_Math" alttext="{\mathbf{w}}_{t}^{{\color[rgb]{0.4688,0.4688,0.4688}\ell}}" display="inline" intent=":literal"><semantics><msubsup><mi>𝐰</mi><mi>t</mi><mi style="--ltx-fg-color:#787878;" mathcolor="#787878" mathvariant="normal">ℓ</mi></msubsup><annotation encoding="application/x-tex">{\mathbf{w}}_{t}^{{\color[rgb]{0.4688,0.4688,0.4688}\ell}}</annotation></semantics></math> (and then running a full top-<math id="A2.SS1.p1.m4" class="ltx_Math" alttext="k" display="inline" intent=":literal"><semantics><mi>k</mi><annotation encoding="application/x-tex">k</annotation></semantics></math>) is prohibitively expensive when <math id="A2.SS1.p1.m5" class="ltx_Math" alttext="K" display="inline" intent=":literal"><semantics><mi>K</mi><annotation encoding="application/x-tex">K</annotation></semantics></math> is large. In this subsection, we show how to obtain the top-<math id="A2.SS1.p1.m6" class="ltx_Math" alttext="k" display="inline" intent=":literal"><semantics><mi>k</mi><annotation encoding="application/x-tex">k</annotation></semantics></math> values and their associated indices while using only <math id="A2.SS1.p1.m7" class="ltx_Math" alttext="\mathcal{O}(k)" display="inline" intent=":literal"><semantics><mrow><mi class="ltx_font_mathcaligraphic">𝒪</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>k</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathcal{O}(k)</annotation></semantics></math> memory and without simulating all <math id="A2.SS1.p1.m8" class="ltx_Math" alttext="K" display="inline" intent=":literal"><semantics><mi>K</mi><annotation encoding="application/x-tex">K</annotation></semantics></math> random variables. The key idea is to decouple <em id="A2.SS1.p1.1.1" class="ltx_emph ltx_font_italic">values</em> from <em id="A2.SS1.p1.1.2" class="ltx_emph ltx_font_italic">locations</em>: we first sample the top-<math id="A2.SS1.p1.m9" class="ltx_Math" alttext="k" display="inline" intent=":literal"><semantics><mi>k</mi><annotation encoding="application/x-tex">k</annotation></semantics></math> Gaussian order statistics directly via inverse transform sampling (Sec. <a href="#A2.SS1.SSS1" title="B.1.1 Inverse Transform Sampling ‣ B.1 Sampling the top-𝑘 values in 𝐰_𝑡^ℓ Without Materializing The Full Vector ‣ Appendix B Fast Curriculum ‣ The Diffusion Duality, Chapter II: Ψ-Samplers and Efficient Curriculum" class="ltx_ref"><span class="ltx_text ltx_ref_tag">B.1.1</span></a>), leveraging closed-form expressions for uniform order statistics (Sec. <a href="#A2.SS1.SSS2" title="B.1.2 Distribution of the largest uniform random variable out of 𝐾 ‣ B.1 Sampling the top-𝑘 values in 𝐰_𝑡^ℓ Without Materializing The Full Vector ‣ Appendix B Fast Curriculum ‣ The Diffusion Duality, Chapter II: Ψ-Samplers and Efficient Curriculum" class="ltx_ref"><span class="ltx_text ltx_ref_tag">B.1.2</span></a>, Sec. <a href="#A2.SS1.SSS3" title="B.1.3 Distribution of the 𝑘 largest uniform random variable out of 𝐾 ‣ B.1 Sampling the top-𝑘 values in 𝐰_𝑡^ℓ Without Materializing The Full Vector ‣ Appendix B Fast Curriculum ‣ The Diffusion Duality, Chapter II: Ψ-Samplers and Efficient Curriculum" class="ltx_ref"><span class="ltx_text ltx_ref_tag">B.1.3</span></a>) and a numerically stable log-space implementation (Algo. <a href="#alg1" title='Algorithm 1 ‣ Sampling The 𝑘^"th"-largest ‣ B.1.4 Generating the 𝑘 largest Gaussian random variables out of 𝐾 ‣ B.1 Sampling the top-𝑘 values in 𝐰_𝑡^ℓ Without Materializing The Full Vector ‣ Appendix B Fast Curriculum ‣ The Diffusion Duality, Chapter II: Ψ-Samplers and Efficient Curriculum' class="ltx_ref"><span class="ltx_text ltx_ref_tag">1</span></a>). We then assign these top-<math id="A2.SS1.p1.m10" class="ltx_Math" alttext="k" display="inline" intent=":literal"><semantics><mi>k</mi><annotation encoding="application/x-tex">k</annotation></semantics></math> to their corresponding indices (Sec. <a href="#A2.SS1.SSS5" title="B.1.5 Sampling Integers Without Repetitions and Without Shuffling ‣ B.1 Sampling the top-𝑘 values in 𝐰_𝑡^ℓ Without Materializing The Full Vector ‣ Appendix B Fast Curriculum ‣ The Diffusion Duality, Chapter II: Ψ-Samplers and Efficient Curriculum" class="ltx_ref"><span class="ltx_text ltx_ref_tag">B.1.5</span></a>, Algo. <a href="#alg2" title="Algorithm 2 ‣ B.1.5 Sampling Integers Without Repetitions and Without Shuffling ‣ B.1 Sampling the top-𝑘 values in 𝐰_𝑡^ℓ Without Materializing The Full Vector ‣ Appendix B Fast Curriculum ‣ The Diffusion Duality, Chapter II: Ψ-Samplers and Efficient Curriculum" class="ltx_ref"><span class="ltx_text ltx_ref_tag">2</span></a>). This yields an efficient routine whose cost scales with <math id="A2.SS1.p1.m11" class="ltx_Math" alttext="k" display="inline" intent=":literal"><semantics><mi>k</mi><annotation encoding="application/x-tex">k</annotation></semantics></math> rather than <math id="A2.SS1.p1.m12" class="ltx_Math" alttext="K" display="inline" intent=":literal"><semantics><mi>K</mi><annotation encoding="application/x-tex">K</annotation></semantics></math>, enabling top-<math id="A2.SS1.p1.m13" class="ltx_Math" alttext="k" display="inline" intent=":literal"><semantics><mi>k</mi><annotation encoding="application/x-tex">k</annotation></semantics></math> truncation of <math id="A2.SS1.p1.m14" class="ltx_Math" alttext="{\mathbf{w}}_{t}^{{\color[rgb]{0.4688,0.4688,0.4688}\ell}}" display="inline" intent=":literal"><semantics><msubsup><mi>𝐰</mi><mi>t</mi><mi style="--ltx-fg-color:#787878;" mathcolor="#787878" mathvariant="normal">ℓ</mi></msubsup><annotation encoding="application/x-tex">{\mathbf{w}}_{t}^{{\color[rgb]{0.4688,0.4688,0.4688}\ell}}</annotation></semantics></math> without ever materializing it.</p>
</div>
<section id="A2.SS1.SSS1" class="ltx_subsubsection">
<h4 class="ltx_title ltx_title_subsubsection"><span class="ltx_tag ltx_tag_subsubsection">B.1.1 </span>Inverse Transform Sampling</h4>

<div id="A2.SS1.SSS1.p1" class="ltx_para ltx_noindent">
<p id="A2.SS1.SSS1.p1.1" class="ltx_p">The Inverse Transform Sampling method <cite class="ltx_cite ltx_citemacro_citep">(<a href="#bib.bib2" title="" class="ltx_ref">Devroye, 1986</a>)</cite> is an algorithm for generating a continuous random variables <math id="A2.SS1.SSS1.p1.m1" class="ltx_Math" alttext="X" display="inline" intent=":literal"><semantics><mi>X</mi><annotation encoding="application/x-tex">X</annotation></semantics></math> with a known Cumulative Distribution Function (CDF) <math id="A2.SS1.SSS1.p1.m2" class="ltx_Math" alttext="F_{X}" display="inline" intent=":literal"><semantics><msub><mi>F</mi><mi>X</mi></msub><annotation encoding="application/x-tex">F_{X}</annotation></semantics></math>. Implementing Inverse Transform Sampling requires access to the inverse CDF <math id="A2.SS1.SSS1.p1.m3" class="ltx_Math" alttext="F^{-1}_{X}" display="inline" intent=":literal"><semantics><msubsup><mi>F</mi><mi>X</mi><mrow><mo>−</mo><mn>1</mn></mrow></msubsup><annotation encoding="application/x-tex">F^{-1}_{X}</annotation></semantics></math>, and a source of <math id="A2.SS1.SSS1.p1.m4" class="ltx_Math" alttext="i.i.d" display="inline" intent=":literal"><semantics><mrow><mi>i</mi><mo lspace="0em" rspace="0.167em">.</mo><mi>i</mi><mo lspace="0em" rspace="0.167em">.</mo><mi>d</mi></mrow><annotation encoding="application/x-tex">i.i.d</annotation></semantics></math> uniform random variables. If <math id="A2.SS1.SSS1.p1.m5" class="ltx_Math" alttext="X=F^{-1}_{X}(U)" display="inline" intent=":literal"><semantics><mrow><mi>X</mi><mo>=</mo><mrow><msubsup><mi>F</mi><mi>X</mi><mrow><mo>−</mo><mn>1</mn></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>U</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">X=F^{-1}_{X}(U)</annotation></semantics></math>, where <math id="A2.SS1.SSS1.p1.m6" class="ltx_Math" alttext="U\sim\mathcal{U}[0,1]" display="inline" intent=":literal"><semantics><mrow><mi>U</mi><mo>∼</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒰</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><mn>0</mn><mo>,</mo><mn>1</mn></mrow><mo stretchy="false">]</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">U\sim\mathcal{U}[0,1]</annotation></semantics></math>, then <math id="A2.SS1.SSS1.p1.m7" class="ltx_Math" alttext="X\sim F_{X}" display="inline" intent=":literal"><semantics><mrow><mi>X</mi><mo>∼</mo><msub><mi>F</mi><mi>X</mi></msub></mrow><annotation encoding="application/x-tex">X\sim F_{X}</annotation></semantics></math>. Indeed, for <math id="A2.SS1.SSS1.p1.m8" class="ltx_Math" alttext="x\in\mathbb{R}" display="inline" intent=":literal"><semantics><mrow><mi>x</mi><mo>∈</mo><mi>ℝ</mi></mrow><annotation encoding="application/x-tex">x\in\mathbb{R}</annotation></semantics></math>,</p>
<table id="A2.E29" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A2.E29.m1" class="ltx_Math" alttext="\mathbb{P}(X\leq x)=\mathbb{P}(F^{-1}_{X}(U)\leq x)=\mathbb{P}(U\leq F_{X}(x))=F_{X}(x)," display="block" intent=":literal"><semantics><mrow><mrow><mrow><mi>ℙ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>X</mi><mo>≤</mo><mi>x</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mi>ℙ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><msubsup><mi>F</mi><mi>X</mi><mrow><mo>−</mo><mn>1</mn></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>U</mi><mo stretchy="false">)</mo></mrow></mrow><mo>≤</mo><mi>x</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mi>ℙ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>U</mi><mo>≤</mo><mrow><msub><mi>F</mi><mi>X</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><msub><mi>F</mi><mi>X</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\mathbb{P}(X\leq x)=\mathbb{P}(F^{-1}_{X}(U)\leq x)=\mathbb{P}(U\leq F_{X}(x))=F_{X}(x),</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(29)</span></td></tr></tbody>
</table>
<p id="A2.SS1.SSS1.p1.2" class="ltx_p">since for <math id="A2.SS1.SSS1.p1.m9" class="ltx_Math" alttext="a\in[0,1]" display="inline" intent=":literal"><semantics><mrow><mi>a</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mrow><mn>0</mn><mo>,</mo><mn>1</mn></mrow><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">a\in[0,1]</annotation></semantics></math>, <math id="A2.SS1.SSS1.p1.m10" class="ltx_Math" alttext="\mathbb{P}(U\leq a)=a" display="inline" intent=":literal"><semantics><mrow><mrow><mi>ℙ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>U</mi><mo>≤</mo><mi>a</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mi>a</mi></mrow><annotation encoding="application/x-tex">\mathbb{P}(U\leq a)=a</annotation></semantics></math>. This shows that <math id="A2.SS1.SSS1.p1.m11" class="ltx_Math" alttext="X" display="inline" intent=":literal"><semantics><mi>X</mi><annotation encoding="application/x-tex">X</annotation></semantics></math> has the correct distribution.</p>
</div>
</section>
<section id="A2.SS1.SSS2" class="ltx_subsubsection">
<h4 class="ltx_title ltx_title_subsubsection"><span class="ltx_tag ltx_tag_subsubsection">B.1.2 </span>Distribution of the largest uniform random variable out of <math id="A2.SS1.SSS2.m1" class="ltx_Math" alttext="K" display="inline" intent=":literal"><semantics><mi>K</mi><annotation encoding="application/x-tex">K</annotation></semantics></math></h4>

<div id="A2.SS1.SSS2.p1" class="ltx_para ltx_noindent">
<p id="A2.SS1.SSS2.p1.1" class="ltx_p">The distribution of the largest uniform random variable out of <math id="A2.SS1.SSS2.p1.m1" class="ltx_Math" alttext="K" display="inline" intent=":literal"><semantics><mi>K</mi><annotation encoding="application/x-tex">K</annotation></semantics></math> admits a simple closed-form expression:</p>
</div>
<div id="A2.Thmtheorem1" class="ltx_theorem ltx_theorem_proposition">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="A2.Thmtheorem1.2" class="ltx_text ltx_font_bold">Proposition B.1</span></span><span id="A2.Thmtheorem1.3" class="ltx_text ltx_font_bold"> </span>(Distribution of the largest uniform random variable out of <math id="A2.Thmtheorem1.m1" class="ltx_Math" alttext="K" display="inline" intent=":literal"><semantics><mi>K</mi><annotation encoding="application/x-tex">K</annotation></semantics></math>)<span id="A2.Thmtheorem1.4" class="ltx_text ltx_font_bold">.</span></h6>
<div id="A2.Thmtheorem1.p1" class="ltx_para ltx_noindent">
<p id="A2.Thmtheorem1.p1.1" class="ltx_p"><math id="A2.Thmtheorem1.p1.m1" class="ltx_Math" alttext="U^{(1)}\geq U^{(2)}\geq...\geq U^{(K)}" display="inline" intent=":literal"><semantics><mrow><msup><mi>U</mi><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msup><mo>≥</mo><msup><mi>U</mi><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msup><mo>≥</mo><mi mathvariant="normal">…</mi><mo>≥</mo><msup><mi>U</mi><mrow><mo stretchy="false">(</mo><mi>K</mi><mo stretchy="false">)</mo></mrow></msup></mrow><annotation encoding="application/x-tex">U^{(1)}\geq U^{(2)}\geq...\geq U^{(K)}</annotation></semantics></math><span id="A2.Thmtheorem1.p1.1.1" class="ltx_text ltx_font_italic"> denote an order statistic over <math id="A2.Thmtheorem1.p1.m2" class="ltx_Math" alttext="K" display="inline" intent=":literal"><semantics><mi>K</mi><annotation encoding="application/x-tex">K</annotation></semantics></math> i.i.d uniform random variables <math id="A2.Thmtheorem1.p1.m3" class="ltx_Math" alttext="\mathcal{U}([0,\theta])" display="inline" intent=":literal"><semantics><mrow><mi class="ltx_font_mathcaligraphic">𝒰</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mo stretchy="false">[</mo><mrow><mn>0</mn><mo>,</mo><mi>θ</mi></mrow><mo stretchy="false">]</mo></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathcal{U}([0,\theta])</annotation></semantics></math> with Cumulative Density Function (CDF) <math id="A2.Thmtheorem1.p1.m4" class="ltx_Math" alttext="F_{U}" display="inline" intent=":literal"><semantics><msub><mi>F</mi><mi>U</mi></msub><annotation encoding="application/x-tex">F_{U}</annotation></semantics></math>. Suppose that <math id="A2.Thmtheorem1.p1.m5" class="ltx_Math" alttext="u\in[0,1]" display="inline" intent=":literal"><semantics><mrow><mi>u</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mrow><mn>0</mn><mo>,</mo><mn>1</mn></mrow><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">u\in[0,1]</annotation></semantics></math>, then <math id="A2.Thmtheorem1.p1.m6" class="ltx_Math" alttext="F_{U}(u)=\frac{u}{\theta}" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>F</mi><mi>U</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>u</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mfrac><mi>u</mi><mi>θ</mi></mfrac></mrow><annotation encoding="application/x-tex">F_{U}(u)=\frac{u}{\theta}</annotation></semantics></math>. Then, the CDF <math id="A2.Thmtheorem1.p1.m7" class="ltx_Math" alttext="F_{U^{(1)}}" display="inline" intent=":literal"><semantics><msub><mi>F</mi><msup><mi>U</mi><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msup></msub><annotation encoding="application/x-tex">F_{U^{(1)}}</annotation></semantics></math> and probability density function (PDF) <math id="A2.Thmtheorem1.p1.m8" class="ltx_Math" alttext="f_{U^{(1)}}" display="inline" intent=":literal"><semantics><msub><mi>f</mi><msup><mi>U</mi><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msup></msub><annotation encoding="application/x-tex">f_{U^{(1)}}</annotation></semantics></math> of the largest random variable <math id="A2.Thmtheorem1.p1.m9" class="ltx_Math" alttext="U^{(1)}" display="inline" intent=":literal"><semantics><msup><mi>U</mi><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msup><annotation encoding="application/x-tex">U^{(1)}</annotation></semantics></math> are as follows:</span></p>
<table id="A2.E30" class="ltx_equationgroup ltx_eqn_table">
<tbody>
<tr id="A2.E30X" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A2.E30X.m2" class="ltx_Math" alttext="\displaystyle F_{U^{(1)}}(u)" display="inline" intent=":literal"><semantics><mrow><msub><mi>F</mi><msup><mi>U</mi><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msup></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>u</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle F_{U^{(1)}}(u)</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.E30X.m3" class="ltx_Math" alttext="\displaystyle=F_{U}^{K}(u)=u^{K}\theta^{-K}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><msubsup><mi>F</mi><mi>U</mi><mi>K</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>u</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><msup><mi>u</mi><mi>K</mi></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>θ</mi><mrow><mo>−</mo><mi>K</mi></mrow></msup></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=F_{U}^{K}(u)=u^{K}\theta^{-K}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="2" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equationgroup ltx_align_right">(30)</span></td></tr>
<tr id="A2.E30Xa" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A2.E30Xa.m2" class="ltx_Math" alttext="\displaystyle f_{U^{(1)}}(u)" display="inline" intent=":literal"><semantics><mrow><msub><mi>f</mi><msup><mi>U</mi><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msup></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>u</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle f_{U^{(1)}}(u)</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.E30Xa.m3" class="ltx_Math" alttext="\displaystyle=KF_{U}^{K-1}(u)f_{U}(u)=Ku^{K-1}\theta^{-K}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mi>K</mi><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>F</mi><mi>U</mi><mrow><mi>K</mi><mo>−</mo><mn>1</mn></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>u</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>f</mi><mi>U</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>u</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mi>K</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>u</mi><mrow><mi>K</mi><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>θ</mi><mrow><mo>−</mo><mi>K</mi></mrow></msup></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=KF_{U}^{K-1}(u)f_{U}(u)=Ku^{K-1}\theta^{-K}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
</div>
<div id="A2.SS1.SSS2.2" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="A2.SS1.SSS2.p2" class="ltx_para ltx_noindent">
<table id="A2.E31" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A2.E31.m1" class="ltx_Math" alttext="F_{U^{(1)}}(u)=\mathbb{P}(U^{(1)}\leq u)=\mathbb{P}(U_{i}\leq u)_{\forall i\in[K]}=P(U\leq u)^{K}=F_{U}^{K}(u)." display="block" intent=":literal"><semantics><mrow><mrow><mrow><msub><mi>F</mi><msup><mi>U</mi><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msup></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>u</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mi>ℙ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mi>U</mi><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msup><mo>≤</mo><mi>u</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mi>ℙ</mi><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">(</mo><mrow><msub><mi>U</mi><mi>i</mi></msub><mo>≤</mo><mi>u</mi></mrow><mo stretchy="false">)</mo></mrow><mrow><mrow><mo rspace="0.167em">∀</mo><mi>i</mi></mrow><mo>∈</mo><mrow><mo stretchy="false">[</mo><mi>K</mi><mo stretchy="false">]</mo></mrow></mrow></msub></mrow><mo>=</mo><mrow><mi>P</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mi>U</mi><mo>≤</mo><mi>u</mi></mrow><mo stretchy="false">)</mo></mrow><mi>K</mi></msup></mrow><mo>=</mo><mrow><msubsup><mi>F</mi><mi>U</mi><mi>K</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>u</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">F_{U^{(1)}}(u)=\mathbb{P}(U^{(1)}\leq u)=\mathbb{P}(U_{i}\leq u)_{\forall i\in[K]}=P(U\leq u)^{K}=F_{U}^{K}(u).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(31)</span></td></tr></tbody>
</table>
<p id="A2.SS1.SSS2.p2.1" class="ltx_p"><span id="A2.SS1.SSS2.p2.1.1" class="ltx_text">The PDF is obtained by differentiation:</span></p>
<table id="A2.E32" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A2.E32.m1" class="ltx_Math" alttext="f_{U^{(1)}}(u)=\frac{d}{du}F_{U^{(1)}}(u)=KF_{U}^{K-1}(u)f_{U}(u)," display="block" intent=":literal"><semantics><mrow><mrow><mrow><msub><mi>f</mi><msup><mi>U</mi><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msup></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>u</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mfrac><mi>d</mi><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>u</mi></mrow></mfrac><mo lspace="0em" rspace="0em">​</mo><msub><mi>F</mi><msup><mi>U</mi><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msup></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>u</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mi>K</mi><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>F</mi><mi>U</mi><mrow><mi>K</mi><mo>−</mo><mn>1</mn></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>u</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>f</mi><mi>U</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>u</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">f_{U^{(1)}}(u)=\frac{d}{du}F_{U^{(1)}}(u)=KF_{U}^{K-1}(u)f_{U}(u),</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(32)</span></td></tr></tbody>
</table>
<p id="A2.SS1.SSS2.p2.2" class="ltx_p"><span id="A2.SS1.SSS2.p2.2.1" class="ltx_text">∎</span></p>
</div>
</div>
</section>
<section id="A2.SS1.SSS3" class="ltx_subsubsection">
<h4 class="ltx_title ltx_title_subsubsection"><span class="ltx_tag ltx_tag_subsubsection">B.1.3 </span>Distribution of the <math id="A2.SS1.SSS3.m1" class="ltx_Math" alttext="k" display="inline" intent=":literal"><semantics><mi>k</mi><annotation encoding="application/x-tex">k</annotation></semantics></math> largest uniform random variable out of <math id="A2.SS1.SSS3.m2" class="ltx_Math" alttext="K" display="inline" intent=":literal"><semantics><mi>K</mi><annotation encoding="application/x-tex">K</annotation></semantics></math></h4>

<div id="A2.SS1.SSS3.p1" class="ltx_para ltx_noindent">
<p id="A2.SS1.SSS3.p1.1" class="ltx_p">In this part, we show how to sample the <math id="A2.SS1.SSS3.p1.m1" class="ltx_Math" alttext="k" display="inline" intent=":literal"><semantics><mi>k</mi><annotation encoding="application/x-tex">k</annotation></semantics></math> largest uniform random variables out of <math id="A2.SS1.SSS3.p1.m2" class="ltx_Math" alttext="K" display="inline" intent=":literal"><semantics><mi>K</mi><annotation encoding="application/x-tex">K</annotation></semantics></math>. Importantly, we do not need to draw all <math id="A2.SS1.SSS3.p1.m3" class="ltx_Math" alttext="K" display="inline" intent=":literal"><semantics><mi>K</mi><annotation encoding="application/x-tex">K</annotation></semantics></math> values and sort them, which would be impractical for large <math id="A2.SS1.SSS3.p1.m4" class="ltx_Math" alttext="K" display="inline" intent=":literal"><semantics><mi>K</mi><annotation encoding="application/x-tex">K</annotation></semantics></math>. Let <math id="A2.SS1.SSS3.p1.m5" class="ltx_Math" alttext="U^{(1)}\geq\cdots\geq U^{(K)}" display="inline" intent=":literal"><semantics><mrow><msup><mi>U</mi><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msup><mo rspace="0.1389em">≥</mo><mo lspace="0.1389em" rspace="0.1389em">⋯</mo><mo lspace="0.1389em">≥</mo><msup><mi>U</mi><mrow><mo stretchy="false">(</mo><mi>K</mi><mo stretchy="false">)</mo></mrow></msup></mrow><annotation encoding="application/x-tex">U^{(1)}\geq\cdots\geq U^{(K)}</annotation></semantics></math> denote the order statistics of <math id="A2.SS1.SSS3.p1.m6" class="ltx_Math" alttext="K" display="inline" intent=":literal"><semantics><mi>K</mi><annotation encoding="application/x-tex">K</annotation></semantics></math> i.i.d. <math id="A2.SS1.SSS3.p1.m7" class="ltx_Math" alttext="\mathcal{U}[0,1]" display="inline" intent=":literal"><semantics><mrow><mi class="ltx_font_mathcaligraphic">𝒰</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><mn>0</mn><mo>,</mo><mn>1</mn></mrow><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">\mathcal{U}[0,1]</annotation></semantics></math> random variables. We argue that for <math id="A2.SS1.SSS3.p1.m8" class="ltx_Math" alttext="1\leq i&lt;K" display="inline" intent=":literal"><semantics><mrow><mn>1</mn><mo>≤</mo><mi>i</mi><mo>&lt;</mo><mi>K</mi></mrow><annotation encoding="application/x-tex">1\leq i&lt;K</annotation></semantics></math>, conditioned on <math id="A2.SS1.SSS3.p1.m9" class="ltx_Math" alttext="U^{(i)}=u^{(i)}" display="inline" intent=":literal"><semantics><mrow><msup><mi>U</mi><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></msup><mo>=</mo><msup><mi>u</mi><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></msup></mrow><annotation encoding="application/x-tex">U^{(i)}=u^{(i)}</annotation></semantics></math>, <math id="A2.SS1.SSS3.p1.m10" class="ltx_Math" alttext="U^{(i+1)}" display="inline" intent=":literal"><semantics><msup><mi>U</mi><mrow><mo stretchy="false">(</mo><mrow><mi>i</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></msup><annotation encoding="application/x-tex">U^{(i+1)}</annotation></semantics></math> is distributed as the largest out of <math id="A2.SS1.SSS3.p1.m11" class="ltx_Math" alttext="K-i" display="inline" intent=":literal"><semantics><mrow><mi>K</mi><mo>−</mo><mi>i</mi></mrow><annotation encoding="application/x-tex">K-i</annotation></semantics></math> uniform random variables on <math id="A2.SS1.SSS3.p1.m12" class="ltx_Math" alttext="[0,u^{(i)}]" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">[</mo><mn>0</mn><mo>,</mo><msup><mi>u</mi><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">]</mo></mrow><annotation encoding="application/x-tex">[0,u^{(i)}]</annotation></semantics></math>. This enables an iterative scheme to generate the <math id="A2.SS1.SSS3.p1.m13" class="ltx_Math" alttext="k" display="inline" intent=":literal"><semantics><mi>k</mi><annotation encoding="application/x-tex">k</annotation></semantics></math> largest variables in decreasing order. The argument relies on two standard results: the conditional density formula (Prop. <a href="#A2.Thmtheorem2" title="Proposition B.2 (Conditional Density ( , )). ‣ B.1.3 Distribution of the 𝑘 largest uniform random variable out of 𝐾 ‣ B.1 Sampling the top-𝑘 values in 𝐰_𝑡^ℓ Without Materializing The Full Vector ‣ Appendix B Fast Curriculum ‣ The Diffusion Duality, Chapter II: Ψ-Samplers and Efficient Curriculum" class="ltx_ref"><span class="ltx_text ltx_ref_tag">B.2</span></a>) and the joint density of a pair of order statistics (Prop. <a href="#A2.Thmtheorem3" title="Proposition B.3 (Joint Density of Order Statistics ( ( ) ; proof in ( ) )). ‣ B.1.3 Distribution of the 𝑘 largest uniform random variable out of 𝐾 ‣ B.1 Sampling the top-𝑘 values in 𝐰_𝑡^ℓ Without Materializing The Full Vector ‣ Appendix B Fast Curriculum ‣ The Diffusion Duality, Chapter II: Ψ-Samplers and Efficient Curriculum" class="ltx_ref"><span class="ltx_text ltx_ref_tag">B.3</span></a>). The conditional distribution of <math id="A2.SS1.SSS3.p1.m14" class="ltx_Math" alttext="U^{(i+1)}\mid U^{(i)}=u^{(i)}" display="inline" intent=":literal"><semantics><mrow><msup><mi>U</mi><mrow><mo stretchy="false">(</mo><mrow><mi>i</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></msup><mo fence="false">|</mo><mrow><msup><mi>U</mi><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></msup><mo>=</mo><msup><mi>u</mi><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></msup></mrow></mrow><annotation encoding="application/x-tex">U^{(i+1)}\mid U^{(i)}=u^{(i)}</annotation></semantics></math> is given in Prop. <a href="#A2.Thmtheorem4" title="Proposition B.4 (Conditional Distribution of 𝑈^(𝑖+1) given 𝑈^(𝑖)). ‣ B.1.3 Distribution of the 𝑘 largest uniform random variable out of 𝐾 ‣ B.1 Sampling the top-𝑘 values in 𝐰_𝑡^ℓ Without Materializing The Full Vector ‣ Appendix B Fast Curriculum ‣ The Diffusion Duality, Chapter II: Ψ-Samplers and Efficient Curriculum" class="ltx_ref"><span class="ltx_text ltx_ref_tag">B.4</span></a>.</p>
</div>
<div id="A2.Thmtheorem2" class="ltx_theorem ltx_theorem_proposition">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="A2.Thmtheorem2.2" class="ltx_text ltx_font_bold">Proposition B.2</span></span><span id="A2.Thmtheorem2.3" class="ltx_text ltx_font_bold"> </span>(Conditional Density <cite class="ltx_cite ltx_citemacro_citep">(<a href="#bib.bib59" title="" class="ltx_ref">Berger and Casella, 2001</a>)</cite>)<span id="A2.Thmtheorem2.4" class="ltx_text ltx_font_bold">.</span></h6>
<div id="A2.Thmtheorem2.p1" class="ltx_para ltx_noindent">
<p id="A2.Thmtheorem2.p1.1" class="ltx_p"><span id="A2.Thmtheorem2.p1.1.1" class="ltx_text ltx_font_italic">Let <math id="A2.Thmtheorem2.p1.m1" class="ltx_Math" alttext="X,Y" display="inline" intent=":literal"><semantics><mrow><mi>X</mi><mo>,</mo><mi>Y</mi></mrow><annotation encoding="application/x-tex">X,Y</annotation></semantics></math> be two random variables with joint density <math id="A2.Thmtheorem2.p1.m2" class="ltx_Math" alttext="f_{X,Y}" display="inline" intent=":literal"><semantics><msub><mi>f</mi><mrow><mi>X</mi><mo>,</mo><mi>Y</mi></mrow></msub><annotation encoding="application/x-tex">f_{X,Y}</annotation></semantics></math> and marginals <math id="A2.Thmtheorem2.p1.m3" class="ltx_Math" alttext="f_{X},f_{Y}" display="inline" intent=":literal"><semantics><mrow><msub><mi>f</mi><mi>X</mi></msub><mo>,</mo><msub><mi>f</mi><mi>Y</mi></msub></mrow><annotation encoding="application/x-tex">f_{X},f_{Y}</annotation></semantics></math>. Then, the conditional density of <math id="A2.Thmtheorem2.p1.m4" class="ltx_Math" alttext="X" display="inline" intent=":literal"><semantics><mi>X</mi><annotation encoding="application/x-tex">X</annotation></semantics></math> given <math id="A2.Thmtheorem2.p1.m5" class="ltx_Math" alttext="Y=y" display="inline" intent=":literal"><semantics><mrow><mi>Y</mi><mo>=</mo><mi>y</mi></mrow><annotation encoding="application/x-tex">Y=y</annotation></semantics></math> is</span></p>
</div>
<div id="A2.Thmtheorem2.p2" class="ltx_para">
<table id="A2.E33" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A2.E33.m1" class="ltx_Math" alttext="f_{X|Y=y}(x|y)=\frac{f_{X,Y}(x,y)}{f_{Y}(y)}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><msub><mi>f</mi><mrow><mi>X</mi><mo fence="false">|</mo><mrow><mi>Y</mi><mo>=</mo><mi>y</mi></mrow></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo lspace="0em" rspace="0em">|</mo><mi>y</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mfrac><mrow><msub><mi>f</mi><mrow><mi>X</mi><mo>,</mo><mi>Y</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>y</mi><mo stretchy="false">)</mo></mrow></mrow><mrow><msub><mi>f</mi><mi>Y</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>y</mi><mo stretchy="false">)</mo></mrow></mrow></mfrac></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">f_{X|Y=y}(x|y)=\frac{f_{X,Y}(x,y)}{f_{Y}(y)}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(33)</span></td></tr></tbody>
</table>
</div>
</div>
<div id="A2.Thmtheorem3" class="ltx_theorem ltx_theorem_proposition">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="A2.Thmtheorem3.2" class="ltx_text ltx_font_bold">Proposition B.3</span></span><span id="A2.Thmtheorem3.3" class="ltx_text ltx_font_bold"> </span>(Joint Density of Order Statistics (<cite class="ltx_cite ltx_citemacro_citet"><a href="#bib.bib59" title="" class="ltx_ref">Berger and Casella (2001)</a></cite>; proof in <cite class="ltx_cite ltx_citemacro_citet"><a href="#bib.bib58" title="" class="ltx_ref">Border (2021)</a></cite>))<span id="A2.Thmtheorem3.4" class="ltx_text ltx_font_bold">.</span></h6>
<div id="A2.Thmtheorem3.p1" class="ltx_para ltx_noindent">
<p id="A2.Thmtheorem3.p1.1" class="ltx_p"><span id="A2.Thmtheorem3.p1.1.1" class="ltx_text ltx_font_italic">Let <math id="A2.Thmtheorem3.p1.m1" class="ltx_Math" alttext="X^{(1)}\geq\cdots\geq X^{(K)}" display="inline" intent=":literal"><semantics><mrow><msup><mi>X</mi><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msup><mo rspace="0.1389em">≥</mo><mo lspace="0.1389em" rspace="0.1389em">⋯</mo><mo lspace="0.1389em">≥</mo><msup><mi>X</mi><mrow><mo stretchy="false">(</mo><mi>K</mi><mo stretchy="false">)</mo></mrow></msup></mrow><annotation encoding="application/x-tex">X^{(1)}\geq\cdots\geq X^{(K)}</annotation></semantics></math> denote the order statistics of <math id="A2.Thmtheorem3.p1.m2" class="ltx_Math" alttext="K" display="inline" intent=":literal"><semantics><mi>K</mi><annotation encoding="application/x-tex">K</annotation></semantics></math> random variables with CDF <math id="A2.Thmtheorem3.p1.m3" class="ltx_Math" alttext="F" display="inline" intent=":literal"><semantics><mi>F</mi><annotation encoding="application/x-tex">F</annotation></semantics></math> and PDF <math id="A2.Thmtheorem3.p1.m4" class="ltx_Math" alttext="f" display="inline" intent=":literal"><semantics><mi>f</mi><annotation encoding="application/x-tex">f</annotation></semantics></math>, arranged in descending order. Then, the joint density of <math id="A2.Thmtheorem3.p1.m5" class="ltx_Math" alttext="X^{(n)}" display="inline" intent=":literal"><semantics><msup><mi>X</mi><mrow><mo stretchy="false">(</mo><mi>n</mi><mo stretchy="false">)</mo></mrow></msup><annotation encoding="application/x-tex">X^{(n)}</annotation></semantics></math> and <math id="A2.Thmtheorem3.p1.m6" class="ltx_Math" alttext="X^{(m)}" display="inline" intent=":literal"><semantics><msup><mi>X</mi><mrow><mo stretchy="false">(</mo><mi>m</mi><mo stretchy="false">)</mo></mrow></msup><annotation encoding="application/x-tex">X^{(m)}</annotation></semantics></math>, where <math id="A2.Thmtheorem3.p1.m7" class="ltx_Math" alttext="n&lt;m" display="inline" intent=":literal"><semantics><mrow><mi>n</mi><mo>&lt;</mo><mi>m</mi></mrow><annotation encoding="application/x-tex">n&lt;m</annotation></semantics></math> (so that <math id="A2.Thmtheorem3.p1.m8" class="ltx_Math" alttext="X^{(n)}\geq X^{(m)}" display="inline" intent=":literal"><semantics><mrow><msup><mi>X</mi><mrow><mo stretchy="false">(</mo><mi>n</mi><mo stretchy="false">)</mo></mrow></msup><mo>≥</mo><msup><mi>X</mi><mrow><mo stretchy="false">(</mo><mi>m</mi><mo stretchy="false">)</mo></mrow></msup></mrow><annotation encoding="application/x-tex">X^{(n)}\geq X^{(m)}</annotation></semantics></math>), is given by</span></p>
</div>
<div id="A2.Thmtheorem3.p2" class="ltx_para">
<table id="A2.E34" class="ltx_equationgroup ltx_eqn_table">
<tbody>
<tr id="A2.E34X" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.E34X.m2" class="ltx_Math" alttext="\displaystyle f_{X^{(n)},X^{(m)}}(u,v)=" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>f</mi><mrow><msup><mi>X</mi><mrow><mo stretchy="false">(</mo><mi>n</mi><mo stretchy="false">)</mo></mrow></msup><mo>,</mo><msup><mi>X</mi><mrow><mo stretchy="false">(</mo><mi>m</mi><mo stretchy="false">)</mo></mrow></msup></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>u</mi><mo>,</mo><mi>v</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mphantom></mphantom></mrow><annotation encoding="application/x-tex">\displaystyle f_{X^{(n)},X^{(m)}}(u,v)=</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="2" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equationgroup ltx_align_right">(34)</span></td></tr>
<tr id="A2.E34Xa" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.E34Xa.m2" class="ltx_Math" alttext="\displaystyle\frac{K!}{(n-1)!(m-n-1)!(K-m)!}\,(1-F(u))^{n-1}\,(F(u)-F(v))^{m-n-1}\,F(v)^{K-m}\,f(u)\,f(v)." display="inline" intent=":literal"><semantics><mrow><mrow><mstyle displaystyle="true"><mfrac><mrow><mi>K</mi><mo>!</mo></mrow><mrow><mrow><mrow><mrow><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>n</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mo>!</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>m</mi><mo>−</mo><mi>n</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>!</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>K</mi><mo>−</mo><mi>m</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>!</mo></mrow></mfrac></mstyle><mo lspace="0.170em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mrow><mi>F</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>u</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow><mrow><mi>n</mi><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mrow><mi>F</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>u</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mi>F</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>v</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow><mrow><mi>m</mi><mo>−</mo><mi>n</mi><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mi>F</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>v</mi><mo stretchy="false">)</mo></mrow><mrow><mi>K</mi><mo>−</mo><mi>m</mi></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mi>f</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>u</mi><mo stretchy="false">)</mo></mrow><mo lspace="0.170em" rspace="0em">​</mo><mi>f</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>v</mi><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\frac{K!}{(n-1)!(m-n-1)!(K-m)!}\,(1-F(u))^{n-1}\,(F(u)-F(v))^{m-n-1}\,F(v)^{K-m}\,f(u)\,f(v).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
</div>
<div id="A2.Thmtheorem4" class="ltx_theorem ltx_theorem_proposition">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="A2.Thmtheorem4.2" class="ltx_text ltx_font_bold">Proposition B.4</span></span><span id="A2.Thmtheorem4.3" class="ltx_text ltx_font_bold"> </span>(Conditional Distribution of <math id="A2.Thmtheorem4.m1" class="ltx_Math" alttext="U^{(i+1)}" display="inline" intent=":literal"><semantics><msup><mi>U</mi><mrow><mo stretchy="false">(</mo><mrow><mi>i</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></msup><annotation encoding="application/x-tex">U^{(i+1)}</annotation></semantics></math> given <math id="A2.Thmtheorem4.m2" class="ltx_Math" alttext="U^{(i)}" display="inline" intent=":literal"><semantics><msup><mi>U</mi><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></msup><annotation encoding="application/x-tex">U^{(i)}</annotation></semantics></math>)<span id="A2.Thmtheorem4.4" class="ltx_text ltx_font_bold">.</span></h6>
<div id="A2.Thmtheorem4.p1" class="ltx_para">
<p id="A2.Thmtheorem4.p1.1" class="ltx_p"><span id="A2.Thmtheorem4.p1.1.1" class="ltx_text ltx_font_italic">Let <math id="A2.Thmtheorem4.p1.m1" class="ltx_Math" alttext="U^{(1)}\geq\cdots\geq U^{(K)}" display="inline" intent=":literal"><semantics><mrow><msup><mi>U</mi><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msup><mo rspace="0.1389em">≥</mo><mo lspace="0.1389em" rspace="0.1389em">⋯</mo><mo lspace="0.1389em">≥</mo><msup><mi>U</mi><mrow><mo stretchy="false">(</mo><mi>K</mi><mo stretchy="false">)</mo></mrow></msup></mrow><annotation encoding="application/x-tex">U^{(1)}\geq\cdots\geq U^{(K)}</annotation></semantics></math> denote the order statistics of <math id="A2.Thmtheorem4.p1.m2" class="ltx_Math" alttext="K" display="inline" intent=":literal"><semantics><mi>K</mi><annotation encoding="application/x-tex">K</annotation></semantics></math> independent and uniformly distributed random variables on <math id="A2.Thmtheorem4.p1.m3" class="ltx_Math" alttext="[0,1]" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">[</mo><mn>0</mn><mo>,</mo><mn>1</mn><mo stretchy="false">]</mo></mrow><annotation encoding="application/x-tex">[0,1]</annotation></semantics></math>, arranged in descending order. For any <math id="A2.Thmtheorem4.p1.m4" class="ltx_Math" alttext="1\leq i&lt;K" display="inline" intent=":literal"><semantics><mrow><mn>1</mn><mo>≤</mo><mi>i</mi><mo>&lt;</mo><mi>K</mi></mrow><annotation encoding="application/x-tex">1\leq i&lt;K</annotation></semantics></math>, conditioned on <math id="A2.Thmtheorem4.p1.m5" class="ltx_Math" alttext="U^{(i)}=u^{(i)}" display="inline" intent=":literal"><semantics><mrow><msup><mi>U</mi><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></msup><mo>=</mo><msup><mi>u</mi><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></msup></mrow><annotation encoding="application/x-tex">U^{(i)}=u^{(i)}</annotation></semantics></math>, <math id="A2.Thmtheorem4.p1.m6" class="ltx_Math" alttext="U^{(i+1)}" display="inline" intent=":literal"><semantics><msup><mi>U</mi><mrow><mo stretchy="false">(</mo><mrow><mi>i</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></msup><annotation encoding="application/x-tex">U^{(i+1)}</annotation></semantics></math> is distributed as the largest of <math id="A2.Thmtheorem4.p1.m7" class="ltx_Math" alttext="K{-}i" display="inline" intent=":literal"><semantics><mrow><mi>K</mi><mo>−</mo><mi>i</mi></mrow><annotation encoding="application/x-tex">K{-}i</annotation></semantics></math> i.i.d. uniform random variables on <math id="A2.Thmtheorem4.p1.m8" class="ltx_Math" alttext="[0,u^{(i)}]" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">[</mo><mn>0</mn><mo>,</mo><msup><mi>u</mi><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">]</mo></mrow><annotation encoding="application/x-tex">[0,u^{(i)}]</annotation></semantics></math>.</span></p>
</div>
</div>
<div id="A2.SS1.SSS3.2" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="A2.SS1.SSS3.p2" class="ltx_para ltx_noindent">
<p id="A2.SS1.SSS3.p2.1" class="ltx_p"><span id="A2.SS1.SSS3.p2.1.1" class="ltx_text">From Prop. <a href="#A2.Thmtheorem3" title="Proposition B.3 (Joint Density of Order Statistics ( ( ) ; proof in ( ) )). ‣ B.1.3 Distribution of the 𝑘 largest uniform random variable out of 𝐾 ‣ B.1 Sampling the top-𝑘 values in 𝐰_𝑡^ℓ Without Materializing The Full Vector ‣ Appendix B Fast Curriculum ‣ The Diffusion Duality, Chapter II: Ψ-Samplers and Efficient Curriculum" class="ltx_ref"><span class="ltx_text ltx_ref_tag">B.3</span></a> with <math id="A2.SS1.SSS3.p2.m1" class="ltx_Math" alttext="k=i" display="inline" intent=":literal"><semantics><mrow><mi>k</mi><mo>=</mo><mi>i</mi></mrow><annotation encoding="application/x-tex">k=i</annotation></semantics></math> and <math id="A2.SS1.SSS3.p2.m2" class="ltx_Math" alttext="l=i+1" display="inline" intent=":literal"><semantics><mrow><mi>l</mi><mo>=</mo><mrow><mi>i</mi><mo>+</mo><mn>1</mn></mrow></mrow><annotation encoding="application/x-tex">l=i+1</annotation></semantics></math>, the joint density of <math id="A2.SS1.SSS3.p2.m3" class="ltx_Math" alttext="(U^{(i)},U^{(i+1)})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><msup><mi>U</mi><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></msup><mo>,</mo><msup><mi>U</mi><mrow><mo stretchy="false">(</mo><mrow><mi>i</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(U^{(i)},U^{(i+1)})</annotation></semantics></math> for <math id="A2.SS1.SSS3.p2.m4" class="ltx_Math" alttext="\mathcal{U}[0,1]" display="inline" intent=":literal"><semantics><mrow><mi class="ltx_font_mathcaligraphic">𝒰</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><mn>0</mn><mo>,</mo><mn>1</mn></mrow><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">\mathcal{U}[0,1]</annotation></semantics></math> variables (where <math id="A2.SS1.SSS3.p2.m5" class="ltx_Math" alttext="F(u)=u" display="inline" intent=":literal"><semantics><mrow><mrow><mi>F</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>u</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mi>u</mi></mrow><annotation encoding="application/x-tex">F(u)=u</annotation></semantics></math> and <math id="A2.SS1.SSS3.p2.m6" class="ltx_Math" alttext="f(u)=1" display="inline" intent=":literal"><semantics><mrow><mrow><mi>f</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>u</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">f(u)=1</annotation></semantics></math>) is</span></p>
<table id="A2.E35" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A2.E35.m1" class="ltx_Math" alttext="f_{U^{(i)},U^{(i+1)}}(u^{(i)},u^{(i+1)})=\frac{K!}{(i-1)!\,(K-i-1)!}\,(1-u^{(i)})^{i-1}\,(u^{(i+1)})^{K-i-1}," display="block" intent=":literal"><semantics><mrow><mrow><mrow><msub><mi>f</mi><mrow><msup><mi>U</mi><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></msup><mo>,</mo><msup><mi>U</mi><mrow><mo stretchy="false">(</mo><mrow><mi>i</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></msup></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>u</mi><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></msup><mo>,</mo><msup><mi>u</mi><mrow><mo stretchy="false">(</mo><mrow><mi>i</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mfrac><mrow><mi>K</mi><mo>!</mo></mrow><mrow><mrow><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>i</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mo>!</mo></mrow><mo lspace="0.170em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>K</mi><mo>−</mo><mi>i</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>!</mo></mrow></mfrac><mo lspace="0.170em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msup><mi>u</mi><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></msup></mrow><mo stretchy="false">)</mo></mrow><mrow><mi>i</mi><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><msup><mi>u</mi><mrow><mo stretchy="false">(</mo><mrow><mi>i</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow><mrow><mi>K</mi><mo>−</mo><mi>i</mi><mo>−</mo><mn>1</mn></mrow></msup></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">f_{U^{(i)},U^{(i+1)}}(u^{(i)},u^{(i+1)})=\frac{K!}{(i-1)!\,(K-i-1)!}\,(1-u^{(i)})^{i-1}\,(u^{(i+1)})^{K-i-1},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(35)</span></td></tr></tbody>
</table>
<p id="A2.SS1.SSS3.p2.2" class="ltx_p"><span id="A2.SS1.SSS3.p2.2.1" class="ltx_text">since <math id="A2.SS1.SSS3.p2.m7" class="ltx_Math" alttext="(F(u^{(i)})-F(u^{(i+1)}))^{l-k-1}=1" display="inline" intent=":literal"><semantics><mrow><msup><mrow><mo stretchy="false">(</mo><mrow><mrow><mi>F</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>u</mi><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mi>F</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>u</mi><mrow><mo stretchy="false">(</mo><mrow><mi>i</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow><mrow><mi>l</mi><mo>−</mo><mi>k</mi><mo>−</mo><mn>1</mn></mrow></msup><mo>=</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">(F(u^{(i)})-F(u^{(i+1)}))^{l-k-1}=1</annotation></semantics></math> as <math id="A2.SS1.SSS3.p2.m8" class="ltx_Math" alttext="l-k=1" display="inline" intent=":literal"><semantics><mrow><mrow><mi>l</mi><mo>−</mo><mi>k</mi></mrow><mo>=</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">l-k=1</annotation></semantics></math>.</span></p>
</div>
<div id="A2.SS1.SSS3.p3" class="ltx_para ltx_noindent">
<p id="A2.SS1.SSS3.p3.1" class="ltx_p"><span id="A2.SS1.SSS3.p3.1.1" class="ltx_text">To apply Prop. <a href="#A2.Thmtheorem2" title="Proposition B.2 (Conditional Density ( , )). ‣ B.1.3 Distribution of the 𝑘 largest uniform random variable out of 𝐾 ‣ B.1 Sampling the top-𝑘 values in 𝐰_𝑡^ℓ Without Materializing The Full Vector ‣ Appendix B Fast Curriculum ‣ The Diffusion Duality, Chapter II: Ψ-Samplers and Efficient Curriculum" class="ltx_ref"><span class="ltx_text ltx_ref_tag">B.2</span></a>, we need the marginal density of <math id="A2.SS1.SSS3.p3.m1" class="ltx_Math" alttext="U^{(i)}" display="inline" intent=":literal"><semantics><msup><mi>U</mi><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></msup><annotation encoding="application/x-tex">U^{(i)}</annotation></semantics></math>. The event <math id="A2.SS1.SSS3.p3.m2" class="ltx_math_unparsed" alttext="\{u^{(i)}\leq U^{(i)}\leq u^{(i)}+du\}" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">{</mo><msup><mi>u</mi><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></msup><mo>≤</mo><msup><mi>U</mi><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></msup><mo>≤</mo><msup><mi>u</mi><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></msup><mo>+</mo><mi>d</mi><mi>u</mi><mo stretchy="false">}</mo></mrow><annotation encoding="application/x-tex">\{u^{(i)}\leq U^{(i)}\leq u^{(i)}+du\}</annotation></semantics></math> requires that, among the <math id="A2.SS1.SSS3.p3.m3" class="ltx_Math" alttext="K" display="inline" intent=":literal"><semantics><mi>K</mi><annotation encoding="application/x-tex">K</annotation></semantics></math> i.i.d. draws, exactly <math id="A2.SS1.SSS3.p3.m4" class="ltx_Math" alttext="i-1" display="inline" intent=":literal"><semantics><mrow><mi>i</mi><mo>−</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">i-1</annotation></semantics></math> fall in <math id="A2.SS1.SSS3.p3.m5" class="ltx_math_unparsed" alttext="(u^{(i)}+du,1]" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><msup><mi>u</mi><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></msup><mo>+</mo><mi>d</mi><mi>u</mi><mo>,</mo><mn>1</mn><mo stretchy="false">]</mo></mrow><annotation encoding="application/x-tex">(u^{(i)}+du,1]</annotation></semantics></math>, exactly one falls in <math id="A2.SS1.SSS3.p3.m6" class="ltx_math_unparsed" alttext="[u^{(i)},u^{(i)}+du)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">[</mo><msup><mi>u</mi><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></msup><mo>,</mo><msup><mi>u</mi><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></msup><mo>+</mo><mi>d</mi><mi>u</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">[u^{(i)},u^{(i)}+du)</annotation></semantics></math>, and the remaining <math id="A2.SS1.SSS3.p3.m7" class="ltx_Math" alttext="K-i" display="inline" intent=":literal"><semantics><mrow><mi>K</mi><mo>−</mo><mi>i</mi></mrow><annotation encoding="application/x-tex">K-i</annotation></semantics></math> fall in <math id="A2.SS1.SSS3.p3.m8" class="ltx_Math" alttext="[0,u^{(i)})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">[</mo><mn>0</mn><mo>,</mo><msup><mi>u</mi><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">[0,u^{(i)})</annotation></semantics></math>. The number of such assignments is the multinomial coefficient <math id="A2.SS1.SSS3.p3.m9" class="ltx_Math" alttext="\frac{K!}{(i-1)!\,1!\,(K-i)!}" display="inline" intent=":literal"><semantics><mfrac><mrow><mi>K</mi><mo>!</mo></mrow><mrow><mrow><mrow><mrow><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>i</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mo>!</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mn> 1</mn></mrow><mo>!</mo></mrow><mo lspace="0.170em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>K</mi><mo>−</mo><mi>i</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>!</mo></mrow></mfrac><annotation encoding="application/x-tex">\frac{K!}{(i-1)!\,1!\,(K-i)!}</annotation></semantics></math>, and the probability of each assignment is <span id="A2.SS1.SSS3.p3.1.1.1" class="ltx_text"><math id="A2.SS1.SSS3.p3.m10" class="ltx_Math" alttext="\left(1-u^{(i)}-du\right)^{i-1}\cdot du\cdot\left(u^{(i)}\right)^{K-i}" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><msup><mrow><mo>(</mo><mrow><mn>1</mn><mo>−</mo><msup><mi>u</mi><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></msup><mo>−</mo><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>u</mi></mrow></mrow><mo>)</mo></mrow><mrow><mi>i</mi><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0.222em" rspace="0.222em">⋅</mo><mi>d</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mi>u</mi></mrow><mo lspace="0.222em" rspace="0.222em">⋅</mo><msup><mrow><mo>(</mo><msup><mi>u</mi><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></msup><mo>)</mo></mrow><mrow><mi>K</mi><mo>−</mo><mi>i</mi></mrow></msup></mrow><annotation encoding="application/x-tex">\left(1-u^{(i)}-du\right)^{i-1}\cdot du\cdot\left(u^{(i)}\right)^{K-i}</annotation></semantics></math></span>. Multiplying these terms gives</span></p>
<table id="A2.E36" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A2.E36.m1" class="ltx_Math" alttext="P(u^{(i)}\leq U^{(i)}\leq u^{(i)}+du)=\frac{K!}{(i-1)!\,(K-i)!}\,(1-u^{(i)}-du)^{i-1}\cdot du\cdot(u^{(i)})^{K-i}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mi>P</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mi>u</mi><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></msup><mo>≤</mo><msup><mi>U</mi><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></msup><mo>≤</mo><mrow><msup><mi>u</mi><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></msup><mo>+</mo><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>u</mi></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mrow><mrow><mrow><mfrac><mrow><mi>K</mi><mo>!</mo></mrow><mrow><mrow><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>i</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mo>!</mo></mrow><mo lspace="0.170em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>K</mi><mo>−</mo><mi>i</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>!</mo></mrow></mfrac><mo lspace="0.170em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msup><mi>u</mi><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></msup><mo>−</mo><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>u</mi></mrow></mrow><mo rspace="0.055em" stretchy="false">)</mo></mrow><mrow><mi>i</mi><mo>−</mo><mn>1</mn></mrow></msup></mrow><mo rspace="0.222em">⋅</mo><mi>d</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mi>u</mi></mrow><mo lspace="0.222em" rspace="0.222em">⋅</mo><msup><mrow><mo stretchy="false">(</mo><msup><mi>u</mi><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow><mrow><mi>K</mi><mo>−</mo><mi>i</mi></mrow></msup></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">P(u^{(i)}\leq U^{(i)}\leq u^{(i)}+du)=\frac{K!}{(i-1)!\,(K-i)!}\,(1-u^{(i)}-du)^{i-1}\cdot du\cdot(u^{(i)})^{K-i}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(36)</span></td></tr></tbody>
</table>
<p id="A2.SS1.SSS3.p3.2" class="ltx_p"><span id="A2.SS1.SSS3.p3.2.1" class="ltx_text">By definition, <math id="A2.SS1.SSS3.p3.m11" class="ltx_Math" alttext="f_{U^{(i)}}(u^{(i)})=\lim_{du\to 0}\frac{P(u^{(i)}\leq U^{(i)}\leq u^{(i)}+du)}{du}" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>f</mi><msup><mi>U</mi><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></msup></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>u</mi><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow></mrow><mo rspace="0.1389em">=</mo><mrow><msub><mo lspace="0.1389em" rspace="0.167em">lim</mo><mrow><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>u</mi></mrow><mo stretchy="false">→</mo><mn>0</mn></mrow></msub><mfrac><mrow><mi>P</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mi>u</mi><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></msup><mo>≤</mo><msup><mi>U</mi><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></msup><mo>≤</mo><mrow><msup><mi>u</mi><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></msup><mo>+</mo><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>u</mi></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>u</mi></mrow></mfrac></mrow></mrow><annotation encoding="application/x-tex">f_{U^{(i)}}(u^{(i)})=\lim_{du\to 0}\frac{P(u^{(i)}\leq U^{(i)}\leq u^{(i)}+du)}{du}</annotation></semantics></math>. Since <math id="A2.SS1.SSS3.p3.m12" class="ltx_Math" alttext="(1-u^{(i)}-du)^{i-1}\to(1-u^{(i)})^{i-1}" display="inline" intent=":literal"><semantics><mrow><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msup><mi>u</mi><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></msup><mo>−</mo><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>u</mi></mrow></mrow><mo stretchy="false">)</mo></mrow><mrow><mi>i</mi><mo>−</mo><mn>1</mn></mrow></msup><mo stretchy="false">→</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msup><mi>u</mi><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></msup></mrow><mo stretchy="false">)</mo></mrow><mrow><mi>i</mi><mo>−</mo><mn>1</mn></mrow></msup></mrow><annotation encoding="application/x-tex">(1-u^{(i)}-du)^{i-1}\to(1-u^{(i)})^{i-1}</annotation></semantics></math> as <math id="A2.SS1.SSS3.p3.m13" class="ltx_Math" alttext="du\to 0" display="inline" intent=":literal"><semantics><mrow><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>u</mi></mrow><mo stretchy="false">→</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">du\to 0</annotation></semantics></math>, we obtain</span></p>
<table id="A2.E37" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A2.E37.m1" class="ltx_Math" alttext="f_{U^{(i)}}(u^{(i)})=\frac{K!}{(i-1)!\,(K-i)!}\,(1-u^{(i)})^{i-1}\,(u^{(i)})^{K-i}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><msub><mi>f</mi><msup><mi>U</mi><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></msup></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>u</mi><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mfrac><mrow><mi>K</mi><mo>!</mo></mrow><mrow><mrow><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>i</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mo>!</mo></mrow><mo lspace="0.170em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>K</mi><mo>−</mo><mi>i</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>!</mo></mrow></mfrac><mo lspace="0.170em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msup><mi>u</mi><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></msup></mrow><mo stretchy="false">)</mo></mrow><mrow><mi>i</mi><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><msup><mi>u</mi><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow><mrow><mi>K</mi><mo>−</mo><mi>i</mi></mrow></msup></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">f_{U^{(i)}}(u^{(i)})=\frac{K!}{(i-1)!\,(K-i)!}\,(1-u^{(i)})^{i-1}\,(u^{(i)})^{K-i}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(37)</span></td></tr></tbody>
</table>
</div>
<div id="A2.SS1.SSS3.p4" class="ltx_para ltx_noindent">
<p id="A2.SS1.SSS3.p4.1" class="ltx_p"><span id="A2.SS1.SSS3.p4.1.1" class="ltx_text">Applying Prop. <a href="#A2.Thmtheorem2" title="Proposition B.2 (Conditional Density ( , )). ‣ B.1.3 Distribution of the 𝑘 largest uniform random variable out of 𝐾 ‣ B.1 Sampling the top-𝑘 values in 𝐰_𝑡^ℓ Without Materializing The Full Vector ‣ Appendix B Fast Curriculum ‣ The Diffusion Duality, Chapter II: Ψ-Samplers and Efficient Curriculum" class="ltx_ref"><span class="ltx_text ltx_ref_tag">B.2</span></a>:</span></p>
<table id="A2.E38" class="ltx_equationgroup ltx_eqn_table">
<tbody>
<tr id="A2.E38X" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A2.E38X.m2" class="ltx_Math" alttext="\displaystyle f_{U^{(i+1)}\mid U^{(i)}}(u^{(i+1)}\mid u^{(i)})" display="inline" intent=":literal"><semantics><mrow><msub><mi>f</mi><mrow><msup><mi>U</mi><mrow><mo stretchy="false">(</mo><mrow><mi>i</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></msup><mo fence="false">|</mo><msup><mi>U</mi><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></msup></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>u</mi><mrow><mo stretchy="false">(</mo><mrow><mi>i</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></msup><mo fence="true" lspace="0em" rspace="0em">∣</mo><msup><mi>u</mi><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle f_{U^{(i+1)}\mid U^{(i)}}(u^{(i+1)}\mid u^{(i)})</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.E38X.m3" class="ltx_Math" alttext="\displaystyle=\frac{f_{U^{(i)},U^{(i+1)}}(u^{(i)},u^{(i+1)})}{f_{U^{(i)}}(u^{(i)})}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mstyle displaystyle="true"><mfrac><mrow><msub><mi>f</mi><mrow><msup><mi>U</mi><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></msup><mo>,</mo><msup><mi>U</mi><mrow><mo stretchy="false">(</mo><mrow><mi>i</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></msup></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>u</mi><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></msup><mo>,</mo><msup><mi>u</mi><mrow><mo stretchy="false">(</mo><mrow><mi>i</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow></mrow><mrow><msub><mi>f</mi><msup><mi>U</mi><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></msup></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>u</mi><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle></mrow><annotation encoding="application/x-tex">\displaystyle=\frac{f_{U^{(i)},U^{(i+1)}}(u^{(i)},u^{(i+1)})}{f_{U^{(i)}}(u^{(i)})}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="3" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equationgroup ltx_align_right">(38)</span></td></tr>
<tr id="A2.E38Xa" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.E38Xa.m2" class="ltx_Math" alttext="\displaystyle=\frac{\frac{K!}{(i-1)!\,(K-i-1)!}\,(1-u^{(i)})^{i-1}\,(u^{(i+1)})^{K-i-1}}{\frac{K!}{(i-1)!\,(K-i)!}\,(1-u^{(i)})^{i-1}\,(u^{(i)})^{K-i}}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mstyle displaystyle="true"><mfrac><mrow><mfrac><mrow><mi>K</mi><mo>!</mo></mrow><mrow><mrow><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>i</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mo>!</mo></mrow><mo lspace="0.170em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>K</mi><mo>−</mo><mi>i</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>!</mo></mrow></mfrac><mo lspace="0.170em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msup><mi>u</mi><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></msup></mrow><mo stretchy="false">)</mo></mrow><mrow><mi>i</mi><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><msup><mi>u</mi><mrow><mo stretchy="false">(</mo><mrow><mi>i</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow><mrow><mi>K</mi><mo>−</mo><mi>i</mi><mo>−</mo><mn>1</mn></mrow></msup></mrow><mrow><mfrac><mrow><mi>K</mi><mo>!</mo></mrow><mrow><mrow><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>i</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mo>!</mo></mrow><mo lspace="0.170em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>K</mi><mo>−</mo><mi>i</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>!</mo></mrow></mfrac><mo lspace="0.170em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msup><mi>u</mi><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></msup></mrow><mo stretchy="false">)</mo></mrow><mrow><mi>i</mi><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><msup><mi>u</mi><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow><mrow><mi>K</mi><mo>−</mo><mi>i</mi></mrow></msup></mrow></mfrac></mstyle></mrow><annotation encoding="application/x-tex">\displaystyle=\frac{\frac{K!}{(i-1)!\,(K-i-1)!}\,(1-u^{(i)})^{i-1}\,(u^{(i+1)})^{K-i-1}}{\frac{K!}{(i-1)!\,(K-i)!}\,(1-u^{(i)})^{i-1}\,(u^{(i)})^{K-i}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr>
<tr id="A2.E38Xb" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.E38Xb.m2" class="ltx_Math" alttext="\displaystyle=(K-i)\,\frac{(u^{(i+1)})^{K-i-1}}{(u^{(i)})^{K-i}}," display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>K</mi><mo>−</mo><mi>i</mi></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0.170em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><msup><mrow><mo stretchy="false">(</mo><msup><mi>u</mi><mrow><mo stretchy="false">(</mo><mrow><mi>i</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow><mrow><mi>K</mi><mo>−</mo><mi>i</mi><mo>−</mo><mn>1</mn></mrow></msup><msup><mrow><mo stretchy="false">(</mo><msup><mi>u</mi><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow><mrow><mi>K</mi><mo>−</mo><mi>i</mi></mrow></msup></mfrac></mstyle></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle=(K-i)\,\frac{(u^{(i+1)})^{K-i-1}}{(u^{(i)})^{K-i}},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A2.SS1.SSS3.p4.2" class="ltx_p"><span id="A2.SS1.SSS3.p4.2.1" class="ltx_text">since the factors <math id="A2.SS1.SSS3.p4.m1" class="ltx_Math" alttext="K!/(i-1)!" display="inline" intent=":literal"><semantics><mrow><mrow><mi>K</mi><mo>!</mo></mrow><mo>/</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>i</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mo>!</mo></mrow></mrow><annotation encoding="application/x-tex">K!/(i-1)!</annotation></semantics></math> and <math id="A2.SS1.SSS3.p4.m2" class="ltx_Math" alttext="(1-u^{(i)})^{i-1}" display="inline" intent=":literal"><semantics><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msup><mi>u</mi><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></msup></mrow><mo stretchy="false">)</mo></mrow><mrow><mi>i</mi><mo>−</mo><mn>1</mn></mrow></msup><annotation encoding="application/x-tex">(1-u^{(i)})^{i-1}</annotation></semantics></math> cancel. This is precisely the density of the largest of <math id="A2.SS1.SSS3.p4.m3" class="ltx_Math" alttext="K{-}i" display="inline" intent=":literal"><semantics><mrow><mi>K</mi><mo>−</mo><mi>i</mi></mrow><annotation encoding="application/x-tex">K{-}i</annotation></semantics></math> i.i.d. <math id="A2.SS1.SSS3.p4.m4" class="ltx_Math" alttext="\mathcal{U}[0,u^{(i)}]" display="inline" intent=":literal"><semantics><mrow><mi class="ltx_font_mathcaligraphic">𝒰</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><mn>0</mn><mo>,</mo><msup><mi>u</mi><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></msup></mrow><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">\mathcal{U}[0,u^{(i)}]</annotation></semantics></math> random variables.
∎</span></p>
</div>
</div>
</section>
<section id="A2.SS1.SSS4" class="ltx_subsubsection">
<h4 class="ltx_title ltx_title_subsubsection"><span class="ltx_tag ltx_tag_subsubsection">B.1.4 </span>Generating the <math id="A2.SS1.SSS4.m1" class="ltx_Math" alttext="k" display="inline" intent=":literal"><semantics><mi>k</mi><annotation encoding="application/x-tex">k</annotation></semantics></math> largest Gaussian random variables out of <math id="A2.SS1.SSS4.m2" class="ltx_Math" alttext="K" display="inline" intent=":literal"><semantics><mi>K</mi><annotation encoding="application/x-tex">K</annotation></semantics></math></h4>

<div id="A2.SS1.SSS4.p1" class="ltx_para ltx_noindent">
<p id="A2.SS1.SSS4.p1.1" class="ltx_p">We now show that it is possible to generate the <math id="A2.SS1.SSS4.p1.m1" class="ltx_Math" alttext="k" display="inline" intent=":literal"><semantics><mi>k</mi><annotation encoding="application/x-tex">k</annotation></semantics></math> largest Gaussian random variables out of <math id="A2.SS1.SSS4.p1.m2" class="ltx_Math" alttext="K" display="inline" intent=":literal"><semantics><mi>K</mi><annotation encoding="application/x-tex">K</annotation></semantics></math> via inverse transform sampling (Sec. <a href="#A2.SS1.SSS1" title="B.1.1 Inverse Transform Sampling ‣ B.1 Sampling the top-𝑘 values in 𝐰_𝑡^ℓ Without Materializing The Full Vector ‣ Appendix B Fast Curriculum ‣ The Diffusion Duality, Chapter II: Ψ-Samplers and Efficient Curriculum" class="ltx_ref"><span class="ltx_text ltx_ref_tag">B.1.1</span></a>) as follows.</p>
</div>
<div id="A2.SS1.SSS4.p2" class="ltx_para ltx_noindent">
<p id="A2.SS1.SSS4.p2.1" class="ltx_p">Given a single uniform random variable <math id="A2.SS1.SSS4.p2.m1" class="ltx_Math" alttext="U\sim\mathcal{U}[0,1]" display="inline" intent=":literal"><semantics><mrow><mi>U</mi><mo>∼</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒰</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><mn>0</mn><mo>,</mo><mn>1</mn></mrow><mo stretchy="false">]</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">U\sim\mathcal{U}[0,1]</annotation></semantics></math>, one can obtain a standard Gaussian random variable <math id="A2.SS1.SSS4.p2.m2" class="ltx_Math" alttext="W=\Phi^{-1}(U)" display="inline" intent=":literal"><semantics><mrow><mi>W</mi><mo>=</mo><mrow><msup><mi mathvariant="normal">Φ</mi><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>U</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">W=\Phi^{-1}(U)</annotation></semantics></math>, where <math id="A2.SS1.SSS4.p2.m3" class="ltx_Math" alttext="\Phi" display="inline" intent=":literal"><semantics><mi mathvariant="normal">Φ</mi><annotation encoding="application/x-tex">\Phi</annotation></semantics></math> is the Gaussian CDF, via inverse transform sampling. Now assume we have a sorted list of <math id="A2.SS1.SSS4.p2.m4" class="ltx_Math" alttext="K" display="inline" intent=":literal"><semantics><mi>K</mi><annotation encoding="application/x-tex">K</annotation></semantics></math> uniform random variables <math id="A2.SS1.SSS4.p2.m5" class="ltx_Math" alttext="U_{1}\geq U_{2}\geq...\geq U_{K}" display="inline" intent=":literal"><semantics><mrow><msub><mi>U</mi><mn>1</mn></msub><mo>≥</mo><msub><mi>U</mi><mn>2</mn></msub><mo>≥</mo><mi mathvariant="normal">…</mi><mo>≥</mo><msub><mi>U</mi><mi>K</mi></msub></mrow><annotation encoding="application/x-tex">U_{1}\geq U_{2}\geq...\geq U_{K}</annotation></semantics></math>. Since <math id="A2.SS1.SSS4.p2.m6" class="ltx_Math" alttext="\Phi" display="inline" intent=":literal"><semantics><mi mathvariant="normal">Φ</mi><annotation encoding="application/x-tex">\Phi</annotation></semantics></math> is a monotonically increasing function, the largest uniform random variable, <math id="A2.SS1.SSS4.p2.m7" class="ltx_Math" alttext="U_{1}" display="inline" intent=":literal"><semantics><msub><mi>U</mi><mn>1</mn></msub><annotation encoding="application/x-tex">U_{1}</annotation></semantics></math>, is mapped to the largest Gaussian random variable, i.e. <math id="A2.SS1.SSS4.p2.m8" class="ltx_Math" alttext="\Phi^{-1}(U_{1})" display="inline" intent=":literal"><semantics><mrow><msup><mi mathvariant="normal">Φ</mi><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>U</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\Phi^{-1}(U_{1})</annotation></semantics></math> is distributed as the largest Gaussian random variable out of <math id="A2.SS1.SSS4.p2.m9" class="ltx_Math" alttext="K" display="inline" intent=":literal"><semantics><mi>K</mi><annotation encoding="application/x-tex">K</annotation></semantics></math>.</p>
</div>
<section id="A2.SS1.SSS4.Px1" class="ltx_paragraph">
<h5 class="ltx_title ltx_title_paragraph">Sampling The Largest</h5>

<div id="A2.SS1.SSS4.Px1.p1" class="ltx_para ltx_noindent">
<p id="A2.SS1.SSS4.Px1.p1.1" class="ltx_p">As shown in Prop. <a href="#A2.Thmtheorem1" title="Proposition B.1 (Distribution of the largest uniform random variable out of 𝐾). ‣ B.1.2 Distribution of the largest uniform random variable out of 𝐾 ‣ B.1 Sampling the top-𝑘 values in 𝐰_𝑡^ℓ Without Materializing The Full Vector ‣ Appendix B Fast Curriculum ‣ The Diffusion Duality, Chapter II: Ψ-Samplers and Efficient Curriculum" class="ltx_ref"><span class="ltx_text ltx_ref_tag">B.1</span></a>, the CDF of the largest uniform random variable out of <math id="A2.SS1.SSS4.Px1.p1.m1" class="ltx_Math" alttext="K" display="inline" intent=":literal"><semantics><mi>K</mi><annotation encoding="application/x-tex">K</annotation></semantics></math> has an analytical solution. For <math id="A2.SS1.SSS4.Px1.p1.m2" class="ltx_Math" alttext="u\in[0,1]" display="inline" intent=":literal"><semantics><mrow><mi>u</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mrow><mn>0</mn><mo>,</mo><mn>1</mn></mrow><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">u\in[0,1]</annotation></semantics></math>, <math id="A2.SS1.SSS4.Px1.p1.m3" class="ltx_Math" alttext="P(U_{1}\leq u)=u^{K}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>P</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>U</mi><mn>1</mn></msub><mo>≤</mo><mi>u</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><msup><mi>u</mi><mi>K</mi></msup></mrow><annotation encoding="application/x-tex">P(U_{1}\leq u)=u^{K}</annotation></semantics></math>, hence it can be generated via inverse transform sampling.</p>
</div>
</section>
<section id="A2.SS1.SSS4.Px2" class="ltx_paragraph">
<h5 class="ltx_title ltx_title_paragraph">Sampling The Second Largest</h5>

<div id="A2.SS1.SSS4.Px2.p1" class="ltx_para ltx_noindent">
<p id="A2.SS1.SSS4.Px2.p1.1" class="ltx_p">Furthermore, the distribution of the second largest, conditioned on <math id="A2.SS1.SSS4.Px2.p1.m1" class="ltx_Math" alttext="U_{1}=u_{1}" display="inline" intent=":literal"><semantics><mrow><msub><mi>U</mi><mn>1</mn></msub><mo>=</mo><msub><mi>u</mi><mn>1</mn></msub></mrow><annotation encoding="application/x-tex">U_{1}=u_{1}</annotation></semantics></math>, also admits a closed-form solution (Sec. <a href="#A2.SS1.SSS3" title="B.1.3 Distribution of the 𝑘 largest uniform random variable out of 𝐾 ‣ B.1 Sampling the top-𝑘 values in 𝐰_𝑡^ℓ Without Materializing The Full Vector ‣ Appendix B Fast Curriculum ‣ The Diffusion Duality, Chapter II: Ψ-Samplers and Efficient Curriculum" class="ltx_ref"><span class="ltx_text ltx_ref_tag">B.1.3</span></a>): for <math id="A2.SS1.SSS4.Px2.p1.m2" class="ltx_Math" alttext="u_{2}\in[0,u_{1}]" display="inline" intent=":literal"><semantics><mrow><msub><mi>u</mi><mn>2</mn></msub><mo>∈</mo><mrow><mo stretchy="false">[</mo><mrow><mn>0</mn><mo>,</mo><msub><mi>u</mi><mn>1</mn></msub></mrow><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">u_{2}\in[0,u_{1}]</annotation></semantics></math>, it is given by <math id="A2.SS1.SSS4.Px2.p1.m3" class="ltx_Math" alttext="P(U_{2}\leq u_{2}|U_{1}=u_{1})=u_{2}^{K-1}u_{1}^{-(K-1)}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>P</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>U</mi><mn>2</mn></msub><mo>≤</mo><msub><mi>u</mi><mn>2</mn></msub></mrow><mo lspace="0em" rspace="0em">|</mo><mrow><msub><mi>U</mi><mn>1</mn></msub><mo>=</mo><msub><mi>u</mi><mn>1</mn></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><msubsup><mi>u</mi><mn>2</mn><mrow><mi>K</mi><mo>−</mo><mn>1</mn></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>u</mi><mn>1</mn><mrow><mo>−</mo><mrow><mo stretchy="false">(</mo><mrow><mi>K</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow></msubsup></mrow></mrow><annotation encoding="application/x-tex">P(U_{2}\leq u_{2}|U_{1}=u_{1})=u_{2}^{K-1}u_{1}^{-(K-1)}</annotation></semantics></math>, i.e. it is distributed as the largest uniform variable out of <math id="A2.SS1.SSS4.Px2.p1.m4" class="ltx_Math" alttext="K-1" display="inline" intent=":literal"><semantics><mrow><mi>K</mi><mo>−</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">K-1</annotation></semantics></math>, supported on <math id="A2.SS1.SSS4.Px2.p1.m5" class="ltx_Math" alttext="[0,u_{1}]" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">[</mo><mn>0</mn><mo>,</mo><msub><mi>u</mi><mn>1</mn></msub><mo stretchy="false">]</mo></mrow><annotation encoding="application/x-tex">[0,u_{1}]</annotation></semantics></math>.</p>
</div>
</section>
<section id="A2.SS1.SSS4.Px3" class="ltx_paragraph">
<h5 class="ltx_title ltx_title_paragraph">Sampling The <math id="A2.SS1.SSS4.Px3.m1" class="ltx_Math" alttext="k^{\text{th}}" display="inline" intent=":literal"><semantics><msup><mi>k</mi><mtext>th</mtext></msup><annotation encoding="application/x-tex">k^{\text{th}}</annotation></semantics></math>-largest</h5>

<div id="A2.SS1.SSS4.Px3.p1" class="ltx_para ltx_noindent">
<p id="A2.SS1.SSS4.Px3.p1.1" class="ltx_p">More generally, the same argument shows that conditioned on <math id="A2.SS1.SSS4.Px3.p1.m1" class="ltx_Math" alttext="U_{i}=u_{i}" display="inline" intent=":literal"><semantics><mrow><msub><mi>U</mi><mi>i</mi></msub><mo>=</mo><msub><mi>u</mi><mi>i</mi></msub></mrow><annotation encoding="application/x-tex">U_{i}=u_{i}</annotation></semantics></math>, the random variable <math id="A2.SS1.SSS4.Px3.p1.m2" class="ltx_Math" alttext="U_{i+1}" display="inline" intent=":literal"><semantics><msub><mi>U</mi><mrow><mi>i</mi><mo>+</mo><mn>1</mn></mrow></msub><annotation encoding="application/x-tex">U_{i+1}</annotation></semantics></math> is distributed as the largest uniform variable on <math id="A2.SS1.SSS4.Px3.p1.m3" class="ltx_Math" alttext="[0,u_{i}]" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">[</mo><mn>0</mn><mo>,</mo><msub><mi>u</mi><mi>i</mi></msub><mo stretchy="false">]</mo></mrow><annotation encoding="application/x-tex">[0,u_{i}]</annotation></semantics></math> out of <math id="A2.SS1.SSS4.Px3.p1.m4" class="ltx_Math" alttext="K-i+1" display="inline" intent=":literal"><semantics><mrow><mrow><mi>K</mi><mo>−</mo><mi>i</mi></mrow><mo>+</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">K-i+1</annotation></semantics></math>. This shows that we can sample <math id="A2.SS1.SSS4.Px3.p1.m5" class="ltx_Math" alttext="U_{1},...,U_{k}" display="inline" intent=":literal"><semantics><mrow><msub><mi>U</mi><mn>1</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>U</mi><mi>k</mi></msub></mrow><annotation encoding="application/x-tex">U_{1},...,U_{k}</annotation></semantics></math> in decreasing order and without simulating all the <math id="A2.SS1.SSS4.Px3.p1.m6" class="ltx_Math" alttext="K" display="inline" intent=":literal"><semantics><mi>K</mi><annotation encoding="application/x-tex">K</annotation></semantics></math> variables. Finally, the <math id="A2.SS1.SSS4.Px3.p1.m7" class="ltx_Math" alttext="k" display="inline" intent=":literal"><semantics><mi>k</mi><annotation encoding="application/x-tex">k</annotation></semantics></math> largest <math id="A2.SS1.SSS4.Px3.p1.m8" class="ltx_Math" alttext="U_{i}" display="inline" intent=":literal"><semantics><msub><mi>U</mi><mi>i</mi></msub><annotation encoding="application/x-tex">U_{i}</annotation></semantics></math> can be transformed into the <math id="A2.SS1.SSS4.Px3.p1.m9" class="ltx_Math" alttext="k" display="inline" intent=":literal"><semantics><mi>k</mi><annotation encoding="application/x-tex">k</annotation></semantics></math> largest standard Gaussians out of <math id="A2.SS1.SSS4.Px3.p1.m10" class="ltx_Math" alttext="K" display="inline" intent=":literal"><semantics><mi>K</mi><annotation encoding="application/x-tex">K</annotation></semantics></math> as <math id="A2.SS1.SSS4.Px3.p1.m11" class="ltx_Math" alttext="\{\Phi^{-1}(U_{i})\}_{i=1}^{k}" display="inline" intent=":literal"><semantics><msubsup><mrow><mo stretchy="false">{</mo><mrow><msup><mi mathvariant="normal">Φ</mi><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>U</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">}</mo></mrow><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>k</mi></msubsup><annotation encoding="application/x-tex">\{\Phi^{-1}(U_{i})\}_{i=1}^{k}</annotation></semantics></math>. In practice, a naive implementation of inverse transform sampling is numerically unstable when <math id="A2.SS1.SSS4.Px3.p1.m12" class="ltx_Math" alttext="K" display="inline" intent=":literal"><semantics><mi>K</mi><annotation encoding="application/x-tex">K</annotation></semantics></math> is large. For stability, operations should be implemented in log-space. Algo. <a href="#alg1" title='Algorithm 1 ‣ Sampling The 𝑘^"th"-largest ‣ B.1.4 Generating the 𝑘 largest Gaussian random variables out of 𝐾 ‣ B.1 Sampling the top-𝑘 values in 𝐰_𝑡^ℓ Without Materializing The Full Vector ‣ Appendix B Fast Curriculum ‣ The Diffusion Duality, Chapter II: Ψ-Samplers and Efficient Curriculum' class="ltx_ref"><span class="ltx_text ltx_ref_tag">1</span></a> shows the pseudocode of the log-space implementation.</p>
</div>
<figure id="alg1" class="ltx_float ltx_float_algorithm ltx_framed ltx_framed_top">
<figcaption class="ltx_caption"><span class="ltx_tag ltx_tag_float"><span id="alg1.3" class="ltx_text ltx_font_bold">Algorithm 1</span> </span> Reverse Sampling from Order Statistics of Gaussian Random Variables. Here <math id="alg1.m5" class="ltx_Math" alttext="N" display="inline" intent=":literal"><semantics><mi>N</mi><annotation encoding="application/x-tex">N</annotation></semantics></math> corresponds to <math id="alg1.m6" class="ltx_Math" alttext="K{-}1" display="inline" intent=":literal"><semantics><mrow><mi>K</mi><mo>−</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">K{-}1</annotation></semantics></math> (the number of zero-mean entries) and <math id="alg1.m7" class="ltx_Math" alttext="\sigma" display="inline" intent=":literal"><semantics><mi>σ</mi><annotation encoding="application/x-tex">\sigma</annotation></semantics></math> to <math id="alg1.m8" class="ltx_Math" alttext="{\color[rgb]{0.9023,0.5703,0.2188}\tilde{\sigma}_{t}}=\sqrt{1-{\color[rgb]{0.9023,0.5703,0.2188}\tilde{\alpha}_{t}^{{\color[rgb]{0,0,0}2}}}}" display="inline" intent=":literal"><semantics><mrow><msub><mover accent="true"><mi style="--ltx-fg-color:#E69138;" mathcolor="#E69138">σ</mi><mo>~</mo></mover><mi style="--ltx-fg-color:#E69138;" mathcolor="#E69138">t</mi></msub><mo>=</mo><msqrt><mrow><mn>1</mn><mo>−</mo><msubsup><mover accent="true"><mi style="--ltx-fg-color:#E69138;" mathcolor="#E69138">α</mi><mo>~</mo></mover><mi style="--ltx-fg-color:#E69138;" mathcolor="#E69138">t</mi><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">2</mn></msubsup></mrow></msqrt></mrow><annotation encoding="application/x-tex">{\color[rgb]{0.9023,0.5703,0.2188}\tilde{\sigma}_{t}}=\sqrt{1-{\color[rgb]{0.9023,0.5703,0.2188}\tilde{\alpha}_{t}^{{\color[rgb]{0,0,0}2}}}}</annotation></semantics></math>.</figcaption>
<div id="alg1.4" class="ltx_listing ltx_framed ltx_framed_topbottom ltx_listing">
<div id="alg1.l1" class="ltx_listingline">
                  
                  
                 <span id="alg1.l1.2" class="ltx_text ltx_font_bold">Input</span> Number of variables <math id="alg1.l1.m1" class="ltx_Math" alttext="N" display="inline" intent=":literal"><semantics><mi>N</mi><annotation encoding="application/x-tex">N</annotation></semantics></math>, standard deviation <math id="alg1.l1.m2" class="ltx_Math" alttext="\sigma" display="inline" intent=":literal"><semantics><mi>σ</mi><annotation encoding="application/x-tex">\sigma</annotation></semantics></math>, number of top values <math id="alg1.l1.m3" class="ltx_Math" alttext="k" display="inline" intent=":literal"><semantics><mi>k</mi><annotation encoding="application/x-tex">k</annotation></semantics></math>

</div>
<div id="alg1.l2" class="ltx_listingline">
                  
                  
                 Sample <math id="alg1.l2.m1" class="ltx_Math" alttext="U_{\ell}\sim\mathcal{U}(0,1)" display="inline" intent=":literal"><semantics><mrow><msub><mi>U</mi><mi mathvariant="normal">ℓ</mi></msub><mo>∼</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒰</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mn>0</mn><mo>,</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">U_{\ell}\sim\mathcal{U}(0,1)</annotation></semantics></math>, for <math id="alg1.l2.m2" class="ltx_Math" alttext="N\geq\ell\geq N-k+1" display="inline" intent=":literal"><semantics><mrow><mi>N</mi><mo>≥</mo><mi mathvariant="normal">ℓ</mi><mo>≥</mo><mrow><mrow><mi>N</mi><mo>−</mo><mi>k</mi></mrow><mo>+</mo><mn>1</mn></mrow></mrow><annotation encoding="application/x-tex">N\geq\ell\geq N-k+1</annotation></semantics></math>

</div>
<div id="alg1.l3" class="ltx_listingline">
                  
                  
                 Compute the random variables: <math id="alg1.l3.m1" class="ltx_Math" alttext="R_{\ell}=\frac{\log U_{\ell}}{\ell}" display="inline" intent=":literal"><semantics><mrow><msub><mi>R</mi><mi mathvariant="normal">ℓ</mi></msub><mo>=</mo><mfrac><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><msub><mi>U</mi><mi mathvariant="normal">ℓ</mi></msub></mrow><mi mathvariant="normal">ℓ</mi></mfrac></mrow><annotation encoding="application/x-tex">R_{\ell}=\frac{\log U_{\ell}}{\ell}</annotation></semantics></math>

</div>
<div id="alg1.l4" class="ltx_listingline">
                  
                  
                 Compute the cumulative sums: <math id="alg1.l4.m1" class="ltx_Math" alttext="P_{\ell}=\sum_{m=\ell}^{N}R_{m}" display="inline" intent=":literal"><semantics><mrow><msub><mi>P</mi><mi mathvariant="normal">ℓ</mi></msub><mo rspace="0.111em">=</mo><mrow><msubsup><mo>∑</mo><mrow><mi>m</mi><mo>=</mo><mi mathvariant="normal">ℓ</mi></mrow><mi>N</mi></msubsup><msub><mi>R</mi><mi>m</mi></msub></mrow></mrow><annotation encoding="application/x-tex">P_{\ell}=\sum_{m=\ell}^{N}R_{m}</annotation></semantics></math>

</div>
<div id="alg1.l5" class="ltx_listingline">
                  
                  
                 Let <math id="alg1.l5.m1" class="ltx_Math" alttext="V_{\ell}=\exp(P_{\ell})" display="inline" intent=":literal"><semantics><mrow><msub><mi>V</mi><mi mathvariant="normal">ℓ</mi></msub><mo>=</mo><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>P</mi><mi mathvariant="normal">ℓ</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">V_{\ell}=\exp(P_{\ell})</annotation></semantics></math>, the <math id="alg1.l5.m2" class="ltx_Math" alttext="\ell" display="inline" intent=":literal"><semantics><mi mathvariant="normal">ℓ</mi><annotation encoding="application/x-tex">\ell</annotation></semantics></math>-th sample from the (uniform) order statistic.

</div>
<div id="alg1.l6" class="ltx_listingline">
                  
                  
                 Apply inverse normal CDF: <math id="alg1.l6.m1" class="ltx_Math" alttext="X^{(\ell)}=\Phi^{-1}(V_{\ell})\cdot\sigma" display="inline" intent=":literal"><semantics><mrow><msup><mi>X</mi><mrow><mo stretchy="false">(</mo><mi mathvariant="normal">ℓ</mi><mo stretchy="false">)</mo></mrow></msup><mo>=</mo><mrow><mrow><msup><mi mathvariant="normal">Φ</mi><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>V</mi><mi mathvariant="normal">ℓ</mi></msub><mo rspace="0.055em" stretchy="false">)</mo></mrow></mrow><mo rspace="0.222em">⋅</mo><mi>σ</mi></mrow></mrow><annotation encoding="application/x-tex">X^{(\ell)}=\Phi^{-1}(V_{\ell})\cdot\sigma</annotation></semantics></math>

</div>
<div id="alg1.l7" class="ltx_listingline">
                  
                  
                 <span id="alg1.l7.2" class="ltx_text ltx_font_bold">return</span> <math id="alg1.l7.m1" class="ltx_Math" alttext="\{X^{(\ell)}\}_{\ell=N}^{N-k+1}" display="inline" intent=":literal"><semantics><msubsup><mrow><mo stretchy="false">{</mo><msup><mi>X</mi><mrow><mo stretchy="false">(</mo><mi mathvariant="normal">ℓ</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">}</mo></mrow><mrow><mi mathvariant="normal">ℓ</mi><mo>=</mo><mi>N</mi></mrow><mrow><mrow><mi>N</mi><mo>−</mo><mi>k</mi></mrow><mo>+</mo><mn>1</mn></mrow></msubsup><annotation encoding="application/x-tex">\{X^{(\ell)}\}_{\ell=N}^{N-k+1}</annotation></semantics></math>

</div>
</div>
</figure>
</section>
</section>
<section id="A2.SS1.SSS5" class="ltx_subsubsection">
<h4 class="ltx_title ltx_title_subsubsection"><span class="ltx_tag ltx_tag_subsubsection">B.1.5 </span>Sampling Integers Without Repetitions and Without Shuffling</h4>

<div id="A2.SS1.SSS5.p1" class="ltx_para ltx_noindent">
<p id="A2.SS1.SSS5.p1.1" class="ltx_p">Suppose that <math id="A2.SS1.SSS5.p1.m1" class="ltx_Math" alttext="{\mathbf{x}}" display="inline" intent=":literal"><semantics><mi>𝐱</mi><annotation encoding="application/x-tex">{\mathbf{x}}</annotation></semantics></math> denotes the one-hot vector of category <math id="A2.SS1.SSS5.p1.m2" class="ltx_Math" alttext="o" display="inline" intent=":literal"><semantics><mi>o</mi><annotation encoding="application/x-tex">o</annotation></semantics></math>. By symmetry, after applying Gaussian diffusion to <math id="A2.SS1.SSS5.p1.m3" class="ltx_Math" alttext="{\mathbf{x}}" display="inline" intent=":literal"><semantics><mi>𝐱</mi><annotation encoding="application/x-tex">{\mathbf{x}}</annotation></semantics></math>, all entries <math id="A2.SS1.SSS5.p1.m4" class="ltx_Math" alttext="({\mathbf{x}}_{j})_{j\neq o}" display="inline" intent=":literal"><semantics><msub><mrow><mo stretchy="false">(</mo><msub><mi>𝐱</mi><mi>j</mi></msub><mo stretchy="false">)</mo></mrow><mrow><mi>j</mi><mo>≠</mo><mi>o</mi></mrow></msub><annotation encoding="application/x-tex">({\mathbf{x}}_{j})_{j\neq o}</annotation></semantics></math> such that follow the exact same distribution. Therefore, they have the same probability of being one of the top <math id="A2.SS1.SSS5.p1.m5" class="ltx_Math" alttext="k" display="inline" intent=":literal"><semantics><mi>k</mi><annotation encoding="application/x-tex">k</annotation></semantics></math> largest random variable.</p>
</div>
<div id="A2.SS1.SSS5.p2" class="ltx_para ltx_noindent">
<p id="A2.SS1.SSS5.p2.1" class="ltx_p">To implement the curriculum, we must not only approximate the weights of the embedding combination but also select which embeddings to include. As described in Sec. <a href="#S4" title="4 Scalable Curriculum for Faster Training ‣ The Diffusion Duality, Chapter II: Ψ-Samplers and Efficient Curriculum" class="ltx_ref"><span class="ltx_text ltx_ref_tag">4</span></a>, we sample <math id="A2.SS1.SSS5.p2.m1" class="ltx_Math" alttext="k" display="inline" intent=":literal"><semantics><mi>k</mi><annotation encoding="application/x-tex">k</annotation></semantics></math> random indices <em id="A2.SS1.SSS5.p2.1.1" class="ltx_emph ltx_font_italic">without repetition</em> excluding <math id="A2.SS1.SSS5.p2.m2" class="ltx_Math" alttext="i" display="inline" intent=":literal"><semantics><mi>i</mi><annotation encoding="application/x-tex">i</annotation></semantics></math>. If the random variable at position <math id="A2.SS1.SSS5.p2.m3" class="ltx_Math" alttext="o" display="inline" intent=":literal"><semantics><mi>o</mi><annotation encoding="application/x-tex">o</annotation></semantics></math>, corresponding to the clean token, belongs to the top-<math id="A2.SS1.SSS5.p2.m4" class="ltx_Math" alttext="k" display="inline" intent=":literal"><semantics><mi>k</mi><annotation encoding="application/x-tex">k</annotation></semantics></math>, we replace one of the sampled indices with <math id="A2.SS1.SSS5.p2.m5" class="ltx_Math" alttext="o" display="inline" intent=":literal"><semantics><mi>o</mi><annotation encoding="application/x-tex">o</annotation></semantics></math>. Otherwise, we use the <math id="A2.SS1.SSS5.p2.m6" class="ltx_Math" alttext="k" display="inline" intent=":literal"><semantics><mi>k</mi><annotation encoding="application/x-tex">k</annotation></semantics></math> sampled indices directly.</p>
</div>
<div id="A2.SS1.SSS5.p3" class="ltx_para ltx_noindent">
<p id="A2.SS1.SSS5.p3.1" class="ltx_p">A simple way to sample <math id="A2.SS1.SSS5.p3.m1" class="ltx_Math" alttext="k" display="inline" intent=":literal"><semantics><mi>k</mi><annotation encoding="application/x-tex">k</annotation></semantics></math> random indices without repetition is to shuffle a list of <math id="A2.SS1.SSS5.p3.m2" class="ltx_Math" alttext="K" display="inline" intent=":literal"><semantics><mi>K</mi><annotation encoding="application/x-tex">K</annotation></semantics></math> integers and take the first <math id="A2.SS1.SSS5.p3.m3" class="ltx_Math" alttext="k" display="inline" intent=":literal"><semantics><mi>k</mi><annotation encoding="application/x-tex">k</annotation></semantics></math>. However, this defeats the purpose of our efficient curriculum, as it requires materializing large tensors. Instead, Floyd’s algorithm <cite class="ltx_cite ltx_citemacro_citep">(<a href="#bib.bib4" title="" class="ltx_ref">Bentley, 1999</a>)</cite>, given in Algo. <a href="#alg2" title="Algorithm 2 ‣ B.1.5 Sampling Integers Without Repetitions and Without Shuffling ‣ B.1 Sampling the top-𝑘 values in 𝐰_𝑡^ℓ Without Materializing The Full Vector ‣ Appendix B Fast Curriculum ‣ The Diffusion Duality, Chapter II: Ψ-Samplers and Efficient Curriculum" class="ltx_ref"><span class="ltx_text ltx_ref_tag">2</span></a>, samples without repetition while avoiding shuffling. Although sequential with <math id="A2.SS1.SSS5.p3.m4" class="ltx_Math" alttext="k" display="inline" intent=":literal"><semantics><mi>k</mi><annotation encoding="application/x-tex">k</annotation></semantics></math> iterations, it is much faster than shuffling when <math id="A2.SS1.SSS5.p3.m5" class="ltx_Math" alttext="k\ll K" display="inline" intent=":literal"><semantics><mrow><mi>k</mi><mo>≪</mo><mi>K</mi></mrow><annotation encoding="application/x-tex">k\ll K</annotation></semantics></math>.</p>
</div>
<figure id="alg2" class="ltx_float ltx_float_algorithm ltx_framed ltx_framed_top">
<figcaption class="ltx_caption"><span class="ltx_tag ltx_tag_float"><span id="alg2.3" class="ltx_text ltx_font_bold">Algorithm 2</span> </span> Floyd’s Algorithm for Sampling Without Repetition</figcaption>
<div id="alg2.4" class="ltx_listing ltx_framed ltx_framed_topbottom ltx_listing">
<div id="alg2.l1" class="ltx_listingline">
                
                
               <span id="alg2.l1.2" class="ltx_text ltx_font_bold">Input</span> Number of possible values <math id="alg2.l1.m1" class="ltx_Math" alttext="N" display="inline" intent=":literal"><semantics><mi>N</mi><annotation encoding="application/x-tex">N</annotation></semantics></math>, number of samples <math id="alg2.l1.m2" class="ltx_Math" alttext="k" display="inline" intent=":literal"><semantics><mi>k</mi><annotation encoding="application/x-tex">k</annotation></semantics></math>.

</div>
<div id="alg2.l2" class="ltx_listingline">
                
                
               Initialize array <math id="alg2.l2.m1" class="ltx_Math" alttext="S" display="inline" intent=":literal"><semantics><mi>S</mi><annotation encoding="application/x-tex">S</annotation></semantics></math> of size <math id="alg2.l2.m2" class="ltx_Math" alttext="k" display="inline" intent=":literal"><semantics><mi>k</mi><annotation encoding="application/x-tex">k</annotation></semantics></math> to store samples

</div>
<div id="alg2.l3" class="ltx_listingline">
                
                
               <span id="alg2.l3.2" class="ltx_text ltx_font_bold">for</span> <math id="alg2.l3.m1" class="ltx_Math" alttext="t=0" display="inline" intent=":literal"><semantics><mrow><mi>t</mi><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">t=0</annotation></semantics></math> to <math id="alg2.l3.m2" class="ltx_Math" alttext="k-1" display="inline" intent=":literal"><semantics><mrow><mi>k</mi><mo>−</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">k-1</annotation></semantics></math> <span id="alg2.l3.3" class="ltx_text ltx_font_bold">do</span>



</div>
<div id="alg2.l4" class="ltx_listingline">
                
                
                Sample <math id="alg2.l4.m1" class="ltx_Math" alttext="j\sim\text{Randint}(0,N-k+t)" display="inline" intent=":literal"><semantics><mrow><mi>j</mi><mo>∼</mo><mrow><mtext>Randint</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mn>0</mn><mo>,</mo><mrow><mrow><mi>N</mi><mo>−</mo><mi>k</mi></mrow><mo>+</mo><mi>t</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">j\sim\text{Randint}(0,N-k+t)</annotation></semantics></math>

</div>
<div id="alg2.l5" class="ltx_listingline">
                
                
                <span id="alg2.l5.2" class="ltx_text ltx_font_bold">if</span> <math id="alg2.l5.m1" class="ltx_Math" alttext="t&gt;0" display="inline" intent=":literal"><semantics><mrow><mi>t</mi><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">t&gt;0</annotation></semantics></math> and <math id="alg2.l5.m2" class="ltx_Math" alttext="j" display="inline" intent=":literal"><semantics><mi>j</mi><annotation encoding="application/x-tex">j</annotation></semantics></math> appears in <math id="alg2.l5.m3" class="ltx_math_unparsed" alttext="S[0:t]" display="inline" intent=":literal"><semantics><mrow><mi>S</mi><mrow><mo stretchy="false">[</mo><mn>0</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mi>t</mi><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">S[0:t]</annotation></semantics></math> <span id="alg2.l5.3" class="ltx_text ltx_font_bold">then</span>



</div>
<div id="alg2.l6" class="ltx_listingline">
                
                
                 <math id="alg2.l6.m1" class="ltx_Math" alttext="S[t]\leftarrow N-k+t" display="inline" intent=":literal"><semantics><mrow><mrow><mi>S</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mi>t</mi><mo stretchy="false">]</mo></mrow></mrow><mo stretchy="false">←</mo><mrow><mrow><mi>N</mi><mo>−</mo><mi>k</mi></mrow><mo>+</mo><mi>t</mi></mrow></mrow><annotation encoding="application/x-tex">S[t]\leftarrow N-k+t</annotation></semantics></math> {Use largest remaining value}

</div>
<div id="alg2.l7" class="ltx_listingline">
                
                
                <span id="alg2.l7.2" class="ltx_text ltx_font_bold">else</span>


</div>
<div id="alg2.l8" class="ltx_listingline">
                
                
                 <math id="alg2.l8.m1" class="ltx_Math" alttext="S[t]\leftarrow j" display="inline" intent=":literal"><semantics><mrow><mrow><mi>S</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mi>t</mi><mo stretchy="false">]</mo></mrow></mrow><mo stretchy="false">←</mo><mi>j</mi></mrow><annotation encoding="application/x-tex">S[t]\leftarrow j</annotation></semantics></math>

</div>
<div id="alg2.l9" class="ltx_listingline">
                
                
                <span id="alg2.l9.2" class="ltx_text ltx_font_bold">end</span> <span id="alg2.l9.3" class="ltx_text ltx_font_bold">if</span>
</div>
<div id="alg2.l10" class="ltx_listingline">
                
                
               <span id="alg2.l10.2" class="ltx_text ltx_font_bold">end</span> <span id="alg2.l10.3" class="ltx_text ltx_font_bold">for</span>
</div>
<div id="alg2.l11" class="ltx_listingline">
                
                
               <span id="alg2.l11.2" class="ltx_text ltx_font_bold">return</span> <math id="alg2.l11.m1" class="ltx_Math" alttext="S" display="inline" intent=":literal"><semantics><mi>S</mi><annotation encoding="application/x-tex">S</annotation></semantics></math>

</div>
</div>
</figure>
</section>
</section>
<section id="A2.SS2" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">B.2 </span>Approximating the Weighted Sum of the Embeddings</h3>

<div id="A2.SS2.p1" class="ltx_para ltx_noindent">
<p id="A2.SS2.p1.1" class="ltx_p">After extracting the top-<math id="A2.SS2.p1.m1" class="ltx_Math" alttext="k" display="inline" intent=":literal"><semantics><mi>k</mi><annotation encoding="application/x-tex">k</annotation></semantics></math> values and indices <math id="A2.SS2.p1.m2" class="ltx_Math" alttext="(\mathcal{K},\mathcal{I})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi class="ltx_font_mathcaligraphic">𝒦</mi><mo>,</mo><mi class="ltx_font_mathcaligraphic">ℐ</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(\mathcal{K},\mathcal{I})</annotation></semantics></math> from <math id="A2.SS2.p1.m3" class="ltx_Math" alttext="{\mathbf{w}}_{t}^{{\color[rgb]{0.4688,0.4688,0.4688}\ell}}" display="inline" intent=":literal"><semantics><msubsup><mi>𝐰</mi><mi>t</mi><mi style="--ltx-fg-color:#787878;" mathcolor="#787878" mathvariant="normal">ℓ</mi></msubsup><annotation encoding="application/x-tex">{\mathbf{w}}_{t}^{{\color[rgb]{0.4688,0.4688,0.4688}\ell}}</annotation></semantics></math>, we approximate the
softmax-weighted embedding by retaining only the <math id="A2.SS2.p1.m4" class="ltx_Math" alttext="k" display="inline" intent=":literal"><semantics><mi>k</mi><annotation encoding="application/x-tex">k</annotation></semantics></math> selected rows of the <math id="A2.SS2.p1.m5" class="ltx_Math" alttext="\texttt{embeddings}\in\mathbb{R}^{K\times d}" display="inline" intent=":literal"><semantics><mrow><mtext class="ltx_mathvariant_monospace">embeddings</mtext><mo>∈</mo><msup><mi>ℝ</mi><mrow><mi>K</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>d</mi></mrow></msup></mrow><annotation encoding="application/x-tex">\texttt{embeddings}\in\mathbb{R}^{K\times d}</annotation></semantics></math> (<math id="A2.SS2.p1.m6" class="ltx_Math" alttext="d" display="inline" intent=":literal"><semantics><mi>d</mi><annotation encoding="application/x-tex">d</annotation></semantics></math> denotes the embedding size):</p>
<table id="A2.EGx15" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A2.E39"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A2.E39.m1" class="ltx_Math" alttext="\displaystyle{\color[rgb]{0.6055,0,0}\mathrm{softmax}}({\mathbf{w}}_{t}^{{\color[rgb]{0.4688,0.4688,0.4688}\ell}})^{\top}\texttt{embeddings}\approx\sum_{i=1}^{k}\frac{\exp(\mathcal{K}_{i}/\tau)}{\tilde{Z}}\texttt{embeddings}[{\mathcal{I}_{i}}]," display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mi style="--ltx-fg-color:#9A0000;" mathcolor="#9A0000">softmax</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><msubsup><mi>𝐰</mi><mi>t</mi><mi style="--ltx-fg-color:#787878;" mathcolor="#787878" mathvariant="normal">ℓ</mi></msubsup><mo stretchy="false">)</mo></mrow><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mtext class="ltx_mathvariant_monospace">embeddings</mtext></mrow><mo>≈</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>k</mi></munderover></mstyle><mrow><mstyle displaystyle="true"><mfrac><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi class="ltx_font_mathcaligraphic">𝒦</mi><mi>i</mi></msub><mo>/</mo><mi>τ</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mover accent="true"><mi>Z</mi><mo>~</mo></mover></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mtext class="ltx_mathvariant_monospace">embeddings</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><msub><mi class="ltx_font_mathcaligraphic">ℐ</mi><mi>i</mi></msub><mo stretchy="false">]</mo></mrow></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle{\color[rgb]{0.6055,0,0}\mathrm{softmax}}({\mathbf{w}}_{t}^{{\color[rgb]{0.4688,0.4688,0.4688}\ell}})^{\top}\texttt{embeddings}\approx\sum_{i=1}^{k}\frac{\exp(\mathcal{K}_{i}/\tau)}{\tilde{Z}}\texttt{embeddings}[{\mathcal{I}_{i}}],</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(39)</span></td></tr></tbody>
</table>
<p id="A2.SS2.p1.2" class="ltx_p">where <math id="A2.SS2.p1.m7" class="ltx_Math" alttext="\texttt{embeddings}[j]" display="inline" intent=":literal"><semantics><mrow><mtext class="ltx_mathvariant_monospace">embeddings</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mi>j</mi><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">\texttt{embeddings}[j]</annotation></semantics></math> denotes the <math id="A2.SS2.p1.m8" class="ltx_Math" alttext="j" display="inline" intent=":literal"><semantics><mi>j</mi><annotation encoding="application/x-tex">j</annotation></semantics></math>-th row.</p>
</div>
<div id="A2.SS2.p2" class="ltx_para ltx_noindent">
<p id="A2.SS2.p2.1" class="ltx_p">The normalizer <math id="A2.SS2.p2.m1" class="ltx_Math" alttext="\tilde{Z}" display="inline" intent=":literal"><semantics><mover accent="true"><mi>Z</mi><mo>~</mo></mover><annotation encoding="application/x-tex">\tilde{Z}</annotation></semantics></math> includes both sampled (top-<math id="A2.SS2.p2.m2" class="ltx_Math" alttext="k" display="inline" intent=":literal"><semantics><mi>k</mi><annotation encoding="application/x-tex">k</annotation></semantics></math>) and unsampled terms. To account for this contribution, let</p>
<table id="A2.EGx16" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A2.E40"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A2.E40.m1" class="ltx_Math" alttext="\displaystyle\mu=\mathbb{E}[\exp(X/\tau)\mid X&lt;\mathcal{K}_{k}]" display="inline" intent=":literal"><semantics><mrow><mi>μ</mi><mo>=</mo><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>X</mi><mo>/</mo><mi>τ</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0.167em">∣</mo><mrow><mi>X</mi><mo>&lt;</mo><msub><mi class="ltx_font_mathcaligraphic">𝒦</mi><mi>k</mi></msub></mrow></mrow><mo stretchy="false">]</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\mu=\mathbb{E}[\exp(X/\tau)\mid X&lt;\mathcal{K}_{k}]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(40)</span></td></tr></tbody>
</table>
<p id="A2.SS2.p2.2" class="ltx_p">denote the expectation that a r.v. <math id="A2.SS2.p2.m3" class="ltx_Math" alttext="X" display="inline" intent=":literal"><semantics><mi>X</mi><annotation encoding="application/x-tex">X</annotation></semantics></math> with pmf <math id="A2.SS2.p2.m4" class="ltx_Math" alttext="{\mathcal{N}}(0,{\color[rgb]{0.9023,0.5703,0.2188}\tilde{\sigma}_{t}^{{\color[rgb]{0,0,0}2}}})" display="inline" intent=":literal"><semantics><mrow><mi class="ltx_font_mathcaligraphic">𝒩</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mn>0</mn><mo>,</mo><msubsup><mover accent="true"><mi style="--ltx-fg-color:#E69138;" mathcolor="#E69138">σ</mi><mo>~</mo></mover><mi style="--ltx-fg-color:#E69138;" mathcolor="#E69138">t</mi><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">2</mn></msubsup><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">{\mathcal{N}}(0,{\color[rgb]{0.9023,0.5703,0.2188}\tilde{\sigma}_{t}^{{\color[rgb]{0,0,0}2}}})</annotation></semantics></math> is less than <math id="A2.SS2.p2.m5" class="ltx_Math" alttext="\mathcal{K}_{k}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">𝒦</mi><mi>k</mi></msub><annotation encoding="application/x-tex">\mathcal{K}_{k}</annotation></semantics></math>.</p>
</div>
<div id="A2.SS2.p3" class="ltx_para ltx_noindent">
<p id="A2.SS2.p3.1" class="ltx_p">We approximate <math id="A2.SS2.p3.m1" class="ltx_Math" alttext="\tilde{Z}" display="inline" intent=":literal"><semantics><mover accent="true"><mi>Z</mi><mo>~</mo></mover><annotation encoding="application/x-tex">\tilde{Z}</annotation></semantics></math> via two cases.
Let <math id="A2.SS2.p3.m2" class="ltx_Math" alttext="o" display="inline" intent=":literal"><semantics><mi>o</mi><annotation encoding="application/x-tex">o</annotation></semantics></math> be the index corresponding to the clean-token category in <math id="A2.SS2.p3.m3" class="ltx_Math" alttext="{\mathbf{x}}^{{\color[rgb]{0.4688,0.4688,0.4688}\ell}}" display="inline" intent=":literal"><semantics><msup><mi>𝐱</mi><mi style="--ltx-fg-color:#787878;" mathcolor="#787878" mathvariant="normal">ℓ</mi></msup><annotation encoding="application/x-tex">{\mathbf{x}}^{{\color[rgb]{0.4688,0.4688,0.4688}\ell}}</annotation></semantics></math>, and let <math id="A2.SS2.p3.m4" class="ltx_Math" alttext="\tilde{w}\sim{\mathcal{N}}({\color[rgb]{0.9023,0.5703,0.2188}\tilde{\alpha}_{t}},{\color[rgb]{0.9023,0.5703,0.2188}\tilde{\sigma}_{t}^{{\color[rgb]{0,0,0}2}}})" display="inline" intent=":literal"><semantics><mrow><mover accent="true"><mi>w</mi><mo>~</mo></mover><mo>∼</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒩</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi style="--ltx-fg-color:#E69138;" mathcolor="#E69138">α</mi><mo>~</mo></mover><mi style="--ltx-fg-color:#E69138;" mathcolor="#E69138">t</mi></msub><mo>,</mo><msubsup><mover accent="true"><mi style="--ltx-fg-color:#E69138;" mathcolor="#E69138">σ</mi><mo>~</mo></mover><mi style="--ltx-fg-color:#E69138;" mathcolor="#E69138">t</mi><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">2</mn></msubsup><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\tilde{w}\sim{\mathcal{N}}({\color[rgb]{0.9023,0.5703,0.2188}\tilde{\alpha}_{t}},{\color[rgb]{0.9023,0.5703,0.2188}\tilde{\sigma}_{t}^{{\color[rgb]{0,0,0}2}}})</annotation></semantics></math>.</p>
</div>
<div id="A2.SS2.p4" class="ltx_para ltx_noindent">
<p id="A2.SS2.p4.1" class="ltx_p"><span id="A2.SS2.p4.1.1" class="ltx_text" style="--ltx-bg-color:#F0E0BD;">Case 1.</span> If <math id="A2.SS2.p4.m1" class="ltx_Math" alttext="o" display="inline" intent=":literal"><semantics><mi>o</mi><annotation encoding="application/x-tex">o</annotation></semantics></math> is not among the top-<math id="A2.SS2.p4.m2" class="ltx_Math" alttext="k" display="inline" intent=":literal"><semantics><mi>k</mi><annotation encoding="application/x-tex">k</annotation></semantics></math> indices (i.e., <math id="A2.SS2.p4.m3" class="ltx_Math" alttext="o\notin\mathcal{I}" display="inline" intent=":literal"><semantics><mrow><mi>o</mi><mo>∉</mo><mi class="ltx_font_mathcaligraphic">ℐ</mi></mrow><annotation encoding="application/x-tex">o\notin\mathcal{I}</annotation></semantics></math>, and consequently <math id="A2.SS2.p4.m4" class="ltx_Math" alttext="\tilde{w}\notin\mathcal{K}" display="inline" intent=":literal"><semantics><mrow><mover accent="true"><mi>w</mi><mo>~</mo></mover><mo>∉</mo><mi class="ltx_font_mathcaligraphic">𝒦</mi></mrow><annotation encoding="application/x-tex">\tilde{w}\notin\mathcal{K}</annotation></semantics></math>), then <math id="A2.SS2.p4.m5" class="ltx_Math" alttext="\tilde{Z}" display="inline" intent=":literal"><semantics><mover accent="true"><mi>Z</mi><mo>~</mo></mover><annotation encoding="application/x-tex">\tilde{Z}</annotation></semantics></math> includes: (i) the <math id="A2.SS2.p4.m6" class="ltx_Math" alttext="k" display="inline" intent=":literal"><semantics><mi>k</mi><annotation encoding="application/x-tex">k</annotation></semantics></math> terms in <math id="A2.SS2.p4.m7" class="ltx_Math" alttext="\mathcal{K}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">𝒦</mi><annotation encoding="application/x-tex">\mathcal{K}</annotation></semantics></math>, (ii) the explicit contribution from index <math id="A2.SS2.p4.m8" class="ltx_Math" alttext="o" display="inline" intent=":literal"><semantics><mi>o</mi><annotation encoding="application/x-tex">o</annotation></semantics></math>, and (iii) the remaining <math id="A2.SS2.p4.m9" class="ltx_Math" alttext="K-k-1" display="inline" intent=":literal"><semantics><mrow><mi>K</mi><mo>−</mo><mi>k</mi><mo>−</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">K-k-1</annotation></semantics></math> unsampled terms, each approximated by <math id="A2.SS2.p4.m10" class="ltx_Math" alttext="\mu" display="inline" intent=":literal"><semantics><mi>μ</mi><annotation encoding="application/x-tex">\mu</annotation></semantics></math>. Thus,</p>
<table id="A2.EGx17" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A2.E41"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A2.E41.m1" class="ltx_Math" alttext="\displaystyle\tilde{Z}\approx\underbrace{\sum_{i=1}^{k}\exp\left(\frac{\mathcal{K}_{i}}{\tau}\right)}_{\text{top-$k$ terms}}+\underbrace{\exp\left(\frac{\tilde{w}}{\tau}\right)}_{\text{index $o$}}+\underbrace{(K-k-1)\mu}_{\text{unsampled terms}}." display="inline" intent=":literal"><semantics><mrow><mrow><mover accent="true"><mi>Z</mi><mo>~</mo></mover><mo>≈</mo><mrow><munder><munder accentunder="true"><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>k</mi></munderover></mstyle><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo>(</mo><mstyle displaystyle="true"><mfrac><msub><mi class="ltx_font_mathcaligraphic">𝒦</mi><mi>i</mi></msub><mi>τ</mi></mfrac></mstyle><mo>)</mo></mrow></mrow></mrow><mo stretchy="true">⏟</mo></munder><mrow><mtext>top-</mtext><mi mathsize="0.700em">k</mi><mtext> terms</mtext></mrow></munder><mo>+</mo><munder><munder accentunder="true"><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo>(</mo><mstyle displaystyle="true"><mfrac><mover accent="true"><mi>w</mi><mo>~</mo></mover><mi>τ</mi></mfrac></mstyle><mo>)</mo></mrow></mrow><mo stretchy="true">⏟</mo></munder><mrow><mtext>index </mtext><mi mathsize="0.700em">o</mi></mrow></munder><mo>+</mo><munder><munder accentunder="true"><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>K</mi><mo>−</mo><mi>k</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>μ</mi></mrow><mo stretchy="true">⏟</mo></munder><mtext>unsampled terms</mtext></munder></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\tilde{Z}\approx\underbrace{\sum_{i=1}^{k}\exp\left(\frac{\mathcal{K}_{i}}{\tau}\right)}_{\text{top-$k$ terms}}+\underbrace{\exp\left(\frac{\tilde{w}}{\tau}\right)}_{\text{index $o$}}+\underbrace{(K-k-1)\mu}_{\text{unsampled terms}}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(41)</span></td></tr></tbody>
</table>
<p id="A2.SS2.p4.2" class="ltx_p"><span id="A2.SS2.p4.2.1" class="ltx_text" style="--ltx-bg-color:#A3D4B0;">Case 2.</span> If <math id="A2.SS2.p4.m11" class="ltx_Math" alttext="o" display="inline" intent=":literal"><semantics><mi>o</mi><annotation encoding="application/x-tex">o</annotation></semantics></math> is among the top-<math id="A2.SS2.p4.m12" class="ltx_Math" alttext="k" display="inline" intent=":literal"><semantics><mi>k</mi><annotation encoding="application/x-tex">k</annotation></semantics></math> indices (i.e., <math id="A2.SS2.p4.m13" class="ltx_Math" alttext="o\in\mathcal{I}" display="inline" intent=":literal"><semantics><mrow><mi>o</mi><mo>∈</mo><mi class="ltx_font_mathcaligraphic">ℐ</mi></mrow><annotation encoding="application/x-tex">o\in\mathcal{I}</annotation></semantics></math>, and hence, <math id="A2.SS2.p4.m14" class="ltx_Math" alttext="\tilde{w}\in\mathcal{K}" display="inline" intent=":literal"><semantics><mrow><mover accent="true"><mi>w</mi><mo>~</mo></mover><mo>∈</mo><mi class="ltx_font_mathcaligraphic">𝒦</mi></mrow><annotation encoding="application/x-tex">\tilde{w}\in\mathcal{K}</annotation></semantics></math>), its contribution is already included in the top-<math id="A2.SS2.p4.m15" class="ltx_Math" alttext="k" display="inline" intent=":literal"><semantics><mi>k</mi><annotation encoding="application/x-tex">k</annotation></semantics></math> sum, leaving <math id="A2.SS2.p4.m16" class="ltx_Math" alttext="K-k" display="inline" intent=":literal"><semantics><mrow><mi>K</mi><mo>−</mo><mi>k</mi></mrow><annotation encoding="application/x-tex">K-k</annotation></semantics></math> unsampled terms. Hence,</p>
<table id="A2.EGx18" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A2.E42"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A2.E42.m1" class="ltx_Math" alttext="\displaystyle\tilde{Z}\approx\underbrace{\sum_{i=1}^{k}\exp\left(\frac{\mathcal{K}_{i}}{\tau}\right)}_{\text{top-$k$ terms}}+\underbrace{(K-k)\mu}_{\text{unsampled terms}}." display="inline" intent=":literal"><semantics><mrow><mrow><mover accent="true"><mi>Z</mi><mo>~</mo></mover><mo>≈</mo><mrow><munder><munder accentunder="true"><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>k</mi></munderover></mstyle><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo>(</mo><mstyle displaystyle="true"><mfrac><msub><mi class="ltx_font_mathcaligraphic">𝒦</mi><mi>i</mi></msub><mi>τ</mi></mfrac></mstyle><mo>)</mo></mrow></mrow></mrow><mo stretchy="true">⏟</mo></munder><mrow><mtext>top-</mtext><mi mathsize="0.700em">k</mi><mtext> terms</mtext></mrow></munder><mo>+</mo><munder><munder accentunder="true"><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>K</mi><mo>−</mo><mi>k</mi></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>μ</mi></mrow><mo stretchy="true">⏟</mo></munder><mtext>unsampled terms</mtext></munder></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\tilde{Z}\approx\underbrace{\sum_{i=1}^{k}\exp\left(\frac{\mathcal{K}_{i}}{\tau}\right)}_{\text{top-$k$ terms}}+\underbrace{(K-k)\mu}_{\text{unsampled terms}}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(42)</span></td></tr></tbody>
</table>
<p id="A2.SS2.p4.3" class="ltx_p">Next, we derive a closed-form expression for <math id="A2.SS2.p4.m17" class="ltx_Math" alttext="\mu" display="inline" intent=":literal"><semantics><mi>μ</mi><annotation encoding="application/x-tex">\mu</annotation></semantics></math> in (<a href="#A2.E40" title="Equation 40 ‣ B.2 Approximating the Weighted Sum of the Embeddings ‣ Appendix B Fast Curriculum ‣ The Diffusion Duality, Chapter II: Ψ-Samplers and Efficient Curriculum" class="ltx_ref"><span class="ltx_text ltx_ref_tag">40</span></a>).</p>
</div>
<div id="A2.SS2.p5" class="ltx_para">
<table id="A2.E43" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A2.E43.m1" class="ltx_Math" alttext="\mu=\log\mathbb{E}[\exp(X)\mid X&lt;\mathcal{K}_{k}]=\frac{{\color[rgb]{0.9023,0.5703,0.2188}\tilde{\sigma}_{t}^{{\color[rgb]{0,0,0}2}}}}{2\tau^{2}}-\log\Phi\left(\frac{\mathcal{K}_{k}}{{\color[rgb]{0.9023,0.5703,0.2188}\tilde{\sigma}_{t}}}\right)+\log\Phi\left(\frac{\mathcal{K}_{k}-{\color[rgb]{0.9023,0.5703,0.2188}\tilde{\sigma}_{t}^{{\color[rgb]{0,0,0}2}}}/\tau}{{\color[rgb]{0.9023,0.5703,0.2188}\tilde{\sigma}_{t}}}\right)." display="block" intent=":literal"><semantics><mrow><mrow><mi>μ</mi><mo>=</mo><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0.167em">∣</mo><mrow><mi>X</mi><mo>&lt;</mo><msub><mi class="ltx_font_mathcaligraphic">𝒦</mi><mi>k</mi></msub></mrow></mrow><mo stretchy="false">]</mo></mrow></mrow></mrow><mo>=</mo><mrow><mrow><mfrac><msubsup><mover accent="true"><mi style="--ltx-fg-color:#E69138;" mathcolor="#E69138">σ</mi><mo>~</mo></mover><mi style="--ltx-fg-color:#E69138;" mathcolor="#E69138">t</mi><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">2</mn></msubsup><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msup><mi>τ</mi><mn>2</mn></msup></mrow></mfrac><mo>−</mo><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mrow><mi mathvariant="normal">Φ</mi><mo>⁡</mo><mrow><mo>(</mo><mfrac><msub><mi class="ltx_font_mathcaligraphic">𝒦</mi><mi>k</mi></msub><msub><mover accent="true"><mi style="--ltx-fg-color:#E69138;" mathcolor="#E69138">σ</mi><mo>~</mo></mover><mi style="--ltx-fg-color:#E69138;" mathcolor="#E69138">t</mi></msub></mfrac><mo>)</mo></mrow></mrow></mrow></mrow><mo>+</mo><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mrow><mi mathvariant="normal">Φ</mi><mo>⁡</mo><mrow><mo>(</mo><mfrac><mrow><msub><mi class="ltx_font_mathcaligraphic">𝒦</mi><mi>k</mi></msub><mo>−</mo><mrow><msubsup><mover accent="true"><mi style="--ltx-fg-color:#E69138;" mathcolor="#E69138">σ</mi><mo>~</mo></mover><mi style="--ltx-fg-color:#E69138;" mathcolor="#E69138">t</mi><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">2</mn></msubsup><mo>/</mo><mi>τ</mi></mrow></mrow><msub><mover accent="true"><mi style="--ltx-fg-color:#E69138;" mathcolor="#E69138">σ</mi><mo>~</mo></mover><mi style="--ltx-fg-color:#E69138;" mathcolor="#E69138">t</mi></msub></mfrac><mo>)</mo></mrow></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\mu=\log\mathbb{E}[\exp(X)\mid X&lt;\mathcal{K}_{k}]=\frac{{\color[rgb]{0.9023,0.5703,0.2188}\tilde{\sigma}_{t}^{{\color[rgb]{0,0,0}2}}}}{2\tau^{2}}-\log\Phi\left(\frac{\mathcal{K}_{k}}{{\color[rgb]{0.9023,0.5703,0.2188}\tilde{\sigma}_{t}}}\right)+\log\Phi\left(\frac{\mathcal{K}_{k}-{\color[rgb]{0.9023,0.5703,0.2188}\tilde{\sigma}_{t}^{{\color[rgb]{0,0,0}2}}}/\tau}{{\color[rgb]{0.9023,0.5703,0.2188}\tilde{\sigma}_{t}}}\right).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(43)</span></td></tr></tbody>
</table>
</div>
<div id="A2.SS2.2" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="A2.SS2.p6" class="ltx_para">
<table id="A2.EGx19" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A2.Ex6"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A2.Ex6.m1" class="ltx_Math" alttext="\displaystyle\mu=" display="inline" intent=":literal"><semantics><mrow><mi>μ</mi><mo>=</mo><mphantom></mphantom></mrow><annotation encoding="application/x-tex">\displaystyle\mu=</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex6.m2" class="ltx_Math" alttext="\displaystyle\log\mathbb{E}\left[\exp\left(\frac{X}{\tau}\right)\mid X&lt;\mathcal{K}_{k}\right]" display="inline" intent=":literal"><semantics><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><mrow><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo>(</mo><mstyle displaystyle="true"><mfrac><mi>X</mi><mi>τ</mi></mfrac></mstyle><mo>)</mo></mrow></mrow><mo lspace="0em" rspace="0.167em">∣</mo><mrow><mi>X</mi><mo>&lt;</mo><msub><mi class="ltx_font_mathcaligraphic">𝒦</mi><mi>k</mi></msub></mrow></mrow><mo>]</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\log\mathbb{E}\left[\exp\left(\frac{X}{\tau}\right)\mid X&lt;\mathcal{K}_{k}\right]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A2.Ex7"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><span id="A2.Ex7.3.1" class="ltx_text ltx_markedasmath">Applying change of variables <math id="A2.Ex7.m1.m1" class="ltx_Math" alttext="\bar{X}=X/\tau" display="inline" intent=":literal"><semantics><mrow><mover accent="true"><mi>X</mi><mo>¯</mo></mover><mo>=</mo><mrow><mi>X</mi><mo>/</mo><mi>τ</mi></mrow></mrow><annotation encoding="application/x-tex">\bar{X}=X/\tau</annotation></semantics></math>; we get,</span></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A2.Ex8"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex8.m1" class="ltx_Math" alttext="\displaystyle=\log\mathbb{E}[\exp(\bar{X})\mid\bar{X}&lt;\mathcal{K}_{k}/\tau]" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mover accent="true"><mi>X</mi><mo>¯</mo></mover><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0.167em">∣</mo><mrow><mover accent="true"><mi>X</mi><mo>¯</mo></mover><mo>&lt;</mo><mrow><msub><mi class="ltx_font_mathcaligraphic">𝒦</mi><mi>k</mi></msub><mo>/</mo><mi>τ</mi></mrow></mrow></mrow><mo stretchy="false">]</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\log\mathbb{E}[\exp(\bar{X})\mid\bar{X}&lt;\mathcal{K}_{k}/\tau]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A2.Ex9"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex9.m1" class="ltx_math_unparsed" alttext="\displaystyle=\log\int_{-\infty}^{\mathcal{K}_{k}/\tau}\exp(x)\frac{f_{\bar{X}}(x)}{\mathbb{P}(\bar{X}&lt;\mathcal{K}_{k}/\tau)}dx" display="inline" intent=":literal"><semantics><mrow><mo>=</mo><mi>log</mi><mstyle displaystyle="true"><msubsup><mo>∫</mo><mrow><mo>−</mo><mi mathvariant="normal">∞</mi></mrow><mrow><msub><mi class="ltx_font_mathcaligraphic">𝒦</mi><mi>k</mi></msub><mo>/</mo><mi>τ</mi></mrow></msubsup></mstyle><mi>exp</mi><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow><mstyle displaystyle="true"><mfrac><mrow><msub><mi>f</mi><mover accent="true"><mi>X</mi><mo>¯</mo></mover></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mrow><mi>ℙ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mover accent="true"><mi>X</mi><mo>¯</mo></mover><mo>&lt;</mo><mrow><msub><mi class="ltx_font_mathcaligraphic">𝒦</mi><mi>k</mi></msub><mo>/</mo><mi>τ</mi></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle><mi>d</mi><mi>x</mi></mrow><annotation encoding="application/x-tex">\displaystyle=\log\int_{-\infty}^{\mathcal{K}_{k}/\tau}\exp(x)\frac{f_{\bar{X}}(x)}{\mathbb{P}(\bar{X}&lt;\mathcal{K}_{k}/\tau)}dx</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A2.Ex10"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><span id="A2.Ex10.3.1" class="ltx_text ltx_markedasmath">Substituting <math id="A2.Ex10.m1.m1" class="ltx_Math" alttext="\sigma:={\color[rgb]{0.9023,0.5703,0.2188}\tilde{\sigma}_{t}}/\tau" display="inline" intent=":literal"><semantics><mrow><mi>σ</mi><mo>:=</mo><mrow><msub><mover accent="true"><mi style="--ltx-fg-color:#E69138;" mathcolor="#E69138">σ</mi><mo>~</mo></mover><mi style="--ltx-fg-color:#E69138;" mathcolor="#E69138">t</mi></msub><mo>/</mo><mi>τ</mi></mrow></mrow><annotation encoding="application/x-tex">\sigma:={\color[rgb]{0.9023,0.5703,0.2188}\tilde{\sigma}_{t}}/\tau</annotation></semantics></math>, we get:</span></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A2.Ex11"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex11.m1" class="ltx_Math" alttext="\displaystyle=\log\left[\frac{1}{\Phi(\mathcal{K}_{k}/{\color[rgb]{0.9023,0.5703,0.2188}\tilde{\sigma}_{t}})}\int_{-\infty}^{\mathcal{K}_{k}/\tau}\exp(x)\frac{1}{\sqrt{2\pi\sigma^{2}}}\exp\left(-\frac{x^{2}}{2\sigma^{2}}\right)dx\right]" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mi>log</mi><mo>⁡</mo><mrow><mo>[</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mrow><mi mathvariant="normal">Φ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi class="ltx_font_mathcaligraphic">𝒦</mi><mi>k</mi></msub><mo>/</mo><msub><mover accent="true"><mi style="--ltx-fg-color:#E69138;" mathcolor="#E69138">σ</mi><mo>~</mo></mover><mi style="--ltx-fg-color:#E69138;" mathcolor="#E69138">t</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><msubsup><mo>∫</mo><mrow><mo>−</mo><mi mathvariant="normal">∞</mi></mrow><mrow><msub><mi class="ltx_font_mathcaligraphic">𝒦</mi><mi>k</mi></msub><mo>/</mo><mi>τ</mi></mrow></msubsup></mstyle><mrow><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><msqrt><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>π</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>σ</mi><mn>2</mn></msup></mrow></msqrt></mfrac></mstyle><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mo>−</mo><mstyle displaystyle="true"><mfrac><msup><mi>x</mi><mn>2</mn></msup><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msup><mi>σ</mi><mn>2</mn></msup></mrow></mfrac></mstyle></mrow><mo>)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo rspace="0em">𝑑</mo><mi>x</mi></mrow></mrow></mrow></mrow><mo>]</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\log\left[\frac{1}{\Phi(\mathcal{K}_{k}/{\color[rgb]{0.9023,0.5703,0.2188}\tilde{\sigma}_{t}})}\int_{-\infty}^{\mathcal{K}_{k}/\tau}\exp(x)\frac{1}{\sqrt{2\pi\sigma^{2}}}\exp\left(-\frac{x^{2}}{2\sigma^{2}}\right)dx\right]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A2.Ex12"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex12.m1" class="ltx_Math" alttext="\displaystyle=\log\left[\frac{1}{\Phi(\mathcal{K}_{k}/{\color[rgb]{0.9023,0.5703,0.2188}\tilde{\sigma}_{t}})}\frac{1}{\sqrt{2\pi\sigma^{2}}}\int_{-\infty}^{\mathcal{K}_{k}/\tau}\exp\left(-\frac{x^{2}}{2\sigma^{2}}+x\right)dx\right]" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mi>log</mi><mo>⁡</mo><mrow><mo>[</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mrow><mi mathvariant="normal">Φ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi class="ltx_font_mathcaligraphic">𝒦</mi><mi>k</mi></msub><mo>/</mo><msub><mover accent="true"><mi style="--ltx-fg-color:#E69138;" mathcolor="#E69138">σ</mi><mo>~</mo></mover><mi style="--ltx-fg-color:#E69138;" mathcolor="#E69138">t</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><msqrt><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>π</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>σ</mi><mn>2</mn></msup></mrow></msqrt></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><msubsup><mo>∫</mo><mrow><mo>−</mo><mi mathvariant="normal">∞</mi></mrow><mrow><msub><mi class="ltx_font_mathcaligraphic">𝒦</mi><mi>k</mi></msub><mo>/</mo><mi>τ</mi></mrow></msubsup></mstyle><mrow><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mrow><mo>−</mo><mstyle displaystyle="true"><mfrac><msup><mi>x</mi><mn>2</mn></msup><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msup><mi>σ</mi><mn>2</mn></msup></mrow></mfrac></mstyle></mrow><mo>+</mo><mi>x</mi></mrow><mo>)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo rspace="0em">𝑑</mo><mi>x</mi></mrow></mrow></mrow></mrow><mo>]</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\log\left[\frac{1}{\Phi(\mathcal{K}_{k}/{\color[rgb]{0.9023,0.5703,0.2188}\tilde{\sigma}_{t}})}\frac{1}{\sqrt{2\pi\sigma^{2}}}\int_{-\infty}^{\mathcal{K}_{k}/\tau}\exp\left(-\frac{x^{2}}{2\sigma^{2}}+x\right)dx\right]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A2.Ex13"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex13.m1" class="ltx_Math" alttext="\displaystyle=\log\left[\frac{1}{\Phi(\mathcal{K}_{k}/{\color[rgb]{0.9023,0.5703,0.2188}\tilde{\sigma}_{t}})}\frac{1}{\sqrt{2\pi\sigma^{2}}}\int_{-\infty}^{\mathcal{K}_{k}/\tau}\exp\left(-\frac{1}{2\sigma^{2}}(x^{2}-2\sigma^{2}x+\sigma^{4}-\sigma^{4})\right)dx\right]" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mi>log</mi><mo>⁡</mo><mrow><mo>[</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mrow><mi mathvariant="normal">Φ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi class="ltx_font_mathcaligraphic">𝒦</mi><mi>k</mi></msub><mo>/</mo><msub><mover accent="true"><mi style="--ltx-fg-color:#E69138;" mathcolor="#E69138">σ</mi><mo>~</mo></mover><mi style="--ltx-fg-color:#E69138;" mathcolor="#E69138">t</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><msqrt><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>π</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>σ</mi><mn>2</mn></msup></mrow></msqrt></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><msubsup><mo>∫</mo><mrow><mo>−</mo><mi mathvariant="normal">∞</mi></mrow><mrow><msub><mi class="ltx_font_mathcaligraphic">𝒦</mi><mi>k</mi></msub><mo>/</mo><mi>τ</mi></mrow></msubsup></mstyle><mrow><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mo>−</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msup><mi>σ</mi><mn>2</mn></msup></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mrow><msup><mi>x</mi><mn>2</mn></msup><mo>−</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msup><mi>σ</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mi>x</mi></mrow></mrow><mo>+</mo><msup><mi>σ</mi><mn>4</mn></msup></mrow><mo>−</mo><msup><mi>σ</mi><mn>4</mn></msup></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo rspace="0em">𝑑</mo><mi>x</mi></mrow></mrow></mrow></mrow><mo>]</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\log\left[\frac{1}{\Phi(\mathcal{K}_{k}/{\color[rgb]{0.9023,0.5703,0.2188}\tilde{\sigma}_{t}})}\frac{1}{\sqrt{2\pi\sigma^{2}}}\int_{-\infty}^{\mathcal{K}_{k}/\tau}\exp\left(-\frac{1}{2\sigma^{2}}(x^{2}-2\sigma^{2}x+\sigma^{4}-\sigma^{4})\right)dx\right]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A2.Ex14"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex14.m1" class="ltx_Math" alttext="\displaystyle=\log\left[\frac{\exp(\sigma^{2}/2)}{\Phi(\mathcal{K}_{k}/{\color[rgb]{0.9023,0.5703,0.2188}\tilde{\sigma}_{t}})}\frac{1}{\sqrt{2\pi\sigma^{2}}}\int_{-\infty}^{\mathcal{K}_{k}/\tau}\exp\left(-\frac{1}{2\sigma^{2}}(x-\sigma^{2})^{2}\right)dx\right]" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mi>log</mi><mo>⁡</mo><mrow><mo>[</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mi>σ</mi><mn>2</mn></msup><mo>/</mo><mn>2</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><mrow><mi mathvariant="normal">Φ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi class="ltx_font_mathcaligraphic">𝒦</mi><mi>k</mi></msub><mo>/</mo><msub><mover accent="true"><mi style="--ltx-fg-color:#E69138;" mathcolor="#E69138">σ</mi><mo>~</mo></mover><mi style="--ltx-fg-color:#E69138;" mathcolor="#E69138">t</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><msqrt><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>π</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>σ</mi><mn>2</mn></msup></mrow></msqrt></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><msubsup><mo>∫</mo><mrow><mo>−</mo><mi mathvariant="normal">∞</mi></mrow><mrow><msub><mi class="ltx_font_mathcaligraphic">𝒦</mi><mi>k</mi></msub><mo>/</mo><mi>τ</mi></mrow></msubsup></mstyle><mrow><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mo>−</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msup><mi>σ</mi><mn>2</mn></msup></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mi>x</mi><mo>−</mo><msup><mi>σ</mi><mn>2</mn></msup></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mrow></mrow><mo>)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo rspace="0em">𝑑</mo><mi>x</mi></mrow></mrow></mrow></mrow><mo>]</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\log\left[\frac{\exp(\sigma^{2}/2)}{\Phi(\mathcal{K}_{k}/{\color[rgb]{0.9023,0.5703,0.2188}\tilde{\sigma}_{t}})}\frac{1}{\sqrt{2\pi\sigma^{2}}}\int_{-\infty}^{\mathcal{K}_{k}/\tau}\exp\left(-\frac{1}{2\sigma^{2}}(x-\sigma^{2})^{2}\right)dx\right]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A2.Ex15"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex15.m1" class="ltx_Math" alttext="\displaystyle=\log\left[\frac{\exp(\sigma^{2}/2)}{\Phi(\mathcal{K}_{k}/{\color[rgb]{0.9023,0.5703,0.2188}\tilde{\sigma}_{t}})}\Phi\left(\frac{\mathcal{K}_{k}/\tau-\sigma^{2}}{\sigma}\right)\right]" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mi>log</mi><mo>⁡</mo><mrow><mo>[</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mi>σ</mi><mn>2</mn></msup><mo>/</mo><mn>2</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><mrow><mi mathvariant="normal">Φ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi class="ltx_font_mathcaligraphic">𝒦</mi><mi>k</mi></msub><mo>/</mo><msub><mover accent="true"><mi style="--ltx-fg-color:#E69138;" mathcolor="#E69138">σ</mi><mo>~</mo></mover><mi style="--ltx-fg-color:#E69138;" mathcolor="#E69138">t</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mi mathvariant="normal">Φ</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mstyle displaystyle="true"><mfrac><mrow><mrow><msub><mi class="ltx_font_mathcaligraphic">𝒦</mi><mi>k</mi></msub><mo>/</mo><mi>τ</mi></mrow><mo>−</mo><msup><mi>σ</mi><mn>2</mn></msup></mrow><mi>σ</mi></mfrac></mstyle><mo>)</mo></mrow></mrow><mo>]</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\log\left[\frac{\exp(\sigma^{2}/2)}{\Phi(\mathcal{K}_{k}/{\color[rgb]{0.9023,0.5703,0.2188}\tilde{\sigma}_{t}})}\Phi\left(\frac{\mathcal{K}_{k}/\tau-\sigma^{2}}{\sigma}\right)\right]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A2.Ex16"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex16.m1" class="ltx_Math" alttext="\displaystyle=\frac{\sigma^{2}}{2}-\log\Phi\left(\frac{\mathcal{K}_{k}}{{\color[rgb]{0.9023,0.5703,0.2188}\tilde{\sigma}_{t}}}\right)+\log\Phi\left(\frac{\mathcal{K}_{k}/\tau-\sigma^{2}}{\sigma}\right)" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><mstyle displaystyle="true"><mfrac><msup><mi>σ</mi><mn>2</mn></msup><mn>2</mn></mfrac></mstyle><mo>−</mo><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mrow><mi mathvariant="normal">Φ</mi><mo>⁡</mo><mrow><mo>(</mo><mstyle displaystyle="true"><mfrac><msub><mi class="ltx_font_mathcaligraphic">𝒦</mi><mi>k</mi></msub><msub><mover accent="true"><mi style="--ltx-fg-color:#E69138;" mathcolor="#E69138">σ</mi><mo>~</mo></mover><mi style="--ltx-fg-color:#E69138;" mathcolor="#E69138">t</mi></msub></mfrac></mstyle><mo>)</mo></mrow></mrow></mrow></mrow><mo>+</mo><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mrow><mi mathvariant="normal">Φ</mi><mo>⁡</mo><mrow><mo>(</mo><mstyle displaystyle="true"><mfrac><mrow><mrow><msub><mi class="ltx_font_mathcaligraphic">𝒦</mi><mi>k</mi></msub><mo>/</mo><mi>τ</mi></mrow><mo>−</mo><msup><mi>σ</mi><mn>2</mn></msup></mrow><mi>σ</mi></mfrac></mstyle><mo>)</mo></mrow></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\frac{\sigma^{2}}{2}-\log\Phi\left(\frac{\mathcal{K}_{k}}{{\color[rgb]{0.9023,0.5703,0.2188}\tilde{\sigma}_{t}}}\right)+\log\Phi\left(\frac{\mathcal{K}_{k}/\tau-\sigma^{2}}{\sigma}\right)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A2.Ex17"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><span id="A2.Ex17.3.1" class="ltx_text ltx_markedasmath">Substituting back <math id="A2.Ex17.m1.m1" class="ltx_Math" alttext="\sigma:={\color[rgb]{0.9023,0.5703,0.2188}\tilde{\sigma}_{t}}/\tau" display="inline" intent=":literal"><semantics><mrow><mi>σ</mi><mo>:=</mo><mrow><msub><mover accent="true"><mi style="--ltx-fg-color:#E69138;" mathcolor="#E69138">σ</mi><mo>~</mo></mover><mi style="--ltx-fg-color:#E69138;" mathcolor="#E69138">t</mi></msub><mo>/</mo><mi>τ</mi></mrow></mrow><annotation encoding="application/x-tex">\sigma:={\color[rgb]{0.9023,0.5703,0.2188}\tilde{\sigma}_{t}}/\tau</annotation></semantics></math>, we get:</span></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A2.E44"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.E44.m1" class="ltx_Math" alttext="\displaystyle=\frac{{\color[rgb]{0.9023,0.5703,0.2188}\tilde{\sigma}_{t}^{{\color[rgb]{0,0,0}2}}}}{2\tau^{2}}-\log\Phi\left(\frac{\mathcal{K}_{k}}{{\color[rgb]{0.9023,0.5703,0.2188}\tilde{\sigma}_{t}}}\right)+\log\Phi\left(\frac{\mathcal{K}_{k}-{\color[rgb]{0.9023,0.5703,0.2188}\tilde{\sigma}_{t}^{{\color[rgb]{0,0,0}2}}}/\tau}{{\color[rgb]{0.9023,0.5703,0.2188}\tilde{\sigma}_{t}}}\right)" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><mstyle displaystyle="true"><mfrac><msubsup><mover accent="true"><mi style="--ltx-fg-color:#E69138;" mathcolor="#E69138">σ</mi><mo>~</mo></mover><mi style="--ltx-fg-color:#E69138;" mathcolor="#E69138">t</mi><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">2</mn></msubsup><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msup><mi>τ</mi><mn>2</mn></msup></mrow></mfrac></mstyle><mo>−</mo><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mrow><mi mathvariant="normal">Φ</mi><mo>⁡</mo><mrow><mo>(</mo><mstyle displaystyle="true"><mfrac><msub><mi class="ltx_font_mathcaligraphic">𝒦</mi><mi>k</mi></msub><msub><mover accent="true"><mi style="--ltx-fg-color:#E69138;" mathcolor="#E69138">σ</mi><mo>~</mo></mover><mi style="--ltx-fg-color:#E69138;" mathcolor="#E69138">t</mi></msub></mfrac></mstyle><mo>)</mo></mrow></mrow></mrow></mrow><mo>+</mo><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mrow><mi mathvariant="normal">Φ</mi><mo>⁡</mo><mrow><mo>(</mo><mstyle displaystyle="true"><mfrac><mrow><msub><mi class="ltx_font_mathcaligraphic">𝒦</mi><mi>k</mi></msub><mo>−</mo><mrow><msubsup><mover accent="true"><mi style="--ltx-fg-color:#E69138;" mathcolor="#E69138">σ</mi><mo>~</mo></mover><mi style="--ltx-fg-color:#E69138;" mathcolor="#E69138">t</mi><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">2</mn></msubsup><mo>/</mo><mi>τ</mi></mrow></mrow><msub><mover accent="true"><mi style="--ltx-fg-color:#E69138;" mathcolor="#E69138">σ</mi><mo>~</mo></mover><mi style="--ltx-fg-color:#E69138;" mathcolor="#E69138">t</mi></msub></mfrac></mstyle><mo>)</mo></mrow></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\frac{{\color[rgb]{0.9023,0.5703,0.2188}\tilde{\sigma}_{t}^{{\color[rgb]{0,0,0}2}}}}{2\tau^{2}}-\log\Phi\left(\frac{\mathcal{K}_{k}}{{\color[rgb]{0.9023,0.5703,0.2188}\tilde{\sigma}_{t}}}\right)+\log\Phi\left(\frac{\mathcal{K}_{k}-{\color[rgb]{0.9023,0.5703,0.2188}\tilde{\sigma}_{t}^{{\color[rgb]{0,0,0}2}}}/\tau}{{\color[rgb]{0.9023,0.5703,0.2188}\tilde{\sigma}_{t}}}\right)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(44)</span></td></tr></tbody>
</table>
<p id="A2.SS2.p6.1" class="ltx_p"><span id="A2.SS2.p6.1.1" class="ltx_text">This concludes our proof.
∎</span></p>
</div>
</div>
<div id="A2.SS2.p7" class="ltx_para ltx_noindent">
<p id="A2.SS2.p7.1" class="ltx_p">Finally, substituting the value of <math id="A2.SS2.p7.m1" class="ltx_Math" alttext="\mu" display="inline" intent=":literal"><semantics><mi>μ</mi><annotation encoding="application/x-tex">\mu</annotation></semantics></math> from (<a href="#A2.Ex6" title="In Proof. ‣ B.2 Approximating the Weighted Sum of the Embeddings ‣ Appendix B Fast Curriculum ‣ The Diffusion Duality, Chapter II: Ψ-Samplers and Efficient Curriculum" class="ltx_ref"><span class="ltx_text ltx_ref_tag">44</span></a>) into (<a href="#A2.E41" title="Equation 41 ‣ B.2 Approximating the Weighted Sum of the Embeddings ‣ Appendix B Fast Curriculum ‣ The Diffusion Duality, Chapter II: Ψ-Samplers and Efficient Curriculum" class="ltx_ref"><span class="ltx_text ltx_ref_tag">41</span></a>) and (<a href="#A2.E42" title="Equation 42 ‣ B.2 Approximating the Weighted Sum of the Embeddings ‣ Appendix B Fast Curriculum ‣ The Diffusion Duality, Chapter II: Ψ-Samplers and Efficient Curriculum" class="ltx_ref"><span class="ltx_text ltx_ref_tag">42</span></a>), we obtain:</p>
<table id="A2.EGx20" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A2.E45"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A2.E45.m1" class="ltx_Math" alttext="\displaystyle\tilde{Z}\approx" display="inline" intent=":literal"><semantics><mrow><mover accent="true"><mi>Z</mi><mo>~</mo></mover><mo>≈</mo><mphantom></mphantom></mrow><annotation encoding="application/x-tex">\displaystyle\tilde{Z}\approx</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.E45.m2" class="ltx_Math" alttext="\displaystyle\underbrace{\sum_{i=1}^{k}\exp\left(\frac{\mathcal{K}_{i}}{\tau}\right)}_{\text{top-$k$ terms}}+\underbrace{\delta\exp\left(\frac{\tilde{w}}{\tau}\right)}_{\text{clean token}}+\underbrace{(K-k-\delta)\exp\left(\frac{{\color[rgb]{0.9023,0.5703,0.2188}\tilde{\sigma}_{t}^{{\color[rgb]{0,0,0}2}}}}{2\tau^{2}}-\log\Phi\!\left(\frac{\mathcal{K}_{k}}{{\color[rgb]{0.9023,0.5703,0.2188}\tilde{\sigma}_{t}}}\right)+\log\Phi\!\left(\frac{\mathcal{K}_{k}-{\color[rgb]{0.9023,0.5703,0.2188}\tilde{\sigma}_{t}^{{\color[rgb]{0,0,0}2}}}/\tau}{{\color[rgb]{0.9023,0.5703,0.2188}\tilde{\sigma}_{t}}}\right)\right)}_{\text{unsampled zero-mean terms}}," display="inline" intent=":literal"><semantics><mrow><mrow><munder><munder accentunder="true"><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>k</mi></munderover></mstyle><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo>(</mo><mstyle displaystyle="true"><mfrac><msub><mi class="ltx_font_mathcaligraphic">𝒦</mi><mi>i</mi></msub><mi>τ</mi></mfrac></mstyle><mo>)</mo></mrow></mrow></mrow><mo stretchy="true">⏟</mo></munder><mrow><mtext>top-</mtext><mi mathsize="0.700em">k</mi><mtext> terms</mtext></mrow></munder><mo>+</mo><munder><munder accentunder="true"><mrow><mi>δ</mi><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo>(</mo><mstyle displaystyle="true"><mfrac><mover accent="true"><mi>w</mi><mo>~</mo></mover><mi>τ</mi></mfrac></mstyle><mo>)</mo></mrow></mrow></mrow><mo stretchy="true">⏟</mo></munder><mtext>clean token</mtext></munder><mo>+</mo><munder><munder accentunder="true"><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>K</mi><mo>−</mo><mi>k</mi><mo>−</mo><mi>δ</mi></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mrow><mstyle displaystyle="true"><mfrac><msubsup><mover accent="true"><mi style="--ltx-fg-color:#E69138;" mathcolor="#E69138">σ</mi><mo>~</mo></mover><mi style="--ltx-fg-color:#E69138;" mathcolor="#E69138">t</mi><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">2</mn></msubsup><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msup><mi>τ</mi><mn>2</mn></msup></mrow></mfrac></mstyle><mo>−</mo><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mrow><mpadded style="width:0.497em;" width="0.497em"><mi mathvariant="normal">Φ</mi></mpadded><mo>⁡</mo><mrow><mo>(</mo><mstyle displaystyle="true"><mfrac><msub><mi class="ltx_font_mathcaligraphic">𝒦</mi><mi>k</mi></msub><msub><mover accent="true"><mi style="--ltx-fg-color:#E69138;" mathcolor="#E69138">σ</mi><mo>~</mo></mover><mi style="--ltx-fg-color:#E69138;" mathcolor="#E69138">t</mi></msub></mfrac></mstyle><mo>)</mo></mrow></mrow></mrow></mrow><mo>+</mo><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mrow><mpadded style="width:0.497em;" width="0.497em"><mi mathvariant="normal">Φ</mi></mpadded><mo>⁡</mo><mrow><mo>(</mo><mstyle displaystyle="true"><mfrac><mrow><msub><mi class="ltx_font_mathcaligraphic">𝒦</mi><mi>k</mi></msub><mo>−</mo><mrow><msubsup><mover accent="true"><mi style="--ltx-fg-color:#E69138;" mathcolor="#E69138">σ</mi><mo>~</mo></mover><mi style="--ltx-fg-color:#E69138;" mathcolor="#E69138">t</mi><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">2</mn></msubsup><mo>/</mo><mi>τ</mi></mrow></mrow><msub><mover accent="true"><mi style="--ltx-fg-color:#E69138;" mathcolor="#E69138">σ</mi><mo>~</mo></mover><mi style="--ltx-fg-color:#E69138;" mathcolor="#E69138">t</mi></msub></mfrac></mstyle><mo>)</mo></mrow></mrow></mrow></mrow><mo>)</mo></mrow></mrow></mrow><mo stretchy="true">⏟</mo></munder><mtext>unsampled zero-mean terms</mtext></munder></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\underbrace{\sum_{i=1}^{k}\exp\left(\frac{\mathcal{K}_{i}}{\tau}\right)}_{\text{top-$k$ terms}}+\underbrace{\delta\exp\left(\frac{\tilde{w}}{\tau}\right)}_{\text{clean token}}+\underbrace{(K-k-\delta)\exp\left(\frac{{\color[rgb]{0.9023,0.5703,0.2188}\tilde{\sigma}_{t}^{{\color[rgb]{0,0,0}2}}}}{2\tau^{2}}-\log\Phi\!\left(\frac{\mathcal{K}_{k}}{{\color[rgb]{0.9023,0.5703,0.2188}\tilde{\sigma}_{t}}}\right)+\log\Phi\!\left(\frac{\mathcal{K}_{k}-{\color[rgb]{0.9023,0.5703,0.2188}\tilde{\sigma}_{t}^{{\color[rgb]{0,0,0}2}}}/\tau}{{\color[rgb]{0.9023,0.5703,0.2188}\tilde{\sigma}_{t}}}\right)\right)}_{\text{unsampled zero-mean terms}},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(45)</span></td></tr></tbody>
</table>
</div>
</section>
<section id="A2.SS3" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">B.3 </span>Efficient computation of <math id="A2.SS3.m1" class="ltx_Math" alttext="{\color[rgb]{0.6055,0,0}\mathcal{T}}" display="inline" intent=":literal"><semantics><mi style="--ltx-fg-color:#9A0000;" class="ltx_font_mathcaligraphic" mathcolor="#9A0000">𝒯</mi><annotation encoding="application/x-tex">{\color[rgb]{0.6055,0,0}\mathcal{T}}</annotation></semantics></math> During Training</h3>

<div id="A2.SS3.p1" class="ltx_para ltx_noindent">
<p id="A2.SS3.p1.1" class="ltx_p">The curriculum objective in (<a href="#S2.E9" title="Equation 9 ‣ Curriculum Learning ‣ 2.1.2 Uniform-state Diffusion Processes ‣ 2.1 Discrete Diffusion Models ‣ 2 Background ‣ The Diffusion Duality, Chapter II: Ψ-Samplers and Efficient Curriculum" class="ltx_ref"><span class="ltx_text ltx_ref_tag">9</span></a>) requires evaluating the diffusion transformation operator <math id="A2.SS3.p1.m1" class="ltx_Math" alttext="{\color[rgb]{0.6055,0,0}\mathcal{T}}(\cdot)" display="inline" intent=":literal"><semantics><mrow><mi style="--ltx-fg-color:#9A0000;" class="ltx_font_mathcaligraphic" mathcolor="#9A0000">𝒯</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">{\color[rgb]{0.6055,0,0}\mathcal{T}}(\cdot)</annotation></semantics></math>. Directly computing <math id="A2.SS3.p1.m2" class="ltx_Math" alttext="{\color[rgb]{0.6055,0,0}\mathcal{T}}" display="inline" intent=":literal"><semantics><mi style="--ltx-fg-color:#9A0000;" class="ltx_font_mathcaligraphic" mathcolor="#9A0000">𝒯</mi><annotation encoding="application/x-tex">{\color[rgb]{0.6055,0,0}\mathcal{T}}</annotation></semantics></math> via (<a href="#S2.E6" title="Equation 6 ‣ The Diffusion Duality ‣ 2.1.2 Uniform-state Diffusion Processes ‣ 2.1 Discrete Diffusion Models ‣ 2 Background ‣ The Diffusion Duality, Chapter II: Ψ-Samplers and Efficient Curriculum" class="ltx_ref"><span class="ltx_text ltx_ref_tag">6</span></a>) is prohibitively expensive during training; <cite class="ltx_cite ltx_citemacro_citet"><a href="#bib.bib7" title="" class="ltx_ref">Sahoo et al. (2025a)</a></cite> therefore precompute and cache many <math id="A2.SS3.p1.m3" class="ltx_Math" alttext="({\color[rgb]{0.043,0.3242,0.5898}\alpha_{t}},{\color[rgb]{0.6055,0,0}\mathcal{T}}({\color[rgb]{0.9023,0.5703,0.2188}\tilde{\alpha}_{t}}))" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><msub><mi style="--ltx-fg-color:#0B5396;" mathcolor="#0B5396">α</mi><mi style="--ltx-fg-color:#0B5396;" mathcolor="#0B5396">t</mi></msub><mo>,</mo><mrow><mi style="--ltx-fg-color:#9A0000;" class="ltx_font_mathcaligraphic" mathcolor="#9A0000">𝒯</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi style="--ltx-fg-color:#E69138;" mathcolor="#E69138">α</mi><mo>~</mo></mover><mi style="--ltx-fg-color:#E69138;" mathcolor="#E69138">t</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">({\color[rgb]{0.043,0.3242,0.5898}\alpha_{t}},{\color[rgb]{0.6055,0,0}\mathcal{T}}({\color[rgb]{0.9023,0.5703,0.2188}\tilde{\alpha}_{t}}))</annotation></semantics></math> pairs, which is cumbersome. Instead, we compute <math id="A2.SS3.p1.m4" class="ltx_Math" alttext="{\color[rgb]{0.6055,0,0}\mathcal{T}}(\cdot)" display="inline" intent=":literal"><semantics><mrow><mi style="--ltx-fg-color:#9A0000;" class="ltx_font_mathcaligraphic" mathcolor="#9A0000">𝒯</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">{\color[rgb]{0.6055,0,0}\mathcal{T}}(\cdot)</annotation></semantics></math> on the fly using its Taylor expansion, detailed below. This derivation relies on two propositions that justify swapping the order of (i) summation and integration (Prop. <a href="#A2.Thmtheorem5" title="Proposition B.5 (First Corollary of the Dominated Convergence Theorem ( ( ) , Theorem 2.25)). ‣ B.3 Efficient computation of 𝒯 During Training ‣ Appendix B Fast Curriculum ‣ The Diffusion Duality, Chapter II: Ψ-Samplers and Efficient Curriculum" class="ltx_ref"><span class="ltx_text ltx_ref_tag">B.5</span></a>) and (ii) differentiation and integration (Prop. <a href="#A2.Thmtheorem6" title="Proposition B.6 (Second Corollary of the Dominated Convergence Theorem ( ( ) , Theorem 2.27)). ‣ B.3 Efficient computation of 𝒯 During Training ‣ Appendix B Fast Curriculum ‣ The Diffusion Duality, Chapter II: Ψ-Samplers and Efficient Curriculum" class="ltx_ref"><span class="ltx_text ltx_ref_tag">B.6</span></a>).</p>
</div>
<div id="A2.Thmtheorem5" class="ltx_theorem ltx_theorem_proposition">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="A2.Thmtheorem5.2" class="ltx_text ltx_font_bold">Proposition B.5</span></span><span id="A2.Thmtheorem5.3" class="ltx_text ltx_font_bold"> </span>(First Corollary of the Dominated Convergence Theorem (<cite class="ltx_cite ltx_citemacro_citet"><a href="#bib.bib61" title="" class="ltx_ref">Folland (1999)</a></cite>, Theorem 2.25))<span id="A2.Thmtheorem5.4" class="ltx_text ltx_font_bold">.</span></h6>
<div id="A2.Thmtheorem5.p1" class="ltx_para ltx_noindent">
<p id="A2.Thmtheorem5.p1.1" class="ltx_p"><span id="A2.Thmtheorem5.p1.1.1" class="ltx_text ltx_font_italic">If the sum <math id="A2.Thmtheorem5.p1.m1" class="ltx_Math" alttext="\sum_{n=0}^{\infty}f_{n}(x)" display="inline" intent=":literal"><semantics><mrow><msubsup><mo>∑</mo><mrow><mi>n</mi><mo>=</mo><mn>0</mn></mrow><mi mathvariant="normal">∞</mi></msubsup><mrow><msub><mi>f</mi><mi>n</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\sum_{n=0}^{\infty}f_{n}(x)</annotation></semantics></math> exists for all <math id="A2.Thmtheorem5.p1.m2" class="ltx_Math" alttext="x" display="inline" intent=":literal"><semantics><mi>x</mi><annotation encoding="application/x-tex">x</annotation></semantics></math> and there exists an integrable function <math id="A2.Thmtheorem5.p1.m3" class="ltx_Math" alttext="g(x)" display="inline" intent=":literal"><semantics><mrow><mi>g</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">g(x)</annotation></semantics></math> such that</span></p>
<table id="A2.E46" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A2.E46.m1" class="ltx_Math" alttext="\left|\sum_{n=0}^{k}f_{n}(x)\right|\leq g(x)" display="block" intent=":literal"><semantics><mrow><mrow><mo>|</mo><mrow><munderover><mo lspace="0em" movablelimits="false">∑</mo><mrow><mi>n</mi><mo>=</mo><mn>0</mn></mrow><mi>k</mi></munderover><mrow><msub><mi>f</mi><mi>n</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>|</mo></mrow><mo>≤</mo><mrow><mi>g</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\left|\sum_{n=0}^{k}f_{n}(x)\right|\leq g(x)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(46)</span></td></tr></tbody>
</table>
<p id="A2.Thmtheorem5.p1.2" class="ltx_p"><span id="A2.Thmtheorem5.p1.2.1" class="ltx_text ltx_font_italic">for all <math id="A2.Thmtheorem5.p1.m4" class="ltx_Math" alttext="k" display="inline" intent=":literal"><semantics><mi>k</mi><annotation encoding="application/x-tex">k</annotation></semantics></math>, then</span></p>
<table id="A2.E47" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A2.E47.m1" class="ltx_Math" alttext="\int_{-\infty}^{\infty}\sum_{n=0}^{\infty}f_{n}(x)dx=\sum_{n=0}^{\infty}\int_{-\infty}^{\infty}f_{n}(x)dx." display="block" intent=":literal"><semantics><mrow><mrow><mrow><msubsup><mo>∫</mo><mrow><mo>−</mo><mi mathvariant="normal">∞</mi></mrow><mi mathvariant="normal">∞</mi></msubsup><mrow><munderover><mo lspace="0.167em" movablelimits="false">∑</mo><mrow><mi>n</mi><mo>=</mo><mn>0</mn></mrow><mi mathvariant="normal">∞</mi></munderover><mrow><msub><mi>f</mi><mi>n</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo rspace="0em">𝑑</mo><mi>x</mi></mrow></mrow></mrow></mrow><mo rspace="0.111em">=</mo><mrow><munderover><mo movablelimits="false" rspace="0em">∑</mo><mrow><mi>n</mi><mo>=</mo><mn>0</mn></mrow><mi mathvariant="normal">∞</mi></munderover><mrow><msubsup><mo>∫</mo><mrow><mo>−</mo><mi mathvariant="normal">∞</mi></mrow><mi mathvariant="normal">∞</mi></msubsup><mrow><msub><mi>f</mi><mi>n</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo rspace="0em">𝑑</mo><mi>x</mi></mrow></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\int_{-\infty}^{\infty}\sum_{n=0}^{\infty}f_{n}(x)dx=\sum_{n=0}^{\infty}\int_{-\infty}^{\infty}f_{n}(x)dx.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(47)</span></td></tr></tbody>
</table>
</div>
</div>
<div id="A2.Thmtheorem6" class="ltx_theorem ltx_theorem_proposition">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="A2.Thmtheorem6.2" class="ltx_text ltx_font_bold">Proposition B.6</span></span><span id="A2.Thmtheorem6.3" class="ltx_text ltx_font_bold"> </span>(Second Corollary of the Dominated Convergence Theorem (<cite class="ltx_cite ltx_citemacro_citet"><a href="#bib.bib61" title="" class="ltx_ref">Folland (1999)</a></cite>, Theorem 2.27))<span id="A2.Thmtheorem6.4" class="ltx_text ltx_font_bold">.</span></h6>
<div id="A2.Thmtheorem6.p1" class="ltx_para ltx_noindent">
<p id="A2.Thmtheorem6.p1.1" class="ltx_p"><span id="A2.Thmtheorem6.p1.1.1" class="ltx_text ltx_font_italic">Let <math id="A2.Thmtheorem6.p1.m1" class="ltx_Math" alttext="f(x,t)" display="inline" intent=":literal"><semantics><mrow><mi>f</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">f(x,t)</annotation></semantics></math> be differentiable in <math id="A2.Thmtheorem6.p1.m2" class="ltx_Math" alttext="t" display="inline" intent=":literal"><semantics><mi>t</mi><annotation encoding="application/x-tex">t</annotation></semantics></math> and suppose there exists a function <math id="A2.Thmtheorem6.p1.m3" class="ltx_Math" alttext="g(x,t)" display="inline" intent=":literal"><semantics><mrow><mi>g</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">g(x,t)</annotation></semantics></math> such that:</span></p>
<ol id="A2.I1" class="ltx_enumerate">
<li id="A2.I1.i1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">1.</span> 
<div id="A2.I1.i1.p1" class="ltx_para ltx_noindent">
<p id="A2.I1.i1.p1.1" class="ltx_p"><math id="A2.I1.i1.p1.m1" class="ltx_Math" alttext="\left|\frac{\partial f(x,t)}{\partial t}\right|\leq g(x,t_{0})" display="inline" intent=":literal"><semantics><mrow><mrow><mo>|</mo><mfrac><mrow><mo>∂</mo><mrow><mi>f</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mrow><mo>∂</mo><mi>t</mi></mrow></mfrac><mo>|</mo></mrow><mo>≤</mo><mrow><mi>g</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><msub><mi>t</mi><mn>0</mn></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\left|\frac{\partial f(x,t)}{\partial t}\right|\leq g(x,t_{0})</annotation></semantics></math><span id="A2.I1.i1.p1.1.1" class="ltx_text ltx_font_italic"> for all </span><math id="A2.I1.i1.p1.m2" class="ltx_Math" alttext="x" display="inline" intent=":literal"><semantics><mi>x</mi><annotation encoding="application/x-tex">x</annotation></semantics></math><span id="A2.I1.i1.p1.1.2" class="ltx_text ltx_font_italic"> and </span><math id="A2.I1.i1.p1.m3" class="ltx_Math" alttext="t" display="inline" intent=":literal"><semantics><mi>t</mi><annotation encoding="application/x-tex">t</annotation></semantics></math><span id="A2.I1.i1.p1.1.3" class="ltx_text ltx_font_italic"> in some neighborhood </span><math id="A2.I1.i1.p1.m4" class="ltx_Math" alttext="|t-t_{0}|\leq\delta_{0}" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">|</mo><mrow><mi>t</mi><mo>−</mo><msub><mi>t</mi><mn>0</mn></msub></mrow><mo stretchy="false">|</mo></mrow><mo>≤</mo><msub><mi>δ</mi><mn>0</mn></msub></mrow><annotation encoding="application/x-tex">|t-t_{0}|\leq\delta_{0}</annotation></semantics></math></p>
</div></li>
<li id="A2.I1.i2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">2.</span> 
<div id="A2.I1.i2.p1" class="ltx_para">
<p id="A2.I1.i2.p1.1" class="ltx_p"><math id="A2.I1.i2.p1.m1" class="ltx_Math" alttext="\int_{-\infty}^{\infty}g(x,t)dx&lt;\infty" display="inline" intent=":literal"><semantics><mrow><mrow><msubsup><mo>∫</mo><mrow><mo>−</mo><mi mathvariant="normal">∞</mi></mrow><mi mathvariant="normal">∞</mi></msubsup><mrow><mrow><mi>g</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo rspace="0em">𝑑</mo><mi>x</mi></mrow></mrow></mrow><mo>&lt;</mo><mi mathvariant="normal">∞</mi></mrow><annotation encoding="application/x-tex">\int_{-\infty}^{\infty}g(x,t)dx&lt;\infty</annotation></semantics></math><span id="A2.I1.i2.p1.1.1" class="ltx_text ltx_font_italic"> for all </span><math id="A2.I1.i2.p1.m2" class="ltx_Math" alttext="t" display="inline" intent=":literal"><semantics><mi>t</mi><annotation encoding="application/x-tex">t</annotation></semantics></math></p>
</div></li>
</ol>
<p id="A2.Thmtheorem6.p1.2" class="ltx_p"><span id="A2.Thmtheorem6.p1.2.1" class="ltx_text ltx_font_italic">Then</span></p>
<table id="A2.E48" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A2.E48.m1" class="ltx_Math" alttext="\frac{d}{dt}\int_{-\infty}^{\infty}f(x,t)dx=\int_{-\infty}^{\infty}\frac{\partial f(x,t)}{\partial t}dx" display="block" intent=":literal"><semantics><mrow><mrow><mfrac><mi>d</mi><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></mfrac><mo lspace="0em" rspace="0em">​</mo><mrow><msubsup><mo>∫</mo><mrow><mo>−</mo><mi mathvariant="normal">∞</mi></mrow><mi mathvariant="normal">∞</mi></msubsup><mrow><mrow><mi>f</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo rspace="0em">𝑑</mo><mi>x</mi></mrow></mrow></mrow></mrow><mo rspace="0.111em">=</mo><mrow><msubsup><mo>∫</mo><mrow><mo>−</mo><mi mathvariant="normal">∞</mi></mrow><mi mathvariant="normal">∞</mi></msubsup><mrow><mfrac><mrow><mo>∂</mo><mrow><mi>f</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mrow><mo>∂</mo><mi>t</mi></mrow></mfrac><mo lspace="0em" rspace="0em">​</mo><mrow><mo rspace="0em">𝑑</mo><mi>x</mi></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\frac{d}{dt}\int_{-\infty}^{\infty}f(x,t)dx=\int_{-\infty}^{\infty}\frac{\partial f(x,t)}{\partial t}dx</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(48)</span></td></tr></tbody>
</table>
</div>
</div>
<section id="A2.SS3.SSS1" class="ltx_subsubsection">
<h4 class="ltx_title ltx_title_subsubsection"><span class="ltx_tag ltx_tag_subsubsection">B.3.1 </span>Series Representation of <math id="A2.SS3.SSS1.m1" class="ltx_Math" alttext="{\color[rgb]{0.6055,0,0}\mathcal{T}}" display="inline" intent=":literal"><semantics><mi style="--ltx-fg-color:#9A0000;" class="ltx_font_mathcaligraphic" mathcolor="#9A0000">𝒯</mi><annotation encoding="application/x-tex">{\color[rgb]{0.6055,0,0}\mathcal{T}}</annotation></semantics></math> and <math id="A2.SS3.SSS1.m2" class="ltx_Math" alttext="\partial_{t}{\color[rgb]{0.6055,0,0}\mathcal{T}}" display="inline" intent=":literal"><semantics><mrow><msub><mo>∂</mo><mi>t</mi></msub><mi style="--ltx-fg-color:#9A0000;" class="ltx_font_mathcaligraphic" mathcolor="#9A0000">𝒯</mi></mrow><annotation encoding="application/x-tex">\partial_{t}{\color[rgb]{0.6055,0,0}\mathcal{T}}</annotation></semantics></math></h4>

<div id="A2.SS3.SSS1.p1" class="ltx_para ltx_noindent">
<p id="A2.SS3.SSS1.p1.1" class="ltx_p">Evaluating the series expansion on the fly is faster than precomputing and caching <math id="A2.SS3.SSS1.p1.m1" class="ltx_Math" alttext="{\color[rgb]{0.6055,0,0}\mathcal{T}}" display="inline" intent=":literal"><semantics><mi style="--ltx-fg-color:#9A0000;" class="ltx_font_mathcaligraphic" mathcolor="#9A0000">𝒯</mi><annotation encoding="application/x-tex">{\color[rgb]{0.6055,0,0}\mathcal{T}}</annotation></semantics></math> for many <math id="A2.SS3.SSS1.p1.m2" class="ltx_Math" alttext="({\color[rgb]{0.043,0.3242,0.5898}\alpha_{t}},{\color[rgb]{0.6055,0,0}\mathcal{T}}({\color[rgb]{0.9023,0.5703,0.2188}\tilde{\alpha}_{t}}))" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><msub><mi style="--ltx-fg-color:#0B5396;" mathcolor="#0B5396">α</mi><mi style="--ltx-fg-color:#0B5396;" mathcolor="#0B5396">t</mi></msub><mo>,</mo><mrow><mi style="--ltx-fg-color:#9A0000;" class="ltx_font_mathcaligraphic" mathcolor="#9A0000">𝒯</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi style="--ltx-fg-color:#E69138;" mathcolor="#E69138">α</mi><mo>~</mo></mover><mi style="--ltx-fg-color:#E69138;" mathcolor="#E69138">t</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">({\color[rgb]{0.043,0.3242,0.5898}\alpha_{t}},{\color[rgb]{0.6055,0,0}\mathcal{T}}({\color[rgb]{0.9023,0.5703,0.2188}\tilde{\alpha}_{t}}))</annotation></semantics></math> pairs as done by <cite class="ltx_cite ltx_citemacro_citet"><a href="#bib.bib7" title="" class="ltx_ref">Sahoo et al. (2025a)</a></cite>. We can further speed the evaluation up by fitting a low-degree polynomial to the series, which we use in practice (see Suppl. <a href="#A2.SS3.SSS2" title="B.3.2 Polynomial Approximation of 𝒯 ‣ B.3 Efficient computation of 𝒯 During Training ‣ Appendix B Fast Curriculum ‣ The Diffusion Duality, Chapter II: Ψ-Samplers and Efficient Curriculum" class="ltx_ref"><span class="ltx_text ltx_ref_tag">B.3.2</span></a> for the approximation error analysis). Below, we derive the series expansion for <math id="A2.SS3.SSS1.p1.m3" class="ltx_Math" alttext="{\color[rgb]{0.6055,0,0}\mathcal{T}}" display="inline" intent=":literal"><semantics><mi style="--ltx-fg-color:#9A0000;" class="ltx_font_mathcaligraphic" mathcolor="#9A0000">𝒯</mi><annotation encoding="application/x-tex">{\color[rgb]{0.6055,0,0}\mathcal{T}}</annotation></semantics></math> (Prop. <a href="#A2.Thmtheorem7" title="Proposition B.7 (Series Expansion of the Diffusion Transformation Operator). ‣ B.3.1 Series Representation of 𝒯 and ∂_𝑡𝒯 ‣ B.3 Efficient computation of 𝒯 During Training ‣ Appendix B Fast Curriculum ‣ The Diffusion Duality, Chapter II: Ψ-Samplers and Efficient Curriculum" class="ltx_ref"><span class="ltx_text ltx_ref_tag">B.7</span></a>) and its time-derivative <math id="A2.SS3.SSS1.p1.m4" class="ltx_Math" alttext="\partial_{t}{\color[rgb]{0.6055,0,0}\mathcal{T}}" display="inline" intent=":literal"><semantics><mrow><msub><mo>∂</mo><mi>t</mi></msub><mi style="--ltx-fg-color:#9A0000;" class="ltx_font_mathcaligraphic" mathcolor="#9A0000">𝒯</mi></mrow><annotation encoding="application/x-tex">\partial_{t}{\color[rgb]{0.6055,0,0}\mathcal{T}}</annotation></semantics></math> (Prop. <a href="#A2.Thmtheorem8" title="Proposition B.8 (Time-Derivative of the Diffusion Transformation Operator). ‣ Advantages ‣ B.3.1 Series Representation of 𝒯 and ∂_𝑡𝒯 ‣ B.3 Efficient computation of 𝒯 During Training ‣ Appendix B Fast Curriculum ‣ The Diffusion Duality, Chapter II: Ψ-Samplers and Efficient Curriculum" class="ltx_ref"><span class="ltx_text ltx_ref_tag">B.8</span></a>):</p>
</div>
<div id="A2.Thmtheorem7" class="ltx_theorem ltx_theorem_proposition">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="A2.Thmtheorem7.2" class="ltx_text ltx_font_bold">Proposition B.7</span></span><span id="A2.Thmtheorem7.3" class="ltx_text ltx_font_bold"> </span>(Series Expansion of the Diffusion Transformation Operator)<span id="A2.Thmtheorem7.4" class="ltx_text ltx_font_bold">.</span></h6>
<div id="A2.Thmtheorem7.p1" class="ltx_para ltx_noindent">
<p id="A2.Thmtheorem7.p1.1" class="ltx_p"><span id="A2.Thmtheorem7.p1.1.1" class="ltx_text ltx_font_italic">The diffusion transformation operator <math id="A2.Thmtheorem7.p1.m1" class="ltx_Math" alttext="{\color[rgb]{0.6055,0,0}\mathcal{T}}" display="inline" intent=":literal"><semantics><mi style="--ltx-fg-color:#9A0000;" class="ltx_font_mathcaligraphic" mathcolor="#9A0000">𝒯</mi><annotation encoding="application/x-tex">{\color[rgb]{0.6055,0,0}\mathcal{T}}</annotation></semantics></math> can be expressed as:</span></p>
<table id="A2.E49" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A2.E49.m1" class="ltx_math_unparsed" alttext="{\color[rgb]{0.6055,0,0}\mathcal{T}}(\tilde{\alpha}_{t})=\frac{K}{K-1}\left[e^{-\nu_{t}^{2}/2}\sum_{n=0}^{\infty}\frac{\nu_{t}^{n}}{n!}M_{n}-\frac{1}{K}\right]" display="block" intent=":literal"><semantics><mrow><mi style="--ltx-fg-color:#9A0000;" class="ltx_font_mathcaligraphic" mathcolor="#9A0000">𝒯</mi><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi>α</mi><mo>~</mo></mover><mi>t</mi></msub><mo stretchy="false">)</mo></mrow><mo>=</mo><mfrac><mi>K</mi><mrow><mi>K</mi><mo>−</mo><mn>1</mn></mrow></mfrac><mrow><mo>[</mo><msup><mi>e</mi><mrow><mo>−</mo><mi>ν</mi><msub><mrow></mrow><mi>t</mi></msub><msup><mrow></mrow><mn>2</mn></msup><mo>/</mo><mn>2</mn></mrow></msup><munderover><mo movablelimits="false">∑</mo><mrow><mi>n</mi><mo>=</mo><mn>0</mn></mrow><mi mathvariant="normal">∞</mi></munderover><mfrac><msubsup><mi>ν</mi><mi>t</mi><mi>n</mi></msubsup><mrow><mi>n</mi><mo>!</mo></mrow></mfrac><msub><mi>M</mi><mi>n</mi></msub><mo>−</mo><mfrac><mn>1</mn><mi>K</mi></mfrac><mo>]</mo></mrow></mrow><annotation encoding="application/x-tex">{\color[rgb]{0.6055,0,0}\mathcal{T}}(\tilde{\alpha}_{t})=\frac{K}{K-1}\left[e^{-\nu_{t}^{2}/2}\sum_{n=0}^{\infty}\frac{\nu_{t}^{n}}{n!}M_{n}-\frac{1}{K}\right]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(49)</span></td></tr></tbody>
</table>
</div>
<div id="A2.Thmtheorem7.p2" class="ltx_para">
<p id="A2.Thmtheorem7.p2.1" class="ltx_p"><math id="A2.Thmtheorem7.p2.m1" class="ltx_Math" alttext="\nu_{t}=\frac{\tilde{\alpha}_{t}}{\sqrt{1-\tilde{\alpha}_{t}^{2}}}" display="inline" intent=":literal"><semantics><mrow><msub><mi>ν</mi><mi>t</mi></msub><mo>=</mo><mfrac><msub><mover accent="true"><mi>α</mi><mo>~</mo></mover><mi>t</mi></msub><msqrt><mrow><mn>1</mn><mo>−</mo><msubsup><mover accent="true"><mi>α</mi><mo>~</mo></mover><mi>t</mi><mn>2</mn></msubsup></mrow></msqrt></mfrac></mrow><annotation encoding="application/x-tex">\nu_{t}=\frac{\tilde{\alpha}_{t}}{\sqrt{1-\tilde{\alpha}_{t}^{2}}}</annotation></semantics></math><span id="A2.Thmtheorem7.p2.1.1" class="ltx_text ltx_font_italic"> and <math id="A2.Thmtheorem7.p2.m2" class="ltx_Math" alttext="M_{n}=\int_{-\infty}^{\infty}z^{n}\phi(z)\Phi^{K-1}(z)dz" display="inline" intent=":literal"><semantics><mrow><msub><mi>M</mi><mi>n</mi></msub><mo rspace="0.111em">=</mo><mrow><msubsup><mo>∫</mo><mrow><mo>−</mo><mi mathvariant="normal">∞</mi></mrow><mi mathvariant="normal">∞</mi></msubsup><mrow><msup><mi>z</mi><mi>n</mi></msup><mo lspace="0em" rspace="0em">​</mo><mi>ϕ</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>z</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mi mathvariant="normal">Φ</mi><mrow><mi>K</mi><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>z</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo rspace="0em">𝑑</mo><mi>z</mi></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">M_{n}=\int_{-\infty}^{\infty}z^{n}\phi(z)\Phi^{K-1}(z)dz</annotation></semantics></math>.</span></p>
</div>
</div>
<div id="A2.SS3.SSS1.2" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="A2.SS3.SSS1.p2" class="ltx_para ltx_noindent">
<p id="A2.SS3.SSS1.p2.1" class="ltx_p"><span id="A2.SS3.SSS1.p2.1.1" class="ltx_text">Recall that the standard Gaussian PDF is given by</span></p>
<table id="A2.E50" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A2.E50.m1" class="ltx_math_unparsed" alttext="\phi(x)=\frac{1}{\sqrt{2\pi}}e^{-x^{2}/2}." display="block" intent=":literal"><semantics><mrow><mi>ϕ</mi><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow><mo>=</mo><mfrac><mn>1</mn><msqrt><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>π</mi></mrow></msqrt></mfrac><msup><mi>e</mi><mrow><mo>−</mo><mi>x</mi><msup><mrow></mrow><mn>2</mn></msup><mo>/</mo><mn>2</mn></mrow></msup><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\phi(x)=\frac{1}{\sqrt{2\pi}}e^{-x^{2}/2}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(50)</span></td></tr></tbody>
</table>
<p id="A2.SS3.SSS1.p2.2" class="ltx_p"><span id="A2.SS3.SSS1.p2.2.1" class="ltx_text">For notational convenience, let <math id="A2.SS3.SSS1.p2.m1" class="ltx_Math" alttext="\nu_{t}=\frac{\tilde{\alpha}_{t}}{\sqrt{1-\tilde{\alpha}_{t}^{2}}}" display="inline" intent=":literal"><semantics><mrow><msub><mi>ν</mi><mi>t</mi></msub><mo>=</mo><mfrac><msub><mover accent="true"><mi>α</mi><mo>~</mo></mover><mi>t</mi></msub><msqrt><mrow><mn>1</mn><mo>−</mo><msubsup><mover accent="true"><mi>α</mi><mo>~</mo></mover><mi>t</mi><mn>2</mn></msubsup></mrow></msqrt></mfrac></mrow><annotation encoding="application/x-tex">\nu_{t}=\frac{\tilde{\alpha}_{t}}{\sqrt{1-\tilde{\alpha}_{t}^{2}}}</annotation></semantics></math>. We can rewrite <math id="A2.SS3.SSS1.p2.m2" class="ltx_Math" alttext="\phi(x-\nu_{t})" display="inline" intent=":literal"><semantics><mrow><mi>ϕ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>x</mi><mo>−</mo><msub><mi>ν</mi><mi>t</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\phi(x-\nu_{t})</annotation></semantics></math> in terms of <math id="A2.SS3.SSS1.p2.m3" class="ltx_Math" alttext="\phi(x)" display="inline" intent=":literal"><semantics><mrow><mi>ϕ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\phi(x)</annotation></semantics></math>:</span></p>
<table id="A2.E51" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A2.E51.m1" class="ltx_math_unparsed" alttext="\phi(x-\nu_{t})=\frac{1}{\sqrt{2\pi}}e^{-(x-\nu_{t})^{2}/2}=\frac{1}{\sqrt{2\pi}}e^{-(x^{2}-2\nu_{t}x+\nu_{t}^{2})/2}=\phi(x)e^{\nu_{t}x}e^{-\nu_{t}^{2}/2}." display="block" intent=":literal"><semantics><mrow><mi>ϕ</mi><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>−</mo><msub><mi>ν</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow><mo>=</mo><mfrac><mn>1</mn><msqrt><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>π</mi></mrow></msqrt></mfrac><msup><mi>e</mi><mrow><mo>−</mo><mo stretchy="false">(</mo><mi>x</mi><mo>−</mo><mi>ν</mi><msub><mrow></mrow><mi>t</mi></msub><mo stretchy="false">)</mo><msup><mrow></mrow><mn>2</mn></msup><mo>/</mo><mn>2</mn></mrow></msup><mo>=</mo><mfrac><mn>1</mn><msqrt><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>π</mi></mrow></msqrt></mfrac><msup><mi>e</mi><mrow><mo>−</mo><mo stretchy="false">(</mo><mi>x</mi><msup><mrow></mrow><mn>2</mn></msup><mo>−</mo><mn>2</mn><mi>ν</mi><msub><mrow></mrow><mi>t</mi></msub><mi>x</mi><mo>+</mo><mi>ν</mi><msub><mrow></mrow><mi>t</mi></msub><msup><mrow></mrow><mn>2</mn></msup><mo stretchy="false">)</mo><mo>/</mo><mn>2</mn></mrow></msup><mo>=</mo><mi>ϕ</mi><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow><msup><mi>e</mi><mrow><msub><mi>ν</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi>x</mi></mrow></msup><msup><mi>e</mi><mrow><mo>−</mo><mi>ν</mi><msub><mrow></mrow><mi>t</mi></msub><msup><mrow></mrow><mn>2</mn></msup><mo>/</mo><mn>2</mn></mrow></msup><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\phi(x-\nu_{t})=\frac{1}{\sqrt{2\pi}}e^{-(x-\nu_{t})^{2}/2}=\frac{1}{\sqrt{2\pi}}e^{-(x^{2}-2\nu_{t}x+\nu_{t}^{2})/2}=\phi(x)e^{\nu_{t}x}e^{-\nu_{t}^{2}/2}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(51)</span></td></tr></tbody>
</table>
<p id="A2.SS3.SSS1.p2.3" class="ltx_p"><span id="A2.SS3.SSS1.p2.3.1" class="ltx_text">Using the definition of the infinite series of <math id="A2.SS3.SSS1.p2.m4" class="ltx_Math" alttext="e^{x}" display="inline" intent=":literal"><semantics><msup><mi>e</mi><mi>x</mi></msup><annotation encoding="application/x-tex">e^{x}</annotation></semantics></math>, we can expand <math id="A2.SS3.SSS1.p2.m5" class="ltx_Math" alttext="e^{\nu_{t}x}" display="inline" intent=":literal"><semantics><msup><mi>e</mi><mrow><msub><mi>ν</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi>x</mi></mrow></msup><annotation encoding="application/x-tex">e^{\nu_{t}x}</annotation></semantics></math>:</span></p>
<table id="A2.E52" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A2.E52.m1" class="ltx_math_unparsed" alttext="\phi(x-\nu_{t})=\phi(x)e^{-\nu_{t}^{2}/2}\sum_{n=0}^{\infty}\frac{\nu_{t}^{n}x^{n}}{n!}." display="block" intent=":literal"><semantics><mrow><mi>ϕ</mi><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>−</mo><msub><mi>ν</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow><mo>=</mo><mi>ϕ</mi><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow><msup><mi>e</mi><mrow><mo>−</mo><mi>ν</mi><msub><mrow></mrow><mi>t</mi></msub><msup><mrow></mrow><mn>2</mn></msup><mo>/</mo><mn>2</mn></mrow></msup><munderover><mo movablelimits="false">∑</mo><mrow><mi>n</mi><mo>=</mo><mn>0</mn></mrow><mi mathvariant="normal">∞</mi></munderover><mfrac><mrow><msubsup><mi>ν</mi><mi>t</mi><mi>n</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mi>x</mi><mi>n</mi></msup></mrow><mrow><mi>n</mi><mo>!</mo></mrow></mfrac><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\phi(x-\nu_{t})=\phi(x)e^{-\nu_{t}^{2}/2}\sum_{n=0}^{\infty}\frac{\nu_{t}^{n}x^{n}}{n!}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(52)</span></td></tr></tbody>
</table>
<p id="A2.SS3.SSS1.p2.4" class="ltx_p"><span id="A2.SS3.SSS1.p2.4.1" class="ltx_text">Substituting this into our original integral:</span></p>
<table id="A2.E53" class="ltx_equationgroup ltx_eqn_table">
<tbody>
<tr id="A2.E53X" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A2.E53X.m2" class="ltx_Math" alttext="\displaystyle\int_{-\infty}^{\infty}\phi\left(z-\nu_{t}\right)\Phi^{K-1}(z)dz" display="inline" intent=":literal"><semantics><mrow><mstyle displaystyle="true"><msubsup><mo>∫</mo><mrow><mo>−</mo><mi mathvariant="normal">∞</mi></mrow><mi mathvariant="normal">∞</mi></msubsup></mstyle><mrow><mrow><mi>ϕ</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mi>z</mi><mo>−</mo><msub><mi>ν</mi><mi>t</mi></msub></mrow><mo>)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mi mathvariant="normal">Φ</mi><mrow><mi>K</mi><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>z</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo rspace="0em">𝑑</mo><mi>z</mi></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\int_{-\infty}^{\infty}\phi\left(z-\nu_{t}\right)\Phi^{K-1}(z)dz</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.E53X.m3" class="ltx_Math" alttext="\displaystyle=\int_{-\infty}^{\infty}\phi(z)e^{-\nu_{t}^{2}/2}\sum_{n=0}^{\infty}\frac{\nu_{t}^{n}z^{n}}{n!}\Phi^{K-1}(z)dz" display="inline" intent=":literal"><semantics><mrow><mo>=</mo><mstyle displaystyle="true"><mo>∫</mo></mstyle><msub><mrow></mrow><mrow><mo>−</mo><mi mathvariant="normal">∞</mi></mrow></msub><msup><mrow></mrow><mi mathvariant="normal">∞</mi></msup><mi>ϕ</mi><mo stretchy="false">(</mo><mi>z</mi><mo stretchy="false">)</mo><mi>e</mi><msup><mrow></mrow><mrow><mo>−</mo><mi>ν</mi><msub><mrow></mrow><mi>t</mi></msub><msup><mrow></mrow><mn>2</mn></msup><mo>/</mo><mn>2</mn></mrow></msup><mstyle displaystyle="true"><mo movablelimits="false">∑</mo></mstyle><msub><mrow></mrow><mrow><mi>n</mi><mo>=</mo><mn>0</mn></mrow></msub><msup><mrow></mrow><mi mathvariant="normal">∞</mi></msup><mstyle displaystyle="true"><mfrac><mrow><msubsup><mi>ν</mi><mi>t</mi><mi>n</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mi>z</mi><mi>n</mi></msup></mrow><mrow><mi>n</mi><mo>!</mo></mrow></mfrac></mstyle><mi mathvariant="normal">Φ</mi><msup><mrow></mrow><mrow><mi>K</mi><mo>−</mo><mn>1</mn></mrow></msup><mo stretchy="false">(</mo><mi>z</mi><mo stretchy="false">)</mo><mi>d</mi><mi>z</mi></mrow><annotation encoding="application/x-tex">\displaystyle=\int_{-\infty}^{\infty}\phi(z)e^{-\nu_{t}^{2}/2}\sum_{n=0}^{\infty}\frac{\nu_{t}^{n}z^{n}}{n!}\Phi^{K-1}(z)dz</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equationgroup ltx_align_right">(53)</span></td></tr></tbody>
</table>
<p id="A2.SS3.SSS1.p2.5" class="ltx_p"><span id="A2.SS3.SSS1.p2.5.1" class="ltx_text">Since Prop. <a href="#A2.Thmtheorem5" title="Proposition B.5 (First Corollary of the Dominated Convergence Theorem ( ( ) , Theorem 2.25)). ‣ B.3 Efficient computation of 𝒯 During Training ‣ Appendix B Fast Curriculum ‣ The Diffusion Duality, Chapter II: Ψ-Samplers and Efficient Curriculum" class="ltx_ref"><span class="ltx_text ltx_ref_tag">B.5</span></a> is satisfied, as the sum is the Taylor series of the exponential function, we can exchange the order of integration and summation. This leads to our final result:</span></p>
<table id="A2.E54" class="ltx_equationgroup ltx_eqn_table">
<tbody>
<tr id="A2.E54X" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A2.E54X.m2" class="ltx_Math" alttext="\displaystyle\int_{-\infty}^{\infty}\phi\left(z-\nu_{t}\right)\Phi^{K-1}(z)dz" display="inline" intent=":literal"><semantics><mrow><mstyle displaystyle="true"><msubsup><mo>∫</mo><mrow><mo>−</mo><mi mathvariant="normal">∞</mi></mrow><mi mathvariant="normal">∞</mi></msubsup></mstyle><mrow><mrow><mi>ϕ</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mi>z</mi><mo>−</mo><msub><mi>ν</mi><mi>t</mi></msub></mrow><mo>)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mi mathvariant="normal">Φ</mi><mrow><mi>K</mi><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>z</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo rspace="0em">𝑑</mo><mi>z</mi></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\int_{-\infty}^{\infty}\phi\left(z-\nu_{t}\right)\Phi^{K-1}(z)dz</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.E54X.m3" class="ltx_Math" alttext="\displaystyle=e^{-\nu_{t}^{2}/2}\sum_{n=0}^{\infty}\frac{\nu_{t}^{n}}{n!}\int_{-\infty}^{\infty}z^{n}\phi(z)\Phi^{K-1}(z)dz" display="inline" intent=":literal"><semantics><mrow><mo>=</mo><mi>e</mi><msup><mrow></mrow><mrow><mo>−</mo><mi>ν</mi><msub><mrow></mrow><mi>t</mi></msub><msup><mrow></mrow><mn>2</mn></msup><mo>/</mo><mn>2</mn></mrow></msup><mstyle displaystyle="true"><mo movablelimits="false">∑</mo></mstyle><msub><mrow></mrow><mrow><mi>n</mi><mo>=</mo><mn>0</mn></mrow></msub><msup><mrow></mrow><mi mathvariant="normal">∞</mi></msup><mstyle displaystyle="true"><mfrac><msubsup><mi>ν</mi><mi>t</mi><mi>n</mi></msubsup><mrow><mi>n</mi><mo>!</mo></mrow></mfrac></mstyle><mstyle displaystyle="true"><mo>∫</mo></mstyle><msub><mrow></mrow><mrow><mo>−</mo><mi mathvariant="normal">∞</mi></mrow></msub><msup><mrow></mrow><mi mathvariant="normal">∞</mi></msup><mi>z</mi><msup><mrow></mrow><mi>n</mi></msup><mi>ϕ</mi><mo stretchy="false">(</mo><mi>z</mi><mo stretchy="false">)</mo><mi mathvariant="normal">Φ</mi><msup><mrow></mrow><mrow><mi>K</mi><mo>−</mo><mn>1</mn></mrow></msup><mo stretchy="false">(</mo><mi>z</mi><mo stretchy="false">)</mo><mi>d</mi><mi>z</mi></mrow><annotation encoding="application/x-tex">\displaystyle=e^{-\nu_{t}^{2}/2}\sum_{n=0}^{\infty}\frac{\nu_{t}^{n}}{n!}\int_{-\infty}^{\infty}z^{n}\phi(z)\Phi^{K-1}(z)dz</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="2" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equationgroup ltx_align_right">(54)</span></td></tr>
<tr id="A2.E54Xa" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.E54Xa.m2" class="ltx_Math" alttext="\displaystyle=e^{-\nu_{t}^{2}/2}\sum_{n=0}^{\infty}\frac{\nu_{t}^{n}}{n!}M_{n}." display="inline" intent=":literal"><semantics><mrow><mo>=</mo><mi>e</mi><msup><mrow></mrow><mrow><mo>−</mo><mi>ν</mi><msub><mrow></mrow><mi>t</mi></msub><msup><mrow></mrow><mn>2</mn></msup><mo>/</mo><mn>2</mn></mrow></msup><mstyle displaystyle="true"><mo movablelimits="false">∑</mo></mstyle><msub><mrow></mrow><mrow><mi>n</mi><mo>=</mo><mn>0</mn></mrow></msub><msup><mrow></mrow><mi mathvariant="normal">∞</mi></msup><mstyle displaystyle="true"><mfrac><msubsup><mi>ν</mi><mi>t</mi><mi>n</mi></msubsup><mrow><mi>n</mi><mo>!</mo></mrow></mfrac></mstyle><mi>M</mi><msub><mrow></mrow><mi>n</mi></msub><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle=e^{-\nu_{t}^{2}/2}\sum_{n=0}^{\infty}\frac{\nu_{t}^{n}}{n!}M_{n}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A2.SS3.SSS1.p2.6" class="ltx_p"><span id="A2.SS3.SSS1.p2.6.1" class="ltx_text">∎</span></p>
</div>
</div>
<section id="A2.SS3.SSS1.Px1" class="ltx_paragraph">
<h5 class="ltx_title ltx_title_paragraph">Advantages</h5>

<div id="A2.SS3.SSS1.Px1.p1" class="ltx_para ltx_noindent">
<p id="A2.SS3.SSS1.Px1.p1.1" class="ltx_p">At this point, one might ask what is gained by expressing <math id="A2.SS3.SSS1.Px1.p1.m1" class="ltx_Math" alttext="{\color[rgb]{0.6055,0,0}\mathcal{T}}" display="inline" intent=":literal"><semantics><mi style="--ltx-fg-color:#9A0000;" class="ltx_font_mathcaligraphic" mathcolor="#9A0000">𝒯</mi><annotation encoding="application/x-tex">{\color[rgb]{0.6055,0,0}\mathcal{T}}</annotation></semantics></math> as a series expansion. There are two key advantages. First, since <math id="A2.SS3.SSS1.Px1.p1.m2" class="ltx_Math" alttext="{\color[rgb]{0.6055,0,0}\mathcal{T}}" display="inline" intent=":literal"><semantics><mi style="--ltx-fg-color:#9A0000;" class="ltx_font_mathcaligraphic" mathcolor="#9A0000">𝒯</mi><annotation encoding="application/x-tex">{\color[rgb]{0.6055,0,0}\mathcal{T}}</annotation></semantics></math> is intractable, <cite class="ltx_cite ltx_citemacro_citet"><a href="#bib.bib27" title="" class="ltx_ref">Sahoo et al. (2024)</a></cite> resort to precomputing 100k evaluations, which can take up to two hours with the GPT-2 tokenizer. Second, they approximate the time derivative using finite differences. Crucially, observe that <math id="A2.SS3.SSS1.Px1.p1.m3" class="ltx_Math" alttext="M_{n}" display="inline" intent=":literal"><semantics><msub><mi>M</mi><mi>n</mi></msub><annotation encoding="application/x-tex">M_{n}</annotation></semantics></math> and <math id="A2.SS3.SSS1.Px1.p1.m4" class="ltx_Math" alttext="I_{n}" display="inline" intent=":literal"><semantics><msub><mi>I</mi><mi>n</mi></msub><annotation encoding="application/x-tex">I_{n}</annotation></semantics></math> in Prop. <a href="#A2.Thmtheorem7" title="Proposition B.7 (Series Expansion of the Diffusion Transformation Operator). ‣ B.3.1 Series Representation of 𝒯 and ∂_𝑡𝒯 ‣ B.3 Efficient computation of 𝒯 During Training ‣ Appendix B Fast Curriculum ‣ The Diffusion Duality, Chapter II: Ψ-Samplers and Efficient Curriculum" class="ltx_ref"><span class="ltx_text ltx_ref_tag">B.7</span></a> and <a href="#A2.Thmtheorem8" title="Proposition B.8 (Time-Derivative of the Diffusion Transformation Operator). ‣ Advantages ‣ B.3.1 Series Representation of 𝒯 and ∂_𝑡𝒯 ‣ B.3 Efficient computation of 𝒯 During Training ‣ Appendix B Fast Curriculum ‣ The Diffusion Duality, Chapter II: Ψ-Samplers and Efficient Curriculum" class="ltx_ref"><span class="ltx_text ltx_ref_tag">B.8</span></a> are the only intractable components of the series expansion, and they are independent of the input <math id="A2.SS3.SSS1.Px1.p1.m5" class="ltx_Math" alttext="\tilde{\alpha}_{t}" display="inline" intent=":literal"><semantics><msub><mover accent="true"><mi>α</mi><mo>~</mo></mover><mi>t</mi></msub><annotation encoding="application/x-tex">\tilde{\alpha}_{t}</annotation></semantics></math>. We find that the terms of the series decay to zero after roughly 150 terms (with slower decay as <math id="A2.SS3.SSS1.Px1.p1.m6" class="ltx_Math" alttext="t\to 1" display="inline" intent=":literal"><semantics><mrow><mi>t</mi><mo stretchy="false">→</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">t\to 1</annotation></semantics></math>). Thus, instead of pre-computing 100k evaluations of <math id="A2.SS3.SSS1.Px1.p1.m7" class="ltx_Math" alttext="{\color[rgb]{0.6055,0,0}\mathcal{T}}" display="inline" intent=":literal"><semantics><mi style="--ltx-fg-color:#9A0000;" class="ltx_font_mathcaligraphic" mathcolor="#9A0000">𝒯</mi><annotation encoding="application/x-tex">{\color[rgb]{0.6055,0,0}\mathcal{T}}</annotation></semantics></math>, it suffices to cache <math id="A2.SS3.SSS1.Px1.p1.m8" class="ltx_Math" alttext="M_{n}" display="inline" intent=":literal"><semantics><msub><mi>M</mi><mi>n</mi></msub><annotation encoding="application/x-tex">M_{n}</annotation></semantics></math> and <math id="A2.SS3.SSS1.Px1.p1.m9" class="ltx_Math" alttext="I_{n}" display="inline" intent=":literal"><semantics><msub><mi>I</mi><mi>n</mi></msub><annotation encoding="application/x-tex">I_{n}</annotation></semantics></math> for <math id="A2.SS3.SSS1.Px1.p1.m10" class="ltx_Math" alttext="n&lt;150" display="inline" intent=":literal"><semantics><mrow><mi>n</mi><mo>&lt;</mo><mn>150</mn></mrow><annotation encoding="application/x-tex">n&lt;150</annotation></semantics></math>. In practice, this takes only a few seconds and can be performed at the start of training.</p>
</div>
<div id="A2.Thmtheorem8" class="ltx_theorem ltx_theorem_proposition">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="A2.Thmtheorem8.2" class="ltx_text ltx_font_bold">Proposition B.8</span></span><span id="A2.Thmtheorem8.3" class="ltx_text ltx_font_bold"> </span>(Time-Derivative of the Diffusion Transformation Operator)<span id="A2.Thmtheorem8.4" class="ltx_text ltx_font_bold">.</span></h6>
<div id="A2.Thmtheorem8.p1" class="ltx_para ltx_noindent">
<p id="A2.Thmtheorem8.p1.1" class="ltx_p"><span id="A2.Thmtheorem8.p1.1.1" class="ltx_text ltx_font_italic">The time-derivative of the diffusion transformation operator <math id="A2.Thmtheorem8.p1.m1" class="ltx_Math" alttext="{\color[rgb]{0.6055,0,0}\mathcal{T}}" display="inline" intent=":literal"><semantics><mi style="--ltx-fg-color:#9A0000;" class="ltx_font_mathcaligraphic" mathcolor="#9A0000">𝒯</mi><annotation encoding="application/x-tex">{\color[rgb]{0.6055,0,0}\mathcal{T}}</annotation></semantics></math> can be expressed as:</span></p>
<table id="A2.E55" class="ltx_equationgroup ltx_eqn_table">
<tbody>
<tr id="A2.E55X" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A2.E55X.m2" class="ltx_Math" alttext="\displaystyle\frac{d}{dt}{\color[rgb]{0.6055,0,0}\mathcal{T}}(\tilde{\alpha}_{t})" display="inline" intent=":literal"><semantics><mrow><mstyle displaystyle="true"><mfrac><mi>d</mi><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mi style="--ltx-fg-color:#9A0000;" class="ltx_font_mathcaligraphic" mathcolor="#9A0000">𝒯</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi>α</mi><mo>~</mo></mover><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\frac{d}{dt}{\color[rgb]{0.6055,0,0}\mathcal{T}}(\tilde{\alpha}_{t})</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.E55X.m3" class="ltx_Math" alttext="\displaystyle=\frac{K\cdot e^{-\nu_{t}^{2}/2}}{K-1}\frac{\tilde{\alpha}_{t}^{\prime}}{(1-\tilde{\alpha}_{t}^{2})^{3/2}}\sum_{n=0}^{\infty}\frac{\nu_{t}^{n}}{n!}\left[I_{n}-\nu_{t}M_{n}\right]" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mi>K</mi><mo lspace="0.222em" rspace="0.222em">⋅</mo><mi>e</mi><msup><mrow></mrow><mrow><mo>−</mo><mi>ν</mi><msub><mrow></mrow><mi>t</mi></msub><msup><mrow></mrow><mn>2</mn></msup><mo>/</mo><mn>2</mn></mrow></msup></mrow><mrow><mi>K</mi><mo>−</mo><mn>1</mn></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><msubsup><mover accent="true"><mi>α</mi><mo>~</mo></mover><mi>t</mi><mo>′</mo></msubsup><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msubsup><mover accent="true"><mi>α</mi><mo>~</mo></mover><mi>t</mi><mn>2</mn></msubsup></mrow><mo stretchy="false">)</mo></mrow><mrow><mn>3</mn><mo>/</mo><mn>2</mn></mrow></msup></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>n</mi><mo>=</mo><mn>0</mn></mrow><mi mathvariant="normal">∞</mi></munderover></mstyle><mrow><mstyle displaystyle="true"><mfrac><msubsup><mi>ν</mi><mi>t</mi><mi>n</mi></msubsup><mrow><mi>n</mi><mo>!</mo></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><mrow><msub><mi>I</mi><mi>n</mi></msub><mo>−</mo><mrow><msub><mi>ν</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>M</mi><mi>n</mi></msub></mrow></mrow><mo>]</mo></mrow></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\frac{K\cdot e^{-\nu_{t}^{2}/2}}{K-1}\frac{\tilde{\alpha}_{t}^{\prime}}{(1-\tilde{\alpha}_{t}^{2})^{3/2}}\sum_{n=0}^{\infty}\frac{\nu_{t}^{n}}{n!}\left[I_{n}-\nu_{t}M_{n}\right]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equationgroup ltx_align_right">(55)</span></td></tr></tbody>
</table>
<p id="A2.Thmtheorem8.p1.2" class="ltx_p"><span id="A2.Thmtheorem8.p1.2.1" class="ltx_text ltx_font_italic">where <math id="A2.Thmtheorem8.p1.m2" class="ltx_Math" alttext="\nu_{t}" display="inline" intent=":literal"><semantics><msub><mi>ν</mi><mi>t</mi></msub><annotation encoding="application/x-tex">\nu_{t}</annotation></semantics></math> and <math id="A2.Thmtheorem8.p1.m3" class="ltx_Math" alttext="M_{n}" display="inline" intent=":literal"><semantics><msub><mi>M</mi><mi>n</mi></msub><annotation encoding="application/x-tex">M_{n}</annotation></semantics></math> are defined as in Prop. <a href="#A2.Thmtheorem7" title="Proposition B.7 (Series Expansion of the Diffusion Transformation Operator). ‣ B.3.1 Series Representation of 𝒯 and ∂_𝑡𝒯 ‣ B.3 Efficient computation of 𝒯 During Training ‣ Appendix B Fast Curriculum ‣ The Diffusion Duality, Chapter II: Ψ-Samplers and Efficient Curriculum" class="ltx_ref"><span class="ltx_text ltx_ref_tag">B.7</span></a>. Finally, <math id="A2.Thmtheorem8.p1.m4" class="ltx_Math" alttext="I_{n}=\int_{-\infty}^{\infty}z^{n+1}\phi(z)\Phi^{K-1}(z)dz" display="inline" intent=":literal"><semantics><mrow><msub><mi>I</mi><mi>n</mi></msub><mo rspace="0.111em">=</mo><mrow><msubsup><mo>∫</mo><mrow><mo>−</mo><mi mathvariant="normal">∞</mi></mrow><mi mathvariant="normal">∞</mi></msubsup><mrow><msup><mi>z</mi><mrow><mi>n</mi><mo>+</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mi>ϕ</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>z</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mi mathvariant="normal">Φ</mi><mrow><mi>K</mi><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>z</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo rspace="0em">𝑑</mo><mi>z</mi></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">I_{n}=\int_{-\infty}^{\infty}z^{n+1}\phi(z)\Phi^{K-1}(z)dz</annotation></semantics></math>, and <math id="A2.Thmtheorem8.p1.m5" class="ltx_Math" alttext="\tilde{\alpha}_{t}^{\prime}" display="inline" intent=":literal"><semantics><msubsup><mover accent="true"><mi>α</mi><mo>~</mo></mover><mi>t</mi><mo>′</mo></msubsup><annotation encoding="application/x-tex">\tilde{\alpha}_{t}^{\prime}</annotation></semantics></math> denotes the time-derivative of the Gaussian noise schedule <math id="A2.Thmtheorem8.p1.m6" class="ltx_Math" alttext="\tilde{\alpha}_{t}" display="inline" intent=":literal"><semantics><msub><mover accent="true"><mi>α</mi><mo>~</mo></mover><mi>t</mi></msub><annotation encoding="application/x-tex">\tilde{\alpha}_{t}</annotation></semantics></math>.</span></p>
</div>
</div>
<div id="A2.SS3.SSS1.Px1.1" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="A2.SS3.SSS1.Px1.p2" class="ltx_para ltx_noindent">
<p id="A2.SS3.SSS1.Px1.p2.1" class="ltx_p"><span id="A2.SS3.SSS1.Px1.p2.1.1" class="ltx_text">We want to compute</span></p>
<table id="A2.E56" class="ltx_equationgroup ltx_eqn_table">
<tbody>
<tr id="A2.E56X" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A2.E56X.m2" class="ltx_Math" alttext="\displaystyle\frac{d}{d\nu_{t}}{\color[rgb]{0.6055,0,0}\mathcal{T}}(\tilde{\alpha}_{t})=\frac{K}{K-1}\frac{d}{d\nu_{t}}\int\phi(z-\nu_{t})\Phi^{K-1}(z)dz." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mstyle displaystyle="true"><mfrac><mi>d</mi><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>ν</mi><mi>t</mi></msub></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mi style="--ltx-fg-color:#9A0000;" class="ltx_font_mathcaligraphic" mathcolor="#9A0000">𝒯</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi>α</mi><mo>~</mo></mover><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mstyle displaystyle="true"><mfrac><mi>K</mi><mrow><mi>K</mi><mo>−</mo><mn>1</mn></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><mi>d</mi><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>ν</mi><mi>t</mi></msub></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mrow><mo>∫</mo><mrow><mrow><mi>ϕ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>z</mi><mo>−</mo><msub><mi>ν</mi><mi>t</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mi mathvariant="normal">Φ</mi><mrow><mi>K</mi><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>z</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo rspace="0em">d</mo><mi>z</mi></mrow></mrow></mrow></mstyle></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\frac{d}{d\nu_{t}}{\color[rgb]{0.6055,0,0}\mathcal{T}}(\tilde{\alpha}_{t})=\frac{K}{K-1}\frac{d}{d\nu_{t}}\int\phi(z-\nu_{t})\Phi^{K-1}(z)dz.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equationgroup ltx_align_right">(56)</span></td></tr></tbody>
</table>
<p id="A2.SS3.SSS1.Px1.p2.2" class="ltx_p"><span id="A2.SS3.SSS1.Px1.p2.2.1" class="ltx_text">To justify passing the derivative under the integral, we verify the conditions of Prop. <a href="#A2.Thmtheorem6" title="Proposition B.6 (Second Corollary of the Dominated Convergence Theorem ( ( ) , Theorem 2.27)). ‣ B.3 Efficient computation of 𝒯 During Training ‣ Appendix B Fast Curriculum ‣ The Diffusion Duality, Chapter II: Ψ-Samplers and Efficient Curriculum" class="ltx_ref"><span class="ltx_text ltx_ref_tag">B.6</span></a>. Define</span></p>
<table id="A2.E57" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A2.E57.m1" class="ltx_Math" alttext="f(z,t)=\phi\left(z-\frac{\tilde{\alpha}_{t}}{\sqrt{1-\tilde{\alpha}_{t}^{2}}}\right)\Phi^{K-1}(z)=\phi\left(z-\nu_{t}\right)\Phi^{K-1}(z)," display="block" intent=":literal"><semantics><mrow><mrow><mrow><mi>f</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>z</mi><mo>,</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mrow><mi>ϕ</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mi>z</mi><mo>−</mo><mfrac><msub><mover accent="true"><mi>α</mi><mo>~</mo></mover><mi>t</mi></msub><msqrt><mrow><mn>1</mn><mo>−</mo><msubsup><mover accent="true"><mi>α</mi><mo>~</mo></mover><mi>t</mi><mn>2</mn></msubsup></mrow></msqrt></mfrac></mrow><mo>)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mi mathvariant="normal">Φ</mi><mrow><mi>K</mi><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>z</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mrow><mi>ϕ</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mi>z</mi><mo>−</mo><msub><mi>ν</mi><mi>t</mi></msub></mrow><mo>)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mi mathvariant="normal">Φ</mi><mrow><mi>K</mi><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>z</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">f(z,t)=\phi\left(z-\frac{\tilde{\alpha}_{t}}{\sqrt{1-\tilde{\alpha}_{t}^{2}}}\right)\Phi^{K-1}(z)=\phi\left(z-\nu_{t}\right)\Phi^{K-1}(z),</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(57)</span></td></tr></tbody>
</table>
<p id="A2.SS3.SSS1.Px1.p2.3" class="ltx_p"><span id="A2.SS3.SSS1.Px1.p2.3.1" class="ltx_text">which has time derivative</span></p>
<table id="A2.E58" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A2.E58.m1" class="ltx_Math" alttext="\frac{\partial f(z,t)}{\partial t}=\frac{(z-\nu_{t})\phi(z-\nu_{t})}{(1-\tilde{\alpha}_{t}^{2})^{3/2}}\Phi^{K-1}(z)." display="block" intent=":literal"><semantics><mrow><mrow><mfrac><mrow><mo>∂</mo><mrow><mi>f</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>z</mi><mo>,</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mrow><mo>∂</mo><mi>t</mi></mrow></mfrac><mo>=</mo><mrow><mfrac><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>z</mi><mo>−</mo><msub><mi>ν</mi><mi>t</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>ϕ</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>z</mi><mo>−</mo><msub><mi>ν</mi><mi>t</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msubsup><mover accent="true"><mi>α</mi><mo>~</mo></mover><mi>t</mi><mn>2</mn></msubsup></mrow><mo stretchy="false">)</mo></mrow><mrow><mn>3</mn><mo>/</mo><mn>2</mn></mrow></msup></mfrac><mo lspace="0em" rspace="0em">​</mo><msup><mi mathvariant="normal">Φ</mi><mrow><mi>K</mi><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>z</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\frac{\partial f(z,t)}{\partial t}=\frac{(z-\nu_{t})\phi(z-\nu_{t})}{(1-\tilde{\alpha}_{t}^{2})^{3/2}}\Phi^{K-1}(z).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(58)</span></td></tr></tbody>
</table>
<p id="A2.SS3.SSS1.Px1.p2.4" class="ltx_p"><span id="A2.SS3.SSS1.Px1.p2.4.1" class="ltx_text">We need to find a suitable dominating function <math id="A2.SS3.SSS1.Px1.p2.m1" class="ltx_Math" alttext="g" display="inline" intent=":literal"><semantics><mi>g</mi><annotation encoding="application/x-tex">g</annotation></semantics></math>. Let <math id="A2.SS3.SSS1.Px1.p2.m2" class="ltx_Math" alttext="1&gt;\delta_{0}&gt;0" display="inline" intent=":literal"><semantics><mrow><mn>1</mn><mo>&gt;</mo><msub><mi>δ</mi><mn>0</mn></msub><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">1&gt;\delta_{0}&gt;0</annotation></semantics></math> and choose <math id="A2.SS3.SSS1.Px1.p2.m3" class="ltx_Math" alttext="t_{0}=\frac{1-\delta_{0}}{2}" display="inline" intent=":literal"><semantics><mrow><msub><mi>t</mi><mn>0</mn></msub><mo>=</mo><mfrac><mrow><mn>1</mn><mo>−</mo><msub><mi>δ</mi><mn>0</mn></msub></mrow><mn>2</mn></mfrac></mrow><annotation encoding="application/x-tex">t_{0}=\frac{1-\delta_{0}}{2}</annotation></semantics></math>. When <math id="A2.SS3.SSS1.Px1.p2.m4" class="ltx_Math" alttext="|t-t_{0}|\leq\delta_{0}" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">|</mo><mrow><mi>t</mi><mo>−</mo><msub><mi>t</mi><mn>0</mn></msub></mrow><mo stretchy="false">|</mo></mrow><mo>≤</mo><msub><mi>δ</mi><mn>0</mn></msub></mrow><annotation encoding="application/x-tex">|t-t_{0}|\leq\delta_{0}</annotation></semantics></math>, we have <math id="A2.SS3.SSS1.Px1.p2.m5" class="ltx_Math" alttext="t\in[t_{0}-\delta_{0},t_{0}+\delta_{0}]" display="inline" intent=":literal"><semantics><mrow><mi>t</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mrow><mrow><msub><mi>t</mi><mn>0</mn></msub><mo>−</mo><msub><mi>δ</mi><mn>0</mn></msub></mrow><mo>,</mo><mrow><msub><mi>t</mi><mn>0</mn></msub><mo>+</mo><msub><mi>δ</mi><mn>0</mn></msub></mrow></mrow><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">t\in[t_{0}-\delta_{0},t_{0}+\delta_{0}]</annotation></semantics></math>. Since <math id="A2.SS3.SSS1.Px1.p2.m6" class="ltx_Math" alttext="t_{0}-\delta_{0}&lt;t_{0}&lt;1" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>t</mi><mn>0</mn></msub><mo>−</mo><msub><mi>δ</mi><mn>0</mn></msub></mrow><mo>&lt;</mo><msub><mi>t</mi><mn>0</mn></msub><mo>&lt;</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">t_{0}-\delta_{0}&lt;t_{0}&lt;1</annotation></semantics></math> and <math id="A2.SS3.SSS1.Px1.p2.m7" class="ltx_Math" alttext="t_{0}+\delta_{0}=\frac{1-\delta_{0}}{2}+\delta_{0}&lt;1" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>t</mi><mn>0</mn></msub><mo>+</mo><msub><mi>δ</mi><mn>0</mn></msub></mrow><mo>=</mo><mrow><mfrac><mrow><mn>1</mn><mo>−</mo><msub><mi>δ</mi><mn>0</mn></msub></mrow><mn>2</mn></mfrac><mo>+</mo><msub><mi>δ</mi><mn>0</mn></msub></mrow><mo>&lt;</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">t_{0}+\delta_{0}=\frac{1-\delta_{0}}{2}+\delta_{0}&lt;1</annotation></semantics></math>, we are guaranteed that <math id="A2.SS3.SSS1.Px1.p2.m8" class="ltx_Math" alttext="t&lt;1" display="inline" intent=":literal"><semantics><mrow><mi>t</mi><mo>&lt;</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">t&lt;1</annotation></semantics></math>. This ensures that <math id="A2.SS3.SSS1.Px1.p2.m9" class="ltx_Math" alttext="\nu_{t}" display="inline" intent=":literal"><semantics><msub><mi>ν</mi><mi>t</mi></msub><annotation encoding="application/x-tex">\nu_{t}</annotation></semantics></math> is finite.
Because <math id="A2.SS3.SSS1.Px1.p2.m10" class="ltx_Math" alttext="\tilde{\alpha}_{t}\in[0,1)" display="inline" intent=":literal"><semantics><mrow><msub><mover accent="true"><mi>α</mi><mo>~</mo></mover><mi>t</mi></msub><mo>∈</mo><mrow><mo stretchy="false">[</mo><mn>0</mn><mo>,</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\tilde{\alpha}_{t}\in[0,1)</annotation></semantics></math> when <math id="A2.SS3.SSS1.Px1.p2.m11" class="ltx_Math" alttext="t&lt;1" display="inline" intent=":literal"><semantics><mrow><mi>t</mi><mo>&lt;</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">t&lt;1</annotation></semantics></math>, there exists a constant <math id="A2.SS3.SSS1.Px1.p2.m12" class="ltx_Math" alttext="C" display="inline" intent=":literal"><semantics><mi>C</mi><annotation encoding="application/x-tex">C</annotation></semantics></math>, such that</span></p>
<table id="A2.E59" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A2.E59.m1" class="ltx_Math" alttext="C:=\max_{|t-t_{0}|\leq\delta_{0}}\frac{1}{(1-\tilde{\alpha}_{t}^{2})^{3/2}}&lt;\infty." display="block" intent=":literal"><semantics><mrow><mrow><mi>C</mi><mo>:=</mo><mrow><munder><mi>max</mi><mrow><mrow><mo stretchy="false">|</mo><mrow><mi>t</mi><mo>−</mo><msub><mi>t</mi><mn>0</mn></msub></mrow><mo stretchy="false">|</mo></mrow><mo>≤</mo><msub><mi>δ</mi><mn>0</mn></msub></mrow></munder><mo lspace="0.167em">⁡</mo><mfrac><mn>1</mn><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msubsup><mover accent="true"><mi>α</mi><mo>~</mo></mover><mi>t</mi><mn>2</mn></msubsup></mrow><mo stretchy="false">)</mo></mrow><mrow><mn>3</mn><mo>/</mo><mn>2</mn></mrow></msup></mfrac></mrow><mo>&lt;</mo><mi mathvariant="normal">∞</mi></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">C:=\max_{|t-t_{0}|\leq\delta_{0}}\frac{1}{(1-\tilde{\alpha}_{t}^{2})^{3/2}}&lt;\infty.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(59)</span></td></tr></tbody>
</table>
<p id="A2.SS3.SSS1.Px1.p2.5" class="ltx_p"><span id="A2.SS3.SSS1.Px1.p2.5.1" class="ltx_text">For <math id="A2.SS3.SSS1.Px1.p2.m13" class="ltx_Math" alttext="z\in\mathbb{R}" display="inline" intent=":literal"><semantics><mrow><mi>z</mi><mo>∈</mo><mi>ℝ</mi></mrow><annotation encoding="application/x-tex">z\in\mathbb{R}</annotation></semantics></math> and <math id="A2.SS3.SSS1.Px1.p2.m14" class="ltx_Math" alttext="|t-t_{0}|\leq\delta_{0}" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">|</mo><mrow><mi>t</mi><mo>−</mo><msub><mi>t</mi><mn>0</mn></msub></mrow><mo stretchy="false">|</mo></mrow><mo>≤</mo><msub><mi>δ</mi><mn>0</mn></msub></mrow><annotation encoding="application/x-tex">|t-t_{0}|\leq\delta_{0}</annotation></semantics></math>, we can bound the absolute value of the time derivative of <math id="A2.SS3.SSS1.Px1.p2.m15" class="ltx_Math" alttext="f" display="inline" intent=":literal"><semantics><mi>f</mi><annotation encoding="application/x-tex">f</annotation></semantics></math> as follows:</span></p>
<table id="A2.EGx21" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A2.Ex18"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A2.Ex18.m1" class="ltx_Math" alttext="\displaystyle\left|\frac{\partial f(z,t)}{\partial t}\right|" display="inline" intent=":literal"><semantics><mrow><mo>|</mo><mstyle displaystyle="true"><mfrac><mrow><mo>∂</mo><mrow><mi>f</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>z</mi><mo>,</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mrow><mo>∂</mo><mi>t</mi></mrow></mfrac></mstyle><mo>|</mo></mrow><annotation encoding="application/x-tex">\displaystyle\left|\frac{\partial f(z,t)}{\partial t}\right|</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex18.m2" class="ltx_Math" alttext="\displaystyle=\frac{|z-\nu_{t}|}{(1-\tilde{\alpha}_{t}^{2})^{3/2}}\,\phi(z-\nu_{t})\,\Phi^{K-1}(z)" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mo stretchy="false">|</mo><mrow><mi>z</mi><mo>−</mo><msub><mi>ν</mi><mi>t</mi></msub></mrow><mo stretchy="false">|</mo></mrow><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msubsup><mover accent="true"><mi>α</mi><mo>~</mo></mover><mi>t</mi><mn>2</mn></msubsup></mrow><mo stretchy="false">)</mo></mrow><mrow><mn>3</mn><mo>/</mo><mn>2</mn></mrow></msup></mfrac></mstyle><mo lspace="0.170em" rspace="0em">​</mo><mi>ϕ</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>z</mi><mo>−</mo><msub><mi>ν</mi><mi>t</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0.170em" rspace="0em">​</mo><msup><mi mathvariant="normal">Φ</mi><mrow><mi>K</mi><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>z</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\frac{|z-\nu_{t}|}{(1-\tilde{\alpha}_{t}^{2})^{3/2}}\,\phi(z-\nu_{t})\,\Phi^{K-1}(z)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A2.Ex19"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex19.m1" class="ltx_Math" alttext="\displaystyle\leq C|z-\nu_{t}|\phi(z-\nu_{t})=g(z,t)." display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>≤</mo><mrow><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">|</mo><mrow><mi>z</mi><mo>−</mo><msub><mi>ν</mi><mi>t</mi></msub></mrow><mo stretchy="false">|</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>ϕ</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>z</mi><mo>−</mo><msub><mi>ν</mi><mi>t</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mi>g</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>z</mi><mo>,</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\leq C|z-\nu_{t}|\phi(z-\nu_{t})=g(z,t).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A2.SS3.SSS1.Px1.p2.6" class="ltx_p"><span id="A2.SS3.SSS1.Px1.p2.6.1" class="ltx_text">Finally, for all <math id="A2.SS3.SSS1.Px1.p2.m16" class="ltx_Math" alttext="t\in[0,1)" display="inline" intent=":literal"><semantics><mrow><mi>t</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mn>0</mn><mo>,</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">t\in[0,1)</annotation></semantics></math>:</span></p>
<table id="A2.E60" class="ltx_equationgroup ltx_eqn_table">
<tbody>
<tr id="A2.E60X" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A2.E60X.m2" class="ltx_Math" alttext="\displaystyle\int_{-\infty}^{\infty}g(z,t)dz" display="inline" intent=":literal"><semantics><mrow><mstyle displaystyle="true"><msubsup><mo>∫</mo><mrow><mo>−</mo><mi mathvariant="normal">∞</mi></mrow><mi mathvariant="normal">∞</mi></msubsup></mstyle><mrow><mrow><mi>g</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>z</mi><mo>,</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo rspace="0em">𝑑</mo><mi>z</mi></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\int_{-\infty}^{\infty}g(z,t)dz</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.E60X.m3" class="ltx_Math" alttext="\displaystyle=C\int_{-\infty}^{\infty}|z-\nu_{t}|\phi(z-\nu_{t})dz=C\int_{-\infty}^{\infty}|z|\phi(z)dz" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><msubsup><mo>∫</mo><mrow><mo>−</mo><mi mathvariant="normal">∞</mi></mrow><mi mathvariant="normal">∞</mi></msubsup></mstyle><mrow><mrow><mo stretchy="false">|</mo><mrow><mi>z</mi><mo>−</mo><msub><mi>ν</mi><mi>t</mi></msub></mrow><mo stretchy="false">|</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>ϕ</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>z</mi><mo>−</mo><msub><mi>ν</mi><mi>t</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo rspace="0em">𝑑</mo><mi>z</mi></mrow></mrow></mrow></mrow><mo>=</mo><mrow><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><msubsup><mo>∫</mo><mrow><mo>−</mo><mi mathvariant="normal">∞</mi></mrow><mi mathvariant="normal">∞</mi></msubsup></mstyle><mrow><mrow><mo stretchy="false">|</mo><mi>z</mi><mo stretchy="false">|</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>ϕ</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>z</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo rspace="0em">𝑑</mo><mi>z</mi></mrow></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=C\int_{-\infty}^{\infty}|z-\nu_{t}|\phi(z-\nu_{t})dz=C\int_{-\infty}^{\infty}|z|\phi(z)dz</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="5" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equationgroup ltx_align_right">(60)</span></td></tr>
<tr id="A2.E60Xa" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.E60Xa.m2" class="ltx_Math" alttext="\displaystyle=C\int_{-\infty}^{\infty}|z|\phi(z)dz=2C\int_{0}^{\infty}z\phi(z)dz" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><msubsup><mo>∫</mo><mrow><mo>−</mo><mi mathvariant="normal">∞</mi></mrow><mi mathvariant="normal">∞</mi></msubsup></mstyle><mrow><mrow><mo stretchy="false">|</mo><mi>z</mi><mo stretchy="false">|</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>ϕ</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>z</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo rspace="0em">𝑑</mo><mi>z</mi></mrow></mrow></mrow></mrow><mo>=</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><msubsup><mo>∫</mo><mn>0</mn><mi mathvariant="normal">∞</mi></msubsup></mstyle><mrow><mi>z</mi><mo lspace="0em" rspace="0em">​</mo><mi>ϕ</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>z</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo rspace="0em">𝑑</mo><mi>z</mi></mrow></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=C\int_{-\infty}^{\infty}|z|\phi(z)dz=2C\int_{0}^{\infty}z\phi(z)dz</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr>
<tr id="A2.E60Xb" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.E60Xb.m2" class="ltx_Math" alttext="\displaystyle=2C\int_{0}^{\infty}z\cdot\frac{1}{\sqrt{2\pi}}e^{-z^{2}/2}dz" display="inline" intent=":literal"><semantics><mrow><mo>=</mo><mn>2</mn><mi>C</mi><mstyle displaystyle="true"><mo>∫</mo></mstyle><msub><mrow></mrow><mn>0</mn></msub><msup><mrow></mrow><mi mathvariant="normal">∞</mi></msup><mi>z</mi><mo lspace="0.222em" rspace="0.222em">⋅</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><msqrt><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>π</mi></mrow></msqrt></mfrac></mstyle><mi>e</mi><msup><mrow></mrow><mrow><mo>−</mo><mi>z</mi><msup><mrow></mrow><mn>2</mn></msup><mo>/</mo><mn>2</mn></mrow></msup><mi>d</mi><mi>z</mi></mrow><annotation encoding="application/x-tex">\displaystyle=2C\int_{0}^{\infty}z\cdot\frac{1}{\sqrt{2\pi}}e^{-z^{2}/2}dz</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr>
<tr id="A2.E60Xc" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.E60Xc.m2" class="ltx_Math" alttext="\displaystyle=\frac{2C}{\sqrt{2\pi}}\int_{0}^{\infty}ze^{-z^{2}/2}dz" display="inline" intent=":literal"><semantics><mrow><mo>=</mo><mstyle displaystyle="true"><mfrac><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>C</mi></mrow><msqrt><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>π</mi></mrow></msqrt></mfrac></mstyle><mstyle displaystyle="true"><mo>∫</mo></mstyle><msub><mrow></mrow><mn>0</mn></msub><msup><mrow></mrow><mi mathvariant="normal">∞</mi></msup><mi>z</mi><mi>e</mi><msup><mrow></mrow><mrow><mo>−</mo><mi>z</mi><msup><mrow></mrow><mn>2</mn></msup><mo>/</mo><mn>2</mn></mrow></msup><mi>d</mi><mi>z</mi></mrow><annotation encoding="application/x-tex">\displaystyle=\frac{2C}{\sqrt{2\pi}}\int_{0}^{\infty}ze^{-z^{2}/2}dz</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr>
<tr id="A2.E60Xd" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.E60Xd.m2" class="ltx_Math" alttext="\displaystyle=\frac{2C}{\sqrt{2\pi}}\cdot 1=C\sqrt{\frac{2}{\pi}}&lt;\infty," display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>=</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>C</mi></mrow><msqrt><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>π</mi></mrow></msqrt></mfrac></mstyle><mo lspace="0.222em" rspace="0.222em">⋅</mo><mn>1</mn></mrow><mo>=</mo><mrow><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><msqrt><mstyle displaystyle="true"><mfrac><mn>2</mn><mi>π</mi></mfrac></mstyle></msqrt></mrow><mo>&lt;</mo><mi mathvariant="normal">∞</mi></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle=\frac{2C}{\sqrt{2\pi}}\cdot 1=C\sqrt{\frac{2}{\pi}}&lt;\infty,</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A2.SS3.SSS1.Px1.p2.7" class="ltx_p"><span id="A2.SS3.SSS1.Px1.p2.7.1" class="ltx_text">where we used the substitution <math id="A2.SS3.SSS1.Px1.p2.m17" class="ltx_Math" alttext="u=z^{2}/2" display="inline" intent=":literal"><semantics><mrow><mi>u</mi><mo>=</mo><mrow><msup><mi>z</mi><mn>2</mn></msup><mo>/</mo><mn>2</mn></mrow></mrow><annotation encoding="application/x-tex">u=z^{2}/2</annotation></semantics></math> in the integral <math id="A2.SS3.SSS1.Px1.p2.m18" class="ltx_math_unparsed" alttext="\int_{0}^{\infty}ze^{-z^{2}/2}dz" display="inline" intent=":literal"><semantics><mrow><mo>∫</mo><msub><mrow></mrow><mn>0</mn></msub><msup><mrow></mrow><mi mathvariant="normal">∞</mi></msup><mi>z</mi><mi>e</mi><msup><mrow></mrow><mrow><mo>−</mo><mi>z</mi><msup><mrow></mrow><mn>2</mn></msup><mo>/</mo><mn>2</mn></mrow></msup><mi>d</mi><mi>z</mi></mrow><annotation encoding="application/x-tex">\int_{0}^{\infty}ze^{-z^{2}/2}dz</annotation></semantics></math> to obtain <math id="A2.SS3.SSS1.Px1.p2.m19" class="ltx_Math" alttext="\int_{0}^{\infty}e^{-u}du=1" display="inline" intent=":literal"><semantics><mrow><mrow><msubsup><mo>∫</mo><mn>0</mn><mi mathvariant="normal">∞</mi></msubsup><mrow><msup><mi>e</mi><mrow><mo>−</mo><mi>u</mi></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo rspace="0em">𝑑</mo><mi>u</mi></mrow></mrow></mrow><mo>=</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">\int_{0}^{\infty}e^{-u}du=1</annotation></semantics></math>. The conditions of Prop. <a href="#A2.Thmtheorem6" title="Proposition B.6 (Second Corollary of the Dominated Convergence Theorem ( ( ) , Theorem 2.27)). ‣ B.3 Efficient computation of 𝒯 During Training ‣ Appendix B Fast Curriculum ‣ The Diffusion Duality, Chapter II: Ψ-Samplers and Efficient Curriculum" class="ltx_ref"><span class="ltx_text ltx_ref_tag">B.6</span></a> are satisfied, so we can pass the derivative under the integral.</span></p>
</div>
<div id="A2.SS3.SSS1.Px1.p3" class="ltx_para ltx_noindent">
<p id="A2.SS3.SSS1.Px1.p3.1" class="ltx_p"><span id="A2.SS3.SSS1.Px1.p3.1.1" class="ltx_text">Applying the derivative under the integral sign and using the identity <math id="A2.SS3.SSS1.Px1.p3.m1" class="ltx_math_unparsed" alttext="\phi(z-\nu_{t})=\phi(z)e^{\nu_{t}z}e^{-\nu_{t}^{2}/2}" display="inline" intent=":literal"><semantics><mrow><mi>ϕ</mi><mrow><mo stretchy="false">(</mo><mi>z</mi><mo>−</mo><msub><mi>ν</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow><mo>=</mo><mi>ϕ</mi><mrow><mo stretchy="false">(</mo><mi>z</mi><mo stretchy="false">)</mo></mrow><msup><mi>e</mi><mrow><msub><mi>ν</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi>z</mi></mrow></msup><msup><mi>e</mi><mrow><mo>−</mo><mi>ν</mi><msub><mrow></mrow><mi>t</mi></msub><msup><mrow></mrow><mn>2</mn></msup><mo>/</mo><mn>2</mn></mrow></msup></mrow><annotation encoding="application/x-tex">\phi(z-\nu_{t})=\phi(z)e^{\nu_{t}z}e^{-\nu_{t}^{2}/2}</annotation></semantics></math>, we have:</span></p>
<table id="A2.E61" class="ltx_equationgroup ltx_eqn_table">
<tbody>
<tr id="A2.E61X" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A2.E61X.m2" class="ltx_Math" alttext="\displaystyle\frac{d}{d\nu_{t}}\phi(z-\nu_{t})" display="inline" intent=":literal"><semantics><mrow><mstyle displaystyle="true"><mfrac><mi>d</mi><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>ν</mi><mi>t</mi></msub></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mi>ϕ</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>z</mi><mo>−</mo><msub><mi>ν</mi><mi>t</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\frac{d}{d\nu_{t}}\phi(z-\nu_{t})</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.E61X.m3" class="ltx_Math" alttext="\displaystyle=\phi(z)\frac{d}{d\nu_{t}}[e^{\nu_{t}z-\nu_{t}^{2}/2}]" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><mi>ϕ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>z</mi><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><mi>d</mi><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>ν</mi><mi>t</mi></msub></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><msup><mi>e</mi><mrow><mrow><msub><mi>ν</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi>z</mi></mrow><mo>−</mo><mrow><msubsup><mi>ν</mi><mi>t</mi><mn>2</mn></msubsup><mo>/</mo><mn>2</mn></mrow></mrow></msup><mo stretchy="false">]</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\phi(z)\frac{d}{d\nu_{t}}[e^{\nu_{t}z-\nu_{t}^{2}/2}]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="3" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equationgroup ltx_align_right">(61)</span></td></tr>
<tr id="A2.E61Xa" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.E61Xa.m2" class="ltx_Math" alttext="\displaystyle=\phi(z)e^{\nu_{t}z-\nu_{t}^{2}/2}(z-\nu_{t})" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><mi>ϕ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>z</mi><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mi>e</mi><mrow><mrow><msub><mi>ν</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi>z</mi></mrow><mo>−</mo><mrow><msubsup><mi>ν</mi><mi>t</mi><mn>2</mn></msubsup><mo>/</mo><mn>2</mn></mrow></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>z</mi><mo>−</mo><msub><mi>ν</mi><mi>t</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\phi(z)e^{\nu_{t}z-\nu_{t}^{2}/2}(z-\nu_{t})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr>
<tr id="A2.E61Xb" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.E61Xb.m2" class="ltx_Math" alttext="\displaystyle=(z-\nu_{t})\phi(z-\nu_{t})" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>z</mi><mo>−</mo><msub><mi>ν</mi><mi>t</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>ϕ</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>z</mi><mo>−</mo><msub><mi>ν</mi><mi>t</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=(z-\nu_{t})\phi(z-\nu_{t})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A2.SS3.SSS1.Px1.p3.2" class="ltx_p"><span id="A2.SS3.SSS1.Px1.p3.2.1" class="ltx_text">Therefore:</span></p>
<table id="A2.E62" class="ltx_equationgroup ltx_eqn_table">
<tbody>
<tr id="A2.E62X" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A2.E62X.m2" class="ltx_Math" alttext="\displaystyle\frac{d}{d\nu_{t}}{\color[rgb]{0.6055,0,0}\mathcal{T}}(\tilde{\alpha}_{t})=\frac{K}{K-1}\int_{-\infty}^{\infty}(z-\nu_{t})\phi(z-\nu_{t})\Phi^{K-1}(z)dz" display="inline" intent=":literal"><semantics><mrow><mrow><mstyle displaystyle="true"><mfrac><mi>d</mi><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>ν</mi><mi>t</mi></msub></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mi style="--ltx-fg-color:#9A0000;" class="ltx_font_mathcaligraphic" mathcolor="#9A0000">𝒯</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi>α</mi><mo>~</mo></mover><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mstyle displaystyle="true"><mfrac><mi>K</mi><mrow><mi>K</mi><mo>−</mo><mn>1</mn></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><msubsup><mo>∫</mo><mrow><mo>−</mo><mi mathvariant="normal">∞</mi></mrow><mi mathvariant="normal">∞</mi></msubsup></mstyle><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>z</mi><mo>−</mo><msub><mi>ν</mi><mi>t</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>ϕ</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>z</mi><mo>−</mo><msub><mi>ν</mi><mi>t</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mi mathvariant="normal">Φ</mi><mrow><mi>K</mi><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>z</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo rspace="0em">𝑑</mo><mi>z</mi></mrow></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\frac{d}{d\nu_{t}}{\color[rgb]{0.6055,0,0}\mathcal{T}}(\tilde{\alpha}_{t})=\frac{K}{K-1}\int_{-\infty}^{\infty}(z-\nu_{t})\phi(z-\nu_{t})\Phi^{K-1}(z)dz</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equationgroup ltx_align_right">(62)</span></td></tr></tbody>
</table>
<p id="A2.SS3.SSS1.Px1.p3.3" class="ltx_p"><span id="A2.SS3.SSS1.Px1.p3.3.1" class="ltx_text">Now using the Taylor series of <math id="A2.SS3.SSS1.Px1.p3.m2" class="ltx_Math" alttext="\phi(z-\nu_{t})" display="inline" intent=":literal"><semantics><mrow><mi>ϕ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>z</mi><mo>−</mo><msub><mi>ν</mi><mi>t</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\phi(z-\nu_{t})</annotation></semantics></math>, found earlier, and inverting the sum and integral as before, we find</span></p>
<table id="A2.E63" class="ltx_equationgroup ltx_eqn_table">
<tbody>
<tr id="A2.E63X" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A2.E63X.m2" class="ltx_Math" alttext="\displaystyle\frac{d}{d\nu_{t}}{\color[rgb]{0.6055,0,0}\mathcal{T}}(\tilde{\alpha}_{t})" display="inline" intent=":literal"><semantics><mrow><mstyle displaystyle="true"><mfrac><mi>d</mi><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>ν</mi><mi>t</mi></msub></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mi style="--ltx-fg-color:#9A0000;" class="ltx_font_mathcaligraphic" mathcolor="#9A0000">𝒯</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi>α</mi><mo>~</mo></mover><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\frac{d}{d\nu_{t}}{\color[rgb]{0.6055,0,0}\mathcal{T}}(\tilde{\alpha}_{t})</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.E63X.m3" class="ltx_Math" alttext="\displaystyle=\frac{K}{K-1}\int_{-\infty}^{\infty}(z-\nu_{t})\phi(z)e^{\nu_{t}z}e^{-\nu_{t}^{2}/2}\Phi^{K-1}(z)dz" display="inline" intent=":literal"><semantics><mrow><mo>=</mo><mstyle displaystyle="true"><mfrac><mi>K</mi><mrow><mi>K</mi><mo>−</mo><mn>1</mn></mrow></mfrac></mstyle><mstyle displaystyle="true"><mo>∫</mo></mstyle><msub><mrow></mrow><mrow><mo>−</mo><mi mathvariant="normal">∞</mi></mrow></msub><msup><mrow></mrow><mi mathvariant="normal">∞</mi></msup><mo stretchy="false">(</mo><mi>z</mi><mo>−</mo><mi>ν</mi><msub><mrow></mrow><mi>t</mi></msub><mo stretchy="false">)</mo><mi>ϕ</mi><mo stretchy="false">(</mo><mi>z</mi><mo stretchy="false">)</mo><mi>e</mi><msup><mrow></mrow><mrow><msub><mi>ν</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi>z</mi></mrow></msup><mi>e</mi><msup><mrow></mrow><mrow><mo>−</mo><mi>ν</mi><msub><mrow></mrow><mi>t</mi></msub><msup><mrow></mrow><mn>2</mn></msup><mo>/</mo><mn>2</mn></mrow></msup><mi mathvariant="normal">Φ</mi><msup><mrow></mrow><mrow><mi>K</mi><mo>−</mo><mn>1</mn></mrow></msup><mo stretchy="false">(</mo><mi>z</mi><mo stretchy="false">)</mo><mi>d</mi><mi>z</mi></mrow><annotation encoding="application/x-tex">\displaystyle=\frac{K}{K-1}\int_{-\infty}^{\infty}(z-\nu_{t})\phi(z)e^{\nu_{t}z}e^{-\nu_{t}^{2}/2}\Phi^{K-1}(z)dz</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="3" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equationgroup ltx_align_right">(63)</span></td></tr>
<tr id="A2.E63Xa" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.E63Xa.m2" class="ltx_Math" alttext="\displaystyle=\frac{K\cdot e^{-\nu_{t}^{2}/2}}{K-1}\sum_{n=0}^{\infty}\frac{\nu_{t}^{n}}{n!}\left[\int_{-\infty}^{\infty}z^{n+1}\phi(z)\Phi^{K-1}(z)dz-\nu_{t}\int_{-\infty}^{\infty}z^{n}\phi(z)\Phi^{K-1}(z)dz\right]" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mi>K</mi><mo lspace="0.222em" rspace="0.222em">⋅</mo><mi>e</mi><msup><mrow></mrow><mrow><mo>−</mo><mi>ν</mi><msub><mrow></mrow><mi>t</mi></msub><msup><mrow></mrow><mn>2</mn></msup><mo>/</mo><mn>2</mn></mrow></msup></mrow><mrow><mi>K</mi><mo>−</mo><mn>1</mn></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>n</mi><mo>=</mo><mn>0</mn></mrow><mi mathvariant="normal">∞</mi></munderover></mstyle><mrow><mstyle displaystyle="true"><mfrac><msubsup><mi>ν</mi><mi>t</mi><mi>n</mi></msubsup><mrow><mi>n</mi><mo>!</mo></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><mrow><mrow><mstyle displaystyle="true"><msubsup><mo>∫</mo><mrow><mo>−</mo><mi mathvariant="normal">∞</mi></mrow><mi mathvariant="normal">∞</mi></msubsup></mstyle><mrow><msup><mi>z</mi><mrow><mi>n</mi><mo>+</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mi>ϕ</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>z</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mi mathvariant="normal">Φ</mi><mrow><mi>K</mi><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>z</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo rspace="0em">d</mo><mi>z</mi></mrow></mrow></mrow><mo>−</mo><mrow><msub><mi>ν</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><msubsup><mo>∫</mo><mrow><mo>−</mo><mi mathvariant="normal">∞</mi></mrow><mi mathvariant="normal">∞</mi></msubsup></mstyle><mrow><msup><mi>z</mi><mi>n</mi></msup><mo lspace="0em" rspace="0em">​</mo><mi>ϕ</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>z</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mi mathvariant="normal">Φ</mi><mrow><mi>K</mi><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>z</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo rspace="0em">d</mo><mi>z</mi></mrow></mrow></mrow></mrow></mrow><mo>]</mo></mrow></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\frac{K\cdot e^{-\nu_{t}^{2}/2}}{K-1}\sum_{n=0}^{\infty}\frac{\nu_{t}^{n}}{n!}\left[\int_{-\infty}^{\infty}z^{n+1}\phi(z)\Phi^{K-1}(z)dz-\nu_{t}\int_{-\infty}^{\infty}z^{n}\phi(z)\Phi^{K-1}(z)dz\right]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr>
<tr id="A2.E63Xb" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.E63Xb.m2" class="ltx_Math" alttext="\displaystyle=\frac{K\cdot e^{-\nu_{t}^{2}/2}}{K-1}\sum_{n=0}^{\infty}\frac{\nu_{t}^{n}}{n!}\left[I_{n}-\nu_{t}M_{n}\right]." display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>=</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mi>K</mi><mo lspace="0.222em" rspace="0.222em">⋅</mo><mi>e</mi><msup><mrow></mrow><mrow><mo>−</mo><mi>ν</mi><msub><mrow></mrow><mi>t</mi></msub><msup><mrow></mrow><mn>2</mn></msup><mo>/</mo><mn>2</mn></mrow></msup></mrow><mrow><mi>K</mi><mo>−</mo><mn>1</mn></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>n</mi><mo>=</mo><mn>0</mn></mrow><mi mathvariant="normal">∞</mi></munderover></mstyle><mrow><mstyle displaystyle="true"><mfrac><msubsup><mi>ν</mi><mi>t</mi><mi>n</mi></msubsup><mrow><mi>n</mi><mo>!</mo></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><mrow><msub><mi>I</mi><mi>n</mi></msub><mo>−</mo><mrow><msub><mi>ν</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>M</mi><mi>n</mi></msub></mrow></mrow><mo>]</mo></mrow></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle=\frac{K\cdot e^{-\nu_{t}^{2}/2}}{K-1}\sum_{n=0}^{\infty}\frac{\nu_{t}^{n}}{n!}\left[I_{n}-\nu_{t}M_{n}\right].</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A2.SS3.SSS1.Px1.p3.4" class="ltx_p"><span id="A2.SS3.SSS1.Px1.p3.4.1" class="ltx_text">where <math id="A2.SS3.SSS1.Px1.p3.m3" class="ltx_Math" alttext="I_{n}=\int_{-\infty}^{\infty}z^{n+1}\phi(z)\Phi^{K-1}(z)dz" display="inline" intent=":literal"><semantics><mrow><msub><mi>I</mi><mi>n</mi></msub><mo rspace="0.111em">=</mo><mrow><msubsup><mo>∫</mo><mrow><mo>−</mo><mi mathvariant="normal">∞</mi></mrow><mi mathvariant="normal">∞</mi></msubsup><mrow><msup><mi>z</mi><mrow><mi>n</mi><mo>+</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mi>ϕ</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>z</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mi mathvariant="normal">Φ</mi><mrow><mi>K</mi><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>z</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo rspace="0em">𝑑</mo><mi>z</mi></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">I_{n}=\int_{-\infty}^{\infty}z^{n+1}\phi(z)\Phi^{K-1}(z)dz</annotation></semantics></math> and <math id="A2.SS3.SSS1.Px1.p3.m4" class="ltx_Math" alttext="M_{n}=\int_{-\infty}^{\infty}z^{n}\phi(z)\Phi^{K-1}(z)dz" display="inline" intent=":literal"><semantics><mrow><msub><mi>M</mi><mi>n</mi></msub><mo rspace="0.111em">=</mo><mrow><msubsup><mo>∫</mo><mrow><mo>−</mo><mi mathvariant="normal">∞</mi></mrow><mi mathvariant="normal">∞</mi></msubsup><mrow><msup><mi>z</mi><mi>n</mi></msup><mo lspace="0em" rspace="0em">​</mo><mi>ϕ</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>z</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mi mathvariant="normal">Φ</mi><mrow><mi>K</mi><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>z</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo rspace="0em">𝑑</mo><mi>z</mi></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">M_{n}=\int_{-\infty}^{\infty}z^{n}\phi(z)\Phi^{K-1}(z)dz</annotation></semantics></math>.
∎</span></p>
</div>
</div>
</section>
</section>
<section id="A2.SS3.SSS2" class="ltx_subsubsection">
<h4 class="ltx_title ltx_title_subsubsection"><span class="ltx_tag ltx_tag_subsubsection">B.3.2 </span>Polynomial Approximation of <math id="A2.SS3.SSS2.m1" class="ltx_Math" alttext="{\color[rgb]{0.6055,0,0}\mathcal{T}}" display="inline" intent=":literal"><semantics><mi style="--ltx-fg-color:#9A0000;" class="ltx_font_mathcaligraphic" mathcolor="#9A0000">𝒯</mi><annotation encoding="application/x-tex">{\color[rgb]{0.6055,0,0}\mathcal{T}}</annotation></semantics></math></h4>

<figure id="A2.F5" class="ltx_figure">
<div class="ltx_flex_figure">
<div class="ltx_flex_cell ltx_flex_size_3">
<figure id="A2.F5.fig1" class="ltx_figure ltx_figure_panel ltx_align_center"><object type="image/svg+xml" data="2602.21185v1/poly9.svg" id="A2.F5.g1" class="ltx_graphics ltx_centering ltx_img_landscape" style="aspect-ratio:548/412;" width="548" height="412"></object>
</figure></div><div class="ltx_flex_cell ltx_flex_size_3">
<figure id="A2.F5.fig2" class="ltx_figure ltx_figure_panel ltx_align_center"><object type="image/svg+xml" data="2602.21185v1/poly5.svg" id="A2.F5.g2" class="ltx_graphics ltx_centering ltx_img_landscape" style="aspect-ratio:548/412;" width="548" height="412"></object>
</figure></div><div class="ltx_flex_cell ltx_flex_size_3">
<figure id="A2.F5.fig3" class="ltx_figure ltx_figure_panel ltx_align_center"><object type="image/svg+xml" data="2602.21185v1/sigmoid.svg" id="A2.F5.g3" class="ltx_graphics ltx_centering ltx_img_landscape" style="aspect-ratio:548/412;" width="548" height="412"></object>
</figure></div></div>
<figcaption class="ltx_caption ltx_centering"><span class="ltx_tag ltx_tag_figure">Figure 5: </span>Polynomial approximation and approximation error, compared to the series approximation, truncated at 150 terms. The degree-<math id="A2.F5.m3" class="ltx_Math" alttext="9" display="inline" intent=":literal"><semantics><mn>9</mn><annotation encoding="application/x-tex">9</annotation></semantics></math> polynomial (left) achieves orders of magnitude lower error than the degree-<math id="A2.F5.m4" class="ltx_Math" alttext="5" display="inline" intent=":literal"><semantics><mn>5</mn><annotation encoding="application/x-tex">5</annotation></semantics></math> polynomial (center) and sigmoid (right) approximations.</figcaption>
</figure>
<div id="A2.SS3.SSS2.p1" class="ltx_para ltx_noindent">
<p id="A2.SS3.SSS2.p1.1" class="ltx_p">Because the Diffusion Transformation Operator <math id="A2.SS3.SSS2.p1.m1" class="ltx_Math" alttext="{\color[rgb]{0.6055,0,0}\mathcal{T}}" display="inline" intent=":literal"><semantics><mi style="--ltx-fg-color:#9A0000;" class="ltx_font_mathcaligraphic" mathcolor="#9A0000">𝒯</mi><annotation encoding="application/x-tex">{\color[rgb]{0.6055,0,0}\mathcal{T}}</annotation></semantics></math> has a sigmoid-like shape, we approximate it with S-shaped functions that require only a handful of coefficients. This allows us to store fewer parameters during training, instead of the 100k values required by the original curriculum or the 300 coefficients from the series approximation. Concretely, we test several functional forms with fewer than 10 parameters and fit them using non-linear least squares, via <span id="A2.SS3.SSS2.p1.1.1" class="ltx_text ltx_font_typewriter">scipy.optimize.curve_fit</span>.</p>
</div>
<div id="A2.SS3.SSS2.p2" class="ltx_para ltx_noindent">
<p id="A2.SS3.SSS2.p2.1" class="ltx_p">As shown in Fig. <a href="#A2.F5" title="Figure 5 ‣ B.3.2 Polynomial Approximation of 𝒯 ‣ B.3 Efficient computation of 𝒯 During Training ‣ Appendix B Fast Curriculum ‣ The Diffusion Duality, Chapter II: Ψ-Samplers and Efficient Curriculum" class="ltx_ref"><span class="ltx_text ltx_ref_tag">5</span></a>, approximations tend to be less accurate at the boundaries, when <math id="A2.SS3.SSS2.p2.m1" class="ltx_Math" alttext="t\approx 0" display="inline" intent=":literal"><semantics><mrow><mi>t</mi><mo>≈</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">t\approx 0</annotation></semantics></math> or <math id="A2.SS3.SSS2.p2.m2" class="ltx_Math" alttext="t\approx 1" display="inline" intent=":literal"><semantics><mrow><mi>t</mi><mo>≈</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">t\approx 1</annotation></semantics></math>. We find that the degree-9 polynomial works better than a sigmoid function of the form <math id="A2.SS3.SSS2.p2.m3" class="ltx_Math" alttext="a\sigma(bt+c)+d" display="inline" intent=":literal"><semantics><mrow><mrow><mi>a</mi><mo lspace="0em" rspace="0em">​</mo><mi>σ</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mi>b</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow><mo>+</mo><mi>c</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mi>d</mi></mrow><annotation encoding="application/x-tex">a\sigma(bt+c)+d</annotation></semantics></math>, especially at the boundaries.</p>
</div>
</section>
</section>
<section id="A2.SS4" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">B.4 </span>Implementation of the Fast Curriculum</h3>

<div id="A2.SS4.p1" class="ltx_para ltx_noindent">
<p id="A2.SS4.p1.1" class="ltx_p">In Sec. <a href="#S4" title="4 Scalable Curriculum for Faster Training ‣ The Diffusion Duality, Chapter II: Ψ-Samplers and Efficient Curriculum" class="ltx_ref"><span class="ltx_text ltx_ref_tag">4</span></a>, we described our efficient curriculum. Here we provide the pseudocode (Algo. <a href="#alg3" title="Algorithm 3 ‣ B.4 Implementation of the Fast Curriculum ‣ Appendix B Fast Curriculum ‣ The Diffusion Duality, Chapter II: Ψ-Samplers and Efficient Curriculum" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3</span></a>) and elaborate on the three main implementation challenges:</p>
<ul id="A2.I2" class="ltx_itemize">
<li id="A2.I2.i1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="A2.I2.i1.p1" class="ltx_para ltx_noindent">
<p id="A2.I2.i1.p1.1" class="ltx_p">First, we need to sample the <math id="A2.I2.i1.p1.m1" class="ltx_Math" alttext="k" display="inline" intent=":literal"><semantics><mi>k</mi><annotation encoding="application/x-tex">k</annotation></semantics></math> largest zero-mean Gaussian random variables out of <math id="A2.I2.i1.p1.m2" class="ltx_Math" alttext="K" display="inline" intent=":literal"><semantics><mi>K</mi><annotation encoding="application/x-tex">K</annotation></semantics></math>, to emulate the Gaussian Diffusion over the one-hot data samples <math id="A2.I2.i1.p1.m3" class="ltx_Math" alttext="{\mathbf{x}}" display="inline" intent=":literal"><semantics><mi>𝐱</mi><annotation encoding="application/x-tex">{\mathbf{x}}</annotation></semantics></math> (Sec. <a href="#A2.SS1.SSS4" title="B.1.4 Generating the 𝑘 largest Gaussian random variables out of 𝐾 ‣ B.1 Sampling the top-𝑘 values in 𝐰_𝑡^ℓ Without Materializing The Full Vector ‣ Appendix B Fast Curriculum ‣ The Diffusion Duality, Chapter II: Ψ-Samplers and Efficient Curriculum" class="ltx_ref"><span class="ltx_text ltx_ref_tag">B.1.4</span></a>).</p>
</div></li>
<li id="A2.I2.i2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="A2.I2.i2.p1" class="ltx_para ltx_noindent">
<p id="A2.I2.i2.p1.1" class="ltx_p">Secondly, we must estimate the normalization constant of the softmax, without actually sampling the <math id="A2.I2.i2.p1.m1" class="ltx_Math" alttext="K" display="inline" intent=":literal"><semantics><mi>K</mi><annotation encoding="application/x-tex">K</annotation></semantics></math> random variables (Sec. <a href="#A2.SS2" title="B.2 Approximating the Weighted Sum of the Embeddings ‣ Appendix B Fast Curriculum ‣ The Diffusion Duality, Chapter II: Ψ-Samplers and Efficient Curriculum" class="ltx_ref"><span class="ltx_text ltx_ref_tag">B.2</span></a>).</p>
</div></li>
<li id="A2.I2.i3" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="A2.I2.i3.p1" class="ltx_para">
<p id="A2.I2.i3.p1.1" class="ltx_p">Third, we require an efficient method to sample <math id="A2.I2.i3.p1.m1" class="ltx_Math" alttext="k" display="inline" intent=":literal"><semantics><mi>k</mi><annotation encoding="application/x-tex">k</annotation></semantics></math> distinct integers from <math id="A2.I2.i3.p1.m2" class="ltx_Math" alttext="K" display="inline" intent=":literal"><semantics><mi>K</mi><annotation encoding="application/x-tex">K</annotation></semantics></math> without replacement (Sec. <a href="#A2.SS1.SSS5" title="B.1.5 Sampling Integers Without Repetitions and Without Shuffling ‣ B.1 Sampling the top-𝑘 values in 𝐰_𝑡^ℓ Without Materializing The Full Vector ‣ Appendix B Fast Curriculum ‣ The Diffusion Duality, Chapter II: Ψ-Samplers and Efficient Curriculum" class="ltx_ref"><span class="ltx_text ltx_ref_tag">B.1.5</span></a>).</p>
</div></li>
</ul>
<p id="A2.SS4.p1.2" class="ltx_p">Algo. <a href="#alg3" title="Algorithm 3 ‣ B.4 Implementation of the Fast Curriculum ‣ Appendix B Fast Curriculum ‣ The Diffusion Duality, Chapter II: Ψ-Samplers and Efficient Curriculum" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3</span></a> shows the pseudocode of the complete algorithm.</p>
</div>
<figure id="alg3" class="ltx_float ltx_float_algorithm ltx_framed ltx_framed_top">
<figcaption class="ltx_caption"><span class="ltx_tag ltx_tag_float"><span id="alg3.4" class="ltx_text ltx_font_bold">Algorithm 3</span> </span> Scalable Top-<math id="alg3.m12" class="ltx_Math" alttext="k" display="inline" intent=":literal"><semantics><mi>k</mi><annotation encoding="application/x-tex">k</annotation></semantics></math> Curriculum Weights (Sec. <a href="#S4" title="4 Scalable Curriculum for Faster Training ‣ The Diffusion Duality, Chapter II: Ψ-Samplers and Efficient Curriculum" class="ltx_ref"><span class="ltx_text ltx_ref_tag">4</span></a>).
<br class="ltx_break">Recall that <span id="alg3.5" class="ltx_text"><math id="alg3.m13" class="ltx_Math" alttext="{\mathbf{w}}_{t}^{{\color[rgb]{0.4688,0.4688,0.4688}\ell}}={\color[rgb]{0.9023,0.5703,0.2188}\tilde{\alpha}_{t}}{\mathbf{x}}^{{\color[rgb]{0.4688,0.4688,0.4688}\ell}}+{\color[rgb]{0.9023,0.5703,0.2188}\tilde{\sigma}_{t}}\bm{\epsilon}" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>𝐰</mi><mi>t</mi><mi style="--ltx-fg-color:#787878;" mathcolor="#787878" mathvariant="normal">ℓ</mi></msubsup><mo>=</mo><mrow><mrow><msub><mover accent="true"><mi style="--ltx-fg-color:#E69138;" mathcolor="#E69138">α</mi><mo>~</mo></mover><mi style="--ltx-fg-color:#E69138;" mathcolor="#E69138">t</mi></msub><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝐱</mi><mi style="--ltx-fg-color:#787878;" mathcolor="#787878" mathvariant="normal">ℓ</mi></msup></mrow><mo>+</mo><mrow><msub><mover accent="true"><mi style="--ltx-fg-color:#E69138;" mathcolor="#E69138">σ</mi><mo>~</mo></mover><mi style="--ltx-fg-color:#E69138;" mathcolor="#E69138">t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi class="ltx_mathvariant_bold-italic" mathvariant="bold-italic">ϵ</mi></mrow></mrow></mrow><annotation encoding="application/x-tex">{\mathbf{w}}_{t}^{{\color[rgb]{0.4688,0.4688,0.4688}\ell}}={\color[rgb]{0.9023,0.5703,0.2188}\tilde{\alpha}_{t}}{\mathbf{x}}^{{\color[rgb]{0.4688,0.4688,0.4688}\ell}}+{\color[rgb]{0.9023,0.5703,0.2188}\tilde{\sigma}_{t}}\bm{\epsilon}</annotation></semantics></math>, <math id="alg3.m14" class="ltx_Math" alttext="\bm{\epsilon}\sim{\mathcal{N}}(\mathbf{0},\mathbf{I}_{K})" display="inline" intent=":literal"><semantics><mrow><mi class="ltx_mathvariant_bold-italic" mathvariant="bold-italic">ϵ</mi><mo>∼</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒩</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mn>𝟎</mn><mo>,</mo><msub><mi>𝐈</mi><mi>K</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\bm{\epsilon}\sim{\mathcal{N}}(\mathbf{0},\mathbf{I}_{K})</annotation></semantics></math></span>, where <math id="alg3.m15" class="ltx_Math" alttext="{\mathbf{x}}^{{\color[rgb]{0.4688,0.4688,0.4688}\ell}}" display="inline" intent=":literal"><semantics><msup><mi>𝐱</mi><mi style="--ltx-fg-color:#787878;" mathcolor="#787878" mathvariant="normal">ℓ</mi></msup><annotation encoding="application/x-tex">{\mathbf{x}}^{{\color[rgb]{0.4688,0.4688,0.4688}\ell}}</annotation></semantics></math> is the one-hot vector representation of category <math id="alg3.m16" class="ltx_Math" alttext="o" display="inline" intent=":literal"><semantics><mi>o</mi><annotation encoding="application/x-tex">o</annotation></semantics></math>. Hence, <math id="alg3.m17" class="ltx_Math" alttext="({\mathbf{w}}_{t}^{{\color[rgb]{0.4688,0.4688,0.4688}\ell}})_{o}\sim{\mathcal{N}}({\color[rgb]{0.9023,0.5703,0.2188}\tilde{\alpha}_{t}},{\color[rgb]{0.9023,0.5703,0.2188}\tilde{\sigma}_{t}^{{\color[rgb]{0,0,0}2}}})" display="inline" intent=":literal"><semantics><mrow><msub><mrow><mo stretchy="false">(</mo><msubsup><mi>𝐰</mi><mi>t</mi><mi style="--ltx-fg-color:#787878;" mathcolor="#787878" mathvariant="normal">ℓ</mi></msubsup><mo stretchy="false">)</mo></mrow><mi>o</mi></msub><mo>∼</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒩</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi style="--ltx-fg-color:#E69138;" mathcolor="#E69138">α</mi><mo>~</mo></mover><mi style="--ltx-fg-color:#E69138;" mathcolor="#E69138">t</mi></msub><mo>,</mo><msubsup><mover accent="true"><mi style="--ltx-fg-color:#E69138;" mathcolor="#E69138">σ</mi><mo>~</mo></mover><mi style="--ltx-fg-color:#E69138;" mathcolor="#E69138">t</mi><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">2</mn></msubsup><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">({\mathbf{w}}_{t}^{{\color[rgb]{0.4688,0.4688,0.4688}\ell}})_{o}\sim{\mathcal{N}}({\color[rgb]{0.9023,0.5703,0.2188}\tilde{\alpha}_{t}},{\color[rgb]{0.9023,0.5703,0.2188}\tilde{\sigma}_{t}^{{\color[rgb]{0,0,0}2}}})</annotation></semantics></math> and the remaining <math id="alg3.m18" class="ltx_Math" alttext="K{-}1" display="inline" intent=":literal"><semantics><mrow><mi>K</mi><mo>−</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">K{-}1</annotation></semantics></math> entries are i.i.d. <math id="alg3.m19" class="ltx_Math" alttext="{\mathcal{N}}(0,{\color[rgb]{0.9023,0.5703,0.2188}\tilde{\sigma}_{t}^{{\color[rgb]{0,0,0}2}}})" display="inline" intent=":literal"><semantics><mrow><mi class="ltx_font_mathcaligraphic">𝒩</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mn>0</mn><mo>,</mo><msubsup><mover accent="true"><mi style="--ltx-fg-color:#E69138;" mathcolor="#E69138">σ</mi><mo>~</mo></mover><mi style="--ltx-fg-color:#E69138;" mathcolor="#E69138">t</mi><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">2</mn></msubsup><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">{\mathcal{N}}(0,{\color[rgb]{0.9023,0.5703,0.2188}\tilde{\sigma}_{t}^{{\color[rgb]{0,0,0}2}}})</annotation></semantics></math>. The goal is to approximate <math id="alg3.m20" class="ltx_Math" alttext="{\color[rgb]{0.6055,0,0}\mathrm{softmax}}({\mathbf{w}}_{t}^{{\color[rgb]{0.4688,0.4688,0.4688}\ell}}/\tau)" display="inline" intent=":literal"><semantics><mrow><mi style="--ltx-fg-color:#9A0000;" mathcolor="#9A0000">softmax</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msubsup><mi>𝐰</mi><mi>t</mi><mi style="--ltx-fg-color:#787878;" mathcolor="#787878" mathvariant="normal">ℓ</mi></msubsup><mo>/</mo><mi>τ</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">{\color[rgb]{0.6055,0,0}\mathrm{softmax}}({\mathbf{w}}_{t}^{{\color[rgb]{0.4688,0.4688,0.4688}\ell}}/\tau)</annotation></semantics></math> using only the <math id="alg3.m21" class="ltx_Math" alttext="k" display="inline" intent=":literal"><semantics><mi>k</mi><annotation encoding="application/x-tex">k</annotation></semantics></math> largest entries (<math id="alg3.m22" class="ltx_Math" alttext="k\ll K" display="inline" intent=":literal"><semantics><mrow><mi>k</mi><mo>≪</mo><mi>K</mi></mrow><annotation encoding="application/x-tex">k\ll K</annotation></semantics></math>).</figcaption>
<div id="alg3.6" class="ltx_listing ltx_framed ltx_framed_topbottom ltx_listing">
<div id="alg3.l1" class="ltx_listingline">
              
              
             <span id="alg3.l1.2" class="ltx_text ltx_font_bold">Input:</span> Clean token index <math id="alg3.l1.m1" class="ltx_Math" alttext="o\in[K]" display="inline" intent=":literal"><semantics><mrow><mi>o</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mi>K</mi><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">o\in[K]</annotation></semantics></math>, vocabulary size <math id="alg3.l1.m2" class="ltx_Math" alttext="K" display="inline" intent=":literal"><semantics><mi>K</mi><annotation encoding="application/x-tex">K</annotation></semantics></math>, top-<math id="alg3.l1.m3" class="ltx_Math" alttext="k" display="inline" intent=":literal"><semantics><mi>k</mi><annotation encoding="application/x-tex">k</annotation></semantics></math> count <math id="alg3.l1.m4" class="ltx_Math" alttext="k" display="inline" intent=":literal"><semantics><mi>k</mi><annotation encoding="application/x-tex">k</annotation></semantics></math>, temperature <math id="alg3.l1.m5" class="ltx_Math" alttext="\tau" display="inline" intent=":literal"><semantics><mi>τ</mi><annotation encoding="application/x-tex">\tau</annotation></semantics></math>, Gaussian schedule <math id="alg3.l1.m6" class="ltx_Math" alttext="({\color[rgb]{0.9023,0.5703,0.2188}\tilde{\alpha}_{t}},{\color[rgb]{0.9023,0.5703,0.2188}\tilde{\sigma}_{t}})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi style="--ltx-fg-color:#E69138;" mathcolor="#E69138">α</mi><mo>~</mo></mover><mi style="--ltx-fg-color:#E69138;" mathcolor="#E69138">t</mi></msub><mo>,</mo><msub><mover accent="true"><mi style="--ltx-fg-color:#E69138;" mathcolor="#E69138">σ</mi><mo>~</mo></mover><mi style="--ltx-fg-color:#E69138;" mathcolor="#E69138">t</mi></msub><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">({\color[rgb]{0.9023,0.5703,0.2188}\tilde{\alpha}_{t}},{\color[rgb]{0.9023,0.5703,0.2188}\tilde{\sigma}_{t}})</annotation></semantics></math>

