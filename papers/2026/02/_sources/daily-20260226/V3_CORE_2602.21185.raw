             <math id="alg3.l5.m1" class="ltx_Math" alttext="\mathcal{K}_{1}\geq\cdots\geq\mathcal{K}_{k}\leftarrow" display="inline" intent=":literal"><semantics><mrow><msub><mi class="ltx_font_mathcaligraphic">𝒦</mi><mn>1</mn></msub><mo rspace="0.1389em">≥</mo><mo lspace="0.1389em" rspace="0.1389em">⋯</mo><mo lspace="0.1389em">≥</mo><msub><mi class="ltx_font_mathcaligraphic">𝒦</mi><mi>k</mi></msub><mo stretchy="false">←</mo><mphantom></mphantom></mrow><annotation encoding="application/x-tex">\mathcal{K}_{1}\geq\cdots\geq\mathcal{K}_{k}\leftarrow</annotation></semantics></math> top-<math id="alg3.l5.m2" class="ltx_Math" alttext="k" display="inline" intent=":literal"><semantics><mi>k</mi><annotation encoding="application/x-tex">k</annotation></semantics></math> order statistics of <math id="alg3.l5.m3" class="ltx_Math" alttext="(K{-}1)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mrow><mi>K</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(K{-}1)</annotation></semantics></math> i.i.d. <math id="alg3.l5.m4" class="ltx_Math" alttext="{\mathcal{N}}(0,{\color[rgb]{0.9023,0.5703,0.2188}\tilde{\sigma}_{t}^{{\color[rgb]{0,0,0}2}}})" display="inline" intent=":literal"><semantics><mrow><mi class="ltx_font_mathcaligraphic">𝒩</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mn>0</mn><mo>,</mo><msubsup><mover accent="true"><mi style="--ltx-fg-color:#E69138;" mathcolor="#E69138">σ</mi><mo>~</mo></mover><mi style="--ltx-fg-color:#E69138;" mathcolor="#E69138">t</mi><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">2</mn></msubsup><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">{\mathcal{N}}(0,{\color[rgb]{0.9023,0.5703,0.2188}\tilde{\sigma}_{t}^{{\color[rgb]{0,0,0}2}}})</annotation></semantics></math> draws <span id="alg3.l5.2" class="ltx_text" style="float:right;"><math id="alg3.l5.m5" class="ltx_Math" alttext="\triangleright" display="inline" intent=":literal"><semantics><mo style="--ltx-fg-color:#808080;" mathcolor="#808080">⊳</mo><annotation encoding="application/x-tex">\triangleright</annotation></semantics></math><span id="alg3.l5.2.1" class="ltx_text" style="--ltx-fg-color:#808080;"> Algo. <a href="#alg1" title='Algorithm 1 ‣ Sampling The 𝑘^"th"-largest ‣ B.1.4 Generating the 𝑘 largest Gaussian random variables out of 𝐾 ‣ B.1 Sampling the top-𝑘 values in 𝐰_𝑡^ℓ Without Materializing The Full Vector ‣ Appendix B Fast Curriculum ‣ The Diffusion Duality, Chapter II: Ψ-Samplers and Efficient Curriculum' class="ltx_ref"><span class="ltx_text ltx_ref_tag">1</span></a></span>
