<figure id="A1.F16" class="ltx_figure"><img src="2602.20980v1/fig/viz_146_maps_step_1078.jpg" id="A1.F16.g1" class="ltx_graphics ltx_centering ltx_img_landscape" style="aspect-ratio:476/127;" width="476" height="127" alt="Refer to caption">
