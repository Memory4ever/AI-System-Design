<th id="A2.T1.2.1.1" class="ltx_td ltx_align_left ltx_align_top ltx_th ltx_th_column ltx_border_tt">
<span id="A2.T1.2.1.1.1" class="ltx_inline-block ltx_align_top" style="width:103.5pt;">
