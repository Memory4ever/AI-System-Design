;" stroke="#000000" stroke-width="1.1pt"><path style="fill:none" d="M 471.05 -186.61 L 618.13 -223.49"></path><g style="--ltx-fill-color:#000000;" fill="#000000" stroke-dasharray="none" stroke-dashoffset="0.0pt" stroke-linejoin="miter" transform="matrix(0.96997 -0.24321 0.24321 0.96997 618.13 -223.49)"><path d="M 7.2 0 C 6.31 0.22 2.43 1.45 0 2.8 L 0 -2.8 C 2.43 -1.45 6.31 -0.22 7.2 0 Z"></path></g></g><g style="--ltx-stroke-color:#000000;" stroke="#000000" stroke-width="1.1pt"><path style="fill:none" d="M 23.62 -372.1 L 23.62 -399.26"></path><g style="--ltx-fill-color:#000000;" fill="#000000" stroke-dasharray="none" stroke-dashoffset="0.0pt" stroke-linejoin="miter" transform="matrix(0.0 -1.0 1.0 0.0 23.62 -399.26)"><path d="M 7.2 0 C 6.31 0.22 2.43 1.45 0 2.8 L 0 -2.8 C 2.43 -1.45 6.31 -0.22 7.2 0 Z"></path></g></g><g style="--ltx-stroke-color:#000000;" stroke="#000000" stroke-width="1.1pt"><path style="fill:none" d="M 628.06 -313.15 L 628.06 -340.31"></path><g style="--ltx-fill-color:#000000;" fill="#000000" stroke-dasharray="none" stroke-dashoffset="0.0pt" stroke-linejoin="miter" transform="matrix(0.0 -1.0 1.0 0.0 628.06 -340.31)"><path d="M 7.2 0 C 6.31 0.22 2.43 1.45 0 2.8 L 0 -2.8 C 2.43 -1.45 6.31 -0.22 7.2 0 Z"></path></g></g><g style="--ltx-stroke-color:#000000;" stroke="#000000" stroke-width="1.1pt"><path style="fill:none" d="M 628.06 -446.64 L 628.06 -473.8"></path><g style="--ltx-fill-color:#000000;" fill="#000000" stroke-dasharray="none" stroke-dashoffset="0.0pt" stroke-linejoin="miter" transform="matrix(0.0 -1.0 1.0 0.0 628.06 -473.8)"><path d="M 7.2 0 C 6.31 0.22 2.43 1.45 0 2.8 L 0 -2.8 C 2.43 -1.45 6.31 -0.22 7.2 0 Z"></path></g></g><g style="--ltx-stroke-color:#000000;" stroke="#000000" stroke-width="1.1pt"><path style="fill:none" d="M 628.06 -571.21 L 628.06 -598.37"></path><g style="--ltx-fill-color:#000000;" fill="#000000" stroke-dasharray="none" stroke-dashoffset="0.0pt" stroke-linejoin="miter" transform="matrix(0.0 -1.0 1.0 0.0 628.06 -598.37)"><path d="M 7.2 0 C 6.31 0.22 2.43 1.45 0 2.8 L 0 -2.8 C 2.43 -1.45 6.31 -0.22 7.2 0 Z"></path></g></g></g></svg></span></span></span>
</span></span></span></p>
