<span id="S2.F1.pic1.19.1" class="ltx_p"></span>
<span id="S2.F1.pic1.19.2" class="ltx_p"><span id="S2.F1.pic1.19.2.1" class="ltx_text" style="font-size:144%;">Pick <math id="S2.F1.pic1.m16" class="ltx_Math" alttext="k=3" display="inline" intent=":literal"><semantics><mrow><mi>k</mi><mo>=</mo><mn>3</mn></mrow><annotation encoding="application/x-tex">k=3</annotation></semantics></math>. RHS is divisible</span></span>
<span id="S2.F1.pic1.19.3" class="ltx_p"><span id="S2.F1.pic1.19.3.1" class="ltx_text" style="font-size:144%;">by 3, hence RHS <math id="S2.F1.pic1.m17" class="ltx_Math" alttext="\bmod\,3=0" display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>mod</mo><mn> 3</mn></mrow><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\bmod\,3=0</annotation></semantics></math>.</span></span>
</span></span></span></foreignObject></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#FFFFFF;" fill="#FFFFFF" stroke="#000000" stroke-width="0.9pt"><path d="M 523.18 -219.06 C 523.18 -208.19 514.37 -199.38 503.5 -199.38 C 492.63 -199.38 483.81 -208.19 483.81 -219.06 C 483.81 -229.93 492.63 -238.75 503.5 -238.75 C 514.37 -238.75 523.18 -229.93 523.18 -219.06 Z M 503.5 -219.06"></path></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" stroke-width="0.9pt" transform="matrix(1.0 0.0 0.0 1.0 500.04 -223.52)"><foreignObject style="--ltx-fo-width:0.5em;--ltx-fo-height:0.64em;--ltx-fo-depth:0em;font-size:10pt;" height="8.92" overflow="visible" transform="matrix(1 0 0 -1 0 8.92)" width="6.92"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><span id="S2.F1.pic1.20" class="ltx_text">9</span></span></span></foreignObject></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#E6E6FF;" fill="#E6E6FF" stroke="#000000"><path d="M 761.92 -350.83 L 494.2 -350.83 C 488.09 -350.83 483.13 -355.78 483.13 -361.9 L 483.13 -435.29 C 483.13 -441.41 488.09 -446.36 494.2 -446.36 L 761.92 -446.36 C 768.03 -446.36 772.99 -441.41 772.99 -435.29 L 772.99 -361.9 C 772.99 -355.78 768.03 -350.83 761.92 -350.83 Z M 483.13 -446.36"></path></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 494.2 -375.73)"><foreignObject style="--ltx-fo-width:13.44em;--ltx-fo-height:1em;--ltx-fo-depth:4.3em;font-size:10pt;" height="73.4" overflow="visible" transform="matrix(1 0 0 -1 0 13.84)" width="185.97"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content">
<span id="S2.F1.pic1.21" class="ltx_inline-block ltx_minipage ltx_align_top" style="width:13.44em;">
<span id="S2.F1.pic1.21.1" class="ltx_p"></span>
<span id="S2.F1.pic1.21.2" class="ltx_p"><span id="S2.F1.pic1.21.2.1" class="ltx_text" style="font-size:144%;">For every <math id="S2.F1.pic1.m18" class="ltx_Math" alttext="a" display="inline" intent=":literal"><semantics><mi>a</mi><annotation encoding="application/x-tex">a</annotation></semantics></math>, if <math id="S2.F1.pic1.m19" class="ltx_Math" alttext="a\bmod 3=0" display="inline" intent=":literal"><semantics><mrow><mrow><mi>a</mi><mo>mod</mo><mn>3</mn></mrow><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">a\bmod 3=0</annotation></semantics></math> then</span></span>
<span id="S2.F1.pic1.21.3" class="ltx_p"><span id="S2.F1.pic1.21.3.1" class="ltx_text" style="font-size:144%;">so is <math id="S2.F1.pic1.m20" class="ltx_Math" alttext="a^{2}" display="inline" intent=":literal"><semantics><msup><mi>a</mi><mn>2</mn></msup><annotation encoding="application/x-tex">a^{2}</annotation></semantics></math>. Otherwise write <math id="S2.F1.pic1.m21" class="ltx_Math" alttext="a=3n+r" display="inline" intent=":literal"><semantics><mrow><mi>a</mi><mo>=</mo><mrow><mrow><mn>3</mn><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow><mo>+</mo><mi>r</mi></mrow></mrow><annotation encoding="application/x-tex">a=3n+r</annotation></semantics></math></span></span>
<span id="S2.F1.pic1.21.4" class="ltx_p"><span id="S2.F1.pic1.21.4.1" class="ltx_text" style="font-size:144%;">for <math id="S2.F1.pic1.m22" class="ltx_Math" alttext="r\in\{1,2\}" display="inline" intent=":literal"><semantics><mrow><mi>r</mi><mo>∈</mo><mrow><mo maxsize="0.690em" minsize="0.690em">{</mo><mrow><mn>1</mn><mo>,</mo><mn>2</mn></mrow><mo maxsize="0.690em" minsize="0.690em">}</mo></mrow></mrow><annotation encoding="application/x-tex">r\in\{1,2\}</annotation></semantics></math>, then</span></span>
<span id="S2.F1.pic1.21.5" class="ltx_p"><math id="S2.F1.pic1.m23" class="ltx_Math" alttext="a^{2}\bmod 3=r^{2}\bmod 3=1" display="inline" intent=":literal"><semantics><mrow><mrow><msup><mi mathsize="1.440em">a</mi><mn mathsize="1.440em">2</mn></msup><mo mathsize="1.440em">mod</mo><mn mathsize="1.440em">3</mn></mrow><mo mathsize="1.440em">=</mo><mrow><msup><mi mathsize="1.440em">r</mi><mn mathsize="1.440em">2</mn></msup><mo mathsize="1.440em">mod</mo><mn mathsize="1.440em">3</mn></mrow><mo mathsize="1.440em">=</mo><mn mathsize="1.440em">1</mn></mrow><annotation encoding="application/x-tex">a^{2}\bmod 3=r^{2}\bmod 3=1</annotation></semantics></math><span id="S2.F1.pic1.21.5.1" class="ltx_text" style="font-size:144%;">.</span></span>
</span></span></span></foreignObject></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#FFFFFF;" fill="#FFFFFF" stroke="#000000" stroke-width="0.9pt"><path d="M 495.62 -343.63 C 495.62 -332.76 486.81 -323.95 475.94 -323.95 C 465.07 -323.95 456.25 -332.76 456.25 -343.63 C 456.25 -354.5 465.07 -363.32 475.94 -363.32 C 486.81 -363.32 495.62 -354.5 495.62 -343.63 Z M 475.94 -343.63"></path></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" stroke-width="0.9pt" transform="matrix(1.0 0.0 0.0 1.0 469.02 -348.09)"><foreignObject style="--ltx-fo-width:1em;--ltx-fo-height:0.64em;--ltx-fo-depth:0em;font-size:10pt;" height="8.92" overflow="visible" transform="matrix(1 0 0 -1 0 8.92)" width="13.84"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><span id="S2.F1.pic1.22" class="ltx_text">10</span></span></span></foreignObject></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#E6E6FF;" fill="#E6E6FF" stroke="#000000"><path d="M 761.92 -484.32 L 494.2 -484.32 C 488.09 -484.32 483.13 -489.27 483.13 -495.39 L 483.13 -559.86 C 483.13 -565.98 488.09 -570.93 494.2 -570.93 L 761.92 -570.93 C 768.03 -570.93 772.99 -565.98 772.99 -559.86 L 772.99 -495.39 C 772.99 -489.27 768.03 -484.32 761.92 -484.32 Z M 483.13 -570.93"></path></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 494.2 -512.32)"><foreignObject style="--ltx-fo-width:13.44em;--ltx-fo-height:1em;--ltx-fo-depth:3.21em;font-size:10pt;" height="58.28" overflow="visible" transform="matrix(1 0 0 -1 0 13.84)" width="185.97"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content">
<span id="S2.F1.pic1.23" class="ltx_inline-block ltx_minipage ltx_align_top" style="width:13.44em;">
<span id="S2.F1.pic1.23.1" class="ltx_p"></span>
<span id="S2.F1.pic1.23.2" class="ltx_p"><span id="S2.F1.pic1.23.2.1" class="ltx_text" style="font-size:144%;">Since <math id="S2.F1.pic1.m24" class="ltx_Math" alttext="a,b" display="inline" intent=":literal"><semantics><mrow><mi>a</mi><mo>,</mo><mi>b</mi></mrow><annotation encoding="application/x-tex">a,b</annotation></semantics></math> are coprime, at least one</span></span>
<span id="S2.F1.pic1.23.3" class="ltx_p"><span id="S2.F1.pic1.23.3.1" class="ltx_text" style="font-size:144%;">of them is not divisible by 3.</span></span>
<span id="S2.F1.pic1.23.4" class="ltx_p"><span id="S2.F1.pic1.23.4.1" class="ltx_text" style="font-size:144%;">Hence <math id="S2.F1.pic1.m25" class="ltx_Math" alttext="a^{2}+b^{2}\bmod 3\in\{1,2\}" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><msup><mi>a</mi><mn>2</mn></msup><mo>+</mo><msup><mi>b</mi><mn>2</mn></msup></mrow><mo>mod</mo><mn>3</mn></mrow><mo>∈</mo><mrow><mo maxsize="0.690em" minsize="0.690em">{</mo><mn>1</mn><mo>,</mo><mn>2</mn><mo maxsize="0.690em" minsize="0.690em">}</mo></mrow></mrow><annotation encoding="application/x-tex">a^{2}+b^{2}\bmod 3\in\{1,2\}</annotation></semantics></math>.</span></span>
</span></span></span></foreignObject></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#FFFFFF;" fill="#FFFFFF" stroke="#000000" stroke-width="0.9pt"><path d="M 495.62 -477.12 C 495.62 -466.25 486.81 -457.44 475.94 -457.44 C 465.07 -457.44 456.25 -466.25 456.25 -477.12 C 456.25 -487.99 465.07 -496.81 475.94 -496.81 C 486.81 -496.81 495.62 -487.99 495.62 -477.12 Z M 475.94 -477.12"></path></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" stroke-width="0.9pt" transform="matrix(1.0 0.0 0.0 1.0 469.02 -481.58)"><foreignObject style="--ltx-fo-width:1em;--ltx-fo-height:0.64em;--ltx-fo-depth:0em;font-size:10pt;" height="8.92" overflow="visible" transform="matrix(1 0 0 -1 0 8.92)" width="13.84"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><span id="S2.F1.pic1.24" class="ltx_text">11</span></span></span></foreignObject></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#E6E6FF;" fill="#E6E6FF" stroke="#000000"><path d="M 761.92 -608.89 L 494.2 -608.89 C 488.09 -608.89 483.13 -613.84 483.13 -619.96 L 483.13 -684.43 C 483.13 -690.54 488.09 -695.5 494.2 -695.5 L 761.92 -695.5 C 768.03 -695.5 772.99 -690.54 772.99 -684.43 L 772.99 -619.96 C 772.99 -613.84 768.03 -608.89 761.92 -608.89 Z M 483.13 -695.5"></path></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 494.2 -641.26)"><foreignObject style="--ltx-fo-width:13.44em;--ltx-fo-height:1em;--ltx-fo-depth:2.58em;font-size:10pt;" height="49.54" overflow="visible" transform="matrix(1 0 0 -1 0 13.84)" width="185.97"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content">
<span id="S2.F1.pic1.25" class="ltx_inline-block ltx_minipage ltx_align_top" style="width:13.44em;">
<span id="S2.F1.pic1.25.1" class="ltx_p"></span>
<span id="S2.F1.pic1.25.2" class="ltx_p"><span id="S2.F1.pic1.25.2.1" class="ltx_text" style="font-size:144%;">We have shown that LHS <math id="S2.F1.pic1.m26" class="ltx_Math" alttext="\bmod\,3" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>mod</mo><mn> 3</mn></mrow><annotation encoding="application/x-tex">\bmod\,3</annotation></semantics></math> is in</span></span>
<span id="S2.F1.pic1.25.3" class="ltx_p"><math id="S2.F1.pic1.m27" class="ltx_Math" alttext="\{1,2\}" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">{</mo><mn mathsize="1.440em">1</mn><mo mathsize="1.440em">,</mo><mn mathsize="1.440em">2</mn><mo stretchy="false">}</mo></mrow><annotation encoding="application/x-tex">\{1,2\}</annotation></semantics></math><span id="S2.F1.pic1.25.3.1" class="ltx_text" style="font-size:144%;"> while RHS <math id="S2.F1.pic1.m28" class="ltx_Math" alttext="\bmod\,3" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>mod</mo><mn> 3</mn></mrow><annotation encoding="application/x-tex">\bmod\,3</annotation></semantics></math> is 0. Done.</span></span>
</span></span></span></foreignObject></g></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#FFFFFF;" fill="#FFFFFF" stroke="#000000" stroke-width="0.9pt"><path d="M 495.62 -601.69 C 495.62 -590.82 486.81 -582.01 475.94 -582.01 C 465.07 -582.01 456.25 -590.82 456.25 -601.69 C 456.25 -612.56 465.07 -621.38 475.94 -621.38 C 486.81 -621.38 495.62 -612.56 495.62 -601.69 Z M 475.94 -601.69"></path></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" stroke-width="0.9pt" transform="matrix(1.0 0.0 0.0 1.0 469.02 -606.15)"><foreignObject style="--ltx-fo-width:1em;--ltx-fo-height:0.64em;--ltx-fo-depth:0em;font-size:10pt;" height="8.92" overflow="visible" transform="matrix(1 0 0 -1 0 8.92)" width="13.84"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><span id="S2.F1.pic1.26" class="ltx_text">12</span></span></span></foreignObject></g><g style="--ltx-stroke-color:#000000;" stroke="#000000" stroke-width="1.1pt"><path style="fill:none" d="M -157.02 -45.55 L -327.75 -90.21"></path><g style="--ltx-fill-color:#000000;" fill="#000000" stroke-dasharray="none" stroke-dashoffset="0.0pt" stroke-linejoin="miter" transform="matrix(-0.96745 -0.25304 0.25304 -0.96745 -327.75 -90.21)"><path d="M 7.2 0 C 6.31 0.22 2.43 1.45 0 2.8 L 0 -2.8 C 2.43 -1.45 6.31 -0.22 7.2 0 Z"></path></g></g><g style="--ltx-stroke-color:#000000;" stroke="#000000" stroke-width="1.1pt"><path style="fill:none" d="M -337.65 -179.96 L -337.65 -211.06"></path><g style="--ltx-fill-color:#000000;" fill="#000000" stroke-dasharray="none" stroke-dashoffset="0.0pt" stroke-linejoin="miter" transform="matrix(0.0 -1.0 1.0 0.0 -337.65 -211.06)"><path d="M 7.2 0 C 6.31 0.22 2.43 1.45 0 2.8 L 0 -2.8 C 2.43 -1.45 6.31 -0.22 7.2 0 Z"></path></g></g><g style="--ltx-stroke-color:#000000;" stroke="#000000" stroke-width="1.1pt"><path style="fill:none" d="M -337.65 -353.31 L -337.65 -384.41"></path><g style="--ltx-fill-color:#000000;" fill="#000000" st