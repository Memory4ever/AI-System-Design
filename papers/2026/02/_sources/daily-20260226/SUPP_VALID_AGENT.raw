        <span>&nbsp;[<a href="https://arxiv.org/pdf/2604.16321">pdf</a>, <a href="https://arxiv.org/ps/2604.16321">ps</a>, <a href="https://arxiv.org/format/2604.16321">other</a>]&nbsp;</span>
