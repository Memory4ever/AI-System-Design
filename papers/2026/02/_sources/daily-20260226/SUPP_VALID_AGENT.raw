        <span>&nbsp;[<a href="https://arxiv.org/pdf/2602.20867">pdf</a>, <a href="https://arxiv.org/ps/2602.20867">ps</a>, <a href="https://arxiv.org/format/2602.20867">other</a>]&nbsp;</span>
