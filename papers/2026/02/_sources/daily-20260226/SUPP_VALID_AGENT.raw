        <span>&nbsp;[<a href="https://arxiv.org/pdf/2602.20979">pdf</a>, <a href="https://arxiv.org/ps/2602.20979">ps</a>, <a href="https://arxiv.org/format/2602.20979">other</a>]&nbsp;</span>
