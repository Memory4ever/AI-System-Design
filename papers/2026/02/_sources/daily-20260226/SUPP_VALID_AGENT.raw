      <a href="/search/?searchtype=author&amp;query=Sekiya%2C+M">Motoyoshi Sekiya</a>, 
      
      <a href="/search/?searchtype=author&amp;query=Unno%2C+Y">Yuki Unno</a>, 
      
      <a href="/search/?searchtype=author&amp;query=Suga%2C+J">Junichi Suga</a>
      
