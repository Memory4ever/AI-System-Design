        <span>&nbsp;[<a href="https://arxiv.org/pdf/2602.21556">pdf</a>, <a href="https://arxiv.org/ps/2602.21556">ps</a>, <a href="https://arxiv.org/format/2602.21556">other</a>]&nbsp;</span>
