<td id="S4.T7.5.3.2" class="ltx_td ltx_align_center"><span id="S4.T7.5.3.2.1" class="ltx_text ltx_font_bold">92.83 <math id="S4.T7.m4" class="ltx_Math" alttext="\pm" display="inline" intent=":literal"><semantics><mo>±</mo><annotation encoding="application/x-tex">\pm</annotation></semantics></math> 0.20</span></td></tr>
<tr id="S4.T7.5.4" class="ltx_tr">
<th id="S4.T7.5.4.1" class="ltx_td ltx_align_left ltx_th ltx_th_row">Res-20-32-B-ema</th>
<td id="S4.T7.5.4.2" class="ltx_td ltx_align_center">92.78 <math id="S4.T7.m5" class="ltx_Math" alttext="\pm" display="inline" intent=":literal"><semantics><mo>±</mo><annotation encoding="application/x-tex">\pm</annotation></semantics></math> 0.23</td></tr>
<tr id="S4.T7.5.5" class="ltx_tr">
