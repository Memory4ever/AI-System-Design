             motivated <math id="alg1.l1.m1" class="ltx_Math" alttext="\leftarrow" display="inline" intent=":literal"><semantics><mo stretchy="false">←</mo><annotation encoding="application/x-tex">\leftarrow</annotation></semantics></math> <span id="alg1.l1.3" class="ltx_text ltx_font_bold">false</span>;

</div>
