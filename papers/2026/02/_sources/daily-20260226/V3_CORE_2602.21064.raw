             prev_loss <math id="alg1.l3.m1" class="ltx_Math" alttext="\leftarrow" display="inline" intent=":literal"><semantics><mo stretchy="false">←</mo><annotation encoding="application/x-tex">\leftarrow</annotation></semantics></math> <math id="alg1.l3.m2" class="ltx_Math" alttext="+\infty" display="inline" intent=":literal"><semantics><mrow><mo>+</mo><mi mathvariant="normal">∞</mi></mrow><annotation encoding="application/x-tex">+\infty</annotation></semantics></math>

</div>
<div id="alg1.l4" class="ltx_listingline">
