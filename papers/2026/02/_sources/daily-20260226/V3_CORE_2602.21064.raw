             <span id="alg1.l5.3" class="ltx_text ltx_font_bold">for</span> epoch = 1 to <math id="alg1.l5.m1" class="ltx_Math" alttext="N" display="inline" intent=":literal"><semantics><mi>N</mi><annotation encoding="application/x-tex">N</annotation></semantics></math> <span id="alg1.l5.4" class="ltx_text ltx_font_bold">do</span>



