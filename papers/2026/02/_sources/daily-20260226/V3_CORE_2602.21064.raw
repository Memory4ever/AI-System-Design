<td id="S6.T8.5.3.2" class="ltx_td ltx_align_center">92.47M</td>
<td id="S6.T8.5.3.3" class="ltx_td ltx_align_center">85.12M</td></tr>
<tr id="S6.T8.5.4" class="ltx_tr">
<th id="S6.T8.5.4.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_t">Resnet-32-C</th>
<td id="S6.T8.5.4.2" class="ltx_td ltx_align_center ltx_border_t">140.13M</td>
