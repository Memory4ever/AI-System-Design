<th id="S4.T7.5.1.2" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_t"><span id="S4.T7.5.1.2.1" class="ltx_text ltx_font_bold">CIFAR-10 (%)</span></th></tr>
</thead>
<tbody class="ltx_tbody">
<tr id="S4.T7.5.2" class="ltx_tr">
