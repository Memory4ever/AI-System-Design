<td id="S6.T8.5.2.2" class="ltx_td ltx_align_center ltx_border_t">82.82M</td>
<td id="S6.T8.5.2.3" class="ltx_td ltx_align_center ltx_border_t">82.82M</td></tr>
<tr id="S6.T8.5.3" class="ltx_tr">
