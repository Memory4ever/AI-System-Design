<td id="S4.T7.5.2.2" class="ltx_td ltx_align_center ltx_border_t">92.62 <math id="S4.T7.m3" class="ltx_Math" alttext="\pm" display="inline" intent=":literal"><semantics><mo>±</mo><annotation encoding="application/x-tex">\pm</annotation></semantics></math> 0.17</td></tr>
<tr id="S4.T7.5.3" class="ltx_tr">
