<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A4.Ex285.m1" class="ltx_Math" alttext="\displaystyle=" display="inline" intent=":literal"><semantics><mo>=</mo><annotation encoding="application/x-tex">\displaystyle=</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex285.m2" class="ltx_math_unparsed" alttext="\displaystyle~1+W_{i,j}\mathds{1}_{\left\{v_{i,j}=x_{i,j}\right\}}-2W_{i,j}\mathds{1}_{\left\{v_{i,j}=x_{i,j}\right\}}" display="inline" intent=":literal"><semantics><mrow><mn>1</mn><mo>+</mo><mi>W</mi><msub><mrow></mrow><mrow><mi>i</mi><mo>,</mo><mi>j</mi></mrow></msub><mn>𝟙</mn><msub><mrow></mrow><mrow><mo>{</mo><mi>v</mi><msub><mrow></mrow><mrow><mi>i</mi><mo>,</mo><mi>j</mi></mrow></msub><mo>=</mo><mi>x</mi><msub><mrow></mrow><mrow><mi>i</mi><mo>,</mo><mi>j</mi></mrow></msub><mo>}</mo></mrow></msub><mo>−</mo><mn>2</mn><mi>W</mi><msub><mrow></mrow><mrow><mi>i</mi><mo>,</mo><mi>j</mi></mrow></msub><mn>𝟙</mn><msub><mrow></mrow><mrow><mo>{</mo><mi>v</mi><msub><mrow></mrow><mrow><mi>i</mi><mo>,</mo><mi>j</mi></mrow></msub><mo>=</mo><mi>x</mi><msub><mrow></mrow><mrow><mi>i</mi><mo>,</mo><mi>j</mi></mrow></msub><mo>}</mo></mrow></msub></mrow><annotation encoding="application/x-tex">\displaystyle~1+W_{i,j}\mathds{1}_{\left\{v_{i,j}=x_{i,j}\right\}}-2W_{i,j}\mathds{1}_{\left\{v_{i,j}=x_{i,j}\right\}}</annotation></semantics></math></td>
