<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex288.m2" class="ltx_math_unparsed" alttext="\displaystyle~\frac{1}{Nn}\sum_{i=1}^{N}\sum_{j=1}^{n}U_{i}\mathcal{I}_{i}\left(1-W_{i,j}+\left(1-\mathds{1}_{\left\{v_{i,j}=x_{i,j}\right\}}\right)W_{i,j}\right)" display="inline" intent=":literal"><semantics><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mrow><mi>N</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow></mfrac></mstyle><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>N</mi></munderover></mstyle><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>j</mi><mo>=</mo><mn>1</mn></mrow><mi>n</mi></munderover></mstyle><msub><mi>U</mi><mi>i</mi></msub><msub><mi class="ltx_font_mathcaligraphic">ℐ</mi><mi>i</mi></msub><mrow><mo>(</mo><mn>1</mn><mo>−</mo><msub><mi>W</mi><mrow><mi>i</mi><mo>,</mo><mi>j</mi></mrow></msub><mo>+</mo><mrow><mo>(</mo><mn>1</mn><mo>−</mo><msub><mn>𝟙</mn><mrow><mo>{</mo><mi>v</mi><msub><mrow></mrow><mrow><mi>i</mi><mo>,</mo><mi>j</mi></mrow></msub><mo>=</mo><mi>x</mi><msub><mrow></mrow><mrow><mi>i</mi><mo>,</mo><mi>j</mi></mrow></msub><mo>}</mo></mrow></msub><mo>)</mo></mrow><msub><mi>W</mi><mrow><mi>i</mi><mo>,</mo><mi>j</mi></mrow></msub><mo>)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle~\frac{1}{Nn}\sum_{i=1}^{N}\sum_{j=1}^{n}U_{i}\mathcal{I}_{i}\left(1-W_{i,j}+\left(1-\mathds{1}_{\left\{v_{i,j}=x_{i,j}\right\}}\right)W_{i,j}\right)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A4.Ex289"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
