<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex293.m2" class="ltx_math_unparsed" alttext="\displaystyle~2\left(1-\varepsilon\right)-\left(1-\varepsilon\right)\left(1-\alpha\right)-\frac{1}{Nn}\sum_{i=1}^{N}\sum_{j=1}^{n}\mathcal{I}_{i}\mathds{1}_{\left\{v_{i,j}=x_{i,j}\right\}}" display="inline" intent=":literal"><semantics><mrow><mn>2</mn><mrow><mo>(</mo><mn>1</mn><mo>−</mo><mi>ε</mi><mo>)</mo></mrow><mo>−</mo><mrow><mo>(</mo><mn>1</mn><mo>−</mo><mi>ε</mi><mo>)</mo></mrow><mrow><mo>(</mo><mn>1</mn><mo>−</mo><mi>α</mi><mo>)</mo></mrow><mo>−</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mrow><mi>N</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow></mfrac></mstyle><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>N</mi></munderover></mstyle><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>j</mi><mo>=</mo><mn>1</mn></mrow><mi>n</mi></munderover></mstyle><msub><mi class="ltx_font_mathcaligraphic">ℐ</mi><mi>i</mi></msub><msub><mn>𝟙</mn><mrow><mo>{</mo><mi>v</mi><msub><mrow></mrow><mrow><mi>i</mi><mo>,</mo><mi>j</mi></mrow></msub><mo>=</mo><mi>x</mi><msub><mrow></mrow><mrow><mi>i</mi><mo>,</mo><mi>j</mi></mrow></msub><mo>}</mo></mrow></msub></mrow><annotation encoding="application/x-tex">\displaystyle~2\left(1-\varepsilon\right)-\left(1-\varepsilon\right)\left(1-\alpha\right)-\frac{1}{Nn}\sum_{i=1}^{N}\sum_{j=1}^{n}\mathcal{I}_{i}\mathds{1}_{\left\{v_{i,j}=x_{i,j}\right\}}</annotation></semantics></math></td>
