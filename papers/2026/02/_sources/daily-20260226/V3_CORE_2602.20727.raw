<div id="S4.T1.2" class="ltx_inline-block ltx_align_center ltx_transformed_outer" style="width:373.1pt;height:144.3pt;vertical-align:-70.0pt;"><span class="ltx_transformed_inner" style="transform:translate(-32.9pt,12.7pt) scale(0.8,0.8) ;">
