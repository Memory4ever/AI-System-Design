<th id="A1.T5.5.1.2" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt"><span id="A1.T5.5.1.2.1" class="ltx_text ltx_font_bold">Name</span></th>
<th id="A1.T5.5.1.3" class="ltx_td ltx_align_left ltx_th ltx_th_column ltx_border_tt"><span id="A1.T5.5.1.3.1" class="ltx_text ltx_font_bold">Description</span></th></tr>
</thead>
<tbody class="ltx_tbody">
<tr id="A1.T5.5.2" class="ltx_tr">
<td id="A1.T5.5.2.1" class="ltx_td ltx_align_center ltx_border_t">0</td>
<td id="A1.T5.5.2.2" class="ltx_td ltx_align_center ltx_border_t"><math id="A1.T5.m1" class="ltx_Math" alttext="Cl" display="inline" intent=":literal"><semantics><mrow><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><mi>l</mi></mrow><annotation encoding="application/x-tex">Cl</annotation></semantics></math>-<math id="A1.T5.m2" class="ltx_Math" alttext="Cl" display="inline" intent=":literal"><semantics><mrow><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><mi>l</mi></mrow><annotation encoding="application/x-tex">Cl</annotation></semantics></math></td>
<td id="A1.T5.5.2.3" class="ltx_td ltx_align_left ltx_border_t">Intra-clique edge</td></tr>
<tr id="A1.T5.5.3" class="ltx_tr">
<td id="A1.T5.5.3.1" class="ltx_td ltx_align_center">1</td>
