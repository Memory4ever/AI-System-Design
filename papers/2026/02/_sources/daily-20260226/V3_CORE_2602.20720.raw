<td id="S6.T3.8.1.26.9" class="ltx_td ltx_align_center ltx_border_bb ltx_border_r ltx_border_t" style="padding:0.9pt 3.0pt;"><span id="S6.T3.8.1.26.9.1" class="ltx_text" style="font-size:90%;">18.7</span></td>
