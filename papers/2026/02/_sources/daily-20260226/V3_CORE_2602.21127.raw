<td id="S5.T7.2.1.19.1" class="ltx_td ltx_align_left ltx_border_t" style="padding:-0.75pt 12.0pt;" rowspan="2"><span id="S5.T7.2.1.19.1.1" class="ltx_text ltx_font_bold">Init Vigilance</span></td>
