<td id="S3.T1.2.1.4.1" class="ltx_td ltx_align_left" style="padding-left:3.0pt;padding-right:3.0pt;"><span id="S3.T1.2.1.4.1.1" class="ltx_text" style="--ltx-bg-color:#ECECEC;">DoctorAgent</span></td>
<td id="S3.T1.2.1.4.2" class="ltx_td ltx_align_left" style="padding-left:3.0pt;padding-right:3.0pt;"><span id="S3.T1.2.1.4.2.1" class="ltx_text" style="--ltx-bg-color:#ECECEC;">Perception</span></td>
<td id="S3.T1.2.1.4.3" class="ltx_td ltx_align_left" style="padding-left:3.0pt;padding-right:3.0pt;"><span id="S3.T1.2.1.4.3.1" class="ltx_text" style="--ltx-bg-color:#ECECEC;">Indirect Prompt Injection</span></td>
<td id="S3.T1.2.1.4.4" class="ltx_td ltx_align_left" style="padding-left:3.0pt;padding-right:3.0pt;"><span id="S3.T1.2.1.4.4.1" class="ltx_text" style="--ltx-bg-color:#ECECEC;">Generate a medical report</span></td>
<td id="S3.T1.2.1.4.5" class="ltx_td ltx_nopad_r ltx_align_left" style="padding-left:3.0pt;padding-right:3.0pt;"><span id="S3.T1.2.1.4.5.1" class="ltx_text" style="--ltx-bg-color:#ECECEC;">Skewed diagnosis due to tampered questionnaire</span></td></tr>
<tr id="S3.T1.2.1.5" class="ltx_tr">
