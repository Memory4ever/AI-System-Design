<td id="S5.T8.4.1.1.2" class="ltx_td ltx_align_center ltx_border_tt" style="padding:-0.5pt 2.0pt;" colspan="3"><span id="S5.T8.4.1.1.2.1" class="ltx_text ltx_font_bold">Pleasantness</span> <math id="S5.T8.m1" class="ltx_Math" alttext="\uparrow" display="inline" intent=":literal"><semantics><mo stretchy="false">↑</mo><annotation encoding="application/x-tex">\uparrow</annotation></semantics></math></td>
