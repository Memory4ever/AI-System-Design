<td id="S5.T7.2.1.20.1" class="ltx_td ltx_align_left" style="padding:-0.75pt 12.0pt;">High Frequency (<math id="S5.T7.m17" class="ltx_Math" alttext="\geq" display="inline" intent=":literal"><semantics><mo>≥</mo><annotation encoding="application/x-tex">\geq</annotation></semantics></math>4)</td>
