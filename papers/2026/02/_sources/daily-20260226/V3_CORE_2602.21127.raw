<td id="S5.T7.2.1.21.3" class="ltx_td ltx_align_center ltx_border_t" style="padding:-0.75pt 12.0pt;"><span id="S5.T7.2.1.21.3.1" class="ltx_text ltx_font_bold">8.89</span></td>
<td id="S5.T7.2.1.21.4" class="ltx_td ltx_align_center ltx_border_bb ltx_border_t" style="padding:-0.75pt 12.0pt;" rowspan="2"><span id="S5.T7.2.1.21.4.1" class="ltx_text">.9157</span></td></tr>
<tr id="S5.T7.2.1.22" class="ltx_tr">
