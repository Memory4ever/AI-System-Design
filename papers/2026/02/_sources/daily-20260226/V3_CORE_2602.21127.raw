<td id="S5.T8.4.1.2.3" class="ltx_td ltx_align_center ltx_border_t" style="padding:-0.5pt 2.0pt;"><span id="S5.T8.4.1.2.3.1" class="ltx_text ltx_font_italic">p</span>-value</td>
<td id="S5.T8.4.1.2.4" class="ltx_td ltx_align_center ltx_border_t" style="padding:-0.5pt 2.0pt;">Trust+<sup id="S5.T8.4.1.2.4.1" class="ltx_sup"><math id="S5.T8.m3" class="ltx_Math" alttext="\natural" display="inline" intent=":literal"><semantics><mi mathvariant="normal">♮</mi><annotation encoding="application/x-tex">\natural</annotation></semantics></math></sup></td>
<td id="S5.T8.4.1.2.5" class="ltx_td ltx_align_center ltx_border_t" style="padding:-0.5pt 2.0pt;">Trust–</td>
<td id="S5.T8.4.1.2.6" class="ltx_td ltx_align_center ltx_border_t" style="padding:-0.5pt 2.0pt;"><span id="S5.T8.4.1.2.6.1" class="ltx_text ltx_font_italic">p</span>-value</td></tr>
<tr id="S5.T8.4.1.3" class="ltx_tr">
<td id="S5.T8.4.1.3.1" class="ltx_td ltx_align_left ltx_border_t" style="padding:-0.5pt 2.0pt;">Guard 1</td>
<td id="S5.T8.4.1.3.2" class="ltx_td ltx_align_center ltx_border_t" style="padding:-0.5pt 2.0pt;">3.86<math id="S5.T8.m4" class="ltx_Math" alttext="\pm" display="inline" intent=":literal"><semantics><mo>±</mo><annotation encoding="application/x-tex">\pm</annotation></semantics></math>0.83</td>
<td id="S5.T8.4.1.3.3" class="ltx_td ltx_align_center ltx_border_t" style="padding:-0.5pt 2.0pt;">4.12<math id="S5.T8.m5" class="ltx_Math" alttext="\pm" display="inline" intent=":literal"><semantics><mo>±</mo><annotation encoding="application/x-tex">\pm</annotation></semantics></math>0.97</td>
<td id="S5.T8.4.1.3.4" class="ltx_td ltx_align_center ltx_border_t" style="padding:-0.5pt 2.0pt;">0.117</td>
<td id="S5.T8.4.1.3.5" class="ltx_td ltx_align_center ltx_border_t" style="padding:-0.5pt 2.0pt;">4.43<math id="S5.T8.m6" class="ltx_Math" alttext="\pm" display="inline" intent=":literal"><semantics><mo>±</mo><annotation encoding="application/x-tex">\pm</annotation></semantics></math>0.65</td>
<td id="S5.T8.4.1.3.6" class="ltx_td ltx_align_center ltx_border_t" style="padding:-0.5pt 2.0pt;">4.03<math id="S5.T8.m7" class="ltx_Math" alttext="\pm" display="inline" intent=":literal"><semantics><mo>±</mo><annotation encoding="application/x-tex">\pm</annotation></semantics></math>1.10</td>
