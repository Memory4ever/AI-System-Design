<td id="S3.T1.2.1.2.3" class="ltx_td ltx_align_left ltx_border_t" style="padding-left:3.0pt;padding-right:3.0pt;"><span id="S3.T1.2.1.2.3.1" class="ltx_text" style="--ltx-bg-color:#ECECEC;">Indirect Prompt Injection</span></td>
