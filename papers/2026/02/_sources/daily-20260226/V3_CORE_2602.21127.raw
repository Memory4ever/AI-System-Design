<td id="S5.T6.2.1.3.7" class="ltx_td ltx_align_left ltx_border_t" style="padding:-1pt 4.0pt;"><math id="S5.T6.m3" class="ltx_Math" style="--ltx-bg-color:#ECECEC;" alttext="61.7" display="inline" intent=":literal"><semantics><mn style="--ltx-bg-color:#ECECEC;" mathbackground="#ECECEC">61.7</mn><annotation encoding="application/x-tex">61.7</annotation></semantics></math></td></tr>
