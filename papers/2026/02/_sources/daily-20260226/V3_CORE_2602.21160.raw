<th id="A2.T5.2.1.1.2" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt"><math id="A2.T5.m1" class="ltx_Math" alttext="\sum_{k}C_{k}" display="inline" intent=":literal"><semantics><mrow><msub><mo>∑</mo><mi>k</mi></msub><msub><mi>C</mi><mi>k</mi></msub></mrow><annotation encoding="application/x-tex">\sum_{k}C_{k}</annotation></semantics></math> (ours)</th>
