<td id="A4.T14.2.4.2" class="ltx_td ltx_align_center"><math id="A4.T14.m12" class="ltx_Math" alttext="0.390\pm 0.029" display="inline" intent=":literal"><semantics><mrow><mn mathsize="0.900em">0.390</mn><mo mathsize="0.900em">±</mo><mn mathsize="0.900em">0.029</mn></mrow><annotation encoding="application/x-tex">0.390\pm 0.029</annotation></semantics></math></td>
<td id="A4.T14.2.4.3" class="ltx_td ltx_align_center"><math id="A4.T14.m13" class="ltx_Math" alttext="0.314\pm 0.016" display="inline" intent=":literal"><semantics><mrow><mn mathsize="0.900em">0.314</mn><mo mathsize="0.900em">±</mo><mn mathsize="0.900em">0.016</mn></mrow><annotation encoding="application/x-tex">0.314\pm 0.016</annotation></semantics></math></td></tr>
<tr id="A4.T14.2.5" class="ltx_tr">
