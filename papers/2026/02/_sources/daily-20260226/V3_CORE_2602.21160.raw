<math id="A4.T14.m3" class="ltx_Math" alttext="80\%" display="inline" intent=":literal"><semantics><mrow><mn>80</mn><mo>%</mo></mrow><annotation encoding="application/x-tex">80\%</annotation></semantics></math> coverage (<math id="A4.T14.m4" class="ltx_Math" alttext="\downarrow" display="inline" intent=":literal"><semantics><mo stretchy="false">↓</mo><annotation encoding="application/x-tex">\downarrow</annotation></semantics></math> better); 200 bootstrap resamples.</figcaption>
