<td id="A4.T8.2.1.11.5" class="ltx_td ltx_align_center ltx_border_bb"><math id="A4.T8.m39" class="ltx_Math" alttext="0.843\pm 0.005" display="inline" intent=":literal"><semantics><mrow><mn>0.843</mn><mo>±</mo><mn>0.005</mn></mrow><annotation encoding="application/x-tex">0.843\pm 0.005</annotation></semantics></math></td>
<td id="A4.T8.2.1.11.6" class="ltx_td ltx_align_center ltx_border_bb">0.0</td></tr>
