<span id="S3.T1.2.9.1.1.1.2" class="ltx_p">(proposed)</span>
</span></span></td>
<td id="S3.T1.2.9.2" class="ltx_td ltx_align_left ltx_border_t" style="padding-left:4.0pt;padding-right:4.0pt;"><math id="S3.T1.m15" class="ltx_Math" alttext="C_{\text{crit\_sum}}" display="inline" intent=":literal"><semantics><msub><mi mathsize="0.800em">C</mi><mtext mathsize="0.800em">crit_sum</mtext></msub><annotation encoding="application/x-tex">C_{\text{crit\_sum}}</annotation></semantics></math></td>
