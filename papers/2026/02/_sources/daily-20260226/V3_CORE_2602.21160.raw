<td id="A4.T14.2.2.3" class="ltx_td ltx_align_center ltx_border_t"><math id="A4.T14.m8" class="ltx_Math" alttext="0.362\pm 0.017" display="inline" intent=":literal"><semantics><mrow><mn mathsize="0.900em">0.362</mn><mo mathsize="0.900em">±</mo><mn mathsize="0.900em">0.017</mn></mrow><annotation encoding="application/x-tex">0.362\pm 0.017</annotation></semantics></math></td></tr>
<tr id="A4.T14.2.3" class="ltx_tr">
