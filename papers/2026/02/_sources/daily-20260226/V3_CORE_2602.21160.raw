<td id="A4.T14.2.5.2" class="ltx_td ltx_align_center"><math id="A4.T14.m15" class="ltx_Math" alttext="0.406\pm 0.029" display="inline" intent=":literal"><semantics><mrow><mn mathsize="0.900em">0.406</mn><mo mathsize="0.900em">±</mo><mn mathsize="0.900em">0.029</mn></mrow><annotation encoding="application/x-tex">0.406\pm 0.029</annotation></semantics></math></td>
<td id="A4.T14.2.5.3" class="ltx_td ltx_align_center"><math id="A4.T14.m16" class="ltx_Math" alttext="0.333\pm 0.016" display="inline" intent=":literal"><semantics><mrow><mn mathsize="0.900em">0.333</mn><mo mathsize="0.900em">±</mo><mn mathsize="0.900em">0.016</mn></mrow><annotation encoding="application/x-tex">0.333\pm 0.016</annotation></semantics></math></td></tr>
