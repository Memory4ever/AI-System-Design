<td id="A5.T15.2.9.2" class="ltx_td ltx_align_center">None</td>
<td id="A5.T15.2.9.3" class="ltx_td ltx_align_center"><math id="A5.T15.m6" class="ltx_Math" alttext="w_{0}{=}1,\;w_{1}{=}1/\text{pos\_frac}\approx 11.9" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>w</mi><mn>0</mn></msub><mo>=</mo><mn>1</mn></mrow><mo rspace="0.447em">,</mo><mrow><msub><mi>w</mi><mn>1</mn></msub><mo>=</mo><mrow><mn>1</mn><mo>/</mo><mtext>pos_frac</mtext></mrow><mo>≈</mo><mn>11.9</mn></mrow></mrow><annotation encoding="application/x-tex">w_{0}{=}1,\;w_{1}{=}1/\text{pos\_frac}\approx 11.9</annotation></semantics></math></td></tr>
<tr id="A5.T15.2.10" class="ltx_tr">
