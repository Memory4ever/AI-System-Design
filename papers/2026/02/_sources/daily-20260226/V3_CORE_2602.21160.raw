<td id="A4.T14.2.3.2" class="ltx_td ltx_align_center"><math id="A4.T14.m9" class="ltx_Math" alttext="0.447\pm 0.031" display="inline" intent=":literal"><semantics><mrow><mn mathsize="0.900em">0.447</mn><mo mathsize="0.900em">±</mo><mn mathsize="0.900em">0.031</mn></mrow><annotation encoding="application/x-tex">0.447\pm 0.031</annotation></semantics></math></td>
<td id="A4.T14.2.3.3" class="ltx_td ltx_align_center"><math id="A4.T14.m10" class="ltx_Math" alttext="0.414\pm 0.018" display="inline" intent=":literal"><semantics><mrow><mn mathsize="0.900em">0.414</mn><mo mathsize="0.900em">±</mo><mn mathsize="0.900em">0.018</mn></mrow><annotation encoding="application/x-tex">0.414\pm 0.018</annotation></semantics></math></td></tr>
<tr id="A4.T14.2.4" class="ltx_tr">
