<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S4.E28Xe.m2" class="ltx_Math" alttext="\displaystyle+3C_{v}^{2}L_{\nabla^{2}f}^{2}\mathbb{E}\left[\left\|\tilde{y}_{i-1}^{(t)}-y_{i-1}^{(t)}\right\|^{4}\right]+3\mathbb{E}\left[\left\|\mathbb{E}_{t}^{\mathcal{H}_{i+1}}[\varepsilon_{i+1}^{(t)}]\right\|^{2}\right]" display="inline" intent=":literal"><semantics><mrow><mrow><mo>+</mo><mrow><mn>3</mn><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>C</mi><mi>v</mi><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>L</mi><mrow><msup><mo>∇</mo><mn>2</mn></msup><mi>f</mi></mrow><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>𝔼</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><msup><mrow><mo>‖</mo><mrow><msubsup><mover accent="true"><mi>y</mi><mo>~</mo></mover><mrow><mi>i</mi><mo>−</mo><mn>1</mn></mrow><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msubsup><mo>−</mo><msubsup><mi>y</mi><mrow><mi>i</mi><mo>−</mo><mn>1</mn></mrow><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msubsup></mrow><mo>‖</mo></mrow><mn>4</mn></msup><mo>]</mo></mrow></mrow></mrow><mo>+</mo><mrow><mn>3</mn><mo lspace="0em" rspace="0em">​</mo><mi>𝔼</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><msup><mrow><mo>‖</mo><mrow><msubsup><mi>𝔼</mi><mi>t</mi><msub><mi class="ltx_font_mathcaligraphic">ℋ</mi><mrow><mi>i</mi><mo>+</mo><mn>1</mn></mrow></msub></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><msubsup><mi>ε</mi><mrow><mi>i</mi><mo>+</mo><mn>1</mn></mrow><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msubsup><mo stretchy="false">]</mo></mrow></mrow><mo>‖</mo></mrow><mn>2</mn></msup><mo>]</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle+3C_{v}^{2}L_{\nabla^{2}f}^{2}\mathbb{E}\left[\left\|\tilde{y}_{i-1}^{(t)}-y_{i-1}^{(t)}\right\|^{4}\right]+3\mathbb{E}\left[\left\|\mathbb{E}_{t}^{\mathcal{H}_{i+1}}[\varepsilon_{i+1}^{(t)}]\right\|^{2}\right]</annotation></semantics></math></td>
