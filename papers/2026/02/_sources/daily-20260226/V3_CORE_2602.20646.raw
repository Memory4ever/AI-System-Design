w><mn>4</mn></msup><mo>]</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle 2C_{\nabla^{2}f}^{2}\left\|\mathbb{E}^{\mathcal{G}_{i-1}}_{t}[\tilde{y}_{i-1}^{(t)}-{y}_{i-1}^{(t)}]\right\|^{2}+L_{\nabla^{2}f}^{2}\mathbb{E}^{\mathcal{G}_{i-1}}_{t}\left[\left\|\tilde{y}_{i-1}^{(t)}-{y}_{i-1}^{(t)}\right\|^{4}\right].</annotation></semantics></math></td>
