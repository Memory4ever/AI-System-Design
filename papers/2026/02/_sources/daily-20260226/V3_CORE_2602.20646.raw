<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S4.E31Xb.m2" class="ltx_Math" alttext="\displaystyle+2\sum_{i=1}^{N-1}\left[\sum_{j=1}^{i}(3C_{\nabla f}^{2})^{j}\right]\mathbb{E}\left[\left\|\mathbb{E}_{t}^{\mathcal{H}_{i+1}}[\varepsilon_{i+1}^{(t)}]\right\|^{2}\right]." display="inline" intent=":literal"><semantics><mrow><mo>+</mo><mn>2</mn><mstyle displaystyle="true"><mo movablelimits="false">∑</mo></mstyle><msub><mrow></mrow><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow></msub><msup><mrow></mrow><mrow><mi>N</mi><mo>−</mo><mn>1</mn></mrow></msup><mo>[</mo><mstyle displaystyle="true"><mo movablelimits="false">∑</mo></mstyle><msub><mrow></mrow><mrow><mi>j</mi><mo>=</mo><mn>1</mn></mrow></msub><msup><mrow></mrow><mi>i</mi></msup><mo stretchy="false">(</mo><mn>3</mn><mi>C</mi><msub><mrow></mrow><mrow><mo rspace="0.167em">∇</mo><mi>f</mi></mrow></msub><msup><mrow></mrow><mn>2</mn></msup><mo stretchy="false">)</mo><msup><mrow></mrow><mi>j</mi></msup><mo>]</mo><mi>𝔼</mi><mo>[</mo><mo>‖</mo><mi>𝔼</mi><msub><mrow></mrow><mi>t</mi></msub><msup><mrow></mrow><msub><mi class="ltx_font_mathcaligraphic">ℋ</mi><mrow><mi>i</mi><mo>+</mo><mn>1</mn></mrow></msub></msup><mo stretchy="false">[</mo><mi>ε</mi><msub><mrow></mrow><mrow><mi>i</mi><mo>+</mo><mn>1</mn></mrow></msub><msup><mrow></mrow><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">]</mo><mo>‖</mo><msup><mrow></mrow><mn>2</mn></msup><mo>]</mo><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle+2\sum_{i=1}^{N-1}\left[\sum_{j=1}^{i}(3C_{\nabla f}^{2})^{j}\right]\mathbb{E}\left[\left\|\mathbb{E}_{t}^{\mathcal{H}_{i+1}}[\varepsilon_{i+1}^{(t)}]\right\|^{2}\right].</annotation></semantics></math></td>
