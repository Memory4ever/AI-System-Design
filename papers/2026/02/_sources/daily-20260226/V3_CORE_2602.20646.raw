<tr id="S4.E28Xf" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S4.E28Xf.m2" class="ltx_Math" alttext="\displaystyle\leq" display="inline" intent=":literal"><semantics><mo>≤</mo><annotation encoding="application/x-tex">\displaystyle\leq</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S4.E28Xf.m3" class="ltx_Math" alttext="\displaystyle\cdots\leq 6C_{v}^{2}C_{\nabla^{2}f}^{2}\sum_{j=i}^{N-1}(3C_{\nabla f}^{2})^{j-i}\mathbb{E}\left[\left\|\mathbb{E}^{\mathcal{G}_{j}}_{t}[\tilde{y}_{j}^{(t)}-y_{j}^{(t)}]\right\|^{2}\right]" display="inline" intent=":literal"><semantics><mrow><mo rspace="0.1389em">⋯</mo><mo lspace="0.1389em">≤</mo><mrow><mn>6</mn><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>C</mi><mi>v</mi><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>C</mi><mrow><msup><mo>∇</mo><mn>2</mn></msup><mi>f</mi></mrow><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>j</mi><mo>=</mo><mi>i</mi></mrow><mrow><mi>N</mi><mo>−</mo><mn>1</mn></mrow></munderover></mstyle><mrow><msup><mrow><mo stretchy="false">(</mo><mrow><mn>3</mn><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>C</mi><mrow><mo rspace="0.167em">∇</mo><mi>f</mi></mrow><mn>2</mn></msubsup></mrow><mo stretchy="false">)</mo></mrow><mrow><mi>j</mi><mo>−</mo><mi>i</mi></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mi>𝔼</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><msup><mrow><mo>‖</mo><mrow><msubsup><mi>𝔼</mi><mi>t</mi><msub><mi class="ltx_font_mathcaligraphic">𝒢</mi><mi>j</mi></msub></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mrow><msubsup><mover accent="true"><mi>y</mi><mo>~</mo></mover><mi>j</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msubsup><mo>−</mo><msubsup><mi>y</mi><mi>j</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msubsup></mrow><mo stretchy="false">]</mo></mrow></mrow><mo>‖</mo></mrow><mn>2</mn></msup><mo>]</mo></mrow></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\cdots\leq 6C_{v}^{2}C_{\nabla^{2}f}^{2}\sum_{j=i}^{N-1}(3C_{\nabla f}^{2})^{j-i}\mathbb{E}\left[\left\|\mathbb{E}^{\mathcal{G}_{j}}_{t}[\tilde{y}_{j}^{(t)}-y_{j}^{(t)}]\right\|^{2}\right]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr>
<tr id="S4.E28Xg" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S4.E28Xg.m2" class="ltx_Math" alttext="\displaystyle+\hskip-1.42262pt3\hskip-2.84526pt\sum_{j=i}^{N-1}\hskip-1.42262pt(3C_{\nabla f}^{2})^{j-i}\mathbb{E}\hskip-1.42262pt\left[\left\|\mathbb{E}_{t}^{\mathcal{H}_{j+1}}[\varepsilon_{j+1}^{(t)}]\right\|^{2}\right]\hskip-2.84526pt+\hskip-1.42262pt3C_{v}^{2}L_{\nabla^{2}f}^{2}\hskip-2.84526pt\sum_{j=i}^{N-1}\hskip-1.42262pt(3C_{\nabla f}^{2})^{j-i}\mathbb{E}\hskip-1.42262pt\left[\left\|\tilde{y}_{j}^{(t)}\hskip-2.84526pt-\hskip-1.42262pty_{j}^{(t)}\right\|^{4}\hskip-1.42262pt\right]\hskip-2.84526pt." display="inline" intent=":literal"><semantics><mrow><mo>+</mo><mn>3</mn><mstyle displaystyle="true"><mo movablelimits="false">∑</mo></mstyle><msub><mrow></mrow><mrow><mi>j</mi><mo>=</mo><mi>i</mi></mrow></msub><msup><mrow></mrow><mrow><mi>N</mi><mo>−</mo><mn>1</mn></mrow></msup><mo stretchy="false">(</mo><mn>3</mn><mi>C</mi><msub><mrow></mrow><mrow><mo rspace="0.167em">∇</mo><mi>f</mi></mrow></msub><msup><mrow></mrow><mn>2</mn></msup><mo stretchy="false">)</mo><msup><mrow></mrow><mrow><mi>j</mi><mo>−</mo><mi>i</mi></mrow></msup><mi>𝔼</mi><mo>[</mo><mo>‖</mo><mi>𝔼</mi><msub><mrow></mrow><mi>t</mi></msub><msup><mrow></mrow><msub><mi class="ltx_font_mathcaligraphic">ℋ</mi><mrow><mi>j</mi><mo>+</mo><mn>1</mn></mrow></msub></msup><mo stretchy="false">[</mo><mi>ε</mi><msub><mrow></mrow><mrow><mi>j</mi><mo>+</mo><mn>1</mn></mrow></msub><msup><mrow></mrow><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">]</mo><mo>‖</mo><msup><mrow></mrow><mn>2</mn></msup><mo>]</mo><mo>+</mo><mn>3</mn><mi>C</mi><msub><mrow></mrow><mi>v</mi></msub><msup><mrow></mrow><mn>2</mn></msup><mi>L</mi><msub><mrow></mrow><mrow><msup><mo>∇</mo><mn>2</mn></msup><mi>f</mi></mrow></msub><msup><mrow></mrow><mn>2</mn></msup><mstyle displaystyle="true"><mo movablelimits="false">∑</mo></mstyle><msub><mrow></mrow><mrow><mi>j</mi><mo>=</mo><mi>i</mi></mrow></msub><msup><mrow></mrow><mrow><mi>N</mi><mo>−</mo><mn>1</mn></mrow></msup><mo stretchy="false">(</mo><mn>3</mn><mi>C</mi><msub><mrow></mrow><mrow><mo rspace="0.167em">∇</mo><mi>f</mi></mrow></msub><msup><mrow></mrow><mn>2</mn></msup><mo stretchy="false">)</mo><msup><mrow></mrow><mrow><mi>j</mi><mo>−</mo><mi>i</mi></mrow></msup><mi>𝔼</mi><mo>[</mo><mo>‖</mo><mover accent="true"><mi>y</mi><mo>~</mo></mover><msub><mrow></mrow><mi>j</mi></msub><msup><mrow></mrow><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo>−</mo><mi>y</mi><msub><mrow></mrow><mi>j</mi></msub><msup><mrow></mrow><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo>‖</mo><msup><mrow></mrow><mn>4</mn></msup><mo>]</mo><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle+\hskip-1.42262pt3\hskip-2.84526pt\sum_{j=i}^{N-1}\hskip-1.42262pt(3C_{\nabla f}^{2})^{j-i}\mathbb{E}\hskip-1.42262pt\left[\left\|\mathbb{E}_{t}^{\mathcal{H}_{j+1}}[\varepsilon_{j+1}^{(t)}]\right\|^{2}\right]\hskip-2.84526pt+\hskip-1.42262pt3C_{v}^{2}L_{\nabla^{2}f}^{2}\hskip-2.84526pt\sum_{j=i}^{N-1}\hskip-1.42262pt(3C_{\nabla f}^{2})^{j-i}\mathbb{E}\hskip-1.42262pt\left[\left\|\tilde{y}_{j}^{(t)}\hskip-2.84526pt-\hskip-1.42262pty_{j}^{(t)}\right\|^{4}\hskip-1.42262pt\right]\hskip-2.84526pt.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="Thmtheorem2.p2.15" class="ltx_p"><span id="Thmtheorem2.p2.15.1" class="ltx_text">Next, we bound <math id="Thmtheorem2.p2.m9" class="ltx_Math" alttext="\mathbb{E}^{\mathcal{G}_{i}}_{t}[\tilde{y}_{i}^{(t)}-y_{i}^{(t)}]" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>𝔼</mi><mi>t</mi><msub><mi class="ltx_font_mathcaligraphic">𝒢</mi><mi>i</mi></msub></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mrow><msubsup><mover accent="true"><mi>y</mi><mo>~</mo></mover><mi>i</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msubsup><mo>−</mo><msubsup><mi>y</mi><mi>i</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msubsup></mrow><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">\mathbb{E}^{\mathcal{G}_{i}}_{t}[\tilde{y}_{i}^{(t)}-y_{i}^{(t)}]</annotation></semantics></math> for <math id="Thmtheorem2.p2.m10" class="ltx_Math" alttext="i=2,\ldots,N-1" display="inline" intent=":literal"><semantics><mrow><mrow><mi>i</mi><mo>=</mo><mn>2</mn></mrow><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mrow><mi>N</mi><mo>−</mo><mn>1</mn></mrow></mrow><annotation encoding="application/x-tex">i=2,\ldots,N-1</annotation></semantics></math>:</span></p>
<table id="S4.E29" class="ltx_equationgroup ltx_eqn_table">
<tbody>
<tr id="S4.E29X" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S4.E29X.m2" class="ltx_Math" alttext="\displaystyle\mathbb{E}\left[\left\|\mathbb{E}^{\mathcal{G}_{i}}_{t}[\tilde{y}_{i}^{(t)}-y_{i}^{(t)}]\right\|^{2}\right]=\mathbb{E}\left[\left\|\mathbb{E}^{\mathcal{G}_{i}}_{t}\left[f_{i}(\tilde{y}_{i-1}^{(t)},w_{i}^{(t)})-f_{i}(y_{i-1}^{(t)},w_{i}^{(t)})+\delta_{i}^{(t)}\right]\right\|^{2}\right]" display="inline" intent=":literal"><semantics><mrow><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><msup><mrow><mo>‖</mo><mrow><msubsup><mi>𝔼</mi><mi>t</mi><msub><mi class="ltx_font_mathcaligraphic">𝒢</mi><mi>i</mi></msub></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mrow><msubsup><mover accent="true"><mi>y</mi><mo>~</mo></mover><mi>i</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msubsup><mo>−</mo><msubsup><mi>y</mi><mi>i</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msubsup></mrow><mo stretchy="false">]</mo></mrow></mrow><mo>‖</mo></mrow><mn>2</mn></msup><mo>]</mo></mrow></mrow><mo>=</mo><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><msup><mrow><mo>‖</mo><mrow><msubsup><mi>𝔼</mi><mi>t</mi><msub><mi class="ltx_font_mathcaligraphic">𝒢</mi><mi>i</mi></msub></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><mrow><mrow><mrow><msub><mi>f</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msubsup><mover accent="true"><mi>y</mi><mo>~</mo></mover><mrow><mi>i</mi><mo>−</mo><mn>1</mn></mrow><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msubsup><mo>,</mo><msubsup><mi>w</mi><mi>i</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msubsup><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msub><mi>f</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>y</mi><mrow><mi>i</mi><mo>−</mo><mn>1</mn></mrow><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msubsup><mo>,</mo><msubsup><mi>w</mi><mi>i</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msubsup><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>+</mo><msubsup><mi>δ</mi><mi>i</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msubsup></mrow><mo>]</mo></mrow></mrow><mo>‖</mo></mrow><mn>2</mn></msup><mo>]</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\mathbb{E}\left[\left\|\mathbb{E}^{\mathcal{G}_{i}}_{t}[\tilde{y}_{i}^{(t)}-y_{i}^{(t)}]\right\|^{2}\right]=\mathbb{E}\left[\left\|\mathbb{E}^{\mathcal{G}_{i}}_{t}\left[f_{i}(\tilde{y}_{i-1}^{(t)},w_{i}^{(t)})-f_{i}(y_{i-1}^{(t)},w_{i}^{(t)})+\delta_{i}^{(t)}\right]\right\|^{2}\right]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="4" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equationgroup ltx_align_right">(29)</span></td></tr>
<tr id="S4.E29Xa" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S4.E29Xa.m2" class="ltx_Math" alttext="\displaystyle\leq" display="inline" intent=":literal"><semantics><mo>≤</mo><annotation encoding="application/x-tex">\displaystyle\leq</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S4.E29Xa.m3" class="ltx_Math" alttext="\displaystyle 2\mathbb{E}\left[\left\|\mathbb{E}^{\mathcal{G}_{i}}_{t}\left[f_{i}(\tilde{y}_{i-1}^{(t)},w_{i}^{(t)})-f_{i}(y_{i-1}^{(t)},w_{i}^{(t)})\right]\right\|^{2}\right]+2\mathbb{E}\left[\left\|\mathbb{E}^{\mathcal{G}_{i}}_{t}[\delta_{i}^{(t)}]\right\|^{2}\right]" display="inline" intent=":literal"><semantics><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>𝔼</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><msup><mrow><mo>‖</mo><mrow><msubsup><mi>𝔼</mi><mi>t</mi><msub><mi class="ltx_font_mathcaligraphic">𝒢</mi><mi>i</mi></msub></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><mrow><mrow><msub><mi>f</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msubsup><mover accent="true"><mi>y</mi><mo>~</mo></mover><mrow><mi>i</mi><mo>−</mo><mn>1</mn></mrow><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msubsup><mo>,</mo><msubsup><mi>w</mi><mi>i</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msubsup><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msub><mi>f</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>y</mi><mrow><mi>i</mi><mo>−</mo><mn>1</mn></mrow><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msubsup><mo>,</mo><msubsup><mi>w</mi><mi>i</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msubsup><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>]</mo></mrow></mrow><mo>‖</mo></mrow><mn>2</mn></msup><mo>]</mo></mrow></mrow><mo>+</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>𝔼</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><msup><mrow><mo>‖</mo><mrow><msubsup><mi>𝔼</mi><mi>t</mi><msub><mi class="ltx_font_mathcaligraphic">𝒢</mi><mi>i</mi></msub></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><msubsup><mi>δ</mi><mi>i</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msubsup><mo stretchy="false">]</mo></mrow></mrow><mo>‖</mo></mrow><mn>2</mn></msup><mo>]</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle 2\mathbb{E}\left[\left\|\mathbb{E}^{\mathcal{G}_{i}}_{t}\left[f_{i}(\tilde{y}_{i-1}^{(t)},w_{i}^{(t)})-f_{i}(y_{i-1}^{(t)},w_{i}^{(t)})\right]\right\|^{2}\right]+2\mathbb{E}\left[\left\|\mathbb{E}^{\mathcal{G}_{i}}_{t}[\delta_{i}^{(t)}]\right\|^{2}\right]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr>
<tr id="S4.E29Xb" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S4.E29Xb.m2" class="ltx_Math" alttext="\displaystyle\leq" display="inline" intent=":literal"><semantics><mo>≤</mo><annotation encoding="application/x-tex">\displaystyle\leq</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S4.E29Xb.m3" class="ltx_Math" alttext="\displaystyle 4C_{\nabla f}^{2}\left\|\mathbb{E}_{t}^{\mathcal{G}_{i-1}}[\tilde{y}_{i-1}^{(t)}-y_{i-1}^{(t)}]\right\|^{2}+2L_{\nabla f}^{2}\mathbb{E}\left[\left\|\tilde{y}_{i-1}^{(t)}-y_{i-1}^{(t)}\right\|^{4}\right]+2\mathbb{E}\left[\left\|\mathbb{E}^{\mathcal{G}_{i}}_{t}[\delta_{i}^{(t)}]\right\|^{2}\right]" display="inline" intent=":literal"><semantics><mrow><mrow><mn>4</mn><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>C</mi><mrow><mo rspace="0.167em">∇</mo><mi>f</mi></mrow><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo>‖</mo><mrow><msubsup><mi>𝔼</mi><mi>t</mi><msub><mi class="ltx_font_mathcaligraphic">𝒢</mi><mrow><mi>i</mi><mo>−</mo><mn>1</mn></mrow></msub></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mrow><msubsup><mover accent="true"><mi>y</mi><mo>~</mo></mover><mrow><mi>i</mi><mo>−</mo><mn>1</mn></mrow><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msubsup><mo>−</mo><msubsup><mi>y</mi><mrow><mi>i</mi><mo>−</mo><mn>1</mn></mrow><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msubsup></mrow><mo stretchy="false">]</mo></mrow></mrow><mo>‖</mo></mrow><mn>2</mn></msup></mrow><mo>+</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>L</mi><mrow><mo rspace="0.167em">∇</mo><mi>f</mi></mrow><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>𝔼</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><msup><mrow><mo>‖</mo><mrow><msubsup><mover accent="true"><mi>y</mi><mo>~</mo></mover><mrow><mi>i</mi><mo>−</mo><mn>1</mn></mrow><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msubsup><mo>−</mo><msubsup><mi>y</mi><mrow><mi>i</mi><mo>−</mo><mn>1</mn></mrow><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msubsup></mrow><mo>‖</mo></mrow><mn>4</mn></msup><mo>]</mo></mrow></mrow><mo>+</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>𝔼</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><msup><mrow><mo>‖</mo><mrow><msubsup><mi>𝔼</mi><mi>t</mi><msub><mi class="ltx_font_mathcaligraphic">𝒢</mi><mi>i</mi></msub></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><msubsup><mi>δ</mi><mi>i</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msubsup><mo stretchy="false">]</mo></mrow></mrow><mo>‖</mo></mrow><mn>2</mn></msup><mo>]</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle 4C_{\nabla f}^{2}\left\|\mathbb{E}_{t}^{\mathcal{G}_{i-1}}[\tilde{y}_{i-1}^{(t)}-y_{i-1}^{(t)}]\right\|^{2}+2L_{\nabla f}^{2}\mathbb{E}\left[\left\|\tilde{y}_{i-1}^{(t)}-y_{i-1}^{(t)}\right\|^{4}\right]+2\mathbb{E}\left[\left\|\mathbb{E}^{\mathcal{G}_{i}}_{t}[\delta_{i}^{(t)}]\right\|^{2}\right]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr>
<tr id="S4.E29Xc" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S4.E29Xc.m2" class="ltx_Math" alttext="\displaystyle\leq" display="inline" intent=":literal"><semantics><mo>≤</mo><annotation encoding="application/x-tex">\displaystyle\leq</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S4.E29Xc.m3" class="ltx_Math" alttext="\displaystyle 2L_{\nabla f}^{2}\sum_{j=1}^{i-1}(4C_{\nabla f}^{2})^{i-j-1}\mathbb{E}\left[\left\|\tilde{y}_{j}^{(t)}-y_{j}^{(t)}\right\|^{4}\right]+2\sum_{j=1}^{i}(4C_{\nabla f}^{2})^{i-j}\mathbb{E}\left[\left\|\mathbb{E}^{\mathcal{G}_{j}}_{t}[\delta_{j}^{(t)}]\right\|^{2}\right]," display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>L</mi><mrow><mo rspace="0.167em">∇</mo><mi>f</mi></mrow><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>j</mi><mo>=</mo><mn>1</mn></mrow><mrow><mi>i</mi><mo>−</mo><mn>1</mn></mrow></munderover></mstyle><mrow><msup><mrow><mo stretchy="false">(</mo><mrow><mn>4</mn><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>C</mi><mrow><mo rspace="0.167em">∇</mo><mi>f</mi></mrow><mn>2</mn></msubsup></mrow><mo stretchy="false">)</mo></mrow><mrow><mi>i</mi><mo>−</mo><mi>j</mi><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mi>𝔼</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><msup><mrow><mo>‖</mo><mrow><msubsup><mover accent="true"><mi>y</mi><mo>~</mo></mover><mi>j</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msubsup><mo>−</mo><msubsup><mi>y</mi><mi>j</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msubsup></mrow><mo>‖</mo></mrow><mn>4</mn></msup><mo>]</mo></mrow></mrow></mrow></mrow><mo>+</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>j</mi><mo>=</mo><mn>1</mn></mrow><mi>i</mi></munderover></mstyle><mrow><msup><mrow><mo stretchy="false">(</mo><mrow><mn>4</mn><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>C</mi><mrow><mo rspace="0.167em">∇</mo><mi>f</mi></mrow><mn>2</mn></msubsup></mrow><mo stretchy="false">)</mo></mrow><mrow><mi>i</mi><mo>−</mo><mi>j</mi></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mi>𝔼</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><msup><mrow><mo>‖</mo><mrow><msubsup><mi>𝔼</mi><mi>t</mi><msub><mi class="ltx_font_mathcaligraphic">𝒢</mi><mi>j</mi></msub></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><msubsup><mi>δ</mi><mi>j</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msubsup><mo stretchy="false">]</mo></mrow></mrow><mo>‖</mo></mrow><mn>2</mn></msup><mo>]</mo></mrow></mrow></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle 2L_{\nabla f}^{2}\sum_{j=1}^{i-1}(4C_{\nabla f}^{2})^{i-j-1}\mathbb{E}\left[\left\|\tilde{y}_{j}^{(t)}-y_{j}^{(t)}\right\|^{4}\right]+2\sum_{j=1}^{i}(4C_{\nabla f}^{2})^{i-j}\mathbb{E}\left[\left\|\mathbb{E}^{\mathcal{G}_{j}}_{t}[\delta_{j}^{(t)}]\right\|^{2}\right],</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="Thmtheorem2.p2.16" class="ltx_p"><span id="Thmtheorem2.p2.16.1" class="ltx_text">where the second inequality follows from Lemma <a href="#Thmlemma2" title="Lemma 2. ‣ 4 Error Propagation Analysis ‣ On the Convergence of Stochastic Gradient Descent with Perturbed Forward-Backward Passes" class="ltx_ref"><span class="ltx_text ltx_ref_tag">2</span></a> and the inclusion <math id="Thmtheorem2.p2.m11" class="ltx_Math" alttext="\mathcal{G}_{i-1}^{(t)}\subset\mathcal{G}_{i}^{(t)}" display="inline" intent=":literal"><semantics><mrow><msubsup><mi class="ltx_font_mathcaligraphic">𝒢</mi><mrow><mi>i</mi><mo>−</mo><mn>1</mn></mrow><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msubsup><mo>⊂</mo><msubsup><mi class="ltx_font_mathcaligraphic">𝒢</mi><mi>i</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msubsup></mrow><annotation encoding="application/x-tex">\mathcal{G}_{i-1}^{(t)}\subset\mathcal{G}_{i}^{(t)}</annotation></semantics></math>. Note that (<a href="#S4.E29" title="In Proof. ‣ Theorem 2. ‣ 4 Error Propagation Analysis ‣ On the Convergence of Stochastic Gradient Descent with Perturbed Forward-Backward Passes" class="ltx_ref"><span class="ltx_text ltx_ref_tag">29</span></a>) also holds for <math id="Thmtheorem2.p2.m12" class="ltx_Math" alttext="i=1" display="inline" intent=":literal"><semantics><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">i=1</annotation></semantics></math>. Finally, for <math id="Thmtheorem2.p2.m13" class="ltx_Math" alttext="i=1,2,\ldots,N-1" display="inline" intent=":literal"><semantics><mrow><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mo>,</mo><mn>2</mn><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mrow><mi>N</mi><mo>−</mo><mn>1</mn></mrow></mrow><annotation encoding="application/x-tex">i=1,2,\ldots,N-1</annotation></semantics></math>, we have</span></p>
<table id="S4.E30" class="ltx_equationgroup ltx_eqn_table">
<tbody>
<tr id="S4.E30X" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S4.E30X.m2" class="ltx_Math" alttext="\displaystyle\mathbb{E}\left[\left\|\tilde{y}_{i}^{(t)}-{y}_{i}^{(t)}\right\|^{4}\right]=\mathbb{E}\left[\left\|f_{i}(\tilde{y}_{i-1}^{(t)},w_{i}^{(t)})-f_{i}(y_{i-1}^{(t)},w_{i}^{(t)})+\delta_{i}^{(t)}\right\|^{4}\right]" display="inline" intent=":literal"><semantics><mrow><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><msup><mrow><mo>‖</mo><mrow><msubsup><mover accent="true"><mi>y</mi><mo>~</mo></mover><mi>i</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msubsup><mo>−</mo><msubsup><mi>y</mi><mi>i</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msubsup></mrow><mo>‖</mo></mrow><mn>4</mn></msup><mo>]</mo></mrow></mrow><mo>=</mo><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><msup><mrow><mo>‖</mo><mrow><mrow><mrow><msub><mi>f</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msubsup><mover accent="true"><mi>y</mi><mo>~</mo></mover><mrow><mi>i</mi><mo>−</mo><mn>1</mn></mrow><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msubsup><mo>,</mo><msubsup><mi>w</mi><mi>i</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msubsup><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msub><mi>f</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>y</mi><mrow><mi>i</mi><mo>−</mo><mn>1</mn></mrow><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msubsup><mo>,</mo><msubsup><mi>w</mi><mi>i</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msubsup><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>+</mo><msubsup><mi>δ</mi><mi>i</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msubsup></mrow><mo>‖</mo></mrow><mn>4</mn></msup><mo>]</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\mathbb{E}\left[\left\|\tilde{y}_{i}^{(t)}-{y}_{i}^{(t)}\right\|^{4}\right]=\mathbb{E}\left[\left\|f_{i}(\tilde{y}_{i-1}^{(t)},w_{i}^{(t)})-f_{i}(y_{i-1}^{(t)},w_{i}^{(t)})+\delta_{i}^{(t)}\right\|^{4}\right]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="2" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equationgroup ltx_align_right">(30)</span></td></tr>
<tr id="S4.E30Xa" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S4.E30Xa.m2" class="ltx_Math" alttext="\displaystyle\leq" display="inline" intent=":literal"><semantics><mo>≤</mo><annotation encoding="application/x-tex">\displaystyle\leq</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S4.E30Xa.m3" class="ltx_Math" alttext="\displaystyle 8L_{f}^{4}\mathbb{E}\left[\left\|\tilde{y}_{i-1}^{(t)}-{y}_{i-1}^{(t)}\right\|^{4}\right]+8\mathbb{E}\left[\left\|\delta_{i}^{(t)}\right\|^{4}\right]\leq\cdots\leq 8\sum_{j=1}^{i}(8L_{f}^{4})^{i-j}\mathbb{E}\left[\left\|\delta_{j}^{(t)}\right\|^{4}\right]." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mrow><mn>8</mn><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>L</mi><mi>f</mi><mn>4</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>𝔼</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><msup><mrow><mo>‖</mo><mrow><msubsup><mover accent="true"><mi>y</mi><mo>~</mo></mover><mrow><mi>i</mi><mo>−</mo><mn>1</mn></mrow><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msubsup><mo>−</mo><msubsup><mi>y</mi><mrow><mi>i</mi><mo>−</mo><mn>1</mn></mrow><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msubsup></mrow><mo>‖</mo></mrow><mn>4</mn></msup><mo>]</mo></mrow></mrow><mo>+</mo><mrow><mn>8</mn><mo lspace="0em" rspace="0em">​</mo><mi>𝔼</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><msup><mrow><mo>‖</mo><msubsup><mi>δ</mi><mi>i</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msubsup><mo>‖</mo></mrow><mn>4</mn></msup><mo>]</mo></mrow></mrow></mrow><mo rspace="0.1389em">≤</mo><mo lspace="0.1389em" rspace="0.1389em">⋯</mo><mo lspace="0.1389em">≤</mo><mrow><mn>8</mn><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>j</mi><mo>=</mo><mn>1</mn></mrow><mi>i</mi></munderover></mstyle><mrow><msup><mrow><mo stretchy="false">(</mo><mrow><mn>8</mn><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>L</mi><mi>f</mi><mn>4</mn></msubsup></mrow><mo stretchy="false">)</mo></mrow><mrow><mi>i</mi><mo>−</mo><mi>j</mi></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mi>𝔼</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><msup><mrow><mo>‖</mo><msubsup><mi>δ</mi><mi>j</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msubsup><mo>‖</mo></mrow><mn>4</mn></msup><mo>]</mo></mrow></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle 8L_{f}^{4}\mathbb{E}\left[\left\|\tilde{y}_{i-1}^{(t)}-{y}_{i-1}^{(t)}\right\|^{4}\right]+8\mathbb{E}\left[\left\|\delta_{i}^{(t)}\right\|^{4}\right]\leq\cdots\leq 8\sum_{j=1}^{i}(8L_{f}^{4})^{i-j}\mathbb{E}\left[\left\|\delta_{j}^{(t)}\right\|^{4}\right].</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="Thmtheorem2.p2.17" class="ltx_p"><span id="Thmtheorem2.p2.17.1" class="ltx_text">Substituting (<a href="#S4.E28" title="In Proof. ‣ Theorem 2. ‣ 4 Error Propagation Analysis ‣ On the Convergence of Stochastic Gradient Descent with Perturbed Forward-Backward Passes" class="ltx_ref"><span class="ltx_text ltx_ref_tag">28</span></a>) into (<a href="#S4.E27" title="In Proof. ‣ Theorem 2. ‣ 4 Error Propagation Analysis ‣ On the Convergence of Stochastic Gradient Descent with Perturbed Forward-Backward Passes" class="ltx_ref"><span class="ltx_text ltx_ref_tag">27</span></a>) yields</span></p>
<table id="S4.E31" class="ltx_equationgroup ltx_eqn_table">
<tbody>
<tr id="S4.E31X" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
