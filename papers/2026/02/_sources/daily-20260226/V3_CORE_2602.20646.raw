<tr id="S4.E28Xc" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S4.E28Xc.m2" class="ltx_Math" alttext="\displaystyle+3\mathbb{E}\left[\left\|\mathbb{E}_{t}^{\mathcal{H}_{i+1}}\left[\varepsilon_{i+1}^{(t)}\right]\right\|^{2}\right]" display="inline" intent=":literal"><semantics><mrow><mo>+</mo><mrow><mn>3</mn><mo lspace="0em" rspace="0em">​</mo><mi>𝔼</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><msup><mrow><mo>‖</mo><mrow><msubsup><mi>𝔼</mi><mi>t</mi><msub><mi class="ltx_font_mathcaligraphic">ℋ</mi><mrow><mi>i</mi><mo>+</mo><mn>1</mn></mrow></msub></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><msubsup><mi>ε</mi><mrow><mi>i</mi><mo>+</mo><mn>1</mn></mrow><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msubsup><mo>]</mo></mrow></mrow><mo>‖</mo></mrow><mn>2</mn></msup><mo>]</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle+3\mathbb{E}\left[\left\|\mathbb{E}_{t}^{\mathcal{H}_{i+1}}\left[\varepsilon_{i+1}^{(t)}\right]\right\|^{2}\right]</annotation></semantics></math></td>
