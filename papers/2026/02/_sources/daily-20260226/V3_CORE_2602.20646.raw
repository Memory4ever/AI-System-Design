<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S5.E36Xe.m2" class="ltx_Math" alttext="\displaystyle\leq" display="inline" intent=":literal"><semantics><mo>≤</mo><annotation encoding="application/x-tex">\displaystyle\leq</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S5.E36Xe.m3" class="ltx_Math" alttext="\displaystyle\ell(\boldsymbol{w}^{(t)})-\dfrac{1}{6}\gamma\left\|\nabla\ell(\boldsymbol{w}^{(t)})\right\|^{2}+L_{\nabla\ell}\gamma^{2}\sigma^{2}+L_{\nabla\ell}\gamma^{2}\mathbb{E}_{t}\left[\left\|\tilde{{\boldsymbol{u}}}^{(t)}-{{\boldsymbol{u}}}^{(t)}\right\|^{2}\right]" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mi mathvariant="normal">ℓ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>𝒘</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mn>6</mn></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mi>γ</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo>‖</mo><mrow><mrow><mo rspace="0.167em">∇</mo><mi mathvariant="normal">ℓ</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>𝒘</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow></mrow><mo>‖</mo></mrow><mn>2</mn></msup></mrow></mrow><mo>+</mo><mrow><msub><mi>L</mi><mrow><mo rspace="0.167em">∇</mo><mi mathvariant="normal">ℓ</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msup><mi>γ</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>σ</mi><mn>2</mn></msup></mrow><mo>+</mo><mrow><msub><mi>L</mi><mrow><mo rspace="0.167em">∇</mo><mi mathvariant="normal">ℓ</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msup><mi>γ</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝔼</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><msup><mrow><mo>‖</mo><mrow><msup><mover accent="true"><mi>𝒖</mi><mo>~</mo></mover><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo>−</mo><msup><mi>𝒖</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup></mrow><mo>‖</mo></mrow><mn>2</mn></msup><mo>]</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\ell(\boldsymbol{w}^{(t)})-\dfrac{1}{6}\gamma\left\|\nabla\ell(\boldsymbol{w}^{(t)})\right\|^{2}+L_{\nabla\ell}\gamma^{2}\sigma^{2}+L_{\nabla\ell}\gamma^{2}\mathbb{E}_{t}\left[\left\|\tilde{{\boldsymbol{u}}}^{(t)}-{{\boldsymbol{u}}}^{(t)}\right\|^{2}\right]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr>
<tr id="S5.E36Xf" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S5.E36Xf.m2" class="ltx_Math" alttext="\displaystyle+\dfrac{\gamma}{2}\left\|\mathbb{E}_{t}[\tilde{{\boldsymbol{u}}}^{(t)}-{{\boldsymbol{u}}}^{(t)}]\right\|^{2}," display="inline" intent=":literal"><semantics><mrow><mrow><mo>+</mo><mrow><mstyle displaystyle="true"><mfrac><mi>γ</mi><mn>2</mn></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo>‖</mo><mrow><msub><mi>𝔼</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mrow><msup><mover accent="true"><mi>𝒖</mi><mo>~</mo></mover><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo>−</mo><msup><mi>𝒖</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup></mrow><mo stretchy="false">]</mo></mrow></mrow><mo>‖</mo></mrow><mn>2</mn></msup></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle+\dfrac{\gamma}{2}\left\|\mathbb{E}_{t}[\tilde{{\boldsymbol{u}}}^{(t)}-{{\boldsymbol{u}}}^{(t)}]\right\|^{2},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="Thmtheorem3.p2.5" class="ltx_p"><span id="Thmtheorem3.p2.5.1" class="ltx_text">where the first inequality uses the fact that <math id="Thmtheorem3.p2.m4" class="ltx_Math" alttext="\boldsymbol{w}^{(t)}" display="inline" intent=":literal"><semantics><msup><mi>𝒘</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><annotation encoding="application/x-tex">\boldsymbol{w}^{(t)}</annotation></semantics></math> is measurable with respect to <math id="Thmtheorem3.p2.m5" class="ltx_Math" alttext="\mathcal{G}^{(t)}" display="inline" intent=":literal"><semantics><msup><mi class="ltx_font_mathcaligraphic">𝒢</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><annotation encoding="application/x-tex">\mathcal{G}^{(t)}</annotation></semantics></math> and that <math id="Thmtheorem3.p2.m6" class="ltx_Math" alttext="{\boldsymbol{u}}^{(t)}" display="inline" intent=":literal"><semantics><msup><mi>𝒖</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><annotation encoding="application/x-tex">{\boldsymbol{u}}^{(t)}</annotation></semantics></math> is an unbiased estimator of <math id="Thmtheorem3.p2.m7" class="ltx_Math" alttext="\nabla\ell(\boldsymbol{w}^{(t)})" display="inline" intent=":literal"><semantics><mrow><mrow><mo rspace="0.167em">∇</mo><mi mathvariant="normal">ℓ</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>𝒘</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\nabla\ell(\boldsymbol{w}^{(t)})</annotation></semantics></math> (Assumption <a href="#Thmassumption2" title="Assumption 2 (Stochasticity). ‣ 3.3 Assumptions ‣ 3 Preliminaries ‣ On the Convergence of Stochastic Gradient Descent with Perturbed Forward-Backward Passes" class="ltx_ref"><span class="ltx_text ltx_ref_tag">2</span></a>). The last inequality follows from the bounded variance of <math id="Thmtheorem3.p2.m8" class="ltx_Math" alttext="{\boldsymbol{u}}^{(t)}" display="inline" intent=":literal"><semantics><msup><mi>𝒖</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><annotation encoding="application/x-tex">{\boldsymbol{u}}^{(t)}</annotation></semantics></math> (Assumption <a href="#Thmassumption2" title="Assumption 2 (Stochasticity). ‣ 3.3 Assumptions ‣ 3 Preliminaries ‣ On the Convergence of Stochastic Gradient Descent with Perturbed Forward-Backward Passes" class="ltx_ref"><span class="ltx_text ltx_ref_tag">2</span></a>) and the step size condition <math id="Thmtheorem3.p2.m9" class="ltx_Math" alttext="L_{\nabla\ell}\gamma\leq\frac{1}{3}" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>L</mi><mrow><mo rspace="0.167em">∇</mo><mi mathvariant="normal">ℓ</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mi>γ</mi></mrow><mo>≤</mo><mfrac><mn>1</mn><mn>3</mn></mfrac></mrow><annotation encoding="application/x-tex">L_{\nabla\ell}\gamma\leq\frac{1}{3}</annotation></semantics></math>. Taking the full expectation and summing over <math id="Thmtheorem3.p2.m10" class="ltx_Math" alttext="t=0,1,\ldots,T-1" display="inline" intent=":literal"><semantics><mrow><mrow><mi>t</mi><mo>=</mo><mn>0</mn></mrow><mo>,</mo><mn>1</mn><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mrow><mi>T</mi><mo>−</mo><mn>1</mn></mrow></mrow><annotation encoding="application/x-tex">t=0,1,\ldots,T-1</annotation></semantics></math>, we obtain</span></p>
<table id="S5.Ex1" class="ltx_equationgroup ltx_eqn_table">

<tbody id="S5.Ex1X"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S5.Ex1X.m2" class="ltx_Math" alttext="\displaystyle\dfrac{1}{T}\sum_{t=0}^{T-1}\mathbb{E}\left[\left\|\nabla\ell(\boldsymbol{w}^{(t)})\right\|^{2}\right]\leq" display="inline" intent=":literal"><semantics><mrow><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>T</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>t</mi><mo>=</mo><mn>0</mn></mrow><mrow><mi>T</mi><mo>−</mo><mn>1</mn></mrow></munderover></mstyle><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><msup><mrow><mo>‖</mo><mrow><mrow><mo rspace="0.167em">∇</mo><mi mathvariant="normal">ℓ</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>𝒘</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow></mrow><mo>‖</mo></mrow><mn>2</mn></msup><mo>]</mo></mrow></mrow></mrow></mrow><mo>≤</mo><mphantom></mphantom></mrow><annotation encoding="application/x-tex">\displaystyle\dfrac{1}{T}\sum_{t=0}^{T-1}\mathbb{E}\left[\left\|\nabla\ell(\boldsymbol{w}^{(t)})\right\|^{2}\right]\leq</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S5.Ex1X.m3" class="ltx_Math" alttext="\displaystyle\dfrac{6\Delta_{0}}{\gamma T}+6L_{\nabla\ell}\gamma\sigma^{2}+\dfrac{6L_{\nabla\ell}\gamma}{T}\sum_{t=0}^{T-1}\mathbb{E}\left[\left\|\tilde{{\boldsymbol{u}}}^{(t)}-{{\boldsymbol{u}}}^{(t)}\right\|^{2}\right]" display="inline" intent=":literal"><semantics><mrow><mstyle displaystyle="true"><mfrac><mrow><mn>6</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi mathvariant="normal">Δ</mi><mn>0</mn></msub></mrow><mrow><mi>γ</mi><mo lspace="0em" rspace="0em">​</mo><mi>T</mi></mrow></mfrac></mstyle><mo>+</mo><mrow><mn>6</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>L</mi><mrow><mo rspace="0.167em">∇</mo><mi mathvariant="normal">ℓ</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mi>γ</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>σ</mi><mn>2</mn></msup></mrow><mo>+</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mn>6</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>L</mi><mrow><mo rspace="0.167em">∇</mo><mi mathvariant="normal">ℓ</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mi>γ</mi></mrow><mi>T</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>t</mi><mo>=</mo><mn>0</mn></mrow><mrow><mi>T</mi><mo>−</mo><mn>1</mn></mrow></munderover></mstyle><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><msup><mrow><mo>‖</mo><mrow><msup><mover accent="true"><mi>𝒖</mi><mo>~</mo></mover><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo>−</mo><msup><mi>𝒖</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup></mrow><mo>‖</mo></mrow><mn>2</mn></msup><mo>]</mo></mrow></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\dfrac{6\Delta_{0}}{\gamma T}+6L_{\nabla\ell}\gamma\sigma^{2}+\dfrac{6L_{\nabla\ell}\gamma}{T}\sum_{t=0}^{T-1}\mathbb{E}\left[\left\|\tilde{{\boldsymbol{u}}}^{(t)}-{{\boldsymbol{u}}}^{(t)}\right\|^{2}\right]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="S5.Ex1Xa"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S5.Ex1Xa.m2" class="ltx_Math" alttext="\displaystyle+\dfrac{3}{T}\sum_{t=0}^{T-1}\mathbb{E}\left[\left\|\mathbb{E}_{t}[\tilde{{\boldsymbol{u}}}^{(t)}-{{\boldsymbol{u}}}^{(t)}]\right\|^{2}\right]," display="inline" intent=":literal"><semantics><mrow><mo>+</mo><mstyle displaystyle="true"><mfrac><mn>3</mn><mi>T</mi></mfrac></mstyle><mstyle displaystyle="true"><mo movablelimits="false">∑</mo></mstyle><msub><mrow></mrow><mrow><mi>t</mi><mo>=</mo><mn>0</mn></mrow></msub><msup><mrow></mrow><mrow><mi>T</mi><mo>−</mo><mn>1</mn></mrow></msup><mi>𝔼</mi><mo>[</mo><mo>‖</mo><mi>𝔼</mi><msub><mrow></mrow><mi>t</mi></msub><mo stretchy="false">[</mo><mover accent="true"><mi>𝒖</mi><mo>~</mo></mover><msup><mrow></mrow><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo>−</mo><mi>𝒖</mi><msup><mrow></mrow><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">]</mo><mo>‖</mo><msup><mrow></mrow><mn>2</mn></msup><mo>]</mo><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle+\dfrac{3}{T}\sum_{t=0}^{T-1}\mathbb{E}\left[\left\|\mathbb{E}_{t}[\tilde{{\boldsymbol{u}}}^{(t)}-{{\boldsymbol{u}}}^{(t)}]\right\|^{2}\right],</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="Thmtheorem3.p2.6" class="ltx_p"><span id="Thmtheorem3.p2.6.1" class="ltx_text">which establishes (<a href="#S5.E34" title="In Theorem 3. ‣ 5.1 Convergence with Non-Convex Assumption ‣ 5 Convergence of SGD with Perturbed Forward-Backward Passes ‣ On the Convergence of Stochastic Gradient Descent with Perturbed Forward-Backward Passes" class="ltx_ref"><span class="ltx_text ltx_ref_tag">34</span></a>).
∎</span></p>
</div>
</div>
</div>
<div id="S5.SS1.p2" class="ltx_para ltx_noindent">
<p id="S5.SS1.p2.1" class="ltx_p">Inequality (<a href="#S5.E34" title="In Theorem 3. ‣ 5.1 Convergence with Non-Convex Assumption ‣ 5 Convergence of SGD with Perturbed Forward-Backward Passes ‣ On the Convergence of Stochastic Gradient Descent with Perturbed Forward-Backward Passes" class="ltx_ref"><span class="ltx_text ltx_ref_tag">34</span></a>) shows that the impact of forward and backward perturbations on convergence can be decomposed into two terms. The first is the variance of the gradient error, <math id="S5.SS1.p2.m1" class="ltx_Math" alttext="\mathbb{E}_{t}[\|\tilde{{\boldsymbol{u}}}^{(t)}-{\boldsymbol{u}}^{(t)}\|^{2}]" display="inline" intent=":literal"><semantics><mrow><msub><mi>𝔼</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><msup><mrow><mo stretchy="false">‖</mo><mrow><msup><mover accent="true"><mi>𝒖</mi><mo>~</mo></mover><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo>−</mo><msup><mi>𝒖</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">\mathbb{E}_{t}[\|\tilde{{\boldsymbol{u}}}^{(t)}-{\boldsymbol{u}}^{(t)}\|^{2}]</annotation></semantics></math>, which measures the <math id="S5.SS1.p2.m2" class="ltx_Math" alttext="\ell_{2}" display="inline" intent=":literal"><semantics><msub><mi mathvariant="normal">ℓ</mi><mn>2</mn></msub><annotation encoding="application/x-tex">\ell_{2}</annotation></semantics></math> deviation between the perturbed gradient <math id="S5.SS1.p2.m3" class="ltx_Math" alttext="\tilde{{\boldsymbol{u}}}^{(t)}" display="inline" intent=":literal"><semantics><msup><mover accent="true"><mi>𝒖</mi><mo>~</mo></mover><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><annotation encoding="application/x-tex">\tilde{{\boldsymbol{u}}}^{(t)}</annotation></semantics></math> and the ideal stochastic gradient <math id="S5.SS1.p2.m4" class="ltx_Math" alttext="{\boldsymbol{u}}^{(t)}" display="inline" intent=":literal"><semantics><msup><mi>𝒖</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><annotation encoding="application/x-tex">{\boldsymbol{u}}^{(t)}</annotation></semantics></math>. The second is the squared bias, <math id="S5.SS1.p2.m5" class="ltx_Math" alttext="\|\mathbb{E}_{t}[\tilde{{\boldsymbol{u}}}^{(t)}-{\boldsymbol{u}}^{(t)}]\|^{2}" display="inline" intent=":literal"><semantics><msup><mrow><mo stretchy="false">‖</mo><mrow><msub><mi>𝔼</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mrow><msup><mover accent="true"><mi>𝒖</mi><mo>~</mo></mover><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo>−</mo><msup><mi>𝒖</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup></mrow><mo stretchy="false">]</mo></mrow></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup><annotation encoding="application/x-tex">\|\mathbb{E}_{t}[\tilde{{\boldsymbol{u}}}^{(t)}-{\boldsymbol{u}}^{(t)}]\|^{2}</annotation></semantics></math>, which captures the systematic error introduced by the perturbations. Both terms were analyzed in Section <a href="#S4" title="4 Error Propagation Analysis ‣ On the Convergence of Stochastic Gradient Descent with Perturbed Forward-Backward Passes" class="ltx_ref"><span class="ltx_text ltx_ref_tag">4</span></a>.</p>
</div>
<div id="S5.SS1.p3" class="ltx_para ltx_noindent">
<p id="S5.SS1.p3.1" class="ltx_p">Substituting the bounds from (<a href="#S4.E13" title="In Theorem 1. ‣ 4 Error Propagation Analysis ‣ On the Convergence of Stochastic Gradient Descent with Perturbed Forward-Backward Passes" class="ltx_ref"><span class="ltx_text ltx_ref_tag">13</span></a>) and (<a href="#S4.E23" title="In Theorem 2. ‣ 4 Error Propagation Analysis ‣ On the Convergence of Stochastic Gradient Descent with Perturbed Forward-Backward Passes" class="ltx_ref"><span class="ltx_text ltx_ref_tag">23</span></a>) into (<a href="#S5.E34" title="In Theorem 3. ‣ 5.1 Convergence with Non-Convex Assumption ‣ 5 Convergence of SGD with Perturbed Forward-Backward Passes ‣ On the Convergence of Stochastic Gradient Descent with Perturbed Forward-Backward Passes" class="ltx_ref"><span class="ltx_text ltx_ref_tag">34</span></a>) yields the following convergence rate in the nonconvex setting.</p>
</div>
<div id="Thmtheorem4" class="ltx_theorem ltx_theorem_theorem">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="Thmtheorem4.2" class="ltx_text ltx_font_bold">Theorem 4</span></span><span id="Thmtheorem4.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="Thmtheorem4.p1" class="ltx_para ltx_noindent">
<p id="Thmtheorem4.p1.2" class="ltx_p"><span id="Thmtheorem4.p1.2.1" class="ltx_text ltx_font_italic">Suppose Assumptions <a href="#Thmassumption1" title="Assumption 1 (Smoothness of the loss function). ‣ 3.3 Assumptions ‣ 3 Preliminaries ‣ On the Convergence of Stochastic Gradient Descent with Perturbed Forward-Backward Passes" class="ltx_ref"><span class="ltx_text ltx_ref_tag">1</span></a>-<a href="#Thmassumption3" title="Assumption 3 (Operator smoothness). ‣ 3.3 Assumptions ‣ 3 Preliminaries ‣ On the Convergence of Stochastic Gradient Descent with Perturbed Forward-Backward Passes" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3</span></a> are all satisfied. If the step-size <math id="Thmtheorem4.p1.m1" class="ltx_Math" alttext="\gamma\leq\frac{1}{3L_{\nabla\ell}}" display="inline" intent=":literal"><semantics><mrow><mi>γ</mi><mo>≤</mo><mfrac><mn>1</mn><mrow><mn>3</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>L</mi><mrow><mo rspace="0.167em">∇</mo><mi mathvariant="normal">ℓ</mi></mrow></msub></mrow></mfrac></mrow><annotation encoding="application/x-tex">\gamma\leq\frac{1}{3L_{\nabla\ell}}</annotation></semantics></math>, then it holds that:</span></p>
<table id="S5.E37" class="ltx_equationgroup ltx_eqn_table">
<tbody>
<tr id="S5.E37X" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S5.E37X.m2" class="ltx_Math" alttext="\displaystyle\dfrac{1}{T}\sum_{t=0}^{T-1}\mathbb{E}\left[\left\|\nabla\ell(\boldsymbol{w}^{(t)})\right\|^{2}\right]" display="inline" intent=":literal"><semantics><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>T</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>t</mi><mo>=</mo><mn>0</mn></mrow><mrow><mi>T</mi><mo>−</mo><mn>1</mn></mrow></munderover></mstyle><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><msup><mrow><mo>‖</mo><mrow><mrow><mo rspace="0.167em">∇</mo><mi mathvariant="normal">ℓ</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>𝒘</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow></mrow><mo>‖</mo></mrow><mn>2</mn></msup><mo>]</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\dfrac{1}{T}\sum_{t=0}^{T-1}\mathbb{E}\left[\left\|\nabla\ell(\boldsymbol{w}^{(t)})\right\|^{2}\right]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="3" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equationgroup ltx_align_right">(37)</span></td></tr>
<tr id="S5.E37Xa" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S5.E37Xa.m2" class="ltx_Math" alttext="\displaystyle\leq" display="inline" intent=":literal"><semantics><mo>≤</mo><annotation encoding="application/x-tex">\displaystyle\leq</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S5.E37Xa.m3" class="ltx_Math" alttext="\displaystyle\dfrac{6\Delta_{0}}{\gamma T}+6L_{\nabla\ell}\gamma\sigma^{2}+\dfrac{6L_{\nabla\ell}\gamma}{T}\sum_{t=0}^{T-1}\left(\sum_{i=1}^{N-1}C^{e}_{\delta_{i}}\mathbb{E}\left[\left\|\delta_{i}^{(t)}\right\|^{2}\right]+\sum_{i=2}^{N}C^{e}_{\varepsilon_{i}}\mathbb{E}\left[\left\|\varepsilon_{i}^{(t)}\right\|^{2}\right]\right)" display="inline" intent=":literal"><semantics><mrow><mstyle displaystyle="true"><mfrac><mrow><mn>6</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi mathvariant="normal">Δ</mi><mn>0</mn></msub></mrow><mrow><mi>γ</mi><mo lspace="0em" rspace="0em">​</mo><mi>T</mi></mrow></mfrac></mstyle><mo>+</mo><mrow><mn>6</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>L</mi><mrow><mo rspace="0.167em">∇</mo><mi mathvariant="normal">ℓ</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mi>γ</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>σ</mi><mn>2</mn></msup></mrow><mo>+</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mn>6</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>L</mi><mrow><mo rspace="0.167em">∇</mo><mi mathvariant="normal">ℓ</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mi>γ</mi></mrow><mi>T</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>t</mi><mo>=</mo><mn>0</mn></mrow><mrow><mi>T</mi><mo>−</mo><mn>1</mn></mrow></munderover></mstyle><mrow><mo>(</mo><mrow><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mrow><mi>N</mi><mo>−</mo><mn>1</mn></mrow></munderover></mstyle><mrow><msubsup><mi>C</mi><msub><mi>δ</mi><mi>i</mi></msub><mi>e</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>𝔼</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><msup><mrow><mo>‖</mo><msubsup><mi>δ</mi><mi>i</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msubsup><mo>‖</mo></mrow><mn>2</mn></msup><mo>]</mo></mrow></mrow></mrow><mo>+</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>2</mn></mrow><mi>N</mi></munderover></mstyle><mrow><msubsup><mi>C</mi><msub><mi>ε</mi><mi>i</mi></msub><mi>e</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>𝔼</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><msup><mrow><mo>‖</mo><msubsup><mi>ε</mi><mi>i</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msubsup><mo>‖</mo></mrow><mn>2</mn></msup><mo>]</mo></mrow></mrow></mrow></mrow><mo>)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\dfrac{6\Delta_{0}}{\gamma T}+6L_{\nabla\ell}\gamma\sigma^{2}+\dfrac{6L_{\nabla\ell}\gamma}{T}\sum_{t=0}^{T-1}\left(\sum_{i=1}^{N-1}C^{e}_{\delta_{i}}\mathbb{E}\left[\left\|\delta_{i}^{(t)}\right\|^{2}\right]+\sum_{i=2}^{N}C^{e}_{\varepsilon_{i}}\mathbb{E}\left[\left\|\varepsilon_{i}^{(t)}\right\|^{2}\right]\right)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr>
<tr id="S5.E37Xb" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S5.E37Xb.m2" class="ltx_Math" alttext="\displaystyle+\hskip-2.84526pt\dfrac{3}{T}\hskip-1.42262pt\sum_{t=0}^{T-1}\hskip-2.84526pt\left(\hskip-1.42262pt\sum_{i=1}^{N-1}\hskip-2.84526ptC_{\delta_{i}}^{b}\mathbb{E}\hskip-1.42262pt\left[\hskip-0.85358pt\left\|\mathbb{E}^{\mathcal{G}_{i}}_{t}[\delta_{i}^{(t)}]\right\|^{2}\right]\hskip-2.84526pt+\hskip-1.42262pt\sum_{i=2}^{N}\hskip-1.42262ptC^{b}_{\varepsilon_{i}}\mathbb{E}\hskip-1.42262pt\left[\hskip-0.85358pt\left\|\mathbb{E}_{t}^{\mathcal{H}_{i}}[\varepsilon_{i}^{(t)}]\right\|^{2}\right]\hskip-2.84526pt+\hskip-2.84526pt\sum_{i=1}^{N-1}\hskip-2.27621pt\tilde{C}_{\delta_{i}}^{b}\mathbb{E}\hskip-1.42262pt\left[\hskip-0.85358pt\left\|\delta_{i}^{(t)}\right\|^{4}\right]\hskip-2.84526pt\right)\hskip-2.84526pt." display="inline" intent=":literal"><semantics><mrow><mo>+</mo><mstyle displaystyle="true"><mfrac><mn>3</mn><mi>T</mi></mfrac></mstyle><mstyle displaystyle="true"><mo movablelimits="false">∑</mo></mstyle><msub><mrow></mrow><mrow><mi>t</mi><mo>=</mo><mn>0</mn></mrow></msub><msup><mrow></mrow><mrow><mi>T</mi><mo>−</mo><mn>1</mn></mrow></msup><mo>(</mo><mstyle displaystyle="true"><mo movablelimits="false">∑</mo></mstyle><msub><mrow></mrow><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow></msub><msup><mrow></mrow><mrow><mi>N</mi><mo>−</mo><mn>1</mn></mrow></msup><mi>C</mi><msub><mrow></mrow><msub><mi>δ</mi><mi>i</mi></msub></msub><msup><mrow></mrow><mi>b</mi></msup><mi>𝔼</mi><mo>[</mo><mo>‖</mo><mi>𝔼</mi><msup><mrow></mrow><msub><mi class="ltx_font_mathcaligraphic">𝒢</mi><mi>i</mi></msub></msup><msub><mrow></mrow><mi>t</mi></msub><mo stretchy="false">[</mo><mi>δ</mi><msub><mrow></mrow><mi>i</mi></msub><msup><mrow></mrow><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">]</mo><mo>‖</mo><msup><mrow></mrow><mn>2</mn></msup><mo>]</mo><mo>+</mo><mstyle displaystyle="true"><mo movablelimits="false">∑</mo></mstyle><msub><mrow></mrow><mrow><mi>i</mi><mo>=</mo><mn>2</mn></mrow></msub><msup><mrow></mrow><mi>N</mi></msup><mi>C</mi><msup><mrow></mrow><mi>b</mi></msup><msub><mrow></mrow><msub><mi>ε</mi><mi>i</mi></msub></msub><mi>𝔼</mi><mo>[</mo><mo>‖</mo><mi>𝔼</mi><msub><mrow></mrow><mi>t</mi></msub><msup><mrow></mrow><msub><mi class="ltx_font_mathcaligraphic">ℋ</mi><mi>i</mi></msub></msup><mo stretchy="false">[</mo><mi>ε</mi><msub><mrow></mrow><mi>i</mi></msub><msup><mrow></mrow><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">]</mo><mo>‖</mo><msup><mrow></mrow><mn>2</mn></msup><mo>]</mo><mo>+</mo><mstyle displaystyle="true"><mo movablelimits="false">∑</mo></mstyle><msub><mrow></mrow><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow></msub><msup><mrow></mrow><mrow><mi>N</mi><mo>−</mo><mn>1</mn></mrow></msup><mover accent="true"><mi>C</mi><mo>~</mo></mover><msub><mrow></mrow><msub><mi>δ</mi><mi>i</mi></msub></msub><msup><mrow></mrow><mi>b</mi></msup><mi>𝔼</mi><mo>[</mo><mo>‖</mo><mi>δ</mi><msub><mrow></mrow><mi>i</mi></msub><msup><mrow></mrow><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo>‖</mo><msup><mrow></mrow><mn>4</mn></msup><mo>]</mo><mo>)</mo><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle+\hskip-2.84526pt\dfrac{3}{T}\hskip-1.42262pt\sum_{t=0}^{T-1}\hskip-2.84526pt\left(\hskip-1.42262pt\sum_{i=1}^{N-1}\hskip-2.84526ptC_{\delta_{i}}^{b}\mathbb{E}\hskip-1.42262pt\left[\hskip-0.85358pt\left\|\mathbb{E}^{\mathcal{G}_{i}}_{t}[\delta_{i}^{(t)}]\right\|^{2}\right]\hskip-2.84526pt+\hskip-1.42262pt\sum_{i=2}^{N}\hskip-1.42262ptC^{b}_{\varepsilon_{i}}\mathbb{E}\hskip-1.42262pt\left[\hskip-0.85358pt\left\|\mathbb{E}_{t}^{\mathcal{H}_{i}}[\varepsilon_{i}^{(t)}]\right\|^{2}\right]\hskip-2.84526pt+\hskip-2.84526pt\sum_{i=1}^{N-1}\hskip-2.27621pt\tilde{C}_{\delta_{i}}^{b}\mathbb{E}\hskip-1.42262pt\left[\hskip-0.85358pt\left\|\delta_{i}^{(t)}\right\|^{4}\right]\hskip-2.84526pt\right)\hskip-2.84526pt.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
</div>
<div id="Thmremark1" class="ltx_theorem ltx_theorem_remark">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="Thmremark1.2" class="ltx_text ltx_font_bold">Remark 1</span></span><span id="Thmremark1.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="Thmremark1.p1" class="ltx_para">
<p id="Thmremark1.p1.1" class="ltx_p"><span id="Thmremark1.p1.1.1" class="ltx_text ltx_font_italic">Setting <math id="Thmremark1.p1.m1" class="ltx_Math" alttext="\delta_{i}^{(t)}=0" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>δ</mi><mi>i</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msubsup><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\delta_{i}^{(t)}=0</annotation></semantics></math> and <math id="Thmremark1.p1.m2" class="ltx_Math" alttext="\varepsilon_{i}^{(t)}=0" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>ε</mi><mi>i</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msubsup><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\varepsilon_{i}^{(t)}=0</annotation></semantics></math> recovers the standard SGD without perturbations in forward and backward passes. In this case, choosing the step size <math id="Thmremark1.p1.m3" class="ltx_Math" alttext="\gamma=\mathcal{O}(T^{-\frac{1}{2}})" display="inline" intent=":literal"><semantics><mrow><mi>γ</mi><mo>=</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒪</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>T</mi><mrow><mo>−</mo><mfrac><mn>1</mn><mn>2</mn></mfrac></mrow></msup><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\gamma=\mathcal{O}(T^{-\frac{1}{2}})</annotation></semantics></math> in (<a href="#S5.E37" title="In Theorem 4. ‣ 5.1 Convergence with Non-Convex Assumption ‣ 5 Convergence of SGD with Perturbed Forward-Backward Passes ‣ On the Convergence of Stochastic Gradient Descent with Perturbed Forward-Backward Passes" class="ltx_ref"><span class="ltx_text ltx_ref_tag">37</span></a>) yields the classical <math id="Thmremark1.p1.m4" class="ltx_Math" alttext="\mathcal{O}(T^{-\frac{1}{2}})" display="inline" intent=":literal"><semantics><mrow><mi class="ltx_font_mathcaligraphic">𝒪</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>T</mi><mrow><mo>−</mo><mfrac><mn>1</mn><mn>2</mn></mfrac></mrow></msup><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathcal{O}(T^{-\frac{1}{2}})</annotation></semantics></math> convergence rate of SGD in the nonconvex setting.</span></p>
</div>
</div>
</section>
<section id="S5.SS2" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">5.2 </span>Convergence with PL Condition</h3>

<div id="S5.SS2.p1" class="ltx_para ltx_noindent">
<p id="S5.SS2.p1.1" class="ltx_p">Analogous to the nonconvex analysis, we derive the convergence rate under the PL condition.</p>
</div>
<div id="Thmtheorem5" class="ltx_theorem ltx_theorem_theorem">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="Thmtheorem5.2" class="ltx_text ltx_font_bold">Theorem 5</span></span><span id="Thmtheorem5.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="Thmtheorem5.p1" class="ltx_para ltx_noindent">
<p id="Thmtheorem5.p1.2" class="ltx_p"><span id="Thmtheorem5.p1.2.1" class="ltx_text ltx_font_italic">Suppose Assumption <a href="#Thmassumption1" title="Assumption 1 (Smoothness of the loss function). ‣ 3.3 Assumptions ‣ 3 Preliminaries ‣ On the Convergence of Stochastic Gradient Descent with Perturbed Forward-Backward Passes" class="ltx_ref"><span class="ltx_text ltx_ref_tag">1</span></a>-<a href="#Thmassumption4" title="Assumption 4 (PL condition). ‣ 3.3 Assumptions ‣ 3 Preliminaries ‣ On the Convergence of Stochastic Gradient Descent with Perturbed Forward-Backward Passes" class="ltx_ref"><span class="ltx_text ltx_ref_tag">4</span></a> are all satisfied. If the step-size <math id="Thmtheorem5.p1.m1" class="ltx_Math" alttext="\gamma\leq\frac{1}{3L_{\nabla\ell}}" display="inline" intent=":literal"><semantics><mrow><mi>γ</mi><mo>≤</mo><mfrac><mn>1</mn><mrow><mn>3</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>L</mi><mrow><mo rspace="0.167em">∇</mo><mi mathvariant="normal">ℓ</mi></mrow></msub></mrow></mfrac></mrow><annotation encoding="application/x-tex">\gamma\leq\frac{1}{3L_{\nabla\ell}}</annotation></semantics></math>, then it holds that:</span></p>
<table id="S5.E38" class="ltx_equationgroup ltx_eqn_table">
<tbody>
<tr id="S5.E38X" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S5.E38X.m2" class="ltx_Math" alttext="\displaystyle" display="inline" intent=":literal"><semantics><mphantom></mphantom><annotation encoding="application/x-tex">\displaystyle</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S5.E38X.m3" class="ltx_Math" alttext="\displaystyle\mathbb{E}\left[\ell(\boldsymbol{w}^{(T)})-\ell^{*}\right]" display="inline" intent=":literal"><semantics><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><mrow><mrow><mi mathvariant="normal">ℓ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>𝒘</mi><mrow><mo stretchy="false">(</mo><mi>T</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><msup><mi mathvariant="normal">ℓ</mi><mo>∗</mo></msup></mrow><mo>]</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\mathbb{E}\left[\ell(\boldsymbol{w}^{(T)})-\ell^{*}\right]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="5" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equationgroup ltx_align_right">(38)</span></td></tr>
<tr id="S5.E38Xa" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S5.E38Xa.m2" class="ltx_Math" alttext="\displaystyle\leq\left(1-\dfrac{\mu\gamma}{3}\right)^{T}\Delta_{0}+\dfrac{3L_{\nabla\ell}\gamma\sigma^{2}}{\mu}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≤</mo><mrow><mrow><msup><mrow><mo>(</mo><mrow><mn>1</mn><mo>−</mo><mstyle displaystyle="true"><mfrac><mrow><mi>μ</mi><mo lspace="0em" rspace="0em">​</mo><mi>γ</mi></mrow><mn>3</mn></mfrac></mstyle></mrow><mo>)</mo></mrow><mi>T</mi></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi mathvariant="normal">Δ</mi><mn>0</mn></msub></mrow><mo>+</mo><mstyle displaystyle="true"><mfrac><mrow><mn>3</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>L</mi><mrow><mo rspace="0.167em">∇</mo><mi mathvariant="normal">ℓ</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mi>γ</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>σ</mi><mn>2</mn></msup></mrow><mi>μ</mi></mfrac></mstyle></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\leq\left(1-\dfrac{\mu\gamma}{3}\right)^{T}\Delta_{0}+\dfrac{3L_{\nabla\ell}\gamma\sigma^{2}}{\mu}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr>
<tr id="S5.E38Xb" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S5.E38Xb.m2" class="ltx_Math" alttext="\displaystyle+L_{\nabla\ell}\gamma^{2}\sum_{t=0}^{T-1}\left(1-\dfrac{\mu\gamma}{3}\right)^{T-t}\left(\sum_{i=1}^{N-1}C^{e}_{\delta_{i}}\mathbb{E}\left[\left\|\delta_{i}^{(t)}\right\|^{2}\right]+\sum_{i=2}^{N}C^{e}_{\varepsilon_{i}}\mathbb{E}\left[\left\|\varepsilon_{i}^{(t)}\right\|^{2}\right]\right)" display="inline" intent=":literal"><semantics><mrow><mo>+</mo><mi>L</mi><msub><mrow></mrow><mrow><mo rspace="0.167em">∇</mo><mi mathvariant="normal">ℓ</mi></mrow></msub><mi>γ</mi><msup><mrow></mrow><mn>2</mn></msup><mstyle displaystyle="true"><mo movablelimits="false">∑</mo></mstyle><msub><mrow></mrow><mrow><mi>t</mi><mo>=</mo><mn>0</mn></mrow></msub><msup><mrow></mrow><mrow><mi>T</mi><mo>−</mo><mn>1</mn></mrow></msup><mo>(</mo><mn>1</mn><mo>−</mo><mstyle displaystyle="true"><mfrac><mrow><mi>μ</mi><mo lspace="0em" rspace="0em">​</mo><mi>γ</mi></mrow><mn>3</mn></mfrac></mstyle><mo>)</mo><msup><mrow></mrow><mrow><mi>T</mi><mo>−</mo><mi>t</mi></mrow></msup><mo>(</mo><mstyle displaystyle="true"><mo movablelimits="false">∑</mo></mstyle><msub><mrow></mrow><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow></msub><msup><mrow></mrow><mrow><mi>N</mi><mo>−</mo><mn>1</mn></mrow></msup><mi>C</mi><msup><mrow></mrow><mi>e</mi></msup><msub><mrow></mrow><msub><mi>δ</mi><mi>i</mi></msub></msub><mi>𝔼</mi><mo>[</mo><mo>‖</mo><mi>δ</mi><msub><mrow></mrow><mi>i</mi></msub><msup><mrow></mrow><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo>‖</mo><msup><mrow></mrow><mn>2</mn></msup><mo>]</mo><mo>+</mo><mstyle displaystyle="true"><mo movablelimits="false">∑</mo></mstyle><msub><mrow></mrow><mrow><mi>i</mi><mo>=</mo><mn>2</mn></mrow></msub><msup><mrow></mrow><mi>N</mi></msup><mi>C</mi><msup><mrow></mrow><mi>e</mi></msup><msub><mrow></mrow><msub><mi>ε</mi><mi>i</mi></msub></msub><mi>𝔼</mi><mo>[</mo><mo>‖</mo><mi>ε</mi><msub><mrow></mrow><mi>i</mi></msub><msup><mrow></mrow><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo>‖</mo><msup><mrow></mrow><mn>2</mn></msup><mo>]</mo><mo>)</mo></mrow><annotation encoding="application/x-tex">\displaystyle+L_{\nabla\ell}\gamma^{2}\sum_{t=0}^{T-1}\left(1-\dfrac{\mu\gamma}{3}\right)^{T-t}\left(\sum_{i=1}^{N-1}C^{e}_{\delta_{i}}\mathbb{E}\left[\left\|\delta_{i}^{(t)}\right\|^{2}\right]+\sum_{i=2}^{N}C^{e}_{\varepsilon_{i}}\mathbb{E}\left[\left\|\varepsilon_{i}^{(t)}\right\|^{2}\right]\right)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr>
<tr id="S5.E38Xc" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S5.E38Xc.m2" class="ltx_Math" alttext="\displaystyle+\dfrac{\gamma}{2}\sum_{t=0}^{T-1}\left(1-\dfrac{\mu\gamma}{3}\right)^{T-t}\left(\sum_{i=1}^{N-1}C_{\delta_{i}}^{b}\mathbb{E}\left[\left\|\mathbb{E}^{\mathcal{G}_{i}}_{t}[\delta_{i}^{(t)}]\right\|^{2}\right]+\sum_{i=2}^{N}C^{b}_{\varepsilon_{i}}\mathbb{E}\left[\left\|\mathbb{E}_{t}^{\mathcal{H}_{i}}[\varepsilon_{i}^{(t)}]\right\|^{2}\right]\right." display="inline" intent=":literal"><semantics><mrow><mo>+</mo><mstyle displaystyle="true"><mfrac><mi>γ</mi><mn>2</mn></mfrac></mstyle><mstyle displaystyle="true"><mo movablelimits="false">∑</mo></mstyle><msub><mrow></mrow><mrow><mi>t</mi><mo>=</mo><mn>0</mn></mrow></msub><msup><mrow></mrow><mrow><mi>T</mi><mo>−</mo><mn>1</mn></mrow></msup><mo>(</mo><mn>1</mn><mo>−</mo><mstyle displaystyle="true"><mfrac><mrow><mi>μ</mi><mo lspace="0em" rspace="0em">​</mo><mi>γ</mi></mrow><mn>3</mn></mfrac></mstyle><mo>)</mo><msup><mrow></mrow><mrow><mi>T</mi><mo>−</mo><mi>t</mi></mrow></msup><mo>(</mo><mstyle displaystyle="true"><mo movablelimits="false">∑</mo></mstyle><msub><mrow></mrow><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow></msub><msup><mrow></mrow><mrow><mi>N</mi><mo>−</mo><mn>1</mn></mrow></msup><mi>C</mi><msub><mrow></mrow><msub><mi>δ</mi><mi>i</mi></msub></msub><msup><mrow></mrow><mi>b</mi></msup><mi>𝔼</mi><mo>[</mo><mo>‖</mo><mi>𝔼</mi><msup><mrow></mrow><msub><mi class="ltx_font_mathcaligraphic">𝒢</mi><mi>i</mi></msub></msup><msub><mrow></mrow><mi>t</mi></msub><mo stretchy="false">[</mo><mi>δ</mi><msub><mrow></mrow><mi>i</mi></msub><msup><mrow></mrow><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">]</mo><mo>‖</mo><msup><mrow></mrow><mn>2</mn></msup><mo>]</mo><mo>+</mo><mstyle displaystyle="true"><mo movablelimits="false">∑</mo></mstyle><msub><mrow></mrow><mrow><mi>i</mi><mo>=</mo><mn>2</mn></mrow></msub><msup><mrow></mrow><mi>N</mi></msup><mi>C</mi><msup><mrow></mrow><mi>b</mi></msup><msub><mrow></mrow><msub><mi>ε</mi><mi>i</mi></msub></msub><mi>𝔼</mi><mo>[</mo><mo>‖</mo><mi>𝔼</mi><msub><mrow></mrow><mi>t</mi></msub><msup><mrow></mrow><msub><mi class="ltx_font_mathcaligraphic">ℋ</mi><mi>i</mi></msub></msup><mo stretchy="false">[</mo><mi>ε</mi><msub><mrow></mrow><mi>i</mi></msub><msup><mrow></mrow><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">]</mo><mo>‖</mo><msup><mrow></mrow><mn>2</mn></msup><mo>]</mo></mrow><annotation encoding="application/x-tex">\displaystyle+\dfrac{\gamma}{2}\sum_{t=0}^{T-1}\left(1-\dfrac{\mu\gamma}{3}\right)^{T-t}\left(\sum_{i=1}^{N-1}C_{\delta_{i}}^{b}\mathbb{E}\left[\left\|\mathbb{E}^{\mathcal{G}_{i}}_{t}[\delta_{i}^{(t)}]\right\|^{2}\right]+\sum_{i=2}^{N}C^{b}_{\varepsilon_{i}}\mathbb{E}\left[\left\|\mathbb{E}_{t}^{\mathcal{H}_{i}}[\varepsilon_{i}^{(t)}]\right\|^{2}\right]\right.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr>
<tr id="S5.E38Xd" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S5.E38Xd.m2" class="ltx_Math" alttext="\displaystyle\left.+\sum_{i=1}^{N-1}\tilde{C}_{\delta_{i}}^{b}\mathbb{E}\left[\left\|\delta_{i}^{(t)}\right\|^{4}\right]\right)." display="inline" intent=":literal"><semantics><mrow><mo>+</mo><mstyle displaystyle="true"><mo movablelimits="false">∑</mo></mstyle><msub><mrow></mrow><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow></msub><msup><mrow></mrow><mrow><mi>N</mi><mo>−</mo><mn>1</mn></mrow></msup><mover accent="true"><mi>C</mi><mo>~</mo></mover><msub><mrow></mrow><msub><mi>δ</mi><mi>i</mi></msub></msub><msup><mrow></mrow><mi>b</mi></msup><mi>𝔼</mi><mo>[</mo><mo>‖</mo><mi>δ</mi><msub><mrow></mrow><mi>i</mi></msub><msup><mrow></mrow><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo>‖</mo><msup><mrow></mrow><mn>4</mn></msup><mo>]</mo><mo>)</mo><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\left.+\sum_{i=1}^{N-1}\tilde{C}_{\delta_{i}}^{b}\mathbb{E}\left[\left\|\delta_{i}^{(t)}\right\|^{4}\right]\right).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="Thmtheorem5.4" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="Thmtheorem5.p2" class="ltx_para ltx_noindent">
<p id="Thmtheorem5.p2.5" class="ltx_p"><span id="Thmtheorem5.p2.5.1" class="ltx_text">Under Assumption <a href="#Thmassumption2" title="Assumption 2 (Stochasticity). ‣ 3.3 Assumptions ‣ 3 Preliminaries ‣ On the Convergence of Stochastic Gradient Descent with Perturbed Forward-Backward Passes" class="ltx_ref"><span class="ltx_text ltx_ref_tag">2</span></a>, it follows from (<a href="#S5.E36" title="In Proof. ‣ Theorem 3. ‣ 5.1 Convergence with Non-Convex Assumption ‣ 5 Convergence of SGD with Perturbed Forward-Backward Passes ‣ On the Convergence of Stochastic Gradient Descent with Perturbed Forward-Backward Passes" class="ltx_ref"><span class="ltx_text ltx_ref_tag">36</span></a>) that</span></p>
<table id="S5.E39" class="ltx_equationgroup ltx_eqn_table">
<tbody>
<tr id="S5.E39X" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S5.E39X.m2" class="ltx_Math" alttext="\displaystyle\mathbb{E}_{t}\left[\ell(\boldsymbol{w}^{(t+1)})\right]\leq" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>𝔼</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><mrow><mi mathvariant="normal">ℓ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>𝒘</mi><mrow><mo stretchy="false">(</mo><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow></mrow><mo>]</mo></mrow></mrow><mo>≤</mo><mphantom></mphantom></mrow><annotation encoding="application/x-tex">\displaystyle\mathbb{E}_{t}\left[\ell(\boldsymbol{w}^{(t+1)})\right]\leq</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S5.E39X.m3" class="ltx_Math" alttext="\displaystyle\ell(\boldsymbol{w}^{(t)})-\dfrac{\mu\gamma}{3}(\ell(\boldsymbol{w}^{(t)})-\ell^{*})+L_{\nabla\ell}\gamma^{2}\sigma^{2}" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mi mathvariant="normal">ℓ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>𝒘</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mi>μ</mi><mo lspace="0em" rspace="0em">​</mo><mi>γ</mi></mrow><mn>3</mn></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mi mathvariant="normal">ℓ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>𝒘</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><msup><mi mathvariant="normal">ℓ</mi><mo>∗</mo></msup></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>+</mo><mrow><msub><mi>L</mi><mrow><mo rspace="0.167em">∇</mo><mi mathvariant="normal">ℓ</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msup><mi>γ</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>σ</mi><mn>2</mn></msup></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\ell(\boldsymbol{w}^{(t)})-\dfrac{\mu\gamma}{3}(\ell(\boldsymbol{w}^{(t)})-\ell^{*})+L_{\nabla\ell}\gamma^{2}\sigma^{2}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="2" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equationgroup ltx_align_right">(39)</span></td></tr>
<tr id="S5.E39Xa" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S5.E39Xa.m2" class="ltx_Math" alttext="\displaystyle+L_{\nabla\ell}\gamma^{2}\mathbb{E}_{t}\left[\left\|\tilde{{\boldsymbol{u}}}^{(t)}-{{\boldsymbol{u}}}^{(t)}\right\|^{2}\right]+\dfrac{\gamma}{2}\mathbb{E}_{t}\left\|\mathbb{E}_{t}[\tilde{{\boldsymbol{u}}}^{(t)}-{{\boldsymbol{u}}}^{(t)}]\right\|^{2}." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mo>+</mo><mrow><msub><mi>L</mi><mrow><mo rspace="0.167em">∇</mo><mi mathvariant="normal">ℓ</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msup><mi>γ</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝔼</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><msup><mrow><mo>‖</mo><mrow><msup><mover accent="true"><mi>𝒖</mi><mo>~</mo></mover><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo>−</mo><msup><mi>𝒖</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup></mrow><mo>‖</mo></mrow><mn>2</mn></msup><mo>]</mo></mrow></mrow></mrow><mo>+</mo><mrow><mstyle displaystyle="true"><mfrac><mi>γ</mi><mn>2</mn></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝔼</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo>‖</mo><mrow><msub><mi>𝔼</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mrow><msup><mover accent="true"><mi>𝒖</mi><mo>~</mo></mover><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo>−</mo><msup><mi>𝒖</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup></mrow><mo stretchy="false">]</mo></mrow></mrow><mo>‖</mo></mrow><mn>2</mn></msup></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle+L_{\nabla\ell}\gamma^{2}\mathbb{E}_{t}\left[\left\|\tilde{{\boldsymbol{u}}}^{(t)}-{{\boldsymbol{u}}}^{(t)}\right\|^{2}\right]+\dfrac{\gamma}{2}\mathbb{E}_{t}\left\|\mathbb{E}_{t}[\tilde{{\boldsymbol{u}}}^{(t)}-{{\boldsymbol{u}}}^{(t)}]\right\|^{2}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="Thmtheorem5.p2.6" class="ltx_p"><span id="Thmtheorem5.p2.6.1" class="ltx_text">Taking the full expectation on both sides yields</span></p>
<table id="S5.E40" class="ltx_equationgroup ltx_eqn_table">
<tbody>
<tr id="S5.E40X" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S5.E40X.m2" class="ltx_Math" alttext="\displaystyle\mathbb{E}\left[\ell(\boldsymbol{w}^{(t+1)})-\ell^{*}\right]\leq" display="inline" intent=":literal"><semantics><mrow><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><mrow><mrow><mi mathvariant="normal">ℓ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>𝒘</mi><mrow><mo stretchy="false">(</mo><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><msup><mi mathvariant="normal">ℓ</mi><mo>∗</mo></msup></mrow><mo>]</mo></mrow></mrow><mo>≤</mo><mphantom></mphantom></mrow><annotation encoding="application/x-tex">\displaystyle\mathbb{E}\left[\ell(\boldsymbol{w}^{(t+1)})-\ell^{*}\right]\leq</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S5.E40X.m3" class="ltx_Math" alttext="\displaystyle\left(1-\dfrac{\mu\gamma}{3}\right)\mathbb{E}\left[\ell(\boldsymbol{w}^{(t)})-\ell^{*}\right]+L_{\nabla\ell}\gamma^{2}\sigma^{2}" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mo>(</mo><mrow><mn>1</mn><mo>−</mo><mstyle displaystyle="true"><mfrac><mrow><mi>μ</mi><mo lspace="0em" rspace="0em">​</mo><mi>γ</mi></mrow><mn>3</mn></mfrac></mstyle></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>𝔼</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><mrow><mrow><mi mathvariant="normal">ℓ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>𝒘</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><msup><mi mathvariant="normal">ℓ</mi><mo>∗</mo></msup></mrow><mo>]</mo></mrow></mrow><mo>+</mo><mrow><msub><mi>L</mi><mrow><mo rspace="0.167em">∇</mo><mi mathvariant="normal">ℓ</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msup><mi>γ</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>σ</mi><mn>2</mn></msup></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\left(1-\dfrac{\mu\gamma}{3}\right)\mathbb{E}\left[\ell(\boldsymbol{w}^{(t)})-\ell^{*}\right]+L_{\nabla\ell}\gamma^{2}\sigma^{2}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="2" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equationgroup ltx_align_right">(40)</span></td></tr>
<tr id="S5.E40Xa" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S5.E40Xa.m2" class="ltx_Math" alttext="\displaystyle+L_{\nabla\ell}\gamma^{2}\mathbb{E}\left[\left\|\tilde{{\boldsymbol{u}}}^{(t)}-{{\boldsymbol{u}}}^{(t)}\right\|^{2}\right]+\dfrac{\gamma}{2}\mathbb{E}\left[\left\|\mathbb{E}_{t}[\tilde{{\boldsymbol{u}}}^{(t)}-{{\boldsymbol{u}}}^{(t)}]\right\|^{2}\right]." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mo>+</mo><mrow><msub><mi>L</mi><mrow><mo rspace="0.167em">∇</mo><mi mathvariant="normal">ℓ</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msup><mi>γ</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mi>𝔼</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><msup><mrow><mo>‖</mo><mrow><msup><mover accent="true"><mi>𝒖</mi><mo>~</mo></mover><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo>−</mo><msup><mi>𝒖</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup></mrow><mo>‖</mo></mrow><mn>2</mn></msup><mo>]</mo></mrow></mrow></mrow><mo>+</mo><mrow><mstyle displaystyle="true"><mfrac><mi>γ</mi><mn>2</mn></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mi>𝔼</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><msup><mrow><mo>‖</mo><mrow><msub><mi>𝔼</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mrow><msup><mover accent="true"><mi>𝒖</mi><mo>~</mo></mover><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo>−</mo><msup><mi>𝒖</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup></mrow><mo stretchy="false">]</mo></mrow></mrow><mo>‖</mo></mrow><mn>2</mn></msup><mo>]</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle+L_{\nabla\ell}\gamma^{2}\mathbb{E}\left[\left\|\tilde{{\boldsymbol{u}}}^{(t)}-{{\boldsymbol{u}}}^{(t)}\right\|^{2}\right]+\dfrac{\gamma}{2}\mathbb{E}\left[\left\|\mathbb{E}_{t}[\tilde{{\boldsymbol{u}}}^{(t)}-{{\boldsymbol{u}}}^{(t)}]\right\|^{2}\right].</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="Thmtheorem5.p2.7" class="ltx_p"><span id="Thmtheorem5.p2.7.1" class="ltx_text">Applying this recursively, we obtain</span></p>
<table id="S5.E41" class="ltx_equationgroup ltx_eqn_table">
<tbody>
<tr id="S5.E41X" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S5.E41X.m2" class="ltx_Math" alttext="\displaystyle\mathbb{E}\left[\ell(\boldsymbol{w}^{(T)})-\ell^{*}\right]" display="inline" intent=":literal"><semantics><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><mrow><mrow><mi mathvariant="normal">ℓ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>𝒘</mi><mrow><mo stretchy="false">(</mo><mi>T</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><msup><mi mathvariant="normal">ℓ</mi><mo>∗</mo></msup></mrow><mo>]</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\mathbb{E}\left[\ell(\boldsymbol{w}^{(T)})-\ell^{*}\right]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="3" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equationgroup ltx_align_right">(41)</span></td></tr>
<tr id="S5.E41Xa" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S5.E41Xa.m2" class="ltx_Math" alttext="\displaystyle\leq" display="inline" intent=":literal"><semantics><mo>≤</mo><annotation encoding="application/x-tex">\displaystyle\leq</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S5.E41Xa.m3" class="ltx_Math" alttext="\displaystyle\left(1-\dfrac{\mu\gamma}{3}\right)^{T}\Delta_{0}+\dfrac{3L_{\nabla\ell}\gamma\sigma^{2}}{\mu}+L_{\nabla\ell}\gamma^{2}\sum_{t=0}^{T-1}\left(1-\dfrac{\mu\gamma}{3}\right)^{T-t}\mathbb{E}\left[\left\|\tilde{{\boldsymbol{u}}}^{(t)}-{{\boldsymbol{u}}}^{(t)}\right\|^{2}\right]" display="inline" intent=":literal"><semantics><mrow><mrow><msup><mrow><mo>(</mo><mrow><mn>1</mn><mo>−</mo><mstyle displaystyle="true"><mfrac><mrow><mi>μ</mi><mo lspace="0em" rspace="0em">​</mo><mi>γ</mi></mrow><mn>3</mn></mfrac></mstyle></mrow><mo>)</mo></mrow><mi>T</mi></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi mathvariant="normal">Δ</mi><mn>0</mn></msub></mrow><mo>+</mo><mstyle displaystyle="true"><mfrac><mrow><mn>3</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>L</mi><mrow><mo rspace="0.167em">∇</mo><mi mathvariant="normal">ℓ</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mi>γ</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>σ</mi><mn>2</mn></msup></mrow><mi>μ</mi></mfrac></mstyle><mo>+</mo><mrow><msub><mi>L</mi><mrow><mo rspace="0.167em">∇</mo><mi mathvariant="normal">ℓ</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msup><mi>γ</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>t</mi><mo>=</mo><mn>0</mn></mrow><mrow><mi>T</mi><mo>−</mo><mn>1</mn></mrow></munderover></mstyle><mrow><msup><mrow><mo>(</mo><mrow><mn>1</mn><mo>−</mo><mstyle displaystyle="true"><mfrac><mrow><mi>μ</mi><mo lspace="0em" rspace="0em">​</mo><mi>γ</mi></mrow><mn>3</mn></mfrac></mstyle></mrow><mo>)</mo></mrow><mrow><mi>T</mi><mo>−</mo><mi>t</mi></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mi>𝔼</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><msup><mrow><mo>‖</mo><mrow><msup><mover accent="true"><mi>𝒖</mi><mo>~</mo></mover><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo>−</mo><msup><mi>𝒖</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup></mrow><mo>‖</mo></mrow><mn>2</mn></msup><mo>]</mo></mrow></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\left(1-\dfrac{\mu\gamma}{3}\right)^{T}\Delta_{0}+\dfrac{3L_{\nabla\ell}\gamma\sigma^{2}}{\mu}+L_{\nabla\ell}\gamma^{2}\sum_{t=0}^{T-1}\left(1-\dfrac{\mu\gamma}{3}\right)^{T-t}\mathbb{E}\left[\left\|\tilde{{\boldsymbol{u}}}^{(t)}-{{\boldsymbol{u}}}^{(t)}\right\|^{2}\right]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr>
<tr id="S5.E41Xb" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S5.E41Xb.m2" class="ltx_Math" alttext="\displaystyle+\dfrac{\gamma}{2}\sum_{t=0}^{T-1}\left(1-\dfrac{\mu\gamma}{3}\right)^{T-t}\mathbb{E}\left[\left\|\mathbb{E}_{t}[\tilde{{\boldsymbol{u}}}^{(t)}-{{\boldsymbol{u}}}^{(t)}]\right\|^{2}\right]." display="inline" intent=":literal"><semantics><mrow><mo>+</mo><mstyle displaystyle="true"><mfrac><mi>γ</mi><mn>2</mn></mfrac></mstyle><mstyle displaystyle="true"><mo movablelimits="false">∑</mo></mstyle><msub><mrow></mrow><mrow><mi>t</mi><mo>=</mo><mn>0</mn></mrow></msub><msup><mrow></mrow><mrow><mi>T</mi><mo>−</mo><mn>1</mn></mrow></msup><mo>(</mo><mn>1</mn><mo>−</mo><mstyle displaystyle="true"><mfrac><mrow><mi>μ</mi><mo lspace="0em" rspace="0em">​</mo><mi>γ</mi></mrow><mn>3</mn></mfrac></mstyle><mo>)</mo><msup><mrow></mrow><mrow><mi>T</mi><mo>−</mo><mi>t</mi></mrow></msup><mi>𝔼</mi><mo>[</mo><mo>‖</mo><mi>𝔼</mi><msub><mrow></mrow><mi>t</mi></msub><mo stretchy="false">[</mo><mover accent="true"><mi>𝒖</mi><mo>~</mo></mover><msup><mrow></mrow><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo>−</mo><mi>𝒖</mi><msup><mrow></mrow><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">]</mo><mo>‖</mo><msup><mrow></mrow><mn>2</mn></msup><mo>]</mo><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle+\dfrac{\gamma}{2}\sum_{t=0}^{T-1}\left(1-\dfrac{\mu\gamma}{3}\right)^{T-t}\mathbb{E}\left[\left\|\mathbb{E}_{t}[\tilde{{\boldsymbol{u}}}^{(t)}-{{\boldsymbol{u}}}^{(t)}]\right\|^{2}\right].</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="Thmtheorem5.p2.8" class="ltx_p"><span id="Thmtheorem5.p2.8.1" class="ltx_text">Finally, substituting (<a href="#S4.E13" title="In Theorem 1. ‣ 4 Error Propagation Analysis ‣ On the Convergence of Stochastic Gradient Descent with Perturbed Forward-Backward Passes" class="ltx_ref"><span class="ltx_text ltx_ref_tag">13</span></a>) and (<a href="#S4.E23" title="In Theorem 2. ‣ 4 Error Propagation Analysis ‣ On the Convergence of Stochastic Gradient Descent with Perturbed Forward-Backward Passes" class="ltx_ref"><span class="ltx_text ltx_ref_tag">23</span></a>) into (<a href="#S5.E41" title="In Proof. ‣ Theorem 5. ‣ 5.2 Convergence with PL Condition ‣ 5 Convergence of SGD with Perturbed Forward-Backward Passes ‣ On the Convergence of Stochastic Gradient Descent with Perturbed Forward-Backward Passes" class="ltx_ref"><span class="ltx_text ltx_ref_tag">41</span></a>) gives</span></p>
<table id="S5.E42" class="ltx_equationgroup ltx_eqn_table">
<tbody>
<tr id="S5.E42X" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S5.E42X.m2" class="ltx_Math" alttext="\displaystyle\mathbb{E}\left[\ell(\boldsymbol{w}^{(T)})-\ell^{*}\right]\leq" display="inline" intent=":literal"><semantics><mrow><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><mrow><mrow><mi mathvariant="normal">ℓ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>𝒘</mi><mrow><mo stretchy="false">(</mo><mi>T</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><msup><mi mathvariant="normal">ℓ</mi><mo>∗</mo></msup></mrow><mo>]</mo></mrow></mrow><mo>≤</mo><mphantom></mphantom></mrow><annotation encoding="application/x-tex">\displaystyle\mathbb{E}\left[\ell(\boldsymbol{w}^{(T)})-\ell^{*}\right]\leq</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S5.E42X.m3" class="ltx_Math" alttext="\displaystyle\left(1-\dfrac{\mu\gamma}{3}\right)^{T}\Delta_{0}+\dfrac{3L_{\nabla\ell}\gamma\sigma^{2}}{\mu}" display="inline" intent=":literal"><semantics><mrow><mrow><msup><mrow><mo>(</mo><mrow><mn>1</mn><mo>−</mo><mstyle displaystyle="true"><mfrac><mrow><mi>μ</mi><mo lspace="0em" rspace="0em">​</mo><mi>γ</mi></mrow><mn>3</mn></mfrac></mstyle></mrow><mo>)</mo></mrow><mi>T</mi></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi mathvariant="normal">Δ</mi><mn>0</mn></msub></mrow><mo>+</mo><mstyle displaystyle="true"><mfrac><mrow><mn>3</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>L</mi><mrow><mo rspace="0.167em">∇</mo><mi mathvariant="normal">ℓ</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mi>γ</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>σ</mi><mn>2</mn></msup></mrow><mi>μ</mi></mfrac></mstyle></mrow><annotation encoding="application/x-tex">\displaystyle\left(1-\dfrac{\mu\gamma}{3}\right)^{T}\Delta_{0}+\dfrac{3L_{\nabla\ell}\gamma\sigma^{2}}{\mu}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="4" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equationgroup ltx_align_right">(42)</span></td></tr>
<tr id="S5.E42Xa" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S5.E42Xa.m2" class="ltx_Math" alttext="\displaystyle+" display="inline" intent=":literal"><semantics><mo>+</mo><annotation encoding="application/x-tex">\displaystyle+</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S5.E42Xa.m3" class="ltx_Math" alttext="\displaystyle L_{\nabla\ell}\gamma^{2}\sum_{t=0}^{T-1}\left(1-\dfrac{\mu\gamma}{3}\right)^{T-t}\left(\sum_{i=1}^{N-1}C^{e}_{\delta_{i}}\mathbb{E}\left[\left\|\delta_{i}^{(t)}\right\|^{2}\right]+\sum_{i=2}^{N}C^{e}_{\varepsilon_{i}}\mathbb{E}\left[\left\|\varepsilon_{i}^{(t)}\right\|^{2}\right]\right)" display="inline" intent=":literal"><semantics><mrow><msub><mi>L</mi><mrow><mo rspace="0.167em">∇</mo><mi mathvariant="normal">ℓ</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msup><mi>γ</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>t</mi><mo>=</mo><mn>0</mn></mrow><mrow><mi>T</mi><mo>−</mo><mn>1</mn></mrow></munderover></mstyle><mrow><msup><mrow><mo>(</mo><mrow><mn>1</mn><mo>−</mo><mstyle displaystyle="true"><mfrac><mrow><mi>μ</mi><mo lspace="0em" rspace="0em">​</mo><mi>γ</mi></mrow><mn>3</mn></mfrac></mstyle></mrow><mo>)</mo></mrow><mrow><mi>T</mi><mo>−</mo><mi>t</mi></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mrow><mi>N</mi><mo>−</mo><mn>1</mn></mrow></munderover></mstyle><mrow><msubsup><mi>C</mi><msub><mi>δ</mi><mi>i</mi></msub><mi>e</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>𝔼</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><msup><mrow><mo>‖</mo><msubsup><mi>δ</mi><mi>i</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msubsup><mo>‖</mo></mrow><mn>2</mn></msup><mo>]</mo></mrow></mrow></mrow><mo>+</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>2</mn></mrow><mi>N</mi></munderover></mstyle><mrow><msubsup><mi>C</mi><msub><mi>ε</mi><mi>i</mi></msub><mi>e</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>𝔼</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><msup><mrow><mo>‖</mo><msubsup><mi>ε</mi><mi>i</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msubsup><mo>‖</mo></mrow><mn>2</mn></msup><mo>]</mo></mrow></mrow></mrow></mrow><mo>)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle L_{\nabla\ell}\gamma^{2}\sum_{t=0}^{T-1}\left(1-\dfrac{\mu\gamma}{3}\right)^{T-t}\left(\sum_{i=1}^{N-1}C^{e}_{\delta_{i}}\mathbb{E}\left[\left\|\delta_{i}^{(t)}\right\|^{2}\right]+\sum_{i=2}^{N}C^{e}_{\varepsilon_{i}}\mathbb{E}\left[\left\|\varepsilon_{i}^{(t)}\right\|^{2}\right]\right)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr>
<tr id="S5.E42Xb" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S5.E42Xb.m2" class="ltx_Math" alttext="\displaystyle+" display="inline" intent=":literal"><semantics><mo>+</mo><annotation encoding="application/x-tex">\displaystyle+</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S5.E42Xb.m3" class="ltx_Math" alttext="\displaystyle\dfrac{\gamma}{2}\sum_{t=0}^{T-1}\left(1-\dfrac{\mu\gamma}{3}\right)^{T-t}\left(\sum_{i=1}^{N-1}C_{\delta_{i}}^{b}\mathbb{E}\left[\left\|\mathbb{E}^{\mathcal{G}_{i}}_{t}[\delta_{i}^{(t)}]\right\|^{2}\right]+\sum_{i=2}^{N}C^{b}_{\varepsilon_{i}}\mathbb{E}\left[\left\|\mathbb{E}_{t}^{\mathcal{H}_{i}}[\varepsilon_{i}^{(t)}]\right\|^{2}\right]\right." display="inline" intent=":literal"><semantics><mrow><mstyle displaystyle="true"><mfrac><mi>γ</mi><mn>2</mn></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>t</mi><mo>=</mo><mn>0</mn></mrow><mrow><mi>T</mi><mo>−</mo><mn>1</mn></mrow></munderover></mstyle><mrow><msup><mrow><mo>(</mo><mrow><mn>1</mn><mo>−</mo><mstyle displaystyle="true"><mfrac><mrow><mi>μ</mi><mo lspace="0em" rspace="0em">​</mo><mi>γ</mi></mrow><mn>3</mn></mfrac></mstyle></mrow><mo>)</mo></mrow><mrow><mi>T</mi><mo>−</mo><mi>t</mi></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mrow><mi>N</mi><mo>−</mo><mn>1</mn></mrow></munderover></mstyle><mrow><msubsup><mi>C</mi><msub><mi>δ</mi><mi>i</mi></msub><mi>b</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>𝔼</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><msup><mrow><mo>‖</mo><mrow><msubsup><mi>𝔼</mi><mi>t</mi><msub><mi class="ltx_font_mathcaligraphic">𝒢</mi><mi>i</mi></msub></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><msubsup><mi>δ</mi><mi>i</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msubsup><mo stretchy="false">]</mo></mrow></mrow><mo>‖</mo></mrow><mn>2</mn></msup><mo>]</mo></mrow></mrow></mrow><mo>+</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>2</mn></mrow><mi>N</mi></munderover></mstyle><mrow><msubsup><mi>C</mi><msub><mi>ε</mi><mi>i</mi></msub><mi>b</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>𝔼</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><msup><mrow><mo>‖</mo><mrow><msubsup><mi>𝔼</mi><mi>t</mi><msub><mi class="ltx_font_mathcaligraphic">ℋ</mi><mi>i</mi></msub></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><msubsup><mi>ε</mi><mi>i</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msubsup><mo stretchy="false">]</mo></mrow></mrow><mo>‖</mo></mrow><mn>2</mn></msup><mo>]</mo></mrow></mrow></mrow></mrow><mo fence="true" lspace="0em">CLOSE</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\dfrac{\gamma}{2}\sum_{t=0}^{T-1}\left(1-\dfrac{\mu\gamma}{3}\right)^{T-t}\left(\sum_{i=1}^{N-1}C_{\delta_{i}}^{b}\mathbb{E}\left[\left\|\mathbb{E}^{\mathcal{G}_{i}}_{t}[\delta_{i}^{(t)}]\right\|^{2}\right]+\sum_{i=2}^{N}C^{b}_{\varepsilon_{i}}\mathbb{E}\left[\left\|\mathbb{E}_{t}^{\mathcal{H}_{i}}[\varepsilon_{i}^{(t)}]\right\|^{2}\right]\right.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr>
<tr id="S5.E42Xc" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S5.E42Xc.m2" class="ltx_Math" alttext="\displaystyle\left.+\sum_{i=1}^{N-1}\tilde{C}_{\delta_{i}}^{b}\mathbb{E}\left[\left\|\delta_{i}^{(t)}\right\|^{4}\right]\right)," display="inline" intent=":literal"><semantics><mrow><mo>+</mo><mstyle displaystyle="true"><mo movablelimits="false">∑</mo></mstyle><msub><mrow></mrow><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow></msub><msup><mrow></mrow><mrow><mi>N</mi><mo>−</mo><mn>1</mn></mrow></msup><mover accent="true"><mi>C</mi><mo>~</mo></mover><msub><mrow></mrow><msub><mi>δ</mi><mi>i</mi></msub></msub><msup><mrow></mrow><mi>b</mi></msup><mi>𝔼</mi><mo>[</mo><mo>‖</mo><mi>δ</mi><msub><mrow></mrow><mi>i</mi></msub><msup><mrow></mrow><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo>‖</mo><msup><mrow></mrow><mn>4</mn></msup><mo>]</mo><mo>)</mo><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\left.+\sum_{i=1}^{N-1}\tilde{C}_{\delta_{i}}^{b}\mathbb{E}\left[\left\|\delta_{i}^{(t)}\right\|^{4}\right]\right),</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="Thmtheorem5.p2.9" class="ltx_p"><span id="Thmtheorem5.p2.9.1" class="ltx_text">which establishes (<a href="#S5.E38" title="In Theorem 5. ‣ 5.2 Convergence with PL Condition ‣ 5 Convergence of SGD with Perturbed Forward-Backward Passes ‣ On the Convergence of Stochastic Gradient Descent with Perturbed Forward-Backward Passes" class="ltx_ref"><span class="ltx_text ltx_ref_tag">38</span></a>).
∎</span></p>
