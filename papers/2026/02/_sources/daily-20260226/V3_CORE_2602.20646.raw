<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S4.Ex7.m1" class="ltx_Math" alttext="\displaystyle C_{y_{i}}^{2}:=" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>C</mi><msub><mi>y</mi><mi>i</mi></msub><mn>2</mn></msubsup><mo>:=</mo><mphantom></mphantom></mrow><annotation encoding="application/x-tex">\displaystyle C_{y_{i}}^{2}:=</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S4.Ex7.m2" class="ltx_Math" alttext="\displaystyle 8C_{\nabla^{2}f}^{2}L_{\nabla f}^{2}C_{v}^{2}\sum_{j=i+1}^{N-1}\left[\sum_{k=0}^{j}(3C_{\nabla f}^{2})^{k}\right](4C_{\nabla f}^{2})^{j-i-1}+2L_{\nabla^{2}f}^{2}C_{v}^{2}\sum_{j=0}^{i}(3C_{\nabla f}^{2})^{j}." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mn>8</mn><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>C</mi><mrow><msup><mo>∇</mo><mn>2</mn></msup><mi>f</mi></mrow><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>L</mi><mrow><mo rspace="0.167em">∇</mo><mi>f</mi></mrow><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>C</mi><mi>v</mi><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>j</mi><mo>=</mo><mrow><mi>i</mi><mo>+</mo><mn>1</mn></mrow></mrow><mrow><mi>N</mi><mo>−</mo><mn>1</mn></mrow></munderover></mstyle><mrow><mrow><mo>[</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>k</mi><mo>=</mo><mn>0</mn></mrow><mi>j</mi></munderover></mstyle><msup><mrow><mo stretchy="false">(</mo><mrow><mn>3</mn><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>C</mi><mrow><mo rspace="0.167em">∇</mo><mi>f</mi></mrow><mn>2</mn></msubsup></mrow><mo stretchy="false">)</mo></mrow><mi>k</mi></msup></mrow><mo>]</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mn>4</mn><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>C</mi><mrow><mo rspace="0.167em">∇</mo><mi>f</mi></mrow><mn>2</mn></msubsup></mrow><mo stretchy="false">)</mo></mrow><mrow><mi>j</mi><mo>−</mo><mi>i</mi><mo>−</mo><mn>1</mn></mrow></msup></mrow></mrow></mrow><mo>+</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>L</mi><mrow><msup><mo>∇</mo><mn>2</mn></msup><mi>f</mi></mrow><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>C</mi><mi>v</mi><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>j</mi><mo>=</mo><mn>0</mn></mrow><mi>i</mi></munderover></mstyle><msup><mrow><mo stretchy="false">(</mo><mrow><mn>3</mn><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>C</mi><mrow><mo rspace="0.167em">∇</mo><mi>f</mi></mrow><mn>2</mn></msubsup></mrow><mo stretchy="false">)</mo></mrow><mi>j</mi></msup></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle 8C_{\nabla^{2}f}^{2}L_{\nabla f}^{2}C_{v}^{2}\sum_{j=i+1}^{N-1}\left[\sum_{k=0}^{j}(3C_{\nabla f}^{2})^{k}\right](4C_{\nabla f}^{2})^{j-i-1}+2L_{\nabla^{2}f}^{2}C_{v}^{2}\sum_{j=0}^{i}(3C_{\nabla f}^{2})^{j}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="Thmtheorem2.p2.20" class="ltx_p"><span id="Thmtheorem2.p2.20.1" class="ltx_text">Substituting (<a href="#S4.E29" title="In Proof. ‣ Theorem 2. ‣ 4 Error Propagation Analysis ‣ On the Convergence of Stochastic Gradient Descent with Perturbed Forward-Backward Passes" class="ltx_ref"><span class="ltx_text ltx_ref_tag">29</span></a>) into (<a href="#S4.E31" title="In Proof. ‣ Theorem 2. ‣ 4 Error Propagation Analysis ‣ On the Convergence of Stochastic Gradient Descent with Perturbed Forward-Backward Passes" class="ltx_ref"><span class="ltx_text ltx_ref_tag">31</span></a>) then gives</span></p>
<table id="S4.EGx14" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="S4.Ex8"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S4.Ex8.m1" class="ltx_Math" alttext="\displaystyle\mathbb{E}\left[\left\|\mathbb{E}_{t}[\tilde{\boldsymbol{u}}^{(t)}-\boldsymbol{u}^{(t)}]\right\|^{2}\right]" display="inline" intent=":literal"><semantics><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><msup><mrow><mo>‖</mo><mrow><msub><mi>𝔼</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mrow><msup><mover accent="true"><mi>𝒖</mi><mo>~</mo></mover><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo>−</mo><msup><mi>𝒖</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup></mrow><mo stretchy="false">]</mo></mrow></mrow><mo>‖</mo></mrow><mn>2</mn></msup><mo>]</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\mathbb{E}\left[\left\|\mathbb{E}_{t}[\tilde{\boldsymbol{u}}^{(t)}-\boldsymbol{u}^{(t)}]\right\|^{2}\right]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="S4.Ex9"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S4.Ex9.m1" class="ltx_Math" alttext="\displaystyle\leq" display="inline" intent=":literal"><semantics><mo>≤</mo><annotation encoding="application/x-tex">\displaystyle\leq</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S4.Ex9.m2" class="ltx_Math" alttext="\displaystyle 8C_{\nabla^{2}f}^{2}C_{v}^{2}\sum_{i=1}^{N-1}\left(\sum_{j=i}^{N-1}\left[\sum_{k=0}^{j}(3C_{\nabla f}^{2})^{k}\right](4C_{\nabla f}^{2})^{j-i}\right)\mathbb{E}\left[\left\|\mathbb{E}^{\mathcal{G}_{i}}_{t}[\delta_{i}^{(t)}]\right\|^{2}\right]" display="inline" intent=":literal"><semantics><mrow><mn>8</mn><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>C</mi><mrow><msup><mo>∇</mo><mn>2</mn></msup><mi>f</mi></mrow><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>C</mi><mi>v</mi><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mrow><mi>N</mi><mo>−</mo><mn>1</mn></mrow></munderover></mstyle><mrow><mrow><mo>(</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>j</mi><mo>=</mo><mi>i</mi></mrow><mrow><mi>N</mi><mo>−</mo><mn>1</mn></mrow></munderover></mstyle><mrow><mrow><mo>[</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>k</mi><mo>=</mo><mn>0</mn></mrow><mi>j</mi></munderover></mstyle><msup><mrow><mo stretchy="false">(</mo><mrow><mn>3</mn><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>C</mi><mrow><mo rspace="0.167em">∇</mo><mi>f</mi></mrow><mn>2</mn></msubsup></mrow><mo stretchy="false">)</mo></mrow><mi>k</mi></msup></mrow><mo>]</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mn>4</mn><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>C</mi><mrow><mo rspace="0.167em">∇</mo><mi>f</mi></mrow><mn>2</mn></msubsup></mrow><mo stretchy="false">)</mo></mrow><mrow><mi>j</mi><mo>−</mo><mi>i</mi></mrow></msup></mrow></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>𝔼</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><msup><mrow><mo>‖</mo><mrow><msubsup><mi>𝔼</mi><mi>t</mi><msub><mi class="ltx_font_mathcaligraphic">𝒢</mi><mi>i</mi></msub></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><msubsup><mi>δ</mi><mi>i</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msubsup><mo stretchy="false">]</mo></mrow></mrow><mo>‖</mo></mrow><mn>2</mn></msup><mo>]</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle 8C_{\nabla^{2}f}^{2}C_{v}^{2}\sum_{i=1}^{N-1}\left(\sum_{j=i}^{N-1}\left[\sum_{k=0}^{j}(3C_{\nabla f}^{2})^{k}\right](4C_{\nabla f}^{2})^{j-i}\right)\mathbb{E}\left[\left\|\mathbb{E}^{\mathcal{G}_{i}}_{t}[\delta_{i}^{(t)}]\right\|^{2}\right]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="S4.Ex10"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S4.Ex10.m1" class="ltx_math_unparsed" alttext="\displaystyle+2\hskip-2.84526pt\sum_{i=1}^{N-1}\hskip-1.42262pt\left[\hskip-0.56905pt\sum_{j=1}^{i}(3C_{\nabla f}^{2})^{j}\hskip-1.42262pt\right]\hskip-1.42262pt\mathbb{E}\hskip-1.42262pt\left[\left\|\mathbb{E}_{t}^{\mathcal{H}_{i+1}}[\varepsilon_{i+1}^{(t)}]\right\|^{2}\right]\hskip-1.42262pt+\hskip-1.42262pt8\hskip-2.84526pt\sum_{i=1}^{N-1}\left[\sum_{j=i}^{N-1}C_{y_{j}}^{2}(8L_{f}^{4})^{j-i}\right]\hskip-1.42262pt\mathbb{E}\hskip-1.42262pt\left[\left\|\delta_{i}^{(t)}\right\|^{4}\right]\hskip-2.84526pt." display="inline" intent=":literal"><semantics><mrow><mo>+</mo><mn>2</mn><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mrow><mi>N</mi><mo>−</mo><mn>1</mn></mrow></munderover></mstyle><mrow><mo>[</mo><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>j</mi><mo>=</mo><mn>1</mn></mrow><mi>i</mi></munderover></mstyle><msup><mrow><mo stretchy="false">(</mo><mn>3</mn><msubsup><mi>C</mi><mrow><mo rspace="0.167em">∇</mo><mi>f</mi></mrow><mn>2</mn></msubsup><mo stretchy="false">)</mo></mrow><mi>j</mi></msup><mo>]</mo></mrow><mi>𝔼</mi><mrow><mo>[</mo><msup><mrow><mo>‖</mo><msubsup><mi>𝔼</mi><mi>t</mi><msub><mi class="ltx_font_mathcaligraphic">ℋ</mi><mrow><mi>i</mi><mo>+</mo><mn>1</mn></mrow></msub></msubsup><mrow><mo stretchy="false">[</mo><msubsup><mi>ε</mi><mrow><mi>i</mi><mo>+</mo><mn>1</mn></mrow><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msubsup><mo stretchy="false">]</mo></mrow><mo>‖</mo></mrow><mn>2</mn></msup><mo>]</mo></mrow><mo>+</mo><mn>8</mn><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mrow><mi>N</mi><mo>−</mo><mn>1</mn></mrow></munderover></mstyle><mrow><mo>[</mo><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>j</mi><mo>=</mo><mi>i</mi></mrow><mrow><mi>N</mi><mo>−</mo><mn>1</mn></mrow></munderover></mstyle><msubsup><mi>C</mi><msub><mi>y</mi><mi>j</mi></msub><mn>2</mn></msubsup><msup><mrow><mo stretchy="false">(</mo><mn>8</mn><msubsup><mi>L</mi><mi>f</mi><mn>4</mn></msubsup><mo stretchy="false">)</mo></mrow><mrow><mi>j</mi><mo>−</mo><mi>i</mi></mrow></msup><mo>]</mo></mrow><mi>𝔼</mi><mrow><mo>[</mo><msup><mrow><mo>‖</mo><msubsup><mi>δ</mi><mi>i</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msubsup><mo>‖</mo></mrow><mn>4</mn></msup><mo>]</mo></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle+2\hskip-2.84526pt\sum_{i=1}^{N-1}\hskip-1.42262pt\left[\hskip-0.56905pt\sum_{j=1}^{i}(3C_{\nabla f}^{2})^{j}\hskip-1.42262pt\right]\hskip-1.42262pt\mathbb{E}\hskip-1.42262pt\left[\left\|\mathbb{E}_{t}^{\mathcal{H}_{i+1}}[\varepsilon_{i+1}^{(t)}]\right\|^{2}\right]\hskip-1.42262pt+\hskip-1.42262pt8\hskip-2.84526pt\sum_{i=1}^{N-1}\left[\sum_{j=i}^{N-1}C_{y_{j}}^{2}(8L_{f}^{4})^{j-i}\right]\hskip-1.42262pt\mathbb{E}\hskip-1.42262pt\left[\left\|\delta_{i}^{(t)}\right\|^{4}\right]\hskip-2.84526pt.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="Thmtheorem2.p2.21" class="ltx_p"><span id="Thmtheorem2.p2.21.1" class="ltx_text">Defining</span></p>
<table id="S4.E33" class="ltx_equationgroup ltx_eqn_table">
<tbody><tr id="S4.EGx15" class="ltx_eqn_row"><td class="ltx_eqn_cell" colspan="5"></td></tr>
<tr id="S4.E33.1" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S4.E33.1.m1" class="ltx_Math" alttext="\displaystyle C^{b}_{\delta_{i}}:=" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>C</mi><msub><mi>δ</mi><mi>i</mi></msub><mi>b</mi></msubsup><mo>:=</mo><mphantom></mphantom></mrow><annotation encoding="application/x-tex">\displaystyle C^{b}_{\delta_{i}}:=</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S4.E33.1.m2" class="ltx_Math" alttext="\displaystyle 8L_{\nabla^{2}f}^{2}C_{v}^{2}\sum_{j=i}^{N-1}\left[\sum_{k=0}^{j}(3C_{\nabla f}^{2})^{k}\right](4C_{\nabla f}^{2})^{j-i}," display="inline" intent=":literal"><semantics><mrow><mrow><mn>8</mn><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>L</mi><mrow><msup><mo>∇</mo><mn>2</mn></msup><mi>f</mi></mrow><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>C</mi><mi>v</mi><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>j</mi><mo>=</mo><mi>i</mi></mrow><mrow><mi>N</mi><mo>−</mo><mn>1</mn></mrow></munderover></mstyle><mrow><mrow><mo>[</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>k</mi><mo>=</mo><mn>0</mn></mrow><mi>j</mi></munderover></mstyle><msup><mrow><mo stretchy="false">(</mo><mrow><mn>3</mn><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>C</mi><mrow><mo rspace="0.167em">∇</mo><mi>f</mi></mrow><mn>2</mn></msubsup></mrow><mo stretchy="false">)</mo></mrow><mi>k</mi></msup></mrow><mo>]</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mn>4</mn><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>C</mi><mrow><mo rspace="0.167em">∇</mo><mi>f</mi></mrow><mn>2</mn></msubsup></mrow><mo stretchy="false">)</mo></mrow><mrow><mi>j</mi><mo>−</mo><mi>i</mi></mrow></msup></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle 8L_{\nabla^{2}f}^{2}C_{v}^{2}\sum_{j=i}^{N-1}\left[\sum_{k=0}^{j}(3C_{\nabla f}^{2})^{k}\right](4C_{\nabla f}^{2})^{j-i},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(33a)</span></td></tr>
<tr id="S4.E33.2" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S4.E33.2.m1" class="ltx_Math" alttext="\displaystyle C^{b}_{\varepsilon_{i+1}}:=" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>C</mi><msub><mi>ε</mi><mrow><mi>i</mi><mo>+</mo><mn>1</mn></mrow></msub><mi>b</mi></msubsup><mo>:=</mo><mphantom></mphantom></mrow><annotation encoding="application/x-tex">\displaystyle C^{b}_{\varepsilon_{i+1}}:=</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S4.E33.2.m2" class="ltx_Math" alttext="\displaystyle 2\sum_{j=1}^{i}(3C_{\nabla f}^{2})^{j},\quad\tilde{C}^{b}_{\delta_{i}}:=8\sum_{j=i}^{N-1}C_{y_{j}}^{2}(8L_{f}^{4})^{j-i}," display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>j</mi><mo>=</mo><mn>1</mn></mrow><mi>i</mi></munderover></mstyle><msup><mrow><mo stretchy="false">(</mo><mrow><mn>3</mn><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>C</mi><mrow><mo rspace="0.167em">∇</mo><mi>f</mi></mrow><mn>2</mn></msubsup></mrow><mo stretchy="false">)</mo></mrow><mi>j</mi></msup></mrow></mrow><mo rspace="1.167em">,</mo><mrow><msubsup><mover accent="true"><mi>C</mi><mo>~</mo></mover><msub><mi>δ</mi><mi>i</mi></msub><mi>b</mi></msubsup><mo>:=</mo><mrow><mn>8</mn><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>j</mi><mo>=</mo><mi>i</mi></mrow><mrow><mi>N</mi><mo>−</mo><mn>1</mn></mrow></munderover></mstyle><mrow><msubsup><mi>C</mi><msub><mi>y</mi><mi>j</mi></msub><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mn>8</mn><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>L</mi><mi>f</mi><mn>4</mn></msubsup></mrow><mo stretchy="false">)</mo></mrow><mrow><mi>j</mi><mo>−</mo><mi>i</mi></mrow></msup></mrow></mrow></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle 2\sum_{j=1}^{i}(3C_{\nabla f}^{2})^{j},\quad\tilde{C}^{b}_{\delta_{i}}:=8\sum_{j=i}^{N-1}C_{y_{j}}^{2}(8L_{f}^{4})^{j-i},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(33b)</span></td></tr></tbody>
</table>
<p id="Thmtheorem2.p2.22" class="ltx_p"><span id="Thmtheorem2.p2.22.1" class="ltx_text">we conclude that (<a href="#S4.E23" title="In Theorem 2. ‣ 4 Error Propagation Analysis ‣ On the Convergence of Stochastic Gradient Descent with Perturbed Forward-Backward Passes" class="ltx_ref"><span class="ltx_text ltx_ref_tag">23</span></a>) holds for all <math id="Thmtheorem2.p2.m14" class="ltx_Math" alttext="t=1,2,\ldots,T" display="inline" intent=":literal"><semantics><mrow><mrow><mi>t</mi><mo>=</mo><mn>1</mn></mrow><mo>,</mo><mn>2</mn><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mi>T</mi></mrow><annotation encoding="application/x-tex">t=1,2,\ldots,T</annotation></semantics></math>.
∎</span></p>
</div>
</div>
</div>
<div id="S4.p7" class="ltx_para ltx_noindent">
<p id="S4.p7.1" class="ltx_p">Theorem <a href="#Thmtheorem2" title="Theorem 2. ‣ 4 Error Propagation Analysis ‣ On the Convergence of Stochastic Gradient Descent with Perturbed Forward-Backward Passes" class="ltx_ref"><span class="ltx_text ltx_ref_tag">2</span></a> shows that the bias of the gradient estimate is controlled by the expected forward perturbations <math id="S4.p7.m1" class="ltx_Math" alttext="\mathbb{E}[\delta]" display="inline" intent=":literal"><semantics><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mi>δ</mi><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">\mathbb{E}[\delta]</annotation></semantics></math>, the expected backward perturbations <math id="S4.p7.m2" class="ltx_Math" alttext="\mathbb{E}[\varepsilon]" display="inline" intent=":literal"><semantics><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mi>ε</mi><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">\mathbb{E}[\varepsilon]</annotation></semantics></math>, and the <em id="S4.p7.1.1" class="ltx_emph ltx_font_italic">fourth moment</em> of the forward perturbations <math id="S4.p7.m3" class="ltx_Math" alttext="\|\delta\|^{4}" display="inline" intent=":literal"><semantics><msup><mrow><mo stretchy="false">‖</mo><mi>δ</mi><mo stretchy="false">‖</mo></mrow><mn>4</mn></msup><annotation encoding="application/x-tex">\|\delta\|^{4}</annotation></semantics></math>. As with (<a href="#S4.E13" title="In Theorem 1. ‣ 4 Error Propagation Analysis ‣ On the Convergence of Stochastic Gradient Descent with Perturbed Forward-Backward Passes" class="ltx_ref"><span class="ltx_text ltx_ref_tag">13</span></a>), the coefficients in (<a href="#S4.E33" title="In Proof. ‣ Theorem 2. ‣ 4 Error Propagation Analysis ‣ On the Convergence of Stochastic Gradient Descent with Perturbed Forward-Backward Passes" class="ltx_ref"><span class="ltx_text ltx_ref_tag">33</span></a>) exhibit exponential growth with the depth of the computational graph.</p>
</div>
<div id="S4.p8" class="ltx_para ltx_noindent">
<p id="S4.p8.1" class="ltx_p">Theorems <a href="#Thmtheorem1" title="Theorem 1. ‣ 4 Error Propagation Analysis ‣ On the Convergence of Stochastic Gradient Descent with Perturbed Forward-Backward Passes" class="ltx_ref"><span class="ltx_text ltx_ref_tag">1</span></a> and <a href="#Thmtheorem2" title="Theorem 2. ‣ 4 Error Propagation Analysis ‣ On the Convergence of Stochastic Gradient Descent with Perturbed Forward-Backward Passes" class="ltx_ref"><span class="ltx_text ltx_ref_tag">2</span></a> together provide a complete characterization of how forward and backward perturbations corrupt gradient estimates, bounding the variance and bias of the gradient error, respectively. Combined, they yield a comprehensive quantification of the deviation between the perturbed gradient <math id="S4.p8.m1" class="ltx_Math" alttext="\tilde{\boldsymbol{u}}^{(t)}" display="inline" intent=":literal"><semantics><msup><mover accent="true"><mi>𝒖</mi><mo>~</mo></mover><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><annotation encoding="application/x-tex">\tilde{\boldsymbol{u}}^{(t)}</annotation></semantics></math> and the ideal <math id="S4.p8.m2" class="ltx_Math" alttext="\boldsymbol{u}^{(t)}" display="inline" intent=":literal"><semantics><msup><mi>𝒖</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><annotation encoding="application/x-tex">\boldsymbol{u}^{(t)}</annotation></semantics></math>.</p>
</div>
</section>
<section id="S5" class="ltx_section">
<h2 class="ltx_title ltx_title_section"><span class="ltx_tag ltx_tag_section">5 </span>Convergence of SGD with Perturbed Forward-Backward Passes</h2>

<div id="S5.p1" class="ltx_para ltx_noindent">
<p id="S5.p1.1" class="ltx_p">Building on the error propagation analysis in Section <a href="#S4" title="4 Error Propagation Analysis ‣ On the Convergence of Stochastic Gradient Descent with Perturbed Forward-Backward Passes" class="ltx_ref"><span class="ltx_text ltx_ref_tag">4</span></a>, we now establish convergence rates for SGD with perturbed forward and backward passes.</p>
</div>
<section id="S5.SS1" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">5.1 </span>Convergence with Non-Convex Assumption</h3>

<div id="S5.SS1.p1" class="ltx_para ltx_noindent">
<p id="S5.SS1.p1.1" class="ltx_p">We begin with a descent lemma for SGD under nonconvex objectives and perturbed forward-backward passes.</p>
</div>
<div id="Thmtheorem3" class="ltx_theorem ltx_theorem_theorem">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="Thmtheorem3.2" class="ltx_text ltx_font_bold">Theorem 3</span></span><span id="Thmtheorem3.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="Thmtheorem3.p1" class="ltx_para ltx_noindent">
<p id="Thmtheorem3.p1.2" class="ltx_p"><span id="Thmtheorem3.p1.2.1" class="ltx_text ltx_font_italic">Suppose Assumptions <a href="#Thmassumption1" title="Assumption 1 (Smoothness of the loss function). ‣ 3.3 Assumptions ‣ 3 Preliminaries ‣ On the Convergence of Stochastic Gradient Descent with Perturbed Forward-Backward Passes" class="ltx_ref"><span class="ltx_text ltx_ref_tag">1</span></a>-<a href="#Thmassumption3" title="Assumption 3 (Operator smoothness). ‣ 3.3 Assumptions ‣ 3 Preliminaries ‣ On the Convergence of Stochastic Gradient Descent with Perturbed Forward-Backward Passes" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3</span></a> are all satisfied. If the step-size <math id="Thmtheorem3.p1.m1" class="ltx_Math" alttext="\gamma\leq\frac{1}{3L_{\nabla\ell}}" display="inline" intent=":literal"><semantics><mrow><mi>γ</mi><mo>≤</mo><mfrac><mn>1</mn><mrow><mn>3</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>L</mi><mrow><mo rspace="0.167em">∇</mo><mi mathvariant="normal">ℓ</mi></mrow></msub></mrow></mfrac></mrow><annotation encoding="application/x-tex">\gamma\leq\frac{1}{3L_{\nabla\ell}}</annotation></semantics></math>, then it holds that:</span></p>
<table id="S5.E34" class="ltx_equationgroup ltx_eqn_table">
<tbody>
<tr id="S5.E34X" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S5.E34X.m2" class="ltx_Math" alttext="\displaystyle\dfrac{1}{T}\sum_{t=0}^{T-1}\mathbb{E}\left[\left\|\nabla\ell(\boldsymbol{w}^{(t)})\right\|^{2}\right]\leq" display="inline" intent=":literal"><semantics><mrow><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>T</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>t</mi><mo>=</mo><mn>0</mn></mrow><mrow><mi>T</mi><mo>−</mo><mn>1</mn></mrow></munderover></mstyle><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><msup><mrow><mo>‖</mo><mrow><mrow><mo rspace="0.167em">∇</mo><mi mathvariant="normal">ℓ</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>𝒘</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow></mrow><mo>‖</mo></mrow><mn>2</mn></msup><mo>]</mo></mrow></mrow></mrow></mrow><mo>≤</mo><mphantom></mphantom></mrow><annotation encoding="application/x-tex">\displaystyle\dfrac{1}{T}\sum_{t=0}^{T-1}\mathbb{E}\left[\left\|\nabla\ell(\boldsymbol{w}^{(t)})\right\|^{2}\right]\leq</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S5.E34X.m3" class="ltx_Math" alttext="\displaystyle\dfrac{6\Delta_{0}}{\gamma T}+6L_{\nabla\ell}\gamma\sigma^{2}+\dfrac{6L_{\nabla\ell}\gamma}{T}\sum_{t=0}^{T-1}\mathbb{E}\left[\left\|\tilde{{\boldsymbol{u}}}^{(t)}-{{\boldsymbol{u}}}^{(t)}\right\|^{2}\right]" display="inline" intent=":literal"><semantics><mrow><mstyle displaystyle="true"><mfrac><mrow><mn>6</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi mathvariant="normal">Δ</mi><mn>0</mn></msub></mrow><mrow><mi>γ</mi><mo lspace="0em" rspace="0em">​</mo><mi>T</mi></mrow></mfrac></mstyle><mo>+</mo><mrow><mn>6</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>L</mi><mrow><mo rspace="0.167em">∇</mo><mi mathvariant="normal">ℓ</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mi>γ</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>σ</mi><mn>2</mn></msup></mrow><mo>+</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mn>6</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>L</mi><mrow><mo rspace="0.167em">∇</mo><mi mathvariant="normal">ℓ</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mi>γ</mi></mrow><mi>T</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>t</mi><mo>=</mo><mn>0</mn></mrow><mrow><mi>T</mi><mo>−</mo><mn>1</mn></mrow></munderover></mstyle><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><msup><mrow><mo>‖</mo><mrow><msup><mover accent="true"><mi>𝒖</mi><mo>~</mo></mover><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo>−</mo><msup><mi>𝒖</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup></mrow><mo>‖</mo></mrow><mn>2</mn></msup><mo>]</mo></mrow></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\dfrac{6\Delta_{0}}{\gamma T}+6L_{\nabla\ell}\gamma\sigma^{2}+\dfrac{6L_{\nabla\ell}\gamma}{T}\sum_{t=0}^{T-1}\mathbb{E}\left[\left\|\tilde{{\boldsymbol{u}}}^{(t)}-{{\boldsymbol{u}}}^{(t)}\right\|^{2}\right]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="2" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equationgroup ltx_align_right">(34)</span></td></tr>
<tr id="S5.E34Xa" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S5.E34Xa.m2" class="ltx_Math" alttext="\displaystyle+\dfrac{3}{T}\sum_{t=0}^{T-1}\mathbb{E}\left[\left\|\mathbb{E}_{t}[\tilde{{\boldsymbol{u}}}^{(t)}-{{\boldsymbol{u}}}^{(t)}]\right\|^{2}\right]." display="inline" intent=":literal"><semantics><mrow><mo>+</mo><mstyle displaystyle="true"><mfrac><mn>3</mn><mi>T</mi></mfrac></mstyle><mstyle displaystyle="true"><mo movablelimits="false">∑</mo></mstyle><msub><mrow></mrow><mrow><mi>t</mi><mo>=</mo><mn>0</mn></mrow></msub><msup><mrow></mrow><mrow><mi>T</mi><mo>−</mo><mn>1</mn></mrow></msup><mi>𝔼</mi><mo>[</mo><mo>‖</mo><mi>𝔼</mi><msub><mrow></mrow><mi>t</mi></msub><mo stretchy="false">[</mo><mover accent="true"><mi>𝒖</mi><mo>~</mo></mover><msup><mrow></mrow><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo>−</mo><mi>𝒖</mi><msup><mrow></mrow><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">]</mo><mo>‖</mo><msup><mrow></mrow><mn>2</mn></msup><mo>]</mo><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle+\dfrac{3}{T}\sum_{t=0}^{T-1}\mathbb{E}\left[\left\|\mathbb{E}_{t}[\tilde{{\boldsymbol{u}}}^{(t)}-{{\boldsymbol{u}}}^{(t)}]\right\|^{2}\right].</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="Thmtheorem3.4" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="Thmtheorem3.p2" class="ltx_para ltx_noindent">
<p id="Thmtheorem3.p2.3" class="ltx_p"><span id="Thmtheorem3.p2.3.1" class="ltx_text">Since <math id="Thmtheorem3.p2.m1" class="ltx_Math" alttext="\nabla\ell" display="inline" intent=":literal"><semantics><mrow><mo rspace="0.167em">∇</mo><mi mathvariant="normal">ℓ</mi></mrow><annotation encoding="application/x-tex">\nabla\ell</annotation></semantics></math> is <math id="Thmtheorem3.p2.m2" class="ltx_Math" alttext="L_{\nabla\ell}" display="inline" intent=":literal"><semantics><msub><mi>L</mi><mrow><mo rspace="0.167em">∇</mo><mi mathvariant="normal">ℓ</mi></mrow></msub><annotation encoding="application/x-tex">L_{\nabla\ell}</annotation></semantics></math>-Lipschitz continuous, we have</span></p>
<table id="S5.E35" class="ltx_equationgroup ltx_eqn_table">
<tbody>
<tr id="S5.E35X" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S5.E35X.m2" class="ltx_Math" alttext="\displaystyle\ell(\boldsymbol{w}^{(t+1)})\leq" display="inline" intent=":literal"><semantics><mrow><mrow><mi mathvariant="normal">ℓ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>𝒘</mi><mrow><mo stretchy="false">(</mo><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow></mrow><mo>≤</mo><mphantom></mphantom></mrow><annotation encoding="application/x-tex">\displaystyle\ell(\boldsymbol{w}^{(t+1)})\leq</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S5.E35X.m3" class="ltx_Math" alttext="\displaystyle\ell(\boldsymbol{w}^{(t)})+\langle\nabla\ell(\boldsymbol{w}^{(t)}),\boldsymbol{w}^{(t+1)}-\boldsymbol{w}^{(t)}\rangle+\dfrac{L_{\nabla\ell}}{2}\left\|\boldsymbol{w}^{(t+1)}-\boldsymbol{w}^{(t)}\right\|^{2}" display="inline" intent=":literal"><semantics><mrow><mrow><mi mathvariant="normal">ℓ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>𝒘</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mrow><mo stretchy="false">⟨</mo><mrow><mrow><mrow><mo rspace="0.167em">∇</mo><mi mathvariant="normal">ℓ</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>𝒘</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mrow><msup><mi>𝒘</mi><mrow><mo stretchy="false">(</mo><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></msup><mo>−</mo><msup><mi>𝒘</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup></mrow></mrow><mo stretchy="false">⟩</mo></mrow><mo>+</mo><mrow><mstyle displaystyle="true"><mfrac><msub><mi>L</mi><mrow><mo rspace="0.167em">∇</mo><mi mathvariant="normal">ℓ</mi></mrow></msub><mn>2</mn></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo>‖</mo><mrow><msup><mi>𝒘</mi><mrow><mo stretchy="false">(</mo><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></msup><mo>−</mo><msup><mi>𝒘</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup></mrow><mo>‖</mo></mrow><mn>2</mn></msup></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\ell(\boldsymbol{w}^{(t)})+\langle\nabla\ell(\boldsymbol{w}^{(t)}),\boldsymbol{w}^{(t+1)}-\boldsymbol{w}^{(t)}\rangle+\dfrac{L_{\nabla\ell}}{2}\left\|\boldsymbol{w}^{(t+1)}-\boldsymbol{w}^{(t)}\right\|^{2}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="4" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equationgroup ltx_align_right">(35)</span></td></tr>
<tr id="S5.E35Xa" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S5.E35Xa.m2" class="ltx_Math" alttext="\displaystyle=" display="inline" intent=":literal"><semantics><mo>=</mo><annotation encoding="application/x-tex">\displaystyle=</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S5.E35Xa.m3" class="ltx_Math" alttext="\displaystyle\ell(\boldsymbol{w}^{(t)})-\gamma\langle\nabla\ell(\boldsymbol{w}^{(t)}),\tilde{{\boldsymbol{u}}}^{(t)}+{{\boldsymbol{r}}}^{(t)}\rangle+\dfrac{L_{\nabla\ell}\gamma^{2}}{2}\left\|\tilde{{\boldsymbol{u}}}^{(t)}+{{\boldsymbol{r}}}^{(t)}\right\|^{2}" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mi mathvariant="normal">ℓ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>𝒘</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mi>γ</mi><mo>⁡</mo><mrow><mo stretchy="false">⟨</mo><mrow><mrow><mrow><mo rspace="0.167em">∇</mo><mi mathvariant="normal">ℓ</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>𝒘</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mrow><msup><mover accent="true"><mi>𝒖</mi><mo>~</mo></mover><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo>+</mo><msup><mi>𝒓</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup></mrow></mrow><mo stretchy="false">⟩</mo></mrow></mrow></mrow><mo>+</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><msub><mi>L</mi><mrow><mo rspace="0.167em">∇</mo><mi mathvariant="normal">ℓ</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msup><mi>γ</mi><mn>2</mn></msup></mrow><mn>2</mn></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo>‖</mo><mrow><msup><mover accent="true"><mi>𝒖</mi><mo>~</mo></mover><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo>+</mo><msup><mi>𝒓</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup></mrow><mo>‖</mo></mrow><mn>2</mn></msup></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\ell(\boldsymbol{w}^{(t)})-\gamma\langle\nabla\ell(\boldsymbol{w}^{(t)}),\tilde{{\boldsymbol{u}}}^{(t)}+{{\boldsymbol{r}}}^{(t)}\rangle+\dfrac{L_{\nabla\ell}\gamma^{2}}{2}\left\|\tilde{{\boldsymbol{u}}}^{(t)}+{{\boldsymbol{r}}}^{(t)}\right\|^{2}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr>
<tr id="S5.E35Xb" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S5.E35Xb.m2" class="ltx_Math" alttext="\displaystyle\leq" display="inline" intent=":literal"><semantics><mo>≤</mo><annotation encoding="application/x-tex">\displaystyle\leq</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S5.E35Xb.m3" class="ltx_Math" alttext="\displaystyle\ell(\boldsymbol{w}^{(t)})-\gamma\langle\nabla\ell(\boldsymbol{w}^{(t)}),{\boldsymbol{u}}^{(t)}+{{\boldsymbol{r}}}^{(t)}\rangle+L_{\nabla\ell}\gamma^{2}\left\|{{\boldsymbol{u}}}^{(t)}+{{\boldsymbol{r}}}^{(t)}\right\|^{2}" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mi mathvariant="normal">ℓ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>𝒘</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mi>γ</mi><mo>⁡</mo><mrow><mo stretchy="false">⟨</mo><mrow><mrow><mrow><mo rspace="0.167em">∇</mo><mi mathvariant="normal">ℓ</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>𝒘</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mrow><msup><mi>𝒖</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo>+</mo><msup><mi>𝒓</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup></mrow></mrow><mo stretchy="false">⟩</mo></mrow></mrow></mrow><mo>+</mo><mrow><msub><mi>L</mi><mrow><mo rspace="0.167em">∇</mo><mi mathvariant="normal">ℓ</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msup><mi>γ</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo>‖</mo><mrow><msup><mi>𝒖</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo>+</mo><msup><mi>𝒓</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup></mrow><mo>‖</mo></mrow><mn>2</mn></msup></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\ell(\boldsymbol{w}^{(t)})-\gamma\langle\nabla\ell(\boldsymbol{w}^{(t)}),{\boldsymbol{u}}^{(t)}+{{\boldsymbol{r}}}^{(t)}\rangle+L_{\nabla\ell}\gamma^{2}\left\|{{\boldsymbol{u}}}^{(t)}+{{\boldsymbol{r}}}^{(t)}\right\|^{2}</annotation></semantics></math></td>
