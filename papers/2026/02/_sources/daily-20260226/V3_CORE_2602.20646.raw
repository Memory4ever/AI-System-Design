<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S4.E28Xb.m3" class="ltx_Math" alttext="\displaystyle\dfrac{3}{2}\mathbb{E}\left[\left\|\mathbb{E}_{t}^{\mathcal{H}_{i+1}}\left[\nabla_{1}f_{i+1}(\tilde{y}_{i}^{(t)},w_{i+1}^{(t)})^{\top}\tilde{v}_{i+1}^{(t)}-\nabla_{1}f_{i+1}(y_{i}^{(t)},w_{i+1}^{(t)})^{\top}v_{i+1}^{(t)}\right]\right\|^{2}\right]" display="inline" intent=":literal"><semantics><mrow><mstyle displaystyle="true"><mfrac><mn>3</mn><mn>2</mn></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mi>𝔼</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><msup><mrow><mo>‖</mo><mrow><msubsup><mi>𝔼</mi><mi>t</mi><msub><mi class="ltx_font_mathcaligraphic">ℋ</mi><mrow><mi>i</mi><mo>+</mo><mn>1</mn></mrow></msub></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><mrow><mrow><mrow><msub><mo rspace="0.167em">∇</mo><mn>1</mn></msub><msub><mi>f</mi><mrow><mi>i</mi><mo>+</mo><mn>1</mn></mrow></msub></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><msubsup><mover accent="true"><mi>y</mi><mo>~</mo></mover><mi>i</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msubsup><mo>,</mo><msubsup><mi>w</mi><mrow><mi>i</mi><mo>+</mo><mn>1</mn></mrow><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msubsup><mo stretchy="false">)</mo></mrow><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msubsup><mover accent="true"><mi>v</mi><mo>~</mo></mover><mrow><mi>i</mi><mo>+</mo><mn>1</mn></mrow><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msubsup></mrow><mo>−</mo><mrow><mrow><msub><mo rspace="0.167em">∇</mo><mn>1</mn></msub><msub><mi>f</mi><mrow><mi>i</mi><mo>+</mo><mn>1</mn></mrow></msub></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><msubsup><mi>y</mi><mi>i</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msubsup><mo>,</mo><msubsup><mi>w</mi><mrow><mi>i</mi><mo>+</mo><mn>1</mn></mrow><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msubsup><mo stretchy="false">)</mo></mrow><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>v</mi><mrow><mi>i</mi><mo>+</mo><mn>1</mn></mrow><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msubsup></mrow></mrow><mo>]</mo></mrow></mrow><mo>‖</mo></mrow><mn>2</mn></msup><mo>]</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\dfrac{3}{2}\mathbb{E}\left[\left\|\mathbb{E}_{t}^{\mathcal{H}_{i+1}}\left[\nabla_{1}f_{i+1}(\tilde{y}_{i}^{(t)},w_{i+1}^{(t)})^{\top}\tilde{v}_{i+1}^{(t)}-\nabla_{1}f_{i+1}(y_{i}^{(t)},w_{i+1}^{(t)})^{\top}v_{i+1}^{(t)}\right]\right\|^{2}\right]</annotation></semantics></math></td>
