</table>
<p id="Thmtheorem2.p2.13" class="ltx_p"><span id="Thmtheorem2.p2.13.1" class="ltx_text">where the last inequality follows from the boundedness of <math id="Thmtheorem2.p2.m4" class="ltx_Math" alttext="\nabla f_{i}" display="inline" intent=":literal"><semantics><mrow><mo rspace="0.167em">∇</mo><msub><mi>f</mi><mi>i</mi></msub></mrow><annotation encoding="application/x-tex">\nabla f_{i}</annotation></semantics></math>, Lemma <a href="#Thmlemma2" title="Lemma 2. ‣ 4 Error Propagation Analysis ‣ On the Convergence of Stochastic Gradient Descent with Perturbed Forward-Backward Passes" class="ltx_ref"><span class="ltx_text ltx_ref_tag">2</span></a>, and the inclusion <math id="Thmtheorem2.p2.m5" class="ltx_Math" alttext="\mathcal{F}^{(t)}\subset\mathcal{G}_{i-1}^{(t)}" display="inline" intent=":literal"><semantics><mrow><msup><mi class="ltx_font_mathcaligraphic">ℱ</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo>⊂</mo><msubsup><mi class="ltx_font_mathcaligraphic">𝒢</mi><mrow><mi>i</mi><mo>−</mo><mn>1</mn></mrow><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msubsup></mrow><annotation encoding="application/x-tex">\mathcal{F}^{(t)}\subset\mathcal{G}_{i-1}^{(t)}</annotation></semantics></math>. Summing over <math id="Thmtheorem2.p2.m6" class="ltx_Math" alttext="i=1,2,\ldots,N" display="inline" intent=":literal"><semantics><mrow><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mo>,</mo><mn>2</mn><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mi>N</mi></mrow><annotation encoding="application/x-tex">i=1,2,\ldots,N</annotation></semantics></math> yields</span></p>
<table id="S4.E27" class="ltx_equationgroup ltx_eqn_table">
<tbody>
<tr id="S4.E27X" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S4.E27X.m2" class="ltx_Math" alttext="\displaystyle\mathbb{E}\left[\left\|\mathbb{E}_{t}[\tilde{{\boldsymbol{u}}}^{(t)}-{{\boldsymbol{u}}}^{(t)}]\right\|^{2}\right]=\sum_{i=1}^{N}\mathbb{E}\left[\left\|\mathbb{E}_{t}[\tilde{u}_{i}^{(t)}-{u}_{i}^{(t)}]\right\|^{2}\right]" display="inline" intent=":literal"><semantics><mrow><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><msup><mrow><mo>‖</mo><mrow><msub><mi>𝔼</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mrow><msup><mover accent="true"><mi>𝒖</mi><mo>~</mo></mover><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo>−</mo><msup><mi>𝒖</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup></mrow><mo stretchy="false">]</mo></mrow></mrow><mo>‖</mo></mrow><mn>2</mn></msup><mo>]</mo></mrow></mrow><mo>=</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>N</mi></munderover></mstyle><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><msup><mrow><mo>‖</mo><mrow><msub><mi>𝔼</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mrow><msubsup><mover accent="true"><mi>u</mi><mo>~</mo></mover><mi>i</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msubsup><mo>−</mo><msubsup><mi>u</mi><mi>i</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msubsup></mrow><mo stretchy="false">]</mo></mrow></mrow><mo>‖</mo></mrow><mn>2</mn></msup><mo>]</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\mathbb{E}\left[\left\|\mathbb{E}_{t}[\tilde{{\boldsymbol{u}}}^{(t)}-{{\boldsymbol{u}}}^{(t)}]\right\|^{2}\right]=\sum_{i=1}^{N}\mathbb{E}\left[\left\|\mathbb{E}_{t}[\tilde{u}_{i}^{(t)}-{u}_{i}^{(t)}]\right\|^{2}\right]</annotation></semantics></math></td>
