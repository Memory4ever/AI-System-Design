<td rowspan="3" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equationgroup ltx_align_right">(27)</span></td></tr>
<tr id="S4.E27Xa" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S4.E27Xa.m2" class="ltx_Math" alttext="\displaystyle\leq" display="inline" intent=":literal"><semantics><mo>≤</mo><annotation encoding="application/x-tex">\displaystyle\leq</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S4.E27Xa.m3" class="ltx_Math" alttext="\displaystyle 2C_{\nabla f}^{2}\sum_{i=1}^{N-1}\mathbb{E}\left[\left\|\mathbb{E}^{\mathcal{H}_{i}}_{t}[\tilde{v}_{i}^{(t)}-v_{i}^{(t)}]\right\|^{2}\right]+4C_{v}^{2}C_{\nabla^{2}f}^{2}\sum_{i=1}^{N-1}\mathbb{E}\left[\left\|\mathbb{E}^{\mathcal{G}_{i}}_{t}[\tilde{y}_{i}^{(t)}-y_{i}^{(t)}]\right\|^{2}\right]" display="inline" intent=":literal"><semantics><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>C</mi><mrow><mo rspace="0.167em">∇</mo><mi>f</mi></mrow><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mrow><mi>N</mi><mo>−</mo><mn>1</mn></mrow></munderover></mstyle><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><msup><mrow><mo>‖</mo><mrow><msubsup><mi>𝔼</mi><mi>t</mi><msub><mi class="ltx_font_mathcaligraphic">ℋ</mi><mi>i</mi></msub></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mrow><msubsup><mover accent="true"><mi>v</mi><mo>~</mo></mover><mi>i</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msubsup><mo>−</mo><msubsup><mi>v</mi><mi>i</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msubsup></mrow><mo stretchy="false">]</mo></mrow></mrow><mo>‖</mo></mrow><mn>2</mn></msup><mo>]</mo></mrow></mrow></mrow></mrow><mo>+</mo><mrow><mn>4</mn><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>C</mi><mi>v</mi><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>C</mi><mrow><msup><mo>∇</mo><mn>2</mn></msup><mi>f</mi></mrow><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mrow><mi>N</mi><mo>−</mo><mn>1</mn></mrow></munderover></mstyle><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><msup><mrow><mo>‖</mo><mrow><msubsup><mi>𝔼</mi><mi>t</mi><msub><mi class="ltx_font_mathcaligraphic">𝒢</mi><mi>i</mi></msub></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mrow><msubsup><mover accent="true"><mi>y</mi><mo>~</mo></mover><mi>i</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msubsup><mo>−</mo><msubsup><mi>y</mi><mi>i</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msubsup></mrow><mo stretchy="false">]</mo></mrow></mrow><mo>‖</mo></mrow><mn>2</mn></msup><mo>]</mo></mrow></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle 2C_{\nabla f}^{2}\sum_{i=1}^{N-1}\mathbb{E}\left[\left\|\mathbb{E}^{\mathcal{H}_{i}}_{t}[\tilde{v}_{i}^{(t)}-v_{i}^{(t)}]\right\|^{2}\right]+4C_{v}^{2}C_{\nabla^{2}f}^{2}\sum_{i=1}^{N-1}\mathbb{E}\left[\left\|\mathbb{E}^{\mathcal{G}_{i}}_{t}[\tilde{y}_{i}^{(t)}-y_{i}^{(t)}]\right\|^{2}\right]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr>
<tr id="S4.E27Xb" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S4.E27Xb.m2" class="ltx_Math" alttext="\displaystyle+2C_{v}^{2}L_{\nabla^{2}f}^{2}\sum_{i=1}^{N-1}\mathbb{E}\left[\left\|\tilde{y}_{i}^{(t)}-y_{i}^{(t)}\right\|^{4}\right]." display="inline" intent=":literal"><semantics><mrow><mo>+</mo><mn>2</mn><mi>C</mi><msub><mrow></mrow><mi>v</mi></msub><msup><mrow></mrow><mn>2</mn></msup><mi>L</mi><msub><mrow></mrow><mrow><msup><mo>∇</mo><mn>2</mn></msup><mi>f</mi></mrow></msub><msup><mrow></mrow><mn>2</mn></msup><mstyle displaystyle="true"><mo movablelimits="false">∑</mo></mstyle><msub><mrow></mrow><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow></msub><msup><mrow></mrow><mrow><mi>N</mi><mo>−</mo><mn>1</mn></mrow></msup><mi>𝔼</mi><mo>[</mo><mo>‖</mo><mover accent="true"><mi>y</mi><mo>~</mo></mover><msub><mrow></mrow><mi>i</mi></msub><msup><mrow></mrow><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo>−</mo><mi>y</mi><msub><mrow></mrow><mi>i</mi></msub><msup><mrow></mrow><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo>‖</mo><msup><mrow></mrow><mn>4</mn></msup><mo>]</mo><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle+2C_{v}^{2}L_{\nabla^{2}f}^{2}\sum_{i=1}^{N-1}\mathbb{E}\left[\left\|\tilde{y}_{i}^{(t)}-y_{i}^{(t)}\right\|^{4}\right].</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="Thmtheorem2.p2.14" class="ltx_p"><span id="Thmtheorem2.p2.14.1" class="ltx_text">In view of (<a href="#S4.E24" title="In Proof. ‣ Theorem 2. ‣ 4 Error Propagation Analysis ‣ On the Convergence of Stochastic Gradient Descent with Perturbed Forward-Backward Passes" class="ltx_ref"><span class="ltx_text ltx_ref_tag">24</span></a>) and (<a href="#S4.E26" title="In Proof. ‣ Theorem 2. ‣ 4 Error Propagation Analysis ‣ On the Convergence of Stochastic Gradient Descent with Perturbed Forward-Backward Passes" class="ltx_ref"><span class="ltx_text ltx_ref_tag">26</span></a>), we next analyze <math id="Thmtheorem2.p2.m7" class="ltx_Math" alttext="\mathbb{E}_{t}^{\mathcal{H}_{i}}[\tilde{v}_{i}^{(t)}-v_{i}^{(t)}]" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>𝔼</mi><mi>t</mi><msub><mi class="ltx_font_mathcaligraphic">ℋ</mi><mi>i</mi></msub></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mrow><msubsup><mover accent="true"><mi>v</mi><mo>~</mo></mover><mi>i</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msubsup><mo>−</mo><msubsup><mi>v</mi><mi>i</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msubsup></mrow><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">\mathbb{E}_{t}^{\mathcal{H}_{i}}[\tilde{v}_{i}^{(t)}-v_{i}^{(t)}]</annotation></semantics></math> for <math id="Thmtheorem2.p2.m8" class="ltx_Math" alttext="i=1,2,\ldots,N-1" display="inline" intent=":literal"><semantics><mrow><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mo>,</mo><mn>2</mn><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mrow><mi>N</mi><mo>−</mo><mn>1</mn></mrow></mrow><annotation encoding="application/x-tex">i=1,2,\ldots,N-1</annotation></semantics></math>. We obtain</span></p>
