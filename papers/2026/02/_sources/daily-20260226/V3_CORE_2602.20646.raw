<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S4.E28Xa.m2" class="ltx_Math" alttext="\displaystyle\leq" display="inline" intent=":literal"><semantics><mo>≤</mo><annotation encoding="application/x-tex">\displaystyle\leq</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S4.E28Xa.m3" class="ltx_Math" alttext="\displaystyle\mathbb{E}\hskip-1.42262pt\left[\left\|\mathbb{E}_{t}^{\mathcal{H}_{i+1}}\hskip-2.84526pt\left[\nabla_{1}f_{i+1}(\tilde{y}_{i}^{(t)},w_{i+1}^{(t)})^{\top}\tilde{v}_{i+1}^{(t)}\hskip-1.42262pt-\hskip-1.42262pt\nabla_{1}f_{i+1}(y_{i}^{(t)},w_{i+1}^{(t)})^{\top}v_{i+1}^{(t)}+\varepsilon_{i+1}^{(t)}\right]\hskip-1.42262pt\right\|^{2}\right]" display="inline" intent=":literal"><semantics><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><msup><mrow><mo>‖</mo><mrow><msubsup><mi>𝔼</mi><mi>t</mi><msub><mi class="ltx_font_mathcaligraphic">ℋ</mi><mrow><mi>i</mi><mo>+</mo><mn>1</mn></mrow></msub></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><mrow><mrow><mrow><mrow><msub><mo rspace="0.167em">∇</mo><mn>1</mn></msub><msub><mi>f</mi><mrow><mi>i</mi><mo>+</mo><mn>1</mn></mrow></msub></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><msubsup><mover accent="true"><mi>y</mi><mo>~</mo></mover><mi>i</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msubsup><mo>,</mo><msubsup><mi>w</mi><mrow><mi>i</mi><mo>+</mo><mn>1</mn></mrow><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msubsup><mo stretchy="false">)</mo></mrow><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msubsup><mover accent="true"><mi>v</mi><mo>~</mo></mover><mrow><mi>i</mi><mo>+</mo><mn>1</mn></mrow><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msubsup></mrow><mo>−</mo><mrow><mrow><msub><mo rspace="0.167em">∇</mo><mn>1</mn></msub><msub><mi>f</mi><mrow><mi>i</mi><mo>+</mo><mn>1</mn></mrow></msub></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><msubsup><mi>y</mi><mi>i</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msubsup><mo>,</mo><msubsup><mi>w</mi><mrow><mi>i</mi><mo>+</mo><mn>1</mn></mrow><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msubsup><mo stretchy="false">)</mo></mrow><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>v</mi><mrow><mi>i</mi><mo>+</mo><mn>1</mn></mrow><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msubsup></mrow></mrow><mo>+</mo><msubsup><mi>ε</mi><mrow><mi>i</mi><mo>+</mo><mn>1</mn></mrow><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msubsup></mrow><mo>]</mo></mrow></mrow><mo>‖</mo></mrow><mn>2</mn></msup><mo>]</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\mathbb{E}\hskip-1.42262pt\left[\left\|\mathbb{E}_{t}^{\mathcal{H}_{i+1}}\hskip-2.84526pt\left[\nabla_{1}f_{i+1}(\tilde{y}_{i}^{(t)},w_{i+1}^{(t)})^{\top}\tilde{v}_{i+1}^{(t)}\hskip-1.42262pt-\hskip-1.42262pt\nabla_{1}f_{i+1}(y_{i}^{(t)},w_{i+1}^{(t)})^{\top}v_{i+1}^{(t)}+\varepsilon_{i+1}^{(t)}\right]\hskip-1.42262pt\right\|^{2}\right]</annotation></semantics></math></td>
