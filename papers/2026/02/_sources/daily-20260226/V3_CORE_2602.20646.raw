<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S4.E32Xb.m2" class="ltx_Math" alttext="\displaystyle+\hskip-1.42262pt8C_{\nabla^{2}f}^{2}L_{\nabla f}^{2}C_{v}^{2}\hskip-1.42262pt\sum_{i=1}^{N-2}\hskip-2.84526pt\left(\sum_{j=i+1}^{N-1}\hskip-2.84526pt\left[\sum_{k=0}^{j}(3C_{\nabla f}^{2})^{k}\hskip-1.42262pt\right]\hskip-1.42262pt(4C_{\nabla f}^{2})^{j-i-1}\hskip-4.2679pt\right)\mathbb{E}\hskip-1.42262pt\left[\left\|\tilde{y}_{i}^{(t)}-y_{i}^{(t)}\right\|^{4}\hskip-1.42262pt\right]\hskip-2.84526pt." display="inline" intent=":literal"><semantics><mrow><mo>+</mo><mn>8</mn><mi>C</mi><msub><mrow></mrow><mrow><msup><mo>∇</mo><mn>2</mn></msup><mi>f</mi></mrow></msub><msup><mrow></mrow><mn>2</mn></msup><mi>L</mi><msub><mrow></mrow><mrow><mo rspace="0.167em">∇</mo><mi>f</mi></mrow></msub><msup><mrow></mrow><mn>2</mn></msup><mi>C</mi><msub><mrow></mrow><mi>v</mi></msub><msup><mrow></mrow><mn>2</mn></msup><mstyle displaystyle="true"><mo movablelimits="false">∑</mo></mstyle><msub><mrow></mrow><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow></msub><msup><mrow></mrow><mrow><mi>N</mi><mo>−</mo><mn>2</mn></mrow></msup><mo>(</mo><mstyle displaystyle="true"><mo movablelimits="false">∑</mo></mstyle><msub><mrow></mrow><mrow><mi>j</mi><mo>=</mo><mrow><mi>i</mi><mo>+</mo><mn>1</mn></mrow></mrow></msub><msup><mrow></mrow><mrow><mi>N</mi><mo>−</mo><mn>1</mn></mrow></msup><mo>[</mo><mstyle displaystyle="true"><mo movablelimits="false">∑</mo></mstyle><msub><mrow></mrow><mrow><mi>k</mi><mo>=</mo><mn>0</mn></mrow></msub><msup><mrow></mrow><mi>j</mi></msup><mo stretchy="false">(</mo><mn>3</mn><mi>C</mi><msub><mrow></mrow><mrow><mo rspace="0.167em">∇</mo><mi>f</mi></mrow></msub><msup><mrow></mrow><mn>2</mn></msup><mo stretchy="false">)</mo><msup><mrow></mrow><mi>k</mi></msup><mo>]</mo><mo stretchy="false">(</mo><mn>4</mn><mi>C</mi><msub><mrow></mrow><mrow><mo rspace="0.167em">∇</mo><mi>f</mi></mrow></msub><msup><mrow></mrow><mn>2</mn></msup><mo stretchy="false">)</mo><msup><mrow></mrow><mrow><mi>j</mi><mo>−</mo><mi>i</mi><mo>−</mo><mn>1</mn></mrow></msup><mo>)</mo><mi>𝔼</mi><mo>[</mo><mo>‖</mo><mover accent="true"><mi>y</mi><mo>~</mo></mover><msub><mrow></mrow><mi>i</mi></msub><msup><mrow></mrow><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo>−</mo><mi>y</mi><msub><mrow></mrow><mi>i</mi></msub><msup><mrow></mrow><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo>‖</mo><msup><mrow></mrow><mn>4</mn></msup><mo>]</mo><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle+\hskip-1.42262pt8C_{\nabla^{2}f}^{2}L_{\nabla f}^{2}C_{v}^{2}\hskip-1.42262pt\sum_{i=1}^{N-2}\hskip-2.84526pt\left(\sum_{j=i+1}^{N-1}\hskip-2.84526pt\left[\sum_{k=0}^{j}(3C_{\nabla f}^{2})^{k}\hskip-1.42262pt\right]\hskip-1.42262pt(4C_{\nabla f}^{2})^{j-i-1}\hskip-4.2679pt\right)\mathbb{E}\hskip-1.42262pt\left[\left\|\tilde{y}_{i}^{(t)}-y_{i}^{(t)}\right\|^{4}\hskip-1.42262pt\right]\hskip-2.84526pt.</annotation></semantics></math></td>
