<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S5.E35Xc.m2" class="ltx_Math" alttext="\displaystyle+L_{\nabla\ell}\gamma^{2}\left\|\tilde{{\boldsymbol{u}}}^{(t)}-{{\boldsymbol{u}}}^{(t)}\right\|^{2}-\gamma\langle\nabla\ell(\boldsymbol{w}^{(t)}),\tilde{{\boldsymbol{u}}}^{(t)}-{{\boldsymbol{u}}}^{(t)}\rangle," display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mo>+</mo><mrow><msub><mi>L</mi><mrow><mo rspace="0.167em">∇</mo><mi mathvariant="normal">ℓ</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msup><mi>γ</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo>‖</mo><mrow><msup><mover accent="true"><mi>𝒖</mi><mo>~</mo></mover><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo>−</mo><msup><mi>𝒖</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup></mrow><mo>‖</mo></mrow><mn>2</mn></msup></mrow></mrow><mo>−</mo><mrow><mi>γ</mi><mo>⁡</mo><mrow><mo stretchy="false">⟨</mo><mrow><mrow><mrow><mo rspace="0.167em">∇</mo><mi mathvariant="normal">ℓ</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>𝒘</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mrow><msup><mover accent="true"><mi>𝒖</mi><mo>~</mo></mover><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo>−</mo><msup><mi>𝒖</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup></mrow></mrow><mo stretchy="false">⟩</mo></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle+L_{\nabla\ell}\gamma^{2}\left\|\tilde{{\boldsymbol{u}}}^{(t)}-{{\boldsymbol{u}}}^{(t)}\right\|^{2}-\gamma\langle\nabla\ell(\boldsymbol{w}^{(t)}),\tilde{{\boldsymbol{u}}}^{(t)}-{{\boldsymbol{u}}}^{(t)}\rangle,</annotation></semantics></math></td>
