<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S4.E28Xd.m2" class="ltx_Math" alttext="\displaystyle\leq" display="inline" intent=":literal"><semantics><mo>≤</mo><annotation encoding="application/x-tex">\displaystyle\leq</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S4.E28Xd.m3" class="ltx_Math" alttext="\displaystyle 3C_{\nabla f}^{2}\mathbb{E}\left[\left\|\mathbb{E}^{\mathcal{H}_{i+1}}_{t}[\tilde{v}_{i+1}^{(t)}-v_{i+1}^{(t)}]\right\|^{2}\right]+6C_{v}^{2}C_{\nabla^{2}f}^{2}\mathbb{E}\left[\left\|\mathbb{E}^{\mathcal{G}_{i}}_{t}[\tilde{y}_{i}^{(t)}-y_{i}^{(t)}]\right\|^{2}\right]" display="inline" intent=":literal"><semantics><mrow><mrow><mn>3</mn><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>C</mi><mrow><mo rspace="0.167em">∇</mo><mi>f</mi></mrow><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>𝔼</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><msup><mrow><mo>‖</mo><mrow><msubsup><mi>𝔼</mi><mi>t</mi><msub><mi class="ltx_font_mathcaligraphic">ℋ</mi><mrow><mi>i</mi><mo>+</mo><mn>1</mn></mrow></msub></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mrow><msubsup><mover accent="true"><mi>v</mi><mo>~</mo></mover><mrow><mi>i</mi><mo>+</mo><mn>1</mn></mrow><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msubsup><mo>−</mo><msubsup><mi>v</mi><mrow><mi>i</mi><mo>+</mo><mn>1</mn></mrow><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msubsup></mrow><mo stretchy="false">]</mo></mrow></mrow><mo>‖</mo></mrow><mn>2</mn></msup><mo>]</mo></mrow></mrow><mo>+</mo><mrow><mn>6</mn><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>C</mi><mi>v</mi><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>C</mi><mrow><msup><mo>∇</mo><mn>2</mn></msup><mi>f</mi></mrow><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>𝔼</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><msup><mrow><mo>‖</mo><mrow><msubsup><mi>𝔼</mi><mi>t</mi><msub><mi class="ltx_font_mathcaligraphic">𝒢</mi><mi>i</mi></msub></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mrow><msubsup><mover accent="true"><mi>y</mi><mo>~</mo></mover><mi>i</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msubsup><mo>−</mo><msubsup><mi>y</mi><mi>i</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msubsup></mrow><mo stretchy="false">]</mo></mrow></mrow><mo>‖</mo></mrow><mn>2</mn></msup><mo>]</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle 3C_{\nabla f}^{2}\mathbb{E}\left[\left\|\mathbb{E}^{\mathcal{H}_{i+1}}_{t}[\tilde{v}_{i+1}^{(t)}-v_{i+1}^{(t)}]\right\|^{2}\right]+6C_{v}^{2}C_{\nabla^{2}f}^{2}\mathbb{E}\left[\left\|\mathbb{E}^{\mathcal{G}_{i}}_{t}[\tilde{y}_{i}^{(t)}-y_{i}^{(t)}]\right\|^{2}\right]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr>
<tr id="S4.E28Xe" class="ltx_equation ltx_eqn_row ltx_align_baseline">
