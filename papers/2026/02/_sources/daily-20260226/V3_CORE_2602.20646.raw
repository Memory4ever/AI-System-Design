<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S4.E32Xa.m3" class="ltx_Math" alttext="\displaystyle 8C_{\nabla^{2}f}^{2}C_{v}^{2}\sum_{i=1}^{N-1}\left(\sum_{j=i}^{N-1}\left[\sum_{k=0}^{j}(3C_{\nabla f}^{2})^{k}\right](4C_{\nabla f}^{2})^{j-i}\right)\mathbb{E}\left[\left\|\mathbb{E}^{\mathcal{G}_{i}}_{t}[\delta_{i}^{(t)}]\right\|^{2}\right]" display="inline" intent=":literal"><semantics><mrow><mn>8</mn><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>C</mi><mrow><msup><mo>∇</mo><mn>2</mn></msup><mi>f</mi></mrow><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>C</mi><mi>v</mi><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mrow><mi>N</mi><mo>−</mo><mn>1</mn></mrow></munderover></mstyle><mrow><mrow><mo>(</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>j</mi><mo>=</mo><mi>i</mi></mrow><mrow><mi>N</mi><mo>−</mo><mn>1</mn></mrow></munderover></mstyle><mrow><mrow><mo>[</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>k</mi><mo>=</mo><mn>0</mn></mrow><mi>j</mi></munderover></mstyle><msup><mrow><mo stretchy="false">(</mo><mrow><mn>3</mn><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>C</mi><mrow><mo rspace="0.167em">∇</mo><mi>f</mi></mrow><mn>2</mn></msubsup></mrow><mo stretchy="false">)</mo></mrow><mi>k</mi></msup></mrow><mo>]</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mn>4</mn><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>C</mi><mrow><mo rspace="0.167em">∇</mo><mi>f</mi></mrow><mn>2</mn></msubsup></mrow><mo stretchy="false">)</mo></mrow><mrow><mi>j</mi><mo>−</mo><mi>i</mi></mrow></msup></mrow></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>𝔼</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><msup><mrow><mo>‖</mo><mrow><msubsup><mi>𝔼</mi><mi>t</mi><msub><mi class="ltx_font_mathcaligraphic">𝒢</mi><mi>i</mi></msub></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><msubsup><mi>δ</mi><mi>i</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msubsup><mo stretchy="false">]</mo></mrow></mrow><mo>‖</mo></mrow><mn>2</mn></msup><mo>]</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle 8C_{\nabla^{2}f}^{2}C_{v}^{2}\sum_{i=1}^{N-1}\left(\sum_{j=i}^{N-1}\left[\sum_{k=0}^{j}(3C_{\nabla f}^{2})^{k}\right](4C_{\nabla f}^{2})^{j-i}\right)\mathbb{E}\left[\left\|\mathbb{E}^{\mathcal{G}_{i}}_{t}[\delta_{i}^{(t)}]\right\|^{2}\right]</annotation></semantics></math></td>
