<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S4.E26Xa.m3" class="ltx_Math" alttext="\displaystyle 2\mathbb{E}\left[\left\|\nabla_{2}f_{i}(\tilde{y}_{i-1}^{(t)},w_{i}^{(t)})\right\|^{2}\left\|\mathbb{E}^{\mathcal{H}_{i}}_{t}[\tilde{v}_{i}^{(t)}-v_{i}^{(t)}]\right\|^{2}\right]" display="inline" intent=":literal"><semantics><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>𝔼</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><mrow><msup><mrow><mo>‖</mo><mrow><mrow><msub><mo rspace="0.167em">∇</mo><mn>2</mn></msub><msub><mi>f</mi><mi>i</mi></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msubsup><mover accent="true"><mi>y</mi><mo>~</mo></mover><mrow><mi>i</mi><mo>−</mo><mn>1</mn></mrow><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msubsup><mo>,</mo><msubsup><mi>w</mi><mi>i</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msubsup><mo stretchy="false">)</mo></mrow></mrow><mo>‖</mo></mrow><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo>‖</mo><mrow><msubsup><mi>𝔼</mi><mi>t</mi><msub><mi class="ltx_font_mathcaligraphic">ℋ</mi><mi>i</mi></msub></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mrow><msubsup><mover accent="true"><mi>v</mi><mo>~</mo></mover><mi>i</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msubsup><mo>−</mo><msubsup><mi>v</mi><mi>i</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msubsup></mrow><mo stretchy="false">]</mo></mrow></mrow><mo>‖</mo></mrow><mn>2</mn></msup></mrow><mo>]</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle 2\mathbb{E}\left[\left\|\nabla_{2}f_{i}(\tilde{y}_{i-1}^{(t)},w_{i}^{(t)})\right\|^{2}\left\|\mathbb{E}^{\mathcal{H}_{i}}_{t}[\tilde{v}_{i}^{(t)}-v_{i}^{(t)}]\right\|^{2}\right]</annotation></semantics></math></td>
