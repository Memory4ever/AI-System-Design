<td id="S5.T1.2.1.11.6" class="ltx_td ltx_align_center ltx_border_b ltx_border_t" style="padding-top:0.75pt;padding-bottom:0.75pt;">78.9</td>
<td id="S5.T1.2.1.11.7" class="ltx_td ltx_align_center ltx_border_b ltx_border_t" style="padding-top:0.75pt;padding-bottom:0.75pt;">72.9</td>
<td id="S5.T1.2.1.11.8" class="ltx_td ltx_align_center ltx_border_b ltx_border_t" style="padding-top:0.75pt;padding-bottom:0.75pt;">77.5</td>
