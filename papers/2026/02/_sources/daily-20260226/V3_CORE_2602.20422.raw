<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.E17X.m3" class="ltx_Math" alttext="\displaystyle=\frac{1}{\sqrt{\alpha_{k}\alpha_{k-1}}}\bm{\tau}^{k}-\frac{1-\alpha_{k}}{\sqrt{(1-\bar{\alpha}_{k})\alpha_{k}\alpha_{k-1}}}\epsilon_{\theta}(\bm{\tau}^{k},k)-\frac{1-\alpha_{k-1}}{\sqrt{(1-\bar{\alpha}_{k-1})\alpha_{k-1}}}\epsilon_{\theta}(\bm{\tau}^{k-1},k-1)" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><msqrt><mrow><msub><mi>α</mi><mi>k</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>α</mi><mrow><mi>k</mi><mo>−</mo><mn>1</mn></mrow></msub></mrow></msqrt></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝝉</mi><mi>k</mi></msup></mrow><mo>−</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mn>1</mn><mo>−</mo><msub><mi>α</mi><mi>k</mi></msub></mrow><msqrt><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msub><mover accent="true"><mi>α</mi><mo>¯</mo></mover><mi>k</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>α</mi><mi>k</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>α</mi><mrow><mi>k</mi><mo>−</mo><mn>1</mn></mrow></msub></mrow></msqrt></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msub><mi>ϵ</mi><mi>θ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>𝝉</mi><mi>k</mi></msup><mo>,</mo><mi>k</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mn>1</mn><mo>−</mo><msub><mi>α</mi><mrow><mi>k</mi><mo>−</mo><mn>1</mn></mrow></msub></mrow><msqrt><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msub><mover accent="true"><mi>α</mi><mo>¯</mo></mover><mrow><mi>k</mi><mo>−</mo><mn>1</mn></mrow></msub></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>α</mi><mrow><mi>k</mi><mo>−</mo><mn>1</mn></mrow></msub></mrow></msqrt></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msub><mi>ϵ</mi><mi>θ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>𝝉</mi><mrow><mi>k</mi><mo>−</mo><mn>1</mn></mrow></msup><mo>,</mo><mrow><mi>k</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\frac{1}{\sqrt{\alpha_{k}\alpha_{k-1}}}\bm{\tau}^{k}-\frac{1-\alpha_{k}}{\sqrt{(1-\bar{\alpha}_{k})\alpha_{k}\alpha_{k-1}}}\epsilon_{\theta}(\bm{\tau}^{k},k)-\frac{1-\alpha_{k-1}}{\sqrt{(1-\bar{\alpha}_{k-1})\alpha_{k-1}}}\epsilon_{\theta}(\bm{\tau}^{k-1},k-1)</annotation></semantics></math></td>
