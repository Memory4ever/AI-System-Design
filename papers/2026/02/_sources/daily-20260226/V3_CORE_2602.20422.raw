<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.E16Xc.m2" class="ltx_Math" alttext="\displaystyle+\sigma_{k-1}\bm{\epsilon}_{k-1}" display="inline" intent=":literal"><semantics><mrow><mo>+</mo><mrow><msub><mi>σ</mi><mrow><mi>k</mi><mo>−</mo><mn>1</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi class="ltx_mathvariant_bold-italic" mathvariant="bold-italic">ϵ</mi><mrow><mi>k</mi><mo>−</mo><mn>1</mn></mrow></msub></mrow></mrow><annotation encoding="application/x-tex">\displaystyle+\sigma_{k-1}\bm{\epsilon}_{k-1}</annotation></semantics></math></td>
