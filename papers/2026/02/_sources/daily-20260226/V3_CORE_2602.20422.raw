<tr id="A2.E16Xd" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.E16Xd.m2" class="ltx_Math" alttext="\displaystyle=\frac{1}{\sqrt{\alpha_{k}\alpha_{k-1}}}\bm{\tau}^{k}-\frac{1-\alpha_{k}}{\sqrt{(1-\bar{\alpha}_{k})\alpha_{k}\alpha_{k-1}}}\epsilon_{\theta}(\bm{\tau}^{k},k)-\frac{1-\alpha_{k-1}}{\sqrt{(1-\bar{\alpha}_{k-1})\alpha_{k-1}}}\epsilon_{\theta}(\bm{\tau}^{k-1},k-1)" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><msqrt><mrow><msub><mi>α</mi><mi>k</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>α</mi><mrow><mi>k</mi><mo>−</mo><mn>1</mn></mrow></msub></mrow></msqrt></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝝉</mi><mi>k</mi></msup></mrow><mo>−</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mn>1</mn><mo>−</mo><msub><mi>α</mi><mi>k</mi></msub></mrow><msqrt><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msub><mover accent="true"><mi>α</mi><mo>¯</mo></mover><mi>k</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>α</mi><mi>k</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>α</mi><mrow><mi>k</mi><mo>−</mo><mn>1</mn></mrow></msub></mrow></msqrt></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msub><mi>ϵ</mi><mi>θ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>𝝉</mi><mi>k</mi></msup><mo>,</mo><mi>k</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mn>1</mn><mo>−</mo><msub><mi>α</mi><mrow><mi>k</mi><mo>−</mo><mn>1</mn></mrow></msub></mrow><msqrt><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msub><mover accent="true"><mi>α</mi><mo>¯</mo></mover><mrow><mi>k</mi><mo>−</mo><mn>1</mn></mrow></msub></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>α</mi><mrow><mi>k</mi><mo>−</mo><mn>1</mn></mrow></msub></mrow></msqrt></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msub><mi>ϵ</mi><mi>θ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>𝝉</mi><mrow><mi>k</mi><mo>−</mo><mn>1</mn></mrow></msup><mo>,</mo><mrow><mi>k</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\frac{1}{\sqrt{\alpha_{k}\alpha_{k-1}}}\bm{\tau}^{k}-\frac{1-\alpha_{k}}{\sqrt{(1-\bar{\alpha}_{k})\alpha_{k}\alpha_{k-1}}}\epsilon_{\theta}(\bm{\tau}^{k},k)-\frac{1-\alpha_{k-1}}{\sqrt{(1-\bar{\alpha}_{k-1})\alpha_{k-1}}}\epsilon_{\theta}(\bm{\tau}^{k-1},k-1)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr>
<tr id="A2.E16Xe" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.E16Xe.m2" class="ltx_Math" alttext="\displaystyle+\frac{1}{\sqrt{\alpha_{k-1}}}\sigma_{k}\bm{\epsilon}_{k}+\sigma_{k-1}\bm{\epsilon}_{k-1}." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mo>+</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><msqrt><msub><mi>α</mi><mrow><mi>k</mi><mo>−</mo><mn>1</mn></mrow></msub></msqrt></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msub><mi>σ</mi><mi>k</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi class="ltx_mathvariant_bold-italic" mathvariant="bold-italic">ϵ</mi><mi>k</mi></msub></mrow></mrow><mo>+</mo><mrow><msub><mi>σ</mi><mrow><mi>k</mi><mo>−</mo><mn>1</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi class="ltx_mathvariant_bold-italic" mathvariant="bold-italic">ϵ</mi><mrow><mi>k</mi><mo>−</mo><mn>1</mn></mrow></msub></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle+\frac{1}{\sqrt{\alpha_{k-1}}}\sigma_{k}\bm{\epsilon}_{k}+\sigma_{k-1}\bm{\epsilon}_{k-1}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A2.p2.4" class="ltx_p"><span id="A2.p2.4.1" class="ltx_text">The introduced noise <math id="A2.p2.m13" class="ltx_Math" alttext="\bm{\epsilon}_{k-1}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_mathvariant_bold-italic" mathvariant="bold-italic">ϵ</mi><mrow><mi>k</mi><mo>−</mo><mn>1</mn></mrow></msub><annotation encoding="application/x-tex">\bm{\epsilon}_{k-1}</annotation></semantics></math> in diffusion step <math id="A2.p2.m14" class="ltx_Math" alttext="k-1" display="inline" intent=":literal"><semantics><mrow><mi>k</mi><mo>−</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">k-1</annotation></semantics></math> can be combined with the noise <math id="A2.p2.m15" class="ltx_Math" alttext="\bm{\epsilon}_{k}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_mathvariant_bold-italic" mathvariant="bold-italic">ϵ</mi><mi>k</mi></msub><annotation encoding="application/x-tex">\bm{\epsilon}_{k}</annotation></semantics></math> at diffusion step <math id="A2.p2.m16" class="ltx_Math" alttext="k" display="inline" intent=":literal"><semantics><mi>k</mi><annotation encoding="application/x-tex">k</annotation></semantics></math> into a joint noise term, <math id="A2.p2.m17" class="ltx_Math" alttext="\bar{\bm{\epsilon}}_{k-1}" display="inline" intent=":literal"><semantics><msub><mover accent="true"><mi class="ltx_mathvariant_bold-italic" mathvariant="bold-italic">ϵ</mi><mo>¯</mo></mover><mrow><mi>k</mi><mo>−</mo><mn>1</mn></mrow></msub><annotation encoding="application/x-tex">\bar{\bm{\epsilon}}_{k-1}</annotation></semantics></math>, by merging two Gaussian distributions, <math id="A2.p2.m18" class="ltx_Math" alttext="\mathcal{N}(0,\frac{\sigma_{k}^{2}}{\alpha_{k-1}}\mathbf{I})" display="inline" intent=":literal"><semantics><mrow><mi class="ltx_font_mathcaligraphic">𝒩</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mn>0</mn><mo>,</mo><mrow><mfrac><msubsup><mi>σ</mi><mi>k</mi><mn>2</mn></msubsup><msub><mi>α</mi><mrow><mi>k</mi><mo>−</mo><mn>1</mn></mrow></msub></mfrac><mo lspace="0em" rspace="0em">​</mo><mi>𝐈</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathcal{N}(0,\frac{\sigma_{k}^{2}}{\alpha_{k-1}}\mathbf{I})</annotation></semantics></math> and <math id="A2.p2.m19" class="ltx_Math" alttext="\mathcal{N}(0,\sigma_{k-1}^{2}\mathbf{I})" display="inline" intent=":literal"><semantics><mrow><mi class="ltx_font_mathcaligraphic">𝒩</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mn>0</mn><mo>,</mo><mrow><msubsup><mi>σ</mi><mrow><mi>k</mi><mo>−</mo><mn>1</mn></mrow><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>𝐈</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathcal{N}(0,\sigma_{k-1}^{2}\mathbf{I})</annotation></semantics></math>, into <math id="A2.p2.m20" class="ltx_Math" alttext="\mathcal{N}(0,(\frac{\sigma_{k}^{2}}{\alpha_{k-1}}+\sigma_{k-1}^{2})\mathbf{I})" display="inline" intent=":literal"><semantics><mrow><mi class="ltx_font_mathcaligraphic">𝒩</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mn>0</mn><mo>,</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mfrac><msubsup><mi>σ</mi><mi>k</mi><mn>2</mn></msubsup><msub><mi>α</mi><mrow><mi>k</mi><mo>−</mo><mn>1</mn></mrow></msub></mfrac><mo>+</mo><msubsup><mi>σ</mi><mrow><mi>k</mi><mo>−</mo><mn>1</mn></mrow><mn>2</mn></msubsup></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>𝐈</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathcal{N}(0,(\frac{\sigma_{k}^{2}}{\alpha_{k-1}}+\sigma_{k-1}^{2})\mathbf{I})</annotation></semantics></math>. Consequently, we obtain the distribution for the denoised data <math id="A2.p2.m21" class="ltx_Math" alttext="\widehat{\bm{\tau}}^{k-2}" display="inline" intent=":literal"><semantics><msup><mover accent="true"><mi>𝝉</mi><mo>^</mo></mover><mrow><mi>k</mi><mo>−</mo><mn>2</mn></mrow></msup><annotation encoding="application/x-tex">\widehat{\bm{\tau}}^{k-2}</annotation></semantics></math> with only directly computable terms, where</span></p>
<table id="A2.E17" class="ltx_equationgroup ltx_eqn_table">
<tbody>
