<section id="A1" class="ltx_appendix">
<h2 class="ltx_title ltx_title_appendix"><span class="ltx_tag ltx_tag_appendix">Appendix A </span>Diffusion Training Algorithm</h2>

<figure id="alg2" class="ltx_float ltx_float_algorithm ltx_framed ltx_framed_top">
<figcaption class="ltx_caption"><span class="ltx_tag ltx_tag_float"><span id="alg2.3" class="ltx_text ltx_font_bold">Algorithm 2</span> </span> Diffusion Training</figcaption>
<div id="alg2.4" class="ltx_listing ltx_framed ltx_framed_topbottom ltx_listing">
<div id="alg2.l0" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline">0:</span>
            
            
           Offline data <math id="alg2.l0.m1" class="ltx_Math" alttext="\mathcal{D}=\{(s_{0}^{i},a_{0}^{i},r_{0}^{i},s_{1}^{i},a_{1}^{i},r_{1}^{i},\dots,s_{T}^{i},a_{T}^{i},r_{T}^{i})\}" display="inline" intent=":literal"><semantics><mrow><mi class="ltx_font_mathcaligraphic">𝒟</mi><mo>=</mo><mrow><mo stretchy="false">{</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>s</mi><mn>0</mn><mi>i</mi></msubsup><mo>,</mo><msubsup><mi>a</mi><mn>0</mn><mi>i</mi></msubsup><mo>,</mo><msubsup><mi>r</mi><mn>0</mn><mi>i</mi></msubsup><mo>,</mo><msubsup><mi>s</mi><mn>1</mn><mi>i</mi></msubsup><mo>,</mo><msubsup><mi>a</mi><mn>1</mn><mi>i</mi></msubsup><mo>,</mo><msubsup><mi>r</mi><mn>1</mn><mi>i</mi></msubsup><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msubsup><mi>s</mi><mi>T</mi><mi>i</mi></msubsup><mo>,</mo><msubsup><mi>a</mi><mi>T</mi><mi>i</mi></msubsup><mo>,</mo><msubsup><mi>r</mi><mi>T</mi><mi>i</mi></msubsup><mo stretchy="false">)</mo></mrow><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">\mathcal{D}=\{(s_{0}^{i},a_{0}^{i},r_{0}^{i},s_{1}^{i},a_{1}^{i},r_{1}^{i},\dots,s_{T}^{i},a_{T}^{i},r_{T}^{i})\}</annotation></semantics></math>.

</div>
<div id="alg2.l1" class="ltx_listingline">
            
            
           Learn transition model
<math id="alg2.l1.m1" class="ltx_Math" alttext="\widehat{\mathcal{T}}(s_{t},a_{t})" display="inline" intent=":literal"><semantics><mrow><mover accent="true"><mi class="ltx_font_mathcaligraphic">𝒯</mi><mo>^</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>s</mi><mi>t</mi></msub><mo>,</mo><msub><mi>a</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\widehat{\mathcal{T}}(s_{t},a_{t})</annotation></semantics></math> and reward function <math id="alg2.l1.m2" class="ltx_Math" alttext="\widehat{\mathcal{R}}(s_{t},a_{t})" display="inline" intent=":literal"><semantics><mrow><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℛ</mi><mo>^</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>s</mi><mi>t</mi></msub><mo>,</mo><msub><mi>a</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\widehat{\mathcal{R}}(s_{t},a_{t})</annotation></semantics></math> from offline data <math id="alg2.l1.m3" class="ltx_Math" alttext="\mathcal{D}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">𝒟</mi><annotation encoding="application/x-tex">\mathcal{D}</annotation></semantics></math>.

</div>
<div id="alg2.l2" class="ltx_listingline">
            
            
           Initialize noise network <math id="alg2.l2.m1" class="ltx_Math" alttext="\epsilon_{\theta}(\tau^{k},k)" display="inline" intent=":literal"><semantics><mrow><msub><mi>ϵ</mi><mi>θ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>τ</mi><mi>k</mi></msup><mo>,</mo><mi>k</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\epsilon_{\theta}(\tau^{k},k)</annotation></semantics></math>.

</div>
<div id="alg2.l3" class="ltx_listingline">
            
            
           <span id="alg2.l3.2" class="ltx_text ltx_font_bold">while</span> not converged <span id="alg2.l3.3" class="ltx_text ltx_font_bold">do</span>



</div>
<div id="alg2.l4" class="ltx_listingline">
            
            
            Sample a trajectory from offline data <math id="alg2.l4.m1" class="ltx_Math" alttext="\bm{\tau}^{0}\sim\mathcal{D}" display="inline" intent=":literal"><semantics><mrow><msup><mi>𝝉</mi><mn>0</mn></msup><mo>∼</mo><mi class="ltx_font_mathcaligraphic">𝒟</mi></mrow><annotation encoding="application/x-tex">\bm{\tau}^{0}\sim\mathcal{D}</annotation></semantics></math>.

</div>
<div id="alg2.l5" class="ltx_listingline">
            
            
            Sample a random diffusion step <math id="alg2.l5.m1" class="ltx_Math" alttext="k\sim\mathcal{U}(1,K)" display="inline" intent=":literal"><semantics><mrow><mi>k</mi><mo>∼</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒰</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mn>1</mn><mo>,</mo><mi>K</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">k\sim\mathcal{U}(1,K)</annotation></semantics></math>.

</div>
<div id="alg2.l6" class="ltx_listingline">
            
            
            Sample a random noise <math id="alg2.l6.m1" class="ltx_Math" alttext="\bm{\epsilon}\sim\mathcal{N}(0,\mathbf{I})" display="inline" intent=":literal"><semantics><mrow><mi class="ltx_mathvariant_bold-italic" mathvariant="bold-italic">ϵ</mi><mo>∼</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒩</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mn>0</mn><mo>,</mo><mi>𝐈</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\bm{\epsilon}\sim\mathcal{N}(0,\mathbf{I})</annotation></semantics></math>.

</div>
<div id="alg2.l7" class="ltx_listingline">
            
            
            Calculate the gradient <math id="alg2.l7.m1" class="ltx_Math" alttext="\nabla_{\theta}L_{\text{total}}" display="inline" intent=":literal"><semantics><mrow><msub><mo>∇</mo><mi>θ</mi></msub><msub><mi>L</mi><mtext>total</mtext></msub></mrow><annotation encoding="application/x-tex">\nabla_{\theta}L_{\text{total}}</annotation></semantics></math> of Eq. (<a href="#S4.E12" title="In 4.1.4 Full Modulation Framework ‣ 4.1 Modulation of Diffusion Training ‣ 4 Method ‣ Diffusion Modulation via Environment Mechanism Modeling for Planning" class="ltx_ref"><span class="ltx_text ltx_ref_tag">12</span></a>) and take gradient descent step.

</div>
<div id="alg2.l8" class="ltx_listingline">
            
            
           <span id="alg2.l8.2" class="ltx_text ltx_font_bold">end</span> <span id="alg2.l8.3" class="ltx_text ltx_font_bold">while</span>
</div>
</div>
</figure>
<div id="A1.p1" class="ltx_para ltx_noindent">
<p id="A1.p1.1" class="ltx_p">The complete training process of the diffusion model is presented in Algorithm <a href="#alg2" title="Algorithm 2 ‣ Appendix A Diffusion Training Algorithm ‣ Diffusion Modulation via Environment Mechanism Modeling for Planning" class="ltx_ref"><span class="ltx_text ltx_ref_tag">2</span></a>. Prior to training the diffusion model,
a probabilistic transition
model <math id="A1.p1.m1" class="ltx_Math" alttext="\widehat{\mathcal{T}}(s_{t},a_{t})" display="inline" intent=":literal"><semantics><mrow><mover accent="true"><mi class="ltx_font_mathcaligraphic">𝒯</mi><mo>^</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>s</mi><mi>t</mi></msub><mo>,</mo><msub><mi>a</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\widehat{\mathcal{T}}(s_{t},a_{t})</annotation></semantics></math> and a reward model <math id="A1.p1.m2" class="ltx_Math" alttext="\widehat{\mathcal{R}}(s_{t},a_{t})" display="inline" intent=":literal"><semantics><mrow><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℛ</mi><mo>^</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>s</mi><mi>t</mi></msub><mo>,</mo><msub><mi>a</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\widehat{\mathcal{R}}(s_{t},a_{t})</annotation></semantics></math> are learned from the offline dataset <math id="A1.p1.m3" class="ltx_Math" alttext="\mathcal{D}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">𝒟</mi><annotation encoding="application/x-tex">\mathcal{D}</annotation></semantics></math>. Afterward, the noise network is initialized and iteratively trained. During each iteration, an original trajectory <math id="A1.p1.m4" class="ltx_Math" alttext="\bm{\tau}^{0}" display="inline" intent=":literal"><semantics><msup><mi>𝝉</mi><mn>0</mn></msup><annotation encoding="application/x-tex">\bm{\tau}^{0}</annotation></semantics></math> is sampled from the offline dataset <math id="A1.p1.m5" class="ltx_Math" alttext="\mathcal{D}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">𝒟</mi><annotation encoding="application/x-tex">\mathcal{D}</annotation></semantics></math>, along with a randomly selected diffusion step <math id="A1.p1.m6" class="ltx_Math" alttext="k" display="inline" intent=":literal"><semantics><mi>k</mi><annotation encoding="application/x-tex">k</annotation></semantics></math> and noise sample <math id="A1.p1.m7" class="ltx_Math" alttext="\bm{\epsilon}" display="inline" intent=":literal"><semantics><mi class="ltx_mathvariant_bold-italic" mathvariant="bold-italic">ϵ</mi><annotation encoding="application/x-tex">\bm{\epsilon}</annotation></semantics></math>. Gradient descent is then applied to minimize the total loss
<math id="A1.p1.m8" class="ltx_Math" alttext="L_{\text{total}}" display="inline" intent=":literal"><semantics><msub><mi>L</mi><mtext>total</mtext></msub><annotation encoding="application/x-tex">L_{\text{total}}</annotation></semantics></math>.</p>
</div>
</section>
<section id="A2" class="ltx_appendix">
<h2 class="ltx_title ltx_title_appendix"><span class="ltx_tag ltx_tag_appendix">Appendix B </span>Proof of Proposition <a href="#S4.EGx2" title="Proposition 1. ‣ 4.1 Modulation of Diffusion Training ‣ 4 Method ‣ Diffusion Modulation via Environment Mechanism Modeling for Planning" class="ltx_ref"><span class="ltx_text ltx_ref_tag">1</span></a></h2>

<div id="A2.p1" class="ltx_para">
<p id="A2.p1.1" class="ltx_p">In this section, we present the proof of Proposition <a href="#S4.EGx2" title="Proposition 1. ‣ 4.1 Modulation of Diffusion Training ‣ 4 Method ‣ Diffusion Modulation via Environment Mechanism Modeling for Planning" class="ltx_ref"><span class="ltx_text ltx_ref_tag">1</span></a>.</p>
</div>
<div id="A2.2" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="A2.p2" class="ltx_para ltx_noindent">
<p id="A2.p2.1" class="ltx_p"><span id="A2.p2.1.1" class="ltx_text">To incorporate key RL mechanisms into the training of the diffusion model, we explore the denoising process and trace the denoised data through the reverse diffusion process. Let <math id="A2.p2.m1" class="ltx_Math" alttext="\widehat{\bm{\tau}}^{0}" display="inline" intent=":literal"><semantics><msup><mover accent="true"><mi>𝝉</mi><mo>^</mo></mover><mn>0</mn></msup><annotation encoding="application/x-tex">\widehat{\bm{\tau}}^{0}</annotation></semantics></math>
represent the denoised output trajectory.
It can be gradually denoised using the reverse process, following the chain rule: <math id="A2.p2.m2" class="ltx_Math" alttext="\widehat{\bm{\tau}}^{0}\sim p_{\theta}(\bm{\tau}^{K})\prod_{k=1}^{K}p_{\theta}(\bm{\tau}^{k-1}|\bm{\tau}^{k})" display="inline" intent=":literal"><semantics><mrow><msup><mover accent="true"><mi>𝝉</mi><mo>^</mo></mover><mn>0</mn></msup><mo>∼</mo><mrow><msub><mi>p</mi><mi>θ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>𝝉</mi><mi>K</mi></msup><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><msubsup><mo>∏</mo><mrow><mi>k</mi><mo>=</mo><mn>1</mn></mrow><mi>K</mi></msubsup><mrow><msub><mi>p</mi><mi>θ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>𝝉</mi><mrow><mi>k</mi><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">|</mo><msup><mi>𝝉</mi><mi>k</mi></msup><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\widehat{\bm{\tau}}^{0}\sim p_{\theta}(\bm{\tau}^{K})\prod_{k=1}^{K}p_{\theta}(\bm{\tau}^{k-1}|\bm{\tau}^{k})</annotation></semantics></math>,
where the detailed reverse process is defined in Eq. (<a href="#S3.E3" title="In Trajectory Diffusion ‣ 3.1 Planning with Diffusion Model ‣ 3 Preliminaries ‣ Diffusion Modulation via Environment Mechanism Modeling for Planning" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3</span></a>) and Eq. (<a href="#S3.E4" title="In Trajectory Diffusion ‣ 3.1 Planning with Diffusion Model ‣ 3 Preliminaries ‣ Diffusion Modulation via Environment Mechanism Modeling for Planning" class="ltx_ref"><span class="ltx_text ltx_ref_tag">4</span></a>). Starting from an intermediate trajectory <math id="A2.p2.m3" class="ltx_Math" alttext="\bm{\tau}^{k}" display="inline" intent=":literal"><semantics><msup><mi>𝝉</mi><mi>k</mi></msup><annotation encoding="application/x-tex">\bm{\tau}^{k}</annotation></semantics></math> at step <math id="A2.p2.m4" class="ltx_Math" alttext="k" display="inline" intent=":literal"><semantics><mi>k</mi><annotation encoding="application/x-tex">k</annotation></semantics></math>,
by combining these two equations,
the trajectory at the next diffusion step, <math id="A2.p2.m5" class="ltx_Math" alttext="k-1" display="inline" intent=":literal"><semantics><mrow><mi>k</mi><mo>−</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">k-1</annotation></semantics></math>, can be directly sampled from the distribution:</span></p>
<table id="A2.E14" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A2.E14.m1" class="ltx_Math" alttext="\widehat{\bm{\tau}}^{k-1}\sim\mathcal{N}\left(\frac{1}{\sqrt{\alpha_{k}}}\left(\bm{\tau}^{k}-\frac{1-\alpha_{k}}{\sqrt{1-\bar{\alpha}_{k}}}\epsilon_{\theta}(\bm{\tau}^{k},k)\right),\sigma_{k}^{2}\mathbf{I}\right)." display="block" intent=":literal"><semantics><mrow><mrow><msup><mover accent="true"><mi>𝝉</mi><mo>^</mo></mover><mrow><mi>k</mi><mo>−</mo><mn>1</mn></mrow></msup><mo>∼</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒩</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mfrac><mn>1</mn><msqrt><msub><mi>α</mi><mi>k</mi></msub></msqrt></mfrac><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><msup><mi>𝝉</mi><mi>k</mi></msup><mo>−</mo><mrow><mfrac><mrow><mn>1</mn><mo>−</mo><msub><mi>α</mi><mi>k</mi></msub></mrow><msqrt><mrow><mn>1</mn><mo>−</mo><msub><mover accent="true"><mi>α</mi><mo>¯</mo></mover><mi>k</mi></msub></mrow></msqrt></mfrac><mo lspace="0em" rspace="0em">​</mo><msub><mi>ϵ</mi><mi>θ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>𝝉</mi><mi>k</mi></msup><mo>,</mo><mi>k</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>)</mo></mrow></mrow><mo>,</mo><mrow><msubsup><mi>σ</mi><mi>k</mi><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>𝐈</mi></mrow><mo>)</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\widehat{\bm{\tau}}^{k-1}\sim\mathcal{N}\left(\frac{1}{\sqrt{\alpha_{k}}}\left(\bm{\tau}^{k}-\frac{1-\alpha_{k}}{\sqrt{1-\bar{\alpha}_{k}}}\epsilon_{\theta}(\bm{\tau}^{k},k)\right),\sigma_{k}^{2}\mathbf{I}\right).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(14)</span></td></tr></tbody>
</table>
<p id="A2.p2.2" class="ltx_p"><span id="A2.p2.2.1" class="ltx_text">By applying the reparameterization trick <cite class="ltx_cite ltx_citemacro_citep">(<a href="#bib.bib29" title="" class="ltx_ref">Kingma and Welling, 2014</a>)</cite>, we can derive a closed-form solution for the above distribution. Let <math id="A2.p2.m6" class="ltx_Math" alttext="\bm{\epsilon}_{k}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_mathvariant_bold-italic" mathvariant="bold-italic">ϵ</mi><mi>k</mi></msub><annotation encoding="application/x-tex">\bm{\epsilon}_{k}</annotation></semantics></math> represent the noise introduced in the reverse process <math id="A2.p2.m7" class="ltx_Math" alttext="p_{\theta}(\bm{\tau}^{k-1}|\bm{\tau}_{k})" display="inline" intent=":literal"><semantics><mrow><msub><mi>p</mi><mi>θ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>𝝉</mi><mrow><mi>k</mi><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">|</mo><msub><mi>𝝉</mi><mi>k</mi></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">p_{\theta}(\bm{\tau}^{k-1}|\bm{\tau}_{k})</annotation></semantics></math>, and the denoised trajectory can then be formulated as:</span></p>
<table id="A2.E15" class="ltx_equationgroup ltx_eqn_table">
<tbody>
<tr id="A2.E15X" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A2.E15X.m2" class="ltx_Math" alttext="\displaystyle\widehat{\bm{\tau}}^{k-1}" display="inline" intent=":literal"><semantics><msup><mover accent="true"><mi>𝝉</mi><mo>^</mo></mover><mrow><mi>k</mi><mo>−</mo><mn>1</mn></mrow></msup><annotation encoding="application/x-tex">\displaystyle\widehat{\bm{\tau}}^{k-1}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.E15X.m3" class="ltx_Math" alttext="\displaystyle=\frac{1}{\sqrt{\alpha_{k}}}\left(\bm{\tau}^{k}-\frac{1-\alpha_{k}}{\sqrt{1-\bar{\alpha}_{k}}}\epsilon_{\theta}(\bm{\tau}^{k},k)\right)+\sigma_{k}\bm{\epsilon}_{k}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><msqrt><msub><mi>α</mi><mi>k</mi></msub></msqrt></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><msup><mi>𝝉</mi><mi>k</mi></msup><mo>−</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mn>1</mn><mo>−</mo><msub><mi>α</mi><mi>k</mi></msub></mrow><msqrt><mrow><mn>1</mn><mo>−</mo><msub><mover accent="true"><mi>α</mi><mo>¯</mo></mover><mi>k</mi></msub></mrow></msqrt></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msub><mi>ϵ</mi><mi>θ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>𝝉</mi><mi>k</mi></msup><mo mathsize="0.700em">,</mo><mi>k</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>)</mo></mrow></mrow><mo>+</mo><mrow><msub><mi>σ</mi><mi>k</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi class="ltx_mathvariant_bold-italic" mathvariant="bold-italic">ϵ</mi><mi>k</mi></msub></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\frac{1}{\sqrt{\alpha_{k}}}\left(\bm{\tau}^{k}-\frac{1-\alpha_{k}}{\sqrt{1-\bar{\alpha}_{k}}}\epsilon_{\theta}(\bm{\tau}^{k},k)\right)+\sigma_{k}\bm{\epsilon}_{k}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="2" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equationgroup ltx_align_right">(15)</span></td></tr>
<tr id="A2.E15Xa" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.E15Xa.m2" class="ltx_Math" alttext="\displaystyle=\frac{1}{\sqrt{\alpha_{k}}}\bm{\tau}^{k}-\frac{1-\alpha_{k}}{\sqrt{(1-\bar{\alpha}_{k})\alpha_{k}}}\epsilon_{\theta}(\bm{\tau}^{k},k)+\sigma_{k}\bm{\epsilon}_{k}." display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><msqrt><msub><mi>α</mi><mi>k</mi></msub></msqrt></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝝉</mi><mi>k</mi></msup></mrow><mo>−</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mn>1</mn><mo>−</mo><msub><mi>α</mi><mi>k</mi></msub></mrow><msqrt><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msub><mover accent="true"><mi>α</mi><mo>¯</mo></mover><mi>k</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>α</mi><mi>k</mi></msub></mrow></msqrt></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msub><mi>ϵ</mi><mi>θ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>𝝉</mi><mi>k</mi></msup><mo>,</mo><mi>k</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>+</mo><mrow><msub><mi>σ</mi><mi>k</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi class="ltx_mathvariant_bold-italic" mathvariant="bold-italic">ϵ</mi><mi>k</mi></msub></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle=\frac{1}{\sqrt{\alpha_{k}}}\bm{\tau}^{k}-\frac{1-\alpha_{k}}{\sqrt{(1-\bar{\alpha}_{k})\alpha_{k}}}\epsilon_{\theta}(\bm{\tau}^{k},k)+\sigma_{k}\bm{\epsilon}_{k}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A2.p2.3" class="ltx_p"><span id="A2.p2.3.1" class="ltx_text">In the following diffusion step <math id="A2.p2.m8" class="ltx_Math" alttext="k-2" display="inline" intent=":literal"><semantics><mrow><mi>k</mi><mo>−</mo><mn>2</mn></mrow><annotation encoding="application/x-tex">k-2</annotation></semantics></math>, the denoised data <math id="A2.p2.m9" class="ltx_Math" alttext="\widehat{\bm{\tau}}^{k-2}" display="inline" intent=":literal"><semantics><msup><mover accent="true"><mi>𝝉</mi><mo>^</mo></mover><mrow><mi>k</mi><mo>−</mo><mn>2</mn></mrow></msup><annotation encoding="application/x-tex">\widehat{\bm{\tau}}^{k-2}</annotation></semantics></math> is sampled from a similar Gaussian distribution. By the Central Limit Theorem, <math id="A2.p2.m10" class="ltx_Math" alttext="\widehat{\bm{\tau}}^{k-1}" display="inline" intent=":literal"><semantics><msup><mover accent="true"><mi>𝝉</mi><mo>^</mo></mover><mrow><mi>k</mi><mo>−</mo><mn>1</mn></mrow></msup><annotation encoding="application/x-tex">\widehat{\bm{\tau}}^{k-1}</annotation></semantics></math> serves as an unbiased estimate of <math id="A2.p2.m11" class="ltx_Math" alttext="\bm{\tau}^{k-1}" display="inline" intent=":literal"><semantics><msup><mi>𝝉</mi><mrow><mi>k</mi><mo>−</mo><mn>1</mn></mrow></msup><annotation encoding="application/x-tex">\bm{\tau}^{k-1}</annotation></semantics></math>. Therefore, the denoised data <math id="A2.p2.m12" class="ltx_Math" alttext="\widehat{\bm{\tau}}^{k-2}" display="inline" intent=":literal"><semantics><msup><mover accent="true"><mi>𝝉</mi><mo>^</mo></mover><mrow><mi>k</mi><mo>−</mo><mn>2</mn></mrow></msup><annotation encoding="application/x-tex">\widehat{\bm{\tau}}^{k-2}</annotation></semantics></math> can be expressed as follows:</span></p>
<table id="A2.E16" class="ltx_equationgroup ltx_eqn_table">
<tbody>
<tr id="A2.E16X" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A2.E16X.m2" class="ltx_Math" alttext="\displaystyle\widehat{\bm{\tau}}^{k-2}" display="inline" intent=":literal"><semantics><msup><mover accent="true"><mi>𝝉</mi><mo>^</mo></mover><mrow><mi>k</mi><mo>−</mo><mn>2</mn></mrow></msup><annotation encoding="application/x-tex">\displaystyle\widehat{\bm{\tau}}^{k-2}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.E16X.m3" class="ltx_Math" alttext="\displaystyle\sim\mathcal{N}\left(\frac{1}{\sqrt{\alpha_{k-1}}}\left(\bm{\tau}^{k-1}-\frac{1-\alpha_{k-1}}{\sqrt{1-\bar{\alpha}_{k-1}}}\epsilon_{\theta}(\bm{\tau}^{k-1},k-1)\right),\sigma_{k-1}^{2}\mathbf{I}\right)" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>∼</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒩</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><msqrt><msub><mi>α</mi><mrow><mi>k</mi><mo>−</mo><mn>1</mn></mrow></msub></msqrt></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><msup><mi>𝝉</mi><mrow><mi>k</mi><mo>−</mo><mn>1</mn></mrow></msup><mo>−</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mn>1</mn><mo>−</mo><msub><mi>α</mi><mrow><mi>k</mi><mo>−</mo><mn>1</mn></mrow></msub></mrow><msqrt><mrow><mn>1</mn><mo>−</mo><msub><mover accent="true"><mi>α</mi><mo>¯</mo></mover><mrow><mi>k</mi><mo>−</mo><mn>1</mn></mrow></msub></mrow></msqrt></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msub><mi>ϵ</mi><mi>θ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>𝝉</mi><mrow><mi>k</mi><mo>−</mo><mn>1</mn></mrow></msup><mo>,</mo><mrow><mi>k</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>)</mo></mrow></mrow><mo>,</mo><mrow><msubsup><mi>σ</mi><mrow><mi>k</mi><mo>−</mo><mn>1</mn></mrow><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>𝐈</mi></mrow><mo>)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\sim\mathcal{N}\left(\frac{1}{\sqrt{\alpha_{k-1}}}\left(\bm{\tau}^{k-1}-\frac{1-\alpha_{k-1}}{\sqrt{1-\bar{\alpha}_{k-1}}}\epsilon_{\theta}(\bm{\tau}^{k-1},k-1)\right),\sigma_{k-1}^{2}\mathbf{I}\right)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="6" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equationgroup ltx_align_right">(16)</span></td></tr>
<tr id="A2.E16Xa" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.E16Xa.m2" class="ltx_Math" alttext="\displaystyle=\frac{1}{\sqrt{\alpha_{k-1}}}\left(\widehat{\bm{\tau}}^{k-1}-\frac{1-\alpha_{k-1}}{\sqrt{1-\bar{\alpha}_{k-1}}}\epsilon_{\theta}(\bm{\tau}^{k-1},k-1)\right)+\sigma_{k-1}\bm{\epsilon}_{k-1}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><msqrt><msub><mi>α</mi><mrow><mi>k</mi><mo>−</mo><mn>1</mn></mrow></msub></msqrt></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><msup><mover accent="true"><mi>𝝉</mi><mo>^</mo></mover><mrow><mi>k</mi><mo>−</mo><mn>1</mn></mrow></msup><mo>−</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mn>1</mn><mo>−</mo><msub><mi>α</mi><mrow><mi>k</mi><mo>−</mo><mn>1</mn></mrow></msub></mrow><msqrt><mrow><mn>1</mn><mo>−</mo><msub><mover accent="true"><mi>α</mi><mo>¯</mo></mover><mrow><mi>k</mi><mo>−</mo><mn>1</mn></mrow></msub></mrow></msqrt></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msub><mi>ϵ</mi><mi>θ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>𝝉</mi><mrow><mi>k</mi><mo>−</mo><mn>1</mn></mrow></msup><mo mathsize="0.700em">,</mo><mrow><mi>k</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>)</mo></mrow></mrow><mo>+</mo><mrow><msub><mi>σ</mi><mrow><mi>k</mi><mo>−</mo><mn>1</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi class="ltx_mathvariant_bold-italic" mathvariant="bold-italic">ϵ</mi><mrow><mi>k</mi><mo>−</mo><mn>1</mn></mrow></msub></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\frac{1}{\sqrt{\alpha_{k-1}}}\left(\widehat{\bm{\tau}}^{k-1}-\frac{1-\alpha_{k-1}}{\sqrt{1-\bar{\alpha}_{k-1}}}\epsilon_{\theta}(\bm{\tau}^{k-1},k-1)\right)+\sigma_{k-1}\bm{\epsilon}_{k-1}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr>
<tr id="A2.E16Xb" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.E16Xb.m2" class="ltx_Math" alttext="\displaystyle=\frac{1}{\sqrt{\alpha_{k-1}}}\left(\frac{1}{\sqrt{\alpha_{k}}}\bm{\tau}^{k}-\frac{1-\alpha_{k}}{\sqrt{(1-\bar{\alpha}_{k})\alpha_{k}}}\epsilon_{\theta}(\bm{\tau}^{k},k)-\frac{1-\alpha_{k-1}}{\sqrt{1-\bar{\alpha}_{k-1}}}\epsilon_{\theta}(\bm{\tau}^{k-1},k-1)+\sigma_{k}\bm{\epsilon}_{k}\right)" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><msqrt><msub><mi>α</mi><mrow><mi>k</mi><mo>−</mo><mn>1</mn></mrow></msub></msqrt></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mrow><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><msqrt><msub><mi>α</mi><mi>k</mi></msub></msqrt></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝝉</mi><mi>k</mi></msup></mrow><mo>−</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mn>1</mn><mo>−</mo><msub><mi>α</mi><mi>k</mi></msub></mrow><msqrt><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msub><mover accent="true"><mi>α</mi><mo>¯</mo></mover><mi>k</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>α</mi><mi>k</mi></msub></mrow></msqrt></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msub><mi>ϵ</mi><mi>θ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>𝝉</mi><mi>k</mi></msup><mo>,</mo><mi>k</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mn>1</mn><mo>−</mo><msub><mi>α</mi><mrow><mi>k</mi><mo>−</mo><mn>1</mn></mrow></msub></mrow><msqrt><mrow><mn>1</mn><mo>−</mo><msub><mover accent="true"><mi>α</mi><mo>¯</mo></mover><mrow><mi>k</mi><mo>−</mo><mn>1</mn></mrow></msub></mrow></msqrt></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msub><mi>ϵ</mi><mi>θ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>𝝉</mi><mrow><mi>k</mi><mo>−</mo><mn>1</mn></mrow></msup><mo>,</mo><mrow><mi>k</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>+</mo><mrow><msub><mi>σ</mi><mi>k</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi class="ltx_mathvariant_bold-italic" mathvariant="bold-italic">ϵ</mi><mi>k</mi></msub></mrow></mrow><mo>)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\frac{1}{\sqrt{\alpha_{k-1}}}\left(\frac{1}{\sqrt{\alpha_{k}}}\bm{\tau}^{k}-\frac{1-\alpha_{k}}{\sqrt{(1-\bar{\alpha}_{k})\alpha_{k}}}\epsilon_{\theta}(\bm{\tau}^{k},k)-\frac{1-\alpha_{k-1}}{\sqrt{1-\bar{\alpha}_{k-1}}}\epsilon_{\theta}(\bm{\tau}^{k-1},k-1)+\sigma_{k}\bm{\epsilon}_{k}\right)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr>
