<figcaption class="ltx_caption ltx_centering"><span class="ltx_tag ltx_tag_figure"><span id="S9.F14.sf1.3" class="ltx_text" style="font-size:90%;">(a)</span> </span><math id="S9.F14.sf1.m2" class="ltx_Math" alttext="{\textit{NFE}}=16" display="inline" intent=":literal"><semantics><mrow><mtext class="ltx_mathvariant_italic" mathsize="0.900em">NFE</mtext><mo mathsize="0.900em">=</mo><mn mathsize="0.900em">16</mn></mrow><annotation encoding="application/x-tex">{\textit{NFE}}=16</annotation></semantics></math></figcaption>
