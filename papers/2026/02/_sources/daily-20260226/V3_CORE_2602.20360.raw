<figure id="S9.F14.sf2" class="ltx_figure ltx_figure_panel ltx_align_center"><object type="image/svg+xml" data="2602.20360v1/cfg2.0_nfe32_surface.svg" id="S9.F14.sf2.g1" class="ltx_graphics ltx_centering ltx_img_square" style="aspect-ratio:685/609;" width="685" height="609"></object>
