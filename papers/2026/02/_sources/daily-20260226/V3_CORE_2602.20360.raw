<figure id="S9.F14.sf3" class="ltx_figure ltx_figure_panel ltx_align_center"><object type="image/svg+xml" data="2602.20360v1/cfg2.0_nfe64_surface.svg" id="S9.F14.sf3.g1" class="ltx_graphics ltx_centering ltx_img_square" style="aspect-ratio:685/609;" width="685" height="609"></object>
<figcaption class="ltx_caption ltx_centering"><span class="ltx_tag ltx_tag_figure"><span id="S9.F14.sf3.3" class="ltx_text" style="font-size:90%;">(c)</span> </span><math id="S9.F14.sf3.m2" class="ltx_Math" alttext="{\textit{NFE}}=64" display="inline" intent=":literal"><semantics><mrow><mtext class="ltx_mathvariant_italic" mathsize="0.900em">NFE</mtext><mo mathsize="0.900em">=</mo><mn mathsize="0.900em">64</mn></mrow><annotation encoding="application/x-tex">{\textit{NFE}}=64</annotation></semantics></math></figcaption>
