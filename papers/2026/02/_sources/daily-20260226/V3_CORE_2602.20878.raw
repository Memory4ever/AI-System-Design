<p id="S0.T1.3" class="ltx_p"><span id="S0.T1.3.1" class="ltx_text">
<span id="S0.T1.3.1.1" class="ltx_inline-block ltx_transformed_outer" style="width:313.4pt;height:207.2pt;vertical-align:-101.1pt;"><span class="ltx_transformed_inner" style="transform:translate(0.0pt,0.0pt) scale(1,1) ;">
<span id="S0.T1.3.1.1.1" class="ltx_p"><span id="S0.T1.3.1.1.1.1" class="ltx_text">
