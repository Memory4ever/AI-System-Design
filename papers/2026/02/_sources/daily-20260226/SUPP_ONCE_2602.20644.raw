<td id="S4.T1.4.2.4" class="ltx_td ltx_align_center ltx_border_r ltx_border_t"><span id="S4.T1.4.2.4.1" class="ltx_text" style="font-size:70%;">1</span></td></tr>
<tr id="S4.T1.4.3" class="ltx_tr">
<th id="S4.T1.4.3.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_l ltx_border_r"><span id="S4.T1.4.3.1.1" class="ltx_text" style="font-size:70%;">Straight-2</span></th>
<td id="S4.T1.4.3.2" class="ltx_td ltx_align_center ltx_border_r"><span id="S4.T1.4.3.2.1" class="ltx_text" style="font-size:70%;">2</span></td>
<td id="S4.T1.4.3.3" class="ltx_td ltx_align_center ltx_border_r"><span id="S4.T1.4.3.3.1" class="ltx_text" style="font-size:70%;">1</span></td>
<td id="S4.T1.4.3.4" class="ltx_td ltx_align_center ltx_border_r"><span id="S4.T1.4.3.4.1" class="ltx_text" style="font-size:70%;">2</span></td></tr>
<tr id="S4.T1.4.4" class="ltx_tr">
<th id="S4.T1.4.4.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_l ltx_border_r"><span id="S4.T1.4.4.1.1" class="ltx_text" style="font-size:70%;">Intersection-1</span></th>
<td id="S4.T1.4.4.2" class="ltx_td ltx_align_center ltx_border_r"><span id="S4.T1.4.4.2.1" class="ltx_text" style="font-size:70%;">3</span></td>
