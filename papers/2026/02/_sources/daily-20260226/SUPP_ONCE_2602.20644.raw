<tr id="S4.T1.4.1" class="ltx_tr">
<th id="S4.T1.4.1.1" class="ltx_td ltx_align_left ltx_th ltx_th_column ltx_th_row ltx_border_l ltx_border_r ltx_border_t"><span id="S4.T1.4.1.1.1" class="ltx_text ltx_font_bold" style="font-size:70%;">Road-Type</span></th>
<th id="S4.T1.4.1.2" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_r ltx_border_t"><span id="S4.T1.4.1.2.1" class="ltx_text ltx_font_bold" style="font-size:70%;">Human Assessor 1</span></th>
<th id="S4.T1.4.1.3" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_r ltx_border_t"><span id="S4.T1.4.1.3.1" class="ltx_text ltx_font_bold" style="font-size:70%;">Human Assessor 2</span></th>
