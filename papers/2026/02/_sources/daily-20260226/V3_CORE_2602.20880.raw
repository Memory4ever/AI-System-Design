<td id="S3.T1.6.9.3" class="ltx_td ltx_align_center ltx_border_t"><span id="S3.T1.6.9.3.1" class="ltx_text" style="font-size:90%;">20.4 (-32.4)</span></td></tr>
<tr id="S3.T1.6.10" class="ltx_tr">
