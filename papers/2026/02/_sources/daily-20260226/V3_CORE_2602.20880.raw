<td id="A4.T7.7.11.6" class="ltx_td ltx_align_center ltx_border_b" style="padding-top:0.5pt;padding-bottom:0.5pt;"><span id="A4.T7.7.11.6.1" class="ltx_text ltx_font_bold">5.0 (-22.0)</span></td>
