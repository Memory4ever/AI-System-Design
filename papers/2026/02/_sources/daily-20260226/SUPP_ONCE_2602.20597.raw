<td id="A1.T8.6.1.12.7" class="ltx_td ltx_align_center ltx_border_bb ltx_border_t"><span id="A1.T8.6.1.12.7.1" class="ltx_text ltx_font_bold" style="--ltx-bg-color:#ECECEC;">80.68</span></td></tr>
