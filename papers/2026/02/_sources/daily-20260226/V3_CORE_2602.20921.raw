<table id="S2.T1.2" class="ltx_tabular ltx_centering ltx_align_middle">
<tr id="S2.T1.2.1" class="ltx_tr">
<td id="S2.T1.2.1.1" class="ltx_td ltx_align_left ltx_border_tt"><span id="S2.T1.2.1.1.1" class="ltx_text ltx_font_bold">Symbol</span></td>
<td id="S2.T1.2.1.2" class="ltx_td ltx_align_left ltx_border_tt"><span id="S2.T1.2.1.2.1" class="ltx_text ltx_font_bold">Meaning</span></td>
<td id="S2.T1.2.1.3" class="ltx_td ltx_align_left ltx_border_tt"><span id="S2.T1.2.1.3.1" class="ltx_text ltx_font_bold">Appears in</span></td></tr>
<tr id="S2.T1.2.2" class="ltx_tr">
<td id="S2.T1.2.2.1" class="ltx_td ltx_align_left ltx_border_t"><math id="S2.T1.m1" class="ltx_Math" alttext="n_{\rm d}/n" display="inline" intent=":literal"><semantics><mrow><msub><mi>n</mi><mi>d</mi></msub><mo>/</mo><mi>n</mi></mrow><annotation encoding="application/x-tex">n_{\rm d}/n</annotation></semantics></math></td>
<td id="S2.T1.2.2.2" class="ltx_td ltx_align_left ltx_border_t">Dimension of input/output</td>
<td id="S2.T1.2.2.3" class="ltx_td ltx_align_left ltx_border_t">Subsection 2.2</td></tr>
<tr id="S2.T1.2.3" class="ltx_tr">
<td id="S2.T1.2.3.1" class="ltx_td ltx_align_left"><math id="S2.T1.m2" class="ltx_Math" alttext="L" display="inline" intent=":literal"><semantics><mi>L</mi><annotation encoding="application/x-tex">L</annotation></semantics></math></td>
<td id="S2.T1.2.3.2" class="ltx_td ltx_align_left">Number of layers</td>
<td id="S2.T1.2.3.3" class="ltx_td ltx_align_left">Eq. (<a href="#S2.E1" title="Equation 1 ‣ 2.2 Residual neural network and its dynamical system modeling ‣ 2 Notations and problem formulation ‣ On the Generalization Behavior of Deep Residual Networks From a Dynamical System Perspective" class="ltx_ref"><span class="ltx_text ltx_ref_tag">1</span></a>)</td></tr>
<tr id="S2.T1.2.4" class="ltx_tr">
<td id="S2.T1.2.4.1" class="ltx_td ltx_align_left"><math id="S2.T1.m3" class="ltx_Math" alttext="\tau_{L}" display="inline" intent=":literal"><semantics><msub><mi>τ</mi><mi>L</mi></msub><annotation encoding="application/x-tex">\tau_{L}</annotation></semantics></math></td>
<td id="S2.T1.2.4.2" class="ltx_td ltx_align_left">Discretization step</td>
<td id="S2.T1.2.4.3" class="ltx_td ltx_align_left">Eq. (<a href="#S2.E1" title="Equation 1 ‣ 2.2 Residual neural network and its dynamical system modeling ‣ 2 Notations and problem formulation ‣ On the Generalization Behavior of Deep Residual Networks From a Dynamical System Perspective" class="ltx_ref"><span class="ltx_text ltx_ref_tag">1</span></a>)</td></tr>
<tr id="S2.T1.2.5" class="ltx_tr">
<td id="S2.T1.2.5.1" class="ltx_td ltx_align_left"><math id="S2.T1.m4" class="ltx_Math" alttext="\Theta_{L}^{\rm total}" display="inline" intent=":literal"><semantics><msubsup><mi mathvariant="normal">Θ</mi><mi>L</mi><mi>total</mi></msubsup><annotation encoding="application/x-tex">\Theta_{L}^{\rm total}</annotation></semantics></math></td>
<td id="S2.T1.2.5.2" class="ltx_td ltx_align_left">Discrete-time learnable parameter</td>
<td id="S2.T1.2.5.3" class="ltx_td ltx_align_left">Subsection 2.2</td></tr>
<tr id="S2.T1.2.6" class="ltx_tr">
<td id="S2.T1.2.6.1" class="ltx_td ltx_align_left"><math id="S2.T1.m5" class="ltx_Math" alttext="\mathrm{x}^{l}(\cdot;{\Theta}^{\rm total}_{L})" display="inline" intent=":literal"><semantics><mrow><msup><mi>x</mi><mi>l</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo>,</mo><msubsup><mi mathvariant="normal">Θ</mi><mi>L</mi><mi>total</mi></msubsup><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathrm{x}^{l}(\cdot;{\Theta}^{\rm total}_{L})</annotation></semantics></math></td>
<td id="S2.T1.2.6.2" class="ltx_td ltx_align_left">Output function of the <math id="S2.T1.m6" class="ltx_Math" alttext="l" display="inline" intent=":literal"><semantics><mi>l</mi><annotation encoding="application/x-tex">l</annotation></semantics></math>-th layer in Eq.(<a href="#S2.E1" title="Equation 1 ‣ 2.2 Residual neural network and its dynamical system modeling ‣ 2 Notations and problem formulation ‣ On the Generalization Behavior of Deep Residual Networks From a Dynamical System Perspective" class="ltx_ref"><span class="ltx_text ltx_ref_tag">1</span></a>) with <math id="S2.T1.m7" class="ltx_Math" alttext="{\Theta}^{\rm total}_{L}" display="inline" intent=":literal"><semantics><msubsup><mi mathvariant="normal">Θ</mi><mi>L</mi><mi>total</mi></msubsup><annotation encoding="application/x-tex">{\Theta}^{\rm total}_{L}</annotation></semantics></math></td>
<td id="S2.T1.2.6.3" class="ltx_td ltx_align_left">Subsection 2.2</td></tr>
<tr id="S2.T1.2.7" class="ltx_tr">
<td id="S2.T1.2.7.1" class="ltx_td ltx_align_left"><math id="S2.T1.m8" class="ltx_Math" alttext="\mathcal{F}^{l}" display="inline" intent=":literal"><semantics><msup><mi class="ltx_font_mathcaligraphic">ℱ</mi><mi>l</mi></msup><annotation encoding="application/x-tex">\mathcal{F}^{l}</annotation></semantics></math></td>
<td id="S2.T1.2.7.2" class="ltx_td ltx_align_left">Hypothesis set of discrete-time ResNet at <math id="S2.T1.m9" class="ltx_Math" alttext="l" display="inline" intent=":literal"><semantics><mi>l</mi><annotation encoding="application/x-tex">l</annotation></semantics></math>-th</td>
<td id="S2.T1.2.7.3" class="ltx_td ltx_align_left">Eq. (<a href="#S2.E3" title="Equation 3 ‣ 2.2 Residual neural network and its dynamical system modeling ‣ 2 Notations and problem formulation ‣ On the Generalization Behavior of Deep Residual Networks From a Dynamical System Perspective" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3</span></a>)</td></tr>
<tr id="S2.T1.2.8" class="ltx_tr">
<td id="S2.T1.2.8.1" class="ltx_td ltx_align_left"><math id="S2.T1.m10" class="ltx_Math" alttext="T" display="inline" intent=":literal"><semantics><mi>T</mi><annotation encoding="application/x-tex">T</annotation></semantics></math></td>
<td id="S2.T1.2.8.2" class="ltx_td ltx_align_left">Terminal time</td>
<td id="S2.T1.2.8.3" class="ltx_td ltx_align_left">Eq. (<a href="#S2.E5" title="Equation 5 ‣ 2.2 Residual neural network and its dynamical system modeling ‣ 2 Notations and problem formulation ‣ On the Generalization Behavior of Deep Residual Networks From a Dynamical System Perspective" class="ltx_ref"><span class="ltx_text ltx_ref_tag">5</span></a>)</td></tr>
<tr id="S2.T1.2.9" class="ltx_tr">
<td id="S2.T1.2.9.1" class="ltx_td ltx_align_left"><math id="S2.T1.m11" class="ltx_Math" alttext="\boldsymbol{\Theta}^{\rm total}" display="inline" intent=":literal"><semantics><msup><mi>𝚯</mi><mi>total</mi></msup><annotation encoding="application/x-tex">\boldsymbol{\Theta}^{\rm total}</annotation></semantics></math></td>
<td id="S2.T1.2.9.2" class="ltx_td ltx_align_left">Continuous-time learnable parameter</td>
<td id="S2.T1.2.9.3" class="ltx_td ltx_align_left">Subsection 2.2</td></tr>
<tr id="S2.T1.2.10" class="ltx_tr">
<td id="S2.T1.2.10.1" class="ltx_td ltx_align_left"><math id="S2.T1.m12" class="ltx_Math" alttext="\mathbb{x}(T;\cdot;\boldsymbol{\Theta}^{\rm total})" display="inline" intent=":literal"><semantics><mrow><mi>𝕩</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>T</mi><mo rspace="0em">,</mo><mo lspace="0em" rspace="0em">⋅</mo><mo>,</mo><msup><mi>𝚯</mi><mi>total</mi></msup><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathbb{x}(T;\cdot;\boldsymbol{\Theta}^{\rm total})</annotation></semantics></math></td>
<td id="S2.T1.2.10.2" class="ltx_td ltx_align_left">Output function of Eq.(<a href="#S2.E5" title="Equation 5 ‣ 2.2 Residual neural network and its dynamical system modeling ‣ 2 Notations and problem formulation ‣ On the Generalization Behavior of Deep Residual Networks From a Dynamical System Perspective" class="ltx_ref"><span class="ltx_text ltx_ref_tag">5</span></a>) with <math id="S2.T1.m13" class="ltx_Math" alttext="\boldsymbol{\Theta}^{\rm total}" display="inline" intent=":literal"><semantics><msup><mi>𝚯</mi><mi>total</mi></msup><annotation encoding="application/x-tex">\boldsymbol{\Theta}^{\rm total}</annotation></semantics></math></td>
<td id="S2.T1.2.10.3" class="ltx_td ltx_align_left">Subsection 2.2</td></tr>
<tr id="S2.T1.2.11" class="ltx_tr">
<td id="S2.T1.2.11.1" class="ltx_td ltx_align_left"><math id="S2.T1.m14" class="ltx_Math" alttext="{\mathcal{F}}^{T}" display="inline" intent=":literal"><semantics><msup><mi class="ltx_font_mathcaligraphic">ℱ</mi><mi>T</mi></msup><annotation encoding="application/x-tex">{\mathcal{F}}^{T}</annotation></semantics></math></td>
<td id="S2.T1.2.11.2" class="ltx_td ltx_align_left">Hypothesis set of continuous-time ResNet at time <math id="S2.T1.m15" class="ltx_Math" alttext="T" display="inline" intent=":literal"><semantics><mi>T</mi><annotation encoding="application/x-tex">T</annotation></semantics></math></td>
<td id="S2.T1.2.11.3" class="ltx_td ltx_align_left">Eq. (<a href="#S2.E7" title="Equation 7 ‣ 2.2 Residual neural network and its dynamical system modeling ‣ 2 Notations and problem formulation ‣ On the Generalization Behavior of Deep Residual Networks From a Dynamical System Perspective" class="ltx_ref"><span class="ltx_text ltx_ref_tag">7</span></a>)</td></tr>
<tr id="S2.T1.2.12" class="ltx_tr">
<td id="S2.T1.2.12.1" class="ltx_td ltx_align_left"><math id="S2.T1.m16" class="ltx_Math" alttext="\Omega_{{\Theta}^{\rm total}_{L}}/\Omega_{\boldsymbol{\Theta}^{\rm total}}" display="inline" intent=":literal"><semantics><mrow><msub><mi mathvariant="normal">Ω</mi><msubsup><mi mathvariant="normal">Θ</mi><mi>L</mi><mi>total</mi></msubsup></msub><mo>/</mo><msub><mi mathvariant="normal">Ω</mi><msup><mi>𝚯</mi><mi>total</mi></msup></msub></mrow><annotation encoding="application/x-tex">\Omega_{{\Theta}^{\rm total}_{L}}/\Omega_{\boldsymbol{\Theta}^{\rm total}}</annotation></semantics></math></td>
<td id="S2.T1.2.12.2" class="ltx_td ltx_align_left">Discrete/Continuous time parameter set</td>
<td id="S2.T1.2.12.3" class="ltx_td ltx_align_left">Subsection 2.2</td></tr>
<tr id="S2.T1.2.13" class="ltx_tr">
<td id="S2.T1.2.13.1" class="ltx_td ltx_align_left"><math id="S2.T1.m17" class="ltx_Math" alttext="\ell" display="inline" intent=":literal"><semantics><mi mathvariant="normal">ℓ</mi><annotation encoding="application/x-tex">\ell</annotation></semantics></math></td>
<td id="S2.T1.2.13.2" class="ltx_td ltx_align_left">Loss function</td>
<td id="S2.T1.2.13.3" class="ltx_td ltx_align_left">Eq. (<a href="#S2.E9" title="Equation 9 ‣ 2.3 The problem of generalization for discrete- and continuous-time ResNets ‣ 2 Notations and problem formulation ‣ On the Generalization Behavior of Deep Residual Networks From a Dynamical System Perspective" class="ltx_ref"><span class="ltx_text ltx_ref_tag">9</span></a>)</td></tr>
<tr id="S2.T1.2.14" class="ltx_tr">
<td id="S2.T1.2.14.1" class="ltx_td ltx_align_left"><math id="S2.T1.m18" class="ltx_Math" alttext="\mathfrak{D}/\mathcal{S}" display="inline" intent=":literal"><semantics><mrow><mi>𝔇</mi><mo>/</mo><mi class="ltx_font_mathcaligraphic">𝒮</mi></mrow><annotation encoding="application/x-tex">\mathfrak{D}/\mathcal{S}</annotation></semantics></math></td>
<td id="S2.T1.2.14.2" class="ltx_td ltx_align_left">Data distribution/Training sample set</td>
<td id="S2.T1.2.14.3" class="ltx_td ltx_align_left">Subsection 2.3</td></tr>
<tr id="S2.T1.2.15" class="ltx_tr">
<td id="S2.T1.2.15.1" class="ltx_td ltx_align_left"><math id="S2.T1.m19" class="ltx_Math" alttext="\mathfrak{R}_{{\mathfrak{D}}}(\cdot)/\hat{\mathfrak{R}}_{\mathcal{S}}(\cdot)" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><msub><mi>ℜ</mi><mi>𝔇</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo stretchy="false">)</mo></mrow></mrow><mo>/</mo><msub><mover accent="true"><mi>ℜ</mi><mo>^</mo></mover><mi class="ltx_font_mathcaligraphic">𝒮</mi></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathfrak{R}_{{\mathfrak{D}}}(\cdot)/\hat{\mathfrak{R}}_{\mathcal{S}}(\cdot)</annotation></semantics></math></td>
<td id="S2.T1.2.15.2" class="ltx_td ltx_align_left">Expected/Empirical loss (risk)</td>
<td id="S2.T1.2.15.3" class="ltx_td ltx_align_left">Eq. (<a href="#S2.E9" title="Equation 9 ‣ 2.3 The problem of generalization for discrete- and continuous-time ResNets ‣ 2 Notations and problem formulation ‣ On the Generalization Behavior of Deep Residual Networks From a Dynamical System Perspective" class="ltx_ref"><span class="ltx_text ltx_ref_tag">9</span></a>)/(<a href="#S2.E10" title="Equation 10 ‣ 2.3 The problem of generalization for discrete- and continuous-time ResNets ‣ 2 Notations and problem formulation ‣ On the Generalization Behavior of Deep Residual Networks From a Dynamical System Perspective" class="ltx_ref"><span class="ltx_text ltx_ref_tag">10</span></a>)</td></tr>
<tr id="S2.T1.2.16" class="ltx_tr">
<td id="S2.T1.2.16.1" class="ltx_td ltx_align_left"><math id="S2.T1.m20" class="ltx_Math" alttext="S" display="inline" intent=":literal"><semantics><mi>S</mi><annotation encoding="application/x-tex">S</annotation></semantics></math></td>
<td id="S2.T1.2.16.2" class="ltx_td ltx_align_left">Number of training samples</td>
<td id="S2.T1.2.16.3" class="ltx_td ltx_align_left">Subsection 2.3</td></tr>
<tr id="S2.T1.2.17" class="ltx_tr">
<td id="S2.T1.2.17.1" class="ltx_td ltx_align_left"><math id="S2.T1.m21" class="ltx_Math" alttext="GE_{\mathcal{S}}(\cdot)" display="inline" intent=":literal"><semantics><mrow><mi>G</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>E</mi><mi class="ltx_font_mathcaligraphic">𝒮</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">GE_{\mathcal{S}}(\cdot)</annotation></semantics></math></td>
<td id="S2.T1.2.17.2" class="ltx_td ltx_align_left">Generalization gap</td>
<td id="S2.T1.2.17.3" class="ltx_td ltx_align_left">Eq. (<a href="#S2.E11" title="Equation 11 ‣ 2.3 The problem of generalization for discrete- and continuous-time ResNets ‣ 2 Notations and problem formulation ‣ On the Generalization Behavior of Deep Residual Networks From a Dynamical System Perspective" class="ltx_ref"><span class="ltx_text ltx_ref_tag">11</span></a>)</td></tr>
<tr id="S2.T1.2.18" class="ltx_tr">
<td id="S2.T1.2.18.1" class="ltx_td ltx_align_left"><math id="S2.T1.m22" class="ltx_Math" alttext="\mathscr{A}(\mathbb{R})" display="inline" intent=":literal"><semantics><mrow><mi class="ltx_font_mathscript">𝒜</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>ℝ</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathscr{A}(\mathbb{R})</annotation></semantics></math></td>
<td id="S2.T1.2.18.2" class="ltx_td ltx_align_left">Set of activation functions</td>
<td id="S2.T1.2.18.3" class="ltx_td ltx_align_left">Definition <a href="#Thmtheorem1" title="Definition 1. ‣ 3 Main results and application ‣ On the Generalization Behavior of Deep Residual Networks From a Dynamical System Perspective" class="ltx_ref"><span class="ltx_text ltx_ref_tag">1</span></a></td></tr>
<tr id="S2.T1.2.19" class="ltx_tr">
<td id="S2.T1.2.19.1" class="ltx_td ltx_align_left"><math id="S2.T1.m23" class="ltx_Math" alttext="\mathrm{Lip}_{\psi}" display="inline" intent=":literal"><semantics><msub><mi>Lip</mi><mi>ψ</mi></msub><annotation encoding="application/x-tex">\mathrm{Lip}_{\psi}</annotation></semantics></math></td>
<td id="S2.T1.2.19.2" class="ltx_td ltx_align_left">Lipschitz constant of function <math id="S2.T1.m24" class="ltx_Math" alttext="\psi" display="inline" intent=":literal"><semantics><mi>ψ</mi><annotation encoding="application/x-tex">\psi</annotation></semantics></math></td>
<td id="S2.T1.2.19.3" class="ltx_td ltx_align_left">Proposition 3.1</td></tr>
<tr id="S2.T1.2.20" class="ltx_tr">
<td id="S2.T1.2.20.1" class="ltx_td ltx_align_left"><math id="S2.T1.m25" class="ltx_Math" alttext="\mathscr{R}_{\mathcal{Z}}(\mathcal{F})" display="inline" intent=":literal"><semantics><mrow><msub><mi class="ltx_font_mathscript">ℛ</mi><mi class="ltx_font_mathcaligraphic">𝒵</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi class="ltx_font_mathcaligraphic">ℱ</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathscr{R}_{\mathcal{Z}}(\mathcal{F})</annotation></semantics></math></td>
<td id="S2.T1.2.20.2" class="ltx_td ltx_align_left">Rademacher complexity of function class <math id="S2.T1.m26" class="ltx_Math" alttext="\mathcal{F}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">ℱ</mi><annotation encoding="application/x-tex">\mathcal{F}</annotation></semantics></math></td>
<td id="S2.T1.2.20.3" class="ltx_td ltx_align_left">Proposition <a href="#Thmtheorem2" title="Proposition 2. ‣ 3 Main results and application ‣ On the Generalization Behavior of Deep Residual Networks From a Dynamical System Perspective" class="ltx_ref"><span class="ltx_text ltx_ref_tag">2</span></a></td></tr>
<tr id="S2.T1.2.21" class="ltx_tr">
<td id="S2.T1.2.21.1" class="ltx_td ltx_align_left"><math id="S2.T1.m27" class="ltx_Math" alttext="B_{\rm in}" display="inline" intent=":literal"><semantics><msub><mi>B</mi><mi>in</mi></msub><annotation encoding="application/x-tex">B_{\rm in}</annotation></semantics></math></td>
<td id="S2.T1.2.21.2" class="ltx_td ltx_align_left">Bound on the data distribution</td>
<td id="S2.T1.2.21.3" class="ltx_td ltx_align_left">Assumption A1</td></tr>
<tr id="S2.T1.2.22" class="ltx_tr">
<td id="S2.T1.2.22.1" class="ltx_td ltx_align_left"><math id="S2.T1.m28" class="ltx_Math" alttext="B_{\boldsymbol{\Theta}}" display="inline" intent=":literal"><semantics><msub><mi>B</mi><mi>𝚯</mi></msub><annotation encoding="application/x-tex">B_{\boldsymbol{\Theta}}</annotation></semantics></math></td>
<td id="S2.T1.2.22.2" class="ltx_td ltx_align_left">Bound on the learnable parameters</td>
<td id="S2.T1.2.22.3" class="ltx_td ltx_align_left">Assumption A2</td></tr>
<tr id="S2.T1.2.23" class="ltx_tr">
<td id="S2.T1.2.23.1" class="ltx_td ltx_align_left"><math id="S2.T1.m29" class="ltx_Math" alttext="\kappa" display="inline" intent=":literal"><semantics><mi>κ</mi><annotation encoding="application/x-tex">\kappa</annotation></semantics></math></td>
<td id="S2.T1.2.23.2" class="ltx_td ltx_align_left">Local Lipschitz bound function for <math id="S2.T1.m30" class="ltx_Math" alttext="\ell(\cdot,\mathrm{g})" display="inline" intent=":literal"><semantics><mrow><mi mathvariant="normal">ℓ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo>,</mo><mi>g</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\ell(\cdot,\mathrm{g})</annotation></semantics></math></td>
<td id="S2.T1.2.23.3" class="ltx_td ltx_align_left">Assumption A4</td></tr>
<tr id="S2.T1.2.24" class="ltx_tr">
<td id="S2.T1.2.24.1" class="ltx_td ltx_align_left ltx_border_bb"><math id="S2.T1.m31" class="ltx_Math" alttext="B_{\kappa}/B_{\ell}" display="inline" intent=":literal"><semantics><mrow><msub><mi>B</mi><mi>κ</mi></msub><mo>/</mo><msub><mi>B</mi><mi mathvariant="normal">ℓ</mi></msub></mrow><annotation encoding="application/x-tex">B_{\kappa}/B_{\ell}</annotation></semantics></math></td>
<td id="S2.T1.2.24.2" class="ltx_td ltx_align_left ltx_border_bb">Bound of <math id="S2.T1.m32" class="ltx_Math" alttext="\kappa/\ell" display="inline" intent=":literal"><semantics><mrow><mi>κ</mi><mo>/</mo><mi mathvariant="normal">ℓ</mi></mrow><annotation encoding="application/x-tex">\kappa/\ell</annotation></semantics></math> on some compact set</td>
<td id="S2.T1.2.24.3" class="ltx_td ltx_align_left ltx_border_bb">Theorem <a href="#Thmtheorem5" title="Theorem 5. ‣ 3 Main results and application ‣ On the Generalization Behavior of Deep Residual Networks From a Dynamical System Perspective" class="ltx_ref"><span class="ltx_text ltx_ref_tag">5</span></a></td></tr>
</table>
</figure>
</section>
<section id="S2.SS2" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">2.2 </span>Residual neural network and its dynamical system modeling</h3>

<div id="S2.SS2.p1" class="ltx_para">
<p id="S2.SS2.p1.2" class="ltx_p">We present the dynamical system modeling of ResNets <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib16" title="" class="ltx_ref">12</a>, <a href="#bib.bib17" title="" class="ltx_ref">19</a>]</cite>. In particular, we consider</p>
<table id="S2.E1" class="ltx_equationgroup ltx_eqn_table">
<tbody>
<tr id="S2.E1X" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S2.E1X.m2" class="ltx_Math" alttext="\displaystyle\mathrm{x}^{l+1}" display="inline" intent=":literal"><semantics><msup><mi>x</mi><mrow><mi>l</mi><mo>+</mo><mn>1</mn></mrow></msup><annotation encoding="application/x-tex">\displaystyle\mathrm{x}^{l+1}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S2.E1X.m3" class="ltx_Math" alttext="\displaystyle=\mathrm{x}^{l}+\tau_{L}\big[\mathrm{W}^{l}\psi\circ(\mathrm{V}^{l}\mathrm{x}^{l}+\mathrm{b}^{l})+\mathrm{c}^{l}\big],\ 0\leq l\leq L-1," display="inline" intent=":literal"><semantics><mrow><mo>=</mo><mi>x</mi><msup><mrow></mrow><mi>l</mi></msup><mo>+</mo><mi>τ</mi><msub><mrow></mrow><mi>L</mi></msub><mo maxsize="1.200em" minsize="1.200em">[</mo><mi>W</mi><msup><mrow></mrow><mi>l</mi></msup><mi>ψ</mi><mo lspace="0.222em" rspace="0.222em">∘</mo><mo stretchy="false">(</mo><mi>V</mi><msup><mrow></mrow><mi>l</mi></msup><mi>x</mi><msup><mrow></mrow><mi>l</mi></msup><mo>+</mo><mi>b</mi><msup><mrow></mrow><mi>l</mi></msup><mo stretchy="false">)</mo><mo>+</mo><mi>c</mi><msup><mrow></mrow><mi>l</mi></msup><mo maxsize="1.200em" minsize="1.200em">]</mo><mo>,</mo><mn> 0</mn><mo>≤</mo><mi>l</mi><mo>≤</mo><mi>L</mi><mo>−</mo><mn>1</mn><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle=\mathrm{x}^{l}+\tau_{L}\big[\mathrm{W}^{l}\psi\circ(\mathrm{V}^{l}\mathrm{x}^{l}+\mathrm{b}^{l})+\mathrm{c}^{l}\big],\ 0\leq l\leq L-1,</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="2" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equationgroup ltx_align_right">(1)</span></td></tr>
<tr id="S2.E1Xa" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S2.E1Xa.m2" class="ltx_Math" alttext="\displaystyle\mathrm{x}^{0}" display="inline" intent=":literal"><semantics><msup><mi>x</mi><mn>0</mn></msup><annotation encoding="application/x-tex">\displaystyle\mathrm{x}^{0}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S2.E1Xa.m3" class="ltx_Math" alttext="\displaystyle=\psi\circ(\mathrm{U}\mathrm{d}+\mathrm{a})," display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>=</mo><mrow><mi>ψ</mi><mo lspace="0.222em" rspace="0.222em">∘</mo><mrow><mo stretchy="false">(</mo><mrow><mi>Ud</mi><mo>+</mo><mi>a</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle=\psi\circ(\mathrm{U}\mathrm{d}+\mathrm{a}),</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S2.SS2.p1.3" class="ltx_p">where <math id="S2.SS2.p1.m1" class="ltx_Math" alttext="\mathrm{d}\in\mathbb{R}^{n_{\mathrm{d}}}" display="inline" intent=":literal"><semantics><mrow><mi>d</mi><mo>∈</mo><msup><mi>ℝ</mi><msub><mi>n</mi><mi>d</mi></msub></msup></mrow><annotation encoding="application/x-tex">\mathrm{d}\in\mathbb{R}^{n_{\mathrm{d}}}</annotation></semantics></math> is the input data; <math id="S2.SS2.p1.m2" class="ltx_Math" alttext="\psi:\mathbb{R}\to\mathbb{R}" display="inline" intent=":literal"><semantics><mrow><mi>ψ</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi>ℝ</mi><mo stretchy="false">→</mo><mi>ℝ</mi></mrow></mrow><annotation encoding="application/x-tex">\psi:\mathbb{R}\to\mathbb{R}</annotation></semantics></math> is the activation function, and is applied elementwise to vectors; the parameters <math id="S2.SS2.p1.m3" class="ltx_Math" alttext="(\mathrm{U},\mathrm{a})=:{\Theta}^{\rm pre}\in\mathcal{E}^{\rm pre}=:\mathbb{R}^{n\times n_{\mathrm{d}}}\times\mathbb{R}^{n}" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">(</mo><mi>U</mi><mo>,</mo><mi>a</mi><mo stretchy="false">)</mo></mrow><mo>=</mo><mphantom></mphantom><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><msup><mi mathvariant="normal">Θ</mi><mi>pre</mi></msup><mo>∈</mo><msup><mi class="ltx_font_mathcaligraphic">ℰ</mi><mi>pre</mi></msup><mo>=</mo><mphantom></mphantom></mrow><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><msup><mi>ℝ</mi><mrow><mi>n</mi><mo lspace="0.222em" rspace="0.222em">×</mo><msub><mi>n</mi><mi>d</mi></msub></mrow></msup><mo lspace="0.222em" rspace="0.222em">×</mo><msup><mi>ℝ</mi><mi>n</mi></msup></mrow></mrow><annotation encoding="application/x-tex">(\mathrm{U},\mathrm{a})=:{\Theta}^{\rm pre}\in\mathcal{E}^{\rm pre}=:\mathbb{R}^{n\times n_{\mathrm{d}}}\times\mathbb{R}^{n}</annotation></semantics></math> are learnable parameters in the preprocessing layer, and the parameters <math id="S2.SS2.p1.m4" class="ltx_Math" alttext="(\mathrm{V}^{l},\mathrm{W}^{l},\mathrm{b}^{l},\mathrm{c}^{l})=:{\Theta}^{l}\in\mathcal{E}:=\mathbb{R}^{m\times n}\times\mathbb{R}^{n\times m}\times\mathbb{R}^{m}\times\mathbb{R}^{n}" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">(</mo><msup><mi>V</mi><mi>l</mi></msup><mo>,</mo><msup><mi>W</mi><mi>l</mi></msup><mo>,</mo><msup><mi>b</mi><mi>l</mi></msup><mo>,</mo><msup><mi>c</mi><mi>l</mi></msup><mo stretchy="false">)</mo></mrow><mo>=</mo><mphantom></mphantom><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><msup><mi mathvariant="normal">Θ</mi><mi>l</mi></msup><mo>∈</mo><mi class="ltx_font_mathcaligraphic">ℰ</mi><mo>:=</mo><mrow><msup><mi>ℝ</mi><mrow><mi>m</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>n</mi></mrow></msup><mo lspace="0.222em" rspace="0.222em">×</mo><msup><mi>ℝ</mi><mrow><mi>n</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>m</mi></mrow></msup><mo lspace="0.222em" rspace="0.222em">×</mo><msup><mi>ℝ</mi><mi>m</mi></msup><mo lspace="0.222em" rspace="0.222em">×</mo><msup><mi>ℝ</mi><mi>n</mi></msup></mrow></mrow></mrow><annotation encoding="application/x-tex">(\mathrm{V}^{l},\mathrm{W}^{l},\mathrm{b}^{l},\mathrm{c}^{l})=:{\Theta}^{l}\in\mathcal{E}:=\mathbb{R}^{m\times n}\times\mathbb{R}^{n\times m}\times\mathbb{R}^{m}\times\mathbb{R}^{n}</annotation></semantics></math> are learnable parameters in <math id="S2.SS2.p1.m5" class="ltx_Math" alttext="l" display="inline" intent=":literal"><semantics><mi>l</mi><annotation encoding="application/x-tex">l</annotation></semantics></math>-th layer of ResNet; <math id="S2.SS2.p1.m6" class="ltx_Math" alttext="L\in\mathbb{N}" display="inline" intent=":literal"><semantics><mrow><mi>L</mi><mo>∈</mo><mi>ℕ</mi></mrow><annotation encoding="application/x-tex">L\in\mathbb{N}</annotation></semantics></math> is the total layer number; <math id="S2.SS2.p1.m7" class="ltx_Math" alttext="\tau_{L}=T/L" display="inline" intent=":literal"><semantics><mrow><msub><mi>τ</mi><mi>L</mi></msub><mo>=</mo><mrow><mi>T</mi><mo>/</mo><mi>L</mi></mrow></mrow><annotation encoding="application/x-tex">\tau_{L}=T/L</annotation></semantics></math> is the discretization step, which serves as a “scaling factor”.</p>
</div>
<div id="S2.SS2.p2" class="ltx_para">
<p id="S2.SS2.p2.1" class="ltx_p">Denote <math id="S2.SS2.p2.m1" class="ltx_Math" alttext="{\Theta}_{L}\!=\!\left({\Theta}^{0}_{L},{\Theta}^{1}_{L},\ldots,{\Theta}^{L-1}_{L}\right)\!\in\!\mathcal{E}^{L}" display="inline" intent=":literal"><semantics><mrow><msub><mi mathvariant="normal">Θ</mi><mi>L</mi></msub><mo lspace="0.108em" rspace="0.108em">=</mo><mrow><mo>(</mo><msubsup><mi mathvariant="normal">Θ</mi><mi>L</mi><mn>0</mn></msubsup><mo>,</mo><msubsup><mi mathvariant="normal">Θ</mi><mi>L</mi><mn>1</mn></msubsup><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msubsup><mi mathvariant="normal">Θ</mi><mi>L</mi><mrow><mi>L</mi><mo>−</mo><mn>1</mn></mrow></msubsup><mo>)</mo></mrow><mo lspace="0.108em" rspace="0.108em">∈</mo><msup><mi class="ltx_font_mathcaligraphic">ℰ</mi><mi>L</mi></msup></mrow><annotation encoding="application/x-tex">{\Theta}_{L}\!=\!\left({\Theta}^{0}_{L},{\Theta}^{1}_{L},\ldots,{\Theta}^{L-1}_{L}\right)\!\in\!\mathcal{E}^{L}</annotation></semantics></math>. Let
<math id="S2.SS2.p2.m2" class="ltx_Math" alttext="{\Theta}^{\rm total}_{L}\!=\!({\Theta}^{\rm pre},{\Theta}_{L})\!\in\!\mathcal{E}^{\rm pre}\times\mathcal{E}^{L}" display="inline" intent=":literal"><semantics><mrow><msubsup><mi mathvariant="normal">Θ</mi><mi>L</mi><mi>total</mi></msubsup><mo lspace="0.108em" rspace="0.108em">=</mo><mrow><mo stretchy="false">(</mo><msup><mi mathvariant="normal">Θ</mi><mi>pre</mi></msup><mo>,</mo><msub><mi mathvariant="normal">Θ</mi><mi>L</mi></msub><mo stretchy="false">)</mo></mrow><mo lspace="0.108em" rspace="0.108em">∈</mo><mrow><msup><mi class="ltx_font_mathcaligraphic">ℰ</mi><mi>pre</mi></msup><mo lspace="0.222em" rspace="0.222em">×</mo><msup><mi class="ltx_font_mathcaligraphic">ℰ</mi><mi>L</mi></msup></mrow></mrow><annotation encoding="application/x-tex">{\Theta}^{\rm total}_{L}\!=\!({\Theta}^{\rm pre},{\Theta}_{L})\!\in\!\mathcal{E}^{\rm pre}\times\mathcal{E}^{L}</annotation></semantics></math> be the learnable parameters for the ResNet (<a href="#S2.E1" title="Equation 1 ‣ 2.2 Residual neural network and its dynamical system modeling ‣ 2 Notations and problem formulation ‣ On the Generalization Behavior of Deep Residual Networks From a Dynamical System Perspective" class="ltx_ref"><span class="ltx_text ltx_ref_tag">1</span></a>) with <math id="S2.SS2.p2.m3" class="ltx_Math" alttext="L" display="inline" intent=":literal"><semantics><mi>L</mi><annotation encoding="application/x-tex">L</annotation></semantics></math> layers. Let <math id="S2.SS2.p2.m4" class="ltx_Math" alttext="\Omega_{{\Theta}^{\rm total}_{L}}\subset\mathcal{E}^{\rm pre}\times\mathcal{E}^{L}" display="inline" intent=":literal"><semantics><mrow><msub><mi mathvariant="normal">Ω</mi><msubsup><mi mathvariant="normal">Θ</mi><mi>L</mi><mi>total</mi></msubsup></msub><mo>⊂</mo><mrow><msup><mi class="ltx_font_mathcaligraphic">ℰ</mi><mi>pre</mi></msup><mo lspace="0.222em" rspace="0.222em">×</mo><msup><mi class="ltx_font_mathcaligraphic">ℰ</mi><mi>L</mi></msup></mrow></mrow><annotation encoding="application/x-tex">\Omega_{{\Theta}^{\rm total}_{L}}\subset\mathcal{E}^{\rm pre}\times\mathcal{E}^{L}</annotation></semantics></math> be the parameter set. We denote <math id="S2.SS2.p2.m5" class="ltx_Math" alttext="\|{\Theta}_{L}^{l}\|_{\infty}=\max\{\|\mathrm{V}^{l}\|_{\infty},\|\mathrm{W}^{l}\|_{\infty},\|\mathrm{b}^{l}\|_{\infty},\|\mathrm{c}^{l}\|_{\infty}\}" display="inline" intent=":literal"><semantics><mrow><msub><mrow><mo stretchy="false">‖</mo><msubsup><mi mathvariant="normal">Θ</mi><mi>L</mi><mi>l</mi></msubsup><mo stretchy="false">‖</mo></mrow><mi mathvariant="normal">∞</mi></msub><mo>=</mo><mrow><mi>max</mi><mo>⁡</mo><mrow><mo stretchy="false">{</mo><mrow><msub><mrow><mo stretchy="false">‖</mo><msup><mi>V</mi><mi>l</mi></msup><mo stretchy="false">‖</mo></mrow><mi mathvariant="normal">∞</mi></msub><mo>,</mo><msub><mrow><mo stretchy="false">‖</mo><msup><mi>W</mi><mi>l</mi></msup><mo stretchy="false">‖</mo></mrow><mi mathvariant="normal">∞</mi></msub><mo>,</mo><msub><mrow><mo stretchy="false">‖</mo><msup><mi>b</mi><mi>l</mi></msup><mo stretchy="false">‖</mo></mrow><mi mathvariant="normal">∞</mi></msub><mo>,</mo><msub><mrow><mo stretchy="false">‖</mo><msup><mi>c</mi><mi>l</mi></msup><mo stretchy="false">‖</mo></mrow><mi mathvariant="normal">∞</mi></msub></mrow><mo stretchy="false">}</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\|{\Theta}_{L}^{l}\|_{\infty}=\max\{\|\mathrm{V}^{l}\|_{\infty},\|\mathrm{W}^{l}\|_{\infty},\|\mathrm{b}^{l}\|_{\infty},\|\mathrm{c}^{l}\|_{\infty}\}</annotation></semantics></math>, and define a norm for <math id="S2.SS2.p2.m6" class="ltx_Math" alttext="{\Theta}^{\rm total}_{L}\!\in\!\mathcal{E}^{\rm pre}\!\times\!\mathcal{E}^{L}" display="inline" intent=":literal"><semantics><mrow><msubsup><mi mathvariant="normal">Θ</mi><mi>L</mi><mi>total</mi></msubsup><mo lspace="0.108em" rspace="0.108em">∈</mo><mrow><msup><mi class="ltx_font_mathcaligraphic">ℰ</mi><mi>pre</mi></msup><mo lspace="0.222em" rspace="0.052em">×</mo><msup><mi class="ltx_font_mathcaligraphic">ℰ</mi><mi>L</mi></msup></mrow></mrow><annotation encoding="application/x-tex">{\Theta}^{\rm total}_{L}\!\in\!\mathcal{E}^{\rm pre}\!\times\!\mathcal{E}^{L}</annotation></semantics></math> as</p>
<table id="S2.E2" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S2.E2.m1" class="ltx_Math" alttext="\|{\Theta}^{\rm total}_{L}\|_{\infty}:=\max\{\|\mathrm{U}\|_{\infty},\|\mathrm{a}\|_{\infty},\max_{0\leq l\leq L-1}\|{\Theta}_{L}^{l}\|_{\infty}\}." display="block" intent=":literal"><semantics><mrow><mrow><msub><mrow><mo stretchy="false">‖</mo><msubsup><mi mathvariant="normal">Θ</mi><mi>L</mi><mi>total</mi></msubsup><mo stretchy="false">‖</mo></mrow><mi mathvariant="normal">∞</mi></msub><mo>:=</mo><mrow><mi>max</mi><mo>⁡</mo><mrow><mo stretchy="false">{</mo><msub><mrow><mo stretchy="false">‖</mo><mi>U</mi><mo stretchy="false">‖</mo></mrow><mi mathvariant="normal">∞</mi></msub><mo>,</mo><msub><mrow><mo stretchy="false">‖</mo><mi>a</mi><mo stretchy="false">‖</mo></mrow><mi mathvariant="normal">∞</mi></msub><mo>,</mo><mrow><munder><mi>max</mi><mrow><mn>0</mn><mo>≤</mo><mi>l</mi><mo>≤</mo><mrow><mi>L</mi><mo>−</mo><mn>1</mn></mrow></mrow></munder><mo>⁡</mo><msub><mrow><mo stretchy="false">‖</mo><msubsup><mi mathvariant="normal">Θ</mi><mi>L</mi><mi>l</mi></msubsup><mo stretchy="false">‖</mo></mrow><mi mathvariant="normal">∞</mi></msub></mrow><mo stretchy="false">}</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\|{\Theta}^{\rm total}_{L}\|_{\infty}:=\max\{\|\mathrm{U}\|_{\infty},\|\mathrm{a}\|_{\infty},\max_{0\leq l\leq L-1}\|{\Theta}_{L}^{l}\|_{\infty}\}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(2)</span></td></tr></tbody>
</table>
</div>
<div id="S2.SS2.p3" class="ltx_para">
<p id="S2.SS2.p3.3" class="ltx_p">We rewrite the state variable <math id="S2.SS2.p3.m1" class="ltx_Math" alttext="\mathrm{x}^{l}" display="inline" intent=":literal"><semantics><msup><mi>x</mi><mi>l</mi></msup><annotation encoding="application/x-tex">\mathrm{x}^{l}</annotation></semantics></math> in Eq.(<a href="#S2.E1" title="Equation 1 ‣ 2.2 Residual neural network and its dynamical system modeling ‣ 2 Notations and problem formulation ‣ On the Generalization Behavior of Deep Residual Networks From a Dynamical System Perspective" class="ltx_ref"><span class="ltx_text ltx_ref_tag">1</span></a>) as <math id="S2.SS2.p3.m2" class="ltx_Math" alttext="\mathrm{x}^{l}(\mathrm{d};{\Theta}^{\rm total}_{L})" display="inline" intent=":literal"><semantics><mrow><msup><mi>x</mi><mi>l</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>d</mi><mo>,</mo><msubsup><mi mathvariant="normal">Θ</mi><mi>L</mi><mi>total</mi></msubsup><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathrm{x}^{l}(\mathrm{d};{\Theta}^{\rm total}_{L})</annotation></semantics></math> (<math id="S2.SS2.p3.m3" class="ltx_Math" alttext="0\leq l\leq L" display="inline" intent=":literal"><semantics><mrow><mn>0</mn><mo>≤</mo><mi>l</mi><mo>≤</mo><mi>L</mi></mrow><annotation encoding="application/x-tex">0\leq l\leq L</annotation></semantics></math>) to emphasize its dependency on the input data <math id="S2.SS2.p3.m4" class="ltx_Math" alttext="\mathrm{d}" display="inline" intent=":literal"><semantics><mi>d</mi><annotation encoding="application/x-tex">\mathrm{d}</annotation></semantics></math> and the learnable parameter <math id="S2.SS2.p3.m5" class="ltx_Math" alttext="{\Theta}^{\rm total}_{L}" display="inline" intent=":literal"><semantics><msubsup><mi mathvariant="normal">Θ</mi><mi>L</mi><mi>total</mi></msubsup><annotation encoding="application/x-tex">{\Theta}^{\rm total}_{L}</annotation></semantics></math> and denote <math id="S2.SS2.p3.m6" class="ltx_Math" alttext="\mathrm{x}_{i}^{l}(\mathrm{d};{\Theta}^{\rm total}_{L})" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>x</mi><mi>i</mi><mi>l</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>d</mi><mo>,</mo><msubsup><mi mathvariant="normal">Θ</mi><mi>L</mi><mi>total</mi></msubsup><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathrm{x}_{i}^{l}(\mathrm{d};{\Theta}^{\rm total}_{L})</annotation></semantics></math> as the <math id="S2.SS2.p3.m7" class="ltx_Math" alttext="i" display="inline" intent=":literal"><semantics><mi>i</mi><annotation encoding="application/x-tex">i</annotation></semantics></math>-th element of <math id="S2.SS2.p3.m8" class="ltx_Math" alttext="\mathrm{x}^{l}(\mathrm{d};{\Theta}^{\rm total}_{L})" display="inline" intent=":literal"><semantics><mrow><msup><mi>x</mi><mi>l</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>d</mi><mo>,</mo><msubsup><mi mathvariant="normal">Θ</mi><mi>L</mi><mi>total</mi></msubsup><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathrm{x}^{l}(\mathrm{d};{\Theta}^{\rm total}_{L})</annotation></semantics></math>.
Therefore <math id="S2.SS2.p3.m9" class="ltx_Math" alttext="\mathrm{x}^{l}(\mathrm{d};{\Theta}^{\rm total}_{L})" display="inline" intent=":literal"><semantics><mrow><msup><mi>x</mi><mi>l</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>d</mi><mo>,</mo><msubsup><mi mathvariant="normal">Θ</mi><mi>L</mi><mi>total</mi></msubsup><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathrm{x}^{l}(\mathrm{d};{\Theta}^{\rm total}_{L})</annotation></semantics></math> can be seen as the functions from <math id="S2.SS2.p3.m10" class="ltx_Math" alttext="\mathbb{R}^{n_{\mathrm{d}}}" display="inline" intent=":literal"><semantics><msup><mi>ℝ</mi><msub><mi>n</mi><mi>d</mi></msub></msup><annotation encoding="application/x-tex">\mathbb{R}^{n_{\mathrm{d}}}</annotation></semantics></math> to <math id="S2.SS2.p3.m11" class="ltx_Math" alttext="\mathbb{R}^{n}" display="inline" intent=":literal"><semantics><msup><mi>ℝ</mi><mi>n</mi></msup><annotation encoding="application/x-tex">\mathbb{R}^{n}</annotation></semantics></math> when the parameter <math id="S2.SS2.p3.m12" class="ltx_Math" alttext="{\Theta}^{\rm total}_{L}" display="inline" intent=":literal"><semantics><msubsup><mi mathvariant="normal">Θ</mi><mi>L</mi><mi>total</mi></msubsup><annotation encoding="application/x-tex">{\Theta}^{\rm total}_{L}</annotation></semantics></math> is given, and we can define the hypothesis set of discrete-time ResNet at <math id="S2.SS2.p3.m13" class="ltx_Math" alttext="l" display="inline" intent=":literal"><semantics><mi>l</mi><annotation encoding="application/x-tex">l</annotation></semantics></math>-th (<math id="S2.SS2.p3.m14" class="ltx_Math" alttext="0\leq l\leq L" display="inline" intent=":literal"><semantics><mrow><mn>0</mn><mo>≤</mo><mi>l</mi><mo>≤</mo><mi>L</mi></mrow><annotation encoding="application/x-tex">0\leq l\leq L</annotation></semantics></math>) layer as</p>
<table id="S2.E3" class="ltx_equationgroup ltx_eqn_table">
<tbody>
<tr id="S2.E3X" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S2.E3X.m2" class="ltx_Math" alttext="\displaystyle\mathcal{F}^{l}:=\{\mathrm{x}^{l}(\cdot;{\Theta}^{\rm total}_{L})|" display="inline" intent=":literal"><semantics><mrow><mi class="ltx_font_mathcaligraphic">ℱ</mi><msup><mrow></mrow><mi>l</mi></msup><mo>:=</mo><mo stretchy="false">{</mo><mi>x</mi><msup><mrow></mrow><mi>l</mi></msup><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo>;</mo><mi mathvariant="normal">Θ</mi><msup><mrow></mrow><mi>total</mi></msup><msub><mrow></mrow><mi>L</mi></msub><mo stretchy="false">)</mo><mo fence="false" stretchy="false">|</mo></mrow><annotation encoding="application/x-tex">\displaystyle\mathcal{F}^{l}:=\{\mathrm{x}^{l}(\cdot;{\Theta}^{\rm total}_{L})|</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S2.E3X.m3" class="ltx_Math" alttext="\displaystyle\mathrm{x}^{l}(\cdot;{\Theta}^{\rm total}_{L}):\mathbb{R}^{n_{\mathrm{d}}}\rightarrow\mathbb{R}^{n}\text{ is the output function of {the $l$-th} }" display="inline" intent=":literal"><semantics><mrow><mrow><msup><mi>x</mi><mi>l</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo>,</mo><msubsup><mi mathvariant="normal">Θ</mi><mi>L</mi><mi>total</mi></msubsup><mo rspace="0.278em" stretchy="false">)</mo></mrow></mrow><mo rspace="0.278em">:</mo><mrow><msup><mi>ℝ</mi><msub><mi>n</mi><mi>d</mi></msub></msup><mo stretchy="false">→</mo><mrow><msup><mi>ℝ</mi><mi>n</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mtext> is the output function of the </mtext><mi>l</mi><mtext>-th</mtext></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\mathrm{x}^{l}(\cdot;{\Theta}^{\rm total}_{L}):\mathbb{R}^{n_{\mathrm{d}}}\rightarrow\mathbb{R}^{n}\text{ is the output function of {the $l$-th} }</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="2" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equationgroup ltx_align_right">(3)</span></td></tr>
<tr id="S2.E3Xa" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S2.E3Xa.m2" class="ltx_Math" alttext="\displaystyle\text{layer in Eq.(\ref{equation: discrete-time ResNet}) with parameter }{\Theta}^{\rm total}_{L}\in\Omega_{{\Theta}^{\rm total}_{L}}\}." display="inline" intent=":literal"><semantics><mrow><mrow><mtext>layer in Eq.(</mtext><mtext><a href="#S2.E1" title="Equation 1 ‣ 2.2 Residual neural network and its dynamical system modeling ‣ 2 Notations and problem formulation ‣ On the Generalization Behavior of Deep Residual Networks From a Dynamical System Perspective" class="ltx_ref"><span class="ltx_text ltx_ref_tag">1</span></a></mtext><mtext>) with parameter </mtext></mrow><mi mathvariant="normal">Θ</mi><msup><mrow></mrow><mi>total</mi></msup><msub><mrow></mrow><mi>L</mi></msub><mo>∈</mo><mi mathvariant="normal">Ω</mi><msub><mrow></mrow><msubsup><mi mathvariant="normal">Θ</mi><mi>L</mi><mi>total</mi></msubsup></msub><mo stretchy="false">}</mo><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\text{layer in Eq.(\ref{equation: discrete-time ResNet}) with parameter }{\Theta}^{\rm total}_{L}\in\Omega_{{\Theta}^{\rm total}_{L}}\}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S2.SS2.p3.4" class="ltx_p">The class of scalar functions representing the <math id="S2.SS2.p3.m15" class="ltx_Math" alttext="i" display="inline" intent=":literal"><semantics><mi>i</mi><annotation encoding="application/x-tex">i</annotation></semantics></math>-th component (<math id="S2.SS2.p3.m16" class="ltx_Math" alttext="1\leq i\leq n" display="inline" intent=":literal"><semantics><mrow><mn>1</mn><mo>≤</mo><mi>i</mi><mo>≤</mo><mi>n</mi></mrow><annotation encoding="application/x-tex">1\leq i\leq n</annotation></semantics></math>) of the state variable at layer <math id="S2.SS2.p3.m17" class="ltx_Math" alttext="l" display="inline" intent=":literal"><semantics><mi>l</mi><annotation encoding="application/x-tex">l</annotation></semantics></math> is defined as</p>
<table id="S2.E4" class="ltx_equationgroup ltx_eqn_table">
<tbody>
<tr id="S2.E4X" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S2.E4X.m2" class="ltx_Math" alttext="\displaystyle\mathcal{F}^{l}_{i}:=\{\mathrm{x}_{i}^{l}(\cdot;{\Theta}^{\rm total}_{L})|" display="inline" intent=":literal"><semantics><mrow><mi class="ltx_font_mathcaligraphic">ℱ</mi><msup><mrow></mrow><mi>l</mi></msup><msub><mrow></mrow><mi>i</mi></msub><mo>:=</mo><mo stretchy="false">{</mo><mi>x</mi><msub><mrow></mrow><mi>i</mi></msub><msup><mrow></mrow><mi>l</mi></msup><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo>;</mo><mi mathvariant="normal">Θ</mi><msup><mrow></mrow><mi>total</mi></msup><msub><mrow></mrow><mi>L</mi></msub><mo stretchy="false">)</mo><mo fence="false" stretchy="false">|</mo></mrow><annotation encoding="application/x-tex">\displaystyle\mathcal{F}^{l}_{i}:=\{\mathrm{x}_{i}^{l}(\cdot;{\Theta}^{\rm total}_{L})|</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S2.E4X.m3" class="ltx_Math" alttext="\displaystyle\mathrm{x}_{i}^{l}(\cdot;{\Theta}^{\rm total}_{L}):\mathbb{R}^{n_{\mathrm{d}}}\rightarrow\mathbb{R}\text{ is the $i$-th component of }\mathrm{x}^{l}(\cdot;{\Theta}^{\rm total}_{L})" display="inline" intent=":literal"><semantics><mrow><mrow><msubsup><mi>x</mi><mi>i</mi><mi>l</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo>,</mo><msubsup><mi mathvariant="normal">Θ</mi><mi>L</mi><mi>total</mi></msubsup><mo rspace="0.278em" stretchy="false">)</mo></mrow></mrow><mo rspace="0.278em">:</mo><mrow><msup><mi>ℝ</mi><msub><mi>n</mi><mi>d</mi></msub></msup><mo stretchy="false">→</mo><mrow><mi>ℝ</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mtext> is the </mtext><mi>i</mi><mtext>-th component of </mtext></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mi>x</mi><mi>l</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo>,</mo><msubsup><mi mathvariant="normal">Θ</mi><mi>L</mi><mi>total</mi></msubsup><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\mathrm{x}_{i}^{l}(\cdot;{\Theta}^{\rm total}_{L}):\mathbb{R}^{n_{\mathrm{d}}}\rightarrow\mathbb{R}\text{ is the $i$-th component of }\mathrm{x}^{l}(\cdot;{\Theta}^{\rm total}_{L})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="2" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equationgroup ltx_align_right">(4)</span></td></tr>
<tr id="S2.E4Xa" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S2.E4Xa.m2" class="ltx_Math" alttext="\displaystyle\text{ determined by Eq.\eqref{equation: discrete-time ResNet} with parameter }{\Theta}^{\rm total}_{L}\in\Omega_{{\Theta}^{\rm total}_{L}}\}." display="inline" intent=":literal"><semantics><mrow><mrow><mtext>determined by Eq.(</mtext><mtext><a href="#S2.E1" title="Equation 1 ‣ 2.2 Residual neural network and its dynamical system modeling ‣ 2 Notations and problem formulation ‣ On the Generalization Behavior of Deep Residual Networks From a Dynamical System Perspective" class="ltx_ref"><span class="ltx_text ltx_ref_tag">1</span></a></mtext><mtext>) with parameter </mtext></mrow><mi mathvariant="normal">Θ</mi><msup><mrow></mrow><mi>total</mi></msup><msub><mrow></mrow><mi>L</mi></msub><mo>∈</mo><mi mathvariant="normal">Ω</mi><msub><mrow></mrow><msubsup><mi mathvariant="normal">Θ</mi><mi>L</mi><mi>total</mi></msubsup></msub><mo stretchy="false">}</mo><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\text{ determined by Eq.\eqref{equation: discrete-time ResNet} with parameter }{\Theta}^{\rm total}_{L}\in\Omega_{{\Theta}^{\rm total}_{L}}\}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S2.SS2.p3.5" class="ltx_p">Note that the hypothesis classes <math id="S2.SS2.p3.m18" class="ltx_Math" alttext="\mathcal{F}^{l}" display="inline" intent=":literal"><semantics><msup><mi class="ltx_font_mathcaligraphic">ℱ</mi><mi>l</mi></msup><annotation encoding="application/x-tex">\mathcal{F}^{l}</annotation></semantics></math> and <math id="S2.SS2.p3.m19" class="ltx_Math" alttext="\mathcal{F}_{i}^{l}" display="inline" intent=":literal"><semantics><msubsup><mi class="ltx_font_mathcaligraphic">ℱ</mi><mi>i</mi><mi>l</mi></msubsup><annotation encoding="application/x-tex">\mathcal{F}_{i}^{l}</annotation></semantics></math> (<math id="S2.SS2.p3.m20" class="ltx_Math" alttext="0\leq l\leq L" display="inline" intent=":literal"><semantics><mrow><mn>0</mn><mo>≤</mo><mi>l</mi><mo>≤</mo><mi>L</mi></mrow><annotation encoding="application/x-tex">0\leq l\leq L</annotation></semantics></math>) consist of vector-valued and scalar-valued functions induced by deep neural networks with residual architectures as given in Eq.(<a href="#S2.E1" title="Equation 1 ‣ 2.2 Residual neural network and its dynamical system modeling ‣ 2 Notations and problem formulation ‣ On the Generalization Behavior of Deep Residual Networks From a Dynamical System Perspective" class="ltx_ref"><span class="ltx_text ltx_ref_tag">1</span></a>), and parameterized by parameters in <math id="S2.SS2.p3.m21" class="ltx_Math" alttext="\Omega_{{\Theta}^{\rm total}_{L}}" display="inline" intent=":literal"><semantics><msub><mi mathvariant="normal">Ω</mi><msubsup><mi mathvariant="normal">Θ</mi><mi>L</mi><mi>total</mi></msubsup></msub><annotation encoding="application/x-tex">\Omega_{{\Theta}^{\rm total}_{L}}</annotation></semantics></math>. For notational simplicity, we omit the explicit dependence of the hypothesis sets on the parameter set, as <math id="S2.SS2.p3.m22" class="ltx_Math" alttext="\Omega_{{\Theta}^{\rm total}_{L}}" display="inline" intent=":literal"><semantics><msub><mi mathvariant="normal">Ω</mi><msubsup><mi mathvariant="normal">Θ</mi><mi>L</mi><mi>total</mi></msubsup></msub><annotation encoding="application/x-tex">\Omega_{{\Theta}^{\rm total}_{L}}</annotation></semantics></math> is fixed throughout the paper.</p>
</div>
<div id="S2.SS2.p4" class="ltx_para">
<p id="S2.SS2.p4.2" class="ltx_p">The dynamical system approach modeled the discrete-time ResNet Eq.(<a href="#S2.E1" title="Equation 1 ‣ 2.2 Residual neural network and its dynamical system modeling ‣ 2 Notations and problem formulation ‣ On the Generalization Behavior of Deep Residual Networks From a Dynamical System Perspective" class="ltx_ref"><span class="ltx_text ltx_ref_tag">1</span></a>)
as a continuous-time ODE <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib16" title="" class="ltx_ref">12</a>, <a href="#bib.bib17" title="" class="ltx_ref">19</a>]</cite>. Therefore, we consider the following continuous-time counterpart of Eq.(<a href="#S2.E1" title="Equation 1 ‣ 2.2 Residual neural network and its dynamical system modeling ‣ 2 Notations and problem formulation ‣ On the Generalization Behavior of Deep Residual Networks From a Dynamical System Perspective" class="ltx_ref"><span class="ltx_text ltx_ref_tag">1</span></a>)</p>
<table id="S2.E5" class="ltx_equationgroup ltx_eqn_table">
<tbody>
<tr id="S2.E5X" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S2.E5X.m2" class="ltx_Math" alttext="\displaystyle\frac{\mathrm{d}{\mathbb{x}}(t)}{\mathrm{d}t}" display="inline" intent=":literal"><semantics><mstyle displaystyle="true"><mfrac><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝕩</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></mfrac></mstyle><annotation encoding="application/x-tex">\displaystyle\frac{\mathrm{d}{\mathbb{x}}(t)}{\mathrm{d}t}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S2.E5X.m3" class="ltx_Math" alttext="\displaystyle=\mathbb{W}(t)\psi\circ(\mathbb{V}(t)\mathbb{x}(t)+\mathbb{b}(t))+\mathbb{c}(t),t\in[0,T]," display="inline" intent=":literal"><semantics><mrow><mo>=</mo><mi>𝕎</mi><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo><mi>ψ</mi><mo lspace="0.222em" rspace="0.222em">∘</mo><mo stretchy="false">(</mo><mi>𝕍</mi><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo><mi>𝕩</mi><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo><mo>+</mo><mi>𝕓</mi><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo><mo stretchy="false">)</mo><mo>+</mo><mi>𝕔</mi><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo><mo>,</mo><mi>t</mi><mo>∈</mo><mo stretchy="false">[</mo><mn>0</mn><mo>,</mo><mi>T</mi><mo stretchy="false">]</mo><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle=\mathbb{W}(t)\psi\circ(\mathbb{V}(t)\mathbb{x}(t)+\mathbb{b}(t))+\mathbb{c}(t),t\in[0,T],</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="2" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equationgroup ltx_align_right">(5)</span></td></tr>
<tr id="S2.E5Xa" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S2.E5Xa.m2" class="ltx_Math" alttext="\displaystyle\mathbb{x}(0)" display="inline" intent=":literal"><semantics><mrow><mi>𝕩</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\mathbb{x}(0)</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S2.E5Xa.m3" class="ltx_Math" alttext="\displaystyle=\psi\circ(\mathrm{U}\mathrm{d}+\mathrm{a})." display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>=</mo><mrow><mi>ψ</mi><mo lspace="0.222em" rspace="0.222em">∘</mo><mrow><mo stretchy="false">(</mo><mrow><mi>Ud</mi><mo>+</mo><mi>a</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle=\psi\circ(\mathrm{U}\mathrm{d}+\mathrm{a}).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S2.SS2.p4.3" class="ltx_p">Similar to the discrete-time case, the learnable parameters of (<a href="#S2.E5" title="Equation 5 ‣ 2.2 Residual neural network and its dynamical system modeling ‣ 2 Notations and problem formulation ‣ On the Generalization Behavior of Deep Residual Networks From a Dynamical System Perspective" class="ltx_ref"><span class="ltx_text ltx_ref_tag">5</span></a>) are packaged as <math id="S2.SS2.p4.m1" class="ltx_Math" alttext="\boldsymbol{\Theta}^{\rm total}=({\Theta}^{\rm pre},\boldsymbol{\Theta})" display="inline" intent=":literal"><semantics><mrow><msup><mi>𝚯</mi><mi>total</mi></msup><mo>=</mo><mrow><mo stretchy="false">(</mo><msup><mi mathvariant="normal">Θ</mi><mi>pre</mi></msup><mo>,</mo><mi>𝚯</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\boldsymbol{\Theta}^{\rm total}=({\Theta}^{\rm pre},\boldsymbol{\Theta})</annotation></semantics></math>, where <math id="S2.SS2.p4.m2" class="ltx_Math" alttext="{\Theta}^{\rm pre}=(\mathrm{U},\mathrm{a})" display="inline" intent=":literal"><semantics><mrow><msup><mi mathvariant="normal">Θ</mi><mi>pre</mi></msup><mo>=</mo><mrow><mo stretchy="false">(</mo><mi>U</mi><mo>,</mo><mi>a</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">{\Theta}^{\rm pre}=(\mathrm{U},\mathrm{a})</annotation></semantics></math>, <math id="S2.SS2.p4.m3" class="ltx_Math" alttext="\boldsymbol{\Theta}(t)=(\mathbb{V}(t),\mathbb{W}(t),\mathbb{b}(t)," display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mi>𝚯</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mi>𝕍</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mrow><mi>𝕎</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mrow><mi>𝕓</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo fence="true" lspace="0em" rspace="0em">CLOSE</mo></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\boldsymbol{\Theta}(t)=(\mathbb{V}(t),\mathbb{W}(t),\mathbb{b}(t),</annotation></semantics></math> <math id="S2.SS2.p4.m4" class="ltx_Math" alttext="\mathbb{c}(t))\in\mathcal{E},t\in[0,T]" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mo fence="true" rspace="0em">OPEN</mo><mrow><mi>𝕔</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow><mo>∈</mo><mi class="ltx_font_mathcaligraphic">ℰ</mi></mrow><mo>,</mo><mrow><mi>t</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mrow><mn>0</mn><mo>,</mo><mi>T</mi></mrow><mo stretchy="false">]</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\mathbb{c}(t))\in\mathcal{E},t\in[0,T]</annotation></semantics></math>. We then consider the parameter space of <math id="S2.SS2.p4.m5" class="ltx_Math" alttext="\boldsymbol{\Theta}" display="inline" intent=":literal"><semantics><mi>𝚯</mi><annotation encoding="application/x-tex">\boldsymbol{\Theta}</annotation></semantics></math> as <math id="S2.SS2.p4.m6" class="ltx_Math" alttext="\mathcal{C}([0,T];\mathcal{E})\cap\mathcal{H}^{1}(0,T;\mathcal{E})" display="inline" intent=":literal"><semantics><mrow><mrow><mi class="ltx_font_mathcaligraphic">𝒞</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mo stretchy="false">[</mo><mrow><mn>0</mn><mo>,</mo><mi>T</mi></mrow><mo stretchy="false">]</mo></mrow><mo>,</mo><mi class="ltx_font_mathcaligraphic">ℰ</mi><mo stretchy="false">)</mo></mrow></mrow><mo>∩</mo><mrow><msup><mi class="ltx_font_mathcaligraphic">ℋ</mi><mn>1</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mn>0</mn><mo>,</mo><mi>T</mi><mo>,</mo><mi class="ltx_font_mathcaligraphic">ℰ</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\mathcal{C}([0,T];\mathcal{E})\cap\mathcal{H}^{1}(0,T;\mathcal{E})</annotation></semantics></math> and denote</p>
<table id="S2.Ex1" class="ltx_equationgroup ltx_eqn_table">

<tbody id="S2.Ex1X"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S2.Ex1X.m2" class="ltx_Math" alttext="\displaystyle\|\boldsymbol{\Theta}\|_{\mathcal{C}}" display="inline" intent=":literal"><semantics><msub><mrow><mo stretchy="false">‖</mo><mi>𝚯</mi><mo stretchy="false">‖</mo></mrow><mi class="ltx_font_mathcaligraphic">𝒞</mi></msub><annotation encoding="application/x-tex">\displaystyle\|\boldsymbol{\Theta}\|_{\mathcal{C}}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S2.Ex1X.m3" class="ltx_Math" alttext="\displaystyle:=\max\{\max_{0\leq t\leq T}\|\mathbb{V}(t)\|_{\infty},\max_{0\leq t\leq T}\|\mathbb{W}(t)\|_{\infty},\max_{0\leq t\leq T}\|\mathbb{b}(t)\|_{\infty},\max_{0\leq t\leq T}\|\mathbb{c}(t)\|_{\infty}\};" display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mphantom></mphantom><mo>=</mo><mrow><mi>max</mi><mo>⁡</mo><mrow><mo stretchy="false">{</mo><mrow><mrow><munder><mi>max</mi><mrow><mn>0</mn><mo>≤</mo><mi>t</mi><mo>≤</mo><mi>T</mi></mrow></munder><mo>⁡</mo><msub><mrow><mo stretchy="false">‖</mo><mrow><mi>𝕍</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">‖</mo></mrow><mi mathvariant="normal">∞</mi></msub></mrow><mo>,</mo><mrow><munder><mi>max</mi><mrow><mn>0</mn><mo>≤</mo><mi>t</mi><mo>≤</mo><mi>T</mi></mrow></munder><mo>⁡</mo><msub><mrow><mo stretchy="false">‖</mo><mrow><mi>𝕎</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">‖</mo></mrow><mi mathvariant="normal">∞</mi></msub></mrow><mo>,</mo><mrow><munder><mi>max</mi><mrow><mn>0</mn><mo>≤</mo><mi>t</mi><mo>≤</mo><mi>T</mi></mrow></munder><mo>⁡</mo><msub><mrow><mo stretchy="false">‖</mo><mrow><mi>𝕓</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">‖</mo></mrow><mi mathvariant="normal">∞</mi></msub></mrow><mo>,</mo><mrow><munder><mi>max</mi><mrow><mn>0</mn><mo>≤</mo><mi>t</mi><mo>≤</mo><mi>T</mi></mrow></munder><mo>⁡</mo><msub><mrow><mo stretchy="false">‖</mo><mrow><mi>𝕔</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">‖</mo></mrow><mi mathvariant="normal">∞</mi></msub></mrow></mrow><mo stretchy="false">}</mo></mrow></mrow></mrow></mrow><mo>;</mo></mrow><annotation encoding="application/x-tex">\displaystyle:=\max\{\max_{0\leq t\leq T}\|\mathbb{V}(t)\|_{\infty},\max_{0\leq t\leq T}\|\mathbb{W}(t)\|_{\infty},\max_{0\leq t\leq T}\|\mathbb{b}(t)\|_{\infty},\max_{0\leq t\leq T}\|\mathbb{c}(t)\|_{\infty}\};</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="S2.Ex1Xa"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S2.Ex1Xa.m2" class="ltx_Math" alttext="\displaystyle\|\boldsymbol{\Theta}\|_{\mathcal{H}^{1}}" display="inline" intent=":literal"><semantics><msub><mrow><mo stretchy="false">‖</mo><mi>𝚯</mi><mo stretchy="false">‖</mo></mrow><msup><mi class="ltx_font_mathcaligraphic">ℋ</mi><mn>1</mn></msup></msub><annotation encoding="application/x-tex">\displaystyle\|\boldsymbol{\Theta}\|_{\mathcal{H}^{1}}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S2.Ex1Xa.m3" class="ltx_Math" alttext="\displaystyle:=\max\{\|\mathbb{V}\|_{\mathcal{H}^{1}},\|\mathbb{W}\|_{\mathcal{H}^{1}},\|\mathbb{b}\|_{\mathcal{H}^{1}},\|\mathbb{c}\|_{\mathcal{H}^{1}}\}." display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mphantom></mphantom><mo>=</mo><mrow><mi>max</mi><mo>⁡</mo><mrow><mo stretchy="false">{</mo><mrow><msub><mrow><mo stretchy="false">‖</mo><mi>𝕍</mi><mo stretchy="false">‖</mo></mrow><msup><mi class="ltx_font_mathcaligraphic">ℋ</mi><mn>1</mn></msup></msub><mo>,</mo><msub><mrow><mo stretchy="false">‖</mo><mi>𝕎</mi><mo stretchy="false">‖</mo></mrow><msup><mi class="ltx_font_mathcaligraphic">ℋ</mi><mn>1</mn></msup></msub><mo>,</mo><msub><mrow><mo stretchy="false">‖</mo><mi>𝕓</mi><mo stretchy="false">‖</mo></mrow><msup><mi class="ltx_font_mathcaligraphic">ℋ</mi><mn>1</mn></msup></msub><mo>,</mo><msub><mrow><mo stretchy="false">‖</mo><mi>𝕔</mi><mo stretchy="false">‖</mo></mrow><msup><mi class="ltx_font_mathcaligraphic">ℋ</mi><mn>1</mn></msup></msub></mrow><mo stretchy="false">}</mo></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle:=\max\{\|\mathbb{V}\|_{\mathcal{H}^{1}},\|\mathbb{W}\|_{\mathcal{H}^{1}},\|\mathbb{b}\|_{\mathcal{H}^{1}},\|\mathbb{c}\|_{\mathcal{H}^{1}}\}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S2.SS2.p4.4" class="ltx_p">Then, for <math id="S2.SS2.p4.m7" class="ltx_Math" alttext="\boldsymbol{\Theta}^{\rm total}=({\Theta}^{\rm pre},\boldsymbol{\Theta})\in\mathcal{E}^{\rm pre}\times(\mathcal{C}([0,T];\mathcal{E})\cap\mathcal{H}^{1}(0,T;\mathcal{E}))" display="inline" intent=":literal"><semantics><mrow><msup><mi>𝚯</mi><mi>total</mi></msup><mo>=</mo><mrow><mo stretchy="false">(</mo><msup><mi mathvariant="normal">Θ</mi><mi>pre</mi></msup><mo>,</mo><mi>𝚯</mi><mo stretchy="false">)</mo></mrow><mo>∈</mo><mrow><msup><mi class="ltx_font_mathcaligraphic">ℰ</mi><mi>pre</mi></msup><mo lspace="0.222em" rspace="0.222em">×</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mi class="ltx_font_mathcaligraphic">𝒞</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mo stretchy="false">[</mo><mrow><mn>0</mn><mo>,</mo><mi>T</mi></mrow><mo stretchy="false">]</mo></mrow><mo>,</mo><mi class="ltx_font_mathcaligraphic">ℰ</mi><mo stretchy="false">)</mo></mrow></mrow><mo>∩</mo><mrow><msup><mi class="ltx_font_mathcaligraphic">ℋ</mi><mn>1</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mn>0</mn><mo>,</mo><mi>T</mi><mo>,</mo><mi class="ltx_font_mathcaligraphic">ℰ</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\boldsymbol{\Theta}^{\rm total}=({\Theta}^{\rm pre},\boldsymbol{\Theta})\in\mathcal{E}^{\rm pre}\times(\mathcal{C}([0,T];\mathcal{E})\cap\mathcal{H}^{1}(0,T;\mathcal{E}))</annotation></semantics></math>, a norm is given as</p>
<table id="S2.E6" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S2.E6.m1" class="ltx_Math" alttext="\|\boldsymbol{\Theta}^{\rm total}\|=\max\{\|\mathrm{U}\|_{\infty},\|\mathrm{a}\|_{\infty},\|\boldsymbol{\Theta}\|_{\mathcal{C}},{\|\boldsymbol{\Theta}\|_{\mathcal{H}^{1}}}\}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mo stretchy="false">‖</mo><msup><mi>𝚯</mi><mi>total</mi></msup><mo stretchy="false">‖</mo></mrow><mo>=</mo><mrow><mi>max</mi><mo>⁡</mo><mrow><mo stretchy="false">{</mo><mrow><msub><mrow><mo stretchy="false">‖</mo><mi>U</mi><mo stretchy="false">‖</mo></mrow><mi mathvariant="normal">∞</mi></msub><mo>,</mo><msub><mrow><mo stretchy="false">‖</mo><mi>a</mi><mo stretchy="false">‖</mo></mrow><mi mathvariant="normal">∞</mi></msub><mo>,</mo><msub><mrow><mo stretchy="false">‖</mo><mi>𝚯</mi><mo stretchy="false">‖</mo></mrow><mi class="ltx_font_mathcaligraphic">𝒞</mi></msub><mo>,</mo><msub><mrow><mo stretchy="false">‖</mo><mi>𝚯</mi><mo stretchy="false">‖</mo></mrow><msup><mi class="ltx_font_mathcaligraphic">ℋ</mi><mn>1</mn></msup></msub></mrow><mo stretchy="false">}</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\|\boldsymbol{\Theta}^{\rm total}\|=\max\{\|\mathrm{U}\|_{\infty},\|\mathrm{a}\|_{\infty},\|\boldsymbol{\Theta}\|_{\mathcal{C}},{\|\boldsymbol{\Theta}\|_{\mathcal{H}^{1}}}\}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(6)</span></td></tr></tbody>
</table>
<p id="S2.SS2.p4.5" class="ltx_p">The set of learnable parameters is <math id="S2.SS2.p4.m8" class="ltx_Math" alttext="\Omega_{\boldsymbol{\Theta}^{\rm total}}\subset\mathcal{E}^{\rm pre}\times(\mathcal{C}([0,T];\mathcal{E})\cap\mathcal{H}^{1}(0,T;\mathcal{E}))" display="inline" intent=":literal"><semantics><mrow><msub><mi mathvariant="normal">Ω</mi><msup><mi>𝚯</mi><mi>total</mi></msup></msub><mo>⊂</mo><mrow><msup><mi class="ltx_font_mathcaligraphic">ℰ</mi><mi>pre</mi></msup><mo lspace="0.222em" rspace="0.222em">×</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mi class="ltx_font_mathcaligraphic">𝒞</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mo stretchy="false">[</mo><mrow><mn>0</mn><mo>,</mo><mi>T</mi></mrow><mo stretchy="false">]</mo></mrow><mo>,</mo><mi class="ltx_font_mathcaligraphic">ℰ</mi><mo stretchy="false">)</mo></mrow></mrow><mo>∩</mo><mrow><msup><mi class="ltx_font_mathcaligraphic">ℋ</mi><mn>1</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mn>0</mn><mo>,</mo><mi>T</mi><mo>,</mo><mi class="ltx_font_mathcaligraphic">ℰ</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\Omega_{\boldsymbol{\Theta}^{\rm total}}\subset\mathcal{E}^{\rm pre}\times(\mathcal{C}([0,T];\mathcal{E})\cap\mathcal{H}^{1}(0,T;\mathcal{E}))</annotation></semantics></math>.</p>
</div>
<div id="S2.SS2.p5" class="ltx_para">
<p id="S2.SS2.p5.3" class="ltx_p">We rewrite the states <math id="S2.SS2.p5.m1" class="ltx_Math" alttext="\mathbb{x}(t)" display="inline" intent=":literal"><semantics><mrow><mi>𝕩</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathbb{x}(t)</annotation></semantics></math> in Eq.(<a href="#S2.E5" title="Equation 5 ‣ 2.2 Residual neural network and its dynamical system modeling ‣ 2 Notations and problem formulation ‣ On the Generalization Behavior of Deep Residual Networks From a Dynamical System Perspective" class="ltx_ref"><span class="ltx_text ltx_ref_tag">5</span></a>) as the flow map notation <math id="S2.SS2.p5.m2" class="ltx_Math" alttext="\mathbb{x}(t;\mathrm{d};\boldsymbol{\Theta}^{\rm total})" display="inline" intent=":literal"><semantics><mrow><mi>𝕩</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo>,</mo><mi>d</mi><mo>,</mo><msup><mi>𝚯</mi><mi>total</mi></msup><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathbb{x}(t;\mathrm{d};\boldsymbol{\Theta}^{\rm total})</annotation></semantics></math> to emphasize its dependency on the input data <math id="S2.SS2.p5.m3" class="ltx_Math" alttext="\mathrm{d}" display="inline" intent=":literal"><semantics><mi>d</mi><annotation encoding="application/x-tex">\mathrm{d}</annotation></semantics></math> and the learnable parameter <math id="S2.SS2.p5.m4" class="ltx_Math" alttext="\boldsymbol{\Theta}^{\rm total}" display="inline" intent=":literal"><semantics><msup><mi>𝚯</mi><mi>total</mi></msup><annotation encoding="application/x-tex">\boldsymbol{\Theta}^{\rm total}</annotation></semantics></math>.
Then the hypothesis set (or space) of continuous-time ResNet (<a href="#S2.E5" title="Equation 5 ‣ 2.2 Residual neural network and its dynamical system modeling ‣ 2 Notations and problem formulation ‣ On the Generalization Behavior of Deep Residual Networks From a Dynamical System Perspective" class="ltx_ref"><span class="ltx_text ltx_ref_tag">5</span></a>) is given as</p>
<table id="S2.E7" class="ltx_equationgroup ltx_eqn_table">
<tbody>
<tr id="S2.E7X" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S2.E7X.m2" class="ltx_Math" alttext="\displaystyle{\mathcal{F}}^{T}=\{\mathbb{x}(T;\cdot;\boldsymbol{\Theta}^{\rm total})|" display="inline" intent=":literal"><semantics><mrow><mi class="ltx_font_mathcaligraphic">ℱ</mi><msup><mrow></mrow><mi>T</mi></msup><mo>=</mo><mo stretchy="false">{</mo><mi>𝕩</mi><mo stretchy="false">(</mo><mi>T</mi><mo rspace="0em">;</mo><mo lspace="0em" rspace="0em">⋅</mo><mo>;</mo><mi>𝚯</mi><msup><mrow></mrow><mi>total</mi></msup><mo stretchy="false">)</mo><mo fence="false" stretchy="false">|</mo></mrow><annotation encoding="application/x-tex">\displaystyle{\mathcal{F}}^{T}=\{\mathbb{x}(T;\cdot;\boldsymbol{\Theta}^{\rm total})|</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S2.E7X.m3" class="ltx_Math" alttext="\displaystyle\mathbb{x}(T;\cdot;\boldsymbol{\Theta}^{\rm total}):\mathbb{R}^{n_{\mathrm{d}}}\rightarrow\mathbb{R}^{n}\text{ is the output function }" display="inline" intent=":literal"><semantics><mrow><mrow><mi>𝕩</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>T</mi><mo rspace="0em">,</mo><mo lspace="0em" rspace="0em">⋅</mo><mo>,</mo><msup><mi>𝚯</mi><mi>total</mi></msup><mo rspace="0.278em" stretchy="false">)</mo></mrow></mrow><mo rspace="0.278em">:</mo><mrow><msup><mi>ℝ</mi><msub><mi>n</mi><mi>d</mi></msub></msup><mo stretchy="false">→</mo><mrow><msup><mi>ℝ</mi><mi>n</mi></msup><mo lspace="0em" rspace="0em">​</mo><mtext> is the output function</mtext></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\mathbb{x}(T;\cdot;\boldsymbol{\Theta}^{\rm total}):\mathbb{R}^{n_{\mathrm{d}}}\rightarrow\mathbb{R}^{n}\text{ is the output function }</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="2" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equationgroup ltx_align_right">(7)</span></td></tr>
<tr id="S2.E7Xa" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S2.E7Xa.m2" class="ltx_Math" alttext="\displaystyle\text{ of Eq.(\ref{equation: continuous-time ResNet}) with parameter }\boldsymbol{\Theta}^{\rm total}\in\Omega_{\boldsymbol{\Theta}^{\rm total}}\};" display="inline" intent=":literal"><semantics><mrow><mrow><mtext>of Eq.(</mtext><mtext><a href="#S2.E5" title="Equation 5 ‣ 2.2 Residual neural network and its dynamical system modeling ‣ 2 Notations and problem formulation ‣ On the Generalization Behavior of Deep Residual Networks From a Dynamical System Perspective" class="ltx_ref"><span class="ltx_text ltx_ref_tag">5</span></a></mtext><mtext>) with parameter </mtext></mrow><mi>𝚯</mi><msup><mrow></mrow><mi>total</mi></msup><mo>∈</mo><mi mathvariant="normal">Ω</mi><msub><mrow></mrow><msup><mi>𝚯</mi><mi>total</mi></msup></msub><mo stretchy="false">}</mo><mo>;</mo></mrow><annotation encoding="application/x-tex">\displaystyle\text{ of Eq.(\ref{equation: continuous-time ResNet}) with parameter }\boldsymbol{\Theta}^{\rm total}\in\Omega_{\boldsymbol{\Theta}^{\rm total}}\};</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S2.SS2.p5.4" class="ltx_p">and the class of scalar functions that represent the <math id="S2.SS2.p5.m5" class="ltx_Math" alttext="i" display="inline" intent=":literal"><semantics><mi>i</mi><annotation encoding="application/x-tex">i</annotation></semantics></math>-th component (<math id="S2.SS2.p5.m6" class="ltx_Math" alttext="1\leq i\leq n" display="inline" intent=":literal"><semantics><mrow><mn>1</mn><mo>≤</mo><mi>i</mi><mo>≤</mo><mi>n</mi></mrow><annotation encoding="application/x-tex">1\leq i\leq n</annotation></semantics></math>) of the continuous-time state variable is defined as</p>
<table id="S2.E8" class="ltx_equationgroup ltx_eqn_table">
<tbody>
<tr id="S2.E8X" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S2.E8X.m2" class="ltx_Math" alttext="\displaystyle{\mathcal{F}}_{i}^{T}=\{\mathbb{x}_{i}(T;\cdot;\boldsymbol{\Theta}^{\rm total})|" display="inline" intent=":literal"><semantics><mrow><mi class="ltx_font_mathcaligraphic">ℱ</mi><msub><mrow></mrow><mi>i</mi></msub><msup><mrow></mrow><mi>T</mi></msup><mo>=</mo><mo stretchy="false">{</mo><mi>𝕩</mi><msub><mrow></mrow><mi>i</mi></msub><mo stretchy="false">(</mo><mi>T</mi><mo rspace="0em">;</mo><mo lspace="0em" rspace="0em">⋅</mo><mo>;</mo><mi>𝚯</mi><msup><mrow></mrow><mi>total</mi></msup><mo stretchy="false">)</mo><mo fence="false" stretchy="false">|</mo></mrow><annotation encoding="application/x-tex">\displaystyle{\mathcal{F}}_{i}^{T}=\{\mathbb{x}_{i}(T;\cdot;\boldsymbol{\Theta}^{\rm total})|</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S2.E8X.m3" class="ltx_Math" alttext="\displaystyle\mathbb{x}_{i}(T;\cdot;\boldsymbol{\Theta}^{\rm total}):\mathbb{R}^{n_{\mathrm{d}}}\rightarrow\mathbb{R}\text{ is the $i$-th component of }\mathbb{x}(T;\cdot;\boldsymbol{\Theta}^{\rm total})" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>𝕩</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>T</mi><mo rspace="0em">,</mo><mo lspace="0em" rspace="0em">⋅</mo><mo>,</mo><msup><mi>𝚯</mi><mi>total</mi></msup><mo rspace="0.278em" stretchy="false">)</mo></mrow></mrow><mo rspace="0.278em">:</mo><mrow><msup><mi>ℝ</mi><msub><mi>n</mi><mi>d</mi></msub></msup><mo stretchy="false">→</mo><mrow><mi>ℝ</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mtext> is the </mtext><mi>i</mi><mtext>-th component of </mtext></mrow><mo lspace="0em" rspace="0em">​</mo><mi>𝕩</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>T</mi><mo rspace="0em">,</mo><mo lspace="0em" rspace="0em">⋅</mo><mo>,</mo><msup><mi>𝚯</mi><mi>total</mi></msup><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\mathbb{x}_{i}(T;\cdot;\boldsymbol{\Theta}^{\rm total}):\mathbb{R}^{n_{\mathrm{d}}}\rightarrow\mathbb{R}\text{ is the $i$-th component of }\mathbb{x}(T;\cdot;\boldsymbol{\Theta}^{\rm total})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="2" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equationgroup ltx_align_right">(8)</span></td></tr>
<tr id="S2.E8Xa" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S2.E8Xa.m2" class="ltx_Math" alttext="\displaystyle\text{ determined by Eq.(\ref{equation: continuous-time ResNet}) with parameter }\boldsymbol{\Theta}^{\rm total}\in\Omega_{\boldsymbol{\Theta}^{\rm total}}\}." display="inline" intent=":literal"><semantics><mrow><mrow><mtext>determined by Eq.(</mtext><mtext><a href="#S2.E5" title="Equation 5 ‣ 2.2 Residual neural network and its dynamical system modeling ‣ 2 Notations and problem formulation ‣ On the Generalization Behavior of Deep Residual Networks From a Dynamical System Perspective" class="ltx_ref"><span class="ltx_text ltx_ref_tag">5</span></a></mtext><mtext>) with parameter </mtext></mrow><mi>𝚯</mi><msup><mrow></mrow><mi>total</mi></msup><mo>∈</mo><mi mathvariant="normal">Ω</mi><msub><mrow></mrow><msup><mi>𝚯</mi><mi>total</mi></msup></msub><mo stretchy="false">}</mo><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\text{ determined by Eq.(\ref{equation: continuous-time ResNet}) with parameter }\boldsymbol{\Theta}^{\rm total}\in\Omega_{\boldsymbol{\Theta}^{\rm total}}\}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S2.SS2.p5.5" class="ltx_p">Similar to the discrete-time case, we omit the dependence of the hypothesis sets on the parameter set, as <math id="S2.SS2.p5.m7" class="ltx_Math" alttext="\Omega_{\boldsymbol{\Theta}^{\rm total}}" display="inline" intent=":literal"><semantics><msub><mi mathvariant="normal">Ω</mi><msup><mi>𝚯</mi><mi>total</mi></msup></msub><annotation encoding="application/x-tex">\Omega_{\boldsymbol{\Theta}^{\rm total}}</annotation></semantics></math> is fixed throughout the paper.</p>
</div>
</section>
<section id="S2.SS3" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">2.3 </span>The problem of generalization for discrete- and continuous-time ResNets</h3>

<div id="S2.SS3.p1" class="ltx_para">
<p id="S2.SS3.p1.1" class="ltx_p">Let <math id="S2.SS3.p1.m1" class="ltx_Math" alttext="\mathfrak{D}" display="inline" intent=":literal"><semantics><mi>𝔇</mi><annotation encoding="application/x-tex">\mathfrak{D}</annotation></semantics></math> be an (often unknown) probability distribution supported on a <math id="S2.SS3.p1.m2" class="ltx_Math" alttext="\sigma" display="inline" intent=":literal"><semantics><mi>σ</mi><annotation encoding="application/x-tex">\sigma</annotation></semantics></math>-algebra of <math id="S2.SS3.p1.m3" class="ltx_Math" alttext="\mathbb{R}^{n_{\mathrm{d}}}\times\mathbb{R}^{n}" display="inline" intent=":literal"><semantics><mrow><msup><mi>ℝ</mi><msub><mi>n</mi><mi>d</mi></msub></msup><mo lspace="0.222em" rspace="0.222em">×</mo><msup><mi>ℝ</mi><mi>n</mi></msup></mrow><annotation encoding="application/x-tex">\mathbb{R}^{n_{\mathrm{d}}}\times\mathbb{R}^{n}</annotation></semantics></math>. In supervised learning, the objective is to approximate a target function <math id="S2.SS3.p1.m4" class="ltx_Math" alttext="f:\mathbb{R}^{n_{\mathrm{d}}}\to\mathbb{R}^{n}" display="inline" intent=":literal"><semantics><mrow><mi>f</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><msup><mi>ℝ</mi><msub><mi>n</mi><mi>d</mi></msub></msup><mo stretchy="false">→</mo><msup><mi>ℝ</mi><mi>n</mi></msup></mrow></mrow><annotation encoding="application/x-tex">f:\mathbb{R}^{n_{\mathrm{d}}}\to\mathbb{R}^{n}</annotation></semantics></math> that effectively “characterizes” <math id="S2.SS3.p1.m5" class="ltx_Math" alttext="\mathfrak{D}" display="inline" intent=":literal"><semantics><mi>𝔇</mi><annotation encoding="application/x-tex">\mathfrak{D}</annotation></semantics></math>.</p>
</div>
<div id="S2.SS3.p2" class="ltx_para">
<p id="S2.SS3.p2.3" class="ltx_p">The target function is determined by solving the following optimal control problem</p>
<table id="S2.E9" class="ltx_equationgroup ltx_eqn_table">
<tbody>
<tr id="S2.E9X" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S2.E9X.m2" class="ltx_Math" alttext="\displaystyle\inf\limits_{{\Theta}^{\rm total}_{L}\in\Omega_{{\Theta}^{\rm total}_{L}}}\Big\{\mathfrak{R}_{{\mathfrak{D}}}(\mathrm{x}^{L}(\cdot;{\Theta}^{\rm total}_{L})):=\mathbb{E}_{(\mathrm{d},\mathrm{g})\sim{\mathfrak{D}}}\big[{\ell}(\mathrm{x}^{L}(\mathrm{d};{\Theta}^{\rm total}_{L}),\mathrm{g})\big]\Big\}" display="inline" intent=":literal"><semantics><mrow><mo movablelimits="false" rspace="0em">inf</mo><msub><mrow></mrow><mrow><msubsup><mi mathvariant="normal">Θ</mi><mi>L</mi><mi>total</mi></msubsup><mo>∈</mo><msub><mi mathvariant="normal">Ω</mi><msubsup><mi mathvariant="normal">Θ</mi><mi>L</mi><mi>total</mi></msubsup></msub></mrow></msub><mo stretchy="false">{</mo><mi>ℜ</mi><msub><mrow></mrow><mi>𝔇</mi></msub><mo stretchy="false">(</mo><mi>x</mi><msup><mrow></mrow><mi>L</mi></msup><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo>;</mo><mi mathvariant="normal">Θ</mi><msup><mrow></mrow><mi>total</mi></msup><msub><mrow></mrow><mi>L</mi></msub><mo stretchy="false">)</mo><mo stretchy="false">)</mo><mo>:=</mo><mi>𝔼</mi><msub><mrow></mrow><mrow><mrow><mo stretchy="false">(</mo><mi>d</mi><mo>,</mo><mi>g</mi><mo stretchy="false">)</mo></mrow><mo>∼</mo><mi>𝔇</mi></mrow></msub><mo maxsize="1.200em" minsize="1.200em">[</mo><mi mathvariant="normal">ℓ</mi><mo stretchy="false">(</mo><mi>x</mi><msup><mrow></mrow><mi>L</mi></msup><mo stretchy="false">(</mo><mi>d</mi><mo>;</mo><mi mathvariant="normal">Θ</mi><msup><mrow></mrow><mi>total</mi></msup><msub><mrow></mrow><mi>L</mi></msub><mo stretchy="false">)</mo><mo>,</mo><mi>g</mi><mo stretchy="false">)</mo><mo maxsize="1.200em" minsize="1.200em">]</mo><mo stretchy="false">}</mo></mrow><annotation encoding="application/x-tex">\displaystyle\inf\limits_{{\Theta}^{\rm total}_{L}\in\Omega_{{\Theta}^{\rm total}_{L}}}\Big\{\mathfrak{R}_{{\mathfrak{D}}}(\mathrm{x}^{L}(\cdot;{\Theta}^{\rm total}_{L})):=\mathbb{E}_{(\mathrm{d},\mathrm{g})\sim{\mathfrak{D}}}\big[{\ell}(\mathrm{x}^{L}(\mathrm{d};{\Theta}^{\rm total}_{L}),\mathrm{g})\big]\Big\}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="2" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equationgroup ltx_align_right">(9)</span></td></tr>
<tr id="S2.E9Xa" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S2.E9Xa.m2" class="ltx_Math" alttext="\displaystyle\rm{\displaystyle subject\ to:}\ \mathrm{x}^{L}(\mathrm{d};{\Theta}^{\rm total}_{L})\text{ is the end state of Eq.(\ref{equation: discrete-time ResNet}) with input }\mathrm{d}," display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mi>subject</mi><mo lspace="0.500em" rspace="0em">​</mo><mi>to</mi></mrow><mo lspace="0.278em" rspace="0.778em">:</mo><mrow><msup><mi>x</mi><mi>L</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>d</mi><mo>,</mo><msubsup><mi mathvariant="normal">Θ</mi><mi>L</mi><mi>total</mi></msubsup><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mtext> is the end state of Eq.(</mtext><mtext><a href="#S2.E1" title="Equation 1 ‣ 2.2 Residual neural network and its dynamical system modeling ‣ 2 Notations and problem formulation ‣ On the Generalization Behavior of Deep Residual Networks From a Dynamical System Perspective" class="ltx_ref"><span class="ltx_text ltx_ref_tag">1</span></a></mtext><mtext>) with input </mtext></mrow><mo lspace="0em" rspace="0em">​</mo><mi>d</mi></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\rm{\displaystyle subject\ to:}\ \mathrm{x}^{L}(\mathrm{d};{\Theta}^{\rm total}_{L})\text{ is the end state of Eq.(\ref{equation: discrete-time ResNet}) with input }\mathrm{d},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S2.SS3.p2.4" class="ltx_p">where <math id="S2.SS3.p2.m1" class="ltx_Math" alttext="\ell:\mathbb{R}^{n}\times\mathbb{R}^{n}\rightarrow[0,\infty)" display="inline" intent=":literal"><semantics><mrow><mi mathvariant="normal">ℓ</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mrow><msup><mi>ℝ</mi><mi>n</mi></msup><mo lspace="0.222em" rspace="0.222em">×</mo><msup><mi>ℝ</mi><mi>n</mi></msup></mrow><mo stretchy="false">→</mo><mrow><mo stretchy="false">[</mo><mn>0</mn><mo>,</mo><mi mathvariant="normal">∞</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\ell:\mathbb{R}^{n}\times\mathbb{R}^{n}\rightarrow[0,\infty)</annotation></semantics></math> is a loss function, and <math id="S2.SS3.p2.m2" class="ltx_Math" alttext="\mathfrak{R}_{{\mathfrak{D}}}(\mathrm{x}^{L}(\cdot;{\Theta}^{\rm total}_{L}))" display="inline" intent=":literal"><semantics><mrow><msub><mi>ℜ</mi><mi>𝔇</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mi>x</mi><mi>L</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo>,</mo><msubsup><mi mathvariant="normal">Θ</mi><mi>L</mi><mi>total</mi></msubsup><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathfrak{R}_{{\mathfrak{D}}}(\mathrm{x}^{L}(\cdot;{\Theta}^{\rm total}_{L}))</annotation></semantics></math> is the so-called expected loss or risk. Since the distribution <math id="S2.SS3.p2.m3" class="ltx_Math" alttext="\mathfrak{D}" display="inline" intent=":literal"><semantics><mi>𝔇</mi><annotation encoding="application/x-tex">\mathfrak{D}</annotation></semantics></math> is unknown, this quantity cannot be computed directly. Instead, we approximate it using a training dataset <math id="S2.SS3.p2.m4" class="ltx_Math" alttext="\mathcal{S}:=\{(\mathrm{d}_{(s)},\mathrm{g}_{(s)})\}_{s=1}^{S}" display="inline" intent=":literal"><semantics><mrow><mi class="ltx_font_mathcaligraphic">𝒮</mi><mo>:=</mo><msubsup><mrow><mo stretchy="false">{</mo><mrow><mo stretchy="false">(</mo><msub><mi>d</mi><mrow><mo stretchy="false">(</mo><mi>s</mi><mo stretchy="false">)</mo></mrow></msub><mo>,</mo><msub><mi>g</mi><mrow><mo stretchy="false">(</mo><mi>s</mi><mo stretchy="false">)</mo></mrow></msub><mo stretchy="false">)</mo></mrow><mo stretchy="false">}</mo></mrow><mrow><mi>s</mi><mo>=</mo><mn>1</mn></mrow><mi>S</mi></msubsup></mrow><annotation encoding="application/x-tex">\mathcal{S}:=\{(\mathrm{d}_{(s)},\mathrm{g}_{(s)})\}_{s=1}^{S}</annotation></semantics></math> consisting of independently and identically distributed (i.i.d.) samples drawn from <math id="S2.SS3.p2.m5" class="ltx_Math" alttext="\mathfrak{D}" display="inline" intent=":literal"><semantics><mi>𝔇</mi><annotation encoding="application/x-tex">\mathfrak{D}</annotation></semantics></math>. The goal is then to find a hypothesis <math id="S2.SS3.p2.m6" class="ltx_Math" alttext="\mathrm{x}^{L}(\cdot;{\Theta}^{\rm total}_{L})" display="inline" intent=":literal"><semantics><mrow><msup><mi>x</mi><mi>L</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo>,</mo><msubsup><mi mathvariant="normal">Θ</mi><mi>L</mi><mi>total</mi></msubsup><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathrm{x}^{L}(\cdot;{\Theta}^{\rm total}_{L})</annotation></semantics></math> by solving the following sampled optimal control problem</p>
<table id="S2.E10" class="ltx_equationgroup ltx_eqn_table">
<tbody>
<tr id="S2.E10X" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S2.E10X.m2" class="ltx_Math" alttext="\displaystyle\inf\limits_{{\Theta}^{\rm total}_{L}\in\Omega_{{\Theta}^{\rm total}_{L}}}\Big\{\hat{\mathfrak{R}}_{\mathcal{S}}(\mathrm{x}^{L}(\cdot;{\Theta}^{\rm total}_{L})):=\frac{1}{S}\sum_{s=1}^{S}{\ell}(\mathrm{x}^{L}(\mathrm{d}_{(s)};{\Theta}^{\rm total}_{L}),\mathrm{g}_{(s)})\Big\}" display="inline" intent=":literal"><semantics><mrow><mo movablelimits="false" rspace="0em">inf</mo><msub><mrow></mrow><mrow><msubsup><mi mathvariant="normal">Θ</mi><mi>L</mi><mi>total</mi></msubsup><mo>∈</mo><msub><mi mathvariant="normal">Ω</mi><msubsup><mi mathvariant="normal">Θ</mi><mi>L</mi><mi>total</mi></msubsup></msub></mrow></msub><mo stretchy="false">{</mo><mover accent="true"><mi>ℜ</mi><mo>^</mo></mover><msub><mrow></mrow><mi class="ltx_font_mathcaligraphic">𝒮</mi></msub><mo stretchy="false">(</mo><mi>x</mi><msup><mrow></mrow><mi>L</mi></msup><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo>;</mo><mi mathvariant="normal">Θ</mi><msup><mrow></mrow><mi>total</mi></msup><msub><mrow></mrow><mi>L</mi></msub><mo stretchy="false">)</mo><mo stretchy="false">)</mo><mo>:=</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>S</mi></mfrac></mstyle><mstyle displaystyle="true"><mo movablelimits="false">∑</mo></mstyle><msub><mrow></mrow><mrow><mi>s</mi><mo>=</mo><mn>1</mn></mrow></msub><msup><mrow></mrow><mi>S</mi></msup><mi mathvariant="normal">ℓ</mi><mo stretchy="false">(</mo><mi>x</mi><msup><mrow></mrow><mi>L</mi></msup><mo stretchy="false">(</mo><mi>d</mi><msub><mrow></mrow><mrow><mo stretchy="false">(</mo><mi>s</mi><mo stretchy="false">)</mo></mrow></msub><mo>;</mo><mi mathvariant="normal">Θ</mi><msup><mrow></mrow><mi>total</mi></msup><msub><mrow></mrow><mi>L</mi></msub><mo stretchy="false">)</mo><mo>,</mo><mi>g</mi><msub><mrow></mrow><mrow><mo stretchy="false">(</mo><mi>s</mi><mo stretchy="false">)</mo></mrow></msub><mo stretchy="false">)</mo><mo stretchy="false">}</mo></mrow><annotation encoding="application/x-tex">\displaystyle\inf\limits_{{\Theta}^{\rm total}_{L}\in\Omega_{{\Theta}^{\rm total}_{L}}}\Big\{\hat{\mathfrak{R}}_{\mathcal{S}}(\mathrm{x}^{L}(\cdot;{\Theta}^{\rm total}_{L})):=\frac{1}{S}\sum_{s=1}^{S}{\ell}(\mathrm{x}^{L}(\mathrm{d}_{(s)};{\Theta}^{\rm total}_{L}),\mathrm{g}_{(s)})\Big\}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="2" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equationgroup ltx_align_right">(10)</span></td></tr>
<tr id="S2.E10Xa" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S2.E10Xa.m2" class="ltx_Math" alttext="\displaystyle\rm{\displaystyle subject\ to:}\ \mathrm{x}^{L}(\mathrm{d}_{(s)};{\Theta}^{\rm total}_{L})\text{ is the end state of Eq.(\ref{equation: discrete-time ResNet}) with input }\mathrm{d}_{(s)}," display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mi>subject</mi><mo lspace="0.500em" rspace="0em">​</mo><mi>to</mi></mrow><mo lspace="0.278em" rspace="0.778em">:</mo><mrow><msup><mi>x</mi><mi>L</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>d</mi><mrow><mo stretchy="false">(</mo><mi>s</mi><mo stretchy="false">)</mo></mrow></msub><mo>,</mo><msubsup><mi mathvariant="normal">Θ</mi><mi>L</mi><mi>total</mi></msubsup><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mtext> is the end state of Eq.(</mtext><mtext><a href="#S2.E1" title="Equation 1 ‣ 2.2 Residual neural network and its dynamical system modeling ‣ 2 Notations and problem formulation ‣ On the Generalization Behavior of Deep Residual Networks From a Dynamical System Perspective" class="ltx_ref"><span class="ltx_text ltx_ref_tag">1</span></a></mtext><mtext>) with input </mtext></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>d</mi><mrow><mo stretchy="false">(</mo><mi>s</mi><mo stretchy="false">)</mo></mrow></msub></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\rm{\displaystyle subject\ to:}\ \mathrm{x}^{L}(\mathrm{d}_{(s)};{\Theta}^{\rm total}_{L})\text{ is the end state of Eq.(\ref{equation: discrete-time ResNet}) with input }\mathrm{d}_{(s)},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S2.SS3.p2.5" class="ltx_p">where <math id="S2.SS3.p2.m7" class="ltx_Math" alttext="\hat{\mathfrak{R}}_{\mathcal{S}}(\mathrm{x}^{L}(\cdot;{\Theta}^{\rm total}_{L}))" display="inline" intent=":literal"><semantics><mrow><msub><mover accent="true"><mi>ℜ</mi><mo>^</mo></mover><mi class="ltx_font_mathcaligraphic">𝒮</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mi>x</mi><mi>L</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo>,</mo><msubsup><mi mathvariant="normal">Θ</mi><mi>L</mi><mi>total</mi></msubsup><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\hat{\mathfrak{R}}_{\mathcal{S}}(\mathrm{x}^{L}(\cdot;{\Theta}^{\rm total}_{L}))</annotation></semantics></math> is the empirical risk of the hypothesis.</p>
</div>
<div id="S2.SS3.p3" class="ltx_para">
<p id="S2.SS3.p3.1" class="ltx_p">A fundamental question in generalization theory is to understand how minimizing the empirical risk <math id="S2.SS3.p3.m1" class="ltx_Math" alttext="\hat{\mathfrak{R}}_{\mathcal{S}}(\mathrm{x}^{L}(\cdot;{\Theta}^{\rm total}_{L}))" display="inline" intent=":literal"><semantics><mrow><msub><mover accent="true"><mi>ℜ</mi><mo>^</mo></mover><mi class="ltx_font_mathcaligraphic">𝒮</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mi>x</mi><mi>L</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo>,</mo><msubsup><mi mathvariant="normal">Θ</mi><mi>L</mi><mi>total</mi></msubsup><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\hat{\mathfrak{R}}_{\mathcal{S}}(\mathrm{x}^{L}(\cdot;{\Theta}^{\rm total}_{L}))</annotation></semantics></math> provides a meaningful approximation to minimizing the true risk
<math id="S2.SS3.p3.m2" class="ltx_Math" alttext="\mathfrak{R}_{{\mathfrak{D}}}(\mathrm{x}^{L}(\cdot;{\Theta}^{\rm total}_{L}))" display="inline" intent=":literal"><semantics><mrow><msub><mi>ℜ</mi><mi>𝔇</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mi>x</mi><mi>L</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo>,</mo><msubsup><mi mathvariant="normal">Θ</mi><mi>L</mi><mi>total</mi></msubsup><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathfrak{R}_{{\mathfrak{D}}}(\mathrm{x}^{L}(\cdot;{\Theta}^{\rm total}_{L}))</annotation></semantics></math>. This can be characterized by the so-called generalization gap</p>
<table id="S2.E11" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S2.E11.m1" class="ltx_Math" alttext="GE_{\mathcal{S}}(\mathrm{x}^{L}(\cdot;{\Theta}^{\rm total}_{L})):=\mathfrak{R}_{{\mathfrak{D}}}(\mathrm{x}^{L}(\cdot;{\Theta}^{\rm total}_{L}))-\hat{\mathfrak{R}}_{\mathcal{S}}(\mathrm{x}^{L}(\cdot;{\Theta}^{\rm total}_{L})),\ \mathrm{x}^{L}(\cdot;{\Theta}^{\rm total}_{L})\in{\mathcal{F}}^{L}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mrow><mi>G</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>E</mi><mi class="ltx_font_mathcaligraphic">𝒮</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mi>x</mi><mi>L</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo>,</mo><msubsup><mi mathvariant="normal">Θ</mi><mi>L</mi><mi>total</mi></msubsup><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>:=</mo><mrow><mrow><msub><mi>ℜ</mi><mi>𝔇</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mi>x</mi><mi>L</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo>,</mo><msubsup><mi mathvariant="normal">Θ</mi><mi>L</mi><mi>total</mi></msubsup><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msub><mover accent="true"><mi>ℜ</mi><mo>^</mo></mover><mi class="ltx_font_mathcaligraphic">𝒮</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mi>x</mi><mi>L</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo>,</mo><msubsup><mi mathvariant="normal">Θ</mi><mi>L</mi><mi>total</mi></msubsup><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo rspace="0.667em">,</mo><mrow><mrow><msup><mi>x</mi><mi>L</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo>,</mo><msubsup><mi mathvariant="normal">Θ</mi><mi>L</mi><mi>total</mi></msubsup><mo stretchy="false">)</mo></mrow></mrow><mo>∈</mo><msup><mi class="ltx_font_mathcaligraphic">ℱ</mi><mi>L</mi></msup></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">GE_{\mathcal{S}}(\mathrm{x}^{L}(\cdot;{\Theta}^{\rm total}_{L})):=\mathfrak{R}_{{\mathfrak{D}}}(\mathrm{x}^{L}(\cdot;{\Theta}^{\rm total}_{L}))-\hat{\mathfrak{R}}_{\mathcal{S}}(\mathrm{x}^{L}(\cdot;{\Theta}^{\rm total}_{L})),\ \mathrm{x}^{L}(\cdot;{\Theta}^{\rm total}_{L})\in{\mathcal{F}}^{L}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(11)</span></td></tr></tbody>
</table>
<p id="S2.SS3.p3.2" class="ltx_p">The generalization gap of continuous-time ResNet is similarly defined, i.e.,</p>
<table id="S2.E12" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S2.E12.m1" class="ltx_Math" alttext="GE_{\mathcal{S}}(\mathbb{x}(T;\cdot;\boldsymbol{\Theta}^{\rm total}))=\mathfrak{R}_{{\mathfrak{D}}}(\mathbb{x}(T;\cdot;\boldsymbol{\Theta}^{\rm total}))-\hat{\mathfrak{R}}_{\mathcal{S}}(\mathbb{x}(T;\cdot;\boldsymbol{\Theta}^{\rm total})),\ \mathbb{x}(T;\cdot;\boldsymbol{\Theta}^{\rm total})\in{\mathcal{F}}^{T}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mrow><mi>G</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>E</mi><mi class="ltx_font_mathcaligraphic">𝒮</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>𝕩</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>T</mi><mo rspace="0em">,</mo><mo lspace="0em" rspace="0em">⋅</mo><mo>,</mo><msup><mi>𝚯</mi><mi>total</mi></msup><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mrow><msub><mi>ℜ</mi><mi>𝔇</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>𝕩</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>T</mi><mo rspace="0em">,</mo><mo lspace="0em" rspace="0em">⋅</mo><mo>,</mo><msup><mi>𝚯</mi><mi>total</mi></msup><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msub><mover accent="true"><mi>ℜ</mi><mo>^</mo></mover><mi class="ltx_font_mathcaligraphic">𝒮</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>𝕩</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>T</mi><mo rspace="0em">,</mo><mo lspace="0em" rspace="0em">⋅</mo><mo>,</mo><msup><mi>𝚯</mi><mi>total</mi></msup><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo rspace="0.667em">,</mo><mrow><mrow><mi>𝕩</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>T</mi><mo rspace="0em">,</mo><mo lspace="0em" rspace="0em">⋅</mo><mo>,</mo><msup><mi>𝚯</mi><mi>total</mi></msup><mo stretchy="false">)</mo></mrow></mrow><mo>∈</mo><msup><mi class="ltx_font_mathcaligraphic">ℱ</mi><mi>T</mi></msup></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">GE_{\mathcal{S}}(\mathbb{x}(T;\cdot;\boldsymbol{\Theta}^{\rm total}))=\mathfrak{R}_{{\mathfrak{D}}}(\mathbb{x}(T;\cdot;\boldsymbol{\Theta}^{\rm total}))-\hat{\mathfrak{R}}_{\mathcal{S}}(\mathbb{x}(T;\cdot;\boldsymbol{\Theta}^{\rm total})),\ \mathbb{x}(T;\cdot;\boldsymbol{\Theta}^{\rm total})\in{\mathcal{F}}^{T}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(12)</span></td></tr></tbody>
</table>
</div>
<div id="S2.SS3.p4" class="ltx_para">
<p id="S2.SS3.p4.1" class="ltx_p">In this work, we aim to investigate the asymptotic generalization behavior of ResNets in the deep-layer limit by establishing compatible generalization error bounds simultaneously for discrete-time ResNets and their continuous-time counterparts.</p>
</div>
</section>
</section>
<section id="S3" class="ltx_section">
<h2 class="ltx_title ltx_title_section"><span class="ltx_tag ltx_tag_section">3 </span>Main results and application</h2>

<div id="S3.p1" class="ltx_para">
<p id="S3.p1.1" class="ltx_p">Motivated by the dynamical system modeling approach, which offers valuable insights into the approximation behavior, structural stability, and depth variation behavior of DNNs,
we establish generalization error bounds for discrete- and continuous-time ResNets. This captures their generalization behavior in the deep-layer limit.
We begin by introducing a class of commonly used activation functions and develop a new contraction-type inequality that reflects their structural properties. This inequality plays a key role in controlling the Rademacher complexity of the hypothesis class, leading to sharper generalization error bounds.</p>
</div>
<div id="Thmtheorem1" class="ltx_theorem ltx_theorem_definition">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="Thmtheorem1.2" class="ltx_text ltx_font_bold">Definition 1</span></span><span id="Thmtheorem1.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="Thmtheorem1.p1" class="ltx_para">
<p id="Thmtheorem1.p1.1" class="ltx_p"><span id="Thmtheorem1.p1.1.1" class="ltx_text ltx_font_italic">Let <math id="Thmtheorem1.p1.m1" class="ltx_Math" alttext="\Gamma(\mathbb{R})" display="inline" intent=":literal"><semantics><mrow><mi mathvariant="normal">Γ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>ℝ</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\Gamma(\mathbb{R})</annotation></semantics></math> be a set of functions such that for any <math id="Thmtheorem1.p1.m2" class="ltx_Math" alttext="{\phi}\in\Gamma(\mathbb{R})" display="inline" intent=":literal"><semantics><mrow><mi>ϕ</mi><mo>∈</mo><mrow><mi mathvariant="normal">Γ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>ℝ</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">{\phi}\in\Gamma(\mathbb{R})</annotation></semantics></math>, <math id="Thmtheorem1.p1.m3" class="ltx_Math" alttext="{\phi}:\mathbb{R}\to\mathbb{R}" display="inline" intent=":literal"><semantics><mrow><mi>ϕ</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi>ℝ</mi><mo stretchy="false">→</mo><mi>ℝ</mi></mrow></mrow><annotation encoding="application/x-tex">{\phi}:\mathbb{R}\to\mathbb{R}</annotation></semantics></math> is increasing, <math id="Thmtheorem1.p1.m4" class="ltx_Math" alttext="\mathrm{Lip}_{\phi}" display="inline" intent=":literal"><semantics><msub><mi>Lip</mi><mi>ϕ</mi></msub><annotation encoding="application/x-tex">\mathrm{Lip}_{\phi}</annotation></semantics></math>-Lipschitz, and <math id="Thmtheorem1.p1.m5" class="ltx_Math" alttext="{\phi}(x)=0" display="inline" intent=":literal"><semantics><mrow><mrow><mi>ϕ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">{\phi}(x)=0</annotation></semantics></math> for all <math id="Thmtheorem1.p1.m6" class="ltx_Math" alttext="x\leq 0" display="inline" intent=":literal"><semantics><mrow><mi>x</mi><mo>≤</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">x\leq 0</annotation></semantics></math>. Then the set of activation functions <math id="Thmtheorem1.p1.m7" class="ltx_Math" alttext="\mathscr{A}(\mathbb{R})" display="inline" intent=":literal"><semantics><mrow><mi class="ltx_font_mathscript">𝒜</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>ℝ</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathscr{A}(\mathbb{R})</annotation></semantics></math> is given as
<math id="Thmtheorem1.p1.m8" class="ltx_math_unparsed" alttext="\mathscr{A}(\mathbb{R})=\{\psi(\cdot)=\phi_{1}(\cdot-\alpha)-\phi_{2}(-\cdot-\beta)|\ \phi_{1},\phi_{2}\in\Gamma(\mathbb{R}),\ \alpha,\beta\geq 0\}." display="inline" intent=":literal"><semantics><mrow><mi class="ltx_font_mathscript">𝒜</mi><mrow><mo stretchy="false">(</mo><mi>ℝ</mi><mo stretchy="false">)</mo></mrow><mo>=</mo><mrow><mo stretchy="false">{</mo><mi>ψ</mi><mrow><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo stretchy="false">)</mo></mrow><mo>=</mo><msub><mi>ϕ</mi><mn>1</mn></msub><mrow><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo lspace="0em">−</mo><mi>α</mi><mo stretchy="false">)</mo></mrow><mo>−</mo><msub><mi>ϕ</mi><mn>2</mn></msub><mrow><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">−</mo><mo lspace="0em" rspace="0em">⋅</mo><mo lspace="0em">−</mo><mi>β</mi><mo stretchy="false">)</mo></mrow><mo fence="false" rspace="0.667em" stretchy="false">|</mo><msub><mi>ϕ</mi><mn>1</mn></msub><mo>,</mo><msub><mi>ϕ</mi><mn>2</mn></msub><mo>∈</mo><mi mathvariant="normal">Γ</mi><mrow><mo stretchy="false">(</mo><mi>ℝ</mi><mo stretchy="false">)</mo></mrow><mo rspace="0.667em">,</mo><mi>α</mi><mo>,</mo><mi>β</mi><mo>≥</mo><mn>0</mn><mo stretchy="false">}</mo></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\mathscr{A}(\mathbb{R})=\{\psi(\cdot)=\phi_{1}(\cdot-\alpha)-\phi_{2}(-\cdot-\beta)|\ \phi_{1},\phi_{2}\in\Gamma(\mathbb{R}),\ \alpha,\beta\geq 0\}.</annotation></semantics></math>

<span id="Thmtheorem1.p1.1.1.1" class="ltx_text ltx_align_floatright"></span></span></p>
</div>
</div>
<figure id="S3.T2" class="ltx_table">
<figcaption class="ltx_caption ltx_centering"><span class="ltx_tag ltx_tag_table">Table 2: </span>Examples of activation functions in <math id="S3.T2.m4" class="ltx_Math" alttext="\mathscr{A}(\mathbb{R})" display="inline" intent=":literal"><semantics><mrow><mi class="ltx_font_mathscript">𝒜</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>ℝ</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathscr{A}(\mathbb{R})</annotation></semantics></math>. The parameters <math id="S3.T2.m5" class="ltx_Math" alttext="a_{1}\in[0,1]" display="inline" intent=":literal"><semantics><mrow><msub><mi>a</mi><mn>1</mn></msub><mo>∈</mo><mrow><mo stretchy="false">[</mo><mrow><mn>0</mn><mo>,</mo><mn>1</mn></mrow><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">a_{1}\in[0,1]</annotation></semantics></math>, <math id="S3.T2.m6" class="ltx_Math" alttext="a_{2},\lambda,\lambda_{1},\lambda_{2}&gt;0" display="inline" intent=":literal"><semantics><mrow><msub><mi>a</mi><mn>2</mn></msub><mo>,</mo><mi>λ</mi><mo>,</mo><msub><mi>λ</mi><mn>1</mn></msub><mo>,</mo><mrow><msub><mi>λ</mi><mn>2</mn></msub><mo>&gt;</mo><mn>0</mn></mrow></mrow><annotation encoding="application/x-tex">a_{2},\lambda,\lambda_{1},\lambda_{2}&gt;0</annotation></semantics></math>.
</figcaption>
<table id="S3.T2.2" class="ltx_tabular ltx_centering ltx_align_middle">
<tbody class="ltx_tbody">
<tr id="S3.T2.2.1" class="ltx_tr">
<th id="S3.T2.2.1.1" class="ltx_td ltx_align_left ltx_th ltx_th_column ltx_th_row ltx_border_tt"><span id="S3.T2.2.1.1.1" class="ltx_text"></span><span id="S3.T2.2.1.1.2" class="ltx_text ltx_font_bold"> <span id="S3.T2.2.1.1.2.1" class="ltx_text">
<span id="S3.T2.2.1.1.2.1.1" class="ltx_tabular ltx_align_middle">
<span id="S3.T2.2.1.1.2.1.1.1" class="ltx_tr">
<span id="S3.T2.2.1.1.2.1.1.1.1" class="ltx_td ltx_nopad_r ltx_align_center"><span id="S3.T2.2.1.1.2.1.1.1.1.1" class="ltx_text" style="font-size:80%;">Activation</span></span></span>
<span id="S3.T2.2.1.1.2.1.1.2" class="ltx_tr">
<span id="S3.T2.2.1.1.2.1.1.2.1" class="ltx_td ltx_nopad_r ltx_align_center"><span id="S3.T2.2.1.1.2.1.1.2.1.1" class="ltx_text" style="font-size:80%;">functions</span></span></span>
</span></span><span id="S3.T2.2.1.1.2.2" class="ltx_text"></span></span></th>
<td id="S3.T2.2.1.2" class="ltx_td ltx_align_left ltx_border_tt"><math id="S3.T2.m7" class="ltx_Math" alttext="\qquad\psi" display="inline" intent=":literal"><semantics><mi>ψ</mi><annotation encoding="application/x-tex">\qquad\psi</annotation></semantics></math></td>
<td id="S3.T2.2.1.3" class="ltx_td ltx_align_left ltx_border_tt"><math id="S3.T2.m8" class="ltx_Math" alttext="\phi_{1}" display="inline" intent=":literal"><semantics><msub><mi>ϕ</mi><mn>1</mn></msub><annotation encoding="application/x-tex">\phi_{1}</annotation></semantics></math></td>
<td id="S3.T2.2.1.4" class="ltx_td ltx_align_left ltx_border_tt"><math id="S3.T2.m9" class="ltx_Math" alttext="\phi_{2}" display="inline" intent=":literal"><semantics><msub><mi>ϕ</mi><mn>2</mn></msub><annotation encoding="application/x-tex">\phi_{2}</annotation></semantics></math></td>
<td id="S3.T2.2.1.5" class="ltx_td ltx_align_left ltx_border_tt"><math id="S3.T2.m10" class="ltx_Math" alttext="(\alpha,\beta)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi>α</mi><mo>,</mo><mi>β</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(\alpha,\beta)</annotation></semantics></math></td></tr>
<tr id="S3.T2.2.2" class="ltx_tr">
<td id="S3.T2.2.2.1" class="ltx_td ltx_align_left ltx_border_t">ReLU <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib43" title="" class="ltx_ref">14</a>]</cite></td>
<td id="S3.T2.2.2.2" class="ltx_td ltx_align_left ltx_border_t"><math id="S3.T2.m11" class="ltx_Math" alttext="\left\{\begin{array}[]{ll}x,\ x\geq 0\\
0,\ x&lt;0\end{array}\right." display="inline" intent=":literal"><semantics><mrow><mo>{</mo><mtable columnspacing="5pt" rowspacing="0pt"><mtr><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><mi>x</mi><mo rspace="0.667em">,</mo><mi>x</mi></mrow><mo>≥</mo><mn>0</mn></mrow></mtd><mtd></mtd></mtr><mtr><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><mn>0</mn><mo rspace="0.667em">,</mo><mi>x</mi></mrow><mo>&lt;</mo><mn>0</mn></mrow></mtd><mtd></mtd></mtr></mtable><mphantom></mphantom></mrow><annotation encoding="application/x-tex">\left\{\begin{array}[]{ll}x,\ x\geq 0\\
0,\ x&lt;0\end{array}\right.</annotation></semantics></math></td>
