0,\ -\lambda_{2}&lt;x&lt;\lambda_{1}\\
x+\lambda_{2},\ x\leq-\lambda_{2}&amp;\end{array}\right.</annotation></semantics></math></td>
<td id="S3.T2.2.8.3" class="ltx_td ltx_align_left ltx_border_t"><math id="S3.T2.m37" class="ltx_Math" alttext="x\boldsymbol{1}_{[0,\infty)}(x)" display="inline" intent=":literal"><semantics><mrow><mi>x</mi><mo lspace="0em" rspace="0em">​</mo><msub><mn>𝟏</mn><mrow><mo stretchy="false">[</mo><mn>0</mn><mo>,</mo><mi mathvariant="normal">∞</mi><mo stretchy="false">)</mo></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">x\boldsymbol{1}_{[0,\infty)}(x)</annotation></semantics></math></td>
<td id="S3.T2.2.8.4" class="ltx_td ltx_align_left ltx_border_t"><math id="S3.T2.m38" class="ltx_Math" alttext="x\boldsymbol{1}_{[0,\infty)}(x)" display="inline" intent=":literal"><semantics><mrow><mi>x</mi><mo lspace="0em" rspace="0em">​</mo><msub><mn>𝟏</mn><mrow><mo stretchy="false">[</mo><mn>0</mn><mo>,</mo><mi mathvariant="normal">∞</mi><mo stretchy="false">)</mo></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">x\boldsymbol{1}_{[0,\infty)}(x)</annotation></semantics></math></td>
<td id="S3.T2.2.8.5" class="ltx_td ltx_align_left ltx_border_t">(<math id="S3.T2.m39" class="ltx_Math" alttext="\lambda_{1},\!\lambda_{2}" display="inline" intent=":literal"><semantics><mrow><msub><mi>λ</mi><mn>1</mn></msub><mpadded style="width:0.275em;" width="0.275em"><mo>,</mo></mpadded><msub><mi>λ</mi><mn>2</mn></msub></mrow><annotation encoding="application/x-tex">\lambda_{1},\!\lambda_{2}</annotation></semantics></math>)</td></tr>
<tr id="S3.T2.2.9" class="ltx_tr">
<td id="S3.T2.2.9.1" class="ltx_td ltx_align_left ltx_border_b ltx_border_t">Tanh <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib11" title="" class="ltx_ref">16</a>]</cite></td>
<td id="S3.T2.2.9.2" class="ltx_td ltx_align_left ltx_border_b ltx_border_t"><math id="S3.T2.m40" class="ltx_Math" alttext="\frac{e^{x}-e^{-x}}{e^{x}+e^{-x}}" display="inline" intent=":literal"><semantics><mfrac><mrow><msup><mi>e</mi><mi>x</mi></msup><mo>−</mo><msup><mi>e</mi><mrow><mo>−</mo><mi>x</mi></mrow></msup></mrow><mrow><msup><mi>e</mi><mi>x</mi></msup><mo>+</mo><msup><mi>e</mi><mrow><mo>−</mo><mi>x</mi></mrow></msup></mrow></mfrac><annotation encoding="application/x-tex">\frac{e^{x}-e^{-x}}{e^{x}+e^{-x}}</annotation></semantics></math></td>
<td id="S3.T2.2.9.3" class="ltx_td ltx_align_left ltx_border_b ltx_border_t"><math id="S3.T2.m41" class="ltx_Math" alttext="\frac{e^{x}-e^{-x}}{e^{x}+e^{-x}}\boldsymbol{1}_{[0,\infty)}(x)" display="inline" intent=":literal"><semantics><mrow><mfrac><mrow><msup><mi>e</mi><mi>x</mi></msup><mo>−</mo><msup><mi>e</mi><mrow><mo>−</mo><mi>x</mi></mrow></msup></mrow><mrow><msup><mi>e</mi><mi>x</mi></msup><mo>+</mo><msup><mi>e</mi><mrow><mo>−</mo><mi>x</mi></mrow></msup></mrow></mfrac><mo lspace="0em" rspace="0em">​</mo><msub><mn>𝟏</mn><mrow><mo stretchy="false">[</mo><mn>0</mn><mo>,</mo><mi mathvariant="normal">∞</mi><mo stretchy="false">)</mo></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\frac{e^{x}-e^{-x}}{e^{x}+e^{-x}}\boldsymbol{1}_{[0,\infty)}(x)</annotation></semantics></math></td>
<td id="S3.T2.2.9.4" class="ltx_td ltx_align_left ltx_border_b ltx_border_t"><math id="S3.T2.m42" class="ltx_Math" alttext="\frac{e^{x}-e^{-x}}{e^{x}+e^{-x}}\boldsymbol{1}_{[0,\infty)}(x)" display="inline" intent=":literal"><semantics><mrow><mfrac><mrow><msup><mi>e</mi><mi>x</mi></msup><mo>−</mo><msup><mi>e</mi><mrow><mo>−</mo><mi>x</mi></mrow></msup></mrow><mrow><msup><mi>e</mi><mi>x</mi></msup><mo>+</mo><msup><mi>e</mi><mrow><mo>−</mo><mi>x</mi></mrow></msup></mrow></mfrac><mo lspace="0em" rspace="0em">​</mo><msub><mn>𝟏</mn><mrow><mo stretchy="false">[</mo><mn>0</mn><mo>,</mo><mi mathvariant="normal">∞</mi><mo stretchy="false">)</mo></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\frac{e^{x}-e^{-x}}{e^{x}+e^{-x}}\boldsymbol{1}_{[0,\infty)}(x)</annotation></semantics></math></td>
<td id="S3.T2.2.9.5" class="ltx_td ltx_align_left ltx_border_b ltx_border_t">(0,0)</td></tr>
</tbody>
</table>
</figure>
<div id="S3.p2" class="ltx_para">
<p id="S3.p2.1" class="ltx_p">The set <math id="S3.p2.m1" class="ltx_Math" alttext="\mathscr{A}(\mathbb{R})" display="inline" intent=":literal"><semantics><mrow><mi class="ltx_font_mathscript">𝒜</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>ℝ</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathscr{A}(\mathbb{R})</annotation></semantics></math> includes many commonly used activation functions, as summarized in Table <a href="#S3.T2" title="Table 2 ‣ 3 Main results and application ‣ On the Generalization Behavior of Deep Residual Networks From a Dynamical System Perspective" class="ltx_ref"><span class="ltx_text ltx_ref_tag">2</span></a>.
Any function <math id="S3.p2.m2" class="ltx_Math" alttext="\psi\in\mathscr{A}(\mathbb{R})" display="inline" intent=":literal"><semantics><mrow><mi>ψ</mi><mo>∈</mo><mrow><mi class="ltx_font_mathscript">𝒜</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>ℝ</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\psi\in\mathscr{A}(\mathbb{R})</annotation></semantics></math> that can be written in the form <math id="S3.p2.m3" class="ltx_math_unparsed" alttext="\psi=\phi_{1}(\cdot-\alpha)-\phi_{2}(-\cdot-\beta)" display="inline" intent=":literal"><semantics><mrow><mi>ψ</mi><mo>=</mo><msub><mi>ϕ</mi><mn>1</mn></msub><mrow><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo lspace="0em">−</mo><mi>α</mi><mo stretchy="false">)</mo></mrow><mo>−</mo><msub><mi>ϕ</mi><mn>2</mn></msub><mrow><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">−</mo><mo lspace="0em" rspace="0em">⋅</mo><mo lspace="0em">−</mo><mi>β</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\psi=\phi_{1}(\cdot-\alpha)-\phi_{2}(-\cdot-\beta)</annotation></semantics></math> with <math id="S3.p2.m4" class="ltx_Math" alttext="\phi_{1},\phi_{2}\in\Gamma(\mathbb{R})" display="inline" intent=":literal"><semantics><mrow><msub><mi>ϕ</mi><mn>1</mn></msub><mo>,</mo><mrow><msub><mi>ϕ</mi><mn>2</mn></msub><mo>∈</mo><mrow><mi mathvariant="normal">Γ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>ℝ</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\phi_{1},\phi_{2}\in\Gamma(\mathbb{R})</annotation></semantics></math>, is <math id="S3.p2.m5" class="ltx_Math" alttext="\mathrm{Lip}_{\psi}" display="inline" intent=":literal"><semantics><msub><mi>Lip</mi><mi>ψ</mi></msub><annotation encoding="application/x-tex">\mathrm{Lip}_{\psi}</annotation></semantics></math>-Lipschitz continuous, where <math id="S3.p2.m6" class="ltx_Math" alttext="\mathrm{Lip}_{\psi}=\max\{\mathrm{Lip}_{\phi_{1}},\mathrm{Lip}_{\phi_{2}}\}" display="inline" intent=":literal"><semantics><mrow><msub><mi>Lip</mi><mi>ψ</mi></msub><mo>=</mo><mrow><mi>max</mi><mo>⁡</mo><mrow><mo stretchy="false">{</mo><msub><mi>Lip</mi><msub><mi>ϕ</mi><mn>1</mn></msub></msub><mo>,</mo><msub><mi>Lip</mi><msub><mi>ϕ</mi><mn>2</mn></msub></msub><mo stretchy="false">}</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\mathrm{Lip}_{\psi}=\max\{\mathrm{Lip}_{\phi_{1}},\mathrm{Lip}_{\phi_{2}}\}</annotation></semantics></math>. Recall the definition of empirical Rademacher complexity in Appendix <a href="#Thmtheorem16" title="Definition 16. ‣ Appendix A Definition of Rademacher complexity ‣ On the Generalization Behavior of Deep Residual Networks From a Dynamical System Perspective" class="ltx_ref"><span class="ltx_text ltx_ref_tag">16</span></a>, we derive a refined contraction inequality by using the decomposition structure of activation functions.</p>
</div>
<div id="Thmtheorem2" class="ltx_theorem ltx_theorem_proposition">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="Thmtheorem2.2" class="ltx_text ltx_font_bold">Proposition 2</span></span><span id="Thmtheorem2.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="Thmtheorem2.p1" class="ltx_para">
<p id="Thmtheorem2.p1.1" class="ltx_p"><span id="Thmtheorem2.p1.1.1" class="ltx_text ltx_font_italic">Let <math id="Thmtheorem2.p1.m1" class="ltx_Math" alttext="\mathcal{G}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">𝒢</mi><annotation encoding="application/x-tex">\mathcal{G}</annotation></semantics></math> be a set of functions mapping <math id="Thmtheorem2.p1.m2" class="ltx_Math" alttext="\mathbb{R}^{N}" display="inline" intent=":literal"><semantics><msup><mi>ℝ</mi><mi>N</mi></msup><annotation encoding="application/x-tex">\mathbb{R}^{N}</annotation></semantics></math> to <math id="Thmtheorem2.p1.m3" class="ltx_Math" alttext="\mathbb{R}" display="inline" intent=":literal"><semantics><mi>ℝ</mi><annotation encoding="application/x-tex">\mathbb{R}</annotation></semantics></math>. Consider a sample set <math id="Thmtheorem2.p1.m4" class="ltx_Math" alttext="\mathcal{Z}=\left\{\mathrm{z}_{(1)},\mathrm{z}_{(2)},\cdots,\mathrm{z}_{(S)}\right\}" display="inline" intent=":literal"><semantics><mrow><mi class="ltx_font_mathcaligraphic">𝒵</mi><mo>=</mo><mrow><mo>{</mo><mrow><msub><mi mathvariant="normal">z</mi><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msub><mo>,</mo><msub><mi mathvariant="normal">z</mi><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msub><mo>,</mo><mo lspace="0em" rspace="0em">⋯</mo><mo>,</mo><msub><mi mathvariant="normal">z</mi><mrow><mo stretchy="false">(</mo><mi>S</mi><mo stretchy="false">)</mo></mrow></msub></mrow><mo>}</mo></mrow></mrow><annotation encoding="application/x-tex">\mathcal{Z}=\left\{\mathrm{z}_{(1)},\mathrm{z}_{(2)},\cdots,\mathrm{z}_{(S)}\right\}</annotation></semantics></math> from some distribution <math id="Thmtheorem2.p1.m5" class="ltx_Math" alttext="\mathfrak{B}" display="inline" intent=":literal"><semantics><mi>𝔅</mi><annotation encoding="application/x-tex">\mathfrak{B}</annotation></semantics></math> and an activation function <math id="Thmtheorem2.p1.m6" class="ltx_Math" alttext="\psi\in\mathscr{A}(\mathbb{R})" display="inline" intent=":literal"><semantics><mrow><mi>ψ</mi><mo>∈</mo><mrow><mi class="ltx_font_mathscript">𝒜</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>ℝ</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\psi\in\mathscr{A}(\mathbb{R})</annotation></semantics></math> of the form <math id="Thmtheorem2.p1.m7" class="ltx_math_unparsed" alttext="\psi(\cdot):=\phi_{1}(\cdot-\alpha)-\phi_{2}(-\cdot-\beta)" display="inline" intent=":literal"><semantics><mrow><mi>ψ</mi><mrow><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo stretchy="false">)</mo></mrow><mo>:=</mo><msub><mi>ϕ</mi><mn>1</mn></msub><mrow><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo lspace="0em">−</mo><mi>α</mi><mo stretchy="false">)</mo></mrow><mo>−</mo><msub><mi>ϕ</mi><mn>2</mn></msub><mrow><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">−</mo><mo lspace="0em" rspace="0em">⋅</mo><mo lspace="0em">−</mo><mi>β</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\psi(\cdot):=\phi_{1}(\cdot-\alpha)-\phi_{2}(-\cdot-\beta)</annotation></semantics></math>, where <math id="Thmtheorem2.p1.m8" class="ltx_Math" alttext="\phi_{1},\phi_{2}\in\Gamma(\mathbb{R})" display="inline" intent=":literal"><semantics><mrow><msub><mi>ϕ</mi><mn>1</mn></msub><mo>,</mo><mrow><msub><mi>ϕ</mi><mn>2</mn></msub><mo>∈</mo><mrow><mi mathvariant="normal">Γ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>ℝ</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\phi_{1},\phi_{2}\in\Gamma(\mathbb{R})</annotation></semantics></math> and <math id="Thmtheorem2.p1.m9" class="ltx_Math" alttext="\alpha,\beta\geq 0" display="inline" intent=":literal"><semantics><mrow><mrow><mi>α</mi><mo>,</mo><mi>β</mi></mrow><mo>≥</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\alpha,\beta\geq 0</annotation></semantics></math>. Then there exists a constant <math id="Thmtheorem2.p1.m10" class="ltx_Math" alttext="C_{\mathcal{Z}}" display="inline" intent=":literal"><semantics><msub><mi>C</mi><mi class="ltx_font_mathcaligraphic">𝒵</mi></msub><annotation encoding="application/x-tex">C_{\mathcal{Z}}</annotation></semantics></math> dependent on <math id="Thmtheorem2.p1.m11" class="ltx_Math" alttext="\mathcal{Z}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">𝒵</mi><annotation encoding="application/x-tex">\mathcal{Z}</annotation></semantics></math>, <math id="Thmtheorem2.p1.m12" class="ltx_Math" alttext="0\leq C_{\mathcal{Z}}\leq\min\{S,\frac{\mathrm{Lip}_{\psi}S}{\mathrm{Lip}_{\phi_{1}}\alpha+\mathrm{Lip}_{\phi_{2}}\beta}\mathscr{R}_{\mathcal{Z}}(\mathcal{G})\}" display="inline" intent=":literal"><semantics><mrow><mn>0</mn><mo>≤</mo><msub><mi>C</mi><mi class="ltx_font_mathcaligraphic">𝒵</mi></msub><mo>≤</mo><mrow><mi>min</mi><mo>⁡</mo><mrow><mo stretchy="false">{</mo><mi>S</mi><mo>,</mo><mrow><mfrac><mrow><msub><mi>Lip</mi><mi>ψ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi>S</mi></mrow><mrow><mrow><msub><mi>Lip</mi><msub><mi>ϕ</mi><mn>1</mn></msub></msub><mo lspace="0em" rspace="0em">​</mo><mi>α</mi></mrow><mo>+</mo><mrow><msub><mi>Lip</mi><msub><mi>ϕ</mi><mn>2</mn></msub></msub><mo lspace="0em" rspace="0em">​</mo><mi>β</mi></mrow></mrow></mfrac><mo lspace="0em" rspace="0em">​</mo><msub><mi class="ltx_font_mathscript">ℛ</mi><mi class="ltx_font_mathcaligraphic">𝒵</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi class="ltx_font_mathcaligraphic">𝒢</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">}</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">0\leq C_{\mathcal{Z}}\leq\min\{S,\frac{\mathrm{Lip}_{\psi}S}{\mathrm{Lip}_{\phi_{1}}\alpha+\mathrm{Lip}_{\phi_{2}}\beta}\mathscr{R}_{\mathcal{Z}}(\mathcal{G})\}</annotation></semantics></math> and</span></p>
<table id="S3.E13" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S3.E13.m1" class="ltx_Math" alttext="\mathscr{R}_{\mathcal{Z}}(\psi\circ\mathcal{G})\leq\mathrm{Lip}_{\psi}\cdot\mathscr{R}_{\mathcal{Z}}(\mathcal{G})-\frac{\mathrm{Lip}_{\phi_{1}}\alpha+\mathrm{Lip}_{\phi_{2}}\beta}{S}C_{\mathcal{Z}}," display="block" intent=":literal"><semantics><mrow><mrow><mrow><msub><mi class="ltx_font_mathscript">ℛ</mi><mi class="ltx_font_mathcaligraphic">𝒵</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>ψ</mi><mo lspace="0.222em" rspace="0.222em">∘</mo><mi class="ltx_font_mathcaligraphic">𝒢</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>≤</mo><mrow><mrow><mrow><msub><mi>Lip</mi><mi>ψ</mi></msub><mo lspace="0.222em" rspace="0.222em">⋅</mo><msub><mi class="ltx_font_mathscript">ℛ</mi><mi class="ltx_font_mathcaligraphic">𝒵</mi></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi class="ltx_font_mathcaligraphic">𝒢</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mfrac><mrow><mrow><msub><mi>Lip</mi><msub><mi>ϕ</mi><mn>1</mn></msub></msub><mo lspace="0em" rspace="0em">​</mo><mi>α</mi></mrow><mo>+</mo><mrow><msub><mi>Lip</mi><msub><mi>ϕ</mi><mn>2</mn></msub></msub><mo lspace="0em" rspace="0em">​</mo><mi>β</mi></mrow></mrow><mi>S</mi></mfrac><mo lspace="0em" rspace="0em">​</mo><msub><mi>C</mi><mi class="ltx_font_mathcaligraphic">𝒵</mi></msub></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\mathscr{R}_{\mathcal{Z}}(\psi\circ\mathcal{G})\leq\mathrm{Lip}_{\psi}\cdot\mathscr{R}_{\mathcal{Z}}(\mathcal{G})-\frac{\mathrm{Lip}_{\phi_{1}}\alpha+\mathrm{Lip}_{\phi_{2}}\beta}{S}C_{\mathcal{Z}},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(13)</span></td></tr></tbody>
</table>
<p id="Thmtheorem2.p1.2" class="ltx_p"><span id="Thmtheorem2.p1.2.1" class="ltx_text ltx_font_italic">where <math id="Thmtheorem2.p1.m13" class="ltx_Math" alttext="\mathrm{Lip}_{\psi}=\max\{\mathrm{Lip}_{\phi_{1}},\mathrm{Lip}_{\phi_{2}}\}" display="inline" intent=":literal"><semantics><mrow><msub><mi>Lip</mi><mi>ψ</mi></msub><mo>=</mo><mrow><mi>max</mi><mo>⁡</mo><mrow><mo stretchy="false">{</mo><msub><mi>Lip</mi><msub><mi>ϕ</mi><mn>1</mn></msub></msub><mo>,</mo><msub><mi>Lip</mi><msub><mi>ϕ</mi><mn>2</mn></msub></msub><mo stretchy="false">}</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\mathrm{Lip}_{\psi}=\max\{\mathrm{Lip}_{\phi_{1}},\mathrm{Lip}_{\phi_{2}}\}</annotation></semantics></math>, <math id="Thmtheorem2.p1.m14" class="ltx_Math" alttext="\mathrm{Lip}_{\phi_{i}}" display="inline" intent=":literal"><semantics><msub><mi>Lip</mi><msub><mi>ϕ</mi><mi>i</mi></msub></msub><annotation encoding="application/x-tex">\mathrm{Lip}_{\phi_{i}}</annotation></semantics></math> are Lipschitz constants of function <math id="Thmtheorem2.p1.m15" class="ltx_Math" alttext="\phi_{i}" display="inline" intent=":literal"><semantics><msub><mi>ϕ</mi><mi>i</mi></msub><annotation encoding="application/x-tex">\phi_{i}</annotation></semantics></math>.
<span id="Thmtheorem2.p1.2.1.1" class="ltx_text ltx_align_floatright"></span></span></p>
</div>
</div>
<div id="S3.2" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="S3.p3" class="ltx_para">
<p id="S3.p3.1" class="ltx_p"><span id="S3.p3.1.1" class="ltx_text">The proof is given in Section <a href="#S4.SS1" title="4.1 Proof of Proposition ‣ 4 Proofs ‣ On the Generalization Behavior of Deep Residual Networks From a Dynamical System Perspective" class="ltx_ref"><span class="ltx_text ltx_ref_tag">4.1</span></a>.
<span id="S3.p3.1.1.1" class="ltx_text ltx_align_floatright"></span></span></p>
</div>
</div>
<div id="Thmtheorem3" class="ltx_theorem ltx_theorem_remark">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="Thmtheorem3.2" class="ltx_text ltx_font_bold">Remark 3</span></span><span id="Thmtheorem3.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="Thmtheorem3.p1" class="ltx_para">
<p id="Thmtheorem3.p1.1" class="ltx_p"><span id="Thmtheorem3.p1.1.1" class="ltx_text ltx_font_italic">Proposition <a href="#Thmtheorem2" title="Proposition 2. ‣ 3 Main results and application ‣ On the Generalization Behavior of Deep Residual Networks From a Dynamical System Perspective" class="ltx_ref"><span class="ltx_text ltx_ref_tag">2</span></a> provides a refined characterization of the Rademacher complexity of composed function classes compared to the classical contraction inequality in <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib7" title="" class="ltx_ref">42</a>, Lemma 26.9]</cite>, which states that</span></p>
<table id="S3.E14" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S3.E14.m1" class="ltx_Math" alttext="\mathscr{R}_{\mathcal{Z}}(\psi\circ\mathcal{G})\leq\mathrm{Lip}_{\psi}\cdot\mathscr{R}_{\mathcal{Z}}(\mathcal{G})." display="block" intent=":literal"><semantics><mrow><mrow><mrow><msub><mi class="ltx_font_mathscript">ℛ</mi><mi class="ltx_font_mathcaligraphic">𝒵</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>ψ</mi><mo lspace="0.222em" rspace="0.222em">∘</mo><mi class="ltx_font_mathcaligraphic">𝒢</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>≤</mo><mrow><mrow><msub><mi>Lip</mi><mi>ψ</mi></msub><mo lspace="0.222em" rspace="0.222em">⋅</mo><msub><mi class="ltx_font_mathscript">ℛ</mi><mi class="ltx_font_mathcaligraphic">𝒵</mi></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi class="ltx_font_mathcaligraphic">𝒢</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\mathscr{R}_{\mathcal{Z}}(\psi\circ\mathcal{G})\leq\mathrm{Lip}_{\psi}\cdot\mathscr{R}_{\mathcal{Z}}(\mathcal{G}).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(14)</span></td></tr></tbody>
</table>
<p id="Thmtheorem3.p1.2" class="ltx_p"><span id="Thmtheorem3.p1.2.1" class="ltx_text ltx_font_italic">Moreover, the result in <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib3" title="" class="ltx_ref">44</a>, Lemma 1]</cite> is a special case of the above proposition with <math id="Thmtheorem3.p1.m1" class="ltx_Math" alttext="\psi={\mathcal{T}}_{\lambda}" display="inline" intent=":literal"><semantics><mrow><mi>ψ</mi><mo>=</mo><msub><mi class="ltx_font_mathcaligraphic">𝒯</mi><mi>λ</mi></msub></mrow><annotation encoding="application/x-tex">\psi={\mathcal{T}}_{\lambda}</annotation></semantics></math>.
<span id="Thmtheorem3.p1.2.1.1" class="ltx_text ltx_align_floatright"></span></span></p>
</div>
</div>
<div id="S3.p4" class="ltx_para">
<p id="S3.p4.1" class="ltx_p">The following example shows that Proposition <a href="#Thmtheorem2" title="Proposition 2. ‣ 3 Main results and application ‣ On the Generalization Behavior of Deep Residual Networks From a Dynamical System Perspective" class="ltx_ref"><span class="ltx_text ltx_ref_tag">2</span></a> does give a tighter bound than (<a href="#S3.E14" title="Equation 14 ‣ Remark 3. ‣ 3 Main results and application ‣ On the Generalization Behavior of Deep Residual Networks From a Dynamical System Perspective" class="ltx_ref"><span class="ltx_text ltx_ref_tag">14</span></a>).</p>
</div>
<div id="S3.Thmexample1" class="ltx_theorem ltx_theorem_example">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S3.Thmexample1.2" class="ltx_text ltx_font_bold">Example 3.1</span></span><span id="S3.Thmexample1.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S3.Thmexample1.p1" class="ltx_para">
<p id="S3.Thmexample1.p1.1" class="ltx_p"><span id="S3.Thmexample1.p1.1.1" class="ltx_text ltx_font_italic">Given constants <math id="S3.Thmexample1.p1.m1" class="ltx_Math" alttext="\alpha,\beta,\gamma,\eta&gt;0" display="inline" intent=":literal"><semantics><mrow><mi>α</mi><mo>,</mo><mi>β</mi><mo>,</mo><mi>γ</mi><mo>,</mo><mrow><mi>η</mi><mo>&gt;</mo><mn>0</mn></mrow></mrow><annotation encoding="application/x-tex">\alpha,\beta,\gamma,\eta&gt;0</annotation></semantics></math> such that <math id="S3.Thmexample1.p1.m2" class="ltx_Math" alttext="0&lt;\max\{\alpha,\beta\}&lt;\gamma" display="inline" intent=":literal"><semantics><mrow><mn>0</mn><mo>&lt;</mo><mrow><mi>max</mi><mo>⁡</mo><mrow><mo stretchy="false">{</mo><mrow><mi>α</mi><mo>,</mo><mi>β</mi></mrow><mo stretchy="false">}</mo></mrow></mrow><mo>&lt;</mo><mi>γ</mi></mrow><annotation encoding="application/x-tex">0&lt;\max\{\alpha,\beta\}&lt;\gamma</annotation></semantics></math> and any sample set <math id="S3.Thmexample1.p1.m3" class="ltx_math_unparsed" alttext="\mathcal{Z}=\{\mathrm{z}_{(s)}|\ \mathrm{z}_{(s)}\in\mathbb{R}^{N},\|\mathrm{z}_{(s)}\|_{2}=1,s=1,\ldots,S\}" display="inline" intent=":literal"><semantics><mrow><mi class="ltx_font_mathcaligraphic">𝒵</mi><mo>=</mo><mrow><mo stretchy="false">{</mo><msub><mi mathvariant="normal">z</mi><mrow><mo stretchy="false">(</mo><mi>s</mi><mo stretchy="false">)</mo></mrow></msub><mo fence="false" rspace="0.667em" stretchy="false">|</mo><msub><mi mathvariant="normal">z</mi><mrow><mo stretchy="false">(</mo><mi>s</mi><mo stretchy="false">)</mo></mrow></msub><mo>∈</mo><msup><mi>ℝ</mi><mi>N</mi></msup><mo>,</mo><mo lspace="0em" rspace="0.167em">∥</mo><msub><mi mathvariant="normal">z</mi><mrow><mo stretchy="false">(</mo><mi>s</mi><mo stretchy="false">)</mo></mrow></msub><msub><mo lspace="0em" rspace="0.0835em">∥</mo><mn>2</mn></msub><mo lspace="0.0835em">=</mo><mn>1</mn><mo>,</mo><mi>s</mi><mo>=</mo><mn>1</mn><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mi>S</mi><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">\mathcal{Z}=\{\mathrm{z}_{(s)}|\ \mathrm{z}_{(s)}\in\mathbb{R}^{N},\|\mathrm{z}_{(s)}\|_{2}=1,s=1,\ldots,S\}</annotation></semantics></math>. Consider the function class</span></p>
<table id="S3.Ex2" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S3.Ex2.m1" class="ltx_math_unparsed" alttext="\mathcal{G}:=\{c_{1}\|\cdot\|_{2}+c_{2}:\mathbb{R}^{N}\to\mathbb{R}\ |(c_{1},c_{2})\in[0,\eta]\times[\alpha,\gamma]\text{ or }(c_{1},c_{2})\in[-\eta,0]\times[-\gamma,-\beta]\}," display="block" intent=":literal"><semantics><mrow><mi class="ltx_font_mathcaligraphic">𝒢</mi><mo>:=</mo><mrow><mo stretchy="false">{</mo><msub><mi>c</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">∥</mo><mo lspace="0em" rspace="0em">⋅</mo><msub><mo lspace="0em" rspace="0em">∥</mo><mn>2</mn></msub><mo lspace="0em">+</mo><msub><mi>c</mi><mn>2</mn></msub><mo lspace="0.278em" rspace="0.278em">:</mo><msup><mi>ℝ</mi><mi>N</mi></msup><mo stretchy="false">→</mo><mi>ℝ</mi><mo fence="false" lspace="0.500em" rspace="0.167em" stretchy="false">|</mo><mrow><mo stretchy="false">(</mo><msub><mi>c</mi><mn>1</mn></msub><mo>,</mo><msub><mi>c</mi><mn>2</mn></msub><mo stretchy="false">)</mo></mrow><mo>∈</mo><mrow><mo stretchy="false">[</mo><mn>0</mn><mo>,</mo><mi>η</mi><mo rspace="0.055em" stretchy="false">]</mo></mrow><mo rspace="0.222em">×</mo><mrow><mo stretchy="false">[</mo><mi>α</mi><mo>,</mo><mi>γ</mi><mo stretchy="false">]</mo></mrow><mtext class="ltx_mathvariant_italic"> or </mtext><mrow><mo stretchy="false">(</mo><msub><mi>c</mi><mn>1</mn></msub><mo>,</mo><msub><mi>c</mi><mn>2</mn></msub><mo stretchy="false">)</mo></mrow><mo>∈</mo><mrow><mo stretchy="false">[</mo><mo lspace="0em">−</mo><mi>η</mi><mo>,</mo><mn>0</mn><mo rspace="0.055em" stretchy="false">]</mo></mrow><mo rspace="0.222em">×</mo><mrow><mo stretchy="false">[</mo><mo lspace="0em">−</mo><mi>γ</mi><mo rspace="0em">,</mo><mo lspace="0em">−</mo><mi>β</mi><mo stretchy="false">]</mo></mrow><mo stretchy="false">}</mo></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\mathcal{G}:=\{c_{1}\|\cdot\|_{2}+c_{2}:\mathbb{R}^{N}\to\mathbb{R}\ |(c_{1},c_{2})\in[0,\eta]\times[\alpha,\gamma]\text{ or }(c_{1},c_{2})\in[-\eta,0]\times[-\gamma,-\beta]\},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S3.Thmexample1.p1.2" class="ltx_p"><span id="S3.Thmexample1.p1.2.1" class="ltx_text ltx_font_italic">and function
<math id="S3.Thmexample1.p1.m4" class="ltx_math_unparsed" alttext="\psi(\cdot)=(\cdot-\alpha)\boldsymbol{1}_{[0,\infty)}(\cdot-\alpha)-(-\cdot-\beta)\boldsymbol{1}_{[0,\infty)}(-\cdot-\beta)" display="inline" intent=":literal"><semantics><mrow><mi>ψ</mi><mrow><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo stretchy="false">)</mo></mrow><mo>=</mo><mrow><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo lspace="0em">−</mo><mi>α</mi><mo stretchy="false">)</mo></mrow><msub><mn>𝟏</mn><mrow><mo stretchy="false">[</mo><mn>0</mn><mo>,</mo><mi mathvariant="normal">∞</mi><mo stretchy="false">)</mo></mrow></msub><mrow><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo lspace="0em">−</mo><mi>α</mi><mo stretchy="false">)</mo></mrow><mo>−</mo><mrow><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">−</mo><mo lspace="0em" rspace="0em">⋅</mo><mo lspace="0em">−</mo><mi>β</mi><mo stretchy="false">)</mo></mrow><msub><mn>𝟏</mn><mrow><mo stretchy="false">[</mo><mn>0</mn><mo>,</mo><mi mathvariant="normal">∞</mi><mo stretchy="false">)</mo></mrow></msub><mrow><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">−</mo><mo lspace="0em" rspace="0em">⋅</mo><mo lspace="0em">−</mo><mi>β</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\psi(\cdot)=(\cdot-\alpha)\boldsymbol{1}_{[0,\infty)}(\cdot-\alpha)-(-\cdot-\beta)\boldsymbol{1}_{[0,\infty)}(-\cdot-\beta)</annotation></semantics></math>. Then</span></p>
<table id="S3.E15" class="ltx_equationgroup ltx_eqn_table">
<tbody>
<tr id="S3.E15X" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S3.E15X.m2" class="ltx_Math" alttext="\displaystyle\mathscr{R}_{\mathcal{Z}}(\mathcal{G})" display="inline" intent=":literal"><semantics><mrow><msub><mi class="ltx_font_mathscript">ℛ</mi><mi class="ltx_font_mathcaligraphic">𝒵</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi class="ltx_font_mathcaligraphic">𝒢</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\mathscr{R}_{\mathcal{Z}}(\mathcal{G})</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S3.E15X.m3" class="ltx_Math" alttext="\displaystyle=\frac{1}{2^{S-1}}(\eta+\gamma)\binom{S-1}{\lfloor\frac{S}{2}\rfloor}," display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>=</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><msup><mn>2</mn><mrow><mi>S</mi><mo>−</mo><mn>1</mn></mrow></msup></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>η</mi><mo>+</mo><mi>γ</mi></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mstyle displaystyle="true"><mfrac linethickness="0pt"><mrow><mi>S</mi><mo>−</mo><mn>1</mn></mrow><mrow><mo stretchy="false">⌊</mo><mfrac><mi>S</mi><mn>2</mn></mfrac><mo stretchy="false">⌋</mo></mrow></mfrac></mstyle><mo>)</mo></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle=\frac{1}{2^{S-1}}(\eta+\gamma)\binom{S-1}{\lfloor\frac{S}{2}\rfloor},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="2" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equationgroup ltx_align_right">(15)</span></td></tr>
<tr id="S3.E15Xa" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S3.E15Xa.m2" class="ltx_Math" alttext="\displaystyle\mathscr{R}_{\mathcal{Z}}(\psi\circ\mathcal{G})" display="inline" intent=":literal"><semantics><mrow><msub><mi class="ltx_font_mathscript">ℛ</mi><mi class="ltx_font_mathcaligraphic">𝒵</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>ψ</mi><mo lspace="0.222em" rspace="0.222em">∘</mo><mi class="ltx_font_mathcaligraphic">𝒢</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\mathscr{R}_{\mathcal{Z}}(\psi\circ\mathcal{G})</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S3.E15Xa.m3" class="ltx_Math" alttext="\displaystyle=\frac{1}{2^{S}}(2\eta+2\gamma-\beta-\alpha)\binom{S-1}{\lfloor\frac{S}{2}\rfloor}," display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>=</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><msup><mn>2</mn><mi>S</mi></msup></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>η</mi></mrow><mo>+</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>γ</mi></mrow></mrow><mo>−</mo><mi>β</mi><mo>−</mo><mi>α</mi></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mstyle displaystyle="true"><mfrac linethickness="0pt"><mrow><mi>S</mi><mo>−</mo><mn>1</mn></mrow><mrow><mo stretchy="false">⌊</mo><mfrac><mi>S</mi><mn>2</mn></mfrac><mo stretchy="false">⌋</mo></mrow></mfrac></mstyle><mo>)</mo></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle=\frac{1}{2^{S}}(2\eta+2\gamma-\beta-\alpha)\binom{S-1}{\lfloor\frac{S}{2}\rfloor},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S3.Thmexample1.p1.3" class="ltx_p"><span id="S3.Thmexample1.p1.3.1" class="ltx_text ltx_font_italic">and therefore <math id="S3.Thmexample1.p1.m5" class="ltx_Math" alttext="\mathscr{R}_{\mathcal{Z}}(\psi\circ\mathcal{G})\leq\mathrm{Lip}_{\psi}\mathscr{R}_{\mathcal{Z}}(\mathcal{G})-\frac{\alpha+\beta}{S}\cdot\frac{S}{2^{S}}\binom{S-1}{\lfloor\frac{S}{2}\rfloor}." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><msub><mi class="ltx_font_mathscript">ℛ</mi><mi class="ltx_font_mathcaligraphic">𝒵</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>ψ</mi><mo lspace="0.222em" rspace="0.222em">∘</mo><mi class="ltx_font_mathcaligraphic">𝒢</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>≤</mo><mrow><mrow><msub><mi>Lip</mi><mi>ψ</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi class="ltx_font_mathscript">ℛ</mi><mi class="ltx_font_mathcaligraphic">𝒵</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi class="ltx_font_mathcaligraphic">𝒢</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mrow><mfrac><mrow><mi>α</mi><mo>+</mo><mi>β</mi></mrow><mi>S</mi></mfrac><mo lspace="0.222em" rspace="0.222em">⋅</mo><mfrac><mi>S</mi><msup><mn>2</mn><mi>S</mi></msup></mfrac></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mfrac linethickness="0pt"><mrow><mi>S</mi><mo>−</mo><mn>1</mn></mrow><mrow><mo stretchy="false">⌊</mo><mfrac><mi>S</mi><mn>2</mn></mfrac><mo stretchy="false">⌋</mo></mrow></mfrac><mo>)</mo></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\mathscr{R}_{\mathcal{Z}}(\psi\circ\mathcal{G})\leq\mathrm{Lip}_{\psi}\mathscr{R}_{\mathcal{Z}}(\mathcal{G})-\frac{\alpha+\beta}{S}\cdot\frac{S}{2^{S}}\binom{S-1}{\lfloor\frac{S}{2}\rfloor}.</annotation></semantics></math>

<span id="S3.Thmexample1.p1.3.1.1" class="ltx_text ltx_align_floatright"></span></span></p>
</div>
</div>
<div id="S3.3" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="S3.p5" class="ltx_para">
<p id="S3.p5.1" class="ltx_p"><span id="S3.p5.1.1" class="ltx_text">The proof is basic and is supplied in supplementary materials.
<span id="S3.p5.1.1.1" class="ltx_text ltx_align_floatright"></span></span></p>
</div>
</div>
<div id="S3.p6" class="ltx_para">
<p id="S3.p6.1" class="ltx_p">Next, we use contraction inequality (<a href="#S3.E13" title="Equation 13 ‣ Proposition 2. ‣ 3 Main results and application ‣ On the Generalization Behavior of Deep Residual Networks From a Dynamical System Perspective" class="ltx_ref"><span class="ltx_text ltx_ref_tag">13</span></a>) to derive a generalization error bound for the discrete-time ResNet and discuss its implications for the continuous-time ResNet.
The following assumptions are required for the subsequent analysis.</p>
<ul id="S3.I1" class="ltx_itemize">
<li id="S3.I1.ix1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(<math id="S3.I1.ix1.m1" class="ltx_Math" alttext="{A}_{1}" display="inline" intent=":literal"><semantics><msub><mi>A</mi><mn>1</mn></msub><annotation encoding="application/x-tex">{A}_{1}</annotation></semantics></math>)</span> 
<div id="S3.I1.ix1.p1" class="ltx_para">
<p id="S3.I1.ix1.p1.1" class="ltx_p">(Bounded data distribution) The data distribution <math id="S3.I1.ix1.p1.m1" class="ltx_Math" alttext="\mathfrak{D}" display="inline" intent=":literal"><semantics><mi>𝔇</mi><annotation encoding="application/x-tex">\mathfrak{D}</annotation></semantics></math> is supported in a bounded set, i.e., for all <math id="S3.I1.ix1.p1.m2" class="ltx_Math" alttext="(\mathrm{d},\mathrm{g})\sim\mathfrak{D},\ \|\mathrm{d}\|_{2}+\|\mathrm{g}\|_{2}\leq B_{\rm in}" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mo stretchy="false">(</mo><mi>d</mi><mo>,</mo><mi>g</mi><mo stretchy="false">)</mo></mrow><mo>∼</mo><mi>𝔇</mi></mrow><mo rspace="0.667em">,</mo><mrow><mrow><msub><mrow><mo stretchy="false">‖</mo><mi>d</mi><mo stretchy="false">‖</mo></mrow><mn>2</mn></msub><mo>+</mo><msub><mrow><mo stretchy="false">‖</mo><mi>g</mi><mo stretchy="false">‖</mo></mrow><mn>2</mn></msub></mrow><mo>≤</mo><msub><mi>B</mi><mi>in</mi></msub></mrow></mrow><annotation encoding="application/x-tex">(\mathrm{d},\mathrm{g})\sim\mathfrak{D},\ \|\mathrm{d}\|_{2}+\|\mathrm{g}\|_{2}\leq B_{\rm in}</annotation></semantics></math> for some <math id="S3.I1.ix1.p1.m3" class="ltx_Math" alttext="B_{\rm in}&gt;0" display="inline" intent=":literal"><semantics><mrow><msub><mi>B</mi><mi>in</mi></msub><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">B_{\rm in}&gt;0</annotation></semantics></math>.</p>
</div></li>
<li id="S3.I1.ix2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(<math id="S3.I1.ix2.m1" class="ltx_Math" alttext="{A}_{2}" display="inline" intent=":literal"><semantics><msub><mi>A</mi><mn>2</mn></msub><annotation encoding="application/x-tex">{A}_{2}</annotation></semantics></math>)</span> 
<div id="S3.I1.ix2.p1" class="ltx_para">
<p id="S3.I1.ix2.p1.1" class="ltx_p">(Bounded parameter set) For some <math id="S3.I1.ix2.p1.m1" class="ltx_Math" alttext="B_{\boldsymbol{\Theta}}&gt;0" display="inline" intent=":literal"><semantics><mrow><msub><mi>B</mi><mi>𝚯</mi></msub><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">B_{\boldsymbol{\Theta}}&gt;0</annotation></semantics></math>, the parameter sets are given by</p>
<table id="S3.Ex3" class="ltx_equationgroup ltx_eqn_table">

<tbody id="S3.Ex3X"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S3.Ex3X.m2" class="ltx_Math" alttext="\displaystyle\Omega_{{\Theta}^{\rm total}_{L}}" display="inline" intent=":literal"><semantics><msub><mi mathvariant="normal">Ω</mi><msubsup><mi mathvariant="normal">Θ</mi><mi>L</mi><mi>total</mi></msubsup></msub><annotation encoding="application/x-tex">\displaystyle\Omega_{{\Theta}^{\rm total}_{L}}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S3.Ex3X.m3" class="ltx_Math" alttext="\displaystyle=\{{\Theta}^{\rm total}_{L}:{\Theta}^{\rm total}_{L}\in\mathcal{E}^{\rm pre}\times\mathcal{E}^{L},\|{\Theta}^{\rm total}_{L}\|_{\infty}\leq B_{\boldsymbol{\Theta}}\}," display="inline" intent=":literal"><semantics><mrow><mo>=</mo><mo stretchy="false">{</mo><mi mathvariant="normal">Θ</mi><msup><mrow></mrow><mi>total</mi></msup><msub><mrow></mrow><mi>L</mi></msub><mo lspace="0.278em" rspace="0.278em">:</mo><mi mathvariant="normal">Θ</mi><msup><mrow></mrow><mi>total</mi></msup><msub><mrow></mrow><mi>L</mi></msub><mo>∈</mo><mi class="ltx_font_mathcaligraphic">ℰ</mi><msup><mrow></mrow><mi>pre</mi></msup><mo lspace="0.222em" rspace="0.222em">×</mo><mi class="ltx_font_mathcaligraphic">ℰ</mi><msup><mrow></mrow><mi>L</mi></msup><mo>,</mo><mo lspace="0em" rspace="0.167em">∥</mo><mi mathvariant="normal">Θ</mi><msup><mrow></mrow><mi>total</mi></msup><msub><mrow></mrow><mi>L</mi></msub><mo lspace="0em" rspace="0.0835em">∥</mo><msub><mrow></mrow><mi mathvariant="normal">∞</mi></msub><mo lspace="0.0835em">≤</mo><mi>B</mi><msub><mrow></mrow><mi>𝚯</mi></msub><mo stretchy="false">}</mo><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle=\{{\Theta}^{\rm total}_{L}:{\Theta}^{\rm total}_{L}\in\mathcal{E}^{\rm pre}\times\mathcal{E}^{L},\|{\Theta}^{\rm total}_{L}\|_{\infty}\leq B_{\boldsymbol{\Theta}}\},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="S3.Ex3Xa"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S3.Ex3Xa.m2" class="ltx_Math" alttext="\displaystyle\Omega_{\boldsymbol{\Theta}^{\rm total}}" display="inline" intent=":literal"><semantics><msub><mi mathvariant="normal">Ω</mi><msup><mi>𝚯</mi><mi>total</mi></msup></msub><annotation encoding="application/x-tex">\displaystyle\Omega_{\boldsymbol{\Theta}^{\rm total}}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S3.Ex3Xa.m3" class="ltx_Math" alttext="\displaystyle=\{\boldsymbol{\Theta}^{\rm total}:\boldsymbol{\Theta}^{\rm total}\in\mathcal{E}^{\rm pre}\times(\mathcal{C}([0,T];\mathcal{E})\cap\mathcal{H}^{1}(0,T;\mathcal{E})),\|\boldsymbol{\Theta}^{\rm total}\|\!\leq\!B_{\boldsymbol{\Theta}}\}." display="inline" intent=":literal"><semantics><mrow><mo>=</mo><mo stretchy="false">{</mo><mi>𝚯</mi><msup><mrow></mrow><mi>total</mi></msup><mo lspace="0.278em" rspace="0.278em">:</mo><mi>𝚯</mi><msup><mrow></mrow><mi>total</mi></msup><mo>∈</mo><mi class="ltx_font_mathcaligraphic">ℰ</mi><msup><mrow></mrow><mi>pre</mi></msup><mo lspace="0.222em" rspace="0.222em">×</mo><mo stretchy="false">(</mo><mi class="ltx_font_mathcaligraphic">𝒞</mi><mo stretchy="false">(</mo><mo stretchy="false">[</mo><mn>0</mn><mo>,</mo><mi>T</mi><mo stretchy="false">]</mo><mo>;</mo><mi class="ltx_font_mathcaligraphic">ℰ</mi><mo stretchy="false">)</mo><mo>∩</mo><mi class="ltx_font_mathcaligraphic">ℋ</mi><msup><mrow></mrow><mn>1</mn></msup><mo stretchy="false">(</mo><mn>0</mn><mo>,</mo><mi>T</mi><mo>;</mo><mi class="ltx_font_mathcaligraphic">ℰ</mi><mo stretchy="false">)</mo><mo stretchy="false">)</mo><mo>,</mo><mo lspace="0em" rspace="0.167em">∥</mo><mi>𝚯</mi><msup><mrow></mrow><mi>total</mi></msup><mpadded style="width:0.497em;" width="0.497em"><mo lspace="0em">∥</mo></mpadded><mo rspace="0.108em">≤</mo><mi>B</mi><msub><mrow></mrow><mi>𝚯</mi></msub><mo stretchy="false">}</mo><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle=\{\boldsymbol{\Theta}^{\rm total}:\boldsymbol{\Theta}^{\rm total}\in\mathcal{E}^{\rm pre}\times(\mathcal{C}([0,T];\mathcal{E})\cap\mathcal{H}^{1}(0,T;\mathcal{E})),\|\boldsymbol{\Theta}^{\rm total}\|\!\leq\!B_{\boldsymbol{\Theta}}\}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div></li>
<li id="S3.I1.ix3" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(<math id="S3.I1.ix3.m1" class="ltx_Math" alttext="{A}_{3}" display="inline" intent=":literal"><semantics><msub><mi>A</mi><mn>3</mn></msub><annotation encoding="application/x-tex">{A}_{3}</annotation></semantics></math>)</span> 
<div id="S3.I1.ix3.p1" class="ltx_para">
<p id="S3.I1.ix3.p1.1" class="ltx_p">(Activation function) The activation function <math id="S3.I1.ix3.p1.m1" class="ltx_Math" alttext="\psi\in\mathscr{A}(\mathbb{R})" display="inline" intent=":literal"><semantics><mrow><mi>ψ</mi><mo>∈</mo><mrow><mi class="ltx_font_mathscript">𝒜</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>ℝ</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\psi\in\mathscr{A}(\mathbb{R})</annotation></semantics></math>.</p>
</div></li>
<li id="S3.I1.ix4" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(<math id="S3.I1.ix4.m1" class="ltx_Math" alttext="{A}_{4}" display="inline" intent=":literal"><semantics><msub><mi>A</mi><mn>4</mn></msub><annotation encoding="application/x-tex">{A}_{4}</annotation></semantics></math>)</span> 
<div id="S3.I1.ix4.p1" class="ltx_para">
<p id="S3.I1.ix4.p1.1" class="ltx_p">(Loss function) The loss function <math id="S3.I1.ix4.p1.m1" class="ltx_Math" alttext="{\ell}:\mathbb{R}^{n}\times\mathbb{R}^{n}\rightarrow[0,\infty)" display="inline" intent=":literal"><semantics><mrow><mi mathvariant="normal">ℓ</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mrow><msup><mi>ℝ</mi><mi>n</mi></msup><mo lspace="0.222em" rspace="0.222em">×</mo><msup><mi>ℝ</mi><mi>n</mi></msup></mrow><mo stretchy="false">→</mo><mrow><mo stretchy="false">[</mo><mn>0</mn><mo>,</mo><mi mathvariant="normal">∞</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">{\ell}:\mathbb{R}^{n}\times\mathbb{R}^{n}\rightarrow[0,\infty)</annotation></semantics></math> is continuous and satisfies a local Lipschitz condition for the first argument in the following sense. There exist a continuous function <math id="S3.I1.ix4.p1.m2" class="ltx_Math" alttext="{\kappa}:\mathbb{R}^{n}\times\mathbb{R}^{n}\times\mathbb{R}^{n}\rightarrow[0,\infty)" display="inline" intent=":literal"><semantics><mrow><mi>κ</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mrow><msup><mi>ℝ</mi><mi>n</mi></msup><mo lspace="0.222em" rspace="0.222em">×</mo><msup><mi>ℝ</mi><mi>n</mi></msup><mo lspace="0.222em" rspace="0.222em">×</mo><msup><mi>ℝ</mi><mi>n</mi></msup></mrow><mo stretchy="false">→</mo><mrow><mo stretchy="false">[</mo><mn>0</mn><mo>,</mo><mi mathvariant="normal">∞</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">{\kappa}:\mathbb{R}^{n}\times\mathbb{R}^{n}\times\mathbb{R}^{n}\rightarrow[0,\infty)</annotation></semantics></math> such that for all <math id="S3.I1.ix4.p1.m3" class="ltx_Math" alttext="\mathrm{x},\tilde{\mathrm{x}},\mathrm{g}\in\mathbb{R}^{n}" display="inline" intent=":literal"><semantics><mrow><mi>x</mi><mo>,</mo><mover accent="true"><mi>x</mi><mo>~</mo></mover><mo>,</mo><mrow><mi>g</mi><mo>∈</mo><msup><mi>ℝ</mi><mi>n</mi></msup></mrow></mrow><annotation encoding="application/x-tex">\mathrm{x},\tilde{\mathrm{x}},\mathrm{g}\in\mathbb{R}^{n}</annotation></semantics></math>,</p>
<table id="S3.Ex4" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S3.Ex4.m1" class="ltx_Math" alttext="|{\ell}(\mathrm{x},\mathrm{g})-{\ell}(\tilde{\mathrm{x}},\mathrm{g})|\leq{\kappa}(\mathrm{x},\tilde{\mathrm{x}},\mathrm{g})\|\mathrm{x}-\tilde{\mathrm{x}}\|_{2}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mo stretchy="false">|</mo><mrow><mrow><mi mathvariant="normal">ℓ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>g</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mi mathvariant="normal">ℓ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mover accent="true"><mi>x</mi><mo>~</mo></mover><mo>,</mo><mi>g</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">|</mo></mrow><mo>≤</mo><mrow><mrow><mi>κ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mover accent="true"><mi>x</mi><mo>~</mo></mover><mo>,</mo><mi>g</mi><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">‖</mo><mrow><mi>x</mi><mo>−</mo><mover accent="true"><mi>x</mi><mo>~</mo></mover></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn></msub></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">|{\ell}(\mathrm{x},\mathrm{g})-{\ell}(\tilde{\mathrm{x}},\mathrm{g})|\leq{\kappa}(\mathrm{x},\tilde{\mathrm{x}},\mathrm{g})\|\mathrm{x}-\tilde{\mathrm{x}}\|_{2}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div></li>
</ul>
</div>
<div id="Thmtheorem4" class="ltx_theorem ltx_theorem_remark">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="Thmtheorem4.2" class="ltx_text ltx_font_bold">Remark 4</span></span><span id="Thmtheorem4.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="Thmtheorem4.p1" class="ltx_para">
<p id="Thmtheorem4.p1.1" class="ltx_p"><span id="Thmtheorem4.p1.1.1" class="ltx_text ltx_font_italic">These assumptions are mild and commonly used in deep learning theory. In particular,
the boundedness assumptions (<math id="Thmtheorem4.p1.m1" class="ltx_Math" alttext="{A}_{1}" display="inline" intent=":literal"><semantics><msub><mi>A</mi><mn>1</mn></msub><annotation encoding="application/x-tex">{A}_{1}</annotation></semantics></math>) and (<math id="Thmtheorem4.p1.m2" class="ltx_Math" alttext="{A}_{2}" display="inline" intent=":literal"><semantics><msub><mi>A</mi><mn>2</mn></msub><annotation encoding="application/x-tex">{A}_{2}</annotation></semantics></math>) are standard <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib8" title="" class="ltx_ref">9</a>, <a href="#bib.bib9" title="" class="ltx_ref">26</a>, <a href="#bib.bib24" title="" class="ltx_ref">41</a>, <a href="#bib.bib2" title="" class="ltx_ref">24</a>]</cite>.
A broad class of loss functions satisfies (<math id="Thmtheorem4.p1.m3" class="ltx_Math" alttext="{A}_{4}" display="inline" intent=":literal"><semantics><msub><mi>A</mi><mn>4</mn></msub><annotation encoding="application/x-tex">{A}_{4}</annotation></semantics></math>). For example:</span></p>
<ul id="S3.I2" class="ltx_itemize">
<li id="S3.I2.i1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="S3.I2.i1.p1" class="ltx_para">
<p id="S3.I2.i1.p1.1" class="ltx_p"><span id="S3.I2.i1.p1.1.1" class="ltx_text ltx_font_italic">In image inverse problems, the loss function is usually </span><math id="S3.I2.i1.p1.m1" class="ltx_Math" alttext="{\ell}(\mathrm{x},\mathrm{g})=\|\mathrm{x}-\mathrm{g}\|_{2}^{2}" display="inline" intent=":literal"><semantics><mrow><mrow><mi mathvariant="normal">ℓ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>g</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><msubsup><mrow><mo stretchy="false">‖</mo><mrow><mi>x</mi><mo>−</mo><mi>g</mi></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn><mn>2</mn></msubsup></mrow><annotation encoding="application/x-tex">{\ell}(\mathrm{x},\mathrm{g})=\|\mathrm{x}-\mathrm{g}\|_{2}^{2}</annotation></semantics></math><span id="S3.I2.i1.p1.1.2" class="ltx_text ltx_font_italic">. Then we can take </span><math id="S3.I2.i1.p1.m2" class="ltx_Math" alttext="{\kappa}(\mathrm{x},\tilde{\mathrm{x}},\mathrm{g})=\|\mathrm{x}-\mathrm{g}\|_{2}+\|\tilde{\mathrm{x}}-\mathrm{g}\|_{2}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>κ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mover accent="true"><mi>x</mi><mo>~</mo></mover><mo>,</mo><mi>g</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><msub><mrow><mo stretchy="false">‖</mo><mrow><mi>x</mi><mo>−</mo><mi>g</mi></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn></msub><mo>+</mo><msub><mrow><mo stretchy="false">‖</mo><mrow><mover accent="true"><mi>x</mi><mo>~</mo></mover><mo>−</mo><mi>g</mi></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn></msub></mrow></mrow><annotation encoding="application/x-tex">{\kappa}(\mathrm{x},\tilde{\mathrm{x}},\mathrm{g})=\|\mathrm{x}-\mathrm{g}\|_{2}+\|\tilde{\mathrm{x}}-\mathrm{g}\|_{2}</annotation></semantics></math><span id="S3.I2.i1.p1.1.3" class="ltx_text ltx_font_italic">.</span></p>
</div></li>
<li id="S3.I2.i2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="S3.I2.i2.p1" class="ltx_para">
<p id="S3.I2.i2.p1.1" class="ltx_p"><span id="S3.I2.i2.p1.1.1" class="ltx_text ltx_font_italic">In image classification tasks, the loss function is usually the ramp loss </span><cite class="ltx_cite ltx_citemacro_cite"><span id="S3.I2.i2.p1.1.2" class="ltx_text ltx_font_italic">[</span><a href="#bib.bib7" title="" class="ltx_ref">42</a><span id="S3.I2.i2.p1.1.3" class="ltx_text ltx_font_italic">]</span></cite><span id="S3.I2.i2.p1.1.4" class="ltx_text ltx_font_italic">, which is </span><math id="S3.I2.i2.p1.m1" class="ltx_Math" alttext="\mathrm{Lip}_{\ell}" display="inline" intent=":literal"><semantics><msub><mi>Lip</mi><mi mathvariant="normal">ℓ</mi></msub><annotation encoding="application/x-tex">\mathrm{Lip}_{\ell}</annotation></semantics></math><span id="S3.I2.i2.p1.1.5" class="ltx_text ltx_font_italic">-Lipschitz. Then we can take </span><math id="S3.I2.i2.p1.m2" class="ltx_Math" alttext="{\kappa}(\mathrm{x},\tilde{\mathrm{x}},\mathrm{g})\equiv\mathrm{Lip}_{\ell}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>κ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mover accent="true"><mi>x</mi><mo>~</mo></mover><mo>,</mo><mi>g</mi><mo stretchy="false">)</mo></mrow></mrow><mo>≡</mo><msub><mi>Lip</mi><mi mathvariant="normal">ℓ</mi></msub></mrow><annotation encoding="application/x-tex">{\kappa}(\mathrm{x},\tilde{\mathrm{x}},\mathrm{g})\equiv\mathrm{Lip}_{\ell}</annotation></semantics></math><span id="S3.I2.i2.p1.1.6" class="ltx_text ltx_font_italic">.</span></p>
</div></li>
</ul>
<p id="Thmtheorem4.p1.2" class="ltx_p"><span id="Thmtheorem4.p1.2.1" class="ltx_text ltx_align_floatright"></span></p>
</div>
</div>
<div id="S3.p7" class="ltx_para">
<p id="S3.p7.1" class="ltx_p">We now present our two main results. One is the generalization error for discrete-time ResNets, and the other is that for continuous-time ResNets.</p>
</div>
<div id="Thmtheorem5" class="ltx_theorem ltx_theorem_theorem">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="Thmtheorem5.2" class="ltx_text ltx_font_bold">Theorem 5</span></span><span id="Thmtheorem5.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="Thmtheorem5.p1" class="ltx_para">
<p id="Thmtheorem5.p1.1" class="ltx_p"><span id="Thmtheorem5.p1.1.1" class="ltx_text ltx_font_italic">(Generalization error for discrete-time ResNets)
Assume assumptions (<math id="Thmtheorem5.p1.m1" class="ltx_Math" alttext="{A}_{1}" display="inline" intent=":literal"><semantics><msub><mi>A</mi><mn>1</mn></msub><annotation encoding="application/x-tex">{A}_{1}</annotation></semantics></math>)-(<math id="Thmtheorem5.p1.m2" class="ltx_Math" alttext="{A}_{4}" display="inline" intent=":literal"><semantics><msub><mi>A</mi><mn>4</mn></msub><annotation encoding="application/x-tex">{A}_{4}</annotation></semantics></math>) hold. Let the activation function <math id="Thmtheorem5.p1.m3" class="ltx_Math" alttext="\psi\in\mathscr{A}(\mathbb{R})" display="inline" intent=":literal"><semantics><mrow><mi>ψ</mi><mo>∈</mo><mrow><mi class="ltx_font_mathscript">𝒜</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>ℝ</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\psi\in\mathscr{A}(\mathbb{R})</annotation></semantics></math> with <math id="Thmtheorem5.p1.m4" class="ltx_Math" alttext="\phi_{1},\phi_{2}\in\Gamma(\mathbb{R})" display="inline" intent=":literal"><semantics><mrow><msub><mi>ϕ</mi><mn>1</mn></msub><mo>,</mo><mrow><msub><mi>ϕ</mi><mn>2</mn></msub><mo>∈</mo><mrow><mi mathvariant="normal">Γ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>ℝ</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\phi_{1},\phi_{2}\in\Gamma(\mathbb{R})</annotation></semantics></math> and <math id="Thmtheorem5.p1.m5" class="ltx_Math" alttext="\alpha,\beta&gt;0" display="inline" intent=":literal"><semantics><mrow><mrow><mi>α</mi><mo>,</mo><mi>β</mi></mrow><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\alpha,\beta&gt;0</annotation></semantics></math>.
 Then there are constants <math id="Thmtheorem5.p1.m6" class="ltx_Math" alttext="{C}_{\mathcal{S}}^{l}" display="inline" intent=":literal"><semantics><msubsup><mi>C</mi><mi class="ltx_font_mathcaligraphic">𝒮</mi><mi>l</mi></msubsup><annotation encoding="application/x-tex">{C}_{\mathcal{S}}^{l}</annotation></semantics></math> dependent on data <math id="Thmtheorem5.p1.m7" class="ltx_Math" alttext="\mathcal{S}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">𝒮</mi><annotation encoding="application/x-tex">\mathcal{S}</annotation></semantics></math>,
<math id="Thmtheorem5.p1.m8" class="ltx_Math" alttext="0\leq{C}_{\mathcal{S}}^{l}\leq\min\{\sqrt{S}\frac{1+2\mathrm{Lip}_{\psi}B_{\boldsymbol{\Theta}}}{2(\mathrm{Lip}_{\phi_{1}}\alpha+\mathrm{Lip}_{\phi_{2}}\beta)},S\}" display="inline" intent=":literal"><semantics><mrow><mn>0</mn><mo>≤</mo><msubsup><mi>C</mi><mi class="ltx_font_mathcaligraphic">𝒮</mi><mi>l</mi></msubsup><mo>≤</mo><mrow><mi>min</mi><mo>⁡</mo><mrow><mo stretchy="false">{</mo><mrow><msqrt><mi>S</mi></msqrt><mo lspace="0em" rspace="0em">​</mo><mfrac><mrow><mn>1</mn><mo>+</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi mathvariant="normal">L</mi><mo lspace="0em" rspace="0em">​</mo><mi mathvariant="normal">i</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi mathvariant="normal">p</mi><mi>ψ</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>B</mi><mi>𝚯</mi></msub></mrow></mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><msub><mi>Lip</mi><msub><mi>ϕ</mi><mn>1</mn></msub></msub><mo lspace="0em" rspace="0em">​</mo><mi>α</mi></mrow><mo>+</mo><mrow><msub><mi>Lip</mi><msub><mi>ϕ</mi><mn>2</mn></msub></msub><mo lspace="0em" rspace="0em">​</mo><mi>β</mi></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mfrac></mrow><mo>,</mo><mi>S</mi><mo stretchy="false">}</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">0\leq{C}_{\mathcal{S}}^{l}\leq\min\{\sqrt{S}\frac{1+2\mathrm{Lip}_{\psi}B_{\boldsymbol{\Theta}}}{2(\mathrm{Lip}_{\phi_{1}}\alpha+\mathrm{Lip}_{\phi_{2}}\beta)},S\}</annotation></semantics></math> <math id="Thmtheorem5.p1.m9" class="ltx_Math" alttext="(l=1,\ldots,L)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mrow><mi>l</mi><mo>=</mo><mn>1</mn></mrow><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mi>L</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(l=1,\ldots,L)</annotation></semantics></math> such that for any <math id="Thmtheorem5.p1.m10" class="ltx_Math" alttext="\delta\in(0,1)" display="inline" intent=":literal"><semantics><mrow><mi>δ</mi><mo>∈</mo><mrow><mo stretchy="false">(</mo><mn>0</mn><mo>,</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\delta\in(0,1)</annotation></semantics></math>, with probability at least <math id="Thmtheorem5.p1.m11" class="ltx_Math" alttext="1-\delta" display="inline" intent=":literal"><semantics><mrow><mn>1</mn><mo>−</mo><mi>δ</mi></mrow><annotation encoding="application/x-tex">1-\delta</annotation></semantics></math>, every
<math id="Thmtheorem5.p1.m12" class="ltx_Math" alttext="\mathrm{x}^{L}(\cdot;{\Theta}^{\rm total}_{L})\in{\mathcal{F}}^{L}" display="inline" intent=":literal"><semantics><mrow><mrow><msup><mi mathvariant="normal">x</mi><mi>L</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo>,</mo><msubsup><mi mathvariant="normal">Θ</mi><mi>L</mi><mi>total</mi></msubsup><mo stretchy="false">)</mo></mrow></mrow><mo>∈</mo><msup><mi class="ltx_font_mathcaligraphic">ℱ</mi><mi>L</mi></msup></mrow><annotation encoding="application/x-tex">\mathrm{x}^{L}(\cdot;{\Theta}^{\rm total}_{L})\in{\mathcal{F}}^{L}</annotation></semantics></math> satisfies</span></p>
</div>
<div id="Thmtheorem5.p2" class="ltx_para">
<table id="S3.E16" class="ltx_equationgroup ltx_eqn_table">
<tbody>
<tr id="S3.E16X" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S3.E16X.m2" class="ltx_Math" alttext="\displaystyle GE_{\mathcal{S}}(\mathrm{x}^{L}(\cdot;{\Theta}^{\rm total}_{L}))\leq" display="inline" intent=":literal"><semantics><mrow><mrow><mi>G</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>E</mi><mi class="ltx_font_mathcaligraphic">𝒮</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mi>x</mi><mi>L</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo>,</mo><msubsup><mi mathvariant="normal">Θ</mi><mi>L</mi><mi>total</mi></msubsup><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>≤</mo><mphantom></mphantom></mrow><annotation encoding="application/x-tex">\displaystyle GE_{\mathcal{S}}(\mathrm{x}^{L}(\cdot;{\Theta}^{\rm total}_{L}))\leq</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S3.E16X.m3" class="ltx_Math" alttext="\displaystyle 2\sqrt{2}nB_{\kappa}B_{\boldsymbol{\Theta}}\frac{M(T,\!\mathrm{Lip}_{\psi},\!n_{\mathrm{d}},\!B_{\rm in},\!B_{\boldsymbol{\Theta}})}{\sqrt{S}}\!+\!4B_{\ell}\sqrt{\frac{2\!\log(4/\delta)}{S}}" display="inline" intent=":literal"><semantics><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msqrt><mn>2</mn></msqrt><mo lspace="0em" rspace="0em">​</mo><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>B</mi><mi>κ</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>B</mi><mi>𝚯</mi></msub><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><mrow><mi>M</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>T</mi><mo>,</mo><msub><mi>Lip</mi><mi>ψ</mi></msub><mo>,</mo><msub><mi>n</mi><mi>d</mi></msub><mo>,</mo><msub><mi>B</mi><mi>in</mi></msub><mo>,</mo><msub><mi>B</mi><mi>𝚯</mi></msub><mo stretchy="false">)</mo></mrow></mrow><msqrt><mi>S</mi></msqrt></mfrac></mstyle></mrow><mo lspace="0.052em">+</mo><mrow><mn>4</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>B</mi><mi mathvariant="normal">ℓ</mi></msub><mo lspace="0em" rspace="0em">​</mo><msqrt><mstyle displaystyle="true"><mfrac><mrow><mi>log</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mn>4</mn><mo>/</mo><mi>δ</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mi>S</mi></mfrac></mstyle></msqrt></mrow></mrow><annotation encoding="application/x-tex">\displaystyle 2\sqrt{2}nB_{\kappa}B_{\boldsymbol{\Theta}}\frac{M(T,\!\mathrm{Lip}_{\psi},\!n_{\mathrm{d}},\!B_{\rm in},\!B_{\boldsymbol{\Theta}})}{\sqrt{S}}\!+\!4B_{\ell}\sqrt{\frac{2\!\log(4/\delta)}{S}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="2" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equationgroup ltx_align_right">(16)</span></td></tr>
<tr id="S3.E16Xa" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S3.E16Xa.m2" class="ltx_Math" alttext="\displaystyle+(-2\sqrt{2})nB_{\kappa}B_{\boldsymbol{\Theta}}\frac{(\mathrm{Lip}_{\phi_{1}}\alpha\!+\!\mathrm{Lip}_{\phi_{2}}\beta)\exp(T\mathrm{Lip}_{\psi}B_{\boldsymbol{\Theta}}^{2})}{S}\!\tau_{L}\!\sum_{l=1}^{L}{C}^{l}_{\mathcal{S}}," display="inline" intent=":literal"><semantics><mrow><mo>+</mo><mo stretchy="false">(</mo><mo lspace="0em">−</mo><mn>2</mn><msqrt><mn>2</mn></msqrt><mo stretchy="false">)</mo><mi>n</mi><mi>B</mi><msub><mrow></mrow><mi>κ</mi></msub><mi>B</mi><msub><mrow></mrow><mi>𝚯</mi></msub><mstyle displaystyle="true"><mfrac><mrow><mrow><mo stretchy="false">(</mo><mrow><mrow><msub><mi>Lip</mi><msub><mi>ϕ</mi><mn>1</mn></msub></msub><mo lspace="0em" rspace="0em">​</mo><mi>α</mi></mrow><mo lspace="0.052em" rspace="0.052em">+</mo><mrow><msub><mi>Lip</mi><msub><mi>ϕ</mi><mn>2</mn></msub></msub><mo lspace="0em" rspace="0em">​</mo><mi>β</mi></mrow></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>T</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>Lip</mi><mi>ψ</mi></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>B</mi><mi>𝚯</mi><mn>2</mn></msubsup></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mi>S</mi></mfrac></mstyle><mi>τ</mi><msub><mrow></mrow><mi>L</mi></msub><mstyle displaystyle="true"><mo movablelimits="false">∑</mo></mstyle><msub><mrow></mrow><mrow><mi>l</mi><mo>=</mo><mn>1</mn></mrow></msub><msup><mrow></mrow><mi>L</mi></msup><mi>C</mi><msup><mrow></mrow><mi>l</mi></msup><msub><mrow></mrow><mi class="ltx_font_mathcaligraphic">𝒮</mi></msub><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle+(-2\sqrt{2})nB_{\kappa}B_{\boldsymbol{\Theta}}\frac{(\mathrm{Lip}_{\phi_{1}}\alpha\!+\!\mathrm{Lip}_{\phi_{2}}\beta)\exp(T\mathrm{Lip}_{\psi}B_{\boldsymbol{\Theta}}^{2})}{S}\!\tau_{L}\!\sum_{l=1}^{L}{C}^{l}_{\mathcal{S}},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="Thmtheorem5.p2.2" class="ltx_p"><span id="Thmtheorem5.p2.2.1" class="ltx_text ltx_font_italic">where <math id="Thmtheorem5.p2.m1" class="ltx_Math" alttext="M(T,\mathrm{Lip}_{\psi},n_{\mathrm{d}},B_{\rm in},B_{\boldsymbol{\Theta}})=\Big(\mathrm{Lip}_{\psi}B_{\rm in}\sqrt{2\log(2n_{\mathrm{d}})}+1+T(1+2\mathrm{Lip}_{\psi}B_{\boldsymbol{\Theta}})\Big)\exp\big(2T\mathrm{Lip}_{\psi}B_{\boldsymbol{\Theta}}^{2}\big)" display="inline" intent=":literal"><semantics><mrow><mrow><mi>M</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>T</mi><mo>,</mo><msub><mi>Lip</mi><mi>ψ</mi></msub><mo>,</mo><msub><mi>n</mi><mi mathvariant="normal">d</mi></msub><mo>,</mo><msub><mi>B</mi><mi>in</mi></msub><mo>,</mo><msub><mi>B</mi><mi>𝚯</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mrow><mo maxsize="1.600em" minsize="1.600em">(</mo><mrow><mrow><msub><mi>Lip</mi><mi>ψ</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>B</mi><mi>in</mi></msub><mo lspace="0em" rspace="0em">​</mo><msqrt><mrow><mn>2</mn><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>log</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>n</mi><mi mathvariant="normal">d</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></msqrt></mrow><mo>+</mo><mn>1</mn><mo>+</mo><mrow><mi>T</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>Lip</mi><mi>ψ</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>B</mi><mi>𝚯</mi></msub></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo maxsize="1.600em" minsize="1.600em">)</mo></mrow><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>T</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>Lip</mi><mi>ψ</mi></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>B</mi><mi>𝚯</mi><mn>2</mn></msubsup></mrow><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">M(T,\mathrm{Lip}_{\psi},n_{\mathrm{d}},B_{\rm in},B_{\boldsymbol{\Theta}})=\Big(\mathrm{Lip}_{\psi}B_{\rm in}\sqrt{2\log(2n_{\mathrm{d}})}+1+T(1+2\mathrm{Lip}_{\psi}B_{\boldsymbol{\Theta}})\Big)\exp\big(2T\mathrm{Lip}_{\psi}B_{\boldsymbol{\Theta}}^{2}\big)</annotation></semantics></math>, <math id="Thmtheorem5.p2.m2" class="ltx_Math" alttext="B_{\kappa}" display="inline" intent=":literal"><semantics><msub><mi>B</mi><mi>κ</mi></msub><annotation encoding="application/x-tex">B_{\kappa}</annotation></semantics></math>, <math id="Thmtheorem5.p2.m3" class="ltx_Math" alttext="B_{\ell}" display="inline" intent=":literal"><semantics><msub><mi>B</mi><mi mathvariant="normal">ℓ</mi></msub><annotation encoding="application/x-tex">B_{\ell}</annotation></semantics></math> are constants dependent on <math id="Thmtheorem5.p2.m4" class="ltx_Math" alttext="T,B_{\rm in},B_{\boldsymbol{\Theta}},\mathrm{Lip}_{\psi}" display="inline" intent=":literal"><semantics><mrow><mi>T</mi><mo>,</mo><msub><mi>B</mi><mi>in</mi></msub><mo>,</mo><msub><mi>B</mi><mi>𝚯</mi></msub><mo>,</mo><msub><mi>Lip</mi><mi>ψ</mi></msub></mrow><annotation encoding="application/x-tex">T,B_{\rm in},B_{\boldsymbol{\Theta}},\mathrm{Lip}_{\psi}</annotation></semantics></math> and independent of <math id="Thmtheorem5.p2.m5" class="ltx_Math" alttext="L" display="inline" intent=":literal"><semantics><mi>L</mi><annotation encoding="application/x-tex">L</annotation></semantics></math>.
<span id="Thmtheorem5.p2.2.1.1" class="ltx_text ltx_align_floatright"></span></span></p>
</div>
</div>
<div id="S3.4" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="S3.p8" class="ltx_para">
<p id="S3.p8.1" class="ltx_p"><span id="S3.p8.1.1" class="ltx_text">The proof is given in Section <a href="#S4.SS2" title="4.2 Proof of Theorem ‣ 4 Proofs ‣ On the Generalization Behavior of Deep Residual Networks From a Dynamical System Perspective" class="ltx_ref"><span class="ltx_text ltx_ref_tag">4.2</span></a>.
<span id="S3.p8.1.1.1" class="ltx_text ltx_align_floatright"></span></span></p>
</div>
</div>
<div id="Thmtheorem6" class="ltx_theorem ltx_theorem_remark">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="Thmtheorem6.2" class="ltx_text ltx_font_bold">Remark 6</span></span><span id="Thmtheorem6.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="Thmtheorem6.p1" class="ltx_para">
<p id="Thmtheorem6.p1.1" class="ltx_p"><span id="Thmtheorem6.p1.1.1" class="ltx_text ltx_font_bold ltx_font_italic">The bound in (<a href="#S3.E16" title="Equation 16 ‣ Theorem 5. ‣ 3 Main results and application ‣ On the Generalization Behavior of Deep Residual Networks From a Dynamical System Perspective" class="ltx_ref"><span class="ltx_text ltx_ref_tag">16</span></a>) consists of a leading positive term that is independent of the network depth <math id="Thmtheorem6.p1.m1" class="ltx_Math" alttext="L" display="inline" intent=":literal"><semantics><mi mathvariant="normal">L</mi><annotation encoding="application/x-tex">L</annotation></semantics></math>, together with a non-positive depth-dependent structural term of the form</span></p>
<table id="S3.Ex5" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S3.Ex5.m1" class="ltx_math_unparsed" alttext="-2\sqrt{2}nB_{\kappa}B_{\boldsymbol{\Theta}}\frac{(\mathrm{Lip}_{\phi_{1}}\alpha\!+\!\mathrm{Lip}_{\phi_{2}}\beta)\exp(T\mathrm{Lip}_{\psi}B_{\boldsymbol{\Theta}}^{2})}{S}\!\tau_{L}\!\sum_{l=1}^{L}{C}^{l}_{\mathcal{S}}." display="block" intent=":literal"><semantics><mrow><mo>−</mo><mn>2</mn><msqrt><mn>2</mn></msqrt><mi>n</mi><mi>B</mi><msub><mrow></mrow><mi>κ</mi></msub><mi>B</mi><msub><mrow></mrow><mi>𝚯</mi></msub><mfrac><mrow><mrow><mo stretchy="false">(</mo><mrow><mrow><msub><mi>Lip</mi><msub><mi>ϕ</mi><mn>1</mn></msub></msub><mo lspace="0em" rspace="0em">​</mo><mi>α</mi></mrow><mo lspace="0.052em" rspace="0.052em">+</mo><mrow><msub><mi>Lip</mi><msub><mi>ϕ</mi><mn>2</mn></msub></msub><mo lspace="0em" rspace="0em">​</mo><mi>β</mi></mrow></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>T</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>Lip</mi><mi>ψ</mi></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>B</mi><mi>𝚯</mi><mn>2</mn></msubsup></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mi>S</mi></mfrac><mi>τ</mi><msub><mrow></mrow><mi>L</mi></msub><mo movablelimits="false">∑</mo><msub><mrow></mrow><mrow><mi>l</mi><mo>=</mo><mn>1</mn></mrow></msub><msup><mrow></mrow><mi>L</mi></msup><mi>C</mi><msup><mrow></mrow><mi>l</mi></msup><msub><mrow></mrow><mi class="ltx_font_mathcaligraphic">𝒮</mi></msub><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">-2\sqrt{2}nB_{\kappa}B_{\boldsymbol{\Theta}}\frac{(\mathrm{Lip}_{\phi_{1}}\alpha\!+\!\mathrm{Lip}_{\phi_{2}}\beta)\exp(T\mathrm{Lip}_{\psi}B_{\boldsymbol{\Theta}}^{2})}{S}\!\tau_{L}\!\sum_{l=1}^{L}{C}^{l}_{\mathcal{S}}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="Thmtheorem6.p1.2" class="ltx_p"><span id="Thmtheorem6.p1.2.1" class="ltx_text ltx_font_bold ltx_font_italic">Although this structural term appears with a negative sign in
(<a href="#S3.E16" title="Equation 16 ‣ Theorem 5. ‣ 3 Main results and application ‣ On the Generalization Behavior of Deep Residual Networks From a Dynamical System Perspective" class="ltx_ref"><span class="ltx_text ltx_ref_tag">16</span></a>), the resulting right-hand side remains non-negative.
This is guaranteed by the construction of the constants
<math id="Thmtheorem6.p1.m2" class="ltx_Math" alttext="{C}_{\mathcal{S}}^{l}" display="inline" intent=":literal"><semantics><msubsup><mi mathvariant="normal">C</mi><mi class="ltx_font_mathcaligraphic">𝒮</mi><mi mathvariant="normal">l</mi></msubsup><annotation encoding="application/x-tex">{C}_{\mathcal{S}}^{l}</annotation></semantics></math>, <math id="Thmtheorem6.p1.m3" class="ltx_Math" alttext="1\leq l\leq L" display="inline" intent=":literal"><semantics><mrow><mn>1</mn><mo>≤</mo><mi mathvariant="normal">l</mi><mo>≤</mo><mi mathvariant="normal">L</mi></mrow><annotation encoding="application/x-tex">1\leq l\leq L</annotation></semantics></math>, as shown in the proof of
Theorem <a href="#Thmtheorem5" title="Theorem 5. ‣ 3 Main results and application ‣ On the Generalization Behavior of Deep Residual Networks From a Dynamical System Perspective" class="ltx_ref"><span class="ltx_text ltx_ref_tag">5</span></a>. If we further discard the minus term, one immediately obtains a depth-uniform upper bound.<span id="Thmtheorem6.p1.2.1.1" class="ltx_text ltx_font_medium">
<span id="Thmtheorem6.p1.2.1.1.1" class="ltx_text ltx_align_floatright"></span></span></span></p>
</div>
</div>
<div id="Thmtheorem7" class="ltx_theorem ltx_theorem_remark">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="Thmtheorem7.2" class="ltx_text ltx_font_bold">Remark 7</span></span><span id="Thmtheorem7.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="Thmtheorem7.p1" class="ltx_para">
<p id="Thmtheorem7.p1.1" class="ltx_p"><span id="Thmtheorem7.p1.1.1" class="ltx_text ltx_font_italic">The non-positive structural term in the generalization bound reflects a structural effect induced by the activation function. This term depends on several activation-related constants, including <math id="Thmtheorem7.p1.m1" class="ltx_Math" alttext="\mathrm{Lip}_{\phi_{1}}" display="inline" intent=":literal"><semantics><msub><mi>Lip</mi><msub><mi>ϕ</mi><mn>1</mn></msub></msub><annotation encoding="application/x-tex">\mathrm{Lip}_{\phi_{1}}</annotation></semantics></math>, <math id="Thmtheorem7.p1.m2" class="ltx_Math" alttext="\mathrm{Lip}_{\phi_{2}}" display="inline" intent=":literal"><semantics><msub><mi>Lip</mi><msub><mi>ϕ</mi><mn>2</mn></msub></msub><annotation encoding="application/x-tex">\mathrm{Lip}_{\phi_{2}}</annotation></semantics></math>, <math id="Thmtheorem7.p1.m3" class="ltx_Math" alttext="\alpha" display="inline" intent=":literal"><semantics><mi>α</mi><annotation encoding="application/x-tex">\alpha</annotation></semantics></math>, and <math id="Thmtheorem7.p1.m4" class="ltx_Math" alttext="\beta" display="inline" intent=":literal"><semantics><mi>β</mi><annotation encoding="application/x-tex">\beta</annotation></semantics></math>.
Note that the associated data-dependent quantities <math id="Thmtheorem7.p1.m5" class="ltx_Math" alttext="C_{\mathcal{S}}^{l}" display="inline" intent=":literal"><semantics><msubsup><mi>C</mi><mi class="ltx_font_mathcaligraphic">𝒮</mi><mi>l</mi></msubsup><annotation encoding="application/x-tex">C_{\mathcal{S}}^{l}</annotation></semantics></math> are introduced in an existential manner. Therefore, it is difficult to characterize explicitly for realistic network architectures and data distributions. Even for simplified settings, their precise values can be nontrivial to compute (see Example <a href="#S3.Thmexample1" title="Example 3.1. ‣ 3 Main results and application ‣ On the Generalization Behavior of Deep Residual Networks From a Dynamical System Perspective" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3.1</span></a>). <span id="Thmtheorem7.p1.1.1.1" class="ltx_text ltx_font_bold">As a result, it is generally difficult to quantitatively compare the tightness of different generalization bounds for the same model, or to derive explicit design rules for activation parameters.</span>
Nevertheless, this negative structural term theoretically reveals the potential role of activation function structure in improving generalization. From a practical perspective, this suggests that learning activation parameters (such as <math id="Thmtheorem7.p1.m6" class="ltx_Math" alttext="\alpha" display="inline" intent=":literal"><semantics><mi>α</mi><annotation encoding="application/x-tex">\alpha</annotation></semantics></math> and
<math id="Thmtheorem7.p1.m7" class="ltx_Math" alttext="\beta" display="inline" intent=":literal"><semantics><mi>β</mi><annotation encoding="application/x-tex">\beta</annotation></semantics></math>) may enable the network to discover activation configurations that yield improved generalization performance. We will further explore this phenomenon empirically in the experimental section.

<span id="Thmtheorem7.p1.1.1.2" class="ltx_text ltx_align_floatright"></span></span></p>
</div>
</div>
<div id="Thmtheorem8" class="ltx_theorem ltx_theorem_remark">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="Thmtheorem8.2" class="ltx_text ltx_font_bold">Remark 8</span></span><span id="Thmtheorem8.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="Thmtheorem8.p1" class="ltx_para">
<p id="Thmtheorem8.p1.1" class="ltx_p"><span id="Thmtheorem8.p1.1.1" class="ltx_text ltx_font_italic">The bound in (<a href="#S3.E16" title="Equation 16 ‣ Theorem 5. ‣ 3 Main results and application ‣ On the Generalization Behavior of Deep Residual Networks From a Dynamical System Perspective" class="ltx_ref"><span class="ltx_text ltx_ref_tag">16</span></a>) is independent of the network width and hidden dimensions, which is consistent with practical applications and aligns with <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib45" title="" class="ltx_ref">11</a>]</cite>.
Unlike <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib45" title="" class="ltx_ref">11</a>]</cite>, where the bound exhibits an explicit dependence on the network depth, our result can be further controlled by an explicit depth-independent upper bound (see Remark 3.6). Moreover, it remains unclear whether the path-norm framework in <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib45" title="" class="ltx_ref">11</a>]</cite> extends to the continuous-time ResNet arising in the deep-layer limit. In contrast, our analysis admits a natural asymptotic interpretation with respect to depth, suggesting that discretizations of ODE-based architectures yield consistent discrete networks and lead to generalization bounds for continuous-time ResNets, as developed below.
The bound also attains the optimal <math id="Thmtheorem8.p1.m1" class="ltx_Math" alttext="O(1/\sqrt{S})" display="inline" intent=":literal"><semantics><mrow><mi>O</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>/</mo><msqrt><mi>S</mi></msqrt></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">O(1/\sqrt{S})</annotation></semantics></math> rate established in prior works on discrete-time ResNets <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib34" title="" class="ltx_ref">31</a>, <a href="#bib.bib33" title="" class="ltx_ref">21</a>, <a href="#bib.bib45" title="" class="ltx_ref">11</a>]</cite>, which is sharper than the <math id="Thmtheorem8.p1.m2" class="ltx_Math" alttext="O(1/\sqrt[4]{S})" display="inline" intent=":literal"><semantics><mrow><mi>O</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>/</mo><mroot><mi>S</mi><mn>4</mn></mroot></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">O(1/\sqrt[4]{S})</annotation></semantics></math> bound obtained in <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib40" title="" class="ltx_ref">34</a>]</cite> in the discrete-time setting.
The exponential factor depends only on the terminal time <math id="Thmtheorem8.p1.m3" class="ltx_Math" alttext="T" display="inline" intent=":literal"><semantics><mi>T</mi><annotation encoding="application/x-tex">T</annotation></semantics></math>, the Lipschitz constant of the activation function, and the parameter norm bound. Such exponential-in-time dependence is standard in dynamical system and neural ODE analyses, typically arising from
Grönwall-type estimates
<cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib40" title="" class="ltx_ref">34</a>, <a href="#bib.bib46" title="" class="ltx_ref">6</a>, <a href="#bib.bib47" title="" class="ltx_ref">20</a>]</cite>.
These findings highlight a novel interplay between continuous-time neural networks, architectural stability, and generalization behavior, setting the stage for the deep-layer limit results developed in the next theorem.
<span id="Thmtheorem8.p1.1.1.1" class="ltx_text ltx_align_floatright"></span></span></p>
</div>
</div>
<div id="Thmtheorem9" class="ltx_theorem ltx_theorem_theorem">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="Thmtheorem9.2" class="ltx_text ltx_font_bold">Theorem 9</span></span><span id="Thmtheorem9.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="Thmtheorem9.p1" class="ltx_para">
<p id="Thmtheorem9.p1.2" class="ltx_p"><span id="Thmtheorem9.p1.2.1" class="ltx_text ltx_font_italic">(Generalization error for continuous-time ResNets)
Assume assumptions (<math id="Thmtheorem9.p1.m1" class="ltx_Math" alttext="{A}_{1}" display="inline" intent=":literal"><semantics><msub><mi>A</mi><mn>1</mn></msub><annotation encoding="application/x-tex">{A}_{1}</annotation></semantics></math>)-(<math id="Thmtheorem9.p1.m2" class="ltx_Math" alttext="{A}_{4}" display="inline" intent=":literal"><semantics><msub><mi>A</mi><mn>4</mn></msub><annotation encoding="application/x-tex">{A}_{4}</annotation></semantics></math>) hold. Let the activation function <math id="Thmtheorem9.p1.m3" class="ltx_Math" alttext="\psi\in\mathscr{A}(\mathbb{R})" display="inline" intent=":literal"><semantics><mrow><mi>ψ</mi><mo>∈</mo><mrow><mi class="ltx_font_mathscript">𝒜</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>ℝ</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\psi\in\mathscr{A}(\mathbb{R})</annotation></semantics></math> with <math id="Thmtheorem9.p1.m4" class="ltx_Math" alttext="\phi_{1},\phi_{2}\in\Gamma(\mathbb{R})" display="inline" intent=":literal"><semantics><mrow><msub><mi>ϕ</mi><mn>1</mn></msub><mo>,</mo><mrow><msub><mi>ϕ</mi><mn>2</mn></msub><mo>∈</mo><mrow><mi mathvariant="normal">Γ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>ℝ</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\phi_{1},\phi_{2}\in\Gamma(\mathbb{R})</annotation></semantics></math> and <math id="Thmtheorem9.p1.m5" class="ltx_Math" alttext="\alpha,\beta&gt;0" display="inline" intent=":literal"><semantics><mrow><mrow><mi>α</mi><mo>,</mo><mi>β</mi></mrow><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\alpha,\beta&gt;0</annotation></semantics></math>. Then there is a constant <math id="Thmtheorem9.p1.m6" class="ltx_Math" alttext="C_{\mathcal{S}}" display="inline" intent=":literal"><semantics><msub><mi>C</mi><mi class="ltx_font_mathcaligraphic">𝒮</mi></msub><annotation encoding="application/x-tex">C_{\mathcal{S}}</annotation></semantics></math> dependent on <math id="Thmtheorem9.p1.m7" class="ltx_Math" alttext="{\mathcal{S}}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">𝒮</mi><annotation encoding="application/x-tex">{\mathcal{S}}</annotation></semantics></math>, <math id="Thmtheorem9.p1.m8" class="ltx_Math" alttext="0\leq{C}_{\mathcal{S}}\leq\min\{\sqrt{S}\frac{1+2\mathrm{Lip}_{\psi}B_{\boldsymbol{\Theta}}}{2(\mathrm{Lip}_{\phi_{1}}\alpha+\mathrm{Lip}_{\phi_{2}}\beta)},S\}" display="inline" intent=":literal"><semantics><mrow><mn>0</mn><mo>≤</mo><msub><mi>C</mi><mi class="ltx_font_mathcaligraphic">𝒮</mi></msub><mo>≤</mo><mrow><mi>min</mi><mo>⁡</mo><mrow><mo stretchy="false">{</mo><mrow><msqrt><mi>S</mi></msqrt><mo lspace="0em" rspace="0em">​</mo><mfrac><mrow><mn>1</mn><mo>+</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi mathvariant="normal">L</mi><mo lspace="0em" rspace="0em">​</mo><mi mathvariant="normal">i</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi mathvariant="normal">p</mi><mi>ψ</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>B</mi><mi>𝚯</mi></msub></mrow></mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><msub><mi>Lip</mi><msub><mi>ϕ</mi><mn>1</mn></msub></msub><mo lspace="0em" rspace="0em">​</mo><mi>α</mi></mrow><mo>+</mo><mrow><msub><mi>Lip</mi><msub><mi>ϕ</mi><mn>2</mn></msub></msub><mo lspace="0em" rspace="0em">​</mo><mi>β</mi></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mfrac></mrow><mo>,</mo><mi>S</mi><mo stretchy="false">}</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">0\leq{C}_{\mathcal{S}}\leq\min\{\sqrt{S}\frac{1+2\mathrm{Lip}_{\psi}B_{\boldsymbol{\Theta}}}{2(\mathrm{Lip}_{\phi_{1}}\alpha+\mathrm{Lip}_{\phi_{2}}\beta)},S\}</annotation></semantics></math> such that for any <math id="Thmtheorem9.p1.m9" class="ltx_Math" alttext="\delta\in(0,1)" display="inline" intent=":literal"><semantics><mrow><mi>δ</mi><mo>∈</mo><mrow><mo stretchy="false">(</mo><mn>0</mn><mo>,</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\delta\in(0,1)</annotation></semantics></math>, with probability at least <math id="Thmtheorem9.p1.m10" class="ltx_Math" alttext="1-\delta" display="inline" intent=":literal"><semantics><mrow><mn>1</mn><mo>−</mo><mi>δ</mi></mrow><annotation encoding="application/x-tex">1-\delta</annotation></semantics></math>, every
<math id="Thmtheorem9.p1.m11" class="ltx_Math" alttext="\mathbb{x}(T;\cdot;\boldsymbol{\Theta}^{\rm total})\in{\mathcal{F}}^{T}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>𝕩</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>T</mi><mo rspace="0em">,</mo><mo lspace="0em" rspace="0em">⋅</mo><mo>,</mo><msup><mi>𝚯</mi><mi>total</mi></msup><mo stretchy="false">)</mo></mrow></mrow><mo>∈</mo><msup><mi class="ltx_font_mathcaligraphic">ℱ</mi><mi>T</mi></msup></mrow><annotation encoding="application/x-tex">\mathbb{x}(T;\cdot;\boldsymbol{\Theta}^{\rm total})\in{\mathcal{F}}^{T}</annotation></semantics></math> satisfies</span></p>
<table id="S3.E17" class="ltx_equationgroup ltx_eqn_table">
<tbody>
<tr id="S3.E17X" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S3.E17X.m2" class="ltx_Math" alttext="\displaystyle GE_{\mathcal{S}}(\mathbb{x}(T;\cdot;\boldsymbol{\Theta}^{\rm total}))\leq" display="inline" intent=":literal"><semantics><mrow><mrow><mi>G</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>E</mi><mi class="ltx_font_mathcaligraphic">𝒮</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>𝕩</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>T</mi><mo rspace="0em">,</mo><mo lspace="0em" rspace="0em">⋅</mo><mo>,</mo><msup><mi>𝚯</mi><mi>total</mi></msup><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>≤</mo><mphantom></mphantom></mrow><annotation encoding="application/x-tex">\displaystyle GE_{\mathcal{S}}(\mathbb{x}(T;\cdot;\boldsymbol{\Theta}^{\rm total}))\leq</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S3.E17X.m3" class="ltx_Math" alttext="\displaystyle 2\sqrt{2}nB_{\kappa}B_{\boldsymbol{\Theta}}\frac{M(T,\mathrm{Lip}_{\psi},n_{\mathrm{d}},B_{\rm in},B_{\boldsymbol{\Theta}})}{\sqrt{S}}+4B_{\ell}\sqrt{\frac{2\log(4/\delta)}{S}}," display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msqrt><mn>2</mn></msqrt><mo lspace="0em" rspace="0em">​</mo><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>B</mi><mi>κ</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>B</mi><mi>𝚯</mi></msub><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><mrow><mi>M</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>T</mi><mo>,</mo><msub><mi>Lip</mi><mi>ψ</mi></msub><mo>,</mo><msub><mi>n</mi><mi>d</mi></msub><mo>,</mo><msub><mi>B</mi><mi>in</mi></msub><mo>,</mo><msub><mi>B</mi><mi>𝚯</mi></msub><mo stretchy="false">)</mo></mrow></mrow><msqrt><mi>S</mi></msqrt></mfrac></mstyle></mrow><mo>+</mo><mrow><mn>4</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>B</mi><mi mathvariant="normal">ℓ</mi></msub><mo lspace="0em" rspace="0em">​</mo><msqrt><mstyle displaystyle="true"><mfrac><mrow><mn>2</mn><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>log</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mn>4</mn><mo>/</mo><mi>δ</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mi>S</mi></mfrac></mstyle></msqrt></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle 2\sqrt{2}nB_{\kappa}B_{\boldsymbol{\Theta}}\frac{M(T,\mathrm{Lip}_{\psi},n_{\mathrm{d}},B_{\rm in},B_{\boldsymbol{\Theta}})}{\sqrt{S}}+4B_{\ell}\sqrt{\frac{2\log(4/\delta)}{S}},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="2" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equationgroup ltx_align_right">(17)</span></td></tr>
<tr id="S3.E17Xa" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S3.E17Xa.m2" class="ltx_Math" alttext="\displaystyle-\frac{(\mathrm{Lip}_{\phi_{1}}\alpha+\mathrm{Lip}_{\phi_{2}}\beta)\exp(T\mathrm{Lip}_{\psi}B_{\boldsymbol{\Theta}}^{2})T}{S}C_{\mathcal{S}}," display="inline" intent=":literal"><semantics><mrow><mrow><mo>−</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mrow><mo stretchy="false">(</mo><mrow><mrow><msub><mi>Lip</mi><msub><mi>ϕ</mi><mn>1</mn></msub></msub><mo lspace="0em" rspace="0em">​</mo><mi>α</mi></mrow><mo>+</mo><mrow><msub><mi>Lip</mi><msub><mi>ϕ</mi><mn>2</mn></msub></msub><mo lspace="0em" rspace="0em">​</mo><mi>β</mi></mrow></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>T</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>Lip</mi><mi>ψ</mi></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>B</mi><mi>𝚯</mi><mn>2</mn></msubsup></mrow><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><mi>T</mi></mrow><mi>S</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msub><mi>C</mi><mi class="ltx_font_mathcaligraphic">𝒮</mi></msub></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle-\frac{(\mathrm{Lip}_{\phi_{1}}\alpha+\mathrm{Lip}_{\phi_{2}}\beta)\exp(T\mathrm{Lip}_{\psi}B_{\boldsymbol{\Theta}}^{2})T}{S}C_{\mathcal{S}},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="Thmtheorem9.p1.3" class="ltx_p"><span id="Thmtheorem9.p1.3.1" class="ltx_text ltx_font_italic">where <math id="Thmtheorem9.p1.m12" class="ltx_Math" alttext="M(T,\mathrm{Lip}_{\psi},n_{\mathrm{d}},B_{\rm in},B_{\boldsymbol{\Theta}})=\Big(\mathrm{Lip}_{\psi}B_{\rm in}\sqrt{2\log(2n_{\mathrm{d}})}+1+T(1+2\mathrm{Lip}_{\psi}B_{\boldsymbol{\Theta}})\Big)\exp\big(2T\mathrm{Lip}_{\psi}B_{\boldsymbol{\Theta}}^{2}\big)" display="inline" intent=":literal"><semantics><mrow><mrow><mi>M</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>T</mi><mo>,</mo><msub><mi>Lip</mi><mi>ψ</mi></msub><mo>,</mo><msub><mi>n</mi><mi mathvariant="normal">d</mi></msub><mo>,</mo><msub><mi>B</mi><mi>in</mi></msub><mo>,</mo><msub><mi>B</mi><mi>𝚯</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mrow><mo maxsize="1.600em" minsize="1.600em">(</mo><mrow><mrow><msub><mi>Lip</mi><mi>ψ</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>B</mi><mi>in</mi></msub><mo lspace="0em" rspace="0em">​</mo><msqrt><mrow><mn>2</mn><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>log</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>n</mi><mi mathvariant="normal">d</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></msqrt></mrow><mo>+</mo><mn>1</mn><mo>+</mo><mrow><mi>T</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>Lip</mi><mi>ψ</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>B</mi><mi>𝚯</mi></msub></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo maxsize="1.600em" minsize="1.600em">)</mo></mrow><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>T</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>Lip</mi><mi>ψ</mi></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>B</mi><mi>𝚯</mi><mn>2</mn></msubsup></mrow><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">M(T,\mathrm{Lip}_{\psi},n_{\mathrm{d}},B_{\rm in},B_{\boldsymbol{\Theta}})=\Big(\mathrm{Lip}_{\psi}B_{\rm in}\sqrt{2\log(2n_{\mathrm{d}})}+1+T(1+2\mathrm{Lip}_{\psi}B_{\boldsymbol{\Theta}})\Big)\exp\big(2T\mathrm{Lip}_{\psi}B_{\boldsymbol{\Theta}}^{2}\big)</annotation></semantics></math>, <math id="Thmtheorem9.p1.m13" class="ltx_Math" alttext="B_{\kappa}" display="inline" intent=":literal"><semantics><msub><mi>B</mi><mi>κ</mi></msub><annotation encoding="application/x-tex">B_{\kappa}</annotation></semantics></math>, <math id="Thmtheorem9.p1.m14" class="ltx_Math" alttext="B_{\ell}" display="inline" intent=":literal"><semantics><msub><mi>B</mi><mi mathvariant="normal">ℓ</mi></msub><annotation encoding="application/x-tex">B_{\ell}</annotation></semantics></math> are constants dependent on <math id="Thmtheorem9.p1.m15" class="ltx_Math" alttext="T,B_{\rm in},B_{\boldsymbol{\Theta}},\mathrm{Lip}_{\psi}" display="inline" intent=":literal"><semantics><mrow><mi>T</mi><mo>,</mo><msub><mi>B</mi><mi>in</mi></msub><mo>,</mo><msub><mi>B</mi><mi>𝚯</mi></msub><mo>,</mo><msub><mi>Lip</mi><mi>ψ</mi></msub></mrow><annotation encoding="application/x-tex">T,B_{\rm in},B_{\boldsymbol{\Theta}},\mathrm{Lip}_{\psi}</annotation></semantics></math> and independent of <math id="Thmtheorem9.p1.m16" class="ltx_Math" alttext="L" display="inline" intent=":literal"><semantics><mi>L</mi><annotation encoding="application/x-tex">L</annotation></semantics></math>.
<span id="Thmtheorem9.p1.3.1.1" class="ltx_text ltx_align_floatright"></span></span></p>
</div>
</div>
<div id="S3.5" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="S3.p9" class="ltx_para">
<p id="S3.p9.1" class="ltx_p"><span id="S3.p9.1.1" class="ltx_text">The proof is given in Section <a href="#S4.SS3" title="4.3 Proof of Theorem ‣ 4 Proofs ‣ On the Generalization Behavior of Deep Residual Networks From a Dynamical System Perspective" class="ltx_ref"><span class="ltx_text ltx_ref_tag">4.3</span></a>.
<span id="S3.p9.1.1.1" class="ltx_text ltx_align_floatright"></span></span></p>
</div>
</div>
<div id="Thmtheorem10" class="ltx_theorem ltx_theorem_remark">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="Thmtheorem10.2" class="ltx_text ltx_font_bold">Remark 10</span></span><span id="Thmtheorem10.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="Thmtheorem10.p1" class="ltx_para">
<p id="Thmtheorem10.p1.1" class="ltx_p"><span id="Thmtheorem10.p1.1.1" class="ltx_text ltx_font_italic">The bound in (<a href="#S3.E17" title="Equation 17 ‣ Theorem 9. ‣ 3 Main results and application ‣ On the Generalization Behavior of Deep Residual Networks From a Dynamical System Perspective" class="ltx_ref"><span class="ltx_text ltx_ref_tag">17</span></a>) admits the same structural decomposition as its discrete-time counterpart: it consists of a leading term of order <math id="Thmtheorem10.p1.m1" class="ltx_Math" alttext="O(1/\sqrt{S})" display="inline" intent=":literal"><semantics><mrow><mi>O</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>/</mo><msqrt><mi>S</mi></msqrt></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">O(1/\sqrt{S})</annotation></semantics></math>, add a data-dependent but non-positive structure term. In particular, the bound remains well-defined and non-negative.
This generalization error for continuous-time ResNets is uniformly controlled over the time horizon and does not dependent on layer number <math id="Thmtheorem10.p1.m2" class="ltx_Math" alttext="L" display="inline" intent=":literal"><semantics><mi>L</mi><annotation encoding="application/x-tex">L</annotation></semantics></math>.
As a special case, when the learnable parameters are constant in time, our bound directly yields an <math id="Thmtheorem10.p1.m3" class="ltx_Math" alttext="O(1/\sqrt{S})" display="inline" intent=":literal"><semantics><mrow><mi>O</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>/</mo><msqrt><mi>S</mi></msqrt></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">O(1/\sqrt{S})</annotation></semantics></math> generalization estimate for neural ODEs <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib14" title="" class="ltx_ref">8</a>]</cite>. Combined with the discrete-time result in (<a href="#S3.E16" title="Equation 16 ‣ Theorem 5. ‣ 3 Main results and application ‣ On the Generalization Behavior of Deep Residual Networks From a Dynamical System Perspective" class="ltx_ref"><span class="ltx_text ltx_ref_tag">16</span></a>), this analysis shows that the generalization performance of ResNets remains uniformly bounded as the depth tends to infinity, providing theoretical support for the asymptotic consistency of deep residual architectures.
<span id="Thmtheorem10.p1.1.1.1" class="ltx_text ltx_align_floatright"></span></span></p>
</div>
</div>
<div id="Thmtheorem11" class="ltx_theorem ltx_theorem_remark">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="Thmtheorem11.2" class="ltx_text ltx_font_bold">Remark 11</span></span><span id="Thmtheorem11.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="Thmtheorem11.p1" class="ltx_para">
<p id="Thmtheorem11.p1.1" class="ltx_p"><span id="Thmtheorem11.p1.1.1" class="ltx_text ltx_font_italic">For comparison, Marion <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib40" title="" class="ltx_ref">34</a>]</cite> established a generalization bound for a related continuous-time model under additional regularity assumptions on the time dependence of the parameters, obtaining a rate of order <math id="Thmtheorem11.p1.m1" class="ltx_math_unparsed" alttext="O(S^{-1/4})" display="inline" intent=":literal"><semantics><mrow><mi>O</mi><mrow><mo stretchy="false">(</mo><msup><mi>S</mi><mrow><mo>−</mo><mn>1</mn><mo>/</mo><mn>4</mn></mrow></msup><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">O(S^{-1/4})</annotation></semantics></math>. Closely related bounds of the same order were later derived for neural controlled differential equations using Lipschitz-based complexity arguments <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib46" title="" class="ltx_ref">6</a>]</cite>. By contrast, our result is obtained under more general parameter assumptions and achieves an <math id="Thmtheorem11.p1.m2" class="ltx_Math" alttext="O(1/\sqrt{S})" display="inline" intent=":literal"><semantics><mrow><mi>O</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>/</mo><msqrt><mi>S</mi></msqrt></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">O(1/\sqrt{S})</annotation></semantics></math> rate.
More recently, Hanson and Raginsky <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib47" title="" class="ltx_ref">20</a>]</cite> derived an <math id="Thmtheorem11.p1.m3" class="ltx_Math" alttext="O(1/\sqrt{S})" display="inline" intent=":literal"><semantics><mrow><mi>O</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>/</mo><msqrt><mi>S</mi></msqrt></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">O(1/\sqrt{S})</annotation></semantics></math> generalization bound for neural ODEs via a Chen-Fliess series representation. While their analysis provides sharp sample complexity guarantees for continuous-depth models, it does not address the relationship between discrete-time ResNets and their continuous-time limits. Our result, instead, yields consistent <math id="Thmtheorem11.p1.m4" class="ltx_Math" alttext="O(1/\sqrt{S})" display="inline" intent=":literal"><semantics><mrow><mi>O</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>/</mo><msqrt><mi>S</mi></msqrt></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">O(1/\sqrt{S})</annotation></semantics></math> bounds for both discrete- and continuous-time settings within a unified framework.
<span id="Thmtheorem11.p1.1.1.1" class="ltx_text ltx_align_floatright"></span></span></p>
</div>
</div>
</section>
<section id="S4" class="ltx_section">
<h2 class="ltx_title ltx_title_section"><span class="ltx_tag ltx_tag_section">4 </span>Proofs</h2>

<div id="S4.p1" class="ltx_para">
<p id="S4.p1.1" class="ltx_p">In this section, we present detailed proofs for the main results. We start with the proof for Proposition <a href="#Thmtheorem2" title="Proposition 2. ‣ 3 Main results and application ‣ On the Generalization Behavior of Deep Residual Networks From a Dynamical System Perspective" class="ltx_ref"><span class="ltx_text ltx_ref_tag">2</span></a>.</p>
</div>
<section id="S4.SS1" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">4.1 </span>Proof of Proposition <a href="#Thmtheorem2" title="Proposition 2. ‣ 3 Main results and application ‣ On the Generalization Behavior of Deep Residual Networks From a Dynamical System Perspective" class="ltx_ref"><span class="ltx_text ltx_ref_tag">2</span></a></h3>

<div id="S4.SS1.2" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="S4.SS1.p1" class="ltx_para">
<p id="S4.SS1.p1.1" class="ltx_p"><span id="S4.SS1.p1.1.1" class="ltx_text">(Proof of Proposition <a href="#Thmtheorem2" title="Proposition 2. ‣ 3 Main results and application ‣ On the Generalization Behavior of Deep Residual Networks From a Dynamical System Perspective" class="ltx_ref"><span class="ltx_text ltx_ref_tag">2</span></a>)

The proof follows the chaining method framework <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib28" title="" class="ltx_ref">47</a>, <a href="#bib.bib3" title="" class="ltx_ref">44</a>]</cite> and is divided into three steps. The key idea is to carefully track how the piecewise structure of the activation function interacts with the Rademacher variables, allowing us to extract a negative correction term beyond the standard Lipschitz-based bound.</span></p>
</div>
<div id="S4.SS1.p2" class="ltx_para">
<p id="S4.SS1.p2.2" class="ltx_p"><span id="S4.SS1.p2.2.1" class="ltx_text">Step 1: We use the chaining method to decouple <math id="S4.SS1.p2.m1" class="ltx_Math" alttext="\varepsilon_{(S)}" display="inline" intent=":literal"><semantics><msub><mi>ε</mi><mrow><mo stretchy="false">(</mo><mi>S</mi><mo stretchy="false">)</mo></mrow></msub><annotation encoding="application/x-tex">\varepsilon_{(S)}</annotation></semantics></math>. Let <math id="S4.SS1.p2.m2" class="ltx_Math" alttext="\boldsymbol{\varepsilon}_{s}:=\{\varepsilon_{(1)},\ldots,\varepsilon_{(s)}\}" display="inline" intent=":literal"><semantics><mrow><msub><mi>𝜺</mi><mi>s</mi></msub><mo>:=</mo><mrow><mo stretchy="false">{</mo><msub><mi>ε</mi><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>ε</mi><mrow><mo stretchy="false">(</mo><mi>s</mi><mo stretchy="false">)</mo></mrow></msub><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">\boldsymbol{\varepsilon}_{s}:=\{\varepsilon_{(1)},\ldots,\varepsilon_{(s)}\}</annotation></semantics></math> for <math id="S4.SS1.p2.m3" class="ltx_Math" alttext="1\leq s\leq S" display="inline" intent=":literal"><semantics><mrow><mn>1</mn><mo>≤</mo><mi>s</mi><mo>≤</mo><mi>S</mi></mrow><annotation encoding="application/x-tex">1\leq s\leq S</annotation></semantics></math>, and <math id="S4.SS1.p2.m4" class="ltx_Math" alttext="R:=\mathbb{E}_{\boldsymbol{\varepsilon}_{S}}\sup_{{g}\in\mathcal{G}}\Big[\sum_{s=1}^{S}\varepsilon_{(s)}\psi(g(\mathrm{z}_{(s)}))\Big]" display="inline" intent=":literal"><semantics><mrow><mi>R</mi><mo>:=</mo><mrow><msub><mi>𝔼</mi><msub><mi>𝜺</mi><mi>S</mi></msub></msub><mo lspace="0.167em" rspace="0em">​</mo><mrow><msub><mo rspace="0em">sup</mo><mrow><mi>g</mi><mo>∈</mo><mi class="ltx_font_mathcaligraphic">𝒢</mi></mrow></msub><mrow><mo maxsize="1.600em" minsize="1.600em">[</mo><mrow><msubsup><mo lspace="0em">∑</mo><mrow><mi>s</mi><mo>=</mo><mn>1</mn></mrow><mi>S</mi></msubsup><mrow><msub><mi>ε</mi><mrow><mo stretchy="false">(</mo><mi>s</mi><mo stretchy="false">)</mo></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mi>ψ</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>g</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>z</mi><mrow><mo stretchy="false">(</mo><mi>s</mi><mo stretchy="false">)</mo></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo maxsize="1.600em" minsize="1.600em">]</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">R:=\mathbb{E}_{\boldsymbol{\varepsilon}_{S}}\sup_{{g}\in\mathcal{G}}\Big[\sum_{s=1}^{S}\varepsilon_{(s)}\psi(g(\mathrm{z}_{(s)}))\Big]</annotation></semantics></math>. Since <math id="S4.SS1.p2.m5" class="ltx_Math" alttext="\varepsilon_{(s)}" display="inline" intent=":literal"><semantics><msub><mi>ε</mi><mrow><mo stretchy="false">(</mo><mi>s</mi><mo stretchy="false">)</mo></mrow></msub><annotation encoding="application/x-tex">\varepsilon_{(s)}</annotation></semantics></math> <math id="S4.SS1.p2.m6" class="ltx_Math" alttext="(1\leq s\leq S)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>≤</mo><mi>s</mi><mo>≤</mo><mi>S</mi></mrow><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(1\leq s\leq S)</annotation></semantics></math> are independently and uniformly distributed over <math id="S4.SS1.p2.m7" class="ltx_Math" alttext="\{-1,1\}" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">{</mo><mrow><mrow><mo>−</mo><mn>1</mn></mrow><mo>,</mo><mn>1</mn></mrow><mo stretchy="false">}</mo></mrow><annotation encoding="application/x-tex">\{-1,1\}</annotation></semantics></math>, we have</span></p>
<table id="S4.E18" class="ltx_equationgroup ltx_eqn_table">
<tbody>
<tr id="S4.E18X" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S4.E18X.m2" class="ltx_Math" alttext="\displaystyle R=" display="inline" intent=":literal"><semantics><mrow><mi>R</mi><mo>=</mo><mphantom></mphantom></mrow><annotation encoding="application/x-tex">\displaystyle R=</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S4.E18X.m3" class="ltx_Math" alttext="\displaystyle\frac{1}{2}\mathbb{E}_{\boldsymbol{\varepsilon}_{S-1}}\sup_{{g}\in\mathcal{G}}\Big[\psi(g(\mathrm{z}_{(S)}))+\sum_{s=1}^{S-1}\varepsilon_{(s)}\psi(g(\mathrm{z}_{(s)}))\Big]" display="inline" intent=":literal"><semantics><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mn>2</mn></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝔼</mi><msub><mi>𝜺</mi><mrow><mi>S</mi><mo>−</mo><mn>1</mn></mrow></msub></msub><mo lspace="0.167em" rspace="0em">​</mo><mrow><munder><mo movablelimits="false" rspace="0em">sup</mo><mrow><mi>g</mi><mo>∈</mo><mi class="ltx_font_mathcaligraphic">𝒢</mi></mrow></munder><mrow><mo maxsize="1.600em" minsize="1.600em">[</mo><mrow><mrow><mi>ψ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>g</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>z</mi><mrow><mo stretchy="false">(</mo><mi>S</mi><mo stretchy="false">)</mo></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>s</mi><mo>=</mo><mn>1</mn></mrow><mrow><mi>S</mi><mo>−</mo><mn>1</mn></mrow></munderover></mstyle><mrow><msub><mi>ε</mi><mrow><mo stretchy="false">(</mo><mi>s</mi><mo stretchy="false">)</mo></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mi>ψ</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>g</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>z</mi><mrow><mo stretchy="false">(</mo><mi>s</mi><mo stretchy="false">)</mo></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo maxsize="1.600em" minsize="1.600em">]</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\frac{1}{2}\mathbb{E}_{\boldsymbol{\varepsilon}_{S-1}}\sup_{{g}\in\mathcal{G}}\Big[\psi(g(\mathrm{z}_{(S)}))+\sum_{s=1}^{S-1}\varepsilon_{(s)}\psi(g(\mathrm{z}_{(s)}))\Big]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="3" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equationgroup ltx_align_right">(18)</span></td></tr>
<tr id="S4.E18Xa" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S4.E18Xa.m2" class="ltx_Math" alttext="\displaystyle+\frac{1}{2}\mathbb{E}_{\boldsymbol{\varepsilon}_{S-1}}\sup_{{g}\in\mathcal{G}}\Big[-\psi(g(\mathrm{z}_{(S)}))+\sum_{s=1}^{S-1}\varepsilon_{(s)}\psi(g(\mathrm{z}_{(s)}))\Big]" display="inline" intent=":literal"><semantics><mrow><mo>+</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mn>2</mn></mfrac></mstyle><mi>𝔼</mi><msub><mrow></mrow><msub><mi>𝜺</mi><mrow><mi>S</mi><mo>−</mo><mn>1</mn></mrow></msub></msub><mo lspace="0.167em" movablelimits="false" rspace="0em">sup</mo><msub><mrow></mrow><mrow><mi>g</mi><mo>∈</mo><mi class="ltx_font_mathcaligraphic">𝒢</mi></mrow></msub><mo maxsize="1.600em" minsize="1.600em">[</mo><mo lspace="0em">−</mo><mi>ψ</mi><mo stretchy="false">(</mo><mi>g</mi><mo stretchy="false">(</mo><mi>z</mi><msub><mrow></mrow><mrow><mo stretchy="false">(</mo><mi>S</mi><mo stretchy="false">)</mo></mrow></msub><mo stretchy="false">)</mo><mo stretchy="false">)</mo><mo>+</mo><mstyle displaystyle="true"><mo movablelimits="false">∑</mo></mstyle><msub><mrow></mrow><mrow><mi>s</mi><mo>=</mo><mn>1</mn></mrow></msub><msup><mrow></mrow><mrow><mi>S</mi><mo>−</mo><mn>1</mn></mrow></msup><mi>ε</mi><msub><mrow></mrow><mrow><mo stretchy="false">(</mo><mi>s</mi><mo stretchy="false">)</mo></mrow></msub><mi>ψ</mi><mo stretchy="false">(</mo><mi>g</mi><mo stretchy="false">(</mo><mi>z</mi><msub><mrow></mrow><mrow><mo stretchy="false">(</mo><mi>s</mi><mo stretchy="false">)</mo></mrow></msub><mo stretchy="false">)</mo><mo stretchy="false">)</mo><mo maxsize="1.600em" minsize="1.600em">]</mo></mrow><annotation encoding="application/x-tex">\displaystyle+\frac{1}{2}\mathbb{E}_{\boldsymbol{\varepsilon}_{S-1}}\sup_{{g}\in\mathcal{G}}\Big[-\psi(g(\mathrm{z}_{(S)}))+\sum_{s=1}^{S-1}\varepsilon_{(s)}\psi(g(\mathrm{z}_{(s)}))\Big]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr>
<tr id="S4.E18Xb" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S4.E18Xb.m2" class="ltx_Math" alttext="\displaystyle=" display="inline" intent=":literal"><semantics><mo>=</mo><annotation encoding="application/x-tex">\displaystyle=</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S4.E18Xb.m3" class="ltx_Math" alttext="\displaystyle\frac{1}{2}\mathbb{E}_{\boldsymbol{\varepsilon}_{S-1}}\sup_{g,\hat{g}\in{\mathcal{G}}}\Big\{\big[\psi(g(\mathrm{z}_{(S)}))-\psi(\hat{g}(\mathrm{z}_{(S)}))\big]+\sum_{s=1}^{S-1}\varepsilon_{(s)}\big[\psi(g(\mathrm{z}_{(s)}))+\psi(\hat{g}(\mathrm{z}_{(s)}))\big]\Big\}." display="inline" intent=":literal"><semantics><mrow><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mn>2</mn></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝔼</mi><msub><mi>𝜺</mi><mrow><mi>S</mi><mo>−</mo><mn>1</mn></mrow></msub></msub><mo lspace="0.167em" rspace="0em">​</mo><mrow><munder><mo movablelimits="false" rspace="0em">sup</mo><mrow><mrow><mi>g</mi><mo>,</mo><mover accent="true"><mi>g</mi><mo>^</mo></mover></mrow><mo>∈</mo><mi class="ltx_font_mathcaligraphic">𝒢</mi></mrow></munder><mrow><mo stretchy="false">{</mo><mrow><mrow><mo maxsize="1.200em" minsize="1.200em">[</mo><mrow><mrow><mi>ψ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>g</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>z</mi><mrow><mo stretchy="false">(</mo><mi>S</mi><mo stretchy="false">)</mo></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mi>ψ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mover accent="true"><mi>g</mi><mo>^</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>z</mi><mrow><mo stretchy="false">(</mo><mi>S</mi><mo stretchy="false">)</mo></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo maxsize="1.200em" minsize="1.200em">]</mo></mrow><mo>+</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>s</mi><mo>=</mo><mn>1</mn></mrow><mrow><mi>S</mi><mo>−</mo><mn>1</mn></mrow></munderover></mstyle><mrow><msub><mi>ε</mi><mrow><mo stretchy="false">(</mo><mi>s</mi><mo stretchy="false">)</mo></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="1.200em" minsize="1.200em">[</mo><mrow><mrow><mi>ψ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>g</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>z</mi><mrow><mo stretchy="false">(</mo><mi>s</mi><mo stretchy="false">)</mo></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mrow><mi>ψ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mover accent="true"><mi>g</mi><mo>^</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>z</mi><mrow><mo stretchy="false">(</mo><mi>s</mi><mo stretchy="false">)</mo></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo maxsize="1.200em" minsize="1.200em">]</mo></mrow></mrow></mrow></mrow><mo stretchy="false">}</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\frac{1}{2}\mathbb{E}_{\boldsymbol{\varepsilon}_{S-1}}\sup_{g,\hat{g}\in{\mathcal{G}}}\Big\{\big[\psi(g(\mathrm{z}_{(S)}))-\psi(\hat{g}(\mathrm{z}_{(S)}))\big]+\sum_{s=1}^{S-1}\varepsilon_{(s)}\big[\psi(g(\mathrm{z}_{(s)}))+\psi(\hat{g}(\mathrm{z}_{(s)}))\big]\Big\}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S4.SS1.p2.3" class="ltx_p"><span id="S4.SS1.p2.3.1" class="ltx_text">Let <math id="S4.SS1.p2.m8" class="ltx_Math" alttext="u_{\boldsymbol{\varepsilon}_{s}}(g,\hat{g}):=\sum_{i=1}^{s}\varepsilon_{(i)}\big[\psi(g(\mathrm{z}_{(i)}))+\psi(\hat{g}(\mathrm{z}_{(i)}))\big]" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>u</mi><msub><mi>𝜺</mi><mi>s</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>g</mi><mo>,</mo><mover accent="true"><mi>g</mi><mo>^</mo></mover><mo stretchy="false">)</mo></mrow></mrow><mo rspace="0.111em">:=</mo><mrow><msubsup><mo>∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>s</mi></msubsup><mrow><msub><mi>ε</mi><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="1.200em" minsize="1.200em">[</mo><mrow><mrow><mi>ψ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>g</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>z</mi><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mrow><mi>ψ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mover accent="true"><mi>g</mi><mo>^</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>z</mi><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo maxsize="1.200em" minsize="1.200em">]</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">u_{\boldsymbol{\varepsilon}_{s}}(g,\hat{g}):=\sum_{i=1}^{s}\varepsilon_{(i)}\big[\psi(g(\mathrm{z}_{(i)}))+\psi(\hat{g}(\mathrm{z}_{(i)}))\big]</annotation></semantics></math> for <math id="S4.SS1.p2.m9" class="ltx_Math" alttext="s\geq 1" display="inline" intent=":literal"><semantics><mrow><mi>s</mi><mo>≥</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">s\geq 1</annotation></semantics></math> and <math id="S4.SS1.p2.m10" class="ltx_Math" alttext="u_{0}(g,\hat{g}):=0" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>u</mi><mn>0</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>g</mi><mo>,</mo><mover accent="true"><mi>g</mi><mo>^</mo></mover><mo stretchy="false">)</mo></mrow></mrow><mo>:=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">u_{0}(g,\hat{g}):=0</annotation></semantics></math>. We observe that <math id="S4.SS1.p2.m11" class="ltx_Math" alttext="u_{\boldsymbol{\varepsilon}_{s}}(g,\hat{g})" display="inline" intent=":literal"><semantics><mrow><msub><mi>u</mi><msub><mi>𝜺</mi><mi>s</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>g</mi><mo>,</mo><mover accent="true"><mi>g</mi><mo>^</mo></mover><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">u_{\boldsymbol{\varepsilon}_{s}}(g,\hat{g})</annotation></semantics></math> is symmetric, i.e., <math id="S4.SS1.p2.m12" class="ltx_Math" alttext="u_{\boldsymbol{\varepsilon}_{s}}(g,\hat{g})=u_{\boldsymbol{\varepsilon}_{s}}(\hat{g},g)" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>u</mi><msub><mi>𝜺</mi><mi>s</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>g</mi><mo>,</mo><mover accent="true"><mi>g</mi><mo>^</mo></mover><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><msub><mi>u</mi><msub><mi>𝜺</mi><mi>s</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mover accent="true"><mi>g</mi><mo>^</mo></mover><mo>,</mo><mi>g</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">u_{\boldsymbol{\varepsilon}_{s}}(g,\hat{g})=u_{\boldsymbol{\varepsilon}_{s}}(\hat{g},g)</annotation></semantics></math>.</span></p>
</div>
<div id="S4.SS1.p3" class="ltx_para">
<p id="S4.SS1.p3.1" class="ltx_p"><span id="S4.SS1.p3.1.1" class="ltx_text">Step 2: We estimate the first term in the right-hand side of Eq. (<a href="#S4.E18" title="Equation 18 ‣ Proof. ‣ 4.1 Proof of Proposition ‣ 4 Proofs ‣ On the Generalization Behavior of Deep Residual Networks From a Dynamical System Perspective" class="ltx_ref"><span class="ltx_text ltx_ref_tag">18</span></a>). Because the activation functions in <math id="S4.SS1.p3.m1" class="ltx_Math" alttext="\mathscr{A}(\mathbb{R})" display="inline" intent=":literal"><semantics><mrow><mi class="ltx_font_mathscript">𝒜</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>ℝ</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathscr{A}(\mathbb{R})</annotation></semantics></math> have a piecewise structure in the regions <math id="S4.SS1.p3.m2" class="ltx_Math" alttext="(-\infty,-\beta)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mrow><mo>−</mo><mi mathvariant="normal">∞</mi></mrow><mo>,</mo><mrow><mo>−</mo><mi>β</mi></mrow><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(-\infty,-\beta)</annotation></semantics></math>, <math id="S4.SS1.p3.m3" class="ltx_Math" alttext="[-\beta,\alpha]" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">[</mo><mrow><mrow><mo>−</mo><mi>β</mi></mrow><mo>,</mo><mi>α</mi></mrow><mo stretchy="false">]</mo></mrow><annotation encoding="application/x-tex">[-\beta,\alpha]</annotation></semantics></math>, and <math id="S4.SS1.p3.m4" class="ltx_Math" alttext="(\alpha,+\infty)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi>α</mi><mo>,</mo><mrow><mo>+</mo><mi mathvariant="normal">∞</mi></mrow><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(\alpha,+\infty)</annotation></semantics></math>, we divide <math id="S4.SS1.p3.m5" class="ltx_Math" alttext="\mathcal{G}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">𝒢</mi><annotation encoding="application/x-tex">\mathcal{G}</annotation></semantics></math> into three categories</span></p>
<table id="S4.Ex6" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S4.Ex6.m1" class="ltx_math_unparsed" alttext="\left\{\begin{aligned} {\mathcal{G}}^{-1}&amp;=\{{g}\in\mathcal{G}:\ g(\mathrm{z}_{(S)})&lt;-\beta\},\\
{\mathcal{G}}^{0}&amp;=\{{g}\in\mathcal{G}:\ -\beta\leq g(\mathrm{z}_{(S)})\leq\alpha\},\\
{\mathcal{G}}^{1}&amp;=\{{g}\in\mathcal{G}:\ g(\mathrm{z}_{(S)})&gt;\alpha\}.\end{aligned}\right." display="block" intent=":literal"><semantics><mrow><mo>{</mo><mtable columnspacing="0pt" displaystyle="true" rowspacing="0pt"><mtr><mtd class="ltx_align_right" columnalign="right"><msup><mi class="ltx_font_mathcaligraphic">𝒢</mi><mrow><mo>−</mo><mn>1</mn></mrow></msup></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><mphantom></mphantom><mo>=</mo><mrow><mo stretchy="false">{</mo><mrow><mi>g</mi><mo>∈</mo><mi class="ltx_font_mathcaligraphic">𝒢</mi></mrow><mo lspace="0.278em" rspace="0.778em">:</mo><mrow><mrow><mi>g</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>z</mi><mrow><mo stretchy="false">(</mo><mi>S</mi><mo stretchy="false">)</mo></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><mo>&lt;</mo><mrow><mo>−</mo><mi>β</mi></mrow></mrow><mo stretchy="false">}</mo></mrow></mrow><mo>,</mo></mrow></mtd></mtr><mtr><mtd class="ltx_align_right" columnalign="right"><msup><mi class="ltx_font_mathcaligraphic">𝒢</mi><mn>0</mn></msup></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><mphantom></mphantom><mo>=</mo><mrow><mo stretchy="false">{</mo><mrow><mi>g</mi><mo>∈</mo><mi class="ltx_font_mathcaligraphic">𝒢</mi></mrow><mo lspace="0.278em" rspace="0.778em">:</mo><mrow><mrow><mo>−</mo><mi>β</mi></mrow><mo>≤</mo><mrow><mi>g</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>z</mi><mrow><mo stretchy="false">(</mo><mi>S</mi><mo stretchy="false">)</mo></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><mo>≤</mo><mi>α</mi></mrow><mo stretchy="false">}</mo></mrow></mrow><mo>,</mo></mrow></mtd></mtr><mtr><mtd class="ltx_align_right" columnalign="right"><msup><mi class="ltx_font_mathcaligraphic">𝒢</mi><mn>1</mn></msup></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><mphantom></mphantom><mo>=</mo><mrow><mo stretchy="false">{</mo><mrow><mi>g</mi><mo>∈</mo><mi class="ltx_font_mathcaligraphic">𝒢</mi></mrow><mo lspace="0.278em" rspace="0.778em">:</mo><mrow><mrow><mi>g</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>z</mi><mrow><mo stretchy="false">(</mo><mi>S</mi><mo stretchy="false">)</mo></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><mo>&gt;</mo><mi>α</mi></mrow><mo stretchy="false">}</mo></mrow></mrow><mo lspace="0em">.</mo></mrow></mtd></mtr></mtable></mrow><annotation encoding="application/x-tex">\left\{\begin{aligned} {\mathcal{G}}^{-1}&amp;=\{{g}\in\mathcal{G}:\ g(\mathrm{z}_{(S)})&lt;-\beta\},\\
{\mathcal{G}}^{0}&amp;=\{{g}\in\mathcal{G}:\ -\beta\leq g(\mathrm{z}_{(S)})\leq\alpha\},\\
{\mathcal{G}}^{1}&amp;=\{{g}\in\mathcal{G}:\ g(\mathrm{z}_{(S)})&gt;\alpha\}.\end{aligned}\right.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S4.SS1.p3.2" class="ltx_p"><span id="S4.SS1.p3.2.1" class="ltx_text">Define <math id="S4.SS1.p3.m6" class="ltx_Math" alttext="\gamma_{a,b}=\sup_{{g}\in\mathcal{G}^{a},\hat{g}\in\mathcal{G}^{b}}\Big\{\big[\psi(g(\mathrm{z}_{(S)}))-\psi(\hat{g}(\mathrm{z}_{(S)}))\big]+u_{\boldsymbol{\varepsilon}_{S-1}}(g,\hat{g})\Big\}" display="inline" intent=":literal"><semantics><mrow><msub><mi>γ</mi><mrow><mi>a</mi><mo>,</mo><mi>b</mi></mrow></msub><mo rspace="0.1389em">=</mo><mrow><msub><mo lspace="0.1389em" rspace="0em">sup</mo><mrow><mrow><mi>g</mi><mo>∈</mo><msup><mi class="ltx_font_mathcaligraphic">𝒢</mi><mi>a</mi></msup></mrow><mo>,</mo><mrow><mover accent="true"><mi>g</mi><mo>^</mo></mover><mo>∈</mo><msup><mi class="ltx_font_mathcaligraphic">𝒢</mi><mi>b</mi></msup></mrow></mrow></msub><mrow><mo stretchy="false">{</mo><mrow><mrow><mo maxsize="1.200em" minsize="1.200em">[</mo><mrow><mrow><mi>ψ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>g</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>z</mi><mrow><mo stretchy="false">(</mo><mi>S</mi><mo stretchy="false">)</mo></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mi>ψ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mover accent="true"><mi>g</mi><mo>^</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>z</mi><mrow><mo stretchy="false">(</mo><mi>S</mi><mo stretchy="false">)</mo></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo maxsize="1.200em" minsize="1.200em">]</mo></mrow><mo>+</mo><mrow><msub><mi>u</mi><msub><mi>𝜺</mi><mrow><mi>S</mi><mo>−</mo><mn>1</mn></mrow></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>g</mi><mo>,</mo><mover accent="true"><mi>g</mi><mo>^</mo></mover><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">}</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\gamma_{a,b}=\sup_{{g}\in\mathcal{G}^{a},\hat{g}\in\mathcal{G}^{b}}\Big\{\big[\psi(g(\mathrm{z}_{(S)}))-\psi(\hat{g}(\mathrm{z}_{(S)}))\big]+u_{\boldsymbol{\varepsilon}_{S-1}}(g,\hat{g})\Big\}</annotation></semantics></math>, where <math id="S4.SS1.p3.m7" class="ltx_Math" alttext="a,b\in\{-1,0,1\}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>a</mi><mo>,</mo><mi>b</mi></mrow><mo>∈</mo><mrow><mo stretchy="false">{</mo><mrow><mrow><mo>−</mo><mn>1</mn></mrow><mo>,</mo><mn>0</mn><mo>,</mo><mn>1</mn></mrow><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">a,b\in\{-1,0,1\}</annotation></semantics></math>. Next, we estimate <math id="S4.SS1.p3.m8" class="ltx_Math" alttext="\gamma_{a,b}" display="inline" intent=":literal"><semantics><msub><mi>γ</mi><mrow><mi>a</mi><mo>,</mo><mi>b</mi></mrow></msub><annotation encoding="application/x-tex">\gamma_{a,b}</annotation></semantics></math>.</span></p>
</div>
<div id="S4.SS1.p4" class="ltx_para">
<ul id="S4.I1" class="ltx_itemize">
<li id="S4.I1.ix1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(i)</span> 
<div id="S4.I1.ix1.p1" class="ltx_para">
<p id="S4.I1.ix1.p1.1" class="ltx_p">For <math id="S4.I1.ix1.p1.m1" class="ltx_Math" alttext="(g,\hat{g})\in\mathcal{G}^{a}\times\mathcal{G}^{b}" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">(</mo><mi>g</mi><mo>,</mo><mover accent="true"><mi>g</mi><mo>^</mo></mover><mo stretchy="false">)</mo></mrow><mo>∈</mo><mrow><msup><mi class="ltx_font_mathcaligraphic">𝒢</mi><mi>a</mi></msup><mo lspace="0.222em" rspace="0.222em">×</mo><msup><mi class="ltx_font_mathcaligraphic">𝒢</mi><mi>b</mi></msup></mrow></mrow><annotation encoding="application/x-tex">(g,\hat{g})\in\mathcal{G}^{a}\times\mathcal{G}^{b}</annotation></semantics></math> with <math id="S4.I1.ix1.p1.m2" class="ltx_Math" alttext="a=b" display="inline" intent=":literal"><semantics><mrow><mi>a</mi><mo>=</mo><mi>b</mi></mrow><annotation encoding="application/x-tex">a=b</annotation></semantics></math> (i.e., <math id="S4.I1.ix1.p1.m3" class="ltx_Math" alttext="(a,b)=(-1,-1)" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">(</mo><mi>a</mi><mo>,</mo><mi>b</mi><mo stretchy="false">)</mo></mrow><mo>=</mo><mrow><mo stretchy="false">(</mo><mrow><mo>−</mo><mn>1</mn></mrow><mo>,</mo><mrow><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">(a,b)=(-1,-1)</annotation></semantics></math>, <math id="S4.I1.ix1.p1.m4" class="ltx_Math" alttext="(a,b)=(0,0)" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">(</mo><mi>a</mi><mo>,</mo><mi>b</mi><mo stretchy="false">)</mo></mrow><mo>=</mo><mrow><mo stretchy="false">(</mo><mn>0</mn><mo>,</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">(a,b)=(0,0)</annotation></semantics></math>, or <math id="S4.I1.ix1.p1.m5" class="ltx_Math" alttext="(a,b)=(1,1)" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">(</mo><mi>a</mi><mo>,</mo><mi>b</mi><mo stretchy="false">)</mo></mrow><mo>=</mo><mrow><mo stretchy="false">(</mo><mn>1</mn><mo>,</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">(a,b)=(1,1)</annotation></semantics></math>), we have
<math id="S4.I1.ix1.p1.m6" class="ltx_Math" alttext="\psi(g(\mathrm{z}_{(S)}))-\psi(\hat{g}(\mathrm{z}_{(S)}))\leq\mathrm{Lip}_{\psi}\cdot|g(\mathrm{z}_{(S)})-\hat{g}(\mathrm{z}_{(S)})|" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mi>ψ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>g</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>z</mi><mrow><mo stretchy="false">(</mo><mi>S</mi><mo stretchy="false">)</mo></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mi>ψ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mover accent="true"><mi>g</mi><mo>^</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>z</mi><mrow><mo stretchy="false">(</mo><mi>S</mi><mo stretchy="false">)</mo></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>≤</mo><mrow><msub><mi>Lip</mi><mi>ψ</mi></msub><mo lspace="0.222em" rspace="0.222em">⋅</mo><mrow><mo stretchy="false">|</mo><mrow><mrow><mi>g</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>z</mi><mrow><mo stretchy="false">(</mo><mi>S</mi><mo stretchy="false">)</mo></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mover accent="true"><mi>g</mi><mo>^</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>z</mi><mrow><mo stretchy="false">(</mo><mi>S</mi><mo stretchy="false">)</mo></mrow></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">|</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\psi(g(\mathrm{z}_{(S)}))-\psi(\hat{g}(\mathrm{z}_{(S)}))\leq\mathrm{Lip}_{\psi}\cdot|g(\mathrm{z}_{(S)})-\hat{g}(\mathrm{z}_{(S)})|</annotation></semantics></math>, since <math id="S4.I1.ix1.p1.m7" class="ltx_Math" alttext="\psi" display="inline" intent=":literal"><semantics><mi>ψ</mi><annotation encoding="application/x-tex">\psi</annotation></semantics></math> is <math id="S4.I1.ix1.p1.m8" class="ltx_Math" alttext="\mathrm{Lip}_{\psi}" display="inline" intent=":literal"><semantics><msub><mi>Lip</mi><mi>ψ</mi></msub><annotation encoding="application/x-tex">\mathrm{Lip}_{\psi}</annotation></semantics></math>-Lipschitz continuous. Therefore,</p>
<table id="S4.Ex7" class="ltx_equationgroup ltx_eqn_table">

<tbody id="S4.Ex7X"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S4.Ex7X.m2" class="ltx_Math" alttext="\displaystyle\gamma_{a,b}" display="inline" intent=":literal"><semantics><msub><mi>γ</mi><mrow><mi>a</mi><mo>,</mo><mi>b</mi></mrow></msub><annotation encoding="application/x-tex">\displaystyle\gamma_{a,b}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S4.Ex7X.m3" class="ltx_Math" alttext="\displaystyle\leq\sup_{{g}\in\mathcal{G}^{a},\hat{g}\in\mathcal{G}^{b}}\Big\{\mathrm{Lip}_{\psi}|g(\mathrm{z}_{(S)})-\hat{g}(\mathrm{z}_{(S)})|+u_{\boldsymbol{\varepsilon}_{S-1}}(g,\hat{g})\Big\}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo rspace="0.1389em">≤</mo><mrow><munder><mo lspace="0.1389em" movablelimits="false" rspace="0em">sup</mo><mrow><mrow><mi>g</mi><mo>∈</mo><msup><mi class="ltx_font_mathcaligraphic">𝒢</mi><mi>a</mi></msup></mrow><mo>,</mo><mrow><mover accent="true"><mi>g</mi><mo>^</mo></mover><mo>∈</mo><msup><mi class="ltx_font_mathcaligraphic">𝒢</mi><mi>b</mi></msup></mrow></mrow></munder><mrow><mo stretchy="false">{</mo><mrow><mrow><msub><mi>Lip</mi><mi>ψ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">|</mo><mrow><mrow><mi>g</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>z</mi><mrow><mo stretchy="false">(</mo><mi>S</mi><mo stretchy="false">)</mo></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mover accent="true"><mi>g</mi><mo>^</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>z</mi><mrow><mo stretchy="false">(</mo><mi>S</mi><mo stretchy="false">)</mo></mrow></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">|</mo></mrow></mrow><mo>+</mo><mrow><msub><mi>u</mi><msub><mi>𝜺</mi><mrow><mi>S</mi><mo>−</mo><mn>1</mn></mrow></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>g</mi><mo mathsize="1.600em">,</mo><mover accent="true"><mi>g</mi><mo>^</mo></mover><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">}</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\leq\sup_{{g}\in\mathcal{G}^{a},\hat{g}\in\mathcal{G}^{b}}\Big\{\mathrm{Lip}_{\psi}|g(\mathrm{z}_{(S)})-\hat{g}(\mathrm{z}_{(S)})|+u_{\boldsymbol{\varepsilon}_{S-1}}(g,\hat{g})\Big\}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="S4.Ex7Xa"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S4.Ex7Xa.m2" class="ltx_Math" alttext="\displaystyle=\sup_{{g}\in\mathcal{G}^{a},\hat{g}\in\mathcal{G}^{b}}\Big\{\mathrm{Lip}_{\psi}(g(\mathrm{z}_{(S)})-\hat{g}(\mathrm{z}_{(S)}))+u_{\boldsymbol{\varepsilon}_{S-1}}(g,\hat{g})\Big\}," display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo rspace="0.1389em">=</mo><mrow><munder><mo lspace="0.1389em" movablelimits="false" rspace="0em">sup</mo><mrow><mrow><mi>g</mi><mo>∈</mo><msup><mi class="ltx_font_mathcaligraphic">𝒢</mi><mi>a</mi></msup></mrow><mo>,</mo><mrow><mover accent="true"><mi>g</mi><mo>^</mo></mover><mo>∈</mo><msup><mi class="ltx_font_mathcaligraphic">𝒢</mi><mi>b</mi></msup></mrow></mrow></munder><mrow><mo stretchy="false">{</mo><mrow><mrow><msub><mi>Lip</mi><mi>ψ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mi>g</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>z</mi><mrow><mo stretchy="false">(</mo><mi>S</mi><mo stretchy="false">)</mo></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mover accent="true"><mi>g</mi><mo>^</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>z</mi><mrow><mo stretchy="false">(</mo><mi>S</mi><mo stretchy="false">)</mo></mrow></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mrow><msub><mi>u</mi><msub><mi>𝜺</mi><mrow><mi>S</mi><mo>−</mo><mn>1</mn></mrow></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>g</mi><mo>,</mo><mover accent="true"><mi>g</mi><mo>^</mo></mover><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">}</mo></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle=\sup_{{g}\in\mathcal{G}^{a},\hat{g}\in\mathcal{G}^{b}}\Big\{\mathrm{Lip}_{\psi}(g(\mathrm{z}_{(S)})-\hat{g}(\mathrm{z}_{(S)}))+u_{\boldsymbol{\varepsilon}_{S-1}}(g,\hat{g})\Big\},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S4.I1.ix1.p1.2" class="ltx_p">where the last equality is due to the symmetric of <math id="S4.I1.ix1.p1.m9" class="ltx_Math" alttext="u_{\boldsymbol{\varepsilon}_{(S-1)}}" display="inline" intent=":literal"><semantics><msub><mi>u</mi><msub><mi>𝜺</mi><mrow><mo stretchy="false">(</mo><mrow><mi>S</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></msub></msub><annotation encoding="application/x-tex">u_{\boldsymbol{\varepsilon}_{(S-1)}}</annotation></semantics></math>.</p>
</div></li>
<li id="S4.I1.ix2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(ii)</span> 
<div id="S4.I1.ix2.p1" class="ltx_para">
<p id="S4.I1.ix2.p1.1" class="ltx_p">For <math id="S4.I1.ix2.p1.m1" class="ltx_Math" alttext="(g,\hat{g})\in\mathcal{G}^{a}\times\mathcal{G}^{b}" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">(</mo><mi>g</mi><mo>,</mo><mover accent="true"><mi>g</mi><mo>^</mo></mover><mo stretchy="false">)</mo></mrow><mo>∈</mo><mrow><msup><mi class="ltx_font_mathcaligraphic">𝒢</mi><mi>a</mi></msup><mo lspace="0.222em" rspace="0.222em">×</mo><msup><mi class="ltx_font_mathcaligraphic">𝒢</mi><mi>b</mi></msup></mrow></mrow><annotation encoding="application/x-tex">(g,\hat{g})\in\mathcal{G}^{a}\times\mathcal{G}^{b}</annotation></semantics></math> with <math id="S4.I1.ix2.p1.m2" class="ltx_Math" alttext="a-b=1" display="inline" intent=":literal"><semantics><mrow><mrow><mi>a</mi><mo>−</mo><mi>b</mi></mrow><mo>=</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">a-b=1</annotation></semantics></math> (i.e., <math id="S4.I1.ix2.p1.m3" class="ltx_Math" alttext="(a,b)=(0,-1)" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">(</mo><mi>a</mi><mo>,</mo><mi>b</mi><mo stretchy="false">)</mo></mrow><mo>=</mo><mrow><mo stretchy="false">(</mo><mn>0</mn><mo>,</mo><mrow><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">(a,b)=(0,-1)</annotation></semantics></math> or <math id="S4.I1.ix2.p1.m4" class="ltx_Math" alttext="(a,b)=(1,0)" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">(</mo><mi>a</mi><mo>,</mo><mi>b</mi><mo stretchy="false">)</mo></mrow><mo>=</mo><mrow><mo stretchy="false">(</mo><mn>1</mn><mo>,</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">(a,b)=(1,0)</annotation></semantics></math>), we obtain</p>
<table id="S4.Ex8" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S4.Ex8.m1" class="ltx_Math" alttext="\psi(g(\mathrm{z}_{(S)}))-\psi(\hat{g}(\mathrm{z}_{(S)}))\leq\mathrm{Lip}_{\psi}|g(\mathrm{z}_{(S)})-\hat{g}(\mathrm{z}_{(S)})|=\mathrm{Lip}_{\psi}\big(g(\mathrm{z}_{(S)})-\hat{g}(\mathrm{z}_{(S)})\big)." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mrow><mrow><mi>ψ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>g</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>z</mi><mrow><mo stretchy="false">(</mo><mi>S</mi><mo stretchy="false">)</mo></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mi>ψ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mover accent="true"><mi>g</mi><mo>^</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>z</mi><mrow><mo stretchy="false">(</mo><mi>S</mi><mo stretchy="false">)</mo></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>≤</mo><msub><mi>Lip</mi><mi>ψ</mi></msub></mrow><mo fence="false">|</mo><mrow><mrow><mrow><mi>g</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>z</mi><mrow><mo stretchy="false">(</mo><mi>S</mi><mo stretchy="false">)</mo></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mover accent="true"><mi>g</mi><mo>^</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>z</mi><mrow><mo stretchy="false">(</mo><mi>S</mi><mo stretchy="false">)</mo></mrow></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo fence="false">|</mo><mrow><mphantom></mphantom><mo>=</mo><mrow><msub><mi>Lip</mi><mi>ψ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mrow><mrow><mi>g</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>z</mi><mrow><mo stretchy="false">(</mo><mi>S</mi><mo stretchy="false">)</mo></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mover accent="true"><mi>g</mi><mo>^</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>z</mi><mrow><mo stretchy="false">(</mo><mi>S</mi><mo stretchy="false">)</mo></mrow></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\psi(g(\mathrm{z}_{(S)}))-\psi(\hat{g}(\mathrm{z}_{(S)}))\leq\mathrm{Lip}_{\psi}|g(\mathrm{z}_{(S)})-\hat{g}(\mathrm{z}_{(S)})|=\mathrm{Lip}_{\psi}\big(g(\mathrm{z}_{(S)})-\hat{g}(\mathrm{z}_{(S)})\big).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S4.I1.ix2.p1.2" class="ltx_p">Therefore,</p>
<table id="S4.Ex9" class="ltx_equationgroup ltx_eqn_table">

<tbody id="S4.Ex9X"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S4.Ex9X.m2" class="ltx_Math" alttext="\displaystyle\gamma_{a,b}" display="inline" intent=":literal"><semantics><msub><mi>γ</mi><mrow><mi>a</mi><mo>,</mo><mi>b</mi></mrow></msub><annotation encoding="application/x-tex">\displaystyle\gamma_{a,b}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S4.Ex9X.m3" class="ltx_Math" alttext="\displaystyle\leq\sup_{{g}\in\mathcal{G}^{a},\hat{g}\in\mathcal{G}^{b}}\Big\{\mathrm{Lip}_{\psi}\big(g(\mathrm{z}_{(S)})-\hat{g}(\mathrm{z}_{(S)})\big)+u_{\boldsymbol{\varepsilon}_{S-1}}(g,\hat{g})\Big\}." display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo rspace="0.1389em">≤</mo><mrow><munder><mo lspace="0.1389em" movablelimits="false" rspace="0em">sup</mo><mrow><mrow><mi>g</mi><mo>∈</mo><msup><mi class="ltx_font_mathcaligraphic">𝒢</mi><mi>a</mi></msup></mrow><mo>,</mo><mrow><mover accent="true"><mi>g</mi><mo>^</mo></mover><mo>∈</mo><msup><mi class="ltx_font_mathcaligraphic">𝒢</mi><mi>b</mi></msup></mrow></mrow></munder><mrow><mo stretchy="false">{</mo><mrow><mrow><msub><mi>Lip</mi><mi>ψ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mrow><mrow><mi>g</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>z</mi><mrow><mo stretchy="false">(</mo><mi>S</mi><mo stretchy="false">)</mo></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mover accent="true"><mi>g</mi><mo>^</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>z</mi><mrow><mo stretchy="false">(</mo><mi>S</mi><mo stretchy="false">)</mo></mrow></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow></mrow><mo>+</mo><mrow><msub><mi>u</mi><msub><mi>𝜺</mi><mrow><mi>S</mi><mo>−</mo><mn>1</mn></mrow></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>g</mi><mo>,</mo><mover accent="true"><mi>g</mi><mo>^</mo></mover><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">}</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\leq\sup_{{g}\in\mathcal{G}^{a},\hat{g}\in\mathcal{G}^{b}}\Big\{\mathrm{Lip}_{\psi}\big(g(\mathrm{z}_{(S)})-\hat{g}(\mathrm{z}_{(S)})\big)+u_{\boldsymbol{\varepsilon}_{S-1}}(g,\hat{g})\Big\}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div></li>
<li id="S4.I1.ix3" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(iii)</span> 
<div id="S4.I1.ix3.p1" class="ltx_para">
<p id="S4.I1.ix3.p1.1" class="ltx_p">For <math id="S4.I1.ix3.p1.m1" class="ltx_Math" alttext="(g,\hat{g})\in\mathcal{G}^{a}\times\mathcal{G}^{b}" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">(</mo><mi>g</mi><mo>,</mo><mover accent="true"><mi>g</mi><mo>^</mo></mover><mo stretchy="false">)</mo></mrow><mo>∈</mo><mrow><msup><mi class="ltx_font_mathcaligraphic">𝒢</mi><mi>a</mi></msup><mo lspace="0.222em" rspace="0.222em">×</mo><msup><mi class="ltx_font_mathcaligraphic">𝒢</mi><mi>b</mi></msup></mrow></mrow><annotation encoding="application/x-tex">(g,\hat{g})\in\mathcal{G}^{a}\times\mathcal{G}^{b}</annotation></semantics></math> with <math id="S4.I1.ix3.p1.m2" class="ltx_Math" alttext="a-b=2" display="inline" intent=":literal"><semantics><mrow><mrow><mi>a</mi><mo>−</mo><mi>b</mi></mrow><mo>=</mo><mn>2</mn></mrow><annotation encoding="application/x-tex">a-b=2</annotation></semantics></math> (i.e., <math id="S4.I1.ix3.p1.m3" class="ltx_Math" alttext="(a,b)=(1,-1)" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">(</mo><mi>a</mi><mo>,</mo><mi>b</mi><mo stretchy="false">)</mo></mrow><mo>=</mo><mrow><mo stretchy="false">(</mo><mn>1</mn><mo>,</mo><mrow><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">(a,b)=(1,-1)</annotation></semantics></math>), we note that <math id="S4.I1.ix3.p1.m4" class="ltx_Math" alttext="-\hat{g}(\mathrm{z}_{(S)})-\beta&gt;0" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mo>−</mo><mrow><mover accent="true"><mi>g</mi><mo>^</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>z</mi><mrow><mo stretchy="false">(</mo><mi>S</mi><mo stretchy="false">)</mo></mrow></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>−</mo><mi>β</mi></mrow><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">-\hat{g}(\mathrm{z}_{(S)})-\beta&gt;0</annotation></semantics></math>, and</p>
<table id="S4.Ex10" class="ltx_equationgroup ltx_eqn_table">

<tbody id="S4.Ex10X"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S4.Ex10X.m2" class="ltx_Math" alttext="\displaystyle\psi(g(\mathrm{z}_{(S)}))-\psi(\hat{g}(\mathrm{z}_{(S)}))" display="inline" intent=":literal"><semantics><mrow><mrow><mi>ψ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>g</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>z</mi><mrow><mo stretchy="false">(</mo><mi>S</mi><mo stretchy="false">)</mo></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mi>ψ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mover accent="true"><mi>g</mi><mo>^</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>z</mi><mrow><mo stretchy="false">(</mo><mi>S</mi><mo stretchy="false">)</mo></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\psi(g(\mathrm{z}_{(S)}))-\psi(\hat{g}(\mathrm{z}_{(S)}))</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S4.Ex10X.m3" class="ltx_Math" alttext="\displaystyle=\phi_{1}(g(\mathrm{z}_{(S)})-\alpha)+\phi_{2}(-\hat{g}(\mathrm{z}_{(S)})-\beta)" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><msub><mi>ϕ</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mi>g</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>z</mi><mrow><mo stretchy="false">(</mo><mi>S</mi><mo stretchy="false">)</mo></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mi>α</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mrow><msub><mi>ϕ</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mo>−</mo><mrow><mover accent="true"><mi>g</mi><mo>^</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>z</mi><mrow><mo stretchy="false">(</mo><mi>S</mi><mo stretchy="false">)</mo></mrow></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>−</mo><mi>β</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\phi_{1}(g(\mathrm{z}_{(S)})-\alpha)+\phi_{2}(-\hat{g}(\mathrm{z}_{(S)})-\beta)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="S4.Ex10Xa"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S4.Ex10Xa.m2" class="ltx_Math" alttext="\displaystyle\leq\mathrm{Lip}_{\phi_{1}}(g(\mathrm{z}_{(S)})-\alpha)+\mathrm{Lip}_{\phi_{2}}(-\hat{g}(\mathrm{z}_{(S)})-\beta)" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≤</mo><mrow><mrow><msub><mi>Lip</mi><msub><mi>ϕ</mi><mn>1</mn></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mi>g</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>z</mi><mrow><mo stretchy="false">(</mo><mi>S</mi><mo stretchy="false">)</mo></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mi>α</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mrow><msub><mi>Lip</mi><msub><mi>ϕ</mi><mn>2</mn></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mo>−</mo><mrow><mover accent="true"><mi>g</mi><mo>^</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>z</mi><mrow><mo stretchy="false">(</mo><mi>S</mi><mo stretchy="false">)</mo></mrow></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>−</mo><mi>β</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\leq\mathrm{Lip}_{\phi_{1}}(g(\mathrm{z}_{(S)})-\alpha)+\mathrm{Lip}_{\phi_{2}}(-\hat{g}(\mathrm{z}_{(S)})-\beta)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="S4.Ex10Xb"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S4.Ex10Xb.m2" class="ltx_Math" alttext="\displaystyle\leq\mathrm{Lip}_{\psi}\big(g(\mathrm{z}_{(S)})-\hat{g}(\mathrm{z}_{(S)})\big)-\big(\mathrm{Lip}_{\phi_{1}}\alpha+\mathrm{Lip}_{\phi_{2}}\beta\big)," display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>≤</mo><mrow><mrow><msub><mi>Lip</mi><mi>ψ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mrow><mrow><mi>g</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>z</mi><mrow><mo stretchy="false">(</mo><mi>S</mi><mo stretchy="false">)</mo></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mover accent="true"><mi>g</mi><mo>^</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>z</mi><mrow><mo stretchy="false">(</mo><mi>S</mi><mo stretchy="false">)</mo></mrow></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow></mrow><mo>−</mo><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mrow><mrow><msub><mi>Lip</mi><msub><mi>ϕ</mi><mn>1</mn></msub></msub><mo lspace="0em" rspace="0em">​</mo><mi>α</mi></mrow><mo>+</mo><mrow><msub><mi>Lip</mi><msub><mi>ϕ</mi><mn>2</mn></msub></msub><mo lspace="0em" rspace="0em">​</mo><mi>β</mi></mrow></mrow><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\leq\mathrm{Lip}_{\psi}\big(g(\mathrm{z}_{(S)})-\hat{g}(\mathrm{z}_{(S)})\big)-\big(\mathrm{Lip}_{\phi_{1}}\alpha+\mathrm{Lip}_{\phi_{2}}\beta\big),</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S4.I1.ix3.p1.2" class="ltx_p">where the second inequality uses <math id="S4.I1.ix3.p1.m5" class="ltx_Math" alttext="\mathrm{Lip}_{\phi_{1}},\mathrm{Lip}_{\phi_{2}}\leq\mathrm{Lip}_{\psi}" display="inline" intent=":literal"><semantics><mrow><msub><mi>Lip</mi><msub><mi>ϕ</mi><mn>1</mn></msub></msub><mo>,</mo><mrow><msub><mi>Lip</mi><msub><mi>ϕ</mi><mn>2</mn></msub></msub><mo>≤</mo><msub><mi>Lip</mi><mi>ψ</mi></msub></mrow></mrow><annotation encoding="application/x-tex">\mathrm{Lip}_{\phi_{1}},\mathrm{Lip}_{\phi_{2}}\leq\mathrm{Lip}_{\psi}</annotation></semantics></math>.
Therefore,</p>
<table id="S4.Ex11" class="ltx_equationgroup ltx_eqn_table">

<tbody id="S4.Ex11X"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S4.Ex11X.m2" class="ltx_Math" alttext="\displaystyle\gamma_{a,b}" display="inline" intent=":literal"><semantics><msub><mi>γ</mi><mrow><mi>a</mi><mo>,</mo><mi>b</mi></mrow></msub><annotation encoding="application/x-tex">\displaystyle\gamma_{a,b}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S4.Ex11X.m3" class="ltx_Math" alttext="\displaystyle\leq\sup_{{g}\in\mathcal{G}^{a},\hat{g}\in\mathcal{G}^{b}}\Big\{\mathrm{Lip}_{\psi}(g(\mathrm{z}_{(S)})-\hat{g}(\mathrm{z}_{(S)}))+u_{\boldsymbol{\varepsilon}_{S-1}}(g,\hat{g})-\big(\mathrm{Lip}_{\phi_{1}}\alpha+\mathrm{Lip}_{\phi_{2}}\beta\big)\Big\}." display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo rspace="0.1389em">≤</mo><mrow><munder><mo lspace="0.1389em" movablelimits="false" rspace="0em">sup</mo><mrow><mrow><mi>g</mi><mo>∈</mo><msup><mi class="ltx_font_mathcaligraphic">𝒢</mi><mi>a</mi></msup></mrow><mo>,</mo><mrow><mover accent="true"><mi>g</mi><mo>^</mo></mover><mo>∈</mo><msup><mi class="ltx_font_mathcaligraphic">𝒢</mi><mi>b</mi></msup></mrow></mrow></munder><mrow><mo stretchy="false">{</mo><mrow><mrow><mrow><msub><mi>Lip</mi><mi>ψ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mi>g</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>z</mi><mrow><mo stretchy="false">(</mo><mi>S</mi><mo stretchy="false">)</mo></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mover accent="true"><mi>g</mi><mo>^</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>z</mi><mrow><mo stretchy="false">(</mo><mi>S</mi><mo stretchy="false">)</mo></mrow></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mrow><msub><mi>u</mi><msub><mi>𝜺</mi><mrow><mi>S</mi><mo>−</mo><mn>1</mn></mrow></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>g</mi><mo>,</mo><mover accent="true"><mi>g</mi><mo>^</mo></mover><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>−</mo><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mrow><mrow><msub><mi>Lip</mi><msub><mi>ϕ</mi><mn>1</mn></msub></msub><mo lspace="0em" rspace="0em">​</mo><mi>α</mi></mrow><mo>+</mo><mrow><msub><mi>Lip</mi><msub><mi>ϕ</mi><mn>2</mn></msub></msub><mo lspace="0em" rspace="0em">​</mo><mi>β</mi></mrow></mrow><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow></mrow><mo stretchy="false">}</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\leq\sup_{{g}\in\mathcal{G}^{a},\hat{g}\in\mathcal{G}^{b}}\Big\{\mathrm{Lip}_{\psi}(g(\mathrm{z}_{(S)})-\hat{g}(\mathrm{z}_{(S)}))+u_{\boldsymbol{\varepsilon}_{S-1}}(g,\hat{g})-\big(\mathrm{Lip}_{\phi_{1}}\alpha+\mathrm{Lip}_{\phi_{2}}\beta\big)\Big\}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div></li>
<li id="S4.I1.ix4" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(iv)</span> 
<div id="S4.I1.ix4.p1" class="ltx_para">
<p id="S4.I1.ix4.p1.1" class="ltx_p">For <math id="S4.I1.ix4.p1.m1" class="ltx_Math" alttext="(g,\hat{g})\in\mathcal{G}^{a}\times\mathcal{G}^{b}" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">(</mo><mi>g</mi><mo>,</mo><mover accent="true"><mi>g</mi><mo>^</mo></mover><mo stretchy="false">)</mo></mrow><mo>∈</mo><mrow><msup><mi class="ltx_font_mathcaligraphic">𝒢</mi><mi>a</mi></msup><mo lspace="0.222em" rspace="0.222em">×</mo><msup><mi class="ltx_font_mathcaligraphic">𝒢</mi><mi>b</mi></msup></mrow></mrow><annotation encoding="application/x-tex">(g,\hat{g})\in\mathcal{G}^{a}\times\mathcal{G}^{b}</annotation></semantics></math> with <math id="S4.I1.ix4.p1.m2" class="ltx_Math" alttext="a-b&lt;0" display="inline" intent=":literal"><semantics><mrow><mrow><mi>a</mi><mo>−</mo><mi>b</mi></mrow><mo>&lt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">a-b&lt;0</annotation></semantics></math> (i.e., <math id="S4.I1.ix4.p1.m3" class="ltx_Math" alttext="(a,b)=(-1,0)" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">(</mo><mi>a</mi><mo>,</mo><mi>b</mi><mo stretchy="false">)</mo></mrow><mo>=</mo><mrow><mo stretchy="false">(</mo><mrow><mo>−</mo><mn>1</mn></mrow><mo>,</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">(a,b)=(-1,0)</annotation></semantics></math> or <math id="S4.I1.ix4.p1.m4" class="ltx_Math" alttext="(a,b)=(0,1)" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">(</mo><mi>a</mi><mo>,</mo><mi>b</mi><mo stretchy="false">)</mo></mrow><mo>=</mo><mrow><mo stretchy="false">(</mo><mn>0</mn><mo>,</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">(a,b)=(0,1)</annotation></semantics></math> or <math id="S4.I1.ix4.p1.m5" class="ltx_Math" alttext="(a,b)=(-1,1)" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">(</mo><mi>a</mi><mo>,</mo><mi>b</mi><mo stretchy="false">)</mo></mrow><mo>=</mo><mrow><mo stretchy="false">(</mo><mrow><mo>−</mo><mn>1</mn></mrow><mo>,</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">(a,b)=(-1,1)</annotation></semantics></math>), we have</p>
<table id="S4.Ex12" class="ltx_equationgroup ltx_eqn_table">

<tbody id="S4.Ex12X"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S4.Ex12X.m2" class="ltx_Math" alttext="\displaystyle\psi(g(\mathrm{z}_{(S)}))-\psi(\hat{g}(\mathrm{z}_{(S)}))\leq\mathrm{Lip}_{\psi}|g(\mathrm{z}_{(S)})-\hat{g}(\mathrm{z}_{(S)})|=\mathrm{Lip}_{\psi}(\hat{g}(\mathrm{z}_{(S)})-g(\mathrm{z}_{(S)}))." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mrow><mi>ψ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>g</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>z</mi><mrow><mo stretchy="false">(</mo><mi>S</mi><mo stretchy="false">)</mo></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mi>ψ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mover accent="true"><mi>g</mi><mo>^</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>z</mi><mrow><mo stretchy="false">(</mo><mi>S</mi><mo stretchy="false">)</mo></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>≤</mo><msub><mi>Lip</mi><mi>ψ</mi></msub></mrow><mo fence="false">|</mo><mrow><mrow><mrow><mi>g</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>z</mi><mrow><mo stretchy="false">(</mo><mi>S</mi><mo stretchy="false">)</mo></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mover accent="true"><mi>g</mi><mo>^</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>z</mi><mrow><mo stretchy="false">(</mo><mi>S</mi><mo stretchy="false">)</mo></mrow></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo fence="false">|</mo><mrow><mrow><mphantom></mphantom><mo>=</mo><mrow><msub><mi>Lip</mi><mi>ψ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mover accent="true"><mi>g</mi><mo>^</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>z</mi><mrow><mo stretchy="false">(</mo><mi>S</mi><mo stretchy="false">)</mo></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mi>g</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>z</mi><mrow><mo stretchy="false">(</mo><mi>S</mi><mo stretchy="false">)</mo></mrow></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\psi(g(\mathrm{z}_{(S)}))-\psi(\hat{g}(\mathrm{z}_{(S)}))\leq\mathrm{Lip}_{\psi}|g(\mathrm{z}_{(S)})-\hat{g}(\mathrm{z}_{(S)})|=\mathrm{Lip}_{\psi}(\hat{g}(\mathrm{z}_{(S)})-g(\mathrm{z}_{(S)})).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S4.I1.ix4.p1.2" class="ltx_p">Therefore,</p>
<table id="S4.Ex13" class="ltx_equationgroup ltx_eqn_table">

<tbody id="S4.Ex13X"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S4.Ex13X.m2" class="ltx_Math" alttext="\displaystyle\gamma_{a,b}" display="inline" intent=":literal"><semantics><msub><mi>γ</mi><mrow><mi>a</mi><mo>,</mo><mi>b</mi></mrow></msub><annotation encoding="application/x-tex">\displaystyle\gamma_{a,b}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S4.Ex13X.m3" class="ltx_Math" alttext="\displaystyle\leq\sup_{{g}\in\mathcal{G}^{a},\hat{g}\in\mathcal{G}^{b}}\Big\{\mathrm{Lip}_{\psi}(\hat{g}(\mathrm{z}_{(S)})-g(\mathrm{z}_{(S)}))+u_{\boldsymbol{\varepsilon}_{S-1}}(g,\hat{g})\Big\}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo rspace="0.1389em">≤</mo><mrow><munder><mo lspace="0.1389em" movablelimits="false" rspace="0em">sup</mo><mrow><mrow><mi>g</mi><mo>∈</mo><msup><mi class="ltx_font_mathcaligraphic">𝒢</mi><mi>a</mi></msup></mrow><mo>,</mo><mrow><mover accent="true"><mi>g</mi><mo>^</mo></mover><mo>∈</mo><msup><mi class="ltx_font_mathcaligraphic">𝒢</mi><mi>b</mi></msup></mrow></mrow></munder><mrow><mo stretchy="false">{</mo><mrow><mrow><msub><mi>Lip</mi><mi>ψ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mover accent="true"><mi>g</mi><mo>^</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>z</mi><mrow><mo stretchy="false">(</mo><mi>S</mi><mo stretchy="false">)</mo></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mi>g</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>z</mi><mrow><mo stretchy="false">(</mo><mi>S</mi><mo stretchy="false">)</mo></mrow></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mrow><msub><mi>u</mi><msub><mi>𝜺</mi><mrow><mi>S</mi><mo>−</mo><mn>1</mn></mrow></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>g</mi><mo mathsize="1.600em">,</mo><mover accent="true"><mi>g</mi><mo>^</mo></mover><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">}</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\leq\sup_{{g}\in\mathcal{G}^{a},\hat{g}\in\mathcal{G}^{b}}\Big\{\mathrm{Lip}_{\psi}(\hat{g}(\mathrm{z}_{(S)})-g(\mathrm{z}_{(S)}))+u_{\boldsymbol{\varepsilon}_{S-1}}(g,\hat{g})\Big\}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="S4.Ex13Xa"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S4.Ex13Xa.m2" class="ltx_Math" alttext="\displaystyle=\sup_{{g}\in\mathcal{G}^{a},\hat{g}\in\mathcal{G}^{b}}\Big\{\mathrm{Lip}_{\psi}(\hat{g}(\mathrm{z}_{(S)})-g(\mathrm{z}_{(S)}))+u_{\boldsymbol{\varepsilon}_{S-1}}(\hat{g},g)\Big\}=\gamma_{b,a}." display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo rspace="0.1389em">=</mo><mrow><munder><mo lspace="0.1389em" movablelimits="false" rspace="0em">sup</mo><mrow><mrow><mi>g</mi><mo>∈</mo><msup><mi class="ltx_font_mathcaligraphic">𝒢</mi><mi>a</mi></msup></mrow><mo>,</mo><mrow><mover accent="true"><mi>g</mi><mo>^</mo></mover><mo>∈</mo><msup><mi class="ltx_font_mathcaligraphic">𝒢</mi><mi>b</mi></msup></mrow></mrow></munder><mrow><mo stretchy="false">{</mo><mrow><mrow><msub><mi>Lip</mi><mi>ψ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mover accent="true"><mi>g</mi><mo>^</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>z</mi><mrow><mo stretchy="false">(</mo><mi>S</mi><mo stretchy="false">)</mo></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mi>g</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>z</mi><mrow><mo stretchy="false">(</mo><mi>S</mi><mo stretchy="false">)</mo></mrow></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mrow><msub><mi>u</mi><msub><mi>𝜺</mi><mrow><mi>S</mi><mo>−</mo><mn>1</mn></mrow></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mover accent="true"><mi>g</mi><mo>^</mo></mover><mo>,</mo><mi>g</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">}</mo></mrow></mrow><mo>=</mo><msub><mi>γ</mi><mrow><mi>b</mi><mo>,</mo><mi>a</mi></mrow></msub></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle=\sup_{{g}\in\mathcal{G}^{a},\hat{g}\in\mathcal{G}^{b}}\Big\{\mathrm{Lip}_{\psi}(\hat{g}(\mathrm{z}_{(S)})-g(\mathrm{z}_{(S)}))+u_{\boldsymbol{\varepsilon}_{S-1}}(\hat{g},g)\Big\}=\gamma_{b,a}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div></li>
</ul>
</div>
<div id="S4.SS1.p5" class="ltx_para">
<p id="S4.SS1.p5.2" class="ltx_p"><span id="S4.SS1.p5.2.1" class="ltx_text">Combining the above discussions, we obtain</span></p>
<table id="S4.E19" class="ltx_equationgroup ltx_eqn_table">
<tbody>
<tr id="S4.E19X" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S4.E19X.m2" class="ltx_Math" alttext="\displaystyle\max_{a,b\in\{-1,0,1\}}\gamma_{a,b}" display="inline" intent=":literal"><semantics><mrow><munder><mi>max</mi><mrow><mrow><mi>a</mi><mo>,</mo><mi>b</mi></mrow><mo>∈</mo><mrow><mo stretchy="false">{</mo><mrow><mrow><mo>−</mo><mn>1</mn></mrow><mo>,</mo><mn>0</mn><mo>,</mo><mn>1</mn></mrow><mo stretchy="false">}</mo></mrow></mrow></munder><mo lspace="0.167em">⁡</mo><msub><mi>γ</mi><mrow><mi>a</mi><mo>,</mo><mi>b</mi></mrow></msub></mrow><annotation encoding="application/x-tex">\displaystyle\max_{a,b\in\{-1,0,1\}}\gamma_{a,b}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="2" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equationgroup ltx_align_right">(19)</span></td></tr>
<tr id="S4.E19Xa" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S4.E19Xa.m2" class="ltx_Math" alttext="\displaystyle\leq" display="inline" intent=":literal"><semantics><mo>≤</mo><annotation encoding="application/x-tex">\displaystyle\leq</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S4.E19Xa.m3" class="ltx_Math" alttext="\displaystyle\sup_{g,\hat{g}\in\mathcal{G}}\Big\{\mathrm{Lip}_{\psi}(g(\mathrm{z}_{(S)})-\hat{g}(\mathrm{z}_{(S)}))+u_{\boldsymbol{\varepsilon}_{S-1}}(g,\hat{g})-\big(\mathrm{Lip}_{\phi_{1}}\alpha+\mathrm{Lip}_{\phi_{2}}\beta\big)\cdot\mathbb{1}_{{\mathcal{G}}^{1}\times{\mathcal{G}}^{-1}}((g,\hat{g}))\Big\}," display="inline" intent=":literal"><semantics><mrow><mrow><munder><mo movablelimits="false">sup</mo><mrow><mrow><mi>g</mi><mo>,</mo><mover accent="true"><mi>g</mi><mo>^</mo></mover></mrow><mo>∈</mo><mi class="ltx_font_mathcaligraphic">𝒢</mi></mrow></munder><mrow><mo lspace="0em" stretchy="false">{</mo><mrow><mrow><mrow><msub><mi>Lip</mi><mi>ψ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mi>g</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>z</mi><mrow><mo stretchy="false">(</mo><mi>S</mi><mo stretchy="false">)</mo></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mover accent="true"><mi>g</mi><mo>^</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>z</mi><mrow><mo stretchy="false">(</mo><mi>S</mi><mo stretchy="false">)</mo></mrow></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mrow><msub><mi>u</mi><msub><mi>𝜺</mi><mrow><mi>S</mi><mo>−</mo><mn>1</mn></mrow></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>g</mi><mo>,</mo><mover accent="true"><mi>g</mi><mo>^</mo></mover><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>−</mo><mrow><mrow><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mrow><mrow><msub><mi>Lip</mi><msub><mi>ϕ</mi><mn>1</mn></msub></msub><mo lspace="0em" rspace="0em">​</mo><mi>α</mi></mrow><mo>+</mo><mrow><msub><mi>Lip</mi><msub><mi>ϕ</mi><mn>2</mn></msub></msub><mo lspace="0em" rspace="0em">​</mo><mi>β</mi></mrow></mrow><mo maxsize="1.200em" minsize="1.200em" rspace="0.055em">)</mo></mrow><mo rspace="0.222em">⋅</mo><msub><mn>𝟙</mn><mrow><msup><mi class="ltx_font_mathcaligraphic">𝒢</mi><mn>1</mn></msup><mo lspace="0.222em" rspace="0.222em">×</mo><msup><mi class="ltx_font_mathcaligraphic">𝒢</mi><mrow><mo>−</mo><mn>1</mn></mrow></msup></mrow></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mo stretchy="false">(</mo><mi>g</mi><mo>,</mo><mover accent="true"><mi>g</mi><mo>^</mo></mover><mo stretchy="false">)</mo></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">}</mo></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\sup_{g,\hat{g}\in\mathcal{G}}\Big\{\mathrm{Lip}_{\psi}(g(\mathrm{z}_{(S)})-\hat{g}(\mathrm{z}_{(S)}))+u_{\boldsymbol{\varepsilon}_{S-1}}(g,\hat{g})-\big(\mathrm{Lip}_{\phi_{1}}\alpha+\mathrm{Lip}_{\phi_{2}}\beta\big)\cdot\mathbb{1}_{{\mathcal{G}}^{1}\times{\mathcal{G}}^{-1}}((g,\hat{g}))\Big\},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S4.SS1.p5.3" class="ltx_p"><span id="S4.SS1.p5.3.1" class="ltx_text">where</span></p>
<table id="S4.Ex14" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S4.Ex14.m1" class="ltx_math_unparsed" alttext="\mathbb{1}_{{\mathcal{G}}^{1}\times{\mathcal{G}}^{-1}}(g,\hat{g})=\left\{\begin{aligned} &amp;1,\ (g,\hat{g})\in{\mathcal{G}}^{1}\times{\mathcal{G}}^{-1},\\
&amp;0,\ (g,\hat{g})\not\in{\mathcal{G}}^{1}\times{\mathcal{G}}^{-1}.\end{aligned}\right." display="block" intent=":literal"><semantics><mrow><msub><mn>𝟙</mn><mrow><msup><mi class="ltx_font_mathcaligraphic">𝒢</mi><mn>1</mn></msup><mo lspace="0.222em" rspace="0.222em">×</mo><msup><mi class="ltx_font_mathcaligraphic">𝒢</mi><mrow><mo>−</mo><mn>1</mn></mrow></msup></mrow></msub><mrow><mo stretchy="false">(</mo><mi>g</mi><mo>,</mo><mover accent="true"><mi>g</mi><mo>^</mo></mover><mo stretchy="false">)</mo></mrow><mo>=</mo><mrow><mo>{</mo><mtable columnspacing="0pt" displaystyle="true" rowspacing="0pt"><mtr><mtd></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><mn>1</mn><mo rspace="0.667em">,</mo><mrow><mrow><mo stretchy="false">(</mo><mi>g</mi><mo>,</mo><mover accent="true"><mi>g</mi><mo>^</mo></mover><mo stretchy="false">)</mo></mrow><mo>∈</mo><mrow><msup><mi class="ltx_font_mathcaligraphic">𝒢</mi><mn>1</mn></msup><mo lspace="0.222em" rspace="0.222em">×</mo><msup><mi class="ltx_font_mathcaligraphic">𝒢</mi><mrow><mo>−</mo><mn>1</mn></mrow></msup></mrow></mrow></mrow><mo>,</mo></mrow></mtd></mtr><mtr><mtd></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><mn>0</mn><mo rspace="0.667em">,</mo><mrow><mrow><mo stretchy="false">(</mo><mi>g</mi><mo>,</mo><mover accent="true"><mi>g</mi><mo>^</mo></mover><mo stretchy="false">)</mo></mrow><mo>∉</mo><mrow><msup><mi class="ltx_font_mathcaligraphic">𝒢</mi><mn>1</mn></msup><mo lspace="0.222em" rspace="0.222em">×</mo><msup><mi class="ltx_font_mathcaligraphic">𝒢</mi><mrow><mo>−</mo><mn>1</mn></mrow></msup></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow></mtd></mtr></mtable></mrow></mrow><annotation encoding="application/x-tex">\mathbb{1}_{{\mathcal{G}}^{1}\times{\mathcal{G}}^{-1}}(g,\hat{g})=\left\{\begin{aligned} &amp;1,\ (g,\hat{g})\in{\mathcal{G}}^{1}\times{\mathcal{G}}^{-1},\\
&amp;0,\ (g,\hat{g})\not\in{\mathcal{G}}^{1}\times{\mathcal{G}}^{-1}.\end{aligned}\right.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S4.SS1.p5.4" class="ltx_p"><span id="S4.SS1.p5.4.1" class="ltx_text">The indicator term explicitly encodes the frequency with which function pairs fall into the extreme regions of the activation, quantifying how often the negative structural contribution is activated across the sample.</span></p>
</div>
<div id="S4.SS1.p6" class="ltx_para">
<p id="S4.SS1.p6.2" class="ltx_p"><span id="S4.SS1.p6.2.1" class="ltx_text">Step 3: We now aggregate the negative contributions accumulated over all Rademacher configurations, yielding a data-dependent constant in Eq. (<a href="#S3.E13" title="Equation 13 ‣ Proposition 2. ‣ 3 Main results and application ‣ On the Generalization Behavior of Deep Residual Networks From a Dynamical System Perspective" class="ltx_ref"><span class="ltx_text ltx_ref_tag">13</span></a>) that captures the overall strength of the structural correction. For any <math id="S4.SS1.p6.m1" class="ltx_Math" alttext="\eta&gt;0" display="inline" intent=":literal"><semantics><mrow><mi>η</mi><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\eta&gt;0</annotation></semantics></math> and any given <math id="S4.SS1.p6.m2" class="ltx_Math" alttext="\boldsymbol{\varepsilon}_{S}\setminus{\varepsilon}_{(S)}\in\{-1,1\}^{S-1}" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>𝜺</mi><mi>S</mi></msub><mo>∖</mo><msub><mi>ε</mi><mrow><mo stretchy="false">(</mo><mi>S</mi><mo stretchy="false">)</mo></mrow></msub></mrow><mo>∈</mo><msup><mrow><mo stretchy="false">{</mo><mrow><mrow><mo>−</mo><mn>1</mn></mrow><mo>,</mo><mn>1</mn></mrow><mo stretchy="false">}</mo></mrow><mrow><mi>S</mi><mo>−</mo><mn>1</mn></mrow></msup></mrow><annotation encoding="application/x-tex">\boldsymbol{\varepsilon}_{S}\setminus{\varepsilon}_{(S)}\in\{-1,1\}^{S-1}</annotation></semantics></math>, there exist functions <math id="S4.SS1.p6.m3" class="ltx_Math" alttext="g^{*}_{\boldsymbol{\varepsilon}_{S}\setminus{\varepsilon}_{(S)}},\hat{g}^{*}_{\boldsymbol{\varepsilon}_{S}\setminus{\varepsilon}_{(S)}}\in\mathcal{G}" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>g</mi><mrow><msub><mi>𝜺</mi><mi>S</mi></msub><mo>∖</mo><msub><mi>ε</mi><mrow><mo stretchy="false">(</mo><mi>S</mi><mo stretchy="false">)</mo></mrow></msub></mrow><mo>∗</mo></msubsup><mo>,</mo><mrow><msubsup><mover accent="true"><mi>g</mi><mo>^</mo></mover><mrow><msub><mi>𝜺</mi><mi>S</mi></msub><mo>∖</mo><msub><mi>ε</mi><mrow><mo stretchy="false">(</mo><mi>S</mi><mo stretchy="false">)</mo></mrow></msub></mrow><mo>∗</mo></msubsup><mo>∈</mo><mi class="ltx_font_mathcaligraphic">𝒢</mi></mrow></mrow><annotation encoding="application/x-tex">g^{*}_{\boldsymbol{\varepsilon}_{S}\setminus{\varepsilon}_{(S)}},\hat{g}^{*}_{\boldsymbol{\varepsilon}_{S}\setminus{\varepsilon}_{(S)}}\in\mathcal{G}</annotation></semantics></math> such that</span></p>
<table id="S4.E20" class="ltx_equationgroup ltx_eqn_table">
<tbody>
<tr id="S4.E20X" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S4.E20X.m2" class="ltx_Math" alttext="\displaystyle\sup_{g,\hat{g}\in\mathcal{G}}\Big\{\mathrm{Lip}_{\psi}(g(\mathrm{z}_{(S)})-\hat{g}(\mathrm{z}_{(S)}))+u_{\boldsymbol{\varepsilon}_{S-1}}(g,\hat{g})-\big(\mathrm{Lip}_{\phi_{1}}\alpha+\mathrm{Lip}_{\phi_{2}}\beta\big)\cdot\mathbb{1}_{{\mathcal{G}}^{1}\times{\mathcal{G}}^{-1}}(g,\hat{g})\Big\}" display="inline" intent=":literal"><semantics><mrow><munder><mo movablelimits="false">sup</mo><mrow><mrow><mi>g</mi><mo>,</mo><mover accent="true"><mi>g</mi><mo>^</mo></mover></mrow><mo>∈</mo><mi class="ltx_font_mathcaligraphic">𝒢</mi></mrow></munder><mrow><mo lspace="0em" stretchy="false">{</mo><mrow><mrow><mrow><msub><mi>Lip</mi><mi>ψ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mi>g</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>z</mi><mrow><mo stretchy="false">(</mo><mi>S</mi><mo stretchy="false">)</mo></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mover accent="true"><mi>g</mi><mo>^</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>z</mi><mrow><mo stretchy="false">(</mo><mi>S</mi><mo stretchy="false">)</mo></mrow></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mrow><msub><mi>u</mi><msub><mi>𝜺</mi><mrow><mi>S</mi><mo>−</mo><mn>1</mn></mrow></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>g</mi><mo mathsize="1.600em">,</mo><mover accent="true"><mi>g</mi><mo>^</mo></mover><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>−</mo><mrow><mrow><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mrow><mrow><msub><mi>Lip</mi><msub><mi>ϕ</mi><mn>1</mn></msub></msub><mo lspace="0em" rspace="0em">​</mo><mi>α</mi></mrow><mo>+</mo><mrow><msub><mi>Lip</mi><msub><mi>ϕ</mi><mn>2</mn></msub></msub><mo lspace="0em" rspace="0em">​</mo><mi>β</mi></mrow></mrow><mo maxsize="1.200em" minsize="1.200em" rspace="0.055em">)</mo></mrow><mo rspace="0.222em">⋅</mo><msub><mn>𝟙</mn><mrow><msup><mi class="ltx_font_mathcaligraphic">𝒢</mi><mn>1</mn></msup><mo lspace="0.222em" rspace="0.222em">×</mo><msup><mi class="ltx_font_mathcaligraphic">𝒢</mi><mrow><mo>−</mo><mn>1</mn></mrow></msup></mrow></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>g</mi><mo mathsize="1.600em">,</mo><mover accent="true"><mi>g</mi><mo>^</mo></mover><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\sup_{g,\hat{g}\in\mathcal{G}}\Big\{\mathrm{Lip}_{\psi}(g(\mathrm{z}_{(S)})-\hat{g}(\mathrm{z}_{(S)}))+u_{\boldsymbol{\varepsilon}_{S-1}}(g,\hat{g})-\big(\mathrm{Lip}_{\phi_{1}}\alpha+\mathrm{Lip}_{\phi_{2}}\beta\big)\cdot\mathbb{1}_{{\mathcal{G}}^{1}\times{\mathcal{G}}^{-1}}(g,\hat{g})\Big\}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="3" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equationgroup ltx_align_right">(20)</span></td></tr>
<tr id="S4.E20Xa" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S4.E20Xa.m2" class="ltx_Math" alttext="\displaystyle\leq" display="inline" intent=":literal"><semantics><mo>≤</mo><annotation encoding="application/x-tex">\displaystyle\leq</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S4.E20Xa.m3" class="ltx_Math" alttext="\displaystyle\mathrm{Lip}_{\psi}\big(g^{*}_{\boldsymbol{\varepsilon}_{S}\setminus{\varepsilon}_{(S)}}(\mathrm{z}_{(S)})-\hat{g}^{*}_{\boldsymbol{\varepsilon}_{S}\setminus{\varepsilon}_{(S)}}(\mathrm{z}_{(S)})\big)+u_{\boldsymbol{\varepsilon}_{S-1}}(g^{*}_{\boldsymbol{\varepsilon}_{S}\setminus{\varepsilon}_{(S)}},\hat{g}^{*}_{\boldsymbol{\varepsilon}_{S}\setminus{\varepsilon}_{(S)}})" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>Lip</mi><mi>ψ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mrow><mrow><msubsup><mi>g</mi><mrow><msub><mi>𝜺</mi><mi>S</mi></msub><mo>∖</mo><msub><mi>ε</mi><mrow><mo stretchy="false">(</mo><mi>S</mi><mo stretchy="false">)</mo></mrow></msub></mrow><mo>∗</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>z</mi><mrow><mo stretchy="false">(</mo><mi>S</mi><mo stretchy="false">)</mo></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msubsup><mover accent="true"><mi>g</mi><mo>^</mo></mover><mrow><msub><mi>𝜺</mi><mi>S</mi></msub><mo>∖</mo><msub><mi>ε</mi><mrow><mo stretchy="false">(</mo><mi>S</mi><mo stretchy="false">)</mo></mrow></msub></mrow><mo>∗</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>z</mi><mrow><mo stretchy="false">(</mo><mi>S</mi><mo stretchy="false">)</mo></mrow></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow></mrow><mo>+</mo><mrow><msub><mi>u</mi><msub><mi>𝜺</mi><mrow><mi>S</mi><mo>−</mo><mn>1</mn></mrow></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>g</mi><mrow><msub><mi>𝜺</mi><mi>S</mi></msub><mo>∖</mo><msub><mi>ε</mi><mrow><mo stretchy="false">(</mo><mi>S</mi><mo stretchy="false">)</mo></mrow></msub></mrow><mo>∗</mo></msubsup><mo>,</mo><msubsup><mover accent="true"><mi>g</mi><mo>^</mo></mover><mrow><msub><mi>𝜺</mi><mi>S</mi></msub><mo>∖</mo><msub><mi>ε</mi><mrow><mo stretchy="false">(</mo><mi>S</mi><mo stretchy="false">)</mo></mrow></msub></mrow><mo>∗</mo></msubsup><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\mathrm{Lip}_{\psi}\big(g^{*}_{\boldsymbol{\varepsilon}_{S}\setminus{\varepsilon}_{(S)}}(\mathrm{z}_{(S)})-\hat{g}^{*}_{\boldsymbol{\varepsilon}_{S}\setminus{\varepsilon}_{(S)}}(\mathrm{z}_{(S)})\big)+u_{\boldsymbol{\varepsilon}_{S-1}}(g^{*}_{\boldsymbol{\varepsilon}_{S}\setminus{\varepsilon}_{(S)}},\hat{g}^{*}_{\boldsymbol{\varepsilon}_{S}\setminus{\varepsilon}_{(S)}})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr>
<tr id="S4.E20Xb" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S4.E20Xb.m2" class="ltx_Math" alttext="\displaystyle-\big(\mathrm{Lip}_{\phi_{1}}\alpha+\mathrm{Lip}_{\phi_{2}}\beta\big)\mathbb{1}_{{\mathcal{G}}^{1}\times{\mathcal{G}}^{-1}}(g^{*}_{\boldsymbol{\varepsilon}_{S}\setminus{\varepsilon}_{(S)}},\hat{g}^{*}_{\boldsymbol{\varepsilon}_{S}\setminus{\varepsilon}_{(S)}})+\eta/S." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mo>−</mo><mrow><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mrow><mrow><msub><mi>Lip</mi><msub><mi>ϕ</mi><mn>1</mn></msub></msub><mo lspace="0em" rspace="0em">​</mo><mi>α</mi></mrow><mo>+</mo><mrow><msub><mi>Lip</mi><msub><mi>ϕ</mi><mn>2</mn></msub></msub><mo lspace="0em" rspace="0em">​</mo><mi>β</mi></mrow></mrow><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mn>𝟙</mn><mrow><msup><mi class="ltx_font_mathcaligraphic">𝒢</mi><mn>1</mn></msup><mo lspace="0.222em" rspace="0.222em">×</mo><msup><mi class="ltx_font_mathcaligraphic">𝒢</mi><mrow><mo>−</mo><mn>1</mn></mrow></msup></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>g</mi><mrow><msub><mi>𝜺</mi><mi>S</mi></msub><mo>∖</mo><msub><mi>ε</mi><mrow><mo stretchy="false">(</mo><mi>S</mi><mo stretchy="false">)</mo></mrow></msub></mrow><mo>∗</mo></msubsup><mo>,</mo><msubsup><mover accent="true"><mi>g</mi><mo>^</mo></mover><mrow><msub><mi>𝜺</mi><mi>S</mi></msub><mo>∖</mo><msub><mi>ε</mi><mrow><mo stretchy="false">(</mo><mi>S</mi><mo stretchy="false">)</mo></mrow></msub></mrow><mo>∗</mo></msubsup><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>+</mo><mrow><mi>η</mi><mo>/</mo><mi>S</mi></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle-\big(\mathrm{Lip}_{\phi_{1}}\alpha+\mathrm{Lip}_{\phi_{2}}\beta\big)\mathbb{1}_{{\mathcal{G}}^{1}\times{\mathcal{G}}^{-1}}(g^{*}_{\boldsymbol{\varepsilon}_{S}\setminus{\varepsilon}_{(S)}},\hat{g}^{*}_{\boldsymbol{\varepsilon}_{S}\setminus{\varepsilon}_{(S)}})+\eta/S.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S4.SS1.p6.3" class="ltx_p"><span id="S4.SS1.p6.3.1" class="ltx_text">By combining Eqs. (<a href="#S4.E18" title="Equation 18 ‣ Proof. ‣ 4.1 Proof of Proposition ‣ 4 Proofs ‣ On the Generalization Behavior of Deep Residual Networks From a Dynamical System Perspective" class="ltx_ref"><span class="ltx_text ltx_ref_tag">18</span></a>)–(<a href="#S4.E20" title="Equation 20 ‣ Proof. ‣ 4.1 Proof of Proposition ‣ 4 Proofs ‣ On the Generalization Behavior of Deep Residual Networks From a Dynamical System Perspective" class="ltx_ref"><span class="ltx_text ltx_ref_tag">20</span></a>), we get</span></p>
<table id="S4.EGx1" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="S4.Ex15"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S4.Ex15.m1" class="ltx_Math" alttext="\displaystyle R\leq" display="inline" intent=":literal"><semantics><mrow><mi>R</mi><mo>≤</mo><mphantom></mphantom></mrow><annotation encoding="application/x-tex">\displaystyle R\leq</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S4.Ex15.m2" class="ltx_Math" alttext="\displaystyle\frac{1}{2}\mathbb{E}_{\boldsymbol{\varepsilon}_{S-1}}\sup_{g,\hat{g}\in\mathcal{G}}\Big\{\mathrm{Lip}_{\psi}(g(\mathrm{z}_{(S)})-\hat{g}(\mathrm{z}_{(S)}))+u_{\boldsymbol{\varepsilon}_{S-1}}(g,\hat{g})\Big\}" display="inline" intent=":literal"><semantics><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mn>2</mn></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝔼</mi><msub><mi>𝜺</mi><mrow><mi>S</mi><mo>−</mo><mn>1</mn></mrow></msub></msub><mo lspace="0.167em" rspace="0em">​</mo><mrow><munder><mo movablelimits="false" rspace="0em">sup</mo><mrow><mrow><mi>g</mi><mo>,</mo><mover accent="true"><mi>g</mi><mo>^</mo></mover></mrow><mo>∈</mo><mi class="ltx_font_mathcaligraphic">𝒢</mi></mrow></munder><mrow><mo stretchy="false">{</mo><mrow><mrow><msub><mi>Lip</mi><mi>ψ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mi>g</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>z</mi><mrow><mo stretchy="false">(</mo><mi>S</mi><mo stretchy="false">)</mo></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mover accent="true"><mi>g</mi><mo>^</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>z</mi><mrow><mo stretchy="false">(</mo><mi>S</mi><mo stretchy="false">)</mo></mrow></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mrow><msub><mi>u</mi><msub><mi>𝜺</mi><mrow><mi>S</mi><mo>−</mo><mn>1</mn></mrow></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>g</mi><mo>,</mo><mover accent="true"><mi>g</mi><mo>^</mo></mover><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">}</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\frac{1}{2}\mathbb{E}_{\boldsymbol{\varepsilon}_{S-1}}\sup_{g,\hat{g}\in\mathcal{G}}\Big\{\mathrm{Lip}_{\psi}(g(\mathrm{z}_{(S)})-\hat{g}(\mathrm{z}_{(S)}))+u_{\boldsymbol{\varepsilon}_{S-1}}(g,\hat{g})\Big\}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="S4.Ex16"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S4.Ex16.m1" class="ltx_math_unparsed" alttext="\displaystyle-\frac{\mathrm{Lip}_{\phi_{1}}\alpha+\mathrm{Lip}_{\phi_{2}}\beta}{2^{S-1}}\cdot\sum_{\boldsymbol{\varepsilon}_{S}\setminus{\varepsilon}_{(S)}\in\{-1,1\}^{S-1}}\mathbb{1}_{{\mathcal{G}}^{1}\times{\mathcal{G}}^{-1}}(g^{*}_{\boldsymbol{\varepsilon}_{S}\setminus{\varepsilon}_{(S)}},\hat{g}^{*}_{\boldsymbol{\varepsilon}_{S}\setminus{\varepsilon}_{(S)}})+\eta/S" display="inline" intent=":literal"><semantics><mrow><mo>−</mo><mstyle displaystyle="true"><mfrac><mrow><mrow><msub><mi>Lip</mi><msub><mi>ϕ</mi><mn>1</mn></msub></msub><mo lspace="0em" rspace="0em">​</mo><mi>α</mi></mrow><mo>+</mo><mrow><msub><mi>Lip</mi><msub><mi>ϕ</mi><mn>2</mn></msub></msub><mo lspace="0em" rspace="0em">​</mo><mi>β</mi></mrow></mrow><msup><mn>2</mn><mrow><mi>S</mi><mo>−</mo><mn>1</mn></mrow></msup></mfrac></mstyle><mo lspace="0.222em" rspace="0.222em">⋅</mo><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mrow><msub><mi>𝜺</mi><mi>S</mi></msub><mo>∖</mo><msub><mi>ε</mi><mrow><mo stretchy="false">(</mo><mi>S</mi><mo stretchy="false">)</mo></mrow></msub></mrow><mo>∈</mo><msup><mrow><mo stretchy="false">{</mo><mrow><mrow><mo>−</mo><mn>1</mn></mrow><mo>,</mo><mn>1</mn></mrow><mo stretchy="false">}</mo></mrow><mrow><mi>S</mi><mo>−</mo><mn>1</mn></mrow></msup></mrow></munder></mstyle><msub><mn>𝟙</mn><mrow><msup><mi class="ltx_font_mathcaligraphic">𝒢</mi><mn>1</mn></msup><mo lspace="0.222em" rspace="0.222em">×</mo><msup><mi class="ltx_font_mathcaligraphic">𝒢</mi><mrow><mo>−</mo><mn>1</mn></mrow></msup></mrow></msub><mrow><mo stretchy="false">(</mo><msubsup><mi>g</mi><mrow><msub><mi>𝜺</mi><mi>S</mi></msub><mo>∖</mo><msub><mi>ε</mi><mrow><mo stretchy="false">(</mo><mi>S</mi><mo stretchy="false">)</mo></mrow></msub></mrow><mo>∗</mo></msubsup><mo>,</mo><msubsup><mover accent="true"><mi>g</mi><mo>^</mo></mover><mrow><msub><mi>𝜺</mi><mi>S</mi></msub><mo>∖</mo><msub><mi>ε</mi><mrow><mo stretchy="false">(</mo><mi>S</mi><mo stretchy="false">)</mo></mrow></msub></mrow><mo>∗</mo></msubsup><mo stretchy="false">)</mo></mrow><mo>+</mo><mi>η</mi><mo>/</mo><mi>S</mi></mrow><annotation encoding="application/x-tex">\displaystyle-\frac{\mathrm{Lip}_{\phi_{1}}\alpha+\mathrm{Lip}_{\phi_{2}}\beta}{2^{S-1}}\cdot\sum_{\boldsymbol{\varepsilon}_{S}\setminus{\varepsilon}_{(S)}\in\{-1,1\}^{S-1}}\mathbb{1}_{{\mathcal{G}}^{1}\times{\mathcal{G}}^{-1}}(g^{*}_{\boldsymbol{\varepsilon}_{S}\setminus{\varepsilon}_{(S)}},\hat{g}^{*}_{\boldsymbol{\varepsilon}_{S}\setminus{\varepsilon}_{(S)}})+\eta/S</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="S4.Ex17"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S4.Ex17.m1" class="ltx_Math" alttext="\displaystyle=" display="inline" intent=":literal"><semantics><mo>=</mo><annotation encoding="application/x-tex">\displaystyle=</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S4.Ex17.m2" class="ltx_Math" alttext="\displaystyle\mathbb{E}_{\boldsymbol{\varepsilon}_{S}}\sup_{g\in\mathcal{G}}\Big\{{\varepsilon}_{(S)}\mathrm{Lip}_{\psi}g(\mathrm{z}_{(S)})+\sum_{s=1}^{S-1}\varepsilon_{(s)}\psi(g(\mathrm{z}_{(s)}))\Big\}" display="inline" intent=":literal"><semantics><mrow><msub><mi>𝔼</mi><msub><mi>𝜺</mi><mi>S</mi></msub></msub><mo lspace="0.167em" rspace="0em">​</mo><mrow><munder><mo movablelimits="false" rspace="0em">sup</mo><mrow><mi>g</mi><mo>∈</mo><mi class="ltx_font_mathcaligraphic">𝒢</mi></mrow></munder><mrow><mo stretchy="false">{</mo><mrow><mrow><msub><mi>ε</mi><mrow><mo stretchy="false">(</mo><mi>S</mi><mo stretchy="false">)</mo></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>Lip</mi><mi>ψ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi>g</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>z</mi><mrow><mo stretchy="false">(</mo><mi>S</mi><mo stretchy="false">)</mo></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>s</mi><mo>=</mo><mn>1</mn></mrow><mrow><mi>S</mi><mo>−</mo><mn>1</mn></mrow></munderover></mstyle><mrow><msub><mi>ε</mi><mrow><mo stretchy="false">(</mo><mi>s</mi><mo stretchy="false">)</mo></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mi>ψ</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>g</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>z</mi><mrow><mo stretchy="false">(</mo><mi>s</mi><mo stretchy="false">)</mo></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo stretchy="false">}</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\mathbb{E}_{\boldsymbol{\varepsilon}_{S}}\sup_{g\in\mathcal{G}}\Big\{{\varepsilon}_{(S)}\mathrm{Lip}_{\psi}g(\mathrm{z}_{(S)})+\sum_{s=1}^{S-1}\varepsilon_{(s)}\psi(g(\mathrm{z}_{(s)}))\Big\}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="S4.Ex18"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S4.Ex18.m1" class="ltx_math_unparsed" alttext="\displaystyle-\frac{\mathrm{Lip}_{\phi_{1}}\alpha+\mathrm{Lip}_{\phi_{2}}\beta}{2^{S-1}}\cdot\sum_{\boldsymbol{\varepsilon}_{S}\setminus{\varepsilon}_{(S)}\in\{-1,1\}^{S-1}}\mathbb{1}_{{\mathcal{G}}^{1}\times{\mathcal{G}}^{-1}}(g^{*}_{\boldsymbol{\varepsilon}_{S}\setminus{\varepsilon}_{(S)}},\hat{g}^{*}_{\boldsymbol{\varepsilon}_{S}\setminus{\varepsilon}_{(S)}})+\eta/S." display="inline" intent=":literal"><semantics><mrow><mo>−</mo><mstyle displaystyle="true"><mfrac><mrow><mrow><msub><mi>Lip</mi><msub><mi>ϕ</mi><mn>1</mn></msub></msub><mo lspace="0em" rspace="0em">​</mo><mi>α</mi></mrow><mo>+</mo><mrow><msub><mi>Lip</mi><msub><mi>ϕ</mi><mn>2</mn></msub></msub><mo lspace="0em" rspace="0em">​</mo><mi>β</mi></mrow></mrow><msup><mn>2</mn><mrow><mi>S</mi><mo>−</mo><mn>1</mn></mrow></msup></mfrac></mstyle><mo lspace="0.222em" rspace="0.222em">⋅</mo><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mrow><msub><mi>𝜺</mi><mi>S</mi></msub><mo>∖</mo><msub><mi>ε</mi><mrow><mo stretchy="false">(</mo><mi>S</mi><mo stretchy="false">)</mo></mrow></msub></mrow><mo>∈</mo><msup><mrow><mo stretchy="false">{</mo><mrow><mrow><mo>−</mo><mn>1</mn></mrow><mo>,</mo><mn>1</mn></mrow><mo stretchy="false">}</mo></mrow><mrow><mi>S</mi><mo>−</mo><mn>1</mn></mrow></msup></mrow></munder></mstyle><msub><mn>𝟙</mn><mrow><msup><mi class="ltx_font_mathcaligraphic">𝒢</mi><mn>1</mn></msup><mo lspace="0.222em" rspace="0.222em">×</mo><msup><mi class="ltx_font_mathcaligraphic">𝒢</mi><mrow><mo>−</mo><mn>1</mn></mrow></msup></mrow></msub><mrow><mo stretchy="false">(</mo><msubsup><mi>g</mi><mrow><msub><mi>𝜺</mi><mi>S</mi></msub><mo>∖</mo><msub><mi>ε</mi><mrow><mo stretchy="false">(</mo><mi>S</mi><mo stretchy="false">)</mo></mrow></msub></mrow><mo>∗</mo></msubsup><mo>,</mo><msubsup><mover accent="true"><mi>g</mi><mo>^</mo></mover><mrow><msub><mi>𝜺</mi><mi>S</mi></msub><mo>∖</mo><msub><mi>ε</mi><mrow><mo stretchy="false">(</mo><mi>S</mi><mo stretchy="false">)</mo></mrow></msub></mrow><mo>∗</mo></msubsup><mo stretchy="false">)</mo></mrow><mo>+</mo><mi>η</mi><mo>/</mo><mi>S</mi><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle-\frac{\mathrm{Lip}_{\phi_{1}}\alpha+\mathrm{Lip}_{\phi_{2}}\beta}{2^{S-1}}\cdot\sum_{\boldsymbol{\varepsilon}_{S}\setminus{\varepsilon}_{(S)}\in\{-1,1\}^{S-1}}\mathbb{1}_{{\mathcal{G}}^{1}\times{\mathcal{G}}^{-1}}(g^{*}_{\boldsymbol{\varepsilon}_{S}\setminus{\varepsilon}_{(S)}},\hat{g}^{*}_{\boldsymbol{\varepsilon}_{S}\setminus{\varepsilon}_{(S)}})+\eta/S.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="S4.SS1.p7" class="ltx_para">
<p id="S4.SS1.p7.1" class="ltx_p"><span id="S4.SS1.p7.1.1" class="ltx_text">It follows by iterating the above process for <math id="S4.SS1.p7.m1" class="ltx_Math" alttext="S-1" display="inline" intent=":literal"><semantics><mrow><mi>S</mi><mo>−</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">S-1</annotation></semantics></math> more steps (i.e., for <math id="S4.SS1.p7.m2" class="ltx_Math" alttext="s\in\{1,\ldots,S-1\}" display="inline" intent=":literal"><semantics><mrow><mi>s</mi><mo>∈</mo><mrow><mo stretchy="false">{</mo><mrow><mn>1</mn><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mrow><mi>S</mi><mo>−</mo><mn>1</mn></mrow></mrow><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">s\in\{1,\ldots,S-1\}</annotation></semantics></math>) that</span></p>
<table id="S4.Ex19" class="ltx_equationgroup ltx_eqn_table">

<tbody id="S4.Ex19X"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S4.Ex19X.m2" class="ltx_Math" alttext="\displaystyle R\leq" display="inline" intent=":literal"><semantics><mrow><mi>R</mi><mo>≤</mo><mphantom></mphantom></mrow><annotation encoding="application/x-tex">\displaystyle R\leq</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S4.Ex19X.m3" class="ltx_Math" alttext="\displaystyle\mathrm{Lip}_{\psi}\cdot\mathbb{E}_{\boldsymbol{\varepsilon}_{S}}\sup_{{g}\in\mathcal{G}}\Big\{\sum_{s=1}^{S}\varepsilon_{(s)}g(\mathrm{z}_{(s)})\Big\}" display="inline" intent=":literal"><semantics><mrow><mi>Lip</mi><msub><mrow></mrow><mi>ψ</mi></msub><mo lspace="0.222em" rspace="0.222em">⋅</mo><mi>𝔼</mi><msub><mrow></mrow><msub><mi>𝜺</mi><mi>S</mi></msub></msub><mo lspace="0.167em" movablelimits="false" rspace="0em">sup</mo><msub><mrow></mrow><mrow><mi>g</mi><mo>∈</mo><mi class="ltx_font_mathcaligraphic">𝒢</mi></mrow></msub><mo stretchy="false">{</mo><mstyle displaystyle="true"><mo movablelimits="false">∑</mo></mstyle><msub><mrow></mrow><mrow><mi>s</mi><mo>=</mo><mn>1</mn></mrow></msub><msup><mrow></mrow><mi>S</mi></msup><mi>ε</mi><msub><mrow></mrow><mrow><mo stretchy="false">(</mo><mi>s</mi><mo stretchy="false">)</mo></mrow></msub><mi>g</mi><mo stretchy="false">(</mo><mi>z</mi><msub><mrow></mrow><mrow><mo stretchy="false">(</mo><mi>s</mi><mo stretchy="false">)</mo></mrow></msub><mo stretchy="false">)</mo><mo stretchy="false">}</mo></mrow><annotation encoding="application/x-tex">\displaystyle\mathrm{Lip}_{\psi}\cdot\mathbb{E}_{\boldsymbol{\varepsilon}_{S}}\sup_{{g}\in\mathcal{G}}\Big\{\sum_{s=1}^{S}\varepsilon_{(s)}g(\mathrm{z}_{(s)})\Big\}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="S4.Ex19Xa"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S4.Ex19Xa.m2" class="ltx_Math" alttext="\displaystyle-\frac{\mathrm{Lip}_{\phi_{1}}\alpha+\mathrm{Lip}_{\phi_{2}}\beta}{2^{S-1}}\cdot\sum_{s=1}^{S}\sum_{\boldsymbol{\varepsilon}_{S}\setminus{\varepsilon}_{(s)}\in\{-1,1\}^{S-1}}\mathbb{1}_{{\mathcal{G}}^{1}\times{\mathcal{G}}^{-1}}(g^{*}_{\boldsymbol{\varepsilon}_{S}\setminus{\varepsilon}_{(s)}},\hat{g}^{*}_{\boldsymbol{\varepsilon}_{S}\setminus{\varepsilon}_{(s)}})+\eta," display="inline" intent=":literal"><semantics><mrow><mo>−</mo><mstyle displaystyle="true"><mfrac><mrow><mrow><msub><mi>Lip</mi><msub><mi>ϕ</mi><mn>1</mn></msub></msub><mo lspace="0em" rspace="0em">​</mo><mi>α</mi></mrow><mo>+</mo><mrow><msub><mi>Lip</mi><msub><mi>ϕ</mi><mn>2</mn></msub></msub><mo lspace="0em" rspace="0em">​</mo><mi>β</mi></mrow></mrow><msup><mn>2</mn><mrow><mi>S</mi><mo>−</mo><mn>1</mn></mrow></msup></mfrac></mstyle><mo lspace="0.222em" rspace="0.222em">⋅</mo><mstyle displaystyle="true"><mo movablelimits="false">∑</mo></mstyle><msub><mrow></mrow><mrow><mi>s</mi><mo>=</mo><mn>1</mn></mrow></msub><msup><mrow></mrow><mi>S</mi></msup><mstyle displaystyle="true"><mo movablelimits="false">∑</mo></mstyle><msub><mrow></mrow><mrow><mrow><msub><mi>𝜺</mi><mi>S</mi></msub><mo>∖</mo><msub><mi>ε</mi><mrow><mo stretchy="false">(</mo><mi>s</mi><mo stretchy="false">)</mo></mrow></msub></mrow><mo>∈</mo><msup><mrow><mo stretchy="false">{</mo><mrow><mrow><mo>−</mo><mn>1</mn></mrow><mo>,</mo><mn>1</mn></mrow><mo stretchy="false">}</mo></mrow><mrow><mi>S</mi><mo>−</mo><mn>1</mn></mrow></msup></mrow></msub><mn>𝟙</mn><msub><mrow></mrow><mrow><msup><mi class="ltx_font_mathcaligraphic">𝒢</mi><mn>1</mn></msup><mo lspace="0.222em" rspace="0.222em">×</mo><msup><mi class="ltx_font_mathcaligraphic">𝒢</mi><mrow><mo>−</mo><mn>1</mn></mrow></msup></mrow></msub><mo stretchy="false">(</mo><mi>g</mi><msup><mrow></mrow><mo>∗</mo></msup><msub><mrow></mrow><mrow><msub><mi>𝜺</mi><mi>S</mi></msub><mo>∖</mo><msub><mi>ε</mi><mrow><mo stretchy="false">(</mo><mi>s</mi><mo stretchy="false">)</mo></mrow></msub></mrow></msub><mo>,</mo><mover accent="true"><mi>g</mi><mo>^</mo></mover><msup><mrow></mrow><mo>∗</mo></msup><msub><mrow></mrow><mrow><msub><mi>𝜺</mi><mi>S</mi></msub><mo>∖</mo><msub><mi>ε</mi><mrow><mo stretchy="false">(</mo><mi>s</mi><mo stretchy="false">)</mo></mrow></msub></mrow></msub><mo stretchy="false">)</mo><mo>+</mo><mi>η</mi><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle-\frac{\mathrm{Lip}_{\phi_{1}}\alpha+\mathrm{Lip}_{\phi_{2}}\beta}{2^{S-1}}\cdot\sum_{s=1}^{S}\sum_{\boldsymbol{\varepsilon}_{S}\setminus{\varepsilon}_{(s)}\in\{-1,1\}^{S-1}}\mathbb{1}_{{\mathcal{G}}^{1}\times{\mathcal{G}}^{-1}}(g^{*}_{\boldsymbol{\varepsilon}_{S}\setminus{\varepsilon}_{(s)}},\hat{g}^{*}_{\boldsymbol{\varepsilon}_{S}\setminus{\varepsilon}_{(s)}})+\eta,</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S4.SS1.p7.2" class="ltx_p"><span id="S4.SS1.p7.2.1" class="ltx_text">where <math id="S4.SS1.p7.m3" class="ltx_Math" alttext="g^{*}_{\boldsymbol{\varepsilon}_{S}\setminus{\varepsilon}_{(s)}},\hat{g}^{*}_{\boldsymbol{\varepsilon}_{S}\setminus{\varepsilon}_{(s)}}\in\mathcal{G}" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>g</mi><mrow><msub><mi>𝜺</mi><mi>S</mi></msub><mo>∖</mo><msub><mi>ε</mi><mrow><mo stretchy="false">(</mo><mi>s</mi><mo stretchy="false">)</mo></mrow></msub></mrow><mo>∗</mo></msubsup><mo>,</mo><mrow><msubsup><mover accent="true"><mi>g</mi><mo>^</mo></mover><mrow><msub><mi>𝜺</mi><mi>S</mi></msub><mo>∖</mo><msub><mi>ε</mi><mrow><mo stretchy="false">(</mo><mi>s</mi><mo stretchy="false">)</mo></mrow></msub></mrow><mo>∗</mo></msubsup><mo>∈</mo><mi class="ltx_font_mathcaligraphic">𝒢</mi></mrow></mrow><annotation encoding="application/x-tex">g^{*}_{\boldsymbol{\varepsilon}_{S}\setminus{\varepsilon}_{(s)}},\hat{g}^{*}_{\boldsymbol{\varepsilon}_{S}\setminus{\varepsilon}_{(s)}}\in\mathcal{G}</annotation></semantics></math>. Hence,</span></p>
<table id="S4.Ex20" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S4.Ex20.m1" class="ltx_Math" alttext="\mathscr{R}_{\mathcal{Z}}(\psi\circ\mathcal{G})\leq\mathrm{Lip}_{\psi}\cdot\mathscr{R}_{\mathcal{Z}}(\mathcal{G})-\frac{(\mathrm{Lip}_{\phi_{1}}\alpha+\mathrm{Lip}_{\phi_{2}}\beta)}{S}{C_{\mathcal{Z}}(\eta)}+\eta/S," display="block" intent=":literal"><semantics><mrow><mrow><mrow><msub><mi class="ltx_font_mathscript">ℛ</mi><mi class="ltx_font_mathcaligraphic">𝒵</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>ψ</mi><mo lspace="0.222em" rspace="0.222em">∘</mo><mi class="ltx_font_mathcaligraphic">𝒢</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>≤</mo><mrow><mrow><mrow><mrow><msub><mi>Lip</mi><mi>ψ</mi></msub><mo lspace="0.222em" rspace="0.222em">⋅</mo><msub><mi class="ltx_font_mathscript">ℛ</mi><mi class="ltx_font_mathcaligraphic">𝒵</mi></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi class="ltx_font_mathcaligraphic">𝒢</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mfrac><mrow><mo stretchy="false">(</mo><mrow><mrow><msub><mi>Lip</mi><msub><mi>ϕ</mi><mn>1</mn></msub></msub><mo lspace="0em" rspace="0em">​</mo><mi>α</mi></mrow><mo>+</mo><mrow><msub><mi>Lip</mi><msub><mi>ϕ</mi><mn>2</mn></msub></msub><mo lspace="0em" rspace="0em">​</mo><mi>β</mi></mrow></mrow><mo stretchy="false">)</mo></mrow><mi>S</mi></mfrac><mo lspace="0em" rspace="0em">​</mo><msub><mi>C</mi><mi class="ltx_font_mathcaligraphic">𝒵</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>η</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>+</mo><mrow><mi>η</mi><mo>/</mo><mi>S</mi></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\mathscr{R}_{\mathcal{Z}}(\psi\circ\mathcal{G})\leq\mathrm{Lip}_{\psi}\cdot\mathscr{R}_{\mathcal{Z}}(\mathcal{G})-\frac{(\mathrm{Lip}_{\phi_{1}}\alpha+\mathrm{Lip}_{\phi_{2}}\beta)}{S}{C_{\mathcal{Z}}(\eta)}+\eta/S,</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S4.SS1.p7.3" class="ltx_p"><span id="S4.SS1.p7.3.1" class="ltx_text">where <math id="S4.SS1.p7.m4" class="ltx_Math" alttext="C_{\mathcal{Z}}(\eta)=\frac{1}{2^{S-1}}\sum_{s=1}^{S}\sum_{\boldsymbol{\varepsilon}_{S}\setminus{\varepsilon}_{(s)}\in\{-1,1\}^{S-1}}\mathbb{1}_{{\mathcal{G}}^{1}\times{\mathcal{G}}^{-1}}(g^{*}_{\boldsymbol{\varepsilon}_{S}\setminus{\varepsilon}_{(s)}},\hat{g}^{*}_{\boldsymbol{\varepsilon}_{S}\setminus{\varepsilon}_{(s)}})" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>C</mi><mi class="ltx_font_mathcaligraphic">𝒵</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>η</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mfrac><mn>1</mn><msup><mn>2</mn><mrow><mi>S</mi><mo>−</mo><mn>1</mn></mrow></msup></mfrac><mo lspace="0em" rspace="0em">​</mo><mrow><msubsup><mo rspace="0em">∑</mo><mrow><mi>s</mi><mo>=</mo><mn>1</mn></mrow><mi>S</mi></msubsup><mrow><msub><mo>∑</mo><mrow><mrow><msub><mi>𝜺</mi><mi>S</mi></msub><mo>∖</mo><msub><mi>ε</mi><mrow><mo stretchy="false">(</mo><mi>s</mi><mo stretchy="false">)</mo></mrow></msub></mrow><mo>∈</mo><msup><mrow><mo stretchy="false">{</mo><mrow><mrow><mo>−</mo><mn>1</mn></mrow><mo>,</mo><mn>1</mn></mrow><mo stretchy="false">}</mo></mrow><mrow><mi>S</mi><mo>−</mo><mn>1</mn></mrow></msup></mrow></msub><mrow><msub><mn>𝟙</mn><mrow><msup><mi class="ltx_font_mathcaligraphic">𝒢</mi><mn>1</mn></msup><mo lspace="0.222em" rspace="0.222em">×</mo><msup><mi class="ltx_font_mathcaligraphic">𝒢</mi><mrow><mo>−</mo><mn>1</mn></mrow></msup></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>g</mi><mrow><msub><mi>𝜺</mi><mi>S</mi></msub><mo>∖</mo><msub><mi>ε</mi><mrow><mo stretchy="false">(</mo><mi>s</mi><mo stretchy="false">)</mo></mrow></msub></mrow><mo>∗</mo></msubsup><mo>,</mo><msubsup><mover accent="true"><mi>g</mi><mo>^</mo></mover><mrow><msub><mi>𝜺</mi><mi>S</mi></msub><mo>∖</mo><msub><mi>ε</mi><mrow><mo stretchy="false">(</mo><mi>s</mi><mo stretchy="false">)</mo></mrow></msub></mrow><mo>∗</mo></msubsup><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">C_{\mathcal{Z}}(\eta)=\frac{1}{2^{S-1}}\sum_{s=1}^{S}\sum_{\boldsymbol{\varepsilon}_{S}\setminus{\varepsilon}_{(s)}\in\{-1,1\}^{S-1}}\mathbb{1}_{{\mathcal{G}}^{1}\times{\mathcal{G}}^{-1}}(g^{*}_{\boldsymbol{\varepsilon}_{S}\setminus{\varepsilon}_{(s)}},\hat{g}^{*}_{\boldsymbol{\varepsilon}_{S}\setminus{\varepsilon}_{(s)}})</annotation></semantics></math> is dependent on <math id="S4.SS1.p7.m5" class="ltx_Math" alttext="{\mathcal{Z}}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">𝒵</mi><annotation encoding="application/x-tex">{\mathcal{Z}}</annotation></semantics></math>.
Taking the limit as <math id="S4.SS1.p7.m6" class="ltx_Math" alttext="\eta\to 0" display="inline" intent=":literal"><semantics><mrow><mi>η</mi><mo stretchy="false">→</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\eta\to 0</annotation></semantics></math>, we obtain (along a subsequence) that <math id="S4.SS1.p7.m7" class="ltx_Math" alttext="C_{\mathcal{Z}}(\eta)\to C_{\mathcal{Z}}" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>C</mi><mi class="ltx_font_mathcaligraphic">𝒵</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>η</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">→</mo><msub><mi>C</mi><mi class="ltx_font_mathcaligraphic">𝒵</mi></msub></mrow><annotation encoding="application/x-tex">C_{\mathcal{Z}}(\eta)\to C_{\mathcal{Z}}</annotation></semantics></math> for some <math id="S4.SS1.p7.m8" class="ltx_Math" alttext="0\leq C_{\mathcal{Z}}\leq S" display="inline" intent=":literal"><semantics><mrow><mn>0</mn><mo>≤</mo><msub><mi>C</mi><mi class="ltx_font_mathcaligraphic">𝒵</mi></msub><mo>≤</mo><mi>S</mi></mrow><annotation encoding="application/x-tex">0\leq C_{\mathcal{Z}}\leq S</annotation></semantics></math>. 
Thus,</span></p>
<table id="S4.Ex21" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S4.Ex21.m1" class="ltx_Math" alttext="\mathscr{R}_{\mathcal{Z}}(\psi\circ\mathcal{G})\leq\mathrm{Lip}_{\psi}\cdot\mathscr{R}_{\mathcal{Z}}(\mathcal{G})-\frac{\mathrm{Lip}_{\phi_{1}}\alpha+\mathrm{Lip}_{\phi_{2}}\beta}{S}C_{\mathcal{Z}}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><msub><mi class="ltx_font_mathscript">ℛ</mi><mi class="ltx_font_mathcaligraphic">𝒵</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>ψ</mi><mo lspace="0.222em" rspace="0.222em">∘</mo><mi class="ltx_font_mathcaligraphic">𝒢</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>≤</mo><mrow><mrow><mrow><msub><mi>Lip</mi><mi>ψ</mi></msub><mo lspace="0.222em" rspace="0.222em">⋅</mo><msub><mi class="ltx_font_mathscript">ℛ</mi><mi class="ltx_font_mathcaligraphic">𝒵</mi></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi class="ltx_font_mathcaligraphic">𝒢</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mfrac><mrow><mrow><msub><mi>Lip</mi><msub><mi>ϕ</mi><mn>1</mn></msub></msub><mo lspace="0em" rspace="0em">​</mo><mi>α</mi></mrow><mo>+</mo><mrow><msub><mi>Lip</mi><msub><mi>ϕ</mi><mn>2</mn></msub></msub><mo lspace="0em" rspace="0em">​</mo><mi>β</mi></mrow></mrow><mi>S</mi></mfrac><mo lspace="0em" rspace="0em">​</mo><msub><mi>C</mi><mi class="ltx_font_mathcaligraphic">𝒵</mi></msub></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\mathscr{R}_{\mathcal{Z}}(\psi\circ\mathcal{G})\leq\mathrm{Lip}_{\psi}\cdot\mathscr{R}_{\mathcal{Z}}(\mathcal{G})-\frac{\mathrm{Lip}_{\phi_{1}}\alpha+\mathrm{Lip}_{\phi_{2}}\beta}{S}C_{\mathcal{Z}}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S4.SS1.p7.4" class="ltx_p"><span id="S4.SS1.p7.4.1" class="ltx_text">Since the Rademacher complexity is nonnegative, we get
<math id="S4.SS1.p7.m9" class="ltx_Math" alttext="C_{\mathcal{Z}}\leq\frac{\mathrm{Lip}_{\psi}S}{\mathrm{Lip}_{\phi_{1}}\alpha+\mathrm{Lip}_{\phi_{2}}\beta}\mathscr{R}_{\mathcal{Z}}(\mathcal{G})" display="inline" intent=":literal"><semantics><mrow><msub><mi>C</mi><mi class="ltx_font_mathcaligraphic">𝒵</mi></msub><mo>≤</mo><mrow><mfrac><mrow><msub><mi>Lip</mi><mi>ψ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi>S</mi></mrow><mrow><mrow><msub><mi>Lip</mi><msub><mi>ϕ</mi><mn>1</mn></msub></msub><mo lspace="0em" rspace="0em">​</mo><mi>α</mi></mrow><mo>+</mo><mrow><msub><mi>Lip</mi><msub><mi>ϕ</mi><mn>2</mn></msub></msub><mo lspace="0em" rspace="0em">​</mo><mi>β</mi></mrow></mrow></mfrac><mo lspace="0em" rspace="0em">​</mo><msub><mi class="ltx_font_mathscript">ℛ</mi><mi class="ltx_font_mathcaligraphic">𝒵</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi class="ltx_font_mathcaligraphic">𝒢</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">C_{\mathcal{Z}}\leq\frac{\mathrm{Lip}_{\psi}S}{\mathrm{Lip}_{\phi_{1}}\alpha+\mathrm{Lip}_{\phi_{2}}\beta}\mathscr{R}_{\mathcal{Z}}(\mathcal{G})</annotation></semantics></math>, and thus complete the proof.
<span id="S4.SS1.p7.4.1.1" class="ltx_text ltx_align_floatright"></span></span></p>
</div>
</div>
</section>
<section id="S4.SS2" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">4.2 </span>Proof of Theorem <a href="#Thmtheorem5" title="Theorem 5. ‣ 3 Main results and application ‣ On the Generalization Behavior of Deep Residual Networks From a Dynamical System Perspective" class="ltx_ref"><span class="ltx_text ltx_ref_tag">5</span></a></h3>

<div id="S4.SS2.p1" class="ltx_para">
<p id="S4.SS2.p1.1" class="ltx_p">In this subsection, we give a detailed proof for Theorem <a href="#Thmtheorem5" title="Theorem 5. ‣ 3 Main results and application ‣ On the Generalization Behavior of Deep Residual Networks From a Dynamical System Perspective" class="ltx_ref"><span class="ltx_text ltx_ref_tag">5</span></a>. The following lemma provides the boundedness of state variables.</p>
</div>
<div id="Thmtheorem12" class="ltx_theorem ltx_theorem_lemma">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="Thmtheorem12.2" class="ltx_text ltx_font_bold">Lemma 12</span></span><span id="Thmtheorem12.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="Thmtheorem12.p1" class="ltx_para">
<p id="Thmtheorem12.p1.1" class="ltx_p"><span id="Thmtheorem12.p1.1.1" class="ltx_text ltx_font_italic">Assume assumptions <math id="Thmtheorem12.p1.m1" class="ltx_Math" alttext="(A_{1})-(A_{3})" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">(</mo><msub><mi>A</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow><mo>−</mo><mrow><mo stretchy="false">(</mo><msub><mi>A</mi><mn>3</mn></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">(A_{1})-(A_{3})</annotation></semantics></math> hold.
Given any learnable parameters <math id="Thmtheorem12.p1.m2" class="ltx_Math" alttext="{\Theta}^{\rm total}_{L}\in\Omega_{{\Theta}^{\rm total}_{L}},\boldsymbol{\Theta}^{\rm total}\in\Omega_{\boldsymbol{\Theta}^{\rm total}}" display="inline" intent=":literal"><semantics><mrow><mrow><msubsup><mi mathvariant="normal">Θ</mi><mi>L</mi><mi>total</mi></msubsup><mo>∈</mo><msub><mi mathvariant="normal">Ω</mi><msubsup><mi mathvariant="normal">Θ</mi><mi>L</mi><mi>total</mi></msubsup></msub></mrow><mo>,</mo><mrow><msup><mi>𝚯</mi><mi>total</mi></msup><mo>∈</mo><msub><mi mathvariant="normal">Ω</mi><msup><mi>𝚯</mi><mi>total</mi></msup></msub></mrow></mrow><annotation encoding="application/x-tex">{\Theta}^{\rm total}_{L}\in\Omega_{{\Theta}^{\rm total}_{L}},\boldsymbol{\Theta}^{\rm total}\in\Omega_{\boldsymbol{\Theta}^{\rm total}}</annotation></semantics></math> and input <math id="Thmtheorem12.p1.m3" class="ltx_Math" alttext="\mathrm{d}\in\mathbb{R}^{n_{\mathrm{d}}}" display="inline" intent=":literal"><semantics><mrow><mi mathvariant="normal">d</mi><mo>∈</mo><msup><mi>ℝ</mi><msub><mi>n</mi><mi mathvariant="normal">d</mi></msub></msup></mrow><annotation encoding="application/x-tex">\mathrm{d}\in\mathbb{R}^{n_{\mathrm{d}}}</annotation></semantics></math> such that <math id="Thmtheorem12.p1.m4" class="ltx_Math" alttext="\|\mathrm{d}\|_{\infty}\leq B_{\rm in}" display="inline" intent=":literal"><semantics><mrow><msub><mrow><mo stretchy="false">‖</mo><mi mathvariant="normal">d</mi><mo stretchy="false">‖</mo></mrow><mi mathvariant="normal">∞</mi></msub><mo>≤</mo><msub><mi>B</mi><mi>in</mi></msub></mrow><annotation encoding="application/x-tex">\|\mathrm{d}\|_{\infty}\leq B_{\rm in}</annotation></semantics></math>.
Then the state variables <math id="Thmtheorem12.p1.m5" class="ltx_Math" alttext="\{\mathrm{x}^{l}(\mathrm{d};{\Theta}^{\rm total}_{L})\}_{l=0}^{L}" display="inline" intent=":literal"><semantics><msubsup><mrow><mo stretchy="false">{</mo><mrow><msup><mi mathvariant="normal">x</mi><mi>l</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi mathvariant="normal">d</mi><mo>,</mo><msubsup><mi mathvariant="normal">Θ</mi><mi>L</mi><mi>total</mi></msubsup><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">}</mo></mrow><mrow><mi>l</mi><mo>=</mo><mn>0</mn></mrow><mi>L</mi></msubsup><annotation encoding="application/x-tex">\{\mathrm{x}^{l}(\mathrm{d};{\Theta}^{\rm total}_{L})\}_{l=0}^{L}</annotation></semantics></math> of discrete-time ResNet (<a href="#S2.E1" title="Equation 1 ‣ 2.2 Residual neural network and its dynamical system modeling ‣ 2 Notations and problem formulation ‣ On the Generalization Behavior of Deep Residual Networks From a Dynamical System Perspective" class="ltx_ref"><span class="ltx_text ltx_ref_tag">1</span></a>) and <math id="Thmtheorem12.p1.m6" class="ltx_Math" alttext="\{\mathbb{x}(t;\mathrm{d};\boldsymbol{\Theta}^{\rm total}):0\leq t\leq T\}" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">{</mo><mrow><mi>𝕩</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo>,</mo><mi mathvariant="normal">d</mi><mo>,</mo><msup><mi>𝚯</mi><mi>total</mi></msup><mo rspace="0.278em" stretchy="false">)</mo></mrow></mrow><mo rspace="0.278em">:</mo><mrow><mn>0</mn><mo>≤</mo><mi>t</mi><mo>≤</mo><mi>T</mi></mrow><mo stretchy="false">}</mo></mrow><annotation encoding="application/x-tex">\{\mathbb{x}(t;\mathrm{d};\boldsymbol{\Theta}^{\rm total}):0\leq t\leq T\}</annotation></semantics></math> of continuous-time ResNet (<a href="#S2.E5" title="Equation 5 ‣ 2.2 Residual neural network and its dynamical system modeling ‣ 2 Notations and problem formulation ‣ On the Generalization Behavior of Deep Residual Networks From a Dynamical System Perspective" class="ltx_ref"><span class="ltx_text ltx_ref_tag">5</span></a>) exist uniquely and satisfy</span></p>
<table id="S4.Ex22" class="ltx_equationgroup ltx_eqn_table">

<tbody id="S4.Ex22X"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S4.Ex22X.m2" class="ltx_Math" alttext="\displaystyle\|\mathrm{x}^{l}(\mathrm{d};{\Theta}^{\rm total}_{L})\|_{\infty}\leq" display="inline" intent=":literal"><semantics><mrow><msub><mrow><mo stretchy="false">‖</mo><mrow><msup><mi>x</mi><mi>l</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>d</mi><mo>,</mo><msubsup><mi mathvariant="normal">Θ</mi><mi>L</mi><mi>total</mi></msubsup><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">‖</mo></mrow><mi mathvariant="normal">∞</mi></msub><mo>≤</mo><mphantom></mphantom></mrow><annotation encoding="application/x-tex">\displaystyle\|\mathrm{x}^{l}(\mathrm{d};{\Theta}^{\rm total}_{L})\|_{\infty}\leq</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S4.Ex22X.m3" class="ltx_Math" alttext="\displaystyle\Big[\mathrm{Lip}_{\psi}B_{\boldsymbol{\Theta}}(B_{\rm in}+1)\!+\!\tau_{L}l(\mathrm{Lip}_{\psi}B_{\boldsymbol{\Theta}}^{2}\!+\!B_{\boldsymbol{\Theta}})\Big]\exp(\tau_{L}l\mathrm{Lip}_{\psi}B_{\boldsymbol{\Theta}}^{2})=:B_{\rm out}^{l}," display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mrow><mo maxsize="1.600em" minsize="1.600em">[</mo><mrow><mrow><msub><mi>Lip</mi><mi>ψ</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>B</mi><mi>𝚯</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>B</mi><mi>in</mi></msub><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0.052em" rspace="0.052em">+</mo><mrow><msub><mi>τ</mi><mi>L</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi>l</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><msub><mi>Lip</mi><mi>ψ</mi></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>B</mi><mi>𝚯</mi><mn>2</mn></msubsup></mrow><mo rspace="0.052em">+</mo><msub><mi>B</mi><mi>𝚯</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo maxsize="1.600em" minsize="1.600em">]</mo></mrow><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>τ</mi><mi>L</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi>l</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>Lip</mi><mi>ψ</mi></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>B</mi><mi>𝚯</mi><mn>2</mn></msubsup></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>=</mo><mphantom></mphantom><mo lspace="0.278em" rspace="0.278em">:</mo><msubsup><mi>B</mi><mi>out</mi><mi>l</mi></msubsup></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\Big[\mathrm{Lip}_{\psi}B_{\boldsymbol{\Theta}}(B_{\rm in}+1)\!+\!\tau_{L}l(\mathrm{Lip}_{\psi}B_{\boldsymbol{\Theta}}^{2}\!+\!B_{\boldsymbol{\Theta}})\Big]\exp(\tau_{L}l\mathrm{Lip}_{\psi}B_{\boldsymbol{\Theta}}^{2})=:B_{\rm out}^{l},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="S4.Ex22Xa"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S4.Ex22Xa.m2" class="ltx_Math" alttext="\displaystyle\|\mathbb{x}(t;\mathrm{d};\boldsymbol{\Theta}^{\rm total})\|_{\infty}\leq" display="inline" intent=":literal"><semantics><mrow><msub><mrow><mo stretchy="false">‖</mo><mrow><mi>𝕩</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo>,</mo><mi>d</mi><mo>,</mo><msup><mi>𝚯</mi><mi>total</mi></msup><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">‖</mo></mrow><mi mathvariant="normal">∞</mi></msub><mo>≤</mo><mphantom></mphantom></mrow><annotation encoding="application/x-tex">\displaystyle\|\mathbb{x}(t;\mathrm{d};\boldsymbol{\Theta}^{\rm total})\|_{\infty}\leq</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S4.Ex22Xa.m3" class="ltx_Math" alttext="\displaystyle\Big[\mathrm{Lip}_{\psi}B_{\boldsymbol{\Theta}}(B_{\rm in}+1)+t(\mathrm{Lip}_{\psi}B_{\boldsymbol{\Theta}}^{2}+B_{\boldsymbol{\Theta}})\Big]\exp(t\mathrm{Lip}_{\psi}B_{\boldsymbol{\Theta}}^{2})=:B_{\rm out}^{t}," display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mrow><mo maxsize="1.600em" minsize="1.600em">[</mo><mrow><mrow><msub><mi>Lip</mi><mi>ψ</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>B</mi><mi>𝚯</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>B</mi><mi>in</mi></msub><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mrow><mi>t</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><msub><mi>Lip</mi><mi>ψ</mi></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>B</mi><mi>𝚯</mi><mn>2</mn></msubsup></mrow><mo>+</mo><msub><mi>B</mi><mi>𝚯</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo maxsize="1.600em" minsize="1.600em">]</mo></mrow><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>t</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>Lip</mi><mi>ψ</mi></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>B</mi><mi>𝚯</mi><mn>2</mn></msubsup></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>=</mo><mphantom></mphantom><mo lspace="0.278em" rspace="0.278em">:</mo><msubsup><mi>B</mi><mi>out</mi><mi>t</mi></msubsup></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\Big[\mathrm{Lip}_{\psi}B_{\boldsymbol{\Theta}}(B_{\rm in}+1)+t(\mathrm{Lip}_{\psi}B_{\boldsymbol{\Theta}}^{2}+B_{\boldsymbol{\Theta}})\Big]\exp(t\mathrm{Lip}_{\psi}B_{\boldsymbol{\Theta}}^{2})=:B_{\rm out}^{t},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="Thmtheorem12.p1.2" class="ltx_p"><span id="Thmtheorem12.p1.2.1" class="ltx_text ltx_font_italic">respectively. Moreover, let <math id="Thmtheorem12.p1.m7" class="ltx_Math" alttext="B_{\rm out}=\Big[\mathrm{Lip}_{\psi}B_{\boldsymbol{\Theta}}(B_{\rm in}+1)+T(\mathrm{Lip}_{\psi}B_{\boldsymbol{\Theta}}^{2}+B_{\boldsymbol{\Theta}})\Big]\exp(T\mathrm{Lip}_{\psi}B_{\boldsymbol{\Theta}}^{2})" display="inline" intent=":literal"><semantics><mrow><msub><mi>B</mi><mi>out</mi></msub><mo>=</mo><mrow><mrow><mo maxsize="1.600em" minsize="1.600em">[</mo><mrow><mrow><msub><mi>Lip</mi><mi>ψ</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>B</mi><mi>𝚯</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>B</mi><mi>in</mi></msub><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mrow><mi>T</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><msub><mi>Lip</mi><mi>ψ</mi></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>B</mi><mi>𝚯</mi><mn>2</mn></msubsup></mrow><mo>+</mo><msub><mi>B</mi><mi>𝚯</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo maxsize="1.600em" minsize="1.600em">]</mo></mrow><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>T</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>Lip</mi><mi>ψ</mi></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>B</mi><mi>𝚯</mi><mn>2</mn></msubsup></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">B_{\rm out}=\Big[\mathrm{Lip}_{\psi}B_{\boldsymbol{\Theta}}(B_{\rm in}+1)+T(\mathrm{Lip}_{\psi}B_{\boldsymbol{\Theta}}^{2}+B_{\boldsymbol{\Theta}})\Big]\exp(T\mathrm{Lip}_{\psi}B_{\boldsymbol{\Theta}}^{2})</annotation></semantics></math>. We then have</span></p>
<table id="S4.Ex23" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S4.Ex23.m1" class="ltx_Math" alttext="\max\{\max_{0\leq l\leq L}\|\mathrm{x}^{l}(\mathrm{d},{\Theta}^{\rm total}_{L})\|_{\infty},\max_{0\leq t\leq T}\|\mathbb{x}(t;\mathrm{d};\boldsymbol{\Theta}^{\rm total})\|_{\infty}\}\leq B_{\rm out}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mi>max</mi><mo>⁡</mo><mrow><mo stretchy="false">{</mo><mrow><munder><mi>max</mi><mrow><mn>0</mn><mo>≤</mo><mi>l</mi><mo>≤</mo><mi>L</mi></mrow></munder><mo>⁡</mo><msub><mrow><mo stretchy="false">‖</mo><mrow><msup><mi>x</mi><mi>l</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>d</mi><mo>,</mo><msubsup><mi mathvariant="normal">Θ</mi><mi>L</mi><mi>total</mi></msubsup><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">‖</mo></mrow><mi mathvariant="normal">∞</mi></msub></mrow><mo>,</mo><mrow><munder><mi>max</mi><mrow><mn>0</mn><mo>≤</mo><mi>t</mi><mo>≤</mo><mi>T</mi></mrow></munder><mo>⁡</mo><msub><mrow><mo stretchy="false">‖</mo><mrow><mi>𝕩</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo>,</mo><mi>d</mi><mo>,</mo><msup><mi>𝚯</mi><mi>total</mi></msup><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">‖</mo></mrow><mi mathvariant="normal">∞</mi></msub></mrow><mo stretchy="false">}</mo></mrow></mrow><mo>≤</mo><msub><mi>B</mi><mi>out</mi></msub></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\max\{\max_{0\leq l\leq L}\|\mathrm{x}^{l}(\mathrm{d},{\Theta}^{\rm total}_{L})\|_{\infty},\max_{0\leq t\leq T}\|\mathbb{x}(t;\mathrm{d};\boldsymbol{\Theta}^{\rm total})\|_{\infty}\}\leq B_{\rm out}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="Thmtheorem12.p1.3" class="ltx_p"><span id="Thmtheorem12.p1.3.1" class="ltx_text ltx_align_floatright"></span></p>
</div>
</div>
<div id="S4.SS2.2" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="S4.SS2.p2" class="ltx_para">
<p id="S4.SS2.p2.1" class="ltx_p"><span id="S4.SS2.p2.1.1" class="ltx_text">The proof is standard and is supplied in supplementary materials.
<span id="S4.SS2.p2.1.1.1" class="ltx_text ltx_align_floatright"></span></span></p>
</div>
</div>
<div id="S4.SS2.p3" class="ltx_para">
<p id="S4.SS2.p3.1" class="ltx_p">The uniform bound <math id="S4.SS2.p3.m1" class="ltx_Math" alttext="B_{\rm out}" display="inline" intent=":literal"><semantics><msub><mi>B</mi><mi>out</mi></msub><annotation encoding="application/x-tex">B_{\rm out}</annotation></semantics></math> for the discrete- and continuous-time states implies a uniform bound <math id="S4.SS2.p3.m2" class="ltx_Math" alttext="B_{\ell}" display="inline" intent=":literal"><semantics><msub><mi>B</mi><mi mathvariant="normal">ℓ</mi></msub><annotation encoding="application/x-tex">B_{\ell}</annotation></semantics></math> and a uniform local Lipschitz coefficient <math id="S4.SS2.p3.m3" class="ltx_Math" alttext="B_{\kappa}" display="inline" intent=":literal"><semantics><msub><mi>B</mi><mi>κ</mi></msub><annotation encoding="application/x-tex">B_{\kappa}</annotation></semantics></math> for the loss funtion <math id="S4.SS2.p3.m4" class="ltx_Math" alttext="\ell" display="inline" intent=":literal"><semantics><mi mathvariant="normal">ℓ</mi><annotation encoding="application/x-tex">\ell</annotation></semantics></math> used in both discrete- and continuous-time settings. These constants depend only on <math id="S4.SS2.p3.m5" class="ltx_Math" alttext="T,B_{\rm in},B_{\boldsymbol{\Theta}},\mathrm{Lip}_{\psi}" display="inline" intent=":literal"><semantics><mrow><mi>T</mi><mo>,</mo><msub><mi>B</mi><mi>in</mi></msub><mo>,</mo><msub><mi>B</mi><mi>𝚯</mi></msub><mo>,</mo><msub><mi>Lip</mi><mi>ψ</mi></msub></mrow><annotation encoding="application/x-tex">T,B_{\rm in},B_{\boldsymbol{\Theta}},\mathrm{Lip}_{\psi}</annotation></semantics></math>, and will be used in proving Theorems <a href="#Thmtheorem5" title="Theorem 5. ‣ 3 Main results and application ‣ On the Generalization Behavior of Deep Residual Networks From a Dynamical System Perspective" class="ltx_ref"><span class="ltx_text ltx_ref_tag">5</span></a> and <a href="#Thmtheorem9" title="Theorem 9. ‣ 3 Main results and application ‣ On the Generalization Behavior of Deep Residual Networks From a Dynamical System Perspective" class="ltx_ref"><span class="ltx_text ltx_ref_tag">9</span></a>.
The next lemma establishes an equivalence property of hypothesis sets <math id="S4.SS2.p3.m6" class="ltx_Math" alttext="{\mathcal{F}}^{L}_{i}" display="inline" intent=":literal"><semantics><msubsup><mi class="ltx_font_mathcaligraphic">ℱ</mi><mi>i</mi><mi>L</mi></msubsup><annotation encoding="application/x-tex">{\mathcal{F}}^{L}_{i}</annotation></semantics></math> (<math id="S4.SS2.p3.m7" class="ltx_Math" alttext="1\leq i\leq n" display="inline" intent=":literal"><semantics><mrow><mn>1</mn><mo>≤</mo><mi>i</mi><mo>≤</mo><mi>n</mi></mrow><annotation encoding="application/x-tex">1\leq i\leq n</annotation></semantics></math>) under assumptions (<math id="S4.SS2.p3.m8" class="ltx_Math" alttext="A_{1}" display="inline" intent=":literal"><semantics><msub><mi>A</mi><mn>1</mn></msub><annotation encoding="application/x-tex">A_{1}</annotation></semantics></math>) (<math id="S4.SS2.p3.m9" class="ltx_Math" alttext="A_{2}" display="inline" intent=":literal"><semantics><msub><mi>A</mi><mn>2</mn></msub><annotation encoding="application/x-tex">A_{2}</annotation></semantics></math>), which plays a key role in proving Theorem <a href="#Thmtheorem5" title="Theorem 5. ‣ 3 Main results and application ‣ On the Generalization Behavior of Deep Residual Networks From a Dynamical System Perspective" class="ltx_ref"><span class="ltx_text ltx_ref_tag">5</span></a>.</p>
</div>
<div id="Thmtheorem13" class="ltx_theorem ltx_theorem_lemma">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="Thmtheorem13.2" class="ltx_text ltx_font_bold">Lemma 13</span></span><span id="Thmtheorem13.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="Thmtheorem13.p1" class="ltx_para">
<p id="Thmtheorem13.p1.1" class="ltx_p"><span id="Thmtheorem13.p1.1.1" class="ltx_text ltx_font_italic">Let assumptions (<math id="Thmtheorem13.p1.m1" class="ltx_Math" alttext="A_{1}" display="inline" intent=":literal"><semantics><msub><mi>A</mi><mn>1</mn></msub><annotation encoding="application/x-tex">A_{1}</annotation></semantics></math>)-(<math id="Thmtheorem13.p1.m2" class="ltx_Math" alttext="A_{2}" display="inline" intent=":literal"><semantics><msub><mi>A</mi><mn>2</mn></msub><annotation encoding="application/x-tex">A_{2}</annotation></semantics></math>) hold.
For any layer <math id="Thmtheorem13.p1.m3" class="ltx_Math" alttext="0\leq l\leq L" display="inline" intent=":literal"><semantics><mrow><mn>0</mn><mo>≤</mo><mi>l</mi><mo>≤</mo><mi>L</mi></mrow><annotation encoding="application/x-tex">0\leq l\leq L</annotation></semantics></math>, the hypothesis sets <math id="Thmtheorem13.p1.m4" class="ltx_Math" alttext="{\mathcal{F}}^{l}_{i}" display="inline" intent=":literal"><semantics><msubsup><mi class="ltx_font_mathcaligraphic">ℱ</mi><mi>i</mi><mi>l</mi></msubsup><annotation encoding="application/x-tex">{\mathcal{F}}^{l}_{i}</annotation></semantics></math> <math id="Thmtheorem13.p1.m5" class="ltx_Math" alttext="(1\leq i\leq n)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>≤</mo><mi>i</mi><mo>≤</mo><mi>n</mi></mrow><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(1\leq i\leq n)</annotation></semantics></math> defined in (<a href="#S2.E4" title="Equation 4 ‣ 2.2 Residual neural network and its dynamical system modeling ‣ 2 Notations and problem formulation ‣ On the Generalization Behavior of Deep Residual Networks From a Dynamical System Perspective" class="ltx_ref"><span class="ltx_text ltx_ref_tag">4</span></a>) satisfy
<math id="Thmtheorem13.p1.m6" class="ltx_Math" alttext="{\mathcal{F}}^{l}_{i_{1}}={\mathcal{F}}^{l}_{i_{2}},i_{1},i_{2}\in\{1,\dots,n\}." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><msubsup><mi class="ltx_font_mathcaligraphic">ℱ</mi><msub><mi>i</mi><mn>1</mn></msub><mi>l</mi></msubsup><mo>=</mo><msubsup><mi class="ltx_font_mathcaligraphic">ℱ</mi><msub><mi>i</mi><mn>2</mn></msub><mi>l</mi></msubsup></mrow><mo>,</mo><msub><mi>i</mi><mn>1</mn></msub><mo>,</mo><mrow><msub><mi>i</mi><mn>2</mn></msub><mo>∈</mo><mrow><mo stretchy="false">{</mo><mn>1</mn><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mi>n</mi><mo stretchy="false">}</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">{\mathcal{F}}^{l}_{i_{1}}={\mathcal{F}}^{l}_{i_{2}},i_{1},i_{2}\in\{1,\dots,n\}.</annotation></semantics></math>

<span id="Thmtheorem13.p1.1.1.1" class="ltx_text ltx_align_floatright"></span></span></p>
</div>
</div>
<div id="S4.SS2.3" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="S4.SS2.p4" class="ltx_para">
<p id="S4.SS2.p4.1" class="ltx_p"><span id="S4.SS2.p4.1.1" class="ltx_text">Let <math id="S4.SS2.p4.m1" class="ltx_Math" alttext="\mathrm{P}_{(ij)}" display="inline" intent=":literal"><semantics><msub><mi>P</mi><mrow><mo stretchy="false">(</mo><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>j</mi></mrow><mo stretchy="false">)</mo></mrow></msub><annotation encoding="application/x-tex">\mathrm{P}_{(ij)}</annotation></semantics></math> be the <math id="S4.SS2.p4.m2" class="ltx_Math" alttext="n\times n" display="inline" intent=":literal"><semantics><mrow><mi>n</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>n</mi></mrow><annotation encoding="application/x-tex">n\times n</annotation></semantics></math> permutation matrix swapping coordinates <math id="S4.SS2.p4.m3" class="ltx_Math" alttext="i" display="inline" intent=":literal"><semantics><mi>i</mi><annotation encoding="application/x-tex">i</annotation></semantics></math> and <math id="S4.SS2.p4.m4" class="ltx_Math" alttext="j" display="inline" intent=":literal"><semantics><mi>j</mi><annotation encoding="application/x-tex">j</annotation></semantics></math>, i.e.,
<math id="S4.SS2.p4.m5" class="ltx_Math" alttext="\mathrm{P}_{(ij)}:=\mathrm{I}+(\mathrm{e}_{(i)}-\mathrm{e}_{(j)})(\mathrm{e}_{(j)}-\mathrm{e}_{(i)})^{\top}," display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>P</mi><mrow><mo stretchy="false">(</mo><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>j</mi></mrow><mo stretchy="false">)</mo></mrow></msub><mo>:=</mo><mrow><mi>I</mi><mo>+</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><msub><mi>e</mi><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></msub><mo>−</mo><msub><mi>e</mi><mrow><mo stretchy="false">(</mo><mi>j</mi><mo stretchy="false">)</mo></mrow></msub></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><msub><mi>e</mi><mrow><mo stretchy="false">(</mo><mi>j</mi><mo stretchy="false">)</mo></mrow></msub><mo>−</mo><msub><mi>e</mi><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></msub></mrow><mo stretchy="false">)</mo></mrow><mo>⊤</mo></msup></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\mathrm{P}_{(ij)}:=\mathrm{I}+(\mathrm{e}_{(i)}-\mathrm{e}_{(j)})(\mathrm{e}_{(j)}-\mathrm{e}_{(i)})^{\top},</annotation></semantics></math>
where <math id="S4.SS2.p4.m6" class="ltx_Math" alttext="\mathrm{e}_{i}" display="inline" intent=":literal"><semantics><msub><mi>e</mi><mi>i</mi></msub><annotation encoding="application/x-tex">\mathrm{e}_{i}</annotation></semantics></math> represents the <math id="S4.SS2.p4.m7" class="ltx_Math" alttext="i" display="inline" intent=":literal"><semantics><mi>i</mi><annotation encoding="application/x-tex">i</annotation></semantics></math>-th standard basis vector in an <math id="S4.SS2.p4.m8" class="ltx_Math" alttext="n" display="inline" intent=":literal"><semantics><mi>n</mi><annotation encoding="application/x-tex">n</annotation></semantics></math>-dimensional space, with 1 at the <math id="S4.SS2.p4.m9" class="ltx_Math" alttext="i" display="inline" intent=":literal"><semantics><mi>i</mi><annotation encoding="application/x-tex">i</annotation></semantics></math>-th position and 0 elsewhere, <math id="S4.SS2.p4.m10" class="ltx_Math" alttext="\mathrm{I}\in\mathbb{R}^{n\times n}" display="inline" intent=":literal"><semantics><mrow><mi>I</mi><mo>∈</mo><msup><mi>ℝ</mi><mrow><mi>n</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>n</mi></mrow></msup></mrow><annotation encoding="application/x-tex">\mathrm{I}\in\mathbb{R}^{n\times n}</annotation></semantics></math> is the identity matrix.
Denote <math id="S4.SS2.p4.m11" class="ltx_Math" alttext="{\Theta}_{l}:=\left({\Theta}^{0}_{L},{\Theta}^{1}_{L},\ldots,{\Theta}^{l-1}_{L}\right)\in\mathcal{E}^{l},{\Theta}^{\rm total}_{l}:=({\Theta}^{\rm pre},{\Theta}_{l})\in\mathcal{E}^{\rm pre}\times\mathcal{E}^{l}" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi mathvariant="normal">Θ</mi><mi>l</mi></msub><mo>:=</mo><mrow><mo>(</mo><msubsup><mi mathvariant="normal">Θ</mi><mi>L</mi><mn>0</mn></msubsup><mo>,</mo><msubsup><mi mathvariant="normal">Θ</mi><mi>L</mi><mn>1</mn></msubsup><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msubsup><mi mathvariant="normal">Θ</mi><mi>L</mi><mrow><mi>l</mi><mo>−</mo><mn>1</mn></mrow></msubsup><mo>)</mo></mrow><mo>∈</mo><msup><mi class="ltx_font_mathcaligraphic">ℰ</mi><mi>l</mi></msup></mrow><mo>,</mo><mrow><msubsup><mi mathvariant="normal">Θ</mi><mi>l</mi><mi>total</mi></msubsup><mo>:=</mo><mrow><mo stretchy="false">(</mo><msup><mi mathvariant="normal">Θ</mi><mi>pre</mi></msup><mo>,</mo><msub><mi mathvariant="normal">Θ</mi><mi>l</mi></msub><mo stretchy="false">)</mo></mrow><mo>∈</mo><mrow><msup><mi class="ltx_font_mathcaligraphic">ℰ</mi><mi>pre</mi></msup><mo lspace="0.222em" rspace="0.222em">×</mo><msup><mi class="ltx_font_mathcaligraphic">ℰ</mi><mi>l</mi></msup></mrow></mrow></mrow><annotation encoding="application/x-tex">{\Theta}_{l}:=\left({\Theta}^{0}_{L},{\Theta}^{1}_{L},\ldots,{\Theta}^{l-1}_{L}\right)\in\mathcal{E}^{l},{\Theta}^{\rm total}_{l}:=({\Theta}^{\rm pre},{\Theta}_{l})\in\mathcal{E}^{\rm pre}\times\mathcal{E}^{l}</annotation></semantics></math>.
We show by induction on <math id="S4.SS2.p4.m12" class="ltx_Math" alttext="l" display="inline" intent=":literal"><semantics><mi>l</mi><annotation encoding="application/x-tex">l</annotation></semantics></math> that, for each choice of parameters <math id="S4.SS2.p4.m13" class="ltx_Math" alttext="\Theta^{\rm total}_{l}\in\Omega_{{\Theta}^{\rm total}_{l}}" display="inline" intent=":literal"><semantics><mrow><msubsup><mi mathvariant="normal">Θ</mi><mi>l</mi><mi>total</mi></msubsup><mo>∈</mo><msub><mi mathvariant="normal">Ω</mi><msubsup><mi mathvariant="normal">Θ</mi><mi>l</mi><mi>total</mi></msubsup></msub></mrow><annotation encoding="application/x-tex">\Theta^{\rm total}_{l}\in\Omega_{{\Theta}^{\rm total}_{l}}</annotation></semantics></math> and indices <math id="S4.SS2.p4.m14" class="ltx_Math" alttext="i_{1},i_{2}\in\{1,\dots,n\}" display="inline" intent=":literal"><semantics><mrow><msub><mi>i</mi><mn>1</mn></msub><mo>,</mo><mrow><msub><mi>i</mi><mn>2</mn></msub><mo>∈</mo><mrow><mo stretchy="false">{</mo><mn>1</mn><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mi>n</mi><mo stretchy="false">}</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">i_{1},i_{2}\in\{1,\dots,n\}</annotation></semantics></math>, there is a modified parameter <math id="S4.SS2.p4.m15" class="ltx_Math" alttext="\widetilde{\Theta}^{\rm total}_{l}\in\Omega_{{\Theta}^{\rm total}_{l}}" display="inline" intent=":literal"><semantics><mrow><msubsup><mover accent="true"><mi mathvariant="normal">Θ</mi><mo>~</mo></mover><mi>l</mi><mi>total</mi></msubsup><mo>∈</mo><msub><mi mathvariant="normal">Ω</mi><msubsup><mi mathvariant="normal">Θ</mi><mi>l</mi><mi>total</mi></msubsup></msub></mrow><annotation encoding="application/x-tex">\widetilde{\Theta}^{\rm total}_{l}\in\Omega_{{\Theta}^{\rm total}_{l}}</annotation></semantics></math> such that</span></p>
<table id="S4.Ex24" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S4.Ex24.m1" class="ltx_Math" alttext="\mathrm{x}^{l}(\mathrm{d};\tilde{\Theta}^{\rm total}_{l})=\mathrm{P}_{(i_{1}i_{2})}\mathrm{x}^{l}(\mathrm{d};{\Theta}^{\rm total}_{l})." display="block" intent=":literal"><semantics><mrow><mrow><mrow><msup><mi>x</mi><mi>l</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>d</mi><mo>,</mo><msubsup><mover accent="true"><mi mathvariant="normal">Θ</mi><mo>~</mo></mover><mi>l</mi><mi>total</mi></msubsup><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><msub><mi>P</mi><mrow><mo stretchy="false">(</mo><mrow><msub><mi>i</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>i</mi><mn>2</mn></msub></mrow><mo stretchy="false">)</mo></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msup><mi>x</mi><mi>l</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>d</mi><mo>,</mo><msubsup><mi mathvariant="normal">Θ</mi><mi>l</mi><mi>total</mi></msubsup><mo stretchy="false">)</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\mathrm{x}^{l}(\mathrm{d};\tilde{\Theta}^{\rm total}_{l})=\mathrm{P}_{(i_{1}i_{2})}\mathrm{x}^{l}(\mathrm{d};{\Theta}^{\rm total}_{l}).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S4.SS2.p4.2" class="ltx_p"><span id="S4.SS2.p4.2.1" class="ltx_text">Since <math id="S4.SS2.p4.m16" class="ltx_Math" alttext="\mathrm{P}_{(i_{1}i_{2})}^{2}=\mathrm{I}" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>P</mi><mrow><mo stretchy="false">(</mo><mrow><msub><mi>i</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>i</mi><mn>2</mn></msub></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msubsup><mo>=</mo><mi>I</mi></mrow><annotation encoding="application/x-tex">\mathrm{P}_{(i_{1}i_{2})}^{2}=\mathrm{I}</annotation></semantics></math>, this establishes a bijection between the <math id="S4.SS2.p4.m17" class="ltx_Math" alttext="i_{1}" display="inline" intent=":literal"><semantics><msub><mi>i</mi><mn>1</mn></msub><annotation encoding="application/x-tex">i_{1}</annotation></semantics></math>‐th and <math id="S4.SS2.p4.m18" class="ltx_Math" alttext="i_{2}" display="inline" intent=":literal"><semantics><msub><mi>i</mi><mn>2</mn></msub><annotation encoding="application/x-tex">i_{2}</annotation></semantics></math>‐th output functions, hence <math id="S4.SS2.p4.m19" class="ltx_Math" alttext="\mathcal{F}^{l}_{i_{1}}=\mathcal{F}^{l}_{i_{2}}" display="inline" intent=":literal"><semantics><mrow><msubsup><mi class="ltx_font_mathcaligraphic">ℱ</mi><msub><mi>i</mi><mn>1</mn></msub><mi>l</mi></msubsup><mo>=</mo><msubsup><mi class="ltx_font_mathcaligraphic">ℱ</mi><msub><mi>i</mi><mn>2</mn></msub><mi>l</mi></msubsup></mrow><annotation encoding="application/x-tex">\mathcal{F}^{l}_{i_{1}}=\mathcal{F}^{l}_{i_{2}}</annotation></semantics></math>.</span></p>
</div>
<div id="S4.SS2.p5" class="ltx_para">
<p id="S4.SS2.p5.1" class="ltx_p"><span id="S4.SS2.p5.1.1" class="ltx_text">For the preprocessing layer, if <math id="S4.SS2.p5.m1" class="ltx_Math" alttext="{\Theta}^{\rm pre}=(\mathrm{U},\mathrm{a})\in\mathcal{E}^{\rm pre}" display="inline" intent=":literal"><semantics><mrow><msup><mi mathvariant="normal">Θ</mi><mi>pre</mi></msup><mo>=</mo><mrow><mo stretchy="false">(</mo><mi>U</mi><mo>,</mo><mi>a</mi><mo stretchy="false">)</mo></mrow><mo>∈</mo><msup><mi class="ltx_font_mathcaligraphic">ℰ</mi><mi>pre</mi></msup></mrow><annotation encoding="application/x-tex">{\Theta}^{\rm pre}=(\mathrm{U},\mathrm{a})\in\mathcal{E}^{\rm pre}</annotation></semantics></math> and <math id="S4.SS2.p5.m2" class="ltx_Math" alttext="i_{1},i_{2}\in\{1,\ldots,n\}" display="inline" intent=":literal"><semantics><mrow><msub><mi>i</mi><mn>1</mn></msub><mo>,</mo><mrow><msub><mi>i</mi><mn>2</mn></msub><mo>∈</mo><mrow><mo stretchy="false">{</mo><mn>1</mn><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mi>n</mi><mo stretchy="false">}</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">i_{1},i_{2}\in\{1,\ldots,n\}</annotation></semantics></math>, let <math id="S4.SS2.p5.m3" class="ltx_Math" alttext="\tilde{\Theta}^{\rm pre}=(\mathrm{P}_{(i_{1}i_{2})}\mathrm{U},\mathrm{P}_{(i_{1}i_{2})}\mathrm{a})\in\mathcal{E}^{\rm pre}" display="inline" intent=":literal"><semantics><mrow><msup><mover accent="true"><mi mathvariant="normal">Θ</mi><mo>~</mo></mover><mi>pre</mi></msup><mo>=</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>P</mi><mrow><mo stretchy="false">(</mo><mrow><msub><mi>i</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>i</mi><mn>2</mn></msub></mrow><mo stretchy="false">)</mo></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mi>U</mi></mrow><mo>,</mo><mrow><msub><mi>P</mi><mrow><mo stretchy="false">(</mo><mrow><msub><mi>i</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>i</mi><mn>2</mn></msub></mrow><mo stretchy="false">)</mo></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mi>a</mi></mrow><mo stretchy="false">)</mo></mrow><mo>∈</mo><msup><mi class="ltx_font_mathcaligraphic">ℰ</mi><mi>pre</mi></msup></mrow><annotation encoding="application/x-tex">\tilde{\Theta}^{\rm pre}=(\mathrm{P}_{(i_{1}i_{2})}\mathrm{U},\mathrm{P}_{(i_{1}i_{2})}\mathrm{a})\in\mathcal{E}^{\rm pre}</annotation></semantics></math>.
Then it is easy to see</span></p>
<table id="S4.Ex25" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S4.Ex25.m1" class="ltx_Math" alttext="\mathrm{x}^{0}(\mathrm{d};\tilde{\Theta}^{\rm pre})\!=\!\psi\circ(\mathrm{P}_{(i_{1}i_{2})}\mathrm{U}\mathrm{d}+\mathrm{P}_{(i_{1}i_{2})}\mathrm{a})\!=\!\mathrm{P}_{(i_{1}i_{2})}\psi\circ(\mathrm{U}\mathrm{d}+\mathrm{a})\!=\!\mathrm{P}_{(i_{1}i_{2})}\mathrm{x}^{0}(\mathrm{d};{\Theta}^{\rm pre}),\ \forall\mathrm{d}\in\mathbb{R}^{n_{\mathrm{d}}}," display="block" intent=":literal"><semantics><mrow><mrow><mrow><mrow><msup><mi>x</mi><mn>0</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>d</mi><mo>,</mo><msup><mover accent="true"><mi mathvariant="normal">Θ</mi><mo>~</mo></mover><mi>pre</mi></msup><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0.108em" rspace="0.108em">=</mo><mrow><mi>ψ</mi><mo lspace="0.222em" rspace="0.222em">∘</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><msub><mi>P</mi><mrow><mo stretchy="false">(</mo><mrow><msub><mi>i</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>i</mi><mn>2</mn></msub></mrow><mo stretchy="false">)</mo></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mi>Ud</mi></mrow><mo>+</mo><mrow><msub><mi>P</mi><mrow><mo stretchy="false">(</mo><mrow><msub><mi>i</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>i</mi><mn>2</mn></msub></mrow><mo stretchy="false">)</mo></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mi>a</mi></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0.108em" rspace="0.108em">=</mo><mrow><mrow><msub><mi>P</mi><mrow><mo stretchy="false">(</mo><mrow><msub><mi>i</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>i</mi><mn>2</mn></msub></mrow><mo stretchy="false">)</mo></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mi>ψ</mi></mrow><mo lspace="0.222em" rspace="0.222em">∘</mo><mrow><mo stretchy="false">(</mo><mrow><mi>Ud</mi><mo>+</mo><mi>a</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0.108em" rspace="0.108em">=</mo><mrow><msub><mi>P</mi><mrow><mo stretchy="false">(</mo><mrow><msub><mi>i</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>i</mi><mn>2</mn></msub></mrow><mo stretchy="false">)</mo></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msup><mi>x</mi><mn>0</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>d</mi><mo>,</mo><msup><mi mathvariant="normal">Θ</mi><mi>pre</mi></msup><mo stretchy="false">)</mo></mrow></mrow></mrow><mo rspace="0.667em">,</mo><mrow><mrow><mo rspace="0.167em">∀</mo><mi>d</mi></mrow><mo>∈</mo><msup><mi>ℝ</mi><msub><mi>n</mi><mi>d</mi></msub></msup></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\mathrm{x}^{0}(\mathrm{d};\tilde{\Theta}^{\rm pre})\!=\!\psi\circ(\mathrm{P}_{(i_{1}i_{2})}\mathrm{U}\mathrm{d}+\mathrm{P}_{(i_{1}i_{2})}\mathrm{a})\!=\!\mathrm{P}_{(i_{1}i_{2})}\psi\circ(\mathrm{U}\mathrm{d}+\mathrm{a})\!=\!\mathrm{P}_{(i_{1}i_{2})}\mathrm{x}^{0}(\mathrm{d};{\Theta}^{\rm pre}),\ \forall\mathrm{d}\in\mathbb{R}^{n_{\mathrm{d}}},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S4.SS2.p5.2" class="ltx_p"><span id="S4.SS2.p5.2.1" class="ltx_text">by the element-wise action of <math id="S4.SS2.p5.m4" class="ltx_Math" alttext="\psi" display="inline" intent=":literal"><semantics><mi>ψ</mi><annotation encoding="application/x-tex">\psi</annotation></semantics></math>. For <math id="S4.SS2.p5.m5" class="ltx_Math" alttext="l=0" display="inline" intent=":literal"><semantics><mrow><mi>l</mi><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">l=0</annotation></semantics></math> and given parameter <math id="S4.SS2.p5.m6" class="ltx_Math" alttext="{\Theta}^{\rm total}_{0}=((\mathrm{U},\mathrm{a}),(\mathrm{V}^{0},\mathrm{W}^{0},\mathrm{b}^{0},\mathrm{a}^{0}))\in{\Theta}^{\rm total}_{0}" display="inline" intent=":literal"><semantics><mrow><msubsup><mi mathvariant="normal">Θ</mi><mn>0</mn><mi>total</mi></msubsup><mo>=</mo><mrow><mo stretchy="false">(</mo><mrow><mo stretchy="false">(</mo><mi>U</mi><mo>,</mo><mi>a</mi><mo stretchy="false">)</mo></mrow><mo>,</mo><mrow><mo stretchy="false">(</mo><msup><mi>V</mi><mn>0</mn></msup><mo>,</mo><msup><mi>W</mi><mn>0</mn></msup><mo>,</mo><msup><mi>b</mi><mn>0</mn></msup><mo>,</mo><msup><mi>a</mi><mn>0</mn></msup><mo stretchy="false">)</mo></mrow><mo stretchy="false">)</mo></mrow><mo>∈</mo><msubsup><mi mathvariant="normal">Θ</mi><mn>0</mn><mi>total</mi></msubsup></mrow><annotation encoding="application/x-tex">{\Theta}^{\rm total}_{0}=((\mathrm{U},\mathrm{a}),(\mathrm{V}^{0},\mathrm{W}^{0},\mathrm{b}^{0},\mathrm{a}^{0}))\in{\Theta}^{\rm total}_{0}</annotation></semantics></math> and <math id="S4.SS2.p5.m7" class="ltx_Math" alttext="i_{1},i_{2}\in\{1,\ldots,n\}" display="inline" intent=":literal"><semantics><mrow><msub><mi>i</mi><mn>1</mn></msub><mo>,</mo><mrow><msub><mi>i</mi><mn>2</mn></msub><mo>∈</mo><mrow><mo stretchy="false">{</mo><mn>1</mn><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mi>n</mi><mo stretchy="false">}</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">i_{1},i_{2}\in\{1,\ldots,n\}</annotation></semantics></math>, let <math id="S4.SS2.p5.m8" class="ltx_Math" alttext="\tilde{{\Theta}}_{0}^{\rm total}=((\tilde{\mathrm{U}},\tilde{\mathrm{a}}),(\tilde{\mathrm{V}}^{0},\tilde{\mathrm{W}}^{0},\mathrm{b}^{0},\tilde{\mathrm{c}}^{0}))\in\Omega_{{\Theta}^{\rm total}_{0}}" display="inline" intent=":literal"><semantics><mrow><msubsup><mover accent="true"><mi mathvariant="normal">Θ</mi><mo>~</mo></mover><mn>0</mn><mi>total</mi></msubsup><mo>=</mo><mrow><mo stretchy="false">(</mo><mrow><mo stretchy="false">(</mo><mover accent="true"><mi>U</mi><mo>~</mo></mover><mo>,</mo><mover accent="true"><mi>a</mi><mo>~</mo></mover><mo stretchy="false">)</mo></mrow><mo>,</mo><mrow><mo stretchy="false">(</mo><msup><mover accent="true"><mi>V</mi><mo>~</mo></mover><mn>0</mn></msup><mo>,</mo><msup><mover accent="true"><mi>W</mi><mo>~</mo></mover><mn>0</mn></msup><mo>,</mo><msup><mi>b</mi><mn>0</mn></msup><mo>,</mo><msup><mover accent="true"><mi>c</mi><mo>~</mo></mover><mn>0</mn></msup><mo stretchy="false">)</mo></mrow><mo stretchy="false">)</mo></mrow><mo>∈</mo><msub><mi mathvariant="normal">Ω</mi><msubsup><mi mathvariant="normal">Θ</mi><mn>0</mn><mi>total</mi></msubsup></msub></mrow><annotation encoding="application/x-tex">\tilde{{\Theta}}_{0}^{\rm total}=((\tilde{\mathrm{U}},\tilde{\mathrm{a}}),(\tilde{\mathrm{V}}^{0},\tilde{\mathrm{W}}^{0},\mathrm{b}^{0},\tilde{\mathrm{c}}^{0}))\in\Omega_{{\Theta}^{\rm total}_{0}}</annotation></semantics></math>, where</span></p>
<table id="S4.Ex26" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S4.Ex26.m1" class="ltx_Math" alttext="\tilde{\mathrm{U}}=\mathrm{P}_{(i_{1}i_{2})}\mathrm{U},\ \tilde{\mathrm{a}}=\mathrm{P}_{(i_{1}i_{2})}\mathrm{a},\ \tilde{\mathrm{V}}^{0}=\mathrm{V}^{0}\mathrm{P}_{(i_{1}i_{2})},\ \tilde{\mathrm{W}}^{0}=\mathrm{P}_{(i_{1}i_{2})}\mathrm{W}^{0},\ \tilde{\mathrm{c}}^{0}=\mathrm{P}_{(i_{1}i_{2})}\mathrm{c}^{0}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mover accent="true"><mi>U</mi><mo>~</mo></mover><mo>=</mo><mrow><msub><mi>P</mi><mrow><mo stretchy="false">(</mo><mrow><msub><mi>i</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>i</mi><mn>2</mn></msub></mrow><mo stretchy="false">)</mo></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mi>U</mi></mrow></mrow><mo rspace="0.667em">,</mo><mrow><mover accent="true"><mi>a</mi><mo>~</mo></mover><mo>=</mo><mrow><msub><mi>P</mi><mrow><mo stretchy="false">(</mo><mrow><msub><mi>i</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>i</mi><mn>2</mn></msub></mrow><mo stretchy="false">)</mo></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mi>a</mi></mrow></mrow><mo rspace="0.667em">,</mo><mrow><msup><mover accent="true"><mi>V</mi><mo>~</mo></mover><mn>0</mn></msup><mo>=</mo><mrow><msup><mi>V</mi><mn>0</mn></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>P</mi><mrow><mo stretchy="false">(</mo><mrow><msub><mi>i</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>i</mi><mn>2</mn></msub></mrow><mo stretchy="false">)</mo></mrow></msub></mrow></mrow><mo rspace="0.667em">,</mo><mrow><msup><mover accent="true"><mi>W</mi><mo>~</mo></mover><mn>0</mn></msup><mo>=</mo><mrow><msub><mi>P</mi><mrow><mo stretchy="false">(</mo><mrow><msub><mi>i</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>i</mi><mn>2</mn></msub></mrow><mo stretchy="false">)</mo></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msup><mi>W</mi><mn>0</mn></msup></mrow></mrow><mo rspace="0.667em">,</mo><mrow><msup><mover accent="true"><mi>c</mi><mo>~</mo></mover><mn>0</mn></msup><mo>=</mo><mrow><msub><mi>P</mi><mrow><mo stretchy="false">(</mo><mrow><msub><mi>i</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>i</mi><mn>2</mn></msub></mrow><mo stretchy="false">)</mo></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msup><mi>c</mi><mn>0</mn></msup></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\tilde{\mathrm{U}}=\mathrm{P}_{(i_{1}i_{2})}\mathrm{U},\ \tilde{\mathrm{a}}=\mathrm{P}_{(i_{1}i_{2})}\mathrm{a},\ \tilde{\mathrm{V}}^{0}=\mathrm{V}^{0}\mathrm{P}_{(i_{1}i_{2})},\ \tilde{\mathrm{W}}^{0}=\mathrm{P}_{(i_{1}i_{2})}\mathrm{W}^{0},\ \tilde{\mathrm{c}}^{0}=\mathrm{P}_{(i_{1}i_{2})}\mathrm{c}^{0}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S4.SS2.p5.3" class="ltx_p"><span id="S4.SS2.p5.3.1" class="ltx_text">Then we have</span></p>
<table id="S4.Ex27" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S4.Ex27.m1" class="ltx_Math" alttext="\mathrm{x}^{0}(\mathrm{d};\tilde{\Theta}^{\rm pre})=\psi\circ(\mathrm{P}_{(i_{1}i_{2})}\mathrm{U}\mathrm{d}+\mathrm{P}_{(i_{1}i_{2})}\mathrm{a})=\mathrm{P}_{(i_{1}i_{2})}\psi\circ(\mathrm{U}\mathrm{d}+\mathrm{a})=\mathrm{P}_{(i_{1}i_{2})}\mathrm{x}^{0}(\mathrm{d};{\Theta}^{\rm pre})" display="block" intent=":literal"><semantics><mrow><mrow><msup><mi>x</mi><mn>0</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>d</mi><mo>,</mo><msup><mover accent="true"><mi mathvariant="normal">Θ</mi><mo>~</mo></mover><mi>pre</mi></msup><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mi>ψ</mi><mo lspace="0.222em" rspace="0.222em">∘</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><msub><mi>P</mi><mrow><mo stretchy="false">(</mo><mrow><msub><mi>i</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>i</mi><mn>2</mn></msub></mrow><mo stretchy="false">)</mo></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mi>Ud</mi></mrow><mo>+</mo><mrow><msub><mi>P</mi><mrow><mo stretchy="false">(</mo><mrow><msub><mi>i</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>i</mi><mn>2</mn></msub></mrow><mo stretchy="false">)</mo></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mi>a</mi></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mrow><msub><mi>P</mi><mrow><mo stretchy="false">(</mo><mrow><msub><mi>i</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>i</mi><mn>2</mn></msub></mrow><mo stretchy="false">)</mo></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mi>ψ</mi></mrow><mo lspace="0.222em" rspace="0.222em">∘</mo><mrow><mo stretchy="false">(</mo><mrow><mi>Ud</mi><mo>+</mo><mi>a</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><msub><mi>P</mi><mrow><mo stretchy="false">(</mo><mrow><msub><mi>i</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>i</mi><mn>2</mn></msub></mrow><mo stretchy="false">)</mo></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msup><mi>x</mi><mn>0</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>d</mi><mo>,</mo><msup><mi mathvariant="normal">Θ</mi><mi>pre</mi></msup><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\mathrm{x}^{0}(\mathrm{d};\tilde{\Theta}^{\rm pre})=\psi\circ(\mathrm{P}_{(i_{1}i_{2})}\mathrm{U}\mathrm{d}+\mathrm{P}_{(i_{1}i_{2})}\mathrm{a})=\mathrm{P}_{(i_{1}i_{2})}\psi\circ(\mathrm{U}\mathrm{d}+\mathrm{a})=\mathrm{P}_{(i_{1}i_{2})}\mathrm{x}^{0}(\mathrm{d};{\Theta}^{\rm pre})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S4.SS2.p5.4" class="ltx_p"><span id="S4.SS2.p5.4.1" class="ltx_text">and</span></p>
<table id="S4.Ex28" class="ltx_equationgroup ltx_eqn_table">

<tbody id="S4.Ex28X"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S4.Ex28X.m2" class="ltx_Math" alttext="\displaystyle\mathrm{x}^{1}_{i_{1}}(\mathrm{d};\tilde{\Theta}^{\rm total}_{0})=" display="inline" intent=":literal"><semantics><mrow><mrow><msubsup><mi>x</mi><msub><mi>i</mi><mn>1</mn></msub><mn>1</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>d</mi><mo>,</mo><msubsup><mover accent="true"><mi mathvariant="normal">Θ</mi><mo>~</mo></mover><mn>0</mn><mi>total</mi></msubsup><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mphantom></mphantom></mrow><annotation encoding="application/x-tex">\displaystyle\mathrm{x}^{1}_{i_{1}}(\mathrm{d};\tilde{\Theta}^{\rm total}_{0})=</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S4.Ex28X.m3" class="ltx_Math" alttext="\displaystyle\mathrm{x}^{0}_{i_{1}}(\mathrm{d};\tilde{\Theta}^{\rm pre})+\tau_{L}\Big(\tilde{\mathrm{W}}^{0}_{i_{1},:}\psi\circ(\tilde{\mathrm{V}}^{0}\mathrm{x}^{0}(\mathrm{d};\tilde{\Theta}^{\rm pre})+\mathrm{b}^{0})+\tilde{\mathrm{c}}^{0}_{i_{1}}\Big)" display="inline" intent=":literal"><semantics><mrow><mi>x</mi><msup><mrow></mrow><mn>0</mn></msup><msub><mrow></mrow><msub><mi>i</mi><mn>1</mn></msub></msub><mo stretchy="false">(</mo><mi>d</mi><mo>;</mo><mover accent="true"><mi mathvariant="normal">Θ</mi><mo>~</mo></mover><msup><mrow></mrow><mi>pre</mi></msup><mo stretchy="false">)</mo><mo>+</mo><mi>τ</mi><msub><mrow></mrow><mi>L</mi></msub><mo maxsize="1.600em" minsize="1.600em">(</mo><mover accent="true"><mi>W</mi><mo>~</mo></mover><msup><mrow></mrow><mn>0</mn></msup><msub><mrow></mrow><mrow><mi>i</mi><msub><mrow></mrow><mn>1</mn></msub><mo>,</mo><mo>:</mo></mrow></msub><mi>ψ</mi><mo lspace="0.222em" rspace="0.222em">∘</mo><mo stretchy="false">(</mo><mover accent="true"><mi>V</mi><mo>~</mo></mover><msup><mrow></mrow><mn>0</mn></msup><mi>x</mi><msup><mrow></mrow><mn>0</mn></msup><mo stretchy="false">(</mo><mi>d</mi><mo>;</mo><mover accent="true"><mi mathvariant="normal">Θ</mi><mo>~</mo></mover><msup><mrow></mrow><mi>pre</mi></msup><mo stretchy="false">)</mo><mo>+</mo><mi>b</mi><msup><mrow></mrow><mn>0</mn></msup><mo stretchy="false">)</mo><mo>+</mo><mover accent="true"><mi>c</mi><mo>~</mo></mover><msup><mrow></mrow><mn>0</mn></msup><msub><mrow></mrow><msub><mi>i</mi><mn>1</mn></msub></msub><mo maxsize="1.600em" minsize="1.600em">)</mo></mrow><annotation encoding="application/x-tex">\displaystyle\mathrm{x}^{0}_{i_{1}}(\mathrm{d};\tilde{\Theta}^{\rm pre})+\tau_{L}\Big(\tilde{\mathrm{W}}^{0}_{i_{1},:}\psi\circ(\tilde{\mathrm{V}}^{0}\mathrm{x}^{0}(\mathrm{d};\tilde{\Theta}^{\rm pre})+\mathrm{b}^{0})+\tilde{\mathrm{c}}^{0}_{i_{1}}\Big)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="S4.Ex28Xa"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S4.Ex28Xa.m2" class="ltx_Math" alttext="\displaystyle=" display="inline" intent=":literal"><semantics><mo>=</mo><annotation encoding="application/x-tex">\displaystyle=</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S4.Ex28Xa.m3" class="ltx_Math" alttext="\displaystyle\mathrm{x}^{0}_{i_{2}}(\mathrm{d};{\Theta}^{\rm pre})+\tau_{L}\Big({\mathrm{W}}^{0}_{i_{2},:}\psi\circ(\mathrm{V}^{0}\mathrm{x}^{0}(\mathrm{d};{\Theta}^{\rm pre})+\mathrm{b}^{0})+\mathrm{c}^{0}_{i_{2}}\Big)" display="inline" intent=":literal"><semantics><mrow><mi>x</mi><msup><mrow></mrow><mn>0</mn></msup><msub><mrow></mrow><msub><mi>i</mi><mn>2</mn></msub></msub><mo stretchy="false">(</mo><mi>d</mi><mo>;</mo><mi mathvariant="normal">Θ</mi><msup><mrow></mrow><mi>pre</mi></msup><mo stretchy="false">)</mo><mo>+</mo><mi>τ</mi><msub><mrow></mrow><mi>L</mi></msub><mo maxsize="1.600em" minsize="1.600em">(</mo><mi>W</mi><msup><mrow></mrow><mn>0</mn></msup><msub><mrow></mrow><mrow><mi>i</mi><msub><mrow></mrow><mn>2</mn></msub><mo>,</mo><mo>:</mo></mrow></msub><mi>ψ</mi><mo lspace="0.222em" rspace="0.222em">∘</mo><mo stretchy="false">(</mo><mi>V</mi><msup><mrow></mrow><mn>0</mn></msup><mi>x</mi><msup><mrow></mrow><mn>0</mn></msup><mo stretchy="false">(</mo><mi>d</mi><mo>;</mo><mi mathvariant="normal">Θ</mi><msup><mrow></mrow><mi>pre</mi></msup><mo stretchy="false">)</mo><mo>+</mo><mi>b</mi><msup><mrow></mrow><mn>0</mn></msup><mo stretchy="false">)</mo><mo>+</mo><mi>c</mi><msup><mrow></mrow><mn>0</mn></msup><msub><mrow></mrow><msub><mi>i</mi><mn>2</mn></msub></msub><mo maxsize="1.600em" minsize="1.600em">)</mo></mrow><annotation encoding="application/x-tex">\displaystyle\mathrm{x}^{0}_{i_{2}}(\mathrm{d};{\Theta}^{\rm pre})+\tau_{L}\Big({\mathrm{W}}^{0}_{i_{2},:}\psi\circ(\mathrm{V}^{0}\mathrm{x}^{0}(\mathrm{d};{\Theta}^{\rm pre})+\mathrm{b}^{0})+\mathrm{c}^{0}_{i_{2}}\Big)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="S4.Ex28Xb"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S4.Ex28Xb.m2" class="ltx_Math" alttext="\displaystyle=" display="inline" intent=":literal"><semantics><mo>=</mo><annotation encoding="application/x-tex">\displaystyle=</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S4.Ex28Xb.m3" class="ltx_Math" alttext="\displaystyle\mathrm{x}^{1}_{i_{2}}(\mathrm{d};{\Theta}^{\rm total}_{0}),\ \forall\mathrm{d}\in\mathbb{R}^{n_{\mathrm{d}}}," display="inline" intent=":literal"><semantics><mrow><mrow><mrow><msubsup><mi>x</mi><msub><mi>i</mi><mn>2</mn></msub><mn>1</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>d</mi><mo>,</mo><msubsup><mi mathvariant="normal">Θ</mi><mn>0</mn><mi>total</mi></msubsup><mo stretchy="false">)</mo></mrow></mrow><mo rspace="0.667em">,</mo><mrow><mrow><mo rspace="0.167em">∀</mo><mi>d</mi></mrow><mo>∈</mo><msup><mi>ℝ</mi><msub><mi>n</mi><mi>d</mi></msub></msup></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\mathrm{x}^{1}_{i_{2}}(\mathrm{d};{\Theta}^{\rm total}_{0}),\ \forall\mathrm{d}\in\mathbb{R}^{n_{\mathrm{d}}},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S4.SS2.p5.5" class="ltx_p"><span id="S4.SS2.p5.5.1" class="ltx_text">owing to the definition of <math id="S4.SS2.p5.m9" class="ltx_Math" alttext="{\mathcal{F}}^{l}_{i}" display="inline" intent=":literal"><semantics><msubsup><mi class="ltx_font_mathcaligraphic">ℱ</mi><mi>i</mi><mi>l</mi></msubsup><annotation encoding="application/x-tex">{\mathcal{F}}^{l}_{i}</annotation></semantics></math> (for <math id="S4.SS2.p5.m10" class="ltx_Math" alttext="l=0" display="inline" intent=":literal"><semantics><mrow><mi>l</mi><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">l=0</annotation></semantics></math>) in (<a href="#S2.E4" title="Equation 4 ‣ 2.2 Residual neural network and its dynamical system modeling ‣ 2 Notations and problem formulation ‣ On the Generalization Behavior of Deep Residual Networks From a Dynamical System Perspective" class="ltx_ref"><span class="ltx_text ltx_ref_tag">4</span></a>), <math id="S4.SS2.p5.m11" class="ltx_Math" alttext="\mathrm{P}_{(i_{1}i_{2})}\mathrm{P}_{(i_{1}i_{2})}=\mathrm{I}" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>P</mi><mrow><mo stretchy="false">(</mo><mrow><msub><mi>i</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>i</mi><mn>2</mn></msub></mrow><mo stretchy="false">)</mo></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>P</mi><mrow><mo stretchy="false">(</mo><mrow><msub><mi>i</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>i</mi><mn>2</mn></msub></mrow><mo stretchy="false">)</mo></mrow></msub></mrow><mo>=</mo><mi>I</mi></mrow><annotation encoding="application/x-tex">\mathrm{P}_{(i_{1}i_{2})}\mathrm{P}_{(i_{1}i_{2})}=\mathrm{I}</annotation></semantics></math> and the element-wise action of <math id="S4.SS2.p5.m12" class="ltx_Math" alttext="\psi" display="inline" intent=":literal"><semantics><mi>ψ</mi><annotation encoding="application/x-tex">\psi</annotation></semantics></math>. Through a similar procedure as described above, we can derive that <math id="S4.SS2.p5.m13" class="ltx_Math" alttext="\mathrm{x}^{1}_{i_{2}}(\mathrm{d};\tilde{\Theta}^{\rm total}_{0})=\mathrm{x}^{1}_{i_{1}}(\mathrm{d};{\Theta}^{\rm total}_{0})" display="inline" intent=":literal"><semantics><mrow><mrow><msubsup><mi>x</mi><msub><mi>i</mi><mn>2</mn></msub><mn>1</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>d</mi><mo>,</mo><msubsup><mover accent="true"><mi mathvariant="normal">Θ</mi><mo>~</mo></mover><mn>0</mn><mi>total</mi></msubsup><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><msubsup><mi>x</mi><msub><mi>i</mi><mn>1</mn></msub><mn>1</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>d</mi><mo>,</mo><msubsup><mi mathvariant="normal">Θ</mi><mn>0</mn><mi>total</mi></msubsup><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\mathrm{x}^{1}_{i_{2}}(\mathrm{d};\tilde{\Theta}^{\rm total}_{0})=\mathrm{x}^{1}_{i_{1}}(\mathrm{d};{\Theta}^{\rm total}_{0})</annotation></semantics></math> and <math id="S4.SS2.p5.m14" class="ltx_math_unparsed" alttext="\mathrm{x}^{1}_{i}(\mathrm{d};\tilde{\Theta}^{\rm total}_{0})=\mathrm{x}^{1}_{i}(\mathrm{d};{\Theta}^{\rm total}_{0}),i\neq i_{1},i_{2}" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>x</mi><mi>i</mi><mn>1</mn></msubsup><mrow><mo stretchy="false">(</mo><mi>d</mi><mo>;</mo><msubsup><mover accent="true"><mi mathvariant="normal">Θ</mi><mo>~</mo></mover><mn>0</mn><mi>total</mi></msubsup><mo stretchy="false">)</mo></mrow><mo>=</mo><msubsup><mi>x</mi><mi>i</mi><mn>1</mn></msubsup><mrow><mo stretchy="false">(</mo><mi>d</mi><mo>;</mo><msubsup><mi mathvariant="normal">Θ</mi><mn>0</mn><mi>total</mi></msubsup><mo stretchy="false">)</mo></mrow><mo>,</mo><mi>i</mi><mo>≠</mo><msub><mi>i</mi><mn>1</mn></msub><mo>,</mo><msub><mi>i</mi><mn>2</mn></msub></mrow><annotation encoding="application/x-tex">\mathrm{x}^{1}_{i}(\mathrm{d};\tilde{\Theta}^{\rm total}_{0})=\mathrm{x}^{1}_{i}(\mathrm{d};{\Theta}^{\rm total}_{0}),i\neq i_{1},i_{2}</annotation></semantics></math>, i.e., <math id="S4.SS2.p5.m15" class="ltx_Math" alttext="\mathrm{x}^{1}(\mathrm{d};\tilde{\Theta}^{\rm total}_{0})=\mathrm{P}_{(i_{1}i_{2})}\mathrm{x}^{1}(\mathrm{d};{\Theta}^{\rm total}_{0})." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><msup><mi>x</mi><mn>1</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>d</mi><mo>,</mo><msubsup><mover accent="true"><mi mathvariant="normal">Θ</mi><mo>~</mo></mover><mn>0</mn><mi>total</mi></msubsup><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><msub><mi>P</mi><mrow><mo stretchy="false">(</mo><mrow><msub><mi>i</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>i</mi><mn>2</mn></msub></mrow><mo stretchy="false">)</mo></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msup><mi>x</mi><mn>1</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>d</mi><mo>,</mo><msubsup><mi mathvariant="normal">Θ</mi><mn>0</mn><mi>total</mi></msubsup><mo stretchy="false">)</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\mathrm{x}^{1}(\mathrm{d};\tilde{\Theta}^{\rm total}_{0})=\mathrm{P}_{(i_{1}i_{2})}\mathrm{x}^{1}(\mathrm{d};{\Theta}^{\rm total}_{0}).</annotation></semantics></math></span></p>
</div>
<div id="S4.SS2.p6" class="ltx_para">
<p id="S4.SS2.p6.1" class="ltx_p"><span id="S4.SS2.p6.1.1" class="ltx_text">Suppose the claim holds for layer <math id="S4.SS2.p6.m1" class="ltx_Math" alttext="l\leq K" display="inline" intent=":literal"><semantics><mrow><mi>l</mi><mo>≤</mo><mi>K</mi></mrow><annotation encoding="application/x-tex">l\leq K</annotation></semantics></math>, where <math id="S4.SS2.p6.m2" class="ltx_Math" alttext="K\geq 2" display="inline" intent=":literal"><semantics><mrow><mi>K</mi><mo>≥</mo><mn>2</mn></mrow><annotation encoding="application/x-tex">K\geq 2</annotation></semantics></math> and <math id="S4.SS2.p6.m3" class="ltx_Math" alttext="K\in\mathbb{N}" display="inline" intent=":literal"><semantics><mrow><mi>K</mi><mo>∈</mo><mi>ℕ</mi></mrow><annotation encoding="application/x-tex">K\in\mathbb{N}</annotation></semantics></math>.
Given parameter <math id="S4.SS2.p6.m4" class="ltx_Math" alttext="{\Theta}^{\rm total}_{K+1}=({\Theta}^{\rm pre}_{K+1},{\Theta}_{K+1}^{0},\ldots,{\Theta}_{K+1}^{K})\in\Omega_{{\Theta}^{\rm total}_{K+1}}" display="inline" intent=":literal"><semantics><mrow><msubsup><mi mathvariant="normal">Θ</mi><mrow><mi>K</mi><mo>+</mo><mn>1</mn></mrow><mi>total</mi></msubsup><mo>=</mo><mrow><mo stretchy="false">(</mo><msubsup><mi mathvariant="normal">Θ</mi><mrow><mi>K</mi><mo>+</mo><mn>1</mn></mrow><mi>pre</mi></msubsup><mo>,</mo><msubsup><mi mathvariant="normal">Θ</mi><mrow><mi>K</mi><mo>+</mo><mn>1</mn></mrow><mn>0</mn></msubsup><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msubsup><mi mathvariant="normal">Θ</mi><mrow><mi>K</mi><mo>+</mo><mn>1</mn></mrow><mi>K</mi></msubsup><mo stretchy="false">)</mo></mrow><mo>∈</mo><msub><mi mathvariant="normal">Ω</mi><msubsup><mi mathvariant="normal">Θ</mi><mrow><mi>K</mi><mo>+</mo><mn>1</mn></mrow><mi>total</mi></msubsup></msub></mrow><annotation encoding="application/x-tex">{\Theta}^{\rm total}_{K+1}=({\Theta}^{\rm pre}_{K+1},{\Theta}_{K+1}^{0},\ldots,{\Theta}_{K+1}^{K})\in\Omega_{{\Theta}^{\rm total}_{K+1}}</annotation></semantics></math> and <math id="S4.SS2.p6.m5" class="ltx_Math" alttext="i_{1},i_{2}\in\{1,\ldots,n\}" display="inline" intent=":literal"><semantics><mrow><msub><mi>i</mi><mn>1</mn></msub><mo>,</mo><mrow><msub><mi>i</mi><mn>2</mn></msub><mo>∈</mo><mrow><mo stretchy="false">{</mo><mn>1</mn><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mi>n</mi><mo stretchy="false">}</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">i_{1},i_{2}\in\{1,\ldots,n\}</annotation></semantics></math>.
By the inductive hypothesis, we can find parameters
<math id="S4.SS2.p6.m6" class="ltx_Math" alttext="(\tilde{{\Theta}}^{\rm pre}_{K},\tilde{{\Theta}}_{K}^{0},\ldots,\tilde{{\Theta}}_{K}^{K-1})\in\Omega_{{\Theta}^{\rm total}_{K}}" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">(</mo><msubsup><mover accent="true"><mi mathvariant="normal">Θ</mi><mo>~</mo></mover><mi>K</mi><mi>pre</mi></msubsup><mo>,</mo><msubsup><mover accent="true"><mi mathvariant="normal">Θ</mi><mo>~</mo></mover><mi>K</mi><mn>0</mn></msubsup><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msubsup><mover accent="true"><mi mathvariant="normal">Θ</mi><mo>~</mo></mover><mi>K</mi><mrow><mi>K</mi><mo>−</mo><mn>1</mn></mrow></msubsup><mo stretchy="false">)</mo></mrow><mo>∈</mo><msub><mi mathvariant="normal">Ω</mi><msubsup><mi mathvariant="normal">Θ</mi><mi>K</mi><mi>total</mi></msubsup></msub></mrow><annotation encoding="application/x-tex">(\tilde{{\Theta}}^{\rm pre}_{K},\tilde{{\Theta}}_{K}^{0},\ldots,\tilde{{\Theta}}_{K}^{K-1})\in\Omega_{{\Theta}^{\rm total}_{K}}</annotation></semantics></math> such that for <math id="S4.SS2.p6.m7" class="ltx_Math" alttext="\tilde{{\Theta}}_{K+1}^{\rm total}=(\tilde{{\Theta}}^{\rm pre}_{K},\tilde{{\Theta}}_{K}^{0},\ldots,\tilde{{\Theta}}_{K}^{K-1},\tilde{{\Theta}}_{K+1}^{K})" display="inline" intent=":literal"><semantics><mrow><msubsup><mover accent="true"><mi mathvariant="normal">Θ</mi><mo>~</mo></mover><mrow><mi>K</mi><mo>+</mo><mn>1</mn></mrow><mi>total</mi></msubsup><mo>=</mo><mrow><mo stretchy="false">(</mo><msubsup><mover accent="true"><mi mathvariant="normal">Θ</mi><mo>~</mo></mover><mi>K</mi><mi>pre</mi></msubsup><mo>,</mo><msubsup><mover accent="true"><mi mathvariant="normal">Θ</mi><mo>~</mo></mover><mi>K</mi><mn>0</mn></msubsup><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msubsup><mover accent="true"><mi mathvariant="normal">Θ</mi><mo>~</mo></mover><mi>K</mi><mrow><mi>K</mi><mo>−</mo><mn>1</mn></mrow></msubsup><mo>,</mo><msubsup><mover accent="true"><mi mathvariant="normal">Θ</mi><mo>~</mo></mover><mrow><mi>K</mi><mo>+</mo><mn>1</mn></mrow><mi>K</mi></msubsup><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\tilde{{\Theta}}_{K+1}^{\rm total}=(\tilde{{\Theta}}^{\rm pre}_{K},\tilde{{\Theta}}_{K}^{0},\ldots,\tilde{{\Theta}}_{K}^{K-1},\tilde{{\Theta}}_{K+1}^{K})</annotation></semantics></math> <math id="S4.SS2.p6.m8" class="ltx_Math" alttext="=(\tilde{{\Theta}}^{\rm pre}_{K+1},\tilde{{\Theta}}_{K+1}^{0},\ldots,\tilde{{\Theta}}_{K+1}^{K-1},\tilde{{\Theta}}_{K+1}^{K})\in\Omega_{{\Theta}^{\rm total}_{K+1}}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mo stretchy="false">(</mo><msubsup><mover accent="true"><mi mathvariant="normal">Θ</mi><mo>~</mo></mover><mrow><mi>K</mi><mo>+</mo><mn>1</mn></mrow><mi>pre</mi></msubsup><mo>,</mo><msubsup><mover accent="true"><mi mathvariant="normal">Θ</mi><mo>~</mo></mover><mrow><mi>K</mi><mo>+</mo><mn>1</mn></mrow><mn>0</mn></msubsup><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msubsup><mover accent="true"><mi mathvariant="normal">Θ</mi><mo>~</mo></mover><mrow><mi>K</mi><mo>+</mo><mn>1</mn></mrow><mrow><mi>K</mi><mo>−</mo><mn>1</mn></mrow></msubsup><mo>,</mo><msubsup><mover accent="true"><mi mathvariant="normal">Θ</mi><mo>~</mo></mover><mrow><mi>K</mi><mo>+</mo><mn>1</mn></mrow><mi>K</mi></msubsup><mo stretchy="false">)</mo></mrow><mo>∈</mo><msub><mi mathvariant="normal">Ω</mi><msubsup><mi mathvariant="normal">Θ</mi><mrow><mi>K</mi><mo>+</mo><mn>1</mn></mrow><mi>total</mi></msubsup></msub></mrow><annotation encoding="application/x-tex">=(\tilde{{\Theta}}^{\rm pre}_{K+1},\tilde{{\Theta}}_{K+1}^{0},\ldots,\tilde{{\Theta}}_{K+1}^{K-1},\tilde{{\Theta}}_{K+1}^{K})\in\Omega_{{\Theta}^{\rm total}_{K+1}}</annotation></semantics></math>, there is</span></p>
<table id="S4.Ex29" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S4.Ex29.m1" class="ltx_Math" alttext="\mathrm{x}^{K}(\mathrm{d};\tilde{\Theta}^{\rm total}_{K+1})=\mathrm{P}_{(i_{1}i_{2})}\mathrm{x}^{K}(\mathrm{d};{\Theta}^{\rm total}_{K+1})." display="block" intent=":literal"><semantics><mrow><mrow><mrow><msup><mi>x</mi><mi>K</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>d</mi><mo>,</mo><msubsup><mover accent="true"><mi mathvariant="normal">Θ</mi><mo>~</mo></mover><mrow><mi>K</mi><mo>+</mo><mn>1</mn></mrow><mi>total</mi></msubsup><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><msub><mi>P</mi><mrow><mo stretchy="false">(</mo><mrow><msub><mi>i</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>i</mi><mn>2</mn></msub></mrow><mo stretchy="false">)</mo></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msup><mi>x</mi><mi>K</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>d</mi><mo>,</mo><msubsup><mi mathvariant="normal">Θ</mi><mrow><mi>K</mi><mo>+</mo><mn>1</mn></mrow><mi>total</mi></msubsup><mo stretchy="false">)</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\mathrm{x}^{K}(\mathrm{d};\tilde{\Theta}^{\rm total}_{K+1})=\mathrm{P}_{(i_{1}i_{2})}\mathrm{x}^{K}(\mathrm{d};{\Theta}^{\rm total}_{K+1}).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S4.SS2.p6.2" class="ltx_p"><span id="S4.SS2.p6.2.1" class="ltx_text">Let parameter <math id="S4.SS2.p6.m9" class="ltx_Math" alttext="\tilde{{\Theta}}_{K+1}^{K}=(\tilde{\mathrm{V}}^{K},\tilde{\mathrm{W}}^{K},\mathrm{b}^{K},\tilde{\mathrm{c}}^{K})" display="inline" intent=":literal"><semantics><mrow><msubsup><mover accent="true"><mi mathvariant="normal">Θ</mi><mo>~</mo></mover><mrow><mi>K</mi><mo>+</mo><mn>1</mn></mrow><mi>K</mi></msubsup><mo>=</mo><mrow><mo stretchy="false">(</mo><msup><mover accent="true"><mi>V</mi><mo>~</mo></mover><mi>K</mi></msup><mo>,</mo><msup><mover accent="true"><mi>W</mi><mo>~</mo></mover><mi>K</mi></msup><mo>,</mo><msup><mi>b</mi><mi>K</mi></msup><mo>,</mo><msup><mover accent="true"><mi>c</mi><mo>~</mo></mover><mi>K</mi></msup><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\tilde{{\Theta}}_{K+1}^{K}=(\tilde{\mathrm{V}}^{K},\tilde{\mathrm{W}}^{K},\mathrm{b}^{K},\tilde{\mathrm{c}}^{K})</annotation></semantics></math>, where
<math id="S4.SS2.p6.m10" class="ltx_Math" alttext="\tilde{\mathrm{V}}^{K}=\mathrm{V}^{K}\mathrm{P}_{(i_{1}i_{2})},\tilde{\mathrm{W}}^{K}=\mathrm{P}_{(i_{1}i_{2})}\mathrm{W}^{K},\tilde{\mathrm{c}}^{K}=\mathrm{P}_{(i_{1}i_{2})}\mathrm{c}^{K}." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><msup><mover accent="true"><mi>V</mi><mo>~</mo></mover><mi>K</mi></msup><mo>=</mo><mrow><msup><mi>V</mi><mi>K</mi></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>P</mi><mrow><mo stretchy="false">(</mo><mrow><msub><mi>i</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>i</mi><mn>2</mn></msub></mrow><mo stretchy="false">)</mo></mrow></msub></mrow></mrow><mo>,</mo><mrow><msup><mover accent="true"><mi>W</mi><mo>~</mo></mover><mi>K</mi></msup><mo>=</mo><mrow><msub><mi>P</mi><mrow><mo stretchy="false">(</mo><mrow><msub><mi>i</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>i</mi><mn>2</mn></msub></mrow><mo stretchy="false">)</mo></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msup><mi>W</mi><mi>K</mi></msup></mrow></mrow><mo>,</mo><mrow><msup><mover accent="true"><mi>c</mi><mo>~</mo></mover><mi>K</mi></msup><mo>=</mo><mrow><msub><mi>P</mi><mrow><mo stretchy="false">(</mo><mrow><msub><mi>i</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>i</mi><mn>2</mn></msub></mrow><mo stretchy="false">)</mo></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msup><mi>c</mi><mi>K</mi></msup></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\tilde{\mathrm{V}}^{K}=\mathrm{V}^{K}\mathrm{P}_{(i_{1}i_{2})},\tilde{\mathrm{W}}^{K}=\mathrm{P}_{(i_{1}i_{2})}\mathrm{W}^{K},\tilde{\mathrm{c}}^{K}=\mathrm{P}_{(i_{1}i_{2})}\mathrm{c}^{K}.</annotation></semantics></math>
We therefore obtain</span></p>
<table id="S4.Ex30" class="ltx_equationgroup ltx_eqn_table">

<tbody id="S4.Ex30X"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S4.Ex30X.m2" class="ltx_Math" alttext="\displaystyle\mathrm{x}^{K+1}_{i_{1}}(\mathrm{d};\tilde{\Theta}^{\rm total}_{K+1})=" display="inline" intent=":literal"><semantics><mrow><mrow><msubsup><mi>x</mi><msub><mi>i</mi><mn>1</mn></msub><mrow><mi>K</mi><mo>+</mo><mn>1</mn></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>d</mi><mo>,</mo><msubsup><mover accent="true"><mi mathvariant="normal">Θ</mi><mo>~</mo></mover><mrow><mi>K</mi><mo>+</mo><mn>1</mn></mrow><mi>total</mi></msubsup><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mphantom></mphantom></mrow><annotation encoding="application/x-tex">\displaystyle\mathrm{x}^{K+1}_{i_{1}}(\mathrm{d};\tilde{\Theta}^{\rm total}_{K+1})=</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S4.Ex30X.m3" class="ltx_Math" alttext="\displaystyle\mathrm{x}^{K}_{i_{1}}(\mathrm{d};\tilde{\Theta}^{\rm total}_{K+1})+\tau_{L}\Big(\tilde{\mathrm{W}}^{K}_{i_{1},:}\psi\circ(\tilde{\mathrm{V}}^{K}\mathrm{x}^{K}(\mathrm{d};\tilde{\Theta}^{\rm total}_{K+1})+\mathrm{b}^{K})+\tilde{\mathrm{c}}^{K}_{i_{1}})\Big)" display="inline" intent=":literal"><semantics><mrow><mi>x</mi><msup><mrow></mrow><mi>K</mi></msup><msub><mrow></mrow><msub><mi>i</mi><mn>1</mn></msub></msub><mo stretchy="false">(</mo><mi>d</mi><mo>;</mo><mover accent="true"><mi mathvariant="normal">Θ</mi><mo>~</mo></mover><msup><mrow></mrow><mi>total</mi></msup><msub><mrow></mrow><mrow><mi>K</mi><mo>+</mo><mn>1</mn></mrow></msub><mo stretchy="false">)</mo><mo>+</mo><mi>τ</mi><msub><mrow></mrow><mi>L</mi></msub><mo maxsize="1.600em" minsize="1.600em">(</mo><mover accent="true"><mi>W</mi><mo>~</mo></mover><msup><mrow></mrow><mi>K</mi></msup><msub><mrow></mrow><mrow><mi>i</mi><msub><mrow></mrow><mn>1</mn></msub><mo>,</mo><mo>:</mo></mrow></msub><mi>ψ</mi><mo lspace="0.222em" rspace="0.222em">∘</mo><mo stretchy="false">(</mo><mover accent="true"><mi>V</mi><mo>~</mo></mover><msup><mrow></mrow><mi>K</mi></msup><mi>x</mi><msup><mrow></mrow><mi>K</mi></msup><mo stretchy="false">(</mo><mi>d</mi><mo>;</mo><mover accent="true"><mi mathvariant="normal">Θ</mi><mo>~</mo></mover><msup><mrow></mrow><mi>total</mi></msup><msub><mrow></mrow><mrow><mi>K</mi><mo>+</mo><mn>1</mn></mrow></msub><mo stretchy="false">)</mo><mo>+</mo><mi>b</mi><msup><mrow></mrow><mi>K</mi></msup><mo stretchy="false">)</mo><mo>+</mo><mover accent="true"><mi>c</mi><mo>~</mo></mover><msup><mrow></mrow><mi>K</mi></msup><msub><mrow></mrow><msub><mi>i</mi><mn>1</mn></msub></msub><mo stretchy="false">)</mo><mo maxsize="1.600em" minsize="1.600em">)</mo></mrow><annotation encoding="application/x-tex">\displaystyle\mathrm{x}^{K}_{i_{1}}(\mathrm{d};\tilde{\Theta}^{\rm total}_{K+1})+\tau_{L}\Big(\tilde{\mathrm{W}}^{K}_{i_{1},:}\psi\circ(\tilde{\mathrm{V}}^{K}\mathrm{x}^{K}(\mathrm{d};\tilde{\Theta}^{\rm total}_{K+1})+\mathrm{b}^{K})+\tilde{\mathrm{c}}^{K}_{i_{1}})\Big)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="S4.Ex30Xa"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S4.Ex30Xa.m2" class="ltx_Math" alttext="\displaystyle=" display="inline" intent=":literal"><semantics><mo>=</mo><annotation encoding="application/x-tex">\displaystyle=</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S4.Ex30Xa.m3" class="ltx_Math" alttext="\displaystyle\mathrm{x}^{K}_{i_{2}}(\mathrm{d};{\Theta}^{\rm total}_{K+1})+\tau_{L}\Big({\mathrm{W}}^{K}_{i_{2},:}\psi\circ(\mathrm{V}^{K}\mathrm{x}^{K}(\mathrm{d};{\Theta}^{\rm total}_{K+1})+\mathrm{b}^{K})+\mathrm{c}^{K}_{i_{2}})\Big)" display="inline" intent=":literal"><semantics><mrow><mi>x</mi><msup><mrow></mrow><mi>K</mi></msup><msub><mrow></mrow><msub><mi>i</mi><mn>2</mn></msub></msub><mo stretchy="false">(</mo><mi>d</mi><mo>;</mo><mi mathvariant="normal">Θ</mi><msup><mrow></mrow><mi>total</mi></msup><msub><mrow></mrow><mrow><mi>K</mi><mo>+</mo><mn>1</mn></mrow></msub><mo stretchy="false">)</mo><mo>+</mo><mi>τ</mi><msub><mrow></mrow><mi>L</mi></msub><mo maxsize="1.600em" minsize="1.600em">(</mo><mi>W</mi><msup><mrow></mrow><mi>K</mi></msup><msub><mrow></mrow><mrow><mi>i</mi><msub><mrow></mrow><mn>2</mn></msub><mo>,</mo><mo>:</mo></mrow></msub><mi>ψ</mi><mo lspace="0.222em" rspace="0.222em">∘</mo><mo stretchy="false">(</mo><mi>V</mi><msup><mrow></mrow><mi>K</mi></msup><mi>x</mi><msup><mrow></mrow><mi>K</mi></msup><mo stretchy="false">(</mo><mi>d</mi><mo>;</mo><mi mathvariant="normal">Θ</mi><msup><mrow></mrow><mi>total</mi></msup><msub><mrow></mrow><mrow><mi>K</mi><mo>+</mo><mn>1</mn></mrow></msub><mo stretchy="false">)</mo><mo>+</mo><mi>b</mi><msup><mrow></mrow><mi>K</mi></msup><mo stretchy="false">)</mo><mo>+</mo><mi>c</mi><msup><mrow></mrow><mi>K</mi></msup><msub><mrow></mrow><msub><mi>i</mi><mn>2</mn></msub></msub><mo stretchy="false">)</mo><mo maxsize="1.600em" minsize="1.600em">)</mo></mrow><annotation encoding="application/x-tex">\displaystyle\mathrm{x}^{K}_{i_{2}}(\mathrm{d};{\Theta}^{\rm total}_{K+1})+\tau_{L}\Big({\mathrm{W}}^{K}_{i_{2},:}\psi\circ(\mathrm{V}^{K}\mathrm{x}^{K}(\mathrm{d};{\Theta}^{\rm total}_{K+1})+\mathrm{b}^{K})+\mathrm{c}^{K}_{i_{2}})\Big)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="S4.Ex30Xb"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S4.Ex30Xb.m2" class="ltx_Math" alttext="\displaystyle=" display="inline" intent=":literal"><semantics><mo>=</mo><annotation encoding="application/x-tex">\displaystyle=</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S4.Ex30Xb.m3" class="ltx_Math" alttext="\displaystyle\mathrm{x}^{K+1}_{i_{2}}(\mathrm{d};{\Theta}^{\rm total}_{K+1})," display="inline" intent=":literal"><semantics><mrow><mrow><msubsup><mi>x</mi><msub><mi>i</mi><mn>2</mn></msub><mrow><mi>K</mi><mo>+</mo><mn>1</mn></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>d</mi><mo>,</mo><msubsup><mi mathvariant="normal">Θ</mi><mrow><mi>K</mi><mo>+</mo><mn>1</mn></mrow><mi>total</mi></msubsup><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\mathrm{x}^{K+1}_{i_{2}}(\mathrm{d};{\Theta}^{\rm total}_{K+1}),</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S4.SS2.p6.3" class="ltx_p"><span id="S4.SS2.p6.3.1" class="ltx_text">due to the definition of <math id="S4.SS2.p6.m11" class="ltx_Math" alttext="{\mathcal{F}}^{l}_{i}" display="inline" intent=":literal"><semantics><msubsup><mi class="ltx_font_mathcaligraphic">ℱ</mi><mi>i</mi><mi>l</mi></msubsup><annotation encoding="application/x-tex">{\mathcal{F}}^{l}_{i}</annotation></semantics></math> (<math id="S4.SS2.p6.m12" class="ltx_Math" alttext="l\!=\!K\!+\!1" display="inline" intent=":literal"><semantics><mrow><mi>l</mi><mo lspace="0.108em" rspace="0.108em">=</mo><mrow><mi>K</mi><mo lspace="0.052em">+</mo><mn>1</mn></mrow></mrow><annotation encoding="application/x-tex">l\!=\!K\!+\!1</annotation></semantics></math>) in (<a href="#S2.E4" title="Equation 4 ‣ 2.2 Residual neural network and its dynamical system modeling ‣ 2 Notations and problem formulation ‣ On the Generalization Behavior of Deep Residual Networks From a Dynamical System Perspective" class="ltx_ref"><span class="ltx_text ltx_ref_tag">4</span></a>), <math id="S4.SS2.p6.m13" class="ltx_Math" alttext="\mathrm{P}_{(i_{1}i_{2})}\mathrm{P}_{(i_{1}i_{2})}\!=\!\mathrm{I}" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>P</mi><mrow><mo stretchy="false">(</mo><mrow><msub><mi>i</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>i</mi><mn>2</mn></msub></mrow><mo stretchy="false">)</mo></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>P</mi><mrow><mo stretchy="false">(</mo><mrow><msub><mi>i</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>i</mi><mn>2</mn></msub></mrow><mo stretchy="false">)</mo></mrow></msub></mrow><mo rspace="0.108em">=</mo><mi>I</mi></mrow><annotation encoding="application/x-tex">\mathrm{P}_{(i_{1}i_{2})}\mathrm{P}_{(i_{1}i_{2})}\!=\!\mathrm{I}</annotation></semantics></math> and the element-wise action of <math id="S4.SS2.p6.m14" class="ltx_Math" alttext="\psi" display="inline" intent=":literal"><semantics><mi>ψ</mi><annotation encoding="application/x-tex">\psi</annotation></semantics></math>. Besides, we can similarly get <math id="S4.SS2.p6.m15" class="ltx_Math" alttext="\mathrm{x}^{K+1}(\mathrm{d};\tilde{\Theta}^{\rm total}_{K+1})=\mathrm{P}_{(i_{1}i_{2})}\mathrm{x}^{K+1}(\mathrm{d};{\Theta}^{\rm total}_{K+1})" display="inline" intent=":literal"><semantics><mrow><mrow><msup><mi>x</mi><mrow><mi>K</mi><mo>+</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>d</mi><mo>,</mo><msubsup><mover accent="true"><mi mathvariant="normal">Θ</mi><mo>~</mo></mover><mrow><mi>K</mi><mo>+</mo><mn>1</mn></mrow><mi>total</mi></msubsup><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><msub><mi>P</mi><mrow><mo stretchy="false">(</mo><mrow><msub><mi>i</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>i</mi><mn>2</mn></msub></mrow><mo stretchy="false">)</mo></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msup><mi>x</mi><mrow><mi>K</mi><mo>+</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>d</mi><mo>,</mo><msubsup><mi mathvariant="normal">Θ</mi><mrow><mi>K</mi><mo>+</mo><mn>1</mn></mrow><mi>total</mi></msubsup><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\mathrm{x}^{K+1}(\mathrm{d};\tilde{\Theta}^{\rm total}_{K+1})=\mathrm{P}_{(i_{1}i_{2})}\mathrm{x}^{K+1}(\mathrm{d};{\Theta}^{\rm total}_{K+1})</annotation></semantics></math>. These complete the proof.
<span id="S4.SS2.p6.3.1.1" class="ltx_text ltx_align_floatright"></span></span></p>
</div>
</div>
<div id="S4.SS2.p7" class="ltx_para">
<p id="S4.SS2.p7.1" class="ltx_p">We now prove Theorem <a href="#Thmtheorem5" title="Theorem 5. ‣ 3 Main results and application ‣ On the Generalization Behavior of Deep Residual Networks From a Dynamical System Perspective" class="ltx_ref"><span class="ltx_text ltx_ref_tag">5</span></a>.</p>
</div>
<div id="S4.SS2.4" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="S4.SS2.p8" class="ltx_para">
<p id="S4.SS2.p8.1" class="ltx_p"><span id="S4.SS2.p8.1.1" class="ltx_text">(Proof of Theorem <a href="#Thmtheorem5" title="Theorem 5. ‣ 3 Main results and application ‣ On the Generalization Behavior of Deep Residual Networks From a Dynamical System Perspective" class="ltx_ref"><span class="ltx_text ltx_ref_tag">5</span></a>)
We divide the proof into three steps. The proof strategy is to first reduce the generalization gap to a Rademacher complexity estimate,
and then carefully propagate this complexity through the residual layers,
tracking both the standard Lipschitz growth and a layer-wise negative correction induced by the activation structure.</span></p>
</div>
<div id="S4.SS2.p9" class="ltx_para">
<p id="S4.SS2.p9.1" class="ltx_p"><span id="S4.SS2.p9.1.1" class="ltx_text">Step 1. We first establish the boundedness of the loss function, which allows us to apply the result in <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib7" title="" class="ltx_ref">42</a>, Theorem 26.5]</cite> to derive an upper bound on the generalization gap via Rademacher complexity.
By assumptions <math id="S4.SS2.p9.m1" class="ltx_Math" alttext="(A_{1})-(A_{3})" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">(</mo><msub><mi>A</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow><mo>−</mo><mrow><mo stretchy="false">(</mo><msub><mi>A</mi><mn>3</mn></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">(A_{1})-(A_{3})</annotation></semantics></math> and Lemma <a href="#S4.Ex23" title="Lemma 12. ‣ 4.2 Proof of Theorem ‣ 4 Proofs ‣ On the Generalization Behavior of Deep Residual Networks From a Dynamical System Perspective" class="ltx_ref"><span class="ltx_text ltx_ref_tag">12</span></a>,
the sets of state variable <math id="S4.SS2.p9.m2" class="ltx_math_unparsed" alttext="\mathcal{S}_{\rm state}^{L}:=\{\mathrm{x}^{L}(\mathrm{d};{\Theta}^{\rm total}_{L}):\ {\Theta}^{\rm total}_{L}\in\Omega_{{\Theta}^{\rm total}_{L}},(\mathrm{d},\mathrm{g})\sim\mathfrak{D}\},L\geq 1" display="inline" intent=":literal"><semantics><mrow><msubsup><mi class="ltx_font_mathcaligraphic">𝒮</mi><mi>state</mi><mi>L</mi></msubsup><mo>:=</mo><mrow><mo stretchy="false">{</mo><msup><mi>x</mi><mi>L</mi></msup><mrow><mo stretchy="false">(</mo><mi>d</mi><mo>;</mo><msubsup><mi mathvariant="normal">Θ</mi><mi>L</mi><mi>total</mi></msubsup><mo rspace="0.278em" stretchy="false">)</mo></mrow><mo rspace="0.778em">:</mo><msubsup><mi mathvariant="normal">Θ</mi><mi>L</mi><mi>total</mi></msubsup><mo>∈</mo><msub><mi mathvariant="normal">Ω</mi><msubsup><mi mathvariant="normal">Θ</mi><mi>L</mi><mi>total</mi></msubsup></msub><mo>,</mo><mrow><mo stretchy="false">(</mo><mi>d</mi><mo>,</mo><mi>g</mi><mo stretchy="false">)</mo></mrow><mo>∼</mo><mi>𝔇</mi><mo stretchy="false">}</mo></mrow><mo>,</mo><mi>L</mi><mo>≥</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">\mathcal{S}_{\rm state}^{L}:=\{\mathrm{x}^{L}(\mathrm{d};{\Theta}^{\rm total}_{L}):\ {\Theta}^{\rm total}_{L}\in\Omega_{{\Theta}^{\rm total}_{L}},(\mathrm{d},\mathrm{g})\sim\mathfrak{D}\},L\geq 1</annotation></semantics></math> are uniformly bounded by a constant <math id="S4.SS2.p9.m3" class="ltx_Math" alttext="B_{\rm out}" display="inline" intent=":literal"><semantics><msub><mi>B</mi><mi>out</mi></msub><annotation encoding="application/x-tex">B_{\rm out}</annotation></semantics></math> dependent on <math id="S4.SS2.p9.m4" class="ltx_Math" alttext="T,B_{\rm in},B_{\boldsymbol{\Theta}},\mathrm{Lip}_{\psi}" display="inline" intent=":literal"><semantics><mrow><mi>T</mi><mo>,</mo><msub><mi>B</mi><mi>in</mi></msub><mo>,</mo><msub><mi>B</mi><mi>𝚯</mi></msub><mo>,</mo><msub><mi>Lip</mi><mi>ψ</mi></msub></mrow><annotation encoding="application/x-tex">T,B_{\rm in},B_{\boldsymbol{\Theta}},\mathrm{Lip}_{\psi}</annotation></semantics></math>.
Therefore, the sets <math id="S4.SS2.p9.m5" class="ltx_math_unparsed" alttext="\{{\ell}(\mathrm{x}^{L}(\mathrm{d};{\Theta}^{\rm total}_{L}),\mathrm{g}):{\Theta}^{\rm total}_{L}\in\Omega_{{\Theta}^{\rm total}_{L}},(\mathrm{d},\mathrm{g})\sim\mathfrak{D}\},L\geq 1" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">{</mo><mi mathvariant="normal">ℓ</mi><mrow><mo stretchy="false">(</mo><msup><mi>x</mi><mi>L</mi></msup><mrow><mo stretchy="false">(</mo><mi>d</mi><mo>;</mo><msubsup><mi mathvariant="normal">Θ</mi><mi>L</mi><mi>total</mi></msubsup><mo stretchy="false">)</mo></mrow><mo>,</mo><mi>g</mi><mo rspace="0.278em" stretchy="false">)</mo></mrow><mo rspace="0.278em">:</mo><msubsup><mi mathvariant="normal">Θ</mi><mi>L</mi><mi>total</mi></msubsup><mo>∈</mo><msub><mi mathvariant="normal">Ω</mi><msubsup><mi mathvariant="normal">Θ</mi><mi>L</mi><mi>total</mi></msubsup></msub><mo>,</mo><mrow><mo stretchy="false">(</mo><mi>d</mi><mo>,</mo><mi>g</mi><mo stretchy="false">)</mo></mrow><mo>∼</mo><mi>𝔇</mi><mo stretchy="false">}</mo></mrow><mo>,</mo><mi>L</mi><mo>≥</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">\{{\ell}(\mathrm{x}^{L}(\mathrm{d};{\Theta}^{\rm total}_{L}),\mathrm{g}):{\Theta}^{\rm total}_{L}\in\Omega_{{\Theta}^{\rm total}_{L}},(\mathrm{d},\mathrm{g})\sim\mathfrak{D}\},L\geq 1</annotation></semantics></math> are bounded by a constant <math id="S4.SS2.p9.m6" class="ltx_Math" alttext="B_{\ell}" display="inline" intent=":literal"><semantics><msub><mi>B</mi><mi mathvariant="normal">ℓ</mi></msub><annotation encoding="application/x-tex">B_{\ell}</annotation></semantics></math> dependent on <math id="S4.SS2.p9.m7" class="ltx_Math" alttext="T,B_{\rm in},B_{\boldsymbol{\Theta}},\mathrm{Lip}_{\psi}" display="inline" intent=":literal"><semantics><mrow><mi>T</mi><mo>,</mo><msub><mi>B</mi><mi>in</mi></msub><mo>,</mo><msub><mi>B</mi><mi>𝚯</mi></msub><mo>,</mo><msub><mi>Lip</mi><mi>ψ</mi></msub></mrow><annotation encoding="application/x-tex">T,B_{\rm in},B_{\boldsymbol{\Theta}},\mathrm{Lip}_{\psi}</annotation></semantics></math> due to the continuity of loss function.
Hence, for any <math id="S4.SS2.p9.m8" class="ltx_Math" alttext="0&lt;\delta&lt;1" display="inline" intent=":literal"><semantics><mrow><mn>0</mn><mo>&lt;</mo><mi>δ</mi><mo>&lt;</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">0&lt;\delta&lt;1</annotation></semantics></math>, with probability <math id="S4.SS2.p9.m9" class="ltx_Math" alttext="1-\delta" display="inline" intent=":literal"><semantics><mrow><mn>1</mn><mo>−</mo><mi>δ</mi></mrow><annotation encoding="application/x-tex">1-\delta</annotation></semantics></math>,</span></p>
<table id="S4.E21" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S4.E21.m1" class="ltx_Math" alttext="GE_{\mathcal{S}}(\mathrm{x}^{L}(\cdot;{\Theta}^{\rm total}_{L}))\leq 2\mathscr{R}_{\mathcal{S}}({\ell}\circ{\mathcal{F}}^{L})+4B_{\ell}\sqrt{\frac{2\log(4/\delta)}{S}},\ \forall\mathrm{x}^{L}(\cdot;{\Theta}^{\rm total}_{L})\in\mathcal{F}^{L}," display="block" intent=":literal"><semantics><mrow><mrow><mrow><mrow><mi>G</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>E</mi><mi class="ltx_font_mathcaligraphic">𝒮</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mi>x</mi><mi>L</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo>,</mo><msubsup><mi mathvariant="normal">Θ</mi><mi>L</mi><mi>total</mi></msubsup><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>≤</mo><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi class="ltx_font_mathscript">ℛ</mi><mi class="ltx_font_mathcaligraphic">𝒮</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi mathvariant="normal">ℓ</mi><mo lspace="0.222em" rspace="0.222em">∘</mo><msup><mi class="ltx_font_mathcaligraphic">ℱ</mi><mi>L</mi></msup></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mrow><mn>4</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>B</mi><mi mathvariant="normal">ℓ</mi></msub><mo lspace="0em" rspace="0em">​</mo><msqrt><mfrac><mrow><mn>2</mn><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>log</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mn>4</mn><mo>/</mo><mi>δ</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mi>S</mi></mfrac></msqrt></mrow></mrow></mrow><mo rspace="0.667em">,</mo><mrow><mrow><mo rspace="0.167em">∀</mo><mrow><msup><mi>x</mi><mi>L</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo>,</mo><msubsup><mi mathvariant="normal">Θ</mi><mi>L</mi><mi>total</mi></msubsup><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>∈</mo><msup><mi class="ltx_font_mathcaligraphic">ℱ</mi><mi>L</mi></msup></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">GE_{\mathcal{S}}(\mathrm{x}^{L}(\cdot;{\Theta}^{\rm total}_{L}))\leq 2\mathscr{R}_{\mathcal{S}}({\ell}\circ{\mathcal{F}}^{L})+4B_{\ell}\sqrt{\frac{2\log(4/\delta)}{S}},\ \forall\mathrm{x}^{L}(\cdot;{\Theta}^{\rm total}_{L})\in\mathcal{F}^{L},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(21)</span></td></tr></tbody>
</table>
<p id="S4.SS2.p9.2" class="ltx_p"><span id="S4.SS2.p9.2.1" class="ltx_text">due to <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib7" title="" class="ltx_ref">42</a>, Theorem 26.5]</cite>. Here <math id="S4.SS2.p9.m10" class="ltx_Math" alttext="{\ell}\circ{\mathcal{F}}^{L}=\{{f}(\mathrm{d},\mathrm{g})={\ell}(\mathrm{x}^{L}(\mathrm{d};{\Theta}^{\rm total}_{L}),\mathrm{g}):\ \mathrm{x}^{L}(\cdot;{\Theta}^{\rm total}_{L})\in{\mathcal{F}}^{L}\}" display="inline" intent=":literal"><semantics><mrow><mrow><mi mathvariant="normal">ℓ</mi><mo lspace="0.222em" rspace="0.222em">∘</mo><msup><mi class="ltx_font_mathcaligraphic">ℱ</mi><mi>L</mi></msup></mrow><mo>=</mo><mrow><mo stretchy="false">{</mo><mrow><mrow><mi>f</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>d</mi><mo>,</mo><mi>g</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mi mathvariant="normal">ℓ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mi>x</mi><mi>L</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>d</mi><mo>,</mo><msubsup><mi mathvariant="normal">Θ</mi><mi>L</mi><mi>total</mi></msubsup><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mi>g</mi><mo rspace="0.278em" stretchy="false">)</mo></mrow></mrow></mrow><mo rspace="0.778em">:</mo><mrow><mrow><msup><mi>x</mi><mi>L</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo>,</mo><msubsup><mi mathvariant="normal">Θ</mi><mi>L</mi><mi>total</mi></msubsup><mo stretchy="false">)</mo></mrow></mrow><mo>∈</mo><msup><mi class="ltx_font_mathcaligraphic">ℱ</mi><mi>L</mi></msup></mrow><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">{\ell}\circ{\mathcal{F}}^{L}=\{{f}(\mathrm{d},\mathrm{g})={\ell}(\mathrm{x}^{L}(\mathrm{d};{\Theta}^{\rm total}_{L}),\mathrm{g}):\ \mathrm{x}^{L}(\cdot;{\Theta}^{\rm total}_{L})\in{\mathcal{F}}^{L}\}</annotation></semantics></math>.</span></p>
</div>
<div id="S4.SS2.p10" class="ltx_para">
<p id="S4.SS2.p10.1" class="ltx_p"><span id="S4.SS2.p10.1.1" class="ltx_text">Step 2. We estimate the complexity <math id="S4.SS2.p10.m1" class="ltx_Math" alttext="\mathscr{R}_{\mathcal{S}}({\ell}\circ{\mathcal{F}}^{L})" display="inline" intent=":literal"><semantics><mrow><msub><mi class="ltx_font_mathscript">ℛ</mi><mi class="ltx_font_mathcaligraphic">𝒮</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi mathvariant="normal">ℓ</mi><mo lspace="0.222em" rspace="0.222em">∘</mo><msup><mi class="ltx_font_mathcaligraphic">ℱ</mi><mi>L</mi></msup></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathscr{R}_{\mathcal{S}}({\ell}\circ{\mathcal{F}}^{L})</annotation></semantics></math>. Here, we exploit the Lipschitz property of the loss with respect to the network output
to reduce the vector-valued Rademacher complexity to a sum of scalar-valued ones,
thereby decoupling the dependence across output coordinates.</span></p>
</div>
<div id="S4.SS2.p11" class="ltx_para">
<p id="S4.SS2.p11.1" class="ltx_p"><span id="S4.SS2.p11.1.1" class="ltx_text">By assumption (<math id="S4.SS2.p11.m1" class="ltx_Math" alttext="A_{4}" display="inline" intent=":literal"><semantics><msub><mi>A</mi><mn>4</mn></msub><annotation encoding="application/x-tex">A_{4}</annotation></semantics></math>) and the discussion in Step 1,
the sets <math id="S4.SS2.p11.m2" class="ltx_math_unparsed" alttext="\{{\kappa}(\mathrm{x},\tilde{\mathrm{x}},\mathrm{g}):\mathrm{x},\tilde{\mathrm{x}}\in\mathcal{S}_{\rm state}^{L};(\mathrm{d},\mathrm{g})\sim\mathfrak{D}\},L\geq 1" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">{</mo><mi>κ</mi><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mover accent="true"><mi>x</mi><mo>~</mo></mover><mo>,</mo><mi>g</mi><mo rspace="0.278em" stretchy="false">)</mo></mrow><mo rspace="0.278em">:</mo><mi>x</mi><mo>,</mo><mover accent="true"><mi>x</mi><mo>~</mo></mover><mo>∈</mo><msubsup><mi class="ltx_font_mathcaligraphic">𝒮</mi><mi>state</mi><mi>L</mi></msubsup><mo>;</mo><mrow><mo stretchy="false">(</mo><mi>d</mi><mo>,</mo><mi>g</mi><mo stretchy="false">)</mo></mrow><mo>∼</mo><mi>𝔇</mi><mo stretchy="false">}</mo></mrow><mo>,</mo><mi>L</mi><mo>≥</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">\{{\kappa}(\mathrm{x},\tilde{\mathrm{x}},\mathrm{g}):\mathrm{x},\tilde{\mathrm{x}}\in\mathcal{S}_{\rm state}^{L};(\mathrm{d},\mathrm{g})\sim\mathfrak{D}\},L\geq 1</annotation></semantics></math> are uniformly bounded by a constant <math id="S4.SS2.p11.m3" class="ltx_Math" alttext="B_{\kappa}" display="inline" intent=":literal"><semantics><msub><mi>B</mi><mi>κ</mi></msub><annotation encoding="application/x-tex">B_{\kappa}</annotation></semantics></math> dependent on <math id="S4.SS2.p11.m4" class="ltx_Math" alttext="T,B_{\rm in},B_{\boldsymbol{\Theta}},\mathrm{Lip}_{\psi}" display="inline" intent=":literal"><semantics><mrow><mi>T</mi><mo>,</mo><msub><mi>B</mi><mi>in</mi></msub><mo>,</mo><msub><mi>B</mi><mi>𝚯</mi></msub><mo>,</mo><msub><mi>Lip</mi><mi>ψ</mi></msub></mrow><annotation encoding="application/x-tex">T,B_{\rm in},B_{\boldsymbol{\Theta}},\mathrm{Lip}_{\psi}</annotation></semantics></math>. Hence, <math id="S4.SS2.p11.m5" class="ltx_Math" alttext="\ell" display="inline" intent=":literal"><semantics><mi mathvariant="normal">ℓ</mi><annotation encoding="application/x-tex">\ell</annotation></semantics></math> is <math id="S4.SS2.p11.m6" class="ltx_Math" alttext="B_{\kappa}" display="inline" intent=":literal"><semantics><msub><mi>B</mi><mi>κ</mi></msub><annotation encoding="application/x-tex">B_{\kappa}</annotation></semantics></math>-Lipschitz for the first argument in <math id="S4.SS2.p11.m7" class="ltx_math_unparsed" alttext="\{(\mathrm{x}^{L}(\mathrm{d};{\Theta}^{\rm total}_{L}),\mathrm{g}):{\Theta}^{\rm total}_{L}\in\Omega_{{\Theta}^{\rm total}_{L}},(\mathrm{d},\mathrm{g})\sim\mathfrak{D}\}" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">{</mo><mrow><mo stretchy="false">(</mo><msup><mi>x</mi><mi>L</mi></msup><mrow><mo stretchy="false">(</mo><mi>d</mi><mo>;</mo><msubsup><mi mathvariant="normal">Θ</mi><mi>L</mi><mi>total</mi></msubsup><mo stretchy="false">)</mo></mrow><mo>,</mo><mi>g</mi><mo rspace="0.278em" stretchy="false">)</mo></mrow><mo rspace="0.278em">:</mo><msubsup><mi mathvariant="normal">Θ</mi><mi>L</mi><mi>total</mi></msubsup><mo>∈</mo><msub><mi mathvariant="normal">Ω</mi><msubsup><mi mathvariant="normal">Θ</mi><mi>L</mi><mi>total</mi></msubsup></msub><mo>,</mo><mrow><mo stretchy="false">(</mo><mi>d</mi><mo>,</mo><mi>g</mi><mo stretchy="false">)</mo></mrow><mo>∼</mo><mi>𝔇</mi><mo stretchy="false">}</mo></mrow><annotation encoding="application/x-tex">\{(\mathrm{x}^{L}(\mathrm{d};{\Theta}^{\rm total}_{L}),\mathrm{g}):{\Theta}^{\rm total}_{L}\in\Omega_{{\Theta}^{\rm total}_{L}},(\mathrm{d},\mathrm{g})\sim\mathfrak{D}\}</annotation></semantics></math>, and we have,</span></p>
<table id="S4.EGx2" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="S4.Ex31"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S4.Ex31.m1" class="ltx_Math" alttext="\displaystyle\mathscr{R}_{\mathcal{S}}({\ell}\circ{\mathcal{F}}^{L})=" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi class="ltx_font_mathscript">ℛ</mi><mi class="ltx_font_mathcaligraphic">𝒮</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi mathvariant="normal">ℓ</mi><mo lspace="0.222em" rspace="0.222em">∘</mo><msup><mi class="ltx_font_mathcaligraphic">ℱ</mi><mi>L</mi></msup></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mphantom></mphantom></mrow><annotation encoding="application/x-tex">\displaystyle\mathscr{R}_{\mathcal{S}}({\ell}\circ{\mathcal{F}}^{L})=</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S4.Ex31.m2" class="ltx_Math" alttext="\displaystyle\mathbb{E}_{\boldsymbol{\varepsilon}}\sup_{\ell\circ\mathrm{x}^{L}(\cdot;{\Theta}^{\rm total}_{L})\in\ell\circ{\mathcal{F}}^{L}}\frac{1}{S}\sum_{s=1}^{S}\varepsilon_{(s)}\cdot{\ell}(\mathrm{x}^{L}(\mathrm{d}_{(s)};{\Theta}^{\rm total}_{L}),\mathrm{g}_{(s)})" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>𝔼</mi><mi>𝜺</mi></msub><mo lspace="0.167em" rspace="0em">​</mo><mrow><munder><mo movablelimits="false" rspace="0.167em">sup</mo><mrow><mrow><mrow><mi mathvariant="normal">ℓ</mi><mo lspace="0.222em" rspace="0.222em">∘</mo><msup><mi>x</mi><mi>L</mi></msup></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo>,</mo><msubsup><mi mathvariant="normal">Θ</mi><mi>L</mi><mi>total</mi></msubsup><mo stretchy="false">)</mo></mrow></mrow><mo>∈</mo><mrow><mi mathvariant="normal">ℓ</mi><mo lspace="0.222em" rspace="0.222em">∘</mo><msup><mi class="ltx_font_mathcaligraphic">ℱ</mi><mi>L</mi></msup></mrow></mrow></munder><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>S</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>s</mi><mo>=</mo><mn>1</mn></mrow><mi>S</mi></munderover></mstyle><msub><mi>ε</mi><mrow><mo stretchy="false">(</mo><mi>s</mi><mo stretchy="false">)</mo></mrow></msub></mrow></mrow></mrow></mrow><mo lspace="0.222em" rspace="0.222em">⋅</mo><mrow><mi mathvariant="normal">ℓ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mi>x</mi><mi>L</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>d</mi><mrow><mo stretchy="false">(</mo><mi>s</mi><mo stretchy="false">)</mo></mrow></msub><mo>,</mo><msubsup><mi mathvariant="normal">Θ</mi><mi>L</mi><mi>total</mi></msubsup><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><msub><mi>g</mi><mrow><mo stretchy="false">(</mo><mi>s</mi><mo stretchy="false">)</mo></mrow></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\mathbb{E}_{\boldsymbol{\varepsilon}}\sup_{\ell\circ\mathrm{x}^{L}(\cdot;{\Theta}^{\rm total}_{L})\in\ell\circ{\mathcal{F}}^{L}}\frac{1}{S}\sum_{s=1}^{S}\varepsilon_{(s)}\cdot{\ell}(\mathrm{x}^{L}(\mathrm{d}_{(s)};{\Theta}^{\rm total}_{L}),\mathrm{g}_{(s)})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="S4.Ex32"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S4.Ex32.m1" class="ltx_Math" alttext="\displaystyle=" display="inline" intent=":literal"><semantics><mo>=</mo><annotation encoding="application/x-tex">\displaystyle=</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S4.Ex32.m2" class="ltx_Math" alttext="\displaystyle\mathbb{E}_{\boldsymbol{\varepsilon}}\sup_{\mathrm{x}^{L}(\cdot;{\Theta}^{\rm total}_{L})\in{\mathcal{F}}^{L}}\frac{1}{S}\sum_{s=1}^{S}\varepsilon_{(s)}\cdot{\ell}(\mathrm{x}^{L}(\mathrm{d}_{(s)};{\Theta}^{\rm total}_{L}),\mathrm{g}_{(s)})" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>𝔼</mi><mi>𝜺</mi></msub><mo lspace="0.167em" rspace="0em">​</mo><mrow><munder><mo movablelimits="false" rspace="0.167em">sup</mo><mrow><mrow><msup><mi>x</mi><mi>L</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo>,</mo><msubsup><mi mathvariant="normal">Θ</mi><mi>L</mi><mi>total</mi></msubsup><mo stretchy="false">)</mo></mrow></mrow><mo>∈</mo><msup><mi class="ltx_font_mathcaligraphic">ℱ</mi><mi>L</mi></msup></mrow></munder><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>S</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>s</mi><mo>=</mo><mn>1</mn></mrow><mi>S</mi></munderover></mstyle><msub><mi>ε</mi><mrow><mo stretchy="false">(</mo><mi>s</mi><mo stretchy="false">)</mo></mrow></msub></mrow></mrow></mrow></mrow><mo lspace="0.222em" rspace="0.222em">⋅</mo><mrow><mi mathvariant="normal">ℓ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mi>x</mi><mi>L</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>d</mi><mrow><mo stretchy="false">(</mo><mi>s</mi><mo stretchy="false">)</mo></mrow></msub><mo>,</mo><msubsup><mi mathvariant="normal">Θ</mi><mi>L</mi><mi>total</mi></msubsup><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><msub><mi>g</mi><mrow><mo stretchy="false">(</mo><mi>s</mi><mo stretchy="false">)</mo></mrow></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\mathbb{E}_{\boldsymbol{\varepsilon}}\sup_{\mathrm{x}^{L}(\cdot;{\Theta}^{\rm total}_{L})\in{\mathcal{F}}^{L}}\frac{1}{S}\sum_{s=1}^{S}\varepsilon_{(s)}\cdot{\ell}(\mathrm{x}^{L}(\mathrm{d}_{(s)};{\Theta}^{\rm total}_{L}),\mathrm{g}_{(s)})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="S4.Ex33"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S4.Ex33.m1" class="ltx_Math" alttext="\displaystyle\leq" display="inline" intent=":literal"><semantics><mo>≤</mo><annotation encoding="application/x-tex">\displaystyle\leq</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S4.Ex33.m2" class="ltx_Math" alttext="\displaystyle\sqrt{2}B_{\kappa}\mathbb{E}_{\boldsymbol{\epsilon}}\sup_{\begin{subarray}{c}\mathrm{x}^{L}_{k}(\cdot;{\Theta}^{\rm total}_{L})\in{\mathcal{F}}^{L}_{k}\end{subarray}}\frac{1}{S}\sum_{s=1}^{S}\sum_{k=1}^{n}\epsilon_{(sk)}\mathrm{x}^{L}_{k}(\mathrm{d}_{(s)};{\Theta}^{\rm total}_{L})" display="inline" intent=":literal"><semantics><mrow><msqrt><mn>2</mn></msqrt><mo lspace="0em" rspace="0em">​</mo><msub><mi>B</mi><mi>κ</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝔼</mi><mi class="ltx_mathvariant_bold-italic" mathvariant="bold-italic">ϵ</mi></msub><mo lspace="0.167em" rspace="0em">​</mo><mrow><munder><mo movablelimits="false" rspace="0.167em">sup</mo><mtable><mtr><mtd><mrow><mrow><msubsup><mi>x</mi><mi>k</mi><mi>L</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo mathsize="0.710em">,</mo><msubsup><mi mathvariant="normal">Θ</mi><mi>L</mi><mi>total</mi></msubsup><mo stretchy="false">)</mo></mrow></mrow><mo>∈</mo><msubsup><mi class="ltx_font_mathcaligraphic">ℱ</mi><mi>k</mi><mi>L</mi></msubsup></mrow></mtd></mtr></mtable></munder><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>S</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>s</mi><mo>=</mo><mn>1</mn></mrow><mi>S</mi></munderover></mstyle><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>k</mi><mo>=</mo><mn>1</mn></mrow><mi>n</mi></munderover></mstyle><mrow><msub><mi>ϵ</mi><mrow><mo stretchy="false">(</mo><mrow><mi>s</mi><mo lspace="0em" rspace="0em">​</mo><mi>k</mi></mrow><mo stretchy="false">)</mo></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>x</mi><mi>k</mi><mi>L</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>d</mi><mrow><mo stretchy="false">(</mo><mi>s</mi><mo stretchy="false">)</mo></mrow></msub><mo>,</mo><msubsup><mi mathvariant="normal">Θ</mi><mi>L</mi><mi>total</mi></msubsup><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\sqrt{2}B_{\kappa}\mathbb{E}_{\boldsymbol{\epsilon}}\sup_{\begin{subarray}{c}\mathrm{x}^{L}_{k}(\cdot;{\Theta}^{\rm total}_{L})\in{\mathcal{F}}^{L}_{k}\end{subarray}}\frac{1}{S}\sum_{s=1}^{S}\sum_{k=1}^{n}\epsilon_{(sk)}\mathrm{x}^{L}_{k}(\mathrm{d}_{(s)};{\Theta}^{\rm total}_{L})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="S4.Ex34"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S4.Ex34.m1" class="ltx_Math" alttext="\displaystyle\leq" display="inline" intent=":literal"><semantics><mo>≤</mo><annotation encoding="application/x-tex">\displaystyle\leq</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S4.Ex34.m2" class="ltx_math_unparsed" alttext="\displaystyle\sqrt{2}B_{\kappa}\sum_{k=1}^{n}\mathbb{E}_{\boldsymbol{\epsilon}_{k,:}}\sup_{\begin{subarray}{c}\mathrm{x}^{L}_{k}(\cdot;{\Theta}^{\rm total}_{L})\in{\mathcal{F}}^{L}_{k}\end{subarray}}\frac{1}{S}\sum_{s=1}^{S}\epsilon_{(sk)}\mathrm{x}^{L}_{k}(\mathrm{d}_{(s)};{\Theta}^{\rm total}_{L})" display="inline" intent=":literal"><semantics><mrow><msqrt><mn>2</mn></msqrt><msub><mi>B</mi><mi>κ</mi></msub><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>k</mi><mo>=</mo><mn>1</mn></mrow><mi>n</mi></munderover></mstyle><msub><mi>𝔼</mi><mrow><mi class="ltx_mathvariant_bold-italic" mathvariant="bold-italic">ϵ</mi><msub><mrow></mrow><mrow><mi>k</mi><mo>,</mo><mo>:</mo></mrow></msub></mrow></msub><munder><mo lspace="0.167em" movablelimits="false" rspace="0.167em">sup</mo><mtable><mtr><mtd><mrow><mrow><msubsup><mi>x</mi><mi>k</mi><mi>L</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo mathsize="0.710em">,</mo><msubsup><mi mathvariant="normal">Θ</mi><mi>L</mi><mi>total</mi></msubsup><mo stretchy="false">)</mo></mrow></mrow><mo>∈</mo><msubsup><mi class="ltx_font_mathcaligraphic">ℱ</mi><mi>k</mi><mi>L</mi></msubsup></mrow></mtd></mtr></mtable></munder><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>S</mi></mfrac></mstyle><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>s</mi><mo>=</mo><mn>1</mn></mrow><mi>S</mi></munderover></mstyle><msub><mi>ϵ</mi><mrow><mo stretchy="false">(</mo><mrow><mi>s</mi><mo lspace="0em" rspace="0em">​</mo><mi>k</mi></mrow><mo stretchy="false">)</mo></mrow></msub><msubsup><mi>x</mi><mi>k</mi><mi>L</mi></msubsup><mrow><mo stretchy="false">(</mo><msub><mi>d</mi><mrow><mo stretchy="false">(</mo><mi>s</mi><mo stretchy="false">)</mo></mrow></msub><mo>;</mo><msubsup><mi mathvariant="normal">Θ</mi><mi>L</mi><mi>total</mi></msubsup><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\sqrt{2}B_{\kappa}\sum_{k=1}^{n}\mathbb{E}_{\boldsymbol{\epsilon}_{k,:}}\sup_{\begin{subarray}{c}\mathrm{x}^{L}_{k}(\cdot;{\Theta}^{\rm total}_{L})\in{\mathcal{F}}^{L}_{k}\end{subarray}}\frac{1}{S}\sum_{s=1}^{S}\epsilon_{(sk)}\mathrm{x}^{L}_{k}(\mathrm{d}_{(s)};{\Theta}^{\rm total}_{L})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="S4.E22"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S4.E22.m1" class="ltx_Math" alttext="\displaystyle=" display="inline" intent=":literal"><semantics><mo>=</mo><annotation encoding="application/x-tex">\displaystyle=</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S4.E22.m2" class="ltx_Math" alttext="\displaystyle\sqrt{2}B_{\kappa}\sum_{k=1}^{n}\mathscr{R}_{\mathcal{S}}({\mathcal{F}}^{L}_{k})," display="inline" intent=":literal"><semantics><mrow><mrow><msqrt><mn>2</mn></msqrt><mo lspace="0em" rspace="0em">​</mo><msub><mi>B</mi><mi>κ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>k</mi><mo>=</mo><mn>1</mn></mrow><mi>n</mi></munderover></mstyle><mrow><msub><mi class="ltx_font_mathscript">ℛ</mi><mi class="ltx_font_mathcaligraphic">𝒮</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msubsup><mi class="ltx_font_mathcaligraphic">ℱ</mi><mi>k</mi><mi>L</mi></msubsup><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\sqrt{2}B_{\kappa}\sum_{k=1}^{n}\mathscr{R}_{\mathcal{S}}({\mathcal{F}}^{L}_{k}),</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(22)</span></td></tr></tbody>
</table>
<p id="S4.SS2.p11.2" class="ltx_p"><span id="S4.SS2.p11.2.1" class="ltx_text">where <math id="S4.SS2.p11.m8" class="ltx_math_unparsed" alttext="\boldsymbol{\epsilon}_{k,:}=\{\epsilon_{1k},\ldots,\epsilon_{Sk}\}" display="inline" intent=":literal"><semantics><mrow><msub><mi class="ltx_mathvariant_bold-italic" mathvariant="bold-italic">ϵ</mi><mrow><mi>k</mi><mo>,</mo><mo>:</mo></mrow></msub><mo>=</mo><mrow><mo stretchy="false">{</mo><msub><mi>ϵ</mi><mrow><mn>1</mn><mo lspace="0em" rspace="0em">​</mo><mi>k</mi></mrow></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>ϵ</mi><mrow><mi>S</mi><mo lspace="0em" rspace="0em">​</mo><mi>k</mi></mrow></msub><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">\boldsymbol{\epsilon}_{k,:}=\{\epsilon_{1k},\ldots,\epsilon_{Sk}\}</annotation></semantics></math>, the first inequality follows from <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib38" title="" class="ltx_ref">35</a>, Corollary 1]</cite>.</span></p>
</div>
<div id="S4.SS2.p12" class="ltx_para">
<p id="S4.SS2.p12.1" class="ltx_p"><span id="S4.SS2.p12.1.1" class="ltx_text">Step 3. We estimate the Rademacher complexity
<math id="S4.SS2.p12.m1" class="ltx_Math" alttext="\mathscr{R}_{\mathcal{S}}({\mathcal{F}}^{L}_{k})" display="inline" intent=":literal"><semantics><mrow><msub><mi class="ltx_font_mathscript">ℛ</mi><mi class="ltx_font_mathcaligraphic">𝒮</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msubsup><mi class="ltx_font_mathcaligraphic">ℱ</mi><mi>k</mi><mi>L</mi></msubsup><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathscr{R}_{\mathcal{S}}({\mathcal{F}}^{L}_{k})</annotation></semantics></math> for <math id="S4.SS2.p12.m2" class="ltx_Math" alttext="1\leq k\leq n" display="inline" intent=":literal"><semantics><mrow><mn>1</mn><mo>≤</mo><mi>k</mi><mo>≤</mo><mi>n</mi></mrow><annotation encoding="application/x-tex">1\leq k\leq n</annotation></semantics></math>. This step is the core of the analysis.</span></p>
</div>
<div id="S4.SS2.p13" class="ltx_para">
<p id="S4.SS2.p13.1" class="ltx_p"><span id="S4.SS2.p13.1.1" class="ltx_text">By Lemma <a href="#Thmtheorem13" title="Lemma 13. ‣ 4.2 Proof of Theorem ‣ 4 Proofs ‣ On the Generalization Behavior of Deep Residual Networks From a Dynamical System Perspective" class="ltx_ref"><span class="ltx_text ltx_ref_tag">13</span></a>, it suffices to estimate <math id="S4.SS2.p13.m1" class="ltx_Math" alttext="\mathscr{R}_{\mathcal{S}}({\mathcal{F}}^{L}_{1})" display="inline" intent=":literal"><semantics><mrow><msub><mi class="ltx_font_mathscript">ℛ</mi><mi class="ltx_font_mathcaligraphic">𝒮</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msubsup><mi class="ltx_font_mathcaligraphic">ℱ</mi><mn>1</mn><mi>L</mi></msubsup><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathscr{R}_{\mathcal{S}}({\mathcal{F}}^{L}_{1})</annotation></semantics></math>.
For simplicity, define</span></p>
<table id="S4.Ex35" class="ltx_equationgroup ltx_eqn_table">

<tbody id="S4.Ex35X"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S4.Ex35X.m2" class="ltx_Math" alttext="\displaystyle\mathrm{z}^{l+1}(\mathrm{d};{\Theta}^{\rm total}_{L})" display="inline" intent=":literal"><semantics><mrow><msup><mi>z</mi><mrow><mi>l</mi><mo>+</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>d</mi><mo>,</mo><msubsup><mi mathvariant="normal">Θ</mi><mi>L</mi><mi>total</mi></msubsup><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\mathrm{z}^{l+1}(\mathrm{d};{\Theta}^{\rm total}_{L})</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S4.Ex35X.m3" class="ltx_Math" alttext="\displaystyle=\mathrm{V}^{l}\mathrm{x}^{l}(\mathrm{d};{\Theta}^{\rm total}_{L})+\mathrm{b}^{l},0\leq l\leq L-1." display="inline" intent=":literal"><semantics><mrow><mo>=</mo><mi>V</mi><msup><mrow></mrow><mi>l</mi></msup><mi>x</mi><msup><mrow></mrow><mi>l</mi></msup><mo stretchy="false">(</mo><mi>d</mi><mo>;</mo><mi mathvariant="normal">Θ</mi><msup><mrow></mrow><mi>total</mi></msup><msub><mrow></mrow><mi>L</mi></msub><mo stretchy="false">)</mo><mo>+</mo><mi>b</mi><msup><mrow></mrow><mi>l</mi></msup><mo>,</mo><mn>0</mn><mo>≤</mo><mi>l</mi><mo>≤</mo><mi>L</mi><mo>−</mo><mn>1</mn><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle=\mathrm{V}^{l}\mathrm{x}^{l}(\mathrm{d};{\Theta}^{\rm total}_{L})+\mathrm{b}^{l},0\leq l\leq L-1.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S4.SS2.p13.2" class="ltx_p"><span id="S4.SS2.p13.2.1" class="ltx_text">By Lemma <a href="#Thmtheorem13" title="Lemma 13. ‣ 4.2 Proof of Theorem ‣ 4 Proofs ‣ On the Generalization Behavior of Deep Residual Networks From a Dynamical System Perspective" class="ltx_ref"><span class="ltx_text ltx_ref_tag">13</span></a> and its proof, we can see each component of <math id="S4.SS2.p13.m2" class="ltx_Math" alttext="\mathrm{z}^{l+1}(\cdot;{\Theta}^{\rm total}_{L})" display="inline" intent=":literal"><semantics><mrow><msup><mi>z</mi><mrow><mi>l</mi><mo>+</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo>,</mo><msubsup><mi mathvariant="normal">Θ</mi><mi>L</mi><mi>total</mi></msubsup><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathrm{z}^{l+1}(\cdot;{\Theta}^{\rm total}_{L})</annotation></semantics></math> (i.e., <math id="S4.SS2.p13.m3" class="ltx_Math" alttext="\mathrm{z}^{l+1}_{k}(\cdot;{\Theta}^{\rm total}_{L})" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>z</mi><mi>k</mi><mrow><mi>l</mi><mo>+</mo><mn>1</mn></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo>,</mo><msubsup><mi mathvariant="normal">Θ</mi><mi>L</mi><mi>total</mi></msubsup><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathrm{z}^{l+1}_{k}(\cdot;{\Theta}^{\rm total}_{L})</annotation></semantics></math>, <math id="S4.SS2.p13.m4" class="ltx_Math" alttext="1\leq k\leq m" display="inline" intent=":literal"><semantics><mrow><mn>1</mn><mo>≤</mo><mi>k</mi><mo>≤</mo><mi>m</mi></mrow><annotation encoding="application/x-tex">1\leq k\leq m</annotation></semantics></math>) is in the same function class</span></p>
<table id="S4.Ex36" class="ltx_equationgroup ltx_eqn_table">

<tbody id="S4.Ex36X"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S4.Ex36X.m2" class="ltx_Math" alttext="\displaystyle\mathcal{Z}^{l+1}:=\Big\{\mathrm{v}^{\top}\mathrm{x}^{l}(\cdot;{\Theta}^{\rm total}_{L})+b|\ \mathrm{v}\in\mathbb{R}^{n},b\in\mathbb{R},\max\{\|\mathrm{v}\|_{1},|b|\}\!\leq\!B_{\boldsymbol{\Theta}};\mathrm{x}^{l}(\cdot;{\Theta}^{\rm total}_{L})\in\mathcal{F}^{l}\Big\}." display="inline" intent=":literal"><semantics><mrow><mi class="ltx_font_mathcaligraphic">𝒵</mi><msup><mrow></mrow><mrow><mi>l</mi><mo>+</mo><mn>1</mn></mrow></msup><mo>:=</mo><mo stretchy="false">{</mo><mi>v</mi><msup><mrow></mrow><mo>⊤</mo></msup><mi>x</mi><msup><mrow></mrow><mi>l</mi></msup><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo>;</mo><mi mathvariant="normal">Θ</mi><msup><mrow></mrow><mi>total</mi></msup><msub><mrow></mrow><mi>L</mi></msub><mo stretchy="false">)</mo><mo>+</mo><mi>b</mi><mo fence="false" rspace="0.667em" stretchy="false">|</mo><mi>v</mi><mo>∈</mo><mi>ℝ</mi><msup><mrow></mrow><mi>n</mi></msup><mo>,</mo><mi>b</mi><mo>∈</mo><mi>ℝ</mi><mo>,</mo><mi>max</mi><mo stretchy="false">{</mo><mo lspace="0em" rspace="0.167em">∥</mo><mi>v</mi><mo lspace="0em" rspace="0.167em">∥</mo><msub><mrow></mrow><mn>1</mn></msub><mo>,</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>b</mi><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mo stretchy="false">}</mo><mo lspace="0.108em" rspace="0.108em">≤</mo><mi>B</mi><msub><mrow></mrow><mi>𝚯</mi></msub><mo>;</mo><mi>x</mi><msup><mrow></mrow><mi>l</mi></msup><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo>;</mo><mi mathvariant="normal">Θ</mi><msup><mrow></mrow><mi>total</mi></msup><msub><mrow></mrow><mi>L</mi></msub><mo stretchy="false">)</mo><mo>∈</mo><mi class="ltx_font_mathcaligraphic">ℱ</mi><msup><mrow></mrow><mi>l</mi></msup><mo stretchy="false">}</mo><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\mathcal{Z}^{l+1}:=\Big\{\mathrm{v}^{\top}\mathrm{x}^{l}(\cdot;{\Theta}^{\rm total}_{L})+b|\ \mathrm{v}\in\mathbb{R}^{n},b\in\mathbb{R},\max\{\|\mathrm{v}\|_{1},|b|\}\!\leq\!B_{\boldsymbol{\Theta}};\mathrm{x}^{l}(\cdot;{\Theta}^{\rm total}_{L})\in\mathcal{F}^{l}\Big\}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S4.SS2.p13.3" class="ltx_p"><span id="S4.SS2.p13.3.1" class="ltx_text">Therefore, we can derive that</span></p>
<table id="S4.EGx3" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="S4.Ex37"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S4.Ex37.m1" class="ltx_Math" alttext="\displaystyle\mathscr{R}_{\mathcal{S}}({\mathcal{F}}^{l+1}_{1})=\frac{1}{S}\mathbb{E}_{\boldsymbol{\varepsilon}}\sup_{\mathrm{x}^{l+1}_{1}(\cdot;{\Theta}^{\rm total}_{L})\in{\mathcal{F}}^{l+1}_{1}}\sum_{s=1}^{S}\!\varepsilon_{(s)}\mathrm{x}^{l+1}_{1}(\mathrm{d}_{(s)};{\Theta}^{\rm total}_{L})" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi class="ltx_font_mathscript">ℛ</mi><mi class="ltx_font_mathcaligraphic">𝒮</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msubsup><mi class="ltx_font_mathcaligraphic">ℱ</mi><mn>1</mn><mrow><mi>l</mi><mo>+</mo><mn>1</mn></mrow></msubsup><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>S</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝔼</mi><mi>𝜺</mi></msub><mo lspace="0.167em" rspace="0em">​</mo><mrow><munder><mo movablelimits="false" rspace="0.167em">sup</mo><mrow><mrow><msubsup><mi>x</mi><mn>1</mn><mrow><mi>l</mi><mo>+</mo><mn>1</mn></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo>,</mo><msubsup><mi mathvariant="normal">Θ</mi><mi>L</mi><mi>total</mi></msubsup><mo stretchy="false">)</mo></mrow></mrow><mo>∈</mo><msubsup><mi class="ltx_font_mathcaligraphic">ℱ</mi><mn>1</mn><mrow><mi>l</mi><mo>+</mo><mn>1</mn></mrow></msubsup></mrow></munder><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>s</mi><mo>=</mo><mn>1</mn></mrow><mi>S</mi></munderover></mstyle><mrow><msub><mi>ε</mi><mrow><mo stretchy="false">(</mo><mi>s</mi><mo stretchy="false">)</mo></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>x</mi><mn>1</mn><mrow><mi>l</mi><mo>+</mo><mn>1</mn></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>d</mi><mrow><mo stretchy="false">(</mo><mi>s</mi><mo stretchy="false">)</mo></mrow></msub><mo>,</mo><msubsup><mi mathvariant="normal">Θ</mi><mi>L</mi><mi>total</mi></msubsup><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\mathscr{R}_{\mathcal{S}}({\mathcal{F}}^{l+1}_{1})=\frac{1}{S}\mathbb{E}_{\boldsymbol{\varepsilon}}\sup_{\mathrm{x}^{l+1}_{1}(\cdot;{\Theta}^{\rm total}_{L})\in{\mathcal{F}}^{l+1}_{1}}\sum_{s=1}^{S}\!\varepsilon_{(s)}\mathrm{x}^{l+1}_{1}(\mathrm{d}_{(s)};{\Theta}^{\rm total}_{L})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="S4.Ex38"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S4.Ex38.m1" class="ltx_Math" alttext="\displaystyle=" display="inline" intent=":literal"><semantics><mo>=</mo><annotation encoding="application/x-tex">\displaystyle=</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S4.Ex38.m2" class="ltx_math_unparsed" alttext="\displaystyle\frac{1}{S}\mathbb{E}_{\boldsymbol{\varepsilon}}\sup_{\begin{subarray}{c}\mathrm{x}^{l}(\cdot;{\Theta}^{\rm total}_{L})\in{\mathcal{F}}^{l}_{,}\\
\max\{|\mathrm{c}^{l}_{1}|,\|\mathrm{W}_{1,:}^{l}\|_{1}\}\leq B_{\boldsymbol{\Theta}},\\
\max\{\|\mathrm{V}^{l}\|_{\infty},\|\mathrm{b}^{l}\|_{\infty}\}\leq B_{\boldsymbol{\Theta}}\end{subarray}}\!\sum_{s=1}^{S}\!\varepsilon_{(s)}\!\Big[\mathrm{x}^{l}_{1}(\mathrm{d}_{(s)};{\Theta}^{\rm total}_{L})\!+\!\tau_{L}\Big(\mathrm{W}_{1,:}^{l}\psi\circ\big(\mathrm{V}^{l}\mathrm{x}^{l}(\mathrm{d}_{(s)};{\Theta}^{\rm total}_{L})\!+\!\mathrm{b}^{l}\big)\!+\!\mathrm{c}^{l}_{1}\Big)\Big]" display="inline" intent=":literal"><semantics><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>S</mi></mfrac></mstyle><msub><mi>𝔼</mi><mi>𝜺</mi></msub><munder><mo lspace="0.167em" movablelimits="false" rspace="0.167em">sup</mo><mtable rowspacing="0pt"><mtr><mtd><mrow><mi>x</mi><msup><mrow></mrow><mi>l</mi></msup><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo>;</mo><mi mathvariant="normal">Θ</mi><msup><mrow></mrow><mi>total</mi></msup><msub><mrow></mrow><mi>L</mi></msub><mo stretchy="false">)</mo><mo>∈</mo><mi class="ltx_font_mathcaligraphic">ℱ</mi><msup><mrow></mrow><mi>l</mi></msup><msub><mrow></mrow><mo>,</mo></msub></mrow></mtd></mtr><mtr><mtd><mrow><mi>max</mi><mo stretchy="false">{</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>c</mi><msup><mrow></mrow><mi>l</mi></msup><msub><mrow></mrow><mn>1</mn></msub><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mo>,</mo><mo lspace="0em" rspace="0.167em">∥</mo><mi>W</mi><msub><mrow></mrow><mrow><mn>1</mn><mo>,</mo><mo>:</mo></mrow></msub><msup><mrow></mrow><mi>l</mi></msup><mo lspace="0em" rspace="0.167em">∥</mo><msub><mrow></mrow><mn>1</mn></msub><mo stretchy="false">}</mo><mo>≤</mo><mi>B</mi><msub><mrow></mrow><mi>𝚯</mi></msub><mo>,</mo></mrow></mtd></mtr><mtr><mtd><mrow><mrow><mi>max</mi><mo>⁡</mo><mrow><mo stretchy="false">{</mo><msub><mrow><mo stretchy="false">‖</mo><msup><mi>V</mi><mi>l</mi></msup><mo stretchy="false">‖</mo></mrow><mi mathvariant="normal">∞</mi></msub><mo>,</mo><msub><mrow><mo stretchy="false">‖</mo><msup><mi>b</mi><mi>l</mi></msup><mo stretchy="false">‖</mo></mrow><mi mathvariant="normal">∞</mi></msub><mo stretchy="false">}</mo></mrow></mrow><mo>≤</mo><msub><mi>B</mi><mi>𝚯</mi></msub></mrow></mtd></mtr></mtable></munder><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>s</mi><mo>=</mo><mn>1</mn></mrow><mi>S</mi></munderover></mstyle><msub><mi>ε</mi><mrow><mo stretchy="false">(</mo><mi>s</mi><mo stretchy="false">)</mo></mrow></msub><mrow><mo maxsize="1.600em" minsize="1.600em">[</mo><msubsup><mi>x</mi><mn>1</mn><mi>l</mi></msubsup><mrow><mo stretchy="false">(</mo><msub><mi>d</mi><mrow><mo stretchy="false">(</mo><mi>s</mi><mo stretchy="false">)</mo></mrow></msub><mo>;</mo><msubsup><mi mathvariant="normal">Θ</mi><mi>L</mi><mi>total</mi></msubsup><mo stretchy="false">)</mo></mrow><mo lspace="0.052em" rspace="0.052em">+</mo><msub><mi>τ</mi><mi>L</mi></msub><mrow><mo maxsize="1.600em" minsize="1.600em">(</mo><msubsup><mi>W</mi><mrow><mn>1</mn><mo>,</mo><mo>:</mo></mrow><mi>l</mi></msubsup><mi>ψ</mi><mo lspace="0.222em" rspace="0.222em">∘</mo><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><msup><mi>V</mi><mi>l</mi></msup><msup><mi>x</mi><mi>l</mi></msup><mrow><mo stretchy="false">(</mo><msub><mi>d</mi><mrow><mo stretchy="false">(</mo><mi>s</mi><mo stretchy="false">)</mo></mrow></msub><mo>;</mo><msubsup><mi mathvariant="normal">Θ</mi><mi>L</mi><mi>total</mi></msubsup><mo stretchy="false">)</mo></mrow><mo lspace="0.052em" rspace="0.052em">+</mo><msup><mi>b</mi><mi>l</mi></msup><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow><mo lspace="0.052em" rspace="0.052em">+</mo><msubsup><mi>c</mi><mn>1</mn><mi>l</mi></msubsup><mo maxsize="1.600em" minsize="1.600em">)</mo></mrow><mo maxsize="1.600em" minsize="1.600em">]</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\frac{1}{S}\mathbb{E}_{\boldsymbol{\varepsilon}}\sup_{\begin{subarray}{c}\mathrm{x}^{l}(\cdot;{\Theta}^{\rm total}_{L})\in{\mathcal{F}}^{l}_{,}\\
\max\{|\mathrm{c}^{l}_{1}|,\|\mathrm{W}_{1,:}^{l}\|_{1}\}\leq B_{\boldsymbol{\Theta}},\\
\max\{\|\mathrm{V}^{l}\|_{\infty},\|\mathrm{b}^{l}\|_{\infty}\}\leq B_{\boldsymbol{\Theta}}\end{subarray}}\!\sum_{s=1}^{S}\!\varepsilon_{(s)}\!\Big[\mathrm{x}^{l}_{1}(\mathrm{d}_{(s)};{\Theta}^{\rm total}_{L})\!+\!\tau_{L}\Big(\mathrm{W}_{1,:}^{l}\psi\circ\big(\mathrm{V}^{l}\mathrm{x}^{l}(\mathrm{d}_{(s)};{\Theta}^{\rm total}_{L})\!+\!\mathrm{b}^{l}\big)\!+\!\mathrm{c}^{l}_{1}\Big)\Big]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="S4.Ex39"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S4.Ex39.m1" class="ltx_Math" alttext="\displaystyle\leq" display="inline" intent=":literal"><semantics><mo>≤</mo><annotation encoding="application/x-tex">\displaystyle\leq</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S4.Ex39.m2" class="ltx_math_unparsed" alttext="\displaystyle\frac{1}{S}\mathbb{E}_{\boldsymbol{\varepsilon}}\sup_{\begin{subarray}{c}\mathrm{x}^{l}_{1}(\cdot;{\Theta}^{\rm total}_{L})\in{\mathcal{F}}^{l}_{1},\\
\max\{|\mathrm{c}^{l}_{1}|,\|\mathrm{W}_{1,:}^{l}\|_{1}\}\leq B_{\boldsymbol{\Theta}},\\
\mathrm{z}^{l+1}(\cdot;{\Theta}^{\rm total}_{L})\in(\mathcal{Z}^{l+1})^{m}\end{subarray}}\sum_{s=1}^{S}\varepsilon_{(s)}\Big[\mathrm{x}^{l}_{1}(\mathrm{d}_{(s)};{\Theta}^{\rm total}_{L})+\tau_{L}\Big(\mathrm{W}_{1,:}^{l}\psi\circ(\mathrm{z}^{l+1}(\mathrm{d}_{(s)};{\Theta}^{\rm total}_{L}))+\mathrm{c}^{l}_{1}\Big)\Big]" display="inline" intent=":literal"><semantics><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>S</mi></mfrac></mstyle><msub><mi>𝔼</mi><mi>𝜺</mi></msub><munder><mo lspace="0.167em" movablelimits="false" rspace="0.167em">sup</mo><mtable rowspacing="0pt"><mtr><mtd><mrow><mrow><mrow><msubsup><mi>x</mi><mn>1</mn><mi>l</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo>,</mo><msubsup><mi mathvariant="normal">Θ</mi><mi>L</mi><mi>total</mi></msubsup><mo stretchy="false">)</mo></mrow></mrow><mo>∈</mo><msubsup><mi class="ltx_font_mathcaligraphic">ℱ</mi><mn>1</mn><mi>l</mi></msubsup></mrow><mo>,</mo></mrow></mtd></mtr><mtr><mtd><mrow><mi>max</mi><mo stretchy="false">{</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>c</mi><msup><mrow></mrow><mi>l</mi></msup><msub><mrow></mrow><mn>1</mn></msub><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mo>,</mo><mo lspace="0em" rspace="0.167em">∥</mo><mi>W</mi><msub><mrow></mrow><mrow><mn>1</mn><mo>,</mo><mo>:</mo></mrow></msub><msup><mrow></mrow><mi>l</mi></msup><mo lspace="0em" rspace="0.167em">∥</mo><msub><mrow></mrow><mn>1</mn></msub><mo stretchy="false">}</mo><mo>≤</mo><mi>B</mi><msub><mrow></mrow><mi>𝚯</mi></msub><mo>,</mo></mrow></mtd></mtr><mtr><mtd><mrow><mrow><msup><mi>z</mi><mrow><mi>l</mi><mo>+</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo mathsize="0.710em">,</mo><msubsup><mi mathvariant="normal">Θ</mi><mi>L</mi><mi>total</mi></msubsup><mo stretchy="false">)</mo></mrow></mrow><mo>∈</mo><msup><mrow><mo stretchy="false">(</mo><msup><mi class="ltx_font_mathcaligraphic">𝒵</mi><mrow><mi>l</mi><mo>+</mo><mn>1</mn></mrow></msup><mo stretchy="false">)</mo></mrow><mi>m</mi></msup></mrow></mtd></mtr></mtable></munder><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>s</mi><mo>=</mo><mn>1</mn></mrow><mi>S</mi></munderover></mstyle><msub><mi>ε</mi><mrow><mo stretchy="false">(</mo><mi>s</mi><mo stretchy="false">)</mo></mrow></msub><mrow><mo maxsize="1.600em" minsize="1.600em">[</mo><msubsup><mi>x</mi><mn>1</mn><mi>l</mi></msubsup><mrow><mo stretchy="false">(</mo><msub><mi>d</mi><mrow><mo stretchy="false">(</mo><mi>s</mi><mo stretchy="false">)</mo></mrow></msub><mo>;</mo><msubsup><mi mathvariant="normal">Θ</mi><mi>L</mi><mi>total</mi></msubsup><mo stretchy="false">)</mo></mrow><mo>+</mo><msub><mi>τ</mi><mi>L</mi></msub><mrow><mo maxsize="1.600em" minsize="1.600em">(</mo><msubsup><mi>W</mi><mrow><mn>1</mn><mo>,</mo><mo>:</mo></mrow><mi>l</mi></msubsup><mi>ψ</mi><mo lspace="0.222em" rspace="0.222em">∘</mo><mrow><mo stretchy="false">(</mo><msup><mi>z</mi><mrow><mi>l</mi><mo>+</mo><mn>1</mn></mrow></msup><mrow><mo stretchy="false">(</mo><msub><mi>d</mi><mrow><mo stretchy="false">(</mo><mi>s</mi><mo stretchy="false">)</mo></mrow></msub><mo>;</mo><msubsup><mi mathvariant="normal">Θ</mi><mi>L</mi><mi>total</mi></msubsup><mo stretchy="false">)</mo></mrow><mo stretchy="false">)</mo></mrow><mo>+</mo><msubsup><mi>c</mi><mn>1</mn><mi>l</mi></msubsup><mo maxsize="1.600em" minsize="1.600em">)</mo></mrow><mo maxsize="1.600em" minsize="1.600em">]</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\frac{1}{S}\mathbb{E}_{\boldsymbol{\varepsilon}}\sup_{\begin{subarray}{c}\mathrm{x}^{l}_{1}(\cdot;{\Theta}^{\rm total}_{L})\in{\mathcal{F}}^{l}_{1},\\
\max\{|\mathrm{c}^{l}_{1}|,\|\mathrm{W}_{1,:}^{l}\|_{1}\}\leq B_{\boldsymbol{\Theta}},\\
\mathrm{z}^{l+1}(\cdot;{\Theta}^{\rm total}_{L})\in(\mathcal{Z}^{l+1})^{m}\end{subarray}}\sum_{s=1}^{S}\varepsilon_{(s)}\Big[\mathrm{x}^{l}_{1}(\mathrm{d}_{(s)};{\Theta}^{\rm total}_{L})+\tau_{L}\Big(\mathrm{W}_{1,:}^{l}\psi\circ(\mathrm{z}^{l+1}(\mathrm{d}_{(s)};{\Theta}^{\rm total}_{L}))+\mathrm{c}^{l}_{1}\Big)\Big]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
