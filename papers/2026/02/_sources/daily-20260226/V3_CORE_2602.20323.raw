<div id="lstnumberx1355" class="ltx_listingline"><span id="lstnumberx1355.1" class="ltx_text ltx_lst_identifier">Example</span><span id="lstnumberx1355.2" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx1355.3" class="ltx_text ltx_lst_identifier">format</span><span id="lstnumberx1355.4" class="ltx_text ltx_lst_space"> </span>(<span id="lstnumberx1355.5" class="ltx_text ltx_lst_identifier">using</span><span id="lstnumberx1355.6" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx1355.7" class="ltx_text ltx_lst_identifier">surface</span>/<span id="lstnumberx1355.8" class="ltx_text ltx_lst_identifier">shape</span>/<span id="lstnumberx1355.9" class="ltx_text ltx_lst_identifier">orientation</span><span id="lstnumberx1355.10" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx1355.11" class="ltx_text ltx_lst_identifier">naming</span>):
</div>
<div id="lstnumberx1356" class="ltx_listingline">1.<span id="lstnumberx1356.1" class="ltx_text ltx_lst_space"> </span>[95%]<span id="lstnumberx1356.2" class="ltx_text ltx_lst_space"> </span>[<span id="lstnumberx1356.3" class="ltx_text ltx_lst_identifier">REQUIRE</span>]<span id="lstnumberx1356.4" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx1356.5" class="ltx_text ltx_lst_identifier">Step</span><span id="lstnumberx1356.6" class="ltx_text ltx_lst_space"> </span>1<span id="lstnumberx1356.7" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx1356.8" class="ltx_text ltx_lst_identifier">base</span>:<span id="lstnumberx1356.9" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx1356.10" class="ltx_text ltx_lst_identifier">Select</span><span id="lstnumberx1356.11" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx1356.12" class="ltx_text ltx_lst_identifier">LARGEST</span><span id="lstnumberx1356.13" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx1356.14" class="ltx_text ltx_lst_identifier">stone</span><span id="lstnumberx1356.15" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx1356.16" class="ltx_text ltx_lst_identifier">with</span><span id="lstnumberx1356.17" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx1356.18" class="ltx_text ltx_lst_identifier">HIGHEST</span>
</div>
<div id="lstnumberx1357" class="ltx_listingline"><span id="lstnumberx1357.1" class="ltx_text ltx_lst_space">   </span><span id="lstnumberx1357.2" class="ltx_text ltx_lst_identifier">friction</span><span id="lstnumberx1357.3" class="ltx_text ltx_lst_space"> </span>(3<span id="lstnumberx1357.4" class="ltx_text ltx_lst_identifier">M</span><span id="lstnumberx1357.5" class="ltx_text ltx_lst_space"> </span>&gt;<span id="lstnumberx1357.6" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx1357.7" class="ltx_text ltx_lst_identifier">BLK</span><span id="lstnumberx1357.8" class="ltx_text ltx_lst_space"> </span>&gt;<span id="lstnumberx1357.9" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx1357.10" class="ltx_text ltx_lst_identifier">WHT</span><span id="lstnumberx1357.11" class="ltx_text ltx_lst_space"> </span>&gt;<span id="lstnumberx1357.12" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx1357.13" class="ltx_text ltx_lst_identifier">WOOD</span><span id="lstnumberx1357.14" class="ltx_text ltx_lst_space"> </span>&gt;<span id="lstnumberx1357.15" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx1357.16" class="ltx_text ltx_lst_identifier">PAINT</span>),<span id="lstnumberx1357.17" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx1357.18" class="ltx_text ltx_lst_identifier">LARGEST</span><span id="lstnumberx1357.19" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx1357.20" class="ltx_text ltx_lst_identifier">contact</span><span id="lstnumberx1357.21" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx1357.22" class="ltx_text ltx_lst_identifier">area</span>.
</div>
<div id="lstnumberx1358" class="ltx_listingline"><span id="lstnumberx1358.1" class="ltx_text ltx_lst_space">   </span><span id="lstnumberx1358.2" class="ltx_text ltx_lst_identifier">NEVER</span><span id="lstnumberx1358.3" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx1358.4" class="ltx_text ltx_lst_identifier">select</span><span id="lstnumberx1358.5" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx1358.6" class="ltx_text ltx_lst_identifier">vertical</span><span id="lstnumberx1358.7" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx1358.8" class="ltx_text ltx_lst_identifier">bar</span><span id="lstnumberx1358.9" class="ltx_text ltx_lst_space"> </span>(<span id="lstnumberx1358.10" class="ltx_text ltx_lst_identifier">V</span>)<span id="lstnumberx1358.11" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx1358.12" class="ltx_text ltx_lst_identifier">orientation</span><span id="lstnumberx1358.13" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx1358.14" class="ltx_text ltx_lst_identifier">for</span><span id="lstnumberx1358.15" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx1358.16" class="ltx_text ltx_lst_identifier">base</span>.
