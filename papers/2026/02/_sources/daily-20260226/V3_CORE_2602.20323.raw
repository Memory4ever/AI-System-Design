<section id="A8.SS6" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection"><span id="A8.SS6.6" class="ltx_text">H-F</span> </span><span id="A8.SS6.7" class="ltx_text ltx_font_italic">Memory Injection Formatting</span></h3>

<div id="A8.SS6.p1" class="ltx_para">
<p id="A8.SS6.p1.1" class="ltx_p"><span id="A8.SS6.p1.1.1" class="ltx_text ltx_font_bold">Principle Formatting (Long-term Memory).</span>
Principles are formatted with confidence levels using a three-tier system:</p>
</div>
<div id="A8.SS6.p2" class="ltx_para">
<div id="A8.SS6.p2.1" class="ltx_listing ltx_lstlisting ltx_listing"><div class="ltx_listing_data"><a href="data:text/plain;base64,CjEuIFs5NSVdIFtTRVFVRU5DRV0gQWx3YXlzIHBsYWNlIHRoZSBsYXJnZXN0IHN0b25lIGFzIHRoZSBiYXNlLgoyLiBbODglXSBbQVZPSURdIEhpZ2gtc3BlZWQgcHVzaGVzIG5lYXIgb2JzdGFjbGVzIGNhdXNlIHJlYm91bmRzLgozLiBbODIlXSBbUFJFRkVSXSBQbGFjZSBMLXNoYXBlZCBwYXJ0cyBpbiBjb3JuZXJzIGZhY2luZyBpbndhcmQu" download="">⬇</a></div>
<div id="lstnumberx1557" class="ltx_listingline">
</div>
<div id="lstnumberx1558" class="ltx_listingline">1.<span id="lstnumberx1558.1" class="ltx_text ltx_lst_space"> </span>[95%]<span id="lstnumberx1558.2" class="ltx_text ltx_lst_space"> </span>[<span id="lstnumberx1558.3" class="ltx_text ltx_lst_identifier">SEQUENCE</span>]<span id="lstnumberx1558.4" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx1558.5" class="ltx_text ltx_lst_identifier">Always</span><span id="lstnumberx1558.6" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx1558.7" class="ltx_text ltx_lst_identifier">place</span><span id="lstnumberx1558.8" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx1558.9" class="ltx_text ltx_lst_identifier">the</span><span id="lstnumberx1558.10" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx1558.11" class="ltx_text ltx_lst_identifier">largest</span><span id="lstnumberx1558.12" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx1558.13" class="ltx_text ltx_lst_identifier">stone</span><span id="lstnumberx1558.14" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx1558.15" class="ltx_text ltx_lst_identifier">as</span><span id="lstnumberx1558.16" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx1558.17" class="ltx_text ltx_lst_identifier">the</span><span id="lstnumberx1558.18" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx1558.19" class="ltx_text ltx_lst_identifier">base</span>.
</div>
<div id="lstnumberx1559" class="ltx_listingline">2.<span id="lstnumberx1559.1" class="ltx_text ltx_lst_space"> </span>[88%]<span id="lstnumberx1559.2" class="ltx_text ltx_lst_space"> </span>[<span id="lstnumberx1559.3" class="ltx_text ltx_lst_identifier">AVOID</span>]<span id="lstnumberx1559.4" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx1559.5" class="ltx_text ltx_lst_identifier">High</span>-<span id="lstnumberx1559.6" class="ltx_text ltx_lst_identifier">speed</span><span id="lstnumberx1559.7" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx1559.8" class="ltx_text ltx_lst_identifier">pushes</span><span id="lstnumberx1559.9" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx1559.10" class="ltx_text ltx_lst_identifier">near</span><span id="lstnumberx1559.11" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx1559.12" class="ltx_text ltx_lst_identifier">obstacles</span><span id="lstnumberx1559.13" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx1559.14" class="ltx_text ltx_lst_identifier">cause</span><span id="lstnumberx1559.15" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx1559.16" class="ltx_text ltx_lst_identifier">rebounds</span>.
</div>
<div id="lstnumberx1560" class="ltx_listingline">3.<span id="lstnumberx1560.1" class="ltx_text ltx_lst_space"> </span>[82%]<span id="lstnumberx1560.2" class="ltx_text ltx_lst_space"> </span>[<span id="lstnumberx1560.3" class="ltx_text ltx_lst_identifier">PREFER</span>]<span id="lstnumberx1560.4" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx1560.5" class="ltx_text ltx_lst_identifier">Place</span><span id="lstnumberx1560.6" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx1560.7" class="ltx_text ltx_lst_identifier">L</span>-<span id="lstnumberx1560.8" class="ltx_text ltx_lst_identifier">shaped</span><span id="lstnumberx1560.9" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx1560.10" class="ltx_text ltx_lst_identifier">parts</span><span id="lstnumberx1560.11" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx1560.12" class="ltx_text ltx_lst_identifier">in</span><span id="lstnumberx1560.13" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx1560.14" class="ltx_text ltx_lst_identifier">corners</span><span id="lstnumberx1560.15" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx1560.16" class="ltx_text ltx_lst_identifier">facing</span><span id="lstnumberx1560.17" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx1560.18" class="ltx_text ltx_lst_identifier">inward</span>.
</div>
</div>
</div>
<div id="A8.SS6.p3" class="ltx_para">
<p id="A8.SS6.p3.1" class="ltx_p">Confidence display thresholds:</p>
<ul id="A8.I3" class="ltx_itemize ltx_leftmargin_flush">
<li id="A8.I3.i1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="A8.I3.i1.p1" class="ltx_para">
<p id="A8.I3.i1.p1.1" class="ltx_p"><span id="A8.I3.i1.p1.1.1" class="ltx_text ltx_font_bold">HIGH</span> (<math id="A8.I3.i1.p1.m1" class="ltx_Math" alttext="\geq 85\%" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≥</mo><mrow><mn>85</mn><mo>%</mo></mrow></mrow><annotation encoding="application/x-tex">\geq 85\%</annotation></semantics></math>): Strong evidence, should be followed</p>
</div></li>
<li id="A8.I3.i2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="A8.I3.i2.p1" class="ltx_para">
<p id="A8.I3.i2.p1.1" class="ltx_p"><span id="A8.I3.i2.p1.1.1" class="ltx_text ltx_font_bold">MEDIUM</span> (<math id="A8.I3.i2.p1.m1" class="ltx_Math" alttext="60\%" display="inline" intent=":literal"><semantics><mrow><mn>60</mn><mo>%</mo></mrow><annotation encoding="application/x-tex">60\%</annotation></semantics></math>–<math id="A8.I3.i2.p1.m2" class="ltx_Math" alttext="84\%" display="inline" intent=":literal"><semantics><mrow><mn>84</mn><mo>%</mo></mrow><annotation encoding="application/x-tex">84\%</annotation></semantics></math>): Moderate evidence, consider carefully</p>
</div></li>
<li id="A8.I3.i3" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="A8.I3.i3.p1" class="ltx_para">
<p id="A8.I3.i3.p1.1" class="ltx_p"><span id="A8.I3.i3.p1.1.1" class="ltx_text ltx_font_bold">LOW</span> (<math id="A8.I3.i3.p1.m1" class="ltx_Math" alttext="&lt;60\%" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>&lt;</mo><mrow><mn>60</mn><mo>%</mo></mrow></mrow><annotation encoding="application/x-tex">&lt;60\%</annotation></semantics></math>): Weak evidence, use with caution</p>
</div></li>
</ul>
</div>
<div id="A8.SS6.p4" class="ltx_para">
<p id="A8.SS6.p4.1" class="ltx_p"><span id="A8.SS6.p4.1.1" class="ltx_text ltx_font_bold">Hypothesis Formatting (Working Memory).</span>
Hypotheses are marked as under testing to indicate lower confidence:</p>
</div>
<div id="A8.SS6.p5" class="ltx_para">
<div id="A8.SS6.p5.1" class="ltx_listing ltx_lstlisting ltx_listing"><div class="ltx_listing_data"><a href="data:text/plain;base64,CjEuIFtURVNUSU5HXSBSb3VnaCBzdG9uZXMgZ3JpcCBzbW9vdGggc3RvbmVzIGJldHRlciB0aGFuIHZpY2UgdmVyc2EuCjIuIFtURVNUSU5HXSBNZWRpdW0gc3BlZWQgaXMgb3B0aW1hbCBmb3IgbW9zdCBiYWxsIG5hdmlnYXRpb24u" download="">⬇</a></div>
<div id="lstnumberx1561" class="ltx_listingline">
</div>
<div id="lstnumberx1562" class="ltx_listingline">1.<span id="lstnumberx1562.1" class="ltx_text ltx_lst_space"> </span>[<span id="lstnumberx1562.2" class="ltx_text ltx_lst_identifier">TESTING</span>]<span id="lstnumberx1562.3" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx1562.4" class="ltx_text ltx_lst_identifier">Rough</span><span id="lstnumberx1562.5" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx1562.6" class="ltx_text ltx_lst_identifier">stones</span><span id="lstnumberx1562.7" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx1562.8" class="ltx_text ltx_lst_identifier">grip</span><span id="lstnumberx1562.9" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx1562.10" class="ltx_text ltx_lst_identifier">smooth</span><span id="lstnumberx1562.11" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx1562.12" class="ltx_text ltx_lst_identifier">stones</span><span id="lstnumberx1562.13" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx1562.14" class="ltx_text ltx_lst_identifier">better</span><span id="lstnumberx1562.15" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx1562.16" class="ltx_text ltx_lst_identifier">than</span><span id="lstnumberx1562.17" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx1562.18" class="ltx_text ltx_lst_identifier">vice</span><span id="lstnumberx1562.19" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx1562.20" class="ltx_text ltx_lst_identifier">versa</span>.
</div>
<div id="lstnumberx1563" class="ltx_listingline">2.<span id="lstnumberx1563.1" class="ltx_text ltx_lst_space"> </span>[<span id="lstnumberx1563.2" class="ltx_text ltx_lst_identifier">TESTING</span>]<span id="lstnumberx1563.3" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx1563.4" class="ltx_text ltx_lst_identifier">Medium</span><span id="lstnumberx1563.5" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx1563.6" class="ltx_text ltx_lst_identifier">speed</span><span id="lstnumberx1563.7" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx1563.8" class="ltx_text ltx_lst_identifier">is</span><span id="lstnumberx1563.9" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx1563.10" class="ltx_text ltx_lst_identifier">optimal</span><span id="lstnumberx1563.11" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx1563.12" class="ltx_text ltx_lst_identifier">for</span><span id="lstnumberx1563.13" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx1563.14" class="ltx_text ltx_lst_identifier">most</span><span id="lstnumberx1563.15" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx1563.16" class="ltx_text ltx_lst_identifier">ball</span><span id="lstnumberx1563.17" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx1563.18" class="ltx_text ltx_lst_identifier">navigation</span>.
</div>
</div>
</div>
