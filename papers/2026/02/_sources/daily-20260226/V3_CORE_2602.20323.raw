<div id="lstnumberx1192" class="ltx_listingline"><span id="lstnumberx1192.1" class="ltx_text ltx_lst_identifier">You</span><span id="lstnumberx1192.2" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx1192.3" class="ltx_text ltx_lst_identifier">are</span><span id="lstnumberx1192.4" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx1192.5" class="ltx_text ltx_lst_identifier">a</span><span id="lstnumberx1192.6" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx1192.7" class="ltx_text ltx_lst_identifier">robot</span><span id="lstnumberx1192.8" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx1192.9" class="ltx_text ltx_lst_identifier">tasked</span><span id="lstnumberx1192.10" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx1192.11" class="ltx_text ltx_lst_identifier">with</span><span id="lstnumberx1192.12" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx1192.13" class="ltx_text ltx_lst_identifier">building</span><span id="lstnumberx1192.14" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx1192.15" class="ltx_text ltx_lst_identifier">a</span><span id="lstnumberx1192.16" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx1192.17" class="ltx_text ltx_lst_identifier">stable</span><span id="lstnumberx1192.18" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx1192.19" class="ltx_text ltx_lst_identifier">tower</span><span id="lstnumberx1192.20" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx1192.21" class="ltx_text ltx_lst_identifier">by</span><span id="lstnumberx1192.22" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx1192.23" class="ltx_text ltx_lst_identifier">stacking</span>
</div>
<div id="lstnumberx1193" class="ltx_listingline"><span id="lstnumberx1193.1" class="ltx_text ltx_lst_identifier">irregularly</span>-<span id="lstnumberx1193.2" class="ltx_text ltx_lst_identifier">shaped</span><span id="lstnumberx1193.3" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx1193.4" class="ltx_text ltx_lst_identifier">balance</span><span id="lstnumberx1193.5" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx1193.6" class="ltx_text ltx_lst_identifier">stones</span><span id="lstnumberx1193.7" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx1193.8" class="ltx_text ltx_lst_identifier">with</span><span id="lstnumberx1193.9" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx1193.10" class="ltx_text ltx_lst_identifier">varying</span><span id="lstnumberx1193.11" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx1193.12" class="ltx_text ltx_lst_identifier">friction</span><span id="lstnumberx1193.13" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx1193.14" class="ltx_text ltx_lst_identifier">surfaces</span>.
