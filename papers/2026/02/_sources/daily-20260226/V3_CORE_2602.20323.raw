</div>
<div id="lstnumberx660" class="ltx_listingline">2.<span id="lstnumberx660.1" class="ltx_text ltx_lst_space"> </span>[87%]<span id="lstnumberx660.2" class="ltx_text ltx_lst_space"> </span>[<span id="lstnumberx660.3" class="ltx_text ltx_lst_identifier">AVOID</span>]<span id="lstnumberx660.4" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx660.5" class="ltx_text ltx_lst_identifier">Repeated</span><span id="lstnumberx660.6" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx660.7" class="ltx_text ltx_lst_identifier">reorient</span><span id="lstnumberx660.8" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx660.9" class="ltx_text ltx_lst_identifier">actions</span><span id="lstnumberx660.10" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx660.11" class="ltx_text ltx_lst_identifier">on</span><span id="lstnumberx660.12" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx660.13" class="ltx_text ltx_lst_identifier">the</span><span id="lstnumberx660.14" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx660.15" class="ltx_text ltx_lst_identifier">same</span><span id="lstnumberx660.16" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx660.17" class="ltx_text ltx_lst_identifier">brick</span><span id="lstnumberx660.18" class="ltx_text ltx_lst_space"> </span>-
