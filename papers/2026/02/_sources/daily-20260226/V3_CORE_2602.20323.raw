<th id="S5.T1.16.5.2" class="ltx_td ltx_nopad_l ltx_nopad_r ltx_align_center ltx_th ltx_th_row ltx_border_r" style="padding-left:1.3pt;padding-right:1.3pt;"><span id="S5.T1.16.5.2.1" class="ltx_text" style="font-size:90%;">✗</span></th>
<td id="S5.T1.16.5.3" class="ltx_td ltx_nopad_l ltx_nopad_r ltx_align_center" style="--ltx-bg-color:#EBFAEB;padding-left:1.3pt;padding-right:1.3pt;"><span id="S5.T1.16.5.3.1" class="ltx_text" style="font-size:90%;--ltx-bg-color:#EBFAEB;">6.9</span></td>
<td id="S5.T1.16.5.4" class="ltx_td ltx_nopad_l ltx_nopad_r ltx_align_center" style="--ltx-bg-color:#FFD2D2;padding-left:1.3pt;padding-right:1.3pt;"><span id="S5.T1.16.5.4.1" class="ltx_text" style="font-size:90%;--ltx-bg-color:#FFD2D2;">3/10</span></td>
<td id="S5.T1.16.5.5" class="ltx_td ltx_nopad_l ltx_nopad_r ltx_align_center" style="--ltx-bg-color:#FFD2D2;padding-left:1.3pt;padding-right:1.3pt;"><span id="S5.T1.16.5.5.1" class="ltx_text" style="font-size:90%;--ltx-bg-color:#FFD2D2;">2.9</span></td>
<td id="S5.T1.16.5.6" class="ltx_td ltx_nopad_l ltx_nopad_r ltx_align_center" style="--ltx-bg-color:#FFB4B4;padding-left:1.3pt;padding-right:1.3pt;"><span id="S5.T1.16.5.6.1" class="ltx_text" style="font-size:90%;--ltx-bg-color:#FFB4B4;">1/10</span></td>
