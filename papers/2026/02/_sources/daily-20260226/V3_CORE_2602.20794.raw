<td id="S4.T6.6.1.2.2" class="ltx_td ltx_align_center ltx_border_t" style="padding-left:2.1pt;padding-right:2.1pt;">PDMS↑</td>
<td id="S4.T6.6.1.2.3" class="ltx_td ltx_align_center ltx_border_t" style="padding-left:2.1pt;padding-right:2.1pt;">MAP↑</td>
