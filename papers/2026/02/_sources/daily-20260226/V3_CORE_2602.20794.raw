<td id="S4.T6.6.1.2.5" class="ltx_td ltx_align_center ltx_border_t" style="padding-left:2.1pt;padding-right:2.1pt;">Avg↑</td>
<td id="S4.T6.6.1.2.6" class="ltx_td ltx_align_center ltx_border_t" style="padding-left:2.1pt;padding-right:2.1pt;">Time (s)↓</td></tr>
<tr id="S4.T6.6.1.3" class="ltx_tr">
<td id="S4.T6.6.1.3.1" class="ltx_td ltx_align_center ltx_border_t" style="padding-left:2.1pt;padding-right:2.1pt;">1</td>
<td id="S4.T6.6.1.3.2" class="ltx_td ltx_align_left ltx_border_t" style="padding-left:2.1pt;padding-right:2.1pt;">Baseline</td>
<td id="S4.T6.6.1.3.3" class="ltx_td ltx_align_center ltx_border_t" style="padding-left:2.1pt;padding-right:2.1pt;">81.00</td>
<td id="S4.T6.6.1.3.4" class="ltx_td ltx_align_center ltx_border_t" style="padding-left:2.1pt;padding-right:2.1pt;">86.04</td>
<td id="S4.T6.6.1.3.5" class="ltx_td ltx_align_center ltx_border_t" style="padding-left:2.1pt;padding-right:2.1pt;">6.15</td>
<td id="S4.T6.6.1.3.6" class="ltx_td ltx_align_center ltx_border_t" style="padding-left:2.1pt;padding-right:2.1pt;">75.75</td>
<td id="S4.T6.6.1.3.7" class="ltx_td ltx_align_center ltx_border_t" style="padding-left:2.1pt;padding-right:2.1pt;">31.32</td>
<td id="S4.T6.6.1.3.8" class="ltx_td ltx_align_center ltx_border_t" style="padding-left:2.1pt;padding-right:2.1pt;"><span id="S4.T6.6.1.3.8.1" class="ltx_text ltx_font_bold">0.81</span></td></tr>
<tr id="S4.T6.6.1.4" class="ltx_tr">
