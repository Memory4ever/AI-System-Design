le\sum\limits_{i\in\mathcal{M}_{i,t}}E||\bm{A}_{i,l}\bm{B}_{i,l,t}\odot\bm{M}_{i,t}\!\!-\!\!\frac{1}{|\mathcal{M}_{i,t}|}\bm{A}_{i,l}\!\!\!\!\sum\limits_{j\in\mathcal{M}_{i,t}}\!\!\bm{B}_{j,l,t}\odot\bm{M}_{i,t}||</annotation></semantics></math></td>
