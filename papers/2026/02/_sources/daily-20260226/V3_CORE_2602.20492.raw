<tr id="S7.E31Xa" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S7.E31Xa.m2" class="ltx_Math" alttext="\displaystyle=" display="inline" intent=":literal"><semantics><mo>=</mo><annotation encoding="application/x-tex">\displaystyle=</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S7.E31Xa.m3" class="ltx_Math" alttext="\displaystyle\sum\limits_{i\in\mathcal{M}_{i,t}}E||\bm{A}_{i,l}\frac{1}{|\mathcal{M}_{i,t}|}\sum\limits_{j\in\mathcal{M}_{i,t}}\left(\bm{B}_{i,l,t}-\bm{B}_{j,l,t}\right)\odot(\bm{M}_{j,t}\odot\bm{M}_{i,t}" display="inline" intent=":literal"><semantics><mrow><mstyle displaystyle="true"><mo movablelimits="false">∑</mo></mstyle><msub><mrow></mrow><mrow><mi>i</mi><mo>∈</mo><msub><mi class="ltx_font_mathcaligraphic">ℳ</mi><mrow><mi>i</mi><mo>,</mo><mi>t</mi></mrow></msub></mrow></msub><mi>E</mi><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>𝑨</mi><msub><mrow></mrow><mrow><mi>i</mi><mo>,</mo><mi>l</mi></mrow></msub><mstyle displaystyle="true"><mfrac><mn>1</mn><mrow><mo stretchy="false">|</mo><msub><mi class="ltx_font_mathcaligraphic">ℳ</mi><mrow><mi>i</mi><mo>,</mo><mi>t</mi></mrow></msub><mo stretchy="false">|</mo></mrow></mfrac></mstyle><mstyle displaystyle="true"><mo movablelimits="false">∑</mo></mstyle><msub><mrow></mrow><mrow><mi>j</mi><mo>∈</mo><msub><mi class="ltx_font_mathcaligraphic">ℳ</mi><mrow><mi>i</mi><mo>,</mo><mi>t</mi></mrow></msub></mrow></msub><mo>(</mo><mi>𝑩</mi><msub><mrow></mrow><mrow><mi>i</mi><mo>,</mo><mi>l</mi><mo>,</mo><mi>t</mi></mrow></msub><mo>−</mo><mi>𝑩</mi><msub><mrow></mrow><mrow><mi>j</mi><mo>,</mo><mi>l</mi><mo>,</mo><mi>t</mi></mrow></msub><mo rspace="0.055em">)</mo><mo rspace="0.222em">⊙</mo><mo stretchy="false">(</mo><mi>𝑴</mi><msub><mrow></mrow><mrow><mi>j</mi><mo>,</mo><mi>t</mi></mrow></msub><mo lspace="0.222em" rspace="0.222em">⊙</mo><mi>𝑴</mi><msub><mrow></mrow><mrow><mi>i</mi><mo>,</mo><mi>t</mi></mrow></msub></mrow><annotation encoding="application/x-tex">\displaystyle\sum\limits_{i\in\mathcal{M}_{i,t}}E||\bm{A}_{i,l}\frac{1}{|\mathcal{M}_{i,t}|}\sum\limits_{j\in\mathcal{M}_{i,t}}\left(\bm{B}_{i,l,t}-\bm{B}_{j,l,t}\right)\odot(\bm{M}_{j,t}\odot\bm{M}_{i,t}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr>
<tr id="S7.E31Xb" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S7.E31Xb.m2" class="ltx_Math" alttext="\displaystyle+\left|\bm{M}_{j,t}-\bm{M}_{i,t}\right|\odot\bm{M}_{i,t})||" display="inline" intent=":literal"><semantics><mrow><mo rspace="0em">+</mo><mo fence="false" rspace="0.167em">|</mo><mi>𝑴</mi><msub><mrow></mrow><mrow><mi>j</mi><mo>,</mo><mi>t</mi></mrow></msub><mo>−</mo><mi>𝑴</mi><msub><mrow></mrow><mrow><mi>i</mi><mo>,</mo><mi>t</mi></mrow></msub><mo fence="false">|</mo><mo lspace="0em" rspace="0.222em">⊙</mo><mi>𝑴</mi><msub><mrow></mrow><mrow><mi>i</mi><mo>,</mo><mi>t</mi></mrow></msub><mo stretchy="false">)</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mo fence="false" stretchy="false">|</mo></mrow><annotation encoding="application/x-tex">\displaystyle+\left|\bm{M}_{j,t}-\bm{M}_{i,t}\right|\odot\bm{M}_{i,t})||</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr>
<tr id="S7.E31Xc" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S7.E31Xc.m2" class="ltx_Math" alttext="\displaystyle=" display="inline" intent=":literal"><semantics><mo>=</mo><annotation encoding="application/x-tex">\displaystyle=</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S7.E31Xc.m3" class="ltx_Math" alttext="\displaystyle\sum\limits_{i\in\mathcal{M}_{i,t}}E||\bm{A}_{i,l}\frac{1}{|\mathcal{M}_{i,t}|}\sum\limits_{j\in\mathcal{M}_{i,t}}\left(\bm{B}_{i,l,t}-\bm{B}_{j,l,t}\right)\odot\bm{M}_{i,j,t}^{c}||." display="inline" intent=":literal"><semantics><mrow><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>∈</mo><msub><mi class="ltx_font_mathcaligraphic">ℳ</mi><mrow><mi>i</mi><mo>,</mo><mi>t</mi></mrow></msub></mrow></munder></mstyle><mrow><mi>E</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">‖</mo><mrow><mrow><msub><mi>𝑨</mi><mrow><mi>i</mi><mo>,</mo><mi>l</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mrow><mo stretchy="false">|</mo><msub><mi class="ltx_font_mathcaligraphic">ℳ</mi><mrow><mi>i</mi><mo>,</mo><mi>t</mi></mrow></msub><mo stretchy="false">|</mo></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mi>j</mi><mo>∈</mo><msub><mi class="ltx_font_mathcaligraphic">ℳ</mi><mrow><mi>i</mi><mo>,</mo><mi>t</mi></mrow></msub></mrow></munder></mstyle><mrow><mo>(</mo><mrow><msub><mi>𝑩</mi><mrow><mi>i</mi><mo>,</mo><mi>l</mi><mo>,</mo><mi>t</mi></mrow></msub><mo>−</mo><msub><mi>𝑩</mi><mrow><mi>j</mi><mo>,</mo><mi>l</mi><mo>,</mo><mi>t</mi></mrow></msub></mrow><mo rspace="0.055em">)</mo></mrow></mrow></mrow><mo rspace="0.222em">⊙</mo><msubsup><mi>𝑴</mi><mrow><mi>i</mi><mo>,</mo><mi>j</mi><mo>,</mo><mi>t</mi></mrow><mi>c</mi></msubsup></mrow><mo stretchy="false">‖</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\sum\limits_{i\in\mathcal{M}_{i,t}}E||\bm{A}_{i,l}\frac{1}{|\mathcal{M}_{i,t}|}\sum\limits_{j\in\mathcal{M}_{i,t}}\left(\bm{B}_{i,l,t}-\bm{B}_{j,l,t}\right)\odot\bm{M}_{i,j,t}^{c}||.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S7.SS1.p1.5" class="ltx_p">Due to the definition of parameter collision rate, (<a href="#S7.E31" title="In VII-A Proof of Theorem 1 ‣ VII Appendix ‣ Wireless Federated Multi-Task LLM Fine-Tuning via Sparse-and-Orthogonal LoRA" class="ltx_ref"><span class="ltx_text ltx_ref_tag">31</span></a>) can be further given by</p>
<table id="S7.E32" class="ltx_equationgroup ltx_eqn_table">
<tbody>
<tr id="S7.E32X" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S7.E32X.m2" class="ltx_Math" alttext="\displaystyle rk\sum\limits_{i\in\mathcal{M}_{i,t}}\!\!\!\sum\limits_{j\in\mathcal{M}_{i,t}}S_{\mathcal{M}_{i,t},l}E||\bm{A}_{i,l}\left(\bm{B}_{i,l,t}\!-\!\frac{1}{|\mathcal{M}_{i,t}|}\sum\limits_{j\in\mathcal{M}_{i,t}}\!\!\!\bm{B}_{j,l,t}\right)||" display="inline" intent=":literal"><semantics><mrow><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>k</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>∈</mo><msub><mi class="ltx_font_mathcaligraphic">ℳ</mi><mrow><mi>i</mi><mo>,</mo><mi>t</mi></mrow></msub></mrow></munder></mstyle><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mi>j</mi><mo>∈</mo><msub><mi class="ltx_font_mathcaligraphic">ℳ</mi><mrow><mi>i</mi><mo>,</mo><mi>t</mi></mrow></msub></mrow></munder></mstyle><mrow><msub><mi>S</mi><mrow><msub><mi class="ltx_font_mathcaligraphic">ℳ</mi><mrow><mi>i</mi><mo>,</mo><mi>t</mi></mrow></msub><mo>,</mo><mi>l</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mi>E</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">‖</mo><mrow><msub><mi>𝑨</mi><mrow><mi>i</mi><mo>,</mo><mi>l</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><msub><mi>𝑩</mi><mrow><mi>i</mi><mo>,</mo><mi>l</mi><mo>,</mo><mi>t</mi></mrow></msub><mo rspace="0.052em">−</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mrow><mo stretchy="false">|</mo><msub><mi class="ltx_font_mathcaligraphic">ℳ</mi><mrow><mi>i</mi><mo>,</mo><mi>t</mi></mrow></msub><mo stretchy="false">|</mo></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mi>j</mi><mo>∈</mo><msub><mi class="ltx_font_mathcaligraphic">ℳ</mi><mrow><mi>i</mi><mo>,</mo><mi>t</mi></mrow></msub></mrow></munder></mstyle><msub><mi>𝑩</mi><mrow><mi>j</mi><mo>,</mo><mi>l</mi><mo>,</mo><mi>t</mi></mrow></msub></mrow></mrow></mrow><mo>)</mo></mrow></mrow><mo stretchy="false">‖</mo></mrow></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle rk\sum\limits_{i\in\mathcal{M}_{i,t}}\!\!\!\sum\limits_{j\in\mathcal{M}_{i,t}}S_{\mathcal{M}_{i,t},l}E||\bm{A}_{i,l}\left(\bm{B}_{i,l,t}\!-\!\frac{1}{|\mathcal{M}_{i,t}|}\sum\limits_{j\in\mathcal{M}_{i,t}}\!\!\!\bm{B}_{j,l,t}\right)||</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="3" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equationgroup ltx_align_right">(32)</span></td></tr>
<tr id="S7.E32Xa" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S7.E32Xa.m2" class="ltx_Math" alttext="\displaystyle=" display="inline" intent=":literal"><semantics><mo>=</mo><annotation encoding="application/x-tex">\displaystyle=</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S7.E32Xa.m3" class="ltx_Math" alttext="\displaystyle rk\sum\limits_{i\in\mathcal{M}_{i,t}}\!\!\!\sum\limits_{j\in\mathcal{M}_{i,t}}S_{\mathcal{M}_{i,t},l}E||-\eta\bm{A}_{i,l}\nabla_{\bm{B}_{i,l,t}}F_{i}||" display="inline" intent=":literal"><semantics><mrow><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>k</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>∈</mo><msub><mi class="ltx_font_mathcaligraphic">ℳ</mi><mrow><mi>i</mi><mo>,</mo><mi>t</mi></mrow></msub></mrow></munder></mstyle><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mi>j</mi><mo>∈</mo><msub><mi class="ltx_font_mathcaligraphic">ℳ</mi><mrow><mi>i</mi><mo>,</mo><mi>t</mi></mrow></msub></mrow></munder></mstyle><mrow><msub><mi>S</mi><mrow><msub><mi class="ltx_font_mathcaligraphic">ℳ</mi><mrow><mi>i</mi><mo>,</mo><mi>t</mi></mrow></msub><mo>,</mo><mi>l</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mi>E</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">‖</mo><mrow><mo>−</mo><mrow><mi>η</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝑨</mi><mrow><mi>i</mi><mo>,</mo><mi>l</mi></mrow></msub><mo lspace="0.167em" rspace="0em">​</mo><mrow><msub><mo rspace="0.167em">∇</mo><msub><mi>𝑩</mi><mrow><mi>i</mi><mo>,</mo><mi>l</mi><mo>,</mo><mi>t</mi></mrow></msub></msub><msub><mi>F</mi><mi>i</mi></msub></mrow></mrow></mrow><mo stretchy="false">‖</mo></mrow></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle rk\sum\limits_{i\in\mathcal{M}_{i,t}}\!\!\!\sum\limits_{j\in\mathcal{M}_{i,t}}S_{\mathcal{M}_{i,t},l}E||-\eta\bm{A}_{i,l}\nabla_{\bm{B}_{i,l,t}}F_{i}||</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr>
<tr id="S7.E32Xb" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S7.E32Xb.m2" class="ltx_Math" alttext="\displaystyle\leq" display="inline" intent=":literal"><semantics><mo>≤</mo><annotation encoding="application/x-tex">\displaystyle\leq</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S7.E32Xb.m3" class="ltx_Math" alttext="\displaystyle rk\sum\limits_{i\in\mathcal{M}_{i,t}}\!\!\!\sum\limits_{j\in\mathcal{M}_{i,t}}S_{\mathcal{M}_{i,t},l}G." display="inline" intent=":literal"><semantics><mrow><mrow><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>k</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>∈</mo><msub><mi class="ltx_font_mathcaligraphic">ℳ</mi><mrow><mi>i</mi><mo>,</mo><mi>t</mi></mrow></msub></mrow></munder></mstyle><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mi>j</mi><mo>∈</mo><msub><mi class="ltx_font_mathcaligraphic">ℳ</mi><mrow><mi>i</mi><mo>,</mo><mi>t</mi></mrow></msub></mrow></munder></mstyle><mrow><msub><mi>S</mi><mrow><msub><mi class="ltx_font_mathcaligraphic">ℳ</mi><mrow><mi>i</mi><mo>,</mo><mi>t</mi></mrow></msub><mo>,</mo><mi>l</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mi>G</mi></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle rk\sum\limits_{i\in\mathcal{M}_{i,t}}\!\!\!\sum\limits_{j\in\mathcal{M}_{i,t}}S_{\mathcal{M}_{i,t},l}G.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S7.SS1.p1.6" class="ltx_p">The second equation is due to the fact that <math id="S7.SS1.p1.m1" class="ltx_Math" alttext="\bm{A}_{i,l}" display="inline" intent=":literal"><semantics><msub><mi>𝑨</mi><mrow><mi>i</mi><mo>,</mo><mi>l</mi></mrow></msub><annotation encoding="application/x-tex">\bm{A}_{i,l}</annotation></semantics></math> is independent to <math id="S7.SS1.p1.m2" class="ltx_Math" alttext="\frac{1}{|\mathcal{M}_{i,t}|}\sum\limits_{j\in\mathcal{M}_{i,t}}\left(\bm{B}_{i,l,t}-\bm{B}_{j,l,t}\right)\left|\bm{M}_{j,t}-\bm{M}_{i,t}\right|\odot\bm{M}_{i,t}" display="inline" intent=":literal"><semantics><mrow><mrow><mfrac><mn>1</mn><mrow><mo stretchy="false">|</mo><msub><mi class="ltx_font_mathcaligraphic">ℳ</mi><mrow><mi>i</mi><mo>,</mo><mi>t</mi></mrow></msub><mo stretchy="false">|</mo></mrow></mfrac><mo lspace="0em" rspace="0em">​</mo><mrow><munder><mo movablelimits="false" rspace="0em">∑</mo><mrow><mi>j</mi><mo>∈</mo><msub><mi class="ltx_font_mathcaligraphic">ℳ</mi><mrow><mi>i</mi><mo>,</mo><mi>t</mi></mrow></msub></mrow></munder><mrow><mrow><mo>(</mo><mrow><msub><mi>𝑩</mi><mrow><mi>i</mi><mo>,</mo><mi>l</mi><mo>,</mo><mi>t</mi></mrow></msub><mo>−</mo><msub><mi>𝑩</mi><mrow><mi>j</mi><mo>,</mo><mi>l</mi><mo>,</mo><mi>t</mi></mrow></msub></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo>|</mo><mrow><msub><mi>𝑴</mi><mrow><mi>j</mi><mo>,</mo><mi>t</mi></mrow></msub><mo>−</mo><msub><mi>𝑴</mi><mrow><mi>i</mi><mo>,</mo><mi>t</mi></mrow></msub></mrow><mo rspace="0.055em">|</mo></mrow></mrow></mrow></mrow><mo rspace="0.222em">⊙</mo><msub><mi>𝑴</mi><mrow><mi>i</mi><mo>,</mo><mi>t</mi></mrow></msub></mrow><annotation encoding="application/x-tex">\frac{1}{|\mathcal{M}_{i,t}|}\sum\limits_{j\in\mathcal{M}_{i,t}}\left(\bm{B}_{i,l,t}-\bm{B}_{j,l,t}\right)\left|\bm{M}_{j,t}-\bm{M}_{i,t}\right|\odot\bm{M}_{i,t}</annotation></semantics></math>.
Similarly, we can rewrite the second term in (<a href="#S7.E30" title="In VII-A Proof of Theorem 1 ‣ VII Appendix ‣ Wireless Federated Multi-Task LLM Fine-Tuning via Sparse-and-Orthogonal LoRA" class="ltx_ref"><span class="ltx_text ltx_ref_tag">30</span></a>) as</p>
<table id="S7.E33" class="ltx_equationgroup ltx_eqn_table">
<tbody>
<tr id="S7.E33X" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S7.E33X.m2" class="ltx_Math" alttext="\displaystyle\sum\limits_{i\in\mathcal{M}_{i,t}}\!\!\!E||\!\frac{1}{|\mathcal{M}_{i,t}|}\bm{A}_{i,l}\!\!\!\sum\limits_{j\in\mathcal{M}_{i,t}}\!\!\!\bm{B}_{j,l,t}\odot\bm{M}_{j,t}" display="inline" intent=":literal"><semantics><mrow><mstyle displaystyle="true"><mo movablelimits="false">∑</mo></mstyle><msub><mrow></mrow><mrow><mi>i</mi><mo>∈</mo><msub><mi class="ltx_font_mathcaligraphic">ℳ</mi><mrow><mi>i</mi><mo>,</mo><mi>t</mi></mrow></msub></mrow></msub><mi>E</mi><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mo fence="false" stretchy="false">|</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mrow><mo stretchy="false">|</mo><msub><mi class="ltx_font_mathcaligraphic">ℳ</mi><mrow><mi>i</mi><mo>,</mo><mi>t</mi></mrow></msub><mo stretchy="false">|</mo></mrow></mfrac></mstyle><mi>𝑨</mi><msub><mrow></mrow><mrow><mi>i</mi><mo>,</mo><mi>l</mi></mrow></msub><mstyle displaystyle="true"><mo movablelimits="false">∑</mo></mstyle><msub><mrow></mrow><mrow><mi>j</mi><mo>∈</mo><msub><mi class="ltx_font_mathcaligraphic">ℳ</mi><mrow><mi>i</mi><mo>,</mo><mi>t</mi></mrow></msub></mrow></msub><mi>𝑩</mi><msub><mrow></mrow><mrow><mi>j</mi><mo>,</mo><mi>l</mi><mo>,</mo><mi>t</mi></mrow></msub><mo lspace="0.222em" rspace="0.222em">⊙</mo><mi>𝑴</mi><msub><mrow></mrow><mrow><mi>j</mi><mo>,</mo><mi>t</mi></mrow></msub></mrow><annotation encoding="application/x-tex">\displaystyle\sum\limits_{i\in\mathcal{M}_{i,t}}\!\!\!E||\!\frac{1}{|\mathcal{M}_{i,t}|}\bm{A}_{i,l}\!\!\!\sum\limits_{j\in\mathcal{M}_{i,t}}\!\!\!\bm{B}_{j,l,t}\odot\bm{M}_{j,t}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="2" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equationgroup ltx_align_right">(33)</span></td></tr>
<tr id="S7.E33Xa" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S7.E33Xa.m2" class="ltx_Math" alttext="\displaystyle-\!\frac{1}{|\mathcal{M}_{i,t}|}\bm{A}_{i,l}\!\!\!\!\sum\limits_{j\in\mathcal{M}_{i,t}}\!\!\!\bm{B}_{j,l,t}\odot\bm{M}_{i,t}||\leq rk\sum\limits_{i\in\mathcal{M}_{i,t}}S_{\mathcal{M}_{i,t}}P." display="inline" intent=":literal"><semantics><mrow><mo rspace="0.052em">−</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mrow><mo stretchy="false">|</mo><msub><mi class="ltx_font_mathcaligraphic">ℳ</mi><mrow><mi>i</mi><mo>,</mo><mi>t</mi></mrow></msub><mo stretchy="false">|</mo></mrow></mfrac></mstyle><mi>𝑨</mi><msub><mrow></mrow><mrow><mi>i</mi><mo>,</mo><mi>l</mi></mrow></msub><mstyle displaystyle="true"><mo movablelimits="false">∑</mo></mstyle><msub><mrow></mrow><mrow><mi>j</mi><mo>∈</mo><msub><mi class="ltx_font_mathcaligraphic">ℳ</mi><mrow><mi>i</mi><mo>,</mo><mi>t</mi></mrow></msub></mrow></msub><mi>𝑩</mi><msub><mrow></mrow><mrow><mi>j</mi><mo>,</mo><mi>l</mi><mo>,</mo><mi>t</mi></mrow></msub><mo lspace="0.222em" rspace="0.222em">⊙</mo><mi>𝑴</mi><msub><mrow></mrow><mrow><mi>i</mi><mo>,</mo><mi>t</mi></mrow></msub><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mo fence="false" stretchy="false">|</mo><mo lspace="0.167em">≤</mo><mi>r</mi><mi>k</mi><mstyle displaystyle="true"><mo movablelimits="false">∑</mo></mstyle><msub><mrow></mrow><mrow><mi>i</mi><mo>∈</mo><msub><mi class="ltx_font_mathcaligraphic">ℳ</mi><mrow><mi>i</mi><mo>,</mo><mi>t</mi></mrow></msub></mrow></msub><mi>S</mi><msub><mrow></mrow><msub><mi class="ltx_font_mathcaligraphic">ℳ</mi><mrow><mi>i</mi><mo>,</mo><mi>t</mi></mrow></msub></msub><mi>P</mi><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle-\!\frac{1}{|\mathcal{M}_{i,t}|}\bm{A}_{i,l}\!\!\!\!\sum\limits_{j\in\mathcal{M}_{i,t}}\!\!\!\bm{B}_{j,l,t}\odot\bm{M}_{i,t}||\leq rk\sum\limits_{i\in\mathcal{M}_{i,t}}S_{\mathcal{M}_{i,t}}P.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S7.SS1.p1.7" class="ltx_p">Thus, we have</p>
<table id="S7.E34" class="ltx_equationgroup ltx_eqn_table">
<tbody>
<tr id="S7.E34X" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S7.E34X.m2" class="ltx_Math" alttext="\displaystyle\sum\limits_{i\in\mathcal{M}_{i,t}}E||\bm{A}_{i,l}\bm{B}_{i,l,t}\odot\bm{M}_{i,t}\!-\!\frac{1}{|\mathcal{M}_{i,t}|}\bm{A}_{i,l}\!\!\sum\limits_{i\in\mathcal{M}_{i,t}}\!\!\bm{B}_{j,l,t}\odot\bm{M}_{j,t}||^{2}" display="inline" intent=":literal"><semantics><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>∈</mo><msub><mi class="ltx_font_mathcaligraphic">ℳ</mi><mrow><mi>i</mi><mo>,</mo><mi>t</mi></mrow></msub></mrow></munder></mstyle><mrow><mi>E</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">‖</mo><mrow><mrow><mrow><msub><mi>𝑨</mi><mrow><mi>i</mi><mo>,</mo><mi>l</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝑩</mi><mrow><mi>i</mi><mo>,</mo><mi>l</mi><mo>,</mo><mi>t</mi></mrow></msub></mrow><mo lspace="0.222em" rspace="0.222em">⊙</mo><msub><mi>𝑴</mi><mrow><mi>i</mi><mo>,</mo><mi>t</mi></mrow></msub></mrow><mo rspace="0.052em">−</mo><mrow><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mrow><mo stretchy="false">|</mo><msub><mi class="ltx_font_mathcaligraphic">ℳ</mi><mrow><mi>i</mi><mo>,</mo><mi>t</mi></mrow></msub><mo stretchy="false">|</mo></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝑨</mi><mrow><mi>i</mi><mo>,</mo><mi>l</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>∈</mo><msub><mi class="ltx_font_mathcaligraphic">ℳ</mi><mrow><mi>i</mi><mo>,</mo><mi>t</mi></mrow></msub></mrow></munder></mstyle><msub><mi>𝑩</mi><mrow><mi>j</mi><mo>,</mo><mi>l</mi><mo>,</mo><mi>t</mi></mrow></msub></mrow></mrow><mo lspace="0.222em" rspace="0.222em">⊙</mo><msub><mi>𝑴</mi><mrow><mi>j</mi><mo>,</mo><mi>t</mi></mrow></msub></mrow></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\sum\limits_{i\in\mathcal{M}_{i,t}}E||\bm{A}_{i,l}\bm{B}_{i,l,t}\odot\bm{M}_{i,t}\!-\!\frac{1}{|\mathcal{M}_{i,t}|}\bm{A}_{i,l}\!\!\sum\limits_{i\in\mathcal{M}_{i,t}}\!\!\bm{B}_{j,l,t}\odot\bm{M}_{j,t}||^{2}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="2" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equationgroup ltx_align_right">(34)</span></td></tr>
<tr id="S7.E34Xa" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S7.E34Xa.m2" class="ltx_Math" alttext="\displaystyle\leq 2rk\sum\limits_{i\in\mathcal{M}_{i,t}}\sum\limits_{j\in\mathcal{M}_{i,t}}S_{\mathcal{M}_{i,t},l}\left(G+P\right)." display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>≤</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>k</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>∈</mo><msub><mi class="ltx_font_mathcaligraphic">ℳ</mi><mrow><mi>i</mi><mo>,</mo><mi>t</mi></mrow></msub></mrow></munder></mstyle><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mi>j</mi><mo>∈</mo><msub><mi class="ltx_font_mathcaligraphic">ℳ</mi><mrow><mi>i</mi><mo>,</mo><mi>t</mi></mrow></msub></mrow></munder></mstyle><mrow><msub><mi>S</mi><mrow><msub><mi class="ltx_font_mathcaligraphic">ℳ</mi><mrow><mi>i</mi><mo>,</mo><mi>t</mi></mrow></msub><mo>,</mo><mi>l</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mi>G</mi><mo>+</mo><mi>P</mi></mrow><mo>)</mo></mrow></mrow></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\leq 2rk\sum\limits_{i\in\mathcal{M}_{i,t}}\sum\limits_{j\in\mathcal{M}_{i,t}}S_{\mathcal{M}_{i,t},l}\left(G+P\right).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S7.SS1.p1.8" class="ltx_p">This ends the proof.</p>
</div>
</section>
<section id="S7.SS2" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection"><span id="S7.SS2.4" class="ltx_text">VII-B</span> </span><span id="S7.SS2.5" class="ltx_text ltx_font_italic">Proof of Theorem 2</span></h3>

<div id="S7.SS2.p1" class="ltx_para">
<p id="S7.SS2.p1.1" class="ltx_p">By the definition of the Frobenius inner product:</p>
<table id="S7.E35" class="ltx_equationgroup ltx_eqn_table">
<tbody>
<tr id="S7.E35X" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S7.E35X.m2" class="ltx_Math" alttext="\displaystyle\left&lt;\bm{w}_{i,l,t},\bm{w}_{j,l,t}^{\top}\right&gt;_{F}=\text{Tr}\left(\bm{w}_{i,l,t}^{\top},\bm{w}_{j,l,t}\right)" display="inline" intent=":literal"><semantics><mrow><msub><mrow><mo>⟨</mo><mrow><msub><mi>𝒘</mi><mrow><mi>i</mi><mo>,</mo><mi>l</mi><mo>,</mo><mi>t</mi></mrow></msub><mo>,</mo><msubsup><mi>𝒘</mi><mrow><mi>j</mi><mo>,</mo><mi>l</mi><mo>,</mo><mi>t</mi></mrow><mo>⊤</mo></msubsup></mrow><mo>⟩</mo></mrow><mi>F</mi></msub><mo>=</mo><mrow><mtext>Tr</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><msubsup><mi>𝒘</mi><mrow><mi>i</mi><mo>,</mo><mi>l</mi><mo>,</mo><mi>t</mi></mrow><mo>⊤</mo></msubsup><mo>,</mo><msub><mi>𝒘</mi><mrow><mi>j</mi><mo>,</mo><mi>l</mi><mo>,</mo><mi>t</mi></mrow></msub><mo>)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\left&lt;\bm{w}_{i,l,t},\bm{w}_{j,l,t}^{\top}\right&gt;_{F}=\text{Tr}\left(\bm{w}_{i,l,t}^{\top},\bm{w}_{j,l,t}\right)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="4" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equationgroup ltx_align_right">(35)</span></td></tr>
<tr id="S7.E35Xa" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S7.E35Xa.m2" class="ltx_Math" alttext="\displaystyle=" display="inline" intent=":literal"><semantics><mo>=</mo><annotation encoding="application/x-tex">\displaystyle=</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S7.E35Xa.m3" class="ltx_Math" alttext="\displaystyle\text{Tr}\left(\left(\bm{B}_{j,l,t}\odot\bm{M}_{j,l,t}^{B}\right)\bm{A}_{j,l,\text{refined}}\bm{A}_{i,l,\text{refined}}^{\top}\left(\bm{B}_{i,l,t}\odot\bm{M}_{i,l,t}^{B}\right)^{\top}\right)" display="inline" intent=":literal"><semantics><mrow><mtext>Tr</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mrow><mo>(</mo><mrow><msub><mi>𝑩</mi><mrow><mi>j</mi><mo>,</mo><mi>l</mi><mo>,</mo><mi>t</mi></mrow></msub><mo lspace="0.222em" rspace="0.222em">⊙</mo><msubsup><mi>𝑴</mi><mrow><mi>j</mi><mo>,</mo><mi>l</mi><mo>,</mo><mi>t</mi></mrow><mi>B</mi></msubsup></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝑨</mi><mrow><mi>j</mi><mo>,</mo><mi>l</mi><mo>,</mo><mtext>refined</mtext></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝑨</mi><mrow><mi>i</mi><mo>,</mo><mi>l</mi><mo>,</mo><mtext>refined</mtext></mrow><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo>(</mo><mrow><msub><mi>𝑩</mi><mrow><mi>i</mi><mo>,</mo><mi>l</mi><mo>,</mo><mi>t</mi></mrow></msub><mo lspace="0.222em" rspace="0.222em">⊙</mo><msubsup><mi>𝑴</mi><mrow><mi>i</mi><mo>,</mo><mi>l</mi><mo>,</mo><mi>t</mi></mrow><mi>B</mi></msubsup></mrow><mo>)</mo></mrow><mo>⊤</mo></msup></mrow><mo>)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\text{Tr}\left(\left(\bm{B}_{j,l,t}\odot\bm{M}_{j,l,t}^{B}\right)\bm{A}_{j,l,\text{refined}}\bm{A}_{i,l,\text{refined}}^{\top}\left(\bm{B}_{i,l,t}\odot\bm{M}_{i,l,t}^{B}\right)^{\top}\right)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr>
<tr id="S7.E35Xb" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S7.E35Xb.m2" class="ltx_Math" alttext="\displaystyle=" display="inline" intent=":literal"><semantics><mo>=</mo><annotation encoding="application/x-tex">\displaystyle=</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S7.E35Xb.m3" class="ltx_Math" alttext="\displaystyle\text{Tr}\!\left(\!\!\left(\bm{B}_{j,l,t}\!\odot\!\bm{M}_{j,l,t}^{B}\right)\!\!\frac{\left[\bm{H}^{0}_{j,l}\right]^{\top}}{||\bm{H}^{0}_{j,l}||}\bm{A}_{j,l}^{\top}\bm{A}_{i,l}\!\!\frac{\bm{H}^{0}_{i,l}}{||\bm{H}^{0}_{i,l}||}\!\left(\bm{B}_{i,l,t}\!\odot\!\bm{M}_{i,l,t}^{B}\right)^{\top}\!\!\!\right)" display="inline" intent=":literal"><semantics><mrow><mpadded style="width:1.032em;" width="1.032em"><mtext>Tr</mtext></mpadded><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mrow><mo>(</mo><mrow><msub><mi>𝑩</mi><mrow><mi>j</mi><mo>,</mo><mi>l</mi><mo>,</mo><mi>t</mi></mrow></msub><mo lspace="0.222em" rspace="0.052em">⊙</mo><msubsup><mi>𝑴</mi><mrow><mi>j</mi><mo>,</mo><mi>l</mi><mo>,</mo><mi>t</mi></mrow><mi>B</mi></msubsup></mrow><mpadded style="width:0.049em;" width="0.049em"><mo>)</mo></mpadded></mrow><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><msup><mrow><mo>[</mo><msubsup><mi>𝑯</mi><mrow><mi>j</mi><mo>,</mo><mi>l</mi></mrow><mn>0</mn></msubsup><mo>]</mo></mrow><mo>⊤</mo></msup><mrow><mo stretchy="false">‖</mo><msubsup><mi>𝑯</mi><mrow><mi>j</mi><mo>,</mo><mi>l</mi></mrow><mn>0</mn></msubsup><mo stretchy="false">‖</mo></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝑨</mi><mrow><mi>j</mi><mo>,</mo><mi>l</mi></mrow><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝑨</mi><mrow><mi>i</mi><mo>,</mo><mi>l</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><msubsup><mi>𝑯</mi><mrow><mi>i</mi><mo>,</mo><mi>l</mi></mrow><mn>0</mn></msubsup><mrow><mo stretchy="false">‖</mo><msubsup><mi>𝑯</mi><mrow><mi>i</mi><mo>,</mo><mi>l</mi></mrow><mn>0</mn></msubsup><mo stretchy="false">‖</mo></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo>(</mo><mrow><msub><mi>𝑩</mi><mrow><mi>i</mi><mo>,</mo><mi>l</mi><mo>,</mo><mi>t</mi></mrow></msub><mo lspace="0.222em" rspace="0.052em">⊙</mo><msubsup><mi>𝑴</mi><mrow><mi>i</mi><mo>,</mo><mi>l</mi><mo>,</mo><mi>t</mi></mrow><mi>B</mi></msubsup></mrow><mo>)</mo></mrow><mo>⊤</mo></msup></mrow><mo>)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\text{Tr}\!\left(\!\!\left(\bm{B}_{j,l,t}\!\odot\!\bm{M}_{j,l,t}^{B}\right)\!\!\frac{\left[\bm{H}^{0}_{j,l}\right]^{\top}}{||\bm{H}^{0}_{j,l}||}\bm{A}_{j,l}^{\top}\bm{A}_{i,l}\!\!\frac{\bm{H}^{0}_{i,l}}{||\bm{H}^{0}_{i,l}||}\!\left(\bm{B}_{i,l,t}\!\odot\!\bm{M}_{i,l,t}^{B}\right)^{\top}\!\!\!\right)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr>
<tr id="S7.E35Xc" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S7.E35Xc.m2" class="ltx_Math" alttext="\displaystyle=" display="inline" intent=":literal"><semantics><mo>=</mo><annotation encoding="application/x-tex">\displaystyle=</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S7.E35Xc.m3" class="ltx_Math" alttext="\displaystyle\text{Tr}\!\left(\!\!\!\left(\bm{B}_{j,l,t}\!\odot\!\bm{M}_{j,l,t}^{B}\right)\!\!\frac{\left[\bm{H}^{0}_{j,l}\right]^{\top}}{||\bm{H}^{0}_{j,l}||}\!\!\left(\!\!\!\bm{A}_{i,l}\bm{A}_{j,l}^{\top}\!\right)\!\!\frac{\bm{H}^{0}_{i,l}}{||\bm{H}^{0}_{i,l}||}\!\!\left(\bm{B}_{i,l,t}\!\!\odot\!\!\bm{M}_{i,l,t}^{B}\right)^{\top}\!\!\!\right)," display="inline" intent=":literal"><semantics><mrow><mrow><mpadded style="width:1.032em;" width="1.032em"><mtext>Tr</mtext></mpadded><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mrow><mo>(</mo><mrow><msub><mi>𝑩</mi><mrow><mi>j</mi><mo>,</mo><mi>l</mi><mo>,</mo><mi>t</mi></mrow></msub><mo lspace="0.222em" rspace="0.052em">⊙</mo><msubsup><mi>𝑴</mi><mrow><mi>j</mi><mo>,</mo><mi>l</mi><mo>,</mo><mi>t</mi></mrow><mi>B</mi></msubsup></mrow><mpadded style="width:0.049em;" width="0.049em"><mo>)</mo></mpadded></mrow><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><msup><mrow><mo>[</mo><msubsup><mi>𝑯</mi><mrow><mi>j</mi><mo>,</mo><mi>l</mi></mrow><mn>0</mn></msubsup><mo>]</mo></mrow><mo>⊤</mo></msup><mrow><mo stretchy="false">‖</mo><msubsup><mi>𝑯</mi><mrow><mi>j</mi><mo>,</mo><mi>l</mi></mrow><mn>0</mn></msubsup><mo stretchy="false">‖</mo></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><msub><mi>𝑨</mi><mrow><mi>i</mi><mo>,</mo><mi>l</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝑨</mi><mrow><mi>j</mi><mo>,</mo><mi>l</mi></mrow><mo>⊤</mo></msubsup></mrow><mpadded style="width:0.049em;" width="0.049em"><mo>)</mo></mpadded></mrow><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><msubsup><mi>𝑯</mi><mrow><mi>i</mi><mo>,</mo><mi>l</mi></mrow><mn>0</mn></msubsup><mrow><mo stretchy="false">‖</mo><msubsup><mi>𝑯</mi><mrow><mi>i</mi><mo>,</mo><mi>l</mi></mrow><mn>0</mn></msubsup><mo stretchy="false">‖</mo></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo>(</mo><mrow><msub><mi>𝑩</mi><mrow><mi>i</mi><mo>,</mo><mi>l</mi><mo>,</mo><mi>t</mi></mrow></msub><mpadded style="width:0.660em;" width="0.660em"><mo lspace="0.222em">⊙</mo></mpadded><msubsup><mi>𝑴</mi><mrow><mi>i</mi><mo>,</mo><mi>l</mi><mo>,</mo><mi>t</mi></mrow><mi>B</mi></msubsup></mrow><mo>)</mo></mrow><mo>⊤</mo></msup></mrow><mo>)</mo></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\text{Tr}\!\left(\!\!\!\left(\bm{B}_{j,l,t}\!\odot\!\bm{M}_{j,l,t}^{B}\right)\!\!\frac{\left[\bm{H}^{0}_{j,l}\right]^{\top}}{||\bm{H}^{0}_{j,l}||}\!\!\left(\!\!\!\bm{A}_{i,l}\bm{A}_{j,l}^{\top}\!\right)\!\!\frac{\bm{H}^{0}_{i,l}}{||\bm{H}^{0}_{i,l}||}\!\!\left(\bm{B}_{i,l,t}\!\!\odot\!\!\bm{M}_{i,l,t}^{B}\right)^{\top}\!\!\!\right),</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S7.SS2.p1.2" class="ltx_p">where <math id="S7.SS2.p1.m1" class="ltx_Math" alttext="\bm{H}^{0}_{i,l}" display="inline" intent=":literal"><semantics><msubsup><mi>𝑯</mi><mrow><mi>i</mi><mo>,</mo><mi>l</mi></mrow><mn>0</mn></msubsup><annotation encoding="application/x-tex">\bm{H}^{0}_{i,l}</annotation></semantics></math> is the abbreviation of <math id="S7.SS2.p1.m2" class="ltx_Math" alttext="\bm{H}^{0}_{i,l,\text{input}}" display="inline" intent=":literal"><semantics><msubsup><mi>𝑯</mi><mrow><mi>i</mi><mo>,</mo><mi>l</mi><mo>,</mo><mtext>input</mtext></mrow><mn>0</mn></msubsup><annotation encoding="application/x-tex">\bm{H}^{0}_{i,l,\text{input}}</annotation></semantics></math>.
Since elements in <math id="S7.SS2.p1.m3" class="ltx_Math" alttext="\bm{A}_{i,l}" display="inline" intent=":literal"><semantics><msub><mi>𝑨</mi><mrow><mi>i</mi><mo>,</mo><mi>l</mi></mrow></msub><annotation encoding="application/x-tex">\bm{A}_{i,l}</annotation></semantics></math> are random generated from Gauss distribution, <math id="S7.SS2.p1.m4" class="ltx_Math" alttext="\bm{A}_{i,l}\bm{A}_{j,l}^{\top}=0" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>𝑨</mi><mrow><mi>i</mi><mo>,</mo><mi>l</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝑨</mi><mrow><mi>j</mi><mo>,</mo><mi>l</mi></mrow><mo>⊤</mo></msubsup></mrow><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\bm{A}_{i,l}\bm{A}_{j,l}^{\top}=0</annotation></semantics></math>.
Then, we can prove that <math id="S7.SS2.p1.m5" class="ltx_Math" alttext="\left&lt;\bm{w}_{i,l,t},\bm{w}_{j,l,t}^{\top}\right&gt;_{F}=\text{Tr}\left(\bm{w}_{i,l,t}^{\top},\bm{w}_{j,l,t}\right)=0" display="inline" intent=":literal"><semantics><mrow><msub><mrow><mo>⟨</mo><mrow><msub><mi>𝒘</mi><mrow><mi>i</mi><mo>,</mo><mi>l</mi><mo>,</mo><mi>t</mi></mrow></msub><mo>,</mo><msubsup><mi>𝒘</mi><mrow><mi>j</mi><mo>,</mo><mi>l</mi><mo>,</mo><mi>t</mi></mrow><mo>⊤</mo></msubsup></mrow><mo>⟩</mo></mrow><mi>F</mi></msub><mo>=</mo><mrow><mtext>Tr</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><msubsup><mi>𝒘</mi><mrow><mi>i</mi><mo>,</mo><mi>l</mi><mo>,</mo><mi>t</mi></mrow><mo>⊤</mo></msubsup><mo>,</mo><msub><mi>𝒘</mi><mrow><mi>j</mi><mo>,</mo><mi>l</mi><mo>,</mo><mi>t</mi></mrow></msub><mo>)</mo></mrow></mrow><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\left&lt;\bm{w}_{i,l,t},\bm{w}_{j,l,t}^{\top}\right&gt;_{F}=\text{Tr}\left(\bm{w}_{i,l,t}^{\top},\bm{w}_{j,l,t}\right)=0</annotation></semantics></math>.</p>
</div>
<div id="S7.SS2.p2" class="ltx_para">
<p id="S7.SS2.p2.1" class="ltx_p">This completes the proof.</p>
</div>
</section>
</section>
<section id="bib" class="ltx_bibliography">
<h2 class="ltx_title ltx_title_bibliography">References</h2>

<ul class="ltx_biblist">
      
