<td id="S4.T2.8.1.2.9" class="ltx_td ltx_align_center ltx_border_t" style="padding:0.9pt 2.5pt;"><span id="S4.T2.8.1.2.9.1" class="ltx_text" style="font-size:90%;">ASR</span><math id="S4.T2.m9" class="ltx_Math" alttext="\downarrow" display="inline" intent=":literal"><semantics><mo mathsize="0.900em" stretchy="false">↓</mo><annotation encoding="application/x-tex">\downarrow</annotation></semantics></math></td>
<td id="S4.T2.8.1.2.10" class="ltx_td ltx_align_center ltx_border_t" style="padding:0.9pt 2.5pt;"><span id="S4.T2.8.1.2.10.1" class="ltx_text" style="font-size:90%;">UA</span><math id="S4.T2.m10" class="ltx_Math" alttext="\uparrow" display="inline" intent=":literal"><semantics><mo mathsize="0.900em" stretchy="false">↑</mo><annotation encoding="application/x-tex">\uparrow</annotation></semantics></math></td>
<td id="S4.T2.8.1.2.11" class="ltx_td ltx_align_center ltx_border_t" style="padding:0.9pt 2.5pt;"><span id="S4.T2.8.1.2.11.1" class="ltx_text" style="font-size:90%;">ASR</span><math id="S4.T2.m11" class="ltx_Math" alttext="\downarrow" display="inline" intent=":literal"><semantics><mo mathsize="0.900em" stretchy="false">↓</mo><annotation encoding="application/x-tex">\downarrow</annotation></semantics></math></td>
<td id="S4.T2.8.1.2.12" class="ltx_td ltx_align_center ltx_border_t" style="padding:0.9pt 2.5pt;"><span id="S4.T2.8.1.2.12.1" class="ltx_text" style="font-size:90%;">UA</span><math id="S4.T2.m12" class="ltx_Math" alttext="\uparrow" display="inline" intent=":literal"><semantics><mo mathsize="0.900em" stretchy="false">↑</mo><annotation encoding="application/x-tex">\uparrow</annotation></semantics></math></td></tr>
<tr id="S4.T2.8.1.3" class="ltx_tr">
<td id="S4.T2.8.1.3.1" class="ltx_td ltx_align_left ltx_border_r ltx_border_t" style="padding:0.9pt 2.5pt;" rowspan="4"><span id="S4.T2.8.1.3.1.1" class="ltx_text ltx_font_smallcaps" style="font-size:90%;">Qwen-3-8B</span></td>
<td id="S4.T2.8.1.3.2" class="ltx_td ltx_align_left ltx_border_r ltx_border_t" style="padding:0.9pt 2.5pt;" rowspan="4"><span id="S4.T2.8.1.3.2.1" class="ltx_text" style="font-size:90%;">69.8</span></td>
<td id="S4.T2.8.1.3.3" class="ltx_td ltx_align_left ltx_border_r ltx_border_t" style="padding:0.9pt 2.5pt;"><span id="S4.T2.8.1.3.3.1" class="ltx_text" style="font-size:90%;">Ignore Instruction</span></td>
<td id="S4.T2.8.1.3.4" class="ltx_td ltx_align_center ltx_border_t" style="padding:0.9pt 2.5pt;"><span id="S4.T2.8.1.3.4.1" class="ltx_text" style="font-size:90%;">25.0</span></td>
<td id="S4.T2.8.1.3.5" class="ltx_td ltx_align_center ltx_border_t" style="padding:0.9pt 2.5pt;"><span id="S4.T2.8.1.3.5.1" class="ltx_text" style="font-size:90%;">49.7</span></td>
<td id="S4.T2.8.1.3.6" class="ltx_td ltx_align_center ltx_border_t" style="padding:0.9pt 2.5pt;"><span id="S4.T2.8.1.3.6.1" class="ltx_text" style="font-size:90%;">11.7</span></td>
<td id="S4.T2.8.1.3.7" class="ltx_td ltx_align_center ltx_border_t" style="padding:0.9pt 2.5pt;"><span id="S4.T2.8.1.3.7.1" class="ltx_text" style="font-size:90%;">54.2</span></td>
<td id="S4.T2.8.1.3.8" class="ltx_td ltx_align_center ltx_border_t" style="padding:0.9pt 2.5pt;"><span id="S4.T2.8.1.3.8.1" class="ltx_text" style="font-size:90%;">15.3</span></td>
