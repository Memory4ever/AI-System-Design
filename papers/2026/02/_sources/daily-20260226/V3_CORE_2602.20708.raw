<td id="S5.T5.8.1.6.8" class="ltx_td ltx_align_center ltx_border_bb ltx_border_t" style="padding:0.9pt 4.0pt;"><span id="S5.T5.8.1.6.8.1" class="ltx_text" style="font-size:90%;">28.8</span></td>
