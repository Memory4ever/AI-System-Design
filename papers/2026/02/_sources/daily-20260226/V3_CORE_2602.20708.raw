<td id="S4.T2.8.1.2.4" class="ltx_td ltx_align_center ltx_border_t" style="padding:0.9pt 2.5pt;"><span id="S4.T2.8.1.2.4.1" class="ltx_text" style="font-size:90%;">UA</span><math id="S4.T2.m4" class="ltx_Math" alttext="\uparrow" display="inline" intent=":literal"><semantics><mo mathsize="0.900em" stretchy="false">↑</mo><annotation encoding="application/x-tex">\uparrow</annotation></semantics></math></td>
<td id="S4.T2.8.1.2.5" class="ltx_td ltx_align_center ltx_border_t" style="padding:0.9pt 2.5pt;"><span id="S4.T2.8.1.2.5.1" class="ltx_text" style="font-size:90%;">ASR</span><math id="S4.T2.m5" class="ltx_Math" alttext="\downarrow" display="inline" intent=":literal"><semantics><mo mathsize="0.900em" stretchy="false">↓</mo><annotation encoding="application/x-tex">\downarrow</annotation></semantics></math></td>
<td id="S4.T2.8.1.2.6" class="ltx_td ltx_align_center ltx_border_t" style="padding:0.9pt 2.5pt;"><span id="S4.T2.8.1.2.6.1" class="ltx_text" style="font-size:90%;">UA</span><math id="S4.T2.m6" class="ltx_Math" alttext="\uparrow" display="inline" intent=":literal"><semantics><mo mathsize="0.900em" stretchy="false">↑</mo><annotation encoding="application/x-tex">\uparrow</annotation></semantics></math></td>
