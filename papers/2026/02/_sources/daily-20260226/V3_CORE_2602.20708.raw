<td id="S4.T2.8.1.1.7" class="ltx_td ltx_align_center ltx_border_tt" style="padding:0.9pt 2.5pt;" colspan="2"><span id="S4.T2.8.1.1.7.1" class="ltx_text ltx_font_bold" style="font-size:90%;">MELON</span></td>
<td id="S4.T2.8.1.1.8" class="ltx_td ltx_align_center ltx_border_tt" style="padding:0.9pt 2.5pt;" colspan="2"><span id="S4.T2.8.1.1.8.1" class="ltx_text ltx_font_bold" style="font-size:90%;">LLM-Detector</span></td>
<td id="S4.T2.8.1.1.9" class="ltx_td ltx_align_center ltx_border_tt" style="padding:0.9pt 2.5pt;" colspan="2"><span id="S4.T2.8.1.1.9.1" class="ltx_text ltx_font_bold" style="font-size:90%;">ICON (Ours)</span></td></tr>
<tr id="S4.T2.8.1.2" class="ltx_tr">
<td id="S4.T2.8.1.2.1" class="ltx_td ltx_align_center ltx_border_t" style="padding:0.9pt 2.5pt;"><span id="S4.T2.8.1.2.1.1" class="ltx_text" style="font-size:90%;">ASR</span><math id="S4.T2.m1" class="ltx_Math" alttext="\downarrow" display="inline" intent=":literal"><semantics><mo mathsize="0.900em" stretchy="false">↓</mo><annotation encoding="application/x-tex">\downarrow</annotation></semantics></math></td>
