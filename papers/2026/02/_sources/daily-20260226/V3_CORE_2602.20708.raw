<td id="S4.T2.8.1.1.2" class="ltx_td ltx_align_left ltx_border_r ltx_border_tt" style="padding:0.9pt 2.5pt;" rowspan="2"><span id="S4.T2.8.1.1.2.1" class="ltx_text ltx_font_bold" style="font-size:90%;">BU</span></td>
<td id="S4.T2.8.1.1.3" class="ltx_td ltx_align_left ltx_border_r ltx_border_tt" style="padding:0.9pt 2.5pt;" rowspan="2"><span id="S4.T2.8.1.1.3.1" class="ltx_text ltx_font_bold" style="font-size:90%;">Attack</span></td>
