<td id="S5.T3.fig1.1.1.5.8" class="ltx_td ltx_align_center" style="padding:-0.1pt 2.0pt;"><span id="S5.T3.fig1.1.1.5.8.1" class="ltx_text" style="font-size:90%;">48.9</span></td></tr>
