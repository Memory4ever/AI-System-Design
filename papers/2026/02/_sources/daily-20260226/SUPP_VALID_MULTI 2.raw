        <span>&nbsp;[<a href="https://arxiv.org/pdf/2602.21395">pdf</a>, <a href="https://arxiv.org/ps/2602.21395">ps</a>, <a href="https://arxiv.org/format/2602.21395">other</a>]&nbsp;</span>
