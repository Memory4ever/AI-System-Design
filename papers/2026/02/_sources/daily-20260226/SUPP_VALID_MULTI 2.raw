      <a href="/search/?searchtype=author&amp;query=Boominathan%2C+L">Lokesh Boominathan</a>, 
      
      <a href="/search/?searchtype=author&amp;query=Bhendawade%2C+N">Nikhil Bhendawade</a>, 
      
      <a href="/search/?searchtype=author&amp;query=Shidani%2C+A">Amitis Shidani</a>, 
      
      <a href="/search/?searchtype=author&amp;query=Pelemans%2C+J">Joris Pelemans</a>, 
      
      <a href="/search/?searchtype=author&amp;query=Olausson%2C+T+X">Theo X. Olausson</a>, 
      
      <a href="/search/?searchtype=author&amp;query=Hjelm%2C+D">Devon Hjelm</a>, 
      
