        <span>&nbsp;[<a href="https://arxiv.org/pdf/2602.20976">pdf</a>, <a href="https://arxiv.org/ps/2602.20976">ps</a>, <a href="https://arxiv.org/format/2602.20976">other</a>]&nbsp;</span>
