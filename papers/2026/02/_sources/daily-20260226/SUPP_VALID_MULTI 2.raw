      <a href="/search/?searchtype=author&amp;query=Zhang%2C+L">Lingjun Zhang</a>, 
      
      <a href="/search/?searchtype=author&amp;query=Yuan%2C+Y">Yujian Yuan</a>, 
      
      <a href="/search/?searchtype=author&amp;query=Wu%2C+C">Changjie Wu</a>, 
      
      <a href="/search/?searchtype=author&amp;query=Chang%2C+X">Xinyuan Chang</a>, 
      
