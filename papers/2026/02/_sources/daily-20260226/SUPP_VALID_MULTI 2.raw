      <a href="/search/?searchtype=author&amp;query=Ying%2C+R">Rex Ying</a>, 
      
      <a href="/search/?searchtype=author&amp;query=Erichson%2C+N+B">N. Benjamin Erichson</a>, 
      
      <a href="/search/?searchtype=author&amp;query=Mahoney%2C+M+W">Michael W. Mahoney</a>
      
