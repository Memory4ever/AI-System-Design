      <a href="/search/?searchtype=author&amp;query=Tan%2C+Z">Zimu Tan</a>, 
      
      <a href="/search/?searchtype=author&amp;query=Chen%2C+L">Long Chen</a>, 
      
      <a href="/search/?searchtype=author&amp;query=Ye%2C+H">Hangjun Ye</a>, 
      
