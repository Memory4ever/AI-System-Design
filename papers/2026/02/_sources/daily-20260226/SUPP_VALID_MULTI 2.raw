      <a href="/search/?searchtype=author&amp;query=Ro%C3%9Fberg%2C+N">Niklas Roßberg</a>, 
      
      <a href="/search/?searchtype=author&amp;query=Botsch%2C+M">Michael Botsch</a>, 
      
