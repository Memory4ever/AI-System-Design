</span></td>
<td id="Sx1.T3.5.4.4" class="ltx_td ltx_nopad_l ltx_nopad_r ltx_align_left ltx_border_bb" style="padding-left:0.0pt;padding-right:0.0pt;">
<span id="Sx1.T3.5.4.4.1" class="ltx_inline-block ltx_align_top">
<span id="Sx1.T3.5.4.4.1.1" class="ltx_p ltx_align_center"><span id="Sx1.T3.5.4.4.1.1.1" class="ltx_text" style="font-size:70%;">16.910</span></span>
</span></td>
<td id="Sx1.T3.5.4.5" class="ltx_td ltx_nopad_l ltx_nopad_r ltx_align_left ltx_border_bb" style="padding-left:0.0pt;padding-right:0.0pt;">
<span id="Sx1.T3.5.4.5.1" class="ltx_inline-block ltx_align_top">
<span id="Sx1.T3.5.4.5.1.1" class="ltx_p ltx_align_center"><span id="Sx1.T3.5.4.5.1.1.1" class="ltx_text ltx_font_bold" style="font-size:70%;">83.43</span></span>
</span></td>
<td id="Sx1.T3.5.4.6" class="ltx_td ltx_nopad_l ltx_nopad_r ltx_align_left ltx_border_bb" style="padding-left:0.0pt;padding-right:0.0pt;">
<span id="Sx1.T3.5.4.6.1" class="ltx_inline-block ltx_align_top">
<span id="Sx1.T3.5.4.6.1.1" class="ltx_p ltx_align_center"><span id="Sx1.T3.5.4.6.1.1.1" class="ltx_text" style="font-size:70%;">1.78</span></span>
</span></td>
<td id="Sx1.T3.5.4.7" class="ltx_td ltx_nopad_l ltx_nopad_r ltx_align_left ltx_border_bb" style="padding-left:0.0pt;padding-right:0.0pt;">
<span id="Sx1.T3.5.4.7.1" class="ltx_inline-block ltx_align_top">
<span id="Sx1.T3.5.4.7.1.1" class="ltx_p ltx_align_center"><span id="Sx1.T3.5.4.7.1.1.1" class="ltx_text ltx_font_bold" style="font-size:70%;">30.58</span></span>
</span></td>
<td id="Sx1.T3.5.4.8" class="ltx_td ltx_nopad_l ltx_nopad_r ltx_align_left ltx_border_bb" style="padding-left:0.0pt;padding-right:0.0pt;">
<span id="Sx1.T3.5.4.8.1" class="ltx_inline-block ltx_align_top">
