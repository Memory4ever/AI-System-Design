<span id="S5.F5.3.1.11.1.1.3.1.2.1" class="ltx_td ltx_nopad_l ltx_nopad_r ltx_align_center" style="padding-left:0.0pt;padding-right:0.0pt;">3DS2V <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib36" title="" class="ltx_ref">89</a>]</cite></span></span>
</span></span><span id="S5.F5.3.1.11.1.1.4" class="ltx_text"></span></p>
</span></div></td>
<td id="S5.F5.3.1.12" class="ltx_td ltx_nopad_l ltx_nopad_r ltx_align_left" style="padding-left:0.0pt;padding-right:0.0pt;">
<div id="S5.F5.3.1.12.1" class="ltx_inline-block ltx_align_center ltx_align_top ltx_transformed_outer" style="width:16.8pt;height:4.8pt;vertical-align:-0.0pt;"><span class="ltx_transformed_inner" style="width:16.8pt;transform:translate(0.0pt,0.0pt) rotate(-0deg) ;">
<p id="S5.F5.3.1.12.1.1" class="ltx_p"><span id="S5.F5.3.1.12.1.1.1" class="ltx_text" style="font-size:70%;">Ours</span></p>
</span></div></td></tr>
<tr id="S5.F5.3.2" class="ltx_tr">
<td id="S5.F5.3.2.1" class="ltx_td ltx_nopad_l ltx_nopad_r ltx_align_center ltx_border_r ltx_border_t" style="padding-left:0.0pt;padding-right:0.0pt;" colspan="4"><img src="2602.20666v1/figures/stage-2-comparison/474_stage_2_paired.png" id="S5.F5.g1" class="ltx_graphics ltx_img_landscape" style="aspect-ratio:229/50;" width="229" height="50" alt="Refer to caption"></td>
<td id="S5.F5.3.2.2" class="ltx_td ltx_nopad_l ltx_nopad_r ltx_align_center ltx_border_r ltx_border_t" style="padding-left:0.0pt;padding-right:0.0pt;" colspan="4"><img src="2602.20666v1/figures/stage-2-comparison/427_stage_2_paired.png" id="S5.F5.g2" class="ltx_graphics ltx_img_landscape" style="aspect-ratio:229/58;" width="229" height="58" alt="Refer to caption"></td>
<td id="S5.F5.3.2.3" class="ltx_td ltx_nopad_l ltx_align_center ltx_border_t" style="padding-left:0.0pt;padding-right:0.0pt;" colspan="4"><img src="2602.20666v1/figures/stage-2-comparison/150_stage_2_paired.png" id="S5.F5.g3" class="ltx_graphics ltx_img_landscape" style="aspect-ratio:229/58;" width="229" height="58" alt="Refer to caption"></td></tr>
