</span></td>
<td id="Sx1.T5.7.2.4" class="ltx_td ltx_nopad_l ltx_nopad_r ltx_align_left ltx_border_t" style="padding-left:0.8pt;padding-right:0.8pt;">
<span id="Sx1.T5.7.2.4.1" class="ltx_inline-block ltx_align_top">
<span id="Sx1.T5.7.2.4.1.1" class="ltx_p ltx_align_center"><span id="Sx1.T5.7.2.4.1.1.1" class="ltx_text ltx_font_bold" style="font-size:70%;">EMD</span></span>
</span></td>
