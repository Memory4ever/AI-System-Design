<td id="S5.F5.3.3.1" class="ltx_td ltx_nopad_l ltx_nopad_r ltx_align_center ltx_border_r" style="padding-left:0.0pt;padding-right:0.0pt;" colspan="4"><img src="2602.20666v1/figures/stage-2-comparison/125_stage_2_paired.png" id="S5.F5.g4" class="ltx_graphics ltx_img_landscape" style="aspect-ratio:229/58;" width="229" height="58" alt="Refer to caption"></td>
<td id="S5.F5.3.3.2" class="ltx_td ltx_nopad_l ltx_nopad_r ltx_align_center ltx_border_r" style="padding-left:0.0pt;padding-right:0.0pt;" colspan="4"><img src="2602.20666v1/figures/stage-2-comparison/68_stage_2_paired.png" id="S5.F5.g5" class="ltx_graphics ltx_img_landscape" style="aspect-ratio:229/58;" width="229" height="58" alt="Refer to caption"></td>
