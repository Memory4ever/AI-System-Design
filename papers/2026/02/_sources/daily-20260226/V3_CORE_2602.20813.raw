<td id="S6.T4.3.25.4" class="ltx_td ltx_align_center ltx_border_bb"><span id="S6.T4.3.25.4.1" class="ltx_text" style="font-size:80%;">42.8%</span></td>
<td id="S6.T4.3.25.5" class="ltx_td ltx_nopad_r ltx_align_center ltx_border_bb"><math id="S6.T4.m23" class="ltx_Math" alttext="-" display="inline" intent=":literal"><semantics><mo mathsize="0.800em">−</mo><annotation encoding="application/x-tex">-</annotation></semantics></math><span id="S6.T4.3.25.5.1" class="ltx_text" style="font-size:80%;">47.2%</span></td></tr>
