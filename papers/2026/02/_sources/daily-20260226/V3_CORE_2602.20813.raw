<td id="A6.T9.5.2.4" class="ltx_td ltx_align_right ltx_border_t">8</td></tr>
<tr id="A6.T9.5.3" class="ltx_tr">
<td id="A6.T9.5.3.1" class="ltx_td ltx_align_left">Scheming</td>
<td id="A6.T9.5.3.2" class="ltx_td ltx_align_right">0.787</td>
