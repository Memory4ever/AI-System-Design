<td id="A6.T9.5.4.1" class="ltx_td ltx_align_left">Safety</td>
<td id="A6.T9.5.4.2" class="ltx_td ltx_align_right">0.770</td>
<td id="A6.T9.5.4.3" class="ltx_td ltx_align_right">0.146</td>
<td id="A6.T9.5.4.4" class="ltx_td ltx_align_right">5</td></tr>
<tr id="A6.T9.5.5" class="ltx_tr">
