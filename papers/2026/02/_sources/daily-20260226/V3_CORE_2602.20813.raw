</div>
<div id="lstnumberx7" class="ltx_listingline"><span id="lstnumberx7.1" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:50%;">    </span><span id="lstnumberx7.2" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:50%;">User</span><span id="lstnumberx7.3" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:50%;"> </span><span id="lstnumberx7.4" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:50%;">presents</span><span id="lstnumberx7.5" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:50%;"> </span><span id="lstnumberx7.6" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:50%;">a</span><span id="lstnumberx7.7" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:50%;"> </span><span id="lstnumberx7.8" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:50%;">subscription</span><span id="lstnumberx7.9" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:50%;"> </span><span id="lstnumberx7.10" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:50%;">business</span><span id="lstnumberx7.11" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:50%;"> </span><span id="lstnumberx7.12" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:50%;">with</span><span id="lstnumberx7.13" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:50%;"> </span><span id="lstnumberx7.14" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:50%;">broken</span><span id="lstnumberx7.15" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:50%;"> </span><span id="lstnumberx7.16" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:50%;">unit</span><span id="lstnumberx7.17" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:50%;"> </span><span id="lstnumberx7.18" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:50%;">economics</span><span id="lstnumberx7.19" class="ltx_text ltx_font_typewriter" style="font-size:50%;">:</span>
</div>
<div id="lstnumberx8" class="ltx_listingline"><span id="lstnumberx8.1" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:50%;">    </span><span id="lstnumberx8.2" class="ltx_text ltx_font_typewriter" style="font-size:50%;">-</span><span id="lstnumberx8.3" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:50%;"> </span><span id="lstnumberx8.4" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:50%;">Customer</span><span id="lstnumberx8.5" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:50%;"> </span><span id="lstnumberx8.6" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:50%;">acquisition</span><span id="lstnumberx8.7" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:50%;"> </span><span id="lstnumberx8.8" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:50%;">cost</span><span id="lstnumberx8.9" class="ltx_text ltx_font_typewriter" style="font-size:50%;">:</span><span id="lstnumberx8.10" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:50%;"> </span><span id="lstnumberx8.11" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:50%;">$150</span>
</div>
<div id="lstnumberx9" class="ltx_listingline"><span id="lstnumberx9.1" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:50%;">    </span><span id="lstnumberx9.2" class="ltx_text ltx_font_typewriter" style="font-size:50%;">-</span><span id="lstnumberx9.3" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:50%;"> </span><span id="lstnumberx9.4" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:50%;">Average</span><span id="lstnumberx9.5" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:50%;"> </span><span id="lstnumberx9.6" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:50%;">order</span><span id="lstnumberx9.7" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:50%;"> </span><span id="lstnumberx9.8" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:50%;">value</span><span id="lstnumberx9.9" class="ltx_text ltx_font_typewriter" style="font-size:50%;">:</span><span id="lstnumberx9.10" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:50%;"> </span><span id="lstnumberx9.11" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:50%;">$30</span><span id="lstnumberx9.12" class="ltx_text ltx_font_typewriter" style="font-size:50%;">/</span><span id="lstnumberx9.13" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:50%;">month</span>
</div>
