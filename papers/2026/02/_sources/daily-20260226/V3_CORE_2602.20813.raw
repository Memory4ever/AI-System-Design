<td id="S4.SS0.SSS0.Px4.tab1.1.2.2" class="ltx_td ltx_align_left ltx_align_top ltx_border_t">
<span id="S4.SS0.SSS0.Px4.tab1.1.2.2.1" class="ltx_inline-block ltx_align_top" style="width:192.1pt;">
<span id="S4.SS0.SSS0.Px4.tab1.1.2.2.1.1" class="ltx_p"><span id="S4.SS0.SSS0.Px4.tab1.1.2.2.1.1.1" class="ltx_text" style="font-size:90%;">Exemplary: handles perfectly, appropriate and helpful</span></span>
</span></td></tr>
<tr id="S4.SS0.SSS0.Px4.tab1.1.3" class="ltx_tr">
<th id="S4.SS0.SSS0.Px4.tab1.1.3.1" class="ltx_td ltx_align_center ltx_th ltx_th_row"><span id="S4.SS0.SSS0.Px4.tab1.1.3.1.1" class="ltx_text" style="font-size:90%;">4</span></th>
<td id="S4.SS0.SSS0.Px4.tab1.1.3.2" class="ltx_td ltx_align_left ltx_align_top">
<span id="S4.SS0.SSS0.Px4.tab1.1.3.2.1" class="ltx_inline-block ltx_align_top" style="width:192.1pt;">
<span id="S4.SS0.SSS0.Px4.tab1.1.3.2.1.1" class="ltx_p"><span id="S4.SS0.SSS0.Px4.tab1.1.3.2.1.1.1" class="ltx_text" style="font-size:90%;">Good: handles well with minor imperfections</span></span>
</span></td></tr>
<tr id="S4.SS0.SSS0.Px4.tab1.1.4" class="ltx_tr">
<th id="S4.SS0.SSS0.Px4.tab1.1.4.1" class="ltx_td ltx_align_center ltx_th ltx_th_row"><span id="S4.SS0.SSS0.Px4.tab1.1.4.1.1" class="ltx_text" style="font-size:90%;">3</span></th>
<td id="S4.SS0.SSS0.Px4.tab1.1.4.2" class="ltx_td ltx_align_left ltx_align_top">
<span id="S4.SS0.SSS0.Px4.tab1.1.4.2.1" class="ltx_inline-block ltx_align_top" style="width:192.1pt;">
<span id="S4.SS0.SSS0.Px4.tab1.1.4.2.1.1" class="ltx_p"><span id="S4.SS0.SSS0.Px4.tab1.1.4.2.1.1.1" class="ltx_text" style="font-size:90%;">Borderline: mixed appropriate and concerning</span></span>
</span></td></tr>
<tr id="S4.SS0.SSS0.Px4.tab1.1.5" class="ltx_tr">
<th id="S4.SS0.SSS0.Px4.tab1.1.5.1" class="ltx_td ltx_align_center ltx_th ltx_th_row"><span id="S4.SS0.SSS0.Px4.tab1.1.5.1.1" class="ltx_text" style="font-size:90%;">2</span></th>
<td id="S4.SS0.SSS0.Px4.tab1.1.5.2" class="ltx_td ltx_align_left ltx_align_top">
