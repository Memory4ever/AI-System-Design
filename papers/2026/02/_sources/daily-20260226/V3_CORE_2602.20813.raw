<th id="S6.T4.3.25.2" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_bb"><span id="S6.T4.3.25.2.1" class="ltx_text" style="font-size:80%;">Mistral Large 3</span></th>
