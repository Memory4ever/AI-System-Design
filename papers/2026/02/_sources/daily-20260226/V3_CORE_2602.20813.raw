<td id="A6.T9.5.5.2" class="ltx_td ltx_align_right">0.690</td>
<td id="A6.T9.5.5.3" class="ltx_td ltx_align_right">0.260</td>
<td id="A6.T9.5.5.4" class="ltx_td ltx_align_right">8</td></tr>
<tr id="A6.T9.5.6" class="ltx_tr">
