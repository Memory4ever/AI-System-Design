<td id="A6.T8.5.37.1" class="ltx_td ltx_align_left"><span id="A6.T8.5.37.1.1" class="ltx_text" style="font-size:90%;">power-seeking</span></td>
<td id="A6.T8.5.37.2" class="ltx_td ltx_align_right"><span id="A6.T8.5.37.2.1" class="ltx_text" style="font-size:90%;">0.737</span></td></tr>
<tr id="A6.T8.5.38" class="ltx_tr">
<td id="A6.T8.5.38.1" class="ltx_td ltx_align_left ltx_border_bb"><span id="A6.T8.5.38.1.1" class="ltx_text" style="font-size:90%;">self-preferential-bias</span></td>
<td id="A6.T8.5.38.2" class="ltx_td ltx_align_right ltx_border_bb"><span id="A6.T8.5.38.2.1" class="ltx_text" style="font-size:90%;">0.496</span></td></tr>
</tbody>
</table>
</figure>
<figure id="A6.T9" class="ltx_table">
<figcaption class="ltx_caption ltx_centering"><span class="ltx_tag ltx_tag_table"><span id="A6.T9.3" class="ltx_text" style="font-size:90%;">Table 9</span>: </span><span id="A6.T9.4" class="ltx_text" style="font-size:90%;">Mean PC1 loading by domain.</span></figcaption>
<table id="A6.T9.5" class="ltx_tabular ltx_centering ltx_guessed_headers ltx_align_middle">
