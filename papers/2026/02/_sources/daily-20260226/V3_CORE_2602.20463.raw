<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.E63Xb.m2" class="ltx_Math" alttext="\displaystyle=\int\int\frac{\phi_{j}(x)-z_{t}}{1-t}p_{Z_{t}|X_{1}}(z_{t}|x)p_{x|z}(x|z)dxdz_{t}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mstyle displaystyle="true"><mrow><mo rspace="0em">∫</mo><mo>∫</mo></mrow></mstyle><mo>⁡</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mrow><msub><mi>ϕ</mi><mi>j</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><msub><mi>z</mi><mi>t</mi></msub></mrow><mrow><mn>1</mn><mo>−</mo><mi>t</mi></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msub><mi>p</mi><mrow><msub><mi>Z</mi><mi>t</mi></msub><mo fence="false">|</mo><msub><mi>X</mi><mn>1</mn></msub></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>z</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">|</mo><mi>x</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>p</mi><mrow><mi>x</mi><mo fence="false">|</mo><mi>z</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo lspace="0em" rspace="0em">|</mo><mi>z</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo mathsize="0.700em" rspace="0em">𝑑</mo><mi>x</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>z</mi><mi>t</mi></msub></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\int\int\frac{\phi_{j}(x)-z_{t}}{1-t}p_{Z_{t}|X_{1}}(z_{t}|x)p_{x|z}(x|z)dxdz_{t}</annotation></semantics></math></td>
