<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.E58Xe.m2" class="ltx_Math" alttext="\displaystyle=\mathbb{E}[\phi_{j}(X_{1})|Z_{t}=z]" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><mrow><msub><mi>ϕ</mi><mi>j</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>X</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow></mrow><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mrow><msub><mi>Z</mi><mi>t</mi></msub><mo>=</mo><mi>z</mi></mrow></mrow><mo stretchy="false">]</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\mathbb{E}[\phi_{j}(X_{1})|Z_{t}=z]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A1.SS5.SSS0.Px1.p2.3" class="ltx_p"><span id="A1.SS5.SSS0.Px1.p2.3.1" class="ltx_text">When <math id="A1.SS5.SSS0.Px1.p2.m4" class="ltx_Math" alttext="\phi_{j}(X_{t})=Z_{t}" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>ϕ</mi><mi>j</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>X</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><msub><mi>Z</mi><mi>t</mi></msub></mrow><annotation encoding="application/x-tex">\phi_{j}(X_{t})=Z_{t}</annotation></semantics></math> holds, we have</span></p>
<table id="A1.E59" class="ltx_equationgroup ltx_eqn_table">
<tbody>
<tr id="A1.E59X" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A1.E59X.m2" class="ltx_Math" alttext="\displaystyle u_{t}^{z,*}(z)" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>u</mi><mi>t</mi><mrow><mi>z</mi><mo rspace="0em">,</mo><mo lspace="0em">∗</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>z</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle u_{t}^{z,*}(z)</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.E59X.m3" class="ltx_Math" alttext="\displaystyle=\int\frac{z_{1}-z}{1-t}p_{Z_{1}|Z_{t}}(z_{1}|z)dz_{1}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mstyle displaystyle="true"><mrow><mo>∫</mo><mrow><mfrac><mrow><msub><mi>z</mi><mn>1</mn></msub><mo>−</mo><mi>z</mi></mrow><mrow><mn>1</mn><mo>−</mo><mi>t</mi></mrow></mfrac><mo lspace="0em" rspace="0em">​</mo><msub><mi>p</mi><mrow><msub><mi>Z</mi><mn>1</mn></msub><mo fence="false">|</mo><msub><mi>Z</mi><mi>t</mi></msub></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>z</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">|</mo><mi>z</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>z</mi><mn>1</mn></msub></mrow></mrow></mstyle></mrow><annotation encoding="application/x-tex">\displaystyle=\int\frac{z_{1}-z}{1-t}p_{Z_{1}|Z_{t}}(z_{1}|z)dz_{1}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="9" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equationgroup ltx_align_right">(59)</span></td></tr>
<tr id="A1.E59Xa" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.E59Xa.m2" class="ltx_Math" alttext="\displaystyle=\int\frac{z_{1}-z}{1-t}\int p_{Z_{1}|Z_{t},X_{t}}(z_{1}|z,x)p_{x|z}(x|z)dxdz_{1}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mstyle displaystyle="true"><mrow><mo>∫</mo><mrow><mfrac><mrow><msub><mi>z</mi><mn>1</mn></msub><mo>−</mo><mi>z</mi></mrow><mrow><mn>1</mn><mo>−</mo><mi>t</mi></mrow></mfrac><mo lspace="0em" rspace="0em">​</mo><mrow><mo>∫</mo><mrow><msub><mi>p</mi><mrow><msub><mi>Z</mi><mn>1</mn></msub><mo fence="false">|</mo><mrow><msub><mi>Z</mi><mi>t</mi></msub><mo>,</mo><msub><mi>X</mi><mi>t</mi></msub></mrow></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>z</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">|</mo><mrow><mi>z</mi><mo>,</mo><mi>x</mi></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>p</mi><mrow><mi>x</mi><mo fence="false">|</mo><mi>z</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo lspace="0em" rspace="0em">|</mo><mi>z</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo mathsize="0.700em" rspace="0em">d</mo><mi>x</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>z</mi><mn>1</mn></msub></mrow></mrow></mrow></mrow></mstyle></mrow><annotation encoding="application/x-tex">\displaystyle=\int\frac{z_{1}-z}{1-t}\int p_{Z_{1}|Z_{t},X_{t}}(z_{1}|z,x)p_{x|z}(x|z)dxdz_{1}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr>
<tr id="A1.E59Xb" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.E59Xb.m2" class="ltx_Math" alttext="\displaystyle\overset{Z_{t}=\phi_{j}(X_{t})}{=}\int\int\frac{z_{1}-\phi_{j}(x)}{1-t}p_{Z_{1}|X_{t}}(z_{1}|x)p_{x|z}(x|z)dxdz_{1}" display="inline" intent=":literal"><semantics><mrow><mover accent="true"><mo>=</mo><mrow><msub><mi mathsize="0.700em">Z</mi><mi mathsize="0.710em">t</mi></msub><mo mathsize="0.700em">=</mo><mrow><msub><mi mathsize="0.700em">ϕ</mi><mi mathsize="0.710em">j</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="0.700em" minsize="0.700em">(</mo><msub><mi mathsize="0.700em">X</mi><mi mathsize="0.710em">t</mi></msub><mo maxsize="0.700em" minsize="0.700em">)</mo></mrow></mrow></mrow></mover><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mrow><mo rspace="0em">∫</mo><mrow><mo>∫</mo><mrow><mfrac><mrow><msub><mi>z</mi><mn>1</mn></msub><mo>−</mo><mrow><msub><mi>ϕ</mi><mi>j</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mrow><mn>1</mn><mo>−</mo><mi>t</mi></mrow></mfrac><mo lspace="0em" rspace="0em">​</mo><msub><mi>p</mi><mrow><msub><mi>Z</mi><mn>1</mn></msub><mo fence="false">|</mo><msub><mi>X</mi><mi>t</mi></msub></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>z</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">|</mo><mi>x</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>p</mi><mrow><mi>x</mi><mo fence="false">|</mo><mi>z</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo lspace="0em" rspace="0em">|</mo><mi>z</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo mathsize="0.700em" rspace="0em">d</mo><mi>x</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>z</mi><mn>1</mn></msub></mrow></mrow></mrow></mstyle></mrow><annotation encoding="application/x-tex">\displaystyle\overset{Z_{t}=\phi_{j}(X_{t})}{=}\int\int\frac{z_{1}-\phi_{j}(x)}{1-t}p_{Z_{1}|X_{t}}(z_{1}|x)p_{x|z}(x|z)dxdz_{1}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr>
<tr id="A1.E59Xc" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.E59Xc.m2" class="ltx_Math" alttext="\displaystyle=\int\frac{\int z_{1}p_{Z_{1}|X_{t}}(z_{1}|x)dz_{1}-\phi_{j}(x)}{1-t}p_{x|z}(x|z)dx" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mstyle displaystyle="true"><mrow><mo>∫</mo><mrow><mfrac><mrow><mrow><mo>∫</mo><mrow><msub><mi>z</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>p</mi><mrow><msub><mi>Z</mi><mn>1</mn></msub><mo fence="false">|</mo><msub><mi>X</mi><mi>t</mi></msub></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>z</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">|</mo><mi>x</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>z</mi><mn>1</mn></msub></mrow></mrow><mo>−</mo><mrow><msub><mi>ϕ</mi><mi>j</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mrow><mn>1</mn><mo>−</mo><mi>t</mi></mrow></mfrac><mo lspace="0em" rspace="0em">​</mo><msub><mi>p</mi><mrow><mi>x</mi><mo fence="false">|</mo><mi>z</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo lspace="0em" rspace="0em">|</mo><mi>z</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo rspace="0em">𝑑</mo><mi>x</mi></mrow></mrow></mrow></mstyle></mrow><annotation encoding="application/x-tex">\displaystyle=\int\frac{\int z_{1}p_{Z_{1}|X_{t}}(z_{1}|x)dz_{1}-\phi_{j}(x)}{1-t}p_{x|z}(x|z)dx</annotation></semantics></math></td>
