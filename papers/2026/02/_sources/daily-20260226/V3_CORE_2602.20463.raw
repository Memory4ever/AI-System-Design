<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.E60Xa.m2" class="ltx_Math" alttext="\displaystyle=\int\int\phi_{j}(x_{1})\delta_{z_{1}=\phi_{j}(x_{1})}p_{X_{1}|X_{t}}(x_{1}|x)dx_{1}dz_{1}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mstyle displaystyle="true"><mrow><mo rspace="0em">∫</mo><mo>∫</mo></mrow></mstyle><mo>⁡</mo><mrow><msub><mi>ϕ</mi><mi>j</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>δ</mi><mrow><msub><mi>z</mi><mn>1</mn></msub><mo>=</mo><mrow><msub><mi>ϕ</mi><mi>j</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow></mrow></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>p</mi><mrow><msub><mi>X</mi><mn>1</mn></msub><mo fence="false">|</mo><msub><mi>X</mi><mi>t</mi></msub></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">|</mo><mi>x</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>x</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>z</mi><mn>1</mn></msub></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\int\int\phi_{j}(x_{1})\delta_{z_{1}=\phi_{j}(x_{1})}p_{X_{1}|X_{t}}(x_{1}|x)dx_{1}dz_{1}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr>
<tr id="A1.E60Xb" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.E60Xb.m2" class="ltx_Math" alttext="\displaystyle=\int\phi_{j}(x_{1})\int\delta_{z_{1}=\phi_{j}(x_{1})}dz_{1}p_{X_{1}|X_{t}}(x_{1}|x)dx_{1}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mstyle displaystyle="true"><mrow><mo>∫</mo><mrow><msub><mi>ϕ</mi><mi>j</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo>∫</mo><mrow><msub><mi>δ</mi><mrow><msub><mi>z</mi><mn>1</mn></msub><mo>=</mo><mrow><msub><mi>ϕ</mi><mi>j</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow></mrow></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>z</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>p</mi><mrow><msub><mi>X</mi><mn>1</mn></msub><mo fence="false">|</mo><msub><mi>X</mi><mi>t</mi></msub></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">|</mo><mi>x</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>x</mi><mn>1</mn></msub></mrow></mrow></mrow></mrow></mstyle></mrow><annotation encoding="application/x-tex">\displaystyle=\int\phi_{j}(x_{1})\int\delta_{z_{1}=\phi_{j}(x_{1})}dz_{1}p_{X_{1}|X_{t}}(x_{1}|x)dx_{1}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr>
<tr id="A1.E60Xc" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.E60Xc.m2" class="ltx_Math" alttext="\displaystyle=\int\phi_{j}(x_{1})p_{X_{1}|X_{t}}(x_{1}|x)dx_{1}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mstyle displaystyle="true"><mrow><mo>∫</mo><mrow><msub><mi>ϕ</mi><mi>j</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>p</mi><mrow><msub><mi>X</mi><mn>1</mn></msub><mo fence="false">|</mo><msub><mi>X</mi><mi>t</mi></msub></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">|</mo><mi>x</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>x</mi><mn>1</mn></msub></mrow></mrow></mstyle></mrow><annotation encoding="application/x-tex">\displaystyle=\int\phi_{j}(x_{1})p_{X_{1}|X_{t}}(x_{1}|x)dx_{1}</annotation></semantics></math></td>
