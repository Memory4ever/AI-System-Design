<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.E58Xd.m2" class="ltx_Math" alttext="\displaystyle=\int\phi(x_{1})p_{X_{1}|Z_{t}}(x_{1}|z)dx_{1}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mstyle displaystyle="true"><mrow><mo>∫</mo><mrow><mrow><mi>ϕ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>p</mi><mrow><msub><mi>X</mi><mn>1</mn></msub><mo fence="false">|</mo><msub><mi>Z</mi><mi>t</mi></msub></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">|</mo><mi>z</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>x</mi><mn>1</mn></msub></mrow></mrow></mstyle></mrow><annotation encoding="application/x-tex">\displaystyle=\int\phi(x_{1})p_{X_{1}|Z_{t}}(x_{1}|z)dx_{1}</annotation></semantics></math></td>
