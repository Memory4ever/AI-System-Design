<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.E54Xb.m2" class="ltx_Math" alttext="\displaystyle=\frac{1}{1-t}[d-\frac{\nabla\cdot(\mathbb{E}_{x_{t}\sim p_{t}}[x_{t}k_{t}^{\epsilon}(x,x_{t})])\mathbb{E}_{x_{t}\sim p_{t}}[k_{t}^{\epsilon}(x,x_{t})]-\mathbb{E}_{x_{t}\sim p_{t}}[x_{t}k_{t}^{\epsilon}(x,x_{t})]\cdot\nabla(\mathbb{E}_{x_{t}\sim p_{t}}[k_{t}^{\epsilon}(x,x_{t})])}{(\mathbb{E}_{x_{t}\sim p_{t}}[k_{t}^{\epsilon}(x,x_{t})])^{2}}]" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mrow><mn>1</mn><mo>−</mo><mi>t</mi></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mrow><mi>d</mi><mo>−</mo><mstyle displaystyle="true"><mfrac><mrow><mrow><mrow><mo>∇</mo><mo lspace="0em" rspace="0.222em">⋅</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>𝔼</mi><mrow><msub><mi>x</mi><mi>t</mi></msub><mo>∼</mo><msub><mi>p</mi><mi>t</mi></msub></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mrow><msub><mi>x</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>k</mi><mi>t</mi><mi>ϵ</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><msub><mi>x</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">]</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝔼</mi><mrow><msub><mi>x</mi><mi>t</mi></msub><mo>∼</mo><msub><mi>p</mi><mi>t</mi></msub></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mrow><msubsup><mi>k</mi><mi>t</mi><mi>ϵ</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><msub><mi>x</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">]</mo></mrow></mrow><mo>−</mo><mrow><mrow><msub><mi>𝔼</mi><mrow><msub><mi>x</mi><mi>t</mi></msub><mo>∼</mo><msub><mi>p</mi><mi>t</mi></msub></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mrow><msub><mi>x</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>k</mi><mi>t</mi><mi>ϵ</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><msub><mi>x</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo rspace="0.055em" stretchy="false">]</mo></mrow></mrow><mo rspace="0.222em">⋅</mo><mrow><mo>∇</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>𝔼</mi><mrow><msub><mi>x</mi><mi>t</mi></msub><mo>∼</mo><msub><mi>p</mi><mi>t</mi></msub></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mrow><msubsup><mi>k</mi><mi>t</mi><mi>ϵ</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><msub><mi>x</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">]</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><msup><mrow><mo stretchy="false">(</mo><mrow><msub><mi>𝔼</mi><mrow><msub><mi>x</mi><mi>t</mi></msub><mo>∼</mo><msub><mi>p</mi><mi>t</mi></msub></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mrow><msubsup><mi>k</mi><mi>t</mi><mi>ϵ</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><msub><mi>x</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">]</mo></mrow></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mfrac></mstyle></mrow><mo stretchy="false">]</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\frac{1}{1-t}[d-\frac{\nabla\cdot(\mathbb{E}_{x_{t}\sim p_{t}}[x_{t}k_{t}^{\epsilon}(x,x_{t})])\mathbb{E}_{x_{t}\sim p_{t}}[k_{t}^{\epsilon}(x,x_{t})]-\mathbb{E}_{x_{t}\sim p_{t}}[x_{t}k_{t}^{\epsilon}(x,x_{t})]\cdot\nabla(\mathbb{E}_{x_{t}\sim p_{t}}[k_{t}^{\epsilon}(x,x_{t})])}{(\mathbb{E}_{x_{t}\sim p_{t}}[k_{t}^{\epsilon}(x,x_{t})])^{2}}]</annotation></semantics></math></td>
