<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.E60X.m3" class="ltx_Math" alttext="\displaystyle=\int\int\phi_{j}(x_{1})p_{Z_{1}|X_{t},X_{1}}(z_{1}|x,x_{1})p_{X_{1}|X_{t}}(x_{1}|x)dx_{1}dz_{1}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mstyle displaystyle="true"><mrow><mo rspace="0em">∫</mo><mo>∫</mo></mrow></mstyle><mo>⁡</mo><mrow><msub><mi>ϕ</mi><mi>j</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>p</mi><mrow><msub><mi>Z</mi><mn>1</mn></msub><mo fence="false">|</mo><mrow><msub><mi>X</mi><mi>t</mi></msub><mo>,</mo><msub><mi>X</mi><mn>1</mn></msub></mrow></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>z</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">|</mo><mrow><mi>x</mi><mo>,</mo><msub><mi>x</mi><mn>1</mn></msub></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>p</mi><mrow><msub><mi>X</mi><mn>1</mn></msub><mo fence="false">|</mo><msub><mi>X</mi><mi>t</mi></msub></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">|</mo><mi>x</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>x</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>z</mi><mn>1</mn></msub></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\int\int\phi_{j}(x_{1})p_{Z_{1}|X_{t},X_{1}}(z_{1}|x,x_{1})p_{X_{1}|X_{t}}(x_{1}|x)dx_{1}dz_{1}</annotation></semantics></math></td>
