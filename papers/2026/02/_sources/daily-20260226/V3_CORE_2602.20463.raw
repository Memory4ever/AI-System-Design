<th id="A2.T1.4.8.1" class="ltx_td ltx_align_left ltx_th ltx_th_row">   Laplacian kernel (<math id="A2.T1.m3" class="ltx_Math" alttext="B{=}256" display="inline" intent=":literal"><semantics><mrow><mi>B</mi><mo>=</mo><mn>256</mn></mrow><annotation encoding="application/x-tex">B{=}256</annotation></semantics></math>)</th>
<th id="A2.T1.4.8.2" class="ltx_td ltx_align_center ltx_th ltx_th_row">256</th>
<td id="A2.T1.4.8.3" class="ltx_td ltx_align_center">100K</td>
<td id="A2.T1.4.8.4" class="ltx_td ltx_align_center">18.87</td></tr>
<tr id="A2.T1.4.9" class="ltx_tr">
<th id="A2.T1.4.9.1" class="ltx_td ltx_align_left ltx_th ltx_th_row">   Laplacian kernel (<math id="A2.T1.m4" class="ltx_Math" alttext="B{=}1024" display="inline" intent=":literal"><semantics><mrow><mi>B</mi><mo>=</mo><mn>1024</mn></mrow><annotation encoding="application/x-tex">B{=}1024</annotation></semantics></math>)</th>
<th id="A2.T1.4.9.2" class="ltx_td ltx_align_center ltx_th ltx_th_row">1024</th>
<td id="A2.T1.4.9.3" class="ltx_td ltx_align_center">100K</td>
<td id="A2.T1.4.9.4" class="ltx_td ltx_align_center">14.71</td></tr>
<tr id="A2.T1.4.10" class="ltx_tr">
<th id="A2.T1.4.10.1" class="ltx_td ltx_align_left ltx_th ltx_th_row">   Gaussian kernel (<math id="A2.T1.m5" class="ltx_Math" alttext="B{=}64" display="inline" intent=":literal"><semantics><mrow><mi>B</mi><mo>=</mo><mn>64</mn></mrow><annotation encoding="application/x-tex">B{=}64</annotation></semantics></math>)</th>
<th id="A2.T1.4.10.2" class="ltx_td ltx_align_center ltx_th ltx_th_row">256</th>
<td id="A2.T1.4.10.3" class="ltx_td ltx_align_center">100K</td>
<td id="A2.T1.4.10.4" class="ltx_td ltx_align_center">24.70</td></tr>
<tr id="A2.T1.4.11" class="ltx_tr">
<th id="A2.T1.4.11.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_bb">   Gaussian kernel (<math id="A2.T1.m6" class="ltx_Math" alttext="B{=}256" display="inline" intent=":literal"><semantics><mrow><mi>B</mi><mo>=</mo><mn>256</mn></mrow><annotation encoding="application/x-tex">B{=}256</annotation></semantics></math>)</th>
<th id="A2.T1.4.11.2" class="ltx_td ltx_align_center ltx_th ltx_th_row ltx_border_bb">1024</th>
