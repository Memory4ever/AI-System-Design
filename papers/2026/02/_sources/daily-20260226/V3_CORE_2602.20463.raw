<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.E62X.m3" class="ltx_Math" alttext="\displaystyle=\int z_{t}p_{Z_{t}|Z_{1}}(z_{t}|z)dz_{t}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mstyle displaystyle="true"><mrow><mo>∫</mo><mrow><msub><mi>z</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>p</mi><mrow><msub><mi>Z</mi><mi>t</mi></msub><mo fence="false">|</mo><msub><mi>Z</mi><mn>1</mn></msub></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>z</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">|</mo><mi>z</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>z</mi><mi>t</mi></msub></mrow></mrow></mstyle></mrow><annotation encoding="application/x-tex">\displaystyle=\int z_{t}p_{Z_{t}|Z_{1}}(z_{t}|z)dz_{t}</annotation></semantics></math></td>
