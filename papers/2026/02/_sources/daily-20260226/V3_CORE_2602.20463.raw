<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.E54Xf.m2" class="ltx_Math" alttext="\displaystyle=\frac{1}{1-t}[d-\frac{2t^{2}}{2(1-t)^{2}+\epsilon}(\frac{\mathbb{E}_{x_{t}\sim p_{t}}[\|x_{t}\|^{2}k^{\epsilon}_{t}(x,x_{t})]}{\mathbb{E}_{x_{t}\sim p_{t}}[k^{\epsilon}_{t}(x,x_{t})]}-\|\frac{\mathbb{E}_{x_{t}\sim p_{t}}[x_{t}k^{\epsilon}_{t}(x,x_{t})]}{\mathbb{E}_{x_{t}\sim p_{t}}[k^{\epsilon}_{t}(x,x_{t})]}\|^{2})]" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mrow><mn>1</mn><mo>−</mo><mi>t</mi></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mrow><mi>d</mi><mo>−</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msup><mi>t</mi><mn>2</mn></msup></mrow><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>t</mi></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mrow><mo>+</mo><mi>ϵ</mi></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><msub><mi>𝔼</mi><mrow><msub><mi>x</mi><mi>t</mi></msub><mo>∼</mo><msub><mi>p</mi><mi>t</mi></msub></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mrow><msup><mrow><mo stretchy="false">‖</mo><msub><mi>x</mi><mi>t</mi></msub><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>k</mi><mi>t</mi><mi>ϵ</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><msub><mi>x</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">]</mo></mrow></mrow><mrow><msub><mi>𝔼</mi><mrow><msub><mi>x</mi><mi>t</mi></msub><mo>∼</mo><msub><mi>p</mi><mi>t</mi></msub></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mrow><msubsup><mi>k</mi><mi>t</mi><mi>ϵ</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><msub><mi>x</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">]</mo></mrow></mrow></mfrac></mstyle><mo>−</mo><msup><mrow><mo stretchy="false">‖</mo><mstyle displaystyle="true"><mfrac><mrow><msub><mi>𝔼</mi><mrow><msub><mi>x</mi><mi>t</mi></msub><mo>∼</mo><msub><mi>p</mi><mi>t</mi></msub></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mrow><msub><mi>x</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>k</mi><mi>t</mi><mi>ϵ</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><msub><mi>x</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">]</mo></mrow></mrow><mrow><msub><mi>𝔼</mi><mrow><msub><mi>x</mi><mi>t</mi></msub><mo>∼</mo><msub><mi>p</mi><mi>t</mi></msub></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mrow><msubsup><mi>k</mi><mi>t</mi><mi>ϵ</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><msub><mi>x</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">]</mo></mrow></mrow></mfrac></mstyle><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">]</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\frac{1}{1-t}[d-\frac{2t^{2}}{2(1-t)^{2}+\epsilon}(\frac{\mathbb{E}_{x_{t}\sim p_{t}}[\|x_{t}\|^{2}k^{\epsilon}_{t}(x,x_{t})]}{\mathbb{E}_{x_{t}\sim p_{t}}[k^{\epsilon}_{t}(x,x_{t})]}-\|\frac{\mathbb{E}_{x_{t}\sim p_{t}}[x_{t}k^{\epsilon}_{t}(x,x_{t})]}{\mathbb{E}_{x_{t}\sim p_{t}}[k^{\epsilon}_{t}(x,x_{t})]}\|^{2})]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A1.SS4.SSS0.Px1.p2.4" class="ltx_p"><span id="A1.SS4.SSS0.Px1.p2.4.1" class="ltx_text">∎</span></p>
</div>
</div>
</section>
</section>
<section id="A1.SS5" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">A.5 </span>Proof of <a href="#S5.Thmtheorem2" title="Theorem 5.2 (Feature-Data Space Optimal Velocity Relation). ‣ 5 Open Problems in Feature-Space Optimization ‣ A Long-Short Flow-Map Perspective for Drifting Models" class="ltx_ref ltx_refmacro_autoref"><span class="ltx_text ltx_ref_tag">Theorem 5.2</span></a></h3>

<section id="A1.SS5.SSS0.Px1" class="ltx_paragraph">
<h5 class="ltx_title ltx_title_paragraph"><a href="#S5.Thmtheorem2" title="Theorem 5.2 (Feature-Data Space Optimal Velocity Relation). ‣ 5 Open Problems in Feature-Space Optimization ‣ A Long-Short Flow-Map Perspective for Drifting Models" class="ltx_ref ltx_refmacro_autoref"><span class="ltx_text ltx_ref_tag">Theorem 5.2</span></a>Feature-Data Space Optimal Velocity Relation</h5>

<div id="A1.SS5.SSS0.Px1.p1" class="ltx_para ltx_noindent">
<p id="A1.SS5.SSS0.Px1.p1.1" class="ltx_p">Let <math id="A1.SS5.SSS0.Px1.p1.m1" class="ltx_Math" alttext="X_{1}\sim p_{1}" display="inline" intent=":literal"><semantics><mrow><msub><mi>X</mi><mn>1</mn></msub><mo>∼</mo><msub><mi>p</mi><mn>1</mn></msub></mrow><annotation encoding="application/x-tex">X_{1}\sim p_{1}</annotation></semantics></math> and define <math id="A1.SS5.SSS0.Px1.p1.m2" class="ltx_Math" alttext="Z_{1}=\phi_{j}(X_{1})" display="inline" intent=":literal"><semantics><mrow><msub><mi>Z</mi><mn>1</mn></msub><mo>=</mo><mrow><msub><mi>ϕ</mi><mi>j</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>X</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">Z_{1}=\phi_{j}(X_{1})</annotation></semantics></math>. Denote by <math id="A1.SS5.SSS0.Px1.p1.m3" class="ltx_Math" alttext="u_{t}^{x,*}(x)" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>u</mi><mi>t</mi><mrow><mi>x</mi><mo rspace="0em">,</mo><mo lspace="0em">∗</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">u_{t}^{x,*}(x)</annotation></semantics></math> the optimal Flow Matching velocity in data space associated with the conditional path <math id="A1.SS5.SSS0.Px1.p1.m4" class="ltx_Math" alttext="X_{t}=tX_{1}+(1-t)X_{0}" display="inline" intent=":literal"><semantics><mrow><msub><mi>X</mi><mi>t</mi></msub><mo>=</mo><mrow><mrow><mi>t</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>X</mi><mn>1</mn></msub></mrow><mo>+</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>t</mi></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>X</mi><mn>0</mn></msub></mrow></mrow></mrow><annotation encoding="application/x-tex">X_{t}=tX_{1}+(1-t)X_{0}</annotation></semantics></math>, and by <math id="A1.SS5.SSS0.Px1.p1.m5" class="ltx_Math" alttext="u_{t}^{z,*}(z)" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>u</mi><mi>t</mi><mrow><mi>z</mi><mo rspace="0em">,</mo><mo lspace="0em">∗</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>z</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">u_{t}^{z,*}(z)</annotation></semantics></math> the optimal velocity in feature space associated with <math id="A1.SS5.SSS0.Px1.p1.m6" class="ltx_Math" alttext="Z_{t}=tZ_{1}+(1-t)Z_{0}" display="inline" intent=":literal"><semantics><mrow><msub><mi>Z</mi><mi>t</mi></msub><mo>=</mo><mrow><mrow><mi>t</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>Z</mi><mn>1</mn></msub></mrow><mo>+</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>t</mi></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>Z</mi><mn>0</mn></msub></mrow></mrow></mrow><annotation encoding="application/x-tex">Z_{t}=tZ_{1}+(1-t)Z_{0}</annotation></semantics></math>, where <math id="A1.SS5.SSS0.Px1.p1.m7" class="ltx_Math" alttext="X_{0}" display="inline" intent=":literal"><semantics><msub><mi>X</mi><mn>0</mn></msub><annotation encoding="application/x-tex">X_{0}</annotation></semantics></math> and <math id="A1.SS5.SSS0.Px1.p1.m8" class="ltx_Math" alttext="Z_{0}" display="inline" intent=":literal"><semantics><msub><mi>Z</mi><mn>0</mn></msub><annotation encoding="application/x-tex">Z_{0}</annotation></semantics></math> are Gaussian reference variables on <math id="A1.SS5.SSS0.Px1.p1.m9" class="ltx_Math" alttext="\mathcal{X}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">𝒳</mi><annotation encoding="application/x-tex">\mathcal{X}</annotation></semantics></math> and <math id="A1.SS5.SSS0.Px1.p1.m10" class="ltx_Math" alttext="\mathcal{Z}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">𝒵</mi><annotation encoding="application/x-tex">\mathcal{Z}</annotation></semantics></math>, respectively. We define <math id="A1.SS5.SSS0.Px1.p1.m11" class="ltx_Math" alttext="p_{x|z}(x|z)" display="inline" intent=":literal"><semantics><mrow><msub><mi>p</mi><mrow><mi>x</mi><mo fence="false">|</mo><mi>z</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo lspace="0em" rspace="0em">|</mo><mi>z</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">p_{x|z}(x|z)</annotation></semantics></math> as the conditional distribution induced by the inverse of the deterministic map <math id="A1.SS5.SSS0.Px1.p1.m12" class="ltx_Math" alttext="z=\phi_{j}(x)" display="inline" intent=":literal"><semantics><mrow><mi>z</mi><mo>=</mo><mrow><msub><mi>ϕ</mi><mi>j</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">z=\phi_{j}(x)</annotation></semantics></math>. Then, for <math id="A1.SS5.SSS0.Px1.p1.m13" class="ltx_Math" alttext="z=\phi_{j}(x)" display="inline" intent=":literal"><semantics><mrow><mi>z</mi><mo>=</mo><mrow><msub><mi>ϕ</mi><mi>j</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">z=\phi_{j}(x)</annotation></semantics></math>, the two velocities satisfy the following approximate relations:</p>
<table id="A1.E55" class="ltx_equationgroup ltx_eqn_table">
<tbody>
<tr id="A1.E55X" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A1.E55X.m2" class="ltx_Math" alttext="\displaystyle u_{t}^{z,*}(z)" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>u</mi><mi>t</mi><mrow><mi>z</mi><mo rspace="0em">,</mo><mo lspace="0em">∗</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>z</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle u_{t}^{z,*}(z)</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.E55X.m3" class="ltx_Math" alttext="\displaystyle\approx J_{\phi_{j}}(x)\frac{\mathbb{E}[X_{1}|Z_{t}=\phi_{j}(x)]-x}{1-t}," display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>≈</mo><mrow><msub><mi>J</mi><msub><mi>ϕ</mi><mi>j</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><mrow><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><msub><mi>X</mi><mn>1</mn></msub><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mrow><msub><mi>Z</mi><mi>t</mi></msub><mo>=</mo><mrow><msub><mi>ϕ</mi><mi>j</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo stretchy="false">]</mo></mrow></mrow><mo>−</mo><mi>x</mi></mrow><mrow><mn>1</mn><mo>−</mo><mi>t</mi></mrow></mfrac></mstyle></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\approx J_{\phi_{j}}(x)\frac{\mathbb{E}[X_{1}|Z_{t}=\phi_{j}(x)]-x}{1-t},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="2" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equationgroup ltx_align_right">(55)</span></td></tr>
<tr id="A1.E55Xa" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A1.E55Xa.m2" class="ltx_Math" alttext="\displaystyle u_{1^{-}}^{z,*}(z)" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>u</mi><msup><mn>1</mn><mo>−</mo></msup><mrow><mi>z</mi><mo rspace="0em">,</mo><mo lspace="0em">∗</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>z</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle u_{1^{-}}^{z,*}(z)</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.E55Xa.m3" class="ltx_Math" alttext="\displaystyle\approx J_{\phi_{j}}(x)\frac{x-\mathbb{E}[X^{\prime}_{t}|Z_{1}=\phi_{j}(x)]}{1-t}," display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>≈</mo><mrow><msub><mi>J</mi><msub><mi>ϕ</mi><mi>j</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><mrow><mi>x</mi><mo>−</mo><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><msubsup><mi>X</mi><mi>t</mi><mo>′</mo></msubsup><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mrow><msub><mi>Z</mi><mn>1</mn></msub><mo>=</mo><mrow><msub><mi>ϕ</mi><mi>j</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo stretchy="false">]</mo></mrow></mrow></mrow><mrow><mn>1</mn><mo>−</mo><mi>t</mi></mrow></mfrac></mstyle></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\approx J_{\phi_{j}}(x)\frac{x-\mathbb{E}[X^{\prime}_{t}|Z_{1}=\phi_{j}(x)]}{1-t},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A1.SS5.SSS0.Px1.p1.2" class="ltx_p">where <math id="A1.SS5.SSS0.Px1.p1.m14" class="ltx_Math" alttext="J_{\phi_{j}}(x)=\frac{\partial\phi_{j}(x)}{\partial x}" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>J</mi><msub><mi>ϕ</mi><mi>j</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mfrac><mrow><mo>∂</mo><mrow><msub><mi>ϕ</mi><mi>j</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mrow><mo>∂</mo><mi>x</mi></mrow></mfrac></mrow><annotation encoding="application/x-tex">J_{\phi_{j}}(x)=\frac{\partial\phi_{j}(x)}{\partial x}</annotation></semantics></math> is the Jacobian of <math id="A1.SS5.SSS0.Px1.p1.m15" class="ltx_Math" alttext="\phi_{j}" display="inline" intent=":literal"><semantics><msub><mi>ϕ</mi><mi>j</mi></msub><annotation encoding="application/x-tex">\phi_{j}</annotation></semantics></math>, and <math id="A1.SS5.SSS0.Px1.p1.m16" class="ltx_Math" alttext="X^{\prime}_{t}" display="inline" intent=":literal"><semantics><msubsup><mi>X</mi><mi>t</mi><mo>′</mo></msubsup><annotation encoding="application/x-tex">X^{\prime}_{t}</annotation></semantics></math> is an auxiliary <math id="A1.SS5.SSS0.Px1.p1.m17" class="ltx_Math" alttext="\mathcal{X}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">𝒳</mi><annotation encoding="application/x-tex">\mathcal{X}</annotation></semantics></math>-valued random variable satisfying <math id="A1.SS5.SSS0.Px1.p1.m18" class="ltx_Math" alttext="\phi_{j}(X^{\prime}_{t})=Z_{t}" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>ϕ</mi><mi>j</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>X</mi><mi>t</mi><mo>′</mo></msubsup><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><msub><mi>Z</mi><mi>t</mi></msub></mrow><annotation encoding="application/x-tex">\phi_{j}(X^{\prime}_{t})=Z_{t}</annotation></semantics></math> almost surely. The approximation <math id="A1.SS5.SSS0.Px1.p1.m19" class="ltx_Math" alttext="\approx" display="inline" intent=":literal"><semantics><mo>≈</mo><annotation encoding="application/x-tex">\approx</annotation></semantics></math> above follows from the first-order Taylor expansion
<math id="A1.SS5.SSS0.Px1.p1.m20" class="ltx_Math" alttext="\phi_{j}(y)-\phi_{j}(x)=J_{\phi_{j}}(x)(y-x)+O(\|y-x\|^{2})" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><msub><mi>ϕ</mi><mi>j</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>y</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msub><mi>ϕ</mi><mi>j</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>=</mo><mrow><mrow><msub><mi>J</mi><msub><mi>ϕ</mi><mi>j</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>y</mi><mo>−</mo><mi>x</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mrow><mi>O</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mrow><mo stretchy="false">‖</mo><mrow><mi>y</mi><mo>−</mo><mi>x</mi></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\phi_{j}(y)-\phi_{j}(x)=J_{\phi_{j}}(x)(y-x)+O(\|y-x\|^{2})</annotation></semantics></math>. Only in the special case where <math id="A1.SS5.SSS0.Px1.p1.m21" class="ltx_Math" alttext="\phi_{j}(X_{t})=Z_{t}" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>ϕ</mi><mi>j</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>X</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><msub><mi>Z</mi><mi>t</mi></msub></mrow><annotation encoding="application/x-tex">\phi_{j}(X_{t})=Z_{t}</annotation></semantics></math> holds (for instance, when <math id="A1.SS5.SSS0.Px1.p1.m22" class="ltx_Math" alttext="\phi_{j}" display="inline" intent=":literal"><semantics><msub><mi>ϕ</mi><mi>j</mi></msub><annotation encoding="application/x-tex">\phi_{j}</annotation></semantics></math> is linear and the feature-space path <math id="A1.SS5.SSS0.Px1.p1.m23" class="ltx_Math" alttext="Z_{t}" display="inline" intent=":literal"><semantics><msub><mi>Z</mi><mi>t</mi></msub><annotation encoding="application/x-tex">Z_{t}</annotation></semantics></math> is induced by pushing forward the data-space path <math id="A1.SS5.SSS0.Px1.p1.m24" class="ltx_Math" alttext="X_{t}" display="inline" intent=":literal"><semantics><msub><mi>X</mi><mi>t</mi></msub><annotation encoding="application/x-tex">X_{t}</annotation></semantics></math>), the optimal feature-space velocity can be written as</p>
<table id="A1.E56" class="ltx_equationgroup ltx_eqn_table">
<tbody>
<tr id="A1.E56X" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A1.E56X.m2" class="ltx_Math" alttext="\displaystyle u_{t}^{z,*}(z)" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>u</mi><mi>t</mi><mrow><mi>z</mi><mo rspace="0em">,</mo><mo lspace="0em">∗</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>z</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle u_{t}^{z,*}(z)</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.E56X.m3" class="ltx_Math" alttext="\displaystyle\approx\mathbb{E}_{x\sim p_{x|z}}[J_{\phi_{j}}(x)u_{t}^{x,*}(x)]" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≈</mo><mrow><msub><mi>𝔼</mi><mrow><mi>x</mi><mo>∼</mo><msub><mi>p</mi><mrow><mi>x</mi><mo fence="false">|</mo><mi>z</mi></mrow></msub></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mrow><msub><mi>J</mi><msub><mi>ϕ</mi><mi>j</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>u</mi><mi>t</mi><mrow><mi>x</mi><mo rspace="0em">,</mo><mo lspace="0em">∗</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">]</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\approx\mathbb{E}_{x\sim p_{x|z}}[J_{\phi_{j}}(x)u_{t}^{x,*}(x)]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="2" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equationgroup ltx_align_right">(56)</span></td></tr>
<tr id="A1.E56Xa" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A1.E56Xa.m2" class="ltx_Math" alttext="\displaystyle u_{1^{-}}^{z,*}(z)" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>u</mi><msup><mn>1</mn><mo>−</mo></msup><mrow><mi>z</mi><mo rspace="0em">,</mo><mo lspace="0em">∗</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>z</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle u_{1^{-}}^{z,*}(z)</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.E56Xa.m3" class="ltx_Math" alttext="\displaystyle\approx\mathbb{E}_{x\sim p_{x|z}}[J_{\phi_{j}}(x)u_{1^{-}}^{x,*}(x)]" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≈</mo><mrow><msub><mi>𝔼</mi><mrow><mi>x</mi><mo>∼</mo><msub><mi>p</mi><mrow><mi>x</mi><mo fence="false">|</mo><mi>z</mi></mrow></msub></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mrow><msub><mi>J</mi><msub><mi>ϕ</mi><mi>j</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>u</mi><msup><mn>1</mn><mo>−</mo></msup><mrow><mi>x</mi><mo rspace="0em">,</mo><mo lspace="0em">∗</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">]</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\approx\mathbb{E}_{x\sim p_{x|z}}[J_{\phi_{j}}(x)u_{1^{-}}^{x,*}(x)]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="A1.SS5.SSS0.Px1.1" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="A1.SS5.SSS0.Px1.p2" class="ltx_para ltx_noindent">
<p id="A1.SS5.SSS0.Px1.p2.1" class="ltx_p"><span id="A1.SS5.SSS0.Px1.p2.1.1" class="ltx_text">Let <math id="A1.SS5.SSS0.Px1.p2.m1" class="ltx_Math" alttext="z=\phi_{j}(x)" display="inline" intent=":literal"><semantics><mrow><mi>z</mi><mo>=</mo><mrow><msub><mi>ϕ</mi><mi>j</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">z=\phi_{j}(x)</annotation></semantics></math>. The optimal velocity <math id="A1.SS5.SSS0.Px1.p2.m2" class="ltx_Math" alttext="u_{t}^{z,*}(z)" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>u</mi><mi>t</mi><mrow><mi>z</mi><mo rspace="0em">,</mo><mo lspace="0em">∗</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>z</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">u_{t}^{z,*}(z)</annotation></semantics></math> can be computed with first-order approximation:</span></p>
<table id="A1.E57" class="ltx_equationgroup ltx_eqn_table">
<tbody>
<tr id="A1.E57X" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A1.E57X.m2" class="ltx_Math" alttext="\displaystyle u_{t}^{z,*}(z)" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>u</mi><mi>t</mi><mrow><mi>z</mi><mo rspace="0em">,</mo><mo lspace="0em">∗</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>z</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle u_{t}^{z,*}(z)</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.E57X.m3" class="ltx_Math" alttext="\displaystyle=\frac{\mathbb{E}[Z_{1}-z|Z_{t}=z]}{1-t}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mstyle displaystyle="true"><mfrac><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><mrow><msub><mi>Z</mi><mn>1</mn></msub><mo>−</mo><mi>z</mi></mrow><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mrow><msub><mi>Z</mi><mi>t</mi></msub><mo>=</mo><mi>z</mi></mrow></mrow><mo stretchy="false">]</mo></mrow></mrow><mrow><mn>1</mn><mo>−</mo><mi>t</mi></mrow></mfrac></mstyle></mrow><annotation encoding="application/x-tex">\displaystyle=\frac{\mathbb{E}[Z_{1}-z|Z_{t}=z]}{1-t}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="4" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equationgroup ltx_align_right">(57)</span></td></tr>
<tr id="A1.E57Xa" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.E57Xa.m2" class="ltx_Math" alttext="\displaystyle\overset{\textcircled{1}}{=}\frac{\mathbb{E}[\phi_{j}(X_{1})-\phi_{j}(x)|Z_{t}=z]}{1-t}" display="inline" intent=":literal"><semantics><mrow><mover accent="true"><mo>=</mo><mo mathsize="0.700em">①</mo></mover><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><mrow><mrow><msub><mi>ϕ</mi><mi>j</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>X</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msub><mi>ϕ</mi><mi>j</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mrow><msub><mi>Z</mi><mi>t</mi></msub><mo>=</mo><mi>z</mi></mrow></mrow><mo stretchy="false">]</mo></mrow></mrow><mrow><mn>1</mn><mo>−</mo><mi>t</mi></mrow></mfrac></mstyle></mrow><annotation encoding="application/x-tex">\displaystyle\overset{\textcircled{1}}{=}\frac{\mathbb{E}[\phi_{j}(X_{1})-\phi_{j}(x)|Z_{t}=z]}{1-t}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr>
<tr id="A1.E57Xb" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.E57Xb.m2" class="ltx_Math" alttext="\displaystyle\approx\frac{\mathbb{E}[J_{\phi_{j}}(x)(X_{1}-x)|Z_{t}=z]}{1-t}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≈</mo><mstyle displaystyle="true"><mfrac><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><mrow><msub><mi>J</mi><msub><mi>ϕ</mi><mi>j</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>X</mi><mn>1</mn></msub><mo>−</mo><mi>x</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mrow><msub><mi>Z</mi><mi>t</mi></msub><mo>=</mo><mi>z</mi></mrow></mrow><mo stretchy="false">]</mo></mrow></mrow><mrow><mn>1</mn><mo>−</mo><mi>t</mi></mrow></mfrac></mstyle></mrow><annotation encoding="application/x-tex">\displaystyle\approx\frac{\mathbb{E}[J_{\phi_{j}}(x)(X_{1}-x)|Z_{t}=z]}{1-t}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr>
<tr id="A1.E57Xc" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.E57Xc.m2" class="ltx_Math" alttext="\displaystyle=\frac{J_{\phi_{j}}(x)(\mathbb{E}[X_{1}|Z_{t}=z]-x)}{1-t}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mstyle displaystyle="true"><mfrac><mrow><msub><mi>J</mi><msub><mi>ϕ</mi><mi>j</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><msub><mi>X</mi><mn>1</mn></msub><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mrow><msub><mi>Z</mi><mi>t</mi></msub><mo>=</mo><mi>z</mi></mrow></mrow><mo stretchy="false">]</mo></mrow></mrow><mo>−</mo><mi>x</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mrow><mn>1</mn><mo>−</mo><mi>t</mi></mrow></mfrac></mstyle></mrow><annotation encoding="application/x-tex">\displaystyle=\frac{J_{\phi_{j}}(x)(\mathbb{E}[X_{1}|Z_{t}=z]-x)}{1-t}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A1.SS5.SSS0.Px1.p2.2" class="ltx_p"><span id="A1.SS5.SSS0.Px1.p2.2.1" class="ltx_text">where <math id="A1.SS5.SSS0.Px1.p2.m3" class="ltx_Math" alttext="\textcircled{1}" display="inline" intent=":literal"><semantics><mn>①</mn><annotation encoding="application/x-tex">\textcircled{1}</annotation></semantics></math> holds because</span></p>
<table id="A1.E58" class="ltx_equationgroup ltx_eqn_table">
<tbody>
<tr id="A1.E58X" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A1.E58X.m2" class="ltx_Math" alttext="\displaystyle\mathbb{E}[Z_{1}|Z_{t}=z]" display="inline" intent=":literal"><semantics><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><msub><mi>Z</mi><mn>1</mn></msub><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mrow><msub><mi>Z</mi><mi>t</mi></msub><mo>=</mo><mi>z</mi></mrow></mrow><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\mathbb{E}[Z_{1}|Z_{t}=z]</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.E58X.m3" class="ltx_Math" alttext="\displaystyle=\int z_{1}p_{Z_{1}|Z_{t}}(z_{1}|z)dz_{1}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mstyle displaystyle="true"><mrow><mo>∫</mo><mrow><msub><mi>z</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>p</mi><mrow><msub><mi>Z</mi><mn>1</mn></msub><mo fence="false">|</mo><msub><mi>Z</mi><mi>t</mi></msub></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>z</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">|</mo><mi>z</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>z</mi><mn>1</mn></msub></mrow></mrow></mstyle></mrow><annotation encoding="application/x-tex">\displaystyle=\int z_{1}p_{Z_{1}|Z_{t}}(z_{1}|z)dz_{1}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="6" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equationgroup ltx_align_right">(58)</span></td></tr>
<tr id="A1.E58Xa" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.E58Xa.m2" class="ltx_Math" alttext="\displaystyle=\int\int\phi(x_{1})p_{x|z}(x_{1}|z_{1})dx_{1}p_{Z_{1}|Z_{t}}(z_{1}|z)dz_{1}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mstyle displaystyle="true"><mrow><mo rspace="0em">∫</mo><mo>∫</mo></mrow></mstyle><mo>⁡</mo><mrow><mrow><mi>ϕ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>p</mi><mrow><mi>x</mi><mo fence="false">|</mo><mi>z</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">|</mo><msub><mi>z</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>x</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>p</mi><mrow><msub><mi>Z</mi><mn>1</mn></msub><mo fence="false">|</mo><msub><mi>Z</mi><mi>t</mi></msub></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>z</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">|</mo><mi>z</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>z</mi><mn>1</mn></msub></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\int\int\phi(x_{1})p_{x|z}(x_{1}|z_{1})dx_{1}p_{Z_{1}|Z_{t}}(z_{1}|z)dz_{1}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr>
<tr id="A1.E58Xb" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
