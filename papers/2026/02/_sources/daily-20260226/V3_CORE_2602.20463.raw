<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A1.E41X.m2" class="ltx_Math" alttext="\displaystyle\int\frac{x_{1}-x}{1-t}p_{t|1}(x|x_{1})p_{1}(x_{1})dx" display="inline" intent=":literal"><semantics><mstyle displaystyle="true"><mrow><mo>∫</mo><mrow><mfrac><mrow><msub><mi>x</mi><mn>1</mn></msub><mo>−</mo><mi>x</mi></mrow><mrow><mn>1</mn><mo>−</mo><mi>t</mi></mrow></mfrac><mo lspace="0em" rspace="0em">​</mo><msub><mi>p</mi><mrow><mi>t</mi><mo fence="false">|</mo><mn>1</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo lspace="0em" rspace="0em">|</mo><msub><mi>x</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>p</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo rspace="0em">𝑑</mo><mi>x</mi></mrow></mrow></mrow></mstyle><annotation encoding="application/x-tex">\displaystyle\int\frac{x_{1}-x}{1-t}p_{t|1}(x|x_{1})p_{1}(x_{1})dx</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.E41X.m3" class="ltx_Math" alttext="\displaystyle=\int\int\frac{x_{1}-x}{1-t}p_{t|1,0}(x|x_{1},x_{0})p_{0}(x_{0})dx_{0}p_{1}(x_{1})dx" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mstyle displaystyle="true"><mrow><mo rspace="0em">∫</mo><mo>∫</mo></mrow></mstyle><mo>⁡</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><msub><mi>x</mi><mn>1</mn></msub><mo>−</mo><mi>x</mi></mrow><mrow><mn>1</mn><mo>−</mo><mi>t</mi></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msub><mi>p</mi><mrow><mi>t</mi><mo fence="false">|</mo><mrow><mn>1</mn><mo>,</mo><mn>0</mn></mrow></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo lspace="0em" rspace="0em">|</mo><mrow><msub><mi>x</mi><mn>1</mn></msub><mo>,</mo><msub><mi>x</mi><mn>0</mn></msub></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>p</mi><mn>0</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mn>0</mn></msub><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>x</mi><mn>0</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>p</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo rspace="0em">𝑑</mo><mi>x</mi></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\int\int\frac{x_{1}-x}{1-t}p_{t|1,0}(x|x_{1},x_{0})p_{0}(x_{0})dx_{0}p_{1}(x_{1})dx</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="6" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equationgroup ltx_align_right">(41)</span></td></tr>
<tr id="A1.E41Xa" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.E41Xa.m2" class="ltx_Math" alttext="\displaystyle=\int\int\frac{x_{1}-x}{1-t}\delta_{x=tx_{1}+(1-t)x_{0}}p_{0}(x_{0})dx_{0}p_{1}(x_{1})dx" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mstyle displaystyle="true"><mrow><mo rspace="0em">∫</mo><mo>∫</mo></mrow></mstyle><mo>⁡</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><msub><mi>x</mi><mn>1</mn></msub><mo>−</mo><mi>x</mi></mrow><mrow><mn>1</mn><mo>−</mo><mi>t</mi></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msub><mi>δ</mi><mrow><mi>x</mi><mo>=</mo><mrow><mrow><mi>t</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>x</mi><mn>1</mn></msub></mrow><mo>+</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>t</mi></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>x</mi><mn>0</mn></msub></mrow></mrow></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>p</mi><mn>0</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mn>0</mn></msub><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>x</mi><mn>0</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>p</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo rspace="0em">𝑑</mo><mi>x</mi></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\int\int\frac{x_{1}-x}{1-t}\delta_{x=tx_{1}+(1-t)x_{0}}p_{0}(x_{0})dx_{0}p_{1}(x_{1})dx</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr>
<tr id="A1.E41Xb" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.E41Xb.m2" class="ltx_Math" alttext="\displaystyle=\int\int\frac{x_{1}-x}{1-t}\delta_{x=tx_{1}+(1-t)x_{0}}p_{0}(\frac{x-tx_{1}}{1-t})dx_{0}p_{1}(x_{1})dx" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mstyle displaystyle="true"><mrow><mo rspace="0em">∫</mo><mo>∫</mo></mrow></mstyle><mo>⁡</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><msub><mi>x</mi><mn>1</mn></msub><mo>−</mo><mi>x</mi></mrow><mrow><mn>1</mn><mo>−</mo><mi>t</mi></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msub><mi>δ</mi><mrow><mi>x</mi><mo>=</mo><mrow><mrow><mi>t</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>x</mi><mn>1</mn></msub></mrow><mo>+</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>t</mi></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>x</mi><mn>0</mn></msub></mrow></mrow></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>p</mi><mn>0</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mstyle displaystyle="true"><mfrac><mrow><mi>x</mi><mo>−</mo><mrow><mi>t</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>x</mi><mn>1</mn></msub></mrow></mrow><mrow><mn>1</mn><mo>−</mo><mi>t</mi></mrow></mfrac></mstyle><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>x</mi><mn>0</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>p</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo rspace="0em">𝑑</mo><mi>x</mi></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\int\int\frac{x_{1}-x}{1-t}\delta_{x=tx_{1}+(1-t)x_{0}}p_{0}(\frac{x-tx_{1}}{1-t})dx_{0}p_{1}(x_{1})dx</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr>
<tr id="A1.E41Xc" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.E41Xc.m2" class="ltx_Math" alttext="\displaystyle=\int\frac{x_{1}-x}{1-t}p_{0}(\frac{x-tx_{1}}{1-t})p_{1}(x_{1})dx" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mstyle displaystyle="true"><mrow><mo>∫</mo><mrow><mfrac><mrow><msub><mi>x</mi><mn>1</mn></msub><mo>−</mo><mi>x</mi></mrow><mrow><mn>1</mn><mo>−</mo><mi>t</mi></mrow></mfrac><mo lspace="0em" rspace="0em">​</mo><msub><mi>p</mi><mn>0</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mfrac><mrow><mi>x</mi><mo>−</mo><mrow><mi>t</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>x</mi><mn>1</mn></msub></mrow></mrow><mrow><mn>1</mn><mo>−</mo><mi>t</mi></mrow></mfrac><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>p</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo rspace="0em">𝑑</mo><mi>x</mi></mrow></mrow></mrow></mstyle></mrow><annotation encoding="application/x-tex">\displaystyle=\int\frac{x_{1}-x}{1-t}p_{0}(\frac{x-tx_{1}}{1-t})p_{1}(x_{1})dx</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr>
<tr id="A1.E41Xd" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.E41Xd.m2" class="ltx_Math" alttext="\displaystyle=\int\frac{x_{1}-x}{1-t}\frac{1}{(2\pi)^{\frac{d}{2}}}e^{-\|\frac{x-tx_{1}}{1-t}\|^{2}}p_{1}(x_{1})dx" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mstyle displaystyle="true"><mrow><mo>∫</mo><mrow><mfrac><mrow><msub><mi>x</mi><mn>1</mn></msub><mo>−</mo><mi>x</mi></mrow><mrow><mn>1</mn><mo>−</mo><mi>t</mi></mrow></mfrac><mo lspace="0em" rspace="0em">​</mo><mfrac><mn>1</mn><msup><mrow><mo stretchy="false">(</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>π</mi></mrow><mo stretchy="false">)</mo></mrow><mfrac><mi>d</mi><mn>2</mn></mfrac></msup></mfrac><mo lspace="0em" rspace="0em">​</mo><msup><mi>e</mi><mrow><mo>−</mo><msup><mrow><mo stretchy="false">‖</mo><mfrac><mrow><mi>x</mi><mo>−</mo><mrow><mi>t</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>x</mi><mn>1</mn></msub></mrow></mrow><mrow><mn>1</mn><mo>−</mo><mi>t</mi></mrow></mfrac><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>p</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo rspace="0em">𝑑</mo><mi>x</mi></mrow></mrow></mrow></mstyle></mrow><annotation encoding="application/x-tex">\displaystyle=\int\frac{x_{1}-x}{1-t}\frac{1}{(2\pi)^{\frac{d}{2}}}e^{-\|\frac{x-tx_{1}}{1-t}\|^{2}}p_{1}(x_{1})dx</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr>
<tr id="A1.E41Xe" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.E41Xe.m2" class="ltx_Math" alttext="\displaystyle=\frac{1}{(2\pi)^{\frac{d}{2}}}\mathbb{E}_{x_{1}\sim p_{1}}[\frac{x_{1}-x}{1-t}k_{t}(x_{1},x)]" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><msup><mrow><mo stretchy="false">(</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>π</mi></mrow><mo stretchy="false">)</mo></mrow><mfrac><mi>d</mi><mn>2</mn></mfrac></msup></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝔼</mi><mrow><msub><mi>x</mi><mn>1</mn></msub><mo>∼</mo><msub><mi>p</mi><mn>1</mn></msub></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><msub><mi>x</mi><mn>1</mn></msub><mo>−</mo><mi>x</mi></mrow><mrow><mn>1</mn><mo>−</mo><mi>t</mi></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msub><mi>k</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mn>1</mn></msub><mo>,</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">]</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\frac{1}{(2\pi)^{\frac{d}{2}}}\mathbb{E}_{x_{1}\sim p_{1}}[\frac{x_{1}-x}{1-t}k_{t}(x_{1},x)]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A1.SS1.SSS0.Px1.p3.3" class="ltx_p"><span id="A1.SS1.SSS0.Px1.p3.3.1" class="ltx_text">Similarly, we have <math id="A1.SS1.SSS0.Px1.p3.m5" class="ltx_Math" alttext="\int p_{t|1}(x|x_{1})p_{1}(x_{1})dx=\frac{1}{(2\pi)^{\frac{d}{2}}}\mathbb{E}_{x_{1}\sim p_{1}}[k_{t}(x_{1},x)]" display="inline" intent=":literal"><semantics><mrow><mrow><mo>∫</mo><mrow><msub><mi>p</mi><mrow><mi>t</mi><mo fence="false">|</mo><mn>1</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo lspace="0em" rspace="0em">|</mo><msub><mi>x</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>p</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo rspace="0em">𝑑</mo><mi>x</mi></mrow></mrow></mrow><mo>=</mo><mrow><mfrac><mn>1</mn><msup><mrow><mo stretchy="false">(</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>π</mi></mrow><mo stretchy="false">)</mo></mrow><mfrac><mi>d</mi><mn>2</mn></mfrac></msup></mfrac><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝔼</mi><mrow><msub><mi>x</mi><mn>1</mn></msub><mo>∼</mo><msub><mi>p</mi><mn>1</mn></msub></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mrow><msub><mi>k</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mn>1</mn></msub><mo>,</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">]</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\int p_{t|1}(x|x_{1})p_{1}(x_{1})dx=\frac{1}{(2\pi)^{\frac{d}{2}}}\mathbb{E}_{x_{1}\sim p_{1}}[k_{t}(x_{1},x)]</annotation></semantics></math>. Therefore, we obtain:</span></p>
<table id="A1.E42" class="ltx_equationgroup ltx_eqn_table">
<tbody>
<tr id="A1.E42X" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A1.E42X.m2" class="ltx_Math" alttext="\displaystyle u_{t}^{*}(x)" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>u</mi><mi>t</mi><mo>∗</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle u_{t}^{*}(x)</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.E42X.m3" class="ltx_Math" alttext="\displaystyle=\frac{\mathbb{E}_{x_{1}\sim p_{1}}[\frac{x_{1}-x}{1-t}k_{t}(x_{1},x)]}{\mathbb{E}_{x_{1}\sim p_{1}}[k_{t}(x_{1},x)]}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mstyle displaystyle="true"><mfrac><mrow><msub><mi>𝔼</mi><mrow><msub><mi>x</mi><mn>1</mn></msub><mo>∼</mo><msub><mi>p</mi><mn>1</mn></msub></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mrow><mfrac><mrow><msub><mi>x</mi><mn>1</mn></msub><mo>−</mo><mi>x</mi></mrow><mrow><mn>1</mn><mo>−</mo><mi>t</mi></mrow></mfrac><mo lspace="0em" rspace="0em">​</mo><msub><mi>k</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mn>1</mn></msub><mo>,</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">]</mo></mrow></mrow><mrow><msub><mi>𝔼</mi><mrow><msub><mi>x</mi><mn>1</mn></msub><mo>∼</mo><msub><mi>p</mi><mn>1</mn></msub></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mrow><msub><mi>k</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mn>1</mn></msub><mo>,</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">]</mo></mrow></mrow></mfrac></mstyle></mrow><annotation encoding="application/x-tex">\displaystyle=\frac{\mathbb{E}_{x_{1}\sim p_{1}}[\frac{x_{1}-x}{1-t}k_{t}(x_{1},x)]}{\mathbb{E}_{x_{1}\sim p_{1}}[k_{t}(x_{1},x)]}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equationgroup ltx_align_right">(42)</span></td></tr></tbody>
</table>
<p id="A1.SS1.SSS0.Px1.p3.4" class="ltx_p"><span id="A1.SS1.SSS0.Px1.p3.4.1" class="ltx_text">∎</span></p>
</div>
</div>
</section>
</section>
<section id="A1.SS2" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">A.2 </span>Non-Existence of Conditional Flow Maps</h3>

<div id="A1.Thmtheorem1" class="ltx_theorem ltx_theorem_theorem">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="A1.Thmtheorem1.2" class="ltx_text ltx_font_bold">Theorem A.1</span></span><span id="A1.Thmtheorem1.3" class="ltx_text ltx_font_bold"> </span>(Non-Existence of Conditional Flow Maps <cite class="ltx_cite ltx_citemacro_cite"><a href="#bib.bib25" title="" class="ltx_ref">Li et al. [2026a]</a></cite>)<span id="A1.Thmtheorem1.4" class="ltx_text ltx_font_bold">.</span></h6>
<div id="A1.Thmtheorem1.p1" class="ltx_para">
<p id="A1.Thmtheorem1.p1.1" class="ltx_p"><span id="A1.Thmtheorem1.p1.1.1" class="ltx_text ltx_font_italic">There exists no conditional flow maps <math id="A1.Thmtheorem1.p1.m1" class="ltx_Math" alttext="\psi_{t\to r}(x|x_{1})" display="inline" intent=":literal"><semantics><mrow><msub><mi>ψ</mi><mrow><mi>t</mi><mo stretchy="false">→</mo><mi>r</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo lspace="0em" rspace="0em">|</mo><msub><mi>x</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\psi_{t\to r}(x|x_{1})</annotation></semantics></math> that simultaneously (1) is consistent with the conditional velocity <math id="A1.Thmtheorem1.p1.m2" class="ltx_Math" alttext="u(x|x_{1})" display="inline" intent=":literal"><semantics><mrow><mi>u</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo lspace="0em" rspace="0em">|</mo><msub><mi>x</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">u(x|x_{1})</annotation></semantics></math> under <a href="#S2.E6" title="Equation 6 ‣ 2.2 One-Step Flow Map ‣ 2 Background ‣ A Long-Short Flow-Map Perspective for Drifting Models" class="ltx_ref ltx_refmacro_autoref"><span class="ltx_text ltx_ref_tag">Equation 6</span></a>, and (2) satisfies the consistency relation <math id="A1.Thmtheorem1.p1.m3" class="ltx_Math" alttext="\psi_{t\to r}(x)=\mathbb{E}_{x_{1}\sim p_{1|t}(x_{1}|x)}[\psi_{t\to r}(x|x_{1})]" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>ψ</mi><mrow><mi>t</mi><mo stretchy="false">→</mo><mi>r</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><msub><mi>𝔼</mi><mrow><msub><mi>x</mi><mn>1</mn></msub><mo>∼</mo><mrow><msub><mi>p</mi><mrow><mn>1</mn><mo fence="false">|</mo><mi>t</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">|</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mrow><msub><mi>ψ</mi><mrow><mi>t</mi><mo stretchy="false">→</mo><mi>r</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo lspace="0em" rspace="0em">|</mo><msub><mi>x</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">]</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\psi_{t\to r}(x)=\mathbb{E}_{x_{1}\sim p_{1|t}(x_{1}|x)}[\psi_{t\to r}(x|x_{1})]</annotation></semantics></math> with marginal flow maps. As a result, a self-consistent conditional flow map does not exist.</span></p>
</div>
</div>
<div id="A1.SS2.2" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="A1.SS2.p1" class="ltx_para ltx_noindent">
<p id="A1.SS2.p1.1" class="ltx_p"><span id="A1.SS2.p1.1.1" class="ltx_text">First, we denote the mappings <math id="A1.SS2.p1.m1" class="ltx_Math" alttext="\psi_{t\to r}(x)" display="inline" intent=":literal"><semantics><mrow><msub><mi>ψ</mi><mrow><mi>t</mi><mo stretchy="false">→</mo><mi>r</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\psi_{t\to r}(x)</annotation></semantics></math> obtained from (1) and (2) as <math id="A1.SS2.p1.m2" class="ltx_Math" alttext="\psi^{(1)}_{t\to r}(x)" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>ψ</mi><mrow><mi>t</mi><mo stretchy="false">→</mo><mi>r</mi></mrow><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\psi^{(1)}_{t\to r}(x)</annotation></semantics></math> and <math id="A1.SS2.p1.m3" class="ltx_Math" alttext="\psi^{(2)}_{t\to r}(x)" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>ψ</mi><mrow><mi>t</mi><mo stretchy="false">→</mo><mi>r</mi></mrow><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\psi^{(2)}_{t\to r}(x)</annotation></semantics></math>, respectively. Specifically, <math id="A1.SS2.p1.m4" class="ltx_Math" alttext="\psi^{(1)}_{t\to r}(x)=\psi_{0\to r}(\psi_{0\to t}^{-1}(x))" display="inline" intent=":literal"><semantics><mrow><mrow><msubsup><mi>ψ</mi><mrow><mi>t</mi><mo stretchy="false">→</mo><mi>r</mi></mrow><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><msub><mi>ψ</mi><mrow><mn>0</mn><mo stretchy="false">→</mo><mi>r</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msubsup><mi>ψ</mi><mrow><mn>0</mn><mo stretchy="false">→</mo><mi>t</mi></mrow><mrow><mo>−</mo><mn>1</mn></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\psi^{(1)}_{t\to r}(x)=\psi_{0\to r}(\psi_{0\to t}^{-1}(x))</annotation></semantics></math>, and <math id="A1.SS2.p1.m5" class="ltx_Math" alttext="\psi^{(2)}_{t\to r}(x)=\mathbb{E}_{x_{1}\sim p_{t}(x_{1}|x)}[\psi_{t\to r}(x|x_{1})]" display="inline" intent=":literal"><semantics><mrow><mrow><msubsup><mi>ψ</mi><mrow><mi>t</mi><mo stretchy="false">→</mo><mi>r</mi></mrow><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><msub><mi>𝔼</mi><mrow><msub><mi>x</mi><mn>1</mn></msub><mo>∼</mo><mrow><msub><mi>p</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">|</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mrow><msub><mi>ψ</mi><mrow><mi>t</mi><mo stretchy="false">→</mo><mi>r</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo lspace="0em" rspace="0em">|</mo><msub><mi>x</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">]</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\psi^{(2)}_{t\to r}(x)=\mathbb{E}_{x_{1}\sim p_{t}(x_{1}|x)}[\psi_{t\to r}(x|x_{1})]</annotation></semantics></math>. It suffices to show that <math id="A1.SS2.p1.m6" class="ltx_Math" alttext="\psi^{(1)}_{t\to r}(x)\neq\psi^{(2)}_{t\to r}(x)" display="inline" intent=":literal"><semantics><mrow><mrow><msubsup><mi>ψ</mi><mrow><mi>t</mi><mo stretchy="false">→</mo><mi>r</mi></mrow><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo>≠</mo><mrow><msubsup><mi>ψ</mi><mrow><mi>t</mi><mo stretchy="false">→</mo><mi>r</mi></mrow><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\psi^{(1)}_{t\to r}(x)\neq\psi^{(2)}_{t\to r}(x)</annotation></semantics></math>. To this end, it is sufficient to prove that <math id="A1.SS2.p1.m7" class="ltx_Math" alttext="\frac{d}{dt}\psi^{(1)}_{t\to r}(x)\neq\frac{d}{dt}\psi^{(2)}_{t\to r}(x)" display="inline" intent=":literal"><semantics><mrow><mrow><mfrac><mi>d</mi><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></mfrac><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>ψ</mi><mrow><mi>t</mi><mo stretchy="false">→</mo><mi>r</mi></mrow><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo>≠</mo><mrow><mfrac><mi>d</mi><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></mfrac><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>ψ</mi><mrow><mi>t</mi><mo stretchy="false">→</mo><mi>r</mi></mrow><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\frac{d}{dt}\psi^{(1)}_{t\to r}(x)\neq\frac{d}{dt}\psi^{(2)}_{t\to r}(x)</annotation></semantics></math> at <math id="A1.SS2.p1.m8" class="ltx_Math" alttext="t=0" display="inline" intent=":literal"><semantics><mrow><mi>t</mi><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">t=0</annotation></semantics></math>.</span></p>
</div>
<div id="A1.SS2.p2" class="ltx_para">
<table id="A1.E43" class="ltx_equationgroup ltx_eqn_table">
<tbody>
<tr id="A1.E43X" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A1.E43X.m2" class="ltx_Math" alttext="\displaystyle\frac{d}{dr}\psi^{(2)}_{t\to r}(x)" display="inline" intent=":literal"><semantics><mrow><mstyle displaystyle="true"><mfrac><mi>d</mi><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>ψ</mi><mrow><mi>t</mi><mo stretchy="false">→</mo><mi>r</mi></mrow><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\frac{d}{dr}\psi^{(2)}_{t\to r}(x)</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.E43X.m3" class="ltx_Math" alttext="\displaystyle=\frac{d}{dr}\int_{x_{1}}\psi_{t\to r}(x|x_{1})p_{1|t}(x_{1}|x)dx_{1}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mstyle displaystyle="true"><mfrac><mi>d</mi><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><msub><mo>∫</mo><msub><mi>x</mi><mn>1</mn></msub></msub></mstyle><mrow><msub><mi>ψ</mi><mrow><mi>t</mi><mo stretchy="false">→</mo><mi>r</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo lspace="0em" rspace="0em">|</mo><msub><mi>x</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>p</mi><mrow><mn>1</mn><mo fence="false">|</mo><mi>t</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">|</mo><mi>x</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>x</mi><mn>1</mn></msub></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\frac{d}{dr}\int_{x_{1}}\psi_{t\to r}(x|x_{1})p_{1|t}(x_{1}|x)dx_{1}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="6" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equationgroup ltx_align_right">(43)</span></td></tr>
<tr id="A1.E43Xa" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.E43Xa.m2" class="ltx_Math" alttext="\displaystyle=\int_{x_{1}}\frac{d}{dr}\psi_{t\to r}(x|x_{1})p_{1|t}(x_{1}|x)dx_{1}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mstyle displaystyle="true"><msub><mo>∫</mo><msub><mi>x</mi><mn>1</mn></msub></msub></mstyle><mrow><mstyle displaystyle="true"><mfrac><mi>d</mi><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msub><mi>ψ</mi><mrow><mi>t</mi><mo stretchy="false">→</mo><mi>r</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo lspace="0em" rspace="0em">|</mo><msub><mi>x</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>p</mi><mrow><mn>1</mn><mo fence="false">|</mo><mi>t</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">|</mo><mi>x</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>x</mi><mn>1</mn></msub></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\int_{x_{1}}\frac{d}{dr}\psi_{t\to r}(x|x_{1})p_{1|t}(x_{1}|x)dx_{1}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr>
<tr id="A1.E43Xb" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.E43Xb.m2" class="ltx_Math" alttext="\displaystyle=\int_{x_{1}}u_{r}(\psi_{t\to r}(x|x_{1})|x_{1})\frac{p_{1}(x_{1})p_{t|1}(x|x_{1})}{p_{t}(x)}dx_{1}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mstyle displaystyle="true"><msub><mo>∫</mo><msub><mi>x</mi><mn>1</mn></msub></msub></mstyle><mrow><msub><mi>u</mi><mi>r</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>ψ</mi><mrow><mi>t</mi><mo stretchy="false">→</mo><mi>r</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo lspace="0em" rspace="0em">|</mo><msub><mi>x</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">|</mo><msub><mi>x</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><mrow><msub><mi>p</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>p</mi><mrow><mi>t</mi><mo fence="false">|</mo><mn>1</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo lspace="0em" rspace="0em">|</mo><msub><mi>x</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow></mrow><mrow><msub><mi>p</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>x</mi><mn>1</mn></msub></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\int_{x_{1}}u_{r}(\psi_{t\to r}(x|x_{1})|x_{1})\frac{p_{1}(x_{1})p_{t|1}(x|x_{1})}{p_{t}(x)}dx_{1}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr>
<tr id="A1.E43Xc" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.E43Xc.m2" class="ltx_Math" alttext="\displaystyle=\int_{x_{1}}u_{r}(\psi_{t\to r}(x|x_{1})|x_{1})p_{1}(x_{1})dx_{1}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mstyle displaystyle="true"><msub><mo>∫</mo><msub><mi>x</mi><mn>1</mn></msub></msub></mstyle><mrow><msub><mi>u</mi><mi>r</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>ψ</mi><mrow><mi>t</mi><mo stretchy="false">→</mo><mi>r</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo lspace="0em" rspace="0em">|</mo><msub><mi>x</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">|</mo><msub><mi>x</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>p</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>x</mi><mn>1</mn></msub></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\int_{x_{1}}u_{r}(\psi_{t\to r}(x|x_{1})|x_{1})p_{1}(x_{1})dx_{1}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr>
<tr id="A1.E43Xd" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.E43Xd.m2" class="ltx_Math" alttext="\displaystyle=\int_{x_{1}}(x_{1}-x)p_{1}(x_{1})dx_{1}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mstyle displaystyle="true"><msub><mo>∫</mo><msub><mi>x</mi><mn>1</mn></msub></msub></mstyle><mrow><mrow><mo stretchy="false">(</mo><mrow><msub><mi>x</mi><mn>1</mn></msub><mo>−</mo><mi>x</mi></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>p</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>x</mi><mn>1</mn></msub></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\int_{x_{1}}(x_{1}-x)p_{1}(x_{1})dx_{1}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr>
<tr id="A1.E43Xe" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.E43Xe.m2" class="ltx_Math" alttext="\displaystyle=\mathbb{E}_{x_{1}\sim p_{1}(x_{1})}[x_{1}]-x" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><msub><mi>𝔼</mi><mrow><msub><mi>x</mi><mn>1</mn></msub><mo>∼</mo><mrow><msub><mi>p</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow></mrow></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><msub><mi>x</mi><mn>1</mn></msub><mo stretchy="false">]</mo></mrow></mrow><mo>−</mo><mi>x</mi></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\mathbb{E}_{x_{1}\sim p_{1}(x_{1})}[x_{1}]-x</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A1.SS2.p2.1" class="ltx_p"><span id="A1.SS2.p2.1.1" class="ltx_text">Consequently, if <math id="A1.SS2.p2.m1" class="ltx_Math" alttext="\psi^{(1)}_{t\to r}(x)=\psi^{(2)}_{t\to r}(x)" display="inline" intent=":literal"><semantics><mrow><mrow><msubsup><mi>ψ</mi><mrow><mi>t</mi><mo stretchy="false">→</mo><mi>r</mi></mrow><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><msubsup><mi>ψ</mi><mrow><mi>t</mi><mo stretchy="false">→</mo><mi>r</mi></mrow><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\psi^{(1)}_{t\to r}(x)=\psi^{(2)}_{t\to r}(x)</annotation></semantics></math> we must have <math id="A1.SS2.p2.m2" class="ltx_Math" alttext="\frac{d}{dr}\psi_{0\to r}(x)=\mathbb{E}_{x_{1}\sim p_{1}(x_{1})}[x_{1}]-x" display="inline" intent=":literal"><semantics><mrow><mrow><mfrac><mi>d</mi><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi></mrow></mfrac><mo lspace="0em" rspace="0em">​</mo><msub><mi>ψ</mi><mrow><mn>0</mn><mo stretchy="false">→</mo><mi>r</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mrow><msub><mi>𝔼</mi><mrow><msub><mi>x</mi><mn>1</mn></msub><mo>∼</mo><mrow><msub><mi>p</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow></mrow></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><msub><mi>x</mi><mn>1</mn></msub><mo stretchy="false">]</mo></mrow></mrow><mo>−</mo><mi>x</mi></mrow></mrow><annotation encoding="application/x-tex">\frac{d}{dr}\psi_{0\to r}(x)=\mathbb{E}_{x_{1}\sim p_{1}(x_{1})}[x_{1}]-x</annotation></semantics></math>, <math id="A1.SS2.p2.m3" class="ltx_Math" alttext="\psi_{0\to r}(x)=(\mathbb{E}_{x_{1}\sim p_{1}(x_{1})}[x_{1}]-x)r+x" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>ψ</mi><mrow><mn>0</mn><mo stretchy="false">→</mo><mi>r</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mrow><mrow><mo stretchy="false">(</mo><mrow><mrow><msub><mi>𝔼</mi><mrow><msub><mi>x</mi><mn>1</mn></msub><mo>∼</mo><mrow><msub><mi>p</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow></mrow></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><msub><mi>x</mi><mn>1</mn></msub><mo stretchy="false">]</mo></mrow></mrow><mo>−</mo><mi>x</mi></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>r</mi></mrow><mo>+</mo><mi>x</mi></mrow></mrow><annotation encoding="application/x-tex">\psi_{0\to r}(x)=(\mathbb{E}_{x_{1}\sim p_{1}(x_{1})}[x_{1}]-x)r+x</annotation></semantics></math>, which implies <math id="A1.SS2.p2.m4" class="ltx_Math" alttext="p_{1}=(\psi_{0\to 1})_{\sharp}p_{0}=\delta_{\mathbb{E}_{x_{1}\sim p_{1}(x_{1})}[x_{1}]}" display="inline" intent=":literal"><semantics><mrow><msub><mi>p</mi><mn>1</mn></msub><mo>=</mo><mrow><msub><mrow><mo stretchy="false">(</mo><msub><mi>ψ</mi><mrow><mn>0</mn><mo stretchy="false">→</mo><mn>1</mn></mrow></msub><mo stretchy="false">)</mo></mrow><mi mathvariant="normal">♯</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>p</mi><mn>0</mn></msub></mrow><mo>=</mo><msub><mi>δ</mi><mrow><msub><mi>𝔼</mi><mrow><msub><mi>x</mi><mn>1</mn></msub><mo>∼</mo><mrow><msub><mi>p</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow></mrow></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><msub><mi>x</mi><mn>1</mn></msub><mo stretchy="false">]</mo></mrow></mrow></msub></mrow><annotation encoding="application/x-tex">p_{1}=(\psi_{0\to 1})_{\sharp}p_{0}=\delta_{\mathbb{E}_{x_{1}\sim p_{1}(x_{1})}[x_{1}]}</annotation></semantics></math>, where <math id="A1.SS2.p2.m5" class="ltx_Math" alttext="\delta" display="inline" intent=":literal"><semantics><mi>δ</mi><annotation encoding="application/x-tex">\delta</annotation></semantics></math> denotes the Dirac distribution at a single point, which contradicts the actual setting <math id="A1.SS2.p2.m6" class="ltx_Math" alttext="p_{1}=p_{data}" display="inline" intent=":literal"><semantics><mrow><msub><mi>p</mi><mn>1</mn></msub><mo>=</mo><msub><mi>p</mi><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi></mrow></msub></mrow><annotation encoding="application/x-tex">p_{1}=p_{data}</annotation></semantics></math>.
∎</span></p>
</div>
</div>
</section>
<section id="A1.SS3" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">A.3 </span>Proof of <a href="#S3.Thmtheorem1" title="Theorem 3.1 (Closed-Form Solution of the Endpoint Velocity). ‣ 3.2 Second-Order Approximation ‣ 3 Long-Short Flow-Map Perspective ‣ A Long-Short Flow-Map Perspective for Drifting Models" class="ltx_ref ltx_refmacro_autoref"><span class="ltx_text ltx_ref_tag">Theorem 3.1</span></a></h3>

<section id="A1.SS3.SSS0.Px1" class="ltx_paragraph">
<h5 class="ltx_title ltx_title_paragraph"><a href="#S3.Thmtheorem1" title="Theorem 3.1 (Closed-Form Solution of the Endpoint Velocity). ‣ 3.2 Second-Order Approximation ‣ 3 Long-Short Flow-Map Perspective ‣ A Long-Short Flow-Map Perspective for Drifting Models" class="ltx_ref ltx_refmacro_autoref"><span class="ltx_text ltx_ref_tag">Theorem 3.1</span></a>Closed-Form Solution of the Endpoint Velocity</h5>

<div id="A1.SS3.SSS0.Px1.p1" class="ltx_para ltx_noindent">
<p id="A1.SS3.SSS0.Px1.p1.1" class="ltx_p">For Flow Matching, under mild smoothness assumptions on the underlying distributions, the optimal velocity satisfies <math id="A1.SS3.SSS0.Px1.p1.m1" class="ltx_Math" alttext="\lim_{t\to 1^{-}}u_{t}^{*}(x)=x" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mo>lim</mo><mrow><mi>t</mi><mo stretchy="false">→</mo><msup><mn>1</mn><mo>−</mo></msup></mrow></msub><mrow><msubsup><mi>u</mi><mi>t</mi><mo>∗</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>=</mo><mi>x</mi></mrow><annotation encoding="application/x-tex">\lim_{t\to 1^{-}}u_{t}^{*}(x)=x</annotation></semantics></math>. Consequently, the left-limit endpoint velocity <math id="A1.SS3.SSS0.Px1.p1.m2" class="ltx_Math" alttext="u_{1^{-}}^{*}(x)\triangleq\lim_{t\to 1^{-}}u_{t}^{*}(x)" display="inline" intent=":literal"><semantics><mrow><mrow><msubsup><mi>u</mi><msup><mn>1</mn><mo>−</mo></msup><mo>∗</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo rspace="0.1389em">≜</mo><mrow><msub><mo lspace="0.1389em" rspace="0.167em">lim</mo><mrow><mi>t</mi><mo stretchy="false">→</mo><msup><mn>1</mn><mo>−</mo></msup></mrow></msub><mrow><msubsup><mi>u</mi><mi>t</mi><mo>∗</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">u_{1^{-}}^{*}(x)\triangleq\lim_{t\to 1^{-}}u_{t}^{*}(x)</annotation></semantics></math> admits the closed form for any <math id="A1.SS3.SSS0.Px1.p1.m3" class="ltx_Math" alttext="t\in[0,1)" display="inline" intent=":literal"><semantics><mrow><mi>t</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mn>0</mn><mo>,</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">t\in[0,1)</annotation></semantics></math></p>
<table id="A1.E44" class="ltx_equationgroup ltx_eqn_table">
<tbody>
<tr id="A1.E44X" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A1.E44X.m2" class="ltx_Math" alttext="\displaystyle u^{*}_{1^{-}}(x)=\mathbb{E}_{x_{t}\sim p_{t|1}(x_{t}|x)}[\frac{x-x_{t}}{1-t}]=\frac{\mathbb{E}_{x_{t}\sim p_{t}}[\frac{x-x_{t}}{1-t}k_{t}(x,x_{t})]}{\mathbb{E}_{x_{t}\sim p_{t}}[k_{t}(x,x_{t})]}" display="inline" intent=":literal"><semantics><mrow><mrow><msubsup><mi>u</mi><msup><mn>1</mn><mo>−</mo></msup><mo>∗</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><msub><mi>𝔼</mi><mrow><msub><mi>x</mi><mi>t</mi></msub><mo>∼</mo><mrow><msub><mi>p</mi><mrow><mi>t</mi><mo fence="false">|</mo><mn>1</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">|</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mstyle displaystyle="true"><mfrac><mrow><mi>x</mi><mo>−</mo><msub><mi>x</mi><mi>t</mi></msub></mrow><mrow><mn>1</mn><mo>−</mo><mi>t</mi></mrow></mfrac></mstyle><mo stretchy="false">]</mo></mrow></mrow><mo>=</mo><mstyle displaystyle="true"><mfrac><mrow><msub><mi>𝔼</mi><mrow><msub><mi>x</mi><mi>t</mi></msub><mo>∼</mo><msub><mi>p</mi><mi>t</mi></msub></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mrow><mfrac><mrow><mi>x</mi><mo>−</mo><msub><mi>x</mi><mi>t</mi></msub></mrow><mrow><mn>1</mn><mo>−</mo><mi>t</mi></mrow></mfrac><mo lspace="0em" rspace="0em">​</mo><msub><mi>k</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><msub><mi>x</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">]</mo></mrow></mrow><mrow><msub><mi>𝔼</mi><mrow><msub><mi>x</mi><mi>t</mi></msub><mo>∼</mo><msub><mi>p</mi><mi>t</mi></msub></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mrow><msub><mi>k</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><msub><mi>x</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">]</mo></mrow></mrow></mfrac></mstyle></mrow><annotation encoding="application/x-tex">\displaystyle u^{*}_{1^{-}}(x)=\mathbb{E}_{x_{t}\sim p_{t|1}(x_{t}|x)}[\frac{x-x_{t}}{1-t}]=\frac{\mathbb{E}_{x_{t}\sim p_{t}}[\frac{x-x_{t}}{1-t}k_{t}(x,x_{t})]}{\mathbb{E}_{x_{t}\sim p_{t}}[k_{t}(x,x_{t})]}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equationgroup ltx_align_right">(44)</span></td></tr></tbody>
</table>
</div>
<div id="A1.SS3.SSS0.Px1.1" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="A1.SS3.SSS0.Px1.p2" class="ltx_para ltx_noindent">
<p id="A1.SS3.SSS0.Px1.p2.1" class="ltx_p"><span id="A1.SS3.SSS0.Px1.p2.1.1" class="ltx_text">In the derivations below, for convenience, we adopt the random-variable notation from Flow Matching and use the conditional path <math id="A1.SS3.SSS0.Px1.p2.m1" class="ltx_Math" alttext="X_{t}=tX_{1}+(1-t)X_{0}" display="inline" intent=":literal"><semantics><mrow><msub><mi>X</mi><mi>t</mi></msub><mo>=</mo><mrow><mrow><mi>t</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>X</mi><mn>1</mn></msub></mrow><mo>+</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>t</mi></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>X</mi><mn>0</mn></msub></mrow></mrow></mrow><annotation encoding="application/x-tex">X_{t}=tX_{1}+(1-t)X_{0}</annotation></semantics></math>, where <math id="A1.SS3.SSS0.Px1.p2.m2" class="ltx_Math" alttext="X_{1}\sim p_{1}" display="inline" intent=":literal"><semantics><mrow><msub><mi>X</mi><mn>1</mn></msub><mo>∼</mo><msub><mi>p</mi><mn>1</mn></msub></mrow><annotation encoding="application/x-tex">X_{1}\sim p_{1}</annotation></semantics></math>, <math id="A1.SS3.SSS0.Px1.p2.m3" class="ltx_Math" alttext="X_{0}\sim p_{0}" display="inline" intent=":literal"><semantics><mrow><msub><mi>X</mi><mn>0</mn></msub><mo>∼</mo><msub><mi>p</mi><mn>0</mn></msub></mrow><annotation encoding="application/x-tex">X_{0}\sim p_{0}</annotation></semantics></math>, and <math id="A1.SS3.SSS0.Px1.p2.m4" class="ltx_Math" alttext="X_{t}\sim p_{t}" display="inline" intent=":literal"><semantics><mrow><msub><mi>X</mi><mi>t</mi></msub><mo>∼</mo><msub><mi>p</mi><mi>t</mi></msub></mrow><annotation encoding="application/x-tex">X_{t}\sim p_{t}</annotation></semantics></math> are the random variables induced by this conditional probability path.
For sufficiently smooth distributions, the limit <math id="A1.SS3.SSS0.Px1.p2.m5" class="ltx_Math" alttext="\lim_{\epsilon\to 0^{+}}\mathbb{E}[X_{0}|X_{1-\epsilon}=x]=\mathbb{E}[X_{0}|X_{1}=x]" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mo>lim</mo><mrow><mi>ϵ</mi><mo stretchy="false">→</mo><msup><mn>0</mn><mo>+</mo></msup></mrow></msub><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><msub><mi>X</mi><mn>0</mn></msub><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mrow><msub><mi>X</mi><mrow><mn>1</mn><mo>−</mo><mi>ϵ</mi></mrow></msub><mo>=</mo><mi>x</mi></mrow></mrow><mo stretchy="false">]</mo></mrow></mrow></mrow><mo>=</mo><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><msub><mi>X</mi><mn>0</mn></msub><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mrow><msub><mi>X</mi><mn>1</mn></msub><mo>=</mo><mi>x</mi></mrow></mrow><mo stretchy="false">]</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\lim_{\epsilon\to 0^{+}}\mathbb{E}[X_{0}|X_{1-\epsilon}=x]=\mathbb{E}[X_{0}|X_{1}=x]</annotation></semantics></math> exists. Therefore,</span></p>
<table id="A1.E45" class="ltx_equationgroup ltx_eqn_table">
<tbody>
<tr id="A1.E45X" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A1.E45X.m2" class="ltx_Math" alttext="\displaystyle\lim_{t\to 1^{-}}u_{t}(x)" display="inline" intent=":literal"><semantics><mrow><munder><mo movablelimits="false">lim</mo><mrow><mi>t</mi><mo stretchy="false">→</mo><msup><mn>1</mn><mo>−</mo></msup></mrow></munder><mrow><msub><mi>u</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\lim_{t\to 1^{-}}u_{t}(x)</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.E45X.m3" class="ltx_Math" alttext="\displaystyle=\lim_{\epsilon\to 0^{+}}\frac{x-\mathbb{E}[X_{0}|X_{1-\epsilon}=x]}{1-(1-\epsilon)}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo rspace="0.1389em">=</mo><mrow><munder><mo lspace="0.1389em" movablelimits="false" rspace="0.167em">lim</mo><mrow><mi>ϵ</mi><mo stretchy="false">→</mo><msup><mn>0</mn><mo>+</mo></msup></mrow></munder><mstyle displaystyle="true"><mfrac><mrow><mi>x</mi><mo>−</mo><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><msub><mi>X</mi><mn>0</mn></msub><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mrow><msub><mi>X</mi><mrow><mn>1</mn><mo>−</mo><mi>ϵ</mi></mrow></msub><mo>=</mo><mi>x</mi></mrow></mrow><mo stretchy="false">]</mo></mrow></mrow></mrow><mrow><mn>1</mn><mo>−</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>ϵ</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\lim_{\epsilon\to 0^{+}}\frac{x-\mathbb{E}[X_{0}|X_{1-\epsilon}=x]}{1-(1-\epsilon)}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="4" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equationgroup ltx_align_right">(45)</span></td></tr>
<tr id="A1.E45Xa" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.E45Xa.m2" class="ltx_Math" alttext="\displaystyle=x-\mathbb{E}[X_{0}|X_{1}=x]" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mi>x</mi><mo>−</mo><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><msub><mi>X</mi><mn>0</mn></msub><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mrow><msub><mi>X</mi><mn>1</mn></msub><mo>=</mo><mi>x</mi></mrow></mrow><mo stretchy="false">]</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=x-\mathbb{E}[X_{0}|X_{1}=x]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr>
<tr id="A1.E45Xb" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.E45Xb.m2" class="ltx_Math" alttext="\displaystyle\overset{\textcircled{1}}{=}x-\mathbb{E}[X_{0}]" display="inline" intent=":literal"><semantics><mrow><mrow><mover accent="true"><mo>=</mo><mo mathsize="0.700em">①</mo></mover><mo lspace="0em" rspace="0em">​</mo><mi>x</mi></mrow><mo>−</mo><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><msub><mi>X</mi><mn>0</mn></msub><mo stretchy="false">]</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\overset{\textcircled{1}}{=}x-\mathbb{E}[X_{0}]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr>
<tr id="A1.E45Xc" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.E45Xc.m2" class="ltx_Math" alttext="\displaystyle=x," display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>=</mo><mi>x</mi></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle=x,</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A1.SS3.SSS0.Px1.p2.2" class="ltx_p"><span id="A1.SS3.SSS0.Px1.p2.2.1" class="ltx_text">where ① uses the independence of <math id="A1.SS3.SSS0.Px1.p2.m6" class="ltx_Math" alttext="X_{0}" display="inline" intent=":literal"><semantics><msub><mi>X</mi><mn>0</mn></msub><annotation encoding="application/x-tex">X_{0}</annotation></semantics></math> and <math id="A1.SS3.SSS0.Px1.p2.m7" class="ltx_Math" alttext="X_{1}" display="inline" intent=":literal"><semantics><msub><mi>X</mi><mn>1</mn></msub><annotation encoding="application/x-tex">X_{1}</annotation></semantics></math>. We next show that <math id="A1.SS3.SSS0.Px1.p2.m8" class="ltx_Math" alttext="\mathbb{E}[X_{t}|X_{1}=x]=tx" display="inline" intent=":literal"><semantics><mrow><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><msub><mi>X</mi><mi>t</mi></msub><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mrow><msub><mi>X</mi><mn>1</mn></msub><mo>=</mo><mi>x</mi></mrow></mrow><mo stretchy="false">]</mo></mrow></mrow><mo>=</mo><mrow><mi>t</mi><mo lspace="0em" rspace="0em">​</mo><mi>x</mi></mrow></mrow><annotation encoding="application/x-tex">\mathbb{E}[X_{t}|X_{1}=x]=tx</annotation></semantics></math>.</span></p>
<table id="A1.E46" class="ltx_equationgroup ltx_eqn_table">
<tbody>
<tr id="A1.E46X" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A1.E46X.m2" class="ltx_Math" alttext="\displaystyle\mathbb{E}[X_{t}|X_{1}=x]" display="inline" intent=":literal"><semantics><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><msub><mi>X</mi><mi>t</mi></msub><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mrow><msub><mi>X</mi><mn>1</mn></msub><mo>=</mo><mi>x</mi></mrow></mrow><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\mathbb{E}[X_{t}|X_{1}=x]</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.E46X.m3" class="ltx_Math" alttext="\displaystyle=\mathbb{E}[tX_{1}+(1-t)X_{0}|X_{1}=x]" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><mrow><mrow><mi>t</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>X</mi><mn>1</mn></msub></mrow><mo>+</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>t</mi></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>X</mi><mn>0</mn></msub></mrow></mrow><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mrow><msub><mi>X</mi><mn>1</mn></msub><mo>=</mo><mi>x</mi></mrow></mrow><mo stretchy="false">]</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\mathbb{E}[tX_{1}+(1-t)X_{0}|X_{1}=x]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="4" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equationgroup ltx_align_right">(46)</span></td></tr>
<tr id="A1.E46Xa" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.E46Xa.m2" class="ltx_Math" alttext="\displaystyle=tx+(1-t)\mathbb{E}[X_{0}|X_{1}=x]" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><mi>t</mi><mo lspace="0em" rspace="0em">​</mo><mi>x</mi></mrow><mo>+</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>t</mi></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>𝔼</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mrow><msub><mi>X</mi><mn>0</mn></msub><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mrow><msub><mi>X</mi><mn>1</mn></msub><mo>=</mo><mi>x</mi></mrow></mrow><mo stretchy="false">]</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=tx+(1-t)\mathbb{E}[X_{0}|X_{1}=x]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr>
<tr id="A1.E46Xb" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.E46Xb.m2" class="ltx_Math" alttext="\displaystyle=tx+(1-t)\mathbb{E}[X_{0}]" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><mi>t</mi><mo lspace="0em" rspace="0em">​</mo><mi>x</mi></mrow><mo>+</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>t</mi></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>𝔼</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><msub><mi>X</mi><mn>0</mn></msub><mo stretchy="false">]</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=tx+(1-t)\mathbb{E}[X_{0}]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr>
<tr id="A1.E46Xc" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.E46Xc.m2" class="ltx_Math" alttext="\displaystyle=tx" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mi>t</mi><mo lspace="0em" rspace="0em">​</mo><mi>x</mi></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=tx</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A1.SS3.SSS0.Px1.p2.3" class="ltx_p"><span id="A1.SS3.SSS0.Px1.p2.3.1" class="ltx_text">Consequently, the endpoint velocity admits the representation</span></p>
<table id="A1.E47" class="ltx_equationgroup ltx_eqn_table">
<tbody>
<tr id="A1.E47X" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A1.E47X.m2" class="ltx_Math" alttext="\displaystyle u_{1^{-}}(·x)" display="inline" intent=":literal"><semantics><mrow><msub><mi>u</mi><msup><mn>1</mn><mo>−</mo></msup></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>·</mi><mo lspace="0em" rspace="0em">​</mo><mi>x</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle u_{1^{-}}(·x)</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.E47X.m3" class="ltx_Math" alttext="\displaystyle=\lim_{t\to 1}u_{t}(x)" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo rspace="0.1389em">=</mo><mrow><munder><mo lspace="0.1389em" movablelimits="false" rspace="0.167em">lim</mo><mrow><mi>t</mi><mo stretchy="false">→</mo><mn>1</mn></mrow></munder><mrow><msub><mi>u</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\lim_{t\to 1}u_{t}(x)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="4" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equationgroup ltx_align_right">(47)</span></td></tr>
<tr id="A1.E47Xa" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.E47Xa.m2" class="ltx_Math" alttext="\displaystyle=x" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mi>x</mi></mrow><annotation encoding="application/x-tex">\displaystyle=x</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr>
<tr id="A1.E47Xb" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.E47Xb.m2" class="ltx_Math" alttext="\displaystyle=\frac{x-\mathbb{E}[X_{t}|X_{1}=x]}{1-t}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mstyle displaystyle="true"><mfrac><mrow><mi>x</mi><mo>−</mo><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><msub><mi>X</mi><mi>t</mi></msub><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mrow><msub><mi>X</mi><mn>1</mn></msub><mo>=</mo><mi>x</mi></mrow></mrow><mo stretchy="false">]</mo></mrow></mrow></mrow><mrow><mn>1</mn><mo>−</mo><mi>t</mi></mrow></mfrac></mstyle></mrow><annotation encoding="application/x-tex">\displaystyle=\frac{x-\mathbb{E}[X_{t}|X_{1}=x]}{1-t}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr>
<tr id="A1.E47Xc" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.E47Xc.m2" class="ltx_Math" alttext="\displaystyle=\mathbb{E}_{x_{t}\sim p_{t|1}(x_{t}|x)}[\frac{x-x_{t}}{1-t}]" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><msub><mi>𝔼</mi><mrow><msub><mi>x</mi><mi>t</mi></msub><mo>∼</mo><mrow><msub><mi>p</mi><mrow><mi>t</mi><mo fence="false">|</mo><mn>1</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">|</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mstyle displaystyle="true"><mfrac><mrow><mi>x</mi><mo>−</mo><msub><mi>x</mi><mi>t</mi></msub></mrow><mrow><mn>1</mn><mo>−</mo><mi>t</mi></mrow></mfrac></mstyle><mo stretchy="false">]</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\mathbb{E}_{x_{t}\sim p_{t|1}(x_{t}|x)}[\frac{x-x_{t}}{1-t}]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A1.SS3.SSS0.Px1.p2.4" class="ltx_p"><span id="A1.SS3.SSS0.Px1.p2.4.1" class="ltx_text">Similar to <a href="#A1.SS1" title="A.1 Proof of ‣ Appendix A Missing Proofs and Theorems ‣ A Long-Short Flow-Map Perspective for Drifting Models" class="ltx_ref ltx_refmacro_autoref"><span class="ltx_text ltx_ref_tag">subsection A.1</span></a>, we now derive a closed-form expression for <math id="A1.SS3.SSS0.Px1.p2.m9" class="ltx_Math" alttext="u_{1}(x)" display="inline" intent=":literal"><semantics><mrow><msub><mi>u</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">u_{1}(x)</annotation></semantics></math>:</span></p>
<table id="A1.E48" class="ltx_equationgroup ltx_eqn_table">
<tbody>
<tr id="A1.E48X" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A1.E48X.m2" class="ltx_Math" alttext="\displaystyle u_{1^{-}}(x)" display="inline" intent=":literal"><semantics><mrow><msub><mi>u</mi><msup><mn>1</mn><mo>−</mo></msup></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle u_{1^{-}}(x)</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.E48X.m3" class="ltx_Math" alttext="\displaystyle=\mathbb{E}_{x_{t}\sim p_{t|1}(x_{t}|x)}[\frac{x-x_{t}}{1-t}]" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><msub><mi>𝔼</mi><mrow><msub><mi>x</mi><mi>t</mi></msub><mo>∼</mo><mrow><msub><mi>p</mi><mrow><mi>t</mi><mo fence="false">|</mo><mn>1</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">|</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mstyle displaystyle="true"><mfrac><mrow><mi>x</mi><mo>−</mo><msub><mi>x</mi><mi>t</mi></msub></mrow><mrow><mn>1</mn><mo>−</mo><mi>t</mi></mrow></mfrac></mstyle><mo stretchy="false">]</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\mathbb{E}_{x_{t}\sim p_{t|1}(x_{t}|x)}[\frac{x-x_{t}}{1-t}]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="4" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equationgroup ltx_align_right">(48)</span></td></tr>
<tr id="A1.E48Xa" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.E48Xa.m2" class="ltx_Math" alttext="\displaystyle=\int\frac{x-x_{t}}{1-t}p_{t|1}(x_{t}|x)dx_{t}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mstyle displaystyle="true"><mrow><mo>∫</mo><mrow><mfrac><mrow><mi>x</mi><mo>−</mo><msub><mi>x</mi><mi>t</mi></msub></mrow><mrow><mn>1</mn><mo>−</mo><mi>t</mi></mrow></mfrac><mo lspace="0em" rspace="0em">​</mo><msub><mi>p</mi><mrow><mi>t</mi><mo fence="false">|</mo><mn>1</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">|</mo><mi>x</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>x</mi><mi>t</mi></msub></mrow></mrow></mstyle></mrow><annotation encoding="application/x-tex">\displaystyle=\int\frac{x-x_{t}}{1-t}p_{t|1}(x_{t}|x)dx_{t}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr>
<tr id="A1.E48Xb" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.E48Xb.m2" class="ltx_Math" alttext="\displaystyle=\int\frac{x-x_{t}}{1-t}\frac{p_{1|t}(x|x_{t})p_{t}(x_{t})}{\int_{x_{t}}p_{1|t}(x|x_{t})p_{t}(x_{t})dx_{t}}dx_{t}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mstyle displaystyle="true"><mrow><mo>∫</mo><mrow><mfrac><mrow><mi>x</mi><mo>−</mo><msub><mi>x</mi><mi>t</mi></msub></mrow><mrow><mn>1</mn><mo>−</mo><mi>t</mi></mrow></mfrac><mo lspace="0em" rspace="0em">​</mo><mfrac><mrow><msub><mi>p</mi><mrow><mn>1</mn><mo fence="false">|</mo><mi>t</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo lspace="0em" rspace="0em">|</mo><msub><mi>x</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>p</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mrow><msub><mo>∫</mo><msub><mi>x</mi><mi>t</mi></msub></msub><mrow><msub><mi>p</mi><mrow><mn>1</mn><mo fence="false">|</mo><mi>t</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo lspace="0em" rspace="0em">|</mo><msub><mi>x</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>p</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>x</mi><mi>t</mi></msub></mrow></mrow></mfrac><mo lspace="0em" rspace="0em">​</mo><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>x</mi><mi>t</mi></msub></mrow></mrow></mstyle></mrow><annotation encoding="application/x-tex">\displaystyle=\int\frac{x-x_{t}}{1-t}\frac{p_{1|t}(x|x_{t})p_{t}(x_{t})}{\int_{x_{t}}p_{1|t}(x|x_{t})p_{t}(x_{t})dx_{t}}dx_{t}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr>
<tr id="A1.E48Xc" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.E48Xc.m2" class="ltx_Math" alttext="\displaystyle=\frac{\int\frac{x-x_{t}}{1-t}p_{1|t}(x|x_{t})p_{t}(x_{t})dx_{t}}{\int p_{1|t}(x|x_{t})p_{t}(x_{t})dx_{t}}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mstyle displaystyle="true"><mfrac><mrow><mo>∫</mo><mrow><mfrac><mrow><mi>x</mi><mo>−</mo><msub><mi>x</mi><mi>t</mi></msub></mrow><mrow><mn>1</mn><mo>−</mo><mi>t</mi></mrow></mfrac><mo lspace="0em" rspace="0em">​</mo><msub><mi>p</mi><mrow><mn>1</mn><mo fence="false">|</mo><mi>t</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo lspace="0em" rspace="0em">|</mo><msub><mi>x</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>p</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>x</mi><mi>t</mi></msub></mrow></mrow><mrow><mo>∫</mo><mrow><msub><mi>p</mi><mrow><mn>1</mn><mo fence="false">|</mo><mi>t</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo lspace="0em" rspace="0em">|</mo><msub><mi>x</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>p</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>x</mi><mi>t</mi></msub></mrow></mrow></mfrac></mstyle></mrow><annotation encoding="application/x-tex">\displaystyle=\frac{\int\frac{x-x_{t}}{1-t}p_{1|t}(x|x_{t})p_{t}(x_{t})dx_{t}}{\int p_{1|t}(x|x_{t})p_{t}(x_{t})dx_{t}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A1.SS3.SSS0.Px1.p2.5" class="ltx_p"><span id="A1.SS3.SSS0.Px1.p2.5.1" class="ltx_text">Next, we compute <math id="A1.SS3.SSS0.Px1.p2.m10" class="ltx_Math" alttext="\int p_{1|t}(x|x_{t})p_{t}(x_{t})dx_{t}" display="inline" intent=":literal"><semantics><mrow><mo>∫</mo><mrow><msub><mi>p</mi><mrow><mn>1</mn><mo fence="false">|</mo><mi>t</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo lspace="0em" rspace="0em">|</mo><msub><mi>x</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>p</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>x</mi><mi>t</mi></msub></mrow></mrow><annotation encoding="application/x-tex">\int p_{1|t}(x|x_{t})p_{t}(x_{t})dx_{t}</annotation></semantics></math> and <math id="A1.SS3.SSS0.Px1.p2.m11" class="ltx_Math" alttext="\int\frac{x-x_{t}}{1-t}p_{1|t}(x|x_{t})p_{t}(x_{t})dx_{t}" display="inline" intent=":literal"><semantics><mrow><mo>∫</mo><mrow><mfrac><mrow><mi>x</mi><mo>−</mo><msub><mi>x</mi><mi>t</mi></msub></mrow><mrow><mn>1</mn><mo>−</mo><mi>t</mi></mrow></mfrac><mo lspace="0em" rspace="0em">​</mo><msub><mi>p</mi><mrow><mn>1</mn><mo fence="false">|</mo><mi>t</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo lspace="0em" rspace="0em">|</mo><msub><mi>x</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>p</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>x</mi><mi>t</mi></msub></mrow></mrow><annotation encoding="application/x-tex">\int\frac{x-x_{t}}{1-t}p_{1|t}(x|x_{t})p_{t}(x_{t})dx_{t}</annotation></semantics></math>. For <math id="A1.SS3.SSS0.Px1.p2.m12" class="ltx_Math" alttext="\int\frac{x-x_{t}}{1-t}p_{1|t}(x|x_{t})p_{t}(x_{t})dx_{t}" display="inline" intent=":literal"><semantics><mrow><mo>∫</mo><mrow><mfrac><mrow><mi>x</mi><mo>−</mo><msub><mi>x</mi><mi>t</mi></msub></mrow><mrow><mn>1</mn><mo>−</mo><mi>t</mi></mrow></mfrac><mo lspace="0em" rspace="0em">​</mo><msub><mi>p</mi><mrow><mn>1</mn><mo fence="false">|</mo><mi>t</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo lspace="0em" rspace="0em">|</mo><msub><mi>x</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>p</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>x</mi><mi>t</mi></msub></mrow></mrow><annotation encoding="application/x-tex">\int\frac{x-x_{t}}{1-t}p_{1|t}(x|x_{t})p_{t}(x_{t})dx_{t}</annotation></semantics></math>, we have</span></p>
<table id="A1.E49" class="ltx_equationgroup ltx_eqn_table">
<tbody>
<tr id="A1.E49X" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A1.E49X.m2" class="ltx_Math" alttext="\displaystyle\int\frac{x-x_{t}}{1-t}p_{1|t}(x|x_{t})p_{t}(x_{t})dx_{t}" display="inline" intent=":literal"><semantics><mstyle displaystyle="true"><mrow><mo>∫</mo><mrow><mfrac><mrow><mi>x</mi><mo>−</mo><msub><mi>x</mi><mi>t</mi></msub></mrow><mrow><mn>1</mn><mo>−</mo><mi>t</mi></mrow></mfrac><mo lspace="0em" rspace="0em">​</mo><msub><mi>p</mi><mrow><mn>1</mn><mo fence="false">|</mo><mi>t</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo lspace="0em" rspace="0em">|</mo><msub><mi>x</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>p</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>x</mi><mi>t</mi></msub></mrow></mrow></mstyle><annotation encoding="application/x-tex">\displaystyle\int\frac{x-x_{t}}{1-t}p_{1|t}(x|x_{t})p_{t}(x_{t})dx_{t}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.E49X.m3" class="ltx_Math" alttext="\displaystyle=\int_{x_{t}}\int_{x_{0}}\frac{x-x_{t}}{1-t}p_{1|t,0}(x|x_{t},x_{0})p_{0}(x_{0})dx_{0}p_{t}(x_{t})dx_{t}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mstyle displaystyle="true"><msub><mo>∫</mo><msub><mi>x</mi><mi>t</mi></msub></msub></mstyle><mrow><mstyle displaystyle="true"><msub><mo>∫</mo><msub><mi>x</mi><mn>0</mn></msub></msub></mstyle><mrow><mstyle displaystyle="true"><mfrac><mrow><mi>x</mi><mo>−</mo><msub><mi>x</mi><mi>t</mi></msub></mrow><mrow><mn>1</mn><mo>−</mo><mi>t</mi></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msub><mi>p</mi><mrow><mn>1</mn><mo fence="false">|</mo><mrow><mi>t</mi><mo>,</mo><mn>0</mn></mrow></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo lspace="0em" rspace="0em">|</mo><mrow><msub><mi>x</mi><mi>t</mi></msub><mo>,</mo><msub><mi>x</mi><mn>0</mn></msub></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>p</mi><mn>0</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mn>0</mn></msub><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>x</mi><mn>0</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>p</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>x</mi><mi>t</mi></msub></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\int_{x_{t}}\int_{x_{0}}\frac{x-x_{t}}{1-t}p_{1|t,0}(x|x_{t},x_{0})p_{0}(x_{0})dx_{0}p_{t}(x_{t})dx_{t}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="3" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equationgroup ltx_align_right">(49)</span></td></tr>
<tr id="A1.E49Xa" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.E49Xa.m2" class="ltx_Math" alttext="\displaystyle=\int\frac{x-x_{t}}{1-t}\int\delta(x=\frac{x_{t}-(1-t)x_{0}}{t})\frac{1}{(2\pi)^{\frac{d}{2}}}e^{-\frac{1}{2}x_{0}^{2}}dx_{0}p_{t}(x_{t})dx_{t}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mstyle displaystyle="true"><mrow><mo>∫</mo><mrow><mfrac><mrow><mi>x</mi><mo>−</mo><msub><mi>x</mi><mi>t</mi></msub></mrow><mrow><mn>1</mn><mo>−</mo><mi>t</mi></mrow></mfrac><mo lspace="0em" rspace="0em">​</mo><mrow><mo>∫</mo><mrow><mrow><mi>δ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>x</mi><mo>=</mo><mfrac><mrow><msub><mi>x</mi><mi>t</mi></msub><mo>−</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>t</mi></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>x</mi><mn>0</mn></msub></mrow></mrow><mi>t</mi></mfrac></mrow><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><mfrac><mn>1</mn><msup><mrow><mo stretchy="false">(</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>π</mi></mrow><mo stretchy="false">)</mo></mrow><mfrac><mi>d</mi><mn>2</mn></mfrac></msup></mfrac><mo lspace="0em" rspace="0em">​</mo><msup><mi>e</mi><mrow><mo>−</mo><mrow><mfrac><mn>1</mn><mn>2</mn></mfrac><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>x</mi><mn>0</mn><mn>2</mn></msubsup></mrow></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>x</mi><mn>0</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>p</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>x</mi><mi>t</mi></msub></mrow></mrow></mrow></mrow></mstyle></mrow><annotation encoding="application/x-tex">\displaystyle=\int\frac{x-x_{t}}{1-t}\int\delta(x=\frac{x_{t}-(1-t)x_{0}}{t})\frac{1}{(2\pi)^{\frac{d}{2}}}e^{-\frac{1}{2}x_{0}^{2}}dx_{0}p_{t}(x_{t})dx_{t}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr>
<tr id="A1.E49Xb" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.E49Xb.m2" class="ltx_Math" alttext="\displaystyle=\int\frac{x-x_{t}}{1-t}\frac{1}{(2\pi)^{\frac{d}{2}}}e^{-\frac{1}{2}\|\frac{x_{t}-tx}{1-t}\|^{2}}p_{t}(x_{t})dx_{t}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mstyle displaystyle="true"><mrow><mo>∫</mo><mrow><mfrac><mrow><mi>x</mi><mo>−</mo><msub><mi>x</mi><mi>t</mi></msub></mrow><mrow><mn>1</mn><mo>−</mo><mi>t</mi></mrow></mfrac><mo lspace="0em" rspace="0em">​</mo><mfrac><mn>1</mn><msup><mrow><mo stretchy="false">(</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>π</mi></mrow><mo stretchy="false">)</mo></mrow><mfrac><mi>d</mi><mn>2</mn></mfrac></msup></mfrac><mo lspace="0em" rspace="0em">​</mo><msup><mi>e</mi><mrow><mo>−</mo><mrow><mfrac><mn>1</mn><mn>2</mn></mfrac><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">‖</mo><mfrac><mrow><msub><mi>x</mi><mi>t</mi></msub><mo>−</mo><mrow><mi>t</mi><mo lspace="0em" rspace="0em">​</mo><mi>x</mi></mrow></mrow><mrow><mn>1</mn><mo>−</mo><mi>t</mi></mrow></mfrac><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup></mrow></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>p</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>x</mi><mi>t</mi></msub></mrow></mrow></mstyle></mrow><annotation encoding="application/x-tex">\displaystyle=\int\frac{x-x_{t}}{1-t}\frac{1}{(2\pi)^{\frac{d}{2}}}e^{-\frac{1}{2}\|\frac{x_{t}-tx}{1-t}\|^{2}}p_{t}(x_{t})dx_{t}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A1.SS3.SSS0.Px1.p2.6" class="ltx_p"><span id="A1.SS3.SSS0.Px1.p2.6.1" class="ltx_text">Similarly, we have <math id="A1.SS3.SSS0.Px1.p2.m13" class="ltx_Math" alttext="\int p(x|x_{t})p(x_{t})dx_{t}=\int\frac{1}{(2\pi)^{\frac{d}{2}}}e^{-\frac{1}{2}\|\frac{x_{t}-tx}{1-t}\|^{2}}p(x_{t})dx_{t}" display="inline" intent=":literal"><semantics><mrow><mrow><mo>∫</mo><mrow><mrow><mi>p</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo lspace="0em" rspace="0em">|</mo><msub><mi>x</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>x</mi><mi>t</mi></msub></mrow></mrow><mo rspace="0.111em">=</mo><mrow><mo>∫</mo><mrow><mfrac><mn>1</mn><msup><mrow><mo stretchy="false">(</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>π</mi></mrow><mo stretchy="false">)</mo></mrow><mfrac><mi>d</mi><mn>2</mn></mfrac></msup></mfrac><mo lspace="0em" rspace="0em">​</mo><msup><mi>e</mi><mrow><mo>−</mo><mrow><mfrac><mn>1</mn><mn>2</mn></mfrac><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">‖</mo><mfrac><mrow><msub><mi>x</mi><mi>t</mi></msub><mo>−</mo><mrow><mi>t</mi><mo lspace="0em" rspace="0em">​</mo><mi>x</mi></mrow></mrow><mrow><mn>1</mn><mo>−</mo><mi>t</mi></mrow></mfrac><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup></mrow></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>x</mi><mi>t</mi></msub></mrow></mrow></mrow><annotation encoding="application/x-tex">\int p(x|x_{t})p(x_{t})dx_{t}=\int\frac{1}{(2\pi)^{\frac{d}{2}}}e^{-\frac{1}{2}\|\frac{x_{t}-tx}{1-t}\|^{2}}p(x_{t})dx_{t}</annotation></semantics></math>. Therefore, we have</span></p>
<table id="A1.E50" class="ltx_equationgroup ltx_eqn_table">
<tbody>
<tr id="A1.E50X" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A1.E50X.m2" class="ltx_Math" alttext="\displaystyle u_{1^{-}}(x)=\frac{\mathbb{E}_{x_{t}\sim p_{t}}[\frac{x-x_{t}}{1-t}k_{t}(x,x_{t})]}{\mathbb{E}_{x_{t}\sim p_{t}}[k_{t}(x,x_{t})]}" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>u</mi><msup><mn>1</mn><mo>−</mo></msup></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mstyle displaystyle="true"><mfrac><mrow><msub><mi>𝔼</mi><mrow><msub><mi>x</mi><mi>t</mi></msub><mo>∼</mo><msub><mi>p</mi><mi>t</mi></msub></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mrow><mfrac><mrow><mi>x</mi><mo>−</mo><msub><mi>x</mi><mi>t</mi></msub></mrow><mrow><mn>1</mn><mo>−</mo><mi>t</mi></mrow></mfrac><mo lspace="0em" rspace="0em">​</mo><msub><mi>k</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><msub><mi>x</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">]</mo></mrow></mrow><mrow><msub><mi>𝔼</mi><mrow><msub><mi>x</mi><mi>t</mi></msub><mo>∼</mo><msub><mi>p</mi><mi>t</mi></msub></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mrow><msub><mi>k</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><msub><mi>x</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">]</mo></mrow></mrow></mfrac></mstyle></mrow><annotation encoding="application/x-tex">\displaystyle u_{1^{-}}(x)=\frac{\mathbb{E}_{x_{t}\sim p_{t}}[\frac{x-x_{t}}{1-t}k_{t}(x,x_{t})]}{\mathbb{E}_{x_{t}\sim p_{t}}[k_{t}(x,x_{t})]}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equationgroup ltx_align_right">(50)</span></td></tr></tbody>
</table>
<p id="A1.SS3.SSS0.Px1.p2.7" class="ltx_p"><span id="A1.SS3.SSS0.Px1.p2.7.1" class="ltx_text">∎</span></p>
</div>
</div>
</section>
</section>
<section id="A1.SS4" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">A.4 </span>Proof of <a href="#S4.Thmtheorem1" title="Theorem 4.1 (Closed-Form Solution for Velocity Divergence). ‣ 4.2 Drifting Model for Likelihood Learning ‣ 4 Application: Likelihood Learning ‣ A Long-Short Flow-Map Perspective for Drifting Models" class="ltx_ref ltx_refmacro_autoref"><span class="ltx_text ltx_ref_tag">Theorem 4.1</span></a></h3>

<section id="A1.SS4.SSS0.Px1" class="ltx_paragraph">
<h5 class="ltx_title ltx_title_paragraph"><a href="#S4.Thmtheorem1" title="Theorem 4.1 (Closed-Form Solution for Velocity Divergence). ‣ 4.2 Drifting Model for Likelihood Learning ‣ 4 Application: Likelihood Learning ‣ A Long-Short Flow-Map Perspective for Drifting Models" class="ltx_ref ltx_refmacro_autoref"><span class="ltx_text ltx_ref_tag">Theorem 4.1</span></a>Closed-Form Solution for Velocity Divergence</h5>

<div id="A1.SS4.SSS0.Px1.p1" class="ltx_para ltx_noindent">
<p id="A1.SS4.SSS0.Px1.p1.1" class="ltx_p">For the closed-form solution of the velocity field <math id="A1.SS4.SSS0.Px1.p1.m1" class="ltx_Math" alttext="u^{*}_{t}(x)" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>u</mi><mi>t</mi><mo>∗</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">u^{*}_{t}(x)</annotation></semantics></math> in <a href="#S2.E5" title="Equation 5 ‣ Theorem 2.1 (Closed-Form Solution of Flow Matching ( ) ). ‣ 2.1 Closed-Form Flow Matching ‣ 2 Background ‣ A Long-Short Flow-Map Perspective for Drifting Models" class="ltx_ref ltx_refmacro_autoref"><span class="ltx_text ltx_ref_tag">Equation 5</span></a> and the endpoint velocity <math id="A1.SS4.SSS0.Px1.p1.m2" class="ltx_Math" alttext="u^{*}_{1^{-}}(x)" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>u</mi><msup><mn>1</mn><mo>−</mo></msup><mo>∗</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">u^{*}_{1^{-}}(x)</annotation></semantics></math> in <a href="#S3.E15" title="Equation 15 ‣ Theorem 3.1 (Closed-Form Solution of the Endpoint Velocity). ‣ 3.2 Second-Order Approximation ‣ 3 Long-Short Flow-Map Perspective ‣ A Long-Short Flow-Map Perspective for Drifting Models" class="ltx_ref ltx_refmacro_autoref"><span class="ltx_text ltx_ref_tag">Equation 15</span></a> with the mollified kernel <math id="A1.SS4.SSS0.Px1.p1.m3" class="ltx_Math" alttext="k_{t}^{\epsilon}" display="inline" intent=":literal"><semantics><msubsup><mi>k</mi><mi>t</mi><mi>ϵ</mi></msubsup><annotation encoding="application/x-tex">k_{t}^{\epsilon}</annotation></semantics></math> in <a href="#S3.E11" title="Equation 11 ‣ 3.1 First-Order Approximation ‣ 3 Long-Short Flow-Map Perspective ‣ A Long-Short Flow-Map Perspective for Drifting Models" class="ltx_ref ltx_refmacro_autoref"><span class="ltx_text ltx_ref_tag">Equation 11</span></a>, their divergences can be also computed in closed form as</p>
<table id="A1.E51" class="ltx_equationgroup ltx_eqn_table">
<tbody>
<tr id="A1.E51X" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A1.E51X.m2" class="ltx_Math" alttext="\displaystyle\nabla\cdot u^{*}_{t}(x)" display="inline" intent=":literal"><semantics><mrow><mrow><mo>∇</mo><mo lspace="0em" rspace="0.222em">⋅</mo><msubsup><mi>u</mi><mi>t</mi><mo>∗</mo></msubsup></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\nabla\cdot u^{*}_{t}(x)</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.E51X.m3" class="ltx_Math" alttext="\displaystyle=\frac{1}{1-t}[\frac{2t}{2(1-t)^{2}+\epsilon}(\frac{\mathbb{E}_{x_{1}\sim p_{1}}[\|x_{1}\|^{2}k^{\epsilon}_{t}(x_{1},x)]}{\mathbb{E}_{x_{1}\sim p_{1}}[k^{\epsilon}_{t}(x_{1},x)]}" display="inline" intent=":literal"><semantics><mrow><mo>=</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mrow><mn>1</mn><mo>−</mo><mi>t</mi></mrow></mfrac></mstyle><mo stretchy="false">[</mo><mstyle displaystyle="true"><mfrac><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>t</mi></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mrow><mo>+</mo><mi>ϵ</mi></mrow></mfrac></mstyle><mo stretchy="false">(</mo><mstyle displaystyle="true"><mfrac><mrow><msub><mi>𝔼</mi><mrow><msub><mi>x</mi><mn>1</mn></msub><mo>∼</mo><msub><mi>p</mi><mn>1</mn></msub></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mrow><msup><mrow><mo stretchy="false">‖</mo><msub><mi>x</mi><mn>1</mn></msub><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>k</mi><mi>t</mi><mi>ϵ</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mn>1</mn></msub><mo>,</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">]</mo></mrow></mrow><mrow><msub><mi>𝔼</mi><mrow><msub><mi>x</mi><mn>1</mn></msub><mo>∼</mo><msub><mi>p</mi><mn>1</mn></msub></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mrow><msubsup><mi>k</mi><mi>t</mi><mi>ϵ</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mn>1</mn></msub><mo>,</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">]</mo></mrow></mrow></mfrac></mstyle></mrow><annotation encoding="application/x-tex">\displaystyle=\frac{1}{1-t}[\frac{2t}{2(1-t)^{2}+\epsilon}(\frac{\mathbb{E}_{x_{1}\sim p_{1}}[\|x_{1}\|^{2}k^{\epsilon}_{t}(x_{1},x)]}{\mathbb{E}_{x_{1}\sim p_{1}}[k^{\epsilon}_{t}(x_{1},x)]}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="4" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equationgroup ltx_align_right">(51)</span></td></tr>
<tr id="A1.E51Xa" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.E51Xa.m2" class="ltx_Math" alttext="\displaystyle-\|\frac{\mathbb{E}_{x_{1}\sim p_{1}}[x_{1}k^{\epsilon}_{t}(x_{1},x)]}{\mathbb{E}_{x_{1}\sim p_{1}}[k^{\epsilon}_{t}(x_{1},x)]}\|^{2})-d]" display="inline" intent=":literal"><semantics><mrow><mo rspace="0em">−</mo><mo lspace="0em" rspace="0.167em">∥</mo><mstyle displaystyle="true"><mfrac><mrow><msub><mi>𝔼</mi><mrow><msub><mi>x</mi><mn>1</mn></msub><mo>∼</mo><msub><mi>p</mi><mn>1</mn></msub></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mrow><msub><mi>x</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>k</mi><mi>t</mi><mi>ϵ</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mn>1</mn></msub><mo>,</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">]</mo></mrow></mrow><mrow><msub><mi>𝔼</mi><mrow><msub><mi>x</mi><mn>1</mn></msub><mo>∼</mo><msub><mi>p</mi><mn>1</mn></msub></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mrow><msubsup><mi>k</mi><mi>t</mi><mi>ϵ</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mn>1</mn></msub><mo>,</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">]</mo></mrow></mrow></mfrac></mstyle><mo lspace="0em" rspace="0.167em">∥</mo><msup><mrow></mrow><mn>2</mn></msup><mo stretchy="false">)</mo><mo>−</mo><mi>d</mi><mo stretchy="false">]</mo></mrow><annotation encoding="application/x-tex">\displaystyle-\|\frac{\mathbb{E}_{x_{1}\sim p_{1}}[x_{1}k^{\epsilon}_{t}(x_{1},x)]}{\mathbb{E}_{x_{1}\sim p_{1}}[k^{\epsilon}_{t}(x_{1},x)]}\|^{2})-d]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr>
<tr id="A1.E51Xb" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A1.E51Xb.m2" class="ltx_Math" alttext="\displaystyle\nabla\cdot u^{*}_{1^{-}}(x)" display="inline" intent=":literal"><semantics><mrow><mrow><mo>∇</mo><mo lspace="0em" rspace="0.222em">⋅</mo><msubsup><mi>u</mi><msup><mn>1</mn><mo>−</mo></msup><mo>∗</mo></msubsup></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\nabla\cdot u^{*}_{1^{-}}(x)</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.E51Xb.m3" class="ltx_Math" alttext="\displaystyle=\frac{1}{1-t}[d-\frac{2t^{2}}{2(1-t)^{2}+\epsilon}(\frac{\mathbb{E}_{x_{t}\sim p_{t}}[\|x_{t}\|^{2}k^{\epsilon}_{t}(x,x_{t})]}{\mathbb{E}_{x_{t}\sim p_{t}}[k^{\epsilon}_{t}(x,x_{t})]}" display="inline" intent=":literal"><semantics><mrow><mo>=</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mrow><mn>1</mn><mo>−</mo><mi>t</mi></mrow></mfrac></mstyle><mo stretchy="false">[</mo><mi>d</mi><mo>−</mo><mstyle displaystyle="true"><mfrac><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msup><mi>t</mi><mn>2</mn></msup></mrow><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>t</mi></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mrow><mo>+</mo><mi>ϵ</mi></mrow></mfrac></mstyle><mo stretchy="false">(</mo><mstyle displaystyle="true"><mfrac><mrow><msub><mi>𝔼</mi><mrow><msub><mi>x</mi><mi>t</mi></msub><mo>∼</mo><msub><mi>p</mi><mi>t</mi></msub></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mrow><msup><mrow><mo stretchy="false">‖</mo><msub><mi>x</mi><mi>t</mi></msub><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>k</mi><mi>t</mi><mi>ϵ</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><msub><mi>x</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">]</mo></mrow></mrow><mrow><msub><mi>𝔼</mi><mrow><msub><mi>x</mi><mi>t</mi></msub><mo>∼</mo><msub><mi>p</mi><mi>t</mi></msub></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mrow><msubsup><mi>k</mi><mi>t</mi><mi>ϵ</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><msub><mi>x</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">]</mo></mrow></mrow></mfrac></mstyle></mrow><annotation encoding="application/x-tex">\displaystyle=\frac{1}{1-t}[d-\frac{2t^{2}}{2(1-t)^{2}+\epsilon}(\frac{\mathbb{E}_{x_{t}\sim p_{t}}[\|x_{t}\|^{2}k^{\epsilon}_{t}(x,x_{t})]}{\mathbb{E}_{x_{t}\sim p_{t}}[k^{\epsilon}_{t}(x,x_{t})]}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr>
<tr id="A1.E51Xc" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.E51Xc.m2" class="ltx_Math" alttext="\displaystyle-\|\frac{\mathbb{E}_{x_{t}\sim p_{t}}[x_{t}k^{\epsilon}_{t}(x,x_{t})]}{\mathbb{E}_{x_{t}\sim p_{t}}[k^{\epsilon}_{t}(x,x_{t})]}\|^{2})]" display="inline" intent=":literal"><semantics><mrow><mo rspace="0em">−</mo><mo lspace="0em" rspace="0.167em">∥</mo><mstyle displaystyle="true"><mfrac><mrow><msub><mi>𝔼</mi><mrow><msub><mi>x</mi><mi>t</mi></msub><mo>∼</mo><msub><mi>p</mi><mi>t</mi></msub></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mrow><msub><mi>x</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>k</mi><mi>t</mi><mi>ϵ</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><msub><mi>x</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">]</mo></mrow></mrow><mrow><msub><mi>𝔼</mi><mrow><msub><mi>x</mi><mi>t</mi></msub><mo>∼</mo><msub><mi>p</mi><mi>t</mi></msub></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mrow><msubsup><mi>k</mi><mi>t</mi><mi>ϵ</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><msub><mi>x</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">]</mo></mrow></mrow></mfrac></mstyle><mo lspace="0em" rspace="0.167em">∥</mo><msup><mrow></mrow><mn>2</mn></msup><mo stretchy="false">)</mo><mo stretchy="false">]</mo></mrow><annotation encoding="application/x-tex">\displaystyle-\|\frac{\mathbb{E}_{x_{t}\sim p_{t}}[x_{t}k^{\epsilon}_{t}(x,x_{t})]}{\mathbb{E}_{x_{t}\sim p_{t}}[k^{\epsilon}_{t}(x,x_{t})]}\|^{2})]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="A1.SS4.SSS0.Px1.1" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="A1.SS4.SSS0.Px1.p2" class="ltx_para ltx_noindent">
<p id="A1.SS4.SSS0.Px1.p2.1" class="ltx_p"><span id="A1.SS4.SSS0.Px1.p2.1.1" class="ltx_text">First, we compute the partial derivative of <math id="A1.SS4.SSS0.Px1.p2.m1" class="ltx_Math" alttext="k^{\epsilon}_{t}(y,x)" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>k</mi><mi>t</mi><mi>ϵ</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>y</mi><mo>,</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">k^{\epsilon}_{t}(y,x)</annotation></semantics></math>:</span></p>
<table id="A1.E52" class="ltx_equationgroup ltx_eqn_table">
<tbody>
<tr id="A1.E52X" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A1.E52X.m2" class="ltx_Math" alttext="\displaystyle\frac{\partial k^{\epsilon}_{t}(y,x)}{\partial y}=-\frac{2t(ty-x)}{2(1-t)^{2}+\epsilon}e^{-\frac{\|ty-x\|^{2}}{2(1-t)^{2}+\epsilon}}" display="inline" intent=":literal"><semantics><mrow><mstyle displaystyle="true"><mfrac><mrow><mo>∂</mo><mrow><msubsup><mi>k</mi><mi>t</mi><mi>ϵ</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>y</mi><mo>,</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mrow><mo>∂</mo><mi>y</mi></mrow></mfrac></mstyle><mo>=</mo><mrow><mo>−</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>t</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mi>t</mi><mo lspace="0em" rspace="0em">​</mo><mi>y</mi></mrow><mo>−</mo><mi>x</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>t</mi></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mrow><mo>+</mo><mi>ϵ</mi></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msup><mi>e</mi><mrow><mo>−</mo><mfrac><msup><mrow><mo stretchy="false">‖</mo><mrow><mrow><mi>t</mi><mo lspace="0em" rspace="0em">​</mo><mi>y</mi></mrow><mo>−</mo><mi>x</mi></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>t</mi></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mrow><mo>+</mo><mi>ϵ</mi></mrow></mfrac></mrow></msup></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\frac{\partial k^{\epsilon}_{t}(y,x)}{\partial y}=-\frac{2t(ty-x)}{2(1-t)^{2}+\epsilon}e^{-\frac{\|ty-x\|^{2}}{2(1-t)^{2}+\epsilon}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="2" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equationgroup ltx_align_right">(52)</span></td></tr>
<tr id="A1.E52Xa" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A1.E52Xa.m2" class="ltx_Math" alttext="\displaystyle\frac{\partial k^{\epsilon}_{t}(y,x)}{\partial x}=\frac{2(ty-x)}{2(1-t)^{2}+\epsilon}e^{-\frac{\|ty-x\|^{2}}{2(1-t)^{2}+\epsilon}}" display="inline" intent=":literal"><semantics><mrow><mstyle displaystyle="true"><mfrac><mrow><mo>∂</mo><mrow><msubsup><mi>k</mi><mi>t</mi><mi>ϵ</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>y</mi><mo>,</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mrow><mo>∂</mo><mi>x</mi></mrow></mfrac></mstyle><mo>=</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mi>t</mi><mo lspace="0em" rspace="0em">​</mo><mi>y</mi></mrow><mo>−</mo><mi>x</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>t</mi></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mrow><mo>+</mo><mi>ϵ</mi></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msup><mi>e</mi><mrow><mo>−</mo><mfrac><msup><mrow><mo stretchy="false">‖</mo><mrow><mrow><mi>t</mi><mo lspace="0em" rspace="0em">​</mo><mi>y</mi></mrow><mo>−</mo><mi>x</mi></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>t</mi></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mrow><mo>+</mo><mi>ϵ</mi></mrow></mfrac></mrow></msup></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\frac{\partial k^{\epsilon}_{t}(y,x)}{\partial x}=\frac{2(ty-x)}{2(1-t)^{2}+\epsilon}e^{-\frac{\|ty-x\|^{2}}{2(1-t)^{2}+\epsilon}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A1.SS4.SSS0.Px1.p2.2" class="ltx_p"><span id="A1.SS4.SSS0.Px1.p2.2.1" class="ltx_text">Then, we calculate <math id="A1.SS4.SSS0.Px1.p2.m2" class="ltx_Math" alttext="\nabla\cdot u^{*}_{t}(x)" display="inline" intent=":literal"><semantics><mrow><mrow><mo>∇</mo><mo lspace="0em" rspace="0.222em">⋅</mo><msubsup><mi>u</mi><mi>t</mi><mo>∗</mo></msubsup></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\nabla\cdot u^{*}_{t}(x)</annotation></semantics></math> and <math id="A1.SS4.SSS0.Px1.p2.m3" class="ltx_Math" alttext="\nabla\cdot u^{*}_{1}(x)" display="inline" intent=":literal"><semantics><mrow><mrow><mo>∇</mo><mo lspace="0em" rspace="0.222em">⋅</mo><msubsup><mi>u</mi><mn>1</mn><mo>∗</mo></msubsup></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\nabla\cdot u^{*}_{1}(x)</annotation></semantics></math>, respectively. For <math id="A1.SS4.SSS0.Px1.p2.m4" class="ltx_Math" alttext="\nabla\cdot u^{*}_{t}(x)" display="inline" intent=":literal"><semantics><mrow><mrow><mo>∇</mo><mo lspace="0em" rspace="0.222em">⋅</mo><msubsup><mi>u</mi><mi>t</mi><mo>∗</mo></msubsup></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\nabla\cdot u^{*}_{t}(x)</annotation></semantics></math>, we have</span></p>
<table id="A1.E53" class="ltx_equationgroup ltx_eqn_table">
<tbody>
<tr id="A1.E53X" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.E53X.m2" class="ltx_Math" alttext="\displaystyle\nabla\cdot u_{t}^{*}(x)" display="inline" intent=":literal"><semantics><mrow><mrow><mo>∇</mo><mo lspace="0em" rspace="0.222em">⋅</mo><msubsup><mi>u</mi><mi>t</mi><mo>∗</mo></msubsup></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\nabla\cdot u_{t}^{*}(x)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="8" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equationgroup ltx_align_right">(53)</span></td></tr>
<tr id="A1.E53Xa" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.E53Xa.m2" class="ltx_Math" alttext="\displaystyle=\nabla\cdot\Big(\frac{\mathbb{E}_{x_{1}\sim p_{1}}[\frac{x_{1}-x}{1-t}k_{t}^{\epsilon}(x_{1},x)]}{\mathbb{E}_{x_{1}\sim p_{1}}[k_{t}^{\epsilon}(x_{1},x)]}\Big)" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mo>∇</mo><mo lspace="0em" rspace="0.222em">⋅</mo><mrow><mo maxsize="1.600em" minsize="1.600em">(</mo><mstyle displaystyle="true"><mfrac><mrow><msub><mi>𝔼</mi><mrow><msub><mi>x</mi><mn>1</mn></msub><mo>∼</mo><msub><mi>p</mi><mn>1</mn></msub></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mrow><mfrac><mrow><msub><mi>x</mi><mn>1</mn></msub><mo>−</mo><mi>x</mi></mrow><mrow><mn>1</mn><mo>−</mo><mi>t</mi></mrow></mfrac><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>k</mi><mi>t</mi><mi>ϵ</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mn>1</mn></msub><mo>,</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">]</mo></mrow></mrow><mrow><msub><mi>𝔼</mi><mrow><msub><mi>x</mi><mn>1</mn></msub><mo>∼</mo><msub><mi>p</mi><mn>1</mn></msub></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mrow><msubsup><mi>k</mi><mi>t</mi><mi>ϵ</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mn>1</mn></msub><mo>,</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">]</mo></mrow></mrow></mfrac></mstyle><mo maxsize="1.600em" minsize="1.600em">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\nabla\cdot\Big(\frac{\mathbb{E}_{x_{1}\sim p_{1}}[\frac{x_{1}-x}{1-t}k_{t}^{\epsilon}(x_{1},x)]}{\mathbb{E}_{x_{1}\sim p_{1}}[k_{t}^{\epsilon}(x_{1},x)]}\Big)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr>
<tr id="A1.E53Xb" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.E53Xb.m2" class="ltx_Math" alttext="\displaystyle=\frac{\nabla\cdot\Big(\frac{\mathbb{E}_{x_{1}\sim p_{1}}[x_{1}k_{t}^{\epsilon}(x_{1},x)]}{\mathbb{E}_{x_{1}\sim p_{1}}[k_{t}^{\epsilon}(x_{1},x)]}\Big)-d}{1-t}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mstyle displaystyle="true"><mfrac><mrow><mrow><mo>∇</mo><mo lspace="0em" rspace="0.222em">⋅</mo><mrow><mo maxsize="1.600em" minsize="1.600em">(</mo><mfrac><mrow><msub><mi>𝔼</mi><mrow><msub><mi>x</mi><mn>1</mn></msub><mo>∼</mo><msub><mi>p</mi><mn>1</mn></msub></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mrow><msub><mi>x</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>k</mi><mi>t</mi><mi>ϵ</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mn>1</mn></msub><mo>,</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">]</mo></mrow></mrow><mrow><msub><mi>𝔼</mi><mrow><msub><mi>x</mi><mn>1</mn></msub><mo>∼</mo><msub><mi>p</mi><mn>1</mn></msub></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mrow><msubsup><mi>k</mi><mi>t</mi><mi>ϵ</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mn>1</mn></msub><mo>,</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">]</mo></mrow></mrow></mfrac><mo maxsize="1.600em" minsize="1.600em">)</mo></mrow></mrow><mo>−</mo><mi>d</mi></mrow><mrow><mn>1</mn><mo>−</mo><mi>t</mi></mrow></mfrac></mstyle></mrow><annotation encoding="application/x-tex">\displaystyle=\frac{\nabla\cdot\Big(\frac{\mathbb{E}_{x_{1}\sim p_{1}}[x_{1}k_{t}^{\epsilon}(x_{1},x)]}{\mathbb{E}_{x_{1}\sim p_{1}}[k_{t}^{\epsilon}(x_{1},x)]}\Big)-d}{1-t}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr>
<tr id="A1.E53Xc" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
