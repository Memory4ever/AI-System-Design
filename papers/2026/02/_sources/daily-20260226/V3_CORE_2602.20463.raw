<tr id="A1.E59Xe" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.E59Xe.m2" class="ltx_Math" alttext="\displaystyle=\int\int\frac{\phi_{j}(x_{1})-\phi_{j}(x)}{1-t}p_{X_{1}|X_{t}}(x_{1}|x)dx_{1}p_{x|z}(x|z)dx" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mstyle displaystyle="true"><mrow><mo rspace="0em">∫</mo><mo>∫</mo></mrow></mstyle><mo>⁡</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mrow><msub><mi>ϕ</mi><mi>j</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msub><mi>ϕ</mi><mi>j</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mrow><mn>1</mn><mo>−</mo><mi>t</mi></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msub><mi>p</mi><mrow><msub><mi>X</mi><mn>1</mn></msub><mo fence="false">|</mo><msub><mi>X</mi><mi>t</mi></msub></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">|</mo><mi>x</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>x</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>p</mi><mrow><mi>x</mi><mo fence="false">|</mo><mi>z</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo lspace="0em" rspace="0em">|</mo><mi>z</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo rspace="0em">𝑑</mo><mi>x</mi></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\int\int\frac{\phi_{j}(x_{1})-\phi_{j}(x)}{1-t}p_{X_{1}|X_{t}}(x_{1}|x)dx_{1}p_{x|z}(x|z)dx</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr>
<tr id="A1.E59Xf" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.E59Xf.m2" class="ltx_Math" alttext="\displaystyle\approx\int\int J_{\phi_{j}}(x)\frac{x_{1}-x}{1-t}p_{X_{1}|X_{t}}(x_{1}|x)dx_{1}p_{x|z}(x|z)dx" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≈</mo><mrow><mstyle displaystyle="true"><mrow><mo rspace="0em">∫</mo><mo>∫</mo></mrow></mstyle><mo>⁡</mo><mrow><msub><mi>J</mi><msub><mi>ϕ</mi><mi>j</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><mrow><msub><mi>x</mi><mn>1</mn></msub><mo>−</mo><mi>x</mi></mrow><mrow><mn>1</mn><mo>−</mo><mi>t</mi></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msub><mi>p</mi><mrow><msub><mi>X</mi><mn>1</mn></msub><mo fence="false">|</mo><msub><mi>X</mi><mi>t</mi></msub></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">|</mo><mi>x</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>x</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>p</mi><mrow><mi>x</mi><mo fence="false">|</mo><mi>z</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo lspace="0em" rspace="0em">|</mo><mi>z</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo rspace="0em">𝑑</mo><mi>x</mi></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\approx\int\int J_{\phi_{j}}(x)\frac{x_{1}-x}{1-t}p_{X_{1}|X_{t}}(x_{1}|x)dx_{1}p_{x|z}(x|z)dx</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr>
<tr id="A1.E59Xg" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.E59Xg.m2" class="ltx_Math" alttext="\displaystyle=\int J_{\phi_{j}}(x)u_{t}^{x,*}(x)p_{x|z}(x|z)dx" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mstyle displaystyle="true"><mrow><mo>∫</mo><mrow><msub><mi>J</mi><msub><mi>ϕ</mi><mi>j</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>u</mi><mi>t</mi><mrow><mi>x</mi><mo rspace="0em">,</mo><mo lspace="0em">∗</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>p</mi><mrow><mi>x</mi><mo fence="false">|</mo><mi>z</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo lspace="0em" rspace="0em">|</mo><mi>z</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo rspace="0em">𝑑</mo><mi>x</mi></mrow></mrow></mrow></mstyle></mrow><annotation encoding="application/x-tex">\displaystyle=\int J_{\phi_{j}}(x)u_{t}^{x,*}(x)p_{x|z}(x|z)dx</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr>
<tr id="A1.E59Xh" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.E59Xh.m2" class="ltx_Math" alttext="\displaystyle=\mathbb{E}_{x\sim p_{x|z}}[J_{\phi_{j}}(x)u_{t}^{x,*}(x)]" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><msub><mi>𝔼</mi><mrow><mi>x</mi><mo>∼</mo><msub><mi>p</mi><mrow><mi>x</mi><mo fence="false">|</mo><mi>z</mi></mrow></msub></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mrow><msub><mi>J</mi><msub><mi>ϕ</mi><mi>j</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>u</mi><mi>t</mi><mrow><mi>x</mi><mo rspace="0em">,</mo><mo lspace="0em">∗</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">]</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\mathbb{E}_{x\sim p_{x|z}}[J_{\phi_{j}}(x)u_{t}^{x,*}(x)]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A1.SS5.SSS0.Px1.p2.4" class="ltx_p"><span id="A1.SS5.SSS0.Px1.p2.4.1" class="ltx_text">where <math id="A1.SS5.SSS0.Px1.p2.m5" class="ltx_Math" alttext="\textcircled{1}" display="inline" intent=":literal"><semantics><mn>①</mn><annotation encoding="application/x-tex">\textcircled{1}</annotation></semantics></math> holds because</span></p>
