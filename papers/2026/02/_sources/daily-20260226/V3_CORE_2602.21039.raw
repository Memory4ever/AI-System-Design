</div>
</section>
<section id="A4.SS6.SSS0.Px2" class="ltx_paragraph">
<h4 class="ltx_title ltx_title_paragraph"><span id="A4.SS6.SSS0.Px2.1" class="ltx_text ltx_underline"><math id="A4.SS6.SSS0.Px2.m1" class="ltx_Math" alttext="\bm{H_{1}}" display="inline" intent=":literal"><semantics><msub><mi>𝑯</mi><mn>𝟏</mn></msub><annotation encoding="application/x-tex">\bm{H_{1}}</annotation></semantics></math></span>:</h4>

<div id="A4.SS6.SSS0.Px2.p1" class="ltx_para">
<p id="A4.SS6.SSS0.Px2.p1.1" class="ltx_p">Suppose that the alternative hypothesis <math id="A4.SS6.SSS0.Px2.p1.m1" class="ltx_Math" alttext="H_{1}" display="inline" intent=":literal"><semantics><msub><mi>H</mi><mn>1</mn></msub><annotation encoding="application/x-tex">H_{1}</annotation></semantics></math> is true. Then,</p>
<table id="A4.EGx110" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A4.Ex145"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A4.Ex145.m1" class="ltx_Math" alttext="\displaystyle\mathbb{P}_{1}\mathinner{\left(\mathcal{A}_{s}=\mathsf{NO}\right)}" display="inline" intent=":literal"><semantics><mrow><msub><mi>ℙ</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><msub><mi class="ltx_font_mathcaligraphic">𝒜</mi><mi>s</mi></msub><mo>=</mo><mi>𝖭𝖮</mi></mrow><mo>)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\mathbb{P}_{1}\mathinner{\left(\mathcal{A}_{s}=\mathsf{NO}\right)}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex145.m2" class="ltx_Math" alttext="\displaystyle=\mathbb{P}_{1}\mathinner{\left(\mathinner{\left\{T_{i}&gt;\frac{0.05d}{2\epsilon}\right\}}\cap\mathinner{\left\{\mathcal{A}_{s}=\mathsf{NO}\right\}}\right)}+\mathbb{P}_{1}\mathinner{\left(\mathinner{\left\{T_{i}\leq\frac{0.05d}{2\epsilon}\right\}}\cap\mathinner{\left\{\mathsf{D}_{i}=\mathsf{NO}\right\}}\right)}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><msub><mi>ℙ</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mrow><mo>{</mo><mi>T</mi><msub><mrow></mrow><mi>i</mi></msub><mo>&gt;</mo><mstyle displaystyle="true"><mfrac><mrow><mn>0.05</mn><mo lspace="0em" rspace="0em">​</mo><mi>d</mi></mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>ϵ</mi></mrow></mfrac></mstyle><mo>}</mo></mrow><mo>∩</mo><mrow><mo>{</mo><mi class="ltx_font_mathcaligraphic">𝒜</mi><msub><mrow></mrow><mi>s</mi></msub><mo>=</mo><mi>𝖭𝖮</mi><mo>}</mo></mrow></mrow><mo>)</mo></mrow></mrow><mo>+</mo><mrow><msub><mi>ℙ</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mrow><mo>{</mo><mi>T</mi><msub><mrow></mrow><mi>i</mi></msub><mo>≤</mo><mstyle displaystyle="true"><mfrac><mrow><mn>0.05</mn><mo lspace="0em" rspace="0em">​</mo><mi>d</mi></mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>ϵ</mi></mrow></mfrac></mstyle><mo>}</mo></mrow><mo>∩</mo><mrow><mo>{</mo><mi>𝖣</mi><msub><mrow></mrow><mi>i</mi></msub><mo>=</mo><mi>𝖭𝖮</mi><mo>}</mo></mrow></mrow><mo>)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\mathbb{P}_{1}\mathinner{\left(\mathinner{\left\{T_{i}&gt;\frac{0.05d}{2\epsilon}\right\}}\cap\mathinner{\left\{\mathcal{A}_{s}=\mathsf{NO}\right\}}\right)}+\mathbb{P}_{1}\mathinner{\left(\mathinner{\left\{T_{i}\leq\frac{0.05d}{2\epsilon}\right\}}\cap\mathinner{\left\{\mathsf{D}_{i}=\mathsf{NO}\right\}}\right)}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A4.Ex146"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex146.m1" class="ltx_Math" alttext="\displaystyle=\mathbb{P}_{1}\mathinner{\left(T_{i}&gt;\frac{0.05d}{2\epsilon}\right)}\mathbb{P}\mathinner{\left(\mathcal{A}_{s}=\mathsf{NO}\middle|T_{i}&gt;\frac{0.05d}{2\epsilon}\right)}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><msub><mi>ℙ</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><msub><mi>T</mi><mi>i</mi></msub><mo>&gt;</mo><mstyle displaystyle="true"><mfrac><mrow><mn>0.05</mn><mo lspace="0em" rspace="0em">​</mo><mi>d</mi></mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>ϵ</mi></mrow></mfrac></mstyle></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>ℙ</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><msub><mi class="ltx_font_mathcaligraphic">𝒜</mi><mi>s</mi></msub><mo>=</mo><mi>𝖭𝖮</mi></mrow><mo lspace="0em" rspace="0em" stretchy="true">|</mo><mrow><msub><mi>T</mi><mi>i</mi></msub><mo>&gt;</mo><mstyle displaystyle="true"><mfrac><mrow><mn>0.05</mn><mo lspace="0em" rspace="0em">​</mo><mi>d</mi></mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>ϵ</mi></mrow></mfrac></mstyle></mrow><mo>)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\mathbb{P}_{1}\mathinner{\left(T_{i}&gt;\frac{0.05d}{2\epsilon}\right)}\mathbb{P}\mathinner{\left(\mathcal{A}_{s}=\mathsf{NO}\middle|T_{i}&gt;\frac{0.05d}{2\epsilon}\right)}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A4.Ex147"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex147.m1" class="ltx_Math" alttext="\displaystyle\hskip 56.9055pt+\mathbb{P}_{1}\mathinner{\left(\mathsf{D}_{i}=\mathsf{NO}\right)}-\mathbb{P}_{1}\mathinner{\left(\mathinner{\left\{T_{i}&gt;\frac{0.05d}{2\epsilon}\right\}}\cap\mathinner{\left\{\mathsf{D}_{i}=\mathsf{NO}\right\}}\right)}" display="inline" intent=":literal"><semantics><mrow><mrow><mo>+</mo><mrow><msub><mi>ℙ</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><msub><mi>𝖣</mi><mi>i</mi></msub><mo>=</mo><mi>𝖭𝖮</mi></mrow><mo>)</mo></mrow></mrow></mrow><mo>−</mo><mrow><msub><mi>ℙ</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mrow><mo>{</mo><mi>T</mi><msub><mrow></mrow><mi>i</mi></msub><mo>&gt;</mo><mstyle displaystyle="true"><mfrac><mrow><mn>0.05</mn><mo lspace="0em" rspace="0em">​</mo><mi>d</mi></mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>ϵ</mi></mrow></mfrac></mstyle><mo>}</mo></mrow><mo>∩</mo><mrow><mo>{</mo><mi>𝖣</mi><msub><mrow></mrow><mi>i</mi></msub><mo>=</mo><mi>𝖭𝖮</mi><mo>}</mo></mrow></mrow><mo>)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\hskip 56.9055pt+\mathbb{P}_{1}\mathinner{\left(\mathsf{D}_{i}=\mathsf{NO}\right)}-\mathbb{P}_{1}\mathinner{\left(\mathinner{\left\{T_{i}&gt;\frac{0.05d}{2\epsilon}\right\}}\cap\mathinner{\left\{\mathsf{D}_{i}=\mathsf{NO}\right\}}\right)}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A4.Ex148"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex148.m1" class="ltx_Math" alttext="\displaystyle\geq\mathbb{P}_{1}\mathinner{\left(T_{i}&gt;\frac{0.05d}{2\epsilon}\right)}\mathbb{P}\mathinner{\left(\mathcal{A}_{s}=\mathsf{NO}\middle|T_{i}&gt;\frac{0.05d}{2\epsilon}\right)}+\mathbb{P}_{1}\mathinner{\left(\mathsf{D}_{i}=\mathsf{NO}\right)}-\mathbb{P}_{1}\mathinner{\left(T_{i}&gt;\frac{0.05d}{2\epsilon}\right)}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≥</mo><mrow><mrow><mrow><msub><mi>ℙ</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><msub><mi>T</mi><mi>i</mi></msub><mo>&gt;</mo><mstyle displaystyle="true"><mfrac><mrow><mn>0.05</mn><mo lspace="0em" rspace="0em">​</mo><mi>d</mi></mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>ϵ</mi></mrow></mfrac></mstyle></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>ℙ</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><msub><mi class="ltx_font_mathcaligraphic">𝒜</mi><mi>s</mi></msub><mo>=</mo><mi>𝖭𝖮</mi></mrow><mo lspace="0em" rspace="0em" stretchy="true">|</mo><mrow><msub><mi>T</mi><mi>i</mi></msub><mo>&gt;</mo><mstyle displaystyle="true"><mfrac><mrow><mn>0.05</mn><mo lspace="0em" rspace="0em">​</mo><mi>d</mi></mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>ϵ</mi></mrow></mfrac></mstyle></mrow><mo>)</mo></mrow></mrow><mo>+</mo><mrow><msub><mi>ℙ</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><msub><mi>𝖣</mi><mi>i</mi></msub><mo>=</mo><mi>𝖭𝖮</mi></mrow><mo>)</mo></mrow></mrow></mrow><mo>−</mo><mrow><msub><mi>ℙ</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><msub><mi>T</mi><mi>i</mi></msub><mo>&gt;</mo><mstyle displaystyle="true"><mfrac><mrow><mn>0.05</mn><mo lspace="0em" rspace="0em">​</mo><mi>d</mi></mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>ϵ</mi></mrow></mfrac></mstyle></mrow><mo>)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\geq\mathbb{P}_{1}\mathinner{\left(T_{i}&gt;\frac{0.05d}{2\epsilon}\right)}\mathbb{P}\mathinner{\left(\mathcal{A}_{s}=\mathsf{NO}\middle|T_{i}&gt;\frac{0.05d}{2\epsilon}\right)}+\mathbb{P}_{1}\mathinner{\left(\mathsf{D}_{i}=\mathsf{NO}\right)}-\mathbb{P}_{1}\mathinner{\left(T_{i}&gt;\frac{0.05d}{2\epsilon}\right)}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A4.Ex149"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex149.m1" class="ltx_Math" alttext="\displaystyle=\mathbb{P}_{1}\mathinner{\left(\mathsf{D}_{i}=\mathsf{NO}\right)}-\mathbb{P}_{1}\mathinner{\left(T_{i}&gt;\frac{0.05d}{2\epsilon}\right)}\mathbb{P}\mathinner{\left(\mathcal{A}_{s}=\mathsf{YES}\middle|T_{i}&gt;\frac{0.05d}{2\epsilon}\right)}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><msub><mi>ℙ</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><msub><mi>𝖣</mi><mi>i</mi></msub><mo>=</mo><mi>𝖭𝖮</mi></mrow><mo>)</mo></mrow></mrow><mo>−</mo><mrow><msub><mi>ℙ</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><msub><mi>T</mi><mi>i</mi></msub><mo>&gt;</mo><mstyle displaystyle="true"><mfrac><mrow><mn>0.05</mn><mo lspace="0em" rspace="0em">​</mo><mi>d</mi></mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>ϵ</mi></mrow></mfrac></mstyle></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>ℙ</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><msub><mi class="ltx_font_mathcaligraphic">𝒜</mi><mi>s</mi></msub><mo>=</mo><mi>𝖸𝖤𝖲</mi></mrow><mo lspace="0em" rspace="0em" stretchy="true">|</mo><mrow><msub><mi>T</mi><mi>i</mi></msub><mo>&gt;</mo><mstyle displaystyle="true"><mfrac><mrow><mn>0.05</mn><mo lspace="0em" rspace="0em">​</mo><mi>d</mi></mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>ϵ</mi></mrow></mfrac></mstyle></mrow><mo>)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\mathbb{P}_{1}\mathinner{\left(\mathsf{D}_{i}=\mathsf{NO}\right)}-\mathbb{P}_{1}\mathinner{\left(T_{i}&gt;\frac{0.05d}{2\epsilon}\right)}\mathbb{P}\mathinner{\left(\mathcal{A}_{s}=\mathsf{YES}\middle|T_{i}&gt;\frac{0.05d}{2\epsilon}\right)}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A4.Ex150"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex150.m1" class="ltx_Math" alttext="\displaystyle\geq 0.99-0.24" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≥</mo><mrow><mn>0.99</mn><mo>−</mo><mn>0.24</mn></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\geq 0.99-0.24</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A4.Ex151"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex151.m1" class="ltx_Math" alttext="\displaystyle=0.75" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mn>0.75</mn></mrow><annotation encoding="application/x-tex">\displaystyle=0.75</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="A4.SS6.SSS0.Px2.p2" class="ltx_para">
<p id="A4.SS6.SSS0.Px2.p2.1" class="ltx_p">Note that we only required <math id="A4.SS6.SSS0.Px2.p2.m1" class="ltx_Math" alttext="\mathsf{D}_{i}" display="inline" intent=":literal"><semantics><msub><mi>𝖣</mi><mi>i</mi></msub><annotation encoding="application/x-tex">\mathsf{D}_{i}</annotation></semantics></math> succeeding with high probability; this allows us to avoid union bounds over <math id="A4.SS6.SSS0.Px2.p2.m2" class="ltx_Math" alttext="i\in\mathinner{\left[k\right]}" display="inline" intent=":literal"><semantics><mrow><mi>i</mi><mo>∈</mo><mrow><mo>[</mo><mi>k</mi><mo>]</mo></mrow></mrow><annotation encoding="application/x-tex">i\in\mathinner{\left[k\right]}</annotation></semantics></math>. Since <math id="A4.SS6.SSS0.Px2.p2.m3" class="ltx_Math" alttext="\mathcal{A}_{s}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">𝒜</mi><mi>s</mi></msub><annotation encoding="application/x-tex">\mathcal{A}_{s}</annotation></semantics></math> always succeeds with a sample size smaller than the lower bound of <a href="#A4.Thmtheorem1" title="Theorem D.1. ‣ D.4 Proof of ‣ Appendix D Proofs of ‣ Is Multi-Distribution Learning as Easy as PAC Learning: Sharp Rates with Bounded Label Noise" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Theorem</span> <span class="ltx_text ltx_ref_tag">D.1</span></a>, we have thus shown that</p>
<table id="A4.EGx111" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A4.Ex152"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A4.Ex152.m1" class="ltx_Math" alttext="\displaystyle\mathbb{P}_{0}\mathinner{\left(T_{i}&gt;\frac{0.05d}{2\epsilon}\right)}&gt;0.3" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>ℙ</mi><mn>0</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><msub><mi>T</mi><mi>i</mi></msub><mo>&gt;</mo><mstyle displaystyle="true"><mfrac><mrow><mn>0.05</mn><mo lspace="0em" rspace="0em">​</mo><mi>d</mi></mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>ϵ</mi></mrow></mfrac></mstyle></mrow><mo>)</mo></mrow></mrow><mo>&gt;</mo><mn>0.3</mn></mrow><annotation encoding="application/x-tex">\displaystyle\mathbb{P}_{0}\mathinner{\left(T_{i}&gt;\frac{0.05d}{2\epsilon}\right)}&gt;0.3</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A4.SS6.SSS0.Px2.p2.2" class="ltx_p">which we can readily convert into an in-expectation bound:</p>
<table id="A4.EGx112" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A4.Ex153"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A4.Ex153.m1" class="ltx_Math" alttext="\displaystyle\mathbb{E}_{0}\mathinner{\left[T_{i}\right]}\geq\mathbb{E}_{0}\mathinner{\left[T_{i}\mathbb{I}\mathinner{\left\{T_{i}&gt;\frac{0.05d}{2\epsilon}\right\}}\right]}\geq\frac{0.05d}{2\epsilon}\mathbb{P}_{0}\mathinner{\left(T_{i}&gt;\frac{0.05d}{2\epsilon}\right)}&gt;\frac{0.015d}{2\epsilon}" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>𝔼</mi><mn>0</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><msub><mi>T</mi><mi>i</mi></msub><mo>]</mo></mrow></mrow><mo>≥</mo><mrow><msub><mi>𝔼</mi><mn>0</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><mrow><msub><mi>T</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi>𝕀</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo>{</mo><mi>T</mi><msub><mrow></mrow><mi>i</mi></msub><mo>&gt;</mo><mstyle displaystyle="true"><mfrac><mrow><mn>0.05</mn><mo lspace="0em" rspace="0em">​</mo><mi>d</mi></mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>ϵ</mi></mrow></mfrac></mstyle><mo>}</mo></mrow></mrow><mo>]</mo></mrow></mrow><mo>≥</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mn>0.05</mn><mo lspace="0em" rspace="0em">​</mo><mi>d</mi></mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>ϵ</mi></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msub><mi>ℙ</mi><mn>0</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><msub><mi>T</mi><mi>i</mi></msub><mo>&gt;</mo><mstyle displaystyle="true"><mfrac><mrow><mn>0.05</mn><mo lspace="0em" rspace="0em">​</mo><mi>d</mi></mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>ϵ</mi></mrow></mfrac></mstyle></mrow><mo>)</mo></mrow></mrow><mo>&gt;</mo><mstyle displaystyle="true"><mfrac><mrow><mn>0.015</mn><mo lspace="0em" rspace="0em">​</mo><mi>d</mi></mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>ϵ</mi></mrow></mfrac></mstyle></mrow><annotation encoding="application/x-tex">\displaystyle\mathbb{E}_{0}\mathinner{\left[T_{i}\right]}\geq\mathbb{E}_{0}\mathinner{\left[T_{i}\mathbb{I}\mathinner{\left\{T_{i}&gt;\frac{0.05d}{2\epsilon}\right\}}\right]}\geq\frac{0.05d}{2\epsilon}\mathbb{P}_{0}\mathinner{\left(T_{i}&gt;\frac{0.05d}{2\epsilon}\right)}&gt;\frac{0.015d}{2\epsilon}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A4.SS6.SSS0.Px2.p2.3" class="ltx_p">Since this must hold for every <math id="A4.SS6.SSS0.Px2.p2.m4" class="ltx_Math" alttext="i\in\mathinner{\left[k\right]}" display="inline" intent=":literal"><semantics><mrow><mi>i</mi><mo>∈</mo><mrow><mo>[</mo><mi>k</mi><mo>]</mo></mrow></mrow><annotation encoding="application/x-tex">i\in\mathinner{\left[k\right]}</annotation></semantics></math>, we can conclude that</p>
<table id="A4.EGx113" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A4.Ex154"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A4.Ex154.m1" class="ltx_Math" alttext="\displaystyle T_{\mathcal{A}}\mathinner{\left(\epsilon,0.01\right)}\geq\mathbb{E}_{0}\mathinner{\left[\sum_{i=1}^{k}T_{i}\right]}\geq\frac{0.015kd}{2\epsilon}" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>T</mi><mi class="ltx_font_mathcaligraphic">𝒜</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mi>ϵ</mi><mo>,</mo><mn>0.01</mn><mo>)</mo></mrow></mrow><mo>≥</mo><mrow><msub><mi>𝔼</mi><mn>0</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>k</mi></munderover></mstyle><msub><mi>T</mi><mi>i</mi></msub></mrow><mo>]</mo></mrow></mrow><mo>≥</mo><mstyle displaystyle="true"><mfrac><mrow><mn>0.015</mn><mo lspace="0em" rspace="0em">​</mo><mi>k</mi><mo lspace="0em" rspace="0em">​</mo><mi>d</mi></mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>ϵ</mi></mrow></mfrac></mstyle></mrow><annotation encoding="application/x-tex">\displaystyle T_{\mathcal{A}}\mathinner{\left(\epsilon,0.01\right)}\geq\mathbb{E}_{0}\mathinner{\left[\sum_{i=1}^{k}T_{i}\right]}\geq\frac{0.015kd}{2\epsilon}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A4.SS6.SSS0.Px2.p2.4" class="ltx_p">∎</p>
</div>
</section>
</section>
</section>
<section id="A5" class="ltx_appendix">
<h2 class="ltx_title ltx_title_appendix"><span class="ltx_tag ltx_tag_appendix">Appendix E </span>Proofs of <a href="#S5" title="5 MDL Lower Bound ‣ Is Multi-Distribution Learning as Easy as PAC Learning: Sharp Rates with Bounded Label Noise" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Section</span> <span class="ltx_text ltx_ref_tag">5</span></a></h2>

<section id="A5.SS1" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">E.1 </span>Proof of <a href="#S5.Thmtheorem1" title="Lemma 5.1 (MDL to MSHT upper bound). ‣ 5 MDL Lower Bound ‣ Is Multi-Distribution Learning as Easy as PAC Learning: Sharp Rates with Bounded Label Noise" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Lemma</span> <span class="ltx_text ltx_ref_tag">5.1</span></a></h3>

<div id="A5.SS1.p1" class="ltx_para">
<p id="A5.SS1.p1.1" class="ltx_p">Correctness of <math id="A5.SS1.p1.m1" class="ltx_Math" alttext="\mathcal{A}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">𝒜</mi><annotation encoding="application/x-tex">\mathcal{A}</annotation></semantics></math> implies that with probability at least <math id="A5.SS1.p1.m2" class="ltx_Math" alttext="1-\delta/3" display="inline" intent=":literal"><semantics><mrow><mn>1</mn><mo>−</mo><mrow><mi>δ</mi><mo>/</mo><mn>3</mn></mrow></mrow><annotation encoding="application/x-tex">1-\delta/3</annotation></semantics></math>, for all <math id="A5.SS1.p1.m3" class="ltx_Math" alttext="i\in\mathinner{\left[k\right]}" display="inline" intent=":literal"><semantics><mrow><mi>i</mi><mo>∈</mo><mrow><mo>[</mo><mi>k</mi><mo>]</mo></mrow></mrow><annotation encoding="application/x-tex">i\in\mathinner{\left[k\right]}</annotation></semantics></math>, <math id="A5.SS1.p1.m4" class="ltx_Math" alttext="\err\mathinner{\left(\hat{f}_{i};P_{i}\right)}\leq 1/4+\epsilon/48" display="inline" intent=":literal"><semantics><mrow><mrow><mi>err</mi><mo>⁡</mo><mrow><mo>(</mo><msub><mover accent="true"><mi>f</mi><mo>^</mo></mover><mi>i</mi></msub><mo>;</mo><msub><mi>P</mi><mi>i</mi></msub><mo>)</mo></mrow></mrow><mo>≤</mo><mrow><mrow><mn>1</mn><mo>/</mo><mn>4</mn></mrow><mo>+</mo><mrow><mi>ϵ</mi><mo>/</mo><mn>48</mn></mrow></mrow></mrow><annotation encoding="application/x-tex">\err\mathinner{\left(\hat{f}_{i};P_{i}\right)}\leq 1/4+\epsilon/48</annotation></semantics></math>. <a href="#S4.Thmtheorem2" title="Lemma 4.2 (From learning to testing). ‣ Learning-Augmented Testing. ‣ 4.1 () Upper Bounds ‣ 4 Structured Hypothesis Testing ‣ Is Multi-Distribution Learning as Easy as PAC Learning: Sharp Rates with Bounded Label Noise" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Lemma</span> <span class="ltx_text ltx_ref_tag">4.2</span></a> then shows that <math id="A5.SS1.p1.m5" class="ltx_Math" alttext="\mathsf{D}_{i}" display="inline" intent=":literal"><semantics><msub><mi>𝖣</mi><mi>i</mi></msub><annotation encoding="application/x-tex">\mathsf{D}_{i}</annotation></semantics></math> is correct with probability <math id="A5.SS1.p1.m6" class="ltx_Math" alttext="1-\delta" display="inline" intent=":literal"><semantics><mrow><mn>1</mn><mo>−</mo><mi>δ</mi></mrow><annotation encoding="application/x-tex">1-\delta</annotation></semantics></math>, for each <math id="A5.SS1.p1.m7" class="ltx_Math" alttext="i\in\mathinner{\left[k\right]}" display="inline" intent=":literal"><semantics><mrow><mi>i</mi><mo>∈</mo><mrow><mo>[</mo><mi>k</mi><mo>]</mo></mrow></mrow><annotation encoding="application/x-tex">i\in\mathinner{\left[k\right]}</annotation></semantics></math>.</p>
</div>
</section>
<section id="A5.SS2" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">E.2 </span>Proof of <a href="#S5.Thmtheorem2" title="Theorem 5.2 (MDL lower bound). ‣ 5 MDL Lower Bound ‣ Is Multi-Distribution Learning as Easy as PAC Learning: Sharp Rates with Bounded Label Noise" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Theorem</span> <span class="ltx_text ltx_ref_tag">5.2</span></a></h3>

<div id="A5.SS2.p1" class="ltx_para">
<p id="A5.SS2.p1.1" class="ltx_p">The <math id="A5.SS2.p1.m1" class="ltx_Math" alttext="\Omega\mathinner{\left(d/\epsilon\right)}" display="inline" intent=":literal"><semantics><mrow><mi mathvariant="normal">Ω</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mi>d</mi><mo>/</mo><mi>ϵ</mi></mrow><mo>)</mo></mrow></mrow><annotation encoding="application/x-tex">\Omega\mathinner{\left(d/\epsilon\right)}</annotation></semantics></math> term follows from the single-distribution learning lower bound (e.g., see Theorem 6.8 of <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib3" title="" class="ltx_ref">36</a>]</cite>). For the second term, we can apply <a href="#S5.Thmtheorem1" title="Lemma 5.1 (MDL to MSHT upper bound). ‣ 5 MDL Lower Bound ‣ Is Multi-Distribution Learning as Easy as PAC Learning: Sharp Rates with Bounded Label Noise" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Lemma</span> <span class="ltx_text ltx_ref_tag">5.1</span></a> to an MDL algorithm <math id="A5.SS2.p1.m2" class="ltx_Math" alttext="\mathcal{A}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">𝒜</mi><annotation encoding="application/x-tex">\mathcal{A}</annotation></semantics></math> and the (<a href="#S4.Ex46" title="Equation MSHT ‣ 4.3 Multi-Distribution SHT ‣ 4 Structured Hypothesis Testing ‣ Is Multi-Distribution Learning as Easy as PAC Learning: Sharp Rates with Bounded Label Noise" class="ltx_ref"><span class="ltx_text ltx_ref_tag">MSHT</span></a>) lower bound of <a href="#S4.Thmtheorem6" title="Theorem 4.6 (Multi-Distribution SHT lower bound). ‣ 4.3 Multi-Distribution SHT ‣ 4 Structured Hypothesis Testing ‣ Is Multi-Distribution Learning as Easy as PAC Learning: Sharp Rates with Bounded Label Noise" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Theorem</span> <span class="ltx_text ltx_ref_tag">4.6</span></a> to conclude that</p>
<table id="A5.EGx114" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A5.Ex155"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A5.Ex155.m1" class="ltx_Math" alttext="\displaystyle T_{\mathcal{A}}\mathinner{\left(\epsilon,\frac{0.01}{3}\right)}+\frac{4k\log\mathinner{\left(600\right)}}{\epsilon}=T_{\mathcal{A}\to\mathsf{MSHT}}\mathinner{\left(48\epsilon,0.01\right)}\geq\frac{0.015k}{9216}\min\mathinner{\left\{\frac{1}{\epsilon^{2}},\frac{d}{\epsilon}\right\}}" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><msub><mi>T</mi><mi class="ltx_font_mathcaligraphic">𝒜</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mi>ϵ</mi><mo>,</mo><mstyle displaystyle="true"><mfrac><mn>0.01</mn><mn>3</mn></mfrac></mstyle><mo>)</mo></mrow></mrow><mo>+</mo><mstyle displaystyle="true"><mfrac><mrow><mn>4</mn><mo lspace="0em" rspace="0em">​</mo><mi>k</mi><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>log</mi><mo>⁡</mo><mrow><mo>(</mo><mn>600</mn><mo>)</mo></mrow></mrow></mrow><mi>ϵ</mi></mfrac></mstyle></mrow><mo>=</mo><mrow><msub><mi>T</mi><mrow><mi class="ltx_font_mathcaligraphic">𝒜</mi><mo stretchy="false">→</mo><mi>𝖬𝖲𝖧𝖳</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mn>48</mn><mo lspace="0em" rspace="0em">​</mo><mi>ϵ</mi></mrow><mo>,</mo><mn>0.01</mn><mo>)</mo></mrow></mrow><mo>≥</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mn>0.015</mn><mo lspace="0em" rspace="0em">​</mo><mi>k</mi></mrow><mn>9216</mn></mfrac></mstyle><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>min</mi><mo>⁡</mo><mrow><mo>{</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><msup><mi>ϵ</mi><mn>2</mn></msup></mfrac></mstyle><mo>,</mo><mstyle displaystyle="true"><mfrac><mi>d</mi><mi>ϵ</mi></mfrac></mstyle><mo>}</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle T_{\mathcal{A}}\mathinner{\left(\epsilon,\frac{0.01}{3}\right)}+\frac{4k\log\mathinner{\left(600\right)}}{\epsilon}=T_{\mathcal{A}\to\mathsf{MSHT}}\mathinner{\left(48\epsilon,0.01\right)}\geq\frac{0.015k}{9216}\min\mathinner{\left\{\frac{1}{\epsilon^{2}},\frac{d}{\epsilon}\right\}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A5.SS2.p1.2" class="ltx_p">Rearranging under the lower bound on <math id="A5.SS2.p1.m3" class="ltx_Math" alttext="\min\mathinner{\left\{d,1/\epsilon\right\}}" display="inline" intent=":literal"><semantics><mrow><mi>min</mi><mo>⁡</mo><mrow><mo>{</mo><mi>d</mi><mo>,</mo><mrow><mn>1</mn><mo>/</mo><mi>ϵ</mi></mrow><mo>}</mo></mrow></mrow><annotation encoding="application/x-tex">\min\mathinner{\left\{d,1/\epsilon\right\}}</annotation></semantics></math> then yields the claim.</p>
</div>
</section>
</section>
<section id="A6" class="ltx_appendix">
<h2 class="ltx_title ltx_title_appendix"><span class="ltx_tag ltx_tag_appendix">Appendix F </span>Proofs of <a href="#S6" title="6 () Lower Bound ‣ Is Multi-Distribution Learning as Easy as PAC Learning: Sharp Rates with Bounded Label Noise" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Section</span> <span class="ltx_text ltx_ref_tag">6</span></a></h2>

<div id="A6.p1" class="ltx_para">
<p id="A6.p1.1" class="ltx_p">In this section, we prove the (<a href="#S1.Ex5" title="Equation MDL-Mass ‣ Massart. ‣ 1.1 Problem Setup ‣ 1 Introduction ‣ Is Multi-Distribution Learning as Easy as PAC Learning: Sharp Rates with Bounded Label Noise" class="ltx_ref"><span class="ltx_text ltx_ref_tag">MDL-Mass</span></a>) lower bound of <math id="A6.p1.m1" class="ltx_Math" alttext="\Omega\mathinner{\left(k\sqrt{d}/\epsilon\right)}" display="inline" intent=":literal"><semantics><mrow><mi mathvariant="normal">Ω</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mrow><mi>k</mi><mo lspace="0em" rspace="0em">​</mo><msqrt><mi>d</mi></msqrt></mrow><mo>/</mo><mi>ϵ</mi></mrow><mo>)</mo></mrow></mrow><annotation encoding="application/x-tex">\Omega\mathinner{\left(k\sqrt{d}/\epsilon\right)}</annotation></semantics></math>. We begin by establishing a preliminary lower bound for the testing problem (<a href="#S6.Ex55" title="Equation SHT-Mass ‣ 6.1 Massart Testing ‣ 6 () Lower Bound ‣ Is Multi-Distribution Learning as Easy as PAC Learning: Sharp Rates with Bounded Label Noise" class="ltx_ref"><span class="ltx_text ltx_ref_tag">SHT-Mass</span></a>), and then show how it implies the (<a href="#S1.Ex5" title="Equation MDL-Mass ‣ Massart. ‣ 1.1 Problem Setup ‣ 1 Introduction ‣ Is Multi-Distribution Learning as Easy as PAC Learning: Sharp Rates with Bounded Label Noise" class="ltx_ref"><span class="ltx_text ltx_ref_tag">MDL-Mass</span></a>) lower bound.</p>
</div>
<section id="A6.SS1" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">F.1 </span>Proof of <a href="#S6.Thmtheorem1" title="Theorem 6.1 (SHT-Mass lower bound). ‣ 6.1 Massart Testing ‣ 6 () Lower Bound ‣ Is Multi-Distribution Learning as Easy as PAC Learning: Sharp Rates with Bounded Label Noise" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Theorem</span> <span class="ltx_text ltx_ref_tag">6.1</span></a></h3>

<div id="A6.SS1.p1" class="ltx_para">
<p id="A6.SS1.p1.1" class="ltx_p">We will apply the technique of <span id="A6.SS1.p1.1.1" class="ltx_text ltx_font_italic">Poissonization</span>: instead of sampling a deterministic number of times <math id="A6.SS1.p1.m1" class="ltx_Math" alttext="T" display="inline" intent=":literal"><semantics><mi>T</mi><annotation encoding="application/x-tex">T</annotation></semantics></math>, we will sample <math id="A6.SS1.p1.m2" class="ltx_Math" alttext="N\sim\Pois\mathinner{\left(T\right)}" display="inline" intent=":literal"><semantics><mrow><mi>N</mi><mo>∼</mo><mrow><mi>Pois</mi><mo>⁡</mo><mrow><mo>(</mo><mi>T</mi><mo>)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">N\sim\Pois\mathinner{\left(T\right)}</annotation></semantics></math> pairs <math id="A6.SS1.p1.m3" class="ltx_Math" alttext="\mathinner{\left(X_{t},Y_{t}\right)}" display="inline" intent=":literal"><semantics><mrow><mo>(</mo><msub><mi>X</mi><mi>t</mi></msub><mo>,</mo><msub><mi>Y</mi><mi>t</mi></msub><mo>)</mo></mrow><annotation encoding="application/x-tex">\mathinner{\left(X_{t},Y_{t}\right)}</annotation></semantics></math> and must ensure the same guarantee as (<a href="#S6.Ex55" title="Equation SHT-Mass ‣ 6.1 Massart Testing ‣ 6 () Lower Bound ‣ Is Multi-Distribution Learning as Easy as PAC Learning: Sharp Rates with Bounded Label Noise" class="ltx_ref"><span class="ltx_text ltx_ref_tag">SHT-Mass</span></a>). We will first show a lower bound for the Poissonized variant and subsequently relate it back to the original setup.</p>
</div>
<div id="A6.SS1.p2" class="ltx_para">
<p id="A6.SS1.p2.1" class="ltx_p">Let us define the count of <math id="A6.SS1.p2.m1" class="ltx_Math" alttext="\mathinner{\left(x,1\right)}" display="inline" intent=":literal"><semantics><mrow><mo>(</mo><mi>x</mi><mo>,</mo><mn>1</mn><mo>)</mo></mrow><annotation encoding="application/x-tex">\mathinner{\left(x,1\right)}</annotation></semantics></math> and <math id="A6.SS1.p2.m2" class="ltx_Math" alttext="\mathinner{\left(x,0\right)}" display="inline" intent=":literal"><semantics><mrow><mo>(</mo><mi>x</mi><mo>,</mo><mn>0</mn><mo>)</mo></mrow><annotation encoding="application/x-tex">\mathinner{\left(x,0\right)}</annotation></semantics></math> observations:</p>
<table id="A6.EGx115" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A6.Ex156"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A6.Ex156.m1" class="ltx_Math" alttext="\displaystyle N_{x}\coloneqq\sum_{t=1}^{N}\mathbb{I}\mathinner{\left\{X_{t}=x,Y_{t}=1\right\}}\quad\text{and}\quad M_{x}\coloneqq\sum_{t=1}^{N}\mathbb{I}\mathinner{\left\{X_{t}=x,Y_{t}=0\right\}}" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>N</mi><mi>x</mi></msub><mo>≔</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>t</mi><mo>=</mo><mn>1</mn></mrow><mi>N</mi></munderover></mstyle><mrow><mi>𝕀</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo>{</mo><mrow><mrow><msub><mi>X</mi><mi>t</mi></msub><mo>=</mo><mi>x</mi></mrow><mo>,</mo><mrow><msub><mi>Y</mi><mi>t</mi></msub><mo>=</mo><mn>1</mn></mrow></mrow><mo>}</mo></mrow></mrow></mrow></mrow><mspace style="width:1em;" width="1em"></mspace><mtext>and</mtext><mspace style="width:1em;" width="1em"></mspace><mrow><msub><mi>M</mi><mi>x</mi></msub><mo>≔</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>t</mi><mo>=</mo><mn>1</mn></mrow><mi>N</mi></munderover></mstyle><mrow><mi>𝕀</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo>{</mo><mrow><mrow><msub><mi>X</mi><mi>t</mi></msub><mo>=</mo><mi>x</mi></mrow><mo>,</mo><mrow><msub><mi>Y</mi><mi>t</mi></msub><mo>=</mo><mn>0</mn></mrow></mrow><mo>}</mo></mrow></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle N_{x}\coloneqq\sum_{t=1}^{N}\mathbb{I}\mathinner{\left\{X_{t}=x,Y_{t}=1\right\}}\quad\text{and}\quad M_{x}\coloneqq\sum_{t=1}^{N}\mathbb{I}\mathinner{\left\{X_{t}=x,Y_{t}=0\right\}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A6.SS1.p2.2" class="ltx_p">We will work with random <math id="A6.SS1.p2.m3" class="ltx_Math" alttext="\mathbf{q}" display="inline" intent=":literal"><semantics><mi>𝐪</mi><annotation encoding="application/x-tex">\mathbf{q}</annotation></semantics></math>, independent of <math id="A6.SS1.p2.m4" class="ltx_Math" alttext="N" display="inline" intent=":literal"><semantics><mi>N</mi><annotation encoding="application/x-tex">N</annotation></semantics></math>, in which case we can ensure that</p>
<table id="A6.EGx116" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A6.Ex157"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A6.Ex157.m1" class="ltx_Math" alttext="\displaystyle N_{x}|\mathbf{q}\sim\Pois\mathinner{\left(Tp_{X}\mathinner{\left(x\right)}q_{x}\right)}\quad\text{and}\quad M_{x}|\mathbf{q}\sim\Pois\mathinner{\left(Tp_{X}\mathinner{\left(x\right)}\mathinner{\left(1-q_{x}\right)}\right)}" display="inline" intent=":literal"><semantics><mrow><msub><mi>N</mi><mi>x</mi></msub><mo fence="false">|</mo><mrow><mrow><mi>𝐪</mi><mo>∼</mo><mrow><mi>Pois</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mi>T</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>p</mi><mi>X</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mi>x</mi><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>q</mi><mi>x</mi></msub></mrow><mo>)</mo></mrow></mrow></mrow><mspace style="width:1em;" width="1em"></mspace><mtext>and</mtext><mspace style="width:1em;" width="1em"></mspace><mrow><msub><mi>M</mi><mi>x</mi></msub><mo fence="false">|</mo><mrow><mi>𝐪</mi><mo>∼</mo><mrow><mi>Pois</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mi>T</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>p</mi><mi>X</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mi>x</mi><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mn>1</mn><mo>−</mo><msub><mi>q</mi><mi>x</mi></msub></mrow><mo>)</mo></mrow></mrow><mo>)</mo></mrow></mrow></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle N_{x}|\mathbf{q}\sim\Pois\mathinner{\left(Tp_{X}\mathinner{\left(x\right)}q_{x}\right)}\quad\text{and}\quad M_{x}|\mathbf{q}\sim\Pois\mathinner{\left(Tp_{X}\mathinner{\left(x\right)}\mathinner{\left(1-q_{x}\right)}\right)}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A6.SS1.p2.3" class="ltx_p">and are independent conditional on <math id="A6.SS1.p2.m5" class="ltx_Math" alttext="\mathbf{q}" display="inline" intent=":literal"><semantics><mi>𝐪</mi><annotation encoding="application/x-tex">\mathbf{q}</annotation></semantics></math>. Also, note that <math id="A6.SS1.p2.m6" class="ltx_Math" alttext="N_{x}+M_{x}=\sum_{t=1}^{N}\mathbb{I}\mathinner{\left\{X_{t}=x\right\}}\sim\Pois\mathinner{\left(Tp_{X}\mathinner{\left(x\right)}\right)}" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>N</mi><mi>x</mi></msub><mo>+</mo><msub><mi>M</mi><mi>x</mi></msub></mrow><mo rspace="0.111em">=</mo><mrow><msubsup><mo>∑</mo><mrow><mi>t</mi><mo>=</mo><mn>1</mn></mrow><mi>N</mi></msubsup><mrow><mi>𝕀</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo>{</mo><mi>X</mi><msub><mrow></mrow><mi>t</mi></msub><mo>=</mo><mi>x</mi><mo>}</mo></mrow></mrow></mrow><mo>∼</mo><mrow><mi>Pois</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mi>T</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>p</mi><mi>X</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mi>x</mi><mo>)</mo></mrow></mrow><mo>)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">N_{x}+M_{x}=\sum_{t=1}^{N}\mathbb{I}\mathinner{\left\{X_{t}=x\right\}}\sim\Pois\mathinner{\left(Tp_{X}\mathinner{\left(x\right)}\right)}</annotation></semantics></math> and is independent of <math id="A6.SS1.p2.m7" class="ltx_Math" alttext="\mathbf{q}" display="inline" intent=":literal"><semantics><mi>𝐪</mi><annotation encoding="application/x-tex">\mathbf{q}</annotation></semantics></math>.</p>
</div>
<div id="A6.SS1.p3" class="ltx_para">
<p id="A6.SS1.p3.1" class="ltx_p">The next step is to construct appropriate biases for each hypothesis. For <math id="A6.SS1.p3.m1" class="ltx_Math" alttext="H_{0}" display="inline" intent=":literal"><semantics><msub><mi>H</mi><mn>0</mn></msub><annotation encoding="application/x-tex">H_{0}</annotation></semantics></math>, we will simply define the constant vector <math id="A6.SS1.p3.m2" class="ltx_Math" alttext="\mathbf{q}_{0}\coloneqq\mathinner{\left(0.465,\dots,0.465\right)}" display="inline" intent=":literal"><semantics><mrow><msub><mi>𝐪</mi><mn>0</mn></msub><mo>≔</mo><mrow><mo>(</mo><mn>0.465</mn><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mn>0.465</mn><mo>)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathbf{q}_{0}\coloneqq\mathinner{\left(0.465,\dots,0.465\right)}</annotation></semantics></math>. For <math id="A6.SS1.p3.m3" class="ltx_Math" alttext="H_{1}" display="inline" intent=":literal"><semantics><msub><mi>H</mi><mn>1</mn></msub><annotation encoding="application/x-tex">H_{1}</annotation></semantics></math>, we define the prior <math id="A6.SS1.p3.m4" class="ltx_Math" alttext="\mu_{1}\coloneqq 0.75\cdot\Ber\mathinner{\left(0.62\right)}" display="inline" intent=":literal"><semantics><mrow><msub><mi>μ</mi><mn>1</mn></msub><mo>≔</mo><mrow><mn>0.75</mn><mo lspace="0.222em" rspace="0.222em">⋅</mo><mrow><mi>Ber</mi><mo>⁡</mo><mrow><mo>(</mo><mn>0.62</mn><mo>)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\mu_{1}\coloneqq 0.75\cdot\Ber\mathinner{\left(0.62\right)}</annotation></semantics></math> and set <math id="A6.SS1.p3.m5" class="ltx_Math" alttext="\mathbf{q}_{1}\sim\delta_{0.465}\times\mu_{1}^{d}" display="inline" intent=":literal"><semantics><mrow><msub><mi>𝐪</mi><mn>1</mn></msub><mo>∼</mo><mrow><msub><mi>δ</mi><mn>0.465</mn></msub><mo lspace="0.222em" rspace="0.222em">×</mo><msubsup><mi>μ</mi><mn>1</mn><mi>d</mi></msubsup></mrow></mrow><annotation encoding="application/x-tex">\mathbf{q}_{1}\sim\delta_{0.465}\times\mu_{1}^{d}</annotation></semantics></math>. In other words, the <math id="A6.SS1.p3.m6" class="ltx_Math" alttext="0" display="inline" intent=":literal"><semantics><mn>0</mn><annotation encoding="application/x-tex">0</annotation></semantics></math>th coordinate is always <math id="A6.SS1.p3.m7" class="ltx_Math" alttext="0.465" display="inline" intent=":literal"><semantics><mn>0.465</mn><annotation encoding="application/x-tex">0.465</annotation></semantics></math>, and the rest are sampled i.i.d. from <math id="A6.SS1.p3.m8" class="ltx_Math" alttext="\mu_{1}" display="inline" intent=":literal"><semantics><msub><mi>μ</mi><mn>1</mn></msub><annotation encoding="application/x-tex">\mu_{1}</annotation></semantics></math>. One important consequence of this construction is that the first moments match:</p>
<table id="A6.EGx117" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A6.Ex158"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A6.Ex158.m1" class="ltx_Math" alttext="\displaystyle\mathbb{E}_{q\sim\mu_{1}}\mathinner{\left[q\right]}=0.75\cdot 0.62=0.465=\mathbb{E}_{q\sim\mu_{0}}\mathinner{\left[q\right]}" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>𝔼</mi><mrow><mi>q</mi><mo>∼</mo><msub><mi>μ</mi><mn>1</mn></msub></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><mi>q</mi><mo>]</mo></mrow></mrow><mo>=</mo><mrow><mn>0.75</mn><mo lspace="0.222em" rspace="0.222em">⋅</mo><mn>0.62</mn></mrow><mo>=</mo><mn>0.465</mn><mo>=</mo><mrow><msub><mi>𝔼</mi><mrow><mi>q</mi><mo>∼</mo><msub><mi>μ</mi><mn>0</mn></msub></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><mi>q</mi><mo>]</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\mathbb{E}_{q\sim\mu_{1}}\mathinner{\left[q\right]}=0.75\cdot 0.62=0.465=\mathbb{E}_{q\sim\mu_{0}}\mathinner{\left[q\right]}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A6.SS1.p3.2" class="ltx_p">where <math id="A6.SS1.p3.m9" class="ltx_Math" alttext="\mu_{0}\coloneqq\delta_{0.465}" display="inline" intent=":literal"><semantics><mrow><msub><mi>μ</mi><mn>0</mn></msub><mo>≔</mo><msub><mi>δ</mi><mn>0.465</mn></msub></mrow><annotation encoding="application/x-tex">\mu_{0}\coloneqq\delta_{0.465}</annotation></semantics></math>.</p>
</div>
<div id="A6.SS1.p4" class="ltx_para">
<p id="A6.SS1.p4.1" class="ltx_p">While <math id="A6.SS1.p4.m1" class="ltx_Math" alttext="\mathbf{q}_{0}" display="inline" intent=":literal"><semantics><msub><mi>𝐪</mi><mn>0</mn></msub><annotation encoding="application/x-tex">\mathbf{q}_{0}</annotation></semantics></math> falls under <math id="A6.SS1.p4.m2" class="ltx_Math" alttext="H_{0}" display="inline" intent=":literal"><semantics><msub><mi>H</mi><mn>0</mn></msub><annotation encoding="application/x-tex">H_{0}</annotation></semantics></math> with probability <math id="A6.SS1.p4.m3" class="ltx_Math" alttext="1" display="inline" intent=":literal"><semantics><mn>1</mn><annotation encoding="application/x-tex">1</annotation></semantics></math>, we can only ensure a high-probability guarantee for <math id="A6.SS1.p4.m4" class="ltx_Math" alttext="\mathbf{q}_{1}" display="inline" intent=":literal"><semantics><msub><mi>𝐪</mi><mn>1</mn></msub><annotation encoding="application/x-tex">\mathbf{q}_{1}</annotation></semantics></math>. Since</p>
<table id="A6.EGx118" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A6.Ex159"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A6.Ex159.m1" class="ltx_Math" alttext="\displaystyle\mathbb{E}\mathinner{\left[\Delta_{\mathbf{q}_{1}}\right]}=\frac{\epsilon}{d}\cdot d\cdot 0.62\cdot 0.5=0.31\epsilon" display="inline" intent=":literal"><semantics><mrow><mrow><mi>𝔼</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><msub><mi mathvariant="normal">Δ</mi><msub><mi>𝐪</mi><mn>1</mn></msub></msub><mo>]</mo></mrow></mrow><mo>=</mo><mrow><mstyle displaystyle="true"><mfrac><mi>ϵ</mi><mi>d</mi></mfrac></mstyle><mo lspace="0.222em" rspace="0.222em">⋅</mo><mi>d</mi><mo lspace="0.222em" rspace="0.222em">⋅</mo><mn>0.62</mn><mo lspace="0.222em" rspace="0.222em">⋅</mo><mn>0.5</mn></mrow><mo>=</mo><mrow><mn>0.31</mn><mo lspace="0em" rspace="0em">​</mo><mi>ϵ</mi></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\mathbb{E}\mathinner{\left[\Delta_{\mathbf{q}_{1}}\right]}=\frac{\epsilon}{d}\cdot d\cdot 0.62\cdot 0.5=0.31\epsilon</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A6.SS1.p4.2" class="ltx_p">we can apply Hoeffding’s inequality (note that <math id="A6.SS1.p4.m5" class="ltx_Math" alttext="\Delta_{\mathbf{q}_{1}}\in\mathinner{\left[0,\epsilon/2\right]}" display="inline" intent=":literal"><semantics><mrow><msub><mi mathvariant="normal">Δ</mi><msub><mi>𝐪</mi><mn>1</mn></msub></msub><mo>∈</mo><mrow><mo>[</mo><mn>0</mn><mo>,</mo><mrow><mi>ϵ</mi><mo>/</mo><mn>2</mn></mrow><mo>]</mo></mrow></mrow><annotation encoding="application/x-tex">\Delta_{\mathbf{q}_{1}}\in\mathinner{\left[0,\epsilon/2\right]}</annotation></semantics></math>) to conclude that</p>
<table id="A6.EGx119" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A6.Ex160"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A6.Ex160.m1" class="ltx_Math" alttext="\displaystyle\mathbb{P}\mathinner{\left(\Delta_{\mathbf{q}_{1}}\geq 0.3\epsilon\right)}" display="inline" intent=":literal"><semantics><mrow><mi>ℙ</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><msub><mi mathvariant="normal">Δ</mi><msub><mi>𝐪</mi><mn>1</mn></msub></msub><mo>≥</mo><mrow><mn>0.3</mn><mo lspace="0em" rspace="0em">​</mo><mi>ϵ</mi></mrow></mrow><mo>)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\mathbb{P}\mathinner{\left(\Delta_{\mathbf{q}_{1}}\geq 0.3\epsilon\right)}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A6.Ex160.m2" class="ltx_Math" alttext="\displaystyle=\mathbb{P}\mathinner{\left(\Delta_{\mathbf{q}_{1}}-\mathbb{E}\mathinner{\left[\Delta_{\mathbf{q}_{1}}\right]}\geq-0.01\epsilon\right)}\geq 1-\exp\mathinner{\left(-0.0008d\right)}\geq\frac{3}{4}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mi>ℙ</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mrow><msub><mi mathvariant="normal">Δ</mi><msub><mi>𝐪</mi><mn>1</mn></msub></msub><mo>−</mo><mrow><mi>𝔼</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><msub><mi mathvariant="normal">Δ</mi><msub><mi>𝐪</mi><mn>1</mn></msub></msub><mo>]</mo></mrow></mrow></mrow><mo>≥</mo><mrow><mo>−</mo><mrow><mn>0.01</mn><mo lspace="0em" rspace="0em">​</mo><mi>ϵ</mi></mrow></mrow></mrow><mo>)</mo></mrow></mrow><mo>≥</mo><mrow><mn>1</mn><mo>−</mo><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mo>−</mo><mrow><mn>0.0008</mn><mo lspace="0em" rspace="0em">​</mo><mi>d</mi></mrow></mrow><mo>)</mo></mrow></mrow></mrow><mo>≥</mo><mstyle displaystyle="true"><mfrac><mn>3</mn><mn>4</mn></mfrac></mstyle></mrow><annotation encoding="application/x-tex">\displaystyle=\mathbb{P}\mathinner{\left(\Delta_{\mathbf{q}_{1}}-\mathbb{E}\mathinner{\left[\Delta_{\mathbf{q}_{1}}\right]}\geq-0.01\epsilon\right)}\geq 1-\exp\mathinner{\left(-0.0008d\right)}\geq\frac{3}{4}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A6.SS1.p4.3" class="ltx_p">Under hypothesis <math id="A6.SS1.p4.m6" class="ltx_Math" alttext="h\in\mathinner{\left\{0,1\right\}}" display="inline" intent=":literal"><semantics><mrow><mi>h</mi><mo>∈</mo><mrow><mo>{</mo><mn>0</mn><mo>,</mo><mn>1</mn><mo>}</mo></mrow></mrow><annotation encoding="application/x-tex">h\in\mathinner{\left\{0,1\right\}}</annotation></semantics></math>, our decision is based on observations <math id="A6.SS1.p4.m7" class="ltx_Math" alttext="O_{h}\coloneqq\mathinner{\left(N,\mathinner{\left(X_{t},Y_{t}\right)}_{t=1}^{N}\right)}\sim P_{h}^{O}" display="inline" intent=":literal"><semantics><mrow><msub><mi>O</mi><mi>h</mi></msub><mo>≔</mo><mrow><mo>(</mo><mi>N</mi><mo>,</mo><msubsup><mrow><mo>(</mo><msub><mi>X</mi><mi>t</mi></msub><mo>,</mo><msub><mi>Y</mi><mi>t</mi></msub><mo>)</mo></mrow><mrow><mi>t</mi><mo>=</mo><mn>1</mn></mrow><mi>N</mi></msubsup><mo>)</mo></mrow><mo>∼</mo><msubsup><mi>P</mi><mi>h</mi><mi>O</mi></msubsup></mrow><annotation encoding="application/x-tex">O_{h}\coloneqq\mathinner{\left(N,\mathinner{\left(X_{t},Y_{t}\right)}_{t=1}^{N}\right)}\sim P_{h}^{O}</annotation></semantics></math>. Our objective requires that <math id="A6.SS1.p4.m8" class="ltx_Math" alttext="P_{0}^{O}\mathinner{\left(\mathsf{YES}\right)}\geq 3/4" display="inline" intent=":literal"><semantics><mrow><mrow><msubsup><mi>P</mi><mn>0</mn><mi>O</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mi>𝖸𝖤𝖲</mi><mo>)</mo></mrow></mrow><mo>≥</mo><mrow><mn>3</mn><mo>/</mo><mn>4</mn></mrow></mrow><annotation encoding="application/x-tex">P_{0}^{O}\mathinner{\left(\mathsf{YES}\right)}\geq 3/4</annotation></semantics></math>, since the bias vector is deterministic under our constructed <math id="A6.SS1.p4.m9" class="ltx_Math" alttext="H_{0}" display="inline" intent=":literal"><semantics><msub><mi>H</mi><mn>0</mn></msub><annotation encoding="application/x-tex">H_{0}</annotation></semantics></math>. Furthermore, defining the event <math id="A6.SS1.p4.m10" class="ltx_Math" alttext="A\coloneqq\mathinner{\left\{\Delta_{\mathbf{q}_{1}}\geq 0.3\epsilon\right\}}" display="inline" intent=":literal"><semantics><mrow><mi>A</mi><mo>≔</mo><mrow><mo>{</mo><mi mathvariant="normal">Δ</mi><msub><mrow></mrow><msub><mi>𝐪</mi><mn>1</mn></msub></msub><mo>≥</mo><mn>0.3</mn><mi>ϵ</mi><mo>}</mo></mrow></mrow><annotation encoding="application/x-tex">A\coloneqq\mathinner{\left\{\Delta_{\mathbf{q}_{1}}\geq 0.3\epsilon\right\}}</annotation></semantics></math>, we must also satisfy</p>
<table id="A6.EGx120" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A6.Ex161"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A6.Ex161.m1" class="ltx_Math" alttext="\displaystyle P_{1}^{O}\mathinner{\left(\mathsf{YES}\right)}=\underbrace{P_{1}^{O}\mathinner{\left(\mathsf{YES}|A\right)}}_{\leq 1/4}P_{1}^{O}\mathinner{\left(A\right)}+P_{1}^{O}\mathinner{\left(\mathsf{YES}\middle|A^{c}\right)}\underbrace{P_{1}^{O}\mathinner{\left(A^{c}\right)}}_{\leq 1/4}\leq\frac{1}{2}" display="inline" intent=":literal"><semantics><mrow><mrow><msubsup><mi>P</mi><mn>1</mn><mi>O</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mi>𝖸𝖤𝖲</mi><mo>)</mo></mrow></mrow><mo>=</mo><mrow><mrow><munder><munder accentunder="true"><mrow><msubsup><mi>P</mi><mn>1</mn><mi>O</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mi>𝖸𝖤𝖲</mi><mo lspace="0em" rspace="0em">|</mo><mi>A</mi><mo>)</mo></mrow></mrow><mo stretchy="true">⏟</mo></munder><mrow><mphantom></mphantom><mo>≤</mo><mrow><mn>1</mn><mo>/</mo><mn>4</mn></mrow></mrow></munder><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>P</mi><mn>1</mn><mi>O</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mi>A</mi><mo>)</mo></mrow></mrow><mo>+</mo><mrow><msubsup><mi>P</mi><mn>1</mn><mi>O</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mi>𝖸𝖤𝖲</mi><mo lspace="0em" rspace="0em" stretchy="true">|</mo><msup><mi>A</mi><mi>c</mi></msup><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><munder><munder accentunder="true"><mrow><msubsup><mi>P</mi><mn>1</mn><mi>O</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><msup><mi>A</mi><mi>c</mi></msup><mo>)</mo></mrow></mrow><mo stretchy="true">⏟</mo></munder><mrow><mphantom></mphantom><mo>≤</mo><mrow><mn>1</mn><mo>/</mo><mn>4</mn></mrow></mrow></munder></mrow></mrow><mo>≤</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mn>2</mn></mfrac></mstyle></mrow><annotation encoding="application/x-tex">\displaystyle P_{1}^{O}\mathinner{\left(\mathsf{YES}\right)}=\underbrace{P_{1}^{O}\mathinner{\left(\mathsf{YES}|A\right)}}_{\leq 1/4}P_{1}^{O}\mathinner{\left(A\right)}+P_{1}^{O}\mathinner{\left(\mathsf{YES}\middle|A^{c}\right)}\underbrace{P_{1}^{O}\mathinner{\left(A^{c}\right)}}_{\leq 1/4}\leq\frac{1}{2}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A6.SS1.p4.4" class="ltx_p">As a consequence, we get the lower bound</p>
<table id="A6.EGx121" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A6.Ex162"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A6.Ex162.m1" class="ltx_Math" alttext="\displaystyle\TV\mathinner{\left(P_{0}^{O},P_{1}^{O}\right)}\geq P_{0}^{O}\mathinner{\left(\mathsf{YES}\right)}-P_{1}^{O}\mathinner{\left(\mathsf{YES}\right)}\geq\frac{1}{4}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>TV</mi><mo>⁡</mo><mrow><mo>(</mo><msubsup><mi>P</mi><mn>0</mn><mi>O</mi></msubsup><mo>,</mo><msubsup><mi>P</mi><mn>1</mn><mi>O</mi></msubsup><mo>)</mo></mrow></mrow><mo>≥</mo><mrow><mrow><msubsup><mi>P</mi><mn>0</mn><mi>O</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mi>𝖸𝖤𝖲</mi><mo>)</mo></mrow></mrow><mo>−</mo><mrow><msubsup><mi>P</mi><mn>1</mn><mi>O</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mi>𝖸𝖤𝖲</mi><mo>)</mo></mrow></mrow></mrow><mo>≥</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mn>4</mn></mfrac></mstyle></mrow><annotation encoding="application/x-tex">\displaystyle\TV\mathinner{\left(P_{0}^{O},P_{1}^{O}\right)}\geq P_{0}^{O}\mathinner{\left(\mathsf{YES}\right)}-P_{1}^{O}\mathinner{\left(\mathsf{YES}\right)}\geq\frac{1}{4}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A6.SS1.p4.5" class="ltx_p">To further bound the TV distance, we instead switch our attention to the counts <math id="A6.SS1.p4.m11" class="ltx_Math" alttext="C_{h}\coloneqq\mathinner{\left(M_{x},N_{x}\right)}_{x=0}^{d}\sim P_{h}^{C}" display="inline" intent=":literal"><semantics><mrow><msub><mi>C</mi><mi>h</mi></msub><mo>≔</mo><msubsup><mrow><mo>(</mo><msub><mi>M</mi><mi>x</mi></msub><mo>,</mo><msub><mi>N</mi><mi>x</mi></msub><mo>)</mo></mrow><mrow><mi>x</mi><mo>=</mo><mn>0</mn></mrow><mi>d</mi></msubsup><mo>∼</mo><msubsup><mi>P</mi><mi>h</mi><mi>C</mi></msubsup></mrow><annotation encoding="application/x-tex">C_{h}\coloneqq\mathinner{\left(M_{x},N_{x}\right)}_{x=0}^{d}\sim P_{h}^{C}</annotation></semantics></math>. To see why they suffice, note that <math id="A6.SS1.p4.m12" class="ltx_Math" alttext="C_{h}" display="inline" intent=":literal"><semantics><msub><mi>C</mi><mi>h</mi></msub><annotation encoding="application/x-tex">C_{h}</annotation></semantics></math> is a deterministic function of <math id="A6.SS1.p4.m13" class="ltx_Math" alttext="O_{h}" display="inline" intent=":literal"><semantics><msub><mi>O</mi><mi>h</mi></msub><annotation encoding="application/x-tex">O_{h}</annotation></semantics></math>. Moreover, we simply pass <math id="A6.SS1.p4.m14" class="ltx_Math" alttext="C_{h}" display="inline" intent=":literal"><semantics><msub><mi>C</mi><mi>h</mi></msub><annotation encoding="application/x-tex">C_{h}</annotation></semantics></math> through a Markov kernel that is <span id="A6.SS1.p4.5.1" class="ltx_text ltx_font_italic">independent</span> of <math id="A6.SS1.p4.m15" class="ltx_Math" alttext="\mathbf{q}_{h}" display="inline" intent=":literal"><semantics><msub><mi>𝐪</mi><mi>h</mi></msub><annotation encoding="application/x-tex">\mathbf{q}_{h}</annotation></semantics></math> to obtain <math id="A6.SS1.p4.m16" class="ltx_Math" alttext="O_{h}" display="inline" intent=":literal"><semantics><msub><mi>O</mi><mi>h</mi></msub><annotation encoding="application/x-tex">O_{h}</annotation></semantics></math> (choose an ordering of the <math id="A6.SS1.p4.m17" class="ltx_Math" alttext="\mathinner{\left(X_{t},Y_{t}\right)}" display="inline" intent=":literal"><semantics><mrow><mo>(</mo><msub><mi>X</mi><mi>t</mi></msub><mo>,</mo><msub><mi>Y</mi><mi>t</mi></msub><mo>)</mo></mrow><annotation encoding="application/x-tex">\mathinner{\left(X_{t},Y_{t}\right)}</annotation></semantics></math> uniformly at random). This implies that</p>
<table id="A6.EGx122" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A6.Ex163"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A6.Ex163.m1" class="ltx_Math" alttext="\displaystyle\TV\mathinner{\left(P_{0}^{O},P_{1}^{O}\right)}=\TV\mathinner{\left(P_{0}^{C},P_{1}^{C}\right)}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>TV</mi><mo>⁡</mo><mrow><mo>(</mo><msubsup><mi>P</mi><mn>0</mn><mi>O</mi></msubsup><mo>,</mo><msubsup><mi>P</mi><mn>1</mn><mi>O</mi></msubsup><mo>)</mo></mrow></mrow><mo>=</mo><mrow><mi>TV</mi><mo>⁡</mo><mrow><mo>(</mo><msubsup><mi>P</mi><mn>0</mn><mi>C</mi></msubsup><mo>,</mo><msubsup><mi>P</mi><mn>1</mn><mi>C</mi></msubsup><mo>)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\TV\mathinner{\left(P_{0}^{O},P_{1}^{O}\right)}=\TV\mathinner{\left(P_{0}^{C},P_{1}^{C}\right)}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A6.SS1.p4.6" class="ltx_p">Next, we upper bound the right-hand side.</p>
</div>
<div id="A6.Thmtheorem1" class="ltx_theorem ltx_theorem_lemma">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="A6.Thmtheorem1.2" class="ltx_text ltx_font_bold">Lemma F.1</span></span><span id="A6.Thmtheorem1.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="A6.Thmtheorem1.p1" class="ltx_para">
<p id="A6.Thmtheorem1.p1.1" class="ltx_p"><span id="A6.Thmtheorem1.p1.1.1" class="ltx_text ltx_font_italic">We have that</span></p>
<table id="A6.EGx123" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A6.Ex164"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A6.Ex164.m1" class="ltx_Math" alttext="\displaystyle\TV\mathinner{\left(P_{0}^{C},P_{1}^{C}\right)}\leq\frac{T^{2}\epsilon^{2}}{2d}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>TV</mi><mo>⁡</mo><mrow><mo>(</mo><msubsup><mi>P</mi><mn>0</mn><mi>C</mi></msubsup><mo>,</mo><msubsup><mi>P</mi><mn>1</mn><mi>C</mi></msubsup><mo>)</mo></mrow></mrow><mo>≤</mo><mstyle displaystyle="true"><mfrac><mrow><msup><mi>T</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>ϵ</mi><mn>2</mn></msup></mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>d</mi></mrow></mfrac></mstyle></mrow><annotation encoding="application/x-tex">\displaystyle\TV\mathinner{\left(P_{0}^{C},P_{1}^{C}\right)}\leq\frac{T^{2}\epsilon^{2}}{2d}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
</div>
<div id="A6.SS1.2" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof of <a href="#A6.Thmtheorem1" title="Lemma F.1. ‣ F.1 Proof of ‣ Appendix F Proofs of ‣ Is Multi-Distribution Learning as Easy as PAC Learning: Sharp Rates with Bounded Label Noise" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Lemma</span> <span class="ltx_text ltx_ref_tag">F.1</span></a>.</h6>
<div id="A6.SS1.p5" class="ltx_para">
<p id="A6.SS1.p5.1" class="ltx_p"><span id="A6.SS1.p5.1.1" class="ltx_text">We begin with the observation that the coordinates of <math id="A6.SS1.p5.m1" class="ltx_Math" alttext="C_{h}" display="inline" intent=":literal"><semantics><msub><mi>C</mi><mi>h</mi></msub><annotation encoding="application/x-tex">C_{h}</annotation></semantics></math> are independent, and the <math id="A6.SS1.p5.m2" class="ltx_Math" alttext="0" display="inline" intent=":literal"><semantics><mn>0</mn><annotation encoding="application/x-tex">0</annotation></semantics></math>th coordinate of both <math id="A6.SS1.p5.m3" class="ltx_Math" alttext="C_{0}" display="inline" intent=":literal"><semantics><msub><mi>C</mi><mn>0</mn></msub><annotation encoding="application/x-tex">C_{0}</annotation></semantics></math> and <math id="A6.SS1.p5.m4" class="ltx_Math" alttext="C_{1}" display="inline" intent=":literal"><semantics><msub><mi>C</mi><mn>1</mn></msub><annotation encoding="application/x-tex">C_{1}</annotation></semantics></math> is the same by construction. Let <math id="A6.SS1.p5.m5" class="ltx_Math" alttext="\tilde{C}_{h}\sim P_{h}^{\tilde{C}}" display="inline" intent=":literal"><semantics><mrow><msub><mover accent="true"><mi>C</mi><mo>~</mo></mover><mi>h</mi></msub><mo>∼</mo><msubsup><mi>P</mi><mi>h</mi><mover accent="true"><mi>C</mi><mo>~</mo></mover></msubsup></mrow><annotation encoding="application/x-tex">\tilde{C}_{h}\sim P_{h}^{\tilde{C}}</annotation></semantics></math> denote coordinates <math id="A6.SS1.p5.m6" class="ltx_Math" alttext="\mathinner{\left[d\right]}" display="inline" intent=":literal"><semantics><mrow><mo>[</mo><mi>d</mi><mo>]</mo></mrow><annotation encoding="application/x-tex">\mathinner{\left[d\right]}</annotation></semantics></math> of <math id="A6.SS1.p5.m7" class="ltx_Math" alttext="C_{h}" display="inline" intent=":literal"><semantics><msub><mi>C</mi><mi>h</mi></msub><annotation encoding="application/x-tex">C_{h}</annotation></semantics></math>, so that <math id="A6.SS1.p5.m8" class="ltx_Math" alttext="\TV\mathinner{\left(P_{0}^{C},P_{1}^{C}\right)}=\TV\mathinner{\left(P_{0}^{\tilde{C}},P_{1}^{\tilde{C}}\right)}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>TV</mi><mo>⁡</mo><mrow><mo>(</mo><msubsup><mi>P</mi><mn>0</mn><mi>C</mi></msubsup><mo>,</mo><msubsup><mi>P</mi><mn>1</mn><mi>C</mi></msubsup><mo>)</mo></mrow></mrow><mo>=</mo><mrow><mi>TV</mi><mo>⁡</mo><mrow><mo>(</mo><msubsup><mi>P</mi><mn>0</mn><mover accent="true"><mi>C</mi><mo>~</mo></mover></msubsup><mo>,</mo><msubsup><mi>P</mi><mn>1</mn><mover accent="true"><mi>C</mi><mo>~</mo></mover></msubsup><mo>)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\TV\mathinner{\left(P_{0}^{C},P_{1}^{C}\right)}=\TV\mathinner{\left(P_{0}^{\tilde{C}},P_{1}^{\tilde{C}}\right)}</annotation></semantics></math>. To bound this, we note that <math id="A6.SS1.p5.m9" class="ltx_Math" alttext="\tilde{C}_{h}\overset{iid}{\sim}P_{\mu_{h}}" display="inline" intent=":literal"><semantics><mrow><msub><mover accent="true"><mi>C</mi><mo>~</mo></mover><mi>h</mi></msub><mo lspace="0em" rspace="0em">​</mo><mover accent="true"><mo>∼</mo><mrow><mi mathsize="0.700em">i</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.700em">i</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.700em">d</mi></mrow></mover><mo lspace="0em" rspace="0em">​</mo><msub><mi>P</mi><msub><mi>μ</mi><mi>h</mi></msub></msub></mrow><annotation encoding="application/x-tex">\tilde{C}_{h}\overset{iid}{\sim}P_{\mu_{h}}</annotation></semantics></math>, where</span></p>
<table id="A6.EGx124" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A6.Ex165"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A6.Ex165.m1" class="ltx_Math" alttext="\displaystyle P_{q}\coloneqq\Pois\mathinner{\left(\frac{T\epsilon q}{d}\right)}\times\Pois\mathinner{\left(\frac{T\epsilon\mathinner{\left(1-q\right)}}{d}\right)}\quad\text{and}\quad P_{q\sim\mu}\coloneqq\mathbb{E}_{\mu}\mathinner{\left[P_{q}\right]}" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>P</mi><mi>q</mi></msub><mo>≔</mo><mrow><mrow><mi>Pois</mi><mo>⁡</mo><mrow><mo>(</mo><mstyle displaystyle="true"><mfrac><mrow><mi>T</mi><mo lspace="0em" rspace="0em">​</mo><mi>ϵ</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow><mi>d</mi></mfrac></mstyle><mo rspace="0.055em">)</mo></mrow></mrow><mo rspace="0.222em">×</mo><mrow><mi>Pois</mi><mo>⁡</mo><mrow><mo>(</mo><mstyle displaystyle="true"><mfrac><mrow><mi>T</mi><mo lspace="0em" rspace="0em">​</mo><mi>ϵ</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mn>1</mn><mo>−</mo><mi>q</mi></mrow><mo>)</mo></mrow></mrow><mi>d</mi></mfrac></mstyle><mo>)</mo></mrow></mrow></mrow></mrow><mspace style="width:1em;" width="1em"></mspace><mtext>and</mtext><mspace style="width:1em;" width="1em"></mspace><mrow><msub><mi>P</mi><mrow><mi>q</mi><mo>∼</mo><mi>μ</mi></mrow></msub><mo>≔</mo><mrow><msub><mi>𝔼</mi><mi>μ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><msub><mi>P</mi><mi>q</mi></msub><mo>]</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle P_{q}\coloneqq\Pois\mathinner{\left(\frac{T\epsilon q}{d}\right)}\times\Pois\mathinner{\left(\frac{T\epsilon\mathinner{\left(1-q\right)}}{d}\right)}\quad\text{and}\quad P_{q\sim\mu}\coloneqq\mathbb{E}_{\mu}\mathinner{\left[P_{q}\right]}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A6.SS1.p5.2" class="ltx_p"><span id="A6.SS1.p5.2.1" class="ltx_text">Using subadditivity of TV, we then have that <math id="A6.SS1.p5.m10" class="ltx_Math" alttext="\TV\mathinner{\left(P_{0}^{\tilde{C}},P_{1}^{\tilde{C}}\right)}\leq d\TV\mathinner{\left(P_{\mu_{0}},P_{\mu_{1}}\right)}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>TV</mi><mo>⁡</mo><mrow><mo>(</mo><msubsup><mi>P</mi><mn>0</mn><mover accent="true"><mi>C</mi><mo>~</mo></mover></msubsup><mo>,</mo><msubsup><mi>P</mi><mn>1</mn><mover accent="true"><mi>C</mi><mo>~</mo></mover></msubsup><mo>)</mo></mrow></mrow><mo>≤</mo><mrow><mi>d</mi><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>TV</mi><mo>⁡</mo><mrow><mo>(</mo><msub><mi>P</mi><msub><mi>μ</mi><mn>0</mn></msub></msub><mo>,</mo><msub><mi>P</mi><msub><mi>μ</mi><mn>1</mn></msub></msub><mo>)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\TV\mathinner{\left(P_{0}^{\tilde{C}},P_{1}^{\tilde{C}}\right)}\leq d\TV\mathinner{\left(P_{\mu_{0}},P_{\mu_{1}}\right)}</annotation></semantics></math>. To upper bound the right-hand side, let <math id="A6.SS1.p5.m11" class="ltx_Math" alttext="\lambda=T\epsilon/d" display="inline" intent=":literal"><semantics><mrow><mi>λ</mi><mo>=</mo><mrow><mrow><mi>T</mi><mo lspace="0em" rspace="0em">​</mo><mi>ϵ</mi></mrow><mo>/</mo><mi>d</mi></mrow></mrow><annotation encoding="application/x-tex">\lambda=T\epsilon/d</annotation></semantics></math> and note that</span></p>
<table id="A6.EGx125" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A6.Ex166"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A6.Ex166.m1" class="ltx_Math" alttext="\displaystyle P_{q}\mathinner{\left(n,m\right)}=\mathinner{\left(\frac{\mathinner{\left(\lambda q\right)}^{n}e^{-\lambda q}}{n!}\right)}\mathinner{\left(\frac{\mathinner{\left(\lambda\mathinner{\left(1-q\right)}\right)}^{m}e^{-\lambda\mathinner{\left(1-q\right)}}}{m!}\right)}=\frac{\lambda^{n+m}q^{n}\mathinner{\left(1-q\right)}^{m}e^{-\lambda}}{n!m!}" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>P</mi><mi>q</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mi>n</mi><mo>,</mo><mi>m</mi><mo>)</mo></mrow></mrow><mo>=</mo><mrow><mrow><mo>(</mo><mstyle displaystyle="true"><mfrac><mrow><msup><mrow><mo>(</mo><mrow><mi>λ</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow><mo>)</mo></mrow><mi>n</mi></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>e</mi><mrow><mo>−</mo><mrow><mi>λ</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></mrow></msup></mrow><mrow><mi>n</mi><mo>!</mo></mrow></mfrac></mstyle><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mstyle displaystyle="true"><mfrac><mrow><msup><mrow><mo>(</mo><mrow><mi>λ</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mn>1</mn><mo>−</mo><mi>q</mi></mrow><mo>)</mo></mrow></mrow><mo>)</mo></mrow><mi>m</mi></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>e</mi><mrow><mo>−</mo><mrow><mi>λ</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mn>1</mn><mo>−</mo><mi>q</mi></mrow><mo>)</mo></mrow></mrow></mrow></msup></mrow><mrow><mi>m</mi><mo>!</mo></mrow></mfrac></mstyle><mo>)</mo></mrow></mrow><mo>=</mo><mstyle displaystyle="true"><mfrac><mrow><msup><mi>λ</mi><mrow><mi>n</mi><mo>+</mo><mi>m</mi></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>q</mi><mi>n</mi></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo>(</mo><mrow><mn>1</mn><mo>−</mo><mi>q</mi></mrow><mo>)</mo></mrow><mi>m</mi></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>e</mi><mrow><mo>−</mo><mi>λ</mi></mrow></msup></mrow><mrow><mrow><mrow><mi>n</mi><mo>!</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>m</mi></mrow><mo>!</mo></mrow></mfrac></mstyle></mrow><annotation encoding="application/x-tex">\displaystyle P_{q}\mathinner{\left(n,m\right)}=\mathinner{\left(\frac{\mathinner{\left(\lambda q\right)}^{n}e^{-\lambda q}}{n!}\right)}\mathinner{\left(\frac{\mathinner{\left(\lambda\mathinner{\left(1-q\right)}\right)}^{m}e^{-\lambda\mathinner{\left(1-q\right)}}}{m!}\right)}=\frac{\lambda^{n+m}q^{n}\mathinner{\left(1-q\right)}^{m}e^{-\lambda}}{n!m!}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A6.SS1.p5.3" class="ltx_p"><span id="A6.SS1.p5.3.1" class="ltx_text">In particular,</span></p>
<table id="A6.EGx126" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A6.Ex167"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A6.Ex167.m1" class="ltx_Math" alttext="\displaystyle P_{q}\mathinner{\left(0,0\right)}=e^{-\lambda},\quad P_{q}\mathinner{\left(1,0\right)}=\lambda e^{-\lambda}q,\quad P_{q}\mathinner{\left(0,1\right)}=\lambda e^{-\lambda}\mathinner{\left(1-q\right)}" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><msub><mi>P</mi><mi>q</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mn>0</mn><mo>,</mo><mn>0</mn><mo>)</mo></mrow></mrow><mo>=</mo><msup><mi>e</mi><mrow><mo>−</mo><mi>λ</mi></mrow></msup></mrow><mo rspace="1.167em">,</mo><mrow><mrow><msub><mi>P</mi><mi>q</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mn>1</mn><mo>,</mo><mn>0</mn><mo>)</mo></mrow></mrow><mo>=</mo><mrow><mi>λ</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>e</mi><mrow><mo>−</mo><mi>λ</mi></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></mrow><mo rspace="1.167em">,</mo><mrow><mrow><msub><mi>P</mi><mi>q</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mn>0</mn><mo>,</mo><mn>1</mn><mo>)</mo></mrow></mrow><mo>=</mo><mrow><mi>λ</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>e</mi><mrow><mo>−</mo><mi>λ</mi></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mn>1</mn><mo>−</mo><mi>q</mi></mrow><mo>)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle P_{q}\mathinner{\left(0,0\right)}=e^{-\lambda},\quad P_{q}\mathinner{\left(1,0\right)}=\lambda e^{-\lambda}q,\quad P_{q}\mathinner{\left(0,1\right)}=\lambda e^{-\lambda}\mathinner{\left(1-q\right)}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A6.SS1.p5.4" class="ltx_p"><span id="A6.SS1.p5.4.1" class="ltx_text">Since <math id="A6.SS1.p5.m12" class="ltx_Math" alttext="\mathbb{E}_{\mu_{0}}\mathinner{\left[q\right]}=\mathbb{E}_{\mu_{1}}\mathinner{\left[q\right]}" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>𝔼</mi><msub><mi>μ</mi><mn>0</mn></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><mi>q</mi><mo>]</mo></mrow></mrow><mo>=</mo><mrow><msub><mi>𝔼</mi><msub><mi>μ</mi><mn>1</mn></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><mi>q</mi><mo>]</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\mathbb{E}_{\mu_{0}}\mathinner{\left[q\right]}=\mathbb{E}_{\mu_{1}}\mathinner{\left[q\right]}</annotation></semantics></math>, we then know that</span></p>
<table id="A6.EGx127" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A6.Ex168"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A6.Ex168.m1" class="ltx_Math" alttext="\displaystyle P_{\mu_{0}}\mathinner{\left(n,m\right)}=P_{\mu_{1}}\mathinner{\left(n,m\right)}\quad\forall\mathinner{\left(n,m\right)}\in\mathinner{\left\{\mathinner{\left(0,0\right)},\mathinner{\left(1,0\right)},\mathinner{\left(0,1\right)}\right\}}" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><msub><mi>P</mi><msub><mi>μ</mi><mn>0</mn></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mi>n</mi><mo>,</mo><mi>m</mi><mo>)</mo></mrow></mrow><mo>=</mo><mrow><msub><mi>P</mi><msub><mi>μ</mi><mn>1</mn></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mi>n</mi><mo>,</mo><mi>m</mi><mo>)</mo></mrow></mrow></mrow><mspace style="width:1.167em;" width="1.167em"></mspace><mrow><mrow><mo>∀</mo><mrow><mo>(</mo><mi>n</mi><mo>,</mo><mi>m</mi><mo>)</mo></mrow></mrow><mo>∈</mo><mrow><mo>{</mo><mrow><mo>(</mo><mn>0</mn><mo>,</mo><mn>0</mn><mo>)</mo></mrow><mo>,</mo><mrow><mo>(</mo><mn>1</mn><mo>,</mo><mn>0</mn><mo>)</mo></mrow><mo>,</mo><mrow><mo>(</mo><mn>0</mn><mo>,</mo><mn>1</mn><mo>)</mo></mrow><mo>}</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle P_{\mu_{0}}\mathinner{\left(n,m\right)}=P_{\mu_{1}}\mathinner{\left(n,m\right)}\quad\forall\mathinner{\left(n,m\right)}\in\mathinner{\left\{\mathinner{\left(0,0\right)},\mathinner{\left(1,0\right)},\mathinner{\left(0,1\right)}\right\}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A6.SS1.p5.5" class="ltx_p"><span id="A6.SS1.p5.5.1" class="ltx_text">As a result, we get that</span></p>
<table id="A6.EGx128" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A6.Ex169"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A6.Ex169.m1" class="ltx_Math" alttext="\displaystyle\TV\mathinner{\left(P_{\mu_{0}},P_{\mu_{1}}\right)}" display="inline" intent=":literal"><semantics><mrow><mi>TV</mi><mo>⁡</mo><mrow><mo>(</mo><msub><mi>P</mi><msub><mi>μ</mi><mn>0</mn></msub></msub><mo>,</mo><msub><mi>P</mi><msub><mi>μ</mi><mn>1</mn></msub></msub><mo>)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\TV\mathinner{\left(P_{\mu_{0}},P_{\mu_{1}}\right)}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A6.Ex169.m2" class="ltx_Math" alttext="\displaystyle=\frac{1}{2}\sum_{n+m\geq 2}\mathinner{\!\left\lvert P_{\mu_{0}}\mathinner{\left(n,m\right)}-P_{\mu_{1}}\mathinner{\left(n,m\right)}\right\rvert}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mn>2</mn></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mrow><mi>n</mi><mo>+</mo><mi>m</mi></mrow><mo>≥</mo><mn>2</mn></mrow></munder></mstyle><mrow><mo>|</mo><mrow><mrow><msub><mi>P</mi><msub><mi>μ</mi><mn>0</mn></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mi>n</mi><mo>,</mo><mi>m</mi><mo>)</mo></mrow></mrow><mo>−</mo><mrow><msub><mi>P</mi><msub><mi>μ</mi><mn>1</mn></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mi>n</mi><mo>,</mo><mi>m</mi><mo>)</mo></mrow></mrow></mrow><mo>|</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\frac{1}{2}\sum_{n+m\geq 2}\mathinner{\!\left\lvert P_{\mu_{0}}\mathinner{\left(n,m\right)}-P_{\mu_{1}}\mathinner{\left(n,m\right)}\right\rvert}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A6.Ex170"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A6.Ex170.m1" class="ltx_Math" alttext="\displaystyle\leq\frac{1}{2}\mathinner{\left[P_{\mu_{0}}\mathinner{\left(N+M\geq 2\right)}+P_{\mu_{1}}\mathinner{\left(N+M\geq 2\right)}\right]}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≤</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mn>2</mn></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><mrow><mrow><msub><mi>P</mi><msub><mi>μ</mi><mn>0</mn></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mrow><mi>N</mi><mo>+</mo><mi>M</mi></mrow><mo>≥</mo><mn>2</mn></mrow><mo>)</mo></mrow></mrow><mo>+</mo><mrow><msub><mi>P</mi><msub><mi>μ</mi><mn>1</mn></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mrow><mi>N</mi><mo>+</mo><mi>M</mi></mrow><mo>≥</mo><mn>2</mn></mrow><mo>)</mo></mrow></mrow></mrow><mo>]</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\leq\frac{1}{2}\mathinner{\left[P_{\mu_{0}}\mathinner{\left(N+M\geq 2\right)}+P_{\mu_{1}}\mathinner{\left(N+M\geq 2\right)}\right]}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A6.Ex171"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A6.Ex171.m1" class="ltx_Math" alttext="\displaystyle=\mathbb{P}\mathinner{\left(\Pois\mathinner{\left(\lambda\right)}\geq 2\right)}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mi>ℙ</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mrow><mi>Pois</mi><mo>⁡</mo><mrow><mo>(</mo><mi>λ</mi><mo>)</mo></mrow></mrow><mo>≥</mo><mn>2</mn></mrow><mo>)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\mathbb{P}\mathinner{\left(\Pois\mathinner{\left(\lambda\right)}\geq 2\right)}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A6.SS1.p5.6" class="ltx_p"><span id="A6.SS1.p5.6.1" class="ltx_text">where in the last line we used the fact that <math id="A6.SS1.p5.m13" class="ltx_Math" alttext="N+M\sim\Pois\mathinner{\left(\lambda\right)}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>N</mi><mo>+</mo><mi>M</mi></mrow><mo>∼</mo><mrow><mi>Pois</mi><mo>⁡</mo><mrow><mo>(</mo><mi>λ</mi><mo>)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">N+M\sim\Pois\mathinner{\left(\lambda\right)}</annotation></semantics></math> is independent of <math id="A6.SS1.p5.m14" class="ltx_Math" alttext="q" display="inline" intent=":literal"><semantics><mi>q</mi><annotation encoding="application/x-tex">q</annotation></semantics></math>. Lastly, we must bound the Poisson tail above. To start, note that</span></p>
<table id="A6.EGx129" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A6.Ex172"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A6.Ex172.m1" class="ltx_Math" alttext="\displaystyle\mathbb{P}\mathinner{\left(\Pois\mathinner{\left(\lambda\right)}\geq 2\right)}=1-\mathbb{P}\mathinner{\left(\Pois\mathinner{\left(\lambda\right)}=0\right)}-\mathbb{P}\mathinner{\left(\Pois\mathinner{\left(\lambda\right)}=1\right)}=1-e^{-\lambda}\mathinner{\left(1+\lambda\right)}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>ℙ</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mrow><mi>Pois</mi><mo>⁡</mo><mrow><mo>(</mo><mi>λ</mi><mo>)</mo></mrow></mrow><mo>≥</mo><mn>2</mn></mrow><mo>)</mo></mrow></mrow><mo>=</mo><mrow><mn>1</mn><mo>−</mo><mrow><mi>ℙ</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mrow><mi>Pois</mi><mo>⁡</mo><mrow><mo>(</mo><mi>λ</mi><mo>)</mo></mrow></mrow><mo>=</mo><mn>0</mn></mrow><mo>)</mo></mrow></mrow><mo>−</mo><mrow><mi>ℙ</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mrow><mi>Pois</mi><mo>⁡</mo><mrow><mo>(</mo><mi>λ</mi><mo>)</mo></mrow></mrow><mo>=</mo><mn>1</mn></mrow><mo>)</mo></mrow></mrow></mrow><mo>=</mo><mrow><mn>1</mn><mo>−</mo><mrow><msup><mi>e</mi><mrow><mo>−</mo><mi>λ</mi></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mn>1</mn><mo>+</mo><mi>λ</mi></mrow><mo>)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\mathbb{P}\mathinner{\left(\Pois\mathinner{\left(\lambda\right)}\geq 2\right)}=1-\mathbb{P}\mathinner{\left(\Pois\mathinner{\left(\lambda\right)}=0\right)}-\mathbb{P}\mathinner{\left(\Pois\mathinner{\left(\lambda\right)}=1\right)}=1-e^{-\lambda}\mathinner{\left(1+\lambda\right)}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A6.SS1.p5.7" class="ltx_p"><span id="A6.SS1.p5.7.1" class="ltx_text">Define <math id="A6.SS1.p5.m15" class="ltx_Math" alttext="g\mathinner{\left(\lambda\right)}\coloneqq e^{-\lambda}\mathinner{\left(1+\lambda\right)}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>g</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mi>λ</mi><mo>)</mo></mrow></mrow><mo>≔</mo><mrow><msup><mi>e</mi><mrow><mo>−</mo><mi>λ</mi></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mn>1</mn><mo>+</mo><mi>λ</mi></mrow><mo>)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">g\mathinner{\left(\lambda\right)}\coloneqq e^{-\lambda}\mathinner{\left(1+\lambda\right)}</annotation></semantics></math> and note that <math id="A6.SS1.p5.m16" class="ltx_Math" alttext="g^{\prime}\mathinner{\left(\lambda\right)}=-\lambda e^{-\lambda}" display="inline" intent=":literal"><semantics><mrow><mrow><msup><mi>g</mi><mo>′</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mi>λ</mi><mo>)</mo></mrow></mrow><mo>=</mo><mrow><mo>−</mo><mrow><mi>λ</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>e</mi><mrow><mo>−</mo><mi>λ</mi></mrow></msup></mrow></mrow></mrow><annotation encoding="application/x-tex">g^{\prime}\mathinner{\left(\lambda\right)}=-\lambda e^{-\lambda}</annotation></semantics></math>. Then,</span></p>
<table id="A6.EGx130" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A6.Ex173"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A6.Ex173.m1" class="ltx_Math" alttext="\displaystyle 1-e^{-\lambda}\mathinner{\left(1+\lambda\right)}" display="inline" intent=":literal"><semantics><mrow><mn>1</mn><mo>−</mo><mrow><msup><mi>e</mi><mrow><mo>−</mo><mi>λ</mi></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mn>1</mn><mo>+</mo><mi>λ</mi></mrow><mo>)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle 1-e^{-\lambda}\mathinner{\left(1+\lambda\right)}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A6.Ex173.m2" class="ltx_math_unparsed" alttext="\displaystyle=g\mathinner{\left(0\right)}-g\mathinner{\left(\lambda\right)}=\int_{0}^{\lambda}-g^{\prime}\mathinner{\left(t\right)}dt=\int_{0}^{\lambda}te^{-t}dt\leq\int_{0}^{\lambda}tdt=\frac{\lambda^{2}}{2}" display="inline" intent=":literal"><semantics><mrow><mo>=</mo><mi>g</mi><mrow><mo>(</mo><mn>0</mn><mo>)</mo></mrow><mo>−</mo><mi>g</mi><mrow><mo>(</mo><mi>λ</mi><mo>)</mo></mrow><mo>=</mo><mstyle displaystyle="true"><mo>∫</mo></mstyle><msub><mrow></mrow><mn>0</mn></msub><msup><mrow></mrow><mi>λ</mi></msup><mo lspace="0em">−</mo><mi>g</mi><msup><mrow></mrow><mo>′</mo></msup><mrow><mo>(</mo><mi>t</mi><mo>)</mo></mrow><mi>d</mi><mi>t</mi><mo>=</mo><mstyle displaystyle="true"><mo>∫</mo></mstyle><msub><mrow></mrow><mn>0</mn></msub><msup><mrow></mrow><mi>λ</mi></msup><mi>t</mi><mi>e</mi><msup><mrow></mrow><mrow><mo>−</mo><mi>t</mi></mrow></msup><mi>d</mi><mi>t</mi><mo>≤</mo><mstyle displaystyle="true"><mo>∫</mo></mstyle><msub><mrow></mrow><mn>0</mn></msub><msup><mrow></mrow><mi>λ</mi></msup><mi>t</mi><mi>d</mi><mi>t</mi><mo>=</mo><mstyle displaystyle="true"><mfrac><msup><mi>λ</mi><mn>2</mn></msup><mn>2</mn></mfrac></mstyle></mrow><annotation encoding="application/x-tex">\displaystyle=g\mathinner{\left(0\right)}-g\mathinner{\left(\lambda\right)}=\int_{0}^{\lambda}-g^{\prime}\mathinner{\left(t\right)}dt=\int_{0}^{\lambda}te^{-t}dt\leq\int_{0}^{\lambda}tdt=\frac{\lambda^{2}}{2}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A6.SS1.p5.8" class="ltx_p"><span id="A6.SS1.p5.8.1" class="ltx_text">Putting everything together, we conclude that</span></p>
<table id="A6.EGx131" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A6.Ex174"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A6.Ex174.m1" class="ltx_Math" alttext="\displaystyle\TV\mathinner{\left(P_{0}^{C},P_{1}^{C}\right)}" display="inline" intent=":literal"><semantics><mrow><mi>TV</mi><mo>⁡</mo><mrow><mo>(</mo><msubsup><mi>P</mi><mn>0</mn><mi>C</mi></msubsup><mo>,</mo><msubsup><mi>P</mi><mn>1</mn><mi>C</mi></msubsup><mo>)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\TV\mathinner{\left(P_{0}^{C},P_{1}^{C}\right)}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A6.Ex174.m2" class="ltx_Math" alttext="\displaystyle\leq\frac{d\lambda^{2}}{2}=\frac{T^{2}\epsilon^{2}}{2d}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≤</mo><mstyle displaystyle="true"><mfrac><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>λ</mi><mn>2</mn></msup></mrow><mn>2</mn></mfrac></mstyle><mo>=</mo><mstyle displaystyle="true"><mfrac><mrow><msup><mi>T</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>ϵ</mi><mn>2</mn></msup></mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>d</mi></mrow></mfrac></mstyle></mrow><annotation encoding="application/x-tex">\displaystyle\leq\frac{d\lambda^{2}}{2}=\frac{T^{2}\epsilon^{2}}{2d}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A6.SS1.p5.9" class="ltx_p"><span id="A6.SS1.p5.9.1" class="ltx_text">∎</span></p>
</div>
</div>
<div id="A6.SS1.p6" class="ltx_para">
<p id="A6.SS1.p6.1" class="ltx_p">From <a href="#A6.Thmtheorem1" title="Lemma F.1. ‣ F.1 Proof of ‣ Appendix F Proofs of ‣ Is Multi-Distribution Learning as Easy as PAC Learning: Sharp Rates with Bounded Label Noise" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Lemma</span> <span class="ltx_text ltx_ref_tag">F.1</span></a>, we can establish a lower bound on the Poissonized setting:</p>
<table id="A6.EGx132" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A6.Ex175"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A6.Ex175.m1" class="ltx_Math" alttext="\displaystyle\frac{T^{2}\epsilon^{2}}{2d}\geq\frac{1}{4}\Longrightarrow T\geq\frac{\sqrt{d}}{\sqrt{2}\epsilon}" display="inline" intent=":literal"><semantics><mrow><mstyle displaystyle="true"><mfrac><mrow><msup><mi>T</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>ϵ</mi><mn>2</mn></msup></mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>d</mi></mrow></mfrac></mstyle><mo>≥</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mn>4</mn></mfrac></mstyle><mo stretchy="false">⟹</mo><mi>T</mi><mo>≥</mo><mstyle displaystyle="true"><mfrac><msqrt><mi>d</mi></msqrt><mrow><msqrt><mn>2</mn></msqrt><mo lspace="0em" rspace="0em">​</mo><mi>ϵ</mi></mrow></mfrac></mstyle></mrow><annotation encoding="application/x-tex">\displaystyle\frac{T^{2}\epsilon^{2}}{2d}\geq\frac{1}{4}\Longrightarrow T\geq\frac{\sqrt{d}}{\sqrt{2}\epsilon}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A6.SS1.p6.2" class="ltx_p">To obtain a similar bound for our original problem, we rely on the following Poisson tail bound <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib41" title="" class="ltx_ref">26</a>]</cite>: for <math id="A6.SS1.p6.m1" class="ltx_Math" alttext="\lambda\geq 12\log\mathinner{\left(2/\delta\right)}" display="inline" intent=":literal"><semantics><mrow><mi>λ</mi><mo>≥</mo><mrow><mn>12</mn><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>log</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mn>2</mn><mo>/</mo><mi>δ</mi></mrow><mo>)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\lambda\geq 12\log\mathinner{\left(2/\delta\right)}</annotation></semantics></math>,</p>
<table id="A6.EGx133" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A6.Ex176"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A6.Ex176.m1" class="ltx_Math" alttext="\displaystyle\mathbb{P}\mathinner{\left(\Pois\mathinner{\left(\lambda\right)}\in\mathinner{\left[\frac{\lambda}{2},\frac{3\lambda}{2}\right]}\right)}\geq 1-\delta" display="inline" intent=":literal"><semantics><mrow><mrow><mi>ℙ</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mrow><mi>Pois</mi><mo>⁡</mo><mrow><mo>(</mo><mi>λ</mi><mo>)</mo></mrow></mrow><mo>∈</mo><mrow><mo>[</mo><mstyle displaystyle="true"><mfrac><mi>λ</mi><mn>2</mn></mfrac></mstyle><mo>,</mo><mstyle displaystyle="true"><mfrac><mrow><mn>3</mn><mo lspace="0em" rspace="0em">​</mo><mi>λ</mi></mrow><mn>2</mn></mfrac></mstyle><mo>]</mo></mrow></mrow><mo>)</mo></mrow></mrow><mo>≥</mo><mrow><mn>1</mn><mo>−</mo><mi>δ</mi></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\mathbb{P}\mathinner{\left(\Pois\mathinner{\left(\lambda\right)}\in\mathinner{\left[\frac{\lambda}{2},\frac{3\lambda}{2}\right]}\right)}\geq 1-\delta</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A6.SS1.p6.3" class="ltx_p">Suppose that a tester <math id="A6.SS1.p6.m2" class="ltx_Math" alttext="\mathcal{A}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">𝒜</mi><annotation encoding="application/x-tex">\mathcal{A}</annotation></semantics></math> solves (<a href="#S6.Ex55" title="Equation SHT-Mass ‣ 6.1 Massart Testing ‣ 6 () Lower Bound ‣ Is Multi-Distribution Learning as Easy as PAC Learning: Sharp Rates with Bounded Label Noise" class="ltx_ref"><span class="ltx_text ltx_ref_tag">SHT-Mass</span></a>) with at most <math id="A6.SS1.p6.m3" class="ltx_Math" alttext="T" display="inline" intent=":literal"><semantics><mi>T</mi><annotation encoding="application/x-tex">T</annotation></semantics></math> samples. Consider the following strategy <math id="A6.SS1.p6.m4" class="ltx_Math" alttext="\mathcal{A}_{P}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">𝒜</mi><mi>P</mi></msub><annotation encoding="application/x-tex">\mathcal{A}_{P}</annotation></semantics></math> for the Poissonized variant:</p>
<ul id="A6.I1" class="ltx_itemize">
<li id="A6.I1.i1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="A6.I1.i1.p1" class="ltx_para">
<p id="A6.I1.i1.p1.1" class="ltx_p">Sample <math id="A6.I1.i1.p1.m1" class="ltx_Math" alttext="N\sim\Pois\mathinner{\left(2T^{\prime}\right)}" display="inline" intent=":literal"><semantics><mrow><mi>N</mi><mo>∼</mo><mrow><mi>Pois</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msup><mi>T</mi><mo>′</mo></msup></mrow><mo>)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">N\sim\Pois\mathinner{\left(2T^{\prime}\right)}</annotation></semantics></math>, where <math id="A6.I1.i1.p1.m2" class="ltx_Math" alttext="T^{\prime}=\max\mathinner{\left\{T,14\right\}}" display="inline" intent=":literal"><semantics><mrow><msup><mi>T</mi><mo>′</mo></msup><mo>=</mo><mrow><mi>max</mi><mo>⁡</mo><mrow><mo>{</mo><mi>T</mi><mo>,</mo><mn>14</mn><mo>}</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">T^{\prime}=\max\mathinner{\left\{T,14\right\}}</annotation></semantics></math>.</p>
</div></li>
<li id="A6.I1.i2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="A6.I1.i2.p1" class="ltx_para">
<p id="A6.I1.i2.p1.1" class="ltx_p">If <math id="A6.I1.i2.p1.m1" class="ltx_Math" alttext="N\geq T" display="inline" intent=":literal"><semantics><mrow><mi>N</mi><mo>≥</mo><mi>T</mi></mrow><annotation encoding="application/x-tex">N\geq T</annotation></semantics></math>, run <math id="A6.I1.i2.p1.m2" class="ltx_Math" alttext="\mathcal{A}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">𝒜</mi><annotation encoding="application/x-tex">\mathcal{A}</annotation></semantics></math> on the first <math id="A6.I1.i2.p1.m3" class="ltx_Math" alttext="T" display="inline" intent=":literal"><semantics><mi>T</mi><annotation encoding="application/x-tex">T</annotation></semantics></math> samples and output its answer. Otherwise, decide based on a fair coin flip.</p>
</div></li>
</ul>
<p id="A6.SS1.p6.4" class="ltx_p">Since <math id="A6.SS1.p6.m5" class="ltx_Math" alttext="2T^{\prime}\geq 28\geq 12\log\mathinner{\left(2/0.2\right)}" display="inline" intent=":literal"><semantics><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msup><mi>T</mi><mo>′</mo></msup></mrow><mo>≥</mo><mn>28</mn><mo>≥</mo><mrow><mn>12</mn><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>log</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mn>2</mn><mo>/</mo><mn>0.2</mn></mrow><mo>)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">2T^{\prime}\geq 28\geq 12\log\mathinner{\left(2/0.2\right)}</annotation></semantics></math>, the Poisson tail bound implies that</p>
<table id="A6.EGx134" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A6.Ex177"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A6.Ex177.m1" class="ltx_Math" alttext="\displaystyle\mathbb{P}\mathinner{\left(N\geq T\right)}\geq\mathbb{P}\mathinner{\left(N\in\mathinner{\left[T^{\prime},3T^{\prime}\right]}\right)}\geq 0.8" display="inline" intent=":literal"><semantics><mrow><mrow><mi>ℙ</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mi>N</mi><mo>≥</mo><mi>T</mi></mrow><mo>)</mo></mrow></mrow><mo>≥</mo><mrow><mi>ℙ</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mi>N</mi><mo>∈</mo><mrow><mo>[</mo><msup><mi>T</mi><mo>′</mo></msup><mo>,</mo><mrow><mn>3</mn><mo lspace="0em" rspace="0em">​</mo><msup><mi>T</mi><mo>′</mo></msup></mrow><mo>]</mo></mrow></mrow><mo>)</mo></mrow></mrow><mo>≥</mo><mn>0.8</mn></mrow><annotation encoding="application/x-tex">\displaystyle\mathbb{P}\mathinner{\left(N\geq T\right)}\geq\mathbb{P}\mathinner{\left(N\in\mathinner{\left[T^{\prime},3T^{\prime}\right]}\right)}\geq 0.8</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A6.SS1.p6.5" class="ltx_p">Let <math id="A6.SS1.p6.m6" class="ltx_Math" alttext="\mathbb{P}_{h}" display="inline" intent=":literal"><semantics><msub><mi>ℙ</mi><mi>h</mi></msub><annotation encoding="application/x-tex">\mathbb{P}_{h}</annotation></semantics></math> denote the probability measure under any instance of hypothesis <math id="A6.SS1.p6.m7" class="ltx_Math" alttext="h\in\mathinner{\left\{0,1\right\}}" display="inline" intent=":literal"><semantics><mrow><mi>h</mi><mo>∈</mo><mrow><mo>{</mo><mn>0</mn><mo>,</mo><mn>1</mn><mo>}</mo></mrow></mrow><annotation encoding="application/x-tex">h\in\mathinner{\left\{0,1\right\}}</annotation></semantics></math>, and define the event <math id="A6.SS1.p6.m8" class="ltx_Math" alttext="B\coloneqq\mathinner{\left\{N\geq T\right\}}" display="inline" intent=":literal"><semantics><mrow><mi>B</mi><mo>≔</mo><mrow><mo>{</mo><mi>N</mi><mo>≥</mo><mi>T</mi><mo>}</mo></mrow></mrow><annotation encoding="application/x-tex">B\coloneqq\mathinner{\left\{N\geq T\right\}}</annotation></semantics></math>. Then,</p>
<table id="A6.EGx135" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A6.Ex178"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A6.Ex178.m1" class="ltx_Math" alttext="\displaystyle\mathbb{P}_{0}\mathinner{\left(\mathcal{A}_{P}=\mathsf{YES}\right)}" display="inline" intent=":literal"><semantics><mrow><msub><mi>ℙ</mi><mn>0</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><msub><mi class="ltx_font_mathcaligraphic">𝒜</mi><mi>P</mi></msub><mo>=</mo><mi>𝖸𝖤𝖲</mi></mrow><mo>)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\mathbb{P}_{0}\mathinner{\left(\mathcal{A}_{P}=\mathsf{YES}\right)}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A6.Ex178.m2" class="ltx_Math" alttext="\displaystyle=\mathbb{P}_{0}\mathinner{\left(\mathcal{A}=\mathsf{YES}|B\right)}\mathbb{P}\mathinner{\left(B\right)}+\mathbb{P}_{0}\mathinner{\left(\mathcal{A}_{P}=\mathsf{YES}\middle|B^{c}\right)}\mathbb{P}\mathinner{\left(B^{c}\right)}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><msub><mi>ℙ</mi><mn>0</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒜</mi><mo>=</mo><mi>𝖸𝖤𝖲</mi></mrow><mo lspace="0em" rspace="0em">|</mo><mi>B</mi><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>ℙ</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mi>B</mi><mo>)</mo></mrow></mrow><mo>+</mo><mrow><msub><mi>ℙ</mi><mn>0</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><msub><mi class="ltx_font_mathcaligraphic">𝒜</mi><mi>P</mi></msub><mo>=</mo><mi>𝖸𝖤𝖲</mi></mrow><mo lspace="0em" rspace="0em" stretchy="true">|</mo><msup><mi>B</mi><mi>c</mi></msup><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>ℙ</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><msup><mi>B</mi><mi>c</mi></msup><mo>)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\mathbb{P}_{0}\mathinner{\left(\mathcal{A}=\mathsf{YES}|B\right)}\mathbb{P}\mathinner{\left(B\right)}+\mathbb{P}_{0}\mathinner{\left(\mathcal{A}_{P}=\mathsf{YES}\middle|B^{c}\right)}\mathbb{P}\mathinner{\left(B^{c}\right)}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A6.Ex179"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A6.Ex179.m1" class="ltx_Math" alttext="\displaystyle=\mathbb{P}_{0}\mathinner{\left(\mathcal{A}_{P}=\mathsf{YES}\middle|B^{c}\right)}+\mathbb{P}\mathinner{\left(B\right)}\mathinner{\left(\mathbb{P}_{0}\mathinner{\left(\mathcal{A}=\mathsf{YES}|B\right)}-\mathbb{P}_{0}\mathinner{\left(\mathcal{A}_{P}=\mathsf{YES}\middle|B^{c}\right)}\right)}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><msub><mi>ℙ</mi><mn>0</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><msub><mi class="ltx_font_mathcaligraphic">𝒜</mi><mi>P</mi></msub><mo>=</mo><mi>𝖸𝖤𝖲</mi></mrow><mo lspace="0em" rspace="0em" stretchy="true">|</mo><msup><mi>B</mi><mi>c</mi></msup><mo>)</mo></mrow></mrow><mo>+</mo><mrow><mi>ℙ</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mi>B</mi><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mrow><msub><mi>ℙ</mi><mn>0</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒜</mi><mo>=</mo><mi>𝖸𝖤𝖲</mi></mrow><mo lspace="0em" rspace="0em">|</mo><mi>B</mi><mo>)</mo></mrow></mrow><mo>−</mo><mrow><msub><mi>ℙ</mi><mn>0</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><msub><mi class="ltx_font_mathcaligraphic">𝒜</mi><mi>P</mi></msub><mo>=</mo><mi>𝖸𝖤𝖲</mi></mrow><mo lspace="0em" rspace="0em" stretchy="true">|</mo><msup><mi>B</mi><mi>c</mi></msup><mo>)</mo></mrow></mrow></mrow><mo>)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\mathbb{P}_{0}\mathinner{\left(\mathcal{A}_{P}=\mathsf{YES}\middle|B^{c}\right)}+\mathbb{P}\mathinner{\left(B\right)}\mathinner{\left(\mathbb{P}_{0}\mathinner{\left(\mathcal{A}=\mathsf{YES}|B\right)}-\mathbb{P}_{0}\mathinner{\left(\mathcal{A}_{P}=\mathsf{YES}\middle|B^{c}\right)}\right)}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A6.Ex180"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A6.Ex180.m1" class="ltx_Math" alttext="\displaystyle\geq 0.5+0.8\mathinner{\left(0.9-0.5\right)}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≥</mo><mrow><mn>0.5</mn><mo>+</mo><mrow><mn>0.8</mn><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mn>0.9</mn><mo>−</mo><mn>0.5</mn></mrow><mo>)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\geq 0.5+0.8\mathinner{\left(0.9-0.5\right)}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A6.Ex181"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A6.Ex181.m1" class="ltx_Math" alttext="\displaystyle\geq 0.75" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≥</mo><mn>0.75</mn></mrow><annotation encoding="application/x-tex">\displaystyle\geq 0.75</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A6.SS1.p6.6" class="ltx_p">By a symmetric argument, <math id="A6.SS1.p6.m9" class="ltx_Math" alttext="\mathbb{P}_{0}\mathinner{\left(\mathcal{A}_{P}=\mathsf{NO}\right)}\geq 0.75" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>ℙ</mi><mn>0</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><msub><mi class="ltx_font_mathcaligraphic">𝒜</mi><mi>P</mi></msub><mo>=</mo><mi>𝖭𝖮</mi></mrow><mo>)</mo></mrow></mrow><mo>≥</mo><mn>0.75</mn></mrow><annotation encoding="application/x-tex">\mathbb{P}_{0}\mathinner{\left(\mathcal{A}_{P}=\mathsf{NO}\right)}\geq 0.75</annotation></semantics></math>. In other words, we solve the Poissonized problem and its lower bound implies that</p>
<table id="A6.EGx136" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A6.Ex182"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A6.Ex182.m1" class="ltx_Math" alttext="\displaystyle 2T^{\prime}\geq\frac{\sqrt{d}}{\sqrt{2}\epsilon}\Longrightarrow T\geq\frac{\sqrt{d}}{2\sqrt{2}\epsilon}" display="inline" intent=":literal"><semantics><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msup><mi>T</mi><mo>′</mo></msup></mrow><mo>≥</mo><mstyle displaystyle="true"><mfrac><msqrt><mi>d</mi></msqrt><mrow><msqrt><mn>2</mn></msqrt><mo lspace="0em" rspace="0em">​</mo><mi>ϵ</mi></mrow></mfrac></mstyle><mo stretchy="false">⟹</mo><mi>T</mi><mo>≥</mo><mstyle displaystyle="true"><mfrac><msqrt><mi>d</mi></msqrt><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msqrt><mn>2</mn></msqrt><mo lspace="0em" rspace="0em">​</mo><mi>ϵ</mi></mrow></mfrac></mstyle></mrow><annotation encoding="application/x-tex">\displaystyle 2T^{\prime}\geq\frac{\sqrt{d}}{\sqrt{2}\epsilon}\Longrightarrow T\geq\frac{\sqrt{d}}{2\sqrt{2}\epsilon}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A6.SS1.p6.7" class="ltx_p">where we used the assumption <math id="A6.SS1.p6.m10" class="ltx_Math" alttext="d\geq 1750" display="inline" intent=":literal"><semantics><mrow><mi>d</mi><mo>≥</mo><mn>1750</mn></mrow><annotation encoding="application/x-tex">d\geq 1750</annotation></semantics></math>, so that <math id="A6.SS1.p6.m11" class="ltx_Math" alttext="\frac{\sqrt{d}}{\sqrt{2}\epsilon}&gt;28" display="inline" intent=":literal"><semantics><mrow><mfrac><msqrt><mi>d</mi></msqrt><mrow><msqrt><mn>2</mn></msqrt><mo lspace="0em" rspace="0em">​</mo><mi>ϵ</mi></mrow></mfrac><mo>&gt;</mo><mn>28</mn></mrow><annotation encoding="application/x-tex">\frac{\sqrt{d}}{\sqrt{2}\epsilon}&gt;28</annotation></semantics></math> and, thus, <math id="A6.SS1.p6.m12" class="ltx_Math" alttext="T^{\prime}=T" display="inline" intent=":literal"><semantics><mrow><msup><mi>T</mi><mo>′</mo></msup><mo>=</mo><mi>T</mi></mrow><annotation encoding="application/x-tex">T^{\prime}=T</annotation></semantics></math>.</p>
</div>
</section>
<section id="A6.SS2" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">F.2 </span>Proof of <a href="#S6.Thmtheorem2" title="Theorem 6.2 (() lower bound). ‣ 6.2 Lower Bound ‣ 6 () Lower Bound ‣ Is Multi-Distribution Learning as Easy as PAC Learning: Sharp Rates with Bounded Label Noise" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Theorem</span> <span class="ltx_text ltx_ref_tag">6.2</span></a></h3>

<div id="A6.SS2.p1" class="ltx_para">
<p id="A6.SS2.p1.1" class="ltx_p">To start, we note that our construction requires that <math id="A6.SS2.p1.m1" class="ltx_Math" alttext="f^{*}" display="inline" intent=":literal"><semantics><msup><mi>f</mi><mo>∗</mo></msup><annotation encoding="application/x-tex">f^{*}</annotation></semantics></math> always equals <math id="A6.SS2.p1.m2" class="ltx_Math" alttext="0" display="inline" intent=":literal"><semantics><mn>0</mn><annotation encoding="application/x-tex">0</annotation></semantics></math> on the first coordinate of each <math id="A6.SS2.p1.m3" class="ltx_Math" alttext="\mathcal{X}_{i}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">𝒳</mi><mi>i</mi></msub><annotation encoding="application/x-tex">\mathcal{X}_{i}</annotation></semantics></math>. Then, if we apply <a href="#A2.Thmtheorem1" title="Lemma B.1. ‣ Appendix B Learning under Massart Noise ‣ Is Multi-Distribution Learning as Easy as PAC Learning: Sharp Rates with Bounded Label Noise" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Lemma</span> <span class="ltx_text ltx_ref_tag">B.1</span></a> on <math id="A6.SS2.p1.m4" class="ltx_Math" alttext="f_{0}" display="inline" intent=":literal"><semantics><msub><mi>f</mi><mn>0</mn></msub><annotation encoding="application/x-tex">f_{0}</annotation></semantics></math>, we can see that</p>
<table id="A6.EGx137" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A6.Ex183"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A6.Ex183.m1" class="ltx_math_unparsed" alttext="\displaystyle\Delta_{i}\coloneqq\err\mathinner{\left(f_{0};P_{i}\right)}-\eta_{i}^{*}=\sum_{x\in\mathcal{X}\mathrel{\mathop{\mathchar 58\relax}}f^{*}\mathinner{\left(x\right)}=1}\mathinner{\left(1-2\eta_{i}^{*}\mathinner{\left(x\right)}\right)}P_{i}\mathinner{\left(X=x\right)}=\frac{\epsilon}{d}\sum_{x\in\mathcal{X}_{i}\mathrel{\mathop{\mathchar 58\relax}}q_{x}^{i}\geq 1/2}\mathinner{\left(2q_{x}^{i}-1\right)}" display="inline" intent=":literal"><semantics><mrow><mi mathvariant="normal">Δ</mi><msub><mrow></mrow><mi>i</mi></msub><mo>≔</mo><mi>err</mi><mrow><mo>(</mo><msub><mi>f</mi><mn>0</mn></msub><mo>;</mo><msub><mi>P</mi><mi>i</mi></msub><mo>)</mo></mrow><mo>−</mo><mi>η</mi><msub><mrow></mrow><mi>i</mi></msub><msup><mrow></mrow><mo>∗</mo></msup><mo>=</mo><mstyle displaystyle="true"><mo movablelimits="false">∑</mo></mstyle><msub><mrow></mrow><mrow><mi>x</mi><mo>∈</mo><mi class="ltx_font_mathcaligraphic">𝒳</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><msup><mi>f</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mi>x</mi><mo>)</mo></mrow></mrow><mo>=</mo><mn>1</mn></mrow></msub><mrow><mo>(</mo><mrow><mn>1</mn><mo>−</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>η</mi><mi>i</mi><mo>∗</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mi>x</mi><mo>)</mo></mrow></mrow></mrow><mo>)</mo></mrow><mi>P</mi><msub><mrow></mrow><mi>i</mi></msub><mrow><mo>(</mo><mrow><mi>X</mi><mo>=</mo><mi>x</mi></mrow><mo>)</mo></mrow><mo>=</mo><mstyle displaystyle="true"><mfrac><mi>ϵ</mi><mi>d</mi></mfrac></mstyle><mstyle displaystyle="true"><mo movablelimits="false">∑</mo></mstyle><msub><mrow></mrow><mrow><mi>x</mi><mo>∈</mo><msub><mi class="ltx_font_mathcaligraphic">𝒳</mi><mi>i</mi></msub><mo lspace="0.278em" rspace="0.278em">:</mo><msubsup><mi>q</mi><mi>x</mi><mi>i</mi></msubsup><mo>≥</mo><mrow><mn>1</mn><mo>/</mo><mn>2</mn></mrow></mrow></msub><mrow><mo>(</mo><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>q</mi><mi>x</mi><mi>i</mi></msubsup></mrow><mo>−</mo><mn>1</mn></mrow><mo>)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\Delta_{i}\coloneqq\err\mathinner{\left(f_{0};P_{i}\right)}-\eta_{i}^{*}=\sum_{x\in\mathcal{X}\mathrel{\mathop{\mathchar 58\relax}}f^{*}\mathinner{\left(x\right)}=1}\mathinner{\left(1-2\eta_{i}^{*}\mathinner{\left(x\right)}\right)}P_{i}\mathinner{\left(X=x\right)}=\frac{\epsilon}{d}\sum_{x\in\mathcal{X}_{i}\mathrel{\mathop{\mathchar 58\relax}}q_{x}^{i}\geq 1/2}\mathinner{\left(2q_{x}^{i}-1\right)}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A6.SS2.p1.2" class="ltx_p">where <math id="A6.SS2.p1.m5" class="ltx_Math" alttext="q_{x}^{i}\coloneqq P_{i}\mathinner{\left(Y=1|X=x\right)}" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>q</mi><mi>x</mi><mi>i</mi></msubsup><mo>≔</mo><mrow><msub><mi>P</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mi>Y</mi><mo>=</mo><mn>1</mn></mrow><mo lspace="0em" rspace="0em">|</mo><mrow><mi>X</mi><mo>=</mo><mi>x</mi></mrow><mo>)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">q_{x}^{i}\coloneqq P_{i}\mathinner{\left(Y=1|X=x\right)}</annotation></semantics></math>.</p>
</div>
<div id="A6.SS2.p2" class="ltx_para">
<p id="A6.SS2.p2.1" class="ltx_p">Consider the setting where <math id="A6.SS2.p2.m1" class="ltx_Math" alttext="f^{*}=f_{0}" display="inline" intent=":literal"><semantics><mrow><msup><mi>f</mi><mo>∗</mo></msup><mo>=</mo><msub><mi>f</mi><mn>0</mn></msub></mrow><annotation encoding="application/x-tex">f^{*}=f_{0}</annotation></semantics></math> and <math id="A6.SS2.p2.m2" class="ltx_Math" alttext="\eta_{i}^{*}\mathinner{\left(x\right)}=q_{x}^{i}=0.465" display="inline" intent=":literal"><semantics><mrow><mrow><msubsup><mi>η</mi><mi>i</mi><mo>∗</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mi>x</mi><mo>)</mo></mrow></mrow><mo>=</mo><msubsup><mi>q</mi><mi>x</mi><mi>i</mi></msubsup><mo>=</mo><mn>0.465</mn></mrow><annotation encoding="application/x-tex">\eta_{i}^{*}\mathinner{\left(x\right)}=q_{x}^{i}=0.465</annotation></semantics></math> for all <math id="A6.SS2.p2.m3" class="ltx_Math" alttext="x\in\mathcal{X}" display="inline" intent=":literal"><semantics><mrow><mi>x</mi><mo>∈</mo><mi class="ltx_font_mathcaligraphic">𝒳</mi></mrow><annotation encoding="application/x-tex">x\in\mathcal{X}</annotation></semantics></math> and <math id="A6.SS2.p2.m4" class="ltx_Math" alttext="i\in\mathinner{\left[k\right]}" display="inline" intent=":literal"><semantics><mrow><mi>i</mi><mo>∈</mo><mrow><mo>[</mo><mi>k</mi><mo>]</mo></mrow></mrow><annotation encoding="application/x-tex">i\in\mathinner{\left[k\right]}</annotation></semantics></math>. Let <math id="A6.SS2.p2.m5" class="ltx_Math" alttext="\mathbb{P}_{0}" display="inline" intent=":literal"><semantics><msub><mi>ℙ</mi><mn>0</mn></msub><annotation encoding="application/x-tex">\mathbb{P}_{0}</annotation></semantics></math> denote the probability law under this environment. We will show that any successful (<a href="#S1.Ex5" title="Equation MDL-Mass ‣ Massart. ‣ 1.1 Problem Setup ‣ 1 Introduction ‣ Is Multi-Distribution Learning as Easy as PAC Learning: Sharp Rates with Bounded Label Noise" class="ltx_ref"><span class="ltx_text ltx_ref_tag">MDL-Mass</span></a>) algorithm must sample <math id="A6.SS2.p2.m6" class="ltx_Math" alttext="\Omega\mathinner{\left(\sqrt{d}/\epsilon\right)}" display="inline" intent=":literal"><semantics><mrow><mi mathvariant="normal">Ω</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><msqrt><mi>d</mi></msqrt><mo>/</mo><mi>ϵ</mi></mrow><mo>)</mo></mrow></mrow><annotation encoding="application/x-tex">\Omega\mathinner{\left(\sqrt{d}/\epsilon\right)}</annotation></semantics></math> times from each distribution under <math id="A6.SS2.p2.m7" class="ltx_Math" alttext="\mathbb{P}_{0}" display="inline" intent=":literal"><semantics><msub><mi>ℙ</mi><mn>0</mn></msub><annotation encoding="application/x-tex">\mathbb{P}_{0}</annotation></semantics></math> with high probability.</p>
</div>
<div id="A6.SS2.p3" class="ltx_para">
<p id="A6.SS2.p3.1" class="ltx_p">To do this, we will solve an (<a href="#S6.Ex55" title="Equation SHT-Mass ‣ 6.1 Massart Testing ‣ 6 () Lower Bound ‣ Is Multi-Distribution Learning as Easy as PAC Learning: Sharp Rates with Bounded Label Noise" class="ltx_ref"><span class="ltx_text ltx_ref_tag">SHT-Mass</span></a>) hard instance <math id="A6.SS2.p3.m1" class="ltx_Math" alttext="P" display="inline" intent=":literal"><semantics><mi>P</mi><annotation encoding="application/x-tex">P</annotation></semantics></math> by simulating a (<a href="#S1.Ex5" title="Equation MDL-Mass ‣ Massart. ‣ 1.1 Problem Setup ‣ 1 Introduction ‣ Is Multi-Distribution Learning as Easy as PAC Learning: Sharp Rates with Bounded Label Noise" class="ltx_ref"><span class="ltx_text ltx_ref_tag">MDL-Mass</span></a>) algorithm <math id="A6.SS2.p3.m2" class="ltx_Math" alttext="\mathcal{A}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">𝒜</mi><annotation encoding="application/x-tex">\mathcal{A}</annotation></semantics></math>. Here, <math id="A6.SS2.p3.m3" class="ltx_Math" alttext="P" display="inline" intent=":literal"><semantics><mi>P</mi><annotation encoding="application/x-tex">P</annotation></semantics></math> is a distribution over <math id="A6.SS2.p3.m4" class="ltx_Math" alttext="\mathinner{\left(X,Y\right)}" display="inline" intent=":literal"><semantics><mrow><mo>(</mo><mi>X</mi><mo>,</mo><mi>Y</mi><mo>)</mo></mrow><annotation encoding="application/x-tex">\mathinner{\left(X,Y\right)}</annotation></semantics></math> where <math id="A6.SS2.p3.m5" class="ltx_Math" alttext="p_{X}=\mathinner{\left(1-\epsilon,\epsilon/d,\dots,\epsilon/d\right)}" display="inline" intent=":literal"><semantics><mrow><msub><mi>p</mi><mi>X</mi></msub><mo>=</mo><mrow><mo>(</mo><mrow><mn>1</mn><mo>−</mo><mi>ϵ</mi></mrow><mo>,</mo><mrow><mi>ϵ</mi><mo>/</mo><mi>d</mi></mrow><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mrow><mi>ϵ</mi><mo>/</mo><mi>d</mi></mrow><mo>)</mo></mrow></mrow><annotation encoding="application/x-tex">p_{X}=\mathinner{\left(1-\epsilon,\epsilon/d,\dots,\epsilon/d\right)}</annotation></semantics></math> on <math id="A6.SS2.p3.m6" class="ltx_Math" alttext="\llbracket d\rrbracket" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">⟦</mo><mi>d</mi><mo stretchy="false">⟧</mo></mrow><annotation encoding="application/x-tex">\llbracket d\rrbracket</annotation></semantics></math> and <math id="A6.SS2.p3.m7" class="ltx_Math" alttext="Y|X=x\sim\Ber\mathinner{\left(q_{x}\right)}" display="inline" intent=":literal"><semantics><mrow><mi>Y</mi><mo fence="false">|</mo><mrow><mi>X</mi><mo>=</mo><mi>x</mi><mo>∼</mo><mrow><mi>Ber</mi><mo>⁡</mo><mrow><mo>(</mo><msub><mi>q</mi><mi>x</mi></msub><mo>)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">Y|X=x\sim\Ber\mathinner{\left(q_{x}\right)}</annotation></semantics></math>. Recall our testing objective:</p>
<ul id="A6.I2" class="ltx_itemize">
<li id="A6.I2.i1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="A6.I2.i1.p1" class="ltx_para">
<p id="A6.I2.i1.p1.1" class="ltx_p"><math id="A6.I2.i1.p1.m1" class="ltx_Math" alttext="H_{0}" display="inline" intent=":literal"><semantics><msub><mi>H</mi><mn>0</mn></msub><annotation encoding="application/x-tex">H_{0}</annotation></semantics></math>: <math id="A6.I2.i1.p1.m2" class="ltx_Math" alttext="q_{x}=0.465" display="inline" intent=":literal"><semantics><mrow><msub><mi>q</mi><mi>x</mi></msub><mo>=</mo><mn>0.465</mn></mrow><annotation encoding="application/x-tex">q_{x}=0.465</annotation></semantics></math> for all <math id="A6.I2.i1.p1.m3" class="ltx_Math" alttext="x\in\llbracket d\rrbracket" display="inline" intent=":literal"><semantics><mrow><mi>x</mi><mo>∈</mo><mrow><mo stretchy="false">⟦</mo><mi>d</mi><mo stretchy="false">⟧</mo></mrow></mrow><annotation encoding="application/x-tex">x\in\llbracket d\rrbracket</annotation></semantics></math>.</p>
</div></li>
<li id="A6.I2.i2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="A6.I2.i2.p1" class="ltx_para">
<p id="A6.I2.i2.p1.1" class="ltx_p"><math id="A6.I2.i2.p1.m1" class="ltx_Math" alttext="H_{1}" display="inline" intent=":literal"><semantics><msub><mi>H</mi><mn>1</mn></msub><annotation encoding="application/x-tex">H_{1}</annotation></semantics></math>: <math id="A6.I2.i2.p1.m2" class="ltx_math_unparsed" alttext="\Delta_{\mathbf{q}}=\frac{\epsilon}{d}\sum_{x\in\llbracket d\rrbracket\mathrel{\mathop{\mathchar 58\relax}}q_{x}\geq 1/2}\mathinner{\left(2q_{x}-1\right)}\geq 0.3\epsilon" display="inline" intent=":literal"><semantics><mrow><mi mathvariant="normal">Δ</mi><msub><mrow></mrow><mi>𝐪</mi></msub><mo>=</mo><mfrac><mi>ϵ</mi><mi>d</mi></mfrac><mo rspace="0em">∑</mo><msub><mrow></mrow><mrow><mi>x</mi><mo>∈</mo><mrow><mo stretchy="false">⟦</mo><mi>d</mi><mo rspace="0.278em" stretchy="false">⟧</mo></mrow><mo rspace="0.278em">:</mo><msub><mi>q</mi><mi>x</mi></msub><mo>≥</mo><mrow><mn>1</mn><mo>/</mo><mn>2</mn></mrow></mrow></msub><mrow><mo>(</mo><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>q</mi><mi>x</mi></msub></mrow><mo>−</mo><mn>1</mn></mrow><mo>)</mo></mrow><mo>≥</mo><mn>0.3</mn><mi>ϵ</mi></mrow><annotation encoding="application/x-tex">\Delta_{\mathbf{q}}=\frac{\epsilon}{d}\sum_{x\in\llbracket d\rrbracket\mathrel{\mathop{\mathchar 58\relax}}q_{x}\geq 1/2}\mathinner{\left(2q_{x}-1\right)}\geq 0.3\epsilon</annotation></semantics></math>.</p>
</div></li>
</ul>
<p id="A6.SS2.p3.2" class="ltx_p">Fix some <math id="A6.SS2.p3.m8" class="ltx_Math" alttext="i\in\mathinner{\left[k\right]}" display="inline" intent=":literal"><semantics><mrow><mi>i</mi><mo>∈</mo><mrow><mo>[</mo><mi>k</mi><mo>]</mo></mrow></mrow><annotation encoding="application/x-tex">i\in\mathinner{\left[k\right]}</annotation></semantics></math> and let <math id="A6.SS2.p3.m9" class="ltx_Math" alttext="T_{i}" display="inline" intent=":literal"><semantics><msub><mi>T</mi><mi>i</mi></msub><annotation encoding="application/x-tex">T_{i}</annotation></semantics></math> be number of times that <math id="A6.SS2.p3.m10" class="ltx_Math" alttext="\mathcal{A}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">𝒜</mi><annotation encoding="application/x-tex">\mathcal{A}</annotation></semantics></math> samples <math id="A6.SS2.p3.m11" class="ltx_Math" alttext="P_{i}" display="inline" intent=":literal"><semantics><msub><mi>P</mi><mi>i</mi></msub><annotation encoding="application/x-tex">P_{i}</annotation></semantics></math>. We will show, by contradiction, that <math id="A6.SS2.p3.m12" class="ltx_Math" alttext="T_{i}\gtrsim\sqrt{d}/\epsilon" display="inline" intent=":literal"><semantics><mrow><msub><mi>T</mi><mi>i</mi></msub><mo>≳</mo><mrow><msqrt><mi>d</mi></msqrt><mo>/</mo><mi>ϵ</mi></mrow></mrow><annotation encoding="application/x-tex">T_{i}\gtrsim\sqrt{d}/\epsilon</annotation></semantics></math> with high probability under <math id="A6.SS2.p3.m13" class="ltx_Math" alttext="\mathbb{P}_{0}" display="inline" intent=":literal"><semantics><msub><mi>ℙ</mi><mn>0</mn></msub><annotation encoding="application/x-tex">\mathbb{P}_{0}</annotation></semantics></math>. Let <math id="A6.SS2.p3.m14" class="ltx_Math" alttext="B_{i}\coloneqq\mathinner{\left\{T_{i}\leq 0.05\sqrt{d}/\epsilon\right\}}" display="inline" intent=":literal"><semantics><mrow><msub><mi>B</mi><mi>i</mi></msub><mo>≔</mo><mrow><mo>{</mo><mi>T</mi><msub><mrow></mrow><mi>i</mi></msub><mo>≤</mo><mn>0.05</mn><msqrt><mi>d</mi></msqrt><mo>/</mo><mi>ϵ</mi><mo>}</mo></mrow></mrow><annotation encoding="application/x-tex">B_{i}\coloneqq\mathinner{\left\{T_{i}\leq 0.05\sqrt{d}/\epsilon\right\}}</annotation></semantics></math> and assume to the contrary that</p>
<table id="A6.EGx138" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A6.Ex184"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A6.Ex184.m1" class="ltx_Math" alttext="\displaystyle\mathbb{P}_{0}\mathinner{\left(B_{i}\right)}\geq 0.85" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>ℙ</mi><mn>0</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><msub><mi>B</mi><mi>i</mi></msub><mo>)</mo></mrow></mrow><mo>≥</mo><mn>0.85</mn></mrow><annotation encoding="application/x-tex">\displaystyle\mathbb{P}_{0}\mathinner{\left(B_{i}\right)}\geq 0.85</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A6.SS2.p3.3" class="ltx_p">We will construct an (<a href="#S6.Ex55" title="Equation SHT-Mass ‣ 6.1 Massart Testing ‣ 6 () Lower Bound ‣ Is Multi-Distribution Learning as Easy as PAC Learning: Sharp Rates with Bounded Label Noise" class="ltx_ref"><span class="ltx_text ltx_ref_tag">SHT-Mass</span></a>) <math id="A6.SS2.p3.m15" class="ltx_Math" alttext="\mathcal{A}_{s}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">𝒜</mi><mi>s</mi></msub><annotation encoding="application/x-tex">\mathcal{A}_{s}</annotation></semantics></math> strategy as follows:</p>
<ol id="A6.I3" class="ltx_enumerate">
<li id="A6.I3.i1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">1.</span> 
<div id="A6.I3.i1.p1" class="ltx_para">
<p id="A6.I3.i1.p1.1" class="ltx_p">Run <math id="A6.I3.i1.p1.m1" class="ltx_Math" alttext="\mathcal{A}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">𝒜</mi><annotation encoding="application/x-tex">\mathcal{A}</annotation></semantics></math> on parameters <math id="A6.I3.i1.p1.m2" class="ltx_Math" alttext="\mathinner{\left(\eta,\epsilon,\delta\right)}=\mathinner{\left(0.49,\epsilon/192,0.1/3\right)}" display="inline" intent=":literal"><semantics><mrow><mrow><mo>(</mo><mi>η</mi><mo>,</mo><mi>ϵ</mi><mo>,</mo><mi>δ</mi><mo>)</mo></mrow><mo>=</mo><mrow><mo>(</mo><mn>0.49</mn><mo>,</mo><mrow><mi>ϵ</mi><mo>/</mo><mn>192</mn></mrow><mo>,</mo><mrow><mn>0.1</mn><mo>/</mo><mn>3</mn></mrow><mo>)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathinner{\left(\eta,\epsilon,\delta\right)}=\mathinner{\left(0.49,\epsilon/192,0.1/3\right)}</annotation></semantics></math>. When it samples distribution <math id="A6.I3.i1.p1.m3" class="ltx_Math" alttext="j\in\mathinner{\left[k\right]}" display="inline" intent=":literal"><semantics><mrow><mi>j</mi><mo>∈</mo><mrow><mo>[</mo><mi>k</mi><mo>]</mo></mrow></mrow><annotation encoding="application/x-tex">j\in\mathinner{\left[k\right]}</annotation></semantics></math>,</p>
<ul id="A6.I3.i1.I1" class="ltx_itemize">
<li id="A6.I3.i1.I1.i1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="A6.I3.i1.I1.i1.p1" class="ltx_para">
<p id="A6.I3.i1.I1.i1.p1.1" class="ltx_p">If <math id="A6.I3.i1.I1.i1.p1.m1" class="ltx_Math" alttext="j=i" display="inline" intent=":literal"><semantics><mrow><mi>j</mi><mo>=</mo><mi>i</mi></mrow><annotation encoding="application/x-tex">j=i</annotation></semantics></math>, sample <math id="A6.I3.i1.I1.i1.p1.m2" class="ltx_Math" alttext="\mathinner{\left(X,Y\right)}\sim P" display="inline" intent=":literal"><semantics><mrow><mrow><mo>(</mo><mi>X</mi><mo>,</mo><mi>Y</mi><mo>)</mo></mrow><mo>∼</mo><mi>P</mi></mrow><annotation encoding="application/x-tex">\mathinner{\left(X,Y\right)}\sim P</annotation></semantics></math>.</p>
</div></li>
<li id="A6.I3.i1.I1.i2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="A6.I3.i1.I1.i2.p1" class="ltx_para">
<p id="A6.I3.i1.I1.i2.p1.1" class="ltx_p">If <math id="A6.I3.i1.I1.i2.p1.m1" class="ltx_Math" alttext="j\neq i" display="inline" intent=":literal"><semantics><mrow><mi>j</mi><mo>≠</mo><mi>i</mi></mrow><annotation encoding="application/x-tex">j\neq i</annotation></semantics></math>, sample <math id="A6.I3.i1.I1.i2.p1.m2" class="ltx_Math" alttext="X\sim p_{X}" display="inline" intent=":literal"><semantics><mrow><mi>X</mi><mo>∼</mo><msub><mi>p</mi><mi>X</mi></msub></mrow><annotation encoding="application/x-tex">X\sim p_{X}</annotation></semantics></math> and <math id="A6.I3.i1.I1.i2.p1.m3" class="ltx_Math" alttext="Y\sim\Ber\mathinner{\left(0.465\right)}" display="inline" intent=":literal"><semantics><mrow><mi>Y</mi><mo>∼</mo><mrow><mi>Ber</mi><mo>⁡</mo><mrow><mo>(</mo><mn>0.465</mn><mo>)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">Y\sim\Ber\mathinner{\left(0.465\right)}</annotation></semantics></math>.</p>
</div></li>
</ul>
<p id="A6.I3.i1.p1.2" class="ltx_p">To ensure that <math id="A6.I3.i1.p1.m4" class="ltx_Math" alttext="X\in\mathcal{X}_{j}" display="inline" intent=":literal"><semantics><mrow><mi>X</mi><mo>∈</mo><msub><mi class="ltx_font_mathcaligraphic">𝒳</mi><mi>j</mi></msub></mrow><annotation encoding="application/x-tex">X\in\mathcal{X}_{j}</annotation></semantics></math>, we shift <math id="A6.I3.i1.p1.m5" class="ltx_Math" alttext="X" display="inline" intent=":literal"><semantics><mi>X</mi><annotation encoding="application/x-tex">X</annotation></semantics></math> by <math id="A6.I3.i1.p1.m6" class="ltx_Math" alttext="\mathinner{\left(j-1\right)}\mathinner{\left(d+1\right)}" display="inline" intent=":literal"><semantics><mrow><mrow><mo>(</mo><mrow><mi>j</mi><mo>−</mo><mn>1</mn></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mi>d</mi><mo>+</mo><mn>1</mn></mrow><mo>)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathinner{\left(j-1\right)}\mathinner{\left(d+1\right)}</annotation></semantics></math> before returning it to <math id="A6.I3.i1.p1.m7" class="ltx_Math" alttext="\mathcal{A}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">𝒜</mi><annotation encoding="application/x-tex">\mathcal{A}</annotation></semantics></math>. In other words, we set <math id="A6.I3.i1.p1.m8" class="ltx_Math" alttext="P_{i}" display="inline" intent=":literal"><semantics><msub><mi>P</mi><mi>i</mi></msub><annotation encoding="application/x-tex">P_{i}</annotation></semantics></math> to <math id="A6.I3.i1.p1.m9" class="ltx_Math" alttext="P" display="inline" intent=":literal"><semantics><mi>P</mi><annotation encoding="application/x-tex">P</annotation></semantics></math>, with an appropriate shift, and set <math id="A6.I3.i1.p1.m10" class="ltx_Math" alttext="f^{*}" display="inline" intent=":literal"><semantics><msup><mi>f</mi><mo>∗</mo></msup><annotation encoding="application/x-tex">f^{*}</annotation></semantics></math> to <math id="A6.I3.i1.p1.m11" class="ltx_Math" alttext="0" display="inline" intent=":literal"><semantics><mn>0</mn><annotation encoding="application/x-tex">0</annotation></semantics></math> outside of <math id="A6.I3.i1.p1.m12" class="ltx_Math" alttext="\mathcal{X}_{i}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">𝒳</mi><mi>i</mi></msub><annotation encoding="application/x-tex">\mathcal{X}_{i}</annotation></semantics></math>. By construction, this aligns with our MDL setup.</p>
</div></li>
<li id="A6.I3.i2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">2.</span> 
<div id="A6.I3.i2.p1" class="ltx_para">
<p id="A6.I3.i2.p1.1" class="ltx_p">Terminate when the first of the following occurs:</p>
<ul id="A6.I3.i2.I1" class="ltx_itemize">
<li id="A6.I3.i2.I1.i1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="A6.I3.i2.I1.i1.p1" class="ltx_para">
<p id="A6.I3.i2.I1.i1.p1.1" class="ltx_p">If <math id="A6.I3.i2.I1.i1.p1.m1" class="ltx_Math" alttext="T_{i}" display="inline" intent=":literal"><semantics><msub><mi>T</mi><mi>i</mi></msub><annotation encoding="application/x-tex">T_{i}</annotation></semantics></math> exceeds <math id="A6.I3.i2.I1.i1.p1.m2" class="ltx_Math" alttext="0.05\sqrt{d}/\epsilon" display="inline" intent=":literal"><semantics><mrow><mrow><mn>0.05</mn><mo lspace="0em" rspace="0em">​</mo><msqrt><mi>d</mi></msqrt></mrow><mo>/</mo><mi>ϵ</mi></mrow><annotation encoding="application/x-tex">0.05\sqrt{d}/\epsilon</annotation></semantics></math>, output <math id="A6.I3.i2.I1.i1.p1.m3" class="ltx_Math" alttext="\mathsf{NO}" display="inline" intent=":literal"><semantics><mi>𝖭𝖮</mi><annotation encoding="application/x-tex">\mathsf{NO}</annotation></semantics></math>.</p>
</div></li>
<li id="A6.I3.i2.I1.i2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="A6.I3.i2.I1.i2.p1" class="ltx_para">
<p id="A6.I3.i2.I1.i2.p1.1" class="ltx_p">If <math id="A6.I3.i2.I1.i2.p1.m1" class="ltx_Math" alttext="\mathcal{A}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">𝒜</mi><annotation encoding="application/x-tex">\mathcal{A}</annotation></semantics></math> terminates and outputs <math id="A6.I3.i2.I1.i2.p1.m2" class="ltx_Math" alttext="\hat{f}_{i}" display="inline" intent=":literal"><semantics><msub><mover accent="true"><mi>f</mi><mo>^</mo></mover><mi>i</mi></msub><annotation encoding="application/x-tex">\hat{f}_{i}</annotation></semantics></math>, sample <math id="A6.I3.i2.I1.i2.p1.m3" class="ltx_Math" alttext="S\overset{iid}{\sim}P" display="inline" intent=":literal"><semantics><mrow><mi>S</mi><mo lspace="0em" rspace="0em">​</mo><mover accent="true"><mo>∼</mo><mrow><mi mathsize="0.700em">i</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.700em">i</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.700em">d</mi></mrow></mover><mo lspace="0em" rspace="0em">​</mo><mi>P</mi></mrow><annotation encoding="application/x-tex">S\overset{iid}{\sim}P</annotation></semantics></math> of size</p>
<table id="A6.EGx139" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A6.Ex185"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A6.Ex185.m1" class="ltx_Math" alttext="\displaystyle\mathinner{\!\left\lvert S\right\rvert}=T_{\mathsf{L}}\mathinner{\left(0.49,\epsilon/4,0.1\right)}=\frac{384}{0.02\epsilon}\log\mathinner{\left(60\right)}\leq\frac{80000}{\epsilon}" display="inline" intent=":literal"><semantics><mrow><mrow><mo>|</mo><mi>S</mi><mo>|</mo></mrow><mo>=</mo><mrow><msub><mi>T</mi><mi>𝖫</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mn>0.49</mn><mo>,</mo><mrow><mi>ϵ</mi><mo>/</mo><mn>4</mn></mrow><mo>,</mo><mn>0.1</mn><mo>)</mo></mrow></mrow><mo>=</mo><mrow><mstyle displaystyle="true"><mfrac><mn>384</mn><mrow><mn>0.02</mn><mo lspace="0em" rspace="0em">​</mo><mi>ϵ</mi></mrow></mfrac></mstyle><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>log</mi><mo>⁡</mo><mrow><mo>(</mo><mn>60</mn><mo>)</mo></mrow></mrow></mrow><mo>≤</mo><mstyle displaystyle="true"><mfrac><mn>80000</mn><mi>ϵ</mi></mfrac></mstyle></mrow><annotation encoding="application/x-tex">\displaystyle\mathinner{\!\left\lvert S\right\rvert}=T_{\mathsf{L}}\mathinner{\left(0.49,\epsilon/4,0.1\right)}=\frac{384}{0.02\epsilon}\log\mathinner{\left(60\right)}\leq\frac{80000}{\epsilon}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A6.I3.i2.I1.i2.p1.2" class="ltx_p">shift the <math id="A6.I3.i2.I1.i2.p1.m4" class="ltx_Math" alttext="X" display="inline" intent=":literal"><semantics><mi>X</mi><annotation encoding="application/x-tex">X</annotation></semantics></math>’s appropriately, and output <math id="A6.I3.i2.I1.i2.p1.m5" class="ltx_Math" alttext="\mathsf{YES}" display="inline" intent=":literal"><semantics><mi>𝖸𝖤𝖲</mi><annotation encoding="application/x-tex">\mathsf{YES}</annotation></semantics></math> if and only if event</p>
<table id="A6.EGx140" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A6.Ex186"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A6.Ex186.m1" class="ltx_Math" alttext="\displaystyle E_{i}\coloneqq\mathinner{\left\{\mathinner{\!\left\lvert\emperr\mathinner{\left(f_{0};S\right)}-\emperr\mathinner{\left(\hat{f}_{i};S\right)}\right\rvert}\leq\frac{\epsilon}{12}\right\}}" display="inline" intent=":literal"><semantics><mrow><msub><mi>E</mi><mi>i</mi></msub><mo>≔</mo><mrow><mo>{</mo><mrow><mo>|</mo><mrow><mrow><mover accent="true"><mi>err</mi><mo>^</mo></mover><mo>⁡</mo><mrow><mo>(</mo><msub><mi>f</mi><mn>0</mn></msub><mo>;</mo><mi>S</mi><mo>)</mo></mrow></mrow><mo>−</mo><mrow><mover accent="true"><mi>err</mi><mo>^</mo></mover><mo>⁡</mo><mrow><mo>(</mo><msub><mover accent="true"><mi>f</mi><mo>^</mo></mover><mi>i</mi></msub><mo>;</mo><mi>S</mi><mo>)</mo></mrow></mrow></mrow><mo>|</mo></mrow><mo>≤</mo><mstyle displaystyle="true"><mfrac><mi>ϵ</mi><mn>12</mn></mfrac></mstyle><mo>}</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle E_{i}\coloneqq\mathinner{\left\{\mathinner{\!\left\lvert\emperr\mathinner{\left(f_{0};S\right)}-\emperr\mathinner{\left(\hat{f}_{i};S\right)}\right\rvert}\leq\frac{\epsilon}{12}\right\}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A6.I3.i2.I1.i2.p1.3" class="ltx_p">occurs.</p>
</div></li>
</ul>
</div></li>
</ol>
<p id="A6.SS2.p3.4" class="ltx_p">Note that the suboptimality gaps coincide: <math id="A6.SS2.p3.m16" class="ltx_Math" alttext="\Delta_{i}=\Delta_{\mathbf{q}}" display="inline" intent=":literal"><semantics><mrow><msub><mi mathvariant="normal">Δ</mi><mi>i</mi></msub><mo>=</mo><msub><mi mathvariant="normal">Δ</mi><mi>𝐪</mi></msub></mrow><annotation encoding="application/x-tex">\Delta_{i}=\Delta_{\mathbf{q}}</annotation></semantics></math>. In addition, correctness of <math id="A6.SS2.p3.m17" class="ltx_Math" alttext="\mathcal{A}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">𝒜</mi><annotation encoding="application/x-tex">\mathcal{A}</annotation></semantics></math> implies, via <a href="#S4.Thmtheorem2" title="Lemma 4.2 (From learning to testing). ‣ Learning-Augmented Testing. ‣ 4.1 () Upper Bounds ‣ 4 Structured Hypothesis Testing ‣ Is Multi-Distribution Learning as Easy as PAC Learning: Sharp Rates with Bounded Label Noise" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Lemma</span> <span class="ltx_text ltx_ref_tag">4.2</span></a>, that with probability at least <math id="A6.SS2.p3.m18" class="ltx_Math" alttext="0.9" display="inline" intent=":literal"><semantics><mn>0.9</mn><annotation encoding="application/x-tex">0.9</annotation></semantics></math>,</p>
<ul id="A6.I4" class="ltx_itemize">
<li id="A6.I4.i1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="A6.I4.i1.p1" class="ltx_para">
<p id="A6.I4.i1.p1.1" class="ltx_p">Under <math id="A6.I4.i1.p1.m1" class="ltx_Math" alttext="H_{0}" display="inline" intent=":literal"><semantics><msub><mi>H</mi><mn>0</mn></msub><annotation encoding="application/x-tex">H_{0}</annotation></semantics></math>, we have that <math id="A6.I4.i1.p1.m2" class="ltx_Math" alttext="\Delta_{i}=0" display="inline" intent=":literal"><semantics><mrow><msub><mi mathvariant="normal">Δ</mi><mi>i</mi></msub><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\Delta_{i}=0</annotation></semantics></math>, so that <math id="A6.I4.i1.p1.m3" class="ltx_Math" alttext="E_{i}" display="inline" intent=":literal"><semantics><msub><mi>E</mi><mi>i</mi></msub><annotation encoding="application/x-tex">E_{i}</annotation></semantics></math> occurs.</p>
</div></li>
<li id="A6.I4.i2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="A6.I4.i2.p1" class="ltx_para">
<p id="A6.I4.i2.p1.1" class="ltx_p">Under <math id="A6.I4.i2.p1.m1" class="ltx_Math" alttext="H_{1}" display="inline" intent=":literal"><semantics><msub><mi>H</mi><mn>1</mn></msub><annotation encoding="application/x-tex">H_{1}</annotation></semantics></math>, we have that <math id="A6.I4.i2.p1.m2" class="ltx_Math" alttext="\Delta_{i}\geq 0.3\epsilon" display="inline" intent=":literal"><semantics><mrow><msub><mi mathvariant="normal">Δ</mi><mi>i</mi></msub><mo>≥</mo><mrow><mn>0.3</mn><mo lspace="0em" rspace="0em">​</mo><mi>ϵ</mi></mrow></mrow><annotation encoding="application/x-tex">\Delta_{i}\geq 0.3\epsilon</annotation></semantics></math>, so that <math id="A6.I4.i2.p1.m3" class="ltx_Math" alttext="E_{i}^{c}" display="inline" intent=":literal"><semantics><msubsup><mi>E</mi><mi>i</mi><mi>c</mi></msubsup><annotation encoding="application/x-tex">E_{i}^{c}</annotation></semantics></math> occurs.</p>
</div></li>
</ul>
<p id="A6.SS2.p3.5" class="ltx_p">Importantly, this statement is <span id="A6.SS2.p3.5.1" class="ltx_text ltx_font_italic">unconditional</span>; that is, under no assumption of <math id="A6.SS2.p3.m19" class="ltx_Math" alttext="B_{i}" display="inline" intent=":literal"><semantics><msub><mi>B</mi><mi>i</mi></msub><annotation encoding="application/x-tex">B_{i}</annotation></semantics></math> occurring. Let <math id="A6.SS2.p3.m20" class="ltx_Math" alttext="\mathbb{P}_{i}" display="inline" intent=":literal"><semantics><msub><mi>ℙ</mi><mi>i</mi></msub><annotation encoding="application/x-tex">\mathbb{P}_{i}</annotation></semantics></math> denote the probability law under <math id="A6.SS2.p3.m21" class="ltx_Math" alttext="H_{i}" display="inline" intent=":literal"><semantics><msub><mi>H</mi><mi>i</mi></msub><annotation encoding="application/x-tex">H_{i}</annotation></semantics></math>, where we note that <math id="A6.SS2.p3.m22" class="ltx_Math" alttext="\mathbb{P}_{0}" display="inline" intent=":literal"><semantics><msub><mi>ℙ</mi><mn>0</mn></msub><annotation encoding="application/x-tex">\mathbb{P}_{0}</annotation></semantics></math> coincides with our earlier definition.</p>
</div>
<section id="A6.SS2.SSS0.Px1" class="ltx_paragraph">
<h4 class="ltx_title ltx_title_paragraph"><span id="A6.SS2.SSS0.Px1.1" class="ltx_text ltx_underline"><math id="A6.SS2.SSS0.Px1.m1" class="ltx_Math" alttext="\bm{H_{0}}" display="inline" intent=":literal"><semantics><msub><mi>𝑯</mi><mn>𝟎</mn></msub><annotation encoding="application/x-tex">\bm{H_{0}}</annotation></semantics></math></span>:</h4>

<div id="A6.SS2.SSS0.Px1.p1" class="ltx_para">
<table id="A6.EGx141" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A6.Ex187"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A6.Ex187.m1" class="ltx_Math" alttext="\displaystyle\mathbb{P}_{0}\mathinner{\left(\mathcal{A}_{s}=\mathsf{YES}\right)}" display="inline" intent=":literal"><semantics><mrow><msub><mi>ℙ</mi><mn>0</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><msub><mi class="ltx_font_mathcaligraphic">𝒜</mi><mi>s</mi></msub><mo>=</mo><mi>𝖸𝖤𝖲</mi></mrow><mo>)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\mathbb{P}_{0}\mathinner{\left(\mathcal{A}_{s}=\mathsf{YES}\right)}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A6.Ex187.m2" class="ltx_Math" alttext="\displaystyle=\mathbb{P}_{0}\mathinner{\left(B_{i}\cap E_{i}\right)}=\mathbb{P}_{0}\mathinner{\left(E_{i}\right)}-\mathbb{P}_{0}\mathinner{\left(B_{i}^{c}\cap E_{i}\right)}\geq\mathbb{P}_{0}\mathinner{\left(E_{i}\right)}-\mathbb{P}_{0}\mathinner{\left(B_{i}^{c}\right)}\geq 0.75" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><msub><mi>ℙ</mi><mn>0</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><msub><mi>B</mi><mi>i</mi></msub><mo>∩</mo><msub><mi>E</mi><mi>i</mi></msub></mrow><mo>)</mo></mrow></mrow><mo>=</mo><mrow><mrow><msub><mi>ℙ</mi><mn>0</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><msub><mi>E</mi><mi>i</mi></msub><mo>)</mo></mrow></mrow><mo>−</mo><mrow><msub><mi>ℙ</mi><mn>0</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><msubsup><mi>B</mi><mi>i</mi><mi>c</mi></msubsup><mo>∩</mo><msub><mi>E</mi><mi>i</mi></msub></mrow><mo>)</mo></mrow></mrow></mrow><mo>≥</mo><mrow><mrow><msub><mi>ℙ</mi><mn>0</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><msub><mi>E</mi><mi>i</mi></msub><mo>)</mo></mrow></mrow><mo>−</mo><mrow><msub><mi>ℙ</mi><mn>0</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><msubsup><mi>B</mi><mi>i</mi><mi>c</mi></msubsup><mo>)</mo></mrow></mrow></mrow><mo>≥</mo><mn>0.75</mn></mrow><annotation encoding="application/x-tex">\displaystyle=\mathbb{P}_{0}\mathinner{\left(B_{i}\cap E_{i}\right)}=\mathbb{P}_{0}\mathinner{\left(E_{i}\right)}-\mathbb{P}_{0}\mathinner{\left(B_{i}^{c}\cap E_{i}\right)}\geq\mathbb{P}_{0}\mathinner{\left(E_{i}\right)}-\mathbb{P}_{0}\mathinner{\left(B_{i}^{c}\right)}\geq 0.75</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
</section>
<section id="A6.SS2.SSS0.Px2" class="ltx_paragraph">
<h4 class="ltx_title ltx_title_paragraph"><span id="A6.SS2.SSS0.Px2.1" class="ltx_text ltx_underline"><math id="A6.SS2.SSS0.Px2.m1" class="ltx_Math" alttext="\bm{H_{1}}" display="inline" intent=":literal"><semantics><msub><mi>𝑯</mi><mn>𝟏</mn></msub><annotation encoding="application/x-tex">\bm{H_{1}}</annotation></semantics></math></span>:</h4>

<div id="A6.SS2.SSS0.Px2.p1" class="ltx_para">
<table id="A6.EGx142" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A6.Ex188"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A6.Ex188.m1" class="ltx_Math" alttext="\displaystyle\mathbb{P}_{1}\mathinner{\left(\mathcal{A}_{s}=\mathsf{NO}\right)}" display="inline" intent=":literal"><semantics><mrow><msub><mi>ℙ</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><msub><mi class="ltx_font_mathcaligraphic">𝒜</mi><mi>s</mi></msub><mo>=</mo><mi>𝖭𝖮</mi></mrow><mo>)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\mathbb{P}_{1}\mathinner{\left(\mathcal{A}_{s}=\mathsf{NO}\right)}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A6.Ex188.m2" class="ltx_Math" alttext="\displaystyle=\mathbb{P}_{1}\mathinner{\left(B_{i}^{c}\right)}+\mathbb{P}_{1}\mathinner{\left(B_{i}\cap E_{i}^{c}\right)}=\mathbb{P}_{1}\mathinner{\left(B_{i}^{c}\right)}+\mathbb{P}_{1}\mathinner{\left(E_{i}^{c}\right)}-\mathbb{P}_{1}\mathinner{\left(B_{i}^{c}\cap E_{i}^{c}\right)}\geq\mathbb{P}_{1}\mathinner{\left(E_{i}^{c}\right)}\geq 0.9" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><msub><mi>ℙ</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><msubsup><mi>B</mi><mi>i</mi><mi>c</mi></msubsup><mo>)</mo></mrow></mrow><mo>+</mo><mrow><msub><mi>ℙ</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><msub><mi>B</mi><mi>i</mi></msub><mo>∩</mo><msubsup><mi>E</mi><mi>i</mi><mi>c</mi></msubsup></mrow><mo>)</mo></mrow></mrow></mrow><mo>=</mo><mrow><mrow><mrow><msub><mi>ℙ</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><msubsup><mi>B</mi><mi>i</mi><mi>c</mi></msubsup><mo>)</mo></mrow></mrow><mo>+</mo><mrow><msub><mi>ℙ</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><msubsup><mi>E</mi><mi>i</mi><mi>c</mi></msubsup><mo>)</mo></mrow></mrow></mrow><mo>−</mo><mrow><msub><mi>ℙ</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><msubsup><mi>B</mi><mi>i</mi><mi>c</mi></msubsup><mo>∩</mo><msubsup><mi>E</mi><mi>i</mi><mi>c</mi></msubsup></mrow><mo>)</mo></mrow></mrow></mrow><mo>≥</mo><mrow><msub><mi>ℙ</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><msubsup><mi>E</mi><mi>i</mi><mi>c</mi></msubsup><mo>)</mo></mrow></mrow><mo>≥</mo><mn>0.9</mn></mrow><annotation encoding="application/x-tex">\displaystyle=\mathbb{P}_{1}\mathinner{\left(B_{i}^{c}\right)}+\mathbb{P}_{1}\mathinner{\left(B_{i}\cap E_{i}^{c}\right)}=\mathbb{P}_{1}\mathinner{\left(B_{i}^{c}\right)}+\mathbb{P}_{1}\mathinner{\left(E_{i}^{c}\right)}-\mathbb{P}_{1}\mathinner{\left(B_{i}^{c}\cap E_{i}^{c}\right)}\geq\mathbb{P}_{1}\mathinner{\left(E_{i}^{c}\right)}\geq 0.9</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A6.SS2.SSS0.Px2.p1.1" class="ltx_p">That is, we solve (<a href="#S6.Ex55" title="Equation SHT-Mass ‣ 6.1 Massart Testing ‣ 6 () Lower Bound ‣ Is Multi-Distribution Learning as Easy as PAC Learning: Sharp Rates with Bounded Label Noise" class="ltx_ref"><span class="ltx_text ltx_ref_tag">SHT-Mass</span></a>) with a sample size of at most</p>
<table id="A6.EGx143" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A6.Ex189"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A6.Ex189.m1" class="ltx_Math" alttext="\displaystyle\frac{0.05\sqrt{d}}{\epsilon}+1+\frac{80000}{\epsilon}\leq\frac{\sqrt{d}}{2\sqrt{2}\epsilon}" display="inline" intent=":literal"><semantics><mrow><mrow><mstyle displaystyle="true"><mfrac><mrow><mn>0.05</mn><mo lspace="0em" rspace="0em">​</mo><msqrt><mi>d</mi></msqrt></mrow><mi>ϵ</mi></mfrac></mstyle><mo>+</mo><mn>1</mn><mo>+</mo><mstyle displaystyle="true"><mfrac><mn>80000</mn><mi>ϵ</mi></mfrac></mstyle></mrow><mo>≤</mo><mstyle displaystyle="true"><mfrac><msqrt><mi>d</mi></msqrt><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msqrt><mn>2</mn></msqrt><mo lspace="0em" rspace="0em">​</mo><mi>ϵ</mi></mrow></mfrac></mstyle></mrow><annotation encoding="application/x-tex">\displaystyle\frac{0.05\sqrt{d}}{\epsilon}+1+\frac{80000}{\epsilon}\leq\frac{\sqrt{d}}{2\sqrt{2}\epsilon}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A6.SS2.SSS0.Px2.p1.2" class="ltx_p">beating the lower bound of <a href="#S6.Thmtheorem1" title="Theorem 6.1 (SHT-Mass lower bound). ‣ 6.1 Massart Testing ‣ 6 () Lower Bound ‣ Is Multi-Distribution Learning as Easy as PAC Learning: Sharp Rates with Bounded Label Noise" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Theorem</span> <span class="ltx_text ltx_ref_tag">6.1</span></a>. This contradiction ensures that</p>
<table id="A6.EGx144" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A6.Ex190"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A6.Ex190.m1" class="ltx_Math" alttext="\displaystyle\mathbb{P}_{0}\mathinner{\left(T_{i}&gt;\frac{0.05\sqrt{d}}{\epsilon}\right)}&gt;0.15\Longrightarrow\mathbb{E}_{0}\mathinner{\left[T_{i}\right]}\geq\mathbb{E}_{0}\mathinner{\left[T_{i}\mathbb{I}\mathinner{\left\{{T_{i}&gt;\frac{0.05\sqrt{d}}{\epsilon}}\right\}}\right]}\geq\frac{0.0075\sqrt{d}}{\epsilon}" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>ℙ</mi><mn>0</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><msub><mi>T</mi><mi>i</mi></msub><mo>&gt;</mo><mstyle displaystyle="true"><mfrac><mrow><mn>0.05</mn><mo lspace="0em" rspace="0em">​</mo><msqrt><mi>d</mi></msqrt></mrow><mi>ϵ</mi></mfrac></mstyle></mrow><mo>)</mo></mrow></mrow><mo>&gt;</mo><mn>0.15</mn><mo stretchy="false">⟹</mo><mrow><msub><mi>𝔼</mi><mn>0</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><msub><mi>T</mi><mi>i</mi></msub><mo>]</mo></mrow></mrow><mo>≥</mo><mrow><msub><mi>𝔼</mi><mn>0</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><mrow><msub><mi>T</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi>𝕀</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo>{</mo><mi>T</mi><msub><mrow></mrow><mi>i</mi></msub><mo>&gt;</mo><mstyle displaystyle="true"><mfrac><mrow><mn>0.05</mn><mo lspace="0em" rspace="0em">​</mo><msqrt><mi>d</mi></msqrt></mrow><mi>ϵ</mi></mfrac></mstyle><mo>}</mo></mrow></mrow><mo>]</mo></mrow></mrow><mo>≥</mo><mstyle displaystyle="true"><mfrac><mrow><mn>0.0075</mn><mo lspace="0em" rspace="0em">​</mo><msqrt><mi>d</mi></msqrt></mrow><mi>ϵ</mi></mfrac></mstyle></mrow><annotation encoding="application/x-tex">\displaystyle\mathbb{P}_{0}\mathinner{\left(T_{i}&gt;\frac{0.05\sqrt{d}}{\epsilon}\right)}&gt;0.15\Longrightarrow\mathbb{E}_{0}\mathinner{\left[T_{i}\right]}\geq\mathbb{E}_{0}\mathinner{\left[T_{i}\mathbb{I}\mathinner{\left\{{T_{i}&gt;\frac{0.05\sqrt{d}}{\epsilon}}\right\}}\right]}\geq\frac{0.0075\sqrt{d}}{\epsilon}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A6.SS2.SSS0.Px2.p1.3" class="ltx_p">Since this holds for each <math id="A6.SS2.SSS0.Px2.p1.m1" class="ltx_Math" alttext="i\in\mathinner{\left[k\right]}" display="inline" intent=":literal"><semantics><mrow><mi>i</mi><mo>∈</mo><mrow><mo>[</mo><mi>k</mi><mo>]</mo></mrow></mrow><annotation encoding="application/x-tex">i\in\mathinner{\left[k\right]}</annotation></semantics></math>, we finally get that</p>
<table id="A6.EGx145" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A6.Ex191"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A6.Ex191.m1" class="ltx_Math" alttext="\displaystyle T_{\mathcal{A}}\mathinner{\left(\frac{\epsilon}{192},\frac{0.1}{3}\right)}\geq\mathbb{E}_{0}\mathinner{\left[\sum_{i=1}^{k}T_{i}\right]}\geq\frac{0.0075k\sqrt{d}}{\epsilon}" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>T</mi><mi class="ltx_font_mathcaligraphic">𝒜</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mstyle displaystyle="true"><mfrac><mi>ϵ</mi><mn>192</mn></mfrac></mstyle><mo>,</mo><mstyle displaystyle="true"><mfrac><mn>0.1</mn><mn>3</mn></mfrac></mstyle><mo>)</mo></mrow></mrow><mo>≥</mo><mrow><msub><mi>𝔼</mi><mn>0</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>k</mi></munderover></mstyle><msub><mi>T</mi><mi>i</mi></msub></mrow><mo>]</mo></mrow></mrow><mo>≥</mo><mstyle displaystyle="true"><mfrac><mrow><mn>0.0075</mn><mo lspace="0em" rspace="0em">​</mo><mi>k</mi><mo lspace="0em" rspace="0em">​</mo><msqrt><mi>d</mi></msqrt></mrow><mi>ϵ</mi></mfrac></mstyle></mrow><annotation encoding="application/x-tex">\displaystyle T_{\mathcal{A}}\mathinner{\left(\frac{\epsilon}{192},\frac{0.1}{3}\right)}\geq\mathbb{E}_{0}\mathinner{\left[\sum_{i=1}^{k}T_{i}\right]}\geq\frac{0.0075k\sqrt{d}}{\epsilon}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
</section>
</section>
</section>
