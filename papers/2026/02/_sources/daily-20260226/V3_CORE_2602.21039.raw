              Function class <math id="alg4.l1.m1" class="ltx_Math" alttext="\mathcal{F}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">ℱ</mi><annotation encoding="application/x-tex">\mathcal{F}</annotation></semantics></math>, distribution <math id="alg4.l1.m2" class="ltx_Math" alttext="P" display="inline" intent=":literal"><semantics><mi>P</mi><annotation encoding="application/x-tex">P</annotation></semantics></math>, function <math id="alg4.l1.m3" class="ltx_Math" alttext="f\mathrel{\mathop{\mathchar 58\relax}}\mathcal{X}\to\mathinner{\left\{0,1\right\}}" display="inline" intent=":literal"><semantics><mrow><mi>f</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mi class="ltx_font_mathcaligraphic">𝒳</mi><mo stretchy="false">→</mo><mrow><mo>{</mo><mn>0</mn><mo>,</mo><mn>1</mn><mo>}</mo></mrow></mrow><annotation encoding="application/x-tex">f\mathrel{\mathop{\mathchar 58\relax}}\mathcal{X}\to\mathinner{\left\{0,1\right\}}</annotation></semantics></math>, parameters <math id="alg4.l1.m4" class="ltx_Math" alttext="\mathinner{\left(\epsilon,\delta\right)}\in\mathinner{\left(0,1\right)}^{2}" display="inline" intent=":literal"><semantics><mrow><mrow><mo>(</mo><mi>ϵ</mi><mo>,</mo><mi>δ</mi><mo>)</mo></mrow><mo>∈</mo><msup><mrow><mo>(</mo><mn>0</mn><mo>,</mo><mn>1</mn><mo>)</mo></mrow><mn>2</mn></msup></mrow><annotation encoding="application/x-tex">\mathinner{\left(\epsilon,\delta\right)}\in\mathinner{\left(0,1\right)}^{2}</annotation></semantics></math>.

