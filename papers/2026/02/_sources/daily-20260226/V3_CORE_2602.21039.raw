<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex144.m1" class="ltx_Math" alttext="\displaystyle=0.762" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mn>0.762</mn></mrow><annotation encoding="application/x-tex">\displaystyle=0.762</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
