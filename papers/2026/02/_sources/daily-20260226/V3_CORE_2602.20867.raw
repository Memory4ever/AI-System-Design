<td id="S7.T6.2.1.2.1" class="ltx_td ltx_align_center ltx_border_r ltx_border_t"><span id="S7.T6.2.1.2.1.1" class="ltx_text" style="--ltx-bg-color:#FBF5EC;">1</span></td>
<td id="S7.T6.2.1.2.2" class="ltx_td ltx_align_center ltx_border_r ltx_border_t"><span id="S7.T6.2.1.2.2.1" class="ltx_text" style="--ltx-bg-color:#FBF5EC;">Metadata progressive disclosure</span></td>
<td id="S7.T6.2.1.2.3" class="ltx_td ltx_align_left ltx_align_middle ltx_border_r ltx_border_t">
<span id="S7.T6.2.1.2.3.1" class="ltx_inline-block ltx_align_middle" style="width:156.5pt;--ltx-bg-color:#FBF5EC;">
<span id="S7.T6.2.1.2.3.1.1" class="ltx_p ltx_align_left">Metadata poisoning; misleading descriptions</span>
</span></td>
<td id="S7.T6.2.1.2.4" class="ltx_td ltx_align_left ltx_align_middle ltx_border_r ltx_border_t">
<span id="S7.T6.2.1.2.4.1" class="ltx_inline-block ltx_align_middle" style="width:142.3pt;--ltx-bg-color:#FBF5EC;">
<span id="S7.T6.2.1.2.4.1.1" class="ltx_p ltx_align_left">Metadata schema validation; human review for high-privilege skills</span>
</span></td>
<td id="S7.T6.2.1.2.5" class="ltx_td ltx_align_center ltx_border_t"><span id="S7.T6.2.1.2.5.1" class="ltx_text" style="--ltx-bg-color:#FBF5EC;">Medium</span></td></tr>
<tr id="S7.T6.2.1.3" class="ltx_tr">
<td id="S7.T6.2.1.3.1" class="ltx_td ltx_align_center ltx_border_r">2</td>
<td id="S7.T6.2.1.3.2" class="ltx_td ltx_align_center ltx_border_r">Code-as-skill</td>
<td id="S7.T6.2.1.3.3" class="ltx_td ltx_align_left ltx_align_middle ltx_border_r">
<span id="S7.T6.2.1.3.3.1" class="ltx_inline-block ltx_align_middle" style="width:156.5pt;">
<span id="S7.T6.2.1.3.3.1.1" class="ltx_p ltx_align_left">Code injection; sandbox escape; dependency vulnerabilities</span>
</span></td>
<td id="S7.T6.2.1.3.4" class="ltx_td ltx_align_left ltx_align_middle ltx_border_r">
<span id="S7.T6.2.1.3.4.1" class="ltx_inline-block ltx_align_middle" style="width:142.3pt;">
<span id="S7.T6.2.1.3.4.1.1" class="ltx_p ltx_align_left">Container sandboxing; static analysis; dependency scanning</span>
</span></td>
<td id="S7.T6.2.1.3.5" class="ltx_td ltx_align_center">High</td></tr>
<tr id="S7.T6.2.1.4" class="ltx_tr" style="--ltx-bg-color:#FBF5EC;">
<td id="S7.T6.2.1.4.1" class="ltx_td ltx_align_center ltx_border_r"><span id="S7.T6.2.1.4.1.1" class="ltx_text" style="--ltx-bg-color:#FBF5EC;">3</span></td>
<td id="S7.T6.2.1.4.2" class="ltx_td ltx_align_center ltx_border_r"><span id="S7.T6.2.1.4.2.1" class="ltx_text" style="--ltx-bg-color:#FBF5EC;">Workflow enforcement</span></td>
<td id="S7.T6.2.1.4.3" class="ltx_td ltx_align_left ltx_align_middle ltx_border_r">
