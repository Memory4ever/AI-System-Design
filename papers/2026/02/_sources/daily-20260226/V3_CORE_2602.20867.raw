<td id="S5.T4.2.1.1.2" class="ltx_td ltx_align_center ltx_border_r ltx_border_tt"><span id="S5.T4.2.1.1.2.1" class="ltx_text ltx_font_bold">Context cost</span></td>
<td id="S5.T4.2.1.1.3" class="ltx_td ltx_align_center ltx_border_r ltx_border_tt"><span id="S5.T4.2.1.1.3.1" class="ltx_text ltx_font_bold">Determinism</span></td>
<td id="S5.T4.2.1.1.4" class="ltx_td ltx_align_center ltx_border_r ltx_border_tt"><span id="S5.T4.2.1.1.4.1" class="ltx_text ltx_font_bold">Composability</span></td>
