<div id="S4.T2.2.1.1.7.1" class="ltx_inline-block ltx_transformed_outer" style="width:21.3pt;height:38.7pt;vertical-align:-0.7pt;"><span class="ltx_transformed_inner" style="width:38.0pt;transform:translate(-8.4pt,-14.9pt) rotate(-70deg) ;">
<p id="S4.T2.2.1.1.7.1.1" class="ltx_p"><span id="S4.T2.2.1.1.7.1.1.1" class="ltx_text ltx_font_bold">Storage</span></p>
</span></div></td>
