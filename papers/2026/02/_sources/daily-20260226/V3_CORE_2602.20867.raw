<span id="S5.T3.2.1.3.3.1" class="ltx_inline-block ltx_align_middle" style="width:94.5pt;">
<span id="S5.T3.2.1.3.3.1.1" class="ltx_p ltx_align_left">Voyager, CodeAct, SWE-agent</span>
</span></td>
<td id="S5.T3.2.1.3.4" class="ltx_td ltx_align_center ltx_border_r">Code</td>
<td id="S5.T3.2.1.3.5" class="ltx_td ltx_align_left ltx_align_middle ltx_border_r">
<span id="S5.T3.2.1.3.5.1" class="ltx_inline-block ltx_align_middle" style="width:82.5pt;">
<span id="S5.T3.2.1.3.5.1.1" class="ltx_p ltx_align_left">Deterministic; testable; composable</span>
</span></td>
<td id="S5.T3.2.1.3.6" class="ltx_td ltx_align_left ltx_align_middle ltx_border_r">
<span id="S5.T3.2.1.3.6.1" class="ltx_inline-block ltx_align_middle" style="width:76.8pt;">
<span id="S5.T3.2.1.3.6.1.1" class="ltx_p ltx_align_left">Requires sandbox; brittle to API changes</span>
</span></td>
<td id="S5.T3.2.1.3.7" class="ltx_td ltx_align_left ltx_align_middle">
<span id="S5.T3.2.1.3.7.1" class="ltx_inline-block ltx_align_middle" style="width:71.1pt;">
<span id="S5.T3.2.1.3.7.1.1" class="ltx_p ltx_align_left">Code injection</span>
</span></td></tr>
