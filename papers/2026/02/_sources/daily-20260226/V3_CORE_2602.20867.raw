<span id="S2.T1.2.1.6.5.2.1" class="ltx_tabular ltx_align_middle">
<span id="S2.T1.2.1.6.5.2.1.1" class="ltx_tr">
<span id="S2.T1.2.1.6.5.2.1.1.1" class="ltx_td ltx_nopad_r ltx_align_center">Hierarchical,</span></span>
<span id="S2.T1.2.1.6.5.2.1.2" class="ltx_tr">
<span id="S2.T1.2.1.6.5.2.1.2.1" class="ltx_td ltx_nopad_r ltx_align_center">DAG, recursive</span></span>
</span></span><span id="S2.T1.2.1.6.5.3" class="ltx_text"></span></td>
