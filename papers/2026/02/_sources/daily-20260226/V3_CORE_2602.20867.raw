<span id="S5.T3.2.1.2.3.1" class="ltx_inline-block ltx_align_middle" style="width:94.5pt;--ltx-bg-color:#F9F4EB;">
<span id="S5.T3.2.1.2.3.1.1" class="ltx_p ltx_align_left">Claude Code, Semantic Kernel, LangChain</span>
</span></td>
<td id="S5.T3.2.1.2.4" class="ltx_td ltx_align_center ltx_border_r ltx_border_t"><span id="S5.T3.2.1.2.4.1" class="ltx_text" style="--ltx-bg-color:#F9F4EB;">NL + metadata</span></td>
<td id="S5.T3.2.1.2.5" class="ltx_td ltx_align_left ltx_align_middle ltx_border_r ltx_border_t">
<span id="S5.T3.2.1.2.5.1" class="ltx_inline-block ltx_align_middle" style="width:82.5pt;--ltx-bg-color:#F9F4EB;">
<span id="S5.T3.2.1.2.5.1.1" class="ltx_p ltx_align_left">Token efficiency; scales to large libraries</span>
</span></td>
<td id="S5.T3.2.1.2.6" class="ltx_td ltx_align_left ltx_align_middle ltx_border_r ltx_border_t">
<span id="S5.T3.2.1.2.6.1" class="ltx_inline-block ltx_align_middle" style="width:76.8pt;--ltx-bg-color:#F9F4EB;">
<span id="S5.T3.2.1.2.6.1.1" class="ltx_p ltx_align_left">Retrieval quality depends on metadata</span>
</span></td>
<td id="S5.T3.2.1.2.7" class="ltx_td ltx_align_left ltx_align_middle ltx_border_t">
<span id="S5.T3.2.1.2.7.1" class="ltx_inline-block ltx_align_middle" style="width:71.1pt;--ltx-bg-color:#F9F4EB;">
