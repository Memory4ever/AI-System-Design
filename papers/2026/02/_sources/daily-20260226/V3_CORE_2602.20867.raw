<td id="S2.T1.2.1.6.4" class="ltx_td ltx_align_center ltx_border_bb ltx_border_r ltx_border_t"><span id="S2.T1.2.1.6.4.1" class="ltx_text"></span> <span id="S2.T1.2.1.6.4.2" class="ltx_text">
<span id="S2.T1.2.1.6.4.2.1" class="ltx_tabular ltx_align_middle">
<span id="S2.T1.2.1.6.4.2.1.1" class="ltx_tr">
<span id="S2.T1.2.1.6.4.2.1.1.1" class="ltx_td ltx_nopad_r ltx_align_center">Outcome</span></span>
