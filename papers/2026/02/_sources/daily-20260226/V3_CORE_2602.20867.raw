<td id="S4.T2.2.1.2.9" class="ltx_td ltx_align_center ltx_border_t">✓</td>
<td id="S4.T2.2.1.2.10" class="ltx_td ltx_align_center ltx_border_r ltx_border_t"><math id="S4.T2.m3" class="ltx_Math" alttext="\sim" display="inline" intent=":literal"><semantics><mo style="--ltx-fg-color:#FF8000;" mathcolor="#FF8000">∼</mo><annotation encoding="application/x-tex">\sim</annotation></semantics></math></td>
<td id="S4.T2.2.1.2.11" class="ltx_td ltx_align_center ltx_border_t">Code</td></tr>
<tr id="S4.T2.2.1.3" class="ltx_tr">
<td id="S4.T2.2.1.3.1" class="ltx_td ltx_align_center ltx_border_r">JARVIS-1 <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib14" title="" class="ltx_ref">36</a>]</cite></td>
