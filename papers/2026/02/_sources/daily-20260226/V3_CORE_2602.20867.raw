<td id="S5.T5.2.1.7.1" class="ltx_td ltx_align_center ltx_border_r">WebArena agents <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib4" title="" class="ltx_ref">1</a>]</cite></td>
<td id="S5.T5.2.1.7.2" class="ltx_td ltx_align_center ltx_border_r">2, 3</td>
<td id="S5.T5.2.1.7.3" class="ltx_td ltx_align_center ltx_border_r">Code/NL</td>
<td id="S5.T5.2.1.7.4" class="ltx_td ltx_align_center ltx_border_r">Web</td>
<td id="S5.T5.2.1.7.5" class="ltx_td ltx_align_center ltx_border_r">Pre-defined</td>
<td id="S5.T5.2.1.7.6" class="ltx_td ltx_align_center ltx_border_r">Browser</td>
<td id="S5.T5.2.1.7.7" class="ltx_td ltx_align_center ltx_border_r">Task reward</td>
<td id="S5.T5.2.1.7.8" class="ltx_td ltx_align_center">Sandboxed</td></tr>
<tr id="S5.T5.2.1.8" class="ltx_tr">
<td id="S5.T5.2.1.8.1" class="ltx_td ltx_align_center ltx_border_r">HuggingGPT <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib7" title="" class="ltx_ref">4</a>]</cite></td>
<td id="S5.T5.2.1.8.2" class="ltx_td ltx_align_center ltx_border_r">1, 7</td>
<td id="S5.T5.2.1.8.3" class="ltx_td ltx_align_center ltx_border_r">Hybrid</td>
<td id="S5.T5.2.1.8.4" class="ltx_td ltx_align_center ltx_border_r">Multi</td>
<td id="S5.T5.2.1.8.5" class="ltx_td ltx_align_center ltx_border_r">Pre-registered</td>
