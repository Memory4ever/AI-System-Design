<td id="S2.T1.2.1.1.2" class="ltx_td ltx_align_center ltx_border_r ltx_border_tt"><span id="S2.T1.2.1.1.2.1" class="ltx_text ltx_font_bold">Unit of Reuse</span></td>
<td id="S2.T1.2.1.1.3" class="ltx_td ltx_align_center ltx_border_r ltx_border_tt"><span id="S2.T1.2.1.1.3.1" class="ltx_text ltx_font_bold">Execution Semantics</span></td>
