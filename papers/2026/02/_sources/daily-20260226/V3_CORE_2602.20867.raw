<td id="S5.T5.2.1.1.2" class="ltx_td ltx_align_center ltx_border_r ltx_border_tt"><span id="S5.T5.2.1.1.2.1" class="ltx_text ltx_font_bold">Pattern(s)</span></td>
<td id="S5.T5.2.1.1.3" class="ltx_td ltx_align_center ltx_border_r ltx_border_tt"><span id="S5.T5.2.1.1.3.1" class="ltx_text ltx_font_bold">Representation</span></td>
<td id="S5.T5.2.1.1.4" class="ltx_td ltx_align_center ltx_border_r ltx_border_tt"><span id="S5.T5.2.1.1.4.1" class="ltx_text ltx_font_bold">Scope</span></td>
<td id="S5.T5.2.1.1.5" class="ltx_td ltx_align_center ltx_border_r ltx_border_tt"><span id="S5.T5.2.1.1.5.1" class="ltx_text ltx_font_bold">Acquisition</span></td>
