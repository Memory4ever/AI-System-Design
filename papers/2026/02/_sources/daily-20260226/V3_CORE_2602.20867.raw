<td id="S7.T6.2.1.6.1" class="ltx_td ltx_align_center ltx_border_r"><span id="S7.T6.2.1.6.1.1" class="ltx_text" style="--ltx-bg-color:#FBF5EC;">5</span></td>
<td id="S7.T6.2.1.6.2" class="ltx_td ltx_align_center ltx_border_r"><span id="S7.T6.2.1.6.2.1" class="ltx_text" style="--ltx-bg-color:#FBF5EC;">Hybrid NL+code macros</span></td>
