<div id="algx1.l12" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline"><span id="algx1.l12.1" class="ltx_text" style="font-size:80%;">12:</span></span>
            
            
                <math id="algx1.l12.m1" class="ltx_math_unparsed" alttext="\tilde{a}_{t+1}\sim\pi_{\phi}(\cdot|z_{t+1},s_{t+1}^{\text{proprio}})" display="inline" intent=":literal"><semantics><mrow><msub><mover accent="true"><mi>a</mi><mo>~</mo></mover><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow></msub><mo>∼</mo><msub><mi>π</mi><mi>ϕ</mi></msub><mrow><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><msub><mi>z</mi><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow></msub><mo>,</mo><msubsup><mi>s</mi><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow><mtext>proprio</mtext></msubsup><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\tilde{a}_{t+1}\sim\pi_{\phi}(\cdot|z_{t+1},s_{t+1}^{\text{proprio}})</annotation></semantics></math>

</div>
<div id="algx1.l13" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline"><span id="algx1.l13.1" class="ltx_text" style="font-size:80%;">13:</span></span>
            
            
                <math id="algx1.l13.m1" class="ltx_Math" alttext="y=r_{t}+\dfrac{\gamma}{2}\displaystyle\sum_{i=1}^{2}\left(Q_{\bar{\theta}_{i}}(z_{t+1},s_{t+1}^{\text{proprio}},\tilde{a}_{t+1})-\alpha\log\pi_{\phi}(\tilde{a}_{t+1}|z_{t+1},s_{t+1}^{\text{proprio}})\right)" display="inline" intent=":literal"><semantics><mrow><mi>y</mi><mo>=</mo><mrow><msub><mi>r</mi><mi>t</mi></msub><mo>+</mo><mrow><mstyle displaystyle="true"><mfrac><mi>γ</mi><mn>2</mn></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mn>2</mn></munderover></mstyle><mrow><mo>(</mo><mrow><mrow><msub><mi>Q</mi><msub><mover accent="true"><mi>θ</mi><mo>¯</mo></mover><mi>i</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>z</mi><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow></msub><mo>,</mo><msubsup><mi>s</mi><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow><mtext>proprio</mtext></msubsup><mo>,</mo><msub><mover accent="true"><mi>a</mi><mo>~</mo></mover><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mi>α</mi><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><msub><mi>π</mi><mi>ϕ</mi></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi>a</mi><mo>~</mo></mover><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow></msub><mo lspace="0em" rspace="0em">|</mo><mrow><msub><mi>z</mi><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow></msub><mo>,</mo><msubsup><mi>s</mi><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow><mtext>proprio</mtext></msubsup></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>)</mo></mrow></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">y=r_{t}+\dfrac{\gamma}{2}\displaystyle\sum_{i=1}^{2}\left(Q_{\bar{\theta}_{i}}(z_{t+1},s_{t+1}^{\text{proprio}},\tilde{a}_{t+1})-\alpha\log\pi_{\phi}(\tilde{a}_{t+1}|z_{t+1},s_{t+1}^{\text{proprio}})\right)</annotation></semantics></math>

</div>
