/mo><mrow><mo stretchy="false">{</mo><mrow><mn>1</mn><mo>,</mo><mn>2</mn></mrow><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">i\in\{1,2\}</annotation></semantics></math>

</div>
