<span id="S5.T1.10.9.7.1.1" class="ltx_p">24.7</span>
</span></td>
<td id="S5.T1.10.9.8" class="ltx_td ltx_align_center" style="padding-left:5.5pt;padding-right:5.5pt;">
<span id="S5.T1.10.9.8.1" class="ltx_inline-block ltx_align_top">
<span id="S5.T1.10.9.8.1.1" class="ltx_p">31.5</span>
</span></td></tr>
