<td id="S5.T1.10.10.2" class="ltx_td ltx_align_center ltx_border_bb ltx_border_r" style="padding-left:5.5pt;padding-right:5.5pt;"><span id="S5.T1.10.10.2.1" class="ltx_text ltx_font_bold" style="--ltx-bg-color:#F2F2FF;">1%</span></td>
<td id="S5.T1.10.10.3" class="ltx_td ltx_align_center ltx_border_bb ltx_border_r" style="padding-left:5.5pt;padding-right:5.5pt;"><span id="S5.T1.10.10.3.1" class="ltx_text ltx_underline" style="--ltx-bg-color:#F2F2FF;">33.2</span></td>
<td id="S5.T1.10.10.4" class="ltx_td ltx_align_center ltx_border_bb" style="padding-left:5.5pt;padding-right:5.5pt;"><span id="S5.T1.10.10.4.1" class="ltx_text ltx_underline" style="--ltx-bg-color:#F2F2FF;">38.0</span></td>
<td id="S5.T1.10.10.5" class="ltx_td ltx_align_center ltx_border_bb ltx_border_r" style="padding-left:5.5pt;padding-right:5.5pt;"><span id="S5.T1.10.10.5.1" class="ltx_text ltx_font_bold" style="--ltx-bg-color:#F2F2FF;">30.2</span></td>
