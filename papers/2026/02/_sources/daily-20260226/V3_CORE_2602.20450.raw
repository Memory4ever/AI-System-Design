<th id="S7.T3.2.1.1.3" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_r ltx_border_t"><math id="S7.T3.m4" class="ltx_Math" alttext="\eta=3" display="inline" intent=":literal"><semantics><mrow><mi>η</mi><mo>=</mo><mn>3</mn></mrow><annotation encoding="application/x-tex">\eta=3</annotation></semantics></math></th>
<th id="S7.T3.2.1.1.4" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_r ltx_border_t"><math id="S7.T3.m5" class="ltx_Math" alttext="\eta=4" display="inline" intent=":literal"><semantics><mrow><mi>η</mi><mo>=</mo><mn>4</mn></mrow><annotation encoding="application/x-tex">\eta=4</annotation></semantics></math></th></tr>
