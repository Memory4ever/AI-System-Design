<div id="S7.T3.2" class="ltx_inline-block ltx_align_center ltx_transformed_outer" style="width:241.5pt;height:59.8pt;vertical-align:-26.9pt;"><span class="ltx_transformed_inner" style="transform:translate(19.7pt,-4.9pt) scale(1.19537247396549,1.19537247396549) ;">
<table id="S7.T3.2.1" class="ltx_tabular ltx_guessed_headers ltx_align_middle">
