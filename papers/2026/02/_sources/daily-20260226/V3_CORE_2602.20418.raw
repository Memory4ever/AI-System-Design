<td id="A4.T21.8.3.2" class="ltx_td ltx_align_center"><math id="A4.T21.m10" class="ltx_Math" alttext="1.18\pm 0.01" display="inline" intent=":literal"><semantics><mrow><mn mathsize="0.500em">1.18</mn><mo mathsize="0.500em">±</mo><mn mathsize="0.500em">0.01</mn></mrow><annotation encoding="application/x-tex">1.18\pm 0.01</annotation></semantics></math></td>
