<td id="S5.T2.11.7.4" class="ltx_td ltx_nopad_l ltx_nopad_r ltx_align_center ltx_border_bb" style="padding-left:1.2pt;padding-right:1.2pt;"><math id="S5.T2.m40" class="ltx_Math" alttext="58.16\pm 4.0" display="inline" intent=":literal"><semantics><mrow><mn class="ltx_mathvariant_bold" mathsize="0.700em" mathvariant="bold">58.16</mn><mo class="ltx_mathvariant_bold" mathsize="0.700em" mathvariant="bold">±</mo><mn class="ltx_mathvariant_bold" mathsize="0.700em" mathvariant="bold">4.0</mn></mrow><annotation encoding="application/x-tex">58.16\pm 4.0</annotation></semantics></math></td>
<td id="S5.T2.11.7.5" class="ltx_td ltx_nopad_l ltx_nopad_r ltx_align_center ltx_border_bb" style="padding-left:1.2pt;padding-right:1.2pt;"><math id="S5.T2.m41" class="ltx_Math" alttext="45.07\pm 8.48" display="inline" intent=":literal"><semantics><mrow><mn class="ltx_mathvariant_bold" mathsize="0.700em" mathvariant="bold">45.07</mn><mo class="ltx_mathvariant_bold" mathsize="0.700em" mathvariant="bold">±</mo><mn class="ltx_mathvariant_bold" mathsize="0.700em" mathvariant="bold">8.48</mn></mrow><annotation encoding="application/x-tex">45.07\pm 8.48</annotation></semantics></math></td>
