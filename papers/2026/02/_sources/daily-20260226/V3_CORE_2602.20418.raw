<td id="A3.T4.5.6.5" class="ltx_td ltx_align_center">8</td></tr>
<tr id="A3.T4.5.7" class="ltx_tr">
<td id="A3.T4.5.7.1" class="ltx_td ltx_align_left">Coauthor-CS</td>
<td id="A3.T4.5.7.2" class="ltx_td ltx_align_center">18,333</td>
<td id="A3.T4.5.7.3" class="ltx_td ltx_align_center">163,788</td>
<td id="A3.T4.5.7.4" class="ltx_td ltx_align_center">6,805</td>
<td id="A3.T4.5.7.5" class="ltx_td ltx_align_center">15</td></tr>
