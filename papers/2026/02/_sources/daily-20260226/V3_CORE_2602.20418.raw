<td id="A4.T21.8.2.8" class="ltx_td ltx_align_center ltx_border_t"><math id="A4.T21.m9" class="ltx_Math" alttext="0.05\pm 0.06" display="inline" intent=":literal"><semantics><mrow><mn mathsize="0.500em">0.05</mn><mo mathsize="0.500em">±</mo><mn mathsize="0.500em">0.06</mn></mrow><annotation encoding="application/x-tex">0.05\pm 0.06</annotation></semantics></math></td></tr>
