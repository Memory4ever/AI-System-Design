<td id="S5.T2.11.7.2" class="ltx_td ltx_nopad_l ltx_nopad_r ltx_align_center ltx_border_bb" style="padding-left:1.2pt;padding-right:1.2pt;"><math id="S5.T2.m38" class="ltx_Math" alttext="47.07\pm 11.3" display="inline" intent=":literal"><semantics><mrow><mn class="ltx_mathvariant_bold" mathsize="0.700em" mathvariant="bold">47.07</mn><mo class="ltx_mathvariant_bold" mathsize="0.700em" mathvariant="bold">±</mo><mn class="ltx_mathvariant_bold" mathsize="0.700em" mathvariant="bold">11.3</mn></mrow><annotation encoding="application/x-tex">47.07\pm 11.3</annotation></semantics></math></td>
