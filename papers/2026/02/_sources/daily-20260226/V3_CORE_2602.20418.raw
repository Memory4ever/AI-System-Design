<td id="A4.T21.8.3.8" class="ltx_td ltx_align_center"><math id="A4.T21.m16" class="ltx_Math" alttext="19.45\pm 0.01" display="inline" intent=":literal"><semantics><mrow><mn mathsize="0.500em">19.45</mn><mo mathsize="0.500em">±</mo><mn mathsize="0.500em">0.01</mn></mrow><annotation encoding="application/x-tex">19.45\pm 0.01</annotation></semantics></math></td></tr>
<tr id="A4.T21.8.4" class="ltx_tr">
<td id="A4.T21.8.4.1" class="ltx_td ltx_align_left ltx_border_bb"><span id="A4.T21.8.4.1.1" class="ltx_text" style="font-size:50%;">Percentage (%)</span></td>
