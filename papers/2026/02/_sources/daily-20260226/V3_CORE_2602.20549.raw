<td id="A5.T2.2.2.5" class="ltx_td ltx_align_center ltx_border_t" style="padding-top:1pt;padding-bottom:1pt;"><span id="A5.T2.2.2.5.1" class="ltx_text ltx_font_bold">GT 8 Model 6</span></td>
<td id="A5.T2.2.2.6" class="ltx_td ltx_align_center ltx_border_t" style="padding-top:1pt;padding-bottom:1pt;"><span id="A5.T2.2.2.6.1" class="ltx_text ltx_font_bold">GT 8 Model 7</span></td>
