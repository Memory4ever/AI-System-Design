<td id="A5.T2.2.1.3" class="ltx_td ltx_align_center ltx_border_r ltx_border_t" style="padding-top:1pt;padding-bottom:1pt;" colspan="3"><math id="A5.T2.m2" class="ltx_Math" alttext="\sigma_{\min}=0.05" display="inline" intent=":literal"><semantics><mrow><msub><mi>σ</mi><mi>min</mi></msub><mo>=</mo><mn>0.05</mn></mrow><annotation encoding="application/x-tex">\sigma_{\min}=0.05</annotation></semantics></math></td></tr>
