<td id="S4.T1.2.8.6" class="ltx_td ltx_align_center" style="padding-top:0.5pt;padding-bottom:0.5pt;"><math id="S4.T1.m39" class="ltx_Math" alttext="-259.1\pm 2.9" display="inline" intent=":literal"><semantics><mrow><mrow><mo>−</mo><mn>259.1</mn></mrow><mo>±</mo><mn>2.9</mn></mrow><annotation encoding="application/x-tex">-259.1\pm 2.9</annotation></semantics></math></td>
