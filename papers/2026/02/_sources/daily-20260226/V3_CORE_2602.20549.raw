<td id="A5.T2.2.4.2" class="ltx_td ltx_align_center ltx_border_t" style="padding-top:1pt;padding-bottom:1pt;"><math id="A5.T2.m9" class="ltx_Math" alttext="-183\pm 7" display="inline" intent=":literal"><semantics><mrow><mrow><mo>−</mo><mn>183</mn></mrow><mo>±</mo><mn>7</mn></mrow><annotation encoding="application/x-tex">-183\pm 7</annotation></semantics></math></td>
<td id="A5.T2.2.4.3" class="ltx_td ltx_align_center ltx_border_t" style="padding-top:1pt;padding-bottom:1pt;"><math id="A5.T2.m10" class="ltx_Math" alttext="-224\pm 5" display="inline" intent=":literal"><semantics><mrow><mrow><mo>−</mo><mn>224</mn></mrow><mo>±</mo><mn>5</mn></mrow><annotation encoding="application/x-tex">-224\pm 5</annotation></semantics></math></td>
