            <span id="lstnumberx34.2" class="ltx_text ltx_lst_space ltx_font_typewriter">            </span><span id="lstnumberx34.3" class="ltx_text ltx_lst_literate ltx_font_typewriter" style="--ltx-fg-color:#009400;">"</span><span id="lstnumberx34.4" class="ltx_text ltx_lst_identifier ltx_font_typewriter">name</span><span id="lstnumberx34.5" class="ltx_text ltx_lst_literate ltx_font_typewriter" style="--ltx-fg-color:#009400;">"</span><span id="lstnumberx34.6" class="ltx_text ltx_lst_literate ltx_font_typewriter">:</span><span id="lstnumberx34.7" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx34.8" class="ltx_text ltx_lst_literate ltx_font_typewriter" style="--ltx-fg-color:#009400;">"</span><span id="lstnumberx34.9" class="ltx_text ltx_lst_identifier ltx_font_typewriter">cup</span><span id="lstnumberx34.10" class="ltx_text ltx_lst_literate ltx_font_typewriter" style="--ltx-fg-color:#009400;">"</span><span id="lstnumberx34.11" class="ltx_text ltx_lst_literate ltx_font_typewriter">,</span>
</div>
<div id="lstnumberx35" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline">10</span>
              
              
              
              
              
              
              
            <span id="lstnumberx35.2" class="ltx_text ltx_lst_space ltx_font_typewriter">            </span><span id="lstnumberx35.3" class="ltx_text ltx_lst_literate ltx_font_typewriter" style="--ltx-fg-color:#009400;">"</span><span id="lstnumberx35.4" class="ltx_text ltx_lst_identifier ltx_font_typewriter">attributes</span><span id="lstnumberx35.5" class="ltx_text ltx_lst_literate ltx_font_typewriter" style="--ltx-fg-color:#009400;">"</span><span id="lstnumberx35.6" class="ltx_text ltx_lst_literate ltx_font_typewriter">:</span><span id="lstnumberx35.7" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx35.8" class="ltx_text ltx_font_typewriter">[</span><span id="lstnumberx35.9" class="ltx_text ltx_lst_literate ltx_font_typewriter" style="--ltx-fg-color:#009400;">"</span><span id="lstnumberx35.10" class="ltx_text ltx_lst_identifier ltx_font_typewriter">ceramic</span><span id="lstnumberx35.11" class="ltx_text ltx_lst_literate ltx_font_typewriter" style="--ltx-fg-color:#009400;">"</span><span id="lstnumberx35.12" class="ltx_text ltx_lst_literate ltx_font_typewriter">,</span><span id="lstnumberx35.13" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx35.14" class="ltx_text ltx_lst_literate ltx_font_typewriter" style="--ltx-fg-color:#009400;">"</span><span id="lstnumberx35.15" class="ltx_text ltx_lst_identifier ltx_font_typewriter">empty</span><span id="lstnumberx35.16" class="ltx_text ltx_lst_literate ltx_font_typewriter" style="--ltx-fg-color:#009400;">"</span><span id="lstnumberx35.17" class="ltx_text ltx_lst_literate ltx_font_typewriter">,</span><span id="lstnumberx35.18" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx35.19" class="ltx_text ltx_lst_literate ltx_font_typewriter" style="--ltx-fg-color:#009400;">"</span><span id="lstnumberx35.20" class="ltx_text ltx_lst_identifier ltx_font_typewriter">handle</span><span id="lstnumberx35.21" class="ltx_text ltx_lst_space ltx_font_t