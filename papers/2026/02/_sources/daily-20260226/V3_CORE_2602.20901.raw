            <span id="lstnumberx42.2" class="ltx_text ltx_lst_space ltx_font_typewriter">        </span><span id="lstnumberx42.3" class="ltx_text ltx_font_typewriter">{</span><span id="lstnumberx42.4" class="ltx_text ltx_lst_literate ltx_font_typewriter" style="--ltx-fg-color:#009400;">"</span><span id="lstnumberx42.5" class="ltx_text ltx_lst_identifier ltx_font_typewriter">source</span><span id="lstnumberx42.6" class="ltx_text ltx_lst_literate ltx_font_typewriter" style="--ltx-fg-color:#009400;">"</span><span id="lstnumberx42.7" class="ltx_text ltx_lst_literate ltx_font_typewriter">:</span><span id="lstnumberx42.8" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx42.9" class="ltx_text ltx_lst_literate ltx_font_typewriter" style="--ltx-fg-color:#009400;">"</span><span id="lstnumberx42.10" class="ltx_text ltx_lst_identifier ltx_font_typewriter">teapot</span><span id="lstnumberx42.11" class="ltx_text ltx_lst_literate ltx_font_typewriter" style="--ltx-fg-color:#009400;">"</span><span id="lstnumberx42.12" class="ltx_text ltx_lst_literate ltx_font_typewriter">,</span><span id="lstnumberx42.13" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx42.14" class="ltx_text ltx_lst_literate ltx_font_typewriter" style="--ltx-fg-color:#009400;">"</span><span id="lstnumberx42.15" class="ltx_text ltx_lst_identifier ltx_font_typewriter">relation</span><span id="lstnumberx42.16" class="ltx_text ltx_lst_literate ltx_font_typewriter" style="--ltx-fg-color:#009400;">"</span><span id="lstnumberx42.17" class="ltx_text ltx_lst_literate ltx_font_typewriter">:</span><span id="lstnumberx42.18" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx42.19" class="ltx_text ltx_lst_literate ltx_font_typewriter" style="--ltx-fg-color:#009400;">"</span><span id="lstnumberx42.20" class="ltx_text ltx_lst_identifier ltx_font_typewriter">under</span><span id="lstnumberx42.21" class="ltx_text ltx_lst_literate ltx_font_typewriter" style="--ltx-fg-color:#009400;">"</span><span id="lstnumberx42.22" class="ltx_text ltx_lst_literate ltx_font_typewriter">,</span><span id="lstnumberx42.23" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx42.24" class="ltx_text ltx_lst_literate ltx_font_typewriter" style="--ltx-fg-color:#009400;">"</span><span id="lstnumberx42.25" class="ltx_text ltx_lst_identifier ltx_font_typewriter">target</span><span id="lstnumberx42.26" class="ltx_text ltx_lst_literate ltx_font_typewriter" style="--ltx-fg-color:#009400;">"</span><span id="lstnumberx42.27" class="ltx_text ltx_lst_literate ltx_font_typewriter">:</span><span id="lstnumberx42.28" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx42.29" class="ltx_text ltx_lst_literate ltx_font_typewriter" style="--ltx-fg-color:#009400;">"</span><span id="lstnumberx42.30" class="ltx_text ltx_lst_identifier ltx_font_typewriter">box</span><span id="lstnumberx42.31" class="ltx_text ltx_lst_literate ltx_font_typewriter" style="--ltx-fg-color:#009400;">"</span><span id="lstnumberx42.32" class="ltx_text ltx_font_typewriter">}</span>
