<tr id="S1.T1.3.2" class="ltx_tr">
<td id="S1.T1.3.2.1" class="ltx_td ltx_align_center ltx_border_t" style="padding-left:3.1pt;padding-right:3.1pt;"><span id="S1.T1.3.2.1.1" class="ltx_text" style="font-size:90%;--ltx-fg-color:#3CA541;">CLEVR<span id="S1.T1.3.2.1.1.1" class="ltx_text" style="--ltx-fg-color:#000000;"> <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib36" title="" class="ltx_ref">24</a>]</cite></span></span></td>
