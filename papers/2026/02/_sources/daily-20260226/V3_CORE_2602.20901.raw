 </span><span id="lstnumberx41.22" class="ltx_text ltx_lst_identifier ltx_font_typewriter">to</span><span id="lstnumberx41.23" class="ltx_text ltx_lst_literate ltx_font_typewriter" style="--ltx-fg-color:#009400;">"</span><span id="lstnumberx41.24" class="ltx_text ltx_lst_literate ltx_font_typewriter">,</span><span id="lstnumberx41.25" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx41.26" class="ltx_text ltx_lst_literate ltx_font_typewriter" style="--ltx-fg-color:#009400;">"</span><span id="lstnumberx41.27" class="ltx_text ltx_lst_identifier ltx_font_typewriter">target</span><span id="lstnumberx41.28" class="ltx_text ltx_lst_literate ltx_font_typewriter" style="--ltx-fg-color:#009400;">"</span><span id="lstnumberx41.29" class="ltx_text ltx_lst_literate ltx_font_typewriter">:</span><span id="lstnumberx41.30" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx41.31" class="ltx_text ltx_lst_literate ltx_font_typewriter" style="--ltx-fg-color:#009400;">"</span><span id="lstnumberx41.32" class="ltx_text ltx_lst_identifier ltx_font_typewriter">teapot</span><span id="lstnumberx41.33" class="ltx_text ltx_lst_literate ltx_font_typewriter" style="--ltx-fg-color:#009400;">"</span><span id="lstnumberx41.34" class="ltx_text ltx_font_typewriter">}</span><span id="lstnumberx41.35" class="ltx_text ltx_lst_literate ltx_font_typewriter">,</span>
