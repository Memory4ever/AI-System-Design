<td id="A4.T1.3.3.1" class="ltx_td ltx_align_center"><span id="A4.T1.3.3.1.1" class="ltx_text" style="font-size:90%;">+ depth</span></td>
<td id="A4.T1.3.3.2" class="ltx_td ltx_align_center"><span id="A4.T1.3.3.2.1" class="ltx_text" style="font-size:90%;">27.9h</span></td>
<td id="A4.T1.3.3.3" class="ltx_td ltx_align_center"><span id="A4.T1.3.3.3.1" class="ltx_text" style="font-size:90%;">64.1</span></td>
<td id="A4.T1.3.3.4" class="ltx_td ltx_align_center"><span id="A4.T1.3.3.4.1" class="ltx_text" style="font-size:90%;">19.0</span></td></tr>
