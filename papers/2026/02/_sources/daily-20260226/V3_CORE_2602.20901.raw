<td id="A4.T1.3.6.2" class="ltx_td ltx_align_center"><span id="A4.T1.3.6.2.1" class="ltx_text" style="font-size:90%;">31.5h</span></td>
<td id="A4.T1.3.6.3" class="ltx_td ltx_align_center"><span id="A4.T1.3.6.3.1" class="ltx_text" style="font-size:90%;">64.7</span></td>
<td id="A4.T1.3.6.4" class="ltx_td ltx_align_center"><span id="A4.T1.3.6.4.1" class="ltx_text" style="font-size:90%;">22.2</span></td></tr>
<tr id="A4.T1.3.7" class="ltx_tr">
