<td id="S4.T1.6.1.1.1" class="ltx_td ltx_align_left ltx_border_tt">Model</td>
<td id="S4.T1.6.1.1.2" class="ltx_td ltx_align_center ltx_border_tt"><span id="S4.T1.6.1.1.2.1" class="ltx_text"></span> <span id="S4.T1.6.1.1.2.2" class="ltx_text">
<span id="S4.T1.6.1.1.2.2.1" class="ltx_tabular ltx_align_middle">
<span id="S4.T1.6.1.1.2.2.1.1" class="ltx_tr">
<span id="S4.T1.6.1.1.2.2.1.1.1" class="ltx_td ltx_nopad_r ltx_align_center">Perplexity <math id="S4.T1.m1" class="ltx_Math" alttext="\downarrow" display="inline" intent=":literal"><semantics><mo stretchy="false">↓</mo><annotation encoding="application/x-tex">\downarrow</annotation></semantics></math></span></span>
<span id="S4.T1.6.1.1.2.2.1.2" class="ltx_tr">
<span id="S4.T1.6.1.1.2.2.1.2.1" class="ltx_td ltx_nopad_r ltx_align_center">(LaCT-LLM)</span></span>
</span></span><span id="S4.T1.6.1.1.2.3" class="ltx_text"></span></td>
<td id="S4.T1.6.1.1.3" class="ltx_td ltx_align_center ltx_border_tt"><span id="S4.T1.6.1.1.3.1" class="ltx_text"></span> <span id="S4.T1.6.1.1.3.2" class="ltx_text">
<span id="S4.T1.6.1.1.3.2.1" class="ltx_tabular ltx_align_middle">
<span id="S4.T1.6.1.1.3.2.1.1" class="ltx_tr">
<span id="S4.T1.6.1.1.3.2.1.1.1" class="ltx_td ltx_nopad_r ltx_align_center">PSNR <math id="S4.T1.m2" class="ltx_Math" alttext="\uparrow" display="inline" intent=":literal"><semantics><mo stretchy="false">↑</mo><annotation encoding="application/x-tex">\uparrow</annotation></semantics></math></span></span>
