</span></span><span id="S4.T1.6.1.1.3.3" class="ltx_text"></span></td>
<td id="S4.T1.6.1.1.4" class="ltx_td ltx_align_center ltx_border_tt"><span id="S4.T1.6.1.1.4.1" class="ltx_text"></span> <span id="S4.T1.6.1.1.4.2" class="ltx_text">
