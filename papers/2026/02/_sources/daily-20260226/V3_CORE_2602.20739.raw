<span id="S3.T1.8.1.1.1.1.1.1.1.3" class="ltx_td ltx_align_center ltx_border_r ltx_border_tt ltx_colspan ltx_colspan_4"><span id="S3.T1.8.1.1.1.1.1.1.1.3.1" class="ltx_text ltx_font_bold">Multimodal Reasoning</span></span>
<span id="S3.T1.8.1.1.1.1.1.1.1.4" class="ltx_td ltx_align_center ltx_border_tt"><span id="S3.T1.8.1.1.1.1.1.1.1.4.1" class="ltx_text ltx_font_bold">Agentic Reasoning</span></span></span>
