<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S3.Ex141.m1" class="ltx_Math" alttext="\displaystyle\boldsymbol{\mathcal{F}}_{FF}^{(prl-mtp)}\circ\boldsymbol{T}^{(prl)}\circ\boldsymbol{\mathcal{F}}_{FF}^{(mid)}\circ\boldsymbol{\mathcal{F}}_{EB}(\boldsymbol{X})=" display="inline" intent=":literal"><semantics><mrow><mrow><msubsup><mi class="ltx_font_mathcaligraphic">𝓕</mi><mrow><mi>F</mi><mo lspace="0em" rspace="0em">​</mo><mi>F</mi></mrow><mrow><mo stretchy="false">(</mo><mrow><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>l</mi></mrow><mo>−</mo><mrow><mi>m</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi><mo lspace="0em" rspace="0em">​</mo><mi>p</mi></mrow></mrow><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0.222em" rspace="0.222em">∘</mo><msup><mi>𝑻</mi><mrow><mo stretchy="false">(</mo><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>l</mi></mrow><mo stretchy="false">)</mo></mrow></msup><mo lspace="0.222em" rspace="0.222em">∘</mo><msubsup><mi class="ltx_font_mathcaligraphic">𝓕</mi><mrow><mi>F</mi><mo lspace="0em" rspace="0em">​</mo><mi>F</mi></mrow><mrow><mo stretchy="false">(</mo><mrow><mi>m</mi><mo lspace="0em" rspace="0em">​</mo><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>d</mi></mrow><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0.222em" rspace="0.222em">∘</mo><mrow><msub><mi class="ltx_font_mathcaligraphic">𝓕</mi><mrow><mi>E</mi><mo lspace="0em" rspace="0em">​</mo><mi>B</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝑿</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>=</mo><mphantom></mphantom></mrow><annotation encoding="application/x-tex">\displaystyle\boldsymbol{\mathcal{F}}_{FF}^{(prl-mtp)}\circ\boldsymbol{T}^{(prl)}\circ\boldsymbol{\mathcal{F}}_{FF}^{(mid)}\circ\boldsymbol{\mathcal{F}}_{EB}(\boldsymbol{X})=</annotation></semantics></math></td>
