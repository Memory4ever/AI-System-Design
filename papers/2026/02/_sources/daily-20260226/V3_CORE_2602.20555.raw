<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S6.Ex356.m2" class="ltx_math_unparsed" alttext="\displaystyle 9\|f^{*}-f_{0}\|_{m}^{2}+2^{13}\sigma^{2}m^{-2\gamma/(2\gamma+d)}" display="inline" intent=":literal"><semantics><mrow><mn>9</mn><mo lspace="0em" rspace="0.167em">∥</mo><mi>f</mi><msup><mrow></mrow><mo>∗</mo></msup><mo>−</mo><mi>f</mi><msub><mrow></mrow><mn>0</mn></msub><mo lspace="0em" rspace="0em">∥</mo><msub><mrow></mrow><mi>m</mi></msub><msup><mrow></mrow><mn>2</mn></msup><mo lspace="0em">+</mo><mn>2</mn><msup><mrow></mrow><mn>13</mn></msup><mi>σ</mi><msup><mrow></mrow><mn>2</mn></msup><mi>m</mi><msup><mrow></mrow><mrow><mo>−</mo><mn>2</mn><mi>γ</mi><mo>/</mo><mo stretchy="false">(</mo><mn>2</mn><mi>γ</mi><mo>+</mo><mi>d</mi><mo stretchy="false">)</mo></mrow></msup></mrow><annotation encoding="application/x-tex">\displaystyle 9\|f^{*}-f_{0}\|_{m}^{2}+2^{13}\sigma^{2}m^{-2\gamma/(2\gamma+d)}</annotation></semantics></math></td>
