 stretchy="false">(</mo><mi>h</mi><mo stretchy="false">)</mo></mrow></msubsup><mi>𝒀</mi><mo>)</mo></mrow><mo>‖</mo></mrow><mi>F</mi></msub></mrow><annotation encoding="application/x-tex">\displaystyle\quad+\sum_{h=1}^{H}\left\|\boldsymbol{\widetilde{W}}_{O}^{(h)}\boldsymbol{\widetilde{W}}_{V}^{(h)}\boldsymbol{Y}\sigma_{S}\left(\boldsymbol{Y}^{\top}\boldsymbol{{W}}_{K}^{(h)\top}\boldsymbol{{W}}_{Q}^{(h)}\boldsymbol{Y}\right)-\boldsymbol{{W}}_{O}^{(h)}\boldsymbol{{W}}_{V}^{(h)}\boldsymbol{Y}\sigma_{S}\left(\boldsymbol{Y}^{\top}\boldsymbol{{W}}_{K}^{(h)\top}\boldsymbol{{W}}_{Q}^{(h)}\boldsymbol{Y}\right)\right\|_{F}</annotation></semantics></math></td>
