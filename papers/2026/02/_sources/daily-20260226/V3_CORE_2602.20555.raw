<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S7.Ex468.m1" class="ltx_Math" alttext="\displaystyle\quad\left(\prod_{k^{\prime}=1}^{K-1}\prod_{k^{\prime\prime}=1}^{k^{\prime}}d_{k^{\prime\prime}}^{4}\right)\left(\prod_{k^{\prime}=k+1}^{K}d_{k^{\prime}}\right)d_{k+1}^{5/2}\left(\prod_{k^{\prime}=k+2}^{K}d_{k^{\prime}}^{3}\right)d_{out}^{1/2}" display="inline" intent=":literal"><semantics><mrow><mrow><mo>(</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∏</mo><mrow><msup><mi>k</mi><mo>′</mo></msup><mo>=</mo><mn>1</mn></mrow><mrow><mi>K</mi><mo>−</mo><mn>1</mn></mrow></munderover></mstyle><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∏</mo><mrow><msup><mi>k</mi><mo>′′</mo></msup><mo>=</mo><mn>1</mn></mrow><msup><mi>k</mi><mo>′</mo></msup></munderover></mstyle><msubsup><mi>d</mi><msup><mi>k</mi><mo>′′</mo></msup><mn>4</mn></msubsup></mrow></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∏</mo><mrow><msup><mi>k</mi><mo>′</mo></msup><mo>=</mo><mrow><mi>k</mi><mo>+</mo><mn>1</mn></mrow></mrow><mi>K</mi></munderover></mstyle><msub><mi>d</mi><msup><mi>k</mi><mo>′</mo></msup></msub></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>d</mi><mrow><mi>k</mi><mo>+</mo><mn>1</mn></mrow><mrow><mn>5</mn><mo>/</mo><mn>2</mn></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∏</mo><mrow><msup><mi>k</mi><mo>′</mo></msup><mo>=</mo><mrow><mi>k</mi><mo>+</mo><mn>2</mn></mrow></mrow><mi>K</mi></munderover></mstyle><msubsup><mi>d</mi><msup><mi>k</mi><mo>′</mo></msup><mn>3</mn></msubsup></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>d</mi><mrow><mi>o</mi><mo lspace="0em" rspace="0em">​</mo><mi>u</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow><mrow><mn>1</mn><mo>/</mo><mn>2</mn></mrow></msubsup></mrow><annotation encoding="application/x-tex">\displaystyle\quad\left(\prod_{k^{\prime}=1}^{K-1}\prod_{k^{\prime\prime}=1}^{k^{\prime}}d_{k^{\prime\prime}}^{4}\right)\left(\prod_{k^{\prime}=k+1}^{K}d_{k^{\prime}}\right)d_{k+1}^{5/2}\left(\prod_{k^{\prime}=k+2}^{K}d_{k^{\prime}}^{3}\right)d_{out}^{1/2}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="S7.Ex469"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S7.Ex469.m1" class="ltx_Math" alttext="\displaystyle\quad H^{(K-k)^{2}}S^{(K-k)(K-k+1)}L^{(K-k)(K-k+1)}W^{(L-1)(K-k)(K-k+2)}" display="inline" intent=":literal"><semantics><mrow><msup><mi>H</mi><msup><mrow><mo stretchy="false">(</mo><mrow><mi>K</mi><mo>−</mo><mi>k</mi></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>S</mi><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>K</mi><mo>−</mo><mi>k</mi></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mi>K</mi><mo>−</mo><mi>k</mi></mrow><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>L</mi><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>K</mi><mo>−</mo><mi>k</mi></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mi>K</mi><mo>−</mo><mi>k</mi></mrow><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>W</mi><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>L</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>K</mi><mo>−</mo><mi>k</mi></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mi>K</mi><mo>−</mo><mi>k</mi></mrow><mo>+</mo><mn>2</mn></mrow><mo stretchy="false">)</mo></mrow></mrow></msup></mrow><annotation encoding="application/x-tex">\displaystyle\quad H^{(K-k)^{2}}S^{(K-k)(K-k+1)}L^{(K-k)(K-k+1)}W^{(L-1)(K-k)(K-k+2)}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="S7.Ex470"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S7.Ex470.m1" class="ltx_Math" alttext="\displaystyle\quad B_{EB}^{2(K-k)}B_{FF}^{L(K-k)(K-k+2)}B_{SA}^{2(K-k)(K-k+1)}" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>B</mi><mrow><mi>E</mi><mo lspace="0em" rspace="0em">​</mo><mi>B</mi></mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>K</mi><mo>−</mo><mi>k</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>B</mi><mrow><mi>F</mi><mo lspace="0em" rspace="0em">​</mo><mi>F</mi></mrow><mrow><mi>L</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>K</mi><mo>−</mo><mi>k</mi></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mi>K</mi><mo>−</mo><mi>k</mi></mrow><mo>+</mo><mn>2</mn></mrow><mo stretchy="false">)</mo></mrow></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>B</mi><mrow><mi>S</mi><mo lspace="0em" rspace="0em">​</mo><mi>A</mi></mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>K</mi><mo>−</mo><mi>k</mi></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mi>K</mi><mo>−</mo><mi>k</mi></mrow><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow></msubsup></mrow><annotation encoding="application/x-tex">\displaystyle\quad B_{EB}^{2(K-k)}B_{FF}^{L(K-k)(K-k+2)}B_{SA}^{2(K-k)(K-k+1)}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="S7.E37"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S7.E37.m1" class="ltx_math_unparsed" alttext="\displaystyle\quad\left\|\boldsymbol{\mathcal{\widetilde{F}}}_{FF}^{(k)}\circ\boldsymbol{\mathcal{{F}}}_{SA}^{(k)}\circ\cdots\circ\boldsymbol{\mathcal{{F}}}_{FF}^{(0)}\circ\boldsymbol{\mathcal{F}}_{EB}(\boldsymbol{X})-\boldsymbol{\mathcal{{F}}}_{FF}^{(k)}\circ\boldsymbol{\mathcal{{F}}}_{SA}^{(k)}\circ\cdots\circ\boldsymbol{\mathcal{{F}}}_{FF}^{(0)}\circ\boldsymbol{\mathcal{F}}_{EB}(\boldsymbol{X})\right\|_{F}." display="inline" intent=":literal"><semantics><mrow><msub><mrow><mo>‖</mo><msubsup><mover accent="true"><mi class="ltx_font_mathcaligraphic">𝓕</mi><mo>~</mo></mover><mrow><mi>F</mi><mo lspace="0em" rspace="0em">​</mo><mi>F</mi></mrow><mrow><mo stretchy="false">(</mo><mi>k</mi><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0.222em" rspace="0.222em">∘</mo><msubsup><mi class="ltx_font_mathcaligraphic">𝓕</mi><mrow><mi>S</mi><mo lspace="0em" rspace="0em">​</mo><mi>A</mi></mrow><mrow><mo stretchy="false">(</mo><mi>k</mi><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0.222em">∘</mo><mo lspace="0.055em" rspace="0.055em">⋯</mo><mo rspace="0.222em">∘</mo><msubsup><mi class="ltx_font_mathcaligraphic">𝓕</mi><mrow><mi>F</mi><mo lspace="0em" rspace="0em">​</mo><mi>F</mi></mrow><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0.222em" rspace="0.222em">∘</mo><msub><mi class="ltx_font_mathcaligraphic">𝓕</mi><mrow><mi>E</mi><mo lspace="0em" rspace="0em">​</mo><mi>B</mi></mrow></msub><mrow><mo stretchy="false">(</mo><mi>𝑿</mi><mo stretchy="false">)</mo></mrow><mo>−</mo><msubsup><mi class="ltx_font_mathcaligraphic">𝓕</mi><mrow><mi>F</mi><mo lspace="0em" rspace="0em">​</mo><mi>F</mi></mrow><mrow><mo stretchy="false">(</mo><mi>k</mi><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0.222em" rspace="0.222em">∘</mo><msubsup><mi class="ltx_font_mathcaligraphic">𝓕</mi><mrow><mi>S</mi><mo lspace="0em" rspace="0em">​</mo><mi>A</mi></mrow><mrow><mo stretchy="false">(</mo><mi>k</mi><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0.222em">∘</mo><mo lspace="0.055em" rspace="0.055em">⋯</mo><mo rspace="0.222em">∘</mo><msubsup><mi class="ltx_font_mathcaligraphic">𝓕</mi><mrow><mi>F</mi><mo lspace="0em" rspace="0em">​</mo><mi>F</mi></mrow><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0.222em" rspace="0.222em">∘</mo><msub><mi class="ltx_font_mathcaligraphic">𝓕</mi><mrow><mi>E</mi><mo lspace="0em" rspace="0em">​</mo><mi>B</mi></mrow></msub><mrow><mo stretchy="false">(</mo><mi>𝑿</mi><mo stretchy="false">)</mo></mrow><mo>‖</mo></mrow><mi>F</mi></msub><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\quad\left\|\boldsymbol{\mathcal{\widetilde{F}}}_{FF}^{(k)}\circ\boldsymbol{\mathcal{{F}}}_{SA}^{(k)}\circ\cdots\circ\boldsymbol{\mathcal{{F}}}_{FF}^{(0)}\circ\boldsymbol{\mathcal{F}}_{EB}(\boldsymbol{X})-\boldsymbol{\mathcal{{F}}}_{FF}^{(k)}\circ\boldsymbol{\mathcal{{F}}}_{SA}^{(k)}\circ\cdots\circ\boldsymbol{\mathcal{{F}}}_{FF}^{(0)}\circ\boldsymbol{\mathcal{F}}_{EB}(\boldsymbol{X})\right\|_{F}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(37)</span></td></tr></tbody>
</table>
<p id="S7.p15.8" class="ltx_p"><span id="S7.p15.8.1" class="ltx_text">Applying Lemma <a href="#Thmlemma28" title="Lemma 28. ‣ 7 Proof of Lemma : Estimation of Lipschitz Constant ‣ Standard Transformers Achieve the Minimax Rate in Nonparametric Regression with 𝐶^{𝑠,𝜆} Targets" class="ltx_ref"><span class="ltx_text ltx_ref_tag">28</span></a> repeatedly, we have</span></p>
<table id="S7.EGx255" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="S7.Ex471"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S7.Ex471.m1" class="ltx_math_unparsed" alttext="\displaystyle\left\|\boldsymbol{\mathcal{{F}}}_{SA}^{(k)}\circ\cdots\circ\boldsymbol{\mathcal{{F}}}_{FF}^{(0)}\circ\boldsymbol{\mathcal{F}}_{EB}(\boldsymbol{X})\right\|_{F}" display="inline" intent=":literal"><semantics><msub><mrow><mo>‖</mo><msubsup><mi class="ltx_font_mathcaligraphic">𝓕</mi><mrow><mi>S</mi><mo lspace="0em" rspace="0em">​</mo><mi>A</mi></mrow><mrow><mo stretchy="false">(</mo><mi>k</mi><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0.222em">∘</mo><mo lspace="0.055em" rspace="0.055em">⋯</mo><mo rspace="0.222em">∘</mo><msubsup><mi class="ltx_font_mathcaligraphic">𝓕</mi><mrow><mi>F</mi><mo lspace="0em" rspace="0em">​</mo><mi>F</mi></mrow><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0.222em" rspace="0.222em">∘</mo><msub><mi class="ltx_font_mathcaligraphic">𝓕</mi><mrow><mi>E</mi><mo lspace="0em" rspace="0em">​</mo><mi>B</mi></mrow></msub><mrow><mo stretchy="false">(</mo><mi>𝑿</mi><mo stretchy="false">)</mo></mrow><mo>‖</mo></mrow><mi>F</mi></msub><annotation encoding="application/x-tex">\displaystyle\left\|\boldsymbol{\mathcal{{F}}}_{SA}^{(k)}\circ\cdots\circ\boldsymbol{\mathcal{{F}}}_{FF}^{(0)}\circ\boldsymbol{\mathcal{F}}_{EB}(\boldsymbol{X})\right\|_{F}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="S7.Ex472"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S7.Ex472.m1" class="ltx_Math" alttext="\displaystyle\leq 4^{k+1/2}n^{k+1}d_{in}^{1/2}d_{0}\left(\prod_{k^{\prime}=1}^{k-1}d_{k^{\prime}}^{2}\right){d_{k}^{3/2}}H^{k}S^{k}L^{k}W^{(L-1)k}B_{EB}B_{FF}^{Lk}B_{SA}^{2k}." display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>≤</mo><mrow><msup><mn>4</mn><mrow><mi>k</mi><mo>+</mo><mrow><mn>1</mn><mo>/</mo><mn>2</mn></mrow></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>n</mi><mrow><mi>k</mi><mo>+</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>d</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow><mrow><mn>1</mn><mo>/</mo><mn>2</mn></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mi>d</mi><mn>0</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∏</mo><mrow><msup><mi>k</mi><mo>′</mo></msup><mo>=</mo><mn>1</mn></mrow><mrow><mi>k</mi><mo>−</mo><mn>1</mn></mrow></munderover></mstyle><msubsup><mi>d</mi><msup><mi>k</mi><mo>′</mo></msup><mn>2</mn></msubsup></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>d</mi><mi>k</mi><mrow><mn>3</mn><mo>/</mo><mn>2</mn></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mi>H</mi><mi>k</mi></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>S</mi><mi>k</mi></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>L</mi><mi>k</mi></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>W</mi><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>L</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>k</mi></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>B</mi><mrow><mi>E</mi><mo lspace="0em" rspace="0em">​</mo><mi>B</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>B</mi><mrow><mi>F</mi><mo lspace="0em" rspace="0em">​</mo><mi>F</mi></mrow><mrow><mi>L</mi><mo lspace="0em" rspace="0em">​</mo><mi>k</mi></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>B</mi><mrow><mi>S</mi><mo lspace="0em" rspace="0em">​</mo><mi>A</mi></mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>k</mi></mrow></msubsup></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\leq 4^{k+1/2}n^{k+1}d_{in}^{1/2}d_{0}\left(\prod_{k^{\prime}=1}^{k-1}d_{k^{\prime}}^{2}\right){d_{k}^{3/2}}H^{k}S^{k}L^{k}W^{(L-1)k}B_{EB}B_{FF}^{Lk}B_{SA}^{2k}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S7.p15.9" class="ltx_p"><span id="S7.p15.9.1" class="ltx_text">Using the above estimate and Lemma <a href="#Thmlemma29" title="Lemma 29. ‣ 7 Proof of Lemma : Estimation of Lipschitz Constant ‣ Standard Transformers Achieve the Minimax Rate in Nonparametric Regression with 𝐶^{𝑠,𝜆} Targets" class="ltx_ref"><span class="ltx_text ltx_ref_tag">29</span></a>, we have</span></p>
<table id="S7.EGx256" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="S7.Ex473"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S7.Ex473.m1" class="ltx_math_unparsed" alttext="\displaystyle\left\|\boldsymbol{\mathcal{\widetilde{F}}}_{FF}^{(k)}\circ\boldsymbol{\mathcal{{F}}}_{SA}^{(k)}\circ\cdots\circ\boldsymbol{\mathcal{{F}}}_{FF}^{(0)}\circ\boldsymbol{\mathcal{F}}_{EB}(\boldsymbol{X})-\boldsymbol{\mathcal{{F}}}_{FF}^{(k)}\circ\boldsymbol{\mathcal{{F}}}_{SA}^{(k)}\circ\cdots\circ\boldsymbol{\mathcal{{F}}}_{FF}^{(0)}\circ\boldsymbol{\mathcal{F}}_{EB}(\boldsymbol{X})\right\|_{F}" display="inline" intent=":literal"><semantics><msub><mrow><mo>‖</mo><msubsup><mover accent="true"><mi class="ltx_font_mathcaligraphic">𝓕</mi><mo>~</mo></mover><mrow><mi>F</mi><mo lspace="0em" rspace="0em">​</mo><mi>F</mi></mrow><mrow><mo stretchy="false">(</mo><mi>k</mi><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0.222em" rspace="0.222em">∘</mo><msubsup><mi class="ltx_font_mathcaligraphic">𝓕</mi><mrow><mi>S</mi><mo lspace="0em" rspace="0em">​</mo><mi>A</mi></mrow><mrow><mo stretchy="false">(</mo><mi>k</mi><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0.222em">∘</mo><mo lspace="0.055em" rspace="0.055em">⋯</mo><mo rspace="0.222em">∘</mo><msubsup><mi class="ltx_font_mathcaligraphic">𝓕</mi><mrow><mi>F</mi><mo lspace="0em" rspace="0em">​</mo><mi>F</mi></mrow><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0.222em" rspace="0.222em">∘</mo><msub><mi class="ltx_font_mathcaligraphic">𝓕</mi><mrow><mi>E</mi><mo lspace="0em" rspace="0em">​</mo><mi>B</mi></mrow></msub><mrow><mo stretchy="false">(</mo><mi>𝑿</mi><mo stretchy="false">)</mo></mrow><mo>−</mo><msubsup><mi class="ltx_font_mathcaligraphic">𝓕</mi><mrow><mi>F</mi><mo lspace="0em" rspace="0em">​</mo><mi>F</mi></mrow><mrow><mo stretchy="false">(</mo><mi>k</mi><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0.222em" rspace="0.222em">∘</mo><msubsup><mi class="ltx_font_mathcaligraphic">𝓕</mi><mrow><mi>S</mi><mo lspace="0em" rspace="0em">​</mo><mi>A</mi></mrow><mrow><mo stretchy="false">(</mo><mi>k</mi><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0.222em">∘</mo><mo lspace="0.055em" rspace="0.055em">⋯</mo><mo rspace="0.222em">∘</mo><msubsup><mi class="ltx_font_mathcaligraphic">𝓕</mi><mrow><mi>F</mi><mo lspace="0em" rspace="0em">​</mo><mi>F</mi></mrow><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0.222em" rspace="0.222em">∘</mo><msub><mi class="ltx_font_mathcaligraphic">𝓕</mi><mrow><mi>E</mi><mo lspace="0em" rspace="0em">​</mo><mi>B</mi></mrow></msub><mrow><mo stretchy="false">(</mo><mi>𝑿</mi><mo stretchy="false">)</mo></mrow><mo>‖</mo></mrow><mi>F</mi></msub><annotation encoding="application/x-tex">\displaystyle\left\|\boldsymbol{\mathcal{\widetilde{F}}}_{FF}^{(k)}\circ\boldsymbol{\mathcal{{F}}}_{SA}^{(k)}\circ\cdots\circ\boldsymbol{\mathcal{{F}}}_{FF}^{(0)}\circ\boldsymbol{\mathcal{F}}_{EB}(\boldsymbol{X})-\boldsymbol{\mathcal{{F}}}_{FF}^{(k)}\circ\boldsymbol{\mathcal{{F}}}_{SA}^{(k)}\circ\cdots\circ\boldsymbol{\mathcal{{F}}}_{FF}^{(0)}\circ\boldsymbol{\mathcal{F}}_{EB}(\boldsymbol{X})\right\|_{F}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="S7.E38"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S7.E38.m1" class="ltx_Math" alttext="\displaystyle\leq 4^{k+3/2}n^{k+2}d_{in}^{1/2}d_{0}\left(\prod_{k^{\prime}=1}^{k-1}d_{k^{\prime}}^{2}\right){d_{k}^{5/2}}{d_{k+1}^{3/2}}H^{k}S^{k}L^{k+2}W^{(k+2)L-k-3/2}B_{EB}B_{FF}^{(k+2)L-1}B_{SA}^{2k}\varsigma." display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>≤</mo><mrow><msup><mn>4</mn><mrow><mi>k</mi><mo>+</mo><mrow><mn>3</mn><mo>/</mo><mn>2</mn></mrow></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>n</mi><mrow><mi>k</mi><mo>+</mo><mn>2</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>d</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow><mrow><mn>1</mn><mo>/</mo><mn>2</mn></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mi>d</mi><mn>0</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∏</mo><mrow><msup><mi>k</mi><mo>′</mo></msup><mo>=</mo><mn>1</mn></mrow><mrow><mi>k</mi><mo>−</mo><mn>1</mn></mrow></munderover></mstyle><msubsup><mi>d</mi><msup><mi>k</mi><mo>′</mo></msup><mn>2</mn></msubsup></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>d</mi><mi>k</mi><mrow><mn>5</mn><mo>/</mo><mn>2</mn></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>d</mi><mrow><mi>k</mi><mo>+</mo><mn>1</mn></mrow><mrow><mn>3</mn><mo>/</mo><mn>2</mn></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mi>H</mi><mi>k</mi></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>S</mi><mi>k</mi></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>L</mi><mrow><mi>k</mi><mo>+</mo><mn>2</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>W</mi><mrow><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>k</mi><mo>+</mo><mn>2</mn></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>L</mi></mrow><mo>−</mo><mi>k</mi><mo>−</mo><mrow><mn>3</mn><mo>/</mo><mn>2</mn></mrow></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>B</mi><mrow><mi>E</mi><mo lspace="0em" rspace="0em">​</mo><mi>B</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>B</mi><mrow><mi>F</mi><mo lspace="0em" rspace="0em">​</mo><mi>F</mi></mrow><mrow><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>k</mi><mo>+</mo><mn>2</mn></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>L</mi></mrow><mo>−</mo><mn>1</mn></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>B</mi><mrow><mi>S</mi><mo lspace="0em" rspace="0em">​</mo><mi>A</mi></mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>k</mi></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>ς</mi></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\leq 4^{k+3/2}n^{k+2}d_{in}^{1/2}d_{0}\left(\prod_{k^{\prime}=1}^{k-1}d_{k^{\prime}}^{2}\right){d_{k}^{5/2}}{d_{k+1}^{3/2}}H^{k}S^{k}L^{k+2}W^{(k+2)L-k-3/2}B_{EB}B_{FF}^{(k+2)L-1}B_{SA}^{2k}\varsigma.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(38)</span></td></tr></tbody>
</table>
<p id="S7.p15.10" class="ltx_p"><span id="S7.p15.10.1" class="ltx_text">Plugging (<a href="#S7.E38" title="In Proof of Lemma . ‣ 7 Proof of Lemma : Estimation of Lipschitz Constant ‣ Standard Transformers Achieve the Minimax Rate in Nonparametric Regression with 𝐶^{𝑠,𝜆} Targets" class="ltx_ref"><span class="ltx_text ltx_ref_tag">38</span></a>) into (<a href="#S7.E37" title="In Proof of Lemma . ‣ 7 Proof of Lemma : Estimation of Lipschitz Constant ‣ Standard Transformers Achieve the Minimax Rate in Nonparametric Regression with 𝐶^{𝑠,𝜆} Targets" class="ltx_ref"><span class="ltx_text ltx_ref_tag">37</span></a>) and simplifying the expression, we derive that</span></p>
</div>
<div id="S7.p16" class="ltx_para">
<table id="S7.EGx257" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="S7.Ex474"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
