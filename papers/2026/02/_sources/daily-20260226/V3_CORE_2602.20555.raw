<p id="S3.SS1.p17.2" class="ltx_p"><span id="S3.SS1.p17.2.1" class="ltx_text">The weight bounds of <math id="S3.SS1.p17.m3" class="ltx_Math" alttext="\boldsymbol{T}^{(prl-mmr)}" display="inline" intent=":literal"><semantics><msup><mi>𝑻</mi><mrow><mo stretchy="false">(</mo><mrow><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>l</mi></mrow><mo>−</mo><mrow><mi>m</mi><mo lspace="0em" rspace="0em">​</mo><mi>m</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi></mrow></mrow><mo stretchy="false">)</mo></mrow></msup><annotation encoding="application/x-tex">\boldsymbol{T}^{(prl-mmr)}</annotation></semantics></math> are <math id="S3.SS1.p17.m4" class="ltx_Math" alttext="B_{FF}=C(\boldsymbol{f})d^{2}n^{7}K^{6dn+2},B_{SA}=\frac{1}{2}\log(3{d}{\pi}n^{4}(3n+1)K^{4dn+1})" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>B</mi><mrow><mi>F</mi><mo lspace="0em" rspace="0em">​</mo><mi>F</mi></mrow></msub><mo>=</mo><mrow><mrow><mi>C</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝒇</mi><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mi>d</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>n</mi><mn>7</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>K</mi><mrow><mrow><mn>6</mn><mo lspace="0em" rspace="0em">​</mo><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow><mo>+</mo><mn>2</mn></mrow></msup></mrow></mrow><mo>,</mo><mrow><msub><mi>B</mi><mrow><mi>S</mi><mo lspace="0em" rspace="0em">​</mo><mi>A</mi></mrow></msub><mo>=</mo><mrow><mfrac><mn>1</mn><mn>2</mn></mfrac><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>log</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mn>3</mn><mo lspace="0em" rspace="0em">​</mo><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>π</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>n</mi><mn>4</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mn>3</mn><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mi>K</mi><mrow><mrow><mn>4</mn><mo lspace="0em" rspace="0em">​</mo><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow><mo>+</mo><mn>1</mn></mrow></msup></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">B_{FF}=C(\boldsymbol{f})d^{2}n^{7}K^{6dn+2},B_{SA}=\frac{1}{2}\log(3{d}{\pi}n^{4}(3n+1)K^{4dn+1})</annotation></semantics></math>.</span></p>
</div>
<div id="S3.SS1.p18" class="ltx_para">
<p id="S3.SS1.p18.1" class="ltx_p"><span id="S3.SS1.p18.1.1" class="ltx_text ltx_font_bold">Step 3: Approximate the monomials <math id="S3.SS1.p18.m1" class="ltx_Math" alttext="\left(\boldsymbol{X}-\boldsymbol{X}^{(j)}\right)^{\boldsymbol{\alpha}_{i}}" display="inline" intent=":literal"><semantics><msup><mrow><mo>(</mo><mrow><mi>X</mi><mo>−</mo><msup><mi>X</mi><mrow><mo stretchy="false">(</mo><mi>j</mi><mo stretchy="false">)</mo></mrow></msup></mrow><mo>)</mo></mrow><msub><mi>α</mi><mi>i</mi></msub></msup><annotation encoding="application/x-tex">\left(\boldsymbol{X}-\boldsymbol{X}^{(j)}\right)^{\boldsymbol{\alpha}_{i}}</annotation></semantics></math>.<span id="S3.SS1.p18.1.1.1" class="ltx_text"></span></span></p>
</div>
<div id="S3.SS1.p19" class="ltx_para">
<p id="S3.SS1.p19.1" class="ltx_p"><span id="S3.SS1.p19.1.1" class="ltx_text">For <math id="S3.SS1.p19.m1" class="ltx_Math" alttext="\boldsymbol{X}\in\Omega_{j}" display="inline" intent=":literal"><semantics><mrow><mi>𝑿</mi><mo>∈</mo><msub><mi mathvariant="normal">Ω</mi><mi>j</mi></msub></mrow><annotation encoding="application/x-tex">\boldsymbol{X}\in\Omega_{j}</annotation></semantics></math> with some <math id="S3.SS1.p19.m2" class="ltx_Math" alttext="j\in\left[K^{dn}\right]" display="inline" intent=":literal"><semantics><mrow><mi>j</mi><mo>∈</mo><mrow><mo>[</mo><msup><mi>K</mi><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow></msup><mo>]</mo></mrow></mrow><annotation encoding="application/x-tex">j\in\left[K^{dn}\right]</annotation></semantics></math>, denote</span></p>
<table id="S3.EGx83" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="S3.Ex123"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S3.Ex123.m1" class="ltx_Math" alttext="\displaystyle\boldsymbol{\bar{X}}:=\boldsymbol{X}-\boldsymbol{X}^{(j)}." display="inline" intent=":literal"><semantics><mrow><mrow><mover accent="true"><mi>𝑿</mi><mo>¯</mo></mover><mo>:=</mo><mrow><mi>𝑿</mi><mo>−</mo><msup><mi>𝑿</mi><mrow><mo stretchy="false">(</mo><mi>j</mi><mo stretchy="false">)</mo></mrow></msup></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\boldsymbol{\bar{X}}:=\boldsymbol{X}-\boldsymbol{X}^{(j)}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S3.SS1.p19.2" class="ltx_p"><span id="S3.SS1.p19.2.1" class="ltx_text">Let <math id="S3.SS1.p19.m3" class="ltx_Math" alttext="0&lt;\epsilon_{1}\leq\frac{3^{\lceil\log_{2}(s-1)\rceil}-1}{3^{\lceil\log_{2}(s-1)\rceil-1}-1}" display="inline" intent=":literal"><semantics><mrow><mn>0</mn><mo>&lt;</mo><msub><mi>ϵ</mi><mn>1</mn></msub><mo>≤</mo><mfrac><mrow><msup><mn>3</mn><mrow><mo stretchy="false">⌈</mo><mrow><msub><mi>log</mi><mn>2</mn></msub><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>s</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">⌉</mo></mrow></msup><mo>−</mo><mn>1</mn></mrow><mrow><msup><mn>3</mn><mrow><mrow><mo stretchy="false">⌈</mo><mrow><msub><mi>log</mi><mn>2</mn></msub><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>s</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">⌉</mo></mrow><mo>−</mo><mn>1</mn></mrow></msup><mo>−</mo><mn>1</mn></mrow></mfrac></mrow><annotation encoding="application/x-tex">0&lt;\epsilon_{1}\leq\frac{3^{\lceil\log_{2}(s-1)\rceil}-1}{3^{\lceil\log_{2}(s-1)\rceil-1}-1}</annotation></semantics></math> be some accuracy to be determined later. By Lemma <a href="#Thmlemma9" title="Lemma 9. ‣ 3.1 Proof of Proposition ‣ 3 Proof of Proposition : Construction of Transformers ‣ Standard Transformers Achieve the Minimax Rate in Nonparametric Regression with 𝐶^{𝑠,𝜆} Targets" class="ltx_ref"><span class="ltx_text ltx_ref_tag">9</span></a>, there exists ReLU FNN functions <math id="S3.SS1.p19.m4" class="ltx_Math" alttext="\left\{f_{FF,i}^{(mnm)}\right\}_{i\in\left[C_{s+dn-1}^{dn-1}\right]}" display="inline" intent=":literal"><semantics><msub><mrow><mo>{</mo><msubsup><mi>f</mi><mrow><mrow><mi>F</mi><mo lspace="0em" rspace="0em">​</mo><mi>F</mi></mrow><mo>,</mo><mi>i</mi></mrow><mrow><mo stretchy="false">(</mo><mrow><mi>m</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><mi>m</mi></mrow><mo stretchy="false">)</mo></mrow></msubsup><mo>}</mo></mrow><mrow><mi>i</mi><mo>∈</mo><mrow><mo>[</mo><msubsup><mi>C</mi><mrow><mrow><mi>s</mi><mo>+</mo><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow></mrow><mo>−</mo><mn>1</mn></mrow><mrow><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow><mo>−</mo><mn>1</mn></mrow></msubsup><mo>]</mo></mrow></mrow></msub><annotation encoding="application/x-tex">\left\{f_{FF,i}^{(mnm)}\right\}_{i\in\left[C_{s+dn-1}^{dn-1}\right]}</annotation></semantics></math> with width <math id="S3.SS1.p19.m5" class="ltx_Math" alttext="21\cdot 2^{\lceil\log_{2}(s-1)\rceil-1}" display="inline" intent=":literal"><semantics><mrow><mn>21</mn><mo lspace="0.222em" rspace="0.222em">⋅</mo><msup><mn>2</mn><mrow><mrow><mo stretchy="false">⌈</mo><mrow><msub><mi>log</mi><mn>2</mn></msub><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>s</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">⌉</mo></mrow><mo>−</mo><mn>1</mn></mrow></msup></mrow><annotation encoding="application/x-tex">21\cdot 2^{\lceil\log_{2}(s-1)\rceil-1}</annotation></semantics></math>, depth <math id="S3.SS1.p19.m6" class="ltx_Math" alttext="C\ln\frac{3^{\lceil\log_{2}(s-1)\rceil}-1}{2\epsilon_{1}}" display="inline" intent=":literal"><semantics><mrow><mi>C</mi><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>ln</mi><mo lspace="0.167em">⁡</mo><mfrac><mrow><msup><mn>3</mn><mrow><mo stretchy="false">⌈</mo><mrow><msub><mi>log</mi><mn>2</mn></msub><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>s</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">⌉</mo></mrow></msup><mo>−</mo><mn>1</mn></mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>ϵ</mi><mn>1</mn></msub></mrow></mfrac></mrow></mrow><annotation encoding="application/x-tex">C\ln\frac{3^{\lceil\log_{2}(s-1)\rceil}-1}{2\epsilon_{1}}</annotation></semantics></math> and weight bound <math id="S3.SS1.p19.m7" class="ltx_Math" alttext="C" display="inline" intent=":literal"><semantics><mi>C</mi><annotation encoding="application/x-tex">C</annotation></semantics></math> such that</span></p>
<table id="S3.EGx84" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="S3.E9"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S3.E9.m1" class="ltx_Math" alttext="\displaystyle\left|f_{FF,i}^{(mnm)}\left(\boldsymbol{\bar{X}}^{(flt)}\right)-\boldsymbol{\bar{X}}^{\boldsymbol{\alpha}_{i}}\right|\leq\epsilon_{1},\quad i\in\left[C_{s+dn-1}^{dn-1}\right]." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mrow><mo>|</mo><mrow><mrow><msubsup><mi>f</mi><mrow><mrow><mi>F</mi><mo lspace="0em" rspace="0em">​</mo><mi>F</mi></mrow><mo>,</mo><mi>i</mi></mrow><mrow><mo stretchy="false">(</mo><mrow><mi>m</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><mi>m</mi></mrow><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><msup><mover accent="true"><mi>𝑿</mi><mo>¯</mo></mover><mrow><mo stretchy="false">(</mo><mrow><mi>f</mi><mo lspace="0em" rspace="0em">​</mo><mi>l</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow><mo stretchy="false">)</mo></mrow></msup><mo>)</mo></mrow></mrow><mo>−</mo><msup><mover accent="true"><mi>𝑿</mi><mo>¯</mo></mover><msub><mi>𝜶</mi><mi>i</mi></msub></msup></mrow><mo>|</mo></mrow><mo>≤</mo><msub><mi>ϵ</mi><mn>1</mn></msub></mrow><mo rspace="1.167em">,</mo><mrow><mi>i</mi><mo>∈</mo><mrow><mo>[</mo><msubsup><mi>C</mi><mrow><mrow><mi>s</mi><mo>+</mo><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow></mrow><mo>−</mo><mn>1</mn></mrow><mrow><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow><mo>−</mo><mn>1</mn></mrow></msubsup><mo>]</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\left|f_{FF,i}^{(mnm)}\left(\boldsymbol{\bar{X}}^{(flt)}\right)-\boldsymbol{\bar{X}}^{\boldsymbol{\alpha}_{i}}\right|\leq\epsilon_{1},\quad i\in\left[C_{s+dn-1}^{dn-1}\right].</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(9)</span></td></tr></tbody>
</table>
<p id="S3.SS1.p19.3" class="ltx_p"><span id="S3.SS1.p19.3.1" class="ltx_text">By Lemma <a href="#Thmlemma8" title="Lemma 8. ‣ 3.1 Proof of Proposition ‣ 3 Proof of Proposition : Construction of Transformers ‣ Standard Transformers Achieve the Minimax Rate in Nonparametric Regression with 𝐶^{𝑠,𝜆} Targets" class="ltx_ref"><span class="ltx_text ltx_ref_tag">8</span></a>, there exists Transformers <math id="S3.SS1.p19.m8" class="ltx_Math" alttext="\left\{\boldsymbol{T}_{i}^{(mnm)}\right\}_{i\in\left[C_{s+dn-1}^{dn-1}\right]}" display="inline" intent=":literal"><semantics><msub><mrow><mo>{</mo><msubsup><mi>𝑻</mi><mi>i</mi><mrow><mo stretchy="false">(</mo><mrow><mi>m</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><mi>m</mi></mrow><mo stretchy="false">)</mo></mrow></msubsup><mo>}</mo></mrow><mrow><mi>i</mi><mo>∈</mo><mrow><mo>[</mo><msubsup><mi>C</mi><mrow><mrow><mi>s</mi><mo>+</mo><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow></mrow><mo>−</mo><mn>1</mn></mrow><mrow><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow><mo>−</mo><mn>1</mn></mrow></msubsup><mo>]</mo></mrow></mrow></msub><annotation encoding="application/x-tex">\left\{\boldsymbol{T}_{i}^{(mnm)}\right\}_{i\in\left[C_{s+dn-1}^{dn-1}\right]}</annotation></semantics></math> with size</span></p>
<table id="S3.EGx85" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="S3.Ex124"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S3.Ex124.m1" class="ltx_Math" alttext="\displaystyle\left\{(2,2dn),(1,dn),\left(C\ln\frac{3^{\lceil\log_{2}(s-1)\rceil}-1}{2\epsilon_{1}},\max\left\{21\cdot 2^{\lceil\log_{2}(s-1)\rceil-1},2dn\right\}\right)\right\}" display="inline" intent=":literal"><semantics><mrow><mo>{</mo><mrow><mo stretchy="false">(</mo><mn>2</mn><mo>,</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow><mo stretchy="false">)</mo></mrow><mo>,</mo><mrow><mo stretchy="false">(</mo><mn>1</mn><mo>,</mo><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow><mo stretchy="false">)</mo></mrow><mo>,</mo><mrow><mo>(</mo><mrow><mi>C</mi><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>ln</mi><mo lspace="0.167em">⁡</mo><mstyle displaystyle="true"><mfrac><mrow><msup><mn>3</mn><mrow><mo stretchy="false">⌈</mo><mrow><msub><mi>log</mi><mn>2</mn></msub><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>s</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">⌉</mo></mrow></msup><mo>−</mo><mn>1</mn></mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>ϵ</mi><mn>1</mn></msub></mrow></mfrac></mstyle></mrow></mrow><mo>,</mo><mrow><mi>max</mi><mo>⁡</mo><mrow><mo>{</mo><mrow><mn>21</mn><mo lspace="0.222em" rspace="0.222em">⋅</mo><msup><mn>2</mn><mrow><mrow><mo stretchy="false">⌈</mo><mrow><msub><mi>log</mi><mn>2</mn></msub><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>s</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">⌉</mo></mrow><mo>−</mo><mn>1</mn></mrow></msup></mrow><mo>,</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow><mo>}</mo></mrow></mrow><mo>)</mo></mrow><mo>}</mo></mrow><annotation encoding="application/x-tex">\displaystyle\left\{(2,2dn),(1,dn),\left(C\ln\frac{3^{\lceil\log_{2}(s-1)\rceil}-1}{2\epsilon_{1}},\max\left\{21\cdot 2^{\lceil\log_{2}(s-1)\rceil-1},2dn\right\}\right)\right\}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S3.SS1.p19.4" class="ltx_p"><span id="S3.SS1.p19.4.1" class="ltx_text">and dimension vector <math id="S3.SS1.p19.m9" class="ltx_Math" alttext="\begin{pmatrix}d+n&amp;d+n&amp;2dn&amp;1\end{pmatrix}" display="inline" intent=":literal"><semantics><mrow><mo>(</mo><mtable columnspacing="5pt"><mtr><mtd><mrow><mi>d</mi><mo>+</mo><mi>n</mi></mrow></mtd><mtd><mrow><mi>d</mi><mo>+</mo><mi>n</mi></mrow></mtd><mtd><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow></mtd><mtd><mn>1</mn></mtd></mtr></mtable><mo>)</mo></mrow><annotation encoding="application/x-tex">\begin{pmatrix}d+n&amp;d+n&amp;2dn&amp;1\end{pmatrix}</annotation></semantics></math> such that for <math id="S3.SS1.p19.m10" class="ltx_Math" alttext="i\in\left[C_{s+dn-1}^{dn-1}\right]" display="inline" intent=":literal"><semantics><mrow><mi>i</mi><mo>∈</mo><mrow><mo>[</mo><msubsup><mi>C</mi><mrow><mrow><mi>s</mi><mo>+</mo><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow></mrow><mo>−</mo><mn>1</mn></mrow><mrow><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow><mo>−</mo><mn>1</mn></mrow></msubsup><mo>]</mo></mrow></mrow><annotation encoding="application/x-tex">i\in\left[C_{s+dn-1}^{dn-1}\right]</annotation></semantics></math>,</span></p>
<table id="S3.EGx86" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="S3.Ex125"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S3.Ex125.m1" class="ltx_Math" alttext="\displaystyle\boldsymbol{T}_{i}^{(mnm)}\left(\begin{pmatrix}\boldsymbol{\bar{X}}\\
\boldsymbol{I}_{n\times n}-\boldsymbol{1}_{n\times n}\end{pmatrix}\right)=f_{FF,i}^{(mnm)}\left(\boldsymbol{\bar{X}}^{(flt)}\right)\boldsymbol{1}_{1\times n}." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><msubsup><mi>𝑻</mi><mi>i</mi><mrow><mo stretchy="false">(</mo><mrow><mi>m</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><mi>m</mi></mrow><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mo>(</mo><mtable rowspacing="0pt"><mtr><mtd><mover accent="true"><mi>𝑿</mi><mo>¯</mo></mover></mtd></mtr><mtr><mtd><mrow><msub><mi>𝑰</mi><mrow><mi>n</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>n</mi></mrow></msub><mo>−</mo><msub><mn>𝟏</mn><mrow><mi>n</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>n</mi></mrow></msub></mrow></mtd></mtr></mtable><mo>)</mo></mrow><mo>)</mo></mrow></mrow><mo>=</mo><mrow><msubsup><mi>f</mi><mrow><mrow><mi>F</mi><mo lspace="0em" rspace="0em">​</mo><mi>F</mi></mrow><mo>,</mo><mi>i</mi></mrow><mrow><mo stretchy="false">(</mo><mrow><mi>m</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><mi>m</mi></mrow><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><msup><mover accent="true"><mi>𝑿</mi><mo>¯</mo></mover><mrow><mo stretchy="false">(</mo><mrow><mi>f</mi><mo lspace="0em" rspace="0em">​</mo><mi>l</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow><mo stretchy="false">)</mo></mrow></msup><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mn>𝟏</mn><mrow><mn>1</mn><mo lspace="0.222em" rspace="0.222em">×</mo><mi>n</mi></mrow></msub></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\boldsymbol{T}_{i}^{(mnm)}\left(\begin{pmatrix}\boldsymbol{\bar{X}}\\
\boldsymbol{I}_{n\times n}-\boldsymbol{1}_{n\times n}\end{pmatrix}\right)=f_{FF,i}^{(mnm)}\left(\boldsymbol{\bar{X}}^{(flt)}\right)\boldsymbol{1}_{1\times n}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S3.SS1.p19.5" class="ltx_p"><span id="S3.SS1.p19.5.1" class="ltx_text">The weight bounds of <math id="S3.SS1.p19.m11" class="ltx_Math" alttext="\boldsymbol{T}_{i}^{(mnm)}" display="inline" intent=":literal"><semantics><msubsup><mi>𝑻</mi><mi>i</mi><mrow><mo stretchy="false">(</mo><mrow><mi>m</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><mi>m</mi></mrow><mo stretchy="false">)</mo></mrow></msubsup><annotation encoding="application/x-tex">\boldsymbol{T}_{i}^{(mnm)}</annotation></semantics></math> are <math id="S3.SS1.p19.m12" class="ltx_Math" alttext="B_{FF}=C,B_{SA}=1" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>B</mi><mrow><mi>F</mi><mo lspace="0em" rspace="0em">​</mo><mi>F</mi></mrow></msub><mo>=</mo><mi>C</mi></mrow><mo>,</mo><mrow><msub><mi>B</mi><mrow><mi>S</mi><mo lspace="0em" rspace="0em">​</mo><mi>A</mi></mrow></msub><mo>=</mo><mn>1</mn></mrow></mrow><annotation encoding="application/x-tex">B_{FF}=C,B_{SA}=1</annotation></semantics></math>. Based on Lemma <a href="#Thmlemma3" title="Lemma 3. ‣ 2.2 Proof of Theorem ‣ 2 Proofs of Main Results ‣ Standard Transformers Achieve the Minimax Rate in Nonparametric Regression with 𝐶^{𝑠,𝜆} Targets" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3</span></a>, there exists a Transformer <math id="S3.SS1.p19.m13" class="ltx_Math" alttext="\boldsymbol{T}^{(prl-mnm)}:\mathbb{R}^{(d+n)\times n}\to\mathbb{R}^{C_{s+dn-1}^{dn-1}\times n}" display="inline" intent=":literal"><semantics><mrow><msup><mi>𝑻</mi><mrow><mo stretchy="false">(</mo><mrow><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>l</mi></mrow><mo>−</mo><mrow><mi>m</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><mi>m</mi></mrow></mrow><mo stretchy="false">)</mo></mrow></msup><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><msup><mi>ℝ</mi><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>d</mi><mo>+</mo><mi>n</mi></mrow><mo rspace="0.055em" stretchy="false">)</mo></mrow><mo rspace="0.222em">×</mo><mi>n</mi></mrow></msup><mo stretchy="false">→</mo><msup><mi>ℝ</mi><mrow><msubsup><mi>C</mi><mrow><mrow><mi>s</mi><mo>+</mo><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow></mrow><mo>−</mo><mn>1</mn></mrow><mrow><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow><mo>−</mo><mn>1</mn></mrow></msubsup><mo lspace="0.222em" rspace="0.222em">×</mo><mi>n</mi></mrow></msup></mrow></mrow><annotation encoding="application/x-tex">\boldsymbol{T}^{(prl-mnm)}:\mathbb{R}^{(d+n)\times n}\to\mathbb{R}^{C_{s+dn-1}^{dn-1}\times n}</annotation></semantics></math> with size</span></p>
<table id="S3.EGx87" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="S3.Ex126"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S3.Ex126.m1" class="ltx_Math" alttext="\displaystyle\left\{\left(2,2dnC_{s+dn-1}^{dn-1}\right),\left(C_{s+dn-1}^{dn-1},dn\right),\left(C\ln\frac{3^{\lceil\log_{2}(s-1)\rceil}-1}{2\epsilon_{1}},\max\left\{21\cdot 2^{\lceil\log_{2}(s-1)\rceil-1},2dn\right\}C_{s+dn-1}^{dn-1}\right)\right\}" display="inline" intent=":literal"><semantics><mrow><mo>{</mo><mrow><mo>(</mo><mn>2</mn><mo>,</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>C</mi><mrow><mrow><mi>s</mi><mo>+</mo><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow></mrow><mo>−</mo><mn>1</mn></mrow><mrow><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow><mo>−</mo><mn>1</mn></mrow></msubsup></mrow><mo>)</mo></mrow><mo>,</mo><mrow><mo>(</mo><msubsup><mi>C</mi><mrow><mrow><mi>s</mi><mo>+</mo><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow></mrow><mo>−</mo><mn>1</mn></mrow><mrow><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow><mo>−</mo><mn>1</mn></mrow></msubsup><mo>,</mo><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow><mo>)</mo></mrow><mo>,</mo><mrow><mo>(</mo><mrow><mi>C</mi><mo lspace="0.167em" rspace="0em">​</mo><mi>ln</mi><mo lspace="0.167em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><mrow><msup><mn>3</mn><mrow><mo stretchy="false">⌈</mo><mrow><msub><mi>log</mi><mn>2</mn></msub><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>s</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">⌉</mo></mrow></msup><mo>−</mo><mn>1</mn></mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>ϵ</mi><mn>1</mn></msub></mrow></mfrac></mstyle></mrow><mo>,</mo><mrow><mrow><mi>max</mi><mo>⁡</mo><mrow><mo>{</mo><mrow><mn>21</mn><mo lspace="0.222em" rspace="0.222em">⋅</mo><msup><mn>2</mn><mrow><mrow><mo stretchy="false">⌈</mo><mrow><msub><mi>log</mi><mn>2</mn></msub><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>s</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">⌉</mo></mrow><mo>−</mo><mn>1</mn></mrow></msup></mrow><mo>,</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow><mo>}</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>C</mi><mrow><mrow><mi>s</mi><mo>+</mo><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow></mrow><mo>−</mo><mn>1</mn></mrow><mrow><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow><mo>−</mo><mn>1</mn></mrow></msubsup></mrow><mo>)</mo></mrow><mo>}</mo></mrow><annotation encoding="application/x-tex">\displaystyle\left\{\left(2,2dnC_{s+dn-1}^{dn-1}\right),\left(C_{s+dn-1}^{dn-1},dn\right),\left(C\ln\frac{3^{\lceil\log_{2}(s-1)\rceil}-1}{2\epsilon_{1}},\max\left\{21\cdot 2^{\lceil\log_{2}(s-1)\rceil-1},2dn\right\}C_{s+dn-1}^{dn-1}\right)\right\}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S3.SS1.p19.6" class="ltx_p"><span id="S3.SS1.p19.6.1" class="ltx_text">and dimension vector <math id="S3.SS1.p19.m14" class="ltx_Math" alttext="\begin{pmatrix}d+n&amp;d+n&amp;2dnC_{s+dn-1}^{dn-1}&amp;C_{s+dn-1}^{dn-1}\end{pmatrix}" display="inline" intent=":literal"><semantics><mrow><mo>(</mo><mtable columnspacing="5pt"><mtr><mtd><mrow><mi>d</mi><mo>+</mo><mi>n</mi></mrow></mtd><mtd><mrow><mi>d</mi><mo>+</mo><mi>n</mi></mrow></mtd><mtd><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>C</mi><mrow><mrow><mi>s</mi><mo>+</mo><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow></mrow><mo>−</mo><mn>1</mn></mrow><mrow><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow><mo>−</mo><mn>1</mn></mrow></msubsup></mrow></mtd><mtd><msubsup><mi>C</mi><mrow><mrow><mi>s</mi><mo>+</mo><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow></mrow><mo>−</mo><mn>1</mn></mrow><mrow><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow><mo>−</mo><mn>1</mn></mrow></msubsup></mtd></mtr></mtable><mo>)</mo></mrow><annotation encoding="application/x-tex">\begin{pmatrix}d+n&amp;d+n&amp;2dnC_{s+dn-1}^{dn-1}&amp;C_{s+dn-1}^{dn-1}\end{pmatrix}</annotation></semantics></math> such that</span></p>
<table id="S3.EGx88" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="S3.Ex127"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
