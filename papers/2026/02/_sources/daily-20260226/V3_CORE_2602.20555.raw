<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S2.Ex62.m1" class="ltx_Math" alttext="\displaystyle\boldsymbol{\mathcal{F}}_{FF}^{(prl)}\left(\begin{pmatrix}\boldsymbol{X}\\
\boldsymbol{Y}\end{pmatrix}\right)" display="inline" intent=":literal"><semantics><mrow><msubsup><mi class="ltx_font_mathcaligraphic">𝓕</mi><mrow><mi>F</mi><mo lspace="0em" rspace="0em">​</mo><mi>F</mi></mrow><mrow><mo stretchy="false">(</mo><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>l</mi></mrow><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mo>(</mo><mtable rowspacing="0pt"><mtr><mtd><mi>𝑿</mi></mtd></mtr><mtr><mtd><mi>𝒀</mi></mtd></mtr></mtable><mo>)</mo></mrow><mo>)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\boldsymbol{\mathcal{F}}_{FF}^{(prl)}\left(\begin{pmatrix}\boldsymbol{X}\\
