<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="S3.Ex159"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S3.Ex159.m1" class="ltx_Math" alttext="\displaystyle\quad+\left|\sum_{i=1}^{C_{s+dn-1}^{dn-1}}c_{i,j}(f_{pq})\boldsymbol{\bar{X}}^{\boldsymbol{\alpha}_{i}}-f_{pq}(\boldsymbol{X})\right|" display="inline" intent=":literal"><semantics><mrow><mo>+</mo><mrow><mo>|</mo><mrow><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><msubsup><mi>C</mi><mrow><mrow><mi>s</mi><mo>+</mo><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow></mrow><mo>−</mo><mn>1</mn></mrow><mrow><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow><mo>−</mo><mn>1</mn></mrow></msubsup></munderover></mstyle><mrow><msub><mi>c</mi><mrow><mi>i</mi><mo>,</mo><mi>j</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>f</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mover accent="true"><mi>𝑿</mi><mo>¯</mo></mover><msub><mi>𝜶</mi><mi>i</mi></msub></msup></mrow></mrow><mo>−</mo><mrow><msub><mi>f</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝑿</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>|</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\quad+\left|\sum_{i=1}^{C_{s+dn-1}^{dn-1}}c_{i,j}(f_{pq})\boldsymbol{\bar{X}}^{\boldsymbol{\alpha}_{i}}-f_{pq}(\boldsymbol{X})\right|</annotation></semantics></math></td>
