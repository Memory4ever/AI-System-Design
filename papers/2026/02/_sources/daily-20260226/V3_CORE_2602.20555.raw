<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S3.Ex127.m1" class="ltx_Math" alttext="\displaystyle\boldsymbol{T}^{(prl-mnm)}\left(\boldsymbol{Y}\right):=\begin{pmatrix}\boldsymbol{T}_{1}^{(mnm)}\left(\boldsymbol{Y}\right)\\
\boldsymbol{T}_{2}^{(mnm)}\left(\boldsymbol{Y}\right)\\
\vdots\\
\boldsymbol{T}_{C_{s+dn-1}^{dn-1}}^{(mnm)}\left(\boldsymbol{Y}\right)\end{pmatrix},\quad\boldsymbol{Y}\in\mathbb{R}^{(d+n)\times n}." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mrow><msup><mi>𝑻</mi><mrow><mo stretchy="false">(</mo><mrow><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>l</mi></mrow><mo>−</mo><mrow><mi>m</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><mi>m</mi></mrow></mrow><mo stretchy="false">)</mo></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mi>𝒀</mi><mo>)</mo></mrow></mrow><mo>:=</mo><mrow><mo>(</mo><mtable rowspacing="0pt"><mtr><mtd><mrow><msubsup><mi>𝑻</mi><mn>1</mn><mrow><mo stretchy="false">(</mo><mrow><mi>m</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><mi>m</mi></mrow><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mi>𝒀</mi><mo>)</mo></mrow></mrow></mtd></mtr><mtr><mtd><mrow><msubsup><mi>𝑻</mi><mn>2</mn><mrow><mo stretchy="false">(</mo><mrow><mi>m</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><mi>m</mi></mrow><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mi>𝒀</mi><mo>)</mo></mrow></mrow></mtd></mtr><mtr><mtd></mtd></mtr><mtr><mtd><mrow><msubsup><mi>𝑻</mi><msubsup><mi>C</mi><mrow><mrow><mi>s</mi><mo>+</mo><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow></mrow><mo>−</mo><mn>1</mn></mrow><mrow><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow><mo>−</mo><mn>1</mn></mrow></msubsup><mrow><mo stretchy="false">(</mo><mrow><mi>m</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><mi>m</mi></mrow><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mi>𝒀</mi><mo>)</mo></mrow></mrow></mtd></mtr></mtable><mo>)</mo></mrow></mrow><mo rspace="1.167em">,</mo><mrow><mi>𝒀</mi><mo>∈</mo><msup><mi>ℝ</mi><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>d</mi><mo>+</mo><mi>n</mi></mrow><mo rspace="0.055em" stretchy="false">)</mo></mrow><mo rspace="0.222em">×</mo><mi>n</mi></mrow></msup></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\boldsymbol{T}^{(prl-mnm)}\left(\boldsymbol{Y}\right):=\begin{pmatrix}\boldsymbol{T}_{1}^{(mnm)}\left(\boldsymbol{Y}\right)\\
\boldsymbol{T}_{2}^{(mnm)}\left(\boldsymbol{Y}\right)\\
\vdots\\
\boldsymbol{T}_{C_{s+dn-1}^{dn-1}}^{(mnm)}\left(\boldsymbol{Y}\right)\end{pmatrix},\quad\boldsymbol{Y}\in\mathbb{R}^{(d+n)\times n}.</annotation></semantics></math></td>
