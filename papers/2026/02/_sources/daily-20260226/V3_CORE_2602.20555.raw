\boldsymbol{W}_{O,h}^{(2)}\end{pmatrix},\quad\boldsymbol{W}_{V,h,2}^{(prl)}:=\begin{pmatrix}\boldsymbol{0}_{S^{(2)}\times d^{(1)}}&amp;\boldsymbol{W}_{V,h}^{(2)}\end{pmatrix}," display="inline" intent=":literal"><semantics><mrow><mrow><mrow><msubsup><mi>𝑾</mi><mrow><mi>O</mi><mo>,</mo><mi>h</mi><mo>,</mo><mn>2</mn></mrow><mrow><mo stretchy="false">(</mo><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>l</mi></mrow><mo stretchy="false">)</mo></mrow></msubsup><mo>:=</mo><mrow><mo>(</mo><mtable rowspacing="0pt"><mtr><mtd><msub><mn>𝟎</mn><mrow><msub><mi>d</mi><mn>1</mn></msub><mo lspace="0.222em" rspace="0.222em">×</mo><msub><mi>S</mi><mn>2</mn></msub></mrow></msub></mtd></mtr><mtr><mtd><msubsup><mi>𝑾</mi><mrow><mi>O</mi><mo>,</mo><mi>h</mi></mrow><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup></mtd></mtr></mtable><mo>)</mo></mrow></mrow><mo rspace="1.167em">,</mo><mrow><msubsup><mi>𝑾</mi><mrow><mi>V</mi><mo>,</mo><mi>h</mi><mo>,</mo><mn>2</mn></mrow><mrow><mo stretchy="false">(</mo><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>l</mi></mrow><mo stretchy="false">)</mo></mrow></msubsup><mo>:=</mo><mrow><mo>(</mo><mtable columnspacing="5pt"><mtr><mtd><msub><mn>𝟎</mn><mrow><msup><mi>S</mi><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msup><mo lspace="0.222em" rspace="0.222em">×</mo><msup><mi>d</mi><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msup></mrow></msub></mtd><mtd><msubsup><mi>𝑾</mi><mrow><mi>V</mi><mo>,</mo><mi>h</mi></mrow><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup></mtd></mtr></mtable><mo>)</mo></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\boldsymbol{W}_{O,h,2}^{(prl)}:=\begin{pmatrix}\boldsymbol{0}_{d_{1}\times S_{2}}\\
\boldsymbol{W}_{O,h}^{(2)}\end{pmatrix},\quad\boldsymbol{W}_{V,h,2}^{(prl)}:=\begin{pmatrix}\boldsymbol{0}_{S^{(2)}\times d^{(1)}}&amp;\boldsymbol{W}_{V,h}^{(2)}\end{pmatrix},</annotation></semantics></math></td>
