<li id="S2.I2.ix3" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(3)</span> 
<div id="S2.I2.ix3.p1" class="ltx_para">
<p id="S2.I2.ix3.p1.1" class="ltx_p"><span id="S2.I2.ix3.p1.1.1" class="ltx_text ltx_font_italic">Let </span><math id="S2.I2.ix3.p1.m1" class="ltx_Math" alttext="\boldsymbol{T}^{(1)}:\mathbb{R}^{d_{in}^{(1)}\times n}\to\mathbb{R}^{d_{out}^{(1)}\times n}" display="inline" intent=":literal"><semantics><mrow><msup><mi>𝑻</mi><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msup><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><msup><mi>ℝ</mi><mrow><msubsup><mi>d</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0.222em" rspace="0.222em">×</mo><mi>n</mi></mrow></msup><mo stretchy="false">→</mo><msup><mi>ℝ</mi><mrow><msubsup><mi>d</mi><mrow><mi>o</mi><mo lspace="0em" rspace="0em">​</mo><mi>u</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0.222em" rspace="0.222em">×</mo><mi>n</mi></mrow></msup></mrow></mrow><annotation encoding="application/x-tex">\boldsymbol{T}^{(1)}:\mathbb{R}^{d_{in}^{(1)}\times n}\to\mathbb{R}^{d_{out}^{(1)}\times n}</annotation></semantics></math><span id="S2.I2.ix3.p1.1.2" class="ltx_text ltx_font_italic"> and </span><math id="S2.I2.ix3.p1.m2" class="ltx_Math" alttext="\boldsymbol{T}^{(2)}:\mathbb{R}^{d_{in}^{(2)}\times n}\to\mathbb{R}^{d_{out}^{(2)}\times n}" display="inline" intent=":literal"><semantics><mrow><msup><mi>𝑻</mi><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msup><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><msup><mi>ℝ</mi><mrow><msubsup><mi>d</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0.222em" rspace="0.222em">×</mo><mi>n</mi></mrow></msup><mo stretchy="false">→</mo><msup><mi>ℝ</mi><mrow><msubsup><mi>d</mi><mrow><mi>o</mi><mo lspace="0em" rspace="0em">​</mo><mi>u</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0.222em" rspace="0.222em">×</mo><mi>n</mi></mrow></msup></mrow></mrow><annotation encoding="application/x-tex">\boldsymbol{T}^{(2)}:\mathbb{R}^{d_{in}^{(2)}\times n}\to\mathbb{R}^{d_{out}^{(2)}\times n}</annotation></semantics></math><span id="S2.I2.ix3.p1.1.3" class="ltx_text ltx_font_italic"> be two Transformers with sizes</span></p>
<table id="S2.EGx37" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="S2.Ex64"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S2.Ex64.m1" class="ltx_Math" alttext="\displaystyle\left\{\left(L_{0},W_{0}^{(1)}\right),\left(H_{1}^{(1)},S_{1}^{(1)}\right),\left(L_{1},W_{1}^{(1)}\right),\cdots,\left(H_{K}^{(1)},S_{K}^{(1)}\right),\left(L_{K},W_{K}^{(1)}\right)\right\}," display="inline" intent=":literal"><semantics><mrow><mrow><mo>{</mo><mrow><mrow><mo>(</mo><msub><mi>L</mi><mn>0</mn></msub><mo>,</mo><msubsup><mi>W</mi><mn>0</mn><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msubsup><mo>)</mo></mrow><mo>,</mo><mrow><mo>(</mo><msubsup><mi>H</mi><mn>1</mn><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msubsup><mo>,</mo><msubsup><mi>S</mi><mn>1</mn><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msubsup><mo>)</mo></mrow><mo>,</mo><mrow><mo>(</mo><msub><mi>L</mi><mn>1</mn></msub><mo>,</mo><msubsup><mi>W</mi><mn>1</mn><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msubsup><mo>)</mo></mrow><mo>,</mo><mo lspace="0em" rspace="0em">⋯</mo><mo>,</mo><mrow><mo>(</mo><msubsup><mi>H</mi><mi>K</mi><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msubsup><mo>,</mo><msubsup><mi>S</mi><mi>K</mi><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msubsup><mo>)</mo></mrow><mo>,</mo><mrow><mo>(</mo><msub><mi>L</mi><mi>K</mi></msub><mo>,</mo><msubsup><mi>W</mi><mi>K</mi><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msubsup><mo>)</mo></mrow></mrow><mo>}</mo></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\left\{\left(L_{0},W_{0}^{(1)}\right),\left(H_{1}^{(1)},S_{1}^{(1)}\right),\left(L_{1},W_{1}^{(1)}\right),\cdots,\left(H_{K}^{(1)},S_{K}^{(1)}\right),\left(L_{K},W_{K}^{(1)}\right)\right\},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="S2.Ex65"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S2.Ex65.m1" class="ltx_Math" alttext="\displaystyle\left\{\left(L_{0},W_{0}^{(2)}\right),\left(H_{1}^{(2)},S_{1}^{(2)}\right),\left(L_{1},W_{1}^{(2)}\right),\cdots,\left(H_{K}^{(2)},S_{K}^{(2)}\right),\left(L_{K},W_{K}^{(2)}\right)\right\}," display="inline" intent=":literal"><semantics><mrow><mrow><mo>{</mo><mrow><mrow><mo>(</mo><msub><mi>L</mi><mn>0</mn></msub><mo>,</mo><msubsup><mi>W</mi><mn>0</mn><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup><mo>)</mo></mrow><mo>,</mo><mrow><mo>(</mo><msubsup><mi>H</mi><mn>1</mn><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup><mo>,</mo><msubsup><mi>S</mi><mn>1</mn><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup><mo>)</mo></mrow><mo>,</mo><mrow><mo>(</mo><msub><mi>L</mi><mn>1</mn></msub><mo>,</mo><msubsup><mi>W</mi><mn>1</mn><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup><mo>)</mo></mrow><mo>,</mo><mo lspace="0em" rspace="0em">⋯</mo><mo>,</mo><mrow><mo>(</mo><msubsup><mi>H</mi><mi>K</mi><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup><mo>,</mo><msubsup><mi>S</mi><mi>K</mi><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup><mo>)</mo></mrow><mo>,</mo><mrow><mo>(</mo><msub><mi>L</mi><mi>K</mi></msub><mo>,</mo><msubsup><mi>W</mi><mi>K</mi><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup><mo>)</mo></mrow></mrow><mo>}</mo></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\left\{\left(L_{0},W_{0}^{(2)}\right),\left(H_{1}^{(2)},S_{1}^{(2)}\right),\left(L_{1},W_{1}^{(2)}\right),\cdots,\left(H_{K}^{(2)},S_{K}^{(2)}\right),\left(L_{K},W_{K}^{(2)}\right)\right\},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S2.I2.ix3.p1.2" class="ltx_p"><span id="S2.I2.ix3.p1.2.1" class="ltx_text ltx_font_italic">dimension vectors</span></p>
<table id="S2.EGx38" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="S2.Ex66"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S2.Ex66.m1" class="ltx_Math" alttext="\displaystyle\begin{pmatrix}d_{in}^{(1)}&amp;d_{0}^{(1)}&amp;d_{1}^{(1)}&amp;\cdots&amp;d_{K}^{(1)}&amp;d_{out}^{(1)}\end{pmatrix},\quad\begin{pmatrix}d_{in}^{(2)}&amp;d_{0}^{(2)}&amp;d_{1}^{(2)}&amp;\cdots&amp;d_{K}^{(2)}&amp;d_{out}^{(2)}\end{pmatrix}," display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mo>(</mo><mtable columnspacing="5pt"><mtr><mtd><msubsup><mi>d</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msubsup></mtd><mtd><msubsup><mi>d</mi><mn>0</mn><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msubsup></mtd><mtd><msubsup><mi>d</mi><mn>1</mn><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msubsup></mtd><mtd><mo>⋯</mo></mtd><mtd><msubsup><mi>d</mi><mi>K</mi><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msubsup></mtd><mtd><msubsup><mi>d</mi><mrow><mi>o</mi><mo lspace="0em" rspace="0em">​</mo><mi>u</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msubsup></mtd></mtr></mtable><mo>)</mo></mrow><mo rspace="1.167em">,</mo><mrow><mo>(</mo><mtable columnspacing="5pt"><mtr><mtd><msubsup><mi>d</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup></mtd><mtd><msubsup><mi>d</mi><mn>0</mn><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup></mtd><mtd><msubsup><mi>d</mi><mn>1</mn><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup></mtd><mtd><mo>⋯</mo></mtd><mtd><msubsup><mi>d</mi><mi>K</mi><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup></mtd><mtd><msubsup><mi>d</mi><mrow><mi>o</mi><mo lspace="0em" rspace="0em">​</mo><mi>u</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup></mtd></mtr></mtable><mo>)</mo></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\begin{pmatrix}d_{in}^{(1)}&amp;d_{0}^{(1)}&amp;d_{1}^{(1)}&amp;\cdots&amp;d_{K}^{(1)}&amp;d_{out}^{(1)}\end{pmatrix},\quad\begin{pmatrix}d_{in}^{(2)}&amp;d_{0}^{(2)}&amp;d_{1}^{(2)}&amp;\cdots&amp;d_{K}^{(2)}&amp;d_{out}^{(2)}\end{pmatrix},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S2.I2.ix3.p1.3" class="ltx_p"><span id="S2.I2.ix3.p1.3.1" class="ltx_text ltx_font_italic">weight bounds </span><math id="S2.I2.ix3.p1.m3" class="ltx_Math" alttext="\left(B_{FF}^{(1)},B_{SA}^{(1)}\right),\left(B_{FF}^{(2)},B_{SA}^{(2)}\right)" display="inline" intent=":literal"><semantics><mrow><mrow><mo>(</mo><msubsup><mi>B</mi><mrow><mi>F</mi><mo lspace="0em" rspace="0em">​</mo><mi>F</mi></mrow><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msubsup><mo>,</mo><msubsup><mi>B</mi><mrow><mi>S</mi><mo lspace="0em" rspace="0em">​</mo><mi>A</mi></mrow><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msubsup><mo>)</mo></mrow><mo>,</mo><mrow><mo>(</mo><msubsup><mi>B</mi><mrow><mi>F</mi><mo lspace="0em" rspace="0em">​</mo><mi>F</mi></mrow><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup><mo>,</mo><msubsup><mi>B</mi><mrow><mi>S</mi><mo lspace="0em" rspace="0em">​</mo><mi>A</mi></mrow><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup><mo>)</mo></mrow></mrow><annotation encoding="application/x-tex">\left(B_{FF}^{(1)},B_{SA}^{(1)}\right),\left(B_{FF}^{(2)},B_{SA}^{(2)}\right)</annotation></semantics></math><span id="S2.I2.ix3.p1.3.2" class="ltx_text ltx_font_italic">, respectively. There exists a Transformer </span><math id="S2.I2.ix3.p1.m4" class="ltx_Math" alttext="\boldsymbol{T}^{(prl)}:\mathbb{R}^{\left(d_{in}^{(1)}+d_{in}^{(2)}\right)\times n}\to\mathbb{R}^{\left(d_{out}^{(1)}+d_{out}^{(2)}\right)\times n}" display="inline" intent=":literal"><semantics><mrow><msup><mi>𝑻</mi><mrow><mo stretchy="false">(</mo><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>l</mi></mrow><mo stretchy="false">)</mo></mrow></msup><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><msup><mi>ℝ</mi><mrow><mrow><mo>(</mo><mrow><msubsup><mi>d</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msubsup><mo>+</mo><msubsup><mi>d</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup></mrow><mo rspace="0.055em">)</mo></mrow><mo rspace="0.222em">×</mo><mi>n</mi></mrow></msup><mo stretchy="false">→</mo><msup><mi>ℝ</mi><mrow><mrow><mo>(</mo><mrow><msubsup><mi>d</mi><mrow><mi>o</mi><mo lspace="0em" rspace="0em">​</mo><mi>u</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msubsup><mo>+</mo><msubsup><mi>d</mi><mrow><mi>o</mi><mo lspace="0em" rspace="0em">​</mo><mi>u</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup></mrow><mo rspace="0.055em">)</mo></mrow><mo rspace="0.222em">×</mo><mi>n</mi></mrow></msup></mrow></mrow><annotation encoding="application/x-tex">\boldsymbol{T}^{(prl)}:\mathbb{R}^{\left(d_{in}^{(1)}+d_{in}^{(2)}\right)\times n}\to\mathbb{R}^{\left(d_{out}^{(1)}+d_{out}^{(2)}\right)\times n}</annotation></semantics></math><span id="S2.I2.ix3.p1.3.3" class="ltx_text ltx_font_italic"> with size</span></p>
<table id="S2.EGx39" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="S2.Ex67"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S2.Ex67.m1" class="ltx_math_unparsed" alttext="\displaystyle\left\{\left(L_{0},W_{0}^{(1)}+W_{0}^{(2)}\right),\left(H_{1}^{(1)}+H_{1}^{(2)},\max\left\{S_{1}^{(1)},S_{1}^{(2)}\right\}\right),\left(L_{1},W_{1}^{(1)}+W_{1}^{(2)}\right),\cdots,\right." display="inline" intent=":literal"><semantics><mrow><mo>{</mo><mrow><mo>(</mo><msub><mi>L</mi><mn>0</mn></msub><mo>,</mo><msubsup><mi>W</mi><mn>0</mn><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msubsup><mo>+</mo><msubsup><mi>W</mi><mn>0</mn><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup><mo>)</mo></mrow><mo>,</mo><mrow><mo>(</mo><msubsup><mi>H</mi><mn>1</mn><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msubsup><mo>+</mo><msubsup><mi>H</mi><mn>1</mn><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup><mo>,</mo><mi>max</mi><mrow><mo>{</mo><msubsup><mi>S</mi><mn>1</mn><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msubsup><mo>,</mo><msubsup><mi>S</mi><mn>1</mn><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup><mo>}</mo></mrow><mo>)</mo></mrow><mo>,</mo><mrow><mo>(</mo><msub><mi>L</mi><mn>1</mn></msub><mo>,</mo><msubsup><mi>W</mi><mn>1</mn><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msubsup><mo>+</mo><msubsup><mi>W</mi><mn>1</mn><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup><mo>)</mo></mrow><mo>,</mo><mo lspace="0em" rspace="0em">⋯</mo><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\left\{\left(L_{0},W_{0}^{(1)}+W_{0}^{(2)}\right),\left(H_{1}^{(1)}+H_{1}^{(2)},\max\left\{S_{1}^{(1)},S_{1}^{(2)}\right\}\right),\left(L_{1},W_{1}^{(1)}+W_{1}^{(2)}\right),\cdots,\right.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="S2.Ex68"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S2.Ex68.m1" class="ltx_math_unparsed" alttext="\displaystyle\left.\ \ \left(H_{K}^{(1)}+H_{K}^{(2)},\max\left\{S_{K}^{(1)},S_{K}^{(2)}\right\}\right),\left(L_{K},W_{K}^{(1)}+W_{K}^{(2)}\right)\right\}," display="inline" intent=":literal"><semantics><mrow><mrow><mo>(</mo><msubsup><mi>H</mi><mi>K</mi><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msubsup><mo>+</mo><msubsup><mi>H</mi><mi>K</mi><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup><mo>,</mo><mi>max</mi><mrow><mo>{</mo><msubsup><mi>S</mi><mi>K</mi><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msubsup><mo>,</mo><msubsup><mi>S</mi><mi>K</mi><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup><mo>}</mo></mrow><mo>)</mo></mrow><mo>,</mo><mrow><mo>(</mo><msub><mi>L</mi><mi>K</mi></msub><mo>,</mo><msubsup><mi>W</mi><mi>K</mi><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msubsup><mo>+</mo><msubsup><mi>W</mi><mi>K</mi><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup><mo>)</mo></mrow><mo>}</mo><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\left.\ \ \left(H_{K}^{(1)}+H_{K}^{(2)},\max\left\{S_{K}^{(1)},S_{K}^{(2)}\right\}\right),\left(L_{K},W_{K}^{(1)}+W_{K}^{(2)}\right)\right\},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S2.I2.ix3.p1.4" class="ltx_p"><span id="S2.I2.ix3.p1.4.1" class="ltx_text ltx_font_italic">dimension vector</span></p>
<table id="S2.EGx40" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="S2.Ex69"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S2.Ex69.m1" class="ltx_Math" alttext="\displaystyle\begin{pmatrix}d_{in}^{(1)}+d_{in}^{(2)}&amp;d_{0}^{(1)}+d_{0}^{(2)}&amp;d_{1}^{(1)}+d_{1}^{(2)}&amp;\cdots&amp;d_{K}^{(1)}+d_{K}^{(2)}&amp;d_{out}^{(1)}+d_{out}^{(2)}\end{pmatrix}" display="inline" intent=":literal"><semantics><mrow><mo>(</mo><mtable columnspacing="5pt"><mtr><mtd><mrow><msubsup><mi>d</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msubsup><mo>+</mo><msubsup><mi>d</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup></mrow></mtd><mtd><mrow><msubsup><mi>d</mi><mn>0</mn><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msubsup><mo>+</mo><msubsup><mi>d</mi><mn>0</mn><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup></mrow></mtd><mtd><mrow><msubsup><mi>d</mi><mn>1</mn><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msubsup><mo>+</mo><msubsup><mi>d</mi><mn>1</mn><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup></mrow></mtd><mtd><mo>⋯</mo></mtd><mtd><mrow><msubsup><mi>d</mi><mi>K</mi><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msubsup><mo>+</mo><msubsup><mi>d</mi><mi>K</mi><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup></mrow></mtd><mtd><mrow><msubsup><mi>d</mi><mrow><mi>o</mi><mo lspace="0em" rspace="0em">​</mo><mi>u</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msubsup><mo>+</mo><msubsup><mi>d</mi><mrow><mi>o</mi><mo lspace="0em" rspace="0em">​</mo><mi>u</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup></mrow></mtd></mtr></mtable><mo>)</mo></mrow><annotation encoding="application/x-tex">\displaystyle\begin{pmatrix}d_{in}^{(1)}+d_{in}^{(2)}&amp;d_{0}^{(1)}+d_{0}^{(2)}&amp;d_{1}^{(1)}+d_{1}^{(2)}&amp;\cdots&amp;d_{K}^{(1)}+d_{K}^{(2)}&amp;d_{out}^{(1)}+d_{out}^{(2)}\end{pmatrix}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S2.I2.ix3.p1.5" class="ltx_p"><span id="S2.I2.ix3.p1.5.1" class="ltx_text ltx_font_italic">and weight bounds</span></p>
<table id="S2.EGx41" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="S2.Ex70"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S2.Ex70.m1" class="ltx_Math" alttext="\displaystyle B_{FF}=\max\left\{B_{FF}^{(1)},B_{FF}^{(2)}\right\},\quad B_{SA}=\max\left\{B_{SA}^{(1)},B_{SA}^{(2)}\right\}" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>B</mi><mrow><mi>F</mi><mo lspace="0em" rspace="0em">​</mo><mi>F</mi></mrow></msub><mo>=</mo><mrow><mi>max</mi><mo>⁡</mo><mrow><mo>{</mo><msubsup><mi>B</mi><mrow><mi>F</mi><mo lspace="0em" rspace="0em">​</mo><mi>F</mi></mrow><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msubsup><mo>,</mo><msubsup><mi>B</mi><mrow><mi>F</mi><mo lspace="0em" rspace="0em">​</mo><mi>F</mi></mrow><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup><mo>}</mo></mrow></mrow></mrow><mo rspace="1.167em">,</mo><mrow><msub><mi>B</mi><mrow><mi>S</mi><mo lspace="0em" rspace="0em">​</mo><mi>A</mi></mrow></msub><mo>=</mo><mrow><mi>max</mi><mo>⁡</mo><mrow><mo>{</mo><msubsup><mi>B</mi><mrow><mi>S</mi><mo lspace="0em" rspace="0em">​</mo><mi>A</mi></mrow><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msubsup><mo>,</mo><msubsup><mi>B</mi><mrow><mi>S</mi><mo lspace="0em" rspace="0em">​</mo><mi>A</mi></mrow><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup><mo>}</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle B_{FF}=\max\left\{B_{FF}^{(1)},B_{FF}^{(2)}\right\},\quad B_{SA}=\max\left\{B_{SA}^{(1)},B_{SA}^{(2)}\right\}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S2.I2.ix3.p1.6" class="ltx_p"><span id="S2.I2.ix3.p1.6.1" class="ltx_text ltx_font_italic">such that for any </span><math id="S2.I2.ix3.p1.m5" class="ltx_Math" alttext="\boldsymbol{X}\in\mathbb{R}^{d_{in}^{(1)}\times n},\boldsymbol{Y}\in\mathbb{R}^{d_{in}^{(2)}\times n}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>𝑿</mi><mo>∈</mo><msup><mi>ℝ</mi><mrow><msubsup><mi>d</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0.222em" rspace="0.222em">×</mo><mi>n</mi></mrow></msup></mrow><mo>,</mo><mrow><mi>𝒀</mi><mo>∈</mo><msup><mi>ℝ</mi><mrow><msubsup><mi>d</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0.222em" rspace="0.222em">×</mo><mi>n</mi></mrow></msup></mrow></mrow><annotation encoding="application/x-tex">\boldsymbol{X}\in\mathbb{R}^{d_{in}^{(1)}\times n},\boldsymbol{Y}\in\mathbb{R}^{d_{in}^{(2)}\times n}</annotation></semantics></math><span id="S2.I2.ix3.p1.6.2" class="ltx_text ltx_font_italic">,</span></p>
<table id="S2.EGx42" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="S2.Ex71"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S2.Ex71.m1" class="ltx_Math" alttext="\displaystyle\boldsymbol{T}^{(prl)}\left(\begin{pmatrix}\boldsymbol{X}\\
\boldsymbol{Y}\end{pmatrix}\right)" display="inline" intent=":literal"><semantics><mrow><msup><mi>𝑻</mi><mrow><mo stretchy="false">(</mo><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>l</mi></mrow><mo stretchy="false">)</mo></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mo>(</mo><mtable rowspacing="0pt"><mtr><mtd><mi>𝑿</mi></mtd></mtr><mtr><mtd><mi>𝒀</mi></mtd></mtr></mtable><mo>)</mo></mrow><mo>)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\boldsymbol{T}^{(prl)}\left(\begin{pmatrix}\boldsymbol{X}\\
\boldsymbol{Y}\end{pmatrix}\right)</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S2.Ex71.m2" class="ltx_Math" alttext="\displaystyle=\begin{pmatrix}\boldsymbol{T}^{(1)}(\boldsymbol{X})\\
\boldsymbol{T}^{(2)}(\boldsymbol{Y})\end{pmatrix}." display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>=</mo><mrow><mo>(</mo><mtable rowspacing="0pt"><mtr><mtd><mrow><msup><mi>𝑻</mi><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝑿</mi><mo stretchy="false">)</mo></mrow></mrow></mtd></mtr><mtr><mtd><mrow><msup><mi>𝑻</mi><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝒀</mi><mo stretchy="false">)</mo></mrow></mrow></mtd></mtr></mtable><mo>)</mo></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle=\begin{pmatrix}\boldsymbol{T}^{(1)}(\boldsymbol{X})\\
\boldsymbol{T}^{(2)}(\boldsymbol{Y})\end{pmatrix}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div></li>
</ol>
</div>
</div>
<div id="S2.SS2.2" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof of Theorem <a href="#Thmtheorem2" title="Theorem 2. ‣ 1.2 Main Results ‣ 1 Introduction ‣ Standard Transformers Achieve the Minimax Rate in Nonparametric Regression with 𝐶^{𝑠,𝜆} Targets" class="ltx_ref"><span class="ltx_text ltx_ref_tag">2</span></a>.</h6>
<div id="S2.SS2.p4" class="ltx_para">
<p id="S2.SS2.p4.1" class="ltx_p"><span id="S2.SS2.p4.1.1" class="ltx_text">Using Proposition <a href="#Thmproposition1" title="Proposition 1. ‣ 2.1 Proof of Theorem ‣ 2 Proofs of Main Results ‣ Standard Transformers Achieve the Minimax Rate in Nonparametric Regression with 𝐶^{𝑠,𝜆} Targets" class="ltx_ref"><span class="ltx_text ltx_ref_tag">1</span></a> with <math id="S2.SS2.p4.m1" class="ltx_Math" alttext="\epsilon" display="inline" intent=":literal"><semantics><mi>ϵ</mi><annotation encoding="application/x-tex">\epsilon</annotation></semantics></math> replaced by <math id="S2.SS2.p4.m2" class="ltx_Math" alttext="\frac{\epsilon}{2}" display="inline" intent=":literal"><semantics><mfrac><mi>ϵ</mi><mn>2</mn></mfrac><annotation encoding="application/x-tex">\frac{\epsilon}{2}</annotation></semantics></math> therein, we obtain a Transformer <math id="S2.SS2.p4.m3" class="ltx_Math" alttext="\boldsymbol{\widetilde{T}}" display="inline" intent=":literal"><semantics><mover accent="true"><mi>𝑻</mi><mo>~</mo></mover><annotation encoding="application/x-tex">\boldsymbol{\widetilde{T}}</annotation></semantics></math> that can approximate <math id="S2.SS2.p4.m4" class="ltx_Math" alttext="\boldsymbol{f}" display="inline" intent=":literal"><semantics><mi>𝒇</mi><annotation encoding="application/x-tex">\boldsymbol{f}</annotation></semantics></math> entry-wise on <math id="S2.SS2.p4.m5" class="ltx_Math" alttext="[0,1]^{d\times n}\setminus\Omega^{(flaw)}" display="inline" intent=":literal"><semantics><mrow><msup><mrow><mo stretchy="false">[</mo><mrow><mn>0</mn><mo>,</mo><mn>1</mn></mrow><mo stretchy="false">]</mo></mrow><mrow><mi>d</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>n</mi></mrow></msup><mo>∖</mo><msup><mi mathvariant="normal">Ω</mi><mrow><mo stretchy="false">(</mo><mrow><mi>f</mi><mo lspace="0em" rspace="0em">​</mo><mi>l</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi><mo lspace="0em" rspace="0em">​</mo><mi>w</mi></mrow><mo stretchy="false">)</mo></mrow></msup></mrow><annotation encoding="application/x-tex">[0,1]^{d\times n}\setminus\Omega^{(flaw)}</annotation></semantics></math>. By shifting <math id="S2.SS2.p4.m6" class="ltx_Math" alttext="\boldsymbol{\widetilde{T}}" display="inline" intent=":literal"><semantics><mover accent="true"><mi>𝑻</mi><mo>~</mo></mover><annotation encoding="application/x-tex">\boldsymbol{\widetilde{T}}</annotation></semantics></math> in various ways, where each entry of the shift matrix takes values in <math id="S2.SS2.p4.m7" class="ltx_Math" alttext="\{-\delta,0,\delta\}" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">{</mo><mrow><mrow><mo>−</mo><mi>δ</mi></mrow><mo>,</mo><mn>0</mn><mo>,</mo><mi>δ</mi></mrow><mo stretchy="false">}</mo></mrow><annotation encoding="application/x-tex">\{-\delta,0,\delta\}</annotation></semantics></math>, we obtain <math id="S2.SS2.p4.m8" class="ltx_Math" alttext="3^{dn}" display="inline" intent=":literal"><semantics><msup><mn>3</mn><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow></msup><annotation encoding="application/x-tex">3^{dn}</annotation></semantics></math> distinct shifted versions of <math id="S2.SS2.p4.m9" class="ltx_Math" alttext="\boldsymbol{\widetilde{T}}" display="inline" intent=":literal"><semantics><mover accent="true"><mi>𝑻</mi><mo>~</mo></mover><annotation encoding="application/x-tex">\boldsymbol{\widetilde{T}}</annotation></semantics></math>. The shifting operation can be implemented via the embedding layer. Parallelizing these <math id="S2.SS2.p4.m10" class="ltx_Math" alttext="3^{dn}" display="inline" intent=":literal"><semantics><msup><mn>3</mn><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow></msup><annotation encoding="application/x-tex">3^{dn}</annotation></semantics></math> shifted versions of <math id="S2.SS2.p4.m11" class="ltx_Math" alttext="\boldsymbol{\widetilde{T}}" display="inline" intent=":literal"><semantics><mover accent="true"><mi>𝑻</mi><mo>~</mo></mover><annotation encoding="application/x-tex">\boldsymbol{\widetilde{T}}</annotation></semantics></math> yields a new Transformer <math id="S2.SS2.p4.m12" class="ltx_Math" alttext="\boldsymbol{T}^{(prl)}" display="inline" intent=":literal"><semantics><msup><mi>𝑻</mi><mrow><mo stretchy="false">(</mo><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>l</mi></mrow><mo stretchy="false">)</mo></mrow></msup><annotation encoding="application/x-tex">\boldsymbol{T}^{(prl)}</annotation></semantics></math>. Then, by composing <math id="S2.SS2.p4.m13" class="ltx_Math" alttext="\boldsymbol{T}^{(prl)}" display="inline" intent=":literal"><semantics><msup><mi>𝑻</mi><mrow><mo stretchy="false">(</mo><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>l</mi></mrow><mo stretchy="false">)</mo></mrow></msup><annotation encoding="application/x-tex">\boldsymbol{T}^{(prl)}</annotation></semantics></math> with <math id="S2.SS2.p4.m14" class="ltx_Math" alttext="dn" display="inline" intent=":literal"><semantics><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow><annotation encoding="application/x-tex">dn</annotation></semantics></math> feedforward layers (each consisting of several parallel <math id="S2.SS2.p4.m15" class="ltx_Math" alttext="\boldsymbol{\mathcal{F}}_{FF}^{(mid)}" display="inline" intent=":literal"><semantics><msubsup><mi class="ltx_font_mathcaligraphic">𝓕</mi><mrow><mi>F</mi><mo lspace="0em" rspace="0em">​</mo><mi>F</mi></mrow><mrow><mo stretchy="false">(</mo><mrow><mi>m</mi><mo lspace="0em" rspace="0em">​</mo><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>d</mi></mrow><mo stretchy="false">)</mo></mrow></msubsup><annotation encoding="application/x-tex">\boldsymbol{\mathcal{F}}_{FF}^{(mid)}</annotation></semantics></math> modules), we obtain the desired Transformer <math id="S2.SS2.p4.m16" class="ltx_Math" alttext="\boldsymbol{T}" display="inline" intent=":literal"><semantics><mi>𝑻</mi><annotation encoding="application/x-tex">\boldsymbol{T}</annotation></semantics></math>.</span></p>
</div>
<div id="S2.SS2.p5" class="ltx_para">
<p id="S2.SS2.p5.1" class="ltx_p"><span id="S2.SS2.p5.1.1" class="ltx_text">Note that
<math id="S2.SS2.p5.m1" class="ltx_Math" alttext="\omega_{f_{pq}}(\delta)\lesssim\delta^{\lambda}" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>ω</mi><msub><mi>f</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>δ</mi><mo stretchy="false">)</mo></mrow></mrow><mo>≲</mo><msup><mi>δ</mi><mi>λ</mi></msup></mrow><annotation encoding="application/x-tex">\omega_{f_{pq}}(\delta)\lesssim\delta^{\lambda}</annotation></semantics></math>. Setting <math id="S2.SS2.p5.m2" class="ltx_Math" alttext="\delta\asymp{\epsilon^{1/\lambda}}" display="inline" intent=":literal"><semantics><mrow><mi>δ</mi><mo>≍</mo><msup><mi>ϵ</mi><mrow><mn>1</mn><mo>/</mo><mi>λ</mi></mrow></msup></mrow><annotation encoding="application/x-tex">\delta\asymp{\epsilon^{1/\lambda}}</annotation></semantics></math> and applying Proposition <a href="#Thmproposition1" title="Proposition 1. ‣ 2.1 Proof of Theorem ‣ 2 Proofs of Main Results ‣ Standard Transformers Achieve the Minimax Rate in Nonparametric Regression with 𝐶^{𝑠,𝜆} Targets" class="ltx_ref"><span class="ltx_text ltx_ref_tag">1</span></a>, Lemma <a href="#Thmlemma1" title="Lemma 1 ([], Lemma 3.1). ‣ 2.2 Proof of Theorem ‣ 2 Proofs of Main Results ‣ Standard Transformers Achieve the Minimax Rate in Nonparametric Regression with 𝐶^{𝑠,𝜆} Targets" class="ltx_ref"><span class="ltx_text ltx_ref_tag">1</span></a>, Lemma <a href="#Thmlemma2" title="Lemma 2 ([], Lemma 3.4). ‣ 2.2 Proof of Theorem ‣ 2 Proofs of Main Results ‣ Standard Transformers Achieve the Minimax Rate in Nonparametric Regression with 𝐶^{𝑠,𝜆} Targets" class="ltx_ref"><span class="ltx_text ltx_ref_tag">2</span></a> and Lemma <a href="#Thmlemma3" title="Lemma 3. ‣ 2.2 Proof of Theorem ‣ 2 Proofs of Main Results ‣ Standard Transformers Achieve the Minimax Rate in Nonparametric Regression with 𝐶^{𝑠,𝜆} Targets" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3</span></a>, we achieve the result.</span></p>
</div>
<div id="S2.SS2.p6" class="ltx_para">
<p id="S2.SS2.p6.1" class="ltx_p"><span id="S2.SS2.p6.1.1" class="ltx_text">∎</span></p>
</div>
</div>
</section>
<section id="S2.SS3" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">2.3 </span>Proof of Theorem <a href="#Thmtheorem3" title="Theorem 3. ‣ 1.2 Main Results ‣ 1 Introduction ‣ Standard Transformers Achieve the Minimax Rate in Nonparametric Regression with 𝐶^{𝑠,𝜆} Targets" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3</span></a></h3>

<div id="S2.SS3.p1" class="ltx_para">
<p id="S2.SS3.p1.1" class="ltx_p">Based on classical empirical process theory, we can derive an upper bound of the excess risk in terms of the covering number of the function class. The proof of Proposition <a href="#Thmproposition2" title="Proposition 2. ‣ 2.3 Proof of Theorem ‣ 2 Proofs of Main Results ‣ Standard Transformers Achieve the Minimax Rate in Nonparametric Regression with 𝐶^{𝑠,𝜆} Targets" class="ltx_ref"><span class="ltx_text ltx_ref_tag">2</span></a> is deferred to Section <a href="#S6" title="6 Proof of Proposition ‣ Standard Transformers Achieve the Minimax Rate in Nonparametric Regression with 𝐶^{𝑠,𝜆} Targets" class="ltx_ref"><span class="ltx_text ltx_ref_tag">6</span></a>.</p>
</div>
<div id="Thmdefinition1" class="ltx_theorem ltx_theorem_definition">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="Thmdefinition1.2" class="ltx_text ltx_font_bold">Definition 1</span></span><span id="Thmdefinition1.3" class="ltx_text ltx_font_bold"> </span>(covering number)<span id="Thmdefinition1.4" class="ltx_text ltx_font_bold">.</span></h6>
<div id="Thmdefinition1.p1" class="ltx_para">
<p id="Thmdefinition1.p1.1" class="ltx_p"><span id="Thmdefinition1.p1.1.1" class="ltx_text ltx_font_italic">Let <math id="Thmdefinition1.p1.m1" class="ltx_Math" alttext="T" display="inline" intent=":literal"><semantics><mi>T</mi><annotation encoding="application/x-tex">T</annotation></semantics></math> be a set in a metric space <math id="Thmdefinition1.p1.m2" class="ltx_Math" alttext="(\bar{T},\tau)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mover accent="true"><mi>T</mi><mo>¯</mo></mover><mo>,</mo><mi>τ</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(\bar{T},\tau)</annotation></semantics></math>. An <math id="Thmdefinition1.p1.m3" class="ltx_Math" alttext="\epsilon" display="inline" intent=":literal"><semantics><mi>ϵ</mi><annotation encoding="application/x-tex">\epsilon</annotation></semantics></math>-cover of <math id="Thmdefinition1.p1.m4" class="ltx_Math" alttext="T" display="inline" intent=":literal"><semantics><mi>T</mi><annotation encoding="application/x-tex">T</annotation></semantics></math> is a subset <math id="Thmdefinition1.p1.m5" class="ltx_Math" alttext="T_{c}\subset\bar{T}" display="inline" intent=":literal"><semantics><mrow><msub><mi>T</mi><mi>c</mi></msub><mo>⊂</mo><mover accent="true"><mi>T</mi><mo>¯</mo></mover></mrow><annotation encoding="application/x-tex">T_{c}\subset\bar{T}</annotation></semantics></math> such that for each <math id="Thmdefinition1.p1.m6" class="ltx_Math" alttext="t\in T" display="inline" intent=":literal"><semantics><mrow><mi>t</mi><mo>∈</mo><mi>T</mi></mrow><annotation encoding="application/x-tex">t\in T</annotation></semantics></math>, there exists a <math id="Thmdefinition1.p1.m7" class="ltx_Math" alttext="t_{c}\in T_{c}" display="inline" intent=":literal"><semantics><mrow><msub><mi>t</mi><mi>c</mi></msub><mo>∈</mo><msub><mi>T</mi><mi>c</mi></msub></mrow><annotation encoding="application/x-tex">t_{c}\in T_{c}</annotation></semantics></math> such that <math id="Thmdefinition1.p1.m8" class="ltx_Math" alttext="\tau(t,t_{c})\leq\epsilon" display="inline" intent=":literal"><semantics><mrow><mrow><mi>τ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo>,</mo><msub><mi>t</mi><mi>c</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>≤</mo><mi>ϵ</mi></mrow><annotation encoding="application/x-tex">\tau(t,t_{c})\leq\epsilon</annotation></semantics></math>. The <math id="Thmdefinition1.p1.m9" class="ltx_Math" alttext="\epsilon" display="inline" intent=":literal"><semantics><mi>ϵ</mi><annotation encoding="application/x-tex">\epsilon</annotation></semantics></math>-covering number of <math id="Thmdefinition1.p1.m10" class="ltx_Math" alttext="T" display="inline" intent=":literal"><semantics><mi>T</mi><annotation encoding="application/x-tex">T</annotation></semantics></math>, denoted as <math id="Thmdefinition1.p1.m11" class="ltx_Math" alttext="\mathcal{N}(\epsilon,T,\tau)" display="inline" intent=":literal"><semantics><mrow><mi class="ltx_font_mathcaligraphic">𝒩</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>ϵ</mi><mo>,</mo><mi>T</mi><mo>,</mo><mi>τ</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathcal{N}(\epsilon,T,\tau)</annotation></semantics></math> is defined to be the minimum cardinality among all <math id="Thmdefinition1.p1.m12" class="ltx_Math" alttext="\epsilon" display="inline" intent=":literal"><semantics><mi>ϵ</mi><annotation encoding="application/x-tex">\epsilon</annotation></semantics></math>-cover of <math id="Thmdefinition1.p1.m13" class="ltx_Math" alttext="T" display="inline" intent=":literal"><semantics><mi>T</mi><annotation encoding="application/x-tex">T</annotation></semantics></math> with respect to the metric <math id="Thmdefinition1.p1.m14" class="ltx_Math" alttext="\tau" display="inline" intent=":literal"><semantics><mi>τ</mi><annotation encoding="application/x-tex">\tau</annotation></semantics></math>.</span></p>
</div>
</div>
<div id="Thmproposition2" class="ltx_theorem ltx_theorem_proposition">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="Thmproposition2.2" class="ltx_text ltx_font_bold">Proposition 2</span></span><span id="Thmproposition2.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="Thmproposition2.p1" class="ltx_para">
<p id="Thmproposition2.p1.1" class="ltx_p"><span id="Thmproposition2.p1.1.1" class="ltx_text ltx_font_italic">Let <math id="Thmproposition2.p1.m1" class="ltx_Math" alttext="B_{\mathcal{F}}\in\mathbb{R}_{&gt;0}" display="inline" intent=":literal"><semantics><mrow><msub><mi>B</mi><mi class="ltx_font_mathcaligraphic">ℱ</mi></msub><mo>∈</mo><msub><mi>ℝ</mi><mrow><mphantom></mphantom><mo>&gt;</mo><mn>0</mn></mrow></msub></mrow><annotation encoding="application/x-tex">B_{\mathcal{F}}\in\mathbb{R}_{&gt;0}</annotation></semantics></math>. Let <math id="Thmproposition2.p1.m2" class="ltx_Math" alttext="\mathcal{F}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">ℱ</mi><annotation encoding="application/x-tex">\mathcal{F}</annotation></semantics></math> be any given function class in <math id="Thmproposition2.p1.m3" class="ltx_Math" alttext="\mathbb{R}^{d}" display="inline" intent=":literal"><semantics><msup><mi>ℝ</mi><mi>d</mi></msup><annotation encoding="application/x-tex">\mathbb{R}^{d}</annotation></semantics></math> such that <math id="Thmproposition2.p1.m4" class="ltx_Math" alttext="|f|\leq B_{\mathcal{F}}" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">|</mo><mi>f</mi><mo stretchy="false">|</mo></mrow><mo>≤</mo><msub><mi>B</mi><mi class="ltx_font_mathcaligraphic">ℱ</mi></msub></mrow><annotation encoding="application/x-tex">|f|\leq B_{\mathcal{F}}</annotation></semantics></math> for all <math id="Thmproposition2.p1.m5" class="ltx_Math" alttext="f\in\mathcal{F}" display="inline" intent=":literal"><semantics><mrow><mi>f</mi><mo>∈</mo><mi class="ltx_font_mathcaligraphic">ℱ</mi></mrow><annotation encoding="application/x-tex">f\in\mathcal{F}</annotation></semantics></math>. There holds</span></p>
<table id="S2.EGx43" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="S2.Ex72"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S2.Ex72.m1" class="ltx_Math" alttext="\displaystyle\left\|\widehat{f}-f_{0}\right\|_{L^{2}(\mu)}^{2}" display="inline" intent=":literal"><semantics><msubsup><mrow><mo>‖</mo><mrow><mover accent="true"><mi>f</mi><mo>^</mo></mover><mo>−</mo><msub><mi>f</mi><mn>0</mn></msub></mrow><mo>‖</mo></mrow><mrow><msup><mi>L</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>μ</mi><mo stretchy="false">)</mo></mrow></mrow><mn>2</mn></msubsup><annotation encoding="application/x-tex">\displaystyle\left\|\widehat{f}-f_{0}\right\|_{L^{2}(\mu)}^{2}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="S2.Ex73"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S2.Ex73.m1" class="ltx_math_unparsed" alttext="\displaystyle\leq\left(\frac{896B_{\mathcal{F}}^{2}}{3}+2^{17}\sigma^{2}+20\right)m^{-2\gamma/(2\gamma+d)}+\frac{896B_{\mathcal{F}}^{2}\log\mathcal{N}(m^{-\gamma/(2\gamma+d)},\mathcal{F},\|\cdot\|_{L^{\infty}(\mu)})}{3m}" display="inline" intent=":literal"><semantics><mrow><mo>≤</mo><mrow><mo>(</mo><mstyle displaystyle="true"><mfrac><mrow><mn>896</mn><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>B</mi><mi class="ltx_font_mathcaligraphic">ℱ</mi><mn>2</mn></msubsup></mrow><mn>3</mn></mfrac></mstyle><mo>+</mo><msup><mn>2</mn><mn>17</mn></msup><msup><mi>σ</mi><mn>2</mn></msup><mo>+</mo><mn>20</mn><mo>)</mo></mrow><msup><mi>m</mi><mrow><mo>−</mo><mn>2</mn><mi>γ</mi><mo>/</mo><mo stretchy="false">(</mo><mn>2</mn><mi>γ</mi><mo>+</mo><mi>d</mi><mo stretchy="false">)</mo></mrow></msup><mo>+</mo><mstyle displaystyle="true"><mfrac><mrow><mn>896</mn><mi>B</mi><msub><mrow></mrow><mi class="ltx_font_mathcaligraphic">ℱ</mi></msub><msup><mrow></mrow><mn>2</mn></msup><mi>log</mi><mi class="ltx_font_mathcaligraphic">𝒩</mi><mo stretchy="false">(</mo><mi>m</mi><msup><mrow></mrow><mrow><mo>−</mo><mi>γ</mi><mo>/</mo><mo stretchy="false">(</mo><mn>2</mn><mi>γ</mi><mo>+</mo><mi>d</mi><mo stretchy="false">)</mo></mrow></msup><mo>,</mo><mi class="ltx_font_mathcaligraphic">ℱ</mi><mo>,</mo><mo lspace="0em" rspace="0em">∥</mo><mo lspace="0em" rspace="0em">⋅</mo><mo lspace="0em" rspace="0.167em">∥</mo><msub><mrow></mrow><mrow><msup><mi>L</mi><mi mathvariant="normal">∞</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>μ</mi><mo stretchy="false">)</mo></mrow></mrow></msub><mo stretchy="false">)</mo></mrow><mrow><mn>3</mn><mo lspace="0em" rspace="0em">​</mo><mi>m</mi></mrow></mfrac></mstyle></mrow><annotation encoding="application/x-tex">\displaystyle\leq\left(\frac{896B_{\mathcal{F}}^{2}}{3}+2^{17}\sigma^{2}+20\right)m^{-2\gamma/(2\gamma+d)}+\frac{896B_{\mathcal{F}}^{2}\log\mathcal{N}(m^{-\gamma/(2\gamma+d)},\mathcal{F},\|\cdot\|_{L^{\infty}(\mu)})}{3m}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="S2.Ex74"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S2.Ex74.m1" class="ltx_math_unparsed" alttext="\displaystyle\quad+146\|f^{*}-f_{0}\|_{L^{\infty}(\mu)}^{2}+\frac{2^{10}\sigma}{m^{(\gamma+d)/(2\gamma+d)}}\left(\int_{0}^{2^{7}\sigma m^{-\gamma/(2\gamma+d)}}\sqrt{\log 2\mathcal{N}(\varsigma,\mathcal{F},\|\cdot\|_{L^{\infty}(\mu)})^{2}}\,d\varsigma\right)^{2}" display="inline" intent=":literal"><semantics><mrow><mo>+</mo><mn>146</mn><mo lspace="0em" rspace="0.167em">∥</mo><msup><mi>f</mi><mo>∗</mo></msup><mo>−</mo><msub><mi>f</mi><mn>0</mn></msub><msubsup><mo lspace="0em" rspace="0em">∥</mo><mrow><msup><mi>L</mi><mi mathvariant="normal">∞</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>μ</mi><mo stretchy="false">)</mo></mrow></mrow><mn>2</mn></msubsup><mo lspace="0em">+</mo><mstyle displaystyle="true"><mfrac><mrow><msup><mn>2</mn><mn>10</mn></msup><mo lspace="0em" rspace="0em">​</mo><mi>σ</mi></mrow><msup><mi>m</mi><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>γ</mi><mo>+</mo><mi>d</mi></mrow><mo stretchy="false">)</mo></mrow><mo>/</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>γ</mi></mrow><mo>+</mo><mi>d</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></msup></mfrac></mstyle><msup><mrow><mo>(</mo><mstyle displaystyle="true"><msubsup><mo>∫</mo><mn>0</mn><mrow><mn>2</mn><msup><mrow></mrow><mn>7</mn></msup><mi>σ</mi><mi>m</mi><msup><mrow></mrow><mrow><mo>−</mo><mi>γ</mi><mo>/</mo><mo stretchy="false">(</mo><mn>2</mn><mi>γ</mi><mo>+</mo><mi>d</mi><mo stretchy="false">)</mo></mrow></msup></mrow></msubsup></mstyle><msqrt><mrow><mi>log</mi><mn>2</mn><mi class="ltx_font_mathcaligraphic">𝒩</mi><mo stretchy="false">(</mo><mi>ς</mi><mo>,</mo><mi class="ltx_font_mathcaligraphic">ℱ</mi><mo>,</mo><mo lspace="0em" rspace="0em">∥</mo><mo lspace="0em" rspace="0em">⋅</mo><mo lspace="0em" rspace="0.167em">∥</mo><msub><mrow></mrow><mrow><msup><mi>L</mi><mi mathvariant="normal">∞</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>μ</mi><mo stretchy="false">)</mo></mrow></mrow></msub><mo stretchy="false">)</mo><msup><mrow></mrow><mn>2</mn></msup></mrow></msqrt><mi>d</mi><mi>ς</mi><mo>)</mo></mrow><mn>2</mn></msup></mrow><annotation encoding="application/x-tex">\displaystyle\quad+146\|f^{*}-f_{0}\|_{L^{\infty}(\mu)}^{2}+\frac{2^{10}\sigma}{m^{(\gamma+d)/(2\gamma+d)}}\left(\int_{0}^{2^{7}\sigma m^{-\gamma/(2\gamma+d)}}\sqrt{\log 2\mathcal{N}(\varsigma,\mathcal{F},\|\cdot\|_{L^{\infty}(\mu)})^{2}}\,d\varsigma\right)^{2}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="Thmproposition2.p1.2" class="ltx_p"><span id="Thmproposition2.p1.2.1" class="ltx_text ltx_font_italic">with probability at least <math id="Thmproposition2.p1.m6" class="ltx_Math" alttext="1-2\exp\left(-m^{d/(2s+d)}\right)" display="inline" intent=":literal"><semantics><mrow><mn>1</mn><mo>−</mo><mrow><mn>2</mn><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mo>−</mo><msup><mi>m</mi><mrow><mi>d</mi><mo>/</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>s</mi></mrow><mo>+</mo><mi>d</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></msup></mrow><mo>)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">1-2\exp\left(-m^{d/(2s+d)}\right)</annotation></semantics></math>, where <math id="Thmproposition2.p1.m7" class="ltx_Math" alttext="f^{*}" display="inline" intent=":literal"><semantics><msup><mi>f</mi><mo>∗</mo></msup><annotation encoding="application/x-tex">f^{*}</annotation></semantics></math> can be any function in <math id="Thmproposition2.p1.m8" class="ltx_Math" alttext="\mathcal{F}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">ℱ</mi><annotation encoding="application/x-tex">\mathcal{F}</annotation></semantics></math>.</span></p>
</div>
</div>
<div id="S2.SS3.p2" class="ltx_para">
<p id="S2.SS3.p2.1" class="ltx_p">It remains to upper-bound the covering number of Transformer class, which is done in Lemma <a href="#Thmlemma4" title="Lemma 4. ‣ 2.3 Proof of Theorem ‣ 2 Proofs of Main Results ‣ Standard Transformers Achieve the Minimax Rate in Nonparametric Regression with 𝐶^{𝑠,𝜆} Targets" class="ltx_ref"><span class="ltx_text ltx_ref_tag">4</span></a> with proof deferred to Section <a href="#S7" title="7 Proof of Lemma : Estimation of Lipschitz Constant ‣ Standard Transformers Achieve the Minimax Rate in Nonparametric Regression with 𝐶^{𝑠,𝜆} Targets" class="ltx_ref"><span class="ltx_text ltx_ref_tag">7</span></a>.</p>
</div>
<div id="Thmlemma4" class="ltx_theorem ltx_theorem_lemma">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="Thmlemma4.2" class="ltx_text ltx_font_bold">Lemma 4</span></span><span id="Thmlemma4.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="Thmlemma4.p1" class="ltx_para">
<p id="Thmlemma4.p1.1" class="ltx_p"><span id="Thmlemma4.p1.1.1" class="ltx_text ltx_font_italic">For <math id="Thmlemma4.p1.m1" class="ltx_Math" alttext="\mathcal{F}_{\mathcal{T}}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">ℱ</mi><mi class="ltx_font_mathcaligraphic">𝒯</mi></msub><annotation encoding="application/x-tex">\mathcal{F}_{\mathcal{T}}</annotation></semantics></math> defined in (<a href="#S1.E2" title="In 1.2 Main Results ‣ 1 Introduction ‣ Standard Transformers Achieve the Minimax Rate in Nonparametric Regression with 𝐶^{𝑠,𝜆} Targets" class="ltx_ref"><span class="ltx_text ltx_ref_tag">2</span></a>), there holds</span></p>
<table id="S2.EGx44" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="S2.Ex75"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S2.Ex75.m1" class="ltx_math_unparsed" alttext="\displaystyle\mathcal{N}(\varsigma,\mathcal{F}_{\mathcal{T}},\|\cdot\|_{L^{\infty}(\mu)})\leq\left(\frac{2B_{EB}\mathfrak{L}}{\varsigma}\right)^{M_{EB}}\left(\frac{2B_{FF}\mathfrak{L}}{\varsigma}\right)^{M_{FF}}\left(\frac{2B_{SA}\mathfrak{L}}{\varsigma}\right)^{M_{SA}},\quad\forall\varsigma&gt;0," display="inline" intent=":literal"><semantics><mrow><mi class="ltx_font_mathcaligraphic">𝒩</mi><mrow><mo stretchy="false">(</mo><mi>ς</mi><mo>,</mo><msub><mi class="ltx_font_mathcaligraphic">ℱ</mi><mi class="ltx_font_mathcaligraphic">𝒯</mi></msub><mo>,</mo><mo lspace="0em" rspace="0em">∥</mo><mo lspace="0em" rspace="0em">⋅</mo><msub><mo lspace="0em" rspace="0.167em">∥</mo><mrow><msup><mi>L</mi><mi mathvariant="normal">∞</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>μ</mi><mo stretchy="false">)</mo></mrow></mrow></msub><mo stretchy="false">)</mo></mrow><mo>≤</mo><msup><mrow><mo>(</mo><mstyle displaystyle="true"><mfrac><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>B</mi><mrow><mi>E</mi><mo lspace="0em" rspace="0em">​</mo><mi>B</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mi>𝔏</mi></mrow><mi>ς</mi></mfrac></mstyle><mo>)</mo></mrow><msub><mi>M</mi><mrow><mi>E</mi><mo lspace="0em" rspace="0em">​</mo><mi>B</mi></mrow></msub></msup><msup><mrow><mo>(</mo><mstyle displaystyle="true"><mfrac><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>B</mi><mrow><mi>F</mi><mo lspace="0em" rspace="0em">​</mo><mi>F</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mi>𝔏</mi></mrow><mi>ς</mi></mfrac></mstyle><mo>)</mo></mrow><msub><mi>M</mi><mrow><mi>F</mi><mo lspace="0em" rspace="0em">​</mo><mi>F</mi></mrow></msub></msup><msup><mrow><mo>(</mo><mstyle displaystyle="true"><mfrac><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>B</mi><mrow><mi>S</mi><mo lspace="0em" rspace="0em">​</mo><mi>A</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mi>𝔏</mi></mrow><mi>ς</mi></mfrac></mstyle><mo>)</mo></mrow><msub><mi>M</mi><mrow><mi>S</mi><mo lspace="0em" rspace="0em">​</mo><mi>A</mi></mrow></msub></msup><mo rspace="1.167em">,</mo><mo rspace="0.167em">∀</mo><mi>ς</mi><mo>&gt;</mo><mn>0</mn><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\mathcal{N}(\varsigma,\mathcal{F}_{\mathcal{T}},\|\cdot\|_{L^{\infty}(\mu)})\leq\left(\frac{2B_{EB}\mathfrak{L}}{\varsigma}\right)^{M_{EB}}\left(\frac{2B_{FF}\mathfrak{L}}{\varsigma}\right)^{M_{FF}}\left(\frac{2B_{SA}\mathfrak{L}}{\varsigma}\right)^{M_{SA}},\quad\forall\varsigma&gt;0,</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="Thmlemma4.p1.2" class="ltx_p"><span id="Thmlemma4.p1.2.1" class="ltx_text ltx_font_italic">where</span></p>
<table id="S2.EGx45" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="S2.Ex76"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S2.Ex76.m1" class="ltx_Math" alttext="\displaystyle\mathfrak{L}=" display="inline" intent=":literal"><semantics><mrow><mi>𝔏</mi><mo>=</mo><mphantom></mphantom></mrow><annotation encoding="application/x-tex">\displaystyle\mathfrak{L}=</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S2.Ex76.m2" class="ltx_Math" alttext="\displaystyle(2K+2)6^{K}4^{K^{2}+K+4}n^{K^{2}+5K/2+3}d_{in}^{K+1/2}d_{0}^{2K+1}\left(\prod_{k^{\prime}=1}^{K}d_{k^{\prime}}^{4(K-k^{\prime})+6}\right)d_{out}^{1/2}" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">(</mo><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>K</mi></mrow><mo>+</mo><mn>2</mn></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mn>6</mn><mi>K</mi></msup><mo lspace="0em" rspace="0em">​</mo><msup><mn>4</mn><mrow><msup><mi>K</mi><mn>2</mn></msup><mo>+</mo><mi>K</mi><mo>+</mo><mn>4</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>n</mi><mrow><msup><mi>K</mi><mn>2</mn></msup><mo>+</mo><mrow><mrow><mn>5</mn><mo lspace="0em" rspace="0em">​</mo><mi>K</mi></mrow><mo>/</mo><mn>2</mn></mrow><mo>+</mo><mn>3</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>d</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow><mrow><mi>K</mi><mo>+</mo><mrow><mn>1</mn><mo>/</mo><mn>2</mn></mrow></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>d</mi><mn>0</mn><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>K</mi></mrow><mo>+</mo><mn>1</mn></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∏</mo><mrow><msup><mi>k</mi><mo>′</mo></msup><mo>=</mo><mn>1</mn></mrow><mi>K</mi></munderover></mstyle><msubsup><mi>d</mi><msup><mi>k</mi><mo>′</mo></msup><mrow><mrow><mn>4</mn><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>K</mi><mo>−</mo><msup><mi>k</mi><mo>′</mo></msup></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mn>6</mn></mrow></msubsup></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>d</mi><mrow><mi>o</mi><mo lspace="0em" rspace="0em">​</mo><mi>u</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow><mrow><mn>1</mn><mo>/</mo><mn>2</mn></mrow></msubsup></mrow><annotation encoding="application/x-tex">\displaystyle(2K+2)6^{K}4^{K^{2}+K+4}n^{K^{2}+5K/2+3}d_{in}^{K+1/2}d_{0}^{2K+1}\left(\prod_{k^{\prime}=1}^{K}d_{k^{\prime}}^{4(K-k^{\prime})+6}\right)d_{out}^{1/2}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="S2.E3"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S2.E3.m1" class="ltx_Math" alttext="\displaystyle H^{K^{2}+K-1}S^{K^{2}+2K+1}L^{K^{2}+2K+3}W^{(L-1)(K^{2}+3K+3)}B_{EB}^{2K+1}B_{FF}^{L(K^{2}+3K+3)}B_{SA}^{2(K^{2}+2K+1)}." display="inline" intent=":literal"><semantics><mrow><mrow><msup><mi>H</mi><mrow><mrow><msup><mi>K</mi><mn>2</mn></msup><mo>+</mo><mi>K</mi></mrow><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>S</mi><mrow><msup><mi>K</mi><mn>2</mn></msup><mo>+</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>K</mi></mrow><mo>+</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>L</mi><mrow><msup><mi>K</mi><mn>2</mn></msup><mo>+</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>K</mi></mrow><mo>+</mo><mn>3</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>W</mi><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>L</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mi>K</mi><mn>2</mn></msup><mo>+</mo><mrow><mn>3</mn><mo lspace="0em" rspace="0em">​</mo><mi>K</mi></mrow><mo>+</mo><mn>3</mn></mrow><mo stretchy="false">)</mo></mrow></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>B</mi><mrow><mi>E</mi><mo lspace="0em" rspace="0em">​</mo><mi>B</mi></mrow><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>K</mi></mrow><mo>+</mo><mn>1</mn></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>B</mi><mrow><mi>F</mi><mo lspace="0em" rspace="0em">​</mo><mi>F</mi></mrow><mrow><mi>L</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mi>K</mi><mn>2</mn></msup><mo>+</mo><mrow><mn>3</mn><mo lspace="0em" rspace="0em">​</mo><mi>K</mi></mrow><mo>+</mo><mn>3</mn></mrow><mo stretchy="false">)</mo></mrow></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>B</mi><mrow><mi>S</mi><mo lspace="0em" rspace="0em">​</mo><mi>A</mi></mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mi>K</mi><mn>2</mn></msup><mo>+</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>K</mi></mrow><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow></msubsup></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle H^{K^{2}+K-1}S^{K^{2}+2K+1}L^{K^{2}+2K+3}W^{(L-1)(K^{2}+3K+3)}B_{EB}^{2K+1}B_{FF}^{L(K^{2}+3K+3)}B_{SA}^{2(K^{2}+2K+1)}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(3)</span></td></tr></tbody>
</table>
</div>
</div>
<div id="S2.SS3.p3" class="ltx_para">
<p id="S2.SS3.p3.1" class="ltx_p">We also need the Lipschitz continuity of the truncation function.</p>
</div>
<div id="Thmlemma5" class="ltx_theorem ltx_theorem_lemma">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="Thmlemma5.2" class="ltx_text ltx_font_bold">Lemma 5</span></span><span id="Thmlemma5.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="Thmlemma5.p1" class="ltx_para">
<p id="Thmlemma5.p1.1" class="ltx_p"><span id="Thmlemma5.p1.1.1" class="ltx_text ltx_font_italic">Let <math id="Thmlemma5.p1.m1" class="ltx_Math" alttext="B\in\mathbb{R}_{&gt;0}" display="inline" intent=":literal"><semantics><mrow><mi>B</mi><mo>∈</mo><msub><mi>ℝ</mi><mrow><mphantom></mphantom><mo>&gt;</mo><mn>0</mn></mrow></msub></mrow><annotation encoding="application/x-tex">B\in\mathbb{R}_{&gt;0}</annotation></semantics></math>. Let <math id="Thmlemma5.p1.m2" class="ltx_Math" alttext="U" display="inline" intent=":literal"><semantics><mi>U</mi><annotation encoding="application/x-tex">U</annotation></semantics></math> be a set. For any two functions <math id="Thmlemma5.p1.m3" class="ltx_Math" alttext="f_{1},f_{2}:U\to\mathbb{R}" display="inline" intent=":literal"><semantics><mrow><msub><mi>f</mi><mn>1</mn></msub><mo>,</mo><mrow><msub><mi>f</mi><mn>2</mn></msub><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi>U</mi><mo stretchy="false">→</mo><mi>ℝ</mi></mrow></mrow></mrow><annotation encoding="application/x-tex">f_{1},f_{2}:U\to\mathbb{R}</annotation></semantics></math>,</span></p>
<table id="S2.EGx46" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="S2.Ex77"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S2.Ex77.m1" class="ltx_Math" alttext="\displaystyle|f_{tr,B}\circ f_{1}(x)-f_{tr,B}\circ f_{2}(x)|\leq|f_{1}(x)-f_{2}(x)|,\quad x\in U." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mrow><mo stretchy="false">|</mo><mrow><mrow><mrow><msub><mi>f</mi><mrow><mrow><mi>t</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi></mrow><mo>,</mo><mi>B</mi></mrow></msub><mo lspace="0.222em" rspace="0.222em">∘</mo><msub><mi>f</mi><mn>1</mn></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mrow><msub><mi>f</mi><mrow><mrow><mi>t</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi></mrow><mo>,</mo><mi>B</mi></mrow></msub><mo lspace="0.222em" rspace="0.222em">∘</mo><msub><mi>f</mi><mn>2</mn></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">|</mo></mrow><mo>≤</mo><mrow><mo stretchy="false">|</mo><mrow><mrow><msub><mi>f</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msub><mi>f</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">|</mo></mrow></mrow><mo rspace="1.167em">,</mo><mrow><mi>x</mi><mo>∈</mo><mi>U</mi></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle|f_{tr,B}\circ f_{1}(x)-f_{tr,B}\circ f_{2}(x)|\leq|f_{1}(x)-f_{2}(x)|,\quad x\in U.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
</div>
<div id="S2.SS3.2" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="S2.SS3.p4" class="ltx_para">
<p id="S2.SS3.p4.1" class="ltx_p"><span id="S2.SS3.p4.1.1" class="ltx_text">For <math id="S2.SS3.p4.m1" class="ltx_Math" alttext="x" display="inline" intent=":literal"><semantics><mi>x</mi><annotation encoding="application/x-tex">x</annotation></semantics></math> such that <math id="S2.SS3.p4.m2" class="ltx_Math" alttext="|f_{1}(x)|,|f_{2}(x)|\leq B" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">|</mo><mrow><msub><mi>f</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">|</mo></mrow><mo>,</mo><mrow><mrow><mo stretchy="false">|</mo><mrow><msub><mi>f</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">|</mo></mrow><mo>≤</mo><mi>B</mi></mrow></mrow><annotation encoding="application/x-tex">|f_{1}(x)|,|f_{2}(x)|\leq B</annotation></semantics></math>, the conclusion is trivial. For <math id="S2.SS3.p4.m3" class="ltx_Math" alttext="x" display="inline" intent=":literal"><semantics><mi>x</mi><annotation encoding="application/x-tex">x</annotation></semantics></math> such that <math id="S2.SS3.p4.m4" class="ltx_Math" alttext="|f_{1}(x)|,|f_{2}(x)|&gt;B" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">|</mo><mrow><msub><mi>f</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">|</mo></mrow><mo>,</mo><mrow><mrow><mo stretchy="false">|</mo><mrow><msub><mi>f</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">|</mo></mrow><mo>&gt;</mo><mi>B</mi></mrow></mrow><annotation encoding="application/x-tex">|f_{1}(x)|,|f_{2}(x)|&gt;B</annotation></semantics></math>, <math id="S2.SS3.p4.m5" class="ltx_Math" alttext="f_{tr,B}\circ f_{1}(x)=f_{tr,B}\circ f_{2}(x)=0" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><msub><mi>f</mi><mrow><mrow><mi>t</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi></mrow><mo>,</mo><mi>B</mi></mrow></msub><mo lspace="0.222em" rspace="0.222em">∘</mo><msub><mi>f</mi><mn>1</mn></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mrow><msub><mi>f</mi><mrow><mrow><mi>t</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi></mrow><mo>,</mo><mi>B</mi></mrow></msub><mo lspace="0.222em" rspace="0.222em">∘</mo><msub><mi>f</mi><mn>2</mn></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">f_{tr,B}\circ f_{1}(x)=f_{tr,B}\circ f_{2}(x)=0</annotation></semantics></math>. For <math id="S2.SS3.p4.m6" class="ltx_Math" alttext="x" display="inline" intent=":literal"><semantics><mi>x</mi><annotation encoding="application/x-tex">x</annotation></semantics></math> such that <math id="S2.SS3.p4.m7" class="ltx_Math" alttext="|f_{1}(x)|&gt;B,|f_{2}(x)|\leq B" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mo stretchy="false">|</mo><mrow><msub><mi>f</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">|</mo></mrow><mo>&gt;</mo><mi>B</mi></mrow><mo>,</mo><mrow><mrow><mo stretchy="false">|</mo><mrow><msub><mi>f</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">|</mo></mrow><mo>≤</mo><mi>B</mi></mrow></mrow><annotation encoding="application/x-tex">|f_{1}(x)|&gt;B,|f_{2}(x)|\leq B</annotation></semantics></math>, without loss of generality we assume <math id="S2.SS3.p4.m8" class="ltx_Math" alttext="f_{1}(x)&gt;B" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>f</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo>&gt;</mo><mi>B</mi></mrow><annotation encoding="application/x-tex">f_{1}(x)&gt;B</annotation></semantics></math>, then</span></p>
<table id="S2.EGx47" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="S2.Ex78"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S2.Ex78.m1" class="ltx_Math" alttext="\displaystyle 0&lt;f_{tr,B}\circ f_{1}(x)-f_{tr,B}\circ f_{2}(x)=B-f_{2}(x)&lt;f_{1}(x)-f_{2}(x)." display="inline" intent=":literal"><semantics><mrow><mrow><mn>0</mn><mo>&lt;</mo><mrow><mrow><mrow><msub><mi>f</mi><mrow><mrow><mi>t</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi></mrow><mo>,</mo><mi>B</mi></mrow></msub><mo lspace="0.222em" rspace="0.222em">∘</mo><msub><mi>f</mi><mn>1</mn></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mrow><msub><mi>f</mi><mrow><mrow><mi>t</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi></mrow><mo>,</mo><mi>B</mi></mrow></msub><mo lspace="0.222em" rspace="0.222em">∘</mo><msub><mi>f</mi><mn>2</mn></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>=</mo><mrow><mi>B</mi><mo>−</mo><mrow><msub><mi>f</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>&lt;</mo><mrow><mrow><msub><mi>f</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msub><mi>f</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle 0&lt;f_{tr,B}\circ f_{1}(x)-f_{tr,B}\circ f_{2}(x)=B-f_{2}(x)&lt;f_{1}(x)-f_{2}(x).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S2.SS3.p4.2" class="ltx_p"><span id="S2.SS3.p4.2.1" class="ltx_text">For <math id="S2.SS3.p4.m9" class="ltx_Math" alttext="x" display="inline" intent=":literal"><semantics><mi>x</mi><annotation encoding="application/x-tex">x</annotation></semantics></math> such that <math id="S2.SS3.p4.m10" class="ltx_Math" alttext="f_{1}(x)\leq B,f_{2}(x)&gt;B" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><msub><mi>f</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo>≤</mo><mi>B</mi></mrow><mo>,</mo><mrow><mrow><msub><mi>f</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo>&gt;</mo><mi>B</mi></mrow></mrow><annotation encoding="application/x-tex">f_{1}(x)\leq B,f_{2}(x)&gt;B</annotation></semantics></math>, the conclusion can be proved similarly.</span></p>
</div>
<div id="S2.SS3.p5" class="ltx_para">
<p id="S2.SS3.p5.1" class="ltx_p"><span id="S2.SS3.p5.1.1" class="ltx_text">∎</span></p>
</div>
</div>
<div id="S2.SS3.3" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof of Theorem <a href="#Thmtheorem3" title="Theorem 3. ‣ 1.2 Main Results ‣ 1 Introduction ‣ Standard Transformers Achieve the Minimax Rate in Nonparametric Regression with 𝐶^{𝑠,𝜆} Targets" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3</span></a>.</h6>
<div id="S2.SS3.p6" class="ltx_para">
<p id="S2.SS3.p6.1" class="ltx_p"><span id="S2.SS3.p6.1.1" class="ltx_text">By Theorem <a href="#Thmtheorem2" title="Theorem 2. ‣ 1.2 Main Results ‣ 1 Introduction ‣ Standard Transformers Achieve the Minimax Rate in Nonparametric Regression with 𝐶^{𝑠,𝜆} Targets" class="ltx_ref"><span class="ltx_text ltx_ref_tag">2</span></a>, for a given <math id="S2.SS3.p6.m1" class="ltx_Math" alttext="0&lt;\epsilon&lt;1" display="inline" intent=":literal"><semantics><mrow><mn>0</mn><mo>&lt;</mo><mi>ϵ</mi><mo>&lt;</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">0&lt;\epsilon&lt;1</annotation></semantics></math>, there exists <math id="S2.SS3.p6.m2" class="ltx_Math" alttext="f:\mathbb{R}^{d\times n}\to\mathbb{R}" display="inline" intent=":literal"><semantics><mrow><mi>f</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><msup><mi>ℝ</mi><mrow><mi>d</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>n</mi></mrow></msup><mo stretchy="false">→</mo><mi>ℝ</mi></mrow></mrow><annotation encoding="application/x-tex">f:\mathbb{R}^{d\times n}\to\mathbb{R}</annotation></semantics></math>, which lies in</span></p>
<table id="S2.EGx48" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="S2.Ex79"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S2.Ex79.m1" class="ltx_Math" alttext="\displaystyle\mathcal{F}_{\mathcal{T}}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">ℱ</mi><mi class="ltx_font_mathcaligraphic">𝒯</mi></msub><annotation encoding="application/x-tex">\displaystyle\mathcal{F}_{\mathcal{T}}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S2.Ex79.m2" class="ltx_math_unparsed" alttext="\displaystyle\left(K=n,L=\mathcal{O}\left(\log\frac{1}{\epsilon}\right),W=\mathcal{O}\left(\epsilon^{-dn/\gamma}\right),H=\mathcal{O}(1),S=\mathcal{O}(1),\right." display="inline" intent=":literal"><semantics><mrow><mo>(</mo><mi>K</mi><mo>=</mo><mi>n</mi><mo>,</mo><mi>L</mi><mo>=</mo><mi class="ltx_font_mathcaligraphic">𝒪</mi><mrow><mo>(</mo><mi>log</mi><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>ϵ</mi></mfrac></mstyle><mo>)</mo></mrow><mo>,</mo><mi>W</mi><mo>=</mo><mi class="ltx_font_mathcaligraphic">𝒪</mi><mrow><mo>(</mo><msup><mi>ϵ</mi><mrow><mo>−</mo><mi>d</mi><mi>n</mi><mo>/</mo><mi>γ</mi></mrow></msup><mo>)</mo></mrow><mo>,</mo><mi>H</mi><mo>=</mo><mi class="ltx_font_mathcaligraphic">𝒪</mi><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow><mo>,</mo><mi>S</mi><mo>=</mo><mi class="ltx_font_mathcaligraphic">𝒪</mi><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\left(K=n,L=\mathcal{O}\left(\log\frac{1}{\epsilon}\right),W=\mathcal{O}\left(\epsilon^{-dn/\gamma}\right),H=\mathcal{O}(1),S=\mathcal{O}(1),\right.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="S2.Ex80"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S2.Ex80.m1" class="ltx_math_unparsed" alttext="\displaystyle\quad\left.M_{EB}=\mathcal{O}\left(1\right),M_{FF}=\mathcal{O}\left(\epsilon^{-dn/\gamma}\right),M_{SA}=\mathcal{O}\left(1\right),\right." display="inline" intent=":literal"><semantics><mrow><msub><mi>M</mi><mrow><mi>E</mi><mo lspace="0em" rspace="0em">​</mo><mi>B</mi></mrow></msub><mo>=</mo><mi class="ltx_font_mathcaligraphic">𝒪</mi><mrow><mo>(</mo><mn>1</mn><mo>)</mo></mrow><mo>,</mo><msub><mi>M</mi><mrow><mi>F</mi><mo lspace="0em" rspace="0em">​</mo><mi>F</mi></mrow></msub><mo>=</mo><mi class="ltx_font_mathcaligraphic">𝒪</mi><mrow><mo>(</mo><msup><mi>ϵ</mi><mrow><mo>−</mo><mi>d</mi><mi>n</mi><mo>/</mo><mi>γ</mi></mrow></msup><mo>)</mo></mrow><mo>,</mo><msub><mi>M</mi><mrow><mi>S</mi><mo lspace="0em" rspace="0em">​</mo><mi>A</mi></mrow></msub><mo>=</mo><mi class="ltx_font_mathcaligraphic">𝒪</mi><mrow><mo>(</mo><mn>1</mn><mo>)</mo></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\quad\left.M_{EB}=\mathcal{O}\left(1\right),M_{FF}=\mathcal{O}\left(\epsilon^{-dn/\gamma}\right),M_{SA}=\mathcal{O}\left(1\right),\right.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="S2.E4"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S2.E4.m1" class="ltx_Math" alttext="\displaystyle\quad\left.B_{EB}=\mathcal{O}\left(1\right),B_{FF}=\mathcal{O}\left(\epsilon^{-\max\{(6dn+2)/\gamma,1/\lambda\}}\right),B_{SA}=\mathcal{O}\left(\log\frac{1}{\epsilon}\right),\boldsymbol{d}\right)" display="inline" intent=":literal"><semantics><mrow><mo fence="true" rspace="1.000em">OPEN</mo><mrow><mrow><msub><mi>B</mi><mrow><mi>E</mi><mo lspace="0em" rspace="0em">​</mo><mi>B</mi></mrow></msub><mo>=</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒪</mi><mo>⁡</mo><mrow><mo>(</mo><mn>1</mn><mo>)</mo></mrow></mrow></mrow><mo>,</mo><mrow><msub><mi>B</mi><mrow><mi>F</mi><mo lspace="0em" rspace="0em">​</mo><mi>F</mi></mrow></msub><mo>=</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒪</mi><mo>⁡</mo><mrow><mo>(</mo><msup><mi>ϵ</mi><mrow><mo rspace="0.167em">−</mo><mrow><mi>max</mi><mo>⁡</mo><mrow><mo stretchy="false">{</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mrow><mn>6</mn><mo lspace="0em" rspace="0em">​</mo><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow><mo>+</mo><mn>2</mn></mrow><mo stretchy="false">)</mo></mrow><mo>/</mo><mi>γ</mi></mrow><mo>,</mo><mrow><mn>1</mn><mo>/</mo><mi>λ</mi></mrow><mo stretchy="false">}</mo></mrow></mrow></mrow></msup><mo>)</mo></mrow></mrow></mrow><mo>,</mo><mrow><msub><mi>B</mi><mrow><mi>S</mi><mo lspace="0em" rspace="0em">​</mo><mi>A</mi></mrow></msub><mo>=</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒪</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>ϵ</mi></mfrac></mstyle></mrow><mo>)</mo></mrow></mrow></mrow><mo>,</mo><mi>𝒅</mi></mrow><mo>)</mo></mrow><annotation encoding="application/x-tex">\displaystyle\quad\left.B_{EB}=\mathcal{O}\left(1\right),B_{FF}=\mathcal{O}\left(\epsilon^{-\max\{(6dn+2)/\gamma,1/\lambda\}}\right),B_{SA}=\mathcal{O}\left(\log\frac{1}{\epsilon}\right),\boldsymbol{d}\right)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(4)</span></td></tr></tbody>
</table>
<p id="S2.SS3.p6.2" class="ltx_p"><span id="S2.SS3.p6.2.1" class="ltx_text">with</span></p>
<table id="S2.EGx49" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="S2.Ex81"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S2.Ex81.m1" class="ltx_Math" alttext="\displaystyle\boldsymbol{d}=\begin{pmatrix}d&amp;d+n+1+3^{n}&amp;(2dn+5d)3^{dn}C_{s+dn-1}^{dn-1}\cdot\boldsymbol{1}_{1\times n}&amp;d\end{pmatrix}," display="inline" intent=":literal"><semantics><mrow><mrow><mi>𝒅</mi><mo>=</mo><mrow><mo>(</mo><mtable columnspacing="5pt"><mtr><mtd><mi>d</mi></mtd><mtd><mrow><mi>d</mi><mo>+</mo><mi>n</mi><mo>+</mo><mn>1</mn><mo>+</mo><msup><mn>3</mn><mi>n</mi></msup></mrow></mtd><mtd><mrow><mrow><mrow><mo stretchy="false">(</mo><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow><mo>+</mo><mrow><mn>5</mn><mo lspace="0em" rspace="0em">​</mo><mi>d</mi></mrow></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mn>3</mn><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>C</mi><mrow><mrow><mi>s</mi><mo>+</mo><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow></mrow><mo>−</mo><mn>1</mn></mrow><mrow><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow><mo>−</mo><mn>1</mn></mrow></msubsup></mrow><mo lspace="0.222em" rspace="0.222em">⋅</mo><msub><mn>𝟏</mn><mrow><mn>1</mn><mo lspace="0.222em" rspace="0.222em">×</mo><mi>n</mi></mrow></msub></mrow></mtd><mtd><mi>d</mi></mtd></mtr></mtable><mo>)</mo></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\boldsymbol{d}=\begin{pmatrix}d&amp;d+n+1+3^{n}&amp;(2dn+5d)3^{dn}C_{s+dn-1}^{dn-1}\cdot\boldsymbol{1}_{1\times n}&amp;d\end{pmatrix},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S2.SS3.p6.3" class="ltx_p"><span id="S2.SS3.p6.3.1" class="ltx_text">such that</span></p>
<table id="S2.EGx50" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="S2.Ex82"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S2.Ex82.m1" class="ltx_Math" alttext="\displaystyle\left\|f-f_{0}\right\|_{L^{\infty}([0,1]^{d\times n})}\leq\epsilon." display="inline" intent=":literal"><semantics><mrow><mrow><msub><mrow><mo>‖</mo><mrow><mi>f</mi><mo>−</mo><msub><mi>f</mi><mn>0</mn></msub></mrow><mo>‖</mo></mrow><mrow><msup><mi>L</mi><mi mathvariant="normal">∞</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mrow><mo stretchy="false">[</mo><mrow><mn>0</mn><mo>,</mo><mn>1</mn></mrow><mo stretchy="false">]</mo></mrow><mrow><mi>d</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>n</mi></mrow></msup><mo stretchy="false">)</mo></mrow></mrow></msub><mo>≤</mo><mi>ϵ</mi></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\left\|f-f_{0}\right\|_{L^{\infty}([0,1]^{d\times n})}\leq\epsilon.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S2.SS3.p6.4" class="ltx_p"><span id="S2.SS3.p6.4.1" class="ltx_text">It follows from Lemma <a href="#Thmlemma5" title="Lemma 5. ‣ 2.3 Proof of Theorem ‣ 2 Proofs of Main Results ‣ Standard Transformers Achieve the Minimax Rate in Nonparametric Regression with 𝐶^{𝑠,𝜆} Targets" class="ltx_ref"><span class="ltx_text ltx_ref_tag">5</span></a> that</span></p>
<table id="S2.EGx51" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="S2.E5"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S2.E5.m1" class="ltx_Math" alttext="\displaystyle\left\|f_{tr,B_{Y}}\circ f-f_{0}\right\|_{L^{\infty}([0,1]^{d\times n})}\leq\epsilon." display="inline" intent=":literal"><semantics><mrow><mrow><msub><mrow><mo>‖</mo><mrow><mrow><msub><mi>f</mi><mrow><mrow><mi>t</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi></mrow><mo>,</mo><msub><mi>B</mi><mi>Y</mi></msub></mrow></msub><mo lspace="0.222em" rspace="0.222em">∘</mo><mi>f</mi></mrow><mo>−</mo><msub><mi>f</mi><mn>0</mn></msub></mrow><mo>‖</mo></mrow><mrow><msup><mi>L</mi><mi mathvariant="normal">∞</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mrow><mo stretchy="false">[</mo><mrow><mn>0</mn><mo>,</mo><mn>1</mn></mrow><mo stretchy="false">]</mo></mrow><mrow><mi>d</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>n</mi></mrow></msup><mo stretchy="false">)</mo></mrow></mrow></msub><mo>≤</mo><mi>ϵ</mi></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\left\|f_{tr,B_{Y}}\circ f-f_{0}\right\|_{L^{\infty}([0,1]^{d\times n})}\leq\epsilon.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(5)</span></td></tr></tbody>
</table>
<p id="S2.SS3.p6.5" class="ltx_p"><span id="S2.SS3.p6.5.1" class="ltx_text">By Lemma <a href="#Thmlemma4" title="Lemma 4. ‣ 2.3 Proof of Theorem ‣ 2 Proofs of Main Results ‣ Standard Transformers Achieve the Minimax Rate in Nonparametric Regression with 𝐶^{𝑠,𝜆} Targets" class="ltx_ref"><span class="ltx_text ltx_ref_tag">4</span></a> and some calculations, the entropy of the function class (<a href="#S2.E4" title="In Proof of Theorem . ‣ 2.3 Proof of Theorem ‣ 2 Proofs of Main Results ‣ Standard Transformers Achieve the Minimax Rate in Nonparametric Regression with 𝐶^{𝑠,𝜆} Targets" class="ltx_ref"><span class="ltx_text ltx_ref_tag">4</span></a>) can be bounded as</span></p>
</div>
<div id="S2.SS3.p7" class="ltx_para">
<table id="S2.EGx52" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="S2.Ex83"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S2.Ex83.m1" class="ltx_math_unparsed" alttext="\displaystyle\log\mathcal{N}(\varsigma,\mathcal{F}_{\mathcal{T}},\|\cdot\|_{L^{\infty}(\mu)})" display="inline" intent=":literal"><semantics><mrow><mi>log</mi><mi class="ltx_font_mathcaligraphic">𝒩</mi><mrow><mo stretchy="false">(</mo><mi>ς</mi><mo>,</mo><msub><mi class="ltx_font_mathcaligraphic">ℱ</mi><mi class="ltx_font_mathcaligraphic">𝒯</mi></msub><mo>,</mo><mo lspace="0em" rspace="0em">∥</mo><mo lspace="0em" rspace="0em">⋅</mo><msub><mo lspace="0em" rspace="0.167em">∥</mo><mrow><msup><mi>L</mi><mi mathvariant="normal">∞</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>μ</mi><mo stretchy="false">)</mo></mrow></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\log\mathcal{N}(\varsigma,\mathcal{F}_{\mathcal{T}},\|\cdot\|_{L^{\infty}(\mu)})</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S2.Ex83.m2" class="ltx_math_unparsed" alttext="\displaystyle\lesssim\epsilon^{-dn/\gamma}\left(\log\frac{1}{\epsilon}\right)^{2}+\epsilon^{-dn/\gamma}\log\frac{1}{\varsigma},\quad\forall\varsigma&gt;0." display="inline" intent=":literal"><semantics><mrow><mo>≲</mo><msup><mi>ϵ</mi><mrow><mo>−</mo><mi>d</mi><mi>n</mi><mo>/</mo><mi>γ</mi></mrow></msup><msup><mrow><mo>(</mo><mi>log</mi><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>ϵ</mi></mfrac></mstyle><mo>)</mo></mrow><mn>2</mn></msup><mo>+</mo><msup><mi>ϵ</mi><mrow><mo>−</mo><mi>d</mi><mi>n</mi><mo>/</mo><mi>γ</mi></mrow></msup><mi>log</mi><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>ς</mi></mfrac></mstyle><mo rspace="1.167em">,</mo><mo rspace="0.167em">∀</mo><mi>ς</mi><mo>&gt;</mo><mn>0</mn><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\lesssim\epsilon^{-dn/\gamma}\left(\log\frac{1}{\epsilon}\right)^{2}+\epsilon^{-dn/\gamma}\log\frac{1}{\varsigma},\quad\forall\varsigma&gt;0.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S2.SS3.p7.1" class="ltx_p"><span id="S2.SS3.p7.1.1" class="ltx_text">Truncation does not increase entropy:</span></p>
<table id="S2.EGx53" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="S2.Ex84"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S2.Ex84.m1" class="ltx_math_unparsed" alttext="\displaystyle\log\mathcal{N}(\varsigma,f_{tr,B_{Y}}\circ\mathcal{F}_{\mathcal{T}},\|\cdot\|_{L^{\infty}(\mu)})" display="inline" intent=":literal"><semantics><mrow><mi>log</mi><mi class="ltx_font_mathcaligraphic">𝒩</mi><mrow><mo stretchy="false">(</mo><mi>ς</mi><mo>,</mo><msub><mi>f</mi><mrow><mrow><mi>t</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi></mrow><mo>,</mo><msub><mi>B</mi><mi>Y</mi></msub></mrow></msub><mo lspace="0.222em" rspace="0.222em">∘</mo><msub><mi class="ltx_font_mathcaligraphic">ℱ</mi><mi class="ltx_font_mathcaligraphic">𝒯</mi></msub><mo>,</mo><mo lspace="0em" rspace="0em">∥</mo><mo lspace="0em" rspace="0em">⋅</mo><msub><mo lspace="0em" rspace="0.167em">∥</mo><mrow><msup><mi>L</mi><mi mathvariant="normal">∞</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>μ</mi><mo stretchy="false">)</mo></mrow></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\log\mathcal{N}(\varsigma,f_{tr,B_{Y}}\circ\mathcal{F}_{\mathcal{T}},\|\cdot\|_{L^{\infty}(\mu)})</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S2.Ex84.m2" class="ltx_math_unparsed" alttext="\displaystyle\leq\log\mathcal{N}(\varsigma,\mathcal{F}_{\mathcal{T}},\|\cdot\|_{L^{\infty}(\mu)})" display="inline" intent=":literal"><semantics><mrow><mo>≤</mo><mi>log</mi><mi class="ltx_font_mathcaligraphic">𝒩</mi><mrow><mo stretchy="false">(</mo><mi>ς</mi><mo>,</mo><msub><mi class="ltx_font_mathcaligraphic">ℱ</mi><mi class="ltx_font_mathcaligraphic">𝒯</mi></msub><mo>,</mo><mo lspace="0em" rspace="0em">∥</mo><mo lspace="0em" rspace="0em">⋅</mo><msub><mo lspace="0em" rspace="0.167em">∥</mo><mrow><msup><mi>L</mi><mi mathvariant="normal">∞</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>μ</mi><mo stretchy="false">)</mo></mrow></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\leq\log\mathcal{N}(\varsigma,\mathcal{F}_{\mathcal{T}},\|\cdot\|_{L^{\infty}(\mu)})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="S2.E6"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S2.E6.m1" class="ltx_math_unparsed" alttext="\displaystyle\lesssim\epsilon^{-dn/\gamma}\left(\log\frac{1}{\epsilon}\right)^{2}+\epsilon^{-dn/\gamma}\log\frac{1}{\varsigma}." display="inline" intent=":literal"><semantics><mrow><mo>≲</mo><msup><mi>ϵ</mi><mrow><mo>−</mo><mi>d</mi><mi>n</mi><mo>/</mo><mi>γ</mi></mrow></msup><msup><mrow><mo>(</mo><mi>log</mi><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>ϵ</mi></mfrac></mstyle><mo>)</mo></mrow><mn>2</mn></msup><mo>+</mo><msup><mi>ϵ</mi><mrow><mo>−</mo><mi>d</mi><mi>n</mi><mo>/</mo><mi>γ</mi></mrow></msup><mi>log</mi><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>ς</mi></mfrac></mstyle><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\lesssim\epsilon^{-dn/\gamma}\left(\log\frac{1}{\epsilon}\right)^{2}+\epsilon^{-dn/\gamma}\log\frac{1}{\varsigma}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(6)</span></td></tr></tbody>
</table>
<p id="S2.SS3.p7.2" class="ltx_p"><span id="S2.SS3.p7.2.1" class="ltx_text">We can then apply Proposition <a href="#Thmproposition2" title="Proposition 2. ‣ 2.3 Proof of Theorem ‣ 2 Proofs of Main Results ‣ Standard Transformers Achieve the Minimax Rate in Nonparametric Regression with 𝐶^{𝑠,𝜆} Targets" class="ltx_ref"><span class="ltx_text ltx_ref_tag">2</span></a> with <math id="S2.SS3.p7.m1" class="ltx_Math" alttext="f^{*}=f_{tr,B_{Y}}\circ f" display="inline" intent=":literal"><semantics><mrow><msup><mi>f</mi><mo>∗</mo></msup><mo>=</mo><mrow><msub><mi>f</mi><mrow><mrow><mi>t</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi></mrow><mo>,</mo><msub><mi>B</mi><mi>Y</mi></msub></mrow></msub><mo lspace="0.222em" rspace="0.222em">∘</mo><mi>f</mi></mrow></mrow><annotation encoding="application/x-tex">f^{*}=f_{tr,B_{Y}}\circ f</annotation></semantics></math> to derive an upper bound for <math id="S2.SS3.p7.m2" class="ltx_Math" alttext="\left\|\widehat{f}-f_{0}\right\|_{L^{2}(\mu)}" display="inline" intent=":literal"><semantics><msub><mrow><mo>‖</mo><mrow><mover accent="true"><mi>f</mi><mo>^</mo></mover><mo>−</mo><msub><mi>f</mi><mn>0</mn></msub></mrow><mo>‖</mo></mrow><mrow><msup><mi>L</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>μ</mi><mo stretchy="false">)</mo></mrow></mrow></msub><annotation encoding="application/x-tex">\left\|\widehat{f}-f_{0}\right\|_{L^{2}(\mu)}</annotation></semantics></math>. To this end, we need to evaluate the integral in Proposition <a href="#Thmproposition2" title="Proposition 2. ‣ 2.3 Proof of Theorem ‣ 2 Proofs of Main Results ‣ Standard Transformers Achieve the Minimax Rate in Nonparametric Regression with 𝐶^{𝑠,𝜆} Targets" class="ltx_ref"><span class="ltx_text ltx_ref_tag">2</span></a>:</span></p>
<table id="S2.EGx54" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="S2.Ex85"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S2.Ex85.m1" class="ltx_math_unparsed" alttext="\displaystyle\left(\int_{0}^{2^{7}\sigma m^{-\gamma/(2\gamma+dn)}}\sqrt{\log 2\mathcal{N}(\varsigma,f_{tr,B_{Y}}\circ\mathcal{F}_{\mathcal{T}},\|\cdot\|_{L^{\infty}(\mu)})^{2}}\,d\varsigma\right)^{2}" display="inline" intent=":literal"><semantics><msup><mrow><mo>(</mo><mstyle displaystyle="true"><msubsup><mo>∫</mo><mn>0</mn><mrow><mn>2</mn><msup><mrow></mrow><mn>7</mn></msup><mi>σ</mi><mi>m</mi><msup><mrow></mrow><mrow><mo>−</mo><mi>γ</mi><mo>/</mo><mo stretchy="false">(</mo><mn>2</mn><mi>γ</mi><mo>+</mo><mi>d</mi><mi>n</mi><mo stretchy="false">)</mo></mrow></msup></mrow></msubsup></mstyle><msqrt><mrow><mi>log</mi><mn>2</mn><mi class="ltx_font_mathcaligraphic">𝒩</mi><mo stretchy="false">(</mo><mi>ς</mi><mo>,</mo><mi>f</mi><msub><mrow></mrow><mrow><mrow><mi>t</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi></mrow><mo>,</mo><msub><mi>B</mi><mi>Y</mi></msub></mrow></msub><mo lspace="0.222em" rspace="0.222em">∘</mo><mi class="ltx_font_mathcaligraphic">ℱ</mi><msub><mrow></mrow><mi class="ltx_font_mathcaligraphic">𝒯</mi></msub><mo>,</mo><mo lspace="0em" rspace="0em">∥</mo><mo lspace="0em" rspace="0em">⋅</mo><mo lspace="0em" rspace="0.167em">∥</mo><msub><mrow></mrow><mrow><msup><mi>L</mi><mi mathvariant="normal">∞</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>μ</mi><mo stretchy="false">)</mo></mrow></mrow></msub><mo stretchy="false">)</mo><msup><mrow></mrow><mn>2</mn></msup></mrow></msqrt><mi>d</mi><mi>ς</mi><mo>)</mo></mrow><mn>2</mn></msup><annotation encoding="application/x-tex">\displaystyle\left(\int_{0}^{2^{7}\sigma m^{-\gamma/(2\gamma+dn)}}\sqrt{\log 2\mathcal{N}(\varsigma,f_{tr,B_{Y}}\circ\mathcal{F}_{\mathcal{T}},\|\cdot\|_{L^{\infty}(\mu)})^{2}}\,d\varsigma\right)^{2}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="S2.Ex86"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S2.Ex86.m1" class="ltx_math_unparsed" alttext="\displaystyle\leq 2^{7}\sigma m^{-\gamma/(2\gamma+dn)}\int_{0}^{2^{7}\sigma m^{-\gamma/(2\gamma+dn)}}\log 2\mathcal{N}(\varsigma,f_{tr,B_{Y}}\circ\mathcal{F}_{\mathcal{T}},\|\cdot\|_{L^{\infty}(\mu)})^{2}\,d\varsigma" display="inline" intent=":literal"><semantics><mrow><mo>≤</mo><msup><mn>2</mn><mn>7</mn></msup><mi>σ</mi><msup><mi>m</mi><mrow><mo>−</mo><mi>γ</mi><mo>/</mo><mo stretchy="false">(</mo><mn>2</mn><mi>γ</mi><mo>+</mo><mi>d</mi><mi>n</mi><mo stretchy="false">)</mo></mrow></msup><mstyle displaystyle="true"><msubsup><mo>∫</mo><mn>0</mn><mrow><mn>2</mn><msup><mrow></mrow><mn>7</mn></msup><mi>σ</mi><mi>m</mi><msup><mrow></mrow><mrow><mo>−</mo><mi>γ</mi><mo>/</mo><mo stretchy="false">(</mo><mn>2</mn><mi>γ</mi><mo>+</mo><mi>d</mi><mi>n</mi><mo stretchy="false">)</mo></mrow></msup></mrow></msubsup></mstyle><mi>log</mi><mn>2</mn><mi class="ltx_font_mathcaligraphic">𝒩</mi><msup><mrow><mo stretchy="false">(</mo><mi>ς</mi><mo>,</mo><msub><mi>f</mi><mrow><mrow><mi>t</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi></mrow><mo>,</mo><msub><mi>B</mi><mi>Y</mi></msub></mrow></msub><mo lspace="0.222em" rspace="0.222em">∘</mo><msub><mi class="ltx_font_mathcaligraphic">ℱ</mi><mi class="ltx_font_mathcaligraphic">𝒯</mi></msub><mo>,</mo><mo lspace="0em" rspace="0em">∥</mo><mo lspace="0em" rspace="0em">⋅</mo><msub><mo lspace="0em" rspace="0.167em">∥</mo><mrow><msup><mi>L</mi><mi mathvariant="normal">∞</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>μ</mi><mo stretchy="false">)</mo></mrow></mrow></msub><mo stretchy="false">)</mo></mrow><mn>2</mn></msup><mi>d</mi><mi>ς</mi></mrow><annotation encoding="application/x-tex">\displaystyle\leq 2^{7}\sigma m^{-\gamma/(2\gamma+dn)}\int_{0}^{2^{7}\sigma m^{-\gamma/(2\gamma+dn)}}\log 2\mathcal{N}(\varsigma,f_{tr,B_{Y}}\circ\mathcal{F}_{\mathcal{T}},\|\cdot\|_{L^{\infty}(\mu)})^{2}\,d\varsigma</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="S2.Ex87"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S2.Ex87.m1" class="ltx_math_unparsed" alttext="\displaystyle\lesssim m^{-\gamma/(2\gamma+dn)}\int_{0}^{2^{7}\sigma m^{-\gamma/(2\gamma+dn)}}\left(\epsilon^{-dn/\gamma}\left(\log\frac{1}{\epsilon}\right)^{2}+\epsilon^{-dn/\gamma}\log\frac{1}{\varsigma}\right)\,d\varsigma" display="inline" intent=":literal"><semantics><mrow><mo>≲</mo><msup><mi>m</mi><mrow><mo>−</mo><mi>γ</mi><mo>/</mo><mo stretchy="false">(</mo><mn>2</mn><mi>γ</mi><mo>+</mo><mi>d</mi><mi>n</mi><mo stretchy="false">)</mo></mrow></msup><mstyle displaystyle="true"><msubsup><mo>∫</mo><mn>0</mn><mrow><mn>2</mn><msup><mrow></mrow><mn>7</mn></msup><mi>σ</mi><mi>m</mi><msup><mrow></mrow><mrow><mo>−</mo><mi>γ</mi><mo>/</mo><mo stretchy="false">(</mo><mn>2</mn><mi>γ</mi><mo>+</mo><mi>d</mi><mi>n</mi><mo stretchy="false">)</mo></mrow></msup></mrow></msubsup></mstyle><mrow><mo>(</mo><msup><mi>ϵ</mi><mrow><mo>−</mo><mi>d</mi><mi>n</mi><mo>/</mo><mi>γ</mi></mrow></msup><msup><mrow><mo>(</mo><mi>log</mi><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>ϵ</mi></mfrac></mstyle><mo>)</mo></mrow><mn>2</mn></msup><mo>+</mo><msup><mi>ϵ</mi><mrow><mo>−</mo><mi>d</mi><mi>n</mi><mo>/</mo><mi>γ</mi></mrow></msup><mi>log</mi><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>ς</mi></mfrac></mstyle><mo rspace="0.170em">)</mo></mrow><mi>d</mi><mi>ς</mi></mrow><annotation encoding="application/x-tex">\displaystyle\lesssim m^{-\gamma/(2\gamma+dn)}\int_{0}^{2^{7}\sigma m^{-\gamma/(2\gamma+dn)}}\left(\epsilon^{-dn/\gamma}\left(\log\frac{1}{\epsilon}\right)^{2}+\epsilon^{-dn/\gamma}\log\frac{1}{\varsigma}\right)\,d\varsigma</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="S2.E7"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S2.E7.m1" class="ltx_math_unparsed" alttext="\displaystyle\lesssim m^{-2\gamma/(2\gamma+dn)}\epsilon^{-dn/\gamma}\left(\left(\log\frac{1}{\epsilon}\right)^{2}+\log m\right)." display="inline" intent=":literal"><semantics><mrow><mo>≲</mo><msup><mi>m</mi><mrow><mo>−</mo><mn>2</mn><mi>γ</mi><mo>/</mo><mo stretchy="false">(</mo><mn>2</mn><mi>γ</mi><mo>+</mo><mi>d</mi><mi>n</mi><mo stretchy="false">)</mo></mrow></msup><msup><mi>ϵ</mi><mrow><mo>−</mo><mi>d</mi><mi>n</mi><mo>/</mo><mi>γ</mi></mrow></msup><mrow><mo>(</mo><msup><mrow><mo>(</mo><mi>log</mi><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>ϵ</mi></mfrac></mstyle><mo>)</mo></mrow><mn>2</mn></msup><mo>+</mo><mi>log</mi><mi>m</mi><mo>)</mo></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\lesssim m^{-2\gamma/(2\gamma+dn)}\epsilon^{-dn/\gamma}\left(\left(\log\frac{1}{\epsilon}\right)^{2}+\log m\right).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(7)</span></td></tr></tbody>
</table>
<p id="S2.SS3.p7.3" class="ltx_p"><span id="S2.SS3.p7.3.1" class="ltx_text">Here we use Hölder’s inequality. Now, combining Proposition <a href="#Thmproposition2" title="Proposition 2. ‣ 2.3 Proof of Theorem ‣ 2 Proofs of Main Results ‣ Standard Transformers Achieve the Minimax Rate in Nonparametric Regression with 𝐶^{𝑠,𝜆} Targets" class="ltx_ref"><span class="ltx_text ltx_ref_tag">2</span></a> and (<a href="#S2.E5" title="In Proof of Theorem . ‣ 2.3 Proof of Theorem ‣ 2 Proofs of Main Results ‣ Standard Transformers Achieve the Minimax Rate in Nonparametric Regression with 𝐶^{𝑠,𝜆} Targets" class="ltx_ref"><span class="ltx_text ltx_ref_tag">5</span></a>)-(<a href="#S2.E7" title="In Proof of Theorem . ‣ 2.3 Proof of Theorem ‣ 2 Proofs of Main Results ‣ Standard Transformers Achieve the Minimax Rate in Nonparametric Regression with 𝐶^{𝑠,𝜆} Targets" class="ltx_ref"><span class="ltx_text ltx_ref_tag">7</span></a>) yields</span></p>
</div>
<div id="S2.SS3.p8" class="ltx_para">
<table id="S2.EGx55" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="S2.Ex88"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S2.Ex88.m1" class="ltx_Math" alttext="\displaystyle\left\|\widehat{f}-f_{0}\right\|_{L^{2}(\mu)}^{2}" display="inline" intent=":literal"><semantics><msubsup><mrow><mo>‖</mo><mrow><mover accent="true"><mi>f</mi><mo>^</mo></mover><mo>−</mo><msub><mi>f</mi><mn>0</mn></msub></mrow><mo>‖</mo></mrow><mrow><msup><mi>L</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>μ</mi><mo stretchy="false">)</mo></mrow></mrow><mn>2</mn></msubsup><annotation encoding="application/x-tex">\displaystyle\left\|\widehat{f}-f_{0}\right\|_{L^{2}(\mu)}^{2}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S2.Ex88.m2" class="ltx_math_unparsed" alttext="\displaystyle\lesssim m^{-2\gamma/(2\gamma+dn)}+m^{-1}\epsilon^{-dn/\gamma}\left(\log\frac{1}{\epsilon}\right)^{2}+\epsilon^{-dn/\gamma}m^{-1}\log m" display="inline" intent=":literal"><semantics><mrow><mo>≲</mo><msup><mi>m</mi><mrow><mo>−</mo><mn>2</mn><mi>γ</mi><mo>/</mo><mo stretchy="false">(</mo><mn>2</mn><mi>γ</mi><mo>+</mo><mi>d</mi><mi>n</mi><mo stretchy="false">)</mo></mrow></msup><mo>+</mo><msup><mi>m</mi><mrow><mo>−</mo><mn>1</mn></mrow></msup><msup><mi>ϵ</mi><mrow><mo>−</mo><mi>d</mi><mi>n</mi><mo>/</mo><mi>γ</mi></mrow></msup><msup><mrow><mo>(</mo><mi>log</mi><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>ϵ</mi></mfrac></mstyle><mo>)</mo></mrow><mn>2</mn></msup><mo>+</mo><msup><mi>ϵ</mi><mrow><mo>−</mo><mi>d</mi><mi>n</mi><mo>/</mo><mi>γ</mi></mrow></msup><msup><mi>m</mi><mrow><mo>−</mo><mn>1</mn></mrow></msup><mi>log</mi><mi>m</mi></mrow><annotation encoding="application/x-tex">\displaystyle\lesssim m^{-2\gamma/(2\gamma+dn)}+m^{-1}\epsilon^{-dn/\gamma}\left(\log\frac{1}{\epsilon}\right)^{2}+\epsilon^{-dn/\gamma}m^{-1}\log m</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="S2.Ex89"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S2.Ex89.m1" class="ltx_math_unparsed" alttext="\displaystyle\quad+\epsilon^{2}+m^{-(3\gamma+dn)/(2\gamma+dn)}\epsilon^{-dn/\gamma}\left(\left(\log\frac{1}{\epsilon}\right)^{2}+\log m\right)" display="inline" intent=":literal"><semantics><mrow><mo>+</mo><msup><mi>ϵ</mi><mn>2</mn></msup><mo>+</mo><msup><mi>m</mi><mrow><mo>−</mo><mo stretchy="false">(</mo><mn>3</mn><mi>γ</mi><mo>+</mo><mi>d</mi><mi>n</mi><mo stretchy="false">)</mo><mo>/</mo><mo stretchy="false">(</mo><mn>2</mn><mi>γ</mi><mo>+</mo><mi>d</mi><mi>n</mi><mo stretchy="false">)</mo></mrow></msup><msup><mi>ϵ</mi><mrow><mo>−</mo><mi>d</mi><mi>n</mi><mo>/</mo><mi>γ</mi></mrow></msup><mrow><mo>(</mo><msup><mrow><mo>(</mo><mi>log</mi><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>ϵ</mi></mfrac></mstyle><mo>)</mo></mrow><mn>2</mn></msup><mo>+</mo><mi>log</mi><mi>m</mi><mo>)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\quad+\epsilon^{2}+m^{-(3\gamma+dn)/(2\gamma+dn)}\epsilon^{-dn/\gamma}\left(\left(\log\frac{1}{\epsilon}\right)^{2}+\log m\right)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S2.SS3.p8.1" class="ltx_p"><span id="S2.SS3.p8.1.1" class="ltx_text">with probability at least <math id="S2.SS3.p8.m1" class="ltx_Math" alttext="1-2\exp\left(-m^{dn/(2\gamma+dn)}\right)" display="inline" intent=":literal"><semantics><mrow><mn>1</mn><mo>−</mo><mrow><mn>2</mn><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mo>−</mo><msup><mi>m</mi><mrow><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow><mo>/</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>γ</mi></mrow><mo>+</mo><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></msup></mrow><mo>)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">1-2\exp\left(-m^{dn/(2\gamma+dn)}\right)</annotation></semantics></math>. We complete the proof by setting</span></p>
<table id="S2.EGx56" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="S2.Ex90"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S2.Ex90.m1" class="ltx_math_unparsed" alttext="\displaystyle\epsilon\asymp m^{-\gamma/(2\gamma+dn)}." display="inline" intent=":literal"><semantics><mrow><mi>ϵ</mi><mo>≍</mo><mi>m</mi><msup><mrow></mrow><mrow><mo>−</mo><mi>γ</mi><mo>/</mo><mo stretchy="false">(</mo><mn>2</mn><mi>γ</mi><mo>+</mo><mi>d</mi><mi>n</mi><mo stretchy="false">)</mo></mrow></msup><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\epsilon\asymp m^{-\gamma/(2\gamma+dn)}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="S2.SS3.p9" class="ltx_para">
<p id="S2.SS3.p9.1" class="ltx_p"><span id="S2.SS3.p9.1.1" class="ltx_text">∎</span></p>
</div>
</div>
</section>
</section>
<section id="S3" class="ltx_section">
<h2 class="ltx_title ltx_title_section"><span class="ltx_tag ltx_tag_section">3 </span>Proof of Proposition <a href="#Thmproposition1" title="Proposition 1. ‣ 2.1 Proof of Theorem ‣ 2 Proofs of Main Results ‣ Standard Transformers Achieve the Minimax Rate in Nonparametric Regression with 𝐶^{𝑠,𝜆} Targets" class="ltx_ref"><span class="ltx_text ltx_ref_tag">1</span></a>: Construction of Transformers</h2>

<div id="S3.p1" class="ltx_para">
<p id="S3.p1.1" class="ltx_p">In Section <a href="#S3.SS1" title="3.1 Proof of Proposition ‣ 3 Proof of Proposition : Construction of Transformers ‣ Standard Transformers Achieve the Minimax Rate in Nonparametric Regression with 𝐶^{𝑠,𝜆} Targets" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3.1</span></a>, we present the proof of Proposition <a href="#Thmproposition1" title="Proposition 1. ‣ 2.1 Proof of Theorem ‣ 2 Proofs of Main Results ‣ Standard Transformers Achieve the Minimax Rate in Nonparametric Regression with 𝐶^{𝑠,𝜆} Targets" class="ltx_ref"><span class="ltx_text ltx_ref_tag">1</span></a> along with the technical lemmas required during the proof. Sections <a href="#S3.SS2" title="3.2 Proof of Lemma ‣ 3 Proof of Proposition : Construction of Transformers ‣ Standard Transformers Achieve the Minimax Rate in Nonparametric Regression with 𝐶^{𝑠,𝜆} Targets" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3.2</span></a> and <a href="#S3.SS3" title="3.3 Proof of Lemma ‣ 3 Proof of Proposition : Construction of Transformers ‣ Standard Transformers Achieve the Minimax Rate in Nonparametric Regression with 𝐶^{𝑠,𝜆} Targets" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3.3</span></a> contain the proofs of the technical lemmas.</p>
</div>
<section id="S3.SS1" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">3.1 </span>Proof of Proposition <a href="#Thmproposition1" title="Proposition 1. ‣ 2.1 Proof of Theorem ‣ 2 Proofs of Main Results ‣ Standard Transformers Achieve the Minimax Rate in Nonparametric Regression with 𝐶^{𝑠,𝜆} Targets" class="ltx_ref"><span class="ltx_text ltx_ref_tag">1</span></a></h3>

<div id="S3.SS1.p1" class="ltx_para">
<p id="S3.SS1.p1.1" class="ltx_p">Inspired by the approximation of highly smooth functions using FNNs <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib57" title="" class="ltx_ref">57</a>, <a href="#bib.bib31" title="" class="ltx_ref">31</a>]</cite>, the basic idea of proving Proposition <a href="#Thmproposition1" title="Proposition 1. ‣ 2.1 Proof of Theorem ‣ 2 Proofs of Main Results ‣ Standard Transformers Achieve the Minimax Rate in Nonparametric Regression with 𝐶^{𝑠,𝜆} Targets" class="ltx_ref"><span class="ltx_text ltx_ref_tag">1</span></a> is to construct Transformers to achieve the approximation of Taylor polynomials. Consider the set <math id="S3.SS1.p1.m1" class="ltx_Math" alttext="\left\{\boldsymbol{\alpha}\in\mathbb{N}_{\geq 0}^{d\times n}:\sum_{u=1}^{d}\sum_{v=1}^{n}\alpha_{uv}\leq s\right\}" display="inline" intent=":literal"><semantics><mrow><mo>{</mo><mrow><mi>𝜶</mi><mo>∈</mo><msubsup><mi>ℕ</mi><mrow><mphantom></mphantom><mo>≥</mo><mn>0</mn></mrow><mrow><mi>d</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>n</mi></mrow></msubsup></mrow><mo lspace="0.278em" rspace="0.111em">:</mo><mrow><mrow><msubsup><mo rspace="0em">∑</mo><mrow><mi>u</mi><mo>=</mo><mn>1</mn></mrow><mi>d</mi></msubsup><mrow><msubsup><mo>∑</mo><mrow><mi>v</mi><mo>=</mo><mn>1</mn></mrow><mi>n</mi></msubsup><msub><mi>α</mi><mrow><mi>u</mi><mo lspace="0em" rspace="0em">​</mo><mi>v</mi></mrow></msub></mrow></mrow><mo>≤</mo><mi>s</mi></mrow><mo>}</mo></mrow><annotation encoding="application/x-tex">\left\{\boldsymbol{\alpha}\in\mathbb{N}_{\geq 0}^{d\times n}:\sum_{u=1}^{d}\sum_{v=1}^{n}\alpha_{uv}\leq s\right\}</annotation></semantics></math>. Given that its cardinality is <math id="S3.SS1.p1.m2" class="ltx_Math" alttext="C_{s+dn-1}^{dn-1}" display="inline" intent=":literal"><semantics><msubsup><mi>C</mi><mrow><mrow><mi>s</mi><mo>+</mo><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow></mrow><mo>−</mo><mn>1</mn></mrow><mrow><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow><mo>−</mo><mn>1</mn></mrow></msubsup><annotation encoding="application/x-tex">C_{s+dn-1}^{dn-1}</annotation></semantics></math>, we can rewrite it as <math id="S3.SS1.p1.m3" class="ltx_Math" alttext="\left\{\boldsymbol{\alpha}_{1},\cdots,\boldsymbol{\alpha}_{C_{s+dn-1}^{dn-1}}\right\}" display="inline" intent=":literal"><semantics><mrow><mo>{</mo><msub><mi>𝜶</mi><mn>1</mn></msub><mo>,</mo><mo lspace="0em" rspace="0em">⋯</mo><mo>,</mo><msub><mi>𝜶</mi><msubsup><mi>C</mi><mrow><mrow><mi>s</mi><mo>+</mo><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow></mrow><mo>−</mo><mn>1</mn></mrow><mrow><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow><mo>−</mo><mn>1</mn></mrow></msubsup></msub><mo>}</mo></mrow><annotation encoding="application/x-tex">\left\{\boldsymbol{\alpha}_{1},\cdots,\boldsymbol{\alpha}_{C_{s+dn-1}^{dn-1}}\right\}</annotation></semantics></math>. For each <math id="S3.SS1.p1.m4" class="ltx_Math" alttext="p\in[d]" display="inline" intent=":literal"><semantics><mrow><mi>p</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mi>d</mi><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">p\in[d]</annotation></semantics></math> and <math id="S3.SS1.p1.m5" class="ltx_Math" alttext="q\in[n]" display="inline" intent=":literal"><semantics><mrow><mi>q</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mi>n</mi><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">q\in[n]</annotation></semantics></math>, let</p>
<table id="S3.EGx57" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="S3.Ex91"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S3.Ex91.m1" class="ltx_Math" alttext="\displaystyle P_{j}(f_{pq})=\sum_{i\in\left[C_{s+dn-1}^{dn-1}\right]}c_{i,j}(f_{pq})\left(\boldsymbol{X}-\boldsymbol{X}^{(j)}\right)^{\boldsymbol{\alpha}_{i}}" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>P</mi><mi>j</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>f</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>∈</mo><mrow><mo>[</mo><msubsup><mi>C</mi><mrow><mrow><mi>s</mi><mo>+</mo><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow></mrow><mo>−</mo><mn>1</mn></mrow><mrow><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow><mo>−</mo><mn>1</mn></mrow></msubsup><mo>]</mo></mrow></mrow></munder></mstyle><mrow><msub><mi>c</mi><mrow><mi>i</mi><mo>,</mo><mi>j</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>f</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo>(</mo><mrow><mi>𝑿</mi><mo>−</mo><msup><mi>𝑿</mi><mrow><mo stretchy="false">(</mo><mi>j</mi><mo stretchy="false">)</mo></mrow></msup></mrow><mo>)</mo></mrow><msub><mi>𝜶</mi><mi>i</mi></msub></msup></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle P_{j}(f_{pq})=\sum_{i\in\left[C_{s+dn-1}^{dn-1}\right]}c_{i,j}(f_{pq})\left(\boldsymbol{X}-\boldsymbol{X}^{(j)}\right)^{\boldsymbol{\alpha}_{i}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S3.SS1.p1.2" class="ltx_p">be the <math id="S3.SS1.p1.m6" class="ltx_Math" alttext="s-1" display="inline" intent=":literal"><semantics><mrow><mi>s</mi><mo>−</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">s-1</annotation></semantics></math> order Taylor polynomial of <math id="S3.SS1.p1.m7" class="ltx_Math" alttext="f_{pq}" display="inline" intent=":literal"><semantics><msub><mi>f</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub><annotation encoding="application/x-tex">f_{pq}</annotation></semantics></math> at the grid point <math id="S3.SS1.p1.m8" class="ltx_Math" alttext="\boldsymbol{X}^{(j)}:={\boldsymbol{\beta}_{j}}/{K}" display="inline" intent=":literal"><semantics><mrow><msup><mi>𝑿</mi><mrow><mo stretchy="false">(</mo><mi>j</mi><mo stretchy="false">)</mo></mrow></msup><mo>:=</mo><mrow><msub><mi>𝜷</mi><mi>j</mi></msub><mo>/</mo><mi>K</mi></mrow></mrow><annotation encoding="application/x-tex">\boldsymbol{X}^{(j)}:={\boldsymbol{\beta}_{j}}/{K}</annotation></semantics></math>. Here we use the notation <math id="S3.SS1.p1.m9" class="ltx_Math" alttext="\boldsymbol{X}^{\boldsymbol{\alpha}}:=\prod_{u=1}^{d}\prod_{v=1}^{n}x_{uv}^{\alpha_{uv}}" display="inline" intent=":literal"><semantics><mrow><msup><mi>𝑿</mi><mi>𝜶</mi></msup><mo rspace="0.111em">:=</mo><mrow><msubsup><mo rspace="0em">∏</mo><mrow><mi>u</mi><mo>=</mo><mn>1</mn></mrow><mi>d</mi></msubsup><mrow><msubsup><mo>∏</mo><mrow><mi>v</mi><mo>=</mo><mn>1</mn></mrow><mi>n</mi></msubsup><msubsup><mi>x</mi><mrow><mi>u</mi><mo lspace="0em" rspace="0em">​</mo><mi>v</mi></mrow><msub><mi>α</mi><mrow><mi>u</mi><mo lspace="0em" rspace="0em">​</mo><mi>v</mi></mrow></msub></msubsup></mrow></mrow></mrow><annotation encoding="application/x-tex">\boldsymbol{X}^{\boldsymbol{\alpha}}:=\prod_{u=1}^{d}\prod_{v=1}^{n}x_{uv}^{\alpha_{uv}}</annotation></semantics></math>. For any <math id="S3.SS1.p1.m10" class="ltx_Math" alttext="\boldsymbol{X}\in\Omega_{j}" display="inline" intent=":literal"><semantics><mrow><mi>𝑿</mi><mo>∈</mo><msub><mi mathvariant="normal">Ω</mi><mi>j</mi></msub></mrow><annotation encoding="application/x-tex">\boldsymbol{X}\in\Omega_{j}</annotation></semantics></math> with <math id="S3.SS1.p1.m11" class="ltx_Math" alttext="j\in\left[K^{dn}\right]" display="inline" intent=":literal"><semantics><mrow><mi>j</mi><mo>∈</mo><mrow><mo>[</mo><msup><mi>K</mi><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow></msup><mo>]</mo></mrow></mrow><annotation encoding="application/x-tex">j\in\left[K^{dn}\right]</annotation></semantics></math>, the standard Taylor remainder estimate gives</p>
<table id="S3.EGx58" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="S3.E8"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S3.E8.m1" class="ltx_Math" alttext="\displaystyle\left|f_{pq}(\boldsymbol{X})-\sum_{i\in\left[C_{s+dn-1}^{dn-1}\right]}c_{i,j}(f_{pq})\left(\boldsymbol{X}-\boldsymbol{X}^{(j)}\right)^{\boldsymbol{\alpha}_{i}}\right|\leq C(\boldsymbol{f},s,d,n)\frac{1}{K^{s+\lambda}}." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mo>|</mo><mrow><mrow><msub><mi>f</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝑿</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>∈</mo><mrow><mo>[</mo><msubsup><mi>C</mi><mrow><mrow><mi>s</mi><mo>+</mo><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow></mrow><mo>−</mo><mn>1</mn></mrow><mrow><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow><mo>−</mo><mn>1</mn></mrow></msubsup><mo>]</mo></mrow></mrow></munder></mstyle><mrow><msub><mi>c</mi><mrow><mi>i</mi><mo>,</mo><mi>j</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>f</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo>(</mo><mrow><mi>𝑿</mi><mo>−</mo><msup><mi>𝑿</mi><mrow><mo stretchy="false">(</mo><mi>j</mi><mo stretchy="false">)</mo></mrow></msup></mrow><mo>)</mo></mrow><msub><mi>𝜶</mi><mi>i</mi></msub></msup></mrow></mrow></mrow><mo>|</mo></mrow><mo>≤</mo><mrow><mrow><mi>C</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝒇</mi><mo>,</mo><mi>s</mi><mo>,</mo><mi>d</mi><mo>,</mo><mi>n</mi><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><msup><mi>K</mi><mrow><mi>s</mi><mo>+</mo><mi>λ</mi></mrow></msup></mfrac></mstyle></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\left|f_{pq}(\boldsymbol{X})-\sum_{i\in\left[C_{s+dn-1}^{dn-1}\right]}c_{i,j}(f_{pq})\left(\boldsymbol{X}-\boldsymbol{X}^{(j)}\right)^{\boldsymbol{\alpha}_{i}}\right|\leq C(\boldsymbol{f},s,d,n)\frac{1}{K^{s+\lambda}}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(8)</span></td></tr></tbody>
</table>
<p id="S3.SS1.p1.3" class="ltx_p">Based on this estimation, we can ahieve the approximation of <math id="S3.SS1.p1.m12" class="ltx_Math" alttext="f_{pq}" display="inline" intent=":literal"><semantics><msub><mi>f</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub><annotation encoding="application/x-tex">f_{pq}</annotation></semantics></math> once we achieve the approximation of Taylor polynomials <math id="S3.SS1.p1.m13" class="ltx_Math" alttext="P_{j}(f_{pq})" display="inline" intent=":literal"><semantics><mrow><msub><mi>P</mi><mi>j</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>f</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">P_{j}(f_{pq})</annotation></semantics></math>. To this end, we divide our proof into seven steps. In step 1, we use the following lemma to contruct a feedforward block that maps <math id="S3.SS1.p1.m14" class="ltx_Math" alttext="\Omega_{j}" display="inline" intent=":literal"><semantics><msub><mi mathvariant="normal">Ω</mi><mi>j</mi></msub><annotation encoding="application/x-tex">\Omega_{j}</annotation></semantics></math> to the grid point <math id="S3.SS1.p1.m15" class="ltx_Math" alttext="\boldsymbol{X}^{(j)}" display="inline" intent=":literal"><semantics><msup><mi>𝑿</mi><mrow><mo stretchy="false">(</mo><mi>j</mi><mo stretchy="false">)</mo></mrow></msup><annotation encoding="application/x-tex">\boldsymbol{X}^{(j)}</annotation></semantics></math>.</p>
</div>
<div id="Thmlemma6" class="ltx_theorem ltx_theorem_lemma">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="Thmlemma6.2" class="ltx_text ltx_font_bold">Lemma 6</span></span><span id="Thmlemma6.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="Thmlemma6.p1" class="ltx_para">
<p id="Thmlemma6.p1.1" class="ltx_p"><span id="Thmlemma6.p1.1.1" class="ltx_text ltx_font_italic">There exists a ReLU FNN function <math id="Thmlemma6.p1.m1" class="ltx_Math" alttext="f_{FF}^{(dsc)}:\mathbb{R}\to\mathbb{R}" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>f</mi><mrow><mi>F</mi><mo lspace="0em" rspace="0em">​</mo><mi>F</mi></mrow><mrow><mo stretchy="false">(</mo><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>s</mi><mo lspace="0em" rspace="0em">​</mo><mi>c</mi></mrow><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi>ℝ</mi><mo stretchy="false">→</mo><mi>ℝ</mi></mrow></mrow><annotation encoding="application/x-tex">f_{FF}^{(dsc)}:\mathbb{R}\to\mathbb{R}</annotation></semantics></math> with width <math id="Thmlemma6.p1.m2" class="ltx_Math" alttext="K" display="inline" intent=":literal"><semantics><mi>K</mi><annotation encoding="application/x-tex">K</annotation></semantics></math>, depth <math id="Thmlemma6.p1.m3" class="ltx_Math" alttext="3" display="inline" intent=":literal"><semantics><mn>3</mn><annotation encoding="application/x-tex">3</annotation></semantics></math> and weight bound <math id="Thmlemma6.p1.m4" class="ltx_Math" alttext="1/\delta" display="inline" intent=":literal"><semantics><mrow><mn>1</mn><mo>/</mo><mi>δ</mi></mrow><annotation encoding="application/x-tex">1/\delta</annotation></semantics></math> such that for any <math id="Thmlemma6.p1.m5" class="ltx_Math" alttext="x\in\left[\frac{k}{K},\frac{k+1}{K}\right]" display="inline" intent=":literal"><semantics><mrow><mi>x</mi><mo>∈</mo><mrow><mo>[</mo><mrow><mfrac><mi>k</mi><mi>K</mi></mfrac><mo>,</mo><mfrac><mrow><mi>k</mi><mo>+</mo><mn>1</mn></mrow><mi>K</mi></mfrac></mrow><mo>]</mo></mrow></mrow><annotation encoding="application/x-tex">x\in\left[\frac{k}{K},\frac{k+1}{K}\right]</annotation></semantics></math> with <math id="Thmlemma6.p1.m6" class="ltx_Math" alttext="k\in\{0,1,\cdots,K-1\}" display="inline" intent=":literal"><semantics><mrow><mi>k</mi><mo>∈</mo><mrow><mo stretchy="false">{</mo><mrow><mn>0</mn><mo>,</mo><mn>1</mn><mo>,</mo><mo lspace="0em" rspace="0em">⋯</mo><mo>,</mo><mrow><mi>K</mi><mo>−</mo><mn>1</mn></mrow></mrow><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">k\in\{0,1,\cdots,K-1\}</annotation></semantics></math>,</span></p>
<table id="S3.EGx59" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="S3.Ex92"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S3.Ex92.m1" class="ltx_math_unparsed" alttext="\displaystyle f_{FF}^{(dsc)}(x)=\left\{\begin{matrix}\frac{k}{K},&amp;x\in\left[\frac{k}{K},\frac{k+1-\delta}{K}\right);\\
\frac{k+1}{K}-\frac{k+1-Kx}{K\delta},&amp;x\in\left[\frac{k+1-\delta}{K},\frac{k+1}{K}\right].\end{matrix}\right." display="inline" intent=":literal"><semantics><mrow><msubsup><mi>f</mi><mrow><mi>F</mi><mo lspace="0em" rspace="0em">​</mo><mi>F</mi></mrow><mrow><mo stretchy="false">(</mo><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>s</mi><mo lspace="0em" rspace="0em">​</mo><mi>c</mi></mrow><mo stretchy="false">)</mo></mrow></msubsup><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow><mo>=</mo><mrow><mo>{</mo><mtable columnspacing="5pt" rowspacing="0pt"><mtr><mtd><mrow><mfrac><mi>k</mi><mi>K</mi></mfrac><mo>,</mo></mrow></mtd><mtd><mrow><mrow><mi>x</mi><mo>∈</mo><mrow><mo>[</mo><mfrac><mi>k</mi><mi>K</mi></mfrac><mo>,</mo><mfrac><mrow><mrow><mi>k</mi><mo>+</mo><mn>1</mn></mrow><mo>−</mo><mi>δ</mi></mrow><mi>K</mi></mfrac><mo>)</mo></mrow></mrow><mo>;</mo></mrow></mtd></mtr><mtr><mtd><mrow><mrow><mfrac><mrow><mi>k</mi><mo>+</mo><mn>1</mn></mrow><mi>K</mi></mfrac><mo>−</mo><mfrac><mrow><mrow><mi>k</mi><mo>+</mo><mn>1</mn></mrow><mo>−</mo><mrow><mi>K</mi><mo lspace="0em" rspace="0em">​</mo><mi>x</mi></mrow></mrow><mrow><mi>K</mi><mo lspace="0em" rspace="0em">​</mo><mi>δ</mi></mrow></mfrac></mrow><mo>,</mo></mrow></mtd><mtd><mrow><mrow><mi>x</mi><mo>∈</mo><mrow><mo>[</mo><mrow><mfrac><mrow><mrow><mi>k</mi><mo>+</mo><mn>1</mn></mrow><mo>−</mo><mi>δ</mi></mrow><mi>K</mi></mfrac><mo>,</mo><mfrac><mrow><mi>k</mi><mo>+</mo><mn>1</mn></mrow><mi>K</mi></mfrac></mrow><mo>]</mo></mrow></mrow><mo lspace="0em">.</mo></mrow></mtd></mtr></mtable></mrow></mrow><annotation encoding="application/x-tex">\displaystyle f_{FF}^{(dsc)}(x)=\left\{\begin{matrix}\frac{k}{K},&amp;x\in\left[\frac{k}{K},\frac{k+1-\delta}{K}\right);\\
\frac{k+1}{K}-\frac{k+1-Kx}{K\delta},&amp;x\in\left[\frac{k+1-\delta}{K},\frac{k+1}{K}\right].\end{matrix}\right.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
</div>
<div id="S3.SS1.2" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="S3.SS1.p2" class="ltx_para">
<p id="S3.SS1.p2.1" class="ltx_p"><span id="S3.SS1.p2.1.1" class="ltx_text">We first construct a FNN function that approximate the step function <math id="S3.SS1.p2.m1" class="ltx_Math" alttext="\mathbbm{1}_{x\geq 1}" display="inline" intent=":literal"><semantics><msub><mn>𝟙</mn><mrow><mi>x</mi><mo>≥</mo><mn>1</mn></mrow></msub><annotation encoding="application/x-tex">\mathbbm{1}_{x\geq 1}</annotation></semantics></math>:</span></p>
<table id="S3.EGx60" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="S3.Ex93"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S3.Ex93.m1" class="ltx_math_unparsed" alttext="\displaystyle g(x):=\sigma_{R}\left(1-\sigma_{R}\left(-\frac{x}{\delta}+\frac{1}{\delta}\right)\right)=\left\{\begin{matrix}0,&amp;x&lt;1-\delta;\\
1-\frac{1-x}{\delta},&amp;1-\delta\leq x\leq 1;\\
1,&amp;x&gt;1.\end{matrix}\right." display="inline" intent=":literal"><semantics><mrow><mi>g</mi><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow><mo>:=</mo><msub><mi>σ</mi><mi>R</mi></msub><mrow><mo>(</mo><mn>1</mn><mo>−</mo><msub><mi>σ</mi><mi>R</mi></msub><mrow><mo>(</mo><mo lspace="0em">−</mo><mstyle displaystyle="true"><mfrac><mi>x</mi><mi>δ</mi></mfrac></mstyle><mo>+</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>δ</mi></mfrac></mstyle><mo>)</mo></mrow><mo>)</mo></mrow><mo>=</mo><mrow><mo>{</mo><mtable columnspacing="5pt" rowspacing="0pt"><mtr><mtd><mrow><mn>0</mn><mo>,</mo></mrow></mtd><mtd><mrow><mrow><mi>x</mi><mo>&lt;</mo><mrow><mn>1</mn><mo>−</mo><mi>δ</mi></mrow></mrow><mo>;</mo></mrow></mtd></mtr><mtr><mtd><mrow><mrow><mn>1</mn><mo>−</mo><mfrac><mrow><mn>1</mn><mo>−</mo><mi>x</mi></mrow><mi>δ</mi></mfrac></mrow><mo>,</mo></mrow></mtd><mtd><mrow><mrow><mrow><mn>1</mn><mo>−</mo><mi>δ</mi></mrow><mo>≤</mo><mi>x</mi><mo>≤</mo><mn>1</mn></mrow><mo>;</mo></mrow></mtd></mtr><mtr><mtd><mrow><mn>1</mn><mo>,</mo></mrow></mtd><mtd><mrow><mrow><mi>x</mi><mo>&gt;</mo><mn>1</mn></mrow><mo lspace="0em">.</mo></mrow></mtd></mtr></mtable></mrow></mrow><annotation encoding="application/x-tex">\displaystyle g(x):=\sigma_{R}\left(1-\sigma_{R}\left(-\frac{x}{\delta}+\frac{1}{\delta}\right)\right)=\left\{\begin{matrix}0,&amp;x&lt;1-\delta;\\
1-\frac{1-x}{\delta},&amp;1-\delta\leq x\leq 1;\\
1,&amp;x&gt;1.\end{matrix}\right.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S3.SS1.p2.2" class="ltx_p"><span id="S3.SS1.p2.2.1" class="ltx_text">Then <math id="S3.SS1.p2.m2" class="ltx_Math" alttext="f_{FF}^{(dsc)}" display="inline" intent=":literal"><semantics><msubsup><mi>f</mi><mrow><mi>F</mi><mo lspace="0em" rspace="0em">​</mo><mi>F</mi></mrow><mrow><mo stretchy="false">(</mo><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>s</mi><mo lspace="0em" rspace="0em">​</mo><mi>c</mi></mrow><mo stretchy="false">)</mo></mrow></msubsup><annotation encoding="application/x-tex">f_{FF}^{(dsc)}</annotation></semantics></math> is contructed through a summation of a series of <math id="S3.SS1.p2.m3" class="ltx_Math" alttext="g" display="inline" intent=":literal"><semantics><mi>g</mi><annotation encoding="application/x-tex">g</annotation></semantics></math> that have undergone translation and scaling transformations:</span></p>
<table id="S3.EGx61" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="S3.Ex94"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S3.Ex94.m1" class="ltx_Math" alttext="\displaystyle f_{FF}^{(dsc)}(x):=\frac{1}{K}\sum_{k=0}^{K-1}g(Kx-k)." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><msubsup><mi>f</mi><mrow><mi>F</mi><mo lspace="0em" rspace="0em">​</mo><mi>F</mi></mrow><mrow><mo stretchy="false">(</mo><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>s</mi><mo lspace="0em" rspace="0em">​</mo><mi>c</mi></mrow><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo>:=</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>K</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>k</mi><mo>=</mo><mn>0</mn></mrow><mrow><mi>K</mi><mo>−</mo><mn>1</mn></mrow></munderover></mstyle><mrow><mi>g</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mi>K</mi><mo lspace="0em" rspace="0em">​</mo><mi>x</mi></mrow><mo>−</mo><mi>k</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle f_{FF}^{(dsc)}(x):=\frac{1}{K}\sum_{k=0}^{K-1}g(Kx-k).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S3.SS1.p2.3" class="ltx_p"><span id="S3.SS1.p2.3.1" class="ltx_text">∎</span></p>
</div>
</div>
<div id="S3.SS1.p3" class="ltx_para">
<p id="S3.SS1.p3.1" class="ltx_p">In step 2, we construct a Transformer to map the grid point <math id="S3.SS1.p3.m1" class="ltx_Math" alttext="\boldsymbol{X}_{j}" display="inline" intent=":literal"><semantics><msub><mi>𝑿</mi><mi>j</mi></msub><annotation encoding="application/x-tex">\boldsymbol{X}_{j}</annotation></semantics></math> to the Taylor coefficients <math id="S3.SS1.p3.m2" class="ltx_Math" alttext="c_{i,j}" display="inline" intent=":literal"><semantics><msub><mi>c</mi><mrow><mi>i</mi><mo>,</mo><mi>j</mi></mrow></msub><annotation encoding="application/x-tex">c_{i,j}</annotation></semantics></math>, which is exactly a memorization task. The following tokenwise separatedness assumption on the input sequences is common in the literature of Transformer memorization <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib25" title="" class="ltx_ref">25</a>, <a href="#bib.bib22" title="" class="ltx_ref">22</a>, <a href="#bib.bib23" title="" class="ltx_ref">23</a>]</cite>.</p>
</div>
<div id="Thmdefinition2" class="ltx_theorem ltx_theorem_definition">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="Thmdefinition2.2" class="ltx_text ltx_font_bold">Definition 2</span></span><span id="Thmdefinition2.3" class="ltx_text ltx_font_bold"> </span>(Tokenwise separatedness)<span id="Thmdefinition2.4" class="ltx_text ltx_font_bold">.</span></h6>
<div id="Thmdefinition2.p1" class="ltx_para">
<p id="Thmdefinition2.p1.1" class="ltx_p"><span id="Thmdefinition2.p1.1.1" class="ltx_text ltx_font_italic">Let <math id="Thmdefinition2.p1.m1" class="ltx_Math" alttext="N\in\mathbb{N}_{\geq 1}" display="inline" intent=":literal"><semantics><mrow><mi>N</mi><mo>∈</mo><msub><mi>ℕ</mi><mrow><mphantom></mphantom><mo>≥</mo><mn>1</mn></mrow></msub></mrow><annotation encoding="application/x-tex">N\in\mathbb{N}_{\geq 1}</annotation></semantics></math> and <math id="Thmdefinition2.p1.m2" class="ltx_Math" alttext="r,\phi\in\mathbb{R}_{&gt;0}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>r</mi><mo>,</mo><mi>ϕ</mi></mrow><mo>∈</mo><msub><mi>ℝ</mi><mrow><mphantom></mphantom><mo>&gt;</mo><mn>0</mn></mrow></msub></mrow><annotation encoding="application/x-tex">r,\phi\in\mathbb{R}_{&gt;0}</annotation></semantics></math>. Let <math id="Thmdefinition2.p1.m3" class="ltx_Math" alttext="\boldsymbol{X}^{(1)},\cdots,\boldsymbol{X}^{(N)}\in\mathbb{R}^{d\times n}" display="inline" intent=":literal"><semantics><mrow><msup><mi>𝐗</mi><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msup><mo>,</mo><mo lspace="0em" rspace="0em">⋯</mo><mo>,</mo><mrow><msup><mi>𝐗</mi><mrow><mo stretchy="false">(</mo><mi>N</mi><mo stretchy="false">)</mo></mrow></msup><mo>∈</mo><msup><mi>ℝ</mi><mrow><mi>d</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>n</mi></mrow></msup></mrow></mrow><annotation encoding="application/x-tex">\boldsymbol{X}^{(1)},\cdots,\boldsymbol{X}^{(N)}\in\mathbb{R}^{d\times n}</annotation></semantics></math> be a set of <math id="Thmdefinition2.p1.m4" class="ltx_Math" alttext="N" display="inline" intent=":literal"><semantics><mi>N</mi><annotation encoding="application/x-tex">N</annotation></semantics></math> input sequences. Then, we say that <math id="Thmdefinition2.p1.m5" class="ltx_Math" alttext="\left\{\boldsymbol{X}^{(i)}\right\}_{i\in[N]}" display="inline" intent=":literal"><semantics><msub><mrow><mo>{</mo><msup><mi>𝐗</mi><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></msup><mo>}</mo></mrow><mrow><mi>i</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mi>N</mi><mo stretchy="false">]</mo></mrow></mrow></msub><annotation encoding="application/x-tex">\left\{\boldsymbol{X}^{(i)}\right\}_{i\in[N]}</annotation></semantics></math> are tokenwise <math id="Thmdefinition2.p1.m6" class="ltx_Math" alttext="(r,\phi)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi>r</mi><mo>,</mo><mi>ϕ</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(r,\phi)</annotation></semantics></math>-separated if the following two conditions are satisfied:</span></p>
<ul id="S3.I1" class="ltx_itemize">
<li id="S3.I1.i1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="S3.I1.i1.p1" class="ltx_para">
<p id="S3.I1.i1.p1.1" class="ltx_p"><span id="S3.I1.i1.p1.1.1" class="ltx_text ltx_font_italic">For any </span><math id="S3.I1.i1.p1.m1" class="ltx_Math" alttext="i\in[N]" display="inline" intent=":literal"><semantics><mrow><mi>i</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mi>N</mi><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">i\in[N]</annotation></semantics></math><span id="S3.I1.i1.p1.1.2" class="ltx_text ltx_font_italic"> and </span><math id="S3.I1.i1.p1.m2" class="ltx_Math" alttext="k\in[n]" display="inline" intent=":literal"><semantics><mrow><mi>k</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mi>n</mi><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">k\in[n]</annotation></semantics></math><span id="S3.I1.i1.p1.1.3" class="ltx_text ltx_font_italic">, </span><math id="S3.I1.i1.p1.m3" class="ltx_math_unparsed" alttext="\left\|\boldsymbol{X}_{:,k}^{(i)}\right\|_{2}\leq r" display="inline" intent=":literal"><semantics><mrow><msub><mrow><mo>‖</mo><msubsup><mi>𝑿</mi><mrow><mo rspace="0em">:</mo><mo>,</mo><mi>k</mi></mrow><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></msubsup><mo>‖</mo></mrow><mn>2</mn></msub><mo>≤</mo><mi>r</mi></mrow><annotation encoding="application/x-tex">\left\|\boldsymbol{X}_{:,k}^{(i)}\right\|_{2}\leq r</annotation></semantics></math><span id="S3.I1.i1.p1.1.4" class="ltx_text ltx_font_italic"> holds.</span></p>
</div></li>
<li id="S3.I1.i2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="S3.I1.i2.p1" class="ltx_para">
<p id="S3.I1.i2.p1.1" class="ltx_p"><span id="S3.I1.i2.p1.1.1" class="ltx_text ltx_font_italic">For any </span><math id="S3.I1.i2.p1.m1" class="ltx_Math" alttext="i,j\in[N]" display="inline" intent=":literal"><semantics><mrow><mrow><mi>i</mi><mo>,</mo><mi>j</mi></mrow><mo>∈</mo><mrow><mo stretchy="false">[</mo><mi>N</mi><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">i,j\in[N]</annotation></semantics></math><span id="S3.I1.i2.p1.1.2" class="ltx_text ltx_font_italic"> and </span><math id="S3.I1.i2.p1.m2" class="ltx_Math" alttext="k,l\in[n]" display="inline" intent=":literal"><semantics><mrow><mrow><mi>k</mi><mo>,</mo><mi>l</mi></mrow><mo>∈</mo><mrow><mo stretchy="false">[</mo><mi>n</mi><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">k,l\in[n]</annotation></semantics></math><span id="S3.I1.i2.p1.1.3" class="ltx_text ltx_font_italic">, either </span><math id="S3.I1.i2.p1.m3" class="ltx_math_unparsed" alttext="\boldsymbol{X}_{:,k}^{(i)}=\boldsymbol{X}_{:,l}^{(j)}" display="inline" intent=":literal"><semantics><mrow><mi>𝑿</mi><msub><mrow></mrow><mrow><mo rspace="0em">:</mo><mo>,</mo><mi>k</mi></mrow></msub><msup><mrow></mrow><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></msup><mo>=</mo><mi>𝑿</mi><msub><mrow></mrow><mrow><mo rspace="0em">:</mo><mo>,</mo><mi>l</mi></mrow></msub><msup><mrow></mrow><mrow><mo stretchy="false">(</mo><mi>j</mi><mo stretchy="false">)</mo></mrow></msup></mrow><annotation encoding="application/x-tex">\boldsymbol{X}_{:,k}^{(i)}=\boldsymbol{X}_{:,l}^{(j)}</annotation></semantics></math><span id="S3.I1.i2.p1.1.4" class="ltx_text ltx_font_italic"> or </span><math id="S3.I1.i2.p1.m4" class="ltx_math_unparsed" alttext="\left\|\boldsymbol{X}_{:,k}^{(i)}-\boldsymbol{X}_{:,l}^{(j)}\right\|_{2}\geq\phi" display="inline" intent=":literal"><semantics><mrow><msub><mrow><mo>‖</mo><msubsup><mi>𝑿</mi><mrow><mo rspace="0em">:</mo><mo>,</mo><mi>k</mi></mrow><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></msubsup><mo>−</mo><msubsup><mi>𝑿</mi><mrow><mo rspace="0em">:</mo><mo>,</mo><mi>l</mi></mrow><mrow><mo stretchy="false">(</mo><mi>j</mi><mo stretchy="false">)</mo></mrow></msubsup><mo>‖</mo></mrow><mn>2</mn></msub><mo>≥</mo><mi>ϕ</mi></mrow><annotation encoding="application/x-tex">\left\|\boldsymbol{X}_{:,k}^{(i)}-\boldsymbol{X}_{:,l}^{(j)}\right\|_{2}\geq\phi</annotation></semantics></math><span id="S3.I1.i2.p1.1.5" class="ltx_text ltx_font_italic"> holds.</span></p>
</div></li>
</ul>
</div>
</div>
<div id="S3.SS1.p4" class="ltx_para">
<p id="S3.SS1.p4.1" class="ltx_p">With this assumption, we are able to construct a Transformer realizing memorization. We provide a detailed characterization of its structure in Lemma <a href="#Thmlemma7" title="Lemma 7. ‣ 3.1 Proof of Proposition ‣ 3 Proof of Proposition : Construction of Transformers ‣ Standard Transformers Achieve the Minimax Rate in Nonparametric Regression with 𝐶^{𝑠,𝜆} Targets" class="ltx_ref"><span class="ltx_text ltx_ref_tag">7</span></a>. Since this result is of independent interest, its proof is presented in a separate section (Section <a href="#S4" title="4 Proof of Lemma : Memorization of Transformers ‣ Standard Transformers Achieve the Minimax Rate in Nonparametric Regression with 𝐶^{𝑠,𝜆} Targets" class="ltx_ref"><span class="ltx_text ltx_ref_tag">4</span></a>).</p>
</div>
<div id="Thmlemma7" class="ltx_theorem ltx_theorem_lemma">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="Thmlemma7.2" class="ltx_text ltx_font_bold">Lemma 7</span></span><span id="Thmlemma7.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="Thmlemma7.p1" class="ltx_para">
<p id="Thmlemma7.p1.1" class="ltx_p"><span id="Thmlemma7.p1.1.1" class="ltx_text ltx_font_italic">Let <math id="Thmlemma7.p1.m1" class="ltx_Math" alttext="N\in\mathbb{N}_{\geq 2}" display="inline" intent=":literal"><semantics><mrow><mi>N</mi><mo>∈</mo><msub><mi>ℕ</mi><mrow><mphantom></mphantom><mo>≥</mo><mn>2</mn></mrow></msub></mrow><annotation encoding="application/x-tex">N\in\mathbb{N}_{\geq 2}</annotation></semantics></math> and <math id="Thmlemma7.p1.m2" class="ltx_Math" alttext="r,\phi,B_{y}\in\mathbb{R}_{&gt;0}" display="inline" intent=":literal"><semantics><mrow><mi>r</mi><mo>,</mo><mi>ϕ</mi><mo>,</mo><mrow><msub><mi>B</mi><mi>y</mi></msub><mo>∈</mo><msub><mi>ℝ</mi><mrow><mphantom></mphantom><mo>&gt;</mo><mn>0</mn></mrow></msub></mrow></mrow><annotation encoding="application/x-tex">r,\phi,B_{y}\in\mathbb{R}_{&gt;0}</annotation></semantics></math>. Suppose <math id="Thmlemma7.p1.m3" class="ltx_Math" alttext="r&gt;\phi" display="inline" intent=":literal"><semantics><mrow><mi>r</mi><mo>&gt;</mo><mi>ϕ</mi></mrow><annotation encoding="application/x-tex">r&gt;\phi</annotation></semantics></math>. For any <math id="Thmlemma7.p1.m4" class="ltx_Math" alttext="N" display="inline" intent=":literal"><semantics><mi>N</mi><annotation encoding="application/x-tex">N</annotation></semantics></math> data pairs <math id="Thmlemma7.p1.m5" class="ltx_Math" alttext="\left\{\left(\boldsymbol{X}^{(i)},\boldsymbol{Y}^{(i)}\right)\right\}_{i\in[N]}\subset\mathbb{R}^{d\times n}\times[-B_{y},B_{y}]^{1\times n}" display="inline" intent=":literal"><semantics><mrow><msub><mrow><mo>{</mo><mrow><mo>(</mo><msup><mi>𝐗</mi><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></msup><mo>,</mo><msup><mi>𝐘</mi><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></msup><mo>)</mo></mrow><mo>}</mo></mrow><mrow><mi>i</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mi>N</mi><mo stretchy="false">]</mo></mrow></mrow></msub><mo>⊂</mo><mrow><msup><mi>ℝ</mi><mrow><mi>d</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>n</mi></mrow></msup><mo lspace="0.222em" rspace="0.222em">×</mo><msup><mrow><mo stretchy="false">[</mo><mrow><mrow><mo>−</mo><msub><mi>B</mi><mi>y</mi></msub></mrow><mo>,</mo><msub><mi>B</mi><mi>y</mi></msub></mrow><mo stretchy="false">]</mo></mrow><mrow><mn>1</mn><mo lspace="0.222em" rspace="0.222em">×</mo><mi>n</mi></mrow></msup></mrow></mrow><annotation encoding="application/x-tex">\left\{\left(\boldsymbol{X}^{(i)},\boldsymbol{Y}^{(i)}\right)\right\}_{i\in[N]}\subset\mathbb{R}^{d\times n}\times[-B_{y},B_{y}]^{1\times n}</annotation></semantics></math> such that the input sequences <math id="Thmlemma7.p1.m6" class="ltx_Math" alttext="\left\{\boldsymbol{X}^{(i)}\right\}_{i\in[N]}" display="inline" intent=":literal"><semantics><msub><mrow><mo>{</mo><msup><mi>𝐗</mi><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></msup><mo>}</mo></mrow><mrow><mi>i</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mi>N</mi><mo stretchy="false">]</mo></mrow></mrow></msub><annotation encoding="application/x-tex">\left\{\boldsymbol{X}^{(i)}\right\}_{i\in[N]}</annotation></semantics></math> are distinct and are tokenwise <math id="Thmlemma7.p1.m7" class="ltx_Math" alttext="(r,\phi)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi>r</mi><mo>,</mo><mi>ϕ</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(r,\phi)</annotation></semantics></math>-separated, there eixsts a Transformer <math id="Thmlemma7.p1.m8" class="ltx_Math" alttext="\boldsymbol{T}^{(mmr)}:\mathbb{R}^{d\times n}\to\mathbb{R}^{1\times n}" display="inline" intent=":literal"><semantics><mrow><msup><mi>𝐓</mi><mrow><mo stretchy="false">(</mo><mrow><mi>m</mi><mo lspace="0em" rspace="0em">​</mo><mi>m</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi></mrow><mo stretchy="false">)</mo></mrow></msup><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><msup><mi>ℝ</mi><mrow><mi>d</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>n</mi></mrow></msup><mo stretchy="false">→</mo><msup><mi>ℝ</mi><mrow><mn>1</mn><mo lspace="0.222em" rspace="0.222em">×</mo><mi>n</mi></mrow></msup></mrow></mrow><annotation encoding="application/x-tex">\boldsymbol{T}^{(mmr)}:\mathbb{R}^{d\times n}\to\mathbb{R}^{1\times n}</annotation></semantics></math> with size <math id="Thmlemma7.p1.m9" class="ltx_Math" alttext="\{(2,\max\{d,5\}),((3,3),(3,11))\times(n-1)\text{ times},(3,3),(3,\max\left\{5,nN-1\right\})\}" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">{</mo><mrow><mrow><mo stretchy="false">(</mo><mn>2</mn><mo>,</mo><mrow><mi>max</mi><mo>⁡</mo><mrow><mo stretchy="false">{</mo><mi>d</mi><mo>,</mo><mn>5</mn><mo stretchy="false">}</mo></mrow></mrow><mo stretchy="false">)</mo></mrow><mo>,</mo><mrow><mrow><mrow><mo stretchy="false">(</mo><mrow><mo stretchy="false">(</mo><mn>3</mn><mo>,</mo><mn>3</mn><mo stretchy="false">)</mo></mrow><mo>,</mo><mrow><mo stretchy="false">(</mo><mn>3</mn><mo>,</mo><mn>11</mn><mo stretchy="false">)</mo></mrow><mo rspace="0.055em" stretchy="false">)</mo></mrow><mo rspace="0.222em">×</mo><mrow><mo stretchy="false">(</mo><mrow><mi>n</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><mtext class="ltx_mathvariant_italic"> times</mtext></mrow><mo>,</mo><mrow><mo stretchy="false">(</mo><mn>3</mn><mo>,</mo><mn>3</mn><mo stretchy="false">)</mo></mrow><mo>,</mo><mrow><mo stretchy="false">(</mo><mn>3</mn><mo>,</mo><mrow><mi>max</mi><mo>⁡</mo><mrow><mo>{</mo><mrow><mn>5</mn><mo>,</mo><mrow><mrow><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><mi>N</mi></mrow><mo>−</mo><mn>1</mn></mrow></mrow><mo>}</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">}</mo></mrow><annotation encoding="application/x-tex">\{(2,\max\{d,5\}),((3,3),(3,11))\times(n-1)\text{ times},(3,3),(3,\max\left\{5,nN-1\right\})\}</annotation></semantics></math> and dimension vector <math id="Thmlemma7.p1.m10" class="ltx_Math" alttext="\begin{pmatrix}d&amp;d&amp;5\cdot\boldsymbol{1}_{1\times n}&amp;1\end{pmatrix}" display="inline" intent=":literal"><semantics><mrow><mo>(</mo><mtable columnspacing="5pt"><mtr><mtd><mi>d</mi></mtd><mtd><mi>d</mi></mtd><mtd><mrow><mn>5</mn><mo lspace="0.222em" rspace="0.222em">⋅</mo><msub><mn>𝟏</mn><mrow><mn>1</mn><mo lspace="0.222em" rspace="0.222em">×</mo><mi>n</mi></mrow></msub></mrow></mtd><mtd><mn>1</mn></mtd></mtr></mtable><mo>)</mo></mrow><annotation encoding="application/x-tex">\begin{pmatrix}d&amp;d&amp;5\cdot\boldsymbol{1}_{1\times n}&amp;1\end{pmatrix}</annotation></semantics></math> and a positional encoding matrix</span></p>
<table id="S3.EGx62" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="S3.Ex95"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S3.Ex95.m1" class="ltx_Math" alttext="\displaystyle\boldsymbol{E}:=\frac{3r}{\sqrt{d}}\begin{pmatrix}\boldsymbol{1}_{d\times 1}&amp;2\boldsymbol{1}_{d\times 1}&amp;\cdots&amp;n\boldsymbol{1}_{d\times 1}\end{pmatrix}\in\mathbb{R}^{d\times n}" display="inline" intent=":literal"><semantics><mrow><mi>𝑬</mi><mo>:=</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mn>3</mn><mo lspace="0em" rspace="0em">​</mo><mi>r</mi></mrow><msqrt><mi>d</mi></msqrt></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mtable columnspacing="5pt"><mtr><mtd><msub><mn>𝟏</mn><mrow><mi>d</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mn>1</mn></mrow></msub></mtd><mtd><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mn>𝟏</mn><mrow><mi>d</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mn>1</mn></mrow></msub></mrow></mtd><mtd><mo>⋯</mo></mtd><mtd><mrow><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><msub><mn>𝟏</mn><mrow><mi>d</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mn>1</mn></mrow></msub></mrow></mtd></mtr></mtable><mo>)</mo></mrow></mrow><mo>∈</mo><msup><mi>ℝ</mi><mrow><mi>d</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>n</mi></mrow></msup></mrow><annotation encoding="application/x-tex">\displaystyle\boldsymbol{E}:=\frac{3r}{\sqrt{d}}\begin{pmatrix}\boldsymbol{1}_{d\times 1}&amp;2\boldsymbol{1}_{d\times 1}&amp;\cdots&amp;n\boldsymbol{1}_{d\times 1}\end{pmatrix}\in\mathbb{R}^{d\times n}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="Thmlemma7.p1.2" class="ltx_p"><span id="Thmlemma7.p1.2.1" class="ltx_text ltx_font_italic">such that</span></p>
<ul id="S3.I2" class="ltx_itemize">
<li id="S3.I2.i1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="S3.I2.i1.p1" class="ltx_para">
<table id="S3.EGx63" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="S3.Ex96"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S3.Ex96.m1" class="ltx_Math" alttext="\displaystyle\boldsymbol{T}^{(mmr)}\left(\boldsymbol{X}^{(i)}\right)=\boldsymbol{Y}^{(i)},\quad i\in[N]." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mrow><msup><mi>𝑻</mi><mrow><mo stretchy="false">(</mo><mrow><mi>m</mi><mo lspace="0em" rspace="0em">​</mo><mi>m</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi></mrow><mo stretchy="false">)</mo></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><msup><mi>𝑿</mi><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></msup><mo>)</mo></mrow></mrow><mo>=</mo><msup><mi>𝒀</mi><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></msup></mrow><mo rspace="1.167em">,</mo><mrow><mi>i</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mi>N</mi><mo stretchy="false">]</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\boldsymbol{T}^{(mmr)}\left(\boldsymbol{X}^{(i)}\right)=\boldsymbol{Y}^{(i)},\quad i\in[N].</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S3.I2.i1.p1.1" class="ltx_p"><span id="S3.I2.i1.p1.1.1" class="ltx_text ltx_font_italic">In this case, the labels </span><math id="S3.I2.i1.p1.m1" class="ltx_Math" alttext="\left\{\boldsymbol{Y}^{(i)}\right\}_{i\in[N]}" display="inline" intent=":literal"><semantics><msub><mrow><mo>{</mo><msup><mi>𝒀</mi><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></msup><mo>}</mo></mrow><mrow><mi>i</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mi>N</mi><mo stretchy="false">]</mo></mrow></mrow></msub><annotation encoding="application/x-tex">\left\{\boldsymbol{Y}^{(i)}\right\}_{i\in[N]}</annotation></semantics></math><span id="S3.I2.i1.p1.1.2" class="ltx_text ltx_font_italic"> need to satisfy the consistency condition: for any </span><math id="S3.I2.i1.p1.m2" class="ltx_Math" alttext="i,j\in[N],k,l\in[n]" display="inline" intent=":literal"><semantics><mrow><mi>i</mi><mo>,</mo><mrow><mi>j</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mi>N</mi><mo stretchy="false">]</mo></mrow></mrow><mo>,</mo><mi>k</mi><mo>,</mo><mrow><mi>l</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mi>n</mi><mo stretchy="false">]</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">i,j\in[N],k,l\in[n]</annotation></semantics></math><span id="S3.I2.i1.p1.1.3" class="ltx_text ltx_font_italic">, </span><math id="S3.I2.i1.p1.m3" class="ltx_Math" alttext="y_{1,k}^{(i)}=y_{1,l}^{(j)}" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>y</mi><mrow><mn>1</mn><mo>,</mo><mi>k</mi></mrow><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></msubsup><mo>=</mo><msubsup><mi>y</mi><mrow><mn>1</mn><mo>,</mo><mi>l</mi></mrow><mrow><mo stretchy="false">(</mo><mi>j</mi><mo stretchy="false">)</mo></mrow></msubsup></mrow><annotation encoding="application/x-tex">y_{1,k}^{(i)}=y_{1,l}^{(j)}</annotation></semantics></math><span id="S3.I2.i1.p1.1.4" class="ltx_text ltx_font_italic"> if </span><math id="S3.I2.i1.p1.m4" class="ltx_math_unparsed" alttext="\boldsymbol{X}_{:,k}^{(i)}=\boldsymbol{X}_{:,l}^{(j)}" display="inline" intent=":literal"><semantics><mrow><mi>𝑿</mi><msub><mrow></mrow><mrow><mo rspace="0em">:</mo><mo>,</mo><mi>k</mi></mrow></msub><msup><mrow></mrow><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></msup><mo>=</mo><mi>𝑿</mi><msub><mrow></mrow><mrow><mo rspace="0em">:</mo><mo>,</mo><mi>l</mi></mrow></msub><msup><mrow></mrow><mrow><mo stretchy="false">(</mo><mi>j</mi><mo stretchy="false">)</mo></mrow></msup></mrow><annotation encoding="application/x-tex">\boldsymbol{X}_{:,k}^{(i)}=\boldsymbol{X}_{:,l}^{(j)}</annotation></semantics></math><span id="S3.I2.i1.p1.1.5" class="ltx_text ltx_font_italic"> and </span><math id="S3.I2.i1.p1.m5" class="ltx_Math" alttext="\boldsymbol{X}^{(i)}=\boldsymbol{X}^{(j)}" display="inline" intent=":literal"><semantics><mrow><msup><mi>𝑿</mi><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></msup><mo>=</mo><msup><mi>𝑿</mi><mrow><mo stretchy="false">(</mo><mi>j</mi><mo stretchy="false">)</mo></mrow></msup></mrow><annotation encoding="application/x-tex">\boldsymbol{X}^{(i)}=\boldsymbol{X}^{(j)}</annotation></semantics></math><span id="S3.I2.i1.p1.1.6" class="ltx_text ltx_font_italic"> up to permutations.</span></p>
</div></li>
<li id="S3.I2.i2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="S3.I2.i2.p1" class="ltx_para">
<table id="S3.EGx64" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="S3.Ex97"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S3.Ex97.m1" class="ltx_Math" alttext="\displaystyle\boldsymbol{T}^{(mmr)}\left(\boldsymbol{X}^{(i)}+\boldsymbol{E}\right)=\boldsymbol{Y}^{(i)},\quad i\in[N]." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mrow><msup><mi>𝑻</mi><mrow><mo stretchy="false">(</mo><mrow><mi>m</mi><mo lspace="0em" rspace="0em">​</mo><mi>m</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi></mrow><mo stretchy="false">)</mo></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><msup><mi>𝑿</mi><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></msup><mo>+</mo><mi>𝑬</mi></mrow><mo>)</mo></mrow></mrow><mo>=</mo><msup><mi>𝒀</mi><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></msup></mrow><mo rspace="1.167em">,</mo><mrow><mi>i</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mi>N</mi><mo stretchy="false">]</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\boldsymbol{T}^{(mmr)}\left(\boldsymbol{X}^{(i)}+\boldsymbol{E}\right)=\boldsymbol{Y}^{(i)},\quad i\in[N].</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S3.I2.i2.p1.1" class="ltx_p"><span id="S3.I2.i2.p1.1.1" class="ltx_text ltx_font_italic">In this case, the labels </span><math id="S3.I2.i2.p1.m1" class="ltx_Math" alttext="\left\{\boldsymbol{Y}^{(i)}\right\}_{i\in[N]}" display="inline" intent=":literal"><semantics><msub><mrow><mo>{</mo><msup><mi>𝒀</mi><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></msup><mo>}</mo></mrow><mrow><mi>i</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mi>N</mi><mo stretchy="false">]</mo></mrow></mrow></msub><annotation encoding="application/x-tex">\left\{\boldsymbol{Y}^{(i)}\right\}_{i\in[N]}</annotation></semantics></math><span id="S3.I2.i2.p1.1.2" class="ltx_text ltx_font_italic"> need not to satisfy the consistency condition.</span></p>
</div></li>
</ul>
<p id="Thmlemma7.p1.3" class="ltx_p"><span id="Thmlemma7.p1.3.1" class="ltx_text ltx_font_italic">The weight bounds of <math id="Thmlemma7.p1.m11" class="ltx_Math" alttext="\boldsymbol{T}^{(mmr)}" display="inline" intent=":literal"><semantics><msup><mi>𝐓</mi><mrow><mo stretchy="false">(</mo><mrow><mi>m</mi><mo lspace="0em" rspace="0em">​</mo><mi>m</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi></mrow><mo stretchy="false">)</mo></mrow></msup><annotation encoding="application/x-tex">\boldsymbol{T}^{(mmr)}</annotation></semantics></math> are <math id="Thmlemma7.p1.m12" class="ltx_Math" alttext="B_{FF}=\max\{R,2B_{y}\},B_{SA}=\frac{1}{2}\log(3\sqrt{d}{\pi}n^{4}(3n+1)N^{4}r\phi^{-1})" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>B</mi><mrow><mi>F</mi><mo lspace="0em" rspace="0em">​</mo><mi>F</mi></mrow></msub><mo>=</mo><mrow><mi>max</mi><mo>⁡</mo><mrow><mo stretchy="false">{</mo><mi>R</mi><mo>,</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>B</mi><mi>y</mi></msub></mrow><mo stretchy="false">}</mo></mrow></mrow></mrow><mo>,</mo><mrow><msub><mi>B</mi><mrow><mi>S</mi><mo lspace="0em" rspace="0em">​</mo><mi>A</mi></mrow></msub><mo>=</mo><mrow><mfrac><mn>1</mn><mn>2</mn></mfrac><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>log</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mn>3</mn><mo lspace="0em" rspace="0em">​</mo><msqrt><mi>d</mi></msqrt><mo lspace="0em" rspace="0em">​</mo><mi>π</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>n</mi><mn>4</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mn>3</mn><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mi>N</mi><mn>4</mn></msup><mo lspace="0em" rspace="0em">​</mo><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>ϕ</mi><mrow><mo>−</mo><mn>1</mn></mrow></msup></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">B_{FF}=\max\{R,2B_{y}\},B_{SA}=\frac{1}{2}\log(3\sqrt{d}{\pi}n^{4}(3n+1)N^{4}r\phi^{-1})</annotation></semantics></math>, where</span></p>
<table id="S3.EGx65" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="S3.Ex98"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S3.Ex98.m1" class="ltx_Math" alttext="\displaystyle R:=(\sqrt{2\pi d}n^{2}N^{2}(3n+1)r\phi^{-1}+1)\left(\frac{3{\pi}}{4}\sqrt{d}n^{3}N^{4}(3n+1)r\phi^{-1}+\frac{3}{2}\right)." display="inline" intent=":literal"><semantics><mrow><mrow><mi>R</mi><mo>:=</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mrow><msqrt><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>π</mi><mo lspace="0em" rspace="0em">​</mo><mi>d</mi></mrow></msqrt><mo lspace="0em" rspace="0em">​</mo><msup><mi>n</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>N</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mn>3</mn><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>ϕ</mi><mrow><mo>−</mo><mn>1</mn></mrow></msup></mrow><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mrow><mstyle displaystyle="true"><mfrac><mrow><mn>3</mn><mo lspace="0em" rspace="0em">​</mo><mi>π</mi></mrow><mn>4</mn></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msqrt><mi>d</mi></msqrt><mo lspace="0em" rspace="0em">​</mo><msup><mi>n</mi><mn>3</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>N</mi><mn>4</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mn>3</mn><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>ϕ</mi><mrow><mo>−</mo><mn>1</mn></mrow></msup></mrow><mo>+</mo><mstyle displaystyle="true"><mfrac><mn>3</mn><mn>2</mn></mfrac></mstyle></mrow><mo>)</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle R:=(\sqrt{2\pi d}n^{2}N^{2}(3n+1)r\phi^{-1}+1)\left(\frac{3{\pi}}{4}\sqrt{d}n^{3}N^{4}(3n+1)r\phi^{-1}+\frac{3}{2}\right).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="Thmlemma7.p1.4" class="ltx_p"><span id="Thmlemma7.p1.4.1" class="ltx_text ltx_font_italic">Furthermore, if <math id="Thmlemma7.p1.m13" class="ltx_Math" alttext="\boldsymbol{X}\in\mathbb{R}^{d\times n}" display="inline" intent=":literal"><semantics><mrow><mi>𝐗</mi><mo>∈</mo><msup><mi>ℝ</mi><mrow><mi>d</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>n</mi></mrow></msup></mrow><annotation encoding="application/x-tex">\boldsymbol{X}\in\mathbb{R}^{d\times n}</annotation></semantics></math> satisfies <math id="Thmlemma7.p1.m14" class="ltx_math_unparsed" alttext="\left\|\boldsymbol{X}_{:,k}\right\|_{2}\leq r" display="inline" intent=":literal"><semantics><mrow><msub><mrow><mo>‖</mo><msub><mi>𝐗</mi><mrow><mo rspace="0em">:</mo><mo>,</mo><mi>k</mi></mrow></msub><mo>‖</mo></mrow><mn>2</mn></msub><mo>≤</mo><mi>r</mi></mrow><annotation encoding="application/x-tex">\left\|\boldsymbol{X}_{:,k}\right\|_{2}\leq r</annotation></semantics></math> for all <math id="Thmlemma7.p1.m15" class="ltx_Math" alttext="k\in[n]" display="inline" intent=":literal"><semantics><mrow><mi>k</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mi>n</mi><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">k\in[n]</annotation></semantics></math>, then</span></p>
<table id="S3.EGx66" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="S3.Ex99"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S3.Ex99.m1" class="ltx_Math" alttext="\displaystyle\left|\boldsymbol{T}^{(mmr)}\left(\boldsymbol{X}\right)_{1,k}\right|,\left|\boldsymbol{T}^{(mmr)}\left(\boldsymbol{X}+\boldsymbol{E}\right)_{1,k}\right|\leq[4(nN-1)R+1]B_{y}" display="inline" intent=":literal"><semantics><mrow><mrow><mo>|</mo><mrow><msup><mi>𝑻</mi><mrow><mo stretchy="false">(</mo><mrow><mi>m</mi><mo lspace="0em" rspace="0em">​</mo><mi>m</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi></mrow><mo stretchy="false">)</mo></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo>(</mo><mi>𝑿</mi><mo>)</mo></mrow><mrow><mn>1</mn><mo>,</mo><mi>k</mi></mrow></msub></mrow><mo>|</mo></mrow><mo>,</mo><mrow><mrow><mo>|</mo><mrow><msup><mi>𝑻</mi><mrow><mo stretchy="false">(</mo><mrow><mi>m</mi><mo lspace="0em" rspace="0em">​</mo><mi>m</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi></mrow><mo stretchy="false">)</mo></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo>(</mo><mrow><mi>𝑿</mi><mo>+</mo><mi>𝑬</mi></mrow><mo>)</mo></mrow><mrow><mn>1</mn><mo>,</mo><mi>k</mi></mrow></msub></mrow><mo>|</mo></mrow><mo>≤</mo><mrow><mrow><mo stretchy="false">[</mo><mrow><mrow><mn>4</mn><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><mi>N</mi></mrow><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>R</mi></mrow><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">]</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>B</mi><mi>y</mi></msub></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\left|\boldsymbol{T}^{(mmr)}\left(\boldsymbol{X}\right)_{1,k}\right|,\left|\boldsymbol{T}^{(mmr)}\left(\boldsymbol{X}+\boldsymbol{E}\right)_{1,k}\right|\leq[4(nN-1)R+1]B_{y}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="Thmlemma7.p1.5" class="ltx_p"><span id="Thmlemma7.p1.5.1" class="ltx_text ltx_font_italic">for all <math id="Thmlemma7.p1.m16" class="ltx_Math" alttext="k\in[n]" display="inline" intent=":literal"><semantics><mrow><mi>k</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mi>n</mi><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">k\in[n]</annotation></semantics></math>.</span></p>
</div>
</div>
<div id="S3.SS1.p5" class="ltx_para">
<p id="S3.SS1.p5.1" class="ltx_p">In step 3, we construct a Transformer to approximate the monomials <math id="S3.SS1.p5.m1" class="ltx_Math" alttext="\left(\boldsymbol{X}-\boldsymbol{X}^{(j)}\right)^{\boldsymbol{\alpha}_{i}}" display="inline" intent=":literal"><semantics><msup><mrow><mo>(</mo><mrow><mi>𝑿</mi><mo>−</mo><msup><mi>𝑿</mi><mrow><mo stretchy="false">(</mo><mi>j</mi><mo stretchy="false">)</mo></mrow></msup></mrow><mo>)</mo></mrow><msub><mi>𝜶</mi><mi>i</mi></msub></msup><annotation encoding="application/x-tex">\left(\boldsymbol{X}-\boldsymbol{X}^{(j)}\right)^{\boldsymbol{\alpha}_{i}}</annotation></semantics></math> with the aid of the following two lemmas, whose proofs are deferred to Sections <a href="#S3.SS2" title="3.2 Proof of Lemma ‣ 3 Proof of Proposition : Construction of Transformers ‣ Standard Transformers Achieve the Minimax Rate in Nonparametric Regression with 𝐶^{𝑠,𝜆} Targets" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3.2</span></a> and <a href="#S3.SS3" title="3.3 Proof of Lemma ‣ 3 Proof of Proposition : Construction of Transformers ‣ Standard Transformers Achieve the Minimax Rate in Nonparametric Regression with 𝐶^{𝑠,𝜆} Targets" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3.3</span></a>, respectively.</p>
</div>
<div id="Thmlemma8" class="ltx_theorem ltx_theorem_lemma">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="Thmlemma8.2" class="ltx_text ltx_font_bold">Lemma 8</span></span><span id="Thmlemma8.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="Thmlemma8.p1" class="ltx_para">
<p id="Thmlemma8.p1.1" class="ltx_p"><span id="Thmlemma8.p1.1.1" class="ltx_text ltx_font_italic">For any ReLU FNN <math id="Thmlemma8.p1.m1" class="ltx_Math" alttext="f_{FF}:\mathbb{R}^{dn}\to\mathbb{R}" display="inline" intent=":literal"><semantics><mrow><msub><mi>f</mi><mrow><mi>F</mi><mo lspace="0em" rspace="0em">​</mo><mi>F</mi></mrow></msub><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><msup><mi>ℝ</mi><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow></msup><mo stretchy="false">→</mo><mi>ℝ</mi></mrow></mrow><annotation encoding="application/x-tex">f_{FF}:\mathbb{R}^{dn}\to\mathbb{R}</annotation></semantics></math> with depth <math id="Thmlemma8.p1.m2" class="ltx_Math" alttext="L" display="inline" intent=":literal"><semantics><mi>L</mi><annotation encoding="application/x-tex">L</annotation></semantics></math>, width <math id="Thmlemma8.p1.m3" class="ltx_Math" alttext="W" display="inline" intent=":literal"><semantics><mi>W</mi><annotation encoding="application/x-tex">W</annotation></semantics></math> and weight bound <math id="Thmlemma8.p1.m4" class="ltx_Math" alttext="B" display="inline" intent=":literal"><semantics><mi>B</mi><annotation encoding="application/x-tex">B</annotation></semantics></math>, there exists a Transformer <math id="Thmlemma8.p1.m5" class="ltx_Math" alttext="\boldsymbol{T}^{(FF)}:\mathbb{R}^{(d+n)\times n}\to\mathbb{R}^{1\times n}" display="inline" intent=":literal"><semantics><mrow><msup><mi>𝐓</mi><mrow><mo stretchy="false">(</mo><mrow><mi>F</mi><mo lspace="0em" rspace="0em">​</mo><mi>F</mi></mrow><mo stretchy="false">)</mo></mrow></msup><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><msup><mi>ℝ</mi><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>d</mi><mo>+</mo><mi>n</mi></mrow><mo rspace="0.055em" stretchy="false">)</mo></mrow><mo rspace="0.222em">×</mo><mi>n</mi></mrow></msup><mo stretchy="false">→</mo><msup><mi>ℝ</mi><mrow><mn>1</mn><mo lspace="0.222em" rspace="0.222em">×</mo><mi>n</mi></mrow></msup></mrow></mrow><annotation encoding="application/x-tex">\boldsymbol{T}^{(FF)}:\mathbb{R}^{(d+n)\times n}\to\mathbb{R}^{1\times n}</annotation></semantics></math> with size <math id="Thmlemma8.p1.m6" class="ltx_Math" alttext="\{(2,2dn),(1,dn),(L,\max\{W,2dn\})\}" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">{</mo><mrow><mo stretchy="false">(</mo><mn>2</mn><mo>,</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow><mo stretchy="false">)</mo></mrow><mo>,</mo><mrow><mo stretchy="false">(</mo><mn>1</mn><mo>,</mo><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow><mo stretchy="false">)</mo></mrow><mo>,</mo><mrow><mo stretchy="false">(</mo><mi>L</mi><mo>,</mo><mrow><mi>max</mi><mo>⁡</mo><mrow><mo stretchy="false">{</mo><mi>W</mi><mo>,</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow><mo stretchy="false">}</mo></mrow></mrow><mo stretchy="false">)</mo></mrow><mo stretchy="false">}</mo></mrow><annotation encoding="application/x-tex">\{(2,2dn),(1,dn),(L,\max\{W,2dn\})\}</annotation></semantics></math> and dimension vector <math id="Thmlemma8.p1.m7" class="ltx_Math" alttext="\begin{pmatrix}d+n&amp;d+n&amp;2dn&amp;1\end{pmatrix}" display="inline" intent=":literal"><semantics><mrow><mo>(</mo><mtable columnspacing="5pt"><mtr><mtd><mrow><mi>d</mi><mo>+</mo><mi>n</mi></mrow></mtd><mtd><mrow><mi>d</mi><mo>+</mo><mi>n</mi></mrow></mtd><mtd><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow></mtd><mtd><mn>1</mn></mtd></mtr></mtable><mo>)</mo></mrow><annotation encoding="application/x-tex">\begin{pmatrix}d+n&amp;d+n&amp;2dn&amp;1\end{pmatrix}</annotation></semantics></math> such that for any <math id="Thmlemma8.p1.m8" class="ltx_Math" alttext="\boldsymbol{X}\in[0,1]^{d\times n}" display="inline" intent=":literal"><semantics><mrow><mi>𝐗</mi><mo>∈</mo><msup><mrow><mo stretchy="false">[</mo><mrow><mn>0</mn><mo>,</mo><mn>1</mn></mrow><mo stretchy="false">]</mo></mrow><mrow><mi>d</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>n</mi></mrow></msup></mrow><annotation encoding="application/x-tex">\boldsymbol{X}\in[0,1]^{d\times n}</annotation></semantics></math>,</span></p>
<table id="S3.EGx67" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="S3.Ex100"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S3.Ex100.m1" class="ltx_Math" alttext="\displaystyle\boldsymbol{T}^{(FF)}\left(\begin{pmatrix}\boldsymbol{X}\\
\boldsymbol{I}_{n\times n}-\boldsymbol{1}_{n\times n}\end{pmatrix}\right)=f_{FF}\left(\boldsymbol{X}^{(flt)}\right)\boldsymbol{1}_{1\times n}," display="inline" intent=":literal"><semantics><mrow><mrow><mrow><msup><mi>𝑻</mi><mrow><mo stretchy="false">(</mo><mrow><mi>F</mi><mo lspace="0em" rspace="0em">​</mo><mi>F</mi></mrow><mo stretchy="false">)</mo></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mo>(</mo><mtable rowspacing="0pt"><mtr><mtd><mi>𝑿</mi></mtd></mtr><mtr><mtd><mrow><msub><mi>𝑰</mi><mrow><mi>n</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>n</mi></mrow></msub><mo>−</mo><msub><mn>𝟏</mn><mrow><mi>n</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>n</mi></mrow></msub></mrow></mtd></mtr></mtable><mo>)</mo></mrow><mo>)</mo></mrow></mrow><mo>=</mo><mrow><msub><mi>f</mi><mrow><mi>F</mi><mo lspace="0em" rspace="0em">​</mo><mi>F</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><msup><mi>𝑿</mi><mrow><mo stretchy="false">(</mo><mrow><mi>f</mi><mo lspace="0em" rspace="0em">​</mo><mi>l</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow><mo stretchy="false">)</mo></mrow></msup><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mn>𝟏</mn><mrow><mn>1</mn><mo lspace="0.222em" rspace="0.222em">×</mo><mi>n</mi></mrow></msub></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\boldsymbol{T}^{(FF)}\left(\begin{pmatrix}\boldsymbol{X}\\
\boldsymbol{I}_{n\times n}-\boldsymbol{1}_{n\times n}\end{pmatrix}\right)=f_{FF}\left(\boldsymbol{X}^{(flt)}\right)\boldsymbol{1}_{1\times n},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="Thmlemma8.p1.2" class="ltx_p"><span id="Thmlemma8.p1.2.1" class="ltx_text ltx_font_italic">where <math id="Thmlemma8.p1.m9" class="ltx_Math" alttext="\boldsymbol{X}^{(flt)}\in\mathbb{R}^{dn}" display="inline" intent=":literal"><semantics><mrow><msup><mi>𝐗</mi><mrow><mo stretchy="false">(</mo><mrow><mi>f</mi><mo lspace="0em" rspace="0em">​</mo><mi>l</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow><mo stretchy="false">)</mo></mrow></msup><mo>∈</mo><msup><mi>ℝ</mi><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow></msup></mrow><annotation encoding="application/x-tex">\boldsymbol{X}^{(flt)}\in\mathbb{R}^{dn}</annotation></semantics></math> is the flatten of <math id="Thmlemma8.p1.m10" class="ltx_Math" alttext="\boldsymbol{X}" display="inline" intent=":literal"><semantics><mi>𝐗</mi><annotation encoding="application/x-tex">\boldsymbol{X}</annotation></semantics></math>, defined in the following way:</span></p>
<table id="S3.EGx68" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="S3.Ex101"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S3.Ex101.m1" class="ltx_Math" alttext="\displaystyle\boldsymbol{X}^{(flt)}:=\begin{pmatrix}x_{11}&amp;\dots&amp;x_{1n}&amp;x_{21}&amp;\dots&amp;x_{2n}&amp;\dots&amp;x_{d1}&amp;\dots&amp;x_{dn}\end{pmatrix}^{\top}." display="inline" intent=":literal"><semantics><mrow><mrow><msup><mi>𝑿</mi><mrow><mo stretchy="false">(</mo><mrow><mi>f</mi><mo lspace="0em" rspace="0em">​</mo><mi>l</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow><mo stretchy="false">)</mo></mrow></msup><mo>:=</mo><msup><mrow><mo>(</mo><mtable columnspacing="5pt"><mtr><mtd><msub><mi>x</mi><mn>11</mn></msub></mtd><mtd><mi mathvariant="normal">…</mi></mtd><mtd><msub><mi>x</mi><mrow><mn>1</mn><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow></msub></mtd><mtd><msub><mi>x</mi><mn>21</mn></msub></mtd><mtd><mi mathvariant="normal">…</mi></mtd><mtd><msub><mi>x</mi><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow></msub></mtd><mtd><mi mathvariant="normal">…</mi></mtd><mtd><msub><mi>x</mi><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mn>1</mn></mrow></msub></mtd><mtd><mi mathvariant="normal">…</mi></mtd><mtd><msub><mi>x</mi><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow></msub></mtd></mtr></mtable><mo>)</mo></mrow><mo>⊤</mo></msup></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\boldsymbol{X}^{(flt)}:=\begin{pmatrix}x_{11}&amp;\dots&amp;x_{1n}&amp;x_{21}&amp;\dots&amp;x_{2n}&amp;\dots&amp;x_{d1}&amp;\dots&amp;x_{dn}\end{pmatrix}^{\top}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="Thmlemma8.p1.3" class="ltx_p"><span id="Thmlemma8.p1.3.1" class="ltx_text ltx_font_italic">Furthermore, <math id="Thmlemma8.p1.m11" class="ltx_Math" alttext="B_{FF}=\max\{B,1\},B_{SA}=n" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>B</mi><mrow><mi>F</mi><mo lspace="0em" rspace="0em">​</mo><mi>F</mi></mrow></msub><mo>=</mo><mrow><mi>max</mi><mo>⁡</mo><mrow><mo stretchy="false">{</mo><mi>B</mi><mo>,</mo><mn>1</mn><mo stretchy="false">}</mo></mrow></mrow></mrow><mo>,</mo><mrow><msub><mi>B</mi><mrow><mi>S</mi><mo lspace="0em" rspace="0em">​</mo><mi>A</mi></mrow></msub><mo>=</mo><mi>n</mi></mrow></mrow><annotation encoding="application/x-tex">B_{FF}=\max\{B,1\},B_{SA}=n</annotation></semantics></math>.</span></p>
</div>
</div>
<div id="Thmlemma9" class="ltx_theorem ltx_theorem_lemma">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="Thmlemma9.2" class="ltx_text ltx_font_bold">Lemma 9</span></span><span id="Thmlemma9.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="Thmlemma9.p1" class="ltx_para">
<p id="Thmlemma9.p1.1" class="ltx_p"><span id="Thmlemma9.p1.1.1" class="ltx_text ltx_font_italic">Let <math id="Thmlemma9.p1.m1" class="ltx_Math" alttext="d,s\in\mathbb{N}_{\geq 1}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>d</mi><mo>,</mo><mi>s</mi></mrow><mo>∈</mo><msub><mi>ℕ</mi><mrow><mphantom></mphantom><mo>≥</mo><mn>1</mn></mrow></msub></mrow><annotation encoding="application/x-tex">d,s\in\mathbb{N}_{\geq 1}</annotation></semantics></math>. Let <math id="Thmlemma9.p1.m2" class="ltx_Math" alttext="\boldsymbol{\alpha}\in\mathbb{N}_{\geq 0}^{d}" display="inline" intent=":literal"><semantics><mrow><mi>𝛂</mi><mo>∈</mo><msubsup><mi>ℕ</mi><mrow><mphantom></mphantom><mo>≥</mo><mn>0</mn></mrow><mi>d</mi></msubsup></mrow><annotation encoding="application/x-tex">\boldsymbol{\alpha}\in\mathbb{N}_{\geq 0}^{d}</annotation></semantics></math> and <math id="Thmlemma9.p1.m3" class="ltx_Math" alttext="\sum_{i=1}^{d}\alpha_{i}=\bar{\alpha}" display="inline" intent=":literal"><semantics><mrow><mrow><msubsup><mo>∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>d</mi></msubsup><msub><mi>α</mi><mi>i</mi></msub></mrow><mo>=</mo><mover accent="true"><mi>α</mi><mo>¯</mo></mover></mrow><annotation encoding="application/x-tex">\sum_{i=1}^{d}\alpha_{i}=\bar{\alpha}</annotation></semantics></math>. For any <math id="Thmlemma9.p1.m4" class="ltx_Math" alttext="0&lt;\epsilon\leq\frac{3^{\lceil\log_{2}\bar{\alpha}\rceil}-1}{3^{\lceil\log_{2}\bar{\alpha}\rceil-1}-1}" display="inline" intent=":literal"><semantics><mrow><mn>0</mn><mo>&lt;</mo><mi>ϵ</mi><mo>≤</mo><mfrac><mrow><msup><mn>3</mn><mrow><mo stretchy="false">⌈</mo><mrow><msub><mi>log</mi><mn>2</mn></msub><mo lspace="0.167em">⁡</mo><mover accent="true"><mi>α</mi><mo>¯</mo></mover></mrow><mo stretchy="false">⌉</mo></mrow></msup><mo>−</mo><mn>1</mn></mrow><mrow><msup><mn>3</mn><mrow><mrow><mo stretchy="false">⌈</mo><mrow><msub><mi>log</mi><mn>2</mn></msub><mo lspace="0.167em">⁡</mo><mover accent="true"><mi>α</mi><mo>¯</mo></mover></mrow><mo stretchy="false">⌉</mo></mrow><mo>−</mo><mn>1</mn></mrow></msup><mo>−</mo><mn>1</mn></mrow></mfrac></mrow><annotation encoding="application/x-tex">0&lt;\epsilon\leq\frac{3^{\lceil\log_{2}\bar{\alpha}\rceil}-1}{3^{\lceil\log_{2}\bar{\alpha}\rceil-1}-1}</annotation></semantics></math>, there exists a ReLU FNN function <math id="Thmlemma9.p1.m5" class="ltx_Math" alttext="f_{FF}^{(mnm)}:\mathbb{R}^{d}\to\mathbb{R}" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>f</mi><mrow><mi>F</mi><mo lspace="0em" rspace="0em">​</mo><mi>F</mi></mrow><mrow><mo stretchy="false">(</mo><mrow><mi>m</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><mi>m</mi></mrow><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><msup><mi>ℝ</mi><mi>d</mi></msup><mo stretchy="false">→</mo><mi>ℝ</mi></mrow></mrow><annotation encoding="application/x-tex">f_{FF}^{(mnm)}:\mathbb{R}^{d}\to\mathbb{R}</annotation></semantics></math> with width <math id="Thmlemma9.p1.m6" class="ltx_Math" alttext="21\cdot 2^{\lceil\log_{2}\bar{\alpha}\rceil-1}" display="inline" intent=":literal"><semantics><mrow><mn>21</mn><mo lspace="0.222em" rspace="0.222em">⋅</mo><msup><mn>2</mn><mrow><mrow><mo stretchy="false">⌈</mo><mrow><msub><mi>log</mi><mn>2</mn></msub><mo lspace="0.167em">⁡</mo><mover accent="true"><mi>α</mi><mo>¯</mo></mover></mrow><mo stretchy="false">⌉</mo></mrow><mo>−</mo><mn>1</mn></mrow></msup></mrow><annotation encoding="application/x-tex">21\cdot 2^{\lceil\log_{2}\bar{\alpha}\rceil-1}</annotation></semantics></math>, depth <math id="Thmlemma9.p1.m7" class="ltx_Math" alttext="C\ln\frac{3^{\lceil\log_{2}\bar{\alpha}\rceil}-1}{2\epsilon}" display="inline" intent=":literal"><semantics><mrow><mi>C</mi><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>ln</mi><mo lspace="0.167em">⁡</mo><mfrac><mrow><msup><mn>3</mn><mrow><mo stretchy="false">⌈</mo><mrow><msub><mi>log</mi><mn>2</mn></msub><mo lspace="0.167em">⁡</mo><mover accent="true"><mi>α</mi><mo>¯</mo></mover></mrow><mo stretchy="false">⌉</mo></mrow></msup><mo>−</mo><mn>1</mn></mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>ϵ</mi></mrow></mfrac></mrow></mrow><annotation encoding="application/x-tex">C\ln\frac{3^{\lceil\log_{2}\bar{\alpha}\rceil}-1}{2\epsilon}</annotation></semantics></math> and weight bound <math id="Thmlemma9.p1.m8" class="ltx_Math" alttext="C" display="inline" intent=":literal"><semantics><mi>C</mi><annotation encoding="application/x-tex">C</annotation></semantics></math> such that for any <math id="Thmlemma9.p1.m9" class="ltx_Math" alttext="\boldsymbol{x}\in[0,1]^{d}" display="inline" intent=":literal"><semantics><mrow><mi>𝐱</mi><mo>∈</mo><msup><mrow><mo stretchy="false">[</mo><mrow><mn>0</mn><mo>,</mo><mn>1</mn></mrow><mo stretchy="false">]</mo></mrow><mi>d</mi></msup></mrow><annotation encoding="application/x-tex">\boldsymbol{x}\in[0,1]^{d}</annotation></semantics></math>,</span></p>
<table id="S3.EGx69" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="S3.Ex102"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S3.Ex102.m1" class="ltx_math_unparsed" alttext="\displaystyle\left|f_{FF}^{(mnm)}(\boldsymbol{x})-x_{1}^{\alpha_{1}}x_{2}^{\alpha_{2}}\cdots x_{d}^{\alpha_{d}}\right|\leq\epsilon." display="inline" intent=":literal"><semantics><mrow><mo fence="false" rspace="0.167em">|</mo><msubsup><mi>f</mi><mrow><mi>F</mi><mo lspace="0em" rspace="0em">​</mo><mi>F</mi></mrow><mrow><mo stretchy="false">(</mo><mrow><mi>m</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><mi>m</mi></mrow><mo stretchy="false">)</mo></mrow></msubsup><mrow><mo stretchy="false">(</mo><mi>𝒙</mi><mo stretchy="false">)</mo></mrow><mo>−</mo><msubsup><mi>x</mi><mn>1</mn><msub><mi>α</mi><mn>1</mn></msub></msubsup><msubsup><mi>x</mi><mn>2</mn><msub><mi>α</mi><mn>2</mn></msub></msubsup><mo lspace="0em" rspace="0em">⋯</mo><msubsup><mi>x</mi><mi>d</mi><msub><mi>α</mi><mi>d</mi></msub></msubsup><mo fence="false">|</mo><mo lspace="0.167em">≤</mo><mi>ϵ</mi><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\left|f_{FF}^{(mnm)}(\boldsymbol{x})-x_{1}^{\alpha_{1}}x_{2}^{\alpha_{2}}\cdots x_{d}^{\alpha_{d}}\right|\leq\epsilon.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
</div>
<div id="S3.SS1.p6" class="ltx_para">
<p id="S3.SS1.p6.1" class="ltx_p">In step 4, we contruct a Transformer to parallel <math id="S3.SS1.p6.m1" class="ltx_Math" alttext="c_{i,j}" display="inline" intent=":literal"><semantics><msub><mi>c</mi><mrow><mi>i</mi><mo>,</mo><mi>j</mi></mrow></msub><annotation encoding="application/x-tex">c_{i,j}</annotation></semantics></math> and the appromants of <math id="S3.SS1.p6.m2" class="ltx_Math" alttext="\left(\boldsymbol{X}-\boldsymbol{X}^{(j)}\right)^{\boldsymbol{\alpha}_{i}}" display="inline" intent=":literal"><semantics><msup><mrow><mo>(</mo><mrow><mi>𝑿</mi><mo>−</mo><msup><mi>𝑿</mi><mrow><mo stretchy="false">(</mo><mi>j</mi><mo stretchy="false">)</mo></mrow></msup></mrow><mo>)</mo></mrow><msub><mi>𝜶</mi><mi>i</mi></msub></msup><annotation encoding="application/x-tex">\left(\boldsymbol{X}-\boldsymbol{X}^{(j)}\right)^{\boldsymbol{\alpha}_{i}}</annotation></semantics></math>, followed by contructing a feedforward block that approximates the multiplications of <math id="S3.SS1.p6.m3" class="ltx_Math" alttext="c_{ij}" display="inline" intent=":literal"><semantics><msub><mi>c</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>j</mi></mrow></msub><annotation encoding="application/x-tex">c_{ij}</annotation></semantics></math> and <math id="S3.SS1.p6.m4" class="ltx_Math" alttext="\left(\boldsymbol{X}-\boldsymbol{X}^{(j)}\right)^{\boldsymbol{\alpha}_{i}}" display="inline" intent=":literal"><semantics><msup><mrow><mo>(</mo><mrow><mi>𝑿</mi><mo>−</mo><msup><mi>𝑿</mi><mrow><mo stretchy="false">(</mo><mi>j</mi><mo stretchy="false">)</mo></mrow></msup></mrow><mo>)</mo></mrow><msub><mi>𝜶</mi><mi>i</mi></msub></msup><annotation encoding="application/x-tex">\left(\boldsymbol{X}-\boldsymbol{X}^{(j)}\right)^{\boldsymbol{\alpha}_{i}}</annotation></semantics></math> and sums them over <math id="S3.SS1.p6.m5" class="ltx_Math" alttext="i\in\left[C_{s+dn-1}^{dn-1}\right]" display="inline" intent=":literal"><semantics><mrow><mi>i</mi><mo>∈</mo><mrow><mo>[</mo><msubsup><mi>C</mi><mrow><mrow><mi>s</mi><mo>+</mo><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow></mrow><mo>−</mo><mn>1</mn></mrow><mrow><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow><mo>−</mo><mn>1</mn></mrow></msubsup><mo>]</mo></mrow></mrow><annotation encoding="application/x-tex">i\in\left[C_{s+dn-1}^{dn-1}\right]</annotation></semantics></math> in step 5. We need the following result on the approximation of multiplication by ReLU FNNs in step 5.</p>
</div>
<div id="Thmlemma10" class="ltx_theorem ltx_theorem_lemma">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="Thmlemma10.2" class="ltx_text ltx_font_bold">Lemma 10</span></span><span id="Thmlemma10.3" class="ltx_text ltx_font_bold"> </span>(<cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib57" title="" class="ltx_ref">57</a>]</cite>, Proposition 3)<span id="Thmlemma10.4" class="ltx_text ltx_font_bold">.</span></h6>
<div id="Thmlemma10.p1" class="ltx_para">
<p id="Thmlemma10.p1.1" class="ltx_p"><span id="Thmlemma10.p1.1.1" class="ltx_text ltx_font_italic">Let <math id="Thmlemma10.p1.m1" class="ltx_Math" alttext="B,B^{\prime}\in\mathbb{R}_{\geq 1}" display="inline" intent=":literal"><semantics><mrow><mi>B</mi><mo>,</mo><mrow><msup><mi>B</mi><mo>′</mo></msup><mo>∈</mo><msub><mi>ℝ</mi><mrow><mphantom></mphantom><mo>≥</mo><mn>1</mn></mrow></msub></mrow></mrow><annotation encoding="application/x-tex">B,B^{\prime}\in\mathbb{R}_{\geq 1}</annotation></semantics></math>. For any <math id="Thmlemma10.p1.m2" class="ltx_Math" alttext="\epsilon&gt;0" display="inline" intent=":literal"><semantics><mrow><mi>ϵ</mi><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\epsilon&gt;0</annotation></semantics></math>, there exists a ReLU FNN function <math id="Thmlemma10.p1.m3" class="ltx_Math" alttext="\widetilde{\times}:\mathbb{R}^{2}\to\mathbb{R}" display="inline" intent=":literal"><semantics><mrow><mover accent="true"><mo>×</mo><mo>~</mo></mover><mo lspace="0em" rspace="0.278em">:</mo><mrow><msup><mi>ℝ</mi><mn>2</mn></msup><mo stretchy="false">→</mo><mi>ℝ</mi></mrow></mrow><annotation encoding="application/x-tex">\widetilde{\times}:\mathbb{R}^{2}\to\mathbb{R}</annotation></semantics></math> with width <math id="Thmlemma10.p1.m4" class="ltx_Math" alttext="21" display="inline" intent=":literal"><semantics><mn>21</mn><annotation encoding="application/x-tex">21</annotation></semantics></math>, depth <math id="Thmlemma10.p1.m5" class="ltx_Math" alttext="C(B)\ln\frac{1}{\epsilon}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>C</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>B</mi><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>ln</mi><mo lspace="0.167em">⁡</mo><mfrac><mn>1</mn><mi>ϵ</mi></mfrac></mrow></mrow><annotation encoding="application/x-tex">C(B)\ln\frac{1}{\epsilon}</annotation></semantics></math> and weight bound <math id="Thmlemma10.p1.m6" class="ltx_Math" alttext="B^{2}" display="inline" intent=":literal"><semantics><msup><mi>B</mi><mn>2</mn></msup><annotation encoding="application/x-tex">B^{2}</annotation></semantics></math> such that for any <math id="Thmlemma10.p1.m7" class="ltx_Math" alttext="\boldsymbol{x}\in[-B,B]^{2}" display="inline" intent=":literal"><semantics><mrow><mi>𝐱</mi><mo>∈</mo><msup><mrow><mo stretchy="false">[</mo><mrow><mrow><mo>−</mo><mi>B</mi></mrow><mo>,</mo><mi>B</mi></mrow><mo stretchy="false">]</mo></mrow><mn>2</mn></msup></mrow><annotation encoding="application/x-tex">\boldsymbol{x}\in[-B,B]^{2}</annotation></semantics></math>,</span></p>
<table id="S3.EGx70" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="S3.Ex103"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S3.Ex103.m1" class="ltx_Math" alttext="\displaystyle\left|\widetilde{\times}(\boldsymbol{x})-x_{1}x_{2}\right|\leq\epsilon." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mo>|</mo><mrow><mrow><mover accent="true"><mo lspace="0em">×</mo><mo>~</mo></mover><mo lspace="0.222em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝒙</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msub><mi>x</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>x</mi><mn>2</mn></msub></mrow></mrow><mo>|</mo></mrow><mo>≤</mo><mi>ϵ</mi></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\left|\widetilde{\times}(\boldsymbol{x})-x_{1}x_{2}\right|\leq\epsilon.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="Thmlemma10.p1.2" class="ltx_p"><span id="Thmlemma10.p1.2.1" class="ltx_text ltx_font_italic">Furthermore, for any <math id="Thmlemma10.p1.m8" class="ltx_Math" alttext="\boldsymbol{x}\in[-B^{\prime},B^{\prime}]^{2}" display="inline" intent=":literal"><semantics><mrow><mi>𝐱</mi><mo>∈</mo><msup><mrow><mo stretchy="false">[</mo><mrow><mrow><mo>−</mo><msup><mi>B</mi><mo>′</mo></msup></mrow><mo>,</mo><msup><mi>B</mi><mo>′</mo></msup></mrow><mo stretchy="false">]</mo></mrow><mn>2</mn></msup></mrow><annotation encoding="application/x-tex">\boldsymbol{x}\in[-B^{\prime},B^{\prime}]^{2}</annotation></semantics></math>, <math id="Thmlemma10.p1.m9" class="ltx_Math" alttext="\left|\widetilde{\times}(\boldsymbol{x})\right|\leq\max\{12B^{2},4BB^{\prime}\}" display="inline" intent=":literal"><semantics><mrow><mrow><mo>|</mo><mrow><mover accent="true"><mo lspace="0em">×</mo><mo>~</mo></mover><mo lspace="0.222em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐱</mi><mo stretchy="false">)</mo></mrow></mrow><mo>|</mo></mrow><mo>≤</mo><mrow><mi>max</mi><mo>⁡</mo><mrow><mo stretchy="false">{</mo><mrow><mn>12</mn><mo lspace="0em" rspace="0em">​</mo><msup><mi>B</mi><mn>2</mn></msup></mrow><mo>,</mo><mrow><mn>4</mn><mo lspace="0em" rspace="0em">​</mo><mi>B</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>B</mi><mo>′</mo></msup></mrow><mo stretchy="false">}</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\left|\widetilde{\times}(\boldsymbol{x})\right|\leq\max\{12B^{2},4BB^{\prime}\}</annotation></semantics></math>.</span></p>
</div>
</div>
<div id="Thmremark1" class="ltx_theorem ltx_theorem_remark">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="Thmremark1.2" class="ltx_text ltx_font_bold">Remark 1</span></span><span id="Thmremark1.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="Thmremark1.p1" class="ltx_para">
<p id="Thmremark1.p1.1" class="ltx_p"><span id="Thmremark1.p1.1.1" class="ltx_text ltx_font_italic">Although <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib57" title="" class="ltx_ref">57</a>]</cite> does not explicitly characterize the width, weight bound, and magnitude of <math id="Thmremark1.p1.m1" class="ltx_Math" alttext="\widetilde{\times}" display="inline" intent=":literal"><semantics><mover accent="true"><mo>×</mo><mo>~</mo></mover><annotation encoding="application/x-tex">\widetilde{\times}</annotation></semantics></math>, these can be readily derived from its proof and arguments.</span></p>
</div>
</div>
<div id="S3.SS1.p7" class="ltx_para">
<p id="S3.SS1.p7.1" class="ltx_p">Finally, in step 6 and 7, by properly setting the values of parameters, we estimate the approximation error on <math id="S3.SS1.p7.m1" class="ltx_Math" alttext="\bigcup_{j\in[K^{dn}]}\Omega_{j}" display="inline" intent=":literal"><semantics><mrow><msub><mo>⋃</mo><mrow><mi>j</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><msup><mi>K</mi><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow></msup><mo stretchy="false">]</mo></mrow></mrow></msub><msub><mi mathvariant="normal">Ω</mi><mi>j</mi></msub></mrow><annotation encoding="application/x-tex">\bigcup_{j\in[K^{dn}]}\Omega_{j}</annotation></semantics></math> and the magnitude of constructed Transformer on <math id="S3.SS1.p7.m2" class="ltx_Math" alttext="\Omega^{(flaw)}" display="inline" intent=":literal"><semantics><msup><mi mathvariant="normal">Ω</mi><mrow><mo stretchy="false">(</mo><mrow><mi>f</mi><mo lspace="0em" rspace="0em">​</mo><mi>l</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi><mo lspace="0em" rspace="0em">​</mo><mi>w</mi></mrow><mo stretchy="false">)</mo></mrow></msup><annotation encoding="application/x-tex">\Omega^{(flaw)}</annotation></semantics></math>, resepctively. Figure <a href="#S3.F1" title="Figure 1 ‣ 3.1 Proof of Proposition ‣ 3 Proof of Proposition : Construction of Transformers ‣ Standard Transformers Achieve the Minimax Rate in Nonparametric Regression with 𝐶^{𝑠,𝜆} Targets" class="ltx_ref"><span class="ltx_text ltx_ref_tag">1</span></a> illustrates the flow of the proof for Proposition <a href="#Thmproposition1" title="Proposition 1. ‣ 2.1 Proof of Theorem ‣ 2 Proofs of Main Results ‣ Standard Transformers Achieve the Minimax Rate in Nonparametric Regression with 𝐶^{𝑠,𝜆} Targets" class="ltx_ref"><span class="ltx_text ltx_ref_tag">1</span></a>.</p>
</div>
<figure id="S3.F1" class="ltx_figure"><span class="ltx_inline-block"><svg id="S3.F1.pic1" class="ltx_picture ltx_centering" height="326.74" overflow="visible" version="1.1" viewBox="0 0 435.37 326.74" width="435.37"><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" stroke-width="0.4pt" transform="translate(0,326.74) matrix(1 0 0 -1 0 0) translate(186.41,0) translate(0,315.08)"><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 24.4 -4.75)"><foreignObject style="--ltx-fo-width:1.03em;--ltx-fo-height:0.69em;--ltx-fo-depth:0em;font-size:10pt;" height="9.49" overflow="visible" transform="matrix(1 0 0 -1 0 9.49)" width="14.18"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S3.F1.pic1.m1" class="ltx_Math" alttext="\boldsymbol{X}" display="inline" intent=":literal"><semantics><mi>𝑿</mi><annotation encoding="application/x-tex">\boldsymbol{X}</annotation></semantics></math></span></span></foreignObject></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 17.17 -70.79)"><foreignObject style="--ltx-fo-width:2.07em;--ltx-fo-height:0.89em;--ltx-fo-depth:0em;font-size:10pt;" height="12.29" overflow="visible" transform="matrix(1 0 0 -1 0 12.29)" width="28.66"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S3.F1.pic1.m2" class="ltx_Math" alttext="\boldsymbol{X}^{(j)}" display="inline" intent=":literal"><semantics><msup><mi>𝑿</mi><mrow><mo stretchy="false">(</mo><mi>j</mi><mo stretchy="false">)</mo></mrow></msup><annotation encoding="application/x-tex">\boldsymbol{X}^{(j)}</annotation></semantics></math></span></span></foreignObject></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 -179.49 -168.34)"><foreignObject style="--ltx-fo-width:10.33em;--ltx-fo-height:0.89em;--ltx-fo-depth:0.49em;font-size:10pt;" height="19.12" overflow="visible" transform="matrix(1 0 0 -1 0 12.29)" width="142.9"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S3.F1.pic1.m3" class="ltx_Math" alttext="\left\{\left(\boldsymbol{X}-\boldsymbol{X}^{(j)}\right)^{\boldsymbol{\alpha}_{i}}\right\}_{i\in\left[C_{s+dn-1}^{dn-1}\right]}" display="inline" intent=":literal"><semantics><msub><mrow><mo>{</mo><msup><mrow><mo>(</mo><mrow><mi>𝑿</mi><mo>−</mo><msup><mi>𝑿</mi><mrow><mo stretchy="false">(</mo><mi>j</mi><mo stretchy="false">)</mo></mrow></msup></mrow><mo>)</mo></mrow><msub><mi>𝜶</mi><mi>i</mi></msub></msup><mo>}</mo></mrow><mrow><mi>i</mi><mo>∈</mo><mrow><mo>[</mo><msubsup><mi>C</mi><mrow><mrow><mi>s</mi><mo>+</mo><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow></mrow><mo>−</mo><mn>1</mn></mrow><mrow><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow><mo>−</mo><mn>1</mn></mrow></msubsup><mo>]</mo></mrow></mrow></msub><annotation encoding="application/x-tex">\left\{\left(\boldsymbol{X}-\boldsymbol{X}^{(j)}\right)^{\boldsymbol{\alpha}_{i}}\right\}_{i\in\left[C_{s+dn-1}^{dn-1}\right]}</annotation></semantics></math></span></span></foreignObject></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 150.77 -170.36)"><foreignObject style="--ltx-fo-width:6.6em;--ltx-fo-height:0.75em;--ltx-fo-depth:0.49em;font-size:10pt;" height="17.21" overflow="visible" transform="matrix(1 0 0 -1 0 10.38)" width="91.27"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S3.F1.pic1.m4" class="ltx_Math" alttext="\left\{c_{i,j}\right\}_{i\in\left[C_{s+dn-1}^{dn-1}\right]}" display="inline" intent=":literal"><semantics><msub><mrow><mo>{</mo><msub><mi>c</mi><mrow><mi>i</mi><mo>,</mo><mi>j</mi></mrow></msub><mo>}</mo></mrow><mrow><mi>i</mi><mo>∈</mo><mrow><mo>[</mo><msubsup><mi>C</mi><mrow><mrow><mi>s</mi><mo>+</mo><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow></mrow><mo>−</mo><mn>1</mn></mrow><mrow><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow><mo>−</mo><mn>1</mn></mrow></msubsup><mo>]</mo></mrow></mrow></msub><annotation encoding="application/x-tex">\left\{c_{i,j}\right\}_{i\in\left[C_{s+dn-1}^{dn-1}\right]}</annotation></semantics></math></span></span></foreignObject></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 -65.39 -294.32)"><foreignObject style="--ltx-fo-width:14em;--ltx-fo-height:0.89em;--ltx-fo-depth:1em;font-size:10pt;" height="26.12" overflow="visible" transform="matrix(1 0 0 -1 0 12.29)" width="193.77"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S3.F1.pic1.m5" class="ltx_Math" alttext="P_{j}=\sum_{i\in\left[C_{s+dn-1}^{dn-1}\right]}c_{i,j}\left(\boldsymbol{X}-\boldsymbol{X}^{(j)}\right)^{\boldsymbol{\alpha}_{i}}" display="inline" intent=":literal"><semantics><mrow><msub><mi>P</mi><mi>j</mi></msub><mo rspace="0.111em">=</mo><mrow><msub><mo>∑</mo><mrow><mi>i</mi><mo>∈</mo><mrow><mo>[</mo><msubsup><mi>C</mi><mrow><mrow><mi>s</mi><mo>+</mo><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow></mrow><mo>−</mo><mn>1</mn></mrow><mrow><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow><mo>−</mo><mn>1</mn></mrow></msubsup><mo>]</mo></mrow></mrow></msub><mrow><msub><mi>c</mi><mrow><mi>i</mi><mo>,</mo><mi>j</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo>(</mo><mrow><mi>𝑿</mi><mo>−</mo><msup><mi>𝑿</mi><mrow><mo stretchy="false">(</mo><mi>j</mi><mo stretchy="false">)</mo></mrow></msup></mrow><mo>)</mo></mrow><msub><mi>𝜶</mi><mi>i</mi></msub></msup></mrow></mrow></mrow><annotation encoding="application/x-tex">P_{j}=\sum_{i\in\left[C_{s+dn-1}^{dn-1}\right]}c_{i,j}\left(\boldsymbol{X}-\boldsymbol{X}^{(j)}\right)^{\boldsymbol{\alpha}_{i}}</annotation></semantics></math></span></span></foreignObject></g><g stroke-width="0.8pt"><path style="fill:none" d="M 31.5 -11.94 L 31.5 -45.35"></path><g stroke-dasharray="none" stroke-dashoffset="0.0pt" stroke-linejoin="miter" transform="matrix(0.0 -1.0 1.0 0.0 31.5 -42.18)"><path d="M 7.66 0 L 1.79 2.18 L 3.45 0 L 1.79 -2.18 Z"></path></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 38.97 -35.09)"><foreignObject style="--ltx-fo-width:3.57em;--ltx-fo-height:0.68em;--ltx-fo-depth:0em;font-size:10pt;" height="9.46" overflow="visible" transform="matrix(1 0 0 -1 0 9.46)" width="49.39"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><span id="S3.F1.pic1.1" class="ltx_text">Lemma <a href="#Thmlemma6" title="Lemma 6. ‣ 3.1 Proof of Proposition ‣ 3 Proof of Proposition : Construction of Transformers ‣ Standard Transformers Achieve the Minimax Rate in Nonparametric Regression with 𝐶^{𝑠,𝜆} Targets" class="ltx_ref"><span class="ltx_text ltx_ref_tag">6</span></a></span></span></span></foreignObject></g></g><g stroke-width="0.8pt"><path style="fill:none" d="M 31.5 -77.99 L -102.73 -146.16"></path><g stroke-dasharray="none" stroke-dashoffset="0.0pt" stroke-linejoin="miter" transform="matrix(-0.89162 -0.4528 0.4528 -0.89162 -99.9 -144.72)"><path d="M 7.66 0 L 1.79 2.18 L 3.45 0 L 1.79 -2.18 Z"></path></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 -140.47 -116.88)"><foreignObject style="--ltx-fo-width:4.18em;--ltx-fo-height:0.66em;--ltx-fo-depth:0.19em;font-size:9.25pt;" height="10.93" overflow="visible" transform="matrix(1 0 0 -1 0 8.51)" width="53.51"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><span id="S3.F1.pic1.2" class="ltx_text" style="font-size:90%;">Lemma <a href="#Thmlemma8" title="Lemma 8. ‣ 3.1 Proof of Proposition ‣ 3 Proof of Proposition : Construction of Transformers ‣ Standard Transformers Achieve the Minimax Rate in Nonparametric Regression with 𝐶^{𝑠,𝜆} Targets" class="ltx_ref"><span class="ltx_text ltx_ref_tag">8</span></a>, <a href="#Thmlemma9" title="Lemma 9. ‣ 3.1 Proof of Proposition ‣ 3 Proof of Proposition : Construction of Transformers ‣ Standard Transformers Achieve the Minimax Rate in Nonparametric Regression with 𝐶^{𝑠,𝜆} Targets" class="ltx_ref"><span class="ltx_text ltx_ref_tag">9</span></a></span></span></span></foreignObject></g></g><g stroke-width="0.8pt"><path style="fill:none" d="M 31.5 -77.99 L 190.98 -150.33"></path><g stroke-dasharray="none" stroke-dashoffset="0.0pt" stroke-linejoin="miter" transform="matrix(0.91069 -0.41309 0.41309 0.91069 188.09 -149.02)"><path d="M 7.66 0 L 1.79 2.18 L 3.45 0 L 1.79 -2.18 Z"></path></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 145.04 -118.85)"><foreignObject style="--ltx-fo-width:3.57em;--ltx-fo-height:0.66em;--ltx-fo-depth:0em;font-size:9.25pt;" height="8.51" overflow="visible" transform="matrix(1 0 0 -1 0 8.51)" width="45.69"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><span id="S3.F1.pic1.3" class="ltx_text" style="font-size:90%;">Lemma <a href="#Thmlemma7" title="Lemma 7. ‣ 3.1 Proof of Proposition ‣ 3 Proof of Proposition : Construction of Transformers ‣ Standard Transformers Achieve the Minimax Rate in Nonparametric Regression with 𝐶^{𝑠,𝜆} Targets" class="ltx_ref"><span class="ltx_text ltx_ref_tag">7</span></a></span></span></span></foreignObject></g></g><g stroke-width="0.8pt"><path style="fill:none" d="M -108.04 -182.37 L 15.59 -271.36"></path><g stroke-dasharray="none" stroke-dashoffset="0.0pt" stroke-linejoin="miter" transform="matrix(0.81161 -0.5842 0.5842 0.81161 13.01 -269.5)"><path d="M 7.66 0 L 1.79 2.18 L 3.45 0 L 1.79 -2.18 Z"></path></g></g><g stroke-width="0.8pt"><path style="fill:none" d="M 196.4 -184.4 L 47.7 -271.82"></path><g stroke-dasharray="none" stroke-dashoffset="0.0pt" stroke-linejoin="miter" transform="matrix(-0.86206 -0.5068 0.5068 -0.86206 50.44 -270.21)"><path d="M 7.66 0 L 1.79 2.18 L 3.45 0 L 1.79 -2.18 Z"></path></g></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 9.61 -232.57)"><foreignObject style="--ltx-fo-width:3.57em;--ltx-fo-height:0.66em;--ltx-fo-depth:0em;font-size:9.25pt;" height="8.51" overflow="visible" transform="matrix(1 0 0 -1 0 8.51)" width="45.69"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><span id="S3.F1.pic1.4" class="ltx_text" style="font-size:90%;">Lemma <a href="#Thmlemma10" title="Lemma 10 ([], Proposition 3). ‣ 3.1 Proof of Proposition ‣ 3 Proof of Proposition : Construction of Transformers ‣ Standard Transformers Achieve the Minimax Rate in Nonparametric Regression with 𝐶^{𝑠,𝜆} Targets" class="ltx_ref"><span class="ltx_text ltx_ref_tag">10</span></a></span></span></span></foreignObject></g></g></svg></span>
<figcaption class="ltx_caption ltx_centering"><span class="ltx_tag ltx_tag_figure">Figure 1: </span>Illustration of the proof process</figcaption>
</figure>
<div id="S3.SS1.p8" class="ltx_para">
<p id="S3.SS1.p8.1" class="ltx_p">In the proof of Proposition <a href="#Thmproposition1" title="Proposition 1. ‣ 2.1 Proof of Theorem ‣ 2 Proofs of Main Results ‣ Standard Transformers Achieve the Minimax Rate in Nonparametric Regression with 𝐶^{𝑠,𝜆} Targets" class="ltx_ref"><span class="ltx_text ltx_ref_tag">1</span></a>, we also require the following two trivial lemmas, which state that both the feedforward block and the self-attention layer can realize the identity mapping. We may sometimes use these two lemmas without explicit mention, particularly when we employ Lemma <a href="#Thmlemma3" title="Lemma 3. ‣ 2.2 Proof of Theorem ‣ 2 Proofs of Main Results ‣ Standard Transformers Achieve the Minimax Rate in Nonparametric Regression with 𝐶^{𝑠,𝜆} Targets" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3</span></a> to parallel two feedforward blocks of different depths.</p>
</div>
<div id="Thmlemma11" class="ltx_theorem ltx_theorem_lemma">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="Thmlemma11.2" class="ltx_text ltx_font_bold">Lemma 11</span></span><span id="Thmlemma11.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="Thmlemma11.p1" class="ltx_para">
<p id="Thmlemma11.p1.1" class="ltx_p"><span id="Thmlemma11.p1.1.1" class="ltx_text ltx_font_italic">There exists a ReLU FNN function <math id="Thmlemma11.p1.m1" class="ltx_Math" alttext="f_{FF}^{(idt)}:\mathbb{R}\to\mathbb{R}" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>f</mi><mrow><mi>F</mi><mo lspace="0em" rspace="0em">​</mo><mi>F</mi></mrow><mrow><mo stretchy="false">(</mo><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi>ℝ</mi><mo stretchy="false">→</mo><mi>ℝ</mi></mrow></mrow><annotation encoding="application/x-tex">f_{FF}^{(idt)}:\mathbb{R}\to\mathbb{R}</annotation></semantics></math> with width <math id="Thmlemma11.p1.m2" class="ltx_Math" alttext="2" display="inline" intent=":literal"><semantics><mn>2</mn><annotation encoding="application/x-tex">2</annotation></semantics></math>, depth <math id="Thmlemma11.p1.m3" class="ltx_Math" alttext="2" display="inline" intent=":literal"><semantics><mn>2</mn><annotation encoding="application/x-tex">2</annotation></semantics></math> and weight bound <math id="Thmlemma11.p1.m4" class="ltx_Math" alttext="1" display="inline" intent=":literal"><semantics><mn>1</mn><annotation encoding="application/x-tex">1</annotation></semantics></math> such that for any <math id="Thmlemma11.p1.m5" class="ltx_Math" alttext="{x}\in\mathbb{R}" display="inline" intent=":literal"><semantics><mrow><mi>x</mi><mo>∈</mo><mi>ℝ</mi></mrow><annotation encoding="application/x-tex">{x}\in\mathbb{R}</annotation></semantics></math>,</span></p>
<table id="S3.EGx71" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="S3.Ex104"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S3.Ex104.m1" class="ltx_Math" alttext="\displaystyle f_{FF}^{(idt)}(x)=x." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><msubsup><mi>f</mi><mrow><mi>F</mi><mo lspace="0em" rspace="0em">​</mo><mi>F</mi></mrow><mrow><mo stretchy="false">(</mo><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mi>x</mi></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle f_{FF}^{(idt)}(x)=x.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
</div>
<div id="S3.SS1.3" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="S3.SS1.p9" class="ltx_para">
<p id="S3.SS1.p9.1" class="ltx_p"><span id="S3.SS1.p9.1.1" class="ltx_text">The result follows directly from the property</span></p>
<table id="S3.EGx72" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="S3.Ex105"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S3.Ex105.m1" class="ltx_Math" alttext="\displaystyle x=\sigma_{R}(x)-\sigma_{R}(-x),\quad x\in\mathbb{R}." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mi>x</mi><mo>=</mo><mrow><mrow><msub><mi>σ</mi><mi>R</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msub><mi>σ</mi><mi>R</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mo>−</mo><mi>x</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo rspace="1.167em">,</mo><mrow><mi>x</mi><mo>∈</mo><mi>ℝ</mi></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle x=\sigma_{R}(x)-\sigma_{R}(-x),\quad x\in\mathbb{R}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S3.SS1.p9.2" class="ltx_p"><span id="S3.SS1.p9.2.1" class="ltx_text">∎</span></p>
</div>
</div>
<div id="Thmlemma12" class="ltx_theorem ltx_theorem_lemma">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="Thmlemma12.2" class="ltx_text ltx_font_bold">Lemma 12</span></span><span id="Thmlemma12.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="Thmlemma12.p1" class="ltx_para">
<p id="Thmlemma12.p1.1" class="ltx_p"><span id="Thmlemma12.p1.1.1" class="ltx_text ltx_font_italic">There exists a self-attention layer <math id="Thmlemma12.p1.m1" class="ltx_Math" alttext="\boldsymbol{\mathcal{F}}_{SA}^{(idt)}:\mathbb{R}^{1\times n}\to\mathbb{R}^{1\times n}" display="inline" intent=":literal"><semantics><mrow><msubsup><mi class="ltx_font_mathcaligraphic">𝓕</mi><mrow><mi>S</mi><mo lspace="0em" rspace="0em">​</mo><mi>A</mi></mrow><mrow><mo stretchy="false">(</mo><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><msup><mi>ℝ</mi><mrow><mn>1</mn><mo lspace="0.222em" rspace="0.222em">×</mo><mi>n</mi></mrow></msup><mo stretchy="false">→</mo><msup><mi>ℝ</mi><mrow><mn>1</mn><mo lspace="0.222em" rspace="0.222em">×</mo><mi>n</mi></mrow></msup></mrow></mrow><annotation encoding="application/x-tex">\boldsymbol{\mathcal{F}}_{SA}^{(idt)}:\mathbb{R}^{1\times n}\to\mathbb{R}^{1\times n}</annotation></semantics></math> with head number <math id="Thmlemma12.p1.m2" class="ltx_Math" alttext="1" display="inline" intent=":literal"><semantics><mn>1</mn><annotation encoding="application/x-tex">1</annotation></semantics></math>, head size <math id="Thmlemma12.p1.m3" class="ltx_Math" alttext="1" display="inline" intent=":literal"><semantics><mn>1</mn><annotation encoding="application/x-tex">1</annotation></semantics></math> and weight bound <math id="Thmlemma12.p1.m4" class="ltx_Math" alttext="1" display="inline" intent=":literal"><semantics><mn>1</mn><annotation encoding="application/x-tex">1</annotation></semantics></math> such that for any <math id="Thmlemma12.p1.m5" class="ltx_Math" alttext="\boldsymbol{x}\in\mathbb{R}^{1\times n}" display="inline" intent=":literal"><semantics><mrow><mi>𝐱</mi><mo>∈</mo><msup><mi>ℝ</mi><mrow><mn>1</mn><mo lspace="0.222em" rspace="0.222em">×</mo><mi>n</mi></mrow></msup></mrow><annotation encoding="application/x-tex">\boldsymbol{x}\in\mathbb{R}^{1\times n}</annotation></semantics></math>,</span></p>
<table id="S3.EGx73" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="S3.Ex106"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S3.Ex106.m1" class="ltx_Math" alttext="\displaystyle\boldsymbol{\mathcal{F}}_{SA}^{(idt)}\left(\boldsymbol{x}\right)=\boldsymbol{x}." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><msubsup><mi class="ltx_font_mathcaligraphic">𝓕</mi><mrow><mi>S</mi><mo lspace="0em" rspace="0em">​</mo><mi>A</mi></mrow><mrow><mo stretchy="false">(</mo><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mi>𝒙</mi><mo>)</mo></mrow></mrow><mo>=</mo><mi>𝒙</mi></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\boldsymbol{\mathcal{F}}_{SA}^{(idt)}\left(\boldsymbol{x}\right)=\boldsymbol{x}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
</div>
<div id="S3.SS1.4" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="S3.SS1.p10" class="ltx_para">
<p id="S3.SS1.p10.1" class="ltx_p"><span id="S3.SS1.p10.1.1" class="ltx_text">Setting <math id="S3.SS1.p10.m1" class="ltx_Math" alttext="\boldsymbol{W}_{O}=0" display="inline" intent=":literal"><semantics><mrow><msub><mi>𝑾</mi><mi>O</mi></msub><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\boldsymbol{W}_{O}=0</annotation></semantics></math> yields the result.
∎</span></p>
</div>
</div>
<div id="S3.SS1.p11" class="ltx_para">
<p id="S3.SS1.p11.1" class="ltx_p">We now present the formal proof of Proposition <a href="#Thmproposition1" title="Proposition 1. ‣ 2.1 Proof of Theorem ‣ 2 Proofs of Main Results ‣ Standard Transformers Achieve the Minimax Rate in Nonparametric Regression with 𝐶^{𝑠,𝜆} Targets" class="ltx_ref"><span class="ltx_text ltx_ref_tag">1</span></a>.</p>
</div>
<div id="S3.SS1.5" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof of Proposition <a href="#Thmproposition1" title="Proposition 1. ‣ 2.1 Proof of Theorem ‣ 2 Proofs of Main Results ‣ Standard Transformers Achieve the Minimax Rate in Nonparametric Regression with 𝐶^{𝑠,𝜆} Targets" class="ltx_ref"><span class="ltx_text ltx_ref_tag">1</span></a>.</h6>
<div id="S3.SS1.p12" class="ltx_para">
<p id="S3.SS1.p12.1" class="ltx_p"><span id="S3.SS1.p12.1.1" class="ltx_text ltx_font_bold">Step 1: Map <math id="S3.SS1.p12.m1" class="ltx_Math" alttext="\Omega_{j}" display="inline" intent=":literal"><semantics><msub><mi mathvariant="normal">Ω</mi><mi>j</mi></msub><annotation encoding="application/x-tex">\Omega_{j}</annotation></semantics></math> to the grid point <math id="S3.SS1.p12.m2" class="ltx_Math" alttext="\boldsymbol{X}^{(j)}={\boldsymbol{\beta}_{j}}/{K}" display="inline" intent=":literal"><semantics><mrow><msup><mi>X</mi><mrow><mo stretchy="false">(</mo><mi>j</mi><mo stretchy="false">)</mo></mrow></msup><mo>=</mo><mrow><msub><mi>β</mi><mi>j</mi></msub><mo>/</mo><mi>K</mi></mrow></mrow><annotation encoding="application/x-tex">\boldsymbol{X}^{(j)}={\boldsymbol{\beta}_{j}}/{K}</annotation></semantics></math>.<span id="S3.SS1.p12.1.1.1" class="ltx_text"></span></span></p>
</div>
<div id="S3.SS1.p13" class="ltx_para">
<p id="S3.SS1.p13.1" class="ltx_p"><span id="S3.SS1.p13.1.1" class="ltx_text">Denote</span></p>
<table id="S3.EGx74" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="S3.Ex107"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S3.Ex107.m1" class="ltx_Math" alttext="\displaystyle\boldsymbol{W}_{EB}:=\begin{pmatrix}\boldsymbol{I}_{d\times d}\\
\boldsymbol{0}_{(n+1)\times d}\end{pmatrix}\in\mathbb{R}^{(d+n+1)\times d},\quad\boldsymbol{B}_{EB}:=\begin{pmatrix}\boldsymbol{0}_{d\times n}\\
\boldsymbol{I}_{n\times n}-\boldsymbol{1}_{n\times n}\\
\boldsymbol{\widetilde{B}}_{EB}\end{pmatrix}\in\mathbb{R}^{(d+n+1)\times n}," display="inline" intent=":literal"><semantics><mrow><mrow><mrow><msub><mi>𝑾</mi><mrow><mi>E</mi><mo lspace="0em" rspace="0em">​</mo><mi>B</mi></mrow></msub><mo>:=</mo><mrow><mo>(</mo><mtable rowspacing="0pt"><mtr><mtd><msub><mi>𝑰</mi><mrow><mi>d</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>d</mi></mrow></msub></mtd></mtr><mtr><mtd><msub><mn>𝟎</mn><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>n</mi><mo>+</mo><mn>1</mn></mrow><mo rspace="0.055em" stretchy="false">)</mo></mrow><mo rspace="0.222em">×</mo><mi>d</mi></mrow></msub></mtd></mtr></mtable><mo>)</mo></mrow><mo>∈</mo><msup><mi>ℝ</mi><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>d</mi><mo>+</mo><mi>n</mi><mo>+</mo><mn>1</mn></mrow><mo rspace="0.055em" stretchy="false">)</mo></mrow><mo rspace="0.222em">×</mo><mi>d</mi></mrow></msup></mrow><mo rspace="1.167em">,</mo><mrow><msub><mi>𝑩</mi><mrow><mi>E</mi><mo lspace="0em" rspace="0em">​</mo><mi>B</mi></mrow></msub><mo>:=</mo><mrow><mo>(</mo><mtable rowspacing="0pt"><mtr><mtd><msub><mn>𝟎</mn><mrow><mi>d</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>n</mi></mrow></msub></mtd></mtr><mtr><mtd><mrow><msub><mi>𝑰</mi><mrow><mi>n</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>n</mi></mrow></msub><mo>−</mo><msub><mn>𝟏</mn><mrow><mi>n</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>n</mi></mrow></msub></mrow></mtd></mtr><mtr><mtd><msub><mover accent="true"><mi>𝑩</mi><mo>~</mo></mover><mrow><mi>E</mi><mo lspace="0em" rspace="0em">​</mo><mi>B</mi></mrow></msub></mtd></mtr></mtable><mo>)</mo></mrow><mo>∈</mo><msup><mi>ℝ</mi><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>d</mi><mo>+</mo><mi>n</mi><mo>+</mo><mn>1</mn></mrow><mo rspace="0.055em" stretchy="false">)</mo></mrow><mo rspace="0.222em">×</mo><mi>n</mi></mrow></msup></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\boldsymbol{W}_{EB}:=\begin{pmatrix}\boldsymbol{I}_{d\times d}\\
\boldsymbol{0}_{(n+1)\times d}\end{pmatrix}\in\mathbb{R}^{(d+n+1)\times d},\quad\boldsymbol{B}_{EB}:=\begin{pmatrix}\boldsymbol{0}_{d\times n}\\
\boldsymbol{I}_{n\times n}-\boldsymbol{1}_{n\times n}\\
\boldsymbol{\widetilde{B}}_{EB}\end{pmatrix}\in\mathbb{R}^{(d+n+1)\times n},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S3.SS1.p13.2" class="ltx_p"><span id="S3.SS1.p13.2.1" class="ltx_text">where</span></p>
<table id="S3.EGx75" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="S3.Ex108"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S3.Ex108.m1" class="ltx_Math" alttext="\displaystyle\boldsymbol{\widetilde{B}}_{EB}:=\begin{pmatrix}3&amp;6&amp;\cdots&amp;3n\end{pmatrix}\in\mathbb{R}^{1\times n}." display="inline" intent=":literal"><semantics><mrow><mrow><msub><mover accent="true"><mi>𝑩</mi><mo>~</mo></mover><mrow><mi>E</mi><mo lspace="0em" rspace="0em">​</mo><mi>B</mi></mrow></msub><mo>:=</mo><mrow><mo>(</mo><mtable columnspacing="5pt"><mtr><mtd><mn>3</mn></mtd><mtd><mn>6</mn></mtd><mtd><mo>⋯</mo></mtd><mtd><mrow><mn>3</mn><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow></mtd></mtr></mtable><mo>)</mo></mrow><mo>∈</mo><msup><mi>ℝ</mi><mrow><mn>1</mn><mo lspace="0.222em" rspace="0.222em">×</mo><mi>n</mi></mrow></msup></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\boldsymbol{\widetilde{B}}_{EB}:=\begin{pmatrix}3&amp;6&amp;\cdots&amp;3n\end{pmatrix}\in\mathbb{R}^{1\times n}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S3.SS1.p13.3" class="ltx_p"><span id="S3.SS1.p13.3.1" class="ltx_text">The embedding layer <math id="S3.SS1.p13.m1" class="ltx_Math" alttext="\boldsymbol{\mathcal{F}}_{EB}:\mathbb{R}^{d\times n}\to\mathbb{R}^{(d+n+1)\times n}" display="inline" intent=":literal"><semantics><mrow><msub><mi class="ltx_font_mathcaligraphic">𝓕</mi><mrow><mi>E</mi><mo lspace="0em" rspace="0em">​</mo><mi>B</mi></mrow></msub><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><msup><mi>ℝ</mi><mrow><mi>d</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>n</mi></mrow></msup><mo stretchy="false">→</mo><msup><mi>ℝ</mi><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>d</mi><mo>+</mo><mi>n</mi><mo>+</mo><mn>1</mn></mrow><mo rspace="0.055em" stretchy="false">)</mo></mrow><mo rspace="0.222em">×</mo><mi>n</mi></mrow></msup></mrow></mrow><annotation encoding="application/x-tex">\boldsymbol{\mathcal{F}}_{EB}:\mathbb{R}^{d\times n}\to\mathbb{R}^{(d+n+1)\times n}</annotation></semantics></math> is defined to be</span></p>
<table id="S3.EGx76" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="S3.Ex109"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S3.Ex109.m1" class="ltx_Math" alttext="\displaystyle\boldsymbol{\mathcal{F}}_{EB}(\boldsymbol{X}):=\boldsymbol{W}_{EB}\boldsymbol{X}+\boldsymbol{B}_{EB}=\begin{pmatrix}\boldsymbol{X}\\
\boldsymbol{I}_{n\times n}-\boldsymbol{1}_{n\times n}\\
\boldsymbol{\widetilde{B}}_{EB}\end{pmatrix}\in\mathbb{R}^{(d+n+1)\times n}." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><msub><mi class="ltx_font_mathcaligraphic">𝓕</mi><mrow><mi>E</mi><mo lspace="0em" rspace="0em">​</mo><mi>B</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝑿</mi><mo stretchy="false">)</mo></mrow></mrow><mo>:=</mo><mrow><mrow><msub><mi>𝑾</mi><mrow><mi>E</mi><mo lspace="0em" rspace="0em">​</mo><mi>B</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mi>𝑿</mi></mrow><mo>+</mo><msub><mi>𝑩</mi><mrow><mi>E</mi><mo lspace="0em" rspace="0em">​</mo><mi>B</mi></mrow></msub></mrow><mo>=</mo><mrow><mo>(</mo><mtable rowspacing="0pt"><mtr><mtd><mi>𝑿</mi></mtd></mtr><mtr><mtd><mrow><msub><mi>𝑰</mi><mrow><mi>n</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>n</mi></mrow></msub><mo>−</mo><msub><mn>𝟏</mn><mrow><mi>n</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>n</mi></mrow></msub></mrow></mtd></mtr><mtr><mtd><msub><mover accent="true"><mi>𝑩</mi><mo>~</mo></mover><mrow><mi>E</mi><mo lspace="0em" rspace="0em">​</mo><mi>B</mi></mrow></msub></mtd></mtr></mtable><mo>)</mo></mrow><mo>∈</mo><msup><mi>ℝ</mi><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>d</mi><mo>+</mo><mi>n</mi><mo>+</mo><mn>1</mn></mrow><mo rspace="0.055em" stretchy="false">)</mo></mrow><mo rspace="0.222em">×</mo><mi>n</mi></mrow></msup></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\boldsymbol{\mathcal{F}}_{EB}(\boldsymbol{X}):=\boldsymbol{W}_{EB}\boldsymbol{X}+\boldsymbol{B}_{EB}=\begin{pmatrix}\boldsymbol{X}\\
\boldsymbol{I}_{n\times n}-\boldsymbol{1}_{n\times n}\\
\boldsymbol{\widetilde{B}}_{EB}\end{pmatrix}\in\mathbb{R}^{(d+n+1)\times n}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="S3.SS1.p14" class="ltx_para">
<p id="S3.SS1.p14.1" class="ltx_p"><span id="S3.SS1.p14.1.1" class="ltx_text">Let <math id="S3.SS1.p14.m1" class="ltx_Math" alttext="\boldsymbol{\mathcal{F}}_{FF}^{(dsc)}:\mathbb{R}^{1\times n}\to\mathbb{R}^{1\times n}" display="inline" intent=":literal"><semantics><mrow><msubsup><mi class="ltx_font_mathcaligraphic">𝓕</mi><mrow><mi>F</mi><mo lspace="0em" rspace="0em">​</mo><mi>F</mi></mrow><mrow><mo stretchy="false">(</mo><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>s</mi><mo lspace="0em" rspace="0em">​</mo><mi>c</mi></mrow><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><msup><mi>ℝ</mi><mrow><mn>1</mn><mo lspace="0.222em" rspace="0.222em">×</mo><mi>n</mi></mrow></msup><mo stretchy="false">→</mo><msup><mi>ℝ</mi><mrow><mn>1</mn><mo lspace="0.222em" rspace="0.222em">×</mo><mi>n</mi></mrow></msup></mrow></mrow><annotation encoding="application/x-tex">\boldsymbol{\mathcal{F}}_{FF}^{(dsc)}:\mathbb{R}^{1\times n}\to\mathbb{R}^{1\times n}</annotation></semantics></math> be the feedforward block generated by the ReLU FNN function <math id="S3.SS1.p14.m2" class="ltx_Math" alttext="f_{FF}^{(dsc)}" display="inline" intent=":literal"><semantics><msubsup><mi>f</mi><mrow><mi>F</mi><mo lspace="0em" rspace="0em">​</mo><mi>F</mi></mrow><mrow><mo stretchy="false">(</mo><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>s</mi><mo lspace="0em" rspace="0em">​</mo><mi>c</mi></mrow><mo stretchy="false">)</mo></mrow></msubsup><annotation encoding="application/x-tex">f_{FF}^{(dsc)}</annotation></semantics></math> in Lemma <a href="#Thmlemma6" title="Lemma 6. ‣ 3.1 Proof of Proposition ‣ 3 Proof of Proposition : Construction of Transformers ‣ Standard Transformers Achieve the Minimax Rate in Nonparametric Regression with 𝐶^{𝑠,𝜆} Targets" class="ltx_ref"><span class="ltx_text ltx_ref_tag">6</span></a>. Let <math id="S3.SS1.p14.m3" class="ltx_Math" alttext="\boldsymbol{\mathcal{F}}_{FF}^{(prl-dsc)}:\mathbb{R}^{(d+n+1)\times n}\to\mathbb{R}^{d\times n}" display="inline" intent=":literal"><semantics><mrow><msubsup><mi class="ltx_font_mathcaligraphic">𝓕</mi><mrow><mi>F</mi><mo lspace="0em" rspace="0em">​</mo><mi>F</mi></mrow><mrow><mo stretchy="false">(</mo><mrow><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>l</mi></mrow><mo>−</mo><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>s</mi><mo lspace="0em" rspace="0em">​</mo><mi>c</mi></mrow></mrow><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><msup><mi>ℝ</mi><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>d</mi><mo>+</mo><mi>n</mi><mo>+</mo><mn>1</mn></mrow><mo rspace="0.055em" stretchy="false">)</mo></mrow><mo rspace="0.222em">×</mo><mi>n</mi></mrow></msup><mo stretchy="false">→</mo><msup><mi>ℝ</mi><mrow><mi>d</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>n</mi></mrow></msup></mrow></mrow><annotation encoding="application/x-tex">\boldsymbol{\mathcal{F}}_{FF}^{(prl-dsc)}:\mathbb{R}^{(d+n+1)\times n}\to\mathbb{R}^{d\times n}</annotation></semantics></math> be the parallelization of <math id="S3.SS1.p14.m4" class="ltx_Math" alttext="\boldsymbol{\mathcal{F}}_{FF}^{(dsc)}" display="inline" intent=":literal"><semantics><msubsup><mi class="ltx_font_mathcaligraphic">𝓕</mi><mrow><mi>F</mi><mo lspace="0em" rspace="0em">​</mo><mi>F</mi></mrow><mrow><mo stretchy="false">(</mo><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>s</mi><mo lspace="0em" rspace="0em">​</mo><mi>c</mi></mrow><mo stretchy="false">)</mo></mrow></msubsup><annotation encoding="application/x-tex">\boldsymbol{\mathcal{F}}_{FF}^{(dsc)}</annotation></semantics></math>:</span></p>
<table id="S3.EGx77" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="S3.Ex110"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S3.Ex110.m1" class="ltx_math_unparsed" alttext="\displaystyle\boldsymbol{\mathcal{F}}_{FF}^{(prl-dsc)}(\boldsymbol{Y}):=\begin{pmatrix}\boldsymbol{\mathcal{F}}_{FF}^{(dsc)}(\boldsymbol{Y}_{1,:})\\
\boldsymbol{\mathcal{F}}_{FF}^{(dsc)}(\boldsymbol{Y}_{2,:})\\
\vdots\\
\boldsymbol{\mathcal{F}}_{FF}^{(dsc)}(\boldsymbol{Y}_{d,:})\end{pmatrix},\quad\boldsymbol{Y}\in\mathbb{R}^{(d+n+1)\times n}." display="inline" intent=":literal"><semantics><mrow><msubsup><mi class="ltx_font_mathcaligraphic">𝓕</mi><mrow><mi>F</mi><mo lspace="0em" rspace="0em">​</mo><mi>F</mi></mrow><mrow><mo stretchy="false">(</mo><mrow><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>l</mi></mrow><mo>−</mo><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>s</mi><mo lspace="0em" rspace="0em">​</mo><mi>c</mi></mrow></mrow><mo stretchy="false">)</mo></mrow></msubsup><mrow><mo stretchy="false">(</mo><mi>𝒀</mi><mo stretchy="false">)</mo></mrow><mo>:=</mo><mrow><mo>(</mo><mtable rowspacing="0pt"><mtr><mtd><mrow><mi class="ltx_font_mathcaligraphic">𝓕</mi><msub><mrow></mrow><mrow><mi>F</mi><mo lspace="0em" rspace="0em">​</mo><mi>F</mi></mrow></msub><msup><mrow></mrow><mrow><mo stretchy="false">(</mo><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>s</mi><mo lspace="0em" rspace="0em">​</mo><mi>c</mi></mrow><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">(</mo><mi>𝒀</mi><msub><mrow></mrow><mrow><mn>1</mn><mo>,</mo><mo>:</mo></mrow></msub><mo stretchy="false">)</mo></mrow></mtd></mtr><mtr><mtd><mrow><mi class="ltx_font_mathcaligraphic">𝓕</mi><msub><mrow></mrow><mrow><mi>F</mi><mo lspace="0em" rspace="0em">​</mo><mi>F</mi></mrow></msub><msup><mrow></mrow><mrow><mo stretchy="false">(</mo><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>s</mi><mo lspace="0em" rspace="0em">​</mo><mi>c</mi></mrow><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">(</mo><mi>𝒀</mi><msub><mrow></mrow><mrow><mn>2</mn><mo>,</mo><mo>:</mo></mrow></msub><mo stretchy="false">)</mo></mrow></mtd></mtr><mtr><mtd></mtd></mtr><mtr><mtd><mrow><mi class="ltx_font_mathcaligraphic">𝓕</mi><msub><mrow></mrow><mrow><mi>F</mi><mo lspace="0em" rspace="0em">​</mo><mi>F</mi></mrow></msub><msup><mrow></mrow><mrow><mo stretchy="false">(</mo><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>s</mi><mo lspace="0em" rspace="0em">​</mo><mi>c</mi></mrow><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">(</mo><mi>𝒀</mi><msub><mrow></mrow><mrow><mi>d</mi><mo>,</mo><mo>:</mo></mrow></msub><mo stretchy="false">)</mo></mrow></mtd></mtr></mtable><mo>)</mo></mrow><mo rspace="1.167em">,</mo><mi>𝒀</mi><mo>∈</mo><msup><mi>ℝ</mi><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>d</mi><mo>+</mo><mi>n</mi><mo>+</mo><mn>1</mn></mrow><mo rspace="0.055em" stretchy="false">)</mo></mrow><mo rspace="0.222em">×</mo><mi>n</mi></mrow></msup><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\boldsymbol{\mathcal{F}}_{FF}^{(prl-dsc)}(\boldsymbol{Y}):=\begin{pmatrix}\boldsymbol{\mathcal{F}}_{FF}^{(dsc)}(\boldsymbol{Y}_{1,:})\\
\boldsymbol{\mathcal{F}}_{FF}^{(dsc)}(\boldsymbol{Y}_{2,:})\\
\vdots\\
\boldsymbol{\mathcal{F}}_{FF}^{(dsc)}(\boldsymbol{Y}_{d,:})\end{pmatrix},\quad\boldsymbol{Y}\in\mathbb{R}^{(d+n+1)\times n}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S3.SS1.p14.2" class="ltx_p"><span id="S3.SS1.p14.2.1" class="ltx_text">It follows that <math id="S3.SS1.p14.m5" class="ltx_Math" alttext="\boldsymbol{\mathcal{F}}_{FF}^{(prl-dsc)}" display="inline" intent=":literal"><semantics><msubsup><mi class="ltx_font_mathcaligraphic">𝓕</mi><mrow><mi>F</mi><mo lspace="0em" rspace="0em">​</mo><mi>F</mi></mrow><mrow><mo stretchy="false">(</mo><mrow><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>l</mi></mrow><mo>−</mo><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>s</mi><mo lspace="0em" rspace="0em">​</mo><mi>c</mi></mrow></mrow><mo stretchy="false">)</mo></mrow></msubsup><annotation encoding="application/x-tex">\boldsymbol{\mathcal{F}}_{FF}^{(prl-dsc)}</annotation></semantics></math> is of width <math id="S3.SS1.p14.m6" class="ltx_Math" alttext="\max\{dK,d+n+1\}" display="inline" intent=":literal"><semantics><mrow><mi>max</mi><mo>⁡</mo><mrow><mo stretchy="false">{</mo><mrow><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>K</mi></mrow><mo>,</mo><mrow><mi>d</mi><mo>+</mo><mi>n</mi><mo>+</mo><mn>1</mn></mrow></mrow><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">\max\{dK,d+n+1\}</annotation></semantics></math>, depth <math id="S3.SS1.p14.m7" class="ltx_Math" alttext="3" display="inline" intent=":literal"><semantics><mn>3</mn><annotation encoding="application/x-tex">3</annotation></semantics></math> and weight bound <math id="S3.SS1.p14.m8" class="ltx_Math" alttext="1/\delta" display="inline" intent=":literal"><semantics><mrow><mn>1</mn><mo>/</mo><mi>δ</mi></mrow><annotation encoding="application/x-tex">1/\delta</annotation></semantics></math>, and</span></p>
<table id="S3.EGx78" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="S3.Ex111"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S3.Ex111.m1" class="ltx_Math" alttext="\displaystyle\boldsymbol{\mathcal{F}}_{FF}^{(prl-dsc)}\circ\boldsymbol{\mathcal{F}}_{EB}(\boldsymbol{X})=\boldsymbol{X}^{(j)},\quad\boldsymbol{X}\in\Omega_{j}." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mrow><mrow><msubsup><mi class="ltx_font_mathcaligraphic">𝓕</mi><mrow><mi>F</mi><mo lspace="0em" rspace="0em">​</mo><mi>F</mi></mrow><mrow><mo stretchy="false">(</mo><mrow><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>l</mi></mrow><mo>−</mo><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>s</mi><mo lspace="0em" rspace="0em">​</mo><mi>c</mi></mrow></mrow><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0.222em" rspace="0.222em">∘</mo><msub><mi class="ltx_font_mathcaligraphic">𝓕</mi><mrow><mi>E</mi><mo lspace="0em" rspace="0em">​</mo><mi>B</mi></mrow></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝑿</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><msup><mi>𝑿</mi><mrow><mo stretchy="false">(</mo><mi>j</mi><mo stretchy="false">)</mo></mrow></msup></mrow><mo rspace="1.167em">,</mo><mrow><mi>𝑿</mi><mo>∈</mo><msub><mi mathvariant="normal">Ω</mi><mi>j</mi></msub></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\boldsymbol{\mathcal{F}}_{FF}^{(prl-dsc)}\circ\boldsymbol{\mathcal{F}}_{EB}(\boldsymbol{X})=\boldsymbol{X}^{(j)},\quad\boldsymbol{X}\in\Omega_{j}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="S3.SS1.p15" class="ltx_para">
<p id="S3.SS1.p15.1" class="ltx_p"><span id="S3.SS1.p15.1.1" class="ltx_text ltx_font_bold">Step 2: Map <math id="S3.SS1.p15.m1" class="ltx_Math" alttext="\boldsymbol{X}_{j}" display="inline" intent=":literal"><semantics><msub><mi>X</mi><mi>j</mi></msub><annotation encoding="application/x-tex">\boldsymbol{X}_{j}</annotation></semantics></math> to the Taylor coefficients <math id="S3.SS1.p15.m2" class="ltx_Math" alttext="c_{i,j}" display="inline" intent=":literal"><semantics><msub><mi>c</mi><mrow><mi>i</mi><mo>,</mo><mi>j</mi></mrow></msub><annotation encoding="application/x-tex">c_{i,j}</annotation></semantics></math>.<span id="S3.SS1.p15.1.1.1" class="ltx_text"></span></span></p>
</div>
<div id="S3.SS1.p16" class="ltx_para">
<p id="S3.SS1.p16.1" class="ltx_p"><span id="S3.SS1.p16.1.1" class="ltx_text">Applying Lemma <a href="#Thmlemma7" title="Lemma 7. ‣ 3.1 Proof of Proposition ‣ 3 Proof of Proposition : Construction of Transformers ‣ Standard Transformers Achieve the Minimax Rate in Nonparametric Regression with 𝐶^{𝑠,𝜆} Targets" class="ltx_ref"><span class="ltx_text ltx_ref_tag">7</span></a> with paramters <math id="S3.SS1.p16.m1" class="ltx_Math" alttext="r=\sqrt{d},\phi=\frac{1}{K},N=K^{dn},B_{y}=C(\boldsymbol{f})" display="inline" intent=":literal"><semantics><mrow><mrow><mi>r</mi><mo>=</mo><msqrt><mi>d</mi></msqrt></mrow><mo>,</mo><mrow><mi>ϕ</mi><mo>=</mo><mfrac><mn>1</mn><mi>K</mi></mfrac></mrow><mo>,</mo><mrow><mi>N</mi><mo>=</mo><msup><mi>K</mi><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow></msup></mrow><mo>,</mo><mrow><msub><mi>B</mi><mi>y</mi></msub><mo>=</mo><mrow><mi>C</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝒇</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">r=\sqrt{d},\phi=\frac{1}{K},N=K^{dn},B_{y}=C(\boldsymbol{f})</annotation></semantics></math> therein, we can find Transformers <math id="S3.SS1.p16.m2" class="ltx_Math" alttext="\left\{\boldsymbol{T}_{i,k}^{(mmr)}\right\}_{i\in[C_{s+dn-1}^{dn-1}],k\in[d]}" display="inline" intent=":literal"><semantics><msub><mrow><mo>{</mo><msubsup><mi>𝑻</mi><mrow><mi>i</mi><mo>,</mo><mi>k</mi></mrow><mrow><mo stretchy="false">(</mo><mrow><mi>m</mi><mo lspace="0em" rspace="0em">​</mo><mi>m</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi></mrow><mo stretchy="false">)</mo></mrow></msubsup><mo>}</mo></mrow><mrow><mrow><mi>i</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><msubsup><mi>C</mi><mrow><mrow><mi>s</mi><mo>+</mo><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow></mrow><mo>−</mo><mn>1</mn></mrow><mrow><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow><mo>−</mo><mn>1</mn></mrow></msubsup><mo stretchy="false">]</mo></mrow></mrow><mo>,</mo><mrow><mi>k</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mi>d</mi><mo stretchy="false">]</mo></mrow></mrow></mrow></msub><annotation encoding="application/x-tex">\left\{\boldsymbol{T}_{i,k}^{(mmr)}\right\}_{i\in[C_{s+dn-1}^{dn-1}],k\in[d]}</annotation></semantics></math> with size</span></p>
<table id="S3.EGx79" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="S3.Ex112"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S3.Ex112.m1" class="ltx_Math" alttext="\displaystyle L_{0}" display="inline" intent=":literal"><semantics><msub><mi>L</mi><mn>0</mn></msub><annotation encoding="application/x-tex">\displaystyle L_{0}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S3.Ex112.m2" class="ltx_Math" alttext="\displaystyle=2,\quad W_{0}=\max\{d,5\};" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mphantom></mphantom><mo>=</mo><mn>2</mn></mrow><mo rspace="1.167em">,</mo><mrow><msub><mi>W</mi><mn>0</mn></msub><mo>=</mo><mrow><mi>max</mi><mo>⁡</mo><mrow><mo stretchy="false">{</mo><mi>d</mi><mo>,</mo><mn>5</mn><mo stretchy="false">}</mo></mrow></mrow></mrow></mrow><mo>;</mo></mrow><annotation encoding="application/x-tex">\displaystyle=2,\quad W_{0}=\max\{d,5\};</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="S3.Ex113"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S3.Ex113.m1" class="ltx_Math" alttext="\displaystyle H_{l}" display="inline" intent=":literal"><semantics><msub><mi>H</mi><mi>l</mi></msub><annotation encoding="application/x-tex">\displaystyle H_{l}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S3.Ex113.m2" class="ltx_math_unparsed" alttext="\displaystyle=3,\quad S_{l}=3;\quad l=1,\cdots,n;" display="inline" intent=":literal"><semantics><mrow><mo>=</mo><mn>3</mn><mo rspace="1.167em">,</mo><mi>S</mi><msub><mrow></mrow><mi>l</mi></msub><mo>=</mo><mn>3</mn><mo rspace="1.167em">;</mo><mi>l</mi><mo>=</mo><mn>1</mn><mo>,</mo><mo lspace="0em" rspace="0em">⋯</mo><mo>,</mo><mi>n</mi><mo>;</mo></mrow><annotation encoding="application/x-tex">\displaystyle=3,\quad S_{l}=3;\quad l=1,\cdots,n;</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="S3.Ex114"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S3.Ex114.m1" class="ltx_Math" alttext="\displaystyle L_{l}" display="inline" intent=":literal"><semantics><msub><mi>L</mi><mi>l</mi></msub><annotation encoding="application/x-tex">\displaystyle L_{l}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S3.Ex114.m2" class="ltx_math_unparsed" alttext="\displaystyle=3,\quad W_{l}=11;\quad l=1,\cdots,n-1;" display="inline" intent=":literal"><semantics><mrow><mo>=</mo><mn>3</mn><mo rspace="1.167em">,</mo><mi>W</mi><msub><mrow></mrow><mi>l</mi></msub><mo>=</mo><mn>11</mn><mo rspace="1.167em">;</mo><mi>l</mi><mo>=</mo><mn>1</mn><mo>,</mo><mo lspace="0em" rspace="0em">⋯</mo><mo>,</mo><mi>n</mi><mo>−</mo><mn>1</mn><mo>;</mo></mrow><annotation encoding="application/x-tex">\displaystyle=3,\quad W_{l}=11;\quad l=1,\cdots,n-1;</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="S3.Ex115"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S3.Ex115.m1" class="ltx_Math" alttext="\displaystyle L_{n}" display="inline" intent=":literal"><semantics><msub><mi>L</mi><mi>n</mi></msub><annotation encoding="application/x-tex">\displaystyle L_{n}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S3.Ex115.m2" class="ltx_Math" alttext="\displaystyle=3,\quad W_{n}=\max\left\{5,nK^{dn}-1\right\}" display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>=</mo><mn>3</mn></mrow><mo rspace="1.167em">,</mo><mrow><msub><mi>W</mi><mi>n</mi></msub><mo>=</mo><mrow><mi>max</mi><mo>⁡</mo><mrow><mo>{</mo><mrow><mn>5</mn><mo>,</mo><mrow><mrow><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>K</mi><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow></msup></mrow><mo>−</mo><mn>1</mn></mrow></mrow><mo>}</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=3,\quad W_{n}=\max\left\{5,nK^{dn}-1\right\}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S3.SS1.p16.2" class="ltx_p"><span id="S3.SS1.p16.2.1" class="ltx_text">and dimension vector <math id="S3.SS1.p16.m3" class="ltx_Math" alttext="\begin{pmatrix}d&amp;d&amp;5\cdot\boldsymbol{1}_{1\times n}&amp;1\end{pmatrix}" display="inline" intent=":literal"><semantics><mrow><mo>(</mo><mtable columnspacing="5pt"><mtr><mtd><mi>d</mi></mtd><mtd><mi>d</mi></mtd><mtd><mrow><mn>5</mn><mo lspace="0.222em" rspace="0.222em">⋅</mo><msub><mn>𝟏</mn><mrow><mn>1</mn><mo lspace="0.222em" rspace="0.222em">×</mo><mi>n</mi></mrow></msub></mrow></mtd><mtd><mn>1</mn></mtd></mtr></mtable><mo>)</mo></mrow><annotation encoding="application/x-tex">\begin{pmatrix}d&amp;d&amp;5\cdot\boldsymbol{1}_{1\times n}&amp;1\end{pmatrix}</annotation></semantics></math> such that for <math id="S3.SS1.p16.m4" class="ltx_Math" alttext="j\in\left[K^{dn}\right]" display="inline" intent=":literal"><semantics><mrow><mi>j</mi><mo>∈</mo><mrow><mo>[</mo><msup><mi>K</mi><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow></msup><mo>]</mo></mrow></mrow><annotation encoding="application/x-tex">j\in\left[K^{dn}\right]</annotation></semantics></math>,</span></p>
<table id="S3.EGx80" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="S3.Ex116"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S3.Ex116.m1" class="ltx_Math" alttext="\displaystyle\boldsymbol{T}_{i,k}^{(mmr)}\left(\boldsymbol{X}^{(j)}+\boldsymbol{1}_{d\times 1}\boldsymbol{\widetilde{B}}_{EB}\right):=\begin{pmatrix}c_{i,j}(f_{k1})&amp;c_{i,j}(f_{k2})&amp;\cdots&amp;c_{i,j}(f_{kn})\end{pmatrix},\quad i\in[C_{s+dn-1}^{dn-1}],k\in[d]." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mrow><msubsup><mi>𝑻</mi><mrow><mi>i</mi><mo>,</mo><mi>k</mi></mrow><mrow><mo stretchy="false">(</mo><mrow><mi>m</mi><mo lspace="0em" rspace="0em">​</mo><mi>m</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi></mrow><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><msup><mi>𝑿</mi><mrow><mo stretchy="false">(</mo><mi>j</mi><mo stretchy="false">)</mo></mrow></msup><mo>+</mo><mrow><msub><mn>𝟏</mn><mrow><mi>d</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mn>1</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msub><mover accent="true"><mi>𝑩</mi><mo>~</mo></mover><mrow><mi>E</mi><mo lspace="0em" rspace="0em">​</mo><mi>B</mi></mrow></msub></mrow></mrow><mo>)</mo></mrow></mrow><mo>:=</mo><mrow><mo>(</mo><mtable columnspacing="5pt"><mtr><mtd><mrow><msub><mi>c</mi><mrow><mi>i</mi><mo>,</mo><mi>j</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>f</mi><mrow><mi>k</mi><mo lspace="0em" rspace="0em">​</mo><mn>1</mn></mrow></msub><mo stretchy="false">)</mo></mrow></mrow></mtd><mtd><mrow><msub><mi>c</mi><mrow><mi>i</mi><mo>,</mo><mi>j</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>f</mi><mrow><mi>k</mi><mo lspace="0em" rspace="0em">​</mo><mn>2</mn></mrow></msub><mo stretchy="false">)</mo></mrow></mrow></mtd><mtd><mo>⋯</mo></mtd><mtd><mrow><msub><mi>c</mi><mrow><mi>i</mi><mo>,</mo><mi>j</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>f</mi><mrow><mi>k</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow></msub><mo stretchy="false">)</mo></mrow></mrow></mtd></mtr></mtable><mo>)</mo></mrow></mrow><mo rspace="1.167em">,</mo><mrow><mi>i</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><msubsup><mi>C</mi><mrow><mrow><mi>s</mi><mo>+</mo><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow></mrow><mo>−</mo><mn>1</mn></mrow><mrow><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow><mo>−</mo><mn>1</mn></mrow></msubsup><mo stretchy="false">]</mo></mrow></mrow><mo>,</mo><mrow><mi>k</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mi>d</mi><mo stretchy="false">]</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\boldsymbol{T}_{i,k}^{(mmr)}\left(\boldsymbol{X}^{(j)}+\boldsymbol{1}_{d\times 1}\boldsymbol{\widetilde{B}}_{EB}\right):=\begin{pmatrix}c_{i,j}(f_{k1})&amp;c_{i,j}(f_{k2})&amp;\cdots&amp;c_{i,j}(f_{kn})\end{pmatrix},\quad i\in[C_{s+dn-1}^{dn-1}],k\in[d].</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S3.SS1.p16.3" class="ltx_p"><span id="S3.SS1.p16.3.1" class="ltx_text">The weight bounds of <math id="S3.SS1.p16.m5" class="ltx_Math" alttext="\boldsymbol{T}_{i,k}^{(mmr)}" display="inline" intent=":literal"><semantics><msubsup><mi>𝑻</mi><mrow><mi>i</mi><mo>,</mo><mi>k</mi></mrow><mrow><mo stretchy="false">(</mo><mrow><mi>m</mi><mo lspace="0em" rspace="0em">​</mo><mi>m</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi></mrow><mo stretchy="false">)</mo></mrow></msubsup><annotation encoding="application/x-tex">\boldsymbol{T}_{i,k}^{(mmr)}</annotation></semantics></math> are <math id="S3.SS1.p16.m6" class="ltx_Math" alttext="B_{FF}=C(\boldsymbol{f})d^{2}n^{7}K^{6dn+2},B_{SA}=\frac{1}{2}\log(3{d}{\pi}n^{4}(3n+1)K^{4dn+1})" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>B</mi><mrow><mi>F</mi><mo lspace="0em" rspace="0em">​</mo><mi>F</mi></mrow></msub><mo>=</mo><mrow><mrow><mi>C</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝒇</mi><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mi>d</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>n</mi><mn>7</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>K</mi><mrow><mrow><mn>6</mn><mo lspace="0em" rspace="0em">​</mo><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow><mo>+</mo><mn>2</mn></mrow></msup></mrow></mrow><mo>,</mo><mrow><msub><mi>B</mi><mrow><mi>S</mi><mo lspace="0em" rspace="0em">​</mo><mi>A</mi></mrow></msub><mo>=</mo><mrow><mfrac><mn>1</mn><mn>2</mn></mfrac><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>log</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mn>3</mn><mo lspace="0em" rspace="0em">​</mo><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>π</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>n</mi><mn>4</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mn>3</mn><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mi>K</mi><mrow><mrow><mn>4</mn><mo lspace="0em" rspace="0em">​</mo><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow><mo>+</mo><mn>1</mn></mrow></msup></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">B_{FF}=C(\boldsymbol{f})d^{2}n^{7}K^{6dn+2},B_{SA}=\frac{1}{2}\log(3{d}{\pi}n^{4}(3n+1)K^{4dn+1})</annotation></semantics></math>. Based on Lemma <a href="#Thmlemma3" title="Lemma 3. ‣ 2.2 Proof of Theorem ‣ 2 Proofs of Main Results ‣ Standard Transformers Achieve the Minimax Rate in Nonparametric Regression with 𝐶^{𝑠,𝜆} Targets" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3</span></a>, we can construct a Transformer <math id="S3.SS1.p16.m7" class="ltx_Math" alttext="\boldsymbol{T}^{(prl-mmr)}:\mathbb{R}^{d\times n}\to\mathbb{R}^{dC_{s+dn-1}^{dn-1}\times n}" display="inline" intent=":literal"><semantics><mrow><msup><mi>𝑻</mi><mrow><mo stretchy="false">(</mo><mrow><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>l</mi></mrow><mo>−</mo><mrow><mi>m</mi><mo lspace="0em" rspace="0em">​</mo><mi>m</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi></mrow></mrow><mo stretchy="false">)</mo></mrow></msup><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><msup><mi>ℝ</mi><mrow><mi>d</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>n</mi></mrow></msup><mo stretchy="false">→</mo><msup><mi>ℝ</mi><mrow><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>C</mi><mrow><mrow><mi>s</mi><mo>+</mo><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow></mrow><mo>−</mo><mn>1</mn></mrow><mrow><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow><mo>−</mo><mn>1</mn></mrow></msubsup></mrow><mo lspace="0.222em" rspace="0.222em">×</mo><mi>n</mi></mrow></msup></mrow></mrow><annotation encoding="application/x-tex">\boldsymbol{T}^{(prl-mmr)}:\mathbb{R}^{d\times n}\to\mathbb{R}^{dC_{s+dn-1}^{dn-1}\times n}</annotation></semantics></math> with with size</span></p>
</div>
