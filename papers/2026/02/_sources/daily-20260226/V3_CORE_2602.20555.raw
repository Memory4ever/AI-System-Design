<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S3.Ex142.m1" class="ltx_Math" alttext="\displaystyle\begin{pmatrix}\widetilde{\times}\left(c_{1,j}(f_{11}),f_{1}^{(mnm)}\right)&amp;\widetilde{\times}\left(c_{1,j}(f_{12}),f_{1}^{(mnm)}\right)&amp;\cdots&amp;\widetilde{\times}\left(c_{1,j}(f_{1n}),f_{1}^{(mnm)}\right)\\
