<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S3.SS1.p19.8" class="ltx_p"><span id="S3.SS1.p19.8.1" class="ltx_text">The weight bounds of <math id="S3.SS1.p19.m15" class="ltx_Math" alttext="\boldsymbol{T}^{(prl-mnm)}" display="inline" intent=":literal"><semantics><msup><mi>𝑻</mi><mrow><mo stretchy="false">(</mo><mrow><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>l</mi></mrow><mo>−</mo><mrow><mi>m</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><mi>m</mi></mrow></mrow><mo stretchy="false">)</mo></mrow></msup><annotation encoding="application/x-tex">\boldsymbol{T}^{(prl-mnm)}</annotation></semantics></math> are <math id="S3.SS1.p19.m16" class="ltx_Math" alttext="B_{FF}=C,B_{SA}=1" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>B</mi><mrow><mi>F</mi><mo lspace="0em" rspace="0em">​</mo><mi>F</mi></mrow></msub><mo>=</mo><mi>C</mi></mrow><mo>,</mo><mrow><msub><mi>B</mi><mrow><mi>S</mi><mo lspace="0em" rspace="0em">​</mo><mi>A</mi></mrow></msub><mo>=</mo><mn>1</mn></mrow></mrow><annotation encoding="application/x-tex">B_{FF}=C,B_{SA}=1</annotation></semantics></math>.</span></p>
</div>
<div id="S3.SS1.p20" class="ltx_para">
<p id="S3.SS1.p20.1" class="ltx_p"><span id="S3.SS1.p20.1.1" class="ltx_text ltx_font_bold">Step 4: Parallel <math id="S3.SS1.p20.m1" class="ltx_Math" alttext="c_{i,j}" display="inline" intent=":literal"><semantics><msub><mi>c</mi><mrow><mi>i</mi><mo>,</mo><mi>j</mi></mrow></msub><annotation encoding="application/x-tex">c_{i,j}</annotation></semantics></math> and the appromants of <math id="S3.SS1.p20.m2" class="ltx_Math" alttext="\left(\boldsymbol{X}-\boldsymbol{X}^{(j)}\right)^{\boldsymbol{\alpha}_{i}}" display="inline" intent=":literal"><semantics><msup><mrow><mo>(</mo><mrow><mi>X</mi><mo>−</mo><msup><mi>X</mi><mrow><mo stretchy="false">(</mo><mi>j</mi><mo stretchy="false">)</mo></mrow></msup></mrow><mo>)</mo></mrow><msub><mi>α</mi><mi>i</mi></msub></msup><annotation encoding="application/x-tex">\left(\boldsymbol{X}-\boldsymbol{X}^{(j)}\right)^{\boldsymbol{\alpha}_{i}}</annotation></semantics></math>.<span id="S3.SS1.p20.1.1.1" class="ltx_text"></span></span></p>
</div>
<div id="S3.SS1.p21" class="ltx_para">
<p id="S3.SS1.p21.1" class="ltx_p"><span id="S3.SS1.p21.1.1" class="ltx_text">From the result of step 1, we can construct a feedforward block <math id="S3.SS1.p21.m1" class="ltx_Math" alttext="\boldsymbol{\mathcal{F}}_{FF}^{(mid)}:\mathbb{R}^{(d+n+1)\times n}\to\mathbb{R}^{(2d+n+1)\times n}" display="inline" intent=":literal"><semantics><mrow><msubsup><mi class="ltx_font_mathcaligraphic">𝓕</mi><mrow><mi>F</mi><mo lspace="0em" rspace="0em">​</mo><mi>F</mi></mrow><mrow><mo stretchy="false">(</mo><mrow><mi>m</mi><mo lspace="0em" rspace="0em">​</mo><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>d</mi></mrow><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><msup><mi>ℝ</mi><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>d</mi><mo>+</mo><mi>n</mi><mo>+</mo><mn>1</mn></mrow><mo rspace="0.055em" stretchy="false">)</mo></mrow><mo rspace="0.222em">×</mo><mi>n</mi></mrow></msup><mo stretchy="false">→</mo><msup><mi>ℝ</mi><mrow><mrow><mo stretchy="false">(</mo><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>d</mi></mrow><mo>+</mo><mi>n</mi><mo>+</mo><mn>1</mn></mrow><mo rspace="0.055em" stretchy="false">)</mo></mrow><mo rspace="0.222em">×</mo><mi>n</mi></mrow></msup></mrow></mrow><annotation encoding="application/x-tex">\boldsymbol{\mathcal{F}}_{FF}^{(mid)}:\mathbb{R}^{(d+n+1)\times n}\to\mathbb{R}^{(2d+n+1)\times n}</annotation></semantics></math> as</span></p>
<table id="S3.EGx90" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="S3.Ex129"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S3.Ex129.m1" class="ltx_math_unparsed" alttext="\displaystyle\boldsymbol{\mathcal{F}}_{FF}^{(mid)}(\boldsymbol{Y}):=\begin{pmatrix}\boldsymbol{\mathcal{F}}_{FF}^{(idt)}(\boldsymbol{Y}_{1:d,:})-\boldsymbol{\mathcal{F}}_{FF}^{(prl-drc)}(\boldsymbol{Y}_{1:d,:})\\
\boldsymbol{\mathcal{F}}_{FF}^{(idt)}(\boldsymbol{Y}_{(d+1):(d+n),:})\\
\boldsymbol{\mathcal{F}}_{FF}^{(prl-drc)}(\boldsymbol{Y}_{1:d,:})\\
\boldsymbol{\mathcal{F}}_{FF}^{(idt)}(\boldsymbol{Y}_{d+n+1,:})\end{pmatrix},\quad\boldsymbol{Y}\in\mathbb{R}^{(d+n+1)\times n}," display="inline" intent=":literal"><semantics><mrow><msubsup><mi class="ltx_font_mathcaligraphic">𝓕</mi><mrow><mi>F</mi><mo lspace="0em" rspace="0em">​</mo><mi>F</mi></mrow><mrow><mo stretchy="false">(</mo><mrow><mi>m</mi><mo lspace="0em" rspace="0em">​</mo><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>d</mi></mrow><mo stretchy="false">)</mo></mrow></msubsup><mrow><mo stretchy="false">(</mo><mi>𝒀</mi><mo stretchy="false">)</mo></mrow><mo>:=</mo><mrow><mo>(</mo><mtable rowspacing="0pt"><mtr><mtd><mrow><mi class="ltx_font_mathcaligraphic">𝓕</mi><msub><mrow></mrow><mrow><mi>F</mi><mo lspace="0em" rspace="0em">​</mo><mi>F</mi></mrow></msub><msup><mrow></mrow><mrow><mo stretchy="false">(</mo><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">(</mo><mi>𝒀</mi><msub><mrow></mrow><mrow><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mi>d</mi><mo>,</mo><mo>:</mo></mrow></msub><mo stretchy="false">)</mo><mo>−</mo><mi class="ltx_font_mathcaligraphic">𝓕</mi><msub><mrow></mrow><mrow><mi>F</mi><mo lspace="0em" rspace="0em">​</mo><mi>F</mi></mrow></msub><msup><mrow></mrow><mrow><mo stretchy="false">(</mo><mrow><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>l</mi></mrow><mo>−</mo><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>c</mi></mrow></mrow><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">(</mo><mi>𝒀</mi><msub><mrow></mrow><mrow><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mi>d</mi><mo>,</mo><mo>:</mo></mrow></msub><mo stretchy="false">)</mo></mrow></mtd></mtr><mtr><mtd><mrow><mi class="ltx_font_mathcaligraphic">𝓕</mi><msub><mrow></mrow><mrow><mi>F</mi><mo lspace="0em" rspace="0em">​</mo><mi>F</mi></mrow></msub><msup><mrow></mrow><mrow><mo stretchy="false">(</mo><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">(</mo><mi>𝒀</mi><msub><mrow></mrow><mrow><mo stretchy="false">(</mo><mi>d</mi><mo>+</mo><mn>1</mn><mo rspace="0.278em" stretchy="false">)</mo><mo rspace="0.278em">:</mo><mo stretchy="false">(</mo><mi>d</mi><mo>+</mo><mi>n</mi><mo stretchy="false">)</mo><mo>,</mo><mo>:</mo></mrow></msub><mo stretchy="false">)</mo></mrow></mtd></mtr><mtr><mtd><mrow><mi class="ltx_font_mathcaligraphic">𝓕</mi><msub><mrow></mrow><mrow><mi>F</mi><mo lspace="0em" rspace="0em">​</mo><mi>F</mi></mrow></msub><msup><mrow></mrow><mrow><mo stretchy="false">(</mo><mrow><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>l</mi></mrow><mo>−</mo><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>c</mi></mrow></mrow><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">(</mo><mi>𝒀</mi><msub><mrow></mrow><mrow><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mi>d</mi><mo>,</mo><mo>:</mo></mrow></msub><mo stretchy="false">)</mo></mrow></mtd></mtr><mtr><mtd><mrow><mi class="ltx_font_mathcaligraphic">𝓕</mi><msub><mrow></mrow><mrow><mi>F</mi><mo lspace="0em" rspace="0em">​</mo><mi>F</mi></mrow></msub><msup><mrow></mrow><mrow><mo stretchy="false">(</mo><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">(</mo><mi>𝒀</mi><msub><mrow></mrow><mrow><mi>d</mi><mo>+</mo><mi>n</mi><mo>+</mo><mn>1</mn><mo>,</mo><mo>:</mo></mrow></msub><mo stretchy="false">)</mo></mrow></mtd></mtr></mtable><mo>)</mo></mrow><mo rspace="1.167em">,</mo><mi>𝒀</mi><mo>∈</mo><msup><mi>ℝ</mi><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>d</mi><mo>+</mo><mi>n</mi><mo>+</mo><mn>1</mn></mrow><mo rspace="0.055em" stretchy="false">)</mo></mrow><mo rspace="0.222em">×</mo><mi>n</mi></mrow></msup><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\boldsymbol{\mathcal{F}}_{FF}^{(mid)}(\boldsymbol{Y}):=\begin{pmatrix}\boldsymbol{\mathcal{F}}_{FF}^{(idt)}(\boldsymbol{Y}_{1:d,:})-\boldsymbol{\mathcal{F}}_{FF}^{(prl-drc)}(\boldsymbol{Y}_{1:d,:})\\
\boldsymbol{\mathcal{F}}_{FF}^{(idt)}(\boldsymbol{Y}_{(d+1):(d+n),:})\\
\boldsymbol{\mathcal{F}}_{FF}^{(prl-drc)}(\boldsymbol{Y}_{1:d,:})\\
\boldsymbol{\mathcal{F}}_{FF}^{(idt)}(\boldsymbol{Y}_{d+n+1,:})\end{pmatrix},\quad\boldsymbol{Y}\in\mathbb{R}^{(d+n+1)\times n},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S3.SS1.p21.2" class="ltx_p"><span id="S3.SS1.p21.2.1" class="ltx_text">where <math id="S3.SS1.p21.m2" class="ltx_Math" alttext="\boldsymbol{\mathcal{F}}_{FF}^{(idt)}" display="inline" intent=":literal"><semantics><msubsup><mi class="ltx_font_mathcaligraphic">𝓕</mi><mrow><mi>F</mi><mo lspace="0em" rspace="0em">​</mo><mi>F</mi></mrow><mrow><mo stretchy="false">(</mo><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow><mo stretchy="false">)</mo></mrow></msubsup><annotation encoding="application/x-tex">\boldsymbol{\mathcal{F}}_{FF}^{(idt)}</annotation></semantics></math> is the identical mapping. It follows that for <math id="S3.SS1.p21.m3" class="ltx_Math" alttext="\boldsymbol{X}\in\Omega_{j}" display="inline" intent=":literal"><semantics><mrow><mi>𝑿</mi><mo>∈</mo><msub><mi mathvariant="normal">Ω</mi><mi>j</mi></msub></mrow><annotation encoding="application/x-tex">\boldsymbol{X}\in\Omega_{j}</annotation></semantics></math> with some <math id="S3.SS1.p21.m4" class="ltx_Math" alttext="j\in[K^{dn}]" display="inline" intent=":literal"><semantics><mrow><mi>j</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><msup><mi>K</mi><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow></msup><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">j\in[K^{dn}]</annotation></semantics></math>,</span></p>
<table id="S3.EGx91" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="S3.Ex130"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S3.Ex130.m1" class="ltx_Math" alttext="\displaystyle\boldsymbol{\mathcal{F}}_{FF}^{(mid)}\circ\boldsymbol{\mathcal{F}}_{EB}(\boldsymbol{X})=\begin{pmatrix}\boldsymbol{X}-\boldsymbol{X}^{(j)}\\
\boldsymbol{I}_{n\times n}-\boldsymbol{1}_{n\times n}\\
\boldsymbol{X}^{(j)}\\
\boldsymbol{\widetilde{B}}_{EB}\end{pmatrix}." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mrow><msubsup><mi class="ltx_font_mathcaligraphic">𝓕</mi><mrow><mi>F</mi><mo lspace="0em" rspace="0em">​</mo><mi>F</mi></mrow><mrow><mo stretchy="false">(</mo><mrow><mi>m</mi><mo lspace="0em" rspace="0em">​</mo><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>d</mi></mrow><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0.222em" rspace="0.222em">∘</mo><msub><mi class="ltx_font_mathcaligraphic">𝓕</mi><mrow><mi>E</mi><mo lspace="0em" rspace="0em">​</mo><mi>B</mi></mrow></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝑿</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mo>(</mo><mtable rowspacing="0pt"><mtr><mtd><mrow><mi>𝑿</mi><mo>−</mo><msup><mi>𝑿</mi><mrow><mo stretchy="false">(</mo><mi>j</mi><mo stretchy="false">)</mo></mrow></msup></mrow></mtd></mtr><mtr><mtd><mrow><msub><mi>𝑰</mi><mrow><mi>n</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>n</mi></mrow></msub><mo>−</mo><msub><mn>𝟏</mn><mrow><mi>n</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>n</mi></mrow></msub></mrow></mtd></mtr><mtr><mtd><msup><mi>𝑿</mi><mrow><mo stretchy="false">(</mo><mi>j</mi><mo stretchy="false">)</mo></mrow></msup></mtd></mtr><mtr><mtd><msub><mover accent="true"><mi>𝑩</mi><mo>~</mo></mover><mrow><mi>E</mi><mo lspace="0em" rspace="0em">​</mo><mi>B</mi></mrow></msub></mtd></mtr></mtable><mo>)</mo></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\boldsymbol{\mathcal{F}}_{FF}^{(mid)}\circ\boldsymbol{\mathcal{F}}_{EB}(\boldsymbol{X})=\begin{pmatrix}\boldsymbol{X}-\boldsymbol{X}^{(j)}\\
\boldsymbol{I}_{n\times n}-\boldsymbol{1}_{n\times n}\\
\boldsymbol{X}^{(j)}\\
\boldsymbol{\widetilde{B}}_{EB}\end{pmatrix}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S3.SS1.p21.3" class="ltx_p"><span id="S3.SS1.p21.3.1" class="ltx_text">Based on Lemma <a href="#Thmlemma11" title="Lemma 11. ‣ 3.1 Proof of Proposition ‣ 3 Proof of Proposition : Construction of Transformers ‣ Standard Transformers Achieve the Minimax Rate in Nonparametric Regression with 𝐶^{𝑠,𝜆} Targets" class="ltx_ref"><span class="ltx_text ltx_ref_tag">11</span></a> and the structure of <math id="S3.SS1.p21.m5" class="ltx_Math" alttext="\boldsymbol{\mathcal{F}}_{FF}^{(drc)}" display="inline" intent=":literal"><semantics><msubsup><mi class="ltx_font_mathcaligraphic">𝓕</mi><mrow><mi>F</mi><mo lspace="0em" rspace="0em">​</mo><mi>F</mi></mrow><mrow><mo stretchy="false">(</mo><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>c</mi></mrow><mo stretchy="false">)</mo></mrow></msubsup><annotation encoding="application/x-tex">\boldsymbol{\mathcal{F}}_{FF}^{(drc)}</annotation></semantics></math> constructed in step 1, it is not hard to see that <math id="S3.SS1.p21.m6" class="ltx_Math" alttext="\boldsymbol{\mathcal{F}}_{FF}^{(prl-drc)}" display="inline" intent=":literal"><semantics><msubsup><mi class="ltx_font_mathcaligraphic">𝓕</mi><mrow><mi>F</mi><mo lspace="0em" rspace="0em">​</mo><mi>F</mi></mrow><mrow><mo stretchy="false">(</mo><mrow><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>l</mi></mrow><mo>−</mo><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>c</mi></mrow></mrow><mo stretchy="false">)</mo></mrow></msubsup><annotation encoding="application/x-tex">\boldsymbol{\mathcal{F}}_{FF}^{(prl-drc)}</annotation></semantics></math> is of depth <math id="S3.SS1.p21.m7" class="ltx_Math" alttext="3" display="inline" intent=":literal"><semantics><mn>3</mn><annotation encoding="application/x-tex">3</annotation></semantics></math>, width <math id="S3.SS1.p21.m8" class="ltx_Math" alttext="(K+2)d+2n+2" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>K</mi><mo>+</mo><mn>2</mn></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>d</mi></mrow><mo>+</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow><mo>+</mo><mn>2</mn></mrow><annotation encoding="application/x-tex">(K+2)d+2n+2</annotation></semantics></math> and weight bound <math id="S3.SS1.p21.m9" class="ltx_Math" alttext="\max\{1/\delta,1\}" display="inline" intent=":literal"><semantics><mrow><mi>max</mi><mo>⁡</mo><mrow><mo stretchy="false">{</mo><mrow><mrow><mn>1</mn><mo>/</mo><mi>δ</mi></mrow><mo>,</mo><mn>1</mn></mrow><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">\max\{1/\delta,1\}</annotation></semantics></math>.</span></p>
</div>
<div id="S3.SS1.p22" class="ltx_para">
<p id="S3.SS1.p22.1" class="ltx_p"><span id="S3.SS1.p22.1.1" class="ltx_text">Lemma <a href="#Thmlemma3" title="Lemma 3. ‣ 2.2 Proof of Theorem ‣ 2 Proofs of Main Results ‣ Standard Transformers Achieve the Minimax Rate in Nonparametric Regression with 𝐶^{𝑠,𝜆} Targets" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3</span></a> ensures the existence of a Transformer <math id="S3.SS1.p22.m1" class="ltx_Math" alttext="\boldsymbol{T}^{(prl)}:\mathbb{R}^{(2d+n+1)\times n}\to\mathbb{R}^{(d+1)C_{s+dn-1}^{dn-1}\times n}" display="inline" intent=":literal"><semantics><mrow><msup><mi>𝑻</mi><mrow><mo stretchy="false">(</mo><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>l</mi></mrow><mo stretchy="false">)</mo></mrow></msup><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><msup><mi>ℝ</mi><mrow><mrow><mo stretchy="false">(</mo><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>d</mi></mrow><mo>+</mo><mi>n</mi><mo>+</mo><mn>1</mn></mrow><mo rspace="0.055em" stretchy="false">)</mo></mrow><mo rspace="0.222em">×</mo><mi>n</mi></mrow></msup><mo stretchy="false">→</mo><msup><mi>ℝ</mi><mrow><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>d</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>C</mi><mrow><mrow><mi>s</mi><mo>+</mo><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow></mrow><mo>−</mo><mn>1</mn></mrow><mrow><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow><mo>−</mo><mn>1</mn></mrow></msubsup></mrow><mo lspace="0.222em" rspace="0.222em">×</mo><mi>n</mi></mrow></msup></mrow></mrow><annotation encoding="application/x-tex">\boldsymbol{T}^{(prl)}:\mathbb{R}^{(2d+n+1)\times n}\to\mathbb{R}^{(d+1)C_{s+dn-1}^{dn-1}\times n}</annotation></semantics></math> with size</span></p>
</div>
<div id="S3.SS1.p23" class="ltx_para">
<table id="S3.EGx92" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="S3.Ex131"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S3.Ex131.m1" class="ltx_Math" alttext="\displaystyle L_{0}" display="inline" intent=":literal"><semantics><msub><mi>L</mi><mn>0</mn></msub><annotation encoding="application/x-tex">\displaystyle L_{0}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S3.Ex131.m2" class="ltx_Math" alttext="\displaystyle=2,\quad W_{0}=dC_{s+dn-1}^{dn-1}\left[\max\{d+1,5\}+2n\right];" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mphantom></mphantom><mo>=</mo><mn>2</mn></mrow><mo rspace="1.167em">,</mo><mrow><msub><mi>W</mi><mn>0</mn></msub><mo>=</mo><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>C</mi><mrow><mrow><mi>s</mi><mo>+</mo><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow></mrow><mo>−</mo><mn>1</mn></mrow><mrow><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow><mo>−</mo><mn>1</mn></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><mrow><mrow><mi>max</mi><mo>⁡</mo><mrow><mo stretchy="false">{</mo><mrow><mrow><mi>d</mi><mo>+</mo><mn>1</mn></mrow><mo>,</mo><mn>5</mn></mrow><mo stretchy="false">}</mo></mrow></mrow><mo>+</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow></mrow><mo>]</mo></mrow></mrow></mrow></mrow><mo>;</mo></mrow><annotation encoding="application/x-tex">\displaystyle=2,\quad W_{0}=dC_{s+dn-1}^{dn-1}\left[\max\{d+1,5\}+2n\right];</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="S3.Ex132"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S3.Ex132.m1" class="ltx_Math" alttext="\displaystyle H_{1}" display="inline" intent=":literal"><semantics><msub><mi>H</mi><mn>1</mn></msub><annotation encoding="application/x-tex">\displaystyle H_{1}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S3.Ex132.m2" class="ltx_Math" alttext="\displaystyle=(3d+1)C_{s+dn-1}^{dn-1},\quad S_{1}=\max\{dn,3\};" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mrow><mn>3</mn><mo lspace="0em" rspace="0em">​</mo><mi>d</mi></mrow><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>C</mi><mrow><mrow><mi>s</mi><mo>+</mo><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow></mrow><mo>−</mo><mn>1</mn></mrow><mrow><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow><mo>−</mo><mn>1</mn></mrow></msubsup></mrow></mrow><mo rspace="1.167em">,</mo><mrow><msub><mi>S</mi><mn>1</mn></msub><mo>=</mo><mrow><mi>max</mi><mo>⁡</mo><mrow><mo stretchy="false">{</mo><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow><mo>,</mo><mn>3</mn><mo stretchy="false">}</mo></mrow></mrow></mrow></mrow><mo>;</mo></mrow><annotation encoding="application/x-tex">\displaystyle=(3d+1)C_{s+dn-1}^{dn-1},\quad S_{1}=\max\{dn,3\};</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="S3.Ex133"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S3.Ex133.m1" class="ltx_Math" alttext="\displaystyle L_{l}" display="inline" intent=":literal"><semantics><msub><mi>L</mi><mi>l</mi></msub><annotation encoding="application/x-tex">\displaystyle L_{l}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S3.Ex133.m2" class="ltx_math_unparsed" alttext="\displaystyle=3,\quad W_{l}=dC_{s+dn-1}^{dn-1}(4n+11);\quad l=1,\cdots,n-1;" display="inline" intent=":literal"><semantics><mrow><mo>=</mo><mn>3</mn><mo rspace="1.167em">,</mo><msub><mi>W</mi><mi>l</mi></msub><mo>=</mo><mi>d</mi><msubsup><mi>C</mi><mrow><mrow><mi>s</mi><mo>+</mo><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow></mrow><mo>−</mo><mn>1</mn></mrow><mrow><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow><mo>−</mo><mn>1</mn></mrow></msubsup><mrow><mo stretchy="false">(</mo><mn>4</mn><mi>n</mi><mo>+</mo><mn>11</mn><mo stretchy="false">)</mo></mrow><mo rspace="1.167em">;</mo><mi>l</mi><mo>=</mo><mn>1</mn><mo>,</mo><mo lspace="0em" rspace="0em">⋯</mo><mo>,</mo><mi>n</mi><mo>−</mo><mn>1</mn><mo>;</mo></mrow><annotation encoding="application/x-tex">\displaystyle=3,\quad W_{l}=dC_{s+dn-1}^{dn-1}(4n+11);\quad l=1,\cdots,n-1;</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="S3.Ex134"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S3.Ex134.m1" class="ltx_Math" alttext="\displaystyle H_{l}" display="inline" intent=":literal"><semantics><msub><mi>H</mi><mi>l</mi></msub><annotation encoding="application/x-tex">\displaystyle H_{l}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S3.Ex134.m2" class="ltx_math_unparsed" alttext="\displaystyle=3dC_{s+dn-1}^{dn-1},\quad S_{l}=3;\quad l=2,\cdots,n;" display="inline" intent=":literal"><semantics><mrow><mo>=</mo><mn>3</mn><mi>d</mi><mi>C</mi><msub><mrow></mrow><mrow><mrow><mi>s</mi><mo>+</mo><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow></mrow><mo>−</mo><mn>1</mn></mrow></msub><msup><mrow></mrow><mrow><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow><mo>−</mo><mn>1</mn></mrow></msup><mo rspace="1.167em">,</mo><mi>S</mi><msub><mrow></mrow><mi>l</mi></msub><mo>=</mo><mn>3</mn><mo rspace="1.167em">;</mo><mi>l</mi><mo>=</mo><mn>2</mn><mo>,</mo><mo lspace="0em" rspace="0em">⋯</mo><mo>,</mo><mi>n</mi><mo>;</mo></mrow><annotation encoding="application/x-tex">\displaystyle=3dC_{s+dn-1}^{dn-1},\quad S_{l}=3;\quad l=2,\cdots,n;</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="S3.Ex135"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S3.Ex135.m1" class="ltx_Math" alttext="\displaystyle L_{n}" display="inline" intent=":literal"><semantics><msub><mi>L</mi><mi>n</mi></msub><annotation encoding="application/x-tex">\displaystyle L_{n}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S3.Ex135.m2" class="ltx_Math" alttext="\displaystyle=C\ln\frac{3^{\lceil\log_{2}(s-1)\rceil}-1}{2\epsilon_{1}},\quad W_{n}=dC_{s+dn-1}^{dn-1}(nK^{dn}-1)+\max\left\{21\cdot 2^{\lceil\log_{2}(s-1)\rceil-1},2dn\right\}C_{s+dn-1}^{dn-1}" display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>=</mo><mrow><mi>C</mi><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>ln</mi><mo lspace="0.167em">⁡</mo><mstyle displaystyle="true"><mfrac><mrow><msup><mn>3</mn><mrow><mo stretchy="false">⌈</mo><mrow><msub><mi>log</mi><mn>2</mn></msub><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>s</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">⌉</mo></mrow></msup><mo>−</mo><mn>1</mn></mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>ϵ</mi><mn>1</mn></msub></mrow></mfrac></mstyle></mrow></mrow></mrow><mo rspace="1.167em">,</mo><mrow><msub><mi>W</mi><mi>n</mi></msub><mo>=</mo><mrow><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>C</mi><mrow><mrow><mi>s</mi><mo>+</mo><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow></mrow><mo>−</mo><mn>1</mn></mrow><mrow><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow><mo>−</mo><mn>1</mn></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>K</mi><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow></msup></mrow><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mrow><mi>max</mi><mo>⁡</mo><mrow><mrow><mo>{</mo><mrow><mn>21</mn><mo lspace="0.222em" rspace="0.222em">⋅</mo><msup><mn>2</mn><mrow><mrow><mo stretchy="false">⌈</mo><mrow><msub><mi>log</mi><mn>2</mn></msub><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>s</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">⌉</mo></mrow><mo>−</mo><mn>1</mn></mrow></msup></mrow><mo>,</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow><mo>}</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>C</mi><mrow><mrow><mi>s</mi><mo>+</mo><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow></mrow><mo>−</mo><mn>1</mn></mrow><mrow><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow><mo>−</mo><mn>1</mn></mrow></msubsup></mrow></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=C\ln\frac{3^{\lceil\log_{2}(s-1)\rceil}-1}{2\epsilon_{1}},\quad W_{n}=dC_{s+dn-1}^{dn-1}(nK^{dn}-1)+\max\left\{21\cdot 2^{\lceil\log_{2}(s-1)\rceil-1},2dn\right\}C_{s+dn-1}^{dn-1}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S3.SS1.p23.1" class="ltx_p"><span id="S3.SS1.p23.1.1" class="ltx_text">and dimension vector</span></p>
<table id="S3.EGx93" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="S3.Ex136"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S3.Ex136.m1" class="ltx_Math" alttext="\displaystyle\begin{pmatrix}2d+n+1&amp;2d+n+1&amp;&amp;(2dn+5d)C_{s+dn-1}^{dn-1}\cdot\boldsymbol{1}_{1\times n}&amp;(d+1)C_{s+dn-1}^{dn-1}\end{pmatrix}" display="inline" intent=":literal"><semantics><mrow><mo>(</mo><mtable columnspacing="5pt"><mtr><mtd><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>d</mi></mrow><mo>+</mo><mi>n</mi><mo>+</mo><mn>1</mn></mrow></mtd><mtd><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>d</mi></mrow><mo>+</mo><mi>n</mi><mo>+</mo><mn>1</mn></mrow></mtd><mtd></mtd><mtd><mrow><mrow><mrow><mo stretchy="false">(</mo><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow><mo>+</mo><mrow><mn>5</mn><mo lspace="0em" rspace="0em">​</mo><mi>d</mi></mrow></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>C</mi><mrow><mrow><mi>s</mi><mo>+</mo><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow></mrow><mo>−</mo><mn>1</mn></mrow><mrow><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow><mo>−</mo><mn>1</mn></mrow></msubsup></mrow><mo lspace="0.222em" rspace="0.222em">⋅</mo><msub><mn>𝟏</mn><mrow><mn>1</mn><mo lspace="0.222em" rspace="0.222em">×</mo><mi>n</mi></mrow></msub></mrow></mtd><mtd><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>d</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>C</mi><mrow><mrow><mi>s</mi><mo>+</mo><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow></mrow><mo>−</mo><mn>1</mn></mrow><mrow><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow><mo>−</mo><mn>1</mn></mrow></msubsup></mrow></mtd></mtr></mtable><mo>)</mo></mrow><annotation encoding="application/x-tex">\displaystyle\begin{pmatrix}2d+n+1&amp;2d+n+1&amp;&amp;(2dn+5d)C_{s+dn-1}^{dn-1}\cdot\boldsymbol{1}_{1\times n}&amp;(d+1)C_{s+dn-1}^{dn-1}\end{pmatrix}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S3.SS1.p23.2" class="ltx_p"><span id="S3.SS1.p23.2.1" class="ltx_text">such that</span></p>
<table id="S3.EGx94" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="S3.Ex137"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S3.Ex137.m1" class="ltx_math_unparsed" alttext="\displaystyle\boldsymbol{T}^{(prl)}(\boldsymbol{Y}):=\begin{pmatrix}\boldsymbol{T}^{(prl-mnm)}\left(\boldsymbol{Y}_{1:(d+n),:}\right)\\
\boldsymbol{T}^{(prl-mmr)}\left(\boldsymbol{W}_{1}\boldsymbol{Y}_{(d+n+1):(2d+n+1),:}\right)\end{pmatrix},\quad\boldsymbol{Y}\in\mathbb{R}^{(2d+n+1)\times n}," display="inline" intent=":literal"><semantics><mrow><msup><mi>𝑻</mi><mrow><mo stretchy="false">(</mo><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>l</mi></mrow><mo stretchy="false">)</mo></mrow></msup><mrow><mo stretchy="false">(</mo><mi>𝒀</mi><mo stretchy="false">)</mo></mrow><mo>:=</mo><mrow><mo>(</mo><mtable rowspacing="0pt"><mtr><mtd><mrow><mi>𝑻</mi><msup><mrow></mrow><mrow><mo stretchy="false">(</mo><mrow><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>l</mi></mrow><mo>−</mo><mrow><mi>m</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><mi>m</mi></mrow></mrow><mo stretchy="false">)</mo></mrow></msup><mo>(</mo><mi>𝒀</mi><msub><mrow></mrow><mrow><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mo stretchy="false">(</mo><mi>d</mi><mo>+</mo><mi>n</mi><mo stretchy="false">)</mo><mo>,</mo><mo>:</mo></mrow></msub><mo>)</mo></mrow></mtd></mtr><mtr><mtd><mrow><mi>𝑻</mi><msup><mrow></mrow><mrow><mo stretchy="false">(</mo><mrow><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>l</mi></mrow><mo>−</mo><mrow><mi>m</mi><mo lspace="0em" rspace="0em">​</mo><mi>m</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi></mrow></mrow><mo stretchy="false">)</mo></mrow></msup><mo>(</mo><mi>𝑾</mi><msub><mrow></mrow><mn>1</mn></msub><mi>𝒀</mi><msub><mrow></mrow><mrow><mo stretchy="false">(</mo><mi>d</mi><mo>+</mo><mi>n</mi><mo>+</mo><mn>1</mn><mo rspace="0.278em" stretchy="false">)</mo><mo rspace="0.278em">:</mo><mo stretchy="false">(</mo><mn>2</mn><mi>d</mi><mo>+</mo><mi>n</mi><mo>+</mo><mn>1</mn><mo stretchy="false">)</mo><mo>,</mo><mo>:</mo></mrow></msub><mo>)</mo></mrow></mtd></mtr></mtable><mo>)</mo></mrow><mo rspace="1.167em">,</mo><mi>𝒀</mi><mo>∈</mo><msup><mi>ℝ</mi><mrow><mrow><mo stretchy="false">(</mo><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>d</mi></mrow><mo>+</mo><mi>n</mi><mo>+</mo><mn>1</mn></mrow><mo rspace="0.055em" stretchy="false">)</mo></mrow><mo rspace="0.222em">×</mo><mi>n</mi></mrow></msup><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\boldsymbol{T}^{(prl)}(\boldsymbol{Y}):=\begin{pmatrix}\boldsymbol{T}^{(prl-mnm)}\left(\boldsymbol{Y}_{1:(d+n),:}\right)\\
\boldsymbol{T}^{(prl-mmr)}\left(\boldsymbol{W}_{1}\boldsymbol{Y}_{(d+n+1):(2d+n+1),:}\right)\end{pmatrix},\quad\boldsymbol{Y}\in\mathbb{R}^{(2d+n+1)\times n},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S3.SS1.p23.3" class="ltx_p"><span id="S3.SS1.p23.3.1" class="ltx_text">where</span></p>
<table id="S3.EGx95" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="S3.Ex138"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S3.Ex138.m1" class="ltx_Math" alttext="\displaystyle\boldsymbol{W}_{1}:=\begin{pmatrix}\boldsymbol{I}_{d\times d}&amp;\boldsymbol{1}_{d\times 1}\end{pmatrix}." display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>𝑾</mi><mn>1</mn></msub><mo>:=</mo><mrow><mo>(</mo><mtable columnspacing="5pt"><mtr><mtd><msub><mi>𝑰</mi><mrow><mi>d</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>d</mi></mrow></msub></mtd><mtd><msub><mn>𝟏</mn><mrow><mi>d</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mn>1</mn></mrow></msub></mtd></mtr></mtable><mo>)</mo></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\boldsymbol{W}_{1}:=\begin{pmatrix}\boldsymbol{I}_{d\times d}&amp;\boldsymbol{1}_{d\times 1}\end{pmatrix}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S3.SS1.p23.4" class="ltx_p"><span id="S3.SS1.p23.4.1" class="ltx_text">The weight bounds of <math id="S3.SS1.p23.m1" class="ltx_Math" alttext="\boldsymbol{T}^{(prl)}" display="inline" intent=":literal"><semantics><msup><mi>𝑻</mi><mrow><mo stretchy="false">(</mo><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>l</mi></mrow><mo stretchy="false">)</mo></mrow></msup><annotation encoding="application/x-tex">\boldsymbol{T}^{(prl)}</annotation></semantics></math> are <math id="S3.SS1.p23.m2" class="ltx_Math" alttext="B_{FF}=C(\boldsymbol{f})d^{2}n^{7}K^{6dn+2},B_{SA}=\frac{1}{2}\log(3{d}{\pi}n^{4}(3n+1)K^{4dn+1})" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>B</mi><mrow><mi>F</mi><mo lspace="0em" rspace="0em">​</mo><mi>F</mi></mrow></msub><mo>=</mo><mrow><mrow><mi>C</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝒇</mi><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mi>d</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>n</mi><mn>7</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>K</mi><mrow><mrow><mn>6</mn><mo lspace="0em" rspace="0em">​</mo><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow><mo>+</mo><mn>2</mn></mrow></msup></mrow></mrow><mo>,</mo><mrow><msub><mi>B</mi><mrow><mi>S</mi><mo lspace="0em" rspace="0em">​</mo><mi>A</mi></mrow></msub><mo>=</mo><mrow><mfrac><mn>1</mn><mn>2</mn></mfrac><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>log</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mn>3</mn><mo lspace="0em" rspace="0em">​</mo><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>π</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>n</mi><mn>4</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mn>3</mn><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mi>K</mi><mrow><mrow><mn>4</mn><mo lspace="0em" rspace="0em">​</mo><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow><mo>+</mo><mn>1</mn></mrow></msup></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">B_{FF}=C(\boldsymbol{f})d^{2}n^{7}K^{6dn+2},B_{SA}=\frac{1}{2}\log(3{d}{\pi}n^{4}(3n+1)K^{4dn+1})</annotation></semantics></math>. For <math id="S3.SS1.p23.m3" class="ltx_Math" alttext="\boldsymbol{X}\in\Omega_{j}" display="inline" intent=":literal"><semantics><mrow><mi>𝑿</mi><mo>∈</mo><msub><mi mathvariant="normal">Ω</mi><mi>j</mi></msub></mrow><annotation encoding="application/x-tex">\boldsymbol{X}\in\Omega_{j}</annotation></semantics></math> with some <math id="S3.SS1.p23.m4" class="ltx_Math" alttext="j\in\left[K^{dn}\right]" display="inline" intent=":literal"><semantics><mrow><mi>j</mi><mo>∈</mo><mrow><mo>[</mo><msup><mi>K</mi><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow></msup><mo>]</mo></mrow></mrow><annotation encoding="application/x-tex">j\in\left[K^{dn}\right]</annotation></semantics></math>,</span></p>
<table id="S3.EGx96" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="S3.Ex139"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S3.Ex139.m1" class="ltx_Math" alttext="\displaystyle\boldsymbol{T}^{(prl)}\circ\boldsymbol{\mathcal{F}}_{FF}^{(mid)}\circ\boldsymbol{\mathcal{F}}_{EB}(\boldsymbol{X})=\begin{pmatrix}\boldsymbol{T}^{(prl-mnm)}\left(\begin{pmatrix}\boldsymbol{X}-\boldsymbol{X}^{(j)}\\
\boldsymbol{I}_{n\times n}-\boldsymbol{1}_{n\times n}\end{pmatrix}\right)\\
\boldsymbol{T}^{(prl-mmr)}\left(\boldsymbol{X}^{(j)}+\boldsymbol{1}_{d\times 1}\boldsymbol{\widetilde{B}}_{EB}\right)\end{pmatrix}." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><msup><mi>𝑻</mi><mrow><mo stretchy="false">(</mo><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>l</mi></mrow><mo stretchy="false">)</mo></mrow></msup><mo lspace="0.222em" rspace="0.222em">∘</mo><msubsup><mi class="ltx_font_mathcaligraphic">𝓕</mi><mrow><mi>F</mi><mo lspace="0em" rspace="0em">​</mo><mi>F</mi></mrow><mrow><mo stretchy="false">(</mo><mrow><mi>m</mi><mo lspace="0em" rspace="0em">​</mo><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>d</mi></mrow><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0.222em" rspace="0.222em">∘</mo><mrow><msub><mi class="ltx_font_mathcaligraphic">𝓕</mi><mrow><mi>E</mi><mo lspace="0em" rspace="0em">​</mo><mi>B</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝑿</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>=</mo><mrow><mo>(</mo><mtable rowspacing="0pt"><mtr><mtd><mrow><msup><mi>𝑻</mi><mrow><mo stretchy="false">(</mo><mrow><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>l</mi></mrow><mo>−</mo><mrow><mi>m</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><mi>m</mi></mrow></mrow><mo stretchy="false">)</mo></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mo>(</mo><mtable rowspacing="0pt"><mtr><mtd><mrow><mi>𝑿</mi><mo>−</mo><msup><mi>𝑿</mi><mrow><mo stretchy="false">(</mo><mi>j</mi><mo stretchy="false">)</mo></mrow></msup></mrow></mtd></mtr><mtr><mtd><mrow><msub><mi>𝑰</mi><mrow><mi>n</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>n</mi></mrow></msub><mo>−</mo><msub><mn>𝟏</mn><mrow><mi>n</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>n</mi></mrow></msub></mrow></mtd></mtr></mtable><mo>)</mo></mrow><mo>)</mo></mrow></mrow></mtd></mtr><mtr><mtd><mrow><msup><mi>𝑻</mi><mrow><mo stretchy="false">(</mo><mrow><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>l</mi></mrow><mo>−</mo><mrow><mi>m</mi><mo lspace="0em" rspace="0em">​</mo><mi>m</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi></mrow></mrow><mo stretchy="false">)</mo></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><msup><mi>𝑿</mi><mrow><mo stretchy="false">(</mo><mi>j</mi><mo stretchy="false">)</mo></mrow></msup><mo>+</mo><mrow><msub><mn>𝟏</mn><mrow><mi>d</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mn>1</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msub><mover accent="true"><mi>𝑩</mi><mo>~</mo></mover><mrow><mi>E</mi><mo lspace="0em" rspace="0em">​</mo><mi>B</mi></mrow></msub></mrow></mrow><mo>)</mo></mrow></mrow></mtd></mtr></mtable><mo>)</mo></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\boldsymbol{T}^{(prl)}\circ\boldsymbol{\mathcal{F}}_{FF}^{(mid)}\circ\boldsymbol{\mathcal{F}}_{EB}(\boldsymbol{X})=\begin{pmatrix}\boldsymbol{T}^{(prl-mnm)}\left(\begin{pmatrix}\boldsymbol{X}-\boldsymbol{X}^{(j)}\\
\boldsymbol{I}_{n\times n}-\boldsymbol{1}_{n\times n}\end{pmatrix}\right)\\
\boldsymbol{T}^{(prl-mmr)}\left(\boldsymbol{X}^{(j)}+\boldsymbol{1}_{d\times 1}\boldsymbol{\widetilde{B}}_{EB}\right)\end{pmatrix}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S3.SS1.p23.5" class="ltx_p"><span id="S3.SS1.p23.5.1" class="ltx_text">It is worth mentioning that the last feedforward block of <math id="S3.SS1.p23.m5" class="ltx_Math" alttext="\boldsymbol{T}^{(prl)}" display="inline" intent=":literal"><semantics><msup><mi>𝑻</mi><mrow><mo stretchy="false">(</mo><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>l</mi></mrow><mo stretchy="false">)</mo></mrow></msup><annotation encoding="application/x-tex">\boldsymbol{T}^{(prl)}</annotation></semantics></math> has only <math id="S3.SS1.p23.m6" class="ltx_Math" alttext="dC_{s+dn-1}^{dn-1}(nK^{dn}-1)+\max\left\{21\cdot 2^{\lceil\log_{2}(s-1)\rceil-1},2dn\right\}C_{s+dn-1}^{dn-1}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>C</mi><mrow><mrow><mi>s</mi><mo>+</mo><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow></mrow><mo>−</mo><mn>1</mn></mrow><mrow><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow><mo>−</mo><mn>1</mn></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>K</mi><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow></msup></mrow><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mrow><mi>max</mi><mo>⁡</mo><mrow><mrow><mo>{</mo><mrow><mn>21</mn><mo lspace="0.222em" rspace="0.222em">⋅</mo><msup><mn>2</mn><mrow><mrow><mo stretchy="false">⌈</mo><mrow><msub><mi>log</mi><mn>2</mn></msub><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>s</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">⌉</mo></mrow><mo>−</mo><mn>1</mn></mrow></msup></mrow><mo>,</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow><mo>}</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>C</mi><mrow><mrow><mi>s</mi><mo>+</mo><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow></mrow><mo>−</mo><mn>1</mn></mrow><mrow><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow><mo>−</mo><mn>1</mn></mrow></msubsup></mrow></mrow></mrow><annotation encoding="application/x-tex">dC_{s+dn-1}^{dn-1}(nK^{dn}-1)+\max\left\{21\cdot 2^{\lceil\log_{2}(s-1)\rceil-1},2dn\right\}C_{s+dn-1}^{dn-1}</annotation></semantics></math> neurons in the final layer, while the number of neurons in each of the other layers does not exceed <math id="S3.SS1.p23.m7" class="ltx_Math" alttext="10dC_{s+dn-1}^{dn-1}+\max\left\{21\cdot 2^{\lceil\log_{2}(s-1)\rceil-1},2dn\right\}C_{s+dn-1}^{dn-1}" display="inline" intent=":literal"><semantics><mrow><mrow><mn>10</mn><mo lspace="0em" rspace="0em">​</mo><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>C</mi><mrow><mrow><mi>s</mi><mo>+</mo><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow></mrow><mo>−</mo><mn>1</mn></mrow><mrow><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow><mo>−</mo><mn>1</mn></mrow></msubsup></mrow><mo>+</mo><mrow><mi>max</mi><mo>⁡</mo><mrow><mrow><mo>{</mo><mrow><mn>21</mn><mo lspace="0.222em" rspace="0.222em">⋅</mo><msup><mn>2</mn><mrow><mrow><mo stretchy="false">⌈</mo><mrow><msub><mi>log</mi><mn>2</mn></msub><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>s</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">⌉</mo></mrow><mo>−</mo><mn>1</mn></mrow></msup></mrow><mo>,</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow><mo>}</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>C</mi><mrow><mrow><mi>s</mi><mo>+</mo><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow></mrow><mo>−</mo><mn>1</mn></mrow><mrow><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow><mo>−</mo><mn>1</mn></mrow></msubsup></mrow></mrow></mrow><annotation encoding="application/x-tex">10dC_{s+dn-1}^{dn-1}+\max\left\{21\cdot 2^{\lceil\log_{2}(s-1)\rceil-1},2dn\right\}C_{s+dn-1}^{dn-1}</annotation></semantics></math>.</span></p>
</div>
<div id="S3.SS1.p24" class="ltx_para">
<p id="S3.SS1.p24.1" class="ltx_p"><span id="S3.SS1.p24.1.1" class="ltx_text ltx_font_bold">Step 5: Approximate the multiplications of <math id="S3.SS1.p24.m1" class="ltx_Math" alttext="c_{ij}" display="inline" intent=":literal"><semantics><msub><mi>c</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>j</mi></mrow></msub><annotation encoding="application/x-tex">c_{ij}</annotation></semantics></math> and <math id="S3.SS1.p24.m2" class="ltx_Math" alttext="\left(\boldsymbol{X}-\boldsymbol{X}^{(j)}\right)^{\boldsymbol{\alpha}_{i}}" display="inline" intent=":literal"><semantics><msup><mrow><mo>(</mo><mrow><mi>X</mi><mo>−</mo><msup><mi>X</mi><mrow><mo stretchy="false">(</mo><mi>j</mi><mo stretchy="false">)</mo></mrow></msup></mrow><mo>)</mo></mrow><msub><mi>α</mi><mi>i</mi></msub></msup><annotation encoding="application/x-tex">\left(\boldsymbol{X}-\boldsymbol{X}^{(j)}\right)^{\boldsymbol{\alpha}_{i}}</annotation></semantics></math> and sum them over <math id="S3.SS1.p24.m3" class="ltx_Math" alttext="i" display="inline" intent=":literal"><semantics><mi>i</mi><annotation encoding="application/x-tex">i</annotation></semantics></math>.<span id="S3.SS1.p24.1.1.1" class="ltx_text"></span></span></p>
</div>
<div id="S3.SS1.p25" class="ltx_para">
<p id="S3.SS1.p25.1" class="ltx_p"><span id="S3.SS1.p25.1.1" class="ltx_text">We apply Lemma <a href="#Thmlemma10" title="Lemma 10 ([], Proposition 3). ‣ 3.1 Proof of Proposition ‣ 3 Proof of Proposition : Construction of Transformers ‣ Standard Transformers Achieve the Minimax Rate in Nonparametric Regression with 𝐶^{𝑠,𝜆} Targets" class="ltx_ref"><span class="ltx_text ltx_ref_tag">10</span></a> to approximate the multiplications of <math id="S3.SS1.p25.m1" class="ltx_Math" alttext="c_{ij}" display="inline" intent=":literal"><semantics><msub><mi>c</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>j</mi></mrow></msub><annotation encoding="application/x-tex">c_{ij}</annotation></semantics></math> and <math id="S3.SS1.p25.m2" class="ltx_Math" alttext="f_{FF,i}^{(mnm)}\left(\boldsymbol{\bar{X}}^{(flt)}\right)" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>f</mi><mrow><mrow><mi>F</mi><mo lspace="0em" rspace="0em">​</mo><mi>F</mi></mrow><mo>,</mo><mi>i</mi></mrow><mrow><mo stretchy="false">(</mo><mrow><mi>m</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><mi>m</mi></mrow><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><msup><mover accent="true"><mi>𝑿</mi><mo>¯</mo></mover><mrow><mo stretchy="false">(</mo><mrow><mi>f</mi><mo lspace="0em" rspace="0em">​</mo><mi>l</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow><mo stretchy="false">)</mo></mrow></msup><mo>)</mo></mrow></mrow><annotation encoding="application/x-tex">f_{FF,i}^{(mnm)}\left(\boldsymbol{\bar{X}}^{(flt)}\right)</annotation></semantics></math> (the approximant of <math id="S3.SS1.p25.m3" class="ltx_Math" alttext="\left(\boldsymbol{X}-\boldsymbol{X}^{(j)}\right)^{\boldsymbol{\alpha}_{i}}" display="inline" intent=":literal"><semantics><msup><mrow><mo>(</mo><mrow><mi>𝑿</mi><mo>−</mo><msup><mi>𝑿</mi><mrow><mo stretchy="false">(</mo><mi>j</mi><mo stretchy="false">)</mo></mrow></msup></mrow><mo>)</mo></mrow><msub><mi>𝜶</mi><mi>i</mi></msub></msup><annotation encoding="application/x-tex">\left(\boldsymbol{X}-\boldsymbol{X}^{(j)}\right)^{\boldsymbol{\alpha}_{i}}</annotation></semantics></math>). Since <math id="S3.SS1.p25.m4" class="ltx_Math" alttext="|c_{ij}|\leq C(\boldsymbol{f})" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">|</mo><msub><mi>c</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>j</mi></mrow></msub><mo stretchy="false">|</mo></mrow><mo>≤</mo><mrow><mi>C</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝒇</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">|c_{ij}|\leq C(\boldsymbol{f})</annotation></semantics></math> and <math id="S3.SS1.p25.m5" class="ltx_Math" alttext="\left|f_{FF,i}^{(mnm)}\left(\boldsymbol{\bar{X}}^{(flt)}\right)\right|\leq 2" display="inline" intent=":literal"><semantics><mrow><mrow><mo>|</mo><mrow><msubsup><mi>f</mi><mrow><mrow><mi>F</mi><mo lspace="0em" rspace="0em">​</mo><mi>F</mi></mrow><mo>,</mo><mi>i</mi></mrow><mrow><mo stretchy="false">(</mo><mrow><mi>m</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><mi>m</mi></mrow><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><msup><mover accent="true"><mi>𝑿</mi><mo>¯</mo></mover><mrow><mo stretchy="false">(</mo><mrow><mi>f</mi><mo lspace="0em" rspace="0em">​</mo><mi>l</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow><mo stretchy="false">)</mo></mrow></msup><mo>)</mo></mrow></mrow><mo>|</mo></mrow><mo>≤</mo><mn>2</mn></mrow><annotation encoding="application/x-tex">\left|f_{FF,i}^{(mnm)}\left(\boldsymbol{\bar{X}}^{(flt)}\right)\right|\leq 2</annotation></semantics></math> (assuming <math id="S3.SS1.p25.m6" class="ltx_Math" alttext="\epsilon_{1}&lt;1" display="inline" intent=":literal"><semantics><mrow><msub><mi>ϵ</mi><mn>1</mn></msub><mo>&lt;</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">\epsilon_{1}&lt;1</annotation></semantics></math>), we choose <math id="S3.SS1.p25.m7" class="ltx_Math" alttext="B" display="inline" intent=":literal"><semantics><mi>B</mi><annotation encoding="application/x-tex">B</annotation></semantics></math> in Lemma <a href="#Thmlemma10" title="Lemma 10 ([], Proposition 3). ‣ 3.1 Proof of Proposition ‣ 3 Proof of Proposition : Construction of Transformers ‣ Standard Transformers Achieve the Minimax Rate in Nonparametric Regression with 𝐶^{𝑠,𝜆} Targets" class="ltx_ref"><span class="ltx_text ltx_ref_tag">10</span></a> to be <math id="S3.SS1.p25.m8" class="ltx_Math" alttext="C(\boldsymbol{f})" display="inline" intent=":literal"><semantics><mrow><mi>C</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝒇</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">C(\boldsymbol{f})</annotation></semantics></math>. Then according to Lemma <a href="#Thmlemma10" title="Lemma 10 ([], Proposition 3). ‣ 3.1 Proof of Proposition ‣ 3 Proof of Proposition : Construction of Transformers ‣ Standard Transformers Achieve the Minimax Rate in Nonparametric Regression with 𝐶^{𝑠,𝜆} Targets" class="ltx_ref"><span class="ltx_text ltx_ref_tag">10</span></a>, for <math id="S3.SS1.p25.m9" class="ltx_Math" alttext="i=jd+k\in\left[dC_{s+dn-1}^{dn-1}\right]" display="inline" intent=":literal"><semantics><mrow><mi>i</mi><mo>=</mo><mrow><mrow><mi>j</mi><mo lspace="0em" rspace="0em">​</mo><mi>d</mi></mrow><mo>+</mo><mi>k</mi></mrow><mo>∈</mo><mrow><mo>[</mo><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>C</mi><mrow><mrow><mi>s</mi><mo>+</mo><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow></mrow><mo>−</mo><mn>1</mn></mrow><mrow><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow><mo>−</mo><mn>1</mn></mrow></msubsup></mrow><mo>]</mo></mrow></mrow><annotation encoding="application/x-tex">i=jd+k\in\left[dC_{s+dn-1}^{dn-1}\right]</annotation></semantics></math> with some <math id="S3.SS1.p25.m10" class="ltx_Math" alttext="0\leq j\leq C_{s+dn-1}^{dn-1}-1" display="inline" intent=":literal"><semantics><mrow><mn>0</mn><mo>≤</mo><mi>j</mi><mo>≤</mo><mrow><msubsup><mi>C</mi><mrow><mrow><mi>s</mi><mo>+</mo><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow></mrow><mo>−</mo><mn>1</mn></mrow><mrow><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow><mo>−</mo><mn>1</mn></mrow></msubsup><mo>−</mo><mn>1</mn></mrow></mrow><annotation encoding="application/x-tex">0\leq j\leq C_{s+dn-1}^{dn-1}-1</annotation></semantics></math> and <math id="S3.SS1.p25.m11" class="ltx_Math" alttext="1\leq k\leq d" display="inline" intent=":literal"><semantics><mrow><mn>1</mn><mo>≤</mo><mi>k</mi><mo>≤</mo><mi>d</mi></mrow><annotation encoding="application/x-tex">1\leq k\leq d</annotation></semantics></math>, there exists a ReLU FNN <math id="S3.SS1.p25.m12" class="ltx_Math" alttext="f_{FF,i}^{(mtp-two)}:\mathbb{R}^{(d+1)C_{s+dn-1}^{dn-1}}\to\mathbb{R}" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>f</mi><mrow><mrow><mi>F</mi><mo lspace="0em" rspace="0em">​</mo><mi>F</mi></mrow><mo>,</mo><mi>i</mi></mrow><mrow><mo stretchy="false">(</mo><mrow><mrow><mi>m</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi><mo lspace="0em" rspace="0em">​</mo><mi>p</mi></mrow><mo>−</mo><mrow><mi>t</mi><mo lspace="0em" rspace="0em">​</mo><mi>w</mi><mo lspace="0em" rspace="0em">​</mo><mi>o</mi></mrow></mrow><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><msup><mi>ℝ</mi><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>d</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>C</mi><mrow><mrow><mi>s</mi><mo>+</mo><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow></mrow><mo>−</mo><mn>1</mn></mrow><mrow><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow><mo>−</mo><mn>1</mn></mrow></msubsup></mrow></msup><mo stretchy="false">→</mo><mi>ℝ</mi></mrow></mrow><annotation encoding="application/x-tex">f_{FF,i}^{(mtp-two)}:\mathbb{R}^{(d+1)C_{s+dn-1}^{dn-1}}\to\mathbb{R}</annotation></semantics></math> with width <math id="S3.SS1.p25.m13" class="ltx_Math" alttext="\max\left\{21,(d+1)C_{s+dn}^{dn}\right\}" display="inline" intent=":literal"><semantics><mrow><mi>max</mi><mo>⁡</mo><mrow><mo>{</mo><mn>21</mn><mo>,</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>d</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>C</mi><mrow><mi>s</mi><mo>+</mo><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow></mrow><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow></msubsup></mrow><mo>}</mo></mrow></mrow><annotation encoding="application/x-tex">\max\left\{21,(d+1)C_{s+dn}^{dn}\right\}</annotation></semantics></math>, depth <math id="S3.SS1.p25.m14" class="ltx_Math" alttext="C(\boldsymbol{f})\ln\frac{1}{\epsilon_{2}}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>C</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝒇</mi><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>ln</mi><mo lspace="0.167em">⁡</mo><mfrac><mn>1</mn><msub><mi>ϵ</mi><mn>2</mn></msub></mfrac></mrow></mrow><annotation encoding="application/x-tex">C(\boldsymbol{f})\ln\frac{1}{\epsilon_{2}}</annotation></semantics></math> and weight bound <math id="S3.SS1.p25.m15" class="ltx_Math" alttext="C(\boldsymbol{f})" display="inline" intent=":literal"><semantics><mrow><mi>C</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝒇</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">C(\boldsymbol{f})</annotation></semantics></math> such that for any <math id="S3.SS1.p25.m16" class="ltx_Math" alttext="\boldsymbol{x}\in\left[-C(\boldsymbol{f}),C(\boldsymbol{f})\right]^{(d+1)C_{s+dn}^{dn}}" display="inline" intent=":literal"><semantics><mrow><mi>𝒙</mi><mo>∈</mo><msup><mrow><mo>[</mo><mrow><mrow><mo>−</mo><mrow><mi>C</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝒇</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>,</mo><mrow><mi>C</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝒇</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>]</mo></mrow><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>d</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>C</mi><mrow><mi>s</mi><mo>+</mo><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow></mrow><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow></msubsup></mrow></msup></mrow><annotation encoding="application/x-tex">\boldsymbol{x}\in\left[-C(\boldsymbol{f}),C(\boldsymbol{f})\right]^{(d+1)C_{s+dn}^{dn}}</annotation></semantics></math>, <math id="S3.SS1.p25.m17" class="ltx_Math" alttext="f_{FF,i}^{(mtp-two)}(\boldsymbol{x}):=\widetilde{\times}\left(x_{j+1},x_{C_{s+dn-1}^{dn-1}+i}\right)" display="inline" intent=":literal"><semantics><mrow><mrow><msubsup><mi>f</mi><mrow><mrow><mi>F</mi><mo lspace="0em" rspace="0em">​</mo><mi>F</mi></mrow><mo>,</mo><mi>i</mi></mrow><mrow><mo stretchy="false">(</mo><mrow><mrow><mi>m</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi><mo lspace="0em" rspace="0em">​</mo><mi>p</mi></mrow><mo>−</mo><mrow><mi>t</mi><mo lspace="0em" rspace="0em">​</mo><mi>w</mi><mo lspace="0em" rspace="0em">​</mo><mi>o</mi></mrow></mrow><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝒙</mi><mo stretchy="false">)</mo></mrow></mrow><mo rspace="0em">:=</mo><mrow><mover accent="true"><mo lspace="0em">×</mo><mo>~</mo></mover><mo lspace="0.222em" rspace="0em">​</mo><mrow><mo>(</mo><msub><mi>x</mi><mrow><mi>j</mi><mo>+</mo><mn>1</mn></mrow></msub><mo>,</mo><msub><mi>x</mi><mrow><msubsup><mi>C</mi><mrow><mrow><mi>s</mi><mo>+</mo><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow></mrow><mo>−</mo><mn>1</mn></mrow><mrow><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow><mo>−</mo><mn>1</mn></mrow></msubsup><mo>+</mo><mi>i</mi></mrow></msub><mo>)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">f_{FF,i}^{(mtp-two)}(\boldsymbol{x}):=\widetilde{\times}\left(x_{j+1},x_{C_{s+dn-1}^{dn-1}+i}\right)</annotation></semantics></math> and</span></p>
<table id="S3.EGx97" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="S3.E10"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S3.E10.m1" class="ltx_Math" alttext="\displaystyle\left|f_{FF,i}^{(mtp-two)}(\boldsymbol{x})-x_{j+1}x_{C_{s+dn-1}^{dn-1}+i}\right|\leq\epsilon_{2}," display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mo>|</mo><mrow><mrow><msubsup><mi>f</mi><mrow><mrow><mi>F</mi><mo lspace="0em" rspace="0em">​</mo><mi>F</mi></mrow><mo>,</mo><mi>i</mi></mrow><mrow><mo stretchy="false">(</mo><mrow><mrow><mi>m</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi><mo lspace="0em" rspace="0em">​</mo><mi>p</mi></mrow><mo>−</mo><mrow><mi>t</mi><mo lspace="0em" rspace="0em">​</mo><mi>w</mi><mo lspace="0em" rspace="0em">​</mo><mi>o</mi></mrow></mrow><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝒙</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msub><mi>x</mi><mrow><mi>j</mi><mo>+</mo><mn>1</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>x</mi><mrow><msubsup><mi>C</mi><mrow><mrow><mi>s</mi><mo>+</mo><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow></mrow><mo>−</mo><mn>1</mn></mrow><mrow><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow><mo>−</mo><mn>1</mn></mrow></msubsup><mo>+</mo><mi>i</mi></mrow></msub></mrow></mrow><mo>|</mo></mrow><mo>≤</mo><msub><mi>ϵ</mi><mn>2</mn></msub></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\left|f_{FF,i}^{(mtp-two)}(\boldsymbol{x})-x_{j+1}x_{C_{s+dn-1}^{dn-1}+i}\right|\leq\epsilon_{2},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(10)</span></td></tr></tbody>
</table>
<p id="S3.SS1.p25.2" class="ltx_p"><span id="S3.SS1.p25.2.1" class="ltx_text">where <math id="S3.SS1.p25.m18" class="ltx_Math" alttext="\epsilon_{2}" display="inline" intent=":literal"><semantics><msub><mi>ϵ</mi><mn>2</mn></msub><annotation encoding="application/x-tex">\epsilon_{2}</annotation></semantics></math> will be determined later. Let <math id="S3.SS1.p25.m19" class="ltx_Math" alttext="\boldsymbol{\mathcal{F}}_{FF,i}^{(mtp-two)}:\mathbb{R}^{(d+1)C_{s+dn-1}^{dn-1}\times n}\to\mathbb{R}^{1\times n}" display="inline" intent=":literal"><semantics><mrow><msubsup><mi class="ltx_font_mathcaligraphic">𝓕</mi><mrow><mrow><mi>F</mi><mo lspace="0em" rspace="0em">​</mo><mi>F</mi></mrow><mo>,</mo><mi>i</mi></mrow><mrow><mo stretchy="false">(</mo><mrow><mrow><mi>m</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi><mo lspace="0em" rspace="0em">​</mo><mi>p</mi></mrow><mo>−</mo><mrow><mi>t</mi><mo lspace="0em" rspace="0em">​</mo><mi>w</mi><mo lspace="0em" rspace="0em">​</mo><mi>o</mi></mrow></mrow><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><msup><mi>ℝ</mi><mrow><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>d</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>C</mi><mrow><mrow><mi>s</mi><mo>+</mo><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow></mrow><mo>−</mo><mn>1</mn></mrow><mrow><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow><mo>−</mo><mn>1</mn></mrow></msubsup></mrow><mo lspace="0.222em" rspace="0.222em">×</mo><mi>n</mi></mrow></msup><mo stretchy="false">→</mo><msup><mi>ℝ</mi><mrow><mn>1</mn><mo lspace="0.222em" rspace="0.222em">×</mo><mi>n</mi></mrow></msup></mrow></mrow><annotation encoding="application/x-tex">\boldsymbol{\mathcal{F}}_{FF,i}^{(mtp-two)}:\mathbb{R}^{(d+1)C_{s+dn-1}^{dn-1}\times n}\to\mathbb{R}^{1\times n}</annotation></semantics></math> be the feedforward block generated from <math id="S3.SS1.p25.m20" class="ltx_Math" alttext="f_{FF,i}^{(mtp-two)}" display="inline" intent=":literal"><semantics><msubsup><mi>f</mi><mrow><mrow><mi>F</mi><mo lspace="0em" rspace="0em">​</mo><mi>F</mi></mrow><mo>,</mo><mi>i</mi></mrow><mrow><mo stretchy="false">(</mo><mrow><mrow><mi>m</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi><mo lspace="0em" rspace="0em">​</mo><mi>p</mi></mrow><mo>−</mo><mrow><mi>t</mi><mo lspace="0em" rspace="0em">​</mo><mi>w</mi><mo lspace="0em" rspace="0em">​</mo><mi>o</mi></mrow></mrow><mo stretchy="false">)</mo></mrow></msubsup><annotation encoding="application/x-tex">f_{FF,i}^{(mtp-two)}</annotation></semantics></math>.
By Lemma <a href="#Thmlemma3" title="Lemma 3. ‣ 2.2 Proof of Theorem ‣ 2 Proofs of Main Results ‣ Standard Transformers Achieve the Minimax Rate in Nonparametric Regression with 𝐶^{𝑠,𝜆} Targets" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3</span></a>, there exists a feedforward block <math id="S3.SS1.p25.m21" class="ltx_Math" alttext="\boldsymbol{\mathcal{F}}_{FF}^{(prl-mtp)}:\mathbb{R}^{(d+1)C_{s+dn-1}^{dn-1}\times n}\to\mathbb{R}^{dC_{s+dn-1}^{dn-1}\times n}" display="inline" intent=":literal"><semantics><mrow><msubsup><mi class="ltx_font_mathcaligraphic">𝓕</mi><mrow><mi>F</mi><mo lspace="0em" rspace="0em">​</mo><mi>F</mi></mrow><mrow><mo stretchy="false">(</mo><mrow><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>l</mi></mrow><mo>−</mo><mrow><mi>m</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi><mo lspace="0em" rspace="0em">​</mo><mi>p</mi></mrow></mrow><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><msup><mi>ℝ</mi><mrow><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>d</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>C</mi><mrow><mrow><mi>s</mi><mo>+</mo><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow></mrow><mo>−</mo><mn>1</mn></mrow><mrow><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow><mo>−</mo><mn>1</mn></mrow></msubsup></mrow><mo lspace="0.222em" rspace="0.222em">×</mo><mi>n</mi></mrow></msup><mo stretchy="false">→</mo><msup><mi>ℝ</mi><mrow><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>C</mi><mrow><mrow><mi>s</mi><mo>+</mo><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow></mrow><mo>−</mo><mn>1</mn></mrow><mrow><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow><mo>−</mo><mn>1</mn></mrow></msubsup></mrow><mo lspace="0.222em" rspace="0.222em">×</mo><mi>n</mi></mrow></msup></mrow></mrow><annotation encoding="application/x-tex">\boldsymbol{\mathcal{F}}_{FF}^{(prl-mtp)}:\mathbb{R}^{(d+1)C_{s+dn-1}^{dn-1}\times n}\to\mathbb{R}^{dC_{s+dn-1}^{dn-1}\times n}</annotation></semantics></math> with width <math id="S3.SS1.p25.m22" class="ltx_Math" alttext="21dC_{s+dn-1}^{dn-1}" display="inline" intent=":literal"><semantics><mrow><mn>21</mn><mo lspace="0em" rspace="0em">​</mo><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>C</mi><mrow><mrow><mi>s</mi><mo>+</mo><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow></mrow><mo>−</mo><mn>1</mn></mrow><mrow><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow><mo>−</mo><mn>1</mn></mrow></msubsup></mrow><annotation encoding="application/x-tex">21dC_{s+dn-1}^{dn-1}</annotation></semantics></math>, depth <math id="S3.SS1.p25.m23" class="ltx_Math" alttext="C(\boldsymbol{f})\ln\frac{1}{\epsilon_{2}}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>C</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝒇</mi><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>ln</mi><mo lspace="0.167em">⁡</mo><mfrac><mn>1</mn><msub><mi>ϵ</mi><mn>2</mn></msub></mfrac></mrow></mrow><annotation encoding="application/x-tex">C(\boldsymbol{f})\ln\frac{1}{\epsilon_{2}}</annotation></semantics></math> and weight bound <math id="S3.SS1.p25.m24" class="ltx_Math" alttext="C(\boldsymbol{f})" display="inline" intent=":literal"><semantics><mrow><mi>C</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝒇</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">C(\boldsymbol{f})</annotation></semantics></math> such that</span></p>
