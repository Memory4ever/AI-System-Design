<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S7.Ex400.m1" class="ltx_Math" alttext="\displaystyle\left\|\boldsymbol{\mathcal{\widetilde{F}}}_{SA}(\boldsymbol{Y})-\boldsymbol{\mathcal{F}}_{SA}(\boldsymbol{Y})\right\|_{F}" display="inline" intent=":literal"><semantics><msub><mrow><mo>‖</mo><mrow><mrow><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">𝓕</mi><mo>~</mo></mover><mrow><mi>S</mi><mo lspace="0em" rspace="0em">​</mo><mi>A</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝒀</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msub><mi class="ltx_font_mathcaligraphic">𝓕</mi><mrow><mi>S</mi><mo lspace="0em" rspace="0em">​</mo><mi>A</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝒀</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>‖</mo></mrow><mi>F</mi></msub><annotation encoding="application/x-tex">\displaystyle\left\|\boldsymbol{\mathcal{\widetilde{F}}}_{SA}(\boldsymbol{Y})-\boldsymbol{\mathcal{F}}_{SA}(\boldsymbol{Y})\right\|_{F}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
