w></msubsup><mo>)</mo></mrow></mrow></mrow></mtd><mtd><mrow><msubsup><mo maxsize="0.900em" minsize="0.900em" stretchy="true">∑</mo><mrow><mi mathsize="0.900em">i</mi><mo mathsize="0.900em">=</mo><mn mathsize="0.900em">1</mn></mrow><msubsup><mi mathsize="0.900em">C</mi><mrow><mrow><mi mathsize="0.900em">s</mi><mo mathsize="0.900em">+</mo><mrow><mi mathsize="0.900em">d</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">n</mi></mrow></mrow><mo mathsize="0.900em">−</mo><mn mathsize="0.900em">1</mn></mrow><mrow><mrow><mi mathsize="0.900em">d</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">n</mi></mrow><mo mathsize="0.900em">−</mo><mn mathsize="0.900em">1</mn></mrow></msubsup></msubsup><mrow><mover accent="true"><mo lspace="0em" mathsize="0.900em">×</mo><mo>~</mo></mover><mo lspace="0.222em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><msub><mi mathsize="0.900em">c</mi><mrow><mi mathsize="0.900em">i</mi><mo mathsize="0.900em">,</mo><mi mathsize="0.900em">j</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><msub><mi mathsize="0.900em">f</mi><mrow><mi mathsize="0.900em">d</mi><mo lspace="0em" rspace="0em">​</mo><mn mathsize="0.900em">2</mn></mrow></msub><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow></mrow><mo mathsize="0.900em">,</mo><msubsup><mi mathsize="0.900em">f</mi><mi mathsize="0.900em">i</mi><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><mrow><mi mathsize="0.900em">m</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">n</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">m</mi></mrow><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow></msubsup><mo>)</mo></mrow></mrow></mrow></mtd><mtd><mo mathsize="0.900em">⋯</mo></mtd><mtd><mrow><msubsup><mo maxsize="0.900em" minsize="0.900em" stretchy="true">∑</mo><mrow><mi mathsize="0.900em">i</mi><mo mathsize="0.900em">=</mo><mn mathsize="0.900em">1</mn></mrow><msubsup><mi mathsize="0.900em">C</mi><mrow><mrow><mi mathsize="0.900em">s</mi><mo mathsize="0.900em">+</mo><mrow><mi mathsize="0.900em">d</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">n</mi></mrow></mrow><mo mathsize="0.900em">−</mo><mn mathsize="0.900em">1</mn></mrow><mrow><mrow><mi mathsize="0.900em">d</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">n</mi></mrow><mo mathsize="0.900em">−</mo><mn mathsize="0.900em">1</mn></mrow></msubsup></msubsup><mrow><mover accent="true"><mo lspace="0em" mathsize="0.900em">×</mo><mo>~</mo></mover><mo lspace="0.222em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><msub><mi mathsize="0.900em">c</mi><mrow><mi mathsize="0.900em">i</mi><mo mathsize="0.900em">,</mo><mi mathsize="0.900em">j</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><msub><mi mathsize="0.900em">f</mi><mrow><mi mathsize="0.900em">d</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">n</mi></mrow></msub><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow></mrow><mo mathsize="0.900em">,</mo><msubsup><mi mathsize="0.900em">f</mi><mi mathsize="0.900em">i</mi><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><mrow><mi mathsize="0.900em">m</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">n</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">m</mi></mrow><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow></msubsup><mo>)</mo></mrow></mrow></mrow></mtd></mtr></mtable><mo>)</mo></mrow><mo lspace="0em" mathsize="0.900em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\begin{pmatrix}\sum_{i=1}^{C_{s+dn-1}^{dn-1}}\widetilde{\times}\left(c_{i,j}(f_{11}),f_{i}^{(mnm)}\right)&amp;\sum_{i=1}^{C_{s+dn-1}^{dn-1}}\widetilde{\times}\left(c_{i,j}(f_{12}),f_{i}^{(mnm)}\right)&amp;\cdots&amp;\sum_{i=1}^{C_{s+dn-1}^{dn-1}}\widetilde{\times}\left(c_{i,j}(f_{1n}),f_{i}^{(mnm)}\right)\\
\sum_{i=1}^{C_{s+dn-1}^{dn-1}}\widetilde{\times}\left(c_{i,j}(f_{21}),f_{i}^{(mnm)}\right)&amp;\sum_{i=1}^{C_{s+dn-1}^{dn-1}}\widetilde{\times}\left(c_{i,j}(f_{22}),f_{i}^{(mnm)}\right)&amp;\cdots&amp;\sum_{i=1}^{C_{s+dn-1}^{dn-1}}\widetilde{\times}\left(c_{i,j}(f_{2n}),f_{i}^{(mnm)}\right)\\
\vdots&amp;\vdots&amp;\ddots&amp;\vdots\\
\sum_{i=1}^{C_{s+dn-1}^{dn-1}}\widetilde{\times}\left(c_{i,j}(f_{d1}),f_{i}^{(mnm)}\right)&amp;\sum_{i=1}^{C_{s+dn-1}^{dn-1}}\widetilde{\times}\left(c_{i,j}(f_{d2}),f_{i}^{(mnm)}\right)&amp;\cdots&amp;\sum_{i=1}^{C_{s+dn-1}^{dn-1}}\widetilde{\times}\left(c_{i,j}(f_{dn}),f_{i}^{(mnm)}\right)\end{pmatrix}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S3.SS1.p26.1" class="ltx_p"><span id="S3.SS1.p26.1.1" class="ltx_text">The Transformer <math id="S3.SS1.p26.m1" class="ltx_Math" alttext="\boldsymbol{T}" display="inline" intent=":literal"><semantics><mi>𝑻</mi><annotation encoding="application/x-tex">\boldsymbol{T}</annotation></semantics></math> we are going to find is exactly defined as</span></p>
<table id="S3.EGx102" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="S3.Ex146"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S3.Ex146.m1" class="ltx_Math" alttext="\displaystyle\boldsymbol{T}(\boldsymbol{X}):=\boldsymbol{W}^{(sum)}\boldsymbol{\mathcal{F}}_{FF}^{(prl-mtp)}\circ\boldsymbol{T}^{(prl)}\circ\boldsymbol{\mathcal{F}}_{FF}^{(mid)}\circ\boldsymbol{\mathcal{F}}_{EB}(\boldsymbol{X})." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mi>𝑻</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝑿</mi><mo stretchy="false">)</mo></mrow></mrow><mo>:=</mo><mrow><mrow><msup><mi>𝑾</mi><mrow><mo stretchy="false">(</mo><mrow><mi>s</mi><mo lspace="0em" rspace="0em">​</mo><mi>u</mi><mo lspace="0em" rspace="0em">​</mo><mi>m</mi></mrow><mo stretchy="false">)</mo></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi class="ltx_font_mathcaligraphic">𝓕</mi><mrow><mi>F</mi><mo lspace="0em" rspace="0em">​</mo><mi>F</mi></mrow><mrow><mo stretchy="false">(</mo><mrow><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>l</mi></mrow><mo>−</mo><mrow><mi>m</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi><mo lspace="0em" rspace="0em">​</mo><mi>p</mi></mrow></mrow><mo stretchy="false">)</mo></mrow></msubsup></mrow><mo lspace="0.222em" rspace="0.222em">∘</mo><msup><mi>𝑻</mi><mrow><mo stretchy="false">(</mo><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>l</mi></mrow><mo stretchy="false">)</mo></mrow></msup><mo lspace="0.222em" rspace="0.222em">∘</mo><msubsup><mi class="ltx_font_mathcaligraphic">𝓕</mi><mrow><mi>F</mi><mo lspace="0em" rspace="0em">​</mo><mi>F</mi></mrow><mrow><mo stretchy="false">(</mo><mrow><mi>m</mi><mo lspace="0em" rspace="0em">​</mo><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>d</mi></mrow><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0.222em" rspace="0.222em">∘</mo><mrow><msub><mi class="ltx_font_mathcaligraphic">𝓕</mi><mrow><mi>E</mi><mo lspace="0em" rspace="0em">​</mo><mi>B</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝑿</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\boldsymbol{T}(\boldsymbol{X}):=\boldsymbol{W}^{(sum)}\boldsymbol{\mathcal{F}}_{FF}^{(prl-mtp)}\circ\boldsymbol{T}^{(prl)}\circ\boldsymbol{\mathcal{F}}_{FF}^{(mid)}\circ\boldsymbol{\mathcal{F}}_{EB}(\boldsymbol{X}).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S3.SS1.p26.2" class="ltx_p"><span id="S3.SS1.p26.2.1" class="ltx_text">Its size is</span></p>
<table id="S3.EGx103" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="S3.Ex147"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S3.Ex147.m1" class="ltx_Math" alttext="\displaystyle L_{0}" display="inline" intent=":literal"><semantics><msub><mi>L</mi><mn>0</mn></msub><annotation encoding="application/x-tex">\displaystyle L_{0}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S3.Ex147.m2" class="ltx_Math" alttext="\displaystyle=4,\quad W_{0}=\max\{(K+2)d+2n+2,dC_{s+dn-1}^{dn-1}\left[\max\{d+1,5\}+2n\right]\};" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mphantom></mphantom><mo>=</mo><mn>4</mn></mrow><mo rspace="1.167em">,</mo><mrow><msub><mi>W</mi><mn>0</mn></msub><mo>=</mo><mrow><mi>max</mi><mo>⁡</mo><mrow><mo stretchy="false">{</mo><mrow><mrow><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>K</mi><mo>+</mo><mn>2</mn></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>d</mi></mrow><mo>+</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow><mo>+</mo><mn>2</mn></mrow><mo>,</mo><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>C</mi><mrow><mrow><mi>s</mi><mo>+</mo><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow></mrow><mo>−</mo><mn>1</mn></mrow><mrow><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow><mo>−</mo><mn>1</mn></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><mrow><mrow><mi>max</mi><mo>⁡</mo><mrow><mo stretchy="false">{</mo><mrow><mrow><mi>d</mi><mo>+</mo><mn>1</mn></mrow><mo>,</mo><mn>5</mn></mrow><mo stretchy="false">}</mo></mrow></mrow><mo>+</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow></mrow><mo>]</mo></mrow></mrow></mrow><mo stretchy="false">}</mo></mrow></mrow></mrow></mrow><mo>;</mo></mrow><annotation encoding="application/x-tex">\displaystyle=4,\quad W_{0}=\max\{(K+2)d+2n+2,dC_{s+dn-1}^{dn-1}\left[\max\{d+1,5\}+2n\right]\};</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="S3.Ex148"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S3.Ex148.m1" class="ltx_Math" alttext="\displaystyle H_{1}" display="inline" intent=":literal"><semantics><msub><mi>H</mi><mn>1</mn></msub><annotation encoding="application/x-tex">\displaystyle H_{1}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S3.Ex148.m2" class="ltx_Math" alttext="\displaystyle=(3d+1)C_{s+dn-1}^{dn-1},\quad S_{1}=\max\{dn,3\};" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mrow><mn>3</mn><mo lspace="0em" rspace="0em">​</mo><mi>d</mi></mrow><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>C</mi><mrow><mrow><mi>s</mi><mo>+</mo><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow></mrow><mo>−</mo><mn>1</mn></mrow><mrow><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow><mo>−</mo><mn>1</mn></mrow></msubsup></mrow></mrow><mo rspace="1.167em">,</mo><mrow><msub><mi>S</mi><mn>1</mn></msub><mo>=</mo><mrow><mi>max</mi><mo>⁡</mo><mrow><mo stretchy="false">{</mo><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow><mo>,</mo><mn>3</mn><mo stretchy="false">}</mo></mrow></mrow></mrow></mrow><mo>;</mo></mrow><annotation encoding="application/x-tex">\displaystyle=(3d+1)C_{s+dn-1}^{dn-1},\quad S_{1}=\max\{dn,3\};</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="S3.Ex149"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S3.Ex149.m1" class="ltx_Math" alttext="\displaystyle L_{l}" display="inline" intent=":literal"><semantics><msub><mi>L</mi><mi>l</mi></msub><annotation encoding="application/x-tex">\displaystyle L_{l}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S3.Ex149.m2" class="ltx_math_unparsed" alttext="\displaystyle=3,\quad W_{l}=dC_{s+dn-1}^{dn-1}(4n+11);\quad l=1,\cdots,n-1;" display="inline" intent=":literal"><semantics><mrow><mo>=</mo><mn>3</mn><mo rspace="1.167em">,</mo><msub><mi>W</mi><mi>l</mi></msub><mo>=</mo><mi>d</mi><msubsup><mi>C</mi><mrow><mrow><mi>s</mi><mo>+</mo><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow></mrow><mo>−</mo><mn>1</mn></mrow><mrow><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow><mo>−</mo><mn>1</mn></mrow></msubsup><mrow><mo stretchy="false">(</mo><mn>4</mn><mi>n</mi><mo>+</mo><mn>11</mn><mo stretchy="false">)</mo></mrow><mo rspace="1.167em">;</mo><mi>l</mi><mo>=</mo><mn>1</mn><mo>,</mo><mo lspace="0em" rspace="0em">⋯</mo><mo>,</mo><mi>n</mi><mo>−</mo><mn>1</mn><mo>;</mo></mrow><annotation encoding="application/x-tex">\displaystyle=3,\quad W_{l}=dC_{s+dn-1}^{dn-1}(4n+11);\quad l=1,\cdots,n-1;</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="S3.Ex150"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S3.Ex150.m1" class="ltx_Math" alttext="\displaystyle H_{l}" display="inline" intent=":literal"><semantics><msub><mi>H</mi><mi>l</mi></msub><annotation encoding="application/x-tex">\displaystyle H_{l}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S3.Ex150.m2" class="ltx_math_unparsed" alttext="\displaystyle=3dC_{s+dn-1}^{dn-1},\quad S_{l}=3;\quad l=2,\cdots,n;" display="inline" intent=":literal"><semantics><mrow><mo>=</mo><mn>3</mn><mi>d</mi><mi>C</mi><msub><mrow></mrow><mrow><mrow><mi>s</mi><mo>+</mo><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow></mrow><mo>−</mo><mn>1</mn></mrow></msub><msup><mrow></mrow><mrow><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow><mo>−</mo><mn>1</mn></mrow></msup><mo rspace="1.167em">,</mo><mi>S</mi><msub><mrow></mrow><mi>l</mi></msub><mo>=</mo><mn>3</mn><mo rspace="1.167em">;</mo><mi>l</mi><mo>=</mo><mn>2</mn><mo>,</mo><mo lspace="0em" rspace="0em">⋯</mo><mo>,</mo><mi>n</mi><mo>;</mo></mrow><annotation encoding="application/x-tex">\displaystyle=3dC_{s+dn-1}^{dn-1},\quad S_{l}=3;\quad l=2,\cdots,n;</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="S3.Ex151"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S3.Ex151.m1" class="ltx_Math" alttext="\displaystyle L_{n}" display="inline" intent=":literal"><semantics><msub><mi>L</mi><mi>n</mi></msub><annotation encoding="application/x-tex">\displaystyle L_{n}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S3.Ex151.m2" class="ltx_Math" alttext="\displaystyle=C\ln\frac{3^{\lceil\log_{2}(s-1)\rceil}-1}{2\epsilon_{1}}+C(\boldsymbol{f})\ln\frac{1}{\epsilon_{2}}," display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><mi>C</mi><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>ln</mi><mo lspace="0.167em">⁡</mo><mstyle displaystyle="true"><mfrac><mrow><msup><mn>3</mn><mrow><mo stretchy="false">⌈</mo><mrow><msub><mi>log</mi><mn>2</mn></msub><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>s</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">⌉</mo></mrow></msup><mo>−</mo><mn>1</mn></mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>ϵ</mi><mn>1</mn></msub></mrow></mfrac></mstyle></mrow></mrow><mo>+</mo><mrow><mrow><mi>C</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝒇</mi><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>ln</mi><mo lspace="0.167em">⁡</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><msub><mi>ϵ</mi><mn>2</mn></msub></mfrac></mstyle></mrow></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle=C\ln\frac{3^{\lceil\log_{2}(s-1)\rceil}-1}{2\epsilon_{1}}+C(\boldsymbol{f})\ln\frac{1}{\epsilon_{2}},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="S3.Ex152"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S3.Ex152.m1" class="ltx_Math" alttext="\displaystyle W_{n}" display="inline" intent=":literal"><semantics><msub><mi>W</mi><mi>n</mi></msub><annotation encoding="application/x-tex">\displaystyle W_{n}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S3.Ex152.m2" class="ltx_Math" alttext="\displaystyle=dC_{s+dn-1}^{dn-1}(nK^{dn}-1)+\max\left\{21\cdot 2^{\lceil\log_{2}(s-1)\rceil-1},2dn,21d\right\}C_{s+dn-1}^{dn-1}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>C</mi><mrow><mrow><mi>s</mi><mo>+</mo><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow></mrow><mo>−</mo><mn>1</mn></mrow><mrow><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow><mo>−</mo><mn>1</mn></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>K</mi><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow></msup></mrow><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mrow><mi>max</mi><mo>⁡</mo><mrow><mrow><mo>{</mo><mrow><mn>21</mn><mo lspace="0.222em" rspace="0.222em">⋅</mo><msup><mn>2</mn><mrow><mrow><mo stretchy="false">⌈</mo><mrow><msub><mi>log</mi><mn>2</mn></msub><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>s</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">⌉</mo></mrow><mo>−</mo><mn>1</mn></mrow></msup></mrow><mo>,</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow><mo>,</mo><mrow><mn>21</mn><mo lspace="0em" rspace="0em">​</mo><mi>d</mi></mrow><mo>}</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>C</mi><mrow><mrow><mi>s</mi><mo>+</mo><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow></mrow><mo>−</mo><mn>1</mn></mrow><mrow><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow><mo>−</mo><mn>1</mn></mrow></msubsup></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=dC_{s+dn-1}^{dn-1}(nK^{dn}-1)+\max\left\{21\cdot 2^{\lceil\log_{2}(s-1)\rceil-1},2dn,21d\right\}C_{s+dn-1}^{dn-1}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S3.SS1.p26.3" class="ltx_p"><span id="S3.SS1.p26.3.1" class="ltx_text">and its dimension vector is</span></p>
<table id="S3.EGx104" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="S3.Ex153"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S3.Ex153.m1" class="ltx_Math" alttext="\displaystyle\begin{pmatrix}d&amp;d+n+1&amp;(2dn+5d)C_{s+dn-1}^{dn-1}\cdot\boldsymbol{1}_{1\times n}&amp;d\end{pmatrix}." display="inline" intent=":literal"><semantics><mrow><mrow><mo>(</mo><mtable columnspacing="5pt"><mtr><mtd><mi>d</mi></mtd><mtd><mrow><mi>d</mi><mo>+</mo><mi>n</mi><mo>+</mo><mn>1</mn></mrow></mtd><mtd><mrow><mrow><mrow><mo stretchy="false">(</mo><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow><mo>+</mo><mrow><mn>5</mn><mo lspace="0em" rspace="0em">​</mo><mi>d</mi></mrow></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>C</mi><mrow><mrow><mi>s</mi><mo>+</mo><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow></mrow><mo>−</mo><mn>1</mn></mrow><mrow><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow><mo>−</mo><mn>1</mn></mrow></msubsup></mrow><mo lspace="0.222em" rspace="0.222em">⋅</mo><msub><mn>𝟏</mn><mrow><mn>1</mn><mo lspace="0.222em" rspace="0.222em">×</mo><mi>n</mi></mrow></msub></mrow></mtd><mtd><mi>d</mi></mtd></mtr></mtable><mo>)</mo></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\begin{pmatrix}d&amp;d+n+1&amp;(2dn+5d)C_{s+dn-1}^{dn-1}\cdot\boldsymbol{1}_{1\times n}&amp;d\end{pmatrix}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S3.SS1.p26.4" class="ltx_p"><span id="S3.SS1.p26.4.1" class="ltx_text">The weight bounds of <math id="S3.SS1.p26.m2" class="ltx_Math" alttext="\boldsymbol{T}" display="inline" intent=":literal"><semantics><mi>𝑻</mi><annotation encoding="application/x-tex">\boldsymbol{T}</annotation></semantics></math> are <math id="S3.SS1.p26.m3" class="ltx_Math" alttext="B_{FF}=\max\left\{C(\boldsymbol{f})d^{2}n^{7}K^{6dn+2},1/\delta\right\},B_{SA}=\frac{1}{2}\log(3{d}{\pi}n^{4}(3n+1)K^{4dn+1})" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>B</mi><mrow><mi>F</mi><mo lspace="0em" rspace="0em">​</mo><mi>F</mi></mrow></msub><mo>=</mo><mrow><mi>max</mi><mo>⁡</mo><mrow><mo>{</mo><mrow><mrow><mi>C</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝒇</mi><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mi>d</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>n</mi><mn>7</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>K</mi><mrow><mrow><mn>6</mn><mo lspace="0em" rspace="0em">​</mo><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow><mo>+</mo><mn>2</mn></mrow></msup></mrow><mo>,</mo><mrow><mn>1</mn><mo>/</mo><mi>δ</mi></mrow><mo>}</mo></mrow></mrow></mrow><mo>,</mo><mrow><msub><mi>B</mi><mrow><mi>S</mi><mo lspace="0em" rspace="0em">​</mo><mi>A</mi></mrow></msub><mo>=</mo><mrow><mfrac><mn>1</mn><mn>2</mn></mfrac><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>log</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mn>3</mn><mo lspace="0em" rspace="0em">​</mo><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>π</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>n</mi><mn>4</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mn>3</mn><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mi>K</mi><mrow><mrow><mn>4</mn><mo lspace="0em" rspace="0em">​</mo><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow><mo>+</mo><mn>1</mn></mrow></msup></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">B_{FF}=\max\left\{C(\boldsymbol{f})d^{2}n^{7}K^{6dn+2},1/\delta\right\},B_{SA}=\frac{1}{2}\log(3{d}{\pi}n^{4}(3n+1)K^{4dn+1})</annotation></semantics></math>.</span></p>
</div>
<div id="S3.SS1.p27" class="ltx_para">
<p id="S3.SS1.p27.1" class="ltx_p"><span id="S3.SS1.p27.1.1" class="ltx_text">It is worth mentioning that the last feedforward block of <math id="S3.SS1.p27.m1" class="ltx_Math" alttext="\boldsymbol{T}" display="inline" intent=":literal"><semantics><mi>𝑻</mi><annotation encoding="application/x-tex">\boldsymbol{T}</annotation></semantics></math> has only <math id="S3.SS1.p27.m2" class="ltx_Math" alttext="dC_{s+dn-1}^{dn-1}(nK^{dn}-1)+\max\left\{21\cdot 2^{\lceil\log_{2}(s-1)\rceil-1},2dn,21d\right\}C_{s+dn-1}^{dn-1}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>C</mi><mrow><mrow><mi>s</mi><mo>+</mo><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow></mrow><mo>−</mo><mn>1</mn></mrow><mrow><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow><mo>−</mo><mn>1</mn></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>K</mi><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow></msup></mrow><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mrow><mi>max</mi><mo>⁡</mo><mrow><mrow><mo>{</mo><mrow><mn>21</mn><mo lspace="0.222em" rspace="0.222em">⋅</mo><msup><mn>2</mn><mrow><mrow><mo stretchy="false">⌈</mo><mrow><msub><mi>log</mi><mn>2</mn></msub><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>s</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">⌉</mo></mrow><mo>−</mo><mn>1</mn></mrow></msup></mrow><mo>,</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow><mo>,</mo><mrow><mn>21</mn><mo lspace="0em" rspace="0em">​</mo><mi>d</mi></mrow><mo>}</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>C</mi><mrow><mrow><mi>s</mi><mo>+</mo><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow></mrow><mo>−</mo><mn>1</mn></mrow><mrow><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow><mo>−</mo><mn>1</mn></mrow></msubsup></mrow></mrow></mrow><annotation encoding="application/x-tex">dC_{s+dn-1}^{dn-1}(nK^{dn}-1)+\max\left\{21\cdot 2^{\lceil\log_{2}(s-1)\rceil-1},2dn,21d\right\}C_{s+dn-1}^{dn-1}</annotation></semantics></math> neurons in a certain layer, while the number of neurons in each of the other layers does not exceed <math id="S3.SS1.p27.m3" class="ltx_Math" alttext="10dC_{s+dn-1}^{dn-1}\linebreak+\max\left\{21\cdot 2^{\lceil\log_{2}(s-1)\rceil-1},2dn,21d\right\}C_{s+dn-1}^{dn-1}" display="inline" intent=":literal"><semantics><mrow><mrow><mn>10</mn><mo lspace="0em" rspace="0em">​</mo><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>C</mi><mrow><mrow><mi>s</mi><mo>+</mo><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow></mrow><mo>−</mo><mn>1</mn></mrow><mrow><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow><mo>−</mo><mn>1</mn></mrow></msubsup></mrow><mo>+</mo><mrow><mi>max</mi><mo>⁡</mo><mrow><mrow><mo>{</mo><mrow><mn>21</mn><mo lspace="0.222em" rspace="0.222em">⋅</mo><msup><mn>2</mn><mrow><mrow><mo stretchy="false">⌈</mo><mrow><msub><mi>log</mi><mn>2</mn></msub><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>s</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">⌉</mo></mrow><mo>−</mo><mn>1</mn></mrow></msup></mrow><mo>,</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow><mo>,</mo><mrow><mn>21</mn><mo lspace="0em" rspace="0em">​</mo><mi>d</mi></mrow><mo>}</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>C</mi><mrow><mrow><mi>s</mi><mo>+</mo><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow></mrow><mo>−</mo><mn>1</mn></mrow><mrow><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow><mo>−</mo><mn>1</mn></mrow></msubsup></mrow></mrow></mrow><annotation encoding="application/x-tex">10dC_{s+dn-1}^{dn-1}\linebreak+\max\left\{21\cdot 2^{\lceil\log_{2}(s-1)\rceil-1},2dn,21d\right\}C_{s+dn-1}^{dn-1}</annotation></semantics></math>.</span></p>
</div>
<div id="S3.SS1.p28" class="ltx_para">
<p id="S3.SS1.p28.1" class="ltx_p"><span id="S3.SS1.p28.1.1" class="ltx_text ltx_font_bold">Step 6: Estimate the approximation error on <math id="S3.SS1.p28.m1" class="ltx_Math" alttext="\bigcup_{j\in[K^{dn}]}\Omega_{j}" display="inline" intent=":literal"><semantics><mrow><msub><mo>⋃</mo><mrow><mi>j</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><msup><mi>K</mi><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow></msup><mo stretchy="false">]</mo></mrow></mrow></msub><msub><mi mathvariant="normal">Ω</mi><mi>j</mi></msub></mrow><annotation encoding="application/x-tex">\bigcup_{j\in[K^{dn}]}\Omega_{j}</annotation></semantics></math>.<span id="S3.SS1.p28.1.1.1" class="ltx_text"></span></span></p>
</div>
<div id="S3.SS1.p29" class="ltx_para">
<p id="S3.SS1.p29.1" class="ltx_p"><span id="S3.SS1.p29.1.1" class="ltx_text">Let <math id="S3.SS1.p29.m1" class="ltx_Math" alttext="p\in[d],q\in[n]" display="inline" intent=":literal"><semantics><mrow><mrow><mi>p</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mi>d</mi><mo stretchy="false">]</mo></mrow></mrow><mo>,</mo><mrow><mi>q</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mi>n</mi><mo stretchy="false">]</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">p\in[d],q\in[n]</annotation></semantics></math>. For <math id="S3.SS1.p29.m2" class="ltx_Math" alttext="\boldsymbol{X}\in\Omega_{j}" display="inline" intent=":literal"><semantics><mrow><mi>𝑿</mi><mo>∈</mo><msub><mi mathvariant="normal">Ω</mi><mi>j</mi></msub></mrow><annotation encoding="application/x-tex">\boldsymbol{X}\in\Omega_{j}</annotation></semantics></math> with some <math id="S3.SS1.p29.m3" class="ltx_Math" alttext="j\in\left[K^{dn}\right]" display="inline" intent=":literal"><semantics><mrow><mi>j</mi><mo>∈</mo><mrow><mo>[</mo><msup><mi>K</mi><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow></msup><mo>]</mo></mrow></mrow><annotation encoding="application/x-tex">j\in\left[K^{dn}\right]</annotation></semantics></math>, combining (<a href="#S3.E8" title="In 3.1 Proof of Proposition ‣ 3 Proof of Proposition : Construction of Transformers ‣ Standard Transformers Achieve the Minimax Rate in Nonparametric Regression with 𝐶^{𝑠,𝜆} Targets" class="ltx_ref"><span class="ltx_text ltx_ref_tag">8</span></a>)(<a href="#S3.E9" title="In Proof of Proposition . ‣ 3.1 Proof of Proposition ‣ 3 Proof of Proposition : Construction of Transformers ‣ Standard Transformers Achieve the Minimax Rate in Nonparametric Regression with 𝐶^{𝑠,𝜆} Targets" class="ltx_ref"><span class="ltx_text ltx_ref_tag">9</span></a>)(<a href="#S3.E10" title="In Proof of Proposition . ‣ 3.1 Proof of Proposition ‣ 3 Proof of Proposition : Construction of Transformers ‣ Standard Transformers Achieve the Minimax Rate in Nonparametric Regression with 𝐶^{𝑠,𝜆} Targets" class="ltx_ref"><span class="ltx_text ltx_ref_tag">10</span></a>) and letting</span></p>
<table id="S3.EGx105" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="S3.Ex154"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S3.Ex154.m1" class="ltx_math_unparsed" alttext="\displaystyle K=\Theta\left(\epsilon^{-1/\gamma}\right),\quad\epsilon_{1}=\Theta\left(\epsilon\right),\quad\epsilon_{2}=\Theta\left(\epsilon\right)" display="inline" intent=":literal"><semantics><mrow><mi>K</mi><mo>=</mo><mi mathvariant="normal">Θ</mi><mrow><mo>(</mo><msup><mi>ϵ</mi><mrow><mo>−</mo><mn>1</mn><mo>/</mo><mi>γ</mi></mrow></msup><mo>)</mo></mrow><mo rspace="1.167em">,</mo><msub><mi>ϵ</mi><mn>1</mn></msub><mo>=</mo><mi mathvariant="normal">Θ</mi><mrow><mo>(</mo><mi>ϵ</mi><mo>)</mo></mrow><mo rspace="1.167em">,</mo><msub><mi>ϵ</mi><mn>2</mn></msub><mo>=</mo><mi mathvariant="normal">Θ</mi><mrow><mo>(</mo><mi>ϵ</mi><mo>)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle K=\Theta\left(\epsilon^{-1/\gamma}\right),\quad\epsilon_{1}=\Theta\left(\epsilon\right),\quad\epsilon_{2}=\Theta\left(\epsilon\right)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S3.SS1.p29.2" class="ltx_p"><span id="S3.SS1.p29.2.1" class="ltx_text">yields</span></p>
<table id="S3.EGx106" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="S3.Ex155"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S3.Ex155.m1" class="ltx_Math" alttext="\displaystyle|T_{pq}(\boldsymbol{X})-f_{pq}(\boldsymbol{X})|" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">|</mo><mrow><mrow><msub><mi>T</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝑿</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msub><mi>f</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝑿</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">|</mo></mrow><annotation encoding="application/x-tex">\displaystyle|T_{pq}(\boldsymbol{X})-f_{pq}(\boldsymbol{X})|</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="S3.Ex156"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S3.Ex156.m1" class="ltx_Math" alttext="\displaystyle=\left|\sum_{i=1}^{C_{s+dn-1}^{dn-1}}\widetilde{\times}\left(c_{i,j}(f_{pq}),f_{i}^{(mnm)}\left(\boldsymbol{\bar{X}}^{(flt)}\right)\right)-f_{pq}(\boldsymbol{X})\right|" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mo>|</mo><mrow><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><msubsup><mi>C</mi><mrow><mrow><mi>s</mi><mo>+</mo><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow></mrow><mo>−</mo><mn>1</mn></mrow><mrow><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow><mo>−</mo><mn>1</mn></mrow></msubsup></munderover></mstyle><mrow><mover accent="true"><mo lspace="0.222em">×</mo><mo>~</mo></mover><mo lspace="0.222em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><msub><mi>c</mi><mrow><mi>i</mi><mo>,</mo><mi>j</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>f</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mrow><msubsup><mi>f</mi><mi>i</mi><mrow><mo stretchy="false">(</mo><mrow><mi>m</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><mi>m</mi></mrow><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><msup><mover accent="true"><mi>𝑿</mi><mo>¯</mo></mover><mrow><mo stretchy="false">(</mo><mrow><mi>f</mi><mo lspace="0em" rspace="0em">​</mo><mi>l</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow><mo stretchy="false">)</mo></mrow></msup><mo>)</mo></mrow></mrow><mo>)</mo></mrow></mrow></mrow><mo>−</mo><mrow><msub><mi>f</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝑿</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>|</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\left|\sum_{i=1}^{C_{s+dn-1}^{dn-1}}\widetilde{\times}\left(c_{i,j}(f_{pq}),f_{i}^{(mnm)}\left(\boldsymbol{\bar{X}}^{(flt)}\right)\right)-f_{pq}(\boldsymbol{X})\right|</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="S3.Ex157"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S3.Ex157.m1" class="ltx_Math" alttext="\displaystyle=\left|\sum_{i=1}^{C_{s+dn-1}^{dn-1}}\widetilde{\times}\left(c_{i,j}(f_{pq}),f_{i}^{(mnm)}\left(\boldsymbol{\bar{X}}^{(flt)}\right)\right)-\sum_{i=1}^{C_{s+dn-1}^{dn-1}}c_{i,j}(f_{pq})f_{i}^{(mnm)}\left(\boldsymbol{\bar{X}}^{(flt)}\right)\right|" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mo>|</mo><mrow><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><msubsup><mi>C</mi><mrow><mrow><mi>s</mi><mo>+</mo><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow></mrow><mo>−</mo><mn>1</mn></mrow><mrow><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow><mo>−</mo><mn>1</mn></mrow></msubsup></munderover></mstyle><mrow><mover accent="true"><mo lspace="0.222em">×</mo><mo>~</mo></mover><mo lspace="0.222em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><msub><mi>c</mi><mrow><mi>i</mi><mo>,</mo><mi>j</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>f</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mrow><msubsup><mi>f</mi><mi>i</mi><mrow><mo stretchy="false">(</mo><mrow><mi>m</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><mi>m</mi></mrow><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><msup><mover accent="true"><mi>𝑿</mi><mo>¯</mo></mover><mrow><mo stretchy="false">(</mo><mrow><mi>f</mi><mo lspace="0em" rspace="0em">​</mo><mi>l</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow><mo stretchy="false">)</mo></mrow></msup><mo>)</mo></mrow></mrow><mo>)</mo></mrow></mrow></mrow><mo>−</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><msubsup><mi>C</mi><mrow><mrow><mi>s</mi><mo>+</mo><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow></mrow><mo>−</mo><mn>1</mn></mrow><mrow><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow><mo>−</mo><mn>1</mn></mrow></msubsup></munderover></mstyle><mrow><msub><mi>c</mi><mrow><mi>i</mi><mo>,</mo><mi>j</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>f</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>f</mi><mi>i</mi><mrow><mo stretchy="false">(</mo><mrow><mi>m</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><mi>m</mi></mrow><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><msup><mover accent="true"><mi>𝑿</mi><mo>¯</mo></mover><mrow><mo stretchy="false">(</mo><mrow><mi>f</mi><mo lspace="0em" rspace="0em">​</mo><mi>l</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow><mo stretchy="false">)</mo></mrow></msup><mo>)</mo></mrow></mrow></mrow></mrow><mo>|</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\left|\sum_{i=1}^{C_{s+dn-1}^{dn-1}}\widetilde{\times}\left(c_{i,j}(f_{pq}),f_{i}^{(mnm)}\left(\boldsymbol{\bar{X}}^{(flt)}\right)\right)-\sum_{i=1}^{C_{s+dn-1}^{dn-1}}c_{i,j}(f_{pq})f_{i}^{(mnm)}\left(\boldsymbol{\bar{X}}^{(flt)}\right)\right|</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="S3.Ex158"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S3.Ex158.m1" class="ltx_Math" alttext="\displaystyle\quad+\left|\sum_{i=1}^{C_{s+dn-1}^{dn-1}}c_{i,j}(f_{pq})f_{i}^{(mnm)}\left(\boldsymbol{\bar{X}}^{(flt)}\right)-\sum_{i=1}^{C_{s+dn-1}^{dn-1}}c_{i,j}(f_{pq})\boldsymbol{\bar{X}}^{\boldsymbol{\alpha}_{i}}\right|" display="inline" intent=":literal"><semantics><mrow><mo>+</mo><mrow><mo>|</mo><mrow><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><msubsup><mi>C</mi><mrow><mrow><mi>s</mi><mo>+</mo><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow></mrow><mo>−</mo><mn>1</mn></mrow><mrow><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow><mo>−</mo><mn>1</mn></mrow></msubsup></munderover></mstyle><mrow><msub><mi>c</mi><mrow><mi>i</mi><mo>,</mo><mi>j</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>f</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>f</mi><mi>i</mi><mrow><mo stretchy="false">(</mo><mrow><mi>m</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><mi>m</mi></mrow><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><msup><mover accent="true"><mi>𝑿</mi><mo>¯</mo></mover><mrow><mo stretchy="false">(</mo><mrow><mi>f</mi><mo lspace="0em" rspace="0em">​</mo><mi>l</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow><mo stretchy="false">)</mo></mrow></msup><mo>)</mo></mrow></mrow></mrow><mo>−</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><msubsup><mi>C</mi><mrow><mrow><mi>s</mi><mo>+</mo><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow></mrow><mo>−</mo><mn>1</mn></mrow><mrow><mrow><mi>d</mi><mo lspace="0em" rspace="0em