<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S5.Ex301.m1" class="ltx_Math" alttext="\displaystyle\boldsymbol{W}_{O,h,1}^{(prl)}\boldsymbol{W}_{V,h,1}^{(prl)}\begin{pmatrix}\boldsymbol{X}\\
\boldsymbol{Y}\end{pmatrix}\sigma_{S}\left(\begin{pmatrix}\boldsymbol{X}^{\top}&amp;\boldsymbol{Y}^{\top}\end{pmatrix}\boldsymbol{W}_{K,h,1}^{(prl)T}\boldsymbol{W}_{Q,h,1}^{(prl)}\begin{pmatrix}\boldsymbol{X}\\
\boldsymbol{Y}\end{pmatrix}\right)" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>𝑾</mi><mrow><mi>O</mi><mo>,</mo><mi>h</mi><mo>,</mo><mn>1</mn></mrow><mrow><mo stretchy="false">(</mo><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>l</mi></mrow><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝑾</mi><mrow><mi>V</mi><mo>,</mo><mi>h</mi><mo>,</mo><mn>1</mn></mrow><mrow><mo stretchy="false">(</mo><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>l</mi></mrow><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mtable rowspacing="0pt"><mtr><mtd><mi>𝑿</mi></mtd></mtr><mtr><mtd><mi>𝒀</mi></mtd></mtr></mtable><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>σ</mi><mi>S</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mrow><mo>(</mo><mtable columnspacing="5pt"><mtr><mtd><msup><mi>𝑿</mi><mo>⊤</mo></msup></mtd><mtd><msup><mi>𝒀</mi><mo>⊤</mo></msup></mtd></mtr></mtable><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝑾</mi><mrow><mi>K</mi><mo>,</mo><mi>h</mi><mo>,</mo><mn>1</mn></mrow><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>l</mi></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>T</mi></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝑾</mi><mrow><mi>Q</mi><mo>,</mo><mi>h</mi><mo>,</mo><mn>1</mn></mrow><mrow><mo stretchy="false">(</mo><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>l</mi></mrow><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mtable rowspacing="0pt"><mtr><mtd><mi>𝑿</mi></mtd></mtr><mtr><mtd><mi>𝒀</mi></mtd></mtr></mtable><mo>)</mo></mrow></mrow><mo>)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\boldsymbol{W}_{O,h,1}^{(prl)}\boldsymbol{W}_{V,h,1}^{(prl)}\begin{pmatrix}\boldsymbol{X}\\
\boldsymbol{Y}\end{pmatrix}\sigma_{S}\left(\begin{pmatrix}\boldsymbol{X}^{\top}&amp;\boldsymbol{Y}^{\top}\end{pmatrix}\boldsymbol{W}_{K,h,1}^{(prl)T}\boldsymbol{W}_{Q,h,1}^{(prl)}\begin{pmatrix}\boldsymbol{X}\\
\boldsymbol{Y}\end{pmatrix}\right)</annotation></semantics></math></td>
