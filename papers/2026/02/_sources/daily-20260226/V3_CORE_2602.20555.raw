rspace="0.222em">∘</mo><msub><mi class="ltx_font_mathcaligraphic">𝓕</mi><mrow><mi>E</mi><mo lspace="0em" rspace="0em">​</mo><mi>B</mi></mrow></msub><mrow><mo stretchy="false">(</mo><mi>𝑿</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\left\|\boldsymbol{\mathcal{\widetilde{F}}}_{FF}^{(K)}\circ\cdots\circ\boldsymbol{\mathcal{\widetilde{F}}}_{FF}^{(k)}\circ\boldsymbol{\mathcal{\widetilde{F}}}_{SA}^{(k)}\circ\boldsymbol{\mathcal{{F}}}_{FF}^{(k-1)}\circ\cdots\circ\boldsymbol{\mathcal{{F}}}_{FF}^{(0)}\circ\boldsymbol{\mathcal{F}}_{EB}(\boldsymbol{X})\right.</annotation></semantics></math></td>
