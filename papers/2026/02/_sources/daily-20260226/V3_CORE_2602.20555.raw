<tbody id="S5.Ex303"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S5.Ex303.m1" class="ltx_Math" alttext="\displaystyle=\begin{pmatrix}\boldsymbol{W}_{O,h}^{(1)}\boldsymbol{W}_{V,h}^{(1)}\boldsymbol{X}\sigma_{S}\left(\boldsymbol{X}^{\top}\boldsymbol{W}_{K,h}^{(1){\top}}\boldsymbol{W}_{Q,h}^{(1)}\boldsymbol{X}\right)\\
\boldsymbol{0}_{d^{(2)}\times n}\end{pmatrix}." display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>=</mo><mrow><mo>(</mo><mtable rowspacing="0pt"><mtr><mtd><mrow><msubsup><mi>𝑾</mi><mrow><mi>O</mi><mo>,</mo><mi>h</mi></mrow><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝑾</mi><mrow><mi>V</mi><mo>,</mo><mi>h</mi></mrow><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>𝑿</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>σ</mi><mi>S</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><msup><mi>𝑿</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝑾</mi><mrow><mi>K</mi><mo>,</mo><mi>h</mi></mrow><mrow><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow><mo lspace="0.222em">⊤</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝑾</mi><mrow><mi>Q</mi><mo>,</mo><mi>h</mi></mrow><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>𝑿</mi></mrow><mo>)</mo></mrow></mrow></mtd></mtr><mtr><mtd><msub><mn>𝟎</mn><mrow><msup><mi>d</mi><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msup><mo lspace="0.222em" rspace="0.222em">×</mo><mi>n</mi></mrow></msub></mtd></mtr></mtable><mo>)</mo></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle=\begin{pmatrix}\boldsymbol{W}_{O,h}^{(1)}\boldsymbol{W}_{V,h}^{(1)}\boldsymbol{X}\sigma_{S}\left(\boldsymbol{X}^{\top}\boldsymbol{W}_{K,h}^{(1){\top}}\boldsymbol{W}_{Q,h}^{(1)}\boldsymbol{X}\right)\\
\boldsymbol{0}_{d^{(2)}\times n}\end{pmatrix}.</annotation></semantics></math></td>
