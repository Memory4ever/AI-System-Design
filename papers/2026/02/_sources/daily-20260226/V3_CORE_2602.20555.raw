<tbody id="S3.Ex160"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S3.Ex160.m1" class="ltx_Math" alttext="\displaystyle\leq\sum_{i=1}^{C_{s+dn-1}^{dn-1}}\left|\widetilde{\times}\left(c_{i,j}(f_{pq}),f_{i}^{(mnm)}\left(\boldsymbol{\bar{X}}^{(flt)}\right)\right)-c_{i,j}(f_{pq})f_{i}^{(mnm)}\left(\boldsymbol{\bar{X}}^{(flt)}\right)\right|" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≤</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><msubsup><mi>C</mi><mrow><mrow><mi>s</mi><mo>+</mo><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow></mrow><mo>−</mo><mn>1</mn></mrow><mrow><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow><mo>−</mo><mn>1</mn></mrow></msubsup></munderover></mstyle><mrow><mo>|</mo><mrow><mrow><mover accent="true"><mo lspace="0em">×</mo><mo>~</mo></mover><mo lspace="0.222em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><msub><mi>c</mi><mrow><mi>i</mi><mo>,</mo><mi>j</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>f</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mrow><msubsup><mi>f</mi><mi>i</mi><mrow><mo stretchy="false">(</mo><mrow><mi>m</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><mi>m</mi></mrow><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><msup><mover accent="true"><mi>𝑿</mi><mo>¯</mo></mover><mrow><mo stretchy="false">(</mo><mrow><mi>f</mi><mo lspace="0em" rspace="0em">​</mo><mi>l</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow><mo stretchy="false">)</mo></mrow></msup><mo>)</mo></mrow></mrow><mo>)</mo></mrow></mrow><mo>−</mo><mrow><msub><mi>c</mi><mrow><mi>i</mi><mo>,</mo><mi>j</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>f</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>f</mi><mi>i</mi><mrow><mo stretchy="false">(</mo><mrow><mi>m</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><mi>m</mi></mrow><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><msup><mover accent="true"><mi>𝑿</mi><mo>¯</mo></mover><mrow><mo stretchy="false">(</mo><mrow><mi>f</mi><mo lspace="0em" rspace="0em">​</mo><mi>l</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow><mo stretchy="false">)</mo></mrow></msup><mo>)</mo></mrow></mrow></mrow><mo>|</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\leq\sum_{i=1}^{C_{s+dn-1}^{dn-1}}\left|\widetilde{\times}\left(c_{i,j}(f_{pq}),f_{i}^{(mnm)}\left(\boldsymbol{\bar{X}}^{(flt)}\right)\right)-c_{i,j}(f_{pq})f_{i}^{(mnm)}\left(\boldsymbol{\bar{X}}^{(flt)}\right)\right|</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="S3.Ex161"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S3.Ex161.m1" class="ltx_math_unparsed" alttext="\displaystyle\quad+\sum_{i=1}^{C_{s+dn-1}^{dn-1}}|c_{i,j}(f_{pq})|\left|f_{i}^{(mnm)}\left(\boldsymbol{\bar{X}}^{(flt)}\right)-\boldsymbol{\bar{X}}^{\boldsymbol{\alpha}_{i}}\right|" display="inline" intent=":literal"><semantics><mrow><mo>+</mo><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><msubsup><mi>C</mi><mrow><mrow><mi>s</mi><mo>+</mo><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow></mrow><mo>−</mo><mn>1</mn></mrow><mrow><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow><mo>−</mo><mn>1</mn></mrow></msubsup></munderover></mstyle><mo fence="false" rspace="0.167em" stretchy="false">|</mo><msub><mi>c</mi><mrow><mi>i</mi><mo>,</mo><mi>j</mi></mrow></msub><mrow><mo stretchy="false">(</mo><msub><mi>f</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub><mo stretchy="false">)</mo></mrow><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mo fence="false" rspace="0.167em">|</mo><msubsup><mi>f</mi><mi>i</mi><mrow><mo stretchy="false">(</mo><mrow><mi>m</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><mi>m</mi></mrow><mo stretchy="false">)</mo></mrow></msubsup><mrow><mo>(</mo><msup><mover accent="true"><mi>𝑿</mi><mo>¯</mo></mover><mrow><mo stretchy="false">(</mo><mrow><mi>f</mi><mo lspace="0em" rspace="0em">​</mo><mi>l</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow><mo stretchy="false">)</mo></mrow></msup><mo>)</mo></mrow><mo>−</mo><msup><mover accent="true"><mi>𝑿</mi><mo>¯</mo></mover><msub><mi>𝜶</mi><mi>i</mi></msub></msup><mo fence="false">|</mo></mrow><annotation encoding="application/x-tex">\displaystyle\quad+\sum_{i=1}^{C_{s+dn-1}^{dn-1}}|c_{i,j}(f_{pq})|\left|f_{i}^{(mnm)}\left(\boldsymbol{\bar{X}}^{(flt)}\right)-\boldsymbol{\bar{X}}^{\boldsymbol{\alpha}_{i}}\right|</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="S3.Ex162"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S3.Ex162.m1" class="ltx_Math" alttext="\displaystyle\quad+\left|\sum_{i=1}^{C_{s+dn}^{dn}}c_{i,j}(f_{pq})\boldsymbol{\bar{X}}^{\boldsymbol{\alpha}_{i}}-f_{pq}(\boldsymbol{X})\right|" display="inline" intent=":literal"><semantics><mrow><mo>+</mo><mrow><mo>|</mo><mrow><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><msubsup><mi>C</mi><mrow><mi>s</mi><mo>+</mo><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow></mrow><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow></msubsup></munderover></mstyle><mrow><msub><mi>c</mi><mrow><mi>i</mi><mo>,</mo><mi>j</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>f</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mover accent="true"><mi>𝑿</mi><mo>¯</mo></mover><msub><mi>𝜶</mi><mi>i</mi></msub></msup></mrow></mrow><mo>−</mo><mrow><msub><mi>f</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝑿</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>|</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\quad+\left|\sum_{i=1}^{C_{s+dn}^{dn}}c_{i,j}(f_{pq})\boldsymbol{\bar{X}}^{\boldsymbol{\alpha}_{i}}-f_{pq}(\boldsymbol{X})\right|</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="S3.Ex163"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S3.Ex163.m1" class="ltx_Math" alttext="\displaystyle\leq\frac{\epsilon}{3}+\frac{\epsilon}{3}+\frac{\epsilon}{3}=\epsilon." display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>≤</mo><mrow><mstyle displaystyle="true"><mfrac><mi>ϵ</mi><mn>3</mn></mfrac></mstyle><mo>+</mo><mstyle displaystyle="true"><mfrac><mi>ϵ</mi><mn>3</mn></mfrac></mstyle><mo>+</mo><mstyle displaystyle="true"><mfrac><mi>ϵ</mi><mn>3</mn></mfrac></mstyle></mrow><mo>=</mo><mi>ϵ</mi></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\leq\frac{\epsilon}{3}+\frac{\epsilon}{3}+\frac{\epsilon}{3}=\epsilon.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="S3.SS1.p30" class="ltx_para">
<p id="S3.SS1.p30.1" class="ltx_p"><span id="S3.SS1.p30.1.1" class="ltx_text ltx_font_bold">Step 7: Estimate the magnitude of <math id="S3.SS1.p30.m1" class="ltx_Math" alttext="T" display="inline" intent=":literal"><semantics><mi>T</mi><annotation encoding="application/x-tex">T</annotation></semantics></math> on <math id="S3.SS1.p30.m2" class="ltx_Math" alttext="\Omega^{(flaw)}" display="inline" intent=":literal"><semantics><msup><mi mathvariant="normal">Ω</mi><mrow><mo stretchy="false">(</mo><mrow><mi>f</mi><mo lspace="0em" rspace="0em">​</mo><mi>l</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi><mo lspace="0em" rspace="0em">​</mo><mi>w</mi></mrow><mo stretchy="false">)</mo></mrow></msup><annotation encoding="application/x-tex">\Omega^{(flaw)}</annotation></semantics></math>.<span id="S3.SS1.p30.1.1.1" class="ltx_text"></span></span></p>
</div>
<div id="S3.SS1.p31" class="ltx_para">
<p id="S3.SS1.p31.1" class="ltx_p"><span id="S3.SS1.p31.1.1" class="ltx_text">For <math id="S3.SS1.p31.m1" class="ltx_Math" alttext="p\in[d],q\in[n]" display="inline" intent=":literal"><semantics><mrow><mrow><mi>p</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mi>d</mi><mo stretchy="false">]</mo></mrow></mrow><mo>,</mo><mrow><mi>q</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mi>n</mi><mo stretchy="false">]</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">p\in[d],q\in[n]</annotation></semantics></math> and <math id="S3.SS1.p31.m2" class="ltx_Math" alttext="\boldsymbol{X}\in\Omega^{(flaw)}" display="inline" intent=":literal"><semantics><mrow><mi>𝑿</mi><mo>∈</mo><msup><mi mathvariant="normal">Ω</mi><mrow><mo stretchy="false">(</mo><mrow><mi>f</mi><mo lspace="0em" rspace="0em">​</mo><mi>l</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi><mo lspace="0em" rspace="0em">​</mo><mi>w</mi></mrow><mo stretchy="false">)</mo></mrow></msup></mrow><annotation encoding="application/x-tex">\boldsymbol{X}\in\Omega^{(flaw)}</annotation></semantics></math>, by the above construction, we have</span></p>
<table id="S3.EGx107" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="S3.E11"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S3.E11.m1" class="ltx_Math" alttext="\displaystyle T_{pq}(\boldsymbol{X})=\sum_{i=1}^{C_{s+dn-1}^{dn-1}}\widetilde{\times}\left(\left[\boldsymbol{T}_{i,p}^{(mmr)}\left(\boldsymbol{\mathcal{F}}_{FF}^{(prl-dsc)}(\boldsymbol{X})\right)\right]_{1,q},\left[\boldsymbol{T}_{i}^{(mnm)}\left(\boldsymbol{X}-\boldsymbol{\mathcal{F}}_{FF}^{(prl-dsc)}(\boldsymbol{X})\right)\right]_{1,q}\right)." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><msub><mi>T</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝑿</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><msubsup><mi>C</mi><mrow><mrow><mi>s</mi><mo>+</mo><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow></mrow><mo>−</mo><mn>1</mn></mrow><mrow><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow><mo>−</mo><mn>1</mn></mrow></msubsup></munderover></mstyle><mrow><mover accent="true"><mo lspace="0.222em">×</mo><mo>~</mo></mover><mo lspace="0.222em" rspace="0em">​</mo><mrow><mo>(</mo><msub><mrow><mo>[</mo><mrow><msubsup><mi>𝑻</mi><mrow><mi>i</mi><mo>,</mo><mi>p</mi></mrow><mrow><mo stretchy="false">(</mo><mrow><mi>m</mi><mo lspace="0em" rspace="0em">​</mo><mi>m</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi></mrow><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><msubsup><mi class="ltx_font_mathcaligraphic">𝓕</mi><mrow><mi>F</mi><mo lspace="0em" rspace="0em">​</mo><mi>F</mi></mrow><mrow><mo stretchy="false">(</mo><mrow><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>l</mi></mrow><mo>−</mo><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>s</mi><mo lspace="0em" rspace="0em">​</mo><mi>c</mi></mrow></mrow><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝑿</mi><mo stretchy="false">)</mo></mrow></mrow><mo>)</mo></mrow></mrow><mo>]</mo></mrow><mrow><mn>1</mn><mo>,</mo><mi>q</mi></mrow></msub><mo>,</mo><msub><mrow><mo>[</mo><mrow><msubsup><mi>𝑻</mi><mi>i</mi><mrow><mo stretchy="false">(</mo><mrow><mi>m</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><mi>m</mi></mrow><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mi>𝑿</mi><mo>−</mo><mrow><msubsup><mi class="ltx_font_mathcaligraphic">𝓕</mi><mrow><mi>F</mi><mo lspace="0em" rspace="0em">​</mo><mi>F</mi></mrow><mrow><mo stretchy="false">(</mo><mrow><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>l</mi></mrow><mo>−</mo><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>s</mi><mo lspace="0em" rspace="0em">​</mo><mi>c</mi></mrow></mrow><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝑿</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>)</mo></mrow></mrow><mo>]</mo></mrow><mrow><mn>1</mn><mo>,</mo><mi>q</mi></mrow></msub><mo>)</mo></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle T_{pq}(\boldsymbol{X})=\sum_{i=1}^{C_{s+dn-1}^{dn-1}}\widetilde{\times}\left(\left[\boldsymbol{T}_{i,p}^{(mmr)}\left(\boldsymbol{\mathcal{F}}_{FF}^{(prl-dsc)}(\boldsymbol{X})\right)\right]_{1,q},\left[\boldsymbol{T}_{i}^{(mnm)}\left(\boldsymbol{X}-\boldsymbol{\mathcal{F}}_{FF}^{(prl-dsc)}(\boldsymbol{X})\right)\right]_{1,q}\right).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(11)</span></td></tr></tbody>
</table>
<p id="S3.SS1.p31.2" class="ltx_p"><span id="S3.SS1.p31.2.1" class="ltx_text">Applying Lemma <a href="#Thmlemma7" title="Lemma 7. ‣ 3.1 Proof of Proposition ‣ 3 Proof of Proposition : Construction of Transformers ‣ Standard Transformers Achieve the Minimax Rate in Nonparametric Regression with 𝐶^{𝑠,𝜆} Targets" class="ltx_ref"><span class="ltx_text ltx_ref_tag">7</span></a> with paramters <math id="S3.SS1.p31.m3" class="ltx_Math" alttext="r=\sqrt{d},\delta=\frac{1}{K},N=K^{dn},B_{y}=C(\boldsymbol{f})" display="inline" intent=":literal"><semantics><mrow><mrow><mi>r</mi><mo>=</mo><msqrt><mi>d</mi></msqrt></mrow><mo>,</mo><mrow><mi>δ</mi><mo>=</mo><mfrac><mn>1</mn><mi>K</mi></mfrac></mrow><mo>,</mo><mrow><mi>N</mi><mo>=</mo><msup><mi>K</mi><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow></msup></mrow><mo>,</mo><mrow><msub><mi>B</mi><mi>y</mi></msub><mo>=</mo><mrow><mi>C</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝒇</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">r=\sqrt{d},\delta=\frac{1}{K},N=K^{dn},B_{y}=C(\boldsymbol{f})</annotation></semantics></math> therein, we have</span></p>
<table id="S3.EGx108" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="S3.Ex164"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S3.Ex164.m1" class="ltx_Math" alttext="\displaystyle\left|\left[\boldsymbol{T}_{i,p}^{(mmr)}\left(\boldsymbol{\mathcal{F}}_{FF}^{(prl-dsc)}(\boldsymbol{X})\right)\right]_{1,q}\right|\leq C(\boldsymbol{f})d^{2}n^{8}K^{7dn+2}." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mo>|</mo><msub><mrow><mo>[</mo><mrow><msubsup><mi>𝑻</mi><mrow><mi>i</mi><mo>,</mo><mi>p</mi></mrow><mrow><mo stretchy="false">(</mo><mrow><mi>m</mi><mo lspace="0em" rspace="0em">​</mo><mi>m</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi></mrow><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><msubsup><mi class="ltx_font_mathcaligraphic">𝓕</mi><mrow><mi>F</mi><mo lspace="0em" rspace="0em">​</mo><mi>F</mi></mrow><mrow><mo stretchy="false">(</mo><mrow><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>l</mi></mrow><mo>−</mo><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>s</mi><mo lspace="0em" rspace="0em">​</mo><mi>c</mi></mrow></mrow><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝑿</mi><mo stretchy="false">)</mo></mrow></mrow><mo>)</mo></mrow></mrow><mo>]</mo></mrow><mrow><mn>1</mn><mo>,</mo><mi>q</mi></mrow></msub><mo>|</mo></mrow><mo>≤</mo><mrow><mrow><mi>C</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝒇</mi><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mi>d</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>n</mi><mn>8</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>K</mi><mrow><mrow><mn>7</mn><mo lspace="0em" rspace="0em">​</mo><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow><mo>+</mo><mn>2</mn></mrow></msup></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\left|\left[\boldsymbol{T}_{i,p}^{(mmr)}\left(\boldsymbol{\mathcal{F}}_{FF}^{(prl-dsc)}(\boldsymbol{X})\right)\right]_{1,q}\right|\leq C(\boldsymbol{f})d^{2}n^{8}K^{7dn+2}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S3.SS1.p31.3" class="ltx_p"><span id="S3.SS1.p31.3.1" class="ltx_text">Noting that</span></p>
<table id="S3.EGx109" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="S3.Ex165"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S3.Ex165.m1" class="ltx_Math" alttext="\displaystyle\left|\left[\boldsymbol{T}_{i}^{(mnm)}\left(\boldsymbol{X}-\boldsymbol{\mathcal{F}}_{FF}^{(prl-dsc)}(\boldsymbol{X})\right)\right]_{1,q}\right|\leq 2" display="inline" intent=":literal"><semantics><mrow><mrow><mo>|</mo><msub><mrow><mo>[</mo><mrow><msubsup><mi>𝑻</mi><mi>i</mi><mrow><mo stretchy="false">(</mo><mrow><mi>m</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><mi>m</mi></mrow><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mi>𝑿</mi><mo>−</mo><mrow><msubsup><mi class="ltx_font_mathcaligraphic">𝓕</mi><mrow><mi>F</mi><mo lspace="0em" rspace="0em">​</mo><mi>F</mi></mrow><mrow><mo stretchy="false">(</mo><mrow><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>l</mi></mrow><mo>−</mo><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>s</mi><mo lspace="0em" rspace="0em">​</mo><mi>c</mi></mrow></mrow><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝑿</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>)</mo></mrow></mrow><mo>]</mo></mrow><mrow><mn>1</mn><mo>,</mo><mi>q</mi></mrow></msub><mo>|</mo></mrow><mo>≤</mo><mn>2</mn></mrow><annotation encoding="application/x-tex">\displaystyle\left|\left[\boldsymbol{T}_{i}^{(mnm)}\left(\boldsymbol{X}-\boldsymbol{\mathcal{F}}_{FF}^{(prl-dsc)}(\boldsymbol{X})\right)\right]_{1,q}\right|\leq 2</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S3.SS1.p31.4" class="ltx_p"><span id="S3.SS1.p31.4.1" class="ltx_text">and hence applying Lemma <a href="#Thmlemma10" title="Lemma 10 ([], Proposition 3). ‣ 3.1 Proof of Proposition ‣ 3 Proof of Proposition : Construction of Transformers ‣ Standard Transformers Achieve the Minimax Rate in Nonparametric Regression with 𝐶^{𝑠,𝜆} Targets" class="ltx_ref"><span class="ltx_text ltx_ref_tag">10</span></a> with <math id="S3.SS1.p31.m4" class="ltx_Math" alttext="B^{\prime}=C(\boldsymbol{f})d^{2}n^{8}K^{7dn+2}" display="inline" intent=":literal"><semantics><mrow><msup><mi>B</mi><mo>′</mo></msup><mo>=</mo><mrow><mrow><mi>C</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝒇</mi><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mi>d</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>n</mi><mn>8</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>K</mi><mrow><mrow><mn>7</mn><mo lspace="0em" rspace="0em">​</mo><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow><mo>+</mo><mn>2</mn></mrow></msup></mrow></mrow><annotation encoding="application/x-tex">B^{\prime}=C(\boldsymbol{f})d^{2}n^{8}K^{7dn+2}</annotation></semantics></math>, we have</span></p>
<table id="S3.EGx110" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="S3.Ex166"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S3.Ex166.m1" class="ltx_Math" alttext="\displaystyle\left|\widetilde{\times}\left(\left[\boldsymbol{T}_{i,p}^{(mmr)}\left(\boldsymbol{\mathcal{F}}_{FF}^{(prl-dsc)}(\boldsymbol{X})\right)\right]_{1,q},\left[\boldsymbol{T}_{i}^{(mnm)}\left(\boldsymbol{X}-\boldsymbol{\mathcal{F}}_{FF}^{(prl-dsc)}(\boldsymbol{X})\right)\right]_{1,q}\right)\right|\leq C(\boldsymbol{f})d^{2}n^{8}K^{7dn+2}." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mo>|</mo><mrow><mover accent="true"><mo lspace="0em">×</mo><mo>~</mo></mover><mo lspace="0.222em" rspace="0em">​</mo><mrow><mo>(</mo><msub><mrow><mo>[</mo><mrow><msubsup><mi>𝑻</mi><mrow><mi>i</mi><mo>,</mo><mi>p</mi></mrow><mrow><mo stretchy="false">(</mo><mrow><mi>m</mi><mo lspace="0em" rspace="0em">​</mo><mi>m</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi></mrow><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><msubsup><mi class="ltx_font_mathcaligraphic">𝓕</mi><mrow><mi>F</mi><mo lspace="0em" rspace="0em">​</mo><mi>F</mi></mrow><mrow><mo stretchy="false">(</mo><mrow><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>l</mi></mrow><mo>−</mo><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>s</mi><mo lspace="0em" rspace="0em">​</mo><mi>c</mi></mrow></mrow><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝑿</mi><mo stretchy="false">)</mo></mrow></mrow><mo>)</mo></mrow></mrow><mo>]</mo></mrow><mrow><mn>1</mn><mo>,</mo><mi>q</mi></mrow></msub><mo>,</mo><msub><mrow><mo>[</mo><mrow><msubsup><mi>𝑻</mi><mi>i</mi><mrow><mo stretchy="false">(</mo><mrow><mi>m</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><mi>m</mi></mrow><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mi>𝑿</mi><mo>−</mo><mrow><msubsup><mi class="ltx_font_mathcaligraphic">𝓕</mi><mrow><mi>F</mi><mo lspace="0em" rspace="0em">​</mo><mi>F</mi></mrow><mrow><mo stretchy="false">(</mo><mrow><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>l</mi></mrow><mo>−</mo><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>s</mi><mo lspace="0em" rspace="0em">​</mo><mi>c</mi></mrow></mrow><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝑿</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>)</mo></mrow></mrow><mo>]</mo></mrow><mrow><mn>1</mn><mo>,</mo><mi>q</mi></mrow></msub><mo>)</mo></mrow></mrow><mo>|</mo></mrow><mo>≤</mo><mrow><mrow><mi>C</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝒇</mi><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mi>d</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>n</mi><mn>8</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>K</mi><mrow><mrow><mn>7</mn><mo lspace="0em" rspace="0em">​</mo><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow><mo>+</mo><mn>2</mn></mrow></msup></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\left|\widetilde{\times}\left(\left[\boldsymbol{T}_{i,p}^{(mmr)}\left(\boldsymbol{\mathcal{F}}_{FF}^{(prl-dsc)}(\boldsymbol{X})\right)\right]_{1,q},\left[\boldsymbol{T}_{i}^{(mnm)}\left(\boldsymbol{X}-\boldsymbol{\mathcal{F}}_{FF}^{(prl-dsc)}(\boldsymbol{X})\right)\right]_{1,q}\right)\right|\leq C(\boldsymbol{f})d^{2}n^{8}K^{7dn+2}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S3.SS1.p31.5" class="ltx_p"><span id="S3.SS1.p31.5.1" class="ltx_text">Plugging the above estimate into (<a href="#S3.E11" title="In Proof of Proposition . ‣ 3.1 Proof of Proposition ‣ 3 Proof of Proposition : Construction of Transformers ‣ Standard Transformers Achieve the Minimax Rate in Nonparametric Regression with 𝐶^{𝑠,𝜆} Targets" class="ltx_ref"><span class="ltx_text ltx_ref_tag">11</span></a>) yields</span></p>
<table id="S3.EGx111" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="S3.Ex167"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S3.Ex167.m1" class="ltx_Math" alttext="\displaystyle\left|T_{pq}(\boldsymbol{X})\right|\leq C(\boldsymbol{f})C_{s+dn-1}^{dn-1}d^{2}n^{8}K^{7dn+2}." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mo>|</mo><mrow><msub><mi>T</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝑿</mi><mo stretchy="false">)</mo></mrow></mrow><mo>|</mo></mrow><mo>≤</mo><mrow><mrow><mi>C</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝒇</mi><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>C</mi><mrow><mrow><mi>s</mi><mo>+</mo><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow></mrow><mo>−</mo><mn>1</mn></mrow><mrow><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow><mo>−</mo><mn>1</mn></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mi>d</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>n</mi><mn>8</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>K</mi><mrow><mrow><mn>7</mn><mo lspace="0em" rspace="0em">​</mo><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow><mo>+</mo><mn>2</mn></mrow></msup></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\left|T_{pq}(\boldsymbol{X})\right|\leq C(\boldsymbol{f})C_{s+dn-1}^{dn-1}d^{2}n^{8}K^{7dn+2}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="S3.SS1.p32" class="ltx_para">
<p id="S3.SS1.p32.1" class="ltx_p"><span id="S3.SS1.p32.1.1" class="ltx_text">∎</span></p>
</div>
</div>
</section>
<section id="S3.SS2" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">3.2 </span>Proof of Lemma <a href="#Thmlemma8" title="Lemma 8. ‣ 3.1 Proof of Proposition ‣ 3 Proof of Proposition : Construction of Transformers ‣ Standard Transformers Achieve the Minimax Rate in Nonparametric Regression with 𝐶^{𝑠,𝜆} Targets" class="ltx_ref"><span class="ltx_text ltx_ref_tag">8</span></a></h3>

<div id="S3.SS2.p1" class="ltx_para">
<p id="S3.SS2.p1.1" class="ltx_p">Denote</p>
<table id="S3.EGx112" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="S3.Ex168"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S3.Ex168.m1" class="ltx_Math" alttext="\displaystyle\boldsymbol{\widetilde{X}}:=\begin{pmatrix}\boldsymbol{X}\\
\boldsymbol{I}_{n\times n}-\boldsymbol{1}_{n\times n}\end{pmatrix}." display="inline" intent=":literal"><semantics><mrow><mrow><mover accent="true"><mi>𝑿</mi><mo>~</mo></mover><mo>:=</mo><mrow><mo>(</mo><mtable rowspacing="0pt"><mtr><mtd><mi>𝑿</mi></mtd></mtr><mtr><mtd><mrow><msub><mi>𝑰</mi><mrow><mi>n</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>n</mi></mrow></msub><mo>−</mo><msub><mn>𝟏</mn><mrow><mi>n</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>n</mi></mrow></msub></mrow></mtd></mtr></mtable><mo>)</mo></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\boldsymbol{\widetilde{X}}:=\begin{pmatrix}\boldsymbol{X}\\
\boldsymbol{I}_{n\times n}-\boldsymbol{1}_{n\times n}\end{pmatrix}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S3.SS2.p1.2" class="ltx_p">Define <math id="S3.SS2.p1.m1" class="ltx_Math" alttext="\boldsymbol{\mathcal{F}}_{FF,1}^{(FF)}:\mathbb{R}^{(d+n)\times n}\to\mathbb{R}^{2dn\times n}" display="inline" intent=":literal"><semantics><mrow><msubsup><mi class="ltx_font_mathcaligraphic">𝓕</mi><mrow><mrow><mi>F</mi><mo lspace="0em" rspace="0em">​</mo><mi>F</mi></mrow><mo>,</mo><mn>1</mn></mrow><mrow><mo stretchy="false">(</mo><mrow><mi>F</mi><mo lspace="0em" rspace="0em">​</mo><mi>F</mi></mrow><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><msup><mi>ℝ</mi><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>d</mi><mo>+</mo><mi>n</mi></mrow><mo rspace="0.055em" stretchy="false">)</mo></mrow><mo rspace="0.222em">×</mo><mi>n</mi></mrow></msup><mo stretchy="false">→</mo><msup><mi>ℝ</mi><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow><mo lspace="0.222em" rspace="0.222em">×</mo><mi>n</mi></mrow></msup></mrow></mrow><annotation encoding="application/x-tex">\boldsymbol{\mathcal{F}}_{FF,1}^{(FF)}:\mathbb{R}^{(d+n)\times n}\to\mathbb{R}^{2dn\times n}</annotation></semantics></math> as</p>
<table id="S3.EGx113" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="S3.Ex169"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S3.Ex169.m1" class="ltx_Math" alttext="\displaystyle\boldsymbol{\mathcal{F}}_{FF,1}^{(FF)}(\boldsymbol{Y}):=\sigma_{R}\left(\boldsymbol{W}_{1}\boldsymbol{Y}\right),\quad\boldsymbol{Y}\in\mathbb{R}^{(d+n)\times n}" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><msubsup><mi class="ltx_font_mathcaligraphic">𝓕</mi><mrow><mrow><mi>F</mi><mo lspace="0em" rspace="0em">​</mo><mi>F</mi></mrow><mo>,</mo><mn>1</mn></mrow><mrow><mo stretchy="false">(</mo><mrow><mi>F</mi><mo lspace="0em" rspace="0em">​</mo><mi>F</mi></mrow><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝒀</mi><mo stretchy="false">)</mo></mrow></mrow><mo>:=</mo><mrow><msub><mi>σ</mi><mi>R</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><msub><mi>𝑾</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mi>𝒀</mi></mrow><mo>)</mo></mrow></mrow></mrow><mo rspace="1.167em">,</mo><mrow><mi>𝒀</mi><mo>∈</mo><msup><mi>ℝ</mi><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>d</mi><mo>+</mo><mi>n</mi></mrow><mo rspace="0.055em" stretchy="false">)</mo></mrow><mo rspace="0.222em">×</mo><mi>n</mi></mrow></msup></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\boldsymbol{\mathcal{F}}_{FF,1}^{(FF)}(\boldsymbol{Y}):=\sigma_{R}\left(\boldsymbol{W}_{1}\boldsymbol{Y}\right),\quad\boldsymbol{Y}\in\mathbb{R}^{(d+n)\times n}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S3.SS2.p1.3" class="ltx_p">with</p>
<table id="S3.EGx114" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="S3.Ex170"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S3.Ex170.m1" class="ltx_Math" alttext="\displaystyle\boldsymbol{W}_{1}:=\begin{pmatrix}\boldsymbol{1}_{n\times 1}&amp;\boldsymbol{0}_{n\times 1}&amp;\cdots&amp;\boldsymbol{0}_{n\times 1}&amp;\boldsymbol{I}_{n\times n}\\
\boldsymbol{0}_{n\times 1}&amp;\boldsymbol{1}_{n\times 1}&amp;\cdots&amp;\boldsymbol{0}_{n\times 1}&amp;\boldsymbol{I}_{n\times n}\\
\vdots&amp;\vdots&amp;\ddots&amp;\vdots&amp;\vdots\\
\boldsymbol{0}_{n\times 1}&amp;\boldsymbol{0}_{n\times 1}&amp;\cdots&amp;\boldsymbol{1}_{n\times 1}&amp;\boldsymbol{I}_{n\times n}\\
&amp;&amp;\boldsymbol{0}_{dn\times(d+n)}\end{pmatrix}\in\mathbb{R}^{2dn\times(d+n)}." display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>𝑾</mi><mn>1</mn></msub><mo>:=</mo><mrow><mo>(</mo><mtable columnspacing="5pt" rowspacing="0pt"><mtr><mtd><msub><mn>𝟏</mn><mrow><mi>n</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mn>1</mn></mrow></msub></mtd><mtd><msub><mn>𝟎</mn><mrow><mi>n</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mn>1</mn></mrow></msub></mtd><mtd><mo>⋯</mo></mtd><mtd><msub><mn>𝟎</mn><mrow><mi>n</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mn>1</mn></mrow></msub></mtd><mtd><msub><mi>𝑰</mi><mrow><mi>n</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>n</mi></mrow></msub></mtd></mtr><mtr><mtd><msub><mn>𝟎</mn><mrow><mi>n</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mn>1</mn></mrow></msub></mtd><mtd><msub><mn>𝟏</mn><mrow><mi>n</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mn>1</mn></mrow></msub></mtd><mtd><mo>⋯</mo></mtd><mtd><msub><mn>𝟎</mn><mrow><mi>n</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mn>1</mn></mrow></msub></mtd><mtd><msub><mi>𝑰</mi><mrow><mi>n</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>n</mi></mrow></msub></mtd></mtr><mtr><mtd></mtd><mtd></mtd><mtd><mi mathvariant="normal">⋱</mi></mtd><mtd></mtd><mtd></mtd></mtr><mtr><mtd><msub><mn>𝟎</mn><mrow><mi>n</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mn>1</mn></mrow></msub></mtd><mtd><msub><mn>𝟎</mn><mrow><mi>n</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mn>1</mn></mrow></msub></mtd><mtd><mo>⋯</mo></mtd><mtd><msub><mn>𝟏</mn><mrow><mi>n</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mn>1</mn></mrow></msub></mtd><mtd><msub><mi>𝑰</mi><mrow><mi>n</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>n</mi></mrow></msub></mtd></mtr><mtr><mtd></mtd><mtd></mtd><mtd><msub><mn>𝟎</mn><mrow><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow><mo lspace="0.222em" rspace="0.222em">×</mo><mrow><mo stretchy="false">(</mo><mrow><mi>d</mi><mo>+</mo><mi>n</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></msub></mtd></mtr></mtable><mo>)</mo></mrow><mo>∈</mo><msup><mi>ℝ</mi><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow><mo lspace="0.222em" rspace="0.222em">×</mo><mrow><mo stretchy="false">(</mo><mrow><mi>d</mi><mo>+</mo><mi>n</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></msup></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\boldsymbol{W}_{1}:=\begin{pmatrix}\boldsymbol{1}_{n\times 1}&amp;\boldsymbol{0}_{n\times 1}&amp;\cdots&amp;\boldsymbol{0}_{n\times 1}&amp;\boldsymbol{I}_{n\times n}\\
\boldsymbol{0}_{n\times 1}&amp;\boldsymbol{1}_{n\times 1}&amp;\cdots&amp;\boldsymbol{0}_{n\times 1}&amp;\boldsymbol{I}_{n\times n}\\
\vdots&amp;\vdots&amp;\ddots&amp;\vdots&amp;\vdots\\
\boldsymbol{0}_{n\times 1}&amp;\boldsymbol{0}_{n\times 1}&amp;\cdots&amp;\boldsymbol{1}_{n\times 1}&amp;\boldsymbol{I}_{n\times n}\\
&amp;&amp;\boldsymbol{0}_{dn\times(d+n)}\end{pmatrix}\in\mathbb{R}^{2dn\times(d+n)}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S3.SS2.p1.4" class="ltx_p">It can be checked that</p>
<table id="S3.EGx115" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="S3.Ex171"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S3.Ex171.m1" class="ltx_Math" alttext="\displaystyle\boldsymbol{\mathcal{F}}_{FF,1}^{(FF)}\left(\boldsymbol{\widetilde{X}}\right)=\sigma_{R}\left(\boldsymbol{W}_{1}\boldsymbol{\widetilde{X}}\right)=\begin{pmatrix}\text{diag}(x_{11},x_{12},\dots,x_{1n})\\
\text{diag}(x_{21},x_{22},\dots,x_{2n})\\
\vdots\\
\text{diag}(x_{d1},x_{d2},\dots,x_{dn})\\
\boldsymbol{0}_{dn\times n}\end{pmatrix}\in\mathbb{R}^{2dn\times n}," display="inline" intent=":literal"><semantics><mrow><mrow><mrow><msubsup><mi class="ltx_font_mathcaligraphic">𝓕</mi><mrow><mrow><mi>F</mi><mo lspace="0em" rspace="0em">​</mo><mi>F</mi></mrow><mo>,</mo><mn>1</mn></mrow><mrow><mo stretchy="false">(</mo><mrow><mi>F</mi><mo lspace="0em" rspace="0em">​</mo><mi>F</mi></mrow><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mover accent="true"><mi>𝑿</mi><mo>~</mo></mover><mo>)</mo></mrow></mrow><mo>=</mo><mrow><msub><mi>σ</mi><mi>R</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><msub><mi>𝑾</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mover accent="true"><mi>𝑿</mi><mo>~</mo></mover></mrow><mo>)</mo></mrow></mrow><mo>=</mo><mrow><mo>(</mo><mtable rowspacing="0pt"><mtr><mtd><mrow><mtext>diag</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mn>11</mn></msub><mo>,</mo><msub><mi>x</mi><mn>12</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>x</mi><mrow><mn>1</mn><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow></msub><mo stretchy="false">)</mo></mrow></mrow></mtd></mtr><mtr><mtd><mrow><mtext>diag</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mn>21</mn></msub><mo>,</mo><msub><mi>x</mi><mn>22</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>x</mi><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow></msub><mo stretchy="false">)</mo></mrow></mrow></mtd></mtr><mtr><mtd></mtd></mtr><mtr><mtd><mrow><mtext>diag</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mn>1</mn></mrow></msub><mo>,</mo><msub><mi>x</mi><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mn>2</mn></mrow></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>x</mi><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow></msub><mo stretchy="false">)</mo></mrow></mrow></mtd></mtr><mtr><mtd><msub><mn>𝟎</mn><mrow><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow><mo lspace="0.222em" rspace="0.222em">×</mo><mi>n</mi></mrow></msub></mtd></mtr></mtable><mo>)</mo></mrow><mo>∈</mo><msup><mi>ℝ</mi><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow><mo lspace="0.222em" rspace="0.222em">×</mo><mi>n</mi></mrow></msup></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\boldsymbol{\mathcal{F}}_{FF,1}^{(FF)}\left(\boldsymbol{\widetilde{X}}\right)=\sigma_{R}\left(\boldsymbol{W}_{1}\boldsymbol{\widetilde{X}}\right)=\begin{pmatrix}\text{diag}(x_{11},x_{12},\dots,x_{1n})\\
\text{diag}(x_{21},x_{22},\dots,x_{2n})\\
\vdots\\
\text{diag}(x_{d1},x_{d2},\dots,x_{dn})\\
\boldsymbol{0}_{dn\times n}\end{pmatrix}\in\mathbb{R}^{2dn\times n},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S3.SS2.p1.5" class="ltx_p">where</p>
<table id="S3.EGx116" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="S3.Ex172"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S3.Ex172.m1" class="ltx_Math" alttext="\displaystyle\text{diag}(x_{i1},x_{i2},\dots,x_{in}):=\begin{pmatrix}x_{i1}&amp;0&amp;\cdots&amp;0\\
0&amp;x_{i2}&amp;\cdots&amp;0\\
\vdots&amp;\vdots&amp;\ddots&amp;\vdots\\
0&amp;0&amp;\cdots&amp;x_{in}\end{pmatrix}." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mtext>diag</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mn>1</mn></mrow></msub><mo>,</mo><msub><mi>x</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mn>2</mn></mrow></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>x</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><mo>:=</mo><mrow><mo>(</mo><mtable columnspacing="5pt" rowspacing="0pt"><mtr><mtd><msub><mi>x</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mn>1</mn></mrow></msub></mtd><mtd><mn>0</mn></mtd><mtd><mo>⋯</mo></mtd><mtd><mn>0</mn></mtd></mtr><mtr><mtd><mn>0</mn></mtd><mtd><msub><mi>x</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mn>2</mn></mrow></msub></mtd><mtd><mo>⋯</mo></mtd><mtd><mn>0</mn></mtd></mtr><mtr><mtd></mtd><mtd></mtd><mtd><mi mathvariant="normal">⋱</mi></mtd><mtd></mtd></mtr><mtr><mtd><mn>0</mn></mtd><mtd><mn>0</mn></mtd><mtd><mo>⋯</mo></mtd><mtd><msub><mi>x</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow></msub></mtd></mtr></mtable><mo>)</mo></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\text{diag}(x_{i1},x_{i2},\dots,x_{in}):=\begin{pmatrix}x_{i1}&amp;0&amp;\cdots&amp;0\\
0&amp;x_{i2}&amp;\cdots&amp;0\\
\vdots&amp;\vdots&amp;\ddots&amp;\vdots\\
0&amp;0&amp;\cdots&amp;x_{in}\end{pmatrix}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S3.SS2.p1.6" class="ltx_p">Define the matrices in the self-attention layer to be</p>
<table id="S3.EGx117" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="S3.Ex173"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S3.Ex173.m1" class="ltx_Math" alttext="\displaystyle\boldsymbol{W}_{O}:=\begin{pmatrix}\boldsymbol{0}_{dn\times dn}\\
n\boldsymbol{I}_{dn\times dn}\end{pmatrix},\quad\boldsymbol{W}_{V}:=\begin{pmatrix}\boldsymbol{I}_{dn\times dn}&amp;\boldsymbol{0}_{dn\times dn}\end{pmatrix},\quad\boldsymbol{W}_{K}:=\boldsymbol{W}_{Q}:=\boldsymbol{0}_{1\times 2dn}." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><msub><mi>𝑾</mi><mi>O</mi></msub><mo>:=</mo><mrow><mo>(</mo><mtable rowspacing="0pt"><mtr><mtd><msub><mn>𝟎</mn><mrow><mrow><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow><mo lspace="0.222em" rspace="0.222em">×</mo><mi>d</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow></msub></mtd></mtr><mtr><mtd><mrow><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝑰</mi><mrow><mrow><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow><mo lspace="0.222em" rspace="0.222em">×</mo><mi>d</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow></msub></mrow></mtd></mtr></mtable><mo>)</mo></mrow></mrow><mo rspace="1.167em">,</mo><mrow><msub><mi>𝑾</mi><mi>V</mi></msub><mo>:=</mo><mrow><mo>(</mo><mtable columnspacing="5pt"><mtr><mtd><msub><mi>𝑰</mi><mrow><mrow><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow><mo lspace="0.222em" rspace="0.222em">×</mo><mi>d</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow></msub></mtd><mtd><msub><mn>𝟎</mn><mrow><mrow><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow><mo lspace="0.222em" rspace="0.222em">×</mo><mi>d</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow></msub></mtd></mtr></mtable><mo>)</mo></mrow></mrow><mo rspace="1.167em">,</mo><mrow><msub><mi>𝑾</mi><mi>K</mi></msub><mo>:=</mo><msub><mi>𝑾</mi><mi>Q</mi></msub><mo>:=</mo><msub><mn>𝟎</mn><mrow><mrow><mn>1</mn><mo lspace="0.222em" rspace="0.222em">×</mo><mn>2</mn></mrow><mo lspace="0em" rspace="0em">​</mo><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow></msub></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\boldsymbol{W}_{O}:=\begin{pmatrix}\boldsymbol{0}_{dn\times dn}\\
n\boldsymbol{I}_{dn\times dn}\end{pmatrix},\quad\boldsymbol{W}_{V}:=\begin{pmatrix}\boldsymbol{I}_{dn\times dn}&amp;\boldsymbol{0}_{dn\times dn}\end{pmatrix},\quad\boldsymbol{W}_{K}:=\boldsymbol{W}_{Q}:=\boldsymbol{0}_{1\times 2dn}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S3.SS2.p1.7" class="ltx_p">It follows that the output of the softmax function is <math id="S3.SS2.p1.m2" class="ltx_Math" alttext="\frac{1}{n}\boldsymbol{1}_{n\times n}" display="inline" intent=":literal"><semantics><mrow><mfrac><mn>1</mn><mi>n</mi></mfrac><mo lspace="0em" rspace="0em">​</mo><msub><mn>𝟏</mn><mrow><mi>n</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>n</mi></mrow></msub></mrow><annotation encoding="application/x-tex">\frac{1}{n}\boldsymbol{1}_{n\times n}</annotation></semantics></math> and hence</p>
<table id="S3.EGx118" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="S3.Ex174"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S3.Ex174.m1" class="ltx_Math" alttext="\displaystyle\boldsymbol{\mathcal{F}}_{SA}^{(FF)}\circ\boldsymbol{\mathcal{F}}_{FF,1}^{(FF)}\left(\boldsymbol{\widetilde{X}}\right)" display="inline" intent=":literal"><semantics><mrow><mrow><msubsup><mi class="ltx_font_mathcaligraphic">𝓕</mi><mrow><mi>S</mi><mo lspace="0em" rspace="0em">​</mo><mi>A</mi></mrow><mrow><mo stretchy="false">(</mo><mrow><mi>F</mi><mo lspace="0em" rspace="0em">​</mo><mi>F</mi></mrow><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0.222em" rspace="0.222em">∘</mo><msubsup><mi class="ltx_font_mathcaligraphic">𝓕</mi><mrow><mrow><mi>F</mi><mo lspace="0em" rspace="0em">​</mo><mi>F</mi></mrow><mo>,</mo><mn>1</mn></mrow><mrow><mo stretchy="false">(</mo><mrow><mi>F</mi><mo lspace="0em" rspace="0em">​</mo><mi>F</mi></mrow><mo stretchy="false">)</mo></mrow></msubsup></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mover accent="true"><mi>𝑿</mi><mo>~</mo></mover><mo>)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\boldsymbol{\mathcal{F}}_{SA}^{(FF)}\circ\boldsymbol{\mathcal{F}}_{FF,1}^{(FF)}\left(\boldsymbol{\widetilde{X}}\right)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="S3.Ex175"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S3.Ex175.m1" class="ltx_Math" alttext="\displaystyle=\begin{pmatrix}\text{diag}(x_{11},x_{12},\dots,x_{1n})\\
\text{diag}(x_{21},x_{22},\dots,x_{2n})\\
\vdots\\
\text{diag}(x_{d1},x_{d2},\dots,x_{dn})\\
\boldsymbol{0}_{dn\times n}\end{pmatrix}+\frac{1}{n}\begin{pmatrix}\boldsymbol{0}_{dn\times dn}\\
n\boldsymbol{I}_{dn\times dn}\end{pmatrix}\begin{pmatrix}\boldsymbol{I}_{dn\times dn}&amp;\boldsymbol{0}_{dn\times dn}\end{pmatrix}\begin{pmatrix}\text{diag}(x_{11},x_{12},\dots,x_{1n})\\
\text{diag}(x_{21},x_{22},\dots,x_{2n})\\
\vdots\\
\text{diag}(x_{d1},x_{d2},\dots,x_{dn})\\
\boldsymbol{0}_{dn\times n}\end{pmatrix}\boldsymbol{1}_{n\times n}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><mo>(</mo><mtable rowspacing="0pt"><mtr><mtd><mrow><mtext>diag</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mn>11</mn></msub><mo>,</mo><msub><mi>x</mi><mn>12</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>x</mi><mrow><mn>1</mn><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow></msub><mo stretchy="false">)</mo></mrow></mrow></mtd></mtr><mtr><mtd><mrow><mtext>diag</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mn>21</mn></msub><mo>,</mo><msub><mi>x</mi><mn>22</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>x</mi><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow></msub><mo stretchy="false">)</mo></mrow></mrow></mtd></mtr><mtr><mtd></mtd></mtr><mtr><mtd><mrow><mtext>diag</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mn>1</mn></mrow></msub><mo>,</mo><msub><mi>x</mi><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mn>2</mn></mrow></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>x</mi><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow></msub><mo stretchy="false">)</mo></mrow></mrow></mtd></mtr><mtr><mtd><msub><mn>𝟎</mn><mrow><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow><mo lspace="0.222em" rspace="0.222em">×</mo><mi>n</mi></mrow></msub></mtd></mtr></mtable><mo>)</mo></mrow><mo>+</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>n</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mtable rowspacing="0pt"><mtr><mtd><msub><mn>𝟎</mn><mrow><mrow><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow><mo lspace="0.222em" rspace="0.222em">×</mo><mi>d</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow></msub></mtd></mtr><mtr><mtd><mrow><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝑰</mi><mrow><mrow><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow><mo lspace="0.222em" rspace="0.222em">×</mo><mi>d</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow></msub></mrow></mtd></mtr></mtable><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mtable columnspacing="5pt"><mtr><mtd><msub><mi>𝑰</mi><mrow><mrow><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow><mo lspace="0.222em" rspace="0.222em">×</mo><mi>d</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow></msub></mtd><mtd><msub><mn>𝟎</mn><mrow><mrow><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow><mo lspace="0.222em" rspace="0.222em">×</mo><mi>d</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow></msub></mtd></mtr></mtable><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mtable rowspacing="0pt"><mtr><mtd><mrow><mtext>diag</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mn>11</mn></msub><mo>,</mo><msub><mi>x</mi><mn>12</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>x</mi><mrow><mn>1</mn><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow></msub><mo stretchy="false">)</mo></mrow></mrow></mtd></mtr><mtr><mtd><mrow><mtext>diag</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mn>21</mn></msub><mo>,</mo><msub><mi>x</mi><mn>22</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>x</mi><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow></msub><mo stretchy="false">)</mo></mrow></mrow></mtd></mtr><mtr><mtd></mtd></mtr><mtr><mtd><mrow><mtext>diag</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mn>1</mn></mrow></msub><mo>,</mo><msub><mi>x</mi><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mn>2</mn></mrow></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>x</mi><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow></msub><mo stretchy="false">)</mo></mrow></mrow></mtd></mtr><mtr><mtd><msub><mn>𝟎</mn><mrow><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow><mo lspace="0.222em" rspace="0.222em">×</mo><mi>n</mi></mrow></msub></mtd></mtr></mtable><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mn>𝟏</mn><mrow><mi>n</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>n</mi></mrow></msub></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\begin{pmatrix}\text{diag}(x_{11},x_{12},\dots,x_{1n})\\
\text{diag}(x_{21},x_{22},\dots,x_{2n})\\
\vdots\\
\text{diag}(x_{d1},x_{d2},\dots,x_{dn})\\
\boldsymbol{0}_{dn\times n}\end{pmatrix}+\frac{1}{n}\begin{pmatrix}\boldsymbol{0}_{dn\times dn}\\
n\boldsymbol{I}_{dn\times dn}\end{pmatrix}\begin{pmatrix}\boldsymbol{I}_{dn\times dn}&amp;\boldsymbol{0}_{dn\times dn}\end{pmatrix}\begin{pmatrix}\text{diag}(x_{11},x_{12},\dots,x_{1n})\\
\text{diag}(x_{21},x_{22},\dots,x_{2n})\\
\vdots\\
\text{diag}(x_{d1},x_{d2},\dots,x_{dn})\\
\boldsymbol{0}_{dn\times n}\end{pmatrix}\boldsymbol{1}_{n\times n}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="S3.Ex176"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S3.Ex176.m1" class="ltx_Math" alttext="\displaystyle=\begin{pmatrix}\text{diag}(x_{11},x_{12},\dots,x_{1n})\\
\text{diag}(x_{21},x_{22},\dots,x_{2n})\\
\vdots\\
\text{diag}(x_{d1},x_{d2},\dots,x_{dn})\\
\boldsymbol{X}^{(flt)}\boldsymbol{1}_{1\times n}\end{pmatrix}\in\mathbb{R}^{2dn\times n}." display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>=</mo><mrow><mo>(</mo><mtable rowspacing="0pt"><mtr><mtd><mrow><mtext>diag</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mn>11</mn></msub><mo>,</mo><msub><mi>x</mi><mn>12</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>x</mi><mrow><mn>1</mn><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow></msub><mo stretchy="false">)</mo></mrow></mrow></mtd></mtr><mtr><mtd><mrow><mtext>diag</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mn>21</mn></msub><mo>,</mo><msub><mi>x</mi><mn>22</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>x</mi><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow></msub><mo stretchy="false">)</mo></mrow></mrow></mtd></mtr><mtr><mtd></mtd></mtr><mtr><mtd><mrow><mtext>diag</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mn>1</mn></mrow></msub><mo>,</mo><msub><mi>x</mi><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mn>2</mn></mrow></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>x</mi><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow></msub><mo stretchy="false">)</mo></mrow></mrow></mtd></mtr><mtr><mtd><mrow><msup><mi>𝑿</mi><mrow><mo stretchy="false">(</mo><mrow><mi>f</mi><mo lspace="0em" rspace="0em">​</mo><mi>l</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow><mo stretchy="false">)</mo></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msub><mn>𝟏</mn><mrow><mn>1</mn><mo lspace="0.222em" rspace="0.222em">×</mo><mi>n</mi></mrow></msub></mrow></mtd></mtr></mtable><mo>)</mo></mrow><mo>∈</mo><msup><mi>ℝ</mi><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow><mo lspace="0.222em" rspace="0.222em">×</mo><mi>n</mi></mrow></msup></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle=\begin{pmatrix}\text{diag}(x_{11},x_{12},\dots,x_{1n})\\
\text{diag}(x_{21},x_{22},\dots,x_{2n})\\
\vdots\\
\text{diag}(x_{d1},x_{d2},\dots,x_{dn})\\
\boldsymbol{X}^{(flt)}\boldsymbol{1}_{1\times n}\end{pmatrix}\in\mathbb{R}^{2dn\times n}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S3.SS2.p1.8" class="ltx_p">Denote</p>
<table id="S3.EGx119" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="S3.Ex177"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S3.Ex177.m1" class="ltx_Math" alttext="\displaystyle\boldsymbol{W}_{2}:=\begin{pmatrix}\boldsymbol{0}_{dn\times dn}&amp;\boldsymbol{\boldsymbol{I}}_{dn\times dn}\end{pmatrix}" display="inline" intent=":literal"><semantics><mrow><msub><mi>𝑾</mi><mn>2</mn></msub><mo>:=</mo><mrow><mo>(</mo><mtable columnspacing="5pt"><mtr><mtd><msub><mn>𝟎</mn><mrow><mrow><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow><mo lspace="0.222em" rspace="0.222em">×</mo><mi>d</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow></msub></mtd><mtd><msub><mi>𝑰</mi><mrow><mrow><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow><mo lspace="0.222em" rspace="0.222em">×</mo><mi>d</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow></msub></mtd></mtr></mtable><mo>)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\boldsymbol{W}_{2}:=\begin{pmatrix}\boldsymbol{0}_{dn\times dn}&amp;\boldsymbol{\boldsymbol{I}}_{dn\times dn}\end{pmatrix}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S3.SS2.p1.9" class="ltx_p">and let</p>
<table id="S3.EGx120" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="S3.Ex178"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S3.Ex178.m1" class="ltx_Math" alttext="\displaystyle\boldsymbol{\mathcal{F}}_{FF,2}^{(FF)}(\boldsymbol{Y}):=\boldsymbol{\mathcal{F}}_{FF}(\boldsymbol{W}_{2}\boldsymbol{Y}),\quad\boldsymbol{Y}\in\mathbb{R}^{2dn\times n}," display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mrow><msubsup><mi class="ltx_font_mathcaligraphic">𝓕</mi><mrow><mrow><mi>F</mi><mo lspace="0em" rspace="0em">​</mo><mi>F</mi></mrow><mo>,</mo><mn>2</mn></mrow><mrow><mo stretchy="false">(</mo><mrow><mi>F</mi><mo lspace="0em" rspace="0em">​</mo><mi>F</mi></mrow><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝒀</mi><mo stretchy="false">)</mo></mrow></mrow><mo>:=</mo><mrow><msub><mi class="ltx_font_mathcaligraphic">𝓕</mi><mrow><mi>F</mi><mo lspace="0em" rspace="0em">​</mo><mi>F</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>𝑾</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><mi>𝒀</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo rspace="1.167em">,</mo><mrow><mi>𝒀</mi><mo>∈</mo><msup><mi>ℝ</mi><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow><mo lspace="0.222em" rspace="0.222em">×</mo><mi>n</mi></mrow></msup></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\boldsymbol{\mathcal{F}}_{FF,2}^{(FF)}(\boldsymbol{Y}):=\boldsymbol{\mathcal{F}}_{FF}(\boldsymbol{W}_{2}\boldsymbol{Y}),\quad\boldsymbol{Y}\in\mathbb{R}^{2dn\times n},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S3.SS2.p1.10" class="ltx_p">where <math id="S3.SS2.p1.m3" class="ltx_Math" alttext="{\boldsymbol{\mathcal{F}}}_{FF}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">𝓕</mi><mrow><mi>F</mi><mo lspace="0em" rspace="0em">​</mo><mi>F</mi></mrow></msub><annotation encoding="application/x-tex">{\boldsymbol{\mathcal{F}}}_{FF}</annotation></semantics></math> is the feedforward block generated from <math id="S3.SS2.p1.m4" class="ltx_Math" alttext="f_{FF}" display="inline" intent=":literal"><semantics><msub><mi>f</mi><mrow><mi>F</mi><mo lspace="0em" rspace="0em">​</mo><mi>F</mi></mrow></msub><annotation encoding="application/x-tex">f_{FF}</annotation></semantics></math>. Then the Transformer <math id="S3.SS2.p1.m5" class="ltx_Math" alttext="\boldsymbol{T}^{(FF)}" display="inline" intent=":literal"><semantics><msup><mi>𝑻</mi><mrow><mo stretchy="false">(</mo><mrow><mi>F</mi><mo lspace="0em" rspace="0em">​</mo><mi>F</mi></mrow><mo stretchy="false">)</mo></mrow></msup><annotation encoding="application/x-tex">\boldsymbol{T}^{(FF)}</annotation></semantics></math> is defined as</p>
<table id="S3.EGx121" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="S3.Ex179"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S3.Ex179.m1" class="ltx_Math" alttext="\displaystyle\boldsymbol{T}^{(FF)}\left(\boldsymbol{\widetilde{X}}\right)" display="inline" intent=":literal"><semantics><mrow><msup><mi>𝑻</mi><mrow><mo stretchy="false">(</mo><mrow><mi>F</mi><mo lspace="0em" rspace="0em">​</mo><mi>F</mi></mrow><mo stretchy="false">)</mo></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mover accent="true"><mi>𝑿</mi><mo>~</mo></mover><mo>)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\boldsymbol{T}^{(FF)}\left(\boldsymbol{\widetilde{X}}\right)</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S3.Ex179.m2" class="ltx_Math" alttext="\displaystyle:=\boldsymbol{\mathcal{F}}_{FF,2}^{(FF)}\circ\boldsymbol{\mathcal{F}}_{SA}^{(FF)}\circ\boldsymbol{\mathcal{F}}_{FF,1}^{(FF)}\left(\boldsymbol{\widetilde{X}}\right)" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mphantom></mphantom><mo>=</mo><mrow><msubsup><mi class="ltx_font_mathcaligraphic">𝓕</mi><mrow><mrow><mi>F</mi><mo lspace="0em" rspace="0em">​</mo><mi>F</mi></mrow><mo>,</mo><mn>2</mn></mrow><mrow><mo stretchy="false">(</mo><mrow><mi>F</mi><mo lspace="0em" rspace="0em">​</mo><mi>F</mi></mrow><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0.222em" rspace="0.222em">∘</mo><msubsup><mi class="ltx_font_mathcaligraphic">𝓕</mi><mrow><mi>S</mi><mo lspace="0em" rspace="0em">​</mo><mi>A</mi></mrow><mrow><mo stretchy="false">(</mo><mrow><mi>F</mi><mo lspace="0em" rspace="0em">​</mo><mi>F</mi></mrow><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0.222em" rspace="0.222em">∘</mo><mrow><msubsup><mi class="ltx_font_mathcaligraphic">𝓕</mi><mrow><mrow><mi>F</mi><mo lspace="0em" rspace="0em">​</mo><mi>F</mi></mrow><mo>,</mo><mn>1</mn></mrow><mrow><mo stretchy="false">(</mo><mrow><mi>F</mi><mo lspace="0em" rspace="0em">​</mo><mi>F</mi></mrow><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mover accent="true"><mi>𝑿</mi><mo>~</mo></mover><mo>)</mo></mrow></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle:=\boldsymbol{\mathcal{F}}_{FF,2}^{(FF)}\circ\boldsymbol{\mathcal{F}}_{SA}^{(FF)}\circ\boldsymbol{\mathcal{F}}_{FF,1}^{(FF)}\left(\boldsymbol{\widetilde{X}}\right)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="S3.Ex180"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S3.Ex180.m1" class="ltx_Math" alttext="\displaystyle=\boldsymbol{\mathcal{F}}_{FF}\left(\begin{pmatrix}\boldsymbol{0}_{dn\times dn}&amp;\boldsymbol{\boldsymbol{I}}_{dn\times dn}\end{pmatrix}\begin{pmatrix}\text{diag}(x_{11},x_{12},\dots,x_{1n})\\
\text{diag}(x_{21},x_{22},\dots,x_{2n})\\
\vdots\\
\text{diag}(x_{d1},x_{d2},\dots,x_{dn})\\
\boldsymbol{X}^{(flt)}\boldsymbol{1}_{1\times n}\end{pmatrix}\right)" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><msub><mi class="ltx_font_mathcaligraphic">𝓕</mi><mrow><mi>F</mi><mo lspace="0em" rspace="0em">​</mo><mi>F</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mrow><mo>(</mo><mtable columnspacing="5pt"><mtr><mtd><msub><mn>𝟎</mn><mrow><mrow><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow><mo lspace="0.222em" rspace="0.222em">×</mo><mi>d</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow></msub></mtd><mtd><msub><mi>𝑰</mi><mrow><mrow><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow><mo lspace="0.222em" rspace="0.222em">×</mo><mi>d</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow></msub></mtd></mtr></mtable><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mtable rowspacing="0pt"><mtr><mtd><mrow><mtext>diag</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mn>11</mn></msub><mo>,</mo><msub><mi>x</mi><mn>12</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>x</mi><mrow><mn>1</mn><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow></msub><mo stretchy="false">)</mo></mrow></mrow></mtd></mtr><mtr><mtd><mrow><mtext>diag</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mn>21</mn></msub><mo>,</mo><msub><mi>x</mi><mn>22</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>x</mi><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow></msub><mo stretchy="false">)</mo></mrow></mrow></mtd></mtr><mtr><mtd></mtd></mtr><mtr><mtd><mrow><mtext>diag</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mn>1</mn></mrow></msub><mo>,</mo><msub><mi>x</mi><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mn>2</mn></mrow></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>x</mi><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow></msub><mo stretchy="false">)</mo></mrow></mrow></mtd></mtr><mtr><mtd><mrow><msup><mi>𝑿</mi><mrow><mo stretchy="false">(</mo><mrow><mi>f</mi><mo lspace="0em" rspace="0em">​</mo><mi>l</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow><mo stretchy="false">)</mo></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msub><mn>𝟏</mn><mrow><mn>1</mn><mo lspace="0.222em" rspace="0.222em">×</mo><mi>n</mi></mrow></msub></mrow></mtd></mtr></mtable><mo>)</mo></mrow></mrow><mo>)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\boldsymbol{\mathcal{F}}_{FF}\left(\begin{pmatrix}\boldsymbol{0}_{dn\times dn}&amp;\boldsymbol{\boldsymbol{I}}_{dn\times dn}\end{pmatrix}\begin{pmatrix}\text{diag}(x_{11},x_{12},\dots,x_{1n})\\
\text{diag}(x_{21},x_{22},\dots,x_{2n})\\
\vdots\\
\text{diag}(x_{d1},x_{d2},\dots,x_{dn})\\
\boldsymbol{X}^{(flt)}\boldsymbol{1}_{1\times n}\end{pmatrix}\right)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="S3.Ex181"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S3.Ex181.m1" class="ltx_Math" alttext="\displaystyle=\boldsymbol{\mathcal{F}}_{FF}\left(\boldsymbol{X}^{(flt)}\boldsymbol{1}_{1\times n}\right)=f_{FF}\left(\boldsymbol{X}^{(flt)}\right)\boldsymbol{1}_{1\times n}." display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>=</mo><mrow><msub><mi class="ltx_font_mathcaligraphic">𝓕</mi><mrow><mi>F</mi><mo lspace="0em" rspace="0em">​</mo><mi>F</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><msup><mi>𝑿</mi><mrow><mo stretchy="false">(</mo><mrow><mi>f</mi><mo lspace="0em" rspace="0em">​</mo><mi>l</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow><mo stretchy="false">)</mo></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msub><mn>𝟏</mn><mrow><mn>1</mn><mo lspace="0.222em" rspace="0.222em">×</mo><mi>n</mi></mrow></msub></mrow><mo>)</mo></mrow></mrow><mo>=</mo><mrow><msub><mi>f</mi><mrow><mi>F</mi><mo lspace="0em" rspace="0em">​</mo><mi>F</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><msup><mi>𝑿</mi><mrow><mo stretchy="false">(</mo><mrow><mi>f</mi><mo lspace="0em" rspace="0em">​</mo><mi>l</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow><mo stretchy="false">)</mo></mrow></msup><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mn>𝟏</mn><mrow><mn>1</mn><mo lspace="0.222em" rspace="0.222em">×</mo><mi>n</mi></mrow></msub></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle=\boldsymbol{\mathcal{F}}_{FF}\left(\boldsymbol{X}^{(flt)}\boldsymbol{1}_{1\times n}\right)=f_{FF}\left(\boldsymbol{X}^{(flt)}\right)\boldsymbol{1}_{1\times n}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
</section>
<section id="S3.SS3" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">3.3 </span>Proof of Lemma <a href="#Thmlemma9" title="Lemma 9. ‣ 3.1 Proof of Proposition ‣ 3 Proof of Proposition : Construction of Transformers ‣ Standard Transformers Achieve the Minimax Rate in Nonparametric Regression with 𝐶^{𝑠,𝜆} Targets" class="ltx_ref"><span class="ltx_text ltx_ref_tag">9</span></a></h3>

<div id="Thmlemma13" class="ltx_theorem ltx_theorem_lemma">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="Thmlemma13.2" class="ltx_text ltx_font_bold">Lemma 13</span></span><span id="Thmlemma13.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="Thmlemma13.p1" class="ltx_para">
<p id="Thmlemma13.p1.1" class="ltx_p"><span id="Thmlemma13.p1.1.1" class="ltx_text ltx_font_italic">Let <math id="Thmlemma13.p1.m1" class="ltx_Math" alttext="d\in\mathbb{N}_{&gt;1}" display="inline" intent=":literal"><semantics><mrow><mi>d</mi><mo>∈</mo><msub><mi>ℕ</mi><mrow><mphantom></mphantom><mo>&gt;</mo><mn>1</mn></mrow></msub></mrow><annotation encoding="application/x-tex">d\in\mathbb{N}_{&gt;1}</annotation></semantics></math>. For any <math id="Thmlemma13.p1.m2" class="ltx_Math" alttext="0&lt;\epsilon\leq\frac{3^{\lceil\log_{2}d\rceil}-1}{3^{\lceil\log_{2}d\rceil-1}-1}" display="inline" intent=":literal"><semantics><mrow><mn>0</mn><mo>&lt;</mo><mi>ϵ</mi><mo>≤</mo><mfrac><mrow><msup><mn>3</mn><mrow><mo stretchy="false">⌈</mo><mrow><msub><mi>log</mi><mn>2</mn></msub><mo lspace="0.167em">⁡</mo><mi>d</mi></mrow><mo stretchy="false">⌉</mo></mrow></msup><mo>−</mo><mn>1</mn></mrow><mrow><msup><mn>3</mn><mrow><mrow><mo stretchy="false">⌈</mo><mrow><msub><mi>log</mi><mn>2</mn></msub><mo lspace="0.167em">⁡</mo><mi>d</mi></mrow><mo stretchy="false">⌉</mo></mrow><mo>−</mo><mn>1</mn></mrow></msup><mo>−</mo><mn>1</mn></mrow></mfrac></mrow><annotation encoding="application/x-tex">0&lt;\epsilon\leq\frac{3^{\lceil\log_{2}d\rceil}-1}{3^{\lceil\log_{2}d\rceil-1}-1}</annotation></semantics></math>, there exists a ReLU FNN function <math id="Thmlemma13.p1.m3" class="ltx_Math" alttext="f_{FF,d}^{(mtp)}:\mathbb{R}^{d}\to\mathbb{R}" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>f</mi><mrow><mrow><mi>F</mi><mo lspace="0em" rspace="0em">​</mo><mi>F</mi></mrow><mo>,</mo><mi>d</mi></mrow><mrow><mo stretchy="false">(</mo><mrow><mi>m</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi><mo lspace="0em" rspace="0em">​</mo><mi>p</mi></mrow><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><msup><mi>ℝ</mi><mi>d</mi></msup><mo stretchy="false">→</mo><mi>ℝ</mi></mrow></mrow><annotation encoding="application/x-tex">f_{FF,d}^{(mtp)}:\mathbb{R}^{d}\to\mathbb{R}</annotation></semantics></math> with width <math id="Thmlemma13.p1.m4" class="ltx_Math" alttext="21\cdot 2^{\lceil\log_{2}d\rceil-1}" display="inline" intent=":literal"><semantics><mrow><mn>21</mn><mo lspace="0.222em" rspace="0.222em">⋅</mo><msup><mn>2</mn><mrow><mrow><mo stretchy="false">⌈</mo><mrow><msub><mi>log</mi><mn>2</mn></msub><mo lspace="0.167em">⁡</mo><mi>d</mi></mrow><mo stretchy="false">⌉</mo></mrow><mo>−</mo><mn>1</mn></mrow></msup></mrow><annotation encoding="application/x-tex">21\cdot 2^{\lceil\log_{2}d\rceil-1}</annotation></semantics></math>, depth <math id="Thmlemma13.p1.m5" class="ltx_Math" alttext="C\ln\frac{3^{\lceil\log_{2}d\rceil}-1}{2\epsilon}" display="inline" intent=":literal"><semantics><mrow><mi>C</mi><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>ln</mi><mo lspace="0.167em">⁡</mo><mfrac><mrow><msup><mn>3</mn><mrow><mo stretchy="false">⌈</mo><mrow><msub><mi>log</mi><mn>2</mn></msub><mo lspace="0.167em">⁡</mo><mi>d</mi></mrow><mo stretchy="false">⌉</mo></mrow></msup><mo>−</mo><mn>1</mn></mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>ϵ</mi></mrow></mfrac></mrow></mrow><annotation encoding="application/x-tex">C\ln\frac{3^{\lceil\log_{2}d\rceil}-1}{2\epsilon}</annotation></semantics></math> and weight bound <math id="Thmlemma13.p1.m6" class="ltx_Math" alttext="C" display="inline" intent=":literal"><semantics><mi>C</mi><annotation encoding="application/x-tex">C</annotation></semantics></math> such that for any <math id="Thmlemma13.p1.m7" class="ltx_Math" alttext="\boldsymbol{x}\in[0,1]^{d}" display="inline" intent=":literal"><semantics><mrow><mi>𝐱</mi><mo>∈</mo><msup><mrow><mo stretchy="false">[</mo><mrow><mn>0</mn><mo>,</mo><mn>1</mn></mrow><mo stretchy="false">]</mo></mrow><mi>d</mi></msup></mrow><annotation encoding="application/x-tex">\boldsymbol{x}\in[0,1]^{d}</annotation></semantics></math>,</span></p>
<table id="S3.EGx122" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="S3.Ex182"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S3.Ex182.m1" class="ltx_math_unparsed" alttext="\displaystyle\left|f_{FF,d}^{(mtp)}(\boldsymbol{{x}})-x_{1}\cdots x_{d}\right|\leq\epsilon." display="inline" intent=":literal"><semantics><mrow><mo fence="false" rspace="0.167em">|</mo><msubsup><mi>f</mi><mrow><mrow><mi>F</mi><mo lspace="0em" rspace="0em">​</mo><mi>F</mi></mrow><mo>,</mo><mi>d</mi></mrow><mrow><mo stretchy="false">(</mo><mrow><mi>m</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi><mo lspace="0em" rspace="0em">​</mo><mi>p</mi></mrow><mo stretchy="false">)</mo></mrow></msubsup><mrow><mo stretchy="false">(</mo><mi>𝒙</mi><mo stretchy="false">)</mo></mrow><mo>−</mo><msub><mi>x</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">⋯</mo><msub><mi>x</mi><mi>d</mi></msub><mo fence="false">|</mo><mo lspace="0.167em">≤</mo><mi>ϵ</mi><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\left|f_{FF,d}^{(mtp)}(\boldsymbol{{x}})-x_{1}\cdots x_{d}\right|\leq\epsilon.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
</div>
<div id="S3.SS3.2" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="S3.SS3.p1" class="ltx_para">
<p id="S3.SS3.p1.1" class="ltx_p"><span id="S3.SS3.p1.1.1" class="ltx_text">Assume <math id="S3.SS3.p1.m1" class="ltx_Math" alttext="2^{\widetilde{d}-1}&lt;d\leq 2^{\widetilde{d}}" display="inline" intent=":literal"><semantics><mrow><msup><mn>2</mn><mrow><mover accent="true"><mi>d</mi><mo>~</mo></mover><mo>−</mo><mn>1</mn></mrow></msup><mo>&lt;</mo><mi>d</mi><mo>≤</mo><msup><mn>2</mn><mover accent="true"><mi>d</mi><mo>~</mo></mover></msup></mrow><annotation encoding="application/x-tex">2^{\widetilde{d}-1}&lt;d\leq 2^{\widetilde{d}}</annotation></semantics></math> for some <math id="S3.SS3.p1.m2" class="ltx_Math" alttext="\widetilde{d}\in\mathbb{N}_{\geq 1}" display="inline" intent=":literal"><semantics><mrow><mover accent="true"><mi>d</mi><mo>~</mo></mover><mo>∈</mo><msub><mi>ℕ</mi><mrow><mphantom></mphantom><mo>≥</mo><mn>1</mn></mrow></msub></mrow><annotation encoding="application/x-tex">\widetilde{d}\in\mathbb{N}_{\geq 1}</annotation></semantics></math>. We first adopt a linear mapping to expand <math id="S3.SS3.p1.m3" class="ltx_Math" alttext="\boldsymbol{{x}}" display="inline" intent=":literal"><semantics><mi>𝒙</mi><annotation encoding="application/x-tex">\boldsymbol{{x}}</annotation></semantics></math> into</span></p>
<table id="S3.EGx123" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="S3.Ex183"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S3.Ex183.m1" class="ltx_Math" alttext="\displaystyle\boldsymbol{\widetilde{x}}:=\begin{pmatrix}\boldsymbol{x}\\
\boldsymbol{1}_{2^{\widetilde{d}}-d}\end{pmatrix}\in\mathbb{R}^{2^{\widetilde{d}}}." display="inline" intent=":literal"><semantics><mrow><mrow><mover accent="true"><mi>𝒙</mi><mo>~</mo></mover><mo>:=</mo><mrow><mo>(</mo><mtable rowspacing="0pt"><mtr><mtd><mi>𝒙</mi></mtd></mtr><mtr><mtd><msub><mn>𝟏</mn><mrow><msup><mn>2</mn><mover accent="true"><mi>d</mi><mo>~</mo></mover></msup><mo>−</mo><mi>d</mi></mrow></msub></mtd></mtr></mtable><mo>)</mo></mrow><mo>∈</mo><msup><mi>ℝ</mi><msup><mn>2</mn><mover accent="true"><mi>d</mi><mo>~</mo></mover></msup></msup></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\boldsymbol{\widetilde{x}}:=\begin{pmatrix}\boldsymbol{x}\\
\boldsymbol{1}_{2^{\widetilde{d}}-d}\end{pmatrix}\in\mathbb{R}^{2^{\widetilde{d}}}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S3.SS3.p1.2" class="ltx_p"><span id="S3.SS3.p1.2.1" class="ltx_text">Without loss of generality, in the following we simply assume <math id="S3.SS3.p1.m4" class="ltx_Math" alttext="d=2^{\widetilde{d}}" display="inline" intent=":literal"><semantics><mrow><mi>d</mi><mo>=</mo><msup><mn>2</mn><mover accent="true"><mi>d</mi><mo>~</mo></mover></msup></mrow><annotation encoding="application/x-tex">d=2^{\widetilde{d}}</annotation></semantics></math>. <math id="S3.SS3.p1.m5" class="ltx_Math" alttext="f_{FF,2^{\widetilde{d}}}^{(mtp)}" display="inline" intent=":literal"><semantics><msubsup><mi>f</mi><mrow><mrow><mi>F</mi><mo lspace="0em" rspace="0em">​</mo><mi>F</mi></mrow><mo>,</mo><msup><mn>2</mn><mover accent="true"><mi>d</mi><mo>~</mo></mover></msup></mrow><mrow><mo stretchy="false">(</mo><mrow><mi>m</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi><mo lspace="0em" rspace="0em">​</mo><mi>p</mi></mrow><mo stretchy="false">)</mo></mrow></msubsup><annotation encoding="application/x-tex">f_{FF,2^{\widetilde{d}}}^{(mtp)}</annotation></semantics></math> is recursviely defined by</span></p>
<table id="S3.EGx124" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="S3.E12"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S3.E12.m1" class="ltx_Math" alttext="\displaystyle f_{FF,2^{\widetilde{d}}}^{(mtp)}(\boldsymbol{{x}}):=\widetilde{\times}\left(f_{FF,2^{\widetilde{d}-1}}^{(mtp)}(\boldsymbol{{x}}_{1}),f_{FF,2^{\widetilde{d}-1}}^{(mtp)}(\boldsymbol{{x}}_{2})\right),\quad\boldsymbol{x}\in[0,1]^{2^{\widetilde{d}}}," display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mrow><msubsup><mi>f</mi><mrow><mrow><mi>F</mi><mo lspace="0em" rspace="0em">​</mo><mi>F</mi></mrow><mo>,</mo><msup><mn>2</mn><mover accent="true"><mi>d</mi><mo>~</mo></mover></msup></mrow><mrow><mo stretchy="false">(</mo><mrow><mi>m</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi><mo lspace="0em" rspace="0em">​</mo><mi>p</mi></mrow><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝒙</mi><mo stretchy="false">)</mo></mrow></mrow><mo rspace="0em">:=</mo><mrow><mover accent="true"><mo lspace="0em">×</mo><mo>~</mo></mover><mo lspace="0.222em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><msubsup><mi>f</mi><mrow><mrow><mi>F</mi><mo lspace="0em" rspace="0em">​</mo><mi>F</mi></mrow><mo>,</mo><msup><mn>2</mn><mrow><mover accent="true"><mi>d</mi><mo>~</mo></mover><mo>−</mo><mn>1</mn></mrow></msup></mrow><mrow><mo stretchy="false">(</mo><mrow><mi>m</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi><mo lspace="0em" rspace="0em">​</mo><mi>p</mi></mrow><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒙</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mrow><msubsup><mi>f</mi><mrow><mrow><mi>F</mi><mo lspace="0em" rspace="0em">​</mo><mi>F</mi></mrow><mo>,</mo><msup><mn>2</mn><mrow><mover accent="true"><mi>d</mi><mo>~</mo></mover><mo>−</mo><mn>1</mn></mrow></msup></mrow><mrow><mo stretchy="false">(</mo><mrow><mi>m</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi><mo lspace="0em" rspace="0em">​</mo><mi>p</mi></mrow><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒙</mi><mn>2</mn></msub><mo stretchy="false">)</mo></mrow></mrow><mo>)</mo></mrow></mrow></mrow><mo rspace="1.167em">,</mo><mrow><mi>𝒙</mi><mo>∈</mo><msup><mrow><mo stretchy="false">[</mo><mrow><mn>0</mn><mo>,</mo><mn>1</mn></mrow><mo stretchy="false">]</mo></mrow><msup><mn>2</mn><mover accent="true"><mi>d</mi><mo>~</mo></mover></msup></msup></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle f_{FF,2^{\widetilde{d}}}^{(mtp)}(\boldsymbol{{x}}):=\widetilde{\times}\left(f_{FF,2^{\widetilde{d}-1}}^{(mtp)}(\boldsymbol{{x}}_{1}),f_{FF,2^{\widetilde{d}-1}}^{(mtp)}(\boldsymbol{{x}}_{2})\right),\quad\boldsymbol{x}\in[0,1]^{2^{\widetilde{d}}},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(12)</span></td></tr></tbody>
</table>
<p id="S3.SS3.p1.3" class="ltx_p"><span id="S3.SS3.p1.3.1" class="ltx_text">where <math id="S3.SS3.p1.m6" class="ltx_Math" alttext="\widetilde{\times}" display="inline" intent=":literal"><semantics><mover accent="true"><mo>×</mo><mo>~</mo></mover><annotation encoding="application/x-tex">\widetilde{\times}</annotation></semantics></math> is the FNN function in Lemma <a href="#Thmlemma10" title="Lemma 10 ([], Proposition 3). ‣ 3.1 Proof of Proposition ‣ 3 Proof of Proposition : Construction of Transformers ‣ Standard Transformers Achieve the Minimax Rate in Nonparametric Regression with 𝐶^{𝑠,𝜆} Targets" class="ltx_ref"><span class="ltx_text ltx_ref_tag">10</span></a> that achieves approximation accuracy <math id="S3.SS3.p1.m7" class="ltx_Math" alttext="\widetilde{\epsilon}" display="inline" intent=":literal"><semantics><mover accent="true"><mi>ϵ</mi><mo>~</mo></mover><annotation encoding="application/x-tex">\widetilde{\epsilon}</annotation></semantics></math> and</span></p>
<table id="S3.EGx125" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="S3.Ex184"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S3.Ex184.m1" class="ltx_Math" alttext="\displaystyle\boldsymbol{{x}}_{1}=\left(x_{1},\cdots,x_{2^{\widetilde{d}-1}}\right),\quad\boldsymbol{{x}}_{2}=\left(x_{2^{\widetilde{d}-1}+1},\cdots,x_{2^{\widetilde{d}}}\right)." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><msub><mi>𝒙</mi><mn>1</mn></msub><mo>=</mo><mrow><mo>(</mo><msub><mi>x</mi><mn>1</mn></msub><mo>,</mo><mo lspace="0em" rspace="0em">⋯</mo><mo>,</mo><msub><mi>x</mi><msup><mn>2</mn><mrow><mover accent="true"><mi>d</mi><mo>~</mo></mover><mo>−</mo><mn>1</mn></mrow></msup></msub><mo>)</mo></mrow></mrow><mo rspace="1.167em">,</mo><mrow><msub><mi>𝒙</mi><mn>2</mn></msub><mo>=</mo><mrow><mo>(</mo><msub><mi>x</mi><mrow><msup><mn>2</mn><mrow><mover accent="true"><mi>d</mi><mo>~</mo></mover><mo>−</mo><mn>1</mn></mrow></msup><mo>+</mo><mn>1</mn></mrow></msub><mo>,</mo><mo lspace="0em" rspace="0em">⋯</mo><mo>,</mo><msub><mi>x</mi><msup><mn>2</mn><mover accent="true"><mi>d</mi><mo>~</mo></mover></msup></msub><mo>)</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\boldsymbol{{x}}_{1}=\left(x_{1},\cdots,x_{2^{\widetilde{d}-1}}\right),\quad\boldsymbol{{x}}_{2}=\left(x_{2^{\widetilde{d}-1}+1},\cdots,x_{2^{\widetilde{d}}}\right).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S3.SS3.p1.4" class="ltx_p"><span id="S3.SS3.p1.4.1" class="ltx_text">We show by induction on <math id="S3.SS3.p1.m8" class="ltx_Math" alttext="\widetilde{d}" display="inline" intent=":literal"><semantics><mover accent="true"><mi>d</mi><mo>~</mo></mover><annotation encoding="application/x-tex">\widetilde{d}</annotation></semantics></math> that the ReLU FNN function <math id="S3.SS3.p1.m9" class="ltx_Math" alttext="f_{FF,2^{\widetilde{d}}}^{(mtp)}" display="inline" intent=":literal"><semantics><msubsup><mi>f</mi><mrow><mrow><mi>F</mi><mo lspace="0em" rspace="0em">​</mo><mi>F</mi></mrow><mo>,</mo><msup><mn>2</mn><mover accent="true"><mi>d</mi><mo>~</mo></mover></msup></mrow><mrow><mo stretchy="false">(</mo><mrow><mi>m</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi><mo lspace="0em" rspace="0em">​</mo><mi>p</mi></mrow><mo stretchy="false">)</mo></mrow></msubsup><annotation encoding="application/x-tex">f_{FF,2^{\widetilde{d}}}^{(mtp)}</annotation></semantics></math> defined in (<a href="#S3.E12" title="In Proof. ‣ 3.3 Proof of Lemma ‣ 3 Proof of Proposition : Construction of Transformers ‣ Standard Transformers Achieve the Minimax Rate in Nonparametric Regression with 𝐶^{𝑠,𝜆} Targets" class="ltx_ref"><span class="ltx_text ltx_ref_tag">12</span></a>) is of width <math id="S3.SS3.p1.m10" class="ltx_Math" alttext="21\cdot 2^{\widetilde{d}-1}" display="inline" intent=":literal"><semantics><mrow><mn>21</mn><mo lspace="0.222em" rspace="0.222em">⋅</mo><msup><mn>2</mn><mrow><mover accent="true"><mi>d</mi><mo>~</mo></mover><mo>−</mo><mn>1</mn></mrow></msup></mrow><annotation encoding="application/x-tex">21\cdot 2^{\widetilde{d}-1}</annotation></semantics></math>, depth <math id="S3.SS3.p1.m11" class="ltx_Math" alttext="C\widetilde{d}\ln\frac{1}{\widetilde{\epsilon}}" display="inline" intent=":literal"><semantics><mrow><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><mover accent="true"><mi>d</mi><mo>~</mo></mover><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>ln</mi><mo lspace="0.167em">⁡</mo><mfrac><mn>1</mn><mover accent="true"><mi>ϵ</mi><mo>~</mo></mover></mfrac></mrow></mrow><annotation encoding="application/x-tex">C\widetilde{d}\ln\frac{1}{\widetilde{\epsilon}}</annotation></semantics></math> and weight bound <math id="S3.SS3.p1.m12" class="ltx_Math" alttext="C" display="inline" intent=":literal"><semantics><mi>C</mi><annotation encoding="application/x-tex">C</annotation></semantics></math>, and</span></p>
<table id="S3.EGx126" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="S3.Ex185"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S3.Ex185.m1" class="ltx_math_unparsed" alttext="\displaystyle\left|f_{FF,2^{\widetilde{d}}}^{(mtp)}(\boldsymbol{{x}})-x_{1}\cdots x_{2^{\widetilde{d}}}\right|\leq\frac{1}{2}\left(3^{\widetilde{d}}-1\right)\widetilde{\epsilon}." display="inline" intent=":literal"><semantics><mrow><mo fence="false" rspace="0.167em">|</mo><msubsup><mi>f</mi><mrow><mrow><mi>F</mi><mo lspace="0em" rspace="0em">​</mo><mi>F</mi></mrow><mo>,</mo><msup><mn>2</mn><mover accent="true"><mi>d</mi><mo>~</mo></mover></msup></mrow><mrow><mo stretchy="false">(</mo><mrow><mi>m</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi><mo lspace="0em" rspace="0em">​</mo><mi>p</mi></mrow><mo stretchy="false">)</mo></mrow></msubsup><mrow><mo stretchy="false">(</mo><mi>𝒙</mi><mo stretchy="false">)</mo></mrow><mo>−</mo><msub><mi>x</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">⋯</mo><msub><mi>x</mi><msup><mn>2</mn><mover accent="true"><mi>d</mi><mo>~</mo></mover></msup></msub><mo fence="false">|</mo><mo lspace="0.167em">≤</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mn>2</mn></mfrac></mstyle><mrow><mo>(</mo><msup><mn>3</mn><mover accent="true"><mi>d</mi><mo>~</mo></mover></msup><mo>−</mo><mn>1</mn><mo>)</mo></mrow><mover accent="true"><mi>ϵ</mi><mo>~</mo></mover><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\left|f_{FF,2^{\widetilde{d}}}^{(mtp)}(\boldsymbol{{x}})-x_{1}\cdots x_{2^{\widetilde{d}}}\right|\leq\frac{1}{2}\left(3^{\widetilde{d}}-1\right)\widetilde{\epsilon}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S3.SS3.p1.5" class="ltx_p"><span id="S3.SS3.p1.5.1" class="ltx_text">The case of <math id="S3.SS3.p1.m13" class="ltx_Math" alttext="\widetilde{d}=1" display="inline" intent=":literal"><semantics><mrow><mover accent="true"><mi>d</mi><mo>~</mo></mover><mo>=</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">\widetilde{d}=1</annotation></semantics></math> is verified by Lemma <a href="#Thmlemma10" title="Lemma 10 ([], Proposition 3). ‣ 3.1 Proof of Proposition ‣ 3 Proof of Proposition : Construction of Transformers ‣ Standard Transformers Achieve the Minimax Rate in Nonparametric Regression with 𝐶^{𝑠,𝜆} Targets" class="ltx_ref"><span class="ltx_text ltx_ref_tag">10</span></a>. Now we assume <math id="S3.SS3.p1.m14" class="ltx_Math" alttext="f_{FF,2^{\widetilde{d}-1}}^{(mtp)}" display="inline" intent=":literal"><semantics><msubsup><mi>f</mi><mrow><mrow><mi>F</mi><mo lspace="0em" rspace="0em">​</mo><mi>F</mi></mrow><mo>,</mo><msup><mn>2</mn><mrow><mover accent="true"><mi>d</mi><mo>~</mo></mover><mo>−</mo><mn>1</mn></mrow></msup></mrow><mrow><mo stretchy="false">(</mo><mrow><mi>m</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi><mo lspace="0em" rspace="0em">​</mo><mi>p</mi></mrow><mo stretchy="false">)</mo></mrow></msubsup><annotation encoding="application/x-tex">f_{FF,2^{\widetilde{d}-1}}^{(mtp)}</annotation></semantics></math> is of width <math id="S3.SS3.p1.m15" class="ltx_Math" alttext="21\cdot 2^{\widetilde{d}-2}" display="inline" intent=":literal"><semantics><mrow><mn>21</mn><mo lspace="0.222em" rspace="0.222em">⋅</mo><msup><mn>2</mn><mrow><mover accent="true"><mi>d</mi><mo>~</mo></mover><mo>−</mo><mn>2</mn></mrow></msup></mrow><annotation encoding="application/x-tex">21\cdot 2^{\widetilde{d}-2}</annotation></semantics></math>, depth <math id="S3.SS3.p1.m16" class="ltx_Math" alttext="C(\widetilde{d}-1)\ln\frac{1}{\widetilde{\epsilon}}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>C</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mover accent="true"><mi>d</mi><mo>~</mo></mover><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>ln</mi><mo lspace="0.167em">⁡</mo><mfrac><mn>1</mn><mover accent="true"><mi>ϵ</mi><mo>~</mo></mover></mfrac></mrow></mrow><annotation encoding="application/x-tex">C(\widetilde{d}-1)\ln\frac{1}{\widetilde{\epsilon}}</annotation></semantics></math> and weight bound <math id="S3.SS3.p1.m17" class="ltx_Math" alttext="C" display="inline" intent=":literal"><semantics><mi>C</mi><annotation encoding="application/x-tex">C</annotation></semantics></math>, and for any <math id="S3.SS3.p1.m18" class="ltx_Math" alttext="\boldsymbol{y}\in[0,1]^{2^{\widetilde{d}-1}}" display="inline" intent=":literal"><semantics><mrow><mi>𝒚</mi><mo>∈</mo><msup><mrow><mo stretchy="false">[</mo><mrow><mn>0</mn><mo>,</mo><mn>1</mn></mrow><mo stretchy="false">]</mo></mrow><msup><mn>2</mn><mrow><mover accent="true"><mi>d</mi><mo>~</mo></mover><mo>−</mo><mn>1</mn></mrow></msup></msup></mrow><annotation encoding="application/x-tex">\boldsymbol{y}\in[0,1]^{2^{\widetilde{d}-1}}</annotation></semantics></math>,</span></p>
<table id="S3.EGx127" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="S3.Ex186"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S3.Ex186.m1" class="ltx_math_unparsed" alttext="\displaystyle\left|f_{FF,2^{\widetilde{d}-1}}^{(mtp)}(\boldsymbol{{y}})-y_{1}\cdots y_{2^{\widetilde{d}-1}}\right|\leq\frac{1}{2}\left(3^{\widetilde{d}-1}-1\right)\widetilde{\epsilon}." display="inline" intent=":literal"><semantics><mrow><mo fence="false" rspace="0.167em">|</mo><msubsup><mi>f</mi><mrow><mrow><mi>F</mi><mo lspace="0em" rspace="0em">​</mo><mi>F</mi></mrow><mo>,</mo><msup><mn>2</mn><mrow><mover accent="true"><mi>d</mi><mo>~</mo></mover><mo>−</mo><mn>1</mn></mrow></msup></mrow><mrow><mo stretchy="false">(</mo><mrow><mi>m</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi><mo lspace="0em" rspace="0em">​</mo><mi>p</mi></mrow><mo stretchy="false">)</mo></mrow></msubsup><mrow><mo stretchy="false">(</mo><mi>𝒚</mi><mo stretchy="false">)</mo></mrow><mo>−</mo><msub><mi>y</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">⋯</mo><msub><mi>y</mi><msup><mn>2</mn><mrow><mover accent="true"><mi>d</mi><mo>~</mo></mover><mo>−</mo><mn>1</mn></mrow></msup></msub><mo fence="false">|</mo><mo lspace="0.167em">≤</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mn>2</mn></mfrac></mstyle><mrow><mo>(</mo><msup><mn>3</mn><mrow><mover accent="true"><mi>d</mi><mo>~</mo></mover><mo>−</mo><mn>1</mn></mrow></msup><mo>−</mo><mn>1</mn><mo>)</mo></mrow><mover accent="true"><mi>ϵ</mi><mo>~</mo></mover><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\left|f_{FF,2^{\widetilde{d}-1}}^{(mtp)}(\boldsymbol{{y}})-y_{1}\cdots y_{2^{\widetilde{d}-1}}\right|\leq\frac{1}{2}\left(3^{\widetilde{d}-1}-1\right)\widetilde{\epsilon}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S3.SS3.p1.6" class="ltx_p"><span id="S3.SS3.p1.6.1" class="ltx_text">Supposing <math id="S3.SS3.p1.m19" class="ltx_Math" alttext="\widetilde{\epsilon}\leq\frac{2}{3^{\widetilde{d}-1}-1}" display="inline" intent=":literal"><semantics><mrow><mover accent="true"><mi>ϵ</mi><mo>~</mo></mover><mo>≤</mo><mfrac><mn>2</mn><mrow><msup><mn>3</mn><mrow><mover accent="true"><mi>d</mi><mo>~</mo></mover><mo>−</mo><mn>1</mn></mrow></msup><mo>−</mo><mn>1</mn></mrow></mfrac></mrow><annotation encoding="application/x-tex">\widetilde{\epsilon}\leq\frac{2}{3^{\widetilde{d}-1}-1}</annotation></semantics></math>, we have</span></p>
<table id="S3.EGx128" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="S3.Ex187"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S3.Ex187.m1" class="ltx_Math" alttext="\displaystyle\left|f_{FF,2^{\widetilde{d}-1}}^{(mtp)}(\boldsymbol{{y}})\right|" display="inline" intent=":literal"><semantics><mrow><mo>|</mo><mrow><msubsup><mi>f</mi><mrow><mrow><mi>F</mi><mo lspace="0em" rspace="0em">​</mo><mi>F</mi></mrow><mo>,</mo><msup><mn>2</mn><mrow><mover accent="true"><mi>d</mi><mo>~</mo></mover><mo>−</mo><mn>1</mn></mrow></msup></mrow><mrow><mo stretchy="false">(</mo><mrow><mi>m</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi><mo lspace="0em" rspace="0em">​</mo><mi>p</mi></mrow><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝒚</mi><mo stretchy="false">)</mo></mrow></mrow><mo>|</mo></mrow><annotation encoding="application/x-tex">\displaystyle\left|f_{FF,2^{\widetilde{d}-1}}^{(mtp)}(\boldsymbol{{y}})\right|</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S3.Ex187.m2" class="ltx_math_unparsed" alttext="\displaystyle\leq\left|f_{FF,2^{\widetilde{d}-1}}^{(mtp)}(\boldsymbol{{y}})-y_{1}\cdots y_{2^{\widetilde{d}-1}}\right|+\left|y_{1}\cdots y_{2^{\widetilde{d}-1}}\right|" display="inline" intent=":literal"><semantics><mrow><mo rspace="0em">≤</mo><mo fence="false" rspace="0.167em">|</mo><msubsup><mi>f</mi><mrow><mrow><mi>F</mi><mo lspace="0em" rspace="0em">​</mo><mi>F</mi></mrow><mo>,</mo><msup><mn>2</mn><mrow><mover accent="true"><mi>d</mi><mo>~</mo></mover><mo>−</mo><mn>1</mn></mrow></msup></mrow><mrow><mo stretchy="false">(</mo><mrow><mi>m</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi><mo lspace="0em" rspace="0em">​</mo><mi>p</mi></mrow><mo stretchy="false">)</mo></mrow></msubsup><mrow><mo stretchy="false">(</mo><mi>𝒚</mi><mo stretchy="false">)</mo></mrow><mo>−</mo><msub><mi>y</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">⋯</mo><msub><mi>y</mi><msup><mn>2</mn><mrow><mover accent="true"><mi>d</mi><mo>~</mo></mover><mo>−</mo><mn>1</mn></mrow></msup></msub><mo fence="false">|</mo><mo lspace="0em" rspace="0em">+</mo><mo fence="false" rspace="0.167em">|</mo><msub><mi>y</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">⋯</mo><msub><mi>y</mi><msup><mn>2</mn><mrow><mover accent="true"><mi>d</mi><mo>~</mo></mover><mo>−</mo><mn>1</mn></mrow></msup></msub><mo fence="false">|</mo></mrow><annotation encoding="application/x-tex">\displaystyle\leq\left|f_{FF,2^{\widetilde{d}-1}}^{(mtp)}(\boldsymbol{{y}})-y_{1}\cdots y_{2^{\widetilde{d}-1}}\right|+\left|y_{1}\cdots y_{2^{\widetilde{d}-1}}\right|</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="S3.Ex188"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S3.Ex188.m1" class="ltx_Math" alttext="\displaystyle\leq\frac{1}{2}\left(3^{\widetilde{d}-1}-1\right)\widetilde{\epsilon}+1\leq 2." display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>≤</mo><mrow><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mn>2</mn></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><msup><mn>3</mn><mrow><mover accent="true"><mi>d</mi><mo>~</mo></mover><mo>−</mo><mn>1</mn></mrow></msup><mo>−</mo><mn>1</mn></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mover accent="true"><mi>ϵ</mi><mo>~</mo></mover></mrow><mo>+</mo><mn>1</mn></mrow><mo>≤</mo><mn>2</mn></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\leq\frac{1}{2}\left(3^{\widetilde{d}-1}-1\right)\widetilde{\epsilon}+1\leq 2.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S3.SS3.p1.7" class="ltx_p"><span id="S3.SS3.p1.7.1" class="ltx_text">By (<a href="#S3.E12" title="In Proof. ‣ 3.3 Proof of Lemma ‣ 3 Proof of Proposition : Construction of Transformers ‣ Standard Transformers Achieve the Minimax Rate in Nonparametric Regression with 𝐶^{𝑠,𝜆} Targets" class="ltx_ref"><span class="ltx_text ltx_ref_tag">12</span></a>), <math id="S3.SS3.p1.m20" class="ltx_Math" alttext="f_{FF,2^{\widetilde{d}}}^{(mtp)}" display="inline" intent=":literal"><semantics><msubsup><mi>f</mi><mrow><mrow><mi>F</mi><mo lspace="0em" rspace="0em">​</mo><mi>F</mi></mrow><mo>,</mo><msup><mn>2</mn><mover accent="true"><mi>d</mi><mo>~</mo></mover></msup></mrow><mrow><mo stretchy="false">(</mo><mrow><mi>m</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi><mo lspace="0em" rspace="0em">​</mo><mi>p</mi></mrow><mo stretchy="false">)</mo></mrow></msubsup><annotation encoding="application/x-tex">f_{FF,2^{\widetilde{d}}}^{(mtp)}</annotation></semantics></math> is of width <math id="S3.SS3.p1.m21" class="ltx_Math" alttext="21\cdot 2^{\widetilde{d}-1}" display="inline" intent=":literal"><semantics><mrow><mn>21</mn><mo lspace="0.222em" rspace="0.222em">⋅</mo><msup><mn>2</mn><mrow><mover accent="true"><mi>d</mi><mo>~</mo></mover><mo>−</mo><mn>1</mn></mrow></msup></mrow><annotation encoding="application/x-tex">21\cdot 2^{\widetilde{d}-1}</annotation></semantics></math>, depth <math id="S3.SS3.p1.m22" class="ltx_Math" alttext="C\widetilde{d}\ln\frac{1}{\widetilde{\epsilon}}" display="inline" intent=":literal"><semantics><mrow><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><mover accent="true"><mi>d</mi><mo>~</mo></mover><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>ln</mi><mo lspace="0.167em">⁡</mo><mfrac><mn>1</mn><mover accent="true"><mi>ϵ</mi><mo>~</mo></mover></mfrac></mrow></mrow><annotation encoding="application/x-tex">C\widetilde{d}\ln\frac{1}{\widetilde{\epsilon}}</annotation></semantics></math> and weight bound <math id="S3.SS3.p1.m23" class="ltx_Math" alttext="C" display="inline" intent=":literal"><semantics><mi>C</mi><annotation encoding="application/x-tex">C</annotation></semantics></math>. Furthermore, for any <math id="S3.SS3.p1.m24" class="ltx_Math" alttext="\boldsymbol{x}\in[0,1]^{2^{\widetilde{d}}}" display="inline" intent=":literal"><semantics><mrow><mi>𝒙</mi><mo>∈</mo><msup><mrow><mo stretchy="false">[</mo><mrow><mn>0</mn><mo>,</mo><mn>1</mn></mrow><mo stretchy="false">]</mo></mrow><msup><mn>2</mn><mover accent="true"><mi>d</mi><mo>~</mo></mover></msup></msup></mrow><annotation encoding="application/x-tex">\boldsymbol{x}\in[0,1]^{2^{\widetilde{d}}}</annotation></semantics></math>,</span></p>
<table id="S3.EGx129" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="S3.Ex189"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S3.Ex189.m1" class="ltx_math_unparsed" alttext="\displaystyle\left|f_{FF,2^{\widetilde{d}}}^{(mtp)}(\boldsymbol{{x}})-x_{1}\cdots x_{2^{\widetilde{d}}}\right|" display="inline" intent=":literal"><semantics><mrow><mo fence="false" rspace="0.167em">|</mo><msubsup><mi>f</mi><mrow><mrow><mi>F</mi><mo lspace="0em" rspace="0em">​</mo><mi>F</mi></mrow><mo>,</mo><msup><mn>2</mn><mover accent="true"><mi>d</mi><mo>~</mo></mover></msup></mrow><mrow><mo stretchy="false">(</mo><mrow><mi>m</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi><mo lspace="0em" rspace="0em">​</mo><mi>p</mi></mrow><mo stretchy="false">)</mo></mrow></msubsup><mrow><mo stretchy="false">(</mo><mi>𝒙</mi><mo stretchy="false">)</mo></mrow><mo>−</mo><msub><mi>x</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">⋯</mo><msub><mi>x</mi><msup><mn>2</mn><mover accent="true"><mi>d</mi><mo>~</mo></mover></msup></msub><mo fence="false">|</mo></mrow><annotation encoding="application/x-tex">\displaystyle\left|f_{FF,2^{\widetilde{d}}}^{(mtp)}(\boldsymbol{{x}})-x_{1}\cdots x_{2^{\widetilde{d}}}\right|</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="S3.Ex190"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S3.Ex190.m1" class="ltx_Math" alttext="\displaystyle\leq\left|f_{FF,2}^{(mtp)}\left(f_{FF,2^{\widetilde{d}-1}}^{(mtp)}(\boldsymbol{{x}}_{1}),f_{FF,2^{\widetilde{d}-1}}^{(mtp)}(\boldsymbol{{x}}_{2})\right)-f_{FF,2^{\widetilde{d}-1}}^{(mtp)}(\boldsymbol{{x}}_{1})f_{FF,2^{\widetilde{d}-1}}^{(mtp)}(\boldsymbol{{x}}_{2})\right|" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≤</mo><mrow><mo>|</mo><mrow><mrow><msubsup><mi>f</mi><mrow><mrow><mi>F</mi><mo lspace="0em" rspace="0em">​</mo><mi>F</mi></mrow><mo>,</mo><mn>2</mn></mrow><mrow><mo stretchy="false">(</mo><mrow><mi>m</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi><mo lspace="0em" rspace="0em">​</mo><mi>p</mi></mrow><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><msubsup><mi>f</mi><mrow><mrow><mi>F</mi><mo lspace="0em" rspace="0em">​</mo><mi>F</mi></mrow><mo>,</mo><msup><mn>2</mn><mrow><mover accent="true"><mi>d</mi><mo>~</mo></mover><mo>−</mo><mn>1</mn></mrow></msup></mrow><mrow><mo stretchy="false">(</mo><mrow><mi>m</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi><mo lspace="0em" rspace="0em">​</mo><mi>p</mi></mrow><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒙</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mrow><msubsup><mi>f</mi><mrow><mrow><mi>F</mi><mo lspace="0em" rspace="0em">​</mo><mi>F</mi></mrow><mo>,</mo><msup><mn>2</mn><mrow><mover accent="true"><mi>d</mi><mo>~</mo></mover><mo>−</mo><mn>1</mn></mrow></msup></mrow><mrow><mo stretchy="false">(</mo><mrow><mi>m</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi><mo lspace="0em" rspace="0em">​</mo><mi>p</mi></mrow><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒙</mi><mn>2</mn></msub><mo stretchy="false">)</mo></mrow></mrow><mo>)</mo></mrow></mrow><mo>−</mo><mrow><msubsup><mi>f</mi><mrow><mrow><mi>F</mi><mo lspace="0em" rspace="0em">​</mo><mi>F</mi></mrow><mo>,</mo><msup><mn>2</mn><mrow><mover accent="true"><mi>d</mi><mo>~</mo></mover><mo>−</mo><mn>1</mn></mrow></msup></mrow><mrow><mo stretchy="false">(</mo><mrow><mi>m</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi><mo lspace="0em" rspace="0em">​</mo><mi>p</mi></mrow><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒙</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>f</mi><mrow><mrow><mi>F</mi><mo lspace="0em" rspace="0em">​</mo><mi>F</mi></mrow><mo>,</mo><msup><mn>2</mn><mrow><mover accent="true"><mi>d</mi><mo>~</mo></mover><mo>−</mo><mn>1</mn></mrow></msup></mrow><mrow><mo stretchy="false">(</mo><mrow><mi>m</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi><mo lspace="0em" rspace="0em">​</mo><mi>p</mi></mrow><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒙</mi><mn>2</mn></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>|</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\leq\left|f_{FF,2}^{(mtp)}\left(f_{FF,2^{\widetilde{d}-1}}^{(mtp)}(\boldsymbol{{x}}_{1}),f_{FF,2^{\widetilde{d}-1}}^{(mtp)}(\boldsymbol{{x}}_{2})\right)-f_{FF,2^{\widetilde{d}-1}}^{(mtp)}(\boldsymbol{{x}}_{1})f_{FF,2^{\widetilde{d}-1}}^{(mtp)}(\boldsymbol{{x}}_{2})\right|</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="S3.Ex191"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S3.Ex191.m1" class="ltx_math_unparsed" alttext="\displaystyle\quad+\left|f_{FF,2^{\widetilde{d}-1}}^{(mtp)}(\boldsymbol{{x}}_{1})f_{FF,2^{\widetilde{d}-1}}^{(mtp)}(\boldsymbol{{x}}_{2})-x_{1}\cdots x_{2^{\widetilde{d}-1}}\cdot f_{FF,2^{\widetilde{d}-1}}^{(mtp)}(\boldsymbol{{x}}_{2})\right|" display="inline" intent=":literal"><semantics><mrow><mo rspace="0em">+</mo><mo fence="false" rspace="0.167em">|</mo><msubsup><mi>f</mi><mrow><mrow><mi>F</mi><mo lspace="0em" rspace="0em">​</mo><mi>F</mi></mrow><mo>,</mo><msup><mn>2</mn><mrow><mover accent="true"><mi>d</mi><mo>~</mo></mover><mo>−</mo><mn>1</mn></mrow></msup></mrow><mrow><mo stretchy="false">(</mo><mrow><mi>m</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi><mo lspace="0em" rspace="0em">​</mo><mi>p</mi></mrow><mo stretchy="false">)</mo></mrow></msubsup><mrow><mo stretchy="false">(</mo><msub><mi>𝒙</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow><msubsup><mi>f</mi><mrow><mrow><mi>F</mi><mo lspace="0em" rspace="0em">​</mo><mi>F</mi></mrow><mo>,</mo><msup><mn>2</mn><mrow><mover accent="true"><mi>d</mi><mo>~</mo></mover><mo>−</mo><mn>1</mn></mrow></msup></mrow><mrow><mo stretchy="false">(</mo><mrow><mi>m</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi><mo lspace="0em" rspace="0em">​</mo><mi>p</mi></mrow><mo stretchy="false">)</mo></mrow></msubsup><mrow><mo stretchy="false">(</mo><msub><mi>𝒙</mi><mn>2</mn></msub><mo stretchy="false">)</mo></mrow><mo>−</mo><msub><mi>x</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">⋯</mo><msub><mi>x</mi><msup><mn>2</mn><mrow><mover accent="true"><mi>d</mi><mo>~</mo></mover><mo>−</mo><mn>1</mn></mrow></msup></msub><mo lspace="0.222em" rspace="0.222em">⋅</mo><msubsup><mi>f</mi><mrow><mrow><mi>F</mi><mo lspace="0em" rspace="0em">​</mo><mi>F</mi></mrow><mo>,</mo><msup><mn>2</mn><mrow><mover accent="true"><mi>d</mi><mo>~</mo></mover><mo>−</mo><mn>1</mn></mrow></msup></mrow><mrow><mo stretchy="false">(</mo><mrow><mi>m</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi><mo lspace="0em" rspace="0em">​</mo><mi>p</mi></mrow><mo stretchy="false">)</mo></mrow></msubsup><mrow><mo stretchy="false">(</mo><msub><mi>𝒙</mi><mn>2</mn></msub><mo stretchy="false">)</mo></mrow><mo fence="false">|</mo></mrow><annotation encoding="application/x-tex">\displaystyle\quad+\left|f_{FF,2^{\widetilde{d}-1}}^{(mtp)}(\boldsymbol{{x}}_{1})f_{FF,2^{\widetilde{d}-1}}^{(mtp)}(\boldsymbol{{x}}_{2})-x_{1}\cdots x_{2^{\widetilde{d}-1}}\cdot f_{FF,2^{\widetilde{d}-1}}^{(mtp)}(\boldsymbol{{x}}_{2})\right|</annotation></semantics></math></td>
