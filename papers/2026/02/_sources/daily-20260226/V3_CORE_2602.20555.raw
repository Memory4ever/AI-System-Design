<tbody id="S3.Ex140"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S3.Ex140.m1" class="ltx_Math" alttext="\displaystyle\boldsymbol{\mathcal{F}}_{FF}^{(prl-mtp)}(\boldsymbol{Y}):=\begin{pmatrix}\boldsymbol{\mathcal{F}}_{FF,1}^{(mtp-two)}(\boldsymbol{Y})&amp;\cdots&amp;\boldsymbol{\mathcal{F}}_{FF,dC_{s+dn-1}^{dn-1}}^{(mtp-two)}(\boldsymbol{Y})\end{pmatrix}^{\top},\quad\boldsymbol{Y}\in\mathbb{R}^{(d+1)C_{s+dn-1}^{dn-1}\times n}." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mrow><msubsup><mi class="ltx_font_mathcaligraphic">𝓕</mi><mrow><mi>F</mi><mo lspace="0em" rspace="0em">​</mo><mi>F</mi></mrow><mrow><mo stretchy="false">(</mo><mrow><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>l</mi></mrow><mo>−</mo><mrow><mi>m</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi><mo lspace="0em" rspace="0em">​</mo><mi>p</mi></mrow></mrow><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝒀</mi><mo stretchy="false">)</mo></mrow></mrow><mo>:=</mo><msup><mrow><mo>(</mo><mtable columnspacing="5pt"><mtr><mtd><mrow><msubsup><mi class="ltx_font_mathcaligraphic">𝓕</mi><mrow><mrow><mi>F</mi><mo lspace="0em" rspace="0em">​</mo><mi>F</mi></mrow><mo>,</mo><mn>1</mn></mrow><mrow><mo stretchy="false">(</mo><mrow><mrow><mi>m</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi><mo lspace="0em" rspace="0em">​</mo><mi>p</mi></mrow><mo>−</mo><mrow><mi>t</mi><mo lspace="0em" rspace="0em">​</mo><mi>w</mi><mo lspace="0em" rspace="0em">​</mo><mi>o</mi></mrow></mrow><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝒀</mi><mo stretchy="false">)</mo></mrow></mrow></mtd><mtd><mo>⋯</mo></mtd><mtd><mrow><msubsup><mi class="ltx_font_mathcaligraphic">𝓕</mi><mrow><mrow><mi>F</mi><mo lspace="0em" rspace="0em">​</mo><mi>F</mi></mrow><mo>,</mo><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>C</mi><mrow><mrow><mi>s</mi><mo>+</mo><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow></mrow><mo>−</mo><mn>1</mn></mrow><mrow><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow><mo>−</mo><mn>1</mn></mrow></msubsup></mrow></mrow><mrow><mo stretchy="false">(</mo><mrow><mrow><mi>m</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi><mo lspace="0em" rspace="0em">​</mo><mi>p</mi></mrow><mo>−</mo><mrow><mi>t</mi><mo lspace="0em" rspace="0em">​</mo><mi>w</mi><mo lspace="0em" rspace="0em">​</mo><mi>o</mi></mrow></mrow><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝒀</mi><mo stretchy="false">)</mo></mrow></mrow></mtd></mtr></mtable><mo>)</mo></mrow><mo>⊤</mo></msup></mrow><mo rspace="1.167em">,</mo><mrow><mi>𝒀</mi><mo>∈</mo><msup><mi>ℝ</mi><mrow><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>d</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>C</mi><mrow><mrow><mi>s</mi><mo>+</mo><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow></mrow><mo>−</mo><mn>1</mn></mrow><mrow><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow><mo>−</mo><mn>1</mn></mrow></msubsup></mrow><mo lspace="0.222em" rspace="0.222em">×</mo><mi>n</mi></mrow></msup></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\boldsymbol{\mathcal{F}}_{FF}^{(prl-mtp)}(\boldsymbol{Y}):=\begin{pmatrix}\boldsymbol{\mathcal{F}}_{FF,1}^{(mtp-two)}(\boldsymbol{Y})&amp;\cdots&amp;\boldsymbol{\mathcal{F}}_{FF,dC_{s+dn-1}^{dn-1}}^{(mtp-two)}(\boldsymbol{Y})\end{pmatrix}^{\top},\quad\boldsymbol{Y}\in\mathbb{R}^{(d+1)C_{s+dn-1}^{dn-1}\times n}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S3.SS1.p25.3" class="ltx_p"><span id="S3.SS1.p25.3.1" class="ltx_text">Then for <math id="S3.SS1.p25.m25" class="ltx_Math" alttext="\boldsymbol{X}\in\Omega_{j}" display="inline" intent=":literal"><semantics><mrow><mi>𝑿</mi><mo>∈</mo><msub><mi mathvariant="normal">Ω</mi><mi>j</mi></msub></mrow><annotation encoding="application/x-tex">\boldsymbol{X}\in\Omega_{j}</annotation></semantics></math> with some <math id="S3.SS1.p25.m26" class="ltx_Math" alttext="j\in\left[K^{dn}\right]" display="inline" intent=":literal"><semantics><mrow><mi>j</mi><mo>∈</mo><mrow><mo>[</mo><msup><mi>K</mi><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow></msup><mo>]</mo></mrow></mrow><annotation encoding="application/x-tex">j\in\left[K^{dn}\right]</annotation></semantics></math>,</span></p>
