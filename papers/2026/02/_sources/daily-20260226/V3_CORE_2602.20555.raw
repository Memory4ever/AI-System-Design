<tbody id="S7.Ex405"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S7.Ex405.m1" class="ltx_math_unparsed" alttext="\displaystyle\quad+\sum_{h=1}^{H}\left\|\boldsymbol{\widetilde{W}}_{O}^{(h)}\boldsymbol{\widetilde{W}}_{V}^{(h)}-\boldsymbol{{W}}_{O}^{(h)}\boldsymbol{{W}}_{V}^{(h)}\right\|_{F}\left\|\boldsymbol{Y}\right\|_{F}\left\|\sigma_{S}\left(\boldsymbol{Y}^{\top}\boldsymbol{{W}}_{K}^{(h)\top}\boldsymbol{{W}}_{Q}^{(h)}\boldsymbol{Y}\right)\right\|_{F}" display="inline" intent=":literal"><semantics><mrow><mo>+</mo><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>h</mi><mo>=</mo><mn>1</mn></mrow><mi>H</mi></munderover></mstyle><msub><mrow><mo>‖</mo><msubsup><mover accent="true"><mi>𝑾</mi><mo>~</mo></mover><mi>O</mi><mrow><mo stretchy="false">(</mo><mi>h</mi><mo stretchy="false">)</mo></mrow></msubsup><msubsup><mover accent="true"><mi>𝑾</mi><mo>~</mo></mover><mi>V</mi><mrow><mo stretchy="false">(</mo><mi>h</mi><mo stretchy="false">)</mo></mrow></msubsup><mo>−</mo><msubsup><mi>𝑾</mi><mi>O</mi><mrow><mo stretchy="false">(</mo><mi>h</mi><mo stretchy="false">)</mo></mrow></msubsup><msubsup><mi>𝑾</mi><mi>V</mi><mrow><mo stretchy="false">(</mo><mi>h</mi><mo stretchy="false">)</mo></mrow></msubsup><mo>‖</mo></mrow><mi>F</mi></msub><msub><mrow><mo>‖</mo><mi>𝒀</mi><mo>‖</mo></mrow><mi>F</mi></msub><msub><mrow><mo>‖</mo><msub><mi>σ</mi><mi>S</mi></msub><mrow><mo>(</mo><msup><mi>𝒀</mi><mo>⊤</mo></msup><msubsup><mi>𝑾</mi><mi>K</mi><mrow><mrow><mo stretchy="false">(</mo><mi>h</mi><mo stretchy="false">)</mo></mrow><mo lspace="0.222em">⊤</mo></mrow></msubsup><msubsup><mi>𝑾</mi><mi>Q</mi><mrow><mo stretchy="false">(</mo><mi>h</mi><mo stretchy="false">)</mo></mrow></msubsup><mi>𝒀</mi><mo>)</mo></mrow><mo>‖</mo></mrow><mi>F</mi></msub></mrow><annotation encoding="application/x-tex">\displaystyle\quad+\sum_{h=1}^{H}\left\|\boldsymbol{\widetilde{W}}_{O}^{(h)}\boldsymbol{\widetilde{W}}_{V}^{(h)}-\boldsymbol{{W}}_{O}^{(h)}\boldsymbol{{W}}_{V}^{(h)}\right\|_{F}\left\|\boldsymbol{Y}\right\|_{F}\left\|\sigma_{S}\left(\boldsymbol{Y}^{\top}\boldsymbol{{W}}_{K}^{(h)\top}\boldsymbol{{W}}_{Q}^{(h)}\boldsymbol{Y}\right)\right\|_{F}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="S7.Ex406"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S7.Ex406.m1" class="ltx_Math" alttext="\displaystyle\leq 2\sum_{h=1}^{H}\left\|\boldsymbol{\widetilde{W}}_{O}^{(h)}\right\|_{F}\left\|\boldsymbol{\widetilde{W}}_{V}^{(h)}\right\|_{F}\left\|\boldsymbol{Y}\right\|_{F}^{3}\left\|\boldsymbol{\widetilde{W}}_{K}^{(h)\top}\boldsymbol{\widetilde{W}}_{Q}^{(h)}-\boldsymbol{{W}}_{K}^{(h)\top}\boldsymbol{{W}}_{Q}^{(h)}\right\|_{F}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≤</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>h</mi><mo>=</mo><mn>1</mn></mrow><mi>H</mi></munderover></mstyle><mrow><msub><mrow><mo>‖</mo><msubsup><mover accent="true"><mi>𝑾</mi><mo>~</mo></mover><mi>O</mi><mrow><mo stretchy="false">(</mo><mi>h</mi><mo stretchy="false">)</mo></mrow></msubsup><mo>‖</mo></mrow><mi>F</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo>‖</mo><msubsup><mover accent="true"><mi>𝑾</mi><mo>~</mo></mover><mi>V</mi><mrow><mo stretchy="false">(</mo><mi>h</mi><mo stretchy="false">)</mo></mrow></msubsup><mo>‖</mo></mrow><mi>F</mi></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mrow><mo>‖</mo><mi>𝒀</mi><mo>‖</mo></mrow><mi>F</mi><mn>3</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo>‖</mo><mrow><mrow><msubsup><mover accent="true"><mi>𝑾</mi><mo>~</mo></mover><mi>K</mi><mrow><mrow><mo stretchy="false">(</mo><mi>h</mi><mo stretchy="false">)</mo></mrow><mo lspace="0.222em">⊤</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><msubsup><mover accent="true"><mi>𝑾</mi><mo>~</mo></mover><mi>Q</mi><mrow><mo stretchy="false">(</mo><mi>h</mi><mo stretchy="false">)</mo></mrow></msubsup></mrow><mo>−</mo><mrow><msubsup><mi>𝑾</mi><mi>K</mi><mrow><mrow><mo stretchy="false">(</mo><mi>h</mi><mo stretchy="false">)</mo></mrow><mo lspace="0.222em">⊤</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝑾</mi><mi>Q</mi><mrow><mo stretchy="false">(</mo><mi>h</mi><mo stretchy="false">)</mo></mrow></msubsup></mrow></mrow><mo>‖</mo></mrow><mi>F</mi></msub></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\leq 2\sum_{h=1}^{H}\left\|\boldsymbol{\widetilde{W}}_{O}^{(h)}\right\|_{F}\left\|\boldsymbol{\widetilde{W}}_{V}^{(h)}\right\|_{F}\left\|\boldsymbol{Y}\right\|_{F}^{3}\left\|\boldsymbol{\widetilde{W}}_{K}^{(h)\top}\boldsymbol{\widetilde{W}}_{Q}^{(h)}-\boldsymbol{{W}}_{K}^{(h)\top}\boldsymbol{{W}}_{Q}^{(h)}\right\|_{F}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="S7.Ex407"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S7.Ex407.m1" class="ltx_math_unparsed" alttext="\displaystyle\quad+\sqrt{n}\sum_{h=1}^{H}\left\|\boldsymbol{\widetilde{W}}_{O}^{(h)}\boldsymbol{\widetilde{W}}_{V}^{(h)}-\boldsymbol{{W}}_{O}^{(h)}\boldsymbol{{W}}_{V}^{(h)}\right\|_{F}\left\|\boldsymbol{Y}\right\|_{F}" display="inline" intent=":literal"><semantics><mrow><mo>+</mo><msqrt><mi>n</mi></msqrt><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>h</mi><mo>=</mo><mn>1</mn></mrow><mi>H</mi></munderover></mstyle><msub><mrow><mo>‖</mo><msubsup><mover accent="true"><mi>𝑾</mi><mo>~</mo></mover><mi>O</mi><mrow><mo stretchy="false">(</mo><mi>h</mi><mo stretchy="false">)</mo></mrow></msubsup><msubsup><mover accent="true"><mi>𝑾</mi><mo>~</mo></mover><mi>V</mi><mrow><mo stretchy="false">(</mo><mi>h</mi><mo stretchy="false">)</mo></mrow></msubsup><mo>−</mo><msubsup><mi>𝑾</mi><mi>O</mi><mrow><mo stretchy="false">(</mo><mi>h</mi><mo stretchy="false">)</mo></mrow></msubsup><msubsup><mi>𝑾</mi><mi>V</mi><mrow><mo stretchy="false">(</mo><mi>h</mi><mo stretchy="false">)</mo></mrow></msubsup><mo>‖</mo></mrow><mi>F</mi></msub><msub><mrow><mo>‖</mo><mi>𝒀</mi><mo>‖</mo></mrow><mi>F</mi></msub></mrow><annotation encoding="application/x-tex">\displaystyle\quad+\sqrt{n}\sum_{h=1}^{H}\left\|\boldsymbol{\widetilde{W}}_{O}^{(h)}\boldsymbol{\widetilde{W}}_{V}^{(h)}-\boldsymbol{{W}}_{O}^{(h)}\boldsymbol{{W}}_{V}^{(h)}\right\|_{F}\left\|\boldsymbol{Y}\right\|_{F}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="S7.Ex408"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S7.Ex408.m1" class="ltx_Math" alttext="\displaystyle\leq 2\sum_{h=1}^{H}\left\|\boldsymbol{\widetilde{W}}_{O}^{(h)}\right\|_{F}\left\|\boldsymbol{\widetilde{W}}_{V}^{(h)}\right\|_{F}\left\|\boldsymbol{Y}\right\|_{F}^{3}\left(\left\|\boldsymbol{\widetilde{W}}_{K}^{(h)}\right\|_{F}\left\|\boldsymbol{\widetilde{W}}_{Q}^{(h)}-\boldsymbol{{W}}_{Q}^{(h)}\right\|_{F}+\left\|\boldsymbol{\widetilde{W}}_{K}^{(h)}-\boldsymbol{{W}}_{K}^{(h)}\right\|_{F}\left\|\boldsymbol{{W}}_{Q}^{(h)}\right\|_{F}\right)" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≤</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>h</mi><mo>=</mo><mn>1</mn></mrow><mi>H</mi></munderover></mstyle><mrow><msub><mrow><mo>‖</mo><msubsup><mover accent="true"><mi>𝑾</mi><mo>~</mo></mover><mi>O</mi><mrow><mo stretchy="false">(</mo><mi>h</mi><mo stretchy="false">)</mo></mrow></msubsup><mo>‖</mo></mrow><mi>F</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo>‖</mo><msubsup><mover accent="true"><mi>𝑾</mi><mo>~</mo></mover><mi>V</mi><mrow><mo stretchy="false">(</mo><mi>h</mi><mo stretchy="false">)</mo></mrow></msubsup><mo>‖</mo></mrow><mi>F</mi></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mrow><mo>‖</mo><mi>𝒀</mi><mo>‖</mo></mrow><mi>F</mi><mn>3</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mrow><msub><mrow><mo>‖</mo><msubsup><mover accent="true"><mi>𝑾</mi><mo>~</mo></mover><mi>K</mi><mrow><mo stretchy="false">(</mo><mi>h</mi><mo stretchy="false">)</mo></mrow></msubsup><mo>‖</mo></mrow><mi>F</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo>‖</mo><mrow><msubsup><mover accent="true"><mi>𝑾</mi><mo>~</mo></mover><mi>Q</mi><mrow><mo stretchy="false">(</mo><mi>h</mi><mo stretchy="false">)</mo></mrow></msubsup><mo>−</mo><msubsup><mi>𝑾</mi><mi>Q</mi><mrow><mo stretchy="false">(</mo><mi>h</mi><mo stretchy="false">)</mo></mrow></msubsup></mrow><mo>‖</mo></mrow><mi>F</mi></msub></mrow><mo>+</mo><mrow><msub><mrow><mo>‖</mo><mrow><msubsup><mover accent="true"><mi>𝑾</mi><mo>~</mo></mover><mi>K</mi><mrow><mo stretchy="false">(</mo><mi>h</mi><mo stretchy="false">)</mo></mrow></msubsup><mo>−</mo><msubsup><mi>𝑾</mi><mi>K</mi><mrow><mo stretchy="false">(</mo><mi>h</mi><mo stretchy="false">)</mo></mrow></msubsup></mrow><mo>‖</mo></mrow><mi>F</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo>‖</mo><msubsup><mi>𝑾</mi><mi>Q</mi><mrow><mo stretchy="false">(</mo><mi>h</mi><mo stretchy="false">)</mo></mrow></msubsup><mo>‖</mo></mrow><mi>F</mi></msub></mrow></mrow><mo>)</mo></mrow></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\leq 2\sum_{h=1}^{H}\left\|\boldsymbol{\widetilde{W}}_{O}^{(h)}\right\|_{F}\left\|\boldsymbol{\widetilde{W}}_{V}^{(h)}\right\|_{F}\left\|\boldsymbol{Y}\right\|_{F}^{3}\left(\left\|\boldsymbol{\widetilde{W}}_{K}^{(h)}\right\|_{F}\left\|\boldsymbol{\widetilde{W}}_{Q}^{(h)}-\boldsymbol{{W}}_{Q}^{(h)}\right\|_{F}+\left\|\boldsymbol{\widetilde{W}}_{K}^{(h)}-\boldsymbol{{W}}_{K}^{(h)}\right\|_{F}\left\|\boldsymbol{{W}}_{Q}^{(h)}\right\|_{F}\right)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="S7.Ex409"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S7.Ex409.m1" class="ltx_math_unparsed" alttext="\displaystyle\quad+\sqrt{n}\sum_{h=1}^{H}\left(\left\|\boldsymbol{\widetilde{W}}_{O}^{(h)}\right\|_{F}\left\|\boldsymbol{\widetilde{W}}_{V}^{(h)}-\boldsymbol{{W}}_{V}^{(h)}\right\|_{F}+\left\|\boldsymbol{\widetilde{W}}_{O}^{(h)}-\boldsymbol{{W}}_{O}^{(h)}\right\|_{F}\left\|\boldsymbol{{W}}_{V}^{(h)}\right\|_{F}\right)\left\|\boldsymbol{Y}\right\|_{F}" display="inline" intent=":literal"><semantics><mrow><mo>+</mo><msqrt><mi>n</mi></msqrt><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>h</mi><mo>=</mo><mn>1</mn></mrow><mi>H</mi></munderover></mstyle><mrow><mo>(</mo><msub><mrow><mo>‖</mo><msubsup><mover accent="true"><mi>𝑾</mi><mo>~</mo></mover><mi>O</mi><mrow><mo stretchy="false">(</mo><mi>h</mi><mo stretchy="false">)</mo></mrow></msubsup><mo>‖</mo></mrow><mi>F</mi></msub><msub><mrow><mo>‖</mo><msubsup><mover accent="true"><mi>𝑾</mi><mo>~</mo></mover><mi>V</mi><mrow><mo stretchy="false">(</mo><mi>h</mi><mo stretchy="false">)</mo></mrow></msubsup><mo>−</mo><msubsup><mi>𝑾</mi><mi>V</mi><mrow><mo stretchy="false">(</mo><mi>h</mi><mo stretchy="false">)</mo></mrow></msubsup><mo>‖</mo></mrow><mi>F</mi></msub><mo>+</mo><msub><mrow><mo>‖</mo><msubsup><mover accent="true"><mi>𝑾</mi><mo>~</mo></mover><mi>O</mi><mrow><mo stretchy="false">(</mo><mi>h</mi><mo stretchy="false">)</mo></mrow></msubsup><mo>−</mo><msubsup><mi>𝑾</mi><mi>O</mi><mrow><mo stretchy="false">(</mo><mi>h</mi><mo stretchy="false">)</mo></mrow></msubsup><mo>‖</mo></mrow><mi>F</mi></msub><msub><mrow><mo>‖</mo><msubsup><mi>𝑾</mi><mi>V</mi><mrow><mo stretchy="false">(</mo><mi>h</mi><mo stretchy="false">)</mo></mrow></msubsup><mo>‖</mo></mrow><mi>F</mi></msub><mo>)</mo></mrow><msub><mrow><mo>‖</mo><mi>𝒀</mi><mo>‖</mo></mrow><mi>F</mi></msub></mrow><annotation encoding="application/x-tex">\displaystyle\quad+\sqrt{n}\sum_{h=1}^{H}\left(\left\|\boldsymbol{\widetilde{W}}_{O}^{(h)}\right\|_{F}\left\|\boldsymbol{\widetilde{W}}_{V}^{(h)}-\boldsymbol{{W}}_{V}^{(h)}\right\|_{F}+\left\|\boldsymbol{\widetilde{W}}_{O}^{(h)}-\boldsymbol{{W}}_{O}^{(h)}\right\|_{F}\left\|\boldsymbol{{W}}_{V}^{(h)}\right\|_{F}\right)\left\|\boldsymbol{Y}\right\|_{F}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="S7.Ex410"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S7.Ex410.m1" class="ltx_Math" alttext="\displaystyle\leq 3d_{SA}^{2}\sqrt{n}HS^{2}B_{SA}^{3}\left\|\boldsymbol{Y}\right\|_{F}^{3}\varsigma," display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>≤</mo><mrow><mn>3</mn><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>d</mi><mrow><mi>S</mi><mo lspace="0em" rspace="0em">​</mo><mi>A</mi></mrow><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><msqrt><mi>n</mi></msqrt><mo lspace="0em" rspace="0em">​</mo><mi>H</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>S</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>B</mi><mrow><mi>S</mi><mo lspace="0em" rspace="0em">​</mo><mi>A</mi></mrow><mn>3</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><msubsup><mrow><mo>‖</mo><mi>𝒀</mi><mo>‖</mo></mrow><mi>F</mi><mn>3</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>ς</mi></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\leq 3d_{SA}^{2}\sqrt{n}HS^{2}B_{SA}^{3}\left\|\boldsymbol{Y}\right\|_{F}^{3}\varsigma,</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S7.p11.6" class="ltx_p"><span id="S7.p11.6.1" class="ltx_text">where in the fourth step we use Lemma <a href="#Thmlemma24" title="Lemma 24. ‣ 7 Proof of Lemma : Estimation of Lipschitz Constant ‣ Standard Transformers Achieve the Minimax Rate in Nonparametric Regression with 𝐶^{𝑠,𝜆} Targets" class="ltx_ref"><span class="ltx_text ltx_ref_tag">24</span></a> and Lemma <a href="#Thmlemma27" title="Lemma 27. ‣ 7 Proof of Lemma : Estimation of Lipschitz Constant ‣ Standard Transformers Achieve the Minimax Rate in Nonparametric Regression with 𝐶^{𝑠,𝜆} Targets" class="ltx_ref"><span class="ltx_text ltx_ref_tag">27</span></a>. For <math id="S7.p11.m6" class="ltx_Math" alttext="\boldsymbol{\mathcal{F}}_{EB}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">𝓕</mi><mrow><mi>E</mi><mo lspace="0em" rspace="0em">​</mo><mi>B</mi></mrow></msub><annotation encoding="application/x-tex">\boldsymbol{\mathcal{F}}_{EB}</annotation></semantics></math>, by definition we have</span></p>
<table id="S7.EGx241" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="S7.Ex411"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S7.Ex411.m1" class="ltx_Math" alttext="\displaystyle\left\|\boldsymbol{\widetilde{\mathcal{F}}}_{EB}(\boldsymbol{Z})-\boldsymbol{\mathcal{F}}_{EB}(\boldsymbol{Z})\right\|_{F}" display="inline" intent=":literal"><semantics><msub><mrow><mo>‖</mo><mrow><mrow><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">𝓕</mi><mo>~</mo></mover><mrow><mi>E</mi><mo lspace="0em" rspace="0em">​</mo><mi>B</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝒁</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msub><mi class="ltx_font_mathcaligraphic">𝓕</mi><mrow><mi>E</mi><mo lspace="0em" rspace="0em">​</mo><mi>B</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝒁</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>‖</mo></mrow><mi>F</mi></msub><annotation encoding="application/x-tex">\displaystyle\left\|\boldsymbol{\widetilde{\mathcal{F}}}_{EB}(\boldsymbol{Z})-\boldsymbol{\mathcal{F}}_{EB}(\boldsymbol{Z})\right\|_{F}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S7.Ex411.m2" class="ltx_Math" alttext="\displaystyle=\left\|\boldsymbol{\widetilde{W}}_{EB}\boldsymbol{Z}+\boldsymbol{\widetilde{B}}_{EB}-\boldsymbol{W}_{EB}\boldsymbol{Z}-\boldsymbol{B}_{EB}\right\|_{F}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><msub><mrow><mo>‖</mo><mrow><mrow><mrow><msub><mover accent="true"><mi>𝑾</mi><mo>~</mo></mover><mrow><mi>E</mi><mo lspace="0em" rspace="0em">​</mo><mi>B</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mi>𝒁</mi></mrow><mo>+</mo><msub><mover accent="true"><mi>𝑩</mi><mo>~</mo></mover><mrow><mi>E</mi><mo lspace="0em" rspace="0em">​</mo><mi>B</mi></mrow></msub></mrow><mo>−</mo><mrow><msub><mi>𝑾</mi><mrow><mi>E</mi><mo lspace="0em" rspace="0em">​</mo><mi>B</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mi>𝒁</mi></mrow><mo>−</mo><msub><mi>𝑩</mi><mrow><mi>E</mi><mo lspace="0em" rspace="0em">​</mo><mi>B</mi></mrow></msub></mrow><mo>‖</mo></mrow><mi>F</mi></msub></mrow><annotation encoding="application/x-tex">\displaystyle=\left\|\boldsymbol{\widetilde{W}}_{EB}\boldsymbol{Z}+\boldsymbol{\widetilde{B}}_{EB}-\boldsymbol{W}_{EB}\boldsymbol{Z}-\boldsymbol{B}_{EB}\right\|_{F}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="S7.Ex412"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S7.Ex412.m1" class="ltx_Math" alttext="\displaystyle\leq\left\|\boldsymbol{\widetilde{W}}_{EB}-\boldsymbol{W}_{EB}\right\|_{F}\left\|\boldsymbol{Z}\right\|_{F}+\left\|\boldsymbol{\widetilde{B}}_{EB}-\boldsymbol{B}_{EB}\right\|_{F}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≤</mo><mrow><mrow><msub><mrow><mo>‖</mo><mrow><msub><mover accent="true"><mi>𝑾</mi><mo>~</mo></mover><mrow><mi>E</mi><mo lspace="0em" rspace="0em">​</mo><mi>B</mi></mrow></msub><mo>−</mo><msub><mi>𝑾</mi><mrow><mi>E</mi><mo lspace="0em" rspace="0em">​</mo><mi>B</mi></mrow></msub></mrow><mo>‖</mo></mrow><mi>F</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo>‖</mo><mi>𝒁</mi><mo>‖</mo></mrow><mi>F</mi></msub></mrow><mo>+</mo><msub><mrow><mo>‖</mo><mrow><msub><mover accent="true"><mi>𝑩</mi><mo>~</mo></mover><mrow><mi>E</mi><mo lspace="0em" rspace="0em">​</mo><mi>B</mi></mrow></msub><mo>−</mo><msub><mi>𝑩</mi><mrow><mi>E</mi><mo lspace="0em" rspace="0em">​</mo><mi>B</mi></mrow></msub></mrow><mo>‖</mo></mrow><mi>F</mi></msub></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\leq\left\|\boldsymbol{\widetilde{W}}_{EB}-\boldsymbol{W}_{EB}\right\|_{F}\left\|\boldsymbol{Z}\right\|_{F}+\left\|\boldsymbol{\widetilde{B}}_{EB}-\boldsymbol{B}_{EB}\right\|_{F}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="S7.Ex413"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S7.Ex413.m1" class="ltx_Math" alttext="\displaystyle\leq 2\sqrt{d_{EB}d_{in}n}\left\|\boldsymbol{Z}\right\|_{F}\varsigma." display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>≤</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msqrt><mrow><msub><mi>d</mi><mrow><mi>E</mi><mo lspace="0em" rspace="0em">​</mo><mi>B</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>d</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow></msqrt><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo>‖</mo><mi>𝒁</mi><mo>‖</mo></mrow><mi>F</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi>ς</mi></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\leq 2\sqrt{d_{EB}d_{in}n}\left\|\boldsymbol{Z}\right\|_{F}\varsigma.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="S7.p12" class="ltx_para">
<p id="S7.p12.1" class="ltx_p"><span id="S7.p12.1.1" class="ltx_text">∎</span></p>
</div>
</div>
<div id="Thmlemma30" class="ltx_theorem ltx_theorem_lemma">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="Thmlemma30.2" class="ltx_text ltx_font_bold">Lemma 30</span></span><span id="Thmlemma30.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="Thmlemma30.p1" class="ltx_para">
<p id="Thmlemma30.p1.1" class="ltx_p"><span id="Thmlemma30.p1.1.1" class="ltx_text ltx_font_italic">Let <math id="Thmlemma30.p1.m1" class="ltx_Math" alttext="E\in\mathbb{R}_{&gt;0}" display="inline" intent=":literal"><semantics><mrow><mi>E</mi><mo>∈</mo><msub><mi>ℝ</mi><mrow><mphantom></mphantom><mo>&gt;</mo><mn>0</mn></mrow></msub></mrow><annotation encoding="application/x-tex">E\in\mathbb{R}_{&gt;0}</annotation></semantics></math>. Let <math id="Thmlemma30.p1.m2" class="ltx_Math" alttext="\boldsymbol{X},\boldsymbol{\widetilde{X}}\in\mathbb{R}^{d_{FF}^{(in)}\times n},\boldsymbol{Y},\boldsymbol{\widetilde{Y}}\in\mathbb{R}^{d_{SA}\times n}" display="inline" intent=":literal"><semantics><mrow><mi>𝐗</mi><mo>,</mo><mrow><mover accent="true"><mi>𝐗</mi><mo>~</mo></mover><mo>∈</mo><msup><mi>ℝ</mi><mrow><msubsup><mi>d</mi><mrow><mi>F</mi><mo lspace="0em" rspace="0em">​</mo><mi>F</mi></mrow><mrow><mo stretchy="false">(</mo><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0.222em" rspace="0.222em">×</mo><mi>n</mi></mrow></msup></mrow><mo>,</mo><mi>𝐘</mi><mo>,</mo><mrow><mover accent="true"><mi>𝐘</mi><mo>~</mo></mover><mo>∈</mo><msup><mi>ℝ</mi><mrow><msub><mi>d</mi><mrow><mi>S</mi><mo lspace="0em" rspace="0em">​</mo><mi>A</mi></mrow></msub><mo lspace="0.222em" rspace="0.222em">×</mo><mi>n</mi></mrow></msup></mrow></mrow><annotation encoding="application/x-tex">\boldsymbol{X},\boldsymbol{\widetilde{X}}\in\mathbb{R}^{d_{FF}^{(in)}\times n},\boldsymbol{Y},\boldsymbol{\widetilde{Y}}\in\mathbb{R}^{d_{SA}\times n}</annotation></semantics></math>. Suppose <math id="Thmlemma30.p1.m3" class="ltx_Math" alttext="\left\|\boldsymbol{{Y}}\right\|_{F},\left\|\boldsymbol{\widetilde{Y}}\right\|_{F}\leq E" display="inline" intent=":literal"><semantics><mrow><msub><mrow><mo>‖</mo><mi>𝐘</mi><mo>‖</mo></mrow><mi>F</mi></msub><mo>,</mo><mrow><msub><mrow><mo>‖</mo><mover accent="true"><mi>𝐘</mi><mo>~</mo></mover><mo>‖</mo></mrow><mi>F</mi></msub><mo>≤</mo><mi>E</mi></mrow></mrow><annotation encoding="application/x-tex">\left\|\boldsymbol{{Y}}\right\|_{F},\left\|\boldsymbol{\widetilde{Y}}\right\|_{F}\leq E</annotation></semantics></math>. There holds</span></p>
<table id="S7.EGx242" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="S7.Ex414"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S7.Ex414.m1" class="ltx_Math" alttext="\displaystyle\left\|\boldsymbol{\mathcal{F}}_{FF}\left(\boldsymbol{\widetilde{X}}\right)-\boldsymbol{\mathcal{F}}_{FF}(\boldsymbol{X})\right\|_{F}" display="inline" intent=":literal"><semantics><msub><mrow><mo>‖</mo><mrow><mrow><msub><mi class="ltx_font_mathcaligraphic">𝓕</mi><mrow><mi>F</mi><mo lspace="0em" rspace="0em">​</mo><mi>F</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mover accent="true"><mi>𝑿</mi><mo>~</mo></mover><mo>)</mo></mrow></mrow><mo>−</mo><mrow><msub><mi class="ltx_font_mathcaligraphic">𝓕</mi><mrow><mi>F</mi><mo lspace="0em" rspace="0em">​</mo><mi>F</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝑿</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>‖</mo></mrow><mi>F</mi></msub><annotation encoding="application/x-tex">\displaystyle\left\|\boldsymbol{\mathcal{F}}_{FF}\left(\boldsymbol{\widetilde{X}}\right)-\boldsymbol{\mathcal{F}}_{FF}(\boldsymbol{X})\right\|_{F}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S7.Ex414.m2" class="ltx_Math" alttext="\displaystyle\leq\sqrt{d_{FF}^{(in)}d_{FF}^{(out)}}W^{L-1}B_{FF}^{L}\left\|\boldsymbol{\widetilde{X}}-\boldsymbol{X}\right\|_{F}," display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>≤</mo><mrow><msqrt><mrow><msubsup><mi>d</mi><mrow><mi>F</mi><mo lspace="0em" rspace="0em">​</mo><mi>F</mi></mrow><mrow><mo stretchy="false">(</mo><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>d</mi><mrow><mi>F</mi><mo lspace="0em" rspace="0em">​</mo><mi>F</mi></mrow><mrow><mo stretchy="false">(</mo><mrow><mi>o</mi><mo lspace="0em" rspace="0em">​</mo><mi>u</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow><mo stretchy="false">)</mo></mrow></msubsup></mrow></msqrt><mo lspace="0em" rspace="0em">​</mo><msup><mi>W</mi><mrow><mi>L</mi><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>B</mi><mrow><mi>F</mi><mo lspace="0em" rspace="0em">​</mo><mi>F</mi></mrow><mi>L</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo>‖</mo><mrow><mover accent="true"><mi>𝑿</mi><mo>~</mo></mover><mo>−</mo><mi>𝑿</mi></mrow><mo>‖</mo></mrow><mi>F</mi></msub></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\leq\sqrt{d_{FF}^{(in)}d_{FF}^{(out)}}W^{L-1}B_{FF}^{L}\left\|\boldsymbol{\widetilde{X}}-\boldsymbol{X}\right\|_{F},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="S7.Ex415"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S7.Ex415.m1" class="ltx_Math" alttext="\displaystyle\left\|\boldsymbol{\mathcal{F}}_{SA}\left(\boldsymbol{\widetilde{Y}}\right)-\boldsymbol{\mathcal{F}}_{SA}(\boldsymbol{Y})\right\|_{F}" display="inline" intent=":literal"><semantics><msub><mrow><mo>‖</mo><mrow><mrow><msub><mi class="ltx_font_mathcaligraphic">𝓕</mi><mrow><mi>S</mi><mo lspace="0em" rspace="0em">​</mo><mi>A</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mover accent="true"><mi>𝒀</mi><mo>~</mo></mover><mo>)</mo></mrow></mrow><mo>−</mo><mrow><msub><mi class="ltx_font_mathcaligraphic">𝓕</mi><mrow><mi>S</mi><mo lspace="0em" rspace="0em">​</mo><mi>A</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝒀</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>‖</mo></mrow><mi>F</mi></msub><annotation encoding="application/x-tex">\displaystyle\left\|\boldsymbol{\mathcal{F}}_{SA}\left(\boldsymbol{\widetilde{Y}}\right)-\boldsymbol{\mathcal{F}}_{SA}(\boldsymbol{Y})\right\|_{F}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S7.Ex415.m2" class="ltx_Math" alttext="\displaystyle\leq 6d_{SA}^{2}\sqrt{n}E^{2}HS^{2}B_{SA}^{4}\left\|\boldsymbol{\widetilde{Y}}-\boldsymbol{Y}\right\|_{F}." display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>≤</mo><mrow><mn>6</mn><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>d</mi><mrow><mi>S</mi><mo lspace="0em" rspace="0em">​</mo><mi>A</mi></mrow><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><msqrt><mi>n</mi></msqrt><mo lspace="0em" rspace="0em">​</mo><msup><mi>E</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mi>H</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>S</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>B</mi><mrow><mi>S</mi><mo lspace="0em" rspace="0em">​</mo><mi>A</mi></mrow><mn>4</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo>‖</mo><mrow><mover accent="true"><mi>𝒀</mi><mo>~</mo></mover><mo>−</mo><mi>𝒀</mi></mrow><mo>‖</mo></mrow><mi>F</mi></msub></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\leq 6d_{SA}^{2}\sqrt{n}E^{2}HS^{2}B_{SA}^{4}\left\|\boldsymbol{\widetilde{Y}}-\boldsymbol{Y}\right\|_{F}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
</div>
<div id="S7.8" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="S7.p13" class="ltx_para">
<p id="S7.p13.1" class="ltx_p"><span id="S7.p13.1.1" class="ltx_text">For <math id="S7.p13.m1" class="ltx_Math" alttext="\boldsymbol{\mathcal{F}}_{FF}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">𝓕</mi><mrow><mi>F</mi><mo lspace="0em" rspace="0em">​</mo><mi>F</mi></mrow></msub><annotation encoding="application/x-tex">\boldsymbol{\mathcal{F}}_{FF}</annotation></semantics></math>, by definition we have</span></p>
<table id="S7.EGx243" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="S7.Ex416"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S7.Ex416.m1" class="ltx_Math" alttext="\displaystyle\left\|\boldsymbol{\mathcal{F}}_{FF}\left(\boldsymbol{\widetilde{X}}\right)-\boldsymbol{\mathcal{F}}_{FF}(\boldsymbol{X})\right\|_{F}" display="inline" intent=":literal"><semantics><msub><mrow><mo>‖</mo><mrow><mrow><msub><mi class="ltx_font_mathcaligraphic">𝓕</mi><mrow><mi>F</mi><mo lspace="0em" rspace="0em">​</mo><mi>F</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mover accent="true"><mi>𝑿</mi><mo>~</mo></mover><mo>)</mo></mrow></mrow><mo>−</mo><mrow><msub><mi class="ltx_font_mathcaligraphic">𝓕</mi><mrow><mi>F</mi><mo lspace="0em" rspace="0em">​</mo><mi>F</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝑿</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>‖</mo></mrow><mi>F</mi></msub><annotation encoding="application/x-tex">\displaystyle\left\|\boldsymbol{\mathcal{F}}_{FF}\left(\boldsymbol{\widetilde{X}}\right)-\boldsymbol{\mathcal{F}}_{FF}(\boldsymbol{X})\right\|_{F}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="S7.Ex417"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S7.Ex417.m1" class="ltx_Math" alttext="\displaystyle\leq\left\|\boldsymbol{W}_{L}\boldsymbol{\mathcal{F}}_{L-1}\left(\boldsymbol{\widetilde{X}}\right)-\boldsymbol{W}_{L}\boldsymbol{\mathcal{F}}_{L-1}\left(\boldsymbol{{X}}\right)\right\|_{F}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≤</mo><msub><mrow><mo>‖</mo><mrow><mrow><msub><mi>𝑾</mi><mi>L</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi class="ltx_font_mathcaligraphic">𝓕</mi><mrow><mi>L</mi><mo>−</mo><mn>1</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mover accent="true"><mi>𝑿</mi><mo>~</mo></mover><mo>)</mo></mrow></mrow><mo>−</mo><mrow><msub><mi>𝑾</mi><mi>L</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi class="ltx_font_mathcaligraphic">𝓕</mi><mrow><mi>L</mi><mo>−</mo><mn>1</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mi>𝑿</mi><mo>)</mo></mrow></mrow></mrow><mo>‖</mo></mrow><mi>F</mi></msub></mrow><annotation encoding="application/x-tex">\displaystyle\leq\left\|\boldsymbol{W}_{L}\boldsymbol{\mathcal{F}}_{L-1}\left(\boldsymbol{\widetilde{X}}\right)-\boldsymbol{W}_{L}\boldsymbol{\mathcal{F}}_{L-1}\left(\boldsymbol{{X}}\right)\right\|_{F}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="S7.Ex418"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S7.Ex418.m1" class="ltx_Math" alttext="\displaystyle\leq\left\|\boldsymbol{W}_{L}\right\|_{F}\left\|\boldsymbol{\mathcal{F}}_{L-1}\left(\boldsymbol{\widetilde{X}}\right)-\boldsymbol{\mathcal{F}}_{L-1}\left(\boldsymbol{{X}}\right)\right\|_{F}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≤</mo><mrow><msub><mrow><mo>‖</mo><msub><mi>𝑾</mi><mi>L</mi></msub><mo>‖</mo></mrow><mi>F</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo>‖</mo><mrow><mrow><msub><mi class="ltx_font_mathcaligraphic">𝓕</mi><mrow><mi>L</mi><mo>−</mo><mn>1</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mover accent="true"><mi>𝑿</mi><mo>~</mo></mover><mo>)</mo></mrow></mrow><mo>−</mo><mrow><msub><mi class="ltx_font_mathcaligraphic">𝓕</mi><mrow><mi>L</mi><mo>−</mo><mn>1</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mi>𝑿</mi><mo>)</mo></mrow></mrow></mrow><mo>‖</mo></mrow><mi>F</mi></msub></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\leq\left\|\boldsymbol{W}_{L}\right\|_{F}\left\|\boldsymbol{\mathcal{F}}_{L-1}\left(\boldsymbol{\widetilde{X}}\right)-\boldsymbol{\mathcal{F}}_{L-1}\left(\boldsymbol{{X}}\right)\right\|_{F}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="S7.Ex419"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S7.Ex419.m1" class="ltx_Math" alttext="\displaystyle=\left\|\boldsymbol{W}_{L}\right\|_{F}\left\|\sigma_{R}\left(\boldsymbol{W}_{L-1}\boldsymbol{\mathcal{F}}_{L-2}\left(\boldsymbol{\widetilde{X}}\right)+\boldsymbol{B}_{L-1}\right)-\sigma_{R}\left(\boldsymbol{W}_{L-1}\boldsymbol{\mathcal{F}}_{L-2}\left(\boldsymbol{{X}}\right)+\boldsymbol{B}_{L-1}\right)\right\|_{F}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><msub><mrow><mo>‖</mo><msub><mi>𝑾</mi><mi>L</mi></msub><mo>‖</mo></mrow><mi>F</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo>‖</mo><mrow><mrow><msub><mi>σ</mi><mi>R</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mrow><msub><mi>𝑾</mi><mrow><mi>L</mi><mo>−</mo><mn>1</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi class="ltx_font_mathcaligraphic">𝓕</mi><mrow><mi>L</mi><mo>−</mo><mn>2</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mover accent="true"><mi>𝑿</mi><mo>~</mo></mover><mo>)</mo></mrow></mrow><mo>+</mo><msub><mi>𝑩</mi><mrow><mi>L</mi><mo>−</mo><mn>1</mn></mrow></msub></mrow><mo>)</mo></mrow></mrow><mo>−</mo><mrow><msub><mi>σ</mi><mi>R</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mrow><msub><mi>𝑾</mi><mrow><mi>L</mi><mo>−</mo><mn>1</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi class="ltx_font_mathcaligraphic">𝓕</mi><mrow><mi>L</mi><mo>−</mo><mn>2</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mi>𝑿</mi><mo>)</mo></mrow></mrow><mo>+</mo><msub><mi>𝑩</mi><mrow><mi>L</mi><mo>−</mo><mn>1</mn></mrow></msub></mrow><mo>)</mo></mrow></mrow></mrow><mo>‖</mo></mrow><mi>F</mi></msub></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\left\|\boldsymbol{W}_{L}\right\|_{F}\left\|\sigma_{R}\left(\boldsymbol{W}_{L-1}\boldsymbol{\mathcal{F}}_{L-2}\left(\boldsymbol{\widetilde{X}}\right)+\boldsymbol{B}_{L-1}\right)-\sigma_{R}\left(\boldsymbol{W}_{L-1}\boldsymbol{\mathcal{F}}_{L-2}\left(\boldsymbol{{X}}\right)+\boldsymbol{B}_{L-1}\right)\right\|_{F}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="S7.Ex420"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S7.Ex420.m1" class="ltx_Math" alttext="\displaystyle\leq\left\|\boldsymbol{W}_{L}\right\|_{F}\left\|\boldsymbol{W}_{L-1}\right\|_{F}\left\|\boldsymbol{\mathcal{F}}_{L-2}\left(\boldsymbol{\widetilde{X}}\right)-\boldsymbol{\mathcal{F}}_{L-2}\left(\boldsymbol{{X}}\right)\right\|_{F}," display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>≤</mo><mrow><msub><mrow><mo>‖</mo><msub><mi>𝑾</mi><mi>L</mi></msub><mo>‖</mo></mrow><mi>F</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo>‖</mo><msub><mi>𝑾</mi><mrow><mi>L</mi><mo>−</mo><mn>1</mn></mrow></msub><mo>‖</mo></mrow><mi>F</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo>‖</mo><mrow><mrow><msub><mi class="ltx_font_mathcaligraphic">𝓕</mi><mrow><mi>L</mi><mo>−</mo><mn>2</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mover accent="true"><mi>𝑿</mi><mo>~</mo></mover><mo>)</mo></mrow></mrow><mo>−</mo><mrow><msub><mi class="ltx_font_mathcaligraphic">𝓕</mi><mrow><mi>L</mi><mo>−</mo><mn>2</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mi>𝑿</mi><mo>)</mo></mrow></mrow></mrow><mo>‖</mo></mrow><mi>F</mi></msub></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\leq\left\|\boldsymbol{W}_{L}\right\|_{F}\left\|\boldsymbol{W}_{L-1}\right\|_{F}\left\|\boldsymbol{\mathcal{F}}_{L-2}\left(\boldsymbol{\widetilde{X}}\right)-\boldsymbol{\mathcal{F}}_{L-2}\left(\boldsymbol{{X}}\right)\right\|_{F},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S7.p13.2" class="ltx_p"><span id="S7.p13.2.1" class="ltx_text">where in the final step we use the fact that <math id="S7.p13.m2" class="ltx_Math" alttext="\sigma_{R}" display="inline" intent=":literal"><semantics><msub><mi>σ</mi><mi>R</mi></msub><annotation encoding="application/x-tex">\sigma_{R}</annotation></semantics></math> is <math id="S7.p13.m3" class="ltx_Math" alttext="1" display="inline" intent=":literal"><semantics><mn>1</mn><annotation encoding="application/x-tex">1</annotation></semantics></math>-Lipschitz. Repeating this process, we obtain</span></p>
<table id="S7.EGx244" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="S7.Ex421"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S7.Ex421.m1" class="ltx_Math" alttext="\displaystyle\left\|\boldsymbol{\mathcal{F}}_{FF}\left(\boldsymbol{\widetilde{X}}\right)-\boldsymbol{\mathcal{F}}_{FF}(\boldsymbol{X})\right\|_{F}" display="inline" intent=":literal"><semantics><msub><mrow><mo>‖</mo><mrow><mrow><msub><mi class="ltx_font_mathcaligraphic">𝓕</mi><mrow><mi>F</mi><mo lspace="0em" rspace="0em">​</mo><mi>F</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mover accent="true"><mi>𝑿</mi><mo>~</mo></mover><mo>)</mo></mrow></mrow><mo>−</mo><mrow><msub><mi class="ltx_font_mathcaligraphic">𝓕</mi><mrow><mi>F</mi><mo lspace="0em" rspace="0em">​</mo><mi>F</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝑿</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>‖</mo></mrow><mi>F</mi></msub><annotation encoding="application/x-tex">\displaystyle\left\|\boldsymbol{\mathcal{F}}_{FF}\left(\boldsymbol{\widetilde{X}}\right)-\boldsymbol{\mathcal{F}}_{FF}(\boldsymbol{X})\right\|_{F}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S7.Ex421.m2" class="ltx_Math" alttext="\displaystyle\leq\left(\prod_{l=1}^{L}\left\|\boldsymbol{W}_{l}\right\|_{F}\right)\left\|\boldsymbol{\widetilde{X}}-\boldsymbol{X}\right\|_{F}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≤</mo><mrow><mrow><mo>(</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∏</mo><mrow><mi>l</mi><mo>=</mo><mn>1</mn></mrow><mi>L</mi></munderover></mstyle><msub><mrow><mo>‖</mo><msub><mi>𝑾</mi><mi>l</mi></msub><mo>‖</mo></mrow><mi>F</mi></msub></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo>‖</mo><mrow><mover accent="true"><mi>𝑿</mi><mo>~</mo></mover><mo>−</mo><mi>𝑿</mi></mrow><mo>‖</mo></mrow><mi>F</mi></msub></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\leq\left(\prod_{l=1}^{L}\left\|\boldsymbol{W}_{l}\right\|_{F}\right)\left\|\boldsymbol{\widetilde{X}}-\boldsymbol{X}\right\|_{F}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="S7.Ex422"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S7.Ex422.m1" class="ltx_Math" alttext="\displaystyle\leq\sqrt{d_{FF}^{(in)}d_{FF}^{(out)}}W^{L-1}B_{FF}^{L}\left\|\boldsymbol{\widetilde{X}}-\boldsymbol{X}\right\|_{F}." display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>≤</mo><mrow><msqrt><mrow><msubsup><mi>d</mi><mrow><mi>F</mi><mo lspace="0em" rspace="0em">​</mo><mi>F</mi></mrow><mrow><mo stretchy="false">(</mo><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>d</mi><mrow><mi>F</mi><mo lspace="0em" rspace="0em">​</mo><mi>F</mi></mrow><mrow><mo stretchy="false">(</mo><mrow><mi>o</mi><mo lspace="0em" rspace="0em">​</mo><mi>u</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow><mo stretchy="false">)</mo></mrow></msubsup></mrow></msqrt><mo lspace="0em" rspace="0em">​</mo><msup><mi>W</mi><mrow><mi>L</mi><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>B</mi><mrow><mi>F</mi><mo lspace="0em" rspace="0em">​</mo><mi>F</mi></mrow><mi>L</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo>‖</mo><mrow><mover accent="true"><mi>𝑿</mi><mo>~</mo></mover><mo>−</mo><mi>𝑿</mi></mrow><mo>‖</mo></mrow><mi>F</mi></msub></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\leq\sqrt{d_{FF}^{(in)}d_{FF}^{(out)}}W^{L-1}B_{FF}^{L}\left\|\boldsymbol{\widetilde{X}}-\boldsymbol{X}\right\|_{F}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S7.p13.3" class="ltx_p"><span id="S7.p13.3.1" class="ltx_text">For <math id="S7.p13.m4" class="ltx_Math" alttext="\boldsymbol{\mathcal{F}}_{SA}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">𝓕</mi><mrow><mi>S</mi><mo lspace="0em" rspace="0em">​</mo><mi>A</mi></mrow></msub><annotation encoding="application/x-tex">\boldsymbol{\mathcal{F}}_{SA}</annotation></semantics></math>, by definition we have</span></p>
<table id="S7.EGx245" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="S7.Ex423"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S7.Ex423.m1" class="ltx_Math" alttext="\displaystyle\left\|\boldsymbol{\mathcal{F}}_{SA}\left(\boldsymbol{\widetilde{Y}}\right)-\boldsymbol{\mathcal{F}}_{SA}(\boldsymbol{Y})\right\|_{F}\leq" display="inline" intent=":literal"><semantics><mrow><msub><mrow><mo>‖</mo><mrow><mrow><msub><mi class="ltx_font_mathcaligraphic">𝓕</mi><mrow><mi>S</mi><mo lspace="0em" rspace="0em">​</mo><mi>A</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mover accent="true"><mi>𝒀</mi><mo>~</mo></mover><mo>)</mo></mrow></mrow><mo>−</mo><mrow><msub><mi class="ltx_font_mathcaligraphic">𝓕</mi><mrow><mi>S</mi><mo lspace="0em" rspace="0em">​</mo><mi>A</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝒀</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>‖</mo></mrow><mi>F</mi></msub><mo>≤</mo><mphantom></mphantom></mrow><annotation encoding="application/x-tex">\displaystyle\left\|\boldsymbol{\mathcal{F}}_{SA}\left(\boldsymbol{\widetilde{Y}}\right)-\boldsymbol{\mathcal{F}}_{SA}(\boldsymbol{Y})\right\|_{F}\leq</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="S7.Ex424"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S7.Ex424.m1" class="ltx_Math" alttext="\displaystyle\left\|\boldsymbol{\widetilde{Y}}-\boldsymbol{Y}\right\|_{F}+\sum_{h=1}^{H}\left\|\boldsymbol{W}_{O}^{(h)}\boldsymbol{W}_{V}^{(h)}\boldsymbol{\widetilde{Y}}\sigma_{S}\left(\boldsymbol{\widetilde{Y}}^{\top}\boldsymbol{W}_{K}^{(h)\top}\boldsymbol{W}_{Q}^{(h)}\boldsymbol{\widetilde{Y}}\right)-\boldsymbol{W}_{O}^{(h)}\boldsymbol{W}_{V}^{(h)}\boldsymbol{Y}\sigma_{S}\left(\boldsymbol{Y}^{\top}\boldsymbol{W}_{K}^{(h)\top}\boldsymbol{W}_{Q}^{(h)}\boldsymbol{Y}\right)\right\|_{F}." display="inline" intent=":literal"><semantics><mrow><mrow><msub><mrow><mo>‖</mo><mrow><mover accent="true"><mi>𝒀</mi><mo>~</mo></mover><mo>−</mo><mi>𝒀</mi></mrow><mo>‖</mo></mrow><mi>F</mi></msub><mo>+</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>h</mi><mo>=</mo><mn>1</mn></mrow><mi>H</mi></munderover></mstyle><msub><mrow><mo>‖</mo><mrow><mrow><msubsup><mi>𝑾</mi><mi>O</mi><mrow><mo stretchy="false">(</mo><mi>h</mi><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝑾</mi><mi>V</mi><mrow><mo stretchy="false">(</mo><mi>h</mi><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mover accent="true"><mi>𝒀</mi><mo>~</mo></mover><mo lspace="0em" rspace="0em">​</mo><msub><mi>σ</mi><mi>S</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><msup><mover accent="true"><mi>𝒀</mi><mo>~</mo></mover><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝑾</mi><mi>K</mi><mrow><mrow><mo stretchy="false">(</mo><mi>h</mi><mo stretchy="false">)</mo></mrow><mo lspace="0.222em">⊤</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝑾</mi><mi>Q</mi><mrow><mo stretchy="false">(</mo><mi>h</mi><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mover accent="true"><mi>𝒀</mi><mo>~</mo></mover></mrow><mo>)</mo></mrow></mrow><mo>−</mo><mrow><msubsup><mi>𝑾</mi><mi>O</mi><mrow><mo stretchy="false">(</mo><mi>h</mi><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝑾</mi><mi>V</mi><mrow><mo stretchy="false">(</mo><mi>h</mi><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>𝒀</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>σ</mi><mi>S</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><msup><mi>𝒀</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝑾</mi><mi>K</mi><mrow><mrow><mo stretchy="false">(</mo><mi>h</mi><mo stretchy="false">)</mo></mrow><mo lspace="0.222em">⊤</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝑾</mi><mi>Q</mi><mrow><mo stretchy="false">(</mo><mi>h</mi><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>𝒀</mi></mrow><mo>)</mo></mrow></mrow></mrow><mo>‖</mo></mrow><mi>F</mi></msub></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\left\|\boldsymbol{\widetilde{Y}}-\boldsymbol{Y}\right\|_{F}+\sum_{h=1}^{H}\left\|\boldsymbol{W}_{O}^{(h)}\boldsymbol{W}_{V}^{(h)}\boldsymbol{\widetilde{Y}}\sigma_{S}\left(\boldsymbol{\widetilde{Y}}^{\top}\boldsymbol{W}_{K}^{(h)\top}\boldsymbol{W}_{Q}^{(h)}\boldsymbol{\widetilde{Y}}\right)-\boldsymbol{W}_{O}^{(h)}\boldsymbol{W}_{V}^{(h)}\boldsymbol{Y}\sigma_{S}\left(\boldsymbol{Y}^{\top}\boldsymbol{W}_{K}^{(h)\top}\boldsymbol{W}_{Q}^{(h)}\boldsymbol{Y}\right)\right\|_{F}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S7.p13.4" class="ltx_p"><span id="S7.p13.4.1" class="ltx_text">The term to be summed can be bounded by</span></p>
<table id="S7.EGx246" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="S7.Ex425"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S7.Ex425.m1" class="ltx_Math" alttext="\displaystyle\left\|\boldsymbol{W}_{O}^{(h)}\boldsymbol{W}_{V}^{(h)}\boldsymbol{\widetilde{Y}}\sigma_{S}\left(\boldsymbol{\widetilde{Y}}^{\top}\boldsymbol{W}_{K}^{(h)\top}\boldsymbol{W}_{Q}^{(h)}\boldsymbol{\widetilde{Y}}\right)-\boldsymbol{W}_{O}^{(h)}\boldsymbol{W}_{V}^{(h)}\boldsymbol{Y}\sigma_{S}\left(\boldsymbol{Y}^{\top}\boldsymbol{W}_{K}^{(h)\top}\boldsymbol{W}_{Q}^{(h)}\boldsymbol{Y}\right)\right\|_{F}" display="inline" intent=":literal"><semantics><msub><mrow><mo>‖</mo><mrow><mrow><msubsup><mi>𝑾</mi><mi>O</mi><mrow><mo stretchy="false">(</mo><mi>h</mi><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝑾</mi><mi>V</mi><mrow><mo stretchy="false">(</mo><mi>h</mi><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mover accent="true"><mi>𝒀</mi><mo>~</mo></mover><mo lspace="0em" rspace="0em">​</mo><msub><mi>σ</mi><mi>S</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><msup><mover accent="true"><mi>𝒀</mi><mo>~</mo></mover><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝑾</mi><mi>K</mi><mrow><mrow><mo stretchy="false">(</mo><mi>h</mi><mo stretchy="false">)</mo></mrow><mo lspace="0.222em">⊤</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝑾</mi><mi>Q</mi><mrow><mo stretchy="false">(</mo><mi>h</mi><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mover accent="true"><mi>𝒀</mi><mo>~</mo></mover></mrow><mo>)</mo></mrow></mrow><mo>−</mo><mrow><msubsup><mi>𝑾</mi><mi>O</mi><mrow><mo stretchy="false">(</mo><mi>h</mi><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝑾</mi><mi>V</mi><mrow><mo stretchy="false">(</mo><mi>h</mi><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>𝒀</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>σ</mi><mi>S</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><msup><mi>𝒀</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝑾</mi><mi>K</mi><mrow><mrow><mo stretchy="false">(</mo><mi>h</mi><mo stretchy="false">)</mo></mrow><mo lspace="0.222em">⊤</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝑾</mi><mi>Q</mi><mrow><mo stretchy="false">(</mo><mi>h</mi><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>𝒀</mi></mrow><mo>)</mo></mrow></mrow></mrow><mo>‖</mo></mrow><mi>F</mi></msub><annotation encoding="application/x-tex">\displaystyle\left\|\boldsymbol{W}_{O}^{(h)}\boldsymbol{W}_{V}^{(h)}\boldsymbol{\widetilde{Y}}\sigma_{S}\left(\boldsymbol{\widetilde{Y}}^{\top}\boldsymbol{W}_{K}^{(h)\top}\boldsymbol{W}_{Q}^{(h)}\boldsymbol{\widetilde{Y}}\right)-\boldsymbol{W}_{O}^{(h)}\boldsymbol{W}_{V}^{(h)}\boldsymbol{Y}\sigma_{S}\left(\boldsymbol{Y}^{\top}\boldsymbol{W}_{K}^{(h)\top}\boldsymbol{W}_{Q}^{(h)}\boldsymbol{Y}\right)\right\|_{F}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="S7.Ex426"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S7.Ex426.m1" class="ltx_Math" alttext="\displaystyle\leq\left\|\boldsymbol{W}_{O}^{(h)}\boldsymbol{W}_{V}^{(h)}\boldsymbol{\widetilde{Y}}\sigma_{S}\left(\boldsymbol{\widetilde{Y}}^{\top}\boldsymbol{W}_{K}^{(h)\top}\boldsymbol{W}_{Q}^{(h)}\boldsymbol{\widetilde{Y}}\right)-\boldsymbol{W}_{O}^{(h)}\boldsymbol{W}_{V}^{(h)}\boldsymbol{\widetilde{Y}}\sigma_{S}\left(\boldsymbol{Y}^{\top}\boldsymbol{W}_{K}^{(h)\top}\boldsymbol{W}_{Q}^{(h)}\boldsymbol{Y}\right)\right\|_{F}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≤</mo><msub><mrow><mo>‖</mo><mrow><mrow><msubsup><mi>𝑾</mi><mi>O</mi><mrow><mo stretchy="false">(</mo><mi>h</mi><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝑾</mi><mi>V</mi><mrow><mo stretchy="false">(</mo><mi>h</mi><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mover accent="true"><mi>𝒀</mi><mo>~</mo></mover><mo lspace="0em" rspace="0em">​</mo><msub><mi>σ</mi><mi>S</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><msup><mover accent="true"><mi>𝒀</mi><mo>~</mo></mover><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝑾</mi><mi>K</mi><mrow><mrow><mo stretchy="false">(</mo><mi>h</mi><mo stretchy="false">)</mo></mrow><mo lspace="0.222em">⊤</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝑾</mi><mi>Q</mi><mrow><mo stretchy="false">(</mo><mi>h</mi><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mover accent="true"><mi>𝒀</mi><mo>~</mo></mover></mrow><mo>)</mo></mrow></mrow><mo>−</mo><mrow><msubsup><mi>𝑾</mi><mi>O</mi><mrow><mo stretchy="false">(</mo><mi>h</mi><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝑾</mi><mi>V</mi><mrow><mo stretchy="false">(</mo><mi>h</mi><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mover accent="true"><mi>𝒀</mi><mo>~</mo></mover><mo lspace="0em" rspace="0em">​</mo><msub><mi>σ</mi><mi>S</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><msup><mi>𝒀</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝑾</mi><mi>K</mi><mrow><mrow><mo stretchy="false">(</mo><mi>h</mi><mo stretchy="false">)</mo></mrow><mo lspace="0.222em">⊤</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝑾</mi><mi>Q</mi><mrow><mo stretchy="false">(</mo><mi>h</mi><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>𝒀</mi></mrow><mo>)</mo></mrow></mrow></mrow><mo>‖</mo></mrow><mi>F</mi></msub></mrow><annotation encoding="application/x-tex">\displaystyle\leq\left\|\boldsymbol{W}_{O}^{(h)}\boldsymbol{W}_{V}^{(h)}\boldsymbol{\widetilde{Y}}\sigma_{S}\left(\boldsymbol{\widetilde{Y}}^{\top}\boldsymbol{W}_{K}^{(h)\top}\boldsymbol{W}_{Q}^{(h)}\boldsymbol{\widetilde{Y}}\right)-\boldsymbol{W}_{O}^{(h)}\boldsymbol{W}_{V}^{(h)}\boldsymbol{\widetilde{Y}}\sigma_{S}\left(\boldsymbol{Y}^{\top}\boldsymbol{W}_{K}^{(h)\top}\boldsymbol{W}_{Q}^{(h)}\boldsymbol{Y}\right)\right\|_{F}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="S7.Ex427"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
