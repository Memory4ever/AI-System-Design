<tbody id="S7.Ex476"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S7.Ex476.m1" class="ltx_Math" alttext="\displaystyle\leq 6^{K}4^{K^{2}+K+3/2}n^{K^{2}+5K/2+2}d_{in}^{K+1/2}d_{0}^{2K+1}\left(\prod_{k^{\prime}=1}^{K}d_{k^{\prime}}^{4(K-k^{\prime})+5}\right)d_{out}^{1/2}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≤</mo><mrow><msup><mn>6</mn><mi>K</mi></msup><mo lspace="0em" rspace="0em">​</mo><msup><mn>4</mn><mrow><msup><mi>K</mi><mn>2</mn></msup><mo>+</mo><mi>K</mi><mo>+</mo><mrow><mn>3</mn><mo>/</mo><mn>2</mn></mrow></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>n</mi><mrow><msup><mi>K</mi><mn>2</mn></msup><mo>+</mo><mrow><mrow><mn>5</mn><mo lspace="0em" rspace="0em">​</mo><mi>K</mi></mrow><mo>/</mo><mn>2</mn></mrow><mo>+</mo><mn>2</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>d</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow><mrow><mi>K</mi><mo>+</mo><mrow><mn>1</mn><mo>/</mo><mn>2</mn></mrow></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>d</mi><mn>0</mn><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>K</mi></mrow><mo>+</mo><mn>1</mn></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∏</mo><mrow><msup><mi>k</mi><mo>′</mo></msup><mo>=</mo><mn>1</mn></mrow><mi>K</mi></munderover></mstyle><msubsup><mi>d</mi><msup><mi>k</mi><mo>′</mo></msup><mrow><mrow><mn>4</mn><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>K</mi><mo>−</mo><msup><mi>k</mi><mo>′</mo></msup></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mn>5</mn></mrow></msubsup></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>d</mi><mrow><mi>o</mi><mo lspace="0em" rspace="0em">​</mo><mi>u</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow><mrow><mn>1</mn><mo>/</mo><mn>2</mn></mrow></msubsup></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\leq 6^{K}4^{K^{2}+K+3/2}n^{K^{2}+5K/2+2}d_{in}^{K+1/2}d_{0}^{2K+1}\left(\prod_{k^{\prime}=1}^{K}d_{k^{\prime}}^{4(K-k^{\prime})+5}\right)d_{out}^{1/2}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="S7.E39"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S7.E39.m1" class="ltx_Math" alttext="\displaystyle\quad H^{K^{2}}S^{K^{2}+K}L^{K^{2}+K+2}W^{(L-1)K(K+2)+2L-3/2}B_{EB}^{2K+1}B_{FF}^{LK(K+2)+2L-1}B_{SA}^{2K(K+1)}\varsigma." display="inline" intent=":literal"><semantics><mrow><mrow><msup><mi>H</mi><msup><mi>K</mi><mn>2</mn></msup></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>S</mi><mrow><msup><mi>K</mi><mn>2</mn></msup><mo>+</mo><mi>K</mi></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>L</mi><mrow><msup><mi>K</mi><mn>2</mn></msup><mo>+</mo><mi>K</mi><mo>+</mo><mn>2</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>W</mi><mrow><mrow><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>L</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>K</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>K</mi><mo>+</mo><mn>2</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>L</mi></mrow></mrow><mo>−</mo><mrow><mn>3</mn><mo>/</mo><mn>2</mn></mrow></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>B</mi><mrow><mi>E</mi><mo lspace="0em" rspace="0em">​</mo><mi>B</mi></mrow><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>K</mi></mrow><mo>+</mo><mn>1</mn></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>B</mi><mrow><mi>F</mi><mo lspace="0em" rspace="0em">​</mo><mi>F</mi></mrow><mrow><mrow><mrow><mi>L</mi><mo lspace="0em" rspace="0em">​</mo><mi>K</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>K</mi><mo>+</mo><mn>2</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>L</mi></mrow></mrow><mo>−</mo><mn>1</mn></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>B</mi><mrow><mi>S</mi><mo lspace="0em" rspace="0em">​</mo><mi>A</mi></mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>K</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>K</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>ς</mi></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\quad H^{K^{2}}S^{K^{2}+K}L^{K^{2}+K+2}W^{(L-1)K(K+2)+2L-3/2}B_{EB}^{2K+1}B_{FF}^{LK(K+2)+2L-1}B_{SA}^{2K(K+1)}\varsigma.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(39)</span></td></tr></tbody>
</table>
<p id="S7.p16.1" class="ltx_p"><span id="S7.p16.1.1" class="ltx_text">In a similar manner, we can derive an upper bound for the term that difference appears in the <math id="S7.p16.m1" class="ltx_Math" alttext="k" display="inline" intent=":literal"><semantics><mi>k</mi><annotation encoding="application/x-tex">k</annotation></semantics></math>-th self-attention layer (<math id="S7.p16.m2" class="ltx_Math" alttext="k\in\{1,2,\cdots,K\}" display="inline" intent=":literal"><semantics><mrow><mi>k</mi><mo>∈</mo><mrow><mo stretchy="false">{</mo><mrow><mn>1</mn><mo>,</mo><mn>2</mn><mo>,</mo><mo lspace="0em" rspace="0em">⋯</mo><mo>,</mo><mi>K</mi></mrow><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">k\in\{1,2,\cdots,K\}</annotation></semantics></math>):</span></p>
</div>
<div id="S7.p17" class="ltx_para">
<table id="S7.EGx258" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="S7.Ex477"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
