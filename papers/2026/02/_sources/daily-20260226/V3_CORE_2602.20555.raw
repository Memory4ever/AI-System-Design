</div>
</div>
<div id="S4.SS2.5" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof of Lemma <a href="#Thmlemma14" title="Lemma 14. ‣ 4.1 Proof of Lemma ‣ 4 Proof of Lemma : Memorization of Transformers ‣ Standard Transformers Achieve the Minimax Rate in Nonparametric Regression with 𝐶^{𝑠,𝜆} Targets" class="ltx_ref"><span class="ltx_text ltx_ref_tag">14</span></a>.</h6>
<div id="S4.SS2.p14" class="ltx_para">
<p id="S4.SS2.p14.1" class="ltx_p"><span id="S4.SS2.p14.1.1" class="ltx_text">Denote <math id="S4.SS2.p14.m1" class="ltx_Math" alttext="r^{\prime}:=\frac{\sqrt{2}}{2}n^{2}N^{2}\sqrt{\pi d}r\phi^{-1}" display="inline" intent=":literal"><semantics><mrow><msup><mi>r</mi><mo>′</mo></msup><mo>:=</mo><mrow><mfrac><msqrt><mn>2</mn></msqrt><mn>2</mn></mfrac><mo lspace="0em" rspace="0em">​</mo><msup><mi>n</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>N</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msqrt><mrow><mi>π</mi><mo lspace="0em" rspace="0em">​</mo><mi>d</mi></mrow></msqrt><mo lspace="0em" rspace="0em">​</mo><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>ϕ</mi><mrow><mo>−</mo><mn>1</mn></mrow></msup></mrow></mrow><annotation encoding="application/x-tex">r^{\prime}:=\frac{\sqrt{2}}{2}n^{2}N^{2}\sqrt{\pi d}r\phi^{-1}</annotation></semantics></math>. The Transformer <math id="S4.SS2.p14.m2" class="ltx_Math" alttext="\boldsymbol{T}^{(cm)}" display="inline" intent=":literal"><semantics><msup><mi>𝑻</mi><mrow><mo stretchy="false">(</mo><mrow><mi>c</mi><mo lspace="0em" rspace="0em">​</mo><mi>m</mi></mrow><mo stretchy="false">)</mo></mrow></msup><annotation encoding="application/x-tex">\boldsymbol{T}^{(cm)}</annotation></semantics></math> is defined as</span></p>
<table id="S4.EGx181" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="S4.Ex276"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S4.Ex276.m1" class="ltx_Math" alttext="\displaystyle\boldsymbol{T}^{(cm)}(\boldsymbol{X}):" display="inline" intent=":literal"><semantics><mrow><mrow><msup><mi>𝑻</mi><mrow><mo stretchy="false">(</mo><mrow><mi>c</mi><mo lspace="0em" rspace="0em">​</mo><mi>m</mi></mrow><mo stretchy="false">)</mo></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝑿</mi><mo rspace="0.278em" stretchy="false">)</mo></mrow></mrow><mo rspace="0.278em">:</mo><mphantom></mphantom></mrow><annotation encoding="application/x-tex">\displaystyle\boldsymbol{T}^{(cm)}(\boldsymbol{X}):</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S4.Ex276.m2" class="ltx_Math" alttext="\displaystyle=\begin{pmatrix}2r^{\prime}+1&amp;1\end{pmatrix}\begin{pmatrix}\boldsymbol{{T}}^{(sid)}\circ\boldsymbol{\mathcal{F}}_{FF}^{(pjt)}(\boldsymbol{X})\\
\begin{pmatrix}1&amp;0&amp;0&amp;0\end{pmatrix}\boldsymbol{\mathcal{F}}_{FF}^{(pjt)}(\boldsymbol{X})\end{pmatrix}," display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><mo>(</mo><mtable columnspacing="5pt"><mtr><mtd><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msup><mi>r</mi><mo>′</mo></msup></mrow><mo>+</mo><mn>1</mn></mrow></mtd><mtd><mn>1</mn></mtd></mtr></mtable><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mtable rowspacing="0pt"><mtr><mtd><mrow><mrow><msup><mi>𝑻</mi><mrow><mo stretchy="false">(</mo><mrow><mi>s</mi><mo lspace="0em" rspace="0em">​</mo><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>d</mi></mrow><mo stretchy="false">)</mo></mrow></msup><mo lspace="0.222em" rspace="0.222em">∘</mo><msubsup><mi class="ltx_font_mathcaligraphic">𝓕</mi><mrow><mi>F</mi><mo lspace="0em" rspace="0em">​</mo><mi>F</mi></mrow><mrow><mo stretchy="false">(</mo><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>j</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow><mo stretchy="false">)</mo></mrow></msubsup></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝑿</mi><mo stretchy="false">)</mo></mrow></mrow></mtd></mtr><mtr><mtd><mrow><mrow><mo>(</mo><mtable columnspacing="5pt"><mtr><mtd><mn>1</mn></mtd><mtd><mn>0</mn></mtd><mtd><mn>0</mn></mtd><mtd><mn>0</mn></mtd></mtr></mtable><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msubsup><mi class="ltx_font_mathcaligraphic">𝓕</mi><mrow><mi>F</mi><mo lspace="0em" rspace="0em">​</mo><mi>F</mi></mrow><mrow><mo stretchy="false">(</mo><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>j</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝑿</mi><mo stretchy="false">)</mo></mrow></mrow></mtd></mtr></mtable><mo>)</mo></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle=\begin{pmatrix}2r^{\prime}+1&amp;1\end{pmatrix}\begin{pmatrix}\boldsymbol{{T}}^{(sid)}\circ\boldsymbol{\mathcal{F}}_{FF}^{(pjt)}(\boldsymbol{X})\\
\begin{pmatrix}1&amp;0&amp;0&amp;0\end{pmatrix}\boldsymbol{\mathcal{F}}_{FF}^{(pjt)}(\boldsymbol{X})\end{pmatrix},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S4.SS2.p14.2" class="ltx_p"><span id="S4.SS2.p14.2.1" class="ltx_text">where <math id="S4.SS2.p14.m3" class="ltx_Math" alttext="\boldsymbol{\mathcal{F}}_{FF}^{(pjt)}:\mathbb{R}^{d\times n}\to\mathbb{R}^{4\times n}" display="inline" intent=":literal"><semantics><mrow><msubsup><mi class="ltx_font_mathcaligraphic">𝓕</mi><mrow><mi>F</mi><mo lspace="0em" rspace="0em">​</mo><mi>F</mi></mrow><mrow><mo stretchy="false">(</mo><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>j</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><msup><mi>ℝ</mi><mrow><mi>d</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>n</mi></mrow></msup><mo stretchy="false">→</mo><msup><mi>ℝ</mi><mrow><mn>4</mn><mo lspace="0.222em" rspace="0.222em">×</mo><mi>n</mi></mrow></msup></mrow></mrow><annotation encoding="application/x-tex">\boldsymbol{\mathcal{F}}_{FF}^{(pjt)}:\mathbb{R}^{d\times n}\to\mathbb{R}^{4\times n}</annotation></semantics></math> is from Lemma <a href="#Thmlemma19" title="Lemma 19. ‣ 4.2 Proof of Lemma : Realizing Contextual Mapping by Transformers ‣ 4 Proof of Lemma : Memorization of Transformers ‣ Standard Transformers Achieve the Minimax Rate in Nonparametric Regression with 𝐶^{𝑠,𝜆} Targets" class="ltx_ref"><span class="ltx_text ltx_ref_tag">19</span></a> with depth <math id="S4.SS2.p14.m4" class="ltx_Math" alttext="2" display="inline" intent=":literal"><semantics><mn>2</mn><annotation encoding="application/x-tex">2</annotation></semantics></math>, width <math id="S4.SS2.p14.m5" class="ltx_Math" alttext="\max\{d,4\}" display="inline" intent=":literal"><semantics><mrow><mi>max</mi><mo>⁡</mo><mrow><mo stretchy="false">{</mo><mrow><mi>d</mi><mo>,</mo><mn>4</mn></mrow><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">\max\{d,4\}</annotation></semantics></math> and weight bound <math id="S4.SS2.p14.m6" class="ltx_Math" alttext="\frac{\sqrt{2}}{2}n^{2}N^{2}\sqrt{\pi d}r\phi^{-1}" display="inline" intent=":literal"><semantics><mrow><mfrac><msqrt><mn>2</mn></msqrt><mn>2</mn></mfrac><mo lspace="0em" rspace="0em">​</mo><msup><mi>n</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>N</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msqrt><mrow><mi>π</mi><mo lspace="0em" rspace="0em">​</mo><mi>d</mi></mrow></msqrt><mo lspace="0em" rspace="0em">​</mo><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>ϕ</mi><mrow><mo>−</mo><mn>1</mn></mrow></msup></mrow><annotation encoding="application/x-tex">\frac{\sqrt{2}}{2}n^{2}N^{2}\sqrt{\pi d}r\phi^{-1}</annotation></semantics></math>, <math id="S4.SS2.p14.m7" class="ltx_Math" alttext="\boldsymbol{{T}}^{(sid)}:\mathbb{R}^{4\times n}\to\mathbb{R}^{1\times n}" display="inline" intent=":literal"><semantics><mrow><msup><mi>𝑻</mi><mrow><mo stretchy="false">(</mo><mrow><mi>s</mi><mo lspace="0em" rspace="0em">​</mo><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>d</mi></mrow><mo stretchy="false">)</mo></mrow></msup><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><msup><mi>ℝ</mi><mrow><mn>4</mn><mo lspace="0.222em" rspace="0.222em">×</mo><mi>n</mi></mrow></msup><mo stretchy="false">→</mo><msup><mi>ℝ</mi><mrow><mn>1</mn><mo lspace="0.222em" rspace="0.222em">×</mo><mi>n</mi></mrow></msup></mrow></mrow><annotation encoding="application/x-tex">\boldsymbol{{T}}^{(sid)}:\mathbb{R}^{4\times n}\to\mathbb{R}^{1\times n}</annotation></semantics></math> is from Lemma <a href="#Thmlemma20" title="Lemma 20. ‣ 4.2 Proof of Lemma : Realizing Contextual Mapping by Transformers ‣ 4 Proof of Lemma : Memorization of Transformers ‣ Standard Transformers Achieve the Minimax Rate in Nonparametric Regression with 𝐶^{𝑠,𝜆} Targets" class="ltx_ref"><span class="ltx_text ltx_ref_tag">20</span></a> with size <math id="S4.SS2.p14.m8" class="ltx_Math" alttext="\{(2,4),((2,3),(3,10))\times(n-1)\text{ times},(2,3),(2,4)\}" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">{</mo><mrow><mrow><mo stretchy="false">(</mo><mn>2</mn><mo>,</mo><mn>4</mn><mo stretchy="false">)</mo></mrow><mo>,</mo><mrow><mrow><mrow><mo stretchy="false">(</mo><mrow><mo stretchy="false">(</mo><mn>2</mn><mo>,</mo><mn>3</mn><mo stretchy="false">)</mo></mrow><mo>,</mo><mrow><mo stretchy="false">(</mo><mn>3</mn><mo>,</mo><mn>10</mn><mo stretchy="false">)</mo></mrow><mo rspace="0.055em" stretchy="false">)</mo></mrow><mo rspace="0.222em">×</mo><mrow><mo stretchy="false">(</mo><mrow><mi>n</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><mtext> times</mtext></mrow><mo>,</mo><mrow><mo stretchy="false">(</mo><mn>2</mn><mo>,</mo><mn>3</mn><mo stretchy="false">)</mo></mrow><mo>,</mo><mrow><mo stretchy="false">(</mo><mn>2</mn><mo>,</mo><mn>4</mn><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">}</mo></mrow><annotation encoding="application/x-tex">\{(2,4),((2,3),(3,10))\times(n-1)\text{ times},(2,3),(2,4)\}</annotation></semantics></math>, dimension vector <math id="S4.SS2.p14.m9" class="ltx_Math" alttext="\begin{pmatrix}4\cdot\boldsymbol{1}_{1\times(n+2)}&amp;1\end{pmatrix}" display="inline" intent=":literal"><semantics><mrow><mo>(</mo><mtable columnspacing="5pt"><mtr><mtd><mrow><mn>4</mn><mo lspace="0.222em" rspace="0.222em">⋅</mo><msub><mn>𝟏</mn><mrow><mn>1</mn><mo lspace="0.222em" rspace="0.222em">×</mo><mrow><mo stretchy="false">(</mo><mrow><mi>n</mi><mo>+</mo><mn>2</mn></mrow><mo stretchy="false">)</mo></mrow></mrow></msub></mrow></mtd><mtd><mn>1</mn></mtd></mtr></mtable><mo>)</mo></mrow><annotation encoding="application/x-tex">\begin{pmatrix}4\cdot\boldsymbol{1}_{1\times(n+2)}&amp;1\end{pmatrix}</annotation></semantics></math> and weight bounds <math id="S4.SS2.p14.m10" class="ltx_Math" alttext="B_{FF}=\max\left\{2r^{\prime},\frac{3\sqrt{2}}{8}N^{2}\sqrt{\pi n}\right\},B_{SA}=\frac{1}{2}\log(3\sqrt{2\pi}n^{2}N^{2}r^{\prime})" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>B</mi><mrow><mi>F</mi><mo lspace="0em" rspace="0em">​</mo><mi>F</mi></mrow></msub><mo>=</mo><mrow><mi>max</mi><mo>⁡</mo><mrow><mo>{</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msup><mi>r</mi><mo>′</mo></msup></mrow><mo>,</mo><mrow><mfrac><mrow><mn>3</mn><mo lspace="0em" rspace="0em">​</mo><msqrt><mn>2</mn></msqrt></mrow><mn>8</mn></mfrac><mo lspace="0em" rspace="0em">​</mo><msup><mi>N</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msqrt><mrow><mi>π</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow></msqrt></mrow><mo>}</mo></mrow></mrow></mrow><mo>,</mo><mrow><msub><mi>B</mi><mrow><mi>S</mi><mo lspace="0em" rspace="0em">​</mo><mi>A</mi></mrow></msub><mo>=</mo><mrow><mfrac><mn>1</mn><mn>2</mn></mfrac><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>log</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mn>3</mn><mo lspace="0em" rspace="0em">​</mo><msqrt><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>π</mi></mrow></msqrt><mo lspace="0em" rspace="0em">​</mo><msup><mi>n</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>N</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>r</mi><mo>′</mo></msup></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">B_{FF}=\max\left\{2r^{\prime},\frac{3\sqrt{2}}{8}N^{2}\sqrt{\pi n}\right\},B_{SA}=\frac{1}{2}\log(3\sqrt{2\pi}n^{2}N^{2}r^{\prime})</annotation></semantics></math>. According to Lemma <a href="#Thmlemma3" title="Lemma 3. ‣ 2.2 Proof of Theorem ‣ 2 Proofs of Main Results ‣ Standard Transformers Achieve the Minimax Rate in Nonparametric Regression with 𝐶^{𝑠,𝜆} Targets" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3</span></a>, <math id="S4.SS2.p14.m11" class="ltx_Math" alttext="\boldsymbol{T}^{(cm)}" display="inline" intent=":literal"><semantics><msup><mi>𝑻</mi><mrow><mo stretchy="false">(</mo><mrow><mi>c</mi><mo lspace="0em" rspace="0em">​</mo><mi>m</mi></mrow><mo stretchy="false">)</mo></mrow></msup><annotation encoding="application/x-tex">\boldsymbol{T}^{(cm)}</annotation></semantics></math> has size <math id="S4.SS2.p14.m12" class="ltx_Math" alttext="\{(2,\max\{d,5\}),((3,3),(3,11))\times(n-1)\text{ times},(3,3),(2,5)\}" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">{</mo><mrow><mrow><mo stretchy="false">(</mo><mn>2</mn><mo>,</mo><mrow><mi>max</mi><mo>⁡</mo><mrow><mo stretchy="false">{</mo><mi>d</mi><mo>,</mo><mn>5</mn><mo stretchy="false">}</mo></mrow></mrow><mo stretchy="false">)</mo></mrow><mo>,</mo><mrow><mrow><mrow><mo stretchy="false">(</mo><mrow><mo stretchy="false">(</mo><mn>3</mn><mo>,</mo><mn>3</mn><mo stretchy="false">)</mo></mrow><mo>,</mo><mrow><mo stretchy="false">(</mo><mn>3</mn><mo>,</mo><mn>11</mn><mo stretchy="false">)</mo></mrow><mo rspace="0.055em" stretchy="false">)</mo></mrow><mo rspace="0.222em">×</mo><mrow><mo stretchy="false">(</mo><mrow><mi>n</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><mtext> times</mtext></mrow><mo>,</mo><mrow><mo stretchy="false">(</mo><mn>3</mn><mo>,</mo><mn>3</mn><mo stretchy="false">)</mo></mrow><mo>,</mo><mrow><mo stretchy="false">(</mo><mn>2</mn><mo>,</mo><mn>5</mn><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">}</mo></mrow><annotation encoding="application/x-tex">\{(2,\max\{d,5\}),((3,3),(3,11))\times(n-1)\text{ times},(3,3),(2,5)\}</annotation></semantics></math>, dimension vector <math id="S4.SS2.p14.m13" class="ltx_Math" alttext="\begin{pmatrix}d&amp;d&amp;5\cdot\boldsymbol{1}_{1\times n}&amp;1\end{pmatrix}" display="inline" intent=":literal"><semantics><mrow><mo>(</mo><mtable columnspacing="5pt"><mtr><mtd><mi>d</mi></mtd><mtd><mi>d</mi></mtd><mtd><mrow><mn>5</mn><mo lspace="0.222em" rspace="0.222em">⋅</mo><msub><mn>𝟏</mn><mrow><mn>1</mn><mo lspace="0.222em" rspace="0.222em">×</mo><mi>n</mi></mrow></msub></mrow></mtd><mtd><mn>1</mn></mtd></mtr></mtable><mo>)</mo></mrow><annotation encoding="application/x-tex">\begin{pmatrix}d&amp;d&amp;5\cdot\boldsymbol{1}_{1\times n}&amp;1\end{pmatrix}</annotation></semantics></math> and weight bounds</span></p>
<table id="S4.Ex277" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S4.Ex277.m1" class="ltx_Math" alttext="B_{FF}=\max\left\{\sqrt{2}n^{2}N^{2}\sqrt{\pi d}r\phi^{-1}+1,\frac{3\sqrt{2}}{8}N^{2}\sqrt{\pi n}\right\},B_{SA}=\frac{1}{2}\log(3\sqrt{d}{\pi}n^{4}N^{4}r\phi^{-1})." display="block" intent=":literal"><semantics><mrow><mrow><mrow><msub><mi>B</mi><mrow><mi>F</mi><mo lspace="0em" rspace="0em">​</mo><mi>F</mi></mrow></msub><mo>=</mo><mrow><mi>max</mi><mo>⁡</mo><mrow><mo>{</mo><mrow><mrow><mrow><msqrt><mn>2</mn></msqrt><mo lspace="0em" rspace="0em">​</mo><msup><mi>n</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>N</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msqrt><mrow><mi>π</mi><mo lspace="0em" rspace="0em">​</mo><mi>d</mi></mrow></msqrt><mo lspace="0em" rspace="0em">​</mo><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>ϕ</mi><mrow><mo>−</mo><mn>1</mn></mrow></msup></mrow><mo>+</mo><mn>1</mn></mrow><mo>,</mo><mrow><mfrac><mrow><mn>3</mn><mo lspace="0em" rspace="0em">​</mo><msqrt><mn>2</mn></msqrt></mrow><mn>8</mn></mfrac><mo lspace="0em" rspace="0em">​</mo><msup><mi>N</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msqrt><mrow><mi>π</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow></msqrt></mrow></mrow><mo>}</mo></mrow></mrow></mrow><mo>,</mo><mrow><msub><mi>B</mi><mrow><mi>S</mi><mo lspace="0em" rspace="0em">​</mo><mi>A</mi></mrow></msub><mo>=</mo><mrow><mfrac><mn>1</mn><mn>2</mn></mfrac><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>log</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mn>3</mn><mo lspace="0em" rspace="0em">​</mo><msqrt><mi>d</mi></msqrt><mo lspace="0em" rspace="0em">​</mo><mi>π</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>n</mi><mn>4</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>N</mi><mn>4</mn></msup><mo lspace="0em" rspace="0em">​</mo><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>ϕ</mi><mrow><mo>−</mo><mn>1</mn></mrow></msup></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">B_{FF}=\max\left\{\sqrt{2}n^{2}N^{2}\sqrt{\pi d}r\phi^{-1}+1,\frac{3\sqrt{2}}{8}N^{2}\sqrt{\pi n}\right\},B_{SA}=\frac{1}{2}\log(3\sqrt{d}{\pi}n^{4}N^{4}r\phi^{-1}).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S4.SS2.p14.3" class="ltx_p"><span id="S4.SS2.p14.3.1" class="ltx_text">Applying Lemma <a href="#Thmlemma19" title="Lemma 19. ‣ 4.2 Proof of Lemma : Realizing Contextual Mapping by Transformers ‣ 4 Proof of Lemma : Memorization of Transformers ‣ Standard Transformers Achieve the Minimax Rate in Nonparametric Regression with 𝐶^{𝑠,𝜆} Targets" class="ltx_ref"><span class="ltx_text ltx_ref_tag">19</span></a> and Lemma <a href="#Thmlemma20" title="Lemma 20. ‣ 4.2 Proof of Lemma : Realizing Contextual Mapping by Transformers ‣ 4 Proof of Lemma : Memorization of Transformers ‣ Standard Transformers Achieve the Minimax Rate in Nonparametric Regression with 𝐶^{𝑠,𝜆} Targets" class="ltx_ref"><span class="ltx_text ltx_ref_tag">20</span></a>, we have</span></p>
<table id="S4.EGx182" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="S4.Ex278"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S4.Ex278.m1" class="ltx_Math" alttext="\displaystyle\boldsymbol{a}^{(i)}:=\boldsymbol{T}^{(cm)}\left(\boldsymbol{X}^{(i)}\right)" display="inline" intent=":literal"><semantics><mrow><msup><mi>𝒂</mi><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></msup><mo>:=</mo><mrow><msup><mi>𝑻</mi><mrow><mo stretchy="false">(</mo><mrow><mi>c</mi><mo lspace="0em" rspace="0em">​</mo><mi>m</mi></mrow><mo stretchy="false">)</mo></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><msup><mi>𝑿</mi><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></msup><mo>)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\boldsymbol{a}^{(i)}:=\boldsymbol{T}^{(cm)}\left(\boldsymbol{X}^{(i)}\right)</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S4.Ex278.m2" class="ltx_Math" alttext="\displaystyle=\begin{pmatrix}2r^{\prime}+1&amp;1\end{pmatrix}\begin{pmatrix}\boldsymbol{{T}}^{(sid)}\circ\boldsymbol{\mathcal{F}}_{FF}^{(pjt)}\left(\boldsymbol{X}^{(i)}\right)\\
\begin{pmatrix}1&amp;0&amp;0&amp;0\end{pmatrix}\boldsymbol{\mathcal{F}}_{FF}^{(pjt)}\left(\boldsymbol{X}^{(i)}\right)\end{pmatrix}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><mo>(</mo><mtable columnspacing="5pt"><mtr><mtd><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msup><mi>r</mi><mo>′</mo></msup></mrow><mo>+</mo><mn>1</mn></mrow></mtd><mtd><mn>1</mn></mtd></mtr></mtable><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mtable rowspacing="0pt"><mtr><mtd><mrow><mrow><msup><mi>𝑻</mi><mrow><mo stretchy="false">(</mo><mrow><mi>s</mi><mo lspace="0em" rspace="0em">​</mo><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>d</mi></mrow><mo stretchy="false">)</mo></mrow></msup><mo lspace="0.222em" rspace="0.222em">∘</mo><msubsup><mi class="ltx_font_mathcaligraphic">𝓕</mi><mrow><mi>F</mi><mo lspace="0em" rspace="0em">​</mo><mi>F</mi></mrow><mrow><mo stretchy="false">(</mo><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>j</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow><mo stretchy="false">)</mo></mrow></msubsup></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><msup><mi>𝑿</mi><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></msup><mo>)</mo></mrow></mrow></mtd></mtr><mtr><mtd><mrow><mrow><mo>(</mo><mtable columnspacing="5pt"><mtr><mtd><mn>1</mn></mtd><mtd><mn>0</mn></mtd><mtd><mn>0</mn></mtd><mtd><mn>0</mn></mtd></mtr></mtable><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msubsup><mi class="ltx_font_mathcaligraphic">𝓕</mi><mrow><mi>F</mi><mo lspace="0em" rspace="0em">​</mo><mi>F</mi></mrow><mrow><mo stretchy="false">(</mo><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>j</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><msup><mi>𝑿</mi><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></msup><mo>)</mo></mrow></mrow></mtd></mtr></mtable><mo>)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\begin{pmatrix}2r^{\prime}+1&amp;1\end{pmatrix}\begin{pmatrix}\boldsymbol{{T}}^{(sid)}\circ\boldsymbol{\mathcal{F}}_{FF}^{(pjt)}\left(\boldsymbol{X}^{(i)}\right)\\
\begin{pmatrix}1&amp;0&amp;0&amp;0\end{pmatrix}\boldsymbol{\mathcal{F}}_{FF}^{(pjt)}\left(\boldsymbol{X}^{(i)}\right)\end{pmatrix}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="S4.Ex279"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S4.Ex279.m1" class="ltx_Math" alttext="\displaystyle=\begin{pmatrix}2r^{\prime}+1&amp;1\end{pmatrix}\begin{pmatrix}z^{(i)}\boldsymbol{1}_{1\times n}\\
\boldsymbol{x}^{(i)}\end{pmatrix}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><mo>(</mo><mtable columnspacing="5pt"><mtr><mtd><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msup><mi>r</mi><mo>′</mo></msup></mrow><mo>+</mo><mn>1</mn></mrow></mtd><mtd><mn>1</mn></mtd></mtr></mtable><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mtable rowspacing="0pt"><mtr><mtd><mrow><msup><mi>z</mi><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msub><mn>𝟏</mn><mrow><mn>1</mn><mo lspace="0.222em" rspace="0.222em">×</mo><mi>n</mi></mrow></msub></mrow></mtd></mtr><mtr><mtd><msup><mi>𝒙</mi><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></msup></mtd></mtr></mtable><mo>)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\begin{pmatrix}2r^{\prime}+1&amp;1\end{pmatrix}\begin{pmatrix}z^{(i)}\boldsymbol{1}_{1\times n}\\
\boldsymbol{x}^{(i)}\end{pmatrix}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="S4.Ex280"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S4.Ex280.m1" class="ltx_Math" alttext="\displaystyle=(2r^{\prime}+1)z^{(i)}\boldsymbol{1}_{1\times n}+\boldsymbol{x}^{(i)}." display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><mrow><mo stretchy="false">(</mo><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msup><mi>r</mi><mo>′</mo></msup></mrow><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mi>z</mi><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msub><mn>𝟏</mn><mrow><mn>1</mn><mo lspace="0.222em" rspace="0.222em">×</mo><mi>n</mi></mrow></msub></mrow><mo>+</mo><msup><mi>𝒙</mi><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></msup></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle=(2r^{\prime}+1)z^{(i)}\boldsymbol{1}_{1\times n}+\boldsymbol{x}^{(i)}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S4.SS2.p14.4" class="ltx_p"><span id="S4.SS2.p14.4.1" class="ltx_text">It follows that for any <math id="S4.SS2.p14.m14" class="ltx_Math" alttext="i\in[N],k\in[n]" display="inline" intent=":literal"><semantics><mrow><mrow><mi>i</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mi>N</mi><mo stretchy="false">]</mo></mrow></mrow><mo>,</mo><mrow><mi>k</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mi>n</mi><mo stretchy="false">]</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">i\in[N],k\in[n]</annotation></semantics></math>,</span></p>
<table id="S4.EGx183" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="S4.Ex281"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S4.Ex281.m1" class="ltx_Math" alttext="\displaystyle\left|a_{k}^{(i)}\right|" display="inline" intent=":literal"><semantics><mrow><mo>|</mo><msubsup><mi>a</mi><mi>k</mi><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></msubsup><mo>|</mo></mrow><annotation encoding="application/x-tex">\displaystyle\left|a_{k}^{(i)}\right|</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S4.Ex281.m2" class="ltx_Math" alttext="\displaystyle\leq(2r^{\prime}+1)\left|z^{(i)}\right|+x_{1,k}^{(i)}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≤</mo><mrow><mrow><mrow><mo stretchy="false">(</mo><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msup><mi>r</mi><mo>′</mo></msup></mrow><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo>|</mo><msup><mi>z</mi><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></msup><mo>|</mo></mrow></mrow><mo>+</mo><msubsup><mi>x</mi><mrow><mn>1</mn><mo>,</mo><mi>k</mi></mrow><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></msubsup></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\leq(2r^{\prime}+1)\left|z^{(i)}\right|+x_{1,k}^{(i)}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="S4.Ex282"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S4.Ex282.m1" class="ltx_Math" alttext="\displaystyle\leq(2r^{\prime}+1)\left(\frac{3\sqrt{2\pi}}{4}nN^{2}r^{\prime}+\frac{1}{2}\right)+2r^{\prime}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≤</mo><mrow><mrow><mrow><mo stretchy="false">(</mo><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msup><mi>r</mi><mo>′</mo></msup></mrow><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mrow><mstyle displaystyle="true"><mfrac><mrow><mn>3</mn><mo lspace="0em" rspace="0em">​</mo><msqrt><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>π</mi></mrow></msqrt></mrow><mn>4</mn></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>N</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>r</mi><mo>′</mo></msup></mrow><mo>+</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mn>2</mn></mfrac></mstyle></mrow><mo>)</mo></mrow></mrow><mo>+</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msup><mi>r</mi><mo>′</mo></msup></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\leq(2r^{\prime}+1)\left(\frac{3\sqrt{2\pi}}{4}nN^{2}r^{\prime}+\frac{1}{2}\right)+2r^{\prime}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="S4.Ex283"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S4.Ex283.m1" class="ltx_Math" alttext="\displaystyle\leq(2r^{\prime}+1)\left(\frac{3\sqrt{2\pi}}{4}nN^{2}r^{\prime}+\frac{3}{2}\right)." display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>≤</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msup><mi>r</mi><mo>′</mo></msup></mrow><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mrow><mstyle displaystyle="true"><mfrac><mrow><mn>3</mn><mo lspace="0em" rspace="0em">​</mo><msqrt><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>π</mi></mrow></msqrt></mrow><mn>4</mn></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>N</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>r</mi><mo>′</mo></msup></mrow><mo>+</mo><mstyle displaystyle="true"><mfrac><mn>3</mn><mn>2</mn></mfrac></mstyle></mrow><mo>)</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\leq(2r^{\prime}+1)\left(\frac{3\sqrt{2\pi}}{4}nN^{2}r^{\prime}+\frac{3}{2}\right).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S4.SS2.p14.5" class="ltx_p"><span id="S4.SS2.p14.5.1" class="ltx_text">It remains to show the separatedness of <math id="S4.SS2.p14.m15" class="ltx_Math" alttext="\left\{\boldsymbol{a}^{(i)}\right\}_{i\in[N]}" display="inline" intent=":literal"><semantics><msub><mrow><mo>{</mo><msup><mi>𝒂</mi><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></msup><mo>}</mo></mrow><mrow><mi>i</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mi>N</mi><mo stretchy="false">]</mo></mrow></mrow></msub><annotation encoding="application/x-tex">\left\{\boldsymbol{a}^{(i)}\right\}_{i\in[N]}</annotation></semantics></math> when <math id="S4.SS2.p14.m16" class="ltx_math_unparsed" alttext="\boldsymbol{X}_{:,k}^{(i)}\neq\boldsymbol{X}_{:,l}^{(j)}" display="inline" intent=":literal"><semantics><mrow><mi>𝑿</mi><msub><mrow></mrow><mrow><mo rspace="0em">:</mo><mo>,</mo><mi>k</mi></mrow></msub><msup><mrow></mrow><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></msup><mo>≠</mo><mi>𝑿</mi><msub><mrow></mrow><mrow><mo rspace="0em">:</mo><mo>,</mo><mi>l</mi></mrow></msub><msup><mrow></mrow><mrow><mo stretchy="false">(</mo><mi>j</mi><mo stretchy="false">)</mo></mrow></msup></mrow><annotation encoding="application/x-tex">\boldsymbol{X}_{:,k}^{(i)}\neq\boldsymbol{X}_{:,l}^{(j)}</annotation></semantics></math> or <math id="S4.SS2.p14.m17" class="ltx_Math" alttext="\boldsymbol{X}^{(i)}\neq\boldsymbol{X}^{(j)}" display="inline" intent=":literal"><semantics><mrow><msup><mi>𝑿</mi><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></msup><mo>≠</mo><msup><mi>𝑿</mi><mrow><mo stretchy="false">(</mo><mi>j</mi><mo stretchy="false">)</mo></mrow></msup></mrow><annotation encoding="application/x-tex">\boldsymbol{X}^{(i)}\neq\boldsymbol{X}^{(j)}</annotation></semantics></math> up to permutations. According to Lemma <a href="#Thmlemma19" title="Lemma 19. ‣ 4.2 Proof of Lemma : Realizing Contextual Mapping by Transformers ‣ 4 Proof of Lemma : Memorization of Transformers ‣ Standard Transformers Achieve the Minimax Rate in Nonparametric Regression with 𝐶^{𝑠,𝜆} Targets" class="ltx_ref"><span class="ltx_text ltx_ref_tag">19</span></a> and Lemma <a href="#Thmlemma20" title="Lemma 20. ‣ 4.2 Proof of Lemma : Realizing Contextual Mapping by Transformers ‣ 4 Proof of Lemma : Memorization of Transformers ‣ Standard Transformers Achieve the Minimax Rate in Nonparametric Regression with 𝐶^{𝑠,𝜆} Targets" class="ltx_ref"><span class="ltx_text ltx_ref_tag">20</span></a>, we have following equivalent conditions:</span></p>
<ul id="S4.I5" class="ltx_itemize">
<li id="S4.I5.i1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="S4.I5.i1.p1" class="ltx_para">
<p id="S4.I5.i1.p1.1" class="ltx_p"><math id="S4.I5.i1.p1.m1" class="ltx_math_unparsed" alttext="\boldsymbol{X}_{:,k}^{(i)}\neq\boldsymbol{X}_{:,l}^{(j)}" display="inline" intent=":literal"><semantics><mrow><mi>𝑿</mi><msub><mrow></mrow><mrow><mo rspace="0em">:</mo><mo>,</mo><mi>k</mi></mrow></msub><msup><mrow></mrow><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></msup><mo>≠</mo><mi>𝑿</mi><msub><mrow></mrow><mrow><mo rspace="0em">:</mo><mo>,</mo><mi>l</mi></mrow></msub><msup><mrow></mrow><mrow><mo stretchy="false">(</mo><mi>j</mi><mo stretchy="false">)</mo></mrow></msup></mrow><annotation encoding="application/x-tex">\boldsymbol{X}_{:,k}^{(i)}\neq\boldsymbol{X}_{:,l}^{(j)}</annotation></semantics></math> <math id="S4.I5.i1.p1.m2" class="ltx_Math" alttext="\Longleftrightarrow" display="inline" intent=":literal"><semantics><mo stretchy="false">⟺</mo><annotation encoding="application/x-tex">\Longleftrightarrow</annotation></semantics></math> <math id="S4.I5.i1.p1.m3" class="ltx_Math" alttext="{x}_{1,k}^{(i)}\neq{x}_{1,l}^{(j)}" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>x</mi><mrow><mn>1</mn><mo>,</mo><mi>k</mi></mrow><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></msubsup><mo>≠</mo><msubsup><mi>x</mi><mrow><mn>1</mn><mo>,</mo><mi>l</mi></mrow><mrow><mo stretchy="false">(</mo><mi>j</mi><mo stretchy="false">)</mo></mrow></msubsup></mrow><annotation encoding="application/x-tex">{x}_{1,k}^{(i)}\neq{x}_{1,l}^{(j)}</annotation></semantics></math>.</p>
</div></li>
<li id="S4.I5.i2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="S4.I5.i2.p1" class="ltx_para">
<p id="S4.I5.i2.p1.1" class="ltx_p"><math id="S4.I5.i2.p1.m1" class="ltx_Math" alttext="\boldsymbol{X}^{(i)}\neq\boldsymbol{X}^{(j)}" display="inline" intent=":literal"><semantics><mrow><msup><mi>𝑿</mi><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></msup><mo>≠</mo><msup><mi>𝑿</mi><mrow><mo stretchy="false">(</mo><mi>j</mi><mo stretchy="false">)</mo></mrow></msup></mrow><annotation encoding="application/x-tex">\boldsymbol{X}^{(i)}\neq\boldsymbol{X}^{(j)}</annotation></semantics></math> up to permutations <math id="S4.I5.i2.p1.m2" class="ltx_Math" alttext="\Longleftrightarrow" display="inline" intent=":literal"><semantics><mo stretchy="false">⟺</mo><annotation encoding="application/x-tex">\Longleftrightarrow</annotation></semantics></math> <math id="S4.I5.i2.p1.m3" class="ltx_Math" alttext="z^{(i)}\neq z^{(j)}" display="inline" intent=":literal"><semantics><mrow><msup><mi>z</mi><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></msup><mo>≠</mo><msup><mi>z</mi><mrow><mo stretchy="false">(</mo><mi>j</mi><mo stretchy="false">)</mo></mrow></msup></mrow><annotation encoding="application/x-tex">z^{(i)}\neq z^{(j)}</annotation></semantics></math>.</p>
</div></li>
</ul>
<p id="S4.SS2.p14.6" class="ltx_p"><span id="S4.SS2.p14.6.1" class="ltx_text">Therefore, in the following we check the separatedness of <math id="S4.SS2.p14.m18" class="ltx_Math" alttext="\left\{\boldsymbol{a}^{(i)}\right\}_{i\in[N]}" display="inline" intent=":literal"><semantics><msub><mrow><mo>{</mo><msup><mi>𝒂</mi><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></msup><mo>}</mo></mrow><mrow><mi>i</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mi>N</mi><mo stretchy="false">]</mo></mrow></mrow></msub><annotation encoding="application/x-tex">\left\{\boldsymbol{a}^{(i)}\right\}_{i\in[N]}</annotation></semantics></math> when <math id="S4.SS2.p14.m19" class="ltx_Math" alttext="{x}_{1,k}^{(i)}\neq{x}_{1,l}^{(j)}" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>x</mi><mrow><mn>1</mn><mo>,</mo><mi>k</mi></mrow><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></msubsup><mo>≠</mo><msubsup><mi>x</mi><mrow><mn>1</mn><mo>,</mo><mi>l</mi></mrow><mrow><mo stretchy="false">(</mo><mi>j</mi><mo stretchy="false">)</mo></mrow></msubsup></mrow><annotation encoding="application/x-tex">{x}_{1,k}^{(i)}\neq{x}_{1,l}^{(j)}</annotation></semantics></math> or <math id="S4.SS2.p14.m20" class="ltx_Math" alttext="z^{(i)}\neq z^{(j)}" display="inline" intent=":literal"><semantics><mrow><msup><mi>z</mi><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></msup><mo>≠</mo><msup><mi>z</mi><mrow><mo stretchy="false">(</mo><mi>j</mi><mo stretchy="false">)</mo></mrow></msup></mrow><annotation encoding="application/x-tex">z^{(i)}\neq z^{(j)}</annotation></semantics></math>. From definition, we have</span></p>
<table id="S4.EGx184" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="S4.Ex284"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S4.Ex284.m1" class="ltx_Math" alttext="\displaystyle a_{1,k}^{(i)}-a_{1,l}^{(j)}=(2r^{\prime}+1)\left(z^{(i)}-z^{(j)}\right)+\left(x_{1,k}^{(i)}-x_{1,l}^{(j)}\right)." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><msubsup><mi>a</mi><mrow><mn>1</mn><mo>,</mo><mi>k</mi></mrow><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></msubsup><mo>−</mo><msubsup><mi>a</mi><mrow><mn>1</mn><mo>,</mo><mi>l</mi></mrow><mrow><mo stretchy="false">(</mo><mi>j</mi><mo stretchy="false">)</mo></mrow></msubsup></mrow><mo>=</mo><mrow><mrow><mrow><mo stretchy="false">(</mo><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msup><mi>r</mi><mo>′</mo></msup></mrow><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><msup><mi>z</mi><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></msup><mo>−</mo><msup><mi>z</mi><mrow><mo stretchy="false">(</mo><mi>j</mi><mo stretchy="false">)</mo></mrow></msup></mrow><mo>)</mo></mrow></mrow><mo>+</mo><mrow><mo>(</mo><mrow><msubsup><mi>x</mi><mrow><mn>1</mn><mo>,</mo><mi>k</mi></mrow><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></msubsup><mo>−</mo><msubsup><mi>x</mi><mrow><mn>1</mn><mo>,</mo><mi>l</mi></mrow><mrow><mo stretchy="false">(</mo><mi>j</mi><mo stretchy="false">)</mo></mrow></msubsup></mrow><mo>)</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle a_{1,k}^{(i)}-a_{1,l}^{(j)}=(2r^{\prime}+1)\left(z^{(i)}-z^{(j)}\right)+\left(x_{1,k}^{(i)}-x_{1,l}^{(j)}\right).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S4.SS2.p14.7" class="ltx_p"><span id="S4.SS2.p14.7.1" class="ltx_text">If <math id="S4.SS2.p14.m21" class="ltx_Math" alttext="z^{(i)}=z^{(j)}" display="inline" intent=":literal"><semantics><mrow><msup><mi>z</mi><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></msup><mo>=</mo><msup><mi>z</mi><mrow><mo stretchy="false">(</mo><mi>j</mi><mo stretchy="false">)</mo></mrow></msup></mrow><annotation encoding="application/x-tex">z^{(i)}=z^{(j)}</annotation></semantics></math> and <math id="S4.SS2.p14.m22" class="ltx_Math" alttext="x_{1,k}^{(i)}\neq x_{1,l}^{(j)}" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>x</mi><mrow><mn>1</mn><mo>,</mo><mi>k</mi></mrow><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></msubsup><mo>≠</mo><msubsup><mi>x</mi><mrow><mn>1</mn><mo>,</mo><mi>l</mi></mrow><mrow><mo stretchy="false">(</mo><mi>j</mi><mo stretchy="false">)</mo></mrow></msubsup></mrow><annotation encoding="application/x-tex">x_{1,k}^{(i)}\neq x_{1,l}^{(j)}</annotation></semantics></math>, by Lemma <a href="#Thmlemma19" title="Lemma 19. ‣ 4.2 Proof of Lemma : Realizing Contextual Mapping by Transformers ‣ 4 Proof of Lemma : Memorization of Transformers ‣ Standard Transformers Achieve the Minimax Rate in Nonparametric Regression with 𝐶^{𝑠,𝜆} Targets" class="ltx_ref"><span class="ltx_text ltx_ref_tag">19</span></a> there holds</span></p>
<table id="S4.EGx185" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="S4.Ex285"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S4.Ex285.m1" class="ltx_Math" alttext="\displaystyle\left|a_{1,k}^{(i)}-a_{1,l}^{(j)}\right|=\left|x_{1,k}^{(i)}-x_{1,l}^{(j)}\right|\geq 2." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mo>|</mo><mrow><msubsup><mi>a</mi><mrow><mn>1</mn><mo>,</mo><mi>k</mi></mrow><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></msubsup><mo>−</mo><msubsup><mi>a</mi><mrow><mn>1</mn><mo>,</mo><mi>l</mi></mrow><mrow><mo stretchy="false">(</mo><mi>j</mi><mo stretchy="false">)</mo></mrow></msubsup></mrow><mo>|</mo></mrow><mo>=</mo><mrow><mo>|</mo><mrow><msubsup><mi>x</mi><mrow><mn>1</mn><mo>,</mo><mi>k</mi></mrow><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></msubsup><mo>−</mo><msubsup><mi>x</mi><mrow><mn>1</mn><mo>,</mo><mi>l</mi></mrow><mrow><mo stretchy="false">(</mo><mi>j</mi><mo stretchy="false">)</mo></mrow></msubsup></mrow><mo>|</mo></mrow><mo>≥</mo><mn>2</mn></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\left|a_{1,k}^{(i)}-a_{1,l}^{(j)}\right|=\left|x_{1,k}^{(i)}-x_{1,l}^{(j)}\right|\geq 2.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S4.SS2.p14.8" class="ltx_p"><span id="S4.SS2.p14.8.1" class="ltx_text">If <math id="S4.SS2.p14.m23" class="ltx_Math" alttext="z^{(i)}\neq z^{(j)}" display="inline" intent=":literal"><semantics><mrow><msup><mi>z</mi><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></msup><mo>≠</mo><msup><mi>z</mi><mrow><mo stretchy="false">(</mo><mi>j</mi><mo stretchy="false">)</mo></mrow></msup></mrow><annotation encoding="application/x-tex">z^{(i)}\neq z^{(j)}</annotation></semantics></math> and <math id="S4.SS2.p14.m24" class="ltx_Math" alttext="x_{1,k}^{(i)}=x_{1,l}^{(j)}" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>x</mi><mrow><mn>1</mn><mo>,</mo><mi>k</mi></mrow><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></msubsup><mo>=</mo><msubsup><mi>x</mi><mrow><mn>1</mn><mo>,</mo><mi>l</mi></mrow><mrow><mo stretchy="false">(</mo><mi>j</mi><mo stretchy="false">)</mo></mrow></msubsup></mrow><annotation encoding="application/x-tex">x_{1,k}^{(i)}=x_{1,l}^{(j)}</annotation></semantics></math>, by Lemma <a href="#Thmlemma20" title="Lemma 20. ‣ 4.2 Proof of Lemma : Realizing Contextual Mapping by Transformers ‣ 4 Proof of Lemma : Memorization of Transformers ‣ Standard Transformers Achieve the Minimax Rate in Nonparametric Regression with 𝐶^{𝑠,𝜆} Targets" class="ltx_ref"><span class="ltx_text ltx_ref_tag">20</span></a> there holds</span></p>
<table id="S4.EGx186" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="S4.Ex286"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S4.Ex286.m1" class="ltx_Math" alttext="\displaystyle\left|a_{1,k}^{(i)}-a_{1,l}^{(j)}\right|=(2r^{\prime}+1)\left|z^{(i)}-z^{(j)}\right|\geq 2(2r^{\prime}+1)\geq 2." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mo>|</mo><mrow><msubsup><mi>a</mi><mrow><mn>1</mn><mo>,</mo><mi>k</mi></mrow><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></msubsup><mo>−</mo><msubsup><mi>a</mi><mrow><mn>1</mn><mo>,</mo><mi>l</mi></mrow><mrow><mo stretchy="false">(</mo><mi>j</mi><mo stretchy="false">)</mo></mrow></msubsup></mrow><mo>|</mo></mrow><mo>=</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msup><mi>r</mi><mo>′</mo></msup></mrow><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo>|</mo><mrow><msup><mi>z</mi><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></msup><mo>−</mo><msup><mi>z</mi><mrow><mo stretchy="false">(</mo><mi>j</mi><mo stretchy="false">)</mo></mrow></msup></mrow><mo>|</mo></mrow></mrow><mo>≥</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msup><mi>r</mi><mo>′</mo></msup></mrow><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>≥</mo><mn>2</mn></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\left|a_{1,k}^{(i)}-a_{1,l}^{(j)}\right|=(2r^{\prime}+1)\left|z^{(i)}-z^{(j)}\right|\geq 2(2r^{\prime}+1)\geq 2.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S4.SS2.p14.9" class="ltx_p"><span id="S4.SS2.p14.9.1" class="ltx_text">If <math id="S4.SS2.p14.m25" class="ltx_Math" alttext="z^{(i)}\neq z^{(j)}" display="inline" intent=":literal"><semantics><mrow><msup><mi>z</mi><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></msup><mo>≠</mo><msup><mi>z</mi><mrow><mo stretchy="false">(</mo><mi>j</mi><mo stretchy="false">)</mo></mrow></msup></mrow><annotation encoding="application/x-tex">z^{(i)}\neq z^{(j)}</annotation></semantics></math> and <math id="S4.SS2.p14.m26" class="ltx_Math" alttext="x_{1,k}^{(i)}\neq x_{1,l}^{(j)}" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>x</mi><mrow><mn>1</mn><mo>,</mo><mi>k</mi></mrow><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></msubsup><mo>≠</mo><msubsup><mi>x</mi><mrow><mn>1</mn><mo>,</mo><mi>l</mi></mrow><mrow><mo stretchy="false">(</mo><mi>j</mi><mo stretchy="false">)</mo></mrow></msubsup></mrow><annotation encoding="application/x-tex">x_{1,k}^{(i)}\neq x_{1,l}^{(j)}</annotation></semantics></math>, assuming without loss of generality that <math id="S4.SS2.p14.m27" class="ltx_Math" alttext="z^{(i)}&gt;z^{(j)}" display="inline" intent=":literal"><semantics><mrow><msup><mi>z</mi><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></msup><mo>&gt;</mo><msup><mi>z</mi><mrow><mo stretchy="false">(</mo><mi>j</mi><mo stretchy="false">)</mo></mrow></msup></mrow><annotation encoding="application/x-tex">z^{(i)}&gt;z^{(j)}</annotation></semantics></math>, by Lemma <a href="#Thmlemma19" title="Lemma 19. ‣ 4.2 Proof of Lemma : Realizing Contextual Mapping by Transformers ‣ 4 Proof of Lemma : Memorization of Transformers ‣ Standard Transformers Achieve the Minimax Rate in Nonparametric Regression with 𝐶^{𝑠,𝜆} Targets" class="ltx_ref"><span class="ltx_text ltx_ref_tag">19</span></a> and Lemma <a href="#Thmlemma20" title="Lemma 20. ‣ 4.2 Proof of Lemma : Realizing Contextual Mapping by Transformers ‣ 4 Proof of Lemma : Memorization of Transformers ‣ Standard Transformers Achieve the Minimax Rate in Nonparametric Regression with 𝐶^{𝑠,𝜆} Targets" class="ltx_ref"><span class="ltx_text ltx_ref_tag">20</span></a> there holds</span></p>
<table id="S4.EGx187" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="S4.Ex287"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S4.Ex287.m1" class="ltx_Math" alttext="\displaystyle\left|a_{1,k}^{(i)}-a_{1,l}^{(j)}\right|" display="inline" intent=":literal"><semantics><mrow><mo>|</mo><mrow><msubsup><mi>a</mi><mrow><mn>1</mn><mo>,</mo><mi>k</mi></mrow><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></msubsup><mo>−</mo><msubsup><mi>a</mi><mrow><mn>1</mn><mo>,</mo><mi>l</mi></mrow><mrow><mo stretchy="false">(</mo><mi>j</mi><mo stretchy="false">)</mo></mrow></msubsup></mrow><mo>|</mo></mrow><annotation encoding="application/x-tex">\displaystyle\left|a_{1,k}^{(i)}-a_{1,l}^{(j)}\right|</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S4.Ex287.m2" class="ltx_Math" alttext="\displaystyle=\left|(2r^{\prime}+1)\left(z^{(i)}-z^{(j)}\right)+\left(x_{1,k}^{(i)}-x_{1,l}^{(j)}\right)\right|" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mo>|</mo><mrow><mrow><mrow><mo stretchy="false">(</mo><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msup><mi>r</mi><mo>′</mo></msup></mrow><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><msup><mi>z</mi><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></msup><mo>−</mo><msup><mi>z</mi><mrow><mo stretchy="false">(</mo><mi>j</mi><mo stretchy="false">)</mo></mrow></msup></mrow><mo>)</mo></mrow></mrow><mo>+</mo><mrow><mo>(</mo><mrow><msubsup><mi>x</mi><mrow><mn>1</mn><mo>,</mo><mi>k</mi></mrow><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></msubsup><mo>−</mo><msubsup><mi>x</mi><mrow><mn>1</mn><mo>,</mo><mi>l</mi></mrow><mrow><mo stretchy="false">(</mo><mi>j</mi><mo stretchy="false">)</mo></mrow></msubsup></mrow><mo>)</mo></mrow></mrow><mo>|</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\left|(2r^{\prime}+1)\left(z^{(i)}-z^{(j)}\right)+\left(x_{1,k}^{(i)}-x_{1,l}^{(j)}\right)\right|</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="S4.Ex288"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S4.Ex288.m1" class="ltx_Math" alttext="\displaystyle=(2r^{\prime}+1)\left(z^{(i)}-z^{(j)}\right)+\left(x_{1,k}^{(i)}-x_{1,l}^{(j)}\right)" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><mrow><mo stretchy="false">(</mo><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msup><mi>r</mi><mo>′</mo></msup></mrow><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><msup><mi>z</mi><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></msup><mo>−</mo><msup><mi>z</mi><mrow><mo stretchy="false">(</mo><mi>j</mi><mo stretchy="false">)</mo></mrow></msup></mrow><mo>)</mo></mrow></mrow><mo>+</mo><mrow><mo>(</mo><mrow><msubsup><mi>x</mi><mrow><mn>1</mn><mo>,</mo><mi>k</mi></mrow><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></msubsup><mo>−</mo><msubsup><mi>x</mi><mrow><mn>1</mn><mo>,</mo><mi>l</mi></mrow><mrow><mo stretchy="false">(</mo><mi>j</mi><mo stretchy="false">)</mo></mrow></msubsup></mrow><mo>)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=(2r^{\prime}+1)\left(z^{(i)}-z^{(j)}\right)+\left(x_{1,k}^{(i)}-x_{1,l}^{(j)}\right)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="S4.Ex289"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S4.Ex289.m1" class="ltx_Math" alttext="\displaystyle\geq 2(2r^{\prime}+1)-4r^{\prime}=2." display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>≥</mo><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msup><mi>r</mi><mo>′</mo></msup></mrow><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mn>4</mn><mo lspace="0em" rspace="0em">​</mo><msup><mi>r</mi><mo>′</mo></msup></mrow></mrow><mo>=</mo><mn>2</mn></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\geq 2(2r^{\prime}+1)-4r^{\prime}=2.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S4.SS2.p14.10" class="ltx_p"><span id="S4.SS2.p14.10.1" class="ltx_text">∎</span></p>
</div>
</div>
</section>
</section>
<section id="S5" class="ltx_section">
<h2 class="ltx_title ltx_title_section"><span class="ltx_tag ltx_tag_section">5 </span>Proof of Lemma <a href="#Thmlemma3" title="Lemma 3. ‣ 2.2 Proof of Theorem ‣ 2 Proofs of Main Results ‣ Standard Transformers Achieve the Minimax Rate in Nonparametric Regression with 𝐶^{𝑠,𝜆} Targets" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3</span></a>: Parallelization of Transformers</h2>

<div id="S5.p1" class="ltx_para">
<p id="S5.p1.1" class="ltx_p">(1) Since the argument used here is equally applicable to cases where <math id="S5.p1.m1" class="ltx_Math" alttext="L&gt;2" display="inline" intent=":literal"><semantics><mrow><mi>L</mi><mo>&gt;</mo><mn>2</mn></mrow><annotation encoding="application/x-tex">L&gt;2</annotation></semantics></math>, we only discuss the case where <math id="S5.p1.m2" class="ltx_Math" alttext="L=2" display="inline" intent=":literal"><semantics><mrow><mi>L</mi><mo>=</mo><mn>2</mn></mrow><annotation encoding="application/x-tex">L=2</annotation></semantics></math>. In this case, the two feedforward blocks are in the form of</p>
<table id="S5.EGx188" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="S5.Ex290"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S5.Ex290.m1" class="ltx_Math" alttext="\displaystyle\boldsymbol{\mathcal{F}}_{FF}^{(1)}(\boldsymbol{X})" display="inline" intent=":literal"><semantics><mrow><msubsup><mi class="ltx_font_mathcaligraphic">𝓕</mi><mrow><mi>F</mi><mo lspace="0em" rspace="0em">​</mo><mi>F</mi></mrow><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝑿</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\boldsymbol{\mathcal{F}}_{FF}^{(1)}(\boldsymbol{X})</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S5.Ex290.m2" class="ltx_Math" alttext="\displaystyle=\boldsymbol{W}_{2}^{(1)}\sigma_{R}\left(\boldsymbol{W}_{1}^{(1)}\boldsymbol{X}+\boldsymbol{B}_{1}^{(1)}\right)+\boldsymbol{B}_{2}^{(1)}," display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><msubsup><mi>𝑾</mi><mn>2</mn><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mi>σ</mi><mi>R</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mrow><msubsup><mi>𝑾</mi><mn>1</mn><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>𝑿</mi></mrow><mo>+</mo><msubsup><mi>𝑩</mi><mn>1</mn><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msubsup></mrow><mo>)</mo></mrow></mrow><mo>+</mo><msubsup><mi>𝑩</mi><mn>2</mn><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msubsup></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle=\boldsymbol{W}_{2}^{(1)}\sigma_{R}\left(\boldsymbol{W}_{1}^{(1)}\boldsymbol{X}+\boldsymbol{B}_{1}^{(1)}\right)+\boldsymbol{B}_{2}^{(1)},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="S5.Ex291"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S5.Ex291.m1" class="ltx_Math" alttext="\displaystyle\boldsymbol{\mathcal{F}}_{FF}^{(2)}(\boldsymbol{Y})" display="inline" intent=":literal"><semantics><mrow><msubsup><mi class="ltx_font_mathcaligraphic">𝓕</mi><mrow><mi>F</mi><mo lspace="0em" rspace="0em">​</mo><mi>F</mi></mrow><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝒀</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\boldsymbol{\mathcal{F}}_{FF}^{(2)}(\boldsymbol{Y})</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S5.Ex291.m2" class="ltx_Math" alttext="\displaystyle=\boldsymbol{W}_{2}^{(2)}\sigma_{R}\left(\boldsymbol{W}_{1}^{(2)}\boldsymbol{Y}+\boldsymbol{B}_{1}^{(2)}\right)+\boldsymbol{B}_{2}^{(2)}," display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><msubsup><mi>𝑾</mi><mn>2</mn><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mi>σ</mi><mi>R</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mrow><msubsup><mi>𝑾</mi><mn>1</mn><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>𝒀</mi></mrow><mo>+</mo><msubsup><mi>𝑩</mi><mn>1</mn><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup></mrow><mo>)</mo></mrow></mrow><mo>+</mo><msubsup><mi>𝑩</mi><mn>2</mn><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle=\boldsymbol{W}_{2}^{(2)}\sigma_{R}\left(\boldsymbol{W}_{1}^{(2)}\boldsymbol{Y}+\boldsymbol{B}_{1}^{(2)}\right)+\boldsymbol{B}_{2}^{(2)},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S5.p1.2" class="ltx_p">where <math id="S5.p1.m3" class="ltx_math_unparsed" alttext="\boldsymbol{W}_{1}^{(1)}\in\mathbb{R}^{r\times d^{(1)}},\boldsymbol{W}_{1}^{(2)}\in\mathbb{R}^{r\times d^{(2)}},\boldsymbol{B}_{1}^{(1)},\boldsymbol{B}_{1}^{(2)}\in\mathbb{R}^{r\times n},\boldsymbol{W}_{2}^{(1)}\in\mathbb{R}^{\bar{d}^{(1)}\times r},\boldsymbol{W}_{2}^{(2)}\in\mathbb{R}^{\bar{d}^{(2)}\times r},\linebreak\boldsymbol{B}_{2}^{(1)}\in\mathbb{R}^{\bar{d}^{(1)}\times n},\boldsymbol{B}_{2}^{(2)}\in\mathbb{R}^{\bar{d}^{(2)}\times n}" display="inline" intent=":literal"><semantics><mrow><mi>𝑾</mi><msub><mrow></mrow><mn>1</mn></msub><msup><mrow></mrow><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msup><mo>∈</mo><mi>ℝ</mi><msup><mrow></mrow><mrow><mi>r</mi><mo lspace="0.222em" rspace="0.222em">×</mo><msup><mi>d</mi><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msup></mrow></msup><mo>,</mo><mi>𝑾</mi><msub><mrow></mrow><mn>1</mn></msub><msup><mrow></mrow><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msup><mo>∈</mo><mi>ℝ</mi><msup><mrow></mrow><mrow><mi>r</mi><mo lspace="0.222em" rspace="0.222em">×</mo><msup><mi>d</mi><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msup></mrow></msup><mo>,</mo><mi>𝑩</mi><msub><mrow></mrow><mn>1</mn></msub><msup><mrow></mrow><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msup><mo>,</mo><mi>𝑩</mi><msub><mrow></mrow><mn>1</mn></msub><msup><mrow></mrow><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msup><mo>∈</mo><mi>ℝ</mi><msup><mrow></mrow><mrow><mi>r</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>n</mi></mrow></msup><mo>,</mo><mi>𝑾</mi><msub><mrow></mrow><mn>2</mn></msub><msup><mrow></mrow><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msup><mo>∈</mo><mi>ℝ</mi><msup><mrow></mrow><mrow><msup><mover accent="true"><mi>d</mi><mo>¯</mo></mover><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msup><mo lspace="0.222em" rspace="0.222em">×</mo><mi>r</mi></mrow></msup><mo>,</mo><mi>𝑾</mi><msub><mrow></mrow><mn>2</mn></msub><msup><mrow></mrow><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msup><mo>∈</mo><mi>ℝ</mi><msup><mrow></mrow><mrow><msup><mover accent="true"><mi>d</mi><mo>¯</mo></mover><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msup><mo lspace="0.222em" rspace="0.222em">×</mo><mi>r</mi></mrow></msup><mo>,</mo><mi>𝑩</mi><msub><mrow></mrow><mn>2</mn></msub><msup><mrow></mrow><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msup><mo>∈</mo><mi>ℝ</mi><msup><mrow></mrow><mrow><msup><mover accent="true"><mi>d</mi><mo>¯</mo></mover><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msup><mo lspace="0.222em" rspace="0.222em">×</mo><mi>n</mi></mrow></msup><mo>,</mo><mi>𝑩</mi><msub><mrow></mrow><mn>2</mn></msub><msup><mrow></mrow><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msup><mo>∈</mo><mi>ℝ</mi><msup><mrow></mrow><mrow><msup><mover accent="true"><mi>d</mi><mo>¯</mo></mover><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msup><mo lspace="0.222em" rspace="0.222em">×</mo><mi>n</mi></mrow></msup></mrow><annotation encoding="application/x-tex">\boldsymbol{W}_{1}^{(1)}\in\mathbb{R}^{r\times d^{(1)}},\boldsymbol{W}_{1}^{(2)}\in\mathbb{R}^{r\times d^{(2)}},\boldsymbol{B}_{1}^{(1)},\boldsymbol{B}_{1}^{(2)}\in\mathbb{R}^{r\times n},\boldsymbol{W}_{2}^{(1)}\in\mathbb{R}^{\bar{d}^{(1)}\times r},\boldsymbol{W}_{2}^{(2)}\in\mathbb{R}^{\bar{d}^{(2)}\times r},\linebreak\boldsymbol{B}_{2}^{(1)}\in\mathbb{R}^{\bar{d}^{(1)}\times n},\boldsymbol{B}_{2}^{(2)}\in\mathbb{R}^{\bar{d}^{(2)}\times n}</annotation></semantics></math>. Denote</p>
<table id="S5.EGx189" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="S5.Ex292"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S5.Ex292.m1" class="ltx_Math" alttext="\displaystyle\boldsymbol{W}_{1}^{(prl)}:=\begin{pmatrix}\boldsymbol{W}_{1}^{(1)}&amp;\boldsymbol{0}_{r\times d^{(2)}}\\
\boldsymbol{0}_{r\times d^{(1)}}&amp;\boldsymbol{W}_{1}^{(2)}\end{pmatrix},\quad\boldsymbol{B}_{1}^{(prl)}:=\begin{pmatrix}\boldsymbol{B}_{1}^{(1)}\\
\boldsymbol{B}_{1}^{(2)}\end{pmatrix}," display="inline" intent=":literal"><semantics><mrow><mrow><mrow><msubsup><mi>𝑾</mi><mn>1</mn><mrow><mo stretchy="false">(</mo><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>l</mi></mrow><mo stretchy="false">)</mo></mrow></msubsup><mo>:=</mo><mrow><mo>(</mo><mtable columnspacing="5pt" rowspacing="0pt"><mtr><mtd><msubsup><mi>𝑾</mi><mn>1</mn><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msubsup></mtd><mtd><msub><mn>𝟎</mn><mrow><mi>r</mi><mo lspace="0.222em" rspace="0.222em">×</mo><msup><mi>d</mi><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msup></mrow></msub></mtd></mtr><mtr><mtd><msub><mn>𝟎</mn><mrow><mi>r</mi><mo lspace="0.222em" rspace="0.222em">×</mo><msup><mi>d</mi><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msup></mrow></msub></mtd><mtd><msubsup><mi>𝑾</mi><mn>1</mn><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup></mtd></mtr></mtable><mo>)</mo></mrow></mrow><mo rspace="1.167em">,</mo><mrow><msubsup><mi>𝑩</mi><mn>1</mn><mrow><mo stretchy="false">(</mo><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>l</mi></mrow><mo stretchy="false">)</mo></mrow></msubsup><mo>:=</mo><mrow><mo>(</mo><mtable rowspacing="0pt"><mtr><mtd><msubsup><mi>𝑩</mi><mn>1</mn><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msubsup></mtd></mtr><mtr><mtd><msubsup><mi>𝑩</mi><mn>1</mn><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup></mtd></mtr></mtable><mo>)</mo></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\boldsymbol{W}_{1}^{(prl)}:=\begin{pmatrix}\boldsymbol{W}_{1}^{(1)}&amp;\boldsymbol{0}_{r\times d^{(2)}}\\
\boldsymbol{0}_{r\times d^{(1)}}&amp;\boldsymbol{W}_{1}^{(2)}\end{pmatrix},\quad\boldsymbol{B}_{1}^{(prl)}:=\begin{pmatrix}\boldsymbol{B}_{1}^{(1)}\\
\boldsymbol{B}_{1}^{(2)}\end{pmatrix},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="S5.Ex293"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S5.Ex293.m1" class="ltx_Math" alttext="\displaystyle\boldsymbol{W}_{2}^{(prl)}:=\begin{pmatrix}\boldsymbol{W}_{2}^{(1)}&amp;\boldsymbol{0}_{\bar{d}^{(1)}\times r}\\
\boldsymbol{0}_{\bar{d}^{(2)}\times r}&amp;\boldsymbol{W}_{2}^{(2)}\end{pmatrix},\quad\boldsymbol{B}_{2}^{(prl)}:=\begin{pmatrix}\boldsymbol{B}_{2}^{(1)}\\
\boldsymbol{B}_{2}^{(2)}\end{pmatrix}," display="inline" intent=":literal"><semantics><mrow><mrow><mrow><msubsup><mi>𝑾</mi><mn>2</mn><mrow><mo stretchy="false">(</mo><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>l</mi></mrow><mo stretchy="false">)</mo></mrow></msubsup><mo>:=</mo><mrow><mo>(</mo><mtable columnspacing="5pt" rowspacing="0pt"><mtr><mtd><msubsup><mi>𝑾</mi><mn>2</mn><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msubsup></mtd><mtd><msub><mn>𝟎</mn><mrow><msup><mover accent="true"><mi>d</mi><mo>¯</mo></mover><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msup><mo lspace="0.222em" rspace="0.222em">×</mo><mi>r</mi></mrow></msub></mtd></mtr><mtr><mtd><msub><mn>𝟎</mn><mrow><msup><mover accent="true"><mi>d</mi><mo>¯</mo></mover><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msup><mo lspace="0.222em" rspace="0.222em">×</mo><mi>r</mi></mrow></msub></mtd><mtd><msubsup><mi>𝑾</mi><mn>2</mn><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup></mtd></mtr></mtable><mo>)</mo></mrow></mrow><mo rspace="1.167em">,</mo><mrow><msubsup><mi>𝑩</mi><mn>2</mn><mrow><mo stretchy="false">(</mo><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>l</mi></mrow><mo stretchy="false">)</mo></mrow></msubsup><mo>:=</mo><mrow><mo>(</mo><mtable rowspacing="0pt"><mtr><mtd><msubsup><mi>𝑩</mi><mn>2</mn><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msubsup></mtd></mtr><mtr><mtd><msubsup><mi>𝑩</mi><mn>2</mn><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup></mtd></mtr></mtable><mo>)</mo></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\boldsymbol{W}_{2}^{(prl)}:=\begin{pmatrix}\boldsymbol{W}_{2}^{(1)}&amp;\boldsymbol{0}_{\bar{d}^{(1)}\times r}\\
\boldsymbol{0}_{\bar{d}^{(2)}\times r}&amp;\boldsymbol{W}_{2}^{(2)}\end{pmatrix},\quad\boldsymbol{B}_{2}^{(prl)}:=\begin{pmatrix}\boldsymbol{B}_{2}^{(1)}\\
\boldsymbol{B}_{2}^{(2)}\end{pmatrix},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S5.p1.3" class="ltx_p">and define</p>
<table id="S5.EGx190" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="S5.Ex294"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S5.Ex294.m1" class="ltx_Math" alttext="\displaystyle\boldsymbol{\mathcal{F}}_{FF}^{(prl)}\left(\begin{pmatrix}\boldsymbol{X}\\
\boldsymbol{Y}\end{pmatrix}\right)" display="inline" intent=":literal"><semantics><mrow><msubsup><mi class="ltx_font_mathcaligraphic">𝓕</mi><mrow><mi>F</mi><mo lspace="0em" rspace="0em">​</mo><mi>F</mi></mrow><mrow><mo stretchy="false">(</mo><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>l</mi></mrow><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mo>(</mo><mtable rowspacing="0pt"><mtr><mtd><mi>𝑿</mi></mtd></mtr><mtr><mtd><mi>𝒀</mi></mtd></mtr></mtable><mo>)</mo></mrow><mo>)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\boldsymbol{\mathcal{F}}_{FF}^{(prl)}\left(\begin{pmatrix}\boldsymbol{X}\\
\boldsymbol{Y}\end{pmatrix}\right)</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S5.Ex294.m2" class="ltx_Math" alttext="\displaystyle:=\boldsymbol{W}_{2}^{(prl)}\sigma_{R}\left(\boldsymbol{W}_{1}^{(prl)}\begin{pmatrix}\boldsymbol{X}\\
\boldsymbol{Y}\end{pmatrix}+\boldsymbol{B}_{1}^{(prl)}\right)+\boldsymbol{B}_{2}^{(prl)}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><msubsup><mi>𝑾</mi><mn>2</mn><mrow><mo stretchy="false">(</mo><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>l</mi></mrow><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mi>σ</mi><mi>R</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mrow><msubsup><mi>𝑾</mi><mn>1</mn><mrow><mo stretchy="false">(</mo><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>l</mi></mrow><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mtable rowspacing="0pt"><mtr><mtd><mi>𝑿</mi></mtd></mtr><mtr><mtd><mi>𝒀</mi></mtd></mtr></mtable><mo>)</mo></mrow></mrow><mo>+</mo><msubsup><mi>𝑩</mi><mn>1</mn><mrow><mo stretchy="false">(</mo><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>l</mi></mrow><mo stretchy="false">)</mo></mrow></msubsup></mrow><mo>)</mo></mrow></mrow><mo>+</mo><msubsup><mi>𝑩</mi><mn>2</mn><mrow><mo stretchy="false">(</mo><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>l</mi></mrow><mo stretchy="false">)</mo></mrow></msubsup></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle:=\boldsymbol{W}_{2}^{(prl)}\sigma_{R}\left(\boldsymbol{W}_{1}^{(prl)}\begin{pmatrix}\boldsymbol{X}\\
\boldsymbol{Y}\end{pmatrix}+\boldsymbol{B}_{1}^{(prl)}\right)+\boldsymbol{B}_{2}^{(prl)}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="S5.Ex295"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S5.Ex295.m1" class="ltx_Math" alttext="\displaystyle=\begin{pmatrix}\boldsymbol{W}_{2}^{(1)}&amp;\boldsymbol{0}_{\bar{d}^{(1)}\times r}\\
\boldsymbol{0}_{\bar{d}^{(2)}\times r}&amp;\boldsymbol{W}_{2}^{(2)}\end{pmatrix}\sigma_{R}\left(\begin{pmatrix}\boldsymbol{W}_{1}^{(1)}&amp;\boldsymbol{0}_{r\times d^{(2)}}\\
\boldsymbol{0}_{r\times d^{(1)}}&amp;\boldsymbol{W}_{1}^{(2)}\end{pmatrix}\begin{pmatrix}\boldsymbol{X}\\
\boldsymbol{Y}\end{pmatrix}+\begin{pmatrix}\boldsymbol{B}_{1}^{(1)}\\
\boldsymbol{B}_{1}^{(2)}\end{pmatrix}\right)+\begin{pmatrix}\boldsymbol{B}_{2}^{(1)}\\
\boldsymbol{B}_{2}^{(2)}\end{pmatrix}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><mrow><mo>(</mo><mtable columnspacing="5pt" rowspacing="0pt"><mtr><mtd><msubsup><mi>𝑾</mi><mn>2</mn><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msubsup></mtd><mtd><msub><mn>𝟎</mn><mrow><msup><mover accent="true"><mi>d</mi><mo>¯</mo></mover><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msup><mo lspace="0.222em" rspace="0.222em">×</mo><mi>r</mi></mrow></msub></mtd></mtr><mtr><mtd><msub><mn>𝟎</mn><mrow><msup><mover accent="true"><mi>d</mi><mo>¯</mo></mover><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msup><mo lspace="0.222em" rspace="0.222em">×</mo><mi>r</mi></mrow></msub></mtd><mtd><msubsup><mi>𝑾</mi><mn>2</mn><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup></mtd></mtr></mtable><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>σ</mi><mi>R</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mrow><mrow><mo>(</mo><mtable columnspacing="5pt" rowspacing="0pt"><mtr><mtd><msubsup><mi>𝑾</mi><mn>1</mn><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msubsup></mtd><mtd><msub><mn>𝟎</mn><mrow><mi>r</mi><mo lspace="0.222em" rspace="0.222em">×</mo><msup><mi>d</mi><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msup></mrow></msub></mtd></mtr><mtr><mtd><msub><mn>𝟎</mn><mrow><mi>r</mi><mo lspace="0.222em" rspace="0.222em">×</mo><msup><mi>d</mi><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msup></mrow></msub></mtd><mtd><msubsup><mi>𝑾</mi><mn>1</mn><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup></mtd></mtr></mtable><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mtable rowspacing="0pt"><mtr><mtd><mi>𝑿</mi></mtd></mtr><mtr><mtd><mi>𝒀</mi></mtd></mtr></mtable><mo>)</mo></mrow></mrow><mo>+</mo><mrow><mo>(</mo><mtable rowspacing="0pt"><mtr><mtd><msubsup><mi>𝑩</mi><mn>1</mn><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msubsup></mtd></mtr><mtr><mtd><msubsup><mi>𝑩</mi><mn>1</mn><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup></mtd></mtr></mtable><mo>)</mo></mrow></mrow><mo>)</mo></mrow></mrow><mo>+</mo><mrow><mo>(</mo><mtable rowspacing="0pt"><mtr><mtd><msubsup><mi>𝑩</mi><mn>2</mn><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msubsup></mtd></mtr><mtr><mtd><msubsup><mi>𝑩</mi><mn>2</mn><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup></mtd></mtr></mtable><mo>)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\begin{pmatrix}\boldsymbol{W}_{2}^{(1)}&amp;\boldsymbol{0}_{\bar{d}^{(1)}\times r}\\
\boldsymbol{0}_{\bar{d}^{(2)}\times r}&amp;\boldsymbol{W}_{2}^{(2)}\end{pmatrix}\sigma_{R}\left(\begin{pmatrix}\boldsymbol{W}_{1}^{(1)}&amp;\boldsymbol{0}_{r\times d^{(2)}}\\
\boldsymbol{0}_{r\times d^{(1)}}&amp;\boldsymbol{W}_{1}^{(2)}\end{pmatrix}\begin{pmatrix}\boldsymbol{X}\\
\boldsymbol{Y}\end{pmatrix}+\begin{pmatrix}\boldsymbol{B}_{1}^{(1)}\\
\boldsymbol{B}_{1}^{(2)}\end{pmatrix}\right)+\begin{pmatrix}\boldsymbol{B}_{2}^{(1)}\\
\boldsymbol{B}_{2}^{(2)}\end{pmatrix}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="S5.Ex296"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S5.Ex296.m1" class="ltx_Math" alttext="\displaystyle=\begin{pmatrix}\boldsymbol{W}_{2}^{(1)}\sigma_{R}\left(\boldsymbol{W}_{1}^{(1)}\boldsymbol{X}+\boldsymbol{B}_{1}^{(1)}\right)+\boldsymbol{B}_{2}^{(1)}\\
\boldsymbol{W}_{2}^{(2)}\sigma_{R}\left(\boldsymbol{W}_{1}^{(2)}\boldsymbol{Y}+\boldsymbol{B}_{1}^{(2)}\right)+\boldsymbol{B}_{2}^{(2)}\end{pmatrix}=\begin{pmatrix}\boldsymbol{\mathcal{F}}_{FF}^{(1)}(\boldsymbol{X})\\
\boldsymbol{\mathcal{F}}_{FF}^{(2)}(\boldsymbol{Y})\end{pmatrix}." display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>=</mo><mrow><mo>(</mo><mtable rowspacing="0pt"><mtr><mtd><mrow><mrow><msubsup><mi>𝑾</mi><mn>2</mn><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mi>σ</mi><mi>R</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mrow><msubsup><mi>𝑾</mi><mn>1</mn><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>𝑿</mi></mrow><mo>+</mo><msubsup><mi>𝑩</mi><mn>1</mn><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msubsup></mrow><mo>)</mo></mrow></mrow><mo>+</mo><msubsup><mi>𝑩</mi><mn>2</mn><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msubsup></mrow></mtd></mtr><mtr><mtd><mrow><mrow><msubsup><mi>𝑾</mi><mn>2</mn><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mi>σ</mi><mi>R</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mrow><msubsup><mi>𝑾</mi><mn>1</mn><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>𝒀</mi></mrow><mo>+</mo><msubsup><mi>𝑩</mi><mn>1</mn><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup></mrow><mo>)</mo></mrow></mrow><mo>+</mo><msubsup><mi>𝑩</mi><mn>2</mn><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup></mrow></mtd></mtr></mtable><mo>)</mo></mrow><mo>=</mo><mrow><mo>(</mo><mtable rowspacing="0pt"><mtr><mtd><mrow><msubsup><mi class="ltx_font_mathcaligraphic">𝓕</mi><mrow><mi>F</mi><mo lspace="0em" rspace="0em">​</mo><mi>F</mi></mrow><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝑿</mi><mo stretchy="false">)</mo></mrow></mrow></mtd></mtr><mtr><mtd><mrow><msubsup><mi class="ltx_font_mathcaligraphic">𝓕</mi><mrow><mi>F</mi><mo lspace="0em" rspace="0em">​</mo><mi>F</mi></mrow><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝒀</mi><mo stretchy="false">)</mo></mrow></mrow></mtd></mtr></mtable><mo>)</mo></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle=\begin{pmatrix}\boldsymbol{W}_{2}^{(1)}\sigma_{R}\left(\boldsymbol{W}_{1}^{(1)}\boldsymbol{X}+\boldsymbol{B}_{1}^{(1)}\right)+\boldsymbol{B}_{2}^{(1)}\\
\boldsymbol{W}_{2}^{(2)}\sigma_{R}\left(\boldsymbol{W}_{1}^{(2)}\boldsymbol{Y}+\boldsymbol{B}_{1}^{(2)}\right)+\boldsymbol{B}_{2}^{(2)}\end{pmatrix}=\begin{pmatrix}\boldsymbol{\mathcal{F}}_{FF}^{(1)}(\boldsymbol{X})\\
\boldsymbol{\mathcal{F}}_{FF}^{(2)}(\boldsymbol{Y})\end{pmatrix}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S5.p1.4" class="ltx_p">(2) Consider the following two self-attention layers:</p>
<table id="S5.EGx191" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="S5.Ex297"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S5.Ex297.m1" class="ltx_Math" alttext="\displaystyle\boldsymbol{\mathcal{F}}_{SA}^{(1)}(\boldsymbol{X})" display="inline" intent=":literal"><semantics><mrow><msubsup><mi class="ltx_font_mathcaligraphic">𝓕</mi><mrow><mi>S</mi><mo lspace="0em" rspace="0em">​</mo><mi>A</mi></mrow><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝑿</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\boldsymbol{\mathcal{F}}_{SA}^{(1)}(\boldsymbol{X})</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S5.Ex297.m2" class="ltx_Math" alttext="\displaystyle=\boldsymbol{X}+\sum_{h=1}^{H^{(1)}}\boldsymbol{W}_{O,h}^{(1)}\boldsymbol{W}_{V,h}^{(1)}\boldsymbol{X}\sigma_{S}\left(\boldsymbol{X}^{\top}\boldsymbol{W}_{K,h}^{(1){\top}}\boldsymbol{W}_{Q,h}^{(1)}\boldsymbol{X}\right)," display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>=</mo><mrow><mi>𝑿</mi><mo>+</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>h</mi><mo>=</mo><mn>1</mn></mrow><msup><mi>H</mi><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msup></munderover></mstyle><mrow><msubsup><mi>𝑾</mi><mrow><mi>O</mi><mo>,</mo><mi>h</mi></mrow><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝑾</mi><mrow><mi>V</mi><mo>,</mo><mi>h</mi></mrow><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>𝑿</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>σ</mi><mi>S</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><msup><mi>𝑿</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝑾</mi><mrow><mi>K</mi><mo>,</mo><mi>h</mi></mrow><mrow><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow><mo lspace="0.222em">⊤</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝑾</mi><mrow><mi>Q</mi><mo>,</mo><mi>h</mi></mrow><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>𝑿</mi></mrow><mo>)</mo></mrow></mrow></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle=\boldsymbol{X}+\sum_{h=1}^{H^{(1)}}\boldsymbol{W}_{O,h}^{(1)}\boldsymbol{W}_{V,h}^{(1)}\boldsymbol{X}\sigma_{S}\left(\boldsymbol{X}^{\top}\boldsymbol{W}_{K,h}^{(1){\top}}\boldsymbol{W}_{Q,h}^{(1)}\boldsymbol{X}\right),</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="S5.Ex298"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S5.Ex298.m1" class="ltx_Math" alttext="\displaystyle\boldsymbol{\mathcal{F}}_{SA}^{(2)}(\boldsymbol{Y})" display="inline" intent=":literal"><semantics><mrow><msubsup><mi class="ltx_font_mathcaligraphic">𝓕</mi><mrow><mi>S</mi><mo lspace="0em" rspace="0em">​</mo><mi>A</mi></mrow><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝒀</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\boldsymbol{\mathcal{F}}_{SA}^{(2)}(\boldsymbol{Y})</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S5.Ex298.m2" class="ltx_Math" alttext="\displaystyle=\boldsymbol{Y}+\sum_{h=1}^{H^{(2)}}\boldsymbol{W}_{O,h}^{(2)}\boldsymbol{W}_{V,h}^{(2)}\boldsymbol{Y}\sigma_{S}\left(\boldsymbol{Y}^{\top}\boldsymbol{W}_{K,h}^{(2){\top}}\boldsymbol{W}_{Q,h}^{(2)}\boldsymbol{Y}\right)," display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>=</mo><mrow><mi>𝒀</mi><mo>+</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>h</mi><mo>=</mo><mn>1</mn></mrow><msup><mi>H</mi><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msup></munderover></mstyle><mrow><msubsup><mi>𝑾</mi><mrow><mi>O</mi><mo>,</mo><mi>h</mi></mrow><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝑾</mi><mrow><mi>V</mi><mo>,</mo><mi>h</mi></mrow><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>𝒀</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>σ</mi><mi>S</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><msup><mi>𝒀</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝑾</mi><mrow><mi>K</mi><mo>,</mo><mi>h</mi></mrow><mrow><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow><mo lspace="0.222em">⊤</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝑾</mi><mrow><mi>Q</mi><mo>,</mo><mi>h</mi></mrow><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>𝒀</mi></mrow><mo>)</mo></mrow></mrow></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle=\boldsymbol{Y}+\sum_{h=1}^{H^{(2)}}\boldsymbol{W}_{O,h}^{(2)}\boldsymbol{W}_{V,h}^{(2)}\boldsymbol{Y}\sigma_{S}\left(\boldsymbol{Y}^{\top}\boldsymbol{W}_{K,h}^{(2){\top}}\boldsymbol{W}_{Q,h}^{(2)}\boldsymbol{Y}\right),</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S5.p1.5" class="ltx_p">where <math id="S5.p1.m4" class="ltx_Math" alttext="\boldsymbol{W}_{O,h}^{(1)}\in\mathbb{R}^{d^{(1)}\times S^{(1)}},\boldsymbol{W}_{V,h}^{(1)},\boldsymbol{W}_{K,h}^{(1)},\boldsymbol{W}_{Q,h}^{(1)}\in\mathbb{R}^{S^{(1)}\times d^{(1)}},\boldsymbol{W}_{O,h}^{(2)}\in\mathbb{R}^{d^{(2)}\times S^{(2)}},\boldsymbol{W}_{V,h}^{(2)},\linebreak\boldsymbol{W}_{K,h}^{(2)},\boldsymbol{W}_{Q,h}^{(2)}\in\mathbb{R}^{S^{(2)}\times d^{(2)}}" display="inline" intent=":literal"><semantics><mrow><mrow><msubsup><mi>𝑾</mi><mrow><mi>O</mi><mo>,</mo><mi>h</mi></mrow><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msubsup><mo>∈</mo><msup><mi>ℝ</mi><mrow><msup><mi>d</mi><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msup><mo lspace="0.222em" rspace="0.222em">×</mo><msup><mi>S</mi><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msup></mrow></msup></mrow><mo>,</mo><msubsup><mi>𝑾</mi><mrow><mi>V</mi><mo>,</mo><mi>h</mi></mrow><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msubsup><mo>,</mo><msubsup><mi>𝑾</mi><mrow><mi>K</mi><mo>,</mo><mi>h</mi></mrow><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msubsup><mo>,</mo><mrow><msubsup><mi>𝑾</mi><mrow><mi>Q</mi><mo>,</mo><mi>h</mi></mrow><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msubsup><mo>∈</mo><msup><mi>ℝ</mi><mrow><msup><mi>S</mi><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msup><mo lspace="0.222em" rspace="0.222em">×</mo><msup><mi>d</mi><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msup></mrow></msup></mrow><mo>,</mo><mrow><msubsup><mi>𝑾</mi><mrow><mi>O</mi><mo>,</mo><mi>h</mi></mrow><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup><mo>∈</mo><msup><mi>ℝ</mi><mrow><msup><mi>d</mi><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msup><mo lspace="0.222em" rspace="0.222em">×</mo><msup><mi>S</mi><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msup></mrow></msup></mrow><mo>,</mo><msubsup><mi>𝑾</mi><mrow><mi>V</mi><mo>,</mo><mi>h</mi></mrow><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup><mo>,</mo><msubsup><mi>𝑾</mi><mrow><mi>K</mi><mo>,</mo><mi>h</mi></mrow><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup><mo>,</mo><mrow><msubsup><mi>𝑾</mi><mrow><mi>Q</mi><mo>,</mo><mi>h</mi></mrow><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup><mo>∈</mo><msup><mi>ℝ</mi><mrow><msup><mi>S</mi><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msup><mo lspace="0.222em" rspace="0.222em">×</mo><msup><mi>d</mi><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msup></mrow></msup></mrow></mrow><annotation encoding="application/x-tex">\boldsymbol{W}_{O,h}^{(1)}\in\mathbb{R}^{d^{(1)}\times S^{(1)}},\boldsymbol{W}_{V,h}^{(1)},\boldsymbol{W}_{K,h}^{(1)},\boldsymbol{W}_{Q,h}^{(1)}\in\mathbb{R}^{S^{(1)}\times d^{(1)}},\boldsymbol{W}_{O,h}^{(2)}\in\mathbb{R}^{d^{(2)}\times S^{(2)}},\boldsymbol{W}_{V,h}^{(2)},\linebreak\boldsymbol{W}_{K,h}^{(2)},\boldsymbol{W}_{Q,h}^{(2)}\in\mathbb{R}^{S^{(2)}\times d^{(2)}}</annotation></semantics></math>. Let</p>
<table id="S5.EGx192" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="S5.Ex299"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S5.Ex299.m1" class="ltx_Math" alttext="\displaystyle\boldsymbol{W}_{O,h,1}^{(prl)}:=\begin{pmatrix}\boldsymbol{W}_{O,h}^{(1)}\\
