<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S7.Ex434.m1" class="ltx_Math" alttext="\displaystyle\quad+\sqrt{n}\left\|\boldsymbol{W}_{O}^{(h)}\right\|_{F}\left\|\boldsymbol{W}_{V}^{(h)}\right\|_{F}\left\|\boldsymbol{\widetilde{Y}}-\boldsymbol{Y}\right\|_{F}" display="inline" intent=":literal"><semantics><mrow><mo>+</mo><mrow><msqrt><mi>n</mi></msqrt><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo>‖</mo><msubsup><mi>𝑾</mi><mi>O</mi><mrow><mo stretchy="false">(</mo><mi>h</mi><mo stretchy="false">)</mo></mrow></msubsup><mo>‖</mo></mrow><mi>F</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo>‖</mo><msubsup><mi>𝑾</mi><mi>V</mi><mrow><mo stretchy="false">(</mo><mi>h</mi><mo stretchy="false">)</mo></mrow></msubsup><mo>‖</mo></mrow><mi>F</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo>‖</mo><mrow><mover accent="true"><mi>𝒀</mi><mo>~</mo></mover><mo>−</mo><mi>𝒀</mi></mrow><mo>‖</mo></mrow><mi>F</mi></msub></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\quad+\sqrt{n}\left\|\boldsymbol{W}_{O}^{(h)}\right\|_{F}\left\|\boldsymbol{W}_{V}^{(h)}\right\|_{F}\left\|\boldsymbol{\widetilde{Y}}-\boldsymbol{Y}\right\|_{F}</annotation></semantics></math></td>
