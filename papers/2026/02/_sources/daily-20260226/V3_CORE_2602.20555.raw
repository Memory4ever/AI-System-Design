<tbody id="S5.Ex305"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S5.Ex305.m1" class="ltx_Math" alttext="\displaystyle\boldsymbol{W}_{K,h,2}^{(prl)}:=\begin{pmatrix}\boldsymbol{0}_{S^{(2)}\times d^{(1)}}&amp;\boldsymbol{W}_{K,h}^{(2)}\end{pmatrix},\quad\boldsymbol{W}_{Q,h,2}^{(prl)}:=\begin{pmatrix}\boldsymbol{0}_{S^{(2)}\times d^{(1)}}&amp;\boldsymbol{W}_{Q,h}^{(2)}\end{pmatrix}" display="inline" intent=":literal"><semantics><mrow><mrow><msubsup><mi>𝑾</mi><mrow><mi>K</mi><mo>,</mo><mi>h</mi><mo>,</mo><mn>2</mn></mrow><mrow><mo stretchy="false">(</mo><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>l</mi></mrow><mo stretchy="false">)</mo></mrow></msubsup><mo>:=</mo><mrow><mo>(</mo><mtable columnspacing="5pt"><mtr><mtd><msub><mn>𝟎</mn><mrow><msup><mi>S</mi><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msup><mo lspace="0.222em" rspace="0.222em">×</mo><msup><mi>d</mi><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msup></mrow></msub></mtd><mtd><msubsup><mi>𝑾</mi><mrow><mi>K</mi><mo>,</mo><mi>h</mi></mrow><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup></mtd></mtr></mtable><mo>)</mo></mrow></mrow><mo rspace="1.167em">,</mo><mrow><msubsup><mi>𝑾</mi><mrow><mi>Q</mi><mo>,</mo><mi>h</mi><mo>,</mo><mn>2</mn></mrow><mrow><mo stretchy="false">(</mo><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>l</mi></mrow><mo stretchy="false">)</mo></mrow></msubsup><mo>:=</mo><mrow><mo>(</mo><mtable columnspacing="5pt"><mtr><mtd><msub><mn>𝟎</mn><mrow><msup><mi>S</mi><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msup><mo lspace="0.222em" rspace="0.222em">×</mo><msup><mi>d</mi><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msup></mrow></msub></mtd><mtd><msubsup><mi>𝑾</mi><mrow><mi>Q</mi><mo>,</mo><mi>h</mi></mrow><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup></mtd></mtr></mtable><mo>)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\boldsymbol{W}_{K,h,2}^{(prl)}:=\begin{pmatrix}\boldsymbol{0}_{S^{(2)}\times d^{(1)}}&amp;\boldsymbol{W}_{K,h}^{(2)}\end{pmatrix},\quad\boldsymbol{W}_{Q,h,2}^{(prl)}:=\begin{pmatrix}\boldsymbol{0}_{S^{(2)}\times d^{(1)}}&amp;\boldsymbol{W}_{Q,h}^{(2)}\end{pmatrix}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S5.p1.8" class="ltx_p">and we have</p>
<table id="S5.EGx195" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="S5.Ex306"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S5.Ex306.m1" class="ltx_Math" alttext="\displaystyle\boldsymbol{W}_{O,h,2}^{(prl)}\boldsymbol{W}_{V,h,2}^{(prl)}\begin{pmatrix}\boldsymbol{X}\\
\boldsymbol{Y}\end{pmatrix}\sigma_{S}\left(\begin{pmatrix}\boldsymbol{X}^{\top}&amp;\boldsymbol{Y}^{\top}\end{pmatrix}\boldsymbol{W}_{K,h,2}^{(prl){\top}}\boldsymbol{W}_{Q,h,2}^{(prl)}\begin{pmatrix}\boldsymbol{X}\\
\boldsymbol{Y}\end{pmatrix}\right)" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>𝑾</mi><mrow><mi>O</mi><mo>,</mo><mi>h</mi><mo>,</mo><mn>2</mn></mrow><mrow><mo stretchy="false">(</mo><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>l</mi></mrow><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝑾</mi><mrow><mi>V</mi><mo>,</mo><mi>h</mi><mo>,</mo><mn>2</mn></mrow><mrow><mo stretchy="false">(</mo><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>l</mi></mrow><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mtable rowspacing="0pt"><mtr><mtd><mi>𝑿</mi></mtd></mtr><mtr><mtd><mi>𝒀</mi></mtd></mtr></mtable><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>σ</mi><mi>S</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mrow><mo>(</mo><mtable columnspacing="5pt"><mtr><mtd><msup><mi>𝑿</mi><mo>⊤</mo></msup></mtd><mtd><msup><mi>𝒀</mi><mo>⊤</mo></msup></mtd></mtr></mtable><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝑾</mi><mrow><mi>K</mi><mo>,</mo><mi>h</mi><mo>,</mo><mn>2</mn></mrow><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>l</mi></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0.222em">⊤</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝑾</mi><mrow><mi>Q</mi><mo>,</mo><mi>h</mi><mo>,</mo><mn>2</mn></mrow><mrow><mo stretchy="false">(</mo><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>l</mi></mrow><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mtable rowspacing="0pt"><mtr><mtd><mi>𝑿</mi></mtd></mtr><mtr><mtd><mi>𝒀</mi></mtd></mtr></mtable><mo>)</mo></mrow></mrow><mo>)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\boldsymbol{W}_{O,h,2}^{(prl)}\boldsymbol{W}_{V,h,2}^{(prl)}\begin{pmatrix}\boldsymbol{X}\\
\boldsymbol{Y}\end{pmatrix}\sigma_{S}\left(\begin{pmatrix}\boldsymbol{X}^{\top}&amp;\boldsymbol{Y}^{\top}\end{pmatrix}\boldsymbol{W}_{K,h,2}^{(prl){\top}}\boldsymbol{W}_{Q,h,2}^{(prl)}\begin{pmatrix}\boldsymbol{X}\\
\boldsymbol{Y}\end{pmatrix}\right)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="S5.Ex307"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S5.Ex307.m1" class="ltx_Math" alttext="\displaystyle=\begin{pmatrix}\boldsymbol{0}_{d^{(1)}\times n}\\
\boldsymbol{W}_{O,h}^{(2)}\boldsymbol{W}_{V,h}^{(2)}\boldsymbol{Y}\sigma_{S}\left(\boldsymbol{Y}^{\top}\boldsymbol{W}_{K,h}^{(2){\top}}\boldsymbol{W}_{Q,h}^{(2)}\boldsymbol{Y}\right)\end{pmatrix}." display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>=</mo><mrow><mo>(</mo><mtable rowspacing="0pt"><mtr><mtd><msub><mn>𝟎</mn><mrow><msup><mi>d</mi><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msup><mo lspace="0.222em" rspace="0.222em">×</mo><mi>n</mi></mrow></msub></mtd></mtr><mtr><mtd><mrow><msubsup><mi>𝑾</mi><mrow><mi>O</mi><mo>,</mo><mi>h</mi></mrow><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝑾</mi><mrow><mi>V</mi><mo>,</mo><mi>h</mi></mrow><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>𝒀</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>σ</mi><mi>S</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><msup><mi>𝒀</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝑾</mi><mrow><mi>K</mi><mo>,</mo><mi>h</mi></mrow><mrow><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow><mo lspace="0.222em">⊤</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝑾</mi><mrow><mi>Q</mi><mo>,</mo><mi>h</mi></mrow><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>𝒀</mi></mrow><mo>)</mo></mrow></mrow></mtd></mtr></mtable><mo>)</mo></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle=\begin{pmatrix}\boldsymbol{0}_{d^{(1)}\times n}\\
\boldsymbol{W}_{O,h}^{(2)}\boldsymbol{W}_{V,h}^{(2)}\boldsymbol{Y}\sigma_{S}\left(\boldsymbol{Y}^{\top}\boldsymbol{W}_{K,h}^{(2){\top}}\boldsymbol{W}_{Q,h}^{(2)}\boldsymbol{Y}\right)\end{pmatrix}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S5.p1.9" class="ltx_p">Therefore,</p>
<table id="S5.EGx196" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="S5.Ex308"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S5.Ex308.m1" class="ltx_Math" alttext="\displaystyle{\boldsymbol{\mathcal{F}}}_{SA}^{(prl)}\left(\begin{pmatrix}\boldsymbol{X}\\
\boldsymbol{Y}\end{pmatrix}\right)" display="inline" intent=":literal"><semantics><mrow><msubsup><mi class="ltx_font_mathcaligraphic">𝓕</mi><mrow><mi>S</mi><mo lspace="0em" rspace="0em">​</mo><mi>A</mi></mrow><mrow><mo stretchy="false">(</mo><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>l</mi></mrow><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mo>(</mo><mtable rowspacing="0pt"><mtr><mtd><mi>𝑿</mi></mtd></mtr><mtr><mtd><mi>𝒀</mi></mtd></mtr></mtable><mo>)</mo></mrow><mo>)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle{\boldsymbol{\mathcal{F}}}_{SA}^{(prl)}\left(\begin{pmatrix}\boldsymbol{X}\\
\boldsymbol{Y}\end{pmatrix}\right)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="S5.Ex309"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S5.Ex309.m1" class="ltx_Math" alttext="\displaystyle:=\begin{pmatrix}\boldsymbol{X}\\
\boldsymbol{Y}\end{pmatrix}+\sum_{h=1}^{H^{(1)}}\boldsymbol{W}_{O,h,1}^{(prl)}\boldsymbol{W}_{V,h,1}^{(prl)}\begin{pmatrix}\boldsymbol{X}\\
\boldsymbol{Y}\end{pmatrix}\sigma_{S}\left(\begin{pmatrix}\boldsymbol{X}^{\top}&amp;\boldsymbol{Y}^{\top}\end{pmatrix}\boldsymbol{W}_{K,h,1}^{(prl){\top}}\boldsymbol{W}_{Q,h,1}^{(prl)}\begin{pmatrix}\boldsymbol{X}\\
\boldsymbol{Y}\end{pmatrix}\right)" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><mo>(</mo><mtable rowspacing="0pt"><mtr><mtd><mi>𝑿</mi></mtd></mtr><mtr><mtd><mi>𝒀</mi></mtd></mtr></mtable><mo>)</mo></mrow><mo>+</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>h</mi><mo>=</mo><mn>1</mn></mrow><msup><mi>H</mi><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msup></munderover></mstyle><mrow><msubsup><mi>𝑾</mi><mrow><mi>O</mi><mo>,</mo><mi>h</mi><mo>,</mo><mn>1</mn></mrow><mrow><mo stretchy="false">(</mo><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>l</mi></mrow><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝑾</mi><mrow><mi>V</mi><mo>,</mo><mi>h</mi><mo>,</mo><mn>1</mn></mrow><mrow><mo stretchy="false">(</mo><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>l</mi></mrow><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mtable rowspacing="0pt"><mtr><mtd><mi>𝑿</mi></mtd></mtr><mtr><mtd><mi>𝒀</mi></mtd></mtr></mtable><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>σ</mi><mi>S</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mrow><mo>(</mo><mtable columnspacing="5pt"><mtr><mtd><msup><mi>𝑿</mi><mo>⊤</mo></msup></mtd><mtd><msup><mi>𝒀</mi><mo>⊤</mo></msup></mtd></mtr></mtable><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝑾</mi><mrow><mi>K</mi><mo>,</mo><mi>h</mi><mo>,</mo><mn>1</mn></mrow><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>l</mi></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0.222em">⊤</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝑾</mi><mrow><mi>Q</mi><mo>,</mo><mi>h</mi><mo>,</mo><mn>1</mn></mrow><mrow><mo stretchy="false">(</mo><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>l</mi></mrow><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mtable rowspacing="0pt"><mtr><mtd><mi>𝑿</mi></mtd></mtr><mtr><mtd><mi>𝒀</mi></mtd></mtr></mtable><mo>)</mo></mrow></mrow><mo>)</mo></mrow></mrow></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle:=\begin{pmatrix}\boldsymbol{X}\\
\boldsymbol{Y}\end{pmatrix}+\sum_{h=1}^{H^{(1)}}\boldsymbol{W}_{O,h,1}^{(prl)}\boldsymbol{W}_{V,h,1}^{(prl)}\begin{pmatrix}\boldsymbol{X}\\
\boldsymbol{Y}\end{pmatrix}\sigma_{S}\left(\begin{pmatrix}\boldsymbol{X}^{\top}&amp;\boldsymbol{Y}^{\top}\end{pmatrix}\boldsymbol{W}_{K,h,1}^{(prl){\top}}\boldsymbol{W}_{Q,h,1}^{(prl)}\begin{pmatrix}\boldsymbol{X}\\
\boldsymbol{Y}\end{pmatrix}\right)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="S5.Ex310"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S5.Ex310.m1" class="ltx_math_unparsed" alttext="\displaystyle\qquad+\sum_{h=1}^{H^{(2)}}\boldsymbol{W}_{O,h,2}^{(prl)}\boldsymbol{W}_{V,h,2}^{(prl)}\begin{pmatrix}\boldsymbol{X}\\
\boldsymbol{Y}\end{pmatrix}\sigma_{S}\left(\begin{pmatrix}\boldsymbol{X}^{\top}&amp;\boldsymbol{Y}^{\top}\end{pmatrix}\boldsymbol{W}_{K,h,2}^{(prl){\top}}\boldsymbol{W}_{Q,h,2}^{(prl)}\begin{pmatrix}\boldsymbol{X}\\
\boldsymbol{Y}\end{pmatrix}\right)" display="inline" intent=":literal"><semantics><mrow><mo>+</mo><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>h</mi><mo>=</mo><mn>1</mn></mrow><msup><mi>H</mi><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msup></munderover></mstyle><msubsup><mi>𝑾</mi><mrow><mi>O</mi><mo>,</mo><mi>h</mi><mo>,</mo><mn>2</mn></mrow><mrow><mo stretchy="false">(</mo><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>l</mi></mrow><mo stretchy="false">)</mo></mrow></msubsup><msubsup><mi>𝑾</mi><mrow><mi>V</mi><mo>,</mo><mi>h</mi><mo>,</mo><mn>2</mn></mrow><mrow><mo stretchy="false">(</mo><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>l</mi></mrow><mo stretchy="false">)</mo></mrow></msubsup><mrow><mo>(</mo><mtable rowspacing="0pt"><mtr><mtd><mi>𝑿</mi></mtd></mtr><mtr><mtd><mi>𝒀</mi></mtd></mtr></mtable><mo>)</mo></mrow><msub><mi>σ</mi><mi>S</mi></msub><mrow><mo>(</mo><mrow><mo>(</mo><mtable columnspacing="5pt"><mtr><mtd><msup><mi>𝑿</mi><mo>⊤</mo></msup></mtd><mtd><msup><mi>𝒀</mi><mo>⊤</mo></msup></mtd></mtr></mtable><mo>)</mo></mrow><msubsup><mi>𝑾</mi><mrow><mi>K</mi><mo>,</mo><mi>h</mi><mo>,</mo><mn>2</mn></mrow><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>l</mi></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0.222em">⊤</mo></mrow></msubsup><msubsup><mi>𝑾</mi><mrow><mi>Q</mi><mo>,</mo><mi>h</mi><mo>,</mo><mn>2</mn></mrow><mrow><mo stretchy="false">(</mo><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>l</mi></mrow><mo stretchy="false">)</mo></mrow></msubsup><mrow><mo>(</mo><mtable rowspacing="0pt"><mtr><mtd><mi>𝑿</mi></mtd></mtr><mtr><mtd><mi>𝒀</mi></mtd></mtr></mtable><mo>)</mo></mrow><mo>)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\qquad+\sum_{h=1}^{H^{(2)}}\boldsymbol{W}_{O,h,2}^{(prl)}\boldsymbol{W}_{V,h,2}^{(prl)}\begin{pmatrix}\boldsymbol{X}\\
\boldsymbol{Y}\end{pmatrix}\sigma_{S}\left(\begin{pmatrix}\boldsymbol{X}^{\top}&amp;\boldsymbol{Y}^{\top}\end{pmatrix}\boldsymbol{W}_{K,h,2}^{(prl){\top}}\boldsymbol{W}_{Q,h,2}^{(prl)}\begin{pmatrix}\boldsymbol{X}\\
\boldsymbol{Y}\end{pmatrix}\right)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="S5.Ex311"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S5.Ex311.m1" class="ltx_Math" alttext="\displaystyle=\begin{pmatrix}\boldsymbol{X}\\
\boldsymbol{Y}\end{pmatrix}+\sum_{h=1}^{H^{(1)}}\begin{pmatrix}\boldsymbol{W}_{O,h}^{(1)}\boldsymbol{W}_{V,h}^{(1)}\boldsymbol{X}\sigma_{S}\left(\boldsymbol{X}^{\top}\boldsymbol{W}_{K,h}^{(1){\top}}\boldsymbol{W}_{Q,h}^{(1)}\boldsymbol{X}\right)\\
\boldsymbol{0}_{d^{(2)}\times n}\end{pmatrix}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><mo>(</mo><mtable rowspacing="0pt"><mtr><mtd><mi>𝑿</mi></mtd></mtr><mtr><mtd><mi>𝒀</mi></mtd></mtr></mtable><mo>)</mo></mrow><mo>+</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>h</mi><mo>=</mo><mn>1</mn></mrow><msup><mi>H</mi><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msup></munderover></mstyle><mrow><mo>(</mo><mtable rowspacing="0pt"><mtr><mtd><mrow><msubsup><mi>𝑾</mi><mrow><mi>O</mi><mo>,</mo><mi>h</mi></mrow><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝑾</mi><mrow><mi>V</mi><mo>,</mo><mi>h</mi></mrow><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>𝑿</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>σ</mi><mi>S</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><msup><mi>𝑿</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝑾</mi><mrow><mi>K</mi><mo>,</mo><mi>h</mi></mrow><mrow><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow><mo lspace="0.222em">⊤</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝑾</mi><mrow><mi>Q</mi><mo>,</mo><mi>h</mi></mrow><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>𝑿</mi></mrow><mo>)</mo></mrow></mrow></mtd></mtr><mtr><mtd><msub><mn>𝟎</mn><mrow><msup><mi>d</mi><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msup><mo lspace="0.222em" rspace="0.222em">×</mo><mi>n</mi></mrow></msub></mtd></mtr></mtable><mo>)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\begin{pmatrix}\boldsymbol{X}\\
\boldsymbol{Y}\end{pmatrix}+\sum_{h=1}^{H^{(1)}}\begin{pmatrix}\boldsymbol{W}_{O,h}^{(1)}\boldsymbol{W}_{V,h}^{(1)}\boldsymbol{X}\sigma_{S}\left(\boldsymbol{X}^{\top}\boldsymbol{W}_{K,h}^{(1){\top}}\boldsymbol{W}_{Q,h}^{(1)}\boldsymbol{X}\right)\\
\boldsymbol{0}_{d^{(2)}\times n}\end{pmatrix}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="S5.Ex312"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S5.Ex312.m1" class="ltx_math_unparsed" alttext="\displaystyle\qquad+\sum_{h=1}^{H^{(2)}}\begin{pmatrix}\boldsymbol{0}_{d^{(1)}\times n}\\
\boldsymbol{W}_{O,h}^{(2)}\boldsymbol{W}_{V,h}^{(2)}\boldsymbol{Y}\sigma_{S}\left(\boldsymbol{Y}^{\top}\boldsymbol{W}_{K,h}^{(2){\top}}\boldsymbol{W}_{Q,h}^{(2)}\boldsymbol{Y}\right)\end{pmatrix}" display="inline" intent=":literal"><semantics><mrow><mo>+</mo><mstyle displaystyle="true"><mo movablelimits="false">∑</mo></mstyle><msub><mrow></mrow><mrow><mi>h</mi><mo>=</mo><mn>1</mn></mrow></msub><msup><mrow></mrow><msup><mi>H</mi><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msup></msup><mrow><mo>(</mo><mtable rowspacing="0pt"><mtr><mtd><msub><mn>𝟎</mn><mrow><msup><mi>d</mi><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msup><mo lspace="0.222em" rspace="0.222em">×</mo><mi>n</mi></mrow></msub></mtd></mtr><mtr><mtd><mrow><msubsup><mi>𝑾</mi><mrow><mi>O</mi><mo>,</mo><mi>h</mi></mrow><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝑾</mi><mrow><mi>V</mi><mo>,</mo><mi>h</mi></mrow><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>𝒀</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>σ</mi><mi>S</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><msup><mi>𝒀</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝑾</mi><mrow><mi>K</mi><mo>,</mo><mi>h</mi></mrow><mrow><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow><mo lspace="0.222em">⊤</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝑾</mi><mrow><mi>Q</mi><mo>,</mo><mi>h</mi></mrow><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>𝒀</mi></mrow><mo>)</mo></mrow></mrow></mtd></mtr></mtable><mo>)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\qquad+\sum_{h=1}^{H^{(2)}}\begin{pmatrix}\boldsymbol{0}_{d^{(1)}\times n}\\
\boldsymbol{W}_{O,h}^{(2)}\boldsymbol{W}_{V,h}^{(2)}\boldsymbol{Y}\sigma_{S}\left(\boldsymbol{Y}^{\top}\boldsymbol{W}_{K,h}^{(2){\top}}\boldsymbol{W}_{Q,h}^{(2)}\boldsymbol{Y}\right)\end{pmatrix}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="S5.Ex313"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S5.Ex313.m1" class="ltx_Math" alttext="\displaystyle=\begin{pmatrix}\boldsymbol{\mathcal{F}}_{SA}^{(1)}(\boldsymbol{X})\\
\boldsymbol{\mathcal{F}}_{SA}^{(2)}(\boldsymbol{Y})\end{pmatrix}." display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>=</mo><mrow><mo>(</mo><mtable rowspacing="0pt"><mtr><mtd><mrow><msubsup><mi class="ltx_font_mathcaligraphic">𝓕</mi><mrow><mi>S</mi><mo lspace="0em" rspace="0em">​</mo><mi>A</mi></mrow><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝑿</mi><mo stretchy="false">)</mo></mrow></mrow></mtd></mtr><mtr><mtd><mrow><msubsup><mi class="ltx_font_mathcaligraphic">𝓕</mi><mrow><mi>S</mi><mo lspace="0em" rspace="0em">​</mo><mi>A</mi></mrow><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝒀</mi><mo stretchy="false">)</mo></mrow></mrow></mtd></mtr></mtable><mo>)</mo></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle=\begin{pmatrix}\boldsymbol{\mathcal{F}}_{SA}^{(1)}(\boldsymbol{X})\\
\boldsymbol{\mathcal{F}}_{SA}^{(2)}(\boldsymbol{Y})\end{pmatrix}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S5.p1.10" class="ltx_p">(3) A direct corollary from (1) and (2).</p>
</div>
</section>
<section id="S6" class="ltx_section">
<h2 class="ltx_title ltx_title_section"><span class="ltx_tag ltx_tag_section">6 </span>Proof of Proposition <a href="#Thmproposition2" title="Proposition 2. ‣ 2.3 Proof of Theorem ‣ 2 Proofs of Main Results ‣ Standard Transformers Achieve the Minimax Rate in Nonparametric Regression with 𝐶^{𝑠,𝜆} Targets" class="ltx_ref"><span class="ltx_text ltx_ref_tag">2</span></a></h2>

<div id="S6.p1" class="ltx_para">
<p id="S6.p1.1" class="ltx_p">Our proof of Proposition <a href="#Thmproposition2" title="Proposition 2. ‣ 2.3 Proof of Theorem ‣ 2 Proofs of Main Results ‣ Standard Transformers Achieve the Minimax Rate in Nonparametric Regression with 𝐶^{𝑠,𝜆} Targets" class="ltx_ref"><span class="ltx_text ltx_ref_tag">2</span></a> follows techniques developed in <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib49" title="" class="ltx_ref">49</a>, <a href="#bib.bib35" title="" class="ltx_ref">35</a>, <a href="#bib.bib55" title="" class="ltx_ref">55</a>]</cite>. Before proving it, we first list the relevant concepts and results from probability theory that will be used in the proof. In the definitions and lemmas below, <math id="S6.p1.m1" class="ltx_Math" alttext="T" display="inline" intent=":literal"><semantics><mi>T</mi><annotation encoding="application/x-tex">T</annotation></semantics></math> is a set in the metric space <math id="S6.p1.m2" class="ltx_Math" alttext="(\bar{T},\tau)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mover accent="true"><mi>T</mi><mo>¯</mo></mover><mo>,</mo><mi>τ</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(\bar{T},\tau)</annotation></semantics></math>.</p>
</div>
<div id="Thmlemma21" class="ltx_theorem ltx_theorem_lemma">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="Thmlemma21.2" class="ltx_text ltx_font_bold">Lemma 21</span></span><span id="Thmlemma21.3" class="ltx_text ltx_font_bold"> </span>(Bernstein’s inequality)<span id="Thmlemma21.4" class="ltx_text ltx_font_bold">.</span></h6>
<div id="Thmlemma21.p1" class="ltx_para">
<p id="Thmlemma21.p1.1" class="ltx_p"><span id="Thmlemma21.p1.1.1" class="ltx_text ltx_font_italic">For i.i.d. random variables <math id="Thmlemma21.p1.m1" class="ltx_Math" alttext="\{Z_{i}\}_{i=1}^{m}" display="inline" intent=":literal"><semantics><msubsup><mrow><mo stretchy="false">{</mo><msub><mi>Z</mi><mi>i</mi></msub><mo stretchy="false">}</mo></mrow><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>m</mi></msubsup><annotation encoding="application/x-tex">\{Z_{i}\}_{i=1}^{m}</annotation></semantics></math> satisfying <math id="Thmlemma21.p1.m2" class="ltx_Math" alttext="|Z_{i}|\leq c,\ E[Z_{i}]=0,\ \operatorname{Var}(Z_{i})=\sigma^{2}" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mo stretchy="false">|</mo><msub><mi>Z</mi><mi>i</mi></msub><mo stretchy="false">|</mo></mrow><mo>≤</mo><mi>c</mi></mrow><mo rspace="0.667em">,</mo><mrow><mrow><mi>E</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><msub><mi>Z</mi><mi>i</mi></msub><mo stretchy="false">]</mo></mrow></mrow><mo>=</mo><mn>0</mn></mrow><mo rspace="0.667em">,</mo><mrow><mrow><mi>Var</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>Z</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><msup><mi>σ</mi><mn>2</mn></msup></mrow></mrow><annotation encoding="application/x-tex">|Z_{i}|\leq c,\ E[Z_{i}]=0,\ \operatorname{Var}(Z_{i})=\sigma^{2}</annotation></semantics></math>, it holds that</span></p>
<table id="S6.EGx197" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="S6.Ex314"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S6.Ex314.m1" class="ltx_Math" alttext="\displaystyle\mathbb{P}\left(\left|\frac{1}{m}\sum_{i=1}^{m}{Z_{i}}\right|\geq u\right)\leq\exp\left(-\frac{mu^{2}}{2\sigma^{2}+2cu/3}\right)" display="inline" intent=":literal"><semantics><mrow><mrow><mi>ℙ</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mrow><mo>|</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>m</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>m</mi></munderover></mstyle><msub><mi>Z</mi><mi>i</mi></msub></mrow></mrow><mo>|</mo></mrow><mo>≥</mo><mi>u</mi></mrow><mo>)</mo></mrow></mrow><mo>≤</mo><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mo>−</mo><mstyle displaystyle="true"><mfrac><mrow><mi>m</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>u</mi><mn>2</mn></msup></mrow><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msup><mi>σ</mi><mn>2</mn></msup></mrow><mo>+</mo><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>c</mi><mo lspace="0em" rspace="0em">​</mo><mi>u</mi></mrow><mo>/</mo><mn>3</mn></mrow></mrow></mfrac></mstyle></mrow><mo>)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\mathbb{P}\left(\left|\frac{1}{m}\sum_{i=1}^{m}{Z_{i}}\right|\geq u\right)\leq\exp\left(-\frac{mu^{2}}{2\sigma^{2}+2cu/3}\right)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="Thmlemma21.p1.2" class="ltx_p"><span id="Thmlemma21.p1.2.1" class="ltx_text ltx_font_italic">for any <math id="Thmlemma21.p1.m3" class="ltx_Math" alttext="u&gt;0" display="inline" intent=":literal"><semantics><mrow><mi>u</mi><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">u&gt;0</annotation></semantics></math>.</span></p>
</div>
</div>
<div id="Thmdefinition4" class="ltx_theorem ltx_theorem_definition">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="Thmdefinition4.2" class="ltx_text ltx_font_bold">Definition 4</span></span><span id="Thmdefinition4.3" class="ltx_text ltx_font_bold"> </span>(Gaussian process)<span id="Thmdefinition4.4" class="ltx_text ltx_font_bold">.</span></h6>
<div id="Thmdefinition4.p1" class="ltx_para">
<p id="Thmdefinition4.p1.1" class="ltx_p"><span id="Thmdefinition4.p1.1.1" class="ltx_text ltx_font_italic">A stochastic process <math id="Thmdefinition4.p1.m1" class="ltx_Math" alttext="\{X(t)\}_{t\in T}" display="inline" intent=":literal"><semantics><msub><mrow><mo stretchy="false">{</mo><mrow><mi>X</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">}</mo></mrow><mrow><mi>t</mi><mo>∈</mo><mi>T</mi></mrow></msub><annotation encoding="application/x-tex">\{X(t)\}_{t\in T}</annotation></semantics></math> is a Gaussian process if for all <math id="Thmdefinition4.p1.m2" class="ltx_Math" alttext="n\in\mathbb{N}" display="inline" intent=":literal"><semantics><mrow><mi>n</mi><mo>∈</mo><mi>ℕ</mi></mrow><annotation encoding="application/x-tex">n\in\mathbb{N}</annotation></semantics></math>, <math id="Thmdefinition4.p1.m3" class="ltx_Math" alttext="a_{i}\in\mathbb{R}" display="inline" intent=":literal"><semantics><mrow><msub><mi>a</mi><mi>i</mi></msub><mo>∈</mo><mi>ℝ</mi></mrow><annotation encoding="application/x-tex">a_{i}\in\mathbb{R}</annotation></semantics></math> and <math id="Thmdefinition4.p1.m4" class="ltx_Math" alttext="t_{i}\in T" display="inline" intent=":literal"><semantics><mrow><msub><mi>t</mi><mi>i</mi></msub><mo>∈</mo><mi>T</mi></mrow><annotation encoding="application/x-tex">t_{i}\in T</annotation></semantics></math>, the random variable <math id="Thmdefinition4.p1.m5" class="ltx_Math" alttext="\sum_{i=1}^{n}a_{i}X(t_{i})" display="inline" intent=":literal"><semantics><mrow><msubsup><mo>∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>n</mi></msubsup><mrow><msub><mi>a</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi>X</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>t</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\sum_{i=1}^{n}a_{i}X(t_{i})</annotation></semantics></math> is normal or, equivalently, if all the finite-dimensional marginals of <math id="Thmdefinition4.p1.m6" class="ltx_Math" alttext="X" display="inline" intent=":literal"><semantics><mi>X</mi><annotation encoding="application/x-tex">X</annotation></semantics></math> are multivariate normal. <math id="Thmdefinition4.p1.m7" class="ltx_Math" alttext="X" display="inline" intent=":literal"><semantics><mi>X</mi><annotation encoding="application/x-tex">X</annotation></semantics></math> is a centred Gaussian process if all these random variables are normal with mean zero.</span></p>
</div>
</div>
<div id="Thmdefinition5" class="ltx_theorem ltx_theorem_definition">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="Thmdefinition5.2" class="ltx_text ltx_font_bold">Definition 5</span></span><span id="Thmdefinition5.3" class="ltx_text ltx_font_bold"> </span>(Sub-gaussian variable and sub-gaussian process)<span id="Thmdefinition5.4" class="ltx_text ltx_font_bold">.</span></h6>
<div id="Thmdefinition5.p1" class="ltx_para">
<p id="Thmdefinition5.p1.1" class="ltx_p"><span id="Thmdefinition5.p1.1.1" class="ltx_text ltx_font_italic">A square integrable random variable <math id="Thmdefinition5.p1.m1" class="ltx_Math" alttext="\xi" display="inline" intent=":literal"><semantics><mi>ξ</mi><annotation encoding="application/x-tex">\xi</annotation></semantics></math> is said to be sub-gaussian with parameter <math id="Thmdefinition5.p1.m2" class="ltx_Math" alttext="\sigma&gt;0" display="inline" intent=":literal"><semantics><mrow><mi>σ</mi><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\sigma&gt;0</annotation></semantics></math>
if for all <math id="Thmdefinition5.p1.m3" class="ltx_Math" alttext="\lambda\in\mathbb{R}" display="inline" intent=":literal"><semantics><mrow><mi>λ</mi><mo>∈</mo><mi>ℝ</mi></mrow><annotation encoding="application/x-tex">\lambda\in\mathbb{R}</annotation></semantics></math>,</span></p>
<table id="S6.Ex315" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S6.Ex315.m1" class="ltx_Math" alttext="\mathbb{E}e^{\lambda\xi}\leq e^{\lambda^{2}\sigma^{2}/2}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mi>𝔼</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>e</mi><mrow><mi>λ</mi><mo lspace="0em" rspace="0em">​</mo><mi>ξ</mi></mrow></msup></mrow><mo>≤</mo><msup><mi>e</mi><mrow><mrow><msup><mi>λ</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>σ</mi><mn>2</mn></msup></mrow><mo>/</mo><mn>2</mn></mrow></msup></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\mathbb{E}e^{\lambda\xi}\leq e^{\lambda^{2}\sigma^{2}/2}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="Thmdefinition5.p1.2" class="ltx_p"><span id="Thmdefinition5.p1.2.1" class="ltx_text ltx_font_italic">A centred stochastic process <math id="Thmdefinition5.p1.m4" class="ltx_Math" alttext="\{X(t)\}_{t\in T}" display="inline" intent=":literal"><semantics><msub><mrow><mo stretchy="false">{</mo><mrow><mi>X</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">}</mo></mrow><mrow><mi>t</mi><mo>∈</mo><mi>T</mi></mrow></msub><annotation encoding="application/x-tex">\{X(t)\}_{t\in T}</annotation></semantics></math> is sub-gaussian relative to <math id="Thmdefinition5.p1.m5" class="ltx_Math" alttext="\tau" display="inline" intent=":literal"><semantics><mi>τ</mi><annotation encoding="application/x-tex">\tau</annotation></semantics></math> if its increments satisfy the sub-gaussian inequality:</span></p>
<table id="S6.Ex316" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S6.Ex316.m1" class="ltx_math_unparsed" alttext="\mathbb{E}e^{\lambda(X(t)-X(s))}\leq e^{\lambda^{2}\tau^{2}(s,t)/2},\quad\lambda\in\mathbb{R},\;s,t\in T." display="block" intent=":literal"><semantics><mrow><mi>𝔼</mi><mi>e</mi><msup><mrow></mrow><mrow><mi>λ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mi>X</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mi>X</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>s</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></msup><mo>≤</mo><mi>e</mi><msup><mrow></mrow><mrow><mrow><msup><mi>λ</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>τ</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>s</mi><mo>,</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo>/</mo><mn>2</mn></mrow></msup><mo rspace="1.167em">,</mo><mi>λ</mi><mo>∈</mo><mi>ℝ</mi><mo rspace="0.447em">,</mo><mi>s</mi><mo>,</mo><mi>t</mi><mo>∈</mo><mi>T</mi><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\mathbb{E}e^{\lambda(X(t)-X(s))}\leq e^{\lambda^{2}\tau^{2}(s,t)/2},\quad\lambda\in\mathbb{R},\;s,t\in T.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
</div>
<div id="Thmlemma22" class="ltx_theorem ltx_theorem_lemma">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="Thmlemma22.2" class="ltx_text ltx_font_bold">Lemma 22</span></span><span id="Thmlemma22.3" class="ltx_text ltx_font_bold"> </span>(Borell-Sudakov-Tsirelson concentration inequality)<span id="Thmlemma22.4" class="ltx_text ltx_font_bold">.</span></h6>
<div id="Thmlemma22.p1" class="ltx_para">
<p id="Thmlemma22.p1.1" class="ltx_p"><span id="Thmlemma22.p1.1.1" class="ltx_text ltx_font_italic">Let <math id="Thmlemma22.p1.m1" class="ltx_Math" alttext="\{X(t)\}_{t\in T}" display="inline" intent=":literal"><semantics><msub><mrow><mo stretchy="false">{</mo><mrow><mi>X</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">}</mo></mrow><mrow><mi>t</mi><mo>∈</mo><mi>T</mi></mrow></msub><annotation encoding="application/x-tex">\{X(t)\}_{t\in T}</annotation></semantics></math> be a separable centred Gaussian process. Suppose <math id="Thmlemma22.p1.m2" class="ltx_Math" alttext="\mathbb{E}\sup_{t\in T}|X(t)|&lt;\infty,\sigma^{2}:=\sup_{t\in T}\mathbb{E}X^{2}(t)&lt;\infty" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mi>𝔼</mi><mo lspace="0.167em" rspace="0em">​</mo><mrow><msub><mo rspace="0em">sup</mo><mrow><mi>t</mi><mo>∈</mo><mi>T</mi></mrow></msub><mrow><mo stretchy="false">|</mo><mrow><mi>X</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">|</mo></mrow></mrow></mrow><mo>&lt;</mo><mi mathvariant="normal">∞</mi></mrow><mo>,</mo><mrow><msup><mi>σ</mi><mn>2</mn></msup><mo rspace="0.1389em">:=</mo><mrow><msub><mo lspace="0.1389em" rspace="0.167em">sup</mo><mrow><mi>t</mi><mo>∈</mo><mi>T</mi></mrow></msub><mrow><mi>𝔼</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>X</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>&lt;</mo><mi mathvariant="normal">∞</mi></mrow></mrow><annotation encoding="application/x-tex">\mathbb{E}\sup_{t\in T}|X(t)|&lt;\infty,\sigma^{2}:=\sup_{t\in T}\mathbb{E}X^{2}(t)&lt;\infty</annotation></semantics></math>. Then,</span></p>
<table id="S6.EGx198" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="S6.Ex317"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S6.Ex317.m1" class="ltx_Math" alttext="\displaystyle\mathbb{P}\left(\sup_{t\in T}|X(t)|\geq\mathbb{E}\sup_{t\in T}|X(t)|+u\right)" display="inline" intent=":literal"><semantics><mrow><mi>ℙ</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mrow><munder><mo lspace="0em" movablelimits="false" rspace="0em">sup</mo><mrow><mi>t</mi><mo>∈</mo><mi>T</mi></mrow></munder><mrow><mo stretchy="false">|</mo><mrow><mi>X</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">|</mo></mrow></mrow><mo>≥</mo><mrow><mrow><mi>𝔼</mi><mo lspace="0.167em" rspace="0em">​</mo><mrow><munder><mo movablelimits="false" rspace="0em">sup</mo><mrow><mi>t</mi><mo>∈</mo><mi>T</mi></mrow></munder><mrow><mo stretchy="false">|</mo><mrow><mi>X</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">|</mo></mrow></mrow></mrow><mo>+</mo><mi>u</mi></mrow></mrow><mo>)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\mathbb{P}\left(\sup_{t\in T}|X(t)|\geq\mathbb{E}\sup_{t\in T}|X(t)|+u\right)</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S6.Ex317.m2" class="ltx_math_unparsed" alttext="\displaystyle\leq e^{-u^{2}/2\sigma^{2}}," display="inline" intent=":literal"><semantics><mrow><mo>≤</mo><mi>e</mi><msup><mrow></mrow><mrow><mo>−</mo><mi>u</mi><msup><mrow></mrow><mn>2</mn></msup><mo>/</mo><mn>2</mn><mi>σ</mi><msup><mrow></mrow><mn>2</mn></msup></mrow></msup><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\leq e^{-u^{2}/2\sigma^{2}},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="S6.Ex318"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S6.Ex318.m1" class="ltx_Math" alttext="\displaystyle\mathbb{P}\left(\sup_{t\in T}|X(t)|\leq\mathbb{E}\sup_{t\in T}|X(t)|-u\right)" display="inline" intent=":literal"><semantics><mrow><mi>ℙ</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mrow><munder><mo lspace="0em" movablelimits="false" rspace="0em">sup</mo><mrow><mi>t</mi><mo>∈</mo><mi>T</mi></mrow></munder><mrow><mo stretchy="false">|</mo><mrow><mi>X</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">|</mo></mrow></mrow><mo>≤</mo><mrow><mrow><mi>𝔼</mi><mo lspace="0.167em" rspace="0em">​</mo><mrow><munder><mo movablelimits="false" rspace="0em">sup</mo><mrow><mi>t</mi><mo>∈</mo><mi>T</mi></mrow></munder><mrow><mo stretchy="false">|</mo><mrow><mi>X</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">|</mo></mrow></mrow></mrow><mo>−</mo><mi>u</mi></mrow></mrow><mo>)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\mathbb{P}\left(\sup_{t\in T}|X(t)|\leq\mathbb{E}\sup_{t\in T}|X(t)|-u\right)</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S6.Ex318.m2" class="ltx_math_unparsed" alttext="\displaystyle\leq e^{-u^{2}/2\sigma^{2}}." display="inline" intent=":literal"><semantics><mrow><mo>≤</mo><mi>e</mi><msup><mrow></mrow><mrow><mo>−</mo><mi>u</mi><msup><mrow></mrow><mn>2</mn></msup><mo>/</mo><mn>2</mn><mi>σ</mi><msup><mrow></mrow><mn>2</mn></msup></mrow></msup><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\leq e^{-u^{2}/2\sigma^{2}}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
</div>
<div id="S6.2" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="S6.p2" class="ltx_para">
<p id="S6.p2.1" class="ltx_p"><span id="S6.p2.1.1" class="ltx_text">See <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib11" title="" class="ltx_ref">11</a>, Theorem 2.5.8]</cite>.
∎</span></p>
</div>
</div>
<div id="Thmlemma23" class="ltx_theorem ltx_theorem_lemma">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="Thmlemma23.2" class="ltx_text ltx_font_bold">Lemma 23</span></span><span id="Thmlemma23.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="Thmlemma23.p1" class="ltx_para">
<p id="Thmlemma23.p1.1" class="ltx_p"><span id="Thmlemma23.p1.1.1" class="ltx_text ltx_font_italic">Let <math id="Thmlemma23.p1.m1" class="ltx_Math" alttext="\{X(t)\}_{t\in T}" display="inline" intent=":literal"><semantics><msub><mrow><mo stretchy="false">{</mo><mrow><mi>X</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">}</mo></mrow><mrow><mi>t</mi><mo>∈</mo><mi>T</mi></mrow></msub><annotation encoding="application/x-tex">\{X(t)\}_{t\in T}</annotation></semantics></math> be a sub-Gaussian process relative to <math id="Thmlemma23.p1.m2" class="ltx_Math" alttext="\tau" display="inline" intent=":literal"><semantics><mi>τ</mi><annotation encoding="application/x-tex">\tau</annotation></semantics></math>. Assume that</span></p>
<table id="S6.Ex319" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S6.Ex319.m1" class="ltx_Math" alttext="\int_{0}^{\infty}\sqrt{\log\mathcal{N}(\epsilon,T,\tau)}\,d\epsilon&lt;\infty." display="block" intent=":literal"><semantics><mrow><mrow><mrow><msubsup><mo>∫</mo><mn>0</mn><mi mathvariant="normal">∞</mi></msubsup><mrow><msqrt><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒩</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>ϵ</mi><mo>,</mo><mi>T</mi><mo>,</mo><mi>τ</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></msqrt><mo lspace="0.170em" rspace="0em">​</mo><mrow><mo rspace="0em">𝑑</mo><mi>ϵ</mi></mrow></mrow></mrow><mo>&lt;</mo><mi mathvariant="normal">∞</mi></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\int_{0}^{\infty}\sqrt{\log\mathcal{N}(\epsilon,T,\tau)}\,d\epsilon&lt;\infty.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="Thmlemma23.p1.2" class="ltx_p"><span id="Thmlemma23.p1.2.1" class="ltx_text ltx_font_italic">Then any separable version of <math id="Thmlemma23.p1.m3" class="ltx_Math" alttext="\{X(t)\}_{t\in T}" display="inline" intent=":literal"><semantics><msub><mrow><mo stretchy="false">{</mo><mrow><mi>X</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">}</mo></mrow><mrow><mi>t</mi><mo>∈</mo><mi>T</mi></mrow></msub><annotation encoding="application/x-tex">\{X(t)\}_{t\in T}</annotation></semantics></math>, that we keep denoting by <math id="Thmlemma23.p1.m4" class="ltx_Math" alttext="X(t)" display="inline" intent=":literal"><semantics><mrow><mi>X</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">X(t)</annotation></semantics></math> satisfies the inequalities</span></p>
<table id="S6.Ex320" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S6.Ex320.m1" class="ltx_Math" alttext="\mathbb{E}\sup_{t\in T}|X(t)|\leq\mathbb{E}|X(t_{0})|+4\sqrt{2}\int_{0}^{D/2}\sqrt{\log 2\mathcal{N}(\epsilon,T,\tau)}\,d\epsilon," display="block" intent=":literal"><semantics><mrow><mrow><mrow><mi>𝔼</mi><mo lspace="0.167em" rspace="0em">​</mo><mrow><munder><mo movablelimits="false" rspace="0em">sup</mo><mrow><mi>t</mi><mo>∈</mo><mi>T</mi></mrow></munder><mrow><mo stretchy="false">|</mo><mrow><mi>X</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">|</mo></mrow></mrow></mrow><mo>≤</mo><mrow><mrow><mi>𝔼</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">|</mo><mrow><mi>X</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>t</mi><mn>0</mn></msub><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">|</mo></mrow></mrow><mo>+</mo><mrow><mn>4</mn><mo lspace="0em" rspace="0em">​</mo><msqrt><mn>2</mn></msqrt><mo lspace="0em" rspace="0em">​</mo><mrow><msubsup><mo>∫</mo><mn>0</mn><mrow><mi>D</mi><mo>/</mo><mn>2</mn></mrow></msubsup><mrow><msqrt><mrow><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mn>2</mn></mrow><mo lspace="0em" rspace="0em">​</mo><mi class="ltx_font_mathcaligraphic">𝒩</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>ϵ</mi><mo>,</mo><mi>T</mi><mo>,</mo><mi>τ</mi><mo stretchy="false">)</mo></mrow></mrow></msqrt><mo lspace="0.170em" rspace="0em">​</mo><mrow><mo rspace="0em">𝑑</mo><mi>ϵ</mi></mrow></mrow></mrow></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\mathbb{E}\sup_{t\in T}|X(t)|\leq\mathbb{E}|X(t_{0})|+4\sqrt{2}\int_{0}^{D/2}\sqrt{\log 2\mathcal{N}(\epsilon,T,\tau)}\,d\epsilon,</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="Thmlemma23.p1.3" class="ltx_p"><span id="Thmlemma23.p1.3.1" class="ltx_text ltx_font_italic">where <math id="Thmlemma23.p1.m5" class="ltx_Math" alttext="t_{0}\in T" display="inline" intent=":literal"><semantics><mrow><msub><mi>t</mi><mn>0</mn></msub><mo>∈</mo><mi>T</mi></mrow><annotation encoding="application/x-tex">t_{0}\in T</annotation></semantics></math>, <math id="Thmlemma23.p1.m6" class="ltx_Math" alttext="D" display="inline" intent=":literal"><semantics><mi>D</mi><annotation encoding="application/x-tex">D</annotation></semantics></math> is the diameter of <math id="Thmlemma23.p1.m7" class="ltx_Math" alttext="T" display="inline" intent=":literal"><semantics><mi>T</mi><annotation encoding="application/x-tex">T</annotation></semantics></math>.</span></p>
</div>
</div>
<div id="S6.3" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="S6.p3" class="ltx_para">
<p id="S6.p3.1" class="ltx_p"><span id="S6.p3.1.1" class="ltx_text">See <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib11" title="" class="ltx_ref">11</a>, Theorem 2.3.7]</cite>.
∎</span></p>
</div>
</div>
<div id="S6.4" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof of Proposition <a href="#Thmproposition2" title="Proposition 2. ‣ 2.3 Proof of Theorem ‣ 2 Proofs of Main Results ‣ Standard Transformers Achieve the Minimax Rate in Nonparametric Regression with 𝐶^{𝑠,𝜆} Targets" class="ltx_ref"><span class="ltx_text ltx_ref_tag">2</span></a>.</h6>
<div id="S6.p4" class="ltx_para">
<p id="S6.p4.1" class="ltx_p"><span id="S6.p4.1.1" class="ltx_text">By the triangle inequality, we have</span></p>
<table id="S6.EGx199" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="S6.E24"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S6.E24.m1" class="ltx_Math" alttext="\displaystyle\left\|\widehat{f}-f_{0}\right\|_{L^{2}(\mu)}^{2}\leq 2\left\|\widehat{f}-f^{*}\right\|_{L^{2}(\mu)}^{2}+2\|f^{*}-f_{0}\|_{L^{2}(\mu)}^{2}," display="inline" intent=":literal"><semantics><mrow><mrow><msubsup><mrow><mo>‖</mo><mrow><mover accent="true"><mi>f</mi><mo>^</mo></mover><mo>−</mo><msub><mi>f</mi><mn>0</mn></msub></mrow><mo>‖</mo></mrow><mrow><msup><mi>L</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>μ</mi><mo stretchy="false">)</mo></mrow></mrow><mn>2</mn></msubsup><mo>≤</mo><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msubsup><mrow><mo>‖</mo><mrow><mover accent="true"><mi>f</mi><mo>^</mo></mover><mo>−</mo><msup><mi>f</mi><mo>∗</mo></msup></mrow><mo>‖</mo></mrow><mrow><msup><mi>L</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>μ</mi><mo stretchy="false">)</mo></mrow></mrow><mn>2</mn></msubsup></mrow><mo>+</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msubsup><mrow><mo stretchy="false">‖</mo><mrow><msup><mi>f</mi><mo>∗</mo></msup><mo>−</mo><msub><mi>f</mi><mn>0</mn></msub></mrow><mo stretchy="false">‖</mo></mrow><mrow><msup><mi>L</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>μ</mi><mo stretchy="false">)</mo></mrow></mrow><mn>2</mn></msubsup></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\left\|\widehat{f}-f_{0}\right\|_{L^{2}(\mu)}^{2}\leq 2\left\|\widehat{f}-f^{*}\right\|_{L^{2}(\mu)}^{2}+2\|f^{*}-f_{0}\|_{L^{2}(\mu)}^{2},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(24)</span></td></tr></tbody>
</table>
<p id="S6.p4.2" class="ltx_p"><span id="S6.p4.2.1" class="ltx_text">where <math id="S6.p4.m1" class="ltx_Math" alttext="f^{*}" display="inline" intent=":literal"><semantics><msup><mi>f</mi><mo>∗</mo></msup><annotation encoding="application/x-tex">f^{*}</annotation></semantics></math> can be any function in <math id="S6.p4.m2" class="ltx_Math" alttext="\mathcal{F}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">ℱ</mi><annotation encoding="application/x-tex">\mathcal{F}</annotation></semantics></math>. For the remainder of the proof, we primarily focus on deriving an upper bound for <math id="S6.p4.m3" class="ltx_Math" alttext="\left\|\widehat{f}-f^{*}\right\|_{L^{2}(\mu)}^{2}" display="inline" intent=":literal"><semantics><msubsup><mrow><mo>‖</mo><mrow><mover accent="true"><mi>f</mi><mo>^</mo></mover><mo>−</mo><msup><mi>f</mi><mo>∗</mo></msup></mrow><mo>‖</mo></mrow><mrow><msup><mi>L</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>μ</mi><mo stretchy="false">)</mo></mrow></mrow><mn>2</mn></msubsup><annotation encoding="application/x-tex">\left\|\widehat{f}-f^{*}\right\|_{L^{2}(\mu)}^{2}</annotation></semantics></math>. To this end, we first control <math id="S6.p4.m4" class="ltx_Math" alttext="\left\|\widehat{f}-f^{*}\right\|_{L^{2}(\mu)}^{2}" display="inline" intent=":literal"><semantics><msubsup><mrow><mo>‖</mo><mrow><mover accent="true"><mi>f</mi><mo>^</mo></mover><mo>−</mo><msup><mi>f</mi><mo>∗</mo></msup></mrow><mo>‖</mo></mrow><mrow><msup><mi>L</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>μ</mi><mo stretchy="false">)</mo></mrow></mrow><mn>2</mn></msubsup><annotation encoding="application/x-tex">\left\|\widehat{f}-f^{*}\right\|_{L^{2}(\mu)}^{2}</annotation></semantics></math> by its empirical counterpart <math id="S6.p4.m5" class="ltx_Math" alttext="\left\|\widehat{f}-f^{*}\right\|_{m}^{2}:=\frac{1}{m}\sum_{i=1}^{m}\left|\widehat{f}(X_{i})-f^{*}(X_{i})\right|^{2}" display="inline" intent=":literal"><semantics><mrow><msubsup><mrow><mo>‖</mo><mrow><mover accent="true"><mi>f</mi><mo>^</mo></mover><mo>−</mo><msup><mi>f</mi><mo>∗</mo></msup></mrow><mo>‖</mo></mrow><mi>m</mi><mn>2</mn></msubsup><mo>:=</mo><mrow><mfrac><mn>1</mn><mi>m</mi></mfrac><mo lspace="0em" rspace="0em">​</mo><mrow><msubsup><mo rspace="0em">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>m</mi></msubsup><msup><mrow><mo>|</mo><mrow><mrow><mover accent="true"><mi>f</mi><mo>^</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>X</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msup><mi>f</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>X</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>|</mo></mrow><mn>2</mn></msup></mrow></mrow></mrow><annotation encoding="application/x-tex">\left\|\widehat{f}-f^{*}\right\|_{m}^{2}:=\frac{1}{m}\sum_{i=1}^{m}\left|\widehat{f}(X_{i})-f^{*}(X_{i})\right|^{2}</annotation></semantics></math>, and then derive an upper bound for <math id="S6.p4.m6" class="ltx_Math" alttext="\left\|\widehat{f}-f^{*}\right\|_{m}^{2}" display="inline" intent=":literal"><semantics><msubsup><mrow><mo>‖</mo><mrow><mover accent="true"><mi>f</mi><mo>^</mo></mover><mo>−</mo><msup><mi>f</mi><mo>∗</mo></msup></mrow><mo>‖</mo></mrow><mi>m</mi><mn>2</mn></msubsup><annotation encoding="application/x-tex">\left\|\widehat{f}-f^{*}\right\|_{m}^{2}</annotation></semantics></math> by evaluating a variance term.</span></p>
</div>
<div id="S6.p5" class="ltx_para">
<p id="S6.p5.1" class="ltx_p"><span id="S6.p5.1.1" class="ltx_text ltx_font_bold">Step 1: Upper Bound of <math id="S6.p5.m1" class="ltx_Math" alttext="\left\|\widehat{f}-f^{*}\right\|_{L^{2}(\mu)}^{2}" display="inline" intent=":literal"><semantics><msubsup><mrow><mo>‖</mo><mrow><mover accent="true"><mi>f</mi><mo>^</mo></mover><mo>−</mo><msup><mi>f</mi><mo>∗</mo></msup></mrow><mo>‖</mo></mrow><mrow><msup><mi>L</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>μ</mi><mo stretchy="false">)</mo></mrow></mrow><mn>2</mn></msubsup><annotation encoding="application/x-tex">\left\|\widehat{f}-f^{*}\right\|_{L^{2}(\mu)}^{2}</annotation></semantics></math>.<span id="S6.p5.1.1.1" class="ltx_text"></span></span></p>
</div>
<div id="S6.p6" class="ltx_para">
<p id="S6.p6.1" class="ltx_p"><span id="S6.p6.1.1" class="ltx_text">Denote <math id="S6.p6.m1" class="ltx_math_unparsed" alttext="N=\mathcal{N}(m^{-\gamma/(2\gamma+d)},\mathcal{F},\|\cdot\|_{L^{\infty}(\mu)})" display="inline" intent=":literal"><semantics><mrow><mi>N</mi><mo>=</mo><mi class="ltx_font_mathcaligraphic">𝒩</mi><mrow><mo stretchy="false">(</mo><msup><mi>m</mi><mrow><mo>−</mo><mi>γ</mi><mo>/</mo><mo stretchy="false">(</mo><mn>2</mn><mi>γ</mi><mo>+</mo><mi>d</mi><mo stretchy="false">)</mo></mrow></msup><mo>,</mo><mi class="ltx_font_mathcaligraphic">ℱ</mi><mo>,</mo><mo lspace="0em" rspace="0em">∥</mo><mo lspace="0em" rspace="0em">⋅</mo><msub><mo lspace="0em" rspace="0.167em">∥</mo><mrow><msup><mi>L</mi><mi mathvariant="normal">∞</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>μ</mi><mo stretchy="false">)</mo></mrow></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">N=\mathcal{N}(m^{-\gamma/(2\gamma+d)},\mathcal{F},\|\cdot\|_{L^{\infty}(\mu)})</annotation></semantics></math>, and let <math id="S6.p6.m2" class="ltx_Math" alttext="\{f_{1},\ldots,f_{N}\}" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">{</mo><msub><mi>f</mi><mn>1</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>f</mi><mi>N</mi></msub><mo stretchy="false">}</mo></mrow><annotation encoding="application/x-tex">\{f_{1},\ldots,f_{N}\}</annotation></semantics></math> be a set of centers of the minimal <math id="S6.p6.m3" class="ltx_math_unparsed" alttext="m^{-\gamma/(2\gamma+d)}" display="inline" intent=":literal"><semantics><mrow><mi>m</mi><msup><mrow></mrow><mrow><mo>−</mo><mi>γ</mi><mo>/</mo><mo stretchy="false">(</mo><mn>2</mn><mi>γ</mi><mo>+</mo><mi>d</mi><mo stretchy="false">)</mo></mrow></msup></mrow><annotation encoding="application/x-tex">m^{-\gamma/(2\gamma+d)}</annotation></semantics></math>-cover of <math id="S6.p6.m4" class="ltx_Math" alttext="\mathcal{F}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">ℱ</mi><annotation encoding="application/x-tex">\mathcal{F}</annotation></semantics></math> with <math id="S6.p6.m5" class="ltx_math_unparsed" alttext="\|\cdot\|_{L^{\infty}(\mu)}" display="inline" intent=":literal"><semantics><mrow><mo rspace="0em">∥</mo><mo lspace="0em" rspace="0em">⋅</mo><mo lspace="0em">∥</mo><msub><mrow></mrow><mrow><msup><mi>L</mi><mi mathvariant="normal">∞</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>μ</mi><mo stretchy="false">)</mo></mrow></mrow></msub></mrow><annotation encoding="application/x-tex">\|\cdot\|_{L^{\infty}(\mu)}</annotation></semantics></math> norm. Suppose <math id="S6.p6.m6" class="ltx_Math" alttext="f_{j^{\prime}}\in\{f_{1},\ldots,f_{N}\}" display="inline" intent=":literal"><semantics><mrow><msub><mi>f</mi><msup><mi>j</mi><mo>′</mo></msup></msub><mo>∈</mo><mrow><mo stretchy="false">{</mo><msub><mi>f</mi><mn>1</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>f</mi><mi>N</mi></msub><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">f_{j^{\prime}}\in\{f_{1},\ldots,f_{N}\}</annotation></semantics></math> satisfies <math id="S6.p6.m7" class="ltx_math_unparsed" alttext="\left\|\widehat{f}-f_{j^{\prime}}\right\|_{L^{\infty}(\mu)}\leq m^{-\gamma/(2\gamma+d)}" display="inline" intent=":literal"><semantics><mrow><msub><mrow><mo>‖</mo><mover accent="true"><mi>f</mi><mo>^</mo></mover><mo>−</mo><msub><mi>f</mi><msup><mi>j</mi><mo>′</mo></msup></msub><mo>‖</mo></mrow><mrow><msup><mi>L</mi><mi mathvariant="normal">∞</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>μ</mi><mo stretchy="false">)</mo></mrow></mrow></msub><mo>≤</mo><msup><mi>m</mi><mrow><mo>−</mo><mi>γ</mi><mo>/</mo><mo stretchy="false">(</mo><mn>2</mn><mi>γ</mi><mo>+</mo><mi>d</mi><mo stretchy="false">)</mo></mrow></msup></mrow><annotation encoding="application/x-tex">\left\|\widehat{f}-f_{j^{\prime}}\right\|_{L^{\infty}(\mu)}\leq m^{-\gamma/(2\gamma+d)}</annotation></semantics></math>. By the triangle inequality, we have</span></p>
<table id="S6.EGx200" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="S6.E25"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S6.E25.m1" class="ltx_Math" alttext="\displaystyle\left\|\widehat{f}-f^{*}\right\|_{L^{2}(\mu)}^{2}" display="inline" intent=":literal"><semantics><msubsup><mrow><mo>‖</mo><mrow><mover accent="true"><mi>f</mi><mo>^</mo></mover><mo>−</mo><msup><mi>f</mi><mo>∗</mo></msup></mrow><mo>‖</mo></mrow><mrow><msup><mi>L</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>μ</mi><mo stretchy="false">)</mo></mrow></mrow><mn>2</mn></msubsup><annotation encoding="application/x-tex">\displaystyle\left\|\widehat{f}-f^{*}\right\|_{L^{2}(\mu)}^{2}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S6.E25.m2" class="ltx_math_unparsed" alttext="\displaystyle\leq 2\left\|\widehat{f}-f_{j^{\prime}}\right\|_{L^{2}(\mu)}^{2}+2\left\|f_{j^{\prime}}-f^{*}\right\|_{L^{2}(\mu)}^{2}\leq 2m^{-\gamma/(2\gamma+d)}+2\left\|f_{j^{\prime}}-f^{*}\right\|_{L^{2}(\mu)}^{2}." display="inline" intent=":literal"><semantics><mrow><mo>≤</mo><mn>2</mn><msubsup><mrow><mo>‖</mo><mover accent="true"><mi>f</mi><mo>^</mo></mover><mo>−</mo><msub><mi>f</mi><msup><mi>j</mi><mo>′</mo></msup></msub><mo>‖</mo></mrow><mrow><msup><mi>L</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>μ</mi><mo stretchy="false">)</mo></mrow></mrow><mn>2</mn></msubsup><mo>+</mo><mn>2</mn><msubsup><mrow><mo>‖</mo><msub><mi>f</mi><msup><mi>j</mi><mo>′</mo></msup></msub><mo>−</mo><msup><mi>f</mi><mo>∗</mo></msup><mo>‖</mo></mrow><mrow><msup><mi>L</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>μ</mi><mo stretchy="false">)</mo></mrow></mrow><mn>2</mn></msubsup><mo>≤</mo><mn>2</mn><msup><mi>m</mi><mrow><mo>−</mo><mi>γ</mi><mo>/</mo><mo stretchy="false">(</mo><mn>2</mn><mi>γ</mi><mo>+</mo><mi>d</mi><mo stretchy="false">)</mo></mrow></msup><mo>+</mo><mn>2</mn><msubsup><mrow><mo>‖</mo><msub><mi>f</mi><msup><mi>j</mi><mo>′</mo></msup></msub><mo>−</mo><msup><mi>f</mi><mo>∗</mo></msup><mo>‖</mo></mrow><mrow><msup><mi>L</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>μ</mi><mo stretchy="false">)</mo></mrow></mrow><mn>2</mn></msubsup><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\leq 2\left\|\widehat{f}-f_{j^{\prime}}\right\|_{L^{2}(\mu)}^{2}+2\left\|f_{j^{\prime}}-f^{*}\right\|_{L^{2}(\mu)}^{2}\leq 2m^{-\gamma/(2\gamma+d)}+2\left\|f_{j^{\prime}}-f^{*}\right\|_{L^{2}(\mu)}^{2}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(25)</span></td></tr></tbody>
</table>
<p id="S6.p6.2" class="ltx_p"><span id="S6.p6.2.1" class="ltx_text">We bound the term <math id="S6.p6.m8" class="ltx_Math" alttext="\left\|f_{j}-f^{*}\right\|_{L^{2}(\mu)}^{2}" display="inline" intent=":literal"><semantics><msubsup><mrow><mo>‖</mo><mrow><msub><mi>f</mi><mi>j</mi></msub><mo>−</mo><msup><mi>f</mi><mo>∗</mo></msup></mrow><mo>‖</mo></mrow><mrow><msup><mi>L</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>μ</mi><mo stretchy="false">)</mo></mrow></mrow><mn>2</mn></msubsup><annotation encoding="application/x-tex">\left\|f_{j}-f^{*}\right\|_{L^{2}(\mu)}^{2}</annotation></semantics></math> uniformly for all <math id="S6.p6.m9" class="ltx_Math" alttext="j\in[N]" display="inline" intent=":literal"><semantics><mrow><mi>j</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mi>N</mi><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">j\in[N]</annotation></semantics></math> in order to bound the random quantity <math id="S6.p6.m10" class="ltx_Math" alttext="\left\|f_{j^{\prime}}-f^{*}\right\|_{L^{2}(\mu)}^{2}" display="inline" intent=":literal"><semantics><msubsup><mrow><mo>‖</mo><mrow><msub><mi>f</mi><msup><mi>j</mi><mo>′</mo></msup></msub><mo>−</mo><msup><mi>f</mi><mo>∗</mo></msup></mrow><mo>‖</mo></mrow><mrow><msup><mi>L</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>μ</mi><mo stretchy="false">)</mo></mrow></mrow><mn>2</mn></msubsup><annotation encoding="application/x-tex">\left\|f_{j^{\prime}}-f^{*}\right\|_{L^{2}(\mu)}^{2}</annotation></semantics></math>. Firstly, given <math id="S6.p6.m11" class="ltx_Math" alttext="j\in[N]" display="inline" intent=":literal"><semantics><mrow><mi>j</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mi>N</mi><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">j\in[N]</annotation></semantics></math>, we apply Bernstein’s inequality (Lemma <a href="#Thmlemma21" title="Lemma 21 (Bernstein’s inequality). ‣ 6 Proof of Proposition ‣ Standard Transformers Achieve the Minimax Rate in Nonparametric Regression with 𝐶^{𝑠,𝜆} Targets" class="ltx_ref"><span class="ltx_text ltx_ref_tag">21</span></a>) with</span></p>
<table id="S6.EGx201" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="S6.Ex321"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S6.Ex321.m1" class="ltx_Math" alttext="\displaystyle Z_{i}:=(f_{j}(X_{i})-f^{*}(X_{i}))^{2}-\mathbb{E}[(f_{j}(X_{i})-f^{*}(X_{i}))^{2}]." display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>Z</mi><mi>i</mi></msub><mo>:=</mo><mrow><msup><mrow><mo stretchy="false">(</mo><mrow><mrow><msub><mi>f</mi><mi>j</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>X</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msup><mi>f</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>X</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup><mo>−</mo><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mrow><msub><mi>f</mi><mi>j</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>X</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msup><mi>f</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>X</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup><mo stretchy="false">]</mo></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle Z_{i}:=(f_{j}(X_{i})-f^{*}(X_{i}))^{2}-\mathbb{E}[(f_{j}(X_{i})-f^{*}(X_{i}))^{2}].</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S6.p6.3" class="ltx_p"><span id="S6.p6.3.1" class="ltx_text">Since</span></p>
<table id="S6.EGx202" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="S6.Ex322"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S6.Ex322.m1" class="ltx_Math" alttext="\displaystyle|Z_{i}|" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">|</mo><msub><mi>Z</mi><mi>i</mi></msub><mo stretchy="false">|</mo></mrow><annotation encoding="application/x-tex">\displaystyle|Z_{i}|</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S6.Ex322.m2" class="ltx_Math" alttext="\displaystyle=\left|(f_{j}(X_{i})-f^{*}(X_{i}))^{2}-\mathbb{E}[(f_{j}(X_{i})-f^{*}(X_{i}))^{2}]\right|\leq 8B_{\mathcal{F}}^{2}," display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>=</mo><mrow><mo>|</mo><mrow><msup><mrow><mo stretchy="false">(</mo><mrow><mrow><msub><mi>f</mi><mi>j</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>X</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msup><mi>f</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>X</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup><mo>−</mo><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mrow><msub><mi>f</mi><mi>j</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>X</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msup><mi>f</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>X</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup><mo stretchy="false">]</mo></mrow></mrow></mrow><mo>|</mo></mrow><mo>≤</mo><mrow><mn>8</mn><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>B</mi><mi class="ltx_font_mathcaligraphic">ℱ</mi><mn>2</mn></msubsup></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle=\left|(f_{j}(X_{i})-f^{*}(X_{i}))^{2}-\mathbb{E}[(f_{j}(X_{i})-f^{*}(X_{i}))^{2}]\right|\leq 8B_{\mathcal{F}}^{2},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="S6.Ex323"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S6.Ex323.m1" class="ltx_Math" alttext="\displaystyle\mathrm{Var}\left(Z_{i}\right)" display="inline" intent=":literal"><semantics><mrow><mi>Var</mi><mo>⁡</mo><mrow><mo>(</mo><msub><mi>Z</mi><mi>i</mi></msub><mo>)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\mathrm{Var}\left(Z_{i}\right)</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S6.Ex323.m2" class="ltx_Math" alttext="\displaystyle=\mathrm{Var}\left((f_{j}(X_{i})-f^{*}(X_{i}))^{2}-\mathbb{E}[(f_{j}(X_{i})-f^{*}(X_{i}))^{2}]\right)" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mi>Var</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><msup><mrow><mo stretchy="false">(</mo><mrow><mrow><msub><mi>f</mi><mi>j</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>X</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msup><mi>f</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>X</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup><mo>−</mo><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mrow><msub><mi>f</mi><mi>j</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>X</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msup><mi>f</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>X</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup><mo stretchy="false">]</mo></mrow></mrow></mrow><mo>)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\mathrm{Var}\left((f_{j}(X_{i})-f^{*}(X_{i}))^{2}-\mathbb{E}[(f_{j}(X_{i})-f^{*}(X_{i}))^{2}]\right)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="S6.Ex324"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S6.Ex324.m1" class="ltx_Math" alttext="\displaystyle=\mathrm{Var}\left((f_{j}(X_{i})-f^{*}(X_{i}))^{2}\right)" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mi>Var</mi><mo>⁡</mo><mrow><mo>(</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mrow><msub><mi>f</mi><mi>j</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>X</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msup><mi>f</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>X</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup><mo>)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\mathrm{Var}\left((f_{j}(X_{i})-f^{*}(X_{i}))^{2}\right)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="S6.Ex325"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S6.Ex325.m1" class="ltx_Math" alttext="\displaystyle=\mathbb{E}\left(\left[f_{j}(X_{i})-f^{*}(X_{i})\right]^{4}\right)-\left(\mathbb{E}\left[f_{j}(X_{i})-f^{*}(X_{i})\right]^{2}\right)^{2}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>(</mo><msup><mrow><mo>[</mo><mrow><mrow><msub><mi>f</mi><mi>j</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>X</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msup><mi>f</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>X</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>]</mo></mrow><mn>4</mn></msup><mo>)</mo></mrow></mrow><mo>−</mo><msup><mrow><mo>(</mo><mrow><mi>𝔼</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo>[</mo><mrow><mrow><msub><mi>f</mi><mi>j</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>X</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msup><mi>f</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>X</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>]</mo></mrow><mn>2</mn></msup></mrow><mo>)</mo></mrow><mn>2</mn></msup></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\mathbb{E}\left(\left[f_{j}(X_{i})-f^{*}(X_{i})\right]^{4}\right)-\left(\mathbb{E}\left[f_{j}(X_{i})-f^{*}(X_{i})\right]^{2}\right)^{2}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="S6.Ex326"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S6.Ex326.m1" class="ltx_Math" alttext="\displaystyle\leq 4B_{\mathcal{F}}^{2}\mathbb{E}\left(\left[f_{j}(X_{i})-f^{*}(X_{i})\right]^{2}\right)+4B_{\mathcal{F}}^{2}\left(\mathbb{E}\left[f_{j}(X_{i})-f^{*}(X_{i})\right]^{2}\right)" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≤</mo><mrow><mrow><mn>4</mn><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>B</mi><mi class="ltx_font_mathcaligraphic">ℱ</mi><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>𝔼</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><msup><mrow><mo>[</mo><mrow><mrow><msub><mi>f</mi><mi>j</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>X</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msup><mi>f</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>X</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>]</mo></mrow><mn>2</mn></msup><mo>)</mo></mrow></mrow><mo>+</mo><mrow><mn>4</mn><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>B</mi><mi class="ltx_font_mathcaligraphic">ℱ</mi><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mi>𝔼</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo>[</mo><mrow><mrow><msub><mi>f</mi><mi>j</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>X</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msup><mi>f</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>X</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>]</mo></mrow><mn>2</mn></msup></mrow><mo>)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\leq 4B_{\mathcal{F}}^{2}\mathbb{E}\left(\left[f_{j}(X_{i})-f^{*}(X_{i})\right]^{2}\right)+4B_{\mathcal{F}}^{2}\left(\mathbb{E}\left[f_{j}(X_{i})-f^{*}(X_{i})\right]^{2}\right)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="S6.Ex327"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S6.Ex327.m1" class="ltx_Math" alttext="\displaystyle=8B_{\mathcal{F}}^{2}\left\|f_{j}-f^{*}\right\|_{L^{2}(\mu)}^{2}\leq 16B_{\mathcal{F}}^{2}u," display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>=</mo><mrow><mn>8</mn><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>B</mi><mi class="ltx_font_mathcaligraphic">ℱ</mi><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><msubsup><mrow><mo>‖</mo><mrow><msub><mi>f</mi><mi>j</mi></msub><mo>−</mo><msup><mi>f</mi><mo>∗</mo></msup></mrow><mo>‖</mo></mrow><mrow><msup><mi>L</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>μ</mi><mo stretchy="false">)</mo></mrow></mrow><mn>2</mn></msubsup></mrow><mo>≤</mo><mrow><mn>16</mn><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>B</mi><mi class="ltx_font_mathcaligraphic">ℱ</mi><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>u</mi></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle=8B_{\mathcal{F}}^{2}\left\|f_{j}-f^{*}\right\|_{L^{2}(\mu)}^{2}\leq 16B_{\mathcal{F}}^{2}u,</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S6.p6.4" class="ltx_p"><span id="S6.p6.4.1" class="ltx_text">we substitute <math id="S6.p6.m12" class="ltx_Math" alttext="u" display="inline" intent=":literal"><semantics><mi>u</mi><annotation encoding="application/x-tex">u</annotation></semantics></math> with <math id="S6.p6.m13" class="ltx_Math" alttext="\max\left\{v,\|f_{j}-f^{*}\|_{L^{2}(\mu)}^{2}/2\right\}" display="inline" intent=":literal"><semantics><mrow><mi>max</mi><mo>⁡</mo><mrow><mo>{</mo><mi>v</mi><mo>,</mo><mrow><msubsup><mrow><mo stretchy="false">‖</mo><mrow><msub><mi>f</mi><mi>j</mi></msub><mo>−</mo><msup><mi>f</mi><mo>∗</mo></msup></mrow><mo stretchy="false">‖</mo></mrow><mrow><msup><mi>L</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>μ</mi><mo stretchy="false">)</mo></mrow></mrow><mn>2</mn></msubsup><mo>/</mo><mn>2</mn></mrow><mo>}</mo></mrow></mrow><annotation encoding="application/x-tex">\max\left\{v,\|f_{j}-f^{*}\|_{L^{2}(\mu)}^{2}/2\right\}</annotation></semantics></math>, <math id="S6.p6.m14" class="ltx_Math" alttext="c" display="inline" intent=":literal"><semantics><mi>c</mi><annotation encoding="application/x-tex">c</annotation></semantics></math> with <math id="S6.p6.m15" class="ltx_Math" alttext="8B_{\mathcal{F}}^{2}" display="inline" intent=":literal"><semantics><mrow><mn>8</mn><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>B</mi><mi class="ltx_font_mathcaligraphic">ℱ</mi><mn>2</mn></msubsup></mrow><annotation encoding="application/x-tex">8B_{\mathcal{F}}^{2}</annotation></semantics></math> and <math id="S6.p6.m16" class="ltx_Math" alttext="\tau^{2}" display="inline" intent=":literal"><semantics><msup><mi>τ</mi><mn>2</mn></msup><annotation encoding="application/x-tex">\tau^{2}</annotation></semantics></math> with <math id="S6.p6.m17" class="ltx_Math" alttext="16B_{\mathcal{F}}^{2}u" display="inline" intent=":literal"><semantics><mrow><mn>16</mn><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>B</mi><mi class="ltx_font_mathcaligraphic">ℱ</mi><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>u</mi></mrow><annotation encoding="application/x-tex">16B_{\mathcal{F}}^{2}u</annotation></semantics></math> in Lemma <a href="#Thmlemma21" title="Lemma 21 (Bernstein’s inequality). ‣ 6 Proof of Proposition ‣ Standard Transformers Achieve the Minimax Rate in Nonparametric Regression with 𝐶^{𝑠,𝜆} Targets" class="ltx_ref"><span class="ltx_text ltx_ref_tag">21</span></a> and obtain</span></p>
<table id="S6.EGx203" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="S6.E26"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S6.E26.m1" class="ltx_Math" alttext="\displaystyle\mathbb{P}\left(\|f_{j}-f^{*}\|_{L^{2}(\mu)}^{2}\geq\|f_{j}-f^{*}\|_{m}^{2}+u\right)\leq\exp\left(-\frac{3mv}{112B_{\mathcal{F}}^{2}}\right)." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mi>ℙ</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><msubsup><mrow><mo stretchy="false">‖</mo><mrow><msub><mi>f</mi><mi>j</mi></msub><mo>−</mo><msup><mi>f</mi><mo>∗</mo></msup></mrow><mo stretchy="false">‖</mo></mrow><mrow><msup><mi>L</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>μ</mi><mo stretchy="false">)</mo></mrow></mrow><mn>2</mn></msubsup><mo>≥</mo><mrow><msubsup><mrow><mo stretchy="false">‖</mo><mrow><msub><mi>f</mi><mi>j</mi></msub><mo>−</mo><msup><mi>f</mi><mo>∗</mo></msup></mrow><mo stretchy="false">‖</mo></mrow><mi>m</mi><mn>2</mn></msubsup><mo>+</mo><mi>u</mi></mrow></mrow><mo>)</mo></mrow></mrow><mo>≤</mo><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mo>−</mo><mstyle displaystyle="true"><mfrac><mrow><mn>3</mn><mo lspace="0em" rspace="0em">​</mo><mi>m</mi><mo lspace="0em" rspace="0em">​</mo><mi>v</mi></mrow><mrow><mn>112</mn><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>B</mi><mi class="ltx_font_mathcaligraphic">ℱ</mi><mn>2</mn></msubsup></mrow></mfrac></mstyle></mrow><mo>)</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\mathbb{P}\left(\|f_{j}-f^{*}\|_{L^{2}(\mu)}^{2}\geq\|f_{j}-f^{*}\|_{m}^{2}+u\right)\leq\exp\left(-\frac{3mv}{112B_{\mathcal{F}}^{2}}\right).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(26)</span></td></tr></tbody>
</table>
<p id="S6.p6.5" class="ltx_p"><span id="S6.p6.5.1" class="ltx_text">By the uniform bound argument, <math id="S6.p6.m18" class="ltx_Math" alttext="\|f_{j}-f^{*}\|_{L^{2}(\mu)}^{2}\geq\|f_{j}-f^{*}\|_{m}^{2}+u" display="inline" intent=":literal"><semantics><mrow><msubsup><mrow><mo stretchy="false">‖</mo><mrow><msub><mi>f</mi><mi>j</mi></msub><mo>−</mo><msup><mi>f</mi><mo>∗</mo></msup></mrow><mo stretchy="false">‖</mo></mrow><mrow><msup><mi>L</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>μ</mi><mo stretchy="false">)</mo></mrow></mrow><mn>2</mn></msubsup><mo>≥</mo><mrow><msubsup><mrow><mo stretchy="false">‖</mo><mrow><msub><mi>f</mi><mi>j</mi></msub><mo>−</mo><msup><mi>f</mi><mo>∗</mo></msup></mrow><mo stretchy="false">‖</mo></mrow><mi>m</mi><mn>2</mn></msubsup><mo>+</mo><mi>u</mi></mrow></mrow><annotation encoding="application/x-tex">\|f_{j}-f^{*}\|_{L^{2}(\mu)}^{2}\geq\|f_{j}-f^{*}\|_{m}^{2}+u</annotation></semantics></math> holds for all <math id="S6.p6.m19" class="ltx_Math" alttext="j\in[N]" display="inline" intent=":literal"><semantics><mrow><mi>j</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mi>N</mi><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">j\in[N]</annotation></semantics></math> with probability at most <math id="S6.p6.m20" class="ltx_math_unparsed" alttext="N\exp\left(-3mv/(112B_{\mathcal{F}}^{2})\right)" display="inline" intent=":literal"><semantics><mrow><mi>N</mi><mi>exp</mi><mrow><mo>(</mo><mo lspace="0em">−</mo><mn>3</mn><mi>m</mi><mi>v</mi><mo>/</mo><mrow><mo stretchy="false">(</mo><mn>112</mn><msubsup><mi>B</mi><mi class="ltx_font_mathcaligraphic">ℱ</mi><mn>2</mn></msubsup><mo stretchy="false">)</mo></mrow><mo>)</mo></mrow></mrow><annotation encoding="application/x-tex">N\exp\left(-3mv/(112B_{\mathcal{F}}^{2})\right)</annotation></semantics></math>. Substituting <math id="S6.p6.m21" class="ltx_Math" alttext="v" display="inline" intent=":literal"><semantics><mi>v</mi><annotation encoding="application/x-tex">v</annotation></semantics></math> with <math id="S6.p6.m22" class="ltx_Math" alttext="112B_{\mathcal{F}}^{2}(m^{d/(2\gamma+d)}+\log N)/(3m)" display="inline" intent=":literal"><semantics><mrow><mrow><mn>112</mn><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>B</mi><mi class="ltx_font_mathcaligraphic">ℱ</mi><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mi>m</mi><mrow><mi>d</mi><mo>/</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>γ</mi></mrow><mo>+</mo><mi>d</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></msup><mo>+</mo><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mi>N</mi></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>/</mo><mrow><mo stretchy="false">(</mo><mrow><mn>3</mn><mo lspace="0em" rspace="0em">​</mo><mi>m</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">112B_{\mathcal{F}}^{2}(m^{d/(2\gamma+d)}+\log N)/(3m)</annotation></semantics></math> leads to the following inequality:</span></p>
<table id="S6.EGx204" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="S6.Ex328"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S6.Ex328.m1" class="ltx_Math" alttext="\displaystyle\|f_{j}-f^{*}\|_{m}^{2}+u" display="inline" intent=":literal"><semantics><mrow><msubsup><mrow><mo stretchy="false">‖</mo><mrow><msub><mi>f</mi><mi>j</mi></msub><mo>−</mo><msup><mi>f</mi><mo>∗</mo></msup></mrow><mo stretchy="false">‖</mo></mrow><mi>m</mi><mn>2</mn></msubsup><mo>+</mo><mi>u</mi></mrow><annotation encoding="application/x-tex">\displaystyle\|f_{j}-f^{*}\|_{m}^{2}+u</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S6.Ex328.m2" class="ltx_Math" alttext="\displaystyle\leq\|f_{j}-f^{*}\|_{m}^{2}+v+\frac{1}{2}\|f_{j}-f^{*}\|_{L^{2}(\mu)}^{2}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≤</mo><mrow><msubsup><mrow><mo stretchy="false">‖</mo><mrow><msub><mi>f</mi><mi>j</mi></msub><mo>−</mo><msup><mi>f</mi><mo>∗</mo></msup></mrow><mo stretchy="false">‖</mo></mrow><mi>m</mi><mn>2</mn></msubsup><mo>+</mo><mi>v</mi><mo>+</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mn>2</mn></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msubsup><mrow><mo stretchy="false">‖</mo><mrow><msub><mi>f</mi><mi>j</mi></msub><mo>−</mo><msup><mi>f</mi><mo>∗</mo></msup></mrow><mo stretchy="false">‖</mo></mrow><mrow><msup><mi>L</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>μ</mi><mo stretchy="false">)</mo></mrow></mrow><mn>2</mn></msubsup></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\leq\|f_{j}-f^{*}\|_{m}^{2}+v+\frac{1}{2}\|f_{j}-f^{*}\|_{L^{2}(\mu)}^{2}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="S6.Ex329"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S6.Ex329.m1" class="ltx_Math" alttext="\displaystyle\leq\|f_{j}-f^{*}\|_{m}^{2}+\frac{112B_{\mathcal{F}}^{2}m^{-2\gamma/(2\gamma+d)}}{3}+\frac{112B_{\mathcal{F}}^{2}\log N}{3m}+\frac{1}{2}\|f_{j}-f^{*}\|_{L^{2}(\mu)}^{2}." display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>≤</mo><mrow><msubsup><mrow><mo stretchy="false">‖</mo><mrow><msub><mi>f</mi><mi>j</mi></msub><mo>−</mo><msup><mi>f</mi><mo>∗</mo></msup></mrow><mo stretchy="false">‖</mo></mrow><mi>m</mi><mn>2</mn></msubsup><mo>+</mo><mstyle displaystyle="true"><mfrac><mrow><mn>112</mn><mi>B</mi><msub><mrow></mrow><mi class="ltx_font_mathcaligraphic">ℱ</mi></msub><msup><mrow></mrow><mn>2</mn></msup><mi>m</mi><msup><mrow></mrow><mrow><mo>−</mo><mn>2</mn><mi>γ</mi><mo>/</mo><mo stretchy="false">(</mo><mn>2</mn><mi>γ</mi><mo>+</mo><mi>d</mi><mo stretchy="false">)</mo></mrow></msup></mrow><mn>3</mn></mfrac></mstyle><mo>+</mo><mstyle displaystyle="true"><mfrac><mrow><mn>112</mn><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>B</mi><mi class="ltx_font_mathcaligraphic">ℱ</mi><mn>2</mn></msubsup><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mi>N</mi></mrow></mrow><mrow><mn>3</mn><mo lspace="0em" rspace="0em">​</mo><mi>m</mi></mrow></mfrac></mstyle><mo>+</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mn>2</mn></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msubsup><mrow><mo stretchy="false">‖</mo><mrow><msub><mi>f</mi><mi>j</mi></msub><mo>−</mo><msup><mi>f</mi><mo>∗</mo></msup></mrow><mo stretchy="false">‖</mo></mrow><mrow><msup><mi>L</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>μ</mi><mo stretchy="false">)</mo></mrow></mrow><mn>2</mn></msubsup></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\leq\|f_{j}-f^{*}\|_{m}^{2}+\frac{112B_{\mathcal{F}}^{2}m^{-2\gamma/(2\gamma+d)}}{3}+\frac{112B_{\mathcal{F}}^{2}\log N}{3m}+\frac{1}{2}\|f_{j}-f^{*}\|_{L^{2}(\mu)}^{2}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S6.p6.6" class="ltx_p"><span id="S6.p6.6.1" class="ltx_text">Combining the above inequality and (<a href="#S6.E26" title="In Proof of Proposition . ‣ 6 Proof of Proposition ‣ Standard Transformers Achieve the Minimax Rate in Nonparametric Regression with 𝐶^{𝑠,𝜆} Targets" class="ltx_ref"><span class="ltx_text ltx_ref_tag">26</span></a>), we derive that</span></p>
<table id="S6.EGx205" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="S6.E27"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S6.E27.m1" class="ltx_Math" alttext="\displaystyle\|f_{j}-f^{*}\|_{L^{2}(\mu)}^{2}\leq 2\|f_{j}-f^{*}\|_{m}^{2}+\frac{224B_{\mathcal{F}}^{2}m^{-2\gamma/(2\gamma+d)}}{3}+\frac{224B_{\mathcal{F}}^{2}\log N}{3m}" display="inline" intent=":literal"><semantics><mrow><msubsup><mrow><mo stretchy="false">‖</mo><mrow><msub><mi>f</mi><mi>j</mi></msub><mo>−</mo><msup><mi>f</mi><mo>∗</mo></msup></mrow><mo stretchy="false">‖</mo></mrow><mrow><msup><mi>L</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>μ</mi><mo stretchy="false">)</mo></mrow></mrow><mn>2</mn></msubsup><mo>≤</mo><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msubsup><mrow><mo stretchy="false">‖</mo><mrow><msub><mi>f</mi><mi>j</mi></msub><mo>−</mo><msup><mi>f</mi><mo>∗</mo></msup></mrow><mo stretchy="false">‖</mo></mrow><mi>m</mi><mn>2</mn></msubsup></mrow><mo>+</mo><mstyle displaystyle="true"><mfrac><mrow><mn>224</mn><mi>B</mi><msub><mrow></mrow><mi class="ltx_font_mathcaligraphic">ℱ</mi></msub><msup><mrow></mrow><mn>2</mn></msup><mi>m</mi><msup><mrow></mrow><mrow><mo>−</mo><mn>2</mn><mi>γ</mi><mo>/</mo><mo stretchy="false">(</mo><mn>2</mn><mi>γ</mi><mo>+</mo><mi>d</mi><mo stretchy="false">)</mo></mrow></msup></mrow><mn>3</mn></mfrac></mstyle><mo>+</mo><mstyle displaystyle="true"><mfrac><mrow><mn>224</mn><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>B</mi><mi class="ltx_font_mathcaligraphic">ℱ</mi><mn>2</mn></msubsup><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mi>N</mi></mrow></mrow><mrow><mn>3</mn><mo lspace="0em" rspace="0em">​</mo><mi>m</mi></mrow></mfrac></mstyle></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\|f_{j}-f^{*}\|_{L^{2}(\mu)}^{2}\leq 2\|f_{j}-f^{*}\|_{m}^{2}+\frac{224B_{\mathcal{F}}^{2}m^{-2\gamma/(2\gamma+d)}}{3}+\frac{224B_{\mathcal{F}}^{2}\log N}{3m}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(27)</span></td></tr></tbody>
</table>
<p id="S6.p6.7" class="ltx_p"><span id="S6.p6.7.1" class="ltx_text">holds for all <math id="S6.p6.m23" class="ltx_Math" alttext="j\in[N]" display="inline" intent=":literal"><semantics><mrow><mi>j</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mi>N</mi><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">j\in[N]</annotation></semantics></math> with probability at least <math id="S6.p6.m24" class="ltx_Math" alttext="1-\exp\left(-m^{d/(2\gamma+d)}\right)" display="inline" intent=":literal"><semantics><mrow><mn>1</mn><mo>−</mo><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mo>−</mo><msup><mi>m</mi><mrow><mi>d</mi><mo>/</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>γ</mi></mrow><mo>+</mo><mi>d</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></msup></mrow><mo>)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">1-\exp\left(-m^{d/(2\gamma+d)}\right)</annotation></semantics></math>. Plugging (<a href="#S6.E27" title="In Proof of Proposition . ‣ 6 Proof of Proposition ‣ Standard Transformers Achieve the Minimax Rate in Nonparametric Regression with 𝐶^{𝑠,𝜆} Targets" class="ltx_ref"><span class="ltx_text ltx_ref_tag">27</span></a>) into (<a href="#S6.E25" title="In Proof of Proposition . ‣ 6 Proof of Proposition ‣ Standard Transformers Achieve the Minimax Rate in Nonparametric Regression with 𝐶^{𝑠,𝜆} Targets" class="ltx_ref"><span class="ltx_text ltx_ref_tag">25</span></a>) yields</span></p>
<table id="S6.EGx206" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="S6.Ex330"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S6.Ex330.m1" class="ltx_Math" alttext="\displaystyle\left\|\widehat{f}-f^{*}\right\|_{L^{2}(\mu)}^{2}" display="inline" intent=":literal"><semantics><msubsup><mrow><mo>‖</mo><mrow><mover accent="true"><mi>f</mi><mo>^</mo></mover><mo>−</mo><msup><mi>f</mi><mo>∗</mo></msup></mrow><mo>‖</mo></mrow><mrow><msup><mi>L</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>μ</mi><mo stretchy="false">)</mo></mrow></mrow><mn>2</mn></msubsup><annotation encoding="application/x-tex">\displaystyle\left\|\widehat{f}-f^{*}\right\|_{L^{2}(\mu)}^{2}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="S6.Ex331"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S6.Ex331.m1" class="ltx_math_unparsed" alttext="\displaystyle\leq 2m^{-2s/(2s+d)}+4\|f_{j^{\prime}}-f^{*}\|_{m}^{2}+\frac{448B_{\mathcal{F}}^{2}m^{-2\gamma/(2\gamma+d)}}{3}+\frac{448B_{\mathcal{F}}^{2}\log N}{3m}" display="inline" intent=":literal"><semantics><mrow><mo>≤</mo><mn>2</mn><mi>m</mi><msup><mrow></mrow><mrow><mo>−</mo><mn>2</mn><mi>s</mi><mo>/</mo><mo stretchy="false">(</mo><mn>2</mn><mi>s</mi><mo>+</mo><mi>d</mi><mo stretchy="false">)</mo></mrow></msup><mo>+</mo><mn>4</mn><mo lspace="0em" rspace="0.167em">∥</mo><mi>f</mi><msub><mrow></mrow><msup><mi>j</mi><mo>′</mo></msup></msub><mo>−</mo><mi>f</mi><msup><mrow></mrow><mo>∗</mo></msup><mo lspace="0em" rspace="0em">∥</mo><msub><mrow></mrow><mi>m</mi></msub><msup><mrow></mrow><mn>2</mn></msup><mo lspace="0em">+</mo><mstyle displaystyle="true"><mfrac><mrow><mn>448</mn><mi>B</mi><msub><mrow></mrow><mi class="ltx_font_mathcaligraphic">ℱ</mi></msub><msup><mrow></mrow><mn>2</mn></msup><mi>m</mi><msup><mrow></mrow><mrow><mo>−</mo><mn>2</mn><mi>γ</mi><mo>/</mo><mo stretchy="false">(</mo><mn>2</mn><mi>γ</mi><mo>+</mo><mi>d</mi><mo stretchy="false">)</mo></mrow></msup></mrow><mn>3</mn></mfrac></mstyle><mo>+</mo><mstyle displaystyle="true"><mfrac><mrow><mn>448</mn><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>B</mi><mi class="ltx_font_mathcaligraphic">ℱ</mi><mn>2</mn></msubsup><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mi>N</mi></mrow></mrow><mrow><mn>3</mn><mo lspace="0em" rspace="0em">​</mo><mi>m</mi></mrow></mfrac></mstyle></mrow><annotation encoding="application/x-tex">\displaystyle\leq 2m^{-2s/(2s+d)}+4\|f_{j^{\prime}}-f^{*}\|_{m}^{2}+\frac{448B_{\mathcal{F}}^{2}m^{-2\gamma/(2\gamma+d)}}{3}+\frac{448B_{\mathcal{F}}^{2}\log N}{3m}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="S6.Ex332"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S6.Ex332.m1" class="ltx_math_unparsed" alttext="\displaystyle\leq 2m^{-2\gamma/(2\gamma+d)}+8\left\|\widehat{f}-f_{j^{\prime}}\right\|_{m}^{2}+8\left\|\widehat{f}-f^{*}\right\|_{m}^{2}+\frac{448B_{\mathcal{F}}^{2}m^{-2\gamma/(2\gamma+d)}}{3}+\frac{448B_{\mathcal{F}}^{2}\log N}{3m}" display="inline" intent=":literal"><semantics><mrow><mo>≤</mo><mn>2</mn><msup><mi>m</mi><mrow><mo>−</mo><mn>2</mn><mi>γ</mi><mo>/</mo><mo stretchy="false">(</mo><mn>2</mn><mi>γ</mi><mo>+</mo><mi>d</mi><mo stretchy="false">)</mo></mrow></msup><mo>+</mo><mn>8</mn><msubsup><mrow><mo>‖</mo><mover accent="true"><mi>f</mi><mo>^</mo></mover><mo>−</mo><msub><mi>f</mi><msup><mi>j</mi><mo>′</mo></msup></msub><mo>‖</mo></mrow><mi>m</mi><mn>2</mn></msubsup><mo>+</mo><mn>8</mn><msubsup><mrow><mo>‖</mo><mover accent="true"><mi>f</mi><mo>^</mo></mover><mo>−</mo><msup><mi>f</mi><mo>∗</mo></msup><mo>‖</mo></mrow><mi>m</mi><mn>2</mn></msubsup><mo>+</mo><mstyle displaystyle="true"><mfrac><mrow><mn>448</mn><mi>B</mi><msub><mrow></mrow><mi class="ltx_font_mathcaligraphic">ℱ</mi></msub><msup><mrow></mrow><mn>2</mn></msup><mi>m</mi><msup><mrow></mrow><mrow><mo>−</mo><mn>2</mn><mi>γ</mi><mo>/</mo><mo stretchy="false">(</mo><mn>2</mn><mi>γ</mi><mo>+</mo><mi>d</mi><mo stretchy="false">)</mo></mrow></msup></mrow><mn>3</mn></mfrac></mstyle><mo>+</mo><mstyle displaystyle="true"><mfrac><mrow><mn>448</mn><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>B</mi><mi class="ltx_font_mathcaligraphic">ℱ</mi><mn>2</mn></msubsup><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mi>N</mi></mrow></mrow><mrow><mn>3</mn><mo lspace="0em" rspace="0em">​</mo><mi>m</mi></mrow></mfrac></mstyle></mrow><annotation encoding="application/x-tex">\displaystyle\leq 2m^{-2\gamma/(2\gamma+d)}+8\left\|\widehat{f}-f_{j^{\prime}}\right\|_{m}^{2}+8\left\|\widehat{f}-f^{*}\right\|_{m}^{2}+\frac{448B_{\mathcal{F}}^{2}m^{-2\gamma/(2\gamma+d)}}{3}+\frac{448B_{\mathcal{F}}^{2}\log N}{3m}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="S6.Ex333"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S6.Ex333.m1" class="ltx_math_unparsed" alttext="\displaystyle\leq 10m^{-2\gamma/(2\gamma+d)}+8\left\|\widehat{f}-f^{*}\right\|_{m}^{2}+\frac{448B_{\mathcal{F}}^{2}m^{-2\gamma/(2\gamma+d)}}{3}" display="inline" intent=":literal"><semantics><mrow><mo>≤</mo><mn>10</mn><msup><mi>m</mi><mrow><mo>−</mo><mn>2</mn><mi>γ</mi><mo>/</mo><mo stretchy="false">(</mo><mn>2</mn><mi>γ</mi><mo>+</mo><mi>d</mi><mo stretchy="false">)</mo></mrow></msup><mo>+</mo><mn>8</mn><msubsup><mrow><mo>‖</mo><mover accent="true"><mi>f</mi><mo>^</mo></mover><mo>−</mo><msup><mi>f</mi><mo>∗</mo></msup><mo>‖</mo></mrow><mi>m</mi><mn>2</mn></msubsup><mo>+</mo><mstyle displaystyle="true"><mfrac><mrow><mn>448</mn><mi>B</mi><msub><mrow></mrow><mi class="ltx_font_mathcaligraphic">ℱ</mi></msub><msup><mrow></mrow><mn>2</mn></msup><mi>m</mi><msup><mrow></mrow><mrow><mo>−</mo><mn>2</mn><mi>γ</mi><mo>/</mo><mo stretchy="false">(</mo><mn>2</mn><mi>γ</mi><mo>+</mo><mi>d</mi><mo stretchy="false">)</mo></mrow></msup></mrow><mn>3</mn></mfrac></mstyle></mrow><annotation encoding="application/x-tex">\displaystyle\leq 10m^{-2\gamma/(2\gamma+d)}+8\left\|\widehat{f}-f^{*}\right\|_{m}^{2}+\frac{448B_{\mathcal{F}}^{2}m^{-2\gamma/(2\gamma+d)}}{3}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="S6.E28"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S6.E28.m1" class="ltx_Math" alttext="\displaystyle\quad+\frac{448B_{\mathcal{F}}^{2}\log\mathcal{N}(m^{-\gamma/(2\gamma+d)},\mathcal{F},\|\cdot\|_{L^{\infty}(\mu)})}{3m}" display="inline" intent=":literal"><semantics><mrow><mo>+</mo><mstyle displaystyle="true"><mfrac><mrow><mn>448</mn><mi>B</mi><msub><mrow></mrow><mi class="ltx_font_mathcaligraphic">ℱ</mi></msub><msup><mrow></mrow><mn>2</mn></msup><mi>log</mi><mi class="ltx_font_mathcaligraphic">𝒩</mi><mo stretchy="false">(</mo><mi>m</mi><msup><mrow></mrow><mrow><mo>−</mo><mi>γ</mi><mo>/</mo><mo stretchy="false">(</mo><mn>2</mn><mi>γ</mi><mo>+</mo><mi>d</mi><mo stretchy="false">)</mo></mrow></msup><mo>,</mo><mi class="ltx_font_mathcaligraphic">ℱ</mi><mo>,</mo><mo lspace="0em" rspace="0em">∥</mo><mo lspace="0em" rspace="0em">⋅</mo><mo lspace="0em" rspace="0.167em">∥</mo><msub><mrow></mrow><mrow><msup><mi>L</mi><mi mathvariant="normal">∞</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>μ</mi><mo stretchy="false">)</mo></mrow></mrow></msub><mo stretchy="false">)</mo></mrow><mrow><mn>3</mn><mo lspace="0em" rspace="0em">​</mo><mi>m</mi></mrow></mfrac></mstyle></mrow><annotation encoding="application/x-tex">\displaystyle\quad+\frac{448B_{\mathcal{F}}^{2}\log\mathcal{N}(m^{-\gamma/(2\gamma+d)},\mathcal{F},\|\cdot\|_{L^{\infty}(\mu)})}{3m}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(28)</span></td></tr></tbody>
</table>
<p id="S6.p6.8" class="ltx_p"><span id="S6.p6.8.1" class="ltx_text">with probability at least <math id="S6.p6.m25" class="ltx_Math" alttext="1-\exp\left(-m^{d/(2s+d)}\right)" display="inline" intent=":literal"><semantics><mrow><mn>1</mn><mo>−</mo><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mo>−</mo><msup><mi>m</mi><mrow><mi>d</mi><mo>/</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>s</mi></mrow><mo>+</mo><mi>d</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></msup></mrow><mo>)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">1-\exp\left(-m^{d/(2s+d)}\right)</annotation></semantics></math>.</span></p>
</div>
<div id="S6.p7" class="ltx_para">
<p id="S6.p7.1" class="ltx_p"><span id="S6.p7.1.1" class="ltx_text ltx_font_bold">Step 2: Upper Bound of <math id="S6.p7.m1" class="ltx_Math" alttext="\left\|\widehat{f}-f^{*}\right\|_{m}^{2}" display="inline" intent=":literal"><semantics><msubsup><mrow><mo>‖</mo><mrow><mover accent="true"><mi>f</mi><mo>^</mo></mover><mo>−</mo><msup><mi>f</mi><mo>∗</mo></msup></mrow><mo>‖</mo></mrow><mi>m</mi><mn>2</mn></msubsup><annotation encoding="application/x-tex">\left\|\widehat{f}-f^{*}\right\|_{m}^{2}</annotation></semantics></math>.<span id="S6.p7.1.1.1" class="ltx_text"></span></span></p>
</div>
<div id="S6.p8" class="ltx_para">
<p id="S6.p8.1" class="ltx_p"><span id="S6.p8.1.1" class="ltx_text">Denote <math id="S6.p8.m1" class="ltx_math_unparsed" alttext="\delta=\max\left\{2^{8}\sigma m^{-\gamma/(2\gamma+d)},2\left\|\widehat{f}-f_{0}\right\|_{m}\right\}" display="inline" intent=":literal"><semantics><mrow><mi>δ</mi><mo>=</mo><mi>max</mi><mrow><mo>{</mo><msup><mn>2</mn><mn>8</mn></msup><mi>σ</mi><msup><mi>m</mi><mrow><mo>−</mo><mi>γ</mi><mo>/</mo><mo stretchy="false">(</mo><mn>2</mn><mi>γ</mi><mo>+</mo><mi>d</mi><mo stretchy="false">)</mo></mrow></msup><mo>,</mo><mn>2</mn><msub><mrow><mo>‖</mo><mover accent="true"><mi>f</mi><mo>^</mo></mover><mo>−</mo><msub><mi>f</mi><mn>0</mn></msub><mo>‖</mo></mrow><mi>m</mi></msub><mo>}</mo></mrow></mrow><annotation encoding="application/x-tex">\delta=\max\left\{2^{8}\sigma m^{-\gamma/(2\gamma+d)},2\left\|\widehat{f}-f_{0}\right\|_{m}\right\}</annotation></semantics></math>. Given the observed variables <math id="S6.p8.m2" class="ltx_Math" alttext="\{X_{i}\}_{i=1}^{m}" display="inline" intent=":literal"><semantics><msubsup><mrow><mo stretchy="false">{</mo><msub><mi>X</mi><mi>i</mi></msub><mo stretchy="false">}</mo></mrow><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>m</mi></msubsup><annotation encoding="application/x-tex">\{X_{i}\}_{i=1}^{m}</annotation></semantics></math>, we bound <math id="S6.p8.m3" class="ltx_Math" alttext="\left\|\widehat{f}-f^{*}\right\|_{m}^{2}" display="inline" intent=":literal"><semantics><msubsup><mrow><mo>‖</mo><mrow><mover accent="true"><mi>f</mi><mo>^</mo></mover><mo>−</mo><msup><mi>f</mi><mo>∗</mo></msup></mrow><mo>‖</mo></mrow><mi>m</mi><mn>2</mn></msubsup><annotation encoding="application/x-tex">\left\|\widehat{f}-f^{*}\right\|_{m}^{2}</annotation></semantics></math> by considering two cases. In the first case, we suppose that <math id="S6.p8.m4" class="ltx_Math" alttext="\left\|\widehat{f}-f^{*}\right\|_{m}\leq\delta" display="inline" intent=":literal"><semantics><mrow><msub><mrow><mo>‖</mo><mrow><mover accent="true"><mi>f</mi><mo>^</mo></mover><mo>−</mo><msup><mi>f</mi><mo>∗</mo></msup></mrow><mo>‖</mo></mrow><mi>m</mi></msub><mo>≤</mo><mi>δ</mi></mrow><annotation encoding="application/x-tex">\left\|\widehat{f}-f^{*}\right\|_{m}\leq\delta</annotation></semantics></math> holds. By the definition of <math id="S6.p8.m5" class="ltx_Math" alttext="\widehat{f}" display="inline" intent=":literal"><semantics><mover accent="true"><mi>f</mi><mo>^</mo></mover><annotation encoding="application/x-tex">\widehat{f}</annotation></semantics></math>, we have for any <math id="S6.p8.m6" class="ltx_Math" alttext="f\in\mathcal{F}" display="inline" intent=":literal"><semantics><mrow><mi>f</mi><mo>∈</mo><mi class="ltx_font_mathcaligraphic">ℱ</mi></mrow><annotation encoding="application/x-tex">f\in\mathcal{F}</annotation></semantics></math>,</span></p>
<table id="S6.EGx207" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="S6.Ex334"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S6.Ex334.m1" class="ltx_Math" alttext="\displaystyle\left\|Y-\widehat{f}\ \right\|_{m}^{2}\leq\|Y-f\|_{m}^{2}." display="inline" intent=":literal"><semantics><mrow><mrow><msubsup><mrow><mo>‖</mo><mrow><mi>Y</mi><mo>−</mo><mover accent="true"><mi>f</mi><mo>^</mo></mover></mrow><mo>‖</mo></mrow><mi>m</mi><mn>2</mn></msubsup><mo>≤</mo><msubsup><mrow><mo stretchy="false">‖</mo><mrow><mi>Y</mi><mo>−</mo><mi>f</mi></mrow><mo stretchy="false">‖</mo></mrow><mi>m</mi><mn>2</mn></msubsup></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\left\|Y-\widehat{f}\ \right\|_{m}^{2}\leq\|Y-f\|_{m}^{2}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S6.p8.2" class="ltx_p"><span id="S6.p8.2.1" class="ltx_text">By substituting <math id="S6.p8.m7" class="ltx_Math" alttext="Y_{i}=f_{0}(X_{i})+\xi_{i}" display="inline" intent=":literal"><semantics><mrow><msub><mi>Y</mi><mi>i</mi></msub><mo>=</mo><mrow><mrow><msub><mi>f</mi><mn>0</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>X</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><msub><mi>ξ</mi><mi>i</mi></msub></mrow></mrow><annotation encoding="application/x-tex">Y_{i}=f_{0}(X_{i})+\xi_{i}</annotation></semantics></math>, we obtain the base inequality as</span></p>
<table id="S6.Ex335" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S6.Ex335.m1" class="ltx_Math" alttext="\left\|\widehat{f}-f_{0}\right\|_{m}^{2}\leq\left\|f-f_{0}\right\|_{m}^{2}+\frac{2}{m}\sum_{i=1}^{m}\xi_{i}\left(\hat{f}(X_{i})-f(X_{i})\right),\quad f\in\mathcal{F}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><msubsup><mrow><mo>‖</mo><mrow><mover accent="true"><mi>f</mi><mo>^</mo></mover><mo>−</mo><msub><mi>f</mi><mn>0</mn></msub></mrow><mo>‖</mo></mrow><mi>m</mi><mn>2</mn></msubsup><mo>≤</mo><mrow><msubsup><mrow><mo>‖</mo><mrow><mi>f</mi><mo>−</mo><msub><mi>f</mi><mn>0</mn></msub></mrow><mo>‖</mo></mrow><mi>m</mi><mn>2</mn></msubsup><mo>+</mo><mrow><mfrac><mn>2</mn><mi>m</mi></mfrac><mo lspace="0em" rspace="0em">​</mo><mrow><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>m</mi></munderover><mrow><msub><mi>ξ</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mrow><mover accent="true"><mi>f</mi><mo>^</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>X</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mi>f</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>X</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>)</mo></mrow></mrow></mrow></mrow></mrow></mrow><mo rspace="1.167em">,</mo><mrow><mi>f</mi><mo>∈</mo><mi class="ltx_font_mathcaligraphic">ℱ</mi></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\left\|\widehat{f}-f_{0}\right\|_{m}^{2}\leq\left\|f-f_{0}\right\|_{m}^{2}+\frac{2}{m}\sum_{i=1}^{m}\xi_{i}\left(\hat{f}(X_{i})-f(X_{i})\right),\quad f\in\mathcal{F}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S6.p8.3" class="ltx_p"><span id="S6.p8.3.1" class="ltx_text">Setting <math id="S6.p8.m8" class="ltx_Math" alttext="f=f^{*}" display="inline" intent=":literal"><semantics><mrow><mi>f</mi><mo>=</mo><msup><mi>f</mi><mo>∗</mo></msup></mrow><annotation encoding="application/x-tex">f=f^{*}</annotation></semantics></math> in the above inequality, we have</span></p>
<table id="S6.Ex336" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S6.Ex336.m1" class="ltx_Math" alttext="\left\|\widehat{f}-f_{0}\right\|_{m}^{2}\leq\left\|f^{*}-f_{0}\right\|_{m}^{2}+\frac{2}{m}\sum_{i=1}^{m}\xi_{i}\left(\widehat{f}(X_{i})-f^{*}(X_{i})\right)," display="block" intent=":literal"><semantics><mrow><mrow><msubsup><mrow><mo>‖</mo><mrow><mover accent="true"><mi>f</mi><mo>^</mo></mover><mo>−</mo><msub><mi>f</mi><mn>0</mn></msub></mrow><mo>‖</mo></mrow><mi>m</mi><mn>2</mn></msubsup><mo>≤</mo><mrow><msubsup><mrow><mo>‖</mo><mrow><msup><mi>f</mi><mo>∗</mo></msup><mo>−</mo><msub><mi>f</mi><mn>0</mn></msub></mrow><mo>‖</mo></mrow><mi>m</mi><mn>2</mn></msubsup><mo>+</mo><mrow><mfrac><mn>2</mn><mi>m</mi></mfrac><mo lspace="0em" rspace="0em">​</mo><mrow><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>m</mi></munderover><mrow><msub><mi>ξ</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mrow><mover accent="true"><mi>f</mi><mo>^</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>X</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msup><mi>f</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>X</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>)</mo></mrow></mrow></mrow></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\left\|\widehat{f}-f_{0}\right\|_{m}^{2}\leq\left\|f^{*}-f_{0}\right\|_{m}^{2}+\frac{2}{m}\sum_{i=1}^{m}\xi_{i}\left(\widehat{f}(X_{i})-f^{*}(X_{i})\right),</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S6.p8.4" class="ltx_p"><span id="S6.p8.4.1" class="ltx_text">from which we derive that</span></p>
<table id="S6.EGx208" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="S6.Ex337"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S6.Ex337.m1" class="ltx_Math" alttext="\displaystyle\left\|\widehat{f}-f^{*}\right\|_{m}^{2}" display="inline" intent=":literal"><semantics><msubsup><mrow><mo>‖</mo><mrow><mover accent="true"><mi>f</mi><mo>^</mo></mover><mo>−</mo><msup><mi>f</mi><mo>∗</mo></msup></mrow><mo>‖</mo></mrow><mi>m</mi><mn>2</mn></msubsup><annotation encoding="application/x-tex">\displaystyle\left\|\widehat{f}-f^{*}\right\|_{m}^{2}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S6.Ex337.m2" class="ltx_Math" alttext="\displaystyle\leq 2\left\|\widehat{f}-f_{0}\right\|_{m}^{2}+2\left\|f^{*}-f_{0}\right\|_{m}^{2}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≤</mo><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msubsup><mrow><mo>‖</mo><mrow><mover accent="true"><mi>f</mi><mo>^</mo></mover><mo>−</mo><msub><mi>f</mi><mn>0</mn></msub></mrow><mo>‖</mo></mrow><mi>m</mi><mn>2</mn></msubsup></mrow><mo>+</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msubsup><mrow><mo>‖</mo><mrow><msup><mi>f</mi><mo>∗</mo></msup><mo>−</mo><msub><mi>f</mi><mn>0</mn></msub></mrow><mo>‖</mo></mrow><mi>m</mi><mn>2</mn></msubsup></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\leq 2\left\|\widehat{f}-f_{0}\right\|_{m}^{2}+2\left\|f^{*}-f_{0}\right\|_{m}^{2}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="S6.E29"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S6.E29.m1" class="ltx_Math" alttext="\displaystyle\leq 4\|f^{*}-f_{0}\|_{m}^{2}+4\sup_{g\in G_{\delta}}\left|\frac{1}{n}\sum_{i=1}^{n}\xi_{i}g(X_{i})\right|," display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>≤</mo><mrow><mrow><mn>4</mn><mo lspace="0em" rspace="0em">​</mo><msubsup><mrow><mo stretchy="false">‖</mo><mrow><msup><mi>f</mi><mo>∗</mo></msup><mo>−</mo><msub><mi>f</mi><mn>0</mn></msub></mrow><mo stretchy="false">‖</mo></mrow><mi>m</mi><mn>2</mn></msubsup></mrow><mo>+</mo><mrow><mn>4</mn><mo lspace="0.167em" rspace="0em">​</mo><mrow><munder><mo movablelimits="false" rspace="0em">sup</mo><mrow><mi>g</mi><mo>∈</mo><msub><mi>G</mi><mi>δ</mi></msub></mrow></munder><mrow><mo>|</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>n</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>n</mi></munderover></mstyle><mrow><msub><mi>ξ</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi>g</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>X</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo>|</mo></mrow></mrow></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\leq 4\|f^{*}-f_{0}\|_{m}^{2}+4\sup_{g\in G_{\delta}}\left|\frac{1}{n}\sum_{i=1}^{n}\xi_{i}g(X_{i})\right|,</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(29)</span></td></tr></tbody>
</table>
<p id="S6.p8.5" class="ltx_p"><span id="S6.p8.5.1" class="ltx_text">where</span></p>
<table id="S6.EGx209" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="S6.Ex338"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S6.Ex338.m1" class="ltx_math_unparsed" alttext="\displaystyle\mathcal{G}_{\delta}:=\left\{g:g=f-f^{\prime},\|g\|_{L^{\infty}(\mu)}\leq\delta,f,f^{\prime}\in\mathcal{F}\right\}." display="inline" intent=":literal"><semantics><mrow><msub><mi class="ltx_font_mathcaligraphic">𝒢</mi><mi>δ</mi></msub><mo>:=</mo><mrow><mo>{</mo><mi>g</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mi>g</mi><mo>=</mo><mi>f</mi><mo>−</mo><msup><mi>f</mi><mo>′</mo></msup><mo>,</mo><mo lspace="0em" rspace="0.167em">∥</mo><mi>g</mi><msub><mo lspace="0em" rspace="0.0835em">∥</mo><mrow><msup><mi>L</mi><mi mathvariant="normal">∞</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>μ</mi><mo stretchy="false">)</mo></mrow></mrow></msub><mo lspace="0.0835em">≤</mo><mi>δ</mi><mo>,</mo><mi>f</mi><mo>,</mo><msup><mi>f</mi><mo>′</mo></msup><mo>∈</mo><mi class="ltx_font_mathcaligraphic">ℱ</mi><mo>}</mo></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\mathcal{G}_{\delta}:=\left\{g:g=f-f^{\prime},\|g\|_{L^{\infty}(\mu)}\leq\delta,f,f^{\prime}\in\mathcal{F}\right\}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S6.p8.6" class="ltx_p"><span id="S6.p8.6.1" class="ltx_text">For <math id="S6.p8.m9" class="ltx_Math" alttext="g\in\mathcal{G}_{\delta}" display="inline" intent=":literal"><semantics><mrow><mi>g</mi><mo>∈</mo><msub><mi class="ltx_font_mathcaligraphic">𝒢</mi><mi>δ</mi></msub></mrow><annotation encoding="application/x-tex">g\in\mathcal{G}_{\delta}</annotation></semantics></math>, denote
<math id="S6.p8.m10" class="ltx_Math" alttext="Z_{g}:=\frac{1}{n}\sum_{i=1}^{n}\xi_{i}g(X_{i})" display="inline" intent=":literal"><semantics><mrow><msub><mi>Z</mi><mi>g</mi></msub><mo>:=</mo><mrow><mfrac><mn>1</mn><mi>n</mi></mfrac><mo lspace="0em" rspace="0em">​</mo><mrow><msubsup><mo>∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>n</mi></msubsup><mrow><msub><mi>ξ</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi>g</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>X</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">Z_{g}:=\frac{1}{n}\sum_{i=1}^{n}\xi_{i}g(X_{i})</annotation></semantics></math>. It is easy to see that <math id="S6.p8.m11" class="ltx_Math" alttext="\{Z_{g}\}_{g\in\mathcal{G}_{\delta}}" display="inline" intent=":literal"><semantics><msub><mrow><mo stretchy="false">{</mo><msub><mi>Z</mi><mi>g</mi></msub><mo stretchy="false">}</mo></mrow><mrow><mi>g</mi><mo>∈</mo><msub><mi class="ltx_font_mathcaligraphic">𝒢</mi><mi>δ</mi></msub></mrow></msub><annotation encoding="application/x-tex">\{Z_{g}\}_{g\in\mathcal{G}_{\delta}}</annotation></semantics></math> is a centred Gaussian process and</span></p>
<table id="S6.EGx210" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="S6.Ex339"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S6.Ex339.m1" class="ltx_Math" alttext="\displaystyle\mathbb{E}|Z_{g}|^{2}=\mathrm{Var}(Z_{g})=\frac{\sigma^{2}}{m^{2}}\sum_{i=1}^{m}g^{2}(X_{i})\leq\frac{\sigma^{2}\delta^{2}}{m}." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mi>𝔼</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">|</mo><msub><mi>Z</mi><mi>g</mi></msub><mo stretchy="false">|</mo></mrow><mn>2</mn></msup></mrow><mo>=</mo><mrow><mi>Var</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>Z</mi><mi>g</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mstyle displaystyle="true"><mfrac><msup><mi>σ</mi><mn>2</mn></msup><msup><mi>m</mi><mn>2</mn></msup></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>m</mi></munderover></mstyle><mrow><msup><mi>g</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>X</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo>≤</mo><mstyle displaystyle="true"><mfrac><mrow><msup><mi>σ</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>δ</mi><mn>2</mn></msup></mrow><mi>m</mi></mfrac></mstyle></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\mathbb{E}|Z_{g}|^{2}=\mathrm{Var}(Z_{g})=\frac{\sigma^{2}}{m^{2}}\sum_{i=1}^{m}g^{2}(X_{i})\leq\frac{\sigma^{2}\delta^{2}}{m}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S6.p8.7" class="ltx_p"><span id="S6.p8.7.1" class="ltx_text">According to Lemma <a href="#Thmlemma22" title="Lemma 22 (Borell-Sudakov-Tsirelson concentration inequality). ‣ 6 Proof of Proposition ‣ Standard Transformers Achieve the Minimax Rate in Nonparametric Regression with 𝐶^{𝑠,𝜆} Targets" class="ltx_ref"><span class="ltx_text ltx_ref_tag">22</span></a>,</span></p>
<table id="S6.EGx211" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="S6.Ex340"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S6.Ex340.m1" class="ltx_Math" alttext="\displaystyle\mathbb{P}\left(\sup_{g\in G_{\delta}}\left|\frac{1}{m}\sum_{i=1}^{m}\xi_{i}g(X_{i})\right|\geq\mathbb{E}\left[\sup_{g\in G_{\delta}}\left|\frac{1}{m}\sum_{i=1}^{m}\xi_{i}g(X_{i})\right|\right]+2^{-7}\delta^{2}\right)" display="inline" intent=":literal"><semantics><mrow><mi>ℙ</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mrow><munder><mo lspace="0em" movablelimits="false" rspace="0em">sup</mo><mrow><mi>g</mi><mo>∈</mo><msub><mi>G</mi><mi>δ</mi></msub></mrow></munder><mrow><mo>|</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>m</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>m</mi></munderover></mstyle><mrow><msub><mi>ξ</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi>g</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>X</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo>|</mo></mrow></mrow><mo>≥</mo><mrow><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><mrow><munder><mo lspace="0em" movablelimits="false" rspace="0em">sup</mo><mrow><mi>g</mi><mo>∈</mo><msub><mi>G</mi><mi>δ</mi></msub></mrow></munder><mrow><mo>|</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>m</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>m</mi></munderover></mstyle><mrow><msub><mi>ξ</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi>g</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>X</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo>|</mo></mrow></mrow><mo>]</mo></mrow></mrow><mo>+</mo><mrow><msup><mn>2</mn><mrow><mo>−</mo><mn>7</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>δ</mi><mn>2</mn></msup></mrow></mrow></mrow><mo>)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\mathbb{P}\left(\sup_{g\in G_{\delta}}\left|\frac{1}{m}\sum_{i=1}^{m}\xi_{i}g(X_{i})\right|\geq\mathbb{E}\left[\sup_{g\in G_{\delta}}\left|\frac{1}{m}\sum_{i=1}^{m}\xi_{i}g(X_{i})\right|\right]+2^{-7}\delta^{2}\right)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="S6.E30"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S6.E30.m1" class="ltx_Math" alttext="\displaystyle\leq\exp\left(-\frac{m\delta^{2}}{2^{15}\sigma^{2}}\right)\leq\exp\left(-2m^{d/(2\gamma+d)}\right)." display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>≤</mo><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mo>−</mo><mstyle displaystyle="true"><mfrac><mrow><mi>m</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>δ</mi><mn>2</mn></msup></mrow><mrow><msup><mn>2</mn><mn>15</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>σ</mi><mn>2</mn></msup></mrow></mfrac></mstyle></mrow><mo>)</mo></mrow></mrow><mo>≤</mo><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mo>−</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msup><mi>m</mi><mrow><mi>d</mi><mo>/</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>γ</mi></mrow><mo>+</mo><mi>d</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></msup></mrow></mrow><mo>)</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\leq\exp\left(-\frac{m\delta^{2}}{2^{15}\sigma^{2}}\right)\leq\exp\left(-2m^{d/(2\gamma+d)}\right).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(30)</span></td></tr></tbody>
</table>
</div>
<div id="S6.p9" class="ltx_para">
<p id="S6.p9.1" class="ltx_p"><span id="S6.p9.1.1" class="ltx_text">For <math id="S6.p9.m1" class="ltx_Math" alttext="g\in\mathcal{G}_{\delta}" display="inline" intent=":literal"><semantics><mrow><mi>g</mi><mo>∈</mo><msub><mi class="ltx_font_mathcaligraphic">𝒢</mi><mi>δ</mi></msub></mrow><annotation encoding="application/x-tex">g\in\mathcal{G}_{\delta}</annotation></semantics></math>, denote
<math id="S6.p9.m2" class="ltx_Math" alttext="\bar{Z}_{g}:=\frac{1}{\sqrt{m}}\sum_{i=1}^{m}g(X_{i})\frac{\xi_{i}}{\sigma}" display="inline" intent=":literal"><semantics><mrow><msub><mover accent="true"><mi>Z</mi><mo>¯</mo></mover><mi>g</mi></msub><mo>:=</mo><mrow><mfrac><mn>1</mn><msqrt><mi>m</mi></msqrt></mfrac><mo lspace="0em" rspace="0em">​</mo><mrow><msubsup><mo>∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>m</mi></msubsup><mrow><mrow><mi>g</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>X</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><mfrac><msub><mi>ξ</mi><mi>i</mi></msub><mi>σ</mi></mfrac></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\bar{Z}_{g}:=\frac{1}{\sqrt{m}}\sum_{i=1}^{m}g(X_{i})\frac{\xi_{i}}{\sigma}</annotation></semantics></math>. Since <math id="S6.p9.m3" class="ltx_Math" alttext="\{\xi_{i}\}_{i=1}^{m}" display="inline" intent=":literal"><semantics><msubsup><mrow><mo stretchy="false">{</mo><msub><mi>ξ</mi><mi>i</mi></msub><mo stretchy="false">}</mo></mrow><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>m</mi></msubsup><annotation encoding="application/x-tex">\{\xi_{i}\}_{i=1}^{m}</annotation></semantics></math> are centred Gaussian variables with variances <math id="S6.p9.m4" class="ltx_Math" alttext="\sigma^{2}" display="inline" intent=":literal"><semantics><msup><mi>σ</mi><mn>2</mn></msup><annotation encoding="application/x-tex">\sigma^{2}</annotation></semantics></math>, we have</span></p>
<table id="S6.EGx212" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="S6.Ex341"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S6.Ex341.m1" class="ltx_Math" alttext="\displaystyle\mathbb{E}e^{\lambda(\bar{Z}_{g}-\bar{Z}_{h})}" display="inline" intent=":literal"><semantics><mrow><mi>𝔼</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>e</mi><mrow><mi>λ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mover accent="true"><mi>Z</mi><mo>¯</mo></mover><mi>g</mi></msub><mo>−</mo><msub><mover accent="true"><mi>Z</mi><mo>¯</mo></mover><mi>h</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow></msup></mrow><annotation encoding="application/x-tex">\displaystyle\mathbb{E}e^{\lambda(\bar{Z}_{g}-\bar{Z}_{h})}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S6.Ex341.m2" class="ltx_Math" alttext="\displaystyle=\mathbb{E}e^{\lambda\frac{1}{\sqrt{m}}\sum_{i=1}^{m}[g(X_{i})-h(X_{i})]\frac{\xi_{i}}{\sigma}}=\prod_{i=1}^{m}\mathbb{E}e^{\lambda\frac{1}{\sqrt{n}}[g(X_{i})-h(X_{i})]\frac{\xi_{i}}{\sigma}}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mi>𝔼</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>e</mi><mrow><mi>λ</mi><mo lspace="0em" rspace="0em">​</mo><mfrac><mn>1</mn><msqrt><mi>m</mi></msqrt></mfrac><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="false"><msubsup><mo maxsize="0.700em" minsize="0.700em" stretchy="true">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>m</mi></msubsup></mstyle><mrow><mrow><mo stretchy="false">[</mo><mrow><mrow><mi>g</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>X</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mi>h</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>X</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">]</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mfrac><msub><mi>ξ</mi><mi>i</mi></msub><mi>σ</mi></mfrac></mrow></mrow></mrow></msup></mrow><mo>=</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∏</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>m</mi></munderover></mstyle><mrow><mi>𝔼</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>e</mi><mrow><mi>λ</mi><mo lspace="0em" rspace="0em">​</mo><mfrac><mn>1</mn><msqrt><mi>n</mi></msqrt></mfrac><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mrow><mrow><mi>g</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>X</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mi>h</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>X</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">]</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mfrac><msub><mi>ξ</mi><mi>i</mi></msub><mi>σ</mi></mfrac></mrow></msup></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\mathbb{E}e^{\lambda\frac{1}{\sqrt{m}}\sum_{i=1}^{m}[g(X_{i})-h(X_{i})]\frac{\xi_{i}}{\sigma}}=\prod_{i=1}^{m}\mathbb{E}e^{\lambda\frac{1}{\sqrt{n}}[g(X_{i})-h(X_{i})]\frac{\xi_{i}}{\sigma}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="S6.Ex342"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S6.Ex342.m1" class="ltx_Math" alttext="\displaystyle\leq\prod_{i=1}^{m}e^{\lambda^{2}\frac{1}{2m}[g(X_{i})-h(X_{i})]^{2}}\leq e^{\lambda^{2}\|g-h\|_{L^{\infty}(\mu)}/2}," display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>≤</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∏</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>m</mi></munderover></mstyle><msup><mi>e</mi><mrow><msup><mi>λ</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mfrac><mn>1</mn><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>m</mi></mrow></mfrac><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">[</mo><mrow><mrow><mi>g</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>X</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mi>h</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>X</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">]</mo></mrow><mn>2</mn></msup></mrow></msup></mrow><mo>≤</mo><msup><mi>e</mi><mrow><mrow><msup><mi>λ</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">‖</mo><mrow><mi>g</mi><mo>−</mo><mi>h</mi></mrow><mo stretchy="false">‖</mo></mrow><mrow><msup><mi>L</mi><mi mathvariant="normal">∞</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>μ</mi><mo stretchy="false">)</mo></mrow></mrow></msub></mrow><mo>/</mo><mn>2</mn></mrow></msup></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\leq\prod_{i=1}^{m}e^{\lambda^{2}\frac{1}{2m}[g(X_{i})-h(X_{i})]^{2}}\leq e^{\lambda^{2}\|g-h\|_{L^{\infty}(\mu)}/2},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S6.p9.2" class="ltx_p"><span id="S6.p9.2.1" class="ltx_text">which implies that <math id="S6.p9.m5" class="ltx_Math" alttext="\{\bar{Z}_{g}\}_{g\in\mathcal{G}_{\delta}}" display="inline" intent=":literal"><semantics><msub><mrow><mo stretchy="false">{</mo><msub><mover accent="true"><mi>Z</mi><mo>¯</mo></mover><mi>g</mi></msub><mo stretchy="false">}</mo></mrow><mrow><mi>g</mi><mo>∈</mo><msub><mi class="ltx_font_mathcaligraphic">𝒢</mi><mi>δ</mi></msub></mrow></msub><annotation encoding="application/x-tex">\{\bar{Z}_{g}\}_{g\in\mathcal{G}_{\delta}}</annotation></semantics></math> is a sub-gaussian process relative to distance <math id="S6.p9.m6" class="ltx_math_unparsed" alttext="\|\cdot\|_{L^{\infty}(\mu)}" display="inline" intent=":literal"><semantics><mrow><mo rspace="0em">∥</mo><mo lspace="0em" rspace="0em">⋅</mo><mo lspace="0em">∥</mo><msub><mrow></mrow><mrow><msup><mi>L</mi><mi mathvariant="normal">∞</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>μ</mi><mo stretchy="false">)</mo></mrow></mrow></msub></mrow><annotation encoding="application/x-tex">\|\cdot\|_{L^{\infty}(\mu)}</annotation></semantics></math>. Applying Lemma <a href="#Thmlemma23" title="Lemma 23. ‣ 6 Proof of Proposition ‣ Standard Transformers Achieve the Minimax Rate in Nonparametric Regression with 𝐶^{𝑠,𝜆} Targets" class="ltx_ref"><span class="ltx_text ltx_ref_tag">23</span></a> to <math id="S6.p9.m7" class="ltx_Math" alttext="\{\bar{Z}_{g}\}_{g\in\mathcal{G}_{\delta}}" display="inline" intent=":literal"><semantics><msub><mrow><mo stretchy="false">{</mo><msub><mover accent="true"><mi>Z</mi><mo>¯</mo></mover><mi>g</mi></msub><mo stretchy="false">}</mo></mrow><mrow><mi>g</mi><mo>∈</mo><msub><mi class="ltx_font_mathcaligraphic">𝒢</mi><mi>δ</mi></msub></mrow></msub><annotation encoding="application/x-tex">\{\bar{Z}_{g}\}_{g\in\mathcal{G}_{\delta}}</annotation></semantics></math> and noting that <math id="S6.p9.m8" class="ltx_math_unparsed" alttext="\mathcal{N}(\varsigma,\mathcal{G}_{\delta},\|\cdot\|_{L^{\infty}(\mu)})\leq\mathcal{N}(\varsigma/2,\mathcal{F},\|\cdot\|_{L^{\infty}(\mu)})^{2}" display="inline" intent=":literal"><semantics><mrow><mi class="ltx_font_mathcaligraphic">𝒩</mi><mrow><mo stretchy="false">(</mo><mi>ς</mi><mo>,</mo><msub><mi class="ltx_font_mathcaligraphic">𝒢</mi><mi>δ</mi></msub><mo>,</mo><mo lspace="0em" rspace="0em">∥</mo><mo lspace="0em" rspace="0em">⋅</mo><msub><mo lspace="0em" rspace="0.167em">∥</mo><mrow><msup><mi>L</mi><mi mathvariant="normal">∞</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>μ</mi><mo stretchy="false">)</mo></mrow></mrow></msub><mo stretchy="false">)</mo></mrow><mo>≤</mo><mi class="ltx_font_mathcaligraphic">𝒩</mi><msup><mrow><mo stretchy="false">(</mo><mi>ς</mi><mo>/</mo><mn>2</mn><mo>,</mo><mi class="ltx_font_mathcaligraphic">ℱ</mi><mo>,</mo><mo lspace="0em" rspace="0em">∥</mo><mo lspace="0em" rspace="0em">⋅</mo><msub><mo lspace="0em" rspace="0.167em">∥</mo><mrow><msup><mi>L</mi><mi mathvariant="normal">∞</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>μ</mi><mo stretchy="false">)</mo></mrow></mrow></msub><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mrow><annotation encoding="application/x-tex">\mathcal{N}(\varsigma,\mathcal{G}_{\delta},\|\cdot\|_{L^{\infty}(\mu)})\leq\mathcal{N}(\varsigma/2,\mathcal{F},\|\cdot\|_{L^{\infty}(\mu)})^{2}</annotation></semantics></math>, we have</span></p>
<table id="S6.EGx213" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="S6.Ex343"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S6.Ex343.m1" class="ltx_Math" alttext="\displaystyle\mathbb{E}\sup_{g\in\mathcal{G}_{\delta}}|\bar{Z}_{g}|" display="inline" intent=":literal"><semantics><mrow><mi>𝔼</mi><mo lspace="0.167em" rspace="0em">​</mo><mrow><munder><mo movablelimits="false" rspace="0em">sup</mo><mrow><mi>g</mi><mo>∈</mo><msub><mi class="ltx_font_mathcaligraphic">𝒢</mi><mi>δ</mi></msub></mrow></munder><mrow><mo stretchy="false">|</mo><msub><mover accent="true"><mi>Z</mi><mo>¯</mo></mover><mi>g</mi></msub><mo stretchy="false">|</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\mathbb{E}\sup_{g\in\mathcal{G}_{\delta}}|\bar{Z}_{g}|</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S6.Ex343.m2" class="ltx_Math" alttext="\displaystyle\leq 4\sqrt{2}\int_{0}^{\delta}\sqrt{\log 2\mathcal{N}(\varsigma,\mathcal{G}_{\delta},\|\cdot\|_{L^{\infty}(\mu)})}\,d\varsigma" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≤</mo><mrow><mn>4</mn><mo lspace="0em" rspace="0em">​</mo><msqrt><mn>2</mn></msqrt><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><msubsup><mo>∫</mo><mn>0</mn><mi>δ</mi></msubsup></mstyle><mrow><msqrt><mrow><mi>log</mi><mn>2</mn><mi class="ltx_font_mathcaligraphic">𝒩</mi><mo stretchy="false">(</mo><mi>ς</mi><mo>,</mo><mi class="ltx_font_mathcaligraphic">𝒢</mi><msub><mrow></mrow><mi>δ</mi></msub><mo>,</mo><mo lspace="0em" rspace="0em">∥</mo><mo lspace="0em" rspace="0em">⋅</mo><mo lspace="0em" rspace="0.167em">∥</mo><msub><mrow></mrow><mrow><msup><mi>L</mi><mi mathvariant="normal">∞</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>μ</mi><mo stretchy="false">)</mo></mrow></mrow></msub><mo stretchy="false">)</mo></mrow></msqrt><mo lspace="0.170em" rspace="0em">​</mo><mrow><mo rspace="0em">𝑑</mo><mi>ς</mi></mrow></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\leq 4\sqrt{2}\int_{0}^{\delta}\sqrt{\log 2\mathcal{N}(\varsigma,\mathcal{G}_{\delta},\|\cdot\|_{L^{\infty}(\mu)})}\,d\varsigma</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="S6.Ex344"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S6.Ex344.m1" class="ltx_Math" alttext="\displaystyle\leq 4\sqrt{2}\int_{0}^{\delta}\sqrt{\log 2\mathcal{N}(\varsigma/2,\mathcal{F},\|\cdot\|_{L^{\infty}(\mu)})^{2}}\,d\varsigma." display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>≤</mo><mrow><mn>4</mn><mo lspace="0em" rspace="0em">​</mo><msqrt><mn>2</mn></msqrt><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><msubsup><mo>∫</mo><mn>0</mn><mi>δ</mi></msubsup></mstyle><mrow><msqrt><mrow><mi>log</mi><mn>2</mn><mi class="ltx_font_mathcaligraphic">𝒩</mi><mo stretchy="false">(</mo><mi>ς</mi><mo>/</mo><mn>2</mn><mo>,</mo><mi class="ltx_font_mathcaligraphic">ℱ</mi><mo>,</mo><mo lspace="0em" rspace="0em">∥</mo><mo lspace="0em" rspace="0em">⋅</mo><mo lspace="0em" rspace="0.167em">∥</mo><msub><mrow></mrow><mrow><msup><mi>L</mi><mi mathvariant="normal">∞</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>μ</mi><mo stretchy="false">)</mo></mrow></mrow></msub><mo stretchy="false">)</mo><msup><mrow></mrow><mn>2</mn></msup></mrow></msqrt><mo lspace="0.170em" rspace="0em">​</mo><mrow><mo rspace="0em">𝑑</mo><mi>ς</mi></mrow></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\leq 4\sqrt{2}\int_{0}^{\delta}\sqrt{\log 2\mathcal{N}(\varsigma/2,\mathcal{F},\|\cdot\|_{L^{\infty}(\mu)})^{2}}\,d\varsigma.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S6.p9.3" class="ltx_p"><span id="S6.p9.3.1" class="ltx_text">It follows directly that</span></p>
<table id="S6.EGx214" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="S6.E31"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S6.E31.m1" class="ltx_Math" alttext="\displaystyle\mathbb{E}\left[\sup_{g\in\mathcal{G}_{\delta}}\left|\frac{1}{m}\sum_{i=1}^{m}\xi_{i}g(X_{i})\right|\right]\leq\frac{4\sqrt{2}\sigma}{\sqrt{m}}\int_{0}^{\delta}\sqrt{\log 2\mathcal{N}(\varsigma/2,\mathcal{F},\|\cdot\|_{L^{\infty}(\mu)})^{2}}\,d\varsigma." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><mrow><munder><mo lspace="0em" movablelimits="false" rspace="0em">sup</mo><mrow><mi>g</mi><mo>∈</mo><msub><mi class="ltx_font_mathcaligraphic">𝒢</mi><mi>δ</mi></msub></mrow></munder><mrow><mo>|</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>m</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>m</mi></munderover></mstyle><mrow><msub><mi>ξ</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi>g</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>X</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo>|</mo></mrow></mrow><mo>]</mo></mrow></mrow><mo>≤</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mn>4</mn><mo lspace="0em" rspace="0em">​</mo><msqrt><mn>2</mn></msqrt><mo lspace="0em" rspace="0em">​</mo><mi>σ</mi></mrow><msqrt><mi>m</mi></msqrt></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><msubsup><mo>∫</mo><mn>0</mn><mi>δ</mi></msubsup></mstyle><mrow><msqrt><mrow><mi>log</mi><mn>2</mn><mi class="ltx_font_mathcaligraphic">𝒩</mi><mo stretchy="false">(</mo><mi>ς</mi><mo>/</mo><mn>2</mn><mo>,</mo><mi class="ltx_font_mathcaligraphic">ℱ</mi><mo>,</mo><mo lspace="0em" rspace="0em">∥</mo><mo lspace="0em" rspace="0em">⋅</mo><mo lspace="0em" rspace="0.167em">∥</mo><msub><mrow></mrow><mrow><msup><mi>L</mi><mi mathvariant="normal">∞</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>μ</mi><mo stretchy="false">)</mo></mrow></mrow></msub><mo stretchy="false">)</mo><msup><mrow></mrow><mn>2</mn></msup></mrow></msqrt><mo lspace="0.170em" rspace="0em">​</mo><mrow><mo rspace="0em">𝑑</mo><mi>ς</mi></mrow></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\mathbb{E}\left[\sup_{g\in\mathcal{G}_{\delta}}\left|\frac{1}{m}\sum_{i=1}^{m}\xi_{i}g(X_{i})\right|\right]\leq\frac{4\sqrt{2}\sigma}{\sqrt{m}}\int_{0}^{\delta}\sqrt{\log 2\mathcal{N}(\varsigma/2,\mathcal{F},\|\cdot\|_{L^{\infty}(\mu)})^{2}}\,d\varsigma.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(31)</span></td></tr></tbody>
</table>
<p id="S6.p9.4" class="ltx_p"><span id="S6.p9.4.1" class="ltx_text">Combining (<a href="#S6.E30" title="In Proof of Proposition . ‣ 6 Proof of Proposition ‣ Standard Transformers Achieve the Minimax Rate in Nonparametric Regression with 𝐶^{𝑠,𝜆} Targets" class="ltx_ref"><span class="ltx_text ltx_ref_tag">30</span></a>) and (<a href="#S6.E31" title="In Proof of Proposition . ‣ 6 Proof of Proposition ‣ Standard Transformers Achieve the Minimax Rate in Nonparametric Regression with 𝐶^{𝑠,𝜆} Targets" class="ltx_ref"><span class="ltx_text ltx_ref_tag">31</span></a>) yields that</span></p>
<table id="S6.EGx215" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="S6.Ex345"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S6.Ex345.m1" class="ltx_Math" alttext="\displaystyle\sup_{g\in G_{\delta}}\left|\frac{1}{m}\sum_{i=1}^{m}\xi_{i}g(X_{i})\right|" display="inline" intent=":literal"><semantics><mrow><munder><mo movablelimits="false">sup</mo><mrow><mi>g</mi><mo>∈</mo><msub><mi>G</mi><mi>δ</mi></msub></mrow></munder><mrow><mo lspace="0em">|</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>m</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>m</mi></munderover></mstyle><mrow><msub><mi>ξ</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi>g</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>X</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo>|</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\sup_{g\in G_{\delta}}\left|\frac{1}{m}\sum_{i=1}^{m}\xi_{i}g(X_{i})\right|</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S6.Ex345.m2" class="ltx_Math" alttext="\displaystyle\leq\frac{4\sqrt{2}\sigma}{\sqrt{m}}\int_{0}^{\delta}\sqrt{\log 2\mathcal{N}(\varsigma/2,\mathcal{F},\|\cdot\|_{L^{\infty}(\mu)})^{2}}\,d\varsigma+2^{-7}\delta^{2}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≤</mo><mrow><mrow><mstyle displaystyle="true"><mfrac><mrow><mn>4</mn><mo lspace="0em" rspace="0em">​</mo><msqrt><mn>2</mn></msqrt><mo lspace="0em" rspace="0em">​</mo><mi>σ</mi></mrow><msqrt><mi>m</mi></msqrt></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><msubsup><mo>∫</mo><mn>0</mn><mi>δ</mi></msubsup></mstyle><mrow><msqrt><mrow><mi>log</mi><mn>2</mn><mi class="ltx_font_mathcaligraphic">𝒩</mi><mo stretchy="false">(</mo><mi>ς</mi><mo>/</mo><mn>2</mn><mo>,</mo><mi class="ltx_font_mathcaligraphic">ℱ</mi><mo>,</mo><mo lspace="0em" rspace="0em">∥</mo><mo lspace="0em" rspace="0em">⋅</mo><mo lspace="0em" rspace="0.167em">∥</mo><msub><mrow></mrow><mrow><msup><mi>L</mi><mi mathvariant="normal">∞</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>μ</mi><mo stretchy="false">)</mo></mrow></mrow></msub><mo stretchy="false">)</mo><msup><mrow></mrow><mn>2</mn></msup></mrow></msqrt><mo lspace="0.170em" rspace="0em">​</mo><mrow><mo rspace="0em">𝑑</mo><mi>ς</mi></mrow></mrow></mrow></mrow><mo>+</mo><mrow><msup><mn>2</mn><mrow><mo>−</mo><mn>7</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>δ</mi><mn>2</mn></msup></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\leq\frac{4\sqrt{2}\sigma}{\sqrt{m}}\int_{0}^{\delta}\sqrt{\log 2\mathcal{N}(\varsigma/2,\mathcal{F},\|\cdot\|_{L^{\infty}(\mu)})^{2}}\,d\varsigma+2^{-7}\delta^{2}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="S6.Ex346"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S6.Ex346.m1" class="ltx_Math" alttext="\displaystyle=\frac{4\sqrt{2}\sigma\delta}{\sqrt{m}}\int_{0}^{1}\sqrt{\log 2\mathcal{N}(\delta\varsigma/2,\mathcal{F},\|\cdot\|_{L^{\infty}(\mu)})^{2}}\,d\varsigma+2^{-7}\delta^{2}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><mstyle displaystyle="true"><mfrac><mrow><mn>4</mn><mo lspace="0em" rspace="0em">​</mo><msqrt><mn>2</mn></msqrt><mo lspace="0em" rspace="0em">​</mo><mi>σ</mi><mo lspace="0em" rspace="0em">​</mo><mi>δ</mi></mrow><msqrt><mi>m</mi></msqrt></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><msubsup><mo>∫</mo><mn>0</mn><mn>1</mn></msubsup></mstyle><mrow><msqrt><mrow><mi>log</mi><mn>2</mn><mi class="ltx_font_mathcaligraphic">𝒩</mi><mo stretchy="false">(</mo><mi>δ</mi><mi>ς</mi><mo>/</mo><mn>2</mn><mo>,</mo><mi class="ltx_font_mathcaligraphic">ℱ</mi><mo>,</mo><mo lspace="0em" rspace="0em">∥</mo><mo lspace="0em" rspace="0em">⋅</mo><mo lspace="0em" rspace="0.167em">∥</mo><msub><mrow></mrow><mrow><msup><mi>L</mi><mi mathvariant="normal">∞</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>μ</mi><mo stretchy="false">)</mo></mrow></mrow></msub><mo stretchy="false">)</mo><msup><mrow></mrow><mn>2</mn></msup></mrow></msqrt><mo lspace="0.170em" rspace="0em">​</mo><mrow><mo rspace="0em">𝑑</mo><mi>ς</mi></mrow></mrow></mrow></mrow><mo>+</mo><mrow><msup><mn>2</mn><mrow><mo>−</mo><mn>7</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>δ</mi><mn>2</mn></msup></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\frac{4\sqrt{2}\sigma\delta}{\sqrt{m}}\int_{0}^{1}\sqrt{\log 2\mathcal{N}(\delta\varsigma/2,\mathcal{F},\|\cdot\|_{L^{\infty}(\mu)})^{2}}\,d\varsigma+2^{-7}\delta^{2}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="S6.Ex347"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S6.Ex347.m1" class="ltx_Math" alttext="\displaystyle\leq\frac{2^{10}\sigma^{2}}{{m}}\left(\int_{0}^{1}\sqrt{\log 2\mathcal{N}(\delta\varsigma/2,\mathcal{F},\|\cdot\|_{L^{\infty}(\mu)})^{2}}\,d\varsigma\right)^{2}+2^{-6}\delta^{2}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≤</mo><mrow><mrow><mstyle displaystyle="true"><mfrac><mrow><msup><mn>2</mn><mn>10</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>σ</mi><mn>2</mn></msup></mrow><mi>m</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo>(</mo><mrow><mstyle displaystyle="true"><msubsup><mo>∫</mo><mn>0</mn><mn>1</mn></msubsup></mstyle><mrow><msqrt><mrow><mi>log</mi><mn>2</mn><mi class="ltx_font_mathcaligraphic">𝒩</mi><mo stretchy="false">(</mo><mi>δ</mi><mi>ς</mi><mo>/</mo><mn>2</mn><mo>,</mo><mi class="ltx_font_mathcaligraphic">ℱ</mi><mo>,</mo><mo lspace="0em" rspace="0em">∥</mo><mo lspace="0em" rspace="0em">⋅</mo><mo lspace="0em" rspace="0.167em">∥</mo><msub><mrow></mrow><mrow><msup><mi>L</mi><mi mathvariant="normal">∞</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>μ</mi><mo stretchy="false">)</mo></mrow></mrow></msub><mo stretchy="false">)</mo><msup><mrow></mrow><mn>2</mn></msup></mrow></msqrt><mo lspace="0.170em" rspace="0em">​</mo><mrow><mo rspace="0em">𝑑</mo><mi>ς</mi></mrow></mrow></mrow><mo>)</mo></mrow><mn>2</mn></msup></mrow><mo>+</mo><mrow><msup><mn>2</mn><mrow><mo>−</mo><mn>6</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>δ</mi><mn>2</mn></msup></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\leq\frac{2^{10}\sigma^{2}}{{m}}\left(\int_{0}^{1}\sqrt{\log 2\mathcal{N}(\delta\varsigma/2,\mathcal{F},\|\cdot\|_{L^{\infty}(\mu)})^{2}}\,d\varsigma\right)^{2}+2^{-6}\delta^{2}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="S6.Ex348"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S6.Ex348.m1" class="ltx_Math" alttext="\displaystyle\leq\frac{2^{10}\sigma^{2}}{{m}}\left(\int_{0}^{1}\sqrt{\log 2\mathcal{N}(2^{7}\sigma m^{-\gamma/(2\gamma+d)}\varsigma,\mathcal{F},\|\cdot\|_{L^{\infty}(\mu)})^{2}}\,d\varsigma\right)^{2}+2^{-6}\delta^{2}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≤</mo><mrow><mrow><mstyle displaystyle="true"><mfrac><mrow><msup><mn>2</mn><mn>10</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>σ</mi><mn>2</mn></msup></mrow><mi>m</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo>(</mo><mrow><mstyle displaystyle="true"><msubsup><mo>∫</mo><mn>0</mn><mn>1</mn></msubsup></mstyle><mrow><msqrt><mrow><mi>log</mi><mn>2</mn><mi class="ltx_font_mathcaligraphic">𝒩</mi><mo stretchy="false">(</mo><mn>2</mn><msup><mrow></mrow><mn>7</mn></msup><mi>σ</mi><mi>m</mi><msup><mrow></mrow><mrow><mo>−</mo><mi>γ</mi><mo>/</mo><mo stretchy="false">(</mo><mn>2</mn><mi>γ</mi><mo>+</mo><mi>d</mi><mo stretchy="false">)</mo></mrow></msup><mi>ς</mi><mo>,</mo><mi class="ltx_font_mathcaligraphic">ℱ</mi><mo>,</mo><mo lspace="0em" rspace="0em">∥</mo><mo lspace="0em" rspace="0em">⋅</mo><mo lspace="0em" rspace="0.167em">∥</mo><msub><mrow></mrow><mrow><msup><mi>L</mi><mi mathvariant="normal">∞</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>μ</mi><mo stretchy="false">)</mo></mrow></mrow></msub><mo stretchy="false">)</mo><msup><mrow></mrow><mn>2</mn></msup></mrow></msqrt><mo lspace="0.170em" rspace="0em">​</mo><mrow><mo rspace="0em">𝑑</mo><mi>ς</mi></mrow></mrow></mrow><mo>)</mo></mrow><mn>2</mn></msup></mrow><mo>+</mo><mrow><msup><mn>2</mn><mrow><mo>−</mo><mn>6</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>δ</mi><mn>2</mn></msup></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\leq\frac{2^{10}\sigma^{2}}{{m}}\left(\int_{0}^{1}\sqrt{\log 2\mathcal{N}(2^{7}\sigma m^{-\gamma/(2\gamma+d)}\varsigma,\mathcal{F},\|\cdot\|_{L^{\infty}(\mu)})^{2}}\,d\varsigma\right)^{2}+2^{-6}\delta^{2}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="S6.Ex349"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S6.Ex349.m1" class="ltx_math_unparsed" alttext="\displaystyle=\frac{8\sigma}{m^{(\gamma+d)/(2\gamma+d)}}\left(\int_{0}^{2^{7}\sigma m^{-\gamma/(2\gamma+d)}}\sqrt{\log 2\mathcal{N}(\varsigma,\mathcal{F},\|\cdot\|_{L^{\infty}(\mu)})^{2}}\,d\varsigma\right)^{2}+2^{-6}\delta^{2}" display="inline" intent=":literal"><semantics><mrow><mo>=</mo><mstyle displaystyle="true"><mfrac><mrow><mn>8</mn><mo lspace="0em" rspace="0em">​</mo><mi>σ</mi></mrow><msup><mi>m</mi><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>γ</mi><mo>+</mo><mi>d</mi></mrow><mo stretchy="false">)</mo></mrow><mo>/</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>γ</mi></mrow><mo>+</mo><mi>d</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></msup></mfrac></mstyle><msup><mrow><mo>(</mo><mstyle displaystyle="true"><msubsup><mo>∫</mo><mn>0</mn><mrow><mn>2</mn><msup><mrow></mrow><mn>7</mn></msup><mi>σ</mi><mi>m</mi><msup><mrow></mrow><mrow><mo>−</mo><mi>γ</mi><mo>/</mo><mo stretchy="false">(</mo><mn>2</mn><mi>γ</mi><mo>+</mo><mi>d</mi><mo stretchy="false">)</mo></mrow></msup></mrow></msubsup></mstyle><msqrt><mrow><mi>log</mi><mn>2</mn><mi class="ltx_font_mathcaligraphic">𝒩</mi><mo stretchy="false">(</mo><mi>ς</mi><mo>,</mo><mi class="ltx_font_mathcaligraphic">ℱ</mi><mo>,</mo><mo lspace="0em" rspace="0em">∥</mo><mo lspace="0em" rspace="0em">⋅</mo><mo lspace="0em" rspace="0.167em">∥</mo><msub><mrow></mrow><mrow><msup><mi>L</mi><mi mathvariant="normal">∞</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>μ</mi><mo stretchy="false">)</mo></mrow></mrow></msub><mo stretchy="false">)</mo><msup><mrow></mrow><mn>2</mn></msup></mrow></msqrt><mi>d</mi><mi>ς</mi><mo>)</mo></mrow><mn>2</mn></msup><mo>+</mo><msup><mn>2</mn><mrow><mo>−</mo><mn>6</mn></mrow></msup><msup><mi>δ</mi><mn>2</mn></msup></mrow><annotation encoding="application/x-tex">\displaystyle=\frac{8\sigma}{m^{(\gamma+d)/(2\gamma+d)}}\left(\int_{0}^{2^{7}\sigma m^{-\gamma/(2\gamma+d)}}\sqrt{\log 2\mathcal{N}(\varsigma,\mathcal{F},\|\cdot\|_{L^{\infty}(\mu)})^{2}}\,d\varsigma\right)^{2}+2^{-6}\delta^{2}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S6.p9.5" class="ltx_p"><span id="S6.p9.5.1" class="ltx_text">with probability at least <math id="S6.p9.m9" class="ltx_Math" alttext="1-\exp\left(-2m^{d/(2\gamma+d)}\right)" display="inline" intent=":literal"><semantics><mrow><mn>1</mn><mo>−</mo><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mo>−</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msup><mi>m</mi><mrow><mi>d</mi><mo>/</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>γ</mi></mrow><mo>+</mo><mi>d</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></msup></mrow></mrow><mo>)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">1-\exp\left(-2m^{d/(2\gamma+d)}\right)</annotation></semantics></math>. Here we use the inequality <math id="S6.p9.m10" class="ltx_Math" alttext="ab\leq\frac{a^{2}}{2}+\frac{b^{2}}{2}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>a</mi><mo lspace="0em" rspace="0em">​</mo><mi>b</mi></mrow><mo>≤</mo><mrow><mfrac><msup><mi>a</mi><mn>2</mn></msup><mn>2</mn></mfrac><mo>+</mo><mfrac><msup><mi>b</mi><mn>2</mn></msup><mn>2</mn></mfrac></mrow></mrow><annotation encoding="application/x-tex">ab\leq\frac{a^{2}}{2}+\frac{b^{2}}{2}</annotation></semantics></math>. Plugging the above inequality into (<a href="#S6.E29" title="In Proof of Proposition . ‣ 6 Proof of Proposition ‣ Standard Transformers Achieve the Minimax Rate in Nonparametric Regression with 𝐶^{𝑠,𝜆} Targets" class="ltx_ref"><span class="ltx_text ltx_ref_tag">29</span></a>) yields</span></p>
<table id="S6.EGx216" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="S6.Ex350"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
