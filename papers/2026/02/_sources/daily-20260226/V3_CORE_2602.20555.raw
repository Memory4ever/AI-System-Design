<tbody id="S7.Ex457"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S7.Ex457.m1" class="ltx_Math" alttext="\displaystyle\leq\sqrt{d_{K}d_{out}}M^{L-1}B_{FF}^{L}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≤</mo><mrow><msqrt><mrow><msub><mi>d</mi><mi>K</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>d</mi><mrow><mi>o</mi><mo lspace="0em" rspace="0em">​</mo><mi>u</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></msub></mrow></msqrt><mo lspace="0em" rspace="0em">​</mo><msup><mi>M</mi><mrow><mi>L</mi><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>B</mi><mrow><mi>F</mi><mo lspace="0em" rspace="0em">​</mo><mi>F</mi></mrow><mi>L</mi></msubsup></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\leq\sqrt{d_{K}d_{out}}M^{L-1}B_{FF}^{L}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="S7.Ex458"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S7.Ex458.m1" class="ltx_math_unparsed" alttext="\displaystyle\quad\left\|\boldsymbol{\mathcal{\widetilde{F}}}_{SA}^{(K)}\circ\cdots\circ\boldsymbol{\mathcal{\widetilde{F}}}_{SA}^{(k+1)}\circ\boldsymbol{\mathcal{\widetilde{F}}}_{FF}^{(k)}\circ\boldsymbol{\mathcal{{F}}}_{SA}^{(k)}\circ\cdots\circ\boldsymbol{\mathcal{{F}}}_{FF}^{(0)}\circ\boldsymbol{\mathcal{F}}_{EB}(\boldsymbol{X})\right." display="inline" intent=":literal"><semantics><mrow><mo>‖</mo><msubsup><mover accent="true"><mi class="ltx_font_mathcaligraphic">𝓕</mi><mo>~</mo></mover><mrow><mi>S</mi><mo lspace="0em" rspace="0em">​</mo><mi>A</mi></mrow><mrow><mo stretchy="false">(</mo><mi>K</mi><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0.222em">∘</mo><mo lspace="0.055em" rspace="0.055em">⋯</mo><mo rspace="0.222em">∘</mo><msubsup><mover accent="true"><mi class="ltx_font_mathcaligraphic">𝓕</mi><mo>~</mo></mover><mrow><mi>S</mi><mo lspace="0em" rspace="0em">​</mo><mi>A</mi></mrow><mrow><mo stretchy="false">(</mo><mrow><mi>k</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0.222em" rspace="0.222em">∘</mo><msubsup><mover accent="true"><mi class="ltx_font_mathcaligraphic">𝓕</mi><mo>~</mo></mover><mrow><mi>F</mi><mo lspace="0em" rspace="0em">​</mo><mi>F</mi></mrow><mrow><mo stretchy="false">(</mo><mi>k</mi><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0.222em" rspace="0.222em">∘</mo><msubsup><mi class="ltx_font_mathcaligraphic">𝓕</mi><mrow><mi>S</mi><mo lspace="0em" rspace="0em">​</mo><mi>A</mi></mrow><mrow><mo stretchy="false">(</mo><mi>k</mi><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0.222em">∘</mo><mo lspace="0.055em" rspace="0.055em">⋯</mo><mo rspace="0.222em">∘</mo><msubsup><mi class="ltx_font_mathcaligraphic">𝓕</mi><mrow><mi>F</mi><mo lspace="0em" rspace="0em">​</mo><mi>F</mi></mrow><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0.222em" rspace="0.222em">∘</mo><msub><mi class="ltx_font_mathcaligraphic">𝓕</mi><mrow><mi>E</mi><mo lspace="0em" rspace="0em">​</mo><mi>B</mi></mrow></msub><mrow><mo stretchy="false">(</mo><mi>𝑿</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\quad\left\|\boldsymbol{\mathcal{\widetilde{F}}}_{SA}^{(K)}\circ\cdots\circ\boldsymbol{\mathcal{\widetilde{F}}}_{SA}^{(k+1)}\circ\boldsymbol{\mathcal{\widetilde{F}}}_{FF}^{(k)}\circ\boldsymbol{\mathcal{{F}}}_{SA}^{(k)}\circ\cdots\circ\boldsymbol{\mathcal{{F}}}_{FF}^{(0)}\circ\boldsymbol{\mathcal{F}}_{EB}(\boldsymbol{X})\right.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="S7.Ex459"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S7.Ex459.m1" class="ltx_math_unparsed" alttext="\displaystyle\qquad\left.-\boldsymbol{\mathcal{\widetilde{F}}}_{SA}^{(K)}\circ\cdots\circ\boldsymbol{\mathcal{\widetilde{F}}}_{SA}^{(k+1)}\circ\boldsymbol{\mathcal{{F}}}_{FF}^{(k)}\circ\boldsymbol{\mathcal{{F}}}_{SA}^{(k)}\circ\cdots\circ\boldsymbol{\mathcal{{F}}}_{FF}^{(0)}\circ\boldsymbol{\mathcal{F}}_{EB}(\boldsymbol{X})\right\|_{F}" display="inline" intent=":literal"><semantics><msub><mrow><mo>−</mo><msubsup><mover accent="true"><mi class="ltx_font_mathcaligraphic">𝓕</mi><mo>~</mo></mover><mrow><mi>S</mi><mo lspace="0em" rspace="0em">​</mo><mi>A</mi></mrow><mrow><mo stretchy="false">(</mo><mi>K</mi><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0.222em">∘</mo><mo lspace="0.055em" rspace="0.055em">⋯</mo><mo rspace="0.222em">∘</mo><msubsup><mover accent="true"><mi class="ltx_font_mathcaligraphic">𝓕</mi><mo>~</mo></mover><mrow><mi>S</mi><mo lspace="0em" rspace="0em">​</mo><mi>A</mi></mrow><mrow><mo stretchy="false">(</mo><mrow><mi>k</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0.222em" rspace="0.222em">∘</mo><msubsup><mi class="ltx_font_mathcaligraphic">𝓕</mi><mrow><mi>F</mi><mo lspace="0em" rspace="0em">​</mo><mi>F</mi></mrow><mrow><mo stretchy="false">(</mo><mi>k</mi><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0.222em" rspace="0.222em">∘</mo><msubsup><mi class="ltx_font_mathcaligraphic">𝓕</mi><mrow><mi>S</mi><mo lspace="0em" rspace="0em">​</mo><mi>A</mi></mrow><mrow><mo stretchy="false">(</mo><mi>k</mi><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0.222em">∘</mo><mo lspace="0.055em" rspace="0.055em">⋯</mo><mo rspace="0.222em">∘</mo><msubsup><mi class="ltx_font_mathcaligraphic">𝓕</mi><mrow><mi>F</mi><mo lspace="0em" rspace="0em">​</mo><mi>F</mi></mrow><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0.222em" rspace="0.222em">∘</mo><msub><mi class="ltx_font_mathcaligraphic">𝓕</mi><mrow><mi>E</mi><mo lspace="0em" rspace="0em">​</mo><mi>B</mi></mrow></msub><mrow><mo stretchy="false">(</mo><mi>𝑿</mi><mo stretchy="false">)</mo></mrow><mo>‖</mo></mrow><mi>F</mi></msub><annotation encoding="application/x-tex">\displaystyle\qquad\left.-\boldsymbol{\mathcal{\widetilde{F}}}_{SA}^{(K)}\circ\cdots\circ\boldsymbol{\mathcal{\widetilde{F}}}_{SA}^{(k+1)}\circ\boldsymbol{\mathcal{{F}}}_{FF}^{(k)}\circ\boldsymbol{\mathcal{{F}}}_{SA}^{(k)}\circ\cdots\circ\boldsymbol{\mathcal{{F}}}_{FF}^{(0)}\circ\boldsymbol{\mathcal{F}}_{EB}(\boldsymbol{X})\right\|_{F}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="S7.Ex460"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S7.Ex460.m1" class="ltx_Math" alttext="\displaystyle\leq 6\cdot 4^{2K}n^{2K+3/2}d_{in}d_{0}^{2}\left(\prod_{k=1}^{K-1}d_{k}^{4}\right)d_{K}^{7/2}d_{out}^{1/2}H^{2K-1}S^{2K}L^{2K}W^{(L-1)(2K+1)}B_{EB}^{2}B_{FF}^{L(2K+1)}B_{SA}^{4K}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≤</mo><mrow><mrow><mn>6</mn><mo lspace="0.222em" rspace="0.222em">⋅</mo><msup><mn>4</mn><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>K</mi></mrow></msup></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mi>n</mi><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>K</mi></mrow><mo>+</mo><mrow><mn>3</mn><mo>/</mo><mn>2</mn></mrow></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>d</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>d</mi><mn>0</mn><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∏</mo><mrow><mi>k</mi><mo>=</mo><mn>1</mn></mrow><mrow><mi>K</mi><mo>−</mo><mn>1</mn></mrow></munderover></mstyle><msubsup><mi>d</mi><mi>k</mi><mn>4</mn></msubsup></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>d</mi><mi>K</mi><mrow><mn>7</mn><mo>/</mo><mn>2</mn></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>d</mi><mrow><mi>o</mi><mo lspace="0em" rspace="0em">​</mo><mi>u</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow><mrow><mn>1</mn><mo>/</mo><mn>2</mn></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mi>H</mi><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>K</mi></mrow><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>S</mi><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>K</mi></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>L</mi><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>K</mi></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>W</mi><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>L</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>K</mi></mrow><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>B</mi><mrow><mi>E</mi><mo lspace="0em" rspace="0em">​</mo><mi>B</mi></mrow><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>B</mi><mrow><mi>F</mi><mo lspace="0em" rspace="0em">​</mo><mi>F</mi></mrow><mrow><mi>L</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>K</mi></mrow><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>B</mi><mrow><mi>S</mi><mo lspace="0em" rspace="0em">​</mo><mi>A</mi></mrow><mrow><mn>4</mn><mo lspace="0em" rspace="0em">​</mo><mi>K</mi></mrow></msubsup></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\leq 6\cdot 4^{2K}n^{2K+3/2}d_{in}d_{0}^{2}\left(\prod_{k=1}^{K-1}d_{k}^{4}\right)d_{K}^{7/2}d_{out}^{1/2}H^{2K-1}S^{2K}L^{2K}W^{(L-1)(2K+1)}B_{EB}^{2}B_{FF}^{L(2K+1)}B_{SA}^{4K}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="S7.Ex461"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S7.Ex461.m1" class="ltx_math_unparsed" alttext="\displaystyle\quad\left\|\boldsymbol{\mathcal{\widetilde{F}}}_{FF}^{(K-1)}\circ\cdots\circ\boldsymbol{\mathcal{\widetilde{F}}}_{SA}^{(k+1)}\circ\boldsymbol{\mathcal{\widetilde{F}}}_{FF}^{(k)}\circ\boldsymbol{\mathcal{{F}}}_{SA}^{(k)}\circ\cdots\circ\boldsymbol{\mathcal{{F}}}_{FF}^{(0)}\circ\boldsymbol{\mathcal{F}}_{EB}(\boldsymbol{X})\right." display="inline" intent=":literal"><semantics><mrow><mo>‖</mo><msubsup><mover accent="true"><mi class="ltx_font_mathcaligraphic">𝓕</mi><mo>~</mo></mover><mrow><mi>F</mi><mo lspace="0em" rspace="0em">​</mo><mi>F</mi></mrow><mrow><mo stretchy="false">(</mo><mrow><mi>K</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0.222em">∘</mo><mo lspace="0.055em" rspace="0.055em">⋯</mo><mo rspace="0.222em">∘</mo><msubsup><mover accent="true"><mi class="ltx_font_mathcaligraphic">𝓕</mi><mo>~</mo></mover><mrow><mi>S</mi><mo lspace="0em" rspace="0em">​</mo><mi>A</mi></mrow><mrow><mo stretchy="false">(</mo><mrow><mi>k</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0.222em" rspace="0.222em">∘</mo><msubsup><mover accent="true"><mi class="ltx_font_mathcaligraphic">𝓕</mi><mo>~</mo></mover><mrow><mi>F</mi><mo lspace="0em" rspace="0em">​</mo><mi>F</mi></mrow><mrow><mo stretchy="false">(</mo><mi>k</mi><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0.222em" rspace="0.222em">∘</mo><msubsup><mi class="ltx_font_mathcaligraphic">𝓕</mi><mrow><mi>S</mi><mo lspace="0em" rspace="0em">​</mo><mi>A</mi></mrow><mrow><mo stretchy="false">(</mo><mi>k</mi><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0.222em">∘</mo><mo lspace="0.055em" rspace="0.055em">⋯</mo><mo rspace="0.222em">∘</mo><msubsup><mi class="ltx_font_mathcaligraphic">𝓕</mi><mrow><mi>F</mi><mo lspace="0em" rspace="0em">​</mo><mi>F</mi></mrow><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0.222em" rspace="0.222em">∘</mo><msub><mi class="ltx_font_mathcaligraphic">𝓕</mi><mrow><mi>E</mi><mo lspace="0em" rspace="0em">​</mo><mi>B</mi></mrow></msub><mrow><mo stretchy="false">(</mo><mi>𝑿</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\quad\left\|\boldsymbol{\mathcal{\widetilde{F}}}_{FF}^{(K-1)}\circ\cdots\circ\boldsymbol{\mathcal{\widetilde{F}}}_{SA}^{(k+1)}\circ\boldsymbol{\mathcal{\widetilde{F}}}_{FF}^{(k)}\circ\boldsymbol{\mathcal{{F}}}_{SA}^{(k)}\circ\cdots\circ\boldsymbol{\mathcal{{F}}}_{FF}^{(0)}\circ\boldsymbol{\mathcal{F}}_{EB}(\boldsymbol{X})\right.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="S7.Ex462"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S7.Ex462.m1" class="ltx_math_unparsed" alttext="\displaystyle\qquad\left.-\boldsymbol{\mathcal{\widetilde{F}}}_{FF}^{(K-1)}\circ\cdots\circ\boldsymbol{\mathcal{\widetilde{F}}}_{SA}^{(k+1)}\circ\boldsymbol{\mathcal{{F}}}_{FF}^{(k)}\circ\boldsymbol{\mathcal{{F}}}_{SA}^{(k)}\circ\cdots\circ\boldsymbol{\mathcal{{F}}}_{FF}^{(0)}\circ\boldsymbol{\mathcal{F}}_{EB}(\boldsymbol{X})\right\|_{F}." display="inline" intent=":literal"><semantics><mrow><msub><mrow><mo>−</mo><msubsup><mover accent="true"><mi class="ltx_font_mathcaligraphic">𝓕</mi><mo>~</mo></mover><mrow><mi>F</mi><mo lspace="0em" rspace="0em">​</mo><mi>F</mi></mrow><mrow><mo stretchy="false">(</mo><mrow><mi>K</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0.222em">∘</mo><mo lspace="0.055em" rspace="0.055em">⋯</mo><mo rspace="0.222em">∘</mo><msubsup><mover accent="true"><mi class="ltx_font_mathcaligraphic">𝓕</mi><mo>~</mo></mover><mrow><mi>S</mi><mo lspace="0em" rspace="0em">​</mo><mi>A</mi></mrow><mrow><mo stretchy="false">(</mo><mrow><mi>k</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0.222em" rspace="0.222em">∘</mo><msubsup><mi class="ltx_font_mathcaligraphic">𝓕</mi><mrow><mi>F</mi><mo lspace="0em" rspace="0em">​</mo><mi>F</mi></mrow><mrow><mo stretchy="false">(</mo><mi>k</mi><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0.222em" rspace="0.222em">∘</mo><msubsup><mi class="ltx_font_mathcaligraphic">𝓕</mi><mrow><mi>S</mi><mo lspace="0em" rspace="0em">​</mo><mi>A</mi></mrow><mrow><mo stretchy="false">(</mo><mi>k</mi><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0.222em">∘</mo><mo lspace="0.055em" rspace="0.055em">⋯</mo><mo rspace="0.222em">∘</mo><msubsup><mi class="ltx_font_mathcaligraphic">𝓕</mi><mrow><mi>F</mi><mo lspace="0em" rspace="0em">​</mo><mi>F</mi></mrow><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0.222em" rspace="0.222em">∘</mo><msub><mi class="ltx_font_mathcaligraphic">𝓕</mi><mrow><mi>E</mi><mo lspace="0em" rspace="0em">​</mo><mi>B</mi></mrow></msub><mrow><mo stretchy="false">(</mo><mi>𝑿</mi><mo stretchy="false">)</mo></mrow><mo>‖</mo></mrow><mi>F</mi></msub><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\qquad\left.-\boldsymbol{\mathcal{\widetilde{F}}}_{FF}^{(K-1)}\circ\cdots\circ\boldsymbol{\mathcal{\widetilde{F}}}_{SA}^{(k+1)}\circ\boldsymbol{\mathcal{{F}}}_{FF}^{(k)}\circ\boldsymbol{\mathcal{{F}}}_{SA}^{(k)}\circ\cdots\circ\boldsymbol{\mathcal{{F}}}_{FF}^{(0)}\circ\boldsymbol{\mathcal{F}}_{EB}(\boldsymbol{X})\right\|_{F}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S7.p15.6" class="ltx_p"><span id="S7.p15.6.1" class="ltx_text">Repeating this process and making use of the following estimates (obtained by applying Lemma <a href="#Thmlemma28" title="Lemma 28. ‣ 7 Proof of Lemma : Estimation of Lipschitz Constant ‣ Standard Transformers Achieve the Minimax Rate in Nonparametric Regression with 𝐶^{𝑠,𝜆} Targets" class="ltx_ref"><span class="ltx_text ltx_ref_tag">28</span></a> repeatedly):</span></p>
<table id="S7.EGx253" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="S7.Ex463"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S7.Ex463.m1" class="ltx_math_unparsed" alttext="\displaystyle\left.\begin{matrix}\left\|\boldsymbol{\mathcal{\widetilde{F}}}_{FF}^{(k^{\prime})}\circ\cdots\circ\boldsymbol{\mathcal{\widetilde{F}}}_{SA}^{(k+1)}\circ\boldsymbol{\mathcal{\widetilde{F}}}_{FF}^{(k)}\circ\boldsymbol{\mathcal{{F}}}_{SA}^{(k)}\circ\cdots\circ\boldsymbol{\mathcal{{F}}}_{FF}^{(0)}\circ\boldsymbol{\mathcal{F}}_{EB}(\boldsymbol{X})\right\|_{F}\\
\left\|\boldsymbol{\mathcal{\widetilde{F}}}_{FF}^{(k^{\prime})}\circ\cdots\circ\boldsymbol{\mathcal{\widetilde{F}}}_{SA}^{(k+1)}\circ\boldsymbol{\mathcal{{F}}}_{FF}^{(k)}\circ\boldsymbol{\mathcal{{F}}}_{SA}^{(k)}\circ\cdots\circ\boldsymbol{\mathcal{{F}}}_{FF}^{(0)}\circ\boldsymbol{\mathcal{F}}_{EB}(\boldsymbol{X})\right\|_{F}\end{matrix}\right\}" display="inline" intent=":literal"><semantics><mrow><mtable rowspacing="0pt"><mtr><mtd><mrow><mo>‖</mo><mover accent="true"><mi class="ltx_font_mathcaligraphic">𝓕</mi><mo>~</mo></mover><msub><mrow></mrow><mrow><mi>F</mi><mo lspace="0em" rspace="0em">​</mo><mi>F</mi></mrow></msub><msup><mrow></mrow><mrow><mo stretchy="false">(</mo><msup><mi>k</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow></msup><mo lspace="0.222em">∘</mo><mo lspace="0.055em" rspace="0.055em">⋯</mo><mo rspace="0.222em">∘</mo><mover accent="true"><mi class="ltx_font_mathcaligraphic">𝓕</mi><mo>~</mo></mover><msub><mrow></mrow><mrow><mi>S</mi><mo lspace="0em" rspace="0em">​</mo><mi>A</mi></mrow></msub><msup><mrow></mrow><mrow><mo stretchy="false">(</mo><mrow><mi>k</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></msup><mo lspace="0.222em" rspace="0.222em">∘</mo><mover accent="true"><mi class="ltx_font_mathcaligraphic">𝓕</mi><mo>~</mo></mover><msub><mrow></mrow><mrow><mi>F</mi><mo lspace="0em" rspace="0em">​</mo><mi>F</mi></mrow></msub><msup><mrow></mrow><mrow><mo stretchy="false">(</mo><mi>k</mi><mo stretchy="false">)</mo></mrow></msup><mo lspace="0.222em" rspace="0.222em">∘</mo><mi class="ltx_font_mathcaligraphic">𝓕</mi><msub><mrow></mrow><mrow><mi>S</mi><mo lspace="0em" rspace="0em">​</mo><mi>A</mi></mrow></msub><msup><mrow></mrow><mrow><mo stretchy="false">(</mo><mi>k</mi><mo stretchy="false">)</mo></mrow></msup><mo lspace="0.222em">∘</mo><mo lspace="0.055em" rspace="0.055em">⋯</mo><mo rspace="0.222em">∘</mo><mi class="ltx_font_mathcaligraphic">𝓕</mi><msub><mrow></mrow><mrow><mi>F</mi><mo lspace="0em" rspace="0em">​</mo><mi>F</mi></m