<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S2.Ex62.m2" class="ltx_Math" alttext="\displaystyle=\begin{pmatrix}\boldsymbol{\mathcal{F}}_{FF}^{(1)}(\boldsymbol{X})\\
\boldsymbol{\mathcal{F}}_{FF}^{(2)}(\boldsymbol{Y})\end{pmatrix}." display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>=</mo><mrow><mo>(</mo><mtable rowspacing="0pt"><mtr><mtd><mrow><msubsup><mi class="ltx_font_mathcaligraphic">𝓕</mi><mrow><mi>F</mi><mo lspace="0em" rspace="0em">​</mo><mi>F</mi></mrow><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝑿</mi><mo stretchy="false">)</mo></mrow></mrow></mtd></mtr><mtr><mtd><mrow><msubsup><mi class="ltx_font_mathcaligraphic">𝓕</mi><mrow><mi>F</mi><mo lspace="0em" rspace="0em">​</mo><mi>F</mi></mrow><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝒀</mi><mo stretchy="false">)</mo></mrow></mrow></mtd></mtr></mtable><mo>)</mo></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle=\begin{pmatrix}\boldsymbol{\mathcal{F}}_{FF}^{(1)}(\boldsymbol{X})\\
\boldsymbol{\mathcal{F}}_{FF}^{(2)}(\boldsymbol{Y})\end{pmatrix}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div></li>
<li id="S2.I2.ix2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(2)</span> 
<div id="S2.I2.ix2.p1" class="ltx_para">
<p id="S2.I2.ix2.p1.1" class="ltx_p"><span id="S2.I2.ix2.p1.1.1" class="ltx_text ltx_font_italic">Let </span><math id="S2.I2.ix2.p1.m1" class="ltx_Math" alttext="\boldsymbol{\mathcal{F}}_{SA}^{(1)}:\mathbb{R}^{d^{(1)}\times n}\to\mathbb{R}^{{d}^{(1)}\times n}" display="inline" intent=":literal"><semantics><mrow><msubsup><mi class="ltx_font_mathcaligraphic">𝓕</mi><mrow><mi>S</mi><mo lspace="0em" rspace="0em">​</mo><mi>A</mi></mrow><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><msup><mi>ℝ</mi><mrow><msup><mi>d</mi><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msup><mo lspace="0.222em" rspace="0.222em">×</mo><mi>n</mi></mrow></msup><mo stretchy="false">→</mo><msup><mi>ℝ</mi><mrow><msup><mi>d</mi><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msup><mo lspace="0.222em" rspace="0.222em">×</mo><mi>n</mi></mrow></msup></mrow></mrow><annotation encoding="application/x-tex">\boldsymbol{\mathcal{F}}_{SA}^{(1)}:\mathbb{R}^{d^{(1)}\times n}\to\mathbb{R}^{{d}^{(1)}\times n}</annotation></semantics></math><span id="S2.I2.ix2.p1.1.2" class="ltx_text ltx_font_italic"> and </span><math id="S2.I2.ix2.p1.m2" class="ltx_Math" alttext="\boldsymbol{\mathcal{F}}_{SA}^{(2)}:\mathbb{R}^{d^{(2)}\times n}\to\mathbb{R}^{{d}^{(2)}\times n}" display="inline" intent=":literal"><semantics><mrow><msubsup><mi class="ltx_font_mathcaligraphic">𝓕</mi><mrow><mi>S</mi><mo lspace="0em" rspace="0em">​</mo><mi>A</mi></mrow><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><msup><mi>ℝ</mi><mrow><msup><mi>d</mi><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msup><mo lspace="0.222em" rspace="0.222em">×</mo><mi>n</mi></mrow></msup><mo stretchy="false">→</mo><msup><mi>ℝ</mi><mrow><msup><mi>d</mi><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msup><mo lspace="0.222em" rspace="0.222em">×</mo><mi>n</mi></mrow></msup></mrow></mrow><annotation encoding="application/x-tex">\boldsymbol{\mathcal{F}}_{SA}^{(2)}:\mathbb{R}^{d^{(2)}\times n}\to\mathbb{R}^{{d}^{(2)}\times n}</annotation></semantics></math><span id="S2.I2.ix2.p1.1.3" class="ltx_text ltx_font_italic"> be two self-attention layers with head numbers </span><math id="S2.I2.ix2.p1.m3" class="ltx_Math" alttext="H^{(1)}" display="inline" intent=":literal"><semantics><msup><mi>H</mi><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msup><annotation encoding="application/x-tex">H^{(1)}</annotation></semantics></math><span id="S2.I2.ix2.p1.1.4" class="ltx_text ltx_font_italic"> and </span><math id="S2.I2.ix2.p1.m4" class="ltx_Math" alttext="H^{(2)}" display="inline" intent=":literal"><semantics><msup><mi>H</mi><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msup><annotation encoding="application/x-tex">H^{(2)}</annotation></semantics></math><span id="S2.I2.ix2.p1.1.5" class="ltx_text ltx_font_italic">, head sizes </span><math id="S2.I2.ix2.p1.m5" class="ltx_Math" alttext="S^{(1)}" display="inline" intent=":literal"><semantics><msup><mi>S</mi><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msup><annotation encoding="application/x-tex">S^{(1)}</annotation></semantics></math><span id="S2.I2.ix2.p1.1.6" class="ltx_text ltx_font_italic"> and </span><math id="S2.I2.ix2.p1.m6" class="ltx_Math" alttext="S^{(2)}" display="inline" intent=":literal"><semantics><msup><mi>S</mi><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msup><annotation encoding="application/x-tex">S^{(2)}</annotation></semantics></math><span id="S2.I2.ix2.p1.1.7" class="ltx_text ltx_font_italic">, weight bounds </span><math id="S2.I2.ix2.p1.m7" class="ltx_Math" alttext="B^{(1)}" display="inline" intent=":literal"><semantics><msup><mi>B</mi><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msup><annotation encoding="application/x-tex">B^{(1)}</annotation></semantics></math><span id="S2.I2.ix2.p1.1.8" class="ltx_text ltx_font_italic"> and </span><math id="S2.I2.ix2.p1.m8" class="ltx_Math" alttext="B^{(2)}" display="inline" intent=":literal"><semantics><msup><mi>B</mi><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msup><annotation encoding="application/x-tex">B^{(2)}</annotation></semantics></math><span id="S2.I2.ix2.p1.1.9" class="ltx_text ltx_font_italic">, respctively. There exists a self-attention layer </span><math id="S2.I2.ix2.p1.m9" class="ltx_Math" alttext="\boldsymbol{\mathcal{F}}_{SA}^{(prl)}:\mathbb{R}^{(d^{(1)}+d^{(2)})\times n}\to\mathbb{R}^{({d}^{(1)}+{d}^{(2)})\times n}" display="inline" intent=":literal"><semantics><mrow><msubsup><mi class="ltx_font_mathcaligraphic">𝓕</mi><mrow><mi>S</mi><mo lspace="0em" rspace="0em">​</mo><mi>A</mi></mrow><mrow><mo stretchy="false">(</mo><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>l</mi></mrow><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><msup><mi>ℝ</mi><mrow><mrow><mo stretchy="false">(</mo><mrow><msup><mi>d</mi><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msup><mo>+</mo><msup><mi>d</mi><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msup></mrow><mo rspace="0.055em" stretchy="false">)</mo></mrow><mo rspace="0.222em">×</mo><mi>n</mi></mrow></msup><mo stretchy="false">→</mo><msup><mi>ℝ</mi><mrow><mrow><mo stretchy="false">(</mo><mrow><msup><mi>d</mi><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msup><mo>+</mo><msup><mi>d</mi><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msup></mrow><mo rspace="0.055em" stretchy="false">)</mo></mrow><mo rspace="0.222em">×</mo><mi>n</mi></mrow></msup></mrow></mrow><annotation encoding="application/x-tex">\boldsymbol{\mathcal{F}}_{SA}^{(prl)}:\mathbb{R}^{(d^{(1)}+d^{(2)})\times n}\to\mathbb{R}^{({d}^{(1)}+{d}^{(2)})\times n}</annotation></semantics></math><span id="S2.I2.ix2.p1.1.10" class="ltx_text ltx_font_italic"> with head number </span><math id="S2.I2.ix2.p1.m10" class="ltx_Math" alttext="H^{(1)}+H^{(2)}" display="inline" intent=":literal"><semantics><mrow><msup><mi>H</mi><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msup><mo>+</mo><msup><mi>H</mi><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msup></mrow><annotation encoding="application/x-tex">H^{(1)}+H^{(2)}</annotation></semantics></math><span id="S2.I2.ix2.p1.1.11" class="ltx_text ltx_font_italic">, head size </span><math id="S2.I2.ix2.p1.m11" class="ltx_Math" alttext="\max\{S^{(1)},S^{(2)}\}" display="inline" intent=":literal"><semantics><mrow><mi>max</mi><mo>⁡</mo><mrow><mo stretchy="false">{</mo><msup><mi>S</mi><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msup><mo>,</mo><msup><mi>S</mi><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">\max\{S^{(1)},S^{(2)}\}</annotation></semantics></math><span id="S2.I2.ix2.p1.1.12" class="ltx_text ltx_font_italic"> and weight bound </span><math id="S2.I2.ix2.p1.m12" class="ltx_Math" alttext="\max\{B^{(1)},B^{(2)}\}" display="inline" intent=":literal"><semantics><mrow><mi>max</mi><mo>⁡</mo><mrow><mo stretchy="false">{</mo><msup><mi>B</mi><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msup><mo>,</mo><msup><mi>B</mi><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">\max\{B^{(1)},B^{(2)}\}</annotation></semantics></math><span id="S2.I2.ix2.p1.1.13" class="ltx_text ltx_font_italic"> such that for any </span><math id="S2.I2.ix2.p1.m13" class="ltx_Math" alttext="\boldsymbol{X}\in\mathbb{R}^{d^{(1)}\times n},\boldsymbol{Y}\in\mathbb{R}^{d^{(2)}\times n}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>𝑿</mi><mo>∈</mo><msup><mi>ℝ</mi><mrow><msup><mi>d</mi><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msup><mo lspace="0.222em" rspace="0.222em">×</mo><mi>n</mi></mrow></msup></mrow><mo>,</mo><mrow><mi>𝒀</mi><mo>∈</mo><msup><mi>ℝ</mi><mrow><msup><mi>d</mi><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msup><mo lspace="0.222em" rspace="0.222em">×</mo><mi>n</mi></mrow></msup></mrow></mrow><annotation encoding="application/x-tex">\boldsymbol{X}\in\mathbb{R}^{d^{(1)}\times n},\boldsymbol{Y}\in\mathbb{R}^{d^{(2)}\times n}</annotation></semantics></math><span id="S2.I2.ix2.p1.1.14" class="ltx_text ltx_font_italic">,</span></p>
<table id="S2.EGx36" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="S2.Ex63"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S2.Ex63.m1" class="ltx_Math" alttext="\displaystyle\boldsymbol{\mathcal{F}}_{SA}^{(prl)}\left(\begin{pmatrix}\boldsymbol{X}\\
\boldsymbol{Y}\end{pmatrix}\right)" display="inline" intent=":literal"><semantics><mrow><msubsup><mi class="ltx_font_mathcaligraphic">𝓕</mi><mrow><mi>S</mi><mo lspace="0em" rspace="0em">​</mo><mi>A</mi></mrow><mrow><mo stretchy="false">(</mo><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>l</mi></mrow><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mo>(</mo><mtable rowspacing="0pt"><mtr><mtd><mi>𝑿</mi></mtd></mtr><mtr><mtd><mi>𝒀</mi></mtd></mtr></mtable><mo>)</mo></mrow><mo>)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\boldsymbol{\mathcal{F}}_{SA}^{(prl)}\left(\begin{pmatrix}\boldsymbol{X}\\
\boldsymbol{Y}\end{pmatrix}\right)</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S2.Ex63.m2" class="ltx_Math" alttext="\displaystyle=\begin{pmatrix}\boldsymbol{\mathcal{F}}_{SA}^{(1)}(\boldsymbol{X})\\
\boldsymbol{\mathcal{F}}_{SA}^{(2)}(\boldsymbol{Y})\end{pmatrix}." display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>=</mo><mrow><mo>(</mo><mtable rowspacing="0pt"><mtr><mtd><mrow><msubsup><mi class="ltx_font_mathcaligraphic">𝓕</mi><mrow><mi>S</mi><mo lspace="0em" rspace="0em">​</mo><mi>A</mi></mrow><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝑿</mi><mo stretchy="false">)</mo></mrow></mrow></mtd></mtr><mtr><mtd><mrow><msubsup><mi class="ltx_font_mathcaligraphic">𝓕</mi><mrow><mi>S</mi><mo lspace="0em" rspace="0em">​</mo><mi>A</mi></mrow><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝒀</mi><mo stretchy="false">)</mo></mrow></mrow></mtd></mtr></mtable><mo>)</mo></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle=\begin{pmatrix}\boldsymbol{\mathcal{F}}_{SA}^{(1)}(\boldsymbol{X})\\
\boldsymbol{\mathcal{F}}_{SA}^{(2)}(\boldsymbol{Y})\end{pmatrix}.</annotation></semantics></math></td>
