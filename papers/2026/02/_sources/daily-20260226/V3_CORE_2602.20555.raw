\widetilde{\times}\left(c_{2,j}(f_{d1}),f_{2}^{(mnm)}\right)&amp;\widetilde{\times}\left(c_{2,j}(f_{d2}),f_{2}^{(mnm)}\right)&amp;\cdots&amp;\widetilde{\times}\left(c_{2,j}(f_{dn}),f_{2}^{(mnm)}\right)\\
\vdots&amp;\vdots&amp;&amp;\vdots\\
\widetilde{\times}\left(c_{C_{s+dn-1}^{dn-1},j}(f_{11}),f_{C_{s+dn}^{dn}}^{(mnm)}\right)&amp;\widetilde{\times}\left(c_{C_{s+dn-1}^{dn-1},j}(f_{12}),f_{C_{s+dn-1}^{dn-1}}^{(mnm)}\right)&amp;\cdots&amp;\widetilde{\times}\left(c_{C_{s+dn-1}^{dn-1},j}(f_{1n}),f_{C_{s+dn-1}^{dn-1}}^{(mnm)}\right)\\
