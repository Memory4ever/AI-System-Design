<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S7.Ex464.m1" class="ltx_Math" alttext="\displaystyle\leq 4^{k^{\prime}+1}n^{k^{\prime}+3/2}d_{in}^{1/2}d_{0}\left(\prod_{k=1}^{k^{\prime}}d_{k}^{2}\right)d_{k^{\prime}+1}^{1/2}H^{k^{\prime}}S^{k^{\prime}}L^{k^{\prime}+1}W^{(L-1)(k^{\prime}+1)}B_{EB}B_{FF}^{L(k^{\prime}+1)}B_{SA}^{2k^{\prime}}," display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>≤</mo><mrow><msup><mn>4</mn><mrow><msup><mi>k</mi><mo>′</mo></msup><mo>+</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>n</mi><mrow><msup><mi>k</mi><mo>′</mo></msup><mo>+</mo><mrow><mn>3</mn><mo>/</mo><mn>2</mn></mrow></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>d</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow><mrow><mn>1</mn><mo>/</mo><mn>2</mn></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mi>d</mi><mn>0</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∏</mo><mrow><mi>k</mi><mo>=</mo><mn>1</mn></mrow><msup><mi>k</mi><mo>′</mo></msup></munderover></mstyle><msubsup><mi>d</mi><mi>k</mi><mn>2</mn></msubsup></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>d</mi><mrow><msup><mi>k</mi><mo>′</mo></msup><mo>+</mo><mn>1</mn></mrow><mrow><mn>1</mn><mo>/</mo><mn>2</mn></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mi>H</mi><msup><mi>k</mi><mo>′</mo></msup></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>S</mi><msup><mi>k</mi><mo>′</mo></msup></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>L</mi><mrow><msup><mi>k</mi><mo>′</mo></msup><mo>+</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>W</mi><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>L</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mi>k</mi><mo>′</mo></msup><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>B</mi><mrow><mi>E</mi><mo lspace="0em" rspace="0em">​</mo><mi>B</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>B</mi><mrow><mi>F</mi><mo lspace="0em" rspace="0em">​</mo><mi>F</mi></mrow><mrow><mi>L</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mi>k</mi><mo>′</mo></msup><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>B</mi><mrow><mi>S</mi><mo lspace="0em" rspace="0em">​</mo><mi>A</mi></mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msup><mi>k</mi><mo>′</mo></msup></mrow></msubsup></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\leq 4^{k^{\prime}+1}n^{k^{\prime}+3/2}d_{in}^{1/2}d_{0}\left(\prod_{k=1}^{k^{\prime}}d_{k}^{2}\right)d_{k^{\prime}+1}^{1/2}H^{k^{\prime}}S^{k^{\prime}}L^{k^{\prime}+1}W^{(L-1)(k^{\prime}+1)}B_{EB}B_{FF}^{L(k^{\prime}+1)}B_{SA}^{2k^{\prime}},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S7.p15.7" class="ltx_p"><span id="S7.p15.7.1" class="ltx_text">where <math id="S7.p15.m9" class="ltx_Math" alttext="k^{\prime}\in\{k+1,\cdots,K-1\}" display="inline" intent=":literal"><semantics><mrow><msup><mi>k</mi><mo>′</mo></msup><mo>∈</mo><mrow><mo stretchy="false">{</mo><mrow><mrow><mi>k</mi><mo>+</mo><mn>1</mn></mrow><mo>,</mo><mo lspace="0em" rspace="0em">⋯</mo><mo>,</mo><mrow><mi>K</mi><mo>−</mo><mn>1</mn></mrow></mrow><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">k^{\prime}\in\{k+1,\cdots,K-1\}</annotation></semantics></math>, we derive that</span></p>
