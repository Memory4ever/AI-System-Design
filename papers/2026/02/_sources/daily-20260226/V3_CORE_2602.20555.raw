<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S3.Ex193.m1" class="ltx_Math" alttext="\displaystyle\leq\left|f_{FF,2}^{(mtp)}\left(f_{FF,2^{\widetilde{d}-1}}^{(mtp)}(\boldsymbol{{x}}_{1}),f_{FF,2^{\widetilde{d}-1}}^{(mtp)}(\boldsymbol{{x}}_{2})\right)-f_{FF,2^{\widetilde{d}-1}}^{(mtp)}(\boldsymbol{{x}}_{1})f_{FF,2^{\widetilde{d}-1}}^{(mtp)}(\boldsymbol{{x}}_{2})\right|" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≤</mo><mrow><mo>|</mo><mrow><mrow><msubsup><mi>f</mi><mrow><mrow><mi>F</mi><mo lspace="0em" rspace="0em">​</mo><mi>F</mi></mrow><mo>,</mo><mn>2</mn></mrow><mrow><mo stretchy="false">(</mo><mrow><mi>m</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi><mo lspace="0em" rspace="0em">​</mo><mi>p</mi></mrow><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><msubsup><mi>f</mi><mrow><mrow><mi>F</mi><mo lspace="0em" rspace="0em">​</mo><mi>F</mi></mrow><mo>,</mo><msup><mn>2</mn><mrow><mover accent="true"><mi>d</mi><mo>~</mo></mover><mo>−</mo><mn>1</mn></mrow></msup></mrow><mrow><mo stretchy="false">(</mo><mrow><mi>m</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi><mo lspace="0em" rspace="0em">​</mo><mi>p</mi></mrow><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒙</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mrow><msubsup><mi>f</mi><mrow><mrow><mi>F</mi><mo lspace="0em" rspace="0em">​</mo><mi>F</mi></mrow><mo>,</mo><msup><mn>2</mn><mrow><mover accent="true"><mi>d</mi><mo>~</mo></mover><mo>−</mo><mn>1</mn></mrow></msup></mrow><mrow><mo stretchy="false">(</mo><mrow><mi>m</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi><mo lspace="0em" rspace="0em">​</mo><mi>p</mi></mrow><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒙</mi><mn>2</mn></msub><mo stretchy="false">)</mo></mrow></mrow><mo>)</mo></mrow></mrow><mo>−</mo><mrow><msubsup><mi>f</mi><mrow><mrow><mi>F</mi><mo lspace="0em" rspace="0em">​</mo><mi>F</mi></mrow><mo>,</mo><msup><mn>2</mn><mrow><mover accent="true"><mi>d</mi><mo>~</mo></mover><mo>−</mo><mn>1</mn></mrow></msup></mrow><mrow><mo stretchy="false">(</mo><mrow><mi>m</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi><mo lspace="0em" rspace="0em">​</mo><mi>p</mi></mrow><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒙</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>f</mi><mrow><mrow><mi>F</mi><mo lspace="0em" rspace="0em">​</mo><mi>F</mi></mrow><mo>,</mo><msup><mn>2</mn><mrow><mover accent="true"><mi>d</mi><mo>~</mo></mover><mo>−</mo><mn>1</mn></mrow></msup></mrow><mrow><mo stretchy="false">(</mo><mrow><mi>m</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi><mo lspace="0em" rspace="0em">​</mo><mi>p</mi></mrow><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒙</mi><mn>2</mn></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>|</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\leq\left|f_{FF,2}^{(mtp)}\left(f_{FF,2^{\widetilde{d}-1}}^{(mtp)}(\boldsymbol{{x}}_{1}),f_{FF,2^{\widetilde{d}-1}}^{(mtp)}(\boldsymbol{{x}}_{2})\right)-f_{FF,2^{\widetilde{d}-1}}^{(mtp)}(\boldsymbol{{x}}_{1})f_{FF,2^{\widetilde{d}-1}}^{(mtp)}(\boldsymbol{{x}}_{2})\right|</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="S3.Ex194"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S3.Ex194.m1" class="ltx_math_unparsed" alttext="\displaystyle\quad+2\left|f_{FF,2^{\widetilde{d}-1}}^{(mtp)}(\boldsymbol{{x}}_{1})-x_{1}\cdots x_{2^{\widetilde{d}-1}}\right|+\left|f_{FF,2^{\widetilde{d}-1}}^{(mtp)}(\boldsymbol{{x}}_{2})-x_{2^{\widetilde{d}-1}+1}\cdots x_{2^{\widetilde{d}}}\right|" display="inline" intent=":literal"><semantics><mrow><mo>+</mo><mn>2</mn><mo fence="false" rspace="0.167em">|</mo><msubsup><mi>f</mi><mrow><mrow><mi>F</mi><mo lspace="0em" rspace="0em">​</mo><mi>F</mi></mrow><mo>,</mo><msup><mn>2</mn><mrow><mover accent="true"><mi>d</mi><mo>~</mo></mover><mo>−</mo><mn>1</mn></mrow></msup></mrow><mrow><mo stretchy="false">(</mo><mrow><mi>m</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi><mo lspace="0em" rspace="0em">​</mo><mi>p</mi></mrow><mo stretchy="false">)</mo></mrow></msubsup><mrow><mo stretchy="false">(</mo><msub><mi>𝒙</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow><mo>−</mo><msub><mi>x</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">⋯</mo><msub><mi>x</mi><msup><mn>2</mn><mrow><mover accent="true"><mi>d</mi><mo>~</mo></mover><mo>−</mo><mn>1</mn></mrow></msup></msub><mo fence="false">|</mo><mo lspace="0em" rspace="0em">+</mo><mo fence="false" rspace="0.167em">|</mo><msubsup><mi>f</mi><mrow><mrow><mi>F</mi><mo lspace="0em" rspace="0em">​</mo><mi>F</mi></mrow><mo>,</mo><msup><mn>2</mn><mrow><mover accent="true"><mi>d</mi><mo>~</mo></mover><mo>−</mo><mn>1</mn></mrow></msup></mrow><mrow><mo stretchy="false">(</mo><mrow><mi>m</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi><mo lspace="0em" rspace="0em">​</mo><mi>p</mi></mrow><mo stretchy="false">)</mo></mrow></msubsup><mrow><mo stretchy="false">(</mo><msub><mi>𝒙</mi><mn>2</mn></msub><mo stretchy="false">)</mo></mrow><mo>−</mo><msub><mi>x</mi><mrow><msup><mn>2</mn><mrow><mover accent="true"><mi>d</mi><mo>~</mo></mover><mo>−</mo><mn>1</mn></mrow></msup><mo>+</mo><mn>1</mn></mrow></msub><mo lspace="0em" rspace="0em">⋯</mo><msub><mi>x</mi><msup><mn>2</mn><mover accent="true"><mi>d</mi><mo>~</mo></mover></msup></msub><mo fence="false">|</mo></mrow><annotation encoding="application/x-tex">\displaystyle\quad+2\left|f_{FF,2^{\widetilde{d}-1}}^{(mtp)}(\boldsymbol{{x}}_{1})-x_{1}\cdots x_{2^{\widetilde{d}-1}}\right|+\left|f_{FF,2^{\widetilde{d}-1}}^{(mtp)}(\boldsymbol{{x}}_{2})-x_{2^{\widetilde{d}-1}+1}\cdots x_{2^{\widetilde{d}}}\right|</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="S3.Ex195"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S3.Ex195.m1" class="ltx_Math" alttext="\displaystyle\leq\widetilde{\epsilon}+2\cdot\frac{1}{2}\left(3^{\widetilde{d}-1}-1\right)\widetilde{\epsilon}+\frac{1}{2}\left(3^{\widetilde{d}-1}-1\right)\widetilde{\epsilon}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≤</mo><mrow><mover accent="true"><mi>ϵ</mi><mo>~</mo></mover><mo>+</mo><mrow><mrow><mn>2</mn><mo lspace="0.222em" rspace="0.222em">⋅</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mn>2</mn></mfrac></mstyle></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><msup><mn>3</mn><mrow><mover accent="true"><mi>d</mi><mo>~</mo></mover><mo>−</mo><mn>1</mn></mrow></msup><mo>−</mo><mn>1</mn></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mover accent="true"><mi>ϵ</mi><mo>~</mo></mover></mrow><mo>+</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mn>2</mn></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><msup><mn>3</mn><mrow><mover accent="true"><mi>d</mi><mo>~</mo></mover><mo>−</mo><mn>1</mn></mrow></msup><mo>−</mo><mn>1</mn></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mover accent="true"><mi>ϵ</mi><mo>~</mo></mover></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\leq\widetilde{\epsilon}+2\cdot\frac{1}{2}\left(3^{\widetilde{d}-1}-1\right)\widetilde{\epsilon}+\frac{1}{2}\left(3^{\widetilde{d}-1}-1\right)\widetilde{\epsilon}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="S3.Ex196"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S3.Ex196.m1" class="ltx_Math" alttext="\displaystyle=\frac{1}{2}\left(3^{\widetilde{d}}-1\right)\widetilde{\epsilon}," display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>=</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mn>2</mn></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><msup><mn>3</mn><mover accent="true"><mi>d</mi><mo>~</mo></mover></msup><mo>−</mo><mn>1</mn></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mover accent="true"><mi>ϵ</mi><mo>~</mo></mover></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle=\frac{1}{2}\left(3^{\widetilde{d}}-1\right)\widetilde{\epsilon},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S3.SS3.p1.8" class="ltx_p"><span id="S3.SS3.p1.8.1" class="ltx_text">where in the third step we use Lemma <a href="#Thmlemma10" title="Lemma 10 ([], Proposition 3). ‣ 3.1 Proof of Proposition ‣ 3 Proof of Proposition : Construction of Transformers ‣ Standard Transformers Achieve the Minimax Rate in Nonparametric Regression with 𝐶^{𝑠,𝜆} Targets" class="ltx_ref"><span class="ltx_text ltx_ref_tag">10</span></a>. The proof is completed by setting <math id="S3.SS3.p1.m25" class="ltx_Math" alttext="\widetilde{\epsilon}=\frac{2}{3^{\widetilde{d}}-1}\epsilon" display="inline" intent=":literal"><semantics><mrow><mover accent="true"><mi>ϵ</mi><mo>~</mo></mover><mo>=</mo><mrow><mfrac><mn>2</mn><mrow><msup><mn>3</mn><mover accent="true"><mi>d</mi><mo>~</mo></mover></msup><mo>−</mo><mn>1</mn></mrow></mfrac><mo lspace="0em" rspace="0em">​</mo><mi>ϵ</mi></mrow></mrow><annotation encoding="application/x-tex">\widetilde{\epsilon}=\frac{2}{3^{\widetilde{d}}-1}\epsilon</annotation></semantics></math>.</span></p>
</div>
<div id="S3.SS3.p2" class="ltx_para">
<p id="S3.SS3.p2.1" class="ltx_p"><span id="S3.SS3.p2.1.1" class="ltx_text">∎</span></p>
</div>
</div>
<div id="S3.SS3.3" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof of Lemma <a href="#Thmlemma9" title="Lemma 9. ‣ 3.1 Proof of Proposition ‣ 3 Proof of Proposition : Construction of Transformers ‣ Standard Transformers Achieve the Minimax Rate in Nonparametric Regression with 𝐶^{𝑠,𝜆} Targets" class="ltx_ref"><span class="ltx_text ltx_ref_tag">9</span></a>.</h6>
<div id="S3.SS3.p3" class="ltx_para">
<p id="S3.SS3.p3.1" class="ltx_p"><span id="S3.SS3.p3.1.1" class="ltx_text">The first hidden layer is used to transform <math id="S3.SS3.p3.m1" class="ltx_Math" alttext="\boldsymbol{x}" display="inline" intent=":literal"><semantics><mi>𝒙</mi><annotation encoding="application/x-tex">\boldsymbol{x}</annotation></semantics></math> into</span></p>
<table id="S3.EGx130" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="S3.Ex197"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S3.Ex197.m1" class="ltx_Math" alttext="\displaystyle\boldsymbol{\widetilde{x}}:=(\underbrace{x_{1},\cdots,x_{1}}_{\alpha_{1}},\underbrace{x_{2},\cdots,x_{2}}_{\alpha_{2}},\cdots,\underbrace{x_{d},\cdots,x_{d}}_{\alpha_{d}})^{\top}\in\mathbb{R}^{s}." display="inline" intent=":literal"><semantics><mrow><mrow><mover accent="true"><mi>𝒙</mi><mo>~</mo></mover><mo>:=</mo><msup><mrow><mo stretchy="false">(</mo><munder><munder accentunder="true"><mrow><msub><mi>x</mi><mn>1</mn></msub><mo>,</mo><mo lspace="0em" rspace="0em">⋯</mo><mo>,</mo><msub><mi>x</mi><mn>1</mn></msub></mrow><mo stretchy="true">⏟</mo></munder><msub><mi>α</mi><mn>1</mn></msub></munder><mo>,</mo><munder><munder accentunder="true"><mrow><msub><mi>x</mi><mn>2</mn></msub><mo>,</mo><mo lspace="0em" rspace="0em">⋯</mo><mo>,</mo><msub><mi>x</mi><mn>2</mn></msub></mrow><mo stretchy="true">⏟</mo></munder><msub><mi>α</mi><mn>2</mn></msub></munder><mo>,</mo><mo lspace="0em" rspace="0em">⋯</mo><mo>,</mo><munder><munder accentunder="true"><mrow><msub><mi>x</mi><mi>d</mi></msub><mo>,</mo><mo lspace="0em" rspace="0em">⋯</mo><mo>,</mo><msub><mi>x</mi><mi>d</mi></msub></mrow><mo stretchy="true">⏟</mo></munder><msub><mi>α</mi><mi>d</mi></msub></munder><mo stretchy="false">)</mo></mrow><mo>⊤</mo></msup><mo>∈</mo><msup><mi>ℝ</mi><mi>s</mi></msup></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\boldsymbol{\widetilde{x}}:=(\underbrace{x_{1},\cdots,x_{1}}_{\alpha_{1}},\underbrace{x_{2},\cdots,x_{2}}_{\alpha_{2}},\cdots,\underbrace{x_{d},\cdots,x_{d}}_{\alpha_{d}})^{\top}\in\mathbb{R}^{s}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S3.SS3.p3.2" class="ltx_p"><span id="S3.SS3.p3.2.1" class="ltx_text">According to Lemma <a href="#Thmlemma11" title="Lemma 11. ‣ 3.1 Proof of Proposition ‣ 3 Proof of Proposition : Construction of Transformers ‣ Standard Transformers Achieve the Minimax Rate in Nonparametric Regression with 𝐶^{𝑠,𝜆} Targets" class="ltx_ref"><span class="ltx_text ltx_ref_tag">11</span></a>, the number of neurons in this layer is <math id="S3.SS3.p3.m2" class="ltx_Math" alttext="2\bar{\alpha}" display="inline" intent=":literal"><semantics><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mover accent="true"><mi>α</mi><mo>¯</mo></mover></mrow><annotation encoding="application/x-tex">2\bar{\alpha}</annotation></semantics></math>. From Lemma <a href="#Thmlemma13" title="Lemma 13. ‣ 3.3 Proof of Lemma ‣ 3 Proof of Proposition : Construction of Transformers ‣ Standard Transformers Achieve the Minimax Rate in Nonparametric Regression with 𝐶^{𝑠,𝜆} Targets" class="ltx_ref"><span class="ltx_text ltx_ref_tag">13</span></a>, we can find a ReLU FNN function <math id="S3.SS3.p3.m3" class="ltx_Math" alttext="f_{FF,s}^{(mtp)}:\mathbb{R}^{\bar{\alpha}}\to\mathbb{R}" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>f</mi><mrow><mrow><mi>F</mi><mo lspace="0em" rspace="0em">​</mo><mi>F</mi></mrow><mo>,</mo><mi>s</mi></mrow><mrow><mo stretchy="false">(</mo><mrow><mi>m</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi><mo lspace="0em" rspace="0em">​</mo><mi>p</mi></mrow><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><msup><mi>ℝ</mi><mover accent="true"><mi>α</mi><mo>¯</mo></mover></msup><mo stretchy="false">→</mo><mi>ℝ</mi></mrow></mrow><annotation encoding="application/x-tex">f_{FF,s}^{(mtp)}:\mathbb{R}^{\bar{\alpha}}\to\mathbb{R}</annotation></semantics></math> with width <math id="S3.SS3.p3.m4" class="ltx_Math" alttext="21\cdot 2^{\lceil\log_{2}\bar{\alpha}\rceil-1}" display="inline" intent=":literal"><semantics><mrow><mn>21</mn><mo lspace="0.222em" rspace="0.222em">⋅</mo><msup><mn>2</mn><mrow><mrow><mo stretchy="false">⌈</mo><mrow><msub><mi>log</mi><mn>2</mn></msub><mo lspace="0.167em">⁡</mo><mover accent="true"><mi>α</mi><mo>¯</mo></mover></mrow><mo stretchy="false">⌉</mo></mrow><mo>−</mo><mn>1</mn></mrow></msup></mrow><annotation encoding="application/x-tex">21\cdot 2^{\lceil\log_{2}\bar{\alpha}\rceil-1}</annotation></semantics></math>, depth <math id="S3.SS3.p3.m5" class="ltx_Math" alttext="C\ln\frac{3^{\lceil\log_{2}\bar{\alpha}\rceil}-1}{2\epsilon}" display="inline" intent=":literal"><semantics><mrow><mi>C</mi><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>ln</mi><mo lspace="0.167em">⁡</mo><mfrac><mrow><msup><mn>3</mn><mrow><mo stretchy="false">⌈</mo><mrow><msub><mi>log</mi><mn>2</mn></msub><mo lspace="0.167em">⁡</mo><mover accent="true"><mi>α</mi><mo>¯</mo></mover></mrow><mo stretchy="false">⌉</mo></mrow></msup><mo>−</mo><mn>1</mn></mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>ϵ</mi></mrow></mfrac></mrow></mrow><annotation encoding="application/x-tex">C\ln\frac{3^{\lceil\log_{2}\bar{\alpha}\rceil}-1}{2\epsilon}</annotation></semantics></math> and weight bound <math id="S3.SS3.p3.m6" class="ltx_Math" alttext="C" display="inline" intent=":literal"><semantics><mi>C</mi><annotation encoding="application/x-tex">C</annotation></semantics></math> such that</span></p>
<table id="S3.EGx131" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="S3.Ex198"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S3.Ex198.m1" class="ltx_math_unparsed" alttext="\displaystyle\left|f_{FF,d}^{(mtp)}(\boldsymbol{\widetilde{x}})-x_{1}^{\alpha_{1}}x_{2}^{\alpha_{2}}\cdots x_{d}^{\alpha_{d}}\right|\leq\epsilon." display="inline" intent=":literal"><semantics><mrow><mo fence="false" rspace="0.167em">|</mo><msubsup><mi>f</mi><mrow><mrow><mi>F</mi><mo lspace="0em" rspace="0em">​</mo><mi>F</mi></mrow><mo>,</mo><mi>d</mi></mrow><mrow><mo stretchy="false">(</mo><mrow><mi>m</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi><mo lspace="0em" rspace="0em">​</mo><mi>p</mi></mrow><mo stretchy="false">)</mo></mrow></msubsup><mrow><mo stretchy="false">(</mo><mover accent="true"><mi>𝒙</mi><mo>~</mo></mover><mo stretchy="false">)</mo></mrow><mo>−</mo><msubsup><mi>x</mi><mn>1</mn><msub><mi>α</mi><mn>1</mn></msub></msubsup><msubsup><mi>x</mi><mn>2</mn><msub><mi>α</mi><mn>2</mn></msub></msubsup><mo lspace="0em" rspace="0em">⋯</mo><msubsup><mi>x</mi><mi>d</mi><msub><mi>α</mi><mi>d</mi></msub></msubsup><mo fence="false">|</mo><mo lspace="0.167em">≤</mo><mi>ϵ</mi><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\left|f_{FF,d}^{(mtp)}(\boldsymbol{\widetilde{x}})-x_{1}^{\alpha_{1}}x_{2}^{\alpha_{2}}\cdots x_{d}^{\alpha_{d}}\right|\leq\epsilon.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S3.SS3.p3.3" class="ltx_p"><span id="S3.SS3.p3.3.1" class="ltx_text">∎</span></p>
</div>
</div>
</section>
</section>
<section id="S4" class="ltx_section">
<h2 class="ltx_title ltx_title_section"><span class="ltx_tag ltx_tag_section">4 </span>Proof of Lemma <a href="#Thmlemma7" title="Lemma 7. ‣ 3.1 Proof of Proposition ‣ 3 Proof of Proposition : Construction of Transformers ‣ Standard Transformers Achieve the Minimax Rate in Nonparametric Regression with 𝐶^{𝑠,𝜆} Targets" class="ltx_ref"><span class="ltx_text ltx_ref_tag">7</span></a>: Memorization of Transformers</h2>

<div id="S4.p1" class="ltx_para">
<p id="S4.p1.1" class="ltx_p">Following the path of researches on Transformer memorization <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib59" title="" class="ltx_ref">59</a>, <a href="#bib.bib25" title="" class="ltx_ref">25</a>, <a href="#bib.bib22" title="" class="ltx_ref">22</a>, <a href="#bib.bib23" title="" class="ltx_ref">23</a>]</cite>, we first prove that the Transformer can achieve contextual mapping (Lemma <a href="#Thmlemma14" title="Lemma 14. ‣ 4.1 Proof of Lemma ‣ 4 Proof of Lemma : Memorization of Transformers ‣ Standard Transformers Achieve the Minimax Rate in Nonparametric Regression with 𝐶^{𝑠,𝜆} Targets" class="ltx_ref"><span class="ltx_text ltx_ref_tag">14</span></a>), and then associate the resulting context ids with the corresponding labels via an ReLU FNN (Lemma <a href="#Thmlemma15" title="Lemma 15. ‣ 4.1 Proof of Lemma ‣ 4 Proof of Lemma : Memorization of Transformers ‣ Standard Transformers Achieve the Minimax Rate in Nonparametric Regression with 𝐶^{𝑠,𝜆} Targets" class="ltx_ref"><span class="ltx_text ltx_ref_tag">15</span></a>), thereby realizing the memorization task.</p>
</div>
<div id="S4.p2" class="ltx_para">
<p id="S4.p2.1" class="ltx_p">This section is divided into two subsections: In Section <a href="#S4.SS1" title="4.1 Proof of Lemma ‣ 4 Proof of Lemma : Memorization of Transformers ‣ Standard Transformers Achieve the Minimax Rate in Nonparametric Regression with 𝐶^{𝑠,𝜆} Targets" class="ltx_ref"><span class="ltx_text ltx_ref_tag">4.1</span></a>, we prove Lemma <a href="#Thmlemma7" title="Lemma 7. ‣ 3.1 Proof of Proposition ‣ 3 Proof of Proposition : Construction of Transformers ‣ Standard Transformers Achieve the Minimax Rate in Nonparametric Regression with 𝐶^{𝑠,𝜆} Targets" class="ltx_ref"><span class="ltx_text ltx_ref_tag">7</span></a> based on Lemmas <a href="#Thmlemma14" title="Lemma 14. ‣ 4.1 Proof of Lemma ‣ 4 Proof of Lemma : Memorization of Transformers ‣ Standard Transformers Achieve the Minimax Rate in Nonparametric Regression with 𝐶^{𝑠,𝜆} Targets" class="ltx_ref"><span class="ltx_text ltx_ref_tag">14</span></a> and <a href="#Thmlemma15" title="Lemma 15. ‣ 4.1 Proof of Lemma ‣ 4 Proof of Lemma : Memorization of Transformers ‣ Standard Transformers Achieve the Minimax Rate in Nonparametric Regression with 𝐶^{𝑠,𝜆} Targets" class="ltx_ref"><span class="ltx_text ltx_ref_tag">15</span></a>. Since the proof of Lemma 14 is lengthy, we defer it to Section <a href="#S4.SS2" title="4.2 Proof of Lemma : Realizing Contextual Mapping by Transformers ‣ 4 Proof of Lemma : Memorization of Transformers ‣ Standard Transformers Achieve the Minimax Rate in Nonparametric Regression with 𝐶^{𝑠,𝜆} Targets" class="ltx_ref"><span class="ltx_text ltx_ref_tag">4.2</span></a>.</p>
</div>
<section id="S4.SS1" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">4.1 </span>Proof of Lemma <a href="#Thmlemma7" title="Lemma 7. ‣ 3.1 Proof of Proposition ‣ 3 Proof of Proposition : Construction of Transformers ‣ Standard Transformers Achieve the Minimax Rate in Nonparametric Regression with 𝐶^{𝑠,𝜆} Targets" class="ltx_ref"><span class="ltx_text ltx_ref_tag">7</span></a></h3>

<div id="S4.SS1.p1" class="ltx_para">
<p id="S4.SS1.p1.1" class="ltx_p">The contextual mapping defined below assigns a unique id to each token in the input sequence.</p>
</div>
<div id="Thmdefinition3" class="ltx_theorem ltx_theorem_definition">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="Thmdefinition3.2" class="ltx_text ltx_font_bold">Definition 3</span></span><span id="Thmdefinition3.3" class="ltx_text ltx_font_bold"> </span>(Contextual mapping)<span id="Thmdefinition3.4" class="ltx_text ltx_font_bold">.</span></h6>
<div id="Thmdefinition3.p1" class="ltx_para">
<p id="Thmdefinition3.p1.1" class="ltx_p"><span id="Thmdefinition3.p1.1.1" class="ltx_text ltx_font_italic">Let <math id="Thmdefinition3.p1.m1" class="ltx_Math" alttext="N\in\mathbb{N}_{\geq 1}" display="inline" intent=":literal"><semantics><mrow><mi>N</mi><mo>∈</mo><msub><mi>ℕ</mi><mrow><mphantom></mphantom><mo>≥</mo><mn>1</mn></mrow></msub></mrow><annotation encoding="application/x-tex">N\in\mathbb{N}_{\geq 1}</annotation></semantics></math> and <math id="Thmdefinition3.p1.m2" class="ltx_Math" alttext="r,\phi\in\mathbb{R}_{&gt;0}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>r</mi><mo>,</mo><mi>ϕ</mi></mrow><mo>∈</mo><msub><mi>ℝ</mi><mrow><mphantom></mphantom><mo>&gt;</mo><mn>0</mn></mrow></msub></mrow><annotation encoding="application/x-tex">r,\phi\in\mathbb{R}_{&gt;0}</annotation></semantics></math>. Let <math id="Thmdefinition3.p1.m3" class="ltx_Math" alttext="\boldsymbol{X}^{(1)},\cdots,\boldsymbol{X}^{(N)}\in\mathbb{R}^{d\times n}" display="inline" intent=":literal"><semantics><mrow><msup><mi>𝐗</mi><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msup><mo>,</mo><mo lspace="0em" rspace="0em">⋯</mo><mo>,</mo><mrow><msup><mi>𝐗</mi><mrow><mo stretchy="false">(</mo><mi>N</mi><mo stretchy="false">)</mo></mrow></msup><mo>∈</mo><msup><mi>ℝ</mi><mrow><mi>d</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>n</mi></mrow></msup></mrow></mrow><annotation encoding="application/x-tex">\boldsymbol{X}^{(1)},\cdots,\boldsymbol{X}^{(N)}\in\mathbb{R}^{d\times n}</annotation></semantics></math> be a set of <math id="Thmdefinition3.p1.m4" class="ltx_Math" alttext="N" display="inline" intent=":literal"><semantics><mi>N</mi><annotation encoding="application/x-tex">N</annotation></semantics></math> input sequences. A map <math id="Thmdefinition3.p1.m5" class="ltx_Math" alttext="\mathcal{A}:\mathbb{R}^{d\times n}\to\mathbb{R}^{1\times n}" display="inline" intent=":literal"><semantics><mrow><mi class="ltx_font_mathcaligraphic">𝒜</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><msup><mi>ℝ</mi><mrow><mi>d</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>n</mi></mrow></msup><mo stretchy="false">→</mo><msup><mi>ℝ</mi><mrow><mn>1</mn><mo lspace="0.222em" rspace="0.222em">×</mo><mi>n</mi></mrow></msup></mrow></mrow><annotation encoding="application/x-tex">\mathcal{A}:\mathbb{R}^{d\times n}\to\mathbb{R}^{1\times n}</annotation></semantics></math> is called an <math id="Thmdefinition3.p1.m6" class="ltx_Math" alttext="(r,\phi)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi>r</mi><mo>,</mo><mi>ϕ</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(r,\phi)</annotation></semantics></math>-contextual mapping if the following two conditions hold:</span></p>
<ul id="S4.I1" class="ltx_itemize">
<li id="S4.I1.i1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="S4.I1.i1.p1" class="ltx_para">
<p id="S4.I1.i1.p1.1" class="ltx_p"><span id="S4.I1.i1.p1.1.1" class="ltx_text ltx_font_italic">For any </span><math id="S4.I1.i1.p1.m1" class="ltx_Math" alttext="i\in[N]" display="inline" intent=":literal"><semantics><mrow><mi>i</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mi>N</mi><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">i\in[N]</annotation></semantics></math><span id="S4.I1.i1.p1.1.2" class="ltx_text ltx_font_italic"> and </span><math id="S4.I1.i1.p1.m2" class="ltx_Math" alttext="k\in[n]" display="inline" intent=":literal"><semantics><mrow><mi>k</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mi>n</mi><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">k\in[n]</annotation></semantics></math><span id="S4.I1.i1.p1.1.3" class="ltx_text ltx_font_italic">, </span><math id="S4.I1.i1.p1.m3" class="ltx_Math" alttext="\left|\mathcal{A}\left(\boldsymbol{X}^{(i)}\right)_{1,k}\right|\leq r" display="inline" intent=":literal"><semantics><mrow><mrow><mo>|</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒜</mi><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo>(</mo><msup><mi>𝑿</mi><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></msup><mo>)</mo></mrow><mrow><mn>1</mn><mo>,</mo><mi>k</mi></mrow></msub></mrow><mo>|</mo></mrow><mo>≤</mo><mi>r</mi></mrow><annotation encoding="application/x-tex">\left|\mathcal{A}\left(\boldsymbol{X}^{(i)}\right)_{1,k}\right|\leq r</annotation></semantics></math><span id="S4.I1.i1.p1.1.4" class="ltx_text ltx_font_italic">.</span></p>
</div></li>
<li id="S4.I1.i2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="S4.I1.i2.p1" class="ltx_para">
<p id="S4.I1.i2.p1.1" class="ltx_p"><span id="S4.I1.i2.p1.1.1" class="ltx_text ltx_font_italic">For any </span><math id="S4.I1.i2.p1.m1" class="ltx_Math" alttext="i,j\in[N]" display="inline" intent=":literal"><semantics><mrow><mrow><mi>i</mi><mo>,</mo><mi>j</mi></mrow><mo>∈</mo><mrow><mo stretchy="false">[</mo><mi>N</mi><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">i,j\in[N]</annotation></semantics></math><span id="S4.I1.i2.p1.1.2" class="ltx_text ltx_font_italic"> and </span><math id="S4.I1.i2.p1.m2" class="ltx_Math" alttext="k,l\in[n]" display="inline" intent=":literal"><semantics><mrow><mrow><mi>k</mi><mo>,</mo><mi>l</mi></mrow><mo>∈</mo><mrow><mo stretchy="false">[</mo><mi>n</mi><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">k,l\in[n]</annotation></semantics></math><span id="S4.I1.i2.p1.1.3" class="ltx_text ltx_font_italic"> such that </span><math id="S4.I1.i2.p1.m3" class="ltx_math_unparsed" alttext="\boldsymbol{X}_{:,k}^{(i)}\neq\boldsymbol{X}_{:,l}^{(j)}" display="inline" intent=":literal"><semantics><mrow><mi>𝑿</mi><msub><mrow></mrow><mrow><mo rspace="0em">:</mo><mo>,</mo><mi>k</mi></mrow></msub><msup><mrow></mrow><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></msup><mo>≠</mo><mi>𝑿</mi><msub><mrow></mrow><mrow><mo rspace="0em">:</mo><mo>,</mo><mi>l</mi></mrow></msub><msup><mrow></mrow><mrow><mo stretchy="false">(</mo><mi>j</mi><mo stretchy="false">)</mo></mrow></msup></mrow><annotation encoding="application/x-tex">\boldsymbol{X}_{:,k}^{(i)}\neq\boldsymbol{X}_{:,l}^{(j)}</annotation></semantics></math><span id="S4.I1.i2.p1.1.4" class="ltx_text ltx_font_italic"> or </span><math id="S4.I1.i2.p1.m4" class="ltx_Math" alttext="\boldsymbol{X}^{(i)}\neq\boldsymbol{X}^{(j)}" display="inline" intent=":literal"><semantics><mrow><msup><mi>𝑿</mi><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></msup><mo>≠</mo><msup><mi>𝑿</mi><mrow><mo stretchy="false">(</mo><mi>j</mi><mo stretchy="false">)</mo></mrow></msup></mrow><annotation encoding="application/x-tex">\boldsymbol{X}^{(i)}\neq\boldsymbol{X}^{(j)}</annotation></semantics></math><span id="S4.I1.i2.p1.1.5" class="ltx_text ltx_font_italic"> up to permutations, </span><math id="S4.I1.i2.p1.m5" class="ltx_Math" alttext="\left|\mathcal{A}\left(\boldsymbol{X}^{(i)}\right)_{1,k}-\mathcal{A}\left(\boldsymbol{X}^{(j)}\right)_{1,l}\right|\geq\phi" display="inline" intent=":literal"><semantics><mrow><mrow><mo>|</mo><mrow><mrow><mi class="ltx_font_mathcaligraphic">𝒜</mi><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo>(</mo><msup><mi>𝑿</mi><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></msup><mo>)</mo></mrow><mrow><mn>1</mn><mo>,</mo><mi>k</mi></mrow></msub></mrow><mo>−</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒜</mi><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo>(</mo><msup><mi>𝑿</mi><mrow><mo stretchy="false">(</mo><mi>j</mi><mo stretchy="false">)</mo></mrow></msup><mo>)</mo></mrow><mrow><mn>1</mn><mo>,</mo><mi>l</mi></mrow></msub></mrow></mrow><mo>|</mo></mrow><mo>≥</mo><mi>ϕ</mi></mrow><annotation encoding="application/x-tex">\left|\mathcal{A}\left(\boldsymbol{X}^{(i)}\right)_{1,k}-\mathcal{A}\left(\boldsymbol{X}^{(j)}\right)_{1,l}\right|\geq\phi</annotation></semantics></math><span id="S4.I1.i2.p1.1.6" class="ltx_text ltx_font_italic">.</span></p>
</div></li>
</ul>
<p id="Thmdefinition3.p1.2" class="ltx_p"><span id="Thmdefinition3.p1.2.1" class="ltx_text ltx_font_italic">In particular, <math id="Thmdefinition3.p1.m7" class="ltx_Math" alttext="\mathcal{A}(\boldsymbol{X}^{(i)})_{1,k}" display="inline" intent=":literal"><semantics><mrow><mi class="ltx_font_mathcaligraphic">𝒜</mi><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">(</mo><msup><mi>𝐗</mi><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow><mrow><mn>1</mn><mo>,</mo><mi>k</mi></mrow></msub></mrow><annotation encoding="application/x-tex">\mathcal{A}(\boldsymbol{X}^{(i)})_{1,k}</annotation></semantics></math> is called a <span id="Thmdefinition3.p1.2.1.1" class="ltx_text ltx_font_bold">context id</span> of the <math id="Thmdefinition3.p1.m8" class="ltx_Math" alttext="k" display="inline" intent=":literal"><semantics><mi>k</mi><annotation encoding="application/x-tex">k</annotation></semantics></math>-th token in <math id="Thmdefinition3.p1.m9" class="ltx_Math" alttext="X^{(i)}" display="inline" intent=":literal"><semantics><msup><mi>X</mi><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></msup><annotation encoding="application/x-tex">X^{(i)}</annotation></semantics></math>.</span></p>
</div>
</div>
<div id="S4.SS1.p2" class="ltx_para">
<p id="S4.SS1.p2.1" class="ltx_p">The following lemma shows that Transformers can realize contextual mapping (in fact, this is one of the key reasons for their tremendous success in natural language processing and other domains). Its proof is presented in Section <a href="#S4.SS2" title="4.2 Proof of Lemma : Realizing Contextual Mapping by Transformers ‣ 4 Proof of Lemma : Memorization of Transformers ‣ Standard Transformers Achieve the Minimax Rate in Nonparametric Regression with 𝐶^{𝑠,𝜆} Targets" class="ltx_ref"><span class="ltx_text ltx_ref_tag">4.2</span></a>.</p>
</div>
<div id="Thmlemma14" class="ltx_theorem ltx_theorem_lemma">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="Thmlemma14.2" class="ltx_text ltx_font_bold">Lemma 14</span></span><span id="Thmlemma14.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="Thmlemma14.p1" class="ltx_para">
<p id="Thmlemma14.p1.1" class="ltx_p"><span id="Thmlemma14.p1.1.1" class="ltx_text ltx_font_italic">Let <math id="Thmlemma14.p1.m1" class="ltx_Math" alttext="d,n,N\in\mathbb{N}_{\geq 1}" display="inline" intent=":literal"><semantics><mrow><mi>d</mi><mo>,</mo><mi>n</mi><mo>,</mo><mrow><mi>N</mi><mo>∈</mo><msub><mi>ℕ</mi><mrow><mphantom></mphantom><mo>≥</mo><mn>1</mn></mrow></msub></mrow></mrow><annotation encoding="application/x-tex">d,n,N\in\mathbb{N}_{\geq 1}</annotation></semantics></math> and <math id="Thmlemma14.p1.m2" class="ltx_Math" alttext="r,\phi\in\mathbb{R}_{&gt;0}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>r</mi><mo>,</mo><mi>ϕ</mi></mrow><mo>∈</mo><msub><mi>ℝ</mi><mrow><mphantom></mphantom><mo>&gt;</mo><mn>0</mn></mrow></msub></mrow><annotation encoding="application/x-tex">r,\phi\in\mathbb{R}_{&gt;0}</annotation></semantics></math>. Let <math id="Thmlemma14.p1.m3" class="ltx_Math" alttext="\boldsymbol{X}^{(1)},\cdots,\boldsymbol{X}^{(N)}\in\mathbb{R}^{d\times n}" display="inline" intent=":literal"><semantics><mrow><msup><mi>𝐗</mi><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msup><mo>,</mo><mo lspace="0em" rspace="0em">⋯</mo><mo>,</mo><mrow><msup><mi>𝐗</mi><mrow><mo stretchy="false">(</mo><mi>N</mi><mo stretchy="false">)</mo></mrow></msup><mo>∈</mo><msup><mi>ℝ</mi><mrow><mi>d</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>n</mi></mrow></msup></mrow></mrow><annotation encoding="application/x-tex">\boldsymbol{X}^{(1)},\cdots,\boldsymbol{X}^{(N)}\in\mathbb{R}^{d\times n}</annotation></semantics></math> be a set of <math id="Thmlemma14.p1.m4" class="ltx_Math" alttext="N" display="inline" intent=":literal"><semantics><mi>N</mi><annotation encoding="application/x-tex">N</annotation></semantics></math> input sequences that are tokenwise <math id="Thmlemma14.p1.m5" class="ltx_Math" alttext="(r,\phi)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi>r</mi><mo>,</mo><mi>ϕ</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(r,\phi)</annotation></semantics></math>-separated. There eixsts a Transformer <math id="Thmlemma14.p1.m6" class="ltx_Math" alttext="\boldsymbol{T}^{(cm)}:\mathbb{R}^{d\times n}\to\mathbb{R}^{1\times n}" display="inline" intent=":literal"><semantics><mrow><msup><mi>𝐓</mi><mrow><mo stretchy="false">(</mo><mrow><mi>c</mi><mo lspace="0em" rspace="0em">​</mo><mi>m</mi></mrow><mo stretchy="false">)</mo></mrow></msup><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><msup><mi>ℝ</mi><mrow><mi>d</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>n</mi></mrow></msup><mo stretchy="false">→</mo><msup><mi>ℝ</mi><mrow><mn>1</mn><mo lspace="0.222em" rspace="0.222em">×</mo><mi>n</mi></mrow></msup></mrow></mrow><annotation encoding="application/x-tex">\boldsymbol{T}^{(cm)}:\mathbb{R}^{d\times n}\to\mathbb{R}^{1\times n}</annotation></semantics></math> with size <math id="Thmlemma14.p1.m7" class="ltx_Math" alttext="\{(2,\max\{d,5\}),((3,3),(3,11))\times(n-1)\text{ times},(3,3),(2,5)\}" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">{</mo><mrow><mrow><mo stretchy="false">(</mo><mn>2</mn><mo>,</mo><mrow><mi>max</mi><mo>⁡</mo><mrow><mo stretchy="false">{</mo><mi>d</mi><mo>,</mo><mn>5</mn><mo stretchy="false">}</mo></mrow></mrow><mo stretchy="false">)</mo></mrow><mo>,</mo><mrow><mrow><mrow><mo stretchy="false">(</mo><mrow><mo stretchy="false">(</mo><mn>3</mn><mo>,</mo><mn>3</mn><mo stretchy="false">)</mo></mrow><mo>,</mo><mrow><mo stretchy="false">(</mo><mn>3</mn><mo>,</mo><mn>11</mn><mo stretchy="false">)</mo></mrow><mo rspace="0.055em" stretchy="false">)</mo></mrow><mo rspace="0.222em">×</mo><mrow><mo stretchy="false">(</mo><mrow><mi>n</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><mtext class="ltx_mathvariant_italic"> times</mtext></mrow><mo>,</mo><mrow><mo stretchy="false">(</mo><mn>3</mn><mo>,</mo><mn>3</mn><mo stretchy="false">)</mo></mrow><mo>,</mo><mrow><mo stretchy="false">(</mo><mn>2</mn><mo>,</mo><mn>5</mn><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">}</mo></mrow><annotation encoding="application/x-tex">\{(2,\max\{d,5\}),((3,3),(3,11))\times(n-1)\text{ times},(3,3),(2,5)\}</annotation></semantics></math> and dimension vector <math id="Thmlemma14.p1.m8" class="ltx_Math" alttext="\begin{pmatrix}d&amp;d&amp;5\cdot\boldsymbol{1}_{1\times n}&amp;1\end{pmatrix}" display="inline" intent=":literal"><semantics><mrow><mo>(</mo><mtable columnspacing="5pt"><mtr><mtd><mi>d</mi></mtd><mtd><mi>d</mi></mtd><mtd><mrow><mn>5</mn><mo lspace="0.222em" rspace="0.222em">⋅</mo><msub><mn>𝟏</mn><mrow><mn>1</mn><mo lspace="0.222em" rspace="0.222em">×</mo><mi>n</mi></mrow></msub></mrow></mtd><mtd><mn>1</mn></mtd></mtr></mtable><mo>)</mo></mrow><annotation encoding="application/x-tex">\begin{pmatrix}d&amp;d&amp;5\cdot\boldsymbol{1}_{1\times n}&amp;1\end{pmatrix}</annotation></semantics></math> such that it is an <math id="Thmlemma14.p1.m9" class="ltx_Math" alttext="(R,2)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi>R</mi><mo>,</mo><mn>2</mn><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(R,2)</annotation></semantics></math>-contextual mapping with</span></p>
<table id="S4.EGx132" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="S4.Ex199"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S4.Ex199.m1" class="ltx_Math" alttext="\displaystyle R:=(\sqrt{2\pi d}n^{2}N^{2}r\phi^{-1}+1)\left(\frac{3{\pi}}{4}\sqrt{d}n^{3}N^{4}r\phi^{-1}+\frac{3}{2}\right)." display="inline" intent=":literal"><semantics><mrow><mrow><mi>R</mi><mo>:=</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mrow><msqrt><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>π</mi><mo lspace="0em" rspace="0em">​</mo><mi>d</mi></mrow></msqrt><mo lspace="0em" rspace="0em">​</mo><msup><mi>n</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>N</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>ϕ</mi><mrow><mo>−</mo><mn>1</mn></mrow></msup></mrow><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mrow><mstyle displaystyle="true"><mfrac><mrow><mn>3</mn><mo lspace="0em" rspace="0em">​</mo><mi>π</mi></mrow><mn>4</mn></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msqrt><mi>d</mi></msqrt><mo lspace="0em" rspace="0em">​</mo><msup><mi>n</mi><mn>3</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>N</mi><mn>4</mn></msup><mo lspace="0em" rspace="0em">​</mo><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>ϕ</mi><mrow><mo>−</mo><mn>1</mn></mrow></msup></mrow><mo>+</mo><mstyle displaystyle="true"><mfrac><mn>3</mn><mn>2</mn></mfrac></mstyle></mrow><mo>)</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle R:=(\sqrt{2\pi d}n^{2}N^{2}r\phi^{-1}+1)\left(\frac{3{\pi}}{4}\sqrt{d}n^{3}N^{4}r\phi^{-1}+\frac{3}{2}\right).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="Thmlemma14.p1.2" class="ltx_p"><span id="Thmlemma14.p1.2.1" class="ltx_text ltx_font_italic">The weight bounds of <math id="Thmlemma14.p1.m10" class="ltx_Math" alttext="\boldsymbol{T}^{(cm)}" display="inline" intent=":literal"><semantics><msup><mi>𝐓</mi><mrow><mo stretchy="false">(</mo><mrow><mi>c</mi><mo lspace="0em" rspace="0em">​</mo><mi>m</mi></mrow><mo stretchy="false">)</mo></mrow></msup><annotation encoding="application/x-tex">\boldsymbol{T}^{(cm)}</annotation></semantics></math> are <math id="Thmlemma14.p1.m11" class="ltx_Math" alttext="B_{FF}=\max\left\{\sqrt{2}n^{2}N^{2}\sqrt{\pi d}r\phi^{-1}+1,\frac{3\sqrt{2}}{8}N^{2}\sqrt{\pi n}\right\},B_{SA}=\frac{1}{2}\log(3\sqrt{d}{\pi}n^{4}N^{4}r\phi^{-1})" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>B</mi><mrow><mi>F</mi><mo lspace="0em" rspace="0em">​</mo><mi>F</mi></mrow></msub><mo>=</mo><mrow><mi>max</mi><mo>⁡</mo><mrow><mo>{</mo><mrow><mrow><mrow><msqrt><mn>2</mn></msqrt><mo lspace="0em" rspace="0em">​</mo><msup><mi>n</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>N</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msqrt><mrow><mi>π</mi><mo lspace="0em" rspace="0em">​</mo><mi>d</mi></mrow></msqrt><mo lspace="0em" rspace="0em">​</mo><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>ϕ</mi><mrow><mo>−</mo><mn>1</mn></mrow></msup></mrow><mo>+</mo><mn>1</mn></mrow><mo>,</mo><mrow><mfrac><mrow><mn>3</mn><mo lspace="0em" rspace="0em">​</mo><msqrt><mn>2</mn></msqrt></mrow><mn>8</mn></mfrac><mo lspace="0em" rspace="0em">​</mo><msup><mi>N</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msqrt><mrow><mi>π</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow></msqrt></mrow></mrow><mo>}</mo></mrow></mrow></mrow><mo>,</mo><mrow><msub><mi>B</mi><mrow><mi>S</mi><mo lspace="0em" rspace="0em">​</mo><mi>A</mi></mrow></msub><mo>=</mo><mrow><mfrac><mn>1</mn><mn>2</mn></mfrac><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>log</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mn>3</mn><mo lspace="0em" rspace="0em">​</mo><msqrt><mi>d</mi></msqrt><mo lspace="0em" rspace="0em">​</mo><mi>π</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>n</mi><mn>4</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>N</mi><mn>4</mn></msup><mo lspace="0em" rspace="0em">​</mo><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>ϕ</mi><mrow><mo>−</mo><mn>1</mn></mrow></msup></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">B_{FF}=\max\left\{\sqrt{2}n^{2}N^{2}\sqrt{\pi d}r\phi^{-1}+1,\frac{3\sqrt{2}}{8}N^{2}\sqrt{\pi n}\right\},B_{SA}=\frac{1}{2}\log(3\sqrt{d}{\pi}n^{4}N^{4}r\phi^{-1})</annotation></semantics></math>. Furthermore, if <math id="Thmlemma14.p1.m12" class="ltx_Math" alttext="\boldsymbol{X}\in\mathbb{R}^{d\times n}" display="inline" intent=":literal"><semantics><mrow><mi>𝐗</mi><mo>∈</mo><msup><mi>ℝ</mi><mrow><mi>d</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>n</mi></mrow></msup></mrow><annotation encoding="application/x-tex">\boldsymbol{X}\in\mathbb{R}^{d\times n}</annotation></semantics></math> satisfies <math id="Thmlemma14.p1.m13" class="ltx_math_unparsed" alttext="\left\|\boldsymbol{X}_{:,k}\right\|_{2}\leq r" display="inline" intent=":literal"><semantics><mrow><msub><mrow><mo>‖</mo><msub><mi>𝐗</mi><mrow><mo rspace="0em">:</mo><mo>,</mo><mi>k</mi></mrow></msub><mo>‖</mo></mrow><mn>2</mn></msub><mo>≤</mo><mi>r</mi></mrow><annotation encoding="application/x-tex">\left\|\boldsymbol{X}_{:,k}\right\|_{2}\leq r</annotation></semantics></math> for all <math id="Thmlemma14.p1.m14" class="ltx_Math" alttext="k\in[n]" display="inline" intent=":literal"><semantics><mrow><mi>k</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mi>n</mi><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">k\in[n]</annotation></semantics></math>, then <math id="Thmlemma14.p1.m15" class="ltx_Math" alttext="\left|\boldsymbol{T}^{(cm)}\left(\boldsymbol{X}\right)_{1,k}\right|\leq R" display="inline" intent=":literal"><semantics><mrow><mrow><mo>|</mo><mrow><msup><mi>𝐓</mi><mrow><mo stretchy="false">(</mo><mrow><mi>c</mi><mo lspace="0em" rspace="0em">​</mo><mi>m</mi></mrow><mo stretchy="false">)</mo></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo>(</mo><mi>𝐗</mi><mo>)</mo></mrow><mrow><mn>1</mn><mo>,</mo><mi>k</mi></mrow></msub></mrow><mo>|</mo></mrow><mo>≤</mo><mi>R</mi></mrow><annotation encoding="application/x-tex">\left|\boldsymbol{T}^{(cm)}\left(\boldsymbol{X}\right)_{1,k}\right|\leq R</annotation></semantics></math> for all <math id="Thmlemma14.p1.m16" class="ltx_Math" alttext="k\in[n]" display="inline" intent=":literal"><semantics><mrow><mi>k</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mi>n</mi><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">k\in[n]</annotation></semantics></math>.</span></p>
</div>
</div>
<div id="Thmlemma15" class="ltx_theorem ltx_theorem_lemma">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="Thmlemma15.2" class="ltx_text ltx_font_bold">Lemma 15</span></span><span id="Thmlemma15.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="Thmlemma15.p1" class="ltx_para">
<p id="Thmlemma15.p1.1" class="ltx_p"><span id="Thmlemma15.p1.1.1" class="ltx_text ltx_font_italic">Let <math id="Thmlemma15.p1.m1" class="ltx_Math" alttext="N\in\mathbb{N}_{\geq 2}" display="inline" intent=":literal"><semantics><mrow><mi>N</mi><mo>∈</mo><msub><mi>ℕ</mi><mrow><mphantom></mphantom><mo>≥</mo><mn>2</mn></mrow></msub></mrow><annotation encoding="application/x-tex">N\in\mathbb{N}_{\geq 2}</annotation></semantics></math> and <math id="Thmlemma15.p1.m2" class="ltx_Math" alttext="\phi,B_{x},B_{y}\in\mathbb{R}_{&gt;0}" display="inline" intent=":literal"><semantics><mrow><mi>ϕ</mi><mo>,</mo><msub><mi>B</mi><mi>x</mi></msub><mo>,</mo><mrow><msub><mi>B</mi><mi>y</mi></msub><mo>∈</mo><msub><mi>ℝ</mi><mrow><mphantom></mphantom><mo>&gt;</mo><mn>0</mn></mrow></msub></mrow></mrow><annotation encoding="application/x-tex">\phi,B_{x},B_{y}\in\mathbb{R}_{&gt;0}</annotation></semantics></math>. For any <math id="Thmlemma15.p1.m3" class="ltx_Math" alttext="N" display="inline" intent=":literal"><semantics><mi>N</mi><annotation encoding="application/x-tex">N</annotation></semantics></math> data pairs <math id="Thmlemma15.p1.m4" class="ltx_Math" alttext="\{(x_{i},y_{i})\}_{i\in[N]}\subset[-B_{x},B_{x}]\times[-B_{y},B_{y}]" display="inline" intent=":literal"><semantics><mrow><msub><mrow><mo stretchy="false">{</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mi>i</mi></msub><mo>,</mo><msub><mi>y</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow><mo stretchy="false">}</mo></mrow><mrow><mi>i</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mi>N</mi><mo stretchy="false">]</mo></mrow></mrow></msub><mo>⊂</mo><mrow><mrow><mo stretchy="false">[</mo><mrow><mrow><mo>−</mo><msub><mi>B</mi><mi>x</mi></msub></mrow><mo>,</mo><msub><mi>B</mi><mi>x</mi></msub></mrow><mo rspace="0.055em" stretchy="false">]</mo></mrow><mo rspace="0.222em">×</mo><mrow><mo stretchy="false">[</mo><mrow><mrow><mo>−</mo><msub><mi>B</mi><mi>y</mi></msub></mrow><mo>,</mo><msub><mi>B</mi><mi>y</mi></msub></mrow><mo stretchy="false">]</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\{(x_{i},y_{i})\}_{i\in[N]}\subset[-B_{x},B_{x}]\times[-B_{y},B_{y}]</annotation></semantics></math> satisfying <math id="Thmlemma15.p1.m5" class="ltx_Math" alttext="|x_{i}-x_{j}|\geq\phi" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">|</mo><mrow><msub><mi>x</mi><mi>i</mi></msub><mo>−</mo><msub><mi>x</mi><mi>j</mi></msub></mrow><mo stretchy="false">|</mo></mrow><mo>≥</mo><mi>ϕ</mi></mrow><annotation encoding="application/x-tex">|x_{i}-x_{j}|\geq\phi</annotation></semantics></math> for any <math id="Thmlemma15.p1.m6" class="ltx_Math" alttext="i,j\in[N]" display="inline" intent=":literal"><semantics><mrow><mrow><mi>i</mi><mo>,</mo><mi>j</mi></mrow><mo>∈</mo><mrow><mo stretchy="false">[</mo><mi>N</mi><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">i,j\in[N]</annotation></semantics></math> with <math id="Thmlemma15.p1.m7" class="ltx_Math" alttext="i\neq j" display="inline" intent=":literal"><semantics><mrow><mi>i</mi><mo>≠</mo><mi>j</mi></mrow><annotation encoding="application/x-tex">i\neq j</annotation></semantics></math>, there exists a ReLU FNN function <math id="Thmlemma15.p1.m8" class="ltx_Math" alttext="f_{FF}^{(mmr)}:\mathbb{R}\to\mathbb{R}" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>f</mi><mrow><mi>F</mi><mo lspace="0em" rspace="0em">​</mo><mi>F</mi></mrow><mrow><mo stretchy="false">(</mo><mrow><mi>m</mi><mo lspace="0em" rspace="0em">​</mo><mi>m</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi></mrow><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi>ℝ</mi><mo stretchy="false">→</mo><mi>ℝ</mi></mrow></mrow><annotation encoding="application/x-tex">f_{FF}^{(mmr)}:\mathbb{R}\to\mathbb{R}</annotation></semantics></math> with width <math id="Thmlemma15.p1.m9" class="ltx_Math" alttext="N-1" display="inline" intent=":literal"><semantics><mrow><mi>N</mi><mo>−</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">N-1</annotation></semantics></math>, depth <math id="Thmlemma15.p1.m10" class="ltx_Math" alttext="2" display="inline" intent=":literal"><semantics><mn>2</mn><annotation encoding="application/x-tex">2</annotation></semantics></math> and weight bound <math id="Thmlemma15.p1.m11" class="ltx_Math" alttext="\max\{1,B_{x},B_{y},4B_{y}/\phi\}" display="inline" intent=":literal"><semantics><mrow><mi>max</mi><mo>⁡</mo><mrow><mo stretchy="false">{</mo><mrow><mn>1</mn><mo>,</mo><msub><mi>B</mi><mi>x</mi></msub><mo>,</mo><msub><mi>B</mi><mi>y</mi></msub><mo>,</mo><mrow><mrow><mn>4</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>B</mi><mi>y</mi></msub></mrow><mo>/</mo><mi>ϕ</mi></mrow></mrow><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">\max\{1,B_{x},B_{y},4B_{y}/\phi\}</annotation></semantics></math> such that</span></p>
<table id="S4.EGx133" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="S4.E13"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S4.E13.m1" class="ltx_Math" alttext="\displaystyle f_{FF}^{(mmr)}(x_{i})=y_{i},\quad i\in[N]." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mrow><msubsup><mi>f</mi><mrow><mi>F</mi><mo lspace="0em" rspace="0em">​</mo><mi>F</mi></mrow><mrow><mo stretchy="false">(</mo><mrow><mi>m</mi><mo lspace="0em" rspace="0em">​</mo><mi>m</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi></mrow><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><msub><mi>y</mi><mi>i</mi></msub></mrow><mo rspace="1.167em">,</mo><mrow><mi>i</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mi>N</mi><mo stretchy="false">]</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle f_{FF}^{(mmr)}(x_{i})=y_{i},\quad i\in[N].</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(13)</span></td></tr></tbody>
</table>
<p id="Thmlemma15.p1.2" class="ltx_p"><span id="Thmlemma15.p1.2.1" class="ltx_text ltx_font_italic">Furthermore, <math id="Thmlemma15.p1.m12" class="ltx_Math" alttext="\left|f_{FF}^{(mmr)}(x)\right|\leq\frac{8(N-1)B_{x}B_{y}}{\phi}+B_{y}" display="inline" intent=":literal"><semantics><mrow><mrow><mo>|</mo><mrow><msubsup><mi>f</mi><mrow><mi>F</mi><mo lspace="0em" rspace="0em">​</mo><mi>F</mi></mrow><mrow><mo stretchy="false">(</mo><mrow><mi>m</mi><mo lspace="0em" rspace="0em">​</mo><mi>m</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi></mrow><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo>|</mo></mrow><mo>≤</mo><mrow><mfrac><mrow><mn>8</mn><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>N</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>B</mi><mi>x</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>B</mi><mi>y</mi></msub></mrow><mi>ϕ</mi></mfrac><mo>+</mo><msub><mi>B</mi><mi>y</mi></msub></mrow></mrow><annotation encoding="application/x-tex">\left|f_{FF}^{(mmr)}(x)\right|\leq\frac{8(N-1)B_{x}B_{y}}{\phi}+B_{y}</annotation></semantics></math> for any <math id="Thmlemma15.p1.m13" class="ltx_Math" alttext="x\in[-B_{x},B_{x}]" display="inline" intent=":literal"><semantics><mrow><mi>x</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mrow><mrow><mo>−</mo><msub><mi>B</mi><mi>x</mi></msub></mrow><mo>,</mo><msub><mi>B</mi><mi>x</mi></msub></mrow><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">x\in[-B_{x},B_{x}]</annotation></semantics></math>.</span></p>
</div>
</div>
<div id="S4.SS1.2" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="S4.SS1.p3" class="ltx_para">
<p id="S4.SS1.p3.1" class="ltx_p"><span id="S4.SS1.p3.1.1" class="ltx_text">Without loss of generality, we assmue <math id="S4.SS1.p3.m1" class="ltx_Math" alttext="x_{1}&lt;x_{2}&lt;\cdots&lt;x_{N}" display="inline" intent=":literal"><semantics><mrow><msub><mi>x</mi><mn>1</mn></msub><mo>&lt;</mo><msub><mi>x</mi><mn>2</mn></msub><mo rspace="0.1389em">&lt;</mo><mo lspace="0.1389em" rspace="0.1389em">⋯</mo><mo lspace="0.1389em">&lt;</mo><msub><mi>x</mi><mi>N</mi></msub></mrow><annotation encoding="application/x-tex">x_{1}&lt;x_{2}&lt;\cdots&lt;x_{N}</annotation></semantics></math>. <math id="S4.SS1.p3.m2" class="ltx_Math" alttext="f_{FF}^{(mmr)}" display="inline" intent=":literal"><semantics><msubsup><mi>f</mi><mrow><mi>F</mi><mo lspace="0em" rspace="0em">​</mo><mi>F</mi></mrow><mrow><mo stretchy="false">(</mo><mrow><mi>m</mi><mo lspace="0em" rspace="0em">​</mo><mi>m</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi></mrow><mo stretchy="false">)</mo></mrow></msubsup><annotation encoding="application/x-tex">f_{FF}^{(mmr)}</annotation></semantics></math> is defined as</span></p>
<table id="S4.EGx134" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="S4.Ex200"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S4.Ex200.m1" class="ltx_Math" alttext="\displaystyle f_{FF}^{(mmr)}(x):=\boldsymbol{W}_{2}\sigma_{R}(\boldsymbol{W}_{1}x+\boldsymbol{b}_{1})+b_{2}" display="inline" intent=":literal"><semantics><mrow><mrow><msubsup><mi>f</mi><mrow><mi>F</mi><mo lspace="0em" rspace="0em">​</mo><mi>F</mi></mrow><mrow><mo stretchy="false">(</mo><mrow><mi>m</mi><mo lspace="0em" rspace="0em">​</mo><mi>m</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi></mrow><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo>:=</mo><mrow><mrow><msub><mi>𝑾</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>σ</mi><mi>R</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><msub><mi>𝑾</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mi>x</mi></mrow><mo>+</mo><msub><mi>𝒃</mi><mn>1</mn></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><msub><mi>b</mi><mn>2</mn></msub></mrow></mrow><annotation encoding="application/x-tex">\displaystyle f_{FF}^{(mmr)}(x):=\boldsymbol{W}_{2}\sigma_{R}(\boldsymbol{W}_{1}x+\boldsymbol{b}_{1})+b_{2}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S4.SS1.p3.2" class="ltx_p"><span id="S4.SS1.p3.2.1" class="ltx_text">with</span></p>
<table id="S4.EGx135" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="S4.Ex201"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S4.Ex201.m1" class="ltx_Math" alttext="\displaystyle\boldsymbol{W}_{1}:=\boldsymbol{1}_{N-1}\in\mathbb{R}^{N-1},\quad\boldsymbol{b}_{1}:=(-x_{1},-x_{2},\cdots,-x_{N-1})^{\top}\in\mathbb{R}^{N-1},\quad b_{2}:=y_{1}\in\mathbb{R}" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>𝑾</mi><mn>1</mn></msub><mo>:=</mo><msub><mn>𝟏</mn><mrow><mi>N</mi><mo>−</mo><mn>1</mn></mrow></msub><mo>∈</mo><msup><mi>ℝ</mi><mrow><mi>N</mi><mo>−</mo><mn>1</mn></mrow></msup></mrow><mo rspace="1.167em">,</mo><mrow><msub><mi>𝒃</mi><mn>1</mn></msub><mo>:=</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mo>−</mo><msub><mi>x</mi><mn>1</mn></msub></mrow><mo>,</mo><mrow><mo>−</mo><msub><mi>x</mi><mn>2</mn></msub></mrow><mo>,</mo><mo lspace="0em" rspace="0em">⋯</mo><mo>,</mo><mrow><mo>−</mo><msub><mi>x</mi><mrow><mi>N</mi><mo>−</mo><mn>1</mn></mrow></msub></mrow><mo stretchy="false">)</mo></mrow><mo>⊤</mo></msup><mo>∈</mo><msup><mi>ℝ</mi><mrow><mi>N</mi><mo>−</mo><mn>1</mn></mrow></msup></mrow><mo rspace="1.167em">,</mo><mrow><msub><mi>b</mi><mn>2</mn></msub><mo>:=</mo><msub><mi>y</mi><mn>1</mn></msub><mo>∈</mo><mi>ℝ</mi></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\boldsymbol{W}_{1}:=\boldsymbol{1}_{N-1}\in\mathbb{R}^{N-1},\quad\boldsymbol{b}_{1}:=(-x_{1},-x_{2},\cdots,-x_{N-1})^{\top}\in\mathbb{R}^{N-1},\quad b_{2}:=y_{1}\in\mathbb{R}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S4.SS1.p3.3" class="ltx_p"><span id="S4.SS1.p3.3.1" class="ltx_text">and</span></p>
<table id="S4.EGx136" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="S4.Ex202"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S4.Ex202.m1" class="ltx_Math" alttext="\displaystyle\boldsymbol{W}_{2}:=\left(\frac{y_{2}-y_{1}}{x_{2}-x_{1}},\frac{y_{3}-y_{2}}{x_{3}-x_{2}}-\frac{y_{2}-y_{1}}{x_{2}-x_{1}},\cdots,\frac{y_{N}-y_{N-1}}{x_{N}-x_{N-1}}-\frac{y_{N-1}-y_{N-2}}{x_{N-1}-x_{N-2}}\right)\in\mathbb{R}^{1\times(N-1)}." display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>𝑾</mi><mn>2</mn></msub><mo>:=</mo><mrow><mo>(</mo><mstyle displaystyle="true"><mfrac><mrow><msub><mi>y</mi><mn>2</mn></msub><mo>−</mo><msub><mi>y</mi><mn>1</mn></msub></mrow><mrow><msub><mi>x</mi><mn>2</mn></msub><mo>−</mo><msub><mi>x</mi><mn>1</mn></msub></mrow></mfrac></mstyle><mo>,</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><msub><mi>y</mi><mn>3</mn></msub><mo>−</mo><msub><mi>y</mi><mn>2</mn></msub></mrow><mrow><msub><mi>x</mi><mn>3</mn></msub><mo>−</mo><msub><mi>x</mi><mn>2</mn></msub></mrow></mfrac></mstyle><mo>−</mo><mstyle displaystyle="true"><mfrac><mrow><msub><mi>y</mi><mn>2</mn></msub><mo>−</mo><msub><mi>y</mi><mn>1</mn></msub></mrow><mrow><msub><mi>x</mi><mn>2</mn></msub><mo>−</mo><msub><mi>x</mi><mn>1</mn></msub></mrow></mfrac></mstyle></mrow><mo>,</mo><mo lspace="0em" rspace="0em">⋯</mo><mo>,</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><msub><mi>y</mi><mi>N</mi></msub><mo>−</mo><msub><mi>y</mi><mrow><mi>N</mi><mo>−</mo><mn>1</mn></mrow></msub></mrow><mrow><msub><mi>x</mi><mi>N</mi></msub><mo>−</mo><msub><mi>x</mi><mrow><mi>N</mi><mo>−</mo><mn>1</mn></mrow></msub></mrow></mfrac></mstyle><mo>−</mo><mstyle displaystyle="true"><mfrac><mrow><msub><mi>y</mi><mrow><mi>N</mi><mo>−</mo><mn>1</mn></mrow></msub><mo>−</mo><msub><mi>y</mi><mrow><mi>N</mi><mo>−</mo><mn>2</mn></mrow></msub></mrow><mrow><msub><mi>x</mi><mrow><mi>N</mi><mo>−</mo><mn>1</mn></mrow></msub><mo>−</mo><msub><mi>x</mi><mrow><mi>N</mi><mo>−</mo><mn>2</mn></mrow></msub></mrow></mfrac></mstyle></mrow><mo>)</mo></mrow><mo>∈</mo><msup><mi>ℝ</mi><mrow><mn>1</mn><mo lspace="0.222em" rspace="0.222em">×</mo><mrow><mo stretchy="false">(</mo><mrow><mi>N</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow></msup></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\boldsymbol{W}_{2}:=\left(\frac{y_{2}-y_{1}}{x_{2}-x_{1}},\frac{y_{3}-y_{2}}{x_{3}-x_{2}}-\frac{y_{2}-y_{1}}{x_{2}-x_{1}},\cdots,\frac{y_{N}-y_{N-1}}{x_{N}-x_{N-1}}-\frac{y_{N-1}-y_{N-2}}{x_{N-1}-x_{N-2}}\right)\in\mathbb{R}^{1\times(N-1)}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S4.SS1.p3.4" class="ltx_p"><span id="S4.SS1.p3.4.1" class="ltx_text">It follows that</span></p>
<table id="S4.EGx137" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="S4.Ex203"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S4.Ex203.m1" class="ltx_Math" alttext="\displaystyle f_{FF}^{(mmr)}(x_{i})" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>f</mi><mrow><mi>F</mi><mo lspace="0em" rspace="0em">​</mo><mi>F</mi></mrow><mrow><mo stretchy="false">(</mo><mrow><mi>m</mi><mo lspace="0em" rspace="0em">​</mo><mi>m</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi></mrow><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle f_{FF}^{(mmr)}(x_{i})</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S4.Ex203.m2" class="ltx_Math" alttext="\displaystyle=\boldsymbol{W}_{2}\sigma_{R}(\boldsymbol{W}_{1}x_{i}+\boldsymbol{b}_{1})+b_{2}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><msub><mi>𝑾</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>σ</mi><mi>R</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><msub><mi>𝑾</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>x</mi><mi>i</mi></msub></mrow><mo>+</mo><msub><mi>𝒃</mi><mn>1</mn></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><msub><mi>b</mi><mn>2</mn></msub></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\boldsymbol{W}_{2}\sigma_{R}(\boldsymbol{W}_{1}x_{i}+\boldsymbol{b}_{1})+b_{2}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="S4.Ex204"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S4.Ex204.m1" class="ltx_Math" alttext="\displaystyle=\frac{y_{2}-y_{1}}{x_{2}-x_{1}}\cdot(x_{i}-x_{1})+\sum_{j=2}^{i-1}\left(\frac{y_{j+1}-y_{j}}{x_{j+1}-x_{j}}-\frac{y_{j}-y_{j-1}}{x_{j}-x_{j-1}}\right)\cdot(x_{i}-x_{j})+y_{1}." display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><mstyle displaystyle="true"><mfrac><mrow><msub><mi>y</mi><mn>2</mn></msub><mo>−</mo><msub><mi>y</mi><mn>1</mn></msub></mrow><mrow><msub><mi>x</mi><mn>2</mn></msub><mo>−</mo><msub><mi>x</mi><mn>1</mn></msub></mrow></mfrac></mstyle><mo lspace="0.222em" rspace="0.222em">⋅</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>x</mi><mi>i</mi></msub><mo>−</mo><msub><mi>x</mi><mn>1</mn></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mrow><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>j</mi><mo>=</mo><mn>2</mn></mrow><mrow><mi>i</mi><mo>−</mo><mn>1</mn></mrow></munderover></mstyle><mrow><mo>(</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><msub><mi>y</mi><mrow><mi>j</mi><mo>+</mo><mn>1</mn></mrow></msub><mo>−</mo><msub><mi>y</mi><mi>j</mi></msub></mrow><mrow><msub><mi>x</mi><mrow><mi>j</mi><mo>+</mo><mn>1</mn></mrow></msub><mo>−</mo><msub><mi>x</mi><mi>j</mi></msub></mrow></mfrac></mstyle><mo>−</mo><mstyle displaystyle="true"><mfrac><mrow><msub><mi>y</mi><mi>j</mi></msub><mo>−</mo><msub><mi>y</mi><mrow><mi>j</mi><mo>−</mo><mn>1</mn></mrow></msub></mrow><mrow><msub><mi>x</mi><mi>j</mi></msub><mo>−</mo><msub><mi>x</mi><mrow><mi>j</mi><mo>−</mo><mn>1</mn></mrow></msub></mrow></mfrac></mstyle></mrow><mo rspace="0.055em">)</mo></mrow></mrow><mo rspace="0.222em">⋅</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>x</mi><mi>i</mi></msub><mo>−</mo><msub><mi>x</mi><mi>j</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><msub><mi>y</mi><mn>1</mn></msub></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle=\frac{y_{2}-y_{1}}{x_{2}-x_{1}}\cdot(x_{i}-x_{1})+\sum_{j=2}^{i-1}\left(\frac{y_{j+1}-y_{j}}{x_{j+1}-x_{j}}-\frac{y_{j}-y_{j-1}}{x_{j}-x_{j-1}}\right)\cdot(x_{i}-x_{j})+y_{1}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S4.SS1.p3.5" class="ltx_p"><span id="S4.SS1.p3.5.1" class="ltx_text">If we express the right-hand side of the above equation as a linear combination of <math id="S4.SS1.p3.m3" class="ltx_Math" alttext="\{y_{j}\}_{j\in[N]}" display="inline" intent=":literal"><semantics><msub><mrow><mo stretchy="false">{</mo><msub><mi>y</mi><mi>j</mi></msub><mo stretchy="false">}</mo></mrow><mrow><mi>j</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mi>N</mi><mo stretchy="false">]</mo></mrow></mrow></msub><annotation encoding="application/x-tex">\{y_{j}\}_{j\in[N]}</annotation></semantics></math>, we can verify that the coefficient of <math id="S4.SS1.p3.m4" class="ltx_Math" alttext="y_{i}" display="inline" intent=":literal"><semantics><msub><mi>y</mi><mi>i</mi></msub><annotation encoding="application/x-tex">y_{i}</annotation></semantics></math> is <math id="S4.SS1.p3.m5" class="ltx_Math" alttext="1" display="inline" intent=":literal"><semantics><mn>1</mn><annotation encoding="application/x-tex">1</annotation></semantics></math> while the coefficients of all other <math id="S4.SS1.p3.m6" class="ltx_Math" alttext="y_{j}" display="inline" intent=":literal"><semantics><msub><mi>y</mi><mi>j</mi></msub><annotation encoding="application/x-tex">y_{j}</annotation></semantics></math> are <math id="S4.SS1.p3.m7" class="ltx_Math" alttext="0" display="inline" intent=":literal"><semantics><mn>0</mn><annotation encoding="application/x-tex">0</annotation></semantics></math>, which indicates that (<a href="#S4.E13" title="In Lemma 15. ‣ 4.1 Proof of Lemma ‣ 4 Proof of Lemma : Memorization of Transformers ‣ Standard Transformers Achieve the Minimax Rate in Nonparametric Regression with 𝐶^{𝑠,𝜆} Targets" class="ltx_ref"><span class="ltx_text ltx_ref_tag">13</span></a>) holds.</span></p>
</div>
<div id="S4.SS1.p4" class="ltx_para">
<p id="S4.SS1.p4.1" class="ltx_p"><span id="S4.SS1.p4.1.1" class="ltx_text">∎</span></p>
</div>
</div>
<div id="S4.SS1.3" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof of Lemma <a href="#Thmlemma7" title="Lemma 7. ‣ 3.1 Proof of Proposition ‣ 3 Proof of Proposition : Construction of Transformers ‣ Standard Transformers Achieve the Minimax Rate in Nonparametric Regression with 𝐶^{𝑠,𝜆} Targets" class="ltx_ref"><span class="ltx_text ltx_ref_tag">7</span></a>.</h6>
<div id="S4.SS1.p5" class="ltx_para">
<p id="S4.SS1.p5.1" class="ltx_p"><span id="S4.SS1.p5.1.1" class="ltx_text">The Transformer <math id="S4.SS1.p5.m1" class="ltx_Math" alttext="\boldsymbol{T}^{(mmr)}:\mathbb{R}^{d\times n}\to\mathbb{R}^{1\times n}" display="inline" intent=":literal"><semantics><mrow><msup><mi>𝑻</mi><mrow><mo stretchy="false">(</mo><mrow><mi>m</mi><mo lspace="0em" rspace="0em">​</mo><mi>m</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi></mrow><mo stretchy="false">)</mo></mrow></msup><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><msup><mi>ℝ</mi><mrow><mi>d</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>n</mi></mrow></msup><mo stretchy="false">→</mo><msup><mi>ℝ</mi><mrow><mn>1</mn><mo lspace="0.222em" rspace="0.222em">×</mo><mi>n</mi></mrow></msup></mrow></mrow><annotation encoding="application/x-tex">\boldsymbol{T}^{(mmr)}:\mathbb{R}^{d\times n}\to\mathbb{R}^{1\times n}</annotation></semantics></math> is defined as</span></p>
<table id="S4.EGx138" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="S4.Ex205"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S4.Ex205.m1" class="ltx_Math" alttext="\displaystyle\boldsymbol{T}^{(mmr)}:=\boldsymbol{\mathcal{F}}_{FF}^{(mmr)}\circ\boldsymbol{T}^{(cm)}," display="inline" intent=":literal"><semantics><mrow><mrow><msup><mi>𝑻</mi><mrow><mo stretchy="false">(</mo><mrow><mi>m</mi><mo lspace="0em" rspace="0em">​</mo><mi>m</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi></mrow><mo stretchy="false">)</mo></mrow></msup><mo>:=</mo><mrow><msubsup><mi class="ltx_font_mathcaligraphic">𝓕</mi><mrow><mi>F</mi><mo lspace="0em" rspace="0em">​</mo><mi>F</mi></mrow><mrow><mo stretchy="false">(</mo><mrow><mi>m</mi><mo lspace="0em" rspace="0em">​</mo><mi>m</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi></mrow><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0.222em" rspace="0.222em">∘</mo><msup><mi>𝑻</mi><mrow><mo stretchy="false">(</mo><mrow><mi>c</mi><mo lspace="0em" rspace="0em">​</mo><mi>m</mi></mrow><mo stretchy="false">)</mo></mrow></msup></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\boldsymbol{T}^{(mmr)}:=\boldsymbol{\mathcal{F}}_{FF}^{(mmr)}\circ\boldsymbol{T}^{(cm)},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S4.SS1.p5.2" class="ltx_p"><span id="S4.SS1.p5.2.1" class="ltx_text">where <math id="S4.SS1.p5.m2" class="ltx_Math" alttext="\boldsymbol{T}^{(cm)}:\mathbb{R}^{d\times n}\to\mathbb{R}^{1\times n}" display="inline" intent=":literal"><semantics><mrow><msup><mi>𝑻</mi><mrow><mo stretchy="false">(</mo><mrow><mi>c</mi><mo lspace="0em" rspace="0em">​</mo><mi>m</mi></mrow><mo stretchy="false">)</mo></mrow></msup><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><msup><mi>ℝ</mi><mrow><mi>d</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>n</mi></mrow></msup><mo stretchy="false">→</mo><msup><mi>ℝ</mi><mrow><mn>1</mn><mo lspace="0.222em" rspace="0.222em">×</mo><mi>n</mi></mrow></msup></mrow></mrow><annotation encoding="application/x-tex">\boldsymbol{T}^{(cm)}:\mathbb{R}^{d\times n}\to\mathbb{R}^{1\times n}</annotation></semantics></math> is from Lemma <a href="#Thmlemma14" title="Lemma 14. ‣ 4.1 Proof of Lemma ‣ 4 Proof of Lemma : Memorization of Transformers ‣ Standard Transformers Achieve the Minimax Rate in Nonparametric Regression with 𝐶^{𝑠,𝜆} Targets" class="ltx_ref"><span class="ltx_text ltx_ref_tag">14</span></a> with size <math id="S4.SS1.p5.m3" class="ltx_Math" alttext="\{(2,\max\{d,5\}),((3,3),(3,11))\times(n-1)\text{ times},(3,3),(2,5)\}" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">{</mo><mrow><mrow><mo stretchy="false">(</mo><mn>2</mn><mo>,</mo><mrow><mi>max</mi><mo>⁡</mo><mrow><mo stretchy="false">{</mo><mi>d</mi><mo>,</mo><mn>5</mn><mo stretchy="false">}</mo></mrow></mrow><mo stretchy="false">)</mo></mrow><mo>,</mo><mrow><mrow><mrow><mo stretchy="false">(</mo><mrow><mo stretchy="false">(</mo><mn>3</mn><mo>,</mo><mn>3</mn><mo stretchy="false">)</mo></mrow><mo>,</mo><mrow><mo stretchy="false">(</mo><mn>3</mn><mo>,</mo><mn>11</mn><mo stretchy="false">)</mo></mrow><mo rspace="0.055em" stretchy="false">)</mo></mrow><mo rspace="0.222em">×</mo><mrow><mo stretchy="false">(</mo><mrow><mi>n</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><mtext> times</mtext></mrow><mo>,</mo><mrow><mo stretchy="false">(</mo><mn>3</mn><mo>,</mo><mn>3</mn><mo stretchy="false">)</mo></mrow><mo>,</mo><mrow><mo stretchy="false">(</mo><mn>2</mn><mo>,</mo><mn>5</mn><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">}</mo></mrow><annotation encoding="application/x-tex">\{(2,\max\{d,5\}),((3,3),(3,11))\times(n-1)\text{ times},(3,3),(2,5)\}</annotation></semantics></math> and dimension vector <math id="S4.SS1.p5.m4" class="ltx_Math" alttext="\begin{pmatrix}d&amp;d&amp;5\cdot\boldsymbol{1}_{1\times n}&amp;1\end{pmatrix}" display="inline" intent=":literal"><semantics><mrow><mo>(</mo><mtable columnspacing="5pt"><mtr><mtd><mi>d</mi></mtd><mtd><mi>d</mi></mtd><mtd><mrow><mn>5</mn><mo lspace="0.222em" rspace="0.222em">⋅</mo><msub><mn>𝟏</mn><mrow><mn>1</mn><mo lspace="0.222em" rspace="0.222em">×</mo><mi>n</mi></mrow></msub></mrow></mtd><mtd><mn>1</mn></mtd></mtr></mtable><mo>)</mo></mrow><annotation encoding="application/x-tex">\begin{pmatrix}d&amp;d&amp;5\cdot\boldsymbol{1}_{1\times n}&amp;1\end{pmatrix}</annotation></semantics></math>; <math id="S4.SS1.p5.m5" class="ltx_Math" alttext="\boldsymbol{\mathcal{F}}_{FF}^{(mmr)}:\mathbb{R}^{1\times n}\to\mathbb{R}^{1\times n}" display="inline" intent=":literal"><semantics><mrow><msubsup><mi class="ltx_font_mathcaligraphic">𝓕</mi><mrow><mi>F</mi><mo lspace="0em" rspace="0em">​</mo><mi>F</mi></mrow><mrow><mo stretchy="false">(</mo><mrow><mi>m</mi><mo lspace="0em" rspace="0em">​</mo><mi>m</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi></mrow><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><msup><mi>ℝ</mi><mrow><mn>1</mn><mo lspace="0.222em" rspace="0.222em">×</mo><mi>n</mi></mrow></msup><mo stretchy="false">→</mo><msup><mi>ℝ</mi><mrow><mn>1</mn><mo lspace="0.222em" rspace="0.222em">×</mo><mi>n</mi></mrow></msup></mrow></mrow><annotation encoding="application/x-tex">\boldsymbol{\mathcal{F}}_{FF}^{(mmr)}:\mathbb{R}^{1\times n}\to\mathbb{R}^{1\times n}</annotation></semantics></math> is generated from <math id="S4.SS1.p5.m6" class="ltx_Math" alttext="f_{FF}^{(mmr)}:\mathbb{R}\to\mathbb{R}" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>f</mi><mrow><mi>F</mi><mo lspace="0em" rspace="0em">​</mo><mi>F</mi></mrow><mrow><mo stretchy="false">(</mo><mrow><mi>m</mi><mo lspace="0em" rspace="0em">​</mo><mi>m</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi></mrow><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi>ℝ</mi><mo stretchy="false">→</mo><mi>ℝ</mi></mrow></mrow><annotation encoding="application/x-tex">f_{FF}^{(mmr)}:\mathbb{R}\to\mathbb{R}</annotation></semantics></math> in Lemma <a href="#Thmlemma15" title="Lemma 15. ‣ 4.1 Proof of Lemma ‣ 4 Proof of Lemma : Memorization of Transformers ‣ Standard Transformers Achieve the Minimax Rate in Nonparametric Regression with 𝐶^{𝑠,𝜆} Targets" class="ltx_ref"><span class="ltx_text ltx_ref_tag">15</span></a> with width <math id="S4.SS1.p5.m7" class="ltx_Math" alttext="nN-1" display="inline" intent=":literal"><semantics><mrow><mrow><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><mi>N</mi></mrow><mo>−</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">nN-1</annotation></semantics></math> and depth <math id="S4.SS1.p5.m8" class="ltx_Math" alttext="2" display="inline" intent=":literal"><semantics><mn>2</mn><annotation encoding="application/x-tex">2</annotation></semantics></math>.</span></p>
</div>
<div id="S4.SS1.p6" class="ltx_para">
<p id="S4.SS1.p6.1" class="ltx_p"><span id="S4.SS1.p6.1.1" class="ltx_text">We only prove the positional encoding case. For <math id="S4.SS1.p6.m1" class="ltx_Math" alttext="i\in[N]" display="inline" intent=":literal"><semantics><mrow><mi>i</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mi>N</mi><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">i\in[N]</annotation></semantics></math>, denote</span></p>
<table id="S4.EGx139" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="S4.Ex206"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S4.Ex206.m1" class="ltx_Math" alttext="\displaystyle\boldsymbol{\widetilde{X}}^{(i)}:=\boldsymbol{{X}}^{(i)}+\boldsymbol{E}." display="inline" intent=":literal"><semantics><mrow><mrow><msup><mover accent="true"><mi>𝑿</mi><mo>~</mo></mover><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></msup><mo>:=</mo><mrow><msup><mi>𝑿</mi><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></msup><mo>+</mo><mi>𝑬</mi></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\boldsymbol{\widetilde{X}}^{(i)}:=\boldsymbol{{X}}^{(i)}+\boldsymbol{E}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S4.SS1.p6.2" class="ltx_p"><span id="S4.SS1.p6.2.1" class="ltx_text">By using the triangle inequality, we derive that for <math id="S4.SS1.p6.m2" class="ltx_Math" alttext="i\in[N],k\in[n]" display="inline" intent=":literal"><semantics><mrow><mrow><mi>i</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mi>N</mi><mo stretchy="false">]</mo></mrow></mrow><mo>,</mo><mrow><mi>k</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mi>n</mi><mo stretchy="false">]</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">i\in[N],k\in[n]</annotation></semantics></math>,</span></p>
<table id="S4.EGx140" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="S4.Ex207"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S4.Ex207.m1" class="ltx_math_unparsed" alttext="\displaystyle(3k-1)r\leq\left\|\boldsymbol{E}_{:,k}\right\|_{2}-\left\|\boldsymbol{{X}}_{:,k}^{(i)}\right\|_{2}" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">(</mo><mn>3</mn><mi>k</mi><mo>−</mo><mn>1</mn><mo stretchy="false">)</mo></mrow><mi>r</mi><mo>≤</mo><msub><mrow><mo>‖</mo><msub><mi>𝑬</mi><mrow><mo rspace="0em">:</mo><mo>,</mo><mi>k</mi></mrow></msub><mo>‖</mo></mrow><mn>2</mn></msub><mo>−</mo><msub><mrow><mo>‖</mo><msubsup><mi>𝑿</mi><mrow><mo rspace="0em">:</mo><mo>,</mo><mi>k</mi></mrow><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></msubsup><mo>‖</mo></mrow><mn>2</mn></msub></mrow><annotation encoding="application/x-tex">\displaystyle(3k-1)r\leq\left\|\boldsymbol{E}_{:,k}\right\|_{2}-\left\|\boldsymbol{{X}}_{:,k}^{(i)}\right\|_{2}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S4.Ex207.m2" class="ltx_math_unparsed" alttext="\displaystyle\leq\left\|\boldsymbol{\widetilde{X}}_{:,k}^{(i)}\right\|_{2}=\left\|\boldsymbol{{X}}_{:,k}^{(i)}+\boldsymbol{E}_{:,k}\right\|_{2}" display="inline" intent=":literal"><semantics><mrow><mo>≤</mo><msub><mrow><mo>‖</mo><msubsup><mover accent="true"><mi>𝑿</mi><mo>~</mo></mover><mrow><mo rspace="0em">:</mo><mo>,</mo><mi>k</mi></mrow><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></msubsup><mo>‖</mo></mrow><mn>2</mn></msub><mo>=</mo><msub><mrow><mo>‖</mo><msubsup><mi>𝑿</mi><mrow><mo rspace="0em">:</mo><mo>,</mo><mi>k</mi></mrow><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></msubsup><mo>+</mo><msub><mi>𝑬</mi><mrow><mo rspace="0em">:</mo><mo>,</mo><mi>k</mi></mrow></msub><mo>‖</mo></mrow><mn>2</mn></msub></mrow><annotation encoding="application/x-tex">\displaystyle\leq\left\|\boldsymbol{\widetilde{X}}_{:,k}^{(i)}\right\|_{2}=\left\|\boldsymbol{{X}}_{:,k}^{(i)}+\boldsymbol{E}_{:,k}\right\|_{2}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="S4.E14"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S4.E14.m1" class="ltx_math_unparsed" alttext="\displaystyle\leq\left\|\boldsymbol{\widetilde{X}}_{:,k}^{(i)}\right\|_{2}+\left\|\boldsymbol{E}_{:,k}\right\|_{2}\leq(3k+1)r," display="inline" intent=":literal"><semantics><mrow><mo>≤</mo><msub><mrow><mo>‖</mo><msubsup><mover accent="true"><mi>𝑿</mi><mo>~</mo></mover><mrow><mo rspace="0em">:</mo><mo>,</mo><mi>k</mi></mrow><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></msubsup><mo>‖</mo></mrow><mn>2</mn></msub><mo>+</mo><msub><mrow><mo>‖</mo><msub><mi>𝑬</mi><mrow><mo rspace="0em">:</mo><mo>,</mo><mi>k</mi></mrow></msub><mo>‖</mo></mrow><mn>2</mn></msub><mo>≤</mo><mrow><mo stretchy="false">(</mo><mn>3</mn><mi>k</mi><mo>+</mo><mn>1</mn><mo stretchy="false">)</mo></mrow><mi>r</mi><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\leq\left\|\boldsymbol{\widetilde{X}}_{:,k}^{(i)}\right\|_{2}+\left\|\boldsymbol{E}_{:,k}\right\|_{2}\leq(3k+1)r,</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(14)</span></td></tr></tbody>
</table>
<p id="S4.SS1.p6.3" class="ltx_p"><span id="S4.SS1.p6.3.1" class="ltx_text">which implies that <math id="S4.SS1.p6.m3" class="ltx_math_unparsed" alttext="\boldsymbol{\widetilde{X}}_{:,k}^{(i)}" display="inline" intent=":literal"><semantics><mrow><mover accent="true"><mi>𝑿</mi><mo>~</mo></mover><msub><mrow></mrow><mrow><mo rspace="0em">:</mo><mo>,</mo><mi>k</mi></mrow></msub><msup><mrow></mrow><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></msup></mrow><annotation encoding="application/x-tex">\boldsymbol{\widetilde{X}}_{:,k}^{(i)}</annotation></semantics></math> and <math id="S4.SS1.p6.m4" class="ltx_math_unparsed" alttext="\boldsymbol{\widetilde{X}}_{:,l}^{(j)}" display="inline" intent=":literal"><semantics><mrow><mover accent="true"><mi>𝑿</mi><mo>~</mo></mover><msub><mrow></mrow><mrow><mo rspace="0em">:</mo><mo>,</mo><mi>l</mi></mrow></msub><msup><mrow></mrow><mrow><mo stretchy="false">(</mo><mi>j</mi><mo stretchy="false">)</mo></mrow></msup></mrow><annotation encoding="application/x-tex">\boldsymbol{\widetilde{X}}_{:,l}^{(j)}</annotation></semantics></math> with <math id="S4.SS1.p6.m5" class="ltx_Math" alttext="k\neq l" display="inline" intent=":literal"><semantics><mrow><mi>k</mi><mo>≠</mo><mi>l</mi></mrow><annotation encoding="application/x-tex">k\neq l</annotation></semantics></math> are impossible to be identical. Moreover, the triangle inequlity also yields</span></p>
<table id="S4.EGx141" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="S4.Ex208"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S4.Ex208.m1" class="ltx_math_unparsed" alttext="\displaystyle\left\|\boldsymbol{\widetilde{X}}_{:,k}^{(i)}-\boldsymbol{\widetilde{X}}_{:,l}^{(j)}\right\|_{2}" display="inline" intent=":literal"><semantics><msub><mrow><mo>‖</mo><msubsup><mover accent="true"><mi>𝑿</mi><mo>~</mo></mover><mrow><mo rspace="0em">:</mo><mo>,</mo><mi>k</mi></mrow><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></msubsup><mo>−</mo><msubsup><mover accent="true"><mi>𝑿</mi><mo>~</mo></mover><mrow><mo rspace="0em">:</mo><mo>,</mo><mi>l</mi></mrow><mrow><mo stretchy="false">(</mo><mi>j</mi><mo stretchy="false">)</mo></mrow></msubsup><mo>‖</mo></mrow><mn>2</mn></msub><annotation encoding="application/x-tex">\displaystyle\left\|\boldsymbol{\widetilde{X}}_{:,k}^{(i)}-\boldsymbol{\widetilde{X}}_{:,l}^{(j)}\right\|_{2}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S4.Ex208.m2" class="ltx_math_unparsed" alttext="\displaystyle=\left\|\left(\boldsymbol{{X}}_{:,k}^{(i)}-\boldsymbol{{X}}_{:,l}^{(j)}\right)+(k-l)p\boldsymbol{1}_{d\times 1}\right\|_{2}" display="inline" intent=":literal"><semantics><mrow><mo>=</mo><msub><mrow><mo>‖</mo><mrow><mo>(</mo><msubsup><mi>𝑿</mi><mrow><mo rspace="0em">:</mo><mo>,</mo><mi>k</mi></mrow><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></msubsup><mo>−</mo><msubsup><mi>𝑿</mi><mrow><mo rspace="0em">:</mo><mo>,</mo><mi>l</mi></mrow><mrow><mo stretchy="false">(</mo><mi>j</mi><mo stretchy="false">)</mo></mrow></msubsup><mo>)</mo></mrow><mo>+</mo><mrow><mo stretchy="false">(</mo><mi>k</mi><mo>−</mo><mi>l</mi><mo stretchy="false">)</mo></mrow><mi>p</mi><msub><mn>𝟏</mn><mrow><mi>d</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mn>1</mn></mrow></msub><mo>‖</mo></mrow><mn>2</mn></msub></mrow><annotation encoding="application/x-tex">\displaystyle=\left\|\left(\boldsymbol{{X}}_{:,k}^{(i)}-\boldsymbol{{X}}_{:,l}^{(j)}\right)+(k-l)p\boldsymbol{1}_{d\times 1}\right\|_{2}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="S4.E15"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S4.E15.m1" class="ltx_math_unparsed" alttext="\displaystyle\geq\left\{\begin{matrix}\left\|\left(\boldsymbol{{X}}_{:,k}^{(i)}-\boldsymbol{{X}}_{:,l}^{(j)}\right)\right\|_{2}-\left\|(k-l)p\boldsymbol{1}_{d\times 1}\right\|_{2}\geq\phi,\text{ when }k=l\\
\left\|(k-l)p\boldsymbol{1}_{d\times 1}\right\|_{2}-\left\|\left(\boldsymbol{{X}}_{:,k}^{(i)}-\boldsymbol{{X}}_{:,l}^{(j)}\right)\right\|_{2}\geq r,\text{ when }k\neq l\end{matrix}\right.\geq\phi." display="inline" intent=":literal"><semantics><mrow><mo>≥</mo><mrow><mo>{</mo><mtable rowspacing="0pt"><mtr><mtd><mrow><mo>‖</mo><mo>(</mo><mi>𝑿</mi><msub><mrow></mrow><mrow><mo rspace="0em">:</mo><mo>,</mo><mi>k</mi></mrow></msub><msup><mrow></mrow><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></msup><mo>−</mo><mi>𝑿</mi><msub><mrow></mrow><mrow><mo rspace="0em">:</mo><mo>,</mo><mi>l</mi></mrow></msub><msup><mrow></mrow><mrow><mo stretchy="false">(</mo><mi>j</mi><mo stretchy="false">)</mo></mrow></msup><mo>)</mo><mo>‖</mo><msub><mrow></mrow><mn>2</mn></msub><mo>−</mo><mo>‖</mo><mo stretchy="false">(</mo><mi>k</mi><mo>−</mo><mi>l</mi><mo stretchy="false">)</mo><mi>p</mi><mn>𝟏</mn><msub><mrow></mrow><mrow><mi>d</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mn>1</mn></mrow></msub><mo>‖</mo><msub><mrow></mrow><mn>2</mn></msub><mo>≥</mo><mi>ϕ</mi><mo>,</mo><mtext> when </mtext><mi>k</mi><mo>=</mo><mi>l</mi></mrow></mtd></mtr><mtr><mtd><mrow><mo>‖</mo><mo stretchy="false">(</mo><mi>k</mi><mo>−</mo><mi>l</mi><mo stretchy="false">)</mo><mi>p</mi><mn>𝟏</mn><msub><mrow></mrow><mrow><mi>d</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mn>1</mn></mrow></msub><mo>‖</mo><msub><mrow></mrow><mn>2</mn></msub><mo>−</mo><mo>‖</mo><mo>(</mo><mi>𝑿</mi><msub><mrow></mrow><mrow><mo rspace="0em">:</mo><mo>,</mo><mi>k</mi></mrow></msub><msup><mrow></mrow><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></msup><mo>−</mo><mi>𝑿</mi><msub><mrow></mrow><mrow><mo rspace="0em">:</mo><mo>,</mo><mi>l</mi></mrow></msub><msup><mrow></mrow><mrow><mo stretchy="false">(</mo><mi>j</mi><mo stretchy="false">)</mo></mrow></msup><mo>)</mo><mo>‖</mo><msub><mrow></mrow><mn>2</mn></msub><mo>≥</mo><mi>r</mi><mo>,</mo><mtext> when </mtext><mi>k</mi><mo>≠</mo><mi>l</mi></mrow></mtd></mtr></mtable><mo>≥</mo><mi>ϕ</mi><mo lspace="0em">.</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\geq\left\{\begin{matrix}\left\|\left(\boldsymbol{{X}}_{:,k}^{(i)}-\boldsymbol{{X}}_{:,l}^{(j)}\right)\right\|_{2}-\left\|(k-l)p\boldsymbol{1}_{d\times 1}\right\|_{2}\geq\phi,\text{ when }k=l\\
\left\|(k-l)p\boldsymbol{1}_{d\times 1}\right\|_{2}-\left\|\left(\boldsymbol{{X}}_{:,k}^{(i)}-\boldsymbol{{X}}_{:,l}^{(j)}\right)\right\|_{2}\geq r,\text{ when }k\neq l\end{matrix}\right.\geq\phi.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(15)</span></td></tr></tbody>
</table>
<p id="S4.SS1.p6.4" class="ltx_p"><span id="S4.SS1.p6.4.1" class="ltx_text">We conclude from (<a href="#S4.E14" title="In Proof of Lemma . ‣ 4.1 Proof of Lemma ‣ 4 Proof of Lemma : Memorization of Transformers ‣ Standard Transformers Achieve the Minimax Rate in Nonparametric Regression with 𝐶^{𝑠,𝜆} Targets" class="ltx_ref"><span class="ltx_text ltx_ref_tag">14</span></a>)(<a href="#S4.E15" title="In Proof of Lemma . ‣ 4.1 Proof of Lemma ‣ 4 Proof of Lemma : Memorization of Transformers ‣ Standard Transformers Achieve the Minimax Rate in Nonparametric Regression with 𝐶^{𝑠,𝜆} Targets" class="ltx_ref"><span class="ltx_text ltx_ref_tag">15</span></a>) that <math id="S4.SS1.p6.m6" class="ltx_Math" alttext="\left\{\boldsymbol{\widetilde{X}}^{(i)}\right\}_{i\in[N]}" display="inline" intent=":literal"><semantics><msub><mrow><mo>{</mo><msup><mover accent="true"><mi>𝑿</mi><mo>~</mo></mover><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></msup><mo>}</mo></mrow><mrow><mi>i</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mi>N</mi><mo stretchy="false">]</mo></mrow></mrow></msub><annotation encoding="application/x-tex">\left\{\boldsymbol{\widetilde{X}}^{(i)}\right\}_{i\in[N]}</annotation></semantics></math> are <math id="S4.SS1.p6.m7" class="ltx_Math" alttext="((3n+1)r,\phi)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mrow><mn>3</mn><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>r</mi></mrow><mo>,</mo><mi>ϕ</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">((3n+1)r,\phi)</annotation></semantics></math>-seperated. Applying Lemma <a href="#Thmlemma14" title="Lemma 14. ‣ 4.1 Proof of Lemma ‣ 4 Proof of Lemma : Memorization of Transformers ‣ Standard Transformers Achieve the Minimax Rate in Nonparametric Regression with 𝐶^{𝑠,𝜆} Targets" class="ltx_ref"><span class="ltx_text ltx_ref_tag">14</span></a> to <math id="S4.SS1.p6.m8" class="ltx_Math" alttext="\left\{\boldsymbol{\widetilde{X}}^{(i)}\right\}_{i\in[N]}" display="inline" intent=":literal"><semantics><msub><mrow><mo>{</mo><msup><mover accent="true"><mi>𝑿</mi><mo>~</mo></mover><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></msup><mo>}</mo></mrow><mrow><mi>i</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mi>N</mi><mo stretchy="false">]</mo></mrow></mrow></msub><annotation encoding="application/x-tex">\left\{\boldsymbol{\widetilde{X}}^{(i)}\right\}_{i\in[N]}</annotation></semantics></math>, we have</span></p>
<ul id="S4.I2" class="ltx_itemize">
<li id="S4.I2.i1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="S4.I2.i1.p1" class="ltx_para">
<p id="S4.I2.i1.p1.1" class="ltx_p">For any <math id="S4.I2.i1.p1.m1" class="ltx_Math" alttext="i\in[N]" display="inline" intent=":literal"><semantics><mrow><mi>i</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mi>N</mi><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">i\in[N]</annotation></semantics></math> and <math id="S4.I2.i1.p1.m2" class="ltx_Math" alttext="k\in[n]" display="inline" intent=":literal"><semantics><mrow><mi>k</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mi>n</mi><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">k\in[n]</annotation></semantics></math>, <math id="S4.I2.i1.p1.m3" class="ltx_Math" alttext="\left|\boldsymbol{T}^{(cm)}\left(\boldsymbol{\widetilde{X}}^{(i)}\right)_{1,k}\right|\leq R" display="inline" intent=":literal"><semantics><mrow><mrow><mo>|</mo><mrow><msup><mi>𝑻</mi><mrow><mo stretchy="false">(</mo><mrow><mi>c</mi><mo lspace="0em" rspace="0em">​</mo><mi>m</mi></mrow><mo stretchy="false">)</mo></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo>(</mo><msup><mover accent="true"><mi>𝑿</mi><mo>~</mo></mover><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></msup><mo>)</mo></mrow><mrow><mn>1</mn><mo>,</mo><mi>k</mi></mrow></msub></mrow><mo>|</mo></mrow><mo>≤</mo><mi>R</mi></mrow><annotation encoding="application/x-tex">\left|\boldsymbol{T}^{(cm)}\left(\boldsymbol{\widetilde{X}}^{(i)}\right)_{1,k}\right|\leq R</annotation></semantics></math>.</p>
</div></li>
<li id="S4.I2.i2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="S4.I2.i2.p1" class="ltx_para">
<p id="S4.I2.i2.p1.1" class="ltx_p">For any <math id="S4.I2.i2.p1.m1" class="ltx_Math" alttext="i,j\in[N]" display="inline" intent=":literal"><semantics><mrow><mrow><mi>i</mi><mo>,</mo><mi>j</mi></mrow><mo>∈</mo><mrow><mo stretchy="false">[</mo><mi>N</mi><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">i,j\in[N]</annotation></semantics></math> and <math id="S4.I2.i2.p1.m2" class="ltx_Math" alttext="k,l\in[n]" display="inline" intent=":literal"><semantics><mrow><mrow><mi>k</mi><mo>,</mo><mi>l</mi></mrow><mo>∈</mo><mrow><mo stretchy="false">[</mo><mi>n</mi><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">k,l\in[n]</annotation></semantics></math> with <math id="S4.I2.i2.p1.m3" class="ltx_Math" alttext="i\neq j" display="inline" intent=":literal"><semantics><mrow><mi>i</mi><mo>≠</mo><mi>j</mi></mrow><annotation encoding="application/x-tex">i\neq j</annotation></semantics></math> or <math id="S4.I2.i2.p1.m4" class="ltx_Math" alttext="k\neq l" display="inline" intent=":literal"><semantics><mrow><mi>k</mi><mo>≠</mo><mi>l</mi></mrow><annotation encoding="application/x-tex">k\neq l</annotation></semantics></math>,</p>
<table id="S4.EGx142" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="S4.Ex209"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S4.Ex209.m1" class="ltx_Math" alttext="\displaystyle\left|\boldsymbol{T}^{(cm)}\left(\boldsymbol{\widetilde{X}}^{(i)}\right)_{1,k}-\boldsymbol{T}^{(cm)}\left(\boldsymbol{\widetilde{X}}^{(j)}\right)_{1,l}\right|\geq 2." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mo>|</mo><mrow><mrow><msup><mi>𝑻</mi><mrow><mo stretchy="false">(</mo><mrow><mi>c</mi><mo lspace="0em" rspace="0em">​</mo><mi>m</mi></mrow><mo stretchy="false">)</mo></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo>(</mo><msup><mover accent="true"><mi>𝑿</mi><mo>~</mo></mover><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></msup><mo>)</mo></mrow><mrow><mn>1</mn><mo>,</mo><mi>k</mi></mrow></msub></mrow><mo>−</mo><mrow><msup><mi>𝑻</mi><mrow><mo stretchy="false">(</mo><mrow><mi>c</mi><mo lspace="0em" rspace="0em">​</mo><mi>m</mi></mrow><mo stretchy="false">)</mo></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo>(</mo><msup><mover accent="true"><mi>𝑿</mi><mo>~</mo></mover><mrow><mo stretchy="false">(</mo><mi>j</mi><mo stretchy="false">)</mo></mrow></msup><mo>)</mo></mrow><mrow><mn>1</mn><mo>,</mo><mi>l</mi></mrow></msub></mrow></mrow><mo>|</mo></mrow><mo>≥</mo><mn>2</mn></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\left|\boldsymbol{T}^{(cm)}\left(\boldsymbol{\widetilde{X}}^{(i)}\right)_{1,k}-\boldsymbol{T}^{(cm)}\left(\boldsymbol{\widetilde{X}}^{(j)}\right)_{1,l}\right|\geq 2.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div></li>
</ul>
<p id="S4.SS1.p6.5" class="ltx_p"><span id="S4.SS1.p6.5.1" class="ltx_text">Applying Lemma <a href="#Thmlemma15" title="Lemma 15. ‣ 4.1 Proof of Lemma ‣ 4 Proof of Lemma : Memorization of Transformers ‣ Standard Transformers Achieve the Minimax Rate in Nonparametric Regression with 𝐶^{𝑠,𝜆} Targets" class="ltx_ref"><span class="ltx_text ltx_ref_tag">15</span></a> to <math id="S4.SS1.p6.m9" class="ltx_Math" alttext="\left\{\left(\boldsymbol{T}^{(cm)}\left(\boldsymbol{\widetilde{X}}^{(i)}\right)_{1,k},y_{1,k}^{(i)}\right)\right\}_{i\in[N],k\in[n]}" display="inline" intent=":literal"><semantics><msub><mrow><mo>{</mo><mrow><mo>(</mo><mrow><msup><mi>𝑻</mi><mrow><mo stretchy="false">(</mo><mrow><mi>c</mi><mo lspace="0em" rspace="0em">​</mo><mi>m</mi></mrow><mo stretchy="false">)</mo></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo>(</mo><msup><mover accent="true"><mi>𝑿</mi><mo>~</mo></mover><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></msup><mo>)</mo></mrow><mrow><mn>1</mn><mo>,</mo><mi>k</mi></mrow></msub></mrow><mo>,</mo><msubsup><mi>y</mi><mrow><mn>1</mn><mo>,</mo><mi>k</mi></mrow><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></msubsup><mo>)</mo></mrow><mo>}</mo></mrow><mrow><mrow><mi>i</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mi>N</mi><mo stretchy="false">]</mo></mrow></mrow><mo>,</mo><mrow><mi>k</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mi>n</mi><mo stretchy="false">]</mo></mrow></mrow></mrow></msub><annotation encoding="application/x-tex">\left\{\left(\boldsymbol{T}^{(cm)}\left(\boldsymbol{\widetilde{X}}^{(i)}\right)_{1,k},y_{1,k}^{(i)}\right)\right\}_{i\in[N],k\in[n]}</annotation></semantics></math>, we obtain</span></p>
<table id="S4.EGx143" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="S4.Ex210"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S4.Ex210.m1" class="ltx_Math" alttext="\displaystyle\boldsymbol{\mathcal{F}}_{FF}^{(mmr)}\left(\boldsymbol{T}^{(cm)}\left(\boldsymbol{\widetilde{X}}^{(i)}\right)_{1,k}\right)=y_{1,k}^{(i)},\quad i\in[N],k\in[n]." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mrow><msubsup><mi class="ltx_font_mathcaligraphic">𝓕</mi><mrow><mi>F</mi><mo lspace="0em" rspace="0em">​</mo><mi>F</mi></mrow><mrow><mo stretchy="false">(</mo><mrow><mi>m</mi><mo lspace="0em" rspace="0em">​</mo><mi>m</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi></mrow><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><msup><mi>𝑻</mi><mrow><mo stretchy="false">(</mo><mrow><mi>c</mi><mo lspace="0em" rspace="0em">​</mo><mi>m</mi></mrow><mo stretchy="false">)</mo></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo>(</mo><msup><mover accent="true"><mi>𝑿</mi><mo>~</mo></mover><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></msup><mo>)</mo></mrow><mrow><mn>1</mn><mo>,</mo><mi>k</mi></mrow></msub></mrow><mo>)</mo></mrow></mrow><mo>=</mo><msubsup><mi>y</mi><mrow><mn>1</mn><mo>,</mo><mi>k</mi></mrow><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></msubsup></mrow><mo rspace="1.167em">,</mo><mrow><mi>i</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mi>N</mi><mo stretchy="false">]</mo></mrow></mrow><mo>,</mo><mrow><mi>k</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mi>n</mi><mo stretchy="false">]</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\boldsymbol{\mathcal{F}}_{FF}^{(mmr)}\left(\boldsymbol{T}^{(cm)}\left(\boldsymbol{\widetilde{X}}^{(i)}\right)_{1,k}\right)=y_{1,k}^{(i)},\quad i\in[N],k\in[n].</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S4.SS1.p6.6" class="ltx_p"><span id="S4.SS1.p6.6.1" class="ltx_text">The weight bound of <math id="S4.SS1.p6.m10" class="ltx_Math" alttext="\boldsymbol{\mathcal{F}}_{FF}^{(mmr)}" display="inline" intent=":literal"><semantics><msubsup><mi class="ltx_font_mathcaligraphic">𝓕</mi><mrow><mi>F</mi><mo lspace="0em" rspace="0em">​</mo><mi>F</mi></mrow><mrow><mo stretchy="false">(</mo><mrow><mi>m</mi><mo lspace="0em" rspace="0em">​</mo><mi>m</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi></mrow><mo stretchy="false">)</mo></mrow></msubsup><annotation encoding="application/x-tex">\boldsymbol{\mathcal{F}}_{FF}^{(mmr)}</annotation></semantics></math> is <math id="S4.SS1.p6.m11" class="ltx_Math" alttext="\max\{R,2B_{y}\}" display="inline" intent=":literal"><semantics><mrow><mi>max</mi><mo>⁡</mo><mrow><mo stretchy="false">{</mo><mrow><mi>R</mi><mo>,</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>B</mi><mi>y</mi></msub></mrow></mrow><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">\max\{R,2B_{y}\}</annotation></semantics></math>. The weight bounds of <math id="S4.SS1.p6.m12" class="ltx_Math" alttext="\boldsymbol{T}^{(cm)}" display="inline" intent=":literal"><semantics><msup><mi>𝑻</mi><mrow><mo stretchy="false">(</mo><mrow><mi>c</mi><mo lspace="0em" rspace="0em">​</mo><mi>m</mi></mrow><mo stretchy="false">)</mo></mrow></msup><annotation encoding="application/x-tex">\boldsymbol{T}^{(cm)}</annotation></semantics></math> are <math id="S4.SS1.p6.m13" class="ltx_Math" alttext="B_{FF}=\max\left\{\sqrt{2}n^{2}(3n+1)N^{2}\sqrt{\pi d}r\phi^{-1}+1,\frac{3\sqrt{2}}{8}N^{2}\sqrt{\pi n}\right\},B_{SA}=\frac{1}{2}\log(3\sqrt{d}{\pi}n^{4}(3n+1)N^{4}r\phi^{-1})" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>B</mi><mrow><mi>F</mi><mo lspace="0em" rspace="0em">​</mo><mi>F</mi></mrow></msub><mo>=</mo><mrow><mi>max</mi><mo>⁡</mo><mrow><mo>{</mo><mrow><mrow><mrow><msqrt><mn>2</mn></msqrt><mo lspace="0em" rspace="0em">​</mo><msup><mi>n</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mn>3</mn><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mi>N</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msqrt><mrow><mi>π</mi><mo lspace="0em" rspace="0em">​</mo><mi>d</mi></mrow></msqrt><mo lspace="0em" rspace="0em">​</mo><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>ϕ</mi><mrow><mo>−</mo><mn>1</mn></mrow></msup></mrow><mo>+</mo><mn>1</mn></mrow><mo>,</mo><mrow><mfrac><mrow><mn>3</mn><mo lspace="0em" rspace="0em">​</mo><msqrt><mn>2</mn></msqrt></mrow><mn>8</mn></mfrac><mo lspace="0em" rspace="0em">​</mo><msup><mi>N</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msqrt><mrow><mi>π</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow></msqrt></mrow></mrow><mo>}</mo></mrow></mrow></mrow><mo>,</mo><mrow><msub><mi>B</mi><mrow><mi>S</mi><mo lspace="0em" rspace="0em">​</mo><mi>A</mi></mrow></msub><mo>=</mo><mrow><mfrac><mn>1</mn><mn>2</mn></mfrac><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>log</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mn>3</mn><mo lspace="0em" rspace="0em">​</mo><msqrt><mi>d</mi></msqrt><mo lspace="0em" rspace="0em">​</mo><mi>π</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>n</mi><mn>4</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mn>3</mn><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mi>N</mi><mn>4</mn></msup><mo lspace="0em" rspace="0em">​</mo><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>ϕ</mi><mrow><mo>−</mo><mn>1</mn></mrow></msup></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">B_{FF}=\max\left\{\sqrt{2}n^{2}(3n+1)N^{2}\sqrt{\pi d}r\phi^{-1}+1,\frac{3\sqrt{2}}{8}N^{2}\sqrt{\pi n}\right\},B_{SA}=\frac{1}{2}\log(3\sqrt{d}{\pi}n^{4}(3n+1)N^{4}r\phi^{-1})</annotation></semantics></math>. The weight bounds of <math id="S4.SS1.p6.m14" class="ltx_Math" alttext="\boldsymbol{T}^{(mmr)}" display="inline" intent=":literal"><semantics><msup><mi>𝑻</mi><mrow><mo stretchy="false">(</mo><mrow><mi>m</mi><mo lspace="0em" rspace="0em">​</mo><mi>m</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi></mrow><mo stretchy="false">)</mo></mrow></msup><annotation encoding="application/x-tex">\boldsymbol{T}^{(mmr)}</annotation></semantics></math> can be obtained by making a comparison between them.</span></p>
</div>
<div id="S4.SS1.p7" class="ltx_para">
<p id="S4.SS1.p7.1" class="ltx_p"><span id="S4.SS1.p7.1.1" class="ltx_text">∎</span></p>
</div>
</div>
</section>
<section id="S4.SS2" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">4.2 </span>Proof of Lemma <a href="#Thmlemma14" title="Lemma 14. ‣ 4.1 Proof of Lemma ‣ 4 Proof of Lemma : Memorization of Transformers ‣ Standard Transformers Achieve the Minimax Rate in Nonparametric Regression with 𝐶^{𝑠,𝜆} Targets" class="ltx_ref"><span class="ltx_text ltx_ref_tag">14</span></a>: Realizing Contextual Mapping by Transformers</h3>

<div id="S4.SS2.p1" class="ltx_para">
<p id="S4.SS2.p1.1" class="ltx_p">Our proof of Lemma <a href="#Thmlemma14" title="Lemma 14. ‣ 4.1 Proof of Lemma ‣ 4 Proof of Lemma : Memorization of Transformers ‣ Standard Transformers Achieve the Minimax Rate in Nonparametric Regression with 𝐶^{𝑠,𝜆} Targets" class="ltx_ref"><span class="ltx_text ltx_ref_tag">14</span></a> adapts the construction from <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib25" title="" class="ltx_ref">25</a>]</cite>. Specifically, we first construct a feedforward block that maps the input sequence <math id="S4.SS2.p1.m1" class="ltx_Math" alttext="\boldsymbol{X}^{(i)}" display="inline" intent=":literal"><semantics><msup><mi>𝑿</mi><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></msup><annotation encoding="application/x-tex">\boldsymbol{X}^{(i)}</annotation></semantics></math> to the token id <math id="S4.SS2.p1.m2" class="ltx_Math" alttext="\boldsymbol{x}^{(i)}" display="inline" intent=":literal"><semantics><msup><mi>𝒙</mi><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></msup><annotation encoding="application/x-tex">\boldsymbol{x}^{(i)}</annotation></semantics></math> (Lemma <a href="#Thmlemma19" title="Lemma 19. ‣ 4.2 Proof of Lemma : Realizing Contextual Mapping by Transformers ‣ 4 Proof of Lemma : Memorization of Transformers ‣ Standard Transformers Achieve the Minimax Rate in Nonparametric Regression with 𝐶^{𝑠,𝜆} Targets" class="ltx_ref"><span class="ltx_text ltx_ref_tag">19</span></a>), followed by a Transformer that computes the sequence id <math id="S4.SS2.p1.m3" class="ltx_Math" alttext="z^{(i)}" display="inline" intent=":literal"><semantics><msup><mi>z</mi><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></msup><annotation encoding="application/x-tex">z^{(i)}</annotation></semantics></math> (Lemma <a href="#Thmlemma20" title="Lemma 20. ‣ 4.2 Proof of Lemma : Realizing Contextual Mapping by Transformers ‣ 4 Proof of Lemma : Memorization of Transformers ‣ Standard Transformers Achieve the Minimax Rate in Nonparametric Regression with 𝐶^{𝑠,𝜆} Targets" class="ltx_ref"><span class="ltx_text ltx_ref_tag">20</span></a>). The Transformer in Lemma <a href="#Thmlemma14" title="Lemma 14. ‣ 4.1 Proof of Lemma ‣ 4 Proof of Lemma : Memorization of Transformers ‣ Standard Transformers Achieve the Minimax Rate in Nonparametric Regression with 𝐶^{𝑠,𝜆} Targets" class="ltx_ref"><span class="ltx_text ltx_ref_tag">14</span></a> is then obtained via a linear combination of the token id and the sequence id. The proofs of Lemmas <a href="#Thmlemma19" title="Lemma 19. ‣ 4.2 Proof of Lemma : Realizing Contextual Mapping by Transformers ‣ 4 Proof of Lemma : Memorization of Transformers ‣ Standard Transformers Achieve the Minimax Rate in Nonparametric Regression with 𝐶^{𝑠,𝜆} Targets" class="ltx_ref"><span class="ltx_text ltx_ref_tag">19</span></a> and <a href="#Thmlemma20" title="Lemma 20. ‣ 4.2 Proof of Lemma : Realizing Contextual Mapping by Transformers ‣ 4 Proof of Lemma : Memorization of Transformers ‣ Standard Transformers Achieve the Minimax Rate in Nonparametric Regression with 𝐶^{𝑠,𝜆} Targets" class="ltx_ref"><span class="ltx_text ltx_ref_tag">20</span></a> depend on the following three technical lemmas (Lemmas <a href="#Thmlemma16" title="Lemma 16 ([], Lemma 13). ‣ 4.2 Proof of Lemma : Realizing Contextual Mapping by Transformers ‣ 4 Proof of Lemma : Memorization of Transformers ‣ Standard Transformers Achieve the Minimax Rate in Nonparametric Regression with 𝐶^{𝑠,𝜆} Targets" class="ltx_ref"><span class="ltx_text ltx_ref_tag">16</span></a>–<a href="#Thmlemma18" title="Lemma 18. ‣ 4.2 Proof of Lemma : Realizing Contextual Mapping by Transformers ‣ 4 Proof of Lemma : Memorization of Transformers ‣ Standard Transformers Achieve the Minimax Rate in Nonparametric Regression with 𝐶^{𝑠,𝜆} Targets" class="ltx_ref"><span class="ltx_text ltx_ref_tag">18</span></a>).</p>
</div>
<div id="Thmlemma16" class="ltx_theorem ltx_theorem_lemma">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="Thmlemma16.2" class="ltx_text ltx_font_bold">Lemma 16</span></span><span id="Thmlemma16.3" class="ltx_text ltx_font_bold"> </span>(<cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib36" title="" class="ltx_ref">36</a>]</cite>, Lemma 13)<span id="Thmlemma16.4" class="ltx_text ltx_font_bold">.</span></h6>
<div id="Thmlemma16.p1" class="ltx_para">
<p id="Thmlemma16.p1.1" class="ltx_p"><span id="Thmlemma16.p1.1.1" class="ltx_text ltx_font_italic">Let <math id="Thmlemma16.p1.m1" class="ltx_Math" alttext="d,N\in\mathbb{N}_{\geq 1}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>d</mi><mo>,</mo><mi>N</mi></mrow><mo>∈</mo><msub><mi>ℕ</mi><mrow><mphantom></mphantom><mo>≥</mo><mn>1</mn></mrow></msub></mrow><annotation encoding="application/x-tex">d,N\in\mathbb{N}_{\geq 1}</annotation></semantics></math>. Let <math id="Thmlemma16.p1.m2" class="ltx_Math" alttext="\left\{\boldsymbol{x}^{(i)}\right\}_{i\in[N]}\subset\mathbb{R}^{d}" display="inline" intent=":literal"><semantics><mrow><msub><mrow><mo>{</mo><msup><mi>𝐱</mi><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></msup><mo>}</mo></mrow><mrow><mi>i</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mi>N</mi><mo stretchy="false">]</mo></mrow></mrow></msub><mo>⊂</mo><msup><mi>ℝ</mi><mi>d</mi></msup></mrow><annotation encoding="application/x-tex">\left\{\boldsymbol{x}^{(i)}\right\}_{i\in[N]}\subset\mathbb{R}^{d}</annotation></semantics></math>. There exists a unit vector <math id="Thmlemma16.p1.m3" class="ltx_Math" alttext="\boldsymbol{u}\in\mathbb{R}^{d}" display="inline" intent=":literal"><semantics><mrow><mi>𝐮</mi><mo>∈</mo><msup><mi>ℝ</mi><mi>d</mi></msup></mrow><annotation encoding="application/x-tex">\boldsymbol{u}\in\mathbb{R}^{d}</annotation></semantics></math> such that for any <math id="Thmlemma16.p1.m4" class="ltx_Math" alttext="i,j\in[N]" display="inline" intent=":literal"><semantics><mrow><mrow><mi>i</mi><mo>,</mo><mi>j</mi></mrow><mo>∈</mo><mrow><mo stretchy="false">[</mo><mi>N</mi><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">i,j\in[N]</annotation></semantics></math>,</span></p>
<table id="S4.Ex211" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S4.Ex211.m1" class="ltx_Math" alttext="\frac{1}{N^{2}}\sqrt{\frac{8}{\pi d}}\left\|\boldsymbol{x}^{(i)}-\boldsymbol{x}^{(j)}\right\|_{2}\leq\left|\boldsymbol{u}^{\top}\left(\boldsymbol{x}^{(i)}-\boldsymbol{x}^{(j)}\right)\right|\leq\left\|\boldsymbol{x}^{(i)}-\boldsymbol{x}^{(j)}\right\|_{2}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mfrac><mn>1</mn><msup><mi>N</mi><mn>2</mn></msup></mfrac><mo lspace="0em" rspace="0em">​</mo><msqrt><mfrac><mn>8</mn><mrow><mi>π</mi><mo lspace="0em" rspace="0em">​</mo><mi>d</mi></mrow></mfrac></msqrt><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo>‖</mo><mrow><msup><mi>𝒙</mi><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></msup><mo>−</mo><msup><mi>𝒙</mi><mrow><mo stretchy="false">(</mo><mi>j</mi><mo stretchy="false">)</mo></mrow></msup></mrow><mo>‖</mo></mrow><mn>2</mn></msub></mrow><mo>≤</mo><mrow><mo>|</mo><mrow><msup><mi>𝒖</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><msup><mi>𝒙</mi><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></msup><mo>−</mo><msup><mi>𝒙</mi><mrow><mo stretchy="false">(</mo><mi>j</mi><mo stretchy="false">)</mo></mrow></msup></mrow><mo>)</mo></mrow></mrow><mo>|</mo></mrow><mo>≤</mo><msub><mrow><mo>‖</mo><mrow><msup><mi>𝒙</mi><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></msup><mo>−</mo><msup><mi>𝒙</mi><mrow><mo stretchy="false">(</mo><mi>j</mi><mo stretchy="false">)</mo></mrow></msup></mrow><mo>‖</mo></mrow><mn>2</mn></msub></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\frac{1}{N^{2}}\sqrt{\frac{8}{\pi d}}\left\|\boldsymbol{x}^{(i)}-\boldsymbol{x}^{(j)}\right\|_{2}\leq\left|\boldsymbol{u}^{\top}\left(\boldsymbol{x}^{(i)}-\boldsymbol{x}^{(j)}\right)\right|\leq\left\|\boldsymbol{x}^{(i)}-\boldsymbol{x}^{(j)}\right\|_{2}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
</div>
<div id="Thmlemma17" class="ltx_theorem ltx_theorem_lemma">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="Thmlemma17.2" class="ltx_text ltx_font_bold">Lemma 17</span></span><span id="Thmlemma17.3" class="ltx_text ltx_font_bold"> </span>(<cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib25" title="" class="ltx_ref">25</a>]</cite>, Lemma E.3)<span id="Thmlemma17.4" class="ltx_text ltx_font_bold">.</span></h6>
<div id="Thmlemma17.p1" class="ltx_para">
<p id="Thmlemma17.p1.1" class="ltx_p"><span id="Thmlemma17.p1.1.1" class="ltx_text ltx_font_italic">Let <math id="Thmlemma17.p1.m1" class="ltx_Math" alttext="r^{\prime}\in\mathbb{R}" display="inline" intent=":literal"><semantics><mrow><msup><mi>r</mi><mo>′</mo></msup><mo>∈</mo><mi>ℝ</mi></mrow><annotation encoding="application/x-tex">r^{\prime}\in\mathbb{R}</annotation></semantics></math>. There exists a ReLU FNN <math id="Thmlemma17.p1.m2" class="ltx_Math" alttext="f_{FF}^{(elm)}:\mathbb{R}^{2}\to\mathbb{R}" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>f</mi><mrow><mi>F</mi><mo lspace="0em" rspace="0em">​</mo><mi>F</mi></mrow><mrow><mo stretchy="false">(</mo><mrow><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mi>l</mi><mo lspace="0em" rspace="0em">​</mo><mi>m</mi></mrow><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><msup><mi>ℝ</mi><mn>2</mn></msup><mo stretchy="false">→</mo><mi>ℝ</mi></mrow></mrow><annotation encoding="application/x-tex">f_{FF}^{(elm)}:\mathbb{R}^{2}\to\mathbb{R}</annotation></semantics></math> with depth <math id="Thmlemma17.p1.m3" class="ltx_Math" alttext="2" display="inline" intent=":literal"><semantics><mn>2</mn><annotation encoding="application/x-tex">2</annotation></semantics></math>, width <math id="Thmlemma17.p1.m4" class="ltx_Math" alttext="4" display="inline" intent=":literal"><semantics><mn>4</mn><annotation encoding="application/x-tex">4</annotation></semantics></math> and weight bound <math id="Thmlemma17.p1.m5" class="ltx_Math" alttext="\max\{r^{\prime},2\}" display="inline" intent=":literal"><semantics><mrow><mi>max</mi><mo>⁡</mo><mrow><mo stretchy="false">{</mo><mrow><msup><mi>r</mi><mo>′</mo></msup><mo>,</mo><mn>2</mn></mrow><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">\max\{r^{\prime},2\}</annotation></semantics></math> such that for any <math id="Thmlemma17.p1.m6" class="ltx_Math" alttext="\boldsymbol{x}\in\mathbb{R}^{2}" display="inline" intent=":literal"><semantics><mrow><mi>𝐱</mi><mo>∈</mo><msup><mi>ℝ</mi><mn>2</mn></msup></mrow><annotation encoding="application/x-tex">\boldsymbol{x}\in\mathbb{R}^{2}</annotation></semantics></math>,</span></p>
<table id="S4.Ex212" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S4.Ex212.m1" class="ltx_Math" alttext="f_{FF}^{(elm)}(\boldsymbol{x})=\begin{cases}r^{\prime},&amp;\text{if }|x_{1}-x_{2}|&lt;\frac{1}{2};\\
0,&amp;\text{if }|x_{1}-x_{2}|&gt;1.\end{cases}" display="block" intent=":literal"><semantics><mrow><mrow><msubsup><mi>f</mi><mrow><mi>F</mi><mo lspace="0em" rspace="0em">​</mo><mi>F</mi></mrow><mrow><mo stretchy="false">(</mo><mrow><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mi>l</mi><mo lspace="0em" rspace="0em">​</mo><mi>m</mi></mrow><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝒙</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mo>{</mo><mtable columnspacing="5pt" displaystyle="true" rowspacing="0pt"><mtr><mtd class="ltx_align_left" columnalign="left"><mrow><msup><mi>r</mi><mo>′</mo></msup><mo>,</mo></mrow></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><mrow><mtext class="ltx_mathvariant_italic">if </mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">|</mo><mrow><msub><mi>x</mi><mn>1</mn></msub><mo>−</mo><msub><mi>x</mi><mn>2</mn></msub></mrow><mo stretchy="false">|</mo></mrow></mrow><mo>&lt;</mo><mstyle displaystyle="false"><mfrac><mn>1</mn><mn>2</mn></mfrac></mstyle></mrow><mo>;</mo></mrow></mtd></mtr><mtr><mtd class="ltx_align_left" columnalign="left"><mrow><mn>0</mn><mo>,</mo></mrow></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><mrow><mtext class="ltx_mathvariant_italic">if </mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">|</mo><mrow><msub><mi>x</mi><mn>1</mn></msub><mo>−</mo><msub><mi>x</mi><mn>2</mn></msub></mrow><mo stretchy="false">|</mo></mrow></mrow><mo>&gt;</mo><mn>1</mn></mrow><mo lspace="0em">.</mo></mrow></mtd></mtr></mtable></mrow></mrow><annotation encoding="application/x-tex">f_{FF}^{(elm)}(\boldsymbol{x})=\begin{cases}r^{\prime},&amp;\text{if }|x_{1}-x_{2}|&lt;\frac{1}{2};\\
0,&amp;\text{if }|x_{1}-x_{2}|&gt;1.\end{cases}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
</div>
<div id="S4.SS2.p2" class="ltx_para">
<p id="S4.SS2.p2.1" class="ltx_p">The following lemma shows that the self-attention layer can approximate the maximum over the input sequence. This is an adaptation of <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib25" title="" class="ltx_ref">25</a>, Lemma E.2]</cite>, where the self-attention layer is defined without skip connections and the softmax includes a bias term.</p>
</div>
<div id="Thmlemma18" class="ltx_theorem ltx_theorem_lemma">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="Thmlemma18.2" class="ltx_text ltx_font_bold">Lemma 18</span></span><span id="Thmlemma18.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="Thmlemma18.p1" class="ltx_para">
<p id="Thmlemma18.p1.1" class="ltx_p"><span id="Thmlemma18.p1.1.1" class="ltx_text ltx_font_italic">Let <math id="Thmlemma18.p1.m1" class="ltx_Math" alttext="n\in\mathbb{N}_{\geq 1}" display="inline" intent=":literal"><semantics><mrow><mi>n</mi><mo>∈</mo><msub><mi>ℕ</mi><mrow><mphantom></mphantom><mo>≥</mo><mn>1</mn></mrow></msub></mrow><annotation encoding="application/x-tex">n\in\mathbb{N}_{\geq 1}</annotation></semantics></math> and <math id="Thmlemma18.p1.m2" class="ltx_Math" alttext="r^{\prime},P\in\mathbb{R}_{&gt;1}" display="inline" intent=":literal"><semantics><mrow><msup><mi>r</mi><mo>′</mo></msup><mo>,</mo><mrow><mi>P</mi><mo>∈</mo><msub><mi>ℝ</mi><mrow><mphantom></mphantom><mo>&gt;</mo><mn>1</mn></mrow></msub></mrow></mrow><annotation encoding="application/x-tex">r^{\prime},P\in\mathbb{R}_{&gt;1}</annotation></semantics></math>. There exists a self-attention layer <math id="Thmlemma18.p1.m3" class="ltx_Math" alttext="\boldsymbol{\mathcal{F}}_{SA}^{(max)}:\mathbb{R}^{3\times n}\to\mathbb{R}^{3\times n}" display="inline" intent=":literal"><semantics><mrow><msubsup><mi class="ltx_font_mathcaligraphic">𝓕</mi><mrow><mi>S</mi><mo lspace="0em" rspace="0em">​</mo><mi>A</mi></mrow><mrow><mo stretchy="false">(</mo><mrow><mi>m</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi><mo lspace="0em" rspace="0em">​</mo><mi>x</mi></mrow><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><msup><mi>ℝ</mi><mrow><mn>3</mn><mo lspace="0.222em" rspace="0.222em">×</mo><mi>n</mi></mrow></msup><mo stretchy="false">→</mo><msup><mi>ℝ</mi><mrow><mn>3</mn><mo lspace="0.222em" rspace="0.222em">×</mo><mi>n</mi></mrow></msup></mrow></mrow><annotation encoding="application/x-tex">\boldsymbol{\mathcal{F}}_{SA}^{(max)}:\mathbb{R}^{3\times n}\to\mathbb{R}^{3\times n}</annotation></semantics></math> with head number <math id="Thmlemma18.p1.m4" class="ltx_Math" alttext="1" display="inline" intent=":literal"><semantics><mn>1</mn><annotation encoding="application/x-tex">1</annotation></semantics></math>, head size <math id="Thmlemma18.p1.m5" class="ltx_Math" alttext="3" display="inline" intent=":literal"><semantics><mn>3</mn><annotation encoding="application/x-tex">3</annotation></semantics></math> and weight bound <math id="Thmlemma18.p1.m6" class="ltx_Math" alttext="\frac{1}{2}\log(8n^{3/2}r^{\prime}P)" display="inline" intent=":literal"><semantics><mrow><mfrac><mn>1</mn><mn>2</mn></mfrac><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>log</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mn>8</mn><mo lspace="0em" rspace="0em">​</mo><msup><mi>n</mi><mrow><mn>3</mn><mo>/</mo><mn>2</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>r</mi><mo>′</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>P</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\frac{1}{2}\log(8n^{3/2}r^{\prime}P)</annotation></semantics></math> such that for any <math id="Thmlemma18.p1.m7" class="ltx_Math" alttext="\boldsymbol{x}=\begin{pmatrix}x_{1}&amp;x_{2}&amp;\cdots&amp;x_{n}\end{pmatrix}\in\mathbb{R}^{1\times n}" display="inline" intent=":literal"><semantics><mrow><mi>𝐱</mi><mo>=</mo><mrow><mo>(</mo><mtable columnspacing="5pt"><mtr><mtd><msub><mi>x</mi><mn>1</mn></msub></mtd><mtd><msub><mi>x</mi><mn>2</mn></msub></mtd><mtd><mo>⋯</mo></mtd><mtd><msub><mi>x</mi><mi>n</mi></msub></mtd></mtr></mtable><mo>)</mo></mrow><mo>∈</mo><msup><mi>ℝ</mi><mrow><mn>1</mn><mo lspace="0.222em" rspace="0.222em">×</mo><mi>n</mi></mrow></msup></mrow><annotation encoding="application/x-tex">\boldsymbol{x}=\begin{pmatrix}x_{1}&amp;x_{2}&amp;\cdots&amp;x_{n}\end{pmatrix}\in\mathbb{R}^{1\times n}</annotation></semantics></math> satisfying</span></p>
<ul id="S4.I3" class="ltx_itemize">
<li id="S4.I3.i1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="S4.I3.i1.p1" class="ltx_para">
<p id="S4.I3.i1.p1.1" class="ltx_p"><math id="S4.I3.i1.p1.m1" class="ltx_Math" alttext="|x_{i}|\leq 2r^{\prime}" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">|</mo><msub><mi>x</mi><mi>i</mi></msub><mo stretchy="false">|</mo></mrow><mo>≤</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msup><mi>r</mi><mo>′</mo></msup></mrow></mrow><annotation encoding="application/x-tex">|x_{i}|\leq 2r^{\prime}</annotation></semantics></math><span id="S4.I3.i1.p1.1.1" class="ltx_text ltx_font_italic"> for </span><math id="S4.I3.i1.p1.m2" class="ltx_Math" alttext="i\in[n]" display="inline" intent=":literal"><semantics><mrow><mi>i</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mi>n</mi><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">i\in[n]</annotation></semantics></math><span id="S4.I3.i1.p1.1.2" class="ltx_text ltx_font_italic">;</span></p>
</div></li>
<li id="S4.I3.i2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="S4.I3.i2.p1" class="ltx_para">
<p id="S4.I3.i2.p1.1" class="ltx_p"><math id="S4.I3.i2.p1.m1" class="ltx_Math" alttext="x_{i}\leq x_{\max}-2" display="inline" intent=":literal"><semantics><mrow><msub><mi>x</mi><mi>i</mi></msub><mo>≤</mo><mrow><msub><mi>x</mi><mi>max</mi></msub><mo>−</mo><mn>2</mn></mrow></mrow><annotation encoding="application/x-tex">x_{i}\leq x_{\max}-2</annotation></semantics></math><span id="S4.I3.i2.p1.1.1" class="ltx_text ltx_font_italic"> for </span><math id="S4.I3.i2.p1.m2" class="ltx_Math" alttext="i\in[n]" display="inline" intent=":literal"><semantics><mrow><mi>i</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mi>n</mi><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">i\in[n]</annotation></semantics></math><span id="S4.I3.i2.p1.1.2" class="ltx_text ltx_font_italic"> with </span><math id="S4.I3.i2.p1.m3" class="ltx_Math" alttext="x_{i}\neq x_{\text{max}}" display="inline" intent=":literal"><semantics><mrow><msub><mi>x</mi><mi>i</mi></msub><mo>≠</mo><msub><mi>x</mi><mtext class="ltx_mathvariant_italic">max</mtext></msub></mrow><annotation encoding="application/x-tex">x_{i}\neq x_{\text{max}}</annotation></semantics></math><span id="S4.I3.i2.p1.1.3" class="ltx_text ltx_font_italic"> (</span><math id="S4.I3.i2.p1.m4" class="ltx_Math" alttext="x_{\max}:=\max_{i\in[n]}x_{i}" display="inline" intent=":literal"><semantics><mrow><msub><mi>x</mi><mi>max</mi></msub><mo>:=</mo><mrow><msub><mi>max</mi><mrow><mi>i</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mi>n</mi><mo stretchy="false">]</mo></mrow></mrow></msub><mo lspace="0.167em">⁡</mo><msub><mi>x</mi><mi>i</mi></msub></mrow></mrow><annotation encoding="application/x-tex">x_{\max}:=\max_{i\in[n]}x_{i}</annotation></semantics></math><span id="S4.I3.i2.p1.1.4" class="ltx_text ltx_font_italic">),</span></p>
</div></li>
</ul>
<p id="Thmlemma18.p1.2" class="ltx_p"><span id="Thmlemma18.p1.2.1" class="ltx_text ltx_font_italic">there holds</span></p>
<table id="S4.EGx144" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="S4.Ex213"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S4.Ex213.m1" class="ltx_Math" alttext="\displaystyle\boldsymbol{\mathcal{F}}_{SA}^{(max)}\left(\begin{pmatrix}\boldsymbol{x}\\
\boldsymbol{1}_{1\times n}\\
\boldsymbol{0}_{1\times n}\end{pmatrix}\right)=\begin{pmatrix}\boldsymbol{x}\\
\boldsymbol{1}_{1\times n}\\
\widetilde{x}_{\max}\boldsymbol{1}_{1\times n}\end{pmatrix}," display="inline" intent=":literal"><semantics><mrow><mrow><mrow><msubsup><mi class="ltx_font_mathcaligraphic">𝓕</mi><mrow><mi>S</mi><mo lspace="0em" rspace="0em">​</mo><mi>A</mi></mrow><mrow><mo stretchy="false">(</mo><mrow><mi>m</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi><mo lspace="0em" rspace="0em">​</mo><mi>x</mi></mrow><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mo>(</mo><mtable rowspacing="0pt"><mtr><mtd><mi>𝒙</mi></mtd></mtr><mtr><mtd><msub><mn>𝟏</mn><mrow><mn>1</mn><mo lspace="0.222em" rspace="0.222em">×</mo><mi>n</mi></mrow></msub></mtd></mtr><mtr><mtd><msub><mn>𝟎</mn><mrow><mn>1</mn><mo lspace="0.222em" rspace="0.222em">×</mo><mi>n</mi></mrow></msub></mtd></mtr></mtable><mo>)</mo></mrow><mo>)</mo></mrow></mrow><mo>=</mo><mrow><mo>(</mo><mtable rowspacing="0pt"><mtr><mtd><mi>𝒙</mi></mtd></mtr><mtr><mtd><msub><mn>𝟏</mn><mrow><mn>1</mn><mo lspace="0.222em" rspace="0.222em">×</mo><mi>n</mi></mrow></msub></mtd></mtr><mtr><mtd><mrow><msub><mover accent="true"><mi>x</mi><mo>~</mo></mover><mi>max</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mn>𝟏</mn><mrow><mn>1</mn><mo lspace="0.222em" rspace="0.222em">×</mo><mi>n</mi></mrow></msub></mrow></mtd></mtr></mtable><mo>)</mo></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\boldsymbol{\mathcal{F}}_{SA}^{(max)}\left(\begin{pmatrix}\boldsymbol{x}\\
\boldsymbol{1}_{1\times n}\\
\boldsymbol{0}_{1\times n}\end{pmatrix}\right)=\begin{pmatrix}\boldsymbol{x}\\
\boldsymbol{1}_{1\times n}\\
\widetilde{x}_{\max}\boldsymbol{1}_{1\times n}\end{pmatrix},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="Thmlemma18.p1.3" class="ltx_p"><span id="Thmlemma18.p1.3.1" class="ltx_text ltx_font_italic">where <math id="Thmlemma18.p1.m8" class="ltx_Math" alttext="{x}_{\max}-\frac{1}{2P\sqrt{n}}\leq\widetilde{x}_{\max}\leq{x}_{\max}" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>x</mi><mi>max</mi></msub><mo>−</mo><mfrac><mn>1</mn><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>P</mi><mo lspace="0em" rspace="0em">​</mo><msqrt><mi>n</mi></msqrt></mrow></mfrac></mrow><mo>≤</mo><msub><mover accent="true"><mi>x</mi><mo>~</mo></mover><mi>max</mi></msub><mo>≤</mo><msub><mi>x</mi><mi>max</mi></msub></mrow><annotation encoding="application/x-tex">{x}_{\max}-\frac{1}{2P\sqrt{n}}\leq\widetilde{x}_{\max}\leq{x}_{\max}</annotation></semantics></math>. In particular, if <math id="Thmlemma18.p1.m9" class="ltx_Math" alttext="\boldsymbol{x}=\boldsymbol{0}_{1\times n}" display="inline" intent=":literal"><semantics><mrow><mi>𝐱</mi><mo>=</mo><msub><mn>𝟎</mn><mrow><mn>1</mn><mo lspace="0.222em" rspace="0.222em">×</mo><mi>n</mi></mrow></msub></mrow><annotation encoding="application/x-tex">\boldsymbol{x}=\boldsymbol{0}_{1\times n}</annotation></semantics></math>, there holds</span></p>
<table id="S4.EGx145" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="S4.Ex214"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S4.Ex214.m1" class="ltx_Math" alttext="\displaystyle\boldsymbol{\mathcal{F}}_{SA}^{(max)}\left(\begin{pmatrix}\boldsymbol{0}_{1\times n}\\
\boldsymbol{1}_{1\times n}\\
\boldsymbol{0}_{1\times n}\end{pmatrix}\right)=\begin{pmatrix}\boldsymbol{0}_{1\times n}\\
\boldsymbol{1}_{1\times n}\\
\boldsymbol{0}_{1\times n}\end{pmatrix}." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><msubsup><mi class="ltx_font_mathcaligraphic">𝓕</mi><mrow><mi>S</mi><mo lspace="0em" rspace="0em">​</mo><mi>A</mi></mrow><mrow><mo stretchy="false">(</mo><mrow><mi>m</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi><mo lspace="0em" rspace="0em">​</mo><mi>x</mi></mrow><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mo>(</mo><mtable rowspacing="0pt"><mtr><mtd><msub><mn>𝟎</mn><mrow><mn>1</mn><mo lspace="0.222em" rspace="0.222em">×</mo><mi>n</mi></mrow></msub></mtd></mtr><mtr><mtd><msub><mn>𝟏</mn><mrow><mn>1</mn><mo lspace="0.222em" rspace="0.222em">×</mo><mi>n</mi></mrow></msub></mtd></mtr><mtr><mtd><msub><mn>𝟎</mn><mrow><mn>1</mn><mo lspace="0.222em" rspace="0.222em">×</mo><mi>n</mi></mrow></msub></mtd></mtr></mtable><mo>)</mo></mrow><mo>)</mo></mrow></mrow><mo>=</mo><mrow><mo>(</mo><mtable rowspacing="0pt"><mtr><mtd><msub><mn>𝟎</mn><mrow><mn>1</mn><mo lspace="0.222em" rspace="0.222em">×</mo><mi>n</mi></mrow></msub></mtd></mtr><mtr><mtd><msub><mn>𝟏</mn><mrow><mn>1</mn><mo lspace="0.222em" rspace="0.222em">×</mo><mi>n</mi></mrow></msub></mtd></mtr><mtr><mtd><msub><mn>𝟎</mn><mrow><mn>1</mn><mo lspace="0.222em" rspace="0.222em">×</mo><mi>n</mi></mrow></msub></mtd></mtr></mtable><mo>)</mo></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\boldsymbol{\mathcal{F}}_{SA}^{(max)}\left(\begin{pmatrix}\boldsymbol{0}_{1\times n}\\
\boldsymbol{1}_{1\times n}\\
\boldsymbol{0}_{1\times n}\end{pmatrix}\right)=\begin{pmatrix}\boldsymbol{0}_{1\times n}\\
\boldsymbol{1}_{1\times n}\\
\boldsymbol{0}_{1\times n}\end{pmatrix}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
</div>
<div id="S4.SS2.2" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="S4.SS2.p3" class="ltx_para">
<p id="S4.SS2.p3.1" class="ltx_p"><span id="S4.SS2.p3.1.1" class="ltx_text">The proof is a modification of the proof of <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib25" title="" class="ltx_ref">25</a>, Lemma E.2]</cite>. The matrices in <math id="S4.SS2.p3.m1" class="ltx_Math" alttext="\boldsymbol{\mathcal{F}}_{SA}^{(max)}" display="inline" intent=":literal"><semantics><msubsup><mi class="ltx_font_mathcaligraphic">𝓕</mi><mrow><mi>S</mi><mo lspace="0em" rspace="0em">​</mo><mi>A</mi></mrow><mrow><mo stretchy="false">(</mo><mrow><mi>m</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi><mo lspace="0em" rspace="0em">​</mo><mi>x</mi></mrow><mo stretchy="false">)</mo></mrow></msubsup><annotation encoding="application/x-tex">\boldsymbol{\mathcal{F}}_{SA}^{(max)}</annotation></semantics></math> are set as</span></p>
<table id="S4.EGx146" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="S4.Ex215"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S4.Ex215.m1" class="ltx_Math" alttext="\displaystyle\boldsymbol{W}_{O}:=\begin{pmatrix}0\\
0\\
1\end{pmatrix},\quad\boldsymbol{W}_{V}:=\begin{pmatrix}1&amp;0&amp;0\end{pmatrix},\quad\boldsymbol{W}_{K}:=\begin{pmatrix}t&amp;0&amp;0\\
0&amp;0&amp;0\\
0&amp;0&amp;0\end{pmatrix},\quad\boldsymbol{W}_{Q}:=\begin{pmatrix}0&amp;1&amp;0\\
0&amp;0&amp;0\\
0&amp;0&amp;0\end{pmatrix}," display="inline" intent=":literal"><semantics><mrow><mrow><mrow><msub><mi>𝑾</mi><mi>O</mi></msub><mo>:=</mo><mrow><mo>(</mo><mtable rowspacing="0pt"><mtr><mtd><mn>0</mn></mtd></mtr><mtr><mtd><mn>0</mn></mtd></mtr><mtr><mtd><mn>1</mn></mtd></mtr></mtable><mo>)</mo></mrow></mrow><mo rspace="1.167em">,</mo><mrow><msub><mi>𝑾</mi><mi>V</mi></msub><mo>:=</mo><mrow><mo>(</mo><mtable columnspacing="5pt"><mtr><mtd><mn>1</mn></mtd><mtd><mn>0</mn></mtd><mtd><mn>0</mn></mtd></mtr></mtable><mo>)</mo></mrow></mrow><mo rspace="1.167em">,</mo><mrow><msub><mi>𝑾</mi><mi>K</mi></msub><mo>:=</mo><mrow><mo>(</mo><mtable columnspacing="5pt" rowspacing="0pt"><mtr><mtd><mi>t</mi></mtd><mtd><mn>0</mn></mtd><mtd><mn>0</mn></mtd></mtr><mtr><mtd><mn>0</mn></mtd><mtd><mn>0</mn></mtd><mtd><mn>0</mn></mtd></mtr><mtr><mtd><mn>0</mn></mtd><mtd><mn>0</mn></mtd><mtd><mn>0</mn></mtd></mtr></mtable><mo>)</mo></mrow></mrow><mo rspace="1.167em">,</mo><mrow><msub><mi>𝑾</mi><mi>Q</mi></msub><mo>:=</mo><mrow><mo>(</mo><mtable columnspacing="5pt" rowspacing="0pt"><mtr><mtd><mn>0</mn></mtd><mtd><mn>1</mn></mtd><mtd><mn>0</mn></mtd></mtr><mtr><mtd><mn>0</mn></mtd><mtd><mn>0</mn></mtd><mtd><mn>0</mn></mtd></mtr><mtr><mtd><mn>0</mn></mtd><mtd><mn>0</mn></mtd><mtd><mn>0</mn></mtd></mtr></mtable><mo>)</mo></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\boldsymbol{W}_{O}:=\begin{pmatrix}0\\
0\\
1\end{pmatrix},\quad\boldsymbol{W}_{V}:=\begin{pmatrix}1&amp;0&amp;0\end{pmatrix},\quad\boldsymbol{W}_{K}:=\begin{pmatrix}t&amp;0&amp;0\\
0&amp;0&amp;0\\
0&amp;0&amp;0\end{pmatrix},\quad\boldsymbol{W}_{Q}:=\begin{pmatrix}0&amp;1&amp;0\\
0&amp;0&amp;0\\
0&amp;0&amp;0\end{pmatrix},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S4.SS2.p3.2" class="ltx_p"><span id="S4.SS2.p3.2.1" class="ltx_text">where <math id="S4.SS2.p3.m2" class="ltx_Math" alttext="t&gt;0" display="inline" intent=":literal"><semantics><mrow><mi>t</mi><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">t&gt;0</annotation></semantics></math> is some parameter that will be defined later. Denoting</span></p>
<table id="S4.EGx147" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="S4.Ex216"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S4.Ex216.m1" class="ltx_Math" alttext="\displaystyle\boldsymbol{X}=\begin{pmatrix}\boldsymbol{x}\\
\boldsymbol{1}_{1\times n}\\
\boldsymbol{0}_{1\times n}\end{pmatrix}," display="inline" intent=":literal"><semantics><mrow><mrow><mi>𝑿</mi><mo>=</mo><mrow><mo>(</mo><mtable rowspacing="0pt"><mtr><mtd><mi>𝒙</mi></mtd></mtr><mtr><mtd><msub><mn>𝟏</mn><mrow><mn>1</mn><mo lspace="0.222em" rspace="0.222em">×</mo><mi>n</mi></mrow></msub></mtd></mtr><mtr><mtd><msub><mn>𝟎</mn><mrow><mn>1</mn><mo lspace="0.222em" rspace="0.222em">×</mo><mi>n</mi></mrow></msub></mtd></mtr></mtable><mo>)</mo></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\boldsymbol{X}=\begin{pmatrix}\boldsymbol{x}\\
\boldsymbol{1}_{1\times n}\\
\boldsymbol{0}_{1\times n}\end{pmatrix},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S4.SS2.p3.3" class="ltx_p"><span id="S4.SS2.p3.3.1" class="ltx_text">we have</span></p>
<table id="S4.EGx148" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="S4.Ex217"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S4.Ex217.m1" class="ltx_Math" alttext="\displaystyle\boldsymbol{W}_{O}\boldsymbol{W}_{V}\boldsymbol{X}=\begin{pmatrix}0\\
0\\
1\end{pmatrix}\begin{pmatrix}1&amp;0&amp;0\end{pmatrix}\begin{pmatrix}\boldsymbol{x}\\
\boldsymbol{1}_{1\times n}\\
\boldsymbol{0}_{1\times n}\end{pmatrix}=\begin{pmatrix}\boldsymbol{0}_{1\times n}\\
\boldsymbol{0}_{1\times n}\\
\boldsymbol{x}\end{pmatrix}" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>𝑾</mi><mi>O</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝑾</mi><mi>V</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi>𝑿</mi></mrow><mo>=</mo><mrow><mrow><mo>(</mo><mtable rowspacing="0pt"><mtr><mtd><mn>0</mn></mtd></mtr><mtr><mtd><mn>0</mn></mtd></mtr><mtr><mtd><mn>1</mn></mtd></mtr></mtable><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mtable columnspacing="5pt"><mtr><mtd><mn>1</mn></mtd><mtd><mn>0</mn></mtd><mtd><mn>0</mn></mtd></mtr></mtable><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mtable rowspacing="0pt"><mtr><mtd><mi>𝒙</mi></mtd></mtr><mtr><mtd><msub><mn>𝟏</mn><mrow><mn>1</mn><mo lspace="0.222em" rspace="0.222em">×</mo><mi>n</mi></mrow></msub></mtd></mtr><mtr><mtd><msub><mn>𝟎</mn><mrow><mn>1</mn><mo lspace="0.222em" rspace="0.222em">×</mo><mi>n</mi></mrow></msub></mtd></mtr></mtable><mo>)</mo></mrow></mrow><mo>=</mo><mrow><mo>(</mo><mtable rowspacing="0pt"><mtr><mtd><msub><mn>𝟎</mn><mrow><mn>1</mn><mo lspace="0.222em" rspace="0.222em">×</mo><mi>n</mi></mrow></msub></mtd></mtr><mtr><mtd><msub><mn>𝟎</mn><mrow><mn>1</mn><mo lspace="0.222em" rspace="0.222em">×</mo><mi>n</mi></mrow></msub></mtd></mtr><mtr><mtd><mi>𝒙</mi></mtd></mtr></mtable><mo>)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\boldsymbol{W}_{O}\boldsymbol{W}_{V}\boldsymbol{X}=\begin{pmatrix}0\\
0\\
1\end{pmatrix}\begin{pmatrix}1&amp;0&amp;0\end{pmatrix}\begin{pmatrix}\boldsymbol{x}\\
\boldsymbol{1}_{1\times n}\\
\boldsymbol{0}_{1\times n}\end{pmatrix}=\begin{pmatrix}\boldsymbol{0}_{1\times n}\\
\boldsymbol{0}_{1\times n}\\
\boldsymbol{x}\end{pmatrix}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S4.SS2.p3.4" class="ltx_p"><span id="S4.SS2.p3.4.1" class="ltx_text">and</span></p>
<table id="S4.EGx149" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="S4.Ex218"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S4.Ex218.m1" class="ltx_Math" alttext="\displaystyle\left(\boldsymbol{W}_{K}\boldsymbol{X}\right)^{\top}\left(\boldsymbol{W}_{Q}\boldsymbol{X}\right)" display="inline" intent=":literal"><semantics><mrow><msup><mrow><mo>(</mo><mrow><msub><mi>𝑾</mi><mi>K</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi>𝑿</mi></mrow><mo>)</mo></mrow><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><msub><mi>𝑾</mi><mi>Q</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi>𝑿</mi></mrow><mo>)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\left(\boldsymbol{W}_{K}\boldsymbol{X}\right)^{\top}\left(\boldsymbol{W}_{Q}\boldsymbol{X}\right)</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S4.Ex218.m2" class="ltx_Math" alttext="\displaystyle=\left(\begin{pmatrix}t&amp;0&amp;0\\
0&amp;0&amp;0\\
0&amp;0&amp;0\end{pmatrix}\begin{pmatrix}\boldsymbol{x}\\
\boldsymbol{1}_{1\times n}\\
\boldsymbol{0}_{1\times n}\end{pmatrix}\right)^{\top}\left(\begin{pmatrix}0&amp;1&amp;0\\
0&amp;0&amp;0\\
0&amp;0&amp;0\end{pmatrix}\begin{pmatrix}\boldsymbol{x}\\
\boldsymbol{1}_{1\times n}\\
\boldsymbol{0}_{1\times n}\end{pmatrix}\right)" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><msup><mrow><mo>(</mo><mrow><mrow><mo>(</mo><mtable columnspacing="5pt" rowspacing="0pt"><mtr><mtd><mi>t</mi></mtd><mtd><mn>0</mn></mtd><mtd><mn>0</mn></mtd></mtr><mtr><mtd><mn>0</mn></mtd><mtd><mn>0</mn></mtd><mtd><mn>0</mn></mtd></mtr><mtr><mtd><mn>0</mn></mtd><mtd><mn>0</mn></mtd><mtd><mn>0</mn></mtd></mtr></mtable><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mtable rowspacing="0pt"><mtr><mtd><mi>𝒙</mi></mtd></mtr><mtr><mtd><msub><mn>𝟏</mn><mrow><mn>1</mn><mo lspace="0.222em" rspace="0.222em">×</mo><mi>n</mi></mrow></msub></mtd></mtr><mtr><mtd><msub><mn>𝟎</mn><mrow><mn>1</mn><mo lspace="0.222em" rspace="0.222em">×</mo><mi>n</mi></mrow></msub></mtd></mtr></mtable><mo>)</mo></mrow></mrow><mo>)</mo></mrow><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mrow><mo>(</mo><mtable columnspacing="5pt" rowspacing="0pt"><mtr><mtd><mn>0</mn></mtd><mtd><mn>1</mn></mtd><mtd><mn>0</mn></mtd></mtr><mtr><mtd><mn>0</mn></mtd><mtd><mn>0</mn></mtd><mtd><mn>0</mn></mtd></mtr><mtr><mtd><mn>0</mn></mtd><mtd><mn>0</mn></mtd><mtd><mn>0</mn></mtd></mtr></mtable><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mtable rowspacing="0pt"><mtr><mtd><mi>𝒙</mi></mtd></mtr><mtr><mtd><msub><mn>𝟏</mn><mrow><mn>1</mn><mo lspace="0.222em" rspace="0.222em">×</mo><mi>n</mi></mrow></msub></mtd></mtr><mtr><mtd><msub><mn>𝟎</mn><mrow><mn>1</mn><mo lspace="0.222em" rspace="0.222em">×</mo><mi>n</mi></mrow></msub></mtd></mtr></mtable><mo>)</mo></mrow></mrow><mo>)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\left(\begin{pmatrix}t&amp;0&amp;0\\
0&amp;0&amp;0\\
0&amp;0&amp;0\end{pmatrix}\begin{pmatrix}\boldsymbol{x}\\
\boldsymbol{1}_{1\times n}\\
\boldsymbol{0}_{1\times n}\end{pmatrix}\right)^{\top}\left(\begin{pmatrix}0&amp;1&amp;0\\
0&amp;0&amp;0\\
0&amp;0&amp;0\end{pmatrix}\begin{pmatrix}\boldsymbol{x}\\
\boldsymbol{1}_{1\times n}\\
\boldsymbol{0}_{1\times n}\end{pmatrix}\right)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="S4.Ex219"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S4.Ex219.m1" class="ltx_Math" alttext="\displaystyle=\begin{pmatrix}t\boldsymbol{x}^{\top}&amp;\boldsymbol{0}_{n\times 1}&amp;\boldsymbol{0}_{n\times 1}\end{pmatrix}\begin{pmatrix}\boldsymbol{1}_{1\times n}\\
\boldsymbol{0}_{1\times n}\\
\boldsymbol{0}_{1\times n}\end{pmatrix}=t\boldsymbol{x}^{\top}\boldsymbol{1}_{1\times n}." display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><mo>(</mo><mtable columnspacing="5pt"><mtr><mtd><mrow><mi>t</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝒙</mi><mo>⊤</mo></msup></mrow></mtd><mtd><msub><mn>𝟎</mn><mrow><mi>n</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mn>1</mn></mrow></msub></mtd><mtd><msub><mn>𝟎</mn><mrow><mi>n</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mn>1</mn></mrow></msub></mtd></mtr></mtable><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mtable rowspacing="0pt"><mtr><mtd><msub><mn>𝟏</mn><mrow><mn>1</mn><mo lspace="0.222em" rspace="0.222em">×</mo><mi>n</mi></mrow></msub></mtd></mtr><mtr><mtd><msub><mn>𝟎</mn><mrow><mn>1</mn><mo lspace="0.222em" rspace="0.222em">×</mo><mi>n</mi></mrow></msub></mtd></mtr><mtr><mtd><msub><mn>𝟎</mn><mrow><mn>1</mn><mo lspace="0.222em" rspace="0.222em">×</mo><mi>n</mi></mrow></msub></mtd></mtr></mtable><mo>)</mo></mrow></mrow><mo>=</mo><mrow><mi>t</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝒙</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msub><mn>𝟏</mn><mrow><mn>1</mn><mo lspace="0.222em" rspace="0.222em">×</mo><mi>n</mi></mrow></msub></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle=\begin{pmatrix}t\boldsymbol{x}^{\top}&amp;\boldsymbol{0}_{n\times 1}&amp;\boldsymbol{0}_{n\times 1}\end{pmatrix}\begin{pmatrix}\boldsymbol{1}_{1\times n}\\
\boldsymbol{0}_{1\times n}\\
\boldsymbol{0}_{1\times n}\end{pmatrix}=t\boldsymbol{x}^{\top}\boldsymbol{1}_{1\times n}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S4.SS2.p3.5" class="ltx_p"><span id="S4.SS2.p3.5.1" class="ltx_text">Hence</span></p>
<table id="S4.EGx150" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="S4.Ex220"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S4.Ex220.m1" class="ltx_Math" alttext="\displaystyle\boldsymbol{\mathcal{F}}_{SA}^{(max)}\left(\begin{pmatrix}\boldsymbol{x}\\
\boldsymbol{1}_{1\times n}\\
\boldsymbol{0}_{1\times n}\end{pmatrix}\right)" display="inline" intent=":literal"><semantics><mrow><msubsup><mi class="ltx_font_mathcaligraphic">𝓕</mi><mrow><mi>S</mi><mo lspace="0em" rspace="0em">​</mo><mi>A</mi></mrow><mrow><mo stretchy="false">(</mo><mrow><mi>m</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi><mo lspace="0em" rspace="0em">​</mo><mi>x</mi></mrow><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mo>(</mo><mtable rowspacing="0pt"><mtr><mtd><mi>𝒙</mi></mtd></mtr><mtr><mtd><msub><mn>𝟏</mn><mrow><mn>1</mn><mo lspace="0.222em" rspace="0.222em">×</mo><mi>n</mi></mrow></msub></mtd></mtr><mtr><mtd><msub><mn>𝟎</mn><mrow><mn>1</mn><mo lspace="0.222em" rspace="0.222em">×</mo><mi>n</mi></mrow></msub></mtd></mtr></mtable><mo>)</mo></mrow><mo>)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\boldsymbol{\mathcal{F}}_{SA}^{(max)}\left(\begin{pmatrix}\boldsymbol{x}\\
\boldsymbol{1}_{1\times n}\\
\boldsymbol{0}_{1\times n}\end{pmatrix}\right)</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S4.Ex220.m2" class="ltx_Math" alttext="\displaystyle=\boldsymbol{X}+\boldsymbol{W}_{O}\boldsymbol{W}_{V}\boldsymbol{X}\sigma_{S}\left(\left(\boldsymbol{W}_{K}\boldsymbol{X}\right)^{\top}\left(\boldsymbol{W}_{Q}\boldsymbol{X}\right)\right)" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mi>𝑿</mi><mo>+</mo><mrow><msub><mi>𝑾</mi><mi>O</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝑾</mi><mi>V</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi>𝑿</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>σ</mi><mi>S</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><msup><mrow><mo>(</mo><mrow><msub><mi>𝑾</mi><mi>K</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi>𝑿</mi></mrow><mo>)</mo></mrow><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><msub><mi>𝑾</mi><mi>Q</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi>𝑿</mi></mrow><mo>)</mo></mrow></mrow><mo>)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\boldsymbol{X}+\boldsymbol{W}_{O}\boldsymbol{W}_{V}\boldsymbol{X}\sigma_{S}\left(\left(\boldsymbol{W}_{K}\boldsymbol{X}\right)^{\top}\left(\boldsymbol{W}_{Q}\boldsymbol{X}\right)\right)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="S4.Ex221"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S4.Ex221.m1" class="ltx_Math" alttext="\displaystyle=\begin{pmatrix}\boldsymbol{x}\\
\boldsymbol{1}_{1\times n}\\
\boldsymbol{0}_{1\times n}\end{pmatrix}+\begin{pmatrix}\boldsymbol{0}_{1\times n}\\
\boldsymbol{0}_{1\times n}\\
\boldsymbol{x}\end{pmatrix}\sigma_{S}\left(t\boldsymbol{x}^{\top}\boldsymbol{1}_{1\times n}\right)" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><mo>(</mo><mtable rowspacing="0pt"><mtr><mtd><mi>𝒙</mi></mtd></mtr><mtr><mtd><msub><mn>𝟏</mn><mrow><mn>1</mn><mo lspace="0.222em" rspace="0.222em">×</mo><mi>n</mi></mrow></msub></mtd></mtr><mtr><mtd><msub><mn>𝟎</mn><mrow><mn>1</mn><mo lspace="0.222em" rspace="0.222em">×</mo><mi>n</mi></mrow></msub></mtd></mtr></mtable><mo>)</mo></mrow><mo>+</mo><mrow><mrow><mo>(</mo><mtable rowspacing="0pt"><mtr><mtd><msub><mn>𝟎</mn><mrow><mn>1</mn><mo lspace="0.222em" rspace="0.222em">×</mo><mi>n</mi></mrow></msub></mtd></mtr><mtr><mtd><msub><mn>𝟎</mn><mrow><mn>1</mn><mo lspace="0.222em" rspace="0.222em">×</mo><mi>n</mi></mrow></msub></mtd></mtr><mtr><mtd><mi>𝒙</mi></mtd></mtr></mtable><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>σ</mi><mi>S</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mi>t</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝒙</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msub><mn>𝟏</mn><mrow><mn>1</mn><mo lspace="0.222em" rspace="0.222em">×</mo><mi>n</mi></mrow></msub></mrow><mo>)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\begin{pmatrix}\boldsymbol{x}\\
\boldsymbol{1}_{1\times n}\\
\boldsymbol{0}_{1\times n}\end{pmatrix}+\begin{pmatrix}\boldsymbol{0}_{1\times n}\\
\boldsymbol{0}_{1\times n}\\
\boldsymbol{x}\end{pmatrix}\sigma_{S}\left(t\boldsymbol{x}^{\top}\boldsymbol{1}_{1\times n}\right)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
