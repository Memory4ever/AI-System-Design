\boldsymbol{0}_{S^{(1)}\times d^{(2)}}\end{pmatrix}\begin{pmatrix}\boldsymbol{W}_{Q,h}^{(1)}&amp;\boldsymbol{0}_{S^{(1)}\times d^{(2)}}\end{pmatrix}\begin{pmatrix}\boldsymbol{X}\\
\boldsymbol{Y}\end{pmatrix}\right)" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><mo>(</mo><mtable rowspacing="0pt"><mtr><mtd><msubsup><mi>𝑾</mi><mrow><mi>O</mi><mo>,</mo><mi>h</mi></mrow><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msubsup></mtd></mtr><mtr><mtd><msub><mn>𝟎</mn><mrow><msup><mi>d</mi><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msup><mo lspace="0.222em" rspace="0.222em">×</mo><msup><mi>S</mi><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msup></mrow></msub></mtd></mtr></mtable><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mtable columnspacing="5pt"><mtr><mtd><msubsup><mi>𝑾</mi><mrow><mi>V</mi><mo>,</mo><mi>h</mi></mrow><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msubsup></mtd><mtd><msub><mn>𝟎</mn><mrow><msup><mi>S</mi><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msup><mo lspace="0.222em" rspace="0.222em">×</mo><msup><mi>d</mi><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msup></mrow></msub></mtd></mtr></mtable><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mtable rowspacing="0pt"><mtr><mtd><mi>𝑿</mi></mtd></mtr><mtr><mtd><mi>𝒀</mi></mtd></mtr></mtable><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>σ</mi><mi>S</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mrow><mo>(</mo><mtable columnspacing="5pt"><mtr><mtd><msup><mi>𝑿</mi><mo>⊤</mo></msup></mtd><mtd><msup><mi>𝒀</mi><mo>⊤</mo></msup></mtd></mtr></mtable><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mtable rowspacing="0pt"><mtr><mtd><msubsup><mi>𝑾</mi><mrow><mi>K</mi><mo>,</mo><mi>h</mi></mrow><mrow><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow><mo lspace="0.222em">⊤</mo></mrow></msubsup></mtd></mtr><mtr><mtd><msub><mn>𝟎</mn><mrow><msup><mi>S</mi><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msup><mo lspace="0.222em" rspace="0.222em">×</mo><msup><mi>d</mi><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msup></mrow></msub></mtd></mtr></mtable><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mtable columnspacing="5pt"><mtr><mtd><msubsup><mi>𝑾</mi><mrow><mi>Q</mi><mo>,</mo><mi>h</mi></mrow><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msubsup></mtd><mtd><msub><mn>𝟎</mn><mrow><msup><mi>S</mi><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msup><mo lspace="0.222em" rspace="0.222em">×</mo><msup><mi>d</mi><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msup></mrow></msub></mtd></mtr></mtable><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mtable rowspacing="0pt"><mtr><mtd><mi>𝑿</mi></mtd></mtr><mtr><mtd><mi>𝒀</mi></mtd></mtr></mtable><mo>)</mo></mrow></mrow><mo>)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\begin{pmatrix}\boldsymbol{W}_{O,h}^{(1)}\\
\boldsymbol{0}_{d^{(2)}\times S^{(1)}}\end{pmatrix}\begin{pmatrix}\boldsymbol{W}_{V,h}^{(1)}&amp;\boldsymbol{0}_{S^{(1)}\times d^{(2)}}\end{pmatrix}\begin{pmatrix}\boldsymbol{X}\\
\boldsymbol{Y}\end{pmatrix}\sigma_{S}\left(\begin{pmatrix}\boldsymbol{X}^{\top}&amp;\boldsymbol{Y}^{\top}\end{pmatrix}\begin{pmatrix}\boldsymbol{W}_{K,h}^{(1){\top}}\\
\boldsymbol{0}_{S^{(1)}\times d^{(2)}}\end{pmatrix}\begin{pmatrix}\boldsymbol{W}_{Q,h}^{(1)}&amp;\boldsymbol{0}_{S^{(1)}\times d^{(2)}}\end{pmatrix}\begin{pmatrix}\boldsymbol{X}\\
\boldsymbol{Y}\end{pmatrix}\right)</annotation></semantics></math></td>
