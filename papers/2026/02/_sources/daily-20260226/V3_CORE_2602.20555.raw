<tbody id="S7.Ex435"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S7.Ex435.m1" class="ltx_Math" alttext="\displaystyle\leq(4d_{SA}^{2}E^{2}S^{2}B_{SA}^{4}+d_{SA}\sqrt{n}SB_{SA}^{2})\left\|\boldsymbol{\widetilde{Y}}-\boldsymbol{Y}\right\|_{F}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≤</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mrow><mn>4</mn><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>d</mi><mrow><mi>S</mi><mo lspace="0em" rspace="0em">​</mo><mi>A</mi></mrow><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mi>E</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>S</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>B</mi><mrow><mi>S</mi><mo lspace="0em" rspace="0em">​</mo><mi>A</mi></mrow><mn>4</mn></msubsup></mrow><mo>+</mo><mrow><msub><mi>d</mi><mrow><mi>S</mi><mo lspace="0em" rspace="0em">​</mo><mi>A</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msqrt><mi>n</mi></msqrt><mo lspace="0em" rspace="0em">​</mo><mi>S</mi><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>B</mi><mrow><mi>S</mi><mo lspace="0em" rspace="0em">​</mo><mi>A</mi></mrow><mn>2</mn></msubsup></mrow></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo>‖</mo><mrow><mover accent="true"><mi>𝒀</mi><mo>~</mo></mover><mo>−</mo><mi>𝒀</mi></mrow><mo>‖</mo></mrow><mi>F</mi></msub></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\leq(4d_{SA}^{2}E^{2}S^{2}B_{SA}^{4}+d_{SA}\sqrt{n}SB_{SA}^{2})\left\|\boldsymbol{\widetilde{Y}}-\boldsymbol{Y}\right\|_{F}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="S7.Ex436"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S7.Ex436.m1" class="ltx_Math" alttext="\displaystyle\leq 5d_{SA}^{2}\sqrt{n}E^{2}S^{2}B_{SA}^{4}\left\|\boldsymbol{\widetilde{Y}}-\boldsymbol{Y}\right\|_{F}," display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>≤</mo><mrow><mn>5</mn><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>d</mi><mrow><mi>S</mi><mo lspace="0em" rspace="0em">​</mo><mi>A</mi></mrow><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><msqrt><mi>n</mi></msqrt><mo lspace="0em" rspace="0em">​</mo><msup><mi>E</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>S</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>B</mi><mrow><mi>S</mi><mo lspace="0em" rspace="0em">​</mo><mi>A</mi></mrow><mn>4</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo>‖</mo><mrow><mover accent="true"><mi>𝒀</mi><mo>~</mo></mover><mo>−</mo><mi>𝒀</mi></mrow><mo>‖</mo></mrow><mi>F</mi></msub></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\leq 5d_{SA}^{2}\sqrt{n}E^{2}S^{2}B_{SA}^{4}\left\|\boldsymbol{\widetilde{Y}}-\boldsymbol{Y}\right\|_{F},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S7.p13.5" class="ltx_p"><span id="S7.p13.5.1" class="ltx_text">where in the third step we use Lemma <a href="#Thmlemma24" title="Lemma 24. ‣ 7 Proof of Lemma : Estimation of Lipschitz Constant ‣ Standard Transformers Achieve the Minimax Rate in Nonparametric Regression with 𝐶^{𝑠,𝜆} Targets" class="ltx_ref"><span class="ltx_text ltx_ref_tag">24</span></a> and Lemma <a href="#Thmlemma27" title="Lemma 27. ‣ 7 Proof of Lemma : Estimation of Lipschitz Constant ‣ Standard Transformers Achieve the Minimax Rate in Nonparametric Regression with 𝐶^{𝑠,𝜆} Targets" class="ltx_ref"><span class="ltx_text ltx_ref_tag">27</span></a>. Hence</span></p>
<table id="S7.EGx247" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="S7.Ex437"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S7.Ex437.m1" class="ltx_Math" alttext="\displaystyle\left\|\boldsymbol{\mathcal{F}}_{SA}\left(\boldsymbol{\widetilde{Y}}\right)-\boldsymbol{\mathcal{F}}_{SA}(\boldsymbol{Y})\right\|_{F}\leq 6d_{SA}^{2}\sqrt{n}E^{2}HS^{2}B_{SA}^{4}\left\|\boldsymbol{\widetilde{Y}}-\boldsymbol{Y}\right\|_{F}." display="inline" intent=":literal"><semantics><mrow><mrow><msub><mrow><mo>‖</mo><mrow><mrow><msub><mi class="ltx_font_mathcaligraphic">𝓕</mi><mrow><mi>S</mi><mo lspace="0em" rspace="0em">​</mo><mi>A</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mover accent="true"><mi>𝒀</mi><mo>~</mo></mover><mo>)</mo></mrow></mrow><mo>−</mo><mrow><msub><mi class="ltx_font_mathcaligraphic">𝓕</mi><mrow><mi>S</mi><mo lspace="0em" rspace="0em">​</mo><mi>A</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝒀</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>‖</mo></mrow><mi>F</mi></msub><mo>≤</mo><mrow><mn>6</mn><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>d</mi><mrow><mi>S</mi><mo lspace="0em" rspace="0em">​</mo><mi>A</mi></mrow><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><msqrt><mi>n</mi></msqrt><mo lspace="0em" rspace="0em">​</mo><msup><mi>E</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mi>H</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>S</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>B</mi><mrow><mi>S</mi><mo lspace="0em" rspace="0em">​</mo><mi>A</mi></mrow><mn>4</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo>‖</mo><mrow><mover accent="true"><mi>𝒀</mi><mo>~</mo></mover><mo>−</mo><mi>𝒀</mi></mrow><mo>‖</mo></mrow><mi>F</mi></msub></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\left\|\boldsymbol{\mathcal{F}}_{SA}\left(\boldsymbol{\widetilde{Y}}\right)-\boldsymbol{\mathcal{F}}_{SA}(\boldsymbol{Y})\right\|_{F}\leq 6d_{SA}^{2}\sqrt{n}E^{2}HS^{2}B_{SA}^{4}\left\|\boldsymbol{\widetilde{Y}}-\boldsymbol{Y}\right\|_{F}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S7.p13.6" class="ltx_p"><span id="S7.p13.6.1" class="ltx_text">∎</span></p>
</div>
</div>
<div id="S7.p14" class="ltx_para">
<p id="S7.p14.1" class="ltx_p">We prove Lemma <a href="#Thmlemma4" title="Lemma 4. ‣ 2.3 Proof of Theorem ‣ 2 Proofs of Main Results ‣ Standard Transformers Achieve the Minimax Rate in Nonparametric Regression with 𝐶^{𝑠,𝜆} Targets" class="ltx_ref"><span class="ltx_text ltx_ref_tag">4</span></a> by employing Lemmas <a href="#Thmlemma28" title="Lemma 28. ‣ 7 Proof of Lemma : Estimation of Lipschitz Constant ‣ Standard Transformers Achieve the Minimax Rate in Nonparametric Regression with 𝐶^{𝑠,𝜆} Targets" class="ltx_ref"><span class="ltx_text ltx_ref_tag">28</span></a> - <a href="#Thmlemma30" title="Lemma 30. ‣ 7 Proof of Lemma : Estimation of Lipschitz Constant ‣ Standard Transformers Achieve the Minimax Rate in Nonparametric Regression with 𝐶^{𝑠,𝜆} Targets" class="ltx_ref"><span class="ltx_text ltx_ref_tag">30</span></a>.</p>
</div>
<div id="S7.9" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof of Lemma <a href="#Thmlemma4" title="Lemma 4. ‣ 2.3 Proof of Theorem ‣ 2 Proofs of Main Results ‣ Standard Transformers Achieve the Minimax Rate in Nonparametric Regression with 𝐶^{𝑠,𝜆} Targets" class="ltx_ref"><span class="ltx_text ltx_ref_tag">4</span></a>.</h6>
<div id="S7.p15" class="ltx_para">
<p id="S7.p15.1" class="ltx_p"><span id="S7.p15.1.1" class="ltx_text">We examine the difference of <math id="S7.p15.m1" class="ltx_Math" alttext="f_{\boldsymbol{\widetilde{T}}},f_{\boldsymbol{{T}}}\in\mathcal{F}_{\mathcal{T}}" display="inline" intent=":literal"><semantics><mrow><msub><mi>f</mi><mover accent="true"><mi>𝑻</mi><mo>~</mo></mover></msub><mo>,</mo><mrow><msub><mi>f</mi><mi>𝑻</mi></msub><mo>∈</mo><msub><mi class="ltx_font_mathcaligraphic">ℱ</mi><mi class="ltx_font_mathcaligraphic">𝒯</mi></msub></mrow></mrow><annotation encoding="application/x-tex">f_{\boldsymbol{\widetilde{T}}},f_{\boldsymbol{{T}}}\in\mathcal{F}_{\mathcal{T}}</annotation></semantics></math>, where each trainable parameter in <math id="S7.p15.m2" class="ltx_Math" alttext="f_{\boldsymbol{\widetilde{T}}}" display="inline" intent=":literal"><semantics><msub><mi>f</mi><mover accent="true"><mi>𝑻</mi><mo>~</mo></mover></msub><annotation encoding="application/x-tex">f_{\boldsymbol{\widetilde{T}}}</annotation></semantics></math> and <math id="S7.p15.m3" class="ltx_Math" alttext="f_{\boldsymbol{{T}}}" display="inline" intent=":literal"><semantics><msub><mi>f</mi><mi>𝑻</mi></msub><annotation encoding="application/x-tex">f_{\boldsymbol{{T}}}</annotation></semantics></math> differs by at most <math id="S7.p15.m4" class="ltx_Math" alttext="\varsigma" display="inline" intent=":literal"><semantics><mi>ς</mi><annotation encoding="application/x-tex">\varsigma</annotation></semantics></math>. Since</span></p>
<table id="S7.EGx248" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="S7.E35"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S7.E35.m1" class="ltx_Math" alttext="\displaystyle\left|f_{\boldsymbol{\widetilde{T}}}(\boldsymbol{X})-f_{\boldsymbol{T}}(\boldsymbol{X})\right|=\left|\left\langle\boldsymbol{\widetilde{T}}(\boldsymbol{X})-\boldsymbol{T}(\boldsymbol{X}),\boldsymbol{E}_{11}\right\rangle\right|\leq\left\|\boldsymbol{\widetilde{T}}(\boldsymbol{X})-\boldsymbol{T}(\boldsymbol{X})\right\|_{F}," display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mo>|</mo><mrow><mrow><msub><mi>f</mi><mover accent="true"><mi>𝑻</mi><mo>~</mo></mover></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝑿</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msub><mi>f</mi><mi>𝑻</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝑿</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>|</mo></mrow><mo>=</mo><mrow><mo>|</mo><mrow><mo>⟨</mo><mrow><mrow><mrow><mover accent="true"><mi>𝑻</mi><mo>~</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝑿</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mi>𝑻</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝑿</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>,</mo><msub><mi>𝑬</mi><mn>11</mn></msub></mrow><mo>⟩</mo></mrow><mo>|</mo></mrow><mo>≤</mo><msub><mrow><mo>‖</mo><mrow><mrow><mover accent="true"><mi>𝑻</mi><mo>~</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝑿</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mi>𝑻</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝑿</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>‖</mo></mrow><mi>F</mi></msub></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\left|f_{\boldsymbol{\widetilde{T}}}(\boldsymbol{X})-f_{\boldsymbol{T}}(\boldsymbol{X})\right|=\left|\left\langle\boldsymbol{\widetilde{T}}(\boldsymbol{X})-\boldsymbol{T}(\boldsymbol{X}),\boldsymbol{E}_{11}\right\rangle\right|\leq\left\|\boldsymbol{\widetilde{T}}(\boldsymbol{X})-\boldsymbol{T}(\boldsymbol{X})\right\|_{F},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(35)</span></td></tr></tbody>
</table>
<p id="S7.p15.2" class="ltx_p"><span id="S7.p15.2.1" class="ltx_text">what we need is an upper bound of <math id="S7.p15.m5" class="ltx_Math" alttext="\left\|\boldsymbol{\widetilde{T}}(\boldsymbol{X})-\boldsymbol{T}(\boldsymbol{X})\right\|_{F}" display="inline" intent=":literal"><semantics><msub><mrow><mo>‖</mo><mrow><mrow><mover accent="true"><mi>𝑻</mi><mo>~</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝑿</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mi>𝑻</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝑿</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>‖</mo></mrow><mi>F</mi></msub><annotation encoding="application/x-tex">\left\|\boldsymbol{\widetilde{T}}(\boldsymbol{X})-\boldsymbol{T}(\boldsymbol{X})\right\|_{F}</annotation></semantics></math>. We split <math id="S7.p15.m6" class="ltx_Math" alttext="\left\|\boldsymbol{\widetilde{T}}(\boldsymbol{X})-\boldsymbol{T}(\boldsymbol{X})\right\|_{F}" display="inline" intent=":literal"><semantics><msub><mrow><mo>‖</mo><mrow><mrow><mover accent="true"><mi>𝑻</mi><mo>~</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝑿</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mi>𝑻</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝑿</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>‖</mo></mrow><mi>F</mi></msub><annotation encoding="application/x-tex">\left\|\boldsymbol{\widetilde{T}}(\boldsymbol{X})-\boldsymbol{T}(\boldsymbol{X})\right\|_{F}</annotation></semantics></math> in the following way:</span></p>
<table id="S7.EGx249" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="S7.Ex438"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S7.Ex438.m1" class="ltx_Math" alttext="\displaystyle\left\|\boldsymbol{\widetilde{T}}(\boldsymbol{X})-\boldsymbol{T}(\boldsymbol{X})\right\|_{F}" display="inline" intent=":literal"><semantics><msub><mrow><mo>‖</mo><mrow><mrow><mover accent="true"><mi>𝑻</mi><mo>~</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝑿</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mi>𝑻</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝑿</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>‖</mo></mrow><mi>F</mi></msub><annotation encoding="application/x-tex">\displaystyle\left\|\boldsymbol{\widetilde{T}}(\boldsymbol{X})-\boldsymbol{T}(\boldsymbol{X})\right\|_{F}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="S7.Ex439"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S7.Ex439.m1" class="ltx_math_unparsed" alttext="\displaystyle=\left\|\boldsymbol{\mathcal{\widetilde{F}}}_{FF}^{(K)}\circ\boldsymbol{\mathcal{\widetilde{F}}}_{SA}^{(K)}\circ\boldsymbol{\mathcal{\widetilde{F}}}_{FF}^{(K-1)}\circ\cdots\circ\boldsymbol{\mathcal{\widetilde{F}}}_{FF}^{(1)}\circ\boldsymbol{\mathcal{\widetilde{F}}}_{SA}^{(1)}\circ\boldsymbol{\mathcal{\widetilde{F}}}_{FF}^{(0)}\circ\boldsymbol{\mathcal{\widetilde{F}}}_{EB}(\boldsymbol{X})\right." display="inline" intent=":literal"><semantics><mrow><mo>=</mo><mrow><mo>‖</mo><msubsup><mover accent="true"><mi class="ltx_font_mathcaligraphic">𝓕</mi><mo>~</mo></mover><mrow><mi>F</mi><mo lspace="0em" rspace="0em">​</mo><mi>F</mi></mrow><mrow><mo stretchy="false">(</mo><mi>K</mi><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0.222em" rspace="0.222em">∘</mo><msubsup><mover accent="true"><mi class="ltx_font_mathcaligraphic">𝓕</mi><mo>~</mo></mover><mrow><mi>S</mi><mo lspace="0em" rspace="0em">​</mo><mi>A</mi></mrow><mrow><mo stretchy="false">(</mo><mi>K</mi><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0.222em" rspace="0.222em">∘</mo><msubsup><mover accent="true"><mi class="ltx_font_mathcaligraphic">𝓕</mi><mo>~</mo></mover><mrow><mi>F</mi><mo lspace="0em" rspace="0em">​</mo><mi>F</mi></mrow><mrow><mo stretchy="false">(</mo><mrow><mi>K</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0.222em">∘</mo><mo lspace="0.055em" rspace="0.055em">⋯</mo><mo rspace="0.222em">∘</mo><msubsup><mover accent="true"><mi class="ltx_font_mathcaligraphic">𝓕</mi><mo>~</mo></mover><mrow><mi>F</mi><mo lspace="0em" rspace="0em">​</mo><mi>F</mi></mrow><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0.222em" rspace="0.222em">∘</mo><msubsup><mover accent="true"><mi class="ltx_font_mathcaligraphic">𝓕</mi><mo>~</mo></mover><mrow><mi>S</mi><mo lspace="0em" rspace="0em">​</mo><mi>A</mi></mrow><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0.222em" rspace="0.222em">∘</mo><msubsup><mover accent="true"><mi class="ltx_font_mathcaligraphic">𝓕</mi><mo>~</mo></mover><mrow><mi>F</mi><mo lspace="0em" rspace="0em">​</mo><mi>F</mi></mrow><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0.222em" rspace="0.222em">∘</mo><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">𝓕</mi><mo>~</mo></mover><mrow><mi>E</mi><mo lspace="0em" rspace="0em">​</mo><mi>B</mi></mrow></msub><mrow><mo stretchy="false">(</mo><mi>𝑿</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\left\|\boldsymbol{\mathcal{\widetilde{F}}}_{FF}^{(K)}\circ\boldsymbol{\mathcal{\widetilde{F}}}_{SA}^{(K)}\circ\boldsymbol{\mathcal{\widetilde{F}}}_{FF}^{(K-1)}\circ\cdots\circ\boldsymbol{\mathcal{\widetilde{F}}}_{FF}^{(1)}\circ\boldsymbol{\mathcal{\widetilde{F}}}_{SA}^{(1)}\circ\boldsymbol{\mathcal{\widetilde{F}}}_{FF}^{(0)}\circ\boldsymbol{\mathcal{\widetilde{F}}}_{EB}(\boldsymbol{X})\right.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="S7.Ex440"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
