lse">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msup></mrow></msub></mtd></mtr></mtable><mo>)</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\boldsymbol{W}_{K,h,1}^{(prl)}:=\begin{pmatrix}\boldsymbol{W}_{K,h}^{(1)}&amp;\boldsymbol{0}_{S^{(1)}\times d^{(2)}}\end{pmatrix},\quad\boldsymbol{W}_{Q,h,1}^{(prl)}:=\begin{pmatrix}\boldsymbol{W}_{Q,h}^{(1)}&amp;\boldsymbol{0}_{S^{(1)}\times d^{(2)}}\end{pmatrix}.</annotation></semantics></math></td>
