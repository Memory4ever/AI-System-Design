p><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝑾</mi><mi>V</mi><mrow><mo stretchy="false">(</mo><mi>h</mi><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>𝒀</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>σ</mi><mi>S</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><msup><mi>𝒀</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝑾</mi><mi>K</mi><mrow><mrow><mo stretchy="false">(</mo><mi>h</mi><mo stretchy="false">)</mo></mrow><mo lspace="0.222em">⊤</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝑾</mi><mi>Q</mi><mrow><mo stretchy="false">(</mo><mi>h</mi><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>𝒀</mi></mrow><mo>)</mo></mrow></mrow></mrow><mo>‖</mo></mrow><mi>F</mi></msub></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\leq\sum_{h=1}^{H}\left\|\boldsymbol{\widetilde{W}}_{O}^{(h)}\boldsymbol{\widetilde{W}}_{V}^{(h)}\boldsymbol{Y}\sigma_{S}\left(\boldsymbol{Y}^{\top}\boldsymbol{\widetilde{W}}_{K}^{(h)\top}\boldsymbol{\widetilde{W}}_{Q}^{(h)}\boldsymbol{Y}\right)-\boldsymbol{{W}}_{O}^{(h)}\boldsymbol{{W}}_{V}^{(h)}\boldsymbol{Y}\sigma_{S}\left(\boldsymbol{Y}^{\top}\boldsymbol{{W}}_{K}^{(h)\top}\boldsymbol{{W}}_{Q}^{(h)}\boldsymbol{Y}\right)\right\|_{F}</annotation></semantics></math></td>
