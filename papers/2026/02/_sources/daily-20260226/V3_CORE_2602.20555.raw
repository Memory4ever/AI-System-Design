<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S6.Ex351.m1" class="ltx_math_unparsed" alttext="\displaystyle\leq 4\|f^{*}-f_{0}\|_{m}^{2}+\frac{32\sigma}{m^{(\gamma+d)/(2\gamma+d)}}\left(\int_{0}^{2^{7}\sigma m^{-\gamma/(2\gamma+d)}}\sqrt{\log 2\mathcal{N}(\varsigma,\mathcal{F},\|\cdot\|_{L^{\infty}(\mu)})^{2}}\,d\varsigma\right)^{2}+\frac{1}{16}\delta^{2}" display="inline" intent=":literal"><semantics><mrow><mo>≤</mo><mn>4</mn><mo lspace="0em" rspace="0.167em">∥</mo><msup><mi>f</mi><mo>∗</mo></msup><mo>−</mo><msub><mi>f</mi><mn>0</mn></msub><msubsup><mo lspace="0em" rspace="0em">∥</mo><mi>m</mi><mn>2</mn></msubsup><mo lspace="0em">+</mo><mstyle displaystyle="true"><mfrac><mrow><mn>32</mn><mo lspace="0em" rspace="0em">​</mo><mi>σ</mi></mrow><msup><mi>m</mi><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>γ</mi><mo>+</mo><mi>d</mi></mrow><mo stretchy="false">)</mo></mrow><mo>/</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>γ</mi></mrow><mo>+</mo><mi>d</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></msup></mfrac></mstyle><msup><mrow><mo>(</mo><mstyle displaystyle="true"><msubsup><mo>∫</mo><mn>0</mn><mrow><mn>2</mn><msup><mrow></mrow><mn>7</mn></msup><mi>σ</mi><mi>m</mi><msup><mrow></mrow><mrow><mo>−</mo><mi>γ</mi><mo>/</mo><mo stretchy="false">(</mo><mn>2</mn><mi>γ</mi><mo>+</mo><mi>d</mi><mo stretchy="false">)</mo></mrow></msup></mrow></msubsup></mstyle><msqrt><mrow><mi>log</mi><mn>2</mn><mi class="ltx_font_mathcaligraphic">𝒩</mi><mo stretchy="false">(</mo><mi>ς</mi><mo>,</mo><mi class="ltx_font_mathcaligraphic">ℱ</mi><mo>,</mo><mo lspace="0em" rspace="0em">∥</mo><mo lspace="0em" rspace="0em">⋅</mo><mo lspace="0em" rspace="0.167em">∥</mo><msub><mrow></mrow><mrow><msup><mi>L</mi><mi mathvariant="normal">∞</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>μ</mi><mo stretchy="false">)</mo></mrow></mrow></msub><mo stretchy="false">)</mo><msup><mrow></mrow><mn>2</mn></msup></mrow></msqrt><mi>d</mi><mi>ς</mi><mo>)</mo></mrow><mn>2</mn></msup><mo>+</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mn>16</mn></mfrac></mstyle><msup><mi>δ</mi><mn>2</mn></msup></mrow><annotation encoding="application/x-tex">\displaystyle\leq 4\|f^{*}-f_{0}\|_{m}^{2}+\frac{32\sigma}{m^{(\gamma+d)/(2\gamma+d)}}\left(\int_{0}^{2^{7}\sigma m^{-\gamma/(2\gamma+d)}}\sqrt{\log 2\mathcal{N}(\varsigma,\mathcal{F},\|\cdot\|_{L^{\infty}(\mu)})^{2}}\,d\varsigma\right)^{2}+\frac{1}{16}\delta^{2}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
