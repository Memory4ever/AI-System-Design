<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S7.Ex478.m1" class="ltx_math_unparsed" alttext="\displaystyle\quad\left.-\boldsymbol{\mathcal{\widetilde{F}}}_{FF}^{(K)}\circ\cdots\circ\boldsymbol{\mathcal{\widetilde{F}}}_{FF}^{(k)}\circ\boldsymbol{\mathcal{{F}}}_{SA}^{(k)}\circ\boldsymbol{\mathcal{{F}}}_{FF}^{(k-1)}\circ\cdots\circ\boldsymbol{\mathcal{{F}}}_{FF}^{(0)}\circ\boldsymbol{\mathcal{F}}_{EB}(\boldsymbol{X})\right\|_{F}" display="inline" intent=":literal"><semantics><msub><mrow><mo>−</mo><msubsup><mover accent="true"><mi class="ltx_font_mathcaligraphic">𝓕</mi><mo>~</mo></mover><mrow><mi>F</mi><mo lspace="0em" rspace="0em">​</mo><mi>F</mi></mrow><mrow><mo stretchy="false">(</mo><mi>K</mi><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0.222em">∘</mo><mo lspace="0.055em" rspace="0.055em">⋯</mo><mo rspace="0.222em">∘</mo><msubsup><mover accent="true"><mi class="ltx_font_mathcaligraphic">𝓕</mi><mo>~</mo></mover><mrow><mi>F</mi><mo lspace="0em" rspace="0em">​</mo><mi>F</mi></mrow><mrow><mo stretchy="false">(</mo><mi>k</mi><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0.222em" rspace="0.222em">∘</mo><msubsup><mi class="ltx_font_mathcaligraphic">𝓕</mi><mrow><mi>S</mi><mo lspace="0em" rspace="0em">​</mo><mi>A</mi></mrow><mrow><mo stretchy="false">(</mo><mi>k</mi><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0.222em" rspace="0.222em">∘</mo><msubsup><mi class="ltx_font_mathcaligraphic">𝓕</mi><mrow><mi>F</mi><mo lspace="0em" rspace="0em">​</mo><mi>F</mi></mrow><mrow><mo stretchy="false">(</mo><mrow><mi>k</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0.222em">∘</mo><mo lspace="0.055em" rspace="0.055em">⋯</mo><mo rspace="0.222em">∘</mo><msubsup><mi class="ltx_font_mathcaligraphic">𝓕</mi><mrow><mi>F</mi><mo lspace="0em" rspace="0em">​</mo><mi>F</mi></mrow><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0.222em" rspace="0.222em">∘</mo><msub><mi class="ltx_font_mathcaligraphic">𝓕</mi><mrow><mi>E</mi><mo lspace="0em" rspace="0em">​</mo><mi>B</mi></mrow></msub><mrow><mo stretchy="false">(</mo><mi>𝑿</mi><mo stretchy="false">)</mo></mrow><mo>‖</mo></mrow><mi>F</mi></msub><annotation encoding="application/x-tex">\displaystyle\quad\left.-\boldsymbol{\mathcal{\widetilde{F}}}_{FF}^{(K)}\circ\cdots\circ\boldsymbol{\mathcal{\widetilde{F}}}_{FF}^{(k)}\circ\boldsymbol{\mathcal{{F}}}_{SA}^{(k)}\circ\boldsymbol{\mathcal{{F}}}_{FF}^{(k-1)}\circ\cdots\circ\boldsymbol{\mathcal{{F}}}_{FF}^{(0)}\circ\boldsymbol{\mathcal{F}}_{EB}(\boldsymbol{X})\right\|_{F}</annotation></semantics></math></td>
