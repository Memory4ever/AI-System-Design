​</mo><msup><mi>𝒘</mi><mo>′</mo></msup></mrow></mrow><mo>|</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\geq P\left|\left(\boldsymbol{{\bar{x}}}^{(i)}-\boldsymbol{{\bar{x}}}^{(j)}\right)\boldsymbol{w}^{\prime}\right|-P\left|\left(\boldsymbol{{\bar{x}}}^{(i)}-\boldsymbol{{\bar{x}}}^{(j)}\right)\boldsymbol{w}^{\prime}-\left(\boldsymbol{\widetilde{\bar{x}}}^{(i)}-\boldsymbol{\widetilde{\bar{x}}}^{(j)}\right)\boldsymbol{w}^{\prime}\right|</annotation></semantics></math></td>
