\widetilde{\times}\left(c_{1,j}(f_{d1}),f_{1}^{(mnm)}\right)&amp;\widetilde{\times}\left(c_{1,j}(f_{d2}),f_{1}^{(mnm)}\right)&amp;\cdots&amp;\widetilde{\times}\left(c_{1,j}(f_{dn}),f_{1}^{(mnm)}\right)\\
\widetilde{\times}\left(c_{2,j}(f_{11}),f_{2}^{(mnm)}\right)&amp;\widetilde{\times}\left(c_{2,j}(f_{12}),f_{2}^{(mnm)}\right)&amp;\cdots&amp;\widetilde{\times}\left(c_{2,j}(f_{1n}),f_{2}^{(mnm)}\right)\\
