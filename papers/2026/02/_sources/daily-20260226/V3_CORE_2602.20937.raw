<figure id="S4.F4.fig1" class="ltx_figure ltx_figure_panel"><object type="image/svg+xml" data="2602.20937v1/Adamw_wo_mup_coord_check_v2_svg-raw.svg" id="S4.F4.g1" class="ltx_graphics ltx_centering ltx_img_landscape" style="aspect-ratio:285/87;" width="285" height="87"></object>
