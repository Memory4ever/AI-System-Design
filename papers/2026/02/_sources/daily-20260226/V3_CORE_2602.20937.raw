<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S4.Ex33.m1" class="ltx_math_unparsed" alttext="\displaystyle\quad\quad\quad\quad\quad\quad\quad\quad\quad\Theta(n_{l-1}^{-1/4})\left\|\left(\nabla_{\mathbf{h}_{l}}\mathcal{L}\cdot\nabla_{\mathbf{h}_{l}}\mathcal{L}^{\text{T}}\right)^{-1/4}\right\|_{*}\Theta(n_{l}^{1/4})\left\|\left(\mathbf{h}_{l-1}\cdot\mathbf{h}_{l-1}^{\text{T}}\right)^{-1/4}\right\|_{*}" display="inline" intent=":literal"><semantics><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000" mathvariant="normal">Θ</mi><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">(</mo><msubsup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">n</mi><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">l</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">−</mo><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">1</mn></mrow><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">−</mo><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">1</mn><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">/</mo><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">4</mn></mrow></msubsup><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">)</mo></mrow><msub><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">‖</mo><msup><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">(</mo><msub><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" rspace="0.167em">∇</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝐡</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">l</mi></msub></msub><mi style="--ltx-fg-color:#000000;" class="ltx_font_mathcaligraphic" mathcolor="#000000">ℒ</mi><mo style="--ltx-fg-color:#000000;" lspace="0.222em" mathcolor="#000000" rspace="0.222em">⋅</mo><msub><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" rspace="0.167em">∇</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝐡</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">l</mi></msub></msub><msup><mi style="--ltx-fg-color:#000000;" class="ltx_font_mathcaligraphic" mathcolor="#000000">ℒ</mi><mtext style="--ltx-fg-color:#000000;" mathcolor="#000000">T</mtext></msup><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">)</mo></mrow><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">−</mo><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">1</mn><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">/</mo><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">4</mn></mrow></msup><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">‖</mo></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">∗</mo></msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000" mathvariant="normal">Θ</mi><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">(</mo><msubsup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">n</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">l</mi><mrow><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">1</mn><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">/</mo><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">4</mn></mrow></msubsup><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">)</mo></mrow><msub><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">‖</mo><msup><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">(</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝐡</mi><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">l</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">−</mo><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">1</mn></mrow></msub><mo style="--ltx-fg-color:#000000;" lspace="0.222em" mathcolor="#000000" rspace="0.222em">⋅</mo><msubsup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝐡</mi><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">l</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">−</mo><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">1</mn></mrow><mtext style="--ltx-fg-color:#000000;" mathcolor="#000000">T</mtext></msubsup><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">)</mo></mrow><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">−</mo><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">1</mn><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">/</mo><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">4</mn></mrow></msup><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">‖</mo></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">∗</mo></msub></mrow><annotation encoding="application/x-tex">\displaystyle\quad\quad\quad\quad\quad\quad\quad\quad\quad\Theta(n_{l-1}^{-1/4})\left\|\left(\nabla_{\mathbf{h}_{l}}\mathcal{L}\cdot\nabla_{\mathbf{h}_{l}}\mathcal{L}^{\text{T}}\right)^{-1/4}\right\|_{*}\Theta(n_{l}^{1/4})\left\|\left(\mathbf{h}_{l-1}\cdot\mathbf{h}_{l-1}^{\text{T}}\right)^{-1/4}\right\|_{*}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="S4.Ex34"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
