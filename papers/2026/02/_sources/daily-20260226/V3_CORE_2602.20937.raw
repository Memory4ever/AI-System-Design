</figure></div></div>
</figure>
</section>
<section id="S4.SS4" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection" style="--ltx-fg-color:#000000;"><span class="ltx_tag ltx_tag_subsection">4.4 </span><math id="S4.SS4.m1" class="ltx_Math" alttext="\mu" display="inline" intent=":literal"><semantics><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">μ</mi><annotation encoding="application/x-tex">\mu</annotation></semantics></math>P for Sophia</h3>

<div id="S4.SS4.p1" class="ltx_para ltx_noindent">
<p id="S4.SS4.p1.1" class="ltx_p"><span id="S4.SS4.p1.1.1" class="ltx_text" style="--ltx-fg-color:#000000;">Recall the update rule for Sophia </span><cite class="ltx_cite ltx_citemacro_citep"><span id="S4.SS4.p1.1.2" class="ltx_text" style="--ltx-fg-color:#000000;">(</span><a href="#bib.bib17" title="" class="ltx_ref">Liu et al., 2023</a><span id="S4.SS4.p1.1.4" class="ltx_text" style="--ltx-fg-color:#000000;">)</span></cite><span id="S4.SS4.p1.1.5" class="ltx_text" style="--ltx-fg-color:#000000;">,</span></p>
<table id="S4.Ex19" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S4.Ex19.m1" class="ltx_Math" alttext="\mathbf{W}_{l}^{(t+1)}=\mathbf{W}_{l}^{(t)}-\eta^{(t+1)}\text{ clip }\left(\frac{\mathbf{m}^{(t)}}{\max{\{\gamma\mathbf{h}^{(t)},\epsilon\}}},1\right)-\eta^{(t)}\lambda\mathbf{W}_{l}^{(t)}" display="block" intent=":literal"><semantics><mrow><msubsup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝐖</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">l</mi><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">(</mo><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">+</mo><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">1</mn></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">)</mo></mrow></msubsup><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">=</mo><mrow><msubsup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝐖</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">l</mi><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">(</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">)</mo></mrow></msubsup><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">−</mo><mrow><msup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">η</mi><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">(</mo><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">+</mo><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">1</mn></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">)</mo></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mtext style="--ltx-fg-color:#000000;" mathcolor="#000000"> clip </mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">(</mo><mfrac style="--ltx-fg-color:#000000;" mathcolor="#000000"><msup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝐦</mi><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">(</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">)</mo></mrow></msup><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">max</mi><mo>⁡</mo><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">{</mo><mrow><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">γ</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝐡</mi><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">(</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">)</mo></mrow></msup></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">,</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">ϵ</mi></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">}</mo></mrow></mrow></mfrac><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">,</mo><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">1</mn><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">)</mo></mrow></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">−</mo><mrow><msup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">η</mi><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">(</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">)</mo></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">λ</mi><mo lspace="0em" rspace="0em">​</mo><msubsup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝐖</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">l</mi><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">(</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">)</mo></mrow></msubsup></mrow></mrow></mrow><annotation encoding="application/x-tex">\mathbf{W}_{l}^{(t+1)}=\mathbf{W}_{l}^{(t)}-\eta^{(t+1)}\text{ clip }\left(\frac{\mathbf{m}^{(t)}}{\max{\{\gamma\mathbf{h}^{(t)},\epsilon\}}},1\right)-\eta^{(t)}\lambda\mathbf{W}_{l}^{(t)}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(Sophia)</span></td></tr></tbody>
</table>
<p id="S4.SS4.p1.2" class="ltx_p"><span id="S4.SS4.p1.2.1" class="ltx_text" style="--ltx-fg-color:#000000;">where </span><math id="S4.SS4.p1.m1" class="ltx_Math" alttext="\mathbf{h}^{(t)}" display="inline" intent=":literal"><semantics><msup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝐡</mi><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">(</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">)</mo></mrow></msup><annotation encoding="application/x-tex">\mathbf{h}^{(t)}</annotation></semantics></math><span id="S4.SS4.p1.2.2" class="ltx_text" style="--ltx-fg-color:#000000;"> is a momentum-based estimate of the diagonal vector of the Hessian at time </span><math id="S4.SS4.p1.m2" class="ltx_Math" alttext="t" display="inline" intent=":literal"><semantics><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi><annotation encoding="application/x-tex">t</annotation></semantics></math><span id="S4.SS4.p1.2.3" class="ltx_text" style="--ltx-fg-color:#000000;">. From the spectral scaling condition in (</span><a href="#S4.E5" title="In 4.1 Generic Framework ‣ 4 Deriving 𝜇P using Spectral Scaling Conditions ‣ Extending 𝜇P: Spectral Conditions for Feature Learning Across Optimizers" class="ltx_ref" style="--ltx-fg-color:#000000;"><span class="ltx_text ltx_ref_tag">5</span></a><span id="S4.SS4.p1.2.4" class="ltx_text" style="--ltx-fg-color:#000000;">), we need to find </span><math id="S4.SS4.p1.m3" class="ltx_Math" alttext="c_{1},c_{2}\in\real" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">c</mi><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">1</mn></msub><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">,</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">c</mi><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">2</mn></msub></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">∈</mo><mphantom></mphantom></mrow><annotation encoding="application/x-tex">c_{1},c_{2}\in\real</annotation></semantics></math><span id="S4.SS4.p1.2.5" class="ltx_text" style="--ltx-fg-color:#000000;"> such that</span></p>
<table id="S4.EGx7" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="S4.Ex20"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S4.Ex20.m1" class="ltx_Math" alttext="\displaystyle||\Delta\mathbf{W}_{l}||_{*}=\eta(n_{l})^{-c_{1}}(n_{l-1})^{-c_{2}}\left\|\text{ clip }\left(\frac{\mathbf{m}^{(t)}}{\max{\{\gamma\mathbf{h}^{(t)},\epsilon\}}},1\right)-\lambda\mathbf{W}_{l}^{(t)}\right\|_{*}=\Theta\left(\sqrt{\frac{n_{l}}{n_{l-1}}}\right)." display="inline" intent=":literal"><semantics><mrow><mrow><msub><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">‖</mo><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000" mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝐖</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">l</mi></msub></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">‖</mo></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">∗</mo></msub><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">=</mo><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">η</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">(</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">n</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">l</mi></msub><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">)</mo></mrow><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">−</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">c</mi><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">1</mn></msub></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">(</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">n</mi><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">l</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">−</mo><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">1</mn></mrow></msub><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">)</mo></mrow><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">−</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">c</mi><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">2</mn></msub></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">‖</mo><mrow><mrow><mtext style="--ltx-fg-color:#000000;" mathcolor="#000000"> clip </mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">(</mo><mstyle displaystyle="true"><mfrac style="--ltx-fg-color:#000000;" mathcolor="#000000"><msup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝐦</mi><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">(</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">)</mo></mrow></msup><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">max</mi><mo>⁡</mo><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">{</mo><mrow><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">γ</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝐡</mi><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">(</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">)</mo></mrow></msup></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">,</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">ϵ</mi></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">}</mo></mrow></mrow></mfrac></mstyle><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">,</mo><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">1</mn><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">)</mo></mrow></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">−</mo><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">λ</mi><mo lspace="0em" rspace="0em">​</mo><msubsup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝐖</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">l</mi><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">(</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">)</mo></mrow></msubsup></mrow></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">‖</mo></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">∗</mo></msub></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">=</mo><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000" mathvariant="normal">Θ</mi><mo>⁡</mo><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">(</mo><msqrt style="--ltx-fg-color:#000000;" mathcolor="#000000"><mstyle displaystyle="true"><mfrac style="--ltx-fg-color:#000000;" mathcolor="#000000"><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">n</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">l</mi></msub><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">n</mi><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">l</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">−</mo><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">1</mn></mrow></msub></mfrac></mstyle></msqrt><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">)</mo></mrow></mrow></mrow><mo style="--ltx-fg-color:#000000;" lspace="0em" mathcolor="#000000">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle||\Delta\mathbf{W}_{l}||_{*}=\eta(n_{l})^{-c_{1}}(n_{l-1})^{-c_{2}}\left\|\text{ clip }\left(\frac{\mathbf{m}^{(t)}}{\max{\{\gamma\mathbf{h}^{(t)},\epsilon\}}},1\right)-\lambda\mathbf{W}_{l}^{(t)}\right\|_{*}=\Theta\left(\sqrt{\frac{n_{l}}{n_{l-1}}}\right).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S4.SS4.p1.3" class="ltx_p"><span id="S4.SS4.p1.3.1" class="ltx_text" style="--ltx-fg-color:#000000;">For analysis, we consider </span><math id="S4.SS4.p1.m4" class="ltx_Math" alttext="\beta_{1}=\beta_{2}=\epsilon=0" display="inline" intent=":literal"><semantics><mrow><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">β</mi><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">1</mn></msub><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">=</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">β</mi><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">2</mn></msub><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">=</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">ϵ</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">=</mo><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">0</mn></mrow><annotation encoding="application/x-tex">\beta_{1}=\beta_{2}=\epsilon=0</annotation></semantics></math><span id="S4.SS4.p1.3.2" class="ltx_text" style="--ltx-fg-color:#000000;">, and since the weight decay term is usually very small, the above weight update simplifies to</span></p>
<table id="S4.EGx8" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="S4.Ex21"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S4.Ex21.m1" class="ltx_Math" alttext="\displaystyle||\Delta\mathbf{W}_{l}||_{*}" display="inline" intent=":literal"><semantics><msub><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">‖</mo><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000" mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝐖</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">l</mi></msub></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">‖</mo></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">∗</mo></msub><annotation encoding="application/x-tex">\displaystyle||\Delta\mathbf{W}_{l}||_{*}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S4.Ex21.m2" class="ltx_Math" alttext="\displaystyle=\eta(n_{l})^{-c_{1}}(n_{l-1})^{-c_{2}}\left\|\text{ clip }\left(\frac{\nabla_{\mathbf{W}_{l}}\mathcal{L}}{\gamma\nabla^{2}_{\mathbf{W}_{l}}\mathcal{L}},1\right)\right\|_{*}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">=</mo><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">η</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">(</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">n</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">l</mi></msub><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">)</mo></mrow><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">−</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">c</mi><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">1</mn></msub></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">(</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">n</mi><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">l</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">−</mo><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">1</mn></mrow></msub><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">)</mo></mrow><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">−</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">c</mi><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">2</mn></msub></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">‖</mo><mrow><mtext style="--ltx-fg-color:#000000;" mathcolor="#000000"> clip </mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">(</mo><mstyle displaystyle="true"><mfrac style="--ltx-fg-color:#000000;" mathcolor="#000000"><mrow><msub><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">∇</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝐖</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">l</mi></msub></msub><mi style="--ltx-fg-color:#000000;" class="ltx_font_mathcaligraphic" mathcolor="#000000">ℒ</mi></mrow><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">γ</mi><mo lspace="0.167em" rspace="0em">​</mo><msubsup><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">∇</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝐖</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">l</mi></msub><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">2</mn></msubsup><mo lspace="0.167em" rspace="0em">​</mo><mi style="--ltx-fg-color:#000000;" class="ltx_font_mathcaligraphic" mathcolor="#000000">ℒ</mi></mrow></mfrac></mstyle><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">,</mo><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">1</mn><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">)</mo></mrow></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">‖</mo></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">∗</mo></msub></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\eta(n_{l})^{-c_{1}}(n_{l-1})^{-c_{2}}\left\|\text{ clip }\left(\frac{\nabla_{\mathbf{W}_{l}}\mathcal{L}}{\gamma\nabla^{2}_{\mathbf{W}_{l}}\mathcal{L}},1\right)\right\|_{*}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="S4.Ex22"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S4.Ex22.m1" class="ltx_Math" alttext="\displaystyle\approx\eta(n_{l})^{-c_{1}}(n_{l-1})^{-c_{2}}\left\|\text{ clip }\left(\frac{\nabla_{\mathbf{W}_{l}}\mathcal{L}}{\gamma|\nabla^{2}_{\mathbf{W}_{l}}\mathcal{L}|},1\right)\right\|_{\text{F}}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">≈</mo><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">η</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">(</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">n</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">l</mi></msub><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">)</mo></mrow><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">−</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">c</mi><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">1</mn></msub></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">(</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">n</mi><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">l</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">−</mo><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">1</mn></mrow></msub><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">)</mo></mrow><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">−</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">c</mi><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">2</mn></msub></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">‖</mo><mrow><mtext style="--ltx-fg-color:#000000;" mathcolor="#000000"> clip </mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">(</mo><mstyle displaystyle="true"><mfrac style="--ltx-fg-color:#000000;" mathcolor="#000000"><mrow><msub><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">∇</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝐖</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">l</mi></msub></msub><mi style="--ltx-fg-color:#000000;" class="ltx_font_mathcaligraphic" mathcolor="#000000">ℒ</mi></mrow><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">γ</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">|</mo><mrow><msubsup><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">∇</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝐖</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">l</mi></msub><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">2</mn></msubsup><mo lspace="0.167em" rspace="0em">​</mo><mi style="--ltx-fg-color:#000000;" class="ltx_font_mathcaligraphic" mathcolor="#000000">ℒ</mi></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">|</mo></mrow></mrow></mfrac></mstyle><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">,</mo><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">1</mn><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">)</mo></mrow></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">‖</mo></mrow><mtext style="--ltx-fg-color:#000000;" mathcolor="#000000">F</mtext></msub></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\approx\eta(n_{l})^{-c_{1}}(n_{l-1})^{-c_{2}}\left\|\text{ clip }\left(\frac{\nabla_{\mathbf{W}_{l}}\mathcal{L}}{\gamma|\nabla^{2}_{\mathbf{W}_{l}}\mathcal{L}|},1\right)\right\|_{\text{F}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S4.SS4.p1.4" class="ltx_p"><span id="S4.SS4.p1.4.1" class="ltx_text" style="--ltx-fg-color:#000000;">where we take the modulus in the denominator because Sophia avoids negative diagonal terms in the Hessian (thereby avoiding convergence to a saddle point; see discussion in </span><cite class="ltx_cite ltx_citemacro_citep"><span id="S4.SS4.p1.4.2" class="ltx_text" style="--ltx-fg-color:#000000;">(</span><a href="#bib.bib17" title="" class="ltx_ref">Liu et al., 2023</a><span id="S4.SS4.p1.4.4" class="ltx_text" style="--ltx-fg-color:#000000;">, pg. 6)</span></cite><span id="S4.SS4.p1.4.5" class="ltx_text" style="--ltx-fg-color:#000000;">).
Observe that the clip</span><math id="S4.SS4.p1.m5" class="ltx_Math" alttext="(\cdot,1)" display="inline" intent=":literal"><semantics><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">(</mo><mo style="--ltx-fg-color:#000000;" lspace="0em" mathcolor="#000000" rspace="0em">⋅</mo><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">,</mo><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">1</mn><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(\cdot,1)</annotation></semantics></math><span id="S4.SS4.p1.4.6" class="ltx_text" style="--ltx-fg-color:#000000;"> bounds the coordinate-wise weight updates as, </span><math id="S4.SS4.p1.m6" class="ltx_Math" alttext="|[\Delta\mathbf{W}_{l}]_{\text{i, j}}|\leq 1" display="inline" intent=":literal"><semantics><mrow><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">|</mo><msub><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">[</mo><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000" mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝐖</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">l</mi></msub></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">]</mo></mrow><mtext style="--ltx-fg-color:#000000;" mathcolor="#000000">i, j</mtext></msub><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">|</mo></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">≤</mo><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">1</mn></mrow><annotation encoding="application/x-tex">|[\Delta\mathbf{W}_{l}]_{\text{i, j}}|\leq 1</annotation></semantics></math><span id="S4.SS4.p1.4.7" class="ltx_text" style="--ltx-fg-color:#000000;">. Therefore, we can compute an upper bound for the Frobenius norm and get</span></p>
<table id="S4.EGx9" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="S4.Ex23"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S4.Ex23.m1" class="ltx_Math" alttext="\displaystyle||\Delta\mathbf{W}_{l}||_{*}" display="inline" intent=":literal"><semantics><msub><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">‖</mo><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000" mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝐖</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">l</mi></msub></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">‖</mo></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">∗</mo></msub><annotation encoding="application/x-tex">\displaystyle||\Delta\mathbf{W}_{l}||_{*}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S4.Ex23.m2" class="ltx_Math" alttext="\displaystyle\leq\eta(n_{l})^{-c_{1}}(n_{l-1})^{-c_{2}}\frac{1}{\gamma}\Theta(\sqrt{n_{l}n_{l-1}})." display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">≤</mo><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">η</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">(</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">n</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">l</mi></msub><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">)</mo></mrow><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">−</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">c</mi><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">1</mn></msub></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">(</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">n</mi><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">l</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">−</mo><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">1</mn></mrow></msub><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">)</mo></mrow><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">−</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">c</mi><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">2</mn></msub></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac style="--ltx-fg-color:#000000;" mathcolor="#000000"><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">1</mn><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">γ</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000" mathvariant="normal">Θ</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">(</mo><msqrt style="--ltx-fg-color:#000000;" mathcolor="#000000"><mrow><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">n</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">l</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">n</mi><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">l</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">−</mo><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">1</mn></mrow></msub></mrow></msqrt><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">)</mo></mrow></mrow></mrow><mo style="--ltx-fg-color:#000000;" lspace="0em" mathcolor="#000000">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\leq\eta(n_{l})^{-c_{1}}(n_{l-1})^{-c_{2}}\frac{1}{\gamma}\Theta(\sqrt{n_{l}n_{l-1}}).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S4.SS4.p1.5" class="ltx_p"><span id="S4.SS4.p1.5.1" class="ltx_text" style="--ltx-fg-color:#000000;">Then, eq. (</span><a href="#S4.E5" title="In 4.1 Generic Framework ‣ 4 Deriving 𝜇P using Spectral Scaling Conditions ‣ Extending 𝜇P: Spectral Conditions for Feature Learning Across Optimizers" class="ltx_ref" style="--ltx-fg-color:#000000;"><span class="ltx_text ltx_ref_tag">5</span></a><span id="S4.SS4.p1.5.2" class="ltx_text" style="--ltx-fg-color:#000000;">) is satisfied by fixing </span><math id="S4.SS4.p1.m7" class="ltx_Math" alttext="c_{1}=0" display="inline" intent=":literal"><semantics><mrow><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">c</mi><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">1</mn></msub><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">=</mo><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">0</mn></mrow><annotation encoding="application/x-tex">c_{1}=0</annotation></semantics></math><span id="S4.SS4.p1.5.3" class="ltx_text" style="--ltx-fg-color:#000000;"> and </span><math id="S4.SS4.p1.m8" class="ltx_Math" alttext="c_{2}=1" display="inline" intent=":literal"><semantics><mrow><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">c</mi><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">2</mn></msub><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">=</mo><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">1</mn></mrow><annotation encoding="application/x-tex">c_{2}=1</annotation></semantics></math><span id="S4.SS4.p1.5.4" class="ltx_text" style="--ltx-fg-color:#000000;">, resulting in the same </span><math id="S4.SS4.p1.m9" class="ltx_Math" alttext="\mu" display="inline" intent=":literal"><semantics><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">μ</mi><annotation encoding="application/x-tex">\mu</annotation></semantics></math><span id="S4.SS4.p1.5.5" class="ltx_text" style="--ltx-fg-color:#000000;">P scaling as AdamW.
Note that the momentum terms </span><math id="S4.SS4.p1.m10" class="ltx_Math" alttext="\beta_{1}" display="inline" intent=":literal"><semantics><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">β</mi><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">1</mn></msub><annotation encoding="application/x-tex">\beta_{1}</annotation></semantics></math><span id="S4.SS4.p1.5.6" class="ltx_text" style="--ltx-fg-color:#000000;"> and </span><math id="S4.SS4.p1.m11" class="ltx_Math" alttext="\beta_{2}" display="inline" intent=":literal"><semantics><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">β</mi><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">2</mn></msub><annotation encoding="application/x-tex">\beta_{2}</annotation></semantics></math><span id="S4.SS4.p1.5.7" class="ltx_text" style="--ltx-fg-color:#000000;"> do not require any additional scaling because they have </span><math id="S4.SS4.p1.m12" class="ltx_Math" alttext="\Theta(1)" display="inline" intent=":literal"><semantics><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000" mathvariant="normal">Θ</mi><mo>⁡</mo><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">(</mo><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">1</mn><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\Theta(1)</annotation></semantics></math><span id="S4.SS4.p1.5.8" class="ltx_text" style="--ltx-fg-color:#000000;">, width-indepedent order of magnitude, where as the HPs </span><math id="S4.SS4.p1.m13" class="ltx_Math" alttext="\lambda" display="inline" intent=":literal"><semantics><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">λ</mi><annotation encoding="application/x-tex">\lambda</annotation></semantics></math><span id="S4.SS4.p1.5.9" class="ltx_text" style="--ltx-fg-color:#000000;"> and </span><math id="S4.SS4.p1.m14" class="ltx_Math" alttext="\epsilon" display="inline" intent=":literal"><semantics><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">ϵ</mi><annotation encoding="application/x-tex">\epsilon</annotation></semantics></math><span id="S4.SS4.p1.5.10" class="ltx_text" style="--ltx-fg-color:#000000;"> follow the same scaling as the HPs of AdamW because Sophia and AdamW have the same </span><math id="S4.SS4.p1.m15" class="ltx_Math" alttext="\mu" display="inline" intent=":literal"><semantics><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">μ</mi><annotation encoding="application/x-tex">\mu</annotation></semantics></math><span id="S4.SS4.p1.5.11" class="ltx_text" style="--ltx-fg-color:#000000;">P scaling.</span></p>
</div>
<div id="Thminsight2" class="ltx_theorem ltx_theorem_insight">
<h6 class="ltx_title ltx_runin ltx_title_theorem" style="--ltx-fg-color:#000000;"><span class="ltx_tag ltx_tag_theorem"><span id="Thminsight2.2" class="ltx_text ltx_font_bold">Insight 2</span></span></h6>
<div id="Thminsight2.p1" class="ltx_para ltx_noindent">
<p id="Thminsight2.p1.1" class="ltx_p"><span id="Thminsight2.p1.1.1" class="ltx_text ltx_font_italic" style="--ltx-fg-color:#000000;">We provide an intuitive explanation for this result.  Sophia uses signSGD as the default method to handle negative Hessian terms (to avoid convergence to a saddle point), thereby mirroring the analysis for AdamW for such cases.
Additionally, when <math id="Thminsight2.p1.m1" class="ltx_Math" alttext="\gamma=1" display="inline" intent=":literal"><semantics><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">γ</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">=</mo><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">1</mn></mrow><annotation encoding="application/x-tex">\gamma=1</annotation></semantics></math>, all the elements in the weight update are clipped to <math id="Thminsight2.p1.m2" class="ltx_Math" alttext="1" display="inline" intent=":literal"><semantics><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">1</mn><annotation encoding="application/x-tex">1</annotation></semantics></math>, and the upper bound holds exactly. Thus, we get the same scaling as AdamW.</span></p>
</div>
<div id="Thminsight2.p2" class="ltx_para">
<p id="Thminsight2.p2.1" class="ltx_p"><span id="Thminsight2.p2.1.1" class="ltx_text ltx_font_italic" style="--ltx-fg-color:#000000;">In practice, the authors suggest to choose <math id="Thminsight2.p2.m1" class="ltx_Math" alttext="\gamma" display="inline" intent=":literal"><semantics><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">γ</mi><annotation encoding="application/x-tex">\gamma</annotation></semantics></math> such that <math id="Thminsight2.p2.m2" class="ltx_Math" alttext="10\%-50\%" display="inline" intent=":literal"><semantics><mrow><mrow><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">10</mn><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">%</mo></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">−</mo><mrow><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">50</mn><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">%</mo></mrow></mrow><annotation encoding="application/x-tex">10\%-50\%</annotation></semantics></math> of the parameters are not clipped. Therefore, for each term which is not clipped, the above bound incurs an error of less than <math id="Thminsight2.p2.m3" class="ltx_Math" alttext="1" display="inline" intent=":literal"><semantics><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">1</mn><annotation encoding="application/x-tex">1</annotation></semantics></math>. However, as demonstrated in our simulations (Fig. <a href="#S4.F2" title="Figure 2 ‣ 4.1 Generic Framework ‣ 4 Deriving 𝜇P using Spectral Scaling Conditions ‣ Extending 𝜇P: Spectral Conditions for Feature Learning Across Optimizers" class="ltx_ref"><span class="ltx_text ltx_ref_tag">2</span></a>), for the typical values of <math id="Thminsight2.p2.m4" class="ltx_Math" alttext="\gamma" display="inline" intent=":literal"><semantics><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">γ</mi><annotation encoding="application/x-tex">\gamma</annotation></semantics></math> used in practice, the <math id="Thminsight2.p2.m5" class="ltx_Math" alttext="\mu" display="inline" intent=":literal"><semantics><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">μ</mi><annotation encoding="application/x-tex">\mu</annotation></semantics></math>P scaling derived based on the above calculation works well.</span></p>
</div>
</div>
<div id="S4.SS4.p2" class="ltx_para ltx_noindent">
<p id="S4.SS4.p2.1" class="ltx_p"><span id="S4.SS4.p2.1.1" class="ltx_text" style="--ltx-fg-color:#000000;">Fig. </span><a href="#S1.F1" title="Figure 1 ‣ 1 Introduction ‣ Extending 𝜇P: Spectral Conditions for Feature Learning Across Optimizers" class="ltx_ref" style="--ltx-fg-color:#000000;"><span class="ltx_text ltx_ref_tag">1</span></a><span id="S4.SS4.p2.1.2" class="ltx_text" style="--ltx-fg-color:#000000;"> further validates the </span><math id="S4.SS4.p2.m1" class="ltx_Math" alttext="\mu" display="inline" intent=":literal"><semantics><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">μ</mi><annotation encoding="application/x-tex">\mu</annotation></semantics></math><span id="S4.SS4.p2.1.3" class="ltx_text" style="--ltx-fg-color:#000000;">P derivation for Sophia via stable coordinate check plots (Fig. </span><a href="#S1.F1" title="Figure 1 ‣ 1 Introduction ‣ Extending 𝜇P: Spectral Conditions for Feature Learning Across Optimizers" class="ltx_ref" style="--ltx-fg-color:#000000;"><span class="ltx_text ltx_ref_tag">1</span></a><span id="S4.SS4.p2.1.4" class="ltx_text" style="--ltx-fg-color:#000000;"> (left)) and a consistently improving training loss across model widths (Fig. </span><a href="#S1.F1" title="Figure 1 ‣ 1 Introduction ‣ Extending 𝜇P: Spectral Conditions for Feature Learning Across Optimizers" class="ltx_ref" style="--ltx-fg-color:#000000;"><span class="ltx_text ltx_ref_tag">1</span></a><span id="S4.SS4.p2.1.5" class="ltx_text" style="--ltx-fg-color:#000000;"> (right)).</span></p>
</div>
</section>
<section id="S4.SS5" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection" style="--ltx-fg-color:#000000;"><span class="ltx_tag ltx_tag_subsection">4.5 </span><math id="S4.SS5.m1" class="ltx_Math" alttext="\mu" display="inline" intent=":literal"><semantics><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">μ</mi><annotation encoding="application/x-tex">\mu</annotation></semantics></math>P for Shampoo</h3>

<div id="S4.SS5.p1" class="ltx_para ltx_noindent">
<p id="S4.SS5.p1.1" class="ltx_p"><span id="S4.SS5.p1.1.1" class="ltx_text" style="--ltx-fg-color:#000000;">Recall the update rule for Shampoo </span><cite class="ltx_cite ltx_citemacro_citep"><span id="S4.SS5.p1.1.2" class="ltx_text" style="--ltx-fg-color:#000000;">(</span><a href="#bib.bib13" title="" class="ltx_ref">Gupta et al., 2018</a><span id="S4.SS5.p1.1.4" class="ltx_text" style="--ltx-fg-color:#000000;">)</span></cite><span id="S4.SS5.p1.1.5" class="ltx_text" style="--ltx-fg-color:#000000;">,</span></p>
<table id="S4.Ex24" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S4.Ex24.m1" class="ltx_math_unparsed" alttext="\mathbf{W}_{l}^{(t+1)}=\mathbf{W}_{l}^{(t)}-\eta^{(t+1)}\left(\mathbf{L}_{l}^{(t)}\right)^{-1/4}\nabla_{\mathbf{W}_{l}}\mathcal{L}\left(\mathbf{R}_{l}^{(t)}\right)^{-1/4}" display="block" intent=":literal"><semantics><mrow><msubsup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝐖</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">l</mi><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">(</mo><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">+</mo><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">1</mn></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">)</mo></mrow></msubsup><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">=</mo><msubsup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝐖</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">l</mi><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">(</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">)</mo></mrow></msubsup><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">−</mo><msup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">η</mi><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">(</mo><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">+</mo><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">1</mn></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">)</mo></mrow></msup><msup><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">(</mo><msubsup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝐋</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">l</mi><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">(</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">)</mo></mrow></msubsup><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" rspace="0.167em">)</mo></mrow><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">−</mo><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">1</mn><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">/</mo><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">4</mn></mrow></msup><msub><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" rspace="0.167em">∇</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝐖</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">l</mi></msub></msub><mi style="--ltx-fg-color:#000000;" class="ltx_font_mathcaligraphic" mathcolor="#000000">ℒ</mi><msup><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">(</mo><msubsup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝐑</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">l</mi><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">(</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">)</mo></mrow></msubsup><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">)</mo></mrow><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">−</mo><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">1</mn><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">/</mo><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">4</mn></mrow></msup></mrow><annotation encoding="application/x-tex">\mathbf{W}_{l}^{(t+1)}=\mathbf{W}_{l}^{(t)}-\eta^{(t+1)}\left(\mathbf{L}_{l}^{(t)}\right)^{-1/4}\nabla_{\mathbf{W}_{l}}\mathcal{L}\left(\mathbf{R}_{l}^{(t)}\right)^{-1/4}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(Shampoo)</span></td></tr></tbody>
</table>
<table id="S4.EGx10" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="S4.Ex25"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S4.Ex25.m1" class="ltx_Math" alttext="\displaystyle\text{where for some }\delta&gt;0,\quad\mathbf{L}_{l}^{(t)}" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mtext style="--ltx-fg-color:#000000;" mathcolor="#000000">where for some </mtext><mo lspace="0em" rspace="0em">​</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">δ</mi></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">&gt;</mo><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">0</mn></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" rspace="1.167em">,</mo><msubsup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝐋</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">l</mi><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">(</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">)</mo></mrow></msubsup></mrow><annotation encoding="application/x-tex">\displaystyle\text{where for some }\delta&gt;0,\quad\mathbf{L}_{l}^{(t)}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S4.Ex25.m2" class="ltx_math_unparsed" alttext="\displaystyle=\mathbf{L}_{l}^{(t-1)}+\nabla_{\mathbf{W}_{l}}\mathcal{L}\cdot\nabla_{\mathbf{W}_{l}}\mathcal{L}^{\text{T}}\quad;\quad\mathbf{L}_{l}^{(0)}=\delta\mathbf{I}\in\real^{n_{l}\times n_{l}}" display="inline" intent=":literal"><semantics><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">=</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝐋</mi><msub><mrow></mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">l</mi></msub><msup><mrow></mrow><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">(</mo><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">−</mo><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">1</mn></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">)</mo></mrow></msup><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">+</mo><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" rspace="0.167em">∇</mo><msub><mrow></mrow><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝐖</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">l</mi></msub></msub><mi style="--ltx-fg-color:#000000;" class="ltx_font_mathcaligraphic" mathcolor="#000000">ℒ</mi><mo style="--ltx-fg-color:#000000;" lspace="0.222em" mathcolor="#000000" rspace="0.222em">⋅</mo><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" rspace="0.167em">∇</mo><msub><mrow></mrow><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝐖</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">l</mi></msub></msub><mi style="--ltx-fg-color:#000000;" class="ltx_font_mathcaligraphic" mathcolor="#000000">ℒ</mi><msup><mrow></mrow><mtext style="--ltx-fg-color:#000000;" mathcolor="#000000">T</mtext></msup><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" rspace="1.167em">;</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝐋</mi><msub><mrow></mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">l</mi></msub><msup><mrow></mrow><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">(</mo><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">0</mn><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">)</mo></mrow></msup><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">=</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">δ</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝐈</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">∈</mo><msup><mrow></mrow><mrow><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">n</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">l</mi></msub><mo style="--ltx-fg-color:#000000;" lspace="0.222em" mathcolor="#000000" rspace="0.222em">×</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">n</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">l</mi></msub></mrow></msup></mrow><annotation encoding="application/x-tex">\displaystyle=\mathbf{L}_{l}^{(t-1)}+\nabla_{\mathbf{W}_{l}}\mathcal{L}\cdot\nabla_{\mathbf{W}_{l}}\mathcal{L}^{\text{T}}\quad;\quad\mathbf{L}_{l}^{(0)}=\delta\mathbf{I}\in\real^{n_{l}\times n_{l}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="S4.Ex26"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S4.Ex26.m1" class="ltx_Math" alttext="\displaystyle\quad\mathbf{R}_{l}^{(t)}" display="inline" intent=":literal"><semantics><msubsup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝐑</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">l</mi><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">(</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">)</mo></mrow></msubsup><annotation encoding="application/x-tex">\displaystyle\quad\mathbf{R}_{l}^{(t)}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S4.Ex26.m2" class="ltx_math_unparsed" alttext="\displaystyle=\mathbf{R}_{l}^{(t-1)}+\nabla_{\mathbf{W}_{l}}\mathcal{L}^{\text{T}}\cdot\nabla_{\mathbf{W}_{l}}\mathcal{L}\quad;\quad\mathbf{R}_{l}^{(0)}=\delta\mathbf{I}\in\real^{n_{l-1}\times n_{l-1}}" display="inline" intent=":literal"><semantics><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">=</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝐑</mi><msub><mrow></mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">l</mi></msub><msup><mrow></mrow><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">(</mo><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">−</mo><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">1</mn></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">)</mo></mrow></msup><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">+</mo><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" rspace="0.167em">∇</mo><msub><mrow></mrow><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝐖</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">l</mi></msub></msub><mi style="--ltx-fg-color:#000000;" class="ltx_font_mathcaligraphic" mathcolor="#000000">ℒ</mi><msup><mrow></mrow><mtext style="--ltx-fg-color:#000000;" mathcolor="#000000">T</mtext></msup><mo style="--ltx-fg-color:#000000;" lspace="0.222em" mathcolor="#000000" rspace="0.222em">⋅</mo><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" rspace="0.167em">∇</mo><msub><mrow></mrow><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝐖</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">l</mi></msub></msub><mi style="--ltx-fg-color:#000000;" class="ltx_font_mathcaligraphic" mathcolor="#000000">ℒ</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" rspace="1.167em">;</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝐑</mi><msub><mrow></mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">l</mi></msub><msup><mrow></mrow><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">(</mo><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">0</mn><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">)</mo></mrow></msup><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">=</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">δ</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝐈</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">∈</mo><msup><mrow></mrow><mrow><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">n</mi><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">l</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">−</mo><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">1</mn></mrow></msub><mo style="--ltx-fg-color:#000000;" lspace="0.222em" mathcolor="#000000" rspace="0.222em">×</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">n</mi><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">l</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">−</mo><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">1</mn></mrow></msub></mrow></msup></mrow><annotation encoding="application/x-tex">\displaystyle=\mathbf{R}_{l}^{(t-1)}+\nabla_{\mathbf{W}_{l}}\mathcal{L}^{\text{T}}\cdot\nabla_{\mathbf{W}_{l}}\mathcal{L}\quad;\quad\mathbf{R}_{l}^{(0)}=\delta\mathbf{I}\in\real^{n_{l-1}\times n_{l-1}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S4.SS5.p1.2" class="ltx_p"><span id="S4.SS5.p1.2.1" class="ltx_text" style="--ltx-fg-color:#000000;">From the spectral scaling condition in (</span><a href="#S4.E5" title="In 4.1 Generic Framework ‣ 4 Deriving 𝜇P using Spectral Scaling Conditions ‣ Extending 𝜇P: Spectral Conditions for Feature Learning Across Optimizers" class="ltx_ref" style="--ltx-fg-color:#000000;"><span class="ltx_text ltx_ref_tag">5</span></a><span id="S4.SS5.p1.2.2" class="ltx_text" style="--ltx-fg-color:#000000;">), we need to find </span><math id="S4.SS5.p1.m1" class="ltx_Math" alttext="c_{1},c_{2}\in\real" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">c</mi><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">1</mn></msub><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">,</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">c</mi><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">2</mn></msub></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">∈</mo><mphantom></mphantom></mrow><annotation encoding="application/x-tex">c_{1},c_{2}\in\real</annotation></semantics></math><span id="S4.SS5.p1.2.3" class="ltx_text" style="--ltx-fg-color:#000000;"> such that</span></p>
<table id="S4.EGx11" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="S4.Ex27"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S4.Ex27.m1" class="ltx_math_unparsed" alttext="\displaystyle||\Delta\mathbf{W}_{l}||_{*}=\eta(n_{l})^{-c_{1}}(n_{l-1})^{-c_{2}}\left\|\left(\mathbf{L}_{l}^{(t)}\right)^{-1/4}\nabla_{\mathbf{W}_{l}}\mathcal{L}\left(\mathbf{R}_{l}^{(t)}\right)^{-1/4}\right\|_{*}=\Theta\left(\sqrt{\frac{n_{l}}{n_{l-1}}}\right)." display="inline" intent=":literal"><semantics><mrow><mo style="--ltx-fg-color:#000000;" fence="false" mathcolor="#000000" rspace="0.167em" stretchy="false">|</mo><mo style="--ltx-fg-color:#000000;" fence="false" mathcolor="#000000" rspace="0.167em" stretchy="false">|</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000" mathvariant="normal">Δ</mi><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝐖</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">l</mi></msub><mo style="--ltx-fg-color:#000000;" fence="false" mathcolor="#000000" rspace="0.167em" stretchy="false">|</mo><msub><mo style="--ltx-fg-color:#000000;" fence="false" mathcolor="#000000" stretchy="false">|</mo><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">∗</mo></msub><mo style="--ltx-fg-color:#000000;" lspace="0.167em" mathcolor="#000000">=</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">η</mi><msup><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">(</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">n</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">l</mi></msub><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">)</mo></mrow><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">−</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">c</mi><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">1</mn></msub></mrow></msup><msup><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">(</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">n</mi><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">l</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">−</mo><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">1</mn></mrow></msub><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">)</mo></mrow><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">−</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">c</mi><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">2</mn></msub></mrow></msup><msub><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">‖</mo><msup><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">(</mo><msubsup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝐋</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">l</mi><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">(</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">)</mo></mrow></msubsup><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" rspace="0.167em">)</mo></mrow><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">−</mo><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">1</mn><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">/</mo><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">4</mn></mrow></msup><msub><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" rspace="0.167em">∇</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝐖</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">l</mi></msub></msub><mi style="--ltx-fg-color:#000000;" class="ltx_font_mathcaligraphic" mathcolor="#000000">ℒ</mi><msup><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">(</mo><msubsup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝐑</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">l</mi><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">(</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">)</mo></mrow></msubsup><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">)</mo></mrow><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">−</mo><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">1</mn><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">/</mo><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">4</mn></mrow></msup><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">‖</mo></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">∗</mo></msub><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">=</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000" mathvariant="normal">Θ</mi><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">(</mo><msqrt style="--ltx-fg-color:#000000;" mathcolor="#000000"><mstyle displaystyle="true"><mfrac style="--ltx-fg-color:#000000;" mathcolor="#000000"><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">n</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">l</mi></msub><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">n</mi><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">l</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">−</mo><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">1</mn></mrow></msub></mfrac></mstyle></msqrt><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">)</mo></mrow><mo style="--ltx-fg-color:#000000;" lspace="0em" mathcolor="#000000">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle||\Delta\mathbf{W}_{l}||_{*}=\eta(n_{l})^{-c_{1}}(n_{l-1})^{-c_{2}}\left\|\left(\mathbf{L}_{l}^{(t)}\right)^{-1/4}\nabla_{\mathbf{W}_{l}}\mathcal{L}\left(\mathbf{R}_{l}^{(t)}\right)^{-1/4}\right\|_{*}=\Theta\left(\sqrt{\frac{n_{l}}{n_{l-1}}}\right).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S4.SS5.p1.3" class="ltx_p"><span id="S4.SS5.p1.3.1" class="ltx_text" style="--ltx-fg-color:#000000;">For one-step analysis, let </span><math id="S4.SS5.p1.m2" class="ltx_Math" alttext="\delta=0" display="inline" intent=":literal"><semantics><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">δ</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">=</mo><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">0</mn></mrow><annotation encoding="application/x-tex">\delta=0</annotation></semantics></math><span id="S4.SS5.p1.3.2" class="ltx_text" style="--ltx-fg-color:#000000;">. Then the above condition reduces to</span></p>
<table id="S4.EGx12" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="S4.Ex28"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S4.Ex28.m1" class="ltx_Math" alttext="\displaystyle||\Delta\mathbf{W}_{l}||_{*}" display="inline" intent=":literal"><semantics><msub><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">‖</mo><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000" mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝐖</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">l</mi></msub></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">‖</mo></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">∗</mo></msub><annotation encoding="application/x-tex">\displaystyle||\Delta\mathbf{W}_{l}||_{*}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S4.Ex28.m2" class="ltx_math_unparsed" alttext="\displaystyle=\eta(n_{l})^{-c_{1}}(n_{l-1})^{-c_{2}}\left\|\left(\nabla_{\mathbf{W}_{l}}\mathcal{L}\cdot\nabla_{\mathbf{W}_{l}}\mathcal{L}^{\text{T}}\right)^{-1/4}\nabla_{\mathbf{W}_{l}}\mathcal{L}\left(\nabla_{\mathbf{W}_{l}}\mathcal{L}^{\text{T}}\cdot\nabla_{\mathbf{W}_{l}}\mathcal{L}\right)^{-1/4}\right\|_{*}" display="inline" intent=":literal"><semantics><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">=</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">η</mi><msup><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">(</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">n</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">l</mi></msub><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">)</mo></mrow><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">−</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">c</mi><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">1</mn></msub></mrow></msup><msup><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">(</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">n</mi><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">l</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">−</mo><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">1</mn></mrow></msub><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">)</mo></mrow><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">−</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">c</mi><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">2</mn></msub></mrow></msup><msub><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">‖</mo><msup><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">(</mo><msub><mo style="--ltx-fg-color:#000000;" mathcolor="#