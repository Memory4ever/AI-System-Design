<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S4.Ex34.m1" class="ltx_math_unparsed" alttext="\displaystyle\overset{\text{(4)}}{=}\eta\Theta\left((n_{l})^{-c_{1}-\frac{1}{4}}(n_{l-1})^{-c_{2}+\frac{1}{4}}\right)||\nabla_{\mathbf{h}_{l}}\mathcal{L}||_{2}^{-1/2}||\mathbf{h}_{l-1}||_{2}^{-1/2}" display="inline" intent=":literal"><semantics><mrow><mover accent="true"><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">=</mo><mtext style="--ltx-fg-color:#000000;" mathcolor="#000000" mathsize="0.700em">(4)</mtext></mover><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">η</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000" mathvariant="normal">Θ</mi><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">(</mo><msup><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">(</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">n</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">l</mi></msub><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">)</mo></mrow><mrow><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">−</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">c</mi><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">1</mn></msub></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">−</mo><mfrac style="--ltx-fg-color:#000000;" mathcolor="#000000"><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">1</mn><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">4</mn></mfrac></mrow></msup><msup><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">(</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">n</mi><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">l</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">−</mo><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">1</mn></mrow></msub><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">)</mo></mrow><mrow><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">−</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">c</mi><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">2</mn></msub></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">+</mo><mfrac style="--ltx-fg-color:#000000;" mathcolor="#000000"><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">1</mn><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">4</mn></mfrac></mrow></msup><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">)</mo></mrow><mo style="--ltx-fg-color:#000000;" fence="false" mathcolor="#000000" rspace="0.167em" stretchy="false">|</mo><mo style="--ltx-fg-color:#000000;" fence="false" mathcolor="#000000" rspace="0.167em" stretchy="false">|</mo><msub><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" rspace="0.167em">∇</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝐡</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">l</mi></msub></msub><mi style="--ltx-fg-color:#000000;" class="ltx_font_mathcaligraphic" mathcolor="#000000">ℒ</mi><mo style="--ltx-fg-color:#000000;" fence="false" mathcolor="#000000" rspace="0.167em" stretchy="false">|</mo><msubsup><mo style="--ltx-fg-color:#000000;" fence="false" mathcolor="#000000" rspace="0.167em" stretchy="false">|</mo><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">2</mn><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">−</mo><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">1</mn><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">/</mo><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">2</mn></mrow></msubsup><mo style="--ltx-fg-color:#000000;" fence="false" mathcolor="#000000" rspace="0.167em" stretchy="false">|</mo><mo style="--ltx-fg-color:#000000;" fence="false" mathcolor="#000000" rspace="0.167em" stretchy="false">|</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝐡</mi><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">l</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">−</mo><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">1</mn></mrow></msub><mo style="--ltx-fg-color:#000000;" fence="false" mathcolor="#000000" rspace="0.167em" stretchy="false">|</mo><msubsup><mo style="--ltx-fg-color:#000000;" fence="false" mathcolor="#000000" stretchy="false">|</mo><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">2</mn><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">−</mo><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">1</mn><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">/</mo><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">2</mn></mrow></msubsup></mrow><annotation encoding="application/x-tex">\displaystyle\overset{\text{(4)}}{=}\eta\Theta\left((n_{l})^{-c_{1}-\frac{1}{4}}(n_{l-1})^{-c_{2}+\frac{1}{4}}\right)||\nabla_{\mathbf{h}_{l}}\mathcal{L}||_{2}^{-1/2}||\mathbf{h}_{l-1}||_{2}^{-1/2}</annotation></semantics></math></td>
