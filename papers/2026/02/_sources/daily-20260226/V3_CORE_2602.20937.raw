<td id="S4.F2.1.1.2.2" class="ltx_td ltx_align_center"><object type="image/svg+xml" data="2602.20937v1/Shampoo_mup_validation_loss_v5_svg-raw.svg" id="S4.SS1.g4" class="ltx_graphics ltx_img_landscape" style="aspect-ratio:180/135;" width="180" height="135"></object></td></tr>
