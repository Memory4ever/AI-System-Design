<td id="A5.T13.7.6.2" class="ltx_td ltx_align_center ltx_border_bb" style="padding:-0.5pt 2.3pt;"><span id="A5.T13.7.6.2.1" class="ltx_text ltx_font_bold" style="font-size:50%;">0.901</span></td>
