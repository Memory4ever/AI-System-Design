<td id="A2.T6.7.7.2" class="ltx_td ltx_align_center ltx_border_bb" style="padding:0.4pt 2.6pt;"><span id="A2.T6.7.7.2.1" class="ltx_text" style="font-size:70%;">✓</span></td>
<td id="A2.T6.7.7.3" class="ltx_td ltx_align_center ltx_border_bb" style="padding:0.4pt 2.6pt;"><span id="A2.T6.7.7.3.1" class="ltx_text" style="font-size:70%;">✓</span></td>
