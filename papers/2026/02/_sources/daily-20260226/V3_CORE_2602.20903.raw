<td id="A5.T13.7.5.6" class="ltx_td ltx_align_center" style="padding:-0.5pt 2.3pt;"><span id="A5.T13.7.5.6.1" class="ltx_text ltx_font_bold" style="font-size:50%;">0.874</span></td>
