<section id="A1" class="ltx_appendix">
<h2 class="ltx_title ltx_title_appendix" style="--ltx-fg-color:#000000;"><span class="ltx_tag ltx_tag_appendix">Appendix A </span>Derivation of the Gradient</h2>

<div id="A1.p1" class="ltx_para">
<p id="A1.p1.1" class="ltx_p"><span id="A1.p1.1.1" class="ltx_text" style="--ltx-fg-color:#000000;">Here we present an elaborated derivation of the gradients. The derivations follow the material in the appendix of </span><cite class="ltx_cite ltx_citemacro_citet"><a href="#bib.bib4" title="" class="ltx_ref">Anshumann et al. (2025)</a></cite><span id="A1.p1.1.4" class="ltx_text" style="--ltx-fg-color:#000000;">. If </span><math id="A1.p1.m1" class="ltx_Math" alttext="p_{i}=\exp(z_{i})/\sum_{i=1}^{|\mathcal{V}|}\exp(z_{i})" display="inline" intent=":literal"><semantics><mrow><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">p</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">i</mi></msub><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">=</mo><mrow><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">exp</mi><mo>⁡</mo><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">(</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">z</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">i</mi></msub><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">)</mo></mrow></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" rspace="0.055em">/</mo><mrow><msubsup><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">∑</mo><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">i</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">=</mo><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">1</mn></mrow><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">|</mo><mi style="--ltx-fg-color:#000000;" class="ltx_font_mathcaligraphic" mathcolor="#000000">𝒱</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">|</mo></mrow></msubsup><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">exp</mi><mo>⁡</mo><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">(</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">z</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">i</mi></msub><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">)</mo></mrow></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">p_{i}=\exp(z_{i})/\sum_{i=1}^{|\mathcal{V}|}\exp(z_{i})</annotation></semantics></math><span id="A1.p1.1.5" class="ltx_text" style="--ltx-fg-color:#000000;"> is the softmax probability for a logit </span><math id="A1.p1.m2" class="ltx_Math" alttext="z_{i}" display="inline" intent=":literal"><semantics><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">z</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">i</mi></msub><annotation encoding="application/x-tex">z_{i}</annotation></semantics></math><span id="A1.p1.1.6" class="ltx_text" style="--ltx-fg-color:#000000;"> for a vocabulary </span><math id="A1.p1.m3" class="ltx_Math" alttext="\mathcal{V}" display="inline" intent=":literal"><semantics><mi style="--ltx-fg-color:#000000;" class="ltx_font_mathcaligraphic" mathcolor="#000000">𝒱</mi><annotation encoding="application/x-tex">\mathcal{V}</annotation></semantics></math><span id="A1.p1.1.7" class="ltx_text" style="--ltx-fg-color:#000000;">, then the gradient of </span><math id="A1.p1.m4" class="ltx_Math" alttext="p_{k}" display="inline" intent=":literal"><semantics><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">p</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">k</mi></msub><annotation encoding="application/x-tex">p_{k}</annotation></semantics></math><span id="A1.p1.1.8" class="ltx_text" style="--ltx-fg-color:#000000;"> is (from </span><cite class="ltx_cite ltx_citemacro_citep"><span id="A1.p1.1.9" class="ltx_text" style="--ltx-fg-color:#000000;">(</span><a href="#bib.bib5" title="" class="ltx_ref">Iwana et al., 2019</a><span id="A1.p1.1.11" class="ltx_text" style="--ltx-fg-color:#000000;">)</span></cite><span id="A1.p1.1.12" class="ltx_text" style="--ltx-fg-color:#000000;">):</span></p>
<table id="A1.E7" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A1.E7.m1" class="ltx_math_unparsed" alttext="\frac{\partial p_{j}}{\partial z_{i}}=p_{j}\left(\mathds{1}_{[i=j]}-p_{i}\right)" display="block" intent=":literal"><semantics><mrow><mfrac style="--ltx-fg-color:#000000;" mathcolor="#000000"><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">∂</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">p</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">j</mi></msub></mrow><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">∂</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">z</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">i</mi></msub></mrow></mfrac><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">=</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">p</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">j</mi></msub><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">(</mo><msub><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">𝟙</mn><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">[</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">i</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">=</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">j</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">]</mo></mrow></msub><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">−</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">p</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">i</mi></msub><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">)</mo></mrow></mrow><annotation encoding="application/x-tex">\frac{\partial p_{j}}{\partial z_{i}}=p_{j}\left(\mathds{1}_{[i=j]}-p_{i}\right)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(7)</span></td></tr></tbody>
</table>
</div>
<div id="A1.p2" class="ltx_para">
<p id="A1.p2.1" class="ltx_p"><span id="A1.p2.1.1" class="ltx_text" style="--ltx-fg-color:#000000;">Now, given a vocabulary </span><math id="A1.p2.m1" class="ltx_Math" alttext="\mathcal{V}" display="inline" intent=":literal"><semantics><mi style="--ltx-fg-color:#000000;" class="ltx_font_mathcaligraphic" mathcolor="#000000">𝒱</mi><annotation encoding="application/x-tex">\mathcal{V}</annotation></semantics></math><span id="A1.p2.1.2" class="ltx_text" style="--ltx-fg-color:#000000;">, the KL Divergence loss between the teacher probabilities of the teacher (</span><math id="A1.p2.m2" class="ltx_Math" alttext="p^{T}_{i}" display="inline" intent=":literal"><semantics><msubsup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">p</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">i</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">T</mi></msubsup><annotation encoding="application/x-tex">p^{T}_{i}</annotation></semantics></math><span id="A1.p2.1.3" class="ltx_text" style="--ltx-fg-color:#000000;">) and the student (</span><math id="A1.p2.m3" class="ltx_Math" alttext="p^{S}_{i}" display="inline" intent=":literal"><semantics><msubsup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">p</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">i</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">S</mi></msubsup><annotation encoding="application/x-tex">p^{S}_{i}</annotation></semantics></math><span id="A1.p2.1.4" class="ltx_text" style="--ltx-fg-color:#000000;">) is:</span></p>
<table id="A1.E8" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A1.E8.m1" class="ltx_Math" alttext="\mathcal{L}_{KLD}=\sum_{i=1}^{|\mathcal{V}|}p^{T}_{i}\log(p^{T}_{i}/p^{S}_{i})" display="block" intent=":literal"><semantics><mrow><msub><mi style="--ltx-fg-color:#000000;" class="ltx_font_mathcaligraphic" mathcolor="#000000">ℒ</mi><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">K</mi><mo lspace="0em" rspace="0em">​</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">L</mi><mo lspace="0em" rspace="0em">​</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">D</mi></mrow></msub><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" rspace="0.111em">=</mo><mrow><munderover><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" movablelimits="false">∑</mo><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">i</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">=</mo><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">1</mn></mrow><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">|</mo><mi style="--ltx-fg-color:#000000;" class="ltx_font_mathcaligraphic" mathcolor="#000000">𝒱</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">|</mo></mrow></munderover><mrow><msubsup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">p</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">i</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">T</mi></msubsup><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">log</mi><mo>⁡</mo><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">(</mo><mrow><msubsup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">p</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">i</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">T</mi></msubsup><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">/</mo><msubsup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">p</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">i</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">S</mi></msubsup></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">)</mo></mrow></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\mathcal{L}_{KLD}=\sum_{i=1}^{|\mathcal{V}|}p^{T}_{i}\log(p^{T}_{i}/p^{S}_{i})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(8)</span></td></tr></tbody>
</table>
</div>
<div id="A1.p3" class="ltx_para">
<p id="A1.p3.1" class="ltx_p"><span id="A1.p3.1.1" class="ltx_text" style="--ltx-fg-color:#000000;">It can be derived that,</span></p>
<table id="A1.EGx4" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A1.Ex9"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A1.Ex9.m1" class="ltx_Math" alttext="\displaystyle\frac{\partial\mathcal{L}_{KLD}}{\partial z_{i}}" display="inline" intent=":literal"><semantics><mstyle displaystyle="true"><mfrac style="--ltx-fg-color:#000000;" mathcolor="#000000"><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">∂</mo><msub><mi style="--ltx-fg-color:#000000;" class="ltx_font_mathcaligraphic" mathcolor="#000000">ℒ</mi><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">K</mi><mo lspace="0em" rspace="0em">​</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">L</mi><mo lspace="0em" rspace="0em">​</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">D</mi></mrow></msub></mrow><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">∂</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">z</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">i</mi></msub></mrow></mfrac></mstyle><annotation encoding="application/x-tex">\displaystyle\frac{\partial\mathcal{L}_{KLD}}{\partial z_{i}}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.Ex9.m2" class="ltx_math_unparsed" alttext="\displaystyle=-\sum_{j=1}^{|\mathcal{V}|}\frac{p^{T}_{j}}{p^{S}_{j}}\frac{\partial p^{S}_{j}}{\partial z_{i}}" display="inline" intent=":literal"><semantics><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" rspace="0em">=</mo><mo style="--ltx-fg-color:#000000;" lspace="0em" mathcolor="#000000">−</mo><mstyle displaystyle="true"><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" movablelimits="false">∑</mo></mstyle><msub><mrow></mrow><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">j</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">=</mo><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">1</mn></mrow></msub><msup><mrow></mrow><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">|</mo><mi style="--ltx-fg-color:#000000;" class="ltx_font_mathcaligraphic" mathcolor="#000000">𝒱</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">|</mo></mrow></msup><mstyle displaystyle="true"><mfrac style="--ltx-fg-color:#000000;" mathcolor="#000000"><msubsup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">p</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">j</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">T</mi></msubsup><msubsup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">p</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">j</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">S</mi></msubsup></mfrac></mstyle><mstyle displaystyle="true"><mfrac style="--ltx-fg-color:#000000;" mathcolor="#000000"><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">∂</mo><msubsup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">p</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">j</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">S</mi></msubsup></mrow><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">∂</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">z</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">i</mi></msub></mrow></mfrac></mstyle></mrow><annotation encoding="application/x-tex">\displaystyle=-\sum_{j=1}^{|\mathcal{V}|}\frac{p^{T}_{j}}{p^{S}_{j}}\frac{\partial p^{S}_{j}}{\partial z_{i}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A1.Ex10"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.Ex10.m1" class="ltx_math_unparsed" alttext="\displaystyle=-\sum_{j=1}^{|\mathcal{V}|}p^{T}_{j}\left(\mathds{1}_{[i=j]}-p^{S}_{i}\right)" display="inline" intent=":literal"><semantics><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" rspace="0em">=</mo><mo style="--ltx-fg-color:#000000;" lspace="0em" mathcolor="#000000">−</mo><mstyle displaystyle="true"><munderover><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" movablelimits="false">∑</mo><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">j</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">=</mo><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">1</mn></mrow><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">|</mo><mi style="--ltx-fg-color:#000000;" class="ltx_font_mathcaligraphic" mathcolor="#000000">𝒱</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">|</mo></mrow></munderover></mstyle><msubsup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">p</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">j</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">T</mi></msubsup><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">(</mo><msub><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">𝟙</mn><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">[</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">i</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">=</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">j</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">]</mo></mrow></msub><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">−</mo><msubsup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">p</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">i</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">S</mi></msubsup><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=-\sum_{j=1}^{|\mathcal{V}|}p^{T}_{j}\left(\mathds{1}_{[i=j]}-p^{S}_{i}\right)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A1.Ex11"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.Ex11.m1" class="ltx_math_unparsed" alttext="\displaystyle=p^{S}_{i}\cdot(\sum_{j=1}^{|\mathcal{V}|}p^{T}_{j})-\sum_{j=1}^{|\mathcal{V}|}p^{T}_{j}\mathds{1}_{[i=j]}" display="inline" intent=":literal"><semantics><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">=</mo><msubsup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">p</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">i</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">S</mi></msubsup><mo style="--ltx-fg-color:#000000;" lspace="0.222em" mathcolor="#000000" rspace="0.222em">⋅</mo><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">(</mo><mstyle displaystyle="true"><munderover><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" movablelimits="false">∑</mo><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">j</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">=</mo><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">1</mn></mrow><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">|</mo><mi style="--ltx-fg-color:#000000;" class="ltx_font_mathcaligraphic" mathcolor="#000000">𝒱</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">|</mo></mrow></munderover></mstyle><msubsup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">p</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">j</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">T</mi></msubsup><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">)</mo></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">−</mo><mstyle displaystyle="true"><munderover><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" movablelimits="false">∑</mo><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">j</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">=</mo><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">1</mn></mrow><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">|</mo><mi style="--ltx-fg-color:#000000;" class="ltx_font_mathcaligraphic" mathcolor="#000000">𝒱</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">|</mo></mrow></munderover></mstyle><msubsup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">p</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">j</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">T</mi></msubsup><msub><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">𝟙</mn><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">[</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">i</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">=</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">j</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">]</mo></mrow></msub></mrow><annotation encoding="application/x-tex">\displaystyle=p^{S}_{i}\cdot(\sum_{j=1}^{|\mathcal{V}|}p^{T}_{j})-\sum_{j=1}^{|\mathcal{V}|}p^{T}_{j}\mathds{1}_{[i=j]}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A1.Ex12"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.Ex12.m1" class="ltx_Math" alttext="\displaystyle=p^{S}_{i}-p^{T}_{i}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">=</mo><mrow><msubsup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">p</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">i</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">S</mi></msubsup><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">−</mo><msubsup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">p</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">i</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">T</mi></msubsup></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=p^{S}_{i}-p^{T}_{i}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(9)</span></td></tr></tbody>
</table>
</div>
<div id="A1.p4" class="ltx_para">
<p id="A1.p4.1" class="ltx_p"><span id="A1.p4.1.1" class="ltx_text" style="--ltx-fg-color:#000000;">Now, we can show that </span><math id="A1.p4.m1" class="ltx_Math" alttext="\mathcal{\mathcal{D}}_{KL_{1}}" display="inline" intent=":literal"><semantics><msub><mi style="--ltx-fg-color:#000000;" class="ltx_font_mathcaligraphic" mathcolor="#000000">𝒟</mi><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">K</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">L</mi><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">1</mn></msub></mrow></msub><annotation encoding="application/x-tex">\mathcal{\mathcal{D}}_{KL_{1}}</annotation></semantics></math><span id="A1.p4.1.2" class="ltx_text" style="--ltx-fg-color:#000000;"> has </span><math id="A1.p4.m2" class="ltx_Math" alttext="K+1" display="inline" intent=":literal"><semantics><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">K</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">+</mo><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">1</mn></mrow><annotation encoding="application/x-tex">K+1</annotation></semantics></math><span id="A1.p4.1.3" class="ltx_text" style="--ltx-fg-color:#000000;"> terms when we consider top-</span><math id="A1.p4.m3" class="ltx_Math" alttext="K" display="inline" intent=":literal"><semantics><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">K</mi><annotation encoding="application/x-tex">K</annotation></semantics></math><span id="A1.p4.1.4" class="ltx_text" style="--ltx-fg-color:#000000;"> probabilities, with the first </span><math id="A1.p4.m4" class="ltx_Math" alttext="K" display="inline" intent=":literal"><semantics><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">K</mi><annotation encoding="application/x-tex">K</annotation></semantics></math><span id="A1.p4.1.5" class="ltx_text" style="--ltx-fg-color:#000000;"> being (</span><math id="A1.p4.m5" class="ltx_Math" alttext="i\in[K]" display="inline" intent=":literal"><semantics><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">i</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">∈</mo><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">[</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">K</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">i\in[K]</annotation></semantics></math><span id="A1.p4.1.6" class="ltx_text" style="--ltx-fg-color:#000000;">)</span></p>
<table id="A1.EGx5" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A1.Ex13"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A1.Ex13.m1" class="ltx_math_unparsed" alttext="\displaystyle L_{1:K}=\sum_{k=1}^{K}\accentset{\ast}{p}^{T}_{k}\log\frac{\accentset{\ast}{p}^{T}_{k}}{\accentset{\ast}{p}^{S}_{k}}" display="inline" intent=":literal"><semantics><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">L</mi><msub><mrow></mrow><mrow><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">1</mn><mo style="--ltx-fg-color:#000000;" lspace="0.278em" mathcolor="#000000" rspace="0.278em">:</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">K</mi></mrow></msub><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">=</mo><mstyle displaystyle="true"><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" movablelimits="false">∑</mo></mstyle><msub><mrow></mrow><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">k</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">=</mo><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">1</mn></mrow></msub><msup><mrow></mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">K</mi></msup><mover accent="true"><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">p</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" mathsize="0.700em">∗</mo></mover><msup><mrow></mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">T</mi></msup><msub><mrow></mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">k</mi></msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">log</mi><mstyle displaystyle="true"><mfrac style="--ltx-fg-color:#000000;" mathcolor="#000000"><msubsup><mover accent="true"><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">p</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" mathsize="0.700em">∗</mo></mover><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">k</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">T</mi></msubsup><msubsup><mover accent="true"><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">p</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" mathsize="0.700em">∗</mo></mover><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">k</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">S</mi></msubsup></mfrac></mstyle></mrow><annotation encoding="application/x-tex">\displaystyle L_{1:K}=\sum_{k=1}^{K}\accentset{\ast}{p}^{T}_{k}\log\frac{\accentset{\ast}{p}^{T}_{k}}{\accentset{\ast}{p}^{S}_{k}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="A1.p5" class="ltx_para ltx_noindent">
<p id="A1.p5.1" class="ltx_p"><span id="A1.p5.1.1" class="ltx_text" style="--ltx-fg-color:#000000;">where </span><math id="A1.p5.m1" class="ltx_Math" alttext="\accentset{\ast}{p}^{S}_{k}" display="inline" intent=":literal"><semantics><msubsup><mover accent="true"><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">p</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" mathsize="0.700em">∗</mo></mover><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">k</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">S</mi></msubsup><annotation encoding="application/x-tex">\accentset{\ast}{p}^{S}_{k}</annotation></semantics></math><span id="A1.p5.1.2" class="ltx_text" style="--ltx-fg-color:#000000;"> are the student probabilities corresponding to the top-</span><math id="A1.p5.m2" class="ltx_Math" alttext="K" display="inline" intent=":literal"><semantics><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">K</mi><annotation encoding="application/x-tex">K</annotation></semantics></math><span id="A1.p5.1.3" class="ltx_text" style="--ltx-fg-color:#000000;"> tokens, i.e. tokens for which the teacher probabilities are maximum. The derivative of </span><math id="A1.p5.m3" class="ltx_math_unparsed" alttext="L_{1:K}" display="inline" intent=":literal"><semantics><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">L</mi><msub><mrow></mrow><mrow><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">1</mn><mo style="--ltx-fg-color:#000000;" lspace="0.278em" mathcolor="#000000" rspace="0.278em">:</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">K</mi></mrow></msub></mrow><annotation encoding="application/x-tex">L_{1:K}</annotation></semantics></math><span id="A1.p5.1.4" class="ltx_text" style="--ltx-fg-color:#000000;"> w.r.t. a logit </span><math id="A1.p5.m4" class="ltx_Math" alttext="z_{i}" display="inline" intent=":literal"><semantics><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">z</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">i</mi></msub><annotation encoding="application/x-tex">z_{i}</annotation></semantics></math><span id="A1.p5.1.5" class="ltx_text" style="--ltx-fg-color:#000000;"> is</span></p>
<table id="A1.E10" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A1.E10.m1" class="ltx_math_unparsed" alttext="\frac{\partial L_{1:K}}{\partial z_{i}}=p^{S}_{i}\cdot(\sum_{k=1}^{K}\accentset{\ast}{p}^{T}_{k})-\sum_{k=1}^{K}\accentset{\ast}{p}^{T}_{k}\mathds{1}_{[i=k]}" display="block" intent=":literal"><semantics><mrow><mfrac style="--ltx-fg-color:#000000;" mathcolor="#000000"><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">∂</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">L</mi><msub><mrow></mrow><mrow><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">1</mn><mo style="--ltx-fg-color:#000000;" lspace="0.278em" mathcolor="#000000" rspace="0.278em">:</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">K</mi></mrow></msub></mrow><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">∂</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">z</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">i</mi></msub></mrow></mfrac><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">=</mo><msubsup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">p</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">i</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">S</mi></msubsup><mo style="--ltx-fg-color:#000000;" lspace="0.222em" mathcolor="#000000" rspace="0.222em">⋅</mo><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">(</mo><munderover><mo style="--ltx-fg-color:#000000;" lspace="0em" mathcolor="#000000" movablelimits="false">∑</mo><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">k</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">=</mo><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">1</mn></mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">K</mi></munderover><msubsup><mover accent="true"><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">p</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" mathsize="0.700em">∗</mo></mover><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">k</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">T</mi></msubsup><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">)</mo></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" rspace="0.055em">−</mo><munderover><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" movablelimits="false">∑</mo><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">k</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">=</mo><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">1</mn></mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">K</mi></munderover><msubsup><mover accent="true"><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">p</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" mathsize="0.700em">∗</mo></mover><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">k</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">T</mi></msubsup><msub><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">𝟙</mn><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">[</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">i</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">=</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">k</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">]</mo></mrow></msub></mrow><annotation encoding="application/x-tex">\frac{\partial L_{1:K}}{\partial z_{i}}=p^{S}_{i}\cdot(\sum_{k=1}^{K}\accentset{\ast}{p}^{T}_{k})-\sum_{k=1}^{K}\accentset{\ast}{p}^{T}_{k}\mathds{1}_{[i=k]}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(10)</span></td></tr></tbody>
</table>
</div>
<div id="A1.p6" class="ltx_para">
<p id="A1.p6.1" class="ltx_p"><span id="A1.p6.1.1" class="ltx_text" style="--ltx-fg-color:#000000;">Now for </span><math id="A1.p6.m1" class="ltx_Math" alttext="i\in[\mathcal{V}\setminus K]" display="inline" intent=":literal"><semantics><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">i</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">∈</mo><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">[</mo><mrow><mi style="--ltx-fg-color:#000000;" class="ltx_font_mathcaligraphic" mathcolor="#000000">𝒱</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">∖</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">K</mi></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">i\in[\mathcal{V}\setminus K]</annotation></semantics></math><span id="A1.p6.1.2" class="ltx_text" style="--ltx-fg-color:#000000;">, the indicator function </span><math id="A1.p6.m2" class="ltx_math_unparsed" alttext="\mathds{1}_{[i=k]}" display="inline" intent=":literal"><semantics><mrow><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">𝟙</mn><msub><mrow></mrow><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">[</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">i</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">=</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">k</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">]</mo></mrow></msub></mrow><annotation encoding="application/x-tex">\mathds{1}_{[i=k]}</annotation></semantics></math><span id="A1.p6.1.3" class="ltx_text" style="--ltx-fg-color:#000000;"> is never one. Therefore, the gradient of </span><math id="A1.p6.m3" class="ltx_math_unparsed" alttext="L_{1:K}" display="inline" intent=":literal"><semantics><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">L</mi><msub><mrow></mrow><mrow><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">1</mn><mo style="--ltx-fg-color:#000000;" lspace="0.278em" mathcolor="#000000" rspace="0.278em">:</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">K</mi></mrow></msub></mrow><annotation encoding="application/x-tex">L_{1:K}</annotation></semantics></math><span id="A1.p6.1.4" class="ltx_text" style="--ltx-fg-color:#000000;"> has the following forms for two different cases, as:</span></p>
<table id="A1.EGx6" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A1.Ex14"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A1.Ex14.m1" class="ltx_math_unparsed" alttext="\displaystyle\frac{\partial L_{1:K}}{\partial z_{i}}=\begin{cases}p^{S}_{i}\cdot(\sum_{k=1}^{K}\accentset{\ast}{p}^{T}_{i})-p^{T}_{i}\qquad&amp;i\in[K]\\
p^{S}_{i}\cdot(\sum_{k=1}^{K}\accentset{\ast}{p}^{T}_{i})&amp;i\in[\mathcal{V}\setminus K]\end{cases}" display="inline" intent=":literal"><semantics><mrow><mstyle displaystyle="true"><mfrac style="--ltx-fg-color:#000000;" mathcolor="#000000"><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">∂</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">L</mi><msub><mrow></mrow><mrow><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">1</mn><mo style="--ltx-fg-color:#000000;" lspace="0.278em" mathcolor="#000000" rspace="0.278em">:</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">K</mi></mrow></msub></mrow><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">∂</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">z</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">i</mi></msub></mrow></mfrac></mstyle><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">=</mo><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">{</mo><mtable columnspacing="5pt" rowspacing="0pt"><mtr><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><mrow><msubsup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">p</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">i</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">S</mi></msubsup><mo style="--ltx-fg-color:#000000;" lspace="0.222em" mathcolor="#000000" rspace="0.222em">⋅</mo><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">(</mo><mrow><msubsup><mo style="--ltx-fg-color:#000000;" lspace="0em" mathcolor="#000000">∑</mo><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">k</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">=</mo><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">1</mn></mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">K</mi></msubsup><msubsup><mover accent="true"><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">p</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" mathsize="0.700em">∗</mo></mover><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">i</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">T</mi></msubsup></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">)</mo></mrow></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">−</mo><msubsup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">p</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">i</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">T</mi></msubsup></mrow><mspace style="width:2em;" width="2em"></mspace></mrow></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">i</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">∈</mo><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">[</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">K</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">]</mo></mrow></mrow></mtd></mtr><mtr><mtd class="ltx_align_left" columnalign="left"><mrow><msubsup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">p</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">i</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">S</mi></msubsup><mo style="--ltx-fg-color:#000000;" lspace="0.222em" mathcolor="#000000" rspace="0.222em">⋅</mo><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">(</mo><mrow><msubsup><mo style="--ltx-fg-color:#000000;" lspace="0em" mathcolor="#000000">∑</mo><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">k</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">=</mo><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">1</mn></mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">K</mi></msubsup><msubsup><mover accent="true"><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">p</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" mathsize="0.700em">∗</mo></mover><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">i</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">T</mi></msubsup></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">)</mo></mrow></mrow></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">i</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">∈</mo><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">[</mo><mrow><mi style="--ltx-fg-color:#000000;" class="ltx_font_mathcaligraphic" mathcolor="#000000">𝒱</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">∖</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">K</mi></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">]</mo></mrow></mrow></mtd></mtr></mtable></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\frac{\partial L_{1:K}}{\partial z_{i}}=\begin{cases}p^{S}_{i}\cdot(\sum_{k=1}^{K}\accentset{\ast}{p}^{T}_{i})-p^{T}_{i}\qquad&amp;i\in[K]\\
p^{S}_{i}\cdot(\sum_{k=1}^{K}\accentset{\ast}{p}^{T}_{i})&amp;i\in[\mathcal{V}\setminus K]\end{cases}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="A1.p7" class="ltx_para ltx_noindent">
<p id="A1.p7.1" class="ltx_p"><span id="A1.p7.1.1" class="ltx_text" style="--ltx-fg-color:#000000;">Please note that the top </span><math id="A1.p7.m1" class="ltx_Math" alttext="K" display="inline" intent=":literal"><semantics><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">K</mi><annotation encoding="application/x-tex">K</annotation></semantics></math><span id="A1.p7.1.2" class="ltx_text" style="--ltx-fg-color:#000000;"> probabilities do not sum to one. The last term </span><math id="A1.p7.m2" class="ltx_Math" alttext="L_{K+1}" display="inline" intent=":literal"><semantics><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">L</mi><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">K</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">+</mo><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">1</mn></mrow></msub><annotation encoding="application/x-tex">L_{K+1}</annotation></semantics></math><span id="A1.p7.1.3" class="ltx_text" style="--ltx-fg-color:#000000;"> can be expressed as:</span></p>
<table id="A1.EGx7" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A1.Ex15"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A1.Ex15.m1" class="ltx_Math" alttext="\displaystyle L_{K+1}" display="inline" intent=":literal"><semantics><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">L</mi><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">K</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">+</mo><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">1</mn></mrow></msub><annotation encoding="application/x-tex">\displaystyle L_{K+1}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.Ex15.m2" class="ltx_Math" alttext="\displaystyle=\left(1-\sum_{i=1}^{K}\accentset{\ast}{p}^{T}_{k}\right)\log\frac{1-\sum_{i=1}^{K}\accentset{\ast}{p}^{T}_{k}}{1-\sum_{i=1}^{K}\accentset{\ast}{p}^{S}_{i}}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">=</mo><mrow><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">(</mo><mrow><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">1</mn><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">−</mo><mrow><mstyle displaystyle="true"><munderover><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" movablelimits="false">∑</mo><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">i</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">=</mo><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">1</mn></mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">K</mi></munderover></mstyle><msubsup><mover accent="true"><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">p</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" mathsize="0.700em">∗</mo></mover><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">k</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">T</mi></msubsup></mrow></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">)</mo></mrow><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">log</mi><mo lspace="0.167em">⁡</mo><mstyle displaystyle="true"><mfrac style="--ltx-fg-color:#000000;" mathcolor="#000000"><mrow><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">1</mn><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" rspace="0.055em">−</mo><mrow><msubsup><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">∑</mo><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">i</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">=</mo><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">1</mn></mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">K</mi></msubsup><msubsup><mover accent="true"><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">p</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" mathsize="0.700em">∗</mo></mover><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">k</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">T</mi></msubsup></mrow></mrow><mrow><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">1</mn><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" rspace="0.055em">−</mo><mrow><msubsup><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">∑</mo><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">i</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">=</mo><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">1</mn></mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">K</mi></msubsup><msubsup><mover accent="true"><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">p</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" mathsize="0.700em">∗</mo></mover><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">i</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">S</mi></msubsup></mrow></mrow></mfrac></mstyle></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\left(1-\sum_{i=1}^{K}\accentset{\ast}{p}^{T}_{k}\right)\log\frac{1-\sum_{i=1}^{K}\accentset{\ast}{p}^{T}_{k}}{1-\sum_{i=1}^{K}\accentset{\ast}{p}^{S}_{i}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A1.Ex16"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.Ex16.m1" class="ltx_math_unparsed" alttext="\displaystyle=-\left(1-\sum_{k=1}^{K}\accentset{\ast}{p}^{T}_{k}\right)\cdot\log{\left(1-\sum_{k=1}^{K}\accentset{\ast}{p}^{S}_{k}\right)}+\text{C}" display="inline" intent=":literal"><semantics><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" rspace="0em">=</mo><mo style="--ltx-fg-color:#000000;" lspace="0em" mathcolor="#000000">−</mo><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">(</mo><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">1</mn><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">−</mo><mstyle displaystyle="true"><munderover><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" movablelimits="false">∑</mo><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">k</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">=</mo><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">1</mn></mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">K</mi></munderover></mstyle><msubsup><mover accent="true"><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">p</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" mathsize="0.700em">∗</mo></mover><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">k</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">T</mi></msubsup><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" rspace="0.055em">)</mo></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" rspace="0.222em">⋅</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">log</mi><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">(</mo><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">1</mn><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">−</mo><mstyle displaystyle="true"><munderover><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" movablelimits="false">∑</mo><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">k</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">=</mo><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">1</mn></mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">K</mi></munderover></mstyle><msubsup><mover accent="true"><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">p</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" mathsize="0.700em">∗</mo></mover><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">k</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">S</mi></msubsup><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">)</mo></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">+</mo><mtext style="--ltx-fg-color:#000000;" mathcolor="#000000">C</mtext></mrow><annotation encoding="application/x-tex">\displaystyle=-\left(1-\sum_{k=1}^{K}\accentset{\ast}{p}^{T}_{k}\right)\cdot\log{\left(1-\sum_{k=1}^{K}\accentset{\ast}{p}^{S}_{k}\right)}+\text{C}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="A1.p8" class="ltx_para ltx_noindent">
<p id="A1.p8.1" class="ltx_p"><span id="A1.p8.1.1" class="ltx_text" style="--ltx-fg-color:#000000;">where C is a constant. The derivative of the last term, using the derivative of </span><math id="A1.p8.m1" class="ltx_Math" alttext="p^{S}_{k}" display="inline" intent=":literal"><semantics><msubsup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">p</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">k</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">S</mi></msubsup><annotation encoding="application/x-tex">p^{S}_{k}</annotation></semantics></math><span id="A1.p8.1.2" class="ltx_text" style="--ltx-fg-color:#000000;"> from </span><a href="#A1.E7" title="In Appendix A Derivation of the Gradient ‣ Don’t Ignore the Tail: Decoupling top-𝐾 Probabilities for Efficient Language Model Distillation" class="ltx_ref" style="--ltx-fg-color:#000000;"><span class="ltx_text ltx_ref_tag">Equation</span> <span class="ltx_text ltx_ref_tag">7</span></a><span id="A1.p8.1.3" class="ltx_text" style="--ltx-fg-color:#000000;"> is:</span></p>
<table id="A1.EGx8" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A1.Ex17"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A1.Ex17.m1" class="ltx_Math" alttext="\displaystyle\frac{\partial L_{K+1}}{\partial z_{i}}" display="inline" intent=":literal"><semantics><mstyle displaystyle="true"><mfrac style="--ltx-fg-color:#000000;" mathcolor="#000000"><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">∂</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">L</mi><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">K</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">+</mo><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">1</mn></mrow></msub></mrow><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">∂</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">z</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">i</mi></msub></mrow></mfrac></mstyle><annotation encoding="application/x-tex">\displaystyle\frac{\partial L_{K+1}}{\partial z_{i}}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.Ex17.m2" class="ltx_Math" alttext="\displaystyle=\frac{1-\sum_{k=1}^{K}\accentset{\ast}{p}^{T}_{k}}{1-\sum_{k=1}^{K}\accentset{\ast}{p}^{S}_{k}}\cdot\sum_{k=1}^{K}\frac{\partial\accentset{\ast}{p}^{S}_{k}}{\partial z_{i}}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">=</mo><mrow><mstyle displaystyle="true"><mfrac style="--ltx-fg-color:#000000;" mathcolor="#000000"><mrow><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">1</mn><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" rspace="0.055em">−</mo><mrow><msubsup><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">∑</mo><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">k</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">=</mo><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">1</mn></mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">K</mi></msubsup><msubsup><mover accent="true"><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">p</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" mathsize="0.700em">∗</mo></mover><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">k</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">T</mi></msubsup></mrow></mrow><mrow><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">1</mn><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" rspace="0.055em">−</mo><mrow><msubsup><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">∑</mo><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">k</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">=</mo><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">1</mn></mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">K</mi></msubsup><msubsup><mover accent="true"><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">p</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" mathsize="0.700em">∗</mo></mover><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">k</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">S</mi></msubsup></mrow></mrow></mfrac></mstyle><mo style="--ltx-fg-color:#000000;" lspace="0.222em" mathcolor="#000000" rspace="0.222em">⋅</mo><mrow><mstyle displaystyle="true"><munderover><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" movablelimits="false">∑</mo><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">k</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">=</mo><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">1</mn></mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">K</mi></munderover></mstyle><mstyle displaystyle="true"><mfrac style="--ltx-fg-color:#000000;" mathcolor="#000000"><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">∂</mo><msubsup><mover accent="true"><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">p</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" mathsize="0.700em">∗</mo></mover><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">k</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">S</mi></msubsup></mrow><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">∂</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">z</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">i</mi></msub></mrow></mfrac></mstyle></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\frac{1-\sum_{k=1}^{K}\accentset{\ast}{p}^{T}_{k}}{1-\sum_{k=1}^{K}\accentset{\ast}{p}^{S}_{k}}\cdot\sum_{k=1}^{K}\frac{\partial\accentset{\ast}{p}^{S}_{k}}{\partial z_{i}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A1.Ex18"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.Ex18.m1" class="ltx_math_unparsed" alttext="\displaystyle=\frac{1-\sum_{k=1}^{K}\accentset{\ast}{p}^{T}_{k}}{1-\sum_{k=1}^{K}\accentset{\ast}{p}^{S}_{k}}\cdot\sum_{k=1}^{K}\accentset{\ast}{p}^{S}_{k}\left(\mathds{1}_{[i=k]}-p^{S}_{i}\right)" display="inline" intent=":literal"><semantics><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">=</mo><mstyle displaystyle="true"><mfrac style="--ltx-fg-color:#000000;" mathcolor="#000000"><mrow><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">1</mn><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" rspace="0.055em">−</mo><mrow><msubsup><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">∑</mo><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">k</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">=</mo><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">1</mn></mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">K</mi></msubsup><msubsup><mover accent="true"><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">p</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" mathsize="0.700em">∗</mo></mover><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">k</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">T</mi></msubsup></mrow></mrow><mrow><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">1</mn><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" rspace="0.055em">−</mo><mrow><msubsup><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">∑</mo><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">k</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">=</mo><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">1</mn></mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">K</mi></msubsup><msubsup><mover accent="true"><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">p</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" mathsize="0.700em">∗</mo></mover><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">k</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">S</mi></msubsup></mrow></mrow></mfrac></mstyle><mo style="--ltx-fg-color:#000000;" lspace="0.222em" mathcolor="#000000" rspace="0.222em">⋅</mo><mstyle displaystyle="true"><munderover><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" movablelimits="false">∑</mo><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">k</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">=</mo><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">1</mn></mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">K</mi></munderover></mstyle><msubsup><mover accent="true"><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">p</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" mathsize="0.700em">∗</mo></mover><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">k</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">S</mi></msubsup><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">(</mo><msub><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">𝟙</mn><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">[</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">i</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">=</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">k</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">]</mo></mrow></msub><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">−</mo><msubsup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">p</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">i</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">S</mi></msubsup><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\frac{1-\sum_{k=1}^{K}\accentset{\ast}{p}^{T}_{k}}{1-\sum_{k=1}^{K}\accentset{\ast}{p}^{S}_{k}}\cdot\sum_{k=1}^{K}\accentset{\ast}{p}^{S}_{k}\left(\mathds{1}_{[i=k]}-p^{S}_{i}\right)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
