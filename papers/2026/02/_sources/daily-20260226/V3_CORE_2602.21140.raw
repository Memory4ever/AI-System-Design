<td id="S4.T2.5.11.12" class="ltx_td ltx_align_center" style="padding-left:5.5pt;padding-right:5.5pt;">0.589</td>
<td id="S4.T2.5.11.13" class="ltx_td ltx_align_center" style="padding-left:5.5pt;padding-right:5.5pt;">0.534</td>
<td id="S4.T2.5.11.14" class="ltx_td ltx_align_center" style="padding-left:5.5pt;padding-right:5.5pt;">0.523</td></tr>
<tr id="S4.T2.5.12" class="ltx_tr">
<th id="S4.T2.5.12.1" class="ltx_td ltx_align_left ltx_th ltx_th_row" style="padding-left:5.5pt;padding-right:5.5pt;">MMLU</th>
<td id="S4.T2.5.12.2" class="ltx_td ltx_align_center" style="padding-left:5.5pt;padding-right:5.5pt;">0.845</td>
<td id="S4.T2.5.12.3" class="ltx_td ltx_align_center" style="padding-left:5.5pt;padding-right:5.5pt;">0.842</td>
<td id="S4.T2.5.12.4" class="ltx_td ltx_align_center" style="padding-left:5.5pt;padding-right:5.5pt;">0.835</td>
<td id="S4.T2.5.12.5" class="ltx_td ltx_align_center" style="padding-left:5.5pt;padding-right:5.5pt;">0.825</td>
<td id="S4.T2.5.12.6" class="ltx_td ltx_align_center" style="padding-left:5.5pt;padding-right:5.5pt;">0.803</td>
<td id="S4.T2.5.12.7" class="ltx_td ltx_align_center" style="padding-left:5.5pt;padding-right:5.5pt;">0.760</td>
<td id="S4.T2.5.12.8" class="ltx_td ltx_align_center" style="padding-left:5.5pt;padding-right:5.5pt;">0.584</td>
<td id="S4.T2.5.12.9" class="ltx_td ltx_align_center" style="padding-left:5.5pt;padding-right:5.5pt;">0.843</td>
<td id="S4.T2.5.12.10" class="ltx_td ltx_align_center" style="padding-left:5.5pt;padding-right:5.5pt;">0.843</td>
<td id="S4.T2.5.12.11" class="ltx_td ltx_align_center" style="padding-left:5.5pt;padding-right:5.5pt;">0.843</td>
<td id="S4.T2.5.12.12" class="ltx_td ltx_align_center" style="padding-left:5.5pt;padding-right:5.5pt;">0.823</td>
