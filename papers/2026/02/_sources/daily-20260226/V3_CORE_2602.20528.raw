<td id="S7.T2.3.9.2" class="ltx_td ltx_align_center ltx_border_bb"><span id="S7.T2.3.9.2.1" class="ltx_text" style="font-size:90%;">.96B</span></td>
<td id="S7.T2.3.9.3" class="ltx_td ltx_align_center ltx_border_bb"><span id="S7.T2.3.9.3.1" class="ltx_text" style="font-size:90%;">2.0</span></td>
<td id="S7.T2.3.9.4" class="ltx_td ltx_align_center ltx_border_bb"><math id="S7.T2.m23" class="ltx_Math" alttext="94.0_{0.2}" display="inline" intent=":literal"><semantics><msub><mn mathsize="0.900em">94.0</mn><mn mathsize="0.900em">0.2</mn></msub><annotation encoding="application/x-tex">94.0_{0.2}</annotation></semantics></math></td>
