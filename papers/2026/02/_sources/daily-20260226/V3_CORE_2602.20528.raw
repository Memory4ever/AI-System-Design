<td id="S7.T2.3.9.6" class="ltx_td ltx_align_center ltx_border_bb"><math id="S7.T2.m25" class="ltx_Math" alttext="45.4_{0.0}" display="inline" intent=":literal"><semantics><msub><mn mathsize="0.900em">45.4</mn><mn mathsize="0.900em">0.0</mn></msub><annotation encoding="application/x-tex">45.4_{0.0}</annotation></semantics></math></td></tr>
