<td id="A3.T7.2.4.5" class="ltx_td ltx_align_center">1<math id="A3.T7.m3" class="ltx_Math" alttext="\sim" display="inline" intent=":literal"><semantics><mo>∼</mo><annotation encoding="application/x-tex">\sim</annotation></semantics></math>30</td>
