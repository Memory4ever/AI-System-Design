<tbody id="A3.Ex61"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex61.m1" class="ltx_Math" alttext="\displaystyle\overset{(a)}{\leq}\mathbb{E}\big\|\overline{\bm{w}}^{(t)}-\bm{w}_{\bm{S}}^{*}\big\|^{2}-2\gamma_{t}\mathbb{E}\big[F_{\bm{S}}(\overline{\bm{w}}^{(t)})-F_{\bm{S}}(\bm{w}_{\bm{S}}^{*})\big]" display="inline" intent=":literal"><semantics><mrow><mrow><mover accent="true"><mo>≤</mo><mrow><mo maxsize="0.700em" minsize="0.700em">(</mo><mi mathsize="0.700em">a</mi><mo maxsize="0.700em" minsize="0.700em">)</mo></mrow></mover><mo lspace="0em" rspace="0em">​</mo><mi>𝔼</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo maxsize="1.200em" minsize="1.200em" stretchy="true">‖</mo><mrow><msup><mover accent="true"><mi>𝒘</mi><mo stretchy="true">¯</mo></mover><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo>−</mo><msubsup><mi>𝒘</mi><mi>𝑺</mi><mo>∗</mo></msubsup></mrow><mo maxsize="1.200em" minsize="1.200em" stretchy="true">‖</mo></mrow><mn>2</mn></msup></mrow><mo>−</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>γ</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi>𝔼</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="1.200em" minsize="1.200em">[</mo><mrow><mrow><msub><mi>F</mi><mi>𝑺</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mover accent="true"><mi>𝒘</mi><mo stretchy="true">¯</mo></mover><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msub><mi>F</mi><mi>𝑺</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>𝒘</mi><mi>𝑺</mi><mo>∗</mo></msubsup><mo stretchy="false">)</mo></mrow></mrow></mrow><mo maxsize="1.200em" minsize="1.200em">]</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\overset{(a)}{\leq}\mathbb{E}\big\|\overline{\bm{w}}^{(t)}-\bm{w}_{\bm{S}}^{*}\big\|^{2}-2\gamma_{t}\mathbb{E}\big[F_{\bm{S}}(\overline{\bm{w}}^{(t)})-F_{\bm{S}}(\bm{w}_{\bm{S}}^{*})\big]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A3.E65"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.E65.m1" class="ltx_Math" alttext="\displaystyle\quad+\frac{4rCL\gamma_{t}{\lambda}^{t}C_{w_{0}}}{\delta}+\Big(G^{2}+\frac{4rCLG}{\delta(1-{\lambda})}\Big)\gamma_{t}^{2}." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mo>+</mo><mstyle displaystyle="true"><mfrac><mrow><mn>4</mn><mo lspace="0em" rspace="0em">​</mo><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><mi>L</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>γ</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><msup><mi>λ</mi><mi>t</mi></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>C</mi><msub><mi>w</mi><mn>0</mn></msub></msub></mrow><mi>δ</mi></mfrac></mstyle></mrow><mo>+</mo><mrow><mrow><mo maxsize="1.600em" minsize="1.600em">(</mo><mrow><msup><mi>G</mi><mn>2</mn></msup><mo>+</mo><mstyle displaystyle="true"><mfrac><mrow><mn>4</mn><mo lspace="0em" rspace="0em">​</mo><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><mi>L</mi><mo lspace="0em" rspace="0em">​</mo><mi>G</mi></mrow><mrow><mi>δ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>λ</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle></mrow><mo maxsize="1.600em" minsize="1.600em">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>γ</mi><mi>t</mi><mn>2</mn></msubsup></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\quad+\frac{4rCL\gamma_{t}{\lambda}^{t}C_{w_{0}}}{\delta}+\Big(G^{2}+\frac{4rCLG}{\delta(1-{\lambda})}\Big)\gamma_{t}^{2}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(65)</span></td></tr></tbody>
</table>
</div>
<div id="A3.SS3.p3" class="ltx_para">
<p id="A3.SS3.p3.1" class="ltx_p"><span id="A3.SS3.p3.1.1" class="ltx_text">Here, in <math id="A3.SS3.p3.m1" class="ltx_Math" alttext="(a)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi>a</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(a)</annotation></semantics></math> we assume <math id="A3.SS3.p3.m2" class="ltx_Math" alttext="\{\gamma_{t}\}" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">{</mo><msub><mi>γ</mi><mi>t</mi></msub><mo stretchy="false">}</mo></mrow><annotation encoding="application/x-tex">\{\gamma_{t}\}</annotation></semantics></math> is nonincreasing and use</span></p>
<table id="A3.Ex62" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A3.Ex62.m1" class="ltx_Math" alttext="\gamma_{t}\sum_{s=0}^{t-1}\lambda^{t-s}\gamma_{s}\leq\gamma_{t}^{2}\sum_{s=0}^{t-1}\lambda^{t-s}\leq\frac{\gamma_{t}^{2}}{1-\lambda}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><msub><mi>γ</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><munderover><mo movablelimits="false">∑</mo><mrow><mi>s</mi><mo>=</mo><mn>0</mn></mrow><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow></munderover><mrow><msup><mi>λ</mi><mrow><mi>t</mi><mo>−</mo><mi>s</mi></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>γ</mi><mi>s</mi></msub></mrow></mrow></mrow><mo>≤</mo><mrow><msubsup><mi>γ</mi><mi>t</mi><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><munderover><mo movablelimits="false">∑</mo><mrow><mi>s</mi><mo>=</mo><mn>0</mn></mrow><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow></munderover><msup><mi>λ</mi><mrow><mi>t</mi><mo>−</mo><mi>s</mi></mrow></msup></mrow></mrow><mo>≤</mo><mfrac><msubsup><mi>γ</mi><mi>t</mi><mn>2</mn></msubsup><mrow><mn>1</mn><mo>−</mo><mi>λ</mi></mrow></mfrac></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\gamma_{t}\sum_{s=0}^{t-1}\lambda^{t-s}\gamma_{s}\leq\gamma_{t}^{2}\sum_{s=0}^{t-1}\lambda^{t-s}\leq\frac{\gamma_{t}^{2}}{1-\lambda}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="A3.SS3.p4" class="ltx_para">
<p id="A3.SS3.p4.1" class="ltx_p"><span id="A3.SS3.p4.1.1" class="ltx_text">Rearranging the recursion and summing over <math id="A3.SS3.p4.m1" class="ltx_Math" alttext="t" display="inline" intent=":literal"><semantics><mi>t</mi><annotation encoding="application/x-tex">t</annotation></semantics></math> from <math id="A3.SS3.p4.m2" class="ltx_Math" alttext="0" display="inline" intent=":literal"><semantics><mn>0</mn><annotation encoding="application/x-tex">0</annotation></semantics></math> to <math id="A3.SS3.p4.m3" class="ltx_Math" alttext="T-1" display="inline" intent=":literal"><semantics><mrow><mi>T</mi><mo>−</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">T-1</annotation></semantics></math> yields</span></p>
<table id="A3.EGx20" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A3.Ex63"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.Ex63.m1" class="ltx_Math" alttext="\displaystyle\sum_{t=0}^{T-1}\gamma_{t}\,\mathbb{E}\big[F_{\bm{S}}(\overline{\bm{w}}^{(t)})-F_{\bm{S}}(\bm{w}_{\bm{S}}^{*})\big]" display="inline" intent=":literal"><semantics><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>t</mi><mo>=</mo><mn>0</mn></mrow><mrow><mi>T</mi><mo>−</mo><mn>1</mn></mrow></munderover></mstyle><mrow><msub><mi>γ</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi>𝔼</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="1.200em" minsize="1.200em">[</mo><mrow><mrow><msub><mi>F</mi><mi>𝑺</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mover accent="true"><mi>𝒘</mi><mo stretchy="true">¯</mo></mover><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msub><mi>F</mi><mi>𝑺</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>𝒘</mi><mi>𝑺</mi><mo>∗</mo></msubsup><mo stretchy="false">)</mo></mrow></mrow></mrow><mo maxsize="1.200em" minsize="1.200em">]</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\sum_{t=0}^{T-1}\gamma_{t}\,\mathbb{E}\big[F_{\bm{S}}(\overline{\bm{w}}^{(t)})-F_{\bm{S}}(\bm{w}_{\bm{S}}^{*})\big]</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex63.m2" class="ltx_Math" alttext="\displaystyle\leq\frac{1}{2}\big\|\overline{\bm{w}}^{(0)}-\bm{w}_{\bm{S}}^{*}\big\|^{2}+\frac{2rCLC_{w_{0}}}{\delta}\sum_{t=0}^{T-1}\gamma_{t}\lambda^{t}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≤</mo><mrow><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mn>2</mn></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo maxsize="1.200em" minsize="1.200em" stretchy="true">‖</mo><mrow><msup><mover accent="true"><mi>𝒘</mi><mo stretchy="true">¯</mo></mover><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></msup><mo>−</mo><msubsup><mi>𝒘</mi><mi>𝑺</mi><mo>∗</mo></msubsup></mrow><mo maxsize="1.200em" minsize="1.200em" stretchy="true">‖</mo></mrow><mn>2</mn></msup></mrow><mo>+</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><mi>L</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>C</mi><msub><mi>w</mi><mn>0</mn></msub></msub></mrow><mi>δ</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>t</mi><mo>=</mo><mn>0</mn></mrow><mrow><mi>T</mi><mo>−</mo><mn>1</mn></mrow></munderover></mstyle><mrow><msub><mi>γ</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><msup><mi>λ</mi><mi>t</mi></msup></mrow></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\leq\frac{1}{2}\big\|\overline{\bm{w}}^{(0)}-\bm{w}_{\bm{S}}^{*}\big\|^{2}+\frac{2rCLC_{w_{0}}}{\delta}\sum_{t=0}^{T-1}\gamma_{t}\lambda^{t}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A3.E66"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.E66.m1" class="ltx_math_unparsed" alttext="\displaystyle\quad+\Big(\frac{2rCLG}{\delta(1-{\lambda})}+\frac{G^{2}}{2}\Big)\sum_{t=0}^{T-1}\gamma_{t}^{2}." display="inline" intent=":literal"><semantics><mrow><mo>+</mo><mrow><mo maxsize="1.600em" minsize="1.600em">(</mo><mstyle displaystyle="true"><mfrac><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><mi>L</mi><mo lspace="0em" rspace="0em">​</mo><mi>G</mi></mrow><mrow><mi>δ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>λ</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle><mo>+</mo><mstyle displaystyle="true"><mfrac><msup><mi>G</mi><mn>2</mn></msup><mn>2</mn></mfrac></mstyle><mo maxsize="1.600em" minsize="1.600em">)</mo></mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>t</mi><mo>=</mo><mn>0</mn></mrow><mrow><mi>T</mi><mo>−</mo><mn>1</mn></mrow></munderover></mstyle><msubsup><mi>γ</mi><mi>t</mi><mn>2</mn></msubsup><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\quad+\Big(\frac{2rCLG}{\delta(1-{\lambda})}+\frac{G^{2}}{2}\Big)\sum_{t=0}^{T-1}\gamma_{t}^{2}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright" colspan="2"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(66)</span></td></tr></tbody>
</table>
</div>
<div id="A3.SS3.p5" class="ltx_para">
<p id="A3.SS3.p5.1" class="ltx_p"><span id="A3.SS3.p5.1.1" class="ltx_text">Recall the definition of the averaged model
<math id="A3.SS3.p5.m1" class="ltx_Math" alttext="\bm{w}_{\text{avg}}^{(T)}=\frac{\sum_{t=0}^{T-1}\gamma_{t}\,\overline{\bm{w}}^{(t)}}{\sum_{t=0}^{T-1}\gamma_{t}}." display="inline" intent=":literal"><semantics><mrow><mrow><msubsup><mi>𝒘</mi><mtext>avg</mtext><mrow><mo stretchy="false">(</mo><mi>T</mi><mo stretchy="false">)</mo></mrow></msubsup><mo>=</mo><mfrac><mrow><mstyle displaystyle="false"><msubsup><mo maxsize="0.700em" minsize="0.700em" stretchy="true">∑</mo><mrow><mi>t</mi><mo>=</mo><mn>0</mn></mrow><mrow><mi>T</mi><mo>−</mo><mn>1</mn></mrow></msubsup></mstyle><mrow><msub><mi>γ</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><msup><mover accent="true"><mi>𝒘</mi><mo stretchy="true">¯</mo></mover><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup></mrow></mrow><mrow><mstyle displaystyle="false"><msubsup><mo maxsize="0.700em" minsize="0.700em" stretchy="true">∑</mo><mrow><mi>t</mi><mo>=</mo><mn>0</mn></mrow><mrow><mi>T</mi><mo>−</mo><mn>1</mn></mrow></msubsup></mstyle><msub><mi>γ</mi><mi>t</mi></msub></mrow></mfrac></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\bm{w}_{\text{avg}}^{(T)}=\frac{\sum_{t=0}^{T-1}\gamma_{t}\,\overline{\bm{w}}^{(t)}}{\sum_{t=0}^{T-1}\gamma_{t}}.</annotation></semantics></math>
By convexity of <math id="A3.SS3.p5.m2" class="ltx_Math" alttext="F_{\bm{S}}" display="inline" intent=":literal"><semantics><msub><mi>F</mi><mi>𝑺</mi></msub><annotation encoding="application/x-tex">F_{\bm{S}}</annotation></semantics></math>, we have</span></p>
<table id="A3.EGx21" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A3.Ex64"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.Ex64.m1" class="ltx_Math" alttext="\displaystyle\epsilon_{\mathrm{opt}}" display="inline" intent=":literal"><semantics><msub><mi>ϵ</mi><mi>opt</mi></msub><annotation encoding="application/x-tex">\displaystyle\epsilon_{\mathrm{opt}}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex64.m2" class="ltx_Math" alttext="\displaystyle=\mathbb{E}\big[F_{\bm{S}}(\bm{w}_{\text{avg}}^{(T)})-F_{\bm{S}}(\bm{w}_{\bm{S}}^{*})\big]\leq\frac{\sum_{t=0}^{T-1}\gamma_{t}\,\mathbb{E}\big[F_{\bm{S}}(\overline{\bm{w}}^{(t)})-F_{\bm{S}}(\bm{w}_{\bm{S}}^{*})\big]}{\sum_{t=0}^{T-1}\gamma_{t}}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo maxsize="1.200em" minsize="1.200em">[</mo><mrow><mrow><msub><mi>F</mi><mi>𝑺</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>𝒘</mi><mtext>avg</mtext><mrow><mo stretchy="false">(</mo><mi>T</mi><mo stretchy="false">)</mo></mrow></msubsup><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msub><mi>F</mi><mi>𝑺</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>𝒘</mi><mi>𝑺</mi><mo>∗</mo></msubsup><mo stretchy="false">)</mo></mrow></mrow></mrow><mo maxsize="1.200em" minsize="1.200em">]</mo></mrow></mrow><mo>≤</mo><mstyle displaystyle="true"><mfrac><mrow><msubsup><mo>∑</mo><mrow><mi>t</mi><mo>=</mo><mn>0</mn></mrow><mrow><mi>T</mi><mo>−</mo><mn>1</mn></mrow></msubsup><mrow><msub><mi>γ</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi>𝔼</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="1.200em" minsize="1.200em">[</mo><mrow><mrow><msub><mi>F</mi><mi>𝑺</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mover accent="true"><mi>𝒘</mi><mo stretchy="true">¯</mo></mover><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msub><mi>F</mi><mi>𝑺</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>𝒘</mi><mi>𝑺</mi><mo>∗</mo></msubsup><mo stretchy="false">)</mo></mrow></mrow></mrow><mo maxsize="1.200em" minsize="1.200em">]</mo></mrow></mrow></mrow><mrow><msubsup><mo>∑</mo><mrow><mi>t</mi><mo>=</mo><mn>0</mn></mrow><mrow><mi>T</mi><mo>−</mo><mn>1</mn></mrow></msubsup><msub><mi>γ</mi><mi>t</mi></msub></mrow></mfrac></mstyle></mrow><annotation encoding="application/x-tex">\displaystyle=\mathbb{E}\big[F_{\bm{S}}(\bm{w}_{\text{avg}}^{(T)})-F_{\bm{S}}(\bm{w}_{\bm{S}}^{*})\big]\leq\frac{\sum_{t=0}^{T-1}\gamma_{t}\,\mathbb{E}\big[F_{\bm{S}}(\overline{\bm{w}}^{(t)})-F_{\bm{S}}(\bm{w}_{\bm{S}}^{*})\big]}{\sum_{t=0}^{T-1}\gamma_{t}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A3.E67"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.E67.m1" class="ltx_Math" alttext="\displaystyle\leq\frac{\big\|\overline{\bm{w}}^{(0)}-\bm{w}_{\bm{S}}^{*}\big\|^{2}}{2\sum_{t=0}^{T-1}\gamma_{t}}+\frac{2rCLC_{w_{0}}}{\delta\sum_{t=0}^{T-1}\gamma_{t}}\sum_{t=0}^{T-1}\gamma_{t}{\lambda}^{t}+\Big(\frac{2rCLG}{\delta(1-{\lambda})}+\frac{G^{2}}{2}\Big)\frac{\sum_{t=0}^{T-1}\gamma_{t}^{2}}{\sum_{t=0}^{T-1}\gamma_{t}}." display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>≤</mo><mrow><mstyle displaystyle="true"><mfrac><msup><mrow><mo maxsize="1.200em" minsize="1.200em" stretchy="true">‖</mo><mrow><msup><mover accent="true"><mi>𝒘</mi><mo stretchy="true">¯</mo></mover><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></msup><mo>−</mo><msubsup><mi>𝒘</mi><mi>𝑺</mi><mo>∗</mo></msubsup></mrow><mo maxsize="1.200em" minsize="1.200em" stretchy="true">‖</mo></mrow><mn>2</mn></msup><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mrow><msubsup><mo>∑</mo><mrow><mi>t</mi><mo>=</mo><mn>0</mn></mrow><mrow><mi>T</mi><mo>−</mo><mn>1</mn></mrow></msubsup><msub><mi>γ</mi><mi>t</mi></msub></mrow></mrow></mfrac></mstyle><mo>+</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><mi>L</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>C</mi><msub><mi>w</mi><mn>0</mn></msub></msub></mrow><mrow><mi>δ</mi><mo lspace="0em" rspace="0em">​</mo><mrow><msubsup><mo>∑</mo><mrow><mi>t</mi><mo>=</mo><mn>0</mn></mrow><mrow><mi>T</mi><mo>−</mo><mn>1</mn></mrow></msubsup><msub><mi>γ</mi><mi>t</mi></msub></mrow></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>t</mi><mo>=</mo><mn>0</mn></mrow><mrow><mi>T</mi><mo>−</mo><mn>1</mn></mrow></munderover></mstyle><mrow><msub><mi>γ</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><msup><mi>λ</mi><mi>t</mi></msup></mrow></mrow></mrow><mo>+</mo><mrow><mrow><mo maxsize="1.600em" minsize="1.600em">(</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><mi>L</mi><mo lspace="0em" rspace="0em">​</mo><mi>G</mi></mrow><mrow><mi>δ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>λ</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle><mo>+</mo><mstyle displaystyle="true"><mfrac><msup><mi>G</mi><mn>2</mn></msup><mn>2</mn></mfrac></mstyle></mrow><mo maxsize="1.600em" minsize="1.600em">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><mrow><msubsup><mo>∑</mo><mrow><mi>t</mi><mo>=</mo><mn>0</mn></mrow><mrow><mi>T</mi><mo>−</mo><mn>1</mn></mrow></msubsup><msubsup><mi>γ</mi><mi>t</mi><mn>2</mn></msubsup></mrow><mrow><msubsup><mo>∑</mo><mrow><mi>t</mi><mo>=</mo><mn>0</mn></mrow><mrow><mi>T</mi><mo>−</mo><mn>1</mn></mrow></msubsup><msub><mi>γ</mi><mi>t</mi></msub></mrow></mfrac></mstyle></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\leq\frac{\big\|\overline{\bm{w}}^{(0)}-\bm{w}_{\bm{S}}^{*}\big\|^{2}}{2\sum_{t=0}^{T-1}\gamma_{t}}+\frac{2rCLC_{w_{0}}}{\delta\sum_{t=0}^{T-1}\gamma_{t}}\sum_{t=0}^{T-1}\gamma_{t}{\lambda}^{t}+\Big(\frac{2rCLG}{\delta(1-{\lambda})}+\frac{G^{2}}{2}\Big)\frac{\sum_{t=0}^{T-1}\gamma_{t}^{2}}{\sum_{t=0}^{T-1}\gamma_{t}}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(67)</span></td></tr></tbody>
</table>
</div>
<div id="A3.SS3.p6" class="ltx_para">
<p id="A3.SS3.p6.1" class="ltx_p"><span id="A3.SS3.p6.1.1" class="ltx_text">This completes the proof of Theorem <a href="#Thmtheorem26" title="Theorem 26 (Optimization Error). ‣ 4.2 Results on Convex Case ‣ 4 Theoretical Analysis ‣ Stability and Generalization of Push-Sum Based Decentralized Optimization over Directed Graphs" class="ltx_ref"><span class="ltx_text ltx_ref_tag">26</span></a>.
∎</span></p>
</div>
</div>
</section>
<section id="A3.SS4" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">C.4 </span>Proof of Corollary <a href="#Thmtheorem27" title="Corollary 27 (Optimization Error on Common Learning Rate). ‣ 4.2 Results on Convex Case ‣ 4 Theoretical Analysis ‣ Stability and Generalization of Push-Sum Based Decentralized Optimization over Directed Graphs" class="ltx_ref"><span class="ltx_text ltx_ref_tag">27</span></a></h3>

<div id="A3.SS4.2" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
</div>
<section id="A3.SS4.SSS0.Px1" class="ltx_paragraph">
<h4 class="ltx_title ltx_title_paragraph">Case 1: Constant learning rate.</h4>

<div id="A3.SS4.SSS0.Px1.p1" class="ltx_para">
<p id="A3.SS4.SSS0.Px1.p1.1" class="ltx_p">For constant learning rates <math id="A3.SS4.SSS0.Px1.p1.m1" class="ltx_Math" alttext="\gamma_{t}=\gamma" display="inline" intent=":literal"><semantics><mrow><msub><mi>γ</mi><mi>t</mi></msub><mo>=</mo><mi>γ</mi></mrow><annotation encoding="application/x-tex">\gamma_{t}=\gamma</annotation></semantics></math>, substituting into Theorem <a href="#Thmtheorem26" title="Theorem 26 (Optimization Error). ‣ 4.2 Results on Convex Case ‣ 4 Theoretical Analysis ‣ Stability and Generalization of Push-Sum Based Decentralized Optimization over Directed Graphs" class="ltx_ref"><span class="ltx_text ltx_ref_tag">26</span></a> yields</p>
<table id="A3.EGx22" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A3.Ex65"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.Ex65.m1" class="ltx_Math" alttext="\displaystyle\epsilon_{\mathrm{opt}}" display="inline" intent=":literal"><semantics><msub><mi>ϵ</mi><mi>opt</mi></msub><annotation encoding="application/x-tex">\displaystyle\epsilon_{\mathrm{opt}}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex65.m2" class="ltx_Math" alttext="\displaystyle\leq\frac{\|\overline{\bm{w}}^{(0)}-\bm{w}_{\bm{S}}^{*}\|^{2}}{2\sum_{t=0}^{T-1}\gamma}+\frac{2rCLC_{w_{0}}}{\delta\sum_{t=0}^{T-1}\gamma}\sum_{t=0}^{T-1}\gamma{\lambda}^{t}+\Big(\frac{2rCLG}{\delta(1-{\lambda})}+\frac{G^{2}}{2}\Big)\frac{\sum_{t=0}^{T-1}\gamma^{2}}{\sum_{t=0}^{T-1}\gamma}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≤</mo><mrow><mstyle displaystyle="true"><mfrac><msup><mrow><mo stretchy="false">‖</mo><mrow><msup><mover accent="true"><mi>𝒘</mi><mo stretchy="true">¯</mo></mover><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></msup><mo>−</mo><msubsup><mi>𝒘</mi><mi>𝑺</mi><mo>∗</mo></msubsup></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mrow><msubsup><mo>∑</mo><mrow><mi>t</mi><mo>=</mo><mn>0</mn></mrow><mrow><mi>T</mi><mo>−</mo><mn>1</mn></mrow></msubsup><mi>γ</mi></mrow></mrow></mfrac></mstyle><mo>+</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><mi>L</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>C</mi><msub><mi>w</mi><mn>0</mn></msub></msub></mrow><mrow><mi>δ</mi><mo lspace="0em" rspace="0em">​</mo><mrow><msubsup><mo>∑</mo><mrow><mi>t</mi><mo>=</mo><mn>0</mn></mrow><mrow><mi>T</mi><mo>−</mo><mn>1</mn></mrow></msubsup><mi>γ</mi></mrow></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>t</mi><mo>=</mo><mn>0</mn></mrow><mrow><mi>T</mi><mo>−</mo><mn>1</mn></mrow></munderover></mstyle><mrow><mi>γ</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>λ</mi><mi>t</mi></msup></mrow></mrow></mrow><mo>+</mo><mrow><mrow><mo maxsize="1.600em" minsize="1.600em">(</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><mi>L</mi><mo lspace="0em" rspace="0em">​</mo><mi>G</mi></mrow><mrow><mi>δ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>λ</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle><mo>+</mo><mstyle displaystyle="true"><mfrac><msup><mi>G</mi><mn>2</mn></msup><mn>2</mn></mfrac></mstyle></mrow><mo maxsize="1.600em" minsize="1.600em">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><mrow><msubsup><mo>∑</mo><mrow><mi>t</mi><mo>=</mo><mn>0</mn></mrow><mrow><mi>T</mi><mo>−</mo><mn>1</mn></mrow></msubsup><msup><mi>γ</mi><mn>2</mn></msup></mrow><mrow><msubsup><mo>∑</mo><mrow><mi>t</mi><mo>=</mo><mn>0</mn></mrow><mrow><mi>T</mi><mo>−</mo><mn>1</mn></mrow></msubsup><mi>γ</mi></mrow></mfrac></mstyle></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\leq\frac{\|\overline{\bm{w}}^{(0)}-\bm{w}_{\bm{S}}^{*}\|^{2}}{2\sum_{t=0}^{T-1}\gamma}+\frac{2rCLC_{w_{0}}}{\delta\sum_{t=0}^{T-1}\gamma}\sum_{t=0}^{T-1}\gamma{\lambda}^{t}+\Big(\frac{2rCLG}{\delta(1-{\lambda})}+\frac{G^{2}}{2}\Big)\frac{\sum_{t=0}^{T-1}\gamma^{2}}{\sum_{t=0}^{T-1}\gamma}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A3.Ex66"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex66.m1" class="ltx_Math" alttext="\displaystyle=\frac{\|\overline{\bm{w}}^{(0)}-\bm{w}_{\bm{S}}^{*}\|^{2}}{2T\gamma}+\frac{2rCLC_{w_{0}}}{\delta T}\sum_{t=0}^{T-1}{\lambda}^{t}+\Big(\frac{2rCLG}{\delta(1-{\lambda})}+\frac{G^{2}}{2}\Big)\gamma" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mstyle displaystyle="true"><mfrac><msup><mrow><mo stretchy="false">‖</mo><mrow><msup><mover accent="true"><mi>𝒘</mi><mo stretchy="true">¯</mo></mover><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></msup><mo>−</mo><msubsup><mi>𝒘</mi><mi>𝑺</mi><mo>∗</mo></msubsup></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>T</mi><mo lspace="0em" rspace="0em">​</mo><mi>γ</mi></mrow></mfrac></mstyle><mo>+</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><mi>L</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>C</mi><msub><mi>w</mi><mn>0</mn></msub></msub></mrow><mrow><mi>δ</mi><mo lspace="0em" rspace="0em">​</mo><mi>T</mi></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>t</mi><mo>=</mo><mn>0</mn></mrow><mrow><mi>T</mi><mo>−</mo><mn>1</mn></mrow></munderover></mstyle><msup><mi>λ</mi><mi>t</mi></msup></mrow></mrow><mo>+</mo><mrow><mrow><mo maxsize="1.600em" minsize="1.600em">(</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><mi>L</mi><mo lspace="0em" rspace="0em">​</mo><mi>G</mi></mrow><mrow><mi>δ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>λ</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle><mo>+</mo><mstyle displaystyle="true"><mfrac><msup><mi>G</mi><mn>2</mn></msup><mn>2</mn></mfrac></mstyle></mrow><mo maxsize="1.600em" minsize="1.600em">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>γ</mi></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\frac{\|\overline{\bm{w}}^{(0)}-\bm{w}_{\bm{S}}^{*}\|^{2}}{2T\gamma}+\frac{2rCLC_{w_{0}}}{\delta T}\sum_{t=0}^{T-1}{\lambda}^{t}+\Big(\frac{2rCLG}{\delta(1-{\lambda})}+\frac{G^{2}}{2}\Big)\gamma</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A3.Ex67"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex67.m1" class="ltx_Math" alttext="\displaystyle\overset{(a)}{\leq}\frac{\|\overline{\bm{w}}^{(0)}-\bm{w}_{\bm{S}}^{*}\|^{2}}{2T\gamma}+\frac{2rCLC_{w_{0}}}{\delta T(1-{\lambda})}+\Big(\frac{2rCLG}{\delta(1-{\lambda})}+\frac{G^{2}}{2}\Big)\gamma" display="inline" intent=":literal"><semantics><mrow><mrow><mover accent="true"><mo>≤</mo><mrow><mo maxsize="0.700em" minsize="0.700em">(</mo><mi mathsize="0.700em">a</mi><mo maxsize="0.700em" minsize="0.700em">)</mo></mrow></mover><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><msup><mrow><mo stretchy="false">‖</mo><mrow><msup><mover accent="true"><mi>𝒘</mi><mo stretchy="true">¯</mo></mover><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></msup><mo>−</mo><msubsup><mi>𝒘</mi><mi>𝑺</mi><mo>∗</mo></msubsup></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>T</mi><mo lspace="0em" rspace="0em">​</mo><mi>γ</mi></mrow></mfrac></mstyle></mrow><mo>+</mo><mstyle displaystyle="true"><mfrac><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><mi>L</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>C</mi><msub><mi>w</mi><mn>0</mn></msub></msub></mrow><mrow><mi>δ</mi><mo lspace="0em" rspace="0em">​</mo><mi>T</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>λ</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle><mo>+</mo><mrow><mrow><mo maxsize="1.600em" minsize="1.600em">(</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><mi>L</mi><mo lspace="0em" rspace="0em">​</mo><mi>G</mi></mrow><mrow><mi>δ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>λ</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle><mo>+</mo><mstyle displaystyle="true"><mfrac><msup><mi>G</mi><mn>2</mn></msup><mn>2</mn></mfrac></mstyle></mrow><mo maxsize="1.600em" minsize="1.600em">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>γ</mi></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\overset{(a)}{\leq}\frac{\|\overline{\bm{w}}^{(0)}-\bm{w}_{\bm{S}}^{*}\|^{2}}{2T\gamma}+\frac{2rCLC_{w_{0}}}{\delta T(1-{\lambda})}+\Big(\frac{2rCLG}{\delta(1-{\lambda})}+\frac{G^{2}}{2}\Big)\gamma</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A3.E68"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.E68.m1" class="ltx_Math" alttext="\displaystyle=\left(\frac{\|\overline{\bm{w}}^{(0)}-\bm{w}_{\bm{S}}^{*}\|^{2}}{2\gamma}+\frac{2rCLC_{w_{0}}}{\delta(1-{\lambda})}\right)\frac{1}{T}+\frac{2rCLG}{\delta(1-{\lambda})}\gamma+\frac{G^{2}\gamma}{2}." display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><mrow><mo>(</mo><mrow><mstyle displaystyle="true"><mfrac><msup><mrow><mo stretchy="false">‖</mo><mrow><msup><mover accent="true"><mi>𝒘</mi><mo stretchy="true">¯</mo></mover><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></msup><mo>−</mo><msubsup><mi>𝒘</mi><mi>𝑺</mi><mo>∗</mo></msubsup></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>γ</mi></mrow></mfrac></mstyle><mo>+</mo><mstyle displaystyle="true"><mfrac><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><mi>L</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>C</mi><msub><mi>w</mi><mn>0</mn></msub></msub></mrow><mrow><mi>δ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>λ</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>T</mi></mfrac></mstyle></mrow><mo>+</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><mi>L</mi><mo lspace="0em" rspace="0em">​</mo><mi>G</mi></mrow><mrow><mi>δ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>λ</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mi>γ</mi></mrow><mo>+</mo><mstyle displaystyle="true"><mfrac><mrow><msup><mi>G</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mi>γ</mi></mrow><mn>2</mn></mfrac></mstyle></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle=\left(\frac{\|\overline{\bm{w}}^{(0)}-\bm{w}_{\bm{S}}^{*}\|^{2}}{2\gamma}+\frac{2rCLC_{w_{0}}}{\delta(1-{\lambda})}\right)\frac{1}{T}+\frac{2rCLG}{\delta(1-{\lambda})}\gamma+\frac{G^{2}\gamma}{2}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(68)</span></td></tr></tbody>
</table>
</div>
</section>
<section id="A3.SS4.SSS0.Px2" class="ltx_paragraph">
<h4 class="ltx_title ltx_title_paragraph">Case 2: Decreasing learning rate.</h4>

<div id="A3.SS4.SSS0.Px2.p1" class="ltx_para">
<p id="A3.SS4.SSS0.Px2.p1.1" class="ltx_p">For decreasing step sizes <math id="A3.SS4.SSS0.Px2.p1.m1" class="ltx_Math" alttext="\gamma_{t}=\frac{v}{t+1}" display="inline" intent=":literal"><semantics><mrow><msub><mi>γ</mi><mi>t</mi></msub><mo>=</mo><mfrac><mi>v</mi><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow></mfrac></mrow><annotation encoding="application/x-tex">\gamma_{t}=\frac{v}{t+1}</annotation></semantics></math>, substituting into Theorem <a href="#Thmtheorem26" title="Theorem 26 (Optimization Error). ‣ 4.2 Results on Convex Case ‣ 4 Theoretical Analysis ‣ Stability and Generalization of Push-Sum Based Decentralized Optimization over Directed Graphs" class="ltx_ref"><span class="ltx_text ltx_ref_tag">26</span></a> yields</p>
<table id="A3.EGx23" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A3.Ex69"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.Ex69.m1" class="ltx_Math" alttext="\displaystyle\epsilon_{\mathrm{opt}}" display="inline" intent=":literal"><semantics><msub><mi>ϵ</mi><mi>opt</mi></msub><annotation encoding="application/x-tex">\displaystyle\epsilon_{\mathrm{opt}}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex69.m2" class="ltx_Math" alttext="\displaystyle\leq\frac{\|\overline{\bm{w}}^{(0)}-\bm{w}_{\bm{S}}^{*}\|^{2}}{2\sum_{t=0}^{T-1}\frac{v}{t+1}}+\frac{2rCLC_{w_{0}}}{\delta\sum_{t=0}^{T-1}\frac{v}{t+1}}\sum_{t=0}^{T-1}\frac{v}{t+1}{\lambda}^{t}+\Big(\frac{2rCLG}{\delta(1-{\lambda})}+\frac{G^{2}}{2}\Big)\frac{\sum_{t=0}^{T-1}\big(\frac{v}{t+1}\big)^{2}}{\sum_{t=0}^{T-1}\frac{v}{t+1}}." display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>≤</mo><mrow><mstyle displaystyle="true"><mfrac><msup><mrow><mo stretchy="false">‖</mo><mrow><msup><mover accent="true"><mi>𝒘</mi><mo stretchy="true">¯</mo></mover><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></msup><mo>−</mo><msubsup><mi>𝒘</mi><mi>𝑺</mi><mo>∗</mo></msubsup></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mrow><msubsup><mo>∑</mo><mrow><mi>t</mi><mo>=</mo><mn>0</mn></mrow><mrow><mi>T</mi><mo>−</mo><mn>1</mn></mrow></msubsup><mfrac><mi>v</mi><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow></mfrac></mrow></mrow></mfrac></mstyle><mo>+</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><mi>L</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>C</mi><msub><mi>w</mi><mn>0</mn></msub></msub></mrow><mrow><mi>δ</mi><mo lspace="0em" rspace="0em">​</mo><mrow><msubsup><mo>∑</mo><mrow><mi>t</mi><mo>=</mo><mn>0</mn></mrow><mrow><mi>T</mi><mo>−</mo><mn>1</mn></mrow></msubsup><mfrac><mi>v</mi><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow></mfrac></mrow></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>t</mi><mo>=</mo><mn>0</mn></mrow><mrow><mi>T</mi><mo>−</mo><mn>1</mn></mrow></munderover></mstyle><mrow><mstyle displaystyle="true"><mfrac><mi>v</mi><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msup><mi>λ</mi><mi>t</mi></msup></mrow></mrow></mrow><mo>+</mo><mrow><mrow><mo maxsize="1.600em" minsize="1.600em">(</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><mi>L</mi><mo lspace="0em" rspace="0em">​</mo><mi>G</mi></mrow><mrow><mi>δ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>λ</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle><mo>+</mo><mstyle displaystyle="true"><mfrac><msup><mi>G</mi><mn>2</mn></msup><mn>2</mn></mfrac></mstyle></mrow><mo maxsize="1.600em" minsize="1.600em">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><mrow><msubsup><mo>∑</mo><mrow><mi>t</mi><mo>=</mo><mn>0</mn></mrow><mrow><mi>T</mi><mo>−</mo><mn>1</mn></mrow></msubsup><msup><mrow><mo lspace="0em" maxsize="1.200em" minsize="1.200em">(</mo><mfrac><mi>v</mi><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow></mfrac><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow><mn>2</mn></msup></mrow><mrow><msubsup><mo>∑</mo><mrow><mi>t</mi><mo>=</mo><mn>0</mn></mrow><mrow><mi>T</mi><mo>−</mo><mn>1</mn></mrow></msubsup><mfrac><mi>v</mi><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow></mfrac></mrow></mfrac></mstyle></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\leq\frac{\|\overline{\bm{w}}^{(0)}-\bm{w}_{\bm{S}}^{*}\|^{2}}{2\sum_{t=0}^{T-1}\frac{v}{t+1}}+\frac{2rCLC_{w_{0}}}{\delta\sum_{t=0}^{T-1}\frac{v}{t+1}}\sum_{t=0}^{T-1}\frac{v}{t+1}{\lambda}^{t}+\Big(\frac{2rCLG}{\delta(1-{\lambda})}+\frac{G^{2}}{2}\Big)\frac{\sum_{t=0}^{T-1}\big(\frac{v}{t+1}\big)^{2}}{\sum_{t=0}^{T-1}\frac{v}{t+1}}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A3.SS4.SSS0.Px2.p1.2" class="ltx_p">Using the lower bound</p>
<table id="A3.Ex70" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A3.Ex70.m1" class="ltx_Math" alttext="\sum_{t=0}^{T-1}\frac{1}{t+1}\geq\sum_{t=1}^{T-1}\frac{1}{t+1}\geq\frac{1}{2}\sum_{t=1}^{T-1}\frac{1}{t}\geq\frac{1}{2}\sum_{t=1}^{T-1}\int_{t}^{t+1}\frac{1}{x}\,dx\geq\frac{1}{2}\ln{T}," display="block" intent=":literal"><semantics><mrow><mrow><mrow><munderover><mo movablelimits="false">∑</mo><mrow><mi>t</mi><mo>=</mo><mn>0</mn></mrow><mrow><mi>T</mi><mo>−</mo><mn>1</mn></mrow></munderover><mfrac><mn>1</mn><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow></mfrac></mrow><mo rspace="0.111em">≥</mo><mrow><munderover><mo movablelimits="false">∑</mo><mrow><mi>t</mi><mo>=</mo><mn>1</mn></mrow><mrow><mi>T</mi><mo>−</mo><mn>1</mn></mrow></munderover><mfrac><mn>1</mn><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow></mfrac></mrow><mo>≥</mo><mrow><mfrac><mn>1</mn><mn>2</mn></mfrac><mo lspace="0em" rspace="0em">​</mo><mrow><munderover><mo movablelimits="false">∑</mo><mrow><mi>t</mi><mo>=</mo><mn>1</mn></mrow><mrow><mi>T</mi><mo>−</mo><mn>1</mn></mrow></munderover><mfrac><mn>1</mn><mi>t</mi></mfrac></mrow></mrow><mo>≥</mo><mrow><mfrac><mn>1</mn><mn>2</mn></mfrac><mo lspace="0em" rspace="0em">​</mo><mrow><munderover><mo movablelimits="false" rspace="0em">∑</mo><mrow><mi>t</mi><mo>=</mo><mn>1</mn></mrow><mrow><mi>T</mi><mo>−</mo><mn>1</mn></mrow></munderover><mrow><msubsup><mo>∫</mo><mi>t</mi><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow></msubsup><mrow><mfrac><mn>1</mn><mi>x</mi></mfrac><mo lspace="0.170em" rspace="0em">​</mo><mrow><mo rspace="0em">𝑑</mo><mi>x</mi></mrow></mrow></mrow></mrow></mrow><mo>≥</mo><mrow><mfrac><mn>1</mn><mn>2</mn></mfrac><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>ln</mi><mo lspace="0.167em">⁡</mo><mi>T</mi></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\sum_{t=0}^{T-1}\frac{1}{t+1}\geq\sum_{t=1}^{T-1}\frac{1}{t+1}\geq\frac{1}{2}\sum_{t=1}^{T-1}\frac{1}{t}\geq\frac{1}{2}\sum_{t=1}^{T-1}\int_{t}^{t+1}\frac{1}{x}\,dx\geq\frac{1}{2}\ln{T},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A3.SS4.SSS0.Px2.p1.3" class="ltx_p">we have <math id="A3.SS4.SSS0.Px2.p1.m2" class="ltx_Math" alttext="\sum_{t=0}^{T-1}\frac{v}{t+1}\geq\frac{v}{2}\ln T" display="inline" intent=":literal"><semantics><mrow><mrow><msubsup><mo>∑</mo><mrow><mi>t</mi><mo>=</mo><mn>0</mn></mrow><mrow><mi>T</mi><mo>−</mo><mn>1</mn></mrow></msubsup><mfrac><mi>v</mi><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow></mfrac></mrow><mo>≥</mo><mrow><mfrac><mi>v</mi><mn>2</mn></mfrac><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>ln</mi><mo lspace="0.167em">⁡</mo><mi>T</mi></mrow></mrow></mrow><annotation encoding="application/x-tex">\sum_{t=0}^{T-1}\frac{v}{t+1}\geq\frac{v}{2}\ln T</annotation></semantics></math>. Moreover,
<math id="A3.SS4.SSS0.Px2.p1.m3" class="ltx_Math" alttext="\sum_{t=0}^{T-1}\frac{1}{(t+1)^{2}}\leq 2,\sum_{t=0}^{T-1}\frac{\lambda^{t}}{t+1}\leq\sum_{t=0}^{T-1}\lambda^{t}." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mrow><msubsup><mo>∑</mo><mrow><mi>t</mi><mo>=</mo><mn>0</mn></mrow><mrow><mi>T</mi><mo>−</mo><mn>1</mn></mrow></msubsup><mfrac><mn>1</mn><msup><mrow><mo stretchy="false">(</mo><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mfrac></mrow><mo>≤</mo><mn>2</mn></mrow><mo rspace="0em">,</mo><mrow><mrow><msubsup><mo>∑</mo><mrow><mi>t</mi><mo>=</mo><mn>0</mn></mrow><mrow><mi>T</mi><mo>−</mo><mn>1</mn></mrow></msubsup><mfrac><msup><mi>λ</mi><mi>t</mi></msup><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow></mfrac></mrow><mo rspace="0.111em">≤</mo><mrow><msubsup><mo>∑</mo><mrow><mi>t</mi><mo>=</mo><mn>0</mn></mrow><mrow><mi>T</mi><mo>−</mo><mn>1</mn></mrow></msubsup><msup><mi>λ</mi><mi>t</mi></msup></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\sum_{t=0}^{T-1}\frac{1}{(t+1)^{2}}\leq 2,\sum_{t=0}^{T-1}\frac{\lambda^{t}}{t+1}\leq\sum_{t=0}^{T-1}\lambda^{t}.</annotation></semantics></math></p>
</div>
<div id="A3.SS4.SSS0.Px2.p2" class="ltx_para">
<p id="A3.SS4.SSS0.Px2.p2.1" class="ltx_p">Therefore,</p>
<table id="A3.EGx24" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A3.Ex72"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.Ex72.m1" class="ltx_Math" alttext="\displaystyle\epsilon_{\mathrm{opt}}" display="inline" intent=":literal"><semantics><msub><mi>ϵ</mi><mi>opt</mi></msub><annotation encoding="application/x-tex">\displaystyle\epsilon_{\mathrm{opt}}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex72.m2" class="ltx_Math" alttext="\displaystyle\leq\frac{\|\overline{\bm{w}}^{(0)}-\bm{w}_{\bm{S}}^{*}\|^{2}}{v\ln T}+\frac{2rCLC_{w_{0}}}{\delta}\cdot\frac{\sum_{t=0}^{T-1}\frac{\lambda^{t}}{t+1}}{\sum_{t=0}^{T-1}\frac{1}{t+1}}+\Big(\frac{2rCLG}{\delta(1-{\lambda})}+\frac{G^{2}}{2}\Big)\cdot\frac{v\sum_{t=0}^{T-1}\frac{1}{(t+1)^{2}}}{\sum_{t=0}^{T-1}\frac{1}{t+1}}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≤</mo><mrow><mstyle displaystyle="true"><mfrac><msup><mrow><mo stretchy="false">‖</mo><mrow><msup><mover accent="true"><mi>𝒘</mi><mo stretchy="true">¯</mo></mover><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></msup><mo>−</mo><msubsup><mi>𝒘</mi><mi>𝑺</mi><mo>∗</mo></msubsup></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup><mrow><mi>v</mi><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>ln</mi><mo lspace="0.167em">⁡</mo><mi>T</mi></mrow></mrow></mfrac></mstyle><mo>+</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><mi>L</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>C</mi><msub><mi>w</mi><mn>0</mn></msub></msub></mrow><mi>δ</mi></mfrac></mstyle><mo lspace="0.222em" rspace="0.222em">⋅</mo><mstyle displaystyle="true"><mfrac><mrow><msubsup><mo>∑</mo><mrow><mi>t</mi><mo>=</mo><mn>0</mn></mrow><mrow><mi>T</mi><mo>−</mo><mn>1</mn></mrow></msubsup><mfrac><msup><mi>λ</mi><mi>t</mi></msup><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow></mfrac></mrow><mrow><msubsup><mo>∑</mo><mrow><mi>t</mi><mo>=</mo><mn>0</mn></mrow><mrow><mi>T</mi><mo>−</mo><mn>1</mn></mrow></msubsup><mfrac><mn>1</mn><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow></mfrac></mrow></mfrac></mstyle></mrow><mo>+</mo><mrow><mrow><mo maxsize="1.600em" minsize="1.600em">(</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><mi>L</mi><mo lspace="0em" rspace="0em">​</mo><mi>G</mi></mrow><mrow><mi>δ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>λ</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle><mo>+</mo><mstyle displaystyle="true"><mfrac><msup><mi>G</mi><mn>2</mn></msup><mn>2</mn></mfrac></mstyle></mrow><mo maxsize="1.600em" minsize="1.600em" rspace="0.055em">)</mo></mrow><mo rspace="0.222em">⋅</mo><mstyle displaystyle="true"><mfrac><mrow><mi>v</mi><mo lspace="0em" rspace="0em">​</mo><mrow><msubsup><mo>∑</mo><mrow><mi>t</mi><mo>=</mo><mn>0</mn></mrow><mrow><mi>T</mi><mo>−</mo><mn>1</mn></mrow></msubsup><mfrac><mn>1</mn><msup><mrow><mo stretchy="false">(</mo><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mfrac></mrow></mrow><mrow><msubsup><mo>∑</mo><mrow><mi>t</mi><mo>=</mo><mn>0</mn></mrow><mrow><mi>T</mi><mo>−</mo><mn>1</mn></mrow></msubsup><mfrac><mn>1</mn><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow></mfrac></mrow></mfrac></mstyle></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\leq\frac{\|\overline{\bm{w}}^{(0)}-\bm{w}_{\bm{S}}^{*}\|^{2}}{v\ln T}+\frac{2rCLC_{w_{0}}}{\delta}\cdot\frac{\sum_{t=0}^{T-1}\frac{\lambda^{t}}{t+1}}{\sum_{t=0}^{T-1}\frac{1}{t+1}}+\Big(\frac{2rCLG}{\delta(1-{\lambda})}+\frac{G^{2}}{2}\Big)\cdot\frac{v\sum_{t=0}^{T-1}\frac{1}{(t+1)^{2}}}{\sum_{t=0}^{T-1}\frac{1}{t+1}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A3.Ex73"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex73.m1" class="ltx_Math" alttext="\displaystyle\leq\frac{\|\overline{\bm{w}}^{(0)}-\bm{w}_{\bm{S}}^{*}\|^{2}}{v\ln T}+\frac{4rCLC_{w_{0}}}{\delta\ln T}\sum_{t=0}^{T-1}\lambda^{t}+\Big(\frac{2rCLG}{\delta(1-{\lambda})}+\frac{G^{2}}{2}\Big)\frac{4v}{\ln T}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≤</mo><mrow><mstyle displaystyle="true"><mfrac><msup><mrow><mo stretchy="false">‖</mo><mrow><msup><mover accent="true"><mi>𝒘</mi><mo stretchy="true">¯</mo></mover><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></msup><mo>−</mo><msubsup><mi>𝒘</mi><mi>𝑺</mi><mo>∗</mo></msubsup></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup><mrow><mi>v</mi><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>ln</mi><mo lspace="0.167em">⁡</mo><mi>T</mi></mrow></mrow></mfrac></mstyle><mo>+</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mn>4</mn><mo lspace="0em" rspace="0em">​</mo><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><mi>L</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>C</mi><msub><mi>w</mi><mn>0</mn></msub></msub></mrow><mrow><mi>δ</mi><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>ln</mi><mo lspace="0.167em">⁡</mo><mi>T</mi></mrow></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>t</mi><mo>=</mo><mn>0</mn></mrow><mrow><mi>T</mi><mo>−</mo><mn>1</mn></mrow></munderover></mstyle><msup><mi>λ</mi><mi>t</mi></msup></mrow></mrow><mo>+</mo><mrow><mrow><mo maxsize="1.600em" minsize="1.600em">(</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><mi>L</mi><mo lspace="0em" rspace="0em">​</mo><mi>G</mi></mrow><mrow><mi>δ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>λ</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle><mo>+</mo><mstyle displaystyle="true"><mfrac><msup><mi>G</mi><mn>2</mn></msup><mn>2</mn></mfrac></mstyle></mrow><mo maxsize="1.600em" minsize="1.600em">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><mrow><mn>4</mn><mo lspace="0em" rspace="0em">​</mo><mi>v</mi></mrow><mrow><mi>ln</mi><mo lspace="0.167em">⁡</mo><mi>T</mi></mrow></mfrac></mstyle></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\leq\frac{\|\overline{\bm{w}}^{(0)}-\bm{w}_{\bm{S}}^{*}\|^{2}}{v\ln T}+\frac{4rCLC_{w_{0}}}{\delta\ln T}\sum_{t=0}^{T-1}\lambda^{t}+\Big(\frac{2rCLG}{\delta(1-{\lambda})}+\frac{G^{2}}{2}\Big)\frac{4v}{\ln T}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A3.Ex74"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex74.m1" class="ltx_Math" alttext="\displaystyle\overset{(a)}{\leq}\frac{\|\overline{\bm{w}}^{(0)}-\bm{w}_{\bm{S}}^{*}\|^{2}}{v\ln T}+\frac{4rCLC_{w_{0}}}{\delta(1-\lambda)\ln T}+\Big(\frac{2rCLG}{\delta(1-{\lambda})}+\frac{G^{2}}{2}\Big)\frac{4v}{\ln T}" display="inline" intent=":literal"><semantics><mrow><mrow><mover accent="true"><mo>≤</mo><mrow><mo maxsize="0.700em" minsize="0.700em">(</mo><mi mathsize="0.700em">a</mi><mo maxsize="0.700em" minsize="0.700em">)</mo></mrow></mover><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><msup><mrow><mo stretchy="false">‖</mo><mrow><msup><mover accent="true"><mi>𝒘</mi><mo stretchy="true">¯</mo></mover><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></msup><mo>−</mo><msubsup><mi>𝒘</mi><mi>𝑺</mi><mo>∗</mo></msubsup></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup><mrow><mi>v</mi><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>ln</mi><mo lspace="0.167em">⁡</mo><mi>T</mi></mrow></mrow></mfrac></mstyle></mrow><mo>+</mo><mstyle displaystyle="true"><mfrac><mrow><mn>4</mn><mo lspace="0em" rspace="0em">​</mo><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><mi>L</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>C</mi><msub><mi>w</mi><mn>0</mn></msub></msub></mrow><mrow><mrow><mi>δ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>λ</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>ln</mi><mo lspace="0.167em">⁡</mo><mi>T</mi></mrow></mrow></mfrac></mstyle><mo>+</mo><mrow><mrow><mo maxsize="1.600em" minsize="1.600em">(</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><mi>L</mi><mo lspace="0em" rspace="0em">​</mo><mi>G</mi></mrow><mrow><mi>δ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>λ</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle><mo>+</mo><mstyle displaystyle="true"><mfrac><msup><mi>G</mi><mn>2</mn></msup><mn>2</mn></mfrac></mstyle></mrow><mo maxsize="1.600em" minsize="1.600em">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><mrow><mn>4</mn><mo lspace="0em" rspace="0em">​</mo><mi>v</mi></mrow><mrow><mi>ln</mi><mo lspace="0.167em">⁡</mo><mi>T</mi></mrow></mfrac></mstyle></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\overset{(a)}{\leq}\frac{\|\overline{\bm{w}}^{(0)}-\bm{w}_{\bm{S}}^{*}\|^{2}}{v\ln T}+\frac{4rCLC_{w_{0}}}{\delta(1-\lambda)\ln T}+\Big(\frac{2rCLG}{\delta(1-{\lambda})}+\frac{G^{2}}{2}\Big)\frac{4v}{\ln T}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A3.E69"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.E69.m1" class="ltx_Math" alttext="\displaystyle=\Bigg(\frac{\|\overline{\bm{w}}^{(0)}-\bm{w}_{\bm{S}}^{*}\|^{2}}{v}+\frac{4rCLC_{w_{0}}}{\delta(1-\lambda)}+\frac{8vrCLG}{\delta(1-\lambda)}+2vG^{2}\Bigg)\frac{1}{\ln T}." display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><mo maxsize="2.600em" minsize="2.600em">(</mo><mrow><mstyle displaystyle="true"><mfrac><msup><mrow><mo stretchy="false">‖</mo><mrow><msup><mover accent="true"><mi>𝒘</mi><mo stretchy="true">¯</mo></mover><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></msup><mo>−</mo><msubsup><mi>𝒘</mi><mi>𝑺</mi><mo>∗</mo></msubsup></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup><mi>v</mi></mfrac></mstyle><mo>+</mo><mstyle displaystyle="true"><mfrac><mrow><mn>4</mn><mo lspace="0em" rspace="0em">​</mo><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><mi>L</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>C</mi><msub><mi>w</mi><mn>0</mn></msub></msub></mrow><mrow><mi>δ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>λ</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle><mo>+</mo><mstyle displaystyle="true"><mfrac><mrow><mn>8</mn><mo lspace="0em" rspace="0em">​</mo><mi>v</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><mi>L</mi><mo lspace="0em" rspace="0em">​</mo><mi>G</mi></mrow><mrow><mi>δ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>λ</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle><mo>+</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>v</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>G</mi><mn>2</mn></msup></mrow></mrow><mo maxsize="2.600em" minsize="2.600em">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mrow><mi>ln</mi><mo lspace="0.167em">⁡</mo><mi>T</mi></mrow></mfrac></mstyle></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle=\Bigg(\frac{\|\overline{\bm{w}}^{(0)}-\bm{w}_{\bm{S}}^{*}\|^{2}}{v}+\frac{4rCLC_{w_{0}}}{\delta(1-\lambda)}+\frac{8vrCLG}{\delta(1-\lambda)}+2vG^{2}\Bigg)\frac{1}{\ln T}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(69)</span></td></tr></tbody>
</table>
</div>
<div id="A3.SS4.SSS0.Px2.p3" class="ltx_para">
<p id="A3.SS4.SSS0.Px2.p3.1" class="ltx_p">This completes the proof of Corollary <a href="#Thmtheorem27" title="Corollary 27 (Optimization Error on Common Learning Rate). ‣ 4.2 Results on Convex Case ‣ 4 Theoretical Analysis ‣ Stability and Generalization of Push-Sum Based Decentralized Optimization over Directed Graphs" class="ltx_ref"><span class="ltx_text ltx_ref_tag">27</span></a>.
∎</p>
</div>
</section>
</section>
<section id="A3.SS5" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">C.5 </span>Proof of Corollary <a href="#Thmtheorem29" title="Corollary 29 (Excess Generalization Error on Common Learning Rate). ‣ 4.2 Results on Convex Case ‣ 4 Theoretical Analysis ‣ Stability and Generalization of Push-Sum Based Decentralized Optimization over Directed Graphs" class="ltx_ref"><span class="ltx_text ltx_ref_tag">29</span></a> </h3>

<div id="A3.SS5.2" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
</div>
<section id="A3.SS5.SSS0.Px1" class="ltx_paragraph">
<h4 class="ltx_title ltx_title_paragraph">Case 1 :Constant learning rate.</h4>

<div id="A3.SS5.SSS0.Px1.p1" class="ltx_para">
<p id="A3.SS5.SSS0.Px1.p1.1" class="ltx_p">Suppose the learning rate is constant and satisfies <math id="A3.SS5.SSS0.Px1.p1.m1" class="ltx_Math" alttext="\gamma\leq 2/L" display="inline" intent=":literal"><semantics><mrow><mi>γ</mi><mo>≤</mo><mrow><mn>2</mn><mo>/</mo><mi>L</mi></mrow></mrow><annotation encoding="application/x-tex">\gamma\leq 2/L</annotation></semantics></math>.
Applying the averaged model to the stability result in Theorem <a href="#Thmtheorem22" title="Theorem 22 (Uniform Stability). ‣ 4.2 Results on Convex Case ‣ 4 Theoretical Analysis ‣ Stability and Generalization of Push-Sum Based Decentralized Optimization over Directed Graphs" class="ltx_ref"><span class="ltx_text ltx_ref_tag">22</span></a>
and using the <math id="A3.SS5.SSS0.Px1.p1.m2" class="ltx_Math" alttext="G" display="inline" intent=":literal"><semantics><mi>G</mi><annotation encoding="application/x-tex">G</annotation></semantics></math>-Lipschitz assumption <a href="#Thmtheorem17" title="Assumption 17. ‣ 4.1 Basic Assumptions ‣ 4 Theoretical Analysis ‣ Stability and Generalization of Push-Sum Based Decentralized Optimization over Directed Graphs" class="ltx_ref"><span class="ltx_text ltx_ref_tag">17</span></a>, we obtain</p>
<table id="A3.EGx25" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A3.Ex75"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.Ex75.m1" class="ltx_Math" alttext="\displaystyle\epsilon_{\mathrm{ave\text{-}stab}}" display="inline" intent=":literal"><semantics><msub><mi>ϵ</mi><mrow><mi>ave</mi><mo lspace="0em" rspace="0em">​</mo><mtext>-</mtext><mo lspace="0em" rspace="0em">​</mo><mi>stab</mi></mrow></msub><annotation encoding="application/x-tex">\displaystyle\epsilon_{\mathrm{ave\text{-}stab}}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex75.m2" class="ltx_Math" alttext="\displaystyle\leq G\,\mathbb{E}\bigl[\|\bm{w}_{\mathrm{avg}}^{(T)}-\bm{w}_{\mathrm{avg}}^{\prime(T)}\|\bigr]" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≤</mo><mrow><mi>G</mi><mo lspace="0.170em" rspace="0em">​</mo><mi>𝔼</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="1.200em" minsize="1.200em">[</mo><mrow><mo stretchy="false">‖</mo><mrow><msubsup><mi>𝒘</mi><mi>avg</mi><mrow><mo stretchy="false">(</mo><mi>T</mi><mo stretchy="false">)</mo></mrow></msubsup><mo>−</mo><msubsup><mi>𝒘</mi><mi>avg</mi><mrow><mo rspace="0em">′</mo><mphantom></mphantom><mrow><mo stretchy="false">(</mo><mi>T</mi><mo stretchy="false">)</mo></mrow></mrow></msubsup></mrow><mo stretchy="false">‖</mo></mrow><mo maxsize="1.200em" minsize="1.200em">]</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\leq G\,\mathbb{E}\bigl[\|\bm{w}_{\mathrm{avg}}^{(T)}-\bm{w}_{\mathrm{avg}}^{\prime(T)}\|\bigr]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A3.Ex76"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex76.m1" class="ltx_Math" alttext="\displaystyle=G\,\frac{\sum_{t=0}^{T-1}\gamma\,\mathbb{E}\bigl[\|\overline{\bm{w}}^{(t)}-\overline{\bm{w}}^{\prime(t)}\|\bigr]}{\sum_{t=0}^{T-1}\gamma}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mi>G</mi><mo lspace="0.170em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><mrow><msubsup><mo>∑</mo><mrow><mi>t</mi><mo>=</mo><mn>0</mn></mrow><mrow><mi>T</mi><mo>−</mo><mn>1</mn></mrow></msubsup><mrow><mi>γ</mi><mo lspace="0.170em" rspace="0em">​</mo><mi>𝔼</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="1.200em" minsize="1.200em">[</mo><mrow><mo stretchy="false">‖</mo><mrow><msup><mover accent="true"><mi>𝒘</mi><mo stretchy="true">¯</mo></mover><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo>−</mo><msup><mover accent="true"><mi>𝒘</mi><mo stretchy="true">¯</mo></mover><mrow><mo rspace="0em">′</mo><mphantom></mphantom><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow></msup></mrow><mo stretchy="false">‖</mo></mrow><mo maxsize="1.200em" minsize="1.200em">]</mo></mrow></mrow></mrow><mrow><msubsup><mo>∑</mo><mrow><mi>t</mi><mo>=</mo><mn>0</mn></mrow><mrow><mi>T</mi><mo>−</mo><mn>1</mn></mrow></msubsup><mi>γ</mi></mrow></mfrac></mstyle></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=G\,\frac{\sum_{t=0}^{T-1}\gamma\,\mathbb{E}\bigl[\|\overline{\bm{w}}^{(t)}-\overline{\bm{w}}^{\prime(t)}\|\bigr]}{\sum_{t=0}^{T-1}\gamma}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A3.E70"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.E70.m1" class="ltx_Math" alttext="\displaystyle\leq\frac{CGL\gamma C_{w_{0}}}{\delta(1-{\lambda})}+\left(\frac{CG^{2}L{\gamma}^{2}}{\delta(1-{\lambda})}+\frac{G^{2}{\gamma}}{mn}\right)T." display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>≤</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><mi>G</mi><mo lspace="0em" rspace="0em">​</mo><mi>L</mi><mo lspace="0em" rspace="0em">​</mo><mi>γ</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>C</mi><msub><mi>w</mi><mn>0</mn></msub></msub></mrow><mrow><mi>δ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>λ</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle><mo>+</mo><mrow><mrow><mo>(</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>G</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mi>L</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>γ</mi><mn>2</mn></msup></mrow><mrow><mi>δ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>λ</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle><mo>+</mo><mstyle displaystyle="true"><mfrac><mrow><msup><mi>G</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mi>γ</mi></mrow><mrow><mi>m</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow></mfrac></mstyle></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>T</mi></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\leq\frac{CGL\gamma C_{w_{0}}}{\delta(1-{\lambda})}+\left(\frac{CG^{2}L{\gamma}^{2}}{\delta(1-{\lambda})}+\frac{G^{2}{\gamma}}{mn}\right)T.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(70)</span></td></tr></tbody>
</table>
</div>
<div id="A3.SS5.SSS0.Px1.p2" class="ltx_para">
<p id="A3.SS5.SSS0.Px1.p2.1" class="ltx_p">Combining this with the optimization error bound in Corollary <a href="#Thmtheorem27" title="Corollary 27 (Optimization Error on Common Learning Rate). ‣ 4.2 Results on Convex Case ‣ 4 Theoretical Analysis ‣ Stability and Generalization of Push-Sum Based Decentralized Optimization over Directed Graphs" class="ltx_ref"><span class="ltx_text ltx_ref_tag">27</span></a>, we obtain</p>
<table id="A3.EGx26" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A3.Ex77"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.Ex77.m1" class="ltx_Math" alttext="\displaystyle\epsilon_{\mathrm{exc}}" display="inline" intent=":literal"><semantics><msub><mi>ϵ</mi><mi>exc</mi></msub><annotation encoding="application/x-tex">\displaystyle\epsilon_{\mathrm{exc}}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex77.m2" class="ltx_Math" alttext="\displaystyle\leq\epsilon_{\mathrm{ave\text{-}stab}}+\epsilon_{\mathrm{opt}}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≤</mo><mrow><msub><mi>ϵ</mi><mrow><mi>ave</mi><mo lspace="0em" rspace="0em">​</mo><mtext>-</mtext><mo lspace="0em" rspace="0em">​</mo><mi>stab</mi></mrow></msub><mo>+</mo><msub><mi>ϵ</mi><mi>opt</mi></msub></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\leq\epsilon_{\mathrm{ave\text{-}stab}}+\epsilon_{\mathrm{opt}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A3.Ex78"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex78.m1" class="ltx_Math" alttext="\displaystyle\leq\left(\frac{CG^{2}L{\gamma}^{2}}{\delta(1-{\lambda})}+\frac{G^{2}{\gamma}}{mn}\right)T+\left(\frac{\|\overline{\bm{w}}^{(0)}-\bm{w}_{\bm{S}}^{*}\|^{2}}{2\gamma}+\frac{2rCLC_{w_{0}}}{\delta(1-{\lambda})}\right)\frac{1}{T}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≤</mo><mrow><mrow><mrow><mo>(</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>G</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mi>L</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>γ</mi><mn>2</mn></msup></mrow><mrow><mi>δ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>λ</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle><mo>+</mo><mstyle displaystyle="true"><mfrac><mrow><msup><mi>G</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mi>γ</mi></mrow><mrow><mi>m</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow></mfrac></mstyle></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>T</mi></mrow><mo>+</mo><mrow><mrow><mo>(</mo><mrow><mstyle displaystyle="true"><mfrac><msup><mrow><mo stretchy="false">‖</mo><mrow><msup><mover accent="true"><mi>𝒘</mi><mo stretchy="true">¯</mo></mover><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></msup><mo>−</mo><msubsup><mi>𝒘</mi><mi>𝑺</mi><mo>∗</mo></msubsup></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>γ</mi></mrow></mfrac></mstyle><mo>+</mo><mstyle displaystyle="true"><mfrac><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><mi>L</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>C</mi><msub><mi>w</mi><mn>0</mn></msub></msub></mrow><mrow><mi>δ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>λ</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>T</mi></mfrac></mstyle></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\leq\left(\frac{CG^{2}L{\gamma}^{2}}{\delta(1-{\lambda})}+\frac{G^{2}{\gamma}}{mn}\right)T+\left(\frac{\|\overline{\bm{w}}^{(0)}-\bm{w}_{\bm{S}}^{*}\|^{2}}{2\gamma}+\frac{2rCLC_{w_{0}}}{\delta(1-{\lambda})}\right)\frac{1}{T}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A3.E71"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.E71.m1" class="ltx_Math" alttext="\displaystyle\quad+\frac{CGL\gamma C_{w_{0}}}{\delta(1-{\lambda})}+\frac{2rCLG\gamma}{\delta(1-{\lambda})}+\frac{G^{2}\gamma}{2}." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mo>+</mo><mstyle displaystyle="true"><mfrac><mrow><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><mi>G</mi><mo lspace="0em" rspace="0em">​</mo><mi>L</mi><mo lspace="0em" rspace="0em">​</mo><mi>γ</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>C</mi><msub><mi>w</mi><mn>0</mn></msub></msub></mrow><mrow><mi>δ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>λ</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle></mrow><mo>+</mo><mstyle displaystyle="true"><mfrac><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><mi>L</mi><mo lspace="0em" rspace="0em">​</mo><mi>G</mi><mo lspace="0em" rspace="0em">​</mo><mi>γ</mi></mrow><mrow><mi>δ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>λ</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle><mo>+</mo><mstyle displaystyle="true"><mfrac><mrow><msup><mi>G</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mi>γ</mi></mrow><mn>2</mn></mfrac></mstyle></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\quad+\frac{CGL\gamma C_{w_{0}}}{\delta(1-{\lambda})}+\frac{2rCLG\gamma}{\delta(1-{\lambda})}+\frac{G^{2}\gamma}{2}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(71)</span></td></tr></tbody>
</table>
</div>
<div id="A3.SS5.SSS0.Px1.p3" class="ltx_para">
<p id="A3.SS5.SSS0.Px1.p3.1" class="ltx_p">For convenience, denote</p>
<table id="A3.EGx27" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A3.Ex79"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.Ex79.m1" class="ltx_Math" alttext="\displaystyle A" display="inline" intent=":literal"><semantics><mi>A</mi><annotation encoding="application/x-tex">\displaystyle A</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex79.m2" class="ltx_Math" alttext="\displaystyle:=\frac{CG^{2}L{\gamma}^{2}}{\delta(1-{\lambda})}+\frac{G^{2}{\gamma}}{mn}=G^{2}\gamma\Bigl(\frac{CL\gamma}{\delta(1-\lambda)}+\frac{1}{mn}\Bigr)," display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mphantom></mphantom><mo>=</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>G</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mi>L</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>γ</mi><mn>2</mn></msup></mrow><mrow><mi>δ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>λ</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle><mo>+</mo><mstyle displaystyle="true"><mfrac><mrow><msup><mi>G</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mi>γ</mi></mrow><mrow><mi>m</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow></mfrac></mstyle></mrow><mo>=</mo><mrow><msup><mi>G</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mi>γ</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="1.600em" minsize="1.600em">(</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><mi>L</mi><mo lspace="0em" rspace="0em">​</mo><mi>γ</mi></mrow><mrow><mi>δ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>λ</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle><mo>+</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mrow><mi>m</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow></mfrac></mstyle></mrow><mo maxsize="1.600em" minsize="1.600em">)</mo></mrow></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle:=\frac{CG^{2}L{\gamma}^{2}}{\delta(1-{\lambda})}+\frac{G^{2}{\gamma}}{mn}=G^{2}\gamma\Bigl(\frac{CL\gamma}{\delta(1-\lambda)}+\frac{1}{mn}\Bigr),</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A3.Ex80"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.Ex80.m1" class="ltx_Math" alttext="\displaystyle B" display="inline" intent=":literal"><semantics><mi>B</mi><annotation encoding="application/x-tex">\displaystyle B</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex80.m2" class="ltx_Math" alttext="\displaystyle:=\frac{\|\overline{\bm{w}}^{(0)}-\bm{w}_{\bm{S}}^{*}\|^{2}}{2\gamma}+\frac{2rCLC_{w_{0}}}{\delta(1-{\lambda})}," display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mphantom></mphantom><mo>=</mo><mrow><mstyle displaystyle="true"><mfrac><msup><mrow><mo stretchy="false">‖</mo><mrow><msup><mover accent="true"><mi>𝒘</mi><mo stretchy="true">¯</mo></mover><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></msup><mo>−</mo><msubsup><mi>𝒘</mi><mi>𝑺</mi><mo>∗</mo></msubsup></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>γ</mi></mrow></mfrac></mstyle><mo>+</mo><mstyle displaystyle="true"><mfrac><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><mi>L</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>C</mi><msub><mi>w</mi><mn>0</mn></msub></msub></mrow><mrow><mi>δ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>λ</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle:=\frac{\|\overline{\bm{w}}^{(0)}-\bm{w}_{\bm{S}}^{*}\|^{2}}{2\gamma}+\frac{2rCLC_{w_{0}}}{\delta(1-{\lambda})},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A3.E72"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.E72.m1" class="ltx_Math" alttext="\displaystyle C" display="inline" intent=":literal"><semantics><mi>C</mi><annotation encoding="application/x-tex">\displaystyle C</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.E72.m2" class="ltx_Math" alttext="\displaystyle:=\frac{CGL\gamma C_{w_{0}}}{\delta(1-{\lambda})}+\frac{2rCLG\gamma}{\delta(1-{\lambda})}+\frac{G^{2}\gamma}{2}." display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mphantom></mphantom><mo>=</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><mi>G</mi><mo lspace="0em" rspace="0em">​</mo><mi>L</mi><mo lspace="0em" rspace="0em">​</mo><mi>γ</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>C</mi><msub><mi>w</mi><mn>0</mn></msub></msub></mrow><mrow><mi>δ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>λ</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle><mo>+</mo><mstyle displaystyle="true"><mfrac><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><mi>L</mi><mo lspace="0em" rspace="0em">​</mo><mi>G</mi><mo lspace="0em" rspace="0em">​</mo><mi>γ</mi></mrow><mrow><mi>δ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>λ</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle><mo>+</mo><mstyle displaystyle="true"><mfrac><mrow><msup><mi>G</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mi>γ</mi></mrow><mn>2</mn></mfrac></mstyle></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle:=\frac{CGL\gamma C_{w_{0}}}{\delta(1-{\lambda})}+\frac{2rCLG\gamma}{\delta(1-{\lambda})}+\frac{G^{2}\gamma}{2}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(72)</span></td></tr></tbody>
</table>
<p id="A3.SS5.SSS0.Px1.p3.2" class="ltx_p">Then (<a href="#A3.E71" title="In Case 1 :Constant learning rate. ‣ C.5 Proof of Corollary ‣ Appendix C Proof of Theorem and Corollary ‣ Stability and Generalization of Push-Sum Based Decentralized Optimization over Directed Graphs" class="ltx_ref"><span class="ltx_text ltx_ref_tag">71</span></a>) can be rewritten as</p>
<table id="A3.E73" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A3.E73.m1" class="ltx_Math" alttext="\epsilon_{\mathrm{exc}}(T)\leq AT+\frac{B}{T}+C." display="block" intent=":literal"><semantics><mrow><mrow><mrow><msub><mi>ϵ</mi><mi>exc</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>T</mi><mo stretchy="false">)</mo></mrow></mrow><mo>≤</mo><mrow><mrow><mi>A</mi><mo lspace="0em" rspace="0em">​</mo><mi>T</mi></mrow><mo>+</mo><mfrac><mi>B</mi><mi>T</mi></mfrac><mo>+</mo><mi>C</mi></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\epsilon_{\mathrm{exc}}(T)\leq AT+\frac{B}{T}+C.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(73)</span></td></tr></tbody>
</table>
</div>
<div id="A3.SS5.SSS0.Px1.p4" class="ltx_para">
<p id="A3.SS5.SSS0.Px1.p4.1" class="ltx_p">The right-hand side is minimized over <math id="A3.SS5.SSS0.Px1.p4.m1" class="ltx_Math" alttext="T&gt;0" display="inline" intent=":literal"><semantics><mrow><mi>T</mi><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">T&gt;0</annotation></semantics></math> by</p>
<table id="A3.E74" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A3.E74.m1" class="ltx_Math" alttext="T^{*}=\sqrt{\frac{B}{A}}=\frac{1}{G\sqrt{\gamma}}\,\sqrt{\frac{\displaystyle\frac{\|\overline{\bm{w}}^{(0)}-\bm{w}_{\bm{S}}^{*}\|^{2}}{2\gamma}+\frac{2rCLC_{w_{0}}}{\delta(1-\lambda)}}{\displaystyle\frac{CL\gamma}{\delta(1-\lambda)}+\frac{1}{mn}}}." display="block" intent=":literal"><semantics><mrow><mrow><msup><mi>T</mi><mo>∗</mo></msup><mo>=</mo><msqrt><mfrac><mi>B</mi><mi>A</mi></mfrac></msqrt><mo>=</mo><mrow><mfrac><mn>1</mn><mrow><mi>G</mi><mo lspace="0em" rspace="0em">​</mo><msqrt><mi>γ</mi></msqrt></mrow></mfrac><mo lspace="0.170em" rspace="0em">​</mo><msqrt><mfrac><mrow><mstyle displaystyle="true"><mfrac><msup><mrow><mo stretchy="false">‖</mo><mrow><msup><mover accent="true"><mi>𝒘</mi><mo stretchy="true">¯</mo></mover><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></msup><mo>−</mo><msubsup><mi>𝒘</mi><mi>𝑺</mi><mo>∗</mo></msubsup></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>γ</mi></mrow></mfrac></mstyle><mo>+</mo><mstyle displaystyle="true"><mfrac><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><mi>L</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>C</mi><msub><mi>w</mi><mn>0</mn></msub></msub></mrow><mrow><mi>δ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>λ</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle></mrow><mrow><mstyle displaystyle="true"><mfrac><mrow><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><mi>L</mi><mo lspace="0em" rspace="0em">​</mo><mi>γ</mi></mrow><mrow><mi>δ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>λ</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle><mo>+</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mrow><mi>m</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow></mfrac></mstyle></mrow></mfrac></msqrt></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">T^{*}=\sqrt{\frac{B}{A}}=\frac{1}{G\sqrt{\gamma}}\,\sqrt{\frac{\displaystyle\frac{\|\overline{\bm{w}}^{(0)}-\bm{w}_{\bm{S}}^{*}\|^{2}}{2\gamma}+\frac{2rCLC_{w_{0}}}{\delta(1-\lambda)}}{\displaystyle\frac{CL\gamma}{\delta(1-\lambda)}+\frac{1}{mn}}}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(74)</span></td></tr></tbody>
</table>
</div>
<div id="A3.SS5.SSS0.Px1.p5" class="ltx_para">
<p id="A3.SS5.SSS0.Px1.p5.1" class="ltx_p">Substituting <math id="A3.SS5.SSS0.Px1.p5.m1" class="ltx_Math" alttext="T^{*}" display="inline" intent=":literal"><semantics><msup><mi>T</mi><mo>∗</mo></msup><annotation encoding="application/x-tex">T^{*}</annotation></semantics></math> back into the bound and using
<math id="A3.SS5.SSS0.Px1.p5.m2" class="ltx_Math" alttext="AT^{*}+B/T^{*}=2\sqrt{AB}" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mi>A</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>T</mi><mo>∗</mo></msup></mrow><mo>+</mo><mrow><mi>B</mi><mo>/</mo><msup><mi>T</mi><mo>∗</mo></msup></mrow></mrow><mo>=</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msqrt><mrow><mi>A</mi><mo lspace="0em" rspace="0em">​</mo><mi>B</mi></mrow></msqrt></mrow></mrow><annotation encoding="application/x-tex">AT^{*}+B/T^{*}=2\sqrt{AB}</annotation></semantics></math>,
we obtain the explicit optimal excess generalization bound</p>
<table id="A3.EGx28" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A3.Ex81"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.Ex81.m1" class="ltx_Math" alttext="\displaystyle\epsilon_{\mathrm{exc}}^{*}" display="inline" intent=":literal"><semantics><msubsup><mi>ϵ</mi><mi>exc</mi><mo>∗</mo></msubsup><annotation encoding="application/x-tex">\displaystyle\epsilon_{\mathrm{exc}}^{*}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex81.m2" class="ltx_Math" alttext="\displaystyle\leq 2\sqrt{AB}+C" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≤</mo><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msqrt><mrow><mi>A</mi><mo lspace="0em" rspace="0em">​</mo><mi>B</mi></mrow></msqrt></mrow><mo>+</mo><mi>C</mi></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\leq 2\sqrt{AB}+C</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A3.Ex82"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex82.m1" class="ltx_Math" alttext="\displaystyle=2\sqrt{\Bigl(\frac{CG^{2}L\gamma^{2}}{\delta(1-\lambda)}+\frac{G^{2}\gamma}{mn}\Bigr)\Bigl(\frac{\|\overline{\bm{w}}^{(0)}-\bm{w}_{\bm{S}}^{*}\|^{2}}{2\gamma}+\frac{2rCLC_{w_{0}}}{\delta(1-\lambda)}\Bigr)}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msqrt><mrow><mrow><mo maxsize="1.600em" minsize="1.600em">(</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>G</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mi>L</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>γ</mi><mn>2</mn></msup></mrow><mrow><mi>δ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>λ</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle><mo>+</mo><mstyle displaystyle="true"><mfrac><mrow><msup><mi>G</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mi>γ</mi></mrow><mrow><mi>m</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow></mfrac></mstyle></mrow><mo maxsize="1.600em" minsize="1.600em">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="1.600em" minsize="1.600em">(</mo><mrow><mstyle displaystyle="true"><mfrac><msup><mrow><mo stretchy="false">‖</mo><mrow><msup><mover accent="true"><mi>𝒘</mi><mo stretchy="true">¯</mo></mover><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></msup><mo>−</mo><msubsup><mi>𝒘</mi><mi>𝑺</mi><mo>∗</mo></msubsup></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>γ</mi></mrow></mfrac></mstyle><mo>+</mo><mstyle displaystyle="true"><mfrac><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><mi>L</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>C</mi><msub><mi>w</mi><mn>0</mn></msub></msub></mrow><mrow><mi>δ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>λ</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle></mrow><mo maxsize="1.600em" minsize="1.600em">)</mo></mrow></mrow></msqrt></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=2\sqrt{\Bigl(\frac{CG^{2}L\gamma^{2}}{\delta(1-\lambda)}+\frac{G^{2}\gamma}{mn}\Bigr)\Bigl(\frac{\|\overline{\bm{w}}^{(0)}-\bm{w}_{\bm{S}}^{*}\|^{2}}{2\gamma}+\frac{2rCLC_{w_{0}}}{\delta(1-\lambda)}\Bigr)}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A3.E75"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.E75.m1" class="ltx_Math" alttext="\displaystyle\quad+\frac{CGL\gamma C_{w_{0}}}{\delta(1-{\lambda})}+\frac{2rCLG\gamma}{\delta(1-{\lambda})}+\frac{G^{2}\gamma}{2}." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mo>+</mo><mstyle displaystyle="true"><mfrac><mrow><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><mi>G</mi><mo lspace="0em" rspace="0em">​</mo><mi>L</mi><mo lspace="0em" rspace="0em">​</mo><mi>γ</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>C</mi><msub><mi>w</mi><mn>0</mn></msub></msub></mrow><mrow><mi>δ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>λ</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle></mrow><mo>+</mo><mstyle displaystyle="true"><mfrac><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><mi>L</mi><mo lspace="0em" rspace="0em">​</mo><mi>G</mi><mo lspace="0em" rspace="0em">​</mo><mi>γ</mi></mrow><mrow><mi>δ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>λ</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle><mo>+</mo><mstyle displaystyle="true"><mfrac><mrow><msup><mi>G</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mi>γ</mi></mrow><mn>2</mn></mfrac></mstyle></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\quad+\frac{CGL\gamma C_{w_{0}}}{\delta(1-{\lambda})}+\frac{2rCLG\gamma}{\delta(1-{\lambda})}+\frac{G^{2}\gamma}{2}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(75)</span></td></tr></tbody>
</table>
</div>
<div id="A3.SS5.SSS0.Px1.p6" class="ltx_para">
<p id="A3.SS5.SSS0.Px1.p6.1" class="ltx_p">This gives the excess generalization error under constant learning rate.</p>
</div>
</section>
<section id="A3.SS5.SSS0.Px2" class="ltx_paragraph">
<h4 class="ltx_title ltx_title_paragraph">Case 2: Decreasing learning rate.</h4>

<div id="A3.SS5.SSS0.Px2.p1" class="ltx_para">
<p id="A3.SS5.SSS0.Px2.p1.1" class="ltx_p">Let <math id="A3.SS5.SSS0.Px2.p1.m1" class="ltx_Math" alttext="\gamma_{t}=\frac{v}{t+1}" display="inline" intent=":literal"><semantics><mrow><msub><mi>γ</mi><mi>t</mi></msub><mo>=</mo><mfrac><mi>v</mi><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow></mfrac></mrow><annotation encoding="application/x-tex">\gamma_{t}=\frac{v}{t+1}</annotation></semantics></math> with <math id="A3.SS5.SSS0.Px2.p1.m2" class="ltx_Math" alttext="v\leq 2/L" display="inline" intent=":literal"><semantics><mrow><mi>v</mi><mo>≤</mo><mrow><mn>2</mn><mo>/</mo><mi>L</mi></mrow></mrow><annotation encoding="application/x-tex">v\leq 2/L</annotation></semantics></math>. Applying the averaged model to the stability result in Corollary <a href="#Thmtheorem24" title="Corollary 24 (Uniform Stability on Common Learning Rate). ‣ 4.2 Results on Convex Case ‣ 4 Theoretical Analysis ‣ Stability and Generalization of Push-Sum Based Decentralized Optimization over Directed Graphs" class="ltx_ref"><span class="ltx_text ltx_ref_tag">24</span></a> and using Assumption <a href="#Thmtheorem17" title="Assumption 17. ‣ 4.1 Basic Assumptions ‣ 4 Theoretical Analysis ‣ Stability and Generalization of Push-Sum Based Decentralized Optimization over Directed Graphs" class="ltx_ref"><span class="ltx_text ltx_ref_tag">17</span></a>, we have</p>
<table id="A3.EGx29" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A3.Ex83"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.Ex83.m1" class="ltx_Math" alttext="\displaystyle\epsilon_{\mathrm{avg\text{-}stab}}" display="inline" intent=":literal"><semantics><msub><mi>ϵ</mi><mrow><mi>avg</mi><mo lspace="0em" rspace="0em">​</mo><mtext>-</mtext><mo lspace="0em" rspace="0em">​</mo><mi>stab</mi></mrow></msub><annotation encoding="application/x-tex">\displaystyle\epsilon_{\mathrm{avg\text{-}stab}}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex83.m2" class="ltx_Math" alttext="\displaystyle\leq G\,\mathbb{E}\bigl[\|\bm{w}_{\mathrm{avg}}^{(T)}-\bm{w}_{\mathrm{avg}}^{\prime(T)}\|\bigr]\leq G\,\frac{\sum_{t=0}^{T-1}\gamma_{t}\,\mathbb{E}\bigl[\|\overline{\bm{w}}^{(t)}-\overline{\bm{w}}^{\prime(t)}\|\bigr]}{\sum_{t=0}^{T-1}\gamma_{t}}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≤</mo><mrow><mi>G</mi><mo lspace="0.170em" rspace="0em">​</mo><mi>𝔼</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="1.200em" minsize="1.200em">[</mo><mrow><mo stretchy="false">‖</mo><mrow><msubsup><mi>𝒘</mi><mi>avg</mi><mrow><mo stretchy="false">(</mo><mi>T</mi><mo stretchy="false">)</mo></mrow></msubsup><mo>−</mo><msubsup><mi>𝒘</mi><mi>avg</mi><mrow><mo rspace="0em">′</mo><mphantom></mphantom><mrow><mo stretchy="false">(</mo><mi>T</mi><mo stretchy="false">)</mo></mrow></mrow></msubsup></mrow><mo stretchy="false">‖</mo></mrow><mo maxsize="1.200em" minsize="1.200em">]</mo></mrow></mrow><mo>≤</mo><mrow><mi>G</mi><mo lspace="0.170em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><mrow><msubsup><mo>∑</mo><mrow><mi>t</mi><mo>=</mo><mn>0</mn></mrow><mrow><mi>T</mi><mo>−</mo><mn>1</mn></mrow></msubsup><mrow><msub><mi>γ</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi>𝔼</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="1.200em" minsize="1.200em">[</mo><mrow><mo stretchy="false">‖</mo><mrow><msup><mover accent="true"><mi>𝒘</mi><mo stretchy="true">¯</mo></mover><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo>−</mo><msup><mover accent="true"><mi>𝒘</mi><mo stretchy="true">¯</mo></mover><mrow><mo rspace="0em">′</mo><mphantom></mphantom><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow></msup></mrow><mo stretchy="false">‖</mo></mrow><mo maxsize="1.200em" minsize="1.200em">]</mo></mrow></mrow></mrow><mrow><msubsup><mo>∑</mo><mrow><mi>t</mi><mo>=</mo><mn>0</mn></mrow><mrow><mi>T</mi><mo>−</mo><mn>1</mn></mrow></msubsup><msub><mi>γ</mi><mi>t</mi></msub></mrow></mfrac></mstyle></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\leq G\,\mathbb{E}\bigl[\|\bm{w}_{\mathrm{avg}}^{(T)}-\bm{w}_{\mathrm{avg}}^{\prime(T)}\|\bigr]\leq G\,\frac{\sum_{t=0}^{T-1}\gamma_{t}\,\mathbb{E}\bigl[\|\overline{\bm{w}}^{(t)}-\overline{\bm{w}}^{\prime(t)}\|\bigr]}{\sum_{t=0}^{T-1}\gamma_{t}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A3.Ex84"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex84.m1" class="ltx_Math" alttext="\displaystyle=G\,\frac{\sum_{t=0}^{T-1}\gamma_{t}\,\mathbb{E}[\Delta_{t}]}{\sum_{t=0}^{T-1}\gamma_{t}}\leq G\,\frac{\sum_{t=0}^{T-1}\gamma_{t}\cdot\frac{1}{G}\epsilon_{\mathrm{stab}}(t)}{\sum_{t=0}^{T-1}\gamma_{t}}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mi>G</mi><mo lspace="0.170em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><mrow><msubsup><mo>∑</mo><mrow><mi>t</mi><mo>=</mo><mn>0</mn></mrow><mrow><mi>T</mi><mo>−</mo><mn>1</mn></mrow></msubsup><mrow><msub><mi>γ</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi>𝔼</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><msub><mi mathvariant="normal">Δ</mi><mi>t</mi></msub><mo stretchy="false">]</mo></mrow></mrow></mrow><mrow><msubsup><mo>∑</mo><mrow><mi>t</mi><mo>=</mo><mn>0</mn></mrow><mrow><mi>T</mi><mo>−</mo><mn>1</mn></mrow></msubsup><msub><mi>γ</mi><mi>t</mi></msub></mrow></mfrac></mstyle></mrow><mo>≤</mo><mrow><mi>G</mi><mo lspace="0.170em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><mrow><mrow><mrow><msubsup><mo>∑</mo><mrow><mi>t</mi><mo>=</mo><mn>0</mn></mrow><mrow><mi>T</mi><mo>−</mo><mn>1</mn></mrow></msubsup><msub><mi>γ</mi><mi>t</mi></msub></mrow><mo lspace="0.222em" rspace="0.222em">⋅</mo><mfrac><mn>1</mn><mi>G</mi></mfrac></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>ϵ</mi><mi>stab</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mrow><msubsup><mo>∑</mo><mrow><mi>t</mi><mo>=</mo><mn>0</mn></mrow><mrow><mi>T</mi><mo>−</mo><mn>1</mn></mrow></msubsup><msub><mi>γ</mi><mi>t</mi></msub></mrow></mfrac></mstyle></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=G\,\frac{\sum_{t=0}^{T-1}\gamma_{t}\,\mathbb{E}[\Delta_{t}]}{\sum_{t=0}^{T-1}\gamma_{t}}\leq G\,\frac{\sum_{t=0}^{T-1}\gamma_{t}\cdot\frac{1}{G}\epsilon_{\mathrm{stab}}(t)}{\sum_{t=0}^{T-1}\gamma_{t}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A3.Ex85"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex85.m1" class="ltx_Math" alttext="\displaystyle\leq\frac{\sum_{t=0}^{T-1}\gamma_{t}\left(\frac{2GCLC_{w_{0}}}{\delta}\sum_{k=0}^{t-1}\gamma_{k}\lambda^{k}+\frac{2CG^{2}L}{\delta(1-\lambda)}\sum_{k=0}^{t-1}\gamma_{k}^{2}+\frac{2G^{2}}{mn}\sum_{k=0}^{t-1}\gamma_{k}\right)}{\sum_{t=0}^{T-1}\gamma_{t}}." display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>≤</mo><mstyle displaystyle="true"><mfrac><mrow><msubsup><mo>∑</mo><mrow><mi>t</mi><mo>=</mo><mn>0</mn></mrow><mrow><mi>T</mi><mo>−</mo><mn>1</mn></mrow></msubsup><mrow><msub><mi>γ</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mrow><mfrac><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>G</mi><mo lspace="0em" rspace="0em">​</mo><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><mi>L</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>C</mi><msub><mi>w</mi><mn>0</mn></msub></msub></mrow><mi>δ</mi></mfrac><mo lspace="0em" rspace="0em">​</mo><mrow><msubsup><mo>∑</mo><mrow><mi>k</mi><mo>=</mo><mn>0</mn></mrow><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow></msubsup><mrow><msub><mi>γ</mi><mi>k</mi></msub><mo lspace="0em" rspace="0em">​</mo><msup><mi>λ</mi><mi>k</mi></msup></mrow></mrow></mrow><mo>+</mo><mrow><mfrac><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>G</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mi>L</mi></mrow><mrow><mi>δ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>λ</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mfrac><mo lspace="0em" rspace="0em">​</mo><mrow><msubsup><mo>∑</mo><mrow><mi>k</mi><mo>=</mo><mn>0</mn></mrow><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow></msubsup><msubsup><mi>γ</mi><mi>k</mi><mn>2</mn></msubsup></mrow></mrow><mo>+</mo><mrow><mfrac><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msup><mi>G</mi><mn>2</mn></msup></mrow><mrow><mi>m</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow></mfrac><mo lspace="0em" rspace="0em">​</mo><mrow><msubsup><mo>∑</mo><mrow><mi>k</mi><mo>=</mo><mn>0</mn></mrow><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow></msubsup><msub><mi>γ</mi><mi>k</mi></msub></mrow></mrow></mrow><mo>)</mo></mrow></mrow></mrow><mrow><msubsup><mo>∑</mo><mrow><mi>t</mi><mo>=</mo><mn>0</mn></mrow><mrow><mi>T</mi><mo>−</mo><mn>1</mn></mrow></msubsup><msub><mi>γ</mi><mi>t</mi></msub></mrow></mfrac></mstyle></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\leq\frac{\sum_{t=0}^{T-1}\gamma_{t}\left(\frac{2GCLC_{w_{0}}}{\delta}\sum_{k=0}^{t-1}\gamma_{k}\lambda^{k}+\frac{2CG^{2}L}{\delta(1-\lambda)}\sum_{k=0}^{t-1}\gamma_{k}^{2}+\frac{2G^{2}}{mn}\sum_{k=0}^{t-1}\gamma_{k}\right)}{\sum_{t=0}^{T-1}\gamma_{t}}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A3.SS5.SSS0.Px2.p1.2" class="ltx_p">Substituting <math id="A3.SS5.SSS0.Px2.p1.m3" class="ltx_Math" alttext="\gamma_{k}=\frac{v}{k+1}" display="inline" intent=":literal"><semantics><mrow><msub><mi>γ</mi><mi>k</mi></msub><mo>=</mo><mfrac><mi>v</mi><mrow><mi>k</mi><mo>+</mo><mn>1</mn></mrow></mfrac></mrow><annotation encoding="application/x-tex">\gamma_{k}=\frac{v}{k+1}</annotation></semantics></math>, and using (a),
we obtain</p>
<table id="A3.EGx30" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A3.Ex86"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.Ex86.m1" class="ltx_Math" alttext="\displaystyle\epsilon_{\mathrm{avg\text{-}stab}}" display="inline" intent=":literal"><semantics><msub><mi>ϵ</mi><mrow><mi>avg</mi><mo lspace="0em" rspace="0em">​</mo><mtext>-</mtext><mo lspace="0em" rspace="0em">​</mo><mi>stab</mi></mrow></msub><annotation encoding="application/x-tex">\displaystyle\epsilon_{\mathrm{avg\text{-}stab}}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex86.m2" class="ltx_Math" alttext="\displaystyle\leq\frac{\sum_{t=0}^{T-1}\frac{v}{t+1}\left(\frac{2GCLvC_{w_{0}}}{\delta(1-\lambda)}+\frac{4CG^{2}Lv^{2}}{\delta(1-\lambda)}+\frac{2G^{2}v}{mn}(1+\ln t)\right)}{\sum_{t=0}^{T-1}\frac{v}{t+1}}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≤</mo><mstyle displaystyle="true"><mfrac><mrow><msubsup><mo>∑</mo><mrow><mi>t</mi><mo>=</mo><mn>0</mn></mrow><mrow><mi>T</mi><mo>−</mo><mn>1</mn></mrow></msubsup><mrow><mfrac><mi>v</mi><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow></mfrac><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mfrac><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>G</mi><mo lspace="0em" rspace="0em">​</mo><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><mi>L</mi><mo lspace="0em" rspace="0em">​</mo><mi>v</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>C</mi><msub><mi>w</mi><mn>0</mn></msub></msub></mrow><mrow><mi>δ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>λ</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mfrac><mo>+</mo><mfrac><mrow><mn>4</mn><mo lspace="0em" rspace="0em">​</mo><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>G</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mi>L</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>v</mi><mn>2</mn></msup></mrow><mrow><mi>δ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>λ</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mfrac><mo>+</mo><mrow><mfrac><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msup><mi>G</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mi>v</mi></mrow><mrow><mi>m</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow></mfrac><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><mrow><mi>ln</mi><mo lspace="0.167em">⁡</mo><mi>t</mi></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>)</mo></mrow></mrow></mrow><mrow><msubsup><mo>∑</mo><mrow><mi>t</mi><mo>=</mo><mn>0</mn></mrow><mrow><mi>T</mi><mo>−</mo><mn>1</mn></mrow></msubsup><mfrac><mi>v</mi><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow></mfrac></mrow></mfrac></mstyle></mrow><annotation encoding="application/x-tex">\displaystyle\leq\frac{\sum_{t=0}^{T-1}\frac{v}{t+1}\left(\frac{2GCLvC_{w_{0}}}{\delta(1-\lambda)}+\frac{4CG^{2}Lv^{2}}{\delta(1-\lambda)}+\frac{2G^{2}v}{mn}(1+\ln t)\right)}{\sum_{t=0}^{T-1}\frac{v}{t+1}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A3.Ex87"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex87.m1" class="ltx_Math" alttext="\displaystyle\overset{(e)}{\leq}\frac{\frac{4G^{2}v}{mn}\sum_{t=1}^{T-1}\frac{\ln t}{t+1}+\left(\frac{4GCLvC_{w_{0}}}{\delta(1-\lambda)}+\frac{8CG^{2}Lv^{2}}{\delta(1-\lambda)}+\frac{4G^{2}v}{mn}\right)\sum_{t=0}^{T-1}\frac{1}{t+1}}{\ln T}" display="inline" intent=":literal"><semantics><mrow><mover accent="true"><mo>≤</mo><mrow><mo maxsize="0.700em" minsize="0.700em">(</mo><mi mathsize="0.700em">e</mi><mo maxsize="0.700em" minsize="0.700em">)</mo></mrow></mover><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><mrow><mrow><mfrac><mrow><mn>4</mn><mo lspace="0em" rspace="0em">​</mo><msup><mi>G</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mi>v</mi></mrow><mrow><mi>m</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow></mfrac><mo lspace="0em" rspace="0em">​</mo><mrow><msubsup><mo>∑</mo><mrow><mi>t</mi><mo>=</mo><mn>1</mn></mrow><mrow><mi>T</mi><mo>−</mo><mn>1</mn></mrow></msubsup><mfrac><mrow><mi>ln</mi><mo lspace="0.167em">⁡</mo><mi>t</mi></mrow><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow></mfrac></mrow></mrow><mo>+</mo><mrow><mrow><mo>(</mo><mrow><mfrac><mrow><mn>4</mn><mo lspace="0em" rspace="0em">​</mo><mi>G</mi><mo lspace="0em" rspace="0em">​</mo><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><mi>L</mi><mo lspace="0em" rspace="0em">​</mo><mi>v</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>C</mi><msub><mi>w</mi><mn>0</mn></msub></msub></mrow><mrow><mi>δ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>λ</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mfrac><mo>+</mo><mfrac><mrow><mn>8</mn><mo lspace="0em" rspace="0em">​</mo><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>G</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mi>L</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>v</mi><mn>2</mn></msup></mrow><mrow><mi>δ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>λ</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mfrac><mo>+</mo><mfrac><mrow><mn>4</mn><mo lspace="0em" rspace="0em">​</mo><msup><mi>G</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mi>v</mi></mrow><mrow><mi>m</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow></mfrac></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><msubsup><mo>∑</mo><mrow><mi>t</mi><mo>=</mo><mn>0</mn></mrow><mrow><mi>T</mi><mo>−</mo><mn>1</mn></mrow></msubsup><mfrac><mn>1</mn><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow></mfrac></mrow></mrow></mrow><mrow><mi>ln</mi><mo lspace="0.167em">⁡</mo><mi>T</mi></mrow></mfrac></mstyle></mrow><annotation encoding="application/x-tex">\displaystyle\overset{(e)}{\leq}\frac{\frac{4G^{2}v}{mn}\sum_{t=1}^{T-1}\frac{\ln t}{t+1}+\left(\frac{4GCLvC_{w_{0}}}{\delta(1-\lambda)}+\frac{8CG^{2}Lv^{2}}{\delta(1-\lambda)}+\frac{4G^{2}v}{mn}\right)\sum_{t=0}^{T-1}\frac{1}{t+1}}{\ln T}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A3.Ex88"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex88.m1" class="ltx_Math" alttext="\displaystyle\overset{(f),(b)}{\leq}\frac{\frac{2G^{2}v}{mn}\ln^{2}T+\left(\frac{4GCLvC_{w_{0}}}{\delta(1-\lambda)}+\frac{8CG^{2}Lv^{2}}{\delta(1-\lambda)}+\frac{4G^{2}v}{mn}\right)(1+\ln T)}{\ln T}" display="inline" intent=":literal"><semantics><mrow><mover accent="true"><mo>≤</mo><mrow><mrow><mo maxsize="0.700em" minsize="0.700em">(</mo><mi mathsize="0.700em">f</mi><mo maxsize="0.700em" minsize="0.700em">)</mo></mrow><mo mathsize="0.700em">,</mo><mrow><mo maxsize="0.700em" minsize="0.700em">(</mo><mi mathsize="0.700em">b</mi><mo maxsize="0.700em" minsize="0.700em">)</mo></mrow></mrow></mover><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><mrow><mrow><mfrac><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msup><mi>G</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mi>v</mi></mrow><mrow><mi>m</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow></mfrac><mo lspace="0.167em" rspace="0em">​</mo><msup><mi>ln</mi><mn>2</mn></msup><mo lspace="0.167em" rspace="0em">​</mo><mi>T</mi></mrow><mo>+</mo><mrow><mrow><mo>(</mo><mrow><mfrac><mrow><mn>4</mn><mo lspace="0em" rspace="0em">​</mo><mi>G</mi><mo lspace="0em" rspace="0em">​</mo><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><mi>L</mi><mo lspace="0em" rspace="0em">​</mo><mi>v</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>C</mi><msub><mi>w</mi><mn>0</mn></msub></msub></mrow><mrow><mi>δ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>λ</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mfrac><mo>+</mo><mfrac><mrow><mn>8</mn><mo lspace="0em" rspace="0em">​</mo><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>G</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mi>L</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>v</mi><mn>2</mn></msup></mrow><mrow><mi>δ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>λ</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mfrac><mo>+</mo><mfrac><mrow><mn>4</mn><mo lspace="0em" rspace="0em">​</mo><msup><mi>G</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mi>v</mi></mrow><mrow><mi>m</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow></mfrac></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><mrow><mi>ln</mi><mo lspace="0.167em">⁡</mo><mi>T</mi></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mrow><mi>ln</mi><mo lspace="0.167em">⁡</mo><mi>T</mi></mrow></mfrac></mstyle></mrow><annotation encoding="application/x-tex">\displaystyle\overset{(f),(b)}{\leq}\frac{\frac{2G^{2}v}{mn}\ln^{2}T+\left(\frac{4GCLvC_{w_{0}}}{\delta(1-\lambda)}+\frac{8CG^{2}Lv^{2}}{\delta(1-\lambda)}+\frac{4G^{2}v}{mn}\right)(1+\ln T)}{\ln T}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A3.Ex89"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex89.m1" class="ltx_Math" alttext="\displaystyle\leq\frac{2G^{2}v}{mn}\ln T+\left(\frac{4GCLvC_{w_{0}}}{\delta(1-\lambda)}+\frac{8CG^{2}Lv^{2}}{\delta(1-\lambda)}+\frac{4G^{2}v}{mn}\right)\frac{1}{\ln T}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≤</mo><mrow><mrow><mstyle displaystyle="true"><mfrac><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msup><mi>G</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mi>v</mi></mrow><mrow><mi>m</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow></mfrac></mstyle><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>ln</mi><mo lspace="0.167em">⁡</mo><mi>T</mi></mrow></mrow><mo>+</mo><mrow><mrow><mo>(</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mn>4</mn><mo lspace="0em" rspace="0em">​</mo><mi>G</mi><mo lspace="0em" rspace="0em">​</mo><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><mi>L</mi><mo lspace="0em" rspace="0em">​</mo><mi>v</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>C</mi><msub><mi>w</mi><mn>0</mn></msub></msub></mrow><mrow><mi>δ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>λ</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle><mo>+</mo><mstyle displaystyle="true"><mfrac><mrow><mn>8</mn><mo lspace="0em" rspace="0em">​</mo><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>G</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mi>L</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>v</mi><mn>2</mn></msup></mrow><mrow><mi>δ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>λ</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle><mo>+</mo><mstyle displaystyle="true"><mfrac><mrow><mn>4</mn><mo lspace="0em" rspace="0em">​</mo><msup><mi>G</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mi>v</mi></mrow><mrow><mi>m</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow></mfrac></mstyle></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mrow><mi>ln</mi><mo lspace="0.167em">⁡</mo><mi>T</mi></mrow></mfrac></mstyle></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\leq\frac{2G^{2}v}{mn}\ln T+\left(\frac{4GCLvC_{w_{0}}}{\delta(1-\lambda)}+\frac{8CG^{2}Lv^{2}}{\delta(1-\lambda)}+\frac{4G^{2}v}{mn}\right)\frac{1}{\ln T}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A3.E76"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.E76.m1" class="ltx_Math" alttext="\displaystyle\quad+\left(\frac{4GCLvC_{w_{0}}}{\delta(1-\lambda)}+\frac{8CG^{2}Lv^{2}}{\delta(1-\lambda)}+\frac{4G^{2}v}{mn}\right)." display="inline" intent=":literal"><semantics><mrow><mrow><mo>+</mo><mrow><mo>(</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mn>4</mn><mo lspace="0em" rspace="0em">​</mo><mi>G</mi><mo lspace="0em" rspace="0em">​</mo><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><mi>L</mi><mo lspace="0em" rspace="0em">​</mo><mi>v</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>C</mi><msub><mi>w</mi><mn>0</mn></msub></msub></mrow><mrow><mi>δ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>λ</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle><mo>+</mo><mstyle displaystyle="true"><mfrac><mrow><mn>8</mn><mo lspace="0em" rspace="0em">​</mo><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>G</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mi>L</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>v</mi><mn>2</mn></msup></mrow><mrow><mi>δ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>λ</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle><mo>+</mo><mstyle displaystyle="true"><mfrac><mrow><mn>4</mn><mo lspace="0em" rspace="0em">​</mo><msup><mi>G</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mi>v</mi></mrow><mrow><mi>m</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow></mfrac></mstyle></mrow><mo>)</mo></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\quad+\left(\frac{4GCLvC_{w_{0}}}{\delta(1-\lambda)}+\frac{8CG^{2}Lv^{2}}{\delta(1-\lambda)}+\frac{4G^{2}v}{mn}\right).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(76)</span></td></tr></tbody>
</table>
<p id="A3.SS5.SSS0.Px2.p1.3" class="ltx_p">Here we used</p>
<table id="A3.Ex90" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A3.Ex90.m1" class="ltx_Math" alttext="\sum_{t=1}^{T-1}\frac{\ln t}{t+1}\leq\int_{1}^{T}\frac{\ln x}{x}\,dx=\frac{\ln^{2}T}{2}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><munderover><mo movablelimits="false">∑</mo><mrow><mi>t</mi><mo>=</mo><mn>1</mn></mrow><mrow><mi>T</mi><mo>−</mo><mn>1</mn></mrow></munderover><mfrac><mrow><mi>ln</mi><mo lspace="0.167em">⁡</mo><mi>t</mi></mrow><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow></mfrac></mrow><mo rspace="0.111em">≤</mo><mrow><msubsup><mo>∫</mo><mn>1</mn><mi>T</mi></msubsup><mrow><mfrac><mrow><mi>ln</mi><mo lspace="0.167em">⁡</mo><mi>x</mi></mrow><mi>x</mi></mfrac><mo lspace="0.170em" rspace="0em">​</mo><mrow><mo rspace="0em">𝑑</mo><mi>x</mi></mrow></mrow></mrow><mo>=</mo><mfrac><mrow><msup><mi>ln</mi><mn>2</mn></msup><mo lspace="0.167em">⁡</mo><mi>T</mi></mrow><mn>2</mn></mfrac></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\sum_{t=1}^{T-1}\frac{\ln t}{t+1}\leq\int_{1}^{T}\frac{\ln x}{x}\,dx=\frac{\ln^{2}T}{2}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="A3.SS5.SSS0.Px2.p2" class="ltx_para">
<p id="A3.SS5.SSS0.Px2.p2.1" class="ltx_p">Thus, together with Corollary <a href="#Thmtheorem27" title="Corollary 27 (Optimization Error on Common Learning Rate). ‣ 4.2 Results on Convex Case ‣ 4 Theoretical Analysis ‣ Stability and Generalization of Push-Sum Based Decentralized Optimization over Directed Graphs" class="ltx_ref"><span class="ltx_text ltx_ref_tag">27</span></a>, the excess generalization bound becomes</p>
<table id="A3.EGx31" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A3.Ex92"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.Ex92.m1" class="ltx_Math" alttext="\displaystyle\epsilon_{\mathrm{exc}}" display="inline" intent=":literal"><semantics><msub><mi>ϵ</mi><mi>exc</mi></msub><annotation encoding="application/x-tex">\displaystyle\epsilon_{\mathrm{exc}}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex92.m2" class="ltx_Math" alttext="\displaystyle\leq\epsilon_{\mathrm{avg\text{-}stab}}+\epsilon_{\mathrm{opt}}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≤</mo><mrow><msub><mi>ϵ</mi><mrow><mi>avg</mi><mo lspace="0em" rspace="0em">​</mo><mtext>-</mtext><mo lspace="0em" rspace="0em">​</mo><mi>stab</mi></mrow></msub><mo>+</mo><msub><mi>ϵ</mi><mi>opt</mi></msub></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\leq\epsilon_{\mathrm{avg\text{-}stab}}+\epsilon_{\mathrm{opt}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A3.Ex93"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex93.m1" class="ltx_Math" alttext="\displaystyle\leq\frac{2G^{2}v}{mn}\ln T+\left(\frac{4GCLvC_{w_{0}}}{\delta(1-\lambda)}+\frac{8CG^{2}Lv^{2}}{\delta(1-\lambda)}+\frac{4G^{2}v}{mn}\right)\frac{1}{\ln T}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≤</mo><mrow><mrow><mstyle displaystyle="true"><mfrac><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msup><mi>G</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mi>v</mi></mrow><mrow><mi>m</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow></mfrac></mstyle><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>ln</mi><mo lspace="0.167em">⁡</mo><mi>T</mi></mrow></mrow><mo>+</mo><mrow><mrow><mo>(</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mn>4</mn><mo lspace="0em" rspace="0em">​</mo><mi>G</mi><mo lspace="0em" rspace="0em">​</mo><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><mi>L</mi><mo lspace="0em" rspace="0em">​</mo><mi>v</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>C</mi><msub><mi>w</mi><mn>0</mn></msub></msub></mrow><mrow><mi>δ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>λ</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle><mo>+</mo><mstyle displaystyle="true"><mfrac><mrow><mn>8</mn><mo lspace="0em" rspace="0em">​</mo><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>G</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mi>L</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>v</mi><mn>2</mn></msup></mrow><mrow><mi>δ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>λ</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle><mo>+</mo><mstyle displaystyle="true"><mfrac><mrow><mn>4</mn><mo lspace="0em" rspace="0em">​</mo><msup><mi>G</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mi>v</mi></mrow><mrow><mi>m</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow></mfrac></mstyle></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mrow><mi>ln</mi><mo lspace="0.167em">⁡</mo><mi>T</mi></mrow></mfrac></mstyle></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\leq\frac{2G^{2}v}{mn}\ln T+\left(\frac{4GCLvC_{w_{0}}}{\delta(1-\lambda)}+\frac{8CG^{2}Lv^{2}}{\delta(1-\lambda)}+\frac{4G^{2}v}{mn}\right)\frac{1}{\ln T}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A3.Ex94"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex94.m1" class="ltx_Math" alttext="\displaystyle\quad+\left(\frac{\|\overline{\bm{w}}^{(0)}-\bm{w}_{\bm{S}}^{*}\|^{2}}{v}+\frac{4rCLC_{w_{0}}}{\delta(1-\lambda)}+\frac{8vrCLG}{\delta(1-\lambda)}+2vG^{2}\right)\frac{1}{\ln T}" display="inline" intent=":literal"><semantics><mrow><mo>+</mo><mrow><mrow><mo>(</mo><mrow><mstyle displaystyle="true"><mfrac><msup><mrow><mo stretchy="false">‖</mo><mrow><msup><mover accent="true"><mi>𝒘</mi><mo stretchy="true">¯</mo></mover><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></msup><mo>−</mo><msubsup><mi>𝒘</mi><mi>𝑺</mi><mo>∗</mo></msubsup></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup><mi>v</mi></mfrac></mstyle><mo>+</mo><mstyle displaystyle="true"><mfrac><mrow><mn>4</mn><mo lspace="0em" rspace="0em">​</mo><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><mi>L</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>C</mi><msub><mi>w</mi><mn>0</mn></msub></msub></mrow><mrow><mi>δ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>λ</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle><mo>+</mo><mstyle displaystyle="true"><mfrac><mrow><mn>8</mn><mo lspace="0em" rspace="0em">​</mo><mi>v</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><mi>L</mi><mo lspace="0em" rspace="0em">​</mo><mi>G</mi></mrow><mrow><mi>δ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>λ</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle><mo>+</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>v</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>G</mi><mn>2</mn></msup></mrow></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mrow><mi>ln</mi><mo lspace="0.167em">⁡</mo><mi>T</mi></mrow></mfrac></mstyle></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\quad+\left(\frac{\|\overline{\bm{w}}^{(0)}-\bm{w}_{\bm{S}}^{*}\|^{2}}{v}+\frac{4rCLC_{w_{0}}}{\delta(1-\lambda)}+\frac{8vrCLG}{\delta(1-\lambda)}+2vG^{2}\right)\frac{1}{\ln T}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A3.E77"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.E77.m1" class="ltx_Math" alttext="\displaystyle\quad+\left(\frac{4GCLvC_{w_{0}}}{\delta(1-\lambda)}+\frac{8CG^{2}Lv^{2}}{\delta(1-\lambda)}+\frac{4G^{2}v}{mn}\right)." display="inline" intent=":literal"><semantics><mrow><mrow><mo>+</mo><mrow><mo>(</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mn>4</mn><mo lspace="0em" rspace="0em">​</mo><mi>G</mi><mo lspace="0em" rspace="0em">​</mo><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><mi>L</mi><mo lspace="0em" rspace="0em">​</mo><mi>v</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>C</mi><msub><mi>w</mi><mn>0</mn></msub></msub></mrow><mrow><mi>δ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>λ</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle><mo>+</mo><mstyle displaystyle="true"><mfrac><mrow><mn>8</mn><mo lspace="0em" rspace="0em">​</mo><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>G</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mi>L</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>v</mi><mn>2</mn></msup></mrow><mrow><mi>δ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>λ</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle><mo>+</mo><mstyle displaystyle="true"><mfrac><mrow><mn>4</mn><mo lspace="0em" rspace="0em">​</mo><msup><mi>G</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mi>v</mi></mrow><mrow><mi>m</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow></mfrac></mstyle></mrow><mo>)</mo></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\quad+\left(\frac{4GCLvC_{w_{0}}}{\delta(1-\lambda)}+\frac{8CG^{2}Lv^{2}}{\delta(1-\lambda)}+\frac{4G^{2}v}{mn}\right).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(77)</span></td></tr></tbody>
</table>
</div>
<div id="A3.SS5.SSS0.Px2.p3" class="ltx_para">
<p id="A3.SS5.SSS0.Px2.p3.1" class="ltx_p">We have</p>
<table id="A3.EGx32" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A3.E78"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.E78.m1" class="ltx_Math" alttext="\displaystyle\epsilon_{\mathrm{exc}}(T)\leq A\ln T+\frac{B}{\ln T}+C," display="inline" intent=":literal"><semantics><mrow><mrow><mrow><msub><mi>ϵ</mi><mi>exc</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>T</mi><mo stretchy="false">)</mo></mrow></mrow><mo>≤</mo><mrow><mrow><mi>A</mi><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>ln</mi><mo lspace="0.167em">⁡</mo><mi>T</mi></mrow></mrow><mo>+</mo><mstyle displaystyle="true"><mfrac><mi>B</mi><mrow><mi>ln</mi><mo lspace="0.167em">⁡</mo><mi>T</mi></mrow></mfrac></mstyle><mo>+</mo><mi>C</mi></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\epsilon_{\mathrm{exc}}(T)\leq A\ln T+\frac{B}{\ln T}+C,</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(78)</span></td></tr></tbody>
</table>
<p id="A3.SS5.SSS0.Px2.p3.2" class="ltx_p">where one can take</p>
<table id="A3.EGx33" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A3.Ex95"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.Ex95.m1" class="ltx_Math" alttext="\displaystyle A" display="inline" intent=":literal"><semantics><mi>A</mi><annotation encoding="application/x-tex">\displaystyle A</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex95.m2" class="ltx_Math" alttext="\displaystyle:=\frac{2G^{2}v}{mn}," display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mphantom></mphantom><mo>=</mo><mstyle displaystyle="true"><mfrac><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msup><mi>G</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mi>v</mi></mrow><mrow><mi>m</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow></mfrac></mstyle></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle:=\frac{2G^{2}v}{mn},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A3.Ex96"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.Ex96.m1" class="ltx_Math" alttext="\displaystyle B" display="inline" intent=":literal"><semantics><mi>B</mi><annotation encoding="application/x-tex">\displaystyle B</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex96.m2" class="ltx_Math" alttext="\displaystyle:=\left(\frac{4GCLvC_{w_{0}}}{\delta(1-\lambda)}+\frac{8CG^{2}Lv^{2}}{\delta(1-\lambda)}+\frac{4G^{2}v}{mn}\right)+\left(\frac{\|\overline{\bm{w}}^{(0)}-\bm{w}_{\bm{S}}^{*}\|^{2}}{v}+\frac{4rCLC_{w_{0}}}{\delta(1-\lambda)}+\frac{8vrCLG}{\delta(1-\lambda)}+2vG^{2}\right)," display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><mo>(</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mn>4</mn><mo lspace="0em" rspace="0em">​</mo><mi>G</mi><mo lspace="0em" rspace="0em">​</mo><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><mi>L</mi><mo lspace="0em" rspace="0em">​</mo><mi>v</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>C</mi><msub><mi>w</mi><mn>0</mn></msub></msub></mrow><mrow><mi>δ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>λ</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle><mo>+</mo><mstyle displaystyle="true"><mfrac><mrow><mn>8</mn><mo lspace="0em" rspace="0em">​</mo><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>G</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mi>L</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>v</mi><mn>2</mn></msup></mrow><mrow><mi>δ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>λ</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle><mo>+</mo><mstyle displaystyle="true"><mfrac><mrow><mn>4</mn><mo lspace="0em" rspace="0em">​</mo><msup><mi>G</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mi>v</mi></mrow><mrow><mi>m</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow></mfrac></mstyle></mrow><mo>)</mo></mrow><mo>+</mo><mrow><mo>(</mo><mrow><mstyle displaystyle="true"><mfrac><msup><mrow><mo stretchy="false">‖</mo><mrow><msup><mover accent="true"><mi>𝒘</mi><mo stretchy="true">¯</mo></mover><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></msup><mo>−</mo><msubsup><mi>𝒘</mi><mi>𝑺</mi><mo>∗</mo></msubsup></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup><mi>v</mi></mfrac></mstyle><mo>+</mo><mstyle displaystyle="true"><mfrac><mrow><mn>4</mn><mo lspace="0em" rspace="0em">​</mo><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><mi>L</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>C</mi><msub><mi>w</mi><mn>0</mn></msub></msub></mrow><mrow><mi>δ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>λ</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle><mo>+</mo><mstyle displaystyle="true"><mfrac><mrow><mn>8</mn><mo lspace="0em" rspace="0em">​</mo><mi>v</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><mi>L</mi><mo lspace="0em" rspace="0em">​</mo><mi>G</mi></mrow><mrow><mi>δ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>λ</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle><mo>+</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>v</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>G</mi><mn>2</mn></msup></mrow></mrow><mo>)</mo></mrow></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle:=\left(\frac{4GCLvC_{w_{0}}}{\delta(1-\lambda)}+\frac{8CG^{2}Lv^{2}}{\delta(1-\lambda)}+\frac{4G^{2}v}{mn}\right)+\left(\frac{\|\overline{\bm{w}}^{(0)}-\bm{w}_{\bm{S}}^{*}\|^{2}}{v}+\frac{4rCLC_{w_{0}}}{\delta(1-\lambda)}+\frac{8vrCLG}{\delta(1-\lambda)}+2vG^{2}\right),</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A3.Ex97"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.Ex97.m1" class="ltx_Math" alttext="\displaystyle C" display="inline" intent=":literal"><semantics><mi>C</mi><annotation encoding="application/x-tex">\displaystyle C</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex97.m2" class="ltx_Math" alttext="\displaystyle:=\left(\frac{4GCLvC_{w_{0}}}{\delta(1-\lambda)}+\frac{8CG^{2}Lv^{2}}{\delta(1-\lambda)}+\frac{4G^{2}v}{mn}\right)." display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mphantom></mphantom><mo>=</mo><mrow><mo>(</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mn>4</mn><mo lspace="0em" rspace="0em">​</mo><mi>G</mi><mo lspace="0em" rspace="0em">​</mo><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><mi>L</mi><mo lspace="0em" rspace="0em">​</mo><mi>v</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>C</mi><msub><mi>w</mi><mn>0</mn></msub></msub></mrow><mrow><mi>δ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>λ</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle><mo>+</mo><mstyle displaystyle="true"><mfrac><mrow><mn>8</mn><mo lspace="0em" rspace="0em">​</mo><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>G</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mi>L</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>v</mi><mn>2</mn></msup></mrow><mrow><mi>δ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>λ</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle><mo>+</mo><mstyle displaystyle="true"><mfrac><mrow><mn>4</mn><mo lspace="0em" rspace="0em">​</mo><msup><mi>G</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mi>v</mi></mrow><mrow><mi>m</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow></mfrac></mstyle></mrow><mo>)</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle:=\left(\frac{4GCLvC_{w_{0}}}{\delta(1-\lambda)}+\frac{8CG^{2}Lv^{2}}{\delta(1-\lambda)}+\frac{4G^{2}v}{mn}\right).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="A3.SS5.SSS0.Px2.p4" class="ltx_para">
<p id="A3.SS5.SSS0.Px2.p4.1" class="ltx_p">Viewing the right-hand side as a function of <math id="A3.SS5.SSS0.Px2.p4.m1" class="ltx_Math" alttext="x=\ln T&gt;0" display="inline" intent=":literal"><semantics><mrow><mi>x</mi><mo>=</mo><mrow><mi>ln</mi><mo lspace="0.167em">⁡</mo><mi>T</mi></mrow><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">x=\ln T&gt;0</annotation></semantics></math>,</p>
<table id="A3.EGx34" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A3.E79"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.E79.m1" class="ltx_Math" alttext="\displaystyle\phi(x)=Ax+\frac{B}{x}+C," display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mi>ϕ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mrow><mi>A</mi><mo lspace="0em" rspace="0em">​</mo><mi>x</mi></mrow><mo>+</mo><mstyle displaystyle="true"><mfrac><mi>B</mi><mi>x</mi></mfrac></mstyle><mo>+</mo><mi>C</mi></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\phi(x)=Ax+\frac{B}{x}+C,</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(79)</span></td></tr></tbody>
</table>
<p id="A3.SS5.SSS0.Px2.p4.2" class="ltx_p">standard calculus shows that <math id="A3.SS5.SSS0.Px2.p4.m2" class="ltx_Math" alttext="\phi" display="inline" intent=":literal"><semantics><mi>ϕ</mi><annotation encoding="application/x-tex">\phi</annotation></semantics></math> is minimized at <math id="A3.SS5.SSS0.Px2.p4.m3" class="ltx_Math" alttext="x^{*}=\sqrt{B/A}" display="inline" intent=":literal"><semantics><mrow><msup><mi>x</mi><mo>∗</mo></msup><mo>=</mo><msqrt><mrow><mi>B</mi><mo>/</mo><mi>A</mi></mrow></msqrt></mrow><annotation encoding="application/x-tex">x^{*}=\sqrt{B/A}</annotation></semantics></math>, i.e.,</p>
<table id="A3.EGx35" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A3.E80"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.E80.m1" class="ltx_Math" alttext="\displaystyle\ln T^{*}=\sqrt{\frac{B}{A}}\qquad\Longrightarrow\qquad T^{*}=\exp\!\Bigl(\sqrt{B/A}\Bigr)," display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mrow><mi>ln</mi><mo lspace="0.167em">⁡</mo><msup><mi>T</mi><mo>∗</mo></msup></mrow><mo>=</mo><msqrt><mstyle displaystyle="true"><mfrac><mi>B</mi><mi>A</mi></mfrac></mstyle></msqrt></mrow><mspace style="width:2em;" width="2em"></mspace><mo stretchy="false">⟹</mo><mspace style="width:2em;" width="2em"></mspace><mrow><msup><mi>T</mi><mo>∗</mo></msup><mo>=</mo><mrow><mpadded style="width:1.370em;" width="1.370em"><mi>exp</mi></mpadded><mo>⁡</mo><mrow><mo maxsize="1.600em" minsize="1.600em">(</mo><msqrt><mrow><mi>B</mi><mo>/</mo><mi>A</mi></mrow></msqrt><mo maxsize="1.600em" minsize="1.600em">)</mo></mrow></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\ln T^{*}=\sqrt{\frac{B}{A}}\qquad\Longrightarrow\qquad T^{*}=\exp\!\Bigl(\sqrt{B/A}\Bigr),</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(80)</span></td></tr></tbody>
</table>
<p id="A3.SS5.SSS0.Px2.p4.3" class="ltx_p">and the corresponding minimum value satisfies</p>
<table id="A3.EGx36" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A3.E81"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.E81.m1" class="ltx_Math" alttext="\displaystyle\epsilon_{\mathrm{exc}}^{*}\leq 2\sqrt{AB}+C." display="inline" intent=":literal"><semantics><mrow><mrow><msubsup><mi>ϵ</mi><mi>exc</mi><mo>∗</mo></msubsup><mo>≤</mo><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msqrt><mrow><mi>A</mi><mo lspace="0em" rspace="0em">​</mo><mi>B</mi></mrow></msqrt></mrow><mo>+</mo><mi>C</mi></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\epsilon_{\mathrm{exc}}^{*}\leq 2\sqrt{AB}+C.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(81)</span></td></tr></tbody>
</table>
</div>
<div id="A3.SS5.SSS0.Px2.p5" class="ltx_para">
<p id="A3.SS5.SSS0.Px2.p5.1" class="ltx_p">Moreover,</p>
<table id="A3.EGx37" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A3.E82"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.E82.m1" class="ltx_Math" alttext="\displaystyle\sqrt{AB}" display="inline" intent=":literal"><semantics><msqrt><mrow><mi>A</mi><mo lspace="0em" rspace="0em">​</mo><mi>B</mi></mrow></msqrt><annotation encoding="application/x-tex">\displaystyle\sqrt{AB}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.E82.m2" class="ltx_Math" alttext="\displaystyle=\sqrt{\frac{2G^{2}v}{mn}\cdot B}\leq\frac{\sqrt{2}\,G}{\sqrt{mn}}\sqrt{B}," display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>=</mo><msqrt><mrow><mstyle displaystyle="true"><mfrac><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msup><mi>G</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mi>v</mi></mrow><mrow><mi>m</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow></mfrac></mstyle><mo lspace="0.222em" rspace="0.222em">⋅</mo><mi>B</mi></mrow></msqrt><mo>≤</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><msqrt><mn>2</mn></msqrt><mo lspace="0.170em" rspace="0em">​</mo><mi>G</mi></mrow><msqrt><mrow><mi>m</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow></msqrt></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msqrt><mi>B</mi></msqrt></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle=\sqrt{\frac{2G^{2}v}{mn}\cdot B}\leq\frac{\sqrt{2}\,G}{\sqrt{mn}}\sqrt{B},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(82)</span></td></tr></tbody>
</table>
<p id="A3.SS5.SSS0.Px2.p5.2" class="ltx_p">so keeping the key scalings in the problem parameters, we obtain</p>
<table id="A3.EGx38" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A3.Ex98"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.Ex98.m1" class="ltx_Math" alttext="\displaystyle\epsilon_{\mathrm{exc}}^{*}=\mathcal{O}\Bigg(" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>ϵ</mi><mi>exc</mi><mo>∗</mo></msubsup><mo>=</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒪</mi><mo>⁡</mo><mrow><mo maxsize="2.600em" minsize="2.600em">(</mo><mo fence="true" lspace="0em">CLOSE</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\epsilon_{\mathrm{exc}}^{*}=\mathcal{O}\Bigg(</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex98.m2" class="ltx_Math" alttext="\displaystyle\frac{G}{\sqrt{mn}}\sqrt{\frac{\|\overline{\bm{w}}^{(0)}-\bm{w}_{\bm{S}}^{*}\|^{2}}{v}+\frac{CLvC_{w_{0}}}{\delta(1-\lambda)}+\frac{CG^{2}Lv^{2}}{\delta(1-\lambda)}+\frac{G^{2}v}{mn}}" display="inline" intent=":literal"><semantics><mrow><mstyle displaystyle="true"><mfrac><mi>G</mi><msqrt><mrow><mi>m</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow></msqrt></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msqrt><mrow><mstyle displaystyle="true"><mfrac><msup><mrow><mo stretchy="false">‖</mo><mrow><msup><mover accent="true"><mi>𝒘</mi><mo stretchy="true">¯</mo></mover><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></msup><mo>−</mo><msubsup><mi>𝒘</mi><mi>𝑺</mi><mo>∗</mo></msubsup></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup><mi>v</mi></mfrac></mstyle><mo>+</mo><mstyle displaystyle="true"><mfrac><mrow><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><mi>L</mi><mo lspace="0em" rspace="0em">​</mo><mi>v</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>C</mi><msub><mi>w</mi><mn>0</mn></msub></msub></mrow><mrow><mi>δ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>λ</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle><mo>+</mo><mstyle displaystyle="true"><mfrac><mrow><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>G</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mi>L</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>v</mi><mn>2</mn></msup></mrow><mrow><mi>δ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>λ</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle><mo>+</mo><mstyle displaystyle="true"><mfrac><mrow><msup><mi>G</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mi>v</mi></mrow><mrow><mi>m</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow></mfrac></mstyle></mrow></msqrt></mrow><annotation encoding="application/x-tex">\displaystyle\frac{G}{\sqrt{mn}}\sqrt{\frac{\|\overline{\bm{w}}^{(0)}-\bm{w}_{\bm{S}}^{*}\|^{2}}{v}+\frac{CLvC_{w_{0}}}{\delta(1-\lambda)}+\frac{CG^{2}Lv^{2}}{\delta(1-\lambda)}+\frac{G^{2}v}{mn}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A3.E83"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.E83.m1" class="ltx_Math" alttext="\displaystyle\quad+\frac{G}{\sqrt{mn}}\sqrt{\frac{rCLC_{w_{0}}}{\delta(1-\lambda)}+\frac{vrCLG}{\delta(1-\lambda)}+vG^{2}}+\frac{GCLvC_{w_{0}}}{\delta(1-\lambda)}+\frac{CG^{2}Lv^{2}}{\delta(1-\lambda)}+\frac{G^{2}v}{mn}\Bigg)." display="inline" intent=":literal"><semantics><mrow><mrow><mo fence="true" rspace="0em">OPEN</mo><mrow><mrow><mo>+</mo><mrow><mstyle displaystyle="true"><mfrac><mi>G</mi><msqrt><mrow><mi>m</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow></msqrt></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msqrt><mrow><mstyle displaystyle="true"><mfrac><mrow><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><mi>L</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>C</mi><msub><mi>w</mi><mn>0</mn></msub></msub></mrow><mrow><mi>δ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>λ</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle><mo>+</mo><mstyle displaystyle="true"><mfrac><mrow><mi>v</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><mi>L</mi><mo lspace="0em" rspace="0em">​</mo><mi>G</mi></mrow><mrow><mi>δ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>λ</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle><mo>+</mo><mrow><mi>v</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>G</mi><mn>2</mn></msup></mrow></mrow></msqrt></mrow></mrow><mo>+</mo><mstyle displaystyle="true"><mfrac><mrow><mi>G</mi><mo lspace="0em" rspace="0em">​</mo><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><mi>L</mi><mo lspace="0em" rspace="0em">​</mo><mi>v</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>C</mi><msub><mi>w</mi><mn>0</mn></msub></msub></mrow><mrow><mi>δ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>λ</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle><mo>+</mo><mstyle displaystyle="true"><mfrac><mrow><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>G</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mi>L</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>v</mi><mn>2</mn></msup></mrow><mrow><mi>δ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>λ</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle><mo>+</mo><mstyle displaystyle="true"><mfrac><mrow><msup><mi>G</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mi>v</mi></mrow><mrow><mi>m</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow></mfrac></mstyle></mrow><mo maxsize="2.600em" minsize="2.600em">)</mo></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\quad+\frac{G}{\sqrt{mn}}\sqrt{\frac{rCLC_{w_{0}}}{\delta(1-\lambda)}+\frac{vrCLG}{\delta(1-\lambda)}+vG^{2}}+\frac{GCLvC_{w_{0}}}{\delta(1-\lambda)}+\frac{CG^{2}Lv^{2}}{\delta(1-\lambda)}+\frac{G^{2}v}{mn}\Bigg).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(83)</span></td></tr></tbody>
</table>
</div>
<div id="A3.SS5.SSS0.Px2.p6" class="ltx_para">
<p id="A3.SS5.SSS0.Px2.p6.1" class="ltx_p">This completes the proof of Corollary <a href="#Thmtheorem29" title="Corollary 29 (Excess Generalization Error on Common Learning Rate). ‣ 4.2 Results on Convex Case ‣ 4 Theoretical Analysis ‣ Stability and Generalization of Push-Sum Based Decentralized Optimization over Directed Graphs" class="ltx_ref"><span class="ltx_text ltx_ref_tag">29</span></a>.
∎</p>
</div>
</section>
</section>
<section id="A3.SS6" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">C.6 </span>Proof of Theorem <a href="#Thmtheorem31" title="Theorem 31. ‣ 4.3 Results on Non-convex Case ‣ 4 Theoretical Analysis ‣ Stability and Generalization of Push-Sum Based Decentralized Optimization over Directed Graphs" class="ltx_ref"><span class="ltx_text ltx_ref_tag">31</span></a></h3>

<div id="A3.SS6.2" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="A3.SS6.p1" class="ltx_para">
<p id="A3.SS6.p1.1" class="ltx_p"><span id="A3.SS6.p1.1.1" class="ltx_text">Assume that the two sample sets <math id="A3.SS6.p1.m1" class="ltx_Math" alttext="\bm{S}" display="inline" intent=":literal"><semantics><mi>𝑺</mi><annotation encoding="application/x-tex">\bm{S}</annotation></semantics></math> and <math id="A3.SS6.p1.m2" class="ltx_Math" alttext="\bm{S}^{\prime}" display="inline" intent=":literal"><semantics><msup><mi>𝑺</mi><mo>′</mo></msup><annotation encoding="application/x-tex">\bm{S}^{\prime}</annotation></semantics></math> differ in only one sample among the first <math id="A3.SS6.p1.m3" class="ltx_Math" alttext="n" display="inline" intent=":literal"><semantics><mi>n</mi><annotation encoding="application/x-tex">n</annotation></semantics></math> samples.
Let <math id="A3.SS6.p1.m4" class="ltx_Math" alttext="\Delta_{t}:=\|\overline{\bm{w}}^{(t)}-\overline{\bm{w}}^{\prime(t)}\|" display="inline" intent=":literal"><semantics><mrow><msub><mi mathvariant="normal">Δ</mi><mi>t</mi></msub><mo>:=</mo><mrow><mo stretchy="false">‖</mo><mrow><msup><mover accent="true"><mi>𝒘</mi><mo stretchy="true">¯</mo></mover><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo>−</mo><msup><mover accent="true"><mi>𝒘</mi><mo stretchy="true">¯</mo></mover><mrow><mo rspace="0em">′</mo><mphantom></mphantom><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow></msup></mrow><mo stretchy="false">‖</mo></mrow></mrow><annotation encoding="application/x-tex">\Delta_{t}:=\|\overline{\bm{w}}^{(t)}-\overline{\bm{w}}^{\prime(t)}\|</annotation></semantics></math>.</span></p>
</div>
</div>
<section id="A3.SS6.SSS0.Px1" class="ltx_paragraph">
<h4 class="ltx_title ltx_title_paragraph">Case 1: Identical Samples (with probability <math id="A3.SS6.SSS0.Px1.m1" class="ltx_Math" alttext="1-\frac{1}{n}" display="inline" intent=":literal"><semantics><mrow><mn>1</mn><mo>−</mo><mfrac><mn>1</mn><mi>n</mi></mfrac></mrow><annotation encoding="application/x-tex">1-\frac{1}{n}</annotation></semantics></math>).</h4>

<div id="A3.SS6.SSS0.Px1.p1" class="ltx_para">
<p id="A3.SS6.SSS0.Px1.p1.1" class="ltx_p">In this case, <math id="A3.SS6.SSS0.Px1.p1.m1" class="ltx_Math" alttext="\bm{\xi}_{i}^{(t)}" display="inline" intent=":literal"><semantics><msubsup><mi>𝝃</mi><mi>i</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msubsup><annotation encoding="application/x-tex">\bm{\xi}_{i}^{(t)}</annotation></semantics></math> are identical for both runs, and</p>
<table id="A3.EGx39" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A3.Ex99"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.Ex99.m1" class="ltx_Math" alttext="\displaystyle\Delta_{t+1}" display="inline" intent=":literal"><semantics><msub><mi mathvariant="normal">Δ</mi><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow></msub><annotation encoding="application/x-tex">\displaystyle\Delta_{t+1}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex99.m2" class="ltx_Math" alttext="\displaystyle=\Big\|\overline{\bm{w}}^{(t)}-\overline{\bm{w}}^{\prime(t)}-\frac{\gamma_{t}}{m}\sum_{i=1}^{m}\Big(\nabla f(\bm{z}_{i}^{(t)};\bm{\xi}_{i}^{(t)})-\nabla f(\bm{z}_{i}^{\prime(t)};\bm{\xi}_{i}^{(t)})\Big)\Big\|" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mo maxsize="1.600em" minsize="1.600em" stretchy="true">‖</mo><mrow><msup><mover accent="true"><mi>𝒘</mi><mo stretchy="true">¯</mo></mover><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo>−</mo><msup><mover accent="true"><mi>𝒘</mi><mo stretchy="true">¯</mo></mover><mrow><mo rspace="0em">′</mo><mphantom></mphantom><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow></msup><mo>−</mo><mrow><mstyle displaystyle="true"><mfrac><msub><mi>γ</mi><mi>t</mi></msub><mi>m</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>m</mi></munderover></mstyle><mrow><mo maxsize="1.600em" minsize="1.600em">(</mo><mrow><mrow><mrow><mo rspace="0.167em">∇</mo><mi>f</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>𝒛</mi><mi>i</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msubsup><mo>,</mo><msubsup><mi>𝝃</mi><mi>i</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msubsup><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mrow><mo rspace="0.167em">∇</mo><mi>f</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>𝒛</mi><mi>i</mi><mrow><mo rspace="0em">′</mo><mphantom></mphantom><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow></msubsup><mo>,</mo><msubsup><mi>𝝃</mi><mi>i</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msubsup><mo stretchy="false">)</mo></mrow></mrow></mrow><mo maxsize="1.600em" minsize="1.600em">)</mo></mrow></mrow></mrow></mrow><mo maxsize="1.600em" minsize="1.600em" stretchy="true">‖</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\Big\|\overline{\bm{w}}^{(t)}-\overline{\bm{w}}^{\prime(t)}-\frac{\gamma_{t}}{m}\sum_{i=1}^{m}\Big(\nabla f(\bm{z}_{i}^{(t)};\bm{\xi}_{i}^{(t)})-\nabla f(\bm{z}_{i}^{\prime(t)};\bm{\xi}_{i}^{(t)})\Big)\Big\|</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A3.Ex100"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex100.m1" class="ltx_Math" alttext="\displaystyle\leq\Big\|\overline{\bm{w}}^{(t)}-\overline{\bm{w}}^{\prime(t)}-\frac{\gamma_{t}}{m}\sum_{i=1}^{m}\Big(\nabla f(\overline{\bm{w}}^{(t)};\bm{\xi}_{i}^{(t)})-\nabla f(\overline{\bm{w}}^{\prime(t)};\bm{\xi}_{i}^{(t)})\Big)\Big\|" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≤</mo><mrow><mo maxsize="1.600em" minsize="1.600em" stretchy="true">‖</mo><mrow><msup><mover accent="true"><mi>𝒘</mi><mo stretchy="true">¯</mo></mover><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo>−</mo><msup><mover accent="true"><mi>𝒘</mi><mo stretchy="true">¯</mo></mover><mrow><mo rspace="0em">′</mo><mphantom></mphantom><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow></msup><mo>−</mo><mrow><mstyle displaystyle="true"><mfrac><msub><mi>γ</mi><mi>t</mi></msub><mi>m</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>m</mi></munderover></mstyle><mrow><mo maxsize="1.600em" minsize="1.600em">(</mo><mrow><mrow><mrow><mo rspace="0.167em">∇</mo><mi>f</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mover accent="true"><mi>𝒘</mi><mo stretchy="true">¯</mo></mover><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo>,</mo><msubsup><mi>𝝃</mi><mi>i</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msubsup><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mrow><mo rspace="0.167em">∇</mo><mi>f</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mover accent="true"><mi>𝒘</mi><mo stretchy="true">¯</mo></mover><mrow><mo rspace="0em">′</mo><mphantom></mphantom><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow></msup><mo>,</mo><msubsup><mi>𝝃</mi><mi>i</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msubsup><mo stretchy="false">)</mo></mrow></mrow></mrow><mo maxsize="1.600em" minsize="1.600em">)</mo></mrow></mrow></mrow></mrow><mo maxsize="1.600em" minsize="1.600em" stretchy="true">‖</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\leq\Big\|\overline{\bm{w}}^{(t)}-\overline{\bm{w}}^{\prime(t)}-\frac{\gamma_{t}}{m}\sum_{i=1}^{m}\Big(\nabla f(\overline{\bm{w}}^{(t)};\bm{\xi}_{i}^{(t)})-\nabla f(\overline{\bm{w}}^{\prime(t)};\bm{\xi}_{i}^{(t)})\Big)\Big\|</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A3.Ex101"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex101.m1" class="ltx_Math" alttext="\displaystyle\quad+\Big\|\frac{\gamma_{t}}{m}\sum_{i=1}^{m}\Big(\nabla f(\overline{\bm{w}}^{(t)};\bm{\xi}_{i}^{(t)})-\nabla f(\bm{z}_{i}^{(t)};\bm{\xi}_{i}^{(t)})\Big)\Big\|" display="inline" intent=":literal"><semantics><mrow><mo>+</mo><mrow><mo maxsize="1.600em" minsize="1.600em" stretchy="true">‖</mo><mrow><mstyle displaystyle="true"><mfrac><msub><mi>γ</mi><mi>t</mi></msub><mi>m</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>m</mi></munderover></mstyle><mrow><mo maxsize="1.600em" minsize="1.600em">(</mo><mrow><mrow><mrow><mo rspace="0.167em">∇</mo><mi>f</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mover accent="true"><mi>𝒘</mi><mo stretchy="true">¯</mo></mover><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo>,</mo><msubsup><mi>𝝃</mi><mi>i</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msubsup><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mrow><mo rspace="0.167em">∇</mo><mi>f</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>𝒛</mi><mi>i</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msubsup><mo>,</mo><msubsup><mi>𝝃</mi><mi>i</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msubsup><mo stretchy="false">)</mo></mrow></mrow></mrow><mo maxsize="1.600em" minsize="1.600em">)</mo></mrow></mrow></mrow><mo maxsize="1.600em" minsize="1.600em" stretchy="true">‖</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\quad+\Big\|\frac{\gamma_{t}}{m}\sum_{i=1}^{m}\Big(\nabla f(\overline{\bm{w}}^{(t)};\bm{\xi}_{i}^{(t)})-\nabla f(\bm{z}_{i}^{(t)};\bm{\xi}_{i}^{(t)})\Big)\Big\|</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A3.Ex102"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex102.m1" class="ltx_Math" alttext="\displaystyle\quad+\Big\|\frac{\gamma_{t}}{m}\sum_{i=1}^{m}\Big(\nabla f(\overline{\bm{w}}^{\prime(t)};\bm{\xi}_{i}^{(t)})-\nabla f(\bm{z}_{i}^{\prime(t)};\bm{\xi}_{i}^{(t)})\Big)\Big\|" display="inline" intent=":literal"><semantics><mrow><mo>+</mo><mrow><mo maxsize="1.600em" minsize="1.600em" stretchy="true">‖</mo><mrow><mstyle displaystyle="true"><mfrac><msub><mi>γ</mi><mi>t</mi></msub><mi>m</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>m</mi></munderover></mstyle><mrow><mo maxsize="1.600em" minsize="1.600em">(</mo><mrow><mrow><mrow><mo rspace="0.167em">∇</mo><mi>f</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mover accent="true"><mi>𝒘</mi><mo stretchy="true">¯</mo></mover><mrow><mo rspace="0em">′</mo><mphantom></mphantom><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow></msup><mo>,</mo><msubsup><mi>𝝃</mi><mi>i</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msubsup><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mrow><mo rspace="0.167em">∇</mo><mi>f</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>𝒛</mi><mi>i</mi><mrow><mo rspace="0em">′</mo><mphantom></mphantom><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow></msubsup><mo>,</mo><msubsup><mi>𝝃</mi><mi>i</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msubsup><mo stretchy="false">)</mo></mrow></mrow></mrow><mo maxsize="1.600em" minsize="1.600em">)</mo></mrow></mrow></mrow><mo maxsize="1.600em" minsize="1.600em" stretchy="true">‖</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\quad+\Big\|\frac{\gamma_{t}}{m}\sum_{i=1}^{m}\Big(\nabla f(\overline{\bm{w}}^{\prime(t)};\bm{\xi}_{i}^{(t)})-\nabla f(\bm{z}_{i}^{\prime(t)};\bm{\xi}_{i}^{(t)})\Big)\Big\|</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A3.E84"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.E84.m1" class="ltx_Math" alttext="\displaystyle\overset{\text{Lem}(\ref{lem:hardt}),\,\text{Ass}(\ref{ass:smooth})}{\leq}(1+L\gamma_{t})\Delta_{t}+\frac{L\gamma_{t}}{m}\sum_{i=1}^{m}\|\overline{\bm{w}}^{(t)}-\bm{z}_{i}^{(t)}\|+\frac{L\gamma_{t}}{m}\sum_{i=1}^{m}\|\overline{\bm{w}}^{\prime(t)}-\bm{z}_{i}^{\prime(t)}\|." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mover accent="true"><mo>≤</mo><mrow><mrow><mtext mathsize="0.700em">Lem</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="0.700em" minsize="0.700em">(</mo><mtext class="ltx_mathvariant_italic" mathsize="0.700em"><a href="#Thmtheorem16" title="Lemma 16 (Expansion ( , )). ‣ 3.4 Stability and Generalization Measures ‣ 3 Preliminaries ‣ Stability and Generalization of Push-Sum Based Decentralized Optimization over Directed Graphs" class="ltx_ref ltx_font_italic" style="font-size:70%;"><span class="ltx_text ltx_ref_tag">16</span></a></mtext><mo maxsize="0.700em" minsize="0.700em">)</mo></mrow></mrow><mo mathsize="0.700em" rspace="0.337em">,</mo><mrow><mtext mathsize="0.700em">Ass</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="0.700em" minsize="0.700em">(</mo><mtext class="ltx_mathvariant_italic" mathsize="0.700em"><a href="#Thmtheorem18" title="Assumption 18. ‣ 4.1 Basic Assumptions ‣ 4 Theoretical Analysis ‣ Stability and Generalization of Push-Sum Based Decentralized Optimization over Directed Graphs" class="ltx_ref ltx_font_italic" style="font-size:70%;"><span class="ltx_text ltx_ref_tag">18</span></a></mtext><mo maxsize="0.700em" minsize="0.700em">)</mo></mrow></mrow></mrow></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><mrow><mi>L</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>γ</mi><mi>t</mi></msub></mrow></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi mathvariant="normal">Δ</mi><mi>t</mi></msub></mrow><mo>+</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mi>L</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>γ</mi><mi>t</mi></msub></mrow><mi>m</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>m</mi></munderover></mstyle><mrow><mo stretchy="false">‖</mo><mrow><msup><mover accent="true"><mi>𝒘</mi><mo stretchy="true">¯</mo></mover><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo>−</mo><msubsup><mi>𝒛</mi><mi>i</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msubsup></mrow><mo stretchy="false">‖</mo></mrow></mrow></mrow><mo>+</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mi>L</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>γ</mi><mi>t</mi></msub></mrow><mi>m</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>m</mi></munderover></mstyle><mrow><mo stretchy="false">‖</mo><mrow><msup><mover accent="true"><mi>𝒘</mi><mo stretchy="true">¯</mo></mover><mrow><mo rspace="0em">′</mo><mphantom></mphantom><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow></msup><mo>−</mo><msubsup><mi>𝒛</mi><mi>i</mi><mrow><mo rspace="0em">′</mo><mphantom></mphantom><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow></msubsup></mrow><mo stretchy="false">‖</mo></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\overset{\text{Lem}(\ref{lem:hardt}),\,\text{Ass}(\ref{ass:smooth})}{\leq}(1+L\gamma_{t})\Delta_{t}+\frac{L\gamma_{t}}{m}\sum_{i=1}^{m}\|\overline{\bm{w}}^{(t)}-\bm{z}_{i}^{(t)}\|+\frac{L\gamma_{t}}{m}\sum_{i=1}^{m}\|\overline{\bm{w}}^{\prime(t)}-\bm{z}_{i}^{\prime(t)}\|.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(84)</span></td></tr></tbody>
</table>
<p id="A3.SS6.SSS0.Px1.p1.2" class="ltx_p">Applying Lemma <a href="#Thmtheorem9" title="Lemma 9 (Consistency of Push-Sum). ‣ 3.3 Algorithm: Stochastic Gradient Push (SGP) ‣ 3 Preliminaries ‣ Stability and Generalization of Push-Sum Based Decentralized Optimization over Directed Graphs" class="ltx_ref"><span class="ltx_text ltx_ref_tag">9</span></a> to both runs and using the same <math id="A3.SS6.SSS0.Px1.p1.m2" class="ltx_Math" alttext="C_{w_{0}}" display="inline" intent=":literal"><semantics><msub><mi>C</mi><msub><mi>w</mi><mn>0</mn></msub></msub><annotation encoding="application/x-tex">C_{w_{0}}</annotation></semantics></math>,</p>
<table id="A3.EGx40" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A3.E85"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.E85.m1" class="ltx_Math" alttext="\displaystyle\frac{1}{m}\sum_{i=1}^{m}\|\overline{\bm{w}}^{(t)}-\bm{z}_{i}^{(t)}\|+\frac{1}{m}\sum_{i=1}^{m}\|\overline{\bm{w}}^{\prime(t)}-\bm{z}_{i}^{\prime(t)}\|\leq\frac{2C}{\delta}\Big(\lambda^{t}C_{w_{0}}+G\sum_{s=0}^{t-1}\lambda^{t-s}\gamma_{s}\Big)." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>m</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>m</mi></munderover></mstyle><mrow><mo stretchy="false">‖</mo><mrow><msup><mover accent="true"><mi>𝒘</mi><mo stretchy="true">¯</mo></mover><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo>−</mo><msubsup><mi>𝒛</mi><mi>i</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msubsup></mrow><mo stretchy="false">‖</mo></mrow></mrow></mrow><mo>+</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>m</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>m</mi></munderover></mstyle><mrow><mo stretchy="false">‖</mo><mrow><msup><mover accent="true"><mi>𝒘</mi><mo stretchy="true">¯</mo></mover><mrow><mo rspace="0em">′</mo><mphantom></mphantom><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow></msup><mo>−</mo><msubsup><mi>𝒛</mi><mi>i</mi><mrow><mo rspace="0em">′</mo><mphantom></mphantom><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow></msubsup></mrow><mo stretchy="false">‖</mo></mrow></mrow></mrow></mrow><mo>≤</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>C</mi></mrow><mi>δ</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="1.600em" minsize="1.600em">(</mo><mrow><mrow><msup><mi>λ</mi><mi>t</mi></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>C</mi><msub><mi>w</mi><mn>0</mn></msub></msub></mrow><mo>+</mo><mrow><mi>G</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>s</mi><mo>=</mo><mn>0</mn></mrow><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow></munderover></mstyle><mrow><msup><mi>λ</mi><mrow><mi>t</mi><mo>−</mo><mi>s</mi></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>γ</mi><mi>s</mi></msub></mrow></mrow></mrow></mrow><mo maxsize="1.600em" minsize="1.600em">)</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\frac{1}{m}\sum_{i=1}^{m}\|\overline{\bm{w}}^{(t)}-\bm{z}_{i}^{(t)}\|+\frac{1}{m}\sum_{i=1}^{m}\|\overline{\bm{w}}^{\prime(t)}-\bm{z}_{i}^{\prime(t)}\|\leq\frac{2C}{\delta}\Big(\lambda^{t}C_{w_{0}}+G\sum_{s=0}^{t-1}\lambda^{t-s}\gamma_{s}\Big).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(85)</span></td></tr></tbody>
</table>
<p id="A3.SS6.SSS0.Px1.p1.3" class="ltx_p">Substituting (<a href="#A3.E85" title="In Case 1: Identical Samples (with probability 1-{1/𝑛}). ‣ C.6 Proof of Theorem ‣ Appendix C Proof of Theorem and Corollary ‣ Stability and Generalization of Push-Sum Based Decentralized Optimization over Directed Graphs" class="ltx_ref"><span class="ltx_text ltx_ref_tag">85</span></a>) into (<a href="#A3.E84" title="In Case 1: Identical Samples (with probability 1-{1/𝑛}). ‣ C.6 Proof of Theorem ‣ Appendix C Proof of Theorem and Corollary ‣ Stability and Generalization of Push-Sum Based Decentralized Optimization over Directed Graphs" class="ltx_ref"><span class="ltx_text ltx_ref_tag">84</span></a>) gives</p>
<table id="A3.EGx41" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A3.E86"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.E86.m1" class="ltx_Math" alttext="\displaystyle\Delta_{t+1}\leq(1+L\gamma_{t})\Delta_{t}+\frac{2CL\gamma_{t}}{\delta}\Big(\lambda^{t}C_{w_{0}}+G\sum_{s=0}^{t-1}\lambda^{t-s}\gamma_{s}\Big)." display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi mathvariant="normal">Δ</mi><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow></msub><mo>≤</mo><mrow><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><mrow><mi>L</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>γ</mi><mi>t</mi></msub></mrow></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi mathvariant="normal">Δ</mi><mi>t</mi></msub></mrow><mo>+</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><mi>L</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>γ</mi><mi>t</mi></msub></mrow><mi>δ</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="1.600em" minsize="1.600em">(</mo><mrow><mrow><msup><mi>λ</mi><mi>t</mi></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>C</mi><msub><mi>w</mi><mn>0</mn></msub></msub></mrow><mo>+</mo><mrow><mi>G</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>s</mi><mo>=</mo><mn>0</mn></mrow><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow></munderover></mstyle><mrow><msup><mi>λ</mi><mrow><mi>t</mi><mo>−</mo><mi>s</mi></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>γ</mi><mi>s</mi></msub></mrow></mrow></mrow></mrow><mo maxsize="1.600em" minsize="1.600em">)</mo></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\Delta_{t+1}\leq(1+L\gamma_{t})\Delta_{t}+\frac{2CL\gamma_{t}}{\delta}\Big(\lambda^{t}C_{w_{0}}+G\sum_{s=0}^{t-1}\lambda^{t-s}\gamma_{s}\Big).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(86)</span></td></tr></tbody>
</table>
</div>
</section>
<section id="A3.SS6.SSS0.Px2" class="ltx_paragraph">
<h4 class="ltx_title ltx_title_paragraph">Case 2: Different Sample (with probability <math id="A3.SS6.SSS0.Px2.m1" class="ltx_Math" alttext="\frac{1}{n}" display="inline" intent=":literal"><semantics><mfrac><mn>1</mn><mi>n</mi></mfrac><annotation encoding="application/x-tex">\frac{1}{n}</annotation></semantics></math>).</h4>

<div id="A3.SS6.SSS0.Px2.p1" class="ltx_para">
<p id="A3.SS6.SSS0.Px2.p1.1" class="ltx_p">Without loss of generality, assume node <math id="A3.SS6.SSS0.Px2.p1.m1" class="ltx_Math" alttext="1" display="inline" intent=":literal"><semantics><mn>1</mn><annotation encoding="application/x-tex">1</annotation></semantics></math> uses the replaced sample in the primed run, i.e., <math id="A3.SS6.SSS0.Px2.p1.m2" class="ltx_Math" alttext="\bm{\xi}_{1}^{\prime(t)}" display="inline" intent=":literal"><semantics><msubsup><mi>𝝃</mi><mn>1</mn><mrow><mo rspace="0em">′</mo><mphantom></mphantom><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow></msubsup><annotation encoding="application/x-tex">\bm{\xi}_{1}^{\prime(t)}</annotation></semantics></math>.
Then</p>
<table id="A3.EGx42" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A3.Ex103"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.Ex103.m1" class="ltx_Math" alttext="\displaystyle\Delta_{t+1}" display="inline" intent=":literal"><semantics><msub><mi mathvariant="normal">Δ</mi><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow></msub><annotation encoding="application/x-tex">\displaystyle\Delta_{t+1}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex103.m2" class="ltx_Math" alttext="\displaystyle\leq\Big\|\overline{\bm{w}}^{(t)}-\overline{\bm{w}}^{\prime(t)}-\frac{\gamma_{t}}{m}\sum_{i=2}^{m}\Big(\nabla f(\bm{z}_{i}^{(t)};\bm{\xi}_{i}^{(t)})-\nabla f(\bm{z}_{i}^{\prime(t)};\bm{\xi}_{i}^{(t)})\Big)\Big\|" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≤</mo><mrow><mo maxsize="1.600em" minsize="1.600em" stretchy="true">‖</mo><mrow><msup><mover accent="true"><mi>𝒘</mi><mo stretchy="true">¯</mo></mover><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo>−</mo><msup><mover accent="true"><mi>𝒘</mi><mo stretchy="true">¯</mo></mover><mrow><mo rspace="0em">′</mo><mphantom></mphantom><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow></msup><mo>−</mo><mrow><mstyle displaystyle="true"><mfrac><msub><mi>γ</mi><mi>t</mi></msub><mi>m</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>2</mn></mrow><mi>m</mi></munderover></mstyle><mrow><mo maxsize="1.600em" minsize="1.600em">(</mo><mrow><mrow><mrow><mo rspace="0.167em">∇</mo><mi>f</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>𝒛</mi><mi>i</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msubsup><mo>,</mo><msubsup><mi>𝝃</mi><mi>i</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msubsup><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mrow><mo rspace="0.167em">∇</mo><mi>f</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>𝒛</mi><mi>i</mi><mrow><mo rspace="0em">′</mo><mphantom></mphantom><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow></msubsup><mo>,</mo><msubsup><mi>𝝃</mi><mi>i</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msubsup><mo stretchy="false">)</mo></mrow></mrow></mrow><mo maxsize="1.600em" minsize="1.600em">)</mo></mrow></mrow></mrow></mrow><mo maxsize="1.600em" minsize="1.600em" stretchy="true">‖</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\leq\Big\|\overline{\bm{w}}^{(t)}-\overline{\bm{w}}^{\prime(t)}-\frac{\gamma_{t}}{m}\sum_{i=2}^{m}\Big(\nabla f(\bm{z}_{i}^{(t)};\bm{\xi}_{i}^{(t)})-\nabla f(\bm{z}_{i}^{\prime(t)};\bm{\xi}_{i}^{(t)})\Big)\Big\|</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A3.Ex104"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex104.m1" class="ltx_Math" alttext="\displaystyle\quad+\frac{\gamma_{t}}{m}\Big\|\nabla f(\bm{z}_{1}^{(t)};\bm{\xi}_{1}^{(t)})-\nabla f(\bm{z}_{1}^{\prime(t)};\bm{\xi}_{1}^{\prime(t)})\Big\|" display="inline" intent=":literal"><semantics><mrow><mo>+</mo><mrow><mstyle displaystyle="true"><mfrac><msub><mi>γ</mi><mi>t</mi></msub><mi>m</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="1.600em" minsize="1.600em" stretchy="true">‖</mo><mrow><mrow><mrow><mo rspace="0.167em">∇</mo><mi>f</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>𝒛</mi><mn>1</mn><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msubsup><mo>,</mo><msubsup><mi>𝝃</mi><mn>1</mn><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msubsup><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mrow><mo rspace="0.167em">∇</mo><mi>f</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>𝒛</mi><mn>1</mn><mrow><mo rspace="0em">′</mo><mphantom></mphantom><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow></msubsup><mo>,</mo><msubsup><mi>𝝃</mi><mn>1</mn><mrow><mo rspace="0em">′</mo><mphantom></mphantom><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow></msubsup><mo stretchy="false">)</mo></mrow></mrow></mrow><mo maxsize="1.600em" minsize="1.600em" stretchy="true">‖</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\quad+\frac{\gamma_{t}}{m}\Big\|\nabla f(\bm{z}_{1}^{(t)};\bm{\xi}_{1}^{(t)})-\nabla f(\bm{z}_{1}^{\prime(t)};\bm{\xi}_{1}^{\prime(t)})\Big\|</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A3.E87"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.E87.m1" class="ltx_Math" alttext="\displaystyle\leq\left(1+L\gamma_{t}-\frac{L\gamma_{t}}{mn}\right)\Delta_{t}+\frac{2CL\gamma_{t}}{\delta}\Big(\lambda^{t}C_{w_{0}}+G\sum_{s=0}^{t-1}\lambda^{t-s}\gamma_{s}\Big)+\frac{2G\gamma_{t}}{m}." display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>≤</mo><mrow><mrow><mrow><mo>(</mo><mrow><mrow><mn>1</mn><mo>+</mo><mrow><mi>L</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>γ</mi><mi>t</mi></msub></mrow></mrow><mo>−</mo><mstyle displaystyle="true"><mfrac><mrow><mi>L</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>γ</mi><mi>t</mi></msub></mrow><mrow><mi>m</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow></mfrac></mstyle></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi mathvariant="normal">Δ</mi><mi>t</mi></msub></mrow><mo>+</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><mi>L</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>γ</mi><mi>t</mi></msub></mrow><mi>δ</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="1.600em" minsize="1.600em">(</mo><mrow><mrow><msup><mi>λ</mi><mi>t</mi></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>C</mi><msub><mi>w</mi><mn>0</mn></msub></msub></mrow><mo>+</mo><mrow><mi>G</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>s</mi><mo>=</mo><mn>0</mn></mrow><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow></munderover></mstyle><mrow><msup><mi>λ</mi><mrow><mi>t</mi><mo>−</mo><mi>s</mi></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>γ</mi><mi>s</mi></msub></mrow></mrow></mrow></mrow><mo maxsize="1.600em" minsize="1.600em">)</mo></mrow></mrow><mo>+</mo><mstyle displaystyle="true"><mfrac><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>G</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>γ</mi><mi>t</mi></msub></mrow><mi>m</mi></mfrac></mstyle></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\leq\left(1+L\gamma_{t}-\frac{L\gamma_{t}}{mn}\right)\Delta_{t}+\frac{2CL\gamma_{t}}{\delta}\Big(\lambda^{t}C_{w_{0}}+G\sum_{s=0}^{t-1}\lambda^{t-s}\gamma_{s}\Big)+\frac{2G\gamma_{t}}{m}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(87)</span></td></tr></tbody>
</table>
<p id="A3.SS6.SSS0.Px2.p1.2" class="ltx_p">The last term uses <math id="A3.SS6.SSS0.Px2.p1.m3" class="ltx_Math" alttext="\|\nabla f\|\leq G" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">‖</mo><mrow><mo rspace="0.167em">∇</mo><mi>f</mi></mrow><mo stretchy="false">‖</mo></mrow><mo>≤</mo><mi>G</mi></mrow><annotation encoding="application/x-tex">\|\nabla f\|\leq G</annotation></semantics></math>.</p>
</div>
</section>
<section id="A3.SS6.SSS0.Px3" class="ltx_paragraph">
<h4 class="ltx_title ltx_title_paragraph">Expectation recursion.</h4>

<div id="A3.SS6.SSS0.Px3.p1" class="ltx_para">
<p id="A3.SS6.SSS0.Px3.p1.1" class="ltx_p">Taking expectation and using <math id="A3.SS6.SSS0.Px3.p1.m1" class="ltx_Math" alttext="\mathbb{P}(\text{Case 1})=1-\frac{1}{n}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>ℙ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mtext>Case 1</mtext><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mn>1</mn><mo>−</mo><mfrac><mn>1</mn><mi>n</mi></mfrac></mrow></mrow><annotation encoding="application/x-tex">\mathbb{P}(\text{Case 1})=1-\frac{1}{n}</annotation></semantics></math> and <math id="A3.SS6.SSS0.Px3.p1.m2" class="ltx_Math" alttext="\mathbb{P}(\text{Case 2})=\frac{1}{n}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>ℙ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mtext>Case 2</mtext><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mfrac><mn>1</mn><mi>n</mi></mfrac></mrow><annotation encoding="application/x-tex">\mathbb{P}(\text{Case 2})=\frac{1}{n}</annotation></semantics></math>, from
(<a href="#A3.E86" title="In Case 1: Identical Samples (with probability 1-{1/𝑛}). ‣ C.6 Proof of Theorem ‣ Appendix C Proof of Theorem and Corollary ‣ Stability and Generalization of Push-Sum Based Decentralized Optimization over Directed Graphs" class="ltx_ref"><span class="ltx_text ltx_ref_tag">86</span></a>)–(<a href="#A3.E87" title="In Case 2: Different Sample (with probability 1/𝑛). ‣ C.6 Proof of Theorem ‣ Appendix C Proof of Theorem and Corollary ‣ Stability and Generalization of Push-Sum Based Decentralized Optimization over Directed Graphs" class="ltx_ref"><span class="ltx_text ltx_ref_tag">87</span></a>) we obtain</p>
<table id="A3.EGx43" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A3.E88"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.E88.m1" class="ltx_Math" alttext="\displaystyle\mathbb{E}[\Delta_{t+1}]" display="inline" intent=":literal"><semantics><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><msub><mi mathvariant="normal">Δ</mi><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow></msub><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\mathbb{E}[\Delta_{t+1}]</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.E88.m2" class="ltx_Math" alttext="\displaystyle\leq\left(1+L\gamma_{t}-\frac{L\gamma_{t}}{mn}\right)\mathbb{E}[\Delta_{t}]+\frac{2CL\gamma_{t}}{\delta}\Big(\lambda^{t}C_{w_{0}}+G\sum_{s=0}^{t-1}\lambda^{t-s}\gamma_{s}\Big)+\frac{2G\gamma_{t}}{mn}." display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>≤</mo><mrow><mrow><mrow><mo>(</mo><mrow><mrow><mn>1</mn><mo>+</mo><mrow><mi>L</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>γ</mi><mi>t</mi></msub></mrow></mrow><mo>−</mo><mstyle displaystyle="true"><mfrac><mrow><mi>L</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>γ</mi><mi>t</mi></msub></mrow><mrow><mi>m</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow></mfrac></mstyle></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>𝔼</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><msub><mi mathvariant="normal">Δ</mi><mi>t</mi></msub><mo stretchy="false">]</mo></mrow></mrow><mo>+</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><mi>L</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>γ</mi><mi>t</mi></msub></mrow><mi>δ</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="1.600em" minsize="1.600em">(</mo><mrow><mrow><msup><mi>λ</mi><mi>t</mi></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>C</mi><msub><mi>w</mi><mn>0</mn></msub></msub></mrow><mo>+</mo><mrow><mi>G</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>s</mi><mo>=</mo><mn>0</mn></mrow><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow></munderover></mstyle><mrow><msup><mi>λ</mi><mrow><mi>t</mi><mo>−</mo><mi>s</mi></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>γ</mi><mi>s</mi></msub></mrow></mrow></mrow></mrow><mo maxsize="1.600em" minsize="1.600em">)</mo></mrow></mrow><mo>+</mo><mstyle displaystyle="true"><mfrac><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>G</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>γ</mi><mi>t</mi></msub></mrow><mrow><mi>m</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow></mfrac></mstyle></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\leq\left(1+L\gamma_{t}-\frac{L\gamma_{t}}{mn}\right)\mathbb{E}[\Delta_{t}]+\frac{2CL\gamma_{t}}{\delta}\Big(\lambda^{t}C_{w_{0}}+G\sum_{s=0}^{t-1}\lambda^{t-s}\gamma_{s}\Big)+\frac{2G\gamma_{t}}{mn}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(88)</span></td></tr></tbody>
</table>
</div>
<div id="A3.SS6.SSS0.Px3.p2" class="ltx_para">
<p id="A3.SS6.SSS0.Px3.p2.1" class="ltx_p">Assume <math id="A3.SS6.SSS0.Px3.p2.m1" class="ltx_Math" alttext="t_{0}\in\{1,2,\dots,n\}" display="inline" intent=":literal"><semantics><mrow><msub><mi>t</mi><mn>0</mn></msub><mo>∈</mo><mrow><mo stretchy="false">{</mo><mrow><mn>1</mn><mo>,</mo><mn>2</mn><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mi>n</mi></mrow><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">t_{0}\in\{1,2,\dots,n\}</annotation></semantics></math> to be determined, and condition on <math id="A3.SS6.SSS0.Px3.p2.m2" class="ltx_Math" alttext="\Delta_{t_{0}}=0" display="inline" intent=":literal"><semantics><mrow><msub><mi mathvariant="normal">Δ</mi><msub><mi>t</mi><mn>0</mn></msub></msub><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\Delta_{t_{0}}=0</annotation></semantics></math>.
Unrolling (<a href="#A3.E88" title="In Expectation recursion. ‣ C.6 Proof of Theorem ‣ Appendix C Proof of Theorem and Corollary ‣ Stability and Generalization of Push-Sum Based Decentralized Optimization over Directed Graphs" class="ltx_ref"><span class="ltx_text ltx_ref_tag">88</span></a>) yields</p>
<table id="A3.EGx44" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A3.Ex105"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.Ex105.m1" class="ltx_Math" alttext="\displaystyle\mathbb{E}[\Delta_{T}\mid\Delta_{t_{0}}=0]" display="inline" intent=":literal"><semantics><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><msub><mi mathvariant="normal">Δ</mi><mi>T</mi></msub><mo lspace="0em" rspace="0.167em">∣</mo><mrow><msub><mi mathvariant="normal">Δ</mi><msub><mi>t</mi><mn>0</mn></msub></msub><mo>=</mo><mn>0</mn></mrow></mrow><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\mathbb{E}[\Delta_{T}\mid\Delta_{t_{0}}=0]</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex105.m2" class="ltx_Math" alttext="\displaystyle\leq\sum_{t=t_{0}}^{T-1}\prod_{k=t+1}^{T-1}\left(1+L\gamma_{k}-\frac{L\gamma_{k}}{mn}\right)" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≤</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>t</mi><mo>=</mo><msub><mi>t</mi><mn>0</mn></msub></mrow><mrow><mi>T</mi><mo>−</mo><mn>1</mn></mrow></munderover></mstyle><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∏</mo><mrow><mi>k</mi><mo>=</mo><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow></mrow><mrow><mi>T</mi><mo>−</mo><mn>1</mn></mrow></munderover></mstyle><mrow><mo>(</mo><mrow><mrow><mn>1</mn><mo>+</mo><mrow><mi>L</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>γ</mi><mi>k</mi></msub></mrow></mrow><mo>−</mo><mstyle displaystyle="true"><mfrac><mrow><mi>L</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>γ</mi><mi>k</mi></msub></mrow><mrow><mi>m</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow></mfrac></mstyle></mrow><mo>)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\leq\sum_{t=t_{0}}^{T-1}\prod_{k=t+1}^{T-1}\left(1+L\gamma_{k}-\frac{L\gamma_{k}}{mn}\right)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A3.E89"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.E89.m1" class="ltx_Math" alttext="\displaystyle\qquad\qquad\times\left[\frac{2CL\gamma_{t}}{\delta}\Big(\lambda^{t}C_{w_{0}}+G\sum_{s=0}^{t-1}\lambda^{t-s}\gamma_{s}\Big)+\frac{2G\gamma_{t}}{mn}\right]." display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo lspace="4.222em" rspace="0.222em">×</mo><mrow><mo>[</mo><mrow><mrow><mstyle displaystyle="true"><mfrac><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><mi>L</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>γ</mi><mi>t</mi></msub></mrow><mi>δ</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="1.600em" minsize="1.600em">(</mo><mrow><mrow><msup><mi>λ</mi><mi>t</mi></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>C</mi><msub><mi>w</mi><mn>0</mn></msub></msub></mrow><mo>+</mo><mrow><mi>G</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>s</mi><mo>=</mo><mn>0</mn></mrow><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow></munderover></mstyle><mrow><msup><mi>λ</mi><mrow><mi>t</mi><mo>−</mo><mi>s</mi></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>γ</mi><mi>s</mi></msub></mrow></mrow></mrow></mrow><mo maxsize="1.600em" minsize="1.600em">)</mo></mrow></mrow><mo>+</mo><mstyle displaystyle="true"><mfrac><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>G</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>γ</mi><mi>t</mi></msub></mrow><mrow><mi>m</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow></mfrac></mstyle></mrow><mo>]</mo></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\qquad\qquad\times\left[\frac{2CL\gamma_{t}}{\delta}\Big(\lambda^{t}C_{w_{0}}+G\sum_{s=0}^{t-1}\lambda^{t-s}\gamma_{s}\Big)+\frac{2G\gamma_{t}}{mn}\right].</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(89)</span></td></tr></tbody>
</table>
</div>
<div id="A3.SS6.SSS0.Px3.p3" class="ltx_para">
<p id="A3.SS6.SSS0.Px3.p3.1" class="ltx_p">Finally, the uniform stability under non-convex loss functions satisfies</p>
</div>
<div id="A3.SS6.SSS0.Px3.p4" class="ltx_para">
<table id="A3.EGx45" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A3.Ex106"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.Ex106.m1" class="ltx_Math" alttext="\displaystyle\epsilon_{\mathrm{stab}}" display="inline" intent=":literal"><semantics><msub><mi>ϵ</mi><mi>stab</mi></msub><annotation encoding="application/x-tex">\displaystyle\epsilon_{\mathrm{stab}}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex106.m2" class="ltx_Math" alttext="\displaystyle\leq\frac{t_{0}}{mn}+G\sum_{t=t_{0}}^{T-1}\prod_{k=t+1}^{T-1}\left(1+L\gamma_{k}-\frac{L\gamma_{k}}{mn}\right)\left[\frac{2CL\gamma_{t}}{\delta}\Big(\lambda^{t}C_{w_{0}}+G\sum_{s=0}^{t-1}\lambda^{t-s}\gamma_{s}\Big)+\frac{2G\gamma_{t}}{mn}\right]" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≤</mo><mrow><mstyle displaystyle="true"><mfrac><msub><mi>t</mi><mn>0</mn></msub><mrow><mi>m</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow></mfrac></mstyle><mo>+</mo><mrow><mi>G</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>t</mi><mo>=</mo><msub><mi>t</mi><mn>0</mn></msub></mrow><mrow><mi>T</mi><mo>−</mo><mn>1</mn></mrow></munderover></mstyle><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∏</mo><mrow><mi>k</mi><mo>=</mo><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow></mrow><mrow><mi>T</mi><mo>−</mo><mn>1</mn></mrow></munderover></mstyle><mrow><mrow><mo>(</mo><mrow><mrow><mn>1</mn><mo>+</mo><mrow><mi>L</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>γ</mi><mi>k</mi></msub></mrow></mrow><mo>−</mo><mstyle displaystyle="true"><mfrac><mrow><mi>L</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>γ</mi><mi>k</mi></msub></mrow><mrow><mi>m</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow></mfrac></mstyle></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><mrow><mrow><mstyle displaystyle="true"><mfrac><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><mi>L</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>γ</mi><mi>t</mi></msub></mrow><mi>δ</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="1.600em" minsize="1.600em">(</mo><mrow><mrow><msup><mi>λ</mi><mi>t</mi></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>C</mi><msub><mi>w</mi><mn>0</mn></msub></msub></mrow><mo>+</mo><mrow><mi>G</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>s</mi><mo>=</mo><mn>0</mn></mrow><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow></munderover></mstyle><mrow><msup><mi>λ</mi><mrow><mi>t</mi><mo>−</mo><mi>s</mi></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>γ</mi><mi>s</mi></msub></mrow></mrow></mrow></mrow><mo maxsize="1.600em" minsize="1.600em">)</mo></mrow></mrow><mo>+</mo><mstyle displaystyle="true"><mfrac><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>G</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>γ</mi><mi>t</mi></msub></mrow><mrow><mi>m</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow></mfrac></mstyle></mrow><mo>]</mo></mrow></mrow></mrow></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\leq\frac{t_{0}}{mn}+G\sum_{t=t_{0}}^{T-1}\prod_{k=t+1}^{T-1}\left(1+L\gamma_{k}-\frac{L\gamma_{k}}{mn}\right)\left[\frac{2CL\gamma_{t}}{\delta}\Big(\lambda^{t}C_{w_{0}}+G\sum_{s=0}^{t-1}\lambda^{t-s}\gamma_{s}\Big)+\frac{2G\gamma_{t}}{mn}\right]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A3.E90"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.E90.m1" class="ltx_Math" alttext="\displaystyle\overset{(a)}{\leq}\frac{t_{0}}{mn}+G\sum_{t=t_{0}}^{T-1}\prod_{k=t+1}^{T-1}\left(1+L\gamma_{k}-\frac{L\gamma_{k}}{mn}\right)\left[\frac{2CL\gamma_{t}}{\delta}\Big(\lambda^{t}C_{w_{0}}+\frac{G\gamma_{t}}{1-\lambda}\Big)+\frac{2G\gamma_{t}}{mn}\right]" display="inline" intent=":literal"><semantics><mrow><mrow><mover accent="true"><mo>≤</mo><mrow><mo maxsize="0.700em" minsize="0.700em">(</mo><mi mathsize="0.700em">a</mi><mo maxsize="0.700em" minsize="0.700em">)</mo></mrow></mover><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><msub><mi>t</mi><mn>0</mn></msub><mrow><mi>m</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow></mfrac></mstyle></mrow><mo>+</mo><mrow><mi>G</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>t</mi><mo>=</mo><msub><mi>t</mi><mn>0</mn></msub></mrow><mrow><mi>T</mi><mo>−</mo><mn>1</mn></mrow></munderover></mstyle><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∏</mo><mrow><mi>k</mi><mo>=</mo><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow></mrow><mrow><mi>T</mi><mo>−</mo><mn>1</mn></mrow></munderover></mstyle><mrow><mrow><mo>(</mo><mrow><mrow><mn>1</mn><mo>+</mo><mrow><mi>L</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>γ</mi><mi>k</mi></msub></mrow></mrow><mo>−</mo><mstyle displaystyle="true"><mfrac><mrow><mi>L</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>γ</mi><mi>k</mi></msub></mrow><mrow><mi>m</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow></mfrac></mstyle></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><mrow><mrow><mstyle displaystyle="true"><mfrac><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><mi>L</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>γ</mi><mi>t</mi></msub></mrow><mi>δ</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="1.600em" minsize="1.600em">(</mo><mrow><mrow><msup><mi>λ</mi><mi>t</mi></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>C</mi><msub><mi>w</mi><mn>0</mn></msub></msub></mrow><mo>+</mo><mstyle displaystyle="true"><mfrac><mrow><mi>G</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>γ</mi><mi>t</mi></msub></mrow><mrow><mn>1</mn><mo>−</mo><mi>λ</mi></mrow></mfrac></mstyle></mrow><mo maxsize="1.600em" minsize="1.600em">)</mo></mrow></mrow><mo>+</mo><mstyle displaystyle="true"><mfrac><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>G</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>γ</mi><mi>t</mi></msub></mrow><mrow><mi>m</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow></mfrac></mstyle></mrow><mo>]</mo></mrow></mrow></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\overset{(a)}{\leq}\frac{t_{0}}{mn}+G\sum_{t=t_{0}}^{T-1}\prod_{k=t+1}^{T-1}\left(1+L\gamma_{k}-\frac{L\gamma_{k}}{mn}\right)\left[\frac{2CL\gamma_{t}}{\delta}\Big(\lambda^{t}C_{w_{0}}+\frac{G\gamma_{t}}{1-\lambda}\Big)+\frac{2G\gamma_{t}}{mn}\right]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(90)</span></td></tr></tbody>
</table>
</div>
<div id="A3.SS6.SSS0.Px3.p5" class="ltx_para">
<p id="A3.SS6.SSS0.Px3.p5.1" class="ltx_p">This completes the proof of Theorem <a href="#Thmtheorem31" title="Theorem 31. ‣ 4.3 Results on Non-convex Case ‣ 4 Theoretical Analysis ‣ Stability and Generalization of Push-Sum Based Decentralized Optimization over Directed Graphs" class="ltx_ref"><span class="ltx_text ltx_ref_tag">31</span></a>.
∎</p>
</div>
</section>
</section>
<section id="A3.SS7" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">C.7 </span>Proof of Corollary <a href="#Thmtheorem33" title="Corollary 33 (Uniform Stability on Common Learning Rate). ‣ 4.3 Results on Non-convex Case ‣ 4 Theoretical Analysis ‣ Stability and Generalization of Push-Sum Based Decentralized Optimization over Directed Graphs" class="ltx_ref"><span class="ltx_text ltx_ref_tag">33</span></a></h3>

<div id="A3.SS7.2" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
</div>
<section id="A3.SS7.SSS0.Px1" class="ltx_paragraph">
<h4 class="ltx_title ltx_title_paragraph">Case 1: Constant Learning Rate.</h4>

<div id="A3.SS7.SSS0.Px1.p1" class="ltx_para">
<p id="A3.SS7.SSS0.Px1.p1.1" class="ltx_p">For constant learning rates <math id="A3.SS7.SSS0.Px1.p1.m1" class="ltx_Math" alttext="\gamma_{t}=\gamma" display="inline" intent=":literal"><semantics><mrow><msub><mi>γ</mi><mi>t</mi></msub><mo>=</mo><mi>γ</mi></mrow><annotation encoding="application/x-tex">\gamma_{t}=\gamma</annotation></semantics></math>, from Eq. <a href="#A3.E90" title="In Expectation recursion. ‣ C.6 Proof of Theorem ‣ Appendix C Proof of Theorem and Corollary ‣ Stability and Generalization of Push-Sum Based Decentralized Optimization over Directed Graphs" class="ltx_ref"><span class="ltx_text ltx_ref_tag">90</span></a>, we obtain
<span id="A3.SS7.SSS0.Px1.p1.1.1" class="ltx_text"></span></p>
<table id="A3.EGx46" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A3.Ex107"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.Ex107.m1" class="ltx_Math" alttext="\displaystyle\mathbb{E}[\Delta_{T}\mid\Delta_{t_{0}}=0]" display="inline" intent=":literal"><semantics><mrow><mi mathsize="0.900em">𝔼</mi><mo>⁡</mo><mrow><mo maxsize="0.900em" minsize="0.900em">[</mo><mrow><msub><mi mathsize="0.900em" mathvariant="normal">Δ</mi><mi mathsize="0.900em">T</mi></msub><mo lspace="0em" mathsize="0.900em" rspace="0.167em">∣</mo><mrow><msub><mi mathsize="0.900em" mathvariant="normal">Δ</mi><msub><mi mathsize="0.900em">t</mi><mn mathsize="0.900em">0</mn></msub></msub><mo mathsize="0.900em">=</mo><mn mathsize="0.900em">0</mn></mrow></mrow><mo maxsize="0.900em" minsize="0.900em">]</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\mathbb{E}[\Delta_{T}\mid\Delta_{t_{0}}=0]</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex107.m2" class="ltx_Math" alttext="\displaystyle\leq\sum_{t=t_{0}}^{T-1}\prod_{k=t+1}^{T-1}\left(1+L\gamma-\frac{L\gamma}{mn}\right)\times\left(\frac{2CL\gamma}{\delta}\Big(\lambda^{t}C_{w_{0}}+G\sum_{s=0}^{t-1}\lambda^{t-s}\gamma\Big)+\frac{2G\gamma}{mn}\right)" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo mathsize="0.900em">≤</mo><mrow><mrow><mstyle displaystyle="true"><munderover><mo maxsize="0.900em" minsize="0.900em" movablelimits="false" stretchy="true">∑</mo><mrow><mi mathsize="0.900em">t</mi><mo mathsize="0.900em">=</mo><msub><mi mathsize="0.900em">t</mi><mn mathsize="0.900em">0</mn></msub></mrow><mrow><mi mathsize="0.900em">T</mi><mo mathsize="0.900em">−</mo><mn mathsize="0.900em">1</mn></mrow></munderover></mstyle><mrow><mstyle displaystyle="true"><munderover><mo maxsize="0.900em" minsize="0.900em" movablelimits="false" stretchy="true">∏</mo><mrow><mi mathsize="0.900em">k</mi><mo mathsize="0.900em">=</mo><mrow><mi mathsize="0.900em">t</mi><mo mathsize="0.900em">+</mo><mn mathsize="0.900em">1</mn></mrow></mrow><mrow><mi mathsize="0.900em">T</mi><mo mathsize="0.900em">−</mo><mn mathsize="0.900em">1</mn></mrow></munderover></mstyle><mrow><mo>(</mo><mrow><mrow><mn mathsize="0.900em">1</mn><mo mathsize="0.900em">+</mo><mrow><mi mathsize="0.900em">L</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">γ</mi></mrow></mrow><mo mathsize="0.900em">−</mo><mstyle displaystyle="true"><mfrac><mrow><mi mathsize="0.900em">L</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">γ</mi></mrow><mrow><mi mathsize="0.900em">m</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">n</mi></mrow></mfrac></mstyle></mrow><mo rspace="0.055em">)</mo></mrow></mrow></mrow><mo mathsize="0.900em" rspace="0.222em">×</mo><mrow><mo>(</mo><mrow><mrow><mstyle displaystyle="true"><mfrac><mrow><mn mathsize="0.900em">2</mn><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">C</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">L</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">γ</mi></mrow><mi mathsize="0.900em">δ</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="1.600em" minsize="1.600em">(</mo><mrow><mrow><msup><mi mathsize="0.900em">λ</mi><mi mathsize="0.900em">t</mi></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi mathsize="0.900em">C</mi><msub><mi mathsize="0.900em">w</mi><mn mathsize="0.900em">0</mn></msub></msub></mrow><mo mathsize="0.900em">+</mo><mrow><mi mathsize="0.900em">G</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo maxsize="0.900em" minsize="0.900em" movablelimits="false" stretchy="true">∑</mo><mrow><mi mathsize="0.900em">s</mi><mo mathsize="0.900em">=</mo><mn mathsize="0.900em">0</mn></mrow><mrow><mi mathsize="0.900em">t</mi><mo mathsize="0.900em">−</mo><mn mathsize="0.900em">1</mn></mrow></munderover></mstyle><mrow><msup><mi mathsize="0.900em">λ</mi><mrow><mi mathsize="0.900em">t</mi><mo mathsize="0.900em">−</mo><mi mathsize="0.900em">s</mi></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">γ</mi></mrow></mrow></mrow></mrow><mo maxsize="1.600em" minsize="1.600em">)</mo></mrow></mrow><mo mathsize="0.900em">+</mo><mstyle displaystyle="true"><mfrac><mrow><mn mathsize="0.900em">2</mn><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">G</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">γ</mi></mrow><mrow><mi mathsize="0.900em">m</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">n</mi></mrow></mfrac></mstyle></mrow><mo>)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\leq\sum_{t=t_{0}}^{T-1}\prod_{k=t+1}^{T-1}\left(1+L\gamma-\frac{L\gamma}{mn}\right)\times\left(\frac{2CL\gamma}{\delta}\Big(\lambda^{t}C_{w_{0}}+G\sum_{s=0}^{t-1}\lambda^{t-s}\gamma\Big)+\frac{2G\gamma}{mn}\right)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A3.Ex108"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex108.m1" class="ltx_Math" alttext="\displaystyle\leq\frac{2CL\gamma C_{w_{0}}}{\delta}\sum_{t=t_{0}}^{T-1}\left(1+L\gamma-\frac{L\gamma}{mn}\right)^{T-1-t}{\lambda}^{t}+\left(\frac{2CGL\gamma^{2}}{\delta(1-{\lambda})}+\frac{2G\gamma}{mn}\right)\sum_{t=t_{0}}^{T-1}\left(1+L\gamma-\frac{L\gamma}{mn}\right)^{T-1-t}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo mathsize="0.900em">≤</mo><mrow><mrow><mstyle displaystyle="true"><mfrac><mrow><mn mathsize="0.900em">2</mn><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">C</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">L</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">γ</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi mathsize="0.900em">C</mi><msub><mi mathsize="0.900em">w</mi><mn mathsize="0.900em">0</mn></msub></msub></mrow><mi mathsize="0.900em">δ</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo maxsize="0.900em" minsize="0.900em" movablelimits="false" stretchy="true">∑</mo><mrow><mi mathsize="0.900em">t</mi><mo mathsize="0.900em">=</mo><msub><mi mathsize="0.900em">t</mi><mn mathsize="0.900em">0</mn></msub></mrow><mrow><mi mathsize="0.900em">T</mi><mo mathsize="0.900em">−</mo><mn mathsize="0.900em">1</mn></mrow></munderover></mstyle><mrow><msup><mrow><mo>(</mo><mrow><mrow><mn mathsize="0.900em">1</mn><mo mathsize="0.900em">+</mo><mrow><mi mathsize="0.900em">L</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">γ</mi></mrow></mrow><mo mathsize="0.900em">−</mo><mstyle displaystyle="true"><mfrac><mrow><mi mathsize="0.900em">L</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">γ</mi></mrow><mrow><mi mathsize="0.900em">m</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">n</mi></mrow></mfrac></mstyle></mrow><mo>)</mo></mrow><mrow><mi mathsize="0.900em">T</mi><mo mathsize="0.900em">−</mo><mn mathsize="0.900em">1</mn><mo mathsize="0.900em">−</mo><mi mathsize="0.900em">t</mi></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi mathsize="0.900em">λ</mi><mi mathsize="0.900em">t</mi></msup></mrow></mrow></mrow><mo mathsize="0.900em">+</mo><mrow><mrow><mo>(</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mn mathsize="0.900em">2</mn><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">C</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">G</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">L</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi mathsize="0.900em">γ</mi><mn mathsize="0.900em">2</mn></msup></mrow><mrow><mi mathsize="0.900em">δ</mi><mo>⁡</mo><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><mrow><mn mathsize="0.900em">1</mn><mo mathsize="0.900em">−</mo><mi mathsize="0.900em">λ</mi></mrow><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow></mrow></mfrac></mstyle><mo mathsize="0.900em">+</mo><mstyle displaystyle="true"><mfrac><mrow><mn mathsize="0.900em">2</mn><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">G</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">γ</mi></mrow><mrow><mi mathsize="0.900em">m</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">n</mi></mrow></mfrac></mstyle></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo maxsize="0.900em" minsize="0.900em" movablelimits="false" stretchy="true">∑</mo><mrow><mi mathsize="0.900em">t</mi><mo mathsize="0.900em">=</mo><msub><mi mathsize="0.900em">t</mi><mn mathsize="0.900em">0</mn></msub></mrow><mrow><mi mathsize="0.900em">T</mi><mo mathsize="0.900em">−</mo><mn mathsize="0.900em">1</mn></mrow></munderover></mstyle><msup><mrow><mo>(</mo><mrow><mrow><mn mathsize="0.900em">1</mn><mo mathsize="0.900em">+</mo><mrow><mi mathsize="0.900em">L</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">γ</mi></mrow></mrow><mo mathsize="0.900em">−</mo><mstyle displaystyle="true"><mfrac><mrow><mi mathsize="0.900em">L</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">γ</mi></mrow><mrow><mi mathsize="0.900em">m</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">n</mi></mrow></mfrac></mstyle></mrow><mo>)</mo></mrow><mrow><mi mathsize="0.900em">T</mi><mo mathsize="0.900em">−</mo><mn mathsize="0.900em">1</mn><mo mathsize="0.900em">−</mo><mi mathsize="0.900em">t</mi></mrow></msup></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\leq\frac{2CL\gamma C_{w_{0}}}{\delta}\sum_{t=t_{0}}^{T-1}\left(1+L\gamma-\frac{L\gamma}{mn}\right)^{T-1-t}{\lambda}^{t}+\left(\frac{2CGL\gamma^{2}}{\delta(1-{\lambda})}+\frac{2G\gamma}{mn}\right)\sum_{t=t_{0}}^{T-1}\left(1+L\gamma-\frac{L\gamma}{mn}\right)^{T-1-t}</annotation></semantics></math></td>
