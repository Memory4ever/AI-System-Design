<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex116.m1" class="ltx_Math" alttext="\displaystyle\leq T^{Lv(1-\frac{1}{mn})}\sum_{t=t_{0}}^{T-1}\Bigg(\frac{2CLv\lambda^{t}C_{w_{0}}}{\delta(t+1)^{Lv(1-\frac{1}{mn})+1}}+\frac{2CGLv^{2}}{\delta(1-{\lambda})(t+1)^{Lv(1-\frac{1}{mn})+2}}+\frac{2Gv}{mn(t+1)^{Lv(1-\frac{1}{mn})+1}}\Bigg)" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo mathsize="0.900em">≤</mo><mrow><msup><mi mathsize="0.900em">T</mi><mrow><mi mathsize="0.900em">L</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">v</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><mrow><mn mathsize="0.900em">1</mn><mo mathsize="0.900em">−</mo><mfrac><mn mathsize="0.900em">1</mn><mrow><mi mathsize="0.900em">m</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">n</mi></mrow></mfrac></mrow><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo maxsize="0.900em" minsize="0.900em" movablelimits="false" stretchy="true">∑</mo><mrow><mi mathsize="0.900em">t</mi><mo mathsize="0.900em">=</mo><msub><mi mathsize="0.900em">t</mi><mn mathsize="0.900em">0</mn></msub></mrow><mrow><mi mathsize="0.900em">T</mi><mo mathsize="0.900em">−</mo><mn mathsize="0.900em">1</mn></mrow></munderover></mstyle><mrow><mo maxsize="2.600em" minsize="2.600em">(</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mn mathsize="0.900em">2</mn><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">C</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">L</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">v</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi mathsize="0.900em">λ</mi><mi mathsize="0.900em">t</mi></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi mathsize="0.900em">C</mi><msub><mi mathsize="0.900em">w</mi><mn mathsize="0.900em">0</mn></msub></msub></mrow><mrow><mi mathsize="0.900em">δ</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><mrow><mi mathsize="0.900em">t</mi><mo mathsize="0.900em">+</mo><mn mathsize="0.900em">1</mn></mrow><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow><mrow><mrow><mi mathsize="0.900em">L</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">v</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><mrow><mn mathsize="0.900em">1</mn><mo mathsize="0.900em">−</mo><mfrac><mn mathsize="0.900em">1</mn><mrow><mi mathsize="0.900em">m</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">n</mi></mrow></mfrac></mrow><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow></mrow><mo mathsize="0.900em">+</mo><mn mathsize="0.900em">1</mn></mrow></msup></mrow></mfrac></mstyle><mo mathsize="0.900em">+</mo><mstyle displaystyle="true"><mfrac><mrow><mn mathsize="0.900em">2</mn><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">C</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">G</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">L</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi mathsize="0.900em">v</mi><mn mathsize="0.900em">2</mn></msup></mrow><mrow><mrow><mi mathsize="0.900em">δ</mi><mo>⁡</mo><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><mrow><mn mathsize="0.900em">1</mn><mo mathsize="0.900em">−</mo><mi mathsize="0.900em">λ</mi></mrow><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><mrow><mi mathsize="0.900em">t</mi><mo mathsize="0.900em">+</mo><mn mathsize="0.900em">1</mn></mrow><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow><mrow><mrow><mi mathsize="0.900em">L</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">v</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><mrow><mn mathsize="0.900em">1</mn><mo mathsize="0.9