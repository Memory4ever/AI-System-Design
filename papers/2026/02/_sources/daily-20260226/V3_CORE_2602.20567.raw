<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex109.m1" class="ltx_Math" alttext="\displaystyle\overset{(a)}{\leq}\frac{2CL\gamma C_{w_{0}}}{\delta}\left(1+L\gamma-\frac{L\gamma}{mn}\right)^{T-1}\frac{1+L\gamma-\frac{L\gamma}{mn}}{1+L\gamma-\frac{L\gamma}{mn}-{\lambda}}" display="inline" intent=":literal"><semantics><mrow><mover accent="true"><mo mathsize="0.900em">≤</mo><mrow><mo maxsize="0.630em" minsize="0.630em">(</mo><mi mathsize="0.630em">a</mi><mo maxsize="0.630em" minsize="0.630em">)</mo></mrow></mover><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><mrow><mn mathsize="0.900em">2</mn><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">C</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">L</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">γ</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi mathsize="0.900em">C</mi><msub><mi mathsize="0.900em">w</mi><mn mathsize="0.900em">0</mn></msub></msub></mrow><mi mathsize="0.900em">δ</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo>(</mo><mrow><mrow><mn mathsize="0.900em">1</mn><mo mathsize="0.900em">+</mo><mrow><mi mathsize="0.900em">L</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">γ</mi></mrow></mrow><mo mathsize="0.900em">−</mo><mstyle displaystyle="true"><mfrac><mrow><mi mathsize="0.900em">L</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">γ</mi></mrow><mrow><mi mathsize="0.900em">m</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">n</mi></mrow></mfrac></mstyle></mrow><mo>)</mo></mrow><mrow><mi mathsize="0.900em">T</mi><mo mathsize="0.900em">−</mo><mn mathsize="0.900em">1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><mrow><mrow><mn mathsize="0.900em">1</mn><mo mathsize="0.900em">+</mo><mrow><mi mathsize="0.900em">L</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">γ</mi></mrow></mrow><mo mathsize="0.900em">−</mo><mfrac><mrow><mi mathsize="0.900em">L</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">γ</mi></mrow><mrow><mi mathsize="0.900em">m</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">n</mi></mrow></mfrac></mrow><mrow><mrow><mn mathsize="0.900em">1</mn><mo mathsize="0.900em">+</mo><mrow><mi mathsize="0.900em">L</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">γ</mi></mrow></mrow><mo mathsize="0.900em">−</mo><mfrac><mrow><mi mathsize="0.900em">L</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">γ</mi></mrow><mrow><mi mathsize="0.900em">m</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">n</mi></mrow></mfrac><mo mathsize="0.900em">−</mo><mi mathsize="0.900em">λ</mi></mrow></mfrac></mstyle></mrow><annotation encoding="application/x-tex">\displaystyle\overset{(a)}{\leq}\frac{2CL\gamma C_{w_{0}}}{\delta}\left(1+L\gamma-\frac{L\gamma}{mn}\right)^{T-1}\frac{1+L\gamma-\frac{L\gamma}{mn}}{1+L\gamma-\frac{L\gamma}{mn}-{\lambda}}</annotation></semantics></math></td>
