<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex56.m1" class="ltx_math_unparsed" alttext="\displaystyle\quad+\sum_{i=1}^{m}\frac{4rL\gamma_{t}}{m}\mathbb{E}\big\|\overline{\bm{w}}^{(t)}-\bm{z}_{i}^{(t)}\big\|+\gamma_{t}^{2}G^{2}" display="inline" intent=":literal"><semantics><mrow><mo>+</mo><mstyle displaystyle="true"><mo movablelimits="false">∑</mo></mstyle><msub><mrow></mrow><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow></msub><msup><mrow></mrow><mi>m</mi></msup><mstyle displaystyle="true"><mfrac><mrow><mn>4</mn><mo lspace="0em" rspace="0em">​</mo><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>L</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>γ</mi><mi>t</mi></msub></mrow><mi>m</mi></mfrac></mstyle><mi>𝔼</mi><mo lspace="0em" mathsize="1.200em" rspace="0.167em">∥</mo><mover accent="true"><mi>𝒘</mi><mo stretchy="true">¯</mo></mover><msup><mrow></mrow><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo>−</mo><mi>𝒛</mi><msub><mrow></mrow><mi>i</mi></msub><msup><mrow></mrow><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo lspace="0em" mathsize="1.200em" rspace="0em">∥</mo><mo lspace="0em">+</mo><mi>γ</mi><msub><mrow></mrow><mi>t</mi></msub><msup><mrow></mrow><mn>2</mn></msup><mi>G</mi><msup><mrow></mrow><mn>2</mn></msup></mrow><annotation encoding="application/x-tex">\displaystyle\quad+\sum_{i=1}^{m}\frac{4rL\gamma_{t}}{m}\mathbb{E}\big\|\overline{\bm{w}}^{(t)}-\bm{z}_{i}^{(t)}\big\|+\gamma_{t}^{2}G^{2}</annotation></semantics></math></td>
