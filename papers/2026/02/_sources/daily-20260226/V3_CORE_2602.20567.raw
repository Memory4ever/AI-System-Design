<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex60.m1" class="ltx_Math" alttext="\displaystyle\quad+\frac{4rCL\gamma_{t}{\lambda}^{t}C_{w_{0}}}{\delta}+\frac{4rCLG\gamma_{t}}{\delta}\sum_{s=0}^{t-1}{\lambda}^{t-s}\gamma_{s}+\gamma_{t}^{2}G^{2}" display="inline" intent=":literal"><semantics><mrow><mrow><mo>+</mo><mstyle displaystyle="true"><mfrac><mrow><mn>4</mn><mo lspace="0em" rspace="0em">​</mo><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><mi>L</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>γ</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><msup><mi>λ</mi><mi>t</mi></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>C</mi><msub><mi>w</mi><mn>0</mn></msub></msub></mrow><mi>δ</mi></mfrac></mstyle></mrow><mo>+</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mn>4</mn><mo lspace="0em" rspace="0em">​</mo><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><mi>L</mi><mo lspace="0em" rspace="0em">​</mo><mi>G</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>γ</mi><mi>t</mi></msub></mrow><mi>δ</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>s</mi><mo>=</mo><mn>0</mn></mrow><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow></munderover></mstyle><mrow><msup><mi>λ</mi><mrow><mi>t</mi><mo>−</mo><mi>s</mi></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>γ</mi><mi>s</mi></msub></mrow></mrow></mrow><mo>+</mo><mrow><msubsup><mi>γ</mi><mi>t</mi><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mi>G</mi><mn>2</mn></msup></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\quad+\frac{4rCL\gamma_{t}{\lambda}^{t}C_{w_{0}}}{\delta}+\frac{4rCLG\gamma_{t}}{\delta}\sum_{s=0}^{t-1}{\lambda}^{t-s}\gamma_{s}+\gamma_{t}^{2}G^{2}</annotation></semantics></math></td>
