<td id="S1.T1.2.5.3" class="ltx_td ltx_align_center ltx_border_t" style="padding:0.9pt 2.0pt;"><math id="S1.T1.m35" class="ltx_Math" alttext="\mathcal{O}\!\left((C_{\lambda}+\frac{1}{mn})T^{\frac{vL}{1+vL}}\right)" display="inline" intent=":literal"><semantics><mrow><mpadded style="width:0.674em;" width="0.674em"><mi class="ltx_font_mathcaligraphic" mathsize="0.900em">𝒪</mi></mpadded><mo>⁡</mo><mrow><mo>(</mo><mrow><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><mrow><msub><mi mathsize="0.900em">C</mi><mi mathsize="0.900em">λ</mi></msub><mo mathsize="0.900em">+</mo><mfrac><mn mathsize="0.900em">1</mn><mrow><mi mathsize="0.900em">m</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">n</mi></mrow></mfrac></mrow><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mi mathsize="0.900em">T</mi><mfrac><mrow><mi mathsize="0.900em">v</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">L</mi></mrow><mrow><mn mathsize="0.900em">1</mn><mo mathsize="0.900em">+</mo><mrow><mi mathsize="0.900em">v</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">L</mi></mrow></mrow></mfrac></msup></mrow><mo>)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathcal{O}\!\left((C_{\lambda}+\frac{1}{mn})T^{\frac{vL}{1+vL}}\right)</annotation></semantics></math></td>
