maxsize="0.900em" minsize="0.900em">(</mo><mrow><mi mathsize="0.900em">t</mi><mo mathsize="0.900em">+</mo><mn mathsize="0.900em">1</mn></mrow><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow></mrow></mfrac></mstyle></mrow><mo maxsize="2.600em" minsize="2.600em">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\overset{(h)}{\leq}\sum_{t=t_{0}}^{T-1}\left(\frac{T}{t+1}\right)^{Lv(1-\frac{1}{mn})}\times\Bigg(\frac{2CLv\lambda^{t}C_{w_{0}}}{\delta(t+1)}+\frac{2CGLv^{2}}{\delta(1-{\lambda})(t+1)^{2}}+\frac{2Gv}{mn(t+1)}\Bigg)</annotation></semantics></math></td>
