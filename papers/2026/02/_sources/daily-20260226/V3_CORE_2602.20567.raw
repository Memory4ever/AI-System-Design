<td id="S1.T1.2.7.2" class="ltx_td ltx_align_center" style="padding:0.9pt 2.0pt;"><math id="S1.T1.m40" class="ltx_Math" alttext="\mathcal{O}\!\left(\frac{1}{mn}\ln T\right)" display="inline" intent=":literal"><semantics><mrow><mpadded style="width:0.674em;" width="0.674em"><mi class="ltx_font_mathcaligraphic" mathsize="0.900em">𝒪</mi></mpadded><mo>⁡</mo><mrow><mo>(</mo><mrow><mfrac><mn mathsize="0.900em">1</mn><mrow><mi mathsize="0.900em">m</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">n</mi></mrow></mfrac><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi mathsize="0.900em">ln</mi><mo lspace="0.167em">⁡</mo><mi mathsize="0.900em">T</mi></mrow></mrow><mo>)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathcal{O}\!\left(\frac{1}{mn}\ln T\right)</annotation></semantics></math></td>
<td id="S1.T1.2.7.3" class="ltx_td ltx_align_center" style="padding:0.9pt 2.0pt;"><math id="S1.T1.m41" class="ltx_Math" alttext="\mathcal{O}\!\left((1+\frac{C_{\lambda}C_{w_{0}}}{\delta})\frac{1}{\ln T}\right)" display="inline" intent=":literal"><semantics><mrow><mpadded style="width:0.674em;" width="0.674em"><mi class="ltx_font_mathcaligraphic" mathsize="0.900em">𝒪</mi></mpadded><mo>⁡</mo><mrow><mo>(</mo><mrow><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><mrow><mn mathsize="0.900em">1</mn><mo mathsize="0.900em">+</mo><mfrac><mrow><msub><mi mathsize="0.900em">C</mi><mi mathsize="0.900em">λ</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi mathsize="0.900em">C</mi><msub><mi mathsize="0.900em">w</mi><mn mathsize="0.900em">0</mn></msub></msub></mrow><mi mathsize="0.900em">δ</mi></mfrac></mrow><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mfrac><mn mathsize="0.900em">1</mn><mrow><mi mathsize="0.900em">ln</mi><mo lspace="0.167em">⁡</mo><mi mathsize="0.900em">T</mi></mrow></mfrac></mrow><mo>)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathcal{O}\!\left((1+\frac{C_{\lambda}C_{w_{0}}}{\delta})\frac{1}{\ln T}\right)</annotation></semantics></math></td></tr>
