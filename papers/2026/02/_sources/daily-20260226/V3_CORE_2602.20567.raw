<div id="A3.SS7.SSS0.Px2.p2" class="ltx_para">
<p id="A3.SS7.SSS0.Px2.p2.1" class="ltx_p"><span id="A3.SS7.SSS0.Px2.p2.1.1" class="ltx_text" style="font-size:90%;">Finally,
setting
</span><math id="A3.SS7.SSS0.Px2.p2.m1" class="ltx_Math" alttext="t_{0}=v^{\frac{1}{2+vL}}\,T^{\frac{1+vL}{2+vL}}," display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi mathsize="0.900em">t</mi><mn mathsize="0.900em">0</mn></msub><mo mathsize="0.900em">=</mo><mrow><msup><mi mathsize="0.900em">v</mi><mfrac><mn mathsize="0.900em">1</mn><mrow><mn mathsize="0.900em">2</mn><mo mathsize="0.900em">+</mo><mrow><mi mathsize="0.900em">v</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">L</mi></mrow></mrow></mfrac></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi mathsize="0.900em">T</mi><mfrac><mrow><mn mathsize="0.900em">1</mn><mo mathsize="0.900em">+</mo><mrow><mi mathsize="0.900em">v</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">L</mi></mrow></mrow><mrow><mn mathsize="0.900em">2</mn><mo mathsize="0.900em">+</mo><mrow><mi mathsize="0.900em">v</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">L</mi></mrow></mrow></mfrac></msup></mrow></mrow><mo mathsize="0.900em">,</mo></mrow><annotation encoding="application/x-tex">t_{0}=v^{\frac{1}{2+vL}}\,T^{\frac{1+vL}{2+vL}},</annotation></semantics></math><span id="A3.SS7.SSS0.Px2.p2.1.2" class="ltx_text" style="font-size:90%;">
when </span><math id="A3.SS7.SSS0.Px2.p2.m2" class="ltx_Math" alttext="v" display="inline" intent=":literal"><semantics><mi mathsize="0.900em">v</mi><annotation encoding="application/x-tex">v</annotation></semantics></math><span id="A3.SS7.SSS0.Px2.p2.1.3" class="ltx_text" style="font-size:90%;"> is small enough such that </span><math id="A3.SS7.SSS0.Px2.p2.m3" class="ltx_Math" alttext="t_{0}\leq mn" display="inline" intent=":literal"><semantics><mrow><msub><mi mathsize="0.900em">t</mi><mn mathsize="0.900em">0</mn></msub><mo mathsize="0.900em">≤</mo><mrow><mi mathsize="0.900em">m</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">n</mi></mrow></mrow><annotation encoding="application/x-tex">t_{0}\leq mn</annotation></semantics></math><span id="A3.SS7.SSS0.Px2.p2.1.4" class="ltx_text" style="font-size:90%;">, we have</span></p>
<table id="A3.EGx49" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A3.E94"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.E94.m1" class="ltx_Math" alttext="\displaystyle\left(\frac{T}{t_{0}}\right)^{vL+1}" display="inline" intent=":literal"><semantics><msup><mrow><mo>(</mo><mstyle displaystyle="true"><mfrac><mi mathsize="0.900em">T</mi><msub><mi mathsize="0.900em">t</mi><mn mathsize="0.900em">0</mn></msub></mfrac></mstyle><mo>)</mo></mrow><mrow><mrow><mi mathsize="0.900em">v</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">L</mi></mrow><mo mathsize="0.900em">+</mo><mn mathsize="0.900em">1</mn></mrow></msup><annotation encoding="application/x-tex">\displaystyle\left(\frac{T}{t_{0}}\right)^{vL+1}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.E94.m2" class="ltx_Math" alttext="\displaystyle=\left(\frac{T}{v^{\frac{1}{2+vL}}\,T^{\frac{1+vL}{2+vL}}}\right)^{vL+1}=v^{-\frac{vL+1}{2+vL}}\,T^{\frac{vL+1}{2+vL}}," display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo mathsize="0.900em">=</mo><msup><mrow><mo>(</mo><mstyle displaystyle="true"><mfrac><mi mathsize="0.900em">T</mi><mrow><msup><mi mathsize="0.900em">v</mi><mfrac><mn mathsize="0.900em">1</mn><mrow><mn mathsize="0.900em">2</mn><mo mathsize="0.900em">+</mo><mrow><mi mathsize="0.900em">v</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">L</mi></mrow></mrow></mfrac></msup><mo lspace="0.170em" rspace="0em">​</mo><msup><mi mathsize="0.900em">T</mi><mfrac><mrow><mn mathsize="0.900em">1</mn><mo mathsize="0.900em">+</mo><mrow><mi mathsize="0.900em">v</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">L</mi></mrow></mrow><mrow><mn mathsize="0.900em">2</mn><mo mathsize="0.900em">+</mo><mrow><mi mathsize="0.900em">v</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">L</mi></mrow></mrow></mfrac></msup></mrow></mfrac></mstyle><mo>)</mo></mrow><mrow><mrow><mi mathsize="0.900em">v</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">L</mi></mrow><mo mathsize="0.900em">+</mo><mn mathsize="0.900em">1</mn></mrow></msup><mo mathsize="0.900em">=</mo><mrow><msup><mi mathsize="0.900em">v</mi><mrow><mo mathsize="0.900em">−</mo><mfrac><mrow><mrow><mi mathsize="0.900em">v</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">L</mi></mrow><mo mathsize="0.900em">+</mo><mn mathsize="0.900em">1</mn></mrow><mrow><mn mathsize="0.900em">2</mn><mo mathsize="0.900em">+</mo><mrow><mi mathsize="0.900em">v</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">L</mi></mrow></mrow></mfrac></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi mathsize="0.900em">T</mi><mfrac><mrow><mrow><mi mathsize="0.900em">v</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">L</mi></mrow><mo mathsize="0.900em">+</mo><mn mathsize="0.900em">1</mn></mrow><mrow><mn mathsize="0.900em">2</mn><mo mathsize="0.900em">+</mo><mrow><mi mathsize="0.900em">v</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">L</mi></mrow></mrow></mfrac></msup></mrow></mrow><mo mathsize="0.900em">,</mo></mrow><annotation encoding="application/x-tex">\displaystyle=\left(\frac{T}{v^{\frac{1}{2+vL}}\,T^{\frac{1+vL}{2+vL}}}\right)^{vL+1}=v^{-\frac{vL+1}{2+vL}}\,T^{\frac{vL+1}{2+vL}},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(94)</span></td></tr></tbody>
</table>
<p id="A3.SS7.SSS0.Px2.p2.2" class="ltx_p"><span id="A3.SS7.SSS0.Px2.p2.2.1" class="ltx_text" style="font-size:90%;">and</span></p>
<table id="A3.EGx50" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A3.Ex120"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.Ex120.m1" class="ltx_Math" alttext="\displaystyle\epsilon_{\mathrm{stab}}" display="inline" intent=":literal"><semantics><msub><mi mathsize="0.900em">ϵ</mi><mi mathsize="0.900em">stab</mi></msub><annotation encoding="application/x-tex">\displaystyle\epsilon_{\mathrm{stab}}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex120.m2" class="ltx_Math" alttext="\displaystyle\leq\frac{t_{0}}{mn}+G\,\mathbb{E}[\Delta_{T}\mid\Delta_{t_{0}}=0]" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo mathsize="0.900em">≤</mo><mrow><mstyle displaystyle="true"><mfrac><msub><mi mathsize="0.900em">t</mi><mn mathsize="0.900em">0</mn></msub><mrow><mi mathsize="0.900em">m</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">n</mi></mrow></mfrac></mstyle><mo mathsize="0.900em">+</mo><mrow><mi mathsize="0.900em">G</mi><mo lspace="0.170em" rspace="0em">​</mo><mi mathsize="0.900em">𝔼</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="0.900em" minsize="0.900em">[</mo><mrow><msub><mi mathsize="0.900em" mathvariant="normal">Δ</mi><mi mathsize="0.900em">T</mi></msub><mo lspace="0em" mathsize="0.900em" rspace="0.167em">∣</mo><mrow><msub><mi mathsize="0.900em" mathvariant="normal">Δ</mi><msub><mi mathsize="0.900em">t</mi><mn mathsize="0.900em">0</mn></msub></msub><mo mathsize="0.900em">=</mo><mn mathsize="0.900em">0</mn></mrow></mrow><mo maxsize="0.900em" minsize="0.900em">]</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\leq\frac{t_{0}}{mn}+G\,\mathbb{E}[\Delta_{T}\mid\Delta_{t_{0}}=0]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A3.Ex121"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex121.m1" class="ltx_Math" alttext="\displaystyle\leq\frac{v^{\frac{1}{2+vL}}}{mn}\,T^{\frac{1+vL}{2+vL}}+G\left(\frac{4CmnC_{w_{0}}+4\delta G}{\delta mn}+\frac{2CGv}{\delta(1-\lambda)}\right)\left(\frac{T}{t_{0}}\right)^{vL+1}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo mathsize="0.900em">≤</mo><mrow><mrow><mstyle displaystyle="true"><mfrac><msup><mi mathsize="0.900em">v</mi><mfrac><mn mathsize="0.900em">1</mn><mrow><mn mathsize="0.900em">2</mn><mo mathsize="0.900em">+</mo><mrow><mi mathsize="0.900em">v</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">L</mi></mrow></mrow></mfrac></msup><mrow><mi mathsize="0.900em">m</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">n</mi></mrow></mfrac></mstyle><mo lspace="0.170em" rspace="0em">​</mo><msup><mi mathsize="0.900em">T</mi><mfrac><mrow><mn mathsize="0.900em">1</mn><mo mathsize="0.900em">+</mo><mrow><mi mathsize="0.900em">v</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">L</mi></mrow></mrow><mrow><mn mathsize="0.900em">2</mn><mo mathsize="0.900em">+</mo><mrow><mi mathsize="0.900em">v</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">L</mi></mrow></mrow></mfrac></msup></mrow><mo mathsize="0.900em">+</mo><mrow><mrow><mi mathsize="0.900em">G</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mrow><mn mathsize="0.900em">4</mn><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">C</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">m</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">n</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi mathsize="0.900em">C</mi><msub><mi mathsize="0.900em">w</mi><mn mathsize="0.900em">0</mn></msub></msub></mrow><mo mathsize="0.900em">+</mo><mrow><mn mathsize="0.900em">4</mn><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">δ</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">G</mi></mrow></mrow><mrow><mi mathsize="0.900em">δ</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">m</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">n</mi></mrow></mfrac></mstyle><mo mathsize="0.900em">+</mo><mstyle displaystyle="true"><mfrac><mrow><mn mathsize="0.900em">2</mn><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">C</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">G</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">v</mi></mrow><mrow><mi mathsize="0.900em">δ</mi><mo>⁡</mo><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><mrow><mn mathsize="0.900em">1</mn><mo mathsize="0.900em">−</mo><mi mathsize="0.900em">λ</mi></mrow><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow></mrow></mfrac></mstyle></mrow><mo>)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo>(</mo><mstyle displaystyle="true"><mfrac><mi mathsize="0.900em">T</mi><msub><mi mathsize="0.900em">t</mi><mn mathsize="0.900em">0</mn></msub></mfrac></mstyle><mo>)</mo></mrow><mrow><mrow><mi mathsize="0.900em">v</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">L</mi></mrow><mo mathsize="0.900em">+</mo><mn mathsize="0.900em">1</mn></mrow></msup></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\leq\frac{v^{\frac{1}{2+vL}}}{mn}\,T^{\frac{1+vL}{2+vL}}+G\left(\frac{4CmnC_{w_{0}}+4\delta G}{\delta mn}+\frac{2CGv}{\delta(1-\lambda)}\right)\left(\frac{T}{t_{0}}\right)^{vL+1}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A3.E95"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.E95.m1" class="ltx_Math" alttext="\displaystyle=\frac{v^{\frac{1}{2+vL}}}{mn}\,T^{\frac{1+vL}{2+vL}}+G\left(\frac{4CmnC_{w_{0}}+4\delta G}{\delta mn}+\frac{2CGv}{\delta(1-\lambda)}\right)\,v^{-\frac{vL+1}{2+vL}}\,T^{\frac{vL+1}{2+vL}}." display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo mathsize="0.900em">=</mo><mrow><mrow><mstyle displaystyle="true"><mfrac><msup><mi mathsize="0.900em">v</mi><mfrac><mn mathsize="0.900em">1</mn><mrow><mn mathsize="0.900em">2</mn><mo mathsize="0.900em">+</mo><mrow><mi mathsize="0.900em">v</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">L</mi></mrow></mrow></mfrac></msup><mrow><mi mathsize="0.900em">m</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">n</mi></mrow></mfrac></mstyle><mo lspace="0.170em" rspace="0em">​</mo><msup><mi mathsize="0.900em">T</mi><mfrac><mrow><mn mathsize="0.900em">1</mn><mo mathsize="0.900em">+</mo><mrow><mi mathsize="0.900em">v</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">L</mi></mrow></mrow><mrow><mn mathsize="0.900em">2</mn><mo mathsize="0.900em">+</mo><mrow><mi mathsize="0.900em">v</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">L</mi></mrow></mrow></mfrac></msup></mrow><mo mathsize="0.900em">+</mo><mrow><mrow><mi mathsize="0.900em">G</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mrow><mn mathsize="0.900em">4</mn><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">C</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">m</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">n</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi mathsize="0.900em">C</mi><msub><mi mathsize="0.900em">w</mi><mn mathsize="0.900em">0</mn></msub></msub></mrow><mo mathsize="0.900em">+</mo><mrow><mn mathsize="0.900em">4</mn><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">δ</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">G</mi></mrow></mrow><mrow><mi mathsize="0.900em">δ</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">m</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">n</mi></mrow></mfrac></mstyle><mo mathsize="0.900em">+</mo><mstyle displaystyle="true"><mfrac><mrow><mn mathsize="0.900em">2</mn><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">C</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">G</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">v</mi></mrow><mrow><mi mathsize="0.900em">δ</mi><mo>⁡</mo><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><mrow><mn mathsize="0.900em">1</mn><mo mathsize="0.900em">−</mo><mi mathsize="0.900em">λ</mi></mrow><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow></mrow></mfrac></mstyle></mrow><mo>)</mo></mrow></mrow><mo lspace="0.170em" rspace="0em">​</mo><msup><mi mathsize="0.900em">v</mi><mrow><mo mathsize="0.900em">−</mo><mfrac><mrow><mrow><mi mathsize="0.900em">v</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">L</mi></mrow><mo mathsize="0.900em">+</mo><mn mathsize="0.900em">1</mn></mrow><mrow><mn mathsize="0.900em">2</mn><mo mathsize="0.900em">+</mo><mrow><mi mathsize="0.900em">v</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">L</mi></mrow></mrow></mfrac></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi mathsize="0.900em">T</mi><mfrac><mrow><mrow><mi mathsize="0.900em">v</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">L</mi></mrow><mo mathsize="0.900em">+</mo><mn mathsize="0.900em">1</mn></mrow><mrow><mn mathsize="0.900em">2</mn><mo mathsize="0.900em">+</mo><mrow><mi mathsize="0.900em">v</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">L</mi></mrow></mrow></mfrac></msup></mrow></mrow></mrow><mo lspace="0em" mathsize="0.900em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle=\frac{v^{\frac{1}{2+vL}}}{mn}\,T^{\frac{1+vL}{2+vL}}+G\left(\frac{4CmnC_{w_{0}}+4\delta G}{\delta mn}+\frac{2CGv}{\delta(1-\lambda)}\right)\,v^{-\frac{vL+1}{2+vL}}\,T^{\frac{vL+1}{2+vL}}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(95)</span></td></tr></tbody>
</table>
</div>
<div id="A3.SS7.SSS0.Px2.p3" class="ltx_para">
<p id="A3.SS7.SSS0.Px2.p3.1" class="ltx_p"><span id="A3.SS7.SSS0.Px2.p3.1.1" class="ltx_text" style="font-size:90%;">This completes the proof of Corollary </span><a href="#Thmtheorem33" title="Corollary 33 (Uniform Stability on Common Learning Rate). ‣ 4.3 Results on Non-convex Case ‣ 4 Theoretical Analysis ‣ Stability and Generalization of Push-Sum Based Decentralized Optimization over Directed Graphs" class="ltx_ref" style="font-size:90%;"><span class="ltx_text ltx_ref_tag">33</span></a><span id="A3.SS7.SSS0.Px2.p3.1.2" class="ltx_text" style="font-size:90%;">.
∎</span><span id="A3.SS7.SSS0.Px2.p3.1.3" class="ltx_text"></span></p>
</div>
</section>
</section>
<section id="A3.SS8" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">C.8 </span>Proof of Theorem <a href="#Thmtheorem37" title="Theorem 37 (Optimization Error). ‣ 4.3 Results on Non-convex Case ‣ 4 Theoretical Analysis ‣ Stability and Generalization of Push-Sum Based Decentralized Optimization over Directed Graphs" class="ltx_ref"><span class="ltx_text ltx_ref_tag">37</span></a></h3>

<div id="A3.SS8.2" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="A3.SS8.p1" class="ltx_para">
<p id="A3.SS8.p1.1" class="ltx_p"><span id="A3.SS8.p1.1.1" class="ltx_text">Let <math id="A3.SS8.p1.m1" class="ltx_Math" alttext="F_{\mathcal{S}}" display="inline" intent=":literal"><semantics><msub><mi>F</mi><mi class="ltx_font_mathcaligraphic">𝒮</mi></msub><annotation encoding="application/x-tex">F_{\mathcal{S}}</annotation></semantics></math> be <math id="A3.SS8.p1.m2" class="ltx_Math" alttext="L" display="inline" intent=":literal"><semantics><mi>L</mi><annotation encoding="application/x-tex">L</annotation></semantics></math>-smooth. By the smoothness descent inequality, for any <math id="A3.SS8.p1.m3" class="ltx_Math" alttext="t\geq 0" display="inline" intent=":literal"><semantics><mrow><mi>t</mi><mo>≥</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">t\geq 0</annotation></semantics></math>,</span></p>
<table id="A3.EGx51" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A3.E96"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.E96.m1" class="ltx_Math" alttext="\displaystyle\mathbb{E}\!\left[F_{\mathcal{S}}(\overline{\bm{w}}^{(t+1)})-F_{\mathcal{S}}(\overline{\bm{w}}^{(t)})\right]" display="inline" intent=":literal"><semantics><mrow><mpadded style="width:0.497em;" width="0.497em"><mi>𝔼</mi></mpadded><mo>⁡</mo><mrow><mo>[</mo><mrow><mrow><msub><mi>F</mi><mi class="ltx_font_mathcaligraphic">𝒮</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mover accent="true"><mi>𝒘</mi><mo stretchy="true">¯</mo></mover><mrow><mo stretchy="false">(</mo><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msub><mi>F</mi><mi class="ltx_font_mathcaligraphic">𝒮</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mover accent="true"><mi>𝒘</mi><mo stretchy="true">¯</mo></mover><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>]</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\mathbb{E}\!\left[F_{\mathcal{S}}(\overline{\bm{w}}^{(t+1)})-F_{\mathcal{S}}(\overline{\bm{w}}^{(t)})\right]</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.E96.m2" class="ltx_Math" alttext="\displaystyle\leq\mathbb{E}\!\left\langle\nabla F_{\mathcal{S}}(\overline{\bm{w}}^{(t)}),\,\overline{\bm{w}}^{(t+1)}-\overline{\bm{w}}^{(t)}\right\rangle+\frac{L}{2}\mathbb{E}\!\left\|\overline{\bm{w}}^{(t+1)}-\overline{\bm{w}}^{(t)}\right\|^{2}." display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>≤</mo><mrow><mrow><mpadded style="width:0.497em;" width="0.497em"><mi>𝔼</mi></mpadded><mo>⁡</mo><mrow><mo>⟨</mo><mrow><mrow><mrow><mo rspace="0.167em">∇</mo><msub><mi>F</mi><mi class="ltx_font_mathcaligraphic">𝒮</mi></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mover accent="true"><mi>𝒘</mi><mo stretchy="true">¯</mo></mover><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow></mrow><mo rspace="0.337em">,</mo><mrow><msup><mover accent="true"><mi>𝒘</mi><mo stretchy="true">¯</mo></mover><mrow><mo stretchy="false">(</mo><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></msup><mo>−</mo><msup><mover accent="true"><mi>𝒘</mi><mo stretchy="true">¯</mo></mover><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup></mrow></mrow><mo>⟩</mo></mrow></mrow><mo>+</mo><mrow><mstyle displaystyle="true"><mfrac><mi>L</mi><mn>2</mn></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mpadded style="width:0.497em;" width="0.497em"><mi>𝔼</mi></mpadded><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo>‖</mo><mrow><msup><mover accent="true"><mi>𝒘</mi><mo stretchy="true">¯</mo></mover><mrow><mo stretchy="false">(</mo><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></msup><mo>−</mo><msup><mover accent="true"><mi>𝒘</mi><mo stretchy="true">¯</mo></mover><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup></mrow><mo>‖</mo></mrow><mn>2</mn></msup></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\leq\mathbb{E}\!\left\langle\nabla F_{\mathcal{S}}(\overline{\bm{w}}^{(t)}),\,\overline{\bm{w}}^{(t+1)}-\overline{\bm{w}}^{(t)}\right\rangle+\frac{L}{2}\mathbb{E}\!\left\|\overline{\bm{w}}^{(t+1)}-\overline{\bm{w}}^{(t)}\right\|^{2}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(96)</span></td></tr></tbody>
</table>
<p id="A3.SS8.p1.2" class="ltx_p"><span id="A3.SS8.p1.2.1" class="ltx_text">Using Proposition <a href="#Thmtheorem7" title="Proposition 7. ‣ 3.3 Algorithm: Stochastic Gradient Push (SGP) ‣ 3 Preliminaries ‣ Stability and Generalization of Push-Sum Based Decentralized Optimization over Directed Graphs" class="ltx_ref"><span class="ltx_text ltx_ref_tag">7</span></a>,</span></p>
<table id="A3.EGx52" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A3.Ex122"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.Ex122.m1" class="ltx_Math" alttext="\displaystyle\mathbb{E}\!\left[F_{\mathcal{S}}(\overline{\bm{w}}^{(t+1)})-F_{\mathcal{S}}(\overline{\bm{w}}^{(t)})\right]" display="inline" intent=":literal"><semantics><mrow><mpadded style="width:0.497em;" width="0.497em"><mi>𝔼</mi></mpadded><mo>⁡</mo><mrow><mo>[</mo><mrow><mrow><msub><mi>F</mi><mi class="ltx_font_mathcaligraphic">𝒮</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mover accent="true"><mi>𝒘</mi><mo stretchy="true">¯</mo></mover><mrow><mo stretchy="false">(</mo><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msub><mi>F</mi><mi class="ltx_font_mathcaligraphic">𝒮</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mover accent="true"><mi>𝒘</mi><mo stretchy="true">¯</mo></mover><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>]</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\mathbb{E}\!\left[F_{\mathcal{S}}(\overline{\bm{w}}^{(t+1)})-F_{\mathcal{S}}(\overline{\bm{w}}^{(t)})\right]</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex122.m2" class="ltx_Math" alttext="\displaystyle\leq-\frac{\gamma_{t}}{m}\,\mathbb{E}\!\left\langle\nabla F_{\mathcal{S}}(\overline{\bm{w}}^{(t)}),\,\sum_{i=1}^{m}\nabla f(\bm{z}_{i}^{(t)};\bm{\xi}_{i}^{(t)})\right\rangle+\frac{L\gamma_{t}^{2}}{2}\,\mathbb{E}\!\left\|\frac{1}{m}\sum_{i=1}^{m}\nabla f(\bm{z}_{i}^{(t)};\bm{\xi}_{i}^{(t)})\right\|^{2}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≤</mo><mrow><mrow><mo>−</mo><mrow><mstyle displaystyle="true"><mfrac><msub><mi>γ</mi><mi>t</mi></msub><mi>m</mi></mfrac></mstyle><mo lspace="0.170em" rspace="0em">​</mo><mpadded style="width:0.497em;" width="0.497em"><mi>𝔼</mi></mpadded><mo lspace="0em" rspace="0em">​</mo><mrow><mo>⟨</mo><mrow><mrow><mrow><mo rspace="0.167em">∇</mo><msub><mi>F</mi><mi class="ltx_font_mathcaligraphic">𝒮</mi></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mover accent="true"><mi>𝒘</mi><mo stretchy="true">¯</mo></mover><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow></mrow><mo rspace="0.337em">,</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>m</mi></munderover></mstyle><mrow><mrow><mo lspace="0.167em" rspace="0.167em">∇</mo><mi>f</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>𝒛</mi><mi>i</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msubsup><mo>,</mo><msubsup><mi>𝝃</mi><mi>i</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msubsup><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo>⟩</mo></mrow></mrow></mrow><mo>+</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mi>L</mi><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>γ</mi><mi>t</mi><mn>2</mn></msubsup></mrow><mn>2</mn></mfrac></mstyle><mo lspace="0.170em" rspace="0em">​</mo><mpadded style="width:0.497em;" width="0.497em"><mi>𝔼</mi></mpadded><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo>‖</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>m</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>m</mi></munderover></mstyle><mrow><mrow><mo lspace="0.167em" rspace="0.167em">∇</mo><mi>f</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>𝒛</mi><mi>i</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msubsup><mo>,</mo><msubsup><mi>𝝃</mi><mi>i</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msubsup><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo>‖</mo></mrow><mn>2</mn></msup></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\leq-\frac{\gamma_{t}}{m}\,\mathbb{E}\!\left\langle\nabla F_{\mathcal{S}}(\overline{\bm{w}}^{(t)}),\,\sum_{i=1}^{m}\nabla f(\bm{z}_{i}^{(t)};\bm{\xi}_{i}^{(t)})\right\rangle+\frac{L\gamma_{t}^{2}}{2}\,\mathbb{E}\!\left\|\frac{1}{m}\sum_{i=1}^{m}\nabla f(\bm{z}_{i}^{(t)};\bm{\xi}_{i}^{(t)})\right\|^{2}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A3.Ex123"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex123.m1" class="ltx_Math" alttext="\displaystyle=-\gamma_{t}\,\mathbb{E}\!\left\|\nabla F_{\mathcal{S}}(\overline{\bm{w}}^{(t)})\right\|^{2}+\frac{\gamma_{t}}{m}\,\mathbb{E}\!\left\langle\nabla F_{\mathcal{S}}(\overline{\bm{w}}^{(t)}),\,\sum_{i=1}^{m}\Big(\nabla f(\overline{\bm{w}}^{(t)};\bm{\xi}_{i}^{(t)})-\nabla f(\bm{z}_{i}^{(t)};\bm{\xi}_{i}^{(t)})\Big)\right\rangle" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><mo>−</mo><mrow><msub><mi>γ</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mpadded style="width:0.497em;" width="0.497em"><mi>𝔼</mi></mpadded><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo>‖</mo><mrow><mrow><mo rspace="0.167em">∇</mo><msub><mi>F</mi><mi class="ltx_font_mathcaligraphic">𝒮</mi></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mover accent="true"><mi>𝒘</mi><mo stretchy="true">¯</mo></mover><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow></mrow><mo>‖</mo></mrow><mn>2</mn></msup></mrow></mrow><mo>+</mo><mrow><mstyle displaystyle="true"><mfrac><msub><mi>γ</mi><mi>t</mi></msub><mi>m</mi></mfrac></mstyle><mo lspace="0.170em" rspace="0em">​</mo><mpadded style="width:0.497em;" width="0.497em"><mi>𝔼</mi></mpadded><mo lspace="0em" rspace="0em">​</mo><mrow><mo>⟨</mo><mrow><mrow><mrow><mo rspace="0.167em">∇</mo><msub><mi>F</mi><mi class="ltx_font_mathcaligraphic">𝒮</mi></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mover accent="true"><mi>𝒘</mi><mo stretchy="true">¯</mo></mover><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow></mrow><mo rspace="0.337em">,</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>m</mi></munderover></mstyle><mrow><mo maxsize="1.600em" minsize="1.600em">(</mo><mrow><mrow><mrow><mo rspace="0.167em">∇</mo><mi>f</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mover accent="true"><mi>𝒘</mi><mo stretchy="true">¯</mo></mover><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo>,</mo><msubsup><mi>𝝃</mi><mi>i</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msubsup><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mrow><mo rspace="0.167em">∇</mo><mi>f</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>𝒛</mi><mi>i</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msubsup><mo>,</mo><msubsup><mi>𝝃</mi><mi>i</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msubsup><mo stretchy="false">)</mo></mrow></mrow></mrow><mo maxsize="1.600em" minsize="1.600em">)</mo></mrow></mrow></mrow><mo>⟩</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=-\gamma_{t}\,\mathbb{E}\!\left\|\nabla F_{\mathcal{S}}(\overline{\bm{w}}^{(t)})\right\|^{2}+\frac{\gamma_{t}}{m}\,\mathbb{E}\!\left\langle\nabla F_{\mathcal{S}}(\overline{\bm{w}}^{(t)}),\,\sum_{i=1}^{m}\Big(\nabla f(\overline{\bm{w}}^{(t)};\bm{\xi}_{i}^{(t)})-\nabla f(\bm{z}_{i}^{(t)};\bm{\xi}_{i}^{(t)})\Big)\right\rangle</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A3.E97"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.E97.m1" class="ltx_Math" alttext="\displaystyle\quad+\frac{L\gamma_{t}^{2}}{2}\,\mathbb{E}\!\left\|\frac{1}{m}\sum_{i=1}^{m}\nabla f(\bm{z}_{i}^{(t)};\bm{\xi}_{i}^{(t)})\right\|^{2}." display="inline" intent=":literal"><semantics><mrow><mrow><mo>+</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mi>L</mi><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>γ</mi><mi>t</mi><mn>2</mn></msubsup></mrow><mn>2</mn></mfrac></mstyle><mo lspace="0.170em" rspace="0em">​</mo><mpadded style="width:0.497em;" width="0.497em"><mi>𝔼</mi></mpadded><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo>‖</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>m</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>m</mi></munderover></mstyle><mrow><mrow><mo lspace="0.167em" rspace="0.167em">∇</mo><mi>f</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>𝒛</mi><mi>i</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msubsup><mo>,</mo><msubsup><mi>𝝃</mi><mi>i</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msubsup><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo>‖</mo></mrow><mn>2</mn></msup></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\quad+\frac{L\gamma_{t}^{2}}{2}\,\mathbb{E}\!\left\|\frac{1}{m}\sum_{i=1}^{m}\nabla f(\bm{z}_{i}^{(t)};\bm{\xi}_{i}^{(t)})\right\|^{2}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(97)</span></td></tr></tbody>
</table>
<p id="A3.SS8.p1.3" class="ltx_p"><span id="A3.SS8.p1.3.1" class="ltx_text">For the middle inner-product term, apply Cauchy–Schwarz and the uniform gradient bound <math id="A3.SS8.p1.m4" class="ltx_Math" alttext="\|\nabla f(\cdot)\|\leq G" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">‖</mo><mrow><mrow><mo rspace="0.167em">∇</mo><mi>f</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">‖</mo></mrow><mo>≤</mo><mi>G</mi></mrow><annotation encoding="application/x-tex">\|\nabla f(\cdot)\|\leq G</annotation></semantics></math>, which implies <math id="A3.SS8.p1.m5" class="ltx_Math" alttext="\|\nabla F_{\mathcal{S}}(\cdot)\|\leq G" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">‖</mo><mrow><mrow><mo rspace="0.167em">∇</mo><msub><mi>F</mi><mi class="ltx_font_mathcaligraphic">𝒮</mi></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">‖</mo></mrow><mo>≤</mo><mi>G</mi></mrow><annotation encoding="application/x-tex">\|\nabla F_{\mathcal{S}}(\cdot)\|\leq G</annotation></semantics></math>:</span></p>
<table id="A3.EGx53" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A3.Ex124"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.Ex124.m1" class="ltx_Math" alttext="\displaystyle\frac{\gamma_{t}}{m}\," display="inline" intent=":literal"><semantics><mstyle displaystyle="true"><mfrac><msub><mi>γ</mi><mi>t</mi></msub><mi>m</mi></mfrac></mstyle><annotation encoding="application/x-tex">\displaystyle\frac{\gamma_{t}}{m}\,</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex124.m2" class="ltx_Math" alttext="\displaystyle\mathbb{E}\!\left\langle\nabla F_{\mathcal{S}}(\overline{\bm{w}}^{(t)}),\,\sum_{i=1}^{m}\Big(\nabla f(\overline{\bm{w}}^{(t)};\bm{\xi}_{i}^{(t)})-\nabla f(\bm{z}_{i}^{(t)};\bm{\xi}_{i}^{(t)})\Big)\right\rangle" display="inline" intent=":literal"><semantics><mrow><mpadded style="width:0.497em;" width="0.497em"><mi>𝔼</mi></mpadded><mo>⁡</mo><mrow><mo>⟨</mo><mrow><mrow><mrow><mo rspace="0.167em">∇</mo><msub><mi>F</mi><mi class="ltx_font_mathcaligraphic">𝒮</mi></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mover accent="true"><mi>𝒘</mi><mo stretchy="true">¯</mo></mover><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow></mrow><mo rspace="0.337em">,</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>m</mi></munderover></mstyle><mrow><mo maxsize="1.600em" minsize="1.600em">(</mo><mrow><mrow><mrow><mo rspace="0.167em">∇</mo><mi>f</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mover accent="true"><mi>𝒘</mi><mo stretchy="true">¯</mo></mover><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo>,</mo><msubsup><mi>𝝃</mi><mi>i</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msubsup><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mrow><mo rspace="0.167em">∇</mo><mi>f</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>𝒛</mi><mi>i</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msubsup><mo>,</mo><msubsup><mi>𝝃</mi><mi>i</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msubsup><mo stretchy="false">)</mo></mrow></mrow></mrow><mo maxsize="1.600em" minsize="1.600em">)</mo></mrow></mrow></mrow><mo>⟩</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\mathbb{E}\!\left\langle\nabla F_{\mathcal{S}}(\overline{\bm{w}}^{(t)}),\,\sum_{i=1}^{m}\Big(\nabla f(\overline{\bm{w}}^{(t)};\bm{\xi}_{i}^{(t)})-\nabla f(\bm{z}_{i}^{(t)};\bm{\xi}_{i}^{(t)})\Big)\right\rangle</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A3.Ex125"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex125.m1" class="ltx_Math" alttext="\displaystyle\leq\frac{\gamma_{t}}{m}\sum_{i=1}^{m}\mathbb{E}\!\left[\|\nabla F_{\mathcal{S}}(\overline{\bm{w}}^{(t)})\|\cdot\big\|\nabla f(\overline{\bm{w}}^{(t)};\bm{\xi}_{i}^{(t)})-\nabla f(\bm{z}_{i}^{(t)};\bm{\xi}_{i}^{(t)})\big\|\right]" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≤</mo><mrow><mstyle displaystyle="true"><mfrac><msub><mi>γ</mi><mi>t</mi></msub><mi>m</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>m</mi></munderover></mstyle><mrow><mpadded style="width:0.497em;" width="0.497em"><mi>𝔼</mi></mpadded><mo>⁡</mo><mrow><mo>[</mo><mrow><mrow><mo stretchy="false">‖</mo><mrow><mrow><mo rspace="0.167em">∇</mo><msub><mi>F</mi><mi class="ltx_font_mathcaligraphic">𝒮</mi></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mover accent="true"><mi>𝒘</mi><mo stretchy="true">¯</mo></mover><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow></mrow><mo rspace="0.055em" stretchy="false">‖</mo></mrow><mo rspace="0.222em">⋅</mo><mrow><mo maxsize="1.200em" minsize="1.200em" stretchy="true">‖</mo><mrow><mrow><mrow><mo rspace="0.167em">∇</mo><mi>f</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mover accent="true"><mi>𝒘</mi><mo stretchy="true">¯</mo></mover><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo>,</mo><msubsup><mi>𝝃</mi><mi>i</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msubsup><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mrow><mo rspace="0.167em">∇</mo><mi>f</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>𝒛</mi><mi>i</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msubsup><mo>,</mo><msubsup><mi>𝝃</mi><mi>i</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msubsup><mo stretchy="false">)</mo></mrow></mrow></mrow><mo maxsize="1.200em" minsize="1.200em" stretchy="true">‖</mo></mrow></mrow><mo>]</mo></mrow></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\leq\frac{\gamma_{t}}{m}\sum_{i=1}^{m}\mathbb{E}\!\left[\|\nabla F_{\mathcal{S}}(\overline{\bm{w}}^{(t)})\|\cdot\big\|\nabla f(\overline{\bm{w}}^{(t)};\bm{\xi}_{i}^{(t)})-\nabla f(\bm{z}_{i}^{(t)};\bm{\xi}_{i}^{(t)})\big\|\right]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A3.Ex126"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex126.m1" class="ltx_Math" alttext="\displaystyle\leq\frac{G\gamma_{t}}{m}\sum_{i=1}^{m}\mathbb{E}\!\left[\big\|\nabla f(\overline{\bm{w}}^{(t)};\bm{\xi}_{i}^{(t)})-\nabla f(\bm{z}_{i}^{(t)};\bm{\xi}_{i}^{(t)})\big\|\right]" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≤</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mi>G</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>γ</mi><mi>t</mi></msub></mrow><mi>m</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>m</mi></munderover></mstyle><mrow><mpadded style="width:0.497em;" width="0.497em"><mi>𝔼</mi></mpadded><mo>⁡</mo><mrow><mo>[</mo><mrow><mo maxsize="1.200em" minsize="1.200em" stretchy="true">‖</mo><mrow><mrow><mrow><mo rspace="0.167em">∇</mo><mi>f</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mover accent="true"><mi>𝒘</mi><mo stretchy="true">¯</mo></mover><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo>,</mo><msubsup><mi>𝝃</mi><mi>i</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msubsup><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mrow><mo rspace="0.167em">∇</mo><mi>f</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>𝒛</mi><mi>i</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msubsup><mo>,</mo><msubsup><mi>𝝃</mi><mi>i</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msubsup><mo stretchy="false">)</mo></mrow></mrow></mrow><mo maxsize="1.200em" minsize="1.200em" stretchy="true">‖</mo></mrow><mo>]</mo></mrow></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\leq\frac{G\gamma_{t}}{m}\sum_{i=1}^{m}\mathbb{E}\!\left[\big\|\nabla f(\overline{\bm{w}}^{(t)};\bm{\xi}_{i}^{(t)})-\nabla f(\bm{z}_{i}^{(t)};\bm{\xi}_{i}^{(t)})\big\|\right]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A3.E98"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.E98.m1" class="ltx_Math" alttext="\displaystyle\leq\frac{GL\gamma_{t}}{m}\sum_{i=1}^{m}\mathbb{E}\!\left\|\overline{\bm{w}}^{(t)}-\bm{z}_{i}^{(t)}\right\|," display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>≤</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mi>G</mi><mo lspace="0em" rspace="0em">​</mo><mi>L</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>γ</mi><mi>t</mi></msub></mrow><mi>m</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>m</mi></munderover></mstyle><mrow><mpadded style="width:0.497em;" width="0.497em"><mi>𝔼</mi></mpadded><mo>⁡</mo><mrow><mo>‖</mo><mrow><msup><mover accent="true"><mi>𝒘</mi><mo stretchy="true">¯</mo></mover><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo>−</mo><msubsup><mi>𝒛</mi><mi>i</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msubsup></mrow><mo>‖</mo></mrow></mrow></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\leq\frac{GL\gamma_{t}}{m}\sum_{i=1}^{m}\mathbb{E}\!\left\|\overline{\bm{w}}^{(t)}-\bm{z}_{i}^{(t)}\right\|,</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(98)</span></td></tr></tbody>
</table>
<p id="A3.SS8.p1.4" class="ltx_p"><span id="A3.SS8.p1.4.1" class="ltx_text">where the last step uses <math id="A3.SS8.p1.m6" class="ltx_Math" alttext="L" display="inline" intent=":literal"><semantics><mi>L</mi><annotation encoding="application/x-tex">L</annotation></semantics></math>-smoothness of <math id="A3.SS8.p1.m7" class="ltx_Math" alttext="f(\cdot;\xi)" display="inline" intent=":literal"><semantics><mrow><mi>f</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo>,</mo><mi>ξ</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">f(\cdot;\xi)</annotation></semantics></math> (gradient <math id="A3.SS8.p1.m8" class="ltx_Math" alttext="L" display="inline" intent=":literal"><semantics><mi>L</mi><annotation encoding="application/x-tex">L</annotation></semantics></math>-Lipschitz).
For the last term in (<a href="#A3.E97" title="In Proof. ‣ C.8 Proof of Theorem ‣ Appendix C Proof of Theorem and Corollary ‣ Stability and Generalization of Push-Sum Based Decentralized Optimization over Directed Graphs" class="ltx_ref"><span class="ltx_text ltx_ref_tag">97</span></a>), Jensen’s inequality and <math id="A3.SS8.p1.m9" class="ltx_Math" alttext="\|\nabla f(\cdot)\|\leq G" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">‖</mo><mrow><mrow><mo rspace="0.167em">∇</mo><mi>f</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">‖</mo></mrow><mo>≤</mo><mi>G</mi></mrow><annotation encoding="application/x-tex">\|\nabla f(\cdot)\|\leq G</annotation></semantics></math> give</span></p>
<table id="A3.EGx54" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A3.E99"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.E99.m1" class="ltx_Math" alttext="\displaystyle\frac{L\gamma_{t}^{2}}{2}\,\mathbb{E}\!\left\|\frac{1}{m}\sum_{i=1}^{m}\nabla f(\bm{z}_{i}^{(t)};\bm{\xi}_{i}^{(t)})\right\|^{2}\leq\frac{L\gamma_{t}^{2}}{2}\,\mathbb{E}\!\left[\frac{1}{m}\sum_{i=1}^{m}\|\nabla f(\bm{z}_{i}^{(t)};\bm{\xi}_{i}^{(t)})\|^{2}\right]\leq\frac{LG^{2}\gamma_{t}^{2}}{2}." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mstyle displaystyle="true"><mfrac><mrow><mi>L</mi><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>γ</mi><mi>t</mi><mn>2</mn></msubsup></mrow><mn>2</mn></mfrac></mstyle><mo lspace="0.170em" rspace="0em">​</mo><mpadded style="width:0.497em;" width="0.497em"><mi>𝔼</mi></mpadded><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo>‖</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>m</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>m</mi></munderover></mstyle><mrow><mrow><mo lspace="0.167em" rspace="0.167em">∇</mo><mi>f</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>𝒛</mi><mi>i</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msubsup><mo>,</mo><msubsup><mi>𝝃</mi><mi>i</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msubsup><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo>‖</mo></mrow><mn>2</mn></msup></mrow><mo>≤</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mi>L</mi><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>γ</mi><mi>t</mi><mn>2</mn></msubsup></mrow><mn>2</mn></mfrac></mstyle><mo lspace="0.170em" rspace="0em">​</mo><mpadded style="width:0.497em;" width="0.497em"><mi>𝔼</mi></mpadded><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>m</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>m</mi></munderover></mstyle><msup><mrow><mo stretchy="false">‖</mo><mrow><mrow><mo rspace="0.167em">∇</mo><mi>f</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>𝒛</mi><mi>i</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msubsup><mo>,</mo><msubsup><mi>𝝃</mi><mi>i</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msubsup><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup></mrow></mrow><mo>]</mo></mrow></mrow><mo>≤</mo><mstyle displaystyle="true"><mfrac><mrow><mi>L</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>G</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>γ</mi><mi>t</mi><mn>2</mn></msubsup></mrow><mn>2</mn></mfrac></mstyle></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\frac{L\gamma_{t}^{2}}{2}\,\mathbb{E}\!\left\|\frac{1}{m}\sum_{i=1}^{m}\nabla f(\bm{z}_{i}^{(t)};\bm{\xi}_{i}^{(t)})\right\|^{2}\leq\frac{L\gamma_{t}^{2}}{2}\,\mathbb{E}\!\left[\frac{1}{m}\sum_{i=1}^{m}\|\nabla f(\bm{z}_{i}^{(t)};\bm{\xi}_{i}^{(t)})\|^{2}\right]\leq\frac{LG^{2}\gamma_{t}^{2}}{2}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(99)</span></td></tr></tbody>
</table>
<p id="A3.SS8.p1.5" class="ltx_p"><span id="A3.SS8.p1.5.1" class="ltx_text">Substituting (<a href="#A3.E98" title="In Proof. ‣ C.8 Proof of Theorem ‣ Appendix C Proof of Theorem and Corollary ‣ Stability and Generalization of Push-Sum Based Decentralized Optimization over Directed Graphs" class="ltx_ref"><span class="ltx_text ltx_ref_tag">98</span></a>) and (<a href="#A3.E99" title="In Proof. ‣ C.8 Proof of Theorem ‣ Appendix C Proof of Theorem and Corollary ‣ Stability and Generalization of Push-Sum Based Decentralized Optimization over Directed Graphs" class="ltx_ref"><span class="ltx_text ltx_ref_tag">99</span></a>) into (<a href="#A3.E97" title="In Proof. ‣ C.8 Proof of Theorem ‣ Appendix C Proof of Theorem and Corollary ‣ Stability and Generalization of Push-Sum Based Decentralized Optimization over Directed Graphs" class="ltx_ref"><span class="ltx_text ltx_ref_tag">97</span></a>), we obtain</span></p>
<table id="A3.EGx55" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A3.E100"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.E100.m1" class="ltx_Math" alttext="\displaystyle\mathbb{E}\!\left[F_{\mathcal{S}}(\overline{\bm{w}}^{(t+1)})-F_{\mathcal{S}}(\overline{\bm{w}}^{(t)})\right]" display="inline" intent=":literal"><semantics><mrow><mpadded style="width:0.497em;" width="0.497em"><mi>𝔼</mi></mpadded><mo>⁡</mo><mrow><mo>[</mo><mrow><mrow><msub><mi>F</mi><mi class="ltx_font_mathcaligraphic">𝒮</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mover accent="true"><mi>𝒘</mi><mo stretchy="true">¯</mo></mover><mrow><mo stretchy="false">(</mo><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msub><mi>F</mi><mi class="ltx_font_mathcaligraphic">𝒮</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mover accent="true"><mi>𝒘</mi><mo stretchy="true">¯</mo></mover><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>]</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\mathbb{E}\!\left[F_{\mathcal{S}}(\overline{\bm{w}}^{(t+1)})-F_{\mathcal{S}}(\overline{\bm{w}}^{(t)})\right]</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.E100.m2" class="ltx_Math" alttext="\displaystyle\leq-\gamma_{t}\,\mathbb{E}\!\left\|\nabla F_{\mathcal{S}}(\overline{\bm{w}}^{(t)})\right\|^{2}+\frac{GL\gamma_{t}}{m}\sum_{i=1}^{m}\mathbb{E}\!\left\|\overline{\bm{w}}^{(t)}-\bm{z}_{i}^{(t)}\right\|+\frac{LG^{2}\gamma_{t}^{2}}{2}." display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>≤</mo><mrow><mrow><mo>−</mo><mrow><msub><mi>γ</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mpadded style="width:0.497em;" width="0.497em"><mi>𝔼</mi></mpadded><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo>‖</mo><mrow><mrow><mo rspace="0.167em">∇</mo><msub><mi>F</mi><mi class="ltx_font_mathcaligraphic">𝒮</mi></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mover accent="true"><mi>𝒘</mi><mo stretchy="true">¯</mo></mover><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow></mrow><mo>‖</mo></mrow><mn>2</mn></msup></mrow></mrow><mo>+</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mi>G</mi><mo lspace="0em" rspace="0em">​</mo><mi>L</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>γ</mi><mi>t</mi></msub></mrow><mi>m</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>m</mi></munderover></mstyle><mrow><mpadded style="width:0.497em;" width="0.497em"><mi>𝔼</mi></mpadded><mo>⁡</mo><mrow><mo>‖</mo><mrow><msup><mover accent="true"><mi>𝒘</mi><mo stretchy="true">¯</mo></mover><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo>−</mo><msubsup><mi>𝒛</mi><mi>i</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msubsup></mrow><mo>‖</mo></mrow></mrow></mrow></mrow><mo>+</mo><mstyle displaystyle="true"><mfrac><mrow><mi>L</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>G</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>γ</mi><mi>t</mi><mn>2</mn></msubsup></mrow><mn>2</mn></mfrac></mstyle></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\leq-\gamma_{t}\,\mathbb{E}\!\left\|\nabla F_{\mathcal{S}}(\overline{\bm{w}}^{(t)})\right\|^{2}+\frac{GL\gamma_{t}}{m}\sum_{i=1}^{m}\mathbb{E}\!\left\|\overline{\bm{w}}^{(t)}-\bm{z}_{i}^{(t)}\right\|+\frac{LG^{2}\gamma_{t}^{2}}{2}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(100)</span></td></tr></tbody>
</table>
<p id="A3.SS8.p1.6" class="ltx_p"><span id="A3.SS8.p1.6.1" class="ltx_text">By the PŁ condition, <math id="A3.SS8.p1.m10" class="ltx_Math" alttext="\|\nabla F_{\mathcal{S}}(w)\|^{2}\geq 2\alpha\big(F_{\mathcal{S}}(w)-F_{\mathcal{S}}(w_{\mathcal{S}}^{*})\big)" display="inline" intent=":literal"><semantics><mrow><msup><mrow><mo stretchy="false">‖</mo><mrow><mrow><mo rspace="0.167em">∇</mo><msub><mi>F</mi><mi class="ltx_font_mathcaligraphic">𝒮</mi></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>w</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup><mo>≥</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>α</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mrow><mrow><msub><mi>F</mi><mi class="ltx_font_mathcaligraphic">𝒮</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>w</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msub><mi>F</mi><mi class="ltx_font_mathcaligraphic">𝒮</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>w</mi><mi class="ltx_font_mathcaligraphic">𝒮</mi><mo>∗</mo></msubsup><mo stretchy="false">)</mo></mrow></mrow></mrow><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\|\nabla F_{\mathcal{S}}(w)\|^{2}\geq 2\alpha\big(F_{\mathcal{S}}(w)-F_{\mathcal{S}}(w_{\mathcal{S}}^{*})\big)</annotation></semantics></math>, hence</span></p>
<table id="A3.EGx56" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A3.E101"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.E101.m1" class="ltx_Math" alttext="\displaystyle\mathbb{E}\!\left[F_{\mathcal{S}}(\overline{\bm{w}}^{(t+1)})-F_{\mathcal{S}}(\overline{\bm{w}}^{(t)})\right]" display="inline" intent=":literal"><semantics><mrow><mpadded style="width:0.497em;" width="0.497em"><mi>𝔼</mi></mpadded><mo>⁡</mo><mrow><mo>[</mo><mrow><mrow><msub><mi>F</mi><mi class="ltx_font_mathcaligraphic">𝒮</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mover accent="true"><mi>𝒘</mi><mo stretchy="true">¯</mo></mover><mrow><mo stretchy="false">(</mo><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msub><mi>F</mi><mi class="ltx_font_mathcaligraphic">𝒮</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mover accent="true"><mi>𝒘</mi><mo stretchy="true">¯</mo></mover><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>]</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\mathbb{E}\!\left[F_{\mathcal{S}}(\overline{\bm{w}}^{(t+1)})-F_{\mathcal{S}}(\overline{\bm{w}}^{(t)})\right]</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.E101.m2" class="ltx_Math" alttext="\displaystyle\leq-2\alpha\gamma_{t}\,\mathbb{E}\!\left[F_{\mathcal{S}}(\overline{\bm{w}}^{(t)})-F_{\mathcal{S}}(\bm{w}_{\mathcal{S}}^{*})\right]+\frac{GL\gamma_{t}}{m}\sum_{i=1}^{m}\mathbb{E}\!\left\|\overline{\bm{w}}^{(t)}-\bm{z}_{i}^{(t)}\right\|+\frac{LG^{2}\gamma_{t}^{2}}{2}." display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>≤</mo><mrow><mrow><mo>−</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>α</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>γ</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mpadded style="width:0.497em;" width="0.497em"><mi>𝔼</mi></mpadded><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><mrow><mrow><msub><mi>F</mi><mi class="ltx_font_mathcaligraphic">𝒮</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mover accent="true"><mi>𝒘</mi><mo stretchy="true">¯</mo></mover><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msub><mi>F</mi><mi class="ltx_font_mathcaligraphic">𝒮</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>𝒘</mi><mi class="ltx_font_mathcaligraphic">𝒮</mi><mo>∗</mo></msubsup><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>]</mo></mrow></mrow></mrow><mo>+</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mi>G</mi><mo lspace="0em" rspace="0em">​</mo><mi>L</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>γ</mi><mi>t</mi></msub></mrow><mi>m</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>m</mi></munderover></mstyle><mrow><mpadded style="width:0.497em;" width="0.497em"><mi>𝔼</mi></mpadded><mo>⁡</mo><mrow><mo>‖</mo><mrow><msup><mover accent="true"><mi>𝒘</mi><mo stretchy="true">¯</mo></mover><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo>−</mo><msubsup><mi>𝒛</mi><mi>i</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msubsup></mrow><mo>‖</mo></mrow></mrow></mrow></mrow><mo>+</mo><mstyle displaystyle="true"><mfrac><mrow><mi>L</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>G</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>γ</mi><mi>t</mi><mn>2</mn></msubsup></mrow><mn>2</mn></mfrac></mstyle></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\leq-2\alpha\gamma_{t}\,\mathbb{E}\!\left[F_{\mathcal{S}}(\overline{\bm{w}}^{(t)})-F_{\mathcal{S}}(\bm{w}_{\mathcal{S}}^{*})\right]+\frac{GL\gamma_{t}}{m}\sum_{i=1}^{m}\mathbb{E}\!\left\|\overline{\bm{w}}^{(t)}-\bm{z}_{i}^{(t)}\right\|+\frac{LG^{2}\gamma_{t}^{2}}{2}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(101)</span></td></tr></tbody>
</table>
</div>
<div id="A3.SS8.p2" class="ltx_para">
<p id="A3.SS8.p2.1" class="ltx_p"><span id="A3.SS8.p2.1.1" class="ltx_text">Now apply Lemma <a href="#Thmtheorem9" title="Lemma 9 (Consistency of Push-Sum). ‣ 3.3 Algorithm: Stochastic Gradient Push (SGP) ‣ 3 Preliminaries ‣ Stability and Generalization of Push-Sum Based Decentralized Optimization over Directed Graphs" class="ltx_ref"><span class="ltx_text ltx_ref_tag">9</span></a>,
Thus,</span></p>
<table id="A3.EGx57" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A3.Ex127"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.Ex127.m1" class="ltx_Math" alttext="\displaystyle\frac{GL\gamma_{t}}{m}\sum_{i=1}^{m}\mathbb{E}\!\left\|\overline{\bm{w}}^{(t)}-\bm{z}_{i}^{(t)}\right\|" display="inline" intent=":literal"><semantics><mrow><mstyle displaystyle="true"><mfrac><mrow><mi>G</mi><mo lspace="0em" rspace="0em">​</mo><mi>L</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>γ</mi><mi>t</mi></msub></mrow><mi>m</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>m</mi></munderover></mstyle><mrow><mpadded style="width:0.497em;" width="0.497em"><mi>𝔼</mi></mpadded><mo>⁡</mo><mrow><mo>‖</mo><mrow><msup><mover accent="true"><mi>𝒘</mi><mo stretchy="true">¯</mo></mover><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo>−</mo><msubsup><mi>𝒛</mi><mi>i</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msubsup></mrow><mo>‖</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\frac{GL\gamma_{t}}{m}\sum_{i=1}^{m}\mathbb{E}\!\left\|\overline{\bm{w}}^{(t)}-\bm{z}_{i}^{(t)}\right\|</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex127.m2" class="ltx_Math" alttext="\displaystyle\leq GL\gamma_{t}\cdot\frac{C}{\delta}\left(\lambda^{t}C_{w_{0}}+G\sum_{s=0}^{t-1}\lambda^{t-s}\gamma_{s}\right)" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≤</mo><mrow><mrow><mrow><mi>G</mi><mo lspace="0em" rspace="0em">​</mo><mi>L</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>γ</mi><mi>t</mi></msub></mrow><mo lspace="0.222em" rspace="0.222em">⋅</mo><mstyle displaystyle="true"><mfrac><mi>C</mi><mi>δ</mi></mfrac></mstyle></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mrow><msup><mi>λ</mi><mi>t</mi></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>C</mi><msub><mi>w</mi><mn>0</mn></msub></msub></mrow><mo>+</mo><mrow><mi>G</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>s</mi><mo>=</mo><mn>0</mn></mrow><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow></munderover></mstyle><mrow><msup><mi>λ</mi><mrow><mi>t</mi><mo>−</mo><mi>s</mi></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>γ</mi><mi>s</mi></msub></mrow></mrow></mrow></mrow><mo>)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\leq GL\gamma_{t}\cdot\frac{C}{\delta}\left(\lambda^{t}C_{w_{0}}+G\sum_{s=0}^{t-1}\lambda^{t-s}\gamma_{s}\right)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A3.E102"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.E102.m1" class="ltx_Math" alttext="\displaystyle=\frac{CGL\gamma_{t}\lambda^{t}C_{w_{0}}}{\delta}+\frac{CG^{2}L\gamma_{t}}{\delta}\sum_{s=0}^{t-1}\lambda^{t-s}\gamma_{s}." display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>=</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><mi>G</mi><mo lspace="0em" rspace="0em">​</mo><mi>L</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>γ</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><msup><mi>λ</mi><mi>t</mi></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>C</mi><msub><mi>w</mi><mn>0</mn></msub></msub></mrow><mi>δ</mi></mfrac></mstyle><mo>+</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>G</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mi>L</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>γ</mi><mi>t</mi></msub></mrow><mi>δ</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>s</mi><mo>=</mo><mn>0</mn></mrow><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow></munderover></mstyle><mrow><msup><mi>λ</mi><mrow><mi>t</mi><mo>−</mo><mi>s</mi></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>γ</mi><mi>s</mi></msub></mrow></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle=\frac{CGL\gamma_{t}\lambda^{t}C_{w_{0}}}{\delta}+\frac{CG^{2}L\gamma_{t}}{\delta}\sum_{s=0}^{t-1}\lambda^{t-s}\gamma_{s}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(102)</span></td></tr></tbody>
</table>
<p id="A3.SS8.p2.2" class="ltx_p"><span id="A3.SS8.p2.2.1" class="ltx_text">Assuming the stepsizes are nonincreasing, we have for <math id="A3.SS8.p2.m1" class="ltx_Math" alttext="s\leq t-1" display="inline" intent=":literal"><semantics><mrow><mi>s</mi><mo>≤</mo><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow></mrow><annotation encoding="application/x-tex">s\leq t-1</annotation></semantics></math> that <math id="A3.SS8.p2.m2" class="ltx_Math" alttext="\gamma_{s}\geq\gamma_{t}" display="inline" intent=":literal"><semantics><mrow><msub><mi>γ</mi><mi>s</mi></msub><mo>≥</mo><msub><mi>γ</mi><mi>t</mi></msub></mrow><annotation encoding="application/x-tex">\gamma_{s}\geq\gamma_{t}</annotation></semantics></math>, and hence</span></p>
<table id="A3.Ex128" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A3.Ex128.m1" class="ltx_Math" alttext="\sum_{s=0}^{t-1}\lambda^{t-s}\gamma_{s}\leq\sum_{s=0}^{t-1}\lambda^{t-s}\gamma_{t}=\gamma_{t}\sum_{k=1}^{t}\lambda^{k}\leq\frac{\gamma_{t}}{1-\lambda}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><munderover><mo movablelimits="false">∑</mo><mrow><mi>s</mi><mo>=</mo><mn>0</mn></mrow><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow></munderover><mrow><msup><mi>λ</mi><mrow><mi>t</mi><mo>−</mo><mi>s</mi></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>γ</mi><mi>s</mi></msub></mrow></mrow><mo rspace="0.111em">≤</mo><mrow><munderover><mo movablelimits="false">∑</mo><mrow><mi>s</mi><mo>=</mo><mn>0</mn></mrow><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow></munderover><mrow><msup><mi>λ</mi><mrow><mi>t</mi><mo>−</mo><mi>s</mi></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>γ</mi><mi>t</mi></msub></mrow></mrow><mo>=</mo><mrow><msub><mi>γ</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><munderover><mo movablelimits="false">∑</mo><mrow><mi>k</mi><mo>=</mo><mn>1</mn></mrow><mi>t</mi></munderover><msup><mi>λ</mi><mi>k</mi></msup></mrow></mrow><mo>≤</mo><mfrac><msub><mi>γ</mi><mi>t</mi></msub><mrow><mn>1</mn><mo>−</mo><mi>λ</mi></mrow></mfrac></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\sum_{s=0}^{t-1}\lambda^{t-s}\gamma_{s}\leq\sum_{s=0}^{t-1}\lambda^{t-s}\gamma_{t}=\gamma_{t}\sum_{k=1}^{t}\lambda^{k}\leq\frac{\gamma_{t}}{1-\lambda}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A3.SS8.p2.3" class="ltx_p"><span id="A3.SS8.p2.3.1" class="ltx_text">Substituting this into (<a href="#A3.E102" title="In Proof. ‣ C.8 Proof of Theorem ‣ Appendix C Proof of Theorem and Corollary ‣ Stability and Generalization of Push-Sum Based Decentralized Optimization over Directed Graphs" class="ltx_ref"><span class="ltx_text ltx_ref_tag">102</span></a>) and then into (<a href="#A3.E101" title="In Proof. ‣ C.8 Proof of Theorem ‣ Appendix C Proof of Theorem and Corollary ‣ Stability and Generalization of Push-Sum Based Decentralized Optimization over Directed Graphs" class="ltx_ref"><span class="ltx_text ltx_ref_tag">101</span></a>) yields</span></p>
<table id="A3.EGx58" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A3.Ex129"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.Ex129.m1" class="ltx_Math" alttext="\displaystyle\mathbb{E}\!\left[F_{\mathcal{S}}(\overline{\bm{w}}^{(t+1)})-F_{\mathcal{S}}(\overline{\bm{w}}^{(t)})\right]" display="inline" intent=":literal"><semantics><mrow><mpadded style="width:0.497em;" width="0.497em"><mi>𝔼</mi></mpadded><mo>⁡</mo><mrow><mo>[</mo><mrow><mrow><msub><mi>F</mi><mi class="ltx_font_mathcaligraphic">𝒮</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mover accent="true"><mi>𝒘</mi><mo stretchy="true">¯</mo></mover><mrow><mo stretchy="false">(</mo><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msub><mi>F</mi><mi class="ltx_font_mathcaligraphic">𝒮</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mover accent="true"><mi>𝒘</mi><mo stretchy="true">¯</mo></mover><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>]</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\mathbb{E}\!\left[F_{\mathcal{S}}(\overline{\bm{w}}^{(t+1)})-F_{\mathcal{S}}(\overline{\bm{w}}^{(t)})\right]</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex129.m2" class="ltx_Math" alttext="\displaystyle\leq-2\alpha\gamma_{t}\,\mathbb{E}\!\left[F_{\mathcal{S}}(\overline{\bm{w}}^{(t)})-F_{\mathcal{S}}(\bm{w}_{\mathcal{S}}^{*})\right]" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≤</mo><mrow><mo>−</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>α</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>γ</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mpadded style="width:0.497em;" width="0.497em"><mi>𝔼</mi></mpadded><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><mrow><mrow><msub><mi>F</mi><mi class="ltx_font_mathcaligraphic">𝒮</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mover accent="true"><mi>𝒘</mi><mo stretchy="true">¯</mo></mover><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msub><mi>F</mi><mi class="ltx_font_mathcaligraphic">𝒮</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>𝒘</mi><mi class="ltx_font_mathcaligraphic">𝒮</mi><mo>∗</mo></msubsup><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>]</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\leq-2\alpha\gamma_{t}\,\mathbb{E}\!\left[F_{\mathcal{S}}(\overline{\bm{w}}^{(t)})-F_{\mathcal{S}}(\bm{w}_{\mathcal{S}}^{*})\right]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A3.E103"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.E103.m1" class="ltx_Math" alttext="\displaystyle+\frac{CGL\gamma_{t}\lambda^{t}C_{w_{0}}}{\delta}+\frac{CG^{2}L}{\delta(1-\lambda)}\gamma_{t}^{2}+\frac{LG^{2}}{2}\gamma_{t}^{2}." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mo>+</mo><mstyle displaystyle="true"><mfrac><mrow><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><mi>G</mi><mo lspace="0em" rspace="0em">​</mo><mi>L</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>γ</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><msup><mi>λ</mi><mi>t</mi></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>C</mi><msub><mi>w</mi><mn>0</mn></msub></msub></mrow><mi>δ</mi></mfrac></mstyle></mrow><mo>+</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>G</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mi>L</mi></mrow><mrow><mi>δ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>λ</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>γ</mi><mi>t</mi><mn>2</mn></msubsup></mrow><mo>+</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mi>L</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>G</mi><mn>2</mn></msup></mrow><mn>2</mn></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>γ</mi><mi>t</mi><mn>2</mn></msubsup></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle+\frac{CGL\gamma_{t}\lambda^{t}C_{w_{0}}}{\delta}+\frac{CG^{2}L}{\delta(1-\lambda)}\gamma_{t}^{2}+\frac{LG^{2}}{2}\gamma_{t}^{2}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(103)</span></td></tr></tbody>
</table>
</div>
<div id="A3.SS8.p3" class="ltx_para">
<p id="A3.SS8.p3.1" class="ltx_p"><span id="A3.SS8.p3.1.1" class="ltx_text">Rearranging (<a href="#A3.E103" title="In Proof. ‣ C.8 Proof of Theorem ‣ Appendix C Proof of Theorem and Corollary ‣ Stability and Generalization of Push-Sum Based Decentralized Optimization over Directed Graphs" class="ltx_ref"><span class="ltx_text ltx_ref_tag">103</span></a>) gives</span></p>
<table id="A3.EGx59" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A3.Ex130"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.Ex130.m1" class="ltx_Math" alttext="\displaystyle\gamma_{t}\,\mathbb{E}\!\left[F_{\mathcal{S}}(\overline{\bm{w}}^{(t)})-F_{\mathcal{S}}(\bm{w}_{\mathcal{S}}^{*})\right]" display="inline" intent=":literal"><semantics><mrow><msub><mi>γ</mi><mi>t</mi></msub><mo lspace="0.170em" rspace="0em">​</mo><mpadded style="width:0.497em;" width="0.497em"><mi>𝔼</mi></mpadded><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><mrow><mrow><msub><mi>F</mi><mi class="ltx_font_mathcaligraphic">𝒮</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mover accent="true"><mi>𝒘</mi><mo stretchy="true">¯</mo></mover><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msub><mi>F</mi><mi class="ltx_font_mathcaligraphic">𝒮</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>𝒘</mi><mi class="ltx_font_mathcaligraphic">𝒮</mi><mo>∗</mo></msubsup><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>]</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\gamma_{t}\,\mathbb{E}\!\left[F_{\mathcal{S}}(\overline{\bm{w}}^{(t)})-F_{\mathcal{S}}(\bm{w}_{\mathcal{S}}^{*})\right]</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex130.m2" class="ltx_Math" alttext="\displaystyle\leq\frac{1}{2\alpha}\,\mathbb{E}\!\left[F_{\mathcal{S}}(\overline{\bm{w}}^{(t)})-F_{\mathcal{S}}(\overline{\bm{w}}^{(t+1)})\right]" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≤</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>α</mi></mrow></mfrac></mstyle><mo lspace="0.170em" rspace="0em">​</mo><mpadded style="width:0.497em;" width="0.497em"><mi>𝔼</mi></mpadded><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><mrow><mrow><msub><mi>F</mi><mi class="ltx_font_mathcaligraphic">𝒮</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mover accent="true"><mi>𝒘</mi><mo stretchy="true">¯</mo></mover><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msub><mi>F</mi><mi class="ltx_font_mathcaligraphic">𝒮</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mover accent="true"><mi>𝒘</mi><mo stretchy="true">¯</mo></mover><mrow><mo stretchy="false">(</mo><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>]</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\leq\frac{1}{2\alpha}\,\mathbb{E}\!\left[F_{\mathcal{S}}(\overline{\bm{w}}^{(t)})-F_{\mathcal{S}}(\overline{\bm{w}}^{(t+1)})\right]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A3.E104"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.E104.m1" class="ltx_Math" alttext="\displaystyle+\frac{CGL}{2\delta\alpha}\gamma_{t}\lambda^{t}C_{w_{0}}+\left(\frac{CG^{2}L}{2\delta\alpha(1-\lambda)}+\frac{LG^{2}}{4\alpha}\right)\gamma_{t}^{2}." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mo>+</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><mi>G</mi><mo lspace="0em" rspace="0em">​</mo><mi>L</mi></mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>δ</mi><mo lspace="0em" rspace="0em">​</mo><mi>α</mi></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msub><mi>γ</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><msup><mi>λ</mi><mi>t</mi></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>C</mi><msub><mi>w</mi><mn>0</mn></msub></msub></mrow></mrow><mo>+</mo><mrow><mrow><mo>(</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>G</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mi>L</mi></mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>δ</mi><mo lspace="0em" rspace="0em">​</mo><mi>α</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>λ</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle><mo>+</mo><mstyle displaystyle="true"><mfrac><mrow><mi>L</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>G</mi><mn>2</mn></msup></mrow><mrow><mn>4</mn><mo lspace="0em" rspace="0em">​</mo><mi>α</mi></mrow></mfrac></mstyle></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>γ</mi><mi>t</mi><mn>2</mn></msubsup></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle+\frac{CGL}{2\delta\alpha}\gamma_{t}\lambda^{t}C_{w_{0}}+\left(\frac{CG^{2}L}{2\delta\alpha(1-\lambda)}+\frac{LG^{2}}{4\alpha}\right)\gamma_{t}^{2}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(104)</span></td></tr></tbody>
</table>
<p id="A3.SS8.p3.2" class="ltx_p"><span id="A3.SS8.p3.2.1" class="ltx_text">Summing (<a href="#A3.E104" title="In Proof. ‣ C.8 Proof of Theorem ‣ Appendix C Proof of Theorem and Corollary ‣ Stability and Generalization of Push-Sum Based Decentralized Optimization over Directed Graphs" class="ltx_ref"><span class="ltx_text ltx_ref_tag">104</span></a>) over <math id="A3.SS8.p3.m1" class="ltx_Math" alttext="t=0,\dots,T-1" display="inline" intent=":literal"><semantics><mrow><mrow><mi>t</mi><mo>=</mo><mn>0</mn></mrow><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mrow><mi>T</mi><mo>−</mo><mn>1</mn></mrow></mrow><annotation encoding="application/x-tex">t=0,\dots,T-1</annotation></semantics></math> yields</span></p>
<table id="A3.EGx60" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A3.Ex131"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.Ex131.m1" class="ltx_Math" alttext="\displaystyle\sum_{t=0}^{T-1}\gamma_{t}\,\mathbb{E}\!\left[F_{\mathcal{S}}(\overline{\bm{w}}^{(t)})-F_{\mathcal{S}}(\bm{w}_{\mathcal{S}}^{*})\right]" display="inline" intent=":literal"><semantics><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>t</mi><mo>=</mo><mn>0</mn></mrow><mrow><mi>T</mi><mo>−</mo><mn>1</mn></mrow></munderover></mstyle><mrow><msub><mi>γ</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mpadded style="width:0.497em;" width="0.497em"><mi>𝔼</mi></mpadded><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><mrow><mrow><msub><mi>F</mi><mi class="ltx_font_mathcaligraphic">𝒮</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mover accent="true"><mi>𝒘</mi><mo stretchy="true">¯</mo></mover><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msub><mi>F</mi><mi class="ltx_font_mathcaligraphic">𝒮</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>𝒘</mi><mi class="ltx_font_mathcaligraphic">𝒮</mi><mo>∗</mo></msubsup><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>]</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\sum_{t=0}^{T-1}\gamma_{t}\,\mathbb{E}\!\left[F_{\mathcal{S}}(\overline{\bm{w}}^{(t)})-F_{\mathcal{S}}(\bm{w}_{\mathcal{S}}^{*})\right]</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex131.m2" class="ltx_Math" alttext="\displaystyle\leq\frac{1}{2\alpha}\,\mathbb{E}\!\left[F_{\mathcal{S}}(\overline{\bm{w}}^{(0)})-F_{\mathcal{S}}(\overline{\bm{w}}^{(T)})\right]+\frac{CGLC_{w_{0}}}{2\delta\alpha}\sum_{t=0}^{T-1}\gamma_{t}\lambda^{t}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≤</mo><mrow><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>α</mi></mrow></mfrac></mstyle><mo lspace="0.170em" rspace="0em">​</mo><mpadded style="width:0.497em;" width="0.497em"><mi>𝔼</mi></mpadded><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><mrow><mrow><msub><mi>F</mi><mi class="ltx_font_mathcaligraphic">𝒮</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mover accent="true"><mi>𝒘</mi><mo stretchy="true">¯</mo></mover><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msub><mi>F</mi><mi class="ltx_font_mathcaligraphic">𝒮</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mover accent="true"><mi>𝒘</mi><mo stretchy="true">¯</mo></mover><mrow><mo stretchy="false">(</mo><mi>T</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>]</mo></mrow></mrow><mo>+</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><mi>G</mi><mo lspace="0em" rspace="0em">​</mo><mi>L</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>C</mi><msub><mi>w</mi><mn>0</mn></msub></msub></mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>δ</mi><mo lspace="0em" rspace="0em">​</mo><mi>α</mi></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>t</mi><mo>=</mo><mn>0</mn></mrow><mrow><mi>T</mi><mo>−</mo><mn>1</mn></mrow></munderover></mstyle><mrow><msub><mi>γ</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><msup><mi>λ</mi><mi>t</mi></msup></mrow></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\leq\frac{1}{2\alpha}\,\mathbb{E}\!\left[F_{\mathcal{S}}(\overline{\bm{w}}^{(0)})-F_{\mathcal{S}}(\overline{\bm{w}}^{(T)})\right]+\frac{CGLC_{w_{0}}}{2\delta\alpha}\sum_{t=0}^{T-1}\gamma_{t}\lambda^{t}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A3.E105"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.E105.m1" class="ltx_math_unparsed" alttext="\displaystyle\quad+\left(\frac{CG^{2}L}{2\delta\alpha(1-\lambda)}+\frac{LG^{2}}{4\alpha}\right)\sum_{t=0}^{T-1}\gamma_{t}^{2}." display="inline" intent=":literal"><semantics><mrow><mo>+</mo><mrow><mo>(</mo><mstyle displaystyle="true"><mfrac><mrow><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>G</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mi>L</mi></mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>δ</mi><mo lspace="0em" rspace="0em">​</mo><mi>α</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>λ</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle><mo>+</mo><mstyle displaystyle="true"><mfrac><mrow><mi>L</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>G</mi><mn>2</mn></msup></mrow><mrow><mn>4</mn><mo lspace="0em" rspace="0em">​</mo><mi>α</mi></mrow></mfrac></mstyle><mo>)</mo></mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>t</mi><mo>=</mo><mn>0</mn></mrow><mrow><mi>T</mi><mo>−</mo><mn>1</mn></mrow></munderover></mstyle><msubsup><mi>γ</mi><mi>t</mi><mn>2</mn></msubsup><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\quad+\left(\frac{CG^{2}L}{2\delta\alpha(1-\lambda)}+\frac{LG^{2}}{4\alpha}\right)\sum_{t=0}^{T-1}\gamma_{t}^{2}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(105)</span></td></tr></tbody>
</table>
<p id="A3.SS8.p3.3" class="ltx_p"><span id="A3.SS8.p3.3.1" class="ltx_text">Using the Lipschitz conditionto upper bound the initial function gap,</span></p>
<table id="A3.Ex132" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A3.Ex132.m1" class="ltx_Math" alttext="\mathbb{E}\!\left[F_{\mathcal{S}}(\overline{\bm{w}}^{(0)})-F_{\mathcal{S}}(\overline{\bm{w}}^{(T)})\right]\leq\mathbb{E}\!\left[F_{\mathcal{S}}(\overline{\bm{w}}^{(0)})-F_{\mathcal{S}}(\bm{w}_{\mathcal{S}}^{*})\right]\leq Gr," display="block" intent=":literal"><semantics><mrow><mrow><mrow><mpadded style="width:0.497em;" width="0.497em"><mi>𝔼</mi></mpadded><mo>⁡</mo><mrow><mo>[</mo><mrow><mrow><msub><mi>F</mi><mi class="ltx_font_mathcaligraphic">𝒮</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mover accent="true"><mi>𝒘</mi><mo stretchy="true">¯</mo></mover><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msub><mi>F</mi><mi class="ltx_font_mathcaligraphic">𝒮</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mover accent="true"><mi>𝒘</mi><mo stretchy="true">¯</mo></mover><mrow><mo stretchy="false">(</mo><mi>T</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>]</mo></mrow></mrow><mo>≤</mo><mrow><mpadded style="width:0.497em;" width="0.497em"><mi>𝔼</mi></mpadded><mo>⁡</mo><mrow><mo>[</mo><mrow><mrow><msub><mi>F</mi><mi class="ltx_font_mathcaligraphic">𝒮</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mover accent="true"><mi>𝒘</mi><mo stretchy="true">¯</mo></mover><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msub><mi>F</mi><mi class="ltx_font_mathcaligraphic">𝒮</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>𝒘</mi><mi class="ltx_font_mathcaligraphic">𝒮</mi><mo>∗</mo></msubsup><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>]</mo></mrow></mrow><mo>≤</mo><mrow><mi>G</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\mathbb{E}\!\left[F_{\mathcal{S}}(\overline{\bm{w}}^{(0)})-F_{\mathcal{S}}(\overline{\bm{w}}^{(T)})\right]\leq\mathbb{E}\!\left[F_{\mathcal{S}}(\overline{\bm{w}}^{(0)})-F_{\mathcal{S}}(\bm{w}_{\mathcal{S}}^{*})\right]\leq Gr,</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A3.SS8.p3.4" class="ltx_p"><span id="A3.SS8.p3.4.1" class="ltx_text">and dividing (<a href="#A3.E105" title="In Proof. ‣ C.8 Proof of Theorem ‣ Appendix C Proof of Theorem and Corollary ‣ Stability and Generalization of Push-Sum Based Decentralized Optimization over Directed Graphs" class="ltx_ref"><span class="ltx_text ltx_ref_tag">105</span></a>) by <math id="A3.SS8.p3.m2" class="ltx_Math" alttext="\sum_{t=0}^{T-1}\gamma_{t}" display="inline" intent=":literal"><semantics><mrow><msubsup><mo>∑</mo><mrow><mi>t</mi><mo>=</mo><mn>0</mn></mrow><mrow><mi>T</mi><mo>−</mo><mn>1</mn></mrow></msubsup><msub><mi>γ</mi><mi>t</mi></msub></mrow><annotation encoding="application/x-tex">\sum_{t=0}^{T-1}\gamma_{t}</annotation></semantics></math> gives</span></p>
<table id="A3.EGx61" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A3.Ex133"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.Ex133.m1" class="ltx_Math" alttext="\displaystyle\epsilon_{\mathrm{opt}}" display="inline" intent=":literal"><semantics><msub><mi>ϵ</mi><mi>opt</mi></msub><annotation encoding="application/x-tex">\displaystyle\epsilon_{\mathrm{opt}}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex133.m2" class="ltx_Math" alttext="\displaystyle=\frac{\sum_{t=0}^{T-1}\gamma_{t}\,\mathbb{E}\!\left[F_{\mathcal{S}}(\overline{\bm{w}}^{(t)})-F_{\mathcal{S}}(\bm{w}_{\mathcal{S}}^{*})\right]}{\sum_{t=0}^{T-1}\gamma_{t}}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mstyle displaystyle="true"><mfrac><mrow><msubsup><mo>∑</mo><mrow><mi>t</mi><mo>=</mo><mn>0</mn></mrow><mrow><mi>T</mi><mo>−</mo><mn>1</mn></mrow></msubsup><mrow><msub><mi>γ</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mpadded style="width:0.497em;" width="0.497em"><mi>𝔼</mi></mpadded><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><mrow><mrow><msub><mi>F</mi><mi class="ltx_font_mathcaligraphic">𝒮</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mover accent="true"><mi>𝒘</mi><mo stretchy="true">¯</mo></mover><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msub><mi>F</mi><mi class="ltx_font_mathcaligraphic">𝒮</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>𝒘</mi><mi class="ltx_font_mathcaligraphic">𝒮</mi><mo>∗</mo></msubsup><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>]</mo></mrow></mrow></mrow><mrow><msubsup><mo>∑</mo><mrow><mi>t</mi><mo>=</mo><mn>0</mn></mrow><mrow><mi>T</mi><mo>−</mo><mn>1</mn></mrow></msubsup><msub><mi>γ</mi><mi>t</mi></msub></mrow></mfrac></mstyle></mrow><annotation encoding="application/x-tex">\displaystyle=\frac{\sum_{t=0}^{T-1}\gamma_{t}\,\mathbb{E}\!\left[F_{\mathcal{S}}(\overline{\bm{w}}^{(t)})-F_{\mathcal{S}}(\bm{w}_{\mathcal{S}}^{*})\right]}{\sum_{t=0}^{T-1}\gamma_{t}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A3.E106"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.E106.m1" class="ltx_Math" alttext="\displaystyle\leq\frac{Gr}{\alpha\sum_{t=0}^{T-1}\gamma_{t}}+\frac{CGLC_{w_{0}}}{2\delta\alpha\,\sum_{t=0}^{T-1}\gamma_{t}}\sum_{t=0}^{T-1}\gamma_{t}\lambda^{t}+\left(\frac{CG^{2}L}{2\delta\alpha(1-\lambda)}+\frac{LG^{2}}{4\alpha}\right)\frac{\sum_{t=0}^{T-1}\gamma_{t}^{2}}{\sum_{t=0}^{T-1}\gamma_{t}}." display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>≤</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mi>G</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi></mrow><mrow><mi>α</mi><mo lspace="0em" rspace="0em">​</mo><mrow><msubsup><mo>∑</mo><mrow><mi>t</mi><mo>=</mo><mn>0</mn></mrow><mrow><mi>T</mi><mo>−</mo><mn>1</mn></mrow></msubsup><msub><mi>γ</mi><mi>t</mi></msub></mrow></mrow></mfrac></mstyle><mo>+</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><mi>G</mi><mo lspace="0em" rspace="0em">​</mo><mi>L</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>C</mi><msub><mi>w</mi><mn>0</mn></msub></msub></mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>δ</mi><mo lspace="0em" rspace="0em">​</mo><mi>α</mi><mo lspace="0.337em" rspace="0em">​</mo><mrow><msubsup><mo>∑</mo><mrow><mi>t</mi><mo>=</mo><mn>0</mn></mrow><mrow><mi>T</mi><mo>−</mo><mn>1</mn></mrow></msubsup><msub><mi>γ</mi><mi>t</mi></msub></mrow></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>t</mi><mo>=</mo><mn>0</mn></mrow><mrow><mi>T</mi><mo>−</mo><mn>1</mn></mrow></munderover></mstyle><mrow><msub><mi>γ</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><msup><mi>λ</mi><mi>t</mi></msup></mrow></mrow></mrow><mo>+</mo><mrow><mrow><mo>(</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>G</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mi>L</mi></mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>δ</mi><mo lspace="0em" rspace="0em">​</mo><mi>α</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>λ</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle><mo>+</mo><mstyle displaystyle="true"><mfrac><mrow><mi>L</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>G</mi><mn>2</mn></msup></mrow><mrow><mn>4</mn><mo lspace="0em" rspace="0em">​</mo><mi>α</mi></mrow></mfrac></mstyle></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><mrow><msubsup><mo>∑</mo><mrow><mi>t</mi><mo>=</mo><mn>0</mn></mrow><mrow><mi>T</mi><mo>−</mo><mn>1</mn></mrow></msubsup><msubsup><mi>γ</mi><mi>t</mi><mn>2</mn></msubsup></mrow><mrow><msubsup><mo>∑</mo><mrow><mi>t</mi><mo>=</mo><mn>0</mn></mrow><mrow><mi>T</mi><mo>−</mo><mn>1</mn></mrow></msubsup><msub><mi>γ</mi><mi>t</mi></msub></mrow></mfrac></mstyle></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\leq\frac{Gr}{\alpha\sum_{t=0}^{T-1}\gamma_{t}}+\frac{CGLC_{w_{0}}}{2\delta\alpha\,\sum_{t=0}^{T-1}\gamma_{t}}\sum_{t=0}^{T-1}\gamma_{t}\lambda^{t}+\left(\frac{CG^{2}L}{2\delta\alpha(1-\lambda)}+\frac{LG^{2}}{4\alpha}\right)\frac{\sum_{t=0}^{T-1}\gamma_{t}^{2}}{\sum_{t=0}^{T-1}\gamma_{t}}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(106)</span></td></tr></tbody>
</table>
<p id="A3.SS8.p3.5" class="ltx_p"><span id="A3.SS8.p3.5.1" class="ltx_text">Finally, letting <math id="A3.SS8.p3.m3" class="ltx_Math" alttext="\kappa:=L/\alpha" display="inline" intent=":literal"><semantics><mrow><mi>κ</mi><mo>:=</mo><mrow><mi>L</mi><mo>/</mo><mi>α</mi></mrow></mrow><annotation encoding="application/x-tex">\kappa:=L/\alpha</annotation></semantics></math> completes the proof.
∎</span></p>
</div>
</div>
</section>
<section id="A3.SS9" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">C.9 </span>Proof of Corollary <a href="#Thmtheorem38" title="Corollary 38 (Optimization Error on Common Learning Rate). ‣ 4.3 Results on Non-convex Case ‣ 4 Theoretical Analysis ‣ Stability and Generalization of Push-Sum Based Decentralized Optimization over Directed Graphs" class="ltx_ref"><span class="ltx_text ltx_ref_tag">38</span></a></h3>

<div id="A3.SS9.2" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
</div>
<section id="A3.SS9.SSS0.Px1" class="ltx_paragraph">
<h4 class="ltx_title ltx_title_paragraph">Case 1: Constant Learning Rate.</h4>

<div id="A3.SS9.SSS0.Px1.p1" class="ltx_para">
<p id="A3.SS9.SSS0.Px1.p1.1" class="ltx_p">For the case of constant learning rate where <math id="A3.SS9.SSS0.Px1.p1.m1" class="ltx_Math" alttext="\gamma_{t}=\gamma" display="inline" intent=":literal"><semantics><mrow><msub><mi>γ</mi><mi>t</mi></msub><mo>=</mo><mi>γ</mi></mrow><annotation encoding="application/x-tex">\gamma_{t}=\gamma</annotation></semantics></math> for all <math id="A3.SS9.SSS0.Px1.p1.m2" class="ltx_Math" alttext="t" display="inline" intent=":literal"><semantics><mi>t</mi><annotation encoding="application/x-tex">t</annotation></semantics></math>,
the optimization error bound in Theorem <a href="#Thmtheorem37" title="Theorem 37 (Optimization Error). ‣ 4.3 Results on Non-convex Case ‣ 4 Theoretical Analysis ‣ Stability and Generalization of Push-Sum Based Decentralized Optimization over Directed Graphs" class="ltx_ref"><span class="ltx_text ltx_ref_tag">37</span></a> becomes</p>
<table id="A3.EGx62" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A3.Ex134"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.Ex134.m1" class="ltx_Math" alttext="\displaystyle\epsilon_{\mathrm{opt}}" display="inline" intent=":literal"><semantics><msub><mi>ϵ</mi><mi>opt</mi></msub><annotation encoding="application/x-tex">\displaystyle\epsilon_{\mathrm{opt}}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex134.m2" class="ltx_Math" alttext="\displaystyle\leq\frac{Gr}{\alpha\sum_{t=0}^{T-1}\gamma}+\frac{CG\kappa C_{w_{0}}}{2\delta\sum_{t=0}^{T-1}\gamma}\sum_{t=0}^{T-1}\gamma{\lambda}^{t}+\left(\frac{CG^{2}\kappa}{2\delta(1-{\lambda})}+\frac{G^{2}\kappa}{4}\right)\frac{\sum_{t=0}^{T-1}\gamma^{2}}{\sum_{t=0}^{T-1}\gamma}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≤</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mi>G</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi></mrow><mrow><mi>α</mi><mo lspace="0em" rspace="0em">​</mo><mrow><msubsup><mo>∑</mo><mrow><mi>t</mi><mo>=</mo><mn>0</mn></mrow><mrow><mi>T</mi><mo>−</mo><mn>1</mn></mrow></msubsup><mi>γ</mi></mrow></mrow></mfrac></mstyle><mo>+</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><mi>G</mi><mo lspace="0em" rspace="0em">​</mo><mi>κ</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>C</mi><msub><mi>w</mi><mn>0</mn></msub></msub></mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>δ</mi><mo lspace="0em" rspace="0em">​</mo><mrow><msubsup><mo>∑</mo><mrow><mi>t</mi><mo>=</mo><mn>0</mn></mrow><mrow><mi>T</mi><mo>−</mo><mn>1</mn></mrow></msubsup><mi>γ</mi></mrow></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>t</mi><mo>=</mo><mn>0</mn></mrow><mrow><mi>T</mi><mo>−</mo><mn>1</mn></mrow></munderover></mstyle><mrow><mi>γ</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>λ</mi><mi>t</mi></msup></mrow></mrow></mrow><mo>+</mo><mrow><mrow><mo>(</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>G</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mi>κ</mi></mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>δ</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>λ</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle><mo>+</mo><mstyle displaystyle="true"><mfrac><mrow><msup><mi>G</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mi>κ</mi></mrow><mn>4</mn></mfrac></mstyle></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><mrow><msubsup><mo>∑</mo><mrow><mi>t</mi><mo>=</mo><mn>0</mn></mrow><mrow><mi>T</mi><mo>−</mo><mn>1</mn></mrow></msubsup><msup><mi>γ</mi><mn>2</mn></msup></mrow><mrow><msubsup><mo>∑</mo><mrow><mi>t</mi><mo>=</mo><mn>0</mn></mrow><mrow><mi>T</mi><mo>−</mo><mn>1</mn></mrow></msubsup><mi>γ</mi></mrow></mfrac></mstyle></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\leq\frac{Gr}{\alpha\sum_{t=0}^{T-1}\gamma}+\frac{CG\kappa C_{w_{0}}}{2\delta\sum_{t=0}^{T-1}\gamma}\sum_{t=0}^{T-1}\gamma{\lambda}^{t}+\left(\frac{CG^{2}\kappa}{2\delta(1-{\lambda})}+\frac{G^{2}\kappa}{4}\right)\frac{\sum_{t=0}^{T-1}\gamma^{2}}{\sum_{t=0}^{T-1}\gamma}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A3.Ex135"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex135.m1" class="ltx_Math" alttext="\displaystyle=\frac{Gr}{T\alpha\gamma}+\frac{CG\kappa C_{w_{0}}}{2\delta T\gamma}\sum_{t=0}^{T-1}\gamma{\lambda}^{t}+\left(\frac{CG^{2}\kappa}{2\delta(1-{\lambda})}+\frac{G^{2}\kappa}{4}\right)\gamma" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mi>G</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi></mrow><mrow><mi>T</mi><mo lspace="0em" rspace="0em">​</mo><mi>α</mi><mo lspace="0em" rspace="0em">​</mo><mi>γ</mi></mrow></mfrac></mstyle><mo>+</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><mi>G</mi><mo lspace="0em" rspace="0em">​</mo><mi>κ</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>C</mi><msub><mi>w</mi><mn>0</mn></msub></msub></mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>δ</mi><mo lspace="0em" rspace="0em">​</mo><mi>T</mi><mo lspace="0em" rspace="0em">​</mo><mi>γ</mi></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>t</mi><mo>=</mo><mn>0</mn></mrow><mrow><mi>T</mi><mo>−</mo><mn>1</mn></mrow></munderover></mstyle><mrow><mi>γ</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>λ</mi><mi>t</mi></msup></mrow></mrow></mrow><mo>+</mo><mrow><mrow><mo>(</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>G</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mi>κ</mi></mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>δ</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>λ</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle><mo>+</mo><mstyle displaystyle="true"><mfrac><mrow><msup><mi>G</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mi>κ</mi></mrow><mn>4</mn></mfrac></mstyle></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>γ</mi></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\frac{Gr}{T\alpha\gamma}+\frac{CG\kappa C_{w_{0}}}{2\delta T\gamma}\sum_{t=0}^{T-1}\gamma{\lambda}^{t}+\left(\frac{CG^{2}\kappa}{2\delta(1-{\lambda})}+\frac{G^{2}\kappa}{4}\right)\gamma</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A3.Ex136"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex136.m1" class="ltx_Math" alttext="\displaystyle=\frac{Gr}{T\alpha\gamma}+\frac{CG\kappa C_{w_{0}}}{2\delta T}\sum_{t=0}^{T-1}{\lambda}^{t}+\left(\frac{CG^{2}\kappa}{2\delta(1-{\lambda})}+\frac{G^{2}\kappa}{4}\right)\gamma" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mi>G</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi></mrow><mrow><mi>T</mi><mo lspace="0em" rspace="0em">​</mo><mi>α</mi><mo lspace="0em" rspace="0em">​</mo><mi>γ</mi></mrow></mfrac></mstyle><mo>+</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><mi>G</mi><mo lspace="0em" rspace="0em">​</mo><mi>κ</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>C</mi><msub><mi>w</mi><mn>0</mn></msub></msub></mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>δ</mi><mo lspace="0em" rspace="0em">​</mo><mi>T</mi></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>t</mi><mo>=</mo><mn>0</mn></mrow><mrow><mi>T</mi><mo>−</mo><mn>1</mn></mrow></munderover></mstyle><msup><mi>λ</mi><mi>t</mi></msup></mrow></mrow><mo>+</mo><mrow><mrow><mo>(</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>G</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mi>κ</mi></mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>δ</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>λ</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle><mo>+</mo><mstyle displaystyle="true"><mfrac><mrow><msup><mi>G</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mi>κ</mi></mrow><mn>4</mn></mfrac></mstyle></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>γ</mi></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\frac{Gr}{T\alpha\gamma}+\frac{CG\kappa C_{w_{0}}}{2\delta T}\sum_{t=0}^{T-1}{\lambda}^{t}+\left(\frac{CG^{2}\kappa}{2\delta(1-{\lambda})}+\frac{G^{2}\kappa}{4}\right)\gamma</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A3.E107"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.E107.m1" class="ltx_Math" alttext="\displaystyle\overset{(a)}{\leq}\left(\frac{Gr}{\alpha\gamma}+\frac{CG\kappa C_{w_{0}}}{2\delta(1-{\lambda})}\right)\frac{1}{T}+\left(\frac{CG^{2}\kappa}{2\delta(1-{\lambda})}+\frac{G^{2}\kappa}{4}\right)\gamma." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mover accent="true"><mo>≤</mo><mrow><mo maxsize="0.700em" minsize="0.700em">(</mo><mi mathsize="0.700em">a</mi><mo maxsize="0.700em" minsize="0.700em">)</mo></mrow></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mi>G</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi></mrow><mrow><mi>α</mi><mo lspace="0em" rspace="0em">​</mo><mi>γ</mi></mrow></mfrac></mstyle><mo>+</mo><mstyle displaystyle="true"><mfrac><mrow><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><mi>G</mi><mo lspace="0em" rspace="0em">​</mo><mi>κ</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>C</mi><msub><mi>w</mi><mn>0</mn></msub></msub></mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>δ</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>λ</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>T</mi></mfrac></mstyle></mrow><mo>+</mo><mrow><mrow><mo>(</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>G</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mi>κ</mi></mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>δ</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>λ</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle><mo>+</mo><mstyle displaystyle="true"><mfrac><mrow><msup><mi>G</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mi>κ</mi></mrow><mn>4</mn></mfrac></mstyle></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>γ</mi></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\overset{(a)}{\leq}\left(\frac{Gr}{\alpha\gamma}+\frac{CG\kappa C_{w_{0}}}{2\delta(1-{\lambda})}\right)\frac{1}{T}+\left(\frac{CG^{2}\kappa}{2\delta(1-{\lambda})}+\frac{G^{2}\kappa}{4}\right)\gamma.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(107)</span></td></tr></tbody>
</table>
</div>
</section>
<section id="A3.SS9.SSS0.Px2" class="ltx_paragraph">
<h4 class="ltx_title ltx_title_paragraph">Case 2: Decreasing Learning Rate.</h4>

<div id="A3.SS9.SSS0.Px2.p1" class="ltx_para">
<p id="A3.SS9.SSS0.Px2.p1.1" class="ltx_p">For the case of decreasing learning rates, i.e. , <math id="A3.SS9.SSS0.Px2.p1.m1" class="ltx_Math" alttext="\gamma_{t}=\frac{v}{t+1}" display="inline" intent=":literal"><semantics><mrow><msub><mi>γ</mi><mi>t</mi></msub><mo>=</mo><mfrac><mi>v</mi><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow></mfrac></mrow><annotation encoding="application/x-tex">\gamma_{t}=\frac{v}{t+1}</annotation></semantics></math>,
we again start from the bound in Theorem <a href="#Thmtheorem37" title="Theorem 37 (Optimization Error). ‣ 4.3 Results on Non-convex Case ‣ 4 Theoretical Analysis ‣ Stability and Generalization of Push-Sum Based Decentralized Optimization over Directed Graphs" class="ltx_ref"><span class="ltx_text ltx_ref_tag">37</span></a>:</p>
<table id="A3.EGx63" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A3.Ex137"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.Ex137.m1" class="ltx_Math" alttext="\displaystyle\epsilon_{\mathrm{opt}}" display="inline" intent=":literal"><semantics><msub><mi>ϵ</mi><mi>opt</mi></msub><annotation encoding="application/x-tex">\displaystyle\epsilon_{\mathrm{opt}}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex137.m2" class="ltx_Math" alttext="\displaystyle\leq\frac{Gr}{\alpha\sum_{t=0}^{T-1}\frac{v}{t+1}}+\frac{CG\kappa C_{w_{0}}}{2\delta\sum_{t=0}^{T-1}\frac{v}{t+1}}\sum_{t=0}^{T-1}\frac{v}{t+1}{\lambda}^{t}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≤</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mi>G</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi></mrow><mrow><mi>α</mi><mo lspace="0em" rspace="0em">​</mo><mrow><msubsup><mo>∑</mo><mrow><mi>t</mi><mo>=</mo><mn>0</mn></mrow><mrow><mi>T</mi><mo>−</mo><mn>1</mn></mrow></msubsup><mfrac><mi>v</mi><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow></mfrac></mrow></mrow></mfrac></mstyle><mo>+</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><mi>G</mi><mo lspace="0em" rspace="0em">​</mo><mi>κ</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>C</mi><msub><mi>w</mi><mn>0</mn></msub></msub></mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>δ</mi><mo lspace="0em" rspace="0em">​</mo><mrow><msubsup><mo>∑</mo><mrow><mi>t</mi><mo>=</mo><mn>0</mn></mrow><mrow><mi>T</mi><mo>−</mo><mn>1</mn></mrow></msubsup><mfrac><mi>v</mi><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow></mfrac></mrow></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>t</mi><mo>=</mo><mn>0</mn></mrow><mrow><mi>T</mi><mo>−</mo><mn>1</mn></mrow></munderover></mstyle><mrow><mstyle displaystyle="true"><mfrac><mi>v</mi><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msup><mi>λ</mi><mi>t</mi></msup></mrow></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\leq\frac{Gr}{\alpha\sum_{t=0}^{T-1}\frac{v}{t+1}}+\frac{CG\kappa C_{w_{0}}}{2\delta\sum_{t=0}^{T-1}\frac{v}{t+1}}\sum_{t=0}^{T-1}\frac{v}{t+1}{\lambda}^{t}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A3.Ex138"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex138.m1" class="ltx_Math" alttext="\displaystyle\quad+\left(\frac{CG^{2}\kappa}{2\delta(1-{\lambda})}+\frac{G^{2}\kappa}{4}\right)\frac{\sum_{t=0}^{T-1}\big(\frac{v}{t+1}\big)^{2}}{\sum_{t=0}^{T-1}\frac{v}{t+1}}" display="inline" intent=":literal"><semantics><mrow><mo>+</mo><mrow><mrow><mo>(</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>G</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mi>κ</mi></mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>δ</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>λ</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle><mo>+</mo><mstyle displaystyle="true"><mfrac><mrow><msup><mi>G</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mi>κ</mi></mrow><mn>4</mn></mfrac></mstyle></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><mrow><msubsup><mo>∑</mo><mrow><mi>t</mi><mo>=</mo><mn>0</mn></mrow><mrow><mi>T</mi><mo>−</mo><mn>1</mn></mrow></msubsup><msup><mrow><mo lspace="0em" maxsize="1.200em" minsize="1.200em">(</mo><mfrac><mi>v</mi><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow></mfrac><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow><mn>2</mn></msup></mrow><mrow><msubsup><mo>∑</mo><mrow><mi>t</mi><mo>=</mo><mn>0</mn></mrow><mrow><mi>T</mi><mo>−</mo><mn>1</mn></mrow></msubsup><mfrac><mi>v</mi><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow></mfrac></mrow></mfrac></mstyle></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\quad+\left(\frac{CG^{2}\kappa}{2\delta(1-{\lambda})}+\frac{G^{2}\kappa}{4}\right)\frac{\sum_{t=0}^{T-1}\big(\frac{v}{t+1}\big)^{2}}{\sum_{t=0}^{T-1}\frac{v}{t+1}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A3.Ex139"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex139.m1" class="ltx_Math" alttext="\displaystyle=\frac{Gr}{\alpha v\sum_{t=0}^{T-1}\frac{1}{t+1}}+\frac{CG\kappa C_{w_{0}}}{2\delta v\sum_{t=0}^{T-1}\frac{1}{t+1}}\sum_{t=0}^{T-1}\frac{v}{t+1}{\lambda}^{t}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mi>G</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi></mrow><mrow><mi>α</mi><mo lspace="0em" rspace="0em">​</mo><mi>v</mi><mo lspace="0em" rspace="0em">​</mo><mrow><msubsup><mo>∑</mo><mrow><mi>t</mi><mo>=</mo><mn>0</mn></mrow><mrow><mi>T</mi><mo>−</mo><mn>1</mn></mrow></msubsup><mfrac><mn>1</mn><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow></mfrac></mrow></mrow></mfrac></mstyle><mo>+</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><mi>G</mi><mo lspace="0em" rspace="0em">​</mo><mi>κ</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>C</mi><msub><mi>w</mi><mn>0</mn></msub></msub></mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>δ</mi><mo lspace="0em" rspace="0em">​</mo><mi>v</mi><mo lspace="0em" rspace="0em">​</mo><mrow><msubsup><mo>∑</mo><mrow><mi>t</mi><mo>=</mo><mn>0</mn></mrow><mrow><mi>T</mi><mo>−</mo><mn>1</mn></mrow></msubsup><mfrac><mn>1</mn><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow></mfrac></mrow></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>t</mi><mo>=</mo><mn>0</mn></mrow><mrow><mi>T</mi><mo>−</mo><mn>1</mn></mrow></munderover></mstyle><mrow><mstyle displaystyle="true"><mfrac><mi>v</mi><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msup><mi>λ</mi><mi>t</mi></msup></mrow></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\frac{Gr}{\alpha v\sum_{t=0}^{T-1}\frac{1}{t+1}}+\frac{CG\kappa C_{w_{0}}}{2\delta v\sum_{t=0}^{T-1}\frac{1}{t+1}}\sum_{t=0}^{T-1}\frac{v}{t+1}{\lambda}^{t}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A3.Ex140"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex140.m1" class="ltx_Math" alttext="\displaystyle\quad+\left(\frac{CG^{2}\kappa}{2\delta(1-{\lambda})}+\frac{G^{2}\kappa}{4}\right)v\frac{\sum_{t=0}^{T-1}\frac{1}{(t+1)^{2}}}{\sum_{t=0}^{T-1}\frac{1}{t+1}}." display="inline" intent=":literal"><semantics><mrow><mrow><mo>+</mo><mrow><mrow><mo>(</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>G</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mi>κ</mi></mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>δ</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>λ</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle><mo>+</mo><mstyle displaystyle="true"><mfrac><mrow><msup><mi>G</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mi>κ</mi></mrow><mn>4</mn></mfrac></mstyle></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>v</mi><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><mrow><msubsup><mo>∑</mo><mrow><mi>t</mi><mo>=</mo><mn>0</mn></mrow><mrow><mi>T</mi><mo>−</mo><mn>1</mn></mrow></msubsup><mfrac><mn>1</mn><msup><mrow><mo stretchy="false">(</mo><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mfrac></mrow><mrow><msubsup><mo>∑</mo><mrow><mi>t</mi><mo>=</mo><mn>0</mn></mrow><mrow><mi>T</mi><mo>−</mo><mn>1</mn></mrow></msubsup><mfrac><mn>1</mn><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow></mfrac></mrow></mfrac></mstyle></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\quad+\left(\frac{CG^{2}\kappa}{2\delta(1-{\lambda})}+\frac{G^{2}\kappa}{4}\right)v\frac{\sum_{t=0}^{T-1}\frac{1}{(t+1)^{2}}}{\sum_{t=0}^{T-1}\frac{1}{t+1}}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A3.SS9.SSS0.Px2.p1.2" class="ltx_p">Using the standard lower bound for the harmonic series, there exists a constant
<math id="A3.SS9.SSS0.Px2.p1.m2" class="ltx_Math" alttext="T_{0}" display="inline" intent=":literal"><semantics><msub><mi>T</mi><mn>0</mn></msub><annotation encoding="application/x-tex">T_{0}</annotation></semantics></math> such that for all <math id="A3.SS9.SSS0.Px2.p1.m3" class="ltx_Math" alttext="T\geq T_{0}" display="inline" intent=":literal"><semantics><mrow><mi>T</mi><mo>≥</mo><msub><mi>T</mi><mn>0</mn></msub></mrow><annotation encoding="application/x-tex">T\geq T_{0}</annotation></semantics></math>,</p>
<table id="A3.Ex141" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A3.Ex141.m1" class="ltx_Math" alttext="\sum_{t=0}^{T-1}\frac{1}{t+1}\ \geq\ \frac{1}{2}\ln T,\qquad\text{thus}\qquad\frac{1}{\sum_{t=0}^{T-1}\frac{1}{t+1}}\ \leq\ \frac{2}{\ln T}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mrow><munderover><mo movablelimits="false">∑</mo><mrow><mi>t</mi><mo>=</mo><mn>0</mn></mrow><mrow><mi>T</mi><mo>−</mo><mn>1</mn></mrow></munderover><mfrac><mn>1</mn><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow></mfrac></mrow><mo lspace="0.778em" rspace="0.778em">≥</mo><mrow><mfrac><mn>1</mn><mn>2</mn></mfrac><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>ln</mi><mo lspace="0.167em">⁡</mo><mi>T</mi></mrow></mrow></mrow><mo rspace="2.167em">,</mo><mtext>thus</mtext><mspace style="width:2em;" width="2em"></mspace><mrow><mfrac><mn>1</mn><mrow><msubsup><mo>∑</mo><mrow><mi>t</mi><mo>=</mo><mn>0</mn></mrow><mrow><mi>T</mi><mo>−</mo><mn>1</mn></mrow></msubsup><mfrac><mn>1</mn><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow></mfrac></mrow></mfrac><mo lspace="0.778em" rspace="0.778em">≤</mo><mfrac><mn>2</mn><mrow><mi>ln</mi><mo lspace="0.167em">⁡</mo><mi>T</mi></mrow></mfrac></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\sum_{t=0}^{T-1}\frac{1}{t+1}\ \geq\ \frac{1}{2}\ln T,\qquad\text{thus}\qquad\frac{1}{\sum_{t=0}^{T-1}\frac{1}{t+1}}\ \leq\ \frac{2}{\ln T}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A3.SS9.SSS0.Px2.p1.3" class="ltx_p">Applying this to the first two terms and absorbing constants into the third term, we obtain</p>
<table id="A3.EGx64" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A3.Ex142"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.Ex142.m1" class="ltx_Math" alttext="\displaystyle\epsilon_{\mathrm{opt}}" display="inline" intent=":literal"><semantics><msub><mi>ϵ</mi><mi>opt</mi></msub><annotation encoding="application/x-tex">\displaystyle\epsilon_{\mathrm{opt}}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex142.m2" class="ltx_Math" alttext="\displaystyle\overset{(e)}{\leq}\frac{2Gr}{v\alpha\ln{T}}+\frac{CG\kappa C_{w_{0}}}{\delta\ln{T}}\sum_{t=0}^{T-1}\frac{{\lambda}^{t}}{t+1}+\left(\frac{CG^{2}\kappa}{\delta(1-{\lambda})}+\frac{G^{2}\kappa}{2}\right)\frac{v\sum_{t=0}^{T-1}\frac{1}{(t+1)^{2}}}{\ln{T}}" display="inline" intent=":literal"><semantics><mrow><mrow><mover accent="true"><mo>≤</mo><mrow><mo maxsize="0.700em" minsize="0.700em">(</mo><mi mathsize="0.700em">e</mi><mo maxsize="0.700em" minsize="0.700em">)</mo></mrow></mover><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>G</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi></mrow><mrow><mi>v</mi><mo lspace="0em" rspace="0em">​</mo><mi>α</mi><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>ln</mi><mo lspace="0.167em">⁡</mo><mi>T</mi></mrow></mrow></mfrac></mstyle></mrow><mo>+</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><mi>G</mi><mo lspace="0em" rspace="0em">​</mo><mi>κ</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>C</mi><msub><mi>w</mi><mn>0</mn></msub></msub></mrow><mrow><mi>δ</mi><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>ln</mi><mo lspace="0.167em">⁡</mo><mi>T</mi></mrow></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>t</mi><mo>=</mo><mn>0</mn></mrow><mrow><mi>T</mi><mo>−</mo><mn>1</mn></mrow></munderover></mstyle><mstyle displaystyle="true"><mfrac><msup><mi>λ</mi><mi>t</mi></msup><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow></mfrac></mstyle></mrow></mrow><mo>+</mo><mrow><mrow><mo>(</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>G</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mi>κ</mi></mrow><mrow><mi>δ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>λ</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle><mo>+</mo><mstyle displaystyle="true"><mfrac><mrow><msup><mi>G</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mi>κ</mi></mrow><mn>2</mn></mfrac></mstyle></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><mrow><mi>v</mi><mo lspace="0em" rspace="0em">​</mo><mrow><msubsup><mo>∑</mo><mrow><mi>t</mi><mo>=</mo><mn>0</mn></mrow><mrow><mi>T</mi><mo>−</mo><mn>1</mn></mrow></msubsup><mfrac><mn>1</mn><msup><mrow><mo stretchy="false">(</mo><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mfrac></mrow></mrow><mrow><mi>ln</mi><mo lspace="0.167em">⁡</mo><mi>T</mi></mrow></mfrac></mstyle></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\overset{(e)}{\leq}\frac{2Gr}{v\alpha\ln{T}}+\frac{CG\kappa C_{w_{0}}}{\delta\ln{T}}\sum_{t=0}^{T-1}\frac{{\lambda}^{t}}{t+1}+\left(\frac{CG^{2}\kappa}{\delta(1-{\lambda})}+\frac{G^{2}\kappa}{2}\right)\frac{v\sum_{t=0}^{T-1}\frac{1}{(t+1)^{2}}}{\ln{T}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A3.Ex143"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex143.m1" class="ltx_Math" alttext="\displaystyle\overset{(c)}{\leq}\frac{2Gr}{v\alpha\ln{T}}+\frac{CG\kappa C_{w_{0}}}{\delta\ln{T}}\sum_{t=0}^{T-1}\frac{{\lambda}^{t}}{t+1}+\left(\frac{2CG^{2}\kappa}{\delta(1-{\lambda})}+\frac{G^{2}\kappa}{\alpha}\cdot\frac{\alpha}{1}\right)\frac{v}{\ln{T}}," display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mover accent="true"><mo>≤</mo><mrow><mo maxsize="0.700em" minsize="0.700em">(</mo><mi mathsize="0.700em">c</mi><mo maxsize="0.700em" minsize="0.700em">)</mo></mrow></mover><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>G</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi></mrow><mrow><mi>v</mi><mo lspace="0em" rspace="0em">​</mo><mi>α</mi><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>ln</mi><mo lspace="0.167em">⁡</mo><mi>T</mi></mrow></mrow></mfrac></mstyle></mrow><mo>+</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><mi>G</mi><mo lspace="0em" rspace="0em">​</mo><mi>κ</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>C</mi><msub><mi>w</mi><mn>0</mn></msub></msub></mrow><mrow><mi>δ</mi><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>ln</mi><mo lspace="0.167em">⁡</mo><mi>T</mi></mrow></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>t</mi><mo>=</mo><mn>0</mn></mrow><mrow><mi>T</mi><mo>−</mo><mn>1</mn></mrow></munderover></mstyle><mstyle displaystyle="true"><mfrac><msup><mi>λ</mi><mi>t</mi></msup><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow></mfrac></mstyle></mrow></mrow><mo>+</mo><mrow><mrow><mo>(</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>G</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mi>κ</mi></mrow><mrow><mi>δ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>λ</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle><mo>+</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><msup><mi>G</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mi>κ</mi></mrow><mi>α</mi></mfrac></mstyle><mo lspace="0.222em" rspace="0.222em">⋅</mo><mstyle displaystyle="true"><mfrac><mi>α</mi><mn>1</mn></mfrac></mstyle></mrow></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><mi>v</mi><mrow><mi>ln</mi><mo lspace="0.167em">⁡</mo><mi>T</mi></mrow></mfrac></mstyle></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\overset{(c)}{\leq}\frac{2Gr}{v\alpha\ln{T}}+\frac{CG\kappa C_{w_{0}}}{\delta\ln{T}}\sum_{t=0}^{T-1}\frac{{\lambda}^{t}}{t+1}+\left(\frac{2CG^{2}\kappa}{\delta(1-{\lambda})}+\frac{G^{2}\kappa}{\alpha}\cdot\frac{\alpha}{1}\right)\frac{v}{\ln{T}},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A3.SS9.SSS0.Px2.p1.4" class="ltx_p">where in step (c) we used <math id="A3.SS9.SSS0.Px2.p1.m4" class="ltx_Math" alttext="\sum_{t=0}^{\infty}\frac{1}{(t+1)^{2}}\leq 2" display="inline" intent=":literal"><semantics><mrow><mrow><msubsup><mo>∑</mo><mrow><mi>t</mi><mo>=</mo><mn>0</mn></mrow><mi mathvariant="normal">∞</mi></msubsup><mfrac><mn>1</mn><msup><mrow><mo stretchy="false">(</mo><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mfrac></mrow><mo>≤</mo><mn>2</mn></mrow><annotation encoding="application/x-tex">\sum_{t=0}^{\infty}\frac{1}{(t+1)^{2}}\leq 2</annotation></semantics></math>.
Finally, since <math id="A3.SS9.SSS0.Px2.p1.m5" class="ltx_Math" alttext="\frac{1}{t+1}\leq 1" display="inline" intent=":literal"><semantics><mrow><mfrac><mn>1</mn><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow></mfrac><mo>≤</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">\frac{1}{t+1}\leq 1</annotation></semantics></math> and <math id="A3.SS9.SSS0.Px2.p1.m6" class="ltx_Math" alttext="\sum_{t=0}^{T-1}\lambda^{t}\leq\frac{1}{1-\lambda}" display="inline" intent=":literal"><semantics><mrow><mrow><msubsup><mo>∑</mo><mrow><mi>t</mi><mo>=</mo><mn>0</mn></mrow><mrow><mi>T</mi><mo>−</mo><mn>1</mn></mrow></msubsup><msup><mi>λ</mi><mi>t</mi></msup></mrow><mo>≤</mo><mfrac><mn>1</mn><mrow><mn>1</mn><mo>−</mo><mi>λ</mi></mrow></mfrac></mrow><annotation encoding="application/x-tex">\sum_{t=0}^{T-1}\lambda^{t}\leq\frac{1}{1-\lambda}</annotation></semantics></math>, we have</p>
<table id="A3.EGx65" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A3.E108"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.E108.m1" class="ltx_Math" alttext="\displaystyle\sum_{t=0}^{T-1}\frac{\lambda^{t}}{t+1}\leq\sum_{t=0}^{T-1}\lambda^{t}\overset{(a)}{\leq}\frac{1}{1-\lambda}," display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>t</mi><mo>=</mo><mn>0</mn></mrow><mrow><mi>T</mi><mo>−</mo><mn>1</mn></mrow></munderover></mstyle><mstyle displaystyle="true"><mfrac><msup><mi>λ</mi><mi>t</mi></msup><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow></mfrac></mstyle></mrow><mo>≤</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>t</mi><mo>=</mo><mn>0</mn></mrow><mrow><mi>T</mi><mo>−</mo><mn>1</mn></mrow></munderover></mstyle><mrow><msup><mi>λ</mi><mi>t</mi></msup><mo lspace="0em" rspace="0em">​</mo><mover accent="true"><mo>≤</mo><mrow><mo maxsize="0.700em" minsize="0.700em">(</mo><mi mathsize="0.700em">a</mi><mo maxsize="0.700em" minsize="0.700em">)</mo></mrow></mover><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mrow><mn>1</mn><mo>−</mo><mi>λ</mi></mrow></mfrac></mstyle></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\sum_{t=0}^{T-1}\frac{\lambda^{t}}{t+1}\leq\sum_{t=0}^{T-1}\lambda^{t}\overset{(a)}{\leq}\frac{1}{1-\lambda},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(108)</span></td></tr></tbody>
</table>
<p id="A3.SS9.SSS0.Px2.p1.5" class="ltx_p">and therefore</p>
<table id="A3.EGx66" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A3.E109"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.E109.m1" class="ltx_Math" alttext="\displaystyle\epsilon_{\mathrm{opt}}" display="inline" intent=":literal"><semantics><msub><mi>ϵ</mi><mi>opt</mi></msub><annotation encoding="application/x-tex">\displaystyle\epsilon_{\mathrm{opt}}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.E109.m2" class="ltx_Math" alttext="\displaystyle\overset{(a)}{\leq}\left(\frac{CG\kappa C_{w_{0}}}{\delta(1-{\lambda})}+\frac{2Gr}{v\alpha}+\left(\frac{2CG^{2}\kappa}{\delta(1-{\lambda})}+\frac{G^{2}\kappa}{2}\right)v\right)\frac{1}{\ln{T}}." display="inline" intent=":literal"><semantics><mrow><mrow><mover accent="true"><mo>≤</mo><mrow><mo maxsize="0.700em" minsize="0.700em">(</mo><mi mathsize="0.700em">a</mi><mo maxsize="0.700em" minsize="0.700em">)</mo></mrow></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><mi>G</mi><mo lspace="0em" rspace="0em">​</mo><mi>κ</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>C</mi><msub><mi>w</mi><mn>0</mn></msub></msub></mrow><mrow><mi>δ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>λ</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle><mo>+</mo><mstyle displaystyle="true"><mfrac><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>G</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi></mrow><mrow><mi>v</mi><mo lspace="0em" rspace="0em">​</mo><mi>α</mi></mrow></mfrac></mstyle><mo>+</mo><mrow><mrow><mo>(</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>G</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mi>κ</mi></mrow><mrow><mi>δ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>λ</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle><mo>+</mo><mstyle displaystyle="true"><mfrac><mrow><msup><mi>G</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mi>κ</mi></mrow><mn>2</mn></mfrac></mstyle></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>v</mi></mrow></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mrow><mi>ln</mi><mo lspace="0.167em">⁡</mo><mi>T</mi></mrow></mfrac></mstyle></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\overset{(a)}{\leq}\left(\frac{CG\kappa C_{w_{0}}}{\delta(1-{\lambda})}+\frac{2Gr}{v\alpha}+\left(\frac{2CG^{2}\kappa}{\delta(1-{\lambda})}+\frac{G^{2}\kappa}{2}\right)v\right)\frac{1}{\ln{T}}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(109)</span></td></tr></tbody>
</table>
</div>
<div id="A3.SS9.SSS0.Px2.p2" class="ltx_para">
<p id="A3.SS9.SSS0.Px2.p2.1" class="ltx_p">This completes the proof of Corollary <a href="#Thmtheorem38" title="Corollary 38 (Optimization Error on Common Learning Rate). ‣ 4.3 Results on Non-convex Case ‣ 4 Theoretical Analysis ‣ Stability and Generalization of Push-Sum Based Decentralized Optimization over Directed Graphs" class="ltx_ref"><span class="ltx_text ltx_ref_tag">38</span></a>.
∎</p>
</div>
</section>
</section>
<section id="A3.SS10" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">C.10 </span>Proof of Corollary <a href="#Thmtheorem40" title="Corollary 40 (Excess Generalization Error with Common Learning Rates). ‣ 4.3 Results on Non-convex Case ‣ 4 Theoretical Analysis ‣ Stability and Generalization of Push-Sum Based Decentralized Optimization over Directed Graphs" class="ltx_ref"><span class="ltx_text ltx_ref_tag">40</span></a></h3>

<div id="A3.SS10.2" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
</div>
<section id="A3.SS10.SSS0.Px1" class="ltx_paragraph">
<h4 class="ltx_title ltx_title_paragraph">Case 1: Constant learning rate.</h4>

<div id="A3.SS10.SSS0.Px1.p1" class="ltx_para">
<p id="A3.SS10.SSS0.Px1.p1.1" class="ltx_p">Let <math id="A3.SS10.SSS0.Px1.p1.m1" class="ltx_Math" alttext="\gamma_{t}=\gamma" display="inline" intent=":literal"><semantics><mrow><msub><mi>γ</mi><mi>t</mi></msub><mo>=</mo><mi>γ</mi></mrow><annotation encoding="application/x-tex">\gamma_{t}=\gamma</annotation></semantics></math> and denote</p>
<table id="A3.Ex144" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A3.Ex144.m1" class="ltx_Math" alttext="\rho:=1+L\gamma-\frac{L\gamma}{mn},\qquad\mu:=\ln\rho." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mi>ρ</mi><mo>:=</mo><mrow><mrow><mn>1</mn><mo>+</mo><mrow><mi>L</mi><mo lspace="0em" rspace="0em">​</mo><mi>γ</mi></mrow></mrow><mo>−</mo><mfrac><mrow><mi>L</mi><mo lspace="0em" rspace="0em">​</mo><mi>γ</mi></mrow><mrow><mi>m</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow></mfrac></mrow></mrow><mo rspace="2.167em">,</mo><mrow><mi>μ</mi><mo>:=</mo><mrow><mi>ln</mi><mo lspace="0.167em">⁡</mo><mi>ρ</mi></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\rho:=1+L\gamma-\frac{L\gamma}{mn},\qquad\mu:=\ln\rho.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A3.SS10.SSS0.Px1.p1.2" class="ltx_p">Recall from Corollary <a href="#Thmtheorem33" title="Corollary 33 (Uniform Stability on Common Learning Rate). ‣ 4.3 Results on Non-convex Case ‣ 4 Theoretical Analysis ‣ Stability and Generalization of Push-Sum Based Decentralized Optimization over Directed Graphs" class="ltx_ref"><span class="ltx_text ltx_ref_tag">33</span></a> (constant stepsize case) that</p>
<table id="A3.E110" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A3.E110.m1" class="ltx_Math" alttext="\epsilon_{\mathrm{stab}}(t)\leq\Bigg(\frac{2GCL\gamma C_{w_{0}}}{\delta(1-\lambda)}+\frac{4CG^{2}L\gamma^{2}}{\delta(1-\lambda)}+\frac{4G^{2}\gamma}{mn}\Bigg)\rho^{t}," display="block" intent=":literal"><semantics><mrow><mrow><mrow><msub><mi>ϵ</mi><mi>stab</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo>≤</mo><mrow><mrow><mo maxsize="2.600em" minsize="2.600em">(</mo><mrow><mfrac><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>G</mi><mo lspace="0em" rspace="0em">​</mo><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><mi>L</mi><mo lspace="0em" rspace="0em">​</mo><mi>γ</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>C</mi><msub><mi>w</mi><mn>0</mn></msub></msub></mrow><mrow><mi>δ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>λ</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mfrac><mo>+</mo><mfrac><mrow><mn>4</mn><mo lspace="0em" rspace="0em">​</mo><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>G</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mi>L</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>γ</mi><mn>2</mn></msup></mrow><mrow><mi>δ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>λ</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mfrac><mo>+</mo><mfrac><mrow><mn>4</mn><mo lspace="0em" rspace="0em">​</mo><msup><mi>G</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mi>γ</mi></mrow><mrow><mi>m</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow></mfrac></mrow><mo maxsize="2.600em" minsize="2.600em">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mi>ρ</mi><mi>t</mi></msup></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\epsilon_{\mathrm{stab}}(t)\leq\Bigg(\frac{2GCL\gamma C_{w_{0}}}{\delta(1-\lambda)}+\frac{4CG^{2}L\gamma^{2}}{\delta(1-\lambda)}+\frac{4G^{2}\gamma}{mn}\Bigg)\rho^{t},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(110)</span></td></tr></tbody>
</table>
<p id="A3.SS10.SSS0.Px1.p1.3" class="ltx_p">Since <math id="A3.SS10.SSS0.Px1.p1.m2" class="ltx_Math" alttext="\epsilon_{\mathrm{stab}}(t)\leq G\,\mathbb{E}\|\overline{\bm{w}}^{(t)}-\overline{\bm{w}}^{\prime(t)}\|=G\,\mathbb{E}[\Delta_{t}]" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>ϵ</mi><mi>stab</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo>≤</mo><mrow><mi>G</mi><mo lspace="0.170em" rspace="0em">​</mo><mi>𝔼</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">‖</mo><mrow><msup><mover accent="true"><mi>𝒘</mi><mo stretchy="true">¯</mo></mover><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo>−</mo><msup><mover accent="true"><mi>𝒘</mi><mo stretchy="true">¯</mo></mover><mrow><mo rspace="0em">′</mo><mphantom></mphantom><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow></msup></mrow><mo stretchy="false">‖</mo></mrow></mrow><mo>=</mo><mrow><mi>G</mi><mo lspace="0.170em" rspace="0em">​</mo><mi>𝔼</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><msub><mi mathvariant="normal">Δ</mi><mi>t</mi></msub><mo stretchy="false">]</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\epsilon_{\mathrm{stab}}(t)\leq G\,\mathbb{E}\|\overline{\bm{w}}^{(t)}-\overline{\bm{w}}^{\prime(t)}\|=G\,\mathbb{E}[\Delta_{t}]</annotation></semantics></math>, (<a href="#A3.E110" title="In Case 1: Constant learning rate. ‣ C.10 Proof of Corollary ‣ Appendix C Proof of Theorem and Corollary ‣ Stability and Generalization of Push-Sum Based Decentralized Optimization over Directed Graphs" class="ltx_ref"><span class="ltx_text ltx_ref_tag">110</span></a>) implies</p>
<table id="A3.EGx67" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A3.Ex145"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.Ex145.m1" class="ltx_Math" alttext="\displaystyle\mathbb{E}[\Delta_{t}]" display="inline" intent=":literal"><semantics><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><msub><mi mathvariant="normal">Δ</mi><mi>t</mi></msub><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\mathbb{E}[\Delta_{t}]</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex145.m2" class="ltx_Math" alttext="\displaystyle\leq\Bigg(\frac{2CL\gamma C_{w_{0}}}{\delta(1-\lambda)}+\frac{4CG^{2}L\gamma^{2}}{G\,\delta(1-\lambda)}+\frac{4G\gamma}{mn}\Bigg)\rho^{t}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≤</mo><mrow><mrow><mo maxsize="2.600em" minsize="2.600em">(</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><mi>L</mi><mo lspace="0em" rspace="0em">​</mo><mi>γ</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>C</mi><msub><mi>w</mi><mn>0</mn></msub></msub></mrow><mrow><mi>δ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>λ</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle><mo>+</mo><mstyle displaystyle="true"><mfrac><mrow><mn>4</mn><mo lspace="0em" rspace="0em">​</mo><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>G</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mi>L</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>γ</mi><mn>2</mn></msup></mrow><mrow><mi>G</mi><mo lspace="0.170em" rspace="0em">​</mo><mi>δ</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>λ</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle><mo>+</mo><mstyle displaystyle="true"><mfrac><mrow><mn>4</mn><mo lspace="0em" rspace="0em">​</mo><mi>G</mi><mo lspace="0em" rspace="0em">​</mo><mi>γ</mi></mrow><mrow><mi>m</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow></mfrac></mstyle></mrow><mo maxsize="2.600em" minsize="2.600em">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mi>ρ</mi><mi>t</mi></msup></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\leq\Bigg(\frac{2CL\gamma C_{w_{0}}}{\delta(1-\lambda)}+\frac{4CG^{2}L\gamma^{2}}{G\,\delta(1-\lambda)}+\frac{4G\gamma}{mn}\Bigg)\rho^{t}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A3.E111"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.E111.m1" class="ltx_Math" alttext="\displaystyle=\Bigg(\frac{2CL\gamma C_{w_{0}}}{\delta(1-\lambda)}+\frac{4CGL\gamma^{2}}{\delta(1-\lambda)}+\frac{4G\gamma}{mn}\Bigg)\rho^{t}." display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><mo maxsize="2.600em" minsize="2.600em">(</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><mi>L</mi><mo lspace="0em" rspace="0em">​</mo><mi>γ</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>C</mi><msub><mi>w</mi><mn>0</mn></msub></msub></mrow><mrow><mi>δ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>λ</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle><mo>+</mo><mstyle displaystyle="true"><mfrac><mrow><mn>4</mn><mo lspace="0em" rspace="0em">​</mo><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><mi>G</mi><mo lspace="0em" rspace="0em">​</mo><mi>L</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>γ</mi><mn>2</mn></msup></mrow><mrow><mi>δ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>λ</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle><mo>+</mo><mstyle displaystyle="true"><mfrac><mrow><mn>4</mn><mo lspace="0em" rspace="0em">​</mo><mi>G</mi><mo lspace="0em" rspace="0em">​</mo><mi>γ</mi></mrow><mrow><mi>m</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow></mfrac></mstyle></mrow><mo maxsize="2.600em" minsize="2.600em">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mi>ρ</mi><mi>t</mi></msup></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle=\Bigg(\frac{2CL\gamma C_{w_{0}}}{\delta(1-\lambda)}+\frac{4CGL\gamma^{2}}{\delta(1-\lambda)}+\frac{4G\gamma}{mn}\Bigg)\rho^{t}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(111)</span></td></tr></tbody>
</table>
</div>
<div id="A3.SS10.SSS0.Px1.p2" class="ltx_para">
<p id="A3.SS10.SSS0.Px1.p2.1" class="ltx_p">Applying the averaged model and Assumption <a href="#Thmtheorem17" title="Assumption 17. ‣ 4.1 Basic Assumptions ‣ 4 Theoretical Analysis ‣ Stability and Generalization of Push-Sum Based Decentralized Optimization over Directed Graphs" class="ltx_ref"><span class="ltx_text ltx_ref_tag">17</span></a> (the loss is <math id="A3.SS10.SSS0.Px1.p2.m1" class="ltx_Math" alttext="G" display="inline" intent=":literal"><semantics><mi>G</mi><annotation encoding="application/x-tex">G</annotation></semantics></math>-Lipschitz) yields</p>
<table id="A3.EGx68" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A3.Ex146"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.Ex146.m1" class="ltx_Math" alttext="\displaystyle\epsilon_{\mathrm{ave\text{-}stab}}" display="inline" intent=":literal"><semantics><msub><mi>ϵ</mi><mrow><mi>ave</mi><mo lspace="0em" rspace="0em">​</mo><mtext>-</mtext><mo lspace="0em" rspace="0em">​</mo><mi>stab</mi></mrow></msub><annotation encoding="application/x-tex">\displaystyle\epsilon_{\mathrm{ave\text{-}stab}}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex146.m2" class="ltx_Math" alttext="\displaystyle\leq G\,\mathbb{E}\big\|\bm{w}_{\mathrm{avg}}^{(T)}-\bm{w}_{\mathrm{avg}}^{\prime(T)}\big\|=G\,\frac{\sum_{t=0}^{T-1}\gamma\,\mathbb{E}[\Delta_{t}]}{\sum_{t=0}^{T-1}\gamma}=\frac{G}{T}\sum_{t=0}^{T-1}\mathbb{E}[\Delta_{t}]" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≤</mo><mrow><mi>G</mi><mo lspace="0.170em" rspace="0em">​</mo><mi>𝔼</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="1.200em" minsize="1.200em" stretchy="true">‖</mo><mrow><msubsup><mi>𝒘</mi><mi>avg</mi><mrow><mo stretchy="false">(</mo><mi>T</mi><mo stretchy="false">)</mo></mrow></msubsup><mo>−</mo><msubsup><mi>𝒘</mi><mi>avg</mi><mrow><mo rspace="0em">′</mo><mphantom></mphantom><mrow><mo stretchy="false">(</mo><mi>T</mi><mo stretchy="false">)</mo></mrow></mrow></msubsup></mrow><mo maxsize="1.200em" minsize="1.200em" stretchy="true">‖</mo></mrow></mrow><mo>=</mo><mrow><mi>G</mi><mo lspace="0.170em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><mrow><msubsup><mo>∑</mo><mrow><mi>t</mi><mo>=</mo><mn>0</mn></mrow><mrow><mi>T</mi><mo>−</mo><mn>1</mn></mrow></msubsup><mrow><mi>γ</mi><mo lspace="0.170em" rspace="0em">​</mo><mi>𝔼</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><msub><mi mathvariant="normal">Δ</mi><mi>t</mi></msub><mo stretchy="false">]</mo></mrow></mrow></mrow><mrow><msubsup><mo>∑</mo><mrow><mi>t</mi><mo>=</mo><mn>0</mn></mrow><mrow><mi>T</mi><mo>−</mo><mn>1</mn></mrow></msubsup><mi>γ</mi></mrow></mfrac></mstyle></mrow><mo>=</mo><mrow><mstyle displaystyle="true"><mfrac><mi>G</mi><mi>T</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>t</mi><mo>=</mo><mn>0</mn></mrow><mrow><mi>T</mi><mo>−</mo><mn>1</mn></mrow></munderover></mstyle><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><msub><mi mathvariant="normal">Δ</mi><mi>t</mi></msub><mo stretchy="false">]</mo></mrow></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\leq G\,\mathbb{E}\big\|\bm{w}_{\mathrm{avg}}^{(T)}-\bm{w}_{\mathrm{avg}}^{\prime(T)}\big\|=G\,\frac{\sum_{t=0}^{T-1}\gamma\,\mathbb{E}[\Delta_{t}]}{\sum_{t=0}^{T-1}\gamma}=\frac{G}{T}\sum_{t=0}^{T-1}\mathbb{E}[\Delta_{t}]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A3.Ex147"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex147.m1" class="ltx_Math" alttext="\displaystyle\overset{\eqref{eq:Delta_t_const_bound}}{\leq}\frac{G}{T}\Bigg(\frac{2CL\gamma C_{w_{0}}}{\delta(1-\lambda)}+\frac{4CGL\gamma^{2}}{\delta(1-\lambda)}+\frac{4G\gamma}{mn}\Bigg)\sum_{t=0}^{T-1}\rho^{t}" display="inline" intent=":literal"><semantics><mrow><mover accent="true"><mo>≤</mo><mrow><mtext mathsize="0.700em">(</mtext><mtext mathsize="0.700em"><a href="#A3.E111" title="In Case 1: Constant learning rate. ‣ C.10 Proof of Corollary ‣ Appendix C Proof of Theorem and Corollary ‣ Stability and Generalization of Push-Sum Based Decentralized Optimization over Directed Graphs" class="ltx_ref" style="font-size:70%;"><span class="ltx_text ltx_ref_tag">111</span></a></mtext><mtext mathsize="0.700em">)</mtext></mrow></mover><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><mi>G</mi><mi>T</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="2.600em" minsize="2.600em">(</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><mi>L</mi><mo lspace="0em" rspace="0em">​</mo><mi>γ</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>C</mi><msub><mi>w</mi><mn>0</mn></msub></msub></mrow><mrow><mi>δ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>λ</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle><mo>+</mo><mstyle displaystyle="true"><mfrac><mrow><mn>4</mn><mo lspace="0em" rspace="0em">​</mo><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><mi>G</mi><mo lspace="0em" rspace="0em">​</mo><mi>L</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>γ</mi><mn>2</mn></msup></mrow><mrow><mi>δ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>λ</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle><mo>+</mo><mstyle displaystyle="true"><mfrac><mrow><mn>4</mn><mo lspace="0em" rspace="0em">​</mo><mi>G</mi><mo lspace="0em" rspace="0em">​</mo><mi>γ</mi></mrow><mrow><mi>m</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow></mfrac></mstyle></mrow><mo maxsize="2.600em" minsize="2.600em">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>t</mi><mo>=</mo><mn>0</mn></mrow><mrow><mi>T</mi><mo>−</mo><mn>1</mn></mrow></munderover></mstyle><msup><mi>ρ</mi><mi>t</mi></msup></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\overset{\eqref{eq:Delta_t_const_bound}}{\leq}\frac{G}{T}\Bigg(\frac{2CL\gamma C_{w_{0}}}{\delta(1-\lambda)}+\frac{4CGL\gamma^{2}}{\delta(1-\lambda)}+\frac{4G\gamma}{mn}\Bigg)\sum_{t=0}^{T-1}\rho^{t}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A3.Ex148"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex148.m1" class="ltx_Math" alttext="\displaystyle=\frac{1}{T}\Bigg(\frac{2GCL\gamma C_{w_{0}}}{\delta(1-\lambda)}+\frac{4CG^{2}L\gamma^{2}}{\delta(1-\lambda)}+\frac{4G^{2}\gamma}{mn}\Bigg)\sum_{t=0}^{T-1}\rho^{t}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>T</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="2.600em" minsize="2.600em">(</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>G</mi><mo lspace="0em" rspace="0em">​</mo><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><mi>L</mi><mo lspace="0em" rspace="0em">​</mo><mi>γ</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>C</mi><msub><mi>w</mi><mn>0</mn></msub></msub></mrow><mrow><mi>δ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>λ</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle><mo>+</mo><mstyle displaystyle="true"><mfrac><mrow><mn>4</mn><mo lspace="0em" rspace="0em">​</mo><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>G</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mi>L</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>γ</mi><mn>2</mn></msup></mrow><mrow><mi>δ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>λ</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle><mo>+</mo><mstyle displaystyle="true"><mfrac><mrow><mn>4</mn><mo lspace="0em" rspace="0em">​</mo><msup><mi>G</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mi>γ</mi></mrow><mrow><mi>m</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow></mfrac></mstyle></mrow><mo maxsize="2.600em" minsize="2.600em">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>t</mi><mo>=</mo><mn>0</mn></mrow><mrow><mi>T</mi><mo>−</mo><mn>1</mn></mrow></munderover></mstyle><msup><mi>ρ</mi><mi>t</mi></msup></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\frac{1}{T}\Bigg(\frac{2GCL\gamma C_{w_{0}}}{\delta(1-\lambda)}+\frac{4CG^{2}L\gamma^{2}}{\delta(1-\lambda)}+\frac{4G^{2}\gamma}{mn}\Bigg)\sum_{t=0}^{T-1}\rho^{t}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A3.Ex149"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex149.m1" class="ltx_Math" alttext="\displaystyle=\frac{1}{T}\Bigg(\frac{2GCL\gamma C_{w_{0}}}{\delta(1-\lambda)}+\frac{4CG^{2}L\gamma^{2}}{\delta(1-\lambda)}+\frac{4G^{2}\gamma}{mn}\Bigg)\cdot\frac{\rho^{T}-1}{\rho-1}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>T</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="2.600em" minsize="2.600em">(</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>G</mi><mo lspace="0em" rspace="0em">​</mo><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><mi>L</mi><mo lspace="0em" rspace="0em">​</mo><mi>γ</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>C</mi><msub><mi>w</mi><mn>0</mn></msub></msub></mrow><mrow><mi>δ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>λ</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle><mo>+</mo><mstyle displaystyle="true"><mfrac><mrow><mn>4</mn><mo lspace="0em" rspace="0em">​</mo><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>G</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mi>L</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>γ</mi><mn>2</mn></msup></mrow><mrow><mi>δ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>λ</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle><mo>+</mo><mstyle displaystyle="true"><mfrac><mrow><mn>4</mn><mo lspace="0em" rspace="0em">​</mo><msup><mi>G</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mi>γ</mi></mrow><mrow><mi>m</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow></mfrac></mstyle></mrow><mo maxsize="2.600em" minsize="2.600em" rspace="0.055em">)</mo></mrow></mrow><mo rspace="0.222em">⋅</mo><mstyle displaystyle="true"><mfrac><mrow><msup><mi>ρ</mi><mi>T</mi></msup><mo>−</mo><mn>1</mn></mrow><mrow><mi>ρ</mi><mo>−</mo><mn>1</mn></mrow></mfrac></mstyle></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\frac{1}{T}\Bigg(\frac{2GCL\gamma C_{w_{0}}}{\delta(1-\lambda)}+\frac{4CG^{2}L\gamma^{2}}{\delta(1-\lambda)}+\frac{4G^{2}\gamma}{mn}\Bigg)\cdot\frac{\rho^{T}-1}{\rho-1}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A3.E112"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.E112.m1" class="ltx_Math" alttext="\displaystyle\leq\frac{1}{T}\Bigg(\frac{2GCL\gamma C_{w_{0}}}{\delta(1-\lambda)}+\frac{4CG^{2}L\gamma^{2}}{\delta(1-\lambda)}+\frac{4G^{2}\gamma}{mn}\Bigg)\cdot\frac{\rho^{T}}{\rho-1}." display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>≤</mo><mrow><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>T</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="2.600em" minsize="2.600em">(</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>G</mi><mo lspace="0em" rspace="0em">​</mo><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><mi>L</mi><mo lspace="0em" rspace="0em">​</mo><mi>γ</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>C</mi><msub><mi>w</mi><mn>0</mn></msub></msub></mrow><mrow><mi>δ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>λ</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle><mo>+</mo><mstyle displaystyle="true"><mfrac><mrow><mn>4</mn><mo lspace="0em" rspace="0em">​</mo><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>G</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mi>L</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>γ</mi><mn>2</mn></msup></mrow><mrow><mi>δ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>λ</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle><mo>+</mo><mstyle displaystyle="true"><mfrac><mrow><mn>4</mn><mo lspace="0em" rspace="0em">​</mo><msup><mi>G</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mi>γ</mi></mrow><mrow><mi>m</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow></mfrac></mstyle></mrow><mo maxsize="2.600em" minsize="2.600em" rspace="0.055em">)</mo></mrow></mrow><mo rspace="0.222em">⋅</mo><mstyle displaystyle="true"><mfrac><msup><mi>ρ</mi><mi>T</mi></msup><mrow><mi>ρ</mi><mo>−</mo><mn>1</mn></mrow></mfrac></mstyle></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\leq\frac{1}{T}\Bigg(\frac{2GCL\gamma C_{w_{0}}}{\delta(1-\lambda)}+\frac{4CG^{2}L\gamma^{2}}{\delta(1-\lambda)}+\frac{4G^{2}\gamma}{mn}\Bigg)\cdot\frac{\rho^{T}}{\rho-1}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(112)</span></td></tr></tbody>
</table>
<p id="A3.SS10.SSS0.Px1.p2.2" class="ltx_p">Noting <math id="A3.SS10.SSS0.Px1.p2.m2" class="ltx_Math" alttext="\rho-1=L\gamma(1-\frac{1}{mn})" display="inline" intent=":literal"><semantics><mrow><mrow><mi>ρ</mi><mo>−</mo><mn>1</mn></mrow><mo>=</mo><mrow><mi>L</mi><mo lspace="0em" rspace="0em">​</mo><mi>γ</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mfrac><mn>1</mn><mrow><mi>m</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow></mfrac></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\rho-1=L\gamma(1-\frac{1}{mn})</annotation></semantics></math>, define the constant</p>
<table id="A3.E113" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A3.E113.m1" class="ltx_Math" alttext="C_{\mathrm{stab}}:=\frac{\frac{2GCL\gamma C_{w_{0}}}{\delta(1-\lambda)}+\frac{4CG^{2}L\gamma^{2}}{\delta(1-\lambda)}+\frac{4G^{2}\gamma}{mn}}{L\gamma\left(1-\frac{1}{mn}\right)}," display="block" intent=":literal"><semantics><mrow><mrow><msub><mi>C</mi><mi>stab</mi></msub><mo>:=</mo><mfrac><mrow><mfrac><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>G</mi><mo lspace="0em" rspace="0em">​</mo><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><mi>L</mi><mo lspace="0em" rspace="0em">​</mo><mi>γ</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>C</mi><msub><mi>w</mi><mn>0</mn></msub></msub></mrow><mrow><mi>δ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>λ</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mfrac><mo>+</mo><mfrac><mrow><mn>4</mn><mo lspace="0em" rspace="0em">​</mo><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>G</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mi>L</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>γ</mi><mn>2</mn></msup></mrow><mrow><mi>δ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>λ</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mfrac><mo>+</mo><mfrac><mrow><mn>4</mn><mo lspace="0em" rspace="0em">​</mo><msup><mi>G</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mi>γ</mi></mrow><mrow><mi>m</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow></mfrac></mrow><mrow><mi>L</mi><mo lspace="0em" rspace="0em">​</mo><mi>γ</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mn>1</mn><mo>−</mo><mfrac><mn>1</mn><mrow><mi>m</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow></mfrac></mrow><mo>)</mo></mrow></mrow></mfrac></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">C_{\mathrm{stab}}:=\frac{\frac{2GCL\gamma C_{w_{0}}}{\delta(1-\lambda)}+\frac{4CG^{2}L\gamma^{2}}{\delta(1-\lambda)}+\frac{4G^{2}\gamma}{mn}}{L\gamma\left(1-\frac{1}{mn}\right)},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(113)</span></td></tr></tbody>
</table>
<p id="A3.SS10.SSS0.Px1.p2.3" class="ltx_p">so that (<a href="#A3.E112" title="In Case 1: Constant learning rate. ‣ C.10 Proof of Corollary ‣ Appendix C Proof of Theorem and Corollary ‣ Stability and Generalization of Push-Sum Based Decentralized Optimization over Directed Graphs" class="ltx_ref"><span class="ltx_text ltx_ref_tag">112</span></a>) becomes</p>
<table id="A3.E114" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A3.E114.m1" class="ltx_Math" alttext="\epsilon_{\mathrm{ave\text{-}stab}}\leq C_{\mathrm{stab}}\cdot\frac{\rho^{T}}{T}." display="block" intent=":literal"><semantics><mrow><mrow><msub><mi>ϵ</mi><mrow><mi>ave</mi><mo lspace="0em" rspace="0em">​</mo><mtext>-</mtext><mo lspace="0em" rspace="0em">​</mo><mi>stab</mi></mrow></msub><mo>≤</mo><mrow><msub><mi>C</mi><mi>stab</mi></msub><mo lspace="0.222em" rspace="0.222em">⋅</mo><mfrac><msup><mi>ρ</mi><mi>T</mi></msup><mi>T</mi></mfrac></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\epsilon_{\mathrm{ave\text{-}stab}}\leq C_{\mathrm{stab}}\cdot\frac{\rho^{T}}{T}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(114)</span></td></tr></tbody>
</table>
</div>
<div id="A3.SS10.SSS0.Px1.p3" class="ltx_para">
<p id="A3.SS10.SSS0.Px1.p3.1" class="ltx_p">On the other hand, Corollary <a href="#Thmtheorem38" title="Corollary 38 (Optimization Error on Common Learning Rate). ‣ 4.3 Results on Non-convex Case ‣ 4 Theoretical Analysis ‣ Stability and Generalization of Push-Sum Based Decentralized Optimization over Directed Graphs" class="ltx_ref"><span class="ltx_text ltx_ref_tag">38</span></a> gives (with <math id="A3.SS10.SSS0.Px1.p3.m1" class="ltx_Math" alttext="\kappa:=L/\alpha" display="inline" intent=":literal"><semantics><mrow><mi>κ</mi><mo>:=</mo><mrow><mi>L</mi><mo>/</mo><mi>α</mi></mrow></mrow><annotation encoding="application/x-tex">\kappa:=L/\alpha</annotation></semantics></math>)</p>
<table id="A3.E115" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A3.E115.m1" class="ltx_Math" alttext="\epsilon_{\mathrm{opt}}\leq\Bigg(\frac{Gr}{\alpha\gamma}+\frac{CG\kappa C_{w_{0}}}{2\delta(1-\lambda)}\Bigg)\frac{1}{T}+\Bigg(\frac{CG^{2}\kappa}{2\delta(1-\lambda)}+\frac{G^{2}\kappa}{4}\Bigg)\gamma." display="block" intent=":literal"><semantics><mrow><mrow><msub><mi>ϵ</mi><mi>opt</mi></msub><mo>≤</mo><mrow><mrow><mrow><mo maxsize="2.600em" minsize="2.600em">(</mo><mrow><mfrac><mrow><mi>G</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi></mrow><mrow><mi>α</mi><mo lspace="0em" rspace="0em">​</mo><mi>γ</mi></mrow></mfrac><mo>+</mo><mfrac><mrow><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><mi>G</mi><mo lspace="0em" rspace="0em">​</mo><mi>κ</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>C</mi><msub><mi>w</mi><mn>0</mn></msub></msub></mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>δ</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>λ</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mfrac></mrow><mo maxsize="2.600em" minsize="2.600em">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mfrac><mn>1</mn><mi>T</mi></mfrac></mrow><mo>+</mo><mrow><mrow><mo maxsize="2.600em" minsize="2.600em">(</mo><mrow><mfrac><mrow><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>G</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mi>κ</mi></mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>δ</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>λ</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mfrac><mo>+</mo><mfrac><mrow><msup><mi>G</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mi>κ</mi></mrow><mn>4</mn></mfrac></mrow><mo maxsize="2.600em" minsize="2.600em">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>γ</mi></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\epsilon_{\mathrm{opt}}\leq\Bigg(\frac{Gr}{\alpha\gamma}+\frac{CG\kappa C_{w_{0}}}{2\delta(1-\lambda)}\Bigg)\frac{1}{T}+\Bigg(\frac{CG^{2}\kappa}{2\delta(1-\lambda)}+\frac{G^{2}\kappa}{4}\Bigg)\gamma.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(115)</span></td></tr></tbody>
</table>
<p id="A3.SS10.SSS0.Px1.p3.2" class="ltx_p">Combining (<a href="#A3.E114" title="In Case 1: Constant learning rate. ‣ C.10 Proof of Corollary ‣ Appendix C Proof of Theorem and Corollary ‣ Stability and Generalization of Push-Sum Based Decentralized Optimization over Directed Graphs" class="ltx_ref"><span class="ltx_text ltx_ref_tag">114</span></a>) and (<a href="#A3.E115" title="In Case 1: Constant learning rate. ‣ C.10 Proof of Corollary ‣ Appendix C Proof of Theorem and Corollary ‣ Stability and Generalization of Push-Sum Based Decentralized Optimization over Directed Graphs" class="ltx_ref"><span class="ltx_text ltx_ref_tag">115</span></a>), we obtain</p>
<table id="A3.EGx69" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A3.Ex150"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.Ex150.m1" class="ltx_Math" alttext="\displaystyle\epsilon_{\mathrm{exc}}(T)" display="inline" intent=":literal"><semantics><mrow><msub><mi>ϵ</mi><mi>exc</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>T</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\epsilon_{\mathrm{exc}}(T)</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex150.m2" class="ltx_Math" alttext="\displaystyle\leq\epsilon_{\mathrm{ave\text{-}stab}}+\epsilon_{\mathrm{opt}}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≤</mo><mrow><msub><mi>ϵ</mi><mrow><mi>ave</mi><mo lspace="0em" rspace="0em">​</mo><mtext>-</mtext><mo lspace="0em" rspace="0em">​</mo><mi>stab</mi></mrow></msub><mo>+</mo><msub><mi>ϵ</mi><mi>opt</mi></msub></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\leq\epsilon_{\mathrm{ave\text{-}stab}}+\epsilon_{\mathrm{opt}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A3.E116"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.E116.m1" class="ltx_Math" alttext="\displaystyle\leq\Bigg(\frac{Gr}{\alpha\gamma}+\frac{CG\kappa C_{w_{0}}}{2\delta(1-\lambda)}\Bigg)\frac{1}{T}+C_{\mathrm{stab}}\frac{\rho^{T}}{T}+\Bigg(\frac{CG^{2}\kappa}{2\delta(1-\lambda)}+\frac{G^{2}\kappa}{4}\Bigg)\gamma." display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>≤</mo><mrow><mrow><mrow><mo maxsize="2.600em" minsize="2.600em">(</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mi>G</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi></mrow><mrow><mi>α</mi><mo lspace="0em" rspace="0em">​</mo><mi>γ</mi></mrow></mfrac></mstyle><mo>+</mo><mstyle displaystyle="true"><mfrac><mrow><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><mi>G</mi><mo lspace="0em" rspace="0em">​</mo><mi>κ</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>C</mi><msub><mi>w</mi><mn>0</mn></msub></msub></mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>δ</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>λ</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle></mrow><mo maxsize="2.600em" minsize="2.600em">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>T</mi></mfrac></mstyle></mrow><mo>+</mo><mrow><msub><mi>C</mi><mi>stab</mi></msub><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><msup><mi>ρ</mi><mi>T</mi></msup><mi>T</mi></mfrac></mstyle></mrow><mo>+</mo><mrow><mrow><mo maxsize="2.600em" minsize="2.600em">(</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>G</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mi>κ</mi></mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>δ</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>λ</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle><mo>+</mo><mstyle displaystyle="true"><mfrac><mrow><msup><mi>G</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mi>κ</mi></mrow><mn>4</mn></mfrac></mstyle></mrow><mo maxsize="2.600em" minsize="2.600em">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>γ</mi></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\leq\Bigg(\frac{Gr}{\alpha\gamma}+\frac{CG\kappa C_{w_{0}}}{2\delta(1-\lambda)}\Bigg)\frac{1}{T}+C_{\mathrm{stab}}\frac{\rho^{T}}{T}+\Bigg(\frac{CG^{2}\kappa}{2\delta(1-\lambda)}+\frac{G^{2}\kappa}{4}\Bigg)\gamma.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(116)</span></td></tr></tbody>
</table>
</div>
<div id="A3.SS10.SSS0.Px1.p4" class="ltx_para">
<p id="A3.SS10.SSS0.Px1.p4.1" class="ltx_p">We now choose <math id="A3.SS10.SSS0.Px1.p4.m1" class="ltx_Math" alttext="T" display="inline" intent=":literal"><semantics><mi>T</mi><annotation encoding="application/x-tex">T</annotation></semantics></math> to balance the two <math id="A3.SS10.SSS0.Px1.p4.m2" class="ltx_Math" alttext="1/T" display="inline" intent=":literal"><semantics><mrow><mn>1</mn><mo>/</mo><mi>T</mi></mrow><annotation encoding="application/x-tex">1/T</annotation></semantics></math>-terms in (<a href="#A3.E116" title="In Case 1: Constant learning rate. ‣ C.10 Proof of Corollary ‣ Appendix C Proof of Theorem and Corollary ‣ Stability and Generalization of Push-Sum Based Decentralized Optimization over Directed Graphs" class="ltx_ref"><span class="ltx_text ltx_ref_tag">116</span></a>). Let</p>
<table id="A3.Ex151" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A3.Ex151.m1" class="ltx_Math" alttext="C_{\mathrm{opt}}:=\frac{Gr}{\alpha\gamma}+\frac{CG\kappa C_{w_{0}}}{2\delta(1-\lambda)}." display="block" intent=":literal"><semantics><mrow><mrow><msub><mi>C</mi><mi>opt</mi></msub><mo>:=</mo><mrow><mfrac><mrow><mi>G</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi></mrow><mrow><mi>α</mi><mo lspace="0em" rspace="0em">​</mo><mi>γ</mi></mrow></mfrac><mo>+</mo><mfrac><mrow><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><mi>G</mi><mo lspace="0em" rspace="0em">​</mo><mi>κ</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>C</mi><msub><mi>w</mi><mn>0</mn></msub></msub></mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>δ</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>λ</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mfrac></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">C_{\mathrm{opt}}:=\frac{Gr}{\alpha\gamma}+\frac{CG\kappa C_{w_{0}}}{2\delta(1-\lambda)}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A3.SS10.SSS0.Px1.p4.2" class="ltx_p">Take</p>
<table id="A3.E117" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A3.E117.m1" class="ltx_Math" alttext="T^{*}:=\left\lceil\frac{1}{\mu}\ln\!\Big(\frac{C_{\mathrm{opt}}}{C_{\mathrm{stab}}}\Big)\right\rceil,\qquad\mu=\ln\rho," display="block" intent=":literal"><semantics><mrow><mrow><mrow><msup><mi>T</mi><mo>∗</mo></msup><mo>:=</mo><mrow><mo>⌈</mo><mrow><mfrac><mn>1</mn><mi>μ</mi></mfrac><mo lspace="0.167em" rspace="0em">​</mo><mrow><mpadded style="width:0.748em;" width="0.748em"><mi>ln</mi></mpadded><mo>⁡</mo><mrow><mo maxsize="1.600em" minsize="1.600em">(</mo><mfrac><msub><mi>C</mi><mi>opt</mi></msub><msub><mi>C</mi><mi>stab</mi></msub></mfrac><mo maxsize="1.600em" minsize="1.600em">)</mo></mrow></mrow></mrow><mo>⌉</mo></mrow></mrow><mo rspace="2.167em">,</mo><mrow><mi>μ</mi><mo>=</mo><mrow><mi>ln</mi><mo lspace="0.167em">⁡</mo><mi>ρ</mi></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">T^{*}:=\left\lceil\frac{1}{\mu}\ln\!\Big(\frac{C_{\mathrm{opt}}}{C_{\mathrm{stab}}}\Big)\right\rceil,\qquad\mu=\ln\rho,</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(117)</span></td></tr></tbody>
</table>
<p id="A3.SS10.SSS0.Px1.p4.3" class="ltx_p">(assuming <math id="A3.SS10.SSS0.Px1.p4.m3" class="ltx_Math" alttext="C_{\mathrm{opt}}&gt;C_{\mathrm{stab}}" display="inline" intent=":literal"><semantics><mrow><msub><mi>C</mi><mi>opt</mi></msub><mo>&gt;</mo><msub><mi>C</mi><mi>stab</mi></msub></mrow><annotation encoding="application/x-tex">C_{\mathrm{opt}}&gt;C_{\mathrm{stab}}</annotation></semantics></math>; otherwise one may take <math id="A3.SS10.SSS0.Px1.p4.m4" class="ltx_Math" alttext="T^{*}=1" display="inline" intent=":literal"><semantics><mrow><msup><mi>T</mi><mo>∗</mo></msup><mo>=</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">T^{*}=1</annotation></semantics></math>).
Then <math id="A3.SS10.SSS0.Px1.p4.m5" class="ltx_Math" alttext="\rho^{T^{*}}\leq e\,\frac{C_{\mathrm{opt}}}{C_{\mathrm{stab}}}" display="inline" intent=":literal"><semantics><mrow><msup><mi>ρ</mi><msup><mi>T</mi><mo>∗</mo></msup></msup><mo>≤</mo><mrow><mi>e</mi><mo lspace="0.170em" rspace="0em">​</mo><mfrac><msub><mi>C</mi><mi>opt</mi></msub><msub><mi>C</mi><mi>stab</mi></msub></mfrac></mrow></mrow><annotation encoding="application/x-tex">\rho^{T^{*}}\leq e\,\frac{C_{\mathrm{opt}}}{C_{\mathrm{stab}}}</annotation></semantics></math>, and hence</p>
<table id="A3.EGx70" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A3.Ex152"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.Ex152.m1" class="ltx_Math" alttext="\displaystyle\frac{C_{\mathrm{opt}}}{T^{*}}+C_{\mathrm{stab}}\frac{\rho^{T^{*}}}{T^{*}}" display="inline" intent=":literal"><semantics><mrow><mstyle displaystyle="true"><mfrac><msub><mi>C</mi><mi>opt</mi></msub><msup><mi>T</mi><mo>∗</mo></msup></mfrac></mstyle><mo>+</mo><mrow><msub><mi>C</mi><mi>stab</mi></msub><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><msup><mi>ρ</mi><msup><mi>T</mi><mo>∗</mo></msup></msup><msup><mi>T</mi><mo>∗</mo></msup></mfrac></mstyle></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\frac{C_{\mathrm{opt}}}{T^{*}}+C_{\mathrm{stab}}\frac{\rho^{T^{*}}}{T^{*}}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex152.m2" class="ltx_Math" alttext="\displaystyle\leq\frac{C_{\mathrm{opt}}}{T^{*}}+e\,\frac{C_{\mathrm{opt}}}{T^{*}}=(1+e)\frac{C_{\mathrm{opt}}}{T^{*}}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≤</mo><mrow><mstyle displaystyle="true"><mfrac><msub><mi>C</mi><mi>opt</mi></msub><msup><mi>T</mi><mo>∗</mo></msup></mfrac></mstyle><mo>+</mo><mrow><mi>e</mi><mo lspace="0.170em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><msub><mi>C</mi><mi>opt</mi></msub><msup><mi>T</mi><mo>∗</mo></msup></mfrac></mstyle></mrow></mrow><mo>=</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><mi>e</mi></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><msub><mi>C</mi><mi>opt</mi></msub><msup><mi>T</mi><mo>∗</mo></msup></mfrac></mstyle></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\leq\frac{C_{\mathrm{opt}}}{T^{*}}+e\,\frac{C_{\mathrm{opt}}}{T^{*}}=(1+e)\frac{C_{\mathrm{opt}}}{T^{*}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A3.E118"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.E118.m1" class="ltx_Math" alttext="\displaystyle\leq(1+e)\,C_{\mathrm{opt}}\cdot\frac{\mu}{\ln(C_{\mathrm{opt}}/C_{\mathrm{stab}})}." display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>≤</mo><mrow><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><mi>e</mi></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0.170em" rspace="0em">​</mo><msub><mi>C</mi><mi>opt</mi></msub></mrow><mo lspace="0.222em" rspace="0.222em">⋅</mo><mstyle displaystyle="true"><mfrac><mi>μ</mi><mrow><mi>ln</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>C</mi><mi>opt</mi></msub><mo>/</mo><msub><mi>C</mi><mi>stab</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\leq(1+e)\,C_{\mathrm{opt}}\cdot\frac{\mu}{\ln(C_{\mathrm{opt}}/C_{\mathrm{stab}})}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(118)</span></td></tr></tbody>
</table>
<p id="A3.SS10.SSS0.Px1.p4.4" class="ltx_p">Substituting (<a href="#A3.E118" title="In Case 1: Constant learning rate. ‣ C.10 Proof of Corollary ‣ Appendix C Proof of Theorem and Corollary ‣ Stability and Generalization of Push-Sum Based Decentralized Optimization over Directed Graphs" class="ltx_ref"><span class="ltx_text ltx_ref_tag">118</span></a>) into (<a href="#A3.E116" title="In Case 1: Constant learning rate. ‣ C.10 Proof of Corollary ‣ Appendix C Proof of Theorem and Corollary ‣ Stability and Generalization of Push-Sum Based Decentralized Optimization over Directed Graphs" class="ltx_ref"><span class="ltx_text ltx_ref_tag">116</span></a>) yields the explicit bound</p>
<table id="A3.EGx71" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A3.E119"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.E119.m1" class="ltx_Math" alttext="\displaystyle\epsilon_{\mathrm{exc}}^{*}" display="inline" intent=":literal"><semantics><msubsup><mi>ϵ</mi><mi>exc</mi><mo>∗</mo></msubsup><annotation encoding="application/x-tex">\displaystyle\epsilon_{\mathrm{exc}}^{*}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.E119.m2" class="ltx_Math" alttext="\displaystyle\leq(1+e)\,C_{\mathrm{opt}}\cdot\frac{\ln\!\big(1+L\gamma-\frac{L\gamma}{mn}\big)}{\ln(C_{\mathrm{opt}}/C_{\mathrm{stab}})}+\Bigg(\frac{CG^{2}\kappa}{2\delta(1-\lambda)}+\frac{G^{2}\kappa}{4}\Bigg)\gamma," display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>≤</mo><mrow><mrow><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><mi>e</mi></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0.170em" rspace="0em">​</mo><msub><mi>C</mi><mi>opt</mi></msub></mrow><mo lspace="0.222em" rspace="0.222em">⋅</mo><mstyle displaystyle="true"><mfrac><mrow><mpadded style="width:0.748em;" width="0.748em"><mi>ln</mi></mpadded><mo>⁡</mo><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mrow><mrow><mn>1</mn><mo>+</mo><mrow><mi>L</mi><mo lspace="0em" rspace="0em">​</mo><mi>γ</mi></mrow></mrow><mo>−</mo><mfrac><mrow><mi>L</mi><mo lspace="0em" rspace="0em">​</mo><mi>γ</mi></mrow><mrow><mi>m</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow></mfrac></mrow><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow></mrow><mrow><mi>ln</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>C</mi><mi>opt</mi></msub><mo>/</mo><msub><mi>C</mi><mi>stab</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle></mrow><mo>+</mo><mrow><mrow><mo maxsize="2.600em" minsize="2.600em">(</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>G</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mi>κ</mi></mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>δ</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>λ</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle><mo>+</mo><mstyle displaystyle="true"><mfrac><mrow><msup><mi>G</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mi>κ</mi></mrow><mn>4</mn></mfrac></mstyle></mrow><mo maxsize="2.600em" minsize="2.600em">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>γ</mi></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\leq(1+e)\,C_{\mathrm{opt}}\cdot\frac{\ln\!\big(1+L\gamma-\frac{L\gamma}{mn}\big)}{\ln(C_{\mathrm{opt}}/C_{\mathrm{stab}})}+\Bigg(\frac{CG^{2}\kappa}{2\delta(1-\lambda)}+\frac{G^{2}\kappa}{4}\Bigg)\gamma,</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(119)</span></td></tr></tbody>
</table>
<p id="A3.SS10.SSS0.Px1.p4.5" class="ltx_p">where <math id="A3.SS10.SSS0.Px1.p4.m6" class="ltx_Math" alttext="C_{\mathrm{stab}}" display="inline" intent=":literal"><semantics><msub><mi>C</mi><mi>stab</mi></msub><annotation encoding="application/x-tex">C_{\mathrm{stab}}</annotation></semantics></math> is given in (<a href="#A3.E113" title="In Case 1: Constant learning rate. ‣ C.10 Proof of Corollary ‣ Appendix C Proof of Theorem and Corollary ‣ Stability and Generalization of Push-Sum Based Decentralized Optimization over Directed Graphs" class="ltx_ref"><span class="ltx_text ltx_ref_tag">113</span></a>).</p>
</div>
<div id="A3.SS10.SSS0.Px1.p5" class="ltx_para">
<p id="A3.SS10.SSS0.Px1.p5.1" class="ltx_p">Noting <math id="A3.SS10.SSS0.Px1.p5.m1" class="ltx_Math" alttext="\mu=\ln\rho=\Theta(L\gamma)" display="inline" intent=":literal"><semantics><mrow><mi>μ</mi><mo>=</mo><mrow><mi>ln</mi><mo lspace="0.167em">⁡</mo><mi>ρ</mi></mrow><mo>=</mo><mrow><mi mathvariant="normal">Θ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>L</mi><mo lspace="0em" rspace="0em">​</mo><mi>γ</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\mu=\ln\rho=\Theta(L\gamma)</annotation></semantics></math> for <math id="A3.SS10.SSS0.Px1.p5.m2" class="ltx_Math" alttext="\gamma" display="inline" intent=":literal"><semantics><mi>γ</mi><annotation encoding="application/x-tex">\gamma</annotation></semantics></math> small, the choice (<a href="#A3.E117" title="In Case 1: Constant learning rate. ‣ C.10 Proof of Corollary ‣ Appendix C Proof of Theorem and Corollary ‣ Stability and Generalization of Push-Sum Based Decentralized Optimization over Directed Graphs" class="ltx_ref"><span class="ltx_text ltx_ref_tag">117</span></a>) gives</p>
<table id="A3.Ex153" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A3.Ex153.m1" class="ltx_Math" alttext="T^{*}=\mathcal{O}\!\left(\frac{1}{L\gamma}\log\!\Big(\frac{C_{\mathrm{opt}}}{C_{\mathrm{stab}}}\Big)\right)." display="block" intent=":literal"><semantics><mrow><mrow><msup><mi>T</mi><mo>∗</mo></msup><mo>=</mo><mrow><mpadded style="width:0.654em;" width="0.654em"><mi class="ltx_font_mathcaligraphic">𝒪</mi></mpadded><mo>⁡</mo><mrow><mo>(</mo><mrow><mfrac><mn>1</mn><mrow><mi>L</mi><mo lspace="0em" rspace="0em">​</mo><mi>γ</mi></mrow></mfrac><mo lspace="0.167em" rspace="0em">​</mo><mrow><mpadded style="width:1.146em;" width="1.146em"><mi>log</mi></mpadded><mo>⁡</mo><mrow><mo maxsize="1.600em" minsize="1.600em">(</mo><mfrac><msub><mi>C</mi><mi>opt</mi></msub><msub><mi>C</mi><mi>stab</mi></msub></mfrac><mo maxsize="1.600em" minsize="1.600em">)</mo></mrow></mrow></mrow><mo>)</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">T^{*}=\mathcal{O}\!\left(\frac{1}{L\gamma}\log\!\Big(\frac{C_{\mathrm{opt}}}{C_{\mathrm{stab}}}\Big)\right).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A3.SS10.SSS0.Px1.p5.2" class="ltx_p">Moreover, since <math id="A3.SS10.SSS0.Px1.p5.m3" class="ltx_Math" alttext="\ln(C_{\mathrm{opt}}/C_{\mathrm{stab}})=\Theta(\log(1/\gamma))" display="inline" intent=":literal"><semantics><mrow><mrow><mi>ln</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>C</mi><mi>opt</mi></msub><mo>/</mo><msub><mi>C</mi><mi>stab</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mi mathvariant="normal">Θ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>log</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>/</mo><mi>γ</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\ln(C_{\mathrm{opt}}/C_{\mathrm{stab}})=\Theta(\log(1/\gamma))</annotation></semantics></math> in the typical regime,
the minimized excess risk satisfies</p>
<table id="A3.Ex154" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A3.Ex154.m1" class="ltx_Math" alttext="\epsilon_{\mathrm{exc}}^{*}=\mathcal{O}\!\left(C_{\mathrm{opt}}\cdot\frac{L\gamma}{\log(1/\gamma)}\;+\;G^{2}\kappa\,\gamma\right)=\mathcal{O}\!\left(G^{2}\kappa\,\gamma\right)\quad\text{(up to logarithmic factors).}" display="block" intent=":literal"><semantics><mrow><mrow><msubsup><mi>ϵ</mi><mi>exc</mi><mo>∗</mo></msubsup><mo>=</mo><mrow><mpadded style="width:0.654em;" width="0.654em"><mi class="ltx_font_mathcaligraphic">𝒪</mi></mpadded><mo>⁡</mo><mrow><mo>(</mo><mrow><mrow><msub><mi>C</mi><mi>opt</mi></msub><mo lspace="0.222em" rspace="0.222em">⋅</mo><mfrac><mrow><mi>L</mi><mo lspace="0em" rspace="0em">​</mo><mi>γ</mi></mrow><mrow><mi>log</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>/</mo><mi>γ</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mfrac></mrow><mo lspace="0.502em" rspace="0.502em">+</mo><mrow><msup><mi>G</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mi>κ</mi><mo lspace="0.170em" rspace="0em">​</mo><mi>γ</mi></mrow></mrow><mo>)</mo></mrow></mrow><mo>=</mo><mrow><mpadded style="width:0.654em;" width="0.654em"><mi class="ltx_font_mathcaligraphic">𝒪</mi></mpadded><mo>⁡</mo><mrow><mo>(</mo><mrow><msup><mi>G</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mi>κ</mi><mo lspace="0.170em" rspace="0em">​</mo><mi>γ</mi></mrow><mo>)</mo></mrow></mrow></mrow><mspace style="width:1em;" width="1em"></mspace><mtext>(up to logarithmic factors).</mtext></mrow><annotation encoding="application/x-tex">\epsilon_{\mathrm{exc}}^{*}=\mathcal{O}\!\left(C_{\mathrm{opt}}\cdot\frac{L\gamma}{\log(1/\gamma)}\;+\;G^{2}\kappa\,\gamma\right)=\mathcal{O}\!\left(G^{2}\kappa\,\gamma\right)\quad\text{(up to logarithmic factors).}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
</section>
<section id="A3.SS10.SSS0.Px2" class="ltx_paragraph">
<h4 class="ltx_title ltx_title_paragraph">Case 2: Decreasing Learning Rate.</h4>

<div id="A3.SS10.SSS0.Px2.p1" class="ltx_para">
<p id="A3.SS10.SSS0.Px2.p1.1" class="ltx_p">Let <math id="A3.SS10.SSS0.Px2.p1.m1" class="ltx_Math" alttext="\gamma_{t}=\frac{v}{t+1}" display="inline" intent=":literal"><semantics><mrow><msub><mi>γ</mi><mi>t</mi></msub><mo>=</mo><mfrac><mi>v</mi><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow></mfrac></mrow><annotation encoding="application/x-tex">\gamma_{t}=\frac{v}{t+1}</annotation></semantics></math>.
Recall that the averaged iterate is</p>
<table id="A3.Ex155" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A3.Ex155.m1" class="ltx_Math" alttext="\bm{w}_{\mathrm{avg}}^{(T)}=\frac{\sum_{t=0}^{T-1}\gamma_{t}\,\overline{\bm{w}}^{(t)}}{\sum_{t=0}^{T-1}\gamma_{t}},\qquad\bm{w}_{\mathrm{avg}}^{\prime(T)}=\frac{\sum_{t=0}^{T-1}\gamma_{t}\,\overline{\bm{w}}^{\prime(t)}}{\sum_{t=0}^{T-1}\gamma_{t}}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><msubsup><mi>𝒘</mi><mi>avg</mi><mrow><mo stretchy="false">(</mo><mi>T</mi><mo stretchy="false">)</mo></mrow></msubsup><mo>=</mo><mfrac><mrow><msubsup><mo>∑</mo><mrow><mi>t</mi><mo>=</mo><mn>0</mn></mrow><mrow><mi>T</mi><mo>−</mo><mn>1</mn></mrow></msubsup><mrow><msub><mi>γ</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><msup><mover accent="true"><mi>𝒘</mi><mo stretchy="true">¯</mo></mover><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup></mrow></mrow><mrow><msubsup><mo>∑</mo><mrow><mi>t</mi><mo>=</mo><mn>0</mn></mrow><mrow><mi>T</mi><mo>−</mo><mn>1</mn></mrow></msubsup><msub><mi>γ</mi><mi>t</mi></msub></mrow></mfrac></mrow><mo rspace="2.167em">,</mo><mrow><msubsup><mi>𝒘</mi><mi>avg</mi><mrow><mo rspace="0em">′</mo><mphantom></mphantom><mrow><mo stretchy="false">(</mo><mi>T</mi><mo stretchy="false">)</mo></mrow></mrow></msubsup><mo>=</mo><mfrac><mrow><msubsup><mo>∑</mo><mrow><mi>t</mi><mo>=</mo><mn>0</mn></mrow><mrow><mi>T</mi><mo>−</mo><mn>1</mn></mrow></msubsup><mrow><msub><mi>γ</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><msup><mover accent="true"><mi>𝒘</mi><mo stretchy="true">¯</mo></mover><mrow><mo rspace="0em">′</mo><mphantom></mphantom><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow></msup></mrow></mrow><mrow><msubsup><mo>∑</mo><mrow><mi>t</mi><mo>=</mo><mn>0</mn></mrow><mrow><mi>T</mi><mo>−</mo><mn>1</mn></mrow></msubsup><msub><mi>γ</mi><mi>t</mi></msub></mrow></mfrac></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\bm{w}_{\mathrm{avg}}^{(T)}=\frac{\sum_{t=0}^{T-1}\gamma_{t}\,\overline{\bm{w}}^{(t)}}{\sum_{t=0}^{T-1}\gamma_{t}},\qquad\bm{w}_{\mathrm{avg}}^{\prime(T)}=\frac{\sum_{t=0}^{T-1}\gamma_{t}\,\overline{\bm{w}}^{\prime(t)}}{\sum_{t=0}^{T-1}\gamma_{t}}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A3.SS10.SSS0.Px2.p1.2" class="ltx_p">By <math id="A3.SS10.SSS0.Px2.p1.m2" class="ltx_Math" alttext="G" display="inline" intent=":literal"><semantics><mi>G</mi><annotation encoding="application/x-tex">G</annotation></semantics></math>-Lipschitzness (Assumption <a href="#Thmtheorem17" title="Assumption 17. ‣ 4.1 Basic Assumptions ‣ 4 Theoretical Analysis ‣ Stability and Generalization of Push-Sum Based Decentralized Optimization over Directed Graphs" class="ltx_ref"><span class="ltx_text ltx_ref_tag">17</span></a>) and Jensen’s inequality,</p>
<table id="A3.EGx72" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A3.Ex156"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.Ex156.m1" class="ltx_Math" alttext="\displaystyle\epsilon_{\mathrm{ave\text{-}stab}}" display="inline" intent=":literal"><semantics><msub><mi>ϵ</mi><mrow><mi>ave</mi><mo lspace="0em" rspace="0em">​</mo><mtext>-</mtext><mo lspace="0em" rspace="0em">​</mo><mi>stab</mi></mrow></msub><annotation encoding="application/x-tex">\displaystyle\epsilon_{\mathrm{ave\text{-}stab}}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex156.m2" class="ltx_Math" alttext="\displaystyle\leq G\,\mathbb{E}\bigl\|\bm{w}_{\mathrm{avg}}^{(T)}-\bm{w}_{\mathrm{avg}}^{\prime(T)}\bigr\|=G\,\mathbb{E}\Bigl\|\frac{\sum_{t=0}^{T-1}\gamma_{t}(\overline{\bm{w}}^{(t)}-\overline{\bm{w}}^{\prime(t)})}{\sum_{t=0}^{T-1}\gamma_{t}}\Bigr\|" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≤</mo><mrow><mi>G</mi><mo lspace="0.170em" rspace="0em">​</mo><mi>𝔼</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="1.200em" minsize="1.200em" stretchy="true">‖</mo><mrow><msubsup><mi>𝒘</mi><mi>avg</mi><mrow><mo stretchy="false">(</mo><mi>T</mi><mo stretchy="false">)</mo></mrow></msubsup><mo>−</mo><msubsup><mi>𝒘</mi><mi>avg</mi><mrow><mo rspace="0em">′</mo><mphantom></mphantom><mrow><mo stretchy="false">(</mo><mi>T</mi><mo stretchy="false">)</mo></mrow></mrow></msubsup></mrow><mo maxsize="1.200em" minsize="1.200em" stretchy="true">‖</mo></mrow></mrow><mo>=</mo><mrow><mi>G</mi><mo lspace="0.170em" rspace="0em">​</mo><mi>𝔼</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="1.600em" minsize="1.600em" stretchy="true">‖</mo><mstyle displaystyle="true"><mfrac><mrow><msubsup><mo>∑</mo><mrow><mi>t</mi><mo>=</mo><mn>0</mn></mrow><mrow><mi>T</mi><mo>−</mo><mn>1</mn></mrow></msubsup><mrow><msub><mi>γ</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mover accent="true"><mi>𝒘</mi><mo stretchy="true">¯</mo></mover><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo>−</mo><msup><mover accent="true"><mi>𝒘</mi><mo stretchy="true">¯</mo></mover><mrow><mo rspace="0em">′</mo><mphantom></mphantom><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow></msup></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mrow><msubsup><mo>∑</mo><mrow><mi>t</mi><mo>=</mo><mn>0</mn></mrow><mrow><mi>T</mi><mo>−</mo><mn>1</mn></mrow></msubsup><msub><mi>γ</mi><mi>t</mi></msub></mrow></mfrac></mstyle><mo maxsize="1.600em" minsize="1.600em" stretchy="true">‖</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\leq G\,\mathbb{E}\bigl\|\bm{w}_{\mathrm{avg}}^{(T)}-\bm{w}_{\mathrm{avg}}^{\prime(T)}\bigr\|=G\,\mathbb{E}\Bigl\|\frac{\sum_{t=0}^{T-1}\gamma_{t}(\overline{\bm{w}}^{(t)}-\overline{\bm{w}}^{\prime(t)})}{\sum_{t=0}^{T-1}\gamma_{t}}\Bigr\|</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A3.E120"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.E120.m1" class="ltx_Math" alttext="\displaystyle\leq\frac{G}{\sum_{t=0}^{T-1}\gamma_{t}}\sum_{t=0}^{T-1}\gamma_{t}\,\mathbb{E}\bigl\|\overline{\bm{w}}^{(t)}-\overline{\bm{w}}^{\prime(t)}\bigr\|." display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>≤</mo><mrow><mstyle displaystyle="true"><mfrac><mi>G</mi><mrow><msubsup><mo>∑</mo><mrow><mi>t</mi><mo>=</mo><mn>0</mn></mrow><mrow><mi>T</mi><mo>−</mo><mn>1</mn></mrow></msubsup><msub><mi>γ</mi><mi>t</mi></msub></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>t</mi><mo>=</mo><mn>0</mn></mrow><mrow><mi>T</mi><mo>−</mo><mn>1</mn></mrow></munderover></mstyle><mrow><msub><mi>γ</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi>𝔼</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="1.200em" minsize="1.200em" stretchy="true">‖</mo><mrow><msup><mover accent="true"><mi>𝒘</mi><mo stretchy="true">¯</mo></mover><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo>−</mo><msup><mover accent="true"><mi>𝒘</mi><mo stretchy="true">¯</mo></mover><mrow><mo rspace="0em">′</mo><mphantom></mphantom><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow></msup></mrow><mo maxsize="1.200em" minsize="1.200em" stretchy="true">‖</mo></mrow></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\leq\frac{G}{\sum_{t=0}^{T-1}\gamma_{t}}\sum_{t=0}^{T-1}\gamma_{t}\,\mathbb{E}\bigl\|\overline{\bm{w}}^{(t)}-\overline{\bm{w}}^{\prime(t)}\bigr\|.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(120)</span></td></tr></tbody>
</table>
<p id="A3.SS10.SSS0.Px2.p1.3" class="ltx_p">For each <math id="A3.SS10.SSS0.Px2.p1.m3" class="ltx_Math" alttext="t" display="inline" intent=":literal"><semantics><mi>t</mi><annotation encoding="application/x-tex">t</annotation></semantics></math>, applying the (latest) non-convex stability bound in Corollary <a href="#Thmtheorem33" title="Corollary 33 (Uniform Stability on Common Learning Rate). ‣ 4.3 Results on Non-convex Case ‣ 4 Theoretical Analysis ‣ Stability and Generalization of Push-Sum Based Decentralized Optimization over Directed Graphs" class="ltx_ref"><span class="ltx_text ltx_ref_tag">33</span></a> at horizon <math id="A3.SS10.SSS0.Px2.p1.m4" class="ltx_Math" alttext="t" display="inline" intent=":literal"><semantics><mi>t</mi><annotation encoding="application/x-tex">t</annotation></semantics></math>
(and dividing by <math id="A3.SS10.SSS0.Px2.p1.m5" class="ltx_Math" alttext="G" display="inline" intent=":literal"><semantics><mi>G</mi><annotation encoding="application/x-tex">G</annotation></semantics></math> on both sides), we have</p>
<table id="A3.EGx73" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A3.E121"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.E121.m1" class="ltx_Math" alttext="\displaystyle\mathbb{E}\bigl\|\overline{\bm{w}}^{(t)}-\overline{\bm{w}}^{\prime(t)}\bigr\|\leq\frac{1}{G}\,\epsilon_{\mathrm{stab}}(t)" display="inline" intent=":literal"><semantics><mrow><mrow><mi>𝔼</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="1.200em" minsize="1.200em" stretchy="true">‖</mo><mrow><msup><mover accent="true"><mi>𝒘</mi><mo stretchy="true">¯</mo></mover><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo>−</mo><msup><mover accent="true"><mi>𝒘</mi><mo stretchy="true">¯</mo></mover><mrow><mo rspace="0em">′</mo><mphantom></mphantom><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow></msup></mrow><mo maxsize="1.200em" minsize="1.200em" stretchy="true">‖</mo></mrow></mrow><mo>≤</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>G</mi></mfrac></mstyle><mo lspace="0.170em" rspace="0em">​</mo><msub><mi>ϵ</mi><mi>stab</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\mathbb{E}\bigl\|\overline{\bm{w}}^{(t)}-\overline{\bm{w}}^{\prime(t)}\bigr\|\leq\frac{1}{G}\,\epsilon_{\mathrm{stab}}(t)</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.E121.m2" class="ltx_Math" alttext="\displaystyle\leq\Bigl(\frac{4Cv^{a}C_{w_{0}}}{\delta}+\frac{v^{a}}{Gmn}+\frac{4G}{mn}\Bigr)t^{p}+\frac{2GCv^{a}}{\delta(1-\lambda)}t^{q}," display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>≤</mo><mrow><mrow><mrow><mo maxsize="1.600em" minsize="1.600em">(</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mn>4</mn><mo lspace="0em" rspace="0em">​</mo><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>v</mi><mi>a</mi></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>C</mi><msub><mi>w</mi><mn>0</mn></msub></msub></mrow><mi>δ</mi></mfrac></mstyle><mo>+</mo><mstyle displaystyle="true"><mfrac><msup><mi>v</mi><mi>a</mi></msup><mrow><mi>G</mi><mo lspace="0em" rspace="0em">​</mo><mi>m</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow></mfrac></mstyle><mo>+</mo><mstyle displaystyle="true"><mfrac><mrow><mn>4</mn><mo lspace="0em" rspace="0em">​</mo><mi>G</mi></mrow><mrow><mi>m</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow></mfrac></mstyle></mrow><mo maxsize="1.600em" minsize="1.600em">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mi>t</mi><mi>p</mi></msup></mrow><mo>+</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>G</mi><mo lspace="0em" rspace="0em">​</mo><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>v</mi><mi>a</mi></msup></mrow><mrow><mi>δ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>λ</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msup><mi>t</mi><mi>q</mi></msup></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\leq\Bigl(\frac{4Cv^{a}C_{w_{0}}}{\delta}+\frac{v^{a}}{Gmn}+\frac{4G}{mn}\Bigr)t^{p}+\frac{2GCv^{a}}{\delta(1-\lambda)}t^{q},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(121)</span></td></tr></tbody>
</table>
<p id="A3.SS10.SSS0.Px2.p1.4" class="ltx_p">where we denote</p>
<table id="A3.Ex157" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A3.Ex157.m1" class="ltx_Math" alttext="a:=\frac{1}{2+vL},\qquad p:=\frac{1+vL}{2+vL}=1-a,\qquad q:=\frac{vL}{2+vL}=1-2a." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mi>a</mi><mo>:=</mo><mfrac><mn>1</mn><mrow><mn>2</mn><mo>+</mo><mrow><mi>v</mi><mo lspace="0em" rspace="0em">​</mo><mi>L</mi></mrow></mrow></mfrac></mrow><mo rspace="2.167em">,</mo><mrow><mi>p</mi><mo>:=</mo><mfrac><mrow><mn>1</mn><mo>+</mo><mrow><mi>v</mi><mo lspace="0em" rspace="0em">​</mo><mi>L</mi></mrow></mrow><mrow><mn>2</mn><mo>+</mo><mrow><mi>v</mi><mo lspace="0em" rspace="0em">​</mo><mi>L</mi></mrow></mrow></mfrac><mo>=</mo><mrow><mn>1</mn><mo>−</mo><mi>a</mi></mrow></mrow><mo rspace="2.167em">,</mo><mrow><mi>q</mi><mo>:=</mo><mfrac><mrow><mi>v</mi><mo lspace="0em" rspace="0em">​</mo><mi>L</mi></mrow><mrow><mn>2</mn><mo>+</mo><mrow><mi>v</mi><mo lspace="0em" rspace="0em">​</mo><mi>L</mi></mrow></mrow></mfrac><mo>=</mo><mrow><mn>1</mn><mo>−</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>a</mi></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">a:=\frac{1}{2+vL},\qquad p:=\frac{1+vL}{2+vL}=1-a,\qquad q:=\frac{vL}{2+vL}=1-2a.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A3.SS10.SSS0.Px2.p1.5" class="ltx_p">Substituting (<a href="#A3.E121" title="In Case 2: Decreasing Learning Rate. ‣ C.10 Proof of Corollary ‣ Appendix C Proof of Theorem and Corollary ‣ Stability and Generalization of Push-Sum Based Decentralized Optimization over Directed Graphs" class="ltx_ref"><span class="ltx_text ltx_ref_tag">121</span></a>) into (<a href="#A3.E120" title="In Case 2: Decreasing Learning Rate. ‣ C.10 Proof of Corollary ‣ Appendix C Proof of Theorem and Corollary ‣ Stability and Generalization of Push-Sum Based Decentralized Optimization over Directed Graphs" class="ltx_ref"><span class="ltx_text ltx_ref_tag">120</span></a>) and using <math id="A3.SS10.SSS0.Px2.p1.m6" class="ltx_Math" alttext="\gamma_{t}=\frac{v}{t+1}" display="inline" intent=":literal"><semantics><mrow><msub><mi>γ</mi><mi>t</mi></msub><mo>=</mo><mfrac><mi>v</mi><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow></mfrac></mrow><annotation encoding="application/x-tex">\gamma_{t}=\frac{v}{t+1}</annotation></semantics></math> yields</p>
<table id="A3.EGx74" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A3.Ex158"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.Ex158.m1" class="ltx_Math" alttext="\displaystyle\epsilon_{\mathrm{ave\text{-}stab}}" display="inline" intent=":literal"><semantics><msub><mi>ϵ</mi><mrow><mi>ave</mi><mo lspace="0em" rspace="0em">​</mo><mtext>-</mtext><mo lspace="0em" rspace="0em">​</mo><mi>stab</mi></mrow></msub><annotation encoding="application/x-tex">\displaystyle\epsilon_{\mathrm{ave\text{-}stab}}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex158.m2" class="ltx_Math" alttext="\displaystyle\leq\frac{G}{\sum_{t=0}^{T-1}\frac{v}{t+1}}\sum_{t=0}^{T-1}\frac{v}{t+1}\Biggl[\Bigl(\frac{4Cv^{a}C_{w_{0}}}{\delta}+\frac{v^{a}}{Gmn}+\frac{4G}{mn}\Bigr)t^{p}+\frac{2GCv^{a}}{\delta(1-\lambda)}t^{q}\Biggr]" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≤</mo><mrow><mstyle displaystyle="true"><mfrac><mi>G</mi><mrow><msubsup><mo>∑</mo><mrow><mi>t</mi><mo>=</mo><mn>0</mn></mrow><mrow><mi>T</mi><mo>−</mo><mn>1</mn></mrow></msubsup><mfrac><mi>v</mi><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow></mfrac></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>t</mi><mo>=</mo><mn>0</mn></mrow><mrow><mi>T</mi><mo>−</mo><mn>1</mn></mrow></munderover></mstyle><mrow><mstyle displaystyle="true"><mfrac><mi>v</mi><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="2.600em" minsize="2.600em">[</mo><mrow><mrow><mrow><mo maxsize="1.600em" minsize="1.600em">(</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mn>4</mn><mo lspace="0em" rspace="0em">​</mo><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>v</mi><mi>a</mi></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>C</mi><msub><mi>w</mi><mn>0</mn></msub></msub></mrow><mi>δ</mi></mfrac></mstyle><mo>+</mo><mstyle displaystyle="true"><mfrac><msup><mi>v</mi><mi>a</mi></msup><mrow><mi>G</mi><mo lspace="0em" rspace="0em">​</mo><mi>m</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow></mfrac></mstyle><mo>+</mo><mstyle displaystyle="true"><mfrac><mrow><mn>4</mn><mo lspace="0em" rspace="0em">​</mo><mi>G</mi></mrow><mrow><mi>m</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow></mfrac></mstyle></mrow><mo maxsize="1.600em" minsize="1.600em">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mi>t</mi><mi>p</mi></msup></mrow><mo>+</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>G</mi><mo lspace="0em" rspace="0em">​</mo><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>v</mi><mi>a</mi></msup></mrow><mrow><mi>δ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>λ</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msup><mi>t</mi><mi>q</mi></msup></mrow></mrow><mo maxsize="2.600em" minsize="2.600em">]</mo></mrow></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\leq\frac{G}{\sum_{t=0}^{T-1}\frac{v}{t+1}}\sum_{t=0}^{T-1}\frac{v}{t+1}\Biggl[\Bigl(\frac{4Cv^{a}C_{w_{0}}}{\delta}+\frac{v^{a}}{Gmn}+\frac{4G}{mn}\Bigr)t^{p}+\frac{2GCv^{a}}{\delta(1-\lambda)}t^{q}\Biggr]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A3.E122"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.E122.m1" class="ltx_Math" alttext="\displaystyle=\frac{G}{\sum_{t=0}^{T-1}\frac{1}{t+1}}\Biggl[\Bigl(\frac{4Cv^{a}C_{w_{0}}}{\delta}+\frac{v^{a}}{Gmn}+\frac{4G}{mn}\Bigr)\sum_{t=1}^{T-1}t^{p-1}+\frac{2GCv^{a}}{\delta(1-\lambda)}\sum_{t=1}^{T-1}t^{q-1}\Biggr]." display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>=</mo><mrow><mstyle displaystyle="true"><mfrac><mi>G</mi><mrow><msubsup><mo>∑</mo><mrow><mi>t</mi><mo>=</mo><mn>0</mn></mrow><mrow><mi>T</mi><mo>−</mo><mn>1</mn></mrow></msubsup><mfrac><mn>1</mn><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow></mfrac></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="2.600em" minsize="2.600em">[</mo><mrow><mrow><mrow><mo maxsize="1.600em" minsize="1.600em">(</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mn>4</mn><mo lspace="0em" rspace="0em">​</mo><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>v</mi><mi>a</mi></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>C</mi><msub><mi>w</mi><mn>0</mn></msub></msub></mrow><mi>δ</mi></mfrac></mstyle><mo>+</mo><mstyle displaystyle="true"><mfrac><msup><mi>v</mi><mi>a</mi></msup><mrow><mi>G</mi><mo lspace="0em" rspace="0em">​</mo><mi>m</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow></mfrac></mstyle><mo>+</mo><mstyle displaystyle="true"><mfrac><mrow><mn>4</mn><mo lspace="0em" rspace="0em">​</mo><mi>G</mi></mrow><mrow><mi>m</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow></mfrac></mstyle></mrow><mo maxsize="1.600em" minsize="1.600em">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>t</mi><mo>=</mo><mn>1</mn></mrow><mrow><mi>T</mi><mo>−</mo><mn>1</mn></mrow></munderover></mstyle><msup><mi>t</mi><mrow><mi>p</mi><mo>−</mo><mn>1</mn></mrow></msup></mrow></mrow><mo>+</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>G</mi><mo lspace="0em" rspace="0em">​</mo><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>v</mi><mi>a</mi></msup></mrow><mrow><mi>δ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>λ</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>t</mi><mo>=</mo><mn>1</mn></mrow><mrow><mi>T</mi><mo>−</mo><mn>1</mn></mrow></munderover></mstyle><msup><mi>t</mi><mrow><mi>q</mi><mo>−</mo><mn>1</mn></mrow></msup></mrow></mrow></mrow><mo maxsize="2.600em" minsize="2.600em">]</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle=\frac{G}{\sum_{t=0}^{T-1}\frac{1}{t+1}}\Biggl[\Bigl(\frac{4Cv^{a}C_{w_{0}}}{\delta}+\frac{v^{a}}{Gmn}+\frac{4G}{mn}\Bigr)\sum_{t=1}^{T-1}t^{p-1}+\frac{2GCv^{a}}{\delta(1-\lambda)}\sum_{t=1}^{T-1}t^{q-1}\Biggr].</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(122)</span></td></tr></tbody>
</table>
<p id="A3.SS10.SSS0.Px2.p1.6" class="ltx_p">Next, we bound the denominator and the two power sums by integrals. For <math id="A3.SS10.SSS0.Px2.p1.m7" class="ltx_Math" alttext="T\geq 3" display="inline" intent=":literal"><semantics><mrow><mi>T</mi><mo>≥</mo><mn>3</mn></mrow><annotation encoding="application/x-tex">T\geq 3</annotation></semantics></math>, the harmonic lower bound gives</p>
<table id="A3.Ex159" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A3.Ex159.m1" class="ltx_Math" alttext="\sum_{t=0}^{T-1}\frac{1}{t+1}\geq\frac{1}{2}\ln T," display="block" intent=":literal"><semantics><mrow><mrow><mrow><munderover><mo movablelimits="false">∑</mo><mrow><mi>t</mi><mo>=</mo><mn>0</mn></mrow><mrow><mi>T</mi><mo>−</mo><mn>1</mn></mrow></munderover><mfrac><mn>1</mn><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow></mfrac></mrow><mo>≥</mo><mrow><mfrac><mn>1</mn><mn>2</mn></mfrac><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>ln</mi><mo lspace="0.167em">⁡</mo><mi>T</mi></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\sum_{t=0}^{T-1}\frac{1}{t+1}\geq\frac{1}{2}\ln T,</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A3.SS10.SSS0.Px2.p1.7" class="ltx_p">and for any <math id="A3.SS10.SSS0.Px2.p1.m8" class="ltx_Math" alttext="\theta\in(0,1]" display="inline" intent=":literal"><semantics><mrow><mi>θ</mi><mo>∈</mo><mrow><mo stretchy="false">(</mo><mn>0</mn><mo>,</mo><mn>1</mn><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">\theta\in(0,1]</annotation></semantics></math>,</p>
<table id="A3.Ex160" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A3.Ex160.m1" class="ltx_Math" alttext="\sum_{t=1}^{T-1}t^{\theta-1}\leq 1+\int_{1}^{T}x^{\theta-1}\,dx=1+\frac{T^{\theta}-1}{\theta}\leq\frac{2}{\theta}T^{\theta}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><munderover><mo movablelimits="false">∑</mo><mrow><mi>t</mi><mo>=</mo><mn>1</mn></mrow><mrow><mi>T</mi><mo>−</mo><mn>1</mn></mrow></munderover><msup><mi>t</mi><mrow><mi>θ</mi><mo>−</mo><mn>1</mn></mrow></msup></mrow><mo>≤</mo><mrow><mn>1</mn><mo rspace="0.055em">+</mo><mrow><msubsup><mo>∫</mo><mn>1</mn><mi>T</mi></msubsup><mrow><msup><mi>x</mi><mrow><mi>θ</mi><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo rspace="0em">𝑑</mo><mi>x</mi></mrow></mrow></mrow></mrow><mo>=</mo><mrow><mn>1</mn><mo>+</mo><mfrac><mrow><msup><mi>T</mi><mi>θ</mi></msup><mo>−</mo><mn>1</mn></mrow><mi>θ</mi></mfrac></mrow><mo>≤</mo><mrow><mfrac><mn>2</mn><mi>θ</mi></mfrac><mo lspace="0em" rspace="0em">​</mo><msup><mi>T</mi><mi>θ</mi></msup></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\sum_{t=1}^{T-1}t^{\theta-1}\leq 1+\int_{1}^{T}x^{\theta-1}\,dx=1+\frac{T^{\theta}-1}{\theta}\leq\frac{2}{\theta}T^{\theta}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A3.SS10.SSS0.Px2.p1.8" class="ltx_p">Applying these with <math id="A3.SS10.SSS0.Px2.p1.m9" class="ltx_Math" alttext="\theta=p" display="inline" intent=":literal"><semantics><mrow><mi>θ</mi><mo>=</mo><mi>p</mi></mrow><annotation encoding="application/x-tex">\theta=p</annotation></semantics></math> and <math id="A3.SS10.SSS0.Px2.p1.m10" class="ltx_Math" alttext="\theta=q" display="inline" intent=":literal"><semantics><mrow><mi>θ</mi><mo>=</mo><mi>q</mi></mrow><annotation encoding="application/x-tex">\theta=q</annotation></semantics></math> to (<a href="#A3.E122" title="In Case 2: Decreasing Learning Rate. ‣ C.10 Proof of Corollary ‣ Appendix C Proof of Theorem and Corollary ‣ Stability and Generalization of Push-Sum Based Decentralized Optimization over Directed Graphs" class="ltx_ref"><span class="ltx_text ltx_ref_tag">122</span></a>) yields</p>
<table id="A3.EGx75" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A3.Ex161"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.Ex161.m1" class="ltx_Math" alttext="\displaystyle\epsilon_{\mathrm{ave\text{-}stab}}" display="inline" intent=":literal"><semantics><msub><mi>ϵ</mi><mrow><mi>ave</mi><mo lspace="0em" rspace="0em">​</mo><mtext>-</mtext><mo lspace="0em" rspace="0em">​</mo><mi>stab</mi></mrow></msub><annotation encoding="application/x-tex">\displaystyle\epsilon_{\mathrm{ave\text{-}stab}}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex161.m2" class="ltx_Math" alttext="\displaystyle\leq\frac{2G}{\ln T}\Biggl[\Bigl(\frac{4Cv^{a}C_{w_{0}}}{\delta}+\frac{v^{a}}{Gmn}+\frac{4G}{mn}\Bigr)\cdot\frac{2}{p}T^{p}+\frac{2GCv^{a}}{\delta(1-\lambda)}\cdot\frac{2}{q}T^{q}\Biggr]" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≤</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>G</mi></mrow><mrow><mi>ln</mi><mo lspace="0.167em">⁡</mo><mi>T</mi></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="2.600em" minsize="2.600em">[</mo><mrow><mrow><mrow><mrow><mo maxsize="1.600em" minsize="1.600em">(</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mn>4</mn><mo lspace="0em" rspace="0em">​</mo><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>v</mi><mi>a</mi></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>C</mi><msub><mi>w</mi><mn>0</mn></msub></msub></mrow><mi>δ</mi></mfrac></mstyle><mo>+</mo><mstyle displaystyle="true"><mfrac><msup><mi>v</mi><mi>a</mi></msup><mrow><mi>G</mi><mo lspace="0em" rspace="0em">​</mo><mi>m</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow></mfrac></mstyle><mo>+</mo><mstyle displaystyle="true"><mfrac><mrow><mn>4</mn><mo lspace="0em" rspace="0em">​</mo><mi>G</mi></mrow><mrow><mi>m</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow></mfrac></mstyle></mrow><mo maxsize="1.600em" minsize="1.600em" rspace="0.055em">)</mo></mrow><mo rspace="0.222em">⋅</mo><mstyle displaystyle="true"><mfrac><mn>2</mn><mi>p</mi></mfrac></mstyle></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mi>T</mi><mi>p</mi></msup></mrow><mo>+</mo><mrow><mrow><mstyle displaystyle="true"><mfrac><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>G</mi><mo lspace="0em" rspace="0em">​</mo><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>v</mi><mi>a</mi></msup></mrow><mrow><mi>δ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>λ</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle><mo lspace="0.222em" rspace="0.222em">⋅</mo><mstyle displaystyle="true"><mfrac><mn>2</mn><mi>q</mi></mfrac></mstyle></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mi>T</mi><mi>q</mi></msup></mrow></mrow><mo maxsize="2.600em" minsize="2.600em">]</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\leq\frac{2G}{\ln T}\Biggl[\Bigl(\frac{4Cv^{a}C_{w_{0}}}{\delta}+\frac{v^{a}}{Gmn}+\frac{4G}{mn}\Bigr)\cdot\frac{2}{p}T^{p}+\frac{2GCv^{a}}{\delta(1-\lambda)}\cdot\frac{2}{q}T^{q}\Biggr]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A3.E123"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.E123.m1" class="ltx_Math" alttext="\displaystyle\leq\frac{K_{\mathrm{stab},1}\,T^{p}+K_{\mathrm{stab},2}\,T^{q}}{\ln T}," display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>≤</mo><mstyle displaystyle="true"><mfrac><mrow><mrow><msub><mi>K</mi><mrow><mi>stab</mi><mo>,</mo><mn>1</mn></mrow></msub><mo lspace="0.170em" rspace="0em">​</mo><msup><mi>T</mi><mi>p</mi></msup></mrow><mo>+</mo><mrow><msub><mi>K</mi><mrow><mi>stab</mi><mo>,</mo><mn>2</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msup><mi>T</mi><mi>q</mi></msup></mrow></mrow><mrow><mi>ln</mi><mo lspace="0.167em">⁡</mo><mi>T</mi></mrow></mfrac></mstyle></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\leq\frac{K_{\mathrm{stab},1}\,T^{p}+K_{\mathrm{stab},2}\,T^{q}}{\ln T},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(123)</span></td></tr></tbody>
</table>
<p id="A3.SS10.SSS0.Px2.p1.9" class="ltx_p">where we set the explicit constants</p>
<table id="A3.Ex162" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A3.Ex162.m1" class="ltx_Math" alttext="K_{\mathrm{stab},1}:=\frac{4G}{p}\Bigl(\frac{4Cv^{a}C_{w_{0}}}{\delta}+\frac{v^{a}}{Gmn}+\frac{4G}{mn}\Bigr),\qquad K_{\mathrm{stab},2}:=\frac{8G^{2}Cv^{a}}{q\,\delta(1-\lambda)}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><msub><mi>K</mi><mrow><mi>stab</mi><mo>,</mo><mn>1</mn></mrow></msub><mo>:=</mo><mrow><mfrac><mrow><mn>4</mn><mo lspace="0em" rspace="0em">​</mo><mi>G</mi></mrow><mi>p</mi></mfrac><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="1.600em" minsize="1.600em">(</mo><mrow><mfrac><mrow><mn>4</mn><mo lspace="0em" rspace="0em">​</mo><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>v</mi><mi>a</mi></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>C</mi><msub><mi>w</mi><mn>0</mn></msub></msub></mrow><mi>δ</mi></mfrac><mo>+</mo><mfrac><msup><mi>v</mi><mi>a</mi></msup><mrow><mi>G</mi><mo lspace="0em" rspace="0em">​</mo><mi>m</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow></mfrac><mo>+</mo><mfrac><mrow><mn>4</mn><mo lspace="0em" rspace="0em">​</mo><mi>G</mi></mrow><mrow><mi>m</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow></mfrac></mrow><mo maxsize="1.600em" minsize="1.600em">)</mo></mrow></mrow></mrow><mo rspace="2.167em">,</mo><mrow><msub><mi>K</mi><mrow><mi>stab</mi><mo>,</mo><mn>2</mn></mrow></msub><mo>:=</mo><mfrac><mrow><mn>8</mn><mo lspace="0em" rspace="0em">​</mo><msup><mi>G</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>v</mi><mi>a</mi></msup></mrow><mrow><mi>q</mi><mo lspace="0.170em" rspace="0em">​</mo><mi>δ</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>λ</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mfrac></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">K_{\mathrm{stab},1}:=\frac{4G}{p}\Bigl(\frac{4Cv^{a}C_{w_{0}}}{\delta}+\frac{v^{a}}{Gmn}+\frac{4G}{mn}\Bigr),\qquad K_{\mathrm{stab},2}:=\frac{8G^{2}Cv^{a}}{q\,\delta(1-\lambda)}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="A3.SS10.SSS0.Px2.p2" class="ltx_para">
<p id="A3.SS10.SSS0.Px2.p2.1" class="ltx_p">Combining (<a href="#A3.E123" title="In Case 2: Decreasing Learning Rate. ‣ C.10 Proof of Corollary ‣ Appendix C Proof of Theorem and Corollary ‣ Stability and Generalization of Push-Sum Based Decentralized Optimization over Directed Graphs" class="ltx_ref"><span class="ltx_text ltx_ref_tag">123</span></a>) with the optimization error bound in Corollary <a href="#Thmtheorem38" title="Corollary 38 (Optimization Error on Common Learning Rate). ‣ 4.3 Results on Non-convex Case ‣ 4 Theoretical Analysis ‣ Stability and Generalization of Push-Sum Based Decentralized Optimization over Directed Graphs" class="ltx_ref"><span class="ltx_text ltx_ref_tag">38</span></a>,</p>
<table id="A3.Ex163" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A3.Ex163.m1" class="ltx_Math" alttext="\epsilon_{\mathrm{opt}}\leq\frac{K_{\mathrm{opt}}}{\ln T}," display="block" intent=":literal"><semantics><mrow><mrow><msub><mi>ϵ</mi><mi>opt</mi></msub><mo>≤</mo><mfrac><msub><mi>K</mi><mi>opt</mi></msub><mrow><mi>ln</mi><mo lspace="0.167em">⁡</mo><mi>T</mi></mrow></mfrac></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\epsilon_{\mathrm{opt}}\leq\frac{K_{\mathrm{opt}}}{\ln T},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A3.SS10.SSS0.Px2.p2.2" class="ltx_p">we obtain the excess risk bound</p>
<table id="A3.EGx76" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A3.E124"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.E124.m1" class="ltx_Math" alttext="\displaystyle\epsilon_{\mathrm{exc}}\leq\epsilon_{\mathrm{ave\text{-}stab}}+\epsilon_{\mathrm{opt}}\leq\frac{K_{\mathrm{stab},1}\,T^{p}+K_{\mathrm{stab},2}\,T^{q}+K_{\mathrm{opt}}}{\ln T}." display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>ϵ</mi><mi>exc</mi></msub><mo>≤</mo><mrow><msub><mi>ϵ</mi><mrow><mi>ave</mi><mo lspace="0em" rspace="0em">​</mo><mtext>-</mtext><mo lspace="0em" rspace="0em">​</mo><mi>stab</mi></mrow></msub><mo>+</mo><msub><mi>ϵ</mi><mi>opt</mi></msub></mrow><mo>≤</mo><mstyle displaystyle="true"><mfrac><mrow><mrow><msub><mi>K</mi><mrow><mi>stab</mi><mo>,</mo><mn>1</mn></mrow></msub><mo lspace="0.170em" rspace="0em">​</mo><msup><mi>T</mi><mi>p</mi></msup></mrow><mo>+</mo><mrow><msub><mi>K</mi><mrow><mi>stab</mi><mo>,</mo><mn>2</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msup><mi>T</mi><mi>q</mi></msup></mrow><mo>+</mo><msub><mi>K</mi><mi>opt</mi></msub></mrow><mrow><mi>ln</mi><mo lspace="0.167em">⁡</mo><mi>T</mi></mrow></mfrac></mstyle></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\epsilon_{\mathrm{exc}}\leq\epsilon_{\mathrm{ave\text{-}stab}}+\epsilon_{\mathrm{opt}}\leq\frac{K_{\mathrm{stab},1}\,T^{p}+K_{\mathrm{stab},2}\,T^{q}+K_{\mathrm{opt}}}{\ln T}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(124)</span></td></tr></tbody>
</table>
</div>
<div id="A3.SS10.SSS0.Px2.p3" class="ltx_para">
<p id="A3.SS10.SSS0.Px2.p3.1" class="ltx_p">Finally, since <math id="A3.SS10.SSS0.Px2.p3.m1" class="ltx_Math" alttext="p&gt;q" display="inline" intent=":literal"><semantics><mrow><mi>p</mi><mo>&gt;</mo><mi>q</mi></mrow><annotation encoding="application/x-tex">p&gt;q</annotation></semantics></math>, the dominant stability growth is <math id="A3.SS10.SSS0.Px2.p3.m2" class="ltx_Math" alttext="T^{p}" display="inline" intent=":literal"><semantics><msup><mi>T</mi><mi>p</mi></msup><annotation encoding="application/x-tex">T^{p}</annotation></semantics></math>. Define</p>
<table id="A3.Ex164" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A3.Ex164.m1" class="ltx_Math" alttext="K_{\mathrm{stab}}:=K_{\mathrm{stab},1}+K_{\mathrm{stab},2}." display="block" intent=":literal"><semantics><mrow><mrow><msub><mi>K</mi><mi>stab</mi></msub><mo>:=</mo><mrow><msub><mi>K</mi><mrow><mi>stab</mi><mo>,</mo><mn>1</mn></mrow></msub><mo>+</mo><msub><mi>K</mi><mrow><mi>stab</mi><mo>,</mo><mn>2</mn></mrow></msub></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">K_{\mathrm{stab}}:=K_{\mathrm{stab},1}+K_{\mathrm{stab},2}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A3.SS10.SSS0.Px2.p3.2" class="ltx_p">Then (<a href="#A3.E124" title="In Case 2: Decreasing Learning Rate. ‣ C.10 Proof of Corollary ‣ Appendix C Proof of Theorem and Corollary ‣ Stability and Generalization of Push-Sum Based Decentralized Optimization over Directed Graphs" class="ltx_ref"><span class="ltx_text ltx_ref_tag">124</span></a>) implies</p>
<table id="A3.Ex165" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A3.Ex165.m1" class="ltx_Math" alttext="\epsilon_{\mathrm{exc}}\leq\frac{K_{\mathrm{stab}}\,T^{p}+K_{\mathrm{opt}}}{\ln T}." display="block" intent=":literal"><semantics><mrow><mrow><msub><mi>ϵ</mi><mi>exc</mi></msub><mo>≤</mo><mfrac><mrow><mrow><msub><mi>K</mi><mi>stab</mi></msub><mo lspace="0.170em" rspace="0em">​</mo><msup><mi>T</mi><mi>p</mi></msup></mrow><mo>+</mo><msub><mi>K</mi><mi>opt</mi></msub></mrow><mrow><mi>ln</mi><mo lspace="0.167em">⁡</mo><mi>T</mi></mrow></mfrac></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\epsilon_{\mathrm{exc}}\leq\frac{K_{\mathrm{stab}}\,T^{p}+K_{\mathrm{opt}}}{\ln T}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A3.SS10.SSS0.Px2.p3.3" class="ltx_p">Treating the right-hand side as <math id="A3.SS10.SSS0.Px2.p3.m3" class="ltx_Math" alttext="f(T)=(K_{\mathrm{stab}}T^{p}+K_{\mathrm{opt}})/\ln T" display="inline" intent=":literal"><semantics><mrow><mrow><mi>f</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>T</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mrow><msub><mi>K</mi><mi>stab</mi></msub><mo lspace="0em" rspace="0em">​</mo><msup><mi>T</mi><mi>p</mi></msup></mrow><mo>+</mo><msub><mi>K</mi><mi>opt</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mo>/</mo><mrow><mi>ln</mi><mo lspace="0.167em">⁡</mo><mi>T</mi></mrow></mrow></mrow><annotation encoding="application/x-tex">f(T)=(K_{\mathrm{stab}}T^{p}+K_{\mathrm{opt}})/\ln T</annotation></semantics></math> and using the standard balance condition
(at the minimizer, the two contributions are comparable up to a <math id="A3.SS10.SSS0.Px2.p3.m4" class="ltx_Math" alttext="\ln T" display="inline" intent=":literal"><semantics><mrow><mi>ln</mi><mo lspace="0.167em">⁡</mo><mi>T</mi></mrow><annotation encoding="application/x-tex">\ln T</annotation></semantics></math> factor),</p>
<table id="A3.Ex166" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A3.Ex166.m1" class="ltx_Math" alttext="p\,K_{\mathrm{stab}}T^{p}\ln T\approx K_{\mathrm{opt}}," display="block" intent=":literal"><semantics><mrow><mrow><mrow><mi>p</mi><mo lspace="0.170em" rspace="0em">​</mo><msub><mi>K</mi><mi>stab</mi></msub><mo lspace="0em" rspace="0em">​</mo><msup><mi>T</mi><mi>p</mi></msup><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>ln</mi><mo lspace="0.167em">⁡</mo><mi>T</mi></mrow></mrow><mo>≈</mo><msub><mi>K</mi><mi>opt</mi></msub></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">p\,K_{\mathrm{stab}}T^{p}\ln T\approx K_{\mathrm{opt}},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A3.SS10.SSS0.Px2.p3.4" class="ltx_p">we obtain the explicit stopping time</p>
<table id="A3.E125" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A3.E125.m1" class="ltx_Math" alttext="T^{*}:=\left(\frac{K_{\mathrm{opt}}}{pK_{\mathrm{stab}}\ln\!\Big(\frac{K_{\mathrm{opt}}}{pK_{\mathrm{stab}}}\Big)}\right)^{\!\frac{1}{p}}\quad(\text{for }\tfrac{K_{\mathrm{opt}}}{pK_{\mathrm{stab}}}\geq e)," display="block" intent=":literal"><semantics><mrow><mrow><mrow><msup><mi>T</mi><mo>∗</mo></msup><mo>:=</mo><msup><mrow><mo>(</mo><mfrac><msub><mi>K</mi><mi>opt</mi></msub><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>K</mi><mi>stab</mi></msub><mo lspace="0.167em" rspace="0em">​</mo><mrow><mpadded style="width:0.748em;" width="0.748em"><mi>ln</mi></mpadded><mo>⁡</mo><mrow><mo maxsize="1.600em" minsize="1.600em">(</mo><mfrac><msub><mi>K</mi><mi>opt</mi></msub><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>K</mi><mi>stab</mi></msub></mrow></mfrac><mo maxsize="1.600em" minsize="1.600em">)</mo></mrow></mrow></mrow></mfrac><mo>)</mo></mrow><mfrac><mn>1</mn><mi>p</mi></mfrac></msup></mrow><mspace style="width:1em;" width="1em"></mspace><mrow><mo stretchy="false">(</mo><mrow><mrow><mtext>for </mtext><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="false"><mfrac><msub><mi>K</mi><mi>opt</mi></msub><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>K</mi><mi>stab</mi></msub></mrow></mfrac></mstyle></mrow><mo>≥</mo><mi>e</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">T^{*}:=\left(\frac{K_{\mathrm{opt}}}{pK_{\mathrm{stab}}\ln\!\Big(\frac{K_{\mathrm{opt}}}{pK_{\mathrm{stab}}}\Big)}\right)^{\!\frac{1}{p}}\quad(\text{for }\tfrac{K_{\mathrm{opt}}}{pK_{\mathrm{stab}}}\geq e),</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(125)</span></td></tr></tbody>
</table>
<p id="A3.SS10.SSS0.Px2.p3.5" class="ltx_p">and substituting <math id="A3.SS10.SSS0.Px2.p3.m5" class="ltx_Math" alttext="T^{*}" display="inline" intent=":literal"><semantics><msup><mi>T</mi><mo>∗</mo></msup><annotation encoding="application/x-tex">T^{*}</annotation></semantics></math> back gives an explicit minimum bound</p>
<table id="A3.EGx77" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A3.E126"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.E126.m1" class="ltx_Math" alttext="\displaystyle\epsilon_{\mathrm{exc}}^{*}\leq\frac{p\,K_{\mathrm{opt}}}{\ln\!\Big(\frac{K_{\mathrm{opt}}}{pK_{\mathrm{stab}}}\Big)}." display="inline" intent=":literal"><semantics><mrow><mrow><msubsup><mi>ϵ</mi><mi>exc</mi><mo>∗</mo></msubsup><mo>≤</mo><mstyle displaystyle="true"><mfrac><mrow><mi>p</mi><mo lspace="0.170em" rspace="0em">​</mo><msub><mi>K</mi><mi>opt</mi></msub></mrow><mrow><mpadded style="width:0.748em;" width="0.748em"><mi>ln</mi></mpadded><mo>⁡</mo><mrow><mo maxsize="1.600em" minsize="1.600em">(</mo><mfrac><msub><mi>K</mi><mi>opt</mi></msub><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>K</mi><mi>stab</mi></msub></mrow></mfrac><mo maxsize="1.600em" minsize="1.600em">)</mo></mrow></mrow></mfrac></mstyle></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\epsilon_{\mathrm{exc}}^{*}\leq\frac{p\,K_{\mathrm{opt}}}{\ln\!\Big(\frac{K_{\mathrm{opt}}}{pK_{\mathrm{stab}}}\Big)}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(126)</span></td></tr></tbody>
</table>
</div>
<div id="A3.SS10.SSS0.Px2.p4" class="ltx_para">
<p id="A3.SS10.SSS0.Px2.p4.1" class="ltx_p">Ignoring only logarithmic factors, the optimal stopping time is determined by
balancing the two terms <math id="A3.SS10.SSS0.Px2.p4.m1" class="ltx_Math" alttext="K_{\mathrm{stab}}T^{p}\approx K_{\mathrm{opt}}" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>K</mi><mi>stab</mi></msub><mo lspace="0em" rspace="0em">​</mo><msup><mi>T</mi><mi>p</mi></msup></mrow><mo>≈</mo><msub><mi>K</mi><mi>opt</mi></msub></mrow><annotation encoding="application/x-tex">K_{\mathrm{stab}}T^{p}\approx K_{\mathrm{opt}}</annotation></semantics></math>, which yields</p>
<table id="A3.Ex167" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A3.Ex167.m1" class="ltx_Math" alttext="T^{*}=\tilde{\mathcal{O}}\!\left(\left(\frac{\frac{rG}{v\alpha}+\frac{CG\kappa C_{w_{0}}}{\delta(1-\lambda)}+\frac{vG^{2}\kappa}{\delta(1-\lambda)}+\frac{vG^{2}}{\alpha}}{\frac{GC_{w_{0}}}{\delta}+\frac{G^{2}}{mn}+\frac{G^{2}}{\delta(1-\lambda)}}\right)^{\!\frac{1}{p}}\right)." display="block" intent=":literal"><semantics><mrow><mrow><msup><mi>T</mi><mo>∗</mo></msup><mo>=</mo><mrow><mover accent="true"><mi class="ltx_font_mathcaligraphic">𝒪</mi><mo>~</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><msup><mrow><mo>(</mo><mfrac><mrow><mfrac><mrow><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>G</mi></mrow><mrow><mi>v</mi><mo lspace="0em" rspace="0em">​</mo><mi>α</mi></mrow></mfrac><mo>+</mo><mfrac><mrow><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><mi>G</mi><mo lspace="0em" rspace="0em">​</mo><mi>κ</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>C</mi><msub><mi>w</mi><mn>0</mn></msub></msub></mrow><mrow><mi>δ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>λ</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mfrac><mo>+</mo><mfrac><mrow><mi>v</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>G</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mi>κ</mi></mrow><mrow><mi>δ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>λ</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mfrac><mo>+</mo><mfrac><mrow><mi>v</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>G</mi><mn>2</mn></msup></mrow><mi>α</mi></mfrac></mrow><mrow><mfrac><mrow><mi>G</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>C</mi><msub><mi>w</mi><mn>0</mn></msub></msub></mrow><mi>δ</mi></mfrac><mo>+</mo><mfrac><msup><mi>G</mi><mn>2</mn></msup><mrow><mi>m</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow></mfrac><mo>+</mo><mfrac><msup><mi>G</mi><mn>2</mn></msup><mrow><mi>δ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>λ</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mfrac></mrow></mfrac><mo>)</mo></mrow><mfrac><mn>1</mn><mi>p</mi></mfrac></msup><mo>)</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">T^{*}=\tilde{\mathcal{O}}\!\left(\left(\frac{\frac{rG}{v\alpha}+\frac{CG\kappa C_{w_{0}}}{\delta(1-\lambda)}+\frac{vG^{2}\kappa}{\delta(1-\lambda)}+\frac{vG^{2}}{\alpha}}{\frac{GC_{w_{0}}}{\delta}+\frac{G^{2}}{mn}+\frac{G^{2}}{\delta(1-\lambda)}}\right)^{\!\frac{1}{p}}\right).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="A3.SS10.SSS0.Px2.p5" class="ltx_para">
<p id="A3.SS10.SSS0.Px2.p5.1" class="ltx_p">Substituting <math id="A3.SS10.SSS0.Px2.p5.m1" class="ltx_Math" alttext="T^{*}" display="inline" intent=":literal"><semantics><msup><mi>T</mi><mo>∗</mo></msup><annotation encoding="application/x-tex">T^{*}</annotation></semantics></math> back, the minimized excess risk satisfies</p>
<table id="A3.Ex168" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A3.Ex168.m1" class="ltx_Math" alttext="\epsilon_{\mathrm{exc}}^{*}=\tilde{\mathcal{O}}\!\left(\frac{rG}{v\alpha}+\frac{CG\kappa C_{w_{0}}}{\delta(1-\lambda)}+\frac{vG^{2}\kappa}{\delta(1-\lambda)}+\frac{vG^{2}}{\alpha}\right)," display="block" intent=":literal"><semantics><mrow><mrow><msubsup><mi>ϵ</mi><mi>exc</mi><mo>∗</mo></msubsup><mo>=</mo><mrow><mover accent="true"><mi class="ltx_font_mathcaligraphic">𝒪</mi><mo>~</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mfrac><mrow><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>G</mi></mrow><mrow><mi>v</mi><mo lspace="0em" rspace="0em">​</mo><mi>α</mi></mrow></mfrac><mo>+</mo><mfrac><mrow><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><mi>G</mi><mo lspace="0em" rspace="0em">​</mo><mi>κ</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>C</mi><msub><mi>w</mi><mn>0</mn></msub></msub></mrow><mrow><mi>δ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>λ</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mfrac><mo>+</mo><mfrac><mrow><mi>v</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>G</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mi>κ</mi></mrow><mrow><mi>δ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>λ</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mfrac><mo>+</mo><mfrac><mrow><mi>v</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>G</mi><mn>2</mn></msup></mrow><mi>α</mi></mfrac></mrow><mo>)</mo></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\epsilon_{\mathrm{exc}}^{*}=\tilde{\mathcal{O}}\!\left(\frac{rG}{v\alpha}+\frac{CG\kappa C_{w_{0}}}{\delta(1-\lambda)}+\frac{vG^{2}\kappa}{\delta(1-\lambda)}+\frac{vG^{2}}{\alpha}\right),</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A3.SS10.SSS0.Px2.p5.2" class="ltx_p">which makes explicit the dependence on the network parameters
<math id="A3.SS10.SSS0.Px2.p5.m2" class="ltx_Math" alttext="(\lambda,\delta)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi>λ</mi><mo>,</mo><mi>δ</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(\lambda,\delta)</annotation></semantics></math>, the initialization scale <math id="A3.SS10.SSS0.Px2.p5.m3" class="ltx_Math" alttext="C_{w_{0}}" display="inline" intent=":literal"><semantics><msub><mi>C</mi><msub><mi>w</mi><mn>0</mn></msub></msub><annotation encoding="application/x-tex">C_{w_{0}}</annotation></semantics></math>, and the gradient bound <math id="A3.SS10.SSS0.Px2.p5.m4" class="ltx_Math" alttext="G" display="inline" intent=":literal"><semantics><mi>G</mi><annotation encoding="application/x-tex">G</annotation></semantics></math>.</p>
</div>
<div id="A3.SS10.SSS0.Px2.p6" class="ltx_para">
<p id="A3.SS10.SSS0.Px2.p6.1" class="ltx_p">This completes the proof of Corollary <a href="#Thmtheorem40" title="Corollary 40 (Excess Generalization Error with Common Learning Rates). ‣ 4.3 Results on Non-convex Case ‣ 4 Theoretical Analysis ‣ Stability and Generalization of Push-Sum Based Decentralized Optimization over Directed Graphs" class="ltx_ref"><span class="ltx_text ltx_ref_tag">40</span></a>.</p>
</div>
<div id="A3.SS10.SSS0.Px2.p7" class="ltx_para">
<p id="A3.SS10.SSS0.Px2.p7.1" class="ltx_p">∎</p>
</div>
</section>
</section>
