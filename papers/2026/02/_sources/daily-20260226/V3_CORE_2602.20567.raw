<tbody id="A3.Ex58"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex58.m1" class="ltx_math_unparsed" alttext="\displaystyle\quad+\sum_{i=1}^{m}\frac{4rL\gamma_{t}}{m}\Big(\frac{C}{\delta}{\lambda}^{t}C_{w_{0}}+\frac{CG}{\delta}\sum_{s=0}^{t-1}{\lambda}^{t-s}\gamma_{s}\Big)+\gamma_{t}^{2}G^{2}" display="inline" intent=":literal"><semantics><mrow><mo>+</mo><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>m</mi></munderover></mstyle><mstyle displaystyle="true"><mfrac><mrow><mn>4</mn><mo lspace="0em" rspace="0em">​</mo><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>L</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>γ</mi><mi>t</mi></msub></mrow><mi>m</mi></mfrac></mstyle><mrow><mo maxsize="1.600em" minsize="1.600em">(</mo><mstyle displaystyle="true"><mfrac><mi>C</mi><mi>δ</mi></mfrac></mstyle><msup><mi>λ</mi><mi>t</mi></msup><msub><mi>C</mi><msub><mi>w</mi><mn>0</mn></msub></msub><mo>+</mo><mstyle displaystyle="true"><mfrac><mrow><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><mi>G</mi></mrow><mi>δ</mi></mfrac></mstyle><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>s</mi><mo>=</mo><mn>0</mn></mrow><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow></munderover></mstyle><msup><mi>λ</mi><mrow><mi>t</mi><mo>−</mo><mi>s</mi></mrow></msup><msub><mi>γ</mi><mi>s</mi></msub><mo maxsize="1.600em" minsize="1.600em">)</mo></mrow><mo>+</mo><msubsup><mi>γ</mi><mi>t</mi><mn>2</mn></msubsup><msup><mi>G</mi><mn>2</mn></msup></mrow><annotation encoding="application/x-tex">\displaystyle\quad+\sum_{i=1}^{m}\frac{4rL\gamma_{t}}{m}\Big(\frac{C}{\delta}{\lambda}^{t}C_{w_{0}}+\frac{CG}{\delta}\sum_{s=0}^{t-1}{\lambda}^{t-s}\gamma_{s}\Big)+\gamma_{t}^{2}G^{2}</annotation></semantics></math></td>
