<section id="A2" class="ltx_appendix">
<h2 class="ltx_title ltx_title_appendix"><span class="ltx_tag ltx_tag_appendix">Appendix B </span>Technical Propositions and Lemmas</h2>

<section id="A2.SS1" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">B.1 </span>Proof of Proposition <a href="#Thmtheorem7" title="Proposition 7. ‣ 3.3 Algorithm: Stochastic Gradient Push (SGP) ‣ 3 Preliminaries ‣ Stability and Generalization of Push-Sum Based Decentralized Optimization over Directed Graphs" class="ltx_ref"><span class="ltx_text ltx_ref_tag">7</span></a></h3>

<div id="A2.SS1.2" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="A2.SS1.p1" class="ltx_para">
<p id="A2.SS1.p1.1" class="ltx_p"><span id="A2.SS1.p1.1.1" class="ltx_text">By the SGP update rule,</span></p>
<table id="A2.E38" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A2.E38.m1" class="ltx_math_unparsed" alttext="\bm{W}^{(t+1)}=\bm{P}^{(t)}\!\left(\bm{W}^{(t)}-\gamma_{t}\nabla\bm{f}(\bm{Z}^{(t)};\bm{S}^{(t)})\right)." display="block" intent=":literal"><semantics><mrow><msup><mi>𝑾</mi><mrow><mo stretchy="false">(</mo><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></msup><mo>=</mo><msup><mi>𝑷</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mrow><mo>(</mo><msup><mi>𝑾</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo>−</mo><msub><mi>γ</mi><mi>t</mi></msub><mo lspace="0.167em" rspace="0.167em">∇</mo><mi>𝒇</mi><mrow><mo stretchy="false">(</mo><msup><mi>𝒁</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo>;</mo><msup><mi>𝑺</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow><mo>)</mo></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\bm{W}^{(t+1)}=\bm{P}^{(t)}\!\left(\bm{W}^{(t)}-\gamma_{t}\nabla\bm{f}(\bm{Z}^{(t)};\bm{S}^{(t)})\right).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(38)</span></td></tr></tbody>
</table>
</div>
<div id="A2.SS1.p2" class="ltx_para">
<p id="A2.SS1.p2.1" class="ltx_p"><span id="A2.SS1.p2.1.1" class="ltx_text">Consider the network average
<math id="A2.SS1.p2.m1" class="ltx_Math" alttext="\overline{\bm{w}}^{(t)}=\frac{1}{m}\bm{1}^{\top}\bm{W}^{(t)}." display="inline" intent=":literal"><semantics><mrow><mrow><msup><mover accent="true"><mi>𝒘</mi><mo stretchy="true">¯</mo></mover><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo>=</mo><mrow><mfrac><mn>1</mn><mi>m</mi></mfrac><mo lspace="0em" rspace="0em">​</mo><msup><mn>𝟏</mn><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝑾</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\overline{\bm{w}}^{(t)}=\frac{1}{m}\bm{1}^{\top}\bm{W}^{(t)}.</annotation></semantics></math>
Since <math id="A2.SS1.p2.m2" class="ltx_Math" alttext="\bm{1}^{\top}\bm{P}^{(t)}=\bm{1}^{\top}" display="inline" intent=":literal"><semantics><mrow><mrow><msup><mn>𝟏</mn><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝑷</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup></mrow><mo>=</mo><msup><mn>𝟏</mn><mo>⊤</mo></msup></mrow><annotation encoding="application/x-tex">\bm{1}^{\top}\bm{P}^{(t)}=\bm{1}^{\top}</annotation></semantics></math>, then</span></p>
<table id="A2.EGx2" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A2.Ex17"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A2.Ex17.m1" class="ltx_Math" alttext="\displaystyle\overline{\bm{w}}^{(t+1)}" display="inline" intent=":literal"><semantics><msup><mover accent="true"><mi>𝒘</mi><mo stretchy="true">¯</mo></mover><mrow><mo stretchy="false">(</mo><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></msup><annotation encoding="application/x-tex">\displaystyle\overline{\bm{w}}^{(t+1)}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex17.m2" class="ltx_Math" alttext="\displaystyle=\frac{1}{m}\bm{1}^{\top}\bm{W}^{(t+1)}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>m</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msup><mn>𝟏</mn><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝑾</mi><mrow><mo stretchy="false">(</mo><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></msup></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\frac{1}{m}\bm{1}^{\top}\bm{W}^{(t+1)}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A2.Ex18"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex18.m1" class="ltx_math_unparsed" alttext="\displaystyle=\frac{1}{m}\bm{1}^{\top}\bm{P}^{(t)}\!\left(\bm{W}^{(t)}-\gamma_{t}\nabla\bm{f}(\bm{Z}^{(t)};\bm{S}^{(t)})\right)" display="inline" intent=":literal"><semantics><mrow><mo>=</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>m</mi></mfrac></mstyle><msup><mn>𝟏</mn><mo>⊤</mo></msup><msup><mi>𝑷</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mrow><mo>(</mo><msup><mi>𝑾</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo>−</mo><msub><mi>γ</mi><mi>t</mi></msub><mo lspace="0.167em" rspace="0.167em">∇</mo><mi>𝒇</mi><mrow><mo stretchy="false">(</mo><msup><mi>𝒁</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo>;</mo><msup><mi>𝑺</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow><mo>)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\frac{1}{m}\bm{1}^{\top}\bm{P}^{(t)}\!\left(\bm{W}^{(t)}-\gamma_{t}\nabla\bm{f}(\bm{Z}^{(t)};\bm{S}^{(t)})\right)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A2.Ex19"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex19.m1" class="ltx_math_unparsed" alttext="\displaystyle=\frac{1}{m}\bm{1}^{\top}\!\left(\bm{W}^{(t)}-\gamma_{t}\nabla\bm{f}(\bm{Z}^{(t)};\bm{S}^{(t)})\right)\quad(\text{since }\bm{1}^{\top}\bm{P}^{(t)}=\bm{1}^{\top})" display="inline" intent=":literal"><semantics><mrow><mo>=</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>m</mi></mfrac></mstyle><msup><mn>𝟏</mn><mo>⊤</mo></msup><mrow><mo>(</mo><msup><mi>𝑾</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo>−</mo><msub><mi>γ</mi><mi>t</mi></msub><mo lspace="0.167em" rspace="0.167em">∇</mo><mi>𝒇</mi><mrow><mo stretchy="false">(</mo><msup><mi>𝒁</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo>;</mo><msup><mi>𝑺</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow><mo>)</mo></mrow><mrow><mo stretchy="false">(</mo><mtext>since </mtext><msup><mn>𝟏</mn><mo>⊤</mo></msup><msup><mi>𝑷</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo>=</mo><msup><mn>𝟏</mn><mo>⊤</mo></msup><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\frac{1}{m}\bm{1}^{\top}\!\left(\bm{W}^{(t)}-\gamma_{t}\nabla\bm{f}(\bm{Z}^{(t)};\bm{S}^{(t)})\right)\quad(\text{since }\bm{1}^{\top}\bm{P}^{(t)}=\bm{1}^{\top})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A2.Ex20"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex20.m1" class="ltx_math_unparsed" alttext="\displaystyle=\overline{\bm{w}}^{(t)}-\frac{\gamma_{t}}{m}\bm{1}^{\top}\nabla\bm{f}(\bm{Z}^{(t)};\bm{S}^{(t)})" display="inline" intent=":literal"><semantics><mrow><mo>=</mo><msup><mover accent="true"><mi>𝒘</mi><mo stretchy="true">¯</mo></mover><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo>−</mo><mstyle displaystyle="true"><mfrac><msub><mi>γ</mi><mi>t</mi></msub><mi>m</mi></mfrac></mstyle><msup><mn>𝟏</mn><mo>⊤</mo></msup><mo lspace="0.167em" rspace="0.167em">∇</mo><mi>𝒇</mi><mrow><mo stretchy="false">(</mo><msup><mi>𝒁</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo>;</mo><msup><mi>𝑺</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\overline{\bm{w}}^{(t)}-\frac{\gamma_{t}}{m}\bm{1}^{\top}\nabla\bm{f}(\bm{Z}^{(t)};\bm{S}^{(t)})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A2.E39"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.E39.m1" class="ltx_Math" alttext="\displaystyle=\overline{\bm{w}}^{(t)}-\frac{\gamma_{t}}{m}\sum_{i=1}^{m}\nabla f(\bm{z}_{i}^{(t)};\bm{\xi}_{i}^{(t)})." display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>=</mo><mrow><msup><mover accent="true"><mi>𝒘</mi><mo stretchy="true">¯</mo></mover><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo>−</mo><mrow><mstyle displaystyle="true"><mfrac><msub><mi>γ</mi><mi>t</mi></msub><mi>m</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>m</mi></munderover></mstyle><mrow><mrow><mo lspace="0.167em" rspace="0.167em">∇</mo><mi>f</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>𝒛</mi><mi>i</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msubsup><mo>,</mo><msubsup><mi>𝝃</mi><mi>i</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msubsup><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle=\overline{\bm{w}}^{(t)}-\frac{\gamma_{t}}{m}\sum_{i=1}^{m}\nabla f(\bm{z}_{i}^{(t)};\bm{\xi}_{i}^{(t)}).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(39)</span></td></tr></tbody>
</table>
<p id="A2.SS1.p2.2" class="ltx_p"><span id="A2.SS1.p2.2.1" class="ltx_text">This proves Proposition <a href="#Thmtheorem7" title="Proposition 7. ‣ 3.3 Algorithm: Stochastic Gradient Push (SGP) ‣ 3 Preliminaries ‣ Stability and Generalization of Push-Sum Based Decentralized Optimization over Directed Graphs" class="ltx_ref"><span class="ltx_text ltx_ref_tag">7</span></a>.
∎</span></p>
</div>
</div>
</section>
<section id="A2.SS2" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">B.2 </span>Proof of Lemma <a href="#Thmtheorem9" title="Lemma 9 (Consistency of Push-Sum). ‣ 3.3 Algorithm: Stochastic Gradient Push (SGP) ‣ 3 Preliminaries ‣ Stability and Generalization of Push-Sum Based Decentralized Optimization over Directed Graphs" class="ltx_ref"><span class="ltx_text ltx_ref_tag">9</span></a></h3>

<div id="A2.SS2.2" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="A2.SS2.p1" class="ltx_para">
<p id="A2.SS2.p1.1" class="ltx_p"><span id="A2.SS2.p1.1.1" class="ltx_text">Since <math id="A2.SS2.p1.m1" class="ltx_Math" alttext="\bm{P}" display="inline" intent=":literal"><semantics><mi>𝑷</mi><annotation encoding="application/x-tex">\bm{P}</annotation></semantics></math> is a nonnegative, column-stochastic, and primitive matrix, the Perron–Frobenius theorem
guarantees the existence of a unique positive right eigenvector <math id="A2.SS2.p1.m2" class="ltx_Math" alttext="\bm{\pi}\in\mathbb{R}^{m}_{++}" display="inline" intent=":literal"><semantics><mrow><mi>𝝅</mi><mo>∈</mo><msubsup><mi>ℝ</mi><mrow><mo>+</mo><mo lspace="0em">⁣</mo><mo>+</mo></mrow><mi>m</mi></msubsup></mrow><annotation encoding="application/x-tex">\bm{\pi}\in\mathbb{R}^{m}_{++}</annotation></semantics></math> such that <math id="A2.SS2.p1.m3" class="ltx_Math" alttext="\bm{P}\bm{\pi}=\bm{\pi}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>𝑷</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝝅</mi></mrow><mo>=</mo><mi>𝝅</mi></mrow><annotation encoding="application/x-tex">\bm{P}\bm{\pi}=\bm{\pi}</annotation></semantics></math> and <math id="A2.SS2.p1.m4" class="ltx_Math" alttext="\|\bm{\pi}\|_{1}=1" display="inline" intent=":literal"><semantics><mrow><msub><mrow><mo stretchy="false">‖</mo><mi>𝝅</mi><mo stretchy="false">‖</mo></mrow><mn>1</mn></msub><mo>=</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">\|\bm{\pi}\|_{1}=1</annotation></semantics></math>.
The corresponding left eigenvector is <math id="A2.SS2.p1.m5" class="ltx_Math" alttext="\bm{1}^{\top}" display="inline" intent=":literal"><semantics><msup><mn>𝟏</mn><mo>⊤</mo></msup><annotation encoding="application/x-tex">\bm{1}^{\top}</annotation></semantics></math>, satisfying <math id="A2.SS2.p1.m6" class="ltx_Math" alttext="\bm{1}^{\top}\bm{P}=\bm{1}^{\top}" display="inline" intent=":literal"><semantics><mrow><mrow><msup><mn>𝟏</mn><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>𝑷</mi></mrow><mo>=</mo><msup><mn>𝟏</mn><mo>⊤</mo></msup></mrow><annotation encoding="application/x-tex">\bm{1}^{\top}\bm{P}=\bm{1}^{\top}</annotation></semantics></math>.
Define</span></p>
<table id="A2.E40" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A2.E40.m1" class="ltx_Math" alttext="\bm{H}:=\bm{P}-\bm{\pi}\bm{1}^{\top}." display="block" intent=":literal"><semantics><mrow><mrow><mi>𝑯</mi><mo>:=</mo><mrow><mi>𝑷</mi><mo>−</mo><mrow><mi>𝝅</mi><mo lspace="0em" rspace="0em">​</mo><msup><mn>𝟏</mn><mo>⊤</mo></msup></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\bm{H}:=\bm{P}-\bm{\pi}\bm{1}^{\top}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(40)</span></td></tr></tbody>
</table>
<p id="A2.SS2.p1.2" class="ltx_p"><span id="A2.SS2.p1.2.1" class="ltx_text">Then <math id="A2.SS2.p1.m7" class="ltx_Math" alttext="\bm{H}\bm{\pi}=\bm{0}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>𝑯</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝝅</mi></mrow><mo>=</mo><mn>𝟎</mn></mrow><annotation encoding="application/x-tex">\bm{H}\bm{\pi}=\bm{0}</annotation></semantics></math> and <math id="A2.SS2.p1.m8" class="ltx_Math" alttext="\bm{1}^{\top}\bm{H}=\bm{0}^{\top}" display="inline" intent=":literal"><semantics><mrow><mrow><msup><mn>𝟏</mn><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>𝑯</mi></mrow><mo>=</mo><msup><mn>𝟎</mn><mo>⊤</mo></msup></mrow><annotation encoding="application/x-tex">\bm{1}^{\top}\bm{H}=\bm{0}^{\top}</annotation></semantics></math>, and hence
<math id="A2.SS2.p1.m9" class="ltx_Math" alttext="\bm{P}^{t}=\bm{\pi}\bm{1}^{\top}+\bm{H}^{t}" display="inline" intent=":literal"><semantics><mrow><msup><mi>𝑷</mi><mi>t</mi></msup><mo>=</mo><mrow><mrow><mi>𝝅</mi><mo lspace="0em" rspace="0em">​</mo><msup><mn>𝟏</mn><mo>⊤</mo></msup></mrow><mo>+</mo><msup><mi>𝑯</mi><mi>t</mi></msup></mrow></mrow><annotation encoding="application/x-tex">\bm{P}^{t}=\bm{\pi}\bm{1}^{\top}+\bm{H}^{t}</annotation></semantics></math> for any <math id="A2.SS2.p1.m10" class="ltx_Math" alttext="t\geq 1" display="inline" intent=":literal"><semantics><mrow><mi>t</mi><mo>≥</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">t\geq 1</annotation></semantics></math>.</span></p>
</div>
<div id="A2.SS2.p2" class="ltx_para">
<p id="A2.SS2.p2.1" class="ltx_p"><span id="A2.SS2.p2.1.1" class="ltx_text">Let <math id="A2.SS2.p2.m1" class="ltx_Math" alttext="\lambda" display="inline" intent=":literal"><semantics><mi>λ</mi><annotation encoding="application/x-tex">\lambda</annotation></semantics></math> be the spectral radius of <math id="A2.SS2.p2.m2" class="ltx_Math" alttext="\bm{H}" display="inline" intent=":literal"><semantics><mi>𝑯</mi><annotation encoding="application/x-tex">\bm{H}</annotation></semantics></math>, which satisfies <math id="A2.SS2.p2.m3" class="ltx_Math" alttext="\lambda&lt;1" display="inline" intent=":literal"><semantics><mrow><mi>λ</mi><mo>&lt;</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">\lambda&lt;1</annotation></semantics></math> due to primitivity.
Thus there exists a constant <math id="A2.SS2.p2.m4" class="ltx_Math" alttext="C_{H}&gt;0" display="inline" intent=":literal"><semantics><mrow><msub><mi>C</mi><mi>H</mi></msub><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">C_{H}&gt;0</annotation></semantics></math> such that, for the induced <math id="A2.SS2.p2.m5" class="ltx_Math" alttext="\infty" display="inline" intent=":literal"><semantics><mi mathvariant="normal">∞</mi><annotation encoding="application/x-tex">\infty</annotation></semantics></math>-norm,</span></p>
<table id="A2.E41" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A2.E41.m1" class="ltx_Math" alttext="\|\bm{H}^{t}\|_{\infty}\leq C_{H}\lambda^{t},\quad\forall t\geq 0." display="block" intent=":literal"><semantics><mrow><mrow><mrow><msub><mrow><mo stretchy="false">‖</mo><msup><mi>𝑯</mi><mi>t</mi></msup><mo stretchy="false">‖</mo></mrow><mi mathvariant="normal">∞</mi></msub><mo>≤</mo><mrow><msub><mi>C</mi><mi>H</mi></msub><mo lspace="0em" rspace="0em">​</mo><msup><mi>λ</mi><mi>t</mi></msup></mrow></mrow><mo rspace="1.167em">,</mo><mrow><mrow><mo rspace="0.167em">∀</mo><mi>t</mi></mrow><mo>≥</mo><mn>0</mn></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\|\bm{H}^{t}\|_{\infty}\leq C_{H}\lambda^{t},\quad\forall t\geq 0.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(41)</span></td></tr></tbody>
</table>
<p id="A2.SS2.p2.2" class="ltx_p"><span id="A2.SS2.p2.2.1" class="ltx_text">In particular, <math id="A2.SS2.p2.m6" class="ltx_Math" alttext="(\bm{P}^{t})_{ij}=\pi_{i}+(\bm{H}^{t})_{ij}" display="inline" intent=":literal"><semantics><mrow><msub><mrow><mo stretchy="false">(</mo><msup><mi>𝑷</mi><mi>t</mi></msup><mo stretchy="false">)</mo></mrow><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>j</mi></mrow></msub><mo>=</mo><mrow><msub><mi>π</mi><mi>i</mi></msub><mo>+</mo><msub><mrow><mo stretchy="false">(</mo><msup><mi>𝑯</mi><mi>t</mi></msup><mo stretchy="false">)</mo></mrow><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>j</mi></mrow></msub></mrow></mrow><annotation encoding="application/x-tex">(\bm{P}^{t})_{ij}=\pi_{i}+(\bm{H}^{t})_{ij}</annotation></semantics></math> and <math id="A2.SS2.p2.m7" class="ltx_Math" alttext="|(\bm{H}^{t})_{ij}|\leq\|\bm{H}^{t}\|_{\infty}" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">|</mo><msub><mrow><mo stretchy="false">(</mo><msup><mi>𝑯</mi><mi>t</mi></msup><mo stretchy="false">)</mo></mrow><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>j</mi></mrow></msub><mo stretchy="false">|</mo></mrow><mo>≤</mo><msub><mrow><mo stretchy="false">‖</mo><msup><mi>𝑯</mi><mi>t</mi></msup><mo stretchy="false">‖</mo></mrow><mi mathvariant="normal">∞</mi></msub></mrow><annotation encoding="application/x-tex">|(\bm{H}^{t})_{ij}|\leq\|\bm{H}^{t}\|_{\infty}</annotation></semantics></math>.</span></p>
</div>
<div id="A2.SS2.p3" class="ltx_para">
<p id="A2.SS2.p3.1" class="ltx_p"><span id="A2.SS2.p3.1.1" class="ltx_text">We examine the evolution of the push-sum weight vector <math id="A2.SS2.p3.m1" class="ltx_Math" alttext="\bm{u}^{(t)}=\bm{P}\bm{u}^{(t-1)},\bm{u}^{(0)}=\bm{1}." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><msup><mi>𝒖</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo>=</mo><mrow><mi>𝑷</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝒖</mi><mrow><mo stretchy="false">(</mo><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></msup></mrow></mrow><mo>,</mo><mrow><msup><mi>𝒖</mi><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></msup><mo>=</mo><mn>𝟏</mn></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\bm{u}^{(t)}=\bm{P}\bm{u}^{(t-1)},\bm{u}^{(0)}=\bm{1}.</annotation></semantics></math>
Therefore,</span></p>
<table id="A2.E42" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A2.E42.m1" class="ltx_Math" alttext="\bm{u}^{(t)}=\bm{P}^{t}\bm{1}=(\bm{\pi}\bm{1}^{\top}+\bm{H}^{t})\bm{1}=m\bm{\pi}+\bm{H}^{t}\bm{1}." display="block" intent=":literal"><semantics><mrow><mrow><msup><mi>𝒖</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo>=</mo><mrow><msup><mi>𝑷</mi><mi>t</mi></msup><mo lspace="0em" rspace="0em">​</mo><mn>𝟏</mn></mrow><mo>=</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mrow><mi>𝝅</mi><mo lspace="0em" rspace="0em">​</mo><msup><mn>𝟏</mn><mo>⊤</mo></msup></mrow><mo>+</mo><msup><mi>𝑯</mi><mi>t</mi></msup></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mn>𝟏</mn></mrow><mo>=</mo><mrow><mrow><mi>m</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝝅</mi></mrow><mo>+</mo><mrow><msup><mi>𝑯</mi><mi>t</mi></msup><mo lspace="0em" rspace="0em">​</mo><mn>𝟏</mn></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\bm{u}^{(t)}=\bm{P}^{t}\bm{1}=(\bm{\pi}\bm{1}^{\top}+\bm{H}^{t})\bm{1}=m\bm{\pi}+\bm{H}^{t}\bm{1}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(42)</span></td></tr></tbody>
</table>
<p id="A2.SS2.p3.2" class="ltx_p"><span id="A2.SS2.p3.2.1" class="ltx_text">For node <math id="A2.SS2.p3.m2" class="ltx_Math" alttext="i" display="inline" intent=":literal"><semantics><mi>i</mi><annotation encoding="application/x-tex">i</annotation></semantics></math>, <math id="A2.SS2.p3.m3" class="ltx_Math" alttext="u_{i}^{(t)}=m\pi_{i}+(\bm{H}^{t}\bm{1})_{i}" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>u</mi><mi>i</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msubsup><mo>=</mo><mrow><mrow><mi>m</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>π</mi><mi>i</mi></msub></mrow><mo>+</mo><msub><mrow><mo stretchy="false">(</mo><mrow><msup><mi>𝑯</mi><mi>t</mi></msup><mo lspace="0em" rspace="0em">​</mo><mn>𝟏</mn></mrow><mo stretchy="false">)</mo></mrow><mi>i</mi></msub></mrow></mrow><annotation encoding="application/x-tex">u_{i}^{(t)}=m\pi_{i}+(\bm{H}^{t}\bm{1})_{i}</annotation></semantics></math>. Let <math id="A2.SS2.p3.m4" class="ltx_Math" alttext="\delta=\min_{i}\pi_{i}&gt;0" display="inline" intent=":literal"><semantics><mrow><mi>δ</mi><mo>=</mo><mrow><msub><mi>min</mi><mi>i</mi></msub><mo lspace="0.167em">⁡</mo><msub><mi>π</mi><mi>i</mi></msub></mrow><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\delta=\min_{i}\pi_{i}&gt;0</annotation></semantics></math>.
Using (<a href="#A2.E41" title="In Proof. ‣ B.2 Proof of Lemma ‣ Appendix B Technical Propositions and Lemmas ‣ Stability and Generalization of Push-Sum Based Decentralized Optimization over Directed Graphs" class="ltx_ref"><span class="ltx_text ltx_ref_tag">41</span></a>) and <math id="A2.SS2.p3.m5" class="ltx_Math" alttext="\|\bm{1}\|_{\infty}=1" display="inline" intent=":literal"><semantics><mrow><msub><mrow><mo stretchy="false">‖</mo><mn>𝟏</mn><mo stretchy="false">‖</mo></mrow><mi mathvariant="normal">∞</mi></msub><mo>=</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">\|\bm{1}\|_{\infty}=1</annotation></semantics></math>,</span></p>
<table id="A2.Ex21" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A2.Ex21.m1" class="ltx_Math" alttext="|(\bm{H}^{t}\bm{1})_{i}|\leq\|\bm{H}^{t}\|_{\infty}\|\bm{1}\|_{\infty}\leq C_{H}\lambda^{t}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mo stretchy="false">|</mo><msub><mrow><mo stretchy="false">(</mo><mrow><msup><mi>𝑯</mi><mi>t</mi></msup><mo lspace="0em" rspace="0em">​</mo><mn>𝟏</mn></mrow><mo stretchy="false">)</mo></mrow><mi>i</mi></msub><mo stretchy="false">|</mo></mrow><mo>≤</mo><mrow><msub><mrow><mo stretchy="false">‖</mo><msup><mi>𝑯</mi><mi>t</mi></msup><mo stretchy="false">‖</mo></mrow><mi mathvariant="normal">∞</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">‖</mo><mn>𝟏</mn><mo stretchy="false">‖</mo></mrow><mi mathvariant="normal">∞</mi></msub></mrow><mo>≤</mo><mrow><msub><mi>C</mi><mi>H</mi></msub><mo lspace="0em" rspace="0em">​</mo><msup><mi>λ</mi><mi>t</mi></msup></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">|(\bm{H}^{t}\bm{1})_{i}|\leq\|\bm{H}^{t}\|_{\infty}\|\bm{1}\|_{\infty}\leq C_{H}\lambda^{t}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A2.SS2.p3.3" class="ltx_p"><span id="A2.SS2.p3.3.1" class="ltx_text">Hence there exists <math id="A2.SS2.p3.m6" class="ltx_Math" alttext="T" display="inline" intent=":literal"><semantics><mi>T</mi><annotation encoding="application/x-tex">T</annotation></semantics></math> such that for all <math id="A2.SS2.p3.m7" class="ltx_Math" alttext="t&gt;T" display="inline" intent=":literal"><semantics><mrow><mi>t</mi><mo>&gt;</mo><mi>T</mi></mrow><annotation encoding="application/x-tex">t&gt;T</annotation></semantics></math>,
<math id="A2.SS2.p3.m8" class="ltx_Math" alttext="|(\bm{H}^{t}\bm{1})_{i}|\leq\tfrac{1}{2}m\delta" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">|</mo><msub><mrow><mo stretchy="false">(</mo><mrow><msup><mi>𝑯</mi><mi>t</mi></msup><mo lspace="0em" rspace="0em">​</mo><mn>𝟏</mn></mrow><mo stretchy="false">)</mo></mrow><mi>i</mi></msub><mo stretchy="false">|</mo></mrow><mo>≤</mo><mrow><mfrac><mn>1</mn><mn>2</mn></mfrac><mo lspace="0em" rspace="0em">​</mo><mi>m</mi><mo lspace="0em" rspace="0em">​</mo><mi>δ</mi></mrow></mrow><annotation encoding="application/x-tex">|(\bm{H}^{t}\bm{1})_{i}|\leq\tfrac{1}{2}m\delta</annotation></semantics></math>, implying <math id="A2.SS2.p3.m9" class="ltx_Math" alttext="u_{i}^{(t)}\geq\tfrac{1}{2}m\delta" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>u</mi><mi>i</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msubsup><mo>≥</mo><mrow><mfrac><mn>1</mn><mn>2</mn></mfrac><mo lspace="0em" rspace="0em">​</mo><mi>m</mi><mo lspace="0em" rspace="0em">​</mo><mi>δ</mi></mrow></mrow><annotation encoding="application/x-tex">u_{i}^{(t)}\geq\tfrac{1}{2}m\delta</annotation></semantics></math>.
For the finite interval <math id="A2.SS2.p3.m10" class="ltx_Math" alttext="0\leq t\leq T" display="inline" intent=":literal"><semantics><mrow><mn>0</mn><mo>≤</mo><mi>t</mi><mo>≤</mo><mi>T</mi></mrow><annotation encoding="application/x-tex">0\leq t\leq T</annotation></semantics></math>, primitivity of <math id="A2.SS2.p3.m11" class="ltx_Math" alttext="\bm{P}" display="inline" intent=":literal"><semantics><mi>𝑷</mi><annotation encoding="application/x-tex">\bm{P}</annotation></semantics></math> and positivity of <math id="A2.SS2.p3.m12" class="ltx_Math" alttext="\bm{u}^{(0)}" display="inline" intent=":literal"><semantics><msup><mi>𝒖</mi><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></msup><annotation encoding="application/x-tex">\bm{u}^{(0)}</annotation></semantics></math>
ensure <math id="A2.SS2.p3.m13" class="ltx_Math" alttext="u_{i}^{(t)}&gt;0" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>u</mi><mi>i</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msubsup><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">u_{i}^{(t)}&gt;0</annotation></semantics></math>. Thus, by possibly enlarging constants, we may take</span></p>
<table id="A2.E43" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A2.E43.m1" class="ltx_Math" alttext="u_{i}^{(t)}\geq\frac{1}{2}m\delta,\quad\forall t\geq 0,\ \forall i\in[m]." display="block" intent=":literal"><semantics><mrow><mrow><mrow><msubsup><mi>u</mi><mi>i</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msubsup><mo>≥</mo><mrow><mfrac><mn>1</mn><mn>2</mn></mfrac><mo lspace="0em" rspace="0em">​</mo><mi>m</mi><mo lspace="0em" rspace="0em">​</mo><mi>δ</mi></mrow></mrow><mo rspace="1.167em">,</mo><mrow><mrow><mo rspace="0.167em">∀</mo><mi>t</mi></mrow><mo>≥</mo><mn>0</mn></mrow><mo rspace="0.667em">,</mo><mrow><mrow><mo rspace="0.167em">∀</mo><mi>i</mi></mrow><mo>∈</mo><mrow><mo stretchy="false">[</mo><mi>m</mi><mo stretchy="false">]</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">u_{i}^{(t)}\geq\frac{1}{2}m\delta,\quad\forall t\geq 0,\ \forall i\in[m].</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(43)</span></td></tr></tbody>
</table>
</div>
<div id="A2.SS2.p4" class="ltx_para">
<p id="A2.SS2.p4.1" class="ltx_p"><span id="A2.SS2.p4.1.1" class="ltx_text">Next, the numerator iterates satisfy</span></p>
<table id="A2.E44" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A2.E44.m1" class="ltx_math_unparsed" alttext="\bm{W}^{(t)}=\bm{P}\Big(\bm{W}^{(t-1)}-\gamma_{t-1}\nabla\bm{f}(\bm{Z}^{(t-1)};\bm{S}^{(t-1)})\Big)." display="block" intent=":literal"><semantics><mrow><msup><mi>𝑾</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo>=</mo><mi>𝑷</mi><mrow><mo maxsize="1.600em" minsize="1.600em">(</mo><msup><mi>𝑾</mi><mrow><mo stretchy="false">(</mo><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></msup><mo>−</mo><msub><mi>γ</mi><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow></msub><mo lspace="0.167em" rspace="0.167em">∇</mo><mi>𝒇</mi><mrow><mo stretchy="false">(</mo><msup><mi>𝒁</mi><mrow><mo stretchy="false">(</mo><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></msup><mo>;</mo><msup><mi>𝑺</mi><mrow><mo stretchy="false">(</mo><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow><mo maxsize="1.600em" minsize="1.600em">)</mo></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\bm{W}^{(t)}=\bm{P}\Big(\bm{W}^{(t-1)}-\gamma_{t-1}\nabla\bm{f}(\bm{Z}^{(t-1)};\bm{S}^{(t-1)})\Big).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(44)</span></td></tr></tbody>
</table>
<p id="A2.SS2.p4.2" class="ltx_p"><span id="A2.SS2.p4.2.1" class="ltx_text">Unrolling the recursion gives, for node <math id="A2.SS2.p4.m1" class="ltx_Math" alttext="i" display="inline" intent=":literal"><semantics><mi>i</mi><annotation encoding="application/x-tex">i</annotation></semantics></math>,</span></p>
<table id="A2.E45" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A2.E45.m1" class="ltx_math_unparsed" alttext="\bm{w}_{i}^{(t)}=\sum_{j=1}^{m}(\bm{P}^{t})_{ij}\bm{w}_{j}^{(0)}-\sum_{s=0}^{t-1}\sum_{j=1}^{m}(\bm{P}^{t-s})_{ij}\gamma_{s}\nabla f(\bm{z}_{j}^{(s)};\bm{\xi}_{j}^{(s)})." display="block" intent=":literal"><semantics><mrow><msubsup><mi>𝒘</mi><mi>i</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msubsup><mo rspace="0.111em">=</mo><munderover><mo movablelimits="false" rspace="0em">∑</mo><mrow><mi>j</mi><mo>=</mo><mn>1</mn></mrow><mi>m</mi></munderover><msub><mrow><mo stretchy="false">(</mo><msup><mi>𝑷</mi><mi>t</mi></msup><mo stretchy="false">)</mo></mrow><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>j</mi></mrow></msub><msubsup><mi>𝒘</mi><mi>j</mi><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></msubsup><mo rspace="0.055em">−</mo><munderover><mo movablelimits="false" rspace="0em">∑</mo><mrow><mi>s</mi><mo>=</mo><mn>0</mn></mrow><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow></munderover><munderover><mo movablelimits="false" rspace="0em">∑</mo><mrow><mi>j</mi><mo>=</mo><mn>1</mn></mrow><mi>m</mi></munderover><msub><mrow><mo stretchy="false">(</mo><msup><mi>𝑷</mi><mrow><mi>t</mi><mo>−</mo><mi>s</mi></mrow></msup><mo stretchy="false">)</mo></mrow><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>j</mi></mrow></msub><msub><mi>γ</mi><mi>s</mi></msub><mo lspace="0.167em" rspace="0.167em">∇</mo><mi>f</mi><mrow><mo stretchy="false">(</mo><msubsup><mi>𝒛</mi><mi>j</mi><mrow><mo stretchy="false">(</mo><mi>s</mi><mo stretchy="false">)</mo></mrow></msubsup><mo>;</mo><msubsup><mi>𝝃</mi><mi>j</mi><mrow><mo stretchy="false">(</mo><mi>s</mi><mo stretchy="false">)</mo></mrow></msubsup><mo stretchy="false">)</mo></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\bm{w}_{i}^{(t)}=\sum_{j=1}^{m}(\bm{P}^{t})_{ij}\bm{w}_{j}^{(0)}-\sum_{s=0}^{t-1}\sum_{j=1}^{m}(\bm{P}^{t-s})_{ij}\gamma_{s}\nabla f(\bm{z}_{j}^{(s)};\bm{\xi}_{j}^{(s)}).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(45)</span></td></tr></tbody>
</table>
<p id="A2.SS2.p4.3" class="ltx_p"><span id="A2.SS2.p4.3.1" class="ltx_text">The global average evolves as</span></p>
<table id="A2.E46" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A2.E46.m1" class="ltx_math_unparsed" alttext="\overline{\bm{w}}^{(t)}=\frac{1}{m}\sum_{j=1}^{m}\bm{w}_{j}^{(0)}-\frac{1}{m}\sum_{s=0}^{t-1}\sum_{j=1}^{m}\gamma_{s}\nabla f(\bm{z}_{j}^{(s)};\bm{\xi}_{j}^{(s)})." display="block" intent=":literal"><semantics><mrow><msup><mover accent="true"><mi>𝒘</mi><mo stretchy="true">¯</mo></mover><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo>=</mo><mfrac><mn>1</mn><mi>m</mi></mfrac><munderover><mo movablelimits="false">∑</mo><mrow><mi>j</mi><mo>=</mo><mn>1</mn></mrow><mi>m</mi></munderover><msubsup><mi>𝒘</mi><mi>j</mi><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></msubsup><mo>−</mo><mfrac><mn>1</mn><mi>m</mi></mfrac><munderover><mo movablelimits="false" rspace="0em">∑</mo><mrow><mi>s</mi><mo>=</mo><mn>0</mn></mrow><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow></munderover><munderover><mo movablelimits="false">∑</mo><mrow><mi>j</mi><mo>=</mo><mn>1</mn></mrow><mi>m</mi></munderover><msub><mi>γ</mi><mi>s</mi></msub><mo lspace="0.167em" rspace="0.167em">∇</mo><mi>f</mi><mrow><mo stretchy="false">(</mo><msubsup><mi>𝒛</mi><mi>j</mi><mrow><mo stretchy="false">(</mo><mi>s</mi><mo stretchy="false">)</mo></mrow></msubsup><mo>;</mo><msubsup><mi>𝝃</mi><mi>j</mi><mrow><mo stretchy="false">(</mo><mi>s</mi><mo stretchy="false">)</mo></mrow></msubsup><mo stretchy="false">)</mo></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\overline{\bm{w}}^{(t)}=\frac{1}{m}\sum_{j=1}^{m}\bm{w}_{j}^{(0)}-\frac{1}{m}\sum_{s=0}^{t-1}\sum_{j=1}^{m}\gamma_{s}\nabla f(\bm{z}_{j}^{(s)};\bm{\xi}_{j}^{(s)}).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(46)</span></td></tr></tbody>
</table>
</div>
<div id="A2.SS2.p5" class="ltx_para">
<p id="A2.SS2.p5.1" class="ltx_p"><span id="A2.SS2.p5.1.1" class="ltx_text">We bound <math id="A2.SS2.p5.m1" class="ltx_Math" alttext="\|\bm{z}_{i}^{(t)}-\overline{\bm{w}}^{(t)}\|" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">‖</mo><mrow><msubsup><mi>𝒛</mi><mi>i</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msubsup><mo>−</mo><msup><mover accent="true"><mi>𝒘</mi><mo stretchy="true">¯</mo></mover><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup></mrow><mo stretchy="false">‖</mo></mrow><annotation encoding="application/x-tex">\|\bm{z}_{i}^{(t)}-\overline{\bm{w}}^{(t)}\|</annotation></semantics></math>.
Since <math id="A2.SS2.p5.m2" class="ltx_Math" alttext="\bm{z}_{i}^{(t)}=\bm{w}_{i}^{(t)}/u_{i}^{(t)}" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>𝒛</mi><mi>i</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msubsup><mo>=</mo><mrow><msubsup><mi>𝒘</mi><mi>i</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msubsup><mo>/</mo><msubsup><mi>u</mi><mi>i</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msubsup></mrow></mrow><annotation encoding="application/x-tex">\bm{z}_{i}^{(t)}=\bm{w}_{i}^{(t)}/u_{i}^{(t)}</annotation></semantics></math>,
<math id="A2.SS2.p5.m3" class="ltx_Math" alttext="\bm{z}_{i}^{(t)}-\overline{\bm{w}}^{(t)}=\frac{\bm{w}_{i}^{(t)}-u_{i}^{(t)}\overline{\bm{w}}^{(t)}}{u_{i}^{(t)}}." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><msubsup><mi>𝒛</mi><mi>i</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msubsup><mo>−</mo><msup><mover accent="true"><mi>𝒘</mi><mo stretchy="true">¯</mo></mover><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup></mrow><mo>=</mo><mfrac><mrow><msubsup><mi>𝒘</mi><mi>i</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msubsup><mo>−</mo><mrow><msubsup><mi>u</mi><mi>i</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mover accent="true"><mi>𝒘</mi><mo stretchy="true">¯</mo></mover><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup></mrow></mrow><msubsup><mi>u</mi><mi>i</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msubsup></mfrac></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\bm{z}_{i}^{(t)}-\overline{\bm{w}}^{(t)}=\frac{\bm{w}_{i}^{(t)}-u_{i}^{(t)}\overline{\bm{w}}^{(t)}}{u_{i}^{(t)}}.</annotation></semantics></math>
Substituting <math id="A2.SS2.p5.m4" class="ltx_Math" alttext="(\bm{P}^{n})_{ij}=\pi_{i}+(\bm{H}^{n})_{ij}" display="inline" intent=":literal"><semantics><mrow><msub><mrow><mo stretchy="false">(</mo><msup><mi>𝑷</mi><mi>n</mi></msup><mo stretchy="false">)</mo></mrow><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>j</mi></mrow></msub><mo>=</mo><mrow><msub><mi>π</mi><mi>i</mi></msub><mo>+</mo><msub><mrow><mo stretchy="false">(</mo><msup><mi>𝑯</mi><mi>n</mi></msup><mo stretchy="false">)</mo></mrow><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>j</mi></mrow></msub></mrow></mrow><annotation encoding="application/x-tex">(\bm{P}^{n})_{ij}=\pi_{i}+(\bm{H}^{n})_{ij}</annotation></semantics></math> into (<a href="#A2.E45" title="In Proof. ‣ B.2 Proof of Lemma ‣ Appendix B Technical Propositions and Lemmas ‣ Stability and Generalization of Push-Sum Based Decentralized Optimization over Directed Graphs" class="ltx_ref"><span class="ltx_text ltx_ref_tag">45</span></a>) yields</span></p>
<table id="A2.EGx3" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A2.Ex22"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A2.Ex22.m1" class="ltx_Math" alttext="\displaystyle\bm{w}_{i}^{(t)}" display="inline" intent=":literal"><semantics><msubsup><mi>𝒘</mi><mi>i</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msubsup><annotation encoding="application/x-tex">\displaystyle\bm{w}_{i}^{(t)}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex22.m2" class="ltx_math_unparsed" alttext="\displaystyle=\pi_{i}\left(\sum_{j=1}^{m}\bm{w}_{j}^{(0)}-\sum_{s=0}^{t-1}\sum_{j=1}^{m}\gamma_{s}\nabla f(\bm{z}_{j}^{(s)};\bm{\xi}_{j}^{(s)})\right)+\sum_{j=1}^{m}(\bm{H}^{t})_{ij}\bm{w}_{j}^{(0)}" display="inline" intent=":literal"><semantics><mrow><mo>=</mo><msub><mi>π</mi><mi>i</mi></msub><mrow><mo>(</mo><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>j</mi><mo>=</mo><mn>1</mn></mrow><mi>m</mi></munderover></mstyle><msubsup><mi>𝒘</mi><mi>j</mi><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></msubsup><mo>−</mo><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>s</mi><mo>=</mo><mn>0</mn></mrow><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow></munderover></mstyle><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>j</mi><mo>=</mo><mn>1</mn></mrow><mi>m</mi></munderover></mstyle><msub><mi>γ</mi><mi>s</mi></msub><mo lspace="0.167em" rspace="0.167em">∇</mo><mi>f</mi><mrow><mo stretchy="false">(</mo><msubsup><mi>𝒛</mi><mi>j</mi><mrow><mo stretchy="false">(</mo><mi>s</mi><mo stretchy="false">)</mo></mrow></msubsup><mo>;</mo><msubsup><mi>𝝃</mi><mi>j</mi><mrow><mo stretchy="false">(</mo><mi>s</mi><mo stretchy="false">)</mo></mrow></msubsup><mo stretchy="false">)</mo></mrow><mo>)</mo></mrow><mo>+</mo><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>j</mi><mo>=</mo><mn>1</mn></mrow><mi>m</mi></munderover></mstyle><msub><mrow><mo stretchy="false">(</mo><msup><mi>𝑯</mi><mi>t</mi></msup><mo stretchy="false">)</mo></mrow><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>j</mi></mrow></msub><msubsup><mi>𝒘</mi><mi>j</mi><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></msubsup></mrow><annotation encoding="application/x-tex">\displaystyle=\pi_{i}\left(\sum_{j=1}^{m}\bm{w}_{j}^{(0)}-\sum_{s=0}^{t-1}\sum_{j=1}^{m}\gamma_{s}\nabla f(\bm{z}_{j}^{(s)};\bm{\xi}_{j}^{(s)})\right)+\sum_{j=1}^{m}(\bm{H}^{t})_{ij}\bm{w}_{j}^{(0)}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A2.E47"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.E47.m1" class="ltx_math_unparsed" alttext="\displaystyle\quad-\sum_{s=0}^{t-1}\sum_{j=1}^{m}(\bm{H}^{t-s})_{ij}\gamma_{s}\nabla f(\bm{z}_{j}^{(s)};\bm{\xi}_{j}^{(s)})." display="inline" intent=":literal"><semantics><mrow><mo>−</mo><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>s</mi><mo>=</mo><mn>0</mn></mrow><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow></munderover></mstyle><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>j</mi><mo>=</mo><mn>1</mn></mrow><mi>m</mi></munderover></mstyle><msub><mrow><mo stretchy="false">(</mo><msup><mi>𝑯</mi><mrow><mi>t</mi><mo>−</mo><mi>s</mi></mrow></msup><mo stretchy="false">)</mo></mrow><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>j</mi></mrow></msub><msub><mi>γ</mi><mi>s</mi></msub><mo lspace="0.167em" rspace="0.167em">∇</mo><mi>f</mi><mrow><mo stretchy="false">(</mo><msubsup><mi>𝒛</mi><mi>j</mi><mrow><mo stretchy="false">(</mo><mi>s</mi><mo stretchy="false">)</mo></mrow></msubsup><mo>;</mo><msubsup><mi>𝝃</mi><mi>j</mi><mrow><mo stretchy="false">(</mo><mi>s</mi><mo stretchy="false">)</mo></mrow></msubsup><mo stretchy="false">)</mo></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\quad-\sum_{s=0}^{t-1}\sum_{j=1}^{m}(\bm{H}^{t-s})_{ij}\gamma_{s}\nabla f(\bm{z}_{j}^{(s)};\bm{\xi}_{j}^{(s)}).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(47)</span></td></tr></tbody>
</table>
<p id="A2.SS2.p5.2" class="ltx_p"><span id="A2.SS2.p5.2.1" class="ltx_text">By (<a href="#A2.E46" title="In Proof. ‣ B.2 Proof of Lemma ‣ Appendix B Technical Propositions and Lemmas ‣ Stability and Generalization of Push-Sum Based Decentralized Optimization over Directed Graphs" class="ltx_ref"><span class="ltx_text ltx_ref_tag">46</span></a>), the term in parentheses equals <math id="A2.SS2.p5.m5" class="ltx_Math" alttext="m\overline{\bm{w}}^{(t)}" display="inline" intent=":literal"><semantics><mrow><mi>m</mi><mo lspace="0em" rspace="0em">​</mo><msup><mover accent="true"><mi>𝒘</mi><mo stretchy="true">¯</mo></mover><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup></mrow><annotation encoding="application/x-tex">m\overline{\bm{w}}^{(t)}</annotation></semantics></math>.
Moreover,</span></p>
<table id="A2.Ex23" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A2.Ex23.m1" class="ltx_Math" alttext="u_{i}^{(t)}\overline{\bm{w}}^{(t)}=(m\pi_{i}+(\bm{H}^{t}\bm{1})_{i})\overline{\bm{w}}^{(t)}=m\pi_{i}\overline{\bm{w}}^{(t)}+(\bm{H}^{t}\bm{1})_{i}\overline{\bm{w}}^{(t)}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><msubsup><mi>u</mi><mi>i</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mover accent="true"><mi>𝒘</mi><mo stretchy="true">¯</mo></mover><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup></mrow><mo>=</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mrow><mi>m</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>π</mi><mi>i</mi></msub></mrow><mo>+</mo><msub><mrow><mo stretchy="false">(</mo><mrow><msup><mi>𝑯</mi><mi>t</mi></msup><mo lspace="0em" rspace="0em">​</mo><mn>𝟏</mn></mrow><mo stretchy="false">)</mo></mrow><mi>i</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mover accent="true"><mi>𝒘</mi><mo stretchy="true">¯</mo></mover><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup></mrow><mo>=</mo><mrow><mrow><mi>m</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>π</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><msup><mover accent="true"><mi>𝒘</mi><mo stretchy="true">¯</mo></mover><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup></mrow><mo>+</mo><mrow><msub><mrow><mo stretchy="false">(</mo><mrow><msup><mi>𝑯</mi><mi>t</mi></msup><mo lspace="0em" rspace="0em">​</mo><mn>𝟏</mn></mrow><mo stretchy="false">)</mo></mrow><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><msup><mover accent="true"><mi>𝒘</mi><mo stretchy="true">¯</mo></mover><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">u_{i}^{(t)}\overline{\bm{w}}^{(t)}=(m\pi_{i}+(\bm{H}^{t}\bm{1})_{i})\overline{\bm{w}}^{(t)}=m\pi_{i}\overline{\bm{w}}^{(t)}+(\bm{H}^{t}\bm{1})_{i}\overline{\bm{w}}^{(t)}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A2.SS2.p5.3" class="ltx_p"><span id="A2.SS2.p5.3.1" class="ltx_text">Therefore the dominant term cancels and we obtain</span></p>
<table id="A2.E48" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A2.E48.m1" class="ltx_Math" alttext="\bm{w}_{i}^{(t)}-u_{i}^{(t)}\overline{\bm{w}}^{(t)}=\underbrace{\sum_{j=1}^{m}(\bm{H}^{t})_{ij}\bm{w}_{j}^{(0)}}_{\text{Term I}}-\underbrace{\sum_{s=0}^{t-1}\sum_{j=1}^{m}(\bm{H}^{t-s})_{ij}\gamma_{s}\nabla f(\bm{z}_{j}^{(s)};\bm{\xi}_{j}^{(s)})}_{\text{Term II}}-\underbrace{(\bm{H}^{t}\bm{1})_{i}\overline{\bm{w}}^{(t)}}_{\text{Term III}}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><msubsup><mi>𝒘</mi><mi>i</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msubsup><mo>−</mo><mrow><msubsup><mi>u</mi><mi>i</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mover accent="true"><mi>𝒘</mi><mo stretchy="true">¯</mo></mover><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup></mrow></mrow><mo rspace="0.111em">=</mo><mrow><munder><munder accentunder="true"><mrow><munderover><mo movablelimits="false" rspace="0em">∑</mo><mrow><mi>j</mi><mo>=</mo><mn>1</mn></mrow><mi>m</mi></munderover><mrow><msub><mrow><mo stretchy="false">(</mo><msup><mi>𝑯</mi><mi>t</mi></msup><mo stretchy="false">)</mo></mrow><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>j</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝒘</mi><mi>j</mi><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></msubsup></mrow></mrow><mo stretchy="true">⏟</mo></munder><mtext>Term I</mtext></munder><mo rspace="0.055em">−</mo><munder><munder accentunder="true"><mrow><mo movablelimits="false" rspace="0em">∑</mo><msub><mrow></mrow><mrow><mi>s</mi><mo>=</mo><mn>0</mn></mrow></msub><msup><mrow></mrow><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow></msup><mo movablelimits="false" rspace="0em">∑</mo><msub><mrow></mrow><mrow><mi>j</mi><mo>=</mo><mn>1</mn></mrow></msub><msup><mrow></mrow><mi>m</mi></msup><mo stretchy="false">(</mo><mi>𝑯</mi><msup><mrow></mrow><mrow><mi>t</mi><mo>−</mo><mi>s</mi></mrow></msup><mo stretchy="false">)</mo><msub><mrow></mrow><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>j</mi></mrow></msub><mi>γ</mi><msub><mrow></mrow><mi>s</mi></msub><mo lspace="0.167em" rspace="0.167em">∇</mo><mi>f</mi><mo stretchy="false">(</mo><mi>𝒛</mi><msub><mrow></mrow><mi>j</mi></msub><msup><mrow></mrow><mrow><mo stretchy="false">(</mo><mi>s</mi><mo stretchy="false">)</mo></mrow></msup><mo>;</mo><mi>𝝃</mi><msub><mrow></mrow><mi>j</mi></msub><msup><mrow></mrow><mrow><mo stretchy="false">(</mo><mi>s</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow><mo stretchy="true">⏟</mo></munder><mtext>Term II</mtext></munder><mo>−</mo><munder><munder accentunder="true"><mrow><msub><mrow><mo stretchy="false">(</mo><mrow><msup><mi>𝑯</mi><mi>t</mi></msup><mo lspace="0em" rspace="0em">​</mo><mn>𝟏</mn></mrow><mo stretchy="false">)</mo></mrow><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><msup><mover accent="true"><mi>𝒘</mi><mo stretchy="true">¯</mo></mover><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup></mrow><mo stretchy="true">⏟</mo></munder><mtext>Term III</mtext></munder></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\bm{w}_{i}^{(t)}-u_{i}^{(t)}\overline{\bm{w}}^{(t)}=\underbrace{\sum_{j=1}^{m}(\bm{H}^{t})_{ij}\bm{w}_{j}^{(0)}}_{\text{Term I}}-\underbrace{\sum_{s=0}^{t-1}\sum_{j=1}^{m}(\bm{H}^{t-s})_{ij}\gamma_{s}\nabla f(\bm{z}_{j}^{(s)};\bm{\xi}_{j}^{(s)})}_{\text{Term II}}-\underbrace{(\bm{H}^{t}\bm{1})_{i}\overline{\bm{w}}^{(t)}}_{\text{Term III}}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(48)</span></td></tr></tbody>
</table>
</div>
<div id="A2.SS2.p6" class="ltx_para">
<p id="A2.SS2.p6.1" class="ltx_p"><span id="A2.SS2.p6.1.1" class="ltx_text">For Term I, using (<a href="#A2.E41" title="In Proof. ‣ B.2 Proof of Lemma ‣ Appendix B Technical Propositions and Lemmas ‣ Stability and Generalization of Push-Sum Based Decentralized Optimization over Directed Graphs" class="ltx_ref"><span class="ltx_text ltx_ref_tag">41</span></a>) and the definition of <math id="A2.SS2.p6.m1" class="ltx_Math" alttext="C_{w_{0}}" display="inline" intent=":literal"><semantics><msub><mi>C</mi><msub><mi>w</mi><mn>0</mn></msub></msub><annotation encoding="application/x-tex">C_{w_{0}}</annotation></semantics></math>,</span></p>
<table id="A2.EGx4" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A2.Ex24"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A2.Ex24.m1" class="ltx_Math" alttext="\displaystyle\|\text{Term I}\|" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">‖</mo><mtext>Term I</mtext><mo stretchy="false">‖</mo></mrow><annotation encoding="application/x-tex">\displaystyle\|\text{Term I}\|</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex24.m2" class="ltx_Math" alttext="\displaystyle\leq\sum_{j=1}^{m}|(\bm{H}^{t})_{ij}|\|\bm{w}_{j}^{(0)}\|\leq\|\bm{H}^{t}\|_{\infty}\sum_{j=1}^{m}\|\bm{w}_{j}^{(0)}\|" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≤</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>j</mi><mo>=</mo><mn>1</mn></mrow><mi>m</mi></munderover></mstyle><mrow><mrow><mo stretchy="false">|</mo><msub><mrow><mo stretchy="false">(</mo><msup><mi>𝑯</mi><mi>t</mi></msup><mo stretchy="false">)</mo></mrow><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>j</mi></mrow></msub><mo stretchy="false">|</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">‖</mo><msubsup><mi>𝒘</mi><mi>j</mi><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></msubsup><mo stretchy="false">‖</mo></mrow></mrow></mrow><mo>≤</mo><mrow><msub><mrow><mo stretchy="false">‖</mo><msup><mi>𝑯</mi><mi>t</mi></msup><mo stretchy="false">‖</mo></mrow><mi mathvariant="normal">∞</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>j</mi><mo>=</mo><mn>1</mn></mrow><mi>m</mi></munderover></mstyle><mrow><mo stretchy="false">‖</mo><msubsup><mi>𝒘</mi><mi>j</mi><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></msubsup><mo stretchy="false">‖</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\leq\sum_{j=1}^{m}|(\bm{H}^{t})_{ij}|\|\bm{w}_{j}^{(0)}\|\leq\|\bm{H}^{t}\|_{\infty}\sum_{j=1}^{m}\|\bm{w}_{j}^{(0)}\|</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A2.E49"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.E49.m1" class="ltx_Math" alttext="\displaystyle\leq C_{H}\lambda^{t}\sum_{j=1}^{m}\|\bm{w}_{j}^{(0)}\|=mC_{H}\lambda^{t}\,C_{w_{0}}." display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>≤</mo><mrow><msub><mi>C</mi><mi>H</mi></msub><mo lspace="0em" rspace="0em">​</mo><msup><mi>λ</mi><mi>t</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>j</mi><mo>=</mo><mn>1</mn></mrow><mi>m</mi></munderover></mstyle><mrow><mo stretchy="false">‖</mo><msubsup><mi>𝒘</mi><mi>j</mi><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></msubsup><mo stretchy="false">‖</mo></mrow></mrow></mrow><mo>=</mo><mrow><mi>m</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>C</mi><mi>H</mi></msub><mo lspace="0em" rspace="0em">​</mo><msup><mi>λ</mi><mi>t</mi></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>C</mi><msub><mi>w</mi><mn>0</mn></msub></msub></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\leq C_{H}\lambda^{t}\sum_{j=1}^{m}\|\bm{w}_{j}^{(0)}\|=mC_{H}\lambda^{t}\,C_{w_{0}}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(49)</span></td></tr></tbody>
</table>
</div>
<div id="A2.SS2.p7" class="ltx_para">
<p id="A2.SS2.p7.1" class="ltx_p"><span id="A2.SS2.p7.1.1" class="ltx_text">For Term II,
by the triangle inequality and the uniform bound <math id="A2.SS2.p7.m1" class="ltx_Math" alttext="\|\nabla f(\bm{z}_{j}^{(s)};\bm{\xi}_{j}^{(s)})\|\leq G" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">‖</mo><mrow><mrow><mo rspace="0.167em">∇</mo><mi>f</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>𝒛</mi><mi>j</mi><mrow><mo stretchy="false">(</mo><mi>s</mi><mo stretchy="false">)</mo></mrow></msubsup><mo>,</mo><msubsup><mi>𝝃</mi><mi>j</mi><mrow><mo stretchy="false">(</mo><mi>s</mi><mo stretchy="false">)</mo></mrow></msubsup><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">‖</mo></mrow><mo>≤</mo><mi>G</mi></mrow><annotation encoding="application/x-tex">\|\nabla f(\bm{z}_{j}^{(s)};\bm{\xi}_{j}^{(s)})\|\leq G</annotation></semantics></math>,</span></p>
<table id="A2.EGx5" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A2.Ex25"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A2.Ex25.m1" class="ltx_Math" alttext="\displaystyle\|\text{Term II}\|" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">‖</mo><mtext>Term II</mtext><mo stretchy="false">‖</mo></mrow><annotation encoding="application/x-tex">\displaystyle\|\text{Term II}\|</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex25.m2" class="ltx_Math" alttext="\displaystyle\leq\sum_{s=0}^{t-1}\sum_{j=1}^{m}|(\bm{H}^{t-s})_{ij}|\gamma_{s}\big\|\nabla f(\bm{z}_{j}^{(s)};\bm{\xi}_{j}^{(s)})\big\|" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≤</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>s</mi><mo>=</mo><mn>0</mn></mrow><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow></munderover></mstyle><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>j</mi><mo>=</mo><mn>1</mn></mrow><mi>m</mi></munderover></mstyle><mrow><mrow><mo stretchy="false">|</mo><msub><mrow><mo stretchy="false">(</mo><msup><mi>𝑯</mi><mrow><mi>t</mi><mo>−</mo><mi>s</mi></mrow></msup><mo stretchy="false">)</mo></mrow><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>j</mi></mrow></msub><mo stretchy="false">|</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>γ</mi><mi>s</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="1.200em" minsize="1.200em" stretchy="true">‖</mo><mrow><mrow><mo rspace="0.167em">∇</mo><mi>f</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>𝒛</mi><mi>j</mi><mrow><mo stretchy="false">(</mo><mi>s</mi><mo stretchy="false">)</mo></mrow></msubsup><mo>,</mo><msubsup><mi>𝝃</mi><mi>j</mi><mrow><mo stretchy="false">(</mo><mi>s</mi><mo stretchy="false">)</mo></mrow></msubsup><mo stretchy="false">)</mo></mrow></mrow><mo maxsize="1.200em" minsize="1.200em" stretchy="true">‖</mo></mrow></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\leq\sum_{s=0}^{t-1}\sum_{j=1}^{m}|(\bm{H}^{t-s})_{ij}|\gamma_{s}\big\|\nabla f(\bm{z}_{j}^{(s)};\bm{\xi}_{j}^{(s)})\big\|</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A2.Ex26"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex26.m1" class="ltx_Math" alttext="\displaystyle\leq G\sum_{s=0}^{t-1}\gamma_{s}\sum_{j=1}^{m}|(\bm{H}^{t-s})_{ij}|\leq G\sum_{s=0}^{t-1}\gamma_{s}\|\bm{H}^{t-s}\|_{\infty}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≤</mo><mrow><mi>G</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>s</mi><mo>=</mo><mn>0</mn></mrow><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow></munderover></mstyle><mrow><msub><mi>γ</mi><mi>s</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>j</mi><mo>=</mo><mn>1</mn></mrow><mi>m</mi></munderover></mstyle><mrow><mo stretchy="false">|</mo><msub><mrow><mo stretchy="false">(</mo><msup><mi>𝑯</mi><mrow><mi>t</mi><mo>−</mo><mi>s</mi></mrow></msup><mo stretchy="false">)</mo></mrow><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>j</mi></mrow></msub><mo stretchy="false">|</mo></mrow></mrow></mrow></mrow></mrow><mo>≤</mo><mrow><mi>G</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>s</mi><mo>=</mo><mn>0</mn></mrow><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow></munderover></mstyle><mrow><msub><mi>γ</mi><mi>s</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">‖</mo><msup><mi>𝑯</mi><mrow><mi>t</mi><mo>−</mo><mi>s</mi></mrow></msup><mo stretchy="false">‖</mo></mrow><mi mathvariant="normal">∞</mi></msub></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\leq G\sum_{s=0}^{t-1}\gamma_{s}\sum_{j=1}^{m}|(\bm{H}^{t-s})_{ij}|\leq G\sum_{s=0}^{t-1}\gamma_{s}\|\bm{H}^{t-s}\|_{\infty}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A2.E50"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.E50.m1" class="ltx_Math" alttext="\displaystyle\leq GC_{H}\sum_{s=0}^{t-1}\lambda^{t-s}\gamma_{s}." display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>≤</mo><mrow><mi>G</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>C</mi><mi>H</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>s</mi><mo>=</mo><mn>0</mn></mrow><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow></munderover></mstyle><mrow><msup><mi>λ</mi><mrow><mi>t</mi><mo>−</mo><mi>s</mi></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>γ</mi><mi>s</mi></msub></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\leq GC_{H}\sum_{s=0}^{t-1}\lambda^{t-s}\gamma_{s}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(50)</span></td></tr></tbody>
</table>
</div>
<div id="A2.SS2.p8" class="ltx_para">
<p id="A2.SS2.p8.1" class="ltx_p"><span id="A2.SS2.p8.1.1" class="ltx_text">For Term III,
using <math id="A2.SS2.p8.m1" class="ltx_Math" alttext="|(\bm{H}^{t}\bm{1})_{i}|\leq\|\bm{H}^{t}\|_{\infty}\|\bm{1}\|_{\infty}\leq C_{H}\lambda^{t}" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">|</mo><msub><mrow><mo stretchy="false">(</mo><mrow><msup><mi>𝑯</mi><mi>t</mi></msup><mo lspace="0em" rspace="0em">​</mo><mn>𝟏</mn></mrow><mo stretchy="false">)</mo></mrow><mi>i</mi></msub><mo stretchy="false">|</mo></mrow><mo>≤</mo><mrow><msub><mrow><mo stretchy="false">‖</mo><msup><mi>𝑯</mi><mi>t</mi></msup><mo stretchy="false">‖</mo></mrow><mi mathvariant="normal">∞</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">‖</mo><mn>𝟏</mn><mo stretchy="false">‖</mo></mrow><mi mathvariant="normal">∞</mi></msub></mrow><mo>≤</mo><mrow><msub><mi>C</mi><mi>H</mi></msub><mo lspace="0em" rspace="0em">​</mo><msup><mi>λ</mi><mi>t</mi></msup></mrow></mrow><annotation encoding="application/x-tex">|(\bm{H}^{t}\bm{1})_{i}|\leq\|\bm{H}^{t}\|_{\infty}\|\bm{1}\|_{\infty}\leq C_{H}\lambda^{t}</annotation></semantics></math>
and (<a href="#A2.E46" title="In Proof. ‣ B.2 Proof of Lemma ‣ Appendix B Technical Propositions and Lemmas ‣ Stability and Generalization of Push-Sum Based Decentralized Optimization over Directed Graphs" class="ltx_ref"><span class="ltx_text ltx_ref_tag">46</span></a>) together with the uniform gradient bound,</span></p>
<table id="A2.EGx6" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A2.Ex27"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A2.Ex27.m1" class="ltx_Math" alttext="\displaystyle\|\text{Term III}\|" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">‖</mo><mtext>Term III</mtext><mo stretchy="false">‖</mo></mrow><annotation encoding="application/x-tex">\displaystyle\|\text{Term III}\|</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex27.m2" class="ltx_math_unparsed" alttext="\displaystyle=|(\bm{H}^{t}\bm{1})_{i}|\cdot\|\overline{\bm{w}}^{(t)}\|\leq C_{H}\lambda^{t}\left\|\frac{1}{m}\sum_{j=1}^{m}\bm{w}_{j}^{(0)}-\frac{1}{m}\sum_{s=0}^{t-1}\sum_{j=1}^{m}\gamma_{s}\nabla f(\bm{z}_{j}^{(s)};\bm{\xi}_{j}^{(s)})\right\|" display="inline" intent=":literal"><semantics><mrow><mo rspace="0em">=</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><msub><mrow><mo stretchy="false">(</mo><msup><mi>𝑯</mi><mi>t</mi></msup><mn>𝟏</mn><mo stretchy="false">)</mo></mrow><mi>i</mi></msub><mo fence="false" stretchy="false">|</mo><mo lspace="0em" rspace="0em">⋅</mo><mo lspace="0em" rspace="0.167em">∥</mo><msup><mover accent="true"><mi>𝒘</mi><mo stretchy="true">¯</mo></mover><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo lspace="0em" rspace="0.0835em">∥</mo><mo lspace="0.0835em">≤</mo><msub><mi>C</mi><mi>H</mi></msub><msup><mi>λ</mi><mi>t</mi></msup><mrow><mo>‖</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>m</mi></mfrac></mstyle><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>j</mi><mo>=</mo><mn>1</mn></mrow><mi>m</mi></munderover></mstyle><msubsup><mi>𝒘</mi><mi>j</mi><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></msubsup><mo>−</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>m</mi></mfrac></mstyle><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>s</mi><mo>=</mo><mn>0</mn></mrow><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow></munderover></mstyle><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>j</mi><mo>=</mo><mn>1</mn></mrow><mi>m</mi></munderover></mstyle><msub><mi>γ</mi><mi>s</mi></msub><mo lspace="0.167em" rspace="0.167em">∇</mo><mi>f</mi><mrow><mo stretchy="false">(</mo><msubsup><mi>𝒛</mi><mi>j</mi><mrow><mo stretchy="false">(</mo><mi>s</mi><mo stretchy="false">)</mo></mrow></msubsup><mo>;</mo><msubsup><mi>𝝃</mi><mi>j</mi><mrow><mo stretchy="false">(</mo><mi>s</mi><mo stretchy="false">)</mo></mrow></msubsup><mo stretchy="false">)</mo></mrow><mo>‖</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=|(\bm{H}^{t}\bm{1})_{i}|\cdot\|\overline{\bm{w}}^{(t)}\|\leq C_{H}\lambda^{t}\left\|\frac{1}{m}\sum_{j=1}^{m}\bm{w}_{j}^{(0)}-\frac{1}{m}\sum_{s=0}^{t-1}\sum_{j=1}^{m}\gamma_{s}\nabla f(\bm{z}_{j}^{(s)};\bm{\xi}_{j}^{(s)})\right\|</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A2.Ex28"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex28.m1" class="ltx_Math" alttext="\displaystyle\leq C_{H}\lambda^{t}\left(\frac{1}{m}\sum_{j=1}^{m}\|\bm{w}_{j}^{(0)}\|+\frac{1}{m}\sum_{s=0}^{t-1}\sum_{j=1}^{m}\gamma_{s}\big\|\nabla f(\bm{z}_{j}^{(s)};\bm{\xi}_{j}^{(s)})\big\|\right)" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≤</mo><mrow><msub><mi>C</mi><mi>H</mi></msub><mo lspace="0em" rspace="0em">​</mo><msup><mi>λ</mi><mi>t</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>m</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>j</mi><mo>=</mo><mn>1</mn></mrow><mi>m</mi></munderover></mstyle><mrow><mo stretchy="false">‖</mo><msubsup><mi>𝒘</mi><mi>j</mi><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></msubsup><mo stretchy="false">‖</mo></mrow></mrow></mrow><mo>+</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>m</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>s</mi><mo>=</mo><mn>0</mn></mrow><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow></munderover></mstyle><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>j</mi><mo>=</mo><mn>1</mn></mrow><mi>m</mi></munderover></mstyle><mrow><msub><mi>γ</mi><mi>s</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="1.200em" minsize="1.200em" stretchy="true">‖</mo><mrow><mrow><mo rspace="0.167em">∇</mo><mi>f</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>𝒛</mi><mi>j</mi><mrow><mo stretchy="false">(</mo><mi>s</mi><mo stretchy="false">)</mo></mrow></msubsup><mo>,</mo><msubsup><mi>𝝃</mi><mi>j</mi><mrow><mo stretchy="false">(</mo><mi>s</mi><mo stretchy="false">)</mo></mrow></msubsup><mo stretchy="false">)</mo></mrow></mrow><mo maxsize="1.200em" minsize="1.200em" stretchy="true">‖</mo></mrow></mrow></mrow></mrow></mrow></mrow><mo>)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\leq C_{H}\lambda^{t}\left(\frac{1}{m}\sum_{j=1}^{m}\|\bm{w}_{j}^{(0)}\|+\frac{1}{m}\sum_{s=0}^{t-1}\sum_{j=1}^{m}\gamma_{s}\big\|\nabla f(\bm{z}_{j}^{(s)};\bm{\xi}_{j}^{(s)})\big\|\right)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A2.E51"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.E51.m1" class="ltx_Math" alttext="\displaystyle\leq C_{H}\lambda^{t}\left(C_{w_{0}}+G\sum_{s=0}^{t-1}\gamma_{s}\right)." display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>≤</mo><mrow><msub><mi>C</mi><mi>H</mi></msub><mo lspace="0em" rspace="0em">​</mo><msup><mi>λ</mi><mi>t</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><msub><mi>C</mi><msub><mi>w</mi><mn>0</mn></msub></msub><mo>+</mo><mrow><mi>G</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>s</mi><mo>=</mo><mn>0</mn></mrow><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow></munderover></mstyle><msub><mi>γ</mi><mi>s</mi></msub></mrow></mrow></mrow><mo>)</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\leq C_{H}\lambda^{t}\left(C_{w_{0}}+G\sum_{s=0}^{t-1}\gamma_{s}\right).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(51)</span></td></tr></tbody>
</table>
</div>
<div id="A2.SS2.p9" class="ltx_para">
<p id="A2.SS2.p9.1" class="ltx_p"><span id="A2.SS2.p9.1.1" class="ltx_text">Combining (<a href="#A2.E49" title="In Proof. ‣ B.2 Proof of Lemma ‣ Appendix B Technical Propositions and Lemmas ‣ Stability and Generalization of Push-Sum Based Decentralized Optimization over Directed Graphs" class="ltx_ref"><span class="ltx_text ltx_ref_tag">49</span></a>)–(<a href="#A2.E51" title="In Proof. ‣ B.2 Proof of Lemma ‣ Appendix B Technical Propositions and Lemmas ‣ Stability and Generalization of Push-Sum Based Decentralized Optimization over Directed Graphs" class="ltx_ref"><span class="ltx_text ltx_ref_tag">51</span></a>) and absorbing numerical factors into a constant <math id="A2.SS2.p9.m1" class="ltx_Math" alttext="C^{\prime}&gt;0" display="inline" intent=":literal"><semantics><mrow><msup><mi>C</mi><mo>′</mo></msup><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">C^{\prime}&gt;0</annotation></semantics></math>,
we obtain</span></p>
<table id="A2.E52" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A2.E52.m1" class="ltx_Math" alttext="\|\bm{w}_{i}^{(t)}-u_{i}^{(t)}\overline{\bm{w}}^{(t)}\|\leq mC^{\prime}\left(\lambda^{t}C_{w_{0}}+G\sum_{s=0}^{t-1}\lambda^{t-s}\gamma_{s}\right)," display="block" intent=":literal"><semantics><mrow><mrow><mrow><mo stretchy="false">‖</mo><mrow><msubsup><mi>𝒘</mi><mi>i</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msubsup><mo>−</mo><mrow><msubsup><mi>u</mi><mi>i</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mover accent="true"><mi>𝒘</mi><mo stretchy="true">¯</mo></mover><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup></mrow></mrow><mo stretchy="false">‖</mo></mrow><mo>≤</mo><mrow><mi>m</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>C</mi><mo>′</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mrow><msup><mi>λ</mi><mi>t</mi></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>C</mi><msub><mi>w</mi><mn>0</mn></msub></msub></mrow><mo>+</mo><mrow><mi>G</mi><mo lspace="0em" rspace="0em">​</mo><mrow><munderover><mo movablelimits="false">∑</mo><mrow><mi>s</mi><mo>=</mo><mn>0</mn></mrow><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow></munderover><mrow><msup><mi>λ</mi><mrow><mi>t</mi><mo>−</mo><mi>s</mi></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>γ</mi><mi>s</mi></msub></mrow></mrow></mrow></mrow><mo>)</mo></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\|\bm{w}_{i}^{(t)}-u_{i}^{(t)}\overline{\bm{w}}^{(t)}\|\leq mC^{\prime}\left(\lambda^{t}C_{w_{0}}+G\sum_{s=0}^{t-1}\lambda^{t-s}\gamma_{s}\right),</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(52)</span></td></tr></tbody>
</table>
<p id="A2.SS2.p9.2" class="ltx_p"><span id="A2.SS2.p9.2.1" class="ltx_text">where we used that <math id="A2.SS2.p9.m2" class="ltx_Math" alttext="\sum_{s=0}^{t-1}\gamma_{s}\leq\sum_{s=0}^{t-1}\lambda^{t-s}\gamma_{s}/(\min_{1\leq k\leq t}\lambda^{k})" display="inline" intent=":literal"><semantics><mrow><mrow><msubsup><mo>∑</mo><mrow><mi>s</mi><mo>=</mo><mn>0</mn></mrow><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow></msubsup><msub><mi>γ</mi><mi>s</mi></msub></mrow><mo rspace="0.111em">≤</mo><mrow><mrow><msubsup><mo>∑</mo><mrow><mi>s</mi><mo>=</mo><mn>0</mn></mrow><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow></msubsup><mrow><msup><mi>λ</mi><mrow><mi>t</mi><mo>−</mo><mi>s</mi></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>γ</mi><mi>s</mi></msub></mrow></mrow><mo>/</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>min</mi><mrow><mn>1</mn><mo>≤</mo><mi>k</mi><mo>≤</mo><mi>t</mi></mrow></msub><mo lspace="0.167em">⁡</mo><msup><mi>λ</mi><mi>k</mi></msup></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\sum_{s=0}^{t-1}\gamma_{s}\leq\sum_{s=0}^{t-1}\lambda^{t-s}\gamma_{s}/(\min_{1\leq k\leq t}\lambda^{k})</annotation></semantics></math>
and absorbed into <math id="A2.SS2.p9.m3" class="ltx_Math" alttext="C^{\prime}" display="inline" intent=":literal"><semantics><msup><mi>C</mi><mo>′</mo></msup><annotation encoding="application/x-tex">C^{\prime}</annotation></semantics></math>.</span></p>
</div>
<div id="A2.SS2.p10" class="ltx_para">
<p id="A2.SS2.p10.1" class="ltx_p"><span id="A2.SS2.p10.1.1" class="ltx_text">Finally, using (<a href="#A2.E43" title="In Proof. ‣ B.2 Proof of Lemma ‣ Appendix B Technical Propositions and Lemmas ‣ Stability and Generalization of Push-Sum Based Decentralized Optimization over Directed Graphs" class="ltx_ref"><span class="ltx_text ltx_ref_tag">43</span></a>),</span></p>
<table id="A2.EGx7" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A2.Ex29"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A2.Ex29.m1" class="ltx_Math" alttext="\displaystyle\|\bm{z}_{i}^{(t)}-\overline{\bm{w}}^{(t)}\|" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">‖</mo><mrow><msubsup><mi>𝒛</mi><mi>i</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msubsup><mo>−</mo><msup><mover accent="true"><mi>𝒘</mi><mo stretchy="true">¯</mo></mover><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup></mrow><mo stretchy="false">‖</mo></mrow><annotation encoding="application/x-tex">\displaystyle\|\bm{z}_{i}^{(t)}-\overline{\bm{w}}^{(t)}\|</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex29.m2" class="ltx_Math" alttext="\displaystyle=\frac{1}{u_{i}^{(t)}}\|\bm{w}_{i}^{(t)}-u_{i}^{(t)}\overline{\bm{w}}^{(t)}\|\leq\frac{2}{m\delta}\|\bm{w}_{i}^{(t)}-u_{i}^{(t)}\overline{\bm{w}}^{(t)}\|" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><msubsup><mi>u</mi><mi>i</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msubsup></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">‖</mo><mrow><msubsup><mi>𝒘</mi><mi>i</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msubsup><mo>−</mo><mrow><msubsup><mi>u</mi><mi>i</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mover accent="true"><mi>𝒘</mi><mo stretchy="true">¯</mo></mover><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup></mrow></mrow><mo stretchy="false">‖</mo></mrow></mrow><mo>≤</mo><mrow><mstyle displaystyle="true"><mfrac><mn>2</mn><mrow><mi>m</mi><mo lspace="0em" rspace="0em">​</mo><mi>δ</mi></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">‖</mo><mrow><msubsup><mi>𝒘</mi><mi>i</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msubsup><mo>−</mo><mrow><msubsup><mi>u</mi><mi>i</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mover accent="true"><mi>𝒘</mi><mo stretchy="true">¯</mo></mover><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup></mrow></mrow><mo stretchy="false">‖</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\frac{1}{u_{i}^{(t)}}\|\bm{w}_{i}^{(t)}-u_{i}^{(t)}\overline{\bm{w}}^{(t)}\|\leq\frac{2}{m\delta}\|\bm{w}_{i}^{(t)}-u_{i}^{(t)}\overline{\bm{w}}^{(t)}\|</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A2.E53"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.E53.m1" class="ltx_Math" alttext="\displaystyle\leq\frac{C}{\delta}\left(\lambda^{t}C_{w_{0}}+G\sum_{s=0}^{t-1}\lambda^{t-s}\gamma_{s}\right)," display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>≤</mo><mrow><mstyle displaystyle="true"><mfrac><mi>C</mi><mi>δ</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mrow><msup><mi>λ</mi><mi>t</mi></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>C</mi><msub><mi>w</mi><mn>0</mn></msub></msub></mrow><mo>+</mo><mrow><mi>G</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>s</mi><mo>=</mo><mn>0</mn></mrow><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow></munderover></mstyle><mrow><msup><mi>λ</mi><mrow><mi>t</mi><mo>−</mo><mi>s</mi></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>γ</mi><mi>s</mi></msub></mrow></mrow></mrow></mrow><mo>)</mo></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\leq\frac{C}{\delta}\left(\lambda^{t}C_{w_{0}}+G\sum_{s=0}^{t-1}\lambda^{t-s}\gamma_{s}\right),</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(53)</span></td></tr></tbody>
</table>
<p id="A2.SS2.p10.2" class="ltx_p"><span id="A2.SS2.p10.2.1" class="ltx_text">where <math id="A2.SS2.p10.m1" class="ltx_Math" alttext="C&gt;0" display="inline" intent=":literal"><semantics><mrow><mi>C</mi><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">C&gt;0</annotation></semantics></math> absorbs <math id="A2.SS2.p10.m2" class="ltx_Math" alttext="C^{\prime}" display="inline" intent=":literal"><semantics><msup><mi>C</mi><mo>′</mo></msup><annotation encoding="application/x-tex">C^{\prime}</annotation></semantics></math> and numerical constants. This completes the proof.
∎</span></p>
</div>
</div>
</section>
</section>
<section id="A3" class="ltx_appendix">
<h2 class="ltx_title ltx_title_appendix"><span class="ltx_tag ltx_tag_appendix">Appendix C </span>Proof of Theorem and Corollary</h2>

<section id="A3.SS1" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">C.1 </span>Proof of Theorem <a href="#Thmtheorem22" title="Theorem 22 (Uniform Stability). ‣ 4.2 Results on Convex Case ‣ 4 Theoretical Analysis ‣ Stability and Generalization of Push-Sum Based Decentralized Optimization over Directed Graphs" class="ltx_ref"><span class="ltx_text ltx_ref_tag">22</span></a></h3>

<div id="A3.SS1.2" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="A3.SS1.p1" class="ltx_para">
<p id="A3.SS1.p1.1" class="ltx_p"><span id="A3.SS1.p1.1.1" class="ltx_text">Suppose the two sample sets <math id="A3.SS1.p1.m1" class="ltx_Math" alttext="\bm{S}" display="inline" intent=":literal"><semantics><mi>𝑺</mi><annotation encoding="application/x-tex">\bm{S}</annotation></semantics></math> and <math id="A3.SS1.p1.m2" class="ltx_Math" alttext="\bm{S}^{\prime}" display="inline" intent=":literal"><semantics><msup><mi>𝑺</mi><mo>′</mo></msup><annotation encoding="application/x-tex">\bm{S}^{\prime}</annotation></semantics></math> differ in only one sample among the <math id="A3.SS1.p1.m3" class="ltx_Math" alttext="n" display="inline" intent=":literal"><semantics><mi>n</mi><annotation encoding="application/x-tex">n</annotation></semantics></math> samples.
Assume that at each iteration <math id="A3.SS1.p1.m4" class="ltx_Math" alttext="t" display="inline" intent=":literal"><semantics><mi>t</mi><annotation encoding="application/x-tex">t</annotation></semantics></math>, a global index is sampled uniformly from <math id="A3.SS1.p1.m5" class="ltx_Math" alttext="\{1,\dots,n\}" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">{</mo><mn>1</mn><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mi>n</mi><mo stretchy="false">}</mo></mrow><annotation encoding="application/x-tex">\{1,\dots,n\}</annotation></semantics></math> and broadcast to all nodes.
Then with probability <math id="A3.SS1.p1.m6" class="ltx_Math" alttext="1-\frac{1}{n}" display="inline" intent=":literal"><semantics><mrow><mn>1</mn><mo>−</mo><mfrac><mn>1</mn><mi>n</mi></mfrac></mrow><annotation encoding="application/x-tex">1-\frac{1}{n}</annotation></semantics></math>, the sampled indices at all nodes are identical for both runs; with probability <math id="A3.SS1.p1.m7" class="ltx_Math" alttext="\frac{1}{n}" display="inline" intent=":literal"><semantics><mfrac><mn>1</mn><mi>n</mi></mfrac><annotation encoding="application/x-tex">\frac{1}{n}</annotation></semantics></math>, the sampled point differs.</span></p>
</div>
<div id="A3.SS1.p2" class="ltx_para">
<p id="A3.SS1.p2.1" class="ltx_p"><span id="A3.SS1.p2.1.1" class="ltx_text">Let <math id="A3.SS1.p2.m1" class="ltx_Math" alttext="\Delta_{t}:=\|\overline{\bm{w}}^{(t)}-\overline{\bm{w}}^{\prime(t)}\|" display="inline" intent=":literal"><semantics><mrow><msub><mi mathvariant="normal">Δ</mi><mi>t</mi></msub><mo>:=</mo><mrow><mo stretchy="false">‖</mo><mrow><msup><mover accent="true"><mi>𝒘</mi><mo stretchy="true">¯</mo></mover><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo>−</mo><msup><mover accent="true"><mi>𝒘</mi><mo stretchy="true">¯</mo></mover><mrow><mo rspace="0em">′</mo><mphantom></mphantom><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow></msup></mrow><mo stretchy="false">‖</mo></mrow></mrow><annotation encoding="application/x-tex">\Delta_{t}:=\|\overline{\bm{w}}^{(t)}-\overline{\bm{w}}^{\prime(t)}\|</annotation></semantics></math> and assume <math id="A3.SS1.p2.m2" class="ltx_Math" alttext="\overline{\bm{w}}^{(0)}=\overline{\bm{w}}^{\prime(0)}" display="inline" intent=":literal"><semantics><mrow><msup><mover accent="true"><mi>𝒘</mi><mo stretchy="true">¯</mo></mover><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></msup><mo>=</mo><msup><mover accent="true"><mi>𝒘</mi><mo stretchy="true">¯</mo></mover><mrow><mo rspace="0em">′</mo><mphantom></mphantom><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></mrow></msup></mrow><annotation encoding="application/x-tex">\overline{\bm{w}}^{(0)}=\overline{\bm{w}}^{\prime(0)}</annotation></semantics></math>, i.e., <math id="A3.SS1.p2.m3" class="ltx_Math" alttext="\Delta_{0}=0" display="inline" intent=":literal"><semantics><mrow><msub><mi mathvariant="normal">Δ</mi><mn>0</mn></msub><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\Delta_{0}=0</annotation></semantics></math>.</span></p>
</div>
</div>
<section id="A3.SS1.SSS0.Px1" class="ltx_paragraph">
<h4 class="ltx_title ltx_title_paragraph">Case 1: Identical Samples.</h4>

<div id="A3.SS1.SSS0.Px1.p1" class="ltx_para">
<p id="A3.SS1.SSS0.Px1.p1.1" class="ltx_p">Using Proposition <a href="#Thmtheorem7" title="Proposition 7. ‣ 3.3 Algorithm: Stochastic Gradient Push (SGP) ‣ 3 Preliminaries ‣ Stability and Generalization of Push-Sum Based Decentralized Optimization over Directed Graphs" class="ltx_ref"><span class="ltx_text ltx_ref_tag">7</span></a> and adding/subtracting
<math id="A3.SS1.SSS0.Px1.p1.m1" class="ltx_Math" alttext="\nabla f(\overline{\bm{w}}^{(t)};\bm{\xi}_{i}^{(t)})" display="inline" intent=":literal"><semantics><mrow><mrow><mo rspace="0.167em">∇</mo><mi>f</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mover accent="true"><mi>𝒘</mi><mo stretchy="true">¯</mo></mover><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo>,</mo><msubsup><mi>𝝃</mi><mi>i</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msubsup><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\nabla f(\overline{\bm{w}}^{(t)};\bm{\xi}_{i}^{(t)})</annotation></semantics></math> and
<math id="A3.SS1.SSS0.Px1.p1.m2" class="ltx_Math" alttext="\nabla f(\overline{\bm{w}}^{\prime(t)};\bm{\xi}_{i}^{(t)})" display="inline" intent=":literal"><semantics><mrow><mrow><mo rspace="0.167em">∇</mo><mi>f</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mover accent="true"><mi>𝒘</mi><mo stretchy="true">¯</mo></mover><mrow><mo rspace="0em">′</mo><mphantom></mphantom><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow></msup><mo>,</mo><msubsup><mi>𝝃</mi><mi>i</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msubsup><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\nabla f(\overline{\bm{w}}^{\prime(t)};\bm{\xi}_{i}^{(t)})</annotation></semantics></math>, we obtain</p>
<table id="A3.EGx8" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A3.Ex30"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.Ex30.m1" class="ltx_Math" alttext="\displaystyle\Delta_{t+1}" display="inline" intent=":literal"><semantics><msub><mi mathvariant="normal">Δ</mi><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow></msub><annotation encoding="application/x-tex">\displaystyle\Delta_{t+1}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex30.m2" class="ltx_Math" alttext="\displaystyle=\Big\|\overline{\bm{w}}^{(t)}-\overline{\bm{w}}^{\prime(t)}-\frac{\gamma_{t}}{m}\sum_{i=1}^{m}\big(\nabla f(\bm{z}_{i}^{(t)};\bm{\xi}_{i}^{(t)})-\nabla f(\bm{z}_{i}^{\prime(t)};\bm{\xi}_{i}^{(t)})\big)\Big\|" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mo maxsize="1.600em" minsize="1.600em" stretchy="true">‖</mo><mrow><msup><mover accent="true"><mi>𝒘</mi><mo stretchy="true">¯</mo></mover><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo>−</mo><msup><mover accent="true"><mi>𝒘</mi><mo stretchy="true">¯</mo></mover><mrow><mo rspace="0em">′</mo><mphantom></mphantom><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow></msup><mo>−</mo><mrow><mstyle displaystyle="true"><mfrac><msub><mi>γ</mi><mi>t</mi></msub><mi>m</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>m</mi></munderover></mstyle><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mrow><mrow><mrow><mo rspace="0.167em">∇</mo><mi>f</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>𝒛</mi><mi>i</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msubsup><mo>,</mo><msubsup><mi>𝝃</mi><mi>i</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msubsup><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mrow><mo rspace="0.167em">∇</mo><mi>f</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>𝒛</mi><mi>i</mi><mrow><mo rspace="0em">′</mo><mphantom></mphantom><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow></msubsup><mo>,</mo><msubsup><mi>𝝃</mi><mi>i</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msubsup><mo stretchy="false">)</mo></mrow></mrow></mrow><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow></mrow></mrow></mrow><mo maxsize="1.600em" minsize="1.600em" stretchy="true">‖</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\Big\|\overline{\bm{w}}^{(t)}-\overline{\bm{w}}^{\prime(t)}-\frac{\gamma_{t}}{m}\sum_{i=1}^{m}\big(\nabla f(\bm{z}_{i}^{(t)};\bm{\xi}_{i}^{(t)})-\nabla f(\bm{z}_{i}^{\prime(t)};\bm{\xi}_{i}^{(t)})\big)\Big\|</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A3.Ex31"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex31.m1" class="ltx_Math" alttext="\displaystyle\leq\Big\|\overline{\bm{w}}^{(t)}-\overline{\bm{w}}^{\prime(t)}-\frac{\gamma_{t}}{m}\sum_{i=1}^{m}\big(\nabla f(\overline{\bm{w}}^{(t)};\bm{\xi}_{i}^{(t)})-\nabla f(\overline{\bm{w}}^{\prime(t)};\bm{\xi}_{i}^{(t)})\big)\Big\|" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≤</mo><mrow><mo maxsize="1.600em" minsize="1.600em" stretchy="true">‖</mo><mrow><msup><mover accent="true"><mi>𝒘</mi><mo stretchy="true">¯</mo></mover><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo>−</mo><msup><mover accent="true"><mi>𝒘</mi><mo stretchy="true">¯</mo></mover><mrow><mo rspace="0em">′</mo><mphantom></mphantom><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow></msup><mo>−</mo><mrow><mstyle displaystyle="true"><mfrac><msub><mi>γ</mi><mi>t</mi></msub><mi>m</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>m</mi></munderover></mstyle><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mrow><mrow><mrow><mo rspace="0.167em">∇</mo><mi>f</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mover accent="true"><mi>𝒘</mi><mo stretchy="true">¯</mo></mover><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo>,</mo><msubsup><mi>𝝃</mi><mi>i</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msubsup><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mrow><mo rspace="0.167em">∇</mo><mi>f</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mover accent="true"><mi>𝒘</mi><mo stretchy="true">¯</mo></mover><mrow><mo rspace="0em">′</mo><mphantom></mphantom><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow></msup><mo>,</mo><msubsup><mi>𝝃</mi><mi>i</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msubsup><mo stretchy="false">)</mo></mrow></mrow></mrow><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow></mrow></mrow></mrow><mo maxsize="1.600em" minsize="1.600em" stretchy="true">‖</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\leq\Big\|\overline{\bm{w}}^{(t)}-\overline{\bm{w}}^{\prime(t)}-\frac{\gamma_{t}}{m}\sum_{i=1}^{m}\big(\nabla f(\overline{\bm{w}}^{(t)};\bm{\xi}_{i}^{(t)})-\nabla f(\overline{\bm{w}}^{\prime(t)};\bm{\xi}_{i}^{(t)})\big)\Big\|</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A3.Ex32"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex32.m1" class="ltx_Math" alttext="\displaystyle\quad+\Big\|\frac{\gamma_{t}}{m}\sum_{i=1}^{m}\big(\nabla f(\overline{\bm{w}}^{(t)};\bm{\xi}_{i}^{(t)})-\nabla f(\bm{z}_{i}^{(t)};\bm{\xi}_{i}^{(t)})\big)\Big\|" display="inline" intent=":literal"><semantics><mrow><mo>+</mo><mrow><mo maxsize="1.600em" minsize="1.600em" stretchy="true">‖</mo><mrow><mstyle displaystyle="true"><mfrac><msub><mi>γ</mi><mi>t</mi></msub><mi>m</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>m</mi></munderover></mstyle><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mrow><mrow><mrow><mo rspace="0.167em">∇</mo><mi>f</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mover accent="true"><mi>𝒘</mi><mo stretchy="true">¯</mo></mover><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo>,</mo><msubsup><mi>𝝃</mi><mi>i</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msubsup><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mrow><mo rspace="0.167em">∇</mo><mi>f</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>𝒛</mi><mi>i</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msubsup><mo>,</mo><msubsup><mi>𝝃</mi><mi>i</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msubsup><mo stretchy="false">)</mo></mrow></mrow></mrow><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow></mrow></mrow><mo maxsize="1.600em" minsize="1.600em" stretchy="true">‖</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\quad+\Big\|\frac{\gamma_{t}}{m}\sum_{i=1}^{m}\big(\nabla f(\overline{\bm{w}}^{(t)};\bm{\xi}_{i}^{(t)})-\nabla f(\bm{z}_{i}^{(t)};\bm{\xi}_{i}^{(t)})\big)\Big\|</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A3.Ex33"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex33.m1" class="ltx_Math" alttext="\displaystyle\quad+\Big\|\frac{\gamma_{t}}{m}\sum_{i=1}^{m}\big(\nabla f(\overline{\bm{w}}^{\prime(t)};\bm{\xi}_{i}^{(t)})-\nabla f(\bm{z}_{i}^{\prime(t)};\bm{\xi}_{i}^{(t)})\big)\Big\|" display="inline" intent=":literal"><semantics><mrow><mo>+</mo><mrow><mo maxsize="1.600em" minsize="1.600em" stretchy="true">‖</mo><mrow><mstyle displaystyle="true"><mfrac><msub><mi>γ</mi><mi>t</mi></msub><mi>m</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>m</mi></munderover></mstyle><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mrow><mrow><mrow><mo rspace="0.167em">∇</mo><mi>f</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mover accent="true"><mi>𝒘</mi><mo stretchy="true">¯</mo></mover><mrow><mo rspace="0em">′</mo><mphantom></mphantom><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow></msup><mo>,</mo><msubsup><mi>𝝃</mi><mi>i</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msubsup><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mrow><mo rspace="0.167em">∇</mo><mi>f</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>𝒛</mi><mi>i</mi><mrow><mo rspace="0em">′</mo><mphantom></mphantom><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow></msubsup><mo>,</mo><msubsup><mi>𝝃</mi><mi>i</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msubsup><mo stretchy="false">)</mo></mrow></mrow></mrow><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow></mrow></mrow><mo maxsize="1.600em" minsize="1.600em" stretchy="true">‖</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\quad+\Big\|\frac{\gamma_{t}}{m}\sum_{i=1}^{m}\big(\nabla f(\overline{\bm{w}}^{\prime(t)};\bm{\xi}_{i}^{(t)})-\nabla f(\bm{z}_{i}^{\prime(t)};\bm{\xi}_{i}^{(t)})\big)\Big\|</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A3.E54"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.E54.m1" class="ltx_Math" alttext="\displaystyle\leq\Delta_{t}+\frac{L\gamma_{t}}{m}\sum_{i=1}^{m}\|\overline{\bm{w}}^{(t)}-\bm{z}_{i}^{(t)}\|+\frac{L\gamma_{t}}{m}\sum_{i=1}^{m}\|\overline{\bm{w}}^{\prime(t)}-\bm{z}_{i}^{\prime(t)}\|." display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>≤</mo><mrow><msub><mi mathvariant="normal">Δ</mi><mi>t</mi></msub><mo>+</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mi>L</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>γ</mi><mi>t</mi></msub></mrow><mi>m</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>m</mi></munderover></mstyle><mrow><mo stretchy="false">‖</mo><mrow><msup><mover accent="true"><mi>𝒘</mi><mo stretchy="true">¯</mo></mover><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo>−</mo><msubsup><mi>𝒛</mi><mi>i</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msubsup></mrow><mo stretchy="false">‖</mo></mrow></mrow></mrow><mo>+</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mi>L</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>γ</mi><mi>t</mi></msub></mrow><mi>m</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>m</mi></munderover></mstyle><mrow><mo stretchy="false">‖</mo><mrow><msup><mover accent="true"><mi>𝒘</mi><mo stretchy="true">¯</mo></mover><mrow><mo rspace="0em">′</mo><mphantom></mphantom><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow></msup><mo>−</mo><msubsup><mi>𝒛</mi><mi>i</mi><mrow><mo rspace="0em">′</mo><mphantom></mphantom><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow></msubsup></mrow><mo stretchy="false">‖</mo></mrow></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\leq\Delta_{t}+\frac{L\gamma_{t}}{m}\sum_{i=1}^{m}\|\overline{\bm{w}}^{(t)}-\bm{z}_{i}^{(t)}\|+\frac{L\gamma_{t}}{m}\sum_{i=1}^{m}\|\overline{\bm{w}}^{\prime(t)}-\bm{z}_{i}^{\prime(t)}\|.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(54)</span></td></tr></tbody>
</table>
</div>
<div id="A3.SS1.SSS0.Px1.p2" class="ltx_para">
<p id="A3.SS1.SSS0.Px1.p2.1" class="ltx_p">Applying Lemma <a href="#Thmtheorem9" title="Lemma 9 (Consistency of Push-Sum). ‣ 3.3 Algorithm: Stochastic Gradient Push (SGP) ‣ 3 Preliminaries ‣ Stability and Generalization of Push-Sum Based Decentralized Optimization over Directed Graphs" class="ltx_ref"><span class="ltx_text ltx_ref_tag">9</span></a>,</p>
<table id="A3.EGx9" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A3.E55"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.E55.m1" class="ltx_Math" alttext="\displaystyle\Delta_{t+1}\leq\Delta_{t}+\frac{2CL\gamma_{t}}{\delta}\Big(\lambda^{t}C_{w_{0}}+G\sum_{s=0}^{t-1}\lambda^{t-s}\gamma_{s}\Big)." display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi mathvariant="normal">Δ</mi><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow></msub><mo>≤</mo><mrow><msub><mi mathvariant="normal">Δ</mi><mi>t</mi></msub><mo>+</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><mi>L</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>γ</mi><mi>t</mi></msub></mrow><mi>δ</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="1.600em" minsize="1.600em">(</mo><mrow><mrow><msup><mi>λ</mi><mi>t</mi></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>C</mi><msub><mi>w</mi><mn>0</mn></msub></msub></mrow><mo>+</mo><mrow><mi>G</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>s</mi><mo>=</mo><mn>0</mn></mrow><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow></munderover></mstyle><mrow><msup><mi>λ</mi><mrow><mi>t</mi><mo>−</mo><mi>s</mi></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>γ</mi><mi>s</mi></msub></mrow></mrow></mrow></mrow><mo maxsize="1.600em" minsize="1.600em">)</mo></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\Delta_{t+1}\leq\Delta_{t}+\frac{2CL\gamma_{t}}{\delta}\Big(\lambda^{t}C_{w_{0}}+G\sum_{s=0}^{t-1}\lambda^{t-s}\gamma_{s}\Big).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(55)</span></td></tr></tbody>
</table>
</div>
</section>
<section id="A3.SS1.SSS0.Px2" class="ltx_paragraph">
<h4 class="ltx_title ltx_title_paragraph">Case 2: Different Sample.</h4>

<div id="A3.SS1.SSS0.Px2.p1" class="ltx_para">
<p id="A3.SS1.SSS0.Px2.p1.1" class="ltx_p">Without loss of generality, assume node <math id="A3.SS1.SSS0.Px2.p1.m1" class="ltx_Math" alttext="1" display="inline" intent=":literal"><semantics><mn>1</mn><annotation encoding="application/x-tex">1</annotation></semantics></math> uses the replaced sample.
Proceeding as above and using <math id="A3.SS1.SSS0.Px2.p1.m2" class="ltx_Math" alttext="\|\nabla f(\cdot)\|\leq G" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">‖</mo><mrow><mrow><mo rspace="0.167em">∇</mo><mi>f</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">‖</mo></mrow><mo>≤</mo><mi>G</mi></mrow><annotation encoding="application/x-tex">\|\nabla f(\cdot)\|\leq G</annotation></semantics></math>,</p>
<table id="A3.EGx10" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A3.E56"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.E56.m1" class="ltx_Math" alttext="\displaystyle\Delta_{t+1}" display="inline" intent=":literal"><semantics><msub><mi mathvariant="normal">Δ</mi><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow></msub><annotation encoding="application/x-tex">\displaystyle\Delta_{t+1}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.E56.m2" class="ltx_Math" alttext="\displaystyle\leq\Delta_{t}+\frac{L\gamma_{t}}{m}\sum_{i=2}^{m}\|\overline{\bm{w}}^{(t)}-\bm{z}_{i}^{(t)}\|+\frac{L\gamma_{t}}{m}\sum_{i=2}^{m}\|\overline{\bm{w}}^{\prime(t)}-\bm{z}_{i}^{\prime(t)}\|+\frac{2G\gamma_{t}}{m}." display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>≤</mo><mrow><msub><mi mathvariant="normal">Δ</mi><mi>t</mi></msub><mo>+</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mi>L</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>γ</mi><mi>t</mi></msub></mrow><mi>m</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>2</mn></mrow><mi>m</mi></munderover></mstyle><mrow><mo stretchy="false">‖</mo><mrow><msup><mover accent="true"><mi>𝒘</mi><mo stretchy="true">¯</mo></mover><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo>−</mo><msubsup><mi>𝒛</mi><mi>i</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msubsup></mrow><mo stretchy="false">‖</mo></mrow></mrow></mrow><mo>+</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mi>L</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>γ</mi><mi>t</mi></msub></mrow><mi>m</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>2</mn></mrow><mi>m</mi></munderover></mstyle><mrow><mo stretchy="false">‖</mo><mrow><msup><mover accent="true"><mi>𝒘</mi><mo stretchy="true">¯</mo></mover><mrow><mo rspace="0em">′</mo><mphantom></mphantom><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow></msup><mo>−</mo><msubsup><mi>𝒛</mi><mi>i</mi><mrow><mo rspace="0em">′</mo><mphantom></mphantom><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow></msubsup></mrow><mo stretchy="false">‖</mo></mrow></mrow></mrow><mo>+</mo><mstyle displaystyle="true"><mfrac><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>G</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>γ</mi><mi>t</mi></msub></mrow><mi>m</mi></mfrac></mstyle></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\leq\Delta_{t}+\frac{L\gamma_{t}}{m}\sum_{i=2}^{m}\|\overline{\bm{w}}^{(t)}-\bm{z}_{i}^{(t)}\|+\frac{L\gamma_{t}}{m}\sum_{i=2}^{m}\|\overline{\bm{w}}^{\prime(t)}-\bm{z}_{i}^{\prime(t)}\|+\frac{2G\gamma_{t}}{m}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(56)</span></td></tr></tbody>
</table>
<p id="A3.SS1.SSS0.Px2.p1.2" class="ltx_p">Since <math id="A3.SS1.SSS0.Px2.p1.m3" class="ltx_math_unparsed" alttext="\frac{1}{m}\sum_{i=2}^{m}\|\cdot\|\leq\frac{1}{m}\sum_{i=1}^{m}\|\cdot\|" display="inline" intent=":literal"><semantics><mrow><mfrac><mn>1</mn><mi>m</mi></mfrac><mo rspace="0em">∑</mo><msub><mrow></mrow><mrow><mi>i</mi><mo>=</mo><mn>2</mn></mrow></msub><msup><mrow></mrow><mi>m</mi></msup><mo lspace="0em" rspace="0em">∥</mo><mo lspace="0em" rspace="0em">⋅</mo><mo lspace="0em" rspace="0.0835em">∥</mo><mo lspace="0.0835em">≤</mo><mfrac><mn>1</mn><mi>m</mi></mfrac><mo rspace="0em">∑</mo><msub><mrow></mrow><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow></msub><msup><mrow></mrow><mi>m</mi></msup><mo lspace="0em" rspace="0em">∥</mo><mo lspace="0em" rspace="0em">⋅</mo><mo lspace="0em">∥</mo></mrow><annotation encoding="application/x-tex">\frac{1}{m}\sum_{i=2}^{m}\|\cdot\|\leq\frac{1}{m}\sum_{i=1}^{m}\|\cdot\|</annotation></semantics></math>, applying the same lemma gives</p>
<table id="A3.EGx11" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A3.E57"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.E57.m1" class="ltx_Math" alttext="\displaystyle\Delta_{t+1}\leq\Delta_{t}+\frac{2CL\gamma_{t}}{\delta}\Big(\lambda^{t}C_{w_{0}}+G\sum_{s=0}^{t-1}\lambda^{t-s}\gamma_{s}\Big)+\frac{2G\gamma_{t}}{m}." display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi mathvariant="normal">Δ</mi><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow></msub><mo>≤</mo><mrow><msub><mi mathvariant="normal">Δ</mi><mi>t</mi></msub><mo>+</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><mi>L</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>γ</mi><mi>t</mi></msub></mrow><mi>δ</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="1.600em" minsize="1.600em">(</mo><mrow><mrow><msup><mi>λ</mi><mi>t</mi></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>C</mi><msub><mi>w</mi><mn>0</mn></msub></msub></mrow><mo>+</mo><mrow><mi>G</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>s</mi><mo>=</mo><mn>0</mn></mrow><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow></munderover></mstyle><mrow><msup><mi>λ</mi><mrow><mi>t</mi><mo>−</mo><mi>s</mi></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>γ</mi><mi>s</mi></msub></mrow></mrow></mrow></mrow><mo maxsize="1.600em" minsize="1.600em">)</mo></mrow></mrow><mo>+</mo><mstyle displaystyle="true"><mfrac><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>G</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>γ</mi><mi>t</mi></msub></mrow><mi>m</mi></mfrac></mstyle></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\Delta_{t+1}\leq\Delta_{t}+\frac{2CL\gamma_{t}}{\delta}\Big(\lambda^{t}C_{w_{0}}+G\sum_{s=0}^{t-1}\lambda^{t-s}\gamma_{s}\Big)+\frac{2G\gamma_{t}}{m}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(57)</span></td></tr></tbody>
</table>
</div>
</section>
<section id="A3.SS1.SSS0.Px3" class="ltx_paragraph">
<h4 class="ltx_title ltx_title_paragraph">Expectation recursion.</h4>

<div id="A3.SS1.SSS0.Px3.p1" class="ltx_para">
<p id="A3.SS1.SSS0.Px3.p1.1" class="ltx_p">Taking expectation and using the two cases,</p>
<table id="A3.EGx12" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A3.E58"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.E58.m1" class="ltx_Math" alttext="\displaystyle\mathbb{E}[\Delta_{t+1}]\leq\mathbb{E}[\Delta_{t}]+\frac{2CL\gamma_{t}}{\delta}\Big(\lambda^{t}C_{w_{0}}+G\sum_{s=0}^{t-1}\lambda^{t-s}\gamma_{s}\Big)+\frac{2G\gamma_{t}}{mn}." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><msub><mi mathvariant="normal">Δ</mi><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow></msub><mo stretchy="false">]</mo></mrow></mrow><mo>≤</mo><mrow><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><msub><mi mathvariant="normal">Δ</mi><mi>t</mi></msub><mo stretchy="false">]</mo></mrow></mrow><mo>+</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><mi>L</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>γ</mi><mi>t</mi></msub></mrow><mi>δ</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="1.600em" minsize="1.600em">(</mo><mrow><mrow><msup><mi>λ</mi><mi>t</mi></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>C</mi><msub><mi>w</mi><mn>0</mn></msub></msub></mrow><mo>+</mo><mrow><mi>G</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>s</mi><mo>=</mo><mn>0</mn></mrow><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow></munderover></mstyle><mrow><msup><mi>λ</mi><mrow><mi>t</mi><mo>−</mo><mi>s</mi></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>γ</mi><mi>s</mi></msub></mrow></mrow></mrow></mrow><mo maxsize="1.600em" minsize="1.600em">)</mo></mrow></mrow><mo>+</mo><mstyle displaystyle="true"><mfrac><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>G</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>γ</mi><mi>t</mi></msub></mrow><mrow><mi>m</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow></mfrac></mstyle></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\mathbb{E}[\Delta_{t+1}]\leq\mathbb{E}[\Delta_{t}]+\frac{2CL\gamma_{t}}{\delta}\Big(\lambda^{t}C_{w_{0}}+G\sum_{s=0}^{t-1}\lambda^{t-s}\gamma_{s}\Big)+\frac{2G\gamma_{t}}{mn}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(58)</span></td></tr></tbody>
</table>
</div>
<div id="A3.SS1.SSS0.Px3.p2" class="ltx_para">
<p id="A3.SS1.SSS0.Px3.p2.1" class="ltx_p">Summing from <math id="A3.SS1.SSS0.Px3.p2.m1" class="ltx_Math" alttext="t=0" display="inline" intent=":literal"><semantics><mrow><mi>t</mi><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">t=0</annotation></semantics></math> to <math id="A3.SS1.SSS0.Px3.p2.m2" class="ltx_Math" alttext="T-1" display="inline" intent=":literal"><semantics><mrow><mi>T</mi><mo>−</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">T-1</annotation></semantics></math> yields</p>
<table id="A3.EGx13" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A3.E59"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.E59.m1" class="ltx_Math" alttext="\displaystyle\mathbb{E}[\Delta_{T}]\leq\frac{2CLC_{w_{0}}}{\delta}\sum_{t=0}^{T-1}\gamma_{t}\lambda^{t}+\frac{2CLG}{\delta}\sum_{t=0}^{T-1}\gamma_{t}\sum_{s=0}^{t-1}\lambda^{t-s}\gamma_{s}+\frac{2G}{mn}\sum_{t=0}^{T-1}\gamma_{t}." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><msub><mi mathvariant="normal">Δ</mi><mi>T</mi></msub><mo stretchy="false">]</mo></mrow></mrow><mo>≤</mo><mrow><mrow><mstyle displaystyle="true"><mfrac><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><mi>L</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>C</mi><msub><mi>w</mi><mn>0</mn></msub></msub></mrow><mi>δ</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>t</mi><mo>=</mo><mn>0</mn></mrow><mrow><mi>T</mi><mo>−</mo><mn>1</mn></mrow></munderover></mstyle><mrow><msub><mi>γ</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><msup><mi>λ</mi><mi>t</mi></msup></mrow></mrow></mrow><mo>+</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><mi>L</mi><mo lspace="0em" rspace="0em">​</mo><mi>G</mi></mrow><mi>δ</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>t</mi><mo>=</mo><mn>0</mn></mrow><mrow><mi>T</mi><mo>−</mo><mn>1</mn></mrow></munderover></mstyle><mrow><msub><mi>γ</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>s</mi><mo>=</mo><mn>0</mn></mrow><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow></munderover></mstyle><mrow><msup><mi>λ</mi><mrow><mi>t</mi><mo>−</mo><mi>s</mi></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>γ</mi><mi>s</mi></msub></mrow></mrow></mrow></mrow></mrow><mo>+</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>G</mi></mrow><mrow><mi>m</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>t</mi><mo>=</mo><mn>0</mn></mrow><mrow><mi>T</mi><mo>−</mo><mn>1</mn></mrow></munderover></mstyle><msub><mi>γ</mi><mi>t</mi></msub></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\mathbb{E}[\Delta_{T}]\leq\frac{2CLC_{w_{0}}}{\delta}\sum_{t=0}^{T-1}\gamma_{t}\lambda^{t}+\frac{2CLG}{\delta}\sum_{t=0}^{T-1}\gamma_{t}\sum_{s=0}^{t-1}\lambda^{t-s}\gamma_{s}+\frac{2G}{mn}\sum_{t=0}^{T-1}\gamma_{t}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(59)</span></td></tr></tbody>
</table>
</div>
<div id="A3.SS1.SSS0.Px3.p3" class="ltx_para">
<p id="A3.SS1.SSS0.Px3.p3.1" class="ltx_p">Assume the stepsizes are nonincreasing.
Then for <math id="A3.SS1.SSS0.Px3.p3.m1" class="ltx_Math" alttext="s\leq t-1" display="inline" intent=":literal"><semantics><mrow><mi>s</mi><mo>≤</mo><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow></mrow><annotation encoding="application/x-tex">s\leq t-1</annotation></semantics></math>, <math id="A3.SS1.SSS0.Px3.p3.m2" class="ltx_Math" alttext="\gamma_{s}\geq\gamma_{t}" display="inline" intent=":literal"><semantics><mrow><msub><mi>γ</mi><mi>s</mi></msub><mo>≥</mo><msub><mi>γ</mi><mi>t</mi></msub></mrow><annotation encoding="application/x-tex">\gamma_{s}\geq\gamma_{t}</annotation></semantics></math>, and hence</p>
<table id="A3.EGx14" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A3.E60"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.E60.m1" class="ltx_Math" alttext="\displaystyle\sum_{t=0}^{T-1}\gamma_{t}\sum_{s=0}^{t-1}\lambda^{t-s}\gamma_{s}" display="inline" intent=":literal"><semantics><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>t</mi><mo>=</mo><mn>0</mn></mrow><mrow><mi>T</mi><mo>−</mo><mn>1</mn></mrow></munderover></mstyle><mrow><msub><mi>γ</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>s</mi><mo>=</mo><mn>0</mn></mrow><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow></munderover></mstyle><mrow><msup><mi>λ</mi><mrow><mi>t</mi><mo>−</mo><mi>s</mi></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>γ</mi><mi>s</mi></msub></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\sum_{t=0}^{T-1}\gamma_{t}\sum_{s=0}^{t-1}\lambda^{t-s}\gamma_{s}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.E60.m2" class="ltx_Math" alttext="\displaystyle\leq\sum_{t=0}^{T-1}\gamma_{t}^{2}\sum_{s=0}^{t-1}\lambda^{t-s}=\sum_{t=0}^{T-1}\gamma_{t}^{2}\sum_{k=1}^{t}\lambda^{k}\leq\frac{1}{1-\lambda}\sum_{t=0}^{T-1}\gamma_{t}^{2}." display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>≤</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>t</mi><mo>=</mo><mn>0</mn></mrow><mrow><mi>T</mi><mo>−</mo><mn>1</mn></mrow></munderover></mstyle><mrow><msubsup><mi>γ</mi><mi>t</mi><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>s</mi><mo>=</mo><mn>0</mn></mrow><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow></munderover></mstyle><msup><mi>λ</mi><mrow><mi>t</mi><mo>−</mo><mi>s</mi></mrow></msup></mrow></mrow></mrow><mo>=</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>t</mi><mo>=</mo><mn>0</mn></mrow><mrow><mi>T</mi><mo>−</mo><mn>1</mn></mrow></munderover></mstyle><mrow><msubsup><mi>γ</mi><mi>t</mi><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>k</mi><mo>=</mo><mn>1</mn></mrow><mi>t</mi></munderover></mstyle><msup><mi>λ</mi><mi>k</mi></msup></mrow></mrow></mrow><mo>≤</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mrow><mn>1</mn><mo>−</mo><mi>λ</mi></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>t</mi><mo>=</mo><mn>0</mn></mrow><mrow><mi>T</mi><mo>−</mo><mn>1</mn></mrow></munderover></mstyle><msubsup><mi>γ</mi><mi>t</mi><mn>2</mn></msubsup></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\leq\sum_{t=0}^{T-1}\gamma_{t}^{2}\sum_{s=0}^{t-1}\lambda^{t-s}=\sum_{t=0}^{T-1}\gamma_{t}^{2}\sum_{k=1}^{t}\lambda^{k}\leq\frac{1}{1-\lambda}\sum_{t=0}^{T-1}\gamma_{t}^{2}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(60)</span></td></tr></tbody>
</table>
</div>
<div id="A3.SS1.SSS0.Px3.p4" class="ltx_para">
<p id="A3.SS1.SSS0.Px3.p4.1" class="ltx_p">Therefore,</p>
<table id="A3.EGx15" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A3.E61"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.E61.m1" class="ltx_Math" alttext="\displaystyle\mathbb{E}[\Delta_{T}]\leq\frac{2CLC_{w_{0}}}{\delta}\sum_{t=0}^{T-1}\gamma_{t}\lambda^{t}+\frac{2CLG}{\delta(1-\lambda)}\sum_{t=0}^{T-1}\gamma_{t}^{2}+\frac{2G}{mn}\sum_{t=0}^{T-1}\gamma_{t}." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><msub><mi mathvariant="normal">Δ</mi><mi>T</mi></msub><mo stretchy="false">]</mo></mrow></mrow><mo>≤</mo><mrow><mrow><mstyle displaystyle="true"><mfrac><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><mi>L</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>C</mi><msub><mi>w</mi><mn>0</mn></msub></msub></mrow><mi>δ</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>t</mi><mo>=</mo><mn>0</mn></mrow><mrow><mi>T</mi><mo>−</mo><mn>1</mn></mrow></munderover></mstyle><mrow><msub><mi>γ</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><msup><mi>λ</mi><mi>t</mi></msup></mrow></mrow></mrow><mo>+</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><mi>L</mi><mo lspace="0em" rspace="0em">​</mo><mi>G</mi></mrow><mrow><mi>δ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>λ</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>t</mi><mo>=</mo><mn>0</mn></mrow><mrow><mi>T</mi><mo>−</mo><mn>1</mn></mrow></munderover></mstyle><msubsup><mi>γ</mi><mi>t</mi><mn>2</mn></msubsup></mrow></mrow><mo>+</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>G</mi></mrow><mrow><mi>m</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>t</mi><mo>=</mo><mn>0</mn></mrow><mrow><mi>T</mi><mo>−</mo><mn>1</mn></mrow></munderover></mstyle><msub><mi>γ</mi><mi>t</mi></msub></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\mathbb{E}[\Delta_{T}]\leq\frac{2CLC_{w_{0}}}{\delta}\sum_{t=0}^{T-1}\gamma_{t}\lambda^{t}+\frac{2CLG}{\delta(1-\lambda)}\sum_{t=0}^{T-1}\gamma_{t}^{2}+\frac{2G}{mn}\sum_{t=0}^{T-1}\gamma_{t}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(61)</span></td></tr></tbody>
</table>
</div>
<div id="A3.SS1.SSS0.Px3.p5" class="ltx_para">
<p id="A3.SS1.SSS0.Px3.p5.1" class="ltx_p">Finally, by <math id="A3.SS1.SSS0.Px3.p5.m1" class="ltx_Math" alttext="G" display="inline" intent=":literal"><semantics><mi>G</mi><annotation encoding="application/x-tex">G</annotation></semantics></math>-Lipschitzness,</p>
<table id="A3.EGx16" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A3.Ex34"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.Ex34.m1" class="ltx_Math" alttext="\displaystyle\epsilon_{\mathrm{stab}}" display="inline" intent=":literal"><semantics><msub><mi>ϵ</mi><mi>stab</mi></msub><annotation encoding="application/x-tex">\displaystyle\epsilon_{\mathrm{stab}}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex34.m2" class="ltx_Math" alttext="\displaystyle=\mathbb{E}|f(\overline{\bm{w}}_{T};\bm{z})-f(\overline{\bm{w}}^{\prime}_{T};\bm{z})|\leq G\,\mathbb{E}[\Delta_{T}]" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mi>𝔼</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">|</mo><mrow><mrow><mi>f</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi>𝒘</mi><mo stretchy="true">¯</mo></mover><mi>T</mi></msub><mo>,</mo><mi>𝒛</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mi>f</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msubsup><mover accent="true"><mi>𝒘</mi><mo stretchy="true">¯</mo></mover><mi>T</mi><mo>′</mo></msubsup><mo>,</mo><mi>𝒛</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">|</mo></mrow></mrow><mo>≤</mo><mrow><mi>G</mi><mo lspace="0.170em" rspace="0em">​</mo><mi>𝔼</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><msub><mi mathvariant="normal">Δ</mi><mi>T</mi></msub><mo stretchy="false">]</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\mathbb{E}|f(\overline{\bm{w}}_{T};\bm{z})-f(\overline{\bm{w}}^{\prime}_{T};\bm{z})|\leq G\,\mathbb{E}[\Delta_{T}]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A3.E62"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.E62.m1" class="ltx_Math" alttext="\displaystyle\leq\frac{2CGLC_{w_{0}}}{\delta}\sum_{t=0}^{T-1}\gamma_{t}\lambda^{t}+\frac{2CG^{2}L}{\delta(1-\lambda)}\sum_{t=0}^{T-1}\gamma_{t}^{2}+\frac{2G^{2}}{mn}\sum_{t=0}^{T-1}\gamma_{t}." display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>≤</mo><mrow><mrow><mstyle displaystyle="true"><mfrac><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><mi>G</mi><mo lspace="0em" rspace="0em">​</mo><mi>L</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>C</mi><msub><mi>w</mi><mn>0</mn></msub></msub></mrow><mi>δ</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>t</mi><mo>=</mo><mn>0</mn></mrow><mrow><mi>T</mi><mo>−</mo><mn>1</mn></mrow></munderover></mstyle><mrow><msub><mi>γ</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><msup><mi>λ</mi><mi>t</mi></msup></mrow></mrow></mrow><mo>+</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>G</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mi>L</mi></mrow><mrow><mi>δ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>λ</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>t</mi><mo>=</mo><mn>0</mn></mrow><mrow><mi>T</mi><mo>−</mo><mn>1</mn></mrow></munderover></mstyle><msubsup><mi>γ</mi><mi>t</mi><mn>2</mn></msubsup></mrow></mrow><mo>+</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msup><mi>G</mi><mn>2</mn></msup></mrow><mrow><mi>m</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>t</mi><mo>=</mo><mn>0</mn></mrow><mrow><mi>T</mi><mo>−</mo><mn>1</mn></mrow></munderover></mstyle><msub><mi>γ</mi><mi>t</mi></msub></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\leq\frac{2CGLC_{w_{0}}}{\delta}\sum_{t=0}^{T-1}\gamma_{t}\lambda^{t}+\frac{2CG^{2}L}{\delta(1-\lambda)}\sum_{t=0}^{T-1}\gamma_{t}^{2}+\frac{2G^{2}}{mn}\sum_{t=0}^{T-1}\gamma_{t}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(62)</span></td></tr></tbody>
</table>
</div>
<div id="A3.SS1.SSS0.Px3.p6" class="ltx_para">
<p id="A3.SS1.SSS0.Px3.p6.1" class="ltx_p">This completes the proof of Theorem <a href="#Thmtheorem22" title="Theorem 22 (Uniform Stability). ‣ 4.2 Results on Convex Case ‣ 4 Theoretical Analysis ‣ Stability and Generalization of Push-Sum Based Decentralized Optimization over Directed Graphs" class="ltx_ref"><span class="ltx_text ltx_ref_tag">22</span></a>.
∎</p>
</div>
</section>
</section>
<section id="A3.SS2" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">C.2 </span>Proof of Corollary <a href="#Thmtheorem24" title="Corollary 24 (Uniform Stability on Common Learning Rate). ‣ 4.2 Results on Convex Case ‣ 4 Theoretical Analysis ‣ Stability and Generalization of Push-Sum Based Decentralized Optimization over Directed Graphs" class="ltx_ref"><span class="ltx_text ltx_ref_tag">24</span></a></h3>

<div id="A3.SS2.2" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
</div>
<section id="A3.SS2.SSS0.Px1" class="ltx_paragraph">
<h4 class="ltx_title ltx_title_paragraph">Case 1: Constant Learning Rate.</h4>

<div id="A3.SS2.SSS0.Px1.p1" class="ltx_para">
<p id="A3.SS2.SSS0.Px1.p1.1" class="ltx_p">For constant learning rates <math id="A3.SS2.SSS0.Px1.p1.m1" class="ltx_Math" alttext="\gamma_{t}=\gamma\leq 2/L" display="inline" intent=":literal"><semantics><mrow><msub><mi>γ</mi><mi>t</mi></msub><mo>=</mo><mi>γ</mi><mo>≤</mo><mrow><mn>2</mn><mo>/</mo><mi>L</mi></mrow></mrow><annotation encoding="application/x-tex">\gamma_{t}=\gamma\leq 2/L</annotation></semantics></math>, by Theorem <a href="#Thmtheorem22" title="Theorem 22 (Uniform Stability). ‣ 4.2 Results on Convex Case ‣ 4 Theoretical Analysis ‣ Stability and Generalization of Push-Sum Based Decentralized Optimization over Directed Graphs" class="ltx_ref"><span class="ltx_text ltx_ref_tag">22</span></a>, we have</p>
<table id="A3.EGx17" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A3.Ex35"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.Ex35.m1" class="ltx_Math" alttext="\displaystyle\epsilon_{\mathrm{stab}}" display="inline" intent=":literal"><semantics><msub><mi>ϵ</mi><mi>stab</mi></msub><annotation encoding="application/x-tex">\displaystyle\epsilon_{\mathrm{stab}}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex35.m2" class="ltx_Math" alttext="\displaystyle\leq\frac{2CGLC_{w_{0}}}{\delta}\sum_{t=0}^{T-1}\gamma{\lambda}^{t}+\frac{2CG^{2}L}{\delta(1-{\lambda})}\sum_{t=0}^{T-1}{\gamma}^{2}+\frac{2G^{2}}{mn}\sum_{t=0}^{T-1}\gamma" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≤</mo><mrow><mrow><mstyle displaystyle="true"><mfrac><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><mi>G</mi><mo lspace="0em" rspace="0em">​</mo><mi>L</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>C</mi><msub><mi>w</mi><mn>0</mn></msub></msub></mrow><mi>δ</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>t</mi><mo>=</mo><mn>0</mn></mrow><mrow><mi>T</mi><mo>−</mo><mn>1</mn></mrow></munderover></mstyle><mrow><mi>γ</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>λ</mi><mi>t</mi></msup></mrow></mrow></mrow><mo>+</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>G</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mi>L</mi></mrow><mrow><mi>δ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>λ</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>t</mi><mo>=</mo><mn>0</mn></mrow><mrow><mi>T</mi><mo>−</mo><mn>1</mn></mrow></munderover></mstyle><msup><mi>γ</mi><mn>2</mn></msup></mrow></mrow><mo>+</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msup><mi>G</mi><mn>2</mn></msup></mrow><mrow><mi>m</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>t</mi><mo>=</mo><mn>0</mn></mrow><mrow><mi>T</mi><mo>−</mo><mn>1</mn></mrow></munderover></mstyle><mi>γ</mi></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\leq\frac{2CGLC_{w_{0}}}{\delta}\sum_{t=0}^{T-1}\gamma{\lambda}^{t}+\frac{2CG^{2}L}{\delta(1-{\lambda})}\sum_{t=0}^{T-1}{\gamma}^{2}+\frac{2G^{2}}{mn}\sum_{t=0}^{T-1}\gamma</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A3.E63"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.E63.m1" class="ltx_Math" alttext="\displaystyle\overset{(a)}{\leq}\frac{2CGL\gamma C_{w_{0}}}{\delta(1-{\lambda})}+\left(\frac{2CG^{2}L{\gamma}^{2}}{\delta(1-{\lambda})}+\frac{2G^{2}{\gamma}}{mn}\right)T." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mover accent="true"><mo>≤</mo><mrow><mo maxsize="0.700em" minsize="0.700em">(</mo><mi mathsize="0.700em">a</mi><mo maxsize="0.700em" minsize="0.700em">)</mo></mrow></mover><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><mi>G</mi><mo lspace="0em" rspace="0em">​</mo><mi>L</mi><mo lspace="0em" rspace="0em">​</mo><mi>γ</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>C</mi><msub><mi>w</mi><mn>0</mn></msub></msub></mrow><mrow><mi>δ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>λ</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle></mrow><mo>+</mo><mrow><mrow><mo>(</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>G</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mi>L</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>γ</mi><mn>2</mn></msup></mrow><mrow><mi>δ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>λ</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle><mo>+</mo><mstyle displaystyle="true"><mfrac><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msup><mi>G</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mi>γ</mi></mrow><mrow><mi>m</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow></mfrac></mstyle></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>T</mi></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\overset{(a)}{\leq}\frac{2CGL\gamma C_{w_{0}}}{\delta(1-{\lambda})}+\left(\frac{2CG^{2}L{\gamma}^{2}}{\delta(1-{\lambda})}+\frac{2G^{2}{\gamma}}{mn}\right)T.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(63)</span></td></tr></tbody>
</table>
</div>
</section>
<section id="A3.SS2.SSS0.Px2" class="ltx_paragraph">
<h4 class="ltx_title ltx_title_paragraph">Case 2: Decreasing Learning Rate.</h4>

<div id="A3.SS2.SSS0.Px2.p1" class="ltx_para">
<p id="A3.SS2.SSS0.Px2.p1.1" class="ltx_p">For diminishing learning rates <math id="A3.SS2.SSS0.Px2.p1.m1" class="ltx_Math" alttext="\gamma_{t}=\frac{v}{t+1}" display="inline" intent=":literal"><semantics><mrow><msub><mi>γ</mi><mi>t</mi></msub><mo>=</mo><mfrac><mi>v</mi><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow></mfrac></mrow><annotation encoding="application/x-tex">\gamma_{t}=\frac{v}{t+1}</annotation></semantics></math> with <math id="A3.SS2.SSS0.Px2.p1.m2" class="ltx_Math" alttext="v\leq 2/L" display="inline" intent=":literal"><semantics><mrow><mi>v</mi><mo>≤</mo><mrow><mn>2</mn><mo>/</mo><mi>L</mi></mrow></mrow><annotation encoding="application/x-tex">v\leq 2/L</annotation></semantics></math>, Theorem <a href="#Thmtheorem22" title="Theorem 22 (Uniform Stability). ‣ 4.2 Results on Convex Case ‣ 4 Theoretical Analysis ‣ Stability and Generalization of Push-Sum Based Decentralized Optimization over Directed Graphs" class="ltx_ref"><span class="ltx_text ltx_ref_tag">22</span></a> yields</p>
<table id="A3.EGx18" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A3.Ex36"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.Ex36.m1" class="ltx_Math" alttext="\displaystyle\epsilon_{\mathrm{stab}}" display="inline" intent=":literal"><semantics><msub><mi>ϵ</mi><mi>stab</mi></msub><annotation encoding="application/x-tex">\displaystyle\epsilon_{\mathrm{stab}}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex36.m2" class="ltx_Math" alttext="\displaystyle\leq\frac{2CGLC_{w_{0}}}{\delta}\sum_{t=0}^{T-1}\frac{v{\lambda}^{t}}{t+1}+\frac{2CG^{2}L}{\delta(1-{\lambda})}\sum_{t=0}^{T-1}\Big(\frac{v}{t+1}\Big)^{2}+\frac{2G^{2}}{mn}\sum_{t=0}^{T-1}\frac{v}{t+1}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≤</mo><mrow><mrow><mstyle displaystyle="true"><mfrac><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><mi>G</mi><mo lspace="0em" rspace="0em">​</mo><mi>L</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>C</mi><msub><mi>w</mi><mn>0</mn></msub></msub></mrow><mi>δ</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>t</mi><mo>=</mo><mn>0</mn></mrow><mrow><mi>T</mi><mo>−</mo><mn>1</mn></mrow></munderover></mstyle><mstyle displaystyle="true"><mfrac><mrow><mi>v</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>λ</mi><mi>t</mi></msup></mrow><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow></mfrac></mstyle></mrow></mrow><mo>+</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>G</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mi>L</mi></mrow><mrow><mi>δ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>λ</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>t</mi><mo>=</mo><mn>0</mn></mrow><mrow><mi>T</mi><mo>−</mo><mn>1</mn></mrow></munderover></mstyle><msup><mrow><mo maxsize="1.600em" minsize="1.600em">(</mo><mstyle displaystyle="true"><mfrac><mi>v</mi><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow></mfrac></mstyle><mo maxsize="1.600em" minsize="1.600em">)</mo></mrow><mn>2</mn></msup></mrow></mrow><mo>+</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msup><mi>G</mi><mn>2</mn></msup></mrow><mrow><mi>m</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>t</mi><mo>=</mo><mn>0</mn></mrow><mrow><mi>T</mi><mo>−</mo><mn>1</mn></mrow></munderover></mstyle><mstyle displaystyle="true"><mfrac><mi>v</mi><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow></mfrac></mstyle></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\leq\frac{2CGLC_{w_{0}}}{\delta}\sum_{t=0}^{T-1}\frac{v{\lambda}^{t}}{t+1}+\frac{2CG^{2}L}{\delta(1-{\lambda})}\sum_{t=0}^{T-1}\Big(\frac{v}{t+1}\Big)^{2}+\frac{2G^{2}}{mn}\sum_{t=0}^{T-1}\frac{v}{t+1}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A3.Ex37"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex37.m1" class="ltx_Math" alttext="\displaystyle\overset{(a)(b)(c)}{\leq}\frac{2vCGLC_{w_{0}}}{\delta(1-{\lambda})}+\frac{4CG^{2}Lv^{2}}{\delta(1-{\lambda})}+\frac{2G^{2}v}{mn}(1+\ln{T})" display="inline" intent=":literal"><semantics><mrow><mrow><mover accent="true"><mo>≤</mo><mrow><mrow><mo maxsize="0.700em" minsize="0.700em">(</mo><mi mathsize="0.700em">a</mi><mo maxsize="0.700em" minsize="0.700em">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="0.700em" minsize="0.700em">(</mo><mi mathsize="0.700em">b</mi><mo maxsize="0.700em" minsize="0.700em">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="0.700em" minsize="0.700em">(</mo><mi mathsize="0.700em">c</mi><mo maxsize="0.700em" minsize="0.700em">)</mo></mrow></mrow></mover><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>v</mi><mo lspace="0em" rspace="0em">​</mo><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><mi>G</mi><mo lspace="0em" rspace="0em">​</mo><mi>L</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>C</mi><msub><mi>w</mi><mn>0</mn></msub></msub></mrow><mrow><mi>δ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>λ</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle></mrow><mo>+</mo><mstyle displaystyle="true"><mfrac><mrow><mn>4</mn><mo lspace="0em" rspace="0em">​</mo><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>G</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mi>L</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>v</mi><mn>2</mn></msup></mrow><mrow><mi>δ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>λ</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle><mo>+</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msup><mi>G</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mi>v</mi></mrow><mrow><mi>m</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><mrow><mi>ln</mi><mo lspace="0.167em">⁡</mo><mi>T</mi></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\overset{(a)(b)(c)}{\leq}\frac{2vCGLC_{w_{0}}}{\delta(1-{\lambda})}+\frac{4CG^{2}Lv^{2}}{\delta(1-{\lambda})}+\frac{2G^{2}v}{mn}(1+\ln{T})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A3.E64"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.E64.m1" class="ltx_Math" alttext="\displaystyle=\frac{2G^{2}v}{mn}\ln{T}+\frac{2vCGLC_{w_{0}}+4CG^{2}Lv^{2}}{\delta(1-{\lambda})}+\frac{2G^{2}v}{mn}," display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><mstyle displaystyle="true"><mfrac><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msup><mi>G</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mi>v</mi></mrow><mrow><mi>m</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow></mfrac></mstyle><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>ln</mi><mo lspace="0.167em">⁡</mo><mi>T</mi></mrow></mrow><mo>+</mo><mstyle displaystyle="true"><mfrac><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>v</mi><mo lspace="0em" rspace="0em">​</mo><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><mi>G</mi><mo lspace="0em" rspace="0em">​</mo><mi>L</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>C</mi><msub><mi>w</mi><mn>0</mn></msub></msub></mrow><mo>+</mo><mrow><mn>4</mn><mo lspace="0em" rspace="0em">​</mo><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>G</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mi>L</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>v</mi><mn>2</mn></msup></mrow></mrow><mrow><mi>δ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>λ</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle><mo>+</mo><mstyle displaystyle="true"><mfrac><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msup><mi>G</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mi>v</mi></mrow><mrow><mi>m</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow></mfrac></mstyle></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle=\frac{2G^{2}v}{mn}\ln{T}+\frac{2vCGLC_{w_{0}}+4CG^{2}Lv^{2}}{\delta(1-{\lambda})}+\frac{2G^{2}v}{mn},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(64)</span></td></tr></tbody>
</table>
<p id="A3.SS2.SSS0.Px2.p1.2" class="ltx_p">where we have used:</p>
<table id="A3.Ex38" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A3.Ex38.m1" class="ltx_Math" alttext="\sum_{t=0}^{T-1}\lambda^{t}\leq\frac{1}{1-\lambda},\qquad\sum_{t=0}^{T-1}\frac{\lambda^{t}}{t+1}\leq\sum_{t=0}^{T-1}\lambda^{t}\leq\frac{1}{1-\lambda}," display="block" intent=":literal"><semantics><mrow><mrow><mrow><mrow><munderover><mo movablelimits="false">∑</mo><mrow><mi>t</mi><mo>=</mo><mn>0</mn></mrow><mrow><mi>T</mi><mo>−</mo><mn>1</mn></mrow></munderover><msup><mi>λ</mi><mi>t</mi></msup></mrow><mo>≤</mo><mfrac><mn>1</mn><mrow><mn>1</mn><mo>−</mo><mi>λ</mi></mrow></mfrac></mrow><mo rspace="2.000em">,</mo><mrow><mrow><munderover><mo movablelimits="false">∑</mo><mrow><mi>t</mi><mo>=</mo><mn>0</mn></mrow><mrow><mi>T</mi><mo>−</mo><mn>1</mn></mrow></munderover><mfrac><msup><mi>λ</mi><mi>t</mi></msup><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow></mfrac></mrow><mo rspace="0.111em">≤</mo><mrow><munderover><mo movablelimits="false">∑</mo><mrow><mi>t</mi><mo>=</mo><mn>0</mn></mrow><mrow><mi>T</mi><mo>−</mo><mn>1</mn></mrow></munderover><msup><mi>λ</mi><mi>t</mi></msup></mrow><mo>≤</mo><mfrac><mn>1</mn><mrow><mn>1</mn><mo>−</mo><mi>λ</mi></mrow></mfrac></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\sum_{t=0}^{T-1}\lambda^{t}\leq\frac{1}{1-\lambda},\qquad\sum_{t=0}^{T-1}\frac{\lambda^{t}}{t+1}\leq\sum_{t=0}^{T-1}\lambda^{t}\leq\frac{1}{1-\lambda},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<table id="A3.Ex40" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A3.Ex40.m1" class="ltx_Math" alttext="\sum_{t=0}^{T-1}\frac{1}{t+1}=1+\sum_{t=1}^{T-1}\frac{1}{t+1}\leq 1+\int_{1}^{T}\frac{1}{x}\,dx=1+\ln{T}," display="block" intent=":literal"><semantics><mrow><mrow><mrow><munderover><mo movablelimits="false">∑</mo><mrow><mi>t</mi><mo>=</mo><mn>0</mn></mrow><mrow><mi>T</mi><mo>−</mo><mn>1</mn></mrow></munderover><mfrac><mn>1</mn><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow></mfrac></mrow><mo>=</mo><mrow><mn>1</mn><mo rspace="0.055em">+</mo><mrow><munderover><mo movablelimits="false">∑</mo><mrow><mi>t</mi><mo>=</mo><mn>1</mn></mrow><mrow><mi>T</mi><mo>−</mo><mn>1</mn></mrow></munderover><mfrac><mn>1</mn><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow></mfrac></mrow></mrow><mo>≤</mo><mrow><mn>1</mn><mo rspace="0.055em">+</mo><mrow><msubsup><mo>∫</mo><mn>1</mn><mi>T</mi></msubsup><mrow><mfrac><mn>1</mn><mi>x</mi></mfrac><mo lspace="0.170em" rspace="0em">​</mo><mrow><mo rspace="0em">𝑑</mo><mi>x</mi></mrow></mrow></mrow></mrow><mo>=</mo><mrow><mn>1</mn><mo>+</mo><mrow><mi>ln</mi><mo lspace="0.167em">⁡</mo><mi>T</mi></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\sum_{t=0}^{T-1}\frac{1}{t+1}=1+\sum_{t=1}^{T-1}\frac{1}{t+1}\leq 1+\int_{1}^{T}\frac{1}{x}\,dx=1+\ln{T},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<table id="A3.Ex42" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A3.Ex42.m1" class="ltx_Math" alttext="\sum_{t=0}^{T-1}\frac{1}{(t+1)^{2}}\leq 1+\int_{1}^{T}\frac{1}{x^{2}}\,dx=2-\frac{1}{T}\leq 2." display="block" intent=":literal"><semantics><mrow><mrow><mrow><munderover><mo movablelimits="false">∑</mo><mrow><mi>t</mi><mo>=</mo><mn>0</mn></mrow><mrow><mi>T</mi><mo>−</mo><mn>1</mn></mrow></munderover><mfrac><mn>1</mn><msup><mrow><mo stretchy="false">(</mo><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mfrac></mrow><mo>≤</mo><mrow><mn>1</mn><mo rspace="0.055em">+</mo><mrow><msubsup><mo>∫</mo><mn>1</mn><mi>T</mi></msubsup><mrow><mfrac><mn>1</mn><msup><mi>x</mi><mn>2</mn></msup></mfrac><mo lspace="0.170em" rspace="0em">​</mo><mrow><mo rspace="0em">𝑑</mo><mi>x</mi></mrow></mrow></mrow></mrow><mo>=</mo><mrow><mn>2</mn><mo>−</mo><mfrac><mn>1</mn><mi>T</mi></mfrac></mrow><mo>≤</mo><mn>2</mn></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\sum_{t=0}^{T-1}\frac{1}{(t+1)^{2}}\leq 1+\int_{1}^{T}\frac{1}{x^{2}}\,dx=2-\frac{1}{T}\leq 2.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="A3.SS2.SSS0.Px2.p2" class="ltx_para">
<p id="A3.SS2.SSS0.Px2.p2.1" class="ltx_p">This completes the proof of Corollary <a href="#Thmtheorem24" title="Corollary 24 (Uniform Stability on Common Learning Rate). ‣ 4.2 Results on Convex Case ‣ 4 Theoretical Analysis ‣ Stability and Generalization of Push-Sum Based Decentralized Optimization over Directed Graphs" class="ltx_ref"><span class="ltx_text ltx_ref_tag">24</span></a>.
∎</p>
</div>
</section>
</section>
<section id="A3.SS3" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">C.3 </span>Proof of Theorem <a href="#Thmtheorem26" title="Theorem 26 (Optimization Error). ‣ 4.2 Results on Convex Case ‣ 4 Theoretical Analysis ‣ Stability and Generalization of Push-Sum Based Decentralized Optimization over Directed Graphs" class="ltx_ref"><span class="ltx_text ltx_ref_tag">26</span></a></h3>

<div id="A3.SS3.2" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="A3.SS3.p1" class="ltx_para">
<p id="A3.SS3.p1.1" class="ltx_p"><span id="A3.SS3.p1.1.1" class="ltx_text">Using the convexity of <math id="A3.SS3.p1.m1" class="ltx_Math" alttext="F_{\bm{S}}" display="inline" intent=":literal"><semantics><msub><mi>F</mi><mi>𝑺</mi></msub><annotation encoding="application/x-tex">F_{\bm{S}}</annotation></semantics></math>, we have</span></p>
<table id="A3.Ex44" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A3.Ex44.m1" class="ltx_Math" alttext="F_{\bm{S}}(\overline{\bm{w}}^{(t)})-F_{\bm{S}}(\bm{w}_{\bm{S}}^{*})\leq\left\langle\nabla F_{\bm{S}}(\overline{\bm{w}}^{(t)}),\,\overline{\bm{w}}^{(t)}-\bm{w}_{\bm{S}}^{*}\right\rangle." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mrow><msub><mi>F</mi><mi>𝑺</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mover accent="true"><mi>𝒘</mi><mo stretchy="true">¯</mo></mover><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msub><mi>F</mi><mi>𝑺</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>𝒘</mi><mi>𝑺</mi><mo>∗</mo></msubsup><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>≤</mo><mrow><mo>⟨</mo><mrow><mrow><mrow><mo rspace="0.167em">∇</mo><msub><mi>F</mi><mi>𝑺</mi></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mover accent="true"><mi>𝒘</mi><mo stretchy="true">¯</mo></mover><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow></mrow><mo rspace="0.337em">,</mo><mrow><msup><mover accent="true"><mi>𝒘</mi><mo stretchy="true">¯</mo></mover><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo>−</mo><msubsup><mi>𝒘</mi><mi>𝑺</mi><mo>∗</mo></msubsup></mrow></mrow><mo>⟩</mo></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">F_{\bm{S}}(\overline{\bm{w}}^{(t)})-F_{\bm{S}}(\bm{w}_{\bm{S}}^{*})\leq\left\langle\nabla F_{\bm{S}}(\overline{\bm{w}}^{(t)}),\,\overline{\bm{w}}^{(t)}-\bm{w}_{\bm{S}}^{*}\right\rangle.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(d)</span></td></tr></tbody>
</table>
</div>
<div id="A3.SS3.p2" class="ltx_para">
<p id="A3.SS3.p2.1" class="ltx_p"><span id="A3.SS3.p2.1.1" class="ltx_text">We derive</span></p>
<table id="A3.EGx19" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A3.Ex45"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.Ex45.m1" class="ltx_Math" alttext="\displaystyle\mathbb{E}\big\|\overline{\bm{w}}^{(t+1)}-\bm{w}_{\bm{S}}^{*}\big\|^{2}" display="inline" intent=":literal"><semantics><mrow><mi>𝔼</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo maxsize="1.200em" minsize="1.200em" stretchy="true">‖</mo><mrow><msup><mover accent="true"><mi>𝒘</mi><mo stretchy="true">¯</mo></mover><mrow><mo stretchy="false">(</mo><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></msup><mo>−</mo><msubsup><mi>𝒘</mi><mi>𝑺</mi><mo>∗</mo></msubsup></mrow><mo maxsize="1.200em" minsize="1.200em" stretchy="true">‖</mo></mrow><mn>2</mn></msup></mrow><annotation encoding="application/x-tex">\displaystyle\mathbb{E}\big\|\overline{\bm{w}}^{(t+1)}-\bm{w}_{\bm{S}}^{*}\big\|^{2}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex45.m2" class="ltx_Math" alttext="\displaystyle=\mathbb{E}\Big\|\overline{\bm{w}}^{(t)}-\frac{\gamma_{t}}{m}\sum_{i=1}^{m}\nabla f(\bm{z}_{i}^{(t)};\bm{\xi}_{i}^{(t)})-\bm{w}_{\bm{S}}^{*}\Big\|^{2}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mi>𝔼</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo maxsize="1.600em" minsize="1.600em" stretchy="true">‖</mo><mrow><msup><mover accent="true"><mi>𝒘</mi><mo stretchy="true">¯</mo></mover><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo>−</mo><mrow><mstyle displaystyle="true"><mfrac><msub><mi>γ</mi><mi>t</mi></msub><mi>m</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>m</mi></munderover></mstyle><mrow><mrow><mo lspace="0.167em" rspace="0.167em">∇</mo><mi>f</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>𝒛</mi><mi>i</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msubsup><mo>,</mo><msubsup><mi>𝝃</mi><mi>i</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msubsup><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo>−</mo><msubsup><mi>𝒘</mi><mi>𝑺</mi><mo>∗</mo></msubsup></mrow><mo maxsize="1.600em" minsize="1.600em" stretchy="true">‖</mo></mrow><mn>2</mn></msup></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\mathbb{E}\Big\|\overline{\bm{w}}^{(t)}-\frac{\gamma_{t}}{m}\sum_{i=1}^{m}\nabla f(\bm{z}_{i}^{(t)};\bm{\xi}_{i}^{(t)})-\bm{w}_{\bm{S}}^{*}\Big\|^{2}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A3.Ex46"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
