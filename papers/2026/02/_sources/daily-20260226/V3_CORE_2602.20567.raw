<tr id="S1.T1.2.4" class="ltx_tr">
<td id="S1.T1.2.4.1" class="ltx_td ltx_align_center" style="padding:0.9pt 2.0pt;"><math id="S1.T1.m31" class="ltx_Math" alttext="\gamma_{t}=\mathcal{O}(\frac{1}{t})" display="inline" intent=":literal"><semantics><mrow><msub><mi mathsize="0.900em">γ</mi><mi mathsize="0.900em">t</mi></msub><mo mathsize="0.900em">=</mo><mrow><mi class="ltx_font_mathcaligraphic" mathsize="0.900em">𝒪</mi><mo>⁡</mo><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><mfrac><mn mathsize="0.900em">1</mn><mi mathsize="0.900em">t</mi></mfrac><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\gamma_{t}=\mathcal{O}(\frac{1}{t})</annotation></semantics></math></td>
<td id="S1.T1.2.4.2" class="ltx_td ltx_align_center" style="padding:0.9pt 2.0pt;"><math id="S1.T1.m32" class="ltx_Math" alttext="\mathcal{O}\!\left((\frac{1}{mn}+C_{\lambda})\ln T\right)" display="inline" intent=":literal"><semantics><mrow><mpadded style="width:0.674em;" width="0.674em"><mi class="ltx_font_mathcaligraphic" mathsize="0.900em">𝒪</mi></mpadded><mo>⁡</mo><mrow><mo>(</mo><mrow><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><mrow><mfrac><mn mathsize="0.900em">1</mn><mrow><mi mathsize="0.900em">m</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">n</mi></mrow></mfrac><mo mathsize="0.900em">+</mo><msub><mi mathsize="0.900em">C</mi><mi mathsize="0.900em">λ</mi></msub></mrow><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi mathsize="0.900em">ln</mi><mo lspace="0.167em">⁡</mo><mi mathsize="0.900em">T</mi></mrow></mrow><mo>)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathcal{O}\!\left((\frac{1}{mn}+C_{\lambda})\ln T\right)</annotation></semantics></math></td>
<td id="S1.T1.2.4.3" class="ltx_td ltx_align_center" style="padding:0.9pt 2.0pt;"><math id="S1.T1.m33" class="ltx_Math" alttext="\mathcal{O}\!\left((1+C_{\lambda})\frac{1}{\ln T}\right)" display="inline" intent=":literal"><semantics><mrow><mpadded style="width:0.674em;" width="0.674em"><mi class="ltx_font_mathcaligraphic" mathsize="0.900em">𝒪</mi></mpadded><mo>⁡</mo><mrow><mo>(</mo><mrow><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><mrow><mn mathsize="0.900em">1</mn><mo mathsize="0.900em">+</mo><msub><mi mathsize="0.900em">C</mi><mi mathsize="0.900em">λ</mi></msub></mrow><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mfrac><mn mathsize="0.900em">1</mn><mrow><mi mathsize="0.900em">ln</mi><mo lspace="0.167em">⁡</mo><mi mathsize="0.900em">T</mi></mrow></mfrac></mrow><mo>)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathcal{O}\!\left((1+C_{\lambda})\frac{1}{\ln T}\right)</annotation></semantics></math></td></tr>
