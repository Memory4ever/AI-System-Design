<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex54.m1" class="ltx_math_unparsed" alttext="\displaystyle\quad+\sum_{i=1}^{m}\frac{4r\gamma_{t}}{m}\mathbb{E}\big\|\nabla f(\overline{\bm{w}}^{(t)};\bm{\xi}_{i}^{(t)})-\nabla f(\bm{z}_{i}^{(t)};\bm{\xi}_{i}^{(t)})\big\|+\gamma_{t}^{2}G^{2}" display="inline" intent=":literal"><semantics><mrow><mo>+</mo><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>m</mi></munderover></mstyle><mstyle displaystyle="true"><mfrac><mrow><mn>4</mn><mo lspace="0em" rspace="0em">​</mo><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>γ</mi><mi>t</mi></msub></mrow><mi>m</mi></mfrac></mstyle><mi>𝔼</mi><mo lspace="0em" mathsize="1.200em" rspace="0.167em">∥</mo><mo rspace="0.167em">∇</mo><mi>f</mi><mrow><mo stretchy="false">(</mo><msup><mover accent="true"><mi>𝒘</mi><mo stretchy="true">¯</mo></mover><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo>;</mo><msubsup><mi>𝝃</mi><mi>i</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msubsup><mo stretchy="false">)</mo></mrow><mo>−</mo><mo rspace="0.167em">∇</mo><mi>f</mi><mrow><mo stretchy="false">(</mo><msubsup><mi>𝒛</mi><mi>i</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msubsup><mo>;</mo><msubsup><mi>𝝃</mi><mi>i</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msubsup><mo stretchy="false">)</mo></mrow><mo lspace="0em" mathsize="1.200em" rspace="0em">∥</mo><mo lspace="0em">+</mo><msubsup><mi>γ</mi><mi>t</mi><mn>2</mn></msubsup><msup><mi>G</mi><mn>2</mn></msup></mrow><annotation encoding="application/x-tex">\displaystyle\quad+\sum_{i=1}^{m}\frac{4r\gamma_{t}}{m}\mathbb{E}\big\|\nabla f(\overline{\bm{w}}^{(t)};\bm{\xi}_{i}^{(t)})-\nabla f(\bm{z}_{i}^{(t)};\bm{\xi}_{i}^{(t)})\big\|+\gamma_{t}^{2}G^{2}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
