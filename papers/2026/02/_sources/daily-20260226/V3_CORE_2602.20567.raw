<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex117.m1" class="ltx_math_unparsed" alttext="\displaystyle\leq T^{Lv(1-\frac{1}{mn})}\Bigg[\frac{2CLvC_{w_{0}}}{\delta}\sum_{t=t_{0}}^{T-1}(t+1)^{-Lv(1-\frac{1}{mn})-1}+\frac{2Gv}{mn}\sum_{t=t_{0}}^{T-1}(t+1)^{-Lv(1-\frac{1}{mn})-1}" display="inline" intent=":literal"><semantics><mrow><mo mathsize="0.900em">≤</mo><msup><mi mathsize="0.900em">T</mi><mrow><mi mathsize="0.900em">L</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">v</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><mrow><mn mathsize="0.900em">1</mn><mo mathsize="0.900em">−</mo><mfrac><mn mathsize="0.900em">1</mn><mrow><mi mathsize="0.900em">m</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">n</mi></mrow></mfrac></mrow><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow></mrow></msup><mrow><mo maxsize="2.600em" minsize="2.600em">[</mo><mstyle displaystyle="true"><mfrac><mrow><mn mathsize="0.900em">2</mn><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">C</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">L</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">v</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi mathsize="0.900em">C</mi><msub><mi mathsize="0.900em">w</mi><mn mathsize="0.900em">0</mn></msub></msub></mrow><mi mathsize="0.900em">δ</mi></mfrac></mstyle><mstyle displaystyle="true"><munderover><mo maxsize="0.900em" minsize="0.900em" movablelimits="false" stretchy="true">∑</mo><mrow><mi mathsize="0.900em">t</mi><mo mathsize="0.900em">=</mo><msub><mi mathsize="0.900em">t</mi><mn mathsize="0.900em">0</mn></msub></mrow><mrow><mi mathsize="0.900em">T</mi><mo mathsize="0.900em">−</mo><mn mathsize="0.900em">1</mn></mrow></munderover></mstyle><msup><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><mi mathsize="0.900em">t</mi><mo mathsize="0.900em">+</mo><mn mathsize="0.900em">1</mn><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow><mrow><mrow><mo mathsize="0.900em">−</mo><mrow><mi mathsize="0.900em">L</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">v</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><mrow><mn mathsize="0.900em">1</mn><mo mathsize="0.900em">−</mo><mfrac><mn mathsize="0.900em">1</mn><mrow><mi mathsize="0.900em">m</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">n</mi></mrow></mfrac></mrow><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow></mrow></mrow><mo mathsize="0.900em">−</mo><mn mathsize="0.900em">1</mn></mrow></msup><mo mathsize="0.900em">+</mo><mstyle displaystyle="true"><mfrac><mrow><mn mathsize="0.900em">2</mn><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">G</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">v</mi></mrow><mrow><mi mathsize="0.900em">m</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">n</mi></mrow></mfrac></mstyle><mstyle displaystyle="true"><munderover><mo maxsize="0.900em" minsize="0.900em" movablelimits="false" stretchy="true">∑</mo><mrow><mi mathsize="0.900em">t</mi><mo mathsize="0.900em">=</mo><msub><mi mathsize="0.900em">t</mi><mn mathsize="0.900em">0</mn></msub></mrow><mrow><mi mathsize="0.900em">T</mi><mo mathsize="0.900em">−</mo><mn mathsize="0.900em">1</mn></mrow></munderover></mstyle><msup><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><mi mathsize="0.900em">t</mi><mo mathsize="0.900em">+</mo><mn mathsize="0.900em">1</mn><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow><mrow><mrow><mo mathsize="0.900em">−</mo><mrow><mi mathsize="0.900em">L</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">v</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><mrow><mn mathsize="0.900em">1</mn><mo mathsize="0.900em">−</mo><mfrac><mn mathsize="0.900em">1</mn><mrow><mi mathsize="0.900em">m</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">n</mi></mrow></mfrac></mrow><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow></mrow></mrow><mo mathsize="0.900em">−</mo><mn mathsize="0.900em">1</mn></mrow></msup></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\leq T^{Lv(1-\frac{1}{mn})}\Bigg[\frac{2CLvC_{w_{0}}}{\delta}\sum_{t=t_{0}}^{T-1}(t+1)^{-Lv(1-\frac{1}{mn})-1}+\frac{2Gv}{mn}\sum_{t=t_{0}}^{T-1}(t+1)^{-Lv(1-\frac{1}{mn})-1}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A3.Ex118"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex118.m1" class="ltx_math_unparsed" alttext="\displaystyle\hskip 18.49988pt\hskip 18.49988pt\hskip 18.49988pt+\frac{2CGLv^{2}}{\delta(1-\lambda)}\sum_{t=t_{0}}^{T-1}(t+1)^{-Lv(1-\frac{1}{mn})-2}\Bigg]" display="inline" intent=":literal"><semantics><mrow><mo mathsize="0.900em">+</mo><mstyle displaystyle="true"><mfrac><mrow><mn mathsize="0.900em">2</mn><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">C</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">G</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">L</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi mathsize="0.900em">v</mi><mn mathsize="0.900em">2</mn></msup></mrow><mrow><mi mathsize="0.900em">δ</mi><mo>⁡</mo><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><mrow><mn mathsize="0.900em">1</mn><mo mathsize="0.900em">−</mo><mi mathsize="0.900em">λ</mi></mrow><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow></mrow></mfrac></mstyle><mstyle displaystyle="true"><munderover><mo maxsize="0.900em" minsize="0.900em" movablelimits="false" stretchy="true">∑</mo><mrow><mi mathsize="0.900em">t</mi><mo mathsize="0.900em">=</mo><msub><mi mathsize="0.900em">t</mi><mn mathsize="0.900em">0</mn></msub></mrow><mrow><mi mathsize="0.900em">T</mi><mo mathsize="0.900em">−</mo><mn mathsize="0.900em">1</mn></mrow></munderover></mstyle><msup><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><mi mathsize="0.900em">t</mi><mo mathsize="0.900em">+</mo><mn mathsize="0.900em">1</mn><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow><mrow><mrow><mo mathsize="0.900em">−</mo><mrow><mi mathsize="0.900em">L</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">v</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><mrow><mn mathsize="0.900em">1</mn><mo mathsize="0.900em">−</mo><mfrac><mn mathsize="0.900em">1</mn><mrow><mi mathsize="0.900em">m</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">n</mi></mrow></mfrac></mrow><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow></mrow></mrow><mo mathsize="0.900em">−</mo><mn mathsize="0.900em">2</mn></mrow></msup><mo maxsize="2.600em" minsize="2.600em">]</mo></mrow><annotation encoding="application/x-tex">\displaystyle\hskip 18.49988pt\hskip 18.49988pt\hskip 18.49988pt+\frac{2CGLv^{2}}{\delta(1-\lambda)}\sum_{t=t_{0}}^{T-1}(t+1)^{-Lv(1-\frac{1}{mn})-2}\Bigg]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A3.Ex119"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex119.m1" class="ltx_Math" alttext="\displaystyle\overset{(i)(j)}{\leq}T^{Lv(1-\frac{1}{mn})}\Bigg[\left(\frac{4CLvC_{w_{0}}}{\delta}+\frac{4Gv}{mn}\right)\frac{t_{0}^{-Lv(1-\frac{1}{mn})}}{Lv}+\frac{2CGLv^{2}}{\delta(1-\lambda)}\cdot\frac{t_{0}^{-Lv(1-\frac{1}{mn})-1}}{Lv(1-\frac{1}{mn})+1}\Bigg]" display="inline" intent=":literal"><semantics><mrow><mover accent="true"><mo mathsize="0.900em">≤</mo><mrow><mrow><mo maxsize="0.630em" minsize="0.630em">(</mo><mi mathsize="0.630em">i</mi><mo maxsize="0.630em" minsize="0.630em">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="0.630em" minsize="0.630em">(</mo><mi mathsize="0.630em">j</mi><mo maxsize="0.630em" minsize="0.630em">)</mo></mrow></mrow></mover><mo lspace="0em" rspace="0em">​</mo><msup><mi mathsize="0.900em">T</mi><mrow><mi mathsize="0.900em">L</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">v</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><mrow><mn mathsize="0.900em">1</mn><mo mathsize="0.900em">−</mo><mfrac><mn mathsize="0.900em">1</mn><mrow><mi mathsize="0.900em">m</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">n</mi></mrow></mfrac></mrow><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="2.600em" minsize="2.600em">[</mo><mrow><mrow><mrow><mo>(</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mn mathsize="0.900em">4</mn><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">C</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">L</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">v</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi mathsize="0.900em">C</mi><msub><mi mathsize="0.900em">w</mi><mn mathsize="0.900em">0</mn></msub></msub></mrow><mi mathsize="0.900em">δ</mi></mfrac></mstyle><mo mathsize="0.900em">+</mo><mstyle displaystyle="true"><mfrac><mrow><mn mathsize="0.900em">4</mn><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">G</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">v</mi></mrow><mrow><mi mathsize="0.900em">m</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">n</mi></mrow></mfrac></mstyle></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><msubsup><mi mathsize="0.900em">t</mi><mn mathsize="0.900em">0</mn><mrow><mo mathsize="0.900em">−</mo><mrow><mi mathsize="0.900em">L</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">v</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><mrow><mn mathsize="0.900em">1</mn><mo mathsize="0.900em">−</mo><mfrac><mn mathsize="0.900em">1</mn><mrow><mi mathsize="0.900em">m</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">n</mi></mrow></mfrac></mrow><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow></mrow></mrow></msubsup><mrow><mi mathsize="0.900em">L</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">v</mi></mrow></mfrac></mstyle></mrow><mo mathsize="0.900em">+</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mn mathsize="0.900em">2</mn><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">C</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">G</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">L</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi mathsize="0.900em">v</mi><mn mathsize="0.900em">2</mn></msup></mrow><mrow><mi mathsize="0.900em">δ</mi><mo>⁡</mo><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><mrow><mn mathsize="0.900em">1</mn><mo mathsize="0.900em">−</mo><mi mathsize="0.900em">λ</mi></mrow><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow></mrow></mfrac></mstyle><mo lspace="0.222em" mathsize="0.900em" rspace="0.222em">⋅</mo><mstyle displaystyle="true"><mfrac><msubsup><mi mathsize="0.900em">t</mi><mn mathsize="0.900em">0</mn><mrow><mrow><mo mathsize="0.900em">−</mo><mrow><mi mathsize="0.900em">L</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">v</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><mrow><mn mathsize="0.900em">1</mn><mo mathsize="0.900em">−</mo><mfrac><mn mathsize="0.900em">1</mn><mrow><mi mathsize="0.900em">m</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">n</mi></mrow></mfrac></mrow><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow></mrow></mrow><mo mathsize="0.900em">−</mo><mn mathsize="0.900em">1</mn></mrow></msubsup><mrow><mrow><mi mathsize="0.900em">L</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">v</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><mrow><mn mathsize="0.900em">1</mn><mo mathsize="0.900em">−</mo><mfrac><mn mathsize="0.900em">1</mn><mrow><mi mathsize="0.900em">m</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">n</mi></mrow></mfrac></mrow><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow></mrow><mo mathsize="0.900em">+</mo><mn mathsize="0.900em">1</mn></mrow></mfrac></mstyle></mrow></mrow><mo maxsize="2.600em" minsize="2.600em">]</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\overset{(i)(j)}{\leq}T^{Lv(1-\frac{1}{mn})}\Bigg[\left(\frac{4CLvC_{w_{0}}}{\delta}+\frac{4Gv}{mn}\right)\frac{t_{0}^{-Lv(1-\frac{1}{mn})}}{Lv}+\frac{2CGLv^{2}}{\delta(1-\lambda)}\cdot\frac{t_{0}^{-Lv(1-\frac{1}{mn})-1}}{Lv(1-\frac{1}{mn})+1}\Bigg]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A3.E93"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.E93.m1" class="ltx_Math" alttext="\displaystyle\leq\left(\frac{4CC_{w_{0}}}{\delta}+\frac{4G}{mnL}\right)\left(\frac{T}{t_{0}}\right)^{Lv(1-\frac{1}{mn})}+\frac{2CGv}{\delta(1-\lambda)}\left(\frac{T}{t_{0}}\right)^{Lv(1-\frac{1}{mn})+1}\frac{1}{T}." display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo mathsize="0.900em">≤</mo><mrow><mrow><mrow><mo>(</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mn mathsize="0.900em">4</mn><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">C</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi mathsize="0.900em">C</mi><msub><mi mathsize="0.900em">w</mi><mn mathsize="0.900em">0</mn></msub></msub></mrow><mi mathsize="0.900em">δ</mi></mfrac></mstyle><mo mathsize="0.900em">+</mo><mstyle displaystyle="true"><mfrac><mrow><mn mathsize="0.900em">4</mn><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">G</mi></mrow><mrow><mi mathsize="0.900em">m</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">n</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">L</mi></mrow></mfrac></mstyle></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo>(</mo><mstyle displaystyle="true"><mfrac><mi mathsize="0.900em">T</mi><msub><mi mathsize="0.900em">t</mi><mn mathsize="0.900em">0</mn></msub></mfrac></mstyle><mo>)</mo></mrow><mrow><mi mathsize="0.900em">L</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">v</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><mrow><mn mathsize="0.900em">1</mn><mo mathsize="0.900em">−</mo><mfrac><mn mathsize="0.900em">1</mn><mrow><mi mathsize="0.900em">m</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">n</mi></mrow></mfrac></mrow><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow></mrow></msup></mrow><mo mathsize="0.900em">+</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mn mathsize="0.900em">2</mn><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">C</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">G</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">v</mi></mrow><mrow><mi mathsize="0.900em">δ</mi><mo>⁡</mo><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><mrow><mn mathsize="0.900em">1</mn><mo mathsize="0.900em">−</mo><mi mathsize="0.900em">λ</mi></mrow><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo>(</mo><mstyle displaystyle="true"><mfrac><mi mathsize="0.900em">T</mi><msub><mi mathsize="0.900em">t</mi><mn mathsize="0.900em">0</mn></msub></mfrac></mstyle><mo>)</mo></mrow><mrow><mrow><mi mathsize="0.900em">L</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">v</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><mrow><mn mathsize="0.900em">1</mn><mo mathsize="0.900em">−</mo><mfrac><mn mathsize="0.900em">1</mn><mrow><mi mathsize="0.900em">m</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">n</mi></mrow></mfrac></mrow><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow></mrow><mo mathsize="0.900em">+</mo><mn mathsize="0.900em">1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><mn mathsize="0.900em">1</mn><mi mathsize="0.900em">T</mi></mfrac></mstyle></mrow></mrow></mrow><mo lspace="0em" mathsize="0.900em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\leq\left(\frac{4CC_{w_{0}}}{\delta}+\frac{4G}{mnL}\right)\left(\frac{T}{t_{0}}\right)^{Lv(1-\frac{1}{mn})}+\frac{2CGv}{\delta(1-\lambda)}\left(\frac{T}{t_{0}}\right)^{Lv(1-\frac{1}{mn})+1}\frac{1}{T}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(93)</span></td></tr></tbody>
</table>
