<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex53.m1" class="ltx_Math" alttext="\displaystyle\overset{\text{Ass}\penalty\ \ref{ass:bounded}}{\leq}\mathbb{E}\big\|\overline{\bm{w}}^{(t)}-\bm{w}_{\bm{S}}^{*}\big\|^{2}-2\gamma_{t}\mathbb{E}\big[F_{\bm{S}}(\overline{\bm{w}}^{(t)})-F_{\bm{S}}(\bm{w}_{\bm{S}}^{*})\big]" display="inline" intent=":literal"><semantics><mrow><mrow><mover accent="true"><mo>≤</mo><mrow><mtext mathsize="0.700em">Ass</mtext><mo lspace="0.410em" rspace="0em">​</mo><mtext class="ltx_mathvariant_italic" mathsize="0.700em"><a href="#Thmtheorem19" title="Assumption 19. ‣ 4.1 Basic Assumptions ‣ 4 Theoretical Analysis ‣ Stability and Generalization of Push-Sum Based Decentralized Optimization over Directed Graphs" class="ltx_ref ltx_font_italic" style="font-size:70%;"><span class="ltx_text ltx_ref_tag">19</span></a></mtext></mrow></mover><mo lspace="0em" rspace="0em">​</mo><mi>𝔼</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo maxsize="1.200em" minsize="1.200em" stretchy="true">‖</mo><mrow><msup><mover accent="true"><mi>𝒘</mi><mo stretchy="true">¯</mo></mover><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo>−</mo><msubsup><mi>𝒘</mi><mi>𝑺</mi><mo>∗</mo></msubsup></mrow><mo maxsize="1.200em" minsize="1.200em" stretchy="true">‖</mo></mrow><mn>2</mn></msup></mrow><mo>−</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>γ</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi>𝔼</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="1.200em" minsize="1.200em">[</mo><mrow><mrow><msub><mi>F</mi><mi>𝑺</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mover accent="true"><mi>𝒘</mi><mo stretchy="true">¯</mo></mover><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msub><mi>F</mi><mi>𝑺</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>𝒘</mi><mi>𝑺</mi><mo>∗</mo></msubsup><mo stretchy="false">)</mo></mrow></mrow></mrow><mo maxsize="1.200em" minsize="1.200em">]</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\overset{\text{Ass}\penalty\ \ref{ass:bounded}}{\leq}\mathbb{E}\big\|\overline{\bm{w}}^{(t)}-\bm{w}_{\bm{S}}^{*}\big\|^{2}-2\gamma_{t}\mathbb{E}\big[F_{\bm{S}}(\overline{\bm{w}}^{(t)})-F_{\bm{S}}(\bm{w}_{\bm{S}}^{*})\big]</annotation></semantics></math></td>
