lse">(</mo><msubsup><mi>𝒘</mi><mi>𝑺</mi><mo>∗</mo></msubsup><mo stretchy="false">)</mo></mrow></mrow></mrow><mo maxsize="1.200em" minsize="1.200em">]</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\overset{\text{Ass}\penalty\ \ref{ass:smooth}}{\leq}\mathbb{E}\big\|\overline{\bm{w}}^{(t)}-\bm{w}_{\bm{S}}^{*}\big\|^{2}-2\gamma_{t}\mathbb{E}\big[F_{\bm{S}}(\overline{\bm{w}}^{(t)})-F_{\bm{S}}(\bm{w}_{\bm{S}}^{*})\big]</annotation></semantics></math></td>
