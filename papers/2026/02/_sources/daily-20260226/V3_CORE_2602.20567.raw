<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.E91.m1" class="ltx_Math" alttext="\displaystyle\leq\left(\frac{2CL\gamma C_{w_{0}}}{\delta(1-{\lambda})}+\frac{4CGL\gamma^{2}}{\delta(1-{\lambda})}+\frac{4G\gamma}{mn}\right)\left(1+L\gamma-\frac{L\gamma}{mn}\right)^{T}." display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo mathsize="0.900em">≤</mo><mrow><mrow><mo>(</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mn mathsize="0.900em">2</mn><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">C</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">L</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">γ</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi mathsize="0.900em">C</mi><msub><mi mathsize="0.900em">w</mi><mn mathsize="0.900em">0</mn></msub></msub></mrow><mrow><mi mathsize="0.900em">δ</mi><mo>⁡</mo><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><mrow><mn mathsize="0.900em">1</mn><mo mathsize="0.900em">−</mo><mi mathsize="0.900em">λ</mi></mrow><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow></mrow></mfrac></mstyle><mo mathsize="0.900em">+</mo><mstyle displaystyle="true"><mfrac><mrow><mn mathsize="0.900em">4</mn><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">C</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">G</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">L</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi mathsize="0.900em">γ</mi><mn mathsize="0.900em">2</mn></msup></mrow><mrow><mi mathsize="0.900em">δ</mi><mo>⁡</mo><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><mrow><mn mathsize="0.900em">1</mn><mo mathsize="0.900em">−</mo><mi mathsize="0.900em">λ</mi></mrow><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow></mrow></mfrac></mstyle><mo mathsize="0.900em">+</mo><mstyle displaystyle="true"><mfrac><mrow><mn mathsize="0.900em">4</mn><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">G</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">γ</mi></mrow><mrow><mi mathsize="0.900em">m</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">n</mi></mrow></mfrac></mstyle></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo>(</mo><mrow><mrow><mn mathsize="0.900em">1</mn><mo mathsize="0.900em">+</mo><mrow><mi mathsize="0.900em">L</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">γ</mi></mrow></mrow><mo mathsize="0.900em">−</mo><mstyle displaystyle="true"><mfrac><mrow><mi mathsize="0.900em">L</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">γ</mi></mrow><mrow><mi mathsize="0.900em">m</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">n</mi></mrow></mfrac></mstyle></mrow><mo>)</mo></mrow><mi mathsize="0.900em">T</mi></msup></mrow></mrow><mo lspace="0em" mathsize="0.900em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\leq\left(\frac{2CL\gamma C_{w_{0}}}{\delta(1-{\lambda})}+\frac{4CGL\gamma^{2}}{\delta(1-{\lambda})}+\frac{4G\gamma}{mn}\right)\left(1+L\gamma-\frac{L\gamma}{mn}\right)^{T}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(91)</span></td></tr></tbody>
</table>
<p id="A3.SS7.SSS0.Px1.p1.2" class="ltx_p"><span id="A3.SS7.SSS0.Px1.p1.2.1" class="ltx_text" style="font-size:90%;">When using bound (a), we rely on the fact that
<math id="A3.SS7.SSS0.Px1.p1.m2" class="ltx_Math" alttext="\frac{{\lambda}}{(1+L\gamma-\frac{L\gamma}{mn})}\leq 1." display="inline" intent=":literal"><semantics><mrow><mrow><mfrac><mi>λ</mi><mrow><mo stretchy="false">(</mo><mrow><mrow><mn>1</mn><mo>+</mo><mrow><mi>L</mi><mo lspace="0em" rspace="0em">​</mo><mi>γ</mi></mrow></mrow><mo>−</mo><mfrac><mrow><mi>L</mi><mo lspace="0em" rspace="0em">​</mo><mi>γ</mi></mrow><mrow><mi>m</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow></mfrac></mrow><mo stretchy="false">)</mo></mrow></mfrac><mo>≤</mo><mn>1</mn></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\frac{{\lambda}}{(1+L\gamma-\frac{L\gamma}{mn})}\leq 1.</annotation></semantics></math></span></p>
</div>
<div id="A3.SS7.SSS0.Px1.p2" class="ltx_para">
<p id="A3.SS7.SSS0.Px1.p2.1" class="ltx_p"><span id="A3.SS7.SSS0.Px1.p2.1.1" class="ltx_text" style="font-size:90%;">Thus, the uniform stability satisfies</span></p>
<table id="A3.EGx47" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A3.Ex112"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.Ex112.m1" class="ltx_Math" alttext="\displaystyle\epsilon_{\mathrm{stab}}" display="inline" intent=":literal"><semantics><msub><mi mathsize="0.900em">ϵ</mi><mi mathsize="0.900em">stab</mi></msub><annotation encoding="application/x-tex">\displaystyle\epsilon_{\mathrm{stab}}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex112.m2" class="ltx_Math" alttext="\displaystyle\leq\frac{t_{0}}{mn}+G\,\mathbb{E}[\Delta_{T}\mid\Delta_{t_{0}}=0]" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo mathsize="0.900em">≤</mo><mrow><mstyle displaystyle="true"><mfrac><msub><mi mathsize="0.900em">t</mi><mn mathsize="0.900em">0</mn></msub><mrow><mi mathsize="0.900em">m</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">n</mi></mrow></mfrac></mstyle><mo mathsize="0.900em">+</mo><mrow><mi mathsize="0.900em">G</mi><mo lspace="0.170em" rspace="0em">​</mo><mi mathsize="0.900em">𝔼</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="0.900em" minsize="0.900em">[</mo><mrow><msub><mi mathsize="0.900em" mathvariant="normal">Δ</mi><mi mathsize="0.900em">T</mi></msub><mo lspace="0em" mathsize="0.900em" rspace="0.167em">∣</mo><mrow><msub><mi mathsize="0.900em" mathvariant="normal">Δ</mi><msub><mi mathsize="0.900em">t</mi><mn mathsize="0.900em">0</mn></msub></msub><mo mathsize="0.900em">=</mo><mn mathsize="0.900em">0</mn></mrow></mrow><mo maxsize="0.900em" minsize="0.900em">]</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\leq\frac{t_{0}}{mn}+G\,\mathbb{E}[\Delta_{T}\mid\Delta_{t_{0}}=0]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A3.E92"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.E92.m1" class="ltx_Math" alttext="\displaystyle\leq\frac{t_{0}}{mn}+G\left(\frac{2CL\gamma C_{w_{0}}}{\delta(1-{\lambda})}+\frac{4CGL\gamma^{2}}{\delta(1-{\lambda})}+\frac{4G\gamma}{mn}\right)\left(1+L\gamma-\frac{L\gamma}{mn}\right)^{T}." display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo mathsize="0.900em">≤</mo><mrow><mstyle displaystyle="true"><mfrac><msub><mi mathsize="0.900em">t</mi><mn mathsize="0.900em">0</mn></msub><mrow><mi mathsize="0.900em">m</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">n</mi></mrow></mfrac></mstyle><mo mathsize="0.900em">+</mo><mrow><mrow><mi mathsize="0.900em">G</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mn mathsize="0.900em">2</mn><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">C</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">L</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">γ</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi mathsize="0.900em">C</mi><msub><mi mathsize="0.900em">w</mi><mn mathsize="0.900em">0</mn></msub></msub></mrow><mrow><mi mathsize="0.900em">δ</mi><mo>⁡</mo><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><mrow><mn mathsize="0.900em">1</mn><mo mathsize="0.900em">−</mo><mi mathsize="0.900em">λ</mi></mrow><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow></mrow></mfrac></mstyle><mo mathsize="0.900em">+</mo><mstyle displaystyle="true"><mfrac><mrow><mn mathsize="0.900em">4</mn><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">C</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">G</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">L</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi mathsize="0.900em">γ</mi><mn mathsize="0.900em">2</mn></msup></mrow><mrow><mi mathsize="0.900em">δ</mi><mo>⁡</mo><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><mrow><mn mathsize="0.900em">1</mn><mo mathsize="0.900em">−</mo><mi mathsize="0.900em">λ</mi></mrow><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow></mrow></mfrac></mstyle><mo mathsize="0.900em">+</mo><mstyle displaystyle="true"><mfrac><mrow><mn mathsize="0.900em">4</mn><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">G</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">γ</mi></mrow><mrow><mi mathsize="0.900em">m</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">n</mi></mrow></mfrac></mstyle></mrow><mo>)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo>(</mo><mrow><mrow><mn mathsize="0.900em">1</mn><mo mathsize="0.900em">+</mo><mrow><mi mathsize="0.900em">L</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">γ</mi></mrow></mrow><mo mathsize="0.900em">−</mo><mstyle displaystyle="true"><mfrac><mrow><mi mathsize="0.900em">L</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">γ</mi></mrow><mrow><mi mathsize="0.900em">m</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">n</mi></mrow></mfrac></mstyle></mrow><mo>)</mo></mrow><mi mathsize="0.900em">T</mi></msup></mrow></mrow></mrow><mo lspace="0em" mathsize="0.900em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\leq\frac{t_{0}}{mn}+G\left(\frac{2CL\gamma C_{w_{0}}}{\delta(1-{\lambda})}+\frac{4CGL\gamma^{2}}{\delta(1-{\lambda})}+\frac{4G\gamma}{mn}\right)\left(1+L\gamma-\frac{L\gamma}{mn}\right)^{T}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(92)</span></td></tr></tbody>
</table>
<p id="A3.SS7.SSS0.Px1.p2.2" class="ltx_p"><span id="A3.SS7.SSS0.Px1.p2.2.1" class="ltx_text" style="font-size:90%;">Letting <math id="A3.SS7.SSS0.Px1.p2.m1" class="ltx_Math" alttext="t_{0}=0" display="inline" intent=":literal"><semantics><mrow><msub><mi>t</mi><mn>0</mn></msub><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">t_{0}=0</annotation></semantics></math> gives the minimal bound in this case.</span></p>
</div>
</section>
<section id="A3.SS7.SSS0.Px2" class="ltx_paragraph">
<h4 class="ltx_title ltx_title_paragraph" style="font-size:90%;">Case 2: Decreasing Learning Rate.</h4>

<div id="A3.SS7.SSS0.Px2.p1" class="ltx_para">
<p id="A3.SS7.SSS0.Px2.p1.1" class="ltx_p"><span id="A3.SS7.SSS0.Px2.p1.1.1" class="ltx_text" style="font-size:90%;">From Eq. </span><a href="#A3.E90" title="In Expectation recursion. ‣ C.6 Proof of Theorem ‣ Appendix C Proof of Theorem and Corollary ‣ Stability and Generalization of Push-Sum Based Decentralized Optimization over Directed Graphs" class="ltx_ref" style="font-size:90%;"><span class="ltx_text ltx_ref_tag">90</span></a><span id="A3.SS7.SSS0.Px2.p1.1.2" class="ltx_text" style="font-size:90%;">, for diminishing learning rates </span><math id="A3.SS7.SSS0.Px2.p1.m1" class="ltx_Math" alttext="\gamma_{t}=\frac{v}{t+1}" display="inline" intent=":literal"><semantics><mrow><msub><mi mathsize="0.900em">γ</mi><mi mathsize="0.900em">t</mi></msub><mo mathsize="0.900em">=</mo><mfrac><mi mathsize="0.900em">v</mi><mrow><mi mathsize="0.900em">t</mi><mo mathsize="0.900em">+</mo><mn mathsize="0.900em">1</mn></mrow></mfrac></mrow><annotation encoding="application/x-tex">\gamma_{t}=\frac{v}{t+1}</annotation></semantics></math><span id="A3.SS7.SSS0.Px2.p1.1.3" class="ltx_text" style="font-size:90%;">, we have</span></p>
<table id="A3.EGx48" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A3.Ex113"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.Ex113.m1" class="ltx_Math" alttext="\displaystyle\mathbb{E}[\Delta_{T}\mid\Delta_{t_{0}}=0]" display="inline" intent=":literal"><semantics><mrow><mi mathsize="0.900em">𝔼</mi><mo>⁡</mo><mrow><mo maxsize="0.900em" minsize="0.900em">[</mo><mrow><msub><mi mathsize="0.900em" mathvariant="normal">Δ</mi><mi mathsize="0.900em">T</mi></msub><mo lspace="0em" mathsize="0.900em" rspace="0.167em">∣</mo><mrow><msub><mi mathsize="0.900em" mathvariant="normal">Δ</mi><msub><mi mathsize="0.900em">t</mi><mn mathsize="0.900em">0</mn></msub></msub><mo mathsize="0.900em">=</mo><mn mathsize="0.900em">0</mn></mrow></mrow><mo maxsize="0.900em" minsize="0.900em">]</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\mathbb{E}[\Delta_{T}\mid\Delta_{t_{0}}=0]</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex113.m2" class="ltx_Math" alttext="\displaystyle\leq\sum_{t=t_{0}}^{T-1}\prod_{k=t+1}^{T-1}\left(1+\left(1-\frac{1}{mn}\right)\frac{Lv}{k+1}\right)\times\Bigg(\frac{2CLv\lambda^{t}C_{w_{0}}}{\delta(t+1)}+\frac{2CGLv^{2}}{\delta(1-{\lambda})(t+1)^{2}}+\frac{2Gv}{mn(t+1)}\Bigg)" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo mathsize="0.900em">≤</mo><mrow><mrow><mstyle displaystyle="true"><munderover><mo maxsize="0.900em" minsize="0.900em" movablelimits="false" stretchy="true">∑</mo><mrow><mi mathsize="0.900em">t</mi><mo mathsize="0.900em">=</mo><msub><mi mathsize="0.900em">t</mi><mn mathsize="0.900em">0</mn></msub></mrow><mrow><mi mathsize="0.900em">T</mi><mo mathsize="0.900em">−</mo><mn mathsize="0.900em">1</mn></mrow></munderover></mstyle><mrow><mstyle displaystyle="true"><munderover><mo maxsize="0.900em" minsize="0.900em" movablelimits="false" stretchy="true">∏</mo><mrow><mi mathsize="0.900em">k</mi><mo mathsize="0.900em">=</mo><mrow><mi mathsize="0.900em">t</mi><mo mathsize="0.900em">+</mo><mn mathsize="0.900em">1</mn></mrow></mrow><mrow><mi mathsize="0.900em">T</mi><mo mathsize="0.900em">−</mo><mn mathsize="0.900em">1</mn></mrow></munderover></mstyle><mrow><mo>(</mo><mrow><mn mathsize="0.900em">1</mn><mo mathsize="0.900em">+</mo><mrow><mrow><mo>(</mo><mrow><mn mathsize="0.900em">1</mn><mo mathsize="0.900em">−</mo><mstyle displaystyle="true"><mfrac><mn mathsize="0.900em">1</mn><mrow><mi mathsize="0.900em">m</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">n</mi></mrow></mfrac></mstyle></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><mrow><mi mathsize="0.900em">L</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">v</mi></mrow><mrow><mi mathsize="0.900em">k</mi><mo mathsize="0.900em">+</mo><mn mathsize="0.900em">1</mn></mrow></mfrac></mstyle></mrow></mrow><mo rspace="0.055em">)</mo></mrow></mrow></mrow><mo mathsize="0.900em" rspace="0.222em">×</mo><mrow><mo maxsize="2.600em" minsize="2.600em">(</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mn mathsize="0.900em">2</mn><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">C</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">L</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">v</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi mathsize="0.900em">λ</mi><mi mathsize="0.900em">t</mi></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi mathsize="0.900em">C</mi><msub><mi mathsize="0.900em">w</mi><mn mathsize="0.900em">0</mn></msub></msub></mrow><mrow><mi mathsize="0.900em">δ</mi><mo>⁡</mo><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><mrow><mi mathsize="0.900em">t</mi><mo mathsize="0.900em">+</mo><mn mathsize="0.900em">1</mn></mrow><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow></mrow></mfrac></mstyle><mo mathsize="0.900em">+</mo><mstyle displaystyle="true"><mfrac><mrow><mn mathsize="0.900em">2</mn><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">C</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">G</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">L</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi mathsize="0.900em">v</mi><mn mathsize="0.900em">2</mn></msup></mrow><mrow><mrow><mi mathsize="0.900em">δ</mi><mo>⁡</mo><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><mrow><mn mathsize="0.900em">1</mn><mo mathsize="0.900em">−</mo><mi mathsize="0.900em">λ</mi></mrow><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><mrow><mi mathsize="0.900em">t</mi><mo mathsize="0.900em">+</mo><mn mathsize="0.900em">1</mn></mrow><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow><mn mathsize="0.900em">2</mn></msup></mrow></mfrac></mstyle><mo mathsize="0.900em">+</mo><mstyle displaystyle="true"><mfrac><mrow><mn mathsize="0.900em">2</mn><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">G</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">v</mi></mrow><mrow><mi mathsize="0.900em">m</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">n</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><mrow><mi mathsize="0.900em">t</mi><mo mathsize="0.900em">+</mo><mn mathsize="0.900em">1</mn></mrow><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow></mrow></mfrac></mstyle></mrow><mo maxsize="2.600em" minsize="2.600em">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\leq\sum_{t=t_{0}}^{T-1}\prod_{k=t+1}^{T-1}\left(1+\left(1-\frac{1}{mn}\right)\frac{Lv}{k+1}\right)\times\Bigg(\frac{2CLv\lambda^{t}C_{w_{0}}}{\delta(t+1)}+\frac{2CGLv^{2}}{\delta(1-{\lambda})(t+1)^{2}}+\frac{2Gv}{mn(t+1)}\Bigg)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A3.Ex114"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex114.m1" class="ltx_Math" alttext="\displaystyle\overset{(g)}{\leq}\sum_{t=t_{0}}^{T-1}\exp\!\left(\left(1-\frac{1}{mn}\right)Lv\sum_{k=t+1}^{T-1}\frac{1}{k+1}\right)\times\Bigg(\frac{2CLv\lambda^{t}C_{w_{0}}}{\delta(t+1)}+\frac{2CGLv^{2}}{\delta(1-{\lambda})(t+1)^{2}}+\frac{2Gv}{mn(t+1)}\Bigg)" display="inline" intent=":literal"><semantics><mrow><mrow><mover accent="true"><mo mathsize="0.900em">≤</mo><mrow><mo maxsize="0.630em" minsize="0.630em">(</mo><mi mathsize="0.630em">g</mi><mo maxsize="0.630em" minsize="0.630em">)</mo></mrow></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo maxsize="0.900em" minsize="0.900em" movablelimits="false" stretchy="true">∑</mo><mrow><mi mathsize="0.900em">t</mi><mo mathsize="0.900em">=</mo><msub><mi mathsize="0.900em">t</mi><mn mathsize="0.900em">0</mn></msub></mrow><mrow><mi mathsize="0.900em">T</mi><mo mathsize="0.900em">−</mo><mn mathsize="0.900em">1</mn></mrow></munderover></mstyle><mrow><mpadded style="width:1.390em;" width="1.390em"><mi mathsize="0.900em">exp</mi></mpadded><mo>⁡</mo><mrow><mo>(</mo><mrow><mrow><mo>(</mo><mrow><mn mathsize="0.900em">1</mn><mo mathsize="0.900em">−</mo><mstyle displaystyle="true"><mfrac><mn mathsize="0.900em">1</mn><mrow><mi mathsize="0.900em">m</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">n</mi></mrow></mfrac></mstyle></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">L</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">v</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo maxsize="0.900em" minsize="0.900em" movablelimits="false" stretchy="true">∑</mo><mrow><mi mathsize="0.900em">k</mi><mo mathsize="0.900em">=</mo><mrow><mi mathsize="0.900em">t</mi><mo mathsize="0.900em">+</mo><mn mathsize="0.900em">1</mn></mrow></mrow><mrow><mi mathsize="0.900em">T</mi><mo mathsize="0.900em">−</mo><mn mathsize="0.900em">1</mn></mrow></munderover></mstyle><mstyle displaystyle="true"><mfrac><mn mathsize="0.900em">1</mn><mrow><mi mathsize="0.900em">k</mi><mo mathsize="0.900em">+</mo><mn mathsize="0.900em">1</mn></mrow></mfrac></mstyle></mrow></mrow><mo rspace="0.055em">)</mo></mrow></mrow></mrow></mrow><mo mathsize="0.900em" rspace="0.222em">×</mo><mrow><mo maxsize="2.600em" minsize="2.600em">(</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mn mathsize="0.900em">2</mn><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">C</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">L</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">v</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi mathsize="0.900em">λ</mi><mi mathsize="0.900em">t</mi></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi mathsize="0.900em">C</mi><msub><mi mathsize="0.900em">w</mi><mn mathsize="0.900em">0</mn></msub></msub></mrow><mrow><mi mathsize="0.900em">δ</mi><mo>⁡</mo><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><mrow><mi mathsize="0.900em">t</mi><mo mathsize="0.900em">+</mo><mn mathsize="0.900em">1</mn></mrow><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow></mrow></mfrac></mstyle><mo mathsize="0.900em">+</mo><mstyle displaystyle="true"><mfrac><mrow><mn mathsize="0.900em">2</mn><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">C</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">G</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">L</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi mathsize="0.900em">v</mi><mn mathsize="0.900em">2</mn></msup></mrow><mrow><mrow><mi mathsize="0.900em">δ</mi><mo>⁡</mo><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><mrow><mn mathsize="0.900em">1</mn><mo mathsize="0.900em">−</mo><mi mathsize="0.900em">λ</mi></mrow><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><mrow><mi mathsize="0.900em">t</mi><mo mathsize="0.900em">+</mo><mn mathsize="0.900em">1</mn></mrow><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow><mn mathsize="0.900em">2</mn></msup></mrow></mfrac></mstyle><mo mathsize="0.900em">+</mo><mstyle displaystyle="true"><mfrac><mrow><mn mathsize="0.900em">2</mn><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">G</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">v</mi></mrow><mrow><mi mathsize="0.900em">m</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">n</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><mrow><mi mathsize="0.900em">t</mi><mo mathsize="0.900em">+</mo><mn mathsize="0.900em">1</mn></mrow><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow></mrow></mfrac></mstyle></mrow><mo maxsize="2.600em" minsize="2.600em">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\overset{(g)}{\leq}\sum_{t=t_{0}}^{T-1}\exp\!\left(\left(1-\frac{1}{mn}\right)Lv\sum_{k=t+1}^{T-1}\frac{1}{k+1}\right)\times\Bigg(\frac{2CLv\lambda^{t}C_{w_{0}}}{\delta(t+1)}+\frac{2CGLv^{2}}{\delta(1-{\lambda})(t+1)^{2}}+\frac{2Gv}{mn(t+1)}\Bigg)</annotation></semantics></math></td>
