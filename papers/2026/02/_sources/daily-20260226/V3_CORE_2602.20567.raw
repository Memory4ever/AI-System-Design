<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex110.m1" class="ltx_Math" alttext="\displaystyle\hskip 9.24994pt+\left(\frac{2CGL\gamma^{2}}{\delta(1-{\lambda})}+\frac{2G\gamma}{mn}\right)\left(\frac{mn}{mn-1}\right)\left[\left(1+L\gamma-\frac{L\gamma}{mn}\right)^{T}-1\right]" display="inline" intent=":literal"><semantics><mrow><mo mathsize="0.900em">+</mo><mrow><mrow><mo>(</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mn mathsize="0.900em">2</mn><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">C</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">G</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">L</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi mathsize="0.900em">γ</mi><mn mathsize="0.900em">2</mn></msup></mrow><mrow><mi mathsize="0.900em">δ</mi><mo>⁡</mo><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><mrow><mn mathsize="0.900em">1</mn><mo mathsize="0.900em">−</mo><mi mathsize="0.900em">λ</mi></mrow><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow></mrow></mfrac></mstyle><mo mathsize="0.900em">+</mo><mstyle displaystyle="true"><mfrac><mrow><mn mathsize="0.900em">2</mn><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">G</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">γ</mi></mrow><mrow><mi mathsize="0.900em">m</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">n</mi></mrow></mfrac></mstyle></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mstyle displaystyle="true"><mfrac><mrow><mi mathsize="0.900em">m</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">n</mi></mrow><mrow><mrow><mi mathsize="0.900em">m</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">n</mi></mrow><mo mathsize="0.900em">−</mo><mn mathsize="0.900em">1</mn></mrow></mfrac></mstyle><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><mrow><msup><mrow><mo>(</mo><mrow><mrow><mn mathsize="0.900em">1</mn><mo mathsize="0.900em">+</mo><mrow><mi mathsize="0.900em">L</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">γ</mi></mrow></mrow><mo mathsize="0.900em">−</mo><mstyle displaystyle="true"><mfrac><mrow><mi mathsize="0.900em">L</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">γ</mi></mrow><mrow><mi mathsize="0.900em">m</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">n</mi></mrow></mfrac></mstyle></mrow><mo>)</mo></mrow><mi mathsize="0.900em">T</mi></msup><mo mathsize="0.900em">−</mo><mn mathsize="0.900em">1</mn></mrow><mo>]</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\hskip 9.24994pt+\left(\frac{2CGL\gamma^{2}}{\delta(1-{\lambda})}+\frac{2G\gamma}{mn}\right)\left(\frac{mn}{mn-1}\right)\left[\left(1+L\gamma-\frac{L\gamma}{mn}\right)^{T}-1\right]</annotation></semantics></math></td>
