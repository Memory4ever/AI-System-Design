<td id="S5.T5.2.2.3" class="ltx_td ltx_align_center ltx_border_t"><span id="S5.T5.2.2.3.1" class="ltx_text" style="font-size:90%;">72.6% <span id="S5.T5.2.2.3.1.1" class="ltx_text" style="--ltx-fg-color:#41719C;">(<math id="S5.T5.m1" class="ltx_Math" alttext="\downarrow" display="inline" intent=":literal"><semantics><mo style="--ltx-fg-color:#41719C;" mathcolor="#41719C" stretchy="false">↓</mo><annotation encoding="application/x-tex">\downarrow</annotation></semantics></math> 0%)</span></span></td>
<td id="S5.T5.2.2.4" class="ltx_td ltx_align_center ltx_border_t"><span id="S5.T5.2.2.4.1" class="ltx_text" style="font-size:90%;">45.7% <span id="S5.T5.2.2.4.1.1" class="ltx_text" style="--ltx-fg-color:#960000;">(<math id="S5.T5.m2" class="ltx_Math" alttext="\downarrow" display="inline" intent=":literal"><semantics><mo style="--ltx-fg-color:#960000;" mathcolor="#960000" stretchy="false">↓</mo><annotation encoding="application/x-tex">\downarrow</annotation></semantics></math> 26.9%)</span></span></td></tr>
<tr id="S5.T5.2.3" class="ltx_tr">
<td id="S5.T5.2.3.1" class="ltx_td ltx_align_left"><span id="S5.T5.2.3.1.1" class="ltx_text" style="font-size:90%;">CodeLlama-7B</span></td>
<td id="S5.T5.2.3.2" class="ltx_td ltx_align_center"><span id="S5.T5.2.3.2.1" class="ltx_text" style="font-size:90%;">18.3%</span></td>
<td id="S5.T5.2.3.3" class="ltx_td ltx_align_center"><span id="S5.T5.2.3.3.1" class="ltx_text" style="font-size:90%;">18.3% <span id="S5.T5.2.3.3.1.1" class="ltx_text" style="--ltx-fg-color:#41719C;">(<math id="S5.T5.m3" class="ltx_Math" alttext="\downarrow" display="inline" intent=":literal"><semantics><mo style="--ltx-fg-color:#41719C;" mathcolor="#41719C" stretchy="false">↓</mo><annotation encoding="application/x-tex">\downarrow</annotation></semantics></math> 0%)</span></span></td>
<td id="S5.T5.2.3.4" class="ltx_td ltx_align_center"><span id="S5.T5.2.3.4.1" class="ltx_text" style="font-size:90%;">4.3% <span id="S5.T5.2.3.4.1.1" class="ltx_text" style="--ltx-fg-color:#960000;">(<math id="S5.T5.m4" class="ltx_Math" alttext="\downarrow" display="inline" intent=":literal"><semantics><mo style="--ltx-fg-color:#960000;" mathcolor="#960000" stretchy="false">↓</mo><annotation encoding="application/x-tex">\downarrow</annotation></semantics></math> 14.0%)</span></span></td></tr>
<tr id="S5.T5.2.4" class="ltx_tr">
<td id="S5.T5.2.4.1" class="ltx_td ltx_align_left"><span id="S5.T5.2.4.1.1" class="ltx_text" style="font-size:90%;">Qwen2.5-Coder-7B</span></td>
<td id="S5.T5.2.4.2" class="ltx_td ltx_align_center"><span id="S5.T5.2.4.2.1" class="ltx_text" style="font-size:90%;">79.3%</span></td>
<td id="S5.T5.2.4.3" class="ltx_td ltx_align_center"><span id="S5.T5.2.4.3.1" class="ltx_text" style="font-size:90%;">79.3% <span id="S5.T5.2.4.3.1.1" class="ltx_text" style="--ltx-fg-color:#41719C;">(<math id="S5.T5.m5" class="ltx_Math" alttext="\downarrow" display="inline" intent=":literal"><semantics><mo style="--ltx-fg-color:#41719C;" mathcolor="#41719C" stretchy="false">↓</mo><annotation encoding="application/x-tex">\downarrow</annotation></semantics></math> 0%)</span></span></td>
<td id="S5.T5.2.4.4" class="ltx_td ltx_align_center"><span id="S5.T5.2.4.4.1" class="ltx_text" style="font-size:90%;">-</span></td></tr>
<tr id="S5.T5.2.5" class="ltx_tr">
<td id="S5.T5.2.5.1" class="ltx_td ltx_align_left"><span id="S5.T5.2.5.1.1" class="ltx_text" style="font-size:90%;">Meta-Llama-3-8B</span></td>
<td id="S5.T5.2.5.2" class="ltx_td ltx_align_center"><span id="S5.T5.2.5.2.1" class="ltx_text" style="font-size:90%;">53.0%</span></td>
<td id="S5.T5.2.5.3" class="ltx_td ltx_align_center"><span id="S5.T5.2.5.3.1" class="ltx_text" style="font-size:90%;">53.0% <span id="S5.T5.2.5.3.1.1" class="ltx_text" style="--ltx-fg-color:#41719C;">(<math id="S5.T5.m6" class="ltx_Math" alttext="\downarrow" display="inline" intent=":literal"><semantics><mo style="--ltx-fg-color:#41719C;" mathcolor="#41719C" stretchy="false">↓</mo><annotation encoding="application/x-tex">\downarrow</annotation></semantics></math> 0%)</span></span></td>
<td id="S5.T5.2.5.4" class="ltx_td ltx_align_center"><span id="S5.T5.2.5.4.1" class="ltx_text" style="font-size:90%;">-</span></td></tr>
<tr id="S5.T5.2.6" class="ltx_tr">
<td id="S5.T5.2.6.1" class="ltx_td ltx_align_left ltx_border_bb"><span id="S5.T5.2.6.1.1" class="ltx_text" style="font-size:90%;">Meta-Llama-3.1-8B</span></td>
<td id="S5.T5.2.6.2" class="ltx_td ltx_align_center ltx_border_bb"><span id="S5.T5.2.6.2.1" class="ltx_text" style="font-size:90%;">60.4%</span></td>
<td id="S5.T5.2.6.3" class="ltx_td ltx_align_center ltx_border_bb"><span id="S5.T5.2.6.3.1" class="ltx_text" style="font-size:90%;">60.4% <span id="S5.T5.2.6.3.1.1" class="ltx_text" style="--ltx-fg-color:#41719C;">(<math id="S5.T5.m7" class="ltx_Math" alttext="\downarrow" display="inline" intent=":literal"><semantics><mo style="--ltx-fg-color:#41719C;" mathcolor="#41719C" stretchy="false">↓</mo><annotation encoding="application/x-tex">\downarrow</annotation></semantics></math> 0%)</span></span></td>
<td id="S5.T5.2.6.4" class="ltx_td ltx_align_center ltx_border_bb"><span id="S5.T5.2.6.4.1" class="ltx_text" style="font-size:90%;">-</span></td></tr>
</table>
</figure>
<div id="S5.SS3.p2" class="ltx_para">
<p id="S5.SS3.p2.1" class="ltx_p"><span id="S5.SS3.p2.1.1" class="ltx_text ltx_font_bold">Settings.</span> Following the HumanEval <cite class="ltx_cite ltx_citemacro_citep">(<a href="#bib.bib35" title="" class="ltx_ref">Chen, 2021</a>)</cite> protocol adopted by <cite class="ltx_cite ltx_citemacro_citeauthor"><a href="#bib.bib5" title="" class="ltx_ref">Spracklen et al.</a></cite> <cite class="ltx_cite ltx_citemacro_citep">(<a href="#bib.bib5" title="" class="ltx_ref">Spracklen et al., 2024</a>)</cite>, we evaluate the same models before and after integrating <span id="S5.SS3.p2.1.2" class="ltx_text ltx_font_smallcaps">PackMonitor</span>, and report Pass@1 as the metric for functional correctness. For stability, we set the decoding temperature to 0 for all runs in this RQ.</p>
</div>
<div id="S5.SS3.p3" class="ltx_para">
<p id="S5.SS3.p3.1" class="ltx_p"><span id="S5.SS3.p3.1.1" class="ltx_text ltx_font_bold">Results.</span> The results are shown in Table <a href="#S5.T5" title="Table 5 ‣ 5.3. RQ3: Does PackMonitor Degrade the General Code Generation Capability of LLMs? ‣ 5. Experimental Results ‣ PackMonitor: Enabling Zero Package Hallucinations Through Decoding-Time Monitoring" class="ltx_ref"><span class="ltx_text ltx_ref_tag">5</span></a>.</p>
</div>
<div id="S5.SS3.p4" class="ltx_para">
<p id="S5.SS3.p4.1" class="ltx_p"><span id="S5.SS3.p4.1.1" class="ltx_text ltx_font_bold">Across all evaluated models, HumanEval performance remains unchanged after incorporating <span id="S5.SS3.p4.1.1.1" class="ltx_text ltx_font_smallcaps">PackMonitor</span>.</span>
As shown in Table <a href="#S5.T5" title="Table 5 ‣ 5.3. RQ3: Does PackMonitor Degrade the General Code Generation Capability of LLMs? ‣ 5. Experimental Results ‣ PackMonitor: Enabling Zero Package Hallucinations Through Decoding-Time Monitoring" class="ltx_ref"><span class="ltx_text ltx_ref_tag">5</span></a>, the Pass@1 scores remain unchanged with and without <span id="S5.SS3.p4.1.2" class="ltx_text ltx_font_smallcaps">PackMonitor</span>, indicating that our approach does not degrade general code generation capability. We attribute this to the fact that <span id="S5.SS3.p4.1.3" class="ltx_text ltx_font_smallcaps">PackMonitor</span> only intervenes when the model is generating package names following installation commands. As a result, <span id="S5.SS3.p4.1.4" class="ltx_text ltx_font_smallcaps">PackMonitor</span> eliminates hallucinated packages without interfering with ordinary code generation, thereby preserving the original utility.</p>
</div>
<div id="S5.SS3.p5" class="ltx_para">
<p id="S5.SS3.p5.1" class="ltx_p"><span id="S5.SS3.p5.1.1" class="ltx_text ltx_font_bold">The utility preservation of <span id="S5.SS3.p5.1.1.1" class="ltx_text ltx_font_smallcaps">PackMonitor</span> contrasts sharply with SFT.</span> Prior work reports that although SFT can significantly reduce package hallucinations, it may noticeably hurt general code generation performance. On HumanEval, the Pass@1 scores of DeepSeek-Coder-6.7B and CodeLlama-7B drop by 26.9% and 14.0%, respectively <cite class="ltx_cite ltx_citemacro_citep">(<a href="#bib.bib5" title="" class="ltx_ref">Spracklen et al., 2024</a>)</cite>. This degradation is expected because SFT changes model weights and may inadvertently harm general code generation performance.</p>
</div>
<div id="S5.SS3.p6" class="ltx_para ltx_noindent"><span class="ltx_inline-block"><svg id="S5.SS3.p6.pic1" class="ltx_picture" height="119.68" overflow="visible" version="1.1" viewBox="0 0 477.38 119.68" width="477.38"><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" stroke-width="0.4pt" transform="translate(0,119.68) matrix(1 0 0 -1 0 0)"><g style="--ltx-stroke-color:#BFBFBF;--ltx-fill-color:#BFBFBF;--ltx-fg-color:#BFBFBF;" color="#BFBFBF" fill="#BFBFBF" stroke="#BFBFBF"><path style="stroke:none" d="M 2.08 5.88 L 2.08 109.65 C 2.08 114.05 5.64 117.61 10.03 117.61 L 471.5 117.61 C 475.89 117.61 479.45 114.05 479.45 109.65 L 479.45 5.88 C 479.45 1.49 475.89 -2.08 471.5 -2.08 L 10.03 -2.08 C 5.64 -2.08 2.08 1.49 2.08 5.88 Z"></path></g><g style="--ltx-fill-color:#F0F0F0;" fill="#F0F0F0" fill-opacity="1.0"><path style="stroke:none" d="M 0 6.92 L 0 112.77 C 0 116.59 3.1 119.68 6.92 119.68 L 470.46 119.68 C 474.28 119.68 477.38 116.59 477.38 112.77 L 477.38 6.92 C 477.38 3.1 474.28 0 470.46 0 L 6.92 0 C 3.1 0 0 3.1 0 6.92 Z"></path></g><g fill-opacity="1.0" transform="matrix(1.0 0.0 0.0 1.0 15.01 14.93)"><foreignObject style="--ltx-fo-width:32.33em;--ltx-fo-height:6.69em;--ltx-fo-depth:0.19em;font-size:10pt;" height="95.21" overflow="visible" transform="matrix(1 0 0 -1 0 92.52)" width="447.36"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content">
<span id="S5.SS3.p6.pic1.1" class="ltx_inline-block ltx_minipage ltx_align_bottom" style="width:32.33em;">
<span id="S5.SS3.p6.pic1.1.1" class="ltx_p"><span id="S5.SS3.p6.pic1.1.1.1" class="ltx_text ltx_font_bold" style="--ltx-fg-color:#000000;">Answer to RQ3.<span id="S5.SS3.p6.pic1.1.1.1.1" class="ltx_text ltx_font_medium">
On HumanEval, integrating <span id="S5.SS3.p6.pic1.1.1.1.1.1" class="ltx_text ltx_font_smallcaps">PackMonitor</span> does not change Pass@1 across all evaluated models, indicating that <span id="S5.SS3.p6.pic1.1.1.1.1.2" class="ltx_text ltx_font_smallcaps">PackMonitor</span> preserves general code generation capability.</span></span></span>
</span></span></span></foreignObject></g></g></svg></span>
</div>
</section>
<section id="S5.SS4" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">5.4. </span>RQ4: How Much does DFA-Caching Mechanism Improve Inference Efficiency and Scalability?</h3>

<div id="S5.SS4.p1" class="ltx_para">
<p id="S5.SS4.p1.1" class="ltx_p">In this RQ, we conduct an ablation study to evaluate the effectiveness of the DFA-caching mechanism and to examine how decoding latency scales with increasing package list sizes.</p>
</div>
<figure id="S5.T6" class="ltx_table">
<figcaption class="ltx_caption"><span class="ltx_tag ltx_tag_table">Table 6. </span>Comparison of average generation time on HFuzzer with and without caching across LLMs. Values in parentheses represent the time multiplier relative to the vanilla model.</figcaption>
<table id="S5.T6.2" class="ltx_tabular ltx_centering ltx_align_middle">
<tr id="S5.T6.2.1" class="ltx_tr">
<td id="S5.T6.2.1.1" class="ltx_td ltx_align_left ltx_border_t" style="padding:0.45pt 8.0pt;"><span id="S5.T6.2.1.1.1" class="ltx_text ltx_font_bold" style="font-size:90%;">Model</span></td>
<td id="S5.T6.2.1.2" class="ltx_td ltx_align_center ltx_border_t" style="padding:0.45pt 8.0pt;"><span id="S5.T6.2.1.2.1" class="ltx_text ltx_font_bold" style="font-size:90%;">Average Generation Time (s)</span></td></tr>
<tr id="S5.T6.2.2" class="ltx_tr">
<td id="S5.T6.2.2.1" class="ltx_td ltx_align_left ltx_border_t" style="padding:0.45pt 8.0pt;"><span id="S5.T6.2.2.1.1" class="ltx_text ltx_font_bold" style="font-size:90%;">DeepSeek-Coder-6.7B</span></td>
<td id="S5.T6.2.2.2" class="ltx_td ltx_align_center ltx_border_t" style="padding:0.45pt 8.0pt;"><span id="S5.T6.2.2.2.1" class="ltx_text" style="font-size:90%;">1.9809</span></td></tr>
<tr id="S5.T6.2.3" class="ltx_tr" style="--ltx-bg-color:#F5F5F5;">
<td id="S5.T6.2.3.1" class="ltx_td ltx_align_left" style="padding:0.45pt 8.0pt;"><span id="S5.T6.2.3.1.1" class="ltx_text" style="font-size:90%;--ltx-bg-color:#F5F5F5;">   + <span id="S5.T6.2.3.1.1.1" class="ltx_text ltx_font_smallcaps">PackMonitor</span> (w/o cache)</span></td>
<td id="S5.T6.2.3.2" class="ltx_td ltx_align_center" style="padding:0.45pt 8.0pt;"><span id="S5.T6.2.3.2.1" class="ltx_text" style="font-size:90%;--ltx-bg-color:#F5F5F5;">5.9150 <span id="S5.T6.2.3.2.1.1" class="ltx_text" style="--ltx-fg-color:#960000;">(<math id="S5.T6.m1" class="ltx_Math" alttext="\times" display="inline" intent=":literal"><semantics><mo style="--ltx-fg-color:#960000;--ltx-bg-color:#F5F5F5;" mathbackground="#F5F5F5" mathcolor="#960000">×</mo><annotation encoding="application/x-tex">\times</annotation></semantics></math>2.99)</span></span></td></tr>
<tr id="S5.T6.2.4" class="ltx_tr" style="--ltx-bg-color:#E7E7E7;">
<td id="S5.T6.2.4.1" class="ltx_td ltx_align_left" style="padding:0.45pt 8.0pt;"><span id="S5.T6.2.4.1.1" class="ltx_text" style="font-size:90%;--ltx-bg-color:#E7E7E7;">   + <span id="S5.T6.2.4.1.1.1" class="ltx_text ltx_font_smallcaps">PackMonitor</span></span></td>
<td id="S5.T6.2.4.2" class="ltx_td ltx_align_center" style="padding:0.45pt 8.0pt;"><span id="S5.T6.2.4.2.1" class="ltx_text" style="font-size:90%;--ltx-bg-color:#E7E7E7;">2.2351 <span id="S5.T6.2.4.2.1.1" class="ltx_text" style="--ltx-fg-color:#41719C;">(<math id="S5.T6.m2" class="ltx_Math" alttext="\times" display="inline" intent=":literal"><semantics><mo style="--ltx-fg-color:#41719C;--ltx-bg-color:#E7E7E7;" mathbackground="#E7E7E7" mathcolor="#41719C">×</mo><annotation encoding="application/x-tex">\times</annotation></semantics></math>1.13)</span></span></td></tr>
<tr id="S5.T6.2.5" class="ltx_tr">
<td id="S5.T6.2.5.1" class="ltx_td ltx_align_left" style="padding:0.45pt 8.0pt;"><span id="S5.T6.2.5.1.1" class="ltx_text ltx_font_bold" style="font-size:90%;">CodeLlama-7B</span></td>
