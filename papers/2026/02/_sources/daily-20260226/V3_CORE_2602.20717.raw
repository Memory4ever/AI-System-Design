<td id="S5.T4.2.1.6.4" class="ltx_td ltx_align_center ltx_border_bb" style="padding-top:1pt;padding-bottom:1pt;"><span id="S5.T4.2.1.6.4.1" class="ltx_text ltx_font_bold" style="--ltx-bg-color:#E8E8E8;">0.8596<span id="S5.T4.2.1.6.4.1.1" class="ltx_text ltx_font_medium"> </span><span id="S5.T4.2.1.6.4.1.2" class="ltx_text" style="--ltx-fg-color:#41719C;">(<math id="S5.T4.m18" class="ltx_Math" alttext="\times" display="inline" intent=":literal"><semantics><mo style="--ltx-fg-color:#41719C;--ltx-bg-color:#E8E8E8;" mathbackground="#E8E8E8" mathcolor="#41719C">×</mo><annotation encoding="application/x-tex">\times</annotation></semantics></math>1.07)</span></span></td>
