<td id="S4.T1.3.1.1.6" class="ltx_td ltx_align_center ltx_border_tt" style="padding-top:-3.85pt;padding-bottom:-3.85pt;"><span id="S4.T1.3.1.1.6.1" class="ltx_text ltx_font_bold" style="font-size:80%;">L1 <math id="S4.T1.m5" class="ltx_Math" alttext="\downarrow" display="inline" intent=":literal"><semantics><mo stretchy="false">↓</mo><annotation encoding="application/x-tex">\downarrow</annotation></semantics></math></span></td>
<td id="S4.T1.3.1.1.7" class="ltx_td ltx_align_center ltx_border_tt" style="padding-top:-3.85pt;padding-bottom:-3.85pt;"><span id="S4.T1.3.1.1.7.1" class="ltx_text ltx_font_bold" style="font-size:80%;">FID-VID <math id="S4.T1.m6" class="ltx_Math" alttext="\downarrow" display="inline" intent=":literal"><semantics><mo stretchy="false">↓</mo><annotation encoding="application/x-tex">\downarrow</annotation></semantics></math></span></td>
<td id="S4.T1.3.1.1.8" class="ltx_td ltx_align_center ltx_border_tt" style="padding-top:-3.85pt;padding-bottom:-3.85pt;"><span id="S4.T1.3.1.1.8.1" class="ltx_text ltx_font_bold" style="font-size:80%;">FVD <math id="S4.T1.m7" class="ltx_Math" alttext="\downarrow" display="inline" intent=":literal"><semantics><mo stretchy="false">↓</mo><annotation encoding="application/x-tex">\downarrow</annotation></semantics></math></span></td></tr>
<tr id="S4.T1.3.1.2" class="ltx_tr">
<td id="S4.T1.3.1.2.1" class="ltx_td ltx_align_left ltx_border_t" style="padding-top:-3.85pt;padding-bottom:-3.85pt;"><span id="S4.T1.3.1.2.1.1" class="ltx_text" style="font-size:80%;">MagicAnimate </span><cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib22" title="" class="ltx_ref">22</a>]</cite></td>
<td id="S4.T1.3.1.2.2" class="ltx_td ltx_align_center ltx_border_t" style="padding-top:-3.85pt;padding-bottom:-3.85pt;"><span id="S4.T1.3.1.2.2.1" class="ltx_text" style="font-size:80%;">363.1</span></td>
<td id="S4.T1.3.1.2.3" class="ltx_td ltx_align_center ltx_border_t" style="padding-top:-3.85pt;padding-bottom:-3.85pt;"><span id="S4.T1.3.1.2.3.1" class="ltx_text" style="font-size:80%;">0.756</span></td>
<td id="S4.T1.3.1.2.4" class="ltx_td ltx_align_center ltx_border_t" style="padding-top:-3.85pt;padding-bottom:-3.85pt;"><span id="S4.T1.3.1.2.4.1" class="ltx_text" style="font-size:80%;">8.227</span></td>
<td id="S4.T1.3.1.2.5" class="ltx_td ltx_align_center ltx_border_t" style="padding-top:-3.85pt;padding-bottom:-3.85pt;"><span id="S4.T1.3.1.2.5.1" class="ltx_text" style="font-size:80%;">0.455</span></td>
<td id="S4.T1.3.1.2.6" class="ltx_td ltx_align_center ltx_border_t" style="padding-top:-3.85pt;padding-bottom:-3.85pt;"><span id="S4.T1.3.1.2.6.1" class="ltx_text" style="font-size:80%;">2.8e-04</span></td>
<td id="S4.T1.3.1.2.7" class="ltx_td ltx_align_center ltx_border_t" style="padding-top:-3.85pt;padding-bottom:-3.85pt;"><span id="S4.T1.3.1.2.7.1" class="ltx_text" style="font-size:80%;">161.3</span></td>
<td id="S4.T1.3.1.2.8" class="ltx_td ltx_align_center ltx_border_t" style="padding-top:-3.85pt;padding-bottom:-3.85pt;"><span id="S4.T1.3.1.2.8.1" class="ltx_text" style="font-size:80%;">1323.</span></td></tr>
