<td id="S4.T1.3.1.1.2" class="ltx_td ltx_align_center ltx_border_tt" style="padding-top:-3.85pt;padding-bottom:-3.85pt;"><span id="S4.T1.3.1.1.2.1" class="ltx_text ltx_font_bold" style="font-size:80%;">FID <math id="S4.T1.m1" class="ltx_Math" alttext="\downarrow" display="inline" intent=":literal"><semantics><mo stretchy="false">↓</mo><annotation encoding="application/x-tex">\downarrow</annotation></semantics></math></span></td>
