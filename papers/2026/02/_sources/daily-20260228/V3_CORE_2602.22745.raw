<tr id="A2.T4.3.1.4" class="ltx_tr">
<td id="A2.T4.3.1.4.1" class="ltx_td ltx_align_left ltx_border_bb ltx_border_t" rowspan="2"><span id="A2.T4.3.1.4.1.1" class="ltx_text">+ LoRA</span></td>
<td id="A2.T4.3.1.4.2" class="ltx_td ltx_align_left ltx_border_t">Initial SSR</td>
<td id="A2.T4.3.1.4.3" class="ltx_td ltx_align_center ltx_border_t">0.456</td>
