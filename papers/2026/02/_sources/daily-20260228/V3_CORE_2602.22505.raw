\text{only}\penalty\ y^{i}\neq x^{i}=\mathrm{[MASK]}\end{subarray}}\frac{(\hat{q}_{0}(y^{i}|x_{k}^{UM})-q_{0}(y^{i}|x_{k}^{UM}))^{2}}{2q_{0}(y^{i}|x_{k}^{UM})}+o(1)</annotation></semantics></math></td>
