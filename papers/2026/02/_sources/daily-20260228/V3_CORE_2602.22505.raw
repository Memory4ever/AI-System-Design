<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.Ex68.m1" class="ltx_Math" alttext="\displaystyle\lesssim\mathbb{E}_{x_{t_{k}}\sim\mathchoice{\mkern 3.0mu\reflectbox{$\displaystyle\vec{\reflectbox{$\mkern-3.0mu\displaystyle q\mkern 3.0mu$}}$}\mkern-3.0mu}{\mkern 3.0mu\reflectbox{$\textstyle\vec{\reflectbox{$\mkern-3.0mu\textstyle q\mkern 3.0mu$}}$}\mkern-3.0mu}{\mkern 2.0mu\reflectbox{$\scriptstyle\vec{\reflectbox{$\mkern-2.0mu\scriptstyle q\mkern 2.0mu$}}$}\mkern-2.0mu}{\mkern 2.0mu\reflectbox{$\scriptscriptstyle\vec{\reflectbox{$\mkern-2.0mu\scriptscriptstyle q\mkern 2.0mu$}}$}\mkern-2.0mu}_{t_{k}}}\sum_{y\neq x_{t_{k}}}\left|\frac{q_{T-t}(y)}{q_{T-t}(x_{t_{k}})}-\frac{q_{T-t_{k}}(y)}{q_{T-t_{k}}(x_{t_{k}})}\right|R(y,x_{t_{k}})" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≲</mo><mrow><msub><mi>𝔼</mi><mrow><msub><mi>x</mi><msub><mi>t</mi><mi>k</mi></msub></msub><mo rspace="0.388em">∼</mo><msub><mpadded style="width:6.5pt;height:7.1pt;vertical-align:-0.0pt;" depth="0.0pt" height="7.1pt" width="6.5pt"><mover accent="true"><mpadded style="width:1.7pt;height:2.2pt;vertical-align:-0.7pt;" depth="0.7pt" height="1.5pt" width="1.7pt"><mi mathsize="0.480em">q</mi></mpadded><mo stretchy="false">→</mo></mover></mpadded><msub><mi>t</mi><mi>k</mi></msub></msub></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mi>y</mi><mo>≠</mo><msub><mi>x</mi><msub><mi>t</mi><mi>k</mi></msub></msub></mrow></munder></mstyle><mrow><mrow><mo>|</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><msub><mi>q</mi><mrow><mi>T</mi><mo>−</mo><mi>t</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>y</mi><mo stretchy="false">)</mo></mrow></mrow><mrow><msub><mi>q</mi><mrow><mi>T</mi><mo>−</mo><mi>t</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><msub><mi>t</mi><mi>k</mi></msub></msub><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle><mo>−</mo><mstyle displaystyle="true"><mfrac><mrow><msub><mi>q</mi><mrow><mi>T</mi><mo>−</mo><msub><mi>t</mi><mi>k</mi></msub></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>y</mi><mo stretchy="false">)</mo></mrow></mrow><mrow><msub><mi>q</mi><mrow><mi>T</mi><mo>−</mo><msub><mi>t</mi><mi>k</mi></msub></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><msub><mi>t</mi><mi>k</mi></msub></msub><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle></mrow><mo>|</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>R</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>y</mi><mo>,</mo><msub><mi>x</mi><msub><mi>t</mi><mi>k</mi></msub></msub><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\lesssim\mathbb{E}_{x_{t_{k}}\sim\mathchoice{\mkern 3.0mu\reflectbox{$\displaystyle\vec{\reflectbox{$\mkern-3.0mu\displaystyle q\mkern 3.0mu$}}$}\mkern-3.0mu}{\mkern 3.0mu\reflectbox{$\textstyle\vec{\reflectbox{$\mkern-3.0mu\textstyle q\mkern 3.0mu$}}$}\mkern-3.0mu}{\mkern 2.0mu\reflectbox{$\scriptstyle\vec{\reflectbox{$\mkern-2.0mu\scriptstyle q\mkern 2.0mu$}}$}\mkern-2.0mu}{\mkern 2.0mu\reflectbox{$\scriptscriptstyle\vec{\reflectbox{$\mkern-2.0mu\scriptscriptstyle q\mkern 2.0mu$}}$}\mkern-2.0mu}_{t_{k}}}\sum_{y\neq x_{t_{k}}}\left|\frac{q_{T-t}(y)}{q_{T-t}(x_{t_{k}})}-\frac{q_{T-t_{k}}(y)}{q_{T-t_{k}}(x_{t_{k}})}\right|R(y,x_{t_{k}})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A5.Ex69"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.Ex69.m1" class="ltx_math_unparsed" alttext="\displaystyle\lesssim(t-t_{k})\mathbb{E}_{x_{t_{k}}\sim\mathchoice{\mkern 3.0mu\reflectbox{$\displaystyle\vec{\reflectbox{$\mkern-3.0mu\displaystyle q\mkern 3.0mu$}}$}\mkern-3.0mu}{\mkern 3.0mu\reflectbox{$\textstyle\vec{\reflectbox{$\mkern-3.0mu\textstyle q\mkern 3.0mu$}}$}\mkern-3.0mu}{\mkern 2.0mu\reflectbox{$\scriptstyle\vec{\reflectbox{$\mkern-2.0mu\scriptstyle q\mkern 2.0mu$}}$}\mkern-2.0mu}{\mkern 2.0mu\reflectbox{$\scriptscriptstyle\vec{\reflectbox{$\mkern-2.0mu\scriptscriptstyle q\mkern 2.0mu$}}$}\mkern-2.0mu}_{t_{k}}}\sum_{y\neq x_{t_{k}}}\sup_{t^{\prime}\in(T-t_{k+1},T-t_{k}]}\left|\frac{\partial}{\partial t^{\prime}}\left(\frac{q_{T-t^{\prime}}(y)}{q_{T-t^{\prime}}(x_{t_{k}})}\right)\right|R(y,x_{t_{k}})" display="inline" intent=":literal"><semantics><mrow><mo>≲</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo>−</mo><msub><mi>t</mi><mi>k</mi></msub><mo stretchy="false">)</mo></mrow><msub><mi>𝔼</mi><mrow><msub><mi>x</mi><msub><mi>t</mi><mi>k</mi></msub></msub><mo rspace="0.388em">∼</mo><msub><mpadded style="width:6.5pt;height:7.1pt;vertical-align:-0.0pt;" depth="0.0pt" height="7.1pt" width="6.5pt"><mover accent="true"><mpadded style="width:1.7pt;height:2.2pt;vertical-align:-0.7pt;" depth="0.7pt" height="1.5pt" width="1.7pt"><mi mathsize="0.480em">q</mi></mpadded><mo stretchy="false">→</mo></mover></mpadded><msub><mi>t</mi><mi>k</mi></msub></msub></mrow></msub><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mi>y</mi><mo>≠</mo><msub><mi>x</mi><msub><mi>t</mi><mi>k</mi></msub></msub></mrow></munder></mstyle><munder><mo lspace="0.167em" movablelimits="false" rspace="0em">sup</mo><mrow><mi>t</mi><msup><mrow></mrow><mo>′</mo></msup><mo>∈</mo><mo stretchy="false">(</mo><mi>T</mi><mo>−</mo><mi>t</mi><msub><mrow></mrow><mrow><mi>k</mi><mo>+</mo><mn>1</mn></mrow></msub><mo>,</mo><mi>T</mi><mo>−</mo><mi>t</mi><msub><mrow></mrow><mi>k</mi></msub><mo stretchy="false">]</mo></mrow></munder><mo fence="false" rspace="0.167em">|</mo><mstyle displaystyle="true"><mfrac><mo>∂</mo><mrow><mo>∂</mo><msup><mi>t</mi><mo>′</mo></msup></mrow></mfrac></mstyle><mrow><mo>(</mo><mstyle displaystyle="true"><mfrac><mrow><msub><mi>q</mi><mrow><mi>T</mi><mo>−</mo><msup><mi>t</mi><mo>′</mo></msup></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>y</mi><mo stretchy="false">)</mo></mrow></mrow><mrow><msub><mi>q</mi><mrow><mi>T</mi><mo>−</mo><msup><mi>t</mi><mo>′</mo></msup></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><msub><mi>t</mi><mi>k</mi></msub></msub><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle><mo>)</mo></mrow><mo fence="false" rspace="0.167em">|</mo><mi>R</mi><mrow><mo stretchy="false">(</mo><mi>y</mi><mo>,</mo><msub><mi>x</mi><msub><mi>t</mi><mi>k</mi></msub></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\lesssim(t-t_{k})\mathbb{E}_{x_{t_{k}}\sim\mathchoice{\mkern 3.0mu\reflectbox{$\displaystyle\vec{\reflectbox{$\mkern-3.0mu\displaystyle q\mkern 3.0mu$}}$}\mkern-3.0mu}{\mkern 3.0mu\reflectbox{$\textstyle\vec{\reflectbox{$\mkern-3.0mu\textstyle q\mkern 3.0mu$}}$}\mkern-3.0mu}{\mkern 2.0mu\reflectbox{$\scriptstyle\vec{\reflectbox{$\mkern-2.0mu\scriptstyle q\mkern 2.0mu$}}$}\mkern-2.0mu}{\mkern 2.0mu\reflectbox{$\scriptscriptstyle\vec{\reflectbox{$\mkern-2.0mu\scriptscriptstyle q\mkern 2.0mu$}}$}\mkern-2.0mu}_{t_{k}}}\sum_{y\neq x_{t_{k}}}\sup_{t^{\prime}\in(T-t_{k+1},T-t_{k}]}\left|\frac{\partial}{\partial t^{\prime}}\left(\frac{q_{T-t^{\prime}}(y)}{q_{T-t^{\prime}}(x_{t_{k}})}\right)\right|R(y,x_{t_{k}})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A5.E18"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.E18.m1" class="ltx_Math" alttext="\displaystyle\stackrel{{\scriptstyle(iv)}}{{\lesssim}}dS\frac{e^{T-t_{k+1}}}{(e^{T-t_{k+1}}-1)^{2}}(t-t_{k})," display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mover><mo>≲</mo><mrow><mo stretchy="false">(</mo><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>v</mi></mrow><mo stretchy="false">)</mo></mrow></mover><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>S</mi><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><msup><mi>e</mi><mrow><mi>T</mi><mo>−</mo><msub><mi>t</mi><mrow><mi>k</mi><mo>+</mo><mn>1</mn></mrow></msub></mrow></msup><msup><mrow><mo stretchy="false">(</mo><mrow><msup><mi>e</mi><mrow><mi>T</mi><mo>−</mo><msub><mi>t</mi><mrow><mi>k</mi><mo>+</mo><mn>1</mn></mrow></msub></mrow></msup><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>t</mi><mo>−</mo><msub><mi>t</mi><mi>k</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\stackrel{{\scriptstyle(iv)}}{{\lesssim}}dS\frac{e^{T-t_{k+1}}}{(e^{T-t_{k+1}}-1)^{2}}(t-t_{k}),</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(18)</span></td></tr></tbody>
</table>
<p id="A5.SS3.p5.2" class="ltx_p">where <math id="A5.SS3.p5.m4" class="ltx_Math" alttext="(iv)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>v</mi></mrow><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(iv)</annotation></semantics></math> follows from <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib11" title="" class="ltx_ref">13</a>, Lemma 3]</cite>.</p>
</div>
<div id="A5.SS3.p6" class="ltx_para ltx_noindent">
<p id="A5.SS3.p6.1" class="ltx_p">Now, define <math id="A5.SS3.p6.m1" class="ltx_Math" alttext="k^{*}:=\inf\left\{k:T-t_{k}\leq 1\right\}" display="inline" intent=":literal"><semantics><mrow><msup><mi>k</mi><mo>∗</mo></msup><mo rspace="0.1389em">:=</mo><mrow><mo lspace="0.1389em" rspace="0em">inf</mo><mrow><mo>{</mo><mi>k</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mrow><mi>T</mi><mo>−</mo><msub><mi>t</mi><mi>k</mi></msub></mrow><mo>≤</mo><mn>1</mn></mrow><mo>}</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">k^{*}:=\inf\left\{k:T-t_{k}\leq 1\right\}</annotation></semantics></math>.
Continuing from the above, we have</p>
<table id="A5.EGx12" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A5.Ex70"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.Ex70.m2" class="ltx_Math" alttext="\displaystyle\sum_{k=0}^{N-1}\int_{t_{k}}^{t_{k+1}}\mathbb{E}_{x_{t_{k}}\sim\mathchoice{\mkern 3.0mu\reflectbox{$\displaystyle\vec{\reflectbox{$\mkern-3.0mu\displaystyle q\mkern 3.0mu$}}$}\mkern-3.0mu}{\mkern 3.0mu\reflectbox{$\textstyle\vec{\reflectbox{$\mkern-3.0mu\textstyle q\mkern 3.0mu$}}$}\mkern-3.0mu}{\mkern 2.0mu\reflectbox{$\scriptstyle\vec{\reflectbox{$\mkern-2.0mu\scriptstyle q\mkern 2.0mu$}}$}\mkern-2.0mu}{\mkern 2.0mu\reflectbox{$\scriptscriptstyle\vec{\reflectbox{$\mkern-2.0mu\scriptscriptstyle q\mkern 2.0mu$}}$}\mkern-2.0mu}_{t_{k}}}\left[h_{t}(x_{t_{k}})-h_{t_{k}}(x_{t_{k}})\right]\mathrm{d}t" display="inline" intent=":literal"><semantics><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>k</mi><mo>=</mo><mn>0</mn></mrow><mrow><mi>N</mi><mo>−</mo><mn>1</mn></mrow></munderover></mstyle><mrow><mstyle displaystyle="true"><msubsup><mo>∫</mo><msub><mi>t</mi><mi>k</mi></msub><msub><mi>t</mi><mrow><mi>k</mi><mo>+</mo><mn>1</mn></mrow></msub></msubsup></mstyle><mrow><msub><mi>𝔼</mi><mrow><msub><mi>x</mi><msub><mi>t</mi><mi>k</mi></msub></msub><mo rspace="0.388em">∼</mo><msub><mpadded style="width:6.5pt;height:7.1pt;vertical-align:-0.0pt;" depth="0.0pt" height="7.1pt" width="6.5pt"><mover accent="true"><mpadded style="width:1.7pt;height:2.2pt;vertical-align:-0.7pt;" depth="0.7pt" height="1.5pt" width="1.7pt"><mi mathsize="0.480em">q</mi></mpadded><mo stretchy="false">→</mo></mover></mpadded><msub><mi>t</mi><mi>k</mi></msub></msub></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><mrow><mrow><msub><mi>h</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><msub><mi>t</mi><mi>k</mi></msub></msub><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msub><mi>h</mi><msub><mi>t</mi><mi>k</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><msub><mi>t</mi><mi>k</mi></msub></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>]</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo rspace="0em">𝑑</mo><mi>t</mi></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\sum_{k=0}^{N-1}\int_{t_{k}}^{t_{k+1}}\mathbb{E}_{x_{t_{k}}\sim\mathchoice{\mkern 3.0mu\reflectbox{$\displaystyle\vec{\reflectbox{$\mkern-3.0mu\displaystyle q\mkern 3.0mu$}}$}\mkern-3.0mu}{\mkern 3.0mu\reflectbox{$\textstyle\vec{\reflectbox{$\mkern-3.0mu\textstyle q\mkern 3.0mu$}}$}\mkern-3.0mu}{\mkern 2.0mu\reflectbox{$\scriptstyle\vec{\reflectbox{$\mkern-2.0mu\scriptstyle q\mkern 2.0mu$}}$}\mkern-2.0mu}{\mkern 2.0mu\reflectbox{$\scriptscriptstyle\vec{\reflectbox{$\mkern-2.0mu\scriptscriptstyle q\mkern 2.0mu$}}$}\mkern-2.0mu}_{t_{k}}}\left[h_{t}(x_{t_{k}})-h_{t_{k}}(x_{t_{k}})\right]\mathrm{d}t</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A5.Ex71"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.Ex71.m1" class="ltx_Math" alttext="\displaystyle\lesssim dS\sum_{k=0}^{N-1}\frac{e^{T-t_{k+1}}}{(e^{T-t_{k+1}}-1)^{2}}(t_{k+1}-t_{k})^{2}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≲</mo><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>S</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>k</mi><mo>=</mo><mn>0</mn></mrow><mrow><mi>N</mi><mo>−</mo><mn>1</mn></mrow></munderover></mstyle><mrow><mstyle displaystyle="true"><mfrac><msup><mi>e</mi><mrow><mi>T</mi><mo>−</mo><msub><mi>t</mi><mrow><mi>k</mi><mo>+</mo><mn>1</mn></mrow></msub></mrow></msup><msup><mrow><mo stretchy="false">(</mo><mrow><msup><mi>e</mi><mrow><mi>T</mi><mo>−</mo><msub><mi>t</mi><mrow><mi>k</mi><mo>+</mo><mn>1</mn></mrow></msub></mrow></msup><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><msub><mi>t</mi><mrow><mi>k</mi><mo>+</mo><mn>1</mn></mrow></msub><mo>−</mo><msub><mi>t</mi><mi>k</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\lesssim dS\sum_{k=0}^{N-1}\frac{e^{T-t_{k+1}}}{(e^{T-t_{k+1}}-1)^{2}}(t_{k+1}-t_{k})^{2}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A5.Ex72"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.Ex72.m1" class="ltx_Math" alttext="\displaystyle=dS\kappa^{2}\sum_{k=0}^{k^{*}-1}\frac{e^{T-t_{k+1}}}{(e^{T-t_{k+1}}-1)^{2}}+dS\kappa^{2}\sum_{k=k^{*}}^{N-1}\frac{e^{T-t_{k+1}}}{(e^{T-t_{k+1}}-1)^{2}}(T-t_{k})^{2}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>S</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>κ</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>k</mi><mo>=</mo><mn>0</mn></mrow><mrow><msup><mi>k</mi><mo>∗</mo></msup><mo>−</mo><mn>1</mn></mrow></munderover></mstyle><mstyle displaystyle="true"><mfrac><msup><mi>e</mi><mrow><mi>T</mi><mo>−</mo><msub><mi>t</mi><mrow><mi>k</mi><mo>+</mo><mn>1</mn></mrow></msub></mrow></msup><msup><mrow><mo stretchy="false">(</mo><mrow><msup><mi>e</mi><mrow><mi>T</mi><mo>−</mo><msub><mi>t</mi><mrow><mi>k</mi><mo>+</mo><mn>1</mn></mrow></msub></mrow></msup><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mfrac></mstyle></mrow></mrow><mo>+</mo><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>S</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>κ</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>k</mi><mo>=</mo><msup><mi>k</mi><mo>∗</mo></msup></mrow><mrow><mi>N</mi><mo>−</mo><mn>1</mn></mrow></munderover></mstyle><mrow><mstyle displaystyle="true"><mfrac><msup><mi>e</mi><mrow><mi>T</mi><mo>−</mo><msub><mi>t</mi><mrow><mi>k</mi><mo>+</mo><mn>1</mn></mrow></msub></mrow></msup><msup><mrow><mo stretchy="false">(</mo><mrow><msup><mi>e</mi><mrow><mi>T</mi><mo>−</mo><msub><mi>t</mi><mrow><mi>k</mi><mo>+</mo><mn>1</mn></mrow></msub></mrow></msup><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mi>T</mi><mo>−</mo><msub><mi>t</mi><mi>k</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mrow></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=dS\kappa^{2}\sum_{k=0}^{k^{*}-1}\frac{e^{T-t_{k+1}}}{(e^{T-t_{k+1}}-1)^{2}}+dS\kappa^{2}\sum_{k=k^{*}}^{N-1}\frac{e^{T-t_{k+1}}}{(e^{T-t_{k+1}}-1)^{2}}(T-t_{k})^{2}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A5.Ex73"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.Ex73.m1" class="ltx_Math" alttext="\displaystyle\stackrel{{\scriptstyle(v)}}{{\lesssim}}dS\kappa^{2}\sum_{k=0}^{k^{*}-1}e^{-(T-t_{k+1})}+dS\kappa^{2}\sum_{k=k^{*}}^{N-1}\frac{(T-t_{k})^{2}}{(T-t_{k+1})^{2}}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mover><mo>≲</mo><mrow><mo stretchy="false">(</mo><mi>v</mi><mo stretchy="false">)</mo></mrow></mover><mrow><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>S</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>κ</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>k</mi><mo>=</mo><mn>0</mn></mrow><mrow><msup><mi>k</mi><mo>∗</mo></msup><mo>−</mo><mn>1</mn></mrow></munderover></mstyle><msup><mi>e</mi><mrow><mo>−</mo><mrow><mo stretchy="false">(</mo><mrow><mi>T</mi><mo>−</mo><msub><mi>t</mi><mrow><mi>k</mi><mo>+</mo><mn>1</mn></mrow></msub></mrow><mo stretchy="false">)</mo></mrow></mrow></msup></mrow></mrow><mo>+</mo><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>S</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>κ</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>k</mi><mo>=</mo><msup><mi>k</mi><mo>∗</mo></msup></mrow><mrow><mi>N</mi><mo>−</mo><mn>1</mn></mrow></munderover></mstyle><mstyle displaystyle="true"><mfrac><msup><mrow><mo stretchy="false">(</mo><mrow><mi>T</mi><mo>−</mo><msub><mi>t</mi><mi>k</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup><msup><mrow><mo stretchy="false">(</mo><mrow><mi>T</mi><mo>−</mo><msub><mi>t</mi><mrow><mi>k</mi><mo>+</mo><mn>1</mn></mrow></msub></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mfrac></mstyle></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\stackrel{{\scriptstyle(v)}}{{\lesssim}}dS\kappa^{2}\sum_{k=0}^{k^{*}-1}e^{-(T-t_{k+1})}+dS\kappa^{2}\sum_{k=k^{*}}^{N-1}\frac{(T-t_{k})^{2}}{(T-t_{k+1})^{2}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A5.Ex74"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.Ex74.m1" class="ltx_Math" alttext="\displaystyle\stackrel{{\scriptstyle(vi)}}{{\lesssim}}dS\kappa^{2}\sum_{k=0}^{k^{*}-1}e^{-(T-t_{k+1})}+dS\kappa\log\delta^{-1}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mover><mo>≲</mo><mrow><mo stretchy="false">(</mo><mrow><mi>v</mi><mo lspace="0em" rspace="0em">​</mo><mi>i</mi></mrow><mo stretchy="false">)</mo></mrow></mover><mrow><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>S</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>κ</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>k</mi><mo>=</mo><mn>0</mn></mrow><mrow><msup><mi>k</mi><mo>∗</mo></msup><mo>−</mo><mn>1</mn></mrow></munderover></mstyle><msup><mi>e</mi><mrow><mo>−</mo><mrow><mo stretchy="false">(</mo><mrow><mi>T</mi><mo>−</mo><msub><mi>t</mi><mrow><mi>k</mi><mo>+</mo><mn>1</mn></mrow></msub></mrow><mo stretchy="false">)</mo></mrow></mrow></msup></mrow></mrow><mo>+</mo><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>S</mi><mo lspace="0em" rspace="0em">​</mo><mi>κ</mi><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><msup><mi>δ</mi><mrow><mo>−</mo><mn>1</mn></mrow></msup></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\stackrel{{\scriptstyle(vi)}}{{\lesssim}}dS\kappa^{2}\sum_{k=0}^{k^{*}-1}e^{-(T-t_{k+1})}+dS\kappa\log\delta^{-1}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A5.E19"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.E19.m1" class="ltx_Math" alttext="\displaystyle\stackrel{{\scriptstyle(vii)}}{{\lesssim}}dS\kappa(1-e^{-T})+dS\kappa\log\delta^{-1}." display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mover><mo>≲</mo><mrow><mo stretchy="false">(</mo><mrow><mi>v</mi><mo lspace="0em" rspace="0em">​</mo><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>i</mi></mrow><mo stretchy="false">)</mo></mrow></mover><mrow><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>S</mi><mo lspace="0em" rspace="0em">​</mo><mi>κ</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msup><mi>e</mi><mrow><mo>−</mo><mi>T</mi></mrow></msup></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>S</mi><mo lspace="0em" rspace="0em">​</mo><mi>κ</mi><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><msup><mi>δ</mi><mrow><mo>−</mo><mn>1</mn></mrow></msup></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\stackrel{{\scriptstyle(vii)}}{{\lesssim}}dS\kappa(1-e^{-T})+dS\kappa\log\delta^{-1}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(19)</span></td></tr></tbody>
</table>
<p id="A5.SS3.p6.2" class="ltx_p">Here <math id="A5.SS3.p6.m2" class="ltx_Math" alttext="(v)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi>v</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(v)</annotation></semantics></math> follows because when <math id="A5.SS3.p6.m3" class="ltx_Math" alttext="z\geq 1" display="inline" intent=":literal"><semantics><mrow><mi>z</mi><mo>≥</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">z\geq 1</annotation></semantics></math>, we have <math id="A5.SS3.p6.m4" class="ltx_math_unparsed" alttext="1-e^{-z}\in[1-e^{-1},1)" display="inline" intent=":literal"><semantics><mrow><mn>1</mn><mo>−</mo><msup><mi>e</mi><mrow><mo>−</mo><mi>z</mi></mrow></msup><mo>∈</mo><mrow><mo stretchy="false">[</mo><mn>1</mn><mo>−</mo><msup><mi>e</mi><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo>,</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">1-e^{-z}\in[1-e^{-1},1)</annotation></semantics></math> and thus</p>
<table id="A5.Ex75" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A5.Ex75.m1" class="ltx_Math" alttext="\frac{e^{z}}{(e^{z}-1)^{2}}=\frac{e^{-z}}{(1-e^{-z})^{2}}\lesssim e^{-z}." display="block" intent=":literal"><semantics><mrow><mrow><mfrac><msup><mi>e</mi><mi>z</mi></msup><msup><mrow><mo stretchy="false">(</mo><mrow><msup><mi>e</mi><mi>z</mi></msup><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mfrac><mo>=</mo><mfrac><msup><mi>e</mi><mrow><mo>−</mo><mi>z</mi></mrow></msup><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msup><mi>e</mi><mrow><mo>−</mo><mi>z</mi></mrow></msup></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mfrac><mo>≲</mo><msup><mi>e</mi><mrow><mo>−</mo><mi>z</mi></mrow></msup></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\frac{e^{z}}{(e^{z}-1)^{2}}=\frac{e^{-z}}{(1-e^{-z})^{2}}\lesssim e^{-z}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A5.SS3.p6.3" class="ltx_p">For <math id="A5.SS3.p6.m5" class="ltx_Math" alttext="(vi)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mrow><mi>v</mi><mo lspace="0em" rspace="0em">​</mo><mi>i</mi></mrow><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(vi)</annotation></semantics></math>, the inequality follows because when <math id="A5.SS3.p6.m6" class="ltx_Math" alttext="k&gt;k^{*}" display="inline" intent=":literal"><semantics><mrow><mi>k</mi><mo>&gt;</mo><msup><mi>k</mi><mo>∗</mo></msup></mrow><annotation encoding="application/x-tex">k&gt;k^{*}</annotation></semantics></math>, we have <math id="A5.SS3.p6.m7" class="ltx_Math" alttext="(T-t_{k})-(T-t_{k+1})=\kappa(T-t_{k})" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>T</mi><mo>−</mo><msub><mi>t</mi><mi>k</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mo>−</mo><mrow><mo stretchy="false">(</mo><mrow><mi>T</mi><mo>−</mo><msub><mi>t</mi><mrow><mi>k</mi><mo>+</mo><mn>1</mn></mrow></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mi>κ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>T</mi><mo>−</mo><msub><mi>t</mi><mi>k</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">(T-t_{k})-(T-t_{k+1})=\kappa(T-t_{k})</annotation></semantics></math>. Also, in order to reach that <math id="A5.SS3.p6.m8" class="ltx_Math" alttext="T-t_{N}\asymp\delta" display="inline" intent=":literal"><semantics><mrow><mrow><mi>T</mi><mo>−</mo><msub><mi>t</mi><mi>N</mi></msub></mrow><mo>≍</mo><mi>δ</mi></mrow><annotation encoding="application/x-tex">T-t_{N}\asymp\delta</annotation></semantics></math> when <math id="A5.SS3.p6.m9" class="ltx_Math" alttext="T-t_{k^{*}}=1+O(\kappa)" display="inline" intent=":literal"><semantics><mrow><mrow><mi>T</mi><mo>−</mo><msub><mi>t</mi><msup><mi>k</mi><mo>∗</mo></msup></msub></mrow><mo>=</mo><mrow><mn>1</mn><mo>+</mo><mrow><mi>O</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>κ</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">T-t_{k^{*}}=1+O(\kappa)</annotation></semantics></math>, we need</p>
<table id="A5.Ex76" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A5.Ex76.m1" class="ltx_Math" alttext="N-k^{*}\asymp\log_{1-\kappa}\delta\asymp\frac{\log\delta^{-1}}{\kappa}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mi>N</mi><mo>−</mo><msup><mi>k</mi><mo>∗</mo></msup></mrow><mo>≍</mo><mrow><msub><mi>log</mi><mrow><mn>1</mn><mo>−</mo><mi>κ</mi></mrow></msub><mo lspace="0.167em">⁡</mo><mi>δ</mi></mrow><mo>≍</mo><mfrac><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><msup><mi>δ</mi><mrow><mo>−</mo><mn>1</mn></mrow></msup></mrow><mi>κ</mi></mfrac></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">N-k^{*}\asymp\log_{1-\kappa}\delta\asymp\frac{\log\delta^{-1}}{\kappa}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A5.SS3.p6.4" class="ltx_p">For <math id="A5.SS3.p6.m10" class="ltx_Math" alttext="(vii)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mrow><mi>v</mi><mo lspace="0em" rspace="0em">​</mo><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>i</mi></mrow><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(vii)</annotation></semantics></math>, it follows because</p>
<table id="A5.Ex77" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A5.Ex77.m1" class="ltx_Math" alttext="\kappa\sum_{k=0}^{k^{*}-1}e^{-(T-t_{k+1})}=\int_{1}^{T}e^{-z}\mathrm{d}z(1+O(\kappa))\lesssim 1-e^{-T}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mi>κ</mi><mo lspace="0em" rspace="0em">​</mo><mrow><munderover><mo movablelimits="false">∑</mo><mrow><mi>k</mi><mo>=</mo><mn>0</mn></mrow><mrow><msup><mi>k</mi><mo>∗</mo></msup><mo>−</mo><mn>1</mn></mrow></munderover><msup><mi>e</mi><mrow><mo>−</mo><mrow><mo stretchy="false">(</mo><mrow><mi>T</mi><mo>−</mo><msub><mi>t</mi><mrow><mi>k</mi><mo>+</mo><mn>1</mn></mrow></msub></mrow><mo stretchy="false">)</mo></mrow></mrow></msup></mrow></mrow><mo rspace="0.111em">=</mo><mrow><msubsup><mo>∫</mo><mn>1</mn><mi>T</mi></msubsup><mrow><msup><mi>e</mi><mrow><mo>−</mo><mi>z</mi></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo rspace="0em">𝑑</mo><mi>z</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><mrow><mi>O</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>κ</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>≲</mo><mrow><mn>1</mn><mo>−</mo><msup><mi>e</mi><mrow><mo>−</mo><mi>T</mi></mrow></msup></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\kappa\sum_{k=0}^{k^{*}-1}e^{-(T-t_{k+1})}=\int_{1}^{T}e^{-z}\mathrm{d}z(1+O(\kappa))\lesssim 1-e^{-T}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="A5.SS3.p7" class="ltx_para ltx_noindent">
<p id="A5.SS3.p7.1" class="ltx_p">Therefore,</p>
<table id="A5.EGx13" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A5.Ex78"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.Ex78.m1" class="ltx_Math" alttext="\displaystyle\mathrm{TV}(\mathchoice{\mkern 3.0mu\reflectbox{$\displaystyle\vec{\reflectbox{$\mkern-3.0mu\displaystyle q\mkern 3.0mu$}}$}\mkern-3.0mu}{\mkern 3.0mu\reflectbox{$\textstyle\vec{\reflectbox{$\mkern-3.0mu\textstyle q\mkern 3.0mu$}}$}\mkern-3.0mu}{\mkern 2.0mu\reflectbox{$\scriptstyle\vec{\reflectbox{$\mkern-2.0mu\scriptstyle q\mkern 2.0mu$}}$}\mkern-2.0mu}{\mkern 2.0mu\reflectbox{$\scriptscriptstyle\vec{\reflectbox{$\mkern-2.0mu\scriptscriptstyle q\mkern 2.0mu$}}$}\mkern-2.0mu}_{T-\delta},p_{T-\delta})" display="inline" intent=":literal"><semantics><mrow><mi>TV</mi><mo>⁡</mo><mrow><mo rspace="0.170em" stretchy="false">(</mo><msub><mpadded style="width:6.5pt;height:7.1pt;vertical-align:-0.0pt;" depth="0.0pt" height="7.1pt" width="6.5pt"><mover accent="true"><mpadded style="width:4.8pt;height:6.199999999999999pt;vertical-align:-1.9pt;" depth="1.9pt" height="4.3pt" width="4.8pt"><mi>q</mi></mpadded><mo stretchy="false">→</mo></mover></mpadded><mrow><mi>T</mi><mo>−</mo><mi>δ</mi></mrow></msub><mo>,</mo><msub><mi>p</mi><mrow><mi>T</mi><mo>−</mo><mi>δ</mi></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\mathrm{TV}(\mathchoice{\mkern 3.0mu\reflectbox{$\displaystyle\vec{\reflectbox{$\mkern-3.0mu\displaystyle q\mkern 3.0mu$}}$}\mkern-3.0mu}{\mkern 3.0mu\reflectbox{$\textstyle\vec{\reflectbox{$\mkern-3.0mu\textstyle q\mkern 3.0mu$}}$}\mkern-3.0mu}{\mkern 2.0mu\reflectbox{$\scriptstyle\vec{\reflectbox{$\mkern-2.0mu\scriptstyle q\mkern 2.0mu$}}$}\mkern-2.0mu}{\mkern 2.0mu\reflectbox{$\scriptscriptstyle\vec{\reflectbox{$\mkern-2.0mu\scriptscriptstyle q\mkern 2.0mu$}}$}\mkern-2.0mu}_{T-\delta},p_{T-\delta})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A5.Ex79"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.Ex79.m1" class="ltx_math_unparsed" alttext="\displaystyle\lesssim\sqrt{d\log S}\cdot e^{-T/2}+\sqrt{\varepsilon_{\text{score-tv}}}+d^{2}S\sum_{k=0}^{N-1}\max\{1,(T-t_{k+1})^{-2}\}(t_{k+1}-t_{k})^{2}" display="inline" intent=":literal"><semantics><mrow><mo>≲</mo><msqrt><mrow><mi>d</mi><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mi>S</mi></mrow></mrow></msqrt><mo lspace="0.222em" rspace="0.222em">⋅</mo><msup><mi>e</mi><mrow><mo>−</mo><mi>T</mi><mo>/</mo><mn>2</mn></mrow></msup><mo>+</mo><msqrt><msub><mi>ε</mi><mtext>score-tv</mtext></msub></msqrt><mo>+</mo><msup><mi>d</mi><mn>2</mn></msup><mi>S</mi><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>k</mi><mo>=</mo><mn>0</mn></mrow><mrow><mi>N</mi><mo>−</mo><mn>1</mn></mrow></munderover></mstyle><mi>max</mi><mrow><mo stretchy="false">{</mo><mn>1</mn><mo>,</mo><msup><mrow><mo stretchy="false">(</mo><mi>T</mi><mo>−</mo><msub><mi>t</mi><mrow><mi>k</mi><mo>+</mo><mn>1</mn></mrow></msub><mo stretchy="false">)</mo></mrow><mrow><mo>−</mo><mn>2</mn></mrow></msup><mo stretchy="false">}</mo></mrow><msup><mrow><mo stretchy="false">(</mo><msub><mi>t</mi><mrow><mi>k</mi><mo>+</mo><mn>1</mn></mrow></msub><mo>−</mo><msub><mi>t</mi><mi>k</mi></msub><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mrow><annotation encoding="application/x-tex">\displaystyle\lesssim\sqrt{d\log S}\cdot e^{-T/2}+\sqrt{\varepsilon_{\text{score-tv}}}+d^{2}S\sum_{k=0}^{N-1}\max\{1,(T-t_{k+1})^{-2}\}(t_{k+1}-t_{k})^{2}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A5.Ex80"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.Ex80.m1" class="ltx_math_unparsed" alttext="\displaystyle\lesssim\sqrt{d\log S}\cdot e^{-T/2}+\sqrt{\varepsilon_{\text{score-tv}}}+\kappa d^{2}S(T+\log\delta^{-1})," display="inline" intent=":literal"><semantics><mrow><mo>≲</mo><msqrt><mrow><mi>d</mi><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mi>S</mi></mrow></mrow></msqrt><mo lspace="0.222em" rspace="0.222em">⋅</mo><msup><mi>e</mi><mrow><mo>−</mo><mi>T</mi><mo>/</mo><mn>2</mn></mrow></msup><mo>+</mo><msqrt><msub><mi>ε</mi><mtext>score-tv</mtext></msub></msqrt><mo>+</mo><mi>κ</mi><msup><mi>d</mi><mn>2</mn></msup><mi>S</mi><mrow><mo stretchy="false">(</mo><mi>T</mi><mo>+</mo><mi>log</mi><msup><mi>δ</mi><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo stretchy="false">)</mo></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\lesssim\sqrt{d\log S}\cdot e^{-T/2}+\sqrt{\varepsilon_{\text{score-tv}}}+\kappa d^{2}S(T+\log\delta^{-1}),</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A5.SS3.p7.2" class="ltx_p">where the last line follows from <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib34" title="" class="ltx_ref">36</a>, Lemma 18]</cite>.
Finally, note that as <math id="A5.SS3.p7.m1" class="ltx_Math" alttext="\delta\to 0" display="inline" intent=":literal"><semantics><mrow><mi>δ</mi><mo stretchy="false">→</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\delta\to 0</annotation></semantics></math>, (cf. Theorem 6 of <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib29" title="" class="ltx_ref">16</a>]</cite>)</p>
<table id="A5.Ex81" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A5.Ex81.m1" class="ltx_Math" alttext="\mathrm{TV}(\mathchoice{\mkern 3.0mu\reflectbox{$\displaystyle\vec{\reflectbox{$\mkern-3.0mu\displaystyle q\mkern 3.0mu$}}$}\mkern-3.0mu}{\mkern 3.0mu\reflectbox{$\textstyle\vec{\reflectbox{$\mkern-3.0mu\textstyle q\mkern 3.0mu$}}$}\mkern-3.0mu}{\mkern 2.0mu\reflectbox{$\scriptstyle\vec{\reflectbox{$\mkern-2.0mu\scriptstyle q\mkern 2.0mu$}}$}\mkern-2.0mu}{\mkern 2.0mu\reflectbox{$\scriptscriptstyle\vec{\reflectbox{$\mkern-2.0mu\scriptscriptstyle q\mkern 2.0mu$}}$}\mkern-2.0mu}_{T-\delta},q_{0})\lesssim d\delta." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mi>TV</mi><mo>⁡</mo><mrow><mo rspace="0.170em" stretchy="false">(</mo><msub><mpadded style="width:6.5pt;height:7.1pt;vertical-align:-0.0pt;" depth="0.0pt" height="7.1pt" width="6.5pt"><mover accent="true"><mpadded style="width:4.8pt;height:6.199999999999999pt;vertical-align:-1.9pt;" depth="1.9pt" height="4.3pt" width="4.8pt"><mi>q</mi></mpadded><mo stretchy="false">→</mo></mover></mpadded><mrow><mi>T</mi><mo>−</mo><mi>δ</mi></mrow></msub><mo>,</mo><msub><mi>q</mi><mn>0</mn></msub><mo stretchy="false">)</mo></mrow></mrow><mo>≲</mo><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>δ</mi></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\mathrm{TV}(\mathchoice{\mkern 3.0mu\reflectbox{$\displaystyle\vec{\reflectbox{$\mkern-3.0mu\displaystyle q\mkern 3.0mu$}}$}\mkern-3.0mu}{\mkern 3.0mu\reflectbox{$\textstyle\vec{\reflectbox{$\mkern-3.0mu\textstyle q\mkern 3.0mu$}}$}\mkern-3.0mu}{\mkern 2.0mu\reflectbox{$\scriptstyle\vec{\reflectbox{$\mkern-2.0mu\scriptstyle q\mkern 2.0mu$}}$}\mkern-2.0mu}{\mkern 2.0mu\reflectbox{$\scriptscriptstyle\vec{\reflectbox{$\mkern-2.0mu\scriptscriptstyle q\mkern 2.0mu$}}$}\mkern-2.0mu}_{T-\delta},q_{0})\lesssim d\delta.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A5.SS3.p7.3" class="ltx_p">The proof is now complete.</p>
</div>
</section>
</section>
<section id="A6" class="ltx_appendix">
<h2 class="ltx_title ltx_title_appendix"><span class="ltx_tag ltx_tag_appendix">Appendix F </span>Proof of <a href="#Thmcorollary1" title="Corollary 1. ‣ 3.2 Convergence Upper Bound for the Euler Method ‣ 3 Convergence Guarantees for the Euler Method ‣ Sharp Convergence Rates for Masked Diffusion Models" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Corollary</span> <span class="ltx_text ltx_ref_tag">1</span></a></h2>

<div id="A6.p1" class="ltx_para ltx_noindent">
<p id="A6.p1.1" class="ltx_p">We write <math id="A6.p1.m1" class="ltx_Math" alttext="\gamma" display="inline" intent=":literal"><semantics><mi>γ</mi><annotation encoding="application/x-tex">\gamma</annotation></semantics></math> for <math id="A6.p1.m2" class="ltx_Math" alttext="\gamma(q_{0})" display="inline" intent=":literal"><semantics><mrow><mi>γ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>q</mi><mn>0</mn></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\gamma(q_{0})</annotation></semantics></math> as a shorthand. The only difference is to obtain a modified upper bound on the discretization error in (<a href="#A5.Ex53" title="In E.1 Step 1: Decompose total error ‣ Appendix E Proof of ‣ Sharp Convergence Rates for Masked Diffusion Models" class="ltx_ref"><span class="ltx_text ltx_ref_tag">15</span></a>).
Similarly continuing from (<a href="#A5.Ex63" title="In E.3 Step 3: Upper-bound discretization error ‣ Appendix E Proof of ‣ Sharp Convergence Rates for Masked Diffusion Models" class="ltx_ref"><span class="ltx_text ltx_ref_tag">17</span></a>), with the <math id="A6.p1.m3" class="ltx_Math" alttext="\gamma" display="inline" intent=":literal"><semantics><mi>γ</mi><annotation encoding="application/x-tex">\gamma</annotation></semantics></math> as defined, we have</p>
<table id="A6.EGx14" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A6.Ex82"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A6.Ex82.m2" class="ltx_Math" alttext="\displaystyle\mathbb{E}_{x_{t_{k}}\sim\mathchoice{\mkern 3.0mu\reflectbox{$\displaystyle\vec{\reflectbox{$\mkern-3.0mu\displaystyle q\mkern 3.0mu$}}$}\mkern-3.0mu}{\mkern 3.0mu\reflectbox{$\textstyle\vec{\reflectbox{$\mkern-3.0mu\textstyle q\mkern 3.0mu$}}$}\mkern-3.0mu}{\mkern 2.0mu\reflectbox{$\scriptstyle\vec{\reflectbox{$\mkern-2.0mu\scriptstyle q\mkern 2.0mu$}}$}\mkern-2.0mu}{\mkern 2.0mu\reflectbox{$\scriptscriptstyle\vec{\reflectbox{$\mkern-2.0mu\scriptscriptstyle q\mkern 2.0mu$}}$}\mkern-2.0mu}_{t_{k}}}\left[h_{t}(x_{t_{k}})-h_{t_{k}}(x_{t_{k}})\right]" display="inline" intent=":literal"><semantics><mrow><msub><mi>𝔼</mi><mrow><msub><mi>x</mi><msub><mi>t</mi><mi>k</mi></msub></msub><mo rspace="0.388em">∼</mo><msub><mpadded style="width:6.5pt;height:7.1pt;vertical-align:-0.0pt;" depth="0.0pt" height="7.1pt" width="6.5pt"><mover accent="true"><mpadded style="width:1.7pt;height:2.2pt;vertical-align:-0.7pt;" depth="0.7pt" height="1.5pt" width="1.7pt"><mi mathsize="0.480em">q</mi></mpadded><mo stretchy="false">→</mo></mover></mpadded><msub><mi>t</mi><mi>k</mi></msub></msub></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><mrow><mrow><msub><mi>h</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><msub><mi>t</mi><mi>k</mi></msub></msub><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msub><mi>h</mi><msub><mi>t</mi><mi>k</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><msub><mi>t</mi><mi>k</mi></msub></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>]</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\mathbb{E}_{x_{t_{k}}\sim\mathchoice{\mkern 3.0mu\reflectbox{$\displaystyle\vec{\reflectbox{$\mkern-3.0mu\displaystyle q\mkern 3.0mu$}}$}\mkern-3.0mu}{\mkern 3.0mu\reflectbox{$\textstyle\vec{\reflectbox{$\mkern-3.0mu\textstyle q\mkern 3.0mu$}}$}\mkern-3.0mu}{\mkern 2.0mu\reflectbox{$\scriptstyle\vec{\reflectbox{$\mkern-2.0mu\scriptstyle q\mkern 2.0mu$}}$}\mkern-2.0mu}{\mkern 2.0mu\reflectbox{$\scriptscriptstyle\vec{\reflectbox{$\mkern-2.0mu\scriptscriptstyle q\mkern 2.0mu$}}$}\mkern-2.0mu}_{t_{k}}}\left[h_{t}(x_{t_{k}})-h_{t_{k}}(x_{t_{k}})\right]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A6.Ex83"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A6.Ex83.m1" class="ltx_math_unparsed" alttext="\displaystyle\lesssim(t-t_{k})\mathbb{E}_{x_{t_{k}}\sim\mathchoice{\mkern 3.0mu\reflectbox{$\displaystyle\vec{\reflectbox{$\mkern-3.0mu\displaystyle q\mkern 3.0mu$}}$}\mkern-3.0mu}{\mkern 3.0mu\reflectbox{$\textstyle\vec{\reflectbox{$\mkern-3.0mu\textstyle q\mkern 3.0mu$}}$}\mkern-3.0mu}{\mkern 2.0mu\reflectbox{$\scriptstyle\vec{\reflectbox{$\mkern-2.0mu\scriptstyle q\mkern 2.0mu$}}$}\mkern-2.0mu}{\mkern 2.0mu\reflectbox{$\scriptscriptstyle\vec{\reflectbox{$\mkern-2.0mu\scriptscriptstyle q\mkern 2.0mu$}}$}\mkern-2.0mu}_{t_{k}}}\sum_{y\neq x_{t_{k}}}\sup_{t^{\prime}\in(T-t_{k+1},T-t_{k}]}\left|\frac{\partial}{\partial t^{\prime}}\left(\frac{q_{T-t^{\prime}}(y)}{q_{T-t^{\prime}}(x_{t_{k}})}\right)\right|R(y,x_{t_{k}})" display="inline" intent=":literal"><semantics><mrow><mo>≲</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo>−</mo><msub><mi>t</mi><mi>k</mi></msub><mo stretchy="false">)</mo></mrow><msub><mi>𝔼</mi><mrow><msub><mi>x</mi><msub><mi>t</mi><mi>k</mi></msub></msub><mo rspace="0.388em">∼</mo><msub><mpadded style="width:6.5pt;height:7.1pt;vertical-align:-0.0pt;" depth="0.0pt" height="7.1pt" width="6.5pt"><mover accent="true"><mpadded style="width:1.7pt;height:2.2pt;vertical-align:-0.7pt;" depth="0.7pt" height="1.5pt" width="1.7pt"><mi mathsize="0.480em">q</mi></mpadded><mo stretchy="false">→</mo></mover></mpadded><msub><mi>t</mi><mi>k</mi></msub></msub></mrow></msub><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mi>y</mi><mo>≠</mo><msub><mi>x</mi><msub><mi>t</mi><mi>k</mi></msub></msub></mrow></munder></mstyle><munder><mo lspace="0.167em" movablelimits="false" rspace="0em">sup</mo><mrow><mi>t</mi><msup><mrow></mrow><mo>′</mo></msup><mo>∈</mo><mo stretchy="false">(</mo><mi>T</mi><mo>−</mo><mi>t</mi><msub><mrow></mrow><mrow><mi>k</mi><mo>+</mo><mn>1</mn></mrow></msub><mo>,</mo><mi>T</mi><mo>−</mo><mi>t</mi><msub><mrow></mrow><mi>k</mi></msub><mo stretchy="false">]</mo></mrow></munder><mo fence="false" rspace="0.167em">|</mo><mstyle displaystyle="true"><mfrac><mo>∂</mo><mrow><mo>∂</mo><msup><mi>t</mi><mo>′</mo></msup></mrow></mfrac></mstyle><mrow><mo>(</mo><mstyle displaystyle="true"><mfrac><mrow><msub><mi>q</mi><mrow><mi>T</mi><mo>−</mo><msup><mi>t</mi><mo>′</mo></msup></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>y</mi><mo stretchy="false">)</mo></mrow></mrow><mrow><msub><mi>q</mi><mrow><mi>T</mi><mo>−</mo><msup><mi>t</mi><mo>′</mo></msup></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><msub><mi>t</mi><mi>k</mi></msub></msub><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle><mo>)</mo></mrow><mo fence="false" rspace="0.167em">|</mo><mi>R</mi><mrow><mo stretchy="false">(</mo><mi>y</mi><mo>,</mo><msub><mi>x</mi><msub><mi>t</mi><mi>k</mi></msub></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\lesssim(t-t_{k})\mathbb{E}_{x_{t_{k}}\sim\mathchoice{\mkern 3.0mu\reflectbox{$\displaystyle\vec{\reflectbox{$\mkern-3.0mu\displaystyle q\mkern 3.0mu$}}$}\mkern-3.0mu}{\mkern 3.0mu\reflectbox{$\textstyle\vec{\reflectbox{$\mkern-3.0mu\textstyle q\mkern 3.0mu$}}$}\mkern-3.0mu}{\mkern 2.0mu\reflectbox{$\scriptstyle\vec{\reflectbox{$\mkern-2.0mu\scriptstyle q\mkern 2.0mu$}}$}\mkern-2.0mu}{\mkern 2.0mu\reflectbox{$\scriptscriptstyle\vec{\reflectbox{$\mkern-2.0mu\scriptscriptstyle q\mkern 2.0mu$}}$}\mkern-2.0mu}_{t_{k}}}\sum_{y\neq x_{t_{k}}}\sup_{t^{\prime}\in(T-t_{k+1},T-t_{k}]}\left|\frac{\partial}{\partial t^{\prime}}\left(\frac{q_{T-t^{\prime}}(y)}{q_{T-t^{\prime}}(x_{t_{k}})}\right)\right|R(y,x_{t_{k}})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A6.E20"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A6.E20.m1" class="ltx_Math" alttext="\displaystyle\stackrel{{\scriptstyle(i)}}{{\lesssim}}dS\min\left\{\frac{e^{T-t_{k+1}}}{(e^{T-t_{k+1}}-1)^{2}},\gamma^{-1}\right\}(t-t_{k})," display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mover><mo>≲</mo><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></mover><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>S</mi><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>min</mi><mo>⁡</mo><mrow><mo>{</mo><mstyle displaystyle="true"><mfrac><msup><mi>e</mi><mrow><mi>T</mi><mo>−</mo><msub><mi>t</mi><mrow><mi>k</mi><mo>+</mo><mn>1</mn></mrow></msub></mrow></msup><msup><mrow><mo stretchy="false">(</mo><mrow><msup><mi>e</mi><mrow><mi>T</mi><mo>−</mo><msub><mi>t</mi><mrow><mi>k</mi><mo>+</mo><mn>1</mn></mrow></msub></mrow></msup><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mfrac></mstyle><mo>,</mo><msup><mi>γ</mi><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo>}</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>t</mi><mo>−</mo><msub><mi>t</mi><mi>k</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\stackrel{{\scriptstyle(i)}}{{\lesssim}}dS\min\left\{\frac{e^{T-t_{k+1}}}{(e^{T-t_{k+1}}-1)^{2}},\gamma^{-1}\right\}(t-t_{k}),</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(20)</span></td></tr></tbody>
</table>
<p id="A6.p1.2" class="ltx_p">where <math id="A6.p1.m4" class="ltx_Math" alttext="(i)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(i)</annotation></semantics></math> follows from Lemma 7 of <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib11" title="" class="ltx_ref">13</a>, Lemma 7]</cite>. Note that <math id="A6.p1.m5" class="ltx_Math" alttext="\frac{e^{z}}{(e^{z}-1)^{2}}" display="inline" intent=":literal"><semantics><mfrac><msup><mi>e</mi><mi>z</mi></msup><msup><mrow><mo stretchy="false">(</mo><mrow><msup><mi>e</mi><mi>z</mi></msup><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mfrac><annotation encoding="application/x-tex">\frac{e^{z}}{(e^{z}-1)^{2}}</annotation></semantics></math> is monotonically decreasing. Define <math id="A6.p1.m6" class="ltx_Math" alttext="k^{*}:=\inf\left\{k:\frac{e^{T-t_{k+1}}}{(e^{T-t_{k+1}}-1)^{2}}\geq\gamma^{-1}\right\}" display="inline" intent=":literal"><semantics><mrow><msup><mi>k</mi><mo>∗</mo></msup><mo rspace="0.1389em">:=</mo><mrow><mo lspace="0.1389em" rspace="0em">inf</mo><mrow><mo>{</mo><mi>k</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mfrac><msup><mi>e</mi><mrow><mi>T</mi><mo>−</mo><msub><mi>t</mi><mrow><mi>k</mi><mo>+</mo><mn>1</mn></mrow></msub></mrow></msup><msup><mrow><mo stretchy="false">(</mo><mrow><msup><mi>e</mi><mrow><mi>T</mi><mo>−</mo><msub><mi>t</mi><mrow><mi>k</mi><mo>+</mo><mn>1</mn></mrow></msub></mrow></msup><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mfrac><mo>≥</mo><msup><mi>γ</mi><mrow><mo>−</mo><mn>1</mn></mrow></msup></mrow><mo>}</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">k^{*}:=\inf\left\{k:\frac{e^{T-t_{k+1}}}{(e^{T-t_{k+1}}-1)^{2}}\geq\gamma^{-1}\right\}</annotation></semantics></math>. Below, we have a slightly different upper bound for the dominant term of the discretization error:</p>
<table id="A6.EGx15" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A6.Ex84"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A6.Ex84.m1" class="ltx_Math" alttext="\displaystyle\sum_{k=0}^{N-1}\int_{t_{k}}^{t_{k+1}}\mathbb{E}_{x_{t_{k}}\sim\mathchoice{\mkern 3.0mu\reflectbox{$\displaystyle\vec{\reflectbox{$\mkern-3.0mu\displaystyle q\mkern 3.0mu$}}$}\mkern-3.0mu}{\mkern 3.0mu\reflectbox{$\textstyle\vec{\reflectbox{$\mkern-3.0mu\textstyle q\mkern 3.0mu$}}$}\mkern-3.0mu}{\mkern 2.0mu\reflectbox{$\scriptstyle\vec{\reflectbox{$\mkern-2.0mu\scriptstyle q\mkern 2.0mu$}}$}\mkern-2.0mu}{\mkern 2.0mu\reflectbox{$\scriptscriptstyle\vec{\reflectbox{$\mkern-2.0mu\scriptscriptstyle q\mkern 2.0mu$}}$}\mkern-2.0mu}_{t_{k}}}\left[h_{t}(x_{t_{k}})-h_{t_{k}}(x_{t_{k}})\right]\mathrm{d}t" display="inline" intent=":literal"><semantics><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>k</mi><mo>=</mo><mn>0</mn></mrow><mrow><mi>N</mi><mo>−</mo><mn>1</mn></mrow></munderover></mstyle><mrow><mstyle displaystyle="true"><msubsup><mo>∫</mo><msub><mi>t</mi><mi>k</mi></msub><msub><mi>t</mi><mrow><mi>k</mi><mo>+</mo><mn>1</mn></mrow></msub></msubsup></mstyle><mrow><msub><mi>𝔼</mi><mrow><msub><mi>x</mi><msub><mi>t</mi><mi>k</mi></msub></msub><mo rspace="0.388em">∼</mo><msub><mpadded style="width:6.5pt;height:7.1pt;vertical-align:-0.0pt;" depth="0.0pt" height="7.1pt" width="6.5pt"><mover accent="true"><mpadded style="width:1.7pt;height:2.2pt;vertical-align:-0.7pt;" depth="0.7pt" height="1.5pt" width="1.7pt"><mi mathsize="0.480em">q</mi></mpadded><mo stretchy="false">→</mo></mover></mpadded><msub><mi>t</mi><mi>k</mi></msub></msub></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><mrow><mrow><msub><mi>h</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><msub><mi>t</mi><mi>k</mi></msub></msub><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msub><mi>h</mi><msub><mi>t</mi><mi>k</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><msub><mi>t</mi><mi>k</mi></msub></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>]</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo rspace="0em">𝑑</mo><mi>t</mi></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\sum_{k=0}^{N-1}\int_{t_{k}}^{t_{k+1}}\mathbb{E}_{x_{t_{k}}\sim\mathchoice{\mkern 3.0mu\reflectbox{$\displaystyle\vec{\reflectbox{$\mkern-3.0mu\displaystyle q\mkern 3.0mu$}}$}\mkern-3.0mu}{\mkern 3.0mu\reflectbox{$\textstyle\vec{\reflectbox{$\mkern-3.0mu\textstyle q\mkern 3.0mu$}}$}\mkern-3.0mu}{\mkern 2.0mu\reflectbox{$\scriptstyle\vec{\reflectbox{$\mkern-2.0mu\scriptstyle q\mkern 2.0mu$}}$}\mkern-2.0mu}{\mkern 2.0mu\reflectbox{$\scriptscriptstyle\vec{\reflectbox{$\mkern-2.0mu\scriptscriptstyle q\mkern 2.0mu$}}$}\mkern-2.0mu}_{t_{k}}}\left[h_{t}(x_{t_{k}})-h_{t_{k}}(x_{t_{k}})\right]\mathrm{d}t</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A6.Ex85"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A6.Ex85.m1" class="ltx_Math" alttext="\displaystyle\lesssim dS\sum_{k=0}^{N-1}\min\left\{\frac{e^{T-t_{k+1}}}{(e^{T-t_{k+1}}-1)^{2}},\gamma^{-1}\right\}(t_{k+1}-t_{k})^{2}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≲</mo><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>S</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>k</mi><mo>=</mo><mn>0</mn></mrow><mrow><mi>N</mi><mo>−</mo><mn>1</mn></mrow></munderover></mstyle><mrow><mi>min</mi><mo>⁡</mo><mrow><mrow><mo>{</mo><mstyle displaystyle="true"><mfrac><msup><mi>e</mi><mrow><mi>T</mi><mo>−</mo><msub><mi>t</mi><mrow><mi>k</mi><mo>+</mo><mn>1</mn></mrow></msub></mrow></msup><msup><mrow><mo stretchy="false">(</mo><mrow><msup><mi>e</mi><mrow><mi>T</mi><mo>−</mo><msub><mi>t</mi><mrow><mi>k</mi><mo>+</mo><mn>1</mn></mrow></msub></mrow></msup><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mfrac></mstyle><mo>,</mo><msup><mi>γ</mi><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo>}</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><msub><mi>t</mi><mrow><mi>k</mi><mo>+</mo><mn>1</mn></mrow></msub><mo>−</mo><msub><mi>t</mi><mi>k</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mrow></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\lesssim dS\sum_{k=0}^{N-1}\min\left\{\frac{e^{T-t_{k+1}}}{(e^{T-t_{k+1}}-1)^{2}},\gamma^{-1}\right\}(t_{k+1}-t_{k})^{2}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A6.Ex86"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A6.Ex86.m1" class="ltx_Math" alttext="\displaystyle=dS\kappa^{2}\sum_{k=0}^{k^{*}-1}\frac{e^{T-t_{k+1}}}{(e^{T-t_{k+1}}-1)^{2}}+dS\kappa^{2}\gamma^{-1}(N-k^{*})" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>S</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>κ</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>k</mi><mo>=</mo><mn>0</mn></mrow><mrow><msup><mi>k</mi><mo>∗</mo></msup><mo>−</mo><mn>1</mn></mrow></munderover></mstyle><mstyle displaystyle="true"><mfrac><msup><mi>e</mi><mrow><mi>T</mi><mo>−</mo><msub><mi>t</mi><mrow><mi>k</mi><mo>+</mo><mn>1</mn></mrow></msub></mrow></msup><msup><mrow><mo stretchy="false">(</mo><mrow><msup><mi>e</mi><mrow><mi>T</mi><mo>−</mo><msub><mi>t</mi><mrow><mi>k</mi><mo>+</mo><mn>1</mn></mrow></msub></mrow></msup><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mfrac></mstyle></mrow></mrow><mo>+</mo><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>S</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>κ</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>γ</mi><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>N</mi><mo>−</mo><msup><mi>k</mi><mo>∗</mo></msup></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=dS\kappa^{2}\sum_{k=0}^{k^{*}-1}\frac{e^{T-t_{k+1}}}{(e^{T-t_{k+1}}-1)^{2}}+dS\kappa^{2}\gamma^{-1}(N-k^{*})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A6.Ex87"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A6.Ex87.m1" class="ltx_Math" alttext="\displaystyle\stackrel{{\scriptstyle(ii)}}{{\lesssim}}dS\kappa(1-e^{-T})+dS\kappa^{2}\gamma^{-1}(N-k^{*})" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mover><mo>≲</mo><mrow><mo stretchy="false">(</mo><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>i</mi></mrow><mo stretchy="false">)</mo></mrow></mover><mrow><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>S</mi><mo lspace="0em" rspace="0em">​</mo><mi>κ</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msup><mi>e</mi><mrow><mo>−</mo><mi>T</mi></mrow></msup></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>S</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>κ</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>γ</mi><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>N</mi><mo>−</mo><msup><mi>k</mi><mo>∗</mo></msup></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\stackrel{{\scriptstyle(ii)}}{{\lesssim}}dS\kappa(1-e^{-T})+dS\kappa^{2}\gamma^{-1}(N-k^{*})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A6.Ex88"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A6.Ex88.m1" class="ltx_Math" alttext="\displaystyle\stackrel{{\scriptstyle(iii)}}{{\leq}}dS\kappa(1-e^{-T})+dS\kappa\gamma^{-\frac{1}{2}}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mover><mo>≤</mo><mrow><mo stretchy="false">(</mo><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>i</mi></mrow><mo stretchy="false">)</mo></mrow></mover><mrow><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>S</mi><mo lspace="0em" rspace="0em">​</mo><mi>κ</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msup><mi>e</mi><mrow><mo>−</mo><mi>T</mi></mrow></msup></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>S</mi><mo lspace="0em" rspace="0em">​</mo><mi>κ</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>γ</mi><mrow><mo>−</mo><mfrac><mn>1</mn><mn>2</mn></mfrac></mrow></msup></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\stackrel{{\scriptstyle(iii)}}{{\leq}}dS\kappa(1-e^{-T})+dS\kappa\gamma^{-\frac{1}{2}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A6.p1.3" class="ltx_p">where <math id="A6.p1.m7" class="ltx_Math" alttext="(ii)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>i</mi></mrow><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(ii)</annotation></semantics></math> follows similarly from <math id="A6.p1.m8" class="ltx_Math" alttext="(v)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi>v</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(v)</annotation></semantics></math> in (<a href="#A5.Ex70" title="In E.3 Step 3: Upper-bound discretization error ‣ Appendix E Proof of ‣ Sharp Convergence Rates for Masked Diffusion Models" class="ltx_ref"><span class="ltx_text ltx_ref_tag">19</span></a>), and <math id="A6.p1.m9" class="ltx_Math" alttext="(iii)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>i</mi></mrow><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(iii)</annotation></semantics></math> is because of the following. With the defined <math id="A6.p1.m10" class="ltx_Math" alttext="k^{*}" display="inline" intent=":literal"><semantics><msup><mi>k</mi><mo>∗</mo></msup><annotation encoding="application/x-tex">k^{*}</annotation></semantics></math> and for small <math id="A6.p1.m11" class="ltx_Math" alttext="\gamma" display="inline" intent=":literal"><semantics><mi>γ</mi><annotation encoding="application/x-tex">\gamma</annotation></semantics></math>, since <math id="A6.p1.m12" class="ltx_Math" alttext="\frac{e^{z}}{(e^{z}-1)^{2}}\approx z^{-2}" display="inline" intent=":literal"><semantics><mrow><mfrac><msup><mi>e</mi><mi>z</mi></msup><msup><mrow><mo stretchy="false">(</mo><mrow><msup><mi>e</mi><mi>z</mi></msup><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mfrac><mo>≈</mo><msup><mi>z</mi><mrow><mo>−</mo><mn>2</mn></mrow></msup></mrow><annotation encoding="application/x-tex">\frac{e^{z}}{(e^{z}-1)^{2}}\approx z^{-2}</annotation></semantics></math>, we have <math id="A6.p1.m13" class="ltx_Math" alttext="T-t_{k^{*}}\asymp\sqrt{\gamma}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>T</mi><mo>−</mo><msub><mi>t</mi><msup><mi>k</mi><mo>∗</mo></msup></msub></mrow><mo>≍</mo><msqrt><mi>γ</mi></msqrt></mrow><annotation encoding="application/x-tex">T-t_{k^{*}}\asymp\sqrt{\gamma}</annotation></semantics></math>, and thus <math id="A6.p1.m14" class="ltx_Math" alttext="N-k^{*}\asymp\frac{\sqrt{\gamma}}{\kappa}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>N</mi><mo>−</mo><msup><mi>k</mi><mo>∗</mo></msup></mrow><mo>≍</mo><mfrac><msqrt><mi>γ</mi></msqrt><mi>κ</mi></mfrac></mrow><annotation encoding="application/x-tex">N-k^{*}\asymp\frac{\sqrt{\gamma}}{\kappa}</annotation></semantics></math>.
The rest of the proof is similar to <a href="#Thmtheorem2" title="Theorem 2. ‣ 3.2 Convergence Upper Bound for the Euler Method ‣ 3 Convergence Guarantees for the Euler Method ‣ Sharp Convergence Rates for Masked Diffusion Models" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Theorem</span> <span class="ltx_text ltx_ref_tag">2</span></a>.</p>
</div>
</section>
<section id="A7" class="ltx_appendix">
<h2 class="ltx_title ltx_title_appendix"><span class="ltx_tag ltx_tag_appendix">Appendix G </span>Proof of <a href="#Thmtheorem3" title="Theorem 3. ‣ 3.3 Convergence Lower Bound for the Euler Method ‣ 3 Convergence Guarantees for the Euler Method ‣ Sharp Convergence Rates for Masked Diffusion Models" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Theorem</span> <span class="ltx_text ltx_ref_tag">3</span></a></h2>

<div id="A7.p1" class="ltx_para ltx_noindent">
<p id="A7.p1.1" class="ltx_p">We first construct a distribution <math id="A7.p1.m1" class="ltx_Math" alttext="q^{*}" display="inline" intent=":literal"><semantics><msup><mi>q</mi><mo>∗</mo></msup><annotation encoding="application/x-tex">q^{*}</annotation></semantics></math> as follows. Define <math id="A7.p1.m2" class="ltx_Math" alttext="\gamma:=\frac{\varepsilon^{1/4}}{d}&gt;0" display="inline" intent=":literal"><semantics><mrow><mi>γ</mi><mo>:=</mo><mfrac><msup><mi>ε</mi><mrow><mn>1</mn><mo>/</mo><mn>4</mn></mrow></msup><mi>d</mi></mfrac><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\gamma:=\frac{\varepsilon^{1/4}}{d}&gt;0</annotation></semantics></math>. We want to define an augmented forward process such that <math id="A7.p1.m3" class="ltx_Math" alttext="q^{*}" display="inline" intent=":literal"><semantics><msup><mi>q</mi><mo>∗</mo></msup><annotation encoding="application/x-tex">q^{*}</annotation></semantics></math> is the <math id="A7.p1.m4" class="ltx_Math" alttext="\gamma" display="inline" intent=":literal"><semantics><mi>γ</mi><annotation encoding="application/x-tex">\gamma</annotation></semantics></math>-perturbation of <math id="A7.p1.m5" class="ltx_Math" alttext="q_{0}=\bm{\delta}_{\bm{a}}" display="inline" intent=":literal"><semantics><mrow><msub><mi>q</mi><mn>0</mn></msub><mo>=</mo><msub><mi>𝜹</mi><mi>𝒂</mi></msub></mrow><annotation encoding="application/x-tex">q_{0}=\bm{\delta}_{\bm{a}}</annotation></semantics></math>, denoted by <math id="A7.p1.m6" class="ltx_Math" alttext="q_{\gamma}" display="inline" intent=":literal"><semantics><msub><mi>q</mi><mi>γ</mi></msub><annotation encoding="application/x-tex">q_{\gamma}</annotation></semantics></math>.
Here we let <math id="A7.p1.m7" class="ltx_Math" alttext="\bm{\delta}_{\bm{a}}" display="inline" intent=":literal"><semantics><msub><mi>𝜹</mi><mi>𝒂</mi></msub><annotation encoding="application/x-tex">\bm{\delta}_{\bm{a}}</annotation></semantics></math> denote a delta-distribution such that <math id="A7.p1.m8" class="ltx_Math" alttext="a^{i}\neq\mathrm{[MASK]},\penalty\ \forall i\in[d]" display="inline" intent=":literal"><semantics><mrow><mrow><msup><mi>a</mi><mi>i</mi></msup><mo>≠</mo><mrow><mo stretchy="false">[</mo><mi>MASK</mi><mo stretchy="false">]</mo></mrow></mrow><mo rspace="0.667em">,</mo><mrow><mrow><mo rspace="0.167em">∀</mo><mi>i</mi></mrow><mo>∈</mo><mrow><mo stretchy="false">[</mo><mi>d</mi><mo stretchy="false">]</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">a^{i}\neq\mathrm{[MASK]},\penalty\ \forall i\in[d]</annotation></semantics></math>.
Note that such an augmentation is key to the proof, where we are coupling the forward process starting from <math id="A7.p1.m9" class="ltx_Math" alttext="\bm{\delta}_{\bm{a}}" display="inline" intent=":literal"><semantics><msub><mi>𝜹</mi><mi>𝒂</mi></msub><annotation encoding="application/x-tex">\bm{\delta}_{\bm{a}}</annotation></semantics></math> and that starting from <math id="A7.p1.m10" class="ltx_Math" alttext="q_{\gamma}" display="inline" intent=":literal"><semantics><msub><mi>q</mi><mi>γ</mi></msub><annotation encoding="application/x-tex">q_{\gamma}</annotation></semantics></math>.</p>
</div>
<div id="A7.p2" class="ltx_para ltx_noindent">
<p id="A7.p2.1" class="ltx_p">We first explain why such a <math id="A7.p2.m1" class="ltx_Math" alttext="q_{\gamma}" display="inline" intent=":literal"><semantics><msub><mi>q</mi><mi>γ</mi></msub><annotation encoding="application/x-tex">q_{\gamma}</annotation></semantics></math> satisfies <math id="A7.p2.m2" class="ltx_Math" alttext="\gamma(q_{\gamma})&gt;0" display="inline" intent=":literal"><semantics><mrow><mrow><mi>γ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>q</mi><mi>γ</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\gamma(q_{\gamma})&gt;0</annotation></semantics></math>. Indeed,</p>
<table id="A7.EGx16" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A7.Ex89"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A7.Ex89.m1" class="ltx_Math" alttext="\displaystyle\frac{q_{\gamma}^{i}(\mathrm{[MASK]}|x^{-i})}{\max_{u^{i}\in[S]:u^{i}\neq\mathrm{[MASK]}}q_{\gamma}^{i}(u^{i}|x^{-i})}" display="inline" intent=":literal"><semantics><mstyle displaystyle="true"><mfrac><mrow><msubsup><mi>q</mi><mi>γ</mi><mi>i</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mo stretchy="false">[</mo><mi>MASK</mi><mo stretchy="false">]</mo></mrow><mo lspace="0em" rspace="0em">|</mo><msup><mi>x</mi><mrow><mo>−</mo><mi>i</mi></mrow></msup><mo stretchy="false">)</mo></mrow></mrow><mrow><mi>max</mi><msub><mrow></mrow><mrow><msup><mi>u</mi><mi>i</mi></msup><mo>∈</mo><mrow><mo stretchy="false">[</mo><mi>S</mi><mo rspace="0.278em" stretchy="false">]</mo></mrow><mo rspace="0.278em">:</mo><mrow><msup><mi>u</mi><mi>i</mi></msup><mo>≠</mo><mrow><mo stretchy="false">[</mo><mi>MASK</mi><mo stretchy="false">]</mo></mrow></mrow></mrow></msub><mi>q</mi><msub><mrow></mrow><mi>γ</mi></msub><msup><mrow></mrow><mi>i</mi></msup><mo stretchy="false">(</mo><mi>u</mi><msup><mrow></mrow><mi>i</mi></msup><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>x</mi><msup><mrow></mrow><mrow><mo>−</mo><mi>i</mi></mrow></msup><mo stretchy="false">)</mo></mrow></mfrac></mstyle><annotation encoding="application/x-tex">\displaystyle\frac{q_{\gamma}^{i}(\mathrm{[MASK]}|x^{-i})}{\max_{u^{i}\in[S]:u^{i}\neq\mathrm{[MASK]}}q_{\gamma}^{i}(u^{i}|x^{-i})}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A7.Ex89.m2" class="ltx_math_unparsed" alttext="\displaystyle=\frac{1}{\max_{u^{i}\in[S]:u^{i}\neq\mathrm{[MASK]}}q_{\gamma}(u^{i},x^{-i})/q_{\gamma}(\mathrm{[MASK]},x^{-i})}" display="inline" intent=":literal"><semantics><mrow><mo>=</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mrow><mi>max</mi><msub><mrow></mrow><mrow><msup><mi>u</mi><mi>i</mi></msup><mo>∈</mo><mrow><mo stretchy="false">[</mo><mi>S</mi><mo rspace="0.278em" stretchy="false">]</mo></mrow><mo rspace="0.278em">:</mo><mrow><msup><mi>u</mi><mi>i</mi></msup><mo>≠</mo><mrow><mo stretchy="false">[</mo><mi>MASK</mi><mo stretchy="false">]</mo></mrow></mrow></mrow></msub><mi>q</mi><msub><mrow></mrow><mi>γ</mi></msub><mo stretchy="false">(</mo><mi>u</mi><msup><mrow></mrow><mi>i</mi></msup><mo>,</mo><mi>x</mi><msup><mrow></mrow><mrow><mo>−</mo><mi>i</mi></mrow></msup><mo stretchy="false">)</mo><mo>/</mo><mi>q</mi><msub><mrow></mrow><mi>γ</mi></msub><mo stretchy="false">(</mo><mo stretchy="false">[</mo><mi>MASK</mi><mo stretchy="false">]</mo><mo>,</mo><mi>x</mi><msup><mrow></mrow><mrow><mo>−</mo><mi>i</mi></mrow></msup><mo stretchy="false">)</mo></mrow></mfrac></mstyle></mrow><annotation encoding="application/x-tex">\displaystyle=\frac{1}{\max_{u^{i}\in[S]:u^{i}\neq\mathrm{[MASK]}}q_{\gamma}(u^{i},x^{-i})/q_{\gamma}(\mathrm{[MASK]},x^{-i})}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A7.Ex90"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A7.Ex90.m1" class="ltx_Math" alttext="\displaystyle\geq\gamma&gt;0," display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>≥</mo><mi>γ</mi><mo>&gt;</mo><mn>0</mn></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\geq\gamma&gt;0,</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A7.p2.2" class="ltx_p">where the last line follows by the score upper bound in Lemma 1 of <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib11" title="" class="ltx_ref">13</a>]</cite>.</p>
</div>
<div id="A7.p3" class="ltx_para ltx_noindent">
<p id="A7.p3.1" class="ltx_p">With such a special setup, the (augmented) forward CTMC has the following properties. Suppose that <math id="A7.p3.m1" class="ltx_Math" alttext="y\neq x" display="inline" intent=":literal"><semantics><mrow><mi>y</mi><mo>≠</mo><mi>x</mi></mrow><annotation encoding="application/x-tex">y\neq x</annotation></semantics></math> only on the <math id="A7.p3.m2" class="ltx_Math" alttext="i" display="inline" intent=":literal"><semantics><mi>i</mi><annotation encoding="application/x-tex">i</annotation></semantics></math>-th component. Then, with <math id="A7.p3.m3" class="ltx_Math" alttext="t\in[\gamma,T+\gamma]" display="inline" intent=":literal"><semantics><mrow><mi>t</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mrow><mi>γ</mi><mo>,</mo><mrow><mi>T</mi><mo>+</mo><mi>γ</mi></mrow></mrow><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">t\in[\gamma,T+\gamma]</annotation></semantics></math> (due to augmentation),</p>
<table id="A7.EGx17" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A7.Ex91"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A7.Ex91.m1" class="ltx_math_unparsed" alttext="\displaystyle q_{t}(x)=(1-e^{-t})^{\sum_{i}\mathds{1}\left\{x^{i}=\mathrm{[MASK]}\right\}}(e^{-t})^{\sum_{i}\mathds{1}\left\{x^{i}=a^{i}\right\}}0^{\sum_{i}\mathds{1}\left\{x^{i}\neq\mathrm{[MASK]},x^{i}\neq a^{i}\right\}}" display="inline" intent=":literal"><semantics><mrow><msub><mi>q</mi><mi>t</mi></msub><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow><mo>=</mo><msup><mrow><mo stretchy="false">(</mo><mn>1</mn><mo>−</mo><msup><mi>e</mi><mrow><mo>−</mo><mi>t</mi></mrow></msup><mo stretchy="false">)</mo></mrow><mrow><mstyle scriptlevel="-1"><mo maxsize="0.700em" minsize="0.700em" stretchy="true">∑</mo></mstyle><msub><mrow></mrow><mi>i</mi></msub><mn>𝟙</mn><mo>{</mo><mi>x</mi><msup><mrow></mrow><mi>i</mi></msup><mo>=</mo><mo stretchy="false">[</mo><mi>MASK</mi><mo stretchy="false">]</mo><mo>}</mo></mrow></msup><msup><mrow><mo stretchy="false">(</mo><msup><mi>e</mi><mrow><mo>−</mo><mi>t</mi></mrow></msup><mo stretchy="false">)</mo></mrow><mrow><mstyle scriptlevel="-1"><mo maxsize="0.700em" minsize="0.700em" stretchy="true">∑</mo></mstyle><msub><mrow></mrow><mi>i</mi></msub><mn>𝟙</mn><mo>{</mo><mi>x</mi><msup><mrow></mrow><mi>i</mi></msup><mo>=</mo><mi>a</mi><msup><mrow></mrow><mi>i</mi></msup><mo>}</mo></mrow></msup><msup><mn>0</mn><mrow><mstyle displaystyle="false"><msub><mo maxsize="0.700em" minsize="0.700em" stretchy="true">∑</mo><mi>i</mi></msub></mstyle><mrow><mn>𝟙</mn><mo lspace="0em" rspace="0em">​</mo><mrow><mo>{</mo><mrow><mrow><msup><mi>x</mi><mi>i</mi></msup><mo>≠</mo><mrow><mo stretchy="false">[</mo><mi>MASK</mi><mo stretchy="false">]</mo></mrow></mrow><mo>,</mo><mrow><msup><mi>x</mi><mi>i</mi></msup><mo>≠</mo><msup><mi>a</mi><mi>i</mi></msup></mrow></mrow><mo>}</mo></mrow></mrow></mrow></msup></mrow><annotation encoding="application/x-tex">\displaystyle q_{t}(x)=(1-e^{-t})^{\sum_{i}\mathds{1}\left\{x^{i}=\mathrm{[MASK]}\right\}}(e^{-t})^{\sum_{i}\mathds{1}\left\{x^{i}=a^{i}\right\}}0^{\sum_{i}\mathds{1}\left\{x^{i}\neq\mathrm{[MASK]},x^{i}\neq a^{i}\right\}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A7.Ex92"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A7.Ex92.m1" class="ltx_Math" alttext="\displaystyle\frac{q_{t}(y)}{q_{t}(x)}=\frac{e^{-t}}{1-e^{-t}},\quad\text{only if}\penalty\ y^{i}=a^{i},x^{i}=\mathrm{[MASK]}" display="inline" intent=":literal"><semantics><mrow><mrow><mstyle displaystyle="true"><mfrac><mrow><msub><mi>q</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>y</mi><mo stretchy="false">)</mo></mrow></mrow><mrow><msub><mi>q</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle><mo>=</mo><mstyle displaystyle="true"><mfrac><msup><mi>e</mi><mrow><mo>−</mo><mi>t</mi></mrow></msup><mrow><mn>1</mn><mo>−</mo><msup><mi>e</mi><mrow><mo>−</mo><mi>t</mi></mrow></msup></mrow></mfrac></mstyle></mrow><mo rspace="1.167em">,</mo><mrow><mrow><mtext>only if</mtext><mo lspace="0.500em" rspace="0em">​</mo><msup><mi>y</mi><mi>i</mi></msup></mrow><mo>=</mo><msup><mi>a</mi><mi>i</mi></msup></mrow><mo>,</mo><mrow><msup><mi>x</mi><mi>i</mi></msup><mo>=</mo><mrow><mo stretchy="false">[</mo><mi>MASK</mi><mo stretchy="false">]</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\frac{q_{t}(y)}{q_{t}(x)}=\frac{e^{-t}}{1-e^{-t}},\quad\text{only if}\penalty\ y^{i}=a^{i},x^{i}=\mathrm{[MASK]}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A7.p3.2" class="ltx_p">After placing equal-spaced discretization points on <math id="A7.p3.m4" class="ltx_Math" alttext="[\gamma,T+\gamma]" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">[</mo><mrow><mi>γ</mi><mo>,</mo><mrow><mi>T</mi><mo>+</mo><mi>γ</mi></mrow></mrow><mo stretchy="false">]</mo></mrow><annotation encoding="application/x-tex">[\gamma,T+\gamma]</annotation></semantics></math>, the Euler method proceeds as in (<a href="#S2.E7" title="Equation 7 ‣ 2.2 CTMC Reverse Process and the Euler Method ‣ 2 Preliminaries of Discrete Diffusion Models ‣ Sharp Convergence Rates for Masked Diffusion Models" class="ltx_ref"><span class="ltx_text ltx_ref_tag">7</span></a>) with</p>
<table id="A7.Ex93" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A7.Ex93.m1" class="ltx_math_unparsed" alttext="\hat{R}_{k}^{i}(\mathrm{[MASK]},y^{i})=\frac{e^{-(T+\gamma-t_{k})}}{1-e^{-(T+\gamma-t_{k})}},\quad\text{only if}\penalty\ y^{i}=a^{i},\penalty\ \text{otherwise}\penalty\ 0." display="block" intent=":literal"><semantics><mrow><msubsup><mover accent="true"><mi>R</mi><mo>^</mo></mover><mi>k</mi><mi>i</mi></msubsup><mrow><mo stretchy="false">(</mo><mrow><mo stretchy="false">[</mo><mi>MASK</mi><mo stretchy="false">]</mo></mrow><mo>,</mo><msup><mi>y</mi><mi>i</mi></msup><mo stretchy="false">)</mo></mrow><mo>=</mo><mfrac><msup><mi>e</mi><mrow><mo>−</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mi>T</mi><mo>+</mo><mi>γ</mi></mrow><mo>−</mo><msub><mi>t</mi><mi>k</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow></msup><mrow><mn>1</mn><mo>−</mo><msup><mi>e</mi><mrow><mo>−</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mi>T</mi><mo>+</mo><mi>γ</mi></mrow><mo>−</mo><msub><mi>t</mi><mi>k</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow></msup></mrow></mfrac><mo rspace="1.167em">,</mo><mtext>only if</mtext><msup><mi>y</mi><mi>i</mi></msup><mo>=</mo><msup><mi>a</mi><mi>i</mi></msup><mo rspace="0.667em">,</mo><mtext>otherwise</mtext><mn> 0</mn><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\hat{R}_{k}^{i}(\mathrm{[MASK]},y^{i})=\frac{e^{-(T+\gamma-t_{k})}}{1-e^{-(T+\gamma-t_{k})}},\quad\text{only if}\penalty\ y^{i}=a^{i},\penalty\ \text{otherwise}\penalty\ 0.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A7.p3.3" class="ltx_p">Due to the particular design with the absorbing rate, once this token jumps from <math id="A7.p3.m5" class="ltx_Math" alttext="\mathrm{[MASK]}" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">[</mo><mi>MASK</mi><mo stretchy="false">]</mo></mrow><annotation encoding="application/x-tex">\mathrm{[MASK]}</annotation></semantics></math> to <math id="A7.p3.m6" class="ltx_Math" alttext="a^{i}" display="inline" intent=":literal"><semantics><msup><mi>a</mi><mi>i</mi></msup><annotation encoding="application/x-tex">a^{i}</annotation></semantics></math>, it will stay there.
Also note that the probability on the right-hand side is independent of <math id="A7.p3.m7" class="ltx_Math" alttext="i" display="inline" intent=":literal"><semantics><mi>i</mi><annotation encoding="application/x-tex">i</annotation></semantics></math>. This implies that the resulting <math id="A7.p3.m8" class="ltx_Math" alttext="p_{T}" display="inline" intent=":literal"><semantics><msub><mi>p</mi><mi>T</mi></msub><annotation encoding="application/x-tex">p_{T}</annotation></semantics></math> is independent in <math id="A7.p3.m9" class="ltx_Math" alttext="i" display="inline" intent=":literal"><semantics><mi>i</mi><annotation encoding="application/x-tex">i</annotation></semantics></math>, with</p>
<table id="A7.E21" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A7.E21.m1" class="ltx_Math" alttext="p_{T}^{i}(\mathrm{[MASK]})=\prod_{k=0}^{N-1}\left(1-\frac{\kappa}{e^{T+\gamma-t_{k}}-1}\right)=:p_{M}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><msubsup><mi>p</mi><mi>T</mi><mi>i</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mo stretchy="false">[</mo><mi>MASK</mi><mo stretchy="false">]</mo></mrow><mo stretchy="false">)</mo></mrow></mrow><mo rspace="0.111em">=</mo><mrow><munderover><mo movablelimits="false" rspace="0em">∏</mo><mrow><mi>k</mi><mo>=</mo><mn>0</mn></mrow><mrow><mi>N</mi><mo>−</mo><mn>1</mn></mrow></munderover><mrow><mo>(</mo><mrow><mn>1</mn><mo>−</mo><mfrac><mi>κ</mi><mrow><msup><mi>e</mi><mrow><mrow><mi>T</mi><mo>+</mo><mi>γ</mi></mrow><mo>−</mo><msub><mi>t</mi><mi>k</mi></msub></mrow></msup><mo>−</mo><mn>1</mn></mrow></mfrac></mrow><mo>)</mo></mrow></mrow><mo>=</mo><mphantom></mphantom><mo lspace="0.278em" rspace="0.278em">:</mo><msub><mi>p</mi><mi>M</mi></msub></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">p_{T}^{i}(\mathrm{[MASK]})=\prod_{k=0}^{N-1}\left(1-\frac{\kappa}{e^{T+\gamma-t_{k}}-1}\right)=:p_{M}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(21)</span></td></tr></tbody>
</table>
</div>
<div id="A7.p4" class="ltx_para ltx_noindent">
<p id="A7.p4.1" class="ltx_p">Now we proceeds to analyze <math id="A7.p4.m1" class="ltx_Math" alttext="p_{M}" display="inline" intent=":literal"><semantics><msub><mi>p</mi><mi>M</mi></msub><annotation encoding="application/x-tex">p_{M}</annotation></semantics></math>. We have</p>
<table id="A7.EGx18" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A7.Ex94"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A7.Ex94.m1" class="ltx_Math" alttext="\displaystyle\log p_{M}" display="inline" intent=":literal"><semantics><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><msub><mi>p</mi><mi>M</mi></msub></mrow><annotation encoding="application/x-tex">\displaystyle\log p_{M}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A7.Ex94.m2" class="ltx_Math" alttext="\displaystyle=\sum_{k=0}^{N-1}\log\left(1-\frac{\kappa}{e^{T+\gamma-t_{k}}-1}\right)" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>k</mi><mo>=</mo><mn>0</mn></mrow><mrow><mi>N</mi><mo>−</mo><mn>1</mn></mrow></munderover></mstyle><mrow><mi>log</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mn>1</mn><mo>−</mo><mstyle displaystyle="true"><mfrac><mi>κ</mi><mrow><msup><mi>e</mi><mrow><mrow><mi>T</mi><mo>+</mo><mi>γ</mi></mrow><mo>−</mo><msub><mi>t</mi><mi>k</mi></msub></mrow></msup><mo>−</mo><mn>1</mn></mrow></mfrac></mstyle></mrow><mo>)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\sum_{k=0}^{N-1}\log\left(1-\frac{\kappa}{e^{T+\gamma-t_{k}}-1}\right)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A7.Ex95"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A7.Ex95.m1" class="ltx_math_unparsed" alttext="\displaystyle=\sum_{k=0}^{N-1}-\frac{\kappa}{e^{T+\gamma-t_{k}}-1}-\frac{\kappa^{2}}{2(e^{T+\gamma-t_{k}}-1)^{2}}+O(\kappa^{3})" display="inline" intent=":literal"><semantics><mrow><mo>=</mo><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>k</mi><mo>=</mo><mn>0</mn></mrow><mrow><mi>N</mi><mo>−</mo><mn>1</mn></mrow></munderover></mstyle><mo>−</mo><mstyle displaystyle="true"><mfrac><mi>κ</mi><mrow><msup><mi>e</mi><mrow><mrow><mi>T</mi><mo>+</mo><mi>γ</mi></mrow><mo>−</mo><msub><mi>t</mi><mi>k</mi></msub></mrow></msup><mo>−</mo><mn>1</mn></mrow></mfrac></mstyle><mo>−</mo><mstyle displaystyle="true"><mfrac><msup><mi>κ</mi><mn>2</mn></msup><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><msup><mi>e</mi><mrow><mrow><mi>T</mi><mo>+</mo><mi>γ</mi></mrow><mo>−</mo><msub><mi>t</mi><mi>k</mi></msub></mrow></msup><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mrow></mfrac></mstyle><mo>+</mo><mi>O</mi><mrow><mo stretchy="false">(</mo><msup><mi>κ</mi><mn>3</mn></msup><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\sum_{k=0}^{N-1}-\frac{\kappa}{e^{T+\gamma-t_{k}}-1}-\frac{\kappa^{2}}{2(e^{T+\gamma-t_{k}}-1)^{2}}+O(\kappa^{3})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A7.E22"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A7.E22.m1" class="ltx_math_unparsed" alttext="\displaystyle=-\int_{\gamma}^{T+\gamma}\frac{1}{e^{t}-1}\mathrm{d}t+\tilde{O}(\gamma^{-1}\kappa)," display="inline" intent=":literal"><semantics><mrow><mo rspace="0em">=</mo><mo lspace="0em">−</mo><mstyle displaystyle="true"><msubsup><mo>∫</mo><mi>γ</mi><mrow><mi>T</mi><mo>+</mo><mi>γ</mi></mrow></msubsup></mstyle><mstyle displaystyle="true"><mfrac><mn>1</mn><mrow><msup><mi>e</mi><mi>t</mi></msup><mo>−</mo><mn>1</mn></mrow></mfrac></mstyle><mi>d</mi><mi>t</mi><mo>+</mo><mover accent="true"><mi>O</mi><mo>~</mo></mover><mrow><mo stretchy="false">(</mo><msup><mi>γ</mi><mrow><mo>−</mo><mn>1</mn></mrow></msup><mi>κ</mi><mo stretchy="false">)</mo></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle=-\int_{\gamma}^{T+\gamma}\frac{1}{e^{t}-1}\mathrm{d}t+\tilde{O}(\gamma^{-1}\kappa),</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(22)</span></td></tr></tbody>
</table>
<p id="A7.p4.2" class="ltx_p">where we explain the term <math id="A7.p4.m2" class="ltx_Math" alttext="\tilde{O}(\gamma^{-1}\kappa)" display="inline" intent=":literal"><semantics><mrow><mover accent="true"><mi>O</mi><mo>~</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mi>γ</mi><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mi>κ</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\tilde{O}(\gamma^{-1}\kappa)</annotation></semantics></math> as follows.
First, by the residual of the Riemann sum,</p>
<table id="A7.Ex96" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A7.Ex96.m1" class="ltx_math_unparsed" alttext="\left|\sum_{k=0}^{N-1}-\frac{\kappa}{e^{T+\gamma-t_{k}}-1}-\int_{\gamma}^{T+\gamma}\frac{1}{e^{t}-1}\mathrm{d}t\right|\leq\gamma^{-1}\kappa T=\tilde{O}(\gamma^{-1}\kappa)" display="block" intent=":literal"><semantics><mrow><mo fence="false">|</mo><munderover><mo movablelimits="false" rspace="0em">∑</mo><mrow><mi>k</mi><mo>=</mo><mn>0</mn></mrow><mrow><mi>N</mi><mo>−</mo><mn>1</mn></mrow></munderover><mo lspace="0em">−</mo><mfrac><mi>κ</mi><mrow><msup><mi>e</mi><mrow><mrow><mi>T</mi><mo>+</mo><mi>γ</mi></mrow><mo>−</mo><msub><mi>t</mi><mi>k</mi></msub></mrow></msup><mo>−</mo><mn>1</mn></mrow></mfrac><mo rspace="0.055em">−</mo><msubsup><mo>∫</mo><mi>γ</mi><mrow><mi>T</mi><mo>+</mo><mi>γ</mi></mrow></msubsup><mfrac><mn>1</mn><mrow><msup><mi>e</mi><mi>t</mi></msup><mo>−</mo><mn>1</mn></mrow></mfrac><mi>d</mi><mi>t</mi><mo fence="false">|</mo><mo lspace="0.167em">≤</mo><msup><mi>γ</mi><mrow><mo>−</mo><mn>1</mn></mrow></msup><mi>κ</mi><mi>T</mi><mo>=</mo><mover accent="true"><mi>O</mi><mo>~</mo></mover><mrow><mo stretchy="false">(</mo><msup><mi>γ</mi><mrow><mo>−</mo><mn>1</mn></mrow></msup><mi>κ</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\left|\sum_{k=0}^{N-1}-\frac{\kappa}{e^{T+\gamma-t_{k}}-1}-\int_{\gamma}^{T+\gamma}\frac{1}{e^{t}-1}\mathrm{d}t\right|\leq\gamma^{-1}\kappa T=\tilde{O}(\gamma^{-1}\kappa)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A7.p4.3" class="ltx_p">if <math id="A7.p4.m3" class="ltx_Math" alttext="T=\tilde{O}(1)" display="inline" intent=":literal"><semantics><mrow><mi>T</mi><mo>=</mo><mrow><mover accent="true"><mi>O</mi><mo>~</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">T=\tilde{O}(1)</annotation></semantics></math>. Also,</p>
<table id="A7.Ex97" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A7.Ex97.m1" class="ltx_Math" alttext="\sum_{k=0}^{N-1}\frac{\kappa^{2}}{2(e^{T+\gamma-t_{k}}-1)^{2}}=O\left(\kappa\int_{\gamma}^{T+\gamma}\frac{1}{(e^{t}-1)^{2}}\mathrm{d}t\right)=O(\gamma^{-1}\kappa)." display="block" intent=":literal"><semantics><mrow><mrow><mrow><munderover><mo movablelimits="false">∑</mo><mrow><mi>k</mi><mo>=</mo><mn>0</mn></mrow><mrow><mi>N</mi><mo>−</mo><mn>1</mn></mrow></munderover><mfrac><msup><mi>κ</mi><mn>2</mn></msup><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><msup><mi>e</mi><mrow><mrow><mi>T</mi><mo>+</mo><mi>γ</mi></mrow><mo>−</mo><msub><mi>t</mi><mi>k</mi></msub></mrow></msup><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mrow></mfrac></mrow><mo>=</mo><mrow><mi>O</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mi>κ</mi><mo lspace="0em" rspace="0em">​</mo><mrow><msubsup><mo>∫</mo><mi>γ</mi><mrow><mi>T</mi><mo>+</mo><mi>γ</mi></mrow></msubsup><mrow><mfrac><mn>1</mn><msup><mrow><mo stretchy="false">(</mo><mrow><msup><mi>e</mi><mi>t</mi></msup><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mfrac><mo lspace="0em" rspace="0em">​</mo><mrow><mo rspace="0em">𝑑</mo><mi>t</mi></mrow></mrow></mrow></mrow><mo>)</mo></mrow></mrow><mo>=</mo><mrow><mi>O</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mi>γ</mi><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mi>κ</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\sum_{k=0}^{N-1}\frac{\kappa^{2}}{2(e^{T+\gamma-t_{k}}-1)^{2}}=O\left(\kappa\int_{\gamma}^{T+\gamma}\frac{1}{(e^{t}-1)^{2}}\mathrm{d}t\right)=O(\gamma^{-1}\kappa).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A7.p4.4" class="ltx_p">Also note that <math id="A7.p4.m4" class="ltx_Math" alttext="\gamma^{-1}\kappa=O(\varepsilon^{1/4})" display="inline" intent=":literal"><semantics><mrow><mrow><msup><mi>γ</mi><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mi>κ</mi></mrow><mo>=</mo><mrow><mi>O</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>ε</mi><mrow><mn>1</mn><mo>/</mo><mn>4</mn></mrow></msup><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\gamma^{-1}\kappa=O(\varepsilon^{1/4})</annotation></semantics></math>. The upper bound for the integral is due to the augmented forward process. For small <math id="A7.p4.m5" class="ltx_Math" alttext="\gamma" display="inline" intent=":literal"><semantics><mi>γ</mi><annotation encoding="application/x-tex">\gamma</annotation></semantics></math> and large <math id="A7.p4.m6" class="ltx_Math" alttext="T" display="inline" intent=":literal"><semantics><mi>T</mi><annotation encoding="application/x-tex">T</annotation></semantics></math>, the integral can be evaluated as</p>
<table id="A7.Ex98" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A7.Ex98.m1" class="ltx_Math" alttext="\int_{\gamma}^{T+\gamma}\frac{1}{e^{t}-1}\mathrm{d}t=\log\gamma^{-1}-e^{-T}+O(1)," display="block" intent=":literal"><semantics><mrow><mrow><mrow><msubsup><mo>∫</mo><mi>γ</mi><mrow><mi>T</mi><mo>+</mo><mi>γ</mi></mrow></msubsup><mrow><mfrac><mn>1</mn><mrow><msup><mi>e</mi><mi>t</mi></msup><mo>−</mo><mn>1</mn></mrow></mfrac><mo lspace="0em" rspace="0em">​</mo><mrow><mo rspace="0em">𝑑</mo><mi>t</mi></mrow></mrow></mrow><mo>=</mo><mrow><mrow><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><msup><mi>γ</mi><mrow><mo>−</mo><mn>1</mn></mrow></msup></mrow><mo>−</mo><msup><mi>e</mi><mrow><mo>−</mo><mi>T</mi></mrow></msup></mrow><mo>+</mo><mrow><mi>O</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\int_{\gamma}^{T+\gamma}\frac{1}{e^{t}-1}\mathrm{d}t=\log\gamma^{-1}-e^{-T}+O(1),</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A7.p4.5" class="ltx_p">and thus</p>
<table id="A7.Ex99" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A7.Ex99.m1" class="ltx_Math" alttext="p_{M}\asymp e^{\log\gamma+e^{-T}}(1+\tilde{O}(\gamma^{-1}\kappa))=\gamma e^{e^{-T}}+\tilde{O}(e^{e^{-T}}\kappa)." display="block" intent=":literal"><semantics><mrow><mrow><msub><mi>p</mi><mi>M</mi></msub><mo>≍</mo><mrow><msup><mi>e</mi><mrow><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mi>γ</mi></mrow><mo>+</mo><msup><mi>e</mi><mrow><mo>−</mo><mi>T</mi></mrow></msup></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><mrow><mover accent="true"><mi>O</mi><mo>~</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mi>γ</mi><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mi>κ</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mrow><mi>γ</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>e</mi><msup><mi>e</mi><mrow><mo>−</mo><mi>T</mi></mrow></msup></msup></mrow><mo>+</mo><mrow><mover accent="true"><mi>O</mi><mo>~</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mi>e</mi><msup><mi>e</mi><mrow><mo>−</mo><mi>T</mi></mrow></msup></msup><mo lspace="0em" rspace="0em">​</mo><mi>κ</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">p_{M}\asymp e^{\log\gamma+e^{-T}}(1+\tilde{O}(\gamma^{-1}\kappa))=\gamma e^{e^{-T}}+\tilde{O}(e^{e^{-T}}\kappa).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="A7.p5" class="ltx_para ltx_noindent">
<p id="A7.p5.1" class="ltx_p">Now, note that, when <math id="A7.p5.m1" class="ltx_Math" alttext="\gamma" display="inline" intent=":literal"><semantics><mi>γ</mi><annotation encoding="application/x-tex">\gamma</annotation></semantics></math> vanishes quickly enough such that <math id="A7.p5.m2" class="ltx_Math" alttext="\gamma d\to 0" display="inline" intent=":literal"><semantics><mrow><mrow><mi>γ</mi><mo lspace="0em" rspace="0em">​</mo><mi>d</mi></mrow><mo stretchy="false">→</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\gamma d\to 0</annotation></semantics></math>, we have</p>
<table id="A7.EGx19" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A7.Ex100"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A7.Ex100.m1" class="ltx_Math" alttext="\displaystyle\mathrm{TV}(q_{\gamma},p_{T})" display="inline" intent=":literal"><semantics><mrow><mi>TV</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>q</mi><mi>γ</mi></msub><mo>,</mo><msub><mi>p</mi><mi>T</mi></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\mathrm{TV}(q_{\gamma},p_{T})</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A7.Ex100.m2" class="ltx_Math" alttext="\displaystyle\geq\left|q_{\gamma}(\bm{a})-p_{T}(\bm{a})\right|" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≥</mo><mrow><mo>|</mo><mrow><mrow><msub><mi>q</mi><mi>γ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝒂</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msub><mi>p</mi><mi>T</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝒂</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>|</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\geq\left|q_{\gamma}(\bm{a})-p_{T}(\bm{a})\right|</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A7.Ex101"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A7.Ex101.m1" class="ltx_Math" alttext="\displaystyle=\left|e^{-\gamma d}-(1-p_{M})^{d}\right|" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mo>|</mo><mrow><msup><mi>e</mi><mrow><mo>−</mo><mrow><mi>γ</mi><mo lspace="0em" rspace="0em">​</mo><mi>d</mi></mrow></mrow></msup><mo>−</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msub><mi>p</mi><mi>M</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mi>d</mi></msup></mrow><mo>|</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\left|e^{-\gamma d}-(1-p_{M})^{d}\right|</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A7.Ex102"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A7.Ex102.m1" class="ltx_Math" alttext="\displaystyle=\left|1-\gamma d-(1-dp_{M})\right|+O(d^{2}\gamma^{2})" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><mo>|</mo><mrow><mn>1</mn><mo>−</mo><mrow><mi>γ</mi><mo lspace="0em" rspace="0em">​</mo><mi>d</mi></mrow><mo>−</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>p</mi><mi>M</mi></msub></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>|</mo></mrow><mo>+</mo><mrow><mi>O</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mi>d</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>γ</mi><mn>2</mn></msup></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\left|1-\gamma d-(1-dp_{M})\right|+O(d^{2}\gamma^{2})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A7.Ex103"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A7.Ex103.m1" class="ltx_Math" alttext="\displaystyle=d\left|p_{M}-\gamma\right|+O(d^{2}\gamma^{2})." display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo>|</mo><mrow><msub><mi>p</mi><mi>M</mi></msub><mo>−</mo><mi>γ</mi></mrow><mo>|</mo></mrow></mrow><mo>+</mo><mrow><mi>O</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mi>d</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>γ</mi><mn>2</mn></msup></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle=d\left|p_{M}-\gamma\right|+O(d^{2}\gamma^{2}).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A7.p5.2" class="ltx_p">Here note that <math id="A7.p5.m3" class="ltx_Math" alttext="O(d^{2}\gamma^{2})=O(\varepsilon^{1/2})" display="inline" intent=":literal"><semantics><mrow><mrow><mi>O</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mi>d</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>γ</mi><mn>2</mn></msup></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mi>O</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>ε</mi><mrow><mn>1</mn><mo>/</mo><mn>2</mn></mrow></msup><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">O(d^{2}\gamma^{2})=O(\varepsilon^{1/2})</annotation></semantics></math>. Thus, in order that <math id="A7.p5.m4" class="ltx_Math" alttext="\mathrm{TV}(q_{\gamma},p_{T})\lesssim\sqrt{\varepsilon}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>TV</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>q</mi><mi>γ</mi></msub><mo>,</mo><msub><mi>p</mi><mi>T</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>≲</mo><msqrt><mi>ε</mi></msqrt></mrow><annotation encoding="application/x-tex">\mathrm{TV}(q_{\gamma},p_{T})\lesssim\sqrt{\varepsilon}</annotation></semantics></math>, we must have</p>
<table id="A7.EGx20" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A7.Ex104"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A7.Ex104.m1" class="ltx_Math" alttext="\displaystyle\sqrt{\varepsilon}" display="inline" intent=":literal"><semantics><msqrt><mi>ε</mi></msqrt><annotation encoding="application/x-tex">\displaystyle\sqrt{\varepsilon}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A7.Ex104.m2" class="ltx_Math" alttext="\displaystyle\gtrsim d\left|p_{M}-\gamma\right|+O(d^{2}\gamma^{2})" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≳</mo><mrow><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo>|</mo><mrow><msub><mi>p</mi><mi>M</mi></msub><mo>−</mo><mi>γ</mi></mrow><mo>|</mo></mrow></mrow><mo>+</mo><mrow><mi>O</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mi>d</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>γ</mi><mn>2</mn></msup></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\gtrsim d\left|p_{M}-\gamma\right|+O(d^{2}\gamma^{2})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A7.Ex105"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A7.Ex105.m1" class="ltx_Math" alttext="\displaystyle=d\left|\gamma e^{e^{-T}}+\tilde{O}(e^{e^{-T}}\kappa)-\gamma\right|+O(d^{2}\gamma^{2})" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo>|</mo><mrow><mrow><mrow><mi>γ</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>e</mi><msup><mi>e</mi><mrow><mo>−</mo><mi>T</mi></mrow></msup></msup></mrow><mo>+</mo><mrow><mover accent="true"><mi>O</mi><mo>~</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mi>e</mi><msup><mi>e</mi><mrow><mo>−</mo><mi>T</mi></mrow></msup></msup><mo lspace="0em" rspace="0em">​</mo><mi>κ</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>−</mo><mi>γ</mi></mrow><mo>|</mo></mrow></mrow><mo>+</mo><mrow><mi>O</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mi>d</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>γ</mi><mn>2</mn></msup></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=d\left|\gamma e^{e^{-T}}+\tilde{O}(e^{e^{-T}}\kappa)-\gamma\right|+O(d^{2}\gamma^{2})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A7.Ex106"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A7.Ex106.m1" class="ltx_Math" alttext="\displaystyle=d\left|\gamma e^{-T}+\tilde{O}(e^{e^{-T}}\kappa)\right|+O(d^{2}\gamma^{2}+\gamma de^{-2T})" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo>|</mo><mrow><mrow><mi>γ</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>e</mi><mrow><mo>−</mo><mi>T</mi></mrow></msup></mrow><mo>+</mo><mrow><mover accent="true"><mi>O</mi><mo>~</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mi>e</mi><msup><mi>e</mi><mrow><mo>−</mo><mi>T</mi></mrow></msup></msup><mo lspace="0em" rspace="0em">​</mo><mi>κ</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>|</mo></mrow></mrow><mo>+</mo><mrow><mi>O</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><msup><mi>d</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>γ</mi><mn>2</mn></msup></mrow><mo>+</mo><mrow><mi>γ</mi><mo lspace="0em" rspace="0em">​</mo><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>e</mi><mrow><mo>−</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>T</mi></mrow></mrow></msup></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=d\left|\gamma e^{-T}+\tilde{O}(e^{e^{-T}}\kappa)\right|+O(d^{2}\gamma^{2}+\gamma de^{-2T})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A7.p5.3" class="ltx_p">where the last line follows when <math id="A7.p5.m5" class="ltx_Math" alttext="T" display="inline" intent=":literal"><semantics><mi>T</mi><annotation encoding="application/x-tex">T</annotation></semantics></math> is large and because <math id="A7.p5.m6" class="ltx_Math" alttext="e^{z}-1=z+O(z^{2})" display="inline" intent=":literal"><semantics><mrow><mrow><msup><mi>e</mi><mi>z</mi></msup><mo>−</mo><mn>1</mn></mrow><mo>=</mo><mrow><mi>z</mi><mo>+</mo><mrow><mi>O</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>z</mi><mn>2</mn></msup><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">e^{z}-1=z+O(z^{2})</annotation></semantics></math> when <math id="A7.p5.m7" class="ltx_Math" alttext="z\to 0" display="inline" intent=":literal"><semantics><mrow><mi>z</mi><mo stretchy="false">→</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">z\to 0</annotation></semantics></math>. Thus, when <math id="A7.p5.m8" class="ltx_Math" alttext="\gamma=\frac{\varepsilon^{1/4}}{d}" display="inline" intent=":literal"><semantics><mrow><mi>γ</mi><mo>=</mo><mfrac><msup><mi>ε</mi><mrow><mn>1</mn><mo>/</mo><mn>4</mn></mrow></msup><mi>d</mi></mfrac></mrow><annotation encoding="application/x-tex">\gamma=\frac{\varepsilon^{1/4}}{d}</annotation></semantics></math>, it is required that</p>
<table id="A7.Ex107" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A7.Ex107.m1" class="ltx_Math" alttext="T\gtrsim\log\frac{1}{\varepsilon^{1/4}},\quad\kappa\lesssim\frac{\sqrt{\varepsilon}}{d}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mi>T</mi><mo>≳</mo><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mfrac><mn>1</mn><msup><mi>ε</mi><mrow><mn>1</mn><mo>/</mo><mn>4</mn></mrow></msup></mfrac></mrow></mrow><mo rspace="1.167em">,</mo><mrow><mi>κ</mi><mo>≲</mo><mfrac><msqrt><mi>ε</mi></msqrt><mi>d</mi></mfrac></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">T\gtrsim\log\frac{1}{\varepsilon^{1/4}},\quad\kappa\lesssim\frac{\sqrt{\varepsilon}}{d}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A7.p5.4" class="ltx_p">Then, the number of steps satisfies that</p>
<table id="A7.Ex108" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A7.Ex108.m1" class="ltx_Math" alttext="N=\frac{T}{\kappa}\gtrsim\frac{d}{\sqrt{\varepsilon}}\log\frac{1}{\varepsilon^{1/4}}=\tilde{\Omega}\left(\frac{d}{\sqrt{\varepsilon}}\right)." display="block" intent=":literal"><semantics><mrow><mrow><mi>N</mi><mo>=</mo><mfrac><mi>T</mi><mi>κ</mi></mfrac><mo>≳</mo><mrow><mfrac><mi>d</mi><msqrt><mi>ε</mi></msqrt></mfrac><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mfrac><mn>1</mn><msup><mi>ε</mi><mrow><mn>1</mn><mo>/</mo><mn>4</mn></mrow></msup></mfrac></mrow></mrow><mo>=</mo><mrow><mover accent="true"><mi mathvariant="normal">Ω</mi><mo>~</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mfrac><mi>d</mi><msqrt><mi>ε</mi></msqrt></mfrac><mo>)</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">N=\frac{T}{\kappa}\gtrsim\frac{d}{\sqrt{\varepsilon}}\log\frac{1}{\varepsilon^{1/4}}=\tilde{\Omega}\left(\frac{d}{\sqrt{\varepsilon}}\right).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A7.p5.5" class="ltx_p">The proof is now complete.</p>
</div>
</section>
<section id="A8" class="ltx_appendix">
<h2 class="ltx_title ltx_title_appendix"><span class="ltx_tag ltx_tag_appendix">Appendix H </span>Proof of <a href="#Thmproposition2" title="Proposition 2. ‣ 4 Convergence Guarantees for the FHS Algorithm ‣ Sharp Convergence Rates for Masked Diffusion Models" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Proposition</span> <span class="ltx_text ltx_ref_tag">2</span></a></h2>

<div id="A8.p1" class="ltx_para ltx_noindent">
<p id="A8.p1.1" class="ltx_p">Suppose <math id="A8.p1.m1" class="ltx_Math" alttext="x_{t}" display="inline" intent=":literal"><semantics><msub><mi>x</mi><mi>t</mi></msub><annotation encoding="application/x-tex">x_{t}</annotation></semantics></math> has <math id="A8.p1.m2" class="ltx_Math" alttext="i" display="inline" intent=":literal"><semantics><mi>i</mi><annotation encoding="application/x-tex">i</annotation></semantics></math>-th token being <math id="A8.p1.m3" class="ltx_Math" alttext="\mathrm{[MASK]}" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">[</mo><mi>MASK</mi><mo stretchy="false">]</mo></mrow><annotation encoding="application/x-tex">\mathrm{[MASK]}</annotation></semantics></math>, i.e., <math id="A8.p1.m4" class="ltx_math_unparsed" alttext="x_{t}=x_{t}^{-i}\oplus_{i}\mathrm{[MASK]}" display="inline" intent=":literal"><semantics><mrow><msub><mi>x</mi><mi>t</mi></msub><mo>=</mo><msubsup><mi>x</mi><mi>t</mi><mrow><mo>−</mo><mi>i</mi></mrow></msubsup><msub><mo>⊕</mo><mi>i</mi></msub><mrow><mo stretchy="false">[</mo><mi>MASK</mi><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">x_{t}=x_{t}^{-i}\oplus_{i}\mathrm{[MASK]}</annotation></semantics></math>. Recall the connection between the score estimator <math id="A8.p1.m5" class="ltx_Math" alttext="s_{t}(y,x)" display="inline" intent=":literal"><semantics><mrow><msub><mi>s</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>y</mi><mo>,</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">s_{t}(y,x)</annotation></semantics></math> and <math id="A8.p1.m6" class="ltx_Math" alttext="\mu_{\theta}" display="inline" intent=":literal"><semantics><msub><mi>μ</mi><mi>θ</mi></msub><annotation encoding="application/x-tex">\mu_{\theta}</annotation></semantics></math> in (<a href="#S2.E11" title="Equation 11 ‣ 2.3 D3PM and MDM ‣ 2 Preliminaries of Discrete Diffusion Models ‣ Sharp Convergence Rates for Masked Diffusion Models" class="ltx_ref"><span class="ltx_text ltx_ref_tag">11</span></a>)</p>
<table id="A8.Ex109" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A8.Ex109.m1" class="ltx_math_unparsed" alttext="s_{t}(x_{t}^{-i}\oplus_{i}a,x_{t})=\frac{\alpha_{t}}{1-\alpha_{t}}\,\mu_{\theta}^{i}(x_{t},t)[a]," display="block" intent=":literal"><semantics><mrow><msub><mi>s</mi><mi>t</mi></msub><mrow><mo stretchy="false">(</mo><msubsup><mi>x</mi><mi>t</mi><mrow><mo>−</mo><mi>i</mi></mrow></msubsup><msub><mo>⊕</mo><mi>i</mi></msub><mi>a</mi><mo>,</mo><msub><mi>x</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow><mo>=</mo><mfrac><msub><mi>α</mi><mi>t</mi></msub><mrow><mn>1</mn><mo>−</mo><msub><mi>α</mi><mi>t</mi></msub></mrow></mfrac><msubsup><mi>μ</mi><mi>θ</mi><mi>i</mi></msubsup><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mi>t</mi></msub><mo>,</mo><mi>t</mi><mo stretchy="false">)</mo></mrow><mrow><mo stretchy="false">[</mo><mi>a</mi><mo stretchy="false">]</mo></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">s_{t}(x_{t}^{-i}\oplus_{i}a,x_{t})=\frac{\alpha_{t}}{1-\alpha_{t}}\,\mu_{\theta}^{i}(x_{t},t)[a],</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="A8.p2" class="ltx_para ltx_noindent">
<p id="A8.p2.1" class="ltx_p">and the connection between concrete score and clean data distribution in (<a href="#S2.E12" title="Equation 12 ‣ 2.3 D3PM and MDM ‣ 2 Preliminaries of Discrete Diffusion Models ‣ Sharp Convergence Rates for Masked Diffusion Models" class="ltx_ref"><span class="ltx_text ltx_ref_tag">12</span></a>)</p>
<table id="A8.Ex110" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A8.Ex110.m1" class="ltx_Math" alttext="\frac{q_{t}(x_{t}^{-i}\oplus_{i}a)}{q_{t}(x_{t})}=\frac{\alpha_{t}}{1-\alpha_{t}}\,q_{0}^{i}(a|x_{t}^{UM})," display="block" intent=":literal"><semantics><mrow><mrow><mfrac><mrow><mi>q</mi><msub><mrow></mrow><mi>t</mi></msub><mo stretchy="false">(</mo><mi>x</mi><msub><mrow></mrow><mi>t</mi></msub><msup><mrow></mrow><mrow><mo>−</mo><mi>i</mi></mrow></msup><mo>⊕</mo><msub><mrow></mrow><mi>i</mi></msub><mi>a</mi><mo stretchy="false">)</mo></mrow><mrow><msub><mi>q</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mfrac><mo>=</mo><mrow><mfrac><msub><mi>α</mi><mi>t</mi></msub><mrow><mn>1</mn><mo>−</mo><msub><mi>α</mi><mi>t</mi></msub></mrow></mfrac><mo lspace="0.170em" rspace="0em">​</mo><msubsup><mi>q</mi><mn>0</mn><mi>i</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>a</mi><mo lspace="0em" rspace="0em">|</mo><msubsup><mi>x</mi><mi>t</mi><mrow><mi>U</mi><mo lspace="0em" rspace="0em">​</mo><mi>M</mi></mrow></msubsup><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\frac{q_{t}(x_{t}^{-i}\oplus_{i}a)}{q_{t}(x_{t})}=\frac{\alpha_{t}}{1-\alpha_{t}}\,q_{0}^{i}(a|x_{t}^{UM}),</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A8.p2.2" class="ltx_p">where <math id="A8.p2.m1" class="ltx_Math" alttext="x_{t}^{UM}" display="inline" intent=":literal"><semantics><msubsup><mi>x</mi><mi>t</mi><mrow><mi>U</mi><mo lspace="0em" rspace="0em">​</mo><mi>M</mi></mrow></msubsup><annotation encoding="application/x-tex">x_{t}^{UM}</annotation></semantics></math> denotes the unmasked token collection of <math id="A8.p2.m2" class="ltx_Math" alttext="x_{t}" display="inline" intent=":literal"><semantics><msub><mi>x</mi><mi>t</mi></msub><annotation encoding="application/x-tex">x_{t}</annotation></semantics></math>.</p>
</div>
<div id="A8.p3" class="ltx_para ltx_noindent">
<p id="A8.p3.1" class="ltx_p">Then we have</p>
<table id="A8.E23" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A8.E23.m1" class="ltx_Math" alttext="\sum_{a\neq\mathrm{[MASK]}}\frac{q_{t}(x_{t}^{-i}\oplus_{i}a)}{q_{t}(x_{t})}=\frac{\alpha_{t}}{1-\alpha_{t}}\sum_{a\neq\mathrm{[MASK]}}q_{0}^{i}(a|x_{t}^{UM})=\frac{\alpha_{t}}{1-\alpha_{t}}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><munder><mo movablelimits="false">∑</mo><mrow><mi>a</mi><mo>≠</mo><mrow><mo stretchy="false">[</mo><mi>MASK</mi><mo stretchy="false">]</mo></mrow></mrow></munder><mfrac><mrow><mi>q</mi><msub><mrow></mrow><mi>t</mi></msub><mo stretchy="false">(</mo><mi>x</mi><msub><mrow></mrow><mi>t</mi></msub><msup><mrow></mrow><mrow><mo>−</mo><mi>i</mi></mrow></msup><mo>⊕</mo><msub><mrow></mrow><mi>i</mi></msub><mi>a</mi><mo stretchy="false">)</mo></mrow><mrow><msub><mi>q</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mfrac></mrow><mo>=</mo><mrow><mfrac><msub><mi>α</mi><mi>t</mi></msub><mrow><mn>1</mn><mo>−</mo><msub><mi>α</mi><mi>t</mi></msub></mrow></mfrac><mo lspace="0em" rspace="0em">​</mo><mrow><munder><mo movablelimits="false">∑</mo><mrow><mi>a</mi><mo>≠</mo><mrow><mo stretchy="false">[</mo><mi>MASK</mi><mo stretchy="false">]</mo></mrow></mrow></munder><mrow><msubsup><mi>q</mi><mn>0</mn><mi>i</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>a</mi><mo lspace="0em" rspace="0em">|</mo><msubsup><mi>x</mi><mi>t</mi><mrow><mi>U</mi><mo lspace="0em" rspace="0em">​</mo><mi>M</mi></mrow></msubsup><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo>=</mo><mfrac><msub><mi>α</mi><mi>t</mi></msub><mrow><mn>1</mn><mo>−</mo><msub><mi>α</mi><mi>t</mi></msub></mrow></mfrac></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\sum_{a\neq\mathrm{[MASK]}}\frac{q_{t}(x_{t}^{-i}\oplus_{i}a)}{q_{t}(x_{t})}=\frac{\alpha_{t}}{1-\alpha_{t}}\sum_{a\neq\mathrm{[MASK]}}q_{0}^{i}(a|x_{t}^{UM})=\frac{\alpha_{t}}{1-\alpha_{t}}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(23)</span></td></tr></tbody>
</table>
</div>
<div id="A8.p4" class="ltx_para ltx_noindent">
<p id="A8.p4.1" class="ltx_p">Based on the definition of the integrated <math id="A8.p4.m1" class="ltx_Math" alttext="\mathcal{L}_{SE}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">ℒ</mi><mrow><mi>S</mi><mo lspace="0em" rspace="0em">​</mo><mi>E</mi></mrow></msub><annotation encoding="application/x-tex">\mathcal{L}_{SE}</annotation></semantics></math> loss, we derive</p>
<table id="A8.EGx21" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A8.Ex111"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A8.Ex111.m1" class="ltx_Math" alttext="\displaystyle\int_{0}^{+\infty}\mathcal{L}_{SE}(s,t)\,\mathrm{d}t" display="inline" intent=":literal"><semantics><mrow><mstyle displaystyle="true"><msubsup><mo>∫</mo><mn>0</mn><mrow><mo>+</mo><mi mathvariant="normal">∞</mi></mrow></msubsup></mstyle><mrow><msub><mi class="ltx_font_mathcaligraphic">ℒ</mi><mrow><mi>S</mi><mo lspace="0em" rspace="0em">​</mo><mi>E</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>s</mi><mo>,</mo><mi>t</mi><mo stretchy="false">)</mo></mrow><mo lspace="0.170em" rspace="0em">​</mo><mrow><mo rspace="0em">𝑑</mo><mi>t</mi></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\int_{0}^{+\infty}\mathcal{L}_{SE}(s,t)\,\mathrm{d}t</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A8.Ex111.m2" class="ltx_Math" alttext="\displaystyle=\int_{0}^{+\infty}\mathbb{E}_{x_{t}\sim q_{t}}\sum_{y\neq x_{t}}R_{t}(y,x_{t})\Big(s_{t}(y,x_{t})-\frac{q_{t}(y)}{q_{t}(x_{t})}-\frac{q_{t}(y)}{q_{t}(x_{t})}\log\tfrac{s_{t}(y,x_{t})}{q_{t}(y)/q_{t}(x_{t})}\Big)\,\mathrm{d}t" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mstyle displaystyle="true"><msubsup><mo>∫</mo><mn>0</mn><mrow><mo>+</mo><mi mathvariant="normal">∞</mi></mrow></msubsup></mstyle><mrow><msub><mi>𝔼</mi><mrow><msub><mi>x</mi><mi>t</mi></msub><mo>∼</mo><msub><mi>q</mi><mi>t</mi></msub></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mi>y</mi><mo>≠</mo><msub><mi>x</mi><mi>t</mi></msub></mrow></munder></mstyle><mrow><msub><mi>R</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>y</mi><mo>,</mo><msub><mi>x</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="1.600em" minsize="1.600em">(</mo><mrow><mrow><msub><mi>s</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>y</mi><mo>,</mo><msub><mi>x</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mstyle displaystyle="true"><mfrac><mrow><msub><mi>q</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>y</mi><mo stretchy="false">)</mo></mrow></mrow><mrow><msub><mi>q</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle><mo>−</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><msub><mi>q</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>y</mi><mo stretchy="false">)</mo></mrow></mrow><mrow><msub><mi>q</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mfrac><mrow><msub><mi>s</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>y</mi><mo>,</mo><msub><mi>x</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mrow><mrow><mrow><msub><mi>q</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>y</mi><mo stretchy="false">)</mo></mrow></mrow><mo>/</mo><msub><mi>q</mi><mi>t</mi></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mfrac></mrow></mrow></mrow><mo maxsize="1.600em" minsize="1.600em">)</mo></mrow><mo lspace="0.170em" rspace="0em">​</mo><mrow><mo rspace="0em">𝑑</mo><mi>t</mi></mrow></mrow></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\int_{0}^{+\infty}\mathbb{E}_{x_{t}\sim q_{t}}\sum_{y\neq x_{t}}R_{t}(y,x_{t})\Big(s_{t}(y,x_{t})-\frac{q_{t}(y)}{q_{t}(x_{t})}-\frac{q_{t}(y)}{q_{t}(x_{t})}\log\tfrac{s_{t}(y,x_{t})}{q_{t}(y)/q_{t}(x_{t})}\Big)\,\mathrm{d}t</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A8.Ex112"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A8.Ex112.m1" class="ltx_math_unparsed" alttext="\displaystyle\overset{(i)}{=}\int_{0}^{+\infty}\mathbb{E}_{x_{t}\sim q_{t}}\sum_{l:x_{t}^{l}=\mathrm{[MASK]}}\sum_{a\neq\mathrm{[MASK]}}\left(\frac{\alpha_{t}}{1-\alpha_{t}}\mu_{\theta}^{l}(x_{t},t)[a]-\frac{q_{t}(x_{t}^{-l}\oplus_{l}a)}{q_{t}(x_{t})}\right)\mathrm{d}t" display="inline" intent=":literal"><semantics><mrow><mover accent="true"><mo>=</mo><mrow><mo maxsize="0.700em" minsize="0.700em">(</mo><mi mathsize="0.700em">i</mi><mo maxsize="0.700em" minsize="0.700em">)</mo></mrow></mover><mstyle displaystyle="true"><msubsup><mo>∫</mo><mn>0</mn><mrow><mo>+</mo><mi mathvariant="normal">∞</mi></mrow></msubsup></mstyle><msub><mi>𝔼</mi><mrow><msub><mi>x</mi><mi>t</mi></msub><mo>∼</mo><msub><mi>q</mi><mi>t</mi></msub></mrow></msub><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mi>l</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><msubsup><mi>x</mi><mi>t</mi><mi>l</mi></msubsup><mo>=</mo><mrow><mo stretchy="false">[</mo><mi>MASK</mi><mo stretchy="false">]</mo></mrow></mrow></mrow></munder></mstyle><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mi>a</mi><mo>≠</mo><mrow><mo stretchy="false">[</mo><mi>MASK</mi><mo stretchy="false">]</mo></mrow></mrow></munder></mstyle><mrow><mo>(</mo><mstyle displaystyle="true"><mfrac><msub><mi>α</mi><mi>t</mi></msub><mrow><mn>1</mn><mo>−</mo><msub><mi>α</mi><mi>t</mi></msub></mrow></mfrac></mstyle><msubsup><mi>μ</mi><mi>θ</mi><mi>l</mi></msubsup><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mi>t</mi></msub><mo>,</mo><mi>t</mi><mo stretchy="false">)</mo></mrow><mrow><mo stretchy="false">[</mo><mi>a</mi><mo stretchy="false">]</mo></mrow><mo>−</mo><mstyle displaystyle="true"><mfrac><mrow><mi>q</mi><msub><mrow></mrow><mi>t</mi></msub><mo stretchy="false">(</mo><mi>x</mi><msub><mrow></mrow><mi>t</mi></msub><msup><mrow></mrow><mrow><mo>−</mo><mi>l</mi></mrow></msup><mo>⊕</mo><msub><mrow></mrow><mi>l</mi></msub><mi>a</mi><mo stretchy="false">)</mo></mrow><mrow><msub><mi>q</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle><mo>)</mo></mrow><mi>d</mi><mi>t</mi></mrow><annotation encoding="application/x-tex">\displaystyle\overset{(i)}{=}\int_{0}^{+\infty}\mathbb{E}_{x_{t}\sim q_{t}}\sum_{l:x_{t}^{l}=\mathrm{[MASK]}}\sum_{a\neq\mathrm{[MASK]}}\left(\frac{\alpha_{t}}{1-\alpha_{t}}\mu_{\theta}^{l}(x_{t},t)[a]-\frac{q_{t}(x_{t}^{-l}\oplus_{l}a)}{q_{t}(x_{t})}\right)\mathrm{d}t</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A8.Ex113"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A8.Ex113.m1" class="ltx_math_unparsed" alttext="\displaystyle\quad-\int_{0}^{+\infty}\mathbb{E}_{x_{t}\sim q_{t}}\sum_{l:x_{t}^{l}=\mathrm{[MASK]}}\sum_{a\neq\mathrm{[MASK]}}\frac{q_{t}(x_{t}^{-l}\oplus_{l}a)}{q_{t}(x_{t})}\log\frac{\frac{\alpha_{t}}{1-\alpha_{t}}\mu_{\theta}^{l}(x_{t},t)[a]}{\frac{q_{t}(x_{t}^{-l}\oplus_{l}a)}{q_{t}(x_{t})}}\mathrm{d}t" display="inline" intent=":literal"><semantics><mrow><mo>−</mo><mstyle displaystyle="true"><mo>∫</mo></mstyle><msub><mrow></mrow><mn>0</mn></msub><msup><mrow></mrow><mrow><mo>+</mo><mi mathvariant="normal">∞</mi></mrow></msup><mi>𝔼</mi><msub><mrow></mrow><mrow><msub><mi>x</mi><mi>t</mi></msub><mo>∼</mo><msub><mi>q</mi><mi>t</mi></msub></mrow></msub><mstyle displaystyle="true"><mo movablelimits="false">∑</mo></mstyle><msub><mrow></mrow><mrow><mi>l</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><msubsup><mi>x</mi><mi>t</mi><mi>l</mi></msubsup><mo>=</mo><mrow><mo stretchy="false">[</mo><mi>MASK</mi><mo stretchy="false">]</mo></mrow></mrow></mrow></msub><mstyle displaystyle="true"><mo movablelimits="false">∑</mo></mstyle><msub><mrow></mrow><mrow><mi>a</mi><mo>≠</mo><mrow><mo stretchy="false">[</mo><mi>MASK</mi><mo stretchy="false">]</mo></mrow></mrow></msub><mstyle displaystyle="true"><mfrac><mrow><mi>q</mi><msub><mrow></mrow><mi>t</mi></msub><mo stretchy="false">(</mo><mi>x</mi><msub><mrow></mrow><mi>t</mi></msub><msup><mrow></mrow><mrow><mo>−</mo><mi>l</mi></mrow></msup><mo>⊕</mo><msub><mrow></mrow><mi>l</mi></msub><mi>a</mi><mo stretchy="false">)</mo></mrow><mrow><msub><mi>q</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle><mi>log</mi><mstyle displaystyle="true"><mfrac><mrow><mfrac><msub><mi>α</mi><mi>t</mi></msub><mrow><mn>1</mn><mo>−</mo><msub><mi>α</mi><mi>t</mi></msub></mrow></mfrac><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>μ</mi><mi>θ</mi><mi>l</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mi>t</mi></msub><mo>,</mo><mi>t</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mi>a</mi><mo stretchy="false">]</mo></mrow></mrow><mfrac><mrow><mi>q</mi><msub><mrow></mrow><mi>t</mi></msub><mo stretchy="false">(</mo><mi>x</mi><msub><mrow></mrow><mi>t</mi></msub><msup><mrow></mrow><mrow><mo>−</mo><mi>l</mi></mrow></msup><mo>⊕</mo><msub><mrow></mrow><mi>l</mi></msub><mi>a</mi><mo stretchy="false">)</mo></mrow><mrow><msub><mi>q</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mfrac></mfrac></mstyle><mi>d</mi><mi>t</mi></mrow><annotation encoding="application/x-tex">\displaystyle\quad-\int_{0}^{+\infty}\mathbb{E}_{x_{t}\sim q_{t}}\sum_{l:x_{t}^{l}=\mathrm{[MASK]}}\sum_{a\neq\mathrm{[MASK]}}\frac{q_{t}(x_{t}^{-l}\oplus_{l}a)}{q_{t}(x_{t})}\log\frac{\frac{\alpha_{t}}{1-\alpha_{t}}\mu_{\theta}^{l}(x_{t},t)[a]}{\frac{q_{t}(x_{t}^{-l}\oplus_{l}a)}{q_{t}(x_{t})}}\mathrm{d}t</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A8.Ex114"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A8.Ex114.m1" class="ltx_math_unparsed" alttext="\displaystyle\overset{(ii)}{=}0-\int_{0}^{+\infty}\mathbb{E}_{x_{t}\sim q_{t}}\sum_{l:x_{t}^{l}=\mathrm{[MASK]}}\sum_{a\neq\mathrm{[MASK]}}\frac{q_{t}(x_{t}^{-l}\oplus_{l}a)}{q_{t}(x_{t})}\log\frac{\frac{\alpha_{t}}{1-\alpha_{t}}\mu_{\theta}^{l}(x_{t},t)[a]}{\frac{q_{t}(x_{t}^{-l}\oplus_{l}a)}{q_{t}(x_{t})}}\mathrm{d}t" display="inline" intent=":literal"><semantics><mrow><mover accent="true"><mo>=</mo><mrow><mo maxsize="0.700em" minsize="0.700em">(</mo><mrow><mi mathsize="0.700em">i</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.700em">i</mi></mrow><mo maxsize="0.700em" minsize="0.700em">)</mo></mrow></mover><mn>0</mn><mo>−</mo><mstyle displaystyle="true"><mo>∫</mo></mstyle><msub><mrow></mrow><mn>0</mn></msub><msup><mrow></mrow><mrow><mo>+</mo><mi mathvariant="normal">∞</mi></mrow></msup><mi>𝔼</mi><msub><mrow></mrow><mrow><msub><mi>x</mi><mi>t</mi></msub><mo>∼</mo><msub><mi>q</mi><mi>t</mi></msub></mrow></msub><mstyle displaystyle="true"><mo movablelimits="false">∑</mo></mstyle><msub><mrow></mrow><mrow><mi>l</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><msubsup><mi>x</mi><mi>t</mi><mi>l</mi></msubsup><mo>=</mo><mrow><mo stretchy="false">[</mo><mi>MASK</mi><mo stretchy="false">]</mo></mrow></mrow></mrow></msub><mstyle displaystyle="true"><mo movablelimits="false">∑</mo></mstyle><msub><mrow></mrow><mrow><mi>a</mi><mo>≠</mo><mrow><mo stretchy="false">[</mo><mi>MASK</mi><mo stretchy="false">]</mo></mrow></mrow></msub><mstyle displaystyle="true"><mfrac><mrow><mi>q</mi><msub><mrow></mrow><mi>t</mi></msub><mo stretchy="false">(</mo><mi>x</mi><msub><mrow></mrow><mi>t</mi></msub><msup><mrow></mrow><mrow><mo>−</mo><mi>l</mi></mrow></msup><mo>⊕</mo><msub><mrow></mrow><mi>l</mi></msub><mi>a</mi><mo stretchy="false">)</mo></mrow><mrow><msub><mi>q</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle><mi>log</mi><mstyle displaystyle="true"><mfrac><mrow><mfrac><msub><mi>α</mi><mi>t</mi></msub><mrow><mn>1</mn><mo>−</mo><msub><mi>α</mi><mi>t</mi></msub></mrow></mfrac><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>μ</mi><mi>θ</mi><mi>l</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mi>t</mi></msub><mo>,</mo><mi>t</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mi>a</mi><mo stretchy="false">]</mo></mrow></mrow><mfrac><mrow><mi>q</mi><msub><mrow></mrow><mi>t</mi></msub><mo stretchy="false">(</mo><mi>x</mi><msub><mrow></mrow><mi>t</mi></msub><msup><mrow></mrow><mrow><mo>−</mo><mi>l</mi></mrow></msup><mo>⊕</mo><msub><mrow></mrow><mi>l</mi></msub><mi>a</mi><mo stretchy="false">)</mo></mrow><mrow><msub><mi>q</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mfrac></mfrac></mstyle><mi>d</mi><mi>t</mi></mrow><annotation encoding="application/x-tex">\displaystyle\overset{(ii)}{=}0-\int_{0}^{+\infty}\mathbb{E}_{x_{t}\sim q_{t}}\sum_{l:x_{t}^{l}=\mathrm{[MASK]}}\sum_{a\neq\mathrm{[MASK]}}\frac{q_{t}(x_{t}^{-l}\oplus_{l}a)}{q_{t}(x_{t})}\log\frac{\frac{\alpha_{t}}{1-\alpha_{t}}\mu_{\theta}^{l}(x_{t},t)[a]}{\frac{q_{t}(x_{t}^{-l}\oplus_{l}a)}{q_{t}(x_{t})}}\mathrm{d}t</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A8.Ex115"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A8.Ex115.m1" class="ltx_math_unparsed" alttext="\displaystyle\overset{(iii)}{=}-\int_{0}^{+\infty}\mathbb{E}_{x_{t}\sim q_{t}}\sum_{l:x_{t}^{l}=\mathrm{[MASK]}}\sum_{a\neq\mathrm{[MASK]}}\frac{\alpha_{t}}{1-\alpha_{t}}q_{0}^{l}(a|x_{t}^{UM})\log\frac{\mu_{\theta}^{l}(x_{t},t)[a]}{q_{0}^{l}(a|x_{t}^{UM})}\mathrm{d}t" display="inline" intent=":literal"><semantics><mrow><mover accent="true"><mo>=</mo><mrow><mo maxsize="0.700em" minsize="0.700em">(</mo><mrow><mi mathsize="0.700em">i</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.700em">i</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.700em">i</mi></mrow><mo maxsize="0.700em" minsize="0.700em">)</mo></mrow></mover><mo lspace="0em">−</mo><mstyle displaystyle="true"><msubsup><mo>∫</mo><mn>0</mn><mrow><mo>+</mo><mi mathvariant="normal">∞</mi></mrow></msubsup></mstyle><msub><mi>𝔼</mi><mrow><msub><mi>x</mi><mi>t</mi></msub><mo>∼</mo><msub><mi>q</mi><mi>t</mi></msub></mrow></msub><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mi>l</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><msubsup><mi>x</mi><mi>t</mi><mi>l</mi></msubsup><mo>=</mo><mrow><mo stretchy="false">[</mo><mi>MASK</mi><mo stretchy="false">]</mo></mrow></mrow></mrow></munder></mstyle><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mi>a</mi><mo>≠</mo><mrow><mo stretchy="false">[</mo><mi>MASK</mi><mo stretchy="false">]</mo></mrow></mrow></munder></mstyle><mstyle displaystyle="true"><mfrac><msub><mi>α</mi><mi>t</mi></msub><mrow><mn>1</mn><mo>−</mo><msub><mi>α</mi><mi>t</mi></msub></mrow></mfrac></mstyle><msubsup><mi>q</mi><mn>0</mn><mi>l</mi></msubsup><mrow><mo stretchy="false">(</mo><mi>a</mi><mo fence="false" rspace="0.167em" stretchy="false">|</mo><msubsup><mi>x</mi><mi>t</mi><mrow><mi>U</mi><mo lspace="0em" rspace="0em">​</mo><mi>M</mi></mrow></msubsup><mo rspace="0.167em" stretchy="false">)</mo></mrow><mi>log</mi><mstyle displaystyle="true"><mfrac><mrow><msubsup><mi>μ</mi><mi>θ</mi><mi>l</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mi>t</mi></msub><mo>,</mo><mi>t</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mi>a</mi><mo stretchy="false">]</mo></mrow></mrow><mrow><msubsup><mi>q</mi><mn>0</mn><mi>l</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>a</mi><mo lspace="0em" rspace="0em">|</mo><msubsup><mi>x</mi><mi>t</mi><mrow><mi>U</mi><mo lspace="0em" rspace="0em">​</mo><mi>M</mi></mrow></msubsup><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle><mi>d</mi><mi>t</mi></mrow><annotation encoding="application/x-tex">\displaystyle\overset{(iii)}{=}-\int_{0}^{+\infty}\mathbb{E}_{x_{t}\sim q_{t}}\sum_{l:x_{t}^{l}=\mathrm{[MASK]}}\sum_{a\neq\mathrm{[MASK]}}\frac{\alpha_{t}}{1-\alpha_{t}}q_{0}^{l}(a|x_{t}^{UM})\log\frac{\mu_{\theta}^{l}(x_{t},t)[a]}{q_{0}^{l}(a|x_{t}^{UM})}\mathrm{d}t</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A8.Ex116"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A8.Ex116.m1" class="ltx_math_unparsed" alttext="\displaystyle=\int_{0}^{+\infty}-\frac{\alpha_{t}}{1-\alpha_{t}}\mathbb{E}_{x_{t}}\sum_{l:x_{t}^{l}=\mathrm{[MASK]}}\sum_{a\neq\mathrm{[MASK]}}q_{0}^{l}(a|x_{t}^{UM})\log\mu_{\theta}^{l}(x_{t},t)[a]\,\mathrm{d}t" display="inline" intent=":literal"><semantics><mrow><mo>=</mo><mstyle displaystyle="true"><msubsup><mo>∫</mo><mn>0</mn><mrow><mo>+</mo><mi mathvariant="normal">∞</mi></mrow></msubsup></mstyle><mo>−</mo><mstyle displaystyle="true"><mfrac><msub><mi>α</mi><mi>t</mi></msub><mrow><mn>1</mn><mo>−</mo><msub><mi>α</mi><mi>t</mi></msub></mrow></mfrac></mstyle><msub><mi>𝔼</mi><msub><mi>x</mi><mi>t</mi></msub></msub><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mi>l</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><msubsup><mi>x</mi><mi>t</mi><mi>l</mi></msubsup><mo>=</mo><mrow><mo stretchy="false">[</mo><mi>MASK</mi><mo stretchy="false">]</mo></mrow></mrow></mrow></munder></mstyle><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mi>a</mi><mo>≠</mo><mrow><mo stretchy="false">[</mo><mi>MASK</mi><mo stretchy="false">]</mo></mrow></mrow></munder></mstyle><msubsup><mi>q</mi><mn>0</mn><mi>l</mi></msubsup><mrow><mo stretchy="false">(</mo><mi>a</mi><mo fence="false" rspace="0.167em" stretchy="false">|</mo><msubsup><mi>x</mi><mi>t</mi><mrow><mi>U</mi><mo lspace="0em" rspace="0em">​</mo><mi>M</mi></mrow></msubsup><mo rspace="0.167em" stretchy="false">)</mo></mrow><mi>log</mi><msubsup><mi>μ</mi><mi>θ</mi><mi>l</mi></msubsup><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mi>t</mi></msub><mo>,</mo><mi>t</mi><mo stretchy="false">)</mo></mrow><mrow><mo stretchy="false">[</mo><mi>a</mi><mo rspace="0.170em" stretchy="false">]</mo></mrow><mi>d</mi><mi>t</mi></mrow><annotation encoding="application/x-tex">\displaystyle=\int_{0}^{+\infty}-\frac{\alpha_{t}}{1-\alpha_{t}}\mathbb{E}_{x_{t}}\sum_{l:x_{t}^{l}=\mathrm{[MASK]}}\sum_{a\neq\mathrm{[MASK]}}q_{0}^{l}(a|x_{t}^{UM})\log\mu_{\theta}^{l}(x_{t},t)[a]\,\mathrm{d}t</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A8.E24"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A8.E24.m1" class="ltx_math_unparsed" alttext="\displaystyle\quad-\int_{0}^{+\infty}\frac{\alpha_{t}}{1-\alpha_{t}}\mathbb{E}_{x_{t}}\sum_{l:x_{t}^{l}=\mathrm{[MASK]}}H\left(q_{0}^{l}(\cdot|x_{t}^{UM})\right)\,\mathrm{d}t," display="inline" intent=":literal"><semantics><mrow><mo>−</mo><mstyle displaystyle="true"><msubsup><mo>∫</mo><mn>0</mn><mrow><mo>+</mo><mi mathvariant="normal">∞</mi></mrow></msubsup></mstyle><mstyle displaystyle="true"><mfrac><msub><mi>α</mi><mi>t</mi></msub><mrow><mn>1</mn><mo>−</mo><msub><mi>α</mi><mi>t</mi></msub></mrow></mfrac></mstyle><msub><mi>𝔼</mi><msub><mi>x</mi><mi>t</mi></msub></msub><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mi>l</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><msubsup><mi>x</mi><mi>t</mi><mi>l</mi></msubsup><mo>=</mo><mrow><mo stretchy="false">[</mo><mi>MASK</mi><mo stretchy="false">]</mo></mrow></mrow></mrow></munder></mstyle><mi>H</mi><mrow><mo>(</mo><msubsup><mi>q</mi><mn>0</mn><mi>l</mi></msubsup><mrow><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><msubsup><mi>x</mi><mi>t</mi><mrow><mi>U</mi><mo lspace="0em" rspace="0em">​</mo><mi>M</mi></mrow></msubsup><mo stretchy="false">)</mo></mrow><mo rspace="0.170em">)</mo></mrow><mi>d</mi><mi>t</mi><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\quad-\int_{0}^{+\infty}\frac{\alpha_{t}}{1-\alpha_{t}}\mathbb{E}_{x_{t}}\sum_{l:x_{t}^{l}=\mathrm{[MASK]}}H\left(q_{0}^{l}(\cdot|x_{t}^{UM})\right)\,\mathrm{d}t,</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(24)</span></td></tr></tbody>
</table>
<p id="A8.p4.2" class="ltx_p">where <math id="A8.p4.m2" class="ltx_Math" alttext="(i)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(i)</annotation></semantics></math> follows from (<a href="#S2.E11" title="Equation 11 ‣ 2.3 D3PM and MDM ‣ 2 Preliminaries of Discrete Diffusion Models ‣ Sharp Convergence Rates for Masked Diffusion Models" class="ltx_ref"><span class="ltx_text ltx_ref_tag">11</span></a>), <math id="A8.p4.m3" class="ltx_Math" alttext="(ii)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>i</mi></mrow><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(ii)</annotation></semantics></math> follows from (<a href="#A8.E23" title="Equation 23 ‣ Appendix H Proof of ‣ Sharp Convergence Rates for Masked Diffusion Models" class="ltx_ref"><span class="ltx_text ltx_ref_tag">23</span></a>) and because <math id="A8.p4.m4" class="ltx_Math" alttext="\sum_{a\neq\mathrm{[MASK]}}\mu_{\theta}^{l}(x_{t},t)[a]=1" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mo>∑</mo><mrow><mi>a</mi><mo>≠</mo><mrow><mo stretchy="false">[</mo><mi>MASK</mi><mo stretchy="false">]</mo></mrow></mrow></msub><mrow><msubsup><mi>μ</mi><mi>θ</mi><mi>l</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mi>t</mi></msub><mo>,</mo><mi>t</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mi>a</mi><mo stretchy="false">]</mo></mrow></mrow></mrow><mo>=</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">\sum_{a\neq\mathrm{[MASK]}}\mu_{\theta}^{l}(x_{t},t)[a]=1</annotation></semantics></math>, and <math id="A8.p4.m5" class="ltx_Math" alttext="(iii)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>i</mi></mrow><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(iii)</annotation></semantics></math> follows from (<a href="#S2.E12" title="Equation 12 ‣ 2.3 D3PM and MDM ‣ 2 Preliminaries of Discrete Diffusion Models ‣ Sharp Convergence Rates for Masked Diffusion Models" class="ltx_ref"><span class="ltx_text ltx_ref_tag">12</span></a>), and <math id="A8.p4.m6" class="ltx_Math" alttext="H(\cdot)" display="inline" intent=":literal"><semantics><mrow><mi>H</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">H(\cdot)</annotation></semantics></math> in the last equality denotes the entropy. The derivation of (<a href="#A8.E24" title="Equation 24 ‣ Appendix H Proof of ‣ Sharp Convergence Rates for Masked Diffusion Models" class="ltx_ref"><span class="ltx_text ltx_ref_tag">24</span></a>) implies that <math id="A8.p4.m7" class="ltx_Math" alttext="\int_{0}^{+\infty}\mathcal{L}_{SE}(s,t)\,\mathrm{d}t=0" display="inline" intent=":literal"><semantics><mrow><mrow><msubsup><mo>∫</mo><mn>0</mn><mrow><mo>+</mo><mi mathvariant="normal">∞</mi></mrow></msubsup><mrow><msub><mi class="ltx_font_mathcaligraphic">ℒ</mi><mrow><mi>S</mi><mo lspace="0em" rspace="0em">​</mo><mi>E</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>s</mi><mo>,</mo><mi>t</mi><mo stretchy="false">)</mo></mrow><mo lspace="0.170em" rspace="0em">​</mo><mrow><mo rspace="0em">𝑑</mo><mi>t</mi></mrow></mrow></mrow><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\int_{0}^{+\infty}\mathcal{L}_{SE}(s,t)\,\mathrm{d}t=0</annotation></semantics></math> if and only if <math id="A8.p4.m8" class="ltx_math_unparsed" alttext="q_{0}^{l}(\cdot|x_{t}^{UM})=\mu_{\theta}^{l}(x_{t},t)[\cdot]" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>q</mi><mn>0</mn><mi>l</mi></msubsup><mrow><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><msubsup><mi>x</mi><mi>t</mi><mrow><mi>U</mi><mo lspace="0em" rspace="0em">​</mo><mi>M</mi></mrow></msubsup><mo stretchy="false">)</mo></mrow><mo>=</mo><msubsup><mi>μ</mi><mi>θ</mi><mi>l</mi></msubsup><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mi>t</mi></msub><mo>,</mo><mi>t</mi><mo stretchy="false">)</mo></mrow><mrow><mo stretchy="false">[</mo><mo lspace="0em" rspace="0em">⋅</mo><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">q_{0}^{l}(\cdot|x_{t}^{UM})=\mu_{\theta}^{l}(x_{t},t)[\cdot]</annotation></semantics></math> for all <math id="A8.p4.m9" class="ltx_Math" alttext="t" display="inline" intent=":literal"><semantics><mi>t</mi><annotation encoding="application/x-tex">t</annotation></semantics></math>, <math id="A8.p4.m10" class="ltx_Math" alttext="x_{t}" display="inline" intent=":literal"><semantics><msub><mi>x</mi><mi>t</mi></msub><annotation encoding="application/x-tex">x_{t}</annotation></semantics></math>, and <math id="A8.p4.m11" class="ltx_Math" alttext="l" display="inline" intent=":literal"><semantics><mi>l</mi><annotation encoding="application/x-tex">l</annotation></semantics></math>.</p>
</div>
<div id="A8.p5" class="ltx_para ltx_noindent">
<p id="A8.p5.1" class="ltx_p">First, we show that the first term in (<a href="#A8.E24" title="Equation 24 ‣ Appendix H Proof of ‣ Sharp Convergence Rates for Masked Diffusion Models" class="ltx_ref"><span class="ltx_text ltx_ref_tag">24</span></a>) satisfies:</p>
<table id="A8.E25" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A8.E25.m1" class="ltx_math_unparsed" alttext="\int_{0}^{+\infty}-\frac{\alpha_{t}}{1-\alpha_{t}}\mathbb{E}_{x_{t}}\sum_{l:x_{t}^{l}=\mathrm{[MASK]}}\sum_{a\neq\mathrm{[MASK]}}q_{0}^{l}(a|x_{t}^{UM})\log\mu_{\theta}^{l}(x_{t},t)[a]\,\mathrm{d}t=\mathbb{E}_{x_{0}\sim q_{0}}[\mathcal{L}_{\infty}(x_{0})]." display="block" intent=":literal"><semantics><mrow><msubsup><mo>∫</mo><mn>0</mn><mrow><mo>+</mo><mi mathvariant="normal">∞</mi></mrow></msubsup><mo lspace="0em">−</mo><mfrac><msub><mi>α</mi><mi>t</mi></msub><mrow><mn>1</mn><mo>−</mo><msub><mi>α</mi><mi>t</mi></msub></mrow></mfrac><msub><mi>𝔼</mi><msub><mi>x</mi><mi>t</mi></msub></msub><munder><mo movablelimits="false" rspace="0em">∑</mo><mrow><mi>l</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><msubsup><mi>x</mi><mi>t</mi><mi>l</mi></msubsup><mo>=</mo><mrow><mo stretchy="false">[</mo><mi>MASK</mi><mo stretchy="false">]</mo></mrow></mrow></mrow></munder><munder><mo movablelimits="false">∑</mo><mrow><mi>a</mi><mo>≠</mo><mrow><mo stretchy="false">[</mo><mi>MASK</mi><mo stretchy="false">]</mo></mrow></mrow></munder><msubsup><mi>q</mi><mn>0</mn><mi>l</mi></msubsup><mrow><mo stretchy="false">(</mo><mi>a</mi><mo fence="false" rspace="0.167em" stretchy="false">|</mo><msubsup><mi>x</mi><mi>t</mi><mrow><mi>U</mi><mo lspace="0em" rspace="0em">​</mo><mi>M</mi></mrow></msubsup><mo rspace="0.167em" stretchy="false">)</mo></mrow><mi>log</mi><msubsup><mi>μ</mi><mi>θ</mi><mi>l</mi></msubsup><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mi>t</mi></msub><mo>,</mo><mi>t</mi><mo stretchy="false">)</mo></mrow><mrow><mo stretchy="false">[</mo><mi>a</mi><mo rspace="0.170em" stretchy="false">]</mo></mrow><mi>d</mi><mi>t</mi><mo>=</mo><msub><mi>𝔼</mi><mrow><msub><mi>x</mi><mn>0</mn></msub><mo>∼</mo><msub><mi>q</mi><mn>0</mn></msub></mrow></msub><mrow><mo stretchy="false">[</mo><msub><mi class="ltx_font_mathcaligraphic">ℒ</mi><mi mathvariant="normal">∞</mi></msub><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mn>0</mn></msub><mo stretchy="false">)</mo></mrow><mo stretchy="false">]</mo></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\int_{0}^{+\infty}-\frac{\alpha_{t}}{1-\alpha_{t}}\mathbb{E}_{x_{t}}\sum_{l:x_{t}^{l}=\mathrm{[MASK]}}\sum_{a\neq\mathrm{[MASK]}}q_{0}^{l}(a|x_{t}^{UM})\log\mu_{\theta}^{l}(x_{t},t)[a]\,\mathrm{d}t=\mathbb{E}_{x_{0}\sim q_{0}}[\mathcal{L}_{\infty}(x_{0})].</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(25)</span></td></tr></tbody>
</table>
<p id="A8.p5.2" class="ltx_p">To proceed, by the definition of NELBO <math id="A8.p5.m1" class="ltx_Math" alttext="\mathcal{L}_{\infty}(x_{0})" display="inline" intent=":literal"><semantics><mrow><msub><mi class="ltx_font_mathcaligraphic">ℒ</mi><mi mathvariant="normal">∞</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mn>0</mn></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathcal{L}_{\infty}(x_{0})</annotation></semantics></math> in (<a href="#S2.E10" title="Equation 10 ‣ 2.3 D3PM and MDM ‣ 2 Preliminaries of Discrete Diffusion Models ‣ Sharp Convergence Rates for Masked Diffusion Models" class="ltx_ref"><span class="ltx_text ltx_ref_tag">10</span></a>), we have</p>
<table id="A8.Ex117" class="ltx_equationgroup ltx_eqn_table">

<tbody id="A8.Ex117X"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A8.Ex117X.m2" class="ltx_Math" alttext="\displaystyle\mathbb{E}_{x_{0}\sim q_{0}}[\mathcal{L}_{\infty}(x_{0})]" display="inline" intent=":literal"><semantics><mrow><msub><mi>𝔼</mi><mrow><msub><mi>x</mi><mn>0</mn></msub><mo>∼</mo><msub><mi>q</mi><mn>0</mn></msub></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mrow><msub><mi class="ltx_font_mathcaligraphic">ℒ</mi><mi mathvariant="normal">∞</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mn>0</mn></msub><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\mathbb{E}_{x_{0}\sim q_{0}}[\mathcal{L}_{\infty}(x_{0})]</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A8.Ex117X.m3" class="ltx_Math" alttext="\displaystyle=\int_{0}^{+\infty}-\frac{\alpha_{t}}{1-\alpha_{t}}\mathbb{E}_{x_{t},x_{0}}\sum_{l:x_{t}^{l}=\mathrm{[MASK]}}\log\mu_{\theta}^{l}(x_{t},t)[x_{0}^{l}]\,\mathrm{d}t" display="inline" intent=":literal"><semantics><mrow><mo>=</mo><mstyle displaystyle="true"><mo>∫</mo></mstyle><msub><mrow></mrow><mn>0</mn></msub><msup><mrow></mrow><mrow><mo>+</mo><mi mathvariant="normal">∞</mi></mrow></msup><mo lspace="0em">−</mo><mstyle displaystyle="true"><mfrac><msub><mi>α</mi><mi>t</mi></msub><mrow><mn>1</mn><mo>−</mo><msub><mi>α</mi><mi>t</mi></msub></mrow></mfrac></mstyle><mi>𝔼</mi><msub><mrow></mrow><mrow><msub><mi>x</mi><mi>t</mi></msub><mo>,</mo><msub><mi>x</mi><mn>0</mn></msub></mrow></msub><mstyle displaystyle="true"><mo movablelimits="false">∑</mo></mstyle><msub><mrow></mrow><mrow><mi>l</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><msubsup><mi>x</mi><mi>t</mi><mi>l</mi></msubsup><mo>=</mo><mrow><mo stretchy="false">[</mo><mi>MASK</mi><mo stretchy="false">]</mo></mrow></mrow></mrow></msub><mi>log</mi><mi>μ</mi><msub><mrow></mrow><mi>θ</mi></msub><msup><mrow></mrow><mi>l</mi></msup><mo stretchy="false">(</mo><mi>x</mi><msub><mrow></mrow><mi>t</mi></msub><mo>,</mo><mi>t</mi><mo stretchy="false">)</mo><mo stretchy="false">[</mo><mi>x</mi><msub><mrow></mrow><mn>0</mn></msub><msup><mrow></mrow><mi>l</mi></msup><mo rspace="0.170em" stretchy="false">]</mo><mi>d</mi><mi>t</mi></mrow><annotation encoding="application/x-tex">\displaystyle=\int_{0}^{+\infty}-\frac{\alpha_{t}}{1-\alpha_{t}}\mathbb{E}_{x_{t},x_{0}}\sum_{l:x_{t}^{l}=\mathrm{[MASK]}}\log\mu_{\theta}^{l}(x_{t},t)[x_{0}^{l}]\,\mathrm{d}t</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A8.Ex117Xa"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A8.Ex117Xa.m2" class="ltx_Math" alttext="\displaystyle=\int_{0}^{+\infty}-\frac{\alpha_{t}}{1-\alpha_{t}}\mathbb{E}_{x_{t}}\mathbb{E}_{x_{0}|x_{t}}\sum_{l:x_{t}^{l}=\mathrm{[MASK]}}\log\mu_{\theta}^{l}(x_{t},t)[x_{0}^{l}]\,\mathrm{d}t" display="inline" intent=":literal"><semantics><mrow><mo>=</mo><mstyle displaystyle="true"><mo>∫</mo></mstyle><msub><mrow></mrow><mn>0</mn></msub><msup><mrow></mrow><mrow><mo>+</mo><mi mathvariant="normal">∞</mi></mrow></msup><mo lspace="0em">−</mo><mstyle displaystyle="true"><mfrac><msub><mi>α</mi><mi>t</mi></msub><mrow><mn>1</mn><mo>−</mo><msub><mi>α</mi><mi>t</mi></msub></mrow></mfrac></mstyle><mi>𝔼</mi><msub><mrow></mrow><msub><mi>x</mi><mi>t</mi></msub></msub><mi>𝔼</mi><msub><mrow></mrow><mrow><msub><mi>x</mi><mn>0</mn></msub><mo fence="false">|</mo><msub><mi>x</mi><mi>t</mi></msub></mrow></msub><mstyle displaystyle="true"><mo movablelimits="false">∑</mo></mstyle><msub><mrow></mrow><mrow><mi>l</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><msubsup><mi>x</mi><mi>t</mi><mi>l</mi></msubsup><mo>=</mo><mrow><mo stretchy="false">[</mo><mi>MASK</mi><mo stretchy="false">]</mo></mrow></mrow></mrow></msub><mi>log</mi><mi>μ</mi><msub><mrow></mrow><mi>θ</mi></msub><msup><mrow></mrow><mi>l</mi></msup><mo stretchy="false">(</mo><mi>x</mi><msub><mrow></mrow><mi>t</mi></msub><mo>,</mo><mi>t</mi><mo stretchy="false">)</mo><mo stretchy="false">[</mo><mi>x</mi><msub><mrow></mrow><mn>0</mn></msub><msup><mrow></mrow><mi>l</mi></msup><mo rspace="0.170em" stretchy="false">]</mo><mi>d</mi><mi>t</mi></mrow><annotation encoding="application/x-tex">\displaystyle=\int_{0}^{+\infty}-\frac{\alpha_{t}}{1-\alpha_{t}}\mathbb{E}_{x_{t}}\mathbb{E}_{x_{0}|x_{t}}\sum_{l:x_{t}^{l}=\mathrm{[MASK]}}\log\mu_{\theta}^{l}(x_{t},t)[x_{0}^{l}]\,\mathrm{d}t</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A8.Ex117Xb"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A8.Ex117Xb.m2" class="ltx_Math" alttext="\displaystyle=\int_{0}^{+\infty}-\frac{\alpha_{t}}{1-\alpha_{t}}\mathbb{E}_{x_{t}}\sum_{l:x_{t}^{l}=\mathrm{[MASK]}}\mathbb{E}_{x_{0}^{l}\sim q_{0}^{l}(\cdot|x_{t}^{UM})}\log\mu_{\theta}^{l}(x_{t},t)[x_{0}^{l}]\,\mathrm{d}t" display="inline" intent=":literal"><semantics><mrow><mo>=</mo><mstyle displaystyle="true"><mo>∫</mo></mstyle><msub><mrow></mrow><mn>0</mn></msub><msup><mrow></mrow><mrow><mo>+</mo><mi mathvariant="normal">∞</mi></mrow></msup><mo lspace="0em">−</mo><mstyle displaystyle="true"><mfrac><msub><mi>α</mi><mi>t</mi></msub><mrow><mn>1</mn><mo>−</mo><msub><mi>α</mi><mi>t</mi></msub></mrow></mfrac></mstyle><mi>𝔼</mi><msub><mrow></mrow><msub><mi>x</mi><mi>t</mi></msub></msub><mstyle displaystyle="true"><mo movablelimits="false">∑</mo></mstyle><msub><mrow></mrow><mrow><mi>l</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><msubsup><mi>x</mi><mi>t</mi><mi>l</mi></msubsup><mo>=</mo><mrow><mo stretchy="false">[</mo><mi>MASK</mi><mo stretchy="false">]</mo></mrow></mrow></mrow></msub><mi>𝔼</mi><msub><mrow></mrow><mrow><mi>x</mi><msub><mrow></mrow><mn>0</mn></msub><msup><mrow></mrow><mi>l</mi></msup><mo>∼</mo><mi>q</mi><msub><mrow></mrow><mn>0</mn></msub><msup><mrow></mrow><mi>l</mi></msup><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>x</mi><msub><mrow></mrow><mi>t</mi></msub><msup><mrow></mrow><mrow><mi>U</mi><mo lspace="0em" rspace="0em">​</mo><mi>M</mi></mrow></msup><mo stretchy="false">)</mo></mrow></msub><mi>log</mi><mi>μ</mi><msub><mrow></mrow><mi>θ</mi></msub><msup><mrow></mrow><mi>l</mi></msup><mo stretchy="false">(</mo><mi>x</mi><msub><mrow></mrow><mi>t</mi></msub><mo>,</mo><mi>t</mi><mo stretchy="false">)</mo><mo stretchy="false">[</mo><mi>x</mi><msub><mrow></mrow><mn>0</mn></msub><msup><mrow></mrow><mi>l</mi></msup><mo rspace="0.170em" stretchy="false">]</mo><mi>d</mi><mi>t</mi></mrow><annotation encoding="application/x-tex">\displaystyle=\int_{0}^{+\infty}-\frac{\alpha_{t}}{1-\alpha_{t}}\mathbb{E}_{x_{t}}\sum_{l:x_{t}^{l}=\mathrm{[MASK]}}\mathbb{E}_{x_{0}^{l}\sim q_{0}^{l}(\cdot|x_{t}^{UM})}\log\mu_{\theta}^{l}(x_{t},t)[x_{0}^{l}]\,\mathrm{d}t</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A8.Ex117Xc"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A8.Ex117Xc.m2" class="ltx_Math" alttext="\displaystyle=\int_{0}^{+\infty}-\frac{\alpha_{t}}{1-\alpha_{t}}\mathbb{E}_{x_{t}}\sum_{l:x_{t}^{l}=\mathrm{[MASK]}}\sum_{a\neq\mathrm{[MASK]}}q_{0}^{l}(a|x_{t}^{UM})\log\mu_{\theta}^{l}(x_{t},t)[a]\,\mathrm{d}t." display="inline" intent=":literal"><semantics><mrow><mo>=</mo><mstyle displaystyle="true"><mo>∫</mo></mstyle><msub><mrow></mrow><mn>0</mn></msub><msup><mrow></mrow><mrow><mo>+</mo><mi mathvariant="normal">∞</mi></mrow></msup><mo lspace="0em">−</mo><mstyle displaystyle="true"><mfrac><msub><mi>α</mi><mi>t</mi></msub><mrow><mn>1</mn><mo>−</mo><msub><mi>α</mi><mi>t</mi></msub></mrow></mfrac></mstyle><mi>𝔼</mi><msub><mrow></mrow><msub><mi>x</mi><mi>t</mi></msub></msub><mstyle displaystyle="true"><mo movablelimits="false">∑</mo></mstyle><msub><mrow></mrow><mrow><mi>l</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><msubsup><mi>x</mi><mi>t</mi><mi>l</mi></msubsup><mo>=</mo><mrow><mo stretchy="false">[</mo><mi>MASK</mi><mo stretchy="false">]</mo></mrow></mrow></mrow></msub><mstyle displaystyle="true"><mo movablelimits="false">∑</mo></mstyle><msub><mrow></mrow><mrow><mi>a</mi><mo>≠</mo><mrow><mo stretchy="false">[</mo><mi>MASK</mi><mo stretchy="false">]</mo></mrow></mrow></msub><mi>q</mi><msub><mrow></mrow><mn>0</mn></msub><msup><mrow></mrow><mi>l</mi></msup><mo stretchy="false">(</mo><mi>a</mi><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>x</mi><msub><mrow></mrow><mi>t</mi></msub><msup><mrow></mrow><mrow><mi>U</mi><mo lspace="0em" rspace="0em">​</mo><mi>M</mi></mrow></msup><mo rspace="0.167em" stretchy="false">)</mo><mi>log</mi><mi>μ</mi><msub><mrow></mrow><mi>θ</mi></msub><msup><mrow></mrow><mi>l</mi></msup><mo stretchy="false">(</mo><mi>x</mi><msub><mrow></mrow><mi>t</mi></msub><mo>,</mo><mi>t</mi><mo stretchy="false">)</mo><mo stretchy="false">[</mo><mi>a</mi><mo rspace="0.170em" stretchy="false">]</mo><mi>d</mi><mi>t</mi><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle=\int_{0}^{+\infty}-\frac{\alpha_{t}}{1-\alpha_{t}}\mathbb{E}_{x_{t}}\sum_{l:x_{t}^{l}=\mathrm{[MASK]}}\sum_{a\neq\mathrm{[MASK]}}q_{0}^{l}(a|x_{t}^{UM})\log\mu_{\theta}^{l}(x_{t},t)[a]\,\mathrm{d}t.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A8.p5.3" class="ltx_p">This establishes (<a href="#A8.E25" title="Equation 25 ‣ Appendix H Proof of ‣ Sharp Convergence Rates for Masked Diffusion Models" class="ltx_ref"><span class="ltx_text ltx_ref_tag">25</span></a>).</p>
</div>
<div id="A8.p6" class="ltx_para ltx_noindent">
<p id="A8.p6.1" class="ltx_p">Second, we show the second term in (<a href="#A8.E24" title="Equation 24 ‣ Appendix H Proof of ‣ Sharp Convergence Rates for Masked Diffusion Models" class="ltx_ref"><span class="ltx_text ltx_ref_tag">24</span></a>) satisfies:</p>
<table id="A8.E26" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A8.E26.m1" class="ltx_math_unparsed" alttext="\int_{0}^{+\infty}\frac{\alpha_{t}}{1-\alpha_{t}}\mathbb{E}_{x_{t}}\sum_{l:x_{t}^{l}=\mathrm{[MASK]}}H\left(q_{0}^{l}(\cdot|x_{t}^{UM})\right)\,\mathrm{d}t=\sum_{k=1}^{d}\frac{1}{k}\mathbb{E}_{x_{0}\sim q_{0}}\mathbb{E}_{\mathcal{M}_{k}}\sum_{l\in\mathcal{M}_{k}}H\left(q_{0}^{l}(\cdot|x_{0}^{\mathcal{M}_{k}^{c}})\right)," display="block" intent=":literal"><semantics><mrow><msubsup><mo>∫</mo><mn>0</mn><mrow><mo>+</mo><mi mathvariant="normal">∞</mi></mrow></msubsup><mfrac><msub><mi>α</mi><mi>t</mi></msub><mrow><mn>1</mn><mo>−</mo><msub><mi>α</mi><mi>t</mi></msub></mrow></mfrac><msub><mi>𝔼</mi><msub><mi>x</mi><mi>t</mi></msub></msub><munder><mo movablelimits="false">∑</mo><mrow><mi>l</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><msubsup><mi>x</mi><mi>t</mi><mi>l</mi></msubsup><mo>=</mo><mrow><mo stretchy="false">[</mo><mi>MASK</mi><mo stretchy="false">]</mo></mrow></mrow></mrow></munder><mi>H</mi><mrow><mo>(</mo><msubsup><mi>q</mi><mn>0</mn><mi>l</mi></msubsup><mrow><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><msubsup><mi>x</mi><mi>t</mi><mrow><mi>U</mi><mo lspace="0em" rspace="0em">​</mo><mi>M</mi></mrow></msubsup><mo stretchy="false">)</mo></mrow><mo rspace="0.170em">)</mo></mrow><mi>d</mi><mi>t</mi><mo rspace="0.111em">=</mo><munderover><mo movablelimits="false">∑</mo><mrow><mi>k</mi><mo>=</mo><mn>1</mn></mrow><mi>d</mi></munderover><mfrac><mn>1</mn><mi>k</mi></mfrac><msub><mi>𝔼</mi><mrow><msub><mi>x</mi><mn>0</mn></msub><mo>∼</mo><msub><mi>q</mi><mn>0</mn></msub></mrow></msub><msub><mi>𝔼</mi><msub><mi class="ltx_font_mathcaligraphic">ℳ</mi><mi>k</mi></msub></msub><munder><mo movablelimits="false">∑</mo><mrow><mi>l</mi><mo>∈</mo><msub><mi class="ltx_font_mathcaligraphic">ℳ</mi><mi>k</mi></msub></mrow></munder><mi>H</mi><mrow><mo>(</mo><msubsup><mi>q</mi><mn>0</mn><mi>l</mi></msubsup><mrow><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><msubsup><mi>x</mi><mn>0</mn><msubsup><mi class="ltx_font_mathcaligraphic">ℳ</mi><mi>k</mi><mi>c</mi></msubsup></msubsup><mo stretchy="false">)</mo></mrow><mo>)</mo></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\int_{0}^{+\infty}\frac{\alpha_{t}}{1-\alpha_{t}}\mathbb{E}_{x_{t}}\sum_{l:x_{t}^{l}=\mathrm{[MASK]}}H\left(q_{0}^{l}(\cdot|x_{t}^{UM})\right)\,\mathrm{d}t=\sum_{k=1}^{d}\frac{1}{k}\mathbb{E}_{x_{0}\sim q_{0}}\mathbb{E}_{\mathcal{M}_{k}}\sum_{l\in\mathcal{M}_{k}}H\left(q_{0}^{l}(\cdot|x_{0}^{\mathcal{M}_{k}^{c}})\right),</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(26)</span></td></tr></tbody>
</table>
<p id="A8.p6.2" class="ltx_p">where <math id="A8.p6.m1" class="ltx_Math" alttext="\mathcal{M}_{k}\subseteq[d]" display="inline" intent=":literal"><semantics><mrow><msub><mi class="ltx_font_mathcaligraphic">ℳ</mi><mi>k</mi></msub><mo>⊆</mo><mrow><mo stretchy="false">[</mo><mi>d</mi><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">\mathcal{M}_{k}\subseteq[d]</annotation></semantics></math>, with <math id="A8.p6.m2" class="ltx_Math" alttext="|\mathcal{M}_{k}|=k" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">|</mo><msub><mi class="ltx_font_mathcaligraphic">ℳ</mi><mi>k</mi></msub><mo stretchy="false">|</mo></mrow><mo>=</mo><mi>k</mi></mrow><annotation encoding="application/x-tex">|\mathcal{M}_{k}|=k</annotation></semantics></math> for <math id="A8.p6.m3" class="ltx_Math" alttext="k=1,\ldots,d" display="inline" intent=":literal"><semantics><mrow><mrow><mi>k</mi><mo>=</mo><mn>1</mn></mrow><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mi>d</mi></mrow><annotation encoding="application/x-tex">k=1,\ldots,d</annotation></semantics></math>, denotes the subset with exactly <math id="A8.p6.m4" class="ltx_Math" alttext="k" display="inline" intent=":literal"><semantics><mi>k</mi><annotation encoding="application/x-tex">k</annotation></semantics></math> token indices uniformly sampled from the total index set, <math id="A8.p6.m5" class="ltx_Math" alttext="\mathcal{M}_{k}^{c}=[d]\setminus\mathcal{M}_{k}" display="inline" intent=":literal"><semantics><mrow><msubsup><mi class="ltx_font_mathcaligraphic">ℳ</mi><mi>k</mi><mi>c</mi></msubsup><mo>=</mo><mrow><mrow><mo stretchy="false">[</mo><mi>d</mi><mo stretchy="false">]</mo></mrow><mo>∖</mo><msub><mi class="ltx_font_mathcaligraphic">ℳ</mi><mi>k</mi></msub></mrow></mrow><annotation encoding="application/x-tex">\mathcal{M}_{k}^{c}=[d]\setminus\mathcal{M}_{k}</annotation></semantics></math>, <math id="A8.p6.m6" class="ltx_Math" alttext="x_{0}^{\mathcal{M}_{k}^{c}}:=\{x_{0}^{l}\}_{l\in\mathcal{M}_{k}^{c}}" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>x</mi><mn>0</mn><msubsup><mi class="ltx_font_mathcaligraphic">ℳ</mi><mi>k</mi><mi>c</mi></msubsup></msubsup><mo>:=</mo><msub><mrow><mo stretchy="false">{</mo><msubsup><mi>x</mi><mn>0</mn><mi>l</mi></msubsup><mo stretchy="false">}</mo></mrow><mrow><mi>l</mi><mo>∈</mo><msubsup><mi class="ltx_font_mathcaligraphic">ℳ</mi><mi>k</mi><mi>c</mi></msubsup></mrow></msub></mrow><annotation encoding="application/x-tex">x_{0}^{\mathcal{M}_{k}^{c}}:=\{x_{0}^{l}\}_{l\in\mathcal{M}_{k}^{c}}</annotation></semantics></math>, and <math id="A8.p6.m7" class="ltx_math_unparsed" alttext="q_{0}^{l}(\cdot|x_{0}^{\mathcal{M}_{k}^{c}})" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>q</mi><mn>0</mn><mi>l</mi></msubsup><mrow><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><msubsup><mi>x</mi><mn>0</mn><msubsup><mi class="ltx_font_mathcaligraphic">ℳ</mi><mi>k</mi><mi>c</mi></msubsup></msubsup><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">q_{0}^{l}(\cdot|x_{0}^{\mathcal{M}_{k}^{c}})</annotation></semantics></math> denotes the conditional distribution of <math id="A8.p6.m8" class="ltx_Math" alttext="x_{0}^{l}" display="inline" intent=":literal"><semantics><msubsup><mi>x</mi><mn>0</mn><mi>l</mi></msubsup><annotation encoding="application/x-tex">x_{0}^{l}</annotation></semantics></math> given <math id="A8.p6.m9" class="ltx_Math" alttext="x_{0}^{\mathcal{M}_{k}^{c}}" display="inline" intent=":literal"><semantics><msubsup><mi>x</mi><mn>0</mn><msubsup><mi class="ltx_font_mathcaligraphic">ℳ</mi><mi>k</mi><mi>c</mi></msubsup></msubsup><annotation encoding="application/x-tex">x_{0}^{\mathcal{M}_{k}^{c}}</annotation></semantics></math>.</p>
</div>
<div id="A8.p7" class="ltx_para ltx_noindent">
<p id="A8.p7.1" class="ltx_p">We proceed as follows.</p>
<table id="A8.Ex118" class="ltx_equationgroup ltx_eqn_table">

<tbody id="A8.Ex118X"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A8.Ex118X.m2" class="ltx_Math" alttext="\displaystyle\int_{0}^{+\infty}" display="inline" intent=":literal"><semantics><mstyle displaystyle="true"><msubsup><mo>∫</mo><mn>0</mn><mrow><mo>+</mo><mi mathvariant="normal">∞</mi></mrow></msubsup></mstyle><annotation encoding="application/x-tex">\displaystyle\int_{0}^{+\infty}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A8.Ex118X.m3" class="ltx_Math" alttext="\displaystyle\frac{\alpha_{t}}{1-\alpha_{t}}\mathbb{E}_{x_{t}}\sum_{l:x_{t}^{l}=\mathrm{[MASK]}}H\left(q_{0}^{l}(\cdot|x_{t}^{UM})\right)\,\mathrm{d}t" display="inline" intent=":literal"><semantics><mrow><mstyle displaystyle="true"><mfrac><msub><mi>α</mi><mi>t</mi></msub><mrow><mn>1</mn><mo>−</mo><msub><mi>α</mi><mi>t</mi></msub></mrow></mfrac></mstyle><mi>𝔼</mi><msub><mrow></mrow><msub><mi>x</mi><mi>t</mi></msub></msub><mstyle displaystyle="true"><mo movablelimits="false">∑</mo></mstyle><msub><mrow></mrow><mrow><mi>l</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><msubsup><mi>x</mi><mi>t</mi><mi>l</mi></msubsup><mo>=</mo><mrow><mo stretchy="false">[</mo><mi>MASK</mi><mo stretchy="false">]</mo></mrow></mrow></mrow></msub><mi>H</mi><mo>(</mo><mi>q</mi><msub><mrow></mrow><mn>0</mn></msub><msup><mrow></mrow><mi>l</mi></msup><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>x</mi><msub><mrow></mrow><mi>t</mi></msub><msup><mrow></mrow><mrow><mi>U</mi><mo lspace="0em" rspace="0em">​</mo><mi>M</mi></mrow></msup><mo stretchy="false">)</mo><mo rspace="0.170em">)</mo><mi>d</mi><mi>t</mi></mrow><annotation encoding="application/x-tex">\displaystyle\frac{\alpha_{t}}{1-\alpha_{t}}\mathbb{E}_{x_{t}}\sum_{l:x_{t}^{l}=\mathrm{[MASK]}}H\left(q_{0}^{l}(\cdot|x_{t}^{UM})\right)\,\mathrm{d}t</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A8.Ex118Xa"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A8.Ex118Xa.m2" class="ltx_Math" alttext="\displaystyle=\int_{0}^{+\infty}\frac{\alpha_{t}}{1-\alpha_{t}}\mathbb{E}_{k}\mathbb{E}_{x_{0}\sim q_{0}}\mathbb{E}_{\mathcal{M}_{k}}\sum_{l\in\mathcal{M}_{k}}H\left(q_{0}^{l}(\cdot|x_{0}^{\mathcal{M}_{k}^{c}})\right)\,\mathrm{d}t" display="inline" intent=":literal"><semantics><mrow><mo>=</mo><mstyle displaystyle="true"><mo>∫</mo></mstyle><msub><mrow></mrow><mn>0</mn></msub><msup><mrow></mrow><mrow><mo>+</mo><mi mathvariant="normal">∞</mi></mrow></msup><mstyle displaystyle="true"><mfrac><msub><mi>α</mi><mi>t</mi></msub><mrow><mn>1</mn><mo>−</mo><msub><mi>α</mi><mi>t</mi></msub></mrow></mfrac></mstyle><mi>𝔼</mi><msub><mrow></mrow><mi>k</mi></msub><mi>𝔼</mi><msub><mrow></mrow><mrow><msub><mi>x</mi><mn>0</mn></msub><mo>∼</mo><msub><mi>q</mi><mn>0</mn></msub></mrow></msub><mi>𝔼</mi><msub><mrow></mrow><msub><mi class="ltx_font_mathcaligraphic">ℳ</mi><mi>k</mi></msub></msub><mstyle displaystyle="true"><mo movablelimits="false">∑</mo></mstyle><msub><mrow></mrow><mrow><mi>l</mi><mo>∈</mo><msub><mi class="ltx_font_mathcaligraphic">ℳ</mi><mi>k</mi></msub></mrow></msub><mi>H</mi><mo>(</mo><mi>q</mi><msub><mrow></mrow><mn>0</mn></msub><msup><mrow></mrow><mi>l</mi></msup><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>x</mi><msub><mrow></mrow><mn>0</mn></msub><msup><mrow></mrow><msubsup><mi class="ltx_font_mathcaligraphic">ℳ</mi><mi>k</mi><mi>c</mi></msubsup></msup><mo stretchy="false">)</mo><mo rspace="0.170em">)</mo><mi>d</mi><mi>t</mi></mrow><annotation encoding="application/x-tex">\displaystyle=\int_{0}^{+\infty}\frac{\alpha_{t}}{1-\alpha_{t}}\mathbb{E}_{k}\mathbb{E}_{x_{0}\sim q_{0}}\mathbb{E}_{\mathcal{M}_{k}}\sum_{l\in\mathcal{M}_{k}}H\left(q_{0}^{l}(\cdot|x_{0}^{\mathcal{M}_{k}^{c}})\right)\,\mathrm{d}t</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A8.Ex118Xb"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A8.Ex118Xb.m2" class="ltx_Math" alttext="\displaystyle=\int_{0}^{+\infty}\frac{\alpha_{t}}{1-\alpha_{t}}\sum_{k=1}^{d}\binom{d}{k}(1-\alpha_{t})^{k}\alpha_{t}^{d-k}\ \mathbb{E}_{x_{0}\sim q_{0}}\mathbb{E}_{\mathcal{M}_{k}}\sum_{l\in\mathcal{M}_{k}}H\left(q_{0}^{l}(\cdot|x_{0}^{\mathcal{M}_{k}^{c}})\right)\,\mathrm{d}t" display="inline" intent=":literal"><semantics><mrow><mo>=</mo><mstyle displaystyle="true"><mo>∫</mo></mstyle><msub><mrow></mrow><mn>0</mn></msub><msup><mrow></mrow><mrow><mo>+</mo><mi mathvariant="normal">∞</mi></mrow></msup><mstyle displaystyle="true"><mfrac><msub><mi>α</mi><mi>t</mi></msub><mrow><mn>1</mn><mo>−</mo><msub><mi>α</mi><mi>t</mi></msub></mrow></mfrac></mstyle><mstyle displaystyle="true"><mo movablelimits="false">∑</mo></mstyle><msub><mrow></mrow><mrow><mi>k</mi><mo>=</mo><mn>1</mn></mrow></msub><msup><mrow></mrow><mi>d</mi></msup><mrow><mo>(</mo><mstyle displaystyle="true"><mfrac linethickness="0pt"><mi>d</mi><mi>k</mi></mfrac></mstyle><mo>)</mo></mrow><mo stretchy="false">(</mo><mn>1</mn><mo>−</mo><mi>α</mi><msub><mrow></mrow><mi>t</mi></msub><mo stretchy="false">)</mo><msup><mrow></mrow><mi>k</mi></msup><mi>α</mi><msub><mrow></mrow><mi>t</mi></msub><msup><mrow></mrow><mrow><mi>d</mi><mo>−</mo><mi>k</mi></mrow></msup><mi>𝔼</mi><msub><mrow></mrow><mrow><msub><mi>x</mi><mn>0</mn></msub><mo>∼</mo><msub><mi>q</mi><mn>0</mn></msub></mrow></msub><mi>𝔼</mi><msub><mrow></mrow><msub><mi class="ltx_font_mathcaligraphic">ℳ</mi><mi>k</mi></msub></msub><mstyle displaystyle="true"><mo movablelimits="false">∑</mo></mstyle><msub><mrow></mrow><mrow><mi>l</mi><mo>∈</mo><msub><mi class="ltx_font_mathcaligraphic">ℳ</mi><mi>k</mi></msub></mrow></msub><mi>H</mi><mo>(</mo><mi>q</mi><msub><mrow></mrow><mn>0</mn></msub><msup><mrow></mrow><mi>l</mi></msup><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>x</mi><msub><mrow></mrow><mn>0</mn></msub><msup><mrow></mrow><msubsup><mi class="ltx_font_mathcaligraphic">ℳ</mi><mi>k</mi><mi>c</mi></msubsup></msup><mo stretchy="false">)</mo><mo rspace="0.170em">)</mo><mi>d</mi><mi>t</mi></mrow><annotation encoding="application/x-tex">\displaystyle=\int_{0}^{+\infty}\frac{\alpha_{t}}{1-\alpha_{t}}\sum_{k=1}^{d}\binom{d}{k}(1-\alpha_{t})^{k}\alpha_{t}^{d-k}\ \mathbb{E}_{x_{0}\sim q_{0}}\mathbb{E}_{\mathcal{M}_{k}}\sum_{l\in\mathcal{M}_{k}}H\left(q_{0}^{l}(\cdot|x_{0}^{\mathcal{M}_{k}^{c}})\right)\,\mathrm{d}t</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A8.Ex118Xc"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A8.Ex118Xc.m2" class="ltx_Math" alttext="\displaystyle=\int_{0}^{1}\frac{1}{1-\alpha_{t}}\sum_{k=1}^{d}\binom{d}{k}(1-\alpha_{t})^{k}\alpha_{t}^{d-k}\ \mathbb{E}_{x_{0}\sim q_{0}}\mathbb{E}_{\mathcal{M}_{k}}\sum_{l\in\mathcal{M}_{k}}H\left(q_{0}^{l}(\cdot|x_{0}^{\mathcal{M}_{k}^{c}})\right)\,\mathrm{d}\alpha_{t}" display="inline" intent=":literal"><semantics><mrow><mo>=</mo><mstyle displaystyle="true"><mo>∫</mo></mstyle><msub><mrow></mrow><mn>0</mn></msub><msup><mrow></mrow><mn>1</mn></msup><mstyle displaystyle="true"><mfrac><mn>1</mn><mrow><mn>1</mn><mo>−</mo><msub><mi>α</mi><mi>t</mi></msub></mrow></mfrac></mstyle><mstyle displaystyle="true"><mo movablelimits="false">∑</mo></mstyle><msub><mrow></mrow><mrow><mi>k</mi><mo>=</mo><mn>1</mn></mrow></msub><msup><mrow></mrow><mi>d</mi></msup><mrow><mo>(</mo><mstyle displaystyle="true"><mfrac linethickness="0pt"><mi>d</mi><mi>k</mi></mfrac></mstyle><mo>)</mo></mrow><mo stretchy="false">(</mo><mn>1</mn><mo>−</mo><mi>α</mi><msub><mrow></mrow><mi>t</mi></msub><mo stretchy="false">)</mo><msup><mrow></mrow><mi>k</mi></msup><mi>α</mi><msub><mrow></mrow><mi>t</mi></msub><msup><mrow></mrow><mrow><mi>d</mi><mo>−</mo><mi>k</mi></mrow></msup><mi>𝔼</mi><msub><mrow></mrow><mrow><msub><mi>x</mi><mn>0</mn></msub><mo>∼</mo><msub><mi>q</mi><mn>0</mn></msub></mrow></msub><mi>𝔼</mi><msub><mrow></mrow><msub><mi class="ltx_font_mathcaligraphic">ℳ</mi><mi>k</mi></msub></msub><mstyle displaystyle="true"><mo movablelimits="false">∑</mo></mstyle><msub><mrow></mrow><mrow><mi>l</mi><mo>∈</mo><msub><mi class="ltx_font_mathcaligraphic">ℳ</mi><mi>k</mi></msub></mrow></msub><mi>H</mi><mo>(</mo><mi>q</mi><msub><mrow></mrow><mn>0</mn></msub><msup><mrow></mrow><mi>l</mi></msup><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>x</mi><msub><mrow></mrow><mn>0</mn></msub><msup><mrow></mrow><msubsup><mi class="ltx_font_mathcaligraphic">ℳ</mi><mi>k</mi><mi>c</mi></msubsup></msup><mo stretchy="false">)</mo><mo rspace="0.170em">)</mo><mi>d</mi><mi>α</mi><msub><mrow></mrow><mi>t</mi></msub></mrow><annotation encoding="application/x-tex">\displaystyle=\int_{0}^{1}\frac{1}{1-\alpha_{t}}\sum_{k=1}^{d}\binom{d}{k}(1-\alpha_{t})^{k}\alpha_{t}^{d-k}\ \mathbb{E}_{x_{0}\sim q_{0}}\mathbb{E}_{\mathcal{M}_{k}}\sum_{l\in\mathcal{M}_{k}}H\left(q_{0}^{l}(\cdot|x_{0}^{\mathcal{M}_{k}^{c}})\right)\,\mathrm{d}\alpha_{t}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A8.Ex118Xd"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A8.Ex118Xd.m2" class="ltx_Math" alttext="\displaystyle=\int_{0}^{1}\sum_{k=1}^{d}\frac{d!}{k!(d-k)!}(1-\alpha_{t})^{k-1}\alpha_{t}^{d-k}\ \mathbb{E}_{x_{0}\sim q_{0}}\mathbb{E}_{\mathcal{M}_{k}}\sum_{l\in\mathcal{M}_{k}}H\left(q_{0}^{l}(\cdot|x_{0}^{\mathcal{M}_{k}^{c}})\right)\,\mathrm{d}\alpha_{t}" display="inline" intent=":literal"><semantics><mrow><mo>=</mo><mstyle displaystyle="true"><mo>∫</mo></mstyle><msub><mrow></mrow><mn>0</mn></msub><msup><mrow></mrow><mn>1</mn></msup><mstyle displaystyle="true"><mo movablelimits="false">∑</mo></mstyle><msub><mrow></mrow><mrow><mi>k</mi><mo>=</mo><mn>1</mn></mrow></msub><msup><mrow></mrow><mi>d</mi></msup><mstyle displaystyle="true"><mfrac><mrow><mi>d</mi><mo>!</mo></mrow><mrow><mrow><mrow><mi>k</mi><mo>!</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>d</mi><mo>−</mo><mi>k</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>!</mo></mrow></mfrac></mstyle><mo stretchy="false">(</mo><mn>1</mn><mo>−</mo><mi>α</mi><msub><mrow></mrow><mi>t</mi></msub><mo stretchy="false">)</mo><msup><mrow></mrow><mrow><mi>k</mi><mo>−</mo><mn>1</mn></mrow></msup><mi>α</mi><msub><mrow></mrow><mi>t</mi></msub><msup><mrow></mrow><mrow><mi>d</mi><mo>−</mo><mi>k</mi></mrow></msup><mi>𝔼</mi><msub><mrow></mrow><mrow><msub><mi>x</mi><mn>0</mn></msub><mo>∼</mo><msub><mi>q</mi><mn>0</mn></msub></mrow></msub><mi>𝔼</mi><msub><mrow></mrow><msub><mi class="ltx_font_mathcaligraphic">ℳ</mi><mi>k</mi></msub></msub><mstyle displaystyle="true"><mo movablelimits="false">∑</mo></mstyle><msub><mrow></mrow><mrow><mi>l</mi><mo>∈</mo><msub><mi class="ltx_font_mathcaligraphic">ℳ</mi><mi>k</mi></msub></mrow></msub><mi>H</mi><mo>(</mo><mi>q</mi><msub><mrow></mrow><mn>0</mn></msub><msup><mrow></mrow><mi>l</mi></msup><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>x</mi><msub><mrow></mrow><mn>0</mn></msub><msup><mrow></mrow><msubsup><mi class="ltx_font_mathcaligraphic">ℳ</mi><mi>k</mi><mi>c</mi></msubsup></msup><mo stretchy="false">)</mo><mo rspace="0.170em">)</mo><mi>d</mi><mi>α</mi><msub><mrow></mrow><mi>t</mi></msub></mrow><annotation encoding="application/x-tex">\displaystyle=\int_{0}^{1}\sum_{k=1}^{d}\frac{d!}{k!(d-k)!}(1-\alpha_{t})^{k-1}\alpha_{t}^{d-k}\ \mathbb{E}_{x_{0}\sim q_{0}}\mathbb{E}_{\mathcal{M}_{k}}\sum_{l\in\mathcal{M}_{k}}H\left(q_{0}^{l}(\cdot|x_{0}^{\mathcal{M}_{k}^{c}})\right)\,\mathrm{d}\alpha_{t}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A8.Ex118Xe"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A8.Ex118Xe.m2" class="ltx_Math" alttext="\displaystyle=\sum_{k=1}^{d}\frac{1}{k}\left(\int_{0}^{1}\frac{d!}{(k-1)!(d-k)!}(1-\alpha_{t})^{k-1}\alpha_{t}^{d-k}\,\mathrm{d}\alpha_{t}\right)\ \mathbb{E}_{x_{0}\sim q_{0}}\mathbb{E}_{\mathcal{M}_{k}}\sum_{l\in\mathcal{M}_{k}}H\left(q_{0}^{l}(\cdot|x_{0}^{\mathcal{M}_{k}^{c}})\right)" display="inline" intent=":literal"><semantics><mrow><mo>=</mo><mstyle displaystyle="true"><mo movablelimits="false">∑</mo></mstyle><msub><mrow></mrow><mrow><mi>k</mi><mo>=</mo><mn>1</mn></mrow></msub><msup><mrow></mrow><mi>d</mi></msup><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>k</mi></mfrac></mstyle><mo>(</mo><mstyle displaystyle="true"><mo>∫</mo></mstyle><msub><mrow></mrow><mn>0</mn></msub><msup><mrow></mrow><mn>1</mn></msup><mstyle displaystyle="true"><mfrac><mrow><mi>d</mi><mo>!</mo></mrow><mrow><mrow><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>k</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mo>!</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>d</mi><mo>−</mo><mi>k</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>!</mo></mrow></mfrac></mstyle><mo stretchy="false">(</mo><mn>1</mn><mo>−</mo><mi>α</mi><msub><mrow></mrow><mi>t</mi></msub><mo stretchy="false">)</mo><msup><mrow></mrow><mrow><mi>k</mi><mo>−</mo><mn>1</mn></mrow></msup><mi>α</mi><msub><mrow></mrow><mi>t</mi></msub><msup><mrow></mrow><mrow><mi>d</mi><mo>−</mo><mi>k</mi></mrow></msup><mi>d</mi><mi>α</mi><msub><mrow></mrow><mi>t</mi></msub><mo rspace="0.500em">)</mo><mi>𝔼</mi><msub><mrow></mrow><mrow><msub><mi>x</mi><mn>0</mn></msub><mo>∼</mo><msub><mi>q</mi><mn>0</mn></msub></mrow></msub><mi>𝔼</mi><msub><mrow></mrow><msub><mi class="ltx_font_mathcaligraphic">ℳ</mi><mi>k</mi></msub></msub><mstyle displaystyle="true"><mo movablelimits="false">∑</mo></mstyle><msub><mrow></mrow><mrow><mi>l</mi><mo>∈</mo><msub><mi class="ltx_font_mathcaligraphic">ℳ</mi><mi>k</mi></msub></mrow></msub><mi>H</mi><mo>(</mo><mi>q</mi><msub><mrow></mrow><mn>0</mn></msub><msup><mrow></mrow><mi>l</mi></msup><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>x</mi><msub><mrow></mrow><mn>0</mn></msub><msup><mrow></mrow><msubsup><mi class="ltx_font_mathcaligraphic">ℳ</mi><mi>k</mi><mi>c</mi></msubsup></msup><mo stretchy="false">)</mo><mo>)</mo></mrow><annotation encoding="application/x-tex">\displaystyle=\sum_{k=1}^{d}\frac{1}{k}\left(\int_{0}^{1}\frac{d!}{(k-1)!(d-k)!}(1-\alpha_{t})^{k-1}\alpha_{t}^{d-k}\,\mathrm{d}\alpha_{t}\right)\ \mathbb{E}_{x_{0}\sim q_{0}}\mathbb{E}_{\mathcal{M}_{k}}\sum_{l\in\mathcal{M}_{k}}H\left(q_{0}^{l}(\cdot|x_{0}^{\mathcal{M}_{k}^{c}})\right)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A8.Ex118Xf"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A8.Ex118Xf.m2" class="ltx_Math" alttext="\displaystyle=\sum_{k=1}^{d}\frac{1}{k}\mathbb{E}_{x_{0}\sim q_{0}}\mathbb{E}_{\mathcal{M}_{k}}\sum_{l\in\mathcal{M}_{k}}H\left(q_{0}^{l}(\cdot|x_{0}^{\mathcal{M}_{k}^{c}})\right)." display="inline" intent=":literal"><semantics><mrow><mo>=</mo><mstyle displaystyle="true"><mo movablelimits="false">∑</mo></mstyle><msub><mrow></mrow><mrow><mi>k</mi><mo>=</mo><mn>1</mn></mrow></msub><msup><mrow></mrow><mi>d</mi></msup><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>k</mi></mfrac></mstyle><mi>𝔼</mi><msub><mrow></mrow><mrow><msub><mi>x</mi><mn>0</mn></msub><mo>∼</mo><msub><mi>q</mi><mn>0</mn></msub></mrow></msub><mi>𝔼</mi><msub><mrow></mrow><msub><mi class="ltx_font_mathcaligraphic">ℳ</mi><mi>k</mi></msub></msub><mstyle displaystyle="true"><mo movablelimits="false">∑</mo></mstyle><msub><mrow></mrow><mrow><mi>l</mi><mo>∈</mo><msub><mi class="ltx_font_mathcaligraphic">ℳ</mi><mi>k</mi></msub></mrow></msub><mi>H</mi><mo>(</mo><mi>q</mi><msub><mrow></mrow><mn>0</mn></msub><msup><mrow></mrow><mi>l</mi></msup><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>x</mi><msub><mrow></mrow><mn>0</mn></msub><msup><mrow></mrow><msubsup><mi class="ltx_font_mathcaligraphic">ℳ</mi><mi>k</mi><mi>c</mi></msubsup></msup><mo stretchy="false">)</mo><mo>)</mo><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle=\sum_{k=1}^{d}\frac{1}{k}\mathbb{E}_{x_{0}\sim q_{0}}\mathbb{E}_{\mathcal{M}_{k}}\sum_{l\in\mathcal{M}_{k}}H\left(q_{0}^{l}(\cdot|x_{0}^{\mathcal{M}_{k}^{c}})\right).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A8.p7.2" class="ltx_p">This establishes (<a href="#A8.E26" title="Equation 26 ‣ Appendix H Proof of ‣ Sharp Convergence Rates for Masked Diffusion Models" class="ltx_ref"><span class="ltx_text ltx_ref_tag">26</span></a>).</p>
</div>
<div id="A8.p8" class="ltx_para ltx_noindent">
<p id="A8.p8.1" class="ltx_p">Finally, combining (<a href="#A8.E25" title="Equation 25 ‣ Appendix H Proof of ‣ Sharp Convergence Rates for Masked Diffusion Models" class="ltx_ref"><span class="ltx_text ltx_ref_tag">25</span></a>) and (<a href="#A8.E26" title="Equation 26 ‣ Appendix H Proof of ‣ Sharp Convergence Rates for Masked Diffusion Models" class="ltx_ref"><span class="ltx_text ltx_ref_tag">26</span></a>), we obtain as desired,</p>
<table id="A8.EGx22" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A8.E27"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A8.E27.m1" class="ltx_Math" alttext="\displaystyle\int_{0}^{+\infty}\mathcal{L}_{SE}(s,t)\,\mathrm{d}t" display="inline" intent=":literal"><semantics><mrow><mstyle displaystyle="true"><msubsup><mo>∫</mo><mn>0</mn><mrow><mo>+</mo><mi mathvariant="normal">∞</mi></mrow></msubsup></mstyle><mrow><msub><mi class="ltx_font_mathcaligraphic">ℒ</mi><mrow><mi>S</mi><mo lspace="0em" rspace="0em">​</mo><mi>E</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>s</mi><mo>,</mo><mi>t</mi><mo stretchy="false">)</mo></mrow><mo lspace="0.170em" rspace="0em">​</mo><mrow><mo rspace="0em">𝑑</mo><mi>t</mi></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\int_{0}^{+\infty}\mathcal{L}_{SE}(s,t)\,\mathrm{d}t</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A8.E27.m2" class="ltx_math_unparsed" alttext="\displaystyle=\mathbb{E}_{x_{0}\sim q_{0}}[\mathcal{L}_{\infty}(x_{0})]-\sum_{k=1}^{d}\frac{1}{k}\mathbb{E}_{x_{0}\sim q_{0}}\mathbb{E}_{\mathcal{M}_{k}}\sum_{l\in\mathcal{M}_{k}}H\left(q_{0}^{l}(\cdot|x_{0}^{\mathcal{M}_{k}^{c}})\right)." display="inline" intent=":literal"><semantics><mrow><mo>=</mo><msub><mi>𝔼</mi><mrow><msub><mi>x</mi><mn>0</mn></msub><mo>∼</mo><msub><mi>q</mi><mn>0</mn></msub></mrow></msub><mrow><mo stretchy="false">[</mo><msub><mi class="ltx_font_mathcaligraphic">ℒ</mi><mi mathvariant="normal">∞</mi></msub><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mn>0</mn></msub><mo stretchy="false">)</mo></mrow><mo stretchy="false">]</mo></mrow><mo>−</mo><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>k</mi><mo>=</mo><mn>1</mn></mrow><mi>d</mi></munderover></mstyle><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>k</mi></mfrac></mstyle><msub><mi>𝔼</mi><mrow><msub><mi>x</mi><mn>0</mn></msub><mo>∼</mo><msub><mi>q</mi><mn>0</mn></msub></mrow></msub><msub><mi>𝔼</mi><msub><mi class="ltx_font_mathcaligraphic">ℳ</mi><mi>k</mi></msub></msub><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mi>l</mi><mo>∈</mo><msub><mi class="ltx_font_mathcaligraphic">ℳ</mi><mi>k</mi></msub></mrow></munder></mstyle><mi>H</mi><mrow><mo>(</mo><msubsup><mi>q</mi><mn>0</mn><mi>l</mi></msubsup><mrow><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><msubsup><mi>x</mi><mn>0</mn><msubsup><mi class="ltx_font_mathcaligraphic">ℳ</mi><mi>k</mi><mi>c</mi></msubsup></msubsup><mo stretchy="false">)</mo></mrow><mo>)</mo></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle=\mathbb{E}_{x_{0}\sim q_{0}}[\mathcal{L}_{\infty}(x_{0})]-\sum_{k=1}^{d}\frac{1}{k}\mathbb{E}_{x_{0}\sim q_{0}}\mathbb{E}_{\mathcal{M}_{k}}\sum_{l\in\mathcal{M}_{k}}H\left(q_{0}^{l}(\cdot|x_{0}^{\mathcal{M}_{k}^{c}})\right).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(27)</span></td></tr></tbody>
</table>
</div>
<div id="A8.p9" class="ltx_para ltx_noindent">
<p id="A8.p9.1" class="ltx_p">The proof is now complete.</p>
</div>
</section>
<section id="A9" class="ltx_appendix">
<h2 class="ltx_title ltx_title_appendix"><span class="ltx_tag ltx_tag_appendix">Appendix I </span>FHS Sampling in CTMC Framework: <a href="#Thmproposition3" title="Proposition 3. ‣ Appendix I FHS Sampling in CTMC Framework: and its Proof ‣ Sharp Convergence Rates for Masked Diffusion Models" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Proposition</span> <span class="ltx_text ltx_ref_tag">3</span></a> and its Proof</h2>

<div id="A9.p1" class="ltx_para ltx_noindent">
<p id="A9.p1.1" class="ltx_p">In this section, we establish <a href="#Thmproposition3" title="Proposition 3. ‣ Appendix I FHS Sampling in CTMC Framework: and its Proof ‣ Sharp Convergence Rates for Masked Diffusion Models" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Proposition</span> <span class="ltx_text ltx_ref_tag">3</span></a>, which provides statistical characterization of the FHS sampling process and show that it exactly matches the reverse process under the CTMC framework for absorbing-rate diffusion models. This will highly facilitate us to develop the error analysis for <a href="#Thmtheorem4" title="Theorem 4. ‣ 4 Convergence Guarantees for the FHS Algorithm ‣ Sharp Convergence Rates for Masked Diffusion Models" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Theorem</span> <span class="ltx_text ltx_ref_tag">4</span></a>.</p>
</div>
<div id="A9.p2" class="ltx_para ltx_noindent">
<p id="A9.p2.1" class="ltx_p">We let <math id="A9.p2.m1" class="ltx_Math" alttext="\mathbb{P}_{\mathrm{FHS}}" display="inline" intent=":literal"><semantics><msub><mi>ℙ</mi><mi>FHS</mi></msub><annotation encoding="application/x-tex">\mathbb{P}_{\mathrm{FHS}}</annotation></semantics></math> and <math id="A9.p2.m2" class="ltx_Math" alttext="\mathbb{P}_{\mathrm{CTMC}}" display="inline" intent=":literal"><semantics><msub><mi>ℙ</mi><mi>CTMC</mi></msub><annotation encoding="application/x-tex">\mathbb{P}_{\mathrm{CTMC}}</annotation></semantics></math> denote the probability measure over the entire path generated by the FHS sampling algorithm and the ground truth reverse absorbing-rate continuous-time Markov chain (CTMC). Both processes admit a common simple representation. Since the sequence contains <math id="A9.p2.m3" class="ltx_Math" alttext="d" display="inline" intent=":literal"><semantics><mi>d</mi><annotation encoding="application/x-tex">d</annotation></semantics></math> tokens, starts from the fully masked state, and each token remains fixed once it is unmasked, both processes are fully characterized by: (i) the <math id="A9.p2.m4" class="ltx_Math" alttext="d" display="inline" intent=":literal"><semantics><mi>d</mi><annotation encoding="application/x-tex">d</annotation></semantics></math> unmasking times, (ii) which token is unmasked at each such time, and (iii) the token value to which that token is unmasked. We therefore introduce notation for these random variables. Let <math id="A9.p2.m5" class="ltx_Math" alttext="k\in{0,1,\ldots,d}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>k</mi><mo>∈</mo><mn>0</mn></mrow><mo>,</mo><mn>1</mn><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mi>d</mi></mrow><annotation encoding="application/x-tex">k\in{0,1,\ldots,d}</annotation></semantics></math> index the unmasking events.</p>
<ol id="A9.I1" class="ltx_enumerate">
<li id="A9.I1.i1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">1.</span> 
<div id="A9.I1.i1.p1" class="ltx_para ltx_noindent">
<p id="A9.I1.i1.p1.1" class="ltx_p">For <math id="A9.I1.i1.p1.m1" class="ltx_Math" alttext="k\in[d]" display="inline" intent=":literal"><semantics><mrow><mi>k</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mi>d</mi><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">k\in[d]</annotation></semantics></math>, let <math id="A9.I1.i1.p1.m2" class="ltx_Math" alttext="\tau_{k}" display="inline" intent=":literal"><semantics><msub><mi>τ</mi><mi>k</mi></msub><annotation encoding="application/x-tex">\tau_{k}</annotation></semantics></math> denote the time at which the <math id="A9.I1.i1.p1.m3" class="ltx_Math" alttext="(d-k)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mrow><mi>d</mi><mo>−</mo><mi>k</mi></mrow><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(d-k)</annotation></semantics></math>-th unmasking occurs. Specifically, <math id="A9.I1.i1.p1.m4" class="ltx_Math" alttext="\tau_{d}" display="inline" intent=":literal"><semantics><msub><mi>τ</mi><mi>d</mi></msub><annotation encoding="application/x-tex">\tau_{d}</annotation></semantics></math> denotes the initialization time of the sampling processes. Clearly, unmasking times <math id="A9.I1.i1.p1.m5" class="ltx_Math" alttext="\{\tau_{k}\}_{k}" display="inline" intent=":literal"><semantics><msub><mrow><mo stretchy="false">{</mo><msub><mi>τ</mi><mi>k</mi></msub><mo stretchy="false">}</mo></mrow><mi>k</mi></msub><annotation encoding="application/x-tex">\{\tau_{k}\}_{k}</annotation></semantics></math> are increasing monotonically with respect to <math id="A9.I1.i1.p1.m6" class="ltx_Math" alttext="k" display="inline" intent=":literal"><semantics><mi>k</mi><annotation encoding="application/x-tex">k</annotation></semantics></math>, satisfying</p>
<table id="A9.Ex119" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A9.Ex119.m1" class="ltx_Math" alttext="\tau_{0}&lt;\tau_{1}&lt;\cdots&lt;\tau_{d-1}&lt;\tau_{d}=+\infty," display="block" intent=":literal"><semantics><mrow><mrow><msub><mi>τ</mi><mn>0</mn></msub><mo>&lt;</mo><msub><mi>τ</mi><mn>1</mn></msub><mo rspace="0.1389em">&lt;</mo><mo lspace="0.1389em" rspace="0.1389em">⋯</mo><mo lspace="0.1389em">&lt;</mo><msub><mi>τ</mi><mrow><mi>d</mi><mo>−</mo><mn>1</mn></mrow></msub><mo>&lt;</mo><msub><mi>τ</mi><mi>d</mi></msub><mo>=</mo><mrow><mo>+</mo><mi mathvariant="normal">∞</mi></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\tau_{0}&lt;\tau_{1}&lt;\cdots&lt;\tau_{d-1}&lt;\tau_{d}=+\infty,</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A9.I1.i1.p1.2" class="ltx_p">where <math id="A9.I1.i1.p1.m7" class="ltx_Math" alttext="\tau_{d}=+\infty" display="inline" intent=":literal"><semantics><mrow><msub><mi>τ</mi><mi>d</mi></msub><mo>=</mo><mrow><mo>+</mo><mi mathvariant="normal">∞</mi></mrow></mrow><annotation encoding="application/x-tex">\tau_{d}=+\infty</annotation></semantics></math> is initialized by <math id="A9.I1.i1.p1.m8" class="ltx_Math" alttext="\alpha(\tau_{d})=e^{-\tau_{d}}=0" display="inline" intent=":literal"><semantics><mrow><mrow><mi>α</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>τ</mi><mi>d</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><msup><mi>e</mi><mrow><mo>−</mo><msub><mi>τ</mi><mi>d</mi></msub></mrow></msup><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\alpha(\tau_{d})=e^{-\tau_{d}}=0</annotation></semantics></math>.</p>
</div></li>
<li id="A9.I1.i2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">2.</span> 
<div id="A9.I1.i2.p1" class="ltx_para ltx_noindent">
<p id="A9.I1.i2.p1.1" class="ltx_p">Let <math id="A9.I1.i2.p1.m1" class="ltx_Math" alttext="x_{\tau_{k}}" display="inline" intent=":literal"><semantics><msub><mi>x</mi><msub><mi>τ</mi><mi>k</mi></msub></msub><annotation encoding="application/x-tex">x_{\tau_{k}}</annotation></semantics></math> denote the sequence state immediately after time <math id="A9.I1.i2.p1.m2" class="ltx_Math" alttext="\tau_{k}" display="inline" intent=":literal"><semantics><msub><mi>τ</mi><mi>k</mi></msub><annotation encoding="application/x-tex">\tau_{k}</annotation></semantics></math>, i.e., <math id="A9.I1.i2.p1.m3" class="ltx_Math" alttext="\tau_{k}-\delta" display="inline" intent=":literal"><semantics><mrow><msub><mi>τ</mi><mi>k</mi></msub><mo>−</mo><mi>δ</mi></mrow><annotation encoding="application/x-tex">\tau_{k}-\delta</annotation></semantics></math>. Between consecutive unmasking events, the state remains constant; specifically, we set <math id="A9.I1.i2.p1.m4" class="ltx_Math" alttext="x_{t}\equiv x_{\tau_{k}}" display="inline" intent=":literal"><semantics><mrow><msub><mi>x</mi><mi>t</mi></msub><mo>≡</mo><msub><mi>x</mi><msub><mi>τ</mi><mi>k</mi></msub></msub></mrow><annotation encoding="application/x-tex">x_{t}\equiv x_{\tau_{k}}</annotation></semantics></math> for <math id="A9.I1.i2.p1.m5" class="ltx_Math" alttext="t\in(\tau_{k-1},\tau_{k}]" display="inline" intent=":literal"><semantics><mrow><mi>t</mi><mo>∈</mo><mrow><mo stretchy="false">(</mo><msub><mi>τ</mi><mrow><mi>k</mi><mo>−</mo><mn>1</mn></mrow></msub><mo>,</mo><msub><mi>τ</mi><mi>k</mi></msub><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">t\in(\tau_{k-1},\tau_{k}]</annotation></semantics></math> (equivalently, until the next unmasking time).</p>
</div></li>
<li id="A9.I1.i3" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">3.</span> 
<div id="A9.I1.i3.p1" class="ltx_para ltx_noindent">
<p id="A9.I1.i3.p1.1" class="ltx_p">Let <math id="A9.I1.i3.p1.m1" class="ltx_Math" alttext="i_{\tau_{k}}\in[d]" display="inline" intent=":literal"><semantics><mrow><msub><mi>i</mi><msub><mi>τ</mi><mi>k</mi></msub></msub><mo>∈</mo><mrow><mo stretchy="false">[</mo><mi>d</mi><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">i_{\tau_{k}}\in[d]</annotation></semantics></math> denote the token index unmasked at time <math id="A9.I1.i3.p1.m2" class="ltx_Math" alttext="\tau_{k}" display="inline" intent=":literal"><semantics><msub><mi>τ</mi><mi>k</mi></msub><annotation encoding="application/x-tex">\tau_{k}</annotation></semantics></math>.</p>
</div></li>
<li id="A9.I1.i4" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">4.</span> 
<div id="A9.I1.i4.p1" class="ltx_para">
<p id="A9.I1.i4.p1.1" class="ltx_p">Let <math id="A9.I1.i4.p1.m1" class="ltx_Math" alttext="a_{\tau_{k}}\in[S]" display="inline" intent=":literal"><semantics><mrow><msub><mi>a</mi><msub><mi>τ</mi><mi>k</mi></msub></msub><mo>∈</mo><mrow><mo stretchy="false">[</mo><mi>S</mi><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">a_{\tau_{k}}\in[S]</annotation></semantics></math> denote the realized token value assigned at that time. Thus, the newly revealed token satisfies <math id="A9.I1.i4.p1.m2" class="ltx_Math" alttext="x_{\tau_{k}}^{i_{\tau_{k}}}=a_{\tau_{k}}" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>x</mi><msub><mi>τ</mi><mi>k</mi></msub><msub><mi>i</mi><msub><mi>τ</mi><mi>k</mi></msub></msub></msubsup><mo>=</mo><msub><mi>a</mi><msub><mi>τ</mi><mi>k</mi></msub></msub></mrow><annotation encoding="application/x-tex">x_{\tau_{k}}^{i_{\tau_{k}}}=a_{\tau_{k}}</annotation></semantics></math>.</p>
</div></li>
</ol>
<p id="A9.p2.2" class="ltx_p">To simplify the notation, we use <math id="A9.p2.m6" class="ltx_Math" alttext="x_{k},i_{k},a_{k}" display="inline" intent=":literal"><semantics><mrow><msub><mi>x</mi><mi>k</mi></msub><mo>,</mo><msub><mi>i</mi><mi>k</mi></msub><mo>,</mo><msub><mi>a</mi><mi>k</mi></msub></mrow><annotation encoding="application/x-tex">x_{k},i_{k},a_{k}</annotation></semantics></math> to denote <math id="A9.p2.m7" class="ltx_Math" alttext="x_{\tau_{k}},i_{\tau_{k}},a_{\tau_{k}}" display="inline" intent=":literal"><semantics><mrow><msub><mi>x</mi><msub><mi>τ</mi><mi>k</mi></msub></msub><mo>,</mo><msub><mi>i</mi><msub><mi>τ</mi><mi>k</mi></msub></msub><mo>,</mo><msub><mi>a</mi><msub><mi>τ</mi><mi>k</mi></msub></msub></mrow><annotation encoding="application/x-tex">x_{\tau_{k}},i_{\tau_{k}},a_{\tau_{k}}</annotation></semantics></math>, respectively. Further note that <math id="A9.p2.m8" class="ltx_Math" alttext="x_{k}" display="inline" intent=":literal"><semantics><msub><mi>x</mi><mi>k</mi></msub><annotation encoding="application/x-tex">x_{k}</annotation></semantics></math> is fully determined by <math id="A9.p2.m9" class="ltx_Math" alttext="\{i_{j}\}_{j=d}^{k}" display="inline" intent=":literal"><semantics><msubsup><mrow><mo stretchy="false">{</mo><msub><mi>i</mi><mi>j</mi></msub><mo stretchy="false">}</mo></mrow><mrow><mi>j</mi><mo>=</mo><mi>d</mi></mrow><mi>k</mi></msubsup><annotation encoding="application/x-tex">\{i_{j}\}_{j=d}^{k}</annotation></semantics></math> and <math id="A9.p2.m10" class="ltx_Math" alttext="\{a_{j}\}_{j=d}^{k}" display="inline" intent=":literal"><semantics><msubsup><mrow><mo stretchy="false">{</mo><msub><mi>a</mi><mi>j</mi></msub><mo stretchy="false">}</mo></mrow><mrow><mi>j</mi><mo>=</mo><mi>d</mi></mrow><mi>k</mi></msubsup><annotation encoding="application/x-tex">\{a_{j}\}_{j=d}^{k}</annotation></semantics></math>.</p>
</div>
<div id="A9.p3" class="ltx_para ltx_noindent">
<p id="A9.p3.1" class="ltx_p">The following proposition provides useful statistical properties of the FHS and reverse CTMC processes and their connections.</p>
</div>
<div id="Thmproposition3" class="ltx_theorem ltx_theorem_proposition">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="Thmproposition3.2" class="ltx_text ltx_font_bold">Proposition 3</span></span><span id="Thmproposition3.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="Thmproposition3.p1" class="ltx_para ltx_noindent">
<p id="Thmproposition3.p1.1" class="ltx_p"><span id="Thmproposition3.p1.1.1" class="ltx_text ltx_font_italic">The FHS and reverse absorbing-rate CTMC processes satisfy the following properties:</span></p>
<table id="A9.Ex120" class="ltx_equationgroup ltx_eqn_table">

<tbody id="A9.Ex120X"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A9.Ex120X.m2" class="ltx_Math" alttext="\displaystyle\mathbb{P}_{\mathrm{FHS}}(\tau_{k-1}|x_{k},\tau_{k})=\mathbb{P}_{\mathrm{CTMC}}(\tau_{k-1}|x_{k},\tau_{k})=\mathbb{P}_{\mathrm{CTMC}}(\tau_{k-1}|\tau_{k})," display="inline" intent=":literal"><semantics><mrow><mrow><mrow><msub><mi>ℙ</mi><mi>FHS</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>τ</mi><mrow><mi>k</mi><mo>−</mo><mn>1</mn></mrow></msub><mo lspace="0em" rspace="0em">|</mo><mrow><msub><mi>x</mi><mi>k</mi></msub><mo>,</mo><msub><mi>τ</mi><mi>k</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><msub><mi>ℙ</mi><mi>CTMC</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>τ</mi><mrow><mi>k</mi><mo>−</mo><mn>1</mn></mrow></msub><mo lspace="0em" rspace="0em">|</mo><mrow><msub><mi>x</mi><mi>k</mi></msub><mo>,</mo><msub><mi>τ</mi><mi>k</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><msub><mi>ℙ</mi><mi>CTMC</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>τ</mi><mrow><mi>k</mi><mo>−</mo><mn>1</mn></mrow></msub><mo lspace="0em" rspace="0em">|</mo><msub><mi>τ</mi><mi>k</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\mathbb{P}_{\mathrm{FHS}}(\tau_{k-1}|x_{k},\tau_{k})=\mathbb{P}_{\mathrm{CTMC}}(\tau_{k-1}|x_{k},\tau_{k})=\mathbb{P}_{\mathrm{CTMC}}(\tau_{k-1}|\tau_{k}),</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A9.Ex120Xa"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A9.Ex120Xa.m2" class="ltx_Math" alttext="\displaystyle\mathbb{P}_{\mathrm{FHS}}(i_{k-1}|x_{k},\tau_{k-1})=\mathbb{P}_{\mathrm{CTMC}}(i_{k-1}|x_{k},\tau_{k-1})=\frac{1}{k}," display="inline" intent=":literal"><semantics><mrow><mrow><mrow><msub><mi>ℙ</mi><mi>FHS</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>i</mi><mrow><mi>k</mi><mo>−</mo><mn>1</mn></mrow></msub><mo lspace="0em" rspace="0em">|</mo><mrow><msub><mi>x</mi><mi>k</mi></msub><mo>,</mo><msub><mi>τ</mi><mrow><mi>k</mi><mo>−</mo><mn>1</mn></mrow></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><msub><mi>ℙ</mi><mi>CTMC</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>i</mi><mrow><mi>k</mi><mo>−</mo><mn>1</mn></mrow></msub><mo lspace="0em" rspace="0em">|</mo><mrow><msub><mi>x</mi><mi>k</mi></msub><mo>,</mo><msub><mi>τ</mi><mrow><mi>k</mi><mo>−</mo><mn>1</mn></mrow></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>k</mi></mfrac></mstyle></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\mathbb{P}_{\mathrm{FHS}}(i_{k-1}|x_{k},\tau_{k-1})=\mathbb{P}_{\mathrm{CTMC}}(i_{k-1}|x_{k},\tau_{k-1})=\frac{1}{k},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A9.Ex120Xb"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A9.Ex120Xb.m2" class="ltx_Math" alttext="\displaystyle\mathbb{P}_{\mathrm{FHS}}(a_{k-1}|x_{k},\tau_{k-1},i_{k-1})=\mu_{\theta}^{i_{k-1}}(x_{k},\tau_{k-1})[a_{k-1}]," display="inline" intent=":literal"><semantics><mrow><mrow><mrow><msub><mi>ℙ</mi><mi>FHS</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>a</mi><mrow><mi>k</mi><mo>−</mo><mn>1</mn></mrow></msub><mo lspace="0em" rspace="0em">|</mo><mrow><msub><mi>x</mi><mi>k</mi></msub><mo>,</mo><msub><mi>τ</mi><mrow><mi>k</mi><mo>−</mo><mn>1</mn></mrow></msub><mo>,</mo><msub><mi>i</mi><mrow><mi>k</mi><mo>−</mo><mn>1</mn></mrow></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><msubsup><mi>μ</mi><mi>θ</mi><msub><mi>i</mi><mrow><mi>k</mi><mo>−</mo><mn>1</mn></mrow></msub></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mi>k</mi></msub><mo>,</mo><msub><mi>τ</mi><mrow><mi>k</mi><mo>−</mo><mn>1</mn></mrow></msub><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><msub><mi>a</mi><mrow><mi>k</mi><mo>−</mo><mn>1</mn></mrow></msub><mo stretchy="false">]</mo></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\mathbb{P}_{\mathrm{FHS}}(a_{k-1}|x_{k},\tau_{k-1},i_{k-1})=\mu_{\theta}^{i_{k-1}}(x_{k},\tau_{k-1})[a_{k-1}],</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A9.Ex120Xc"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A9.Ex120Xc.m2" class="ltx_Math" alttext="\displaystyle\mathbb{P}_{\mathrm{CTMC}}(a_{k-1}|x_{k},\tau_{k-1},i_{k-1})=q_{0}^{i_{k-1}}(a_{k-1}|x_{k}^{UM})." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><msub><mi>ℙ</mi><mi>CTMC</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>a</mi><mrow><mi>k</mi><mo>−</mo><mn>1</mn></mrow></msub><mo lspace="0em" rspace="0em">|</mo><mrow><msub><mi>x</mi><mi>k</mi></msub><mo>,</mo><msub><mi>τ</mi><mrow><mi>k</mi><mo>−</mo><mn>1</mn></mrow></msub><mo>,</mo><msub><mi>i</mi><mrow><mi>k</mi><mo>−</mo><mn>1</mn></mrow></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><msubsup><mi>q</mi><mn>0</mn><msub><mi>i</mi><mrow><mi>k</mi><mo>−</mo><mn>1</mn></mrow></msub></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>a</mi><mrow><mi>k</mi><mo>−</mo><mn>1</mn></mrow></msub><mo lspace="0em" rspace="0em">|</mo><msubsup><mi>x</mi><mi>k</mi><mrow><mi>U</mi><mo lspace="0em" rspace="0em">​</mo><mi>M</mi></mrow></msubsup><mo stretchy="false">)</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\mathbb{P}_{\mathrm{CTMC}}(a_{k-1}|x_{k},\tau_{k-1},i_{k-1})=q_{0}^{i_{k-1}}(a_{k-1}|x_{k}^{UM}).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
</div>
<div id="A9.p4" class="ltx_para">
<p id="A9.p4.1" class="ltx_p">Clearly, the second equality of the first property shows that given <math id="A9.p4.m1" class="ltx_Math" alttext="\tau_{k}" display="inline" intent=":literal"><semantics><msub><mi>τ</mi><mi>k</mi></msub><annotation encoding="application/x-tex">\tau_{k}</annotation></semantics></math>, the next umasking time <math id="A9.p4.m2" class="ltx_Math" alttext="\tau_{k-1}" display="inline" intent=":literal"><semantics><msub><mi>τ</mi><mrow><mi>k</mi><mo>−</mo><mn>1</mn></mrow></msub><annotation encoding="application/x-tex">\tau_{k-1}</annotation></semantics></math> is independent of <math id="A9.p4.m3" class="ltx_Math" alttext="x_{k}" display="inline" intent=":literal"><semantics><msub><mi>x</mi><mi>k</mi></msub><annotation encoding="application/x-tex">x_{k}</annotation></semantics></math>.</p>
</div>
<div id="A9.2" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="A9.p5" class="ltx_para ltx_noindent">
<p id="A9.p5.1" class="ltx_p"><span id="A9.p5.1.1" class="ltx_text">The proof contains three steps: Step 1 shows the basic properties of transition dynamics of reverse CTMC, Step 2 further develops the statistical distributions for reverse CTMC, and Step 3 establishes the connection between the statistics of FHS and reverse CTMC processes.</span></p>
</div>
<div id="A9.p6" class="ltx_para ltx_noindent">
<p id="A9.p6.1" class="ltx_p"><span id="A9.p6.1.1" class="ltx_text ltx_font_bold">Step 1. Basic properties of reverse CTMC:<span id="A9.p6.1.1.1" class="ltx_text ltx_font_medium"> We use <math id="A9.p6.m1" class="ltx_Math" alttext="\widetilde{R}_{t}" display="inline" intent=":literal"><semantics><msub><mover accent="true"><mi>R</mi><mo>~</mo></mover><mi>t</mi></msub><annotation encoding="application/x-tex">\widetilde{R}_{t}</annotation></semantics></math> to denote the rate matrix of the reverse absorbing-rate CTMC indexed by forward time <math id="A9.p6.m2" class="ltx_Math" alttext="t" display="inline" intent=":literal"><semantics><mi>t</mi><annotation encoding="application/x-tex">t</annotation></semantics></math>.
This is for the convenience to analyze both processes with the same time indexing.
Specifically, we define the reverse rate matrix <math id="A9.p6.m3" class="ltx_Math" alttext="\widetilde{R}_{t}" display="inline" intent=":literal"><semantics><msub><mover accent="true"><mi>R</mi><mo>~</mo></mover><mi>t</mi></msub><annotation encoding="application/x-tex">\widetilde{R}_{t}</annotation></semantics></math> indexed by the forward time <math id="A9.p6.m4" class="ltx_Math" alttext="t" display="inline" intent=":literal"><semantics><mi>t</mi><annotation encoding="application/x-tex">t</annotation></semantics></math> as, for <math id="A9.p6.m5" class="ltx_Math" alttext="y\neq x" display="inline" intent=":literal"><semantics><mrow><mi>y</mi><mo>≠</mo><mi>x</mi></mrow><annotation encoding="application/x-tex">y\neq x</annotation></semantics></math>,</span></span></p>
<table id="A9.E28" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A9.E28.m1" class="ltx_Math" alttext="\widetilde{R}_{t}(x,y)\;:=\;\lim_{\delta\downarrow 0}\frac{\mathbb{P}\!\left(X_{t-\delta}=y\,\middle|\,X_{t}=x\right)}{\delta}," display="block" intent=":literal"><semantics><mrow><mrow><mrow><msub><mover accent="true"><mi>R</mi><mo>~</mo></mover><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>y</mi><mo rspace="0.280em" stretchy="false">)</mo></mrow></mrow><mo>:=</mo><mrow><munder><mo movablelimits="false" rspace="0.167em">lim</mo><mrow><mi>δ</mi><mo stretchy="false">↓</mo><mn>0</mn></mrow></munder><mfrac><mrow><mpadded style="width:0.441em;" width="0.441em"><mi>ℙ</mi></mpadded><mo>⁡</mo><mrow><mo>(</mo><mrow><msub><mi>X</mi><mrow><mi>t</mi><mo>−</mo><mi>δ</mi></mrow></msub><mo>=</mo><mi>y</mi></mrow><mo lspace="0.170em" rspace="0.170em" stretchy="true">|</mo><mrow><msub><mi>X</mi><mi>t</mi></msub><mo>=</mo><mi>x</mi></mrow><mo>)</mo></mrow></mrow><mi>δ</mi></mfrac></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\widetilde{R}_{t}(x,y)\;:=\;\lim_{\delta\downarrow 0}\frac{\mathbb{P}\!\left(X_{t-\delta}=y\,\middle|\,X_{t}=x\right)}{\delta},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(28)</span></td></tr></tbody>
</table>
<p id="A9.p6.2" class="ltx_p"><span id="A9.p6.2.1" class="ltx_text">or equivalently,</span></p>
<table id="A9.Ex121" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A9.Ex121.m1" class="ltx_math_unparsed" alttext="\mathbb{P}(X_{t-\Delta t}=y|X_{t}=x)=\mathds{1}\left\{y=x\right\}+\widetilde{R}_{t}(x,y)\Delta t+o(\Delta t)." display="block" intent=":literal"><semantics><mrow><mi>ℙ</mi><mrow><mo stretchy="false">(</mo><msub><mi>X</mi><mrow><mi>t</mi><mo>−</mo><mrow><mi mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></mrow></msub><mo>=</mo><mi>y</mi><mo fence="false" rspace="0.167em" stretchy="false">|</mo><msub><mi>X</mi><mi>t</mi></msub><mo>=</mo><mi>x</mi><mo stretchy="false">)</mo></mrow><mo>=</mo><mn>𝟙</mn><mrow><mo>{</mo><mi>y</mi><mo>=</mo><mi>x</mi><mo>}</mo></mrow><mo>+</mo><msub><mover accent="true"><mi>R</mi><mo>~</mo></mover><mi>t</mi></msub><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>y</mi><mo stretchy="false">)</mo></mrow><mi mathvariant="normal">Δ</mi><mi>t</mi><mo>+</mo><mi>o</mi><mrow><mo stretchy="false">(</mo><mi mathvariant="normal">Δ</mi><mi>t</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\mathbb{P}(X_{t-\Delta t}=y|X_{t}=x)=\mathds{1}\left\{y=x\right\}+\widetilde{R}_{t}(x,y)\Delta t+o(\Delta t).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="A9.p7" class="ltx_para ltx_noindent">
<p id="A9.p7.1" class="ltx_p"><span id="A9.p7.1.1" class="ltx_text">The diagonal entries are defined by</span></p>
<table id="A9.Ex122" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A9.Ex122.m1" class="ltx_math_unparsed" alttext="\widetilde{R}_{s}(x,x)\;=\;-\sum_{y\neq x}\widetilde{R}_{s}(x,y)." display="block" intent=":literal"><semantics><mrow><msub><mover accent="true"><mi>R</mi><mo>~</mo></mover><mi>s</mi></msub><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>x</mi><mo rspace="0.280em" stretchy="false">)</mo></mrow><mo rspace="0.058em">=</mo><mo rspace="0.055em">−</mo><munder><mo movablelimits="false">∑</mo><mrow><mi>y</mi><mo>≠</mo><mi>x</mi></mrow></munder><msub><mover accent="true"><mi>R</mi><mo>~</mo></mover><mi>s</mi></msub><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>y</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\widetilde{R}_{s}(x,x)\;=\;-\sum_{y\neq x}\widetilde{R}_{s}(x,y).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="A9.p8" class="ltx_para ltx_noindent">
<p id="A9.p8.1" class="ltx_p"><span id="A9.p8.1.1" class="ltx_text">When horizon <math id="A9.p8.m1" class="ltx_Math" alttext="T" display="inline" intent=":literal"><semantics><mi>T</mi><annotation encoding="application/x-tex">T</annotation></semantics></math> is finite, then the defined reverse rate matrix <math id="A9.p8.m2" class="ltx_Math" alttext="\widetilde{R}_{t}" display="inline" intent=":literal"><semantics><msub><mover accent="true"><mi>R</mi><mo>~</mo></mover><mi>t</mi></msub><annotation encoding="application/x-tex">\widetilde{R}_{t}</annotation></semantics></math> indexed by the forward time is equivalent to previous reverse rate matrix <math id="A9.p8.m3" class="ltx_Math" alttext="\mathchoice{\mkern 3.0mu\reflectbox{$\displaystyle\vec{\reflectbox{$\mkern-3.0mu\displaystyle R\mkern 3.0mu$}}$}\mkern-3.0mu}{\mkern 3.0mu\reflectbox{$\textstyle\vec{\reflectbox{$\mkern-3.0mu\textstyle R\mkern 3.0mu$}}$}\mkern-3.0mu}{\mkern 2.0mu\reflectbox{$\scriptstyle\vec{\reflectbox{$\mkern-2.0mu\scriptstyle R\mkern 2.0mu$}}$}\mkern-2.0mu}{\mkern 2.0mu\reflectbox{$\scriptscriptstyle\vec{\reflectbox{$\mkern-2.0mu\scriptscriptstyle R\mkern 2.0mu$}}$}\mkern-2.0mu}_{t}" display="inline" intent=":literal"><semantics><msub><mpadded style="width:6.5pt;height:7.1pt;vertical-align:-0.0pt;" depth="0.0pt" height="7.1pt" width="6.5pt"><mover accent="true"><mpadded style="width:7.7pt;height:6.8pt;vertical-align:-0.0pt;" depth="0.0pt" height="6.8pt" width="7.7pt"><mi>R</mi></mpadded><mo stretchy="false">→</mo></mover></mpadded><mi>t</mi></msub><annotation encoding="application/x-tex">\mathchoice{\mkern 3.0mu\reflectbox{$\displaystyle\vec{\reflectbox{$\mkern-3.0mu\displaystyle R\mkern 3.0mu$}}$}\mkern-3.0mu}{\mkern 3.0mu\reflectbox{$\textstyle\vec{\reflectbox{$\mkern-3.0mu\textstyle R\mkern 3.0mu$}}$}\mkern-3.0mu}{\mkern 2.0mu\reflectbox{$\scriptstyle\vec{\reflectbox{$\mkern-2.0mu\scriptstyle R\mkern 2.0mu$}}$}\mkern-2.0mu}{\mkern 2.0mu\reflectbox{$\scriptscriptstyle\vec{\reflectbox{$\mkern-2.0mu\scriptscriptstyle R\mkern 2.0mu$}}$}\mkern-2.0mu}_{t}</annotation></semantics></math> by</span></p>
<table id="A9.Ex123" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A9.Ex123.m1" class="ltx_Math" alttext="\widetilde{R}_{t}(x,y)=\mathchoice{\mkern 3.0mu\reflectbox{$\displaystyle\vec{\reflectbox{$\mkern-3.0mu\displaystyle R\mkern 3.0mu$}}$}\mkern-3.0mu}{\mkern 3.0mu\reflectbox{$\textstyle\vec{\reflectbox{$\mkern-3.0mu\textstyle R\mkern 3.0mu$}}$}\mkern-3.0mu}{\mkern 2.0mu\reflectbox{$\scriptstyle\vec{\reflectbox{$\mkern-2.0mu\scriptstyle R\mkern 2.0mu$}}$}\mkern-2.0mu}{\mkern 2.0mu\reflectbox{$\scriptscriptstyle\vec{\reflectbox{$\mkern-2.0mu\scriptscriptstyle R\mkern 2.0mu$}}$}\mkern-2.0mu}_{T-t}(x,y),\quad\forall y\neq x." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mrow><msub><mover accent="true"><mi>R</mi><mo>~</mo></mover><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>y</mi><mo stretchy="false">)</mo></mrow></mrow><mo rspace="0.448em">=</mo><mrow><msub><mpadded style="width:6.5pt;height:7.1pt;vertical-align:-0.0pt;" depth="0.0pt" height="7.1pt" width="6.5pt"><mover accent="true"><mpadded style="width:7.7pt;height:6.8pt;vertical-align:-0.0pt;" depth="0.0pt" height="6.8pt" width="7.7pt"><mi>R</mi></mpadded><mo stretchy="false">→</mo></mover></mpadded><mrow><mi>T</mi><mo>−</mo><mi>t</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>y</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo rspace="1.167em">,</mo><mrow><mrow><mo rspace="0.167em">∀</mo><mi>y</mi></mrow><mo>≠</mo><mi>x</mi></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\widetilde{R}_{t}(x,y)=\mathchoice{\mkern 3.0mu\reflectbox{$\displaystyle\vec{\reflectbox{$\mkern-3.0mu\displaystyle R\mkern 3.0mu$}}$}\mkern-3.0mu}{\mkern 3.0mu\reflectbox{$\textstyle\vec{\reflectbox{$\mkern-3.0mu\textstyle R\mkern 3.0mu$}}$}\mkern-3.0mu}{\mkern 2.0mu\reflectbox{$\scriptstyle\vec{\reflectbox{$\mkern-2.0mu\scriptstyle R\mkern 2.0mu$}}$}\mkern-2.0mu}{\mkern 2.0mu\reflectbox{$\scriptscriptstyle\vec{\reflectbox{$\mkern-2.0mu\scriptscriptstyle R\mkern 2.0mu$}}$}\mkern-2.0mu}_{T-t}(x,y),\quad\forall y\neq x.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="A9.p9" class="ltx_para ltx_noindent">
<p id="A9.p9.1" class="ltx_p"><span id="A9.p9.1.1" class="ltx_text">Based on the notations and definitions above, we next have several basic results concerning time-inhomogeneous CTMCs in <a href="#Thmlemma5" title="Lemma 5. ‣ Proof. ‣ Appendix I FHS Sampling in CTMC Framework: and its Proof ‣ Sharp Convergence Rates for Masked Diffusion Models" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Lemma</span> <span class="ltx_text ltx_ref_tag">5</span></a>.</span></p>
</div>
<div id="Thmlemma5" class="ltx_theorem ltx_theorem_lemma">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="Thmlemma5.2" class="ltx_text ltx_font_bold">Lemma 5</span></span><span id="Thmlemma5.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="Thmlemma5.p1" class="ltx_para ltx_noindent">
<p id="Thmlemma5.p1.1" class="ltx_p"><span id="Thmlemma5.p1.1.1" class="ltx_text ltx_font_italic">Let <math id="Thmlemma5.p1.m1" class="ltx_Math" alttext="(Y_{t})_{t}" display="inline" intent=":literal"><semantics><msub><mrow><mo stretchy="false">(</mo><msub><mi>Y</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow><mi>t</mi></msub><annotation encoding="application/x-tex">(Y_{t})_{t}</annotation></semantics></math> denote the reverse absorbing-rate time-inhomogeneous CTMC with the generator matrix <math id="Thmlemma5.p1.m2" class="ltx_Math" alttext="\{\widetilde{R}_{t}\}" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">{</mo><msub><mover accent="true"><mi>R</mi><mo>~</mo></mover><mi>t</mi></msub><mo stretchy="false">}</mo></mrow><annotation encoding="application/x-tex">\{\widetilde{R}_{t}\}</annotation></semantics></math> defined in (<a href="#A9.E28" title="Equation 28 ‣ Proof. ‣ Appendix I FHS Sampling in CTMC Framework: and its Proof ‣ Sharp Convergence Rates for Masked Diffusion Models" class="ltx_ref"><span class="ltx_text ltx_ref_tag">28</span></a>). Let the unmasking time in state <math id="Thmlemma5.p1.m3" class="ltx_Math" alttext="x" display="inline" intent=":literal"><semantics><mi>x</mi><annotation encoding="application/x-tex">x</annotation></semantics></math> be <math id="Thmlemma5.p1.m4" class="ltx_Math" alttext="\tau:=\sup\{s&lt;t:Y_{s}\neq x\}" display="inline" intent=":literal"><semantics><mrow><mi>τ</mi><mo rspace="0.1389em">:=</mo><mrow><mo lspace="0.1389em" rspace="0em">sup</mo><mrow><mo stretchy="false">{</mo><mrow><mi>s</mi><mo>&lt;</mo><mi>t</mi></mrow><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><msub><mi>Y</mi><mi>s</mi></msub><mo>≠</mo><mi>x</mi></mrow><mo stretchy="false">}</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\tau:=\sup\{s&lt;t:Y_{s}\neq x\}</annotation></semantics></math>. Then</span></p>
<ol id="A9.I2" class="ltx_enumerate">
<li id="A9.I2.i1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">1.</span> 
<div id="A9.I2.i1.p1" class="ltx_para ltx_noindent">
<p id="A9.I2.i1.p1.1" class="ltx_p"><span id="A9.I2.i1.p1.1.1" class="ltx_text ltx_font_italic">The instantaneous total rate of leaving </span><math id="A9.I2.i1.p1.m1" class="ltx_Math" alttext="x" display="inline" intent=":literal"><semantics><mi>x</mi><annotation encoding="application/x-tex">x</annotation></semantics></math><span id="A9.I2.i1.p1.1.2" class="ltx_text ltx_font_italic"> at time </span><math id="A9.I2.i1.p1.m2" class="ltx_Math" alttext="t" display="inline" intent=":literal"><semantics><mi>t</mi><annotation encoding="application/x-tex">t</annotation></semantics></math><span id="A9.I2.i1.p1.1.3" class="ltx_text ltx_font_italic"> is</span></p>
<table id="A9.Ex124" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A9.Ex124.m1" class="ltx_Math" alttext="\Lambda(t,x)=\sum_{y\neq x}\widetilde{R}_{t}(x,y)." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mi mathvariant="normal">Λ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo>,</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo rspace="0.111em">=</mo><mrow><munder><mo movablelimits="false">∑</mo><mrow><mi>y</mi><mo>≠</mo><mi>x</mi></mrow></munder><mrow><msub><mover accent="true"><mi>R</mi><mo>~</mo></mover><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>y</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\Lambda(t,x)=\sum_{y\neq x}\widetilde{R}_{t}(x,y).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div></li>
<li id="A9.I2.i2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">2.</span> 
<div id="A9.I2.i2.p1" class="ltx_para ltx_noindent">
<p id="A9.I2.i2.p1.1" class="ltx_p"><span id="A9.I2.i2.p1.1.1" class="ltx_text ltx_font_italic">The unmasking time </span><math id="A9.I2.i2.p1.m1" class="ltx_Math" alttext="\tau" display="inline" intent=":literal"><semantics><mi>τ</mi><annotation encoding="application/x-tex">\tau</annotation></semantics></math><span id="A9.I2.i2.p1.1.2" class="ltx_text ltx_font_italic"> in state </span><math id="A9.I2.i2.p1.m2" class="ltx_Math" alttext="x" display="inline" intent=":literal"><semantics><mi>x</mi><annotation encoding="application/x-tex">x</annotation></semantics></math><span id="A9.I2.i2.p1.1.3" class="ltx_text ltx_font_italic"> satisfies</span></p>
<table id="A9.Ex125" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A9.Ex125.m1" class="ltx_math_unparsed" alttext="\mathbb{P}(\tau&lt;t-h\mid Y_{t}=x)=\exp\!\left(-\int_{t-h}^{t}\Lambda(u,x)\,du\right)." display="block" intent=":literal"><semantics><mrow><mi>ℙ</mi><mrow><mo stretchy="false">(</mo><mi>τ</mi><mo>&lt;</mo><mi>t</mi><mo>−</mo><mi>h</mi><mo lspace="0em" rspace="0.167em">∣</mo><msub><mi>Y</mi><mi>t</mi></msub><mo>=</mo><mi>x</mi><mo stretchy="false">)</mo></mrow><mo>=</mo><mpadded style="width:1.370em;" width="1.370em"><mi>exp</mi></mpadded><mrow><mo>(</mo><mo lspace="0em" rspace="0.055em">−</mo><msubsup><mo>∫</mo><mrow><mi>t</mi><mo>−</mo><mi>h</mi></mrow><mi>t</mi></msubsup><mi mathvariant="normal">Λ</mi><mrow><mo stretchy="false">(</mo><mi>u</mi><mo>,</mo><mi>x</mi><mo rspace="0.170em" stretchy="false">)</mo></mrow><mi>d</mi><mi>u</mi><mo>)</mo></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\mathbb{P}(\tau&lt;t-h\mid Y_{t}=x)=\exp\!\left(-\int_{t-h}^{t}\Lambda(u,x)\,du\right).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div></li>
<li id="A9.I2.i3" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">3.</span> 
<div id="A9.I2.i3.p1" class="ltx_para ltx_noindent">
<p id="A9.I2.i3.p1.1" class="ltx_p"><span id="A9.I2.i3.p1.1.1" class="ltx_text ltx_font_italic">Given that unmasking occurs at time </span><math id="A9.I2.i3.p1.m1" class="ltx_Math" alttext="\tau" display="inline" intent=":literal"><semantics><mi>τ</mi><annotation encoding="application/x-tex">\tau</annotation></semantics></math><span id="A9.I2.i3.p1.1.2" class="ltx_text ltx_font_italic">, the distribution of the predicted token value satisfies</span></p>
<table id="A9.Ex126" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A9.Ex126.m1" class="ltx_math_unparsed" alttext="\lim\limits_{\delta\downarrow 0}\ \mathbb{P}(Y_{\tau}=y\mid Y_{t}=x,\tau\in(t-\delta,t])=\frac{\widetilde{R}_{t}(x,y)}{\Lambda(t,x)}." display="block" intent=":literal"><semantics><mrow><munder><mo movablelimits="false">lim</mo><mrow><mi>δ</mi><mo stretchy="false">↓</mo><mn>0</mn></mrow></munder><mi>ℙ</mi><mrow><mo stretchy="false">(</mo><msub><mi>Y</mi><mi>τ</mi></msub><mo>=</mo><mi>y</mi><mo lspace="0em" rspace="0.167em">∣</mo><msub><mi>Y</mi><mi>t</mi></msub><mo>=</mo><mi>x</mi><mo>,</mo><mi>τ</mi><mo>∈</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo>−</mo><mi>δ</mi><mo>,</mo><mi>t</mi><mo stretchy="false">]</mo></mrow><mo stretchy="false">)</mo></mrow><mo>=</mo><mfrac><mrow><msub><mover accent="true"><mi>R</mi><mo>~</mo></mover><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>y</mi><mo stretchy="false">)</mo></mrow></mrow><mrow><mi mathvariant="normal">Λ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo>,</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow></mfrac><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\lim\limits_{\delta\downarrow 0}\ \mathbb{P}(Y_{\tau}=y\mid Y_{t}=x,\tau\in(t-\delta,t])=\frac{\widetilde{R}_{t}(x,y)}{\Lambda(t,x)}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div></li>
</ol>
</div>
</div>
<div id="A9.p10" class="ltx_para ltx_noindent">
<p id="A9.p10.1" class="ltx_p"><span id="A9.p10.1.1" class="ltx_text">The full proof of <a href="#Thmlemma5" title="Lemma 5. ‣ Proof. ‣ Appendix I FHS Sampling in CTMC Framework: and its Proof ‣ Sharp Convergence Rates for Masked Diffusion Models" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Lemma</span> <span class="ltx_text ltx_ref_tag">5</span></a> is provided in <a href="#A12.SS5" title="L.5 Proof of ‣ Appendix L Proofs of Auxiliary Lemmas ‣ Sharp Convergence Rates for Masked Diffusion Models" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Section</span> <span class="ltx_text ltx_ref_tag">L.5</span></a>.</span></p>
</div>
<div id="A9.p11" class="ltx_para ltx_noindent">
<p id="A9.p11.1" class="ltx_p"><span id="A9.p11.1.1" class="ltx_text ltx_font_bold">Step 2. Distributions induced by <math id="A9.p11.m1" class="ltx_Math" alttext="\mathbb{P}_{\mathrm{CTMC}}" display="inline" intent=":literal"><semantics><msub><mi>ℙ</mi><mi>CTMC</mi></msub><annotation encoding="application/x-tex">\mathbb{P}_{\mathrm{CTMC}}</annotation></semantics></math>:<span id="A9.p11.1.1.1" class="ltx_text ltx_font_medium"> We characterize some important distributions induced by <math id="A9.p11.m2" class="ltx_Math" alttext="\mathbb{P}_{\mathrm{CTMC}}" display="inline" intent=":literal"><semantics><msub><mi>ℙ</mi><mi>CTMC</mi></msub><annotation encoding="application/x-tex">\mathbb{P}_{\mathrm{CTMC}}</annotation></semantics></math>, which will be useful to establish the connection between <math id="A9.p11.m3" class="ltx_Math" alttext="\mathbb{P}_{\mathrm{FHS}}" display="inline" intent=":literal"><semantics><msub><mi>ℙ</mi><mi>FHS</mi></msub><annotation encoding="application/x-tex">\mathbb{P}_{\mathrm{FHS}}</annotation></semantics></math> and <math id="A9.p11.m4" class="ltx_Math" alttext="\mathbb{P}_{\mathrm{CTMC}}" display="inline" intent=":literal"><semantics><msub><mi>ℙ</mi><mi>CTMC</mi></msub><annotation encoding="application/x-tex">\mathbb{P}_{\mathrm{CTMC}}</annotation></semantics></math>. For any <math id="A9.p11.m5" class="ltx_Math" alttext="x_{k}" display="inline" intent=":literal"><semantics><msub><mi>x</mi><mi>k</mi></msub><annotation encoding="application/x-tex">x_{k}</annotation></semantics></math> with <math id="A9.p11.m6" class="ltx_Math" alttext="k\geq 1" display="inline" intent=":literal"><semantics><mrow><mi>k</mi><mo>≥</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">k\geq 1</annotation></semantics></math>, there must exist <math id="A9.p11.m7" class="ltx_Math" alttext="k" display="inline" intent=":literal"><semantics><mi>k</mi><annotation encoding="application/x-tex">k</annotation></semantics></math> <math id="A9.p11.m8" class="ltx_Math" alttext="\mathrm{[MASK]}" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">[</mo><mi>MASK</mi><mo stretchy="false">]</mo></mrow><annotation encoding="application/x-tex">\mathrm{[MASK]}</annotation></semantics></math> tokens in <math id="A9.p11.m9" class="ltx_Math" alttext="x_{k}" display="inline" intent=":literal"><semantics><msub><mi>x</mi><mi>k</mi></msub><annotation encoding="application/x-tex">x_{k}</annotation></semantics></math> due to the definition of <math id="A9.p11.m10" class="ltx_Math" alttext="x_{k}" display="inline" intent=":literal"><semantics><msub><mi>x</mi><mi>k</mi></msub><annotation encoding="application/x-tex">x_{k}</annotation></semantics></math>. Then without loss of generality, let <math id="A9.p11.m11" class="ltx_Math" alttext="x^{i}" display="inline" intent=":literal"><semantics><msup><mi>x</mi><mi>i</mi></msup><annotation encoding="application/x-tex">x^{i}</annotation></semantics></math> be one of the <math id="A9.p11.m12" class="ltx_Math" alttext="\mathrm{[MASK]}" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">[</mo><mi>MASK</mi><mo stretchy="false">]</mo></mrow><annotation encoding="application/x-tex">\mathrm{[MASK]}</annotation></semantics></math> tokens in the following proof.</span></span></p>
</div>
<div id="A9.p12" class="ltx_para ltx_noindent">
<p id="A9.p12.1" class="ltx_p"><span id="A9.p12.1.1" class="ltx_text">Consider the reverse rate matrix <math id="A9.p12.m1" class="ltx_Math" alttext="\widetilde{R}_{t}" display="inline" intent=":literal"><semantics><msub><mover accent="true"><mi>R</mi><mo>~</mo></mover><mi>t</mi></msub><annotation encoding="application/x-tex">\widetilde{R}_{t}</annotation></semantics></math> with the forward time index <math id="A9.p12.m2" class="ltx_Math" alttext="t" display="inline" intent=":literal"><semantics><mi>t</mi><annotation encoding="application/x-tex">t</annotation></semantics></math> of CTMC. For any <math id="A9.p12.m3" class="ltx_Math" alttext="a\neq\mathrm{[MASK]}" display="inline" intent=":literal"><semantics><mrow><mi>a</mi><mo>≠</mo><mrow><mo stretchy="false">[</mo><mi>MASK</mi><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">a\neq\mathrm{[MASK]}</annotation></semantics></math>, we have</span></p>
<table id="A9.E29" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A9.E29.m1" class="ltx_math_unparsed" alttext="\widetilde{R}_{t}\big(x,x^{-i}\oplus_{i}a\big)=R_{t}\big(x^{-i}\oplus_{i}a,x\big)\cdot\frac{q_{t}(x^{-i}\oplus_{i}a)}{q_{t}(x)}=\frac{q_{t}(x^{-i}\oplus_{i}a)}{q_{t}(x)}." display="block" intent=":literal"><semantics><mrow><msub><mover accent="true"><mi>R</mi><mo>~</mo></mover><mi>t</mi></msub><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mi>x</mi><mo>,</mo><msup><mi>x</mi><mrow><mo>−</mo><mi>i</mi></mrow></msup><msub><mo>⊕</mo><mi>i</mi></msub><mi>a</mi><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow><mo>=</mo><msub><mi>R</mi><mi>t</mi></msub><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><msup><mi>x</mi><mrow><mo>−</mo><mi>i</mi></mrow></msup><msub><mo>⊕</mo><mi>i</mi></msub><mi>a</mi><mo>,</mo><mi>x</mi><mo maxsize="1.200em" minsize="1.200em" rspace="0.055em">)</mo></mrow><mo rspace="0.222em">⋅</mo><mfrac><mrow><mi>q</mi><msub><mrow></mrow><mi>t</mi></msub><mo stretchy="false">(</mo><mi>x</mi><msup><mrow></mrow><mrow><mo>−</mo><mi>i</mi></mrow></msup><mo>⊕</mo><msub><mrow></mrow><mi>i</mi></msub><mi>a</mi><mo stretchy="false">)</mo></mrow><mrow><msub><mi>q</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow></mfrac><mo>=</mo><mfrac><mrow><mi>q</mi><msub><mrow></mrow><mi>t</mi></msub><mo stretchy="false">(</mo><mi>x</mi><msup><mrow></mrow><mrow><mo>−</mo><mi>i</mi></mrow></msup><mo>⊕</mo><msub><mrow></mrow><mi>i</mi></msub><mi>a</mi><mo stretchy="false">)</mo></mrow><mrow><msub><mi>q</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow></mfrac><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\widetilde{R}_{t}\big(x,x^{-i}\oplus_{i}a\big)=R_{t}\big(x^{-i}\oplus_{i}a,x\big)\cdot\frac{q_{t}(x^{-i}\oplus_{i}a)}{q_{t}(x)}=\frac{q_{t}(x^{-i}\oplus_{i}a)}{q_{t}(x)}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(29)</span></td></tr></tbody>
</table>
</div>
<div id="A9.p13" class="ltx_para ltx_noindent">
<p id="A9.p13.1" class="ltx_p"><span id="A9.p13.1.1" class="ltx_text">Following from Claim 1 of <a href="#Thmlemma5" title="Lemma 5. ‣ Proof. ‣ Appendix I FHS Sampling in CTMC Framework: and its Proof ‣ Sharp Convergence Rates for Masked Diffusion Models" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Lemma</span> <span class="ltx_text ltx_ref_tag">5</span></a>, the total rate of leaving <math id="A9.p13.m1" class="ltx_Math" alttext="x" display="inline" intent=":literal"><semantics><mi>x</mi><annotation encoding="application/x-tex">x</annotation></semantics></math> at time <math id="A9.p13.m2" class="ltx_Math" alttext="t" display="inline" intent=":literal"><semantics><mi>t</mi><annotation encoding="application/x-tex">t</annotation></semantics></math> on index <math id="A9.p13.m3" class="ltx_Math" alttext="i" display="inline" intent=":literal"><semantics><mi>i</mi><annotation encoding="application/x-tex">i</annotation></semantics></math> is given by</span></p>
<table id="A9.E30" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A9.E30.m1" class="ltx_math_unparsed" alttext="r_{i}(t,x):=\sum_{b\neq\mathrm{[MASK]}}\widetilde{R}_{t}(x,x^{-i}\oplus_{i}b)=\frac{\sum_{b\neq\mathrm{[MASK]}}q_{t}(x^{-i}\oplus_{i}b)}{q_{t}(x)}=\frac{\alpha_{t}}{1-\alpha_{t}}," display="block" intent=":literal"><semantics><mrow><msub><mi>r</mi><mi>i</mi></msub><mrow><mo stretchy="false">(</mo><mi>t</mi><mo>,</mo><mi>x</mi><mo stretchy="false">)</mo></mrow><mo rspace="0.111em">:=</mo><munder><mo movablelimits="false">∑</mo><mrow><mi>b</mi><mo>≠</mo><mrow><mo stretchy="false">[</mo><mi>MASK</mi><mo stretchy="false">]</mo></mrow></mrow></munder><msub><mover accent="true"><mi>R</mi><mo>~</mo></mover><mi>t</mi></msub><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><msup><mi>x</mi><mrow><mo>−</mo><mi>i</mi></mrow></msup><msub><mo>⊕</mo><mi>i</mi></msub><mi>b</mi><mo stretchy="false">)</mo></mrow><mo>=</mo><mfrac><mrow><mo>∑</mo><msub><mrow></mrow><mrow><mi>b</mi><mo>≠</mo><mrow><mo stretchy="false">[</mo><mi>MASK</mi><mo stretchy="false">]</mo></mrow></mrow></msub><mi>q</mi><msub><mrow></mrow><mi>t</mi></msub><mo stretchy="false">(</mo><mi>x</mi><msup><mrow></mrow><mrow><mo>−</mo><mi>i</mi></mrow></msup><mo>⊕</mo><msub><mrow></mrow><mi>i</mi></msub><mi>b</mi><mo stretchy="false">)</mo></mrow><mrow><msub><mi>q</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow></mfrac><mo>=</mo><mfrac><msub><mi>α</mi><mi>t</mi></msub><mrow><mn>1</mn><mo>−</mo><msub><mi>α</mi><mi>t</mi></msub></mrow></mfrac><mo>,</mo></mrow><annotation encoding="application/x-tex">r_{i}(t,x):=\sum_{b\neq\mathrm{[MASK]}}\widetilde{R}_{t}(x,x^{-i}\oplus_{i}b)=\frac{\sum_{b\neq\mathrm{[MASK]}}q_{t}(x^{-i}\oplus_{i}b)}{q_{t}(x)}=\frac{\alpha_{t}}{1-\alpha_{t}},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(30)</span></td></tr></tbody>
</table>
<p id="A9.p13.2" class="ltx_p"><span id="A9.p13.2.1" class="ltx_text">where the last equality follows from (<a href="#A8.E23" title="Equation 23 ‣ Appendix H Proof of ‣ Sharp Convergence Rates for Masked Diffusion Models" class="ltx_ref"><span class="ltx_text ltx_ref_tag">23</span></a>).
Then the total reverse jump rate of leaving <math id="A9.p13.m4" class="ltx_Math" alttext="x" display="inline" intent=":literal"><semantics><mi>x</mi><annotation encoding="application/x-tex">x</annotation></semantics></math> at time <math id="A9.p13.m5" class="ltx_Math" alttext="t" display="inline" intent=":literal"><semantics><mi>t</mi><annotation encoding="application/x-tex">t</annotation></semantics></math> is given by</span></p>
<table id="A9.E31" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A9.E31.m1" class="ltx_math_unparsed" alttext="\Lambda(t,x)=\sum_{y\neq x}\widetilde{R}_{t}(x,y)=\sum_{i:x^{i}=\mathrm{[MASK]}}r_{i}(t,x)=m(x)\cdot\frac{\alpha_{t}}{1-\alpha_{t}}," display="block" intent=":literal"><semantics><mrow><mi mathvariant="normal">Λ</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo>,</mo><mi>x</mi><mo stretchy="false">)</mo></mrow><mo rspace="0.111em">=</mo><munder><mo movablelimits="false">∑</mo><mrow><mi>y</mi><mo>≠</mo><mi>x</mi></mrow></munder><msub><mover accent="true"><mi>R</mi><mo>~</mo></mover><mi>t</mi></msub><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>y</mi><mo stretchy="false">)</mo></mrow><mo rspace="0.111em">=</mo><munder><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><msup><mi>x</mi><mi>i</mi></msup><mo>=</mo><mrow><mo stretchy="false">[</mo><mi>MASK</mi><mo stretchy="false">]</mo></mrow></mrow></mrow></munder><msub><mi>r</mi><mi>i</mi></msub><mrow><mo stretchy="false">(</mo><mi>t</mi><mo>,</mo><mi>x</mi><mo stretchy="false">)</mo></mrow><mo>=</mo><mi>m</mi><mrow><mo stretchy="false">(</mo><mi>x</mi><mo rspace="0.055em" stretchy="false">)</mo></mrow><mo rspace="0.222em">⋅</mo><mfrac><msub><mi>α</mi><mi>t</mi></msub><mrow><mn>1</mn><mo>−</mo><msub><mi>α</mi><mi>t</mi></msub></mrow></mfrac><mo>,</mo></mrow><annotation encoding="application/x-tex">\Lambda(t,x)=\sum_{y\neq x}\widetilde{R}_{t}(x,y)=\sum_{i:x^{i}=\mathrm{[MASK]}}r_{i}(t,x)=m(x)\cdot\frac{\alpha_{t}}{1-\alpha_{t}},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(31)</span></td></tr></tbody>
</table>
<p id="A9.p13.3" class="ltx_p"><span id="A9.p13.3.1" class="ltx_text">where <math id="A9.p13.m6" class="ltx_Math" alttext="m(x)" display="inline" intent=":literal"><semantics><mrow><mi>m</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">m(x)</annotation></semantics></math> denotes the number of masked tokens in <math id="A9.p13.m7" class="ltx_Math" alttext="x" display="inline" intent=":literal"><semantics><mi>x</mi><annotation encoding="application/x-tex">x</annotation></semantics></math>.</span></p>
</div>
<div id="A9.p14" class="ltx_para ltx_noindent">
<p id="A9.p14.1" class="ltx_p"><span id="A9.p14.1.1" class="ltx_text">Then, substituting (<a href="#A9.E31" title="Equation 31 ‣ Proof. ‣ Appendix I FHS Sampling in CTMC Framework: and its Proof ‣ Sharp Convergence Rates for Masked Diffusion Models" class="ltx_ref"><span class="ltx_text ltx_ref_tag">31</span></a>) into Claim 2 of <a href="#Thmlemma5" title="Lemma 5. ‣ Proof. ‣ Appendix I FHS Sampling in CTMC Framework: and its Proof ‣ Sharp Convergence Rates for Masked Diffusion Models" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Lemma</span> <span class="ltx_text ltx_ref_tag">5</span></a>, we can derive the conditional distribution of <math id="A9.p14.m1" class="ltx_Math" alttext="\tau_{k-1}" display="inline" intent=":literal"><semantics><msub><mi>τ</mi><mrow><mi>k</mi><mo>−</mo><mn>1</mn></mrow></msub><annotation encoding="application/x-tex">\tau_{k-1}</annotation></semantics></math> given <math id="A9.p14.m2" class="ltx_Math" alttext="x_{k}" display="inline" intent=":literal"><semantics><msub><mi>x</mi><mi>k</mi></msub><annotation encoding="application/x-tex">x_{k}</annotation></semantics></math> and <math id="A9.p14.m3" class="ltx_Math" alttext="\tau_{k}" display="inline" intent=":literal"><semantics><msub><mi>τ</mi><mi>k</mi></msub><annotation encoding="application/x-tex">\tau_{k}</annotation></semantics></math> as:</span></p>
<table id="A9.Ex127" class="ltx_equationgroup ltx_eqn_table">

<tbody id="A9.Ex127X"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A9.Ex127X.m2" class="ltx_Math" alttext="\displaystyle\mathbb{P}_{\mathrm{CTMC}}(\tau_{k-1}&lt;t|x_{k},\tau_{k})" display="inline" intent=":literal"><semantics><mrow><msub><mi>ℙ</mi><mi>CTMC</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>τ</mi><mrow><mi>k</mi><mo>−</mo><mn>1</mn></mrow></msub><mo>&lt;</mo><mi>t</mi></mrow><mo lspace="0em" rspace="0em">|</mo><mrow><msub><mi>x</mi><mi>k</mi></msub><mo>,</mo><msub><mi>τ</mi><mi>k</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\mathbb{P}_{\mathrm{CTMC}}(\tau_{k-1}&lt;t|x_{k},\tau_{k})</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A9.Ex127X.m3" class="ltx_Math" alttext="\displaystyle=\exp{\left(-\int_{t}^{\tau_{k}}\Lambda(u,x_{k})\mathrm{d}u\right)}" display="inline" intent=":literal"><semantics><mrow><mo>=</mo><mi>exp</mi><mo>(</mo><mo lspace="0em">−</mo><mstyle displaystyle="true"><mo>∫</mo></mstyle><msub><mrow></mrow><mi>t</mi></msub><msup><mrow></mrow><msub><mi>τ</mi><mi>k</mi></msub></msup><mi mathvariant="normal">Λ</mi><mo stretchy="false">(</mo><mi>u</mi><mo>,</mo><mi>x</mi><msub><mrow></mrow><mi>k</mi></msub><mo stretchy="false">)</mo><mi>d</mi><mi>u</mi><mo>)</mo></mrow><annotation encoding="application/x-tex">\displaystyle=\exp{\left(-\int_{t}^{\tau_{k}}\Lambda(u,x_{k})\mathrm{d}u\right)}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A9.Ex127Xa"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A9.Ex127Xa.m2" class="ltx_Math" alttext="\displaystyle=\exp\!\Big(-\!\!\int_{t}^{\tau_{k}}k\cdot\frac{e^{-u}}{1-e^{-u}}\,du\Big)" display="inline" intent=":literal"><semantics><mrow><mo>=</mo><mpadded style="width:1.370em;" width="1.370em"><mi>exp</mi></mpadded><mo maxsize="1.600em" minsize="1.600em">(</mo><mpadded style="width:0.632em;" width="0.632em"><mo lspace="0em">−</mo></mpadded><mstyle displaystyle="true"><mo>∫</mo></mstyle><msub><mrow></mrow><mi>t</mi></msub><msup><mrow></mrow><msub><mi>τ</mi><mi>k</mi></msub></msup><mi>k</mi><mo lspace="0.222em" rspace="0.222em">⋅</mo><mstyle displaystyle="true"><mfrac><msup><mi>e</mi><mrow><mo>−</mo><mi>u</mi></mrow></msup><mrow><mn>1</mn><mo>−</mo><msup><mi>e</mi><mrow><mo>−</mo><mi>u</mi></mrow></msup></mrow></mfrac></mstyle><mi>d</mi><mi>u</mi><mo maxsize="1.600em" minsize="1.600em">)</mo></mrow><annotation encoding="application/x-tex">\displaystyle=\exp\!\Big(-\!\!\int_{t}^{\tau_{k}}k\cdot\frac{e^{-u}}{1-e^{-u}}\,du\Big)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A9.Ex127Xb"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A9.Ex127Xb.m2" class="ltx_Math" alttext="\displaystyle=\exp\!\Big(-\!\!k\cdot\log(1-e^{-u})|_{u=t}^{\tau_{k}}\Big)" display="inline" intent=":literal"><semantics><mrow><mo>=</mo><mpadded style="width:1.370em;" width="1.370em"><mi>exp</mi></mpadded><mo maxsize="1.600em" minsize="1.600em">(</mo><mpadded style="width:0.632em;" width="0.632em"><mo lspace="0em">−</mo></mpadded><mi>k</mi><mo lspace="0.222em" rspace="0.222em">⋅</mo><mi>log</mi><mo stretchy="false">(</mo><mn>1</mn><mo>−</mo><mi>e</mi><msup><mrow></mrow><mrow><mo>−</mo><mi>u</mi></mrow></msup><mo stretchy="false">)</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><msub><mrow></mrow><mrow><mi>u</mi><mo>=</mo><mi>t</mi></mrow></msub><msup><mrow></mrow><msub><mi>τ</mi><mi>k</mi></msub></msup><mo maxsize="1.600em" minsize="1.600em">)</mo></mrow><annotation encoding="application/x-tex">\displaystyle=\exp\!\Big(-\!\!k\cdot\log(1-e^{-u})|_{u=t}^{\tau_{k}}\Big)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A9.Ex127Xc"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A9.Ex127Xc.m2" class="ltx_Math" alttext="\displaystyle=\left(\frac{1-e^{-t}}{1-e^{-\tau_{k}}}\right)^{k}," display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>=</mo><msup><mrow><mo>(</mo><mstyle displaystyle="true"><mfrac><mrow><mn>1</mn><mo>−</mo><msup><mi>e</mi><mrow><mo>−</mo><mi>t</mi></mrow></msup></mrow><mrow><mn>1</mn><mo>−</mo><msup><mi>e</mi><mrow><mo>−</mo><msub><mi>τ</mi><mi>k</mi></msub></mrow></msup></mrow></mfrac></mstyle><mo>)</mo></mrow><mi>k</mi></msup></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle=\left(\frac{1-e^{-t}}{1-e^{-\tau_{k}}}\right)^{k},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A9.p14.2" class="ltx_p"><span id="A9.p14.2.1" class="ltx_text">which we note that <math id="A9.p14.m4" class="ltx_Math" alttext="\tau_{k-1}" display="inline" intent=":literal"><semantics><msub><mi>τ</mi><mrow><mi>k</mi><mo>−</mo><mn>1</mn></mrow></msub><annotation encoding="application/x-tex">\tau_{k-1}</annotation></semantics></math> does not depend on <math id="A9.p14.m5" class="ltx_Math" alttext="x_{k}" display="inline" intent=":literal"><semantics><msub><mi>x</mi><mi>k</mi></msub><annotation encoding="application/x-tex">x_{k}</annotation></semantics></math> given <math id="A9.p14.m6" class="ltx_Math" alttext="\tau_{k}" display="inline" intent=":literal"><semantics><msub><mi>τ</mi><mi>k</mi></msub><annotation encoding="application/x-tex">\tau_{k}</annotation></semantics></math>.</span></p>
</div>
<div id="A9.p15" class="ltx_para ltx_noindent">
<p id="A9.p15.1" class="ltx_p"><span id="A9.p15.1.1" class="ltx_text">Next, we derive <math id="A9.p15.m1" class="ltx_Math" alttext="\mathbb{P}_{\mathrm{CTMC}}(i_{k-1}|x_{k},\tau_{k-1})" display="inline" intent=":literal"><semantics><mrow><msub><mi>ℙ</mi><mi>CTMC</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>i</mi><mrow><mi>k</mi><mo>−</mo><mn>1</mn></mrow></msub><mo lspace="0em" rspace="0em">|</mo><mrow><msub><mi>x</mi><mi>k</mi></msub><mo>,</mo><msub><mi>τ</mi><mrow><mi>k</mi><mo>−</mo><mn>1</mn></mrow></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathbb{P}_{\mathrm{CTMC}}(i_{k-1}|x_{k},\tau_{k-1})</annotation></semantics></math>. Applying claim 3 in <a href="#Thmlemma5" title="Lemma 5. ‣ Proof. ‣ Appendix I FHS Sampling in CTMC Framework: and its Proof ‣ Sharp Convergence Rates for Masked Diffusion Models" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Lemma</span> <span class="ltx_text ltx_ref_tag">5</span></a> together with (<a href="#A9.E30" title="Equation 30 ‣ Proof. ‣ Appendix I FHS Sampling in CTMC Framework: and its Proof ‣ Sharp Convergence Rates for Masked Diffusion Models" class="ltx_ref"><span class="ltx_text ltx_ref_tag">30</span></a>) and (<a href="#A9.E31" title="Equation 31 ‣ Proof. ‣ Appendix I FHS Sampling in CTMC Framework: and its Proof ‣ Sharp Convergence Rates for Masked Diffusion Models" class="ltx_ref"><span class="ltx_text ltx_ref_tag">31</span></a>), we obtain</span></p>
<table id="A9.EGx23" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A9.Ex128"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A9.Ex128.m1" class="ltx_Math" alttext="\displaystyle\mathbb{P}_{\mathrm{CTMC}}(i_{k-1}|x_{k},\tau_{k-1})" display="inline" intent=":literal"><semantics><mrow><msub><mi>ℙ</mi><mi>CTMC</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>i</mi><mrow><mi>k</mi><mo>−</mo><mn>1</mn></mrow></msub><mo lspace="0em" rspace="0em">|</mo><mrow><msub><mi>x</mi><mi>k</mi></msub><mo>,</mo><msub><mi>τ</mi><mrow><mi>k</mi><mo>−</mo><mn>1</mn></mrow></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\mathbb{P}_{\mathrm{CTMC}}(i_{k-1}|x_{k},\tau_{k-1})</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A9.Ex128.m2" class="ltx_Math" alttext="\displaystyle=\sum_{b\neq\mathrm{[MASK]}}\frac{\widetilde{R}_{\tau_{k-1}}(x_{k},x_{k}^{-i_{k-1}}\oplus_{i_{k-1}}b)}{\Lambda(\tau_{k-1},x_{k})}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mi>b</mi><mo>≠</mo><mrow><mo stretchy="false">[</mo><mi>MASK</mi><mo stretchy="false">]</mo></mrow></mrow></munder></mstyle><mstyle displaystyle="true"><mfrac><mrow><mover accent="true"><mi>R</mi><mo>~</mo></mover><msub><mrow></mrow><msub><mi>τ</mi><mrow><mi>k</mi><mo>−</mo><mn>1</mn></mrow></msub></msub><mo stretchy="false">(</mo><mi>x</mi><msub><mrow></mrow><mi>k</mi></msub><mo>,</mo><mi>x</mi><msub><mrow></mrow><mi>k</mi></msub><msup><mrow></mrow><mrow><mo>−</mo><msub><mi>i</mi><mrow><mi>k</mi><mo>−</mo><mn>1</mn></mrow></msub></mrow></msup><mo>⊕</mo><msub><mrow></mrow><msub><mi>i</mi><mrow><mi>k</mi><mo>−</mo><mn>1</mn></mrow></msub></msub><mi>b</mi><mo stretchy="false">)</mo></mrow><mrow><mi mathvariant="normal">Λ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>τ</mi><mrow><mi>k</mi><mo>−</mo><mn>1</mn></mrow></msub><mo>,</mo><msub><mi>x</mi><mi>k</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\sum_{b\neq\mathrm{[MASK]}}\frac{\widetilde{R}_{\tau_{k-1}}(x_{k},x_{k}^{-i_{k-1}}\oplus_{i_{k-1}}b)}{\Lambda(\tau_{k-1},x_{k})}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A9.Ex129"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A9.Ex129.m1" class="ltx_Math" alttext="\displaystyle=\frac{r_{i_{k-1}}(\tau_{k-1},x_{k})}{\Lambda(\tau_{k-1},x_{k})}=\frac{\frac{\alpha_{t}}{1-\alpha_{t}}}{k\cdot\frac{\alpha_{t}}{1-\alpha_{t}}}=\frac{1}{k}." display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>=</mo><mstyle displaystyle="true"><mfrac><mrow><msub><mi>r</mi><msub><mi>i</mi><mrow><mi>k</mi><mo>−</mo><mn>1</mn></mrow></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>τ</mi><mrow><mi>k</mi><mo>−</mo><mn>1</mn></mrow></msub><mo>,</mo><msub><mi>x</mi><mi>k</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mrow><mi mathvariant="normal">Λ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>τ</mi><mrow><mi>k</mi><mo>−</mo><mn>1</mn></mrow></msub><mo>,</mo><msub><mi>x</mi><mi>k</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle><mo>=</mo><mstyle displaystyle="true"><mfrac><mfrac><msub><mi>α</mi><mi>t</mi></msub><mrow><mn>1</mn><mo>−</mo><msub><mi>α</mi><mi>t</mi></msub></mrow></mfrac><mrow><mi>k</mi><mo lspace="0.222em" rspace="0.222em">⋅</mo><mfrac><msub><mi>α</mi><mi>t</mi></msub><mrow><mn>1</mn><mo>−</mo><msub><mi>α</mi><mi>t</mi></msub></mrow></mfrac></mrow></mfrac></mstyle><mo>=</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>k</mi></mfrac></mstyle></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle=\frac{r_{i_{k-1}}(\tau_{k-1},x_{k})}{\Lambda(\tau_{k-1},x_{k})}=\frac{\frac{\alpha_{t}}{1-\alpha_{t}}}{k\cdot\frac{\alpha_{t}}{1-\alpha_{t}}}=\frac{1}{k}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="A9.p16" class="ltx_para ltx_noindent">
<p id="A9.p16.1" class="ltx_p"><span id="A9.p16.1.1" class="ltx_text">Finally, we derive the conditional distribution over the predicted token value <math id="A9.p16.m1" class="ltx_Math" alttext="a" display="inline" intent=":literal"><semantics><mi>a</mi><annotation encoding="application/x-tex">a</annotation></semantics></math>. Combining (<a href="#A9.E30" title="Equation 30 ‣ Proof. ‣ Appendix I FHS Sampling in CTMC Framework: and its Proof ‣ Sharp Convergence Rates for Masked Diffusion Models" class="ltx_ref"><span class="ltx_text ltx_ref_tag">30</span></a>) and Claim 3 in <a href="#Thmlemma5" title="Lemma 5. ‣ Proof. ‣ Appendix I FHS Sampling in CTMC Framework: and its Proof ‣ Sharp Convergence Rates for Masked Diffusion Models" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Lemma</span> <span class="ltx_text ltx_ref_tag">5</span></a>, we derive, for all <math id="A9.p16.m2" class="ltx_Math" alttext="t" display="inline" intent=":literal"><semantics><mi>t</mi><annotation encoding="application/x-tex">t</annotation></semantics></math> and <math id="A9.p16.m3" class="ltx_Math" alttext="i" display="inline" intent=":literal"><semantics><mi>i</mi><annotation encoding="application/x-tex">i</annotation></semantics></math>,</span></p>
<table id="A9.EGx24" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A9.Ex130"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A9.Ex130.m1" class="ltx_Math" alttext="\displaystyle\mathbb{P}_{\mathrm{CTMC}}(a|x_{k},t,i)" display="inline" intent=":literal"><semantics><mrow><msub><mi>ℙ</mi><mi>CTMC</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>a</mi><mo lspace="0em" rspace="0em">|</mo><mrow><msub><mi>x</mi><mi>k</mi></msub><mo>,</mo><mi>t</mi><mo>,</mo><mi>i</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\mathbb{P}_{\mathrm{CTMC}}(a|x_{k},t,i)</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A9.Ex130.m2" class="ltx_Math" alttext="\displaystyle=\frac{\widetilde{R}_{t}\big(x_{k},x_{k}^{-i}\oplus_{i}a\big)/\Lambda(t,x_{k})}{\sum_{b\neq\mathrm{[MASK]}}\widetilde{R}_{t}\big(x_{k},x_{k}^{-i}\oplus_{i}b\big)/\Lambda(t,x_{k})}." display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>=</mo><mstyle displaystyle="true"><mfrac><mrow><mover accent="true"><mi>R</mi><mo>~</mo></mover><msub><mrow></mrow><mi>t</mi></msub><mo maxsize="1.200em" minsize="1.200em">(</mo><mi>x</mi><msub><mrow></mrow><mi>k</mi></msub><mo>,</mo><mi>x</mi><msub><mrow></mrow><mi>k</mi></msub><msup><mrow></mrow><mrow><mo>−</mo><mi>i</mi></mrow></msup><mo>⊕</mo><msub><mrow></mrow><mi>i</mi></msub><mi>a</mi><mo maxsize="1.200em" minsize="1.200em">)</mo><mo>/</mo><mi mathvariant="normal">Λ</mi><mo stretchy="false">(</mo><mi>t</mi><mo>,</mo><mi>x</mi><msub><mrow></mrow><mi>k</mi></msub><mo stretchy="false">)</mo></mrow><mrow><mo>∑</mo><msub><mrow></mrow><mrow><mi>b</mi><mo>≠</mo><mrow><mo stretchy="false">[</mo><mi>MASK</mi><mo stretchy="false">]</mo></mrow></mrow></msub><mover accent="true"><mi>R</mi><mo>~</mo></mover><msub><mrow></mrow><mi>t</mi></msub><mo maxsize="1.200em" minsize="1.200em">(</mo><mi>x</mi><msub><mrow></mrow><mi>k</mi></msub><mo>,</mo><mi>x</mi><msub><mrow></mrow><mi>k</mi></msub><msup><mrow></mrow><mrow><mo>−</mo><mi>i</mi></mrow></msup><mo>⊕</mo><msub><mrow></mrow><mi>i</mi></msub><mi>b</mi><mo maxsize="1.200em" minsize="1.200em">)</mo><mo>/</mo><mi mathvariant="normal">Λ</mi><mo stretchy="false">(</mo><mi>t</mi><mo>,</mo><mi>x</mi><msub><mrow></mrow><mi>k</mi></msub><mo stretchy="false">)</mo></mrow></mfrac></mstyle></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle=\frac{\widetilde{R}_{t}\big(x_{k},x_{k}^{-i}\oplus_{i}a\big)/\Lambda(t,x_{k})}{\sum_{b\neq\mathrm{[MASK]}}\widetilde{R}_{t}\big(x_{k},x_{k}^{-i}\oplus_{i}b\big)/\Lambda(t,x_{k})}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A9.Ex131"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A9.Ex131.m1" class="ltx_Math" alttext="\displaystyle=\frac{\widetilde{R}_{t}\big(x_{k},x_{k}^{-i}\oplus_{i}a\big)}{\sum_{b\neq\mathrm{[MASK]}}\widetilde{R}_{t}\big(x_{k},x_{k}^{-i}\oplus_{i}b\big)}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mstyle displaystyle="true"><mfrac><mrow><mover accent="true"><mi>R</mi><mo>~</mo></mover><msub><mrow></mrow><mi>t</mi></msub><mo maxsize="1.200em" minsize="1.200em">(</mo><mi>x</mi><msub><mrow></mrow><mi>k</mi></msub><mo>,</mo><mi>x</mi><msub><mrow></mrow><mi>k</mi></msub><msup><mrow></mrow><mrow><mo>−</mo><mi>i</mi></mrow></msup><mo>⊕</mo><msub><mrow></mrow><mi>i</mi></msub><mi>a</mi><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow><mrow><mo>∑</mo><msub><mrow></mrow><mrow><mi>b</mi><mo>≠</mo><mrow><mo stretchy="false">[</mo><mi>MASK</mi><mo stretchy="false">]</mo></mrow></mrow></msub><mover accent="true"><mi>R</mi><mo>~</mo></mover><msub><mrow></mrow><mi>t</mi></msub><mo maxsize="1.200em" minsize="1.200em">(</mo><mi>x</mi><msub><mrow></mrow><mi>k</mi></msub><mo>,</mo><mi>x</mi><msub><mrow></mrow><mi>k</mi></msub><msup><mrow></mrow><mrow><mo>−</mo><mi>i</mi></mrow></msup><mo>⊕</mo><msub><mrow></mrow><mi>i</mi></msub><mi>b</mi><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow></mfrac></mstyle></mrow><annotation encoding="application/x-tex">\displaystyle=\frac{\widetilde{R}_{t}\big(x_{k},x_{k}^{-i}\oplus_{i}a\big)}{\sum_{b\neq\mathrm{[MASK]}}\widetilde{R}_{t}\big(x_{k},x_{k}^{-i}\oplus_{i}b\big)}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A9.Ex132"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A9.Ex132.m1" class="ltx_Math" alttext="\displaystyle\overset{(i)}{=}\frac{q_{t}\!\big(x_{k}^{-i}\oplus_{i}a\big)}{\sum_{b\neq\mathrm{[MASK]}}q_{t}(x_{k}^{-i}\oplus_{i}b)}" display="inline" intent=":literal"><semantics><mrow><mover accent="true"><mo>=</mo><mrow><mo maxsize="0.700em" minsize="0.700em">(</mo><mi mathsize="0.700em">i</mi><mo maxsize="0.700em" minsize="0.700em">)</mo></mrow></mover><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><mrow><mi>q</mi><msub><mrow></mrow><mi>t</mi></msub><mo maxsize="1.200em" minsize="1.200em">(</mo><mi>x</mi><msub><mrow></mrow><mi>k</mi></msub><msup><mrow></mrow><mrow><mo>−</mo><mi>i</mi></mrow></msup><mo>⊕</mo><msub><mrow></mrow><mi>i</mi></msub><mi>a</mi><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow><mrow><mo>∑</mo><msub><mrow></mrow><mrow><mi>b</mi><mo>≠</mo><mrow><mo stretchy="false">[</mo><mi>MASK</mi><mo stretchy="false">]</mo></mrow></mrow></msub><mi>q</mi><msub><mrow></mrow><mi>t</mi></msub><mo stretchy="false">(</mo><mi>x</mi><msub><mrow></mrow><mi>k</mi></msub><msup><mrow></mrow><mrow><mo>−</mo><mi>i</mi></mrow></msup><mo>⊕</mo><msub><mrow></mrow><mi>i</mi></msub><mi>b</mi><mo stretchy="false">)</mo></mrow></mfrac></mstyle></mrow><annotation encoding="application/x-tex">\displaystyle\overset{(i)}{=}\frac{q_{t}\!\big(x_{k}^{-i}\oplus_{i}a\big)}{\sum_{b\neq\mathrm{[MASK]}}q_{t}(x_{k}^{-i}\oplus_{i}b)}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A9.Ex133"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A9.Ex133.m1" class="ltx_Math" alttext="\displaystyle=\frac{q_{t}\!\big(x_{k})}{\sum_{b\neq\mathrm{[MASK]}}q_{t}(x_{k}^{-i}\oplus_{i}b)}\cdot\frac{q_{t}\!\big(x_{k}^{-i}\oplus_{i}a\big)}{q_{t}\!\big(x_{k})}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><msub><mi>q</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><msub><mi>x</mi><mi>k</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mrow><mo>∑</mo><msub><mrow></mrow><mrow><mi>b</mi><mo>≠</mo><mrow><mo stretchy="false">[</mo><mi>MASK</mi><mo stretchy="false">]</mo></mrow></mrow></msub><mi>q</mi><msub><mrow></mrow><mi>t</mi></msub><mo stretchy="false">(</mo><mi>x</mi><msub><mrow></mrow><mi>k</mi></msub><msup><mrow></mrow><mrow><mo>−</mo><mi>i</mi></mrow></msup><mo>⊕</mo><msub><mrow></mrow><mi>i</mi></msub><mi>b</mi><mo stretchy="false">)</mo></mrow></mfrac></mstyle><mo lspace="0.222em" rspace="0.222em">⋅</mo><mstyle displaystyle="true"><mfrac><mrow><mi>q</mi><msub><mrow></mrow><mi>t</mi></msub><mo maxsize="1.200em" minsize="1.200em">(</mo><mi>x</mi><msub><mrow></mrow><mi>k</mi></msub><msup><mrow></mrow><mrow><mo>−</mo><mi>i</mi></mrow></msup><mo>⊕</mo><msub><mrow></mrow><mi>i</mi></msub><mi>a</mi><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow><mrow><msub><mi>q</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><msub><mi>x</mi><mi>k</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\frac{q_{t}\!\big(x_{k})}{\sum_{b\neq\mathrm{[MASK]}}q_{t}(x_{k}^{-i}\oplus_{i}b)}\cdot\frac{q_{t}\!\big(x_{k}^{-i}\oplus_{i}a\big)}{q_{t}\!\big(x_{k})}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A9.Ex134"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A9.Ex134.m1" class="ltx_Math" alttext="\displaystyle=\frac{1-\alpha_{t}}{\alpha_{t}}\cdot\frac{q_{t}\!\big(x_{k}^{-i}\oplus_{i}a\big)}{q_{t}\!\big(x_{k})}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mn>1</mn><mo>−</mo><msub><mi>α</mi><mi>t</mi></msub></mrow><msub><mi>α</mi><mi>t</mi></msub></mfrac></mstyle><mo lspace="0.222em" rspace="0.222em">⋅</mo><mstyle displaystyle="true"><mfrac><mrow><mi>q</mi><msub><mrow></mrow><mi>t</mi></msub><mo maxsize="1.200em" minsize="1.200em">(</mo><mi>x</mi><msub><mrow></mrow><mi>k</mi></msub><msup><mrow></mrow><mrow><mo>−</mo><mi>i</mi></mrow></msup><mo>⊕</mo><msub><mrow></mrow><mi>i</mi></msub><mi>a</mi><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow><mrow><msub><mi>q</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><msub><mi>x</mi><mi>k</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\frac{1-\alpha_{t}}{\alpha_{t}}\cdot\frac{q_{t}\!\big(x_{k}^{-i}\oplus_{i}a\big)}{q_{t}\!\big(x_{k})}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A9.Ex135"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A9.Ex135.m1" class="ltx_Math" alttext="\displaystyle\overset{(ii)}{=}q_{0}^{i}(a|x_{k}^{UM})," display="inline" intent=":literal"><semantics><mrow><mrow><mover accent="true"><mo>=</mo><mrow><mo maxsize="0.700em" minsize="0.700em">(</mo><mrow><mi mathsize="0.700em">i</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.700em">i</mi></mrow><mo maxsize="0.700em" minsize="0.700em">)</mo></mrow></mover><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>q</mi><mn>0</mn><mi>i</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>a</mi><mo lspace="0em" rspace="0em">|</mo><msubsup><mi>x</mi><mi>k</mi><mrow><mi>U</mi><mo lspace="0em" rspace="0em">​</mo><mi>M</mi></mrow></msubsup><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\overset{(ii)}{=}q_{0}^{i}(a|x_{k}^{UM}),</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A9.p16.2" class="ltx_p"><span id="A9.p16.2.1" class="ltx_text">where <math id="A9.p16.m4" class="ltx_Math" alttext="(i)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(i)</annotation></semantics></math> follows by substituting (<a href="#A9.E29" title="Equation 29 ‣ Proof. ‣ Appendix I FHS Sampling in CTMC Framework: and its Proof ‣ Sharp Convergence Rates for Masked Diffusion Models" class="ltx_ref"><span class="ltx_text ltx_ref_tag">29</span></a>) and canceling <math id="A9.p16.m5" class="ltx_Math" alttext="q_{t}(x_{k})" display="inline" intent=":literal"><semantics><mrow><msub><mi>q</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mi>k</mi></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">q_{t}(x_{k})</annotation></semantics></math> in the numerator and the denominator, and <math id="A9.p16.m6" class="ltx_Math" alttext="(ii)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>i</mi></mrow><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(ii)</annotation></semantics></math> is by (<a href="#S2.E12" title="Equation 12 ‣ 2.3 D3PM and MDM ‣ 2 Preliminaries of Discrete Diffusion Models ‣ Sharp Convergence Rates for Masked Diffusion Models" class="ltx_ref"><span class="ltx_text ltx_ref_tag">12</span></a>).</span></p>
</div>
<div id="A9.p17" class="ltx_para ltx_noindent">
<p id="A9.p17.1" class="ltx_p"><span id="A9.p17.1.1" class="ltx_text">Therefore,</span></p>
<table id="A9.Ex136" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A9.Ex136.m1" class="ltx_Math" alttext="\mathbb{P}_{\mathrm{CTMC}}(a_{k-1}|x_{k},\tau_{k-1},i_{k-1})=q_{0}^{i_{k-1}}(a_{k-1}|x_{k}^{UM})." display="block" intent=":literal"><semantics><mrow><mrow><mrow><msub><mi>ℙ</mi><mi>CTMC</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>a</mi><mrow><mi>k</mi><mo>−</mo><mn>1</mn></mrow></msub><mo lspace="0em" rspace="0em">|</mo><mrow><msub><mi>x</mi><mi>k</mi></msub><mo>,</mo><msub><mi>τ</mi><mrow><mi>k</mi><mo>−</mo><mn>1</mn></mrow></msub><mo>,</mo><msub><mi>i</mi><mrow><mi>k</mi><mo>−</mo><mn>1</mn></mrow></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><msubsup><mi>q</mi><mn>0</mn><msub><mi>i</mi><mrow><mi>k</mi><mo>−</mo><mn>1</mn></mrow></msub></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>a</mi><mrow><mi>k</mi><mo>−</mo><mn>1</mn></mrow></msub><mo lspace="0em" rspace="0em">|</mo><msubsup><mi>x</mi><mi>k</mi><mrow><mi>U</mi><mo lspace="0em" rspace="0em">​</mo><mi>M</mi></mrow></msubsup><mo stretchy="false">)</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\mathbb{P}_{\mathrm{CTMC}}(a_{k-1}|x_{k},\tau_{k-1},i_{k-1})=q_{0}^{i_{k-1}}(a_{k-1}|x_{k}^{UM}).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="A9.p18" class="ltx_para ltx_noindent">
<p id="A9.p18.1" class="ltx_p"><span id="A9.p18.1.1" class="ltx_text ltx_font_bold">Step 3. Connection between <math id="A9.p18.m1" class="ltx_Math" alttext="\mathbb{P}_{\mathrm{FHS}}" display="inline" intent=":literal"><semantics><msub><mi>ℙ</mi><mi>FHS</mi></msub><annotation encoding="application/x-tex">\mathbb{P}_{\mathrm{FHS}}</annotation></semantics></math> and <math id="A9.p18.m2" class="ltx_Math" alttext="\mathbb{P}_{\mathrm{CTMC}}" display="inline" intent=":literal"><semantics><msub><mi>ℙ</mi><mi>CTMC</mi></msub><annotation encoding="application/x-tex">\mathbb{P}_{\mathrm{CTMC}}</annotation></semantics></math>:<span id="A9.p18.1.1.1" class="ltx_text ltx_font_medium">
We derive the distribution of <math id="A9.p18.m3" class="ltx_Math" alttext="\mathbb{P}_{\mathrm{FHS}}" display="inline" intent=":literal"><semantics><msub><mi>ℙ</mi><mi>FHS</mi></msub><annotation encoding="application/x-tex">\mathbb{P}_{\mathrm{FHS}}</annotation></semantics></math> and show its connection to <math id="A9.p18.m4" class="ltx_Math" alttext="\mathbb{P}_{\mathrm{CTMC}}" display="inline" intent=":literal"><semantics><msub><mi>ℙ</mi><mi>CTMC</mi></msub><annotation encoding="application/x-tex">\mathbb{P}_{\mathrm{CTMC}}</annotation></semantics></math>.</span></span></p>
</div>
<div id="A9.p19" class="ltx_para ltx_noindent">
<p id="A9.p19.1" class="ltx_p"><span id="A9.p19.1.1" class="ltx_text">Recall in the FHS algorithm, the update rule sets <math id="A9.p19.m1" class="ltx_Math" alttext="\tau_{k-1}" display="inline" intent=":literal"><semantics><msub><mi>τ</mi><mrow><mi>k</mi><mo>−</mo><mn>1</mn></mrow></msub><annotation encoding="application/x-tex">\tau_{k-1}</annotation></semantics></math> as</span></p>
<table id="A9.Ex137" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A9.Ex137.m1" class="ltx_math_unparsed" alttext="\alpha_{\tau_{d}}\leftarrow 0,\quad\tau_{k-1}\leftarrow\alpha^{-1}(1-u_{k}^{1/k}(1-\alpha_{\tau_{k}})),\text{for }k=1,2,\cdots,d," display="block" intent=":literal"><semantics><mrow><msub><mi>α</mi><msub><mi>τ</mi><mi>d</mi></msub></msub><mo stretchy="false">←</mo><mn>0</mn><mo rspace="1.167em">,</mo><msub><mi>τ</mi><mrow><mi>k</mi><mo>−</mo><mn>1</mn></mrow></msub><mo stretchy="false">←</mo><msup><mi>α</mi><mrow><mo>−</mo><mn>1</mn></mrow></msup><mrow><mo stretchy="false">(</mo><mn>1</mn><mo>−</mo><msubsup><mi>u</mi><mi>k</mi><mrow><mn>1</mn><mo>/</mo><mi>k</mi></mrow></msubsup><mrow><mo stretchy="false">(</mo><mn>1</mn><mo>−</mo><msub><mi>α</mi><msub><mi>τ</mi><mi>k</mi></msub></msub><mo stretchy="false">)</mo></mrow><mo stretchy="false">)</mo></mrow><mo>,</mo><mtext>for </mtext><mi>k</mi><mo>=</mo><mn>1</mn><mo>,</mo><mn>2</mn><mo>,</mo><mo lspace="0em" rspace="0em">⋯</mo><mo>,</mo><mi>d</mi><mo>,</mo></mrow><annotation encoding="application/x-tex">\alpha_{\tau_{d}}\leftarrow 0,\quad\tau_{k-1}\leftarrow\alpha^{-1}(1-u_{k}^{1/k}(1-\alpha_{\tau_{k}})),\text{for }k=1,2,\cdots,d,</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A9.p19.2" class="ltx_p"><span id="A9.p19.2.1" class="ltx_text">where <math id="A9.p19.m2" class="ltx_Math" alttext="\alpha_{t}=e^{-t}" display="inline" intent=":literal"><semantics><mrow><msub><mi>α</mi><mi>t</mi></msub><mo>=</mo><msup><mi>e</mi><mrow><mo>−</mo><mi>t</mi></mrow></msup></mrow><annotation encoding="application/x-tex">\alpha_{t}=e^{-t}</annotation></semantics></math>, <math id="A9.p19.m3" class="ltx_Math" alttext="\alpha^{-1}(a)=-\log(a)" display="inline" intent=":literal"><semantics><mrow><mrow><msup><mi>α</mi><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>a</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mo rspace="0.167em">−</mo><mrow><mi>log</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>a</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\alpha^{-1}(a)=-\log(a)</annotation></semantics></math>, and <math id="A9.p19.m4" class="ltx_Math" alttext="\{u_{k}\}_{k=1}^{d}\overset{\mathrm{i.i.d}}{\sim}\text{Unif}(0,1)" display="inline" intent=":literal"><semantics><mrow><msubsup><mrow><mo stretchy="false">{</mo><msub><mi>u</mi><mi>k</mi></msub><mo stretchy="false">}</mo></mrow><mrow><mi>k</mi><mo>=</mo><mn>1</mn></mrow><mi>d</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mover accent="true"><mo>∼</mo><mrow><mi mathsize="0.700em">i</mi><mo lspace="0em" mathsize="0.700em" rspace="0.167em">.</mo><mi mathsize="0.700em">i</mi><mo lspace="0em" mathsize="0.700em" rspace="0.167em">.</mo><mi mathsize="0.700em">d</mi></mrow></mover><mo lspace="0em" rspace="0em">​</mo><mtext>Unif</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mn>0</mn><mo>,</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\{u_{k}\}_{k=1}^{d}\overset{\mathrm{i.i.d}}{\sim}\text{Unif}(0,1)</annotation></semantics></math>. The above update rule for <math id="A9.p19.m5" class="ltx_Math" alttext="\tau_{k-1}" display="inline" intent=":literal"><semantics><msub><mi>τ</mi><mrow><mi>k</mi><mo>−</mo><mn>1</mn></mrow></msub><annotation encoding="application/x-tex">\tau_{k-1}</annotation></semantics></math>
can be rewritten as</span></p>
<table id="A9.Ex138" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A9.Ex138.m1" class="ltx_Math" alttext="\left(\frac{1-e^{-\tau_{k-1}}}{1-e^{-\tau_{k}}}\right)^{k}=u_{k}\sim\text{Unif}(0,1)," display="block" intent=":literal"><semantics><mrow><mrow><msup><mrow><mo>(</mo><mfrac><mrow><mn>1</mn><mo>−</mo><msup><mi>e</mi><mrow><mo>−</mo><msub><mi>τ</mi><mrow><mi>k</mi><mo>−</mo><mn>1</mn></mrow></msub></mrow></msup></mrow><mrow><mn>1</mn><mo>−</mo><msup><mi>e</mi><mrow><mo>−</mo><msub><mi>τ</mi><mi>k</mi></msub></mrow></msup></mrow></mfrac><mo>)</mo></mrow><mi>k</mi></msup><mo>=</mo><msub><mi>u</mi><mi>k</mi></msub><mo>∼</mo><mrow><mtext>Unif</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mn>0</mn><mo>,</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\left(\frac{1-e^{-\tau_{k-1}}}{1-e^{-\tau_{k}}}\right)^{k}=u_{k}\sim\text{Unif}(0,1),</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A9.p19.3" class="ltx_p"><span id="A9.p19.3.1" class="ltx_text">which, based on the inverse CDF method (or inverse transform sampling), is equivalent to sample <math id="A9.p19.m6" class="ltx_Math" alttext="\tau_{k-1}" display="inline" intent=":literal"><semantics><msub><mi>τ</mi><mrow><mi>k</mi><mo>−</mo><mn>1</mn></mrow></msub><annotation encoding="application/x-tex">\tau_{k-1}</annotation></semantics></math> from the distribution with the CDF of <math id="A9.p19.m7" class="ltx_Math" alttext="\mathbb{P}_{\mathrm{CTMC}}(\tau_{k-1}&lt;t|x_{k},\tau_{k})=\left(\frac{1-e^{-t}}{1-e^{-\tau_{k}}}\right)^{k}" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>ℙ</mi><mi>CTMC</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>τ</mi><mrow><mi>k</mi><mo>−</mo><mn>1</mn></mrow></msub><mo>&lt;</mo><mi>t</mi></mrow><mo lspace="0em" rspace="0em">|</mo><mrow><msub><mi>x</mi><mi>k</mi></msub><mo>,</mo><msub><mi>τ</mi><mi>k</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><msup><mrow><mo>(</mo><mfrac><mrow><mn>1</mn><mo>−</mo><msup><mi>e</mi><mrow><mo>−</mo><mi>t</mi></mrow></msup></mrow><mrow><mn>1</mn><mo>−</mo><msup><mi>e</mi><mrow><mo>−</mo><msub><mi>τ</mi><mi>k</mi></msub></mrow></msup></mrow></mfrac><mo>)</mo></mrow><mi>k</mi></msup></mrow><annotation encoding="application/x-tex">\mathbb{P}_{\mathrm{CTMC}}(\tau_{k-1}&lt;t|x_{k},\tau_{k})=\left(\frac{1-e^{-t}}{1-e^{-\tau_{k}}}\right)^{k}</annotation></semantics></math>. Therefore,</span></p>
<table id="A9.Ex139" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A9.Ex139.m1" class="ltx_Math" alttext="\mathbb{P}_{\mathrm{FHS}}(\tau_{k-1}|x_{k},\tau_{k})=\mathbb{P}_{\mathrm{CTMC}}(\tau_{k-1}|x_{k},\tau_{k})," display="block" intent=":literal"><semantics><mrow><mrow><mrow><msub><mi>ℙ</mi><mi>FHS</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>τ</mi><mrow><mi>k</mi><mo>−</mo><mn>1</mn></mrow></msub><mo lspace="0em" rspace="0em">|</mo><mrow><msub><mi>x</mi><mi>k</mi></msub><mo>,</mo><msub><mi>τ</mi><mi>k</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><msub><mi>ℙ</mi><mi>CTMC</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>τ</mi><mrow><mi>k</mi><mo>−</mo><mn>1</mn></mrow></msub><mo lspace="0em" rspace="0em">|</mo><mrow><msub><mi>x</mi><mi>k</mi></msub><mo>,</mo><msub><mi>τ</mi><mi>k</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\mathbb{P}_{\mathrm{FHS}}(\tau_{k-1}|x_{k},\tau_{k})=\mathbb{P}_{\mathrm{CTMC}}(\tau_{k-1}|x_{k},\tau_{k}),</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A9.p19.4" class="ltx_p"><span id="A9.p19.4.1" class="ltx_text">and we further note that <math id="A9.p19.m8" class="ltx_Math" alttext="\tau_{k-1}" display="inline" intent=":literal"><semantics><msub><mi>τ</mi><mrow><mi>k</mi><mo>−</mo><mn>1</mn></mrow></msub><annotation encoding="application/x-tex">\tau_{k-1}</annotation></semantics></math> does not depend on <math id="A9.p19.m9" class="ltx_Math" alttext="x_{k}" display="inline" intent=":literal"><semantics><msub><mi>x</mi><mi>k</mi></msub><annotation encoding="application/x-tex">x_{k}</annotation></semantics></math> given <math id="A9.p19.m10" class="ltx_Math" alttext="\tau_{k}" display="inline" intent=":literal"><semantics><msub><mi>τ</mi><mi>k</mi></msub><annotation encoding="application/x-tex">\tau_{k}</annotation></semantics></math> for both FHS and reverse CTMC processes.</span></p>
</div>
<div id="A9.p20" class="ltx_para ltx_noindent">
<p id="A9.p20.1" class="ltx_p"><span id="A9.p20.1.1" class="ltx_text">Next, note that FHS updates <math id="A9.p20.m1" class="ltx_Math" alttext="i_{k-1}" display="inline" intent=":literal"><semantics><msub><mi>i</mi><mrow><mi>k</mi><mo>−</mo><mn>1</mn></mrow></msub><annotation encoding="application/x-tex">i_{k-1}</annotation></semantics></math> by randomly and uniformly selecting an index <math id="A9.p20.m2" class="ltx_Math" alttext="i" display="inline" intent=":literal"><semantics><mi>i</mi><annotation encoding="application/x-tex">i</annotation></semantics></math> from <math id="A9.p20.m3" class="ltx_Math" alttext="\mathcal{M}(x_{k})=\{l:x_{k}^{l}=\mathrm{[MASK]}\}" display="inline" intent=":literal"><semantics><mrow><mrow><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mi>k</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mo stretchy="false">{</mo><mi>l</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><msubsup><mi>x</mi><mi>k</mi><mi>l</mi></msubsup><mo>=</mo><mrow><mo stretchy="false">[</mo><mi>MASK</mi><mo stretchy="false">]</mo></mrow></mrow><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">\mathcal{M}(x_{k})=\{l:x_{k}^{l}=\mathrm{[MASK]}\}</annotation></semantics></math> for each <math id="A9.p20.m4" class="ltx_Math" alttext="k" display="inline" intent=":literal"><semantics><mi>k</mi><annotation encoding="application/x-tex">k</annotation></semantics></math>, and hence</span></p>
<table id="A9.Ex140" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A9.Ex140.m1" class="ltx_Math" alttext="\mathbb{P}_{\mathrm{FHS}}(i_{k-1}|x_{k},\tau_{k-1})=\frac{1}{k}=\mathbb{P}_{\mathrm{CTMC}}(i_{k-1}|x_{k},\tau_{k-1})." display="block" intent=":literal"><semantics><mrow><mrow><mrow><msub><mi>ℙ</mi><mi>FHS</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>i</mi><mrow><mi>k</mi><mo>−</mo><mn>1</mn></mrow></msub><mo lspace="0em" rspace="0em">|</mo><mrow><msub><mi>x</mi><mi>k</mi></msub><mo>,</mo><msub><mi>τ</mi><mrow><mi>k</mi><mo>−</mo><mn>1</mn></mrow></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mfrac><mn>1</mn><mi>k</mi></mfrac><mo>=</mo><mrow><msub><mi>ℙ</mi><mi>CTMC</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>i</mi><mrow><mi>k</mi><mo>−</mo><mn>1</mn></mrow></msub><mo lspace="0em" rspace="0em">|</mo><mrow><msub><mi>x</mi><mi>k</mi></msub><mo>,</mo><msub><mi>τ</mi><mrow><mi>k</mi><mo>−</mo><mn>1</mn></mrow></msub></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\mathbb{P}_{\mathrm{FHS}}(i_{k-1}|x_{k},\tau_{k-1})=\frac{1}{k}=\mathbb{P}_{\mathrm{CTMC}}(i_{k-1}|x_{k},\tau_{k-1}).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="A9.p21" class="ltx_para ltx_noindent">
<p id="A9.p21.1" class="ltx_p"><span id="A9.p21.1.1" class="ltx_text">Finally, given <math id="A9.p21.m1" class="ltx_Math" alttext="x_{k}" display="inline" intent=":literal"><semantics><msub><mi>x</mi><mi>k</mi></msub><annotation encoding="application/x-tex">x_{k}</annotation></semantics></math>, <math id="A9.p21.m2" class="ltx_Math" alttext="\tau_{k-1}" display="inline" intent=":literal"><semantics><msub><mi>τ</mi><mrow><mi>k</mi><mo>−</mo><mn>1</mn></mrow></msub><annotation encoding="application/x-tex">\tau_{k-1}</annotation></semantics></math>, and <math id="A9.p21.m3" class="ltx_Math" alttext="i_{k-1}" display="inline" intent=":literal"><semantics><msub><mi>i</mi><mrow><mi>k</mi><mo>−</mo><mn>1</mn></mrow></msub><annotation encoding="application/x-tex">i_{k-1}</annotation></semantics></math>, FHS samples the predicted token <math id="A9.p21.m4" class="ltx_Math" alttext="a_{k-1}" display="inline" intent=":literal"><semantics><msub><mi>a</mi><mrow><mi>k</mi><mo>−</mo><mn>1</mn></mrow></msub><annotation encoding="application/x-tex">a_{k-1}</annotation></semantics></math> by</span></p>
<table id="A9.Ex141" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A9.Ex141.m1" class="ltx_Math" alttext="\mathbb{P}_{\mathrm{FHS}}(a_{k-1}|x_{k},\tau_{k-1},i_{k-1})=\mu_{\theta}^{i_{k-1}}(x_{k},\tau_{k-1})[a_{k-1}]." display="block" intent=":literal"><semantics><mrow><mrow><mrow><msub><mi>ℙ</mi><mi>FHS</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>a</mi><mrow><mi>k</mi><mo>−</mo><mn>1</mn></mrow></msub><mo lspace="0em" rspace="0em">|</mo><mrow><msub><mi>x</mi><mi>k</mi></msub><mo>,</mo><msub><mi>τ</mi><mrow><mi>k</mi><mo>−</mo><mn>1</mn></mrow></msub><mo>,</mo><msub><mi>i</mi><mrow><mi>k</mi><mo>−</mo><mn>1</mn></mrow></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><msubsup><mi>μ</mi><mi>θ</mi><msub><mi>i</mi><mrow><mi>k</mi><mo>−</mo><mn>1</mn></mrow></msub></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mi>k</mi></msub><mo>,</mo><msub><mi>τ</mi><mrow><mi>k</mi><mo>−</mo><mn>1</mn></mrow></msub><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><msub><mi>a</mi><mrow><mi>k</mi><mo>−</mo><mn>1</mn></mrow></msub><mo stretchy="false">]</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\mathbb{P}_{\mathrm{FHS}}(a_{k-1}|x_{k},\tau_{k-1},i_{k-1})=\mu_{\theta}^{i_{k-1}}(x_{k},\tau_{k-1})[a_{k-1}].</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A9.p21.2" class="ltx_p"><span id="A9.p21.2.1" class="ltx_text">Here, <math id="A9.p21.m5" class="ltx_Math" alttext="\mathbb{P}_{\mathrm{FHS}}(a_{k-1}|x_{k},\tau_{k-1},i_{k-1})=\mu_{\theta}^{i_{k-1}}(x_{k},\tau_{k-1})[a_{k-1}]" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>ℙ</mi><mi>FHS</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>a</mi><mrow><mi>k</mi><mo>−</mo><mn>1</mn></mrow></msub><mo lspace="0em" rspace="0em">|</mo><mrow><msub><mi>x</mi><mi>k</mi></msub><mo>,</mo><msub><mi>τ</mi><mrow><mi>k</mi><mo>−</mo><mn>1</mn></mrow></msub><mo>,</mo><msub><mi>i</mi><mrow><mi>k</mi><mo>−</mo><mn>1</mn></mrow></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><msubsup><mi>μ</mi><mi>θ</mi><msub><mi>i</mi><mrow><mi>k</mi><mo>−</mo><mn>1</mn></mrow></msub></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mi>k</mi></msub><mo>,</mo><msub><mi>τ</mi><mrow><mi>k</mi><mo>−</mo><mn>1</mn></mrow></msub><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><msub><mi>a</mi><mrow><mi>k</mi><mo>−</mo><mn>1</mn></mrow></msub><mo stretchy="false">]</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\mathbb{P}_{\mathrm{FHS}}(a_{k-1}|x_{k},\tau_{k-1},i_{k-1})=\mu_{\theta}^{i_{k-1}}(x_{k},\tau_{k-1})[a_{k-1}]</annotation></semantics></math> is an estimator of the ground-truth distribution token-prediction distribution <math id="A9.p21.m6" class="ltx_Math" alttext="\mathbb{P}_{\mathrm{CTMC}}(a_{k-1}|x_{k},\tau_{k-1},i_{k-1})=q_{0}^{i_{k-1}}(a_{k-1}|x_{k}^{UM})" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>ℙ</mi><mi>CTMC</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>a</mi><mrow><mi>k</mi><mo>−</mo><mn>1</mn></mrow></msub><mo lspace="0em" rspace="0em">|</mo><mrow><msub><mi>x</mi><mi>k</mi></msub><mo>,</mo><msub><mi>τ</mi><mrow><mi>k</mi><mo>−</mo><mn>1</mn></mrow></msub><mo>,</mo><msub><mi>i</mi><mrow><mi>k</mi><mo>−</mo><mn>1</mn></mrow></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><msubsup><mi>q</mi><mn>0</mn><msub><mi>i</mi><mrow><mi>k</mi><mo>−</mo><mn>1</mn></mrow></msub></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>a</mi><mrow><mi>k</mi><mo>−</mo><mn>1</mn></mrow></msub><mo lspace="0em" rspace="0em">|</mo><msubsup><mi>x</mi><mi>k</mi><mrow><mi>U</mi><mo lspace="0em" rspace="0em">​</mo><mi>M</mi></mrow></msubsup><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\mathbb{P}_{\mathrm{CTMC}}(a_{k-1}|x_{k},\tau_{k-1},i_{k-1})=q_{0}^{i_{k-1}}(a_{k-1}|x_{k}^{UM})</annotation></semantics></math>.</span></p>
</div>
<div id="A9.p22" class="ltx_para">
<p id="A9.p22.1" class="ltx_p"><span id="A9.p22.1.1" class="ltx_text">The proof is now complete.
∎</span></p>
</div>
</div>
</section>
<section id="A10" class="ltx_appendix">
<h2 class="ltx_title ltx_title_appendix"><span class="ltx_tag ltx_tag_appendix">Appendix J </span>Proof of <a href="#Thmtheorem4" title="Theorem 4. ‣ 4 Convergence Guarantees for the FHS Algorithm ‣ Sharp Convergence Rates for Masked Diffusion Models" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Theorem</span> <span class="ltx_text ltx_ref_tag">4</span></a></h2>

<div id="A10.p1" class="ltx_para ltx_noindent">
<p id="A10.p1.1" class="ltx_p">As shown by <a href="#Thmproposition3" title="Proposition 3. ‣ Appendix I FHS Sampling in CTMC Framework: and its Proof ‣ Sharp Convergence Rates for Masked Diffusion Models" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Proposition</span> <span class="ltx_text ltx_ref_tag">3</span></a>, the FHS sampling process and the reverse CTMC decoupling structure: they share the same statistical distributions on the unmasking times <math id="A10.p1.m1" class="ltx_Math" alttext="\tau_{k}" display="inline" intent=":literal"><semantics><msub><mi>τ</mi><mi>k</mi></msub><annotation encoding="application/x-tex">\tau_{k}</annotation></semantics></math> and the indices <math id="A10.p1.m2" class="ltx_Math" alttext="i_{k}" display="inline" intent=":literal"><semantics><msub><mi>i</mi><mi>k</mi></msub><annotation encoding="application/x-tex">i_{k}</annotation></semantics></math> of tokens that are unmasked, and differ only in the mechanism used to sample the predicted token value <math id="A10.p1.m3" class="ltx_Math" alttext="a_{k}" display="inline" intent=":literal"><semantics><msub><mi>a</mi><mi>k</mi></msub><annotation encoding="application/x-tex">a_{k}</annotation></semantics></math> for each <math id="A10.p1.m4" class="ltx_Math" alttext="k" display="inline" intent=":literal"><semantics><mi>k</mi><annotation encoding="application/x-tex">k</annotation></semantics></math>. In particular, FHS predicts <math id="A10.p1.m5" class="ltx_Math" alttext="a_{k-1}" display="inline" intent=":literal"><semantics><msub><mi>a</mi><mrow><mi>k</mi><mo>−</mo><mn>1</mn></mrow></msub><annotation encoding="application/x-tex">a_{k-1}</annotation></semantics></math> via <math id="A10.p1.m6" class="ltx_Math" alttext="\mu_{\theta}^{i_{k-1}}" display="inline" intent=":literal"><semantics><msubsup><mi>μ</mi><mi>θ</mi><msub><mi>i</mi><mrow><mi>k</mi><mo>−</mo><mn>1</mn></mrow></msub></msubsup><annotation encoding="application/x-tex">\mu_{\theta}^{i_{k-1}}</annotation></semantics></math> as an approximation of <math id="A10.p1.m7" class="ltx_Math" alttext="q_{0}^{i_{k-1}}(a|x_{k}^{UM})" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>q</mi><mn>0</mn><msub><mi>i</mi><mrow><mi>k</mi><mo>−</mo><mn>1</mn></mrow></msub></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>a</mi><mo lspace="0em" rspace="0em">|</mo><msubsup><mi>x</mi><mi>k</mi><mrow><mi>U</mi><mo lspace="0em" rspace="0em">​</mo><mi>M</mi></mrow></msubsup><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">q_{0}^{i_{k-1}}(a|x_{k}^{UM})</annotation></semantics></math> used in the ground-truth reverse CTMC. Thus, the estimation error in <math id="A10.p1.m8" class="ltx_Math" alttext="\mu_{\theta}" display="inline" intent=":literal"><semantics><msub><mi>μ</mi><mi>θ</mi></msub><annotation encoding="application/x-tex">\mu_{\theta}</annotation></semantics></math> affects only the sampling of the token value <math id="A10.p1.m9" class="ltx_Math" alttext="a_{k}" display="inline" intent=":literal"><semantics><msub><mi>a</mi><mi>k</mi></msub><annotation encoding="application/x-tex">a_{k}</annotation></semantics></math> and does not propagate to <math id="A10.p1.m10" class="ltx_Math" alttext="\tau_{k}" display="inline" intent=":literal"><semantics><msub><mi>τ</mi><mi>k</mi></msub><annotation encoding="application/x-tex">\tau_{k}</annotation></semantics></math> or <math id="A10.p1.m11" class="ltx_Math" alttext="i_{k}" display="inline" intent=":literal"><semantics><msub><mi>i</mi><mi>k</mi></msub><annotation encoding="application/x-tex">i_{k}</annotation></semantics></math>. As a consequence, the subsequent convergence analysis of FHS can be carried out by technically accumulating only the errors arising from sampling the predicted token value <math id="A10.p1.m12" class="ltx_Math" alttext="a_{k-1}" display="inline" intent=":literal"><semantics><msub><mi>a</mi><mrow><mi>k</mi><mo>−</mo><mn>1</mn></mrow></msub><annotation encoding="application/x-tex">a_{k-1}</annotation></semantics></math> for <math id="A10.p1.m13" class="ltx_Math" alttext="k={1,2,\ldots,d}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>k</mi><mo>=</mo><mn>1</mn></mrow><mo>,</mo><mn>2</mn><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mi>d</mi></mrow><annotation encoding="application/x-tex">k={1,2,\ldots,d}</annotation></semantics></math>.</p>
</div>
<div id="A10.p2" class="ltx_para ltx_noindent">
<p id="A10.p2.1" class="ltx_p">In the following, we first derive the KL divergence between the path distributions of the two processes, i.e., <math id="A10.p2.m1" class="ltx_math_unparsed" alttext="\mathrm{KL}(\mathbb{P}_{\mathrm{CTMC}}(\mathrm{path})||\mathbb{P}_{\mathrm{FHS}}(\mathrm{path}))" display="inline" intent=":literal"><semantics><mrow><mi>KL</mi><mrow><mo stretchy="false">(</mo><msub><mi>ℙ</mi><mi>CTMC</mi></msub><mrow><mo stretchy="false">(</mo><mi>path</mi><mo stretchy="false">)</mo></mrow><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><msub><mi>ℙ</mi><mi>FHS</mi></msub><mrow><mo stretchy="false">(</mo><mi>path</mi><mo stretchy="false">)</mo></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathrm{KL}(\mathbb{P}_{\mathrm{CTMC}}(\mathrm{path})||\mathbb{P}_{\mathrm{FHS}}(\mathrm{path}))</annotation></semantics></math>. Then, by applying the data processing inequality, we obtain the error bound on the distance between the ground-truth distribution <math id="A10.p2.m2" class="ltx_Math" alttext="q_{0}(\cdot)" display="inline" intent=":literal"><semantics><mrow><msub><mi>q</mi><mn>0</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">q_{0}(\cdot)</annotation></semantics></math> and the output distribution of FHS, i.e., <math id="A10.p2.m3" class="ltx_math_unparsed" alttext="\mathrm{KL}(q_{0}(\cdot)||\mathbb{P}_{\mathrm{FHS}}(\cdot))" display="inline" intent=":literal"><semantics><mrow><mi>KL</mi><mrow><mo stretchy="false">(</mo><msub><mi>q</mi><mn>0</mn></msub><mrow><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo stretchy="false">)</mo></mrow><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><msub><mi>ℙ</mi><mi>FHS</mi></msub><mrow><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo stretchy="false">)</mo></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathrm{KL}(q_{0}(\cdot)||\mathbb{P}_{\mathrm{FHS}}(\cdot))</annotation></semantics></math>.</p>
</div>
<div id="A10.p3" class="ltx_para ltx_noindent">
<p id="A10.p3.1" class="ltx_p">By the Markov property, the joint path distribution can be factorized as</p>
<table id="A10.E32" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A10.E32.m1" class="ltx_Math" alttext="\mathbb{P}_{\mathrm{CTMC}}(\mathrm{path})\\
=p_{d}(x_{d},\tau_{d})\prod_{k=d}^{1}\mathbb{P}_{\mathrm{CTMC}}(\tau_{k-1}|x_{k},\tau_{k})\mathbb{P}_{\mathrm{CTMC}}(i_{k-1}|x_{k},\tau_{k-1})\mathbb{P}_{\mathrm{CTMC}}(a_{k-1}|x_{k},\tau_{k-1},i_{k-1})," display="block" intent=":literal"><semantics><mtable displaystyle="true" rowspacing="0pt"><mtr><mtd class="ltx_align_left" columnalign="left"><mrow><msub><mi>ℙ</mi><mi>CTMC</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>path</mi><mo stretchy="false">)</mo></mrow></mrow></mtd></mtr><mtr><mtd class="ltx_align_right" columnalign="right"><mrow><mrow><mphantom></mphantom><mo>=</mo><mrow><msub><mi>p</mi><mi>d</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mi>d</mi></msub><mo>,</mo><msub><mi>τ</mi><mi>d</mi></msub><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><munderover><mo movablelimits="false">∏</mo><mrow><mi>k</mi><mo>=</mo><mi>d</mi></mrow><mn>1</mn></munderover><mrow><msub><mi>ℙ</mi><mi>CTMC</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>τ</mi><mrow><mi>k</mi><mo>−</mo><mn>1</mn></mrow></msub><mo lspace="0em" rspace="0em">|</mo><mrow><msub><mi>x</mi><mi>k</mi></msub><mo>,</mo><msub><mi>τ</mi><mi>k</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>ℙ</mi><mi>CTMC</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>i</mi><mrow><mi>k</mi><mo>−</mo><mn>1</mn></mrow></msub><mo lspace="0em" rspace="0em">|</mo><mrow><msub><mi>x</mi><mi>k</mi></msub><mo>,</mo><msub><mi>τ</mi><mrow><mi>k</mi><mo>−</mo><mn>1</mn></mrow></msub></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>ℙ</mi><mi>CTMC</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>a</mi><mrow><mi>k</mi><mo>−</mo><mn>1</mn></mrow></msub><mo lspace="0em" rspace="0em">|</mo><mrow><msub><mi>x</mi><mi>k</mi></msub><mo>,</mo><msub><mi>τ</mi><mrow><mi>k</mi><mo>−</mo><mn>1</mn></mrow></msub><mo>,</mo><msub><mi>i</mi><mrow><mi>k</mi><mo>−</mo><mn>1</mn></mrow></msub></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow></mrow><mo>,</mo></mrow></mtd></mtr></mtable><annotation encoding="application/x-tex">\mathbb{P}_{\mathrm{CTMC}}(\mathrm{path})\\
=p_{d}(x_{d},\tau_{d})\prod_{k=d}^{1}\mathbb{P}_{\mathrm{CTMC}}(\tau_{k-1}|x_{k},\tau_{k})\mathbb{P}_{\mathrm{CTMC}}(i_{k-1}|x_{k},\tau_{k-1})\mathbb{P}_{\mathrm{CTMC}}(a_{k-1}|x_{k},\tau_{k-1},i_{k-1}),</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(32)</span></td></tr></tbody>
</table>
<p id="A10.p3.2" class="ltx_p">and</p>
<table id="A10.E33" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A10.E33.m1" class="ltx_Math" alttext="\mathbb{P}_{\mathrm{FHS}}(\mathrm{path})=p_{d}(x_{d},\tau_{d})\prod_{k=d}^{1}\mathbb{P}_{\mathrm{FHS}}(\tau_{k-1}|x_{k},\tau_{k})\mathbb{P}_{\mathrm{FHS}}(i_{k-1}|x_{k},\tau_{k-1})\mathbb{P}_{\mathrm{FHS}}(a_{k-1}|x_{k},\tau_{k-1},i_{k-1})," display="block" intent=":literal"><semantics><mrow><mrow><mrow><msub><mi>ℙ</mi><mi>FHS</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>path</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><msub><mi>p</mi><mi>d</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mi>d</mi></msub><mo>,</mo><msub><mi>τ</mi><mi>d</mi></msub><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><munderover><mo movablelimits="false">∏</mo><mrow><mi>k</mi><mo>=</mo><mi>d</mi></mrow><mn>1</mn></munderover><mrow><msub><mi>ℙ</mi><mi>FHS</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>τ</mi><mrow><mi>k</mi><mo>−</mo><mn>1</mn></mrow></msub><mo lspace="0em" rspace="0em">|</mo><mrow><msub><mi>x</mi><mi>k</mi></msub><mo>,</mo><msub><mi>τ</mi><mi>k</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>ℙ</mi><mi>FHS</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>i</mi><mrow><mi>k</mi><mo>−</mo><mn>1</mn></mrow></msub><mo lspace="0em" rspace="0em">|</mo><mrow><msub><mi>x</mi><mi>k</mi></msub><mo>,</mo><msub><mi>τ</mi><mrow><mi>k</mi><mo>−</mo><mn>1</mn></mrow></msub></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>ℙ</mi><mi>FHS</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>a</mi><mrow><mi>k</mi><mo>−</mo><mn>1</mn></mrow></msub><mo lspace="0em" rspace="0em">|</mo><mrow><msub><mi>x</mi><mi>k</mi></msub><mo>,</mo><msub><mi>τ</mi><mrow><mi>k</mi><mo>−</mo><mn>1</mn></mrow></msub><mo>,</mo><msub><mi>i</mi><mrow><mi>k</mi><mo>−</mo><mn>1</mn></mrow></msub></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\mathbb{P}_{\mathrm{FHS}}(\mathrm{path})=p_{d}(x_{d},\tau_{d})\prod_{k=d}^{1}\mathbb{P}_{\mathrm{FHS}}(\tau_{k-1}|x_{k},\tau_{k})\mathbb{P}_{\mathrm{FHS}}(i_{k-1}|x_{k},\tau_{k-1})\mathbb{P}_{\mathrm{FHS}}(a_{k-1}|x_{k},\tau_{k-1},i_{k-1}),</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(33)</span></td></tr></tbody>
</table>
<p id="A10.p3.3" class="ltx_p">where</p>
<table id="A10.Ex142" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A10.Ex142.m1" class="ltx_Math" alttext="\mathbb{P}_{\mathrm{CTMC}}(a_{k-1}|x_{k},\tau_{k-1},i_{k-1})=q_{0}^{i_{k-1}}(a_{k-1}|x_{k}^{UM})" display="block" intent=":literal"><semantics><mrow><mrow><msub><mi>ℙ</mi><mi>CTMC</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>a</mi><mrow><mi>k</mi><mo>−</mo><mn>1</mn></mrow></msub><mo lspace="0em" rspace="0em">|</mo><mrow><msub><mi>x</mi><mi>k</mi></msub><mo>,</mo><msub><mi>τ</mi><mrow><mi>k</mi><mo>−</mo><mn>1</mn></mrow></msub><mo>,</mo><msub><mi>i</mi><mrow><mi>k</mi><mo>−</mo><mn>1</mn></mrow></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><msubsup><mi>q</mi><mn>0</mn><msub><mi>i</mi><mrow><mi>k</mi><mo>−</mo><mn>1</mn></mrow></msub></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>a</mi><mrow><mi>k</mi><mo>−</mo><mn>1</mn></mrow></msub><mo lspace="0em" rspace="0em">|</mo><msubsup><mi>x</mi><mi>k</mi><mrow><mi>U</mi><mo lspace="0em" rspace="0em">​</mo><mi>M</mi></mrow></msubsup><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\mathbb{P}_{\mathrm{CTMC}}(a_{k-1}|x_{k},\tau_{k-1},i_{k-1})=q_{0}^{i_{k-1}}(a_{k-1}|x_{k}^{UM})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A10.p3.4" class="ltx_p">and</p>
<table id="A10.Ex143" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A10.Ex143.m1" class="ltx_Math" alttext="\mathbb{P}_{\mathrm{FHS}}(a_{k-1}|x_{k},\tau_{k-1},i_{k-1})=\mu_{\theta}^{i_{k-1}}(x_{k},\tau_{k-1})[a_{k-1}]" display="block" intent=":literal"><semantics><mrow><mrow><msub><mi>ℙ</mi><mi>FHS</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>a</mi><mrow><mi>k</mi><mo>−</mo><mn>1</mn></mrow></msub><mo lspace="0em" rspace="0em">|</mo><mrow><msub><mi>x</mi><mi>k</mi></msub><mo>,</mo><msub><mi>τ</mi><mrow><mi>k</mi><mo>−</mo><mn>1</mn></mrow></msub><mo>,</mo><msub><mi>i</mi><mrow><mi>k</mi><mo>−</mo><mn>1</mn></mrow></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><msubsup><mi>μ</mi><mi>θ</mi><msub><mi>i</mi><mrow><mi>k</mi><mo>−</mo><mn>1</mn></mrow></msub></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mi>k</mi></msub><mo>,</mo><msub><mi>τ</mi><mrow><mi>k</mi><mo>−</mo><mn>1</mn></mrow></msub><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><msub><mi>a</mi><mrow><mi>k</mi><mo>−</mo><mn>1</mn></mrow></msub><mo stretchy="false">]</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\mathbb{P}_{\mathrm{FHS}}(a_{k-1}|x_{k},\tau_{k-1},i_{k-1})=\mu_{\theta}^{i_{k-1}}(x_{k},\tau_{k-1})[a_{k-1}]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A10.p3.5" class="ltx_p">as shown in <a href="#Thmproposition3" title="Proposition 3. ‣ Appendix I FHS Sampling in CTMC Framework: and its Proof ‣ Sharp Convergence Rates for Masked Diffusion Models" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Proposition</span> <span class="ltx_text ltx_ref_tag">3</span></a>, and <math id="A10.p3.m1" class="ltx_Math" alttext="p_{d}(x_{d},\tau_{d})=1" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>p</mi><mi>d</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mi>d</mi></msub><mo>,</mo><msub><mi>τ</mi><mi>d</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">p_{d}(x_{d},\tau_{d})=1</annotation></semantics></math> is the common initialization distribution with <math id="A10.p3.m2" class="ltx_Math" alttext="x_{d}" display="inline" intent=":literal"><semantics><msub><mi>x</mi><mi>d</mi></msub><annotation encoding="application/x-tex">x_{d}</annotation></semantics></math> being all masked and <math id="A10.p3.m3" class="ltx_Math" alttext="\tau_{d}" display="inline" intent=":literal"><semantics><msub><mi>τ</mi><mi>d</mi></msub><annotation encoding="application/x-tex">\tau_{d}</annotation></semantics></math> satisfying <math id="A10.p3.m4" class="ltx_Math" alttext="\alpha_{\tau_{d}}=0" display="inline" intent=":literal"><semantics><mrow><msub><mi>α</mi><msub><mi>τ</mi><mi>d</mi></msub></msub><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\alpha_{\tau_{d}}=0</annotation></semantics></math>.</p>
</div>
<div id="A10.p4" class="ltx_para ltx_noindent">
<p id="A10.p4.1" class="ltx_p">Dividing (<a href="#A10.E32" title="Equation 32 ‣ Appendix J Proof of ‣ Sharp Convergence Rates for Masked Diffusion Models" class="ltx_ref"><span class="ltx_text ltx_ref_tag">32</span></a>) by (<a href="#A10.E33" title="Equation 33 ‣ Appendix J Proof of ‣ Sharp Convergence Rates for Masked Diffusion Models" class="ltx_ref"><span class="ltx_text ltx_ref_tag">33</span></a>) and applying the properties in <a href="#Thmproposition3" title="Proposition 3. ‣ Appendix I FHS Sampling in CTMC Framework: and its Proof ‣ Sharp Convergence Rates for Masked Diffusion Models" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Proposition</span> <span class="ltx_text ltx_ref_tag">3</span></a>, we have</p>
<table id="A10.Ex144" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A10.Ex144.m1" class="ltx_Math" alttext="\frac{\mathbb{P}_{\mathrm{CTMC}}(\mathrm{path})}{\mathbb{P}_{\mathrm{FHS}}(\mathrm{path})}=\prod_{k=1}^{d}\frac{\mathbb{P}_{\mathrm{CTMC}}(a_{k-1}|x_{k},\tau_{k-1},i_{k-1})}{\mathbb{P}_{\mathrm{FHS}}(a_{k-1}|x_{k},\tau_{k-1},i_{k-1})}." display="block" intent=":literal"><semantics><mrow><mrow><mfrac><mrow><msub><mi>ℙ</mi><mi>CTMC</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>path</mi><mo stretchy="false">)</mo></mrow></mrow><mrow><msub><mi>ℙ</mi><mi>FHS</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>path</mi><mo stretchy="false">)</mo></mrow></mrow></mfrac><mo rspace="0.111em">=</mo><mrow><munderover><mo movablelimits="false">∏</mo><mrow><mi>k</mi><mo>=</mo><mn>1</mn></mrow><mi>d</mi></munderover><mfrac><mrow><msub><mi>ℙ</mi><mi>CTMC</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>a</mi><mrow><mi>k</mi><mo>−</mo><mn>1</mn></mrow></msub><mo lspace="0em" rspace="0em">|</mo><mrow><msub><mi>x</mi><mi>k</mi></msub><mo>,</mo><msub><mi>τ</mi><mrow><mi>k</mi><mo>−</mo><mn>1</mn></mrow></msub><mo>,</mo><msub><mi>i</mi><mrow><mi>k</mi><mo>−</mo><mn>1</mn></mrow></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><mrow><msub><mi>ℙ</mi><mi>FHS</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>a</mi><mrow><mi>k</mi><mo>−</mo><mn>1</mn></mrow></msub><mo lspace="0em" rspace="0em">|</mo><mrow><msub><mi>x</mi><mi>k</mi></msub><mo>,</mo><msub><mi>τ</mi><mrow><mi>k</mi><mo>−</mo><mn>1</mn></mrow></msub><mo>,</mo><msub><mi>i</mi><mrow><mi>k</mi><mo>−</mo><mn>1</mn></mrow></msub></mrow><mo stretchy="false">)</mo></mrow></mrow></mfrac></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\frac{\mathbb{P}_{\mathrm{CTMC}}(\mathrm{path})}{\mathbb{P}_{\mathrm{FHS}}(\mathrm{path})}=\prod_{k=1}^{d}\frac{\mathbb{P}_{\mathrm{CTMC}}(a_{k-1}|x_{k},\tau_{k-1},i_{k-1})}{\mathbb{P}_{\mathrm{FHS}}(a_{k-1}|x_{k},\tau_{k-1},i_{k-1})}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="A10.p5" class="ltx_para ltx_noindent">
<p id="A10.p5.2" class="ltx_p">Then, we derive the KL divergence between the path distributions as follows:</p>
<table id="A10.E34" class="ltx_equationgroup ltx_eqn_table">
<tbody>
<tr id="A10.E34X" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A10.E34X.m2" class="ltx_Math" alttext="\displaystyle\mathrm{KL}(\mathbb{P}_{\mathrm{CTMC}}(\mathrm{path})||\mathbb{P}_{\mathrm{FHS}}(\mathrm{path}))" display="inline" intent=":literal"><semantics><mrow><mi>KL</mi><mo stretchy="false">(</mo><mi>ℙ</mi><msub><mrow></mrow><mi>CTMC</mi></msub><mo stretchy="false">(</mo><mi>path</mi><mo stretchy="false">)</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>ℙ</mi><msub><mrow></mrow><mi>FHS</mi></msub><mo stretchy="false">(</mo><mi>path</mi><mo stretchy="false">)</mo><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">\displaystyle\mathrm{KL}(\mathbb{P}_{\mathrm{CTMC}}(\mathrm{path})||\mathbb{P}_{\mathrm{FHS}}(\mathrm{path}))</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="6" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equationgroup ltx_align_right">(34)</span></td></tr>
<tr id="A10.E34Xa" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A10.E34Xa.m2" class="ltx_Math" alttext="\displaystyle=\mathbb{E}_{\mathrm{path}\sim\mathbb{P}_{\mathrm{CTMC}}}\left[\log\frac{\mathbb{P}_{\mathrm{CTMC}}(\mathrm{path})}{\mathbb{P}_{\mathrm{FHS}}(\mathrm{path})}\right]" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><msub><mi>𝔼</mi><mrow><mi>path</mi><mo>∼</mo><msub><mi>ℙ</mi><mi>CTMC</mi></msub></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mstyle displaystyle="true"><mfrac><mrow><msub><mi>ℙ</mi><mi>CTMC</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>path</mi><mo stretchy="false">)</mo></mrow></mrow><mrow><msub><mi>ℙ</mi><mi>FHS</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>path</mi><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle></mrow><mo>]</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\mathbb{E}_{\mathrm{path}\sim\mathbb{P}_{\mathrm{CTMC}}}\left[\log\frac{\mathbb{P}_{\mathrm{CTMC}}(\mathrm{path})}{\mathbb{P}_{\mathrm{FHS}}(\mathrm{path})}\right]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr>
<tr id="A10.E34Xb" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A10.E34Xb.m2" class="ltx_Math" alttext="\displaystyle=\mathbb{E}_{\mathrm{path}\sim\mathbb{P}_{\mathrm{CTMC}}}\left[\sum_{k=1}^{d}\log\left(\frac{\mathbb{P}_{\mathrm{CTMC}}(a_{k-1}|x_{k},\tau_{k-1},i_{k-1})}{\mathbb{P}_{\mathrm{FHS}}(a_{k-1}|x_{k},\tau_{k-1},i_{k-1})}\right)\right]" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><msub><mi>𝔼</mi><mrow><mi>path</mi><mo>∼</mo><msub><mi>ℙ</mi><mi>CTMC</mi></msub></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>k</mi><mo>=</mo><mn>1</mn></mrow><mi>d</mi></munderover></mstyle><mrow><mi>log</mi><mo>⁡</mo><mrow><mo>(</mo><mstyle displaystyle="true"><mfrac><mrow><msub><mi>ℙ</mi><mi>CTMC</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>a</mi><mrow><mi>k</mi><mo>−</mo><mn>1</mn></mrow></msub><mo lspace="0em" rspace="0em">|</mo><mrow><msub><mi>x</mi><mi>k</mi></msub><mo>,</mo><msub><mi>τ</mi><mrow><mi>k</mi><mo>−</mo><mn>1</mn></mrow></msub><mo>,</mo><msub><mi>i</mi><mrow><mi>k</mi><mo>−</mo><mn>1</mn></mrow></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><mrow><msub><mi>ℙ</mi><mi>FHS</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>a</mi><mrow><mi>k</mi><mo>−</mo><mn>1</mn></mrow></msub><mo lspace="0em" rspace="0em">|</mo><mrow><msub><mi>x</mi><mi>k</mi></msub><mo>,</mo><msub><mi>τ</mi><mrow><mi>k</mi><mo>−</mo><mn>1</mn></mrow></msub><mo>,</mo><msub><mi>i</mi><mrow><mi>k</mi><mo>−</mo><mn>1</mn></mrow></msub></mrow><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle><mo>)</mo></mrow></mrow></mrow><mo>]</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\mathbb{E}_{\mathrm{path}\sim\mathbb{P}_{\mathrm{CTMC}}}\left[\sum_{k=1}^{d}\log\left(\frac{\mathbb{P}_{\mathrm{CTMC}}(a_{k-1}|x_{k},\tau_{k-1},i_{k-1})}{\mathbb{P}_{\mathrm{FHS}}(a_{k-1}|x_{k},\tau_{k-1},i_{k-1})}\right)\right]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr>
<tr id="A10.E34Xc" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A10.E34Xc.m2" class="ltx_Math" alttext="\displaystyle=\sum_{k=1}^{d}\mathbb{E}_{\mathrm{path}\sim\mathbb{P}_{\mathrm{CTMC}}}\left[\log\left(\frac{\mathbb{P}_{\mathrm{CTMC}}(a_{k-1}|x_{k},\tau_{k-1},i_{k-1})}{\mathbb{P}_{\mathrm{FHS}}(a_{k-1}|x_{k},\tau_{k-1},i_{k-1})}\right)\right]" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>k</mi><mo>=</mo><mn>1</mn></mrow><mi>d</mi></munderover></mstyle><mrow><msub><mi>𝔼</mi><mrow><mi>path</mi><mo>∼</mo><msub><mi>ℙ</mi><mi>CTMC</mi></msub></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><mrow><mi>log</mi><mo>⁡</mo><mrow><mo>(</mo><mstyle displaystyle="true"><mfrac><mrow><msub><mi>ℙ</mi><mi>CTMC</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>a</mi><mrow><mi>k</mi><mo>−</mo><mn>1</mn></mrow></msub><mo lspace="0em" rspace="0em">|</mo><mrow><msub><mi>x</mi><mi>k</mi></msub><mo>,</mo><msub><mi>τ</mi><mrow><mi>k</mi><mo>−</mo><mn>1</mn></mrow></msub><mo>,</mo><msub><mi>i</mi><mrow><mi>k</mi><mo>−</mo><mn>1</mn></mrow></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><mrow><msub><mi>ℙ</mi><mi>FHS</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>a</mi><mrow><mi>k</mi><mo>−</mo><mn>1</mn></mrow></msub><mo lspace="0em" rspace="0em">|</mo><mrow><msub><mi>x</mi><mi>k</mi></msub><mo>,</mo><msub><mi>τ</mi><mrow><mi>k</mi><mo>−</mo><mn>1</mn></mrow></msub><mo>,</mo><msub><mi>i</mi><mrow><mi>k</mi><mo>−</mo><mn>1</mn></mrow></msub></mrow><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle><mo>)</mo></mrow></mrow><mo>]</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\sum_{k=1}^{d}\mathbb{E}_{\mathrm{path}\sim\mathbb{P}_{\mathrm{CTMC}}}\left[\log\left(\frac{\mathbb{P}_{\mathrm{CTMC}}(a_{k-1}|x_{k},\tau_{k-1},i_{k-1})}{\mathbb{P}_{\mathrm{FHS}}(a_{k-1}|x_{k},\tau_{k-1},i_{k-1})}\right)\right]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr>
<tr id="A10.E34Xd" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A10.E34Xd.m2" class="ltx_Math" alttext="\displaystyle=\sum_{k=1}^{d}\mathbb{E}_{\begin{subarray}{c}(x_{k},\tau_{k-1},i_{k-1})\sim\mathbb{P}_{\mathrm{CTMC}}\\
(a_{k-1}|x_{k},\tau_{k-1},i_{k-1})\sim\mathbb{P}_{\mathrm{CTMC}}(a_{k-1}|x_{k},\tau_{k-1},i_{k-1})\end{subarray}}\bigg[\log\left(\frac{\mathbb{P}_{\mathrm{CTMC}}(a_{k-1}|x_{k},\tau_{k-1},i_{k-1})}{\mathbb{P}_{\mathrm{FHS}}(a_{k-1}|x_{k},\tau_{k-1},i_{k-1})}\right)\bigg]" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>k</mi><mo>=</mo><mn>1</mn></mrow><mi>d</mi></munderover></mstyle><mrow><msub><mi>𝔼</mi><mtable rowspacing="0pt"><mtr><mtd><mrow><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mi>k</mi></msub><mo mathsize="0.710em">,</mo><msub><mi>τ</mi><mrow><mi>k</mi><mo>−</mo><mn>1</mn></mrow></msub><mo mathsize="0.710em">,</mo><msub><mi>i</mi><mrow><mi>k</mi><mo>−</mo><mn>1</mn></mrow></msub><mo stretchy="false">)</mo></mrow><mo>∼</mo><msub><mi>ℙ</mi><mi>CTMC</mi></msub></mrow></mtd></mtr><mtr><mtd><mrow><mrow><mo stretchy="false">(</mo><msub><mi>a</mi><mrow><mi>k</mi><mo>−</mo><mn>1</mn></mrow></msub><mo lspace="0em" rspace="0em">|</mo><mrow><msub><mi>x</mi><mi>k</mi></msub><mo>,</mo><msub><mi>τ</mi><mrow><mi>k</mi><mo>−</mo><mn>1</mn></mrow></msub><mo>,</mo><msub><mi>i</mi><mrow><mi>k</mi><mo>−</mo><mn>1</mn></mrow></msub></mrow><mo stretchy="false">)</mo></mrow><mo>∼</mo><mrow><msub><mi>ℙ</mi><mi>CTMC</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>a</mi><mrow><mi>k</mi><mo>−</mo><mn>1</mn></mrow></msub><mo lspace="0em" rspace="0em">|</mo><mrow><msub><mi>x</mi><mi>k</mi></msub><mo>,</mo><msub><mi>τ</mi><mrow><mi>k</mi><mo>−</mo><mn>1</mn></mrow></msub><mo>,</mo><msub><mi>i</mi><mrow><mi>k</mi><mo>−</mo><mn>1</mn></mrow></msub></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mtd></mtr></mtable></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="2.100em" minsize="2.100em">[</mo><mrow><mi>log</mi><mo>⁡</mo><mrow><mo>(</mo><mstyle displaystyle="true"><mfrac><mrow><msub><mi>ℙ</mi><mi>CTMC</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>a</mi><mrow><mi>k</mi><mo>−</mo><mn>1</mn></mrow></msub><mo lspace="0em" rspace="0em">|</mo><mrow><msub><mi>x</mi><mi>k</mi></msub><mo>,</mo><msub><mi>τ</mi><mrow><mi>k</mi><mo>−</mo><mn>1</mn></mrow></msub><mo>,</mo><msub><mi>i</mi><mrow><mi>k</mi><mo>−</mo><mn>1</mn></mrow></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><mrow><msub><mi>ℙ</mi><mi>FHS</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>a</mi><mrow><mi>k</mi><mo>−</mo><mn>1</mn></mrow></msub><mo lspace="0em" rspace="0em">|</mo><mrow><msub><mi>x</mi><mi>k</mi></msub><mo>,</mo><msub><mi>τ</mi><mrow><mi>k</mi><mo>−</mo><mn>1</mn></mrow></msub><mo>,</mo><msub><mi>i</mi><mrow><mi>k</mi><mo>−</mo><mn>1</mn></mrow></msub></mrow><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle><mo>)</mo></mrow></mrow><mo maxsize="2.100em" minsize="2.100em">]</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\sum_{k=1}^{d}\mathbb{E}_{\begin{subarray}{c}(x_{k},\tau_{k-1},i_{k-1})\sim\mathbb{P}_{\mathrm{CTMC}}\\
(a_{k-1}|x_{k},\tau_{k-1},i_{k-1})\sim\mathbb{P}_{\mathrm{CTMC}}(a_{k-1}|x_{k},\tau_{k-1},i_{k-1})\end{subarray}}\bigg[\log\left(\frac{\mathbb{P}_{\mathrm{CTMC}}(a_{k-1}|x_{k},\tau_{k-1},i_{k-1})}{\mathbb{P}_{\mathrm{FHS}}(a_{k-1}|x_{k},\tau_{k-1},i_{k-1})}\right)\bigg]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr>
<tr id="A10.E34Xe" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A10.E34Xe.m2" class="ltx_Math" alttext="\displaystyle=\sum_{k=1}^{d}\mathbb{E}_{(x_{k},\tau_{k-1},i_{k-1})\sim\mathbb{P}_{\mathrm{CTMC}}}\left[\mathrm{KL}(\mathbb{P}_{\mathrm{CTMC}}(\cdot|x_{k},\tau_{k-1},i_{k-1})||\mathbb{P}_{\mathrm{FHS}}(\cdot|x_{k},\tau_{k-1},i_{k-1}))\right]." display="inline" intent=":literal"><semantics><mrow><mo>=</mo><mstyle displaystyle="true"><mo movablelimits="false">∑</mo></mstyle><msub><mrow></mrow><mrow><mi>k</mi><mo>=</mo><mn>1</mn></mrow></msub><msup><mrow></mrow><mi>d</mi></msup><mi>𝔼</mi><msub><mrow></mrow><mrow><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mi>k</mi></msub><mo>,</mo><msub><mi>τ</mi><mrow><mi>k</mi><mo>−</mo><mn>1</mn></mrow></msub><mo>,</mo><msub><mi>i</mi><mrow><mi>k</mi><mo>−</mo><mn>1</mn></mrow></msub><mo stretchy="false">)</mo></mrow><mo>∼</mo><msub><mi>ℙ</mi><mi>CTMC</mi></msub></mrow></msub><mo>[</mo><mi>KL</mi><mo stretchy="false">(</mo><mi>ℙ</mi><msub><mrow></mrow><mi>CTMC</mi></msub><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>x</mi><msub><mrow></mrow><mi>k</mi></msub><mo>,</mo><mi>τ</mi><msub><mrow></mrow><mrow><mi>k</mi><mo>−</mo><mn>1</mn></mrow></msub><mo>,</mo><mi>i</mi><msub><mrow></mrow><mrow><mi>k</mi><mo>−</mo><mn>1</mn></mrow></msub><mo stretchy="false">)</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>ℙ</mi><msub><mrow></mrow><mi>FHS</mi></msub><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>x</mi><msub><mrow></mrow><mi>k</mi></msub><mo>,</mo><mi>τ</mi><msub><mrow></mrow><mrow><mi>k</mi><mo>−</mo><mn>1</mn></mrow></msub><mo>,</mo><mi>i</mi><msub><mrow></mrow><mrow><mi>k</mi><mo>−</mo><mn>1</mn></mrow></msub><mo stretchy="false">)</mo><mo stretchy="false">)</mo><mo>]</mo><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle=\sum_{k=1}^{d}\mathbb{E}_{(x_{k},\tau_{k-1},i_{k-1})\sim\mathbb{P}_{\mathrm{CTMC}}}\left[\mathrm{KL}(\mathbb{P}_{\mathrm{CTMC}}(\cdot|x_{k},\tau_{k-1},i_{k-1})||\mathbb{P}_{\mathrm{FHS}}(\cdot|x_{k},\tau_{k-1},i_{k-1}))\right].</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="A10.p6" class="ltx_para ltx_noindent">
<p id="A10.p6.1" class="ltx_p">Thus, the KL divergence between two path distributions <math id="A10.p6.m1" class="ltx_Math" alttext="\mathbb{P}_{\mathrm{CTMC}}" display="inline" intent=":literal"><semantics><msub><mi>ℙ</mi><mi>CTMC</mi></msub><annotation encoding="application/x-tex">\mathbb{P}_{\mathrm{CTMC}}</annotation></semantics></math> and <math id="A10.p6.m2" class="ltx_Math" alttext="\mathbb{P}_{\mathrm{FHS}}" display="inline" intent=":literal"><semantics><msub><mi>ℙ</mi><mi>FHS</mi></msub><annotation encoding="application/x-tex">\mathbb{P}_{\mathrm{FHS}}</annotation></semantics></math> has been decomposed into summation of the expected KL divergence of two token-prediction distributions, which is the error arising from predicting <math id="A10.p6.m3" class="ltx_Math" alttext="x_{k-1}^{i_{k-1}}" display="inline" intent=":literal"><semantics><msubsup><mi>x</mi><mrow><mi>k</mi><mo>−</mo><mn>1</mn></mrow><msub><mi>i</mi><mrow><mi>k</mi><mo>−</mo><mn>1</mn></mrow></msub></msubsup><annotation encoding="application/x-tex">x_{k-1}^{i_{k-1}}</annotation></semantics></math> via <math id="A10.p6.m4" class="ltx_Math" alttext="\mu_{\theta}" display="inline" intent=":literal"><semantics><msub><mi>μ</mi><mi>θ</mi></msub><annotation encoding="application/x-tex">\mu_{\theta}</annotation></semantics></math> in FHS. We next analyze</p>
<table id="A10.Ex145" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A10.Ex145.m1" class="ltx_math_unparsed" alttext="\mathbb{E}_{(x_{k},\tau_{k-1},i_{k-1})\sim\mathbb{P}_{\mathrm{CTMC}}}\left[\mathrm{KL}(\mathbb{P}_{\mathrm{CTMC}}(\cdot|x_{k},\tau_{k-1},i_{k-1})||\mathbb{P}_{\mathrm{FHS}}(\cdot|x_{k},\tau_{k-1},i_{k-1}))\right]" display="block" intent=":literal"><semantics><mrow><msub><mi>𝔼</mi><mrow><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mi>k</mi></msub><mo>,</mo><msub><mi>τ</mi><mrow><mi>k</mi><mo>−</mo><mn>1</mn></mrow></msub><mo>,</mo><msub><mi>i</mi><mrow><mi>k</mi><mo>−</mo><mn>1</mn></mrow></msub><mo stretchy="false">)</mo></mrow><mo>∼</mo><msub><mi>ℙ</mi><mi>CTMC</mi></msub></mrow></msub><mrow><mo>[</mo><mi>KL</mi><mrow><mo stretchy="false">(</mo><msub><mi>ℙ</mi><mi>CTMC</mi></msub><mrow><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><msub><mi>x</mi><mi>k</mi></msub><mo>,</mo><msub><mi>τ</mi><mrow><mi>k</mi><mo>−</mo><mn>1</mn></mrow></msub><mo>,</mo><msub><mi>i</mi><mrow><mi>k</mi><mo>−</mo><mn>1</mn></mrow></msub><mo stretchy="false">)</mo></mrow><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><msub><mi>ℙ</mi><mi>FHS</mi></msub><mrow><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><msub><mi>x</mi><mi>k</mi></msub><mo>,</mo><msub><mi>τ</mi><mrow><mi>k</mi><mo>−</mo><mn>1</mn></mrow></msub><mo>,</mo><msub><mi>i</mi><mrow><mi>k</mi><mo>−</mo><mn>1</mn></mrow></msub><mo stretchy="false">)</mo></mrow><mo stretchy="false">)</mo></mrow><mo>]</mo></mrow></mrow><annotation encoding="application/x-tex">\mathbb{E}_{(x_{k},\tau_{k-1},i_{k-1})\sim\mathbb{P}_{\mathrm{CTMC}}}\left[\mathrm{KL}(\mathbb{P}_{\mathrm{CTMC}}(\cdot|x_{k},\tau_{k-1},i_{k-1})||\mathbb{P}_{\mathrm{FHS}}(\cdot|x_{k},\tau_{k-1},i_{k-1}))\right]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A10.p6.2" class="ltx_p">for each <math id="A10.p6.m5" class="ltx_Math" alttext="k" display="inline" intent=":literal"><semantics><mi>k</mi><annotation encoding="application/x-tex">k</annotation></semantics></math>.</p>
</div>
<div id="A10.p7" class="ltx_para ltx_noindent">
<p id="A10.p7.1" class="ltx_p">The following lemma shows that <math id="A10.p7.m1" class="ltx_Math" alttext="\alpha_{\tau_{k-1}}" display="inline" intent=":literal"><semantics><msub><mi>α</mi><msub><mi>τ</mi><mrow><mi>k</mi><mo>−</mo><mn>1</mn></mrow></msub></msub><annotation encoding="application/x-tex">\alpha_{\tau_{k-1}}</annotation></semantics></math> follows the Beta distribution.</p>
</div>
<div id="Thmlemma6" class="ltx_theorem ltx_theorem_lemma">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="Thmlemma6.2" class="ltx_text ltx_font_bold">Lemma 6</span></span><span id="Thmlemma6.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="Thmlemma6.p1" class="ltx_para ltx_noindent">
<p id="Thmlemma6.p1.1" class="ltx_p"><span id="Thmlemma6.p1.1.1" class="ltx_text ltx_font_italic">The random variable <math id="Thmlemma6.p1.m1" class="ltx_Math" alttext="\alpha_{\tau_{k-1}}" display="inline" intent=":literal"><semantics><msub><mi>α</mi><msub><mi>τ</mi><mrow><mi>k</mi><mo>−</mo><mn>1</mn></mrow></msub></msub><annotation encoding="application/x-tex">\alpha_{\tau_{k-1}}</annotation></semantics></math> sampled by FHS algorithm follows a Beta distribution, i.e., for each <math id="Thmlemma6.p1.m2" class="ltx_Math" alttext="k=1,2,\cdots,d" display="inline" intent=":literal"><semantics><mrow><mrow><mi>k</mi><mo>=</mo><mn>1</mn></mrow><mo>,</mo><mn>2</mn><mo>,</mo><mo lspace="0em" rspace="0em">⋯</mo><mo>,</mo><mi>d</mi></mrow><annotation encoding="application/x-tex">k=1,2,\cdots,d</annotation></semantics></math>,</span></p>
<table id="A10.Ex146" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A10.Ex146.m1" class="ltx_Math" alttext="\alpha_{\tau_{k-1}}\sim Beta(d-k+1,k)." display="block" intent=":literal"><semantics><mrow><mrow><msub><mi>α</mi><msub><mi>τ</mi><mrow><mi>k</mi><mo>−</mo><mn>1</mn></mrow></msub></msub><mo>∼</mo><mrow><mi>B</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mi>d</mi><mo>−</mo><mi>k</mi></mrow><mo>+</mo><mn>1</mn></mrow><mo>,</mo><mi>k</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\alpha_{\tau_{k-1}}\sim Beta(d-k+1,k).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
</div>
<div id="A10.p8" class="ltx_para ltx_noindent">
<p id="A10.p8.1" class="ltx_p">The proof of <a href="#Thmlemma6" title="Lemma 6. ‣ Appendix J Proof of ‣ Sharp Convergence Rates for Masked Diffusion Models" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Lemma</span> <span class="ltx_text ltx_ref_tag">6</span></a> is provided in <a href="#A12.SS6" title="L.6 Proof of ‣ Appendix L Proofs of Auxiliary Lemmas ‣ Sharp Convergence Rates for Masked Diffusion Models" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Section</span> <span class="ltx_text ltx_ref_tag">L.6</span></a>.</p>
</div>
<div id="A10.p9" class="ltx_para ltx_noindent">
<p id="A10.p9.1" class="ltx_p">Further, <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib9" title="" class="ltx_ref">22</a>]</cite> shows that NELBO can be equivalently reformulated as</p>
<table id="A10.Ex147" class="ltx_equationgroup ltx_eqn_table">

<tbody id="A10.Ex147X"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A10.Ex147X.m2" class="ltx_Math" alttext="\displaystyle\mathcal{L}_{\infty}(x_{0})=-\sum_{k=1}^{d}\mathbb{E}_{x_{k}\sim\tilde{q}_{k|0}(\cdot\mid x_{0})}\left[\frac{1}{k}\sum_{l:x_{k}^{l}=\mathrm{[MASK]}}\log\bar{\mu}_{\theta}^{(l)}(x_{k}))[x_{0}^{l}]\right]," display="inline" intent=":literal"><semantics><mrow><mi class="ltx_font_mathcaligraphic">ℒ</mi><msub><mrow></mrow><mi mathvariant="normal">∞</mi></msub><mo stretchy="false">(</mo><mi>x</mi><msub><mrow></mrow><mn>0</mn></msub><mo stretchy="false">)</mo><mo rspace="0em">=</mo><mo lspace="0em">−</mo><mstyle displaystyle="true"><mo movablelimits="false">∑</mo></mstyle><msub><mrow></mrow><mrow><mi>k</mi><mo>=</mo><mn>1</mn></mrow></msub><msup><mrow></mrow><mi>d</mi></msup><mi>𝔼</mi><msub><mrow></mrow><mrow><mi>x</mi><msub><mrow></mrow><mi>k</mi></msub><mo>∼</mo><mover accent="true"><mi>q</mi><mo>~</mo></mover><msub><mrow></mrow><mrow><mi>k</mi><mo fence="false">|</mo><mn>0</mn></mrow></msub><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo lspace="0em" rspace="0.167em">∣</mo><mi>x</mi><msub><mrow></mrow><mn>0</mn></msub><mo stretchy="false">)</mo></mrow></msub><mo>[</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>k</mi></mfrac></mstyle><mstyle displaystyle="true"><mo movablelimits="false">∑</mo></mstyle><msub><mrow></mrow><mrow><mi>l</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><msubsup><mi>x</mi><mi>k</mi><mi>l</mi></msubsup><mo>=</mo><mrow><mo stretchy="false">[</mo><mi>MASK</mi><mo stretchy="false">]</mo></mrow></mrow></mrow></msub><mi>log</mi><mover accent="true"><mi>μ</mi><mo>¯</mo></mover><msub><mrow></mrow><mi>θ</mi></msub><msup><mrow></mrow><mrow><mo stretchy="false">(</mo><mi>l</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">(</mo><mi>x</mi><msub><mrow></mrow><mi>k</mi></msub><mo stretchy="false">)</mo><mo stretchy="false">)</mo><mo stretchy="false">[</mo><mi>x</mi><msub><mrow></mrow><mn>0</mn></msub><msup><mrow></mrow><mi>l</mi></msup><mo stretchy="false">]</mo><mo>]</mo><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\mathcal{L}_{\infty}(x_{0})=-\sum_{k=1}^{d}\mathbb{E}_{x_{k}\sim\tilde{q}_{k|0}(\cdot\mid x_{0})}\left[\frac{1}{k}\sum_{l:x_{k}^{l}=\mathrm{[MASK]}}\log\bar{\mu}_{\theta}^{(l)}(x_{k}))[x_{0}^{l}]\right],</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A10.p9.2" class="ltx_p">where <math id="A10.p9.m1" class="ltx_Math" alttext="\tilde{q}_{k|0}(x_{k}|x_{0})" display="inline" intent=":literal"><semantics><mrow><msub><mover accent="true"><mi>q</mi><mo>~</mo></mover><mrow><mi>k</mi><mo fence="false">|</mo><mn>0</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mi>k</mi></msub><mo lspace="0em" rspace="0em">|</mo><msub><mi>x</mi><mn>0</mn></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\tilde{q}_{k|0}(x_{k}|x_{0})</annotation></semantics></math> denotes the discrete forward process which randomly and uniformly masks <math id="A10.p9.m2" class="ltx_Math" alttext="k" display="inline" intent=":literal"><semantics><mi>k</mi><annotation encoding="application/x-tex">k</annotation></semantics></math> tokens of <math id="A10.p9.m3" class="ltx_Math" alttext="x_{0}" display="inline" intent=":literal"><semantics><msub><mi>x</mi><mn>0</mn></msub><annotation encoding="application/x-tex">x_{0}</annotation></semantics></math>, and</p>
<table id="A10.E35" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A10.E35.m1" class="ltx_Math" alttext="\log\bar{\mu}_{\theta}(x_{k})=\mathbb{E}_{\alpha^{\prime}\sim\mathrm{Beta}(d-k+1,k)}\big[\log\mu_{\theta}(x_{k},\alpha^{-1}(\alpha^{\prime}))\big]." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><msub><mover accent="true"><mi>μ</mi><mo>¯</mo></mover><mi>θ</mi></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mi>k</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><msub><mi>𝔼</mi><mrow><msup><mi>α</mi><mo>′</mo></msup><mo>∼</mo><mrow><mi>Beta</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mi>d</mi><mo>−</mo><mi>k</mi></mrow><mo>+</mo><mn>1</mn></mrow><mo>,</mo><mi>k</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="1.200em" minsize="1.200em">[</mo><mrow><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><msub><mi>μ</mi><mi>θ</mi></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mi>k</mi></msub><mo>,</mo><mrow><msup><mi>α</mi><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>α</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo maxsize="1.200em" minsize="1.200em">]</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\log\bar{\mu}_{\theta}(x_{k})=\mathbb{E}_{\alpha^{\prime}\sim\mathrm{Beta}(d-k+1,k)}\big[\log\mu_{\theta}(x_{k},\alpha^{-1}(\alpha^{\prime}))\big].</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(35)</span></td></tr></tbody>
</table>
</div>
<div id="A10.p10" class="ltx_para ltx_noindent">
<p id="A10.p10.1" class="ltx_p">Then combining <a href="#Thmlemma6" title="Lemma 6. ‣ Appendix J Proof of ‣ Sharp Convergence Rates for Masked Diffusion Models" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Lemma</span> <span class="ltx_text ltx_ref_tag">6</span></a> and (<a href="#A10.E35" title="Equation 35 ‣ Appendix J Proof of ‣ Sharp Convergence Rates for Masked Diffusion Models" class="ltx_ref"><span class="ltx_text ltx_ref_tag">35</span></a>), we have</p>
<table id="A10.E36" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A10.E36.m1" class="ltx_Math" alttext="\mathbb{E}_{\tau_{k-1}}\left[-\log(\mu_{\theta}^{i_{k-1}}(x_{k},\tau_{k-1})[a])\right]=-\log(\bar{\mu}_{\theta}^{i_{k-1}}(x_{k})[a])." display="block" intent=":literal"><semantics><mrow><mrow><mrow><msub><mi>𝔼</mi><msub><mi>τ</mi><mrow><mi>k</mi><mo>−</mo><mn>1</mn></mrow></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><mrow><mo rspace="0.167em">−</mo><mrow><mi>log</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msubsup><mi>μ</mi><mi>θ</mi><msub><mi>i</mi><mrow><mi>k</mi><mo>−</mo><mn>1</mn></mrow></msub></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mi>k</mi></msub><mo>,</mo><msub><mi>τ</mi><mrow><mi>k</mi><mo>−</mo><mn>1</mn></mrow></msub><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mi>a</mi><mo stretchy="false">]</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>]</mo></mrow></mrow><mo>=</mo><mrow><mo rspace="0.167em">−</mo><mrow><mi>log</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msubsup><mover accent="true"><mi>μ</mi><mo>¯</mo></mover><mi>θ</mi><msub><mi>i</mi><mrow><mi>k</mi><mo>−</mo><mn>1</mn></mrow></msub></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mi>k</mi></msub><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mi>a</mi><mo stretchy="false">]</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\mathbb{E}_{\tau_{k-1}}\left[-\log(\mu_{\theta}^{i_{k-1}}(x_{k},\tau_{k-1})[a])\right]=-\log(\bar{\mu}_{\theta}^{i_{k-1}}(x_{k})[a]).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(36)</span></td></tr></tbody>
</table>
</div>
<div id="A10.p11" class="ltx_para ltx_noindent">
<p id="A10.p11.1" class="ltx_p">Thus, given (<a href="#A10.E36" title="Equation 36 ‣ Appendix J Proof of ‣ Sharp Convergence Rates for Masked Diffusion Models" class="ltx_ref"><span class="ltx_text ltx_ref_tag">36</span></a>), we derive</p>
<table id="A10.EGx25" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A10.Ex148"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
