<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex23.m1" class="ltx_math_unparsed" alttext="\displaystyle\stackrel{{\scriptstyle(ii)}}{{\gtrsim}}\frac{1}{e^{t}-1}\mathbb{E}_{x_{t}\sim\mathchoice{\mkern 3.0mu\reflectbox{$\displaystyle\vec{\reflectbox{$\mkern-3.0mu\displaystyle q\mkern 3.0mu$}}$}\mkern-3.0mu}{\mkern 3.0mu\reflectbox{$\textstyle\vec{\reflectbox{$\mkern-3.0mu\textstyle q\mkern 3.0mu$}}$}\mkern-3.0mu}{\mkern 2.0mu\reflectbox{$\scriptstyle\vec{\reflectbox{$\mkern-2.0mu\scriptstyle q\mkern 2.0mu$}}$}\mkern-2.0mu}{\mkern 2.0mu\reflectbox{$\scriptscriptstyle\vec{\reflectbox{$\mkern-2.0mu\scriptscriptstyle q\mkern 2.0mu$}}$}\mkern-2.0mu}_{t_{k}}}\sum_{\begin{subarray}{c}y:y\neq x_{k}\\
\text{only}\penalty\ y^{i}\neq x^{i}=\mathrm{[MASK]}\end{subarray}}(\hat{q}_{0}(y^{i}|x_{k}^{UM})-q_{0}(y^{i}|x_{k}^{UM}))^{2}." display="inline" intent=":literal"><semantics><mrow><mover><mo>≳</mo><mrow><mo stretchy="false">(</mo><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>i</mi></mrow><mo stretchy="false">)</mo></mrow></mover><mstyle displaystyle="true"><mfrac><mn>1</mn><mrow><msup><mi>e</mi><mi>t</mi></msup><mo>−</mo><mn>1</mn></mrow></mfrac></mstyle><msub><mi>𝔼</mi><mrow><msub><mi>x</mi><mi>t</mi></msub><mo rspace="0.388em">∼</mo><msub><mpadded style="width:6.5pt;height:7.1pt;vertical-align:-0.0pt;" depth="0.0pt" height="7.1pt" width="6.5pt"><mover accent="true"><mpadded style="width:1.7pt;height:2.2pt;vertical-align:-0.7pt;" depth="0.7pt" height="1.5pt" width="1.7pt"><mi mathsize="0.480em">q</mi></mpadded><mo stretchy="false">→</mo></mover></mpadded><msub><mi>t</mi><mi>k</mi></msub></msub></mrow></msub><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mtable rowspacing="0pt"><mtr><mtd><mrow><mi>y</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi>y</mi><mo>≠</mo><msub><mi>x</mi><mi>k</mi></msub></mrow></mrow></mtd></mtr><mtr><mtd><mrow><mrow><mtext>only</mtext><mo lspace="0.410em" rspace="0em">​</mo><msup><mi>y</mi><mi>i</mi></msup></mrow><mo>≠</mo><msup><mi>x</mi><mi>i</mi></msup><mo>=</mo><mrow><mo stretchy="false">[</mo><mi>MASK</mi><mo stretchy="false">]</mo></mrow></mrow></mtd></mtr></mtable></munder></mstyle><msup><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi>q</mi><mo>^</mo></mover><mn>0</mn></msub><mrow><mo stretchy="false">(</mo><msup><mi>y</mi><mi>i</mi></msup><mo fence="false" rspace="0.167em" stretchy="false">|</mo><msubsup><mi>x</mi><mi>k</mi><mrow><mi>U</mi><mo lspace="0em" rspace="0em">​</mo><mi>M</mi></mrow></msubsup><mo stretchy="false">)</mo></mrow><mo>−</mo><msub><mi>q</mi><mn>0</mn></msub><mrow><mo stretchy="false">(</mo><msup><mi>y</mi><mi>i</mi></msup><mo fence="false" rspace="0.167em" stretchy="false">|</mo><msubsup><mi>x</mi><mi>k</mi><mrow><mi>U</mi><mo lspace="0em" rspace="0em">​</mo><mi>M</mi></mrow></msubsup><mo stretchy="false">)</mo></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\stackrel{{\scriptstyle(ii)}}{{\gtrsim}}\frac{1}{e^{t}-1}\mathbb{E}_{x_{t}\sim\mathchoice{\mkern 3.0mu\reflectbox{$\displaystyle\vec{\reflectbox{$\mkern-3.0mu\displaystyle q\mkern 3.0mu$}}$}\mkern-3.0mu}{\mkern 3.0mu\reflectbox{$\textstyle\vec{\reflectbox{$\mkern-3.0mu\textstyle q\mkern 3.0mu$}}$}\mkern-3.0mu}{\mkern 2.0mu\reflectbox{$\scriptstyle\vec{\reflectbox{$\mkern-2.0mu\scriptstyle q\mkern 2.0mu$}}$}\mkern-2.0mu}{\mkern 2.0mu\reflectbox{$\scriptscriptstyle\vec{\reflectbox{$\mkern-2.0mu\scriptscriptstyle q\mkern 2.0mu$}}$}\mkern-2.0mu}_{t_{k}}}\sum_{\begin{subarray}{c}y:y\neq x_{k}\\
\text{only}\penalty\ y^{i}\neq x^{i}=\mathrm{[MASK]}\end{subarray}}(\hat{q}_{0}(y^{i}|x_{k}^{UM})-q_{0}(y^{i}|x_{k}^{UM}))^{2}.</annotation></semantics></math></td>
