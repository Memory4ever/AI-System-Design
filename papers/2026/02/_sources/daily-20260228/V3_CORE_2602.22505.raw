<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.Ex60.m1" class="ltx_Math" alttext="\displaystyle=\kappa\cdot O\left(\sum_{k=0}^{N-1}\int_{t_{k}}^{t_{k+1}}\mathbb{E}_{x_{t}\sim\mathchoice{\mkern 3.0mu\reflectbox{$\displaystyle\vec{\reflectbox{$\mkern-3.0mu\displaystyle q\mkern 3.0mu$}}$}\mkern-3.0mu}{\mkern 3.0mu\reflectbox{$\textstyle\vec{\reflectbox{$\mkern-3.0mu\textstyle q\mkern 3.0mu$}}$}\mkern-3.0mu}{\mkern 2.0mu\reflectbox{$\scriptstyle\vec{\reflectbox{$\mkern-2.0mu\scriptstyle q\mkern 2.0mu$}}$}\mkern-2.0mu}{\mkern 2.0mu\reflectbox{$\scriptscriptstyle\vec{\reflectbox{$\mkern-2.0mu\scriptscriptstyle q\mkern 2.0mu$}}$}\mkern-2.0mu}_{t}}\left[h_{t}(x_{t})\right]\mathrm{d}t\right)" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mi>κ</mi><mo lspace="0.222em" rspace="0.222em">⋅</mo><mrow><mi>O</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>k</mi><mo>=</mo><mn>0</mn></mrow><mrow><mi>N</mi><mo>−</mo><mn>1</mn></mrow></munderover></mstyle><mrow><mstyle displaystyle="true"><msubsup><mo>∫</mo><msub><mi>t</mi><mi>k</mi></msub><msub><mi>t</mi><mrow><mi>k</mi><mo>+</mo><mn>1</mn></mrow></msub></msubsup></mstyle><mrow><msub><mi>𝔼</mi><mrow><msub><mi>x</mi><mi>t</mi></msub><mo rspace="0.388em">∼</mo><msub><mpadded style="width:6.5pt;height:7.1pt;vertical-align:-0.0pt;" depth="0.0pt" height="7.1pt" width="6.5pt"><mover accent="true"><mpadded style="width:1.7pt;height:2.2pt;vertical-align:-0.7pt;" depth="0.7pt" height="1.5pt" width="1.7pt"><mi mathsize="0.480em">q</mi></mpadded><mo stretchy="false">→</mo></mover></mpadded><mi>t</mi></msub></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><mrow><msub><mi>h</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>]</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo rspace="0