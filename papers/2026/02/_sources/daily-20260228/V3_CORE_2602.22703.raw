              <span id="alg1.l25.2" class="ltx_text ltx_font_bold">end</span> <span id="alg1.l25.3" class="ltx_text ltx_font_bold">for</span>
</div>
<div id="alg1.l26" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline">26:</span>
              
              
              <span id="alg1.l26.2" class="ltx_text ltx_font_bold">return</span> <math id="alg1.l26.m1" class="ltx_Math" alttext="\mathcal{D}_{DPO}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">𝒟</mi><mrow><mi>D</mi><mo lspace="0em" rspace="0em">​</mo><mi>P</mi><mo lspace="0em" rspace="0em">​</mo><mi>O</mi></mrow></msub><annotation encoding="application/x-tex">\mathcal{D}_{DPO}</annotation></semantics></math>

</div>
