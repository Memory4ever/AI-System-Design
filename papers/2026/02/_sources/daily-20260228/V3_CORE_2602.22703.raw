<td id="S5.T4.4.1.1.3" class="ltx_td ltx_align_center ltx_border_tt" style="padding-left:5.5pt;padding-right:5.5pt;" rowspan="2"><span id="S5.T4.4.1.1.3.1" class="ltx_text"><span id="S5.T4.4.1.1.3.1.1" class="ltx_text"></span> <span id="S5.T4.4.1.1.3.1.2" class="ltx_text">
<span id="S5.T4.4.1.1.3.1.2.1" class="ltx_tabular ltx_align_middle">
<span id="S5.T4.4.1.1.3.1.2.1.1" class="ltx_tr">
<span id="S5.T4.4.1.1.3.1.2.1.1.1" class="ltx_td ltx_nopad_r ltx_align_center" style="padding-left:5.5pt;padding-right:5.5pt;"><span id="S5.T4.4.1.1.3.1.2.1.1.1.1" class="ltx_text ltx_font_bold">Overall</span></span></span>
<span id="S5.T4.4.1.1.3.1.2.1.2" class="ltx_tr">
<span id="S5.T4.4.1.1.3.1.2.1.2.1" class="ltx_td ltx_nopad_r ltx_align_center" style="padding-left:5.5pt;padding-right:5.5pt;"><span id="S5.T4.4.1.1.3.1.2.1.2.1.1" class="ltx_text ltx_font_bold">Score</span></span></span>
</span></span><span id="S5.T4.4.1.1.3.1.3" class="ltx_text"></span></span></td>
