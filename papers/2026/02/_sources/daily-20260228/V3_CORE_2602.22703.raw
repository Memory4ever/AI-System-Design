<span id="S1.T1.6.1.1.2.1" class="ltx_inline-block ltx_align_top" style="width:79.5pt;">
<span id="S1.T1.6.1.1.2.1.1" class="ltx_p"><span id="S1.T1.6.1.1.2.1.1.1" class="ltx_text ltx_font_bold">Model</span></span>
</span></td>
<td id="S1.T1.6.1.1.3" class="ltx_td ltx_align_left ltx_align_top ltx_border_tt">
<span id="S1.T1.6.1.1.3.1" class="ltx_inline-block ltx_align_top" style="width:218.6pt;">
<span id="S1.T1.6.1.1.3.1.1" class="ltx_p"><span id="S1.T1.6.1.1.3.1.1.1" class="ltx_text ltx_font_bold">Caption</span></span>
</span></td></tr>
<tr id="S1.T1.6.1.2" class="ltx_tr">
<td id="S1.T1.6.1.2.1" class="ltx_td ltx_align_left ltx_align_top ltx_border_t">
<span id="S1.T1.6.1.2.1.1" class="ltx_inline-block ltx_align_top" style="width:99.4pt;">
<span id="S1.T1.6.1.2.1.1.1" class="ltx_p"><img src="2602.22703v1/figs/badcase-demo-diagram.png" id="S1.T1.g1" class="ltx_graphics ltx_img_square" style="aspect-ratio:165/157;" width="165" height="157" alt="[Uncaptioned image]"></span>
</span></td>
<td id="S1.T1.6.1.2.2" class="ltx_td ltx_align_left ltx_align_top ltx_border_t">
<span id="S1.T1.6.1.2.2.1" class="ltx_inline-block ltx_align_top" style="width:79.5pt;">
<span id="S1.T1.6.1.2.2.1.1" class="ltx_p"><span id="S1.T1.6.1.2.2.1.1.1" class="ltx_text"></span><span id="S1.T1.6.1.2.2.1.1.2" class="ltx_text">
