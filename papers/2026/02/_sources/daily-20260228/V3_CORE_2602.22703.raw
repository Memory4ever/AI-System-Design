              <span class="ltx_tag ltx_tag_listingline">21:</span>
              
              
                 <span id="alg1.l21.2" class="ltx_text ltx_font_bold">else</span>
</div>
<div id="alg1.l22" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline">22:</span>
              
              
                  <math id="alg1.l22.m1" class="ltx_Math" alttext="idx_{l}\leftarrow idx_{l}+1" display="inline" intent=":literal"><semantics><mrow><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>x</mi><mi>l</mi></msub></mrow><mo stretchy="false">←</mo><mrow><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>x</mi><mi>l</mi></msub></mrow><mo>+</mo><mn>1</mn></mrow></mrow><annotation encoding="application/x-tex">idx_{l}\leftarrow idx_{l}+1</annotation></semantics></math> <span id="alg1.l22.2" class="ltx_text" style="float:right;"><math id="alg1.l22.m2" class="ltx_Math" alttext="\triangleright" display="inline" intent=":literal"><semantics><mo>⊳</mo><annotation encoding="application/x-tex">\triangleright</annotation></semantics></math> Current loser not distinct enough, try next potential loser
</span>
</div>
