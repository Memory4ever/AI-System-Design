<td id="A2.T10.5.1.5.2" class="ltx_td ltx_align_left"><span id="A2.T10.5.1.5.2.1" class="ltx_text" style="font-size:90%;">Similar algorithmic kernel (matrix factorization)</span></td>
<td id="A2.T10.5.1.5.3" class="ltx_td ltx_align_left"><span id="A2.T10.5.1.5.3.1" class="ltx_text ltx_font_typewriter" style="font-size:90%;">svd <math id="A2.T10.m5" class="ltx_Math" alttext="\rightarrow" display="inline" intent=":literal"><semantics><mo stretchy="false">→</mo><annotation encoding="application/x-tex">\rightarrow</annotation></semantics></math> pca_lowrank</span></td></tr>
<tr id="A2.T10.5.1.6" class="ltx_tr">
