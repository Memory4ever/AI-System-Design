<td id="A3.T11.5.4.1" class="ltx_td ltx_align_left ltx_border_bb"><span id="A3.T11.5.4.1.1" class="ltx_text ltx_font_smallcaps">TransFuzz</span></td>
<td id="A3.T11.5.4.2" class="ltx_td ltx_align_center ltx_border_bb">0.8442</td>
