<td id="A2.T10.5.1.6.2" class="ltx_td ltx_align_left"><span id="A2.T10.5.1.6.2.1" class="ltx_text" style="font-size:90%;">Similar warning generation mechanism</span></td>
<td id="A2.T10.5.1.6.3" class="ltx_td ltx_align_left"><span id="A2.T10.5.1.6.3.1" class="ltx_text ltx_font_typewriter" style="font-size:90%;">compile <math id="A2.T10.m6" class="ltx_Math" alttext="\rightarrow" display="inline" intent=":literal"><semantics><mo stretchy="false">→</mo><annotation encoding="application/x-tex">\rightarrow</annotation></semantics></math> jit.trace</span></td></tr>
<tr id="A2.T10.5.1.7" class="ltx_tr">
<td id="A2.T10.5.1.7.1" class="ltx_td ltx_align_left"><span id="A2.T10.5.1.7.1.1" class="ltx_text" style="font-size:90%;">Design Pattern</span></td>
<td id="A2.T10.5.1.7.2" class="ltx_td ltx_align_left"><span id="A2.T10.5.1.7.2.1" class="ltx_text" style="font-size:90%;">Similar dynamic class construction pattern</span></td>
<td id="A2.T10.5.1.7.3" class="ltx_td ltx_align_left"><span id="A2.T10.5.1.7.3.1" class="ltx_text ltx_font_typewriter" style="font-size:90%;">OpaqueUnaryFn <math id="A2.T10.m7" class="ltx_Math" alttext="\rightarrow" display="inline" intent=":literal"><semantics><mo stretchy="false">→</mo><annotation encoding="application/x-tex">\rightarrow</annotation></semantics></math> BitwiseFn</span></td></tr>
<tr id="A2.T10.5.1.8" class="ltx_tr">
<td id="A2.T10.5.1.8.1" class="ltx_td ltx_align_left"><span id="A2.T10.5.1.8.1.1" class="ltx_text" style="font-size:90%;">Usage State</span></td>
<td id="A2.T10.5.1.8.2" class="ltx_td ltx_align_left"><span id="A2.T10.5.1.8.2.1" class="ltx_text" style="font-size:90%;">Similar persistent quantized state</span></td>
<td id="A2.T10.5.1.8.3" class="ltx_td ltx_align_left"><span id="A2.T10.5.1.8.3.1" class="ltx_text ltx_font_typewriter" style="font-size:90%;">quant.Hardswish <math id="A2.T10.m8" class="ltx_Math" alttext="\rightarrow" display="inline" intent=":literal"><semantics><mo stretchy="false">→</mo><annotation encoding="application/x-tex">\rightarrow</annotation></semantics></math> quant.Sigmoid</span></td></tr>
<tr id="A2.T10.5.1.9" class="ltx_tr">
<td id="A2.T10.5.1.9.1" class="ltx_td ltx_align_left"><span id="A2.T10.5.1.9.1.1" class="ltx_text" style="font-size:90%;">Input Semantics</span></td>
<td id="A2.T10.5.1.9.2" class="ltx_td ltx_align_left"><span id="A2.T10.5.1.9.2.1" class="ltx_text" style="font-size:90%;">Similar NumPy-to-Tensor conversion path</span></td>
<td id="A2.T10.5.1.9.3" class="ltx_td ltx_align_left"><span id="A2.T10.5.1.9.3.1" class="ltx_text ltx_font_typewriter" style="font-size:90%;">tensor <math id="A2.T10.m9" class="ltx_Math" alttext="\rightarrow" display="inline" intent=":literal"><semantics><mo stretchy="false">→</mo><annotation encoding="application/x-tex">\rightarrow</annotation></semantics></math> default_collate</span></td></tr>
