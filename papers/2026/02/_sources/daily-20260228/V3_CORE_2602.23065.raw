<ul id="S4.I3" class="ltx_itemize">
<li id="S4.I3.ix1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">*</span> 
<div id="S4.I3.ix1.p1" class="ltx_para">
<p id="S4.I3.ix1.p1.1" class="ltx_p"><span id="S4.I3.ix1.p1.1.1" class="ltx_text" style="font-size:90%;">“N/A” indicates that the fuzzer is not applicable for detecting this specific type of bug.</span></p>
</div></li>
