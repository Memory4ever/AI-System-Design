<td id="S4.T5.6.1.4.5" class="ltx_td ltx_align_center ltx_border_t">1</td>
<td id="S4.T5.6.1.4.6" class="ltx_td ltx_align_center ltx_border_t">1</td>
<td id="S4.T5.6.1.4.7" class="ltx_td ltx_align_center ltx_border_r ltx_border_t"><span id="S4.T5.6.1.4.7.1" class="ltx_text ltx_font_bold">1</span></td>
<td id="S4.T5.6.1.4.8" class="ltx_td ltx_align_center ltx_border_t">N/A</td>
