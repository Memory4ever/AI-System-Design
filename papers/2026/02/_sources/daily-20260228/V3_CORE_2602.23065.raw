<tr id="S4.T3.7.1.4" class="ltx_tr">
<td id="S4.T3.7.1.4.1" class="ltx_td ltx_align_left ltx_border_r ltx_border_t"><span id="S4.T3.7.1.4.1.1" class="ltx_text"></span><span id="S4.T3.7.1.4.1.2" class="ltx_text">
<span id="S4.T3.7.1.4.1.2.1" class="ltx_tabular ltx_align_middle">
<span id="S4.T3.7.1.4.1.2.1.1" class="ltx_tr">
<span id="S4.T3.7.1.4.1.2.1.1.1" class="ltx_td ltx_nopad_r ltx_align_left">Eager VS Jit</span></span>
</span></span><span id="S4.T3.7.1.4.1.3" class="ltx_text"></span></td>
<td id="S4.T3.7.1.4.2" class="ltx_td ltx_align_left ltx_border_r ltx_border_t">torch.set_default_dtype + torch.jit.script</td>
<td id="S4.T3.7.1.4.3" class="ltx_td ltx_align_left ltx_border_r ltx_border_t">torch #36369</td>
<td id="S4.T3.7.1.4.4" class="ltx_td ltx_align_left ltx_border_r ltx_border_t"><span id="S4.T3.7.1.4.4.1" class="ltx_text ltx_underline">torch #150607</span></td>
<td id="S4.T3.7.1.4.5" class="ltx_td ltx_align_center ltx_border_t">1</td></tr>
<tr id="S4.T3.7.1.5" class="ltx_tr">
<td id="S4.T3.7.1.5.1" class="ltx_td ltx_align_left ltx_border_r ltx_border_t"><span id="S4.T3.7.1.5.1.1" class="ltx_text"></span><span id="S4.T3.7.1.5.1.2" class="ltx_text">
<span id="S4.T3.7.1.5.1.2.1" class="ltx_tabular ltx_align_middle">
<span id="S4.T3.7.1.5.1.2.1.1" class="ltx_tr">
