            <math id="algorithm1.m12" class="ltx_Math" alttext="\mathcal{O}\leftarrow\emptyset" display="inline" intent=":literal"><semantics><mrow><mi class="ltx_font_mathcaligraphic">𝒪</mi><mo stretchy="false">←</mo><mi mathvariant="normal">∅</mi></mrow><annotation encoding="application/x-tex">\mathcal{O}\leftarrow\emptyset</annotation></semantics></math>
</div>
<div id="algorithm1.4.12" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="algorithm1.4.12.1" class="ltx_text ltx_font_bold">8</span></span>
            <span id="algorithm1.4.12.2" class="ltx_text ltx_font_bold">foreach</span> <em id="algorithm1.4.12.3" class="ltx_emph ltx_font_italic">line <math id="algorithm1.m13" class="ltx_Math" alttext="\ell_{i}" display="inline" intent=":literal"><semantics><msub><mi mathvariant="normal">ℓ</mi><mi>i</mi></msub><annotation encoding="application/x-tex">\ell_{i}</annotation></semantics></math> in <math id="algorithm1.m14" class="ltx_Math" alttext="S" display="inline" intent=":literal"><semantics><mi>S</mi><annotation encoding="application/x-tex">S</annotation></semantics></math> where <math id="algorithm1.m15" class="ltx_Math" alttext="i&lt;B" display="inline" intent=":literal"><semantics><mrow><mi>i</mi><mo>&lt;</mo><mi>B</mi></mrow><annotation encoding="application/x-tex">i&lt;B</annotation></semantics></math></em> <span id="algorithm1.4.12.4" class="ltx_text ltx_font_bold">do</span>
</div>
<div id="algorithm1.4.13" class="ltx_listingline"> <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span> 
              <span class="ltx_tag ltx_tag_listingline"><span id="algorithm1.4.13.1" class="ltx_text ltx_font_bold">9</span></span>
            <span id="algorithm1.4.13.2" class="ltx_text ltx_font_bold">foreach</span> <em id="algorithm1.4.13.3" class="ltx_emph ltx_font_italic">content block <math id="algorithm1.m16" class="ltx_Math" alttext="b" display="inline" intent=":literal"><semantics><mi>b</mi><annotation encoding="application/x-tex">b</annotation></semantics></math> in <math id="algorithm1.m17" class="ltx_Math" alttext="\ell_{i}" display="inline" intent=":literal"><semantics><msub><mi mathvariant="normal">ℓ</mi><mi>i</mi></msub><annotation encoding="application/x-tex">\ell_{i}</annotation></semantics></math></em> <span id="algorithm1.4.13.4" class="ltx_text ltx_font_bold">do</span>
</div>
<div id="algorithm1.4.14" class="ltx_listingline"> <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span>  <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span> 
              <span class="ltx_tag ltx_tag_listingline"><span id="algorithm1.4.14.1" class="ltx_text ltx_font_bold">10</span></span>
            <span id="algorithm1.4.14.2" class="ltx_text ltx_font_bold">if</span> <em id="algorithm1.4.14.3" class="ltx_emph ltx_font_italic"><math id="algorithm1.m18" class="ltx_Math" alttext="b.\text{type}=" display="inline" intent=":literal"><semantics><mrow><mi>b</mi><mo lspace="0em" rspace="0.167em">.</mo><mrow><mtext class="ltx_mathvariant_italic">type</mtext><mo>=</mo><mphantom></mphantom></mrow></mrow><annotation encoding="application/x-tex">b.\text{type}=</annotation></semantics></math> <span id="algorithm1.4.14.3.1" class="ltx_text ltx_font_typewriter">tool_use</span></em> <span id="algorithm1.4.14.4" class="ltx_text ltx_font_bold">then</span>
</div>
<div id="algorithm1.4.15" class="ltx_listingline"> <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span>  <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span>  <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span> 
