<td id="S4.T1.2.1.2.4" class="ltx_td ltx_align_center ltx_border_t" style="padding:1.5pt 5.0pt;"><span id="S4.T1.2.1.2.4.1" class="ltx_text"></span> <span id="S4.T1.2.1.2.4.2" class="ltx_text">
<span id="S4.T1.2.1.2.4.2.1" class="ltx_tabular ltx_align_middle">
<span id="S4.T1.2.1.2.4.2.1.1" class="ltx_tr">
<span id="S4.T1.2.1.2.4.2.1.1.1" class="ltx_td ltx_nopad_r ltx_align_center" style="padding:1.5pt 5.0pt;">IoU<math id="S4.T1.m4" class="ltx_math_unparsed" alttext="{}_{\text{max}}\downarrow" display="inline" intent=":literal"><semantics><mrow><msub><mrow></mrow><mtext>max</mtext></msub><mo stretchy="false">↓</mo></mrow><annotation encoding="application/x-tex">{}_{\text{max}}\downarrow</annotation></semantics></math></span></span>
</span></span><span id="S4.T1.2.1.2.4.3" class="ltx_text"></span></td>
<td id="S4.T1.2.1.2.5" class="ltx_td ltx_align_center ltx_border_r ltx_border_t" style="padding:1.5pt 5.0pt;"><span id="S4.T1.2.1.2.5.1" class="ltx_text"></span> <span id="S4.T1.2.1.2.5.2" class="ltx_text">
