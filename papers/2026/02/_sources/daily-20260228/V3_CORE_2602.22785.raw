<td id="S4.T1.2.1.2.2" class="ltx_td ltx_align_center ltx_border_t" style="padding:1.5pt 5.0pt;">ULIP-2<math id="S4.T1.m2" class="ltx_Math" alttext="\uparrow" display="inline" intent=":literal"><semantics><mo stretchy="false">↑</mo><annotation encoding="application/x-tex">\uparrow</annotation></semantics></math></td>
