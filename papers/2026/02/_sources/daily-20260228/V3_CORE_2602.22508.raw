<td id="S4.T3.5.1.3.7" class="ltx_td ltx_align_center" style="padding-top:0.75pt;padding-bottom:0.75pt;"><span id="S4.T3.5.1.3.7.1" class="ltx_text ltx_font_bold">0.95</span></td></tr>
