<td id="A2.T9.7.1.23.3" class="ltx_td ltx_align_center ltx_border_bb ltx_border_r"><span id="A2.T9.7.1.23.3.1" class="ltx_text" style="--ltx-bg-color:#F2F2F2;">✓</span></td>
