play="inline" intent=":literal"><semantics><mrow><msub><mi mathvariant="normal">Δ</mi><mi>steg</mi></msub><mo>=</mo><mrow><msub><mi>I</mi><mi>rec</mi></msub><mo>−</mo><msub><mi>I</mi><mi>sen</mi></msub></mrow></mrow><annotation encoding="application/x-tex">\Delta_{\mathrm{steg}}=I_{\mathrm{rec}}-I_{\mathrm{sen}}</annotation></semantics></math>.</span></figcaption>
