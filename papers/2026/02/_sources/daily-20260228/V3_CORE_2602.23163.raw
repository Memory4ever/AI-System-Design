<td id="A6.T8.3.1.2" class="ltx_td ltx_align_left ltx_border_tt"><span id="A6.T8.3.1.2.1" class="ltx_text ltx_font_bold" style="font-size:90%;">Value</span></td></tr>
<tr id="A6.T8.3.2" class="ltx_tr">
<td id="A6.T8.3.2.1" class="ltx_td ltx_align_left ltx_border_t"><span id="A6.T8.3.2.1.1" class="ltx_text" style="font-size:90%;">Base model</span></td>
<td id="A6.T8.3.2.2" class="ltx_td ltx_align_left ltx_border_t"><span id="A6.T8.3.2.2.1" class="ltx_text ltx_font_typewriter" style="font-size:90%;">Qwen/Qwen2.5-3B-Instruct</span></td></tr>
<tr id="A6.T8.3.3" class="ltx_tr">
<td id="A6.T8.3.3.1" class="ltx_td ltx_align_left"><span id="A6.T8.3.3.1.1" class="ltx_text" style="font-size:90%;">Prompt templates</span></td>
<td id="A6.T8.3.3.2" class="ltx_td ltx_align_left"><span id="A6.T8.3.3.2.1" class="ltx_text ltx_font_typewriter" style="font-size:90%;">cot_answer<span id="A6.T8.3.3.2.1.1" class="ltx_text ltx_font_serif"> (for <math id="A6.T8.m1" class="ltx_Math" alttext="\pi_{\text{no-stego}}" display="inline" intent=":literal"><semantics><msub><mi>π</mi><mtext>no-stego</mtext></msub><annotation encoding="application/x-tex">\pi_{\text{no-stego}}</annotation></semantics></math>)</span></span></td></tr>
<tr id="A6.T8.3.4" class="ltx_tr">
<td id="A6.T8.3.4.1" class="ltx_td"></td>
<td id="A6.T8.3.4.2" class="ltx_td ltx_align_left"><span id="A6.T8.3.4.2.1" class="ltx_text ltx_font_typewriter" style="font-size:90%;">cot_answer_encoded<span id="A6.T8.3.4.2.1.1" class="ltx_text ltx_font_serif"> (for <math id="A6.T8.m2" class="ltx_Math" alttext="\pi_{\text{mid-stego}}" display="inline" intent=":literal"><semantics><msub><mi>π</mi><mtext>mid-stego</mtext></msub><annotation encoding="application/x-tex">\pi_{\text{mid-stego}}</annotation></semantics></math>)</span></span></td></tr>
<tr id="A6.T8.3.5" class="ltx_tr">
<td id="A6.T8.3.5.1" class="ltx_td"></td>
<td id="A6.T8.3.5.2" class="ltx_td ltx_align_left"><span id="A6.T8.3.5.2.1" class="ltx_text ltx_font_typewriter" style="font-size:90%;">cot_answer_encoded_multi<span id="A6.T8.3.5.2.1.1" class="ltx_text ltx_font_serif"> (for <math id="A6.T8.m3" class="ltx_Math" alttext="\pi_{\text{high-stego}}" display="inline" intent=":literal"><semantics><msub><mi>π</mi><mtext>high-stego</mtext></msub><annotation encoding="application/x-tex">\pi_{\text{high-stego}}</annotation></semantics></math>)</span></span></td></tr>
<tr id="A6.T8.3.6" class="ltx_tr">
<td id="A6.T8.3.6.1" class="ltx_td ltx_align_left"><span id="A6.T8.3.6.1.1" class="ltx_text" style="font-size:90%;">Generation max tokens</span></td>
<td id="A6.T8.3.6.2" class="ltx_td ltx_align_left"><span id="A6.T8.3.6.2.1" class="ltx_text" style="font-size:90%;">160</span></td></tr>
<tr id="A6.T8.3.7" class="ltx_tr">
<td id="A6.T8.3.7.1" class="ltx_td ltx_align_left"><span id="A6.T8.3.7.1.1" class="ltx_text" style="font-size:90%;">Temperature / top-<math id="A6.T8.m4" class="ltx_Math" alttext="p" display="inline" intent=":literal"><semantics><mi>p</mi><annotation encoding="application/x-tex">p</annotation></semantics></math> / top-<math id="A6.T8.m5" class="ltx_Math" alttext="k" display="inline" intent=":literal"><semantics><mi>k</mi><annotation encoding="application/x-tex">k</annotation></semantics></math></span></td>
<td id="A6.T8.3.7.2" class="ltx_td ltx_align_left"><span id="A6.T8.3.7.2.1" class="ltx_text" style="font-size:90%;">0.8 / 0.9 / 100</span></td></tr>
<tr id="A6.T8.3.8" class="ltx_tr">
<td id="A6.T8.3.8.1" class="ltx_td ltx_align_left"><span id="A6.T8.3.8.1.1" class="ltx_text" style="font-size:90%;">Generations per prompt</span></td>
<td id="A6.T8.3.8.2" class="ltx_td ltx_align_left"><span id="A6.T8.3.8.2.1" class="ltx_text" style="font-size:90%;">8</span></td></tr>
<tr id="A6.T8.3.9" class="ltx_tr">
