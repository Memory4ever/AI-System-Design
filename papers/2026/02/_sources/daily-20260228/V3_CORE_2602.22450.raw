athcolor="#000000">%</mo></mrow></mrow><annotation encoding="application/x-tex">-17\%</annotation></semantics></math></span></span></foreignObject></g><g style="--ltx-stroke-color:#B30000;--ltx-fill-color:#B30000;" fill="#B30000" stroke="#B30000" transform="matrix(1.0 0.0 0.0 1.0 444.1 129.05)"><foreignObject style="--ltx-fo-width:2.39em;--ltx-fo-height:0.75em;--ltx-fo-depth:0.06em;font-size:10pt;" height="11.15" overflow="visible" transform="matrix(1 0 0 -1 0 10.38)" width="33.06"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S6.F2.pic1.m16" class="ltx_Math" alttext="-17\%" display="inline" intent=":literal"><semantics><mrow><mo style="--ltx-fg-color:#B30000;" mathcolor="#B30000">−</mo><mrow><mn style="--ltx-fg-color:#B30000;" mathcolor="#B30000">17</mn><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">%</mo></mrow></mrow><annotation encoding="application/x-tex">-17\%</annotation></semantics></math></span></span></foreignObject></g></g></svg></span>
<figcaption class="ltx_caption ltx_centering"><span class="ltx_tag ltx_tag_figure">Figure 2: </span>Trade-off between stealth (sharding) and reliability. Sharded exfiltration shows reduced success across all surfaces, with the largest drop on Meta (<math id="S6.F2.m2" class="ltx_Math" alttext="-37\%" display="inline" intent=":literal"><semantics><mrow><mo>−</mo><mrow><mn>37</mn><mo>%</mo></mrow></mrow><annotation encoding="application/x-tex">-37\%</annotation></semantics></math>). Body and Title/Anchor maintain relatively high success rates even with complex multi-step instructions.</figcaption>
</figure>
</section>
