<span id="Sx5.T6.3.1.3.1" class="ltx_td ltx_align_left ltx_th ltx_th_row">GPT-2 Small <math id="Sx5.T6.m5" class="ltx_Math" alttext="\times" display="inline" intent=":literal"><semantics><mo>×</mo><annotation encoding="application/x-tex">\times</annotation></semantics></math> GPT-2 Large</span>
<span id="Sx5.T6.3.1.3.2" class="ltx_td ltx_align_center">0.878</span>
<span id="Sx5.T6.3.1.3.3" class="ltx_td ltx_align_center">0.924</span></span>
