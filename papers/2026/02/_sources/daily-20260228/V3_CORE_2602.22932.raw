<td id="S5.T1.5.15.4" class="ltx_td ltx_align_center"><span id="S5.T1.5.15.4.1" class="ltx_text ltx_font_bold" style="--ltx-bg-color:#F1EEFD;">60.1<span id="S5.T1.5.15.4.1.1" class="ltx_text ltx_font_medium"> <span id="S5.T1.5.15.4.1.1.1" class="ltx_text" style="font-size:90%;--ltx-fg-color:#006400;">(+5.1)</span></span></span></td>
