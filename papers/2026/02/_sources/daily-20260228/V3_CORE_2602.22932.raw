<td id="S5.T1.5.18.4" class="ltx_td ltx_align_center"><span id="S5.T1.5.18.4.1" class="ltx_text ltx_font_bold">64.2</span></td>
<td id="S5.T1.5.18.5" class="ltx_td ltx_align_center">56.4</td>
<td id="S5.T1.5.18.6" class="ltx_td ltx_align_center">65.5</td>
<td id="S5.T1.5.18.7" class="ltx_td ltx_align_center">46.4</td></tr>
<tr id="S5.T1.5.19" class="ltx_tr" style="--ltx-bg-color:#F1EEFD;">
<th id="S5.T1.5.19.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_b"><span id="S5.T1.5.19.1.1" class="ltx_text" style="--ltx-bg-color:#F1EEFD;">MSJoE (Ours)</span></th>
<th id="S5.T1.5.19.2" class="ltx_td ltx_align_center ltx_th ltx_th_row ltx_border_b"><span id="S5.T1.5.19.2.1" class="ltx_text" style="--ltx-bg-color:#F1EEFD;">64</span></th>
<td id="S5.T1.5.19.3" class="ltx_td ltx_align_center ltx_border_b"><span id="S5.T1.5.19.3.1" class="ltx_text ltx_font_bold" style="--ltx-bg-color:#F1EEFD;">75.1<span id="S5.T1.5.19.3.1.1" class="ltx_text ltx_font_medium"> <span id="S5.T1.5.19.3.1.1.1" class="ltx_text" style="font-size:90%;--ltx-fg-color:#006400;">(+9.8)</span></span></span></td>
<td id="S5.T1.5.19.4" class="ltx_td ltx_align_center ltx_border_b"><span id="S5.T1.5.19.4.1" class="ltx_text" style="--ltx-bg-color:#F1EEFD;">62.2 <span id="S5.T1.5.19.4.1.1" class="ltx_text" style="font-size:90%;--ltx-fg-color:#006400;">(+4.9)</span></span></td>
