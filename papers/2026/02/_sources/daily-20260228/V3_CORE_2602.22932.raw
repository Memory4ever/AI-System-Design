<td id="S5.T1.5.15.6" class="ltx_td ltx_align_center"><span id="S5.T1.5.15.6.1" class="ltx_text ltx_font_bold" style="--ltx-bg-color:#F1EEFD;">64.3</span></td>
<td id="S5.T1.5.15.7" class="ltx_td ltx_align_center"><span id="S5.T1.5.15.7.1" class="ltx_text ltx_font_bold" style="--ltx-bg-color:#F1EEFD;">46.4<span id="S5.T1.5.15.7.1.1" class="ltx_text ltx_font_medium"> <span id="S5.T1.5.15.7.1.1.1" class="ltx_text" style="font-size:90%;--ltx-fg-color:#006400;">(+9.9)</span></span></span></td></tr>
<tr id="S5.T1.5.16" class="ltx_tr" style="--ltx-bg-color:#F2F2F2;">
<th id="S5.T1.5.16.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_t" colspan="7"><span id="S5.T1.5.16.1.1" class="ltx_text ltx_font_bold ltx_font_italic">Qwen-2.5-VL-7B based methods (64 frames)</span></th></tr>
<tr id="S5.T1.5.17" class="ltx_tr">
<th id="S5.T1.5.17.1" class="ltx_td ltx_align_left ltx_th ltx_th_row">Uniform Sampling</th>
<th id="S5.T1.5.17.2" class="ltx_td ltx_align_center ltx_th ltx_th_row">64</th>
<td id="S5.T1.5.17.3" class="ltx_td ltx_align_center">65.3</td>
