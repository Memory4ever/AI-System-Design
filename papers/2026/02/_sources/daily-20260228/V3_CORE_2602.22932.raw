<span id="lstnumberx17" class="ltx_listingline"><span id="lstnumberx17.1" class="ltx_text ltx_lst_identifier" style="font-size:90%;--ltx-fg-color:#000000;">actor_rollout_ref</span><span id="lstnumberx17.2" class="ltx_text" style="font-size:90%;--ltx-fg-color:#000000;">.</span><span id="lstnumberx17.3" class="ltx_text ltx_lst_identifier" style="font-size:90%;--ltx-fg-color:#000000;">actor</span><span id="lstnumberx17.4" class="ltx_text" style="font-size:90%;--ltx-fg-color:#000000;">.</span><span id="lstnumberx17.5" class="ltx_text ltx_lst_identifier" style="font-size:90%;--ltx-fg-color:#000000;">entropy_coeff</span><span id="lstnumberx17.6" class="ltx_text" style="font-size:90%;--ltx-fg-color:#000000;">=0.0</span><span id="lstnumberx17.7" class="ltx_text ltx_lst_space" style="font-size:90%;--ltx-fg-color:#000000;"> </span><span id="lstnumberx17.8" class="ltx_text" style="font-size:90%;--ltx-fg-color:#000000;">\</span>
</span>
<span id="lstnumberx18" class="ltx_listingline"><span id="lstnumberx18.1" class="ltx_text ltx_lst_identifier" style="font-size:90%;--ltx-fg-color:#000000;">actor_rollout_ref</span><span id="lstnumberx18.2" class="ltx_text" style="font-size:90%;--ltx-fg-color:#000000;">.</span><span id="lstnumberx18.3" class="ltx_text ltx_lst_identifier" style="font-size:90%;--ltx-fg-color:#000000;">rollout</span><span id="lstnumberx18.4" class="ltx_text" style="font-size:90%;--ltx-fg-color:#000000;">.</span><span id="lstnumberx18.5" class="ltx_text ltx_lst_identifier" style="font-size:90%;--ltx-fg-color:#000000;">name</span><span id="lstnumberx18.6" class="ltx_text" style="font-size:90%;--ltx-fg-color:#000000;">=</span><span id="lstnumberx18.7" class="ltx_text ltx_lst_identifier" style="font-size:90%;--ltx-fg-color:#000000;">vllm</span><span id="lstnumberx18.8" class="ltx_text ltx_lst_space" style="font-size:90%;--ltx-fg-color:#000000;"> </span><span id="lstnumberx18.9" class="ltx_text" style="font-size:90%;--ltx-fg-color:#000000;">\</span>
</span>
<span id="lstnumberx19" class="ltx_listingline"><span id="lstnumberx19.1" class="ltx_text ltx_lst_identifier" style="font-size:90%;--ltx-fg-color:#000000;">actor_rollout_ref</span><span id="lstnumberx19.2" class="ltx_text" style="font-size:90%;--ltx-fg-color:#000000;">.</span><span id="lstnumberx19.3" class="ltx_text ltx_lst_identifier" style="font-size:90%;--ltx-fg-color:#000000;">rollout</span><span id="lstnumberx19.4" class="ltx_text" style="font-size:90%;--ltx-fg-color:#000000;">.</span><span id="lstnumberx19.5" class="ltx_text ltx_lst_identifier" style="font-size:90%;--ltx-fg-color:#000000;">n</span><span id="lstnumberx19.6" class="ltx_text" style="font-size:90%;--ltx-fg-color:#000000;">=8</span><span id="lstnumberx19.7" class="ltx_text ltx_lst_space" style="font-size:90%;--ltx-fg-color:#000000;"> </span><span id="lstnumberx19.8" class="ltx_text" style="font-size:90%;--ltx-fg-color:#000000;">\</span>
</span>
<span id="lstnumberx20" class="ltx_listingline"><span id="lstnumberx20.1" class="ltx_text ltx_lst_identifier" style="font-size:90%;--ltx-fg-color:#000000;">actor_rollout_ref</span><span id="lstnumberx20.2" class="ltx_text" style="font-size:90%;--ltx-fg-color:#000000;">.</span><span id="lstnumberx20.3" class="ltx_text ltx_lst_identifier" style="font-size:90%;--ltx-fg-color:#000000;">rollout</span><span id="lstnumberx20.4" class="ltx_text" style="font-size:90%;--ltx-fg-color:#000000;">.</span><span id="lstnumberx20.5" class="ltx_text ltx_lst_identifier" style="font-size:90%;--ltx-fg-color:#000000;">agent</span><span id="lstnumberx20.6" class="ltx_text" style="font-size:90%;--ltx-fg-color:#000000;">.</span><span id="lstnumberx20.7" class="ltx_text ltx_lst_identifier" style="font-size:90%;--ltx-fg-color:#000000;">single_response_max_tokens</span><span id="lstnumberx20.8" class="ltx_text" style="font-size:90%;--ltx-fg-color:#000000;">=512</span><span id="lstnumberx20.9" class="ltx_text ltx_lst_space" style="font-size:90%;--ltx-fg-color:#000000;"> </span><span id="lstnumberx20.10" class="ltx_text" style="font-size:90%;--ltx-fg-color:#000000;">\</span>
