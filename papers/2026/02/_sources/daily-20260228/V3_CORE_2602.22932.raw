<td id="S5.T1.5.17.6" class="ltx_td ltx_align_center">64.1</td>
<td id="S5.T1.5.17.7" class="ltx_td ltx_align_center">39.2</td></tr>
<tr id="S5.T1.5.18" class="ltx_tr">
<th id="S5.T1.5.18.1" class="ltx_td ltx_align_left ltx_th ltx_th_row">TSPO</th>
<th id="S5.T1.5.18.2" class="ltx_td ltx_align_center ltx_th ltx_th_row">64</th>
