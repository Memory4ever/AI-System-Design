<td id="S6.T2.6.1.17.1" class="ltx_td ltx_align_left ltx_border_bb"><span id="S6.T2.6.1.17.1.1" class="ltx_text" style="font-size:90%;">ViSigLIP-OT</span></td>
<td id="S6.T2.6.1.17.2" class="ltx_td ltx_align_center ltx_border_bb"><span id="S6.T2.6.1.17.2.1" class="ltx_text ltx_font_bold" style="font-size:90%;">32.04</span></td>
