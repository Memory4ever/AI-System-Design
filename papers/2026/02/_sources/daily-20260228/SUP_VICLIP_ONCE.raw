<td id="A1.T4.5.1.1.2" class="ltx_td ltx_align_left ltx_border_tt" rowspan="2"><span id="A1.T4.5.1.1.2.1" class="ltx_text">Domain</span></td>
<td id="A1.T4.5.1.1.3" class="ltx_td ltx_align_center ltx_border_tt" colspan="2">Train</td>
<td id="A1.T4.5.1.1.4" class="ltx_td ltx_align_center ltx_border_tt" colspan="2">Validation</td>
<td id="A1.T4.5.1.1.5" class="ltx_td ltx_align_center ltx_border_tt" colspan="2">Test</td></tr>
<tr id="A1.T4.5.1.2" class="ltx_tr">
<td id="A1.T4.5.1.2.1" class="ltx_td ltx_align_right ltx_border_t"><span id="A1.T4.5.1.2.1.1" class="ltx_text ltx_font_typewriter">#</span> Img.</td>
<td id="A1.T4.5.1.2.2" class="ltx_td ltx_align_right ltx_border_t"><span id="A1.T4.5.1.2.2.1" class="ltx_text ltx_font_typewriter">#</span> Cap.</td>
<td id="A1.T4.5.1.2.3" class="ltx_td ltx_align_right ltx_border_t"><span id="A1.T4.5.1.2.3.1" class="ltx_text ltx_font_typewriter">#</span> Img.</td>
<td id="A1.T4.5.1.2.4" class="ltx_td ltx_align_right ltx_border_t"><span id="A1.T4.5.1.2.4.1" class="ltx_text ltx_font_typewriter">#</span> Cap.</td>
<td id="A1.T4.5.1.2.5" class="ltx_td ltx_align_right ltx_border_t"><span id="A1.T4.5.1.2.5.1" class="ltx_text ltx_font_typewriter">#</span> Img.</td>
