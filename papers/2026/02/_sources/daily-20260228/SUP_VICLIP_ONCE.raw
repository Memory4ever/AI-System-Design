<td id="S6.T2.6.1.17.7" class="ltx_td ltx_align_center ltx_border_bb ltx_border_r"><span id="S6.T2.6.1.17.7.1" class="ltx_text" style="font-size:90%;">75.53</span></td>
<td id="S6.T2.6.1.17.8" class="ltx_td ltx_align_center ltx_border_bb"><span id="S6.T2.6.1.17.8.1" class="ltx_text" style="font-size:90%;">56.17</span></td></tr>
