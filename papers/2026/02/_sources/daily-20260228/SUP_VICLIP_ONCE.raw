<td id="S6.T2.6.1.1.2" class="ltx_td ltx_align_center ltx_border_tt" colspan="3"><span id="S6.T2.6.1.1.2.1" class="ltx_text" style="font-size:90%;">Text </span><math id="S6.T2.m1" class="ltx_Math" alttext="\rightarrow" display="inline" intent=":literal"><semantics><mo mathsize="0.900em" stretchy="false">→</mo><annotation encoding="application/x-tex">\rightarrow</annotation></semantics></math><span id="S6.T2.6.1.1.2.2" class="ltx_text" style="font-size:90%;"> Image</span></td>
<td id="S6.T2.6.1.1.3" class="ltx_td ltx_align_center ltx_border_r ltx_border_tt" colspan="3"><span id="S6.T2.6.1.1.3.1" class="ltx_text" style="font-size:90%;">Image </span><math id="S6.T2.m2" class="ltx_Math" alttext="\rightarrow" display="inline" intent=":literal"><semantics><mo mathsize="0.900em" stretchy="false">→</mo><annotation encoding="application/x-tex">\rightarrow</annotation></semantics></math><span id="S6.T2.6.1.1.3.2" class="ltx_text" style="font-size:90%;"> Text</span></td>
<td id="S6.T2.6.1.1.4" class="ltx_td ltx_align_center ltx_border_tt" rowspan="2"><span id="S6.T2.6.1.1.4.1" class="ltx_text ltx_align_center ltx_inline-block" style="font-size:90%;width:29.9pt;">Avg.</span></td></tr>
<tr id="S6.T2.6.1.2" class="ltx_tr">
<td id="S6.T2.6.1.2.1" class="ltx_td ltx_align_center ltx_border_t"><span id="S6.T2.6.1.2.1.1" class="ltx_text ltx_align_center ltx_inline-block" style="font-size:90%;width:29.9pt;">R@1</span></td>
<td id="S6.T2.6.1.2.2" class="ltx_td ltx_align_center ltx_border_t"><span id="S6.T2.6.1.2.2.1" class="ltx_text ltx_align_center ltx_inline-block" style="font-size:90%;width:29.9pt;">R@5</span></td>
