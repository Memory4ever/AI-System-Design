<th id="S4.T4.5.1.3.5" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_t"><span id="S4.T4.5.1.3.5.1" class="ltx_text" style="font-size:90%;">0.797</span></th>
<th id="S4.T4.5.1.3.6" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_t"><span id="S4.T4.5.1.3.6.1" class="ltx_text" style="font-size:90%;">0.846</span></th>
<th id="S4.T4.5.1.3.7" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_t"><span id="S4.T4.5.1.3.7.1" class="ltx_text" style="font-size:90%;">0.866</span></th>
