<td id="S4.T3.5.1.3.2" class="ltx_td ltx_align_center"><span id="S4.T3.5.1.3.2.1" class="ltx_text" style="font-size:90%;">47K</span></td>
<td id="S4.T3.5.1.3.3" class="ltx_td ltx_align_center"><span id="S4.T3.5.1.3.3.1" class="ltx_text" style="font-size:90%;">54.8</span></td>
<td id="S4.T3.5.1.3.4" class="ltx_td ltx_align_center"><span id="S4.T3.5.1.3.4.1" class="ltx_text" style="font-size:90%;">67.6</span></td>
<td id="S4.T3.5.1.3.5" class="ltx_td ltx_align_center"><span id="S4.T3.5.1.3.5.1" class="ltx_text" style="font-size:90%;">68.8</span></td>
<td id="S4.T3.5.1.3.6" class="ltx_td ltx_align_center"><span id="S4.T3.5.1.3.6.1" class="ltx_text" style="font-size:90%;">69.9</span></td></tr>
