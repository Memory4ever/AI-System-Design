<th id="S4.T3.3.1.2.1" class="ltx_td ltx_align_left ltx_th ltx_th_column ltx_th_row" style="padding-left:8.0pt;padding-right:8.0pt;"><span id="S4.T3.3.1.2.1.1" class="ltx_text ltx_font_bold">Probing Method</span></th>
<th id="S4.T3.3.1.2.2" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_t" style="padding-left:8.0pt;padding-right:8.0pt;"><span id="S4.T3.3.1.2.2.1" class="ltx_text ltx_font_bold">K400 <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib28" title="" class="ltx_ref">28</a>]</cite></span></th>
