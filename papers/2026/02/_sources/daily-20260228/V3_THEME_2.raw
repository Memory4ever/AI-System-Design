{"data":[{"id":"10.48550/arxiv.2602.22755","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.22755","identifiers":[{"identifier":"2602.22755","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Abhay","familyName":"Sheshadri","name":"Sheshadri, Abhay","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Aidan","familyName":"Ewart","name":"Ewart, Aidan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Elias","familyName":"Kempf","name":"Kempf, Elias","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Kai","familyName":"Fronsdal","name":"Fronsdal, Kai","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Isha","familyName":"Gupta","name":"Gupta, Isha","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Simon","familyName":"Schrodi","name":"Schrodi, Simon","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Arthur","familyName":"Conmy","name":"Conmy, Arthur","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Samuel R.","familyName":"Bowman","name":"Bowman, Samuel R.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Sara","familyName":"Price","name":"Price, Sara","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Samuel","familyName":"Marks","name":"Marks, Samuel","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Rowan","familyName":"Wang","name":"Wang, Rowan","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"AuditBench: Evaluating Alignment Auditing Techniques on Models with Hidden Behaviors"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-26T08:43:07Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:32:59Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-03-03T06:42:39Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-03-04T01:29:43Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-03-09T18:35:46Z","dateType":"Submitted","dateInformation":"v3"},{"date":"2026-03-11T00:04:32Z","dateType":"Updated","dateInformation":"v3"},{"date":"2026-10-01T00:44:05Z","dateType":"Submitted","dateInformation":"v4"},{"date":"2026-10-02T00:30:43Z","dateType":"Updated","dateInformation":"v4"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"4","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"We introduce AuditBench, an alignment auditing benchmark. AuditBench consists of 56 language models with implanted hidden behaviors. Each model has one of 14 concerning behaviors--such as sycophantic deference, opposition to AI regulation, or secret geopolitical loyalties--which it does not confess to when directly asked. AuditBench models are highly diverse--some are subtle, while others are overt, and we use varying training techniques both for implanting behaviors and training models not to confess. To demonstrate AuditBench's utility, we develop an investigator agent that autonomously employs a configurable set of auditing tools. By measuring investigator agent success using different tools, we can evaluate their efficacy. Notably, we observe a tool-to-agent gap, where tools that perform well in standalone non-agentic evaluations fail to translate into improved performance when used with our investigator agent. We find that our most effective tools involve scaffolded calls to auxiliary models that generate diverse prompts for the target. White-box interpretability tools can be helpful, but the agent performs best with black-box tools. We also find that audit success varies greatly across training techniques: models trained on synthetic documents are easier to audit than models trained on demonstrations, with better adversarial training further increasing auditing difficulty. We release our models, agent, and evaluation framework to support future quantitative, iterative science on alignment auditing."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.22755","contentUrl":null,"metadataVersion":3,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":2,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T02:53:52Z","registered":"2026-02-27T02:53:52Z","published":null,"updated":"2026-10-02T03:30:13Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.22673","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.22673","identifiers":[{"identifier":"2602.22673","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Md Tanvir Hasan","familyName":"Turja","name":"Turja, Md Tanvir Hasan","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Forecasting Bacterial Antimicrobial Resistance Trends Using Machine Learning on WHO GLASS Surveillance Data: A Retrieval-Augmented Generation Approach for Policy Decision Support"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"Quantitative Methods (q-bio.QM)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"FOS: Biological sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-26T06:45:08Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:28:32Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-06-13T19:25:09Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-06-16T00:41:24Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-09-26T19:02:48Z","dateType":"Submitted","dateInformation":"v3"},{"date":"2026-10-01T20:04:28Z","dateType":"Updated","dateInformation":"v3"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"3","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Background: Antimicrobial resistance (AMR) is a global health threat. While the WHO Global Antimicrobial Resistance and Use Surveillance System (GLASS) provides standardized data, population-level machine learning forecasting of resistance trends remains limited. Translating forecasts into policy also requires transparent interpretation. Methods: Surveillance data (2021-2023) comprising 5,909 observations across 44 countries and five WHO regions were processed. Six models (Naive, Linear, Ridge, XGBoost, LightGBM, LSTM) were benchmarked to forecast one-year-ahead resistance rates using prior-year resistance, antibiotic consumption, and related features. MAE, RMSE, and sMAPE were computed with 95% bootstrap confidence intervals for MAE. A local Retrieval-Augmented Generation (RAG) system (Gemma 4) translated forecast findings into policy guidance grounded in WHO documents. Results: XGBoost achieved the best predictive performance (test MAE = 6.13% [95% CI: 5.83-6.44]), an 85.3% error reduction versus the naive baseline (MAE = 41.79%). SHAP analysis identified prior-year resistance as the dominant predictor (50.5% gain). Regional forecast error tracked surveillance coverage, from 3.65% in the European Region to 8.61% in South-East Asia. The RAG pipeline generated source-attributed policy responses without fabricated citations. Conclusion: Short-term AMR resistance rates exhibit strong temporal autocorrelation that can be accurately forecasted using gradient boosting. Coupling these forecasts with a hallucination-resistant RAG system provides a scalable, evidence-based decision-support framework for AMR governance. v3 correction: a leakage audit found feature-construction defects; on the corrected panel a persistence forecast (MAE 5.79) significantly outperforms XGBoost (6.55), and the 85.3% claim is withdrawn (see Correction)."},{"descriptionType":"Other","description":"v3: correction. A leakage audit found four defects in the v2 feature construction; on the corrected panel a persistence forecast (MAE 5.79 pp) significantly beats XGBoost (6.55 pp, p = 0.001) and the v2 claim of an 85.3% improvement is withdrawn. See the Correction notice. Code and corrected panel: github.com/TanvirTurja/amr-forecasting-rag ; full reanalysis under journal review"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.22673","contentUrl":null,"metadataVersion":3,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T02:51:55Z","registered":"2026-02-27T02:51:55Z","published":null,"updated":"2026-10-02T03:30:12Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.23258","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.23258","identifiers":[{"identifier":"2602.23258","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Yutong","familyName":"Wang","name":"Wang, Yutong","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Siyuan","familyName":"Xiong","name":"Xiong, Siyuan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xuebo","familyName":"Liu","name":"Liu, Xuebo","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Wenkang","familyName":"Zhou","name":"Zhou, Wenkang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Liang","familyName":"Ding","name":"Ding, Liang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Miao","familyName":"Zhang","name":"Zhang, Miao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Min","familyName":"Zhang","name":"Zhang, Min","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"MASRubric: Auditing Information Flow in Multi-Agent Systems with Failure-Distilled Pitfall Rubrics"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-26T17:31:43Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:59:28Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-05-28T17:34:33Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-05-29T01:25:49Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-09-28T14:15:58Z","dateType":"Submitted","dateInformation":"v3"},{"date":"2026-09-29T03:03:33Z","dateType":"Updated","dateInformation":"v3"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"3","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"While multi-agent systems (MAS) excel at complex reasoning, they are vulnerable to errors that intermediate agents introduce and downstream agents build upon. Auditing intermediate messages before they propagate requires an explicit standard, yet evaluation rubrics are typically authored by domain experts or written against a reference answer, neither of which is available for an unseen message at test time. We present MASRubric, a MAS information flow auditing framework with failure-distilled pitfall rubrics. Offline, trajectories on which the MAS has failed are automatically distilled into a reusable bank of pitfall criteria, each describing a recurrent error by its underlying misconception, the reasoning situations in which it arises, and the check that would expose it. Online, the criteria applicable to each intermediate message are retrieved from this off-the-shelf bank and checked one by one, and the resulting satisfaction rate decides whether the message is broadcast, returned to its author with diagnostic feedback for revision, or withheld. Empirical results demonstrate that MASRubric enhances MAS performance on both fixed and dynamic frameworks, achieving average accuracy gains of up to 2.83 points on math reasoning benchmarks and 1.74 points on code generation benchmarks. Further analysis shows that the retrieved criteria vary systematically with task types, and that the audit effort tracks task difficulty. Moreover, the bank transfers without re-mining to a system with a stronger backbone, which makes more adaptive and more efficient use of it. Our code and dataset are released at https://github.com/TonySY2/MASRubric."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.23258","contentUrl":null,"metadataVersion":2,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T03:06:26Z","registered":"2026-02-27T03:06:27Z","published":null,"updated":"2026-09-29T07:01:44Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.23024","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.23024","identifiers":[{"identifier":"2602.23024","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Jiahao","familyName":"Liu","name":"Liu, Jiahao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Cui","familyName":"Wenbo","name":"Wenbo, Cui","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zhongpu","familyName":"Xia","name":"Xia, Zhongpu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yongliang","familyName":"Wang","name":"Wang, Yongliang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Haoran","familyName":"Li","name":"Li, Haoran","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Dongbin","familyName":"Zhao","name":"Zhao, Dongbin","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"InCoM: Intent-Driven Perception and Structured Coordination for Mobile Manipulation"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Robotics (cs.RO)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-26T14:03:58Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:47:32Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-04-27T12:00:13Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-04-28T01:37:31Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-04-28T06:27:57Z","dateType":"Submitted","dateInformation":"v3"},{"date":"2026-04-29T00:28:47Z","dateType":"Updated","dateInformation":"v3"},{"date":"2026-04-29T09:32:01Z","dateType":"Submitted","dateInformation":"v4"},{"date":"2026-04-30T00:37:27Z","dateType":"Updated","dateInformation":"v4"},{"date":"2026-07-13T07:47:54Z","dateType":"Submitted","dateInformation":"v5"},{"date":"2026-07-14T01:13:34Z","dateType":"Updated","dateInformation":"v5"},{"date":"2026-07-21T12:50:28Z","dateType":"Submitted","dateInformation":"v6"},{"date":"2026-07-22T00:48:25Z","dateType":"Updated","dateInformation":"v6"},{"date":"2026-09-28T12:06:33Z","dateType":"Submitted","dateInformation":"v7"},{"date":"2026-09-29T02:50:49Z","dateType":"Updated","dateInformation":"v7"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"7","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Mobile manipulation is a fundamental capability for general-purpose robotic agents, requiring both coordinated control of the mobile base and manipulator and robust perception under dynamically changing viewpoints. However, existing approaches face two key challenges: strong coupling between base and arm actions complicates control optimization, and perceptual attention is often poorly allocated as viewpoints shift during mobile manipulation. We propose InCoM, an intent-driven perception and structured coordination framework for mobile manipulation. InCoM infers latent motion intent to dynamically reweight multi-scale perceptual features, enabling stage-adaptive allocation of perceptual attention. To support robust cross-modal perception, InCoM further incorporates a geometric-semantic affinity refinement mechanism that enhances multimodal correspondence. On the control side, we design a decoupled coordinated flow matching action decoder that explicitly models bidirectional base-arm interactions, alleviating optimization difficulties caused by control coupling. Under matched non-privileged observations and task-specific training data, InCoM improves mean success over DSPv2 by 33.0, 26.1, and 23.6 percentage points on SetTable, TidyHouse, and PrepareGroceries, respectively. Furthermore, its effectiveness is consistently validated in real-world mobile manipulation tasks, where InCoM maintains a superior success rate over existing baselines."},{"descriptionType":"Other","description":"The project website is available at https://liujiahao2077.github.io/InCoM.github.io"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.23024","contentUrl":null,"metadataVersion":6,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T03:00:37Z","registered":"2026-02-27T03:00:38Z","published":null,"updated":"2026-09-29T07:01:43Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.23012","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.23012","identifiers":[{"identifier":"2602.23012","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Runpeng","familyName":"Cui","name":"Cui, Runpeng","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zhipeng","familyName":"Sun","name":"Sun, Zhipeng","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Chi","familyName":"Lu","name":"Lu, Chi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Peng","familyName":"Jiang","name":"Jiang, Peng","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"RQ-Reg: A Residual-Quantization-Based Framework for Continuous Value Prediction in Recommender Systems"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Information Retrieval (cs.IR)","lang":"en","subjectScheme":"arXiv"},{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-26T13:52:54Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:46:55Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-09-24T09:38:02Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-09-25T00:43:45Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Predicting continuous values such as watch-time and gross merchandise value (GMV) is a core problem in industrial recommendation systems. Its inherent difficulty stems from the highly complex and long-tailed distributions of the target signals, which are hard to model accurately. Existing regression methods typically rely on fixed parametric assumptions on the target distribution: overly simple assumptions underfit real-world data, whereas more intricate ones tend to sacrifice scalability and generalization. To address these limitations, we propose a sequence modeling framework based on residual quantization (RQ), in which the target continuous value is decomposed into a sequence of quantization codes that represent progressively finer approximations. The model autoregressively predicts these codes from coarse to fine granularity, with each step refining the residual error left by the previous one. To further improve the quality of the learned representations, we introduce an ordinal-aware representation learning objective that aligns the RQ code embedding space with the ordinal structure of target values, thereby yielding continuous representations of quantization codes and more accurate predictions. We conduct comprehensive experiments on public benchmarks for watch-time and lifetime value (LTV) prediction, together with a large-scale online A/B test for GMV prediction on an industrial short-video recommendation platform. Across all settings, the proposed method shows competitive performance among existing state-of-the-art approaches and generalizes well across diverse continuous value prediction scenarios."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.23012","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T03:00:21Z","registered":"2026-02-27T03:00:21Z","published":null,"updated":"2026-09-25T02:53:35Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.23006","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.23006","identifiers":[{"identifier":"2602.23006","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Arsalan","familyName":"Jawaid","name":"Jawaid, Arsalan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Abdullah","familyName":"Karatas","name":"Karatas, Abdullah","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jörg","familyName":"Seewig","name":"Seewig, Jörg","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Regular Fourier Features for Nonstationary Gaussian Processes"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Machine Learning (stat.ML)","lang":"en","subjectScheme":"arXiv"},{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-26T13:50:28Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:46:49Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-06-17T07:36:15Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-06-18T00:33:21Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-09-23T09:16:08Z","dateType":"Submitted","dateInformation":"v3"},{"date":"2026-09-24T00:44:17Z","dateType":"Updated","dateInformation":"v3"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"3","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Simulating a Gaussian process requires sampling from a high-dimensional Gaussian distribution, which scales cubically with the number of sample locations. Spectral methods address this challenge by exploiting the Fourier representation and treating the spectral density as a probability distribution suitable for Monte Carlo approximation. Although this probabilistic interpretation is valid for stationary processes, it is overly restrictive for the nonstationary case, where spectral densities are generally not probability measures. To avoid this limitation, we propose regular Fourier features for harmonizable processes with one-dimensional inputs. Our method discretizes the spectral representation directly, preserving the correlation structure among spectral weights without requiring probability assumptions. Assuming finite spectral support, this yields an efficient low-rank approximation that is positive semi-definite by construction and consistent under mild regularity conditions. When the spectral density is unknown, the framework also extends to kernel learning from data, which we explore as a proof of concept. We demonstrate the approximation on locally stationary and harmonizable mixture kernels, the latter with a complex-valued spectral density. As a feasibility study, we then apply the kernel-learning extension to real and synthetic data, where it matches competitive baselines."},{"descriptionType":"Other","description":"18 pages (including 3-page appendix), 6 figures, 3 tables. OpenReview: https://openreview.net/forum?id=2eZhxVDAhR"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.23006","contentUrl":null,"metadataVersion":2,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T03:00:12Z","registered":"2026-02-27T03:00:13Z","published":null,"updated":"2026-09-24T02:51:14Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.22453","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.22453","identifiers":[{"identifier":"2602.22453","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Shaswat","familyName":"Patel","name":"Patel, Shaswat","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Vishvesh","familyName":"Trivedi","name":"Trivedi, Vishvesh","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yue","familyName":"Han","name":"Han, Yue","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yihuai","familyName":"Hong","name":"Hong, Yihuai","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Eunsol","familyName":"Choi","name":"Choi, Eunsol","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Identifying Crucial Attention Heads for Multilingual Language Models: Retrieval and Retrieval-Transition Heads"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-25T22:28:50Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:10:20Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02-27T17:36:39Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-03-02T01:58:45Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-09-02T01:26:21Z","dateType":"Submitted","dateInformation":"v3"},{"date":"2026-09-03T00:18:28Z","dateType":"Updated","dateInformation":"v3"},{"date":"2026-09-11T19:22:24Z","dateType":"Submitted","dateInformation":"v4"},{"date":"2026-09-15T00:10:37Z","dateType":"Updated","dateInformation":"v4"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"4","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Retrieval heads, a subset of attention heads in Transformers, were studied in English, showing its crucial role in retrieving information from the context. We expand the study of retrieval heads to multilingual context and find that while nearly half of all retrieval heads are often shared across multiple languages, language-specific retrieval heads also emerge. We further design a cross-lingual needle-in-the-haystack task, to identify $\\textit{Retrieval Transition Heads (RTH)}$ that retrieve key information and further map it to target-language output. Our experiments reveal that RTHs do not always overlap with RH, and can be more vital for Chain-of-Thought reasoning in multilingual LLMs. Across four multilingual benchmarks (MMLU-ProX, MGSM, MLQA, and XQuAD) and two model families (Qwen2.5-7B Instruct and Llama3.1-8B Instruct), we demonstrate that masking RTH induces bigger performance drop than masking Retrieval Heads (RH). Specifically, for Llama3.1-8B Instruct, masking the top-25 RTHs results in an average 37.3-point drop (against 19.5-point drop from RH masking) in reasoning accuracy (MMLU-ProX, MGSM) and 9.0 F1-score reduction (against 5.1 drop for RH) in extractive QA (MLQA, XQuAD). Our work advances the understanding of multilingual LMs by isolating the attention heads responsible for mapping to target languages."},{"descriptionType":"Other","description":"Accepted to EMNLP 2026 Findings"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.22453","contentUrl":null,"metadataVersion":3,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T02:46:43Z","registered":"2026-02-27T02:46:44Z","published":null,"updated":"2026-09-15T04:45:14Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.22978","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.22978","identifiers":[{"identifier":"2602.22978","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"M. L. Pereira","familyName":"Junior","name":"Junior, M. L. Pereira","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"M. G. E.","familyName":"da Luz","name":"da Luz, M. G. E.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"P.","familyName":"Cesana","name":"Cesana, P.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"A. L.","familyName":"da Rosa","name":"da Rosa, A. L.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"M. J.","familyName":"Piotrowski","name":"Piotrowski, M. J.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"D.","familyName":"Guedes-Sobrinho","name":"Guedes-Sobrinho, D.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"T. A. S.","familyName":"Pereira","name":"Pereira, T. A. S.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"E. A.","familyName":"Moujaes","name":"Moujaes, E. A.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"A. C.","familyName":"Dias","name":"Dias, A. C.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"R. M.","familyName":"Tromer","name":"Tromer, R. M.","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Chalcogen Impurity Barriers in 2D Systems via Semi-Empirical/Machine Learning Modeling: A Survey over 4000 Materials"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Materials Science (cond-mat.mtrl-sci)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"J.2; I.6","lang":"en","subjectScheme":"ACM"},{"subject":"00-xx","lang":"en","subjectScheme":"MSC"}],"contributors":[],"dates":[{"date":"2026-02-26T13:19:19Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-09-09T01:20:18Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[{"relationType":"IsVersionOf","relatedIdentifier":"10.1021/acs.jctc.6c00350","relatedIdentifierType":"DOI"}],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Adequate characterization of two-dimensional materials with low energy barriers for impurity adsorption is key for advancing applications based on catalysis, sensing, and surface functionalization. However, first-principles methods, such as DFT, are often computationally extremely expensive for feasible large-scale screenings. Given such a scenario, we address a data-driven approach which integrates the semi-empirical Extended Huckel Method with machine learning techniques to estimate adsorption energy barriers in the case of three relevant chalcogen impurities, S, Se and Te. With this aim, we consider the 4036 2D materials found in the C2DB. The scheme employs the EHM to compute energy profiles along three in-plane migration paths, from which average barriers can be derived. The equilibrium distance between the impurity and the 2D surface is not calculated from a tie-consuming geometry optimization. Instead, it is estimated from a simple effective phenomenological expression. Physicochemical descriptors are then obtained from the Matminer library for curated features. Four different ML models are tested, with the XGBoost leading to the highest performance. We further use SHAP to verify the resulting predictions, focusing on the $\\sim1,500$ materials displaying the lowest barrier values. As it could be anticipated, we establish that the average valence electron count, electronegativity, and atomic number are typically the most relevant attributes to validate the ML model. But we also are able to determine, for the different chalcogen atoms, which other few descriptors likewise considerably influence the adsorption properties. Our results show that when combined with interpretable ML protocols, EHM can produce a scalable framework for choosing 2D structures that exhibit the desired capture/release dynamics pertinent in a variety of utilization."},{"descriptionType":"Other","description":"25 pages, 09 figures"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.22978","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":1,"created":"2026-02-27T02:59:29Z","registered":"2026-02-27T02:59:29Z","published":null,"updated":"2026-09-09T05:59:51Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.22371","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.22371","identifiers":[{"identifier":"2602.22371","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Albani","familyName":"Olivieri","name":"Olivieri, Albani","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Gleb","familyName":"Pogudin","name":"Pogudin, Gleb","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Boris","familyName":"Kramer","name":"Kramer, Boris","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Quadratization of Autonomous Partial Differential Equations: Algorithmic Solutions"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Symbolic Computation (cs.SC)","lang":"en","subjectScheme":"arXiv"},{"subject":"Mathematical Software (cs.MS)","lang":"en","subjectScheme":"arXiv"},{"subject":"Numerical Analysis (math.NA)","lang":"en","subjectScheme":"arXiv"},{"subject":"Dynamical Systems (math.DS)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-25T20:08:07Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:06:04Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-09-04T19:40:24Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-09-09T00:08:28Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Quadratization for partial differential equations (PDEs) is a process that formally transforms a PDE with a nonquadratic right-hand side into a quadratic form by introducing auxiliary variables. Even though the existence and uniqueness of the solution of this quadratic form are, as of yet, unknown in the general case, this symbolic transformation has been used in diverse fields to simplify the analysis, simulation, and control of PDE models. This paper presents a rigorous definition of PDE quadratization, a sample case study on the solutions of quadratic representations, and theoretical contributions for the PDE quadratization problem of spatially one-dimensional PDEs, including results on existence and complexity. Its main focus, however, is introducing and analyzing QuPDE, an algorithm based on symbolic computation and discrete optimization that outputs a quadratization for any spatially one-dimensional polynomial or rational PDE. This algorithm is the first computational tool to find quadratizations for PDEs to date. We demonstrate QuPDE's performance by applying it to fourteen nonquadratic PDEs in diverse areas such as fluid mechanics, space physics, chemical engineering, and biological processes. QuPDE delivers a low-order quadratization in each case, uncovering quadratic transformations with fewer auxiliary variables than those previously discovered in the literature for some examples, and finding quadratizations for systems that had not been transformed to quadratic form before."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.22371","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T02:44:51Z","registered":"2026-02-27T02:44:51Z","published":null,"updated":"2026-09-09T05:59:49Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.23038","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.23038","identifiers":[{"identifier":"2602.23038","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Eiji","familyName":"Kawase","name":"Kawase, Eiji","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Shuta","familyName":"Kikuchi","name":"Kikuchi, Shuta","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Hideaki","familyName":"Tamai","name":"Tamai, Hideaki","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Shu","familyName":"Tanaka","name":"Tanaka, Shu","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Parallelizable Search-Space Decomposition for Large-Scale Combinatorial Optimization Problems Using Ising Machines"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Emerging Technologies (cs.ET)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-26T14:23:22Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-09-07T00:26:57Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[{"relationType":"IsVersionOf","relatedIdentifier":"10.1038/s41598-026-57443-z","relatedIdentifierType":"DOI"}],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Combinatorial optimization problems are crucial in industry. However, many COPs are NP-hard, causing the search space to grow exponentially with problem size and rendering large-scale instances computationally intractable. Conventional solvers typically treat problems as monolithic entities, leading to significant efficiency degradation as structural complexity increases. To address this issue, we propose a novel search-space decomposition method that leverages the inherent structure of variables to systematically reduce the size of the master problem. We formulate interaction costs between variables and individual variable costs as a constrained maximum cut problem and convert it into a quadratic unconstrained binary optimization formulation using penalty terms. An Ising-model solver is used to rapidly decompose the problem into independent small-scale subproblems, which are subsequently solved in parallel using mathematical optimization solvers. We validated this method on the capacitated vehicle routing problem. Results demonstrate three significant benefits: a substantial enhancement in feasible solution rates, accelerated convergence, achieving in 1 min the accuracy that the naive method required 30 min to reach, and a variable reduction of up to 95.32\\%. These findings suggest that search-space decomposition is a promising strategy for efficiently solving large-scale combinatorial optimization problems."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.23038","contentUrl":null,"metadataVersion":2,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":1,"created":"2026-02-27T03:00:57Z","registered":"2026-02-27T03:00:58Z","published":null,"updated":"2026-09-07T02:18:28Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.22997","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.22997","identifiers":[{"identifier":"2602.22997","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Merle","familyName":"Backmeyer","name":"Backmeyer, Merle","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Laura A. M.","familyName":"D'Angelo","name":"D'Angelo, Laura A. M.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Brahim","familyName":"Ramdane","name":"Ramdane, Brahim","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Sebastian","familyName":"Schöps","name":"Schöps, Sebastian","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"A Reduced Magnetic Vector Potential Approach with Higher-Order Splines"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Numerical Analysis (math.NA)","lang":"en","subjectScheme":"arXiv"},{"subject":"Computational Engineering, Finance, and Science (cs.CE)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-26T13:39:00Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:46:08Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-08-28T10:13:28Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-08-31T00:40:07Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[{"relationType":"IsVersionOf","relatedIdentifier":"10.1109/tmag.2026.3716008","relatedIdentifierType":"DOI"}],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"This work presents a high-order isogeometric formulation for magnetoquasistatic eddy-current problems based on a decomposition into Biot-Savart-driven source fields and finite-element reaction fields. Building upon a recently proposed surface-only Biot-Savart evaluation, we generalize the reduced magnetic vector potential framework to the quasistatic regime and introduce a consistent high-order spline discretization. The resulting method avoids coil meshing, supports arbitrary winding paths, and enables high-order field approximation within a reduced computational domain. Beyond establishing optimal convergence rates, the numerical investigation identifies the requirements necessary to recover high-order accuracy in practice, including geometric regularity of the enclosing interface, accurate kernel quadrature, and compatible trace spaces for the source-reaction coupling."},{"descriptionType":"Other","description":"7 pages, 6 figures"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.22997","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":1,"created":"2026-02-27T02:59:58Z","registered":"2026-02-27T02:59:59Z","published":null,"updated":"2026-08-31T02:22:34Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.23323","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.23323","identifiers":[{"identifier":"2602.23323","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Claire","familyName":"Walton","name":"Walton, Claire","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Isaac","familyName":"Kaminer","name":"Kaminer, Isaac","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Qi","familyName":"Gong","name":"Gong, Qi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Abram H.","familyName":"Clark","name":"Clark, Abram H.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Theodoros","familyName":"Tsatsanifos","name":"Tsatsanifos, Theodoros","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Modeling Large-Scale Adversarial Swarm Engagements using Optimal Control"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Optimization and Control (math.OC)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-26T18:32:07Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T02:02:44Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-08-18T17:33:52Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-08-19T01:06:39Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"We study optimal control of large-scale autonomous systems under adversarial conditions in which agents may be probabilistically destroyed during an engagement. Because attrition changes the population that generates the spatial interaction dynamics, treating survival and motion independently can produce physically inconsistent solutions. We formulate a stochastic variable-population benchmark and examine three deterministic approximations that propagate agent survival probabilities from relative geometry. The models are applied to defense of a high-value unit against an attacking swarm and solved using direct optimal-control methods. Monte Carlo realizations of the stochastic benchmark show that deterministic models can reproduce engagement outcomes when attrition is coupled to spatial influence, whereas a decoupled formulation can exploit effectively destroyed defenders that continue to repel attackers, a failure mode we term ``ghost herding.'' Large-scale simulations and defender-number sweeps further show that this modeling choice can substantially alter predicted high-value-unit survival and inferred defensive resource requirements. The results provide a tractable framework for attrition-aware trajectory optimization and resource--survival analysis in adversarial autonomous systems."},{"descriptionType":"Other","description":"arXiv admin note: substantial text overlap with arXiv:2108.02311. substantial text overlap with arXiv:2108.02311"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.23323","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T03:08:01Z","registered":"2026-02-27T03:08:02Z","published":null,"updated":"2026-08-19T02:26:12Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.22531","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.22531","identifiers":[{"identifier":"2602.22531","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Yuki K.","familyName":"Wakabayashi","name":"Wakabayashi, Yuki K.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yui","familyName":"Ogawa","name":"Ogawa, Yui","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Franz Benedict","familyName":"Romero","name":"Romero, Franz Benedict","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Takuma","familyName":"Otsuka","name":"Otsuka, Takuma","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yoshitaka","familyName":"Taniyasu","name":"Taniyasu, Yoshitaka","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Interpretable self-driving sputter epitaxy: from black-box optimization to human-usable growth rules"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Materials Science (cond-mat.mtrl-sci)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-26T02:10:26Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-08-18T00:25:41Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[{"relationType":"IsVersionOf","relatedIdentifier":"10.1038/s41467-026-76533-0","relatedIdentifierType":"DOI"}],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Self-driving laboratories have emerged as powerful tools for navigating high-dimensional process spaces, yet systems remain black-box optimizers that yield limited transferable process understanding. Here, we demonstrate an interpretable self-driving laboratory framework that transforms autonomous optimization into human-usable growth rules. As a stringent benchmark, we apply this framework to RF magnetron sputtering, addressing a long-standing challenge of achieving high-quality beta-Ga2O3 heteroepitaxy and single-crystalline beta-Ga2O3 homoepitaxy via sputtering. By combining Bayesian optimization with automated optical evaluation of the Urbach energy as a metric of sub-bandgap disorder, the self-driving system efficiently identifies heteroepitaxial growth conditions yielding a minimum Urbach energy of 182 meV, the lowest value for sputtered beta-Ga2O3 films. Importantly, the optimized growth window is transferable, realizing single-crystalline beta-Ga2O3 homoepitaxy without further optimization, corroborated by scanning transmission electron microscopy. To convert the closed-loop dataset into interpretable growth rules, we train a random forest surrogate and distill it into response curves and quantified pairwise interactions across the four-dimensional growth-parameter space. This analysis identifies substrate temperature as the primary control knob, with RF power and gas flows acting largely additively and only a modest temperature-oxygen coupling delineating the narrow window for high-quality growth, establishing a general route from autonomous experimentation to transferable growth rules."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.22531","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":1,"created":"2026-02-27T02:48:32Z","registered":"2026-02-27T02:48:33Z","published":null,"updated":"2026-08-18T03:59:58Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.22456","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.22456","identifiers":[{"identifier":"2602.22456","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Ikram","familyName":"Darif","name":"Darif, Ikram","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Feifei","familyName":"Niu","name":"Niu, Feifei","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Manel","familyName":"Abdellatif","name":"Abdellatif, Manel","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Lionel C.","familyName":"Briand","name":"Briand, Lionel C.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ramesh","familyName":"S.","name":"S., Ramesh","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Arun","familyName":"Adiththan","name":"Adiththan, Arun","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Automating the Detection of Requirement Dependencies Using Large Language Models"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Software Engineering (cs.SE)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-25T22:33:27Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:10:33Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-08-14T22:30:36Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-08-18T00:11:53Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Requirements are inherently interconnected through various types of dependencies. Identifying these dependencies is essential, as they underpin critical decisions and influence a range of activities throughout software development. However, this task is challenging, particularly in modern software systems, given the high volume of complex, coupled requirements. These challenges are further exacerbated by the ambiguity of Natural Language (NL) requirements and their constant change. Consequently, requirement dependency detection is often overlooked or performed manually. Large Language Models (LLMs) exhibit strong capabilities in NL processing, presenting a promising avenue for requirement-related tasks. While they have shown to enhance various requirements engineering tasks, their effectiveness in identifying requirement dependencies remains unexplored. In this paper, we introduce LEREDD, an LLM-based approach for automated detection of requirement dependencies that leverages Retrieval-Augmented Generation (RAG) and In-Context Learning (ICL). It is designed to identify diverse dependency types directly from NL requirements. We empirically evaluate LEREDD against two state-of-the-art baselines. The results show that LEREDD provides highly accurate classification of dependent and non-dependent requirements, achieving an accuracy of 0.93, and an F1 score of 0.84, with the latter averaging 0.96 for non-dependent cases. LEREDD outperforms zero-shot LLMs and baselines, particularly in detecting fine-grained dependency types, where it yields average relative gains of 94.87% and 105.41% in F1 scores for the Requires dependency over the baselines. We also provide an annotated dataset of requirement dependencies encompassing 813 requirement pairs across three distinct systems to support reproducibility and future research."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.22456","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T02:46:47Z","registered":"2026-02-27T02:46:48Z","published":null,"updated":"2026-08-18T03:59:58Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.22315","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.22315","identifiers":[{"identifier":"2602.22315","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Nilanjan","familyName":"Sasmal","name":"Sasmal, Nilanjan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Adolfo","familyName":"del Campo","name":"del Campo, Adolfo","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Taxonomy of integrable and ground-state solvable models: Jastrow wave functions on graphs and parent Hamiltonians"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Quantum Physics (quant-ph)","lang":"en","subjectScheme":"arXiv"},{"subject":"Quantum Gases (cond-mat.quant-gas)","lang":"en","subjectScheme":"arXiv"},{"subject":"Mathematical Physics (math-ph)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-25T19:00:02Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:02:43Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-06-24T14:53:17Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-06-25T01:00:12Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-08-17T14:52:58Z","dateType":"Submitted","dateInformation":"v3"},{"date":"2026-08-18T01:42:39Z","dateType":"Updated","dateInformation":"v3"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[{"relationType":"IsVersionOf","relatedIdentifier":"10.1103/g7hk-tlq1","relatedIdentifierType":"DOI"}],"relatedItems":[],"sizes":[],"formats":[],"version":"3","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"We introduce a family of many-body systems of distinguishable continuous-variable particles in which interparticle interactions are set by the adjacency matrix of a graph. The ground-state wave function of such systems is of a generalized Jastrow form involving the product of pair-correlation functions over the edge set of the graph. These systems describe quantum fluids when the graph is complete, and the pair function has a well-defined permutation symmetry. In general, they provide the continuous-variable generalization of spin systems on graphs, with broken permutation symmetry. The corresponding parent Hamiltonian is shown to include (a) two-body interactions determined by the graph adjacency matrix and (b) three-body interactions over all possible 2-paths on the graph. Employing elements of graph theory, we chart the landscape of models, recovering known instances in the literature and providing numerous new examples of ground-state solvable models for which the system Hamiltonian, ground-state wave function, and corresponding energy eigenvalue are specified."},{"descriptionType":"Other","description":"13 pages, 7 figures, 8 tables, published version"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.22315","contentUrl":null,"metadataVersion":2,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":1,"created":"2026-02-27T02:43:32Z","registered":"2026-02-27T02:43:33Z","published":null,"updated":"2026-08-18T03:59:55Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.22647","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.22647","identifiers":[{"identifier":"2602.22647","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Zhengyang","familyName":"Su","name":"Su, Zhengyang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Isay","familyName":"Katsman","name":"Katsman, Isay","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yueqi","familyName":"Wang","name":"Wang, Yueqi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ruining","familyName":"He","name":"He, Ruining","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Lukasz","familyName":"Heldt","name":"Heldt, Lukasz","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Raghunandan","familyName":"Keshavan","name":"Keshavan, Raghunandan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Shao-Chuan","familyName":"Wang","name":"Wang, Shao-Chuan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xinyang","familyName":"Yi","name":"Yi, Xinyang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Mingyan","familyName":"Gao","name":"Gao, Mingyan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Onkar","familyName":"Dalal","name":"Dalal, Onkar","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Lichan","familyName":"Hong","name":"Hong, Lichan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ed","familyName":"Chi","name":"Chi, Ed","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ningren","familyName":"Han","name":"Han, Ningren","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Vectorizing the Trie: Efficient Constrained Decoding for LLM-based Generative Retrieval on Accelerators"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Information Retrieval (cs.IR)","lang":"en","subjectScheme":"arXiv"},{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-26T06:00:56Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:26:28Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-07-20T21:24:06Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-08-17T00:17:10Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[{"relationType":"IsVersionOf","relatedIdentifier":"10.1145/3770855.3818506","relatedIdentifierType":"DOI"}],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Generative retrieval has emerged as a powerful paradigm for LLM-based recommendation. However, industrial recommender systems often benefit from restricting the output space to a constrained subset of items based on business logic (e.g. enforcing content freshness or product category), which standard autoregressive decoding cannot natively support. Moreover, existing constrained decoding methods that make use of prefix trees (Tries) incur severe latency penalties on hardware accelerators (TPUs/GPUs). In this work, we introduce STATIC (Sparse Transition Matrix-Accelerated Trie Index for Constrained Decoding), an efficient and scalable constrained decoding technique designed specifically for high-throughput LLM-based generative retrieval on TPUs/GPUs. By flattening the prefix tree into a static Compressed Sparse Row (CSR) matrix, we transform irregular tree traversals into fully vectorized sparse matrix operations, unlocking massive efficiency gains on hardware accelerators. We deploy STATIC on a large-scale industrial video recommendation platform serving billions of users. STATIC produces significant product metric impact with minimal latency overhead (0.033 ms per step and 0.25% of inference time), achieving a 948x speedup over a CPU trie implementation and a 47-1033x speedup over a hardware-accelerated binary-search baseline. Furthermore, the runtime overhead of STATIC remains extremely low across a wide range of practical configurations. To the best of our knowledge, STATIC enables the first production-scale deployment of strictly constrained generative retrieval. In addition, evaluation on academic benchmarks demonstrates that STATIC can considerably improve cold-start performance for generative retrieval. Our code is available at https://github.com/youtube/static-constraint-decoding."},{"descriptionType":"Other","description":"KDD 2026 camera-ready"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.22647","contentUrl":null,"metadataVersion":3,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":1,"created":"2026-02-27T02:51:18Z","registered":"2026-02-27T02:51:18Z","published":null,"updated":"2026-08-17T02:07:53Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.22878","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.22878","identifiers":[{"identifier":"2602.22878","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Debraj","familyName":"Das","name":"Das, Debraj","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Andrea","familyName":"Gambassi","name":"Gambassi, Andrea","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Stefano","familyName":"Iubini","name":"Iubini, Stefano","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Stefano","familyName":"Lepri","name":"Lepri, Stefano","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Dephasing-induced relaxation in tight-binding chains with linear and nonlinear defects"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Statistical Mechanics (cond-mat.stat-mech)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-26T11:16:29Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:39:45Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-08-08T09:13:02Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-08-14T00:50:21Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[{"relationType":"IsVersionOf","relatedIdentifier":"10.1103/gjkp-21dh","relatedIdentifierType":"DOI"}],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"We investigate thermalization in a tight-binding chain with an on-site defect subject to local dephasing noise implemented as random phase kicks. For a single linear defect of strength $ε$, we obtain an exact analytical description of the system spectrum and formulate the dephasing-induced dynamics in the eigenstate basis. We derive an approximate kinetic equation for mode populations that describes a continuous-time random walk in action space. The walk transition rates are defined by the overlap matrix encoding the spatial structure of eigenstates that can be computed exactly. Analyzing the spectral properties of the equation, we show that defect-induced localized modes act as bottlenecks that strongly slow down relaxation, with rates scaling as $ε^{-2}$ for strong defects. Using large-deviation theory, we characterize rare dynamical trajectories and identify distinct relaxation pathways associated with low- and high-activity regimes in action space. We provide numerical evidence that the large-deviation function exhibits a dynamical phase transition in the limit $ε\\to \\infty$. We then extend our analysis to the nonlinear case, considering a single nonlinear defect embedded in either a linear or a fully nonlinear discrete Schrödinger equation. Numerical simulations reveal a qualitatively faster approach to equilibrium than in the corresponding linear-defect model, driven by the amplitude-dependent weakening of the defect. Our results provide a unified framework for understanding thermalization, rare fluctuations, and relaxation pathways in stochastic tight-binding systems."},{"descriptionType":"Other","description":"v1: 17 pages, 10 figures; v2: 17 pages, 10 figures, accepted for publication in Phys. Rev. E"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.22878","contentUrl":null,"metadataVersion":2,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":1,"created":"2026-02-27T02:56:59Z","registered":"2026-02-27T02:56:59Z","published":null,"updated":"2026-08-14T02:24:58Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.22852","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.22852","identifiers":[{"identifier":"2602.22852","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","affiliation":["Umeå University"],"givenName":"Oliver","familyName":"Larsson","name":"Larsson, Oliver","nameIdentifiers":[]},{"nameType":"Personal","affiliation":["Unaffiliated"],"givenName":"Thijs","familyName":"Metsch","name":"Metsch, Thijs","nameIdentifiers":[]},{"nameType":"Personal","affiliation":["Umeå University"],"givenName":"Cristian","familyName":"Klein","name":"Klein, Cristian","nameIdentifiers":[]},{"nameType":"Personal","affiliation":["Umeå University"],"givenName":"Erik","familyName":"Elmroth","name":"Elmroth, Erik","nameIdentifiers":[]}],"titles":[{"title":"Workload Buoyancy: Keeping Apps Afloat by Identifying Shared Resource Bottlenecks"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Distributed, Parallel, and Cluster Computing (cs.DC)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-26T10:39:57Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:38:25Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-08-12T13:43:55Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-08-13T00:46:20Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Modern multi-tenant, hardware-heterogeneous computing environments pose significant challenges for effective workload orchestration. Simple heuristics for assessing workload performance, such as CPU utilization or application-level metrics, are often insufficient to capture the complex performance dynamics arising from resource contention and noisy-neighbor effects. In such environments, performance bottlenecks may emerge in any shared system resource, leading to unexpected and difficult-to-diagnose degradation.\n This paper introduces buoyancy, a novel abstraction for characterizing workload performance in multi-tenant systems. Unlike traditional approaches, buoyancy integrates application-level metrics with system-level insights of shared resource contention to provide a holistic view of performance dynamics. By explicitly capturing bottlenecks and headroom across multiple resources, buoyancy facilitates resource-aware and application-aware orchestration in a manner that is intuitive, extensible, and generalizable across heterogeneous platforms. We evaluate buoyancy using representative multi-tenant workloads to illustrate its ability to expose performance-limiting resource interactions. Buoyancy provides a 19.3% better indication of bottlenecks compared to traditional heuristics on average. We additionally show how buoyancy can act as a drop-in replacement for conventional performance metrics, enabling improved observability and more informed scheduling and optimization decisions."},{"descriptionType":"Other","description":"14 pages, 10 figures, 4 tables"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.22852","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T02:56:22Z","registered":"2026-02-27T02:56:23Z","published":null,"updated":"2026-08-13T02:13:01Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.22895","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.22895","identifiers":[{"identifier":"2602.22895","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Bruno","familyName":"Aristimunha","name":"Aristimunha, Bruno","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ce","familyName":"Ju","name":"Ju, Ce","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Antoine","familyName":"Collas","name":"Collas, Antoine","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Florent","familyName":"Bouchard","name":"Bouchard, Florent","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ammar","familyName":"Mian","name":"Mian, Ammar","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Bertrand","familyName":"Thirion","name":"Thirion, Bertrand","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Sylvain","familyName":"Chevallier","name":"Chevallier, Sylvain","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Reinmar","familyName":"Kobler","name":"Kobler, Reinmar","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"SPD Learn: A Geometric Deep Learning Python Library for Neural Decoding Through Trivialization"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Neurons and Cognition (q-bio.NC)","lang":"en","subjectScheme":"arXiv"},{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Biological sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-26T11:33:21Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:40:29Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-08-10T10:52:17Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-08-11T01:43:22Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Implementations of symmetric positive definite (SPD) matrix-based neural networks for neural decoding remain fragmented across research codebases and Python packages. Existing implementations often employ ad hoc handling of manifold constraints and non-unified training setups, which hinders reproducibility and integration into modern deep-learning workflows. To address this gap, we introduce SPD Learn, a unified and modular Python package for geometric deep learning with SPD matrices. SPD Learn provides core SPD operators and neural-network layers, including numerically stable spectral operators, and enforces Stiefel/SPD constraints via trivialization-based parameterizations. This design enables standard backpropagation and optimization in unconstrained Euclidean spaces while producing manifold-constrained parameters by construction. The package also offers reference implementations of representative SPDNet-based models and interfaces with widely used brain computer interface/neuroimaging toolkits and modern machine-learning libraries (e.g., MOABB, Braindecode, Nilearn, and SKADA), facilitating reproducible benchmarking and practical deployment."},{"descriptionType":"Other","description":"9 Pages"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.22895","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T02:57:22Z","registered":"2026-02-27T02:57:23Z","published":null,"updated":"2026-08-11T04:17:01Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.22632","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.22632","identifiers":[{"identifier":"2602.22632","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Jiawei","familyName":"Feng","name":"Feng, Jiawei","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xiaoyu","familyName":"Kong","name":"Kong, Xiaoyu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Leheng","familyName":"Sheng","name":"Sheng, Leheng","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Bin","familyName":"Wu","name":"Wu, Bin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Chao","familyName":"Yi","name":"Yi, Chao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Feifang","familyName":"Yang","name":"Yang, Feifang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xiang-Rong","familyName":"Sheng","name":"Sheng, Xiang-Rong","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Han","familyName":"Zhu","name":"Zhu, Han","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xiang","familyName":"Wang","name":"Wang, Xiang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jiancan","familyName":"Wu","name":"Wu, Jiancan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xiangnan","familyName":"He","name":"He, Xiangnan","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Fine-grained Semantics Integration for Large Language Model-based Recommendation"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Information Retrieval (cs.IR)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-26T05:17:24Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:25:04Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02-28T11:32:44Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-03-03T01:38:43Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-08-09T07:07:16Z","dateType":"Submitted","dateInformation":"v3"},{"date":"2026-08-11T00:56:53Z","dateType":"Updated","dateInformation":"v3"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"3","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Recent advances in Large Language Models (LLMs) have driven a shift in recommender systems from the discriminative paradigm to the LLM-based generative paradigm, where the recommender autoregressively generates sequences of semantic identifiers (SIDs) for target items conditioned on historical interaction. While prevalent LLM-based recommenders have demonstrated performance gains by aligning pretrained LLMs between the language space and the SID space, modeling the SID space still faces two fundamental challenges: (i) Semantically Meaningless Initialization: SID tokens are initialized by random sampling without incorporating token-specific semantics, leaving them without explicit semantic correspondence to the pretrained language space; and (ii) Coarse-grained Alignment: existing SFT-based alignment tasks primarily focus on item-level optimization while overlooking the semantics of individual tokens within SID sequences. To address these challenges, we propose TS-Rec, which can integrate Token-level Semantics into LLM-based Recommenders. Specifically, TS-Rec comprises two key components: (1) Semantic-Aware Embedding Initialization (SA-Init), which initializes SID token embeddings by applying mean pooling to the pretrained embeddings of keywords extracted by a teacher model; and (2) Token-level Semantic Alignment (TS-Align), which aligns individual tokens within the SID sequence with the shared semantics of the corresponding item clusters. Extensive experiments on three real-world benchmarks demonstrate that TS-Rec consistently outperforms traditional and generative baselines across all standard metrics. These findings confirm the effectiveness of incorporating fine-grained semantic information into LLM-based generative recommenders. The implementation is available at https://anonymous.4open.science/r/TS-Rec-Review-8F99/."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.22632","contentUrl":null,"metadataVersion":2,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T02:50:56Z","registered":"2026-02-27T02:50:57Z","published":null,"updated":"2026-08-11T04:16:58Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.23297","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.23297","identifiers":[{"identifier":"2602.23297","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Yiqing","familyName":"Wang","name":"Wang, Yiqing","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Chunming","familyName":"He","name":"He, Chunming","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ziyun","familyName":"Yang","name":"Yang, Ziyun","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Maria","familyName":"Woodward","name":"Woodward, Maria","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ming-Chen","familyName":"Lu","name":"Lu, Ming-Chen","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Mercy","familyName":"Pawar","name":"Pawar, Mercy","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Leslie","familyName":"Niziol","name":"Niziol, Leslie","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Sina","familyName":"Farsiu","name":"Farsiu, Sina","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"PRIMA: Pre-Training with Risk-Integrated Image--Metadata Alignment for Medical Diagnosis with LLM-Based Feature Aggregation"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-26T18:07:52Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T02:01:23Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-07-04T00:47:22Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-07-07T01:03:51Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-07-28T06:47:55Z","dateType":"Submitted","dateInformation":"v3"},{"date":"2026-07-29T00:29:34Z","dateType":"Updated","dateInformation":"v3"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"3","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Medical diagnosis requires the effective synthesis of visual manifestations and clinical metadata. However, existing methods often treat metadata as isolated tags, failing to exploit the rich semantic knowledge embedded in clinical descriptions. We propose PRIMA (Pre-training with Risk-integrated Image-Metadata Alignment), a framework that integrates domain-specific knowledge into multi-modal representation learning. We first curate a corpus of risk--disease correlations via Retrieval-Augmented Generation (RAG) to refine Clinical ModernBERT, embedding diagnostic priors into the text encoder. To bridge the modality gap, we introduce a dual-encoder pre-training strategy utilizing DINOv3 and our refined Clinical ModernBERT, optimized by a suite of four complementary loss functions. These losses are designed to capture multi-granular semantic alignment and handle the ambiguity of clinical correlations through soft labels. Finally, we leverage Qwen3 to fuse these aligned features for precise disease classification. Extensive experiments demonstrate that PRIMA effectively harmonizes pixel-level features with abstract clinical expertise. Across PAD-UFES-20 and AQUA, PRIMA achieves average F1-scores of 72.04\\% and 85.22\\%, outperforming strong image-only, metadata-fusion, and medical vision-language baselines. Notably, our framework achieves strong performance without requiring massive data collection or exhaustive computational resources. Our code is available at https://github.com/yqwang01/PRIMA."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.23297","contentUrl":null,"metadataVersion":2,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T03:07:25Z","registered":"2026-02-27T03:07:25Z","published":null,"updated":"2026-07-29T02:29:54Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.22229","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.22229","identifiers":[{"identifier":"2602.22229","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Lohit","familyName":"Daksha","name":"Daksha, Lohit","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Seyda","familyName":"Guzelhan","name":"Guzelhan, Seyda","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Kaustubh","familyName":"Shivdikar","name":"Shivdikar, Kaustubh","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Carlos Agulló","familyName":"Domingo","name":"Domingo, Carlos Agulló","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Óscar Vera","familyName":"Lopez","name":"Lopez, Óscar Vera","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Gilbert","familyName":"Jonatan","name":"Jonatan, Gilbert","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Hubert","familyName":"Dymarkowski","name":"Dymarkowski, Hubert","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Aymane El","familyName":"Jerari","name":"Jerari, Aymane El","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"José","familyName":"Cano","name":"Cano, José","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"José L.","familyName":"Abellán","name":"Abellán, José L.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"John","familyName":"Kim","name":"Kim, John","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"David","familyName":"Kaeli","name":"Kaeli, David","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ajay","familyName":"Joshi","name":"Joshi, Ajay","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"FHECore: Rethinking GPU Microarchitecture for Fully Homomorphic Encryption"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Hardware Architecture (cs.AR)","lang":"en","subjectScheme":"arXiv"},{"subject":"Cryptography and Security (cs.CR)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-10T02:55:10Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:00:31Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-07-28T17:21:05Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-07-29T01:06:38Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Fully Homomorphic Encryption (FHE) enables computation directly on encrypted data but incurs massive computational and memory overheads, often exceeding plaintext execution by several orders of magnitude. While custom ASIC accelerators can mitigate these costs, their long time-to-market and the rapid evolution of FHE algorithms threaten their long-term relevance. GPUs, by contrast, offer scalability, programmability, and widespread availability, making them an attractive platform for FHE. However, modern GPUs are increasingly specialized for machine learning workloads, emphasizing low-precision datatypes (e.g., INT$8$, FP$8$) that are fundamentally mismatched to the wide-precision modulo arithmetic required by FHE. Essentially, while GPUs offer ample parallelism, their functional units, like Tensor Cores, are not suited for wide-integer modulo arithmetic required by FHE schemes such as CKKS. Despite this constraint, researchers have attempted to map FHE primitives on Tensor Cores by segmenting wide integers into low-precision (INT$8$) chunks.\n To overcome these bottlenecks, we propose FHECore, a specialized functional unit integrated directly into the GPU's Streaming Multiprocessor. Our design is motivated by a key insight: the two dominant contributors to latency$-$Number Theoretic Transform and Base Conversion$-$can be formulated as modulo-linear transformations. This allows them to be mapped on a common hardware unit that natively supports wide-precision modulo-multiply-accumulate operations. Our simulations demonstrate that FHECore reduces dynamic instruction count by a geometric mean of $2.41\\times$ for CKKS primitives and $1.96\\times$ for end-to-end workloads. These reductions translate to performance speedups of $1.57\\times$ and $2.12\\times$, respectively$-$including a $50\\%$ reduction in bootstrapping latency$-$all while inuring a modest $2.4\\%$ area overhead."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.22229","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T02:41:32Z","registered":"2026-02-27T02:41:33Z","published":null,"updated":"2026-07-29T02:29:53Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.23357","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.23357","identifiers":[{"identifier":"2602.23357","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Aheli","familyName":"Saha","name":"Saha, Aheli","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"René","familyName":"Schuster","name":"Schuster, René","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Didier","familyName":"Stricker","name":"Stricker, Didier","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Sensor Generalization for Adaptive Sensing in Event-based Object Detection via Joint Distribution Training"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-26T18:57:52Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-07-21T00:29:51Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[{"relationType":"IsVersionOf","relatedIdentifier":"10.5220/0014450400004067","relatedIdentifierType":"DOI"}],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Bio-inspired event cameras have recently attracted significant research due to their asynchronous and low-latency capabilities. These features provide a high dynamic range and significantly reduce motion blur. However, because of the novelty in the nature of their output signals, there is a gap in the variability of available data and a lack of extensive analysis of the parameters characterizing their signals. This paper addresses these issues by providing readers with an in-depth understanding of how intrinsic parameters affect the performance of a model trained on event data, specifically for object detection. We also use our findings to expand the capabilities of the downstream model towards sensor-agnostic robustness."},{"descriptionType":"Other","description":"12 pages, International Conference on Pattern Recognition Applications and Methods"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.23357","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":1,"created":"2026-02-27T03:08:52Z","registered":"2026-02-27T03:08:52Z","published":null,"updated":"2026-07-21T03:47:42Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.22446","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.22446","identifiers":[{"identifier":"2602.22446","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Emilio","familyName":"Ferrara","name":"Ferrara, Emilio","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"ECHO: Encoding Communities via High-order Operators"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-25T22:14:29Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-07-21T01:34:26Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[{"relationType":"IsVersionOf","relatedIdentifier":"10.1016/j.mlwa.2026.100930","relatedIdentifierType":"DOI"}],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Community detection in attributed networks faces a fundamental divide: topological algorithms ignore semantic features, while Graph Neural Networks (GNNs) encounter devastating computational bottlenecks. Specifically, GNNs suffer from a Semantic Wall of feature over smoothing in dense or heterophilic networks, and a Systems Wall driven by the O(N^2) memory constraints of pairwise clustering. To dismantle these barriers, we introduce ECHO (Encoding Communities via High order Operators), a scalable, self supervised architecture that reframes community detection as an adaptive, multi scale diffusion process. ECHO features a Topology Aware Router that automatically analyzes structural heuristics sparsity, density, and assortativity to route graphs through the optimal inductive bias, preventing heterophilic poisoning while ensuring semantic densification. Coupled with a memory sharded full batch contrastive objective and a novel chunked O(N \\cdot K) similarity extraction method, ECHO completely bypasses traditional O(N^2) memory bottlenecks without sacrificing the mathematical precision of global gradients. Extensive evaluations demonstrate that this topology feature synergy consistently overcomes the classical resolution limit. On synthetic LFR benchmarks scaled up to 1 million nodes, ECHO achieves scale invariant accuracy despite severe topological noise. Furthermore, on massive real world social networks with over 1.6 million nodes and 30 million edges, it completes clustering in mere minutes with throughputs exceeding 2,800 nodes per second matching the speed of highly optimized purely topological baselines. The implementation utilizes a unified framework that automatically engages memory sharded optimization to support adoption across varying hardware constraints. GitHub Repository: https://github.com/emilioferrara/ECHO-GNN"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.22446","contentUrl":null,"metadataVersion":2,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":1,"created":"2026-02-27T02:46:34Z","registered":"2026-02-27T02:46:34Z","published":null,"updated":"2026-07-21T03:47:39Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.22440","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.22440","identifiers":[{"identifier":"2602.22440","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Ashley Z.","familyName":"Guo","name":"Guo, Ashley Z.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Kaelyn","familyName":"Chang","name":"Chang, Kaelyn","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Nicholas J.","familyName":"Corrente","name":"Corrente, Nicholas J.","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"An Information-theoretic Collective Variable for Configurational Entropy"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Statistical Mechanics (cond-mat.stat-mech)","lang":"en","subjectScheme":"arXiv"},{"subject":"Materials Science (cond-mat.mtrl-sci)","lang":"en","subjectScheme":"arXiv"},{"subject":"Soft Condensed Matter (cond-mat.soft)","lang":"en","subjectScheme":"arXiv"},{"subject":"Chemical Physics (physics.chem-ph)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-25T21:58:37Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:09:53Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-07-17T13:21:49Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-07-20T00:42:23Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[{"relationType":"IsVersionOf","relatedIdentifier":"10.1039/d6me00083e","relatedIdentifierType":"DOI"}],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Entropy governs molecular self-assembly, phase transitions, and material stability, yet remains challenging to quantify and directly control in molecular systems. Here, we demonstrate that the computable information density (CID), a data compression-based information theoretic metric, provides a general per-configuration structural descriptor that tracks configurational entropy changes in molecular dynamics simulations, reflecting both local and long-range structural organization. We validate the CID across systems of increasing complexity, beginning with single-component Lennard-Jones melting before examining binary phase separation, polymer condensation and dispersion, and assembly of amorphous carbon networks at multiple densities. Unlike conventional order parameters, CID requires no a priori knowledge of relevant structural features and captures organizational signatures across a variety of molecular systems and discretization resolutions. By establishing a data compression-based structural complexity metric as a practical proxy for configurational entropy, this framework lays a foundation for future entropy-driven materials design and optimization strategies."},{"descriptionType":"Other","description":"Main text: 13 pages, 7 figures; Supplemental: 4 pages, 5 figures"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.22440","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":1,"created":"2026-02-27T02:46:26Z","registered":"2026-02-27T02:46:26Z","published":null,"updated":"2026-07-20T02:24:33Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.22809","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.22809","identifiers":[{"identifier":"2602.22809","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Mingde","familyName":"Yao","name":"Yao, Mingde","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zhiyuan","familyName":"You","name":"You, Zhiyuan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"King-Man","familyName":"Tam","name":"Tam, King-Man","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Menglu","familyName":"Wang","name":"Wang, Menglu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Tianfan","familyName":"Xue","name":"Xue, Tianfan","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"PhotoAgent: Exploratory Visual Aesthetic Planning with Large Vision Models"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-26T09:46:06Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:35:58Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-03-01T10:54:03Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-03-03T02:08:40Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-07-16T09:58:43Z","dateType":"Submitted","dateInformation":"v3"},{"date":"2026-07-17T00:37:10Z","dateType":"Updated","dateInformation":"v3"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"3","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"With the recent fast development of generative models, instruction-based image editing has shown great potential in generating high-quality images. However, the quality of editing highly depends on carefully designed instructions, placing the burden of task decomposition and sequencing entirely on the user. To achieve autonomous image editing, we present PhotoAgent, a system that advances image editing through explicit aesthetic planning. Specifically, PhotoAgent formulates autonomous image editing as a long-horizon decision-making problem. It reasons over user aesthetic intent, plans multi-step editing actions via tree search, and iteratively refines results through closed-loop execution with memory and visual feedback, without requiring step-by-step user prompts. To support reliable evaluation in real-world scenarios, we introduce UGC-Edit, an aesthetic evaluation benchmark consisting of 7,000 photos and a learned aesthetic reward model. We also construct a test set containing 1,017 photos to systematically assess autonomous photo editing performance. Extensive experiments demonstrate that PhotoAgent consistently improves both instruction adherence and visual quality compared with baseline methods. The project page is https://mdyao.github.io/PhotoAgent/."},{"descriptionType":"Other","description":"ICML 2026 Oral. A fully automated, intelligent photo-editing agent that autonomously plans multi-step aesthetic enhancements, smartly chooses diverse editing tools, and enables everyday users to achieve professional-looking results without crafting complex prompts. Project page: https://mdyao.github.io/PhotoAgent/"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.22809","contentUrl":null,"metadataVersion":2,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T02:55:11Z","registered":"2026-02-27T02:55:12Z","published":null,"updated":"2026-07-17T02:36:02Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.22608","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.22608","identifiers":[{"identifier":"2602.22608","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Benjamin","familyName":"Grimmer","name":"Grimmer, Benjamin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ning","familyName":"Liu","name":"Liu, Ning","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Lower Bounds for Linear Minimization Oracle Methods Optimizing over Strongly Convex Sets"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Optimization and Control (math.OC)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-26T04:29:27Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:23:32Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-07-14T11:34:23Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-07-15T00:45:03Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"We consider the oracle complexity of constrained convex optimization given access to a Linear Minimization Oracle (LMO) for the constraint set and a gradient oracle for the $L$-smooth, $L$-strongly convex objective. This model includes Frank-Wolfe methods and their many variants. Over the problem class of $α$-strongly convex constraint sets $S$, we demonstrate that one can construct hard ``zero-chain'' instances in the classical style of Nemirovski and Yudin. From our new approach to adversarial oracle construction, we prove that no such deterministic method can guarantee a final objective gap less than $\\varepsilon$ in fewer than $Ω(\\sqrt{L\\, \\mathrm{diam}(S)^2/\\varepsilon})$ iterations. Our lower bound partly matches the accelerated Frank-Wolfe theory of Garber and Hazan (2015) of $O(\\sqrt{L(\\mathrm{diam}(S)^2+1/α^2)/\\varepsilon})$. Second, we consider optimization over $β$-smooth sets, finding that in the modestly smooth regime of $β=Ω(1/\\sqrt{\\varepsilon})$, no complexity improvement for span-based LMO methods is possible against either compact convex sets or strongly convex sets."},{"descriptionType":"Other","description":"17 pages"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.22608","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T02:50:22Z","registered":"2026-02-27T02:50:22Z","published":null,"updated":"2026-07-15T02:17:59Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.23342","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.23342","identifiers":[{"identifier":"2602.23342","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Weijian","familyName":"Chen","name":"Chen, Weijian","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Haotian","familyName":"Liu","name":"Liu, Haotian","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yangshen","familyName":"Deng","name":"Deng, Yangshen","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Long","familyName":"Xiang","name":"Xiang, Long","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Liang","familyName":"Huang","name":"Huang, Liang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Bo","familyName":"Tang","name":"Tang, Bo","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"AlayaLaser: Efficient Index Layout and Search Strategy for Large-scale High-dimensional Vector Similarity Search"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Databases (cs.DB)","lang":"en","subjectScheme":"arXiv"},{"subject":"Information Retrieval (cs.IR)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-26T18:48:29Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T02:03:20Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-05-14T05:09:37Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-05-15T00:30:39Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-05-27T05:19:46Z","dateType":"Submitted","dateInformation":"v3"},{"date":"2026-05-28T00:36:08Z","dateType":"Updated","dateInformation":"v3"},{"date":"2026-07-11T13:41:03Z","dateType":"Submitted","dateInformation":"v4"},{"date":"2026-07-14T00:29:58Z","dateType":"Updated","dateInformation":"v4"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"4","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by-sa/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution Share Alike 4.0 International","rightsIdentifier":"cc-by-sa-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"On-disk graph-based approximate nearest neighbor search (ANNS) is essential for large-scale, high-dimensional vector retrieval, yet its performance is widely recognized to be limited by the prohibitive I/O costs. Interestingly, we observed that the performance of on-disk graph-based index systems is compute-bound, not I/O-bound, with the rising of the vector data dimensionality (e.g., hundreds or thousands). This insight uncovers a significant optimization opportunity: existing on-disk graph-based index systems universally target I/O reduction and largely overlook computational overhead, which leaves a substantial performance improvement space.\n In this work, we propose AlayaLaser, an efficient on-disk graph-based index system for large-scale high-dimensional vector similarity search. In particular, we first conduct performance analysis on existing on-disk graph-based index systems via the adapted roofline model, then we devise a novel on-disk data layout in AlayaLaser to effectively alleviate the compute-bound, which is revealed by the above roofline model analysis, by exploiting SIMD instructions on modern CPUs. We next design a suite of optimization techniques (e.g., degree-based node cache, cluster-based entry point selection, and early dispatch strategy) to further improve the performance of AlayaLaser. We last conduct extensive experimental studies on a wide range of large-scale high-dimensional vector datasets to verify the superiority of AlayaLaser. Specifically, AlayaLaser not only surpasses existing on-disk graph-based index systems but also matches or even exceeds the performance of in-memory index systems."},{"descriptionType":"Other","description":"The paper has been accepted by SIGMOD 2026"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.23342","contentUrl":null,"metadataVersion":3,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T03:08:30Z","registered":"2026-02-27T03:08:30Z","published":null,"updated":"2026-07-14T04:01:54Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.23242","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.23242","identifiers":[{"identifier":"2602.23242","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Yegon","familyName":"Kim","name":"Kim, Yegon","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Juho","familyName":"Lee","name":"Lee, Juho","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"A Model-Free Universal AI"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-26T17:21:16Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:58:45Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-04-18T17:10:48Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-04-21T00:48:42Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-06-12T18:50:29Z","dateType":"Submitted","dateInformation":"v3"},{"date":"2026-06-16T00:06:24Z","dateType":"Updated","dateInformation":"v3"},{"date":"2026-07-13T16:29:31Z","dateType":"Submitted","dateInformation":"v4"},{"date":"2026-07-14T01:41:02Z","dateType":"Updated","dateInformation":"v4"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"4","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"In general reinforcement learning, all established optimal agents, including AIXI, are model-based, explicitly maintaining and using environment models. This paper introduces Universal AI with Q-Induction (AIQI), the first model-free agent proven to be asymptotically $\\varepsilon$-optimal in general RL. AIQI performs universal induction over distributional action-value functions, instead of policies or environments like previous works. Under a grain of truth condition, we prove that AIQI is strong asymptotically $\\varepsilon$-optimal and asymptotically $\\varepsilon$-Bayes-optimal. We also apply our novel proof techniques to show asymptotic $\\varepsilon$-optimality of Self-AIXI without any ad-hoc assumptions. Our results significantly expand the diversity of known universal agents."},{"descriptionType":"Other","description":"42nd Conference on Uncertainty in Artificial Intelligence (UAI 2026)"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.23242","contentUrl":null,"metadataVersion":3,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T03:06:02Z","registered":"2026-02-27T03:06:03Z","published":null,"updated":"2026-07-14T04:01:52Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.22776","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.22776","identifiers":[{"identifier":"2602.22776","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Simone","familyName":"Gasperini","name":"Gasperini, Simone","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Gianluca","familyName":"Bianco","name":"Bianco, Gianluca","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Marco","familyName":"Lorusso","name":"Lorusso, Marco","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Carla","familyName":"Rieger","name":"Rieger, Carla","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Michele","familyName":"Grossi","name":"Grossi, Michele","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Optimization-based Unfolding in High-Energy Physics"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Quantum Physics (quant-ph)","lang":"en","subjectScheme":"arXiv"},{"subject":"High Energy Physics - Experiment (hep-ex)","lang":"en","subjectScheme":"arXiv"},{"subject":"Data Analysis, Statistics and Probability (physics.data-an)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-26T09:11:34Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:34:34Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-03-06T16:05:28Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-03-09T00:54:24Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-05-12T07:45:24Z","dateType":"Submitted","dateInformation":"v3"},{"date":"2026-05-13T00:43:42Z","dateType":"Updated","dateInformation":"v3"},{"date":"2026-07-13T15:02:28Z","dateType":"Submitted","dateInformation":"v4"},{"date":"2026-07-14T01:35:36Z","dateType":"Updated","dateInformation":"v4"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"4","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"In experimental High-Energy Physics, unfolding refers to the problem of estimating the underlying distribution of a physical observable from detector-level data, in the presence of statistical fluctuations and systematic uncertainties. Starting from its reformulation as a regularized quadratic optimization problem, we develop a framework to address unfolding using both classical and quantum-compatible methods. In particular, we derive a Quadratic Unconstrained Binary Optimization (QUBO) representation of the unfolding objective, allowing direct implementation on quantum annealing and hybrid quantum-classical solvers. The proposed approach is implemented in QUnfold, an open-source Python package integrating classical mixed-integer solvers and D-Wave's hybrid quantum solver. We benchmark the method against widely used unfolding techniques in RooUnfold, including response Matrix Inversion, Iterative Bayesian Unfolding, and Singular Value Decomposition unfolding, using synthetic datasets with controlled distortion effects. Our results demonstrate that the optimization-based approach achieves competitive reconstruction accuracy across multiple distributions while naturally accommodating regularization within the objective function. This work establishes a unified optimization perspective on unfolding and provides a practical pathway for exploring quantum-enhanced methods in experimental HEP data analysis."},{"descriptionType":"Other","description":"9 pages, 2 figures"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.22776","contentUrl":null,"metadataVersion":3,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T02:54:21Z","registered":"2026-02-27T02:54:22Z","published":null,"updated":"2026-07-14T04:01:50Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.23128","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.23128","identifiers":[{"identifier":"2602.23128","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Mathieu","familyName":"Bazinet","name":"Bazinet, Mathieu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Valentina","familyName":"Zantedeschi","name":"Zantedeschi, Valentina","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Pascal","familyName":"Germain","name":"Germain, Pascal","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Bound to Disagree: Generalization Bounds via Certifiable Surrogates"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-26T15:42:13Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T03:33:34Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-07-07T21:35:02Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-07-09T00:08:57Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Generalization bounds for deep learning models are typically vacuous, not computable or restricted to specific model classes. In this paper, we tackle these issues by providing new disagreement-based certificates for the gap between the true risk of any two predictors. We then bound the true risk of the predictor of interest via a surrogate model that enjoys tight generalization guarantees, and by evaluating our disagreement bound on an unlabeled dataset.We empirically demonstrate the tightness of the obtained certificates and showcase the versatility of the approach by training surrogate models leveraging three different frameworks: sample compression, model compression and PAC-Bayes theory. Importantly, such guarantees are achieved without modifying the target model, nor adapting the training procedure to the generalization framework."},{"descriptionType":"Other","description":"Published in the 42nd conference on Uncertainty in Artificial Intelligence"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.23128","contentUrl":null,"metadataVersion":2,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T03:03:05Z","registered":"2026-02-27T03:03:06Z","published":null,"updated":"2026-07-09T02:04:30Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.22600","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.22600","identifiers":[{"identifier":"2602.22600","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Joshua S.","familyName":"Schiffman","name":"Schiffman, Joshua S.","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Transformers converge to invariant algorithmic cores"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-26T04:09:11Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:22:41Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-07-06T18:07:55Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-07-08T00:02:59Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Training selects for behavior, not circuitry: many weight configurations can implement the same function. Studying any single trained neural network thus risks describing accidents of one training run rather than the computation itself. This work shifts focus from what transformers happen to do to what they must do by extracting algorithmic cores, compact subspaces that are necessary and sufficient for a task and that recur across independently trained models. Here, Algorithmic Core Extraction (ACE) is introduced to isolate these subspaces, causally validate them, and recover the algorithms they implement across settings ranging from synthetic tasks to large-scale pretrained models. Markov-chain transformers embed three-dimensional cores in nearly orthogonal subspaces yet recover identical transition spectra. Modular-addition transformers form compact cyclic cores at grokking that later inflate under continued regularization, redundantly distributing the same computation across many functionally equivalent modes. This functional redundancy is found to accelerate the transition from memorization to generalization, yielding an inverse scaling law for grokking time. In six language models spanning more than two orders of magnitude in scale (GPT-2 Small/Medium/Large, LLaMA-3.1, Gemma-2, and Qwen2.5), subject-verb agreement is governed by a single, steerable axis that aligns across architectures. Flipping this axis inverts grammatical number throughout open-ended generation. Together these results suggest that beneath the apparent complexity of trained transformers lies a simpler, shared computational structure, and that targeting invariants rather than parameterizations may offer a more tractable path to mechanistic understanding and control.\n Code: https://github.com/joshseth/cores"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.22600","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T02:50:10Z","registered":"2026-02-27T02:50:11Z","published":null,"updated":"2026-07-08T02:11:29Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.23213","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.23213","identifiers":[{"identifier":"2602.23213","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Paul","familyName":"Ludwig","name":"Ludwig, Paul","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Timo","familyName":"Jakobs","name":"Jakobs, Timo","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Carsten","familyName":"Urbach","name":"Urbach, Carsten","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Scaling and Luescher Term in a non-Abelian (2+1)d SU$(2)$ Quantum Link Model"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"High Energy Physics - Lattice (hep-lat)","lang":"en","subjectScheme":"arXiv"},{"subject":"Quantum Physics (quant-ph)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-26T16:57:34Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:57:24Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-03-13T18:40:14Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-03-17T00:19:13Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-07-06T15:42:49Z","dateType":"Submitted","dateInformation":"v3"},{"date":"2026-07-07T02:27:33Z","dateType":"Updated","dateInformation":"v3"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[{"relationType":"IsVersionOf","relatedIdentifier":"10.1140/epjc/s10052-026-15945-0","relatedIdentifierType":"DOI"}],"relatedItems":[],"sizes":[],"formats":[],"version":"3","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"We investigate a non-Abelian SU$(2)$ quantum link model in $2+1$ dimensions on a hexagonal lattice using tensor network methods. We determine the static quark potential for a wide range of bare coupling values and find that the theory is confining. We also probe the existence of a Lüscher term and find a clear signal with a $g^2$ dependent coefficient, in qualitative agreement with a strong coupling expansion. Correspondingly, the width of the strings scales logarithmically with the string length again for all $g^2$-values, providing evidence for a rough string, with no indication for a roughening transition."},{"descriptionType":"Other","description":"v3: minor revisions to match published version"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.23213","contentUrl":null,"metadataVersion":2,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":1,"created":"2026-02-27T03:05:17Z","registered":"2026-02-27T03:05:18Z","published":null,"updated":"2026-07-07T05:03:55Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.23148","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.23148","identifiers":[{"identifier":"2602.23148","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Nitin","familyName":"Gupta","name":"Gupta, Nitin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Vishal","familyName":"Pallagani","name":"Pallagani, Vishal","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"John A.","familyName":"Aydin","name":"Aydin, John A.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Biplav","familyName":"Srivastava","name":"Srivastava, Biplav","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"On Sample-Efficient Generalized Planning via Learned Transition Models"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-26T16:13:46Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:54:44Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-03-08T23:27:22Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-03-10T01:29:57Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-03-20T02:31:49Z","dateType":"Submitted","dateInformation":"v3"},{"date":"2026-07-07T02:26:39Z","dateType":"Updated","dateInformation":"v3"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[{"relationType":"IsVersionOf","relatedIdentifier":"10.1609/icaps.v36i1.42888","relatedIdentifierType":"DOI"}],"relatedItems":[],"sizes":[],"formats":[],"version":"3","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Generalized planning studies the construction of solution strategies that generalize across families of planning problems sharing a common domain model, formally defined by a transition function $γ: S \\times A \\rightarrow S$. Classical approaches achieve such generalization through symbolic abstractions and explicit reasoning over $γ$. In contrast, recent Transformer-based planners, such as PlanGPT and Plansformer, largely cast generalized planning as direct action-sequence prediction, bypassing explicit transition modeling. While effective on in-distribution instances, these approaches typically require large datasets and model sizes, and often suffer from state drift in long-horizon settings due to the absence of explicit world-state evolution. In this work, we formulate generalized planning as a transition-model learning problem, in which a neural model explicitly approximates the successor-state function $\\hatγ \\approx γ$ and generates plans by rolling out symbolic state trajectories. Instead of predicting actions directly, the model autoregressively predicts intermediate world states, thereby learning the domain dynamics as an implicit world model. To study size-invariant generalization and sample efficiency, we systematically evaluate multiple state representations and neural architectures, including relational graph encodings. Our results show that learning explicit transition models yields higher out-of-distribution satisficing-plan success than direct action-sequence prediction in multiple domains, while achieving these gains with significantly fewer training instances and smaller models. This is an extended version of a short paper accepted at ICAPS 2026 under the same title."},{"descriptionType":"Other","description":"14 pages; Extended version of short paper accepted at ICAPS 2026; updated with results and analysis"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.23148","contentUrl":null,"metadataVersion":3,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":1,"created":"2026-02-27T03:03:36Z","registered":"2026-02-27T03:03:37Z","published":null,"updated":"2026-07-07T05:03:54Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.23056","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.23056","identifiers":[{"identifier":"2602.23056","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Giona","familyName":"Fieni","name":"Fieni, Giona","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Joschua","familyName":"Wüthrich","name":"Wüthrich, Joschua","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Marc-Philippe","familyName":"Neumann","name":"Neumann, Marc-Philippe","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Christopher H.","familyName":"Onder","name":"Onder, Christopher H.","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Learning-based Multi-agent Race Strategies in Formula 1"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"Systems and Control (eess.SY)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"FOS: Electrical engineering, electronic engineering, information engineering","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-26T14:41:29Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:49:31Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-07-02T15:18:11Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-07-03T00:58:35Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"In Formula 1, race strategies are adapted according to evolving race conditions and competitors' actions. This paper proposes a reinforcement learning approach for multi-agent race strategy optimization. Agents learn to balance energy management, tire degradation, aerodynamic interaction, and pit-stop decisions. Building on a pre-trained single-agent policy, we introduce an interaction module that accounts for the behavior of competitors. The combination of the interaction module and a self-play training scheme generates competitive policies, and agents are ranked based on their relative performance. Results show that the agents adapt pit timing, tire selection, and energy allocation in response to opponents, achieving robust and consistent race performance. Because the framework relies only on information available during real races, it can support race strategists' decisions before and during races."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.23056","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T03:01:24Z","registered":"2026-02-27T03:01:24Z","published":null,"updated":"2026-07-03T02:15:42Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.22897","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.22897","identifiers":[{"identifier":"2602.22897","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Xiaoxi","familyName":"Li","name":"Li, Xiaoxi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Wenxiang","familyName":"Jiao","name":"Jiao, Wenxiang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jiarui","familyName":"Jin","name":"Jin, Jiarui","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Haoxuan","familyName":"Li","name":"Li, Haoxuan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Hao","familyName":"Wang","name":"Wang, Hao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Shijian","familyName":"Wang","name":"Wang, Shijian","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Guanting","familyName":"Dong","name":"Dong, Guanting","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jiajie","familyName":"Jin","name":"Jin, Jiajie","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yinuo","familyName":"Wang","name":"Wang, Yinuo","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yuan","familyName":"Lu","name":"Lu, Yuan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ji-Rong","familyName":"Wen","name":"Wen, Ji-Rong","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zhicheng","familyName":"Dou","name":"Dou, Zhicheng","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zhouchen","familyName":"Lin","name":"Lin, Zhouchen","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"OmniGAIA: Towards Native Omni-Modal AI Agents"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"Multimedia (cs.MM)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-26T11:35:04Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:40:38Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02-28T12:27:12Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-03-03T01:39:42Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-07-02T15:39:17Z","dateType":"Submitted","dateInformation":"v3"},{"date":"2026-07-03T00:59:52Z","dateType":"Updated","dateInformation":"v3"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"3","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Human intelligence naturally intertwines omni-modal perception -- spanning vision, audio, and language -- with complex reasoning and tool usage to interact with the world. However, current multi-modal LLMs are primarily confined to bi-modal interactions (e.g., vision-language), lacking the unified cognitive capabilities required for general AI assistants. To bridge this gap, we introduce OmniGAIA, a comprehensive benchmark designed to evaluate omni-modal agents on tasks necessitating deep reasoning and multi-turn tool execution across video, audio, and image modalities. Constructed via a novel omni-modal event graph approach, OmniGAIA synthesizes complex, multi-hop queries derived from real-world data that require cross-modal reasoning and external tool integration. Furthermore, we propose OmniAtlas, a native omni-modal foundation agent under tool-integrated reasoning paradigm with active omni-modal perception. Trained on trajectories synthesized via a hindsight-guided tree exploration strategy and OmniDPO for fine-grained error correction, OmniAtlas effectively enhances the tool-use capabilities of existing open-source models. This work marks a step towards next-generation native omni-modal AI assistants for real-world scenarios."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.22897","contentUrl":null,"metadataVersion":2,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T02:57:25Z","registered":"2026-02-27T02:57:26Z","published":null,"updated":"2026-07-03T02:15:41Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.22265","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.22265","identifiers":[{"identifier":"2602.22265","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Chika","familyName":"Maduabuchi","name":"Maduabuchi, Chika","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Entropy-Controlled Flow Matching"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-25T06:07:01Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:01:24Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-06-23T20:59:18Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-06-25T00:10:37Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-06-29T23:52:39Z","dateType":"Submitted","dateInformation":"v3"},{"date":"2026-07-01T00:14:45Z","dateType":"Updated","dateInformation":"v3"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"3","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Modern vision generators transport a base distribution to data through time-indexed measures, implemented as deterministic flows (ODEs) or stochastic diffusions (SDEs). Despite strong empirical performance, standard flow-matching objectives do not directly control the information geometry of the trajectory, allowing low-entropy bottlenecks that can transiently deplete semantic modes. We propose Entropy-Controlled Flow Matching (ECFM): a constrained variational principle over continuity-equation paths enforcing a global entropy-rate budget d/dt H(mu_t) \u0026gt;= -lambda. ECFM is a convex optimization in Wasserstein space with a KKT/Pontryagin system, and admits a stochastic-control representation equivalent to a Schrodinger bridge with an explicit entropy multiplier. In the pure transport regime, ECFM recovers entropic OT geodesics and Gamma-converges to classical OT as lambda -\u0026gt; 0. We further obtain certificate-style mode-coverage and density-floor guarantees with Lipschitz stability, and construct near-optimal collapse counterexamples for unconstrained flow matching."},{"descriptionType":"Other","description":"Accepted to ECCV 2026"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.22265","contentUrl":null,"metadataVersion":2,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T02:42:23Z","registered":"2026-02-27T02:42:23Z","published":null,"updated":"2026-07-01T02:29:52Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.22573","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.22573","identifiers":[{"identifier":"2602.22573","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Kuang","familyName":"Bai","name":"Bai, Kuang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Wei","familyName":"Yao","name":"Yao, Wei","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jane J.","familyName":"Ye","name":"Ye, Jane J.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jin","familyName":"Zhang","name":"Zhang, Jin","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Directional first order approach for a class of bilevel programs"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Optimization and Control (math.OC)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-26T03:28:36Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:20:29Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-06-28T00:31:58Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-06-30T00:47:56Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"In this paper, we study a class of bilevel optimization program, where the feasible set of the lower level program is independent of the upper level variable. For bilevel programs it is known that the first order reformulation of a bilevel program requires the convexity of the lower level program while reformulations involving the value function result in difficult optimization problems. In this paper we propose a directional first order approach which does not require convexity of the lower level program. First, we propose some conditions under which the lower level program can be equivalently characterized by its first order condition over a directional neighborhood around the local optimal condition. Next we give some conditions under which the classical first order optimality condition in the form of M-stationary condition still holds as a necessary optimality condition for the first order reformulation of the bilevel program even when the lower level program is nonconvex."},{"descriptionType":"Other","description":"28 pages"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.22573","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T02:49:32Z","registered":"2026-02-27T02:49:32Z","published":null,"updated":"2026-06-30T04:11:22Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.23332","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.23332","identifiers":[{"identifier":"2602.23332","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Jacob","familyName":"Bringewatt","name":"Bringewatt, Jacob","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Leon","familyName":"Zaporski","name":"Zaporski, Leon","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Matthew","familyName":"Radzihovsky","name":"Radzihovsky, Matthew","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jasmine","familyName":"Albert","name":"Albert, Jasmine","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Alexey V.","familyName":"Gorshkov","name":"Gorshkov, Alexey V.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Vladan","familyName":"Vuletic","name":"Vuletic, Vladan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Gregory","familyName":"Bentsen","name":"Bentsen, Gregory","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Butterfly Echo Protocol for Axis-Agnostic Heisenberg-Limited Metrology"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Quantum Physics (quant-ph)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-26T18:38:01Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T02:03:06Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-06-26T16:37:48Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-06-29T00:57:07Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"The extreme sensitivity of chaotic systems to external perturbations makes them natural candidates for sensing applications. We propose a single-shot echo-based protocol for estimating small rotations about an unknown axis that leverages random symmetric probe states prepared via chaotic dynamics. In contrast to previous protocols for this axis-agnostic rotation sensing problem that depend on difficult-to-prepare anticoherent states, the random probe states used in our protocol can be prepared via constant-depth chaotic circuits composed of random one-axis twisting pulses. Further, the signal of interest can be extracted simply by measuring the total spin polarization. We demonstrate analytically that our protocol achieves Heisenberg scaling relative to an arbitrary rotation axis that need not be a priori known. We also investigate the effects of collective and single-particle dephasing in our protocol using analytical and numerical tools. While the requirements on dephasing rates to maintain Heisenberg sensitivity are strict, they are achievable in near-term experiments, for instance, in magnetometric rotosensing with high-spin lanthanide atoms such as dysprosium-164."},{"descriptionType":"Other","description":"7 pages, 4 figures + 19 page supplement. Version 2 features updated figures, revised presentation, and expanded supplement"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.23332","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T03:08:15Z","registered":"2026-02-27T03:08:16Z","published":null,"updated":"2026-06-29T02:01:27Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.23274","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.23274","identifiers":[{"identifier":"2602.23274","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Melissa","familyName":"Lober","name":"Lober, Melissa","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Markus","familyName":"Diesmann","name":"Diesmann, Markus","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Susanne","familyName":"Kunkel","name":"Kunkel, Susanne","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Exploiting network topology in brain-scale simulations of spiking neural networks"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Distributed, Parallel, and Cluster Computing (cs.DC)","lang":"en","subjectScheme":"arXiv"},{"subject":"Neurons and Cognition (q-bio.NC)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"FOS: Biological sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-26T17:49:13Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T02:00:12Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-06-26T12:43:56Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-06-29T00:44:35Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[{"relationType":"IsVersionOf","relatedIdentifier":"10.1088/2634-4386/ae762e","relatedIdentifierType":"DOI"}],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by-nc-nd/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution Non Commercial No Derivatives 4.0 International","rightsIdentifier":"cc-by-nc-nd-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Simulation code for conventional supercomputers serves as a reference for neuromorphic computing systems. The present bottleneck of distributed large-scale spiking neuronal network simulations is the communication between compute nodes. Communication speed seems limited by the interconnect between the nodes and the software library orchestrating the data transfer. Profiling reveals, however, that the variability of the time required by the compute nodes between communication calls is large. The bottleneck is in fact the waiting time for the slowest node. A statistical model explains total simulation time on the basis of the distribution of computation times between communication calls. A fundamental cure is to avoid communication calls because this requires fewer synchronizations and reduces the variability of computation times across compute nodes. The organization of the mammalian brain into areas lends itself to such an optimization strategy. Connections between neurons within an area have short delays, but the delays of the long-range connections across areas are an order of magnitude longer. This suggests a structure-aware mapping of areas to compute nodes allowing for a partition into more frequent communication between nodes simulating a particular area and less frequent global communication. We demonstrate a substantial performance gain on a real-world example. This work proposes a local-global hybrid communication architecture for large-scale neuronal network simulations as a first step in mapping the structure of the brain to the structure of a supercomputer. It challenges the long-standing belief that the bottleneck of simulation is synchronization inherent in the collective calls of standard communication libraries. We provide guidelines for the energy efficient simulation of neuronal networks on conventional computing systems and raise the bar for neuromorphic systems."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.23274","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":1,"created":"2026-02-27T03:06:50Z","registered":"2026-02-27T03:06:51Z","published":null,"updated":"2026-06-29T02:01:26Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.22284","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.22284","identifiers":[{"identifier":"2602.22284","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Mingi","familyName":"Kim","name":"Kim, Mingi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yongjun","familyName":"Kim","name":"Kim, Yongjun","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jungwoo","familyName":"Kang","name":"Kang, Jungwoo","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Hyungki","familyName":"Kim","name":"Kim, Hyungki","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"BrepCoder: A Unified Multimodal Large Language Model for Multi-task B-rep Reasoning"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-25T12:44:28Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:01:52Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-03-02T04:18:48Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-03-03T02:38:11Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-06-25T03:36:56Z","dateType":"Submitted","dateInformation":"v3"},{"date":"2026-06-26T00:22:54Z","dateType":"Updated","dateInformation":"v3"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"3","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by-nc-nd/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution Non Commercial No Derivatives 4.0 International","rightsIdentifier":"cc-by-nc-nd-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Recent advancements in deep learning have actively addressed complex challenges within the Computer-Aided Design (CAD) domain.However, most existing approaches rely on task-specifi c models requiring structural modifi cations for new tasks, and they predominantly focus on point clouds or images rather than the industry-standard Boundary Representation (B-rep) format. To address these limitations, we propose BrepCoder, a unifi ed Multimodal Large Language Model (MLLM) that performs diverse CAD tasks from B-rep inputs. By leveraging the code generation capabilities of Large Language Models (LLMs), we convert CAD modeling sequences into Python-like code and align them with B-rep. We then adopt a two-stage training strategy: First, pre-training on reverse engineering to learn geometric features and design logic. Second, eff ectively extending the model to various downstream tasks such as completion, error correction, and CAD-QA. Consequently, by interpreting B-rep as structural code, BrepCoder achieves superior generalization across diverse tasks, demonstrating its potential as a general-purpose CAD agent."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.22284","contentUrl":null,"metadataVersion":2,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T02:42:50Z","registered":"2026-02-27T02:42:50Z","published":null,"updated":"2026-06-26T02:19:20Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.22822","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.22822","identifiers":[{"identifier":"2602.22822","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Yunhua","familyName":"Zhong","name":"Zhong, Yunhua","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yixuan","familyName":"Tang","name":"Tang, Yixuan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yifan","familyName":"Li","name":"Li, Yifan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Pan","familyName":"Liu","name":"Liu, Pan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zhiwen","familyName":"Yang","name":"Yang, Zhiwen","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zanyi","familyName":"Wang","name":"Wang, Zanyi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jie","familyName":"Yang","name":"Yang, Jie","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jun","familyName":"Xia","name":"Xia, Jun","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"FlexMS: A Unified Public Benchmark for Molecule Tandem Mass Spectrum Prediction"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-26T10:05:01Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:36:51Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-04-12T17:04:41Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-04-14T01:09:38Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-06-11T18:52:07Z","dateType":"Submitted","dateInformation":"v3"},{"date":"2026-06-15T00:07:41Z","dateType":"Updated","dateInformation":"v3"},{"date":"2026-06-24T02:20:00Z","dateType":"Submitted","dateInformation":"v4"},{"date":"2026-06-25T00:21:26Z","dateType":"Updated","dateInformation":"v4"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"4","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by-nc-nd/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution Non Commercial No Derivatives 4.0 International","rightsIdentifier":"cc-by-nc-nd-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Tandem mass spectrometry (MS/MS) is central to small molecule identification, but current deep learning systems for spectrum prediction still remain difficult to evaluate and deploy in practice. While novel architectures constantly claim state-of-the-art performance, inconsistent metadata conditioning and entangled preprocessing pipelines hinder fair architectural comparisons. Besides, existing evaluations are often restricted to curated datasets, failing to capture the heterogeneity and cross-domain shifts of real-world metabolomics. Furthermore, current benchmarks lack difficulty-aware diagnostics and leave blind to how models behave under specific compute or data constraints. To address this, we present FlexMS, a modular public-data benchmark framework that standardizes MS/MS prediction across public resources while keeping molecular encoders, metadata conditioning, predictor heads, and downstream retrieval under one protocol. FlexMS establishes a fair evaluation playground which significantly lowers the barrier for integrating new predictive tools. Rather than solely optimizing for average scores, FlexMS augments aggregate accuracy with difficulty-aware diagnostics, providing actionable guidance on model selection across different compute constraints, data scales, and downstream retrieval objectives. Ultimately, FlexMS provides the community with a reproducible standard to identify which algorithmic conclusions are stable and which operating points are most viable in practice."},{"descriptionType":"Other","description":"preprint version v4"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.22822","contentUrl":null,"metadataVersion":3,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T02:55:31Z","registered":"2026-02-27T02:55:32Z","published":null,"updated":"2026-06-25T02:21:07Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.22733","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.22733","identifiers":[{"identifier":"2602.22733","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Seongyong","familyName":"Kim","name":"Kim, Seongyong","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Junhyeon","familyName":"Cho","name":"Cho, Junhyeon","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Kang-Won","familyName":"Lee","name":"Lee, Kang-Won","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Soo-Chul","familyName":"Lim","name":"Lim, Soo-Chul","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Pixel2Catch: Multi-Agent Sim-to-Real Transfer for Agile Manipulation with a Single RGB Camera"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Robotics (cs.RO)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-26T08:15:38Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-06-25T00:26:21Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[{"relationType":"IsVersionOf","relatedIdentifier":"10.1109/lra.2026.3703582","relatedIdentifierType":"DOI"}],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by-nc-nd/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution Non Commercial No Derivatives 4.0 International","rightsIdentifier":"cc-by-nc-nd-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"To catch a thrown object, a robot must be able to perceive the object's motion and generate control actions in a timely manner. Rather than explicitly estimating the object's 3D position, this work focuses on a novel approach that recognizes object motion using pixel-level visual information extracted from a single RGB image. Such visual cues capture changes in the object's position and scale, allowing the policy to reason about the object's motion. Furthermore, to achieve stable learning in a high-DoF system composed of a robot arm equipped with a multi-fingered hand, we design a heterogeneous multi-agent reinforcement learning framework that defines the arm and hand as independent agents with distinct roles. Each agent is trained cooperatively using role-specific observations and rewards, and the learned policies are successfully transferred from simulation to the real world."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.22733","contentUrl":null,"metadataVersion":2,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":1,"created":"2026-02-27T02:53:19Z","registered":"2026-02-27T02:53:20Z","published":null,"updated":"2026-06-25T02:21:06Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.23059","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.23059","identifiers":[{"identifier":"2602.23059","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Stefano","familyName":"Cipolla","name":"Cipolla, Stefano","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Fabio","familyName":"Durastante","name":"Durastante, Fabio","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Miryam","familyName":"Gnazzo","name":"Gnazzo, Miryam","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Beatrice","familyName":"Meini","name":"Meini, Beatrice","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Nearest Reversible Markov Chains with Sparsity Constraints: An Optimization Approach"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Numerical Analysis (math.NA)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-26T14:44:54Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:49:40Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-06-23T09:21:53Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-06-24T00:41:40Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/publicdomain/zero/1.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Zero v1.0 Universal","rightsIdentifier":"cc0-1.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Reversibility is a key property of Markov chains, central to algorithms such as Metropolis-Hastings and other MCMC methods. Yet many applications yield non-reversible chains, motivating the problem of approximating them by reversible ones with minimal modification. We formulate this task as a matrix nearness problem and focus on the practically relevant case of sparse transition matrices. The resulting optimization problem is a quadratic programming problem, and numerical experiments illustrate the effectiveness of the approach. This framework provides a principled way to enforce reversibility and sparsity patterns in Markov chains with applications in MCMC, computational chemistry, and data-driven modeling."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.23059","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T03:01:28Z","registered":"2026-02-27T03:01:28Z","published":null,"updated":"2026-06-24T02:30:13Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.22810","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.22810","identifiers":[{"identifier":"2602.22810","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Luca","familyName":"Viano","name":"Viano, Luca","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Till","familyName":"Freihaut","name":"Freihaut, Till","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Emanuele","familyName":"Nevali","name":"Nevali, Emanuele","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Volkan","familyName":"Cevher","name":"Cevher, Volkan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Matthieu","familyName":"Geist","name":"Geist, Matthieu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Giorgia","familyName":"Ramponi","name":"Ramponi, Giorgia","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Multi-agent imitation learning with function approximation: Linear Markov games and beyond"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-26T09:50:15Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:36:07Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-06-23T02:26:25Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-06-24T00:20:27Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"In this work, we present the first theoretical analysis of multi-agent imitation learning (MAIL) in linear Markov games where both the transition dynamics and each agent's reward function are linear in some given features. We demonstrate that by leveraging this structure, it is possible to replace the state-action level \"all policy deviation concentrability coefficient\" (Freihaut et al., arXiv:2510.09325) with a concentrability coefficient defined at the feature level which can be much smaller than the state-action analog when the features are informative about states' similarity. Furthermore, to circumvent the need for any concentrability coefficient, we turn to the interactive setting. We provide the first, computationally efficient, interactive MAIL algorithm for linear Markov games and show that its sample complexity depends only on the dimension of the feature map $d$. Building on these theoretical findings, we propose a deep MAIL interactive algorithm which clearly outperforms BC on games such as Tic-Tac-Toe and Connect4."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.22810","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T02:55:13Z","registered":"2026-02-27T02:55:13Z","published":null,"updated":"2026-06-24T02:30:12Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.22560","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.22560","identifiers":[{"identifier":"2602.22560","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Moirangthem Tiken","familyName":"Singh","name":"Singh, Moirangthem Tiken","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Amit","familyName":"Kalita","name":"Kalita, Amit","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Sapam Jitu","familyName":"Singh","name":"Singh, Sapam Jitu","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Operationalizing Fairness: Post-Hoc Threshold Optimization Under Hard Resource Limits"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-26T02:56:36Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-06-24T00:51:10Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[{"relationType":"IsVersionOf","relatedIdentifier":"10.1016/j.neucom.2026.134335","relatedIdentifierType":"DOI"}],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"The deployment of machine learning in high-stakes domains requires a balance between predictive safety and algorithmic fairness. However, existing fairness interventions often as- sume unconstrained resources and employ group-specific decision thresholds that violate anti- discrimination regulations. We introduce a post-hoc, model-agnostic threshold optimization framework that jointly balances safety, efficiency, and equity under strict and hard capacity constraints. To ensure legal compliance, the framework enforces a single, global decision thresh- old. We formulated a parameterized ethical loss function coupled with a bounded decision rule that mathematically prevents intervention volumes from exceeding the available resources. An- alytically, we prove the key properties of the deployed threshold, including local monotonicity with respect to ethical weighting and the formal identification of critical capacity regimes. We conducted extensive experimental evaluations on diverse high-stakes datasets. The principal re- sults demonstrate that capacity constraints dominate ethical priorities; the strict resource limit determines the final deployed threshold in over 80% of the tested configurations. Furthermore, under a restrictive 25% capacity limit, the proposed framework successfully maintains high risk identification (recall ranging from 0.409 to 0.702), whereas standard unconstrained fairness heuristics collapse to a near-zero utility. We conclude that theoretical fairness objectives must be explicitly subordinated to operational capacity limits to remain in deployment. By decou- pling predictive scoring from policy evaluation and strictly bounding intervention rates, this framework provides a practical and legally compliant mechanism for stakeholders to navigate unavoidable ethical trade-offs in resource-constrained environments."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.22560","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":1,"created":"2026-02-27T02:49:14Z","registered":"2026-02-27T02:49:14Z","published":null,"updated":"2026-06-24T02:30:10Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.22642","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.22642","identifiers":[{"identifier":"2602.22642","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Qin-Wen","familyName":"Luo","name":"Luo, Qin-Wen","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Sheng","familyName":"Ren","name":"Ren, Sheng","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xiang","familyName":"Chen","name":"Chen, Xiang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Rui","familyName":"Liu","name":"Liu, Rui","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jun","familyName":"Fang","name":"Fang, Jun","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Naiqiang","familyName":"Tan","name":"Tan, Naiqiang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Sheng-Jun","familyName":"Huang","name":"Huang, Sheng-Jun","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Compress the Easy, Explore the Hard: Difficulty-Aware Entropy Regularization for Efficient LLM Reasoning"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-26T05:47:30Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:26:19Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-06-18T19:10:56Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-06-23T00:10:12Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Chain-of-Thought (CoT) has substantially empowered Large Language Models (LLMs) to tackle complex reasoning tasks, yet the verbose nature of explicit reasoning steps incurs prohibitive inference latency and computational costs, limiting real-world deployment. While existing compression methods - ranging from self-training to Reinforcement Learning (RL) with length constraints - attempt to mitigate this, they often sacrifice reasoning capability for brevity. We identify a critical failure mode in these approaches: explicitly optimizing for shorter trajectories triggers rapid entropy collapse, which prematurely shrinks the exploration space and stifles the discovery of valid reasoning paths, particularly for challenging questions requiring extensive deduction. To address this issue, we propose Compress responses for Easy questions and Explore Hard ones (CEEH), a difficulty-aware approach to RL-based efficient reasoning. CEEH dynamically assesses instance difficulty to apply selective entropy regularization: it preserves a diverse search space for currently hard questions to ensure robustness, while permitting aggressive compression on easier instances where the reasoning path is well-established. In addition, we introduce a dynamic optimal-length penalty anchored to the historically shortest correct response, which effectively counteracts entropy-induced length inflation and stabilizes the reward signal. Across six reasoning benchmarks, CEEH consistently reduces response length while maintaining accuracy comparable to the base model, and improves Pass@k relative to length-only optimization."},{"descriptionType":"Other","description":"Accepted to KDD 2026"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.22642","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T02:51:11Z","registered":"2026-02-27T02:51:11Z","published":null,"updated":"2026-06-23T05:42:02Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.22959","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.22959","identifiers":[{"identifier":"2602.22959","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Zihao","familyName":"Zhao","name":"Zhao, Zihao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Frederik","familyName":"Hauke","name":"Hauke, Frederik","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Juliana","familyName":"De Castilhos","name":"De Castilhos, Juliana","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Sven","familyName":"Nebelung","name":"Nebelung, Sven","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Daniel","familyName":"Truhn","name":"Truhn, Daniel","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Can Agents Distinguish Visually Hard-to-Separate Diseases in a Zero-Shot Setting? A Pilot Study"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-26T12:53:50Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:43:52Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-06-18T09:17:08Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-06-19T00:37:03Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"The rapid progress of multimodal large language models (MLLMs) has led to increasing interest in agent-based systems. While most prior work in medical imaging concentrates on automating routine clinical workflows, we study an underexplored yet clinically significant setting: distinguishing visually hard-to-separate diseases in a zero-shot setting. We benchmark representative agents on two imaging-only proxy diagnostic tasks, (1) melanoma vs. atypical nevus and (2) pulmonary edema vs. pneumonia, where visual features are highly confounded despite substantial differences in clinical management. We introduce a multi-agent framework based on contrastive adjudication. Experimental results show improved diagnostic performance (an 11-percentage-point gain in accuracy on dermoscopy data) and reduced unsupported claims on qualitative samples, although overall performance remains insufficient for clinical deployment. We acknowledge the inherent uncertainty in human annotations and the absence of clinical context, which further limit the translation to real-world settings. Within this controlled setting, this pilot study provides preliminary insights into zero-shot agent performance in visually confounded scenarios."},{"descriptionType":"Other","description":"Code available at https://github.com/TruhnLab/Contrastive-Agent-Reasoning. Accepted by MICCAI 2026"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.22959","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T02:59:00Z","registered":"2026-02-27T02:59:00Z","published":null,"updated":"2026-06-19T02:20:17Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.23092","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.23092","identifiers":[{"identifier":"2602.23092","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Zhuoliang","familyName":"Xie","name":"Xie, Zhuoliang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Fei","familyName":"Liu","name":"Liu, Fei","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zhenkun","familyName":"Wang","name":"Wang, Zhenkun","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Qingfu","familyName":"Zhang","name":"Zhang, Qingfu","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Enhancing CVRP Solver through LLM-driven Automatic Heuristic Design"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-26T15:12:23Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:51:40Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-06-17T15:14:27Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-06-18T01:00:48Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"The Capacitated Vehicle Routing Problem (CVRP), a fundamental combinatorial optimization challenge, focuses on optimizing fleet operations under vehicle capacity constraints. While extensively studied in operational research, the NP-hard nature of CVRP continues to pose significant computational challenges, particularly for large-scale instances. This study presents AILS-AHD (Adaptive Iterated Local Search with Automatic Heuristic Design), a novel approach that leverages Large Language Models (LLMs) to revolutionize CVRP solving. Our methodology integrates an evolutionary search framework with LLMs to dynamically generate and optimize ruin heuristics within the AILS method. Additionally, we introduce an LLM-based acceleration mechanism to enhance computational efficiency. Comprehensive experimental evaluations against state-of-the-art solvers, including AILS-II and HGS, demonstrate the superior performance of AILS-AHD across both moderate and large-scale instances. Notably, our approach establishes new best-known solutions for 8 out of 10 instances in the CVRPLib large-scale benchmark, underscoring the potential of LLM-driven heuristic design in advancing the field of vehicle routing optimization."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.23092","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T03:02:14Z","registered":"2026-02-27T03:02:15Z","published":null,"updated":"2026-06-18T02:22:15Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.22222","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.22222","identifiers":[{"identifier":"2602.22222","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Bingrui","familyName":"Jin","name":"Jin, Bingrui","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Kunyao","familyName":"Lan","name":"Lan, Kunyao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Baihan","familyName":"LI","name":"LI, Baihan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Mengyue","familyName":"Wu","name":"Wu, Mengyue","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"TWICE: Modeling the Temporal Evolution of Personalized User Behavior via Event-Driven Agents"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Information Retrieval (cs.IR)","lang":"en","subjectScheme":"arXiv"},{"subject":"Multiagent Systems (cs.MA)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-12-15T20:28:05Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:00:21Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-06-17T09:41:39Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-06-18T00:39:30Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"User simulators are widely used for data generation, evaluation, and agent-based interaction, but existing approaches often model users as static personas or rely on generic historical context, making it difficult to capture how individual behavior evolves over time. To address this limitation, we propose TWICE, an LLM-based framework for temporally grounded personalized user simulation. TWICE combines structured user profiling, an event-driven memory module organized around life events and behavioral shifts, and a two-stage workflow separating event-grounded content planning from personalized style adaptation. This design enables the simulator to model not only what a user says, but also how past experiences shape later expression. We evaluate TWICE on a large-scale longitudinal Twitter dataset and introduce a comprehensive evaluation framework that jointly measures authenticity, consistency, and humanlikeness. Results show that TWICE consistently outperforms strong baselines, suggesting that event-centered memory is a promising mechanism for modeling the temporal evolution of personalized user behavior."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.22222","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T02:41:23Z","registered":"2026-02-27T02:41:23Z","published":null,"updated":"2026-06-18T02:22:14Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.22277","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.22277","identifiers":[{"identifier":"2602.22277","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Abdul Karim","familyName":"Gizzini","name":"Gizzini, Abdul Karim","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yahia","familyName":"Medjahdi","name":"Medjahdi, Yahia","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"X-REFINE: XAI-based RElevance input-Filtering and archItecture fiNe-tuning for channel Estimation"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"Signal Processing (eess.SP)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"FOS: Electrical engineering, electronic engineering, information engineering","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Electrical engineering, electronic engineering, information engineering","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-25T10:20:26Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:01:42Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-06-16T14:45:04Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-06-17T00:58:42Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"AI-native architectures are vital for 6G wireless communications. The black-box nature and high complexity of deep learning models employed in critical applications, such as channel estimation, limit their practical deployment. While perturbation-based eXplainable Artificial Intelligence (XAI) solutions offer input filtering, they often neglect internal structural optimization. We propose X-REFINE, an XAI-based framework for joint input-filtering and architecture fine-tuning. By utilizing a decomposition-based, sign-stabilized LRP epsilon rule, X-REFINE backpropagates predictions to derive high-resolution relevance scores for both subcarriers and hidden neurons. This enables a reliable optimization that identifies the most reliable model components. Simulation results demonstrate that X-REFINE achieves a superior performance-complexity-interpretability trade-off compared to the external perturbation-based XAI frameworks, significantly reducing computational complexity while maintaining robust bit error rate (BER) performance."},{"descriptionType":"Other","description":"This paper has been accepted for publication in the IEEE Transactions on Vehicular Technology (TVT) as a correspondence paper"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.22277","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T02:42:40Z","registered":"2026-02-27T02:42:40Z","published":null,"updated":"2026-06-17T02:24:42Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.23067","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.23067","identifiers":[{"identifier":"2602.23067","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Samuel","familyName":"Lemes-Perera","name":"Lemes-Perera, Samuel","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Miguel R.","familyName":"Alarcon","name":"Alarcon, Miguel R.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Pino","familyName":"Caballero-Gil","name":"Caballero-Gil, Pino","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Miquel","familyName":"Serra-Ricart","name":"Serra-Ricart, Miquel","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"A High-Throughput AES-GCM Implementation on GPUs for Secure, Policy-Based Access to Massive Astronomical Catalogs"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Instrumentation and Methods for Astrophysics (astro-ph.IM)","lang":"en","subjectScheme":"arXiv"},{"subject":"Cryptography and Security (cs.CR)","lang":"en","subjectScheme":"arXiv"},{"subject":"Distributed, Parallel, and Cluster Computing (cs.DC)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"E.3; D.4.6; J.2","lang":"en","subjectScheme":"ACM"}],"contributors":[],"dates":[{"date":"2026-02-26T14:54:24Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:50:19Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-06-15T09:42:17Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-06-16T01:34:56Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[{"relationType":"IsVersionOf","relatedIdentifier":"10.1016/j.ascom.2026.101153","relatedIdentifierType":"DOI"}],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"The era of large astronomical surveys generates massive image catalogs requiring efficient and secure access, particularly during pre-publication periods where data confidentiality and integrity are paramount. While Findable, Accessible, Interoperable, and Reusable (FAIR) principles guide the eventual public dissemination of data, traditional security methods for restricted phases often lack granularity or incur prohibitive performance penalties. To address this, we present a framework that integrates a flexible policy engine for fine-grained access control with a novel GPU-accelerated implementation of the AES-GCM authenticated encryption protocol.\n The novelty of this work lies in the adaptation and optimization of a parallel tree-reduction strategy to overcome the main performance bottleneck in authenticated encryption on GPUs: the inherently sequential Galois/Counter Mode (GCM) authentication hash (GHASH). We present both the algorithmic adaptation and its efficient execution on GPU architectures. Building on optimized GPU AES kernels from recent work in cryptographic acceleration, this work presents the first integration of these techniques into a high-throughput, FITS-aware encryption framework specifically designed for large-scale astronomical data, combining cryptographic authentication, dual-key access control, and direct compatibility with the standard astronomical Python ecosystem. Our implementation transforms the sequential GHASH computation into a highly parallelizable, logarithmic-time process, achieving authenticated encryption throughput suitable for petabyte-scale image analysis.\n Our solution provides a robust mechanism for data providers to enforce access policies, ensuring both confidentiality and integrity without hindering research workflows, thereby facilitating a secure and managed transition of data to public, FAIR archives."},{"descriptionType":"Other","description":"Submitted to Astronomy and Computing. 18 pages, 5 figures"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.23067","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":1,"created":"2026-02-27T03:01:39Z","registered":"2026-02-27T03:01:40Z","published":null,"updated":"2026-06-16T04:13:01Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.22422","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.22422","identifiers":[{"identifier":"2602.22422","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Luciano","familyName":"Gerber","name":"Gerber, Luciano","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Huw","familyName":"Lloyd","name":"Lloyd, Huw","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Revisiting Chebyshev Polynomial and Anisotropic RBF Models for Tabular Regression"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-25T21:34:52Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:08:55Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-06-14T02:41:16Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-06-16T00:47:18Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Smooth-basis models such as Chebyshev polynomial regressors and radial basis function (RBF) networks are well established in numerical analysis. Their continuously differentiable prediction surfaces suit surrogate optimisation, sensitivity analysis, and other settings where the response varies gradually with inputs. Despite these properties, smooth models seldom appear in tabular regression, where tree ensembles dominate. We ask whether they can compete, benchmarking models across 55 regression datasets organised by application domain.\n We develop an anisotropic RBF network with data-driven centre placement and gradient-based width optimisation, a ridge-regularised Chebyshev polynomial regressor, and a smooth-tree hybrid (Chebyshev model tree); all three are released as scikit-learn-compatible packages. We benchmark these against tree ensembles, a pre-trained transformer, and standard baselines, evaluating accuracy alongside generalisation behaviour.\n The transformer ranks first on accuracy across a majority of datasets, but its GPU dependence, inference latency, and dataset-size limits constrain deployment in the CPU-based settings common across applied science and industry. Among CPU-viable models, smooth models and tree ensembles are statistically tied on accuracy, but the former tend to exhibit tighter generalisation gaps. We recommend routinely including smooth-basis models in the candidate pool, particularly when downstream use benefits from tighter generalisation and gradually varying predictions."},{"descriptionType":"Other","description":"46 pages, 6 figures, 21 tables. Under review at Knowledge-Based Systems"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.22422","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T02:46:01Z","registered":"2026-02-27T02:46:02Z","published":null,"updated":"2026-06-16T04:12:58Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.23238","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.23238","identifiers":[{"identifier":"2602.23238","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Carlos","familyName":"Sevilla-Gutiérrez","name":"Sevilla-Gutiérrez, Carlos","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Varun Raj","familyName":"Kaipalath","name":"Kaipalath, Varun Raj","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Fabian","familyName":"Steinlechner","name":"Steinlechner, Fabian","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Gaussian mode coupling of spectrally broadband photons from bulk spontaneous parametric down-conversion: A spatial-spectral mode analysis of fiber coupling"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Quantum Physics (quant-ph)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-26T17:13:11Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:58:27Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-06-12T09:50:17Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-06-15T00:40:18Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[{"relationType":"IsVersionOf","relatedIdentifier":"10.1103/y39c-63q7","relatedIdentifierType":"DOI"}],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Photon sources based on spontaneous parametric down-conversion (SPDC) are central to experimental quantum optics and quantum technologies. Their performance is commonly quantified by three metrics: pair-collection probability, heralding efficiency, and spectral purity. In bulk-crystal SPDC, these metrics are known to be mutually constrained, yet the physical origin of the resulting trade-offs is often obscured. We show that these trade-offs originate from the frequency-dependent population of discrete spatial modes in the SPDC emission. By performing a Laguerre-Gauss mode decomposition at each frequency component, we show how spectral-spatial non-separability impacts collection probability, heralding efficiency, and purity. We apply this framework to two widely used quasi-phase-matching configurations: collinear degenerate type-0 and type-II SPDC in periodically poled bulk crystals, and quantify how different phase-matching functions shape the spectral-spatial mode structure. In particular, for type-II SPDC we compare standard periodically poled and aperiodically poled Gaussian phase matching. We experimentally validate some of our theoretical results using spatial- and spectral-projection measurements. This spectral-spatial mode analysis provides a quantitative and predictive framework for understanding and engineering bulk-crystal photon sources, enabling systematic multi-parameter optimization beyond qualitative design guidelines."},{"descriptionType":"Other","description":"Accepted version after peer review. Revised text and figures; results unchanged. Journal DOI added"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.23238","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":1,"created":"2026-02-27T03:05:56Z","registered":"2026-02-27T03:05:56Z","published":null,"updated":"2026-06-15T02:06:29Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.22281","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.22281","identifiers":[{"identifier":"2602.22281","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Steven","familyName":"Kelk","name":"Kelk, Steven","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ruben","familyName":"Meuwese","name":"Meuwese, Ruben","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Leo","familyName":"van Iersel","name":"van Iersel, Leo","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"A kernel for the maximum agreement forest problem on multiple binary phylogenetic trees"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Combinatorics (math.CO)","lang":"en","subjectScheme":"arXiv"},{"subject":"Populations and Evolution (q-bio.PE)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"FOS: Biological sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Biological sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-25T11:20:18Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:01:48Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-03-20T14:14:37Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-03-23T00:54:05Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-06-11T17:47:18Z","dateType":"Submitted","dateInformation":"v3"},{"date":"2026-06-12T01:07:20Z","dateType":"Updated","dateInformation":"v3"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"3","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"The maximum agreement forest (MAF) problem in phylogenetics takes as input a set t \u0026gt;= 2 of binary phylogenetic trees T on the same set of taxa X. It asks for a partition of X into the smallest number of blocks such that the subtrees induced by these blocks are disjoint and have common topology across all the trees in T. We produce a modified version of the well-known chain reduction rule in order to prove that after exhaustive application of reduction rules each tree has O( t * r * k ) leaves, where k is the natural parameter (the number of blocks) and r=min{max{k,3},t+1}}. We prove this bound for both the unrooted and rooted version of the problem, and demonstrate that the bound r, the length to which common chains are truncated, is tight. Our results constitute the first kernels for MAF in the t\u0026gt;2 regime."},{"descriptionType":"Other","description":"Under revision at journal. Compared to V2: new figures in Lemma 2, extended conclusion, fixed an error in the tightness constructions, several small typos fixed"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.22281","contentUrl":null,"metadataVersion":2,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T02:42:45Z","registered":"2026-02-27T02:42:46Z","published":null,"updated":"2026-06-12T02:22:44Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.22964","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.22964","identifiers":[{"identifier":"2602.22964","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Merijn","familyName":"Floren","name":"Floren, Merijn","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jan","familyName":"Swevers","name":"Swevers, Jan","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"A guided residual search for nonlinear state-space identification"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Signal Processing (eess.SP)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Electrical engineering, electronic engineering, information engineering","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Electrical engineering, electronic engineering, information engineering","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-26T13:01:42Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:44:13Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-06-10T08:38:34Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-06-11T00:39:22Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[{"relationType":"IsVersionOf","relatedIdentifier":"10.1109/lcsys.2026.3701764","relatedIdentifierType":"DOI"}],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Identifying the parameters of nonlinear state-space models from input-output data typically requires solving a highly non-convex optimization problem, which is prone to slow convergence and suboptimal local solutions. This work improves the reliability and efficiency of the estimation process by decomposing the overall optimization problem into a sequence of tractable subproblems. Starting from a linear baseline model, nonlinear residual dynamics are first estimated using a guided residual search (GRS) and subsequently refined through multiple-shooting optimization. Experiments on two benchmarks show competitive performance with state-of-the-art black-box methods and improved convergence over naive initialization."},{"descriptionType":"Other","description":"Code is available at: https://github.com/merijnfloren/guided-residual-search ; published paper in IEEE Xplore: https://ieeexplore.ieee.org/document/11556202"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.22964","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":1,"created":"2026-02-27T02:59:07Z","registered":"2026-02-27T02:59:08Z","published":null,"updated":"2026-06-11T02:28:53Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.22962","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.22962","identifiers":[{"identifier":"2602.22962","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Yuejiang","familyName":"Yu","name":"Yu, Yuejiang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Langwen","familyName":"Huang","name":"Huang, Langwen","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Alexandru","familyName":"Calotoiu","name":"Calotoiu, Alexandru","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Torsten","familyName":"Hoefler","name":"Hoefler, Torsten","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Scaling Laws of Global Weather Models"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-26T12:57:38Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:44:03Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-06-10T14:33:10Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-06-11T00:59:27Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Data-driven models are revolutionizing weather forecasting. To optimize training efficiency and model performance, this paper analyzes empirical scaling laws within this domain. We investigate the relationship between model performance (validation loss) and three key factors: model size ($N$), dataset size ($D$), and compute budget ($C$). Across a range of models, we find that Aurora exhibits the strongest data-scaling behavior: increasing the training dataset by 10x reduces validation loss by up to 3.2x. GraphCast demonstrates the highest parameter efficiency, yet suffers from limited hardware utilization. Our compute-optimal analysis indicates that, under fixed compute budgets, allocating resources to more total training data yields greater performance gains than increasing model size. Furthermore, we analyze model shape and uncover scaling behaviors that differ fundamentally from those observed in language models: weather forecasting models consistently favor increased width over depth. These findings suggest that future weather models should prioritize wider architectures and larger effective training datasets to maximize predictive performance."},{"descriptionType":"Other","description":"Accepted at ICML 2026. 21 pages, 7 figures"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.22962","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T02:59:04Z","registered":"2026-02-27T02:59:05Z","published":null,"updated":"2026-06-11T02:28:52Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.22638","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.22638","identifiers":[{"identifier":"2602.22638","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Zhiheng","familyName":"Song","name":"Song, Zhiheng","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jingshuai","familyName":"Zhang","name":"Zhang, Jingshuai","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Chuan","familyName":"Qin","name":"Qin, Chuan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Chao","familyName":"Wang","name":"Wang, Chao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Chao","familyName":"Chen","name":"Chen, Chao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Longfei","familyName":"Xu","name":"Xu, Longfei","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Kaikui","familyName":"Liu","name":"Liu, Kaikui","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xiangxiang","familyName":"Chu","name":"Chu, Xiangxiang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Hengshu","familyName":"Zhu","name":"Zhu, Hengshu","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"MobilityBench: A Benchmark for Evaluating Route-Planning Agents in Real-World Mobility Scenarios"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-26T05:39:38Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:25:57Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-06-10T08:57:04Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-06-11T00:40:50Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Route-planning agents powered by large language models (LLMs) have emerged as a promising paradigm for supporting everyday human mobility through natural language interaction and tool-mediated decision making. However, systematic evaluation in real-world mobility settings is hindered by diverse routing demands, non-deterministic mapping services, and limited reproducibility. In this study, we introduce MobilityBench, a scalable benchmark for evaluating LLM-based route-planning agents in real-world mobility scenarios. MobilityBench is constructed from large-scale, anonymized real user queries collected from Amap and covers a broad spectrum of route-planning intents across multiple cities worldwide. To enable reproducible, end-to-end evaluation, we design a deterministic API-replay sandbox that eliminates environmental variance from live services. We further propose a multi-dimensional evaluation protocol centered on outcome validity, complemented by assessments of instruction understanding, planning, tool use, and efficiency. Using MobilityBench, we evaluate multiple LLM-based route-planning agents across diverse real-world mobility scenarios and provide an in-depth analysis of their behaviors and performance. Our findings reveal that current models perform competently on Basic information retrieval and Route Planning tasks, yet struggle considerably with Preference-Constrained Route Planning, underscoring significant room for improvement in personalized mobility applications. We publicly release the benchmark data, evaluation toolkit, and documentation at https://github.com/AMAP-ML/MobilityBench."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.22638","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T02:51:05Z","registered":"2026-02-27T02:51:06Z","published":null,"updated":"2026-06-11T02:28:51Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.23232","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.23232","identifiers":[{"identifier":"2602.23232","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Aishik","familyName":"Sanyal","name":"Sanyal, Aishik","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"ReCoN-Ipsundrum: An Inspectable Recurrent Persistence Loop Agent with Affect-Coupled Control and Mechanism-Linked Consciousness Indicator Assays"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-26T17:11:08Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:58:16Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-03-01T07:17:53Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-06-10T01:07:37Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[{"relationType":"IsVersionOf","relatedIdentifier":"10.1609/aaaiss.v8i1.42565","relatedIdentifierType":"DOI"}],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Indicator-based approaches to machine consciousness recommend mechanism-linked evidence triangulated across tasks, supported by architectural inspection and causal intervention. Inspired by Humphrey's ipsundrum hypothesis, we implement ReCoN-Ipsundrum, an inspectable agent that extends a ReCoN state machine with a recurrent persistence loop over sensory salience $N^s$ and an optional affect proxy reporting valence/arousal. Across fixed-parameter ablations (ReCoN, Ipsundrum, Ipsundrum+affect), we operationalize Humphrey's qualiaphilia (preference for sensory experience for its own sake) as a familiarity-controlled scenic-over-dull route choice. We find a novelty dissociation: non-affect variants are novelty-sensitive ($Δ$scenic-entry = 0.07). Affect coupling is stable ($Δ$scenic-entry = 0.01) even when scenic is less novel (median {$Δ$novelty $\\approx$ -0.43). In reward-free exploratory play, the affect variant shows structured local investigation (scan events 31.4 vs. 0.9; cycle score 7.6). In a pain-tail probe, only the affect variant sustains prolonged planned caution (tail duration 90 vs. 5). Lesioning feedback+integration selectively reduces post-stimulus persistence in ipsundrum variants (AUC drop 27.62, 27.9%) while leaving ReCoN unchanged. These dissociations link recurrence $\\rightarrow$ persistence and affect-coupled control $\\rightarrow$ preference stability, scanning, and lingering caution, illustrating how indicator-like signatures can be engineered and why mechanistic and causal evidence should accompany behavioral markers."},{"descriptionType":"Other","description":"Accepted at AAAI 2026 Spring Symposium - Machine Consciousness: Integrating Theory, Technology, and Philosophy"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.23232","contentUrl":null,"metadataVersion":2,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":1,"created":"2026-02-27T03:05:46Z","registered":"2026-02-27T03:05:47Z","published":null,"updated":"2026-06-10T02:33:18Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.23234","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.23234","identifiers":[{"identifier":"2602.23234","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Evangelia","familyName":"Christakopoulou","name":"Christakopoulou, Evangelia","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Vivekkumar","familyName":"Patel","name":"Patel, Vivekkumar","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Hemanth","familyName":"Velaga","name":"Velaga, Hemanth","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Sandip","familyName":"Gaikwad","name":"Gaikwad, Sandip","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Sean","familyName":"Suchter","name":"Suchter, Sean","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Venkat","familyName":"Sundaranatha","name":"Sundaranatha, Venkat","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Scaling Search Relevance: Augmenting App Store Ranking with LLM-Generated Judgments"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Information Retrieval (cs.IR)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-26T17:11:26Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:58:18Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02-27T19:56:36Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-03-03T01:08:29Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-03-06T22:21:47Z","dateType":"Submitted","dateInformation":"v3"},{"date":"2026-03-10T00:15:17Z","dateType":"Updated","dateInformation":"v3"},{"date":"2026-06-01T00:39:09Z","dateType":"Submitted","dateInformation":"v4"},{"date":"2026-06-02T01:27:42Z","dateType":"Updated","dateInformation":"v4"},{"date":"2026-06-07T00:45:24Z","dateType":"Submitted","dateInformation":"v5"},{"date":"2026-06-09T00:47:41Z","dateType":"Updated","dateInformation":"v5"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"5","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by-nc-nd/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution Non Commercial No Derivatives 4.0 International","rightsIdentifier":"cc-by-nc-nd-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Large-scale commercial search systems optimize for relevance to drive successful sessions that help users find what they are looking for. To maximize relevance, we leverage two complementary objectives: behavioral relevance (results users tend to click or download) and textual relevance (a result's semantic fit to the query). A persistent challenge is the scarcity of expert-provided textual relevance labels relative to abundant behavioral relevance labels. We first address this by systematically evaluating LLM configurations, finding that a specialized, fine-tuned model significantly outperforms a much larger pre-trained one in providing highly relevant labels. Using this optimal model as a force multiplier, we generate millions of textual relevance labels to overcome the data scarcity. We show that augmenting our production ranker with these textual relevance labels leads to a significant outward shift of the Pareto frontier: offline NDCG improves for behavioral relevance while simultaneously increasing for textual relevance. These offline gains were validated by a worldwide A/B test on the App Store ranker, which demonstrated a statistically significant +0.24% increase in conversion rate, with the most substantial performance gains occurring in tail queries, where the new textual relevance labels provide a robust signal in the absence of reliable behavioral relevance labels."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.23234","contentUrl":null,"metadataVersion":4,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T03:05:49Z","registered":"2026-02-27T03:05:50Z","published":null,"updated":"2026-06-09T04:19:15Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.22976","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.22976","identifiers":[{"identifier":"2602.22976","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Henrik","familyName":"Reinstädtler","name":"Reinstädtler, Henrik","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Christian","familyName":"Schulz","name":"Schulz, Christian","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Nodari","familyName":"Sitchinava","name":"Sitchinava, Nodari","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Fabian","familyName":"Walliser","name":"Walliser, Fabian","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Efficient Parallel Algorithms for Hypergraph Matching"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Data Structures and Algorithms (cs.DS)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-26T13:16:38Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:44:51Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-03-12T15:32:41Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-03-13T00:56:05Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-06-05T11:52:25Z","dateType":"Submitted","dateInformation":"v3"},{"date":"2026-06-08T00:42:02Z","dateType":"Updated","dateInformation":"v3"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"3","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"We present efficient parallel algorithms for computing maximal matchings in hypergraphs. Our algorithm finds locally maximal edges in the hypergraph and adds them in parallel to the matching. In the CRCW PRAM models our algorithms achieve $O(\\log{\\logΔ}\\log{m})$ time with $O(κ\\log {m})$ work w.h.p. where $m$ is the number of hyperedges, and $κ$ is the sum and $Δ$ is the maximum of all vertex degrees. The CREW PRAM model algorithm has a running time of $O((\\logΔ+\\log{d})\\log{m})$ and requires $O(κ\\log {m})$ work w.h.p. It can be implemented work-optimal with $O(κ)$ work in $O((\\log{m}+\\log{n})\\log{m})$ time. We prove a~$1/d$-approximation guarantee for our algorithms.\n We evaluate our algorithms experimentally by implementing and running the proposed algorithms on the GPU using CUDA and Kokkos. Our experimental evaluation demonstrates the practical efficiency of our approach on real-world hypergraph instances, yielding a speed up of up to 76 times compared to a single-core CPU algorithm."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.22976","contentUrl":null,"metadataVersion":2,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T02:59:26Z","registered":"2026-02-27T02:59:26Z","published":null,"updated":"2026-06-08T02:04:17Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.22845","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.22845","identifiers":[{"identifier":"2602.22845","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Glitta R.","familyName":"Cheeran","name":"Cheeran, Glitta R.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Mehmet","familyName":"Müftüoğlu","name":"Müftüoğlu, Mehmet","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Sobhi","familyName":"Saeed","name":"Saeed, Sobhi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Bennet","familyName":"Fischer","name":"Fischer, Bennet","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Mario","familyName":"Chemnitz","name":"Chemnitz, Mario","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Kerr-induced In-line Interferometry for Ultra-sensitive Phase-Contrast Imaging"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Optics (physics.optics)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-26T10:37:01Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:38:12Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-06-04T09:25:25Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-06-05T00:46:16Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Measuring the phase of light is fundamental to optical imaging, sensing, and signal processing applications. Conventional optical phase measurements rely on multipath configurations, bulky interferometric setups, and computationally intensive data pipelines, limiting scalability, robustness, and practicality. We introduce a technique that allows for reference-free in-line phase retrieval of abrupt phase transitions in optical pulses directly from spectral measurements. Theory, simulations, and experiments concurrently explain the effect as a result of a Kerr-mediated interference between a projected linear wave component and the high-intensity residual of the phase-altered pulse. Utilizing this phenomenon, we demonstrate algorithm-free phase measurements of up to π/385 sensitivity and shot-to-shot signal prominence at 13 dB above noise at 80 MHz rates and 50 pJ pulse energies. This approach offers new paths toward the use of femtosecond pulses as broadband data carriers for optical communications, information processing, and direct high-throughput phase imaging."},{"descriptionType":"Other","description":"16 pages, 6 figures"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.22845","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T02:56:11Z","registered":"2026-02-27T02:56:12Z","published":null,"updated":"2026-06-05T07:07:31Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.23214","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.23214","identifiers":[{"identifier":"2602.23214","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Chenhe","familyName":"Du","name":"Du, Chenhe","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xuanyu","familyName":"Tian","name":"Tian, Xuanyu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Qing","familyName":"Wu","name":"Wu, Qing","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Muyu","familyName":"Liu","name":"Liu, Muyu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jingyi","familyName":"Yu","name":"Yu, Jingyi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Hongjiang","familyName":"Wei","name":"Wei, Hongjiang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yuyao","familyName":"Zhang","name":"Zhang, Yuyao","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Plug-and-Play Diffusion Meets ADMM: Dual-Variable Coupling for Robust Medical Image Reconstruction"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"Image and Video Processing (eess.IV)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"FOS: Electrical engineering, electronic engineering, information engineering","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Electrical engineering, electronic engineering, information engineering","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-26T16:58:43Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:57:29Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-06-03T12:08:29Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-06-04T00:47:47Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by-nc-sa/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution Non Commercial Share Alike 4.0 International","rightsIdentifier":"cc-by-nc-sa-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Plug-and-Play diffusion prior (PnPDP) frameworks have emerged as a powerful paradigm for solving imaging inverse problems by treating pretrained generative models as modular priors. However, we identify a critical flaw in prevailing PnP solvers (e.g., based on HQS or Proximal Gradient): they function as memoryless operators, updating estimates solely based on instantaneous gradients. This lack of historical tracking inevitably leads to non-vanishing steady-state bias, where the reconstruction fails to strictly satisfy physical measurements under heavy corruption. To resolve this, we propose Dual-Coupled PnP Diffusion (DC-PnPDP), which restores the classical dual variable to provide integral feedback, progressively enforce agreement between the data-consistency and prior. However, this rigorous geometric coupling introduces a secondary challenge: the accumulated dual residuals exhibit spectrally colored, structured artifacts that violate the Additive White Gaussian Noise (AWGN) assumption of diffusion priors, causing severe hallucinations. To bridge this gap, we introduce Spectral Homogenization (SH), a frequency-domain adaptation mechanism that modulates these structured residuals into statistically compliant pseudo-AWGN inputs. This effectively aligns the solver's rigorous optimization trajectory with the denoiser's valid statistical manifold. Extensive experiments on CT and MRI reconstruction demonstrate that our approach resolves the bias-hallucination trade-off, achieving state-of-the-art fidelity with significantly accelerated convergence. The code is available at https://github.com/duchenhe/DC-PnPDP"},{"descriptionType":"Other","description":"Accepted by ICML 2026"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.23214","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T03:05:18Z","registered":"2026-02-27T03:05:19Z","published":null,"updated":"2026-06-04T03:33:23Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.22779","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.22779","identifiers":[{"identifier":"2602.22779","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Chenhao","familyName":"Zheng","name":"Zheng, Chenhao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jieyu","familyName":"Zhang","name":"Zhang, Jieyu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jianing","familyName":"Zhang","name":"Zhang, Jianing","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Weikai","familyName":"Huang","name":"Huang, Weikai","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ashutosh","familyName":"Kumar","name":"Kumar, Ashutosh","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Quan","familyName":"Kong","name":"Kong, Quan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Oncel","familyName":"Tuzel","name":"Tuzel, Oncel","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Chun-Liang","familyName":"Li","name":"Li, Chun-Liang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ranjay","familyName":"Krishna","name":"Krishna, Ranjay","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"TrajTok: Learning Trajectory Tokens enables better Video Understanding"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-26T09:15:34Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:34:40Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-05-10T04:11:45Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-05-12T01:05:34Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-06-03T09:11:47Z","dateType":"Submitted","dateInformation":"v3"},{"date":"2026-06-04T00:39:21Z","dateType":"Updated","dateInformation":"v3"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"3","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Tokenization in video models, typically through patchification, generates an excessive and redundant number of tokens. This severely limits video efficiency and scalability. While recent trajectory-based tokenizers offer a promising solution by decoupling video duration from token count, they rely on complex external segmentation and tracking pipelines that are slow and task-agnostic. We propose TrajTok, an end-to-end video tokenizer module that is fully integrated and co-trained with video models for a downstream objective, dynamically adapting its token granularity to semantic complexity, independent of video duration. TrajTok contains a unified segmenter that performs implicit clustering over pixels in both space and time to directly produce object trajectories in a single forward pass. By prioritizing downstream adaptability over pixel-perfect segmentation fidelity, TrajTok is lightweight and efficient, yet empirically improves video understanding performance. With TrajTok, we implement a video CLIP model trained from scratch (TrajViT2). It achieves the best accuracy at scale across both classification and retrieval benchmarks, while maintaining efficiency comparable to the best token-merging methods. TrajTok also proves to be a versatile component beyond its role as a tokenizer. We show that it can be seamlessly integrated as either a probing head for pretrained visual features (TrajAdapter) or an alignment connector in vision-language models (TrajVLM) with especially strong performance in long-video reasoning."},{"descriptionType":"Other","description":"CVPR 2026"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.22779","contentUrl":null,"metadataVersion":2,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T02:54:25Z","registered":"2026-02-27T02:54:26Z","published":null,"updated":"2026-06-04T03:33:21Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.22480","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.22480","identifiers":[{"identifier":"2602.22480","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Varun","familyName":"Ursekar","name":"Ursekar, Varun","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Apaar","familyName":"Shanker","name":"Shanker, Apaar","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Veronica","familyName":"Chatrath","name":"Chatrath, Veronica","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yuan","familyName":"Xue","name":"Xue, Yuan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Samuel Marc","familyName":"Denton","name":"Denton, Samuel Marc","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"VeRO: A Harness for Agents to Optimize Agents"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-25T23:40:22Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:11:59Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-05-01T21:30:31Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-05-05T00:11:20Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-05-11T16:21:57Z","dateType":"Submitted","dateInformation":"v3"},{"date":"2026-05-12T02:26:37Z","dateType":"Updated","dateInformation":"v3"},{"date":"2026-06-02T16:57:10Z","dateType":"Submitted","dateInformation":"v4"},{"date":"2026-06-03T01:13:01Z","dateType":"Updated","dateInformation":"v4"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"4","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"An important emerging application of coding agents is agent harness optimization: the iterative improvement of a target agent by editing and evaluating its code. Despite its relevance, the community lacks a systematic understanding of coding agent performance on this task. Harness optimization differs from conventional software engineering: agent harnesses interleave deterministic code with stochastic LLM completions, requiring structured capture of both intermediate execution traces and downstream outcomes. To address these challenges, we introduce (1) VeRO (Versioning, Rewards, and Observations), an outer harness that provides versioned snapshots, budget-controlled evaluation, and structured execution traces of target harnesses, and (2) VeRO-Bench, a benchmark suite of target agents and tasks with reference evaluation procedures. Using VeRO, we conduct an empirical study comparing optimizers across tasks and analyzing which modifications reliably improve target agent harnesses. We release VeRO to support research on agent optimization as a core capability for coding agents. Code is available at https://github.com/scaleapi/vero."},{"descriptionType":"Other","description":"Accepted to the Forty-Third International Conference on Machine Learning (ICML), 2026"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.22480","contentUrl":null,"metadataVersion":3,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T02:47:21Z","registered":"2026-02-27T02:47:22Z","published":null,"updated":"2026-06-03T03:14:54Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.23039","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.23039","identifiers":[{"identifier":"2602.23039","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Jakob","familyName":"Kramp","name":"Kramp, Jakob","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Javed","familyName":"Lindner","name":"Lindner, Javed","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Moritz","familyName":"Helias","name":"Helias, Moritz","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Dynamics of neural scaling laws in random feature regression with powerlaw-distributed kernel eigenvalues"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Disordered Systems and Neural Networks (cond-mat.dis-nn)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-26T14:24:11Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:48:34Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-06-01T09:29:09Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-06-02T01:53:45Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Training large neural networks exposes neural scaling laws for the generalization error, which points to a universal behavior across network architectures of learning in high dimensions. It was also shown that this effect persists in the limit of highly overparametrized networks as well as the Neural network Gaussian process limit. We here develop a principled understanding of the typical behavior of generalization in Neural Network Gaussian process regression dynamics. We derive a dynamical mean-field theory that captures the typical case learning dynamics: This allows us to unify multiple existing regimes of learning studied in the current literature, namely Bayesian inference on Gaussian processes, gradient flow with or without weight-decay, and stochastic Langevin training dynamics. Employing tools from statistical physics, the unified framework we derive in either of these cases yields an effective description of the high-dimensional microscopic behavior of networks dynamics in terms of lower dimensional order parameters. We show that collective training dynamics may be separated into the dynamics of N independent eigenmodes, those evolution equations are only coupled through collective response functions and a common statistics of an effective, independent noise. Our approach allows us to quantitatively explain the dynamics of the generalization error by linking spectral and dynamical properties of learning on data with power law spectra, including phenomena such as neural scaling laws and the effect of early stopping."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.23039","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T03:00:59Z","registered":"2026-02-27T03:00:59Z","published":null,"updated":"2026-06-02T05:02:01Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.22221","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.22221","identifiers":[{"identifier":"2602.22221","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Geng","familyName":"Liu","name":"Liu, Geng","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Li","familyName":"Feng","name":"Feng, Li","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Mengxiao","familyName":"Zhu","name":"Zhu, Mengxiao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Francesco","familyName":"Pierri","name":"Pierri, Francesco","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Evaluating Reliability Asymmetries in Chinese Factual Search and AI Answers"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Information Retrieval (cs.IR)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"Computers and Society (cs.CY)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-12-15T15:36:13Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:00:19Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-05-28T07:37:27Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-06-02T00:03:01Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Search engines and AI-powered systems increasingly mediate access to factual information, yet their reliability remains difficult to evaluate in realistic information-seeking settings. We study this problem in the Chinese web ecosystem by constructing a query-based fact-checking dataset from real Chinese search logs and comparing nine systems across traditional search engines, standalone large language models, and search-integrated AI Overviews. Focusing on factual Chinese-language factual Yes/No questions, we evaluate whether systems provide correct, incorrect, or uncertain decisions against evidence-derived ground truth. We find that systems are similarly accurate when they provide definitive answers, but differ sharply in how often they do so. Conditional accuracy ranges from 73.2% to 78.9%, yet search engines answer definitively on over 83% of queries, while Qwen-Max does so on fewer than half. We also find a consistent polarity gap: all systems perform better on yes-labeled queries than on no-labeled queries. We also use Baidu Index data to identify Chinese provinces with higher health-related search attention, which may indicate greater potential exposure to misinformation. Overall, our results show that reliability depends not only on whether systems are correct when they answer, but also on how often they answer, how they handle negative claims, and where information demand may increase exposure risks."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.22221","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T02:41:21Z","registered":"2026-02-27T02:41:22Z","published":null,"updated":"2026-06-02T05:01:57Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.22769","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.22769","identifiers":[{"identifier":"2602.22769","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Yujie","familyName":"Zhao","name":"Zhao, Yujie","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Boqin","familyName":"Yuan","name":"Yuan, Boqin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Junbo","familyName":"Huang","name":"Huang, Junbo","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Haocheng","familyName":"Yuan","name":"Yuan, Haocheng","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zhongming","familyName":"Yu","name":"Yu, Zhongming","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Haozhou","familyName":"Xu","name":"Xu, Haozhou","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Lanxiang","familyName":"Hu","name":"Hu, Lanxiang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Abhilash","familyName":"Shankarampeta","name":"Shankarampeta, Abhilash","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zimeng","familyName":"Huang","name":"Huang, Zimeng","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Wentao","familyName":"Ni","name":"Ni, Wentao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yuandong","familyName":"Tian","name":"Tian, Yuandong","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jishen","familyName":"Zhao","name":"Zhao, Jishen","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"AMA-Bench: Evaluating Long-Horizon Memory for Agentic Applications"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-26T08:59:31Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:34:04Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-03-04T03:30:11Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-03-05T01:25:54Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-05-25T11:24:00Z","dateType":"Submitted","dateInformation":"v3"},{"date":"2026-05-26T01:43:47Z","dateType":"Updated","dateInformation":"v3"},{"date":"2026-05-27T09:28:43Z","dateType":"Submitted","dateInformation":"v4"},{"date":"2026-05-28T00:51:21Z","dateType":"Updated","dateInformation":"v4"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"4","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Large Language Models (LLMs) are increasingly used as autonomous agents in complex, long-horizon applications, where effective memory is critical for sustained performance. Yet existing memory benchmarks are largely dialogue-centric, while real agent memory consists of continuous agent-environment interaction trajectories composed of states, actions, observations, and tool outputs. To address this gap, we introduce **AMA-Bench** (**A**gent **M**emory with **A**ny length), a benchmark for evaluating long-horizon memory in realistic agentic settings. AMA-Bench combines real-world agent trajectories from representative applications with expert-curated QA, as well as synthetic trajectories that scale to arbitrary horizons with rule-based QA. Our study shows that existing memory systems underperform because they fail to capture causal and objective information and rely heavily on lossy similarity-based retrieval. We further propose **AMA-Agent**, a memory system based on causality-graph construction and tool-augmented retrieval. AMA-Agent achieves **57.22%** accuracy on AMA-Bench, outperforming the strongest baseline by **11.16%**. Resources are available at: [https://ama-bench.github.io/](https://ama-bench.github.io/)."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.22769","contentUrl":null,"metadataVersion":3,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T02:54:11Z","registered":"2026-02-27T02:54:12Z","published":null,"updated":"2026-05-28T02:58:28Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.23200","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.23200","identifiers":[{"identifier":"2602.23200","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Sayed Mohammadreza Tayaranian","familyName":"Hosseini","name":"Hosseini, Sayed Mohammadreza Tayaranian","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Amir","familyName":"Ardakani","name":"Ardakani, Amir","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Warren J.","familyName":"Gross","name":"Gross, Warren J.","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"InnerQ: Hardware-Aware Tuning-Free Quantization of KV Cache for Large Language Models"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-26T16:50:36Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:56:57Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-05-20T19:15:57Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-05-22T00:06:26Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"When transformer-based language models are deployed for text generation, most of the inference time is spent in the decoding stage, where output tokens are generated sequentially. Reducing the hardware cost of each decoding step is therefore critical for efficient long-context generation. A major bottleneck is the key-value (KV) cache, whose size grows with sequence length and often dominates the model's memory footprint. Prior work has proposed quantization methods to compress the KV cache while minimizing its loss of precision. We present InnerQ, a hardware-aware KV cache quantization scheme that reduces decode latency without compromising evaluation performance. InnerQ performs group-wise quantization by grouping cache matrices along their inner dimension. This grouping strategy aligns dequantization with vector-matrix multiplication and increases data reuse across GPU compute units. As a result, InnerQ reduces memory access and accelerates dequantization, achieving an average $1.3\\times$ speedup over prior KV cache quantization methods and $2.7\\times$ over the non-quantized baseline. To maintain fidelity under aggressive compression, InnerQ incorporates three techniques: (i) hybrid quantization, which chooses symmetric or asymmetric quantization for each group based on local statistics; (ii) high-precision windows for both recent tokens and attention sink tokens to mitigate outlier leakage; and (iii) per-channel normalization of the key cache, computed once during prefill and folded into the model parameters to eliminate runtime overhead. Beyond reducing latency, experiments on Llama and Mistral models show that InnerQ also improves few-shot evaluation scores relative to prior KV cache quantization methods."},{"descriptionType":"Other","description":"18 pages, 5 figures, 7 tables"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.23200","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T03:04:56Z","registered":"2026-02-27T03:04:56Z","published":null,"updated":"2026-05-22T02:34:16Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.23058","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.23058","identifiers":[{"identifier":"2602.23058","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Zeyu","familyName":"Zhang","name":"Zhang, Zeyu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Danning","familyName":"Li","name":"Li, Danning","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ian","familyName":"Reid","name":"Reid, Ian","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Richard","familyName":"Hartley","name":"Hartley, Richard","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"GeoWorld: Geometric World Models"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"Robotics (cs.RO)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-26T14:42:53Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:49:38Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-05-17T06:55:06Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-05-19T01:01:34Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by-nc-sa/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution Non Commercial Share Alike 4.0 International","rightsIdentifier":"cc-by-nc-sa-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Energy-based predictive world models provide a powerful approach for multi-step visual planning by reasoning over latent energy landscapes rather than generating pixels. However, existing approaches face two major challenges: (i) their latent representations are typically learned in Euclidean space, neglecting the underlying geometric and hierarchical structure among states, and (ii) they struggle with long-horizon prediction, which leads to rapid degradation across extended rollouts. To address these challenges, we introduce GeoWorld, a geometric world model that preserves geometric structure and hierarchical relations through a Hyperbolic JEPA, which maps latent representations from Euclidean space onto hyperbolic manifolds. We further introduce Geometric Reinforcement Learning for energy-based optimization, enabling stable multi-step planning in hyperbolic latent space. Extensive experiments on CrossTask and COIN demonstrate around 3% SR improvement in 3-step planning and 2% SR improvement in 4-step planning compared to the state-of-the-art V-JEPA 2. Project website: https://steve-zeyu-zhang.github.io/GeoWorld."},{"descriptionType":"Other","description":"Accepted to CVPR 2026"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.23058","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T03:01:26Z","registered":"2026-02-27T03:01:27Z","published":null,"updated":"2026-05-19T04:56:38Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.22801","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.22801","identifiers":[{"identifier":"2602.22801","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Yinan","familyName":"Zheng","name":"Zheng, Yinan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Tianyi","familyName":"Tan","name":"Tan, Tianyi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Bin","familyName":"Huang","name":"Huang, Bin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Enguang","familyName":"Liu","name":"Liu, Enguang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ruiming","familyName":"Liang","name":"Liang, Ruiming","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jianlin","familyName":"Zhang","name":"Zhang, Jianlin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jianwei","familyName":"Cui","name":"Cui, Jianwei","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Guang","familyName":"Chen","name":"Chen, Guang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Kun","familyName":"Ma","name":"Ma, Kun","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Hangjun","familyName":"Ye","name":"Ye, Hangjun","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Long","familyName":"Chen","name":"Chen, Long","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ya-Qin","familyName":"Zhang","name":"Zhang, Ya-Qin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xianyuan","familyName":"Zhan","name":"Zhan, Xianyuan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jingjing","familyName":"Liu","name":"Liu, Jingjing","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Unleashing the Potential of Diffusion Models for End-to-End Autonomous Driving"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Robotics (cs.RO)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-26T09:37:38Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:35:33Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-05-16T16:36:34Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-05-19T00:47:18Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by-nc-sa/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution Non Commercial Share Alike 4.0 International","rightsIdentifier":"cc-by-nc-sa-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Diffusion models have become a popular choice for decision-making tasks in robotics, and more recently, are also being considered for solving autonomous driving tasks. However, their applications and evaluations in autonomous driving remain limited to simulation-based or laboratory settings. The full strength of diffusion models for large-scale, complex real-world settings, such as End-to-End Autonomous Driving (E2E AD), remains underexplored. In this study, we conducted a systematic and large-scale investigation to unleash the potential of the diffusion models as planners for E2E AD, based on a tremendous amount of real-vehicle data and road testing. Through comprehensive and carefully controlled studies, we identify key insights into the diffusion loss space, trajectory representation, and data scaling that significantly impact E2E planning performance. Moreover, we also provide an effective reinforcement learning post-training strategy to further enhance the safety and robustness of the learned planner. The resulting diffusion-based learning framework, Hyper Diffusion Planner (HDP), is deployed on a real-vehicle platform and evaluated across 6 urban driving scenarios and 200 km of real-world testing, achieving a notable 10x performance improvement over the base model. Our work demonstrates that diffusion models, when properly designed and trained, can serve as effective and scalable E2E AD planners for complex, real-world autonomous driving tasks."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.22801","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T02:54:59Z","registered":"2026-02-27T02:54:59Z","published":null,"updated":"2026-05-19T04:56:36Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.22602","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.22602","identifiers":[{"identifier":"2602.22602","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Erhan","familyName":"Bayraktar","name":"Bayraktar, Erhan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xihao","familyName":"He","name":"He, Xihao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xiang","familyName":"Yu","name":"Yu, Xiang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Fengyi","familyName":"Yuan","name":"Yuan, Fengyi","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Mean-field games with rough common noise: the compactification approach"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Probability (math.PR)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-26T04:17:37Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:23:02Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-05-16T13:01:07Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-05-19T00:41:11Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"We study mean-field game (MFG) problems with rough common noise, in which the representative state dynamics are governed by a controlled rough stochastic differential equation driven by an idiosyncratic Brownian motion and a deterministic rough-path signal that affects the whole population. Within this new framework, we introduce a canonical weak formulation based on relaxed controls and rough martingale problems. We prove the existence of a pathwise mean-field equilibrium by developing new compactification tools that accommodate rough integration and differ substantially from classical compactification arguments in the literature. Finally, we discuss the relationship between the pathwise problem and the classical MFG problem with randomized Brownian common noise. Using the notion of a pathwise admissible set, we recast mean-field game problems with common noise as optimization problems over an extended space of probability measures. We establish an equivalent characterization of Carmona-Delarue-Lacker's weak equilibrium and, as an application, give an alternative proof of strong equilibrium without first establishing pathwise uniqueness."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.22602","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T02:50:13Z","registered":"2026-02-27T02:50:14Z","published":null,"updated":"2026-05-19T04:56:33Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.22784","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.22784","identifiers":[{"identifier":"2602.22784","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"António","familyName":"Leitão","name":"Leitão, António","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"It's All About Covers: Persistent Homology of Cover Refinements"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Algebraic Topology (math.AT)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"55N31 (Primary), 55U05 (Secondary)","lang":"en","subjectScheme":"MSC"}],"contributors":[],"dates":[{"date":"2026-02-26T09:19:26Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:34:48Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-05-14T08:30:26Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-05-15T00:40:50Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by-nc-nd/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution Non Commercial No Derivatives 4.0 International","rightsIdentifier":"cc-by-nc-nd-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"The computational cost of persistent homology is often dominated by the growth of the underlying simplicial filtrations. Many different filtrations exist, each with its own assumptions and trade-offs, but all face some form of this growth which can be exponential in the worst case, as for the Vietoris-Rips. We recast this problem at the level of covers, developing a framework in which filtrations and persistence modules can be constructed, analyzed, and compared through simple relations between covers rather than at the level of simplicial complexes. The guarantees propagate through any functor that preserves the contiguity of refinement maps, we give the example of two such functors: the Nerve and the Co-Nerve. Working at this level is drastically simpler, with stronger, more general consequences. We explore this perspective and show how it can be used to construct a robust approximation of the Vietoris-Rips filtration that is orders of magnitude smaller, while maintaining a log 3-interleaving unconditionally for any metric space. The resulting filtration restores near-linear scaling in the number of data points and enable us to efficiently capture homology at high degrees."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.22784","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T02:54:32Z","registered":"2026-02-27T02:54:33Z","published":null,"updated":"2026-05-15T02:39:53Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.22847","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.22847","identifiers":[{"identifier":"2602.22847","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Kerrian Le","familyName":"Caillec","name":"Caillec, Kerrian Le","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Anna","familyName":"Van Elst","name":"Van Elst, Anna","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Igor","familyName":"Colin","name":"Colin, Igor","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Stephan","familyName":"Clémençon","name":"Clémençon, Stephan","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Decentralized Ranking Aggregation via Gossip: Convergence and Robustness"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"Machine Learning (stat.ML)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-26T10:37:23Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:38:15Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-05-13T14:53:10Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-05-14T01:13:22Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"The concept of ranking aggregation plays a central role in preference analysis, and numerous algorithms for calculating median rankings, often originating in social choice theory, have been documented in the literature, offering theoretical guarantees in a centralized setting, \\textit{i.e.}, when all the ranking data to be aggregated can be brought together in a single computing unit. For many technologies (\\textit{e.g.} peer-to-peer networks, IoT, multi-agent systems), extending the ability to calculate consensus rankings with guarantees of convergence and resilience to potential contamination in a decentralized setting, when preference data is initially distributed across a communicating network, remains a major methodological challenge. Indeed, in recent years, the literature on decentralized computation has mainly focused on computing or optimizing statistics such as arithmetic means using gossip algorithms. The purpose of this article is precisely to study how to achieve reliable and resilient consensus on collective rankings in a decentralized setting, thereby raising new questions, robustness to corrupted nodes, and scalability through reduced communication costs in particular. The approach proposed and analyzed here relies on the robustness guarantees offered by random gossip communication, which allows autonomous agents to compute a global ranking consensus using local interactions only, without coordination or a central authority."},{"descriptionType":"Other","description":"33 pages, 5 figures"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.22847","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T02:56:14Z","registered":"2026-02-27T02:56:15Z","published":null,"updated":"2026-05-14T02:55:26Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.22626","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.22626","identifiers":[{"identifier":"2602.22626","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Byung Gyu","familyName":"Chae","name":"Chae, Byung Gyu","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Memory-Dominated Quantum Criticality as a Universal Route to High-Temperature Superconductivity"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Strongly Correlated Electrons (cond-mat.str-el)","lang":"en","subjectScheme":"arXiv"},{"subject":"Superconductivity (cond-mat.supr-con)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-26T04:58:35Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:24:43Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-03-02T09:45:49Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-03-03T02:54:00Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-03-09T02:29:18Z","dateType":"Submitted","dateInformation":"v3"},{"date":"2026-03-10T01:34:31Z","dateType":"Updated","dateInformation":"v3"},{"date":"2026-03-16T05:41:05Z","dateType":"Submitted","dateInformation":"v4"},{"date":"2026-03-17T01:52:11Z","dateType":"Updated","dateInformation":"v4"},{"date":"2026-03-30T10:43:25Z","dateType":"Submitted","dateInformation":"v5"},{"date":"2026-03-31T01:36:21Z","dateType":"Updated","dateInformation":"v5"},{"date":"2026-04-21T05:38:34Z","dateType":"Submitted","dateInformation":"v6"},{"date":"2026-04-22T00:34:30Z","dateType":"Updated","dateInformation":"v6"},{"date":"2026-05-13T11:46:36Z","dateType":"Submitted","dateInformation":"v7"},{"date":"2026-05-14T01:00:19Z","dateType":"Updated","dateInformation":"v7"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"7","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Understanding the dynamical origin of high-temperature superconductivity remains a central challenge in strongly correlated quantum matter. Near quantum criticality, diverging correlation times reorganize the infrared dynamics into a scale-free continuum of collective relaxation processes. We show that the infrared behavior of interacting electrons is generically controlled by the relaxation-rate spectrum of the underlying many-body dynamics. Starting from a microscopic fermionic theory, we derive that the Cooper-channel kernel admits a universal spectral representation in terms of the time-scale density of states (TDOS) of collective decay modes, without invoking a specific bosonic mediator. The superconducting instability follows directly from the vanishing of the quadratic kernel via a standard ladder resummation and Thouless criterion, with the pairing interaction determined entirely by the infrared structure of the relaxation spectrum. A finite TDOS at vanishing relaxation rate produces a memory-dominated regime characterized by long-time kernels $K(t)\\sim 1/t$ and logarithmic enhancement of the retarded pairing interaction, leading to a BCS-like exponential transition scale set by infrared spectral weight. More generally, infrared-singular spectra generate power-law response and algebraic enhancement of the transition scale. The same relaxation spectrum controls normal-state dynamics, giving rise to long-time correlations, non-Markovian response, and strange-metal behavior. These results identify the spectral organization of relaxation modes as a universal organizing principle of quantum critical matter and establish memory-dominated criticality as a natural mechanism for enhanced pairing."},{"descriptionType":"Other","description":"39 pages, 5 figures"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.22626","contentUrl":null,"metadataVersion":6,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T02:50:47Z","registered":"2026-02-27T02:50:48Z","published":null,"updated":"2026-05-14T02:55:25Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.22455","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.22455","identifiers":[{"identifier":"2602.22455","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Giuseppe","familyName":"Lando","name":"Lando, Giuseppe","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Rosario","familyName":"Forte","name":"Forte, Rosario","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Antonino","familyName":"Furnari","name":"Furnari, Antonino","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Exploring Multimodal LMMs for Online Episodic Memory Question Answering on the Edge"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-25T22:30:56Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:10:24Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-05-13T08:21:34Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-05-14T00:46:51Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"We investigate the feasibility of using Multimodal Large Language Models (MLLMs) for real-time online episodic memory question answering. While cloud offloading is common, it raises privacy and latency concerns for wearable assistants, hence we investigate implementation on the edge. We integrated streaming constraints into our question answering pipeline, which is structured into two asynchronous threads: a Descriptor Thread that continuously converts video into a lightweight textual memory, and a Question Answering (QA) Thread that reasons over the textual memory to answer queries. Experiments on the QAEgo4D-Closed benchmark analyze the performance of Multimodal Large Language Models (MLLMs) within strict resource boundaries, showing promising results also when compared to clound-based solutions. Specifically, an end-to-end configuration running on a consumer-grade 8GB GPU achieves 51.76% accuracy with a Time-To-First-Token (TTFT) of 0.41s. Scaling to a local enterprise-grade server yields 54.40% accuracy with a TTFT of 0.88s. In comparison, a cloud-based solution obtains an accuracy of 56.00%. These competitive results highlight the potential of edge-based solutions for privacy-preserving episodic memory retrieval."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.22455","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T02:46:46Z","registered":"2026-02-27T02:46:46Z","published":null,"updated":"2026-05-14T02:55:23Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.22507","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.22507","identifiers":[{"identifier":"2602.22507","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Zhuoyang","familyName":"Jiang","name":"Jiang, Zhuoyang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Dongqing","familyName":"Zhang","name":"Zhang, Dongqing","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Space Syntax-guided Post-training for Residential Floor Plan Generation"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-26T00:54:38Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:13:35Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-05-12T01:27:47Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-05-13T00:23:49Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Residential floor plan generation requires not only geometric fidelity but also spatial configurational logic: shared living spaces should be integrative, while private spaces should remain segregated. Existing generators increasingly use room-relation graphs as input-side conditions, but generated layouts are rarely evaluated on the output side for configurational quality, and such evaluation is rarely fed back into model optimization. We propose Space Syntax-guided Post-training (SSPT), a framework that turns space-syntax integration from a post-hoc analysis tool into a computable feedback signal for already-trained floor plan generators. SSPT introduces the Space Syntax Integration Oracle (SSIO), which converts generated layouts into rectangle-space graphs and measures public-space dominance and functional hierarchy. SSIO is first applied to real residential data to establish empirical configurational references, then connected to two SSPT strategies: SSPT-Iter, a basic generate-filter-retrain route, and SSPT-PPO, the first RL-based post-training route for floor plan generation. We also introduce SSPT-Bench, a new evaluation system for measuring the output-side spatial configurational quality of post-trained generators under an out-of-distribution setting. Experiments show that both strategies improve public-space dominance and functional-hierarchy alignment over the unpost-trained baseline. SSPT-PPO achieves stronger gains, lower variance, and higher efficiency than iterative retraining. These results show that output-side configurational evaluation can serve as actionable post-training feedback, offering a practical path for injecting architectural theory into existing floor plan generation backbones."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.22507","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T02:47:57Z","registered":"2026-02-27T02:47:58Z","published":null,"updated":"2026-05-13T03:01:52Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.22953","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.22953","identifiers":[{"identifier":"2602.22953","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Elron","familyName":"Bandel","name":"Bandel, Elron","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Asaf","familyName":"Yehudai","name":"Yehudai, Asaf","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Lilach","familyName":"Eden","name":"Eden, Lilach","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yehoshua","familyName":"Sagron","name":"Sagron, Yehoshua","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yotam","familyName":"Perlitz","name":"Perlitz, Yotam","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Elad","familyName":"Venezian","name":"Venezian, Elad","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Natalia","familyName":"Razinkov","name":"Razinkov, Natalia","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Natan","familyName":"Ergas","name":"Ergas, Natan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Shlomit Shachor","familyName":"Ifergan","name":"Ifergan, Shlomit Shachor","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Segev","familyName":"Shlomov","name":"Shlomov, Segev","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Michal","familyName":"Jacovi","name":"Jacovi, Michal","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Leshem","familyName":"Choshen","name":"Choshen, Leshem","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Liat","familyName":"Ein-Dor","name":"Ein-Dor, Liat","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yoav","familyName":"Katz","name":"Katz, Yoav","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Michal","familyName":"Shmueli-Scheuer","name":"Shmueli-Scheuer, Michal","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"General Agent Evaluation"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-26T12:48:02Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:43:32Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-05-11T10:27:38Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-05-12T02:00:27Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"General-purpose agents perform tasks in unfamiliar environments without domain-specific manual customization. Yet no study has systematically measured how agent architecture shapes performance across heterogeneous protocols and diverse unfamiliar environments. This is the first systematic study, comparing tool-calling, MCP, code-generation, and CLI agents on the same benchmarks with the same models. Two gaps blocked such a study: existing harnesses require per-benchmark wiring or fixed protocol classes (web for BrowserGym, CLI for Harbor), and benchmarks themselves expect human-authored prompts, context, and integration glue. To enable this study, we contribute (1) a unifying protocol that bridges existing benchmark and agent protocols; (2) an evaluation harness that surfaces any benchmark to any general-purpose agent and backbone model; and (3) the first Open General Agent Leaderboard of agent configurations, a full factorial over 5 agent architectures x 5 backbone LLMs (three closed-source, two open-weight) x 6 benchmarks spanning software engineering, customer service, deep research, and personal assistance. We find that (i) general agents adapt to every tested domain without per-domain customization; (ii) agent architecture choice swings results by up to 12pp within a single model, yet backbone model choice dominates overall performance; (iii) on 4 of 6 tested benchmarks, top general agents are indistinguishable from the leading heavily-customized domain-specific agents; (iv) open-weight models tested exhibit \"generality sinks\" absent from frontier closed-source models: they consistently collapse on specific agent architectures or benchmarks; (v) a behavioral failure analysis reveals architecture-distinctive error signatures that aggregate scoring cannot discriminate. Code, harness, leaderboard, and traces are at https://www.exgentic.ai."},{"descriptionType":"Other","description":"Presented at the ICLR 2026 Workshop on Agents in the Wild"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.22953","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":2,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T02:58:51Z","registered":"2026-02-27T02:58:51Z","published":null,"updated":"2026-05-12T05:12:59Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.22551","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.22551","identifiers":[{"identifier":"2602.22551","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Rick S. H.","familyName":"Willemsen","name":"Willemsen, Rick S. H.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Tenindra","familyName":"Abeywickrama","name":"Abeywickrama, Tenindra","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ramu","familyName":"Anandakrishnan","name":"Anandakrishnan, Ramu","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Identifying Multi-Hit Cancer Drivers Without Massive Parallelization: A CP, MIP, and Column Generation Framework"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Optimization and Control (math.OC)","lang":"en","subjectScheme":"arXiv"},{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"G.1.6; G.2.0","lang":"en","subjectScheme":"ACM"}],"contributors":[],"dates":[{"date":"2026-02-26T02:45:04Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:18:14Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-05-11T02:43:59Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-05-12T01:36:48Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Cancer is often driven by specific combinations of an estimated two to nine gene mutations, known as multi-hit combinations. Identifying these multi-hit combinations of gene mutations that drive cancer is critical for understanding carcinogenesis and designing targeted therapies. We formalize this challenge as the Multi-Hit Cancer Driver Set Cover Problem (MHCDSCP), optimizing the selection of gene combinations to maximize tumor coverage while strictly minimizing normal sample misclassification. While existing approaches rely on exhaustive enumeration and massive parallelization, we introduce fast heuristics based on constraint programming and mixed integer programming formulations. Evaluated on real-world cancer genomics data, our framework matches state-of-the-art supercomputing methods using a single commodity CPU in under a minute. We also propose a price-and-branch heuristic which, by solving the root node to optimality, provides the first provably optimal solutions for over half of the benchmark instances, thereby verifying the near-optimality of our fast heuristics. These findings demonstrate that on real-world problem instances, the MHCDSCP is far less computationally demanding than previously believed, providing an accessible baseline that enables the exploration of previously intractable multi-hit modeling assumptions."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.22551","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T02:49:00Z","registered":"2026-02-27T02:49:01Z","published":null,"updated":"2026-05-12T05:12:56Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.22457","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.22457","identifiers":[{"identifier":"2602.22457","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","affiliation":["UC Merced"],"givenName":"Dong","familyName":"Xu","name":"Xu, Dong","nameIdentifiers":[]},{"nameType":"Personal","affiliation":["UC Merced"],"givenName":"Han","familyName":"Meng","name":"Meng, Han","nameIdentifiers":[]},{"nameType":"Personal","affiliation":["Zhejinag University"],"givenName":"Xinyu","familyName":"Chen","name":"Chen, Xinyu","nameIdentifiers":[]},{"nameType":"Personal","affiliation":["Bytedance and"],"givenName":"Dengcheng","familyName":"Zhu","name":"Zhu, Dengcheng","nameIdentifiers":[]},{"nameType":"Personal","affiliation":["Bytedance and"],"givenName":"Wei","familyName":"Tang","name":"Tang, Wei","nameIdentifiers":[]},{"nameType":"Personal","affiliation":["Bytedance and"],"givenName":"Fei","familyName":"Liu","name":"Liu, Fei","nameIdentifiers":[]},{"nameType":"Personal","affiliation":["Bytedance and"],"givenName":"Liguang","familyName":"Xie","name":"Xie, Liguang","nameIdentifiers":[]},{"nameType":"Personal","affiliation":["Bytedance and"],"givenName":"Wu","familyName":"Xiang","name":"Xiang, Wu","nameIdentifiers":[]},{"nameType":"Personal","affiliation":["Bytedance and"],"givenName":"Rui","familyName":"Shi","name":"Shi, Rui","nameIdentifiers":[]},{"nameType":"Personal","affiliation":["Bytedance and"],"givenName":"Yue","familyName":"Li","name":"Li, Yue","nameIdentifiers":[]},{"nameType":"Personal","affiliation":["Bytedance and"],"givenName":"Henry","familyName":"Hu","name":"Hu, Henry","nameIdentifiers":[]},{"nameType":"Personal","affiliation":["Bytedance and"],"givenName":"Hui","familyName":"Zhang","name":"Zhang, Hui","nameIdentifiers":[]},{"nameType":"Personal","affiliation":["Xconn-tech"],"givenName":"Jianping","familyName":"Jiang","name":"Jiang, Jianping","nameIdentifiers":[]},{"nameType":"Personal","affiliation":["UC Merced"],"givenName":"Dong","familyName":"Li","name":"Li, Dong","nameIdentifiers":[]}],"titles":[{"title":"CCCL: Node-Spanning GPU Collectives with CXL Memory Pooling"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Distributed, Parallel, and Cluster Computing (cs.DC)","lang":"en","subjectScheme":"arXiv"},{"subject":"Emerging Technologies (cs.ET)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-25T22:38:46Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:10:34Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-05-05T05:18:40Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-05-06T00:24:00Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-05-06T19:02:10Z","dateType":"Submitted","dateInformation":"v3"},{"date":"2026-05-08T00:05:50Z","dateType":"Updated","dateInformation":"v3"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"3","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Large language models (LLMs) training or inference across multiple nodes introduces significant pressure on GPU memory and interconnect bandwidth. The Compute Express Link (CXL) shared memory pool offers a scalable solution by enabling memory sharing across nodes, reducing over-provisioning and improving resource utilization. We propose \\name, a collective communication library, leveraging the CXL shared memory pool to support cross-node GPU operations without relying on traditional RDMA-based networking. Our design addresses the challenges on synchronization, data interleaving, and communication parallelization faced by using the CXL shared memory pool for collective communications. Evaluating on multiple nodes with a TITAN-II CXL switch and six Micron CZ120 memory cards, we show that \\name achieves highly efficient collective operations across hosts, demonstrating CXL's potential for scalable, memory-centric GPU communication. Our evaluation demonstrates that \\name achieves average performance improvements of 1.34$\\times$ for AllGather, 1.84$\\times$ for Broadcast, 1.94$\\times$ for Gather, and 1.04$\\times$ for Scatter, compared to the original RDMA-based implementation over 200 Gbps InfiniBand. \\textcolor{dong}{In addition, the evaluation with a case of LLM training shows 1.11$\\times$ speedup compared with the InfiniBand while saving production cost by $2.75\\times$ in hardware.}"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.22457","contentUrl":null,"metadataVersion":2,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T02:46:48Z","registered":"2026-02-27T02:46:49Z","published":null,"updated":"2026-05-08T12:55:29Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.22591","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.22591","identifiers":[{"identifier":"2602.22591","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Haodong","familyName":"Chen","name":"Chen, Haodong","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Shengyao","familyName":"Zhuang","name":"Zhuang, Shengyao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zheng","familyName":"Yao","name":"Yao, Zheng","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Guido","familyName":"Zuccon","name":"Zuccon, Guido","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Teerapong","familyName":"Leelanupab","name":"Leelanupab, Teerapong","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Where Relevance Emerges: A Layer-Wise Study of Internal Attention for Zero-Shot Re-Ranking"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Information Retrieval (cs.IR)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"H.3.3","lang":"en","subjectScheme":"ACM"}],"contributors":[],"dates":[{"date":"2026-02-26T03:51:31Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:21:46Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-04-25T11:08:33Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-04-28T00:28:57Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[{"relationType":"IsVersionOf","relatedIdentifier":"10.1145/3805712.3808558","relatedIdentifierType":"DOI"}],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Zero-shot document re-ranking with Large Language Models (LLMs) has evolved from Pointwise methods to Listwise and Setwise approaches that optimize computational efficiency. Despite their success, these methods predominantly rely on generative scoring or output logits, which face bottlenecks in inference latency and result consistency. In-Context Re-ranking (ICR) has recently been proposed as an O(1) alternative method. ICR extracts internal attention signals directly, avoiding the overhead of text generation. However, existing ICR methods simply aggregate signals across all layers; layer-wise contributions and their consistency across architectures have been left unexplored. Furthermore, no unified study has compared internal attention with traditional generative and likelihood-based mechanisms across diverse ranking frameworks under consistent conditions.\n In this paper, we conduct an orthogonal evaluation of generation, likelihood, and internal attention mechanisms across multiple ranking frameworks. We further identify a universal \"bell-curve\" distribution of relevance signals across transformer layers, which motivates the proposed Selective-ICR strategy that reduces inference latency by 30%-50% without compromising effectiveness. Finally, evaluation on the reasoning-intensive BRIGHT benchmark shows that precisely capturing high-quality in-context attention signals fundamentally reduces the need for model scaling and reinforcement learning: a zero-shot 8B model matches the performance of 14B reinforcement-learned re-rankers, while even a 0.6B model outperforms state-of-the-art generation-based approaches. These findings redefine the efficiency-effectiveness frontier for LLM-based re-ranking and highlight the latent potential of internal signals for complex reasoning ranking tasks. Our code and results are publicly available at https://github.com/ielab/Selective-ICR."},{"descriptionType":"Other","description":"Accepted by SIGIR 2026. 10 pages, 5 figures, 4 tables. Code available at https://github.com/ielab/Selective-ICR"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.22591","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T02:49:58Z","registered":"2026-02-27T02:49:58Z","published":null,"updated":"2026-04-28T04:12:15Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.22525","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.22525","identifiers":[{"identifier":"2602.22525","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Zhonghao","familyName":"Zhan","name":"Zhan, Zhonghao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Krinos","familyName":"Li","name":"Li, Krinos","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yefan","familyName":"Zhang","name":"Zhang, Yefan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Hamed","familyName":"Haddadi","name":"Haddadi, Hamed","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Systems-Level Attack Surface of Edge Agent Deployments on IoT"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Cryptography and Security (cs.CR)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-26T01:48:46Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:15:03Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-04-21T21:13:49Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-04-23T00:11:03Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Edge deployment of LLM agents on IoT hardware introduces attack surfaces absent from cloud-hosted orchestration. We present an empirical security analysis of three architectures (cloud-hosted, edge-local swarm, and hybrid) using a multi-device home-automation testbed with local MQTT messaging and an Android smartphone as an edge inference node. We identify five systems-level attack surfaces, including two emergent failures observed during live testbed operation: coordination-state divergence and induced trust erosion. We frame core security properties as measurable systems metrics: data egress volume, failover window exposure, sovereignty boundary integrity, and provenance chain completeness. Our measurements show that edge-local deployments eliminate routine cloud data exposure but silently degrade sovereignty when fallback mechanisms trigger, with boundary crossings invisible at the application layer. Provenance chains remain complete under cooperative operation yet are trivially bypassed without cryptographic enforcement. Failover windows create transient blind spots exploitable for unauthorised actuation. These results demonstrate that deployment architecture, not just model or prompt design, is a primary determinant of security risk in agent-controlled IoT systems."},{"descriptionType":"Other","description":"Proceedings of the 6th Workshop on Machine Learning and Systems (EuroMLSys '26), co-located with EuroSys 2026"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.22525","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T02:48:23Z","registered":"2026-02-27T02:48:24Z","published":null,"updated":"2026-04-23T02:26:37Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.22437","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.22437","identifiers":[{"identifier":"2602.22437","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Zezhou","familyName":"Wang","name":"Wang, Zezhou","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Youjie","familyName":"Li","name":"Li, Youjie","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zhiqi","familyName":"Lin","name":"Lin, Zhiqi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jiacheng","familyName":"Yang","name":"Yang, Jiacheng","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Cong","familyName":"Xie","name":"Xie, Cong","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Guanyu","familyName":"Feng","name":"Feng, Guanyu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zheng","familyName":"Zhong","name":"Zhong, Zheng","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ziyue","familyName":"Huang","name":"Huang, Ziyue","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Hongyu","familyName":"Zhu","name":"Zhu, Hongyu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zhi","familyName":"Zhang","name":"Zhang, Zhi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yanghua","familyName":"Peng","name":"Peng, Yanghua","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xin","familyName":"Liu","name":"Liu, Xin","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"veScale-FSDP: Flexible and High-Performance FSDP at Scale"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Distributed, Parallel, and Cluster Computing (cs.DC)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-25T21:55:43Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:09:45Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02-27T03:28:11Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-03-02T01:19:01Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-04-21T21:24:42Z","dateType":"Submitted","dateInformation":"v3"},{"date":"2026-04-23T00:11:50Z","dateType":"Updated","dateInformation":"v3"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"3","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by-nc-nd/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution Non Commercial No Derivatives 4.0 International","rightsIdentifier":"cc-by-nc-nd-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Fully Sharded Data Parallel (FSDP), also known as Zero Redundancy Optimizer (ZeRO), is widely used for large-scale model training, because of its memory efficiency and minimal intrusion on model code. However, existing FSDP systems rely on fixed element-wise or row-wise sharding formats that conflict with block-structured computations. As a result, they struggle to support modern structure-aware training methods, including block-wise quantization and non-element-wise optimizers such as Shampoo and Muon. In addition, today's implementations incur communication and memory overheads that degrade efficiency at the scale of tens of thousands of GPUs. We introduce veScale-FSDP, a novel FSDP system that combines RaggedShard, a flexible sharding format, with a structure-aware planning algorithm to deliver both flexibility and performance. veScale-FSDP enables zero-copy FSDP communications and natively supports block-wise quantization and non-element-wise optimizers, achieving 5% to 66% higher throughput and 16% to 30% lower memory usage than existing FSDP systems, while scaling efficiently to tens of thousands of GPUs."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.22437","contentUrl":null,"metadataVersion":2,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T02:46:22Z","registered":"2026-02-27T02:46:23Z","published":null,"updated":"2026-04-23T02:26:36Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.22378","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.22378","identifiers":[{"identifier":"2602.22378","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Daniel","familyName":"Rossato","name":"Rossato, Daniel","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Thiago Alberto Rigo","familyName":"Passarin","name":"Passarin, Thiago Alberto Rigo","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Gustavo Pinto","familyName":"Pires","name":"Pires, Gustavo Pinto","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Daniel Rodrigues","familyName":"Pipa","name":"Pipa, Daniel Rodrigues","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Full Waveform Inversion using the Wasserstein metric for ultrasound transducer array based NDT"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Signal Processing (eess.SP)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Electrical engineering, electronic engineering, information engineering","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Electrical engineering, electronic engineering, information engineering","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-25T20:21:41Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:06:28Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-04-22T12:54:18Z","dateType":"Withdrawn","dateInformation":"v2; Paper will undergo a large revision"},{"date":"2026-04-23T00:50:13Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Ultrasonic imaging methods often assume linear direct models, while in reality, many nonlinear phenomena are present, e.g. multiple reflections. A family of imaging methods called Full Waveform Inversion (FWI), which has been developed in the field of seismic imaging, uses full acoustic wave simulations as direct models, taking into account virtually all nonlinearities, which can ultimately enhance the accuracy of ultrasonic imaging. However, the problem of cycle skipping -- the existence of many local minima of the Least Squares (L2) misfit function due to the oscillatory nature of the signals -- is worsened when FWI is applied to ultrasound data because of a lack of low-frequency components. In this paper, we explore the use of the squared Wasserstein (W2) Optimal Transport Distance as the metric for the misfit between the acquired and the synthetic data, applying the method to Nondestructive Evaluation with ultrasonic phased arrays. An analytical continuous time-domain derivation of the adjoint acoustic field related to the W2 misfit is presented and used for the computation of the gradients. To cope with the computational burden of FWI, we apply a low-memory strategy that allows for the computation of the gradients without the storage of the full simulated fields. The GPU implementation of the method (in CUDA language) is detailed, and the source code is made available. Six prototypical cases are presented, and the corresponding sound speed maps are reconstructed with FWI using both the L2 and the W2 misfit functionals. In five of the six cases, the pixel-wise sum of squared errors obtained with W2 was at least one order of magnitude lower than that obtained with W2, with an increase in the gradient computation time not exceeding 2\\%. The results highlight both the adequacy of the W2 misfit for ultrasonic FWI with phased arrays and its computational feasibility."},{"descriptionType":"Other","description":"Paper will undergo a large revision"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.22378","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T02:45:01Z","registered":"2026-02-27T02:45:01Z","published":null,"updated":"2026-04-23T02:26:35Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.22913","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.22913","identifiers":[{"identifier":"2602.22913","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Yang","familyName":"Yu","name":"Yu, Yang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Lei","familyName":"Kou","name":"Kou, Lei","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Huaikuan","familyName":"Yi","name":"Yi, Huaikuan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Bin","familyName":"Chen","name":"Chen, Bin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yayu","familyName":"Cao","name":"Cao, Yayu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Lei","familyName":"Shen","name":"Shen, Lei","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Chao","familyName":"Zhang","name":"Zhang, Chao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Bing","familyName":"Wang","name":"Wang, Bing","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xiaoyi","familyName":"Zeng","name":"Zeng, Xiaoyi","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"SIGMA: A Semantic-Grounded Instruction-Driven Generative Multi-Task Recommender at AliExpress"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Information Retrieval (cs.IR)","lang":"en","subjectScheme":"arXiv"},{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-26T12:00:46Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:41:29Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-04-19T12:51:50Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-04-21T01:11:18Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"With the rapid evolution of Large Language Models (LLMs), generative recommendation is gradually reshaping the paradigm of recommender systems. However, most existing methods remain confined to the interaction-driven next-item prediction paradigm, struggling to keep pace with the latest evolving trends or address the diverse recommendation tasks along with business-specific requirements in real-world scenarios. To this end, we present SIGMA, a Semantic-Grounded Instruction-Driven Generative Multi-Task Recommender deployed at AliExpress. Specifically, we first ground item entities in a unified latent space capturing both general semantics and collaborative signals. Building upon this, we introduce a hybrid item tokenization method for both precise modeling and efficient generation. Moreover, we construct a large-scale multi-task supervised fine-tuning dataset empowering SIGMA to fulfill various recommendation demands via instruction-following. Finally, we design a three-step item generation procedure integrated with an adaptive probabilistic fusion mechanism to calibrate the output distributions based on task-specific requirements for recommendation accuracy and diversity. Extensive offline experiments and online A/B tests demonstrate the effectiveness of SIGMA across various real-world recommendation tasks."},{"descriptionType":"Other","description":"Accepted by SIGIR 2026 Industry Track. 5 pages, 3 figures"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.22913","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T02:57:50Z","registered":"2026-02-27T02:57:50Z","published":null,"updated":"2026-04-21T04:59:12Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.22639","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.22639","identifiers":[{"identifier":"2602.22639","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Daniel","familyName":"Miao","name":"Miao, Daniel","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Gilad","familyName":"Lerman","name":"Lerman, Gilad","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Joe","familyName":"Kileel","name":"Kileel, Joe","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"QuadSync: Quadrifocal Tensor Synchronization via Tucker Decomposition"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"Numerical Analysis (math.NA)","lang":"en","subjectScheme":"arXiv"},{"subject":"Optimization and Control (math.OC)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-26T05:42:17Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:26:02Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-04-20T04:50:31Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-04-21T01:40:09Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by-nc-sa/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution Non Commercial Share Alike 4.0 International","rightsIdentifier":"cc-by-nc-sa-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"In structure from motion, quadrifocal tensors capture more information than their pairwise counterparts (essential matrices), yet they have often been thought of as impractical and only of theoretical interest. In this work, we challenge such beliefs by providing a new framework to recover $n$ cameras from the corresponding collection of quadrifocal tensors. We form the block quadrifocal tensor and show that it admits a Tucker decomposition whose factor matrices are the stacked camera matrices, and which thus has a multilinear rank of (4,~4,~4,~4) independent of $n$. We develop the first synchronization algorithm for quadrifocal tensors, using Tucker decomposition, alternating direction method of multipliers, and iteratively reweighted least squares. We further establish relationships between the block quadrifocal, trifocal, and bifocal tensors, and introduce an algorithm that jointly synchronizes these three entities. Numerical experiments demonstrate the effectiveness of our methods on modern datasets, indicating the potential and importance of using higher-order information in synchronization."},{"descriptionType":"Other","description":"30 pages, accepted to CVPR 2026 as an Oral Presentation. Complementary code can be found at github.com/dmiao153/QuadSync"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.22639","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T02:51:06Z","registered":"2026-02-27T02:51:07Z","published":null,"updated":"2026-04-21T04:59:11Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.22479","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.22479","identifiers":[{"identifier":"2602.22479","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Afshin","familyName":"Khadangi","name":"Khadangi, Afshin","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Efficient Continual Learning in Language Models via Thalamically Routed Cortical Columns"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-25T23:38:16Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:11:58Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-03-15T15:57:48Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-03-17T01:25:27Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-03-17T17:02:11Z","dateType":"Submitted","dateInformation":"v3"},{"date":"2026-03-18T01:23:53Z","dateType":"Updated","dateInformation":"v3"},{"date":"2026-03-25T15:46:31Z","dateType":"Submitted","dateInformation":"v4"},{"date":"2026-03-26T01:04:23Z","dateType":"Updated","dateInformation":"v4"},{"date":"2026-03-27T10:50:18Z","dateType":"Submitted","dateInformation":"v5"},{"date":"2026-03-30T00:42:31Z","dateType":"Updated","dateInformation":"v5"},{"date":"2026-04-17T17:13:27Z","dateType":"Submitted","dateInformation":"v6"},{"date":"2026-04-20T01:01:41Z","dateType":"Updated","dateInformation":"v6"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"6","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Large language models deployed in the wild must adapt to evolving data, user behavior, and task mixtures without erasing previously acquired capabilities. In practice, this remains difficult: sequential updates induce catastrophic forgetting, while many stabilization methods rely on external procedures that are costly, brittle, or difficult to scale. We present TRC$^{2}$ (Thalamically Routed Cortical Columns), a decoder-only architecture that makes continual learning a property of the backbone itself. TRC$^{2}$ combines stacked cortical columns with a thalamic modulatory pathway for selective inter-column communication and a hippocampal pathway for event selective retrieval, delayed surprise-based writing, and replay-driven consolidation. This design localizes fast plasticity while preserving a slower stable computation pathway. We further introduce a causal memory-update scheme and an online replay controller that adjusts consolidation strength from measured forgetting. Across a task-sequential language-modeling stream over C4, WikiText-103, and GSM8K, TRC$^{2}$ consistently improves task-boundary modeling quality and substantially reduces cumulative forgetting relative to Transformer, Mamba, MoE, DeepSeek and continual learning baselines trained under the same pipeline. Ablations show that the thalamic and hippocampal components are central to the retention gains, while the full model remains competitive in throughput and training cost."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.22479","contentUrl":null,"metadataVersion":5,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T02:47:19Z","registered":"2026-02-27T02:47:20Z","published":null,"updated":"2026-04-20T02:12:53Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.23061","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.23061","identifiers":[{"identifier":"2602.23061","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Bangrui","familyName":"Xu","name":"Xu, Bangrui","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Qihang","familyName":"Yao","name":"Yao, Qihang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zirui","familyName":"Tang","name":"Tang, Zirui","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xuanhe","familyName":"Zhou","name":"Zhou, Xuanhe","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yeye","familyName":"He","name":"He, Yeye","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Shihan","familyName":"Yu","name":"Yu, Shihan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Qianqian","familyName":"Xu","name":"Xu, Qianqian","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Bin","familyName":"Wang","name":"Wang, Bin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Guoliang","familyName":"Li","name":"Li, Guoliang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Conghui","familyName":"He","name":"He, Conghui","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Fan","familyName":"Wu","name":"Wu, Fan","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"MoDora: Tree-Based Semi-Structured Document Analysis System"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Information Retrieval (cs.IR)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"Databases (cs.DB)","lang":"en","subjectScheme":"arXiv"},{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-26T14:48:49Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:49:58Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02-27T08:09:20Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-03-02T01:31:33Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-04-14T04:49:27Z","dateType":"Submitted","dateInformation":"v3"},{"date":"2026-04-15T00:26:19Z","dateType":"Updated","dateInformation":"v3"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"3","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Semi-structured documents integrate diverse interleaved data elements (e.g., tables, charts, hierarchical paragraphs) arranged in various and often irregular layouts. These documents are widely observed across domains and account for a large portion of real-world data. However, existing methods struggle to support natural language question answering over these documents due to three main technical challenges: (1) The elements extracted by techniques like OCR are often fragmented and stripped of their original semantic context, making them inadequate for analysis. (2) Existing approaches lack effective representations to capture hierarchical structures within documents (e.g., associating tables with nested chapter titles) and to preserve layout-specific distinctions (e.g., differentiating sidebars from main content). (3) Answering questions often requires retrieving and aligning relevant information scattered across multiple regions or pages, such as linking a descriptive paragraph to table cells located elsewhere in the document.\n To address these issues, we propose MoDora, an LLM-powered system for semi-structured document analysis. First, we adopt a local-alignment aggregation strategy to convert OCR-parsed elements into layout-aware components, and conduct type-specific information extraction for components with hierarchical titles or non-text elements. Second, we design the Component-Correlation Tree (CCTree) to hierarchically organize components, explicitly modeling inter-component relations and layout distinctions through a bottom-up cascade summarization process. Finally, we propose a question-type-aware retrieval strategy that supports (1) layout-based grid partitioning for location-based retrieval and (2) LLM-guided pruning for semantic-based retrieval. Experiments show MoDora outperforms baselines by 5.97%-61.07% in accuracy. The code is at https://github.com/weAIDB/MoDora."},{"descriptionType":"Other","description":"Extension of our SIGMOD 2026 paper. Please refer to source code available at https://github.com/weAIDB/MoDora"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.23061","contentUrl":null,"metadataVersion":2,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T03:01:30Z","registered":"2026-02-27T03:01:31Z","published":null,"updated":"2026-04-15T02:27:51Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.23195","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.23195","identifiers":[{"identifier":"2602.23195","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Alexander G.","familyName":"Tevzadze","name":"Tevzadze, Alexander G.","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Spectral Universality of Turbulent Fluctuations in Relativistic Flows"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"High Energy Astrophysical Phenomena (astro-ph.HE)","lang":"en","subjectScheme":"arXiv"},{"subject":"General Relativity and Quantum Cosmology (gr-qc)","lang":"en","subjectScheme":"arXiv"},{"subject":"High Energy Physics - Theory (hep-th)","lang":"en","subjectScheme":"arXiv"},{"subject":"Plasma Physics (physics.plasm-ph)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-26T16:47:59Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:56:45Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-04-12T00:25:47Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-04-14T00:49:37Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"We develop a Lorentz-covariant framework for projecting spacetime spectra into temporal spectra of stationary turbulent fluctuations in relativistic flows. For self-similar spacetime spectra, we derive a universal scaling relation, $α= β- D$, where $α$ is the temporal spectral index, $β$ the spacetime homogeneity exponent, and $D$ the effective dimensionality of spectral support. We further demonstrate that this universality breaks down when spacetime homogeneity is violated. Temporal spectra in relativistic flows are thus intrinsically nonlocal observables, requiring a covariant projection framework that establishes a general principle for spectral inference in relativistic plasma turbulence and high-energy plasma flows."},{"descriptionType":"Other","description":"Submitted to Journal of Plasma Physics"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.23195","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T03:04:48Z","registered":"2026-02-27T03:04:49Z","published":null,"updated":"2026-04-14T04:26:02Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.22683","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.22683","identifiers":[{"identifier":"2602.22683","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Zhuohang","familyName":"Jiang","name":"Jiang, Zhuohang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xu","familyName":"Yuan","name":"Yuan, Xu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Haohao","familyName":"Qu","name":"Qu, Haohao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Shanru","familyName":"Lin","name":"Lin, Shanru","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Kanglong","familyName":"Liu","name":"Liu, Kanglong","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Wenqi","familyName":"Fan","name":"Fan, Wenqi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Qing","familyName":"Li","name":"Li, Qing","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"SUPERGLASSES: Benchmarking Vision Language Models as Intelligent Agents for AI Smart Glasses"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-26T06:55:48Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:29:00Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-04-09T08:16:21Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-04-10T00:37:06Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"The rapid advancement of AI-powered smart glasses-one of the hottest wearable devices-has unlocked new frontiers for multimodal interaction, with Visual Question Answering (VQA) over external knowledge sources emerging as a core application. Existing Vision Language Models (VLMs) adapted to smart glasses are typically trained and evaluated on traditional multimodal datasets; however, these datasets lack the variety and realism needed to reflect smart glasses usage scenarios and diverge from their specific challenges, where accurately identifying the object of interest must precede any external knowledge retrieval. To bridge this gap, we introduce SUPER- GLASSES, the first comprehensive VQA benchmark built on real-world data entirely collected by smart glasses devices. SUPERGLASSES comprises 2,422 egocentric image-question pairs spanning 14 image domains and 8 query categories, enriched with full search trajectories and reasoning annotations. We evaluate 26 representative VLMs on this benchmark, revealing significant performance gaps. To address the limitations of existing models, we further propose the SUPERLENS, a multimodal smart glasses agent that enables retrieval-augmented answer generation by integrating automatic object detection, query decoupling, and multimodal web search. SUPERLENS achieves state-of-the-art performance, outperforming GPT-4o by 2.19%, underscoring the need for task-specific solutions in smart glasses VQA. Our dataset is publicly available at https://huggingface.co/datasets/xandery/SuperGlasses."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.22683","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T02:52:09Z","registered":"2026-02-27T02:52:10Z","published":null,"updated":"2026-04-10T02:28:53Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.22220","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.22220","identifiers":[{"identifier":"2602.22220","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Bowei","familyName":"Zhang","name":"Zhang, Bowei","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jin","familyName":"Xiao","name":"Xiao, Jin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Guanglei","familyName":"Yue","name":"Yue, Guanglei","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Qianyu","familyName":"He","name":"He, Qianyu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yanghua","familyName":"Xiao","name":"Xiao, Yanghua","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Deqing","familyName":"Yang","name":"Yang, Deqing","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jiaqing","familyName":"Liang","name":"Liang, Jiaqing","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"What Makes an Ideal Quote? Recommending \"Unexpected yet Rational\" Quotations via Novelty"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Information Retrieval (cs.IR)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-12-15T12:19:37Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:00:16Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-04-08T09:41:00Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-04-09T00:39:12Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Quotation recommendation aims to enrich writing by suggesting quotes that complement a given context, yet existing systems mostly optimize surface-level topical relevance and ignore the deeper semantic and aesthetic properties that make quotations memorable. We start from two empirical observations. First, a systematic user study shows that people consistently prefer quotations that are ``unexpected yet rational'' in context, identifying novelty as a key desideratum. Second, we find that strong existing models struggle to fully understand the deep meanings of quotations. Inspired by defamiliarization theory, we therefore formalize quote recommendation as choosing contextually novel but semantically coherent quotations. We operationalize this objective with NovelQR, a novelty-driven quotation recommendation framework. A generative label agent first interprets each quotation and its surrounding context into multi-dimensional deep-meaning labels, enabling label-enhanced retrieval. A token-level novelty estimator then reranks candidates while mitigating auto-regressive continuation bias. Experiments on bilingual datasets spanning diverse real-world domains show that our system recommends quotations that human judges rate as more appropriate, more novel, and more engaging than other baselines, while matching or surpassing existing methods in novelty estimation."},{"descriptionType":"Other","description":"Accepted to ACL 2026 main conference ; Code available at"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.22220","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T02:41:20Z","registered":"2026-02-27T02:41:20Z","published":null,"updated":"2026-04-09T02:24:11Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.22459","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.22459","identifiers":[{"identifier":"2602.22459","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Yicheng","familyName":"Chen","name":"Chen, Yicheng","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jinjie","familyName":"Li","name":"Li, Jinjie","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Haokun","familyName":"Liu","name":"Liu, Haokun","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zicheng","familyName":"Luo","name":"Luo, Zicheng","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Kotaro","familyName":"Kaneko","name":"Kaneko, Kotaro","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Moju","familyName":"Zhao","name":"Zhao, Moju","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Hierarchical Trajectory Planning of Floating-Base Multi-Link Robot for Maneuvering in Confined Environments"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Robotics (cs.RO)","lang":"en","subjectScheme":"arXiv"},{"subject":"Systems and Control (eess.SY)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"FOS: Electrical engineering, electronic engineering, information engineering","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Electrical engineering, electronic engineering, information engineering","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-25T22:49:54Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-04-07T01:23:32Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[{"relationType":"IsVersionOf","relatedIdentifier":"10.1109/tase.2026.3669051","relatedIdentifierType":"DOI"}],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Floating-base multi-link robots can change their shape during flight, making them well-suited for applications in confined environments such as autonomous inspection and search and rescue. However, trajectory planning for such systems remains an open challenge because the problem lies in a high-dimensional, constraint-rich space where collision avoidance must be addressed together with kinematic limits and dynamic feasibility. This work introduces a hierarchical trajectory planning framework that integrates global guidance with configuration-aware local optimization. First, we exploit the dual nature of these robots - the root link as a rigid body for guidance and the articulated joints for flexibility - to generate global anchor states that decompose the planning problem into tractable segments. Second, we design a local trajectory planner that optimizes each segment in parallel with differentiable objectives and constraints, systematically enforcing kinematic feasibility and maintaining dynamic feasibility by avoiding control singularities. Third, we implement a complete system that directly processes point-cloud data, eliminating the need for handcrafted obstacle models. Extensive simulations and real-world experiments confirm that this framework enables an articulated aerial robot to exploit its morphology for maneuvering that rigid robots cannot achieve. To the best of our knowledge, this is the first planning framework for floating-base multi-link robots that has been demonstrated on a real robot to generate continuous, collision-free, and dynamically feasible trajectories directly from raw point-cloud inputs, without relying on handcrafted obstacle models."},{"descriptionType":"Other","description":"Accepted to IEEE T-ASE; DOI pending"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.22459","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":1,"created":"2026-02-27T02:46:51Z","registered":"2026-02-27T02:46:52Z","published":null,"updated":"2026-04-07T03:32:38Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.23032","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.23032","identifiers":[{"identifier":"2602.23032","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Omar","familyName":"Benhar","name":"Benhar, Omar","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Alessandro","familyName":"Lovato","name":"Lovato, Alessandro","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Nuclear binding, correlations, and the $A$-dependence of the EMC effect"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Nuclear Theory (nucl-th)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-26T14:13:24Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:47:59Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-04-03T07:18:59Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-04-06T00:28:30Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"The measurements of inclusive electron scattering from nuclear targets carried out at the Thomas Jefferson National Accelerator Facility in the mid 2000s have provided valuable novel information on the $A$-dependence of the modifications of nuclear structure functions known as EMC effect. We argue that these data are best described in terms of the scaling variable $\\widetilde{y}$, designed to take into account dynamical effects in interacting many-particle systems, and analyse the $A$-dependence of the slope of the inclusive cross section ratios, $R_A = (σ_A/A)/(σ_2/2)$, providing a measure of the size of the EMC effect in the region where nuclear binding plays a leading role. The results of our study clearly hint at a linear correlation between $dR_A(\\widetilde{y})/d\\widetilde{y}$ and the average nucleon removal energy $\\langle E_A \\rangle$. The role of correlation effects\n in the determination of $\\langle E_A \\rangle$ is highlighted."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.23032","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T03:00:49Z","registered":"2026-02-27T03:00:49Z","published":null,"updated":"2026-04-06T01:52:01Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.22732","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.22732","identifiers":[{"identifier":"2602.22732","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Ben","familyName":"Xue","name":"Xue, Ben","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Dan","familyName":"Liu","name":"Liu, Dan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Lixiang","familyName":"Wang","name":"Wang, Lixiang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Mingjie","familyName":"Sun","name":"Sun, Mingjie","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Peng","familyName":"Wang","name":"Wang, Peng","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Pengfei","familyName":"Zhang","name":"Zhang, Pengfei","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Shaoyun","familyName":"Shi","name":"Shi, Shaoyun","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Tianyu","familyName":"Xu","name":"Xu, Tianyu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yunhao","familyName":"Sha","name":"Sha, Yunhao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zhiqiang","familyName":"Liu","name":"Liu, Zhiqiang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Bo","familyName":"Kong","name":"Kong, Bo","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Bo","familyName":"Wang","name":"Wang, Bo","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Hang","familyName":"Yang","name":"Yang, Hang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jieting","familyName":"Xue","name":"Xue, Jieting","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Junhao","familyName":"Wang","name":"Wang, Junhao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Shengyu","familyName":"Wang","name":"Wang, Shengyu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Shuping","familyName":"Hui","name":"Hui, Shuping","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Wencai","familyName":"Ye","name":"Ye, Wencai","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xiao","familyName":"Lin","name":"Lin, Xiao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yongzhi","familyName":"Li","name":"Li, Yongzhi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yuhang","familyName":"Chen","name":"Chen, Yuhang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zhihui","familyName":"Yin","name":"Yin, Zhihui","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Quan","familyName":"Chen","name":"Chen, Quan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Shiyang","familyName":"Wen","name":"Wen, Shiyang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Wenjin","familyName":"Wu","name":"Wu, Wenjin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Han","familyName":"Li","name":"Li, Han","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Guorui","familyName":"Zhou","name":"Zhou, Guorui","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Changcheng","familyName":"Li","name":"Li, Changcheng","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Peng","familyName":"Jiang","name":"Jiang, Peng","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Kun","familyName":"Gai","name":"Gai, Kun","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Generative Recommendation for Large-Scale Advertising"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Information Retrieval (cs.IR)","lang":"en","subjectScheme":"arXiv"},{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-26T08:15:26Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:32:05Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-03-04T09:28:17Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-03-05T01:43:25Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-04-02T02:38:13Z","dateType":"Submitted","dateInformation":"v3"},{"date":"2026-04-03T00:19:56Z","dateType":"Updated","dateInformation":"v3"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"3","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Generative recommendation has recently attracted widespread attention in industry due to its potential for scaling and stronger model capacity. However, deploying real-time generative recommendation in large-scale advertising requires designs beyond large-language-model (LLM)-style training and serving recipes. We present a production-oriented generative recommender co-designed across architecture, learning, and serving, named GR4AD (Generative Recommendation for ADdvertising). As for tokenization, GR4AD proposes UA-SID (Unified Advertisement Semantic ID) to capture complicated business information. Furthermore, GR4AD introduces LazyAR, a lazy autoregressive decoder that relaxes layer-wise dependencies for short, multi-candidate generation, preserving effectiveness while reducing inference cost, which facilitates scaling under fixed serving budgets. To align optimization with business value, GR4AD employs VSL (Value-Aware Supervised Learning) and proposes RSPO (Ranking-Guided Softmax Preference Optimization), a ranking-aware, list-wise reinforcement learning algorithm that optimizes value-based rewards under list-level metrics for continual online updates. For online inference, we further propose dynamic beam serving, which adapts beam width across generation levels and online load to control compute. Large-scale online A/B tests show up to 4.2% ad revenue improvement over an existing DLRM-based stack, with consistent gains from both model scaling and inference-time scaling. GR4AD has been fully deployed in Kuaishou advertising system with over 400 million users and achieves high-throughput real-time serving."},{"descriptionType":"Other","description":"13 pages, 6 figures, under review"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.22732","contentUrl":null,"metadataVersion":2,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T02:53:18Z","registered":"2026-02-27T02:53:18Z","published":null,"updated":"2026-04-03T02:18:58Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.23118","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.23118","identifiers":[{"identifier":"2602.23118","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Sabarnya","familyName":"Mitra","name":"Mitra, Sabarnya","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jishnu","familyName":"Goswami","name":"Goswami, Jishnu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Frithjof","familyName":"Karsch","name":"Karsch, Frithjof","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Universal and non-universal finite-volume effects in the vicinity of chiral phase transition in (2+1)-flavor QCD"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"High Energy Physics - Lattice (hep-lat)","lang":"en","subjectScheme":"arXiv"},{"subject":"High Energy Physics - Phenomenology (hep-ph)","lang":"en","subjectScheme":"arXiv"},{"subject":"High Energy Physics - Theory (hep-th)","lang":"en","subjectScheme":"arXiv"},{"subject":"Nuclear Experiment (nucl-ex)","lang":"en","subjectScheme":"arXiv"},{"subject":"Nuclear Theory (nucl-th)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-26T15:32:30Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:53:16Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-03-31T08:14:55Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-04-01T00:37:32Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"In this proceeding, we discuss the finite-size scaling analysis of the order parameter related to the chiral phase transition in QCD with two massless quarks. We use data obtained in lattice QCD calculations performed with highly improved staggered quarks (HISQ) for a range of light quark masses, $1/240 \\leq m_\\ell/m_s \\leq 1/27$ for different spatial volumes ($N_σ$) on Euclidean lattices with temporal extent $N_τ=8$, satisfying $3\\,N_τ\\leq N_σ\\leq 10\\,N_τ$. We observe that infinite volume extrapolated data for the order parameter agree reasonably well with the expected $O(2)$ scaling behavior even for physical ratios of the light-to-strange quark mass ratio. We quantify deviations from asymptotic scaling and perform a detailed analysis of the influence of finite-size effects in terms of temperature and quark masses at a fixed lattice cutoff. This is crucial for improving the reliability of the infinite-volume extrapolated estimate of the chiral order parameter and for a more precise determination of chiral phase transition temperature from direct Lattice QCD simulations."},{"descriptionType":"Other","description":"10 pages, 4 figures, Contribution to the proceedings of The 42nd International Symposium on Lattice Field Theory (LATTICE2025) , 2-8 November 2025 , TIFR Mumbai, India ; minor typos corrected and revised"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.23118","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T03:02:50Z","registered":"2026-02-27T03:02:50Z","published":null,"updated":"2026-04-01T02:35:21Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.22743","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.22743","identifiers":[{"identifier":"2602.22743","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Jiaqing","familyName":"Zhang","name":"Zhang, Jiaqing","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Mingjia","familyName":"Yin","name":"Yin, Mingjia","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Hao","familyName":"Wang","name":"Wang, Hao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yuxin","familyName":"Tian","name":"Tian, Yuxin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yuyang","familyName":"Ye","name":"Ye, Yuyang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yawen","familyName":"Li","name":"Li, Yawen","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Wei","familyName":"Guo","name":"Guo, Wei","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yong","familyName":"Liu","name":"Liu, Yong","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Enhong","familyName":"Chen","name":"Chen, Enhong","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Generative Data Transformation: From Mixed to Unified Data"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-26T08:30:09Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:32:29Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-03-31T02:35:29Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-04-01T00:20:34Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Recommendation model performance is intrinsically tied to the quality, volume, and relevance of their training data. To address common challenges like data sparsity and cold start, recent researchs have leveraged data from multiple auxiliary domains to enrich information within the target domain. However, inherent domain gaps can degrade the quality of mixed-domain data, leading to negative transfer and diminished model performance. Existing prevailing \\emph{model-centric} paradigm -- which relies on complex, customized architectures -- struggles to capture the subtle, non-structural sequence dependencies across domains, leading to poor generalization and high demands on computational resources. To address these shortcomings, we propose \\textsc{Taesar}, a \\emph{data-centric} framework for \\textbf{t}arget-\\textbf{a}lign\\textbf{e}d \\textbf{s}equenti\\textbf{a}l \\textbf{r}egeneration, which employs a contrastive decoding mechanism to adaptively encode cross-domain context into target-domain sequences. It employs contrastive decoding to encode cross-domain context into target sequences, enabling standard models to learn intricate dependencies without complex fusion architectures. Experiments show \\textsc{Taesar} outperforms model-centric solutions and generalizes to various sequential models. By generating enriched datasets, \\textsc{Taesar} effectively combines the strengths of data- and model-centric paradigms. The code accompanying this paper is available at~ \\textcolor{blue}{https://github.com/USTC-StarTeam/Taesar}."},{"descriptionType":"Other","description":"Accepted by The Web Conference 2026 (WWW '26)"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.22743","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T02:53:33Z","registered":"2026-02-27T02:53:34Z","published":null,"updated":"2026-04-01T02:35:19Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.22463","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.22463","identifiers":[{"identifier":"2602.22463","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Peio","familyName":"Garcia-Goiricelaya","name":"Garcia-Goiricelaya, Peio","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Julen","familyName":"Ibañez-Azpiroz","name":"Ibañez-Azpiroz, Julen","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Many-Body effects beyond excitons in second-harmonic generation of monolayer MoS$_{2}$"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Materials Science (cond-mat.mtrl-sci)","lang":"en","subjectScheme":"arXiv"},{"subject":"Mesoscale and Nanoscale Physics (cond-mat.mes-hall)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-25T22:52:02Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:10:52Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-03-31T13:47:48Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-04-01T00:57:04Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"We present a quantitative study of many-body effects including the three-particle level on second-harmonic generation in monolayer MoS$_2$. Our approach combines many-body perturbation theory with time-dependent current-density-functional theory within an \\textit{ab initio} framework in the optical limit. The inclusion of two-particle excitonic effects \\textit{via} a dynamical long-range linear exchange-correlation kernel reproduces the qualitative features of the second-harmonic response, but underestimates the experimentally reported magnitude by nearly a factor of two. By incorporating three-particle trionic correlations through a static long-range quadratic exchange-correlation kernel, we achieve significantly improved quantitative agreement with experiment. These findings highlight the role of many-body interactions beyond the excitonic level in accurately describing second-order optical responses in two-dimensional semiconductors."},{"descriptionType":"Other","description":"14 pages, 4 figures"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.22463","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T02:46:57Z","registered":"2026-02-27T02:46:57Z","published":null,"updated":"2026-04-01T02:35:18Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.22601","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.22601","identifiers":[{"identifier":"2602.22601","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Thanh-Dat","familyName":"Truong","name":"Truong, Thanh-Dat","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Huu-Thien","familyName":"Tran","name":"Tran, Huu-Thien","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jackson","familyName":"Cothren","name":"Cothren, Jackson","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Bhiksha","familyName":"Raj","name":"Raj, Bhiksha","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Khoa","familyName":"Luu","name":"Luu, Khoa","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"$ϕ$-DPO: Fairness Direct Preference Optimization Approach to Continual Learning in Large Multimodal Models"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-26T04:14:33Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:22:53Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-03-30T15:16:05Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-03-31T01:53:29Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Fairness in Continual Learning for Large Multimodal Models (LMMs) is an emerging yet underexplored challenge, particularly in the presence of imbalanced data distributions that can lead to biased model updates and suboptimal performance across tasks. While recent continual learning studies have made progress in addressing catastrophic forgetting, the problem of fairness caused the imbalanced data remains largely underexplored. This paper presents a novel Fairness Direct Preference Optimization (FaiDPO or $ϕ$-DPO) framework for continual learning in LMMs. In particular, we first propose a new continual learning paradigm based on Direct Preference Optimization (DPO) to mitigate catastrophic forgetting by aligning learning with pairwise preference signals. Then, we identify the limitations of conventional DPO in imbalanced data and present a new $ϕ$-DPO loss that explicitly addresses distributional biases. We provide a comprehensive theoretical analysis demonstrating that our approach addresses both forgetting and data imbalance. Additionally, to enable $ϕ$-DPO-based continual learning, we construct pairwise preference annotations for existing benchmarks in the context of continual learning. Extensive experiments and ablation studies show the proposed $ϕ$-DPO achieves State-of-the-Art performance across multiple benchmarks, outperforming prior continual learning methods of LMMs."},{"descriptionType":"Other","description":"Accepted to CVPR'26"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.22601","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T02:50:12Z","registered":"2026-02-27T02:50:12Z","published":null,"updated":"2026-03-31T04:10:41Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.22419","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.22419","identifiers":[{"identifier":"2602.22419","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Marc-Antoine","familyName":"Lavoie","name":"Lavoie, Marc-Antoine","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Anas","familyName":"Mahmoud","name":"Mahmoud, Anas","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Aldo","familyName":"Zaimi","name":"Zaimi, Aldo","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Arsene Fansi","familyName":"Tchango","name":"Tchango, Arsene Fansi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Steven L.","familyName":"Waslander","name":"Waslander, Steven L.","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"CLIP Is Shortsighted: Paying Attention Beyond the First Sentence"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-25T21:27:00Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:08:51Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-03-28T14:15:06Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-03-31T00:35:49Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"CLIP models learn transferable multi-modal features via image-text contrastive learning on internet-scale data. They are widely used in zero-shot classification, multi-modal retrieval, text-to-image diffusion, and as image encoders in large vision-language models. However, CLIP's pretraining is dominated by images paired with short captions, biasing the model toward encoding simple descriptions of salient objects and leading to coarse alignment on complex scenes and dense descriptions. While recent work mitigates this by fine-tuning on small-scale long-caption datasets, we identify an important common bias: both human- and LLM-generated long captions typically begin with a one-sentence summary followed by a detailed description. We show that this acts as a shortcut during training, concentrating attention on the opening sentence and early tokens and weakening alignment over the rest of the caption. To resolve this, we introduce DeBias-CLIP, which removes the summary sentence during training and applies sentence sub-sampling and text token padding to distribute supervision across all token positions. DeBias-CLIP achieves state-of-the-art long-text retrieval, improves short-text retrieval, and is less sensitive to sentence order permutations. It is a drop-in replacement for Long-CLIP with no additional trainable parameters."},{"descriptionType":"Other","description":"20 pages, 15 figures, to be published in the CVPR 2026 proceedings"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.22419","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T02:45:57Z","registered":"2026-02-27T02:45:58Z","published":null,"updated":"2026-03-31T04:10:40Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.22666","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.22666","identifiers":[{"identifier":"2602.22666","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Xuelu","familyName":"Li","name":"Li, Xuelu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zhaonan","familyName":"Wang","name":"Wang, Zhaonan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xiaogang","familyName":"Wang","name":"Wang, Xiaogang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Lei","familyName":"Wu","name":"Wu, Lei","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Manyi","familyName":"Li","name":"Li, Manyi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Changhe","familyName":"Tu","name":"Tu, Changhe","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"ArtPro: Self-Supervised Articulated Object Reconstruction with Adaptive Integration of Mobility Proposals"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-26T06:35:23Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:28:06Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-03-26T06:01:48Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-03-27T00:30:44Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Reconstructing articulated objects into high-fidelity digital twins is crucial for applications such as robotic manipulation and interactive simulation. Recent self-supervised methods using differentiable rendering frameworks like 3D Gaussian Splatting remain highly sensitive to the initial part segmentation. Their reliance on heuristic clustering or pre-trained models often causes optimization to converge to local minima, especially for complex multi-part objects. To address these limitations, we propose ArtPro, a novel self-supervised framework that introduces adaptive integration of mobility proposals. Our approach begins with an over-segmentation initialization guided by geometry features and motion priors, generating part proposals with plausible motion hypotheses. During optimization, we dynamically merge these proposals by analyzing motion consistency among spatial neighbors, while a collision-aware motion pruning mechanism prevents erroneous kinematic estimation. Extensive experiments on both synthetic and real-world objects demonstrate that ArtPro achieves robust reconstruction of complex multi-part objects, significantly outperforming existing methods in accuracy and stability."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.22666","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T02:51:45Z","registered":"2026-02-27T02:51:46Z","published":null,"updated":"2026-03-27T02:25:58Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.23276","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.23276","identifiers":[{"identifier":"2602.23276","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Hyungyung","familyName":"Lee","name":"Lee, Hyungyung","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Hangyul","familyName":"Yoon","name":"Yoon, Hangyul","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Edward","familyName":"Choi","name":"Choi, Edward","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"CXReasonAgent: Evidence-Grounded Diagnostic Reasoning Agent for Chest X-rays"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-26T17:51:21Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T02:00:18Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-03-24T09:05:23Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-03-25T00:44:39Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Chest X-ray plays a central role in thoracic diagnosis, and its interpretation inherently requires multi-step, evidence-grounded reasoning. However, large vision-language models (LVLMs) often generate plausible responses that are not faithfully grounded in diagnostic evidence and provide limited visual evidence for verification, while also requiring costly retraining to support new diagnostic tasks, limiting their reliability and adaptability in clinical settings. To address these limitations, we present CXReasonAgent, a diagnostic agent that integrates a large language model (LLM) with clinically grounded diagnostic tools to perform evidence-grounded diagnostic reasoning using image-derived diagnostic and visual evidence. To evaluate these capabilities, we introduce CXReasonDial, a multi-turn dialogue benchmark with 1,946 dialogues across 12 diagnostic tasks, and show that CXReasonAgent produces faithfully grounded responses, enabling more reliable and verifiable diagnostic reasoning than LVLMs. These findings highlight the importance of integrating clinically grounded diagnostic tools, particularly in safety-critical clinical settings. The demo is available \\href{https://ttumyche.github.io/cxreasonagent/#demo}{here}."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.23276","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T03:06:53Z","registered":"2026-02-27T03:06:54Z","published":null,"updated":"2026-03-25T02:36:26Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.23029","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.23029","identifiers":[{"identifier":"2602.23029","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Tianyue","familyName":"Wang","name":"Wang, Tianyue","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Leigang","familyName":"Qu","name":"Qu, Leigang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Tianyu","familyName":"Yang","name":"Yang, Tianyu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xiangzhao","familyName":"Hao","name":"Hao, Xiangzhao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yifan","familyName":"Xu","name":"Xu, Yifan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Haiyun","familyName":"Guo","name":"Guo, Haiyun","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jinqiao","familyName":"Wang","name":"Wang, Jinqiao","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"WISER: Wider Search, Deeper Thinking, and Adaptive Fusion for Training-Free Zero-Shot Composed Image Retrieval"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-26T14:11:10Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:47:50Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-03-02T02:20:04Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-03-03T02:33:12Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-03-07T13:24:30Z","dateType":"Submitted","dateInformation":"v3"},{"date":"2026-03-10T00:44:21Z","dateType":"Updated","dateInformation":"v3"},{"date":"2026-03-24T11:51:05Z","dateType":"Submitted","dateInformation":"v4"},{"date":"2026-03-25T00:54:12Z","dateType":"Updated","dateInformation":"v4"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"4","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Zero-Shot Composed Image Retrieval (ZS-CIR) aims to retrieve target images given a multimodal query (comprising a reference image and a modification text), without training on annotated triplets. Existing methods typically convert the multimodal query into a single modality-either as an edited caption for Text-to-Image retrieval (T2I) or as an edited image for Image-to-Image retrieval (I2I). However, each paradigm has inherent limitations: T2I often loses fine-grained visual details, while I2I struggles with complex semantic modifications. To effectively leverage their complementary strengths under diverse query intents, we propose WISER, a training-free framework that unifies T2I and I2I via a \"retrieve-verify-refine\" pipeline, explicitly modeling intent awareness and uncertainty awareness. Specifically, WISER first performs Wider Search by generating both edited captions and images for parallel retrieval to broaden the candidate pool. Then, it conducts Adaptive Fusion with a verifier to assess retrieval confidence, triggering refinement for uncertain retrievals, and dynamically fusing the dual-path for reliable ones. For uncertain retrievals, WISER generates refinement suggestions through structured self-reflection to guide the next retrieval round toward Deeper Thinking. Extensive experiments demonstrate that WISER significantly outperforms previous methods across multiple benchmarks, achieving relative improvements of 45% on CIRCO (mAP@5) and 57% on CIRR (Recall@1) over existing training-free methods. Notably, it even surpasses many training-dependent methods, highlighting its superiority and generalization under diverse scenarios. Code will be released at https://github.com/Physicsmile/WISER."},{"descriptionType":"Other","description":"Accept to CVPR 2026"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.23029","contentUrl":null,"metadataVersion":3,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T03:00:45Z","registered":"2026-02-27T03:00:45Z","published":null,"updated":"2026-03-25T02:36:26Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.22983","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.22983","identifiers":[{"identifier":"2602.22983","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Xun","familyName":"Huang","name":"Huang, Xun","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Simeng","familyName":"Qin","name":"Qin, Simeng","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xiaoshuang","familyName":"Jia","name":"Jia, Xiaoshuang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ranjie","familyName":"Duan","name":"Duan, Ranjie","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Huanqian","familyName":"Yan","name":"Yan, Huanqian","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zhitao","familyName":"Zeng","name":"Zeng, Zhitao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Fei","familyName":"Yang","name":"Yang, Fei","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yang","familyName":"Liu","name":"Liu, Yang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xiaojun","familyName":"Jia","name":"Jia, Xiaojun","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Obscure but Effective: Classical Chinese Jailbreak Prompt Optimization via Bio-Inspired Search"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"Cryptography and Security (cs.CR)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-26T13:25:35Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:45:11Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02-27T09:27:35Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-03-02T01:35:27Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-03-24T07:52:18Z","dateType":"Submitted","dateInformation":"v3"},{"date":"2026-03-25T00:40:01Z","dateType":"Updated","dateInformation":"v3"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"3","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"As Large Language Models (LLMs) are increasingly used, their security risks have drawn increasing attention. Existing research reveals that LLMs are highly susceptible to jailbreak attacks, with effectiveness varying across language contexts. This paper investigates the role of classical Chinese in jailbreak attacks. Owing to its conciseness and obscurity, classical Chinese can partially bypass existing safety constraints, exposing notable vulnerabilities in LLMs. Based on this observation, this paper proposes a framework, CC-BOS, for the automatic generation of classical Chinese adversarial prompts based on multi-dimensional fruit fly optimization, facilitating efficient and automated jailbreak attacks in black-box settings. Prompts are encoded into eight policy dimensions-covering role, behavior, mechanism, metaphor, expression, knowledge, trigger pattern and context; and iteratively refined via smell search, visual search, and cauchy mutation. This design enables efficient exploration of the search space, thereby enhancing the effectiveness of black-box jailbreak attacks. To enhance readability and evaluation accuracy, we further design a classical Chinese to English translation module. Extensive experiments demonstrate that effectiveness of the proposed CC-BOS, consistently outperforming state-of-the-art jailbreak attack methods."},{"descriptionType":"Other","description":"ICLR 2026 Poster The source code relevant to this article has now been open-sourced; for details, please visit: https://github.com/xunhuang123/CC-BOS"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.22983","contentUrl":null,"metadataVersion":2,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T02:59:37Z","registered":"2026-02-27T02:59:37Z","published":null,"updated":"2026-03-25T02:36:25Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.22625","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.22625","identifiers":[{"identifier":"2602.22625","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Seongmin","familyName":"Hong","name":"Hong, Seongmin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Junghun James","familyName":"Kim","name":"Kim, Junghun James","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Daehyeop","familyName":"Kim","name":"Kim, Daehyeop","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Insoo","familyName":"Chung","name":"Chung, Insoo","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Se Young","familyName":"Chun","name":"Chun, Se Young","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"DiffBMP: Differentiable Rendering with Bitmap Primitives"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Graphics (cs.GR)","lang":"en","subjectScheme":"arXiv"},{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-26T04:56:05Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:24:40Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-03-24T11:52:47Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-03-25T00:54:21Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by-nc-nd/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution Non Commercial No Derivatives 4.0 International","rightsIdentifier":"cc-by-nc-nd-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"We introduce DiffBMP, a scalable and efficient differentiable rendering engine for a collection of bitmap images. Our work addresses a limitation that traditional differentiable renderers are constrained to vector graphics, given that most images in the world are bitmaps. Our core contribution is a highly parallelized rendering pipeline, featuring a custom CUDA implementation for calculating gradients. This system can, for example, optimize the position, rotation, scale, color, and opacity of thousands of bitmap primitives all in under 1 min using a consumer GPU. We employ and validate several techniques to facilitate the optimization: soft rasterization via Gaussian blur, structure-aware initialization, noisy canvas, and specialized losses/heuristics for videos or spatially constrained images. We demonstrate DiffBMP is not just an isolated tool, but a practical one designed to integrate into creative workflows. It supports exporting compositions to a native, layered file format, and the entire framework is publicly accessible via an easy-to-hack Python package."},{"descriptionType":"Other","description":"Accepted to CVPR 2026, https://diffbmp.com"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.22625","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T02:50:46Z","registered":"2026-02-27T02:50:46Z","published":null,"updated":"2026-03-25T02:36:24Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.23306","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.23306","identifiers":[{"identifier":"2602.23306","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Yiran","familyName":"Guan","name":"Guan, Yiran","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Sifan","familyName":"Tu","name":"Tu, Sifan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Dingkang","familyName":"Liang","name":"Liang, Dingkang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Linghao","familyName":"Zhu","name":"Zhu, Linghao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jianzhong","familyName":"Ju","name":"Ju, Jianzhong","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zhenbo","familyName":"Luo","name":"Luo, Zhenbo","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jian","familyName":"Luan","name":"Luan, Jian","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yuliang","familyName":"Liu","name":"Liu, Yuliang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xiang","familyName":"Bai","name":"Bai, Xiang","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"ThinkOmni: Lifting Textual Reasoning to Omni-modal Scenarios via Guidance Decoding"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-26T18:10:41Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T02:01:38Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-03-21T06:46:01Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-03-24T00:32:00Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Omni-modal reasoning is essential for intelligent systems to understand and draw inferences from diverse data sources. While existing omni-modal large language models (OLLM) excel at perceiving diverse modalities, they lack the complex reasoning abilities of recent large reasoning models (LRM). However, enhancing the reasoning ability of OLLMs through additional training presents significant challenges, including the need for high-quality data, task-specific adaptation, and substantial computational costs. To address these limitations, we propose ThinkOmni, a training-free and data-free framework that lifts textual reasoning to omni-modal scenarios. ThinkOmni introduces two key components: 1) LRM-as-a-Guide, which leverages off-the-shelf LRMs to guide the OLLM decoding process; 2) Stepwise Contrastive Scaling, which adaptively balances perception and reasoning signals without manual hyperparameter tuning. Experiments on six multi-modal reasoning benchmarks demonstrate that ThinkOmni consistently delivers performance improvements, with main results achieving 70.2 on MathVista and 75.5 on MMAU. Overall, ThinkOmni offers a flexible and generalizable solution for omni-modal reasoning and provides new insights into the generalization and application of reasoning capabilities. Code is publicly available at https://github.com/1ranGuan/thinkomni"},{"descriptionType":"Other","description":"Accept by ICLR 2026, Code: https://github.com/1ranGuan/thinkomni"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.23306","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T03:07:37Z","registered":"2026-02-27T03:07:37Z","published":null,"updated":"2026-03-24T04:24:43Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.22680","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.22680","identifiers":[{"identifier":"2602.22680","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Yue","familyName":"Xu","name":"Xu, Yue","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Qian","familyName":"Chen","name":"Chen, Qian","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zizhan","familyName":"Ma","name":"Ma, Zizhan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Dongrui","familyName":"Liu","name":"Liu, Dongrui","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Wenxuan","familyName":"Wang","name":"Wang, Wenxuan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xiting","familyName":"Wang","name":"Wang, Xiting","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Li","familyName":"Xiong","name":"Xiong, Li","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Wenjie","familyName":"Wang","name":"Wang, Wenjie","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Toward Personalized LLM-Powered Agents: Foundations, Evaluation, and Future Directions"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-26T06:52:47Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:28:57Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-03-16T12:02:17Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-03-17T02:13:05Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Large language models have enabled agentic systems that reason, plan, and interact with tools and environments to accomplish complex tasks. As these agents operate over extended interaction horizons, their effectiveness increasingly depends on adapting behavior to individual users and maintaining continuity across interactions, giving rise to personalized LLM-powered agents (PLAs). In such long-term, user-dependent settings, personalization permeates the entire decision pipeline rather than remaining confined to surface-level response generation. This survey provides a capability-oriented review of personalized LLM-powered agents. Existing work is organized around four interdependent capabilities: profile modeling, memory, planning, and action execution. Using this taxonomy, representative methods are synthesized and analyzed to illustrate how user signals are represented, propagated, and utilized across the agent pipeline, highlighting cross-component interactions and recurring design challenges. Evaluation metrics and benchmarking paradigms tailored to personalized agents are further examined, along with application scenarios ranging from conversational assistants to domain-specific expert systems. By clarifying the design space of personalization in agent systems, this survey provides a structured foundation for developing more user-aligned, adaptive, and deployable LLM-powered agents."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.22680","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T02:52:05Z","registered":"2026-02-27T02:52:06Z","published":null,"updated":"2026-03-17T05:05:45Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.22442","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.22442","identifiers":[{"identifier":"2602.22442","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Gaoyuan","familyName":"Du","name":"Du, Gaoyuan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Amit","familyName":"Ahlawat","name":"Ahlawat, Amit","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xiaoyang","familyName":"Liu","name":"Liu, Xiaoyang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jing","familyName":"Wu","name":"Wu, Jing","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"A Framework for Assessing AI Agent Decisions and Outcomes in AutoML Pipelines"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"I.2.6; I.2.11; D.2.5","lang":"en","subjectScheme":"ACM"}],"contributors":[],"dates":[{"date":"2026-02-25T22:02:00Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:10:00Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-03-13T21:17:42Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-03-17T00:25:47Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Agent-based AutoML systems rely on large language models to make complex, multi-stage decisions across data processing, model selection, and evaluation. However, existing evaluation practices remain outcome-centric, focusing primarily on final task performance. Through a review of prior work, we find that none of the surveyed agentic AutoML systems report structured, decision-level evaluation metrics intended for post-hoc assessment of intermediate decision quality. To address this limitation, we propose an Evaluation Agent (EA) that performs decision-centric assessment of AutoML agents without interfering with their execution. The EA is designed as an observer that evaluates intermediate decisions along four dimensions: decision validity, reasoning consistency, model quality risks beyond accuracy, and counterfactual decision impact. Across four proof-of-concept experiments, we demonstrate that the EA can (i) detect faulty decisions with an F1 score of 0.919, (ii) identify reasoning inconsistencies independent of final outcomes, and (iii) attribute downstream performance changes to agent decisions, revealing impacts ranging from -4.9% to +8.3% in final metrics. These results illustrate how decision-centric evaluation exposes failure modes that are invisible to outcome-only metrics. Our work reframes the evaluation of agentic AutoML systems from an outcome-based perspective to one that audits agent decisions, offering a foundation for reliable, interpretable, and governable autonomous ML systems."},{"descriptionType":"Other","description":"10 pages"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.22442","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T02:46:29Z","registered":"2026-02-27T02:46:29Z","published":null,"updated":"2026-03-17T05:05:41Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.22740","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.22740","identifiers":[{"identifier":"2602.22740","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Tongfei","familyName":"Chen","name":"Chen, Tongfei","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Shuo","familyName":"Yang","name":"Yang, Shuo","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yuguang","familyName":"Yang","name":"Yang, Yuguang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Linlin","familyName":"Yang","name":"Yang, Linlin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Runtang","familyName":"Guo","name":"Guo, Runtang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Changbai","familyName":"Li","name":"Li, Changbai","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"He","familyName":"Long","name":"Long, He","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Chunyu","familyName":"Xie","name":"Xie, Chunyu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Dawei","familyName":"Leng","name":"Leng, Dawei","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Baochang","familyName":"Zhang","name":"Zhang, Baochang","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"AMLRIS: Alignment-aware Masked Learning for Referring Image Segmentation"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-26T08:29:04Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:32:25Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-03-11T04:23:48Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-03-12T00:25:30Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Referring Image Segmentation (RIS) aims to segment the object in an image uniquely referred to by a natural language expression. However, RIS training often contains hard-to-align and instance-specific visual signals; optimizing on such pixels injects misleading gradients and drives the model in the wrong direction. By explicitly estimating pixel-level vision-language alignment, the learner can suppress low-alignment regions, concentrate on reliable cues, and acquire more generalizable alignment features.\n In this paper, we propose Alignment-Aware Masked Learning (AML), a simple yet effective training strategy that quantifies region-referent alignment (PMME) and filters out unreliable pixels during optimization (AFM). Specifically, each sample first computes a similarity map between visual and textual features, and then masks out pixels falling below an adaptive similarity threshold, thereby excluding poorly aligned regions from the training process. AML does not require architectural changes and incurs no inference overhead, directing attention to the areas aligned with the textual description. Experiments on the RefCOCO (vanilla/+/g) datasets show that AML achieves state-of-the-art results across all 8 splits, and beyond improving RIS performance, AML also enhances the model's robustness to diverse descriptions and scenarios. Code is available at https://github.com/pipashu1/AMLRIS."},{"descriptionType":"Other","description":"ICLR 2026 conference paper"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.22740","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T02:53:29Z","registered":"2026-02-27T02:53:30Z","published":null,"updated":"2026-03-12T02:30:32Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.22427","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.22427","identifiers":[{"identifier":"2602.22427","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Idan","familyName":"Habler","name":"Habler, Idan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Vineeth Sai","familyName":"Narajala","name":"Narajala, Vineeth Sai","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Stav","familyName":"Koren","name":"Koren, Stav","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Amy","familyName":"Chang","name":"Chang, Amy","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Tiffany","familyName":"Saade","name":"Saade, Tiffany","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Adversarial Hubness Detector: Detecting Hubness Poisoning in Retrieval-Augmented Generation Systems"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Cryptography and Security (cs.CR)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-25T21:37:53Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:09:12Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-03-11T01:08:33Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-03-12T00:17:43Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Retrieval-Augmented Generation (RAG) systems are essential to contemporary AI applications, allowing large language models to obtain external knowledge via vector similarity search. Nevertheless, these systems encounter a significant security flaw: hubness - items that frequently appear in the top-$k$ retrieval results for a disproportionately high number of varied queries. These hubs can be exploited to introduce harmful content, alter search rankings, bypass content filtering, and decrease system performance.\n We introduce hubscan, an open-source security scanner that evaluates vector indices and embeddings to identify hubs in RAG systems. Hubscan presents a multi-detector architecture that integrates: (1) robust statistical hubness detection utilizing median/Median Absolute Deviation (MAD)-based z-scores, (2) cluster spread analysis to assess cross-cluster retrieval patterns, (3) stability testing under query perturbations, and (4) domain-aware and modality-aware detection for category-specific and cross-modal attacks. Our solution accommodates several vector databases (FAISS, Pinecone, Qdrant, Weaviate) and offers versatile retrieval techniques, including vector similarity, hybrid search, and lexical matching with reranking capabilities.\n We evaluate hubscan on Food-101, MS-COCO, and FiQA adversarial hubness benchmarks constructed using state-of-the-art gradient-optimized and centroid-based hub generation methods. Hubscan achieves 90% recall at a 0.2% alert budget and 100% recall at 0.4%, with adversarial hubs ranking above the 99.8th percentile. In testing, domain-scoped scanning recovered 100% of targeted attacks that evaded global detection. Production validation on 1M real web documents from MS MARCO demonstrates significant score separation between clean documents and adversarial content."},{"descriptionType":"Other","description":"11 pages, 5 figures, 2 tables, Github: https://github.com/cisco-ai-defense/adversarial-hubness-detector, Updated with minor changes to naming"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.22427","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T02:46:08Z","registered":"2026-02-27T02:46:09Z","published":null,"updated":"2026-03-12T02:30:31Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.23040","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.23040","identifiers":[{"identifier":"2602.23040","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Aashish","familyName":"Rai","name":"Rai, Aashish","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Angela","familyName":"Xing","name":"Xing, Angela","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Anushka","familyName":"Agarwal","name":"Agarwal, Anushka","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xiaoyan","familyName":"Cong","name":"Cong, Xiaoyan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zekun","familyName":"Li","name":"Li, Zekun","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Tao","familyName":"Lu","name":"Lu, Tao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Aayush","familyName":"Prakash","name":"Prakash, Aayush","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Srinath","familyName":"Sridhar","name":"Sridhar, Srinath","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"PackUV: Packed Gaussian UV Maps for 4D Volumetric Video"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-26T14:24:48Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:48:35Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-03-06T23:56:11Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-03-10T00:19:44Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Volumetric videos offer immersive 4D experiences, but remain difficult to reconstruct, store, and stream at scale. Existing Gaussian Splatting based methods achieve high-quality reconstruction but break down on long sequences, temporal inconsistency, and fail under large motions and disocclusions. Moreover, their outputs are typically incompatible with conventional video coding pipelines, preventing practical applications.\n We introduce PackUV, a novel 4D Gaussian representation that maps all Gaussian attributes into a sequence of structured, multi-scale UV atlas, enabling compact, image-native storage. To fit this representation from multi-view videos, we propose PackUV-GS, a temporally consistent fitting method that directly optimizes Gaussian parameters in the UV domain. A flow-guided Gaussian labeling and video keyframing module identifies dynamic Gaussians, stabilizes static regions, and preserves temporal coherence even under large motions and disocclusions. The resulting UV atlas format is the first unified volumetric video representation compatible with standard video codecs (e.g., FFV1) without losing quality, enabling efficient streaming within existing multimedia infrastructure.\n To evaluate long-duration volumetric capture, we present PackUV-2B, the largest multi-view video dataset to date, featuring more than 50 synchronized cameras, substantial motion, and frequent disocclusions across 100 sequences and 2B (billion) frames. Extensive experiments demonstrate that our method surpasses existing baselines in rendering fidelity while scaling to sequences up to 30 minutes with consistent quality."},{"descriptionType":"Other","description":"https://ivl.cs.brown.edu/packuv"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.23040","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T03:01:00Z","registered":"2026-02-27T03:01:01Z","published":null,"updated":"2026-03-10T04:59:39Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.22851","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.22851","identifiers":[{"identifier":"2602.22851","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Sebastian","familyName":"Schmitt","name":"Schmitt, Sebastian","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Linus","familyName":"Ekstrøm","name":"Ekstrøm, Linus","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Alberto","familyName":"Bottarelli","name":"Bottarelli, Alberto","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xavier","familyName":"Bonet-Monroig","name":"Bonet-Monroig, Xavier","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Experimental demonstration of the absence of noise-induced barren plateaus using information content landscape analysis"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Quantum Physics (quant-ph)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-26T10:38:53Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:38:23Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-03-09T11:04:59Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-03-10T02:01:38Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Variational quantum algorithms are promising candidates for near-term quantum computing but can be hindered by barren plateaus, where gradients vanish exponentially and optimization becomes intractable. Noise-Induced Barren Plateaus (NIBP) are particularly concerning because they are predicted to arise generically from noise accumulation, independent of system size, circuit structure, and observable locality. We experimentally investigate NIBP on IBM quantum hardware. Using Information Content Landscape Analysis (ICLA), we efficiently estimate gradient norms for variational circuits ranging from 8 to 102 qubits, up to hundreds of parameters and circuit runtimes of hundreds of microseconds. Contrary to NIBP expectations, we observe that gradient magnitudes saturate beyond a characteristic runtime rather than decaying exponentially. Classical simulations of the 8-qubit case under noiseless, depolarizing, amplitude-damping, and dephasing noise models support this behavior. Consistent with recent theory, our results show that $T_1$-dominated non-unital noise inhibits the emergence of NIBP. Our analysis suggest that average calibration metrics may be insufficient to predict variational algorithm performance."},{"descriptionType":"Other","description":"changed formatting, corrected wrong figure"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.22851","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T02:56:20Z","registered":"2026-02-27T02:56:21Z","published":null,"updated":"2026-03-10T04:59:36Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.22555","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.22555","identifiers":[{"identifier":"2602.22555","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Sicheng","familyName":"Dai","name":"Dai, Sicheng","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Hongwang","familyName":"Xiao","name":"Xiao, Hongwang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Shan","familyName":"Yu","name":"Yu, Shan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Qiwei","familyName":"Ye","name":"Ye, Qiwei","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Autoregressive Visual Decoding from EEG Signals"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-26T02:49:04Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:18:21Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-03-09T12:57:06Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-03-10T02:09:02Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Electroencephalogram (EEG) signals have become a popular medium for decoding visual information due to their cost-effectiveness and high temporal resolution. However, current approaches face significant challenges in bridging the modality gap between EEG and image data. These methods typically rely on complex adaptation processes involving multiple stages, making it hard to maintain consistency and manage compounding errors. Furthermore, the computational overhead imposed by large-scale diffusion models limit their practicality in real-world brain-computer interface (BCI) applications. In this work, we present AVDE, a lightweight and efficient framework for visual decoding from EEG signals. First, we leverage LaBraM, a pre-trained EEG model, and fine-tune it via contrastive learning to align EEG and image representations. Second, we adopt an autoregressive generative framework based on a \"next-scale prediction\" strategy: images are encoded into multi-scale token maps using a pre-trained VQ-VAE, and a transformer is trained to autoregressively predict finer-scale tokens starting from EEG embeddings as the coarsest representation. This design enables coherent generation while preserving a direct connection between the input EEG signals and the reconstructed images. Experiments on two datasets show that AVDE outperforms previous state-of-the-art methods in both image retrieval and reconstruction tasks, while using only 10% of the parameters. In addition, visualization of intermediate outputs shows that the generative process of AVDE reflects the hierarchical nature of human visual perception. These results highlight the potential of autoregressive models as efficient and interpretable tools for practical BCI applications."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.22555","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T02:49:06Z","registered":"2026-02-27T02:49:07Z","published":null,"updated":"2026-03-10T04:59:31Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.22553","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.22553","identifiers":[{"identifier":"2602.22553","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Cédric","familyName":"Josz","name":"Josz, Cédric","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Wenqing","familyName":"Ouyang","name":"Ouyang, Wenqing","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Computing Kurdyka-Łojasiewicz exponents via composition and symmetry"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Optimization and Control (math.OC)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"32B20, 49J53, 53-XX","lang":"en","subjectScheme":"MSC"}],"contributors":[],"dates":[{"date":"2026-02-26T02:45:54Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:18:16Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-03-08T02:32:32Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-03-10T01:01:12Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"We devise calculus rules for the Kurdyka-Łojasiewicz exponent using the rank theorem and Lie group actions. They apply to a wide class of composite and invariant functions, and are particularly suitable for handling nonisolated local minima. Notably, smoothness plays no role, eschewing gradient and Hessian computations. This provides a unified framework for establishing linear convergence of various algorithms in matrix factorization, $\\ell_1$-matrix factorization, matrix sensing, and linear neural networks."},{"descriptionType":"Other","description":"60 pages"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.22553","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T02:49:04Z","registered":"2026-02-27T02:49:04Z","published":null,"updated":"2026-03-10T04:59:30Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.22263","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.22263","identifiers":[{"identifier":"2602.22263","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Fuyao","familyName":"Huang","name":"Huang, Fuyao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xiaozhu","familyName":"Yu","name":"Yu, Xiaozhu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Kui","familyName":"Xu","name":"Xu, Kui","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Qiangfeng Cliff","familyName":"Zhang","name":"Zhang, Qiangfeng Cliff","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"CryoNet.Refine: A One-step Diffusion Model for Rapid Refinement of Structural Models with Cryo-EM Density Map Restraints"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Biomolecules (q-bio.BM)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"Image and Video Processing (eess.IV)","lang":"en","subjectScheme":"arXiv"},{"subject":"Quantitative Methods (q-bio.QM)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Biological sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Biological sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"FOS: Electrical engineering, electronic engineering, information engineering","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Electrical engineering, electronic engineering, information engineering","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-25T04:18:18Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:01:21Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-03-09T08:34:19Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-03-10T01:51:22Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"High-resolution structure determination by cryo-electron microscopy (cryo-EM) requires the accurate fitting of an atomic model into an experimental density map. Traditional refinement pipelines such as Phenix.real_space_refine and Rosetta are computationally expensive, demand extensive manual tuning, and present a significant bottleneck for researchers. We present CryoNet.Refine, an end-to-end deep learning framework that automates and accelerates molecular structure refinement. Our approach utilizes a one-step diffusion model that integrates a density-aware loss function with robust stereochemical restraints, enabling rapid optimization of a structure against experimental data. CryoNet.Refine provides a unified and versatile solution capable of refining protein complexes as well as DNA/RNA-protein complexes. In benchmarks against Phenix.real_space_refine, CryoNet.Refine consistently achieves substantial improvements in both model-map correlation and overall geometric quality metrics. By offering a scalable, automated, and powerful alternative, CryoNet.Refine aims to serve as an essential tool for next-generation cryo-EM structure refinement. Web server: https://cryonet.ai/refine; Source code: https://github.com/kuixu/cryonet.refine."},{"descriptionType":"Other","description":"Published as a conference paper at ICLR 2026"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.22263","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T02:42:20Z","registered":"2026-02-27T02:42:21Z","published":null,"updated":"2026-03-10T04:59:28Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.23144","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.23144","identifiers":[{"identifier":"2602.23144","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Emanuele","familyName":"Caputo","name":"Caputo, Emanuele","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Augusto","familyName":"Gerolin","name":"Gerolin, Augusto","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Nataliia","familyName":"Monina","name":"Monina, Nataliia","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Pavlo","familyName":"Pelikh","name":"Pelikh, Pavlo","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Lorenzo","familyName":"Portinale","name":"Portinale, Lorenzo","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Quantum thermodynamics and semidefinite programming: regularization and algorithms"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Mathematical Physics (math-ph)","lang":"en","subjectScheme":"arXiv"},{"subject":"Optimization and Control (math.OC)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"49K30, 49Q22, 81Q10","lang":"en","subjectScheme":"MSC"}],"contributors":[],"dates":[{"date":"2026-02-26T16:10:14Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:54:34Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02-28T10:35:08Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-03-03T01:37:37Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-03-06T10:05:00Z","dateType":"Submitted","dateInformation":"v3"},{"date":"2026-03-09T00:37:14Z","dateType":"Updated","dateInformation":"v3"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"3","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"We investigate variational problems in quantum thermodynamics at positive temperature, in which admissible states are constrained by prescribed outcomes of a finite set of measurements. We solve a problem raised by the recent work [Liu, Minervini, Patel, Wilde; arXiv:2505.04514 - Section C] and develop a general mathematical setup which allows a broad class of possible regularizations. Employing methods inspired by non-commutative optimal transport, we analyze the dual formulation of the problem, study the existence and characterization of maximizers, and investigate the qualitative behavior of the model in the zero-temperature limit. In the second part, we tailor this framework to quantum state tomography and quantum optimal transport. Finally, we address computational aspects, with particular attention to the convergence of algorithms in selected cases."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.23144","contentUrl":null,"metadataVersion":2,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T03:03:30Z","registered":"2026-02-27T03:03:31Z","published":null,"updated":"2026-03-09T02:13:39Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.23008","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.23008","identifiers":[{"identifier":"2602.23008","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Zeyuan","familyName":"Liu","name":"Liu, Zeyuan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jeonghye","familyName":"Kim","name":"Kim, Jeonghye","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xufang","familyName":"Luo","name":"Luo, Xufang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Dongsheng","familyName":"Li","name":"Li, Dongsheng","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yuqing","familyName":"Yang","name":"Yang, Yuqing","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Exploratory Memory-Augmented LLM Agent via Hybrid On- and Off-Policy Optimization"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-26T13:50:57Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:46:51Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-03-06T09:42:17Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-03-09T00:36:00Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Exploration remains the key bottleneck for large language model agents trained with reinforcement learning. While prior methods exploit pretrained knowledge, they fail in environments requiring the discovery of novel states. We propose Exploratory Memory-Augmented On- and Off-Policy Optimization (EMPO$^2$), a hybrid RL framework that leverages memory for exploration and combines on- and off-policy updates to make LLMs perform well with memory while also ensuring robustness without it. On ScienceWorld and WebShop, EMPO$^2$ achieves 128.6% and 11.3% improvements over GRPO, respectively. Moreover, in out-of-distribution tests, EMPO$^2$ demonstrates superior adaptability to new tasks, requiring only a few trials with memory and no parameter updates. These results highlight EMPO$^2$ as a promising framework for building more exploratory and generalizable LLM-based agents."},{"descriptionType":"Other","description":"Accepted to ICLR 2026"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.23008","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T03:00:15Z","registered":"2026-02-27T03:00:16Z","published":null,"updated":"2026-03-09T02:13:37Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.22289","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.22289","identifiers":[{"identifier":"2602.22289","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Ihor","familyName":"Kendiukhov","name":"Kendiukhov, Ihor","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"What Topological and Geometric Structure Do Biological Foundation Models Learn? Evidence from 141 Hypotheses"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Quantitative Methods (q-bio.QM)","lang":"en","subjectScheme":"arXiv"},{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"Genomics (q-bio.GN)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Biological sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Biological sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-25T14:33:24Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:01:58Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-03-05T20:03:46Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-03-09T00:06:13Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"When biological foundation models such as scGPT and Geneformer process single-cell gene expression, what geometric and topological structure forms in their internal representations? Is that structure biologically meaningful or a training artifact, and how confident should we be in such claims? We address these questions through autonomous large-scale hypothesis screening: an AI-driven executor-brainstormer loop that proposed, tested, and refined 141 geometric and topological hypotheses across 52 iterations, covering persistent homology, manifold distances, cross-model alignment, community structure, and directed topology, all with explicit null controls and disjoint gene-pool splits.\n Three principal findings emerge. First, the models learn genuine geometric structure. Gene embedding neighborhoods exhibit non-trivial topology, with persistent homology significant in 11 of 12 transformer layers at p \u0026lt; 0.05 in the weakest domain and 12 of 12 in the other two. A multi-level distance hierarchy shows that manifold-aware metrics outperform Euclidean distance for identifying regulatory gene pairs, and graph community partitions track known transcription factor target relationships. Second, this structure is shared across independently trained models. CCA alignment between scGPT and Geneformer yields canonical correlation of 0.80 and gene retrieval accuracy of 72 percent, yet none of 19 tested methods reliably recover gene-level correspondences. The models agree on the global shape of gene space but not on precise gene placement. Third, the structure is more localized than it first appears. Under stringent null controls applied across all null families, robust signal concentrates in immune tissue, while lung and external lung signals weaken substantially."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.22289","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T02:42:56Z","registered":"2026-02-27T02:42:57Z","published":null,"updated":"2026-03-09T02:13:34Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.22903","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.22903","identifiers":[{"identifier":"2602.22903","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Yunpeng","familyName":"Hong","name":"Hong, Yunpeng","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Chenyang","familyName":"Bu","name":"Bu, Chenyang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jie","familyName":"Zhang","name":"Zhang, Jie","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yi","familyName":"He","name":"He, Yi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Di","familyName":"Wu","name":"Wu, Di","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xindong","familyName":"Wu","name":"Wu, Xindong","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"PSQE: A Theoretical-Practical Approach to Pseudo Seed Quality Enhancement for Unsupervised Multimodal Entity Alignment"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Information Retrieval (cs.IR)","lang":"en","subjectScheme":"arXiv"},{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-26T11:47:32Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:41:01Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-03-03T03:13:30Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-03-04T01:21:07Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[{"relationType":"IsVersionOf","relatedIdentifier":"10.1145/3770854.3780249","relatedIdentifierType":"DOI"}],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Multimodal Entity Alignment (MMEA) aims to identify equivalent entities across different data modalities, enabling structural data integration that in turn improves the performance of various large language model applications. To lift the requirement of labeled seed pairs that are difficult to obtain, recent methods shifted to an unsupervised paradigm using pseudo-alignment seeds. However, unsupervised entity alignment in multimodal settings remains underexplored, mainly because the incorporation of multimodal information often results in imbalanced coverage of pseudo-seeds within the knowledge graph. To overcome this, we propose PSQE (Pseudo-Seed Quality Enhancement) to improve the precision and graph coverage balance of pseudo seeds via multimodal information and clustering-resampling. Theoretical analysis reveals the impact of pseudo seeds on existing contrastive learning-based MMEA models. In particular, pseudo seeds can influence the attraction and the repulsion terms in contrastive learning at once, whereas imbalanced graph coverage causes models to prioritize high-density regions, thereby weakening their learning capability for entities in sparse regions. Experimental results validate our theoretical findings and show that PSQE as a plug-and-play module can improve the performance of baselines by considerable margins."},{"descriptionType":"Other","description":"2026 SIGKDD Accept"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.22903","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":1,"created":"2026-02-27T02:57:33Z","registered":"2026-02-27T02:57:34Z","published":null,"updated":"2026-03-04T03:23:45Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.23239","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.23239","identifiers":[{"identifier":"2602.23239","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Radha","familyName":"Sarma","name":"Sarma, Radha","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Agency and Architectural Limits: Why Optimization-Based Systems Cannot Be Norm-Responsive"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"Computers and Society (cs.CY)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-26T17:16:17Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:58:33Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-03-01T18:44:49Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-03-03T02:21:58Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"AI systems are increasingly deployed in high-stakes contexts (medical diagnosis, legal research, financial analysis) under the assumption they can be governed by norms. This paper demonstrates that the assumption is formally invalid for optimization-based systems, specifically Large Language Models trained via Reinforcement Learning from Human Feedback (RLHF). Genuine agency requires two necessary and jointly sufficient architectural conditions. First, the capacity to maintain certain boundaries as non-negotiable constraints rather than tradeable weights (Incommensurability). Second, a non-inferential mechanism capable of suspending processing when those boundaries are threatened (Apophatic Responsiveness). RLHF-based systems are constitutively incompatible with both conditions. The operations that make optimization powerful, unifying all values on a scalar metric and always selecting the highest-scoring output, are precisely the operations that preclude normative governance and agency. This incompatibility is not a correctable training bug awaiting a technical fix. It is a formal constraint inherent to what optimization is. Consequently, documented failure modes (sycophancy, hallucination, and unfaithful reasoning) are not accidents but expected structural manifestations. Misaligned deployment triggers a second-order risk termed the Convergence Crisis. When humans are forced to verify AI outputs under metric pressure, they degrade from genuine agents into criteria-checking optimizers, eliminating the only component capable of bearing normative accountability. Beyond the incompatibility proof, this paper's primary positive contribution is a substrate-neutral architectural specification deriving what any system (biological, artificial, or institutional) must necessarily satisfy to qualify as a genuine agent rather than a sophisticated instrument."},{"descriptionType":"Other","description":"About 10,600 words in all (includes ~1000 words of literature and ~2400 words of Appendices). Under journal review"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.23239","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T03:05:57Z","registered":"2026-02-27T03:05:58Z","published":null,"updated":"2026-03-03T05:56:02Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.23166","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.23166","identifiers":[{"identifier":"2602.23166","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Zhaochen","familyName":"Su","name":"Su, Zhaochen","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jincheng","familyName":"Gao","name":"Gao, Jincheng","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Hangyu","familyName":"Guo","name":"Guo, Hangyu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zhenhua","familyName":"Liu","name":"Liu, Zhenhua","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Lueyang","familyName":"Zhang","name":"Zhang, Lueyang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xinyu","familyName":"Geng","name":"Geng, Xinyu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Shijue","familyName":"Huang","name":"Huang, Shijue","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Peng","familyName":"Xia","name":"Xia, Peng","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Guanyu","familyName":"Jiang","name":"Jiang, Guanyu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Cheng","familyName":"Wang","name":"Wang, Cheng","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yue","familyName":"Zhang","name":"Zhang, Yue","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yi R.","familyName":"Fung","name":"Fung, Yi R.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Junxian","familyName":"He","name":"He, Junxian","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"AgentVista: Evaluating Multimodal Agents in Ultra-Challenging Realistic Visual Scenarios"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-26T16:30:46Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:55:26Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-03-02T03:29:34Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-03-03T02:36:40Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Real-world multimodal agents solve multi-step workflows grounded in visual evidence. For example, an agent can troubleshoot a device by linking a wiring photo to a schematic and validating the fix with online documentation, or plan a trip by interpreting a transit map and checking schedules under routing constraints. However, existing multimodal benchmarks mainly evaluate single-turn visual reasoning or specific tool skills, and they do not fully capture the realism, visual subtlety, and long-horizon tool use that practical agents require. We introduce AgentVista, a benchmark for generalist multimodal agents that spans 25 sub-domains across 7 categories, pairing realistic and detail-rich visual scenarios with natural hybrid tool use. Tasks require long-horizon tool interactions across modalities, including web search, image search, page navigation, and code-based operations for both image processing and general programming. Comprehensive evaluation of state-of-the-art models exposes significant gaps in their ability to carry out long-horizon multimodal tool use. Even the best model in our evaluation, Gemini-3-Pro with tools, achieves only 27.3% overall accuracy, and hard instances can require more than 25 tool-calling turns. We expect AgentVista to accelerate the development of more capable and reliable multimodal agents for realistic and ultra-challenging problem solving."},{"descriptionType":"Other","description":"The project website is available at https://agentvista-bench.github.io/, and the code is available at https://github.com/hkust-nlp/AgentVista"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.23166","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T03:04:04Z","registered":"2026-02-27T03:04:04Z","published":null,"updated":"2026-03-03T05:55:58Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.22948","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.22948","identifiers":[{"identifier":"2602.22948","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Jiayu","familyName":"Chen","name":"Chen, Jiayu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ruoyu","familyName":"Lin","name":"Lin, Ruoyu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zihao","familyName":"Zheng","name":"Zheng, Zihao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jingxin","familyName":"Li","name":"Li, Jingxin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Maoliang","familyName":"Li","name":"Li, Maoliang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Guojie","familyName":"Luo","name":"Luo, Guojie","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xiang","familyName":"Chen","name":"Chen, Xiang","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"ToProVAR: Efficient Visual Autoregressive Modeling via Tri-Dimensional Entropy-Aware Semantic Analysis and Sparsity Optimization"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-26T12:36:56Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:43:10Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-03-02T16:58:25Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-03-03T03:23:23Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Visual Autoregressive(VAR) models enhance generation quality but face a critical efficiency bottleneck in later stages. In this paper, we present a novel optimization framework for VAR models that fundamentally differs from prior approaches such as FastVAR and SkipVAR. Instead of relying on heuristic skipping strategies, our method leverages attention entropy to characterize the semantic projections across different dimensions of the model architecture. This enables precise identification of parameter dynamics under varying token granularity levels, semantic scopes, and generation scales. Building on this analysis, we further uncover sparsity patterns along three critical dimensions-token, layer, and scale-and propose a set of fine-grained optimization strategies tailored to these patterns. Extensive evaluation demonstrates that our approach achieves aggressive acceleration of the generation process while significantly preserving semantic fidelity and fine details, outperforming traditional methods in both efficiency and quality. Experiments on Infinity-2B and Infinity-8B models demonstrate that ToProVAR achieves up to 3.4x acceleration with minimal quality loss, effectively mitigating the issues found in prior work. Our code will be made publicly available."},{"descriptionType":"Other","description":"ToProVAR is honored to be accepted by ICLR 2026"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.22948","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T02:58:43Z","registered":"2026-02-27T02:58:44Z","published":null,"updated":"2026-03-03T05:55:54Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.22658","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.22658","identifiers":[{"identifier":"2602.22658","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Hoan My","familyName":"Tran","name":"Tran, Hoan My","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xin","familyName":"Wang","name":"Wang, Xin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Wanying","familyName":"Ge","name":"Ge, Wanying","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xuechen","familyName":"Liu","name":"Liu, Xuechen","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Junichi","familyName":"Yamagishi","name":"Yamagishi, Junichi","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Deepfake Word Detection by Next-token Prediction using Fine-tuned Whisper"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Audio and Speech Processing (eess.AS)","lang":"en","subjectScheme":"arXiv"},{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Electrical engineering, electronic engineering, information engineering","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Electrical engineering, electronic engineering, information engineering","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-26T06:17:56Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:26:57Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02-28T00:29:53Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-03-03T01:18:30Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by-nc-sa/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution Non Commercial Share Alike 4.0 International","rightsIdentifier":"cc-by-nc-sa-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Deepfake speech utterances can be forged by replacing one or more words in a bona fide utterance with semantically different words synthesized with speech-generative models. While a dedicated synthetic word detector could be developed, we developed a cost-effective method that fine-tunes a pre-trained Whisper model to detect synthetic words while transcribing the input utterance via next-token prediction. We further investigate using partially vocoded utterances as the fine-tuning data, thus reducing the cost of data collection. Our experiments demonstrate that, on in-domain test data, the fine-tuned Whisper yields low synthetic-word detection error rates and transcription error rates. On out-of-domain test data with synthetic words produced with unseen speech-generative models, the fine-tuned Whisper remains on par with a dedicated ResNet-based detection model; however, the overall performance degradation calls for strategies to improve its generalization capability."},{"descriptionType":"Other","description":"Submitted to Interspeech. To quote: Interspeech no longer enforces an anonymity period for submissions. While uploading a version online is permitted, your official submission to Interspeech must not contain any author-identifying information. ... a note indicating that the paper was submitted for review to (or, eventually, accepted at) Interspeech should be included in the posting"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.22658","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T02:51:33Z","registered":"2026-02-27T02:51:34Z","published":null,"updated":"2026-03-03T05:55:49Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.22627","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.22627","identifiers":[{"identifier":"2602.22627","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Ionel","familyName":"Popescu","name":"Popescu, Ionel","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jeven","familyName":"Syatriadi","name":"Syatriadi, Jeven","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Tushar","familyName":"Vaidya","name":"Vaidya, Tushar","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Anchoring and Mixed-Norm Contractions in Averaging-Learning Dynamics"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Dynamical Systems (math.DS)","lang":"en","subjectScheme":"arXiv"},{"subject":"Optimization and Control (math.OC)","lang":"en","subjectScheme":"arXiv"},{"subject":"Probability (math.PR)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"93D50, 91D30, 15B51, 15A60, 93E15","lang":"en","subjectScheme":"MSC"}],"contributors":[],"dates":[{"date":"2026-02-26T04:58:40Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:24:44Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02-28T12:36:07Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-03-03T01:40:03Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by-nc-nd/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution Non Commercial No Derivatives 4.0 International","rightsIdentifier":"cc-by-nc-nd-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"A single informed agent can draw an arbitrarily large network to the ground truth. This is the sharpest consequence of the \"Averaging plus Learning\" framework studied here, where agents update opinions by socially averaging neighbours while some receive private feedback at heterogeneous rates. The key is a graph-theoretic property we call condensely anchored, which implies convergence to the correct consensus on fixed networks. In the original framework of Popescu and Vaidya (2023), every agent was required to learn. Removing that requirement changes the problem fundamentally: the underlying graph must now carry the signal from a handful of anchors to everyone else. When learning rates decay to zero, a persistence condition on the rates alone suffices, with no uniform connectivity or aperiodicity assumed. The hardest case is intermittent connectivity, where no single time step contracts in any standard norm. A mixed-operator-norm framework is developed that extracts two-step contraction from the interplay between aggregate learning mass and entrywise diffusion of influence, a mechanism new to consensus literature. Finally, we demonstrate the framework's robustness: vanishing noise preserves convergence to the ground truth, whereas persistent noise drives the system to a limiting law."},{"descriptionType":"Other","description":"38 pages, 8 figures, 1 table"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.22627","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T02:50:49Z","registered":"2026-02-27T02:50:49Z","published":null,"updated":"2026-03-03T05:55:46Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.22603","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.22603","identifiers":[{"identifier":"2602.22603","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Sanjay","familyName":"Kariyappa","name":"Kariyappa, Sanjay","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"G. Edward","familyName":"Suh","name":"Suh, G. Edward","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"SideQuest: Model-Driven KV Cache Management for Long-Horizon Agentic Reasoning"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-26T04:20:44Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:23:03Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02-27T19:10:42Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-03-03T01:06:31Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Long-running agentic tasks, such as deep research, require multi-hop reasoning over information distributed across multiple webpages and documents. In such tasks, the LLM context is dominated by tokens from external retrieval, causing memory usage to grow rapidly and limiting decode performance. While several KV cache compression techniques exist for long-context inputs, we find that existing heuristics fail to support multi-step reasoning models effectively. We address this challenge with SideQuest -- a novel approach that leverages the Large Reasoning Model (LRM) itself to perform KV cache compression by reasoning about the usefulness of tokens in its context. To prevent the tokens associated with this management process from polluting the model's memory, we frame KV cache compression as an auxiliary task executed in parallel to the main reasoning task. Our evaluations, using a model trained with just 215 samples, show that SideQuest reduces peak token usage by up to 65% on agentic tasks with minimal degradation in accuracy, outperforming heuristic-based KV cache compression techniques."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.22603","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T02:50:15Z","registered":"2026-02-27T02:50:15Z","published":null,"updated":"2026-03-03T05:55:45Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.23320","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.23320","identifiers":[{"identifier":"2602.23320","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Tianjun","familyName":"Yao","name":"Yao, Tianjun","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yongqiang","familyName":"Chen","name":"Chen, Yongqiang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yujia","familyName":"Zheng","name":"Zheng, Yujia","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Pan","familyName":"Li","name":"Li, Pan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zhiqiang","familyName":"Shen","name":"Shen, Zhiqiang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Kun","familyName":"Zhang","name":"Zhang, Kun","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"ParamMem: Augmenting Language Agents with Parametric Reflective Memory"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"Multiagent Systems (cs.MA)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"I.2.6","lang":"en","subjectScheme":"ACM"}],"contributors":[],"dates":[{"date":"2026-02-26T18:28:04Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T02:02:28Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02-27T08:21:31Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-03-02T01:32:08Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Self-reflection enables language agents to iteratively refine solutions, yet often produces repetitive outputs that limit reasoning performance. Recent studies have attempted to address this limitation through various approaches, among which increasing reflective diversity has shown promise. Our empirical analysis reveals a strong positive correlation between reflective diversity and task success, further motivating the need for diverse reflection signals. We introduce ParamMem, a parametric memory module that encodes cross-sample reflection patterns into model parameters, enabling diverse reflection generation through temperature-controlled sampling. Building on this module, we propose ParamAgent, a reflection-based agent framework that integrates parametric memory with episodic and cross-sample memory. Extensive experiments on code generation, mathematical reasoning, and multi-hop question answering demonstrate consistent improvements over state-of-the-art baselines. Further analysis reveals that ParamMem is sample-efficient, enables weak-to-strong transfer across model scales, and supports self-improvement without reliance on stronger external model, highlighting the potential of ParamMem as an effective component for enhancing language agents."},{"descriptionType":"Other","description":"20 pages"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.23320","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T03:07:57Z","registered":"2026-02-27T03:07:58Z","published":null,"updated":"2026-03-02T03:12:38Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.23296","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.23296","identifiers":[{"identifier":"2602.23296","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Quang-Huy","familyName":"Nguyen","name":"Nguyen, Quang-Huy","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jiaqi","familyName":"Wang","name":"Wang, Jiaqi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Wei-Shinn","familyName":"Ku","name":"Ku, Wei-Shinn","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Conformalized Neural Networks for Federated Uncertainty Quantification under Dual Heterogeneity"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-26T18:07:45Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T02:01:22Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02-27T08:21:48Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-03-02T01:32:09Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Federated learning (FL) faces challenges in uncertainty quantification (UQ). Without reliable UQ, FL systems risk deploying overconfident models at under-resourced agents, leading to silent local failures despite seemingly satisfactory global performance. Existing federated UQ approaches often address data heterogeneity or model heterogeneity in isolation, overlooking their joint effect on coverage reliability across agents. Conformal prediction is a widely used distribution-free UQ framework, yet its applications in heterogeneous FL settings remains underexplored. We provide FedWQ-CP, a simple yet effective approach that balances empirical coverage performance with efficiency at both global and agent levels under the dual heterogeneity. FedWQ-CP performs agent-server calibration in a single communication round. On each agent, conformity scores are computed on calibration data and a local quantile threshold is derived. Each agent then transmits only its quantile threshold and calibration sample size to the server. The server simply aggregates these thresholds through a weighted average to produce a global threshold. Experimental results on seven public datasets for both classification and regression demonstrate that FedWQ-CP empirically maintains agent-wise and global coverage while producing the smallest prediction sets or intervals."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.23296","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T03:07:23Z","registered":"2026-02-27T03:07:24Z","published":null,"updated":"2026-03-02T03:12:37Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.23285","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.23285","identifiers":[{"identifier":"2602.23285","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Haohui","familyName":"Jia","name":"Jia, Haohui","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zheng","familyName":"Chen","name":"Chen, Zheng","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Lingwei","familyName":"Zhu","name":"Zhu, Lingwei","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Rikuto","familyName":"Kotoge","name":"Kotoge, Rikuto","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jathurshan","familyName":"Pradeepkumar","name":"Pradeepkumar, Jathurshan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yasuko","familyName":"Matsubara","name":"Matsubara, Yasuko","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jimeng","familyName":"Sun","name":"Sun, Jimeng","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yasushi","familyName":"Sakurai","name":"Sakurai, Yasushi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Takashi","familyName":"Matsubara","name":"Matsubara, Takashi","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"ODEBrain: Continuous-Time EEG Graph for Modeling Dynamic Brain Networks"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-26T17:59:10Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T02:00:42Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02-27T02:54:11Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-03-02T01:16:27Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Modeling neural population dynamics is crucial for foundational neuroscientific research and various clinical applications. Conventional latent variable methods typically model continuous brain dynamics through discretizing time with recurrent architecture, which necessarily results in compounded cumulative prediction errors and failure of capturing instantaneous, nonlinear characteristics of EEGs. We propose ODEBRAIN, a Neural ODE latent dynamic forecasting framework to overcome these challenges by integrating spatio-temporal-frequency features into spectral graph nodes, followed by a Neural ODE modeling the continuous latent dynamics. Our design ensures that latent representations can capture stochastic variations of complex brain states at any given time point. Extensive experiments verify that ODEBRAIN can improve significantly over existing methods in forecasting EEG dynamics with enhanced robustness and generalization capabilities."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.23285","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T03:07:07Z","registered":"2026-02-27T03:07:08Z","published":null,"updated":"2026-03-02T03:12:36Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.23225","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.23225","identifiers":[{"identifier":"2602.23225","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Pengxiang","familyName":"Li","name":"Li, Pengxiang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Dilxat","familyName":"Muhtar","name":"Muhtar, Dilxat","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Tianlong","familyName":"Chen","name":"Chen, Tianlong","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Lu","familyName":"Yin","name":"Yin, Lu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Shiwei","familyName":"Liu","name":"Liu, Shiwei","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Why Diffusion Language Models Struggle with Truly Parallel (Non-Autoregressive) Decoding?"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-26T17:04:57Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:57:57Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02-27T02:41:06Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-03-02T01:15:17Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Diffusion Language Models (DLMs) are often advertised as enabling parallel token generation, yet practical fast DLMs frequently converge to left-to-right, autoregressive (AR)-like decoding dynamics. In contrast, genuinely non-AR generation is promising because it removes AR's sequential bottleneck, better exploiting parallel hardware to reduce synchronization/communication overhead and improve latency scaling with output length. We argue that a primary driver of AR-like decoding is a mismatch between DLM objectives and the highly sequential structure of widely used training data, including standard pretraining corpora and long chain-of-thought (CoT) supervision. Motivated by this diagnosis, we propose NAP (Non-Autoregressive Parallel DLMs), a proof-of-concept, data-centric approach that better aligns supervision with non-AR parallel decoding. NAP curates examples as multiple independent reasoning trajectories and couples them with a parallel-forced decoding strategy that encourages multi-token parallel updates. Across math reasoning benchmarks, NAP yields stronger performance under parallel decoding than DLMs trained on standard long CoT data, with gains growing as parallelism increases. Our results suggest that revisiting data and supervision is a principled direction for mitigating AR-like behavior and moving toward genuinely non-autoregressive parallel generation in DLMs. Our code is available at https://github.com/pixeli99/NAP."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.23225","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T03:05:36Z","registered":"2026-02-27T03:05:36Z","published":null,"updated":"2026-03-02T03:12:34Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.23109","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.23109","identifiers":[{"identifier":"2602.23109","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Kai","familyName":"Chen","name":"Chen, Kai","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yuyao","familyName":"Huang","name":"Huang, Yuyao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Guang","familyName":"Chen","name":"Chen, Guang","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Towards Intelligible Human-Robot Interaction: An Active Inference Approach to Occluded Pedestrian Scenarios"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Robotics (cs.RO)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-26T15:22:07Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:52:37Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02-27T02:36:06Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-03-02T01:15:04Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"The sudden appearance of occluded pedestrians presents a critical safety challenge in autonomous driving. Conventional rule-based or purely data-driven approaches struggle with the inherent high uncertainty of these long-tail scenarios. To tackle this challenge, we propose a novel framework grounded in Active Inference, which endows the agent with a human-like, belief-driven mechanism. Our framework leverages a Rao-Blackwellized Particle Filter (RBPF) to efficiently estimate the pedestrian's hybrid state. To emulate human-like cognitive processes under uncertainty, we introduce a Conditional Belief Reset mechanism and a Hypothesis Injection technique to explicitly model beliefs about the pedestrian's multiple latent intentions. Planning is achieved via a Cross-Entropy Method (CEM) enhanced Model Predictive Path Integral (MPPI) controller, which synergizes the efficient, iterative search of CEM with the inherent robustness of MPPI. Simulation experiments demonstrate that our approach significantly reduces the collision rate compared to reactive, rule-based, and reinforcement learning (RL) baselines, while also exhibiting explainable and human-like driving behavior that reflects the agent's internal belief state."},{"descriptionType":"Other","description":"14 pages, 6 figures, Proceedings of the 2026 ACM/IEEE International Conference on Human-Robot Interaction (HRI'26)"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.23109","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T03:02:37Z","registered":"2026-02-27T03:02:38Z","published":null,"updated":"2026-03-02T03:12:29Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.22816","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.22816","identifiers":[{"identifier":"2602.22816","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Marco","familyName":"Delbo","name":"Delbo, Marco","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Thomas","familyName":"Dyer","name":"Dyer, Thomas","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ullas","familyName":"Bhat","name":"Bhat, Ullas","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Chrysa","familyName":"Avdellidou","name":"Avdellidou, Chrysa","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Laurent","familyName":"Galluccio","name":"Galluccio, Laurent","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Amelia","familyName":"Milton","name":"Milton, Amelia","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Gaia DR3 supervised classification of asteroid reflectance spectra"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Earth and Planetary Astrophysics (astro-ph.EP)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-26T09:57:27Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:36:28Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02-27T10:05:28Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-03-02T01:37:08Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by-nc-nd/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution Non Commercial No Derivatives 4.0 International","rightsIdentifier":"cc-by-nc-nd-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"We present a supervised, probabilistic taxonomic classification of asteroid reflectance spectra from Gaia Data Release 3 (DR3). Using high-quality Gaia DR3 spectra and a reference set of spectra from the literature consisting exclusively of asteroids with robust spectroscopic taxonomic types, we construct a principal-component (PC) representation of the Gaia reflectances. For each major spectral complex (C, S, X) and several end-member classes (B, D, A, L, K, V), we model the distribution of reference objects in PC space using multivariate kernel density estimation (KDE). This yields likelihoods for each spectral class and provides a quantitative measure of classification confidence.\n Validation against a sample of objects with known spectral classes demonstrates good performance for classes with distinctive reflectance signatures, including the S-complex, D, V, and A types. Spectrally continuous classes (B-C-complex, K-L-S-complex, and X-complex) show the expected degrees of mixing given the limited wavelength range of Gaia's spectrophotometry. We further explore the compositional structure of six major asteroid collisional families using our Gaia-derived spectral classes, finding excellent agreement with ground-based spectroscopy and revealing enhanced detections of olivine-rich A type material in the Flora and Eunomia families, as well as new insights into the spectral diversity of the Tirela family.\n The resulting catalogue constitutes a fully probabilistic taxonomic classification for the full Gaia DR3 asteroid sample. It offers a resource for studying the compositional structure of the main belt, identifying family interlopers, and linking asteroid populations to meteorite groups, and establishes a methodological framework for future Gaia releases, in particular for the validation of the Gaia DR4, expected by the end of 2026."},{"descriptionType":"Other","description":"23 pages, 5 Figures"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.22816","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T02:55:22Z","registered":"2026-02-27T02:55:23Z","published":null,"updated":"2026-03-02T03:12:22Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.22695","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.22695","identifiers":[{"identifier":"2602.22695","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Yu","familyName":"Chen","name":"Chen, Yu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zewei","familyName":"He","name":"He, Zewei","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xingyu","familyName":"Liu","name":"Liu, Xingyu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zixuan","familyName":"Chen","name":"Chen, Zixuan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zheming","familyName":"Lu","name":"Lu, Zheming","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"GFRRN: Explore the Gaps in Single Image Reflection Removal"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-26T07:17:49Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:29:54Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02-27T15:03:14Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-03-02T01:50:11Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Prior dual-stream methods with the feature interaction mechanism have achieved remarkable performance in single image reflection removal (SIRR). However, they often struggle with (1) semantic understanding gap between the features of pre-trained models and those of reflection removal models, and (2) reflection label inconsistencies between synthetic and real-world training data. In this work, we first adopt the parameter efficient fine-tuning (PEFT) strategy by integrating several learnable Mona layers into the pre-trained model to align the training directions. Then, a label generator is designed to unify the reflection labels for both synthetic and real-world data. In addition, a Gaussian-based Adaptive Frequency Learning Block (G-AFLB) is proposed to adaptively learn and fuse the frequency priors, and a Dynamic Agent Attention (DAA) is employed as an alternative to window-based attention by dynamically modeling the significance levels across windows (inter-) and within an individual window (intra-). These components constitute our proposed Gap-Free Reflection Removal Network (GFRRN). Extensive experiments demonstrate the effectiveness of our GFRRN, achieving superior performance against state-of-the-art SIRR methods."},{"descriptionType":"Other","description":"CVPR26"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.22695","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T02:52:26Z","registered":"2026-02-27T02:52:27Z","published":null,"updated":"2026-03-02T03:12:18Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.22745","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.22745","identifiers":[{"identifier":"2602.22745","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Fengming","familyName":"Liu","name":"Liu, Fengming","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Tat-Jen","familyName":"Cham","name":"Cham, Tat-Jen","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Chuanxia","familyName":"Zheng","name":"Zheng, Chuanxia","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"SPATIALALIGN: Aligning Dynamic Spatial Relationships in Video Generation"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-26T08:34:09Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:32:38Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02-27T03:35:01Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-03-02T01:19:38Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by-nc-sa/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution Non Commercial Share Alike 4.0 International","rightsIdentifier":"cc-by-nc-sa-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Most text-to-video (T2V) generators prioritize aesthetic quality, but often ignoring the spatial constraints in the generated videos. In this work, we present SPATIALALIGN, a self-improvement framework that enhances T2V models capabilities to depict Dynamic Spatial Relationships (DSR) specified in text prompts. We present a zeroth-order regularized Direct Preference Optimization (DPO) to fine-tune T2V models towards better alignment with DSR. Specifically, we design DSR-SCORE, a geometry-based metric that quantitatively measures the alignment between generated videos and the specified DSRs in prompts, which is a step forward from prior works that rely on VLM for evaluation. We also conduct a dataset of text-video pairs with diverse DSRs to facilitate the study. Extensive experiments demonstrate that our fine-tuned model significantly out performs the baseline in spatial relationships. The code will be released in Link. Project page: https://fengming001ntu.github.io/SpatialAlign/"},{"descriptionType":"Other","description":"Project page: https://fengming001ntu.github.io/SpatialAlign/"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.22745","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T02:53:36Z","registered":"2026-02-27T02:53:37Z","published":null,"updated":"2026-03-02T03:12:18Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.22675","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.22675","identifiers":[{"identifier":"2602.22675","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Qianben","familyName":"Chen","name":"Chen, Qianben","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Tianrui","familyName":"Qin","name":"Qin, Tianrui","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"King","familyName":"Zhu","name":"Zhu, King","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Qiexiang","familyName":"Wang","name":"Wang, Qiexiang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Chengjun","familyName":"Yu","name":"Yu, Chengjun","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Shu","familyName":"Xu","name":"Xu, Shu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jiaqi","familyName":"Wu","name":"Wu, Jiaqi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jiayu","familyName":"Zhang","name":"Zhang, Jiayu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xinpeng","familyName":"Liu","name":"Liu, Xinpeng","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xin","familyName":"Gui","name":"Gui, Xin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jingyi","familyName":"Cao","name":"Cao, Jingyi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Piaohong","familyName":"Wang","name":"Wang, Piaohong","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Dingfeng","familyName":"Shi","name":"Shi, Dingfeng","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"He","familyName":"Zhu","name":"Zhu, He","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Tiannan","familyName":"Wang","name":"Wang, Tiannan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yuqing","familyName":"Wang","name":"Wang, Yuqing","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Maojia","familyName":"Song","name":"Song, Maojia","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Tianyu","familyName":"Zheng","name":"Zheng, Tianyu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ge","familyName":"Zhang","name":"Zhang, Ge","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jian","familyName":"Yang","name":"Yang, Jian","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jiaheng","familyName":"Liu","name":"Liu, Jiaheng","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Minghao","familyName":"Liu","name":"Liu, Minghao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yuchen Eleanor","familyName":"Jiang","name":"Jiang, Yuchen Eleanor","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Wangchunshu","familyName":"Zhou","name":"Zhou, Wangchunshu","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Search More, Think Less: Rethinking Long-Horizon Agentic Search for Efficiency and Generalization"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-26T06:46:41Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:28:38Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02-27T07:08:13Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-03-02T01:28:53Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Recent deep research agents primarily improve performance by scaling reasoning depth, but this leads to high inference cost and latency in search-intensive scenarios. Moreover, generalization across heterogeneous research settings remains challenging. In this work, we propose \\emph{Search More, Think Less} (SMTL), a framework for long-horizon agentic search that targets both efficiency and generalization. SMTL replaces sequential reasoning with parallel evidence acquisition, enabling efficient context management under constrained context budgets. To support generalization across task types, we further introduce a unified data synthesis pipeline that constructs search tasks spanning both deterministic question answering and open-ended research scenarios with task appropriate evaluation metrics. We train an end-to-end agent using supervised fine-tuning and reinforcement learning, achieving strong and often state of the art performance across benchmarks including BrowseComp (48.6\\%), GAIA (75.7\\%), Xbench (82.0\\%), and DeepResearch Bench (45.9\\%). Compared to Mirothinker-v1.0, SMTL with maximum 100 interaction steps reduces the average number of reasoning steps on BrowseComp by 70.7\\%, while improving accuracy."},{"descriptionType":"Other","description":"12 pages, 5 figures"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.22675","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T02:51:58Z","registered":"2026-02-27T02:51:58Z","published":null,"updated":"2026-03-02T03:12:15Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.22465","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.22465","identifiers":[{"identifier":"2602.22465","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Joseph","familyName":"Tso","name":"Tso, Joseph","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Preston","familyName":"Schmittou","name":"Schmittou, Preston","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Quan","familyName":"Huynh","name":"Huynh, Quan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jibran","familyName":"Hutchins","name":"Hutchins, Jibran","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"ConstraintBench: Benchmarking LLM Constraint Reasoning on Direct Optimization"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-25T22:54:26Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:10:56Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02-27T16:43:01Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-03-02T01:56:02Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Large language models are increasingly applied to operational decision-making where the underlying structure is constrained optimization. Existing benchmarks evaluate whether LLMs can formulate optimization problems as solver code, but leave open a complementary question. Can LLMs directly produce correct solutions to fully specified constrained optimization problems without access to a solver? We introduce ConstraintBench, a benchmark for evaluating LLMs on direct constrained optimization across 10 operations research domains, with all ground-truth solutions verified by the Gurobi solver. Each task presents a natural-language scenario with entities, constraints, and an optimization objective; the model must return a structured solution that a deterministic verifier checks against every constraint and the solver-proven optimum. We evaluate six frontier models on 200 tasks and find that feasibility, not optimality, is the primary bottleneck. The best model achieves only 65.0% feasibility, yet feasible solutions average 89 to 96% of the Gurobi-optimal objective. No model exceeds 30.5% on joint feasibility and optimality within 0.1% of the solver reference. Per-domain analysis shows large variation in difficulty, with average feasibility spanning from 85.0% in the facility location domain to 0.8% in the crew assignment domain. Further, systematic failure modes include duration constraint misunderstanding, entity hallucination, and a feasibility-optimality decoupling in facility location and vehicle routing where models achieve high feasibility but 0% optimality. ConstraintBench and all evaluation infrastructure will be publicly released."},{"descriptionType":"Other","description":"Preprint. 10 pages, 1 figure, 6 tables. Benchmark and evaluation code will be publicly released"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.22465","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T02:46:59Z","registered":"2026-02-27T02:47:00Z","published":null,"updated":"2026-03-02T03:12:12Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.22287","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.22287","identifiers":[{"identifier":"2602.22287","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Willem","familyName":"Schooltink","name":"Schooltink, Willem","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Fabio Massimo","familyName":"Zennaro","name":"Zennaro, Fabio Massimo","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Multi-Level Causal Embeddings"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-25T14:14:13Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:01:56Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02-27T13:49:46Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-03-02T01:45:53Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Abstractions of causal models allow for the coarsening of models such that relations of cause and effect are preserved. Whereas abstractions focus on the relation between two models, in this paper we study a framework for causal embeddings which enable multiple detailed models to be mapped into sub-systems of a coarser causal model. We define causal embeddings as a generalization of abstraction, and present a generalized notion of consistency. By defining a multi-resolution marginal problem, we showcase the relevance of causal embeddings for both the statistical marginal problem and the causal marginal problem; furthermore, we illustrate its practical use in merging datasets coming from models with different representations."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.22287","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T02:42:54Z","registered":"2026-02-27T02:42:54Z","published":null,"updated":"2026-03-02T03:12:04Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.23351","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.23351","identifiers":[{"identifier":"2602.23351","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Amita","familyName":"Kamath","name":"Kamath, Amita","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jack","familyName":"Hessel","name":"Hessel, Jack","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Khyathi","familyName":"Chandu","name":"Chandu, Khyathi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jena D.","familyName":"Hwang","name":"Hwang, Jena D.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Kai-Wei","familyName":"Chang","name":"Chang, Kai-Wei","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ranjay","familyName":"Krishna","name":"Krishna, Ranjay","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Scale Can't Overcome Pragmatics: The Impact of Reporting Bias on Vision-Language Reasoning"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-26T18:54:06Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T02:03:33Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"The lack of reasoning capabilities in Vision-Language Models (VLMs) has remained at the forefront of research discourse. We posit that this behavior stems from a reporting bias in their training data. That is, how people communicate about visual content by default omits tacit information needed to supervise some types of reasoning; e.g., \"at the game today!\" is a more likely caption than \"a photo of 37 people standing behind a field\". We investigate the data underlying the popular VLMs OpenCLIP, LLaVA-1.5 and Molmo through the lens of theories from pragmatics, and find that reporting bias results in insufficient representation of four reasoning skills (spatial, temporal, negation, and counting), despite the corpora being of web-scale, and/or synthetically generated. With a set of curated benchmarks, we demonstrate that: (i) VLMs perform poorly on the aforementioned types of reasoning suppressed in the training data by reporting bias; (ii) contrary to popular belief, scaling data size, model size, and to multiple languages does not result in emergence of these skills by default; but, promisingly, (iii) incorporating annotations specifically collected to obtain tacit information is effective. Our findings highlight the need for more intentional training data curation methods, rather than counting on scale for emergence of reasoning capabilities."},{"descriptionType":"Other","description":"TACL 2026"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.23351","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T03:08:43Z","registered":"2026-02-27T03:08:43Z","published":null,"updated":"2026-02-27T03:08:43Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.23345","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.23345","identifiers":[{"identifier":"2602.23345","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Ruiqi","familyName":"Wang","name":"Wang, Ruiqi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Pinjun","familyName":"Zheng","name":"Zheng, Pinjun","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yiming","familyName":"Yang","name":"Yang, Yiming","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xiarui","familyName":"Su","name":"Su, Xiarui","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Mohammad","familyName":"Vaseem","name":"Vaseem, Mohammad","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Anas","familyName":"Chaaban","name":"Chaaban, Anas","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Md. Jahangir","familyName":"Hossain","name":"Hossain, Md. Jahangir","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Tareq Y.","familyName":"Al-Naffouri","name":"Al-Naffouri, Tareq Y.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Atif","familyName":"Shamim","name":"Shamim, Atif","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Millimeter-Wave RIS: Hardware Design and System-Level Considerations"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Systems and Control (eess.SY)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Electrical engineering, electronic engineering, information engineering","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Electrical engineering, electronic engineering, information engineering","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-26T18:49:53Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T02:03:23Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Reconfigurable intelligent surfaces have emerged as a promising hardware platform for shaping wireless propagation environments at millimeter-wave (mm-Wave) frequencies and beyond. While many existing studies emphasize channel modeling and signal processing, practical RIS deployment is fundamentally governed by hardware design choices and their system-level implications. This paper presents a hardware-centric overview of recent mm-Wave RIS developments, covering wideband realizations, high-resolution phase-quantized designs, fully printed low-cost implementations, optically transparent surfaces, RIS-on-chip solutions, and emerging three-dimensional architectures. Key challenges including mutual coupling, calibration, multi-RIS interaction, and frequency-dependent phase control are discussed to bridge hardware realization with system-level optimization. This overview provides practical design insights and aims to guide future RIS research toward scalable, efficient, and practically deployable intelligent surface architectures."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.23345","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T03:08:34Z","registered":"2026-02-27T03:08:35Z","published":null,"updated":"2026-02-27T03:08:35Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.23339","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.23339","identifiers":[{"identifier":"2602.23339","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Tilemachos","familyName":"Aravanis","name":"Aravanis, Tilemachos","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Vladan","familyName":"Stojnić","name":"Stojnić, Vladan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Bill","familyName":"Psomas","name":"Psomas, Bill","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Nikos","familyName":"Komodakis","name":"Komodakis, Nikos","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Giorgos","familyName":"Tolias","name":"Tolias, Giorgos","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Retrieve and Segment: Are a Few Examples Enough to Bridge the Supervision Gap in Open-Vocabulary Segmentation?"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-26T18:45:33Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T02:03:16Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Open-vocabulary segmentation (OVS) extends the zero-shot recognition capabilities of vision-language models (VLMs) to pixel-level prediction, enabling segmentation of arbitrary categories specified by text prompts. Despite recent progress, OVS lags behind fully supervised approaches due to two challenges: the coarse image-level supervision used to train VLMs and the semantic ambiguity of natural language. We address these limitations by introducing a few-shot setting that augments textual prompts with a support set of pixel-annotated images. Building on this, we propose a retrieval-augmented test-time adapter that learns a lightweight, per-image classifier by fusing textual and visual support features. Unlike prior methods relying on late, hand-crafted fusion, our approach performs learned, per-query fusion, achieving stronger synergy between modalities. The method supports continually expanding support sets, and applies to fine-grained tasks such as personalized segmentation. Experiments show that we significantly narrow the gap between zero-shot and supervised segmentation while preserving open-vocabulary ability."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.23339","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T03:08:25Z","registered":"2026-02-27T03:08:26Z","published":null,"updated":"2026-02-27T03:08:26Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.23336","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.23336","identifiers":[{"identifier":"2602.23336","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Camilo","familyName":"Gomez","name":"Gomez, Camilo","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Pengyang","familyName":"Wang","name":"Wang, Pengyang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Liansheng","familyName":"Tang","name":"Tang, Liansheng","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Differentiable Zero-One Loss via Hypersimplex Projections"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"Machine Learning (stat.ML)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-26T18:41:31Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T02:03:12Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Recent advances in machine learning have emphasized the integration of structured optimization components into end-to-end differentiable models, enabling richer inductive biases and tighter alignment with task-specific objectives. In this work, we introduce a novel differentiable approximation to the zero-one loss-long considered the gold standard for classification performance, yet incompatible with gradient-based optimization due to its non-differentiability. Our method constructs a smooth, order-preserving projection onto the n,k-dimensional hypersimplex through a constrained optimization framework, leading to a new operator we term Soft-Binary-Argmax. After deriving its mathematical properties, we show how its Jacobian can be efficiently computed and integrated into binary and multiclass learning systems. Empirically, our approach achieves significant improvements in generalization under large-batch training by imposing geometric consistency constraints on the output logits, thereby narrowing the performance gap traditionally observed in large-batch training."},{"descriptionType":"Other","description":"To appear in PAKDD 2026 (Pacific-Asia Conference on Knowledge Discovery and Data Mining), 12 pages"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.23336","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T03:08:21Z","registered":"2026-02-27T03:08:22Z","published":null,"updated":"2026-02-27T03:08:22Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.23335","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.23335","identifiers":[{"identifier":"2602.23335","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Dany","familyName":"Haddad","name":"Haddad, Dany","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Dan","familyName":"Bareket","name":"Bareket, Dan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Joseph Chee","familyName":"Chang","name":"Chang, Joseph Chee","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jay","familyName":"DeYoung","name":"DeYoung, Jay","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jena D.","familyName":"Hwang","name":"Hwang, Jena D.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Uri","familyName":"Katz","name":"Katz, Uri","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Mark","familyName":"Polak","name":"Polak, Mark","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Sangho","familyName":"Suh","name":"Suh, Sangho","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Harshit","familyName":"Surana","name":"Surana, Harshit","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Aryeh","familyName":"Tiktinsky","name":"Tiktinsky, Aryeh","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Shriya","familyName":"Atmakuri","name":"Atmakuri, Shriya","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jonathan","familyName":"Bragg","name":"Bragg, Jonathan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Mike","familyName":"D'Arcy","name":"D'Arcy, Mike","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Sergey","familyName":"Feldman","name":"Feldman, Sergey","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Amal","familyName":"Hassan-Ali","name":"Hassan-Ali, Amal","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Rubén","familyName":"Lozano","name":"Lozano, Rubén","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Bodhisattwa Prasad","familyName":"Majumder","name":"Majumder, Bodhisattwa Prasad","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Charles","familyName":"McGrady","name":"McGrady, Charles","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Amanpreet","familyName":"Singh","name":"Singh, Amanpreet","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Brooke","familyName":"Vlahos","name":"Vlahos, Brooke","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yoav","familyName":"Goldberg","name":"Goldberg, Yoav","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Doug","familyName":"Downey","name":"Downey, Doug","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Understanding Usage and Engagement in AI-Powered Scientific Research Tools: The Asta Interaction Dataset"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Human-Computer Interaction (cs.HC)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"Information Retrieval (cs.IR)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-26T18:40:28Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T02:03:10Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"AI-powered scientific research tools are rapidly being integrated into research workflows, yet the field lacks a clear lens into how researchers use these systems in real-world settings. We present and analyze the Asta Interaction Dataset, a large-scale resource comprising over 200,000 user queries and interaction logs from two deployed tools (a literature discovery interface and a scientific question-answering interface) within an LLM-powered retrieval-augmented generation platform. Using this dataset, we characterize query patterns, engagement behaviors, and how usage evolves with experience. We find that users submit longer and more complex queries than in traditional search, and treat the system as a collaborative research partner, delegating tasks such as drafting content and identifying research gaps. Users treat generated responses as persistent artifacts, revisiting and navigating among outputs and cited evidence in non-linear ways. With experience, users issue more targeted queries and engage more deeply with supporting citations, although keyword-style queries persist even among experienced users. We release the anonymized dataset and analysis with a new query intent taxonomy to inform future designs of real-world AI research assistants and to support realistic evaluation."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.23335","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T03:08:20Z","registered":"2026-02-27T03:08:21Z","published":null,"updated":"2026-02-27T03:08:21Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.23330","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.23330","identifiers":[{"identifier":"2602.23330","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Kunihiro","familyName":"Miyazaki","name":"Miyazaki, Kunihiro","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Takanobu","familyName":"Kawahara","name":"Kawahara, Takanobu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Stephen","familyName":"Roberts","name":"Roberts, Stephen","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Stefan","familyName":"Zohren","name":"Zohren, Stefan","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Toward Expert Investment Teams:A Multi-Agent LLM System with Fine-Grained Trading Tasks"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"Trading and Market Microstructure (q-fin.TR)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"FOS: Economics and business","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Economics and business","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-26T18:37:36Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T02:03:01Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"The advancement of large language models (LLMs) has accelerated the development of autonomous financial trading systems. While mainstream approaches deploy multi-agent systems mimicking analyst and manager roles, they often rely on abstract instructions that overlook the intricacies of real-world workflows, which can lead to degraded inference performance and less transparent decision-making. Therefore, we propose a multi-agent LLM trading framework that explicitly decomposes investment analysis into fine-grained tasks, rather than providing coarse-grained instructions. We evaluate the proposed framework using Japanese stock data, including prices, financial statements, news, and macro information, under a leakage-controlled backtesting setting. Experimental results show that fine-grained task decomposition significantly improves risk-adjusted returns compared to conventional coarse-grained designs. Crucially, further analysis of intermediate agent outputs suggests that alignment between analytical outputs and downstream decision preferences is a critical driver of system performance. Moreover, we conduct standard portfolio optimization, exploiting low correlation with the stock index and the variance of each system's output. This approach achieves superior performance. These findings contribute to the design of agent structure and task configuration when applying LLM agents to trading systems in practical settings."},{"descriptionType":"Other","description":"14 pages, 3 figures"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.23330","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T03:08:13Z","registered":"2026-02-27T03:08:13Z","published":null,"updated":"2026-02-27T03:08:13Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.23326","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.23326","identifiers":[{"identifier":"2602.23326","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Andrea","familyName":"Montanari","name":"Montanari, Andrea","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Spin Glass Concepts in Computer Science, Statistics, and Learning"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Probability (math.PR)","lang":"en","subjectScheme":"arXiv"},{"subject":"Disordered Systems and Neural Networks (cond-mat.dis-nn)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-26T18:35:47Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T02:02:49Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Spin glass theory studies the structure of sublevel sets and minima (or near-minima) of certain classes of random functions in high dimension. Near-minima of random functions also play an important role in high-dimensional statistics and statistical learning, where minimizing the empirical risk (which is a random function of the model parameters) is the method of choice for learning a statistical model from noisy data. Finally, near-minima of random functions are obviously central to average-case analysis of optimization algorithms. Computer science, statistics, and machine learning naturally lead to questions that are traditionally not addressed within physics and mathematical physics. I will try to explain how ideas from spin glass theory have seeded recent developments in these fields.\n (This article was written on the occasion of the 2024 Abel Prize to Michel Talagrand.)"},{"descriptionType":"Other","description":"33 pages; 2 pdf figures"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.23326","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T03:08:06Z","registered":"2026-02-27T03:08:06Z","published":null,"updated":"2026-02-27T03:08:07Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.23314","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.23314","identifiers":[{"identifier":"2602.23314","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Marcel","familyName":"Warzecha","name":"Warzecha, Marcel","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Sebastian","familyName":"Resch-Schopper","name":"Resch-Schopper, Sebastian","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Gerhard","familyName":"Müller","name":"Müller, Gerhard","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Uncertainty-Aware Calculation of Analytical Gradients of Matrix-Interpolatory Reduced-Order Models for Efficient Structural Optimization"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Computational Engineering, Finance, and Science (cs.CE)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-26T18:21:59Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T02:02:05Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"This paper presents an adaptive sampling algorithm tailored for the optimization of parametrized dynamical systems using projection-based model order reduction. Unlike classical sampling strategies, this framework does not aim for a small approximation error in the global sense but focuses on identifying and refining promising regions early on while reducing expensive full order model evaluations. The algorithm is tested on two models: a Timoshenko beam and a Kelvin cell, which ought to be optimized in terms of the system output in the frequency domain. For that, different norms of the transfer function are used as the objective function, while up to two geometrical parameters form the vector of design variables. The sampled full order models are reduced using the iterative rational Krylov algorithm and reprojected into a global basis. Subsequently, the models are parametrized by performing sparse Bayesian regression on matrix entry level of the reduced operators. Thompson sampling is carried out using the posterior distribution of the polynomial coefficients in order to account for uncertainties in the trained regression models. The strategy deployed for sample acquisition incorporates a gradient-based search on the parametrized reduced order model, which involves analytical gradients obtained via adjoint sensitivity analysis. By adding the found optimum to the sample set, the sample set is iteratively refined. Results demonstrate robust convergence towards the global optimum but highlight the computational cost introduced by the gradient-based optimization. The probabilistic extensions seamlessly integrate into existing matrix-interpolatory reduction frameworks and enable the analytical calculation of gradients under uncertainty."},{"descriptionType":"Other","description":"25 pages, 10 figures"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.23314","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T03:07:49Z","registered":"2026-02-27T03:07:50Z","published":null,"updated":"2026-02-27T03:07:50Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.23286","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.23286","identifiers":[{"identifier":"2602.23286","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Sungho","familyName":"Park","name":"Park, Sungho","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jueun","familyName":"Kim","name":"Kim, Jueun","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Wook-Shin","familyName":"Han","name":"Han, Wook-Shin","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"SPARTA: Scalable and Principled Benchmark of Tree-Structured Multi-hop QA over Text and Tables"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"Databases (cs.DB)","lang":"en","subjectScheme":"arXiv"},{"subject":"Information Retrieval (cs.IR)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"H.2.4; H.3.3; H.3.4; I.2.7; I.2.1; H.2.3; F.2.2; I.2.6; H.3.1","lang":"en","subjectScheme":"ACM"}],"contributors":[],"dates":[{"date":"2026-02-26T17:59:51Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T02:00:45Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Real-world Table-Text question answering (QA) tasks require models that can reason across long text and source tables, traversing multiple hops and executing complex operations such as aggregation. Yet existing benchmarks are small, manually curated - and therefore error-prone - and contain shallow questions that seldom demand more than two hops or invoke aggregations, grouping, or other advanced analytical operations expressible in natural-language queries. We present SPARTA, an end-to-end construction framework that automatically generates large-scale Table-Text QA benchmarks with lightweight human validation, requiring only one quarter of the annotation time of HybridQA. The framework first constructs a reference fact database by enriching each source table with grounding tables whose tuples are atomic facts automatically extracted from the accompanying unstructured passages, then synthesizes nested queries whose number of nested predicates matches the desired hop count. To ensure that every SQL statement is executable and that its verbalization yields a fluent, human-sounding question, we propose two novel techniques: provenance-based refinement, which rewrites any syntactically valid query that returns a non-empty result, and realistic-structure enforcement, which confines generation to post-order traversals of the query graph. The resulting pipeline produces thousands of high-fidelity question-answer pairs covering aggregations, grouping, and deep multi-hop reasoning across text and tables. On SPARTA, state-of-the-art models that reach over 70 F1 on HybridQA or over 50 F1 on OTT-QA drop by more than 30 F1 points, exposing fundamental weaknesses in current cross-modal reasoning. Our benchmark, construction code, and baseline models are available at https://github.com/pshlego/SPARTA/tree/main."},{"descriptionType":"Other","description":"10 pages, 5 figures. Published as a conference paper at ICLR 2026. Project page: https://sparta-projectpage.github.io/"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.23286","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T03:07:09Z","registered":"2026-02-27T03:07:10Z","published":null,"updated":"2026-02-27T03:07:10Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.23260","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.23260","identifiers":[{"identifier":"2602.23260","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Mehdi","familyName":"Karimi","name":"Karimi, Mehdi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Levent","familyName":"Tuncel","name":"Tuncel, Levent","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Efficient Interior-Point Methods for Hyperbolic Programming via Straight-Line Programs"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Optimization and Control (math.OC)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-26T17:32:55Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:59:30Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Hyperbolic (HB) programming generalizes many popular convex optimization problems, including semidefinite and second-order cone programming. Despite substantial theoretical progress on HB programming, efficient computational tools for solving large-scale hyperbolic programs remain limited. This paper presents DDS 3.0, a new release of the Domain-Driven Solver, which provides an efficient interior-point implementation tailored for hyperbolic programming. A key innovation lies in a new straight-line program (SLP) representation that enables compact representation and efficient computation of hyperbolic polynomials, their gradients, and Hessians. The SLP structure significantly reduces computational cost, allowing the Hessian to be computed in the same asymptotic complexity as the gradient through a batched reverse-over-forward differentiation scheme. We further introduce an improved corrector step for the primal-dual interior-point method, enhancing stability and convergence on convex sets where only the primal self-concordant barrier is efficiently computable. We create a comprehensive benchmark library beyond the elementary symmetric polynomials, using several different techniques. Numerical experiments demonstrate substantial performance gains of DDS 3.0 compared to first-order Frank-Wolfe algorithm, homotopy method, and SDP software utilizing SDP relaxations."},{"descriptionType":"Other","description":"30 pages, 7 Tables, 3 figures"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.23260","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T03:06:29Z","registered":"2026-02-27T03:06:30Z","published":null,"updated":"2026-02-27T03:06:30Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.23259","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.23259","identifiers":[{"identifier":"2602.23259","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Jiangxin","familyName":"Sun","name":"Sun, Jiangxin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Feng","familyName":"Xue","name":"Xue, Feng","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Teng","familyName":"Long","name":"Long, Teng","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Chang","familyName":"Liu","name":"Liu, Chang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jian-Fang","familyName":"Hu","name":"Hu, Jian-Fang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Wei-Shi","familyName":"Zheng","name":"Zheng, Wei-Shi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Nicu","familyName":"Sebe","name":"Sebe, Nicu","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Risk-Aware World Model Predictive Control for Generalizable End-to-End Autonomous Driving"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"Robotics (cs.RO)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-26T17:32:30Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:59:29Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by-nc-nd/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution Non Commercial No Derivatives 4.0 International","rightsIdentifier":"cc-by-nc-nd-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"With advances in imitation learning (IL) and large-scale driving datasets, end-to-end autonomous driving (E2E-AD) has made great progress recently. Currently, IL-based methods have become a mainstream paradigm: models rely on standard driving behaviors given by experts, and learn to minimize the discrepancy between their actions and expert actions. However, this objective of \"only driving like the expert\" suffers from limited generalization: when encountering rare or unseen long-tail scenarios outside the distribution of expert demonstrations, models tend to produce unsafe decisions in the absence of prior experience. This raises a fundamental question: Can an E2E-AD system make reliable decisions without any expert action supervision? Motivated by this, we propose a unified framework named Risk-aware World Model Predictive Control (RaWMPC) to address this generalization dilemma through robust control, without reliance on expert demonstrations. Practically, RaWMPC leverages a world model to predict the consequences of multiple candidate actions and selects low-risk actions through explicit risk evaluation. To endow the world model with the ability to predict the outcomes of risky driving behaviors, we design a risk-aware interaction strategy that systematically exposes the world model to hazardous behaviors, making catastrophic outcomes predictable and thus avoidable. Furthermore, to generate low-risk candidate actions at test time, we introduce a self-evaluation distillation method to distill riskavoidance capabilities from the well-trained world model into a generative action proposal network without any expert demonstration. Extensive experiments show that RaWMPC outperforms state-of-the-art methods in both in-distribution and out-of-distribution scenarios, while providing superior decision interpretability."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.23259","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T03:06:28Z","registered":"2026-02-27T03:06:29Z","published":null,"updated":"2026-02-27T03:06:29Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.23254","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.23254","identifiers":[{"identifier":"2602.23254","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Ziyue","familyName":"Hua","name":"Hua, Ziyue","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Chuanlong","familyName":"Ma","name":"Ma, Chuanlong","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yilong","familyName":"Zhou","name":"Zhou, Yilong","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yifang","familyName":"Xu","name":"Xu, Yifang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zi-Jie","familyName":"Chen","name":"Chen, Zi-Jie","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Weizhou","familyName":"Cai","name":"Cai, Weizhou","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jiajun","familyName":"Chen","name":"Chen, Jiajun","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Lintao","familyName":"Xiao","name":"Xiao, Lintao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Hongwei","familyName":"Huang","name":"Huang, Hongwei","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Weiting","familyName":"Wang","name":"Wang, Weiting","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Hekang","familyName":"Li","name":"Li, Hekang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Haohua","familyName":"Wang","name":"Wang, Haohua","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ming","familyName":"Li","name":"Li, Ming","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Chang-Ling","familyName":"Zou","name":"Zou, Chang-Ling","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Luyan","familyName":"Sun","name":"Sun, Luyan","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Quantum Confocal Microscopy in Fock Space with a 19 dB Metrological Gain"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Quantum Physics (quant-ph)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-26T17:27:45Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:59:13Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Quantum metrology promises measurement precision beyond classical limits by exploiting large-scale quantum states, yet realizing this advantage faces two fundamental challenges: the deterministic preparation of non-trivial quantum probes and the efficient extraction of metrological information in high-dimensional Hilbert spaces. Here, we introduce quantum confocal microscopy in Fock space that simultaneously resolves both challenges. Drawing a direct analogy between classical wave optics and quantum state evolution in a bosonic mode, we construct a confocal system with two Fock-space lenses. The first lens deterministically focuses a coherent state into a quantum probe with a tightly concentrated photon-number distribution, while the second lens maps the metrological information back to the vacuum state for efficient readout. Using a superconducting circuit QED platform, we prepare focused probe states with mean photon numbers up to ${N} = 500$, achieving a 21.5$\\pm$1.1 dB compression of the photon-number uncertainty relative to a coherent state, with a scalable quantum circuit of $\\mathcal{O}(1)$ operational depth. We demonstrate a displacement sensitivity scaling as $N^{-0.416}$, approaching the Heisenberg scaling ($N^{-0.5}$), and achieve a record metrological gain of 19.06$\\pm$0.13 dB beyond the standard quantum limit. This work establishes quantum confocal microscopy as a scalable and practical framework for quantum-enhanced precision measurement, readily extendable to other bosonic platforms and high-dimensional quantum many-body systems."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.23254","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T03:06:20Z","registered":"2026-02-27T03:06:21Z","published":null,"updated":"2026-02-27T03:06:21Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.23253","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.23253","identifiers":[{"identifier":"2602.23253","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Yijie","familyName":"Guo","name":"Guo, Yijie","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Iretiayo","familyName":"Akinola","name":"Akinola, Iretiayo","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Lars","familyName":"Johannsmeier","name":"Johannsmeier, Lars","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Hugo","familyName":"Hadfield","name":"Hadfield, Hugo","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Abhishek","familyName":"Gupta","name":"Gupta, Abhishek","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yashraj","familyName":"Narang","name":"Narang, Yashraj","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"SPARR: Simulation-based Policies with Asymmetric Real-world Residuals for Assembly"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Robotics (cs.RO)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-26T17:26:13Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:59:06Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Robotic assembly presents a long-standing challenge due to its requirement for precise, contact-rich manipulation. While simulation-based learning has enabled the development of robust assembly policies, their performance often degrades when deployed in real-world settings due to the sim-to-real gap. Conversely, real-world reinforcement learning (RL) methods avoid the sim-to-real gap, but rely heavily on human supervision and lack generalization ability to environmental changes. In this work, we propose a hybrid approach that combines a simulation-trained base policy with a real-world residual policy to efficiently adapt to real-world variations. The base policy, trained in simulation using low-level state observations and dense rewards, provides strong priors for initial behavior. The residual policy, learned in the real world using visual observations and sparse rewards, compensates for discrepancies in dynamics and sensor noise. Extensive real-world experiments demonstrate that our method, SPARR, achieves near-perfect success rates across diverse two-part assembly tasks. Compared to the state-of-the-art zero-shot sim-to-real methods, SPARR improves success rates by 38.4% while reducing cycle time by 29.7%. Moreover, SPARR requires no human expertise, in contrast to the state-of-the-art real-world RL approaches that depend heavily on human supervision."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.23253","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T03:06:19Z","registered":"2026-02-27T03:06:19Z","published":null,"updated":"2026-02-27T03:06:19Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.23252","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.23252","identifiers":[{"identifier":"2602.23252","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Maximilian","familyName":"Kalcher","name":"Kalcher, Maximilian","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Tena","familyName":"Dubcek","name":"Dubcek, Tena","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"A Scaling Law for Bandwidth Under Quantization"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Signal Processing (eess.SP)","lang":"en","subjectScheme":"arXiv"},{"subject":"Information Theory (cs.IT)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Electrical engineering, electronic engineering, information engineering","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Electrical engineering, electronic engineering, information engineering","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-26T17:26:11Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:59:03Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"We derive a scaling law relating ADC bit depth to effective bandwidth for signals with $1/f^α$ power spectra. Quantization introduces a flat noise floor whose intersection with the declining signal spectrum defines an effective cutoff frequency $f_c$. We show that each additional bit extends this cutoff by a factor of $2^{2/α}$, approximately doubling bandwidth per bit for $α= 2$. The law requires that quantization noise be approximately white, a condition whose minimum bit depth $N_{\\min}$ we show to be $α$-dependent. Validation on synthetic $1/f^α$ signals for $α\\in \\{1.5, 2.0, 2.5\\}$ yields prediction errors below 3\\% using the theoretical noise floor $Δ^2/(6f_s)$, and approximately 14\\% when the noise floor is estimated empirically from the quantized signal's spectrum. We illustrate practical implications on real EEG data."},{"descriptionType":"Other","description":"4 pages, 3 figures, submitted to IEEE Signal Processing Letters"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.23252","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T03:06:17Z","registered":"2026-02-27T03:06:18Z","published":null,"updated":"2026-02-27T03:06:18Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.23241","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.23241","identifiers":[{"identifier":"2602.23241","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Yunxiao","familyName":"Li","name":"Li, Yunxiao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Qian","familyName":"Zhang","name":"Zhang, Qian","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xuejun","familyName":"Cheng","name":"Cheng, Xuejun","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zhiguo","familyName":"Wang","name":"Wang, Zhiguo","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xiaoyan","familyName":"Wang","name":"Wang, Xiaoyan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Hongji","familyName":"Xu","name":"Xu, Hongji","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ju","familyName":"Liu","name":"Liu, Ju","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Secure Transmission for Fluid Antenna-Aided ISAC Systems"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Information Theory (cs.IT)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-26T17:19:32Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:58:35Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Fluid antenna (FA) has become a highly promising technology and has recently been used to enhance the integrated sensing and communication (ISAC) system. However, the scenario where sensing targets act as eavesdroppers in ISAC and how to maximize the sum secrecy rate has not been addressed. This letter investigates secure transmission in FA-aided ISAC systems, where the spatial agility of FAs enables enhanced physical layer security. We jointly optimize antenna position vector (APV) and beamforming to maximize the multiuser sum secrecy rate, which complicates the solution process. To solve the resulting non-convex problem, we use a block successive upper-bound minimization (BSUM) algorithm, which incorporates the proximal distance algorithm (PDA) for closed-form beamformer updates and extrapolated projected gradient (EPG) for APV optimization. Simulation results show that the proposed FA-ISAC scheme achieves over 20$\\%$ sum secrecy rate gain compared to fixed-position antenna (FPA) systems."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.23241","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T03:06:00Z","registered":"2026-02-27T03:06:01Z","published":null,"updated":"2026-02-27T03:06:01Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.23224","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.23224","identifiers":[{"identifier":"2602.23224","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Mohammad","familyName":"Mahdavian","name":"Mahdavian, Mohammad","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Gordon","familyName":"Tan","name":"Tan, Gordon","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Binbin","familyName":"Xu","name":"Xu, Binbin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yuan","familyName":"Ren","name":"Ren, Yuan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Dongfeng","familyName":"Bai","name":"Bai, Dongfeng","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Bingbing","familyName":"Liu","name":"Liu, Bingbing","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"UniScale: Unified Scale-Aware 3D Reconstruction for Multi-View Understanding via Prior Injection for Robotic Perception"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"Robotics (cs.RO)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-26T17:04:36Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:57:55Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"We present UniScale, a unified, scale-aware multi-view 3D reconstruction framework for robotic applications that flexibly integrates geometric priors through a modular, semantically informed design. In vision-based robotic navigation, the accurate extraction of environmental structure from raw image sequences is critical for downstream tasks. UniScale addresses this challenge with a single feed-forward network that jointly estimates camera intrinsics and extrinsics, scale-invariant depth and point maps, and the metric scale of a scene from multi-view images, while optionally incorporating auxiliary geometric priors when available. By combining global contextual reasoning with camera-aware feature representations, UniScale is able to recover the metric-scale of the scene. In robotic settings where camera intrinsics are known, they can be easily incorporated to improve performance, with additional gains obtained when camera poses are also available. This co-design enables robust, metric-aware 3D reconstruction within a single unified model. Importantly, UniScale does not require training from scratch, and leverages world priors exhibited in pre-existing models without geometric encoding strategies, making it particularly suitable for resource-constrained robotic teams. We evaluate UniScale on multiple benchmarks, demonstrating strong generalization and consistent performance across diverse environments. We will release our implementation upon acceptance."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.23224","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T03:05:34Z","registered":"2026-02-27T03:05:35Z","published":null,"updated":"2026-02-27T03:05:35Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.23220","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.23220","identifiers":[{"identifier":"2602.23220","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Chris","familyName":"Egersdoerfer","name":"Egersdoerfer, Chris","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Philip","familyName":"Carns","name":"Carns, Philip","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Shane","familyName":"Snyder","name":"Snyder, Shane","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Robert","familyName":"Ross","name":"Ross, Robert","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Dong","familyName":"Dai","name":"Dai, Dong","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"STELLAR: Storage Tuning Engine Leveraging LLM Autonomous Reasoning for High Performance Parallel File Systems"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Distributed, Parallel, and Cluster Computing (cs.DC)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-26T17:01:18Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:57:46Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[{"relationType":"IsVersionOf","relatedIdentifier":"10.1145/3712285.3759887","relatedIdentifierType":"DOI"}],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"I/O performance is crucial to efficiency in data-intensive scientific computing; but tuning large-scale storage systems is complex, costly, and notoriously manpower-intensive, making it inaccessible for most domain scientists. To address this problem, we propose STELLAR, an autonomous tuner for high-performance parallel file systems. Our evaluations show that STELLAR almost always selects near-optimal parameter configurations for parallel file systems within the first five attempts, even for previously unseen applications.\n STELLAR differs fundamentally from traditional autotuning methods, which often require hundreds of thousands of iterations to converge. Powered by large language models (LLMs), STELLAR enables autonomous end-to-end agentic tuning by (1) accurately extracting tunable parameters from software manuals, (2) analyzing I/O trace logs generated by applications, (3) selecting initial tuning strategies, (4) rerunning applications on real systems and collecting I/O performance feedback, (5) adjusting tuning strategies and repeating the tuning cycle, and (6) reflecting on and summarizing tuning experiences into reusable knowledge for future optimizations. STELLAR integrates retrieval-augmented generation (RAG), tool execution, LLM-based reasoning, and a multiagent design to stabilize reasoning and combat hallucinations.\n We evaluate the impact of each component on optimization outcomes, providing design insights for similar systems in other optimization domains. STELLAR's architecture and empirical results highlight a promising approach to complex system optimization, especially for problems with large search spaces and high exploration costs, while making I/O tuning more accessible to domain scientists with minimal added resources."},{"descriptionType":"Other","description":"Published in the Proceedings of the 2025 International Conference for High Performance Computing, Networking, Storage, and Analysis (SC25)"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.23220","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":1,"created":"2026-02-27T03:05:28Z","registered":"2026-02-27T03:05:29Z","published":null,"updated":"2026-02-27T03:05:29Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.23219","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.23219","identifiers":[{"identifier":"2602.23219","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Hiroki","familyName":"Naganuma","name":"Naganuma, Hiroki","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Taiji","familyName":"Suzuki","name":"Suzuki, Taiji","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Rio","familyName":"Yokota","name":"Yokota, Rio","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Masahiro","familyName":"Nomura","name":"Nomura, Masahiro","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Kohta","familyName":"Ishikawa","name":"Ishikawa, Kohta","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ikuro","familyName":"Sato","name":"Sato, Ikuro","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Takeuchi's Information Criteria as Generalization Measures for DNNs Close to NTK Regime"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-26T17:01:14Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:57:44Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Generalization measures have been studied extensively in the machine learning community to better characterize generalization gaps. However, establishing a reliable generalization measure for statistically singular models such as deep neural networks (DNNs) is difficult due to their complex nature. This study focuses on Takeuchi's information criterion (TIC) to investigate the conditions under which this classical measure can effectively explain the generalization gaps of DNNs. Importantly, the developed theory indicates the applicability of TIC near the neural tangent kernel (NTK) regime. In a series of experiments, we trained more than 5,000 DNN models with 12 architectures, including large models (e.g., VGG-16), on four datasets, and estimated the corresponding TIC values to examine the relationship between the generalization gap and the TIC estimates. We applied several TIC approximation methods with feasible computational costs and assessed the accuracy trade-off. Our experimental results indicate that the estimated TIC values correlate well with the generalization gap under conditions close to the NTK regime. However, we show both theoretically and empirically that outside the NTK regime such correlation disappears. Finally, we demonstrate that TIC provides better trial pruning ability than existing methods for hyperparameter optimization."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.23219","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T03:05:26Z","registered":"2026-02-27T03:05:27Z","published":null,"updated":"2026-02-27T03:05:27Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.23193","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.23193","identifiers":[{"identifier":"2602.23193","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Elzo Brito dos Santos","familyName":"Filho","name":"Filho, Elzo Brito dos Santos","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"ESAA: Event Sourcing for Autonomous Agents in LLM-Based Software Engineering"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-26T16:45:59Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:56:43Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Autonomous agents based on Large Language Models (LLMs) have evolved from reactive assistants to systems capable of planning, executing actions via tools, and iterating over environment observations. However, they remain vulnerable to structural limitations: lack of native state, context degradation over long horizons, and the gap between probabilistic generation and deterministic execution requirements. This paper presents the ESAA (Event Sourcing for Autonomous Agents) architecture, which separates the agent's cognitive intention from the project's state mutation, inspired by the Event Sourcing pattern. In ESAA, agents emit only structured intentions in validated JSON (agent.result or issue.report); a deterministic orchestrator validates, persists events in an append-only log (activity.jsonl), applies file-writing effects, and projects a verifiable materialized view (roadmap.json). The proposal incorporates boundary contracts (AGENT_CONTRACT.yaml), metaprompting profiles (PARCER), and replay verification with hashing (esaa verify), ensuring the immutability of completed tasks and forensic traceability. Two case studies validate the architecture: (i) a landing page project (9 tasks, 49 events, single-agent composition) and (ii) a clinical dashboard system (50 tasks, 86 events, 4 concurrent agents across 8 phases), both concluding with run.status=success and verify_status=ok. The multi-agent case study demonstrates real concurrent orchestration with heterogeneous LLMs (Claude Sonnet 4.6, Codex GPT-5, Antigravity/Gemini 3 Pro, and Claude Opus 4.6), providing empirical evidence of the architecture's scalability beyond single-agent scenarios."},{"descriptionType":"Other","description":"13 pages, 1 figure, 4 tables. Includes 5 technical appendices"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.23193","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T03:04:45Z","registered":"2026-02-27T03:04:46Z","published":null,"updated":"2026-02-27T03:04:46Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.23184","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.23184","identifiers":[{"identifier":"2602.23184","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Sara","familyName":"Rosenthal","name":"Rosenthal, Sara","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yannis","familyName":"Katsis","name":"Katsis, Yannis","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Vraj","familyName":"Shah","name":"Shah, Vraj","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Lihong","familyName":"He","name":"He, Lihong","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Lucian","familyName":"Popa","name":"Popa, Lucian","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Marina","familyName":"Danilevsky","name":"Danilevsky, Marina","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"MTRAG-UN: A Benchmark for Open Challenges in Multi-Turn RAG Conversations"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-26T16:41:17Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:56:30Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by-sa/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution Share Alike 4.0 International","rightsIdentifier":"cc-by-sa-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"We present MTRAG-UN, a benchmark for exploring open challenges in multi-turn retrieval augmented generation, a popular use of large language models. We release a benchmark of 666 tasks containing over 2,800 conversation turns across 6 domains with accompanying corpora. Our experiments show that retrieval and generation models continue to struggle on conversations with UNanswerable, UNderspecified, and NONstandalone questions and UNclear responses. Our benchmark is available at https://github.com/IBM/mt-rag-benchmark"},{"descriptionType":"Other","description":"5 pages, 3 figures"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.23184","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T03:04:31Z","registered":"2026-02-27T03:04:32Z","published":null,"updated":"2026-02-27T03:04:32Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.23180","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.23180","identifiers":[{"identifier":"2602.23180","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Marek","familyName":"Tyburec","name":"Tyburec, Marek","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Michael","familyName":"Stingl","name":"Stingl, Michael","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Shenyuan","familyName":"Ma","name":"Ma, Shenyuan","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Hierarchy of bounds in free orthotropic material optimization: From convex relaxations to Hashin-Shtrikman via sequential global programming"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Optimization and Control (math.OC)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"G.1.6; I.6.0; J.2","lang":"en","subjectScheme":"ACM"},{"subject":"74P05, 74P15, 74Q20, 65K10","lang":"en","subjectScheme":"MSC"}],"contributors":[],"dates":[{"date":"2026-02-26T16:39:38Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:56:22Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"We study free orthotropic material optimization for two-dimensional plane-stress compliance minimization with two well-ordered isotropic phases, motivated by the gap between tensors admissible in classical free-material optimization and tensors realizable by composites. To reduce this gap, we construct a hierarchy of realizability-aware admissible sets induced by zeroth-order, Voigt, and Hashin--Shtrikman (HS) energy bounds, moving from convex relaxations to a tighter nonconvex model. In the convex zeroth-order and Voigt settings, the Voigt set is strictly tighter for intermediate volume fractions and coincides with the zeroth-order set at pure-phase endpoints, and the Voigt model reduces to an isotropic variable-thickness-sheet formulation. In the single-loadcase continuum zeroth-order problem, at least one optimal solution can be chosen orthotropic. For HS constraints, we rewrite the bound as a Voigt term minus a nonnegative correction, clarifying strict tightening for interior volume fractions and local nonconvexity. We further prove that the convex hull of the HS feasible set equals the Voigt set and derive reduced formulations via active-constraint analysis and explicit elementwise volume characterization, including reductions specialized to orthotropic effective tensors. In the single-loadcase continuum setting, the HS relaxation is tight with the Allaire--Kohn relaxed problem, attained in the relaxation sense by sequential laminates, whereas in generic multi-loadcase settings it provides a lower bound on optimal compliance over general microstructures. The resulting nonconvex orthotropic HS problem is solved by sequential global programming, and numerical results confirm the predicted compliance hierarchy and show close agreement with finite-rank laminate references."},{"descriptionType":"Other","description":"50 pages, 15 figures"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.23180","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T03:04:25Z","registered":"2026-02-27T03:04:26Z","published":null,"updated":"2026-02-27T03:04:26Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.23174","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.23174","identifiers":[{"identifier":"2602.23174","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Yannick","familyName":"Eich","name":"Eich, Yannick","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Christian","familyName":"Fabian","name":"Fabian, Christian","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Kai","familyName":"Cui","name":"Cui, Kai","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Heinz","familyName":"Koeppl","name":"Koeppl, Heinz","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Approximately Solving Continuous-Time Mean Field Games with Finite State Spaces"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Computer Science and Game Theory (cs.GT)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-26T16:36:12Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:56:04Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Mean field games (MFGs) offer a powerful framework for modeling large-scale multi-agent systems. This paper addresses MFGs formulated in continuous time with discrete state spaces, where agents' dynamics are governed by continuous-time Markov chains -- relevant to applications like population dynamics and queueing networks. While prior research has largely focused on theoretical aspects of continuous-time discrete-state MFGs, efficient computational methods for determining equilibria remain underdeveloped. Inspired by discrete-time approaches, we approximate the classical Nash equilibria by regularization methods, enabling more computationally tractable solution algorithms. Specifically, we define regularized equilibria for continuous-time MFGs and extend the classical fixed-point iteration and fictitious play algorithm to these equilibria. We validate the effectiveness and practicality of our approach via illustrative numerical examples."},{"descriptionType":"Other","description":"To be published in ACC 2026"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.23174","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T03:04:16Z","registered":"2026-02-27T03:04:17Z","published":null,"updated":"2026-02-27T03:04:17Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.23169","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.23169","identifiers":[{"identifier":"2602.23169","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Xiaole","familyName":"Tang","name":"Tang, Xiaole","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xiaoyi","familyName":"He","name":"He, Xiaoyi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jiayi","familyName":"Xu","name":"Xu, Jiayi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xiang","familyName":"Gu","name":"Gu, Xiang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jian","familyName":"Sun","name":"Sun, Jian","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Learning Continuous Wasserstein Barycenter Space for Generalized All-in-One Image Restoration"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-26T16:31:27Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:55:31Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Despite substantial advances in all-in-one image restoration for addressing diverse degradations within a unified model, existing methods remain vulnerable to out-of-distribution degradations, thereby limiting their generalization in real-world scenarios. To tackle the challenge, this work is motivated by the intuition that multisource degraded feature distributions are induced by different degradation-specific shifts from an underlying degradation-agnostic distribution, and recovering such a shared distribution is thus crucial for achieving generalization across degradations. With this insight, we propose BaryIR, a representation learning framework that aligns multisource degraded features in the Wasserstein barycenter (WB) space, which models a degradation-agnostic distribution by minimizing the average of Wasserstein distances to multisource degraded distributions. We further introduce residual subspaces, whose embeddings are mutually contrasted while remaining orthogonal to the WB embeddings. Consequently, BaryIR explicitly decouples two orthogonal spaces: a WB space that encodes the degradation-agnostic invariant contents shared across degradations, and residual subspaces that adaptively preserve the degradation-specific knowledge. This disentanglement mitigates overfitting to in-distribution degradations and enables adaptive restoration grounded on the degradation-agnostic shared invariance. Extensive experiments demonstrate that BaryIR performs competitively against state-of-the-art all-in-one methods. Notably, BaryIR generalizes well to unseen degradations (\\textit{e.g.,} types and levels) and shows remarkable robustness in learning generalized features, even when trained on limited degradation types and evaluated on real-world data with mixed degradations."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.23169","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T03:04:08Z","registered":"2026-02-27T03:04:09Z","published":null,"updated":"2026-02-27T03:04:09Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.23167","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.23167","identifiers":[{"identifier":"2602.23167","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","affiliation":["Shanghai Jiao Tong University"],"givenName":"Shuang","familyName":"Liang","name":"Liang, Shuang","nameIdentifiers":[]},{"nameType":"Personal","affiliation":["Queen's University Belfast"],"givenName":"Yang","familyName":"Hua","name":"Hua, Yang","nameIdentifiers":[]},{"nameType":"Personal","affiliation":["National University of Singapore"],"givenName":"Linshan","familyName":"Jiang","name":"Jiang, Linshan","nameIdentifiers":[]},{"nameType":"Personal","affiliation":["Shanghai Jiao Tong University"],"givenName":"Peishen","familyName":"Yan","name":"Yan, Peishen","nameIdentifiers":[]},{"nameType":"Personal","affiliation":["Shanghai Jiao Tong University"],"givenName":"Tao","familyName":"Song","name":"Song, Tao","nameIdentifiers":[]},{"nameType":"Personal","affiliation":["Shanghai Jiao Tong University"],"givenName":"Bin","familyName":"Yao","name":"Yao, Bin","nameIdentifiers":[]},{"nameType":"Personal","affiliation":["Shanghai Jiao Tong University"],"givenName":"Haibing","familyName":"Guan","name":"Guan, Haibing","nameIdentifiers":[]}],"titles":[{"title":"SettleFL: Trustless and Scalable Reward Settlement Protocol for Federated Learning on Permissionless Blockchains (Extended version)"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Cryptography and Security (cs.CR)","lang":"en","subjectScheme":"arXiv"},{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-26T16:31:23Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:55:29Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"In open Federated Learning (FL) environments where no central authority exists, ensuring collaboration fairness relies on decentralized reward settlement, yet the prohibitive cost of permissionless blockchains directly clashes with the high-frequency, iterative nature of model training. Existing solutions either compromise decentralization or suffer from scalability bottlenecks due to linear on-chain costs. To address this, we present SettleFL, a trustless and scalable reward settlement protocol designed to minimize total economic friction by offering a family of two interoperable protocols. Leveraging a shared domain-specific circuit architecture, SettleFL offers two interoperable strategies: (1) a Commit-and-Challenge variant that minimizes on-chain costs via optimistic execution and dispute-driven arbitration, and (2) a Commit-with-Proof variant that guarantees instant finality through per-round validity proofs. This design allows the protocol to flexibly adapt to varying latency and cost constraints while enforcing rational robustness without trusted coordination. We conduct extensive experiments combining real FL workloads and controlled simulations. Results show that SettleFL remains practical when scaling to 800 participants, achieving substantially lower gas cost."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.23167","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T03:04:05Z","registered":"2026-02-27T03:04:06Z","published":null,"updated":"2026-02-27T03:04:06Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.23157","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.23157","identifiers":[{"identifier":"2602.23157","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Kaijing","familyName":"Lyu","name":"Lyu, Kaijing","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Umberto","familyName":"Biccari","name":"Biccari, Umberto","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jun-Min","familyName":"Wang","name":"Wang, Jun-Min","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Operator learning for prescribed-time stabilization of reaction-diffusion systems"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Optimization and Control (math.OC)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-26T16:17:18Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:55:00Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"This paper addresses boundary prescribed-time stabilization of a one-dimensional heat equation with spatially and temporally varying coefficients. In contrast to asymptotic or exponential stabilization, prescribed-time stabilization ensures convergence to equilibrium within a user-defined time that is independent of the initial condition, a property that is particularly attractive in applications with stringent transient performance requirements. The backstepping design for this problem requires solving, at each time instant, a two-dimensional time-dependent kernel Partial Differential Equation (PDE) whose solution continuously varies with the plant coefficients. The repeated numerical solution of this parabolic kernel PDE results in a prohibitive computational burden, thereby limiting real-time applicability. To overcome this limitation, we propose a neural-operator-based approximation of the mapping from the time-varying system coefficient to the corresponding backstepping kernel. The operator is trained offline using representative solutions of the kernel PDE and subsequently deployed online to generate the required time-varying kernels in real time. We establish, via Lyapunov analysis, that the resulting neural-operator-based controller preserves prescribed-time stability provided that the operator approximation error satisfies an explicit bound. Furthermore, we investigate a direct approximation of the full feedback law mapping the plant parameter functions and state measurements to the boundary control input. For this setting, we prove semiglobal practical prescribed-time stability of the closed-loop system. Numerical experiments demonstrate that the proposed approach reduces the computational cost of kernel generation by several orders of magnitude, thereby enabling real-time prescribed-time stabilization for heat equations with spatially and temporally varying coefficients."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.23157","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T03:03:50Z","registered":"2026-02-27T03:03:51Z","published":null,"updated":"2026-02-27T03:03:51Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.23154","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.23154","identifiers":[{"identifier":"2602.23154","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Pepijn Roos","familyName":"Hoefgeest","name":"Hoefgeest, Pepijn Roos","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Lucas","familyName":"Slot","name":"Slot, Lucas","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Robustness of Persistent Topological Features and Minimum Homological Cuts"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Algebraic Topology (math.AT)","lang":"en","subjectScheme":"arXiv"},{"subject":"Optimization and Control (math.OC)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-26T16:16:02Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:54:57Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Persistent homology is a popular method for computing topological features of (metric) data. Standard approaches based on the Čech or Rips filtration are stable under small perturbations of the data, but highly sensitive to outliers. This lack of robustness has been frequently addressed in the literature. In this paper, we take a novel perspective by asking the following question: When can we guarantee that an observed persistent feature (a bar) is inherent to the underlying data in the presence of a limited number of unknown, arbitrary outliers. We formalize this question by introducing the notion of \\emph{adversarial robustness}, and study the problem of deciding whether a given bar in the barcode of a filtered simplicial complex is adversarially robust. We show that this problem is essentially equivalent to a homological variant of the minimum cut problem in simplicial complexes, which we believe to be of independent interest. As our main technical contribution, we provide the first computational complexity results for this problem, consisting of an efficient algorithm in $0$-dimensional homology, NP-hardness for the general problem, and an efficient algorithm for codimension-$1$ in $n$-dimensional complexes embedded in $\\mathbb{R}^n$. We also analyze its natural linear programming relaxation, whose dual defines a homological analog of the max-flow problem in graphs. We show that a max-flow/min-cut theorem does not hold in our setting, implying that the LP relaxation is not tight in general. Finally, in the special case of the Rips filtration, we provide a global heuristic based on the Hausdorff distance that guarantees adversarial robustness of sufficiently long bars. This connects adversarial robustness to standard stability theorems in persistent homology."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.23154","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T03:03:46Z","registered":"2026-02-27T03:03:46Z","published":null,"updated":"2026-02-27T03:03:46Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.23152","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.23152","identifiers":[{"identifier":"2602.23152","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Jingxuan","familyName":"Wei","name":"Wei, Jingxuan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Siyuan","familyName":"Li","name":"Li, Siyuan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yuhang","familyName":"Xu","name":"Xu, Yuhang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zheng","familyName":"Sun","name":"Sun, Zheng","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Junjie","familyName":"Jiang","name":"Jiang, Junjie","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Hexuan","familyName":"Jin","name":"Jin, Hexuan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Caijun","familyName":"Jia","name":"Jia, Caijun","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Honghao","familyName":"He","name":"He, Honghao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xinglong","familyName":"Xu","name":"Xu, Xinglong","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xi","familyName":"bai","name":"bai, Xi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Chang","familyName":"Yu","name":"Yu, Chang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yumou","familyName":"Liu","name":"Liu, Yumou","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Junnan","familyName":"Zhu","name":"Zhu, Junnan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xuanhe","familyName":"Zhou","name":"Zhou, Xuanhe","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jintao","familyName":"Chen","name":"Chen, Jintao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xiaobin","familyName":"Hu","name":"Hu, Xiaobin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Shancheng","familyName":"Pang","name":"Pang, Shancheng","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Bihui","familyName":"Yu","name":"Yu, Bihui","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ran","familyName":"He","name":"He, Ran","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zhen","familyName":"Lei","name":"Lei, Zhen","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Stan Z.","familyName":"Li","name":"Li, Stan Z.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Conghui","familyName":"He","name":"He, Conghui","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Shuicheng","familyName":"Yan","name":"Yan, Shuicheng","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Cheng","familyName":"Tan","name":"Tan, Cheng","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"The Trinity of Consistency as a Defining Principle for General World Models"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-26T16:15:55Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:54:52Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"The construction of World Models capable of learning, simulating, and reasoning about objective physical laws constitutes a foundational challenge in the pursuit of Artificial General Intelligence. Recent advancements represented by video generation models like Sora have demonstrated the potential of data-driven scaling laws to approximate physical dynamics, while the emerging Unified Multimodal Model (UMM) offers a promising architectural paradigm for integrating perception, language, and reasoning. Despite these advances, the field still lacks a principled theoretical framework that defines the essential properties requisite for a General World Model. In this paper, we propose that a World Model must be grounded in the Trinity of Consistency: Modal Consistency as the semantic interface, Spatial Consistency as the geometric basis, and Temporal Consistency as the causal engine. Through this tripartite lens, we systematically review the evolution of multimodal learning, revealing a trajectory from loosely coupled specialized modules toward unified architectures that enable the synergistic emergence of internal world simulators. To complement this conceptual framework, we introduce CoW-Bench, a benchmark centered on multi-frame reasoning and generation scenarios. CoW-Bench evaluates both video generation models and UMMs under a unified evaluation protocol. Our work establishes a principled pathway toward general world models, clarifying both the limitations of current systems and the architectural requirements for future progress."},{"descriptionType":"Other","description":"119 pages, 50 figures"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.23152","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T03:03:42Z","registered":"2026-02-27T03:03:43Z","published":null,"updated":"2026-02-27T03:03:43Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.23145","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.23145","identifiers":[{"identifier":"2602.23145","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Juan Guillermo","familyName":"Garrido","name":"Garrido, Juan Guillermo","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Pedro","familyName":"Pérez-Aros","name":"Pérez-Aros, Pedro","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Mathias","familyName":"Staudigl","name":"Staudigl, Mathias","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Stochastic Differential Inclusions driven by Maximal Monotone Operators with empty interiors"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Optimization and Control (math.OC)","lang":"en","subjectScheme":"arXiv"},{"subject":"Dynamical Systems (math.DS)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-26T16:11:41Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:54:36Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"This paper studies the long-time behavior of stochastic differential inclusions driven by maximal monotone operators, motivated by continuous-time models of first-order optimization methods under noisy or approximate operator information. We first address well-posedness and show that existence and uniqueness can be established without the customary requirement that the operator's domain has nonempty interior, by adopting an appropriate notion of solution. We then analyze asymptotic properties of the resulting stochastic dynamics, extending convergence guarantees beyond previously studied settings that rely on smooth potentials, full-domain subdifferentials, or Lipschitz monotone operators. In addition, we consider a Tikhonov-type regularization of the stochastic inclusion and prove corresponding well-posedness and long-time convergence results."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.23145","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T03:03:32Z","registered":"2026-02-27T03:03:33Z","published":null,"updated":"2026-02-27T03:03:33Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.23137","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.23137","identifiers":[{"identifier":"2602.23137","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Raluca M.","familyName":"Balan","name":"Balan, Raluca M.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"William D.","familyName":"Stephenson","name":"Stephenson, William D.","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Gaussian fluctuations for hyperbolic Anderson model with Lévy colored noise"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Probability (math.PR)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-26T15:57:56Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:54:01Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"In this article, we study the asymptotic behaviour of the spatial integral $F_R(t)$ of the solution to the hyperbolic Anderson model in dimension $d=1$, driven by the Lévy colored noise introduced in Balan and Jiménez (2026). We assume that the spatial coloration kernel of the noise is either integrable on $\\mathbb{R}$, or is the Riesz kernel of order $α\\in (0,1)$, and the Lévy measure of the noise has finite moments of order $p$ and $2p$ for some $p \\in (1,2]$. By applying a recent result of Trauthwein (2025), we prove that $F_R(t)/\\sqrt{{\\rm Var}\\big(F_R(t)\\big)}$ converges to the standard normal distribution as $R \\to \\infty$, and we give an estimate for the rate of this convergence in the Fortet-Mourier distance, the 1-Wasserstein distance, or the Kolmogorov distance. We also provide the corresponding functional limit result."},{"descriptionType":"Other","description":"45 pages"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.23137","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T03:03:20Z","registered":"2026-02-27T03:03:20Z","published":null,"updated":"2026-02-27T03:03:20Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.23132","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.23132","identifiers":[{"identifier":"2602.23132","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Ruochen","familyName":"Yang","name":"Yang, Ruochen","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xiaodong","familyName":"Li","name":"Li, Xiaodong","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jiawei","familyName":"Sheng","name":"Sheng, Jiawei","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jiangxia","familyName":"Cao","name":"Cao, Jiangxia","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xinkui","familyName":"Lin","name":"Lin, Xinkui","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Shen","familyName":"Wang","name":"Wang, Shen","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Shuang","familyName":"Yang","name":"Yang, Shuang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zhaojie","familyName":"Liu","name":"Liu, Zhaojie","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Tingwen","familyName":"Liu","name":"Liu, Tingwen","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"From Agnostic to Specific: Latent Preference Diffusion for Multi-Behavior Sequential Recommendation"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Information Retrieval (cs.IR)","lang":"en","subjectScheme":"arXiv"},{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-26T15:48:09Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:53:49Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Multi-behavior sequential recommendation (MBSR) aims to learn the dynamic and heterogeneous interactions of users' multi-behavior sequences, so as to capture user preferences under target behavior for the next interacted item prediction. Unlike previous methods that adopt unidirectional modeling by mapping auxiliary behaviors to target behavior, recent concerns are shifting from behavior-fixed to behavior-specific recommendation. However, these methods still ignore the user's latent preference that underlying decision-making, leading to suboptimal solutions. Meanwhile, due to the asymmetric deterministic between items and behaviors, discriminative paradigm based on preference scoring is unsuitable to capture the uncertainty from low-entropy behaviors to high-entropy items, failing to provide efficient and diverse recommendation. To address these challenges, we propose \\textbf{FatsMB}, a framework based diffusion model that guides preference generation \\textit{\\textbf{F}rom Behavior-\\textbf{A}gnostic \\textbf{T}o Behavior-\\textbf{S}pecific} in latent spaces, enabling diverse and accurate \\textit{\\textbf{M}ulti-\\textbf{B}ehavior Sequential Recommendation}. Specifically, we design a Multi-Behavior AutoEncoder (MBAE) to construct a unified user latent preference space, facilitating interaction and collaboration across Behaviors, within Behavior-aware RoPE (BaRoPE) employed for multiple information fusion. Subsequently, we conduct target behavior-specific preference transfer in the latent space, enriching with informative priors. A Multi-Condition Guided Layer Normalization (MCGLN) is introduced for the denoising. Extensive experiments on real-world datasets demonstrate the effectiveness of our model."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.23132","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T03:03:12Z","registered":"2026-02-27T03:03:12Z","published":null,"updated":"2026-02-27T03:03:12Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.23123","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.23123","identifiers":[{"identifier":"2602.23123","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Keito","familyName":"Inoshita","name":"Inoshita, Keito","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Multi-Agent Large Language Model Based Emotional Detoxification Through Personalized Intensity Control for Consumer Protection"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-26T15:37:03Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:53:30Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"In the attention economy, sensational content exposes consumers to excessive emotional stimulation, hindering calm decision-making. This study proposes Multi-Agent LLM-based Emotional deToxification (MALLET), a multi-agent information sanitization system consisting of four agents: Emotion Analysis, Emotion Adjustment, Balance Monitoring, and Personal Guide. The Emotion Analysis Agent quantifies stimulus intensity using a 6-emotion BERT classifier, and the Emotion Adjustment Agent rewrites texts into two presentation modes, BALANCED (neutralized text) and COOL (neutralized text + supplementary text), using an LLM. The Balance Monitoring Agent aggregates weekly information consumption patterns and generates personalized advice, while the Personal Guide Agent recommends a presentation mode according to consumer sensitivity. Experiments on 800 AG News articles demonstrated significant stimulus score reduction (up to 19.3%) and improved emotion balance while maintaining semantic preservation. Near-zero correlation between stimulus reduction and semantic preservation confirmed that the two are independently controllable. Category-level analysis revealed substantial reduction (17.8-33.8%) in Sports, Business, and Sci/Tech, whereas the effect was limited in the World category, where facts themselves are inherently high-stimulus. The proposed system provides a framework for supporting calm information reception of consumers without restricting access to the original text."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.23123","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T03:02:57Z","registered":"2026-02-27T03:02:57Z","published":null,"updated":"2026-02-27T03:02:57Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.23121","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.23121","identifiers":[{"identifier":"2602.23121","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"C.","familyName":"Seas","name":"Seas, C.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"G.","familyName":"Fitzpatrick","name":"Fitzpatrick, G.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"J. A.","familyName":"Hamilton","name":"Hamilton, J. A.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"M. C.","familyName":"Carlisle","name":"Carlisle, M. C.","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Automated Vulnerability Detection in Source Code Using Deep Representation Learning"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Cryptography and Security (cs.CR)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-26T15:35:17Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:53:27Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[{"relationType":"IsVersionOf","relatedIdentifier":"10.1109/ccwc60891.2024.10427574","relatedIdentifierType":"DOI"}],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Each year, software vulnerabilities are discovered, which pose significant risks of exploitation and system compromise. We present a convolutional neural network model that can successfully identify bugs in C code. We trained our model using two complementary datasets: a machine-labeled dataset created by Draper Labs using three static analyzers and the NIST SATE Juliet human-labeled dataset designed for testing static analyzers. In contrast with the work of Russell et al. on these datasets, we focus on C programs, enabling us to specialize and optimize our detection techniques for this language. After removing duplicates from the dataset, we tokenize the input into 91 token categories. The category values are converted to a binary vector to save memory. Our first convolution layer is chosen so that the entire encoding of the token is presented to the filter. We use two convolution and pooling layers followed by two fully connected layers to classify programs into either a common weakness enumeration category or as ``clean.'' We obtain higher recall than prior work by Russell et al. on this dataset when requiring high precision. We also demonstrate on a custom Linux kernel dataset that we are able to find real vulnerabilities in complex code with a low false-positive rate."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.23121","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":1,"created":"2026-02-27T03:02:54Z","registered":"2026-02-27T03:02:55Z","published":null,"updated":"2026-02-27T03:02:55Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.23115","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.23115","identifiers":[{"identifier":"2602.23115","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"David","familyName":"Dirnfeld","name":"Dirnfeld, David","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Fabien","familyName":"Delattre","name":"Delattre, Fabien","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Pedro","familyName":"Miraldo","name":"Miraldo, Pedro","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Erik","familyName":"Learned-Miller","name":"Learned-Miller, Erik","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"FLIGHT: Fibonacci Lattice-based Inference for Geometric Heading in real-Time"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"Computational Geometry (cs.CG)","lang":"en","subjectScheme":"arXiv"},{"subject":"Robotics (cs.RO)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-26T15:27:49Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:52:57Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Estimating camera motion from monocular video is a fundamental problem in computer vision, central to tasks such as SLAM, visual odometry, and structure-from-motion. Existing methods that recover the camera's heading under known rotation, whether from an IMU or an optimization algorithm, tend to perform well in low-noise, low-outlier conditions, but often decrease in accuracy or become computationally expensive as noise and outlier levels increase. To address these limitations, we propose a novel generalization of the Hough transform on the unit sphere (S(2)) to estimate the camera's heading. First, the method extracts correspondences between two frames and generates a great circle of directions compatible with each pair of correspondences. Then, by discretizing the unit sphere using a Fibonacci lattice as bin centers, each great circle casts votes for a range of directions, ensuring that features unaffected by noise or dynamic objects vote consistently for the correct motion direction. Experimental results on three datasets demonstrate that the proposed method is on the Pareto frontier of accuracy versus efficiency. Additionally, experiments on SLAM show that the proposed method reduces RMSE by correcting the heading during camera pose initialization."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.23115","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T03:02:45Z","registered":"2026-02-27T03:02:46Z","published":null,"updated":"2026-02-27T03:02:46Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.23111","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.23111","identifiers":[{"identifier":"2602.23111","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Yanyi","familyName":"Li","name":"Li, Yanyi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yimu","familyName":"Zhang","name":"Zhang, Yimu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Cong","familyName":"Fang","name":"Fang, Cong","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"PRAC: Principal-Random Subspace for LLM Activation Compression and Memory-Efficient Training"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-26T15:23:34Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:52:41Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Activations have become the primary memory bottleneck in large-batch LLM training. However, existing compression methods fail to exploit the spectral structure of activations, resulting in slow convergence or limited compression. To address this, we bridge the relationship between the algorithm's fast convergence and the requirements for subspace projection, and show that an effective compression should yield an unbiased estimate of the original activation with low variance. We propose Principal-Random Subspace for LLM Activation Compression (PRAC), which novelly decomposes activations into two components: a principal subspace captured via SVD to retain dominant information, and a random subspace sampled from the orthogonal complement to approximate the tail. By introducing a precise scaling factor, we prove that PRAC yields an unbiased gradient estimator with minimum variance under certain conditions. Extensive experiments on pre-training and fine-tuning tasks demonstrate that PRAC achieves up to 36% total memory reduction with negligible performance degradation and minimal computational cost."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.23111","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T03:02:40Z","registered":"2026-02-27T03:02:41Z","published":null,"updated":"2026-02-27T03:02:41Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.23106","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.23106","identifiers":[{"identifier":"2602.23106","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Bao T.","familyName":"Ma","name":"Ma, Bao T.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"David S.","familyName":"Simmons","name":"Simmons, David S.","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Depth-dependent interplay of dynamical heterogeneity and chain dynamics at the surface of glass-forming polymers"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Soft Condensed Matter (cond-mat.soft)","lang":"en","subjectScheme":"arXiv"},{"subject":"Materials Science (cond-mat.mtrl-sci)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-26T15:20:49Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:52:25Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by-nc-nd/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution Non Commercial No Derivatives 4.0 International","rightsIdentifier":"cc-by-nc-nd-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Polymer thin films exhibit pronounced interfacial mobility gradients that modify chain relaxation, yet how these gradients govern chain-scale dynamics across depth remains incompletely understood. Using molecular dynamics simulations of freestanding glass-forming polymer films, we resolve how depth-dependent variations in segmental relaxation shape chain dynamics across a wide range of displacement scales. Near the free surface, accelerated segmental mobility suppresses Rouse-regime scaling exponents to values as low as gamma = 0.4, reflecting transient localization induced by interfacial mobility gradients rather than topological entanglement. In contrast, the film interior exhibits enhanced Rouse scaling exponents consistent with predictions of the Heterogeneous Rouse Model (HRM), indicating that bulk dynamic heterogeneity compresses the Rouse regime. Mapping the minimum scaling exponent gamma_min across depth reveals a linear gradient that separates the bulk-like enhancement regime from the surface-induced suppression regime of chain dynamical scaling. Together, these results demonstrate that bulk and interfacial dynamic heterogeneity modify chain relaxation in opposite ways and establish Rouse scaling as a sensitive, spatially resolved probe of glassy dynamical heterogeneity and interfacial dynamical gradients in polymers."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.23106","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T03:02:34Z","registered":"2026-02-27T03:02:34Z","published":null,"updated":"2026-02-27T03:02:34Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.23105","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.23105","identifiers":[{"identifier":"2602.23105","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Yusheng","familyName":"Huang","name":"Huang, Yusheng","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Pengbo","familyName":"Xu","name":"Xu, Pengbo","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Shen","familyName":"Wang","name":"Wang, Shen","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Changxin","familyName":"Lao","name":"Lao, Changxin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jiangxia","familyName":"Cao","name":"Cao, Jiangxia","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Shuang","familyName":"Wen","name":"Wen, Shuang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Shuang","familyName":"Yang","name":"Yang, Shuang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zhaojie","familyName":"Liu","name":"Liu, Zhaojie","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Han","familyName":"Li","name":"Li, Han","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Kun","familyName":"Gai","name":"Gai, Kun","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"MaRI: Accelerating Ranking Model Inference via Structural Re-parameterization in Large Scale Recommendation System"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Information Retrieval (cs.IR)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-26T15:19:43Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:52:21Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Ranking models, i.e., coarse-ranking and fine-ranking models, serve as core components in large-scale recommendation systems, responsible for scoring massive item candidates based on user preferences. To meet the stringent latency requirements of online serving, structural lightweighting or knowledge distillation techniques are commonly employed for ranking model acceleration. However, these approaches typically lead to a non-negligible drop in accuracy. Notably, the angle of lossless acceleration by optimizing feature fusion matrix multiplication, particularly through structural reparameterization, remains underexplored. In this paper, we propose MaRI, a novel Matrix Re-parameterized Inference framework, which serves as a complementary approach to existing techniques while accelerating ranking model inference without any accuracy loss. MaRI is motivated by the observation that user-side computation is redundant in feature fusion matrix multiplication, and we therefore adopt the philosophy of structural reparameterization to alleviate such redundancy."},{"descriptionType":"Other","description":"Work in progress"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.23105","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T03:02:32Z","registered":"2026-02-27T03:02:33Z","published":null,"updated":"2026-02-27T03:02:33Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.23087","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.23087","identifiers":[{"identifier":"2602.23087","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Marc","familyName":"Wildi","name":"Wildi, Marc","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Forecasting on the Accuracy-Timeliness Frontier: Two Novel `Look Ahead' Predictors"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Econometrics (econ.EM)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Economics and business","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Economics and business","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-26T15:10:39Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:51:29Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"We re-examine the traditional Mean-Squared Error (MSE) forecasting paradigm by formally integrating an accuracy-timeliness trade-off: accuracy is defined by MSE (or target correlation) and timeliness by advancement (or phase excess). While MSE-optimized predictors are accurate in tracking levels, they sacrifice dynamic lead, causing them to lag behind changing targets. To address this, we introduce two `look-ahead' frameworks--Decoupling-from-Present (DFP) and Peak-Correlation-Shifting (PCS)--and provide closed-form solutions for their optimization. Notably, the classical MSE predictor is shown to be a special case within these frameworks. Dually, our methods achieve maximum advancement for any given accuracy level, so our approach reveals the complete efficient frontier of the accuracy-timeliness trade-off, whereas MSE represents only a single point. We also derive a universal upper bound on lead over MSE for any linear predictor under a consistency constraint and prove that our methods hit this ceiling. We validate this approach through applications in forecasting and real-time signal extraction, introducing a leading-indicator criterion and tailored linear benchmarks."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.23087","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T03:02:07Z","registered":"2026-02-27T03:02:08Z","published":null,"updated":"2026-02-27T03:02:08Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.23079","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.23079","identifiers":[{"identifier":"2602.23079","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Boyang","familyName":"Zhang","name":"Zhang, Boyang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yang","familyName":"Zhang","name":"Zhang, Yang","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Assessing Deanonymization Risks with Stylometry-Assisted LLM Agent"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"Cryptography and Security (cs.CR)","lang":"en","subjectScheme":"arXiv"},{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-26T15:05:13Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:51:14Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"The rapid advancement of large language models (LLMs) has enabled powerful authorship inference capabilities, raising growing concerns about unintended deanonymization risks in textual data such as news articles. In this work, we introduce an LLM agent designed to evaluate and mitigate such risks through a structured, interpretable pipeline. Central to our framework is the proposed $\\textit{SALA}$ (Stylometry-Assisted LLM Analysis) method, which integrates quantitative stylometric features with LLM reasoning for robust and transparent authorship attribution. Experiments on large-scale news datasets demonstrate that $\\textit{SALA}$, particularly when augmented with a database module, achieves high inference accuracy in various scenarios. Finally, we propose a guided recomposition strategy that leverages the agent's reasoning trace to generate rewriting prompts, effectively reducing authorship identifiability while preserving textual meaning. Our findings highlight both the deanonymization potential of LLM agents and the importance of interpretable, proactive defenses for safeguarding author privacy."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.23079","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T03:01:56Z","registered":"2026-02-27T03:01:56Z","published":null,"updated":"2026-02-27T03:01:56Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.23076","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.23076","identifiers":[{"identifier":"2602.23076","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Anthony","familyName":"Palmieri","name":"Palmieri, Anthony","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Francesco","familyName":"Rinaldi","name":"Rinaldi, Francesco","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Saverio","familyName":"Salzo","name":"Salzo, Saverio","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Sara","familyName":"Venturini","name":"Venturini, Sara","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Iteration Complexity of Frank-Wolfe and Its Variants for Bilevel Optimization"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Optimization and Control (math.OC)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"90C30","lang":"en","subjectScheme":"MSC"}],"contributors":[],"dates":[{"date":"2026-02-26T15:04:43Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:51:03Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"We study Frank-Wolfe (FW) methods for constrained bilevel optimization when the lower-level problem is solved only approximately, yielding biased and inexact hypergradients. We analyze inexact variants of vanilla FW as well as away-step and pairwise FW, and provide convergence rates in the nonconvex setting under gradient errors. By combining these results with recent bounds on hypergradient errors from iterative and approximate implicit differentiation, we derive overall iteration complexity guarantees for bilevel FW. Experiments on two real-world applications validate the theory and demonstrate practical effectiveness."},{"descriptionType":"Other","description":"23 pages, 2 figures"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.23076","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T03:01:52Z","registered":"2026-02-27T03:01:52Z","published":null,"updated":"2026-02-27T03:01:52Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.23075","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.23075","identifiers":[{"identifier":"2602.23075","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Mengze","familyName":"Hong","name":"Hong, Mengze","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Di","familyName":"Jiang","name":"Jiang, Di","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Chen Jason","familyName":"Zhang","name":"Zhang, Chen Jason","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zichang","familyName":"Guo","name":"Guo, Zichang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yawen","familyName":"Li","name":"Li, Yawen","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jun","familyName":"Chen","name":"Chen, Jun","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Shaobo","familyName":"Cui","name":"Cui, Shaobo","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zhiyang","familyName":"Su","name":"Su, Zhiyang","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"CiteLLM: An Agentic Platform for Trustworthy Scientific Reference Discovery"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"Information Retrieval (cs.IR)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-26T15:02:22Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:50:44Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Large language models (LLMs) have created new opportunities to enhance the efficiency of scholarly activities; however, challenges persist in the ethical deployment of AI assistance, including (1) the trustworthiness of AI-generated content, (2) preservation of academic integrity and intellectual property, and (3) protection of information privacy. In this work, we present CiteLLM, a specialized agentic platform designed to enable trustworthy reference discovery for grounding author-drafted claims and statements. The system introduces a novel interaction paradigm by embedding LLM utilities directly within the LaTeX editor environment, ensuring a seamless user experience and no data transmission outside the local system. To guarantee hallucination-free references, we employ dynamic discipline-aware routing to retrieve candidates exclusively from trusted web-based academic repositories, while leveraging LLMs solely for generating context-aware search queries, ranking candidates by relevance, and validating and explaining support through paragraph-level semantic matching and an integrated chatbot. Evaluation results demonstrate the superior performance of the proposed system in returning valid and highly usable references."},{"descriptionType":"Other","description":"Accepted by TheWebConf 2026 Demo Track"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.23075","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T03:01:50Z","registered":"2026-02-27T03:01:51Z","published":null,"updated":"2026-02-27T03:01:51Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.23073","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.23073","identifiers":[{"identifier":"2602.23073","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Yaacov","familyName":"Pariente","name":"Pariente, Yaacov","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Vadim","familyName":"Indelman","name":"Indelman, Vadim","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Accelerated Online Risk-Averse Policy Evaluation in POMDPs with Theoretical Guarantees and Novel CVaR Bounds"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Statistics Theory (math.ST)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-26T15:01:40Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:50:36Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Risk-averse decision-making under uncertainty in partially observable domains is a central challenge in artificial intelligence and is essential for developing reliable autonomous agents. The formal framework for such problems is the partially observable Markov decision process (POMDP), where risk sensitivity is introduced through a risk measure applied to the value function, with Conditional Value-at-Risk (CVaR) being a particularly significant criterion. However, solving POMDPs is computationally intractable in general, and approximate methods rely on computationally expensive simulations of future agent trajectories. This work introduces a theoretical framework for accelerating CVaR value function evaluation in POMDPs with formal performance guarantees. We derive new bounds on the CVaR of a random variable X using an auxiliary random variable Y, under assumptions relating their cumulative distribution and density functions; these bounds yield interpretable concentration inequalities and converge as the distributional discrepancy vanishes. Building on this, we establish upper and lower bounds on the CVaR value function computable from a simplified belief-MDP, accommodating general simplifications of the transition dynamics. We develop estimators for these bounds within a particle-belief MDP framework with probabilistic guarantees, and employ them for acceleration via action elimination: actions whose bounds indicate suboptimality under the simplified model are safely discarded while ensuring consistency with the original POMDP. Empirical evaluation across multiple POMDP domains confirms that the bounds reliably separate safe from dangerous policies while achieving substantial computational speedups under the simplified model."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.23073","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T03:01:47Z","registered":"2026-02-27T03:01:48Z","published":null,"updated":"2026-02-27T03:01:48Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.23070","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.23070","identifiers":[{"identifier":"2602.23070","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Sanjid","familyName":"Hasan","name":"Hasan, Sanjid","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Risalat","familyName":"Labib","name":"Labib, Risalat","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"A H M","familyName":"Fuad","name":"Fuad, A H M","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Bayazid","familyName":"Hasan","name":"Hasan, Bayazid","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Make It Hard to Hear, Easy to Learn: Long-Form Bengali ASR and Speaker Diarization via Extreme Augmentation and Perfect Alignment"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Sound (cs.SD)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"Audio and Speech Processing (eess.AS)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"FOS: Electrical engineering, electronic engineering, information engineering","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Electrical engineering, electronic engineering, information engineering","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-26T14:59:24Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:50:32Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Although Automatic Speech Recognition (ASR) in Bengali has seen significant progress, processing long-duration audio and performing robust speaker diarization remain critical research gaps. To address the severe scarcity of joint ASR and diarization resources for this language, we introduce Lipi-Ghor-882, a comprehensive 882-hour multi-speaker Bengali dataset. In this paper, detailing our submission to the DL Sprint 4.0 competition, we systematically evaluate various architectures and approaches for long-form Bengali speech. For ASR, we demonstrate that raw data scaling is ineffective; instead, targeted fine-tuning utilizing perfectly aligned annotations paired with synthetic acoustic degradation (noise and reverberation) emerges as the singular most effective approach. Conversely, for speaker diarization, we observed that global open-source state-of-the-art models (such as Diarizen) performed surprisingly poorly on this complex dataset. Extensive model retraining yielded negligible improvements; instead, strategic, heuristic post-processing of baseline model outputs proved to be the primary driver for increasing accuracy. Ultimately, this work outlines a highly optimized dual pipeline achieving a $\\sim$0.019 Real-Time Factor (RTF), establishing a practical, empirically backed benchmark for low-resource, long-form speech processing."},{"descriptionType":"Other","description":"4 pages, 2 figures"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.23070","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T03:01:43Z","registered":"2026-02-27T03:01:44Z","published":null,"updated":"2026-02-27T03:01:44Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.23066","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.23066","identifiers":[{"identifier":"2602.23066","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Zach","familyName":"Walsh","name":"Walsh, Zach","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Matroids from gain graphs over quotient groups"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Combinatorics (math.CO)","lang":"en","subjectScheme":"arXiv"},{"subject":"Group Theory (math.GR)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"05B35, 20B05","lang":"en","subjectScheme":"MSC"}],"contributors":[],"dates":[{"date":"2026-02-26T14:54:19Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:50:16Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"We present a new construction for matroids from gain graphs that simultaneously generalizes several existing constructions. The construction takes as input a gain graph over a Frobenius group $Γ$ with Frobenius kernel $Γ_1$ and outputs an elementary lift of the frame matroid of the underlying gain graph over the quotient group $Γ/Γ_1$.\n While the hypothesis that $Γ$ is a Frobenius group may seem unusual, we prove that it is in some sense necessary: if $Γ$ is any finite group with a nontrivial proper normal subgroup $Γ_1$ and there is a construction that takes in a complete $Γ$-gain graph and outputs an elementary lift $M$ of the frame matroid of the underlying $(Γ/Γ_1)$-gain graph so that a cycle of the graph is a circuit of $M$ if and only if it is $Γ$-balanced, then $Γ$ is a Frobenius group with Frobenius kernel $Γ_1$."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.23066","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T03:01:38Z","registered":"2026-02-27T03:01:38Z","published":null,"updated":"2026-02-27T03:01:38Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.23060","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.23060","identifiers":[{"identifier":"2602.23060","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Xin","familyName":"Wang","name":"Wang, Xin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Burcu","familyName":"Ozek","name":"Ozek, Burcu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Aruna","familyName":"Mohan","name":"Mohan, Aruna","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Amirhossein","familyName":"Ravari","name":"Ravari, Amirhossein","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Or","familyName":"Zilbershot","name":"Zilbershot, Or","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Fatemeh","familyName":"Afghah","name":"Afghah, Fatemeh","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"RhythmBERT: A Self-Supervised Language Model Based on Latent Representations of ECG Waveforms for Heart Disease Detection"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-26T14:45:29Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:49:41Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Electrocardiogram (ECG) analysis is crucial for diagnosing heart disease, but most self-supervised learning methods treat ECG as a generic time series, overlooking physiologic semantics and rhythm-level structure. Existing contrastive methods utilize augmentations that distort morphology, whereas generative approaches employ fixed-window segmentation, which misaligns cardiac cycles. To address these limitations, we propose RhythmBERT, a generative ECG language model that considers ECG as a language paradigm by encoding P, QRS, and T segments into symbolic tokens via autoencoder-based latent representations. These discrete tokens capture rhythm semantics, while complementary continuous embeddings retain fine-grained morphology, enabling a unified view of waveform structure and rhythm. RhythmBERT is pretrained on approximately 800,000 unlabeled ECG recordings with a masked prediction objective, allowing it to learn contextual representations in a label-efficient manner. Evaluations show that despite using only a single lead, RhythmBERT achieves comparable or superior performance to strong 12-lead baselines. This generalization extends from prevalent conditions such as atrial fibrillation to clinically challenging cases such as subtle ST-T abnormalities and myocardial infarction. Our results suggest that considering ECG as structured language offers a scalable and physiologically aligned pathway for advancing cardiac analysis."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.23060","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T03:01:29Z","registered":"2026-02-27T03:01:30Z","published":null,"updated":"2026-02-27T03:01:30Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.23057","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.23057","identifiers":[{"identifier":"2602.23057","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Jeongin","familyName":"Bae","name":"Bae, Jeongin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Baeseong","familyName":"Park","name":"Park, Baeseong","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Gunho","familyName":"Park","name":"Park, Gunho","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Minsub","familyName":"Kim","name":"Kim, Minsub","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Joonhyung","familyName":"Lee","name":"Lee, Joonhyung","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Junhee","familyName":"Yoo","name":"Yoo, Junhee","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Sunghyeon","familyName":"Woo","name":"Woo, Sunghyeon","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jiwon","familyName":"Ryu","name":"Ryu, Jiwon","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Se Jung","familyName":"Kwon","name":"Kwon, Se Jung","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Dongsoo","familyName":"Lee","name":"Lee, Dongsoo","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Affine-Scaled Attention: Towards Flexible and Stable Transformer Attention"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-26T14:42:16Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:49:32Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Transformer attention is typically implemented using softmax normalization, which enforces attention weights with unit sum normalization. While effective in many settings, this constraint can limit flexibility in controlling attention magnitudes and may contribute to overly concentrated or unstable attention patterns during training. Prior work has explored modifications such as attention sinks or gating mechanisms, but these approaches provide only limited or indirect control over attention reweighting. We propose Affine-Scaled Attention, a simple extension to standard attention that introduces input-dependent scaling and a corresponding bias term applied to softmax-normalized attention weights. This design relaxes the strict normalization constraint while maintaining aggregation of value representations, allowing the model to adjust both the relative distribution and the scale of attention in a controlled manner.\n We empirically evaluate Affine-Scaled Attention in large-scale language model pretraining across multiple model sizes. Experimental results show consistent improvements in training stability, optimization behavior, and downstream task performance compared to standard softmax attention and attention sink baselines. These findings suggest that modest reweighting of attention outputs provides a practical and effective way to improve attention behavior in Transformer models."},{"descriptionType":"Other","description":"Preprint. 14 pages, 11 figures"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.23057","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T03:01:25Z","registered":"2026-02-27T03:01:26Z","published":null,"updated":"2026-02-27T03:01:26Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.23049","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.23049","identifiers":[{"identifier":"2602.23049","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Lorenzo","familyName":"Facciaroni","name":"Facciaroni, Lorenzo","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Costantino","familyName":"Ricciuti","name":"Ricciuti, Costantino","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Enrico","familyName":"Scalas","name":"Scalas, Enrico","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Non-Markovian chains with long-range dependence and their scaling limits"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Probability (math.PR)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-26T14:35:31Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:49:10Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"There is a well-established theory linking certain semi-Markov chains and continuous-time random walks to time-fractional equations and anomalous diffusion. In this work, we go beyond the semi-Markov framework by considering some non-Markovian chains, which exhibit long-memory behaviour, due to stochastic dependence among their waiting times. Particular attention is devoted to the so-called para-Markov chains. Their waiting times share the same marginal distributions as those of the above mentioned semi-Markov chains, but they are dependent; their joint distribution is of Schur-constant type and is closely related to complete Bernstein functions and De Finetti's theorems. A second model that we focus on is given by time-changed Markov chains, where the random time is the inverse of an increasing stable process. This generalizes well-known semi-Markov models available in the literature, which typically focus solely on the inverse of the Levy stable subordinator. The above mentioned models are unified by a general theory of time change of Markov chains."},{"descriptionType":"Other","description":"1 Figure"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.23049","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T03:01:14Z","registered":"2026-02-27T03:01:14Z","published":null,"updated":"2026-02-27T03:01:14Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.23027","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.23027","identifiers":[{"identifier":"2602.23027","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Javier","familyName":"Cembrano","name":"Cembrano, Javier","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Rupert","familyName":"Freeman","name":"Freeman, Rupert","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ulrike","familyName":"Schmidt-Kraepelin","name":"Schmidt-Kraepelin, Ulrike","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Markus","familyName":"Utke","name":"Utke, Markus","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Social Welfare in Budget Aggregation"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Computer Science and Game Theory (cs.GT)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-26T14:07:21Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:47:45Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"We study budget aggregation under $\\ell_1$-utilities, a model for collective decision making in which agents with heterogeneous preferences must allocate a public budget across a set of alternatives. Each agent reports their preferred allocation, and a mechanism selects an allocation. Early work focused on social welfare maximization, which in this setting admits truthful mechanisms, but may underrepresent minority groups, motivating the study of proportional mechanisms. However, the dominant proportionality notion, single-minded proportionality, is weak, as it only constrains outcomes when agents hold extreme preferences. To better understand proportionality and its interaction with welfare and truthfulness, we address three questions. First, how much welfare must be sacrificed to achieve proportionality? We formalize this via the price of proportionality, the best worst-case welfare ratio between a proportional mechanism and Util, the welfare-maximizing mechanism. We introduce a new single-minded proportional and truthful mechanism, UtilProp, and show that it achieves the optimal worst-case ratio. Second, how do proportional mechanisms compare in terms of welfare? We define an instance-wise welfare dominance relation and use it to compare mechanisms from the literature. In particular, we show that UtilProp welfare-dominates all previously known single-minded proportional and truthful mechanisms. Third, can stronger notions of proportionality be achieved without compromising welfare guarantees? We answer this question in the affirmative by studying decomposability and proposing GreedyDecomp, a decomposable mechanism with optimal worst-case welfare ratio. We further show that computing the welfare-dominant decomposable mechanism, UtilDecomp, is NP-hard, and that GreedyDecomp provides a 2-approximation to UtilDecomp in terms of welfare."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.23027","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T03:00:42Z","registered":"2026-02-27T03:00:42Z","published":null,"updated":"2026-02-27T03:00:42Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.23026","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.23026","identifiers":[{"identifier":"2602.23026","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Eitan","familyName":"Bachmat","name":"Bachmat, Eitan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Inbal Livni","familyName":"Navon","name":"Navon, Inbal Livni","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Fairness in Limited Resources Settings"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Computers and Society (cs.CY)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-26T14:07:05Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:47:44Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"In recent years many important societal decisions are made by machine-learning algorithms, and many such important decisions have strict capacity limits, allowing resources to be allocated only to the highest utility individuals. For example, allocating physician appointments to the patients most likely to have some medical condition, or choosing which children will attend a special program. When performing such decisions, we consider both the prediction aspect of the decision and the resource allocation aspect. In this work we focus on the fairness of the decisions in such settings. The fairness aspect here is critical as the resources are limited, and allocating the resources to one individual leaves less resources for others. When the decision involves prediction together with the resource allocation, there is a risk that information gaps between different populations will lead to a very unbalanced allocation of resources.\n We address settings by adapting definitions from resource allocation schemes, identifying connections between the algorithmic fairness definitions and resource allocation ones, and examining the trade-offs between fairness and utility. We analyze the price of enforcing the different fairness definitions compared to a strictly utility-based optimization of the predictor, and show that it can be unbounded. We introduce an adaptation of proportional fairness and show that it has a bounded price of fairness, indicating greater robustness, and propose a variant of equal opportunity that also has a bounded price of fairness."},{"descriptionType":"Other","description":"29 pages 3 figures"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.23026","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T03:00:40Z","registered":"2026-02-27T03:00:41Z","published":null,"updated":"2026-02-27T03:00:41Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.23005","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.23005","identifiers":[{"identifier":"2602.23005","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Man","familyName":"Zhang","name":"Zhang, Man","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Tao","familyName":"Yue","name":"Yue, Tao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yihua","familyName":"He","name":"He, Yihua","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Managing Uncertainty in LLM-based Multi-Agent System Operation"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Software Engineering (cs.SE)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-26T13:49:16Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:46:48Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Applying LLM-based multi-agent software systems in safety-critical domains such as lifespan echocardiography introduces system-level risks that cannot be addressed by improving model accuracy alone. During system operation, beyond individual LLM behavior, uncertainty propagates through agent coordination, data pipelines, human-in-the-loop interaction, and runtime control logic. Yet existing work largely treats uncertainty at the model level rather than as a first-class software engineering concern. This paper approaches uncertainty from both system-level and runtime perspectives. We first differentiate epistemological and ontological uncertainties in the context of LLM-based multi-agent software system operation. Building on this foundation, we propose a lifecycle-based uncertainty management framework comprising four mechanisms: representation, identification, evolution, and adaptation. The uncertainty lifecycle governs how uncertainties emerge, transform, and are mitigated across architectural layers and execution phases, enabling structured runtime governance and controlled adaptation. We demonstrate the feasibility of the framework using a real-world LLM-based multi-agent echocardiographic software system developed in clinical collaboration, showing improved reliability and diagnosability in diagnostic reasoning. The proposed approach generalizes to other safety-critical LLM-based multi-agent software systems, supporting principled operational control and runtime assurance beyond model-centric methods."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.23005","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T03:00:11Z","registered":"2026-02-27T03:00:12Z","published":null,"updated":"2026-02-27T03:00:12Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.22998","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.22998","identifiers":[{"identifier":"2602.22998","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Ryan Paul","familyName":"McKennaa","name":"McKennaa, Ryan Paul","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"John","familyName":"Oyekan","name":"Oyekan, John","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"A Perspective on Open Challenges in Deformable Object Manipulation"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Robotics (cs.RO)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-26T13:39:30Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:46:08Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Deformable object manipulation (DOM) represents a critical challenge in robotics, with applications spanning healthcare, manufacturing, food processing, and beyond. Unlike rigid objects, deformable objects exhibit infinite dimensionality, dynamic shape changes, and complex interactions with their environment, posing significant hurdles for perception, modeling, and control. This paper reviews the state of the art in DOM, focusing on key challenges such as occlusion handling, task generalization, and scalable, real-time solutions. It highlights advancements in multimodal perception systems, including the integration of multi-camera setups, active vision, and tactile sensing, which collectively address occlusion and improve adaptability in unstructured environments. Cutting-edge developments in physically informed reinforcement learning (RL) and differentiable simulations are explored, showcasing their impact on efficiency, precision, and scalability. The review also emphasizes the potential of simulated expert demonstrations and generative neural networks to standardize task specifications and bridge the simulation-to-reality gap. Finally, future directions are proposed, including the adoption of graph neural networks for high-level decision-making and the creation of comprehensive datasets to enhance DOM's real-world applicability. By addressing these challenges, DOM research can pave the way for versatile robotic systems capable of handling diverse and dynamic tasks with deformable objects."},{"descriptionType":"Other","description":"28 pages, 7 Figures"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.22998","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T03:00:00Z","registered":"2026-02-27T03:00:01Z","published":null,"updated":"2026-02-27T03:00:01Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.22991","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.22991","identifiers":[{"identifier":"2602.22991","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Alexander","familyName":"Bonora","name":"Bonora, Alexander","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Anna V.","familyName":"Guglielmi","name":"Guglielmi, Anna V.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Davide","familyName":"Scazzoli","name":"Scazzoli, Davide","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Marco","familyName":"Giordani","name":"Giordani, Marco","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Maurizio","familyName":"Magarini","name":"Magarini, Maurizio","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Vineeth","familyName":"Teeda","name":"Teeda, Vineeth","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Stefano","familyName":"Tomasin","name":"Tomasin, Stefano","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Digital Twin-Based Beamforming for Interference Mitigation in AF Relay MIMO Systems"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Signal Processing (eess.SP)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Electrical engineering, electronic engineering, information engineering","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Electrical engineering, electronic engineering, information engineering","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-26T13:35:26Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:45:57Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Beamforming in multiple-input multiple-output (MIMO) systems should take interference mitigation into account. However, for beamform design, accurate channel state information (CSI) is needed, which is often difficult to obtain due to channel variability, feedback overhead, or hardware constraints. For example, amplify-and-forward (AF) relays passively forward signals without measurement, precluding full CSI acquisition to and from the relay. To address these issues, this paper introduces a novel prediction-assisted optimization (PAO) framework for beamform design in AF relay-assisted multiuser MIMO systems. The proposed solution in the AF relay aims at maximizing the signal-plus-interference-to-noise ratio (SINR). Unlike other methods, PAO relies solely on received power measurements, making it suitable for scenarios where CSI is unreliable or unavailable. PAO consists of two stages: a supervised-learning-based neural network (NN) that predicts the positions of transmitters using signal observations, and an optimization algorithm, guided by a digital twin (DT), that iteratively refines the beam direction of the relay in a simulated radio environment. As a key contribution, we validate the proposed framework using realistic measurements collected on a custom-built experimental millimeter wave (mmWave) platform, which enables training of the NN model under practical wireless conditions. The estimated information is then used to update the digital twin with knowledge of the surrounding environment, enabling online optimization. Numerical results show the trade-off between localization accuracy and beamforming performance and confirm that PAO maintains robustness even in the presence of localization errors while reducing the need for real-world measurements."},{"descriptionType":"Other","description":"12 pages, 13 figures, 1 table. Submitted to IEEE Special Issue on \"Digital Twins for Wireless Networks: Enabling Application-Aware and Closed-Loop Optimization\""}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.22991","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T02:59:49Z","registered":"2026-02-27T02:59:50Z","published":null,"updated":"2026-02-27T02:59:50Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.22985","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.22985","identifiers":[{"identifier":"2602.22985","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Pouya","familyName":"Roudaki","name":"Roudaki, Pouya","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Shakeel","familyName":"Gavioli-Akilagun","name":"Gavioli-Akilagun, Shakeel","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Florian","familyName":"Kalinke","name":"Kalinke, Florian","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Mona","familyName":"Azadkia","name":"Azadkia, Mona","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zoltán","familyName":"Szabó","name":"Szabó, Zoltán","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Kernel Integrated $R^2$: A Measure of Dependence"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Machine Learning (stat.ML)","lang":"en","subjectScheme":"arXiv"},{"subject":"Information Theory (cs.IT)","lang":"en","subjectScheme":"arXiv"},{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"G.3; H.1.1; I.2.6","lang":"en","subjectScheme":"ACM"},{"subject":"62H20 (Primary) 46E22, 62B10, 62G10, 94A17 (Secondary)","lang":"en","subjectScheme":"MSC"}],"contributors":[],"dates":[{"date":"2026-02-26T13:29:12Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:45:30Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"We introduce kernel integrated $R^2$, a new measure of statistical dependence that combines the local normalization principle of the recently introduced integrated $R^2$ with the flexibility of reproducing kernel Hilbert spaces (RKHSs). The proposed measure extends integrated $R^2$ from scalar responses to responses taking values on general spaces equipped with a characteristic kernel, allowing to measure dependence of multivariate, functional, and structured data, while remaining sensitive to tail behaviour and oscillatory dependence structures. We establish that (i) this new measure takes values in $[0,1]$, (ii) equals zero if and only if independence holds, and (iii) equals one if and only if the response is almost surely a measurable function of the covariates. Two estimators are proposed: a graph-based method using $K$-nearest neighbours and an RKHS-based method built on conditional mean embeddings. We prove consistency and derive convergence rates for the graph-based estimator, showing its adaptation to intrinsic dimensionality. Numerical experiments on simulated data and a real data experiment in the context of dependency testing for media annotations demonstrate competitive power against state-of-the-art dependence measures, particularly in settings involving non-linear and structured relationships."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.22985","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T02:59:40Z","registered":"2026-02-27T02:59:41Z","published":null,"updated":"2026-02-27T02:59:41Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.22981","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.22981","identifiers":[{"identifier":"2602.22981","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Haohui","familyName":"Jia","name":"Jia, Haohui","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zheng","familyName":"Chen","name":"Chen, Zheng","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Lingwei","familyName":"Zhu","name":"Zhu, Lingwei","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xu","familyName":"Cao","name":"Cao, Xu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yasuko","familyName":"Matsubara","name":"Matsubara, Yasuko","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Takashi","familyName":"Matsubara","name":"Matsubara, Takashi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yasushi","familyName":"Sakurai","name":"Sakurai, Yasushi","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"RepSPD: Enhancing SPD Manifold Representation in EEGs via Dynamic Graphs"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-26T13:22:19Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:45:05Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Decoding brain activity from electroencephalography (EEG) is crucial for neuroscience and clinical applications. Among recent advances in deep learning for EEG, geometric learning stands out as its theoretical underpinnings on symmetric positive definite (SPD) allows revealing structural connectivity analysis in a physics-grounded manner. However, current SPD-based methods focus predominantly on statistical aggregation of EEGs, with frequency-specific synchronization and local topological structures of brain regions neglected. Given this, we propose RepSPD, a novel geometric deep learning (GDL)-based model. RepSPD implements a cross-attention mechanism on the Riemannian manifold to modulate the geometric attributes of SPD with graph-derived functional connectivity features. On top of this, we introduce a global bidirectional alignment strategy to reshape tangent-space embeddings, mitigating geometric distortions caused by curvature and thereby enhancing geometric consistency. Extensive experiments demonstrate that our proposed framework significantly outperforms existing EEG representation methods, exhibiting superior robustness and generalization capabilities."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.22981","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T02:59:33Z","registered":"2026-02-27T02:59:34Z","published":null,"updated":"2026-02-27T02:59:34Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.22974","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.22974","identifiers":[{"identifier":"2602.22974","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"L.","familyName":"Martino","name":"Martino, L.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"M. M.","familyName":"Garcia","name":"Garcia, M. M.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"P. S.","familyName":"Paradas","name":"Paradas, P. S.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"E.","familyName":"Curbelo","name":"Curbelo, E.","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"An automatic counting algorithm for the quantification and uncertainty analysis of the number of microglial cells trainable in small and heterogeneous datasets"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Computational Engineering, Finance, and Science (cs.CE)","lang":"en","subjectScheme":"arXiv"},{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"Image and Video Processing (eess.IV)","lang":"en","subjectScheme":"arXiv"},{"subject":"Signal Processing (eess.SP)","lang":"en","subjectScheme":"arXiv"},{"subject":"Machine Learning (stat.ML)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"FOS: Electrical engineering, electronic engineering, information engineering","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Electrical engineering, electronic engineering, information engineering","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-26T13:13:43Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:44:45Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[{"relationType":"IsVersionOf","relatedIdentifier":"10.1016/j.eswa.2025.129208","relatedIdentifierType":"DOI"}],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Counting immunopositive cells on biological tissues generally requires either manual annotation or (when available) automatic rough systems, for scanning signal surface and intensity in whole slide imaging. In this work, we tackle the problem of counting microglial cells in lumbar spinal cord cross-sections of rats by omitting cell detection and focusing only on the counting task. Manual cell counting is, however, a time-consuming task and additionally entails extensive personnel training. The classic automatic color-based methods roughly inform about the total labeled area and intensity (protein quantification) but do not specifically provide information on cell number. Since the images to be analyzed have a high resolution but a huge amount of pixels contain just noise or artifacts, we first perform a pre-processing generating several filtered images {(providing a tailored, efficient feature extraction)}. Then, we design an automatic kernel counter that is a non-parametric and non-linear method. The proposed scheme can be easily trained in small datasets since, in its basic version, it relies only on one hyper-parameter. However, being non-parametric and non-linear, the proposed algorithm is flexible enough to express all the information contained in rich and heterogeneous datasets as well (providing the maximum overfit if required). Furthermore, the proposed kernel counter also provides uncertainty estimation of the given prediction, and can directly tackle the case of receiving several expert opinions over the same image. Different numerical experiments with artificial and real datasets show very promising results. Related Matlab code is also provided."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.22974","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":1,"created":"2026-02-27T02:59:23Z","registered":"2026-02-27T02:59:23Z","published":null,"updated":"2026-02-27T02:59:23Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.22963","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.22963","identifiers":[{"identifier":"2602.22963","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Zehao","familyName":"Li","name":"Li, Zehao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Hongwei","familyName":"Yu","name":"Yu, Hongwei","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Hao","familyName":"Jiang","name":"Jiang, Hao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Qiang","familyName":"Sheng","name":"Sheng, Qiang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yilong","familyName":"Xu","name":"Xu, Yilong","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Baolong","familyName":"Bi","name":"Bi, Baolong","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yang","familyName":"Li","name":"Li, Yang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zhenlong","familyName":"Yuan","name":"Yuan, Zhenlong","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yujun","familyName":"Cai","name":"Cai, Yujun","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zhaoqi","familyName":"Wang","name":"Wang, Zhaoqi","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"FactGuard: Agentic Video Misinformation Detection via Reinforcement Learning"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-26T13:00:31Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:44:12Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Multimodal large language models (MLLMs) have substantially advanced video misinformation detection through unified multimodal reasoning, but they often rely on fixed-depth inference and place excessive trust in internally generated assumptions, particularly in scenarios where critical evidence is sparse, fragmented, or requires external verification. To address these limitations, we propose FactGuard, an agentic framework for video misinformation detection that formulates verification as an iterative reasoning process built upon MLLMs. FactGuard explicitly assesses task ambiguity and selectively invokes external tools to acquire critical evidence, enabling progressive refinement of reasoning trajectories. To further strengthen this capability, we introduce a two-stage training strategy that combines domain-specific agentic supervised fine-tuning with decision-aware reinforcement learning to optimize tool usage and calibrate risk-sensitive decision making. Extensive experiments on FakeSV, FakeTT, and FakeVV demonstrate FactGuard's state-of-the-art performance and validate its excellent robustness and generalization capacity."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.22963","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T02:59:06Z","registered":"2026-02-27T02:59:07Z","published":null,"updated":"2026-02-27T02:59:07Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.22945","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.22945","identifiers":[{"identifier":"2602.22945","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Kamal","familyName":"Sherawat","name":"Sherawat, Kamal","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Vikrant","familyName":"Bhati","name":"Bhati, Vikrant","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Cross-Task Benchmarking of CNN Architectures"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-25T15:20:21Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:43:04Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"This project provides a comparative study of dynamic convolutional neural networks (CNNs) for various tasks, including image classification, segmentation, and time series analysis. Based on the ResNet-18 architecture, we compare five variants of CNNs: the vanilla CNN, the hard attention-based CNN, the soft attention-based CNN with local (pixel-wise) and global (image-wise) feature attention, and the omni-directional CNN (ODConv). Experiments on Tiny ImageNet, Pascal VOC, and the UCR Time Series Classification Archive illustrate that attention mechanisms and dynamic convolution methods consistently exceed conventional CNNs in accuracy, efficiency, and computational performance. ODConv was especially effective on morphologically complex images by being able to dynamically adjust to varying spatial patterns. Dynamic CNNs enhanced feature representation and cross-task generalization through adaptive kernel modulation. This project provides perspectives on advanced CNN design architecture for multiplexed data modalities and indicates promising directions in neural network engineering."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.22945","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T02:58:39Z","registered":"2026-02-27T02:58:40Z","published":null,"updated":"2026-02-27T02:58:40Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.22943","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.22943","identifiers":[{"identifier":"2602.22943","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Ali","familyName":"Abbassi","name":"Abbassi, Ali","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yann","familyName":"Dujardin","name":"Dujardin, Yann","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Eric","familyName":"Gourdin","name":"Gourdin, Eric","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Philippe","familyName":"Lacomme","name":"Lacomme, Philippe","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Caroline","familyName":"Prodhon","name":"Prodhon, Caroline","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"A quantum feasibility preserving modeling for the min cut problem"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Quantum Physics (quant-ph)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-26T12:34:59Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:43:02Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by-nc-nd/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution Non Commercial No Derivatives 4.0 International","rightsIdentifier":"cc-by-nc-nd-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"We study the minimum cut problem in weighted undirected graphs using variational quantum algorithms in which only feasible cut configurations are explored. Although minimum cut admits efficient classical solutions, it is a fundamental component of more complex network optimization problems such as multicut and network interdiction. Our objective is to examine quantum models in which feasibility is preserved by the mixer dynamics, without introducing penalty terms in the cost Hamiltonian. We employ a ring structured XY mixer that restricts the quantum evolution to the subspace of valid cut configurations, ensuring that all sampled states correspond to feasible solutions. To address scalability limitations, we suggest an iterative metaheuristic strategy that decomposes large instances into smaller subproblems solved sequentially using the same quantum model. The results obtained using the mixer indicate that the initial probability distribution can be systematically controlled, thereby enabling the development of warm start techniques within variational quantum based algorithms."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.22943","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T02:58:36Z","registered":"2026-02-27T02:58:36Z","published":null,"updated":"2026-02-27T02:58:37Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.22939","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.22939","identifiers":[{"identifier":"2602.22939","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Yosuke","familyName":"Inoue","name":"Inoue, Yosuke","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Masaki","familyName":"Inoue","name":"Inoue, Masaki","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Steady State Covariance Steering via Sparse Intervention"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Systems and Control (eess.SY)","lang":"en","subjectScheme":"arXiv"},{"subject":"Optimization and Control (math.OC)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Electrical engineering, electronic engineering, information engineering","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Electrical engineering, electronic engineering, information engineering","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-26T12:29:43Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:42:51Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"This paper addresses the steady state covariance steering for linear dynamical systems via structural intervention on the system matrix. We formulate the covariance steering problem as the minimization of the Kullback-Leibler (KL) divergence between the steady state and target Gaussian distributions. To solve the problem, we develop a solution method, hereafter referred to as the proximal gradient-based algorithm, of promoting sparsity in the structural intervention by integrating the objective into a proximal gradient framework with L1 regularization. The main contribution of this paper lies in the analytical expression of the KL divergence gradient with respect to the intervention matrix: the gradient is characterized by the solutions to two Lyapunov equations related to the state covariance equation and its adjoint. Numerical simulations demonstrate that the proximal gradient-based algorithm effectively identifies sparse, structurally-constrained interventions to achieve precise covariance steering."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.22939","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T02:58:29Z","registered":"2026-02-27T02:58:30Z","published":null,"updated":"2026-02-27T02:58:31Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.22937","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.22937","identifiers":[{"identifier":"2602.22937","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Suresan","familyName":"Pareth","name":"Pareth, Suresan","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"MSINO: Curvature-Aware Sobolev Optimization for Manifold Neural Networks"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"49M07, 53C21, 46E35","lang":"en","subjectScheme":"MSC"}],"contributors":[],"dates":[{"date":"2026-02-26T12:27:00Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:42:44Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"We introduce Manifold Sobolev Informed Neural Optimization (MSINO), a curvature aware training framework for neural networks defined on Riemannian manifolds. The method replaces standard Euclidean derivative supervision with a covariant Sobolev loss that aligns gradients using parallel transport and improves stability via a Laplace Beltrami smoothness regularization term.\n Building on classical results in Riemannian optimization and Sobolev theory on manifolds, we derive geometry dependent constants that yield (i) a Descent Lemma with a manifold Sobolev smoothness constant, (ii) a Sobolev Polyak Lojasiewicz inequality giving linear convergence guarantees for Riemannian gradient descent and stochastic gradient descent under explicit step size bounds, and (iii) a two step Newton Sobolev method with local quadratic contraction in curvature controlled neighborhoods.\n Unlike prior Sobolev training in Euclidean space, MSINO provides training time guarantees that explicitly track curvature and transported Jacobians. Applications include surface imaging, physics informed learning settings, and robotics on Lie groups such as SO(3) and SE(3). The framework unifies value and gradient based learning with curvature aware convergence guarantees for neural training on manifolds."},{"descriptionType":"Other","description":"32 pages, 6 figures. Submitted for journal consideration"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.22937","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T02:58:25Z","registered":"2026-02-27T02:58:26Z","published":null,"updated":"2026-02-27T02:58:26Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.22936","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.22936","identifiers":[{"identifier":"2602.22936","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Wenquan","familyName":"Ma","name":"Ma, Wenquan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yang","familyName":"Sui","name":"Sui, Yang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jiaye","familyName":"Teng","name":"Teng, Jiaye","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Bohan","familyName":"Wang","name":"Wang, Bohan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jing","familyName":"Xu","name":"Xu, Jing","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jingqin","familyName":"Yang","name":"Yang, Jingqin","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Generalization Bounds of Stochastic Gradient Descent in Homogeneous Neural Networks"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-26T12:26:32Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:42:43Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Algorithmic stability is among the most potent techniques in generalization analysis. However, its derivation usually requires a stepsize $η_t = \\mathcal{O}(1/t)$ under non-convex training regimes, where $t$ denotes iterations. This rigid decay of the stepsize potentially impedes optimization and may not align with practical scenarios. In this paper, we derive the generalization bounds under the homogeneous neural network regimes, proving that this regime enables slower stepsize decay of order $Ω(1/\\sqrt{t})$ under mild assumptions. We further extend the theoretical results from several aspects, e.g., non-Lipschitz regimes. This finding is broadly applicable, as homogeneous neural networks encompass fully-connected and convolutional neural networks with ReLU and LeakyReLU activations."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.22936","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T02:58:24Z","registered":"2026-02-27T02:58:25Z","published":null,"updated":"2026-02-27T02:58:25Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.22935","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.22935","identifiers":[{"identifier":"2602.22935","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Zarif","familyName":"Ishmam","name":"Ishmam, Zarif","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zarif","familyName":"Mahir","name":"Mahir, Zarif","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Shafnan","familyName":"Wasif","name":"Wasif, Shafnan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Md. Ishtiak","familyName":"Moin","name":"Moin, Md. Ishtiak","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"A Holistic Framework for Robust Bangla ASR and Speaker Diarization with Optimized VAD and CTC Alignment"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Sound (cs.SD)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-26T12:26:04Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:42:43Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Despite being one of the most widely spoken languages globally, Bangla remains a low-resource language in the field of Natural Language Processing (NLP). Mainstream Automatic Speech Recognition (ASR) and Speaker Diarization systems for Bangla struggles when processing longform audio exceeding 3060 seconds. This paper presents a robust framework specifically engineered for extended Bangla content by leveraging preexisting models enhanced with novel optimization pipelines for the DL Sprint 4.0 contest. Our approach utilizes Voice Activity Detection (VAD) optimization and Connectionist Temporal Classification (CTC) segmentation via forced word alignment to maintain temporal accuracy and transcription integrity over long durations. Additionally, we employed several finetuning techniques and preprocessed the data using augmentation techniques and noise removal. By bridging the performance gap in complex, multi-speaker environments, this work provides a scalable solution for real-world, longform Bangla speech applications."},{"descriptionType":"Other","description":"5 pages"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.22935","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T02:58:22Z","registered":"2026-02-27T02:58:23Z","published":null,"updated":"2026-02-27T02:58:23Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.22925","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.22925","identifiers":[{"identifier":"2602.22925","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Katerina","familyName":"Papagiannouli","name":"Papagiannouli, Katerina","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Dario","familyName":"Trevisan","name":"Trevisan, Dario","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Giuseppe Pio","familyName":"Zitto","name":"Zitto, Giuseppe Pio","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Beyond NNGP: Large Deviations and Feature Learning in Bayesian Neural Networks"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Machine Learning (stat.ML)","lang":"en","subjectScheme":"arXiv"},{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"G.3","lang":"en","subjectScheme":"ACM"}],"contributors":[],"dates":[{"date":"2026-02-26T12:15:11Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:42:14Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"We study wide Bayesian neural networks focusing on the rare but statistically dominant fluctuations that govern posterior concentration, beyond Gaussian-process limits. Large-deviation theory provides explicit variational objectives-rate functions-on predictors, providing an emerging notion of complexity and feature learning directly at the functional level. We show that the posterior output rate function is obtained by a joint optimization over predictors and internal kernels, in contrast with fixed-kernel (NNGP) theory. Numerical experiments demonstrate that the resulting predictions accurately describe finite-width behavior for moderately sized networks, capturing non-Gaussian tails, posterior deformation, and data-dependent kernel selection effects."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.22925","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T02:58:06Z","registered":"2026-02-27T02:58:07Z","published":null,"updated":"2026-02-27T02:58:07Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.22923","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.22923","identifiers":[{"identifier":"2602.22923","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Runwei","familyName":"Guan","name":"Guan, Runwei","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Shaofeng","familyName":"Liang","name":"Liang, Shaofeng","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ningwei","familyName":"Ouyang","name":"Ouyang, Ningwei","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Weichen","familyName":"Fei","name":"Fei, Weichen","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Shanliang","familyName":"Yao","name":"Yao, Shanliang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Wei","familyName":"Dai","name":"Dai, Wei","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Chenhao","familyName":"Ge","name":"Ge, Chenhao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Penglei","familyName":"Sun","name":"Sun, Penglei","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xiaohui","familyName":"Zhu","name":"Zhu, Xiaohui","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Tao","familyName":"Huang","name":"Huang, Tao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ryan Wen","familyName":"Liu","name":"Liu, Ryan Wen","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Hui","familyName":"Xiong","name":"Xiong, Hui","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"WaterVideoQA: ASV-Centric Perception and Rule-Compliant Reasoning via Multi-Modal Agents"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"Robotics (cs.RO)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-26T12:12:40Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:42:10Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"While autonomous navigation has achieved remarkable success in passive perception (e.g., object detection and segmentation), it remains fundamentally constrained by a void in knowledge-driven, interactive environmental cognition. In the high-stakes domain of maritime navigation, the ability to bridge the gap between raw visual perception and complex cognitive reasoning is not merely an enhancement but a critical prerequisite for Autonomous Surface Vessels to execute safe and precise maneuvers. To this end, we present WaterVideoQA, the first large-scale, comprehensive Video Question Answering benchmark specifically engineered for all-waterway environments. This benchmark encompasses 3,029 video clips across six distinct waterway categories, integrating multifaceted variables such as volatile lighting and dynamic weather to rigorously stress-test ASV capabilities across a five-tier hierarchical cognitive framework. Furthermore, we introduce NaviMind, a pioneering multi-agent neuro-symbolic system designed for open-ended maritime reasoning. By synergizing Adaptive Semantic Routing, Situation-Aware Hierarchical Reasoning, and Autonomous Self-Reflective Verification, NaviMind transitions ASVs from superficial pattern matching to regulation-compliant, interpretable decision-making. Experimental results demonstrate that our framework significantly transcends existing baselines, establishing a new paradigm for intelligent, trustworthy interaction in dynamic maritime environments."},{"descriptionType":"Other","description":"11 pages,8 figures"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.22923","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T02:58:03Z","registered":"2026-02-27T02:58:04Z","published":null,"updated":"2026-02-27T02:58:04Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.22922","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.22922","identifiers":[{"identifier":"2602.22922","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Sophia","familyName":"Taddei","name":"Taddei, Sophia","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Wouter","familyName":"Koppen","name":"Koppen, Wouter","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Eligia","familyName":"Alfio","name":"Alfio, Eligia","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Stefano","familyName":"Nuzzo","name":"Nuzzo, Stefano","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Louis","familyName":"Flynn","name":"Flynn, Louis","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Maria Alejandra","familyName":"Diaz","name":"Diaz, Maria Alejandra","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Sebastian Rojas","familyName":"Gonzalez","name":"Gonzalez, Sebastian Rojas","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Tom","familyName":"Dhaene","name":"Dhaene, Tom","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Kevin","familyName":"De Pauw","name":"De Pauw, Kevin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ivo","familyName":"Couckuyt","name":"Couckuyt, Ivo","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Tom","familyName":"Verstraten","name":"Verstraten, Tom","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Bayesian Preference Elicitation: Human-In-The-Loop Optimization of An Active Prosthesis"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Robotics (cs.RO)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-26T12:11:51Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:42:06Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by-nc-sa/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution Non Commercial Share Alike 4.0 International","rightsIdentifier":"cc-by-nc-sa-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Tuning active prostheses for people with amputation is time-consuming and relies on metrics that may not fully reflect user needs. We introduce a human-in-the-loop optimization (HILO) approach that leverages direct user preferences to personalize a standard four-parameter prosthesis controller efficiently. Our method employs preference-based Multiobjective Bayesian Optimization that uses a state-or-the-art acquisition function especially designed for preference learning, and includes two algorithmic variants: a discrete version (\\textit{EUBO-LineCoSpar}), and a continuous version (\\textit{BPE4Prost}). Simulation results on benchmark functions and real-application trials demonstrate efficient convergence, robust preference elicitation, and measurable biomechanical improvements, illustrating the potential of preference-driven tuning for user-centered prosthesis control."},{"descriptionType":"Other","description":"8 pages, 5 figures"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.22922","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T02:58:02Z","registered":"2026-02-27T02:58:03Z","published":null,"updated":"2026-02-27T02:58:03Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.22917","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.22917","identifiers":[{"identifier":"2602.22917","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Hongzhao","familyName":"Li","name":"Li, Hongzhao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Hao","familyName":"Dong","name":"Dong, Hao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Hualei","familyName":"Wan","name":"Wan, Hualei","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Shupan","familyName":"Li","name":"Li, Shupan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Mingliang","familyName":"Xu","name":"Xu, Mingliang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Muhammad Haris","familyName":"Khan","name":"Khan, Muhammad Haris","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Towards Multimodal Domain Generalization with Few Labels"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-26T12:05:56Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:41:46Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Multimodal models ideally should generalize to unseen domains while remaining data-efficient to reduce annotation costs. To this end, we introduce and study a new problem, Semi-Supervised Multimodal Domain Generalization (SSMDG), which aims to learn robust multimodal models from multi-source data with few labeled samples. We observe that existing approaches fail to address this setting effectively: multimodal domain generalization methods cannot exploit unlabeled data, semi-supervised multimodal learning methods ignore domain shifts, and semi-supervised domain generalization methods are confined to single-modality inputs. To overcome these limitations, we propose a unified framework featuring three key components: Consensus-Driven Consistency Regularization, which obtains reliable pseudo-labels through confident fused-unimodal consensus; Disagreement-Aware Regularization, which effectively utilizes ambiguous non-consensus samples; and Cross-Modal Prototype Alignment, which enforces domain- and modality-invariant representations while promoting robustness under missing modalities via cross-modal translation. We further establish the first SSMDG benchmarks, on which our method consistently outperforms strong baselines in both standard and missing-modality scenarios. Our benchmarks and code are available at https://github.com/lihongzhao99/SSMDG."},{"descriptionType":"Other","description":"Accepted to CVPR 2026"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.22917","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T02:57:55Z","registered":"2026-02-27T02:57:56Z","published":null,"updated":"2026-02-27T02:57:56Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.22916","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.22916","identifiers":[{"identifier":"2602.22916","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Yaseen","familyName":"Abd-Elhaleem","name":"Abd-Elhaleem, Yaseen","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Michal","familyName":"Dory","name":"Dory, Michal","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Oren","familyName":"Weimann","name":"Weimann, Oren","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"A Simple Distributed Deterministic Planar Separator"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Distributed, Parallel, and Cluster Computing (cs.DC)","lang":"en","subjectScheme":"arXiv"},{"subject":"Data Structures and Algorithms (cs.DS)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-26T12:05:21Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:41:45Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by-nc-sa/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution Non Commercial Share Alike 4.0 International","rightsIdentifier":"cc-by-nc-sa-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"A balanced separator of a graph $G$ is a set of vertices whose removal disconnects the graph into connected components that are a constant factor smaller than $G$. Lipton and Tarjan [FOCS'77] famously proved that every planar graph admits a balanced separator of size $O(\\sqrt{n})$, as well as a balanced separator of size $O(D)$ that is a simple path (where $D$ is $G$'s diameter). In the centralized setting, both separators can be found in linear time. In the distributed setting, $D$ is a universal lower bound for the round complexity of solving many optimization problems, so, separators of size $O(D)$ are preferable.\n It was not until [DISC'17] that a distributed algorithm was devised by Ghaffari and Parter to compute such an $O(D)$-size separator in $\\tilde O(D)$ rounds, by adapting the Lipton-Tarjan algorithm to the distributed model. Since then, this algorithm was used in several distributed algorithms for planar graphs, e.g., [GP, DISC'17], [LP, STOC'19], [AEDPW, PODC'25]. However, the algorithm is randomized, deeming the algorithms that use it to be randomized as well. Obtaining a deterministic algorithm remained an interesting open question until [PODC'25], when a (complex) deterministic separator algorithm was given by Jauregui, Montealegre and Rapaport.\n We present a much simpler deterministic separator algorithm with the same (near-optimal) $\\tilde O(D)$-round complexity. While previous works devised either complicated or randomized ways of transferring weights from vertices to faces of $G$, we show that a straightforward way also works: Each vertex simply transfers its weight to one arbitrary face it lies on. That's it!\n We note that a deterministic separator algorithm directly derandomizes the state-of-the-art distributed algorithms for classical problems on planar graphs such as single-source shortest-paths, maximum-flow, directed global min-cut, and reachability."},{"descriptionType":"Other","description":"19 pages, to appear in SIROCCO 2026"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.22916","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T02:57:54Z","registered":"2026-02-27T02:57:54Z","published":null,"updated":"2026-02-27T02:57:54Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.22915","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.22915","identifiers":[{"identifier":"2602.22915","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Farzaneh","familyName":"Farhadi","name":"Farhadi, Farzaneh","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Maria","familyName":"Chli","name":"Chli, Maria","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Robust Information Design for Multi-Agent Systems with Complementarities: Smallest-Equilibrium Threshold Policies"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Computer Science and Game Theory (cs.GT)","lang":"en","subjectScheme":"arXiv"},{"subject":"Multiagent Systems (cs.MA)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-26T12:03:16Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:41:39Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"We study information design in multi-agent systems (MAS) with binary actions and strategic complementarities, where an external designer influences behavior only through signals. Agents play the smallest-equilibrium of the induced Bayesian game, reflecting conservative, coordination-averse behavior typical in distributed systems. We show that when utilities admit a convex potential and welfare is convex, the robustly implementable optimum has a remarkably simple form: perfect coordination at each state: either everyone acts or no one does. We provide a constructive threshold rule: compute a one-dimensional score for each state, sort states, and pick a single threshold (with a knife-edge lottery for at most one state). This rule is an explicit optimal vertex of a linear program (LP) characterized by feasibility and sequential obedience constraints. Empirically, in both vaccination and technology-adoption domains, our constructive policy matches LP optima, scales as $O(|Θ|\\log|Θ|)$, and avoids the inflated welfare predicted by obedience-only designs that assume the designer can dictate the (best) equilibrium. The result is a general, scalable recipe for robust coordination in MAS with complementarities."},{"descriptionType":"Other","description":"This paper has been accepted for publication in Proceedings of the 25th International Conference on Autonomous Agents and Multiagent Systems (AAMAS 2026). The final published version will be available via the ACM Digital Library"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.22915","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T02:57:52Z","registered":"2026-02-27T02:57:53Z","published":null,"updated":"2026-02-27T02:57:53Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.22888","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.22888","identifiers":[{"identifier":"2602.22888","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Chun-Chi","familyName":"Lin","name":"Lin, Chun-Chi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yang-Kai","familyName":"Lue","name":"Lue, Yang-Kai","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Dung The","familyName":"Tran","name":"Tran, Dung The","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Existence of Quantum Splines via Fourth-Order Gradient Flows"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Optimization and Control (math.OC)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-26T11:26:06Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:40:13Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by-nc-sa/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution Non Commercial Share Alike 4.0 International","rightsIdentifier":"cc-by-nc-sa-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"We establish a rigorous existence theory for the quantum splines introduced by Brody, Holm, and Meier in Physical Review Letters (2012). These curves arise as solutions of a variational problem on the unitary group describing optimally controlled quantum evolutions. By formulating the problem within a geometric gradient flow framework for Riemannian spline interpolation, we construct a well-posed fourth order evolution whose asymptotic limits realize the desired quantum splines. The analysis requires adapting the variational structure to boundary conditions dictated by the physical model, which are not directly amenable to the setting in our recently developed framework for gradient flows of Riemannian spline interpolation. We show that, despite these difficulties, the modified system admits a rigorous analytical treatment, yielding both existence and a constructive procedure for generating quantum splines. Our results provide a mathematical foundation for the variational description of smooth quantum control trajectories and clarify the analytical structure underlying their formation."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.22888","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T02:57:13Z","registered":"2026-02-27T02:57:13Z","published":null,"updated":"2026-02-27T02:57:13Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.22879","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.22879","identifiers":[{"identifier":"2602.22879","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Xingcheng","familyName":"Fu","name":"Fu, Xingcheng","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Shengpeng","familyName":"Wang","name":"Wang, Shengpeng","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yisen","familyName":"Gao","name":"Gao, Yisen","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xianxian","familyName":"Li","name":"Li, Xianxian","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Chunpei","familyName":"Li","name":"Li, Chunpei","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Qingyun","familyName":"Sun","name":"Sun, Qingyun","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Dongran","familyName":"Yu","name":"Yu, Dongran","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Towards LLM-Empowered Knowledge Tracing via LLM-Student Hierarchical Behavior Alignment in Hyperbolic Space"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-26T11:17:31Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:39:46Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Knowledge Tracing (KT) diagnoses students' concept mastery through continuous learning state monitoring in education.Existing methods primarily focus on studying behavioral sequences based on ID or textual information.While existing methods rely on ID-based sequences or shallow textual features, they often fail to capture (1) the hierarchical evolution of cognitive states and (2) individualized problem difficulty perception due to limited semantic modeling. Therefore, this paper proposes a Large Language Model Hyperbolic Aligned Knowledge Tracing(L-HAKT). First, the teacher agent deeply parses question semantics and explicitly constructs hierarchical dependencies of knowledge points; the student agent simulates learning behaviors to generate synthetic data. Then, contrastive learning is performed between synthetic and real data in hyperbolic space to reduce distribution differences in key features such as question difficulty and forgetting patterns. Finally, by optimizing hyperbolic curvature, we explicitly model the tree-like hierarchical structure of knowledge points, precisely characterizing differences in learning curve morphology for knowledge points at different levels. Extensive experiments on four real-world educational datasets validate the effectiveness of our Large Language Model Hyperbolic Aligned Knowledge Tracing (L-HAKT) framework."},{"descriptionType":"Other","description":"9 pages, 6 figures, Accepted to AAAI 2026"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.22879","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T02:57:00Z","registered":"2026-02-27T02:57:01Z","published":null,"updated":"2026-02-27T02:57:01Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.22871","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.22871","identifiers":[{"identifier":"2602.22871","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Roy","familyName":"Miles","name":"Miles, Roy","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Aysim","familyName":"Toker","name":"Toker, Aysim","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Andreea-Maria","familyName":"Oncescu","name":"Oncescu, Andreea-Maria","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Songcen","familyName":"Xu","name":"Xu, Songcen","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jiankang","familyName":"Deng","name":"Deng, Jiankang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ismail","familyName":"Elezi","name":"Elezi, Ismail","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Test-Time Scaling with Diffusion Language Models via Reward-Guided Stitching"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-26T11:08:39Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:39:11Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Reasoning with large language models often benefits from generating multiple chains-of-thought, but existing aggregation strategies are typically trajectory-level (e.g., selecting the best trace or voting on the final answer), discarding useful intermediate work from partial or \"nearly correct\" attempts. We propose Stitching Noisy Diffusion Thoughts, a self-consistency framework that turns cheap diffusion-sampled reasoning into a reusable pool of step-level candidates. Given a problem, we (i) sample many diverse, low-cost reasoning trajectories using a masked diffusion language model, (ii) score every intermediate step with an off-the-shelf process reward model (PRM), and (iii) stitch these highest-quality steps across trajectories into a composite rationale. This rationale then conditions an autoregressive (AR) model (solver) to recompute only the final answer. This modular pipeline separates exploration (diffusion) from evaluation and solution synthesis, avoiding monolithic unified hybrids while preserving broad search. Across math reasoning benchmarks, we find that step-level recombination is most beneficial on harder problems, and ablations highlight the importance of the final AR solver in converting stitched but imperfect rationales into accurate answers. Using low-confidence diffusion sampling with parallel, independent rollouts, our training-free framework improves average accuracy by up to 23.8% across six math and coding tasks. At the same time, it achieves up to a 1.8x latency reduction relative to both traditional diffusion models (e.g., Dream, LLaDA) and unified architectures (e.g., TiDAR). Code is available at https://github.com/roymiles/diffusion-stitching."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.22871","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T02:56:49Z","registered":"2026-02-27T02:56:50Z","published":null,"updated":"2026-02-27T02:56:50Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.22869","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.22869","identifiers":[{"identifier":"2602.22869","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Hafiz","familyName":"Sami-Ur-Rehman","name":"Sami-Ur-Rehman, Hafiz","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Arpana","familyName":"Singh","name":"Singh, Arpana","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Nunzia","familyName":"Coppola","name":"Coppola, Nunzia","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Pierpaolo","familyName":"Polverino","name":"Polverino, Pierpaolo","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Sandeep Kumar","familyName":"Chaluvadi","name":"Chaluvadi, Sandeep Kumar","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Shyni","familyName":"Punathum-Chalil","name":"Punathum-Chalil, Shyni","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Heinrich-Christoph","familyName":"Neitzert","name":"Neitzert, Heinrich-Christoph","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Diana","familyName":"Sannino","name":"Sannino, Diana","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Pasquale","familyName":"Orgiani","name":"Orgiani, Pasquale","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Alice","familyName":"Galdi","name":"Galdi, Alice","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Cesare","familyName":"Pianese","name":"Pianese, Cesare","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Paolo","familyName":"Barone","name":"Barone, Paolo","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Carmela","familyName":"Aruta","name":"Aruta, Carmela","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Luigi","familyName":"Maritato","name":"Maritato, Luigi","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Substrate induced optimization of the Electrocatalytic Hydrogen Evolution Reaction (HER) performances of MoS2 thin film"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Materials Science (cond-mat.mtrl-sci)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-26T11:08:24Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:39:10Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Molybdenum disulfide (MoS2) has emerged as a promising, cost-effective catalyst for hydrogen production via water splitting. We investigate the structural and electrocatalytic properties of MoS2 thin films deposited on different substrates (Al2O3, SiC, STO) to study their hydrogen evolution reaction (HER) activity. In particular, in order to study the substrate influence on the stabilization of different polymorphic MoS2 phases, the films are synthesised using pulsed laser deposition on substrates with different crystal symmetries and lattice parameters. All the deposited samples are characterized by X-Ray Diffraction, Raman Spectroscopy, Linear Sweep Voltammetry and Electrochemical Impedance Spectroscopy analyses. The films grown on Al2O3 substrates exhibit the best HER performance, likely due to the stabilization of the metastable 1T phase through the interfacial interactions between film and substrate. Presence of the 1T phase in the samples grown on Al2O3 improves the charge transfer efficiency and the electrochemically active surface with a better response to the applied potential, demonstrating their enhanced catalytic behaviour for hydrogen evolution."},{"descriptionType":"Other","description":"21 pages, 8 figures"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.22869","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T02:56:46Z","registered":"2026-02-27T02:56:47Z","published":null,"updated":"2026-02-27T02:56:47Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.22862","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.22862","identifiers":[{"identifier":"2602.22862","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Enda","familyName":"Xiang","name":"Xiang, Enda","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Haoxiang","familyName":"Ma","name":"Ma, Haoxiang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xinzhu","familyName":"Ma","name":"Ma, Xinzhu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zicheng","familyName":"Liu","name":"Liu, Zicheng","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Di","familyName":"Huang","name":"Huang, Di","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"GraspLDP: Towards Generalizable Grasping Policy via Latent Diffusion"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Robotics (cs.RO)","lang":"en","subjectScheme":"arXiv"},{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-26T10:56:01Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:38:42Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"This paper focuses on enhancing the grasping precision and generalization of manipulation policies learned via imitation learning. Diffusion-based policy learning methods have recently become the mainstream approach for robotic manipulation tasks. As grasping is a critical subtask in manipulation, the ability of imitation-learned policies to execute precise and generalizable grasps merits particular attention. Existing imitation learning techniques for grasping often suffer from imprecise grasp executions, limited spatial generalization, and poor object generalization. To address these challenges, we incorporate grasp prior knowledge into the diffusion policy framework. In particular, we employ a latent diffusion policy to guide action chunk decoding with grasp pose prior, ensuring that generated motion trajectories adhere closely to feasible grasp configurations. Furthermore, we introduce a self-supervised reconstruction objective during diffusion to embed the graspness prior: at each reverse diffusion step, we reconstruct wrist-camera images back-projected the graspness from the intermediate representations. Both simulation and real robot experiments demonstrate that our approach significantly outperforms baseline methods and exhibits strong dynamic grasping capabilities."},{"descriptionType":"Other","description":"Accepted to CVPR 2026"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.22862","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T02:56:36Z","registered":"2026-02-27T02:56:37Z","published":null,"updated":"2026-02-27T02:56:37Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.22858","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.22858","identifiers":[{"identifier":"2602.22858","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Shoto","familyName":"Aoki","name":"Aoki, Shoto","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Hajime","familyName":"Fujita","name":"Fujita, Hajime","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Hidenori","familyName":"Fukaya","name":"Fukaya, Hidenori","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Mikio","familyName":"Furuta","name":"Furuta, Mikio","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Shinichiroh","familyName":"Matsuo","name":"Matsuo, Shinichiroh","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Tetsuya","familyName":"Onogi","name":"Onogi, Tetsuya","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Satoshi","familyName":"Yamaguchi","name":"Yamaguchi, Satoshi","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Generalization of lattice Dirac operator index"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"High Energy Physics - Lattice (hep-lat)","lang":"en","subjectScheme":"arXiv"},{"subject":"High Energy Physics - Theory (hep-th)","lang":"en","subjectScheme":"arXiv"},{"subject":"Differential Geometry (math.DG)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-26T10:51:56Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:38:33Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"We provide a comprehensive lattice formulation of various types of the Dirac operator indices, employing $K$-theory to classify the Wilson Dirac operator via its spectral flow. In contrast to the index of the overlap Dirac operator defined through the Ginsparg-Wilson relation, which is restricted to flat tori in even dimensions, our formulation offers several key advantages: 1) It can be applied straightforwardly to the Atiyah-Patodi-Singer index for manifolds with boundary. 2) The boundary can be curved, allowing for the inclusion of gravitational background effects. 3) The mod-2 index in both even and odd dimensions can be defined as a natural extension of the same formulation. In this talk, we present the mathematical proof and provide numerical evidence supporting the formulation."},{"descriptionType":"Other","description":"10 pages, 3 figures, Talk presented at the 42nd International Symposium on Lattice Field Theory (LATTICE2025), 2-8 November 2025, Tata Institute of Fundamental Research, Mumbai, India"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.22858","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T02:56:31Z","registered":"2026-02-27T02:56:31Z","published":null,"updated":"2026-02-27T02:56:31Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.22856","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.22856","identifiers":[{"identifier":"2602.22856","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Peter","familyName":"Borg","name":"Borg, Peter","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yair","familyName":"Caro","name":"Caro, Yair","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Results on three problems on isolation of graphs"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Combinatorics (math.CO)","lang":"en","subjectScheme":"arXiv"},{"subject":"Computational Complexity (cs.CC)","lang":"en","subjectScheme":"arXiv"},{"subject":"Discrete Mathematics (cs.DM)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"05C35, 05C69, 03D15, 68Q17","lang":"en","subjectScheme":"MSC"}],"contributors":[],"dates":[{"date":"2026-02-26T10:49:59Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:38:31Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"The graph isolation problem was introduced by Caro and Hansberg in 2015. It is a vast generalization of the classical graph domination problem and its study is expanding rapidly. In this paper, we address a number of questions that arise naturally. Let $F$ be a graph. We show that the $F$-isolating set problem is NP-complete if $F$ is connected. We investigate how the $F$-isolation number $ι(G,F)$ of a graph $G$ is affected by the minimum degree $d$ of $G$, establishing a bounded range, in terms of $d$ and the orders of $F$ and $G$, for the largest possible value of $ι(G,F)$ with $d$ sufficiently large. We also investigate how close $ι(G,tF)$ is to $ι(G,F)$, using domination and, in suitable cases, the Erdos-Posa property."},{"descriptionType":"Other","description":"12 pages"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.22856","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T02:56:28Z","registered":"2026-02-27T02:56:29Z","published":null,"updated":"2026-02-27T02:56:29Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.22850","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.22850","identifiers":[{"identifier":"2602.22850","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","affiliation":["Cuiying Honors College, Lanzhou University, Lanzhou, Gansu, China","School of Mathematics and Statistics, Lanzhou University, Lanzhou, Gansu, China"],"givenName":"Yi","familyName":"He","name":"He, Yi","nameIdentifiers":[]},{"nameType":"Personal","affiliation":["School of Management, Lanzhou University, Lanzhou, Gansu, China"],"givenName":"Yina","familyName":"Cao","name":"Cao, Yina","nameIdentifiers":[]},{"nameType":"Personal","affiliation":["Shanghai Innovation Institute, Shanghai, China","School of Mathematics and Statistics, Lanzhou University, Lanzhou, Gansu, China"],"givenName":"Jixiu","familyName":"Zhai","name":"Zhai, Jixiu","nameIdentifiers":[]},{"nameType":"Personal","affiliation":["Cuiying Honors College, Lanzhou University, Lanzhou, Gansu, China","School of Mathematics and Statistics, Lanzhou University, Lanzhou, Gansu, China"],"givenName":"Di","familyName":"Wang","name":"Wang, Di","nameIdentifiers":[]},{"nameType":"Personal","affiliation":["School of Mathematics and Statistics, Lanzhou University, Lanzhou, Gansu, China"],"givenName":"Junxiao","familyName":"Kong","name":"Kong, Junxiao","nameIdentifiers":[]},{"nameType":"Personal","affiliation":["School of Mathematics and Statistics, Lanzhou University, Lanzhou, Gansu, China","Department of Computer Science, City University of Hong Kong, Kowloon, Hong Kong, China"],"givenName":"Tianchi","familyName":"Lu","name":"Lu, Tianchi","nameIdentifiers":[]}],"titles":[{"title":"MEDNA-DFM: A Dual-View FiLM-MoE Model for Explainable DNA Methylation Prediction"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-26T10:38:41Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:38:22Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Accurate computational identification of DNA methylation is essential for understanding epigenetic regulation. Although deep learning excels in this binary classification task, its \"black-box\" nature impedes biological insight. We address this by introducing a high-performance model MEDNA-DFM, alongside mechanism-inspired signal purification algorithms. Our investigation demonstrates that MEDNA-DFM effectively captures conserved methylation patterns, achieving robust distinction across diverse species. Validation on external independent datasets confirms that the model's generalization is driven by conserved intrinsic motifs (e.g., GC content) rather than phylogenetic proximity. Furthermore, applying our developed algorithms extracted motifs with significantly higher reliability than prior studies. Finally, empirical evidence from a Drosophila 6mA case study prompted us to propose a \"sequence-structure synergy\" hypothesis, suggesting that the GAGG core motif and an upstream A-tract element function cooperatively. We further validated this hypothesis via in silico mutagenesis, confirming that the ablation of either or both elements significantly degrades the model's recognition capabilities. This work provides a powerful tool for methylation prediction and demonstrates how explainable deep learning can drive both methodological innovation and the generation of biological hypotheses."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.22850","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T02:56:19Z","registered":"2026-02-27T02:56:20Z","published":null,"updated":"2026-02-27T02:56:20Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.22843","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.22843","identifiers":[{"identifier":"2602.22843","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Chong","familyName":"Wang","name":"Wang, Chong","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yabin","familyName":"Zhang","name":"Zhang, Yabin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yunhe","familyName":"Gao","name":"Gao, Yunhe","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Maya","familyName":"Varma","name":"Varma, Maya","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Clemence","familyName":"Mottez","name":"Mottez, Clemence","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Faidra","familyName":"Patsatzi","name":"Patsatzi, Faidra","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jiaming","familyName":"Liu","name":"Liu, Jiaming","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jin","familyName":"Long","name":"Long, Jin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jean-Benoit","familyName":"Delbrouck","name":"Delbrouck, Jean-Benoit","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Sergios","familyName":"Gatidis","name":"Gatidis, Sergios","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Akshay S.","familyName":"Chaudhari","name":"Chaudhari, Akshay S.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Curtis P.","familyName":"Langlotz","name":"Langlotz, Curtis P.","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"A data- and compute-efficient chest X-ray foundation model beyond aggressive scaling"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-26T10:32:08Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:38:01Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by-nc-sa/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution Non Commercial Share Alike 4.0 International","rightsIdentifier":"cc-by-nc-sa-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Foundation models for medical imaging are typically pretrained on increasingly large datasets, following a \"scale-at-all-costs\" paradigm. However, this strategy faces two critical challenges: large-scale medical datasets often contain substantial redundancy and severe class imbalance that bias representation learning toward over-represented patterns, and indiscriminate training regardless of heterogeneity in data quality incurs considerable computational inefficiency. Here we demonstrate that active, principled data curation during pretraining can serve as a viable, cost-effective alternative to brute-force dataset enlargement. We introduce CheXficient, a chest X-ray (CXR) foundation model that selectively prioritizes informative training samples. CheXficient is pretrained on only 22.7% of 1,235,004 paired CXR images and reports while consuming under 27.3% of the total compute budget, yet achieving comparable or superior performance to its full-data counterpart and other large-scale pretrained models. We assess CheXficient across 20 individual benchmarks spanning 5 task types, including non-adapted off-the-shelf evaluations (zero-shot findings classification and crossmodal retrieval) and adapted downstream tasks (disease prediction, semantic segmentation, and radiology report generation). Further analyses show that CheXficient systematically prioritizes under-represented training samples, improving generalizability on long-tailed or rare conditions. Overall, our work offers practical insights into the data and computation demands for efficient pretraining and downstream adaptation of medical vision-language foundation models."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.22843","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T02:56:08Z","registered":"2026-02-27T02:56:09Z","published":null,"updated":"2026-02-27T02:56:09Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.22836","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.22836","identifiers":[{"identifier":"2602.22836","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Massimo","familyName":"Giannini","name":"Giannini, Massimo","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Endogenous Poverty Traps in Continuous Time: A Signaling Approach"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Theoretical Economics (econ.TH)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Economics and business","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Economics and business","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-26T10:22:41Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:37:35Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"This paper embeds a signaling friction into the continuous-time heterogeneous agent framework. A continuum of producers operate Cobb-Douglas technologies with regime-specific productivity $A_j \\in \\{A_L, A_H\\}$. Stochastic arrival of signaling opportunities and skill obsolescence risk generate an optimal stopping problem -- when to pay a lump-sum cost $ϕ$ to upgrade productivity -- whose solution yields an endogenous Skiba threshold $k^*$. Diminishing returns create a stable interior attractor in each regime; the signaling cost separates the two basins, producing a poverty trap that is an interior optimum rather than a corner solution. The stationary distribution exhibits Twin Peaks, but its decomposition by regime reveals that agents in three distinct states -- structurally trapped, waiting to signal, and successfully upgraded -- coexist at the same wealth levels with different consumption behavior and mobility prospects. Capital alone is therefore insufficient to identify an agent's position in the polarization dynamics. We show that the joint observation of a low marginal propensity to consume out of wealth and a high average propensity to consume -- a combination invisible to standard Euler equation tests -- is the diagnostic signature of the structural trap, distinguishing it from both liquidity constraints and transitory shocks."},{"descriptionType":"Other","description":"3 figures"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.22836","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T02:55:53Z","registered":"2026-02-27T02:55:54Z","published":null,"updated":"2026-02-27T02:55:54Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.22828","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.22828","identifiers":[{"identifier":"2602.22828","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Jianmin","familyName":"Li","name":"Li, Jianmin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ying","familyName":"Chang","name":"Chang, Ying","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Su-Kit","familyName":"Tang","name":"Tang, Su-Kit","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yujia","familyName":"Liu","name":"Liu, Yujia","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yanwen","familyName":"Wang","name":"Wang, Yanwen","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Shuyuan","familyName":"Lin","name":"Lin, Shuyuan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Binkai","familyName":"Ou","name":"Ou, Binkai","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"TCM-DiffRAG: Personalized Syndrome Differentiation Reasoning Method for Traditional Chinese Medicine based on Knowledge Graph and Chain of Thought"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-26T10:11:15Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:37:11Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Background: Retrieval augmented generation (RAG) technology can empower large language models (LLMs) to generate more accurate, professional, and timely responses without fine tuning. However, due to the complex reasoning processes and substantial individual differences involved in traditional Chinese medicine (TCM) clinical diagnosis and treatment, traditional RAG methods often exhibit poor performance in this domain. Objective: To address the limitations of conventional RAG approaches in TCM applications, this study aims to develop an improved RAG framework tailored to the characteristics of TCM reasoning. Methods: We developed TCM-DiffRAG, an innovative RAG framework that integrates knowledge graphs (KG) with chains of thought (CoT). TCM-DiffRAG was evaluated on three distinctive TCM test datasets. Results: The experimental results demonstrated that TCM-DiffRAG achieved significant performance improvements over native LLMs. For example, the qwen-plus model achieved scores of 0.927, 0.361, and 0.038, which were significantly enhanced to 0.952, 0.788, and 0.356 with TCM-DiffRAG. The improvements were even more pronounced for non-Chinese LLMs. Additionally, TCM-DiffRAG outperformed directly supervised fine-tuned (SFT) LLMs and other benchmark RAG methods. Conclusions: TCM-DiffRAG shows that integrating structured TCM knowledge graphs with Chain of Thought based reasoning substantially improves performance in individualized diagnostic tasks. The joint use of universal and personalized knowledge graphs enables effective alignment between general knowledge and clinical reasoning. These results highlight the potential of reasoning-aware RAG frameworks for advancing LLM applications in traditional Chinese medicine."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.22828","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T02:55:40Z","registered":"2026-02-27T02:55:41Z","published":null,"updated":"2026-02-27T02:55:41Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.22823","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.22823","identifiers":[{"identifier":"2602.22823","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Anirudh","familyName":"Thatipelli","name":"Thatipelli, Anirudh","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ali","familyName":"Siahkoohi","name":"Siahkoohi, Ali","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Hypernetwork-based approach for grid-independent functional data clustering"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-26T10:05:07Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:36:54Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Functional data clustering is concerned with grouping functions that share similar structure, yet most existing methods implicitly operate on sampled grids, causing cluster assignments to depend on resolution, sampling density, or preprocessing choices rather than on the underlying functions themselves. To address this limitation, we introduce a framework that maps discretized function observations -- at arbitrary resolution and on arbitrary grids -- into a fixed-dimensional vector space via an auto-encoding architecture. The encoder is a hypernetwork that maps coordinate-value pairs to the weight space of an implicit neural representation (INR), which serves as the decoder. Because INRs represent functions with very few parameters, this design yields compact representations that are decoupled from the sampling grid, while the hypernetwork amortizes weight prediction across the dataset. Clustering is then performed in this weight space using standard algorithms, making the approach agnostic to both the discretization and the choice of clustering method. By means of synthetic and real-world experiments in high-dimensional settings, we demonstrate competitive clustering performance that is robust to changes in sampling resolution -- including generalization to resolutions not seen during training."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.22823","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T02:55:33Z","registered":"2026-02-27T02:55:34Z","published":null,"updated":"2026-02-27T02:55:34Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.22819","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.22819","identifiers":[{"identifier":"2602.22819","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Purbayan","familyName":"Kar","name":"Kar, Purbayan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ayush","familyName":"Ghadiya","name":"Ghadiya, Ayush","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Vishal","familyName":"Chudasama","name":"Chudasama, Vishal","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Pankaj","familyName":"Wasnik","name":"Wasnik, Pankaj","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"C. V.","familyName":"Jawahar","name":"Jawahar, C. V.","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Face Time Traveller : Travel Through Ages Without Losing Identity"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-26T10:01:37Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:36:43Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Face aging, an ill-posed problem shaped by environmental and genetic factors, is vital in entertainment, forensics, and digital archiving, where realistic age transformations must preserve both identity and visual realism. However, existing works relying on numerical age representations overlook the interplay of biological and contextual cues. Despite progress in recent face aging models, they struggle with identity preservation in wide age transformations, also static attention and optimization-heavy inversion in diffusion limit adaptability, fine-grained control and background consistency. To address these challenges, we propose Face Time Traveller (FaceTT), a diffusion-based framework that achieves high-fidelity, identity-consistent age transformation. Here, we introduce a Face-Attribute-Aware Prompt Refinement strategy that encodes intrinsic (biological) and extrinsic (environmental) aging cues for context-aware conditioning. A tuning-free Angular Inversion method is proposed that efficiently maps real faces into the diffusion latent space for fast and accurate reconstruction. Moreover, an Adaptive Attention Control mechanism is introduced that dynamically balances cross-attention for semantic aging cues and self-attention for structural and identity preservation. Extensive experiments on benchmark datasets and in-the-wild testset demonstrate that FaceTT achieves superior identity retention, background preservation and aging realism over state-of-the-art (SOTA) methods."},{"descriptionType":"Other","description":"Accepted at CVPR 2026 (Findings Track)"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.22819","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T02:55:27Z","registered":"2026-02-27T02:55:27Z","published":null,"updated":"2026-02-27T02:55:27Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.22817","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.22817","identifiers":[{"identifier":"2602.22817","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Shuo","familyName":"He","name":"He, Shuo","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Lang","familyName":"Feng","name":"Feng, Lang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Qi","familyName":"Wei","name":"Wei, Qi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xin","familyName":"Cheng","name":"Cheng, Xin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Lei","familyName":"Feng","name":"Feng, Lei","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Bo","familyName":"An","name":"An, Bo","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Hierarchy-of-Groups Policy Optimization for Long-Horizon Agentic Tasks"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-26T09:58:10Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:36:30Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Group-based reinforcement learning (RL), such as GRPO, has advanced the capabilities of large language models on long-horizon agentic tasks. To enable more fine-grained policy updates, recent research has increasingly shifted toward stepwise group-based policy optimization, which treats each step in a rollout trajectory independently while using a memory module to retain historical context. However, we find a key issue in estimating stepwise relative advantages, namely context inconsistency, where steps within the same group may differ in their historical contexts. Empirically, we reveal that this issue can lead to severely biased advantage estimation, thereby degrading policy optimization significantly. To address the issue, in this paper, we propose Hierarchy-of-Groups Policy Optimization (HGPO) for long-horizon agentic tasks. Specifically, within a group of rollout trajectories, HGPO assigns each step to multiple hierarchical groups according to the consistency of historical contexts. Then, for each step, HGPO computes distinct advantages within each group and aggregates them with an adaptive weighting scheme. In this way, HGPO can achieve a favorable bias-variance trade-off in stepwise advantage estimation, without extra models or rollouts. Evaluations on two challenging agentic tasks, ALFWorld and WebShop with Qwen2.5-1.5B-Instruct and Qwen2.5-7B-Instruct, show that HGPO significantly outperforms existing agentic RL methods under the same computational constraints. Code is available at https://github.com/langfengQ/verl-agent/tree/master/recipe/hgpo."},{"descriptionType":"Other","description":"Accepted at ICLR 2026"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.22817","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":3,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T02:55:23Z","registered":"2026-02-27T02:55:24Z","published":null,"updated":"2026-02-27T02:55:24Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.22814","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.22814","identifiers":[{"identifier":"2602.22814","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Soyoung","familyName":"Jung","name":"Jung, Soyoung","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Daehoo","familyName":"Yoon","name":"Yoon, Daehoo","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Sung Gyu","familyName":"Koh","name":"Koh, Sung Gyu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Young Hwan","familyName":"Kim","name":"Kim, Young Hwan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yehan","familyName":"Ahn","name":"Ahn, Yehan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Sung","familyName":"Park","name":"Park, Sung","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"When Should an AI Act? A Human-Centered Model of Scene, Context, and Behavior for Agentic AI Design"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"Human-Computer Interaction (cs.HC)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-26T09:56:37Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:36:21Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Agentic AI increasingly intervenes proactively by inferring users' situations from contextual data yet often fails for lack of principled judgment about when, why, and whether to act. We address this gap by proposing a conceptual model that reframes behavior as an interpretive outcome integrating Scene (observable situation), Context (user-constructed meaning), and Human Behavior Factors (determinants shaping behavioral likelihood). Grounded in multidisciplinary perspectives across the humanities, social sciences, HCI, and engineering, the model separates what is observable from what is meaningful to the user and explains how the same scene can yield different behavioral meanings and outcomes. To translate this lens into design action, we derive five agent design principles (behavioral alignment, contextual sensitivity, temporal appropriateness, motivational calibration, and agency preservation) that guide intervention depth, timing, intensity, and restraint. Together, the model and principles provide a foundation for designing agentic AI systems that act with contextual sensitivity and judgment in interactions."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.22814","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T02:55:19Z","registered":"2026-02-27T02:55:19Z","published":null,"updated":"2026-02-27T02:55:19Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.22808","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.22808","identifiers":[{"identifier":"2602.22808","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Shiqian","familyName":"Su","name":"Su, Shiqian","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Sen","familyName":"Xing","name":"Xing, Sen","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xuan","familyName":"Dong","name":"Dong, Xuan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Muyan","familyName":"Zhong","name":"Zhong, Muyan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Bin","familyName":"Wang","name":"Wang, Bin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xizhou","familyName":"Zhu","name":"Zhu, Xizhou","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yuntao","familyName":"Chen","name":"Chen, Yuntao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Wenhai","familyName":"Wang","name":"Wang, Wenhai","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yue","familyName":"Deng","name":"Deng, Yue","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Pengxiang","familyName":"Zhu","name":"Zhu, Pengxiang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ziyuan","familyName":"Liu","name":"Liu, Ziyuan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Tiantong","familyName":"Li","name":"Li, Tiantong","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jiaheng","familyName":"Yu","name":"Yu, Jiaheng","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zhe","familyName":"Chen","name":"Chen, Zhe","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Lidong","familyName":"Bing","name":"Bing, Lidong","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jifeng","familyName":"Dai","name":"Dai, Jifeng","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"MiroFlow: Towards High-Performance and Robust Open-Source Agent Framework for General Deep Research Tasks"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-26T09:45:04Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:35:54Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Despite the remarkable progress of large language models (LLMs), the capabilities of standalone LLMs have begun to plateau when tackling real-world, complex tasks that require interaction with external tools and dynamic environments. Although recent agent frameworks aim to enhance model autonomy through tool integration and external interaction, they still suffer from naive workflows, unstable performance, limited support across diverse benchmarks and tasks, and heavy reliance on costly commercial APIs. In this work, we propose a high-performance and robust open-source agent framework, termed MiroFlow, which incorporates an agent graph for flexible orchestration, an optional deep reasoning mode to enhance performance, and a robust workflow execution to ensure stable and reproducible performance. Extensive experiments demonstrate that MiroFlow consistently achieves state-of-the-art performance across multiple agent benchmarks, including GAIA, BrowseComp-EN/ZH, HLE, xBench-DeepSearch, and notably FutureX. We hope it could serve as an easily accessible, reproducible, and comparable baseline for the deep research community."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.22808","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T02:55:10Z","registered":"2026-02-27T02:55:10Z","published":null,"updated":"2026-02-27T02:55:10Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.22804","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.22804","identifiers":[{"identifier":"2602.22804","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Sakshi","familyName":"Aggarwal","name":"Aggarwal, Sakshi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Mudasir","familyName":"Ganaie","name":"Ganaie, Mudasir","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Mukesh","familyName":"Saini","name":"Saini, Mukesh","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Communication-Guided Multi-Mutation Differential Evolution for Crop Model Calibration"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Neural and Evolutionary Computing (cs.NE)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-26T09:40:58Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:35:46Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"In this paper, we propose a multi-mutation optimization algorithm, Differential Evolution with Multi-Mutation Operator-Guided Communication (DE-MMOGC), implemented to improve the performance and convergence abilities of standard differential evolution in uncertain environments. DE-MMOGC introduces a communication-guided scheme integrated with multiple mutation operators to encourage exploration and avoid premature convergence. Along with this, it includes a dynamic operator selection mechanism to use the best-performing operator over successive generations. To assimilate real-world uncertainties and missing observations into the predictive model, the proposed algorithm is combined with the Ensemble Kalman Filter. To evaluate the efficacy of the proposed DE-MMOGC in uncertain systems, the unified framework is applied to improve the predictive accuracy of crop simulation models. These simulation models are essential to precision agriculture, as they make it easier to estimate crop growth in a variety of unpredictable weather scenarios. Additionally, precisely calibrating these models raises a challenge due to missing observations. Hence, the simplified WOFOST crop simulation model is incorporated in this study for leaf area index (LAI)-based crop yield estimation. DE-MMOGC enhances the WOFOST performance by optimizing crucial weather parameters (temperature and rainfall), since these parameters are highly uncertain across different crop varieties, such as wheat, rice, and cotton. The experimental study shows that DE-MMOGC outperforms the traditional evolutionary optimizers and achieves better correlation with real LAI values. We found that DE-MMOGC is a resilient solution for crop monitoring."},{"descriptionType":"Other","description":"Submitted to Special Issue on Learning-assisted Swarm Intelligence and Evolutionary Computation: Theories, Algorithms, and Applications of IEEE Transactions on Evolutionary Computation"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.22804","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T02:55:04Z","registered":"2026-02-27T02:55:04Z","published":null,"updated":"2026-02-27T02:55:04Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.22786","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.22786","identifiers":[{"identifier":"2602.22786","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Yuanjun","familyName":"Li","name":"Li, Yuanjun","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Bin","familyName":"Zhang","name":"Zhang, Bin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Hao","familyName":"Chen","name":"Chen, Hao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zhouyang","familyName":"Jiang","name":"Jiang, Zhouyang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Dapeng","familyName":"Li","name":"Li, Dapeng","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zhiwei","familyName":"Xu","name":"Xu, Zhiwei","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"QSIM: Mitigating Overestimation in Multi-Agent Reinforcement Learning via Action Similarity Weighted Q-Learning"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Multiagent Systems (cs.MA)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-26T09:20:46Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:34:51Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Value decomposition (VD) methods have achieved remarkable success in cooperative multi-agent reinforcement learning (MARL). However, their reliance on the max operator for temporal-difference (TD) target calculation leads to systematic Q-value overestimation. This issue is particularly severe in MARL due to the combinatorial explosion of the joint action space, which often results in unstable learning and suboptimal policies. To address this problem, we propose QSIM, a similarity weighted Q-learning framework that reconstructs the TD target using action similarity. Instead of using the greedy joint action directly, QSIM forms a similarity weighted expectation over a structured near-greedy joint action space. This formulation allows the target to integrate Q-values from diverse yet behaviorally related actions while assigning greater influence to those that are more similar to the greedy choice. By smoothing the target with structurally relevant alternatives, QSIM effectively mitigates overestimation and improves learning stability. Extensive experiments demonstrate that QSIM can be seamlessly integrated with various VD methods, consistently yielding superior performance and stability compared to the original algorithms. Furthermore, empirical analysis confirms that QSIM significantly mitigates the systematic value overestimation in MARL. Code is available at https://github.com/MaoMaoLYJ/pymarl-qsim."},{"descriptionType":"Other","description":"19 pages, 15 figures, 7tables. Accepted to the 36th International Conference on Automated Planning and Scheduling (ICAPS 2026)"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.22786","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T02:54:36Z","registered":"2026-02-27T02:54:36Z","published":null,"updated":"2026-02-27T02:54:36Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.22775","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.22775","identifiers":[{"identifier":"2602.22775","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Joydeep","familyName":"Chandra","name":"Chandra, Joydeep","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Satyam Kumar","familyName":"Navneet","name":"Navneet, Satyam Kumar","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yong","familyName":"Zhang","name":"Zhang, Yong","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"TherapyProbe: Generating Design Knowledge for Relational Safety in Mental Health Chatbots Through Adversarial Simulation"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Human-Computer Interaction (cs.HC)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-26T09:11:34Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:34:32Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[{"relationType":"IsVersionOf","relatedIdentifier":"10.1145/3772363.3799049","relatedIdentifierType":"DOI"}],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"As mental health chatbots proliferate to address the global treatment gap, a critical question emerges: How do we design for relational safety the quality of interaction patterns that unfold across conversations rather than the correctness of individual responses? Current safety evaluations assess single-turn crisis responses, missing the therapeutic dynamics that determine whether chatbots help or harm over time. We introduce TherapyProbe, a design probe methodology that generates actionable design knowledge by systematically exploring chatbot conversation trajectories through adversarial multi-agent simulation. Using open-source models, TherapyProbe surfaces relational safety failures interaction patterns like \"validation spirals\" where chatbots progressively reinforce hopelessness, or \"empathy fatigue\" where responses become mechanical over turns. Our contribution is translating these failures into a Safety Pattern Library of 23 failure archetypes with corresponding design recommendations. We contribute: (1) a replicable methodology requiring no API costs, (2) a clinically-grounded failure taxonomy, and (3) design implications for developers, clinicians, and policymakers."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.22775","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":1,"created":"2026-02-27T02:54:20Z","registered":"2026-02-27T02:54:21Z","published":null,"updated":"2026-02-27T02:54:21Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.22774","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.22774","identifiers":[{"identifier":"2602.22774","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Maryam","familyName":"Ansarifard","name":"Ansarifard, Maryam","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Mohit K.","familyName":"Sharma","name":"Sharma, Mohit K.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Kishor C.","familyName":"Joshi","name":"Joshi, Kishor C.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"George","familyName":"Exarchakos","name":"Exarchakos, George","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Transformer Actor-Critic for Efficient Freshness-Aware Resource Allocation"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Systems and Control (eess.SY)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Electrical engineering, electronic engineering, information engineering","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Electrical engineering, electronic engineering, information engineering","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-26T09:10:43Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:34:31Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Emerging applications such as autonomous driving and industrial automation demand ultra-reliable and low-latency communication (URLLC), where maintaining fresh and timely information is critical. A key performance metric in such systems is the age of information (AoI). This paper addresses AoI minimization in a multi-user uplink wireless network using non-orthogonal multiple access (NOMA), where users offload tasks to a base station. The system must handle user heterogeneity in task sizes, AoI thresholds, and penalty sensitivities, while adhering to NOMA constraints on user scheduling. We propose a deep reinforcement learning (DRL) framework based on proximal policy optimization (PPO), enhanced with a Transformer encoder. The attention mechanism allows the agent to focus on critical user states and capture inter-user dependencies, improving policy performance and scalability. Extensive simulations show that our method reduces average AoI compared to baselines. We also analyze the evolution of attention weights during training and observe that the model progressively learns to prioritize high-importance users. Attention maps reveal meaningful structure: early-stage policies exhibit uniform attention, while later stages show focused patterns aligned with user priority and NOMA constraints. These results highlight the promise of attention-driven DRL for intelligent, priority-aware resource allocation in next-generation wireless systems."},{"descriptionType":"Other","description":"\\c{opyright} 2026 IEEE. Personal use of this material is permitted. Permission from IEEE must be obtained for all other uses. Accepted for publication in the 2026 IEEE International Conference on Machine Learning for Communication and Networking (ICMLCN)"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.22774","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T02:54:19Z","registered":"2026-02-27T02:54:19Z","published":null,"updated":"2026-02-27T02:54:19Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.22764","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.22764","identifiers":[{"identifier":"2602.22764","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Jiahong","familyName":"Xiang","name":"Xiang, Jiahong","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Wenxiao","familyName":"He","name":"He, Wenxiao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xihua","familyName":"Wang","name":"Wang, Xihua","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Hongliang","familyName":"Tian","name":"Tian, Hongliang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yuqun","familyName":"Zhang","name":"Zhang, Yuqun","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Evaluating and Improving Automated Repository-Level Rust Issue Resolution with LLM-based Agents"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Software Engineering (cs.SE)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-26T08:54:09Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:33:46Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[{"relationType":"IsVersionOf","relatedIdentifier":"10.1145/3744916.3773108","relatedIdentifierType":"DOI"}],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"The Rust programming language presents a steep learning curve and significant coding challenges, making the automation of issue resolution essential for its broader adoption. Recently, LLM-powered code agents have shown remarkable success in resolving complex software engineering tasks, yet their application to Rust has been limited by the absence of a large-scale, repository-level benchmark. To bridge this gap, we introduce Rust-SWE-bench, a benchmark comprising 500 real-world, repository-level software engineering tasks from 34 diverse and popular Rust repositories. We then perform a comprehensive study on Rust-SWE-bench with four representative agents and four state-of-the-art LLMs to establish a foundational understanding of their capabilities and limitations in the Rust ecosystem. Our extensive study reveals that while ReAct-style agents are promising, i.e., resolving up to 21.2% of issues, they are limited by two primary challenges: comprehending repository-wide code structure and complying with Rust's strict type and trait semantics. We also find that issue reproduction is rather critical for task resolution. Inspired by these findings, we propose RUSTFORGER, a novel agentic approach that integrates an automated test environment setup with a Rust metaprogramming-driven dynamic tracing strategy to facilitate reliable issue reproduction and dynamic analysis. The evaluation shows that RUSTFORGER using Claude-Sonnet-3.7 significantly outperforms all baselines, resolving 28.6% of tasks on Rust-SWE-bench, i.e., a 34.9% improvement over the strongest baseline, and, in aggregate, uniquely solves 46 tasks that no other agent could solve across all adopted advanced LLMs."},{"descriptionType":"Other","description":"Accepted to the 48th International Conference on Software Engineering (ICSE 2026)"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.22764","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":1,"created":"2026-02-27T02:54:05Z","registered":"2026-02-27T02:54:05Z","published":null,"updated":"2026-02-27T02:54:05Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.22760","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.22760","identifiers":[{"identifier":"2602.22760","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Philipp","familyName":"Wiesner","name":"Wiesner, Philipp","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Soeren","familyName":"Becker","name":"Becker, Soeren","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Brett","familyName":"Cornick","name":"Cornick, Brett","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Dominik","familyName":"Scheinert","name":"Scheinert, Dominik","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Alexander","familyName":"Acker","name":"Acker, Alexander","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Odej","familyName":"Kao","name":"Kao, Odej","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Distributed LLM Pretraining During Renewable Curtailment Windows: A Feasibility Study"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Distributed, Parallel, and Cluster Computing (cs.DC)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-26T08:49:57Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:33:30Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Training large language models (LLMs) requires substantial compute and energy. At the same time, renewable energy sources regularly produce more electricity than the grid can absorb, leading to curtailment, the deliberate reduction of clean generation that would otherwise go to waste. These periods represent an opportunity: if training is aligned with curtailment windows, LLMs can be pretrained using electricity that is both clean and cheap. This technical report presents a system that performs full-parameter LLM training across geo-distributed GPU clusters during regional curtailment windows, elastically switching between local single-site training and federated multi-site synchronization as sites become available or unavailable. Our prototype trains a 561M-parameter transformer model across three clusters using the Flower federated learning framework, with curtailment periods derived from real-world marginal carbon intensity traces. Preliminary results show that curtailment-aware scheduling preserves training quality while reducing operational emissions to 5-12% of single-site baselines."},{"descriptionType":"Other","description":"Technical report"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.22760","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T02:53:59Z","registered":"2026-02-27T02:53:59Z","published":null,"updated":"2026-02-27T02:53:59Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.22759","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.22759","identifiers":[{"identifier":"2602.22759","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Yuan-Chih","familyName":"Chen","name":"Chen, Yuan-Chih","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Chun-Shien","familyName":"Lu","name":"Lu, Chun-Shien","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Beyond Detection: Multi-Scale Hidden-Code for Natural Image Deepfake Recovery and Factual Retrieval"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-26T08:47:48Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:33:17Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Recent advances in image authenticity have primarily focused on deepfake detection and localization, leaving recovery of tampered contents for factual retrieval relatively underexplored. We propose a unified hidden-code recovery framework that enables both retrieval and restoration from post-hoc and in-generation watermarking paradigms. Our method encodes semantic and perceptual information into a compact hidden-code representation, refined through multi-scale vector quantization, and enhances contextual reasoning via conditional Transformer modules. To enable systematic evaluation for natural images, we construct ImageNet-S, a benchmark that provides paired image-label factual retrieval tasks. Extensive experiments on ImageNet-S demonstrate that our method exhibits promising retrieval and reconstruction performance while remaining fully compatible with diverse watermarking pipelines. This framework establishes a foundation for general-purpose image recovery beyond detection and localization."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.22759","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T02:53:57Z","registered":"2026-02-27T02:53:58Z","published":null,"updated":"2026-02-27T02:53:58Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.22756","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.22756","identifiers":[{"identifier":"2602.22756","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Yen-Chieh","familyName":"Wu","name":"Wu, Yen-Chieh","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Cheng-Shang","familyName":"Chang","name":"Chang, Cheng-Shang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Duan-Shin","familyName":"Lee","name":"Lee, Duan-Shin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"H. Jonathan","familyName":"Chao","name":"Chao, H. Jonathan","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Dynamic Hierarchical Birkhoff-von Neumann Decomposition for All-to-All GPU Communication"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Networking and Internet Architecture (cs.NI)","lang":"en","subjectScheme":"arXiv"},{"subject":"Distributed, Parallel, and Cluster Computing (cs.DC)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-26T08:44:39Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:33:00Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"All-to-all GPU communication is a critical bottleneck in large-scale training clusters, where completion time is constrained by per-port bandwidth and can be severely impacted by traffic skew across GPUs and network interface cards (NICs). This issue is amplified by the two-tier structure of modern GPU systems, which combine fast intra-server links with much slower inter-server networks. Motivated by recent system observations that highlight the importance of traffic reshaping and hierarchy awareness, we study all-to-all scheduling from an online switching and queueing-theoretic perspective.\n We propose a dynamic hierarchical Birkhoff--von Neumann (BvN) decomposition framework tailored to two-tier GPU fabrics. At each frame boundary, traffic is first balanced within each server using simple local operations to mitigate micro-level GPU/NIC skew while preserving aggregate server-to-server demand. A hierarchical BvN decomposition is then applied at the server level and refined into GPU-level matchings, significantly reducing decomposition complexity relative to a flat GPU-level approach. By integrating this construction with the dynamic frame sizing (DFS) principle, we obtain an online scheduler with provable stability under admissible Poisson arrivals. Simulations demonstrate substantial reductions in mean frame length, particularly under server-localized hotspot traffic."},{"descriptionType":"Other","description":"This work has been submitted to the IEEE for possible publication"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.22756","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T02:53:53Z","registered":"2026-02-27T02:53:54Z","published":null,"updated":"2026-02-27T02:53:54Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.22751","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.22751","identifiers":[{"identifier":"2602.22751","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Qiannian","familyName":"Zhao","name":"Zhao, Qiannian","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Chen","familyName":"Yang","name":"Yang, Chen","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jinhao","familyName":"Jing","name":"Jing, Jinhao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yunke","familyName":"Zhang","name":"Zhang, Yunke","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xuhui","familyName":"Ren","name":"Ren, Xuhui","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Lu","familyName":"Yu","name":"Yu, Lu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Shijie","familyName":"Zhang","name":"Zhang, Shijie","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Hongzhi","familyName":"Yin","name":"Yin, Hongzhi","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Know What You Know: Metacognitive Entropy Calibration for Verifiable RL Reasoning"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-26T08:40:06Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:32:53Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Large reasoning models (LRMs) have emerged as a powerful paradigm for solving complex real-world tasks. In practice, these models are predominantly trained via Reinforcement Learning with Verifiable Rewards (RLVR), yet most existing outcome-only RLVR pipelines rely almost exclusively on a binary correctness signal and largely ignore the model's intrinsic uncertainty. We term this discrepancy the uncertainty-reward mismatch, under which high- and low-uncertainty solutions are treated equivalently, preventing the policy from \"Know What You Know\" and impeding the shift from optimizing for correct answers to optimizing effective reasoning paths. This limitation is especially critical in reasoning-centric tasks such as mathematics and question answering, where performance hinges on the quality of the model's internal reasoning process rather than mere memorization of final answers. To address this, we propose EGPO, a metacognitive entropy calibration framework that explicitly integrates intrinsic uncertainty into RLVR for enhancing LRMs. EGPO estimates per-sample uncertainty using a zero-overhead entropy proxy derived from token-level likelihoods and aligns it with extrinsic correctness through an asymmetric calibration mechanism that preserves correct reasoning while selectively regulating overconfident failures, thereby enabling stable and uncertainty-aware policy optimization. Moreover, EGPO recovers informative learning signals from otherwise degenerate group-based rollouts without modifying the verifier or reward definition. Extensive experiments across multiple benchmarks demonstrate that the proposed EGPO leads to substantial and consistent improvements in reasoning performance, establishing a principled path for advancing LRMs through metacognitive entropy calibration."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.22751","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T02:53:44Z","registered":"2026-02-27T02:53:45Z","published":null,"updated":"2026-02-27T02:53:45Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.22742","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.22742","identifiers":[{"identifier":"2602.22742","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Akihisa","familyName":"Watanabe","name":"Watanabe, Akihisa","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Qing","familyName":"Yu","name":"Yu, Qing","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Edgar","familyName":"Simo-Serra","name":"Simo-Serra, Edgar","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Kent","familyName":"Fujiwara","name":"Fujiwara, Kent","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"ProjFlow: Projection Sampling with Flow Matching for Zero-Shot Exact Spatial Motion Control"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-26T08:29:25Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:32:27Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Generating human motion with precise spatial control is a challenging problem. Existing approaches often require task-specific training or slow optimization, and enforcing hard constraints frequently disrupts motion naturalness. Building on the observation that many animation tasks can be formulated as a linear inverse problem, we introduce ProjFlow, a training-free sampler that achieves zero-shot, exact satisfaction of linear spatial constraints while preserving motion realism. Our key advance is a novel kinematics-aware metric that encodes skeletal topology. This metric allows the sampler to enforce hard constraints by distributing corrections coherently across the entire skeleton, avoiding the unnatural artifacts of naive projection. Furthermore, for sparse inputs, such as filling in long gaps between a few keyframes, we introduce a time-varying formulation using pseudo-observations that fade during sampling. Extensive experiments on representative applications, motion inpainting, and 2D-to-3D lifting, demonstrate that ProjFlow achieves exact constraint satisfaction and matches or improves realism over zero-shot baselines, while remaining competitive with training-based controllers."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.22742","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T02:53:32Z","registered":"2026-02-27T02:53:33Z","published":null,"updated":"2026-02-27T02:53:33Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.22741","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.22741","identifiers":[{"identifier":"2602.22741","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Morenikeji","familyName":"Neri","name":"Neri, Morenikeji","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Nicholas","familyName":"Pischke","name":"Pischke, Nicholas","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Thomas","familyName":"Powell","name":"Powell, Thomas","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Generalized fluctuation bounds for stochastic algorithms in the presence of compactness"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Optimization and Control (math.OC)","lang":"en","subjectScheme":"arXiv"},{"subject":"Logic (math.LO)","lang":"en","subjectScheme":"arXiv"},{"subject":"Probability (math.PR)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-26T08:29:18Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:32:26Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"We provide a convergence result for sequences of random variables taking values in a metric space that satisfy a stochastic quasi-Fejér monotonicity condition, in the context of a (local) compactness assumption. Our result is quantitative in that we derive an explicit and effective construction which, in terms of only a few moduli representing quantitative witnesses to key properties of the sequence of random variables and the underlying metric space involved, provides a metastable rate of pointwise convergence, a type of generalized fluctuation bound. That quantitative result in particular relies on the development of a finitary theory of martingales, culminating in a fully finitary Robbins-Siegmund theorem. We outline how this result particularises to the circumstances of the seminal work of Combettes and Pesquet on stochastic quasi-Fejér monotone sequences in separable Hilbert spaces, and we provide an initial application by illustrating how these results can be used to provide a metastable rate of pointwise convergence for a stochastic Krasnoselskii-Mann scheme solving a stochastic common fixed point problem for nonexpansive maps over proper Hadamard spaces. This work is set in the context of recent applications of the logic-based methodology of proof mining to probability theory, and represents its most sophisticated case study to date."},{"descriptionType":"Other","description":"52 pages"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.22741","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T02:53:30Z","registered":"2026-02-27T02:53:31Z","published":null,"updated":"2026-02-27T02:53:31Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.22735","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.22735","identifiers":[{"identifier":"2602.22735","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Yunpeng","familyName":"Bai","name":"Bai, Yunpeng","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Shengdong","familyName":"Zhao","name":"Zhao, Shengdong","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Antti","familyName":"Oulasvirta","name":"Oulasvirta, Antti","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Simulation-based Optimization for Augmented Reading"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Human-Computer Interaction (cs.HC)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-26T08:17:24Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:32:11Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Augmented reading systems aim to adapt text presentation to improve comprehension and task performance, yet existing approaches rely heavily on heuristics, opaque data-driven models, or repeated human involvement in the design loop. We propose framing augmented reading as a simulation-based optimization problem grounded in resource-rational models of human reading. These models instantiate a simulated reader that allocates limited cognitive resources, such as attention, memory, and time under task demands, enabling systematic evaluation of text user interfaces. We introduce two complementary optimization pipelines: an offline approach that explores design alternatives using simulated readers, and an online approach that personalizes reading interfaces in real time using ongoing interaction data. Together, this perspective enables adaptive, explainable, and scalable augmented reading design without relying solely on human testing."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.22735","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T02:53:22Z","registered":"2026-02-27T02:53:23Z","published":null,"updated":"2026-02-27T02:53:23Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.22724","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.22724","identifiers":[{"identifier":"2602.22724","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Tian","familyName":"Zhang","name":"Zhang, Tian","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yiwei","familyName":"Xu","name":"Xu, Yiwei","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Juan","familyName":"Wang","name":"Wang, Juan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Keyan","familyName":"Guo","name":"Guo, Keyan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xiaoyang","familyName":"Xu","name":"Xu, Xiaoyang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Bowen","familyName":"Xiao","name":"Xiao, Bowen","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Quanlong","familyName":"Guan","name":"Guan, Quanlong","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jinlin","familyName":"Fan","name":"Fan, Jinlin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jiawei","familyName":"Liu","name":"Liu, Jiawei","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zhiquan","familyName":"Liu","name":"Liu, Zhiquan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Hongxin","familyName":"Hu","name":"Hu, Hongxin","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"AgentSentry: Mitigating Indirect Prompt Injection in LLM Agents via Temporal Causal Diagnostics and Context Purification"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Cryptography and Security (cs.CR)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"D.4.6; K.6.5; I.2.7","lang":"en","subjectScheme":"ACM"}],"contributors":[],"dates":[{"date":"2026-02-26T07:59:10Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:31:21Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Large language model (LLM) agents increasingly rely on external tools and retrieval systems to autonomously complete complex tasks. However, this design exposes agents to indirect prompt injection (IPI), where attacker-controlled context embedded in tool outputs or retrieved content silently steers agent actions away from user intent. Unlike prompt-based attacks, IPI unfolds over multi-turn trajectories, making malicious control difficult to disentangle from legitimate task execution. Existing inference-time defenses primarily rely on heuristic detection and conservative blocking of high-risk actions, which can prematurely terminate workflows or broadly suppress tool usage under ambiguous multi-turn scenarios. We propose AgentSentry, a novel inference-time detection and mitigation framework for tool-augmented LLM agents. To the best of our knowledge, AgentSentry is the first inference-time defense to model multi-turn IPI as a temporal causal takeover. It localizes takeover points via controlled counterfactual re-executions at tool-return boundaries and enables safe continuation through causally guided context purification that removes attack-induced deviations while preserving task-relevant evidence. We evaluate AgentSentry on the \\textsc{AgentDojo} benchmark across four task suites, three IPI attack families, and multiple black-box LLMs. AgentSentry eliminates successful attacks and maintains strong utility under attack, achieving an average Utility Under Attack (UA) of 74.55 %, improving UA by 20.8 to 33.6 percentage points over the strongest baselines without degrading benign performance."},{"descriptionType":"Other","description":"23 pages, 8 figures. Under review"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.22724","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T02:53:07Z","registered":"2026-02-27T02:53:07Z","published":null,"updated":"2026-02-27T02:53:07Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.22718","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.22718","identifiers":[{"identifier":"2602.22718","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Rui","familyName":"Wei","name":"Wei, Rui","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Hanfei","familyName":"Yu","name":"Yu, Hanfei","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Shubham","familyName":"Jain","name":"Jain, Shubham","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yogarajan","familyName":"Sivakumar","name":"Sivakumar, Yogarajan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Devesh","familyName":"Tiwari","name":"Tiwari, Devesh","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jian","familyName":"Li","name":"Li, Jian","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Seung-Jong","familyName":"Park","name":"Park, Seung-Jong","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Hao","familyName":"Wang","name":"Wang, Hao","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"RLHFless: Serverless Computing for Efficient RLHF"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"Distributed, Parallel, and Cluster Computing (cs.DC)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-26T07:45:37Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:30:54Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Reinforcement Learning from Human Feedback (RLHF) has been widely applied to Large Language Model (LLM) post-training to align model outputs with human preferences. Recent models, such as DeepSeek-R1, have also shown RLHF's potential to improve LLM reasoning on complex tasks. In RL, inference and training co-exist, creating dynamic resource demands throughout the workflow. Compared to traditional RL, RLHF further challenges training efficiency due to expanding model sizes and resource consumption. Several RLHF frameworks aim to balance flexible abstraction and efficient execution. However, they rely on serverful infrastructures, which struggle with fine-grained resource variability. As a result, during synchronous RLHF training, idle time between or within RL components often causes overhead and resource wastage.\n To address these issues, we present RLHFless, the first scalable training framework for synchronous RLHF, built on serverless computing environments. RLHFless adapts to dynamic resource demands throughout the RLHF pipeline, pre-computes shared prefixes to avoid repeated computation, and uses a cost-aware actor scaling strategy that accounts for response length variation to find sweet spots with lower cost and higher speed. In addition, RLHFless assigns workloads efficiently to reduce intra-function imbalance and idle time. Experiments on both physical testbeds and a large-scale simulated cluster show that RLHFless achieves up to 1.35x speedup and 44.8% cost reduction compared to the state-of-the-art baseline."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.22718","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T02:52:58Z","registered":"2026-02-27T02:52:59Z","published":null,"updated":"2026-02-27T02:52:59Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.22716","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.22716","identifiers":[{"identifier":"2602.22716","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Guanting","familyName":"Ye","name":"Ye, Guanting","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Qiyan","familyName":"Zhao","name":"Zhao, Qiyan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Wenhao","familyName":"Yu","name":"Yu, Wenhao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Liangyu","familyName":"Yuan","name":"Yuan, Liangyu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Mingkai","familyName":"Li","name":"Li, Mingkai","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xiaofeng","familyName":"Zhang","name":"Zhang, Xiaofeng","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jianmin","familyName":"Ji","name":"Ji, Jianmin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yanyong","familyName":"Zhang","name":"Zhang, Yanyong","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Qing","familyName":"Jiang","name":"Jiang, Qing","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ka-Veng","familyName":"Yuen","name":"Yuen, Ka-Veng","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"SoPE: Spherical Coordinate-Based Positional Embedding for Enhancing Spatial Perception of 3D LVLMs"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-26T07:42:15Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:30:50Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"3D Large Vision-Language Models (3D LVLMs) built upon Large Language Models (LLMs) have achieved remarkable progress across various multimodal tasks. However, their inherited position-dependent modeling mechanism, Rotary Position Embedding (RoPE), remains suboptimal for 3D multimodal understanding. The vanilla RoPE formulation fails to preserve essential three-dimensional spatial structures when encoding 3D tokens, and its relative distance computation overlooks angular dependencies, hindering the model's ability to capture directional variations in visual representations. To overcome these limitations, we introduce Spherical Coordinate-based Positional Embedding (SoPE). Our method maps point-cloud token indices into a 3D spherical coordinate space, enabling unified modeling of spatial locations and directional angles. This formulation preserves the inherent geometric structure of point-cloud data, enhances spatial awareness, and yields more consistent and expressive geometric representations for multimodal learning. In addition, we introduce a multi-scale frequency mixing strategy to fuse feature information across different frequency domains. Experimental results on multiple 3D scene benchmarks validate the effectiveness of our approach, while real-world deployment experiments further demonstrate its strong generalization capability."},{"descriptionType":"Other","description":"CVPR 2026"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.22716","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T02:52:56Z","registered":"2026-02-27T02:52:56Z","published":null,"updated":"2026-02-27T02:52:56Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.22714","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.22714","identifiers":[{"identifier":"2602.22714","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Philipp","familyName":"Schitz","name":"Schitz, Philipp","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Paolo","familyName":"Mercorelli","name":"Mercorelli, Paolo","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Johann C.","familyName":"Dauer","name":"Dauer, Johann C.","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Robust Helicopter Ship Deck Landing With Guaranteed Timing Using Shrinking-Horizon Model Predictive Control"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Robotics (cs.RO)","lang":"en","subjectScheme":"arXiv"},{"subject":"Systems and Control (eess.SY)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"FOS: Electrical engineering, electronic engineering, information engineering","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Electrical engineering, electronic engineering, information engineering","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-26T07:40:57Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:30:47Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"We present a runtime efficient algorithm for autonomous helicopter landings on moving ship decks based on Shrinking-Horizon Model Predictive Control (SHMPC). First, a suitable planning model capturing the relevant aspects of the full nonlinear helicopter dynamics is derived. Next, we use the SHMPC together with a touchdown controller stage to ensure a pre-specified maneuver time and an associated landing time window despite the presence of disturbances. A high disturbance rejection performance is achieved by designing an ancillary controller with disturbance feedback. Thus, given a target position and time, a safe landing with suitable terminal conditions is be guaranteed if the initial optimization problem is feasible. The efficacy of our approach is shown in simulation where all maneuvers achieve a high landing precision in strong winds while satisfying timing and operational constraints with maximum computation times in the millisecond range."},{"descriptionType":"Other","description":"This version was submitted to the American Control Conference 2026 and has been accepted"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.22714","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T02:52:53Z","registered":"2026-02-27T02:52:54Z","published":null,"updated":"2026-02-27T02:52:54Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.22713","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.22713","identifiers":[{"identifier":"2602.22713","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Xiang","familyName":"Yin","name":"Yin, Xiang","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Opacity in Discrete Event Systems: A Perspective and Overview"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Systems and Control (eess.SY)","lang":"en","subjectScheme":"arXiv"},{"subject":"Formal Languages and Automata Theory (cs.FL)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Electrical engineering, electronic engineering, information engineering","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Electrical engineering, electronic engineering, information engineering","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-26T07:40:51Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:30:44Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Opacity has emerged as a central confidentiality notion for information-flow security in discrete event systems (DES), capturing the requirement that an external observer (intruder) should never be able to determine with certainty whether the system is, was, or will be in a secret state. This article provides a concise, newcomer-friendly overview of opacity in DES, emphasizing core definitions and the unifying estimation viewpoint behind major opacity notions,. We summarize representative verification techniques and highlight how different observation models reshape both the problem formulation and algorithmic structure. We then review principal enforcement paradigms, ranging from opacity-enforcing supervisory control to sensor activation/information release optimization and obfuscation/editing mechanisms. Beyond finite automata, we outline how opacity has been studied in richer models such as stochastic systems, timed systems, Petri nets, and continuous/hybrid dynamics, and we briefly survey applications in robotics, location privacy, and information services. Finally, we discuss selected open challenges, including solvability under incomparable information, scalable methods beyond worst-case complexity, and opacity under intelligent or data-driven adversaries."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.22713","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T02:52:52Z","registered":"2026-02-27T02:52:52Z","published":null,"updated":"2026-02-27T02:52:52Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.22707","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.22707","identifiers":[{"identifier":"2602.22707","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Kai","familyName":"Li","name":"Li, Kai","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Shengtao","familyName":"Zheng","name":"Zheng, Shengtao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Linkun","familyName":"Xiu","name":"Xiu, Linkun","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yuze","familyName":"Sheng","name":"Sheng, Yuze","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xiao-Ping","familyName":"Zhang","name":"Zhang, Xiao-Ping","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Dongyue","familyName":"Huang","name":"Huang, Dongyue","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xinlei","familyName":"Chen","name":"Chen, Xinlei","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"SCOPE: Skeleton Graph-Based Computation-Efficient Framework for Autonomous UAV Exploration"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Robotics (cs.RO)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-26T07:31:29Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:30:19Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Autonomous exploration in unknown environments is key for mobile robots, helping them perceive, map, and make decisions in complex areas. However, current methods often rely on frequent global optimization, suffering from high computational latency and trajectory oscillation, especially on resource-constrained edge devices. To address these limitations, we propose SCOPE, a novel framework that incrementally constructs a real-time skeletal graph and introduces Implicit Unknown Region Analysis for efficient spatial reasoning. The planning layer adopts a hierarchical on-demand strategy: the Proximal Planner generates smooth, high-frequency local trajectories, while the Region-Sequence Planner is activated only when necessary to optimize global visitation order. Comparative evaluations in simulation demonstrate that SCOPE achieves competitive exploration performance comparable to state-of-the-art global planners, while reducing computational cost by an average of 86.9%. Real-world experiments further validate the system's robustness and low latency in practical scenarios."},{"descriptionType":"Other","description":"This paper has been accepted for publication in the IEEE ROBOTICS AND AUTOMATION LETTERS (RA-L). Please cite the paper using appropriate formats"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.22707","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T02:52:43Z","registered":"2026-02-27T02:52:44Z","published":null,"updated":"2026-02-27T02:52:44Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.22703","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.22703","identifiers":[{"identifier":"2602.22703","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Hao","familyName":"Yu","name":"Yu, Hao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Shuning","familyName":"Jia","name":"Jia, Shuning","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Guanghao","familyName":"Li","name":"Li, Guanghao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Wenhao","familyName":"Jiang","name":"Jiang, Wenhao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Chun","familyName":"Yuan","name":"Yuan, Chun","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Enhancing Geometric Perception in VLMs via Translator-Guided Reinforcement Learning"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-26T07:28:04Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:30:10Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Vision-language models (VLMs) often struggle with geometric reasoning due to their limited perception of fundamental diagram elements. To tackle this challenge, we introduce GeoPerceive, a benchmark comprising diagram instances paired with domain-specific language (DSL) representations, along with an efficient automatic data generation pipeline. This design enables the isolated evaluation of geometric perception independently from reasoning. To exploit the data provided by GeoPerceive for enhancing the geometric perception capabilities of VLMs, we propose GeoDPO, a translator-guided reinforcement learning (RL) framework. GeoDPO employs an NL-to-DSL translator, which is trained on synthetic pairs generated by the data engine of GeoPerceive, to bridge natural language and DSL. This translator facilitates the computation of fine-grained, DSL-level scores, which serve as reward signals in reinforcement learning. We assess GeoDPO on both in-domain and out-of-domain datasets, spanning tasks in geometric perception as well as downstream reasoning. Experimental results demonstrate that, while supervised fine-tuning (SFT) offers only marginal improvements and may even impair performance in out-of-domain scenarios, GeoDPO achieves substantial gains: $+26.5\\%$ on in-domain data, $+8.0\\%$ on out-of-domain data, and $+39.0\\%$ on downstream reasoning tasks. These findings underscore the superior performance and generalization ability of GeoDPO over SFT. All codes are released at https://github.com/Longin-Yu/GeoPerceive\n to ensure reproducibility."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.22703","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T02:52:38Z","registered":"2026-02-27T02:52:38Z","published":null,"updated":"2026-02-27T02:52:38Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.22702","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.22702","identifiers":[{"identifier":"2602.22702","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Siyu","familyName":"Jiang","name":"Jiang, Siyu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Sanshuai","familyName":"Cui","name":"Cui, Sanshuai","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Hui","familyName":"Zeng","name":"Zeng, Hui","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Knob: A Physics-Inspired Gating Interface for Interpretable and Controllable Neural Dynamics"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-26T07:25:22Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:30:04Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Existing neural network calibration methods often treat calibration as a static, post-hoc optimization task. However, this neglects the dynamic and temporal nature of real-world inference. Moreover, existing methods do not provide an intuitive interface enabling human operators to dynamically adjust model behavior under shifting conditions. In this work, we propose Knob, a framework that connects deep learning with classical control theory by mapping neural gating dynamics to a second-order mechanical system. By establishing correspondences between physical parameters -- damping ratio ($ζ$) and natural frequency ($ω_n$) -- and neural gating, we create a tunable \"safety valve\". The core mechanism employs a logit-level convex fusion, functioning as an input-adaptive temperature scaling. It tends to reduce model confidence particularly when model branches produce conflicting predictions. Furthermore, by imposing second-order dynamics (Knob-ODE), we enable a \\textit{dual-mode} inference: standard i.i.d. processing for static tasks, and state-preserving processing for continuous streams. Our framework allows operators to tune \"stability\" and \"sensitivity\" through familiar physical analogues. This paper presents an exploratory architectural interface; we focus on demonstrating the concept and validating its control-theoretic properties rather than claiming state-of-the-art calibration performance. Experiments on CIFAR-10-C validate the calibration mechanism and demonstrate that, in Continuous Mode, the gate responses are consistent with standard second-order control signatures (step settling and low-pass attenuation), paving the way for predictable human-in-the-loop tuning."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.22702","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T02:52:36Z","registered":"2026-02-27T02:52:37Z","published":null,"updated":"2026-02-27T02:52:37Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.22697","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.22697","identifiers":[{"identifier":"2602.22697","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Ning","familyName":"Gao","name":"Gao, Ning","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Wei","familyName":"Zhang","name":"Zhang, Wei","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yuqin","familyName":"Dai","name":"Dai, Yuqin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ling","familyName":"Shi","name":"Shi, Ling","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ziyin","familyName":"Wang","name":"Wang, Ziyin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yujie","familyName":"Wang","name":"Wang, Yujie","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Wei","familyName":"He","name":"He, Wei","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jinpeng","familyName":"Wang","name":"Wang, Jinpeng","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Chaozheng","familyName":"Wang","name":"Wang, Chaozheng","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Reinforcing Real-world Service Agents: Balancing Utility and Cost in Task-oriented Dialogue"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-26T07:19:57Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:29:57Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"The rapid evolution of Large Language Models (LLMs) has accelerated the transition from conversational chatbots to general agents. However, effectively balancing empathetic communication with budget-aware decision-making remains an open challenge. Since existing methods fail to capture these complex strategic trade-offs, we propose InteractCS-RL, a framework that reframes task-oriented dialogue as a multi-granularity reinforcement learning process. Specifically, we first establish a User-centric Interaction Framework to provide a high-fidelity training gym, enabling agents to dynamically explore diverse strategies with persona-driven users. Then, we introduce Cost-aware Multi-turn Policy Optimization (CMPO) with a hybrid advantage estimation strategy. By integrating generative process credits and employing a PID-Lagrangian cost controller, CMPO effectively guides the policy to explore Pareto boundary between user reward and global cost constraints. Extensive experiments on customized real business scenarios demonstrate that InteractCS-RL significantly outperform other baselines across three evaluation dimensions. Further evaluation on tool-agent-user interaction benchmarks verify InteractCS-RL robustness across diverse domains."},{"descriptionType":"Other","description":"35 pages, 8 tables, 3 figures"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.22697","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T02:52:29Z","registered":"2026-02-27T02:52:30Z","published":null,"updated":"2026-02-27T02:52:30Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.22689","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.22689","identifiers":[{"identifier":"2602.22689","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Joonsung","familyName":"Jeon","name":"Jeon, Joonsung","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Woo Jae","familyName":"Kim","name":"Kim, Woo Jae","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Suhyeon","familyName":"Ha","name":"Ha, Suhyeon","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Sooel","familyName":"Son","name":"Son, Sooel","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Sung-Eui","familyName":"Yoon","name":"Yoon, Sung-Eui","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"No Caption, No Problem: Caption-Free Membership Inference via Model-Fitted Embeddings"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"Cryptography and Security (cs.CR)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-26T07:07:11Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:29:29Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by-nc-nd/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution Non Commercial No Derivatives 4.0 International","rightsIdentifier":"cc-by-nc-nd-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Latent diffusion models have achieved remarkable success in high-fidelity text-to-image generation, but their tendency to memorize training data raises critical privacy and intellectual property concerns. Membership inference attacks (MIAs) provide a principled way to audit such memorization by determining whether a given sample was included in training. However, existing approaches assume access to ground-truth captions. This assumption fails in realistic scenarios where only images are available and their textual annotations remain undisclosed, rendering prior methods ineffective when substituted with vision-language model (VLM) captions. In this work, we propose MoFit, a caption-free MIA framework that constructs synthetic conditioning inputs that are explicitly overfitted to the target model's generative manifold. Given a query image, MoFit proceeds in two stages: (i) model-fitted surrogate optimization, where a perturbation applied to the image is optimized to construct a surrogate in regions of the model's unconditional prior learned from member samples, and (ii) surrogate-driven embedding extraction, where a model-fitted embedding is derived from the surrogate and then used as a mismatched condition for the query image. This embedding amplifies conditional loss responses for member samples while leaving hold-outs relatively less affected, thereby enhancing separability in the absence of ground-truth captions. Our comprehensive experiments across multiple datasets and diffusion models demonstrate that MoFit consistently outperforms prior VLM-conditioned baselines and achieves performance competitive with caption-dependent methods."},{"descriptionType":"Other","description":"Accepted to ICLR 2026"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.22689","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T02:52:18Z","registered":"2026-02-27T02:52:19Z","published":null,"updated":"2026-02-27T02:52:19Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.22681","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.22681","identifiers":[{"identifier":"2602.22681","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Shuchen","familyName":"Zhu","name":"Zhu, Shuchen","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Rizhen","familyName":"Hu","name":"Hu, Rizhen","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Mingze","familyName":"Wang","name":"Wang, Mingze","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Mou","familyName":"Sun","name":"Sun, Mou","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xue","familyName":"Wang","name":"Wang, Xue","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Kun","familyName":"Yuan","name":"Yuan, Kun","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zaiwen","familyName":"Wen","name":"Wen, Zaiwen","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Accelerating LLM Pre-Training through Flat-Direction Dynamics Enhancement"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-26T06:54:57Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:28:58Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Pre-training Large Language Models requires immense computational resources, making optimizer efficiency essential. The optimization landscape is highly anisotropic, with loss reduction driven predominantly by progress along flat directions. While matrix-based optimizers such as Muon and SOAP leverage fine-grained curvature information to outperform AdamW, their updates tend toward isotropy -- relatively conservative along flat directions yet potentially aggressive along sharp ones. To address this limitation, we first establish a unified Riemannian Ordinary Differential Equation (ODE) framework that elucidates how common adaptive algorithms operate synergistically: the preconditioner induces a Riemannian geometry that mitigates ill-conditioning, while momentum serves as a Riemannian damping term that promotes convergence. Guided by these insights, we propose LITE, a generalized acceleration strategy that enhances training dynamics by applying larger Hessian damping coefficients and learning rates along flat trajectories. Extensive experiments demonstrate that LITE significantly accelerates both Muon and SOAP across diverse architectures (Dense, MoE), parameter scales (130M--1.3B), datasets (C4, Pile), and learning-rate schedules (cosine, warmup-stable-decay). Theoretical analysis confirms that LITE facilitates faster convergence along flat directions in anisotropic landscapes, providing a principled approach to efficient LLM pre-training. The code is available at https://github.com/SHUCHENZHU/LITE."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.22681","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T02:52:06Z","registered":"2026-02-27T02:52:07Z","published":null,"updated":"2026-02-27T02:52:07Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.22678","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.22678","identifiers":[{"identifier":"2602.22678","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Quoc-Khang","familyName":"Tran","name":"Tran, Quoc-Khang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Minh-Thien","familyName":"Nguyen","name":"Nguyen, Minh-Thien","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Nguyen-Khang","familyName":"Pham","name":"Pham, Nguyen-Khang","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"ViCLIP-OT: The First Foundation Vision-Language Model for Vietnamese Image-Text Retrieval with Optimal Transport"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-26T06:51:25Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:28:51Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Image-text retrieval has become a fundamental component in intelligent multimedia systems; however, most existing vision-language models are optimized for highresource languages and remain suboptimal for low-resource settings such as Vietnamese. This work introduces ViCLIP-OT, a foundation vision-language model specifically designed for Vietnamese image-text retrieval. The proposed framework integrates CLIP-style contrastive learning with a Similarity-Graph Regularized Optimal Transport (SIGROT) loss to enhance global cross-modal consistency and mitigate modality gap issues. Extensive experiments on three Vietnamese benchmarks (UITOpenViIC, KTVIC, and Crossmodal-3600) demonstrate that ViCLIP-OT consistently outperforms CLIP and SigLIP baselines in both in-domain and zero-shot settings. On UIT-OpenViIC, the model achieves an average Recall@K of 67.34%, improving upon CLIP by 5.75 percentage points. In zero-shot evaluation on Crossmodal-3600, ViCLIPOT surpasses CLIP by 11.72 percentage points. Embedding-space analysis further confirms improved alignment and reduced modality gap. The results indicate that integrating SIGROT provides an effective and scalable strategy for cross-modal retrieval in low-resource languages, offering practical implications for intelligent multimedia retrieval systems in Vietnamese and other underrepresented linguistic contexts."},{"descriptionType":"Other","description":"Preprint submitted to Expert Systems with Applications"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.22678","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T02:52:02Z","registered":"2026-02-27T02:52:03Z","published":null,"updated":"2026-02-27T02:52:03Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.22670","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.22670","identifiers":[{"identifier":"2602.22670","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Zichong","familyName":"Ou","name":"Ou, Zichong","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jie","familyName":"Lu","name":"Lu, Jie","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Robust Distributed Nonconvex Optimization Enabling Communication Acceleration and Privacy Protection"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Optimization and Control (math.OC)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-26T06:39:30Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:28:25Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"This paper addresses a distributed nonconvex optimization problem over multi-agent networks, where each agent exchanges its local information solely with its neighbors. Given that most existing distributed nonconvex optimization algorithms are susceptible to information leakage during inter agent communications, we propose a Robust Proximal Primal dual algorithm, referred to as RPP, to enhance the security of information transmission. In contrast to many existing approaches that directly transmit local variables throughout the network, we introduce carefully designed random noises to obfuscate sensitive local information. This not only preserves privacy but also demonstrates the noise robustness of our proposed algorithm. We establish a sublinear rate at which RPP converges to a stationary solution. Moreover, by incorporating Chebyshev acceleration, an accelerated variant of RPP is developed and achieves the optimal communication complexity bound for the algorithms that allow for exchanging local deci sions at each iteration. The superior convergence performance of RPP is validated through a few numerical experiments, which also indicate that, within an appropriate range, the introduced perturbations do not impede the convergence speed of RPP."},{"descriptionType":"Other","description":"8 pages, 2 figures, accepted by ACC2026"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.22670","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T02:51:51Z","registered":"2026-02-27T02:51:51Z","published":null,"updated":"2026-02-27T02:51:51Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.22663","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.22663","identifiers":[{"identifier":"2602.22663","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Wenxuan","familyName":"Song","name":"Song, Wenxuan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jiayi","familyName":"Chen","name":"Chen, Jiayi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xiaoquan","familyName":"Sun","name":"Sun, Xiaoquan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Huashuo","familyName":"Lei","name":"Lei, Huashuo","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yikai","familyName":"Qin","name":"Qin, Yikai","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Wei","familyName":"Zhao","name":"Zhao, Wei","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Pengxiang","familyName":"Ding","name":"Ding, Pengxiang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Han","familyName":"Zhao","name":"Zhao, Han","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Tongxin","familyName":"Wang","name":"Wang, Tongxin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Pengxu","familyName":"Hou","name":"Hou, Pengxu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zhide","familyName":"Zhong","name":"Zhong, Zhide","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Haodong","familyName":"Yan","name":"Yan, Haodong","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Donglin","familyName":"Wang","name":"Wang, Donglin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jun","familyName":"Ma","name":"Ma, Jun","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Haoang","familyName":"Li","name":"Li, Haoang","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Rethinking the Practicality of Vision-language-action Model: A Comprehensive Benchmark and An Improved Baseline"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Robotics (cs.RO)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-26T06:27:37Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:27:52Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Vision-Language-Action (VLA) models have emerged as a generalist robotic agent. However, existing VLAs are hindered by excessive parameter scales, prohibitive pre-training requirements, and limited applicability to diverse embodiments. To improve the practicality of VLAs, we propose a comprehensive benchmark and an improved baseline. First, we propose CEBench, a new benchmark spanning diverse embodiments in both simulation and the real world with consideration of domain randomization. We collect 14.4k simulated trajectories and 1.6k real-world expert-curated trajectories to support training on CEBench. Second, using CEBench as our testbed, we study three critical aspects of VLAs' practicality and offer several key findings. Informed by these findings, we introduce LLaVA-VLA, a lightweight yet powerful VLA designed for practical deployment on consumer-grade GPUs. Architecturally, it integrates a compact VLM backbone with multi-view perception, proprioceptive tokenization, and action chunking. To eliminate reliance on costly pre-training, LLaVA-VLA adopts a two-stage training paradigm including post-training and fine-tuning. Furthermore, LLaVA-VLA extends the action space to unify navigation and manipulation. Experiments across embodiments demonstrate the capabilities of generalization and versatility of LLaVA-VLA , while real-world mobile manipulation experiments establish it as the first end-to-end VLA model for mobile manipulation. We will open-source all datasets, codes, and checkpoints upon acceptance to foster reproducibility and future research."},{"descriptionType":"Other","description":"Accepted by ICRA 2026"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.22663","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T02:51:41Z","registered":"2026-02-27T02:51:41Z","published":null,"updated":"2026-02-27T02:51:41Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.22659","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.22659","identifiers":[{"identifier":"2602.22659","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Renyu","familyName":"Yang","name":"Yang, Renyu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jian","familyName":"Jin","name":"Jin, Jian","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Lili","familyName":"Meng","name":"Meng, Lili","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Meiqin","familyName":"Liu","name":"Liu, Meiqin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yilin","familyName":"Wang","name":"Wang, Yilin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Balu","familyName":"Adsumilli","name":"Adsumilli, Balu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Weisi","familyName":"Lin","name":"Lin, Weisi","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Scaling Audio-Visual Quality Assessment Dataset via Crowdsourcing"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"Multimedia (cs.MM)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-26T06:18:11Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:26:58Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Audio-visual quality assessment (AVQA) research has been stalled by limitations of existing datasets: they are typically small in scale, with insufficient diversity in content and quality, and annotated only with overall scores. These shortcomings provide limited support for model development and multimodal perception research. We propose a practical approach for AVQA dataset construction. First, we design a crowdsourced subjective experiment framework for AVQA, breaks the constraints of in-lab settings and achieves reliable annotation across varied environments. Second, a systematic data preparation strategy is further employed to ensure broad coverage of both quality levels and semantic scenarios. Third, we extend the dataset with additional annotations, enabling research on multimodal perception mechanisms and their relation to content. Finally, we validate this approach through YT-NTU-AVQ, the largest and most diverse AVQA dataset to date, consisting of 1,620 user-generated audio and video (A/V) sequences. The dataset and platform code are available at https://github.com/renyu12/YT-NTU-AVQ"},{"descriptionType":"Other","description":"Accepted to ICASSP 2026. 5 pages (main paper) + 8 pages (supplementary material)"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.22659","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T02:51:35Z","registered":"2026-02-27T02:51:35Z","published":null,"updated":"2026-02-27T02:51:35Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.22655","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.22655","identifiers":[{"identifier":"2602.22655","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Motoki","familyName":"Nakata","name":"Nakata, Motoki","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Masanori","familyName":"Nunami","name":"Nunami, Masanori","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Hideo","familyName":"Sugama","name":"Sugama, Hideo","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Tomo-Hiko","familyName":"Watanabe","name":"Watanabe, Tomo-Hiko","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Isotope Effects on TEM-driven Turbulence and Zonal Flows in Helical and Tokamak Plasmas"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Plasma Physics (physics.plasm-ph)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-26T06:13:38Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:26:51Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[{"relationType":"IsVersionOf","relatedIdentifier":"10.1103/physrevlett.118.165002","relatedIdentifierType":"DOI"}],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Impacts of isotope ion mass on trapped electron mode (TEM) driven turbulence and zonal flows in magnetically confined fusion plasmas are investigated. Gyrokinetic simulations of TEM-driven turbulence in three-dimensional magnetic configuration of LHD plasmas with hydrogen isotope ions and real-mass kinetic electrons are realized for the first time, and the linear and the nonlinear nature of the isotope and collisional effects on the turbulent transport and zonal-flow generation is clarified. It is newly found that combined effects of the collisional TEM stabilization by the isotope ions and the associated increase in the impacts of the steady zonal flows at the near-marginal linear stability lead to the significant transport reduction with the opposite ion mass dependence in comparison to the conventional gyro-Bohm scaling. The universal nature of the isotope effects on the TEM-driven turbulence and zonal flows is verified for a wide variety of toroidal plasmas, e.g., axisymmetric tokamak and non-axisymmetric helical/stellarator systems."},{"descriptionType":"Other","description":"11 pages, 5 figures"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.22655","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":1,"created":"2026-02-27T02:51:29Z","registered":"2026-02-27T02:51:30Z","published":null,"updated":"2026-02-27T02:51:30Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.22650","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.22650","identifiers":[{"identifier":"2602.22650","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Xinxin","familyName":"Yang","name":"Yang, Xinxin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yangyang","familyName":"Tang","name":"Tang, Yangyang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yikun","familyName":"Zhou","name":"Zhou, Yikun","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yaolei","familyName":"Liu","name":"Liu, Yaolei","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yun","familyName":"Li","name":"Li, Yun","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Bo","familyName":"Yang","name":"Yang, Bo","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"AHBid: An Adaptable Hierarchical Bidding Framework for Cross-Channel Advertising"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-26T06:07:28Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:26:41Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[{"relationType":"IsVersionOf","relatedIdentifier":"10.1145/3774904.3792322","relatedIdentifierType":"DOI"}],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"In online advertising, the inherent complexity and dynamic nature of advertising environments necessitate the use of auto-bidding services to assist advertisers in bid optimization. This complexity is further compounded in multi-channel scenarios, where effective allocation of budgets and constraints across channels with distinct behavioral patterns becomes critical for optimizing return on investment. Current approaches predominantly rely on either optimization-based strategies or reinforcement learning techniques. However, optimization-based methods lack flexibility in adapting to dynamic market conditions, while reinforcement learning approaches often struggle to capture essential historical dependencies and observational patterns within the constraints of Markov Decision Process frameworks. To address these limitations, we propose AHBid, an Adaptable Hierarchical Bidding framework that integrates generative planning with real-time control. The framework employs a high-level generative planner based on diffusion models to dynamically allocate budgets and constraints by effectively capturing historical context and temporal patterns. We introduce a constraint enforcement mechanism to ensure compliance with specified constraints, along with a trajectory refinement mechanism that enhances adaptability to environmental changes through the utilization of historical data. The system further incorporates a control-based bidding algorithm that synergistically combines historical knowledge with real-time information, significantly improving both adaptability and operational efficacy. Extensive experiments conducted on large-scale offline datasets and through online A/B tests demonstrate the effectiveness of AHBid, yielding a 13.57% increase in overall return compared to existing baselines."},{"descriptionType":"Other","description":"11 pages, 6 figures, accepted by WWW'2026"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.22650","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":1,"created":"2026-02-27T02:51:22Z","registered":"2026-02-27T02:51:22Z","published":null,"updated":"2026-02-27T02:51:22Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.22644","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.22644","identifiers":[{"identifier":"2602.22644","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Siqi","familyName":"Lu","name":"Lu, Siqi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Wanying","familyName":"Xu","name":"Xu, Wanying","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yongbin","familyName":"Zheng","name":"Zheng, Yongbin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Wenting","familyName":"Luan","name":"Luan, Wenting","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Peng","familyName":"Sun","name":"Sun, Peng","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jianhang","familyName":"Yao","name":"Yao, Jianhang","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Plug, Play, and Fortify: A Low-Cost Module for Robust Multimodal Image Understanding Models"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-26T05:51:41Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:26:21Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Missing modalities present a fundamental challenge in multimodal models, often causing catastrophic performance degradation. Our observations suggest that this fragility stems from an imbalanced learning process, where the model develops an implicit preference for certain modalities, leading to the under-optimization of others. We propose a simple yet efficient method to address this challenge. The central insight of our work is that the dominance relationship between modalities can be effectively discerned and quantified in the frequency domain. To leverage this principle, we first introduce a Frequency Ratio Metric (FRM) to quantify modality preference by analyzing features in the frequency domain. Guided by FRM, we then propose a Multimodal Weight Allocation Module, a plug-and-play component that dynamically re-balances the contribution of each branch during training, promoting a more holistic learning paradigm. Extensive experiments demonstrate that MWAM can be seamlessly integrated into diverse architectural backbones, such as those based on CNNs and ViTs. Furthermore, MWAM delivers consistent performance gains across a wide range of tasks and modality combinations. This advancement extends beyond merely optimizing the performance of the base model; it also manifests as further performance improvements to state-of-the-art methods addressing the missing modality problem."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.22644","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T02:51:13Z","registered":"2026-02-27T02:51:14Z","published":null,"updated":"2026-02-27T02:51:14Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.22640","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.22640","identifiers":[{"identifier":"2602.22640","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Xintong","familyName":"Wang","name":"Wang, Xintong","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Liang","familyName":"Chen","name":"Chen, Liang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yu-Hong","familyName":"Dai","name":"Dai, Yu-Hong","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Efficient exact sequential lifting algorithm for binary knapsack set"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Optimization and Control (math.OC)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-26T05:43:56Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:26:03Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by-nc-nd/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution Non Commercial No Derivatives 4.0 International","rightsIdentifier":"cc-by-nc-nd-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Lifting is a crucial technique in mixed integer programming (MIP) for generating strong valid inequalities, which serve as cutting planes to improve the branch-and-cut algorithm. We first propose an exact sequential lifting algorithm for the binary knapsack set, which employs the dominance list structure to remove redundant storage and computation in the dynamic programming (DP) array. This structure preserves scale invariance and effectively handles constraints with non-integer coefficients. Then, a reduction method is developed for the lifting procedure under some conditions, further enhancing computational efficiency. Finally, numerical experiments demonstrate that the proposed algorithm outperforms DP with arrays in terms of both efficiency and stability, particularly for large-scale and large-capacity instances. Moreover, it enables exact sequential lifting for binary knapsack sets with non-integer weights and large capacities, making it directly applicable in modern MIP solvers."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.22640","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T02:51:08Z","registered":"2026-02-27T02:51:08Z","published":null,"updated":"2026-02-27T02:51:08Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.22633","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.22633","identifiers":[{"identifier":"2602.22633","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Ruichen","familyName":"Xu","name":"Xu, Ruichen","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ying-Jun Angela","familyName":"Zhang","name":"Zhang, Ying-Jun Angela","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jianwei","familyName":"Huang","name":"Huang, Jianwei","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Tackling Privacy Heterogeneity in Differentially Private Federated Learning"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"Distributed, Parallel, and Cluster Computing (cs.DC)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-26T05:20:37Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:25:10Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Differentially private federated learning (DP-FL) enables clients to collaboratively train machine learning models while preserving the privacy of their local data. However, most existing DP-FL approaches assume that all clients share a uniform privacy budget, an assumption that does not hold in real-world scenarios where privacy requirements vary widely. This privacy heterogeneity poses a significant challenge: conventional client selection strategies, which typically rely on data quantity, cannot distinguish between clients providing high-quality updates and those introducing substantial noise due to strict privacy constraints. To address this gap, we present the first systematic study of privacy-aware client selection in DP-FL. We establish a theoretical foundation by deriving a convergence analysis that quantifies the impact of privacy heterogeneity on training error. Building on this analysis, we propose a privacy-aware client selection strategy, formulated as a convex optimization problem, that adaptively adjusts selection probabilities to minimize training error. Extensive experiments on benchmark datasets demonstrate that our approach achieves up to a 10% improvement in test accuracy on CIFAR-10 compared to existing baselines under heterogeneous privacy budgets. These results highlight the importance of incorporating privacy heterogeneity into client selection for practical and effective federated learning."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.22633","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T02:50:57Z","registered":"2026-02-27T02:50:58Z","published":null,"updated":"2026-02-27T02:50:58Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.22618","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.22618","identifiers":[{"identifier":"2602.22618","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Mahindra","familyName":"Rautela","name":"Rautela, Mahindra","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Alexander","familyName":"Scheinker","name":"Scheinker, Alexander","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Advancing accelerator virtual beam diagnostics through latent evolution modeling: an integrated solution to forward, inverse, tuning, and UQ problems"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Accelerator Physics (physics.acc-ph)","lang":"en","subjectScheme":"arXiv"},{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-26T04:46:26Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:24:08Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[{"relationType":"IsVersionOf","relatedIdentifier":"10.18429/jacow-napac2025-mop002","relatedIdentifierType":"DOI"}],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Virtual beam diagnostics relies on computationally intensive beam dynamics simulations where high-dimensional charged particle beams evolve through the accelerator. We propose Latent Evolution Model (LEM), a hybrid machine learning framework with an autoencoder that projects high-dimensional phase spaces into lower-dimensional representations, coupled with transformers to learn temporal dynamics in the latent space. This approach provides a common foundational framework addressing multiple interconnected challenges in beam diagnostics. For \\textit{forward modeling}, a Conditional Variational Autoencoder (CVAE) encodes 15 unique projections of the 6D phase space into a latent representation, while a transformer predicts downstream latent states from upstream inputs. For \\textit{inverse problems}, we address two distinct challenges: (a) predicting upstream phase spaces from downstream observations by utilizing the same CVAE architecture with transformers trained on reversed temporal sequences along with aleatoric uncertainty quantification, and (b) estimating RF settings from the latent space of the trained LEM using a dedicated dense neural network that maps latent representations to RF parameters. For \\textit{tuning problems}, we leverage the trained LEM and RF estimator within a Bayesian optimization framework to determine optimal RF settings that minimize beam loss. This paper summarizes our recent efforts and demonstrates how this unified approach effectively addresses these traditionally separate challenges."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.22618","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":1,"created":"2026-02-27T02:50:36Z","registered":"2026-02-27T02:50:37Z","published":null,"updated":"2026-02-27T02:50:37Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.22617","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.22617","identifiers":[{"identifier":"2602.22617","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Hai","familyName":"Huang","name":"Huang, Hai","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yann","familyName":"LeCun","name":"LeCun, Yann","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Randall","familyName":"Balestriero","name":"Balestriero, Randall","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Semantic Tube Prediction: Beating LLM Data Efficiency with JEPA"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-26T04:45:07Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:24:06Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Large Language Models (LLMs) obey consistent scaling laws -- empirical power-law fits that predict how loss decreases with compute, data, and parameters. While predictive, these laws are descriptive rather than prescriptive: they characterize typical training, not optimal training. Surprisingly few works have successfully challenged the data-efficiency bounds implied by these laws -- which is our primary focus. To that end, we introduce the Geodesic Hypothesis, positing that token sequences trace geodesics on a smooth semantic manifold and are therefore locally linear. Building on this principle, we propose a novel Semantic Tube Prediction (STP) task, a JEPA-style regularizer that confines hidden-state trajectories to a tubular neighborhood of the geodesic. STP generalizes JEPA to language without requiring explicit multi-view augmentations. We show this constraint improves signal-to-noise ratio, and consequently preserves diversity by preventing trajectory collisions during inference. Empirically, STP allows LLMs to match baseline accuracy with 16$\\times$ less training data on the NL-RX-SYNTH dataset, directly violating the data term of Chinchilla-style scaling laws and demonstrating that principled geometric priors can surpass brute-force scaling. Code is available at https://github.com/galilai-group/llm-jepa#stp."},{"descriptionType":"Other","description":"21 pages, 13 figures"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.22617","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T02:50:35Z","registered":"2026-02-27T02:50:35Z","published":null,"updated":"2026-02-27T02:50:35Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.22613","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.22613","identifiers":[{"identifier":"2602.22613","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Minh Kha","familyName":"Do","name":"Do, Minh Kha","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Wei","familyName":"Xiang","name":"Xiang, Wei","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Kang","familyName":"Han","name":"Han, Kang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Di","familyName":"Wu","name":"Wu, Di","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Khoa","familyName":"Phan","name":"Phan, Khoa","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yi-Ping Phoebe","familyName":"Chen","name":"Chen, Yi-Ping Phoebe","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Gaowen","familyName":"Liu","name":"Liu, Gaowen","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ramana Rao","familyName":"Kompella","name":"Kompella, Ramana Rao","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Spectrally Distilled Representations Aligned with Instruction-Augmented LLMs for Satellite Imagery"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-26T04:34:47Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:23:48Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Vision-language foundation models (VLFMs) promise zero-shot and retrieval understanding for Earth observation. While operational satellite systems often lack full multi-spectral coverage, making RGB-only inference highly desirable for scalable deployment, the adoption of VLFMs for satellite imagery remains hindered by two factors: (1) multi-spectral inputs are informative but difficult to exploit consistently due to band redundancy and misalignment; and (2) CLIP-style text encoders limit semantic expressiveness and weaken fine-grained alignment. We present SATtxt, a spectrum-aware VLFM that operates with RGB inputs only at inference while retaining spectral cues learned during training. Our framework comprises two stages. First, Spectral Representation Distillation transfers spectral priors from a frozen multi-spectral teacher to an RGB student via a lightweight projector. Second, Spectrally Grounded Alignment with Instruction-Augmented LLMs bridges the distilled visual space and an expressive LLM embedding space. Across EuroSAT, BigEarthNet, and ForestNet, SATtxt improves zero-shot classification on average by 4.2%, retrieval by 5.9%, and linear probing by 2.7% over baselines, showing an efficient path toward spectrum-aware vision-language learning for Earth observation. Project page: https://ikhado.github.io/sattxt/"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.22613","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T02:50:29Z","registered":"2026-02-27T02:50:30Z","published":null,"updated":"2026-02-27T02:50:30Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.22609","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.22609","identifiers":[{"identifier":"2602.22609","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Guangyu","familyName":"Hu","name":"Hu, Guangyu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xiaofeng","familyName":"Zhou","name":"Zhou, Xiaofeng","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Wei","familyName":"Zhang","name":"Zhang, Wei","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Hongce","familyName":"Zhang","name":"Zhang, Hongce","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"EvolveGen: Algorithmic Level Hardware Model Checking Benchmark Generation through Reinforcement Learning"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Hardware Architecture (cs.AR)","lang":"en","subjectScheme":"arXiv"},{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-26T04:32:07Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:23:34Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Progress in hardware model checking depends critically on high-quality benchmarks. However, the community faces a significant benchmark gap: existing suites are limited in number, often distributed only in representations such as BTOR2 without access to the originating register-transfer-level (RTL) designs, and biased toward extreme difficulty where instances are either trivial or intractable. These limitations hinder rigorous evaluation of new verification techniques and encourage overfitting of solver heuristics to a narrow set of problems. To address this, we introduce EvolveGen, a framework for generating hardware model checking benchmarks by combining reinforcement learning (RL) with high-level synthesis (HLS). Our approach operates at an algorithmic level of abstraction in which an RL agent learns to construct computation graphs. By compiling these graphs under different synthesis directives, we produce pairs of functionally equivalent but structurally distinct hardware designs, inducing challenging model checking instances. Solver runtime is used as the reward signal, enabling the agent to autonomously discover and generate small-but-hard instances that expose solver-specific weaknesses. Experiments show that EvolveGen efficiently creates a diverse benchmark set in standard formats (e.g., AIGER and BTOR2) and effectively reveals performance bottlenecks in state-of-the-art model checkers."},{"descriptionType":"Other","description":"19 pages, 8 figures. Accepted by TACAS 2026"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.22609","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T02:50:23Z","registered":"2026-02-27T02:50:24Z","published":null,"updated":"2026-02-27T02:50:24Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.22597","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.22597","identifiers":[{"identifier":"2602.22597","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Maryam","familyName":"Maghsoudi","name":"Maghsoudi, Maryam","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Rupesh","familyName":"Chillale","name":"Chillale, Rupesh","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Shihab A.","familyName":"Shamma","name":"Shamma, Shihab A.","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Relating the Neural Representations of Vocalized, Mimed, and Imagined Speech"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Sound (cs.SD)","lang":"en","subjectScheme":"arXiv"},{"subject":"Audio and Speech Processing (eess.AS)","lang":"en","subjectScheme":"arXiv"},{"subject":"Signal Processing (eess.SP)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"FOS: Electrical engineering, electronic engineering, information engineering","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Electrical engineering, electronic engineering, information engineering","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-26T04:01:09Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:22:31Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"We investigated the relationship among neural representations of vocalized, mimed, and imagined speech recorded using publicly available stereotactic EEG recordings. Most prior studies have focused on decoding speech responses within each condition separately. Here, instead, we explore how responses across conditions relate by training linear spectrogram reconstruction models for each condition and evaluate their generalization across conditions. We demonstrate that linear decoders trained on one condition generally transfer successfully to others, implying shared speech representations. This commonality was assessed with stimulus-level discriminability by performing a rank-based analysis demonstrating preservation of stimulus-specific structure in both within- and across-conditions. Finally, we compared linear reconstructions to those from a nonlinear neural network. While both exhibited cross-condition transfer, linear models achieve superior stimulus-level discriminability."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.22597","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T02:50:06Z","registered":"2026-02-27T02:50:07Z","published":null,"updated":"2026-02-27T02:50:07Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.22592","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.22592","identifiers":[{"identifier":"2602.22592","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Wenzheng","familyName":"Zhang","name":"Zhang, Wenzheng","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Bingzheng","familyName":"Liu","name":"Liu, Bingzheng","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yang","familyName":"Hu","name":"Hu, Yang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xiaoying","familyName":"Bai","name":"Bai, Xiaoying","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Wentao","familyName":"Zhang","name":"Zhang, Wentao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Bin","familyName":"Cui","name":"Cui, Bin","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"pQuant: Towards Effective Low-Bit Language Models via Decoupled Linear Quantization-Aware Training"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-26T03:51:58Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:21:49Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Quantization-Aware Training from scratch has emerged as a promising approach for building efficient large language models (LLMs) with extremely low-bit weights (sub 2-bit), which can offer substantial advantages for edge deployment. However, existing methods still fail to achieve satisfactory accuracy and scalability. In this work, we identify a parameter democratization effect as a key bottleneck: the sensitivity of all parameters becomes homogenized, severely limiting expressivity. To address this, we propose pQuant, a method that decouples parameters by splitting linear layers into two specialized branches: a dominant 1-bit branch for efficient computation and a compact high-precision branch dedicated to preserving the most sensitive parameters. Through tailored feature scaling, we explicitly guide the model to allocate sensitive parameters to the high-precision branch. Furthermore, we extend this branch into multiple, sparsely-activated experts, enabling efficient capacity scaling. Extensive experiments indicate our pQuant achieves state-of-the-art performance in extremely low-bit quantization."},{"descriptionType":"Other","description":"10 pages, 7 figures"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.22592","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T02:49:59Z","registered":"2026-02-27T02:50:00Z","published":null,"updated":"2026-02-27T02:50:00Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.22589","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.22589","identifiers":[{"identifier":"2602.22589","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Daniel","familyName":"Yamin","name":"Yamin, Daniel","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Willem-Jan","familyName":"van Hoeve","name":"van Hoeve, Willem-Jan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ted K.","familyName":"Ralphs","name":"Ralphs, Ted K.","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Dantzig-Wolfe and Arc-Flow Reformulations: A Systematic Comparison"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Optimization and Control (math.OC)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"90C27","lang":"en","subjectScheme":"MSC"}],"contributors":[],"dates":[{"date":"2026-02-26T03:49:01Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:21:44Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Dantzig-Wolfe reformulation is a widely used technique for obtaining stronger relaxations in the context of branch-and-bound methods for solving integer optimization problems. Arc-Flow reformulations are a lesser known technique related to dynamic programming that has experienced a resurgence as result of the recent popularization of decision diagrams as a tool for solving integer programs. Although these two reformulation techniques arose independently, the recently proposed solution paradigm known as column elimination has revealed that they are in fact closely connected. Building on a unified formulation and notation, this study clarifies the theoretical connections and computational trade-offs between these two reformulations.\n We first revisit the known fact that the LP relaxations of these two reformulations yield the same dual bound. We then dig deeper, establishing conditions under which valid inequalities in the original, Dantzig-Wolfe, or Arc-Flow spaces can be translated across reformulations without loss of strength, and reinterpreting iterative strengthening methods, such as decremental state-space relaxation and column elimination, through the lens of cutting planes. To assess the potential impact of these insights empirically, we benchmark both reformulations under identical conditions on the vehicle routing problem with time windows using state-of-the-art column- and cut-generation techniques. The results identify clear contrasts: the Arc-Flow reformulation benefits from faster convergence and performs best when subproblems are highly relaxed or low-dimensional, whereas the Dantzig-Wolfe reformulation is more efficient when the master problem remains compact. Overall, our study provides a unified perspective and practical guidelines for choosing between Dantzig-Wolfe and Arc-Flow reformulations in large-scale integer optimization."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.22589","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T02:49:55Z","registered":"2026-02-27T02:49:56Z","published":null,"updated":"2026-02-27T02:49:56Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.22584","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.22584","identifiers":[{"identifier":"2602.22584","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Wenwei","familyName":"Li","name":"Li, Wenwei","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ming","familyName":"Xu","name":"Xu, Ming","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Tianle","familyName":"Xia","name":"Xia, Tianle","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Lingxiang","familyName":"Hu","name":"Hu, Lingxiang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yiding","familyName":"Sun","name":"Sun, Yiding","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Linfang","familyName":"Shang","name":"Shang, Linfang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Liqun","familyName":"Liu","name":"Liu, Liqun","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Peng","familyName":"Shu","name":"Shu, Peng","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Huan","familyName":"Yu","name":"Yu, Huan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jie","familyName":"Jiang","name":"Jiang, Jie","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Towards Faithful Industrial RAG: A Reinforced Co-adaptation Framework for Advertising QA"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-26T03:35:09Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:21:20Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Industrial advertising question answering (QA) is a high-stakes task in which hallucinated content, particularly fabricated URLs, can lead to financial loss, compliance violations, and legal risk. Although Retrieval-Augmented Generation (RAG) is widely adopted, deploying it in production remains challenging because industrial knowledge is inherently relational, frequently updated, and insufficiently aligned with generation objectives. We propose a reinforced co-adaptation framework that jointly optimizes retrieval and generation through two components: (1) Graph-aware Retrieval (GraphRAG), which models entity-relation structure over a high-citation knowledge subgraph for multi-hop, domain-specific evidence selection; and (2) evidence-constrained reinforcement learning via Group Relative Policy Optimization (GRPO) with multi-dimensional rewards covering faithfulness, style compliance, safety, and URL validity. Experiments on an internal advertising QA dataset show consistent gains across expert-judged dimensions including accuracy, completeness, and safety, while reducing the hallucination rate by 72\\%. A two-week online A/B test demonstrates a 28.6\\% increase in like rate, a 46.2\\% decrease in dislike rate, and a 92.7\\% reduction in URL hallucination. The system has been running in production for over half a year and has served millions of QA interactions."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.22584","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T02:49:48Z","registered":"2026-02-27T02:49:48Z","published":null,"updated":"2026-02-27T02:49:48Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.22583","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.22583","identifiers":[{"identifier":"2602.22583","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Weida","familyName":"Liang","name":"Liang, Weida","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yiyou","familyName":"Sun","name":"Sun, Yiyou","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Shuyuan","familyName":"Nan","name":"Nan, Shuyuan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Chuang","familyName":"Li","name":"Li, Chuang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Dawn","familyName":"Song","name":"Song, Dawn","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Kenji","familyName":"Kawaguchi","name":"Kawaguchi, Kenji","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Strategy Executability in Mathematical Reasoning: Leveraging Human-Model Differences for Effective Guidance"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-26T03:34:23Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:21:11Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Example-based guidance is widely used to improve mathematical reasoning at inference time, yet its effectiveness is highly unstable across problems and models-even when the guidance is correct and problem-relevant. We show that this instability arises from a previously underexplored gap between strategy usage-whether a reasoning strategy appears in successful solutions-and strategy executability-whether the strategy remains effective when instantiated as guidance for a target model. Through a controlled analysis of paired human-written and model-generated solutions, we identify a systematic dissociation between usage and executability: human- and model-derived strategies differ in structured, domain-dependent ways, leading to complementary strengths and consistent source-dependent reversals under guidance. Building on this diagnosis, we propose Selective Strategy Retrieval (SSR), a test-time framework that explicitly models executability by selectively retrieving and combining strategies using empirical, multi-route, source-aware signals. Across multiple mathematical reasoning benchmarks, SSR yields reliable and consistent improvements over direct solving, in-context learning, and single-source guidance, improving accuracy by up to $+13$ points on AIME25 and $+5$ points on Apex for compact reasoning models. Code and benchmark are publicly available at: https://github.com/lwd17/strategy-execute-pipeline."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.22583","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T02:49:46Z","registered":"2026-02-27T02:49:47Z","published":null,"updated":"2026-02-27T02:49:47Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.22581","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.22581","identifiers":[{"identifier":"2602.22581","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Tian","familyName":"Bian","name":"Bian, Tian","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yifan","familyName":"Niu","name":"Niu, Yifan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Chaohao","familyName":"Yuan","name":"Yuan, Chaohao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Chengzhi","familyName":"Piao","name":"Piao, Chengzhi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Bingzhe","familyName":"Wu","name":"Wu, Bingzhe","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Long-Kai","familyName":"Huang","name":"Huang, Long-Kai","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yu","familyName":"Rong","name":"Rong, Yu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Tingyang","familyName":"Xu","name":"Xu, Tingyang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Hong","familyName":"Cheng","name":"Cheng, Hong","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jia","familyName":"Li","name":"Li, Jia","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"IBCircuit: Towards Holistic Circuit Discovery with Information Bottleneck"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-26T03:33:35Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:21:09Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Circuit discovery has recently attracted attention as a potential research direction to explain the non-trivial behaviors of language models. It aims to find the computational subgraphs, also known as circuits, within the model that are responsible for solving specific tasks. However, most existing studies overlook the holistic nature of these circuits and require designing specific corrupted activations for different tasks, which is inaccurate and inefficient. In this work, we propose an end-to-end approach based on the principle of Information Bottleneck, called IBCircuit, to identify informative circuits holistically. IBCircuit is an optimization framework for holistic circuit discovery and can be applied to any given task without tediously corrupted activation design. In both the Indirect Object Identification (IOI) and Greater-Than tasks, IBCircuit identifies more faithful and minimal circuits in terms of critical node components and edge components compared to recent related work."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.22581","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T02:49:43Z","registered":"2026-02-27T02:49:44Z","published":null,"updated":"2026-02-27T02:49:44Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.22577","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.22577","identifiers":[{"identifier":"2602.22577","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Yuto","familyName":"Watanabe","name":"Watanabe, Yuto","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yang","familyName":"Zheng","name":"Zheng, Yang","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Gradient Dominance in the Linear Quadratic Regulator: A Unified Analysis for Continuous-Time and Discrete-Time Systems"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Optimization and Control (math.OC)","lang":"en","subjectScheme":"arXiv"},{"subject":"Systems and Control (eess.SY)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"FOS: Electrical engineering, electronic engineering, information engineering","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Electrical engineering, electronic engineering, information engineering","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-26T03:31:04Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:20:57Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by-nc-nd/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution Non Commercial No Derivatives 4.0 International","rightsIdentifier":"cc-by-nc-nd-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Despite its nonconvexity, policy optimization for the Linear Quadratic Regulator (LQR) admits a favorable structural property known as gradient dominance, which facilitates linear convergence of policy gradient methods to the globally optimal gain. While gradient dominance has been extensively studied, continuous-time and discrete-time LQRs have largely been analyzed separately, relying on slightly different assumptions, proof strategies, and resulting guarantees. In this paper, we present a unified gradient dominance property for both continuous-time and discrete-time LQRs under mild stabilizability and detectability assumptions. Our analysis is based on a convex reformulation derived from a common Lyapunov inequality representation and a unified change-of-variables procedure. This convex-lifting perspective yields a single proof framework applicable to both time models. The unified treatment clarifies how differences between continuous-time and discrete-time dynamics influence theoretical guarantees and reveals a deeper structural symmetry between the two formulations. Numerical examples illustrate and support the theoretical findings."},{"descriptionType":"Other","description":"28 pages, 4 figures"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.22577","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T02:49:38Z","registered":"2026-02-27T02:49:38Z","published":null,"updated":"2026-02-27T02:49:38Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.22576","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.22576","identifiers":[{"identifier":"2602.22576","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Tianle","familyName":"Xia","name":"Xia, Tianle","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ming","familyName":"Xu","name":"Xu, Ming","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Lingxiang","familyName":"Hu","name":"Hu, Lingxiang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yiding","familyName":"Sun","name":"Sun, Yiding","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Wenwei","familyName":"Li","name":"Li, Wenwei","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Linfang","familyName":"Shang","name":"Shang, Linfang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Liqun","familyName":"Liu","name":"Liu, Liqun","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Peng","familyName":"Shu","name":"Shu, Peng","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Huan","familyName":"Yu","name":"Yu, Huan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jie","familyName":"Jiang","name":"Jiang, Jie","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Search-P1: Path-Centric Reward Shaping for Stable and Efficient Agentic RAG Training"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"Information Retrieval (cs.IR)","lang":"en","subjectScheme":"arXiv"},{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-26T03:31:00Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:20:57Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Retrieval-Augmented Generation (RAG) enhances large language models (LLMs) by incorporating external knowledge, yet traditional single-round retrieval struggles with complex multi-step reasoning. Agentic RAG addresses this by enabling LLMs to dynamically decide when and what to retrieve, but current RL-based training methods suffer from sparse outcome rewards that discard intermediate signals and low sample efficiency where failed samples contribute nothing. We propose Search-P1, a framework that introduces path-centric reward shaping for agentic RAG training, comprising two key components: (1) Path-Centric Reward, which evaluates the structural quality of reasoning trajectories through order-agnostic step coverage and soft scoring that extracts learning signals even from failed samples, and (2) Dual-Track Path Scoring with offline-generated reference planners that assesses paths from both self-consistency and reference-alignment perspectives. Experiments on multiple QA benchmarks demonstrate that Search-P1 achieves significant improvements over Search-R1 and other strong baselines, with an average accuracy gain of 7.7 points."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.22576","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T02:49:36Z","registered":"2026-02-27T02:49:37Z","published":null,"updated":"2026-02-27T02:49:37Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.22571","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.22571","identifiers":[{"identifier":"2602.22571","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Tianyu","familyName":"Chen","name":"Chen, Tianyu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Wei","familyName":"Xiang","name":"Xiang, Wei","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Kang","familyName":"Han","name":"Han, Kang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yu","familyName":"Lu","name":"Lu, Yu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Di","familyName":"Wu","name":"Wu, Di","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Gaowen","familyName":"Liu","name":"Liu, Gaowen","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ramana Rao","familyName":"Kompella","name":"Kompella, Ramana Rao","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"GIFSplat: Generative Prior-Guided Iterative Feed-Forward 3D Gaussian Splatting from Sparse Views"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-26T03:25:18Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:20:11Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Feed-forward 3D reconstruction offers substantial runtime advantages over per-scene optimization, which remains slow at inference and often fragile under sparse views. However, existing feed-forward methods still have potential for further performance gains, especially for out-of-domain data, and struggle to retain second-level inference time once a generative prior is introduced. These limitations stem from the one-shot prediction paradigm in existing feed-forward pipeline: models are strictly bounded by capacity, lack inference-time refinement, and are ill-suited for continuously injecting generative priors. We introduce GIFSplat, a purely feed-forward iterative refinement framework for 3D Gaussian Splatting from sparse unposed views. A small number of forward-only residual updates progressively refine current 3D scene using rendering evidence, achieve favorable balance between efficiency and quality. Furthermore, we distill a frozen diffusion prior into Gaussian-level cues from enhanced novel renderings without gradient backpropagation or ever-increasing view-set expansion, thereby enabling per-scene adaptation with generative prior while preserving feed-forward efficiency. Across DL3DV, RealEstate10K, and DTU, GIFSplat consistently outperforms state-of-the-art feed-forward baselines, improving PSNR by up to +2.1 dB, and it maintains second-scale inference time without requiring camera poses or any test-time gradient optimization."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.22571","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T02:49:29Z","registered":"2026-02-27T02:49:29Z","published":null,"updated":"2026-02-27T02:49:30Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.22565","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.22565","identifiers":[{"identifier":"2602.22565","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Kang","familyName":"Han","name":"Han, Kang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Wei","familyName":"Xiang","name":"Xiang, Wei","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Lu","familyName":"Yu","name":"Yu, Lu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Mathew","familyName":"Wyatt","name":"Wyatt, Mathew","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Gaowen","familyName":"Liu","name":"Liu, Gaowen","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ramana Rao","familyName":"Kompella","name":"Kompella, Ramana Rao","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"SwiftNDC: Fast Neural Depth Correction for High-Fidelity 3D Reconstruction"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"Graphics (cs.GR)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-26T03:07:53Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:19:20Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Depth-guided 3D reconstruction has gained popularity as a fast alternative to optimization-heavy approaches, yet existing methods still suffer from scale drift, multi-view inconsistencies, and the need for substantial refinement to achieve high-fidelity geometry. Here, we propose SwiftNDC, a fast and general framework built around a Neural Depth Correction field that produces cross-view consistent depth maps. From these refined depths, we generate a dense point cloud through back-projection and robust reprojection-error filtering, obtaining a clean and uniformly distributed geometric initialization for downstream reconstruction. This reliable dense geometry substantially accelerates 3D Gaussian Splatting (3DGS) for mesh reconstruction, enabling high-quality surfaces with significantly fewer optimization iterations. For novel-view synthesis, SwiftNDC can also improve 3DGS rendering quality, highlighting the benefits of strong geometric initialization. We conduct a comprehensive study across five datasets, including two for mesh reconstruction, as well as three for novel-view synthesis. SwiftNDC consistently reduces running time for accurate mesh reconstruction and boosts rendering fidelity for view synthesis, demonstrating the effectiveness of combining neural depth refinement with robust geometric initialization for high-fidelity and efficient 3D reconstruction."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.22565","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T02:49:21Z","registered":"2026-02-27T02:49:21Z","published":null,"updated":"2026-02-27T02:49:21Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.22562","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.22562","identifiers":[{"identifier":"2602.22562","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Taoran","familyName":"Li","name":"Li, Taoran","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Varun","familyName":"Chandrasekaran","name":"Chandrasekaran, Varun","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zhiyuan","familyName":"Yu","name":"Yu, Zhiyuan","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Layer-Targeted Multilingual Knowledge Erasure in Large Language Models"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Cryptography and Security (cs.CR)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-26T03:00:07Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:19:01Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Recent work has demonstrated that machine unlearning in Large Language Models (LLMs) fails to generalize across languages: knowledge erased in one language frequently remains accessible through others. However, the underlying cause of this failure and a principled solution remain open. In this work, we identify intervention depth as the key factor determining multilingual generalization. Through systematic layer-wise experiments, we characterize two distinct failure modes: shallow-layer interventions achieve erasure but collapse multilingual capabilities in held-out languages, while deep-layer interventions preserve utility but fail to erase target knowledge even in source languages. These findings reveal that the choice of intervention layer is not a free parameter; it fundamentally determines whether multilingual unlearning succeeds. We propose MUTE (Multilingual Unlearning via Targeted Erasure), a framework that uses Centered Kernel Alignment (CKA) and Linguistic Regions Development Score (LRDS) to identify intermediate, language-agnostic layers where cross-lingual representations converge. By restricting unlearning updates to these layers, MUTE achieves robust multilingual knowledge erasure while optimizing on only a small set of source languages. Extensive experiments across three LLM architectures and three unlearning algorithms validate our approach, with mechanistic analysis via Logit Lens probing confirming genuine knowledge removal rather than output-level suppression."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.22562","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T02:49:16Z","registered":"2026-02-27T02:49:17Z","published":null,"updated":"2026-02-27T02:49:17Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.22557","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.22557","identifiers":[{"identifier":"2602.22557","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Umid","familyName":"Suleymanov","name":"Suleymanov, Umid","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Rufiz","familyName":"Bayramov","name":"Bayramov, Rufiz","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Suad","familyName":"Gafarli","name":"Gafarli, Suad","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Seljan","familyName":"Musayeva","name":"Musayeva, Seljan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Taghi","familyName":"Mammadov","name":"Mammadov, Taghi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Aynur","familyName":"Akhundlu","name":"Akhundlu, Aynur","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Murat","familyName":"Kantarcioglu","name":"Kantarcioglu, Murat","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"CourtGuard: A Model-Agnostic Framework for Zero-Shot Policy Adaptation in LLM Safety"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-26T02:52:11Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:18:31Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Current safety mechanisms for Large Language Models (LLMs) rely heavily on static, fine-tuned classifiers that suffer from adaptation rigidity, the inability to enforce new governance rules without expensive retraining. To address this, we introduce CourtGuard, a retrieval-augmented multi-agent framework that reimagines safety evaluation as Evidentiary Debate. By orchestrating an adversarial debate grounded in external policy documents, CourtGuard achieves state-of-the-art performance across 7 safety benchmarks, outperforming dedicated policy-following baselines without fine-tuning. Beyond standard metrics, we highlight two critical capabilities: (1) Zero-Shot Adaptability, where our framework successfully generalized to an out-of-domain Wikipedia Vandalism task (achieving 90\\% accuracy) by swapping the reference policy; and (2) Automated Data Curation and Auditing, where we leveraged CourtGuard to curate and audit nine novel datasets of sophisticated adversarial attacks. Our results demonstrate that decoupling safety logic from model weights offers a robust, interpretable, and adaptable path for meeting current and future regulatory requirements in AI governance."},{"descriptionType":"Other","description":"Under Review"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.22557","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T02:49:10Z","registered":"2026-02-27T02:49:10Z","published":null,"updated":"2026-02-27T02:49:10Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.22556","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.22556","identifiers":[{"identifier":"2602.22556","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Zihang","familyName":"Xu","name":"Xu, Zihang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Haozhi","familyName":"Xie","name":"Xie, Haozhi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ziqi","familyName":"Miao","name":"Miao, Ziqi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Wuxuan","familyName":"Gong","name":"Gong, Wuxuan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Chen","familyName":"Qian","name":"Qian, Chen","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Lijun","familyName":"Li","name":"Li, Lijun","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Stable Adaptive Thinking via Advantage Shaping and Length-Aware Gradient Regulation"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-26T02:49:36Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:18:26Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Large reasoning models (LRMs) achieve strong performance through extended reasoning traces, but they often exhibit overthinking behavior for low-complexity queries. Existing efforts to mitigate this issue are fundamentally limited by unstable accuracy-efficiency trade-offs and poor robustness to heterogeneous reasoning behaviors. To address these challenges, we propose a two-stage framework for stable adaptive thinking in LRMs. The framework first applies Hybrid Fine-Tuning to expose the model to both thinking and no-thinking behaviors, establishing well-conditioned initialization. It then performs adaptive reinforcement learning with Correctness-Preserving Advantage Shaping (CPAS) to avoid suppressing correct long-chain reasoning, and Length-Aware Gradient Regulation (LAGR) to stabilize optimization under severe reasoning-length heterogeneity. Extensive experiments on Qwen2.5-1.5B and 7B show consistent improvements over strong baselines, achieving up to +3.7/+3.6 accuracy points while reducing generated tokens by 40.6%/43.9%. Further analyses across varying problem difficulties and out-of-distribution tasks confirm the robustness and generalization of our approach."},{"descriptionType":"Other","description":"15 pages, 7 figures"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.22556","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T02:49:08Z","registered":"2026-02-27T02:49:09Z","published":null,"updated":"2026-02-27T02:49:09Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.22552","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.22552","identifiers":[{"identifier":"2602.22552","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Zhikai","familyName":"Chen","name":"Chen, Zhikai","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Han","familyName":"Xie","name":"Xie, Han","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jian","familyName":"Zhang","name":"Zhang, Jian","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jiliang","familyName":"Tang","name":"Tang, Jiliang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xiang","familyName":"Song","name":"Song, Xiang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Huzefa","familyName":"Rangwala","name":"Rangwala, Huzefa","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Relatron: Automating Relational Machine Learning over Relational Databases"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-26T02:45:22Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:18:15Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Predictive modeling over relational databases (RDBs) powers applications, yet remains challenging due to capturing both cross-table dependencies and complex feature interactions. Relational Deep Learning (RDL) methods automate feature engineering via message passing, while classical approaches like Deep Feature Synthesis (DFS) rely on predefined non-parametric aggregators. Despite performance gains, the comparative advantages of RDL over DFS and the design principles for selecting effective architectures remain poorly understood. We present a comprehensive study that unifies RDL and DFS in a shared design space and conducts architecture-centric searches across diverse RDB tasks. Our analysis yields three key findings: (1) RDL does not consistently outperform DFS, with performance being highly task-dependent; (2) no single architecture dominates across tasks, underscoring the need for task-aware model selection; and (3) validation accuracy is an unreliable guide for architecture choice. This search yields a model performance bank that links architecture configurations to their performance; leveraging this bank, we analyze the drivers of the RDL-DFS performance gap and introduce two task signals -- RDB task homophily and an affinity embedding that captures size, path, feature, and temporal structure -- whose correlation with the gap enables principled routing. Guided by these signals, we propose Relatron, a task embedding-based meta-selector that chooses between RDL and DFS and prunes the within-family search. Lightweight loss-landscape metrics further guard against brittle checkpoints by preferring flatter optima. In experiments, Relatron resolves the \"more tuning, worse performance\" effect and, in joint hyperparameter-architecture optimization, achieves up to 18.5% improvement over strong baselines with 10x lower cost than Fisher information-based alternatives."},{"descriptionType":"Other","description":"ICLR 2026"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.22552","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T02:49:02Z","registered":"2026-02-27T02:49:03Z","published":null,"updated":"2026-02-27T02:49:03Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.22549","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.22549","identifiers":[{"identifier":"2602.22549","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Zhechao","familyName":"Wang","name":"Wang, Zhechao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yiming","familyName":"Zeng","name":"Zeng, Yiming","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Lufan","familyName":"Ma","name":"Ma, Lufan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zeqing","familyName":"Fu","name":"Fu, Zeqing","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Chen","familyName":"Bai","name":"Bai, Chen","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ziyao","familyName":"Lin","name":"Lin, Ziyao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Cheng","familyName":"Lu","name":"Lu, Cheng","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"DrivePTS: A Progressive Learning Framework with Textual and Structural Enhancement for Driving Scene Generation"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-26T02:42:14Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:17:49Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Synthesis of diverse driving scenes serves as a crucial data augmentation technique for validating the robustness and generalizability of autonomous driving systems. Current methods aggregate high-definition (HD) maps and 3D bounding boxes as geometric conditions in diffusion models for conditional scene generation. However, implicit inter-condition dependency causes generation failures when control conditions change independently. Additionally, these methods suffer from insufficient details in both semantic and structural aspects. Specifically, brief and view-invariant captions restrict semantic contexts, resulting in weak background modeling. Meanwhile, the standard denoising loss with uniform spatial weighting neglects foreground structural details, causing visual distortions and blurriness. To address these challenges, we propose DrivePTS, which incorporates three key innovations. Firstly, our framework adopts a progressive learning strategy to mitigate inter-dependency between geometric conditions, reinforced by an explicit mutual information constraint. Secondly, a Vision-Language Model is utilized to generate multi-view hierarchical descriptions across six semantic aspects, providing fine-grained textual guidance. Thirdly, a frequency-guided structure loss is introduced to strengthen the model's sensitivity to high-frequency elements, improving foreground structural fidelity. Extensive experiments demonstrate that our DrivePTS achieves state-of-the-art fidelity and controllability in generating diverse driving scenes. Notably, DrivePTS successfully generates rare scenes where prior methods fail, highlighting its strong generalization ability."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.22549","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T02:48:58Z","registered":"2026-02-27T02:48:58Z","published":null,"updated":"2026-02-27T02:48:58Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.22547","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.22547","identifiers":[{"identifier":"2602.22547","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Zhan","familyName":"Su","name":"Su, Zhan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Fengran","familyName":"Mo","name":"Mo, Fengran","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jinghan","familyName":"Zhang","name":"Zhang, Jinghan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yuchen","familyName":"Hui","name":"Hui, Yuchen","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jia Ao","familyName":"Sun","name":"Sun, Jia Ao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Bingbing","familyName":"Wen","name":"Wen, Bingbing","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jian-Yun","familyName":"Nie","name":"Nie, Jian-Yun","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Towards Dynamic Dense Retrieval with Routing Strategy"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Information Retrieval (cs.IR)","lang":"en","subjectScheme":"arXiv"},{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-26T02:38:40Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:17:38Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"The \\textit{de facto} paradigm for applying dense retrieval (DR) to new tasks involves fine-tuning a pre-trained model for a specific task. However, this paradigm has two significant limitations: (1) It is difficult adapt the DR to a new domain if the training dataset is limited.\n (2) Old DR models are simply replaced by newer models that are trained from scratch when the former are no longer up to date. Especially for scenarios where the model needs to be updated frequently, this paradigm is prohibitively expensive. To address these challenges, we propose a novel dense retrieval approach, termed \\textit{dynamic dense retrieval} (DDR). DDR uses \\textit{prefix tuning} as a \\textit{module} specialized for a specific domain. These modules can then be compositional combined with a dynamic routing strategy, enabling highly flexible domain adaptation in the retrieval part. Extensive evaluation on six zero-shot downstream tasks demonstrates that this approach can surpass DR while utilizing only 2\\% of the training parameters, paving the way to achieve more flexible dense retrieval in IR. We see it as a promising future direction for applying dense retrieval to various tasks."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.22547","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T02:48:55Z","registered":"2026-02-27T02:48:55Z","published":null,"updated":"2026-02-27T02:48:55Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.22543","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.22543","identifiers":[{"identifier":"2602.22543","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Huan","familyName":"Song","name":"Song, Huan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Shuyu","familyName":"Tian","name":"Tian, Shuyu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Junyi","familyName":"Hao","name":"Hao, Junyi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Minxiu","familyName":"Xu","name":"Xu, Minxiu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Hongjun","familyName":"An","name":"An, Hongjun","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yiliang","familyName":"Song","name":"Song, Yiliang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jiawei","familyName":"Shao","name":"Shao, Jiawei","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xuelong","familyName":"Li","name":"Li, Xuelong","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Ruyi2 Technical Report"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-26T02:34:49Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:17:23Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Large Language Models (LLMs) face significant challenges regarding deployment costs and latency, necessitating adaptive computing strategies. Building upon the AI Flow framework, we introduce Ruyi2 as an evolution of our adaptive model series designed for efficient variable-depth computation. While early-exit architectures offer a viable efficiency-performance balance, the Ruyi model and existing methods often struggle with optimization complexity and compatibility with large-scale distributed training. To bridge this gap, Ruyi2 introduces a stable \"Familial Model\" based on Megatron-LM. By using 3D parallel training, it achieves a 2-3 times speedup over Ruyi, while performing comparably to same-sized Qwen3 models. These results confirm that family-based parameter sharing is a highly effective strategy, establishing a new \"Train Once, Deploy Many\" paradigm and providing a key reference for balancing architectural efficiency with high-performance capabilities."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.22543","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T02:48:50Z","registered":"2026-02-27T02:48:50Z","published":null,"updated":"2026-02-27T02:48:50Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.22539","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.22539","identifiers":[{"identifier":"2602.22539","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Mohammad Hossein","familyName":"Shokouhi","name":"Shokouhi, Mohammad Hossein","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Vincent W. S.","familyName":"Wong","name":"Wong, Vincent W. S.","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Agentic AI for Intent-driven Optimization in Cell-free O-RAN"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"Signal Processing (eess.SP)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"FOS: Electrical engineering, electronic engineering, information engineering","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Electrical engineering, electronic engineering, information engineering","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-26T02:26:58Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:16:49Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Agentic artificial intelligence (AI) is emerging as a key enabler for autonomous radio access networks (RANs), where multiple large language model (LLM)-based agents reason and collaborate to achieve operator-defined intents. The open RAN (O-RAN) architecture enables the deployment and coordination of such agents. However, most existing works consider simple intents handled by independent agents, while complex intents that require coordination among agents remain unexplored. In this paper, we propose an agentic AI framework for intent translation and optimization in cell-free O-RAN. A supervisor agent translates the operator intents into an optimization objective and minimum rate requirements. Based on this information, a user weighting agent retrieves relevant prior experience from a memory module to determine the user priority weights for precoding. If the intent includes an energy-saving objective, then an open radio unit (O-RU) management agent will also be activated to determine the set of active O-RUs by using a deep reinforcement learning (DRL) algorithm. A monitoring agent measures and monitors the user data rates and coordinates with other agents to guarantee the minimum rate requirements are satisfied. To enhance scalability, we adopt a parameter-efficient fine-tuning (PEFT) method that enables the same underlying LLM to be used for different agents. Simulation results show that the proposed agentic AI framework reduces the number of active O-RUs by 41.93% when compared with three baseline schemes in energy-saving mode. Using the PEFT method, the proposed framework reduces the memory usage by 92% when compared with deploying separate LLM agents."},{"descriptionType":"Other","description":"Accepted by IEEE International Conference on Communications (ICC), Glasgow, UK, May 2026"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.22539","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T02:48:44Z","registered":"2026-02-27T02:48:45Z","published":null,"updated":"2026-02-27T02:48:45Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.22538","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.22538","identifiers":[{"identifier":"2602.22538","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Zhehao","familyName":"Huang","name":"Huang, Zhehao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yuhang","familyName":"Liu","name":"Liu, Yuhang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Baijiong","familyName":"Lin","name":"Lin, Baijiong","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yixin","familyName":"Lou","name":"Lou, Yixin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zhengbao","familyName":"He","name":"He, Zhengbao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Hanling","familyName":"Tian","name":"Tian, Hanling","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Tao","familyName":"Li","name":"Li, Tao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xiaolin","familyName":"Huang","name":"Huang, Xiaolin","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"RAIN-Merging: A Gradient-Free Method to Enhance Instruction Following in Large Reasoning Models with Preserved Thinking Format"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-26T02:26:45Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:16:46Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Large reasoning models (LRMs) excel at a long chain of reasoning but often fail to faithfully follow instructions regarding output format, constraints, or specific requirements. We investigate whether this gap can be closed by integrating an instruction-tuned model (ITM) into an LRM. Analyzing their differences in parameter space, namely task vectors, we find that their principal subspaces are nearly orthogonal across key modules, suggesting a lightweight merging with minimal interference. However, we also demonstrate that naive merges are fragile because they overlook the output format mismatch between LRMs (with explicit thinking and response segments) and ITMs (answers-only). We introduce RAIN-Merging (Reasoning-Aware Instruction-attention guided Null-space projection Merging), a gradient-free method that integrates instruction following while preserving thinking format and reasoning performance. First, with a small reasoning calibration set, we project the ITM task vector onto the null space of forward features at thinking special tokens, which preserves the LRM's structured reasoning mechanisms. Second, using a small instruction calibration set, we estimate instruction attention to derive module-specific scaling that amplifies instruction-relevant components and suppresses leakage. Across four instruction-following benchmarks and nine reasoning \u0026amp; general capability benchmarks, RAIN-Merging substantially improves instruction adherence while maintaining reasoning quality. The gains are consistent across model scales and architectures, translating to improved performance in agent settings."},{"descriptionType":"Other","description":"41 pages, ICLR 2026 Oral"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.22538","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T02:48:43Z","registered":"2026-02-27T02:48:43Z","published":null,"updated":"2026-02-27T02:48:43Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.22536","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.22536","identifiers":[{"identifier":"2602.22536","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Jichao","familyName":"Zhang","name":"Zhang, Jichao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ran","familyName":"Miao","name":"Miao, Ran","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Limin","familyName":"Li","name":"Li, Limin","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Persistent Nonnegative Matrix Factorization via Multi-Scale Graph Regularization"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-26T02:23:50Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:16:40Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Matrix factorization techniques, especially Nonnegative Matrix Factorization (NMF), have been widely used for dimensionality reduction and interpretable data representation. However, existing NMF-based methods are inherently single-scale and fail to capture the evolution of connectivity structures across resolutions. In this work, we propose persistent nonnegative matrix factorization (pNMF), a scale-parameterized family of NMF problems, that produces a sequence of persistence-aligned embeddings rather than a single one. By leveraging persistent homology, we identify a canonical minimal sufficient scale set at which the underlying connectivity undergoes qualitative changes. These canonical scales induce a sequence of graph Laplacians, leading to a coupled NMF formulation with scale-wise geometric regularization and explicit cross-scale consistency constraint. We analyze the structural properties of the embeddings along the scale parameter and establish bounds on their increments between consecutive scales. The resulting model defines a nontrivial solution path across scales, rather than a single factorization, which poses new computational challenges. We develop a sequential alternating optimization algorithm with guaranteed convergence. Numerical experiments on synthetic and single-cell RNA sequencing datasets demonstrate the effectiveness of the proposed approach in multi-scale low-rank embeddings."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.22536","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T02:48:40Z","registered":"2026-02-27T02:48:40Z","published":null,"updated":"2026-02-27T02:48:40Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.22534","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.22534","identifiers":[{"identifier":"2602.22534","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Paul M.","familyName":"Alsing","name":"Alsing, Paul M.","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"WKB-like approach to the Unruh temperature for arbitrary acceleration"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"General Relativity and Quantum Cosmology (gr-qc)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-26T02:12:50Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:16:20Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by-nc-sa/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution Non Commercial Share Alike 4.0 International","rightsIdentifier":"cc-by-nc-sa-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"In this work we study the Unruh temperature as arising from tunneling through a barrier for an observer in flat Minkowski spacetime with arbitrary acceleration $a(t)$. For the defining case of constant acceleration $a(t) = a_0$, the Unruh temperature (W. Unruh, Phys. Rev. D 14, 870 (1976)) is given by $k_b\\,T_U =\\tfrac{\\hbar\\,a_0}{2\\,π\\,c}$. Extending the work of de Gill et al. (A. de Gill, D. Singleton, V. Akhmedova and T. Pilling, Am. J. Phys. 78, 685 (2010)) we generalize the gravitational WKB approach to derive the Unruh temperature for arbitrary acceleration. We show that the often employed Schwarzschild-like form of the flat metric is not appropriate for the WKB calculation with an arbitrary $a(t)$, and instead derive a generalized Unruh temperature for the generalized Rindler metric where $a_0\\to a(t)$. We derive a generalization of the Rindler coordinates appropriate for arbitrary $a(t)$, and stress the importance of the role of the integrated acceleration $χ(t) = \\int^t dt'\\,a(t')$, which can also act as a temporal coordinate. We explore several non-trivial examples of $a(t)$ and their generalized Unruh temperatures. We additionally develop an approximation to the Unruh temperature for small deviations away from constant acceleration by the standard approach of considering the negative frequency content of a purely positive frequency plane wave of an inertial observer, as measured by the co-moving arbitrarily accelerated observer. Lastly, we develop and explicit coordinate transformation between the arbitrarily accelerated observer and conformal coordinates, where the plane wave structure of the solutions of the wave equation is readily transparent, and analogous to the form for the inertial observer."},{"descriptionType":"Other","description":"27 pages, 3 figures"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.22534","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T02:48:36Z","registered":"2026-02-27T02:48:37Z","published":null,"updated":"2026-02-27T02:48:37Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.22532","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.22532","identifiers":[{"identifier":"2602.22532","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Dezhi","familyName":"Yang","name":"Yang, Dezhi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Qiaoyu","familyName":"Tan","name":"Tan, Qiaoyu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Carlotta","familyName":"Domeniconi","name":"Domeniconi, Carlotta","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jun","familyName":"Wang","name":"Wang, Jun","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Lizhen","familyName":"Cui","name":"Cui, Lizhen","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Guoxian","familyName":"Yu","name":"Yu, Guoxian","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Coarse-to-Fine Learning of Dynamic Causal Structures"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-26T02:12:34Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:16:17Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Learning the dynamic causal structure of time series is a challenging problem. Most existing approaches rely on distributional or structural invariance to uncover underlying causal dynamics, assuming stationary or partially stationary causality. However, these assumptions often conflict with the complex, time-varying causal relationships observed in real-world systems. This motivates the need for methods that address fully dynamic causality, where both instantaneous and lagged dependencies evolve over time. Such a setting poses significant challenges for the efficiency and stability of causal discovery. To address these challenges, we introduce DyCausal, a dynamic causal structure learning framework. DyCausal leverages convolutional networks to capture causal patterns within coarse-grained time windows, and then applies linear interpolation to refine causal structures at each time step, thereby recovering fine-grained and time-varying causal graphs. In addition, we propose an acyclic constraint based on matrix norm scaling, which improves efficiency while effectively constraining loops in evolving causal structures. Comprehensive evaluations on both synthetic and real-world datasets demonstrate that DyCausal achieves superior performance compared to existing methods, offering a stable and efficient approach for identifying fully dynamic causal structures from coarse to fine."},{"descriptionType":"Other","description":"Accepted by ICLR2026"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.22532","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T02:48:33Z","registered":"2026-02-27T02:48:34Z","published":null,"updated":"2026-02-27T02:48:34Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.22529","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.22529","identifiers":[{"identifier":"2602.22529","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Saber","familyName":"Zerhoudi","name":"Zerhoudi, Saber","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Michael","familyName":"Granitzer","name":"Granitzer, Michael","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Generative Agents Navigating Digital Libraries"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Information Retrieval (cs.IR)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"Digital Libraries (cs.DL)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-26T02:08:39Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:16:09Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[{"relationType":"IsVersionOf","relatedIdentifier":"10.1007/978-981-96-0865-2_14","relatedIdentifierType":"DOI"}],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"In the rapidly evolving field of digital libraries, the development of large language models (LLMs) has opened up new possibilities for simulating user behavior. This innovation addresses the longstanding challenge in digital library research: the scarcity of publicly available datasets on user search patterns due to privacy concerns. In this context, we introduce Agent4DL, a user search behavior simulator specifically designed for digital library environments. Agent4DL generates realistic user profiles and dynamic search sessions that closely mimic actual search strategies, including querying, clicking, and stopping behaviors tailored to specific user profiles. Our simulator's accuracy in replicating real user interactions has been validated through comparisons with real user data. Notably, Agent4DL demonstrates competitive performance compared to existing user search simulators such as SimIIR 2.0, particularly in its ability to generate more diverse and context-aware user behaviors."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.22529","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":1,"created":"2026-02-27T02:48:29Z","registered":"2026-02-27T02:48:30Z","published":null,"updated":"2026-02-27T02:48:30Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.22523","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.22523","identifiers":[{"identifier":"2602.22523","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Ryan","familyName":"Liu","name":"Liu, Ryan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Dilip","familyName":"Arumugam","name":"Arumugam, Dilip","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Cedegao E.","familyName":"Zhang","name":"Zhang, Cedegao E.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Sean","familyName":"Escola","name":"Escola, Sean","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xaq","familyName":"Pitkow","name":"Pitkow, Xaq","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Thomas L.","familyName":"Griffiths","name":"Griffiths, Thomas L.","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Cognitive Models and AI Algorithms Provide Templates for Designing Language Agents"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"Neurons and Cognition (q-bio.NC)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"FOS: Biological sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Biological sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-26T01:35:32Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:14:49Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"While contemporary large language models (LLMs) are increasingly capable in isolation, there are still many difficult problems that lie beyond the abilities of a single LLM. For such tasks, there is still uncertainty about how best to take many LLMs as parts and combine them into a greater whole. This position paper argues that potential blueprints for designing such modular language agents can be found in the existing literature on cognitive models and artificial intelligence (AI) algorithms. To make this point clear, we formalize the idea of an agent template that specifies roles for individual LLMs and how their functionalities should be composed. We then survey a variety of existing language agents in the literature and highlight their underlying templates derived directly from cognitive models or AI algorithms. By highlighting these designs, we aim to call attention to agent templates inspired by cognitive science and AI as a powerful tool for developing effective, interpretable language agents."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.22523","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T02:48:21Z","registered":"2026-02-27T02:48:22Z","published":null,"updated":"2026-02-27T02:48:22Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.22521","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.22521","identifiers":[{"identifier":"2602.22521","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Jiayi","familyName":"Wu","name":"Wu, Jiayi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zhengyu","familyName":"Wu","name":"Wu, Zhengyu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xunkai","familyName":"Li","name":"Li, Xunkai","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Rong-Hua","familyName":"Li","name":"Li, Rong-Hua","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Guoren","familyName":"Wang","name":"Wang, Guoren","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"TFPS: A Temporal Filtration-enhanced Positive Sample Set Construction Method for Implicit Collaborative Filtering"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Information Retrieval (cs.IR)","lang":"en","subjectScheme":"arXiv"},{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-26T01:32:45Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:14:39Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"The negative sampling strategy can effectively train collaborative filtering (CF) recommendation models based on implicit feedback by constructing positive and negative samples. However, existing methods primarily optimize the negative sampling process while neglecting the exploration of positive samples. Some denoising recommendation methods can be applied to denoise positive samples within negative sampling strategies, but they ignore temporal information. Existing work integrates sequential information during model aggregation but neglects time interval information, hindering accurate capture of users' current preferences. To address this problem, from a data perspective, we propose a novel temporal filtration-enhanced approach to construct a high-quality positive sample set. First, we design a time decay model based on interaction time intervals, transforming the original graph into a weighted user-item bipartite graph. Then, based on predefined filtering operations, the weighted user-item bipartite graph is layered. Finally, we design a layer-enhancement strategy to construct a high-quality positive sample set for the layered subgraphs. We provide theoretical insights into why TFPS can improve Recall@k and NDCG@k, and extensive experiments on three real-world datasets demonstrate the effectiveness of the proposed method. Additionally, TFPS can be integrated with various implicit CF recommenders or negative sampling methods to enhance its performance."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.22521","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T02:48:18Z","registered":"2026-02-27T02:48:19Z","published":null,"updated":"2026-02-27T02:48:19Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.22518","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.22518","identifiers":[{"identifier":"2602.22518","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Xuefeng","familyName":"Li","name":"Li, Xuefeng","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Nir","familyName":"Ben-Israel","name":"Ben-Israel, Nir","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yotam","familyName":"Raz","name":"Raz, Yotam","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Belal","familyName":"Ahmed","name":"Ahmed, Belal","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Doron","familyName":"Serebro","name":"Serebro, Doron","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Antoine","familyName":"Raux","name":"Raux, Antoine","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"RepoMod-Bench: A Benchmark for Code Repository Modernization via Implementation-Agnostic Testing"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Software Engineering (cs.SE)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-26T01:25:00Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:14:25Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"The evolution of AI coding agents has shifted the frontier from simple snippet completion to autonomous repository-level engineering. However, evaluating these agents remains ill-posed in general code repository generation, where the lack of deterministic ground truth leads to ambiguous metrics. Code modernization via automated translation offers a more rigorous alternative by providing a fixed ground truth -- the source repository; yet existing benchmarks are limited to small-scale repositories and rely on language-specific unit tests visible to the agent, allowing test-driven overfitting.\n We address these limitations by introducing a benchmarking framework for repository-level code modernization built on an implementation-agnostic evaluation paradigm. This framework is instantiated through RepoMod-Bench: a benchmark of 21 real-world repositories with standardized interfaces, spanning 8 programming languages. The benchmark contains 1.6M lines of code (LOC) and 11,616 tests, with repository sizes ranging from 14 to 211K LOC. By targeting repositories with standardized interfaces, we utilize an implementation-agnostic test suite to verify functional equivalence between source and target implementations. This black-box approach ensures verification remains consistent across languages, and our environment hides all test suites from agents to prevent test-driven shortcuts. Evaluating four state-of-the-art agent configurations reveals a sharp scaling collapse: average pass rates drop from 91.3% on projects under 10K LOC to 15.3% on projects exceeding 50K LOC. These results demonstrate that autonomous modernization at scale remains a significant open challenge. Our benchmark and code are available at https://github.com/Modelcode-ai/mcode-benchmark."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.22518","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T02:48:13Z","registered":"2026-02-27T02:48:14Z","published":null,"updated":"2026-02-27T02:48:14Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.22511","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.22511","identifiers":[{"identifier":"2602.22511","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Emanuel","familyName":"Knill","name":"Knill, Emanuel","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ezad","familyName":"Shojaee","name":"Shojaee, Ezad","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"James R.","familyName":"van Meter","name":"van Meter, James R.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Akira","familyName":"Kyle","name":"Kyle, Akira","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Scott","familyName":"Glancy","name":"Glancy, Scott","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Quantified convergence of general homodyne measurements with applications to continuous variable quantum computing"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Quantum Physics (quant-ph)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-26T01:04:10Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:13:44Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"In arXiv:2503.00188 we introduced broadband pulsed (BBP) homodyne measurements as a generalization of standard pulsed homodyne quadrature measurements. BBP can take advantage of detectors such as calorimeters that have the potential for high efficiency over a broad spectral range. BBP homodyne retains the advantages of standard pulsed homodyne, enabling measurement of arbitrary quadratures in the limit of large amplitude local oscillators (LO). Here we quantify the convergence of standard and BBP homodyne quadrature measurements to those of the quadrature of interest. We obtain lower bounds on the fidelity of the post-measurement classical-quantum state of outcomes and unmeasured modes, and the fidelity of the states obtained after applying operations conditional on measurement outcomes. The bounds depend on the LO amplitude and the moments of number operators. We demonstrate the practical relevance of these bounds by evaluating them for standard pulsed homodyne used for estimating values of the characteristic function of the Wigner distribution, expectations of moments, for quantum teleportation and for continuous variable error correction with GKP codes."},{"descriptionType":"Other","description":"59 pages, 4 figures, 1 noteworthy table"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.22511","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T02:48:03Z","registered":"2026-02-27T02:48:04Z","published":null,"updated":"2026-02-27T02:48:04Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.22510","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.22510","identifiers":[{"identifier":"2602.22510","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Guoyizhe","familyName":"Wei","name":"Wei, Guoyizhe","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yang","familyName":"Jiao","name":"Jiao, Yang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Nan","familyName":"Xi","name":"Xi, Nan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zhishen","familyName":"Huang","name":"Huang, Zhishen","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jingjing","familyName":"Meng","name":"Meng, Jingjing","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Rama","familyName":"Chellappa","name":"Chellappa, Rama","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yan","familyName":"Gao","name":"Gao, Yan","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Pix2Key: Controllable Open-Vocabulary Retrieval with Semantic Decomposition and Self-Supervised Visual Dictionary Learning"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-26T01:03:23Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:13:43Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Composed Image Retrieval (CIR) uses a reference image plus a natural-language edit to retrieve images that apply the requested change while preserving other relevant visual content. Classic fusion pipelines typically rely on supervised triplets and can lose fine-grained cues, while recent zero-shot approaches often caption the reference image and merge the caption with the edit, which may miss implicit user intent and return repetitive results. We present Pix2Key, which represents both queries and candidates as open-vocabulary visual dictionaries, enabling intent-aware constraint matching and diversity-aware reranking in a unified embedding space. A self-supervised pretraining component, V-Dict-AE, further improves the dictionary representation using only images, strengthening fine-grained attribute understanding without CIR-specific supervision. On the DFMM-Compose benchmark, Pix2Key improves Recall@10 up to 3.2 points, and adding V-Dict-AE yields an additional 2.3-point gain while improving intent consistency and maintaining high list diversity."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.22510","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T02:48:02Z","registered":"2026-02-27T02:48:03Z","published":null,"updated":"2026-02-27T02:48:03Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.22492","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.22492","identifiers":[{"identifier":"2602.22492","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Gracielle Antunes","familyName":"de Araújo","name":"de Araújo, Gracielle Antunes","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Flávio B.","familyName":"Gonçalves","name":"Gonçalves, Flávio B.","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"From Shallow Bayesian Neural Networks to Gaussian Processes: General Convergence, Identifiability and Scalable Inference"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Machine Learning (stat.ML)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-26T00:02:54Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:12:36Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"In this work, we study scaling limits of shallow Bayesian neural networks (BNNs) via their connection to Gaussian processes (GPs), with an emphasis on statistical modeling, identifiability, and scalable inference. We first establish a general convergence result from BNNs to GPs by relaxing assumptions used in prior formulations, and we compare alternative parameterizations of the limiting GP model. Building on this theory, we propose a new covariance function defined as a convex mixture of components induced by four widely used activation functions, and we characterize key properties including positive definiteness and both strict and practical identifiability under different input designs. For computation, we develop a scalable maximum a posterior (MAP) training and prediction procedure using a Nyström approximation, and we show how the Nyström rank and anchor selection control the cost-accuracy trade-off. Experiments on controlled simulations and real-world tabular datasets demonstrate stable hyperparameter estimates and competitive predictive performance at realistic computational cost."},{"descriptionType":"Other","description":"29 pages, 4 figures, 8 tables. Supplementary material included"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.22492","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T02:47:37Z","registered":"2026-02-27T02:47:38Z","published":null,"updated":"2026-02-27T02:47:38Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.22478","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.22478","identifiers":[{"identifier":"2602.22478","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Jun-Rong","familyName":"Liu","name":"Liu, Jun-Rong","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jian-Min","familyName":"Wang","name":"Wang, Jian-Min","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Hua","familyName":"Feng","name":"Feng, Hua","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Accretion-modified Stars in Accretion Disks of Active Galactic Nuclei: Contribution to AGN disk viscosity"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"High Energy Astrophysical Phenomena (astro-ph.HE)","lang":"en","subjectScheme":"arXiv"},{"subject":"Astrophysics of Galaxies (astro-ph.GA)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-25T23:35:28Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:11:57Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"It is widely believed that stellar-mass black holes (sMBHs) exist within the accretion disks of active galactic nuclei (AGN), forming a distinct population termed ``accretion-modified star\" (AMS). Gas from the dense disk accretes onto these AMSs, dissipating substantial gravitational energy through a mini-disk around the sMBHs, which drives powerful outflows that interact with the surrounding disk gas. In this study, we investigate two scenarios for AMS accretion: episodic Bondi explosions with hyper-Eddington accretion (Scenario A) and steady Eddington accretion (Scenario B). These outflows generate turbulence, facilitating outward angular momentum transport in the AGN disk via shock interactions and angular momentum exchange. We explore a broad parameter space-spanning the central supermassive black hole (SMBH) mass ($M_{\\rm p}$), dimensionless accretion rate ($\\dot{\\mathscr{M}}_{\\rm p}$), sMBH mass function, and spatial distribution-to calculate the effective viscosity parameter $α_{\\rm AMS}$. Our analysis reveals the scaling relations $α_{\\rm AMS}\\proptoζM_{\\rm p}^2\\dot{\\mathscr{M}}_{\\rm p}$ for Scenario A and $α_{\\rm AMS}\\proptoζM_{\\rm p}^{1.5}\\dot{\\mathscr{M}}_{\\rm p}^{0.1}$ for Scenario B, where $ζ$ denotes the ratio of total sMBH mass to the SMBH disk mass. For $ζ={0.01}$ and $M_{\\rm p}=10^8 M_\\odot$, $α_{\\rm AMS}$ ranges from $\\sim{3\\times10^{-4}}$ to ${0.01}$ (Scenario A) and $\\sim{3\\times10^{-3}}$ to ${0.04}$ (Scenario B) from the inner to outer disk regions. These results demonstrate that AMS feedback provides an efficient mechanism for angular momentum transport in AGN disks."},{"descriptionType":"Other","description":"Accepted for publication in ApJ"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.22478","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T02:47:18Z","registered":"2026-02-27T02:47:19Z","published":null,"updated":"2026-02-27T02:47:19Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.22462","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.22462","identifiers":[{"identifier":"2602.22462","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Raiyan","familyName":"Jahangir","name":"Jahangir, Raiyan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Nafiz Imtiaz","familyName":"Khan","name":"Khan, Nafiz Imtiaz","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Amritanand","familyName":"Sudheerkumar","name":"Sudheerkumar, Amritanand","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Vladimir","familyName":"Filkov","name":"Filkov, Vladimir","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"MammoWise: Multi-Model Local RAG Pipeline for Mammography Report Generation"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"Information Retrieval (cs.IR)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-25T22:51:31Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:10:51Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Screening mammography is high volume, time sensitive, and documentation heavy. Radiologists must translate subtle visual findings into consistent BI-RADS assessments, breast density categories, and structured narrative reports. While recent Vision Language Models (VLMs) enable image-to-text reporting, many rely on closed cloud systems or tightly coupled architectures that limit privacy, reproducibility, and adaptability. We present MammoWise, a local multi-model pipeline that transforms open source VLMs into mammogram report generators and multi-task classifiers. MammoWise supports any Ollama-hosted VLM and mammography dataset, and enables zero-shot, few-shot, and Chain-of-Thought prompting, with optional multimodal Retrieval Augmented Generation (RAG) using a vector database for case-specific context. We evaluate MedGemma, LLaVA-Med, and Qwen2.5-VL on VinDr-Mammo and DMID datasets, assessing report quality (BERTScore, ROUGE-L), BI-RADS classification, breast density, and key findings. Report generation is consistently strong and improves with few-shot prompting and RAG. Classification is feasible but sensitive to model and dataset choice. Parameter-efficient fine-tuning (QLoRA) of MedGemma improves reliability, achieving BI-RADS accuracy of 0.7545, density accuracy of 0.8840, and calcification accuracy of 0.9341 while preserving report quality. MammoWise provides a practical and extensible framework for deploying local VLMs for mammography reporting within a unified and reproducible workflow."},{"descriptionType":"Other","description":"arXiv preprint (submitted 25 Feb 2026). Local multi-model pipeline for mammography report generation + classification using prompting, multimodal RAG (ChromaDB), and QLoRA fine-tuning; evaluates MedGemma, LLaVA-Med, Qwen2.5-VL on VinDr-Mammo and DMID; reports BERTScore/ROUGE-L and classification metrics"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.22462","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T02:46:55Z","registered":"2026-02-27T02:46:56Z","published":null,"updated":"2026-02-27T02:46:56Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.22458","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.22458","identifiers":[{"identifier":"2602.22458","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Dario","familyName":"Dennstädt","name":"Dennstädt, Dario","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Model Predictive Control for output tracking with prescribed performance"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Optimization and Control (math.OC)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-25T22:39:44Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:10:36Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by-sa/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution Share Alike 4.0 International","rightsIdentifier":"cc-by-sa-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Model Predictive Control (MPC) offers a versatile framework for constraint handling and multi-objective optimisation, yet practical application faces challenges regarding initial and recursive feasibility, robustness against model mismatches, and sampled-data constraints. This thesis develops a novel MPC framework for a class of non-linear continuous-time systems governed by functional differential equations. It targets output tracking within prescribed error bounds while systematically overcoming these challenges.\n First, we introduce funnel MPC, an algorithm eliminating reliance on terminal conditions or restrictive long prediction horizons. Utilising funnel penalty functions -- state costs penalising tracking error deviations from time-varying boundaries -- this framework ensures feasibility while rigorously enforcing tracking performance guarantees.\n Next, we unify funnel MPC with model-free funnel feedback into a hybrid architecture. This synergises model-based optimisation with adaptive feedback compensation, achieving prescribed tracking performance despite structural model-plant mismatches, unmodelled dynamics, and unknown disturbances.\n To further enhance predictive accuracy, we integrate a data-driven learning framework that iteratively refines the model using system measurements, improving long-term performance without compromising robustness.\n Finally, we formalise the transition to sampled-data implementations. We derive explicit bounds on sampling rates and control effort to guarantee stability under piecewise constant control signals, a critical step for digital hardware deployment.\n By addressing feasibility, robustness, learning, and sampling, this thesis establishes a cohesive framework for output tracking within prescribed bounds, paving the way for future advances in learning-enhanced and robust MPC."},{"descriptionType":"Other","description":"PhD thesis"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.22458","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T02:46:50Z","registered":"2026-02-27T02:46:50Z","published":null,"updated":"2026-02-27T02:46:50Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.22452","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.22452","identifiers":[{"identifier":"2602.22452","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Chayan","familyName":"Banerjee","name":"Banerjee, Chayan","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"CWM: Contrastive World Models for Action Feasibility Learning in Embodied Agent Pipelines"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"Robotics (cs.RO)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"I.2.7; I.2.9","lang":"en","subjectScheme":"ACM"}],"contributors":[],"dates":[{"date":"2026-02-25T22:27:30Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:10:19Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"A reliable action feasibility scorer is a critical bottleneck in embodied agent pipelines: before any planning or reasoning occurs, the agent must identify which candidate actions are physically executable in the current state. Existing approaches use supervised fine-tuning (SFT) to train action scorers, but SFT treats each candidate independently and does not explicitly teach the model to discriminate between actions that are physically correct and those that are subtly wrong. We propose the Contrastive World Model (CWM), which fine-tunes a large language model (LLM) as an action scorer using an InfoNCE contrastive objective with hard-mined negative examples. The key idea is to push valid actions away from invalid ones in scoring space, with special emphasis on hard negatives: semantically similar but physically incompatible candidates. We evaluate CWM on the ScienceWorld benchmark through two studies. First, an intrinsic affordance evaluation on 605 hard-negative test pairs shows that CWM outperforms SFT by +6.76 percentage points on Precision@1 for minimal-edit negatives -- cases where a single word changes the physical outcome -- and achieves a higher AUC-ROC (0.929 vs. 0.906). Second, a live filter characterisation study measures how well CWM ranks gold-path actions against all valid environment actions during task execution. Under out-of-distribution stress conditions, CWM maintains a significantly better safety margin (-2.39) than SFT (-3.96), indicating that the gold action is ranked closer to the top. These results support the hypothesis that contrastive training induces representations that capture physical feasibility more faithfully than SFT alone."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.22452","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T02:46:42Z","registered":"2026-02-27T02:46:42Z","published":null,"updated":"2026-02-27T02:46:42Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.22450","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.22450","identifiers":[{"identifier":"2602.22450","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Qianlong","familyName":"Lan","name":"Lan, Qianlong","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Anuj","familyName":"Kaul","name":"Kaul, Anuj","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Shaun","familyName":"Jones","name":"Jones, Shaun","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Stephanie","familyName":"Westrum","name":"Westrum, Stephanie","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Silent Egress: When Implicit Prompt Injection Makes LLM Agents Leak Without a Trace"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Cryptography and Security (cs.CR)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-25T22:26:23Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:10:17Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Agentic large language model systems increasingly automate tasks by retrieving URLs and calling external tools. We show that this workflow gives rise to implicit prompt injection: adversarial instructions embedded in automatically generated URL previews, including titles, metadata, and snippets, can introduce a system-level risk that we refer to as silent egress. Using a fully local and reproducible testbed, we demonstrate that a malicious web page can induce an agent to issue outbound requests that exfiltrate sensitive runtime context, even when the final response shown to the user appears harmless. In 480 experimental runs with a qwen2.5:7b-based agent, the attack succeeds with high probability (P (egress) =0.89), and 95% of successful attacks are not detected by output-based safety checks. We also introduce sharded exfiltration, where sensitive information is split across multiple requests to avoid detection. This strategy reduces single-request leakage metrics by 73% (Leak@1) and bypasses simple data loss prevention mechanisms. Our ablation results indicate that defenses applied at the prompt layer offer limited protection, while controls at the system and network layers, such as domain allowlisting and redirect-chain analysis, are considerably more effective. These findings suggest that network egress should be treated as a first-class security outcome in agentic LLM systems. We outline architectural directions, including provenance tracking and capability isolation, that go beyond prompt-level hardening."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.22450","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T02:46:39Z","registered":"2026-02-27T02:46:40Z","published":null,"updated":"2026-02-27T02:46:40Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.22449","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.22449","identifiers":[{"identifier":"2602.22449","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Mirza","familyName":"Raquib","name":"Raquib, Mirza","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Asif Pervez","familyName":"Polok","name":"Polok, Asif Pervez","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Kedar Nath","familyName":"Biswas","name":"Biswas, Kedar Nath","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Rahat Uddin","familyName":"Azad","name":"Azad, Rahat Uddin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Saydul Akbar","familyName":"Murad","name":"Murad, Saydul Akbar","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Nick","familyName":"Rahimi","name":"Rahimi, Nick","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"A Fusion of context-aware based BanglaBERT and Two-Layer Stacked LSTM Framework for Multi-Label Cyberbullying Detection"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-25T22:24:05Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:10:16Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Cyberbullying has become a serious and growing concern in todays virtual world. When left unnoticed, it can have adverse consequences for social and mental health. Researchers have explored various types of cyberbullying, but most approaches use single-label classification, assuming that each comment contains only one type of abuse. In reality, a single comment may include overlapping forms such as threats, hate speech, and harassment. Therefore, multilabel detection is both realistic and essential. However, multilabel cyberbullying detection has received limited attention, especially in low-resource languages like Bangla, where robust pre-trained models are scarce. Developing a generalized model with moderate accuracy remains challenging. Transformers offer strong contextual understanding but may miss sequential dependencies, while LSTM models capture temporal flow but lack semantic depth. To address these limitations, we propose a fusion architecture that combines BanglaBERT-Large with a two-layer stacked LSTM. We analyze their behavior to jointly model context and sequence. The model is fine-tuned and evaluated on a publicly available multilabel Bangla cyberbullying dataset covering cyberbully, sexual harassment, threat, and spam. We apply different sampling strategies to address class imbalance. Evaluation uses multiple metrics, including accuracy, precision, recall, F1-score, Hamming loss, Cohens kappa, and AUC-ROC. We employ 5-fold cross-validation to assess the generalization of the architecture."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.22449","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T02:46:38Z","registered":"2026-02-27T02:46:38Z","published":null,"updated":"2026-02-27T02:46:38Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.22434","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.22434","identifiers":[{"identifier":"2602.22434","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Alex","familyName":"Aizman","name":"Aizman, Alex","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Abhishek","familyName":"Gaikwad","name":"Gaikwad, Abhishek","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Piotr","familyName":"Żelasko","name":"Żelasko, Piotr","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"GetBatch: Distributed Multi-Object Retrieval for ML Data Loading"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Distributed, Parallel, and Cluster Computing (cs.DC)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"Databases (cs.DB)","lang":"en","subjectScheme":"arXiv"},{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-25T21:45:18Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:09:30Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Machine learning training pipelines consume data in batches. A single training step may require thousands of samples drawn from shards distributed across a storage cluster. Issuing thousands of individual GET requests incurs per-request overhead that often dominates data transfer time. To solve this problem, we introduce GetBatch - a new object store API that elevates batch retrieval to a first-class storage operation, replacing independent GET operations with a single deterministic, fault-tolerant streaming execution. GetBatch achieves up to 15x throughput improvement for small objects and, in a production training workload, reduces P95 batch retrieval latency by 2x and P99 per-object tail latency by 3.7x compared to individual GET requests."},{"descriptionType":"Other","description":"11 pages, 3 figures, 2 tables. Preprint"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.22434","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T02:46:18Z","registered":"2026-02-27T02:46:19Z","published":null,"updated":"2026-02-27T02:46:19Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.22433","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.22433","identifiers":[{"identifier":"2602.22433","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Refat","familyName":"Othman","name":"Othman, Refat","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Predicting Known Vulnerabilities from Attack Descriptions Using Sentence Transformers"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Cryptography and Security (cs.CR)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"D.4.6; I.2.7; K.6.5","lang":"en","subjectScheme":"ACM"},{"subject":"D.4.6, I.2.7","lang":"en","subjectScheme":"MSC"}],"contributors":[],"dates":[{"date":"2026-02-25T21:44:57Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:09:29Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Modern infrastructures rely on software systems that remain vulnerable to cyberattacks. These attacks frequently exploit vulnerabilities documented in repositories such as MITRE's Common Vulnerabilities and Exposures (CVE). However, Cyber Threat Intelligence resources, including MITRE ATT\u0026amp;CK and CVE, provide only partial coverage of attack-vulnerability relationships. Attack information often appears before vulnerabilities are formally linked, creating the need for automated methods that infer likely vulnerabilities directly from attack descriptions.\n This thesis addresses the problem of predicting known vulnerabilities from natural-language descriptions of cyberattacks. We develop transformer-based sentence embedding methods that encode attack and vulnerability descriptions into semantic vector representations, enabling similarity-based ranking and recommendation.\n Fourteen state-of-the-art transformer models were evaluated across four attack description types (Tactic, Technique, Procedure, and Attack Pattern). Results show that Technique descriptions in MITRE ATT\u0026amp;CK provide the strongest predictive signal. The multi-qa-mpnet-base-dot-v1 (MMPNet) model achieved the best performance due to its hybrid pre-training and optimization for semantic similarity.\n The approach was implemented in the VULDAT tool, which automatically links attacks to vulnerabilities. Manual validation revealed previously undocumented relationships in MITRE repositories. Evaluation on unseen cyberattack reports demonstrates that the models generalize beyond curated datasets and support proactive vulnerability awareness."},{"descriptionType":"Other","description":"PhD thesis, Free University of Bozen-Bolzano, 2026"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.22433","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T02:46:16Z","registered":"2026-02-27T02:46:17Z","published":null,"updated":"2026-02-27T02:46:17Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.22430","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.22430","identifiers":[{"identifier":"2602.22430","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Hongrui","familyName":"Chen","name":"Chen, Hongrui","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Josephine V.","familyName":"Carstensen","name":"Carstensen, Josephine V.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Faez","familyName":"Ahmed","name":"Ahmed, Faez","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"TopoEdit: Fast Post-Optimization Editing of Topology Optimized Structures"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Graphics (cs.GR)","lang":"en","subjectScheme":"arXiv"},{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-25T21:41:44Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:09:25Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Despite topology optimization producing high-performance structures, late-stage localized revisions remain brittle: direct density-space edits (e.g., warping pixels, inserting holes, swapping infill) can sever load paths and sharply degrade compliance, while re-running optimization is slow and may drift toward a qualitatively different design. We present TopoEdit, a fast post-optimization editor that demonstrates how structured latent embeddings from a pre-trained topology foundation model (OAT) can be repurposed as an interface for physics-aware engineering edits. Given an optimized topology, TopoEdit encodes it into OAT's spatial latent, applies partial noising to preserve instance identity while increasing editability, and injects user intent through an edit-then-denoise diffusion pipeline. We instantiate three edit operators: drag-based topology warping with boundary-condition-consistent conditioning updates, shell-infill lattice replacement using a lattice-anchored reference latent with updated volume-fraction conditioning, and late-stage no-design region enforcement via masked latent overwrite followed by diffusion-based recovery. A consistency-preserving guided DDIM procedure localizes changes while allowing global structural adaptation; multiple candidates can be sampled and selected using a compliance-aware criterion, with optional short SIMP refinement for warps. Across diverse case studies and large edit sweeps, TopoEdit produces intention-aligned modifications that better preserve mechanical performance and avoid catastrophic failure modes compared to direct density-space edits, while generating edited candidates in sub-second diffusion time per sample."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.22430","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T02:46:12Z","registered":"2026-02-27T02:46:13Z","published":null,"updated":"2026-02-27T02:46:13Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.22421","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.22421","identifiers":[{"identifier":"2602.22421","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Donghao","familyName":"Zhu","name":"Zhu, Donghao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Hanzhang","familyName":"Qin","name":"Qin, Hanzhang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ching-pei","familyName":"Lee","name":"Lee, Ching-pei","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yuki","familyName":"Saito","name":"Saito, Yuki","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Takahiro","familyName":"Kawashima","name":"Kawashima, Takahiro","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Kenji","familyName":"Fukumizu","name":"Fukumizu, Kenji","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Huge-Scale Assortment Optimization with Customer Choice: A Parallel Primal-Dual Approach"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Optimization and Control (math.OC)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-25T21:32:40Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:08:54Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"We study huge-scale assortment optimization problems to maximize expected revenue under customer choice, addressing a fundamental challenge in industries such as transportation, retail, and healthcare. The choice-based linear programming (CBLP) formulation provides a powerful framework for optimizing sales allocations across customer segments, yet traditional approaches often fail to solve CBLPs of huge scale (involving millions of customer choices) due to the lack of algorithmic designs that exploit problem structure. To overcome this computational bottleneck, we propose a first-order primal-dual method, SPFOM, which requires only a small computational cost per iteration, achieves a provably near-optimal convergence rate, and can be readily extended to parallel computing environments. Computational experiments demonstrate the computational and practical superiority of SPFOM over state-of-the-art solvers for large-scale linear programs. The framework is extended to a multi-period assortment optimization setting with inventory constraints, where SPFOM estimates global shadow prices that enhance classical bid-price control policies compared with benchmark methods such as market segment decomposition. Numerical experiments and a case study using real-world data from the ZOZOTOWN platform validate the practical effectiveness of SPFOM, highlighting its advantages in improving revenue performance while maintaining balanced inventory levels."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.22421","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T02:46:00Z","registered":"2026-02-27T02:46:01Z","published":null,"updated":"2026-02-27T02:46:01Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.22411","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.22411","identifiers":[{"identifier":"2602.22411","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"M. Cristina","familyName":"Câmara","name":"Câmara, M. Cristina","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"C.","familyName":"Carteiro","name":"Carteiro, C.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"C.","familyName":"Diogo","name":"Diogo, C.","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Maximal functions and multipliers for subkernels of Toeplitz operators"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Functional Analysis (math.FA)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"47B35, 47B38, 30H10","lang":"en","subjectScheme":"MSC"}],"contributors":[],"dates":[{"date":"2026-02-25T21:04:25Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:08:11Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"We study the relations between maximal functions in a Toeplitz kernel and those in a subkernel of the same Toeplitz operator, as well as the question of how multipliers between Toeplitz kernels act on subkernels. We use those relations to obtain model space representations, in particular isometric model space representations and Hayashi's representation, for some important classes of Toeplitz kernels."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.22411","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T02:45:46Z","registered":"2026-02-27T02:45:47Z","published":null,"updated":"2026-02-27T02:45:47Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.22406","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.22406","identifiers":[{"identifier":"2602.22406","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Xinle","familyName":"Wu","name":"Wu, Xinle","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Rui","familyName":"Zhang","name":"Zhang, Rui","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Mustafa Anis","familyName":"Hussain","name":"Hussain, Mustafa Anis","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yao","familyName":"Lu","name":"Lu, Yao","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Towards Autonomous Memory Agents"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-25T20:59:44Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:07:53Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Recent memory agents improve LLMs by extracting experiences and conversation history into an external storage. This enables low-overhead context assembly and online memory update without expensive LLM training. However, existing solutions remain passive and reactive; memory growth is bounded by information that happens to be available, while memory agents seldom seek external inputs in uncertainties. We propose autonomous memory agents that actively acquire, validate, and curate knowledge at a minimum cost. U-Mem materializes this idea via (i) a cost-aware knowledge-extraction cascade that escalates from cheap self/teacher signals to tool-verified research and, only when needed, expert feedback, and (ii) semantic-aware Thompson sampling to balance exploration and exploitation over memories and mitigate cold-start bias. On both verifiable and non-verifiable benchmarks, U-Mem consistently beats prior memory baselines and can surpass RL-based optimization, improving HotpotQA (Qwen2.5-7B) by 14.6 points and AIME25 (Gemini-2.5-flash) by 7.33 points."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.22406","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T02:45:39Z","registered":"2026-02-27T02:45:40Z","published":null,"updated":"2026-02-27T02:45:40Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.22397","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.22397","identifiers":[{"identifier":"2602.22397","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Ayush","familyName":"Sharma","name":"Sharma, Ayush","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Vikram","familyName":"Tripathi","name":"Tripathi, Vikram","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Hidden $Z_{2}\\times Z_{2}$ subspace symmetry protection for quantum scars"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Strongly Correlated Electrons (cond-mat.str-el)","lang":"en","subjectScheme":"arXiv"},{"subject":"Statistical Mechanics (cond-mat.stat-mech)","lang":"en","subjectScheme":"arXiv"},{"subject":"Quantum Physics (quant-ph)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-25T20:47:26Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:07:36Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"We study the paradigmatic spin-1 XY chain under open boundary conditions, which hosts exact quantum many-body scars generated by an emergent Spectrum Generating Algebra (SGA). We show that the scar subspace possesses a symmetry-protected trivial (SPt) character that we attribute to a hidden $Z_{2}\\times Z_{2}$ symmetry of another model, namely the commutant Hamiltonian, for which the scars are the ground states. We construct a Lieb-Schultz-Mattis (LSM) type twist operator, which, for scar states, takes the value $-1,$ and, for ergodic states, approaches zero in the thermodynamic limit. A complementary understanding of the stability of the scars under different perturbations is obtained by analyzing the Loschmidt echo and Quantum Fisher Information (QFI) of the scars. Finite-size scaling analysis of the QFI reveals that the scars are much more sensitive to perturbations as compared to the nearby thermal states. Based on the analysis of QFI and different LSM twist operators, we obtain a classification of different SGA-preserving and SGA-breaking perturbations."},{"descriptionType":"Other","description":"33 pages, 19 figures. Comments are welcome"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.22397","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T02:45:27Z","registered":"2026-02-27T02:45:28Z","published":null,"updated":"2026-02-27T02:45:28Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.22396","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.22396","identifiers":[{"identifier":"2602.22396","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"P. B.","familyName":"Barbosa","name":"Barbosa, P. B.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"C. J. A. P.","familyName":"Martins","name":"Martins, C. J. A. P.","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Current-carrying string network evolution in an external magnetic field"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"High Energy Physics - Phenomenology (hep-ph)","lang":"en","subjectScheme":"arXiv"},{"subject":"Cosmology and Nongalactic Astrophysics (astro-ph.CO)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-25T20:45:15Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:07:33Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[{"relationType":"IsVersionOf","relatedIdentifier":"10.1103/tfvh-7hld","relatedIdentifierType":"DOI"}],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Cosmic strings are topological defects arising in a variety of cosmological scenarios, as the Universe undergoes symmetry-breaking phase transitions, whose discovery would offer valuable insight into the high-energy physics that shaped the early Universe. To interpret such a detection, robust theoretical models are essential. The Velocity-dependent One-Scale (VOS) model is particularly prominent: it self-consistently treats the network as a thermodynamic system, characterizing its key properties, and predicting its large-scale evolution. This has recently been extended to include superconducting cosmic strings, which carry additional degrees of freedom, giving rise to the Charge-Velocity dependent One-Scale (CVOS) model. One limitation of the latter model is that it only included loss mechanisms for the charge and current. Here, we extend this model by phenomenologically including a possible energy source mechanism, specifically by allowing current-carrying strings interactions with an external magnetic field. We discuss how this coupling impacts the network's evolution, present and classify the physically allowed scaling solutions for this extended CVOS model, and comment on the different impacts of the external magnetic field on the evolution of the network's charge and current. Under our modeling assumptions, one of the ten physically plausible scaling solution enables the network to gain energy by this mechanism."},{"descriptionType":"Other","description":"15 pages, 10 figures; Phys. Rev. D (in press)"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.22396","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":1,"created":"2026-02-27T02:45:26Z","registered":"2026-02-27T02:45:26Z","published":null,"updated":"2026-02-27T02:45:26Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.22390","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.22390","identifiers":[{"identifier":"2602.22390","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Siu Wun","familyName":"Cheung","name":"Cheung, Siu Wun","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Youngsoo","familyName":"Choi","name":"Choi, Youngsoo","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jean-Luc","familyName":"Fattebert","name":"Fattebert, Jean-Luc","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jonas","familyName":"Kaufman","name":"Kaufman, Jonas","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Daniel","familyName":"Osei-Kuffuor","name":"Osei-Kuffuor, Daniel","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"A Reduced Order Model approach for First-Principles Molecular Dynamics Computations"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Numerical Analysis (math.NA)","lang":"en","subjectScheme":"arXiv"},{"subject":"Materials Science (cond-mat.mtrl-sci)","lang":"en","subjectScheme":"arXiv"},{"subject":"Computational Physics (physics.comp-ph)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-25T20:36:41Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:07:19Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"To leverage the redundancy between the electronic structure computed at each step of first-principles molecular dynamics, we present a data-driven modeling framework for Kohn-Sham Density Functional Theory that bypasses the explicit optimization of electronic wavefunctions. We sample a priori representative atomic configurations and construct a low-dimensional basis that efficiently approximates the electronic structure subspace. Subsequently, we employ this reduced basis in a direct solver for the electronic single particle density matrix, thereby enabling the efficient determination of ground state without iterative wavefunction optimization. We demonstrate the efficacy of our approach in a Born-Oppenheimer molecular dynamics of a water molecule, showing that the resulting simulations accurately reproduce key structural properties, such as bond lengths and bond angle, obtained from full first-principles molecular dynamics. This work highlights the potential of data-driven approaches to develop efficient electronic structure solvers for first-principles simulations."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.22390","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T02:45:17Z","registered":"2026-02-27T02:45:18Z","published":null,"updated":"2026-02-27T02:45:18Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.22387","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.22387","identifiers":[{"identifier":"2602.22387","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Yixuan","familyName":"Li","name":"Li, Yixuan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Archer Y.","familyName":"Yang","name":"Yang, Archer Y.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yue","familyName":"Li","name":"Li, Yue","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Disentangling Shared and Target-Enriched Topics via Background-Contrastive Non-negative Matrix Factorization"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-25T20:34:07Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:07:00Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Biological signals of interest in high-dimensional data are often masked by dominant variation shared across conditions. This variation, arising from baseline biological structure or technical effects, can prevent standard dimensionality reduction methods from resolving condition-specific structure. The challenge is that these confounding topics are often unknown and mixed with biological signals. Existing background correction methods are either unscalable to high dimensions or not interpretable. We introduce background contrastive Non-negative Matrix Factorization (\\model), which extracts target-enriched latent topics by jointly factorizing a target dataset and a matched background using shared non-negative bases under a contrastive objective that suppresses background-expressed structure. This approach yields non-negative components that are directly interpretable at the feature level, and explicitly isolates target-specific variation. \\model is learned by an efficient multiplicative update algorithm via matrix multiplication such that it is highly efficient on GPU hardware and scalable to big data via minibatch training akin to deep learning approach. Across simulations and diverse biological datasets, \\model reveals signals obscured by conventional methods, including disease-associated programs in postmortem depressive brain single-cell RNA-seq, genotype-linked protein expression patterns in mice, treatment-specific transcriptional changes in leukemia, and TP53-dependent drug responses in cancer cell lines."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.22387","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T02:45:13Z","registered":"2026-02-27T02:45:14Z","published":null,"updated":"2026-02-27T02:45:14Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.22380","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.22380","identifiers":[{"identifier":"2602.22380","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Alfonso","familyName":"Sciacchitano","name":"Sciacchitano, Alfonso","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Douglas L.","familyName":"Van Bossuyt","name":"Van Bossuyt, Douglas L.","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"A Mission Engineering Framework for Uncrewed Aerial Vehicle Design in GNSS-Denied Environments for Intelligence, Surveillance, and Reconnaissance Mission Sets"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Systems and Control (eess.SY)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Electrical engineering, electronic engineering, information engineering","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Electrical engineering, electronic engineering, information engineering","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-25T20:26:14Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:06:41Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Small, low-size, weight, power, and cost (SWaP-C) uncrewed aerial vehicles (UAVs) are increasingly used for intelligence, surveillance, and reconnaissance (ISR) missions due to their affordability, attritability, and suitability for distributed operations. However, their design poses challenges including limited endurance, constrained payload capacity, and reliance on simple sensing modalities such as fixed-field-of-view, bearing-only cameras. Traditional platform-centric methods cannot capture the coupled performance, cost, and coordination trade-offs that emerge at the system-of-systems level.\n This paper presents a mission engineering framework for early-phase design of low-SWaP-C UAV ISR architectures. The framework integrates design of experiments, multi-objective optimization, and high-fidelity simulation into a closed-loop process linking design variables to estimator-informed performance and mission cost. Candidate architectures are explored via Latin hypercube sampling and refined using a genetic algorithm, with performance evaluated through Monte Carlo trials of a federated Kalman filter benchmarked against the posterior Cramer-Rao lower bound. Validation follows the Validation Square methodology, combining theoretical, empirical, and structural assessments.\n A case study on man-overboard localization in a GNSS-denied maritime environment shows that localization accuracy saturates at sub-meter levels, while higher-cost configurations primarily add redundancy and resilience. The framework thus quantifies mission trade-offs between performance, affordability, and robustness, providing a scalable decision-support tool for contested, resource-constrained ISR missions."},{"descriptionType":"Other","description":"12 pages, 8 figures, submitted to IEEE Systems for publication"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.22380","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T02:45:04Z","registered":"2026-02-27T02:45:04Z","published":null,"updated":"2026-02-27T02:45:04Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.22376","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.22376","identifiers":[{"identifier":"2602.22376","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Hanyang","familyName":"Liu","name":"Liu, Hanyang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Rongjun","familyName":"Qin","name":"Qin, Rongjun","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"AeroDGS: Physically Consistent Dynamic Gaussian Splatting for Single-Sequence Aerial 4D Reconstruction"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-25T20:20:27Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:06:24Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Recent advances in 4D scene reconstruction have significantly improved dynamic modeling across various domains. However, existing approaches remain limited under aerial conditions with single-view capture, wide spatial range, and dynamic objects of limited spatial footprint and large motion disparity. These challenges cause severe depth ambiguity and unstable motion estimation, making monocular aerial reconstruction inherently ill-posed. To this end, we present AeroDGS, a physics-guided 4D Gaussian splatting framework for monocular UAV videos. AeroDGS introduces a Monocular Geometry Lifting module that reconstructs reliable static and dynamic geometry from a single aerial sequence, providing a robust basis for dynamic estimation. To further resolve monocular ambiguity, we propose a Physics-Guided Optimization module that incorporates differentiable ground-support, upright-stability, and trajectory-smoothness priors, transforming ambiguous image cues into physically consistent motion. The framework jointly refines static backgrounds and dynamic entities with stable geometry and coherent temporal evolution. We additionally build a real-world UAV dataset that spans various altitudes and motion conditions to evaluate dynamic aerial reconstruction. Experiments on synthetic and real UAV scenes demonstrate that AeroDGS outperforms state-of-the-art methods, achieving superior reconstruction fidelity in dynamic aerial environments."},{"descriptionType":"Other","description":"Accepted to CVPR 2026"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.22376","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T02:44:58Z","registered":"2026-02-27T02:44:58Z","published":null,"updated":"2026-02-27T02:44:58Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.22365","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.22365","identifiers":[{"identifier":"2602.22365","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Chayan","familyName":"Banerjee","name":"Banerjee, Chayan","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Sustainable Multi-Agent Crowdsourcing via Physics-Informed Bandits"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Multiagent Systems (cs.MA)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-25T19:52:00Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:05:02Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Crowdsourcing platforms face a four-way tension between allocation quality, workforce sustainability, operational feasibility, and strategic contractor behaviour--a dilemma we formalise as the Cold-Start, Burnout, Utilisation, and Strategic Agency Dilemma. Existing methods resolve at most two of these tensions simultaneously: greedy heuristics and multi-criteria decision making (MCDM) methods achieve Day-1 quality but cause catastrophic burnout, while bandit algorithms eliminate burnout only through operationally infeasible 100% workforce utilisation.To address this, we introduce FORGE, a physics-grounded $K+1$ multi-agent simulator in which each contractor is a rational agent that declares its own load-acceptance threshold based on its fatigue state, converting the standard passive Restless Multi-Armed Bandit (RMAB) into a genuine Stackelberg game. Operating within FORGE, we propose a Neural-Linear UCB allocator that fuses a Two-Tower embedding network with a Physics-Informed Covariance Prior derived from offline simulator interactions. The prior simultaneously warm-starts skill-cluster geometry and UCB exploration landscape, providing a geometry-aware belief state from episode 1 that measurably reduces cold-start regret.Over $T = 200$ cold-start episodes, the proposed method achieves the highest reward of all non-oracle methods ($\\text{LRew} = 0.555 \\pm 0.041$) at only 7.6% workforce utilisation--a combination no conventional baseline achieves--while maintaining robustness to workforce turnover up to 50% and observation noise up to $σ= 0.20$."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.22365","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T02:44:42Z","registered":"2026-02-27T02:44:43Z","published":null,"updated":"2026-02-27T02:44:43Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.22362","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.22362","identifiers":[{"identifier":"2602.22362","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Abhishek","familyName":"Kulkarni","name":"Kulkarni, Abhishek","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Alexander","familyName":"Barquero","name":"Barquero, Alexander","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Pavitra","familyName":"Lahari","name":"Lahari, Pavitra","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Aryaan","familyName":"Shaikh","name":"Shaikh, Aryaan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Sarah","familyName":"Brown","name":"Brown, Sarah","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"E3VA: Enhancing Emotional Expressiveness in Virtual Conversational Agents"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Human-Computer Interaction (cs.HC)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-25T19:41:27Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:04:46Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by-nc-nd/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution Non Commercial No Derivatives 4.0 International","rightsIdentifier":"cc-by-nc-nd-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"With the advent of generative AI and large language models, embodied conversational agents are becoming synonymous with online interactions. These agents possess vast amounts of knowledge but suffer from exhibiting limited emotional expressiveness. Without adequate expressions, agents might fail to adapt to users' emotions, which may result in a sub-optimal user experience and engagement. Most current systems prioritize content based responses, neglecting the emotional context of conversations. Research in this space is currently limited to specific contexts, like mental health. To bridge this gap, our project proposes the implementation of expressive features in a virtual conversational agent which will utilize sentiment analysis and natural language processing to inform the generation of empathetic, expressive responses. The project delivers a functional conversational agent capable of assessing and responding to user emotions accordingly. We posit this will enhance usability, engagement, and the overall quality of conversations and present results from an exploratory pilot study investigating the same."},{"descriptionType":"Other","description":"5 pages"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.22362","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T02:44:39Z","registered":"2026-02-27T02:44:39Z","published":null,"updated":"2026-02-27T02:44:39Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.22361","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.22361","identifiers":[{"identifier":"2602.22361","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Liping","familyName":"Meng","name":"Meng, Liping","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Fan","familyName":"Nie","name":"Nie, Fan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yunyun","familyName":"Zhang","name":"Zhang, Yunyun","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Chao","familyName":"Han","name":"Han, Chao","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Optimizing Neural Network Architecture for Medical Image Segmentation Using Monte Carlo Tree Search"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-25T19:40:41Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:04:36Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"This paper proposes a novel medical image segmentation framework, MNAS-Unet, which combines Monte Carlo Tree Search (MCTS) and Neural Architecture Search (NAS). MNAS-Unet dynamically explores promising network architectures through MCTS, significantly enhancing the efficiency and accuracy of architecture search. It also optimizes the DownSC and UpSC unit structures, enabling fast and precise model adjustments. Experimental results demonstrate that MNAS-Unet outperforms NAS-Unet and other state-of-the-art models in segmentation accuracy on several medical image datasets, including PROMISE12, Ultrasound Nerve, and CHAOS. Furthermore, compared with NAS-Unet, MNAS-Unet reduces the architecture search budget by 54% (early stopping at 139 epochs versus 300 epochs under the same search setting), while achieving a lightweight model with only 0.6M parameters and lower GPU memory consumption, which further improves its practical applicability. These results suggest that MNAS-Unet can improve search efficiency while maintaining competitive segmentation accuracy under practical resource constraints."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.22361","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T02:44:37Z","registered":"2026-02-27T02:44:38Z","published":null,"updated":"2026-02-27T02:44:38Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.22359","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.22359","identifiers":[{"identifier":"2602.22359","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Arno","familyName":"Simons","name":"Simons, Arno","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Scaling In, Not Up? Testing Thick Citation Context Analysis with GPT-5 and Fragile Prompts"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"J.4; I.2.1; I.2.7","lang":"en","subjectScheme":"ACM"}],"contributors":[],"dates":[{"date":"2026-02-25T19:33:00Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:04:25Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"This paper tests whether large language models (LLMs) can support interpretative citation context analysis (CCA) by scaling in thick, text-grounded readings of a single hard case rather than scaling up typological labels. It foregrounds prompt-sensitivity analysis as a methodological issue by varying prompt scaffolding and framing in a balanced 2x3 design. Using footnote 6 in Chubin and Moitra (1975) and Gilbert's (1977) reconstruction as a probe, I implement a two-stage GPT-5 pipeline: a citation-text-only surface classification and expectation pass, followed by cross-document interpretative reconstruction using the citing and cited full texts. Across 90 reconstructions, the model produces 450 distinct hypotheses. Close reading and inductive coding identify 21 recurring interpretative moves, and linear probability models estimate how prompt choices shift their frequencies and lexical repertoire. GPT-5's surface pass is highly stable, consistently classifying the citation as \"supplementary\". In reconstruction, the model generates a structured space of plausible alternatives, but scaffolding and examples redistribute attention and vocabulary, sometimes toward strained readings. Relative to Gilbert, GPT-5 detects the same textual hinges yet more often resolves them as lineage and positioning than as admonishment. The study outlines opportunities and risks of using LLMs as guided co-analysts for inspectable, contestable interpretative CCA, and it shows that prompt scaffolding and framing systematically tilt which plausible readings and vocabularies the model foregrounds."},{"descriptionType":"Other","description":"26 pages, 1 figure, 3 tables (plus 17 pages supplement including 1 figure)"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.22359","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T02:44:34Z","registered":"2026-02-27T02:44:35Z","published":null,"updated":"2026-02-27T02:44:35Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.22356","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.22356","identifiers":[{"identifier":"2602.22356","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Ievgen","familyName":"Bondarenko","name":"Bondarenko, Ievgen","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Rostislav","familyName":"Grigorchuk","name":"Grigorchuk, Rostislav","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Alina","familyName":"Vdovina","name":"Vdovina, Alina","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Ramanujan subshifts"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Dynamical Systems (math.DS)","lang":"en","subjectScheme":"arXiv"},{"subject":"Combinatorics (math.CO)","lang":"en","subjectScheme":"arXiv"},{"subject":"Group Theory (math.GR)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"37B51, 37A25, 05C48","lang":"en","subjectScheme":"MSC"}],"contributors":[],"dates":[{"date":"2026-02-25T19:26:46Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:04:13Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"A finite, connected, $(d+1)$-regular graph $G$ is called Ramanujan if every its eigenvalue $λ$ satisfies either $λ=\\pm (d+1)$ or $|λ|\\leq 2\\sqrt{d}$. The Ramanujan condition corresponds to the optimal rate of decay of correlations for the associated non-backtracking edge subshift. We consider a higher-dimensional generalization of this observation. We introduce the notion of a $d$-regular $\\mathbb{Z}^δ$-subshift of finite type, and we define a Ramanujan subshift as a $d$-regular $\\mathbb{Z}^δ$-subshift with an optimal rate of decay of correlations. We show that for every odd prime power $q\\geq 3$ and dimension $δ"},{"descriptionType":"Other","description":"30 pages"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.22356","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T02:44:30Z","registered":"2026-02-27T02:44:31Z","published":null,"updated":"2026-02-27T02:44:31Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.22345","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.22345","identifiers":[{"identifier":"2602.22345","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Davide","familyName":"Ettori","name":"Ettori, Davide","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Structure and Redundancy in Large Language Models: A Spectral Study via Random Matrix Theory"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-25T19:11:56Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:03:29Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"This thesis addresses two persistent and closely related challenges in modern deep learning, reliability and efficiency, through a unified framework grounded in Spectral Geometry and Random Matrix Theory (RMT). As deep networks and large language models continue to scale, their internal behavior becomes increasingly opaque, leading to hallucinations, fragile generalization under distribution shift, and growing computational and energy demands. By analyzing the eigenvalue dynamics of hidden activations across layers and inputs, this work shows that spectral statistics provide a compact, stable, and interpretable lens on model behavior, capable of separating structured, causal representations from noise-dominated variability. Within this framework, the first contribution, EigenTrack, introduces a real-time method for detecting hallucinations and out-of-distribution behavior in large language and vision-language models. EigenTrack transforms streaming activations into spectral descriptors such as entropy, variance, and deviations from the Marchenko-Pastur baseline, and models their temporal evolution using lightweight recurrent classifiers, enabling early detection of reliability failures before they appear in model outputs while offering interpretable insight into representation dynamics. The second contribution, RMT-KD, presents a principled approach to compressing deep networks via random matrix theoretic knowledge distillation. By interpreting outlier eigenvalues in activation spectra as carriers of task-relevant information, RMT-KD progressively projects networks onto lower-dimensional subspaces through iterative self-distillation, yielding significantly more compact and energy-efficient models while preserving accuracy and dense, hardware-friendly structure."},{"descriptionType":"Other","description":"Executive Summary of Master Thesis in Computer Science Engineering, Politecnico di Milano"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.22345","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T02:44:15Z","registered":"2026-02-27T02:44:15Z","published":null,"updated":"2026-02-27T02:44:15Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.22343","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.22343","identifiers":[{"identifier":"2602.22343","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Shruthi","familyName":"Andru","name":"Andru, Shruthi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Shrut Kirti","familyName":"Saksena","name":"Saksena, Shrut Kirti","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Interface Framework for Human-AI Collaboration within Intelligent User Interface Ecosystems"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Human-Computer Interaction (cs.HC)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-25T19:09:32Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:03:27Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by-nc-sa/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution Non Commercial Share Alike 4.0 International","rightsIdentifier":"cc-by-nc-sa-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"As interfaces evolve from static user pathways to dynamic human-AI collaboration, no standard methods exist for selecting appropriate interface patterns based on user needs and task complexity. Existing frameworks only provide guiding principles for designing AI agent capabilities. We propose a dimensional framework based on workflow complexity, AI autonomy, and AI reasoning to guide the design of context-aware, scalable AI interfaces aka modalities (e.g., prompt bars, split screens, full screens, etc.). The framework was developed through co-design workshops with designers of marketing products and refined through qualitative research with eight long-term AI users. The study evaluated the three dimensions, identified task-to-interface relationships, and surfaced the importance of both business impact and security risk across all high-autonomy scenarios. This framework provides product teams with a shared language to develop scalable AI interfaces, emphasizing fluidity between interfaces and progressive user control to balance AI autonomy with human oversight."},{"descriptionType":"Other","description":"22 pages, 8 figures"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.22343","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T02:44:12Z","registered":"2026-02-27T02:44:13Z","published":null,"updated":"2026-02-27T02:44:13Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.22303","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.22303","identifiers":[{"identifier":"2602.22303","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Bruce W.","familyName":"Lee","name":"Lee, Bruce W.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Chen","familyName":"Yueh-Han","name":"Yueh-Han, Chen","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Tomek","familyName":"Korbak","name":"Korbak, Tomek","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Training Agents to Self-Report Misbehavior"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-25T18:47:17Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:02:25Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Frontier AI agents may pursue hidden goals while concealing their pursuit from oversight. Alignment training aims to prevent such behavior by reinforcing the correct goals, but alignment may not always succeed and can lead to unwanted side effects. We propose self-incrimination training, which instead trains agents to produce a visible signal when they covertly misbehave. We train GPT-4.1 and Gemini-2.0 agents to call a report_scheming() tool when behaving deceptively and measure their ability to cause harm undetected in out-of-distribution environments. Self-incrimination significantly reduces the undetected successful attack rate, outperforming matched-capability monitors and alignment baselines while preserving instruction hierarchy and incurring minimal safety tax on general capabilities. Unlike blackbox monitoring, self-incrimination performance is consistent across tasks regardless of how suspicious the misbehavior appears externally. The trained behavior persists under adversarial prompt optimization and generalizes to settings where agents pursue misaligned goals themselves rather than being instructed to misbehave. Our results suggest self-incrimination offers a viable path for reducing frontier misalignment risk, one that neither assumes misbehavior can be prevented nor that it can be reliably classified from the outside."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.22303","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T02:43:16Z","registered":"2026-02-27T02:43:17Z","published":null,"updated":"2026-02-27T02:43:17Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.22302","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.22302","identifiers":[{"identifier":"2602.22302","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Varun Pratap","familyName":"Bhardwaj","name":"Bhardwaj, Varun Pratap","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Agent Behavioral Contracts: Formal Specification and Runtime Enforcement for Reliable Autonomous AI Agents"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"Multiagent Systems (cs.MA)","lang":"en","subjectScheme":"arXiv"},{"subject":"Software Engineering (cs.SE)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-25T18:42:56Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:02:24Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[{"relationType":"IsVersionOf","relatedIdentifier":"10.5281/zenodo.18775393","relatedIdentifierType":"DOI"}],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by-nc-nd/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution Non Commercial No Derivatives 4.0 International","rightsIdentifier":"cc-by-nc-nd-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Traditional software relies on contracts -- APIs, type systems, assertions -- to specify and enforce correct behavior. AI agents, by contrast, operate on prompts and natural language instructions with no formal behavioral specification. This gap is the root cause of drift, governance failures, and frequent project failures in agentic AI deployments. We introduce Agent Behavioral Contracts (ABC), a formal framework that brings Design-by-Contract principles to autonomous AI agents. An ABC contract C = (P, I, G, R) specifies Preconditions, Invariants, Governance policies, and Recovery mechanisms as first-class, runtime-enforceable components. We define (p, delta, k)-satisfaction -- a probabilistic notion of contract compliance that accounts for LLM non-determinism and recovery -- and prove a Drift Bounds Theorem showing that contracts with recovery rate gamma \u0026gt; alpha (the natural drift rate) bound behavioral drift to D* = alpha/gamma in expectation, with Gaussian concentration in the stochastic setting. We establish sufficient conditions for safe contract composition in multi-agent chains and derive probabilistic degradation bounds. We implement ABC in AgentAssert, a runtime enforcement library, and evaluate on AgentContract-Bench, a benchmark of 200 scenarios across 7 models from 6 vendors. Results across 1,980 sessions show that contracted agents detect 5.2-6.8 soft violations per session that uncontracted baselines miss entirely (p \u0026lt; 0.0001, Cohen's d = 6.7-33.8), achieve 88-100% hard constraint compliance, and bound behavioral drift to D* \u0026lt; 0.27 across extended sessions, with 100% recovery for frontier models and 17-100% across all models, at overhead \u0026lt; 10 ms per action."},{"descriptionType":"Other","description":"71 pages, 7 figures, 14 tables. Patent pending. Also available on Zenodo: DOI 10.5281/zenodo.18775393"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.22302","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":2,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":1,"created":"2026-02-27T02:43:15Z","registered":"2026-02-27T02:43:15Z","published":null,"updated":"2026-02-27T02:43:15Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.22298","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.22298","identifiers":[{"identifier":"2602.22298","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Zijian","familyName":"Zhu","name":"Zhu, Zijian","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Qiusheng","familyName":"Huang","name":"Huang, Qiusheng","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Anboyu","familyName":"Guo","name":"Guo, Anboyu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xiaohui","familyName":"Zhong","name":"Zhong, Xiaohui","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Hao","familyName":"Li","name":"Li, Hao","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"AviaSafe: A Physics-Informed Data-Driven Model for Aviation Safety-Critical Cloud Forecasts"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-25T17:51:07Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:02:09Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Current AI weather forecasting models predict conventional atmospheric variables but cannot distinguish between cloud microphysical species critical for aviation safety. We introduce AviaSafe, a hierarchical, physics-informed neural forecaster that produces global, six-hourly predictions of these four hydrometeor species for lead times up to 7 days. Our approach addresses the unique challenges of cloud prediction: extreme sparsity, discontinuous distributions, and complex microphysical interactions between species. We integrate the Icing Condition (IC) index from aviation meteorology as a physics-based constraint that identifies regions where supercooled water fuels explosive ice crystal growth. The model employs a hierarchical architecture that first predicts cloud spatial distribution through masked attention, then quantifies species concentrations within identified regions. Training on ERA5 reanalysis data, our model achieves lower RMSE for cloud species compared to baseline and outperforms operational numerical models on certain key variables at 7-day lead times. The ability to forecast individual cloud species enables new applications in aviation route optimization where distinguishing between ice and liquid water determines engine icing risk."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.22298","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T02:43:09Z","registered":"2026-02-27T02:43:10Z","published":null,"updated":"2026-02-27T02:43:10Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.22297","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.22297","identifiers":[{"identifier":"2602.22297","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Dhiraj","familyName":"Neupane","name":"Neupane, Dhiraj","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Richard","familyName":"Dazeley","name":"Dazeley, Richard","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Mohamed Reda","familyName":"Bouadjenek","name":"Bouadjenek, Mohamed Reda","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Sunil","familyName":"Aryal","name":"Aryal, Sunil","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Learning Rewards, Not Labels: Adversarial Inverse Reinforcement Learning for Machinery Fault Detection"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-25T15:34:19Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:02:08Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[{"relationType":"IsVersionOf","relatedIdentifier":"10.65109/axyx4522","relatedIdentifierType":"DOI"}],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by-nc-nd/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution Non Commercial No Derivatives 4.0 International","rightsIdentifier":"cc-by-nc-nd-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Reinforcement learning (RL) offers significant promise for machinery fault detection (MFD). However, most existing RL-based MFD approaches do not fully exploit RL's sequential decision-making strengths, often treating MFD as a simple guessing game (Contextual Bandits). To bridge this gap, we formulate MFD as an offline inverse reinforcement learning problem, where the agent learns the reward dynamics directly from healthy operational sequences, thereby bypassing the need for manual reward engineering and fault labels. Our framework employs Adversarial Inverse Reinforcement Learning to train a discriminator that distinguishes between normal (expert) and policy-generated transitions. The discriminator's learned reward serves as an anomaly score, indicating deviations from normal operating behaviour. When evaluated on three run-to-failure benchmark datasets (HUMS2023, IMS, and XJTU-SY), the model consistently assigns low anomaly scores to normal samples and high scores to faulty ones, enabling early and robust fault detection. By aligning RL's sequential reasoning with MFD's temporal structure, this work opens a path toward RL-based diagnostics in data-driven industrial settings."},{"descriptionType":"Other","description":"This article is accepted to be published in AAMAS2026. The doi is listed below but the production is on the way as of now (26/02/2026)"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.22297","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":1,"created":"2026-02-27T02:43:08Z","registered":"2026-02-27T02:43:08Z","published":null,"updated":"2026-02-27T02:43:08Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.22296","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.22296","identifiers":[{"identifier":"2602.22296","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Devan","familyName":"Shah","name":"Shah, Devan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Owen","familyName":"Yang","name":"Yang, Owen","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Daniel","familyName":"Yang","name":"Yang, Daniel","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Chongyi","familyName":"Zheng","name":"Zheng, Chongyi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Benjamin","familyName":"Eysenbach","name":"Eysenbach, Benjamin","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"UpSkill: Mutual Information Skill Learning for Structured Response Diversity in LLMs"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-25T15:34:14Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:02:06Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Reinforcement Learning with Verifiable Rewards (RLVR) has improved the reasoning abilities of large language models (LLMs) on mathematics and programming tasks, but standard approaches that optimize single-attempt accuracy can inadvertently suppress response diversity across repeated attempts, narrowing exploration and overlooking underrepresented strategies. We introduce UpSkill, a training time method that adapts Mutual Information Skill Learning (MISL) to LLMs for optimizing pass@k correctness. We propose a novel reward that we implement within Group Relative Policy Optimization (GRPO): a token-level mutual information (MI) reward that encourages trajectory specificity to z. Experiments on GSM8K with three open-weight models, Llama 3.1-8B, Qwen 2.5-7B, and R1-Distilled-Qwen2.5-Math-1.5B, show that UpSkill improves multi-attempt metrics on the stronger base models, yielding mean gains of ~3% in pass@k for both Qwen and Llama without degrading pass@1. Additionally, we find both empirical and theoretical evidence that improvements in pass@k are closely tied to the mutual information objective."},{"descriptionType":"Other","description":"First two authors equal contribution. 29 pages total (11 pages main text), 10 figures, 10 tables. Project website: https://dshah.io/upskill/"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.22296","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T02:43:06Z","registered":"2026-02-27T02:43:07Z","published":null,"updated":"2026-02-27T02:43:07Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.22290","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.22290","identifiers":[{"identifier":"2602.22290","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Yahao","familyName":"Ding","name":"Ding, Yahao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yinchao","familyName":"Yang","name":"Yang, Yinchao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jiaxiang","familyName":"Wang","name":"Wang, Jiaxiang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zhonghao","familyName":"Liu","name":"Liu, Zhonghao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zhaohui","familyName":"Yang","name":"Yang, Zhaohui","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Mingzhe","familyName":"Chen","name":"Chen, Mingzhe","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Mohammad","familyName":"Shikh-Bahaei","name":"Shikh-Bahaei, Mohammad","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Energy Efficient Federated Learning with Hyperdimensional Computing (HDC)"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Distributed, Parallel, and Cluster Computing (cs.DC)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-25T14:55:10Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:01:59Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"This paper investigates the problem of minimizing total energy consumption for secure federated learning (FL) in wireless edge networks, a key paradigm for decentralized big data analytics. To tackle the high computational cost and privacy challenges of processing large-scale distributed data with conventional neural networks, we propose an FL with hyperdimensional computing and differential privacy (FL-HDC-DP) framework. Each edge device employs hyperdimensional computing (HDC) for lightweight local training and applies differential privacy (DP) noise to protect transmitted model updates. The total energy consumption is minimized through a joint optimization of the HDC dimension, transmit power, and CPU frequency. An efficient hybrid algorithm is developed, combining an outer enumeration search for HDC dimensions with an inner one-dimensional search for resource allocation. Simulation results show that the proposed framework achieves up to 83.3% energy reduction compared with baseline schemes, while maintaining high accuracy and faster convergence."},{"descriptionType":"Other","description":"6 pages, 3 figures"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.22290","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T02:42:58Z","registered":"2026-02-27T02:42:58Z","published":null,"updated":"2026-02-27T02:42:58Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.22278","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.22278","identifiers":[{"identifier":"2602.22278","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Dawei","familyName":"Su","name":"Su, Dawei","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Dongsheng","familyName":"Wang","name":"Wang, Dongsheng","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"RETLLM: Training and Data-Free MLLMs for Multimodal Information Retrieval"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Information Retrieval (cs.IR)","lang":"en","subjectScheme":"arXiv"},{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-25T10:31:32Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:01:43Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Multimodal information retrieval (MMIR) has gained attention for its flexibility in handling text, images, or mixed queries and candidates. Recent breakthroughs in multimodal large language models (MLLMs) boost MMIR performance by incorporating MLLM knowledge under the contrastive finetuning framework. However, they suffer from pre-training inconsistency and require large datasets. In this work, we introduce a novel framework, RetLLM, designed to query MLLMs for MMIR in a training- and data-free manner. Specifically, we formulate MMIR as a similarity score generation task and prompt MLLMs to directly predict retrieval scores in a coarse-then-fine pipeline. At the coarse stage, a top-k filtering strategy builds a small yet high-quality candidate pool for each query, enabling MLLMs to focus on semantically relevant candidates. Subsequently, the retrieval score is predicted by feeding both the query and candidate into MLLMs at the fine stage. Importantly, we propose a visual enhancement module during reasoning to help MLLMs re-pick forgotten visuals, improving retrieval. Extensive experiments on MMIR benchmarks show that RetLLM outperforms fine-tuned models. Ablation studies further verify each component. Our work demonstrates that MLLMs can achieve strong MMIR performance without any training, highlighting their inherent multimodal reasoning ability in a simple, scalable framework. We release our code at: https://github.com/alivecat05/RETLLM"},{"descriptionType":"Other","description":"5 pages, 2 figure"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.22278","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T02:42:41Z","registered":"2026-02-27T02:42:42Z","published":null,"updated":"2026-02-27T02:42:42Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.22268","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.22268","identifiers":[{"identifier":"2602.22268","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Changhai","familyName":"Zhou","name":"Zhou, Changhai","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Shiyang","familyName":"Zhang","name":"Zhang, Shiyang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yuhua","familyName":"Zhou","name":"Zhou, Yuhua","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Qian","familyName":"Qiao","name":"Qiao, Qian","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jun","familyName":"Gao","name":"Gao, Jun","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Cheng","familyName":"Jin","name":"Jin, Cheng","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Kaizhou","familyName":"Qin","name":"Qin, Kaizhou","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Weizhong","familyName":"Zhang","name":"Zhang, Weizhong","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"AutoQRA: Joint Optimization of Mixed-Precision Quantization and Low-rank Adapters for Efficient LLM Fine-Tuning"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-25T07:18:08Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:01:29Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Quantization followed by parameter-efficient fine-tuning has emerged as a promising paradigm for downstream adaptation under tight GPU memory constraints. However, this sequential pipeline fails to leverage the intricate interaction between quantization bit-width and LoRA rank. Specifically, a carefully optimized quantization allocation with low quantization error does not always translate to strong fine-tuning performance, and different bit-width and rank configurations can lead to significantly varying outcomes under the same memory budget. To address this limitation, we propose AutoQRA, a joint optimization framework that simultaneously optimizes the bit-width and LoRA rank configuration for each layer during the mixed quantized fine-tuning process. To tackle the challenges posed by the large discrete search space and the high evaluation cost associated with frequent fine-tuning iterations, AutoQRA decomposes the optimization process into two stages. First, it first conducts a global multi-fidelity evolutionary search, where the initial population is warm-started by injecting layer-wise importance priors. This stage employs specific operators and a performance model to efficiently screen candidate configurations. Second, trust-region Bayesian optimization is applied to locally refine promising regions of the search space and identify optimal configurations under the given memory budget. This approach enables active compensation for quantization noise in specific layers during training. Experiments show that AutoQRA achieves performance close to full-precision fine-tuning with a memory footprint comparable to uniform 4-bit methods."},{"descriptionType":"Other","description":"15 pages, 10 figures"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.22268","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T02:42:27Z","registered":"2026-02-27T02:42:28Z","published":null,"updated":"2026-02-27T02:42:28Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.22261","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.22261","identifiers":[{"identifier":"2602.22261","identifierType":"arXiv"}],"creators":[{"nameType":"Organizational","affiliation":[],"name":"Yuvarani","nameIdentifiers":[]},{"nameType":"Personal","givenName":"Akashdeep","familyName":"Singh","name":"Singh, Akashdeep","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zahra","familyName":"Fathanah","name":"Fathanah, Zahra","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Salsabila","familyName":"Harlen","name":"Harlen, Salsabila","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Syeikha Syafura Al-Zahra binti","familyName":"Zahari","name":"Zahari, Syeikha Syafura Al-Zahra binti","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Hema","familyName":"Subramaniam","name":"Subramaniam, Hema","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Sustainable LLM Inference using Context-Aware Model Switching"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-25T03:42:12Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:01:19Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Large language models have become central to many AI applications, but their growing energy consumption raises serious sustainability concerns. A key limitation in current AI deployments is the reliance on a one-size-fits-all inference strategy where most systems route every request to the same large model, regardless of task complexity, leading to substantial and unnecessary energy waste. To address this issue, we propose a context-aware model switching approach that dynamically selects an appropriate language model based on query complexity. The proposed system uses a Context-Aware Model Switching for Energy-Efficient LLM Inference that combines caching for repeated queries, rulebased complexity scoring for fast and explainable decisions, machine learning classification to capture semantic intent, and a user-adaptive component that learns from interaction patterns over time. The proposed architecture was evaluated using real conversation workloads and three open-source language models (Gemma3 1B, Gemma3 4B and Qwen3 4B) with different computational costs, measuring energy consumption (via NVML GPU power telemetry), response latency, routing accuracy, and output quality (BERTScore F1) to reflect real-world usage conditions. Experimental results show that the model switching approach can reduce energy consumption by up to 67.5% compared to always using the largest model while maintaining a response quality of 93.6%. In addition, the response time for simple queries also improved significantly by approximately 68%. These results show that model switching inference offers a practical and scalable path toward more energy-efficient and sustainable AI systems, demonstrating that significant efficiency gains can be achieved without major sacrifices in response quality."},{"descriptionType":"Other","description":"15 pages, 6 figures"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.22261","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T02:42:17Z","registered":"2026-02-27T02:42:18Z","published":null,"updated":"2026-02-27T02:42:18Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.22260","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.22260","identifiers":[{"identifier":"2602.22260","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Camilo Chacón","familyName":"Sartori","name":"Sartori, Camilo Chacón","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Guillem Rodríguez","familyName":"Corominas","name":"Corominas, Guillem Rodríguez","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Code World Models for Parameter Control in Evolutionary Algorithms"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"Neural and Evolutionary Computing (cs.NE)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-25T01:49:29Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:01:18Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Can an LLM learn how an optimizer behaves -- and use that knowledge to control it? We extend Code World Models (CWMs), LLM-synthesized Python programs that predict environment dynamics, from deterministic games to stochastic combinatorial optimization. Given suboptimal trajectories of $(1{+}1)$-$\\text{RLS}_k$, the LLM synthesizes a simulator of the optimizer's dynamics; greedy planning over this simulator then selects the mutation strength $k$ at each step. On \\lo{} and \\onemax{}, CWM-greedy performs within 6\\% of the theoretically optimal policy -- without ever seeing optimal-policy trajectories. On \\jump{$_k$}, where a deceptive valley causes all adaptive baselines to fail (0\\% success rate), CWM-greedy achieves 100\\% success rate -- without any collection policy using oracle knowledge of the gap parameter. On the NK-Landscape, where no closed-form model exists, CWM-greedy outperforms all baselines across fifteen independently generated instances ($36.94$ vs.\\ $36.32$; $p\u0026lt;0.001$) when the prompt includes empirical transition statistics. The CWM also outperforms DQN in sample efficiency (200 offline trajectories vs.\\ 500 online episodes), success rate (100\\% vs.\\ 58\\%), and generalization ($k{=}3$: 78\\% vs.\\ 0\\%). Robustness experiments confirm stable synthesis across 5 independent runs."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.22260","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T02:42:16Z","registered":"2026-02-27T02:42:17Z","published":null,"updated":"2026-02-27T02:42:17Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.22257","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.22257","identifiers":[{"identifier":"2602.22257","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Griffin M","familyName":"Kearney","name":"Kearney, Griffin M","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Kasey M","familyName":"Laurent","name":"Laurent, Kasey M","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Makan","familyName":"Fardad","name":"Fardad, Makan","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Maximum Likelihood Particle Tracking in Turbulent Flows via Sparse Optimization"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Data Analysis, Statistics and Probability (physics.data-an)","lang":"en","subjectScheme":"arXiv"},{"subject":"Fluid Dynamics (physics.flu-dyn)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-25T00:56:14Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:01:14Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by-nc-sa/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution Non Commercial Share Alike 4.0 International","rightsIdentifier":"cc-by-nc-sa-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Lagrangian particle tracking is essential for characterizing turbulent flows, but inferring particle acceleration from inherently noisy position data remains a significant challenge. Fluid particles in turbulence experience extreme, intermittent accelerations, resulting in heavy-tailed probability density functions (PDFs) that deviate strongly from Gaussian predictions. Existing filtering techniques, such as Gaussian kernels and penalized B-splines, implicitly assume Gaussian-distributed jerk, thereby penalizing sparse, high-magnitude acceleration changes and artificially suppressing the intermittent tails. In this work, we develop a novel maximum likelihood estimation (MLE) framework that explicitly accounts for this non-Gaussian intermittency. By formulating a modified Gaussian process to model the random incremental forcing, we introduce a sparse optimization scheme utilizing a convex 1-norm relaxation. To overcome the numerical stiffness associated with high-order difference operators, the problem is efficiently solved using an iteratively reweighted least squares (IRLS) algorithm. The proposed filter is evaluated against direct numerical simulation (DNS) data of homogeneous, isotropic turbulence (Re approx. 310). Results demonstrate that the IRLS approach consistently outperforms state-of-the-art discrete MLE, continuous MLE, and B-spline methods, yielding systematic reductions in root-mean-squared error (RMSE) across position, velocity, and acceleration. Most importantly, the proposed framework succeeds in better recovering the heavy-tailed statistical structure of both acceleration and acceleration differences (jerk) across temporal scales, preserving the physical intermittency characteristic of high-Reynoldsnumber turbulent flows that baseline methods severely attenuate."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.22257","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T02:42:12Z","registered":"2026-02-27T02:42:13Z","published":null,"updated":"2026-02-27T02:42:13Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.22254","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.22254","identifiers":[{"identifier":"2602.22254","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Abdulrahman","familyName":"Tamim","name":"Tamim, Abdulrahman","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Causal Direction from Convergence Time: Faster Training in the True Causal Direction"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"I.2.6; I.2.4; F.2.2","lang":"en","subjectScheme":"ACM"},{"subject":"68T07, 68Q32, 62H30","lang":"en","subjectScheme":"MSC"}],"contributors":[],"dates":[{"date":"2026-02-24T21:34:57Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:01:09Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"We introduce Causal Computational Asymmetry (CCA), a principle for causal direction identification based on optimization dynamics in which one neural network is trained to predict $Y$ from $X$ and another to predict $X$ from $Y$, and the direction that converges faster is inferred to be causal. Under the additive noise model $Y = f(X) + \\varepsilon$ with $\\varepsilon \\perp X$ and $f$ nonlinear and injective, we establish a formal asymmetry: in the reverse direction, residuals remain statistically dependent on the input regardless of approximation quality, inducing a strictly higher irreducible loss floor and non-separable gradient noise in the optimization dynamics, so that the reverse model requires strictly more gradient steps in expectation to reach any fixed loss threshold; consequently, the forward (causal) direction converges in fewer expected optimization steps. CCA operates in optimization-time space, distinguishing it from methods such as RESIT, IGCI, and SkewScore that rely on statistical independence or distributional asymmetries, and proper z-scoring of both variables is required for valid comparison of convergence rates. On synthetic benchmarks, CCA achieves 26/30 correct causal identifications across six neural architectures, including 30/30 on sine and exponential data-generating processes. We further embed CCA into a broader framework termed Causal Compression Learning (CCL), which integrates graph structure learning, causal information compression, and policy optimization, with all theoretical guarantees formally proved and empirically validated on synthetic datasets."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.22254","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T02:42:08Z","registered":"2026-02-27T02:42:08Z","published":null,"updated":"2026-02-27T02:42:08Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.22242","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.22242","identifiers":[{"identifier":"2602.22242","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Piyush","familyName":"Jaiswal","name":"Jaiswal, Piyush","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Aaditya","familyName":"Pratap","name":"Pratap, Aaditya","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Shreyansh","familyName":"Saraswati","name":"Saraswati, Shreyansh","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Harsh","familyName":"Kasyap","name":"Kasyap, Harsh","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Somanath","familyName":"Tripathy","name":"Tripathy, Somanath","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Analysis of LLMs Against Prompt Injection and Jailbreak Attacks"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Cryptography and Security (cs.CR)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-24T12:32:11Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:00:51Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Large Language Models (LLMs) are widely deployed in real-world systems. Given their broader applicability, prompt engineering has become an efficient tool for resource-scarce organizations to adopt LLMs for their own purposes. At the same time, LLMs are vulnerable to prompt-based attacks. Thus, analyzing this risk has become a critical security requirement. This work evaluates prompt-injection and jailbreak vulnerability using a large, manually curated dataset across multiple open-source LLMs, including Phi, Mistral, DeepSeek-R1, Llama 3.2, Qwen, and Gemma variants. We observe significant behavioural variation across models, including refusal responses and complete silent non-responsiveness triggered by internal safety mechanisms. Furthermore, we evaluated several lightweight, inference-time defence mechanisms that operate as filters without any retraining or GPU-intensive fine-tuning. Although these defences mitigate straightforward attacks, they are consistently bypassed by long, reasoning-heavy prompts."},{"descriptionType":"Other","description":"12 pages, 5 figures, 6 tables"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.22242","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T02:41:50Z","registered":"2026-02-27T02:41:51Z","published":null,"updated":"2026-02-27T02:41:51Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.22234","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.22234","identifiers":[{"identifier":"2602.22234","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Yusuf","familyName":"Havvat","name":"Havvat, Yusuf","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Detector-level assessment of alternative target nuclei for CEvNS experiments under realistic experimental conditions"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Instrumentation and Detectors (physics.ins-det)","lang":"en","subjectScheme":"arXiv"},{"subject":"High Energy Physics - Experiment (hep-ex)","lang":"en","subjectScheme":"arXiv"},{"subject":"High Energy Physics - Phenomenology (hep-ph)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-20T10:10:21Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:00:37Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Coherent Elastic Neutrino-Nucleus Scattering (CEvNS) provides a sensitive probe of neutrino interactions at low momentum transfer, but its experimental observation is strongly constrained by detector-related effects such as energy threshold, resolution, noise, and event-selection criteria. In this work, we perform a detector-level assessment of CEvNS nuclear recoil observability under realistic experimental conditions, with particular emphasis on the role of detector response in shaping measurable recoil spectra. Using detailed Geant4-based simulations, CEvNS interactions are modeled for a set of alternative target nuclei spanning light to intermediate mass ranges. The true nuclear recoil energy distributions are propagated through a simplified yet realistic detector-response chain incorporating energy smearing, noise-induced fluctuations, threshold cuts, and veto-based event selection. We present a systematic analysis of recoil energy spectra before and after detector effects, response matrices linking true and reconstructed energies, and energy-dependent selection efficiencies. The results demonstrate that detector response effects significantly modify the observable CEvNS signal, particularly in the near-threshold region where most recoil events are concentrated. Differences in efficiency turn-on behavior and reconstructed energy distributions highlight the target-nucleus dependence of CEvNS observability under identical detector conditions. Rather than focusing on absolute event-rate predictions, this study emphasizes the relative impact of detector effects on signal accessibility and target performance. The presented framework provides a consistent methodology for evaluating and comparing prospective CEvNS target materials at the detector level, offering practical guidance for future low-threshold CEvNS experiments and detector design optimization."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.22234","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T02:41:39Z","registered":"2026-02-27T02:41:40Z","published":null,"updated":"2026-02-27T02:41:40Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.22231","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.22231","identifiers":[{"identifier":"2602.22231","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Dong","familyName":"Yang","name":"Yang, Dong","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yue","familyName":"Wang","name":"Wang, Yue","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Songyang","familyName":"Zhang","name":"Zhang, Songyang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yingshu","familyName":"Li","name":"Li, Yingshu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zhipeng","familyName":"Cai","name":"Cai, Zhipeng","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zhi","familyName":"Tian","name":"Tian, Zhi","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"FM-RME: Foundation Model Empowered Radio Map Estimation"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Signal Processing (eess.SP)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Electrical engineering, electronic engineering, information engineering","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Electrical engineering, electronic engineering, information engineering","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-15T01:37:11Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:00:34Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Traditional radio map estimation (RME) techniques fail to capture multi-dimensional and dynamic characteristics of complex spectrum environments. Recent data-driven methods achieve accurate RME in spatial domain, but ignore physical prior knowledge of radio propagation, limiting data efficiency especially in multi-dimensional scenarios. To overcome such limitations, we propose a new foundation model, characterized by self-supervised pre-training on diverse data for zero-shot generalization, enabling multi-dimensional radio map estimation (FM-RME). Specifically, FM-RME builds an effective synergy of two core components: a geometry-aware feature extraction module that encodes physical propagation symmetries, i.e., translation and rotation invariance, as inductive bias, and an attention-based neural network that learns long-range correlations across the spatial-temporal-spectral domains. A masked self-supervised multi-dimensional pre-training strategy is further developed to learn generalizable spectrum representations across diverse wireless environments. Once pre-trained, FM-RME supports zero-shot inference for multi-dimensional RME, including spatial, temporal, and spectral estimation, without scenario-specific retraining. Simulation results verify that FM-RME exhibits desired learning performance across diverse datasets and zero-shot generalization capabilities beyond existing RME methods."},{"descriptionType":"Other","description":"7 pages, 5 figures, conference"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.22231","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T02:41:35Z","registered":"2026-02-27T02:41:36Z","published":null,"updated":"2026-02-27T02:41:36Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.22230","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.22230","identifiers":[{"identifier":"2602.22230","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Nimrod","familyName":"Talmon","name":"Talmon, Nimrod","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Haim","familyName":"Zysberg","name":"Zysberg, Haim","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"An Adaptive Multichain Blockchain: A Multiobjective Optimization Approach"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Cryptography and Security (cs.CR)","lang":"en","subjectScheme":"arXiv"},{"subject":"Computer Science and Game Theory (cs.GT)","lang":"en","subjectScheme":"arXiv"},{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"Multiagent Systems (cs.MA)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-14T06:01:09Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:00:33Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Blockchains are widely used for secure transaction processing, but their scalability remains limited, and existing multichain designs are typically static even as demand and capacity shift. We cast blockchain configuration as a multiagent resource-allocation problem: applications and operators declare demand, capacity, and price bounds; an optimizer groups them into ephemeral chains each epoch and sets a chain-level clearing price. The objective maximizes a governance-weighted combination of normalized utilities for applications, operators, and the system. The model is modular -- accommodating capability compatibility, application-type diversity, and epoch-to-epoch stability -- and can be solved off-chain with outcomes verifiable on-chain. We analyze fairness and incentive issues and present simulations that highlight trade-offs among throughput, decentralization, operator yield, and service stability."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.22230","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T02:41:34Z","registered":"2026-02-27T02:41:34Z","published":null,"updated":"2026-02-27T02:41:34Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.22226","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.22226","identifiers":[{"identifier":"2602.22226","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Yulong","familyName":"Gao","name":"Gao, Yulong","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Wan","familyName":"Jiang","name":"Jiang, Wan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Mingzhe","familyName":"Cao","name":"Cao, Mingzhe","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xuepu","familyName":"Wang","name":"Wang, Xuepu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zeyu","familyName":"Pan","name":"Pan, Zeyu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Haonan","familyName":"Yang","name":"Yang, Haonan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ye","familyName":"Liu","name":"Liu, Ye","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xin","familyName":"Yang","name":"Yang, Xin","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"SEGB: Self-Evolved Generative Bidding with Local Autoregressive Diffusion"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Information Retrieval (cs.IR)","lang":"en","subjectScheme":"arXiv"},{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-12-31T09:05:59Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:00:26Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"In the realm of online advertising, automated bidding has become a pivotal tool, enabling advertisers to efficiently capture impression opportunities in real-time. Recently, generative auto-bidding has shown significant promise, offering innovative solutions for effective ad optimization. However, existing offline-trained generative policies lack the near-term foresight required for dynamic markets and usually depend on simulators or external experts for post-training improvement. To overcome these critical limitations, we propose Self-Evolved Generative Bidding (SEGB), a framework that plans proactively and refines itself entirely offline. SEGB first synthesizes plausible short-horizon future states to guide each bid, providing the agent with crucial, dynamic foresight. Crucially, it then performs value-guided policy refinement to iteratively discover superior strategies without any external intervention. This self-contained approach uniquely enables robust policy improvement from static data alone. Experiments on the AuctionNet benchmark and a large-scale A/B test validate our approach, demonstrating that SEGB significantly outperforms state-of-the-art baselines. In a large-scale online deployment, it delivered substantial business value, achieving a +10.19% increase in target cost, proving the effectiveness of our advanced planning and evolution paradigm."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.22226","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T02:41:28Z","registered":"2026-02-27T02:41:29Z","published":null,"updated":"2026-02-27T02:41:29Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.22225","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.22225","identifiers":[{"identifier":"2602.22225","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Xuechen","familyName":"Zhang","name":"Zhang, Xuechen","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Koustava","familyName":"Goswami","name":"Goswami, Koustava","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Samet","familyName":"Oymak","name":"Oymak, Samet","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jiasi","familyName":"Chen","name":"Chen, Jiasi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Nedim","familyName":"Lipka","name":"Lipka, Nedim","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"SmartChunk Retrieval: Query-Aware Chunk Compression with Planning for Efficient Document RAG"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Information Retrieval (cs.IR)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-12-17T01:21:44Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:00:24Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by-nc-sa/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution Non Commercial Share Alike 4.0 International","rightsIdentifier":"cc-by-nc-sa-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Retrieval-augmented generation (RAG) has strong potential for producing accurate and factual outputs by combining language models (LMs) with evidence retrieved from large text corpora. However, current pipelines are limited by static chunking and flat retrieval: documents are split into short, predetermined, fixed-size chunks, embeddings are retrieved uniformly, and generation relies on whatever chunks are returned. This design brings challenges, as retrieval quality is highly sensitive to chunk size, often introduces noise from irrelevant or misleading chunks, and scales poorly to large corpora. We present SmartChunk retrieval, a query-adaptive framework for efficient and robust long-document question answering (QA). SmartChunk uses (i) a planner that predicts the optimal chunk abstraction level for each query, and (ii) a lightweight compression module that produces high-level chunk embeddings without repeated summarization. By adapting retrieval granularity on the fly, SmartChunk balances accuracy with efficiency and avoids the drawbacks of fixed strategies. Notably, our planner can reason about chunk abstractions through a novel reinforcement learning scheme, STITCH, which boosts accuracy and generalization. To reflect real-world applications, where users face diverse document types and query styles, we evaluate SmartChunk on five QA benchmarks plus one out-of-domain dataset. Across these evaluations, SmartChunk outperforms state-of-the-art RAG baselines, while reducing cost. Further analysis demonstrates strong scalability with larger corpora and consistent gains on out-of-domain datasets, highlighting its effectiveness as a general framework for adaptive retrieval."},{"descriptionType":"Other","description":"26 pages, 10 figures"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.22225","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T02:41:27Z","registered":"2026-02-27T02:41:28Z","published":null,"updated":"2026-02-27T02:41:28Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.22224","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.22224","identifiers":[{"identifier":"2602.22224","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Jinjian","familyName":"Liu","name":"Liu, Jinjian","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yichuan","familyName":"Wang","name":"Wang, Yichuan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xinxi","familyName":"Lyu","name":"Lyu, Xinxi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Rulin","familyName":"Shao","name":"Shao, Rulin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Joseph E.","familyName":"Gonzalez","name":"Gonzalez, Joseph E.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Matei","familyName":"Zaharia","name":"Zaharia, Matei","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Sewon","familyName":"Min","name":"Min, Sewon","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"DS SERVE: A Framework for Efficient and Scalable Neural Retrieval"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Information Retrieval (cs.IR)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-12-17T00:43:10Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:00:23Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"We present DS-Serve, a framework that transforms large-scale text datasets, comprising half a trillion tokens, into a high-performance neural retrieval system. DS-Serve offers both a web interface and API endpoints, achieving low latency with modest memory overhead on a single node. The framework also supports inference-time trade-offs between latency, accuracy, and result diversity. We anticipate that DS-Serve will be broadly useful for a range of applications, including large-scale retrieval-augmented generation (RAG), training data attribution, training search agents, and beyond."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.22224","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T02:41:26Z","registered":"2026-02-27T02:41:26Z","published":null,"updated":"2026-02-27T02:41:26Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.22223","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.22223","identifiers":[{"identifier":"2602.22223","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Cornelius","familyName":"Wolff","name":"Wolff, Cornelius","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Daniel","familyName":"Gomm","name":"Gomm, Daniel","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Madelon","familyName":"Hulsebos","name":"Hulsebos, Madelon","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"SQaLe: A Large Text-to-SQL Corpus Grounded in Real Schemas"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Information Retrieval (cs.IR)","lang":"en","subjectScheme":"arXiv"},{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-12-16T09:15:10Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:00:22Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by-sa/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution Share Alike 4.0 International","rightsIdentifier":"cc-by-sa-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Advances in large language models have accelerated progress in text-to-SQL, methods for converting natural language queries into valid SQL queries. A key bottleneck for developing generalizable text-to-SQL models is the lack of large-scale datasets with sufficient schema and query complexity, domain coverage, and task diversity. We introduce SQaLe: a large-scale semi-synthetic text-to-SQL dataset built on 135,875 relational database schemas expanded from a collection of real-world schemas, SchemaPile. We establish a principled generation pipeline which combines schema sampling, question synthesis, and SQL construction, and produce 517,676 high-quality (question, schema, query) triples. The SQaLe dataset captures realistic schema size variability, diverse query patterns, and natural language ambiguity while maintaining execution validity. We provide an analysis of its contents and characteristics, and find that SQaLe introduces the most realistic large-scale text-to-SQL dataset to date in comparison with existing benchmarks and datasets. We discuss how SQaLe enables our vision for data scaling and model generalization in text-to-SQL research. The dataset is accessible at: https://huggingface.co/datasets/trl-lab/SQaLe-text-to-SQL-dataset."},{"descriptionType":"Other","description":"Accepted at the AI for Tabular Data workshop at EurIPS 2025"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.22223","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T02:41:24Z","registered":"2026-02-27T02:41:25Z","published":null,"updated":"2026-02-27T02:41:25Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.22219","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.22219","identifiers":[{"identifier":"2602.22219","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Teri","familyName":"Rumble","name":"Rumble, Teri","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zbyněk","familyName":"Gazdík","name":"Gazdík, Zbyněk","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Javad","familyName":"Zarrin","name":"Zarrin, Javad","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jagdeep","familyName":"Ahluwalia","name":"Ahluwalia, Jagdeep","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Comparative Analysis of Neural Retriever-Reranker Pipelines for Retrieval-Augmented Generation over Knowledge Graphs in E-commerce Applications"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Information Retrieval (cs.IR)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-12-14T23:47:40Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:00:15Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Recent advancements in Large Language Models (LLMs) have transformed Natural Language Processing (NLP), enabling complex information retrieval and generation tasks. Retrieval-Augmented Generation (RAG) has emerged as a key innovation, enhancing factual accuracy and contextual grounding by integrating external knowledge sources with generative models. Although RAG demonstrates strong performance on unstructured text, its application to structured knowledge graphs presents challenges: scaling retrieval across connected graphs and preserving contextual relationships during response generation. Cross-encoders refine retrieval precision, yet their integration with structured data remains underexplored. Addressing these challenges is crucial for developing domain-specific assistants that operate in production environments. This study presents the design and comparative evaluation of multiple Retriever-Reranker pipelines for knowledge graph natural language queries in e-Commerce contexts. Using the STaRK Semi-structured Knowledge Base (SKB), a production-scale e-Commerce dataset, we evaluate multiple RAG pipeline configurations optimized for language queries. Experimental results demonstrate substantial improvements over published benchmarks, achieving 20.4% higher Hit@1 and 14.5% higher Mean Reciprocal Rank (MRR). These findings establish a practical framework for integrating domain-specific SKBs into generative systems. Our contributions provide actionable insights for the deployment of production-ready RAG systems, with implications that extend beyond e-Commerce to other domains that require information retrieval from structured knowledge bases."},{"descriptionType":"Other","description":"This manuscript is under review at the Springer journal Knowledge and Information Systems"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.22219","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T02:41:18Z","registered":"2026-02-27T02:41:19Z","published":null,"updated":"2026-02-27T02:41:19Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.22218","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.22218","identifiers":[{"identifier":"2602.22218","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Ashim","familyName":"Mahara","name":"Mahara, Ashim","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Cybersecurity Data Extraction from Common Crawl"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Cryptography and Security (cs.CR)","lang":"en","subjectScheme":"arXiv"},{"subject":"Information Retrieval (cs.IR)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-12-14T23:19:36Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:00:13Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by-nc-sa/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution Non Commercial Share Alike 4.0 International","rightsIdentifier":"cc-by-nc-sa-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Alpha-Root is a cybersecurity-focused dataset collected in a single shot from the Common Crawl web graph using community detection. Unlike iterative content-scoring approaches like DeepSeekMath, we mine quality domains directly from the web graph, starting from just 20 trusted seed domains."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.22218","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T02:41:17Z","registered":"2026-02-27T02:41:18Z","published":null,"updated":"2026-02-27T02:41:18Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.22217","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.22217","identifiers":[{"identifier":"2602.22217","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Ahmed Bin","familyName":"Khalid","name":"Khalid, Ahmed Bin","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"RAGdb: A Zero-Dependency, Embeddable Architecture for Multimodal Retrieval-Augmented Generation on the Edge"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Information Retrieval (cs.IR)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-12-09T15:12:13Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:00:12Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Retrieval-Augmented Generation (RAG) has established itself as the standard paradigm for grounding Large Language Models (LLMs) in domain-specific, up-to-date data. However, the prevailing architecture for RAG has evolved into a complex, distributed stack requiring cloud-hosted vector databases, heavy deep learning frameworks (e.g., PyTorch, CUDA), and high-latency embedding inference servers. This ``infrastructure bloat'' creates a significant barrier to entry for edge computing, air-gapped environments, and privacy-constrained applications where data sovereignty is paramount.\n This paper introduces RAGdb, a novel monolithic architecture that consolidates automated multimodal ingestion, ONNX-based extraction, and hybrid vector retrieval into a single, portable SQLite container. We propose a deterministic Hybrid Scoring Function (HSF) that combines sublinear TF-IDF vectorization with exact substring boosting, eliminating the need for GPU inference at query time. Experimental evaluation on an Intel i7-1165G7 consumer laptop demonstrates that RAGdb achieves 100\\% Recall@1 for entity retrieval and an ingestion efficiency gain of 31.6x during incremental updates compared to cold starts. Furthermore, the system reduces disk footprint by approximately 99.5\\% compared to standard Docker-based RAG stacks, establishing the ``Single-File Knowledge Container'' as a viable primitive for decentralized, local-first AI.\n Keywords: Edge AI, Retrieval-Augmented Generation, Vector Search, Green AI, Serverless Architecture, Knowledge Graphs, Efficient Computing."},{"descriptionType":"Other","description":"6 pages, 2 tables"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.22217","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T02:41:16Z","registered":"2026-02-27T02:41:16Z","published":null,"updated":"2026-02-27T02:41:16Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.22216","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.22216","identifiers":[{"identifier":"2602.22216","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Diogo","familyName":"Pires","name":"Pires, Diogo","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yuriy","familyName":"Perezhohin","name":"Perezhohin, Yuriy","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Mauro","familyName":"Castelli","name":"Castelli, Mauro","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Retrieval-Augmented Generation Assistant for Anatomical Pathology Laboratories"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Information Retrieval (cs.IR)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-12-08T22:44:57Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:00:11Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by-nc-sa/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution Non Commercial Share Alike 4.0 International","rightsIdentifier":"cc-by-nc-sa-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Accurate and efficient access to laboratory protocols is essential in Anatomical Pathology (AP), where up to 70% of medical decisions depend on laboratory diagnoses. However, static documentation such as printed manuals or PDFs is often outdated, fragmented, and difficult to search, creating risks of workflow errors and diagnostic delays. This study proposes and evaluates a Retrieval-Augmented Generation (RAG) assistant tailored to AP laboratories, designed to provide technicians with context-grounded answers to protocol-related queries. We curated a novel corpus of 99 AP protocols from a Portuguese healthcare institution and constructed 323 question-answer pairs for systematic evaluation. Ten experiments were conducted, varying chunking strategies, retrieval methods, and embedding models. Performance was assessed using the RAGAS framework (faithfulness, answer relevance, context recall) alongside top-k retrieval metrics. Results show that recursive chunking and hybrid retrieval delivered the strongest baseline performance. Incorporating a biomedical-specific embedding model (MedEmbed) further improved answer relevance (0.74), faithfulness (0.70), and context recall (0.77), showing the importance of domain-specialised embeddings. Top-k analysis revealed that retrieving a single top-ranked chunk (k=1) maximized efficiency and accuracy, reflecting the modular structure of AP protocols. These findings highlight critical design considerations for deploying RAG systems in healthcare and demonstrate their potential to transform static documentation into dynamic, reliable knowledge assistants, thus improving laboratory workflow efficiency and supporting patient safety."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.22216","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T02:41:14Z","registered":"2026-02-27T02:41:15Z","published":null,"updated":"2026-02-27T02:41:15Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.22215","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.22215","identifiers":[{"identifier":"2602.22215","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Pengzhen","familyName":"Xie","name":"Xie, Pengzhen","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Huizhi","familyName":"Liang","name":"Liang, Huizhi","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Graph Your Way to Inspiration: Integrating Co-Author Graphs with Retrieval-Augmented Generation for Large Language Model Based Scientific Idea Generation"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"Information Retrieval (cs.IR)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"I.2.6, I.2.7","lang":"en","subjectScheme":"MSC"}],"contributors":[],"dates":[{"date":"2025-12-05T03:38:23Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:00:07Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Large Language Models (LLMs) demonstrate potential in the field of scientific idea generation. However, the generated results often lack controllable academic context and traceable inspiration pathways. To bridge this gap, this paper proposes a scientific idea generation system called GYWI, which combines author knowledge graphs with retrieval-augmented generation (RAG) to form an external knowledge base to provide controllable context and trace of inspiration path for LLMs to generate new scientific ideas. We first propose an author-centered knowledge graph construction method and inspiration source sampling algorithms to construct external knowledge base. Then, we propose a hybrid retrieval mechanism that is composed of both RAG and GraphRAG to retrieve content with both depth and breadth knowledge. It forms a hybrid context. Thirdly, we propose a Prompt optimization strategy incorporating reinforcement learning principles to automatically guide LLMs optimizing the results based on the hybrid context. To evaluate the proposed approaches, we constructed an evaluation dataset based on arXiv (2018-2023). This paper also develops a comprehensive evaluation method including empirical automatic assessment in multiple-choice question task, LLM-based scoring, human evaluation, and semantic space visualization analysis. The generated ideas are evaluated from the following five dimensions: novelty, feasibility, clarity, relevance, and significance. We conducted experiments on different LLMs including GPT-4o, DeepSeek-V3, Qwen3-8B, and Gemini 2.5. Experimental results show that GYWI significantly outperforms mainstream LLMs in multiple metrics such as novelty, reliability, and relevance."},{"descriptionType":"Other","description":"15 pages, 10 figures. Submitted to [RAAI]"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.22215","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T02:41:13Z","registered":"2026-02-27T02:41:13Z","published":null,"updated":"2026-02-27T02:41:14Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.22214","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.22214","identifiers":[{"identifier":"2602.22214","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Teodor-Ioan","familyName":"Calin","name":"Calin, Teodor-Ioan","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Adaptive Prefiltering for High-Dimensional Similarity Search: A Frequency-Aware Approach"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Information Retrieval (cs.IR)","lang":"en","subjectScheme":"arXiv"},{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"H.3.3; I.5.3; H.2.4","lang":"en","subjectScheme":"ACM"}],"contributors":[],"dates":[{"date":"2025-12-03T10:11:35Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:00:06Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"High-dimensional similarity search underpins modern retrieval systems, yet uniform search strategies fail to exploit the heterogeneous nature of real-world query distributions. We present an adaptive prefiltering framework that leverages query frequency patterns and cluster coherence metrics to dynamically allocate computational budgets. Our approach partitions the query space into frequency tiers following Zipfian distributions and assigns differentiated search policies based on historical access patterns and local density characteristics. Experiments on ImageNet-1k using CLIP embeddings demonstrate that frequency-aware budget allocation achieves equivalent recall with 20.4% fewer distance computations compared to static nprobe selection, while maintaining sub-millisecond latency on GPU-accelerated FAISS indices. The framework introduces minimal overhead through lightweight frequency tracking and provides graceful degradation for unseen queries through coherence-based fallback policies."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.22214","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T02:41:11Z","registered":"2026-02-27T02:41:12Z","published":null,"updated":"2026-02-27T02:41:12Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.22213","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.22213","identifiers":[{"identifier":"2602.22213","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Zeinab","familyName":"Ghamlouch","name":"Ghamlouch, Zeinab","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Mehwish","familyName":"Alam","name":"Alam, Mehwish","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Enriching Taxonomies Using Large Language Models"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Information Retrieval (cs.IR)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-11-21T10:25:59Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:00:04Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[{"relationType":"IsVersionOf","relatedIdentifier":"10.3233/faia251441","relatedIdentifierType":"DOI"}],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Taxonomies play a vital role in structuring and categorizing information across domains. However, many existing taxonomies suffer from limited coverage and outdated or ambiguous nodes, reducing their effectiveness in knowledge retrieval. To address this, we present Taxoria, a novel taxonomy enrichment pipeline that leverages Large Language Models (LLMs) to enhance a given taxonomy. Unlike approaches that extract internal LLM taxonomies, Taxoria uses an existing taxonomy as a seed and prompts an LLM to propose candidate nodes for enrichment. These candidates are then validated to mitigate hallucinations and ensure semantic relevance before integration. The final output includes an enriched taxonomy with provenance tracking and visualization of the final merged taxonomy for analysis."},{"descriptionType":"Other","description":"Published in ECAI 2025 Demo Track"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.22213","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":1,"created":"2026-02-27T02:41:10Z","registered":"2026-02-27T02:41:11Z","published":null,"updated":"2026-02-27T02:41:11Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}}],"meta":{"total":335,"totalPages":1,"page":1},"links":{"self":"https://api.datacite.org/dois?query=doi%3A10.48550%2Farxiv.2602*%20AND%20registered%3A%5B2026-02-27T01%3A00%3A00Z%20TO%202026-02-28T01%3A00%3A00Z%5D%20AND%20(agent%20OR%20retrieval%20OR%20compiler%20OR%20kernel%20OR%20GPU%20OR%20optimization%20OR%20generalization%20OR%20scaling)\u0026page[size]=1000"}}