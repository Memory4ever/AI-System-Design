<th id="S4.T2.3.1.2" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_r ltx_border_t" rowspan="2"><span id="S4.T2.3.1.2.1" class="ltx_text ltx_font_typewriter" style="font-size:90%;">SOT</span></th>
<th id="S4.T2.3.1.3" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_r ltx_border_t" rowspan="2"><span id="S4.T2.3.1.3.1" class="ltx_text" style="font-size:90%;"><math id="S4.T2.m1" class="ltx_Math" alttext="\mathtt{s}_{1}" display="inline" intent=":literal"><semantics><msub><mi>𝚜</mi><mn>1</mn></msub><annotation encoding="application/x-tex">\mathtt{s}_{1}</annotation></semantics></math></span></th>
<th id="S4.T2.3.1.4" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_r ltx_border_t" rowspan="2"><span id="S4.T2.3.1.4.1" class="ltx_text" style="font-size:90%;"><math id="S4.T2.m2" class="ltx_Math" alttext="\mathtt{s}_{2}" display="inline" intent=":literal"><semantics><msub><mi>𝚜</mi><mn>2</mn></msub><annotation encoding="application/x-tex">\mathtt{s}_{2}</annotation></semantics></math></span></th>
<th id="S4.T2.3.1.5" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_r ltx_border_t" rowspan="2"><span id="S4.T2.3.1.5.1" class="ltx_text" style="font-size:90%;"><math id="S4.T2.m3" class="ltx_Math" alttext="\mathtt{s}_{3}" display="inline" intent=":literal"><semantics><msub><mi>𝚜</mi><mn>3</mn></msub><annotation encoding="application/x-tex">\mathtt{s}_{3}</annotation></semantics></math></span></th>
<th id="S4.T2.3.1.6" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_r ltx_border_t" rowspan="2"><span id="S4.T2.3.1.6.1" class="ltx_text" style="font-size:90%;"><math id="S4.T2.m4" class="ltx_Math" alttext="\mathtt{s}_{4}" display="inline" intent=":literal"><semantics><msub><mi>𝚜</mi><mn>4</mn></msub><annotation encoding="application/x-tex">\mathtt{s}_{4}</annotation></semantics></math></span></th>
<th id="S4.T2.3.1.7" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_r ltx_border_t" rowspan="2"><span id="S4.T2.3.1.7.1" class="ltx_text ltx_font_typewriter" style="font-size:90%;">EOT</span></th>
<th id="S4.T2.3.1.8" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_r ltx_border_t" rowspan="2"><span id="S4.T2.3.1.8.1" class="ltx_text ltx_font_typewriter" style="font-size:90%;">PAD</span></th></tr>
<tr id="S4.T2.3.2" class="ltx_tr">
<th id="S4.T2.3.2.1" class="ltx_td ltx_align_center ltx_th ltx_th_row ltx_border_l ltx_border_rr" style="--ltx-bg-color:#A8FFEB;"><span id="S4.T2.3.2.1.1" class="ltx_text" style="font-size:90%;--ltx-bg-color:#A8FFEB;"><span id="S4.T2.3.2.1.1.1" class="ltx_text ltx_font_bold">Caption</span></span></th></tr>
<tr id="S4.T2.3.3" class="ltx_tr">
<th id="S4.T2.3.3.1" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_th_row ltx_border_l ltx_border_rr ltx_border_tt" style="--ltx-bg-color:#F1D4C6;"><span id="S4.T2.3.3.1.1" class="ltx_text" style="font-size:90%;--ltx-bg-color:#F1D4C6;"><span id="S4.T2.3.3.1.1.1" class="ltx_text ltx_font_bold">Our</span></span></th>
<th id="S4.T2.3.3.2" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_b ltx_border_r ltx_border_tt" rowspan="2"><span id="S4.T2.3.3.2.1" class="ltx_text ltx_font_typewriter" style="font-size:90%;">SOT</span></th>
<th id="S4.T2.3.3.3" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_b ltx_border_r ltx_border_tt" rowspan="2"><span id="S4.T2.3.3.3.1" class="ltx_text ltx_font_typewriter" style="font-size:90%;">PAD</span></th>
<th id="S4.T2.3.3.4" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_b ltx_border_r ltx_border_tt" rowspan="2"><span id="S4.T2.3.3.4.1" class="ltx_text ltx_font_typewriter" style="font-size:90%;">PAD</span></th>
<th id="S4.T2.3.3.5" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_b ltx_border_r ltx_border_tt" rowspan="2"><span id="S4.T2.3.3.5.1" class="ltx_text" style="font-size:90%;"><math id="S4.T2.m5" class="ltx_Math" alttext="\mathtt{s}_{4}" display="inline" intent=":literal"><semantics><msub><mi>𝚜</mi><mn>4</mn></msub><annotation encoding="application/x-tex">\mathtt{s}_{4}</annotation></semantics></math></span></th>
<th id="S4.T2.3.3.6" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_b ltx_border_r ltx_border_tt" rowspan="2"><span id="S4.T2.3.3.6.1" class="ltx_text" style="font-size:90%;"><math id="S4.T2.m6" class="ltx_Math" alttext="\mathtt{s}_{2}" display="inline" intent=":literal"><semantics><msub><mi>𝚜</mi><mn>2</mn></msub><annotation encoding="application/x-tex">\mathtt{s}_{2}</annotation></semantics></math></span></th>
<th id="S4.T2.3.3.7" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_b ltx_border_r ltx_border_tt" rowspan="2"><span id="S4.T2.3.3.7.1" class="ltx_text ltx_font_typewriter" style="font-size:90%;">EOT</span></th>
<th id="S4.T2.3.3.8" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_b ltx_border_r ltx_border_tt" rowspan="2"><span id="S4.T2.3.3.8.1" class="ltx_text ltx_font_typewriter" style="font-size:90%;">PAD</span></th></tr>
<tr id="S4.T2.3.4" class="ltx_tr">
<th id="S4.T2.3.4.1" class="ltx_td ltx_align_center ltx_th ltx_th_row ltx_border_b ltx_border_l ltx_border_rr" style="--ltx-bg-color:#F1D4C6;"><span id="S4.T2.3.4.1.1" class="ltx_text" style="font-size:90%;--ltx-bg-color:#F1D4C6;"><span id="S4.T2.3.4.1.1.1" class="ltx_text ltx_font_bold">Caption</span></span></th></tr>
</thead>
</table>
<figcaption class="ltx_caption ltx_centering" style="font-size:90%;"><span class="ltx_tag ltx_tag_table">Table 2: </span><span id="S4.T2.14" class="ltx_text ltx_font_bold">Visualization of our caption augmentation method</span>. We drop the summary sentence <math id="S4.T2.m8" class="ltx_Math" alttext="\mathtt{s}_{1}" display="inline" intent=":literal"><semantics><msub><mi>𝚜</mi><mn>1</mn></msub><annotation encoding="application/x-tex">\mathtt{s}_{1}</annotation></semantics></math>, randomly sample from the other sentences, and add padding (<span id="S4.T2.15" class="ltx_text ltx_font_typewriter">PAD</span>) before the first sampled sentence. We do not enforce the preservation of sentence order when sampling. Here, <span id="S4.T2.16" class="ltx_text ltx_font_typewriter">SOT</span> and <span id="S4.T2.17" class="ltx_text ltx_font_typewriter">EOT</span> refer to start-of-text and end-of-text tokens, respectively.
</figcaption>
</figure>
<div id="S4.p1" class="ltx_para">
<p id="S4.p1.1" class="ltx_p">In this section, we present three caption-level training augmentations to mitigate the summary sentence shortcut: <span id="S4.p1.1.1" class="ltx_text ltx_font_bold">dropping</span> the summary sentence, randomly <span id="S4.p1.1.2" class="ltx_text ltx_font_bold">sampling</span> from the remaining long-caption sentences, and <span id="S4.p1.1.3" class="ltx_text ltx_font_bold">padding</span> the beginning of the text sequence. Our method is summarized in <a href="#S4.T2" title="In 4 Method ‣ CLIP Is Shortsighted: Paying Attention Beyond the First Sentence" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Tab.</span> <span class="ltx_text ltx_ref_tag">2</span></a>. We generally follow the Long-CLIP <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib1" title="" class="ltx_ref">56</a>]</cite> method.</p>
</div>
<section id="S4.SS1" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">4.1 </span>Problem Definition</h3>

<div id="S4.SS1.p1" class="ltx_para">
<p id="S4.SS1.p1.1" class="ltx_p">Our analysis and proposed sampling strategy assume that long captions can be treated as a set of concatenated sentences, each contributing meaningful semantic concepts. Although cross-sentence context can be beneficial, we approximate sentences as independent semantic units for sampling purposes. Given a long caption <math id="S4.SS1.p1.m1" class="ltx_Math" alttext="C" display="inline" intent=":literal"><semantics><mi>C</mi><annotation encoding="application/x-tex">C</annotation></semantics></math> with <math id="S4.SS1.p1.m2" class="ltx_Math" alttext="k" display="inline" intent=":literal"><semantics><mi>k</mi><annotation encoding="application/x-tex">k</annotation></semantics></math> sentences <math id="S4.SS1.p1.m3" class="ltx_Math" alttext="{n_{\mathrm{sents}}=k}" display="inline" intent=":literal"><semantics><mrow><msub><mi>n</mi><mi>sents</mi></msub><mo>=</mo><mi>k</mi></mrow><annotation encoding="application/x-tex">{n_{\mathrm{sents}}=k}</annotation></semantics></math>, we model it as <math id="S4.SS1.p1.m4" class="ltx_Math" alttext="{C=[s_{1},\,s_{2},\,\dots,\,s_{k}]}" display="inline" intent=":literal"><semantics><mrow><mi>C</mi><mo>=</mo><mrow><mo stretchy="false">[</mo><mrow><msub><mi>s</mi><mn>1</mn></msub><mo rspace="0.337em">,</mo><msub><mi>s</mi><mn>2</mn></msub><mo rspace="0.337em">,</mo><mi mathvariant="normal">…</mi><mo rspace="0.337em">,</mo><msub><mi>s</mi><mi>k</mi></msub></mrow><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">{C=[s_{1},\,s_{2},\,\dots,\,s_{k}]}</annotation></semantics></math>.
The caption <math id="S4.SS1.p1.m5" class="ltx_Math" alttext="C" display="inline" intent=":literal"><semantics><mi>C</mi><annotation encoding="application/x-tex">C</annotation></semantics></math> can be tokenized with a tokenizer <math id="S4.SS1.p1.m6" class="ltx_Math" alttext="\varphi" display="inline" intent=":literal"><semantics><mi>φ</mi><annotation encoding="application/x-tex">\varphi</annotation></semantics></math> as <math id="S4.SS1.p1.m7" class="ltx_Math" alttext="{T=\varphi\left(C\right)}" display="inline" intent=":literal"><semantics><mrow><mi>T</mi><mo>=</mo><mrow><mi>φ</mi><mo>⁡</mo><mrow><mo>(</mo><mi>C</mi><mo>)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">{T=\varphi\left(C\right)}</annotation></semantics></math>, giving <math id="S4.SS1.p1.m8" class="ltx_Math" alttext="{T=[\mathtt{SOT},\,\mathtt{t}_{1},\,\mathtt{t}_{2},\,\dots,\,\mathtt{t}_{k},\,\mathtt{EOT},\,\mathtt{PAD}]}" display="inline" intent=":literal"><semantics><mrow><mi>T</mi><mo>=</mo><mrow><mo stretchy="false">[</mo><mrow><mi>𝚂𝙾𝚃</mi><mo rspace="0.337em">,</mo><msub><mi>𝚝</mi><mn>1</mn></msub><mo rspace="0.337em">,</mo><msub><mi>𝚝</mi><mn>2</mn></msub><mo rspace="0.337em">,</mo><mi mathvariant="normal">…</mi><mo rspace="0.337em">,</mo><msub><mi>𝚝</mi><mi>k</mi></msub><mo rspace="0.337em">,</mo><mi>𝙴𝙾𝚃</mi><mo rspace="0.337em">,</mo><mi>𝙿𝙰𝙳</mi></mrow><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">{T=[\mathtt{SOT},\,\mathtt{t}_{1},\,\mathtt{t}_{2},\,\dots,\,\mathtt{t}_{k},\,\mathtt{EOT},\,\mathtt{PAD}]}</annotation></semantics></math>, where <math id="S4.SS1.p1.m9" class="ltx_Math" alttext="\mathtt{SOT}" display="inline" intent=":literal"><semantics><mi>𝚂𝙾𝚃</mi><annotation encoding="application/x-tex">\mathtt{SOT}</annotation></semantics></math>, <math id="S4.SS1.p1.m10" class="ltx_Math" alttext="\mathtt{EOT}" display="inline" intent=":literal"><semantics><mi>𝙴𝙾𝚃</mi><annotation encoding="application/x-tex">\mathtt{EOT}</annotation></semantics></math> and <math id="S4.SS1.p1.m11" class="ltx_Math" alttext="\mathtt{PAD}" display="inline" intent=":literal"><semantics><mi>𝙿𝙰𝙳</mi><annotation encoding="application/x-tex">\mathtt{PAD}</annotation></semantics></math> are respectively the start-of-text, end-of-text and padding tokens. For Long-CLIP, the short and long training captions are given by</p>
<table id="S4.EGx1" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="S4.E1"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S4.E1.m1" class="ltx_Math" alttext="\displaystyle C_{LC}^{s}" display="inline" intent=":literal"><semantics><msubsup><mi>C</mi><mrow><mi>L</mi><mo lspace="0em" rspace="0em">​</mo><mi>C</mi></mrow><mi>s</mi></msubsup><annotation encoding="application/x-tex">\displaystyle C_{LC}^{s}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S4.E1.m2" class="ltx_Math" alttext="\displaystyle=[s_{1}]," display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>=</mo><mrow><mo stretchy="false">[</mo><msub><mi>s</mi><mn>1</mn></msub><mo stretchy="false">]</mo></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle=[s_{1}],</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(1)</span></td></tr></tbody>
<tbody id="S4.E2"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S4.E2.m1" class="ltx_Math" alttext="\displaystyle C_{LC}^{\ell}" display="inline" intent=":literal"><semantics><msubsup><mi>C</mi><mrow><mi>L</mi><mo lspace="0em" rspace="0em">​</mo><mi>C</mi></mrow><mi mathvariant="normal">ℓ</mi></msubsup><annotation encoding="application/x-tex">\displaystyle C_{LC}^{\ell}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S4.E2.m2" class="ltx_Math" alttext="\displaystyle=[s_{1},\,s_{2},\,\dots,\,s_{k}]." display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>=</mo><mrow><mo stretchy="false">[</mo><mrow><msub><mi>s</mi><mn>1</mn></msub><mo rspace="0.337em">,</mo><msub><mi>s</mi><mn>2</mn></msub><mo rspace="0.337em">,</mo><mi mathvariant="normal">…</mi><mo rspace="0.337em">,</mo><msub><mi>s</mi><mi>k</mi></msub></mrow><mo stretchy="false">]</mo></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle=[s_{1},\,s_{2},\,\dots,\,s_{k}].</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(2)</span></td></tr></tbody>
</table>
<p id="S4.SS1.p1.2" class="ltx_p">Long-CLIP encodes short and long captions, and images as feature vectors <math id="S4.SS1.p1.m12" class="ltx_Math" alttext="u^{s}" display="inline" intent=":literal"><semantics><msup><mi>u</mi><mi>s</mi></msup><annotation encoding="application/x-tex">u^{s}</annotation></semantics></math>, <math id="S4.SS1.p1.m13" class="ltx_Math" alttext="u^{\ell}" display="inline" intent=":literal"><semantics><msup><mi>u</mi><mi mathvariant="normal">ℓ</mi></msup><annotation encoding="application/x-tex">u^{\ell}</annotation></semantics></math>, and <math id="S4.SS1.p1.m14" class="ltx_Math" alttext="v" display="inline" intent=":literal"><semantics><mi>v</mi><annotation encoding="application/x-tex">v</annotation></semantics></math> respectively, and the contrastive loss <math id="S4.SS1.p1.m15" class="ltx_Math" alttext="\mathcal{L}^{\mathrm{cont}}" display="inline" intent=":literal"><semantics><msup><mi class="ltx_font_mathcaligraphic">ℒ</mi><mi>cont</mi></msup><annotation encoding="application/x-tex">\mathcal{L}^{\mathrm{cont}}</annotation></semantics></math> is evaluated independently for both captions:</p>
<table id="S4.EGx2" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="S4.Ex1"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S4.Ex1.m1" class="ltx_Math" alttext="\displaystyle\mathcal{L}^{\mathrm{cont}}\left(a,b\right)" display="inline" intent=":literal"><semantics><mrow><msup><mi class="ltx_font_mathcaligraphic">ℒ</mi><mi>cont</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mi>a</mi><mo>,</mo><mi>b</mi><mo>)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\mathcal{L}^{\mathrm{cont}}\left(a,b\right)</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S4.Ex1.m2" class="ltx_math_unparsed" alttext="\displaystyle=-\dfrac{1}{N}\sum_{i=1}^{N}\log\dfrac{\exp\left(\mathrm{sim}\left(a_{i},b_{i}\right)/\tau\right)}{\sum_{j=1}^{N}\exp\left(\mathrm{sim}\left(a_{i},b_{j}\right)/\tau\right)}," display="inline" intent=":literal"><semantics><mrow><mo rspace="0em">=</mo><mo lspace="0em">−</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>N</mi></mfrac></mstyle><mstyle displaystyle="true"><mo movablelimits="false">∑</mo></mstyle><msub><mrow></mrow><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow></msub><msup><mrow></mrow><mi>N</mi></msup><mi>log</mi><mstyle displaystyle="true"><mfrac><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mrow><mi>sim</mi><mo>⁡</mo><mrow><mo>(</mo><msub><mi>a</mi><mi>i</mi></msub><mo>,</mo><msub><mi>b</mi><mi>i</mi></msub><mo>)</mo></mrow></mrow><mo>/</mo><mi>τ</mi></mrow><mo>)</mo></mrow></mrow><mrow><msubsup><mo>∑</mo><mrow><mi>j</mi><mo>=</mo><mn>1</mn></mrow><mi>N</mi></msubsup><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mrow><mi>sim</mi><mo>⁡</mo><mrow><mo>(</mo><msub><mi>a</mi><mi>i</mi></msub><mo>,</mo><msub><mi>b</mi><mi>j</mi></msub><mo>)</mo></mrow></mrow><mo>/</mo><mi>τ</mi></mrow><mo>)</mo></mrow></mrow></mrow></mfrac></mstyle><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle=-\dfrac{1}{N}\sum_{i=1}^{N}\log\dfrac{\exp\left(\mathrm{sim}\left(a_{i},b_{i}\right)/\tau\right)}{\sum_{j=1}^{N}\exp\left(\mathrm{sim}\left(a_{i},b_{j}\right)/\tau\right)},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="S4.E3"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S4.E3.m1" class="ltx_Math" alttext="\displaystyle\mathcal{L}^{s}" display="inline" intent=":literal"><semantics><msup><mi class="ltx_font_mathcaligraphic">ℒ</mi><mi>s</mi></msup><annotation encoding="application/x-tex">\displaystyle\mathcal{L}^{s}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S4.E3.m2" class="ltx_Math" alttext="\displaystyle=\mathcal{L}^{\mathrm{cont}}\left(u^{s},f\left(v\right)\right)+\mathcal{L}^{\mathrm{cont}}\left(f\left(v\right),u^{s}\right)," display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><msup><mi class="ltx_font_mathcaligraphic">ℒ</mi><mi>cont</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><msup><mi>u</mi><mi>s</mi></msup><mo>,</mo><mrow><mi>f</mi><mo>⁡</mo><mrow><mo>(</mo><mi>v</mi><mo>)</mo></mrow></mrow><mo>)</mo></mrow></mrow><mo>+</mo><mrow><msup><mi class="ltx_font_mathcaligraphic">ℒ</mi><mi>cont</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mi>f</mi><mo>⁡</mo><mrow><mo>(</mo><mi>v</mi><mo>)</mo></mrow></mrow><mo>,</mo><msup><mi>u</mi><mi>s</mi></msup><mo>)</mo></mrow></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle=\mathcal{L}^{\mathrm{cont}}\left(u^{s},f\left(v\right)\right)+\mathcal{L}^{\mathrm{cont}}\left(f\left(v\right),u^{s}\right),</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(3)</span></td></tr></tbody>
<tbody id="S4.E4"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S4.E4.m1" class="ltx_Math" alttext="\displaystyle\mathcal{L}^{\ell}" display="inline" intent=":literal"><semantics><msup><mi class="ltx_font_mathcaligraphic">ℒ</mi><mi mathvariant="normal">ℓ</mi></msup><annotation encoding="application/x-tex">\displaystyle\mathcal{L}^{\ell}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S4.E4.m2" class="ltx_Math" alttext="\displaystyle=\mathcal{L}^{\mathrm{cont}}\left(u^{\ell},v\right)+\mathcal{L}^{\mathrm{cont}}\left(v,u^{\ell}\right)," display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><msup><mi class="ltx_font_mathcaligraphic">ℒ</mi><mi>cont</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><msup><mi>u</mi><mi mathvariant="normal">ℓ</mi></msup><mo>,</mo><mi>v</mi><mo>)</mo></mrow></mrow><mo>+</mo><mrow><msup><mi class="ltx_font_mathcaligraphic">ℒ</mi><mi>cont</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mi>v</mi><mo>,</mo><msup><mi>u</mi><mi mathvariant="normal">ℓ</mi></msup><mo>)</mo></mrow></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle=\mathcal{L}^{\mathrm{cont}}\left(u^{\ell},v\right)+\mathcal{L}^{\mathrm{cont}}\left(v,u^{\ell}\right),</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(4)</span></td></tr></tbody>
<tbody id="S4.E5"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S4.E5.m1" class="ltx_Math" alttext="\displaystyle\mathcal{L}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">ℒ</mi><annotation encoding="application/x-tex">\displaystyle\mathcal{L}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S4.E5.m2" class="ltx_Math" alttext="\displaystyle=\mathcal{L}^{s}+\mathcal{L}^{\ell}," display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>=</mo><mrow><msup><mi class="ltx_font_mathcaligraphic">ℒ</mi><mi>s</mi></msup><mo>+</mo><msup><mi class="ltx_font_mathcaligraphic">ℒ</mi><mi mathvariant="normal">ℓ</mi></msup></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle=\mathcal{L}^{s}+\mathcal{L}^{\ell},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(5)</span></td></tr></tbody>
</table>
<p id="S4.SS1.p1.3" class="ltx_p">where <math id="S4.SS1.p1.m16" class="ltx_Math" alttext="\mathrm{sim}" display="inline" intent=":literal"><semantics><mi>sim</mi><annotation encoding="application/x-tex">\mathrm{sim}</annotation></semantics></math>, <math id="S4.SS1.p1.m17" class="ltx_Math" alttext="\tau" display="inline" intent=":literal"><semantics><mi>τ</mi><annotation encoding="application/x-tex">\tau</annotation></semantics></math>, <math id="S4.SS1.p1.m18" class="ltx_Math" alttext="N" display="inline" intent=":literal"><semantics><mi>N</mi><annotation encoding="application/x-tex">N</annotation></semantics></math>, and <math id="S4.SS1.p1.m19" class="ltx_Math" alttext="f\left(\cdot\right)" display="inline" intent=":literal"><semantics><mrow><mi>f</mi><mo>⁡</mo><mrow><mo>(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo>)</mo></mrow></mrow><annotation encoding="application/x-tex">f\left(\cdot\right)</annotation></semantics></math> are respectively a similarity function, a temperature parameter, the number of pairs in a batch, and a batch-wise PCA operator <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib1" title="" class="ltx_ref">56</a>]</cite> that approximates the image feature vector from a low-rank decomposition.</p>
</div>
</section>
<section id="S4.SS2" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">4.2 </span>Replacing the Summary Sentence</h3>

<div id="S4.SS2.p1" class="ltx_para">
<p id="S4.SS2.p1.1" class="ltx_p">As discussed in <a href="#S3.SS1" title="3.1 Text Retrieval Datasets ‣ 3 Empirical Analysis of CLIP Biases ‣ CLIP Is Shortsighted: Paying Attention Beyond the First Sentence" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Sec.</span> <span class="ltx_text ltx_ref_tag">3.1</span></a>, ShareGPT4V captions start with a summary sentence. Long-CLIP uses this first sentence as a short caption to preserve short-text performance. Our short caption serves a different purpose: it is used to capture fine-grained details that may be ignored in the full caption (due to appearing later). We preserve short-text performance via subsampling and prefix padding, not by relying on the summary sentence (see <a href="#S4.SS3" title="4.3 Sentence Sampling ‣ 4 Method ‣ CLIP Is Shortsighted: Paying Attention Beyond the First Sentence" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Sec.</span> <span class="ltx_text ltx_ref_tag">4.3</span></a> and <a href="#S4.SS4" title="4.4 Token Padding ‣ 4 Method ‣ CLIP Is Shortsighted: Paying Attention Beyond the First Sentence" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Sec.</span> <span class="ltx_text ltx_ref_tag">4.4</span></a>).</p>
</div>
<div id="S4.SS2.p2" class="ltx_para">
<p id="S4.SS2.p2.1" class="ltx_p">We claim that existing CLIP and Long-CLIP models are sensitive to the inclusion and position of the summary caption, and that, in practice, these sentences can act as a shortcut for the alignment loss when training on captions that always contain this summary. In fact, when evaluating Long-CLIP on the DOCCI retrieval task, we find that the average image-caption similarities for positive pairs are larger when using the summary caption only <math id="S4.SS2.p2.m1" class="ltx_Math" alttext="\left(\overline{\mathrm{sim}}\left(u^{s},v\right)=0.320\right)" display="inline" intent=":literal"><semantics><mrow><mo>(</mo><mrow><mrow><mover accent="true"><mi>sim</mi><mo stretchy="true">¯</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><msup><mi>u</mi><mi>s</mi></msup><mo>,</mo><mi>v</mi><mo>)</mo></mrow></mrow><mo>=</mo><mn>0.320</mn></mrow><mo>)</mo></mrow><annotation encoding="application/x-tex">\left(\overline{\mathrm{sim}}\left(u^{s},v\right)=0.320\right)</annotation></semantics></math> compared to using the full caption <math id="S4.SS2.p2.m2" class="ltx_Math" alttext="\left(\overline{\mathrm{sim}}\left(u^{\ell},v\right)=0.308\right)" display="inline" intent=":literal"><semantics><mrow><mo>(</mo><mrow><mrow><mover accent="true"><mi>sim</mi><mo stretchy="true">¯</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><msup><mi>u</mi><mi mathvariant="normal">ℓ</mi></msup><mo>,</mo><mi>v</mi><mo>)</mo></mrow></mrow><mo>=</mo><mn>0.308</mn></mrow><mo>)</mo></mrow><annotation encoding="application/x-tex">\left(\overline{\mathrm{sim}}\left(u^{\ell},v\right)=0.308\right)</annotation></semantics></math>.</p>
</div>
<div id="S4.SS2.p3" class="ltx_para">
<p id="S4.SS2.p3.1" class="ltx_p">Instead of taking the summary sentence as the short caption, we define the short caption as <em id="S4.SS2.p3.1.1" class="ltx_emph ltx_font_italic">the long caption minus its first sentence</em>, encouraging the model to be sensitive to fine-grained details deeper in the caption. Note that we still use the same long caption <math id="S4.SS2.p3.m1" class="ltx_Math" alttext="C^{\ell}" display="inline" intent=":literal"><semantics><msup><mi>C</mi><mi mathvariant="normal">ℓ</mi></msup><annotation encoding="application/x-tex">C^{\ell}</annotation></semantics></math> as Long-CLIP to train on the complete text data, and add a short caption given by</p>
<table id="S4.EGx3" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="S4.E6"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S4.E6.m1" class="ltx_Math" alttext="\displaystyle C^{\mathrm{no\_sum}}" display="inline" intent=":literal"><semantics><msup><mi>C</mi><mrow><mi>no</mi><mo lspace="0em" rspace="0em">​</mo><mi>_</mi><mo lspace="0em" rspace="0em">​</mo><mi>sum</mi></mrow></msup><annotation encoding="application/x-tex">\displaystyle C^{\mathrm{no\_sum}}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S4.E6.m2" class="ltx_Math" alttext="\displaystyle=[s_{2},\,\dots,\,s_{k}]." display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>=</mo><mrow><mo stretchy="false">[</mo><mrow><msub><mi>s</mi><mn>2</mn></msub><mo rspace="0.337em">,</mo><mi mathvariant="normal">…</mi><mo rspace="0.337em">,</mo><msub><mi>s</mi><mi>k</mi></msub></mrow><mo stretchy="false">]</mo></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle=[s_{2},\,\dots,\,s_{k}].</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(6)</span></td></tr></tbody>
</table>
</div>
</section>
<section id="S4.SS3" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">4.3 </span>Sentence Sampling</h3>

<div id="S4.SS3.p1" class="ltx_para">
<p id="S4.SS3.p1.1" class="ltx_p">To increase the difference between the long caption and the new caption <math id="S4.SS3.p1.m1" class="ltx_Math" alttext="C^{\mathrm{no\_sum}}" display="inline" intent=":literal"><semantics><msup><mi>C</mi><mrow><mi>no</mi><mo lspace="0em" rspace="0em">​</mo><mi>_</mi><mo lspace="0em" rspace="0em">​</mo><mi>sum</mi></mrow></msup><annotation encoding="application/x-tex">C^{\mathrm{no\_sum}}</annotation></semantics></math> and to encourage the model to be more sensitive to details throughout texts and images, we subsample the sentences in <math id="S4.SS3.p1.m2" class="ltx_Math" alttext="C^{\mathrm{no\_sum}}" display="inline" intent=":literal"><semantics><msup><mi>C</mi><mrow><mi>no</mi><mo lspace="0em" rspace="0em">​</mo><mi>_</mi><mo lspace="0em" rspace="0em">​</mo><mi>sum</mi></mrow></msup><annotation encoding="application/x-tex">C^{\mathrm{no\_sum}}</annotation></semantics></math> to generate a new short caption. This introduces variation at minimal cost, in contrast to rewriting-based methods used in prior works (e.g., FG-CLIP <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib47" title="" class="ltx_ref">48</a>]</cite>, LaCLIP <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib48" title="" class="ltx_ref">10</a>]</cite>, and TIPS <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib49" title="" class="ltx_ref">28</a>]</cite>). We randomly sample without replacement <math id="S4.SS3.p1.m3" class="ltx_Math" alttext="{n_{\mathrm{sampled}}=\mathcal{U}\left\{1\,,2\,,\dots,\,n_{\mathrm{sents}}-1\right\}}" display="inline" intent=":literal"><semantics><mrow><msub><mi>n</mi><mi>sampled</mi></msub><mo>=</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒰</mi><mo>⁡</mo><mrow><mo>{</mo><mrow><mn>1</mn><mo lspace="0.170em">,</mo><mn>2</mn><mo lspace="0.170em">,</mo><mi mathvariant="normal">…</mi><mo rspace="0.337em">,</mo><mrow><msub><mi>n</mi><mi>sents</mi></msub><mo>−</mo><mn>1</mn></mrow></mrow><mo>}</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">{n_{\mathrm{sampled}}=\mathcal{U}\left\{1\,,2\,,\dots,\,n_{\mathrm{sents}}-1\right\}}</annotation></semantics></math> sentences in <math id="S4.SS3.p1.m4" class="ltx_Math" alttext="C^{\mathrm{no\_sum}}" display="inline" intent=":literal"><semantics><msup><mi>C</mi><mrow><mi>no</mi><mo lspace="0em" rspace="0em">​</mo><mi>_</mi><mo lspace="0em" rspace="0em">​</mo><mi>sum</mi></mrow></msup><annotation encoding="application/x-tex">C^{\mathrm{no\_sum}}</annotation></semantics></math> (excludes the first sentence), leading to captions with a wide range of lengths. We do not maintain sentence order when sampling. A possible sampled short caption is given by</p>
<table id="S4.EGx4" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="S4.E7"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S4.E7.m1" class="ltx_Math" alttext="\displaystyle C^{\mathrm{samp}}" display="inline" intent=":literal"><semantics><msup><mi>C</mi><mi>samp</mi></msup><annotation encoding="application/x-tex">\displaystyle C^{\mathrm{samp}}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S4.E7.m2" class="ltx_Math" alttext="\displaystyle=[s_{4},\,s_{2}]." display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>=</mo><mrow><mo stretchy="false">[</mo><mrow><msub><mi>s</mi><mn>4</mn></msub><mo rspace="0.337em">,</mo><msub><mi>s</mi><mn>2</mn></msub></mrow><mo stretchy="false">]</mo></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle=[s_{4},\,s_{2}].</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(7)</span></td></tr></tbody>
</table>
</div>
</section>
<section id="S4.SS4" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">4.4 </span>Token Padding</h3>

<div id="S4.SS4.p1" class="ltx_para">
<p id="S4.SS4.p1.1" class="ltx_p">When adding sentence sampling, performance does not always improve and sometimes gets worse. We hypothesize that this could be related to uneven training of the positional embeddings, as the long caption <math id="S4.SS4.p1.m1" class="ltx_Math" alttext="C^{\ell}" display="inline" intent=":literal"><semantics><msup><mi>C</mi><mi mathvariant="normal">ℓ</mi></msup><annotation encoding="application/x-tex">C^{\ell}</annotation></semantics></math> can be biased towards the summary sentence and thus early embeddings, in addition to the sampled caption <math id="S4.SS4.p1.m2" class="ltx_Math" alttext="C^{\mathrm{samp}}" display="inline" intent=":literal"><semantics><msup><mi>C</mi><mi>samp</mi></msup><annotation encoding="application/x-tex">C^{\mathrm{samp}}</annotation></semantics></math> being shorter. Moreover, the pretrained model’s short-text performance is better preserved when training with the summary sentences because those captions are more similar to the original training data, but this is no longer the case with the sampled captions. To resolve both issues, we add padding tokens to the start of the tokenized sampled caption to push it to a further position. In encoders with a <span id="S4.SS4.p1.1.1" class="ltx_text ltx_font_typewriter">SOT</span> token (such as CLIP), this padding is added after the <span id="S4.SS4.p1.1.2" class="ltx_text ltx_font_typewriter">SOT</span> token. Given <math id="S4.SS4.p1.m3" class="ltx_Math" alttext="n_{\mathrm{post}}" display="inline" intent=":literal"><semantics><msub><mi>n</mi><mi>post</mi></msub><annotation encoding="application/x-tex">n_{\mathrm{post}}</annotation></semantics></math> post-caption padding tokens, we transfer <math id="S4.SS4.p1.m4" class="ltx_Math" alttext="n_{\mathrm{pre}}" display="inline" intent=":literal"><semantics><msub><mi>n</mi><mi>pre</mi></msub><annotation encoding="application/x-tex">n_{\mathrm{pre}}</annotation></semantics></math> of them as pre-caption padding tokens and update the post-padding as</p>
<table id="S4.EGx5" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="S4.E8"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S4.E8.m1" class="ltx_Math" alttext="\displaystyle n_{\mathrm{pre}}" display="inline" intent=":literal"><semantics><msub><mi>n</mi><mi>pre</mi></msub><annotation encoding="application/x-tex">\displaystyle n_{\mathrm{pre}}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S4.E8.m2" class="ltx_Math" alttext="\displaystyle=\mathcal{U}\left\{0,\,1,\,\dots,\,n_{\mathrm{post}}\right\}," display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>=</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒰</mi><mo>⁡</mo><mrow><mo>{</mo><mrow><mn>0</mn><mo>,</mo><mn> 1</mn><mo rspace="0.337em">,</mo><mi mathvariant="normal">…</mi><mo rspace="0.337em">,</mo><msub><mi>n</mi><mi>post</mi></msub></mrow><mo>}</mo></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle=\mathcal{U}\left\{0,\,1,\,\dots,\,n_{\mathrm{post}}\right\},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(8)</span></td></tr></tbody>
<tbody id="S4.E9"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S4.E9.m1" class="ltx_Math" alttext="\displaystyle n_{\mathrm{post}}" display="inline" intent=":literal"><semantics><msub><mi>n</mi><mi>post</mi></msub><annotation encoding="application/x-tex">\displaystyle n_{\mathrm{post}}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S4.E9.m2" class="ltx_Math" alttext="\displaystyle=n_{\mathrm{post}}-n_{\mathrm{pre}}." display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>=</mo><mrow><msub><mi>n</mi><mi>post</mi></msub><mo>−</mo><msub><mi>n</mi><mi>pre</mi></msub></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle=n_{\mathrm{post}}-n_{\mathrm{pre}}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(9)</span></td></tr></tbody>
</table>
<p id="S4.SS4.p1.2" class="ltx_p">This reassigns part of the post-caption padding to the prefix <em id="S4.SS4.p1.2.1" class="ltx_emph ltx_font_italic">without truncating any text tokens</em>. Given the sampled caption from (<a href="#S4.E7" title="Equation 7 ‣ 4.3 Sentence Sampling ‣ 4 Method ‣ CLIP Is Shortsighted: Paying Attention Beyond the First Sentence" class="ltx_ref"><span class="ltx_text ltx_ref_tag">7</span></a>), our final tokenized short caption would be</p>
<table id="S4.EGx6" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="S4.E10"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S4.E10.m1" class="ltx_Math" alttext="\displaystyle T^{s}_{\mathrm{ours}}" display="inline" intent=":literal"><semantics><msubsup><mi>T</mi><mi>ours</mi><mi>s</mi></msubsup><annotation encoding="application/x-tex">\displaystyle T^{s}_{\mathrm{ours}}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S4.E10.m2" class="ltx_Math" alttext="\displaystyle=[\mathtt{SOT},\,\mathtt{PAD}_{\mathrm{pre}},\,\mathtt{s}_{4},\,\mathtt{s}_{2},\,\mathtt{EOT},\,\mathtt{PAD}_{\mathrm{post}}]." display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>=</mo><mrow><mo stretchy="false">[</mo><mrow><mi>𝚂𝙾𝚃</mi><mo rspace="0.337em">,</mo><msub><mi>𝙿𝙰𝙳</mi><mi>pre</mi></msub><mo rspace="0.337em">,</mo><msub><mi>𝚜</mi><mn>4</mn></msub><mo rspace="0.337em">,</mo><msub><mi>𝚜</mi><mn>2</mn></msub><mo rspace="0.337em">,</mo><mi>𝙴𝙾𝚃</mi><mo rspace="0.337em">,</mo><msub><mi>𝙿𝙰𝙳</mi><mi>post</mi></msub></mrow><mo stretchy="false">]</mo></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle=[\mathtt{SOT},\,\mathtt{PAD}_{\mathrm{pre}},\,\mathtt{s}_{4},\,\mathtt{s}_{2},\,\mathtt{EOT},\,\mathtt{PAD}_{\mathrm{post}}].</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(10)</span></td></tr></tbody>
</table>
</div>
</section>
<section id="S4.SS5" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">4.5 </span>Multi-caption Training</h3>

<div id="S4.SS5.p1" class="ltx_para">
<p id="S4.SS5.p1.1" class="ltx_p">Given the tokenized long caption <math id="S4.SS5.p1.m1" class="ltx_Math" alttext="{T^{\ell}_{LC}=T^{\ell}_{\mathrm{ours}}}" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>T</mi><mrow><mi>L</mi><mo lspace="0em" rspace="0em">​</mo><mi>C</mi></mrow><mi mathvariant="normal">ℓ</mi></msubsup><mo>=</mo><msubsup><mi>T</mi><mi>ours</mi><mi mathvariant="normal">ℓ</mi></msubsup></mrow><annotation encoding="application/x-tex">{T^{\ell}_{LC}=T^{\ell}_{\mathrm{ours}}}</annotation></semantics></math> and the sampled and padded caption <math id="S4.SS5.p1.m2" class="ltx_Math" alttext="T^{s}_{\mathrm{ours}}" display="inline" intent=":literal"><semantics><msubsup><mi>T</mi><mi>ours</mi><mi>s</mi></msubsup><annotation encoding="application/x-tex">T^{s}_{\mathrm{ours}}</annotation></semantics></math> from (<a href="#S4.E10" title="Equation 10 ‣ 4.4 Token Padding ‣ 4 Method ‣ CLIP Is Shortsighted: Paying Attention Beyond the First Sentence" class="ltx_ref"><span class="ltx_text ltx_ref_tag">10</span></a>), we compute independent contrastive losses for each caption with (<a href="#S4.E3" title="Equation 3 ‣ 4.1 Problem Definition ‣ 4 Method ‣ CLIP Is Shortsighted: Paying Attention Beyond the First Sentence" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3</span></a>) and (<a href="#S4.E4" title="Equation 4 ‣ 4.1 Problem Definition ‣ 4 Method ‣ CLIP Is Shortsighted: Paying Attention Beyond the First Sentence" class="ltx_ref"><span class="ltx_text ltx_ref_tag">4</span></a>) and consider the weighted sum of both as the final loss</p>
<table id="S4.EGx7" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="S4.E11"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S4.E11.m1" class="ltx_Math" alttext="\displaystyle\mathcal{L}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">ℒ</mi><annotation encoding="application/x-tex">\displaystyle\mathcal{L}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S4.E11.m2" class="ltx_Math" alttext="\displaystyle=\lambda^{s}\mathcal{L}^{s}+\left(1-\lambda^{s}\right)\mathcal{L}^{\ell}," display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><msup><mi>λ</mi><mi>s</mi></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi class="ltx_font_mathcaligraphic">ℒ</mi><mi>s</mi></msup></mrow><mo>+</mo><mrow><mrow><mo>(</mo><mrow><mn>1</mn><mo>−</mo><msup><mi>λ</mi><mi>s</mi></msup></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mi class="ltx_font_mathcaligraphic">ℒ</mi><mi mathvariant="normal">ℓ</mi></msup></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle=\lambda^{s}\mathcal{L}^{s}+\left(1-\lambda^{s}\right)\mathcal{L}^{\ell},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(11)</span></td></tr></tbody>
</table>
<p id="S4.SS5.p1.2" class="ltx_p">where <math id="S4.SS5.p1.m3" class="ltx_Math" alttext="\lambda^{s}" display="inline" intent=":literal"><semantics><msup><mi>λ</mi><mi>s</mi></msup><annotation encoding="application/x-tex">\lambda^{s}</annotation></semantics></math> is a weight coefficient that controls the relative contribution of the short and long caption losses.</p>
</div>
</section>
</section>
