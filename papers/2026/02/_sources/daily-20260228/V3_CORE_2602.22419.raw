              <span class="ltx_tag ltx_tag_listingline"><span id="alg1.l19.1" class="ltx_text" style="font-size:80%;">19:</span></span>
              
              
            <math id="alg1.l19.m1" class="ltx_Math" alttext="\mathcal{L}^{s}\leftarrow\mathcal{L}^{s}(u^{s},f(v))" display="inline" intent=":literal"><semantics><mrow><msup><mi class="ltx_font_mathcaligraphic">ℒ</mi><mi>s</mi></msup><mo stretchy="false">←</mo><mrow><msup><mi class="ltx_font_mathcaligraphic">ℒ</mi><mi>s</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>u</mi><mi>s</mi></msup><mo>,</mo><mrow><mi>f</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>v</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\mathcal{L}^{s}\leftarrow\mathcal{L}^{s}(u^{s},f(v))</annotation></semantics></math> <span id="alg1.l19.3" class="ltx_text" style="float:right;"><math id="alg1.l19.m2" class="ltx_Math" alttext="\triangleright" display="inline" intent=":literal"><semantics><mo>⊳</mo><annotation encoding="application/x-tex">\triangleright</annotation></semantics></math> Short caption loss
</span>
</div>
<div id="alg1.l20" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg1.l20.1" class="ltx_text" style="font-size:80%;">20:</span></span>
              
              
            <math id="alg1.l20.m1" class="ltx_Math" alttext="\mathcal{L}^{\ell}\leftarrow\mathcal{L}^{\ell}(u^{\ell},v)" display="inline" intent=":literal"><semantics><mrow><msup><mi class="ltx_font_mathcaligraphic">ℒ</mi><mi mathvariant="normal">ℓ</mi></msup><mo stretchy="false">←</mo><mrow><msup><mi class="ltx_font_mathcaligraphic">ℒ</mi><mi mathvariant="normal">ℓ</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>u</mi><mi mathvariant="normal">ℓ</mi></msup><mo>,</mo><mi>v</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\mathcal{L}^{\ell}\leftarrow\mathcal{L}^{\ell}(u^{\ell},v)</annotation></semantics></math> <span id="alg1.l20.3" class="ltx_text" style="float:right;"><math id="alg1.l20.m2" class="ltx_Math" alttext="\triangleright" display="inline" intent=":literal"><semantics><mo>⊳</mo><annotation encoding="application/x-tex">\triangleright</annotation></semantics></math> Long caption loss
</span>
</div>
<div id="alg1.l21" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg1.l21.1" class="ltx_text" style="font-size:80%;">21:</span></span>
              
              
            <math id="alg1.l21.m1" class="ltx_Math" alttext="\mathcal{L}\leftarrow\lambda^{s}\,\mathcal{L}^{s}+(1-\lambda^{s})\,\mathcal{L}^{\ell}" display="inline" intent=":literal"><semantics><mrow><mi class="ltx_font_mathcaligraphic">ℒ</mi><mo stretchy="false">←</mo><mrow><mrow><msup><mi>λ</mi><mi>s</mi></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi class="ltx_font_mathcaligraphic">ℒ</mi><mi>s</mi></msup></mrow><mo>+</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msup><mi>λ</mi><mi>s</mi></msup></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0.170em" rspace="0em">​</mo><msup><mi class="ltx_font_mathcaligraphic">ℒ</mi><mi mathvariant="normal">ℓ</mi></msup></mrow></mrow></mrow><annotation encoding="application/x-tex">\mathcal{L}\leftarrow\lambda^{s}\,\mathcal{L}^{s}+(1-\lambda^{s})\,\mathcal{L}^{\ell}</annotation></semantics></math>

</div>
