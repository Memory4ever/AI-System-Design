="matrix(1 0 0 -1 0 0)"><foreignObject style="--ltx-fo-width:6.16em;--ltx-fo-height:0.67em;--ltx-fo-depth:0.19em;font-size:10pt;" height="11.93" overflow="visible" transform="matrix(1 0 0 -1 0 9.24)" width="85.21"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S4.F2.sf2.pic1.m6" class="ltx_Math" alttext="\frac{d}{G}" display="inline" intent=":literal"><semantics><mfrac><mi>d</mi><mi>G</mi></mfrac><annotation encoding="application/x-tex">\frac{d}{G}</annotation></semantics></math> zero-points</span></span></foreignObject></g></g></g></g></g><g class="ltx_tikzmatrix_row" transform="matrix(1 0 0 1 0 52.57)"><g class="ltx_tikzmatrix_col ltx_nopad_l ltx_nopad_r" transform="matrix(1 0 0 -1 0 0)"><foreignObject style="--ltx-fo-width:4.73em;--ltx-fo-height:0.6em;--ltx-fo-depth:0.17em;font-size:11.5pt;" height="12.3" overflow="visible" transform="matrix(1 0 0 -1 0 9.61)" width="75.23"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><span id="S4.F2.sf2.pic1.3" class="ltx_text ltx_font_bold">High reuse</span></span></span></foreignObject></g></g></g></g></g><g style="--ltx-stroke-color:#0059A6;" stroke="#0059A6" stroke-width="2.0pt"><path style="fill:none" d="M 283.46 -59.06 L 297.06 -59.06"></path><g style="--ltx-fill-color:#0059A6;" fill="#0059A6" transform="matrix(1.0 0.0 0.0 1.0 297.06 -59.06)"><path style="stroke:none" d="M 6.09 0 L -3.65 4.87 L 0 0 L -3.65 -4.87"></path></g></g></g></svg></span>
