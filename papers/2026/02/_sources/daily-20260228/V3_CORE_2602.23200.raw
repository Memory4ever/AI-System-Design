<td id="S5.T1.3.9.4" class="ltx_td ltx_align_center"><span id="S5.T1.3.9.4.1" class="ltx_text" style="font-size:70%;">(<math id="S5.T1.m32" class="ltx_Math" alttext="303.2" display="inline" intent=":literal"><semantics><mn>303.2</mn><annotation encoding="application/x-tex">303.2</annotation></semantics></math> MB)</span></td></tr>
