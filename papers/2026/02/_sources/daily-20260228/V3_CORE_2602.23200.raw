/span></foreignObject></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(0.0 1.0 -1.0 0.0 325.65 23.08)"><foreignObject style="--ltx-fo-width:5.61em;--ltx-fo-height:0.71em;--ltx-fo-depth:0.24em;font-size:8.5pt;" height="11.07" overflow="visible" transform="matrix(1 0 0 -1 0 8.3)" width="66"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><span id="S5.F3.sf2.pic1.11" class="ltx_text" style="font-size:80%;">Speedup (%)</span></span></span></foreignObject></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 475.17 138.71)"><foreignObject style="--ltx-fo-width:14.79em;--ltx-fo-height:0.64em;--ltx-fo-depth:0.18em;font-size:8.5pt;" height="9.72" overflow="visible" transform="matrix(1 0 0 -1 0 7.56)" width="173.9"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><span id="S5.F3.sf2.pic1.12" class="ltx_text" style="font-size:80%;">Inner grouping vs. outer grouping</span></span></span></foreignObject></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#FFFFFF;" fill="#FFFFFF" stroke="#000000"><path d="M 653.42 -6.9 h 103.53 v 48.54 h -103.53 Z"></path></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#FFFFFF;" fill="#FFFFFF" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 657.57 3.03)"><g class="ltx_tikzmatrix" transform="matrix(1 0 0 -1 0 43.01)"><g class="ltx_tikzmatrix_row" transform="matrix(1 0 0 1 0 7.17)"><g style="--ltx-stroke-color:#009E73;--ltx-fill-color:#009E73;--ltx-fg-color:#009E73;" class="ltx_tikzmatrix_col ltx_nopad_l ltx_nopad_r" color="#009E73" fill="#009E73" stroke="#009E73" stroke-width="0.6pt" transform="matrix(1 0 0 -1 0 0) translate(0.42,0)"><path style="fill:none" d="M 0 0 L 11.81 0 L 23.62 0"></path><path d="M 13.19 0 C 13.19 0.76 12.58 1.38 11.81 1.38 C 11.05 1.38 10.43 0.76 10.43 0 C 10.43 -0.76 11.05 -1.38 11.81 -1.38 C