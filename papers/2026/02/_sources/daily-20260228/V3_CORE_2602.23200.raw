<td id="S5.T1.3.9.1" class="ltx_td ltx_align_center"><span id="S5.T1.3.9.1.1" class="ltx_text" style="font-size:70%;">(<math id="S5.T1.m29" class="ltx_Math" alttext="10.4" display="inline" intent=":literal"><semantics><mn>10.4</mn><annotation encoding="application/x-tex">10.4</annotation></semantics></math> MB)</span></td>
<td id="S5.T1.3.9.2" class="ltx_td ltx_align_center"><span id="S5.T1.3.9.2.1" class="ltx_text" style="font-size:70%;">(<math id="S5.T1.m30" class="ltx_Math" alttext="193.0" display="inline" intent=":literal"><semantics><mn>193.0</mn><annotation encoding="application/x-tex">193.0</annotation></semantics></math> MB)</span></td>
