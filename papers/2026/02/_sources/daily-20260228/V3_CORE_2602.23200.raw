<td id="S5.T1.3.7.4" class="ltx_td ltx_align_center"><span id="S5.T1.3.7.4.1" class="ltx_text" style="font-size:70%;">(<math id="S5.T1.m24" class="ltx_Math" alttext="301.4" display="inline" intent=":literal"><semantics><mn>301.4</mn><annotation encoding="application/x-tex">301.4</annotation></semantics></math> MB)</span></td></tr>
<tr id="S5.T1.3.8" class="ltx_tr">
<th id="S5.T1.3.8.1" class="ltx_td ltx_align_center ltx_th ltx_th_row ltx_border_r ltx_border_t" rowspan="2"><span id="S5.T1.3.8.1.1" class="ltx_text">InnerQ (ours)</span></th>
<td id="S5.T1.3.8.2" class="ltx_td ltx_align_center ltx_border_t"><math id="S5.T1.m25" class="ltx_Math" alttext="5.69\%" display="inline" intent=":literal"><semantics><mrow><mn>5.69</mn><mo>%</mo></mrow><annotation encoding="application/x-tex">5.69\%</annotation></semantics></math></td>
<td id="S5.T1.3.8.3" class="ltx_td ltx_align_center ltx_border_t"><math id="S5.T1.m26" class="ltx_Math" alttext="13.64\%" display="inline" intent=":literal"><semantics><mrow><mn>13.64</mn><mo>%</mo></mrow><annotation encoding="application/x-tex">13.64\%</annotation></semantics></math></td>
<td id="S5.T1.3.8.4" class="ltx_td ltx_align_center ltx_border_t"><math id="S5.T1.m27" class="ltx_Math" alttext="49.58\%" display="inline" intent=":literal"><semantics><mrow><mn>49.58</mn><mo>%</mo></mrow><annotation encoding="application/x-tex">49.58\%</annotation></semantics></math></td>
