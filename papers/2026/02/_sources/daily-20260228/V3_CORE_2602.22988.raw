<tbody class="ltx_tbody">
<tr id="S5.T8.2.1.2" class="ltx_tr" style="--ltx-bg-color:#FFFFFF;">
<td id="S5.T8.2.1.2.1" class="ltx_td ltx_align_left ltx_border_t" style="padding:0.6pt 4.5pt;"><span id="S5.T8.2.1.2.1.1" class="ltx_text" style="--ltx-bg-color:#FFFFFF;">Small, <math id="S5.T8.m1" class="ltx_Math" alttext="d=256" display="inline" intent=":literal"><semantics><mrow><mi style="--ltx-bg-color:#FFFFFF;" mathbackground="#FFFFFF">d</mi><mo style="--ltx-bg-color:#FFFFFF;" mathbackground="#FFFFFF">=</mo><mn style="--ltx-bg-color:#FFFFFF;" mathbackground="#FFFFFF">256</mn></mrow><annotation encoding="application/x-tex">d=256</annotation></semantics></math>, <math id="S5.T8.m2" class="ltx_Math" alttext="L=6" display="inline" intent=":literal"><semantics><mrow><mi style="--ltx-bg-color:#FFFFFF;" mathbackground="#FFFFFF">L</mi><mo style="--ltx-bg-color:#FFFFFF;" mathbackground="#FFFFFF">=</mo><mn style="--ltx-bg-color:#FFFFFF;" mathbackground="#FFFFFF">6</mn></mrow><annotation encoding="application/x-tex">L=6</annotation></semantics></math></span></td>
<td id="S5.T8.2.1.2.2" class="ltx_td ltx_align_center ltx_border_t" style="padding:0.6pt 4.5pt;"><span id="S5.T8.2.1.2.2.1" class="ltx_text" style="--ltx-bg-color:#FFFFFF;">25M</span></td>
<td id="S5.T8.2.1.2.3" class="ltx_td ltx_align_center ltx_border_t" style="padding:0.6pt 4.5pt;"><span id="S5.T8.2.1.2.3.1" class="ltx_text" style="--ltx-bg-color:#FFFFFF;">Baseline</span></td>
<td id="S5.T8.2.1.2.4" class="ltx_td ltx_align_center ltx_border_t" style="padding:0.6pt 4.5pt;"><span id="S5.T8.2.1.2.4.1" class="ltx_text" style="--ltx-bg-color:#FFFFFF;">2 of 24</span></td>
<td id="S5.T8.2.1.2.5" class="ltx_td ltx_align_center ltx_border_t" style="padding:0.6pt 4.5pt;"><math id="S5.T8.m3" class="ltx_Math" style="--ltx-bg-color:#FFFFFF;" alttext="58.4" display="inline" intent=":literal"><semantics><mn style="--ltx-bg-color:#FFFFFF;" mathbackground="#FFFFFF">58.4</mn><annotation encoding="application/x-tex">58.4</annotation></semantics></math></td>
<td id="S5.T8.2.1.2.6" class="ltx_td ltx_align_center ltx_border_t" style="padding:0.6pt 4.5pt;"><math id="S5.T8.m4" class="ltx_Math" style="--ltx-bg-color:#FFFFFF;" alttext="3\mathrm{e}{-4}" display="inline" intent=":literal"><semantics><mrow><mrow><mn style="--ltx-bg-color:#FFFFFF;" mathbackground="#FFFFFF">3</mn><mo lspace="0em" rspace="0em">​</mo><mi style="--ltx-bg-color:#FFFFFF;" mathbackground="#FFFFFF">e</mi></mrow><mo style="--ltx-bg-color:#FFFFFF;" mathbackground="#FFFFFF">−</mo><mn style="--ltx-bg-color:#FFFFFF;" mathbackground="#FFFFFF">4</mn></mrow><annotation encoding="application/x-tex">3\mathrm{e}{-4}</annotation></semantics></math></td>
<td id="S5.T8.2.1.2.7" class="ltx_td ltx_align_center ltx_border_t" style="padding:0.6pt 4.5pt;"><span id="S5.T8.2.1.2.7.1" class="ltx_text" style="--ltx-bg-color:#FFFFFF;">10K</span></td></tr>
