<td id="S5.T6.2.1.10.2" class="ltx_td ltx_align_center ltx_border_bb" style="padding:0.6pt 4.5pt;"><math id="S5.T6.m21" class="ltx_Math" style="--ltx-bg-color:#FFFFFF;" alttext="\mathbf{12.5}" display="inline" intent=":literal"><semantics><mn style="--ltx-bg-color:#FFFFFF;" class="ltx_mathvariant_bold" mathbackground="#FFFFFF" mathvariant="bold">12.5</mn><annotation encoding="application/x-tex">\mathbf{12.5}</annotation></semantics></math></td>
<td id="S5.T6.2.1.10.3" class="ltx_td ltx_align_center ltx_border_bb" style="padding:0.6pt 4.5pt;"><math id="S5.T6.m22" class="ltx_Math" style="--ltx-bg-color:#FFFFFF;" alttext="\mathbf{48.2}" display="inline" intent=":literal"><semantics><mn style="--ltx-bg-color:#FFFFFF;" class="ltx_mathvariant_bold" mathbackground="#FFFFFF" mathvariant="bold">48.2</mn><annotation encoding="application/x-tex">\mathbf{48.2}</annotation></semantics></math></td>
