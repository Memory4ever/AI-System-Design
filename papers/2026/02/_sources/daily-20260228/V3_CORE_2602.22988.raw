<th id="S5.T1.2.1.1.2" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt" style="padding:0.6pt 4.5pt;"><math id="S5.T1.m5" class="ltx_Math" style="--ltx-bg-color:#E6E6E6;" alttext="n" display="inline" intent=":literal"><semantics><mi style="--ltx-bg-color:#E6E6E6;" mathbackground="#E6E6E6">n</mi><annotation encoding="application/x-tex">n</annotation></semantics></math></th>
