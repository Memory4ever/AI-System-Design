<th id="S5.T3.2.1.1.3" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt" style="padding:0.6pt 4.5pt;"><span id="S5.T3.2.1.1.3.1" class="ltx_text" style="--ltx-bg-color:#E6E6E6;">Acc.% (higher)</span></th>
<th id="S5.T3.2.1.1.4" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt" style="padding:0.6pt 4.5pt;"><math id="S5.T3.m1" class="ltx_Math" style="--ltx-bg-color:#E6E6E6;" alttext="M_{\approx 1}" display="inline" intent=":literal"><semantics><msub><mi style="--ltx-bg-color:#E6E6E6;" mathbackground="#E6E6E6">M</mi><mrow><mphantom></mphantom><mo style="--ltx-bg-color:#E6E6E6;" mathbackground="#E6E6E6">≈</mo><mn style="--ltx-bg-color:#E6E6E6;" mathbackground="#E6E6E6">1</mn></mrow></msub><annotation encoding="application/x-tex">M_{\approx 1}</annotation></semantics></math></th>
