<th id="S5.T8.2.1.1.4" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt" style="padding:0.6pt 4.5pt;"><span id="S5.T8.2.1.1.4.1" class="ltx_text" style="--ltx-bg-color:#E6E6E6;">Div. of 24 (lower)</span></th>
<th id="S5.T8.2.1.1.5" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt" style="padding:0.6pt 4.5pt;"><span id="S5.T8.2.1.1.5.1" class="ltx_text" style="--ltx-bg-color:#E6E6E6;">PPL (lower)</span></th>
<th id="S5.T8.2.1.1.6" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt" style="padding:0.6pt 4.5pt;"><span id="S5.T8.2.1.1.6.1" class="ltx_text" style="--ltx-bg-color:#E6E6E6;">Max LR</span></th>
<th id="S5.T8.2.1.1.7" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt" style="padding:0.6pt 4.5pt;"><span id="S5.T8.2.1.1.7.1" class="ltx_text" style="--ltx-bg-color:#E6E6E6;">Steps</span></th></tr>
