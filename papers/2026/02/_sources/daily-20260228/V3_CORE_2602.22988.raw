<td id="S5.T7.2.1.3.3" class="ltx_td ltx_align_center ltx_border_bb" style="padding:0.6pt 4.5pt;"><span id="S5.T7.2.1.3.3.1" class="ltx_text" style="--ltx-bg-color:#F5F5F5;">KSS</span></td>
<td id="S5.T7.2.1.3.4" class="ltx_td ltx_align_center ltx_border_bb" style="padding:0.6pt 4.5pt;"><span id="S5.T7.2.1.3.4.1" class="ltx_text ltx_font_bold" style="--ltx-bg-color:#F5F5F5;">3 of 24</span></td>
<td id="S5.T7.2.1.3.5" class="ltx_td ltx_align_center ltx_border_bb" style="padding:0.6pt 4.5pt;"><math id="S5.T7.m6" class="ltx_Math" style="--ltx-bg-color:#F5F5F5;" alttext="\mathbf{46.8}" display="inline" intent=":literal"><semantics><mn style="--ltx-bg-color:#F5F5F5;" class="ltx_mathvariant_bold" mathbackground="#F5F5F5" mathvariant="bold">46.8</mn><annotation encoding="application/x-tex">\mathbf{46.8}</annotation></semantics></math></td>
<td id="S5.T7.2.1.3.6" class="ltx_td ltx_align_center ltx_border_bb" style="padding:0.6pt 4.5pt;"><math id="S5.T7.m7" class="ltx_Math" style="--ltx-bg-color:#F5F5F5;" alttext="11.8\%" display="inline" intent=":literal"><semantics><mrow><mn style="--ltx-bg-color:#F5F5F5;" mathbackground="#F5F5F5">11.8</mn><mo style="--ltx-bg-color:#F5F5F5;" mathbackground="#F5F5F5">%</mo></mrow><annotation encoding="application/x-tex">11.8\%</annotation></semantics></math></td></tr>
