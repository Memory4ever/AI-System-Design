<td id="S5.T6.2.1.9.3" class="ltx_td ltx_align_center" style="padding:0.6pt 4.5pt;"><math id="S5.T6.m19" class="ltx_Math" style="--ltx-bg-color:#F5F5F5;" alttext="36.2" display="inline" intent=":literal"><semantics><mn style="--ltx-bg-color:#F5F5F5;" mathbackground="#F5F5F5">36.2</mn><annotation encoding="application/x-tex">36.2</annotation></semantics></math></td>
