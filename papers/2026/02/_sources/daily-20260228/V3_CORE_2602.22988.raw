<tbody class="ltx_tbody">
<tr id="S5.T3.2.1.2" class="ltx_tr" style="--ltx-bg-color:#FFFFFF;">
<th id="S5.T3.2.1.2.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_t" style="padding:0.6pt 4.5pt;"><span id="S5.T3.2.1.2.1.1" class="ltx_text" style="--ltx-bg-color:#FFFFFF;">No control</span></th>
