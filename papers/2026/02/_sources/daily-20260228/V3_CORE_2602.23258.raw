<div id="alg1.4.40" class="ltx_listingline"> <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span> 
              <span class="ltx_tag ltx_tag_listingline"><span id="alg1.4.40.1" class="ltx_text ltx_font_bold">31</span></span>
            Discard <math id="alg1.m36" class="ltx_Math" alttext="\mathcal{O}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">𝒪</mi><annotation encoding="application/x-tex">\mathcal{O}</annotation></semantics></math> and re-initialize with fresh agents;
</div>
<div id="alg1.4.41" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg1.4.41.1" class="ltx_text ltx_font_bold">32</span></span>
            <span id="alg1.4.41.2" class="ltx_text ltx_font_bold">return</span> <math id="alg1.m37" class="ltx_Math" alttext="o_{N}" display="inline" intent=":literal"><semantics><msub><mi>o</mi><mi>N</mi></msub><annotation encoding="application/x-tex">o_{N}</annotation></semantics></math>;
</div>
<div id="alg1.4.42" class="ltx_listingline">
</div>
</div>
</figure>
<figure id="alg2" class="ltx_float ltx_algorithm ltx_framed ltx_framed_top">
<figcaption class="ltx_caption"><span class="ltx_tag ltx_tag_float"><span id="alg2.3" class="ltx_text ltx_font_bold">Algorithm 2</span> </span> Failure-Driven Indicator Pool Construction</figcaption>
<div id="alg2.4" class="ltx_listing ltx_lst_numbers_left ltx_framed ltx_framed_topbottom ltx_listing">
<div id="alg2.4.1" class="ltx_listingline"><span id="alg2.4.1.1" class="ltx_text ltx_font_bold">Input :</span> Source Dataset <math id="alg2.m1" class="ltx_Math" alttext="\mathcal{D}_{\text{src}}=\{\mathcal{Q},\mathcal{Y}^{*}\}" display="inline" intent=":literal"><semantics><mrow><msub><mi class="ltx_font_mathcaligraphic">𝒟</mi><mtext>src</mtext></msub><mo>=</mo><mrow><mo stretchy="false">{</mo><mi class="ltx_font_mathcaligraphic">𝒬</mi><mo>,</mo><msup><mi class="ltx_font_mathcaligraphic">𝒴</mi><mo>∗</mo></msup><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">\mathcal{D}_{\text{src}}=\{\mathcal{Q},\mathcal{Y}^{*}\}</annotation></semantics></math>, Teacher Model <math id="alg2.m2" class="ltx_Math" alttext="\Phi_{\text{teach}}" display="inline" intent=":literal"><semantics><msub><mi mathvariant="normal">Φ</mi><mtext>teach</mtext></msub><annotation encoding="application/x-tex">\Phi_{\text{teach}}</annotation></semantics></math>, Deduplication Model <math id="alg2.m3" class="ltx_Math" alttext="\Phi_{\text{dedup}}" display="inline" intent=":literal"><semantics><msub><mi mathvariant="normal">Φ</mi><mtext>dedup</mtext></msub><annotation encoding="application/x-tex">\Phi_{\text{dedup}}</annotation></semantics></math>, Embedding Model <math id="alg2.m4" class="ltx_Math" alttext="M_{\text{emb}}" display="inline" intent=":literal"><semantics><msub><mi>M</mi><mtext>emb</mtext></msub><annotation encoding="application/x-tex">M_{\text{emb}}</annotation></semantics></math>
</div>
<div id="alg2.4.2" class="ltx_listingline"><span id="alg2.4.2.1" class="ltx_text ltx_font_bold">Parameters :</span> Retrieval size <math id="alg2.m5" class="ltx_Math" alttext="K_{\text{dedup}}" display="inline" intent=":literal"><semantics><msub><mi>K</mi><mtext>dedup</mtext></msub><annotation encoding="application/x-tex">K_{\text{dedup}}</annotation></semantics></math>
</div>
<div id="alg2.4.3" class="ltx_listingline"><span id="alg2.4.3.1" class="ltx_text ltx_font_bold">Output :</span> Optimized Indicator Pool <math id="alg2.m6" class="ltx_Math" alttext="\mathcal{I}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">ℐ</mi><annotation encoding="application/x-tex">\mathcal{I}</annotation></semantics></math>
</div>
<div id="alg2.4.4" class="ltx_listingline"><span id="alg2.4.4.1" class="ltx_text ltx_font_typewriter">// </span><span id="alg2.4.4.2" class="ltx_text ltx_font_typewriter">Initialize empty indicator pool </span>
</div>
<div id="alg2.4.5" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg2.4.5.1" class="ltx_text ltx_font_bold">1</span></span>
            <math id="alg2.m7" class="ltx_Math" alttext="\mathcal{I}\leftarrow\emptyset" display="inline" intent=":literal"><semantics><mrow><mi class="ltx_font_mathcaligraphic">ℐ</mi><mo stretchy="false">←</mo><mi mathvariant="normal">∅</mi></mrow><annotation encoding="application/x-tex">\mathcal{I}\leftarrow\emptyset</annotation></semantics></math>;
</div>
<div id="alg2.4.6" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg2.4.6.1" class="ltx_text ltx_font_bold">2</span></span>
            <span id="alg2.4.6.2" class="ltx_text ltx_font_bold">foreach</span> <em id="alg2.4.6.3" class="ltx_emph ltx_font_italic">Instance <math id="alg2.m8" class="ltx_Math" alttext="(\mathcal{Q},\mathcal{Y}^{*})\in\mathcal{D}_{\text{src}}" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">(</mo><mi class="ltx_font_mathcaligraphic">𝒬</mi><mo>,</mo><msup><mi class="ltx_font_mathcaligraphic">𝒴</mi><mo>∗</mo></msup><mo stretchy="false">)</mo></mrow><mo>∈</mo><msub><mi class="ltx_font_mathcaligraphic">𝒟</mi><mtext class="ltx_mathvariant_italic">src</mtext></msub></mrow><annotation encoding="application/x-tex">(\mathcal{Q},\mathcal{Y}^{*})\in\mathcal{D}_{\text{src}}</annotation></semantics></math></em> <span id="alg2.4.6.4" class="ltx_text ltx_font_bold">do</span>
</div>
<div id="alg2.4.7" class="ltx_listingline"> <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span> <span id="alg2.4.7.1" class="ltx_text ltx_font_typewriter">// </span><span id="alg2.4.7.2" class="ltx_text ltx_font_typewriter">Step 1: Failure Trajectory Collection </span>
</div>
<div id="alg2.4.8" class="ltx_listingline"> <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span> 
              <span class="ltx_tag ltx_tag_listingline"><span id="alg2.4.8.1" class="ltx_text ltx_font_bold">3</span></span>
            Execute MAS to obtain trajectory: <math id="alg2.m9" class="ltx_math_unparsed" alttext="\mathcal{T}=(\mathcal{Q},A_{1:N},o_{1:N},\mathcal{Y})" display="inline" intent=":literal"><semantics><mrow><mi class="ltx_font_mathcaligraphic">𝒯</mi><mo>=</mo><mrow><mo stretchy="false">(</mo><mi class="ltx_font_mathcaligraphic">𝒬</mi><mo>,</mo><msub><mi>A</mi><mrow><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mi>N</mi></mrow></msub><mo>,</mo><msub><mi>o</mi><mrow><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mi>N</mi></mrow></msub><mo>,</mo><mi class="ltx_font_mathcaligraphic">𝒴</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathcal{T}=(\mathcal{Q},A_{1:N},o_{1:N},\mathcal{Y})</annotation></semantics></math>;
</div>
<div id="alg2.4.9" class="ltx_listingline"> <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span> 
              <span class="ltx_tag ltx_tag_listingline"><span id="alg2.4.9.1" class="ltx_text ltx_font_bold">4</span></span>
            <span id="alg2.4.9.2" class="ltx_text ltx_font_bold">if</span> <em id="alg2.4.9.3" class="ltx_emph ltx_font_italic"><math id="alg2.m10" class="ltx_Math" alttext="\mathcal{Y}\neq\mathcal{Y}^{*}" display="inline" intent=":literal"><semantics><mrow><mi class="ltx_font_mathcaligraphic">𝒴</mi><mo>≠</mo><msup><mi class="ltx_font_mathcaligraphic">𝒴</mi><mo>∗</mo></msup></mrow><annotation encoding="application/x-tex">\mathcal{Y}\neq\mathcal{Y}^{*}</annotation></semantics></math></em> <span id="alg2.4.9.4" class="ltx_text ltx_font_bold">then</span>
</div>
<div id="alg2.4.10" class="ltx_listingline"> <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span>  <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span> <span id="alg2.4.10.1" class="ltx_text ltx_font_typewriter">// </span><span id="alg2.4.10.2" class="ltx_text ltx_font_typewriter">Step 2: Offline Indicator Mining </span>
</div>
<div id="alg2.4.11" class="ltx_listingline"> <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span>  <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span> 
              <span class="ltx_tag ltx_tag_listingline"><span id="alg2.4.11.1" class="ltx_text ltx_font_bold">5</span></span>
            <span id="alg2.4.11.2" class="ltx_text ltx_font_bold">foreach</span> <em id="alg2.4.11.3" class="ltx_emph ltx_font_italic">Agent <math id="alg2.m11" class="ltx_Math" alttext="A_{i}" display="inline" intent=":literal"><semantics><msub><mi>A</mi><mi>i</mi></msub><annotation encoding="application/x-tex">A_{i}</annotation></semantics></math> in <math id="alg2.m12" class="ltx_Math" alttext="\mathcal{T}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">𝒯</mi><annotation encoding="application/x-tex">\mathcal{T}</annotation></semantics></math></em> <span id="alg2.4.11.4" class="ltx_text ltx_font_bold">do</span>
</div>
<div id="alg2.4.12" class="ltx_listingline"> <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span>  <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span>  <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span> 
              <span class="ltx_tag ltx_tag_listingline"><span id="alg2.4.12.1" class="ltx_text ltx_font_bold">6</span></span>
            <math id="alg2.m13" class="ltx_Math" alttext="\mathcal{I}_{\text{new}}\leftarrow\Phi_{\text{teach}}\left(\mathcal{T},\mathcal{Y}^{*},\mathcal{R}_{i},o_{i}\right)" display="inline" intent=":literal"><semantics><mrow><msub><mi class="ltx_font_mathcaligraphic">ℐ</mi><mtext>new</mtext></msub><mo stretchy="false">←</mo><mrow><msub><mi mathvariant="normal">Φ</mi><mtext>teach</mtext></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mi class="ltx_font_mathcaligraphic">𝒯</mi><mo>,</mo><msup><mi class="ltx_font_mathcaligraphic">𝒴</mi><mo>∗</mo></msup><mo>,</mo><msub><mi class="ltx_font_mathcaligraphic">ℛ</mi><mi>i</mi></msub><mo>,</mo><msub><mi>o</mi><mi>i</mi></msub><mo>)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\mathcal{I}_{\text{new}}\leftarrow\Phi_{\text{teach}}\left(\mathcal{T},\mathcal{Y}^{*},\mathcal{R}_{i},o_{i}\right)</annotation></semantics></math> ;  <span id="alg2.4.12.2" class="ltx_text ltx_font_typewriter">// </span><span id="alg2.4.12.3" class="ltx_text ltx_font_typewriter">Generate candidate indicators</span>
</div>
<div id="alg2.4.13" class="ltx_listingline"> <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span>  <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span>  <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span> <span id="alg2.4.13.1" class="ltx_text ltx_font_typewriter">// </span><span id="alg2.4.13.2" class="ltx_text ltx_font_typewriter">Step 3: Redundancy Elimination </span>
</div>
<div id="alg2.4.14" class="ltx_listingline"> <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span>  <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span>  <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span> 
              <span class="ltx_tag ltx_tag_listingline"><span id="alg2.4.14.1" class="ltx_text ltx_font_bold">7</span></span>
            <span id="alg2.4.14.2" class="ltx_text ltx_font_bold">foreach</span> <em id="alg2.4.14.3" class="ltx_emph ltx_font_italic">Indicator <math id="alg2.m14" class="ltx_Math" alttext="I_{\text{new}}=(n_{\text{new}},d_{\text{new}},c_{\text{new}})\in\mathcal{I}_{\text{new}}" display="inline" intent=":literal"><semantics><mrow><msub><mi>I</mi><mtext class="ltx_mathvariant_italic">new</mtext></msub><mo>=</mo><mrow><mo stretchy="false">(</mo><msub><mi>n</mi><mtext class="ltx_mathvariant_italic">new</mtext></msub><mo>,</mo><msub><mi>d</mi><mtext class="ltx_mathvariant_italic">new</mtext></msub><mo>,</mo><msub><mi>c</mi><mtext class="ltx_mathvariant_italic">new</mtext></msub><mo stretchy="false">)</mo></mrow><mo>∈</mo><msub><mi class="ltx_font_mathcaligraphic">ℐ</mi><mtext class="ltx_mathvariant_italic">new</mtext></msub></mrow><annotation encoding="application/x-tex">I_{\text{new}}=(n_{\text{new}},d_{\text{new}},c_{\text{new}})\in\mathcal{I}_{\text{new}}</annotation></semantics></math></em> <span id="alg2.4.14.4" class="ltx_text ltx_font_bold">do</span>
</div>
<div id="alg2.4.15" class="ltx_listingline"> <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span>  <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span>  <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span>  <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span> 
              <span class="ltx_tag ltx_tag_listingline"><span id="alg2.4.15.1" class="ltx_text ltx_font_bold">8</span></span>
            <math id="alg2.m15" class="ltx_Math" alttext="\mathbf{v}_{\text{new}}\leftarrow M_{\text{emb}}(d_{\text{new}}\oplus c_{\text{new}})" display="inline" intent=":literal"><semantics><mrow><msub><mi>𝐯</mi><mtext>new</mtext></msub><mo stretchy="false">←</mo><mrow><msub><mi>M</mi><mtext>emb</mtext></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>d</mi><mtext>new</mtext></msub><mo>⊕</mo><msub><mi>c</mi><mtext>new</mtext></msub></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\mathbf{v}_{\text{new}}\leftarrow M_{\text{emb}}(d_{\text{new}}\oplus c_{\text{new}})</annotation></semantics></math> ;  <span id="alg2.4.15.2" class="ltx_text ltx_font_typewriter">// </span><span id="alg2.4.15.3" class="ltx_text ltx_font_typewriter">Compute semantic vector</span>
</div>
<div id="alg2.4.16" class="ltx_listingline"> <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span>  <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span>  <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span>  <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span> 
              <span class="ltx_tag ltx_tag_listingline"><span id="alg2.4.16.1" class="ltx_text ltx_font_bold">9</span></span>
            <math id="alg2.m16" class="ltx_Math" alttext="\mathcal{I}_{\text{sim}}\leftarrow\text{Top-}K_{\text{dedup}}(\mathbf{v}_{\text{new}},\mathcal{I})" display="inline" intent=":literal"><semantics><mrow><msub><mi class="ltx_font_mathcaligraphic">ℐ</mi><mtext>sim</mtext></msub><mo stretchy="false">←</mo><mrow><mtext>Top-</mtext><mo lspace="0em" rspace="0em">​</mo><msub><mi>K</mi><mtext>dedup</mtext></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐯</mi><mtext>new</mtext></msub><mo>,</mo><mi class="ltx_font_mathcaligraphic">ℐ</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\mathcal{I}_{\text{sim}}\leftarrow\text{Top-}K_{\text{dedup}}(\mathbf{v}_{\text{new}},\mathcal{I})</annotation></semantics></math> ;  <span id="alg2.4.16.2" class="ltx_text ltx_font_typewriter">// </span><span id="alg2.4.16.3" class="ltx_text ltx_font_typewriter">Retrieve top-<math id="alg2.m17" class="ltx_Math" alttext="K_{\text{dedup}}" display="inline" intent=":literal"><semantics><msub><mi>K</mi><mtext class="ltx_mathvariant_monospace">dedup</mtext></msub><annotation encoding="application/x-tex">K_{\text{dedup}}</annotation></semantics></math> similar set</span>
</div>
<div id="alg2.4.17" class="ltx_listingline"> <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span>  <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span>  <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span>  <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span> 
              <span class="ltx_tag ltx_tag_listingline"><span id="alg2.4.17.1" class="ltx_text ltx_font_bold">10</span></span>
            <math id="alg2.m18" class="ltx_Math" alttext="IsNovel\leftarrow\Phi_{\text{dedup}}\left(I_{\text{new}},\mathcal{I}_{\text{sim}}\right)" display="inline" intent=":literal"><semantics><mrow><mrow><mi>I</mi><mo lspace="0em" rspace="0em">​</mo><mi>s</mi><mo lspace="0em" rspace="0em">​</mo><mi>N</mi><mo lspace="0em" rspace="0em">​</mo><mi>o</mi><mo lspace="0em" rspace="0em">​</mo><mi>v</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mi>l</mi></mrow><mo stretchy="false">←</mo><mrow><msub><mi mathvariant="normal">Φ</mi><mtext>dedup</mtext></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><msub><mi>I</mi><mtext>new</mtext></msub><mo>,</mo><msub><mi class="ltx_font_mathcaligraphic">ℐ</mi><mtext>sim</mtext></msub><mo>)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">IsNovel\leftarrow\Phi_{\text{dedup}}\left(I_{\text{new}},\mathcal{I}_{\text{sim}}\right)</annotation></semantics></math>;
</div>
<div id="alg2.4.18" class="ltx_listingline"> <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span>  <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span>  <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span>  <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span> 
              <span class="ltx_tag ltx_tag_listingline"><span id="alg2.4.18.1" class="ltx_text ltx_font_bold">11</span></span>
            <span id="alg2.4.18.2" class="ltx_text ltx_font_bold">if</span> <em id="alg2.4.18.3" class="ltx_emph ltx_font_italic"><math id="alg2.m19" class="ltx_Math" alttext="IsNovel" display="inline" intent=":literal"><semantics><mrow><mi>I</mi><mo lspace="0em" rspace="0em">​</mo><mi>s</mi><mo lspace="0em" rspace="0em">​</mo><mi>N</mi><mo lspace="0em" rspace="0em">​</mo><mi>o</mi><mo lspace="0em" rspace="0em">​</mo><mi>v</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mi>l</mi></mrow><annotation encoding="application/x-tex">IsNovel</annotation></semantics></math> is True</em> <span id="alg2.4.18.4" class="ltx_text ltx_font_bold">then</span>
</div>
<div id="alg2.4.19" class="ltx_listingline"> <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span>  <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span>  <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span>  <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span>  <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span> 
              <span class="ltx_tag ltx_tag_listingline"><span id="alg2.4.19.1" class="ltx_text ltx_font_bold">12</span></span>
            <math id="alg2.m20" class="ltx_Math" alttext="\mathcal{I}\leftarrow\mathcal{I}\cup\{I_{\text{new}}\}" display="inline" intent=":literal"><semantics><mrow><mi class="ltx_font_mathcaligraphic">ℐ</mi><mo stretchy="false">←</mo><mrow><mi class="ltx_font_mathcaligraphic">ℐ</mi><mo>∪</mo><mrow><mo stretchy="false">{</mo><msub><mi>I</mi><mtext>new</mtext></msub><mo stretchy="false">}</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\mathcal{I}\leftarrow\mathcal{I}\cup\{I_{\text{new}}\}</annotation></semantics></math> ;  <span id="alg2.4.19.2" class="ltx_text ltx_font_typewriter">// </span><span id="alg2.4.19.3" class="ltx_text ltx_font_typewriter">Add novel error pattern</span>
</div>
<div id="alg2.4.20" class="ltx_listingline">
