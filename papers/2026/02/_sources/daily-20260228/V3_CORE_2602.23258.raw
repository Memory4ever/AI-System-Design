</span></span></span></foreignObject></g><g fill-opacity="1.0" transform="matrix(1.0 0.0 0.0 1.0 21.65 16.2)"><foreignObject style="--ltx-fo-width:33.91em;--ltx-fo-height:5.87em;--ltx-fo-depth:0.19em;font-size:9.25pt;" height="77.56" overflow="visible" transform="matrix(1 0 0 -1 0 75.14)" width="434.02"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content">
