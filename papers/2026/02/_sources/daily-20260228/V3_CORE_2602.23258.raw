            <span id="alg2.4.20.2" class="ltx_text ltx_font_bold">return</span> <math id="alg2.m21" class="ltx_Math" alttext="\mathcal{I}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">ℐ</mi><annotation encoding="application/x-tex">\mathcal{I}</annotation></semantics></math>;
