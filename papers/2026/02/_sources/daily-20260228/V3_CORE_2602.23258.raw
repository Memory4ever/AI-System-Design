<figure id="A1.F7" class="ltx_figure"><span class="ltx_inline-block"><svg id="A1.F7.pic1" class="ltx_picture ltx_centering" height="123.61" overflow="visible" version="1.1" viewBox="0 0 477.38 123.61" width="477.38"><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" stroke-width="0.4pt" transform="translate(0,123.61) matrix(1 0 0 -1 0 0)"><g style="--ltx-fill-color:#404040;" fill="#404040" fill-opacity="1.0"><path style="stroke:none" d="M 0 5.91 L 0 117.7 C 0 120.96 2.64 123.61 5.91 123.61 L 471.47 123.61 C 474.73 123.61 477.38 120.96 477.38 117.7 L 477.38 5.91 C 477.38 2.64 474.73 0 471.47 0 L 5.91 0 C 2.64 0 0 2.64 0 5.91 Z"></path></g><g style="--ltx-fill-color:#F2F2F2;" fill="#F2F2F2" fill-opacity="1.0"><path style="stroke:none" d="M 1.97 5.91 L 1.97 103.15 L 475.41 103.15 L 475.41 5.91 C 475.41 3.73 473.65 1.97 471.47 1.97 L 5.91 1.97 C 3.73 1.97 1.97 3.73 1.97 5.91 Z"></path></g><g fill-opacity="1.0" transform="matrix(1.0 0.0 0.0 1.0 21.65 109.05)"><foreignObject style="--ltx-fo-width:33.91em;--ltx-fo-height:0.68em;--ltx-fo-depth:0em;font-size:9.25pt;" height="8.65" overflow="visible" transform="matrix(1 0 0 -1 0 8.65)" width="434.02"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content">
