<th id="S3.T1.5.1.2.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_t">Single</th>
<td id="S3.T1.5.1.2.2" class="ltx_td ltx_align_center ltx_border_t">87.64</td>
<td id="S3.T1.5.1.2.3" class="ltx_td ltx_align_center ltx_border_t">74.80</td>
<td id="S3.T1.5.1.2.4" class="ltx_td ltx_align_center ltx_border_t">84.19</td>
<td id="S3.T1.5.1.2.5" class="ltx_td ltx_align_center ltx_border_t">62.50</td>
<td id="S3.T1.5.1.2.6" class="ltx_td ltx_align_center ltx_border_t">47.56</td>
<td id="S3.T1.5.1.2.7" class="ltx_td ltx_align_center ltx_border_t">20.00</td>
<td id="S3.T1.5.1.2.8" class="ltx_td ltx_align_center ltx_border_t">16.00</td>
<td id="S3.T1.5.1.2.9" class="ltx_td ltx_align_center ltx_border_t">13.33</td>
<td id="S3.T1.5.1.2.10" class="ltx_td ltx_align_center ltx_border_t">20.00</td>
<td id="S3.T1.5.1.2.11" class="ltx_td ltx_align_center ltx_border_t">47.34<sub id="S3.T1.5.1.2.11.1" class="ltx_sub"><span id="S3.T1.5.1.2.11.1.1" class="ltx_text ltx_font_italic">+0.00</span></sub></td></tr>
<tr id="S3.T1.5.1.3" class="ltx_tr">
