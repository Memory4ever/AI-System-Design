<td id="S6.T8.5.1.5.2" class="ltx_td ltx_align_center" style="padding:-0.45pt 12.0pt;"><span id="S6.T8.5.1.5.2.1" class="ltx_text" style="font-size:90%;">41.64</span></td>
<td id="S6.T8.5.1.5.3" class="ltx_td ltx_align_center" style="padding:-0.45pt 12.0pt;"><span id="S6.T8.5.1.5.3.1" class="ltx_text" style="font-size:90%;">17.80</span></td>
