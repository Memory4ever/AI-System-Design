<td id="S4.T2.7.1.1.2" class="ltx_td ltx_align_center ltx_border_tt" style="padding-top:-0.5pt;padding-bottom:-0.5pt;" rowspan="2"><span id="S4.T2.7.1.1.2.1" class="ltx_text">w/seg</span></td>
<td id="S4.T2.7.1.1.3" class="ltx_td ltx_align_center ltx_border_tt" style="padding-top:-0.5pt;padding-bottom:-0.5pt;" rowspan="2"><span id="S4.T2.7.1.1.3.1" class="ltx_text">#Params <math id="S4.T2.m1" class="ltx_Math" alttext="\downarrow" display="inline" intent=":literal"><semantics><mo stretchy="false">↓</mo><annotation encoding="application/x-tex">\downarrow</annotation></semantics></math></span></td>
<td id="S4.T2.7.1.1.4" class="ltx_td ltx_align_center ltx_border_r ltx_border_tt" style="padding-top:-0.5pt;padding-bottom:-0.5pt;" rowspan="2"><span id="S4.T2.7.1.1.4.1" class="ltx_text">FLOP <math id="S4.T2.m2" class="ltx_Math" alttext="\downarrow" display="inline" intent=":literal"><semantics><mo stretchy="false">↓</mo><annotation encoding="application/x-tex">\downarrow</annotation></semantics></math></span></td>
<td id="S4.T2.7.1.1.5" class="ltx_td ltx_align_center ltx_border_r ltx_border_tt" style="padding-top:-0.5pt;padding-bottom:-0.5pt;" colspan="4">ScanRefer</td>
