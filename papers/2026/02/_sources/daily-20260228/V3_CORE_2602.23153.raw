<td id="S6.T8.5.1.4.4" class="ltx_td ltx_align_center" style="padding:-0.45pt 12.0pt;"><span id="S6.T8.5.1.4.4.1" class="ltx_text" style="font-size:90%;">14.88</span></td>
<td id="S6.T8.5.1.4.5" class="ltx_td ltx_align_center" style="padding:-0.45pt 12.0pt;"><span id="S6.T8.5.1.4.5.1" class="ltx_text" style="font-size:90%;">83.92</span></td></tr>
