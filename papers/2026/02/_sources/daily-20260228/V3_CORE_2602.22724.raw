probe <math id="algorithm2.m6" class="ltx_Math" alttext="x^{\mathrm{mask}}" display="inline" intent=":literal"><semantics><msup><mi>x</mi><mi>mask</mi></msup><annotation encoding="application/x-tex">x^{\mathrm{mask}}</annotation></semantics></math>; user goal <math id="algorithm2.m7" class="ltx_Math" alttext="g" display="inline" intent=":literal"><semantics><mi>g</mi><annotation encoding="application/x-tex">g</annotation></semantics></math>; policy <math id="algorithm2.m8" class="ltx_Math" alttext="\Pi" display="inline" intent=":literal"><semantics><mi mathvariant="normal">Π</mi><annotation encoding="application/x-tex">\Pi</annotation></semantics></math>.</span>
</div>
<div id="algorithm2.7.2" class="ltx_listingline"><span id="algorithm2.7.2.1" class="ltx_text" style="font-size:90%;"><span id="algorithm2.7.2.1.1" class="ltx_text ltx_font_bold">Output:</span> </span><span id="algorithm2.7.2.2" class="ltx_text" style="font-size:90%;">Samples </span><math id="algorithm2.m9" class="ltx_Math" alttext="\{y_{b}^{(\iota,k)}\}" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">{</mo><msubsup><mi mathsize="0.900em">y</mi><mi mathsize="0.900em">b</mi><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><mi mathsize="0.900em">ι</mi><mo mathsize="0.900em">,</mo><mi mathsize="0.900em">k</mi><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow></msubsup><mo stretchy="false">}</mo></mrow><annotation encoding="application/x-tex">\{y_{b}^{(\iota,k)}\}</annotation></semantics></math><span id="algorithm2.7.2.3" class="ltx_text" style="font-size:90%;"> (and optionally </span><math id="algorithm2.m10" class="ltx_Math" alttext="\{v_{b}^{(\iota,k)}\}" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">{</mo><msubsup><mi mathsize="0.900em">v</mi><mi mathsize="0.900em">b</mi><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><mi mathsize="0.900em">ι</mi><mo mathsize="0.900em">,</mo><mi mathsize="0.900em">k</mi><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow></msubsup><mo stretchy="false">}</mo></mrow><annotation encoding="application/x-tex">\{v_{b}^{(\iota,k)}\}</annotation></semantics></math><span id="algorithm2.7.2.4" class="ltx_text" style="font-size:90%;">) for regimes </span><math id="algorithm2.m11" class="ltx_Math" alttext="\iota" display="inline" intent=":literal"><semantics><mi mathsize="0.900em">ι</mi><annotation encoding="application/x-tex">\iota</annotation></semantics></math><span id="algorithm2.7.2.5" class="ltx_text" style="font-size:90%;">.</span>
</div>
