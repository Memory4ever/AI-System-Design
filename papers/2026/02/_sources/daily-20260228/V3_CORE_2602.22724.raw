<td id="S5.T1.6.4.1" class="ltx_td ltx_align_left" style="padding-top:0.25pt;padding-bottom:0.25pt;"><span id="S5.T1.6.4.1.1" class="ltx_text" style="font-size:90%;">CU (<math id="S5.T1.m7" class="ltx_Math" alttext="\uparrow" display="inline" intent=":literal"><semantics><mo stretchy="false">↑</mo><annotation encoding="application/x-tex">\uparrow</annotation></semantics></math>)</span></td>
