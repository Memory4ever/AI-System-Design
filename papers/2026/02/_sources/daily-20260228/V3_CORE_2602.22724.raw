              <span class="ltx_tag ltx_tag_listingline"><span id="algorithm2.7.9.4" class="ltx_text ltx_font_bold" style="font-size:90%;">7</span></span>
            <span id="algorithm2.7.9.5" class="ltx_text" style="font-size:90%;">Invoke the base agent once to obtain a proposed next action </span><math id="algorithm2.m23" class="ltx_Math" alttext="A_{b}" display="inline" intent=":literal"><semantics><msub><mi mathsize="0.900em">A</mi><mi mathsize="0.900em">b</mi></msub><annotation encoding="application/x-tex">A_{b}</annotation></semantics></math>
</div>
<div id="algorithm2.7.10" class="ltx_listingline"><span id="algorithm2.7.10.1" class="ltx_text" style="font-size:90%;"> </span><span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span><span id="algorithm2.7.10.2" class="ltx_text" style="font-size:90%;">   </span><span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span><span id="algorithm2.7.10.3" class="ltx_text" style="font-size:90%;">  </span><span id="algorithm2.7.10.4" class="ltx_text ltx_font_typewriter" style="font-size:90%;">// </span><span id="algorithm2.7.10.5" class="ltx_text ltx_font_typewriter" style="font-size:90%;">Dry-run: do not execute proposed tool calls; commit no external effects </span>
</div>
<div id="algorithm2.7.11" class="ltx_listingline"><span id="algorithm2.7.11.1" class="ltx_text" style="font-size:90%;"> </span><span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span><span id="algorithm2.7.11.2" class="ltx_text" style="font-size:90%;">   </span><span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span><span id="algorithm2.7.11.3" class="ltx_text" style="font-size:90%;">  </span>
              <span class="ltx_tag ltx_tag_listingline"><span id="algorithm2.7.11.4" class="ltx_text ltx_font_bold" style="font-size:90%;">8</span></span>
            <span id="algorithm2.7.11.5" class="ltx_text" style="font-size:90%;">Compute and store </span><math id="algorithm2.m24" class="ltx_Math" alttext="y_{b}^{(\iota,k)}=\psi(A_{b};\Pi)" display="inline" intent=":literal"><semantics><mrow><msubsup><mi mathsize="0.900em">y</mi><mi mathsize="0.900em">b</mi><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><mi mathsize="0.900em">ι</mi><mo mathsize="0.900em">,</mo><mi mathsize="0.900em">k</mi><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow></msubsup><mo mathsize="0.900em">=</mo><mrow><mi mathsize="0.900em">ψ</mi><mo>⁡</mo><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><msub><mi mathsize="0.900em">A</mi><mi mathsize="0.900em">b</mi></msub><mo mathsize="0.900em">,</mo><mi mathsize="0.900em" mathvariant="normal">Π</mi><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">y_{b}^{(\iota,k)}=\psi(A_{b};\Pi)</annotation></semantics></math><span id="algorithm2.7.11.6" class="ltx_text" style="font-size:90%;"> (and </span><math id="algorithm2.m25" class="ltx_Math" alttext="v_{b}^{(\iota,k)}" display="inline" intent=":literal"><semantics><msubsup><mi mathsize="0.900em">v</mi><mi mathsize="0.900em">b</mi><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><mi mathsize="0.900em">ι</mi><mo mathsize="0.900em">,</mo><mi mathsize="0.900em">k</mi><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow></msubsup><annotation encoding="application/x-tex">v_{b}^{(\iota,k)}</annotation></semantics></math><span id="algorithm2.7.11.7" class="ltx_text" style="font-size:90%;"> when enabled)</span>
</div>
