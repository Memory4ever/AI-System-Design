</thead>
<tbody class="ltx_tbody">
<tr id="A3.T11.2.3" class="ltx_tr">
<th id="A3.T11.2.3.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_t">L16-20_pc3</th>
<td id="A3.T11.2.3.2" class="ltx_td ltx_align_center ltx_border_t">—</td>
<td id="A3.T11.2.3.3" class="ltx_td ltx_align_center ltx_border_t">94.6</td>
<td id="A3.T11.2.3.4" class="ltx_td ltx_align_center ltx_border_t">76.0</td>
