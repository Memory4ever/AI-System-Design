<td id="A3.T11.2.4.4" class="ltx_td ltx_align_center">79.0</td>
<td id="A3.T11.2.4.5" class="ltx_td ltx_align_center">58.0</td></tr>
<tr id="A3.T11.2.5" class="ltx_tr">
<th id="A3.T11.2.5.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_bb">L17-20_pc5</th>
<td id="A3.T11.2.5.2" class="ltx_td ltx_align_center ltx_border_bb">—</td>
