<td id="A5.T2.6.1.4.2" class="ltx_td ltx_align_center"><math id="A5.T2.m7" class="ltx_Math" alttext="0.3sd" display="inline" intent=":literal"><semantics><mrow><mn mathsize="0.900em">0.3</mn><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">s</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">d</mi></mrow><annotation encoding="application/x-tex">0.3sd</annotation></semantics></math><span id="A5.T2.6.1.4.2.1" class="ltx_text" style="font-size:90%;"> = 47K</span></td>
<td id="A5.T2.6.1.4.3" class="ltx_td ltx_align_center"><math id="A5.T2.m8" class="ltx_Math" alttext="O(0.3s^{2})" display="inline" intent=":literal"><semantics><mrow><mi mathsize="0.900em">O</mi><mo>⁡</mo><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><mrow><mn mathsize="0.900em">0.3</mn><mo lspace="0em" rspace="0em">​</mo><msup><mi mathsize="0.900em">s</mi><mn mathsize="0.900em">2</mn></msup></mrow><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow></mrow><annotation encoding="application/x-tex">O(0.3s^{2})</annotation></semantics></math></td>
<td id="A5.T2.6.1.4.4" class="ltx_td ltx_align_center"><span id="A5.T2.6.1.4.4.1" class="ltx_text" style="font-size:90%;">Every 5th layer</span></td></tr>
