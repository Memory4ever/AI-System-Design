<br class="ltx_break"><span id="A5.T1.6.1.8.4.1.1.2" class="ltx_text" style="font-size:90%;">2) Learned residual scale </span><math id="A5.T1.m21" class="ltx_Math" alttext="0.9\pm 0.1" display="inline" intent=":literal"><semantics><mrow><mn mathsize="0.900em">0.9</mn><mo mathsize="0.900em">±</mo><mn mathsize="0.900em">0.1</mn></mrow><annotation encoding="application/x-tex">0.9\pm 0.1</annotation></semantics></math><span id="A5.T1.6.1.8.4.1.1.3" class="ltx_text" style="font-size:90%;"> </span>
<br class="ltx_break"></span>
</span></td></tr>
</table>
</span></div>
</figure>
