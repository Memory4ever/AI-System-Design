<span id="A5.T1.6.1.6.3.1.1" class="ltx_p"><math id="A5.T1.m16" class="ltx_Math" alttext="c=0.5+0.5\cdot\sigma(\text{MLP}(\bar{x}))" display="inline" intent=":literal"><semantics><mrow><mi mathsize="0.900em">c</mi><mo mathsize="0.900em">=</mo><mrow><mn mathsize="0.900em">0.5</mn><mo mathsize="0.900em">+</mo><mrow><mrow><mn mathsize="0.900em">0.5</mn><mo lspace="0.222em" mathsize="0.900em" rspace="0.222em">⋅</mo><mi mathsize="0.900em">σ</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><mrow><mtext mathsize="0.900em">MLP</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><mover accent="true"><mi mathsize="0.900em">x</mi><mo>¯</mo></mover><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow></mrow><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">c=0.5+0.5\cdot\sigma(\text{MLP}(\bar{x}))</annotation></semantics></math></span>
</span></td>
