<td id="A2.T1.5.1.6.3" class="ltx_td ltx_align_left" style="padding-left:4.0pt;padding-right:4.0pt;"><span id="A2.T1.5.1.6.3.1" class="ltx_text" style="font-size:90%;">Stable convergence</span></td></tr>
