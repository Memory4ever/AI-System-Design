<span id="A5.T1.6.1.7.1.1.1" class="ltx_p"><span id="A5.T1.6.1.7.1.1.1.1" class="ltx_text" style="font-size:90%;">Gradient control</span></span>
</span></td>
<td id="A5.T1.6.1.7.2" class="ltx_td ltx_align_left ltx_align_top ltx_border_t" style="padding-left:3.0pt;padding-right:3.0pt;">
