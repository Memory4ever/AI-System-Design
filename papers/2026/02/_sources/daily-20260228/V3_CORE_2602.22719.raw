<td id="A5.T2.6.1.2.2" class="ltx_td ltx_align_center ltx_border_t"><math id="A5.T2.m2" class="ltx_Math" alttext="3d^{2}" display="inline" intent=":literal"><semantics><mrow><mn mathsize="0.900em">3</mn><mo lspace="0em" rspace="0em">​</mo><msup><mi mathsize="0.900em">d</mi><mn mathsize="0.900em">2</mn></msup></mrow><annotation encoding="application/x-tex">3d^{2}</annotation></semantics></math><span id="A5.T2.6.1.2.2.1" class="ltx_text" style="font-size:90%;"> = 1.77M</span></td>
<td id="A5.T2.6.1.2.3" class="ltx_td ltx_align_center ltx_border_t"><math id="A5.T2.m3" class="ltx_Math" alttext="O(d\cdot s)" display="inline" intent=":literal"><semantics><mrow><mi mathsize="0.900em">O</mi><mo>⁡</mo><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><mrow><mi mathsize="0.900em">d</mi><mo lspace="0.222em" mathsize="0.900em" rspace="0.222em">⋅</mo><mi mathsize="0.900em">s</mi></mrow><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow></mrow><annotation encoding="application/x-tex">O(d\cdot s)</annotation></semantics></math></td>
