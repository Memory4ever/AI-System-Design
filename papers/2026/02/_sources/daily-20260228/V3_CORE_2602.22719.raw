<span id="A5.T1.6.1.8.3.1" class="ltx_inline-block ltx_align_top" style="width:148.0pt;">
<span id="A5.T1.6.1.8.3.1.1" class="ltx_p"><math id="A5.T1.m20" class="ltx_Math" alttext="\text{output}=(y_{t}+\lambda_{\text{res}}x)\lambda_{\text{global}}" display="inline" intent=":literal"><semantics><mrow><mtext mathsize="0.900em">output</mtext><mo mathsize="0.900em">=</mo><mrow><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><mrow><msub><mi mathsize="0.900em">y</mi><mi mathsize="0.900em">t</mi></msub><mo mathsize="0.900em">+</mo><mrow><msub><mi mathsize="0.900em">λ</mi><mtext mathsize="0.900em">res</mtext></msub><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">x</mi></mrow></mrow><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi mathsize="0.900em">λ</mi><mtext mathsize="0.900em">global</mtext></msub></mrow></mrow><annotation encoding="application/x-tex">\text{output}=(y_{t}+\lambda_{\text{res}}x)\lambda_{\text{global}}</annotation></semantics></math></span>
</span></td>
