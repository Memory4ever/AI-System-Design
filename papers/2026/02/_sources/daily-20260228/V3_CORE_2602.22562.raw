<span id="S4.tab1.1.2.1.1" class="ltx_inline-block ltx_align_top" style="width:345.0pt;">
<span id="S4.tab1.1.2.1.1.1" class="ltx_p"><span id="S4.tab1.1.2.1.1.1.1" class="ltx_text ltx_font_bold" style="font-size:90%;">Require:</span><span id="S4.tab1.1.2.1.1.1.2" class="ltx_text" style="font-size:90%;"> Multilingual LLM </span><math id="S4.m1" class="ltx_Math" alttext="M_{\theta}" display="inline" intent=":literal"><semantics><msub><mi mathsize="0.900em">M</mi><mi mathsize="0.900em">θ</mi></msub><annotation encoding="application/x-tex">M_{\theta}</annotation></semantics></math><span id="S4.tab1.1.2.1.1.1.3" class="ltx_text" style="font-size:90%;"> with </span><math id="S4.m2" class="ltx_Math" alttext="L" display="inline" intent=":literal"><semantics><mi mathsize="0.900em">L</mi><annotation encoding="application/x-tex">L</annotation></semantics></math><span id="S4.tab1.1.2.1.1.1.4" class="ltx_text" style="font-size:90%;"> layers, forget set </span><math id="S4.m3" class="ltx_Math" alttext="D_{\text{forget}}" display="inline" intent=":literal"><semantics><msub><mi mathsize="0.900em">D</mi><mtext mathsize="0.900em">forget</mtext></msub><annotation encoding="application/x-tex">D_{\text{forget}}</annotation></semantics></math><span id="S4.tab1.1.2.1.1.1.5" class="ltx_text" style="font-size:90%;">, retain set </span><math id="S4.m4" class="ltx_Math" alttext="D_{\text{retain}}" display="inline" intent=":literal"><semantics><msub><mi mathsize="0.900em">D</mi><mtext mathsize="0.900em">retain</mtext></msub><annotation encoding="application/x-tex">D_{\text{retain}}</annotation></semantics></math><span id="S4.tab1.1.2.1.1.1.6" class="ltx_text" style="font-size:90%;">, source languages </span><math id="S4.m5" class="ltx_Math" alttext="\mathcal{L}_{\text{src}}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic" mathsize="0.900em">ℒ</mi><mtext mathsize="0.900em">src</mtext></msub><annotation encoding="application/x-tex">\mathcal{L}_{\text{src}}</annotation></semantics></math><span id="S4.tab1.1.2.1.1.1.7" class="ltx_text" style="font-size:90%;">, scaling factor </span><math id="S4.m6" class="ltx_Math" alttext="\alpha" display="inline" intent=":literal"><semantics><mi mathsize="0.900em">α</mi><annotation encoding="application/x-tex">\alpha</annotation></semantics></math></span>
</span></td></tr>
<tr id="S4.tab1.1.3" class="ltx_tr">
