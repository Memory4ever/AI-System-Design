<th id="A3.T9.6.1.2.6" class="ltx_td ltx_align_center ltx_th ltx_th_column"><span id="A3.T9.6.1.2.6.1" class="ltx_text ltx_font_bold">L16 (Target)</span></th>
<th id="A3.T9.6.1.2.7" class="ltx_td ltx_align_center ltx_th ltx_th_column">L30 (Deep)</th></tr>
<tr id="A3.T9.6.1.3" class="ltx_tr">
<th id="A3.T9.6.1.3.1" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_t" style="--ltx-bg-color:#F2F2F2;" colspan="8"><span id="A3.T9.6.1.3.1.1" class="ltx_text ltx_font_bold" style="--ltx-bg-color:#F2F2F2;">FORGET SET RECALL<span id="A3.T9.6.1.3.1.1.1" class="ltx_text ltx_font_medium"> (Lower is Better <math id="A3.T9.m1" class="ltx_Math" alttext="\downarrow" display="inline" intent=":literal"><semantics><mo style="--ltx-bg-color:#F2F2F2;" mathbackground="#F2F2F2" stretchy="false">↓</mo><annotation encoding="application/x-tex">\downarrow</annotation></semantics></math>)</span></span></th></tr>
</thead>
