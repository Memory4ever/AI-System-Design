<th id="A3.T9.6.1.1.2" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt"><span id="A3.T9.6.1.1.2.1" class="ltx_text ltx_font_bold">Base</span></th>
<th id="A3.T9.6.1.1.3" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_r ltx_border_tt"><span id="A3.T9.6.1.1.3.1" class="ltx_text ltx_font_bold">Finetuned</span></th>
<th id="A3.T9.6.1.1.4" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt" colspan="5"><span id="A3.T9.6.1.1.4.1" class="ltx_text ltx_font_bold">Internal Recall by Intervention Layer</span></th></tr>
<tr id="A3.T9.6.1.2" class="ltx_tr">
