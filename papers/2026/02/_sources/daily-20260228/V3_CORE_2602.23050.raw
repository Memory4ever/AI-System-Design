<div id="S6.T1.sf2.2" class="ltx_inline-block ltx_transformed_outer" style="width:173.7pt;height:31.4pt;vertical-align:-14.8pt;"><span class="ltx_transformed_inner" style="transform:translate(-154.5pt,27.9pt) scale(0.359862225996593,0.359862225996593) ;">
<table id="S6.T1.sf2.2.1" class="ltx_tabular ltx_guessed_headers ltx_align_middle">
<thead class="ltx_thead">
