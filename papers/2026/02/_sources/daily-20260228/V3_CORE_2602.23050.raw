<g stroke-dasharray="none" stroke-dashoffset="0.0pt" stroke-linejoin="round" transform="matrix(1.0 0.0 0.0 1.0 39.51 -102.98)"><path d="M 1.11 0 C -0.28 0.28 -1.66 0.83 -3.32 1.8 C -1.66 0.55 -1.66 -0.55 -3.32 -1.8 C -1.66 -0.83 -0.28 -0.28 1.11 0 Z"></path></g><g stroke-dasharray="3.0pt,3.0pt" stroke-dashoffset="0.0pt"><path style="fill:none" d="M 71.73 -102.98 L 96.52 -102.98"></path></g><g stroke-dasharray="none" stroke-dashoffset="0.0pt" stroke-linejoin="round" transform="matrix(1.0 0.0 0.0 1.0 96.52 -102.98)"><path d="M 1.11 0 C -0.28 0.28 -1.66 0.83 -3.32 1.8 C -1.66 0.55 -1.66 -0.55 -3.32 -1.8 C -1.66 -0.83 -0.28 -0.28 1.11 0 Z"></path></g><g stroke-dasharray="3.0pt,3.0pt" stroke-dashoffset="0.0pt"><path style="fill:none" d="M 128.73 -102.98 L 153.52 -102.98"></path></g><g stroke-dasharray="none" stroke-dashoffset="0.0pt" stroke-linejoin="round" transform="matrix(1.0 0.0 0.0 1.0 153.52 -102.98)"><path d="M 1.11 0 C -0.28 0.28 -1.66 0.83 -3.32 1.8 C -1.66 0.55 -1.66 -0.55 -3.32 -1.8 C -1.66 -0.83 -0.28 -0.28 1.11 0 Z"></path></g><path style="fill:none" d="M -42.28 -102.98 L -17.49 -102.98"></path><g stroke-dasharray="none" stroke-dashoffset="0.0pt" stroke-linejoin="round" transform="matrix(1.0 0.0 0.0 1.0 -17.49 -102.98)"><path d="M 1.11 0 C -0.28 0.28 -1.66 0.83 -3.32 1.8 C -1.66 0.55 -1.66 -0.55 -3.32 -1.8 C -1.66 -0.83 -0.28 -0.28 1.11 0 Z"></path></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#DFDFDF;" fill="#DFDFDF" stroke="#000000"><path d="M 14.53 -154.48 C 14.53 -146.45 8.02 -139.95 0 -139.95 C -8.02 -139.95 -14.53 -146.45 -14.53 -154.48 C -14.53 -162.5 -8.02 -169 0 -169 C 8.02 -169 14.53 -162.5 14.53 -154.48 Z M 0 -154.48"></path></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(0.7 0.0 0.0 0.7 -5.27 -155.9)"><foreignObject style="--ltx-fo-width:1.09em;--ltx-fo-height:0.44em;--ltx-fo-depth:0.15em;font-size:10pt;" height="8.23" overflow="visible" transform="matrix(1 0 0 -1 0 6.15)" width="15.05"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="A1.F7.pic1.m12" class="ltx_Math" alttext="\mathbf{u}_{1}" display="inline" intent=":literal"><semantics><msub><mi>𝐮</mi><mn>1</mn></msub><annotation encoding="application/x-tex">\mathbf{u}_{1}</annotation></semantics></math></span></span></foreignObject></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#DFDFDF;" fill="#DFDFDF" stroke="#000000"><path d="M 71.53 -154.48 C 71.53 -146.45 65.03 -139.95 57 -139.95 C 48.98 -139.95 42.47 -146.45 42.47 -154.48 C 42.47 -162.5 48.98 -169 57 -169 C 65.03 -169 71.53 -162.5 71.53 -154.48 Z M 57 -154.48"></path></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(0.7 0.0 0.0 0.7 51.74 -155.9)"><foreignObject style="--ltx-fo-width:1.09em;--ltx-fo-height:0.44em;--ltx-fo-depth:0.15em;font-size:10pt;" height="8.23" overflow="visible" transform="matrix(1 0 0 -1 0 6.15)" width="15.05"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="A1.F7.pic1.m13" class="ltx_Math" alttext="\mathbf{u}_{2}" display="inline" intent=":literal"><semantics><msub><mi>𝐮</mi><mn>2</mn></msub><annotation encoding="application/x-tex">\mathbf{u}_{2}</annotation></semantics></math></span></span></foreignObject></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#FFFFFF;" fill="#FFFFFF" stroke="#000000"><path style="stroke:none" d="M 128.54 -154.48 C 128.54 -146.45 122.03 -139.95 114.01 -139.95 C 105.98 -139.95 99.48 -146.45 99.48 -154.48 C 99.48 -162.5 105.98 -169 114.01 -169 C 122.03 -169 128.54 -162.5 128.54 -154.48 Z M 114.01 -154.48"></path></g><path style="fill:none" d="M 10.92 -144.61 L 44.02 -114.71"></path><g stroke-dasharray="none" stroke-dashoffset="0.0pt" stroke-linejoin="round" transform="matrix(0.74207 0.67032 -0.67032 0.74207 44.02 -114.71)"><path d="M 1.11 0 C -0.28 0.28 -1.66 0.83 -3.32 1.8 C -1.66 0.55 -1.66 -0.55 -3