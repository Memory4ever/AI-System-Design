<td id="A1.T3.2.1.3.2" class="ltx_td ltx_align_left" style="padding-top:1pt;padding-bottom:1pt;">1<math id="A1.T3.m2" class="ltx_Math" alttext="e" display="inline" intent=":literal"><semantics><mi>e</mi><annotation encoding="application/x-tex">e</annotation></semantics></math>-3</td>
