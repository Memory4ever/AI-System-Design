<span id="S6.T3.5.1.2.1.1" class="ltx_p">TE</span>
</span></th>
<th id="S6.T3.5.1.3" class="ltx_td ltx_align_left ltx_align_top ltx_th ltx_th_column ltx_border_tt">
<span id="S6.T3.5.1.3.1" class="ltx_inline-block ltx_align_top" style="width:45.5pt;">
<span id="S6.T3.5.1.3.1.1" class="ltx_p">AE</span>
</span></th></tr>
