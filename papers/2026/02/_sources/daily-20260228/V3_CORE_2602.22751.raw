<figcaption class="ltx_caption ltx_centering"><span class="ltx_tag ltx_tag_figure"><span id="A1.F5.sf2.3" class="ltx_text" style="font-size:90%;">(b)</span> </span><span id="A1.F5.sf2.4" class="ltx_text" style="font-size:90%;">DeepSeek-R1-Distill-Qwen-1.5B</span></figcaption>
</figure></div></div>
