<td id="A2.T5.2.10.2" class="ltx_td ltx_align_center"><math id="A2.T5.m33" class="ltx_Math" alttext=".880\pm.009" display="inline" intent=":literal"><semantics><mrow><mn>.880</mn><mo>±</mo><mn>.009</mn></mrow><annotation encoding="application/x-tex">.880\pm.009</annotation></semantics></math></td>
