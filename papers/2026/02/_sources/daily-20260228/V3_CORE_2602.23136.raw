<th id="A3.T11.2.1.2" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt"><span id="A3.T11.2.1.2.1" class="ltx_text ltx_font_bold">Mode 0 <math id="A3.T11.m1" class="ltx_Math" alttext="\tilde{\alpha}" display="inline" intent=":literal"><semantics><mover accent="true"><mi>α</mi><mo>~</mo></mover><annotation encoding="application/x-tex">\tilde{\alpha}</annotation></semantics></math></span></th>
<th id="A3.T11.2.1.3" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt"><span id="A3.T11.2.1.3.1" class="ltx_text ltx_font_bold">Mean <math id="A3.T11.m2" class="ltx_Math" alttext="\tilde{\alpha}" display="inline" intent=":literal"><semantics><mover accent="true"><mi>α</mi><mo>~</mo></mover><annotation encoding="application/x-tex">\tilde{\alpha}</annotation></semantics></math> (top 10)</span></th>
