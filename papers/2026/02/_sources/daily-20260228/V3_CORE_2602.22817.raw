<div id="A2.T6.2" class="ltx_inline-block ltx_align_center ltx_transformed_outer" style="width:397.5pt;height:50.5pt;vertical-align:-23.4pt;"><span class="ltx_transformed_inner" style="transform:translate(-72.4pt,9.2pt) scale(0.732931340913102,0.732931340913102) ;">
