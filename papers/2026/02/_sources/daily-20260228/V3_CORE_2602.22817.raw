<td id="A4.T7.8.1.4.3" class="ltx_td ltx_align_center" style="--ltx-bg-color:#ECECEC;padding-left:12.0pt;padding-right:12.0pt;"><span id="A4.T7.8.1.4.3.1" class="ltx_text" style="--ltx-bg-color:#ECECEC;"><span id="A4.T7.8.1.4.3.1.1" class="ltx_text ltx_font_bold">89.58<sub id="A4.T7.8.1.4.3.1.1.1" class="ltx_sub"><span id="A4.T7.8.1.4.3.1.1.1.1" class="ltx_text ltx_font_medium">±0.45</span></sub></span></span></td>
