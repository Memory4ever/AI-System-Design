                 <math id="alg1.l4.m1" class="ltx_math_unparsed" alttext="\hat{a}_{t+1:t+T}\sim\pi_{r}(\cdot|p_{t-h:t},\mathbf{F}_{t-h:t})" display="inline" intent=":literal"><semantics><mrow><msub><mover accent="true"><mi>a</mi><mo>^</mo></mover><mrow><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi>t</mi><mo>+</mo><mi>T</mi></mrow></mrow></msub><mo>∼</mo><msub><mi>π</mi><mi>r</mi></msub><mrow><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><msub><mi>p</mi><mrow><mrow><mi>t</mi><mo>−</mo><mi>h</mi></mrow><mo lspace="0.278em" rspace="0.278em">:</mo><mi>t</mi></mrow></msub><mo>,</mo><msub><mi>𝐅</mi><mrow><mrow><mi>t</mi><mo>−</mo><mi>h</mi></mrow><mo lspace="0.278em" rspace="0.278em">:</mo><mi>t</mi></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\hat{a}_{t+1:t+T}\sim\pi_{r}(\cdot|p_{t-h:t},\mathbf{F}_{t-h:t})</annotation></semantics></math>

