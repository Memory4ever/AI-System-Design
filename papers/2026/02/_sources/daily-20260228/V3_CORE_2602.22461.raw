environment mesh <math id="alg1.l1.m7" class="ltx_Math" alttext="\mathcal{M}^{e}" display="inline" intent=":literal"><semantics><msup><mi class="ltx_font_mathcaligraphic">ℳ</mi><mi>e</mi></msup><annotation encoding="application/x-tex">\mathcal{M}^{e}</annotation></semantics></math>

