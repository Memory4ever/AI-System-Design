<span id="A2.I3.ix3.p1.1" class="ltx_p"><span id="A2.I3.ix3.p1.1.1" class="ltx_text" style="font-size:90%;">Puttu*1, Egg Curry*1</span></span>
</span></span>
<span id="A2.I3.ix4" class="ltx_item"><span class="ltx_tag ltx_tag_item"><span id="A2.I3.ix4.1" class="ltx_text ltx_font_bold" style="font-size:80%;--ltx-fg-color:#2980B9;">FAQ Type</span></span></span>
<span class="ltx_item">
<span id="A2.I3.ix4.p1" class="ltx_para">
<span id="A2.I3.ix4.p1.1" class="ltx_p"><span id="A2.I3.ix4.p1.1.1" class="ltx_text" style="font-size:90%;">Food quality issue (Not delicious)</span></span>
</span></span>
<span id="A2.I3.ix5" class="ltx_item"><span class="ltx_tag ltx_tag_item"><span id="A2.I3.ix5.1" class="ltx_text ltx_font_bold" style="font-size:80%;--ltx-fg-color:#2980B9;">IM History</span></span></span>
<span class="ltx_item">
<span id="A2.I3.ix5.p1" class="ltx_para">
<span id="A2.I3.ix5.p1.1" class="ltx_p"><span id="A2.I3.ix5.p1.1.1" class="ltx_text ltx_font_italic" style="font-size:90%;">Courier: null</span></span>
</span></span>
