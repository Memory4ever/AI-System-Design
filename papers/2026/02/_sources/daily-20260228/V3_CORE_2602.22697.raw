<span id="A2.I3.ix2.p1" class="ltx_para">
<span id="A2.I3.ix2.p1.1" class="ltx_p"><span id="A2.I3.ix2.p1.1.1" class="ltx_text" style="font-size:90%;">Delivered — </span><span id="A2.I3.ix2.p1.1.2" class="ltx_text ltx_font_bold" style="font-size:90%;">Koyikodan</span></span>
</span></span>
<span id="A2.I3.ix3" class="ltx_item"><span class="ltx_tag ltx_tag_item"><span id="A2.I3.ix3.1" class="ltx_text ltx_font_bold" style="font-size:80%;--ltx-fg-color:#2980B9;">Food Info</span></span></span>
<span class="ltx_item">
