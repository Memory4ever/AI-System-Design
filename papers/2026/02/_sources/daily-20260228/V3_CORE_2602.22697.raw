<td id="S6.T2.5.1.3.4" class="ltx_td ltx_align_center ltx_border_t">16.6%</td>
<td id="S6.T2.5.1.3.5" class="ltx_td ltx_align_center ltx_border_r ltx_border_t">152</td>
<td id="S6.T2.5.1.3.6" class="ltx_td ltx_align_center ltx_border_t">14.0%</td>
<td id="S6.T2.5.1.3.7" class="ltx_td ltx_align_center ltx_border_t">76.0%</td>
<td id="S6.T2.5.1.3.8" class="ltx_td ltx_align_center ltx_border_t">18.0%</td>
