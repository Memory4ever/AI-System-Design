<td id="S4.T3.5.1.5.4" class="ltx_td ltx_align_center"><span id="S4.T3.5.1.5.4.1" class="ltx_text" style="font-size:90%;">67.9</span></td>
<td id="S4.T3.5.1.5.5" class="ltx_td ltx_align_center"><span id="S4.T3.5.1.5.5.1" class="ltx_text" style="font-size:90%;">65.7</span></td></tr>
<tr id="S4.T3.5.1.6" class="ltx_tr">
