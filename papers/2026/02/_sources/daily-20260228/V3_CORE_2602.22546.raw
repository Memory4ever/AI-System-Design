<th id="S5.T2.6.2.11" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_t" style="padding:2.3pt 2.0pt;">
<table id="S5.T2.6.2.11.1" class="ltx_tabular ltx_align_middle">
<tr id="S5.T2.6.2.11.1.1" class="ltx_tr">
<td id="S5.T2.6.2.11.1.1.1" class="ltx_td ltx_nopad_r ltx_align_center" style="padding:2.3pt 2.0pt;"><span id="S5.T2.6.2.11.1.1.1.1" class="ltx_text" style="font-size:90%;">Total</span></td></tr>
