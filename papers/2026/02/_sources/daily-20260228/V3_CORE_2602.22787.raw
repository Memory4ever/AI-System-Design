<th id="S3.T1.2.1.1.3" class="ltx_td ltx_align_right ltx_th ltx_th_column ltx_border_tt" style="padding-top:0.5pt;padding-bottom:0.5pt;"><span id="S3.T1.2.1.1.3.1" class="ltx_text ltx_font_bold">Syn</span></th>
<th id="S3.T1.2.1.1.4" class="ltx_td ltx_align_right ltx_th ltx_th_column ltx_border_tt" style="padding-top:0.5pt;padding-bottom:0.5pt;"><span id="S3.T1.2.1.1.4.1" class="ltx_text ltx_font_bold">Size</span></th></tr>
</thead>
<tbody class="ltx_tbody">
<tr id="S3.T1.2.1.2" class="ltx_tr">
<th id="S3.T1.2.1.2.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_t" style="padding-top:0.5pt;padding-bottom:0.5pt;">Llama-3.1-8B</th>
<td id="S3.T1.2.1.2.2" class="ltx_td ltx_align_right ltx_border_t" style="padding-top:0.5pt;padding-bottom:0.5pt;"><math id="S3.T1.m1" class="ltx_Math" alttext="\approx" display="inline" intent=":literal"><semantics><mo>≈</mo><annotation encoding="application/x-tex">\approx</annotation></semantics></math>5:3</td>
<td id="S3.T1.2.1.2.3" class="ltx_td ltx_align_right ltx_border_t" style="padding-top:0.5pt;padding-bottom:0.5pt;">10.3%</td>
<td id="S3.T1.2.1.2.4" class="ltx_td ltx_align_right ltx_border_t" style="padding-top:0.5pt;padding-bottom:0.5pt;">27,244</td></tr>
<tr id="S3.T1.2.1.3" class="ltx_tr">
<th id="S3.T1.2.1.3.1" class="ltx_td ltx_align_left ltx_th ltx_th_row" style="padding-top:0.5pt;padding-bottom:0.5pt;">Mistral-7B-v0.1</th>
<td id="S3.T1.2.1.3.2" class="ltx_td ltx_align_right" style="padding-top:0.5pt;padding-bottom:0.5pt;"><math id="S3.T1.m2" class="ltx_Math" alttext="\approx" display="inline" intent=":literal"><semantics><mo>≈</mo><annotation encoding="application/x-tex">\approx</annotation></semantics></math>3:2</td>
<td id="S3.T1.2.1.3.3" class="ltx_td ltx_align_right" style="padding-top:0.5pt;padding-bottom:0.5pt;">10.7%</td>
<td id="S3.T1.2.1.3.4" class="ltx_td ltx_align_right" style="padding-top:0.5pt;padding-bottom:0.5pt;">26,853</td></tr>
