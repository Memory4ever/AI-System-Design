<th id="S4.T4.2.1.1.3" class="ltx_td ltx_align_right ltx_th ltx_th_column ltx_border_tt" style="padding-top:1pt;padding-bottom:1pt;"><span id="S4.T4.2.1.1.3.1" class="ltx_text ltx_font_bold">WebQ</span></th></tr>
