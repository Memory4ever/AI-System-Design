<td id="S4.T7.5.1.2.2" class="ltx_td ltx_align_center ltx_border_r ltx_border_t"><span id="S4.T7.5.1.2.2.1" class="ltx_text ltx_font_bold">Filtered</span></td>
<td id="S4.T7.5.1.2.3" class="ltx_td ltx_align_center ltx_border_t"><span id="S4.T7.5.1.2.3.1" class="ltx_text ltx_font_bold">Full</span></td>
