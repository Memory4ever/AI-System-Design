<td id="S5.T2.2.1.18.5" class="ltx_td ltx_align_center" style="padding-left:5.0pt;padding-right:5.0pt;">87.8</td>
<td id="S5.T2.2.1.18.6" class="ltx_td ltx_align_center" style="padding-left:5.0pt;padding-right:5.0pt;">85.0</td></tr>
<tr id="S5.T2.2.1.19" class="ltx_tr">
<td id="S5.T2.2.1.19.1" class="ltx_td" style="padding-left:5.0pt;padding-right:5.0pt;"></td>
<td id="S5.T2.2.1.19.2" class="ltx_td ltx_align_left" style="padding-left:5.0pt;padding-right:5.0pt;">Claude-3 Haiku</td>
<td id="S5.T2.2.1.19.3" class="ltx_td ltx_align_center" style="padding-left:5.0pt;padding-right:5.0pt;">65.5</td>
<td id="S5.T2.2.1.19.4" class="ltx_td ltx_align_center" style="padding-left:5.0pt;padding-right:5.0pt;">28.9</td>
<td id="S5.T2.2.1.19.5" class="ltx_td ltx_align_center" style="padding-left:5.0pt;padding-right:5.0pt;">83.4</td>
<td id="S5.T2.2.1.19.6" class="ltx_td ltx_align_center" style="padding-left:5.0pt;padding-right:5.0pt;">70.0</td></tr>
<tr id="S5.T2.2.1.20" class="ltx_tr">
<td id="S5.T2.2.1.20.1" class="ltx_td" style="padding-left:5.0pt;padding-right:5.0pt;"></td>
<td id="S5.T2.2.1.20.2" class="ltx_td ltx_align_left" style="padding-left:5.0pt;padding-right:5.0pt;">Claude-3.5 Sonnet</td>
<td id="S5.T2.2.1.20.3" class="ltx_td ltx_align_center" style="padding-left:5.0pt;padding-right:5.0pt;">95.4</td>
<td id="S5.T2.2.1.20.4" class="ltx_td ltx_align_center" style="padding-left:5.0pt;padding-right:5.0pt;">42.0</td>
<td id="S5.T2.2.1.20.5" class="ltx_td ltx_align_center" style="padding-left:5.0pt;padding-right:5.0pt;">92.3</td>
<td id="S5.T2.2.1.20.6" class="ltx_td ltx_align_center" style="padding-left:5.0pt;padding-right:5.0pt;">83.5</td></tr>
<tr id="S5.T2.2.1.21" class="ltx_tr">
<td id="S5.T2.2.1.21.1" class="ltx_td ltx_border_t" style="padding-left:5.0pt;padding-right:5.0pt;"></td>
