<td id="S5.T2.2.1.21.4" class="ltx_td ltx_align_center ltx_border_t" style="padding-left:5.0pt;padding-right:5.0pt;">25.0</td>
<td id="S5.T2.2.1.21.5" class="ltx_td ltx_align_center ltx_border_t" style="padding-left:5.0pt;padding-right:5.0pt;">11.1</td>
<td id="S5.T2.2.1.21.6" class="ltx_td ltx_align_center ltx_border_t" style="padding-left:5.0pt;padding-right:5.0pt;">50.0</td></tr>
<tr id="S5.T2.2.1.22" class="ltx_tr">
<td id="S5.T2.2.1.22.1" class="ltx_td ltx_border_bb" style="padding-left:5.0pt;padding-right:5.0pt;"></td>
<td id="S5.T2.2.1.22.2" class="ltx_td ltx_align_left ltx_border_bb" style="padding-left:5.0pt;padding-right:5.0pt;">Human Estimate</td>
