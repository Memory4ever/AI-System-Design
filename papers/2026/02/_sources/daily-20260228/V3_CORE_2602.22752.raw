<th id="A4.T6.2.2.1" class="ltx_td ltx_align_left ltx_th ltx_th_column ltx_th_row" style="padding-left:2.4pt;padding-right:2.4pt;"><span id="A4.T6.2.2.1.1" class="ltx_text ltx_font_bold">Lang</span></th>
<th id="A4.T6.2.2.2" class="ltx_td ltx_align_left ltx_th ltx_th_column ltx_th_row" style="padding-left:2.4pt;padding-right:2.4pt;"><span id="A4.T6.2.2.2.1" class="ltx_text ltx_font_bold">Model</span></th>
<th id="A4.T6.2.2.3" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_t" style="padding-left:2.4pt;padding-right:2.4pt;"><span id="A4.T6.2.2.3.1" class="ltx_text ltx_font_bold">Base</span></th>
<th id="A4.T6.2.2.4" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_t" style="padding-left:2.4pt;padding-right:2.4pt;"><span id="A4.T6.2.2.4.1" class="ltx_text ltx_font_bold">FT</span></th>
