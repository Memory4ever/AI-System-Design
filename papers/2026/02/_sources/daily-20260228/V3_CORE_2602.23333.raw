<div id="A2.T5.2" class="ltx_inline-block ltx_align_center ltx_transformed_outer" style="width:345.0pt;height:29.2pt;vertical-align:-12.6pt;"><span class="ltx_transformed_inner" style="transform:translate(-47.4pt,4.0pt) scale(0.784384687757589,0.784384687757589) ;">
