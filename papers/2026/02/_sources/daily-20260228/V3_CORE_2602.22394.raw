<span id="S1.T1.3.1.1.1.1.1.1.2" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt"><span id="S1.T1.3.1.1.1.1.1.1.2.1" class="ltx_text ltx_font_bold">High Norm</span></span>
<span id="S1.T1.3.1.1.1.1.1.1.3" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt"><span id="S1.T1.3.1.1.1.1.1.1.3.1" class="ltx_text ltx_font_bold">Point-in-Box (PiB)</span></span></span>
</span>
