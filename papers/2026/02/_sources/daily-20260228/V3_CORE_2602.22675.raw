<td id="S6.T1.15.1.27.9" class="ltx_td ltx_align_center ltx_border_t" style="padding:1.05pt 3.5pt;"><span id="S6.T1.15.1.27.9.1" class="ltx_text" style="font-size:80%;--ltx-bg-color:#DCF5E1;">42.1</span></td>
<td id="S6.T1.15.1.27.10" class="ltx_td ltx_align_center ltx_border_t" style="padding:1.05pt 3.5pt;"><span id="S6.T1.15.1.27.10.1" class="ltx_text ltx_font_bold" style="font-size:80%;--ltx-bg-color:#DCF5E1;">45.6</span></td>
