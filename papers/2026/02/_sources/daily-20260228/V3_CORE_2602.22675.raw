<span id="A2.SS1.p6.pic1.2.2" class="ltx_p"><span id="A2.SS1.p6.pic1.2.2.1" class="ltx_text ltx_font_bold" style="--ltx-fg-color:#000000;">Input Fields:<span id="A2.SS1.p6.pic1.2.2.1.1" class="ltx_text"></span></span></span>
