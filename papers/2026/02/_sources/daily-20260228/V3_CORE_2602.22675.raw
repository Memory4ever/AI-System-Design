<span id="A2.I21.i2.p1.1" class="ltx_p"><span id="A2.I21.i2.p1.1.1" class="ltx_text" style="--ltx-fg-color:#000000;">Do not respond with a concept, category, or abstract description.</span></span>
</span></span>
<span id="A2.I21.i3" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<span id="A2.I21.i3.p1" class="ltx_para ltx_noindent">
<span id="A2.I21.i3.p1.1" class="ltx_p"><span id="A2.I21.i3.p1.1.1" class="ltx_text" style="--ltx-fg-color:#000000;">If the answer cannot be determined from the description, set </span><span id="A2.I21.i3.p1.1.2" class="ltx_text ltx_font_typewriter" style="--ltx-fg-color:#000000;">"answer"</span><span id="A2.I21.i3.p1.1.3" class="ltx_text" style="--ltx-fg-color:#000000;"> to </span><span id="A2.I21.i3.p1.1.4" class="ltx_text ltx_font_typewriter" style="--ltx-fg-color:#000000;">"Cannot determine"</span><span id="A2.I21.i3.p1.1.5" class="ltx_text" style="--ltx-fg-color:#000000;">.</span></span>
</span></span>
<span id="A2.I21.i4" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<span id="A2.I21.i4.p1" class="ltx_para">
<span id="A2.I21.i4.p1.1" class="ltx_p"><span id="A2.I21.i4.p1.1.1" class="ltx_text" style="--ltx-fg-color:#000000;">Output </span><em id="A2.I21.i4.p1.1.2" class="ltx_emph ltx_font_italic" style="--ltx-fg-color:#000000;">only</em><span id="A2.I21.i4.p1.1.3" class="ltx_text" style="--ltx-fg-color:#000000;"> the JSON object. Do not include any additional text.</span></span>
</span></span>
</span>
</span></span></span></foreignObject></g></g></svg></span>
</div>
<div id="A2.SS1.p6" class="ltx_para ltx_noindent"><span class="ltx_inline-block"><svg id="A2.SS1.p6.pic1" class="ltx_picture" height="567.51" overflow="visible" version="1.1" viewBox="0 0 653.15 567.51" width="653.15"><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" stroke-width="0.4pt" transform="translate(0,567.51) matrix(1 0 0 -1 0 0)"><g style="--ltx-fill-color:#606060;" fill="#606060" fill-opacity="1.0"><path style="stroke:none" d="M 0 5.91 L 0 561.61 C 0 564.87 2.64 567.51 5.91 567.51 L 647.24 567.51 C 650.51 567.51 653.15 564.87 653.15 561.61 L 653.15 5.91 C 653.15 2.64 650.51 0 647.24 0 L 5.91 0 C 2.64 0 0 2.64 0 5.91 Z"></path></g><g style="--ltx-fill-color:#F9F9F9;" fill="#F9F9F9" fill-opacity="1.0"><path style="stroke:none" d="M 1.97 5.91 L 1.97 543.4 L 651.18 543.4 L 651.18 5.91 C 651.18 3.73 649.42 1.97 647.24 1.97 L 5.91 1.97 C 3.73 1.97 1.97 3.73 1.97 5.91 Z"></path></g><g fill-opacity="1.0" transform="matrix(1.0 0.0 0.0 1.0 21.65 552)"><foreignObject style="--ltx-fo-width:38.32em;--ltx-fo-height:0.69em;--ltx-fo-depth:0.19em;font-size:10pt;" height="12.3" overflow="visible" transform="matrix(1 0 0 -1 0 9.61)" width="530.24"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content">
