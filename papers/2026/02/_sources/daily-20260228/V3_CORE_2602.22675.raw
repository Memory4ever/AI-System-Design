<td id="S6.T1.15.1.28.7" class="ltx_td ltx_align_center ltx_border_bb ltx_border_r" style="padding:1.05pt 3.5pt;"><span id="S6.T1.15.1.28.7.1" class="ltx_text ltx_font_bold" style="font-size:80%;--ltx-bg-color:#DCF5E1;">51.4</span></td>
<td id="S6.T1.15.1.28.8" class="ltx_td ltx_align_center ltx_border_bb" style="padding:1.05pt 3.5pt;"><span id="S6.T1.15.1.28.8.1" class="ltx_text" style="font-size:80%;--ltx-bg-color:#DCF5E1;">-</span></td>
<td id="S6.T1.15.1.28.9" class="ltx_td ltx_align_center ltx_border_bb" style="padding:1.05pt 3.5pt;"><span id="S6.T1.15.1.28.9.1" class="ltx_text" style="font-size:80%;--ltx-bg-color:#DCF5E1;">-</span></td>
<td id="S6.T1.15.1.28.10" class="ltx_td ltx_align_center ltx_border_bb" style="padding:1.05pt 3.5pt;"><span id="S6.T1.15.1.28.10.1" class="ltx_text" style="font-size:80%;--ltx-bg-color:#DCF5E1;">-</span></td>
<td id="S6.T1.15.1.28.11" class="ltx_td ltx_align_center ltx_border_bb" style="padding:1.05pt 3.5pt;"><span id="S6.T1.15.1.28.11.1" class="ltx_text" style="font-size:80%;--ltx-bg-color:#DCF5E1;">-</span></td>
