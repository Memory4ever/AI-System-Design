<td id="S6.T1.15.1.27.12" class="ltx_td ltx_align_center ltx_border_t" style="padding:1.05pt 3.5pt;"><span id="S6.T1.15.1.27.12.1" class="ltx_text ltx_font_bold" style="font-size:80%;--ltx-bg-color:#DCF5E1;">45.5</span></td></tr>
