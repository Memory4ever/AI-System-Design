<td id="S4.T9.5.1.3.2" class="ltx_td ltx_align_left ltx_border_t"><span id="S4.T9.5.1.3.2.1" class="ltx_text ltx_font_bold">88.31</span></td>
<td id="S4.T9.5.1.3.3" class="ltx_td ltx_align_left ltx_border_t"><span id="S4.T9.5.1.3.3.1" class="ltx_text ltx_font_bold">70.48</span></td></tr>
