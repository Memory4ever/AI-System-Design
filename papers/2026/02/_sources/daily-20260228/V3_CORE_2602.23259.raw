<td id="S4.T5.5.1.5.3" class="ltx_td ltx_align_left ltx_border_bb">46.82 <span id="S4.T5.5.1.5.3.1" class="ltx_text" style="font-size:50%;--ltx-fg-color:#FF0000;"> -23.66</span></td></tr>
</table>
</span></div>
</figure>
