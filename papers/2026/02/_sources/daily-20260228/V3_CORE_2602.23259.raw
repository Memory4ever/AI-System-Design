<td id="S4.T5.5.1.3.3" class="ltx_td ltx_align_left ltx_border_t"><span id="S4.T5.5.1.3.3.1" class="ltx_text ltx_font_bold">70.48</span></td></tr>
<tr id="S4.T5.5.1.4" class="ltx_tr">
<td id="S4.T5.5.1.4.1" class="ltx_td ltx_align_left"><math id="S4.T5.m3" class="ltx_Math" alttext="\epsilon" display="inline" intent=":literal"><semantics><mi>ϵ</mi><annotation encoding="application/x-tex">\epsilon</annotation></semantics></math>-Greedy Sampling</td>
<td id="S4.T5.5.1.4.2" class="ltx_td ltx_align_left">83.86 <span id="S4.T5.5.1.4.2.1" class="ltx_text" style="font-size:50%;--ltx-fg-color:#FF0000;"> -4.45</span></td>
<td id="S4.T5.5.1.4.3" class="ltx_td ltx_align_left">61.74 <span id="S4.T5.5.1.4.3.1" class="ltx_text" style="font-size:50%;--ltx-fg-color:#FF0000;"> -8.74</span></td></tr>
