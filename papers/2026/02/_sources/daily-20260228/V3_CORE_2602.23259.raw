<div id="S4.T5.5" class="ltx_inline-block ltx_align_center ltx_transformed_outer" style="width:345.0pt;height:83pt;vertical-align:-38.1pt;"><span class="ltx_transformed_inner" style="transform:translate(44.5pt,-10.7pt) scale(1.34797377540829,1.34797377540829) ;">
