<td id="S4.T9.5.1.1.2" class="ltx_td ltx_align_center ltx_border_tt" colspan="2"><span id="S4.T9.5.1.1.2.1" class="ltx_text ltx_font_bold">Metrics</span></td></tr>
<tr id="S4.T9.5.1.2" class="ltx_tr">
