<tr id="S4.T4.13.1.1" class="ltx_tr">
<td id="S4.T4.13.1.1.1" class="ltx_td ltx_align_left ltx_border_tt"><span id="S4.T4.13.1.1.1.1" class="ltx_text ltx_font_bold ltx_font_smallcaps" style="font-size:90%;">Setting</span></td>
<td id="S4.T4.13.1.1.2" class="ltx_td ltx_align_center ltx_border_tt"><math id="S4.T4.m11" class="ltx_Math" alttext="K{=}1" display="inline" intent=":literal"><semantics><mrow><mi mathsize="0.900em">K</mi><mo mathsize="0.900em">=</mo><mn mathsize="0.900em">1</mn></mrow><annotation encoding="application/x-tex">K{=}1</annotation></semantics></math></td>
