<td id="S3.T1.5.1.4.2" class="ltx_td ltx_align_center"><span id="S3.T1.5.1.4.2.1" class="ltx_text" style="font-size:90%;">1.6</span></td>
<td id="S3.T1.5.1.4.3" class="ltx_td ltx_align_center"><span id="S3.T1.5.1.4.3.1" class="ltx_text" style="font-size:90%;">57.7</span></td>
<td id="S3.T1.5.1.4.4" class="ltx_td ltx_align_center"><span id="S3.T1.5.1.4.4.1" class="ltx_text" style="font-size:90%;">27.0</span></td>
<td id="S3.T1.5.1.4.5" class="ltx_td ltx_align_center"><span id="S3.T1.5.1.4.5.1" class="ltx_text" style="font-size:90%;">1.6</span></td>
<td id="S3.T1.5.1.4.6" class="ltx_td ltx_align_center"><span id="S3.T1.5.1.4.6.1" class="ltx_text" style="font-size:90%;">60.3</span></td>
