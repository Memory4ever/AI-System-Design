<td id="S3.T1.5.1.2.8" class="ltx_td ltx_align_center ltx_border_t"><span id="S3.T1.5.1.2.8.1" class="ltx_text" style="font-size:90%;">89.4</span></td>
<td id="S3.T1.5.1.2.9" class="ltx_td ltx_align_right ltx_border_t"><span id="S3.T1.5.1.2.9.1" class="ltx_text" style="font-size:90%;">39.8</span></td></tr>
<tr id="S3.T1.5.1.3" class="ltx_tr">
<td id="S3.T1.5.1.3.1" class="ltx_td ltx_align_left"><span id="S3.T1.5.1.3.1.1" class="ltx_text" style="font-size:90%;">ACT </span><cite class="ltx_cite ltx_citemacro_citep"><span id="S3.T1.5.1.3.1.2" class="ltx_text" style="font-size:90%;">(</span><a href="#bib.bib6" title="" class="ltx_ref">Zhao et al., 2023</a><span id="S3.T1.5.1.3.1.4" class="ltx_text" style="font-size:90%;">)</span></cite></td>
