<td id="S4.T3.5.6.4" class="ltx_td ltx_align_center ltx_border_bb"><math id="S4.T3.m3" class="ltx_Math" alttext="\bm{40.5}" display="inline" intent=":literal"><semantics><mn class="ltx_mathvariant_bold" mathsize="0.900em" mathvariant="bold">40.5</mn><annotation encoding="application/x-tex">\bm{40.5}</annotation></semantics></math></td></tr>
