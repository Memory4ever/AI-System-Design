<td id="S3.T1.5.1.3.5" class="ltx_td ltx_align_center"><span id="S3.T1.5.1.3.5.1" class="ltx_text" style="font-size:90%;">9.0</span></td>
<td id="S3.T1.5.1.3.6" class="ltx_td ltx_align_center"><span id="S3.T1.5.1.3.6.1" class="ltx_text" style="font-size:90%;">21.7</span></td>
<td id="S3.T1.5.1.3.7" class="ltx_td ltx_align_center"><span id="S3.T1.5.1.3.7.1" class="ltx_text" style="font-size:90%;">48.1</span></td>
<td id="S3.T1.5.1.3.8" class="ltx_td ltx_align_center"><span id="S3.T1.5.1.3.8.1" class="ltx_text" style="font-size:90%;">91.5</span></td>
<td id="S3.T1.5.1.3.9" class="ltx_td ltx_align_right"><span id="S3.T1.5.1.3.9.1" class="ltx_text" style="font-size:90%;">38.2</span></td></tr>
<tr id="S3.T1.5.1.4" class="ltx_tr">
