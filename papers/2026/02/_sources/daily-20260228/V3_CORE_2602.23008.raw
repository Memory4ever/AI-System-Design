<span id="S6.T1.6.21.4.1.1" class="ltx_p ltx_align_center">17.1</span>
</span></td>
<td id="S6.T1.6.21.5" class="ltx_td ltx_align_left ltx_align_top ltx_border_b ltx_border_tt" style="padding-top:1.25pt;padding-bottom:1.25pt;">
