            <span class="ltx_tag ltx_tag_listingline">2:</span>
            
            
           <span id="alg1.l2.2" class="ltx_text ltx_font_bold">for</span> each training iteration <span id="alg1.l2.3" class="ltx_text ltx_font_bold">do</span>



</div>
<div id="alg1.l3" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline">3:</span>
            
            
            <span id="alg1.l3.2" class="ltx_text ltx_font_bold" style="--ltx-fg-color:#333EBA;">{// Multi-step rollout}</span>

</div>
