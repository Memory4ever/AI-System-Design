<span id="S6.T1.6.21.7.1" class="ltx_inline-block ltx_align_top" style="width:39.8pt;">
<span id="S6.T1.6.21.7.1.1" class="ltx_p ltx_align_center"><span id="S6.T1.6.21.7.1.1.1" class="ltx_text ltx_font_bold" style="--ltx-bg-color:#F0F1FF;">75.9</span></span>
