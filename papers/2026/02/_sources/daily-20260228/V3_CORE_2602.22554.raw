<td id="S5.T3.8.1.2" class="ltx_td ltx_align_center ltx_border_tt" colspan="3"><span id="S5.T3.8.1.2.1" class="ltx_text ltx_font_typewriter">Llama-3.2-1B</span></td></tr>
