<td id="S5.T2.8.1.3" class="ltx_td ltx_align_center ltx_border_tt">MGSM<math id="S5.T2.m2" class="ltx_Math" alttext="\uparrow" display="inline" intent=":literal"><semantics><mo stretchy="false">↑</mo><annotation encoding="application/x-tex">\uparrow</annotation></semantics></math></td>
<td id="S5.T2.8.1.4" class="ltx_td ltx_align_center ltx_border_tt">M-MMLU<math id="S5.T2.m3" class="ltx_Math" alttext="\uparrow" display="inline" intent=":literal"><semantics><mo stretchy="false">↑</mo><annotation encoding="application/x-tex">\uparrow</annotation></semantics></math></td></tr>
<tr id="S5.T2.8.2" class="ltx_tr">
