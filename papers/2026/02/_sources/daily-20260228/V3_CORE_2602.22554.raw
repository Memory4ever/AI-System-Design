<td id="S5.T1.12.1.31.2" class="ltx_td ltx_align_center ltx_border_bb"><span id="S5.T1.12.1.31.2.1" class="ltx_text ltx_font_smallcaps" style="font-size:90%;">0/313</span><sup id="S5.T1.12.1.31.2.2" class="ltx_sup"><span id="S5.T1.12.1.31.2.2.1" class="ltx_text ltx_font_smallcaps" style="font-size:90%;--ltx-fg-color:#008000;">-16</span></sup></td>
<td id="S5.T1.12.1.31.3" class="ltx_td ltx_align_center ltx_border_bb"><span id="S5.T1.12.1.31.3.1" class="ltx_text ltx_font_smallcaps" style="font-size:90%;">0/313</span><sup id="S5.T1.12.1.31.3.2" class="ltx_sup"><span id="S5.T1.12.1.31.3.2.1" class="ltx_text ltx_font_smallcaps" style="font-size:90%;--ltx-fg-color:#008000;">-12</span></sup></td>
<td id="S5.T1.12.1.31.4" class="ltx_td ltx_align_center ltx_border_bb"><span id="S5.T1.12.1.31.4.1" class="ltx_text ltx_font_smallcaps" style="font-size:90%;">1/313</span><sup id="S5.T1.12.1.31.4.2" class="ltx_sup"><span id="S5.T1.12.1.31.4.2.1" class="ltx_text ltx_font_smallcaps" style="font-size:90%;--ltx-fg-color:#008000;">-20</span></sup></td>
<td id="S5.T1.12.1.31.5" class="ltx_td ltx_align_center ltx_border_bb"><span id="S5.T1.12.1.31.5.1" class="ltx_text ltx_font_smallcaps" style="font-size:90%;">2/313</span><sup id="S5.T1.12.1.31.5.2" class="ltx_sup"><span id="S5.T1.12.1.31.5.2.1" class="ltx_text ltx_font_smallcaps" style="font-size:90%;--ltx-fg-color:#008000;">-37</span></sup></td>
<td id="S5.T1.12.1.31.6" class="ltx_td ltx_align_center ltx_border_bb"><span id="S5.T1.12.1.31.6.1" class="ltx_text ltx_font_smallcaps" style="font-size:90%;">11/313</span><sup id="S5.T1.12.1.31.6.2" class="ltx_sup"><span id="S5.T1.12.1.31.6.2.1" class="ltx_text ltx_font_smallcaps" style="font-size:90%;--ltx-fg-color:#008000;">-87</span></sup></td>
<td id="S5.T1.12.1.31.7" class="ltx_td ltx_align_center ltx_border_bb"><span id="S5.T1.12.1.31.7.1" class="ltx_text ltx_font_smallcaps" style="font-size:90%;">11/313</span><sup id="S5.T1.12.1.31.7.2" class="ltx_sup"><span id="S5.T1.12.1.31.7.2.1" class="ltx_text ltx_font_smallcaps" style="font-size:90%;--ltx-fg-color:#008000;">-37</span></sup></td>
