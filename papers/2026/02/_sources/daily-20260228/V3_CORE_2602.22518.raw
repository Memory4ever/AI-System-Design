<th id="S3.T4.8.2.2" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_t" style="padding-left:4.0pt;padding-right:4.0pt;">hello-world-api</th>
<td id="S3.T4.8.2.3" class="ltx_td ltx_align_right ltx_border_t" style="padding-left:4.0pt;padding-right:4.0pt;">100.0</td>
<td id="S3.T4.8.2.4" class="ltx_td ltx_align_right ltx_border_t" style="padding-left:4.0pt;padding-right:4.0pt;">100.0</td>
<td id="S3.T4.8.2.5" class="ltx_td ltx_align_right ltx_border_t" style="padding-left:4.0pt;padding-right:4.0pt;">100.0</td>
<td id="S3.T4.8.2.6" class="ltx_td ltx_align_right ltx_border_t" style="padding-left:4.0pt;padding-right:4.0pt;">100.0</td></tr>
<tr id="S3.T4.8.3" class="ltx_tr">
