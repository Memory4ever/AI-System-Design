<td id="A1.T6.2.8.4" class="ltx_td ltx_align_right">100.0</td>
<td id="A1.T6.2.8.5" class="ltx_td ltx_align_right">+0.3</td></tr>
<tr id="A1.T6.2.9" class="ltx_tr">
<th id="A1.T6.2.9.1" class="ltx_td ltx_align_left ltx_th ltx_th_row">gitleaks</th>
