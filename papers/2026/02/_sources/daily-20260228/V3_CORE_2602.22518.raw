<td id="S2.T1.2.6.2" class="ltx_td ltx_align_left" style="padding-left:2.5pt;padding-right:2.5pt;"><span id="S2.T1.2.6.2.1" class="ltx_text" style="font-size:90%;">Go</span></td>
