<td id="S2.T1.2.6.4" class="ltx_td ltx_align_right" style="padding-left:2.5pt;padding-right:2.5pt;"><span id="S2.T1.2.6.4.1" class="ltx_text" style="font-size:90%;">13.9K</span></td>
<td id="S2.T1.2.6.5" class="ltx_td ltx_align_right" style="padding-left:2.5pt;padding-right:2.5pt;"><span id="S2.T1.2.6.5.1" class="ltx_text" style="font-size:90%;">647</span></td>
<td id="S2.T1.2.6.6" class="ltx_td ltx_align_left" style="padding-left:2.5pt;padding-right:2.5pt;"><span id="S2.T1.2.6.6.1" class="ltx_text" style="font-size:90%;">TOML parser</span></td></tr>
<tr id="S2.T1.2.7" class="ltx_tr">
<td id="S2.T1.2.7.1" class="ltx_td ltx_align_left" style="padding-left:2.5pt;padding-right:2.5pt;"><span id="S2.T1.2.7.1.1" class="ltx_text" style="font-size:90%;">charcoal-cli</span></td>
