<td id="A1.T8.7.2.2" class="ltx_td ltx_nopad_r ltx_align_left ltx_align_top ltx_border_t" style="padding-top:0.7pt;padding-bottom:0.7pt;">
<span id="A1.T8.7.2.2.1" class="ltx_inline-block ltx_align_top" style="width:255.3pt;">
