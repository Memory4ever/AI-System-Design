<th id="S5.T1.26.1.2" class="ltx_td ltx_align_left ltx_th ltx_th_column ltx_border_tt" style="padding:0.25pt 3.0pt;"><span id="S5.T1.26.1.2.1" class="ltx_text ltx_font_bold" style="font-size:90%;">Method</span></th>
<th id="S5.T1.26.1.3" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt" style="padding:0.25pt 3.0pt;"><span id="S5.T1.26.1.3.1" class="ltx_text ltx_font_bold" style="font-size:90%;">HR<math id="S5.T1.m19" class="ltx_Math" alttext="\downarrow" display="inline" intent=":literal"><semantics><mo stretchy="false">↓</mo><annotation encoding="application/x-tex">\downarrow</annotation></semantics></math></span></th>
<th id="S5.T1.26.1.4" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt" style="padding:0.25pt 3.0pt;"><span id="S5.T1.26.1.4.1" class="ltx_text ltx_font_bold" style="font-size:90%;">Acc<math id="S5.T1.m20" class="ltx_Math" alttext="\uparrow" display="inline" intent=":literal"><semantics><mo stretchy="false">↑</mo><annotation encoding="application/x-tex">\uparrow</annotation></semantics></math></span></th>
<th id="S5.T1.26.1.5" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt" style="padding:0.25pt 3.0pt;"><span id="S5.T1.26.1.5.1" class="ltx_text ltx_font_bold" style="font-size:90%;">CIDEr<math id="S5.T1.m21" class="ltx_Math" alttext="\uparrow" display="inline" intent=":literal"><semantics><mo stretchy="false">↑</mo><annotation encoding="application/x-tex">\uparrow</annotation></semantics></math></span></th>
<th id="S5.T1.26.1.6" class="ltx_td ltx_nopad_r ltx_align_center ltx_th ltx_th_column ltx_border_tt" style="padding:0.25pt 3.0pt;"><math id="S5.T1.m22" class="ltx_Math" alttext="\Delta" display="inline" intent=":literal"><semantics><mi mathsize="0.900em" mathvariant="normal">Δ</mi><annotation encoding="application/x-tex">\Delta</annotation></semantics></math><span id="S5.T1.26.1.6.1" class="ltx_text ltx_font_bold" style="font-size:90%;">HR<math id="S5.T1.m23" class="ltx_Math" alttext="\downarrow" display="inline" intent=":literal"><semantics><mo stretchy="false">↓</mo><annotation encoding="application/x-tex">\downarrow</annotation></semantics></math></span></th></tr>
</thead>
<tbody class="ltx_tbody">
<tr id="S5.T1.26.2" class="ltx_tr">
<td id="S5.T1.26.2.1" class="ltx_td ltx_align_left ltx_border_t" style="padding:0.25pt 3.0pt;" rowspan="9"><span id="S5.T1.26.2.1.1" class="ltx_text" style="font-size:90%;">Cham-7B</span></td>
<td id="S5.T1.26.2.2" class="ltx_td ltx_align_left ltx_border_t" style="padding:0.25pt 3.0pt;"><span id="S5.T1.26.2.2.1" class="ltx_text" style="font-size:90%;">Vanilla</span></td>
<td id="S5.T1.26.2.3" class="ltx_td ltx_align_center ltx_border_t" style="padding:0.25pt 3.0pt;"><span id="S5.T1.26.2.3.1" class="ltx_text" style="font-size:90%;">19.5<math id="S5.T1.m24" class="ltx_Math" alttext="\pm" display="inline" intent=":literal"><semantics><mo>±</mo><annotation encoding="application/x-tex">\pm</annotation></semantics></math>.8</span></td>
<td id="S5.T1.26.2.4" class="ltx_td ltx_align_center ltx_border_t" style="padding:0.25pt 3.0pt;"><span id="S5.T1.26.2.4.1" class="ltx_text" style="font-size:90%;">80.2<math id="S5.T1.m25" class="ltx_Math" alttext="\pm" display="inline" intent=":literal"><semantics><mo>±</mo><annotation encoding="application/x-tex">\pm</annotation></semantics></math>.7</span></td>
<td id="S5.T1.26.2.5" class="ltx_td ltx_align_center ltx_border_t" style="padding:0.25pt 3.0pt;"><span id="S5.T1.26.2.5.1" class="ltx_text" style="font-size:90%;">102.3<math id="S5.T1.m26" class="ltx_Math" alttext="\pm" display="inline" intent=":literal"><semantics><mo>±</mo><annotation encoding="application/x-tex">\pm</annotation></semantics></math>1.4</span></td>
<td id="S5.T1.26.2.6" class="ltx_td ltx_nopad_r ltx_align_center ltx_border_t" style="padding:0.25pt 3.0pt;"><span id="S5.T1.26.2.6.1" class="ltx_text" style="font-size:90%;">-</span></td></tr>
<tr id="S5.T1.26.3" class="ltx_tr">
<td id="S5.T1.26.3.1" class="ltx_td ltx_align_left" style="padding:0.25pt 3.0pt;"><span id="S5.T1.26.3.1.1" class="ltx_text" style="font-size:90%;">OPERA</span></td>
<td id="S5.T1.26.3.2" class="ltx_td ltx_align_center" style="padding:0.25pt 3.0pt;"><span id="S5.T1.26.3.2.1" class="ltx_text" style="font-size:90%;">16.4<math id="S5.T1.m27" class="ltx_Math" alttext="\pm" display="inline" intent=":literal"><semantics><mo>±</mo><annotation encoding="application/x-tex">\pm</annotation></semantics></math>1.1</span></td>
<td id="S5.T1.26.3.3" class="ltx_td ltx_align_center" style="padding:0.25pt 3.0pt;"><span id="S5.T1.26.3.3.1" class="ltx_text" style="font-size:90%;">83.1<math id="S5.T1.m28" class="ltx_Math" alttext="\pm" display="inline" intent=":literal"><semantics><mo>±</mo><annotation encoding="application/x-tex">\pm</annotation></semantics></math>.8</span></td>
<td id="S5.T1.26.3.4" class="ltx_td ltx_align_center" style="padding:0.25pt 3.0pt;"><span id="S5.T1.26.3.4.1" class="ltx_text" style="font-size:90%;">100.1<math id="S5.T1.m29" class="ltx_Math" alttext="\pm" display="inline" intent=":literal"><semantics><mo>±</mo><annotation encoding="application/x-tex">\pm</annotation></semantics></math>1.5</span></td>
<td id="S5.T1.26.3.5" class="ltx_td ltx_nopad_r ltx_align_center" style="padding:0.25pt 3.0pt;"><math id="S5.T1.m30" class="ltx_Math" alttext="-" display="inline" intent=":literal"><semantics><mo mathsize="0.900em">−</mo><annotation encoding="application/x-tex">-</annotation></semantics></math><span id="S5.T1.26.3.5.1" class="ltx_text" style="font-size:90%;">3.1</span></td></tr>
<tr id="S5.T1.26.4" class="ltx_tr">
