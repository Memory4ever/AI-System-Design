<td id="S5.T1.26.4.2" class="ltx_td ltx_align_center" style="padding:0.25pt 3.0pt;"><span id="S5.T1.26.4.2.1" class="ltx_text" style="font-size:90%;">15.3<math id="S5.T1.m31" class="ltx_Math" alttext="\pm" display="inline" intent=":literal"><semantics><mo>±</mo><annotation encoding="application/x-tex">\pm</annotation></semantics></math>1.2</span></td>
