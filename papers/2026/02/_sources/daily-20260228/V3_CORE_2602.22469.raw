<td id="S5.T1.26.37.5" class="ltx_td ltx_nopad_r ltx_align_center ltx_border_bb" style="padding:0.25pt 3.0pt;"><math id="S5.T1.m163" class="ltx_Math" alttext="\mathbf{-5.6}" display="inline" intent=":literal"><semantics><mrow><mo mathsize="0.900em">−</mo><mn class="ltx_mathvariant_bold" mathsize="0.900em" mathvariant="bold">5.6</mn></mrow><annotation encoding="application/x-tex">\mathbf{-5.6}</annotation></semantics></math></td></tr>
