<td id="S4.T7.2.5.4" class="ltx_td ltx_align_center" style="padding-top:0.75pt;padding-bottom:0.75pt;">10.00%</td></tr>
<tr id="S4.T7.2.6" class="ltx_tr" style="--ltx-bg-color:#ECECEC;">
<th id="S4.T7.2.6.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_bb ltx_border_t" style="padding-top:0.75pt;padding-bottom:0.75pt;"><span id="S4.T7.2.6.1.1" class="ltx_text ltx_font_bold" style="--ltx-bg-color:#ECECEC;">Average <math id="S4.T7.m2" class="ltx_Math" alttext="\Delta" display="inline" intent=":literal"><semantics><mi style="--ltx-bg-color:#ECECEC;" mathbackground="#ECECEC">𝚫</mi><annotation encoding="application/x-tex">\Delta</annotation></semantics></math></span></th>
<td id="S4.T7.2.6.2" class="ltx_td ltx_align_center ltx_border_bb ltx_border_t" style="padding-top:0.75pt;padding-bottom:0.75pt;"><span id="S4.T7.2.6.2.1" class="ltx_text" style="--ltx-bg-color:#ECECEC;">–</span></td>
<td id="S4.T7.2.6.3" class="ltx_td ltx_align_center ltx_border_bb ltx_border_t" style="padding-top:0.75pt;padding-bottom:0.75pt;"><span id="S4.T7.2.6.3.1" class="ltx_text ltx_font_bold" style="--ltx-bg-color:#ECECEC;">+9.35%</span></td>
<td id="S4.T7.2.6.4" class="ltx_td ltx_align_center ltx_border_bb ltx_border_t" style="padding-top:0.75pt;padding-bottom:0.75pt;"><span id="S4.T7.2.6.4.1" class="ltx_text ltx_font_bold" style="--ltx-bg-color:#ECECEC;">10.63%</span></td></tr>
</tbody>
</table>
<figcaption class="ltx_caption ltx_centering"><span class="ltx_tag ltx_tag_table">Table 7: </span>Evaluation under a fixed threshold (<math id="S4.T7.m4" class="ltx_Math" alttext="\tau=0.96" display="inline" intent=":literal"><semantics><mrow><mi>𝝉</mi><mo class="ltx_mathvariant_bold" mathvariant="bold">=</mo><mn class="ltx_mathvariant_bold" mathvariant="bold">0.96</mn></mrow><annotation encoding="application/x-tex">\tau=0.96</annotation></semantics></math>)</figcaption>
