<td id="S4.T3.2.8.2" class="ltx_td ltx_align_center" style="padding-top:0.25pt;padding-bottom:0.25pt;"><span id="S4.T3.2.8.2.1" class="ltx_text ltx_font_bold">86.38</span></td>
