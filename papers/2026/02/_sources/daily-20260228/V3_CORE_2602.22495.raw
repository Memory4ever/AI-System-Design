<span id="S4.T1.3.1.1.1.1.1.1.6.4" class="ltx_td ltx_align_center" style="padding:0.5pt 4.0pt;"><span id="S4.T1.3.1.1.1.1.1.1.6.4.1" class="ltx_text ltx_font_bold">1</span></span>
