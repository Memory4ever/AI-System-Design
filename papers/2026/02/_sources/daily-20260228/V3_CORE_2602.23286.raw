<td id="S4.T3.2.1.3.1" class="ltx_td ltx_align_left ltx_border_r ltx_border_t"><em id="S4.T3.2.1.3.1.1" class="ltx_emph ltx_font_italic">One-Shot</em></td>
<td id="S4.T3.2.1.3.2" class="ltx_td ltx_align_center ltx_border_t">500</td>
<td id="S4.T3.2.1.3.3" class="ltx_td ltx_align_center ltx_border_t">60</td>
<td id="S4.T3.2.1.3.4" class="ltx_td ltx_align_center ltx_border_t">1265</td>
