<span id="A13.T16.4.60.2.1.1" class="ltx_p"><span id="A13.T16.4.60.2.1.1.1" class="ltx_text ltx_font_typewriter">SELECT player_name FROM nba_player_game_stats WHERE player_name IN (SELECT player_name FROM nba_player_information WHERE height &gt; (SELECT AVG(height) FROM nba_player_information WHERE position = ’Point Guard’ AND draft_year &gt; 1990) AND position = ’Center’) AND number_of_rebound &gt; 8</span></span>
