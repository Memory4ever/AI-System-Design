<td id="S1.T1.2.1.9.1" class="ltx_td ltx_align_left ltx_border_r"><span id="S1.T1.2.1.9.1.1" class="ltx_text ltx_font_bold">SPARTA (Movie)</span></td>
<td id="S1.T1.2.1.9.2" class="ltx_td ltx_align_center"><span id="S1.T1.2.1.9.2.1" class="ltx_text ltx_font_bold">4.7</span></td>
<td id="S1.T1.2.1.9.3" class="ltx_td ltx_align_center ltx_border_r"><span id="S1.T1.2.1.9.3.1" class="ltx_text ltx_font_bold">10,054.0</span></td></tr>
