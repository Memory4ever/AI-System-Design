<span id="A13.T16.4.48.2.1" class="ltx_inline-block ltx_align_top" style="width:337.9pt;">
<span id="A13.T16.4.48.2.1.1" class="ltx_p"><span id="A13.T16.4.48.2.1.1.1" class="ltx_text ltx_font_typewriter">SELECT title FROM movie WHERE title IN (SELECT movie_title FROM role_mapping WHERE category = ’actor’ AND name = ’Vincent D Onofrio’ AND movie_title = title) AND title IN (SELECT movie_title FROM ratings WHERE avg_rating &gt; 5 AND median_rating = 6 AND movie_title &lt;&gt; ’Kolonya Cumhuriyeti’)</span></span>
</span></td></tr>
