<article class="ltx_document ltx_authors_1line">
<h1 class="ltx_title ltx_title_document">Search-P1: Path-Centric Reward Shaping for Stable and Efficient Agentic RAG Training</h1>
<div class="ltx_authors">
<span class="ltx_creator ltx_role_author">
<span class="ltx_personname">Tianle Xia<sup id="id1" class="ltx_sup">*</sup>
</span></span>
<span class="ltx_author_before">  </span><span class="ltx_creator ltx_role_author">
<span class="ltx_personname">Ming Xu
</span></span>
<span class="ltx_author_before">  </span><span class="ltx_creator ltx_role_author">
<span class="ltx_personname">Lingxiang Hu
</span></span>
<span class="ltx_author_before">  </span><span class="ltx_creator ltx_role_author">
<span class="ltx_personname">Yiding Sun
</span></span>
<span class="ltx_author_before">  </span><span class="ltx_creator ltx_role_author">
<span class="ltx_personname">Wenwei Li
</span></span>
<span class="ltx_author_before">  </span><span class="ltx_creator ltx_role_author">
<span class="ltx_personname">Linfang Shang
</span><span class="ltx_author_notes"><span class="ltx_author_notes_content">
<span class="ltx_contact ltx_role_affiliation"><span class="ltx_contact_name">Affiliation: </span><span id="id2" class="ltx_text ltx_font_bold">Liqun Liu<sup id="id2.1" class="ltx_sup"><span id="id2.1.1" class="ltx_text ltx_font_medium">†</span></sup></span>, <span id="id3" class="ltx_text ltx_font_bold">Peng Shu</span>, <span id="id4" class="ltx_text ltx_font_bold">Huan Yu</span>, <span id="id5" class="ltx_text ltx_font_bold">Jie Jiang</span>
</span>
<span class="ltx_contact ltx_role_affiliation"><span class="ltx_contact_name">Affiliation: </span>Tencent
</span>
