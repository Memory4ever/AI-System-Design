<td id="A6.T12.2.3.10" class="ltx_td ltx_align_center ltx_border_t"><span id="A6.T12.2.3.10.1" class="ltx_text ltx_font_bold">86.2</span></td></tr>
<tr id="A6.T12.2.4" class="ltx_tr">
