<td id="S5.T2.14.3.12" class="ltx_td ltx_nopad_l ltx_nopad_r ltx_align_center ltx_border_r ltx_border_t" style="padding-left:1.8pt;padding-right:1.8pt;"><span id="S5.T2.14.3.12.1" class="ltx_text ltx_font_bold" style="--ltx-fg-color:#FF0000;">4.96</span></td>
<td id="S5.T2.14.3.13" class="ltx_td ltx_nopad_l ltx_nopad_r ltx_align_center ltx_border_t" style="padding-left:1.8pt;padding-right:1.8pt;">85.78</td>
<td id="S5.T2.14.3.14" class="ltx_td ltx_nopad_l ltx_nopad_r ltx_align_center ltx_border_r ltx_border_t" style="padding-left:1.8pt;padding-right:1.8pt;">5.64</td>
<td id="S5.T2.14.3.15" class="ltx_td ltx_nopad_l ltx_nopad_r ltx_align_center ltx_border_t" style="padding-left:1.8pt;padding-right:1.8pt;"><span id="S5.T2.14.3.15.1" class="ltx_text ltx_font_bold" style="--ltx-fg-color:#FF0000;">86.57</span></td>
