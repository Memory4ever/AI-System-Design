<td id="S5.T2.14.2.16" class="ltx_td ltx_nopad_l ltx_nopad_r ltx_align_center" style="padding-left:1.8pt;padding-right:1.8pt;">PCR</td></tr>
<tr id="S5.T2.14.3" class="ltx_tr">
<td id="S5.T2.14.3.1" class="ltx_td ltx_nopad_l ltx_nopad_r ltx_align_center ltx_border_t" style="padding-left:1.8pt;padding-right:1.8pt;">✗</td>
<td id="S5.T2.14.3.2" class="ltx_td ltx_nopad_l ltx_nopad_r ltx_align_center ltx_border_t" style="padding-left:1.8pt;padding-right:1.8pt;">✗</td>
