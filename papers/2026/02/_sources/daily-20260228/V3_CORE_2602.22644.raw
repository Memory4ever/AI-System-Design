<tr id="S1.T1.8.10" class="ltx_tr">
<td id="S1.T1.8.10.1" class="ltx_td ltx_align_center ltx_border_b ltx_border_r ltx_border_t" style="padding-left:4.6pt;padding-right:4.6pt;" colspan="3"><span id="S1.T1.8.10.1.1" class="ltx_text ltx_font_bold">Average</span></td>
<td id="S1.T1.8.10.2" class="ltx_td ltx_align_center ltx_border_b ltx_border_t" style="padding-left:4.6pt;padding-right:4.6pt;">92.94 (-2.50)</td>
