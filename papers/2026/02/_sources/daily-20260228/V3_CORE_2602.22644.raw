<td id="A1.T6.8.3.4" class="ltx_td ltx_align_center ltx_border_t">71.69</td>
<td id="A1.T6.8.3.5" class="ltx_td ltx_align_center ltx_border_r ltx_border_t"><span id="A1.T6.8.3.5.1" class="ltx_text"></span> <span id="A1.T6.8.3.5.2" class="ltx_text">
<span id="A1.T6.8.3.5.2.1" class="ltx_tabular ltx_align_middle">
<span id="A1.T6.8.3.5.2.1.1" class="ltx_tr">
<span id="A1.T6.8.3.5.2.1.1.1" class="ltx_td ltx_nopad_r ltx_align_center">71.69</span></span>
<span id="A1.T6.8.3.5.2.1.2" class="ltx_tr">
<span id="A1.T6.8.3.5.2.1.2.1" class="ltx_td ltx_nopad_r ltx_align_center">(+0)</span></span>
</span></span><span id="A1.T6.8.3.5.3" class="ltx_text"></span></td>
