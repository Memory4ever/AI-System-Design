<td id="S3.T3.6.1.25.11" class="ltx_td ltx_align_center">50.9419<sup id="S3.T3.6.1.25.11.1" class="ltx_sup"><span id="S3.T3.6.1.25.11.1.1" class="ltx_text ltx_font_italic">2</span></sup></td></tr>
