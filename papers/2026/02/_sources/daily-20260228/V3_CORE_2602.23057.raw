<td id="S5.T2.6.1.8.5" class="ltx_td ltx_align_right ltx_border_bb"><span id="S5.T2.6.1.8.5.1" class="ltx_text ltx_font_bold" style="font-size:90%;">63.4</span></td>
<td id="S5.T2.6.1.8.6" class="ltx_td ltx_align_right ltx_border_bb"><span id="S5.T2.6.1.8.6.1" class="ltx_text" style="font-size:90%;">74.6</span></td>
