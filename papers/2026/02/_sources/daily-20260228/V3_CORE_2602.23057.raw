<td id="A2.T5.6.1.3" class="ltx_td ltx_align_center ltx_border_tt">#Spikes (<math id="A2.T5.m5" class="ltx_Math" alttext="k=6" display="inline" intent=":literal"><semantics><mrow><mi>k</mi><mo>=</mo><mn>6</mn></mrow><annotation encoding="application/x-tex">k=6</annotation></semantics></math>)</td>
<td id="A2.T5.6.1.4" class="ltx_td ltx_align_center ltx_border_tt">#Spikes (<math id="A2.T5.m6" class="ltx_Math" alttext="k=9" display="inline" intent=":literal"><semantics><mrow><mi>k</mi><mo>=</mo><mn>9</mn></mrow><annotation encoding="application/x-tex">k=9</annotation></semantics></math>)</td></tr>
