<td id="S3.T1.9.1.3.14" class="ltx_td ltx_align_center ltx_border_t" style="padding-left:3.0pt;padding-right:3.0pt;">RE ↓</td>
<td id="S3.T1.9.1.3.15" class="ltx_td ltx_align_center ltx_border_t" style="padding-left:3.0pt;padding-right:3.0pt;">TE ↓</td>
<td id="S3.T1.9.1.3.16" class="ltx_td ltx_align_center ltx_border_t" style="padding-left:3.0pt;padding-right:3.0pt;">PA ↑</td>
<td id="S3.T1.9.1.3.17" class="ltx_td ltx_align_center ltx_border_t" style="padding-left:3.0pt;padding-right:3.0pt;">CD ↓</td></tr>
<tr id="S3.T1.9.1.4" class="ltx_tr">
<th id="S3.T1.9.1.4.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_r ltx_border_t" style="padding-left:3.0pt;padding-right:3.0pt;">GARF <cite class="ltx_cite ltx_citemacro_citep">(<a href="#bib.bib7" title="" class="ltx_ref">Li et al., 2025a</a>)</cite></th>
<td id="S3.T1.9.1.4.2" class="ltx_td ltx_align_center ltx_border_t" style="padding-left:3.0pt;padding-right:3.0pt;">52.52</td>
<td id="S3.T1.9.1.4.3" class="ltx_td ltx_align_center ltx_border_t" style="padding-left:3.0pt;padding-right:3.0pt;">10.68</td>
<td id="S3.T1.9.1.4.4" class="ltx_td ltx_align_center ltx_border_t" style="padding-left:3.0pt;padding-right:3.0pt;">58.19</td>
<td id="S3.T1.9.1.4.5" class="ltx_td ltx_align_center ltx_border_r ltx_border_t" style="padding-left:3.0pt;padding-right:3.0pt;"><span id="S3.T1.9.1.4.5.1" class="ltx_text ltx_underline">3.10</span></td>
<td id="S3.T1.9.1.4.6" class="ltx_td ltx_align_center ltx_border_t" style="padding-left:3.0pt;padding-right:3.0pt;">49.40</td>
