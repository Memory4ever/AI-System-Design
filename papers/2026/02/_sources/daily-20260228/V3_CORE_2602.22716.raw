><mo stretchy="false">(</mo><mn>21</mn><mo stretchy="false">)</mo></mrow></msup></mtd></mtr><mtr><mtd><msup><mi>K</mi><mrow><mo stretchy="false">(</mo><mn>22</mn><mo stretchy="false">)</mo></mrow></msup></mtd></mtr><mtr><mtd><msup><mi>K</mi><mrow><mo stretchy="false">(</mo><mn>23</mn><mo stretchy="false">)</mo></mrow></msup></mtd></mtr><mtr><mtd><mi mathvariant="normal">⋮</mi></mtd></mtr><mtr><mtd><msup><mi>K</mi><mrow><mo stretchy="false">(</mo><mn>30</mn><mo stretchy="false">)</mo></mrow></msup></mtd></mtr><mtr><mtd><msup><mi>K</mi><mrow><mo stretchy="false">(</mo><mn>31</mn><mo stretchy="false">)</mo></mrow></msup></mtd></mtr></mtable><mo>)</mo></mrow></mrow></mtd></mtr><mtr><mtd class="ltx_align_right" columnalign="right"><mo>+</mo></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><msup><mrow><mo>(</mo><mtable rowspacing="0pt"><mtr><mtd><msup><mi>Q</mi><mrow><mo stretchy="false">(</mo><mn>32</mn><mo stretchy="false">)</mo></mrow></msup></mtd></mtr><mtr><mtd><msup><mi>Q</mi><mrow><mo stretchy="false">(</mo><mn>33</mn><mo stretchy="false">)</mo></mrow></msup></mtd></mtr><mtr><mtd><msup><mi>Q</mi><mrow><mo stretchy="false">(</mo><mn>34</mn><mo stretchy="false">)</mo></mrow></msup></mtd></mtr><mtr><mtd><msup><mi>Q</mi><mrow><mo stretchy="false">(</mo><mn>35</mn><mo stretchy="false">)</mo></mrow></msup></mtd></mtr><mtr><mtd><mi mathvariant="normal">⋮</mi></mtd></mtr><mtr><mtd><msup><mi>Q</mi><mrow><mo stretchy="false">(</mo><mn>126</mn><mo stretchy="false">)</mo></mrow></msup></mtd></mtr><mtr><mtd><msup><mi>Q</mi><mrow><mo stretchy="false">(</mo><mn>127</mn><mo stretchy="false">)</mo></mrow></msup></mtd></mtr></mtable><mo>)</mo></mrow><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mtable columnspacing="5pt" rowspacing="0pt"><mtr><mtd><mrow><mi>cos</mi><mi>θ</mi><msup><mrow></mrow><mo>′</mo></msup><msub><mrow></mrow><mn>16</mn></msub><mi mathvariant="normal">Δ</mi><mi>t</mi></mrow></mtd><mtd><mrow><mo>−</mo><mi>sin</mi><mi>θ</mi><msup><mrow></mrow><mo>′</mo></msup><msub><mrow></mrow><mn>16</mn></msub><mi mathvariant="normal">Δ</mi><mi>t</mi></mrow></mtd><mtd><mn>0</mn></mtd><mtd><mo>⋯</mo></mtd><mtd><mn>0</mn></mtd><mtd><mn>0</mn></mtd></mtr><mtr><mtd><mrow><mi>sin</mi><mi>θ</mi><msup><mrow></mrow><mo>′</mo></msup><msub><mrow></mrow><mn>16</mn></msub><mi mathvariant="normal">Δ</mi><mi>t</mi></mrow></mtd><mtd><mrow><mi>cos</mi><mi>θ</mi><msup><mrow></mrow><mo>′</mo></msup><msub><mrow></mrow><mn>16</mn></msub><mi mathvariant="normal">Δ</mi><mi>t</mi></mrow></mtd><mtd><mn>0</mn></mtd><mtd><mo>⋯</mo></mtd><mtd><mn>0</mn></mtd><mtd><mn>0</mn></mtd></mtr><mtr><mtd><mn>0</mn></mtd><mtd><mn>0</mn></mtd><mtd><mrow><mi>cos</mi><mi>θ</mi><msup><mrow></mrow><mo>′</mo></msup><msub><mrow></mrow><mn>17</mn></msub><mi mathvariant="normal">Δ</mi><mi>t</mi></mrow></mtd><mtd><mrow><mo>−</mo><mi>sin</mi><mi>θ</mi><msup><mrow></mrow><mo>′</mo></msup><msub><mrow></mrow><mn>17</mn></msub><mi mathvariant="normal">Δ</mi><mi>t</mi></mrow></mtd><mtd><mo>⋯</mo></mtd><mtd><mn>0</mn></mtd></mtr><mtr><mtd><mn>0</mn></mtd><mtd><mn>0</mn></mtd><mtd><mrow><mi>sin</mi><mi>θ</mi><msup><mrow></mrow><mo>′</mo></msup><msub><mrow></mrow><mn>17</mn></msub><mi mathvariant="normal">Δ</mi><mi>t</mi></mrow></mtd><mtd><mrow><mi>cos</mi><mi>θ</mi><msup><mrow></mrow><mo>′</mo></msup><msub><mrow></mrow><mn>17</mn></msub><mi mathvariant="normal">Δ</mi><mi>t</mi></mrow></mtd><mtd><mo>⋯</mo></mtd><mtd><mn>0</mn></mtd></mtr><mtr><mtd><mi mathvariant="normal">⋮</mi></mtd><mtd><mi mathvariant="normal">⋮</mi></mtd><mtd><mi mathvariant="normal">⋮</mi></mtd><mtd><mi mathvariant="normal">⋮</mi></mtd><mtd><mi mathvariant="normal">⋱</mi></mtd><mtd><mi mathvariant="normal">⋮</mi></mtd></mtr><mtr><mtd><mn>0</mn></mtd><mtd><mn>0</mn></mtd><mtd><mo>⋯</mo></mtd><mtd><mn>0</mn></mtd><mtd><mrow><mi>cos</mi><mi>θ</mi><msup><mrow></mrow><mo>′</mo></msup><msub><mrow></mrow><mn>63</mn></msub><mi mathvariant="normal">Δ</mi><mi>t</mi></mrow></mtd><mtd><mrow><mo>−</mo><m