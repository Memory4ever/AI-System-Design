<section id="S5.SS3" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">5.3 </span>Ablation Studies</h3>

<figure id="S5.T5" class="ltx_table">
<figcaption class="ltx_caption ltx_centering"><span class="ltx_tag ltx_tag_table"><span id="S5.T5.4" class="ltx_text" style="font-size:90%;">Table 5</span>: </span><span id="S5.T5.5" class="ltx_text ltx_font_bold" style="font-size:90%;">Ablation study for our proposed SpatialSoPE method<span id="S5.T5.5.1" class="ltx_text ltx_font_medium">. We validate our parameter choices by comparing against several variants on the ARKitScenes dataset.</span></span></figcaption>
<table id="S5.T5.6" class="ltx_tabular ltx_centering ltx_guessed_headers ltx_align_middle">
<thead class="ltx_thead">
<tr id="S5.T5.6.1" class="ltx_tr">
<th id="S5.T5.6.1.1" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt" style="padding-left:3.5pt;padding-right:3.5pt;" rowspan="2"><span id="S5.T5.6.1.1.1" class="ltx_text" style="font-size:80%;">Methods</span></th>
<th id="S5.T5.6.1.2" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt" style="padding-left:3.5pt;padding-right:3.5pt;" rowspan="2"><span id="S5.T5.6.1.2.1" class="ltx_text" style="font-size:80%;"><math id="S5.T5.m1" class="ltx_Math" alttext="t:r:\theta:\phi" display="inline" intent=":literal"><semantics><mrow><mi>t</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mi>r</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mi>θ</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mi>ϕ</mi></mrow><annotation encoding="application/x-tex">t:r:\theta:\phi</annotation></semantics></math></span></th>
<th id="S5.T5.6.1.3" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt" style="padding-left:3.5pt;padding-right:3.5pt;" colspan="2"><span id="S5.T5.6.1.3.1" class="ltx_text" style="font-size:80%;">F1 - ARKitScenes</span></th></tr>
<tr id="S5.T5.6.2" class="ltx_tr">
<th id="S5.T5.6.2.1" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_t" style="padding-left:3.5pt;padding-right:3.5pt;"><span id="S5.T5.6.2.1.1" class="ltx_text" style="font-size:80%;">IoU<sub id="S5.T5.6.2.1.1.1" class="ltx_sub"><span id="S5.T5.6.2.1.1.1.1" class="ltx_text ltx_font_italic">3D</span></sub> @0.25<math id="S5.T5.m3" class="ltx_Math" alttext="\uparrow" display="inline" intent=":literal"><semantics><mo stretchy="false">↑</mo><annotation encoding="application/x-tex">\uparrow</annotation></semantics></math></span></th>
