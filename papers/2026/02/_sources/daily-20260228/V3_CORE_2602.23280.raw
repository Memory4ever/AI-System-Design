</figure></div><div class="ltx_flex_cell ltx_flex_size_4">
<figure id="A4.F8.sf4" class="ltx_figure ltx_figure_panel ltx_align_center"><img src="2602.23280v1/charts/pointmaze-teleport-navigate-v0.png" id="A4.F8.sf4.g1" class="ltx_graphics ltx_centering ltx_img_landscape" style="aspect-ratio:476/335;" width="476" height="335" alt="Refer to caption">
