<td id="S4.T4.1.1.1.6" class="ltx_td ltx_align_center ltx_border_tt">Forecast dist_JS <math id="S4.T4.m5" class="ltx_Math" alttext="\downarrow" display="inline" intent=":literal"><semantics><mo stretchy="false">↓</mo><annotation encoding="application/x-tex">\downarrow</annotation></semantics></math></td></tr>
