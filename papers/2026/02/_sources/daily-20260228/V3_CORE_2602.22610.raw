<td id="S3.T1.1.1.9.4" class="ltx_td ltx_align_center ltx_border_r"><span id="S3.T1.1.1.9.4.1" class="ltx_text ltx_font_bold">2.122</span></td>
<td id="S3.T1.1.1.9.5" class="ltx_td ltx_align_center"><span id="S3.T1.1.1.9.5.1" class="ltx_text ltx_font_bold">0.671</span></td>
<td id="S3.T1.1.1.9.6" class="ltx_td ltx_align_center"><span id="S3.T1.1.1.9.6.1" class="ltx_text ltx_font_bold">0.757</span></td>
<td id="S3.T1.1.1.9.7" class="ltx_td ltx_align_center"><span id="S3.T1.1.1.9.7.1" class="ltx_text ltx_font_bold">3.240e-3</span></td></tr>
