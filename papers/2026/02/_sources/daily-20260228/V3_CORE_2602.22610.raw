<td id="S4.T4.1.1.5.3" class="ltx_td ltx_align_center ltx_border_bb"><math id="S4.T4.m14" class="ltx_Math" alttext="\checkmark" display="inline" intent=":literal"><semantics><mi>✓</mi><annotation encoding="application/x-tex">\checkmark</annotation></semantics></math></td>
<td id="S4.T4.1.1.5.4" class="ltx_td ltx_align_center ltx_border_bb">0.87</td>
