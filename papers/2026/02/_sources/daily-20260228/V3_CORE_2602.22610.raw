<td id="S4.T4.1.1.2.3" class="ltx_td ltx_align_center ltx_border_t"><math id="S4.T4.m7" class="ltx_Math" alttext="\times" display="inline" intent=":literal"><semantics><mo>×</mo><annotation encoding="application/x-tex">\times</annotation></semantics></math></td>
<td id="S4.T4.1.1.2.4" class="ltx_td ltx_align_center ltx_border_t">1.00</td>
