<td id="S4.T3.1.1.1.7" class="ltx_td ltx_align_center ltx_border_tt"><math id="S4.T3.m6" class="ltx_Math" alttext="\eta_{90}" display="inline" intent=":literal"><semantics><msub><mi>η</mi><mn>90</mn></msub><annotation encoding="application/x-tex">\eta_{90}</annotation></semantics></math></td></tr>
