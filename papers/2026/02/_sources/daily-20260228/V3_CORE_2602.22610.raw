<td id="S4.T4.1.1.1.3" class="ltx_td ltx_align_center ltx_border_tt"><math id="S4.T4.m2" class="ltx_Math" alttext="(\gamma,\beta,\alpha)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi>γ</mi><mo>,</mo><mi>β</mi><mo>,</mo><mi>α</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(\gamma,\beta,\alpha)</annotation></semantics></math> bounded</td>
