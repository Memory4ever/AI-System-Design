<span id="A4.T12.1.1.1.4.2.1.1" class="ltx_tr">
<span id="A4.T12.1.1.1.4.2.1.1.1" class="ltx_td ltx_nopad_r ltx_align_center">mean(<math id="A4.T12.m3" class="ltx_Math" alttext="\eta" display="inline" intent=":literal"><semantics><mi>η</mi><annotation encoding="application/x-tex">\eta</annotation></semantics></math>) <math id="A4.T12.m4" class="ltx_Math" alttext="\uparrow" display="inline" intent=":literal"><semantics><mo stretchy="false">↑</mo><annotation encoding="application/x-tex">\uparrow</annotation></semantics></math></span></span>
