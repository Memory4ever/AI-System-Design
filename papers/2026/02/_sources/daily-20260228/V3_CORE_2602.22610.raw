<section id="A4" class="ltx_appendix">
<h2 class="ltx_title ltx_title_appendix"><span class="ltx_tag ltx_tag_appendix">Appendix D </span>Clipping Behavior under DP</h2>

<figure id="A4.T12" class="ltx_table">
<div id="A4.T12.1" class="ltx_inline-block ltx_align_center ltx_transformed_outer" style="width:234.6pt;height:58.8pt;vertical-align:-28.1pt;"><span class="ltx_transformed_inner" style="transform:translate(-103.1pt,25.8pt) scale(0.532205030155128,0.532205030155128) ;">
