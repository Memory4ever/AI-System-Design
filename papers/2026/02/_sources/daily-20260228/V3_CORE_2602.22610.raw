<td id="A3.T6.1.1.4.5" class="ltx_td ltx_align_center"><span id="A3.T6.1.1.4.5.1" class="ltx_text ltx_font_bold">3.10%</span></td>
<td id="A3.T6.1.1.4.6" class="ltx_td ltx_align_center"><span id="A3.T6.1.1.4.6.1" class="ltx_text ltx_font_bold">0.741</span></td>
