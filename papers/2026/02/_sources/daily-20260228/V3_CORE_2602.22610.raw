<tr id="S4.T4.1.1.3" class="ltx_tr">
<td id="S4.T4.1.1.3.1" class="ltx_td ltx_align_left">DP-aware (only <math id="S4.T4.m8" class="ltx_Math" alttext="\mathbf{c}" display="inline" intent=":literal"><semantics><mi>𝐜</mi><annotation encoding="application/x-tex">\mathbf{c}</annotation></semantics></math>-bounding)</td>
<td id="S4.T4.1.1.3.2" class="ltx_td ltx_align_center"><math id="S4.T4.m9" class="ltx_Math" alttext="\checkmark" display="inline" intent=":literal"><semantics><mi>✓</mi><annotation encoding="application/x-tex">\checkmark</annotation></semantics></math></td>
<td id="S4.T4.1.1.3.3" class="ltx_td ltx_align_center"><math id="S4.T4.m10" class="ltx_Math" alttext="\times" display="inline" intent=":literal"><semantics><mo>×</mo><annotation encoding="application/x-tex">\times</annotation></semantics></math></td>
<td id="S4.T4.1.1.3.4" class="ltx_td ltx_align_center">0.95</td>
<td id="S4.T4.1.1.3.5" class="ltx_td ltx_align_center">0.510</td>
<td id="S4.T4.1.1.3.6" class="ltx_td ltx_align_center">0.691</td></tr>
<tr id="S4.T4.1.1.4" class="ltx_tr">
<td id="S4.T4.1.1.4.1" class="ltx_td ltx_align_left">DP-aware (only AdaLN bounding)</td>
<td id="S4.T4.1.1.4.2" class="ltx_td ltx_align_center"><math id="S4.T4.m11" class="ltx_Math" alttext="\times" display="inline" intent=":literal"><semantics><mo>×</mo><annotation encoding="application/x-tex">\times</annotation></semantics></math></td>
<td id="S4.T4.1.1.4.3" class="ltx_td ltx_align_center"><math id="S4.T4.m12" class="ltx_Math" alttext="\checkmark" display="inline" intent=":literal"><semantics><mi>✓</mi><annotation encoding="application/x-tex">\checkmark</annotation></semantics></math></td>
<td id="S4.T4.1.1.4.4" class="ltx_td ltx_align_center">0.93</td>
<td id="S4.T4.1.1.4.5" class="ltx_td ltx_align_center">0.495</td>
<td id="S4.T4.1.1.4.6" class="ltx_td ltx_align_center">0.677</td></tr>
