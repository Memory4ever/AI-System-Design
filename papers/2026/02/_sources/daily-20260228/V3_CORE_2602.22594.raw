<th id="S4.T3.3.1.10.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_bb ltx_border_r"><span id="S4.T3.3.1.10.1.1" class="ltx_text ltx_font_bold" style="--ltx-bg-color:#E6E6E6;">CMDM</span></th>
<td id="S4.T3.3.1.10.2" class="ltx_td ltx_align_center ltx_border_bb"><math id="S4.T3.m65" class="ltx_Math" style="--ltx-bg-color:#E6E6E6;" alttext="\mathbf{0.852^{\pm 0.003}}" display="inline" intent=":literal"><semantics><msup><mn style="--ltx-bg-color:#E6E6E6;" class="ltx_mathvariant_bold" mathbackground="#E6E6E6" mathvariant="bold">0.852</mn><mrow><mo style="--ltx-bg-color:#E6E6E6;" mathbackground="#E6E6E6">±</mo><mn style="--ltx-bg-color:#E6E6E6;" class="ltx_mathvariant_bold" mathbackground="#E6E6E6" mathvariant="bold">0.003</mn></mrow></msup><annotation encoding="application/x-tex">\mathbf{0.852^{\pm 0.003}}</annotation></semantics></math></td>
