            <span id="algx2.l13.3" class="ltx_text ltx_font_bold">return</span> Decoded motion <math id="algx2.l13.m1" class="ltx_math_unparsed" alttext="\hat{\mathbf{x}}_{1:T}" display="inline" intent=":literal"><semantics><mrow><mover accent="true"><mi>𝐱</mi><mo>^</mo></mover><msub><mrow></mrow><mrow><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mi>T</mi></mrow></msub></mrow><annotation encoding="application/x-tex">\hat{\mathbf{x}}_{1:T}</annotation></semantics></math> (or latents <math id="algx2.l13.m2" class="ltx_math_unparsed" alttext="\tilde{\mathbf{z}}_{1:T}^{\,0}" display="inline" intent=":literal"><semantics><mrow><mover accent="true"><mi>𝐳</mi><mo>~</mo></mover><msub><mrow></mrow><mrow><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mi>T</mi></mrow></msub><msup><mrow></mrow><mn> 0</mn></msup></mrow><annotation encoding="application/x-tex">\tilde{\mathbf{z}}_{1:T}^{\,0}</annotation></semantics></math>)

</div>
