<tr id="A2.T9.3.1.2" class="ltx_tr">
<td id="A2.T9.3.1.2.1" class="ltx_td ltx_align_center ltx_border_t">FID<math id="A2.T9.m1" class="ltx_Math" alttext="\downarrow" display="inline" intent=":literal"><semantics><mo stretchy="false">↓</mo><annotation encoding="application/x-tex">\downarrow</annotation></semantics></math></td>
