               <span id="algx2.l8.3" class="ltx_text ltx_font_bold">if</span> <math id="algx2.l8.m1" class="ltx_Math" alttext="k=0" display="inline" intent=":literal"><semantics><mrow><mi>k</mi><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">k=0</annotation></semantics></math> <span id="algx2.l8.4" class="ltx_text ltx_font_bold">then</span>

