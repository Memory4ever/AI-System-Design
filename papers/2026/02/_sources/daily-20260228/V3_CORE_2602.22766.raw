<td id="S3.T1.7.1.4.7" class="ltx_td ltx_align_center">48.0*</td>
<td id="S3.T1.7.1.4.8" class="ltx_td ltx_align_center">55.5*</td>
<td id="S3.T1.7.1.4.9" class="ltx_td ltx_align_center">62.0*</td>
<td id="S3.T1.7.1.4.10" class="ltx_td ltx_align_center">49.0*</td>
