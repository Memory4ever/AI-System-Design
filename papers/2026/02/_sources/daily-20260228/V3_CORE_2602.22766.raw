<tr id="S3.T1.7.1.5" class="ltx_tr" style="--ltx-bg-color:#FEE090;">
<th id="S3.T1.7.1.5.1" class="ltx_td ltx_align_center ltx_th ltx_th_row ltx_border_t" colspan="15"><span id="S3.T1.7.1.5.1.1" class="ltx_text ltx_font_bold">Open-Source Models</span></th></tr>
<tr id="S3.T1.7.1.6" class="ltx_tr">
<th id="S3.T1.7.1.6.1" class="ltx_td ltx_align_left ltx_th ltx_th_row">InternVL3-8B</th>
<td id="S3.T1.7.1.6.2" class="ltx_td ltx_align_center">72.3</td>
