<td id="S4.T2.8.1.2.2" class="ltx_td ltx_nopad_l ltx_nopad_r ltx_align_center ltx_border_t" style="padding-top:0.6pt;padding-bottom:0.6pt;"><span id="S4.T2.8.1.2.2.1" class="ltx_text" style="--ltx-bg-color:#F2F2F2;">59.15</span></td>
<td id="S4.T2.8.1.2.3" class="ltx_td ltx_nopad_l ltx_nopad_r ltx_align_center ltx_border_t" style="padding-top:0.6pt;padding-bottom:0.6pt;"><span id="S4.T2.8.1.2.3.1" class="ltx_text" style="--ltx-bg-color:#F2F2F2;">57.67</span></td></tr>
