<td id="S4.T1.8.1.3.4" class="ltx_td ltx_nopad_l ltx_nopad_r ltx_align_center ltx_border_t" style="padding-top:0.6pt;padding-bottom:0.6pt;"><span id="S4.T1.8.1.3.4.1" class="ltx_text" style="--ltx-bg-color:#F2F2F2;">59.15</span></td>
<td id="S4.T1.8.1.3.5" class="ltx_td ltx_nopad_l ltx_nopad_r ltx_align_center ltx_border_r ltx_border_t" style="padding-top:0.6pt;padding-bottom:0.6pt;"><math id="S4.T1.m5" class="ltx_Math" style="--ltx-bg-color:#F2F2F2;" alttext="1.00" display="inline" intent=":literal"><semantics><mn style="--ltx-bg-color:#F2F2F2;" mathbackground="#F2F2F2">1.00</mn><annotation encoding="application/x-tex">1.00</annotation></semantics></math></td>
<td id="S4.T1.8.1.3.6" class="ltx_td ltx_nopad_l ltx_nopad_r ltx_align_center ltx_border_t" style="padding-top:0.6pt;padding-bottom:0.6pt;"><span id="S4.T1.8.1.3.6.1" class="ltx_text" style="--ltx-bg-color:#F2F2F2;">32.93</span></td>
