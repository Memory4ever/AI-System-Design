<th id="S4.T2.8.1.5.1" class="ltx_td ltx_nopad_l ltx_nopad_r ltx_align_left ltx_th ltx_th_row ltx_border_r" style="padding-top:0.6pt;padding-bottom:0.6pt;">DoT-bank</th>
<td id="S4.T2.8.1.5.2" class="ltx_td ltx_nopad_l ltx_nopad_r ltx_align_center" style="padding-top:0.6pt;padding-bottom:0.6pt;"><span id="S4.T2.8.1.5.2.1" class="ltx_text ltx_underline">79.56</span><span id="S4.T2.8.1.5.2.2" class="ltx_text" style="font-size:70%;"> <math id="S4.T2.m5" class="ltx_Math" alttext="\uparrow" display="inline" intent=":literal"><semantics><mo style="--ltx-fg-color:#E9967A;" mathcolor="#E9967A" stretchy="false">↑</mo><annotation encoding="application/x-tex">\uparrow</annotation></semantics></math><span id="S4.T2.8.1.5.2.2.1" class="ltx_text" style="--ltx-fg-color:#E9967A;"> 20.41</span></span></td>
<td id="S4.T2.8.1.5.3" class="ltx_td ltx_nopad_l ltx_nopad_r ltx_align_center" style="padding-top:0.6pt;padding-bottom:0.6pt;">72.00<span id="S4.T2.8.1.5.3.1" class="ltx_text" style="font-size:70%;"> <math id="S4.T2.m6" class="ltx_Math" alttext="\uparrow" display="inline" intent=":literal"><semantics><mo style="--ltx-fg-color:#E9967A;" mathcolor="#E9967A" stretchy="false">↑</mo><annotation encoding="application/x-tex">\uparrow</annotation></semantics></math><span id="S4.T2.8.1.5.3.1.1" class="ltx_text" style="--ltx-fg-color:#E9967A;"> 14.33</span></span></td></tr>
<tr id="S4.T2.8.1.6" class="ltx_tr" style="--ltx-bg-color:#F2F2F2;">
<th id="S4.T2.8.1.6.1" class="ltx_td ltx_nopad_l ltx_nopad_r ltx_align_left ltx_th ltx_th_row ltx_border_r ltx_border_t" style="padding-top:0.6pt;padding-bottom:0.6pt;">
