</span><span id="alg1.l0.50" class="ltx_ERROR undefined">\EndIf</span><span id="alg1.l0.51" class="ltx_ERROR undefined">\EndFor</span><span id="alg1.l0.52" class="ltx_ERROR undefined">\State</span><span id="alg1.l0.53" class="ltx_text ltx_font_bold" style="font-size:80%;">if</span><span id="alg1.l0.54" class="ltx_text" style="font-size:80%;"> not solved </span><span id="alg1.l0.55" class="ltx_text ltx_font_bold" style="font-size:80%;">then</span><span id="alg1.l0.56" class="ltx_text" style="font-size:80%;"> </span><math id="alg1.l0.m26" class="ltx_Math" alttext="\mathcal{F}\leftarrow\mathcal{F}\cup\{x\}" display="inline" intent=":literal"><semantics><mrow><mi class="ltx_font_mathcaligraphic" mathsize="0.800em">ℱ</mi><mo mathsize="0.800em" stretchy="false">←</mo><mrow><mi class="ltx_font_mathcaligraphic" mathsize="0.800em">ℱ</mi><mo mathsize="0.800em">∪</mo><mrow><mo stretchy="false">{</mo><mi mathsize="0.800em">x</mi><mo stretchy="false">}</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\mathcal{F}\leftarrow\mathcal{F}\cup\{x\}</annotation></semantics></math><span id="alg1.l0.57" class="ltx_text" style="font-size:80%;">
