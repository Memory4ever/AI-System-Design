            <span id="lstnumberx56.2" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:90%;">    </span><span id="lstnumberx56.3" class="ltx_text ltx_lst_string ltx_font_typewriter" style="font-size:90%;--ltx-fg-color:#B80000;">""</span><span id="lstnumberx56.4" class="ltx_text ltx_lst_string ltx_font_typewriter" style="font-size:90%;--ltx-fg-color:#B80000;">"Check<span id="lstnumberx56.4.1" class="ltx_text ltx_lst_space"> </span>if<span id="lstnumberx56.4.2" class="ltx_text ltx_lst_space"> </span>any<span id="lstnumberx56.4.3" class="ltx_text ltx_lst_space"> </span>two<span id="lstnumberx56.4.4" class="ltx_text ltx_lst_space"> </span>numbers<span id="lstnumberx56.4.5" class="ltx_text ltx_lst_space"> </span>in<span id="lstnumberx56.4.6" class="ltx_text ltx_lst_space"> </span>the<span id="lstnumberx56.4.7" class="ltx_text ltx_lst_space"> </span>list<span id="lstnumberx56.4.8" class="ltx_text ltx_lst_space"> </span>are<span id="lstnumberx56.4.9" class="ltx_text ltx_lst_space"> </span>closer<span id="lstnumberx56.4.10" class="ltx_text ltx_lst_space"> </span>than<span id="lstnumberx56.4.11" class="ltx_text ltx_lst_space"> </span>the<span id="lstnumberx56.4.12" class="ltx_text ltx_lst_space"> </span>threshold."</span><span id="lstnumberx56.5" class="ltx_text ltx_lst_string ltx_font_typewriter" style="font-size:90%;--ltx-fg-color:#B80000;">""</span>
</div>
<div id="lstnumberx57" class="ltx_listingline">
