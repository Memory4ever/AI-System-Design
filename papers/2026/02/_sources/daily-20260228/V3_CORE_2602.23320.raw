<th id="S4.T2.8.1.3.1" class="ltx_td ltx_nopad_l ltx_nopad_r ltx_align_left ltx_th ltx_th_row ltx_border_r" style="padding-top:0.6pt;padding-bottom:0.6pt;">Reflexion</th>
<td id="S4.T2.8.1.3.2" class="ltx_td ltx_nopad_l ltx_nopad_r ltx_align_center" style="padding-top:0.6pt;padding-bottom:0.6pt;">76.22<span id="S4.T2.8.1.3.2.1" class="ltx_text" style="font-size:70%;"> <math id="S4.T2.m1" class="ltx_Math" alttext="\uparrow" display="inline" intent=":literal"><semantics><mo style="--ltx-fg-color:#E9967A;" mathcolor="#E9967A" stretchy="false">↑</mo><annotation encoding="application/x-tex">\uparrow</annotation></semantics></math><span id="S4.T2.8.1.3.2.1.1" class="ltx_text" style="--ltx-fg-color:#E9967A;"> 17.07</span></span></td>
