<td id="S4.T2.8.1.6.3" class="ltx_td ltx_nopad_l ltx_nopad_r ltx_align_center ltx_border_t" style="padding-top:0.6pt;padding-bottom:0.6pt;"><span id="S4.T2.8.1.6.3.1" class="ltx_text ltx_underline" style="--ltx-bg-color:#F2F2F2;">76.33</span><span id="S4.T2.8.1.6.3.2" class="ltx_text" style="font-size:70%;--ltx-bg-color:#F2F2F2;"> <math id="S4.T2.m8" class="ltx_Math" alttext="\uparrow" display="inline" intent=":literal"><semantics><mo style="--ltx-fg-color:#E9967A;--ltx-bg-color:#F2F2F2;" mathbackground="#F2F2F2" mathcolor="#E9967A" stretchy="false">↑</mo><annotation encoding="application/x-tex">\uparrow</annotation></semantics></math><span id="S4.T2.8.1.6.3.2.1" class="ltx_text" style="--ltx-fg-color:#E9967A;"> 18.66</span></span></td></tr>
<tr id="S4.T2.8.1.7" class="ltx_tr">
<th id="S4.T2.8.1.7.1" class="ltx_td ltx_nopad_l ltx_nopad_r ltx_align_left ltx_th ltx_th_row ltx_border_b ltx_border_r" style="padding-top:0.6pt;padding-bottom:0.6pt;">
<div id="S4.T2.8.1.7.1.1" class="ltx_inline-block ltx_transformed_outer" style="width:5.3pt;height:6.2pt;vertical-align:-0.0pt;"><span class="ltx_transformed_inner" style="transform:translate(0.0pt,-0.0pt) scale(1.0,1.0) ;">
<p id="S4.T2.8.1.7.1.1.1" class="ltx_p"><span id="S4.T2.8.1.7.1.1.1.1" class="ltx_text ltx_font_typewriter">P</span></p>
</span></div><span id="S4.T2.8.1.7.1.2" class="ltx_text ltx_font_typewriter">aram
<span id="S4.T2.8.1.7.1.2.1" class="ltx_inline-block ltx_transformed_outer" style="width:5.3pt;height:6.2pt;vertical-align:-0.0pt;"><span class="ltx_transformed_inner" style="transform:translate(0.0pt,-0.0pt) scale(1.0,1.0) ;">
<span id="S4.T2.8.1.7.1.2.1.1" class="ltx_p">A</span>
</span></span>gent-plus</span> <span id="S4.T2.8.1.7.1.3" class="ltx_text" style="position:relative; bottom:-1.0pt;"><img src="2602.23320v1/figures/llama.png" id="S4.T2.g4" class="ltx_graphics ltx_img_square" style="aspect-ratio:13/13;" width="13" height="13" alt="[Uncaptioned image]"></span></th>
<td id="S4.T2.8.1.7.2" class="ltx_td ltx_nopad_l ltx_nopad_r ltx_align_center ltx_border_b" style="padding-top:0.6pt;padding-bottom:0.6pt;"><span id="S4.T2.8.1.7.2.1" class="ltx_text ltx_font_bold">86.59</span><span id="S4.T2.8.1.7.2.2" class="ltx_text" style="font-size:70%;"> <math id="S4.T2.m9" class="ltx_Math" alttext="\uparrow" display="inline" intent=":literal"><semantics><mo style="--ltx-fg-color:#E9967A;" mathcolor="#E9967A" stretchy="false">↑</mo><annotation encoding="application/x-tex">\uparrow</annotation></semantics></math><span id="S4.T2.8.1.7.2.2.1" class="ltx_text" style="--ltx-fg-color:#E9967A;"> 27.44</span></span></td>
<td id="S4.T2.8.1.7.3" class="ltx_td ltx_nopad_l ltx_nopad_r ltx_align_center ltx_border_b" style="padding-top:0.6pt;padding-bottom:0.6pt;"><span id="S4.T2.8.1.7.3.1" class="ltx_text ltx_font_bold">83.33</span><span id="S4.T2.8.1.7.3.2" class="ltx_text" style="font-size:70%;"> <math id="S4.T2.m10" class="ltx_Math" alttext="\uparrow" display="inline" intent=":literal"><semantics><mo style="--ltx-fg-color:#E9967A;" mathcolor="#E9967A" stretchy="false">↑</mo><annotation encoding="application/x-tex">\uparrow</annotation></semantics></math><span id="S4.T2.8.1.7.3.2.1" class="ltx_text" style="--ltx-fg-color:#E9967A;"> 25.66</span></span></td></tr>
