<td id="S4.T2.8.1.4.2" class="ltx_td ltx_nopad_l ltx_nopad_r ltx_align_center" style="padding-top:0.6pt;padding-bottom:0.6pt;"><span id="S4.T2.8.1.4.2.1" class="ltx_text" style="--ltx-bg-color:#F2F2F2;">73.17<span id="S4.T2.8.1.4.2.1.1" class="ltx_text" style="font-size:70%;"> <math id="S4.T2.m3" class="ltx_Math" alttext="\uparrow" display="inline" intent=":literal"><semantics><mo style="--ltx-fg-color:#E9967A;--ltx-bg-color:#F2F2F2;" mathbackground="#F2F2F2" mathcolor="#E9967A" stretchy="false">↑</mo><annotation encoding="application/x-tex">\uparrow</annotation></semantics></math><span id="S4.T2.8.1.4.2.1.1.1" class="ltx_text" style="--ltx-fg-color:#E9967A;"> 14.02</span></span></span></td>
<td id="S4.T2.8.1.4.3" class="ltx_td ltx_nopad_l ltx_nopad_r ltx_align_center" style="padding-top:0.6pt;padding-bottom:0.6pt;"><span id="S4.T2.8.1.4.3.1" class="ltx_text" style="--ltx-bg-color:#F2F2F2;">66.67<span id="S4.T2.8.1.4.3.1.1" class="ltx_text" style="font-size:70%;"> <math id="S4.T2.m4" class="ltx_Math" alttext="\uparrow" display="inline" intent=":literal"><semantics><mo style="--ltx-fg-color:#E9967A;--ltx-bg-color:#F2F2F2;" mathbackground="#F2F2F2" mathcolor="#E9967A" stretchy="false">↑</mo><annotation encoding="application/x-tex">\uparrow</annotation></semantics></math><span id="S4.T2.8.1.4.3.1.1.1" class="ltx_text" style="--ltx-fg-color:#E9967A;"> 9.00</span></span></span></td></tr>
