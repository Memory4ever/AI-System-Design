<th id="S4.T2.8.1.1.1" class="ltx_td ltx_nopad_l ltx_nopad_r ltx_align_left ltx_th ltx_th_row ltx_border_r ltx_border_t" style="padding-top:0.6pt;padding-bottom:0.6pt;"><span id="S4.T2.8.1.1.1.1" class="ltx_text ltx_font_bold" style="--ltx-bg-color:#DFE2F3;">Method</span></th>
<td id="S4.T2.8.1.1.2" class="ltx_td ltx_nopad_l ltx_nopad_r ltx_align_center ltx_border_t" style="padding-top:0.6pt;padding-bottom:0.6pt;"><span id="S4.T2.8.1.1.2.1" class="ltx_text ltx_font_bold" style="--ltx-bg-color:#DFE2F3;">HumanEval</span></td>
