</div>
<div id="lstnumberx22" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline">8</span>
              
              
              
            <span id="lstnumberx22.2" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:90%;">    </span><span id="lstnumberx22.3" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:90%;">synchronization</span><span id="lstnumberx22.4" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:90%;"> </span><span id="lstnumberx22.5" class="ltx_text ltx_font_typewriter" style="font-size:90%;">;</span>
</div>
<div id="lstnumberx23" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline">9</span>
              
              
              
            
</div>
<div id="lstnumberx24" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline">10</span>
              
              
              
            <span id="lstnumberx24.2" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:90%;">    </span><span id="lstnumberx24.3" class="ltx_text ltx_lst_comment ltx_font_typewriter" style="font-size:90%;--ltx-fg-color:#009900;">//<span id="lstnumberx24.3.1" class="ltx_text ltx_lst_space"> </span>do<span id="lstnumberx24.3.2" class="ltx_text ltx_lst_space"> </span>the<span id="lstnumberx24.3.3" class="ltx_text ltx_lst_space"> </span>read<span id="lstnumberx24.3.4" class="ltx_text ltx_lst_space"> </span>and<span id="lstnumberx24.3.5" class="ltx_text ltx_lst_space"> </span>reduce<span id="lstnumberx24.3.6" class="ltx_text ltx_lst_space"> </span>operation<span id="lstnumberx24.3.7" class="ltx_text ltx_lst_space"> </span>if<span id="lstnumberx24.3.8" class="ltx_text ltx_lst_space"> </span>needed</span>
</div>
<div id="lstnumberx25" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline">11</span>
              
              
              
            <span id="lstnumberx25.2" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:90%;">    </span><span id="lstnumberx25.3" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:90%;">cudaMemcpy</span><span id="lstnumberx25.4" class="ltx_text ltx_font_typewriter" style="font-size:90%;">(</span><span id="lstnumberx25.5" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:90%;">dst</span><span id="lstnumberx25.6" class="ltx_text ltx_font_typewriter" style="font-size:90%;">,</span><span id="lstnumberx25.7" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:90%;"> </span><span id="lstnumberx25.8" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:90%;">src</span><span id="lstnumberx25.9" class="ltx_text ltx_font_typewriter" style="font-size:90%;">,</span><span id="lstnumberx25.10" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:90%;">size</span><span id="lstnumberx25.11" class="ltx_text ltx_font_typewriter" style="font-size:90%;">,</span><span id="lstnumberx25.12" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:90%;"> </span><span id="lstnumberx25.13" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:90%;">cudaMemcpyHostToDevice</span><span id="lstnumberx25.14" class="ltx_text ltx_font_typewriter" style="font-size:90%;">);</span>
