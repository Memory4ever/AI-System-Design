<td id="S4.T2.6.5.4" class="ltx_td ltx_align_left ltx_align_top ltx_border_r ltx_border_t" style="padding-top:0.9pt;padding-bottom:0.9pt;">
<span id="S4.T2.6.5.4.1" class="ltx_inline-block ltx_align_top" style="width:199.2pt;">
<span id="S4.T2.6.5.4.1.1" class="ltx_p"><span id="S4.T2.6.5.4.1.1.1" class="ltx_text" style="font-size:90%;">Each rank gathers </span><math id="S4.T2.m14" class="ltx_Math" alttext="N" display="inline" intent=":literal"><semantics><mi mathsize="0.900em">N</mi><annotation encoding="application/x-tex">N</annotation></semantics></math><span id="S4.T2.6.5.4.1.1.2" class="ltx_text" style="font-size:90%;"> elements from every other rank.</span></span>
</span></td></tr>
<tr id="S4.T2.6.6" class="ltx_tr">
<td id="S4.T2.6.6.1" class="ltx_td ltx_align_left ltx_border_l ltx_border_r ltx_border_t" style="padding-top:0.9pt;padding-bottom:0.9pt;"><span id="S4.T2.6.6.1.1" class="ltx_text ltx_font_typewriter" style="font-size:90%;">ncclReduceScatter</span></td>
<td id="S4.T2.6.6.2" class="ltx_td ltx_align_center ltx_border_r ltx_border_t" style="padding-top:0.9pt;padding-bottom:0.9pt;"><math id="S4.T2.m15" class="ltx_Math" alttext="N" display="inline" intent=":literal"><semantics><mi mathsize="0.900em">N</mi><annotation encoding="application/x-tex">N</annotation></semantics></math></td>
