<td id="S4.T3.10.3.2" class="ltx_td ltx_align_center"><span id="S4.T3.10.3.2.1" class="ltx_text" style="font-size:90%;">88.1</span></td>
<td id="S4.T3.10.3.3" class="ltx_td ltx_align_center"><span id="S4.T3.10.3.3.1" class="ltx_text" style="font-size:90%;">49.2</span></td>
<td id="S4.T3.10.3.4" class="ltx_td ltx_align_center"><span id="S4.T3.10.3.4.1" class="ltx_text" style="font-size:90%;">68.7</span></td></tr>
<tr id="S4.T3.10.4" class="ltx_tr" style="--ltx-bg-color:#D9FFFF;">
<th id="S4.T3.10.4.1" class="ltx_td ltx_align_left ltx_th ltx_th_row"><span id="S4.T3.10.4.1.1" class="ltx_text" style="font-size:90%;--ltx-bg-color:#D9FFFF;">4</span></th>
<td id="S4.T3.10.4.2" class="ltx_td ltx_align_center"><span id="S4.T3.10.4.2.1" class="ltx_text" style="font-size:90%;--ltx-bg-color:#D9FFFF;">91.5</span></td>
<td id="S4.T3.10.4.3" class="ltx_td ltx_align_center"><span id="S4.T3.10.4.3.1" class="ltx_text" style="font-size:90%;--ltx-bg-color:#D9FFFF;">54.2</span></td>
<td id="S4.T3.10.4.4" class="ltx_td ltx_align_center"><span id="S4.T3.10.4.4.1" class="ltx_text" style="font-size:90%;--ltx-bg-color:#D9FFFF;">72.9</span></td></tr>
<tr id="S4.T3.10.5" class="ltx_tr">
<th id="S4.T3.10.5.1" class="ltx_td ltx_align_left ltx_th ltx_th_row"><span id="S4.T3.10.5.1.1" class="ltx_text" style="font-size:90%;">6</span></th>
<td id="S4.T3.10.5.2" class="ltx_td ltx_align_center"><span id="S4.T3.10.5.2.1" class="ltx_text" style="font-size:90%;">91.4</span></td>
<td id="S4.T3.10.5.3" class="ltx_td ltx_align_center"><span id="S4.T3.10.5.3.1" class="ltx_text" style="font-size:90%;">54.3</span></td>
<td id="S4.T3.10.5.4" class="ltx_td ltx_align_center"><span id="S4.T3.10.5.4.1" class="ltx_text" style="font-size:90%;">72.9</span></td></tr>
<tr id="S4.T3.10.6" class="ltx_tr">
