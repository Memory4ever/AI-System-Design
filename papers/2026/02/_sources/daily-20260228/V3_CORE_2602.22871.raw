<td id="S4.T3.10.2.3" class="ltx_td ltx_align_center ltx_border_t"><span id="S4.T3.10.2.3.1" class="ltx_text" style="font-size:90%;">46.0</span></td>
<td id="S4.T3.10.2.4" class="ltx_td ltx_align_center ltx_border_t"><span id="S4.T3.10.2.4.1" class="ltx_text" style="font-size:90%;">64.2</span></td></tr>
