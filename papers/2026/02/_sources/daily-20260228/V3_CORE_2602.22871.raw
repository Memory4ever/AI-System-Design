<td id="S4.T3.10.6.3" class="ltx_td ltx_align_center ltx_border_bb"><span id="S4.T3.10.6.3.1" class="ltx_text" style="font-size:90%;">55.0</span></td>
<td id="S4.T3.10.6.4" class="ltx_td ltx_align_center ltx_border_bb"><span id="S4.T3.10.6.4.1" class="ltx_text" style="font-size:90%;">73.2</span></td></tr>
