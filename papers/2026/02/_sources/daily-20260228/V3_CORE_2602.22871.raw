<td id="S4.T1.8.1.4" class="ltx_td ltx_align_center ltx_border_tt" colspan="2"><span id="S4.T1.8.1.4.1" class="ltx_text ltx_font_bold" style="font-size:90%;">Math</span></td>
<td id="S4.T1.8.1.5" class="ltx_td ltx_align_center ltx_border_tt"><span id="S4.T1.8.1.5.1" class="ltx_text ltx_font_bold" style="font-size:90%;">Avg</span></td></tr>
<tr id="S4.T1.8.2" class="ltx_tr">
<td id="S4.T1.8.2.1" class="ltx_td ltx_align_left ltx_border_t"><span id="S4.T1.8.2.1.1" class="ltx_text ltx_font_bold" style="font-size:90%;">Model Arch</span></td>
<td id="S4.T1.8.2.2" class="ltx_td ltx_align_left ltx_border_t"><span id="S4.T1.8.2.2.1" class="ltx_text ltx_font_bold" style="font-size:90%;">Size</span></td>
<td id="S4.T1.8.2.3" class="ltx_td ltx_align_center ltx_border_t"><span id="S4.T1.8.2.3.1" class="ltx_text ltx_font_bold" style="font-size:90%;">HumanEval</span></td>
<td id="S4.T1.8.2.4" class="ltx_td ltx_align_center ltx_border_t"><span id="S4.T1.8.2.4.1" class="ltx_text ltx_font_bold" style="font-size:90%;">HumanEval+</span></td>
<td id="S4.T1.8.2.5" class="ltx_td ltx_align_center ltx_border_t"><span id="S4.T1.8.2.5.1" class="ltx_text ltx_font_bold" style="font-size:90%;">MBPP</span></td>
<td id="S4.T1.8.2.6" class="ltx_td ltx_align_center ltx_border_t"><span id="S4.T1.8.2.6.1" class="ltx_text ltx_font_bold" style="font-size:90%;">MBPP+</span></td>
<td id="S4.T1.8.2.7" class="ltx_td ltx_align_center ltx_border_t"><span id="S4.T1.8.2.7.1" class="ltx_text ltx_font_bold" style="font-size:90%;">GSM8K</span></td>
<td id="S4.T1.8.2.8" class="ltx_td ltx_align_center ltx_border_t"><span id="S4.T1.8.2.8.1" class="ltx_text ltx_font_bold" style="font-size:90%;">Minerva Math</span></td>
<td id="S4.T1.8.2.9" class="ltx_td ltx_border_t"></td></tr>
<tr id="S4.T1.8.3" class="ltx_tr">
<td id="S4.T1.8.3.1" class="ltx_td ltx_align_left ltx_border_t"><span id="S4.T1.8.3.1.1" class="ltx_text" style="font-size:90%;">Qwen3</span></td>
<td id="S4.T1.8.3.2" class="ltx_td ltx_align_left ltx_border_t"><span id="S4.T1.8.3.2.1" class="ltx_text" style="font-size:90%;">4B</span></td>
<td id="S4.T1.8.3.3" class="ltx_td ltx_align_center ltx_border_t"><span id="S4.T1.8.3.3.1" class="ltx_text" style="font-size:90%;">57.32</span></td>
