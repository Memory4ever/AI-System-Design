<td id="S4.T1.7.3.2" class="ltx_td ltx_align_center ltx_border_t"><span id="S4.T1.7.3.2.1" class="ltx_text" style="font-size:70%;">162M</span></td>
<td id="S4.T1.7.3.3" class="ltx_td ltx_align_center ltx_border_t"><span id="S4.T1.7.3.3.1" class="ltx_text" style="font-size:70%;">768</span></td>
<td id="S4.T1.7.3.4" class="ltx_td ltx_align_center ltx_border_t"><span id="S4.T1.7.3.4.1" class="ltx_text" style="font-size:70%;">13</span></td>
<td id="S4.T1.7.3.5" class="ltx_td ltx_align_center ltx_border_t"><span id="S4.T1.7.3.5.1" class="ltx_text" style="font-size:70%;">60.70</span></td>
<td id="S4.T1.7.3.6" class="ltx_td ltx_align_center ltx_border_t"><span id="S4.T1.7.3.6.1" class="ltx_text" style="font-size:70%;">215.18</span></td>
<td id="S4.T1.7.3.7" class="ltx_td ltx_align_center ltx_border_t"><span id="S4.T1.7.3.7.1" class="ltx_text" style="font-size:70%;">105.72</span></td>
<td id="S4.T1.7.3.8" class="ltx_td ltx_align_center ltx_border_t"><span id="S4.T1.7.3.8.1" class="ltx_text" style="font-size:70%;">8.12</span></td>
<td id="S4.T1.7.3.9" class="ltx_td ltx_align_center ltx_border_t"><span id="S4.T1.7.3.9.1" class="ltx_text" style="font-size:70%;">8.23</span></td>
<td id="S4.T1.7.3.10" class="ltx_td ltx_align_center ltx_border_t"><span id="S4.T1.7.3.10.1" class="ltx_text" style="font-size:70%;">5.09</span></td>
<td id="S4.T1.7.3.11" class="ltx_td ltx_align_center ltx_border_t"><math id="S4.T1.m13" class="ltx_Math" alttext="\sim" display="inline" intent=":literal"><semantics><mo mathsize="0.700em">∼</mo><annotation encoding="application/x-tex">\sim</annotation></semantics></math><span id="S4.T1.7.3.11.1" class="ltx_text" style="font-size:70%;"> <span id="S4.T1.7.3.11.1.1" class="ltx_text ltx_font_bold">127000</span></span></td>
<td id="S4.T1.7.3.12" class="ltx_td ltx_align_center ltx_border_t"><math id="S4.T1.m14" class="ltx_Math" alttext="118\,\mathrm{GB\cdot h}" display="inline" intent=":literal"><semantics><mrow><mrow><mn mathsize="0.700em">𝟏𝟏𝟖</mn><mo lspace="0.170em" rspace="0em">​</mo><mi mathsize="0.700em">𝐆𝐁</mi></mrow><mo class="ltx_mathvariant_bold" lspace="0.222em" mathsize="0.700em" mathvariant="bold" rspace="0.222em">⋅</mo><mi mathsize="0.700em">𝐡</mi></mrow><annotation encoding="application/x-tex">118\,\mathrm{GB\cdot h}</annotation></semantics></math></td></tr>
