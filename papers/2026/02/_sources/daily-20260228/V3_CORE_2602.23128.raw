</figure>
<div class="ltx_pagination ltx_role_newpage"></div>
<div id="A4.SS6.p2" class="ltx_para">
<p id="A4.SS6.p2.1" class="ltx_p"><span id="A4.SS6.p2.1.1" class="ltx_text ltx_font_bold">Hyperparameters for MNIST</span></p>
<div class="ltx_pagination ltx_role_start_2_columns"></div>
<ul id="A4.I11" class="ltx_itemize">
<li id="A4.I11.i1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="A4.I11.i1.p1" class="ltx_para">
<p id="A4.I11.i1.p1.1" class="ltx_p">Portion of pretraining set : 20%</p>
</div></li>
<li id="A4.I11.i2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="A4.I11.i2.p1" class="ltx_para">
<p id="A4.I11.i2.p1.1" class="ltx_p">Number of pretraining epochs : 100</p>
</div></li>
<li id="A4.I11.i3" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="A4.I11.i3.p1" class="ltx_para">
<p id="A4.I11.i3.p1.1" class="ltx_p">Pretraining learning rate : <math id="A4.I11.i3.p1.m1" class="ltx_Math" alttext="10^{-3}" display="inline" intent=":literal"><semantics><msup><mn>10</mn><mrow><mo>−</mo><mn>3</mn></mrow></msup><annotation encoding="application/x-tex">10^{-3}</annotation></semantics></math></p>
</div></li>
<li id="A4.I11.i4" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="A4.I11.i4.p1" class="ltx_para">
<p id="A4.I11.i4.p1.1" class="ltx_p">Dropout probability : 0.0</p>
</div></li>
<li id="A4.I11.i5" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="A4.I11.i5.p1" class="ltx_para">
<p id="A4.I11.i5.p1.1" class="ltx_p">Optimizer : Adam</p>
</div></li>
<li id="A4.I11.i6" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="A4.I11.i6.p1" class="ltx_para">
<p id="A4.I11.i6.p1.1" class="ltx_p">Training learning rate : <math id="A4.I11.i6.p1.m1" class="ltx_Math" alttext="\{10^{-3},5\times 10^{-3},10^{-4}\}" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">{</mo><msup><mn>10</mn><mrow><mo>−</mo><mn>3</mn></mrow></msup><mo>,</mo><mrow><mn>5</mn><mo lspace="0.222em" rspace="0.222em">×</mo><msup><mn>10</mn><mrow><mo>−</mo><mn>3</mn></mrow></msup></mrow><mo>,</mo><msup><mn>10</mn><mrow><mo>−</mo><mn>4</mn></mrow></msup><mo stretchy="false">}</mo></mrow><annotation encoding="application/x-tex">\{10^{-3},5\times 10^{-3},10^{-4}\}</annotation></semantics></math></p>
</div></li>
<li id="A4.I11.i7" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="A4.I11.i7.p1" class="ltx_para">
<p id="A4.I11.i7.p1.1" class="ltx_p">Weight decay : <math id="A4.I11.i7.p1.m1" class="ltx_Math" alttext="\{0.01,0.1\}" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">{</mo><mn>0.01</mn><mo>,</mo><mn>0.1</mn><mo stretchy="false">}</mo></mrow><annotation encoding="application/x-tex">\{0.01,0.1\}</annotation></semantics></math></p>
</div></li>
<li id="A4.I11.i8" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="A4.I11.i8.p1" class="ltx_para">
<p id="A4.I11.i8.p1.1" class="ltx_p">Smoothing parameter <math id="A4.I11.i8.p1.m1" class="ltx_Math" alttext="\alpha" display="inline" intent=":literal"><semantics><mi>α</mi><annotation encoding="application/x-tex">\alpha</annotation></semantics></math> : <math id="A4.I11.i8.p1.m2" class="ltx_Math" alttext="10^{-3}" display="inline" intent=":literal"><semantics><msup><mn>10</mn><mrow><mo>−</mo><mn>3</mn></mrow></msup><annotation encoding="application/x-tex">10^{-3}</annotation></semantics></math></p>
</div></li>
<li id="A4.I11.i9" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="A4.I11.i9.p1" class="ltx_para">
<p id="A4.I11.i9.p1.1" class="ltx_p">Softmax : <math id="A4.I11.i9.p1.m1" class="ltx_Math" alttext="\{" display="inline" intent=":literal"><semantics><mo stretchy="false">{</mo><annotation encoding="application/x-tex">\{</annotation></semantics></math> Smoothed, Clamped<math id="A4.I11.i9.p1.m2" class="ltx_Math" alttext="\}" display="inline" intent=":literal"><semantics><mo stretchy="false">}</mo><annotation encoding="application/x-tex">\}</annotation></semantics></math></p>
</div></li>
<li id="A4.I11.i10" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="A4.I11.i10.p1" class="ltx_para">
<p id="A4.I11.i10.p1.1" class="ltx_p">Standard deviation of prior : <math id="A4.I11.i10.p1.m1" class="ltx_Math" alttext="\{10^{-2},{5\times 10^{-2}},10^{-3},10^{-4}\}" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">{</mo><mrow><msup><mn>10</mn><mrow><mo>−</mo><mn>2</mn></mrow></msup><mo>,</mo><mrow><mn>5</mn><mo lspace="0.222em" rspace="0.222em">×</mo><msup><mn>10</mn><mrow><mo>−</mo><mn>2</mn></mrow></msup></mrow><mo>,</mo><msup><mn>10</mn><mrow><mo>−</mo><mn>3</mn></mrow></msup><mo>,</mo><msup><mn>10</mn><mrow><mo>−</mo><mn>4</mn></mrow></msup></mrow><mo stretchy="false">}</mo></mrow><annotation encoding="application/x-tex">\{10^{-2},{5\times 10^{-2}},10^{-3},10^{-4}\}</annotation></semantics></math></p>
</div></li>
<li id="A4.I11.i11" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="A4.I11.i11.p1" class="ltx_para">
<p id="A4.I11.i11.p1.1" class="ltx_p">Number of Monte Carlo sampling : 2000</p>
</div></li>
</ul>
<div class="ltx_pagination ltx_role_end_2_columns"></div>
</div>
<div id="A4.SS6.p3" class="ltx_para">
<p id="A4.SS6.p3.1" class="ltx_p"><span id="A4.SS6.p3.1.1" class="ltx_text ltx_font_bold">Hyperparameters for CIFAR10</span></p>
<div class="ltx_pagination ltx_role_start_2_columns"></div>
<ul id="A4.I12" class="ltx_itemize">
<li id="A4.I12.i1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="A4.I12.i1.p1" class="ltx_para">
<p id="A4.I12.i1.p1.1" class="ltx_p">Portion of pretraining set : <math id="A4.I12.i1.p1.m1" class="ltx_Math" alttext="\{60\%,70\%\}" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">{</mo><mrow><mn>60</mn><mo>%</mo></mrow><mo>,</mo><mrow><mn>70</mn><mo>%</mo></mrow><mo stretchy="false">}</mo></mrow><annotation encoding="application/x-tex">\{60\%,70\%\}</annotation></semantics></math></p>
</div></li>
<li id="A4.I12.i2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="A4.I12.i2.p1" class="ltx_para">
<p id="A4.I12.i2.p1.1" class="ltx_p">Number of pretraining epochs : 150</p>
</div></li>
<li id="A4.I12.i3" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="A4.I12.i3.p1" class="ltx_para">
<p id="A4.I12.i3.p1.1" class="ltx_p">Pretraining learning rate : <math id="A4.I12.i3.p1.m1" class="ltx_Math" alttext="0.05" display="inline" intent=":literal"><semantics><mn>0.05</mn><annotation encoding="application/x-tex">0.05</annotation></semantics></math></p>
</div></li>
<li id="A4.I12.i4" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="A4.I12.i4.p1" class="ltx_para">
<p id="A4.I12.i4.p1.1" class="ltx_p">Dropout probability : 0.2</p>
</div></li>
<li id="A4.I12.i5" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="A4.I12.i5.p1" class="ltx_para">
<p id="A4.I12.i5.p1.1" class="ltx_p">Optimizer : SGD</p>
</div></li>
<li id="A4.I12.i6" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="A4.I12.i6.p1" class="ltx_para">
<p id="A4.I12.i6.p1.1" class="ltx_p">Training learning rate : <math id="A4.I12.i6.p1.m1" class="ltx_Math" alttext="\{10^{-3},5\times 10^{-3},10^{-4}\}" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">{</mo><msup><mn>10</mn><mrow><mo>−</mo><mn>3</mn></mrow></msup><mo>,</mo><mrow><mn>5</mn><mo lspace="0.222em" rspace="0.222em">×</mo><msup><mn>10</mn><mrow><mo>−</mo><mn>3</mn></mrow></msup></mrow><mo>,</mo><msup><mn>10</mn><mrow><mo>−</mo><mn>4</mn></mrow></msup><mo stretchy="false">}</mo></mrow><annotation encoding="application/x-tex">\{10^{-3},5\times 10^{-3},10^{-4}\}</annotation></semantics></math></p>
</div></li>
<li id="A4.I12.i7" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="A4.I12.i7.p1" class="ltx_para">
<p id="A4.I12.i7.p1.1" class="ltx_p">Weight decay : <math id="A4.I12.i7.p1.m1" class="ltx_Math" alttext="10^{-4}" display="inline" intent=":literal"><semantics><msup><mn>10</mn><mrow><mo>−</mo><mn>4</mn></mrow></msup><annotation encoding="application/x-tex">10^{-4}</annotation></semantics></math></p>
</div></li>
<li id="A4.I12.i8" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="A4.I12.i8.p1" class="ltx_para">
<p id="A4.I12.i8.p1.1" class="ltx_p">Smoothing parameter <math id="A4.I12.i8.p1.m1" class="ltx_Math" alttext="\alpha" display="inline" intent=":literal"><semantics><mi>α</mi><annotation encoding="application/x-tex">\alpha</annotation></semantics></math> : <math id="A4.I12.i8.p1.m2" class="ltx_Math" alttext="10^{-3}" display="inline" intent=":literal"><semantics><msup><mn>10</mn><mrow><mo>−</mo><mn>3</mn></mrow></msup><annotation encoding="application/x-tex">10^{-3}</annotation></semantics></math></p>
</div></li>
<li id="A4.I12.i9" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="A4.I12.i9.p1" class="ltx_para">
<p id="A4.I12.i9.p1.1" class="ltx_p">Softmax : <math id="A4.I12.i9.p1.m1" class="ltx_Math" alttext="\{" display="inline" intent=":literal"><semantics><mo stretchy="false">{</mo><annotation encoding="application/x-tex">\{</annotation></semantics></math> Smoothed, Clamped<math id="A4.I12.i9.p1.m2" class="ltx_Math" alttext="\}" display="inline" intent=":literal"><semantics><mo stretchy="false">}</mo><annotation encoding="application/x-tex">\}</annotation></semantics></math></p>
</div></li>
<li id="A4.I12.i10" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="A4.I12.i10.p1" class="ltx_para">
<p id="A4.I12.i10.p1.1" class="ltx_p">Standard deviation of prior : <math id="A4.I12.i10.p1.m1" class="ltx_Math" alttext="\{10^{-2},{5\times 10^{-2}},10^{-3},10^{-4}\}" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">{</mo><mrow><msup><mn>10</mn><mrow><mo>−</mo><mn>2</mn></mrow></msup><mo>,</mo><mrow><mn>5</mn><mo lspace="0.222em" rspace="0.222em">×</mo><msup><mn>10</mn><mrow><mo>−</mo><mn>2</mn></mrow></msup></mrow><mo>,</mo><msup><mn>10</mn><mrow><mo>−</mo><mn>3</mn></mrow></msup><mo>,</mo><msup><mn>10</mn><mrow><mo>−</mo><mn>4</mn></mrow></msup></mrow><mo stretchy="false">}</mo></mrow><annotation encoding="application/x-tex">\{10^{-2},{5\times 10^{-2}},10^{-3},10^{-4}\}</annotation></semantics></math></p>
</div></li>
<li id="A4.I12.i11" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="A4.I12.i11.p1" class="ltx_para">
<p id="A4.I12.i11.p1.1" class="ltx_p">Number of Monte Carlo sampling : 5000</p>
</div></li>
</ul>
<div class="ltx_pagination ltx_role_end_2_columns"></div>
</div>
<figure id="A4.T4" class="ltx_table">
<figcaption class="ltx_caption ltx_centering"><span class="ltx_tag ltx_tag_table"><span id="A4.T4.3" class="ltx_text" style="font-size:90%;">Table S4</span>: </span><span id="A4.T4.4" class="ltx_text" style="font-size:90%;">Generalization bounds on the zero-one loss achieved via model distillation on Amazon polarity using model compression (MC) bounds. All metrics presented are in percents (%), except the size.</span></figcaption>
