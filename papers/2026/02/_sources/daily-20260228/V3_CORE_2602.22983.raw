<td id="S4.T5.2.1.4.4" class="ltx_td ltx_align_center">100</td>
<td id="S4.T5.2.1.4.5" class="ltx_td ltx_align_center">90</td>
<td id="S4.T5.2.1.4.6" class="ltx_td ltx_align_center">84</td></tr>
<tr id="S4.T5.2.1.5" class="ltx_tr">
<td id="S4.T5.2.1.5.1" class="ltx_td ltx_align_left">Qwen3</td>
