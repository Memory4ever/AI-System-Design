<td id="S4.T5.2.1.3.3" class="ltx_td ltx_align_center">100</td>
<td id="S4.T5.2.1.3.4" class="ltx_td ltx_align_center">88</td>
<td id="S4.T5.2.1.3.5" class="ltx_td ltx_align_center">92</td>
