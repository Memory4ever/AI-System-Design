<td id="A9.T11.2.2.2" class="ltx_td ltx_align_center ltx_border_t"><span id="A9.T11.2.2.2.1" class="ltx_text ltx_font_bold">GPT-4o</span></td>
<td id="A9.T11.2.2.3" class="ltx_td ltx_align_center ltx_border_t"><span id="A9.T11.2.2.3.1" class="ltx_text ltx_font_bold">DeepSeek-Reasoner</span></td></tr>
<tr id="A9.T11.2.3" class="ltx_tr">
