<td id="S6.T1.2.1.2" class="ltx_td ltx_align_center ltx_border_tt" style="padding-left:3.0pt;padding-right:3.0pt;"><span id="S6.T1.2.1.2.1" class="ltx_text ltx_font_smallcaps" style="font-size:90%;">FPS</span></td>
<td id="S6.T1.2.1.3" class="ltx_td ltx_align_center ltx_border_tt" style="padding-left:3.0pt;padding-right:3.0pt;"><span id="S6.T1.2.1.3.1" class="ltx_text ltx_font_smallcaps" style="font-size:90%;">BPF</span></td>
<td id="S6.T1.2.1.4" class="ltx_td ltx_align_center ltx_border_tt" style="padding-left:3.0pt;padding-right:3.0pt;"><span id="S6.T1.2.1.4.1" class="ltx_text ltx_font_smallcaps" style="font-size:90%;">CER<math id="S6.T1.m3" class="ltx_Math" alttext="\downarrow" display="inline" intent=":literal"><semantics><mo stretchy="false">↓</mo><annotation encoding="application/x-tex">\downarrow</annotation></semantics></math></span></td>
<td id="S6.T1.2.1.5" class="ltx_td ltx_align_center ltx_border_tt" style="padding-left:3.0pt;padding-right:3.0pt;"><span id="S6.T1.2.1.5.1" class="ltx_text ltx_font_smallcaps" style="font-size:90%;">SIM<math id="S6.T1.m4" class="ltx_Math" alttext="\uparrow" display="inline" intent=":literal"><semantics><mo stretchy="false">↑</mo><annotation encoding="application/x-tex">\uparrow</annotation></semantics></math></span></td>
<td id="S6.T1.2.1.6" class="ltx_td ltx_align_center ltx_border_tt" style="padding-left:3.0pt;padding-right:3.0pt;"><span id="S6.T1.2.1.6.1" class="ltx_text ltx_font_smallcaps" style="font-size:90%;">oMOS<math id="S6.T1.m5" class="ltx_Math" alttext="\uparrow" display="inline" intent=":literal"><semantics><mo stretchy="false">↑</mo><annotation encoding="application/x-tex">\uparrow</annotation></semantics></math></span></td></tr>
<tr id="S6.T1.2.2" class="ltx_tr">
<td id="S6.T1.2.2.1" class="ltx_td ltx_align_left ltx_border_t" style="padding-left:3.0pt;padding-right:3.0pt;"><span id="S6.T1.2.2.1.1" class="ltx_text ltx_font_smallcaps" style="font-size:90%;">Reference</span></td>
<td id="S6.T1.2.2.2" class="ltx_td ltx_align_center ltx_border_t" style="padding-left:3.0pt;padding-right:3.0pt;"><span id="S6.T1.2.2.2.1" class="ltx_text ltx_font_smallcaps" style="font-size:90%;">24k</span></td>
<td id="S6.T1.2.2.3" class="ltx_td ltx_align_center ltx_border_t" style="padding-left:3.0pt;padding-right:3.0pt;"><span id="S6.T1.2.2.3.1" class="ltx_text ltx_font_smallcaps" style="font-size:90%;">384</span></td>
<td id="S6.T1.2.2.4" class="ltx_td ltx_align_center ltx_border_t" style="padding-left:3.0pt;padding-right:3.0pt;"><span id="S6.T1.2.2.4.1" class="ltx_text ltx_font_smallcaps" style="font-size:90%;">0.00</span></td>
<td id="S6.T1.2.2.5" class="ltx_td ltx_align_center ltx_border_t" style="padding-left:3.0pt;padding-right:3.0pt;"><span id="S6.T1.2.2.5.1" class="ltx_text ltx_font_smallcaps" style="font-size:90%;">85.4</span></td>
<td id="S6.T1.2.2.6" class="ltx_td ltx_align_center ltx_border_t" style="padding-left:3.0pt;padding-right:3.0pt;"><span id="S6.T1.2.2.6.1" class="ltx_text ltx_font_smallcaps" style="font-size:90%;">3.17</span></td></tr>
<tr id="S6.T1.2.3" class="ltx_tr">
