<td id="A2.T4.2.2.1" class="ltx_td ltx_align_center ltx_border_t" style="padding-left:2.0pt;padding-right:2.0pt;"><span id="A2.T4.2.2.1.1" class="ltx_text ltx_font_bold">MKG-W</span></td>
