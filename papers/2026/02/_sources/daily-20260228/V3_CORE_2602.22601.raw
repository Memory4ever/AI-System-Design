<td id="S4.T3.5.1.10.2" class="ltx_td ltx_align_center ltx_border_b ltx_border_t" style="padding-left:2.0pt;padding-right:2.0pt;"><span id="S4.T3.5.1.10.2.1" class="ltx_text ltx_font_bold">77.84</span></td>
