<span id="A2.T2.5.5.2.1.1" class="ltx_p"><span id="A2.T2.5.5.2.1.1.1" class="ltx_text" style="font-size:90%;">Degree of positive homogeneity of the neural network </span><math id="A2.T2.m8" class="ltx_Math" alttext="\Phi" display="inline" intent=":literal"><semantics><mi mathsize="0.900em" mathvariant="normal">Φ</mi><annotation encoding="application/x-tex">\Phi</annotation></semantics></math></span>
</span></td></tr>
<tr id="A2.T2.5.6" class="ltx_tr">
<td id="A2.T2.5.6.1" class="ltx_td ltx_align_left" style="padding-top:0.9pt;padding-bottom:0.9pt;"><math id="A2.T2.m9" class="ltx_Math" alttext="{\bm{w}}_{t}" display="inline" intent=":literal"><semantics><msub><mi mathsize="0.900em">𝒘</mi><mi mathsize="0.900em">t</mi></msub><annotation encoding="application/x-tex">{\bm{w}}_{t}</annotation></semantics></math></td>
<td id="A2.T2.5.6.2" class="ltx_td ltx_nopad_r ltx_align_left" style="padding-top:0.9pt;padding-bottom:0.9pt;">
<span id="A2.T2.5.6.2.1" class="ltx_inline-block ltx_align_top">
<span id="A2.T2.5.6.2.1.1" class="ltx_p"><span id="A2.T2.5.6.2.1.1.1" class="ltx_text" style="font-size:90%;">Weight vector at iteration </span><math id="A2.T2.m10" class="ltx_Math" alttext="t" display="inline" intent=":literal"><semantics><mi mathsize="0.900em">t</mi><annotation encoding="application/x-tex">t</annotation></semantics></math></span>
