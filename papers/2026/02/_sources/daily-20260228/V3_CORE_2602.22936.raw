<td id="S1.T1.5.1.6.1.2.1" class="ltx_td ltx_nopad_r ltx_align_center"><span id="S1.T1.5.1.6.1.2.1.1" class="ltx_text" style="font-size:90%;">Metric</span></td></tr>
</table></td></tr>
<tr id="S1.T1.5.2" class="ltx_tr">
<td id="S1.T1.5.2.1" class="ltx_td ltx_align_center ltx_border_tt"><cite class="ltx_cite ltx_citemacro_citet"><a href="#bib.bib48" title="" class="ltx_ref">Hardt et al. (2016)</a></cite></td>
