ion":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Eluned Anne","familyName":"Smith","name":"Smith, Eluned Anne","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Alexandre","familyName":"Sousa","name":"Sousa, Alexandre","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Michael","familyName":"Spannowsky","name":"Spannowsky, Michael","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Sioni","familyName":"Summers","name":"Summers, Sioni","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yanwen","familyName":"Sun","name":"Sun, Yanwen","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Daniel Tapia","familyName":"Takaki","name":"Takaki, Daniel Tapia","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Antonino","familyName":"Tumeo","name":"Tumeo, Antonino","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Caterina","familyName":"Vernieri","name":"Vernieri, Caterina","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Belina","familyName":"von Krosigk","name":"von Krosigk, Belina","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yash","familyName":"Vora","name":"Vora, Yash","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Linyan","familyName":"Wan","name":"Wan, Linyan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Michael H. L. S.","familyName":"Wang","name":"Wang, Michael H. L. S.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Amanda","familyName":"Weinstein","name":"Weinstein, Amanda","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Andy","familyName":"White","name":"White, Andy","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Simon","familyName":"Williams","name":"Williams, Simon","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Felix","familyName":"Yu","name":"Yu, Felix","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Machine Learning on Heterogeneous, Edge, and Quantum Hardware for Particle Physics (ML-HEQUPP)"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Instrumentation and Detectors (physics.ins-det)","lang":"en","subjectScheme":"arXiv"},{"subject":"Hardware Architecture (cs.AR)","lang":"en","subjectScheme":"arXiv"},{"subject":"Signal Processing (eess.SP)","lang":"en","subjectScheme":"arXiv"},{"subject":"High Energy Physics - Experiment (hep-ex)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"FOS: Electrical engineering, electronic engineering, information engineering","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-24T18:03:32Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:00:58Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-03-10T22:55:19Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-03-12T00:14:17Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-07-24T21:13:48Z","dateType":"Submitted","dateInformation":"v3"},{"date":"2026-07-28T00:10:46Z","dateType":"Updated","dateInformation":"v3"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"3","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"The next generation of particle physics experiments will face a new era of challenges in data acquisition, due to unprecedented data rates and volumes along with extreme environments and operational constraints. Harnessing this data for scientific discovery demands real-time inference and decision-making, intelligent data reduction, and efficient processing architectures beyond current capabilities. Crucial to the success of this experimental paradigm are several emerging technologies, such as artificial intelligence and machine learning (AI/ML), silicon microelectronics, and the advent of quantum algorithms and processing. Their intersection includes areas of research such as low-power and low-latency devices for edge computing, heterogeneous accelerator systems, reconfigurable hardware, novel codesign and synthesis strategies, readout for cryogenic or high-radiation environments, and analog computing. This white paper presents a community-driven vision to identify and prioritize research and development opportunities in hardware-based ML systems and corresponding physics applications, contributing towards a successful transition to the new data frontier of fundamental science."},{"descriptionType":"Other","description":"123 pages, 53 figures"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.22248","contentUrl":null,"metadataVersion":2,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T02:41:59Z","registered":"2026-02-27T02:42:00Z","published":null,"updated":"2026-07-28T03:52:31Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.22535","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.22535","identifiers":[{"identifier":"2602.22535","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Zitong","familyName":"Yu","name":"Yu, Zitong","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Rongping","familyName":"Zeng","name":"Zeng, Rongping","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Frank","familyName":"Samuelson","name":"Samuelson, Frank","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Prabhat","familyName":"Kc","name":"Kc, Prabhat","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Evaluating the resolution of AI-based accelerated MR reconstruction using a deep learning-based model observer"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Medical Physics (physics.med-ph)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-26T02:15:12Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:16:22Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-04-17T04:34:01Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-04-20T00:24:43Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-07-24T18:35:07Z","dateType":"Submitted","dateInformation":"v3"},{"date":"2026-07-28T00:06:41Z","dateType":"Updated","dateInformation":"v3"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"3","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Deep Learning-based Model Observers (DLMOs) were developed to evaluate a multi-coil sensitivity encoding parallel MRI at different acceleration factors on the Rayleigh discrimination task as a surrogate measure of resolution. Gaussian-convolved singlet and doublet signals with varying intensities and lengths were inserted into the white matter of synthetic brain images. K-space data were generated using a simulated MRI at acceleration factors of one (1x, fully sampled), 4.9x, and 16.4x, and reconstructed using a conventional root-sum-of-squares (rSOS) method and an AI-based U-Net method. DLMOs were first trained on fully sampled images and then fine-tuned for each acceleration factor using transfer learning. With a human-label alignment training strategy, the DLMOs achieved discrimination performance similar to that of trained human observers. Resolution was assessed using the area under the receiver operating characteristic curve (AUC), while PSNR and SSIM provided complementary task-agnostic comparisons. Although the U-Net method yielded significantly higher PSNR and SSIM than rSOS across different acceleration factors (p\u0026lt;0.05), task-based evaluation using the proposed DLMO showed inferior performance relative to fully sampled reconstruction. U-Net (4.9x) exhibited modest gains over rSOS (4.9x) for short signals (4-5 mm), but its AUC decreased by approximately 25% and 5% for 4 mm and 5 mm signals, respectively, compared with rSOS (1x). Similar declines were observed for U-Net (16.4x). These results demonstrate that AI-based accelerated MR reconstruction may improve visual appearance, but may not preserve task performance. The proposed DLMO approach may be employed to characterize the discriminative efficacy of AI-based undersampled MRI reconstruction."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.22535","contentUrl":null,"metadataVersion":2,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T02:48:38Z","registered":"2026-02-27T02:48:39Z","published":null,"updated":"2026-07-28T03:52:31Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.23357","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.23357","identifiers":[{"identifier":"2602.23357","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Aheli","familyName":"Saha","name":"Saha, Aheli","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"René","familyName":"Schuster","name":"Schuster, René","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Didier","familyName":"Stricker","name":"Stricker, Didier","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Sensor Generalization for Adaptive Sensing in Event-based Object Detection via Joint Distribution Training"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-26T18:57:52Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-07-21T00:29:51Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[{"relationType":"IsVersionOf","relatedIdentifier":"10.5220/0014450400004067","relatedIdentifierType":"DOI"}],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Bio-inspired event cameras have recently attracted significant research due to their asynchronous and low-latency capabilities. These features provide a high dynamic range and significantly reduce motion blur. However, because of the novelty in the nature of their output signals, there is a gap in the variability of available data and a lack of extensive analysis of the parameters characterizing their signals. This paper addresses these issues by providing readers with an in-depth understanding of how intrinsic parameters affect the performance of a model trained on event data, specifically for object detection. We also use our findings to expand the capabilities of the downstream model towards sensor-agnostic robustness."},{"descriptionType":"Other","description":"12 pages, International Conference on Pattern Recognition Applications and Methods"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.23357","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":1,"created":"2026-02-27T03:08:52Z","registered":"2026-02-27T03:08:52Z","published":null,"updated":"2026-07-21T03:47:42Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.23204","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.23204","identifiers":[{"identifier":"2602.23204","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Roberto","familyName":"Pellerito","name":"Pellerito, Roberto","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Nico","familyName":"Messikommer","name":"Messikommer, Nico","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Giovanni","familyName":"Cioffi","name":"Cioffi, Giovanni","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Marco","familyName":"Cannici","name":"Cannici, Marco","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Davide","familyName":"Scaramuzza","name":"Scaramuzza, Davide","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Motion-aware Event Suppression for Event Cameras"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"Robotics (cs.RO)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-26T16:53:36Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:57:08Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02-27T14:24:26Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-03-02T01:48:11Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-06-01T08:06:13Z","dateType":"Submitted","dateInformation":"v3"},{"date":"2026-06-02T01:47:48Z","dateType":"Updated","dateInformation":"v3"},{"date":"2026-07-18T03:48:45Z","dateType":"Submitted","dateInformation":"v4"},{"date":"2026-07-21T00:19:49Z","dateType":"Updated","dateInformation":"v4"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"4","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Event cameras report asynchronously per-pixel brightness changes with microsecond latency, encoding dynamic visual information as a sparse stream of events. However, their extreme temporal resolution floods perception systems with entangled events from ego-motion and independently moving objects (IMOs), which existing solutions fail to efficiently decouple, relying instead on prohibitive dense 3D reconstructions or limited hand-tuned filters. In this work, we introduce the first framework for Motion-aware Event Suppression, which learns to filter events triggered by IMOs and ego-motion in real time. Our model jointly segments IMOs in the current event stream while predicting their future motion, enabling anticipatory suppression of dynamic events before they occur. Our lightweight architecture achieves 173 Hz inference on consumer-grade GPUs with less than 1 GB of memory usage, outperforming previous state-of-the-art methods on the challenging EVIMO benchmark by 67\\% in segmentation accuracy while operating at a 53\\% higher inference rate. Moreover, we demonstrate significant benefits for downstream applications: our method accelerates Vision Transformer inference by 83\\% via token pruning and improves event-based visual odometry accuracy, reducing Absolute Trajectory Error (ATE) by 13\\%."},{"descriptionType":"Other","description":"Robotics: Science and Systems (RSS) 2026"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.23204","contentUrl":null,"metadataVersion":3,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T03:05:01Z","registered":"2026-02-27T03:05:02Z","published":null,"updated":"2026-07-21T03:47:42Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.23179","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.23179","identifiers":[{"identifier":"2602.23179","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Gal","familyName":"Pomerants","name":"Pomerants, Gal","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yaniv","familyName":"Nikankin","name":"Nikankin, Yaniv","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Anja","familyName":"Reusch","name":"Reusch, Anja","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Tomer","familyName":"Tsaban","name":"Tsaban, Tomer","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ora","familyName":"Schueler-Furman","name":"Schueler-Furman, Ora","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yonatan","familyName":"Belinkov","name":"Belinkov, Yonatan","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Induction Meets Biology: Mechanisms of Repeat Detection in Protein Language Models"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"Biomolecules (q-bio.BM)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"FOS: Biological sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-26T16:39:04Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:56:20Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-03-14T10:40:33Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-03-17T00:45:00Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-05-24T10:43:11Z","dateType":"Submitted","dateInformation":"v3"},{"date":"2026-05-26T01:00:47Z","dateType":"Updated","dateInformation":"v3"},{"date":"2026-05-31T10:57:11Z","dateType":"Submitted","dateInformation":"v4"},{"date":"2026-06-02T01:08:08Z","dateType":"Updated","dateInformation":"v4"},{"date":"2026-07-19T14:54:34Z","dateType":"Submitted","dateInformation":"v5"},{"date":"2026-07-21T01:00:39Z","dateType":"Updated","dateInformation":"v5"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"5","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Protein sequences are abundant in repeating segments, both as exact copies and as approximate segments with mutations. These repeats are important for protein structure and function, motivating decades of algorithmic work on repeat identification. Recent work has shown that protein language models (PLMs) identify repeats, by examining their behavior in masked-token prediction. To elucidate their internal mechanisms, we investigate how PLMs detect both exact and approximate repeats. We find that the mechanism for approximate repeats functionally subsumes that of exact repeats. We then characterize this mechanism, revealing two main stages: PLMs first build feature representations using both general positional attention heads and biologically specialized components, such as neurons that encode amino-acid similarity. Then, induction heads attend to aligned tokens across repeated segments, promoting the correct answer. Our results reveal how PLMs solve this biological task by combining language-based pattern matching with specialized biological knowledge, thereby establishing a basis for studying more complex evolutionary processes in PLMs."},{"descriptionType":"Other","description":"Accepted at the 43rd International Conference on Machine Learning (ICML 2026)"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.23179","contentUrl":null,"metadataVersion":4,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T03:04:24Z","registered":"2026-02-27T03:04:24Z","published":null,"updated":"2026-07-21T03:47:41Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.23311","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.23311","identifiers":[{"identifier":"2602.23311","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Johannes","familyName":"Brachem","name":"Brachem, Johannes","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Paul F. V.","familyName":"Wiemann","name":"Wiemann, Paul F. V.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Matthias","familyName":"Katzfuss","name":"Katzfuss, Matthias","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Data-Efficient Generative Modeling of Non-Gaussian Global Climate Fields via Scalable Composite Transformations"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Methodology (stat.ME)","lang":"en","subjectScheme":"arXiv"},{"subject":"Applications (stat.AP)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-26T18:16:45Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T02:01:53Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-07-10T22:07:08Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-07-14T00:11:29Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Quantifying uncertainty in climate-model output requires characterizing internal variability, often through large ensembles of physical climate-model runs. Since each additional ensemble member is computationally expensive, only limited numbers of replicated fields are typically available under a fixed model configuration and forcing scenario. We propose a data-efficient stochastic generator for the internal variability of global climate fields, specifically designed to overcome these sample-size constraints. The framework targets the distribution of climate-model output under fixed forcing and model physics. Inspired by copula modeling, our approach constructs a highly expressive joint distribution via a composite transformation to a multivariate standard normal space. We combine a nonparametric Bayesian transport map for spatial dependence modeling with flexible, spatially varying marginal models, essential for capturing non-Gaussian behavior and heavy-tailed extremes. These marginals are defined by a parametric model followed by a semi-parametric B-spline correction to capture complex distributional features. The marginal parameters are spatially smoothed using Gaussian-process priors with low-rank approximations, rendering the computational cost linear in the spatial dimension. When applied to global log-precipitation-rate fields under fixed forcing at more than 50,000 grid locations, our stochastic surrogate achieves high fidelity, accurately quantifying the climate distribution's spatial dependence and marginal characteristics, including the tails. Using only 10 training fields, it outperforms a state-of-the-art competitor trained on 80 fields, effectively octupling the computational budget for climate research. We provide a Python implementation at https://github.com/jobrachem/ppptm ."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.23311","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":1,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T03:07:44Z","registered":"2026-02-27T03:07:45Z","published":null,"updated":"2026-07-14T04:01:53Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.23242","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.23242","identifiers":[{"identifier":"2602.23242","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Yegon","familyName":"Kim","name":"Kim, Yegon","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Juho","familyName":"Lee","name":"Lee, Juho","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"A Model-Free Universal AI"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-26T17:21:16Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:58:45Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-04-18T17:10:48Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-04-21T00:48:42Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-06-12T18:50:29Z","dateType":"Submitted","dateInformation":"v3"},{"date":"2026-06-16T00:06:24Z","dateType":"Updated","dateInformation":"v3"},{"date":"2026-07-13T16:29:31Z","dateType":"Submitted","dateInformation":"v4"},{"date":"2026-07-14T01:41:02Z","dateType":"Updated","dateInformation":"v4"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"4","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"In general reinforcement learning, all established optimal agents, including AIXI, are model-based, explicitly maintaining and using environment models. This paper introduces Universal AI with Q-Induction (AIQI), the first model-free agent proven to be asymptotically $\\varepsilon$-optimal in general RL. AIQI performs universal induction over distributional action-value functions, instead of policies or environments like previous works. Under a grain of truth condition, we prove that AIQI is strong asymptotically $\\varepsilon$-optimal and asymptotically $\\varepsilon$-Bayes-optimal. We also apply our novel proof techniques to show asymptotic $\\varepsilon$-optimality of Self-AIXI without any ad-hoc assumptions. Our results significantly expand the diversity of known universal agents."},{"descriptionType":"Other","description":"42nd Conference on Uncertainty in Artificial Intelligence (UAI 2026)"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.23242","contentUrl":null,"metadataVersion":3,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T03:06:02Z","registered":"2026-02-27T03:06:03Z","published":null,"updated":"2026-07-14T04:01:52Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.22867","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.22867","identifiers":[{"identifier":"2602.22867","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Qinfeng","familyName":"Zhu","name":"Zhu, Qinfeng","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yunxi","familyName":"Jiang","name":"Jiang, Yunxi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Lei","familyName":"Fan","name":"Fan, Lei","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"SO3UFormer: Learning Intrinsic Spherical Features for Rotation-Robust Panoramic Dense Prediction"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-26T11:07:51Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:39:07Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-07-12T14:21:52Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-07-14T00:52:30Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Panoramic dense-prediction models, spanning semantic segmentation and depth estimation, are typically trained under a strict gravity-aligned assumption. Real-world captures, however, routinely violate it: handheld devices jitter and aerial platforms change attitude, so the camera is rarely upright. Under such 3D reorientation, standard spherical Transformers overfit global latitude cues and collapse. We introduce SO3UFormer, an architecture that learns intrinsic spherical features largely decoupled from the underlying coordinate frame, through three geometric components: (1) removing absolute latitude encoding, which breaks the dependence on the gravity axis; (2) quadrature-consistent spherical attention, which corrects for non-uniform sampling density; and (3) a gauge-aware relative positional bias built from local tangent-plane angles rather than global axes. A logit-space \\emph{SO(3)}-consistency regularizer, used only during training, further suppresses residual discretization effects. To benchmark robustness, we introduce Pose35, a variant of Stanford2D3D perturbed by random rotations within $\\pm 35^\\circ$, and evaluate under a full, arbitrary \\emph{SO(3)} stress test. There, the baseline SphereUFormer collapses from 67.53 \\emph{mIoU} on Pose35 to 25.26 under the full \\emph{SO(3)} test, whereas SO3UFormer reaches 72.03 on Pose35 and retains 70.67 under the same test. Similarly, on a second real-world dataset (Matterport3D) for segmentation and on panoramic depth estimation, SO3UFormer remains essentially rotation-invariant while the gravity-anchored baseline again loses most of its accuracy. Code and models are available at https://github.com/zhuqinfeng1999/SO3UFormer."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.22867","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T02:56:44Z","registered":"2026-02-27T02:56:44Z","published":null,"updated":"2026-07-14T04:01:51Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.22911","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.22911","identifiers":[{"identifier":"2602.22911","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Hung-Hsuan","familyName":"Chen","name":"Chen, Hung-Hsuan","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"CeRA: Breaking the Linear Ceiling of Low-Rank Adaptation with Non-linearity Retained at Inference"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-26T11:55:25Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:41:18Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-03-02T22:35:44Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-03-04T01:11:32Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-03-09T06:40:14Z","dateType":"Submitted","dateInformation":"v3"},{"date":"2026-03-10T01:45:39Z","dateType":"Updated","dateInformation":"v3"},{"date":"2026-03-18T23:49:58Z","dateType":"Submitted","dateInformation":"v4"},{"date":"2026-03-20T00:23:58Z","dateType":"Updated","dateInformation":"v4"},{"date":"2026-04-03T08:37:26Z","dateType":"Submitted","dateInformation":"v5"},{"date":"2026-04-06T00:31:53Z","dateType":"Updated","dateInformation":"v5"},{"date":"2026-06-25T08:16:33Z","dateType":"Submitted","dateInformation":"v6"},{"date":"2026-06-26T00:33:41Z","dateType":"Updated","dateInformation":"v6"},{"date":"2026-07-09T08:44:52Z","dateType":"Submitted","dateInformation":"v7"},{"date":"2026-07-10T00:29:11Z","dateType":"Updated","dateInformation":"v7"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"7","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Low-Rank Adaptation (LoRA) dominates parameter-efficient fine-tuning (PEFT). However, it faces a ``linear ceiling'': increasing the rank yields diminishing returns in expressive capacity due to linear constraints. We introduce CeRA (Capacity-enhanced Rank Adaptation), a weight-level parallel adapter that injects SiLU gating and dropout to induce non-linearity during inference, thereby placing it in a different function class from adapters whose non-linearity exists during training and collapses to an affine map at inference time. On both the basic arithmetic (GSM8K) and the complex MATH benchmark, CeRA is markedly more parameter-efficient. Across a full rank $\\times$ learning rate sweep, CeRA at rank 64 achieves the highest MATH pass@1 of any configuration in the grid (23.6\\%), matching or exceeding both a rank-512 LoRA (22.4\\%) and DoRA (19.8\\%) while using only 1/8 of the parameter budget. With the rank and learning rate fixed, CeRA equals or outperforms LoRA in 10 of 12 matched settings. Spectrally, CeRA's learned updates utilize the singular-value spectrum more broadly than linear adapters, which exhibit rank collapse at high rank, although a scale-matched control shows that this difference stems mostly from output scale and partially from non-linearity. Additionally, dropout appears to contribute to regularization rather than rank expansion. We release the code for reproducibility: https://github.com/hhchen1105/cera."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.22911","contentUrl":null,"metadataVersion":6,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T02:57:46Z","registered":"2026-02-27T02:57:47Z","published":null,"updated":"2026-07-10T01:56:51Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.23128","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.23128","identifiers":[{"identifier":"2602.23128","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Mathieu","familyName":"Bazinet","name":"Bazinet, Mathieu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Valentina","familyName":"Zantedeschi","name":"Zantedeschi, Valentina","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Pascal","familyName":"Germain","name":"Germain, Pascal","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Bound to Disagree: Generalization Bounds via Certifiable Surrogates"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-26T15:42:13Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T03:33:34Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-07-07T21:35:02Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-07-09T00:08:57Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Generalization bounds for deep learning models are typically vacuous, not computable or restricted to specific model classes. In this paper, we tackle these issues by providing new disagreement-based certificates for the gap between the true risk of any two predictors. We then bound the true risk of the predictor of interest via a surrogate model that enjoys tight generalization guarantees, and by evaluating our disagreement bound on an unlabeled dataset.We empirically demonstrate the tightness of the obtained certificates and showcase the versatility of the approach by training surrogate models leveraging three different frameworks: sample compression, model compression and PAC-Bayes theory. Importantly, such guarantees are achieved without modifying the target model, nor adapting the training procedure to the generalization framework."},{"descriptionType":"Other","description":"Published in the 42nd conference on Uncertainty in Artificial Intelligence"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.23128","contentUrl":null,"metadataVersion":2,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T03:03:05Z","registered":"2026-02-27T03:03:06Z","published":null,"updated":"2026-07-09T02:04:30Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.22590","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.22590","identifiers":[{"identifier":"2602.22590","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Chengyu","familyName":"Cui","name":"Cui, Chengyu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yunxiao","familyName":"Chen","name":"Chen, Yunxiao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jing","familyName":"Ouyang","name":"Ouyang, Jing","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Gongjun","familyName":"Xu","name":"Xu, Gongjun","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Beyond Vintage Rotation: Bias-Free Sparse Representation Learning with Oracle Inference"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Methodology (stat.ME)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-26T03:49:25Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:21:45Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-07-08T10:49:23Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-07-09T00:36:48Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Learning low-dimensional latent representations is a central topic in statistics and machine learning, and rotation methods have long been used to obtain sparse and interpretable representations. Despite nearly a century of widespread use across many fields, rigorous guarantees for valid inference for the learned representation remain lacking. In this paper, we identify a surprisingly prevalent phenomenon that suggests a reason for this gap: for a broad class of vintage rotations, the resulting estimators exhibit a non-estimable bias. Because this bias is independent of the data, it fundamentally precludes the development of valid inferential procedures, including the construction of confidence intervals and hypothesis testing. To address this challenge, we propose a novel bias-free rotation method within a general representation learning framework based on latent variables. We establish an oracle inference property for the learned sparse representations: the estimators achieve the same asymptotic variance as in the ideal setting where the latent variables are observed. To bridge the gap between theory and computation, we develop an efficient computational framework and prove that its output estimators retain the same oracle property. Our results provide a rigorous inference procedure for the rotated estimators, yielding statistically valid and interpretable representation learning. Code for implementing the proposed method is available at the GitHub repository: https://github.com/chengyu06/Folomin.git."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.22590","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T02:49:56Z","registered":"2026-02-27T02:49:57Z","published":null,"updated":"2026-07-09T02:04:29Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.22600","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.22600","identifiers":[{"identifier":"2602.22600","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Joshua S.","familyName":"Schiffman","name":"Schiffman, Joshua S.","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Transformers converge to invariant algorithmic cores"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-26T04:09:11Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:22:41Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-07-06T18:07:55Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-07-08T00:02:59Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Training selects for behavior, not circuitry: many weight configurations can implement the same function. Studying any single trained neural network thus risks describing accidents of one training run rather than the computation itself. This work shifts focus from what transformers happen to do to what they must do by extracting algorithmic cores, compact subspaces that are necessary and sufficient for a task and that recur across independently trained models. Here, Algorithmic Core Extraction (ACE) is introduced to isolate these subspaces, causally validate them, and recover the algorithms they implement across settings ranging from synthetic tasks to large-scale pretrained models. Markov-chain transformers embed three-dimensional cores in nearly orthogonal subspaces yet recover identical transition spectra. Modular-addition transformers form compact cyclic cores at grokking that later inflate under continued regularization, redundantly distributing the same computation across many functionally equivalent modes. This functional redundancy is found to accelerate the transition from memorization to generalization, yielding an inverse scaling law for grokking time. In six language models spanning more than two orders of magnitude in scale (GPT-2 Small/Medium/Large, LLaMA-3.1, Gemma-2, and Qwen2.5), subject-verb agreement is governed by a single, steerable axis that aligns across architectures. Flipping this axis inverts grammatical number throughout open-ended generation. Together these results suggest that beneath the apparent complexity of trained transformers lies a simpler, shared computational structure, and that targeting invariants rather than parameterizations may offer a more tractable path to mechanistic understanding and control.\n Code: https://github.com/joshseth/cores"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.22600","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T02:50:10Z","registered":"2026-02-27T02:50:11Z","published":null,"updated":"2026-07-08T02:11:29Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.23269","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.23269","identifiers":[{"identifier":"2602.23269","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Ashley","familyName":"Babjac","name":"Babjac, Ashley","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Adrienne","familyName":"Hoarfrost","name":"Hoarfrost, Adrienne","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"An Active Learning Framework for Data-Efficient, Human-in-the-Loop Enzyme Function Prediction"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Quantitative Methods (q-bio.QM)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Biological sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-26T17:42:06Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T02:00:04Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-07-02T20:45:04Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-07-07T00:08:43Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Generalizable protein function prediction is increasingly constrained by the growing mismatch between exponentially expanding sequences of environmental proteins and the comparatively slow accumulation of experimentally verified functional data. Active learning offers a promising path forward for accelerating biological function prediction, by selecting the most informative proteins to experimentally annotate for data-efficient training, yet its potential remains largely unexplored. We introduce HATTER (Human-in-the-loop Adaptive Toolkit for Transferable Enzyme Representations), a modular framework that integrates multiple active learning strategies with human-in-the-loop experimental annotation to efficiently fine tune function prediction models. We compare active learning training to standard supervised training for biological enzyme function prediction, demonstrating that active learning achieves performance comparable to standard training across diverse protein sequence evaluation datasets while requiring fewer model updates, processing less data, and substantially reducing computational cost."},{"descriptionType":"Other","description":"6 pages, 3 figures, 1 table, accepted at ACM BCB 2026"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.23269","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T03:06:43Z","registered":"2026-02-27T03:06:43Z","published":null,"updated":"2026-07-07T05:03:55Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.23148","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.23148","identifiers":[{"identifier":"2602.23148","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Nitin","familyName":"Gupta","name":"Gupta, Nitin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Vishal","familyName":"Pallagani","name":"Pallagani, Vishal","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"John A.","familyName":"Aydin","name":"Aydin, John A.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Biplav","familyName":"Srivastava","name":"Srivastava, Biplav","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"On Sample-Efficient Generalized Planning via Learned Transition Models"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-26T16:13:46Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:54:44Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-03-08T23:27:22Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-03-10T01:29:57Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-03-20T02:31:49Z","dateType":"Submitted","dateInformation":"v3"},{"date":"2026-07-07T02:26:39Z","dateType":"Updated","dateInformation":"v3"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[{"relationType":"IsVersionOf","relatedIdentifier":"10.1609/icaps.v36i1.42888","relatedIdentifierType":"DOI"}],"relatedItems":[],"sizes":[],"formats":[],"version":"3","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Generalized planning studies the construction of solution strategies that generalize across families of planning problems sharing a common domain model, formally defined by a transition function $γ: S \\times A \\rightarrow S$. Classical approaches achieve such generalization through symbolic abstractions and explicit reasoning over $γ$. In contrast, recent Transformer-based planners, such as PlanGPT and Plansformer, largely cast generalized planning as direct action-sequence prediction, bypassing explicit transition modeling. While effective on in-distribution instances, these approaches typically require large datasets and model sizes, and often suffer from state drift in long-horizon settings due to the absence of explicit world-state evolution. In this work, we formulate generalized planning as a transition-model learning problem, in which a neural model explicitly approximates the successor-state function $\\hatγ \\approx γ$ and generates plans by rolling out symbolic state trajectories. Instead of predicting actions directly, the model autoregressively predicts intermediate world states, thereby learning the domain dynamics as an implicit world model. To study size-invariant generalization and sample efficiency, we systematically evaluate multiple state representations and neural architectures, including relational graph encodings. Our results show that learning explicit transition models yields higher out-of-distribution satisficing-plan success than direct action-sequence prediction in multiple domains, while achieving these gains with significantly fewer training instances and smaller models. This is an extended version of a short paper accepted at ICAPS 2026 under the same title."},{"descriptionType":"Other","description":"14 pages; Extended version of short paper accepted at ICAPS 2026; updated with results and analysis"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.23148","contentUrl":null,"metadataVersion":3,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":1,"created":"2026-02-27T03:03:36Z","registered":"2026-02-27T03:03:37Z","published":null,"updated":"2026-07-07T05:03:54Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.22545","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.22545","identifiers":[{"identifier":"2602.22545","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Agamdeep S.","familyName":"Chopra","name":"Chopra, Agamdeep S.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Caitlin","familyName":"Neher","name":"Neher, Caitlin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Tianyi","familyName":"Ren","name":"Ren, Tianyi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Juampablo E. Heras","familyName":"Rivera","name":"Rivera, Juampablo E. Heras","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Hesamoddin","familyName":"Jahanian","name":"Jahanian, Hesamoddin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Mehmet","familyName":"Kurt","name":"Kurt, Mehmet","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"SFL-Net: Source-Factorized Latent Representation Learning for Multi-Contrast MRI to Tau-PET Synthesis"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"I.2.10; I.4.8","lang":"en","subjectScheme":"ACM"}],"contributors":[],"dates":[{"date":"2026-02-26T02:37:38Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:17:34Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-04-08T22:09:04Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-04-10T00:12:25Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-07-03T00:03:22Z","dateType":"Submitted","dateInformation":"v3"},{"date":"2026-07-07T00:12:29Z","dateType":"Updated","dateInformation":"v3"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"3","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Tau positron emission tomography supports Alzheimer's disease staging but is difficult to scale because of tracer, scanner, and radiation constraints. Synthesis from structural MRI is therefore attractive, but it is a particularly difficult setting. T1-weighted and FLAIR MRI provide anatomy and disease correlated morphology, but they do not directly measure Tau-PET relevant signal. We introduce SFL-Net, a multi-input synthesis framework that predicts Tau-PET from T1-weighted and FLAIR MRI. SFL-Net factorizes the latent representation into shared, T1-specific, FLAIR-specific, and complementary pathways and preserves anatomical detail through latent structural conditioning rather than direct encoder-decoder connections. We evaluated SFL-Net and baseline models using 605 training and 83 validation subjects from ADNI-3 and OASIS-3 datasets. Evaluation included raw image fidelity, standardized uptake value ratio agreement, high uptake overlap, regional Bland-Altman bias, braak derived stage agreement, non-inferiority sensitivity analysis, and latent component Shapley attribution. SFL-Net performed competitively on both clinically relevant and reconstruction metrics, while also delivering explicit source level auditability that conventional UNet derived models lack."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.22545","contentUrl":null,"metadataVersion":2,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T02:48:52Z","registered":"2026-02-27T02:48:53Z","published":null,"updated":"2026-07-07T05:03:51Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.23056","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.23056","identifiers":[{"identifier":"2602.23056","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Giona","familyName":"Fieni","name":"Fieni, Giona","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Joschua","familyName":"Wüthrich","name":"Wüthrich, Joschua","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Marc-Philippe","familyName":"Neumann","name":"Neumann, Marc-Philippe","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Christopher H.","familyName":"Onder","name":"Onder, Christopher H.","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Learning-based Multi-agent Race Strategies in Formula 1"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"Systems and Control (eess.SY)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"FOS: Electrical engineering, electronic engineering, information engineering","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-26T14:41:29Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:49:31Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-07-02T15:18:11Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-07-03T00:58:35Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"In Formula 1, race strategies are adapted according to evolving race conditions and competitors' actions. This paper proposes a reinforcement learning approach for multi-agent race strategy optimization. Agents learn to balance energy management, tire degradation, aerodynamic interaction, and pit-stop decisions. Building on a pre-trained single-agent policy, we introduce an interaction module that accounts for the behavior of competitors. The combination of the interaction module and a self-play training scheme generates competitive policies, and agents are ranked based on their relative performance. Results show that the agents adapt pit timing, tire selection, and energy allocation in response to opponents, achieving robust and consistent race performance. Because the framework relies only on information available during real races, it can support race strategists' decisions before and during races."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.23056","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T03:01:24Z","registered":"2026-02-27T03:01:24Z","published":null,"updated":"2026-07-03T02:15:42Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.23142","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.23142","identifiers":[{"identifier":"2602.23142","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Zeno","familyName":"Romero","name":"Romero, Zeno","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Kerstin","familyName":"Münnemann","name":"Münnemann, Kerstin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Hans","familyName":"Hasse","name":"Hasse, Hans","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Fabian","familyName":"Jirasek","name":"Jirasek, Fabian","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Prediction of Diffusion Coefficients in Mixtures with Tensor Completion"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-26T16:08:50Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-07-03T00:30:40Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[{"relationType":"IsVersionOf","relatedIdentifier":"10.1039/d6cp00732e","relatedIdentifierType":"DOI"}],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Predicting diffusion coefficients in mixtures is crucial for many applications, as experimental data remain scarce, and machine learning (ML) offers promising alternatives to established semi-empirical models. Among ML models, matrix completion methods (MCMs) have proven effective in predicting thermophysical properties, including diffusion coefficients in binary mixtures. However, MCMs are restricted to single-temperature predictions, and their accuracy depends strongly on the availability of high-quality experimental data for each temperature of interest. In this work, we address this challenge by presenting a hybrid tensor completion method (TCM) for predicting temperature-dependent diffusion coefficients at infinite dilution in binary mixtures. The TCM employs a Tucker decomposition and is jointly trained on experimental data for diffusion coefficients at infinite dilution in binary systems at 298 K, 313 K, and 333 K. Predictions from the semi-empirical SEGWE model serve as prior knowledge within a Bayesian training framework. The TCM then extrapolates linearly to any temperature between 268 K and 378 K, achieving markedly improved prediction accuracy compared to established models across all studied temperatures. To further enhance predictive performance, the experimental database was expanded using active learning (AL) strategies for targeted acquisition of new diffusion data by pulsed-field gradient (PFG) NMR measurements. Diffusion coefficients at infinite dilution in 19 solute + solvent systems were measured at 298 K, 313 K, and 333 K. Incorporating these results yields a substantial improvement in the TCM's predictive accuracy. These findings highlight the potential of combining data-efficient ML methods with adaptive experimentation to advance predictive modeling of transport properties."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.23142","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":1,"created":"2026-02-27T03:03:27Z","registered":"2026-02-27T03:03:28Z","published":null,"updated":"2026-07-03T02:15:42Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.22897","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.22897","identifiers":[{"identifier":"2602.22897","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Xiaoxi","familyName":"Li","name":"Li, Xiaoxi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Wenxiang","familyName":"Jiao","name":"Jiao, Wenxiang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jiarui","familyName":"Jin","name":"Jin, Jiarui","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Haoxuan","familyName":"Li","name":"Li, Haoxuan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Hao","familyName":"Wang","name":"Wang, Hao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Shijian","familyName":"Wang","name":"Wang, Shijian","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Guanting","familyName":"Dong","name":"Dong, Guanting","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jiajie","familyName":"Jin","name":"Jin, Jiajie","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yinuo","familyName":"Wang","name":"Wang, Yinuo","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yuan","familyName":"Lu","name":"Lu, Yuan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ji-Rong","familyName":"Wen","name":"Wen, Ji-Rong","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zhicheng","familyName":"Dou","name":"Dou, Zhicheng","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zhouchen","familyName":"Lin","name":"Lin, Zhouchen","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"OmniGAIA: Towards Native Omni-Modal AI Agents"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"Multimedia (cs.MM)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-26T11:35:04Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:40:38Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02-28T12:27:12Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-03-03T01:39:42Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-07-02T15:39:17Z","dateType":"Submitted","dateInformation":"v3"},{"date":"2026-07-03T00:59:52Z","dateType":"Updated","dateInformation":"v3"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"3","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Human intelligence naturally intertwines omni-modal perception -- spanning vision, audio, and language -- with complex reasoning and tool usage to interact with the world. However, current multi-modal LLMs are primarily confined to bi-modal interactions (e.g., vision-language), lacking the unified cognitive capabilities required for general AI assistants. To bridge this gap, we introduce OmniGAIA, a comprehensive benchmark designed to evaluate omni-modal agents on tasks necessitating deep reasoning and multi-turn tool execution across video, audio, and image modalities. Constructed via a novel omni-modal event graph approach, OmniGAIA synthesizes complex, multi-hop queries derived from real-world data that require cross-modal reasoning and external tool integration. Furthermore, we propose OmniAtlas, a native omni-modal foundation agent under tool-integrated reasoning paradigm with active omni-modal perception. Trained on trajectories synthesized via a hindsight-guided tree exploration strategy and OmniDPO for fine-grained error correction, OmniAtlas effectively enhances the tool-use capabilities of existing open-source models. This work marks a step towards next-generation native omni-modal AI assistants for real-world scenarios."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.22897","contentUrl":null,"metadataVersion":2,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T02:57:25Z","registered":"2026-02-27T02:57:26Z","published":null,"updated":"2026-07-03T02:15:41Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.23164","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.23164","identifiers":[{"identifier":"2602.23164","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Aviral","familyName":"Chawla","name":"Chawla, Aviral","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Galen","familyName":"Hall","name":"Hall, Galen","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Juniper","familyName":"Lovato","name":"Lovato, Juniper","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"MetaOthello: A Controlled Study of Multiple World Models in Transformers"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-26T16:28:09Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:55:18Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-07-01T01:34:38Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-07-02T00:14:48Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Foundation models must handle multiple generative processes, yet mechanistic interpretability largely studies capabilities in isolation; it remains unclear how a single transformer organizes multiple, potentially conflicting \"world models\". Previous experiments on Othello playing neural-networks test world-model learning but focus on a single game with a single set of rules. We introduce MetaOthello, a controlled suite of Othello variants with shared syntax but different rules or tokenizations, and train small GPTs on mixed-variant data to study how multiple world models are organized in a shared representation space. We find that transformers trained on mixed-game data do not partition their capacity into isolated sub-models; instead, they converge on a mostly shared board-state representation that transfers causally across variants. Linear probes trained on one variant can intervene on another's internal state with effectiveness approaching that of matched probes. For isomorphic games with token remapping, representations are equivalent up to a single orthogonal rotation that generalizes across layers. When rules partially overlap, early layers maintain game-agnostic representations while a middle layer identifies game identity, and later layers specialize. MetaOthello offers a path toward understanding not just whether transformers learn world models, but how they organize many at once."},{"descriptionType":"Other","description":"Camera-ready version. Accepted to the 43rd International Conference on Machine Learning (ICML 2026)"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.23164","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T03:04:00Z","registered":"2026-02-27T03:04:01Z","published":null,"updated":"2026-07-02T02:13:32Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.22428","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.22428","identifiers":[{"identifier":"2602.22428","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Daniel","familyName":"Geyfman","name":"Geyfman, Daniel","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Felix","familyName":"Draxler","name":"Draxler, Felix","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jan","familyName":"Groeneveld","name":"Groeneveld, Jan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Hyunsoo","familyName":"Lee","name":"Lee, Hyunsoo","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Theofanis","familyName":"Karaletsos","name":"Karaletsos, Theofanis","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Stephan","familyName":"Mandt","name":"Mandt, Stephan","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Calibrated Test-Time Guidance for Bayesian Inference"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-25T21:38:47Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:09:14Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-06-30T19:32:14Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-07-02T00:02:16Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Test-time guidance is a widely used mechanism for steering pretrained diffusion models toward outcomes specified by a reward function. Existing approaches, however, focus on maximizing reward rather than sampling from the true Bayesian posterior, leading to miscalibrated inference. In this work, we show that common test-time guidance methods do not recover the correct posterior distribution and identify the structural approximations responsible for this failure. We then propose consistent alternative estimators that enable calibrated sampling from the Bayesian posterior. We significantly outperform previous methods on a set of Bayesian inference tasks, and set a new state-of-the-art PSNR in black hole image reconstruction."},{"descriptionType":"Other","description":"Accepted to ICML 2026. Code is available at https://github.com/mandt-lab/Calibrated-Guidance"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.22428","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T02:46:09Z","registered":"2026-02-27T02:46:10Z","published":null,"updated":"2026-07-02T02:13:31Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.23294","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.23294","identifiers":[{"identifier":"2602.23294","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Xin","familyName":"Gu","name":"Gu, Xin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Bing","familyName":"Fan","name":"Fan, Bing","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jiali","familyName":"Yao","name":"Yao, Jiali","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zhipeng","familyName":"Zhang","name":"Zhang, Zhipeng","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yan","familyName":"Huang","name":"Huang, Yan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Cheng","familyName":"Han","name":"Han, Cheng","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Heng","familyName":"Fan","name":"Fan, Heng","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Libo","familyName":"Zhang","name":"Zhang, Libo","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Towards Long-Form Spatio-Temporal Video Grounding"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-26T18:04:09Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T02:01:03Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-06-27T17:17:31Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-06-30T00:42:04Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"In real scenarios, videos can span several minutes or even hours. However, existing research on spatio-temporal video grounding (STVG), given a textual query, mainly focuses on localizing targets in short videos of tens of seconds, typically less than one minute, which limits real-world applications. In this paper, we explore Long-Form STVG (LF-STVG), which aims to locate targets in long-term videos. Compared with short videos, long-term videos contain much longer temporal spans and more irrelevant information, making it difficult for existing STVG methods that process all frames at once. To address this challenge, we propose an AutoRegressive Transformer architecture for LF-STVG, termed ART-STVG. Unlike conventional STVG methods that require the entire video sequence to make predictions at once, ART-STVG treats the video as streaming input and processes frames sequentially, enabling efficient handling of long videos. To model spatio-temporal context, we design spatial and temporal memory banks and apply them to the decoders. Since memories from different moments are not always relevant to the current frame, we introduce simple yet effective memory selection strategies to provide more relevant information to the decoders, significantly improving performance. Furthermore, instead of parallel spatial and temporal localization, we propose a cascaded spatio-temporal design that connects the spatial decoder to the temporal decoder, allowing fine-grained spatial cues to assist complex temporal localization in long videos. Experiments on newly extended LF-STVG datasets show that ART-STVG significantly outperforms state-of-the-art methods, while achieving competitive performance on conventional short-form STVG. Our code is at: https://github.com/HengLan/ART-STVG."},{"descriptionType":"Other","description":"22 pages, 11 figures. Accepted to ECCV 2026"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.23294","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T03:07:21Z","registered":"2026-02-27T03:07:21Z","published":null,"updated":"2026-06-30T04:11:26Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.23353","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.23353","identifiers":[{"identifier":"2602.23353","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Simon","familyName":"Roschmann","name":"Roschmann, Simon","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Paul","familyName":"Krzakala","name":"Krzakala, Paul","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Sonia","familyName":"Mazelet","name":"Mazelet, Sonia","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Quentin","familyName":"Bouniot","name":"Bouniot, Quentin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zeynep","familyName":"Akata","name":"Akata, Zeynep","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"SOTAlign: Semi-Supervised Alignment of Unimodal Vision and Language Models via Optimal Transport"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-26T18:55:06Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T02:03:36Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-06-29T15:37:39Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-06-30T02:07:16Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"The Platonic Representation Hypothesis posits that neural networks trained on different modalities converge toward a shared statistical model of the world. Recent work exploits this convergence by aligning frozen pretrained vision and language models with lightweight alignment layers, but typically relies on contrastive losses and millions of paired samples. In this work, we ask whether meaningful alignment can be achieved with substantially less supervision. We introduce a semi-supervised setting in which pretrained unimodal encoders are aligned using a small number of image-text pairs together with large amounts of unpaired data. To address this challenge, we propose SOTAlign, a two-stage framework that first recovers a coarse shared geometry from limited paired data using a linear teacher, and then refines the alignment on unpaired samples via an optimal-transport-based divergence that transfers relational structure without overconstraining the target space. SOTAlign effectively leverages unpaired images and text, learning robust joint embeddings across datasets and encoder pairs, and significantly outperforming supervised and semi-supervised baselines. Code is available at https://github.com/ExplainableML/SOTAlign."},{"descriptionType":"Other","description":"ICML 2026"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.23353","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T03:08:46Z","registered":"2026-02-27T03:08:47Z","published":null,"updated":"2026-06-30T04:11:26Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.23135","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.23135","identifiers":[{"identifier":"2602.23135","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Tyler","familyName":"Bonnet","name":"Bonnet, Tyler","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Marek","familyName":"Rei","name":"Rei, Marek","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"DyGnROLE: Asymmetric Pretraining for Edge Classification on Dynamic Graphs"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"Social and Information Networks (cs.SI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-26T15:51:51Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:53:58Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-06-27T09:53:28Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-06-30T00:30:40Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Edge classification on directed dynamic graphs requires modeling interactions between source and destination nodes exhibiting asymmetrical behavioral patterns and temporal dynamics. However, existing dynamic graph architectures largely rely on shared parameters for processing source and destination nodes, with limited or no systematic role-aware modeling. We propose DyGnROLE (Dynamic Graph Node-Role-Oriented Latent Encoding), a Transformer-based architecture that disentangles source and destination representations. By using separate embedding tables and role-semantic positional encodings, the model captures the distinct structural and temporal contexts unique to each role. Critical in limited-label settings, which are common in edge classification, is a self-supervised pretraining objective we introduce: Directional Role Alignment (DRA). DRA learns distinct but aligned source and destination embedding spaces by training source representations to retrieve their corresponding destination representations while a historical positive masking strategy excludes previously observed interactions from future negative comparisons. The masks introduce a temporally directional training signal in which node pairs progress monotonically from unseen to observed, after which the relationship is eligible only for further alignment. A comprehensive evaluation on four edge classification tasks across eight datasets demonstrates that DyGnROLE consistently outperforms a wide range of state-of-the-art baselines, highlighting the importance of role-aware representation learning and asymmetric pretraining for modeling complex directed interactions when labeled data is limited."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.23135","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T03:03:16Z","registered":"2026-02-27T03:03:17Z","published":null,"updated":"2026-06-30T04:11:25Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.23171","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.23171","identifiers":[{"identifier":"2602.23171","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Wanting","familyName":"Huang","name":"Huang, Wanting","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Weiran","familyName":"Wang","name":"Wang, Weiran","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Align-Consistency: Improving Non-autoregressive and Semi-supervised ASR with Consistency Regularization"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Audio and Speech Processing (eess.AS)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Electrical engineering, electronic engineering, information engineering","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-26T16:34:30Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:55:41Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-06-27T04:40:18Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-06-30T00:22:40Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Consistency regularization (CR) improves the robustness and accuracy of Connectionist Temporal Classification (CTC) by ensuring predictions remain stable across input perturbations. In this work, we propose Align-Consistency, an extension of CR designed for Align-Refine -- a non-autoregressive (non-AR) model that performs iterative refinement of frame-level hypotheses. This method leverages the speed of parallel inference while significantly boosting recognition performance. The effectiveness of Align-Consistency is demonstrated in two settings. First, in the fully supervised setting, our results indicate that applying CR to both the base CTC model and the subsequent refinement steps is critical, and the accuracy improvements from non-AR decoding and CR are mutually additive. Second, for semi-supervised ASR, we employ fast non-AR decoding to generate online pseudo-labels on unlabeled data, which are used to further refine the supervised model and lead to substantial gains."},{"descriptionType":"Other","description":"Accepted to Interspeech 2026"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.23171","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T03:04:11Z","registered":"2026-02-27T03:04:12Z","published":null,"updated":"2026-06-30T04:11:25Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.22960","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.22960","identifiers":[{"identifier":"2602.22960","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Tianxing","familyName":"Xu","name":"Xu, Tianxing","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zixuan","familyName":"Wang","name":"Wang, Zixuan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Guangyuan","familyName":"Wang","name":"Wang, Guangyuan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Li","familyName":"Hu","name":"Hu, Li","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zhongyi","familyName":"Zhang","name":"Zhang, Zhongyi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Peng","familyName":"Zhang","name":"Zhang, Peng","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Bang","familyName":"Zhang","name":"Zhang, Bang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Songhai","familyName":"Zhang","name":"Zhang, Songhai","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"UCM: Unified Modeling of Camera Control and Memory with Time-aware Positional Encoding Warping for World Models"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-26T12:54:46Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:43:53Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-06-29T11:22:33Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-06-30T01:48:06Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"World models based on video generation demonstrate remarkable potential for simulating interactive environments yet suffer from persistent difficulties in two key areas: maintaining long-term content consistency when scenes are revisited and enabling precise camera control from user-specified inputs. Existing methods based on explicit 3D reconstruction often compromise flexibility in unbounded scenarios and struggle to preserve fine-grained structures. Alternative methods rely directly on previously generated frames without establishing explicit spatial correspondence, thereby limiting controllability and consistency. To address these limitations, we present UCM, a novel framework for unified modeling of long-term memory and precise camera control via a time-aware positional encoding warping mechanism. To reduce computational overhead, we design an efficient dual-stream diffusion transformer for high-fidelity generation. Moreover, we introduce a scalable data curation strategy that utilizes point-cloud-based rendering to simulate scene revisiting, enabling training on over 500K monocular videos. Extensive experiments on real-world and synthetic benchmarks demonstrate that UCM significantly outperforms state-of-the-art methods on long-term scene consistency, while achieving precise camera controllability in high-fidelity video generation."},{"descriptionType":"Other","description":"Project Page: https://humanaigc.github.io/ucm-webpage/"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.22960","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T02:59:01Z","registered":"2026-02-27T02:59:02Z","published":null,"updated":"2026-06-30T04:11:23Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.22284","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.22284","identifiers":[{"identifier":"2602.22284","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Mingi","familyName":"Kim","name":"Kim, Mingi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yongjun","familyName":"Kim","name":"Kim, Yongjun","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jungwoo","familyName":"Kang","name":"Kang, Jungwoo","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Hyungki","familyName":"Kim","name":"Kim, Hyungki","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"BrepCoder: A Unified Multimodal Large Language Model for Multi-task B-rep Reasoning"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-25T12:44:28Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:01:52Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-03-02T04:18:48Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-03-03T02:38:11Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-06-25T03:36:56Z","dateType":"Submitted","dateInformation":"v3"},{"date":"2026-06-26T00:22:54Z","dateType":"Updated","dateInformation":"v3"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"3","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by-nc-nd/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution Non Commercial No Derivatives 4.0 International","rightsIdentifier":"cc-by-nc-nd-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Recent advancements in deep learning have actively addressed complex challenges within the Computer-Aided Design (CAD) domain.However, most existing approaches rely on task-specifi c models requiring structural modifi cations for new tasks, and they predominantly focus on point clouds or images rather than the industry-standard Boundary Representation (B-rep) format. To address these limitations, we propose BrepCoder, a unifi ed Multimodal Large Language Model (MLLM) that performs diverse CAD tasks from B-rep inputs. By leveraging the code generation capabilities of Large Language Models (LLMs), we convert CAD modeling sequences into Python-like code and align them with B-rep. We then adopt a two-stage training strategy: First, pre-training on reverse engineering to learn geometric features and design logic. Second, eff ectively extending the model to various downstream tasks such as completion, error correction, and CAD-QA. Consequently, by interpreting B-rep as structural code, BrepCoder achieves superior generalization across diverse tasks, demonstrating its potential as a general-purpose CAD agent."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.22284","contentUrl":null,"metadataVersion":2,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T02:42:50Z","registered":"2026-02-27T02:42:50Z","published":null,"updated":"2026-06-26T02:19:20Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.22733","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.22733","identifiers":[{"identifier":"2602.22733","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Seongyong","familyName":"Kim","name":"Kim, Seongyong","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Junhyeon","familyName":"Cho","name":"Cho, Junhyeon","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Kang-Won","familyName":"Lee","name":"Lee, Kang-Won","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Soo-Chul","familyName":"Lim","name":"Lim, Soo-Chul","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Pixel2Catch: Multi-Agent Sim-to-Real Transfer for Agile Manipulation with a Single RGB Camera"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Robotics (cs.RO)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-26T08:15:38Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-06-25T00:26:21Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[{"relationType":"IsVersionOf","relatedIdentifier":"10.1109/lra.2026.3703582","relatedIdentifierType":"DOI"}],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by-nc-nd/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution Non Commercial No Derivatives 4.0 International","rightsIdentifier":"cc-by-nc-nd-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"To catch a thrown object, a robot must be able to perceive the object's motion and generate control actions in a timely manner. Rather than explicitly estimating the object's 3D position, this work focuses on a novel approach that recognizes object motion using pixel-level visual information extracted from a single RGB image. Such visual cues capture changes in the object's position and scale, allowing the policy to reason about the object's motion. Furthermore, to achieve stable learning in a high-DoF system composed of a robot arm equipped with a multi-fingered hand, we design a heterogeneous multi-agent reinforcement learning framework that defines the arm and hand as independent agents with distinct roles. Each agent is trained cooperatively using role-specific observations and rewards, and the learned policies are successfully transferred from simulation to the real world."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.22733","contentUrl":null,"metadataVersion":2,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":1,"created":"2026-02-27T02:53:19Z","registered":"2026-02-27T02:53:20Z","published":null,"updated":"2026-06-25T02:21:06Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.22305","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.22305","identifiers":[{"identifier":"2602.22305","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Alessandro","familyName":"Trinca","name":"Trinca, Alessandro","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Alessandro","familyName":"Lupi","name":"Lupi, Alessandro","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Francesco","familyName":"Haardt","name":"Haardt, Francesco","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Piero","familyName":"Madau","name":"Madau, Piero","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"You can't see me: Super-Eddington growth hindering X-ray detection in high-z broad-line active galactic nuclei"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Astrophysics of Galaxies (astro-ph.GA)","lang":"en","subjectScheme":"arXiv"},{"subject":"High Energy Astrophysical Phenomena (astro-ph.HE)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-25T19:00:00Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:02:30Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-05-26T13:21:44Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-06-24T13:32:01Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[{"relationType":"IsVersionOf","relatedIdentifier":"10.1051/0004-6361/202659544","relatedIdentifierType":"DOI"}],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"We revisit black hole mass estimates for high-redshift broad-line active galactic nuclei (AGNs) discovered with JWST by jointly analysing their broad emission lines and their systematic non-detections in deep Chandra imaging. Building upon a self-shadowed, super-Eddington accretion framework in which the corona undergoes efficient radiative over-cooling, we couple funnel-dependent Comptonisation physics with slim-disc spectral models and explore the resulting parameter space through a full MCMC inference. Using a recently compiled sample of JWST high-redshift broad-line AGNs, we show that the observed X-ray weakness - manifested as extreme bolometric corrections, suppressed 2-10 keV luminosities, and non-detections in the 0.5-5 keV Chandra band - naturally arises when the corona is confined and radiatively over-cooled inside a narrow super-Eddington funnel. The combined broad line+X-ray analysis yields strongly bimodal posteriors: either very massive, very low-Eddington black holes (physically disfavoured), or a population of low-mass ($\\sim 10^{6}$-$10^{7} M_{\\odot}$) black holes accreting at $f_{\\rm Edd} \\gg 1$. The latter solution is strongly preferred for nearly all objects and returns masses consistent with, or lower than, local $M_{\\rm BH}$-$M_{\\star}$ relations, mitigating the extreme mass ratios implied by single-epoch virial estimators. The predicted intrinsic spectra are redder and exhibit reduced hard-X-ray output but higher bolometric luminosities, implying bolometric corrections larger than those typical of the local AGN population, yet consistent with low-redshift highly accreting counterparts. These results support a picture in which many JWST broad-line AGNs are powered by rapidly growing, super-Eddington black holes whose suppressed coronal emission and self-shadowed BLR geometry combine to mimic overmassive black holes at $z \\gtrsim 6$."},{"descriptionType":"Other","description":"10 pages, 11 figures, 1 appendix. Accepted for publication in Astronomy \u0026amp; Astrophysics"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.22305","contentUrl":null,"metadataVersion":2,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":1,"created":"2026-02-27T02:43:19Z","registered":"2026-02-27T02:43:19Z","published":null,"updated":"2026-06-25T02:21:05Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.23334","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.23334","identifiers":[{"identifier":"2602.23334","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Yuhao","familyName":"Liu","name":"Liu, Yuhao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Salim","familyName":"Ullah","name":"Ullah, Salim","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Akash","familyName":"Kumar","name":"Kumar, Akash","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Bitwise Systolic Array Architecture for Runtime-Reconfigurable Multi-precision Quantized Multiplication on Hardware Accelerators"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Hardware Architecture (cs.AR)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-26T18:40:02Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T02:03:09Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-06-22T23:42:08Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-06-24T00:14:29Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[{"relationType":"IsVersionOf","relatedIdentifier":"10.1109/isqed65160.2025.11014376","relatedIdentifierType":"DOI"}],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Neural network accelerators have been widely applied to edge devices for complex tasks like object tracking, image recognition, etc. Previous works have explored the quantization technologies in related lightweight accelerator designs to reduce hardware resource consumption. However, low precision leads to high accuracy loss in inference. Therefore, mixed-precision quantization becomes an alternative solution by applying different precision in different layers to trade off resource consumption and accuracy. Because regular designs for multiplication on hardware cannot support the precision reconfiguration for a multi-precision Quantized Neural Network (QNN) model in runtime, we propose a runtime reconfigurable multi-precision multi-channel bitwise systolic array design for QNN accelerators. We have implemented and evaluated our work on the Ultra96 FPGA platform. Results show that our work can achieve 1.3185 to 3.5671 times speedup in inferring mixed-precision models and has less critical path delay, supporting a higher clock frequency (250MHz)."},{"descriptionType":"Other","description":"Accepted at ISQED 2025. RTL source code, Vivado projects, and packaged Vivado IPs are available at: https://github.com/liuyh-Horizon/BitSys"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.23334","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":1,"created":"2026-02-27T03:08:18Z","registered":"2026-02-27T03:08:19Z","published":null,"updated":"2026-06-24T02:30:15Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.23293","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.23293","identifiers":[{"identifier":"2602.23293","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Kate","familyName":"Donahue","name":"Donahue, Kate","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Manish","familyName":"Raghavan","name":"Raghavan, Manish","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Impacts of Aggregation on Model Diversity and Consumer Utility"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Computer Science and Game Theory (cs.GT)","lang":"en","subjectScheme":"arXiv"},{"subject":"Computers and Society (cs.CY)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-26T18:04:03Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T02:01:02Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-06-18T18:11:36Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-06-23T00:07:06Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by-nc-sa/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution Non Commercial Share Alike 4.0 International","rightsIdentifier":"cc-by-nc-sa-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Consider a marketplace of AI tools, each with slightly different strengths and weaknesses. By picking the right model for the task at hand, a user can do better than simply using the same model for everything. Routers operate under a similar principle, where sophisticated model selection can increase overall performance. However, aggregation is often noisy, reflecting imperfect user choices or routing decisions. This leads to two main questions: first, what does a \"healthy marketplace\" of models look like for maximizing consumer utility? Secondly, how can we incentivize producers to create such models? We show that winrate, a standard benchmark in LLM evaluation, can incentivize model creators to homogenize for both types of model changes, reducing consumer welfare. We propose a new mechanism, weighted winrate, which rewards models for answers that are higher quality, and show that it provably improves incentives for producers to specialize and increases consumer welfare. We conclude by exploring the impact of our theoretical results in empirical benchmark datasets and discussing implications for benchmark design."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.23293","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T03:07:19Z","registered":"2026-02-27T03:07:20Z","published":null,"updated":"2026-06-23T05:42:05Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.22642","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.22642","identifiers":[{"identifier":"2602.22642","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Qin-Wen","familyName":"Luo","name":"Luo, Qin-Wen","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Sheng","familyName":"Ren","name":"Ren, Sheng","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xiang","familyName":"Chen","name":"Chen, Xiang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Rui","familyName":"Liu","name":"Liu, Rui","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jun","familyName":"Fang","name":"Fang, Jun","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Naiqiang","familyName":"Tan","name":"Tan, Naiqiang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Sheng-Jun","familyName":"Huang","name":"Huang, Sheng-Jun","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Compress the Easy, Explore the Hard: Difficulty-Aware Entropy Regularization for Efficient LLM Reasoning"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-26T05:47:30Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:26:19Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-06-18T19:10:56Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-06-23T00:10:12Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Chain-of-Thought (CoT) has substantially empowered Large Language Models (LLMs) to tackle complex reasoning tasks, yet the verbose nature of explicit reasoning steps incurs prohibitive inference latency and computational costs, limiting real-world deployment. While existing compression methods - ranging from self-training to Reinforcement Learning (RL) with length constraints - attempt to mitigate this, they often sacrifice reasoning capability for brevity. We identify a critical failure mode in these approaches: explicitly optimizing for shorter trajectories triggers rapid entropy collapse, which prematurely shrinks the exploration space and stifles the discovery of valid reasoning paths, particularly for challenging questions requiring extensive deduction. To address this issue, we propose Compress responses for Easy questions and Explore Hard ones (CEEH), a difficulty-aware approach to RL-based efficient reasoning. CEEH dynamically assesses instance difficulty to apply selective entropy regularization: it preserves a diverse search space for currently hard questions to ensure robustness, while permitting aggressive compression on easier instances where the reasoning path is well-established. In addition, we introduce a dynamic optimal-length penalty anchored to the historically shortest correct response, which effectively counteracts entropy-induced length inflation and stabilizes the reward signal. Across six reasoning benchmarks, CEEH consistently reduces response length while maintaining accuracy comparable to the base model, and improves Pass@k relative to length-only optimization."},{"descriptionType":"Other","description":"Accepted to KDD 2026"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.22642","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T02:51:11Z","registered":"2026-02-27T02:51:11Z","published":null,"updated":"2026-06-23T05:42:02Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.23248","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.23248","identifiers":[{"identifier":"2602.23248","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Yegon","familyName":"Kim","name":"Kim, Yegon","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Juho","familyName":"Lee","name":"Lee, Juho","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Mitigating Legibility Tax with Decoupled Prover-Verifier Games"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-26T17:25:22Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:58:58Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-06-18T15:12:26Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-06-19T00:58:25Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"As large language models become increasingly capable, it is critical that their outputs can be easily checked by less capable systems. Prover-verifier games can be used to improve checkability of model outputs, but display a degradation in accuracy compared to a baseline trained only to maximize correctness -- a phenonemon named legibility tax. We propose a solution by decoupling the correctness from the checkability condition and instead training a \"translator\" model that turns a fixed solver model's solution into a checkable form. This allows us to first train the solver to maximize correctness, and then train the translator to translate the solver into a checkable form while retaining the solver's answer. To accommodate this new objective of translation, we formulate a decoupled prover-verifier game (DPVG) where the equilibria correspond to faithful and checkable translators."},{"descriptionType":"Other","description":"ICLR 2026 Workshop Trustworthy AI"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.23248","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T03:06:11Z","registered":"2026-02-27T03:06:12Z","published":null,"updated":"2026-06-19T02:20:19Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.22959","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.22959","identifiers":[{"identifier":"2602.22959","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Zihao","familyName":"Zhao","name":"Zhao, Zihao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Frederik","familyName":"Hauke","name":"Hauke, Frederik","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Juliana","familyName":"De Castilhos","name":"De Castilhos, Juliana","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Sven","familyName":"Nebelung","name":"Nebelung, Sven","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Daniel","familyName":"Truhn","name":"Truhn, Daniel","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Can Agents Distinguish Visually Hard-to-Separate Diseases in a Zero-Shot Setting? A Pilot Study"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-26T12:53:50Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:43:52Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-06-18T09:17:08Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-06-19T00:37:03Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"The rapid progress of multimodal large language models (MLLMs) has led to increasing interest in agent-based systems. While most prior work in medical imaging concentrates on automating routine clinical workflows, we study an underexplored yet clinically significant setting: distinguishing visually hard-to-separate diseases in a zero-shot setting. We benchmark representative agents on two imaging-only proxy diagnostic tasks, (1) melanoma vs. atypical nevus and (2) pulmonary edema vs. pneumonia, where visual features are highly confounded despite substantial differences in clinical management. We introduce a multi-agent framework based on contrastive adjudication. Experimental results show improved diagnostic performance (an 11-percentage-point gain in accuracy on dermoscopy data) and reduced unsupported claims on qualitative samples, although overall performance remains insufficient for clinical deployment. We acknowledge the inherent uncertainty in human annotations and the absence of clinical context, which further limit the translation to real-world settings. Within this controlled setting, this pilot study provides preliminary insights into zero-shot agent performance in visually confounded scenarios."},{"descriptionType":"Other","description":"Code available at https://github.com/TruhnLab/Contrastive-Agent-Reasoning. Accepted by MICCAI 2026"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.22959","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T02:59:00Z","registered":"2026-02-27T02:59:00Z","published":null,"updated":"2026-06-19T02:20:17Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.22495","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.22495","identifiers":[{"identifier":"2602.22495","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Zhaoyang","familyName":"Zhang","name":"Zhang, Zhaoyang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Shuli","familyName":"Jiang","name":"Jiang, Shuli","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yantao","familyName":"Shen","name":"Shen, Yantao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yuting","familyName":"Zhang","name":"Zhang, Yuting","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Dhananjay","familyName":"Ram","name":"Ram, Dhananjay","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Shuo","familyName":"Yang","name":"Yang, Shuo","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zhuowen","familyName":"Tu","name":"Tu, Zhuowen","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Wei","familyName":"Xia","name":"Xia, Wei","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Stefano","familyName":"Soatto","name":"Soatto, Stefano","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Reinforcement-aware Knowledge Distillation for LLM Reasoning"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-26T00:20:39Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:12:50Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-04-09T21:16:09Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-04-13T00:10:11Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-06-17T23:32:06Z","dateType":"Submitted","dateInformation":"v3"},{"date":"2026-06-19T00:13:52Z","dateType":"Updated","dateInformation":"v3"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"3","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Reinforcement learning (RL) post-training has recently driven major gains in long chain-of-thought reasoning large language models (LLMs), but the high inference cost of such models motivates distillation into smaller students. Most existing knowledge distillation (KD) methods are designed for supervised fine-tuning (SFT), relying on fixed teacher traces or teacher-student Kullback-Leibler (KL) divergence-based regularization. When combined with RL, these approaches often suffer from distribution mismatch and objective interference: teacher supervision may not align with the student's evolving rollout distribution, and the KL regularizer can compete with reward maximization and require careful loss balancing. To address these issues, we propose RL-aware distillation (RLAD), which performs selective imitation during RL -- guiding the student toward the teacher only when it improves the current policy update. Our core component, Trust Region Ratio Distillation (TRRD), replaces the teacher-student KL regularizer with a PPO/GRPO-style likelihood-ratio objective anchored to a teacher--old-policy mixture, yielding advantage-aware, trust-region-bounded distillation on student rollouts and naturally balancing exploration, exploitation, and imitation. Across diverse logic reasoning and math benchmarks, RLAD consistently outperforms offline distillation, standard GRPO, and KL-based on-policy teacher-student knowledge distillation."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.22495","contentUrl":null,"metadataVersion":2,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T02:47:41Z","registered":"2026-02-27T02:47:42Z","published":null,"updated":"2026-06-19T02:20:15Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.23092","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.23092","identifiers":[{"identifier":"2602.23092","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Zhuoliang","familyName":"Xie","name":"Xie, Zhuoliang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Fei","familyName":"Liu","name":"Liu, Fei","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zhenkun","familyName":"Wang","name":"Wang, Zhenkun","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Qingfu","familyName":"Zhang","name":"Zhang, Qingfu","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Enhancing CVRP Solver through LLM-driven Automatic Heuristic Design"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-26T15:12:23Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:51:40Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-06-17T15:14:27Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-06-18T01:00:48Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"The Capacitated Vehicle Routing Problem (CVRP), a fundamental combinatorial optimization challenge, focuses on optimizing fleet operations under vehicle capacity constraints. While extensively studied in operational research, the NP-hard nature of CVRP continues to pose significant computational challenges, particularly for large-scale instances. This study presents AILS-AHD (Adaptive Iterated Local Search with Automatic Heuristic Design), a novel approach that leverages Large Language Models (LLMs) to revolutionize CVRP solving. Our methodology integrates an evolutionary search framework with LLMs to dynamically generate and optimize ruin heuristics within the AILS method. Additionally, we introduce an LLM-based acceleration mechanism to enhance computational efficiency. Comprehensive experimental evaluations against state-of-the-art solvers, including AILS-II and HGS, demonstrate the superior performance of AILS-AHD across both moderate and large-scale instances. Notably, our approach establishes new best-known solutions for 8 out of 10 instances in the CVRPLib large-scale benchmark, underscoring the potential of LLM-driven heuristic design in advancing the field of vehicle routing optimization."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.23092","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T03:02:14Z","registered":"2026-02-27T03:02:15Z","published":null,"updated":"2026-06-18T02:22:15Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.22222","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.22222","identifiers":[{"identifier":"2602.22222","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Bingrui","familyName":"Jin","name":"Jin, Bingrui","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Kunyao","familyName":"Lan","name":"Lan, Kunyao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Baihan","familyName":"LI","name":"LI, Baihan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Mengyue","familyName":"Wu","name":"Wu, Mengyue","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"TWICE: Modeling the Temporal Evolution of Personalized User Behavior via Event-Driven Agents"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Information Retrieval (cs.IR)","lang":"en","subjectScheme":"arXiv"},{"subject":"Multiagent Systems (cs.MA)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-12-15T20:28:05Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:00:21Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-06-17T09:41:39Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-06-18T00:39:30Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"User simulators are widely used for data generation, evaluation, and agent-based interaction, but existing approaches often model users as static personas or rely on generic historical context, making it difficult to capture how individual behavior evolves over time. To address this limitation, we propose TWICE, an LLM-based framework for temporally grounded personalized user simulation. TWICE combines structured user profiling, an event-driven memory module organized around life events and behavioral shifts, and a two-stage workflow separating event-grounded content planning from personalized style adaptation. This design enables the simulator to model not only what a user says, but also how past experiences shape later expression. We evaluate TWICE on a large-scale longitudinal Twitter dataset and introduce a comprehensive evaluation framework that jointly measures authenticity, consistency, and humanlikeness. Results show that TWICE consistently outperforms strong baselines, suggesting that event-centered memory is a promising mechanism for modeling the temporal evolution of personalized user behavior."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.22222","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T02:41:23Z","registered":"2026-02-27T02:41:23Z","published":null,"updated":"2026-06-18T02:22:14Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.22422","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.22422","identifiers":[{"identifier":"2602.22422","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Luciano","familyName":"Gerber","name":"Gerber, Luciano","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Huw","familyName":"Lloyd","name":"Lloyd, Huw","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Revisiting Chebyshev Polynomial and Anisotropic RBF Models for Tabular Regression"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-25T21:34:52Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:08:55Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-06-14T02:41:16Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-06-16T00:47:18Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Smooth-basis models such as Chebyshev polynomial regressors and radial basis function (RBF) networks are well established in numerical analysis. Their continuously differentiable prediction surfaces suit surrogate optimisation, sensitivity analysis, and other settings where the response varies gradually with inputs. Despite these properties, smooth models seldom appear in tabular regression, where tree ensembles dominate. We ask whether they can compete, benchmarking models across 55 regression datasets organised by application domain.\n We develop an anisotropic RBF network with data-driven centre placement and gradient-based width optimisation, a ridge-regularised Chebyshev polynomial regressor, and a smooth-tree hybrid (Chebyshev model tree); all three are released as scikit-learn-compatible packages. We benchmark these against tree ensembles, a pre-trained transformer, and standard baselines, evaluating accuracy alongside generalisation behaviour.\n The transformer ranks first on accuracy across a majority of datasets, but its GPU dependence, inference latency, and dataset-size limits constrain deployment in the CPU-based settings common across applied science and industry. Among CPU-viable models, smooth models and tree ensembles are statistically tied on accuracy, but the former tend to exhibit tighter generalisation gaps. We recommend routinely including smooth-basis models in the candidate pool, particularly when downstream use benefits from tighter generalisation and gradually varying predictions."},{"descriptionType":"Other","description":"46 pages, 6 figures, 21 tables. Under review at Knowledge-Based Systems"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.22422","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T02:46:01Z","registered":"2026-02-27T02:46:02Z","published":null,"updated":"2026-06-16T04:12:58Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.22391","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.22391","identifiers":[{"identifier":"2602.22391","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","affiliation":["Sylhet Engineering College"],"givenName":"Rakib","familyName":"Ullah","name":"Ullah, Rakib","nameIdentifiers":[]},{"nameType":"Personal","affiliation":["Daffodil International University"],"givenName":"Mominul","familyName":"islam","name":"islam, Mominul","nameIdentifiers":[]},{"nameType":"Personal","affiliation":["Daffodil International University"],"givenName":"Md Sanjid","familyName":"Hossain","name":"Hossain, Md Sanjid","nameIdentifiers":[]},{"nameType":"Personal","affiliation":["Daffodil International University"],"givenName":"Md Ismail","familyName":"Hossain","name":"Hossain, Md Ismail","nameIdentifiers":[]}],"titles":[{"title":"Detecting Hate and Inflammatory Content in Bengali Memes: A New Multimodal Dataset and Co-Attention Framework"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-25T20:40:25Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:07:20Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-06-13T09:57:16Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-06-16T00:30:30Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by-nc-nd/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution Non Commercial No Derivatives 4.0 International","rightsIdentifier":"cc-by-nc-nd-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Internet memes have become a dominant form of expression on social media, including within the Bengali speaking community. While often humorous, memes can also be exploited to spread offensive, harmful, and inflammatory content targeting individuals and groups. Detecting this type of content is exceptionally challenging due to its satirical, subtle, and culturally specific nature. This problem is magnified for low-resource languages like Bengali, as existing research predominantly focuses on high-resource languages. To address this critical research gap, we introduce Bn-HIB (Bangla Hate Inflammatory Benign), a novel dataset containing 3,247 manually annotated Bengali memes categorized as Benign, Hate, or Inflammatory. Significantly, Bn- HIB is the first dataset to distinguish inflammatory content from direct hate speech in Bengali memes. Furthermore, we propose the MCFM (Multi-Modal Co-Attention Fusion Model), a simple yet effective architecture that mutually analyses both the visual and textual elements of a meme. MCFM employs a co-attention mechanism to identify and fuse the most critical features from each modality, leading to a more accurate classification. Our experiments show that MCFM significantly outperforms several state-of-the-art models on the Bn-HIB dataset, demonstrating its effectiveness in this nuanced task. To facilitate reproducibility and future research, the Bn-HIB dataset has been made publicly available through Mendeley Data. Warning: This work contains material that may be disturbing to some audience members. Viewer discretion is advised"},{"descriptionType":"Other","description":"Added public link to dataset and fixed typo in abstract"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.22391","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T02:45:19Z","registered":"2026-02-27T02:45:19Z","published":null,"updated":"2026-06-16T04:12:57Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.22629","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.22629","identifiers":[{"identifier":"2602.22629","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Zeyu","familyName":"Jiang","name":"Jiang, Zeyu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Sihang","familyName":"Li","name":"Li, Sihang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Siqi","familyName":"Tan","name":"Tan, Siqi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Chenyang","familyName":"Xu","name":"Xu, Chenyang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Juexiao","familyName":"Zhang","name":"Zhang, Juexiao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Julia","familyName":"Galway-Witham","name":"Galway-Witham, Julia","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xue","familyName":"Wang","name":"Wang, Xue","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Scott A.","familyName":"Williams","name":"Williams, Scott A.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Radu","familyName":"Iovita","name":"Iovita, Radu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Chen","familyName":"Feng","name":"Feng, Chen","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jing","familyName":"Zhang","name":"Zhang, Jing","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"CRAG: Can 3D Generative Models Help 3D Assembly?"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-26T05:04:42Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:24:51Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-06-08T06:01:09Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-06-09T01:23:46Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-06-11T05:10:16Z","dateType":"Submitted","dateInformation":"v3"},{"date":"2026-06-12T00:27:11Z","dateType":"Updated","dateInformation":"v3"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"3","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Most existing 3D assembly methods treat the problem as pure pose estimation, rearranging observed parts via rigid transformations. In contrast, human assembly naturally couples structural reasoning with holistic shape inference. Inspired by this intuition, we reformulate 3D assembly as a joint problem of assembly and generation. We show that these two processes are mutually reinforcing: assembly provides part-level structural priors for generation, while generation injects holistic shape context that resolves ambiguities in assembly. Unlike prior methods that cannot synthesize missing geometry, we propose CRAG, which simultaneously generates plausible complete shapes and predicts poses for input parts. Extensive experiments demonstrate state-of-the-art performance across in-the-wild objects with diverse geometries, varying part counts, and missing pieces. Project Page: https://ai4ce.github.io/CRAG/"},{"descriptionType":"Other","description":"15 pages, 8 figures"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.22629","contentUrl":null,"metadataVersion":2,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T02:50:52Z","registered":"2026-02-27T02:50:52Z","published":null,"updated":"2026-06-12T02:22:45Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.22962","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.22962","identifiers":[{"identifier":"2602.22962","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Yuejiang","familyName":"Yu","name":"Yu, Yuejiang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Langwen","familyName":"Huang","name":"Huang, Langwen","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Alexandru","familyName":"Calotoiu","name":"Calotoiu, Alexandru","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Torsten","familyName":"Hoefler","name":"Hoefler, Torsten","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Scaling Laws of Global Weather Models"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-26T12:57:38Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:44:03Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-06-10T14:33:10Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-06-11T00:59:27Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Data-driven models are revolutionizing weather forecasting. To optimize training efficiency and model performance, this paper analyzes empirical scaling laws within this domain. We investigate the relationship between model performance (validation loss) and three key factors: model size ($N$), dataset size ($D$), and compute budget ($C$). Across a range of models, we find that Aurora exhibits the strongest data-scaling behavior: increasing the training dataset by 10x reduces validation loss by up to 3.2x. GraphCast demonstrates the highest parameter efficiency, yet suffers from limited hardware utilization. Our compute-optimal analysis indicates that, under fixed compute budgets, allocating resources to more total training data yields greater performance gains than increasing model size. Furthermore, we analyze model shape and uncover scaling behaviors that differ fundamentally from those observed in language models: weather forecasting models consistently favor increased width over depth. These findings suggest that future weather models should prioritize wider architectures and larger effective training datasets to maximize predictive performance."},{"descriptionType":"Other","description":"Accepted at ICML 2026. 21 pages, 7 figures"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.22962","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T02:59:04Z","registered":"2026-02-27T02:59:05Z","published":null,"updated":"2026-06-11T02:28:52Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.22638","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.22638","identifiers":[{"identifier":"2602.22638","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Zhiheng","familyName":"Song","name":"Song, Zhiheng","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jingshuai","familyName":"Zhang","name":"Zhang, Jingshuai","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Chuan","familyName":"Qin","name":"Qin, Chuan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Chao","familyName":"Wang","name":"Wang, Chao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Chao","familyName":"Chen","name":"Chen, Chao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Longfei","familyName":"Xu","name":"Xu, Longfei","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Kaikui","familyName":"Liu","name":"Liu, Kaikui","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xiangxiang","familyName":"Chu","name":"Chu, Xiangxiang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Hengshu","familyName":"Zhu","name":"Zhu, Hengshu","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"MobilityBench: A Benchmark for Evaluating Route-Planning Agents in Real-World Mobility Scenarios"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-26T05:39:38Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:25:57Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-06-10T08:57:04Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-06-11T00:40:50Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Route-planning agents powered by large language models (LLMs) have emerged as a promising paradigm for supporting everyday human mobility through natural language interaction and tool-mediated decision making. However, systematic evaluation in real-world mobility settings is hindered by diverse routing demands, non-deterministic mapping services, and limited reproducibility. In this study, we introduce MobilityBench, a scalable benchmark for evaluating LLM-based route-planning agents in real-world mobility scenarios. MobilityBench is constructed from large-scale, anonymized real user queries collected from Amap and covers a broad spectrum of route-planning intents across multiple cities worldwide. To enable reproducible, end-to-end evaluation, we design a deterministic API-replay sandbox that eliminates environmental variance from live services. We further propose a multi-dimensional evaluation protocol centered on outcome validity, complemented by assessments of instruction understanding, planning, tool use, and efficiency. Using MobilityBench, we evaluate multiple LLM-based route-planning agents across diverse real-world mobility scenarios and provide an in-depth analysis of their behaviors and performance. Our findings reveal that current models perform competently on Basic information retrieval and Route Planning tasks, yet struggle considerably with Preference-Constrained Route Planning, underscoring significant room for improvement in personalized mobility applications. We publicly release the benchmark data, evaluation toolkit, and documentation at https://github.com/AMAP-ML/MobilityBench."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.22638","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T02:51:05Z","registered":"2026-02-27T02:51:06Z","published":null,"updated":"2026-06-11T02:28:51Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.23234","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.23234","identifiers":[{"identifier":"2602.23234","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Evangelia","familyName":"Christakopoulou","name":"Christakopoulou, Evangelia","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Vivekkumar","familyName":"Patel","name":"Patel, Vivekkumar","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Hemanth","familyName":"Velaga","name":"Velaga, Hemanth","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Sandip","familyName":"Gaikwad","name":"Gaikwad, Sandip","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Sean","familyName":"Suchter","name":"Suchter, Sean","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Venkat","familyName":"Sundaranatha","name":"Sundaranatha, Venkat","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Scaling Search Relevance: Augmenting App Store Ranking with LLM-Generated Judgments"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Information Retrieval (cs.IR)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-26T17:11:26Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:58:18Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02-27T19:56:36Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-03-03T01:08:29Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-03-06T22:21:47Z","dateType":"Submitted","dateInformation":"v3"},{"date":"2026-03-10T00:15:17Z","dateType":"Updated","dateInformation":"v3"},{"date":"2026-06-01T00:39:09Z","dateType":"Submitted","dateInformation":"v4"},{"date":"2026-06-02T01:27:42Z","dateType":"Updated","dateInformation":"v4"},{"date":"2026-06-07T00:45:24Z","dateType":"Submitted","dateInformation":"v5"},{"date":"2026-06-09T00:47:41Z","dateType":"Updated","dateInformation":"v5"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"5","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by-nc-nd/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution Non Commercial No Derivatives 4.0 International","rightsIdentifier":"cc-by-nc-nd-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Large-scale commercial search systems optimize for relevance to drive successful sessions that help users find what they are looking for. To maximize relevance, we leverage two complementary objectives: behavioral relevance (results users tend to click or download) and textual relevance (a result's semantic fit to the query). A persistent challenge is the scarcity of expert-provided textual relevance labels relative to abundant behavioral relevance labels. We first address this by systematically evaluating LLM configurations, finding that a specialized, fine-tuned model significantly outperforms a much larger pre-trained one in providing highly relevant labels. Using this optimal model as a force multiplier, we generate millions of textual relevance labels to overcome the data scarcity. We show that augmenting our production ranker with these textual relevance labels leads to a significant outward shift of the Pareto frontier: offline NDCG improves for behavioral relevance while simultaneously increasing for textual relevance. These offline gains were validated by a worldwide A/B test on the App Store ranker, which demonstrated a statistically significant +0.24% increase in conversion rate, with the most substantial performance gains occurring in tail queries, where the new textual relevance labels provide a robust signal in the absence of reliable behavioral relevance labels."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.23234","contentUrl":null,"metadataVersion":4,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T03:05:49Z","registered":"2026-02-27T03:05:50Z","published":null,"updated":"2026-06-09T04:19:15Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.22417","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.22417","identifiers":[{"identifier":"2602.22417","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Philippe","familyName":"Gonzalez","name":"Gonzalez, Philippe","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Absorbing Discrete Diffusion for Speech Enhancement"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Sound (cs.SD)","lang":"en","subjectScheme":"arXiv"},{"subject":"Audio and Speech Processing (eess.AS)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"FOS: Electrical engineering, electronic engineering, information engineering","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Electrical engineering, electronic engineering, information engineering","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-25T21:22:08Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:08:38Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-06-04T10:49:29Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-06-05T00:50:20Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Inspired by recent developments in neural speech coding and diffusion-based language modeling, we tackle speech enhancement by modeling the conditional distribution of clean speech codes given noisy speech codes using absorbing discrete diffusion. The proposed approach, which we call ADDSE, leverages both the expressive latent space of neural audio codecs and the non-autoregressive sampling procedure of diffusion models. To efficiently model the hierarchical structure of residual vector quantization codes, we propose RQDiT, which combines techniques from RQ-Transformer and diffusion Transformers for non-autoregressive modeling. Results show competitive performance in terms of non-intrusive objective metrics on two datasets, especially at low signal-to-noise ratios and with few sampling steps. Code and audio examples are available online."},{"descriptionType":"Other","description":"Accepted at Interspeech 2026"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.22417","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T02:45:54Z","registered":"2026-02-27T02:45:55Z","published":null,"updated":"2026-06-05T07:07:31Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.23312","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.23312","identifiers":[{"identifier":"2602.23312","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Rafael R.","familyName":"Baptista","name":"Baptista, Rafael R.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"André de Lima","familyName":"Salgado","name":"Salgado, André de Lima","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ricardo V.","familyName":"Godoy","name":"Godoy, Ricardo V.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Marcelo","familyName":"Becker","name":"Becker, Marcelo","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Thiago","familyName":"Boaventura","name":"Boaventura, Thiago","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Gustavo J. G.","familyName":"Lahr","name":"Lahr, Gustavo J. G.","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Evaluating Zero-Shot and One-Shot Adaptation of Small Language Models in Leader-Follower Interaction"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Human-Computer Interaction (cs.HC)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"Robotics (cs.RO)","lang":"en","subjectScheme":"arXiv"},{"subject":"Systems and Control (eess.SY)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"FOS: Electrical engineering, electronic engineering, information engineering","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Electrical engineering, electronic engineering, information engineering","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-26T18:20:26Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T02:01:59Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-03-12T00:12:05Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-03-13T00:14:49Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-06-02T19:40:01Z","dateType":"Submitted","dateInformation":"v3"},{"date":"2026-06-04T00:07:29Z","dateType":"Updated","dateInformation":"v3"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"3","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Leader-follower interaction is an important paradigm in human-robot interaction (HRI). Yet, assigning roles in real time remains challenging for resource-constrained mobile and assistive robots. While large language models (LLMs) have shown promise for natural communication, their size and latency limit on-device deployment. Small language models (SLMs) offer a potential alternative, but their effectiveness for role classification in HRI has not been systematically evaluated. In this paper, we present a benchmark of SLMs for leader-follower communication, introducing a novel dataset derived from a published database and augmented with synthetic samples to capture interaction-specific dynamics. We investigate two adaptation strategies: prompt engineering and fine-tuning, studied under zero-shot and one-shot interaction modes, compared with an untrained baseline. Experiments with Qwen2.5-0.5B reveal that zero-shot fine-tuning achieves robust classification performance (86.66% accuracy) while maintaining low latency (22.2 ms per sample), significantly outperforming baseline and prompt-engineered approaches. However, results also indicate a performance degradation in one-shot modes, where increased context length challenges the model's architectural capacity. These findings demonstrate that fine-tuned SLMs provide an effective solution for direct role assignment, while highlighting critical trade-offs between dialogue complexity and classification reliability on the edge."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.23312","contentUrl":null,"metadataVersion":2,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T03:07:46Z","registered":"2026-02-27T03:07:46Z","published":null,"updated":"2026-06-04T03:33:24Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.22779","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.22779","identifiers":[{"identifier":"2602.22779","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Chenhao","familyName":"Zheng","name":"Zheng, Chenhao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jieyu","familyName":"Zhang","name":"Zhang, Jieyu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jianing","familyName":"Zhang","name":"Zhang, Jianing","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Weikai","familyName":"Huang","name":"Huang, Weikai","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ashutosh","familyName":"Kumar","name":"Kumar, Ashutosh","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Quan","familyName":"Kong","name":"Kong, Quan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Oncel","familyName":"Tuzel","name":"Tuzel, Oncel","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Chun-Liang","familyName":"Li","name":"Li, Chun-Liang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ranjay","familyName":"Krishna","name":"Krishna, Ranjay","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"TrajTok: Learning Trajectory Tokens enables better Video Understanding"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-26T09:15:34Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:34:40Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-05-10T04:11:45Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-05-12T01:05:34Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-06-03T09:11:47Z","dateType":"Submitted","dateInformation":"v3"},{"date":"2026-06-04T00:39:21Z","dateType":"Updated","dateInformation":"v3"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"3","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Tokenization in video models, typically through patchification, generates an excessive and redundant number of tokens. This severely limits video efficiency and scalability. While recent trajectory-based tokenizers offer a promising solution by decoupling video duration from token count, they rely on complex external segmentation and tracking pipelines that are slow and task-agnostic. We propose TrajTok, an end-to-end video tokenizer module that is fully integrated and co-trained with video models for a downstream objective, dynamically adapting its token granularity to semantic complexity, independent of video duration. TrajTok contains a unified segmenter that performs implicit clustering over pixels in both space and time to directly produce object trajectories in a single forward pass. By prioritizing downstream adaptability over pixel-perfect segmentation fidelity, TrajTok is lightweight and efficient, yet empirically improves video understanding performance. With TrajTok, we implement a video CLIP model trained from scratch (TrajViT2). It achieves the best accuracy at scale across both classification and retrieval benchmarks, while maintaining efficiency comparable to the best token-merging methods. TrajTok also proves to be a versatile component beyond its role as a tokenizer. We show that it can be seamlessly integrated as either a probing head for pretrained visual features (TrajAdapter) or an alignment connector in vision-language models (TrajVLM) with especially strong performance in long-video reasoning."},{"descriptionType":"Other","description":"CVPR 2026"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.22779","contentUrl":null,"metadataVersion":2,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T02:54:25Z","registered":"2026-02-27T02:54:26Z","published":null,"updated":"2026-06-04T03:33:21Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.22480","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.22480","identifiers":[{"identifier":"2602.22480","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Varun","familyName":"Ursekar","name":"Ursekar, Varun","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Apaar","familyName":"Shanker","name":"Shanker, Apaar","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Veronica","familyName":"Chatrath","name":"Chatrath, Veronica","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yuan","familyName":"Xue","name":"Xue, Yuan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Samuel Marc","familyName":"Denton","name":"Denton, Samuel Marc","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"VeRO: A Harness for Agents to Optimize Agents"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-25T23:40:22Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:11:59Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-05-01T21:30:31Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-05-05T00:11:20Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-05-11T16:21:57Z","dateType":"Submitted","dateInformation":"v3"},{"date":"2026-05-12T02:26:37Z","dateType":"Updated","dateInformation":"v3"},{"date":"2026-06-02T16:57:10Z","dateType":"Submitted","dateInformation":"v4"},{"date":"2026-06-03T01:13:01Z","dateType":"Updated","dateInformation":"v4"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"4","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"An important emerging application of coding agents is agent harness optimization: the iterative improvement of a target agent by editing and evaluating its code. Despite its relevance, the community lacks a systematic understanding of coding agent performance on this task. Harness optimization differs from conventional software engineering: agent harnesses interleave deterministic code with stochastic LLM completions, requiring structured capture of both intermediate execution traces and downstream outcomes. To address these challenges, we introduce (1) VeRO (Versioning, Rewards, and Observations), an outer harness that provides versioned snapshots, budget-controlled evaluation, and structured execution traces of target harnesses, and (2) VeRO-Bench, a benchmark suite of target agents and tasks with reference evaluation procedures. Using VeRO, we conduct an empirical study comparing optimizers across tasks and analyzing which modifications reliably improve target agent harnesses. We release VeRO to support research on agent optimization as a core capability for coding agents. Code is available at https://github.com/scaleapi/vero."},{"descriptionType":"Other","description":"Accepted to the Forty-Third International Conference on Machine Learning (ICML), 2026"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.22480","contentUrl":null,"metadataVersion":3,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T02:47:21Z","registered":"2026-02-27T02:47:22Z","published":null,"updated":"2026-06-03T03:14:54Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.23197","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.23197","identifiers":[{"identifier":"2602.23197","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Chungpa","familyName":"Lee","name":"Lee, Chungpa","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jy-yong","familyName":"Sohn","name":"Sohn, Jy-yong","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Kangwook","familyName":"Lee","name":"Lee, Kangwook","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Fine-Tuning Without Forgetting In-Context Learning: A Theoretical Analysis of Linear Attention Models"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"Machine Learning (stat.ML)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-26T16:49:15Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:56:48Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-05-31T12:02:20Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-06-02T01:10:03Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by-sa/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution Share Alike 4.0 International","rightsIdentifier":"cc-by-sa-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Transformer-based large language models exhibit in-context learning, enabling adaptation to downstream tasks via few-shot prompting with demonstrations. In practice, such models are often fine-tuned to improve zero-shot performance on downstream tasks, allowing them to solve tasks without examples and thereby reducing inference costs. However, fine-tuning can degrade in-context learning, limiting the performance of fine-tuned models on tasks not seen during fine-tuning. Using linear attention models, we provide a theoretical analysis that characterizes how fine-tuning objectives modify attention parameters and identifies conditions under which this leads to degraded few-shot performance. We show that fine-tuning all attention parameters can harm in-context learning, whereas restricting updates to the value matrix improves zero-shot performance while preserving in-context learning. We further show that incorporating an auxiliary few-shot loss enhances in-context learning primarily on the target task, at the expense of degraded in-context learning ability on tasks not seen during fine-tuning. We provide empirical evidence from synthetic and real-world datasets consistent with the qualitative predictions of our theory."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.23197","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T03:04:51Z","registered":"2026-02-27T03:04:52Z","published":null,"updated":"2026-06-02T05:02:03Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.23161","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.23161","identifiers":[{"identifier":"2602.23161","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Junkai","familyName":"Lu","name":"Lu, Junkai","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Peng","familyName":"Chen","name":"Chen, Peng","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xingjian","familyName":"Wu","name":"Wu, Xingjian","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yang","familyName":"Shu","name":"Shu, Yang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Chenjuan","familyName":"Guo","name":"Guo, Chenjuan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Christian S.","familyName":"Jensen","name":"Jensen, Christian S.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Bin","familyName":"Yang","name":"Yang, Bin","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"PATRA: Pattern-Aware Alignment and Balanced Reasoning for Time Series Question Answering"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-26T16:20:03Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:55:06Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-05-11T09:34:03Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-05-12T01:57:37Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-05-13T04:59:01Z","dateType":"Submitted","dateInformation":"v3"},{"date":"2026-05-14T00:36:03Z","dateType":"Updated","dateInformation":"v3"},{"date":"2026-06-01T07:54:17Z","dateType":"Submitted","dateInformation":"v4"},{"date":"2026-06-02T01:46:44Z","dateType":"Updated","dateInformation":"v4"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"4","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Time series reasoning demands both the perception of complex dynamics and logical depth. However, existing LLM-based approaches exhibit two limitations: they often treat time series merely as text or images, failing to capture the patterns like trends and seasonalities needed to answer specific questions; and when trained on a mix of simple and complex tasks, simpler objectives often dominate the learning process, hindering the development of deep reasoning capabilities. To address these limitations, we propose the Pattern-Aware Alignment and Balanced Reasoning model (PATRA), introducing a pattern-aware mechanism that extracts trend and seasonality patterns from time series to achieve deep alignment. Furthermore, we design a task-aware balanced reward to harmonize learning across tasks of varying difficulty, incentivizing the generation of coherent Chains of Thought. Extensive experiments show that PATRA outperforms strong baselines across diverse Time Series Question Answering (TSQA) tasks, demonstrating superior cross-modal understanding and reasoning capability."},{"descriptionType":"Other","description":"Accepted By ICML 2026"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.23161","contentUrl":null,"metadataVersion":3,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T03:03:56Z","registered":"2026-02-27T03:03:57Z","published":null,"updated":"2026-06-02T05:02:02Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.23039","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.23039","identifiers":[{"identifier":"2602.23039","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Jakob","familyName":"Kramp","name":"Kramp, Jakob","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Javed","familyName":"Lindner","name":"Lindner, Javed","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Moritz","familyName":"Helias","name":"Helias, Moritz","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Dynamics of neural scaling laws in random feature regression with powerlaw-distributed kernel eigenvalues"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Disordered Systems and Neural Networks (cond-mat.dis-nn)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-26T14:24:11Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:48:34Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-06-01T09:29:09Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-06-02T01:53:45Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Training large neural networks exposes neural scaling laws for the generalization error, which points to a universal behavior across network architectures of learning in high dimensions. It was also shown that this effect persists in the limit of highly overparametrized networks as well as the Neural network Gaussian process limit. We here develop a principled understanding of the typical behavior of generalization in Neural Network Gaussian process regression dynamics. We derive a dynamical mean-field theory that captures the typical case learning dynamics: This allows us to unify multiple existing regimes of learning studied in the current literature, namely Bayesian inference on Gaussian processes, gradient flow with or without weight-decay, and stochastic Langevin training dynamics. Employing tools from statistical physics, the unified framework we derive in either of these cases yields an effective description of the high-dimensional microscopic behavior of networks dynamics in terms of lower dimensional order parameters. We show that collective training dynamics may be separated into the dynamics of N independent eigenmodes, those evolution equations are only coupled through collective response functions and a common statistics of an effective, independent noise. Our approach allows us to quantitatively explain the dynamics of the generalization error by linking spectral and dynamical properties of learning on data with power law spectra, including phenomena such as neural scaling laws and the effect of early stopping."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.23039","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T03:00:59Z","registered":"2026-02-27T03:00:59Z","published":null,"updated":"2026-06-02T05:02:01Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.22768","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.22768","identifiers":[{"identifier":"2602.22768","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Li","familyName":"Yang","name":"Yang, Li","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xiaodong","familyName":"Yan","name":"Yan, Xiaodong","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Dandan","familyName":"Jiang","name":"Jiang, Dandan","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Asymptotic Theory and Sequential Testing for Adaptive Bandits"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Methodology (stat.ME)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-26T08:59:20Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:34:03Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-05-30T08:32:28Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-06-02T00:33:33Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Multi-armed bandit (MAB) processes constitute a foundational subclass of reinforcement learning problems and represent a central topic in statistical decision theory. Yet, conducting valid sequential testing under adaptive allocation remains challenging due to the lack of asymptotic theory under non-i.i.d. reward sequences and sublinear sample sizes for some arms. To address this open challenge, we propose an Urn Bandit (UNB) process to integrate the reinforcement mechanism of urn probabilistic models with MAB principles, ensuring almost sure concentration of allocation proportions on optimal arms. We establish a joint functional central limit theorem (FCLT) for consistent estimators of expected rewards under non-i.i.d. reward sequences with non-sub-Gaussian tails and pairwise cross-arm dependence. To overcome the limitations of existing methods that focus mainly on cumulative regret and therefore provide only algorithmic performance guarantees without supporting valid sequential testing, we develop an asymptotic theory for sequential test statistics under the proposed UNB process. The resulting framework enables a broad class of sequential inference procedures, such as A/B testing and policy evaluation. Simulation studies and real data analysis demonstrate that UNB maintains testing performance comparable to that of the equal randomization (ER) design while achieving improved reward accumulation relative to ER."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.22768","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T02:54:10Z","registered":"2026-02-27T02:54:11Z","published":null,"updated":"2026-06-02T05:01:59Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.22221","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.22221","identifiers":[{"identifier":"2602.22221","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Geng","familyName":"Liu","name":"Liu, Geng","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Li","familyName":"Feng","name":"Feng, Li","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Mengxiao","familyName":"Zhu","name":"Zhu, Mengxiao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Francesco","familyName":"Pierri","name":"Pierri, Francesco","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Evaluating Reliability Asymmetries in Chinese Factual Search and AI Answers"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Information Retrieval (cs.IR)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"Computers and Society (cs.CY)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-12-15T15:36:13Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:00:19Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-05-28T07:37:27Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-06-02T00:03:01Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Search engines and AI-powered systems increasingly mediate access to factual information, yet their reliability remains difficult to evaluate in realistic information-seeking settings. We study this problem in the Chinese web ecosystem by constructing a query-based fact-checking dataset from real Chinese search logs and comparing nine systems across traditional search engines, standalone large language models, and search-integrated AI Overviews. Focusing on factual Chinese-language factual Yes/No questions, we evaluate whether systems provide correct, incorrect, or uncertain decisions against evidence-derived ground truth. We find that systems are similarly accurate when they provide definitive answers, but differ sharply in how often they do so. Conditional accuracy ranges from 73.2% to 78.9%, yet search engines answer definitively on over 83% of queries, while Qwen-Max does so on fewer than half. We also find a consistent polarity gap: all systems perform better on yes-labeled queries than on no-labeled queries. We also use Baidu Index data to identify Chinese provinces with higher health-related search attention, which may indicate greater potential exposure to misinformation. Overall, our results show that reliability depends not only on whether systems are correct when they answer, but also on how often they answer, how they handle negative claims, and where information demand may increase exposure risks."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.22221","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T02:41:21Z","registered":"2026-02-27T02:41:22Z","published":null,"updated":"2026-06-02T05:01:57Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.23280","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.23280","identifiers":[{"identifier":"2602.23280","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Hrishikesh","familyName":"Viswanath","name":"Viswanath, Hrishikesh","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Juanwu","familyName":"Lu","name":"Lu, Juanwu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"S. Talha","familyName":"Bukhari","name":"Bukhari, S. Talha","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Mihir","familyName":"Chauhan","name":"Chauhan, Mihir","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Damon","familyName":"Conover","name":"Conover, Damon","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ziran","familyName":"Wang","name":"Wang, Ziran","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Aniket","familyName":"Bera","name":"Bera, Aniket","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Mollified Value Learning"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"Robotics (cs.RO)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-26T17:53:46Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T02:00:29Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-05-29T16:05:00Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-06-01T01:12:37Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Offline goal-conditioned reinforcement learning (GCRL) learns goal-reaching behaviors from static datasets, but accurate value estimation remains challenging under limited state-action coverage. Existing physics-informed approaches address this by imposing pointwise distance-like geometric constraints derived from Hamilton--Jacobi--Bellman (HJB) optimality principles, often through first-order partial differential equations such as the Eikonal equation. However, enforcing local consistency through explicit differential structure can become unstable in complex, high-dimensional environments. Our key insight is to instead reinterpret distance-like constraints as an expectation over a local spatial measure. By aggregating constraints over this measure rather than evaluating them pointwise, the objective acts as a spatial mollifier, inducing distance-like value geometry without requiring expensive differential operators. We refer to this as Mollified Value Learning (MVL). Experiments across navigation and high-dimensional robotic manipulation tasks show that MVL learns structured, value representations, improving goal-reaching performance, when used with implicit value representation learning methods. Open-source codes are available at https://github.com/HrishikeshVish/MVL."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.23280","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T03:06:59Z","registered":"2026-02-27T03:07:00Z","published":null,"updated":"2026-06-01T02:38:05Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.22971","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.22971","identifiers":[{"identifier":"2602.22971","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Peiyao","familyName":"Xiao","name":"Xiao, Peiyao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xiaogang","familyName":"Li","name":"Li, Xiaogang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xinyi","familyName":"Gao","name":"Gao, Xinyi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Chengliang","familyName":"Xu","name":"Xu, Chengliang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ben","familyName":"Wang","name":"Wang, Ben","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zichao","familyName":"Chen","name":"Chen, Zichao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zeyu","familyName":"Wang","name":"Wang, Zeyu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Lin","familyName":"Qu","name":"Qu, Lin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Bing","familyName":"Zhao","name":"Zhao, Bing","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Hu","familyName":"Wei","name":"Wei, Hu","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"SPM-Bench: Benchmarking Large Language Models for Scanning Probe Microscopy"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-26T13:08:56Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:44:32Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-05-29T07:44:51Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-06-01T00:38:50Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"As LLMs achieved breakthroughs in general reasoning, their proficiency in specialized scientific domains reveals pronounced gaps in existing benchmarks due to data contamination, insufficient complexity, and prohibitive human labor costs. Here we present SPM-Bench, an original, PhD-level multimodal benchmark specifically designed for scanning probe microscopy (SPM). We propose a fully automated data synthesis pipeline that ensures both high authority and low-cost. By employing Anchor-Gated Sieve (AGS) technology, we efficiently extract high-value image-text pairs from arXiv and journal papers published between 2023 and 2025. Through a hybrid cloud-local architecture where VLMs return only spatial coordinates \"llbox\" for local high-fidelity cropping, our pipeline achieves extreme token savings while maintaining high dataset purity. To accurately and objectively evaluate the performance of the LLMs, we introduce the Strict Imperfection Penalty F1 (SIP-F1) score. This metric not only establishes a rigorous capability hierarchy but also, for the first time, quantifies model \"personalities\" (Conservative, Aggressive, Gambler, or Wise). By correlating these results with model-reported confidence and perceived difficulty, we expose the true reasoning boundaries of current AI in complex physical scenarios. These insights establish SPM-Bench as a generalizable paradigm for automated scientific data synthesis."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.22971","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T02:59:18Z","registered":"2026-02-27T02:59:19Z","published":null,"updated":"2026-06-01T02:38:04Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.22968","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.22968","identifiers":[{"identifier":"2602.22968","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Alaa","familyName":"Anani","name":"Anani, Alaa","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Tobias","familyName":"Lorenz","name":"Lorenz, Tobias","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Bernt","familyName":"Schiele","name":"Schiele, Bernt","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Mario","familyName":"Fritz","name":"Fritz, Mario","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jonas","familyName":"Fischer","name":"Fischer, Jonas","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Certified Circuits: Stability Guarantees for Mechanistic Circuits"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"Computers and Society (cs.CY)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-26T13:07:31Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:44:28Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-03-02T13:21:23Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-03-03T03:07:25Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-05-28T21:41:37Z","dateType":"Submitted","dateInformation":"v3"},{"date":"2026-06-01T00:11:46Z","dateType":"Updated","dateInformation":"v3"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"3","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Understanding how neural networks arrive at their predictions is essential for debugging, auditing, and deployment. Mechanistic interpretability pursues this goal by identifying circuits--minimal subnetworks responsible for specific behaviors. However, existing circuit discovery methods are brittle: circuits depend strongly on the chosen concept dataset and often fail to transfer out-of-distribution, raising doubts whether they capture the concept or merely dataset-specific artifacts. We introduce Certified Circuits, which provide provable stability guarantees for circuit discovery. Our framework wraps any black-box discovery algorithm with randomized data subsampling to certify that inclusion decisions over circuit components--neurons or edges of the model graph, depending on the base algorithm--are invariant to bounded edit-distance perturbations of the concept dataset. Unstable components are abstained from, yielding circuits that are more compact and more accurate. We validate across three architectures (ResNet, ViT, GPT-2) on vision (ImageNet and four OOD datasets) and language (IOI, IOI-Hard, Greater-Than) tasks. Certified circuits achieve up to 56% higher accuracy and up to 80% fewer components, and remain reliable where baselines degrade. Certified Circuits puts circuit discovery on formal ground by producing mechanistic explanations that are provably stable and better aligned with the target concept. Code: https://github.com/AlaaAnani/certified-circuits."},{"descriptionType":"Other","description":"Accepted at ICML 2026"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.22968","contentUrl":null,"metadataVersion":2,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T02:59:13Z","registered":"2026-02-27T02:59:14Z","published":null,"updated":"2026-06-01T02:38:03Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.22769","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.22769","identifiers":[{"identifier":"2602.22769","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Yujie","familyName":"Zhao","name":"Zhao, Yujie","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Boqin","familyName":"Yuan","name":"Yuan, Boqin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Junbo","familyName":"Huang","name":"Huang, Junbo","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Haocheng","familyName":"Yuan","name":"Yuan, Haocheng","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zhongming","familyName":"Yu","name":"Yu, Zhongming","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Haozhou","familyName":"Xu","name":"Xu, Haozhou","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Lanxiang","familyName":"Hu","name":"Hu, Lanxiang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Abhilash","familyName":"Shankarampeta","name":"Shankarampeta, Abhilash","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zimeng","familyName":"Huang","name":"Huang, Zimeng","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Wentao","familyName":"Ni","name":"Ni, Wentao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yuandong","familyName":"Tian","name":"Tian, Yuandong","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jishen","familyName":"Zhao","name":"Zhao, Jishen","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"AMA-Bench: Evaluating Long-Horizon Memory for Agentic Applications"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-26T08:59:31Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:34:04Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-03-04T03:30:11Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-03-05T01:25:54Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-05-25T11:24:00Z","dateType":"Submitted","dateInformation":"v3"},{"date":"2026-05-26T01:43:47Z","dateType":"Updated","dateInformation":"v3"},{"date":"2026-05-27T09:28:43Z","dateType":"Submitted","dateInformation":"v4"},{"date":"2026-05-28T00:51:21Z","dateType":"Updated","dateInformation":"v4"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"4","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Large Language Models (LLMs) are increasingly used as autonomous agents in complex, long-horizon applications, where effective memory is critical for sustained performance. Yet existing memory benchmarks are largely dialogue-centric, while real agent memory consists of continuous agent-environment interaction trajectories composed of states, actions, observations, and tool outputs. To address this gap, we introduce **AMA-Bench** (**A**gent **M**emory with **A**ny length), a benchmark for evaluating long-horizon memory in realistic agentic settings. AMA-Bench combines real-world agent trajectories from representative applications with expert-curated QA, as well as synthetic trajectories that scale to arbitrary horizons with rule-based QA. Our study shows that existing memory systems underperform because they fail to capture causal and objective information and rely heavily on lossy similarity-based retrieval. We further propose **AMA-Agent**, a memory system based on causality-graph construction and tool-augmented retrieval. AMA-Agent achieves **57.22%** accuracy on AMA-Bench, outperforming the strongest baseline by **11.16%**. Resources are available at: [https://ama-bench.github.io/](https://ama-bench.github.io/)."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.22769","contentUrl":null,"metadataVersion":3,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T02:54:11Z","registered":"2026-02-27T02:54:12Z","published":null,"updated":"2026-05-28T02:58:28Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.22631","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.22631","identifiers":[{"identifier":"2602.22631","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Robert Joseph","familyName":"George","name":"George, Robert Joseph","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jennifer","familyName":"Cruden","name":"Cruden, Jennifer","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Will","familyName":"Adkisson","name":"Adkisson, Will","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xiangru","familyName":"Zhong","name":"Zhong, Xiangru","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Huan","familyName":"Zhang","name":"Zhang, Huan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Anima","familyName":"Anandkumar","name":"Anandkumar, Anima","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"TorchLean: Formalizing Neural Networks in Lean"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Mathematical Software (cs.MS)","lang":"en","subjectScheme":"arXiv"},{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"Logic in Computer Science (cs.LO)","lang":"en","subjectScheme":"arXiv"},{"subject":"Numerical Analysis (math.NA)","lang":"en","subjectScheme":"arXiv"},{"subject":"Programming Languages (cs.PL)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"I.2.6; F.3.1; D.2.4; G.1.0","lang":"en","subjectScheme":"ACM"},{"subject":"68T07, 68Q60, 65G20, 93C10","lang":"en","subjectScheme":"MSC"}],"contributors":[],"dates":[{"date":"2026-02-26T05:11:44Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:25:00Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-05-24T04:59:07Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-05-26T00:53:29Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Neural networks are increasingly deployed in scientific, safety critical, and mission critical pipelines, yet verification and analysis are often performed outside the programming environment that defines and runs the model. This creates a semantic gap between the executed network and the analyzed artifact: guarantees can depend on implicit conventions about operator semantics, tensor layouts, preprocessing, floating-point behavior, graph transformations, accelerated kernels, and external certificates. We present TorchLean, a unified framework for formalizing, executing, and verifying neural networks in Lean 4. TorchLean treats learned models as executable programs and mathematical objects with a shared semantics for computation, verification, and theorem proving. The framework provides a PyTorch style API for typed tensors, layers, objectives, optimizers, automatic differentiation, and graph programs, with eager and compiled execution paths that lower to a common computation-graph representation. TorchLean supports exact and finite-precision tensor semantics, verified reverse-mode differentiation, interval and affine bound propagation, CROWN/LiRPA style certificate checking, import/export workflows, and CUDA-backed execution through explicit FFI boundaries. It also includes semantic layers for attention and FlashAttention, state-space sequence models, diffusion and sampling processes, probability kernels, reinforcement-learning objectives and Markov decision processes, and self-supervised objectives such as masked autoencoding, JEPA-style predictive views, and variance/correlation-based anti-collapse losses. Together, these components provide a semantic foundation for verified machine learning, where executable neural network artifacts, verification procedures, runtime boundaries, and mathematical claims can be stated and related inside one theorem-proving environment."},{"descriptionType":"Other","description":"55 pages"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.22631","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T02:50:54Z","registered":"2026-02-27T02:50:55Z","published":null,"updated":"2026-05-26T04:25:40Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.23200","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.23200","identifiers":[{"identifier":"2602.23200","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Sayed Mohammadreza Tayaranian","familyName":"Hosseini","name":"Hosseini, Sayed Mohammadreza Tayaranian","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Amir","familyName":"Ardakani","name":"Ardakani, Amir","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Warren J.","familyName":"Gross","name":"Gross, Warren J.","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"InnerQ: Hardware-Aware Tuning-Free Quantization of KV Cache for Large Language Models"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-26T16:50:36Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:56:57Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-05-20T19:15:57Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-05-22T00:06:26Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"When transformer-based language models are deployed for text generation, most of the inference time is spent in the decoding stage, where output tokens are generated sequentially. Reducing the hardware cost of each decoding step is therefore critical for efficient long-context generation. A major bottleneck is the key-value (KV) cache, whose size grows with sequence length and often dominates the model's memory footprint. Prior work has proposed quantization methods to compress the KV cache while minimizing its loss of precision. We present InnerQ, a hardware-aware KV cache quantization scheme that reduces decode latency without compromising evaluation performance. InnerQ performs group-wise quantization by grouping cache matrices along their inner dimension. This grouping strategy aligns dequantization with vector-matrix multiplication and increases data reuse across GPU compute units. As a result, InnerQ reduces memory access and accelerates dequantization, achieving an average $1.3\\times$ speedup over prior KV cache quantization methods and $2.7\\times$ over the non-quantized baseline. To maintain fidelity under aggressive compression, InnerQ incorporates three techniques: (i) hybrid quantization, which chooses symmetric or asymmetric quantization for each group based on local statistics; (ii) high-precision windows for both recent tokens and attention sink tokens to mitigate outlier leakage; and (iii) per-channel normalization of the key cache, computed once during prefill and folded into the model parameters to eliminate runtime overhead. Beyond reducing latency, experiments on Llama and Mistral models show that InnerQ also improves few-shot evaluation scores relative to prior KV cache quantization methods."},{"descriptionType":"Other","description":"18 pages, 5 figures, 7 tables"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.23200","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T03:04:56Z","registered":"2026-02-27T03:04:56Z","published":null,"updated":"2026-05-22T02:34:16Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.22719","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.22719","identifiers":[{"identifier":"2602.22719","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Vamshi Sunku","familyName":"Mohan","name":"Mohan, Vamshi Sunku","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Kaustubh","familyName":"Gupta","name":"Gupta, Kaustubh","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Aneesha","familyName":"Das","name":"Das, Aneesha","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Chandan","familyName":"Singh","name":"Singh, Chandan","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Interpreting and Steering State-Space Models via Activation Subspace Bottlenecks"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-26T07:46:42Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:30:56Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-05-21T10:49:19Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-05-22T00:48:27Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"State-space models (SSMs) have emerged as an efficient strategy for building powerful language models, avoiding the quadratic complexity of computing attention in transformers. Despite their promise, the interpretability and steerability of modern SSMs remain relatively underexplored. We take a major step in this direction by identifying activation subspace bottlenecks in the Mamba family of SSM models using tools from mechanistic interpretability. We then introduce a test-time steering intervention that simply multiplies the activations of the identified bottlenecks by a scalar. Across 7 SSMs and 6 diverse benchmarks, this intervention improves performance by an average of 8.27%, without requiring any task-specific tuning. Finally, we validate that the identified bottlenecks are indeed hindering performance by modifying them to yield an architecture we call Stable-Mamba, which achieves long-context performance gains when retrained from scratch."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.22719","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T02:53:00Z","registered":"2026-02-27T02:53:01Z","published":null,"updated":"2026-05-22T02:34:15Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.23058","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.23058","identifiers":[{"identifier":"2602.23058","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Zeyu","familyName":"Zhang","name":"Zhang, Zeyu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Danning","familyName":"Li","name":"Li, Danning","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ian","familyName":"Reid","name":"Reid, Ian","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Richard","familyName":"Hartley","name":"Hartley, Richard","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"GeoWorld: Geometric World Models"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"Robotics (cs.RO)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-26T14:42:53Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:49:38Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-05-17T06:55:06Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-05-19T01:01:34Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by-nc-sa/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution Non Commercial Share Alike 4.0 International","rightsIdentifier":"cc-by-nc-sa-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Energy-based predictive world models provide a powerful approach for multi-step visual planning by reasoning over latent energy landscapes rather than generating pixels. However, existing approaches face two major challenges: (i) their latent representations are typically learned in Euclidean space, neglecting the underlying geometric and hierarchical structure among states, and (ii) they struggle with long-horizon prediction, which leads to rapid degradation across extended rollouts. To address these challenges, we introduce GeoWorld, a geometric world model that preserves geometric structure and hierarchical relations through a Hyperbolic JEPA, which maps latent representations from Euclidean space onto hyperbolic manifolds. We further introduce Geometric Reinforcement Learning for energy-based optimization, enabling stable multi-step planning in hyperbolic latent space. Extensive experiments on CrossTask and COIN demonstrate around 3% SR improvement in 3-step planning and 2% SR improvement in 4-step planning compared to the state-of-the-art V-JEPA 2. Project website: https://steve-zeyu-zhang.github.io/GeoWorld."},{"descriptionType":"Other","description":"Accepted to CVPR 2026"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.23058","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T03:01:26Z","registered":"2026-02-27T03:01:27Z","published":null,"updated":"2026-05-19T04:56:38Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.22801","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.22801","identifiers":[{"identifier":"2602.22801","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Yinan","familyName":"Zheng","name":"Zheng, Yinan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Tianyi","familyName":"Tan","name":"Tan, Tianyi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Bin","familyName":"Huang","name":"Huang, Bin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Enguang","familyName":"Liu","name":"Liu, Enguang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ruiming","familyName":"Liang","name":"Liang, Ruiming","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jianlin","familyName":"Zhang","name":"Zhang, Jianlin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jianwei","familyName":"Cui","name":"Cui, Jianwei","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Guang","familyName":"Chen","name":"Chen, Guang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Kun","familyName":"Ma","name":"Ma, Kun","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Hangjun","familyName":"Ye","name":"Ye, Hangjun","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Long","familyName":"Chen","name":"Chen, Long","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ya-Qin","familyName":"Zhang","name":"Zhang, Ya-Qin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xianyuan","familyName":"Zhan","name":"Zhan, Xianyuan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jingjing","familyName":"Liu","name":"Liu, Jingjing","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Unleashing the Potential of Diffusion Models for End-to-End Autonomous Driving"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Robotics (cs.RO)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-26T09:37:38Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:35:33Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-05-16T16:36:34Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-05-19T00:47:18Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by-nc-sa/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution Non Commercial Share Alike 4.0 International","rightsIdentifier":"cc-by-nc-sa-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Diffusion models have become a popular choice for decision-making tasks in robotics, and more recently, are also being considered for solving autonomous driving tasks. However, their applications and evaluations in autonomous driving remain limited to simulation-based or laboratory settings. The full strength of diffusion models for large-scale, complex real-world settings, such as End-to-End Autonomous Driving (E2E AD), remains underexplored. In this study, we conducted a systematic and large-scale investigation to unleash the potential of the diffusion models as planners for E2E AD, based on a tremendous amount of real-vehicle data and road testing. Through comprehensive and carefully controlled studies, we identify key insights into the diffusion loss space, trajectory representation, and data scaling that significantly impact E2E planning performance. Moreover, we also provide an effective reinforcement learning post-training strategy to further enhance the safety and robustness of the learned planner. The resulting diffusion-based learning framework, Hyper Diffusion Planner (HDP), is deployed on a real-vehicle platform and evaluated across 6 urban driving scenarios and 200 km of real-world testing, achieving a notable 10x performance improvement over the base model. Our work demonstrates that diffusion models, when properly designed and trained, can serve as effective and scalable E2E AD planners for complex, real-world autonomous driving tasks."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.22801","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T02:54:59Z","registered":"2026-02-27T02:54:59Z","published":null,"updated":"2026-05-19T04:56:36Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.22667","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.22667","identifiers":[{"identifier":"2602.22667","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Changqing","familyName":"Zhou","name":"Zhou, Changqing","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yueru","familyName":"Luo","name":"Luo, Yueru","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Han","familyName":"Zhang","name":"Zhang, Han","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zeyu","familyName":"Jiang","name":"Jiang, Zeyu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Changhao","familyName":"Chen","name":"Chen, Changhao","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Monocular Open Vocabulary Occupancy Prediction for Indoor Scenes"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-26T06:37:43Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:28:21Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-05-18T07:52:01Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-05-19T01:45:13Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Open-vocabulary 3D occupancy is vital for embodied agents, which need to understand complex indoor environments where semantic categories are abundant and evolve beyond fixed taxonomies. While recent work has explored open-vocabulary occupancy in outdoor driving scenarios, such methods transfer poorly indoors, where geometry is denser, layouts are more intricate, and semantics are far more fine-grained. To address these challenges, we adopt a geometry-only supervision paradigm that uses only binary occupancy labels (occupied vs free). Our framework builds upon 3D Language-Embedded Gaussians, which serve as a unified intermediate representation coupling fine-grained 3D geometry with a language-aligned semantic embedding. On the geometry side, we find that existing Gaussian-to-Occupancy operators fail to converge under such weak supervision, and we introduce an opacity-aware, Poisson-based approach that stabilizes volumetric aggregation. On the semantic side, direct alignment between rendered features and open-vocabulary segmentation features suffers from feature mixing; we therefore propose a Progressive Temperature Decay schedule that gradually sharpens opacities during splatting, strengthening Gaussian-language alignment. On Occ-ScanNet, our framework achieves 59.50 IoU and 21.05 mIoU in the open-vocabulary setting, surpassing all existing occupancy methods in IoU and outperforming prior open-vocabulary approaches by a large margin in mIoU. Code will be released at https://github.com/JuIvyy/LegoOcc."},{"descriptionType":"Other","description":"Accepted at CVPR2026 Oral"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.22667","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T02:51:46Z","registered":"2026-02-27T02:51:47Z","published":null,"updated":"2026-05-19T04:56:35Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.22307","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.22307","identifiers":[{"identifier":"2602.22307","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Namu","familyName":"Kroupa","name":"Kroupa, Namu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Will","familyName":"Handley","name":"Handley, Will","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Global structure of the time delay likelihood"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Methodology (stat.ME)","lang":"en","subjectScheme":"arXiv"},{"subject":"Cosmology and Nongalactic Astrophysics (astro-ph.CO)","lang":"en","subjectScheme":"arXiv"},{"subject":"Astrophysics of Galaxies (astro-ph.GA)","lang":"en","subjectScheme":"arXiv"},{"subject":"Instrumentation and Methods for Astrophysics (astro-ph.IM)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-25T19:00:00Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:02:33Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-04-11T14:11:45Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-04-14T00:37:42Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-04-28T14:44:29Z","dateType":"Submitted","dateInformation":"v3"},{"date":"2026-05-19T02:05:42Z","dateType":"Updated","dateInformation":"v3"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[{"relationType":"IsVersionOf","relatedIdentifier":"10.1103/kj4s-nnyx","relatedIdentifierType":"DOI"}],"relatedItems":[],"sizes":[],"formats":[],"version":"3","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"We identify a fundamental pathology in the likelihood for time delay inference which challenges standard inference methods. By analysing the likelihood for time delay inference with Gaussian process light curve models, we show that it generically develops a boundary-driven \"W\"-shape with a global maximum at the true delay and gradual rises towards the edges of the observation window. This arises because time delay estimation is intrinsically extrapolative. In practice, global samplers such as nested sampling are steered towards spurious edge modes unless strict convergence criteria are adopted. We demonstrate this with simulations and show that the effect strengthens with higher data density over a fixed time span. To ensure convergence, we provide concrete guidance, notably increasing the number of live points. Further, we show that methods implicitly favouring small delays, for example optimisers and local MCMC, induce a bias towards larger $H_0$. Our results clarify failure modes and offer practical remedies for robust fully Bayesian time delay inference."},{"descriptionType":"Other","description":"21 pages, 8 figures"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.22307","contentUrl":null,"metadataVersion":3,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":1,"created":"2026-02-27T02:43:21Z","registered":"2026-02-27T02:43:22Z","published":null,"updated":"2026-05-19T04:56:33Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.22918","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.22918","identifiers":[{"identifier":"2602.22918","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Jonathan","familyName":"Steinberg","name":"Steinberg, Jonathan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Oren","familyName":"Gal","name":"Gal, Oren","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Where Vision Becomes Text: Locating the OCR Routing Bottleneck in Vision-Language Models"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-26T12:06:02Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:41:47Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-04-10T13:36:31Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-04-13T00:50:34Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-05-15T04:57:56Z","dateType":"Submitted","dateInformation":"v3"},{"date":"2026-05-18T00:26:29Z","dateType":"Updated","dateInformation":"v3"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"3","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Vision-language models (VLMs) can read text from images, but where does this optical character recognition (OCR) information enter the language processing stream? We investigate the OCR routing mechanism across three architecture families (Qwen3-VL, Phi-4, InternVL3.5) using causal interventions. By computing activation differences between original images and text-inpainted versions, we identify architecture-specific OCR bottlenecks whose dominant location depends on the vision-language integration strategy: DeepStack models (Qwen) show peak sensitivity at mid-depth (about 50%) for scene text, while single-stage projection models (Phi-4, InternVL) peak at early layers (6-25%), though the exact layer of maximum effect varies across datasets. The OCR signal is remarkably low-dimensional: PC1 captures up to 72.9% of variance. Crucially, principal component analysis (PCA) directions learned on one dataset transfer to others, demonstrating shared text-processing pathways. Surprisingly, in models with modular OCR circuits (notably Qwen3-VL-4B), OCR removal can improve counting performance (up to +6.9 percentage points), suggesting OCR interferes with other visual processing in sufficiently modular architectures."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.22918","contentUrl":null,"metadataVersion":2,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T02:57:56Z","registered":"2026-02-27T02:57:57Z","published":null,"updated":"2026-05-18T02:17:22Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.23089","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.23089","identifiers":[{"identifier":"2602.23089","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Domonkos","familyName":"Csuzdi","name":"Csuzdi, Domonkos","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Tamás","familyName":"Bécsi","name":"Bécsi, Tamás","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Olivér","familyName":"Törő","name":"Törő, Olivér","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Physics-informed neural particle flow for the Bayesian update step"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-26T15:10:45Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:51:31Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-05-13T11:02:58Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-05-14T00:58:18Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by-nc-nd/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution Non Commercial No Derivatives 4.0 International","rightsIdentifier":"cc-by-nc-nd-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"The Bayesian update step poses significant computational challenges in high-dimensional nonlinear estimation. While log-homotopy particle flow filters offer an alternative to stochastic sampling, existing formulations usually yield stiff differential equations. Conversely, existing deep learning approximations typically treat the update as a black-box task or rely on asymptotic relaxation, neglecting the exact geometric structure of the finite-horizon probability transport. In this work, we propose a physics-informed neural particle flow, which is an amortized inference framework. To construct the flow, we couple the log-homotopy trajectory of the prior to posterior density function with the continuity equation describing the density evolution. This derivation yields a governing partial differential equation (PDE), referred to as the master PDE. By embedding this PDE as a physical constraint into the loss function, we train a neural network to approximate the transport velocity field. This approach enables purely unsupervised training, eliminating the need for ground-truth posterior samples. We demonstrate that the neural parameterization acts as an implicit regularizer, mitigating the numerical stiffness inherent to analytic flows and reducing online computational complexity. Experimental validation on multimodal benchmarks and a challenging nonlinear scenario confirms better mode coverage and robustness compared to state-of-the-art baselines."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.23089","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T03:02:10Z","registered":"2026-02-27T03:02:11Z","published":null,"updated":"2026-05-14T02:55:28Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.23013","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.23013","identifiers":[{"identifier":"2602.23013","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Camile","familyName":"Lendering","name":"Lendering, Camile","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Erkut","familyName":"Akdag","name":"Akdag, Erkut","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Egor","familyName":"Bondarev","name":"Bondarev, Egor","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"SubspaceAD: Training-Free Few-Shot Anomaly Detection via Subspace Modeling"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-26T13:52:57Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:46:56Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-04-05T15:06:06Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-04-07T00:56:48Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-05-13T09:15:01Z","dateType":"Submitted","dateInformation":"v3"},{"date":"2026-05-14T00:51:09Z","dateType":"Updated","dateInformation":"v3"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"3","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Detecting visual anomalies in industrial inspection often requires training with only a few normal images per category. Recent few-shot methods achieve strong results employing foundation-model features, but typically rely on memory banks, auxiliary datasets, or multi-modal tuning of vision-language models. We therefore question whether such complexity is necessary given the feature representations of vision foundation models. To answer this question, we introduce SubspaceAD, a training-free method, that operates in two simple stages. First, patch-level features are extracted from a small set of normal images by a frozen DINOv2 backbone. Second, a Principal Component Analysis (PCA) model is fit to these features to estimate the low-dimensional subspace of normal variations. At inference, anomalies are detected via the reconstruction residual with respect to this subspace, producing interpretable and statistically grounded anomaly scores. Despite its simplicity, SubspaceAD achieves state-of-the-art performance across one-shot and few-shot settings without training, prompt tuning, or memory banks. In the one-shot anomaly detection setting, SubspaceAD achieves image-level and pixel-level AUROC of 97.1% and 97.5% on the MVTec-AD dataset, and 93.2% and 98.2% on the VisA dataset, respectively, surpassing prior state-of-the-art results. Code and demo are available at https://github.com/CLendering/SubspaceAD."},{"descriptionType":"Other","description":"Accepted to CVPR 2026. Revised version with corrected AU-PRO evaluation and recomputed metrics"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.23013","contentUrl":null,"metadataVersion":2,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T03:00:22Z","registered":"2026-02-27T03:00:23Z","published":null,"updated":"2026-05-14T02:55:26Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.22474","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.22474","identifiers":[{"identifier":"2602.22474","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Jessie","familyName":"Yuan","name":"Yuan, Jessie","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yilin","familyName":"Wu","name":"Wu, Yilin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Andrea","familyName":"Bajcsy","name":"Bajcsy, Andrea","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"When to Act, Ask, or Learn: Uncertainty-Aware Policy Steering"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Robotics (cs.RO)","lang":"en","subjectScheme":"arXiv"},{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-25T23:23:22Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:11:44Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-05-12T19:47:13Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-05-14T00:09:08Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Policy steering is an emerging way to adapt robot behaviors at deployment-time: a learned verifier analyzes low-level action samples proposed by a pre-trained policy (e.g., diffusion policy) and selects only those aligned with the task. While Vision-Language Models (VLMs) are promising general-purpose verifiers due to their reasoning capabilities, existing frameworks often assume these models are well-calibrated. In practice, the overconfident judgment from VLM can degrade the steering performance under both high-level semantic uncertainty in task specifications and low-level action uncertainty or incapability of the pre-trained policy. We propose uncertainty-aware policy steering (UPS), a framework that jointly reasons about semantic task uncertainty and low-level action feasibility, and selects an uncertainty resolution strategy: execute a high-confidence action, clarify task ambiguity via natural language queries, or ask for action interventions to correct the low-level policy when it is deemed incapable at the task. We leverage conformal prediction to calibrate the composition of the VLM and the pre-trained base policy, providing statistical assurances that the verifier selects the correct strategy. After collecting interventions during deployment, we employ residual learning to improve the capability of the pre-trained policy, enabling the system to learn continually but with minimal expensive human feedback. We demonstrate our framework through experiments in simulation and on hardware, showing that UPS can disentangle confident, ambiguous, and incapable scenarios and minimizes expensive user interventions compared to uncalibrated baselines and prior human- or robot-gated continual learning approaches. Videos can be found at https://jessie-yuan.github.io/ups/"},{"descriptionType":"Other","description":"To appear in Robotics: Science and Systems 2026"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.22474","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T02:47:12Z","registered":"2026-02-27T02:47:13Z","published":null,"updated":"2026-05-14T02:55:24Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.22455","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.22455","identifiers":[{"identifier":"2602.22455","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Giuseppe","familyName":"Lando","name":"Lando, Giuseppe","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Rosario","familyName":"Forte","name":"Forte, Rosario","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Antonino","familyName":"Furnari","name":"Furnari, Antonino","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Exploring Multimodal LMMs for Online Episodic Memory Question Answering on the Edge"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-25T22:30:56Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:10:24Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-05-13T08:21:34Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-05-14T00:46:51Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"We investigate the feasibility of using Multimodal Large Language Models (MLLMs) for real-time online episodic memory question answering. While cloud offloading is common, it raises privacy and latency concerns for wearable assistants, hence we investigate implementation on the edge. We integrated streaming constraints into our question answering pipeline, which is structured into two asynchronous threads: a Descriptor Thread that continuously converts video into a lightweight textual memory, and a Question Answering (QA) Thread that reasons over the textual memory to answer queries. Experiments on the QAEgo4D-Closed benchmark analyze the performance of Multimodal Large Language Models (MLLMs) within strict resource boundaries, showing promising results also when compared to clound-based solutions. Specifically, an end-to-end configuration running on a consumer-grade 8GB GPU achieves 51.76% accuracy with a Time-To-First-Token (TTFT) of 0.41s. Scaling to a local enterprise-grade server yields 54.40% accuracy with a TTFT of 0.88s. In comparison, a cloud-based solution obtains an accuracy of 56.00%. These competitive results highlight the potential of edge-based solutions for privacy-preserving episodic memory retrieval."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.22455","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T02:46:46Z","registered":"2026-02-27T02:46:46Z","published":null,"updated":"2026-05-14T02:55:23Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.22251","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.22251","identifiers":[{"identifier":"2602.22251","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Alex","familyName":"Morehead","name":"Morehead, Alex","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Miruna","familyName":"Cretu","name":"Cretu, Miruna","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Antonia","familyName":"Panescu","name":"Panescu, Antonia","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Rishabh","familyName":"Anand","name":"Anand, Rishabh","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Maurice","familyName":"Weiler","name":"Weiler, Maurice","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Tynan","familyName":"Perez","name":"Perez, Tynan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Samuel","familyName":"Blau","name":"Blau, Samuel","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Steven","familyName":"Farrell","name":"Farrell, Steven","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Wahid","familyName":"Bhimji","name":"Bhimji, Wahid","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Anubhav","familyName":"Jain","name":"Jain, Anubhav","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Hrushikesh","familyName":"Sahasrabuddhe","name":"Sahasrabuddhe, Hrushikesh","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Pietro","familyName":"Lio","name":"Lio, Pietro","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Tommi","familyName":"Jaakkola","name":"Jaakkola, Tommi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Rafael","familyName":"Gomez-Bombarelli","name":"Gomez-Bombarelli, Rafael","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Rex","familyName":"Ying","name":"Ying, Rex","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"N. Benjamin","familyName":"Erichson","name":"Erichson, N. Benjamin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Michael W.","familyName":"Mahoney","name":"Mahoney, Michael W.","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Zatom-1: Towards a Multimodal Foundation Model for 3D Molecules and Materials"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"Materials Science (cond-mat.mtrl-sci)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-24T20:52:39Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:01:05Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-03-04T23:58:58Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-03-06T01:14:56Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-04-07T22:30:32Z","dateType":"Submitted","dateInformation":"v3"},{"date":"2026-04-09T00:12:39Z","dateType":"Updated","dateInformation":"v3"},{"date":"2026-05-13T17:47:24Z","dateType":"Submitted","dateInformation":"v4"},{"date":"2026-05-14T01:25:12Z","dateType":"Updated","dateInformation":"v4"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"4","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"General-purpose 3D modeling in chemistry encompasses molecules and materials, requiring both generative and predictive capabilities. However, most existing AI approaches are optimized for a single domain (molecules or materials) and a single task (generation or prediction), which limits representation sharing and transfer. We introduce Zatom-1, a cross-domain, general-purpose model architecture that unifies generative and predictive learning of 3D molecules and materials. Zatom-1 is a deliberately simplified Transformer trained with a multimodal flow matching objective that jointly models discrete atom types and continuous 3D geometries. This approach supports scalable pretraining with predictable gains as model capacity increases, while enabling fast and stable sampling. We use cross-domain generative pretraining as a universal initialization for downstream multi-task prediction of properties, energies, and forces. Empirically, Zatom-1 outperforms or competes with specialized baselines on both multi-task generative and predictive benchmarks in data-controlled settings, while improving generative inference speed by more than an order of magnitude. Our experiments demonstrate positive predictive transfer between data domains from joint generative pretraining: modeling materials during generative pretraining improves molecular property prediction accuracy. Open-source code and model weights are freely available at https://github.com/Zatom-AI/zatom."},{"descriptionType":"Other","description":"38 pages, 10 figures, 15 tables. ICLR 2026 FM4Science. Code, data, and model weights are available at https://github.com/Zatom-AI/zatom"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.22251","contentUrl":null,"metadataVersion":3,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T02:42:04Z","registered":"2026-02-27T02:42:05Z","published":null,"updated":"2026-05-14T02:55:22Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.22586","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.22586","identifiers":[{"identifier":"2602.22586","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Donghong","familyName":"Cai","name":"Cai, Donghong","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jiarui","familyName":"Feng","name":"Feng, Jiarui","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yanbo","familyName":"Wang","name":"Wang, Yanbo","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Da","familyName":"Zheng","name":"Zheng, Da","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yixin","familyName":"Chen","name":"Chen, Yixin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Muhan","familyName":"Zhang","name":"Zhang, Muhan","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"TabDLM: Free-Form Tabular Data Generation via Joint Numerical-Language Diffusion"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-26T03:41:49Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:21:32Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-05-11T21:05:21Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-05-13T00:12:58Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Synthetic tabular data generation has attracted growing attention due to its importance for data augmentation, foundation models, and privacy. However, real-world tabular datasets increasingly contain free-form text fields (e.g., reviews or clinical notes) alongside structured numerical and categorical attributes. Generating such heterogeneous tables with joint modeling of different modalities remains challenging. Existing approaches broadly fall into two categories: diffusion-based methods and LLM-based methods. Diffusion models can capture complex dependencies over numerical and categorical features in continuous or discrete spaces, but extending them to open-ended text is nontrivial and often leads to degraded text quality. In contrast, LLM-based generators naturally produce fluent text, yet their discrete tokenization can distort precise or wide-range numerical values, hindering accurate modeling of both numbers and language. In this work, we propose TabDLM, a unified framework for free-form tabular data generation via a joint numerical-language diffusion model built on masked diffusion language models (MDLMs). TabDLM models textual and categorical features through masked diffusion, while modeling numerical features with a continuous diffusion process through learned specialized numeric tokens embedding; bidirectional attention then captures cross-modality interactions within a single model. Extensive experiments on diverse benchmarks demonstrate the effectiveness of TabDLM compared to strong diffusion- and LLM-based baselines."},{"descriptionType":"Other","description":"Preprint"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.22586","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T02:49:51Z","registered":"2026-02-27T02:49:51Z","published":null,"updated":"2026-05-13T03:01:53Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.22507","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.22507","identifiers":[{"identifier":"2602.22507","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Zhuoyang","familyName":"Jiang","name":"Jiang, Zhuoyang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Dongqing","familyName":"Zhang","name":"Zhang, Dongqing","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Space Syntax-guided Post-training for Residential Floor Plan Generation"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-26T00:54:38Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:13:35Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-05-12T01:27:47Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-05-13T00:23:49Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Residential floor plan generation requires not only geometric fidelity but also spatial configurational logic: shared living spaces should be integrative, while private spaces should remain segregated. Existing generators increasingly use room-relation graphs as input-side conditions, but generated layouts are rarely evaluated on the output side for configurational quality, and such evaluation is rarely fed back into model optimization. We propose Space Syntax-guided Post-training (SSPT), a framework that turns space-syntax integration from a post-hoc analysis tool into a computable feedback signal for already-trained floor plan generators. SSPT introduces the Space Syntax Integration Oracle (SSIO), which converts generated layouts into rectangle-space graphs and measures public-space dominance and functional hierarchy. SSIO is first applied to real residential data to establish empirical configurational references, then connected to two SSPT strategies: SSPT-Iter, a basic generate-filter-retrain route, and SSPT-PPO, the first RL-based post-training route for floor plan generation. We also introduce SSPT-Bench, a new evaluation system for measuring the output-side spatial configurational quality of post-trained generators under an out-of-distribution setting. Experiments show that both strategies improve public-space dominance and functional-hierarchy alignment over the unpost-trained baseline. SSPT-PPO achieves stronger gains, lower variance, and higher efficiency than iterative retraining. These results show that output-side configurational evaluation can serve as actionable post-training feedback, offering a practical path for injecting architectural theory into existing floor plan generation backbones."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.22507","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T02:47:57Z","registered":"2026-02-27T02:47:58Z","published":null,"updated":"2026-05-13T03:01:52Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.22347","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.22347","identifiers":[{"identifier":"2602.22347","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Audun L","familyName":"Henriksen","name":"Henriksen, Audun L","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ole-Johan","familyName":"Skrede","name":"Skrede, Ole-Johan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Lisa","familyName":"van der Schee","name":"van der Schee, Lisa","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Enric","familyName":"Domingo","name":"Domingo, Enric","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Karolina","familyName":"Cyll","name":"Cyll, Karolina","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Sepp","familyName":"de Raedt","name":"de Raedt, Sepp","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ilyá","familyName":"Kostolomov","name":"Kostolomov, Ilyá","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jennifer","familyName":"Hay","name":"Hay, Jennifer","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Wanja","familyName":"Kildal","name":"Kildal, Wanja","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Joakim","familyName":"Kalsnes","name":"Kalsnes, Joakim","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Robert W","familyName":"Williams","name":"Williams, Robert W","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Manohar","familyName":"Pradhan","name":"Pradhan, Manohar","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"John Arne","familyName":"Nesheim","name":"Nesheim, John Arne","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Hanne","familyName":"Askautrud","name":"Askautrud, Hanne","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Maria","familyName":"Isaksen","name":"Isaksen, Maria","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Karmele Saez","familyName":"de Gordoa","name":"de Gordoa, Karmele Saez","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Miriam","familyName":"Cuatrecasas","name":"Cuatrecasas, Miriam","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Joanne","familyName":"Edwards","name":"Edwards, Joanne","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"TransSCOT","familyName":"group","name":"group, TransSCOT","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Arild","familyName":"Nesbakken","name":"Nesbakken, Arild","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Neil A","familyName":"Shepherd","name":"Shepherd, Neil A","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ian","familyName":"Tomlinson","name":"Tomlinson, Ian","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Daniel-Christoph","familyName":"Wagner","name":"Wagner, Daniel-Christoph","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Rachel","familyName":"Kerr","name":"Kerr, Rachel","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Tarjei Sveinsgjerd","familyName":"Hveem","name":"Hveem, Tarjei Sveinsgjerd","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Knut","familyName":"Liestøl","name":"Liestøl, Knut","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yoshiaki","familyName":"Nakamura","name":"Nakamura, Yoshiaki","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Marco","familyName":"Novelli","name":"Novelli, Marco","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Masaaki","familyName":"Miyo","name":"Miyo, Masaaki","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Sebastian","familyName":"Försch","name":"Försch, Sebastian","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"David N","familyName":"Church","name":"Church, David N","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Miangela M","familyName":"Lacle","name":"Lacle, Miangela M","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"David J","familyName":"Kerr","name":"Kerr, David J","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Andreas","familyName":"Kleppe","name":"Kleppe, Andreas","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Enabling clinical use of foundation models for computational pathology"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-25T19:13:11Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:03:32Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-05-12T15:35:25Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-05-13T01:15:54Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by-nc-nd/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution Non Commercial No Derivatives 4.0 International","rightsIdentifier":"cc-by-nc-nd-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Foundation models for computational pathology are expected to facilitate the development of high-performing, generalisable deep learning systems. However, in addition to biologically relevant features, current foundation models also capture pre-analytic and scanner-specific variation that bias the predictions made by downstream task-specific models trained on these features. Here we show that introducing novel robustness losses during downstream model training reduces sensitivity to technical variability. A purpose-designed comprehensive experimentation setup with 27,042 whole-slide images from 6,155 patients is used to train thousands of models from the features of eight well-known foundation models for computational pathology. In addition to a substantial improvement in robustness, our approach improves classification accuracy by focusing on biologically relevant features. It mitigates robustness limitations of foundation models for computational pathology without retraining the foundation models themselves, enabling development of models that are more suitable in real-world clinical use."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.22347","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T02:44:17Z","registered":"2026-02-27T02:44:18Z","published":null,"updated":"2026-05-13T03:01:50Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.22611","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.22611","identifiers":[{"identifier":"2602.22611","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Jiayang","familyName":"Meng","name":"Meng, Jiayang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Tao","familyName":"Huang","name":"Huang, Tao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Chen","familyName":"Hou","name":"Hou, Chen","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Guolong","familyName":"Zheng","name":"Zheng, Guolong","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Hong","familyName":"Chen","name":"Chen, Hong","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Mitigating Membership Inference in Intermediate Representations with Differentially Private Training"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-26T04:32:14Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:23:38Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-05-11T08:15:32Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-05-12T01:51:48Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"In Embedding-as-an-Interface (EaaI) settings, pre-trained models are queried for Intermediate Representations (IRs). The distributional properties of IRs can leak training-set membership signals, enabling Membership Inference Attacks (MIAs) whose strength varies across layers. Although Differentially Private Stochastic Gradient Descent (DP-SGD) mitigates such leakage, existing implementations employ per-example gradient clipping and a uniform, layer-agnostic noise multiplier, ignoring heterogeneous layer-wise MIA vulnerability. This paper introduces Layer-wise MIA-risk-aware DP-SGD (LM-DP-SGD), which adaptively allocates privacy protection across layers in proportion to their MIA risk. Specifically, LM-DP-SGD trains a shadow model on a public shadow dataset, extracts per-layer IRs from its train/test splits, and fits layer-specific MIA adversaries, using their attack error rates as MIA-risk estimates. Leveraging the cross-dataset transferability of MIAs, these estimates are then used to reweight each layer's contribution to the globally clipped gradient during private training, providing layer-appropriate protection under a fixed noise magnitude. We further establish theoretical guarantees on both privacy and convergence of LM-DP-SGD. Extensive experiments show that, under the same privacy budget, LM-DP-SGD reduces the peak IR-level MIA risk while preserving utility, yielding a superior privacy-utility trade-off."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.22611","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T02:50:26Z","registered":"2026-02-27T02:50:26Z","published":null,"updated":"2026-05-12T05:12:57Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.22508","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.22508","identifiers":[{"identifier":"2602.22508","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Ik-hwan","familyName":"Kim","name":"Kim, Ik-hwan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Hyeongrok","familyName":"Han","name":"Han, Hyeongrok","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Mingi","familyName":"Jung","name":"Jung, Mingi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Sangwon","familyName":"Yu","name":"Yu, Sangwon","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jinseok","familyName":"Hong","name":"Hong, Jinseok","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Sang Hun","familyName":"Kim","name":"Kim, Sang Hun","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yoonyoung","familyName":"Choi","name":"Choi, Yoonyoung","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Sungroh","familyName":"Yoon","name":"Yoon, Sungroh","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Metacognitive Behavioral Tuning of Large Language Models for Multi-Hop Question Answering"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-26T00:56:15Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:13:37Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-05-11T05:22:14Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-05-12T01:42:37Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by-nc-sa/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution Non Commercial Share Alike 4.0 International","rightsIdentifier":"cc-by-nc-sa-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Large Language Models (LLMs) often produce incorrect answers on multi-hop question answering even when the reasoning trace already contains a correct intermediate conclusion. We attribute this gap to weak self-regulation rather than insufficient reasoning capacity. Without explicit regulation, valid intermediate conclusions are overridden by continued exploration or left unrecognized as logically sufficient. We propose Metacognitive Behavioral Tuning (MBT), a post-training framework that injects a five-phase metacognitive structure into reasoning traces. The five phases are understanding and filtering, planning, execution and monitoring, self-correction, and verification. MBT has two formulations. MBT-S synthesizes new metacognitive traces from scratch, while MBT-R rewrites the student's own traces into a metacognitive form. Across HotpotQA, MuSiQue, and 2WikiMultiHopQA, MBT attains the highest Accuracy-Efficiency Score (AES) across model scales. MBT lifts task accuracy while keeping traces short and stable, with mean response length on MuSiQue an order of magnitude shorter than baseline methods and degeneration counts reduced by a similar margin. A matched-control study further confirms that the gain stems from the five-phase structural prior itself. To qualitatively assess the regulatory behavior of reasoning traces, we introduce two new metrics, the Reach-Redundancy Profile (RRP) and the length-aware Metacognitive Quality Index (MQI). RRP captures when the answer is reached and how much of the trace is redundant, and MQI quantifies how richly the five phases appear. Under both metrics, MBT achieves the earliest answer arrival, the lowest redundancy, and the richest phase-level behavior across model scales."},{"descriptionType":"Other","description":"41 pages"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.22508","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T02:47:59Z","registered":"2026-02-27T02:48:00Z","published":null,"updated":"2026-05-12T05:12:55Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.22831","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.22831","identifiers":[{"identifier":"2602.22831","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Phil","familyName":"Blandfort","name":"Blandfort, Phil","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Tushar","familyName":"Karayil","name":"Karayil, Tushar","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Alex","familyName":"McKenzie","name":"McKenzie, Alex","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Urja","familyName":"Pawar","name":"Pawar, Urja","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Robert","familyName":"Graham","name":"Graham, Robert","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Dmitrii","familyName":"Krasheninnikov","name":"Krasheninnikov, Dmitrii","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Direction-Flipped Influence Audits Reveal Hidden Structure in Moral Choices of LLMs"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"Computers and Society (cs.CY)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-26T10:17:57Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:37:19Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-05-08T00:42:32Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-05-11T00:24:04Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Moral benchmarks for LLMs typically score models on context-free prompts, implicitly treating the measured choice rate as stable. We test this assumption with a direction-flipped influence audit: for each scenario, we compare a baseline prompt with matched cues steering toward option A or option B. Across a trolley-problem-style moral triage task, BBQ, and DailyDilemmas, and across five LLM families with and without reasoning, short contextual cues shift per-condition choice rates by 12-18 percentage points on average. These shifts reveal structure that baseline scores miss: roughly 40% of baseline-neutral triage and BBQ conditions exhibit directional asymmetry under influence, and a meaningful share of significant effects backfire, moving opposite the cue's intended direction. In follow-up probes, models often recognize the cue while denying that it affected their choice. Among significant backfire trials, this stated-vs.-revealed inconsistency appears in 78% of cases. Reasoning does not eliminate contextual sensitivity but reshapes it: social-pressure cues such as user preference and emotional appeal weaken across benchmarks, while few-shot demonstrations strengthen sharply on both triage and BBQ. We recommend direction-flipped influence pairs as a standard complement to context-free moral-bias evaluation, and release the harness and data to make such audits routine."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.22831","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T02:55:45Z","registered":"2026-02-27T02:55:46Z","published":null,"updated":"2026-05-11T02:47:43Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.22859","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.22859","identifiers":[{"identifier":"2602.22859","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Hongrui","familyName":"Jia","name":"Jia, Hongrui","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Chaoya","familyName":"Jiang","name":"Jiang, Chaoya","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yongrui","familyName":"Heng","name":"Heng, Yongrui","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Shikun","familyName":"Zhang","name":"Zhang, Shikun","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Wei","familyName":"Ye","name":"Ye, Wei","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"From Blind Spots to Gains: Diagnostic-Driven Iterative Training for Large Multimodal Models"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-26T10:53:57Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:38:36Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-05-07T13:23:50Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-05-08T01:00:23Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"As Large Multimodal Models (LMMs) scale up and reinforcement learning (RL) methods mature, LMMs have made notable progress in complex reasoning and decision making. Yet training still relies on static data and fixed recipes, making it difficult to diagnose capability blind spots or provide dynamic, targeted reinforcement. Motivated by findings that test driven error exposure and feedback based correction outperform repetitive practice, we propose Diagnostic-driven Progressive Evolution (DPE), a spiral loop where diagnosis steers data generation and reinforcement, and each iteration re-diagnoses the updated model to drive the next round of targeted improvement. DPE has two key components. First, multiple agents annotate and quality control massive unlabeled multimodal data, using tools such as web search and image editing to produce diverse, realistic samples. Second, DPE attributes failures to specific weaknesses, dynamically adjusts the data mixture, and guides agents to generate weakness focused data for targeted reinforcement. Experiments on Qwen3-VL-8B-Instruct and Qwen2.5-VL-7B-Instruct show stable, continual gains across eleven benchmarks, indicating DPE as a scalable paradigm for continual LMM training under open task distributions. Our code, models, and data are publicly available at https://github.com/hongruijia/DPE."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.22859","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T02:56:32Z","registered":"2026-02-27T02:56:33Z","published":null,"updated":"2026-05-08T12:55:31Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.22710","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.22710","identifiers":[{"identifier":"2602.22710","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Aaron","familyName":"Broukhim","name":"Broukhim, Aaron","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Nadir","familyName":"Weibel","name":"Weibel, Nadir","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Eshin","familyName":"Jolly","name":"Jolly, Eshin","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Same Words, Different Judgments: How Preferences Vary Across Modalities"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Sound (cs.SD)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"Human-Computer Interaction (cs.HC)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-26T07:34:15Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:30:26Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-05-06T21:24:15Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-05-08T00:10:48Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Preference-based reinforcement learning (PbRL) is the dominant framework for aligning AI systems to human preferences. However, evaluation protocols for such data were designed for text and have not been validated for speech. We present the first ICC-based, controlled cross-modal study of human and synthetic preference annotations, comparing text and audio evaluations of identical semantic content across 100 prompts. We show that achieving $\\textit{good}$ agreement within either modality (ICC(2,$k$) $\\approx$ .80) requires $\\sim$9 raters. At the same time, modalities show marked differences in how people report preferences: audio raters exhibit narrower decision thresholds, reduced length bias, and more user-oriented evaluation criteria, with near-chance cross-modality agreement. We demonstrate that synthetic ratings can be used to effectively predict inter-rater agreement, thus serving as an early signal for stimulus selection and proxy for human annotations. Together, these findings argue that evaluation protocols for audio preference data require modality-specific design rather than direct adaptation from text."},{"descriptionType":"Other","description":"Submitted to NeurIPS 2026 for review"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.22710","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T02:52:47Z","registered":"2026-02-27T02:52:48Z","published":null,"updated":"2026-05-08T12:55:30Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.22457","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.22457","identifiers":[{"identifier":"2602.22457","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","affiliation":["UC Merced"],"givenName":"Dong","familyName":"Xu","name":"Xu, Dong","nameIdentifiers":[]},{"nameType":"Personal","affiliation":["UC Merced"],"givenName":"Han","familyName":"Meng","name":"Meng, Han","nameIdentifiers":[]},{"nameType":"Personal","affiliation":["Zhejinag University"],"givenName":"Xinyu","familyName":"Chen","name":"Chen, Xinyu","nameIdentifiers":[]},{"nameType":"Personal","affiliation":["Bytedance and"],"givenName":"Dengcheng","familyName":"Zhu","name":"Zhu, Dengcheng","nameIdentifiers":[]},{"nameType":"Personal","affiliation":["Bytedance and"],"givenName":"Wei","familyName":"Tang","name":"Tang, Wei","nameIdentifiers":[]},{"nameType":"Personal","affiliation":["Bytedance and"],"givenName":"Fei","familyName":"Liu","name":"Liu, Fei","nameIdentifiers":[]},{"nameType":"Personal","affiliation":["Bytedance and"],"givenName":"Liguang","familyName":"Xie","name":"Xie, Liguang","nameIdentifiers":[]},{"nameType":"Personal","affiliation":["Bytedance and"],"givenName":"Wu","familyName":"Xiang","name":"Xiang, Wu","nameIdentifiers":[]},{"nameType":"Personal","affiliation":["Bytedance and"],"givenName":"Rui","familyName":"Shi","name":"Shi, Rui","nameIdentifiers":[]},{"nameType":"Personal","affiliation":["Bytedance and"],"givenName":"Yue","familyName":"Li","name":"Li, Yue","nameIdentifiers":[]},{"nameType":"Personal","affiliation":["Bytedance and"],"givenName":"Henry","familyName":"Hu","name":"Hu, Henry","nameIdentifiers":[]},{"nameType":"Personal","affiliation":["Bytedance and"],"givenName":"Hui","familyName":"Zhang","name":"Zhang, Hui","nameIdentifiers":[]},{"nameType":"Personal","affiliation":["Xconn-tech"],"givenName":"Jianping","familyName":"Jiang","name":"Jiang, Jianping","nameIdentifiers":[]},{"nameType":"Personal","affiliation":["UC Merced"],"givenName":"Dong","familyName":"Li","name":"Li, Dong","nameIdentifiers":[]}],"titles":[{"title":"CCCL: Node-Spanning GPU Collectives with CXL Memory Pooling"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Distributed, Parallel, and Cluster Computing (cs.DC)","lang":"en","subjectScheme":"arXiv"},{"subject":"Emerging Technologies (cs.ET)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-25T22:38:46Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:10:34Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-05-05T05:18:40Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-05-06T00:24:00Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-05-06T19:02:10Z","dateType":"Submitted","dateInformation":"v3"},{"date":"2026-05-08T00:05:50Z","dateType":"Updated","dateInformation":"v3"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"3","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Large language models (LLMs) training or inference across multiple nodes introduces significant pressure on GPU memory and interconnect bandwidth. The Compute Express Link (CXL) shared memory pool offers a scalable solution by enabling memory sharing across nodes, reducing over-provisioning and improving resource utilization. We propose \\name, a collective communication library, leveraging the CXL shared memory pool to support cross-node GPU operations without relying on traditional RDMA-based networking. Our design addresses the challenges on synchronization, data interleaving, and communication parallelization faced by using the CXL shared memory pool for collective communications. Evaluating on multiple nodes with a TITAN-II CXL switch and six Micron CZ120 memory cards, we show that \\name achieves highly efficient collective operations across hosts, demonstrating CXL's potential for scalable, memory-centric GPU communication. Our evaluation demonstrates that \\name achieves average performance improvements of 1.34$\\times$ for AllGather, 1.84$\\times$ for Broadcast, 1.94$\\times$ for Gather, and 1.04$\\times$ for Scatter, compared to the original RDMA-based implementation over 200 Gbps InfiniBand. \\textcolor{dong}{In addition, the evaluation with a case of LLM training shows 1.11$\\times$ speedup compared with the InfiniBand while saving production cost by $2.75\\times$ in hardware.}"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.22457","contentUrl":null,"metadataVersion":2,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T02:46:48Z","registered":"2026-02-27T02:46:49Z","published":null,"updated":"2026-05-08T12:55:29Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.22291","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.22291","identifiers":[{"identifier":"2602.22291","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Sarthak","familyName":"Munshi","name":"Munshi, Sarthak","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Manish","familyName":"Bhatt","name":"Bhatt, Manish","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Vineeth Sai","familyName":"Narajala","name":"Narajala, Vineeth Sai","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Idan","familyName":"Habler","name":"Habler, Idan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ammar","familyName":"Al-Kahfah","name":"Al-Kahfah, Ammar","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ken","familyName":"Huang","name":"Huang, Ken","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Blake","familyName":"Gatto","name":"Gatto, Blake","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Manifold of Failure: Behavioral Attraction Basins in Language Models"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"Cryptography and Security (cs.CR)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-25T15:08:20Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:02:00Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02-27T17:04:02Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-03-02T01:57:25Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-05-06T04:01:57Z","dateType":"Submitted","dateInformation":"v3"},{"date":"2026-05-07T00:22:14Z","dateType":"Updated","dateInformation":"v3"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"3","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"While prior work has focused on projecting adversarial examples back onto the manifold of natural data to restore safety, we argue that a comprehensive understanding of AI safety requires characterizing the unsafe regions themselves. This paper introduces a framework for systematically mapping the Manifold of Failure in Large Language Models (LLMs). We reframe the search for vulnerabilities as a quality diversity problem, using MAP-Elites to illuminate the continuous topology of these failure regions, which we term behavioral attraction basins. Our quality metric, Alignment Deviation, guides the search towards areas where the model's behavior diverges most from its intended alignment. Across three LLMs: Llama-3-8B, GPT-OSS-20B, and GPT-5-Mini, we show that MAP-Elites achieves up to 63% behavioral coverage, discovers up to 370 distinct vulnerability niches, and reveals dramatically different model-specific topological signatures: Llama-3-8B exhibits a near-universal vulnerability plateau (mean Alignment Deviation 0.93), GPT-OSS-20B shows a fragmented landscape with spatially concentrated basins (mean 0.73), and GPT-5-Mini demonstrates strong robustness with a ceiling at 0.50. Our approach produces interpretable, global maps of each model's safety landscape that no existing attack method (GCG, PAIR, or TAP) can provide, shifting the paradigm from finding discrete failures to understanding their underlying structure."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.22291","contentUrl":null,"metadataVersion":2,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T02:42:59Z","registered":"2026-02-27T02:43:00Z","published":null,"updated":"2026-05-07T02:23:32Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.22575","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.22575","identifiers":[{"identifier":"2602.22575","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Yu","familyName":"Zhang","name":"Zhang, Yu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Songwei","familyName":"Liu","name":"Liu, Songwei","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Chenqian","familyName":"Yan","name":"Yan, Chenqian","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Sheng","familyName":"Lin","name":"Lin, Sheng","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Beichen","familyName":"Ning","name":"Ning, Beichen","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Fangmin","familyName":"Chen","name":"Chen, Fangmin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xing","familyName":"Wang","name":"Wang, Xing","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"S2O: Early Stopping for Sparse Attention via Online Permutation"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-26T03:30:28Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:20:46Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-05-05T13:29:50Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-05-06T00:46:39Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Attention scales quadratically with sequence length, fundamentally limiting long-context inference. Existing block-granularity sparsification can reduce latency, but coarse blocks impose an intrinsic sparsity ceiling, making further improvements difficult even with carefully engineered designs. We present S2O, which performs early stopping for sparse attention via online permutation. Inspired by virtual-to-physical address mapping in memory systems, S2O revisits and factorizes FlashAttention execution, enabling inference to load non-contiguous tokens rather than a contiguous span in the original order. Motivated by fine-grained structures in attention heatmaps, we transform explicit permutation into an online, index-guided, discrete loading policy; with extremely lightweight preprocessing and index-remapping overhead, it concentrates importance on a small set of high-priority blocks. Building on this importance-guided online permutation for loading, S2O further introduces an early-stopping rule: computation proceeds from high to low importance; once the current block score falls below a threshold, S2O terminates early and skips the remaining low-contribution blocks, thereby increasing effective sparsity and reducing computation under a controlled error budget.\n As a result, S2O substantially raises the practical sparsity ceiling. On Llama-3.1-8B under a 128K context, S2O reduces single-operator MSE by 3.82$\\times$ at matched sparsity, and reduces prefill compute density by 3.31$\\times$ at matched MSE; meanwhile, it preserves end-to-end accuracy and achieves 7.51$\\times$ attention and 3.81$\\times$ end-to-end speedups."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.22575","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T02:49:35Z","registered":"2026-02-27T02:49:35Z","published":null,"updated":"2026-05-06T02:18:02Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.23163","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.23163","identifiers":[{"identifier":"2602.23163","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Usman","familyName":"Anwar","name":"Anwar, Usman","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Julianna","familyName":"Piskorz","name":"Piskorz, Julianna","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"David D.","familyName":"Baek","name":"Baek, David D.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"David","familyName":"Africa","name":"Africa, David","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jim","familyName":"Weatherall","name":"Weatherall, Jim","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Max","familyName":"Tegmark","name":"Tegmark, Max","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Christian Schroeder","familyName":"de Witt","name":"de Witt, Christian Schroeder","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Mihaela","familyName":"van der Schaar","name":"van der Schaar, Mihaela","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"David","familyName":"Krueger","name":"Krueger, David","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"A Decision-Theoretic Formalisation of Steganography With Applications to LLM Monitoring"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"Cryptography and Security (cs.CR)","lang":"en","subjectScheme":"arXiv"},{"subject":"Information Theory (cs.IT)","lang":"en","subjectScheme":"arXiv"},{"subject":"Multiagent Systems (cs.MA)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-26T16:27:24Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:55:17Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-03-13T15:55:32Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-03-16T00:56:57Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-04-29T17:15:03Z","dateType":"Submitted","dateInformation":"v3"},{"date":"2026-04-30T01:01:56Z","dateType":"Updated","dateInformation":"v3"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"3","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Large language models are beginning to show steganographic capabilities. Such capabilities could allow misaligned models to evade oversight mechanisms. Yet principled methods to detect and quantify such behaviours are lacking. Classical definitions of steganography, and detection methods based on them, require a known reference distribution of non-steganographic signals. For the case of steganographic reasoning in LLMs, knowing such a reference distribution is not feasible; this renders these approaches inapplicable. We propose an alternative, \\textbf{decision-theoretic view of steganography}. Our central insight is that steganography creates an asymmetry in usable information between agents who can and cannot decode the hidden content (present within a steganographic signal), and this otherwise latent asymmetry can be inferred from the agents' observable actions. To formalise this perspective, we introduce generalised $\\mathcal{V}$-information: a utilitarian framework for measuring the amount of usable information within some input. We use this to define the \\textbf{steganographic gap} -- a measure that quantifies steganography by comparing the downstream utility of the steganographic signal to agents that can and cannot decode the hidden content. We empirically validate our formalism, and show that it can be used to detect, quantify, and mitigate steganographic reasoning in LLMs."},{"descriptionType":"Other","description":"First two authors contributed equally"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.23163","contentUrl":null,"metadataVersion":2,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T03:03:59Z","registered":"2026-02-27T03:04:00Z","published":null,"updated":"2026-04-30T02:24:37Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.22591","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.22591","identifiers":[{"identifier":"2602.22591","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Haodong","familyName":"Chen","name":"Chen, Haodong","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Shengyao","familyName":"Zhuang","name":"Zhuang, Shengyao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zheng","familyName":"Yao","name":"Yao, Zheng","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Guido","familyName":"Zuccon","name":"Zuccon, Guido","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Teerapong","familyName":"Leelanupab","name":"Leelanupab, Teerapong","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Where Relevance Emerges: A Layer-Wise Study of Internal Attention for Zero-Shot Re-Ranking"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Information Retrieval (cs.IR)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"H.3.3","lang":"en","subjectScheme":"ACM"}],"contributors":[],"dates":[{"date":"2026-02-26T03:51:31Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:21:46Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-04-25T11:08:33Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-04-28T00:28:57Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[{"relationType":"IsVersionOf","relatedIdentifier":"10.1145/3805712.3808558","relatedIdentifierType":"DOI"}],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Zero-shot document re-ranking with Large Language Models (LLMs) has evolved from Pointwise methods to Listwise and Setwise approaches that optimize computational efficiency. Despite their success, these methods predominantly rely on generative scoring or output logits, which face bottlenecks in inference latency and result consistency. In-Context Re-ranking (ICR) has recently been proposed as an O(1) alternative method. ICR extracts internal attention signals directly, avoiding the overhead of text generation. However, existing ICR methods simply aggregate signals across all layers; layer-wise contributions and their consistency across architectures have been left unexplored. Furthermore, no unified study has compared internal attention with traditional generative and likelihood-based mechanisms across diverse ranking frameworks under consistent conditions.\n In this paper, we conduct an orthogonal evaluation of generation, likelihood, and internal attention mechanisms across multiple ranking frameworks. We further identify a universal \"bell-curve\" distribution of relevance signals across transformer layers, which motivates the proposed Selective-ICR strategy that reduces inference latency by 30%-50% without compromising effectiveness. Finally, evaluation on the reasoning-intensive BRIGHT benchmark shows that precisely capturing high-quality in-context attention signals fundamentally reduces the need for model scaling and reinforcement learning: a zero-shot 8B model matches the performance of 14B reinforcement-learned re-rankers, while even a 0.6B model outperforms state-of-the-art generation-based approaches. These findings redefine the efficiency-effectiveness frontier for LLM-based re-ranking and highlight the latent potential of internal signals for complex reasoning ranking tasks. Our code and results are publicly available at https://github.com/ielab/Selective-ICR."},{"descriptionType":"Other","description":"Accepted by SIGIR 2026. 10 pages, 5 figures, 4 tables. Code available at https://github.com/ielab/Selective-ICR"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.22591","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T02:49:58Z","registered":"2026-02-27T02:49:58Z","published":null,"updated":"2026-04-28T04:12:15Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.22525","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.22525","identifiers":[{"identifier":"2602.22525","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Zhonghao","familyName":"Zhan","name":"Zhan, Zhonghao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Krinos","familyName":"Li","name":"Li, Krinos","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yefan","familyName":"Zhang","name":"Zhang, Yefan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Hamed","familyName":"Haddadi","name":"Haddadi, Hamed","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Systems-Level Attack Surface of Edge Agent Deployments on IoT"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Cryptography and Security (cs.CR)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-26T01:48:46Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:15:03Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-04-21T21:13:49Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-04-23T00:11:03Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Edge deployment of LLM agents on IoT hardware introduces attack surfaces absent from cloud-hosted orchestration. We present an empirical security analysis of three architectures (cloud-hosted, edge-local swarm, and hybrid) using a multi-device home-automation testbed with local MQTT messaging and an Android smartphone as an edge inference node. We identify five systems-level attack surfaces, including two emergent failures observed during live testbed operation: coordination-state divergence and induced trust erosion. We frame core security properties as measurable systems metrics: data egress volume, failover window exposure, sovereignty boundary integrity, and provenance chain completeness. Our measurements show that edge-local deployments eliminate routine cloud data exposure but silently degrade sovereignty when fallback mechanisms trigger, with boundary crossings invisible at the application layer. Provenance chains remain complete under cooperative operation yet are trivially bypassed without cryptographic enforcement. Failover windows create transient blind spots exploitable for unauthorised actuation. These results demonstrate that deployment architecture, not just model or prompt design, is a primary determinant of security risk in agent-controlled IoT systems."},{"descriptionType":"Other","description":"Proceedings of the 6th Workshop on Machine Learning and Systems (EuroMLSys '26), co-located with EuroSys 2026"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.22525","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T02:48:23Z","registered":"2026-02-27T02:48:24Z","published":null,"updated":"2026-04-23T02:26:37Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.22437","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.22437","identifiers":[{"identifier":"2602.22437","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Zezhou","familyName":"Wang","name":"Wang, Zezhou","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Youjie","familyName":"Li","name":"Li, Youjie","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zhiqi","familyName":"Lin","name":"Lin, Zhiqi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jiacheng","familyName":"Yang","name":"Yang, Jiacheng","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Cong","familyName":"Xie","name":"Xie, Cong","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Guanyu","familyName":"Feng","name":"Feng, Guanyu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zheng","familyName":"Zhong","name":"Zhong, Zheng","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ziyue","familyName":"Huang","name":"Huang, Ziyue","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Hongyu","familyName":"Zhu","name":"Zhu, Hongyu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zhi","familyName":"Zhang","name":"Zhang, Zhi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yanghua","familyName":"Peng","name":"Peng, Yanghua","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xin","familyName":"Liu","name":"Liu, Xin","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"veScale-FSDP: Flexible and High-Performance FSDP at Scale"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Distributed, Parallel, and Cluster Computing (cs.DC)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-25T21:55:43Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:09:45Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02-27T03:28:11Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-03-02T01:19:01Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-04-21T21:24:42Z","dateType":"Submitted","dateInformation":"v3"},{"date":"2026-04-23T00:11:50Z","dateType":"Updated","dateInformation":"v3"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"3","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by-nc-nd/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution Non Commercial No Derivatives 4.0 International","rightsIdentifier":"cc-by-nc-nd-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Fully Sharded Data Parallel (FSDP), also known as Zero Redundancy Optimizer (ZeRO), is widely used for large-scale model training, because of its memory efficiency and minimal intrusion on model code. However, existing FSDP systems rely on fixed element-wise or row-wise sharding formats that conflict with block-structured computations. As a result, they struggle to support modern structure-aware training methods, including block-wise quantization and non-element-wise optimizers such as Shampoo and Muon. In addition, today's implementations incur communication and memory overheads that degrade efficiency at the scale of tens of thousands of GPUs. We introduce veScale-FSDP, a novel FSDP system that combines RaggedShard, a flexible sharding format, with a structure-aware planning algorithm to deliver both flexibility and performance. veScale-FSDP enables zero-copy FSDP communications and natively supports block-wise quantization and non-element-wise optimizers, achieving 5% to 66% higher throughput and 16% to 30% lower memory usage than existing FSDP systems, while scaling efficiently to tens of thousands of GPUs."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.22437","contentUrl":null,"metadataVersion":2,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T02:46:22Z","registered":"2026-02-27T02:46:23Z","published":null,"updated":"2026-04-23T02:26:36Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.22378","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.22378","identifiers":[{"identifier":"2602.22378","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Daniel","familyName":"Rossato","name":"Rossato, Daniel","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Thiago Alberto Rigo","familyName":"Passarin","name":"Passarin, Thiago Alberto Rigo","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Gustavo Pinto","familyName":"Pires","name":"Pires, Gustavo Pinto","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Daniel Rodrigues","familyName":"Pipa","name":"Pipa, Daniel Rodrigues","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Full Waveform Inversion using the Wasserstein metric for ultrasound transducer array based NDT"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Signal Processing (eess.SP)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Electrical engineering, electronic engineering, information engineering","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Electrical engineering, electronic engineering, information engineering","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-25T20:21:41Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:06:28Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-04-22T12:54:18Z","dateType":"Withdrawn","dateInformation":"v2; Paper will undergo a large revision"},{"date":"2026-04-23T00:50:13Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Ultrasonic imaging methods often assume linear direct models, while in reality, many nonlinear phenomena are present, e.g. multiple reflections. A family of imaging methods called Full Waveform Inversion (FWI), which has been developed in the field of seismic imaging, uses full acoustic wave simulations as direct models, taking into account virtually all nonlinearities, which can ultimately enhance the accuracy of ultrasonic imaging. However, the problem of cycle skipping -- the existence of many local minima of the Least Squares (L2) misfit function due to the oscillatory nature of the signals -- is worsened when FWI is applied to ultrasound data because of a lack of low-frequency components. In this paper, we explore the use of the squared Wasserstein (W2) Optimal Transport Distance as the metric for the misfit between the acquired and the synthetic data, applying the method to Nondestructive Evaluation with ultrasonic phased arrays. An analytical continuous time-domain derivation of the adjoint acoustic field related to the W2 misfit is presented and used for the computation of the gradients. To cope with the computational burden of FWI, we apply a low-memory strategy that allows for the computation of the gradients without the storage of the full simulated fields. The GPU implementation of the method (in CUDA language) is detailed, and the source code is made available. Six prototypical cases are presented, and the corresponding sound speed maps are reconstructed with FWI using both the L2 and the W2 misfit functionals. In five of the six cases, the pixel-wise sum of squared errors obtained with W2 was at least one order of magnitude lower than that obtained with W2, with an increase in the gradient computation time not exceeding 2\\%. The results highlight both the adequacy of the W2 misfit for ultrasonic FWI with phased arrays and its computational feasibility."},{"descriptionType":"Other","description":"Paper will undergo a large revision"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.22378","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T02:45:01Z","registered":"2026-02-27T02:45:01Z","published":null,"updated":"2026-04-23T02:26:35Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.22913","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.22913","identifiers":[{"identifier":"2602.22913","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Yang","familyName":"Yu","name":"Yu, Yang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Lei","familyName":"Kou","name":"Kou, Lei","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Huaikuan","familyName":"Yi","name":"Yi, Huaikuan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Bin","familyName":"Chen","name":"Chen, Bin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yayu","familyName":"Cao","name":"Cao, Yayu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Lei","familyName":"Shen","name":"Shen, Lei","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Chao","familyName":"Zhang","name":"Zhang, Chao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Bing","familyName":"Wang","name":"Wang, Bing","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xiaoyi","familyName":"Zeng","name":"Zeng, Xiaoyi","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"SIGMA: A Semantic-Grounded Instruction-Driven Generative Multi-Task Recommender at AliExpress"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Information Retrieval (cs.IR)","lang":"en","subjectScheme":"arXiv"},{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-26T12:00:46Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:41:29Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-04-19T12:51:50Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-04-21T01:11:18Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"With the rapid evolution of Large Language Models (LLMs), generative recommendation is gradually reshaping the paradigm of recommender systems. However, most existing methods remain confined to the interaction-driven next-item prediction paradigm, struggling to keep pace with the latest evolving trends or address the diverse recommendation tasks along with business-specific requirements in real-world scenarios. To this end, we present SIGMA, a Semantic-Grounded Instruction-Driven Generative Multi-Task Recommender deployed at AliExpress. Specifically, we first ground item entities in a unified latent space capturing both general semantics and collaborative signals. Building upon this, we introduce a hybrid item tokenization method for both precise modeling and efficient generation. Moreover, we construct a large-scale multi-task supervised fine-tuning dataset empowering SIGMA to fulfill various recommendation demands via instruction-following. Finally, we design a three-step item generation procedure integrated with an adaptive probabilistic fusion mechanism to calibrate the output distributions based on task-specific requirements for recommendation accuracy and diversity. Extensive offline experiments and online A/B tests demonstrate the effectiveness of SIGMA across various real-world recommendation tasks."},{"descriptionType":"Other","description":"Accepted by SIGIR 2026 Industry Track. 5 pages, 3 figures"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.22913","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T02:57:50Z","registered":"2026-02-27T02:57:50Z","published":null,"updated":"2026-04-21T04:59:12Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.22479","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.22479","identifiers":[{"identifier":"2602.22479","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Afshin","familyName":"Khadangi","name":"Khadangi, Afshin","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Efficient Continual Learning in Language Models via Thalamically Routed Cortical Columns"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-25T23:38:16Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:11:58Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-03-15T15:57:48Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-03-17T01:25:27Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-03-17T17:02:11Z","dateType":"Submitted","dateInformation":"v3"},{"date":"2026-03-18T01:23:53Z","dateType":"Updated","dateInformation":"v3"},{"date":"2026-03-25T15:46:31Z","dateType":"Submitted","dateInformation":"v4"},{"date":"2026-03-26T01:04:23Z","dateType":"Updated","dateInformation":"v4"},{"date":"2026-03-27T10:50:18Z","dateType":"Submitted","dateInformation":"v5"},{"date":"2026-03-30T00:42:31Z","dateType":"Updated","dateInformation":"v5"},{"date":"2026-04-17T17:13:27Z","dateType":"Submitted","dateInformation":"v6"},{"date":"2026-04-20T01:01:41Z","dateType":"Updated","dateInformation":"v6"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"6","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Large language models deployed in the wild must adapt to evolving data, user behavior, and task mixtures without erasing previously acquired capabilities. In practice, this remains difficult: sequential updates induce catastrophic forgetting, while many stabilization methods rely on external procedures that are costly, brittle, or difficult to scale. We present TRC$^{2}$ (Thalamically Routed Cortical Columns), a decoder-only architecture that makes continual learning a property of the backbone itself. TRC$^{2}$ combines stacked cortical columns with a thalamic modulatory pathway for selective inter-column communication and a hippocampal pathway for event selective retrieval, delayed surprise-based writing, and replay-driven consolidation. This design localizes fast plasticity while preserving a slower stable computation pathway. We further introduce a causal memory-update scheme and an online replay controller that adjusts consolidation strength from measured forgetting. Across a task-sequential language-modeling stream over C4, WikiText-103, and GSM8K, TRC$^{2}$ consistently improves task-boundary modeling quality and substantially reduces cumulative forgetting relative to Transformer, Mamba, MoE, DeepSeek and continual learning baselines trained under the same pipeline. Ablations show that the thalamic and hippocampal components are central to the retention gains, while the full model remains competitive in throughput and training cost."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.22479","contentUrl":null,"metadataVersion":5,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T02:47:19Z","registered":"2026-02-27T02:47:20Z","published":null,"updated":"2026-04-20T02:12:53Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.22699","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.22699","identifiers":[{"identifier":"2602.22699","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Tomoya","familyName":"Matsumoto","name":"Matsumoto, Tomoya","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Shokichi","familyName":"Takakura","name":"Takakura, Shokichi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Shun","familyName":"Takagi","name":"Takagi, Shun","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Satoshi","familyName":"Hasegawa","name":"Hasegawa, Satoshi","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"DPSQL+: A Differentially Private SQL Library with a Minimum Frequency Rule"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Cryptography and Security (cs.CR)","lang":"en","subjectScheme":"arXiv"},{"subject":"Databases (cs.DB)","lang":"en","subjectScheme":"arXiv"},{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-26T07:21:00Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:30:00Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-04-16T02:14:21Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-04-17T00:20:37Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"SQL is the de facto interface for exploratory data analysis; however, releasing exact query results can expose sensitive information through membership or attribute inference attacks. Differential privacy (DP) provides rigorous privacy guarantees, but in practice, DP alone may not satisfy governance requirements such as the \\emph{minimum frequency rule}, which requires each released group (cell) to include contributions from at least $k$ distinct individuals. In this paper, we present \\textbf{DPSQL+}, a privacy-preserving SQL library that simultaneously enforces user-level $(\\varepsilon,δ)$-DP and the minimum frequency rule. DPSQL+ adopts a modular architecture consisting of: (i) a \\emph{Validator} that statically restricts queries to a DP-safe subset of SQL; (ii) an \\emph{Accountant} that consistently tracks cumulative privacy loss across multiple queries; and (iii) a \\emph{Backend} that interfaces with various database engines, ensuring portability and extensibility. Experiments on the TPC-H benchmark demonstrate that DPSQL+ achieves practical accuracy across a wide range of analytical workloads -- from basic aggregates to quadratic statistics and join operations -- and allows substantially more queries under a fixed global privacy budget than prior libraries in our evaluation."},{"descriptionType":"Other","description":"Accepted to TPDP 2026. Code is available at https://github.com/lycorp-jp/DPSQL_Plus"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.22699","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T02:52:32Z","registered":"2026-02-27T02:52:33Z","published":null,"updated":"2026-04-17T02:22:00Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.23061","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.23061","identifiers":[{"identifier":"2602.23061","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Bangrui","familyName":"Xu","name":"Xu, Bangrui","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Qihang","familyName":"Yao","name":"Yao, Qihang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zirui","familyName":"Tang","name":"Tang, Zirui","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xuanhe","familyName":"Zhou","name":"Zhou, Xuanhe","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yeye","familyName":"He","name":"He, Yeye","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Shihan","familyName":"Yu","name":"Yu, Shihan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Qianqian","familyName":"Xu","name":"Xu, Qianqian","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Bin","familyName":"Wang","name":"Wang, Bin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Guoliang","familyName":"Li","name":"Li, Guoliang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Conghui","familyName":"He","name":"He, Conghui","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Fan","familyName":"Wu","name":"Wu, Fan","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"MoDora: Tree-Based Semi-Structured Document Analysis System"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Information Retrieval (cs.IR)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"Databases (cs.DB)","lang":"en","subjectScheme":"arXiv"},{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-26T14:48:49Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:49:58Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02-27T08:09:20Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-03-02T01:31:33Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-04-14T04:49:27Z","dateType":"Submitted","dateInformation":"v3"},{"date":"2026-04-15T00:26:19Z","dateType":"Updated","dateInformation":"v3"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"3","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Semi-structured documents integrate diverse interleaved data elements (e.g., tables, charts, hierarchical paragraphs) arranged in various and often irregular layouts. These documents are widely observed across domains and account for a large portion of real-world data. However, existing methods struggle to support natural language question answering over these documents due to three main technical challenges: (1) The elements extracted by techniques like OCR are often fragmented and stripped of their original semantic context, making them inadequate for analysis. (2) Existing approaches lack effective representations to capture hierarchical structures within documents (e.g., associating tables with nested chapter titles) and to preserve layout-specific distinctions (e.g., differentiating sidebars from main content). (3) Answering questions often requires retrieving and aligning relevant information scattered across multiple regions or pages, such as linking a descriptive paragraph to table cells located elsewhere in the document.\n To address these issues, we propose MoDora, an LLM-powered system for semi-structured document analysis. First, we adopt a local-alignment aggregation strategy to convert OCR-parsed elements into layout-aware components, and conduct type-specific information extraction for components with hierarchical titles or non-text elements. Second, we design the Component-Correlation Tree (CCTree) to hierarchically organize components, explicitly modeling inter-component relations and layout distinctions through a bottom-up cascade summarization process. Finally, we propose a question-type-aware retrieval strategy that supports (1) layout-based grid partitioning for location-based retrieval and (2) LLM-guided pruning for semantic-based retrieval. Experiments show MoDora outperforms baselines by 5.97%-61.07% in accuracy. The code is at https://github.com/weAIDB/MoDora."},{"descriptionType":"Other","description":"Extension of our SIGMOD 2026 paper. Please refer to source code available at https://github.com/weAIDB/MoDora"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.23061","contentUrl":null,"metadataVersion":2,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T03:01:30Z","registered":"2026-02-27T03:01:31Z","published":null,"updated":"2026-04-15T02:27:51Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.23195","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.23195","identifiers":[{"identifier":"2602.23195","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Alexander G.","familyName":"Tevzadze","name":"Tevzadze, Alexander G.","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Spectral Universality of Turbulent Fluctuations in Relativistic Flows"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"High Energy Astrophysical Phenomena (astro-ph.HE)","lang":"en","subjectScheme":"arXiv"},{"subject":"General Relativity and Quantum Cosmology (gr-qc)","lang":"en","subjectScheme":"arXiv"},{"subject":"High Energy Physics - Theory (hep-th)","lang":"en","subjectScheme":"arXiv"},{"subject":"Plasma Physics (physics.plasm-ph)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-26T16:47:59Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:56:45Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-04-12T00:25:47Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-04-14T00:49:37Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"We develop a Lorentz-covariant framework for projecting spacetime spectra into temporal spectra of stationary turbulent fluctuations in relativistic flows. For self-similar spacetime spectra, we derive a universal scaling relation, $α= β- D$, where $α$ is the temporal spectral index, $β$ the spacetime homogeneity exponent, and $D$ the effective dimensionality of spectral support. We further demonstrate that this universality breaks down when spacetime homogeneity is violated. Temporal spectra in relativistic flows are thus intrinsically nonlocal observables, requiring a covariant projection framework that establishes a general principle for spectral inference in relativistic plasma turbulence and high-energy plasma flows."},{"descriptionType":"Other","description":"Submitted to Journal of Plasma Physics"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.23195","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T03:04:48Z","registered":"2026-02-27T03:04:49Z","published":null,"updated":"2026-04-14T04:26:02Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.22942","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.22942","identifiers":[{"identifier":"2602.22942","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Hongchao","familyName":"Du","name":"Du, Hongchao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Shangyu","familyName":"Wu","name":"Wu, Shangyu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Qiao","familyName":"Li","name":"Li, Qiao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Riwei","familyName":"Pan","name":"Pan, Riwei","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jinheng","familyName":"Li","name":"Li, Jinheng","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Youcheng","familyName":"Sun","name":"Sun, Youcheng","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Chun Jason","familyName":"Xue","name":"Xue, Chun Jason","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"ClawMobile: Rethinking Smartphone-Native Agentic Systems"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Multiagent Systems (cs.MA)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-26T12:34:57Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:43:01Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-04-11T07:11:11Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-04-14T00:26:16Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[{"relationType":"IsVersionOf","relatedIdentifier":"10.1145/3805621.3807655","relatedIdentifierType":"DOI"}],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Smartphones represent a uniquely challenging environment for agentic systems. Unlike cloud or desktop settings, mobile devices combine constrained execution contexts, fragmented control interfaces, and rapidly changing application states. As large language models (LLMs) evolve from conversational assistants to action-oriented agents, achieving reliable smartphone-native autonomy requires rethinking how reasoning and control are composed.\n We introduce ClawMobile as a concrete exploration of this design space. ClawMobile adopts a hierarchical architecture that separates high-level language reasoning from structured, deterministic control pathways, improving execution stability and reproducibility on real devices. Using ClawMobile as a case study, we distill the design principles for mobile LLM runtimes and identify key challenges in efficiency, adaptability, and stability. We argue that building robust smartphone-native agentic systems demands principled coordination between probabilistic planning and deterministic system interfaces. The implementation is open-sourced~\\footnote{https://github.com/ClawMobile/ClawMobile} to facilitate future exploration."},{"descriptionType":"Other","description":"Accepted at EuroMLSys 2026, 7 pages, 1 figure"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.22942","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":1,"created":"2026-02-27T02:58:34Z","registered":"2026-02-27T02:58:35Z","published":null,"updated":"2026-04-14T04:26:01Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.22812","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.22812","identifiers":[{"identifier":"2602.22812","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Hiroki","familyName":"Matsutani","name":"Matsutani, Hiroki","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Naoki","familyName":"Matsuda","name":"Matsuda, Naoki","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Naoto","familyName":"Sugiura","name":"Sugiura, Naoto","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Accelerating Local LLMs on Resource-Constrained Edge Devices via Distributed Prompt Caching"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"Distributed, Parallel, and Cluster Computing (cs.DC)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-26T09:53:17Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:36:15Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-04-10T13:49:34Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-04-13T00:51:05Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Since local LLM inference on resource-constrained edge devices imposes a severe performance bottleneck, this paper proposes distributed prompt caching to enhance inference performance by cooperatively sharing intermediate processing states across multiple low-end edge devices. To fully utilize prompt similarity, our distributed caching mechanism also supports partial matching. As this approach introduces communication overhead associated with state sharing over a wireless network, we introduce a Bloom-filter-based data structure, referred to as a catalog, to determine whether a remote server possesses the desired internal states, thereby suppressing unnecessary communication. Experiments using the Gemma-3 270M model and the MMLU dataset on the Raspberry Pi Zero 2W platform demonstrate that the proposed approach reduces TTFT (Time to First Token) and TTLT (Time to Last Token) by 93.12% and 50.07% on average, respectively."},{"descriptionType":"Other","description":"EuroMLSys'26"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.22812","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T02:55:16Z","registered":"2026-02-27T02:55:17Z","published":null,"updated":"2026-04-13T02:12:31Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.22683","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.22683","identifiers":[{"identifier":"2602.22683","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Zhuohang","familyName":"Jiang","name":"Jiang, Zhuohang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xu","familyName":"Yuan","name":"Yuan, Xu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Haohao","familyName":"Qu","name":"Qu, Haohao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Shanru","familyName":"Lin","name":"Lin, Shanru","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Kanglong","familyName":"Liu","name":"Liu, Kanglong","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Wenqi","familyName":"Fan","name":"Fan, Wenqi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Qing","familyName":"Li","name":"Li, Qing","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"SUPERGLASSES: Benchmarking Vision Language Models as Intelligent Agents for AI Smart Glasses"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-26T06:55:48Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:29:00Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-04-09T08:16:21Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-04-10T00:37:06Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"The rapid advancement of AI-powered smart glasses-one of the hottest wearable devices-has unlocked new frontiers for multimodal interaction, with Visual Question Answering (VQA) over external knowledge sources emerging as a core application. Existing Vision Language Models (VLMs) adapted to smart glasses are typically trained and evaluated on traditional multimodal datasets; however, these datasets lack the variety and realism needed to reflect smart glasses usage scenarios and diverge from their specific challenges, where accurately identifying the object of interest must precede any external knowledge retrieval. To bridge this gap, we introduce SUPER- GLASSES, the first comprehensive VQA benchmark built on real-world data entirely collected by smart glasses devices. SUPERGLASSES comprises 2,422 egocentric image-question pairs spanning 14 image domains and 8 query categories, enriched with full search trajectories and reasoning annotations. We evaluate 26 representative VLMs on this benchmark, revealing significant performance gaps. To address the limitations of existing models, we further propose the SUPERLENS, a multimodal smart glasses agent that enables retrieval-augmented answer generation by integrating automatic object detection, query decoupling, and multimodal web search. SUPERLENS achieves state-of-the-art performance, outperforming GPT-4o by 2.19%, underscoring the need for task-specific solutions in smart glasses VQA. Our dataset is publicly available at https://huggingface.co/datasets/xandery/SuperGlasses."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.22683","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T02:52:09Z","registered":"2026-02-27T02:52:10Z","published":null,"updated":"2026-04-10T02:28:53Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.22486","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.22486","identifiers":[{"identifier":"2602.22486","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Shivam","familyName":"Kumar","name":"Kumar, Shivam","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yixin","familyName":"Wang","name":"Wang, Yixin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Lizhen","familyName":"Lin","name":"Lin, Lizhen","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Flow Matching is Adaptive to Manifold Structures"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Machine Learning (stat.ML)","lang":"en","subjectScheme":"arXiv"},{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"Statistics Theory (math.ST)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-25T23:52:32Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:12:22Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-04-09T08:48:30Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-04-10T00:39:11Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by-nc-sa/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution Non Commercial Share Alike 4.0 International","rightsIdentifier":"cc-by-nc-sa-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Flow matching has emerged as a simulation-free alternative to diffusion-based generative modeling, producing samples by solving an ODE whose time-dependent velocity field is learned along an interpolation between a simple source distribution (e.g., a standard normal) and a target data distribution. Flow-based methods often exhibit greater training stability and have achieved strong empirical performance in high-dimensional settings where data concentrate near a low-dimensional manifold, such as text-to-image synthesis, video generation, and molecular structure generation. Despite this success, existing theoretical analyses of flow matching assume target distributions with smooth, full-dimensional densities, leaving its effectiveness in manifold-supported settings largely unexplained. To this end, we theoretically analyze flow matching with linear interpolation when the target distribution is supported on a smooth manifold. We establish a non-asymptotic convergence guarantee for the learned velocity field, and then propagate this estimation error through the ODE to obtain statistical consistency of the implicit density estimator induced by the flow-matching objective. The resulting convergence rate is near minimax-optimal, depends only on the intrinsic dimension, and reflects the smoothness of both the manifold and the target distribution. Together, these results provide a principled explanation for how flow matching adapts to intrinsic data geometry and circumvents the curse of dimensionality."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.22486","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T02:47:29Z","registered":"2026-02-27T02:47:30Z","published":null,"updated":"2026-04-10T02:28:51Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.22220","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.22220","identifiers":[{"identifier":"2602.22220","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Bowei","familyName":"Zhang","name":"Zhang, Bowei","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jin","familyName":"Xiao","name":"Xiao, Jin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Guanglei","familyName":"Yue","name":"Yue, Guanglei","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Qianyu","familyName":"He","name":"He, Qianyu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yanghua","familyName":"Xiao","name":"Xiao, Yanghua","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Deqing","familyName":"Yang","name":"Yang, Deqing","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jiaqing","familyName":"Liang","name":"Liang, Jiaqing","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"What Makes an Ideal Quote? Recommending \"Unexpected yet Rational\" Quotations via Novelty"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Information Retrieval (cs.IR)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-12-15T12:19:37Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:00:16Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-04-08T09:41:00Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-04-09T00:39:12Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Quotation recommendation aims to enrich writing by suggesting quotes that complement a given context, yet existing systems mostly optimize surface-level topical relevance and ignore the deeper semantic and aesthetic properties that make quotations memorable. We start from two empirical observations. First, a systematic user study shows that people consistently prefer quotations that are ``unexpected yet rational'' in context, identifying novelty as a key desideratum. Second, we find that strong existing models struggle to fully understand the deep meanings of quotations. Inspired by defamiliarization theory, we therefore formalize quote recommendation as choosing contextually novel but semantically coherent quotations. We operationalize this objective with NovelQR, a novelty-driven quotation recommendation framework. A generative label agent first interprets each quotation and its surrounding context into multi-dimensional deep-meaning labels, enabling label-enhanced retrieval. A token-level novelty estimator then reranks candidates while mitigating auto-regressive continuation bias. Experiments on bilingual datasets spanning diverse real-world domains show that our system recommends quotations that human judges rate as more appropriate, more novel, and more engaging than other baselines, while matching or surpassing existing methods in novelty estimation."},{"descriptionType":"Other","description":"Accepted to ACL 2026 main conference ; Code available at"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.22220","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T02:41:20Z","registered":"2026-02-27T02:41:20Z","published":null,"updated":"2026-04-09T02:24:11Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.23047","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.23047","identifiers":[{"identifier":"2602.23047","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Haichuan","familyName":"Hu","name":"Hu, Haichuan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Quanjun","familyName":"Zhang","name":"Zhang, Quanjun","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ye","familyName":"Shang","name":"Shang, Ye","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Guoqing","familyName":"Xie","name":"Xie, Guoqing","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Chunrong","familyName":"Fang","name":"Fang, Chunrong","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zhenyu","familyName":"Chen","name":"Chen, Zhenyu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Liang","familyName":"Xiao","name":"Xiao, Liang","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"CL4SE: Benchmarking Context Learning on Software Engineering"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Software Engineering (cs.SE)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-26T14:28:57Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:48:53Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-03-31T14:31:22Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-04-01T01:00:17Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-04-06T07:08:30Z","dateType":"Submitted","dateInformation":"v3"},{"date":"2026-04-07T01:16:27Z","dateType":"Updated","dateInformation":"v3"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"3","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Context engineering has emerged as a pivotal paradigm for unlocking the potential of Large Language Models (LLMs) in Software Engineering (SE) tasks, enabling performance gains at test time without model fine-tuning. Despite its success, existing research lacks a systematic taxonomy of SE-specific context types and a dedicated benchmark to quantify the heterogeneous effects of different contexts across core SE workflows. To address this gap, we propose CL4SE (Context Learning for Software Engineering), a comprehensive benchmark featuring a fine-grained taxonomy of four SE-oriented context types (interpretable examples, project-specific context, procedural decision-making context, and positive \u0026amp; negative context), each mapped to a representative task (code generation, code summarization, code review, and patch correctness assessment). We construct high-quality datasets comprising over 13,000 samples from more than 30 open-source projects and evaluate five mainstream LLMs across nine metrics. Extensive experiments demonstrate that context learning yields an average performance improvement of 24.7% across all tasks. Specifically, procedural context boosts code review performance by up to 33% (Qwen3-Max), mixed positive-negative context improves patch assessment by 30% (DeepSeek-V3), project-specific context increases code summarization BLEU by 14.78% (GPT-Oss-120B), and interpretable examples enhance code generation PASS@1 by 5.72% (DeepSeek-V3). CL4SE establishes the first standardized evaluation framework for SE context learning, provides actionable empirical insights into task-specific context design, and releases a large-scale dataset to facilitate reproducible research in this domain."},{"descriptionType":"Other","description":"34 pages, 4 figures"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.23047","contentUrl":null,"metadataVersion":2,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T03:01:11Z","registered":"2026-02-27T03:01:12Z","published":null,"updated":"2026-04-07T03:32:40Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.23113","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.23113","identifiers":[{"identifier":"2602.23113","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Vignesh","familyName":"Gopakumar","name":"Gopakumar, Vignesh","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ander","familyName":"Gray","name":"Gray, Ander","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Dan","familyName":"Giles","name":"Giles, Dan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Lorenzo","familyName":"Zanisi","name":"Zanisi, Lorenzo","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Matt J.","familyName":"Kusner","name":"Kusner, Matt J.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Timo","familyName":"Betcke","name":"Betcke, Timo","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Stanislas","familyName":"Pamela","name":"Pamela, Stanislas","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Marc Peter","familyName":"Deisenroth","name":"Deisenroth, Marc Peter","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Learning Physical Operators using Neural Operators"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-26T15:27:14Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:52:53Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-04-02T22:53:09Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-04-06T00:11:00Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by-sa/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution Share Alike 4.0 International","rightsIdentifier":"cc-by-sa-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Neural operators have emerged as promising surrogate models for solving partial differential equations (PDEs), but struggle to generalise beyond training distributions and are often constrained to a fixed temporal discretisation. This work introduces a physics-informed training framework that addresses these limitations by decomposing PDEs using operator splitting methods, training separate neural operators to learn individual non-linear physical operators while approximating linear operators with fixed finite-difference convolutions. This modular mixture-of-experts architecture enables generalisation to novel physical regimes by explicitly encoding the underlying operator structure. We formulate the modelling task as a neural ordinary differential equation (ODE) where these learned operators constitute the right-hand side, enabling continuous-in-time predictions through standard ODE solvers and implicitly enforcing PDE constraints. Demonstrated on incompressible and compressible Navier--Stokes equations, our approach achieves better convergence and superior performance when generalising to unseen physics. The method remains parameter-efficient, enabling temporal extrapolation beyond training horizons, and provides interpretable components whose behaviour can be verified against known physics."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.23113","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T03:02:43Z","registered":"2026-02-27T03:02:44Z","published":null,"updated":"2026-04-06T01:52:01Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.22732","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.22732","identifiers":[{"identifier":"2602.22732","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Ben","familyName":"Xue","name":"Xue, Ben","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Dan","familyName":"Liu","name":"Liu, Dan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Lixiang","familyName":"Wang","name":"Wang, Lixiang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Mingjie","familyName":"Sun","name":"Sun, Mingjie","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Peng","familyName":"Wang","name":"Wang, Peng","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Pengfei","familyName":"Zhang","name":"Zhang, Pengfei","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Shaoyun","familyName":"Shi","name":"Shi, Shaoyun","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Tianyu","familyName":"Xu","name":"Xu, Tianyu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yunhao","familyName":"Sha","name":"Sha, Yunhao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zhiqiang","familyName":"Liu","name":"Liu, Zhiqiang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Bo","familyName":"Kong","name":"Kong, Bo","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Bo","familyName":"Wang","name":"Wang, Bo","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Hang","familyName":"Yang","name":"Yang, Hang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jieting","familyName":"Xue","name":"Xue, Jieting","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Junhao","familyName":"Wang","name":"Wang, Junhao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Shengyu","familyName":"Wang","name":"Wang, Shengyu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Shuping","familyName":"Hui","name":"Hui, Shuping","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Wencai","familyName":"Ye","name":"Ye, Wencai","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xiao","familyName":"Lin","name":"Lin, Xiao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yongzhi","familyName":"Li","name":"Li, Yongzhi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yuhang","familyName":"Chen","name":"Chen, Yuhang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zhihui","familyName":"Yin","name":"Yin, Zhihui","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Quan","familyName":"Chen","name":"Chen, Quan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Shiyang","familyName":"Wen","name":"Wen, Shiyang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Wenjin","familyName":"Wu","name":"Wu, Wenjin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Han","familyName":"Li","name":"Li, Han","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Guorui","familyName":"Zhou","name":"Zhou, Guorui","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Changcheng","familyName":"Li","name":"Li, Changcheng","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Peng","familyName":"Jiang","name":"Jiang, Peng","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Kun","familyName":"Gai","name":"Gai, Kun","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Generative Recommendation for Large-Scale Advertising"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Information Retrieval (cs.IR)","lang":"en","subjectScheme":"arXiv"},{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-26T08:15:26Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:32:05Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-03-04T09:28:17Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-03-05T01:43:25Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-04-02T02:38:13Z","dateType":"Submitted","dateInformation":"v3"},{"date":"2026-04-03T00:19:56Z","dateType":"Updated","dateInformation":"v3"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"3","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Generative recommendation has recently attracted widespread attention in industry due to its potential for scaling and stronger model capacity. However, deploying real-time generative recommendation in large-scale advertising requires designs beyond large-language-model (LLM)-style training and serving recipes. We present a production-oriented generative recommender co-designed across architecture, learning, and serving, named GR4AD (Generative Recommendation for ADdvertising). As for tokenization, GR4AD proposes UA-SID (Unified Advertisement Semantic ID) to capture complicated business information. Furthermore, GR4AD introduces LazyAR, a lazy autoregressive decoder that relaxes layer-wise dependencies for short, multi-candidate generation, preserving effectiveness while reducing inference cost, which facilitates scaling under fixed serving budgets. To align optimization with business value, GR4AD employs VSL (Value-Aware Supervised Learning) and proposes RSPO (Ranking-Guided Softmax Preference Optimization), a ranking-aware, list-wise reinforcement learning algorithm that optimizes value-based rewards under list-level metrics for continual online updates. For online inference, we further propose dynamic beam serving, which adapts beam width across generation levels and online load to control compute. Large-scale online A/B tests show up to 4.2% ad revenue improvement over an existing DLRM-based stack, with consistent gains from both model scaling and inference-time scaling. GR4AD has been fully deployed in Kuaishou advertising system with over 400 million users and achieves high-throughput real-time serving."},{"descriptionType":"Other","description":"13 pages, 6 figures, under review"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.22732","contentUrl":null,"metadataVersion":2,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T02:53:18Z","registered":"2026-02-27T02:53:18Z","published":null,"updated":"2026-04-03T02:18:58Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.22340","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.22340","identifiers":[{"identifier":"2602.22340","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Xiuqi Tommy","familyName":"Zhu","name":"Zhu, Xiuqi Tommy","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xiaoan","familyName":"Liu","name":"Liu, Xiaoan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Casper","familyName":"Harteveld","name":"Harteveld, Casper","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Smit","familyName":"Desai","name":"Desai, Smit","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Eileen","familyName":"McGivney","name":"McGivney, Eileen","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Conversational Successes and Breakdowns in Everyday Smart Glasses Use"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Human-Computer Interaction (cs.HC)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-25T19:05:27Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:03:23Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-04-02T16:33:33Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-04-03T01:01:45Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by-nc-sa/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution Non Commercial Share Alike 4.0 International","rightsIdentifier":"cc-by-nc-sa-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Non-Display Smart Glasses hold the potential to support everyday activities by combining continuous environmental sensing with voice-only interaction powered by large language models (LLMs). Understanding how conversational successes and breakdowns arise in everyday contexts can better inform the design of future voice-only interfaces. To investigate this, we conducted a month-long collaborative autoethnography (n=2) to identify patterns of successes and breakdowns when using such devices. We then compare these patterns with prior findings on voice-only interactions to highlight the unique affordances and opportunities offered by non-display smart glasses."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.22340","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T02:44:08Z","registered":"2026-02-27T02:44:09Z","published":null,"updated":"2026-04-03T02:18:56Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.22721","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.22721","identifiers":[{"identifier":"2602.22721","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Fengyu","familyName":"Li","name":"Li, Fengyu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Junhao","familyName":"Zhu","name":"Zhu, Junhao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Kaishi","familyName":"Song","name":"Song, Kaishi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Lu","familyName":"Chen","name":"Chen, Lu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zhongming","familyName":"Yao","name":"Yao, Zhongming","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Tianyi","familyName":"Li","name":"Li, Tianyi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Christian S.","familyName":"Jensen","name":"Jensen, Christian S.","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Replacing Multi-Step Assembly of Data Preparation Pipelines with One-Step LLM Pipeline Generation for Table QA"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Databases (cs.DB)","lang":"en","subjectScheme":"arXiv"},{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-26T07:49:50Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:31:02Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-04-01T01:31:38Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-04-02T00:19:15Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Table Question Answering (TQA) aims to answer natural language questions over structured tables. Large Language Models (LLMs) enable promising solutions to this problem, with operator-centric solutions that generate table manipulation pipelines in a multi-step manner offering state-of-the-art performance. However, these solutions rely on multiple LLM calls, resulting in prohibitive latencies and computational costs.\n We propose Operation-R1, the first framework that trains lightweight LLMs (e.g., Qwen-4B/1.7B) via a novel variant of reinforcement learning with verifiable rewards to produce high-quality data-preparation pipelines for TQA in a single inference step. To train such an LLM, we first introduce a self-supervised rewarding mechanism to automatically obtain fine-grained pipeline-wise supervision signals for LLM training. We also propose variance-aware group resampling to mitigate training instability. To further enhance robustness of pipeline generation, we develop two complementary mechanisms: operation merge, which filters spurious operations through multi-candidate consensus, and adaptive rollback, which offers runtime protection against information loss in data transformation. Experiments on two benchmark datasets show that, with the same LLM backbone, Operation-R1 achieves average absolute accuracy gains of 8.83 and 4.44 percentage points over multi-step preparation baselines, with 79\\% table compression and a 2.2$\\times$ reduction in monetary cost."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.22721","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T02:53:03Z","registered":"2026-02-27T02:53:03Z","published":null,"updated":"2026-04-02T02:33:36Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.22413","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.22413","identifiers":[{"identifier":"2602.22413","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Jonas","familyName":"Karge","name":"Karge, Jonas","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Epistemic Filtering and Collective Hallucination: A Jury Theorem for Confidence-Calibrated Agents"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-25T21:09:14Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:08:20Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-04-01T14:18:17Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-04-02T00:56:52Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"We investigate the collective accuracy of heterogeneous agents who learn to estimate their own reliability over time and selectively abstain from voting. While classical epistemic voting results, such as the \\textit{Condorcet Jury Theorem} (CJT), assume fixed participation, real-world aggregation often benefits from allowing agents to say ``I don't know.'' We propose a probabilistic framework where agents engage in a \\textit{calibration} phase, updating beliefs about their own fixed competence, before facing a final confidence gate that determines whether to vote or abstain. We derive a non-asymptotic lower bound on the group's success probability and prove that this \\textit{selective participation} generalizes the asymptotic guarantees of the CJT to a sequential, confidence-gated setting. Empirically, we validate these bounds via Monte Carlo simulations. While our results are general, we discuss their potential application to AI safety, outlining how this framework can mitigate \\textit{hallucinations} in collective LLM decision-making."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.22413","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T02:45:49Z","registered":"2026-02-27T02:45:49Z","published":null,"updated":"2026-04-02T02:33:34Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.22743","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.22743","identifiers":[{"identifier":"2602.22743","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Jiaqing","familyName":"Zhang","name":"Zhang, Jiaqing","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Mingjia","familyName":"Yin","name":"Yin, Mingjia","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Hao","familyName":"Wang","name":"Wang, Hao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yuxin","familyName":"Tian","name":"Tian, Yuxin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yuyang","familyName":"Ye","name":"Ye, Yuyang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yawen","familyName":"Li","name":"Li, Yawen","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Wei","familyName":"Guo","name":"Guo, Wei","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yong","familyName":"Liu","name":"Liu, Yong","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Enhong","familyName":"Chen","name":"Chen, Enhong","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Generative Data Transformation: From Mixed to Unified Data"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-26T08:30:09Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:32:29Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-03-31T02:35:29Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-04-01T00:20:34Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Recommendation model performance is intrinsically tied to the quality, volume, and relevance of their training data. To address common challenges like data sparsity and cold start, recent researchs have leveraged data from multiple auxiliary domains to enrich information within the target domain. However, inherent domain gaps can degrade the quality of mixed-domain data, leading to negative transfer and diminished model performance. Existing prevailing \\emph{model-centric} paradigm -- which relies on complex, customized architectures -- struggles to capture the subtle, non-structural sequence dependencies across domains, leading to poor generalization and high demands on computational resources. To address these shortcomings, we propose \\textsc{Taesar}, a \\emph{data-centric} framework for \\textbf{t}arget-\\textbf{a}lign\\textbf{e}d \\textbf{s}equenti\\textbf{a}l \\textbf{r}egeneration, which employs a contrastive decoding mechanism to adaptively encode cross-domain context into target-domain sequences. It employs contrastive decoding to encode cross-domain context into target sequences, enabling standard models to learn intricate dependencies without complex fusion architectures. Experiments show \\textsc{Taesar} outperforms model-centric solutions and generalizes to various sequential models. By generating enriched datasets, \\textsc{Taesar} effectively combines the strengths of data- and model-centric paradigms. The code accompanying this paper is available at~ \\textcolor{blue}{https://github.com/USTC-StarTeam/Taesar}."},{"descriptionType":"Other","description":"Accepted by The Web Conference 2026 (WWW '26)"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.22743","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T02:53:33Z","registered":"2026-02-27T02:53:34Z","published":null,"updated":"2026-04-01T02:35:19Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.23165","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.23165","identifiers":[{"identifier":"2602.23165","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Yichen","familyName":"Peng","name":"Peng, Yichen","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jyun-Ting","familyName":"Song","name":"Song, Jyun-Ting","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Siyeol","familyName":"Jung","name":"Jung, Siyeol","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ruofan","familyName":"Liu","name":"Liu, Ruofan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Haiyang","familyName":"Liu","name":"Liu, Haiyang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xuangeng","familyName":"Chu","name":"Chu, Xuangeng","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ruicong","familyName":"Liu","name":"Liu, Ruicong","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Erwin","familyName":"Wu","name":"Wu, Erwin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Hideki","familyName":"Koike","name":"Koike, Hideki","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Kris","familyName":"Kitani","name":"Kitani, Kris","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"DyaDiT: A Multi-Modal Diffusion Transformer for Socially Favorable Dyadic Gesture Generation"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-26T16:30:07Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:55:23Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-03-30T06:15:00Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-03-31T01:22:27Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Generating realistic conversational gestures are essential for achieving natural, socially engaging interactions with digital humans. However, existing methods typically map a single audio stream to a single speaker's motion, without considering social context or modeling the mutual dynamics between two people engaging in conversation. We present DyaDiT, a multi-modal diffusion transformer that generates contextually appropriate human motion from dyadic audio signals. Trained on Seamless Interaction Dataset, DyaDiT takes dyadic audio with optional social-context tokens to produce context-appropriate motion. It fuses information from both speakers to capture interaction dynamics, uses a motion dictionary to encode motion priors, and can optionally utilize the conversational partner's gestures to produce more responsive motion. We evaluate DyaDiT on standard motion generation metrics and conduct quantitative user studies, demonstrating that it not only surpasses existing methods on objective metrics but is also strongly preferred by users, highlighting its robustness and socially favorable motion generation. Code and models will be released upon acceptance."},{"descriptionType":"Other","description":"13 pages, 9 figures"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.23165","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T03:04:02Z","registered":"2026-02-27T03:04:03Z","published":null,"updated":"2026-03-31T04:10:43Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.22419","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.22419","identifiers":[{"identifier":"2602.22419","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Marc-Antoine","familyName":"Lavoie","name":"Lavoie, Marc-Antoine","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Anas","familyName":"Mahmoud","name":"Mahmoud, Anas","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Aldo","familyName":"Zaimi","name":"Zaimi, Aldo","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Arsene Fansi","familyName":"Tchango","name":"Tchango, Arsene Fansi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Steven L.","familyName":"Waslander","name":"Waslander, Steven L.","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"CLIP Is Shortsighted: Paying Attention Beyond the First Sentence"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-25T21:27:00Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:08:51Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-03-28T14:15:06Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-03-31T00:35:49Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"CLIP models learn transferable multi-modal features via image-text contrastive learning on internet-scale data. They are widely used in zero-shot classification, multi-modal retrieval, text-to-image diffusion, and as image encoders in large vision-language models. However, CLIP's pretraining is dominated by images paired with short captions, biasing the model toward encoding simple descriptions of salient objects and leading to coarse alignment on complex scenes and dense descriptions. While recent work mitigates this by fine-tuning on small-scale long-caption datasets, we identify an important common bias: both human- and LLM-generated long captions typically begin with a one-sentence summary followed by a detailed description. We show that this acts as a shortcut during training, concentrating attention on the opening sentence and early tokens and weakening alignment over the rest of the caption. To resolve this, we introduce DeBias-CLIP, which removes the summary sentence during training and applies sentence sub-sampling and text token padding to distribute supervision across all token positions. DeBias-CLIP achieves state-of-the-art long-text retrieval, improves short-text retrieval, and is less sensitive to sentence order permutations. It is a drop-in replacement for Long-CLIP with no additional trainable parameters."},{"descriptionType":"Other","description":"20 pages, 15 figures, to be published in the CVPR 2026 proceedings"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.22419","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T02:45:57Z","registered":"2026-02-27T02:45:58Z","published":null,"updated":"2026-03-31T04:10:40Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.22949","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.22949","identifiers":[{"identifier":"2602.22949","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Junuk","familyName":"Cha","name":"Cha, Junuk","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jihyeon","familyName":"Kim","name":"Kim, Jihyeon","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Han-Mu","familyName":"Park","name":"Park, Han-Mu","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"OpenFS: Multi-Hand-Capable Fingerspelling Recognition with Implicit Signing-Hand Detection and Frame-Wise Letter-Conditioned Synthesis"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-26T12:41:24Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:43:19Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-03-27T05:30:37Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-03-30T00:27:09Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Fingerspelling is a component of sign languages in which words are spelled out letter by letter using specific hand poses. Automatic fingerspelling recognition plays a crucial role in bridging the communication gap between Deaf and hearing communities, yet it remains challenging due to the signing-hand ambiguity issue, the lack of appropriate training losses, and the out-of-vocabulary (OOV) problem. Prior fingerspelling recognition methods rely on explicit signing-hand detection, which often leads to recognition failures, and on a connectionist temporal classification (CTC) loss, which exhibits the peaky behavior problem. To address these issues, we develop OpenFS, an open-source approach for fingerspelling recognition and synthesis. We propose a multi-hand-capable fingerspelling recognizer that supports both single- and multi-hand inputs and performs implicit signing-hand detection by incorporating a dual-level positional encoding and a signing-hand focus (SF) loss. The SF loss encourages cross-attention to focus on the signing hand, enabling implicit signing-hand detection during recognition. Furthermore, without relying on the CTC loss, we introduce a monotonic alignment (MA) loss that enforces the output letter sequence to follow the temporal order of the input pose sequence through cross-attention regularization. In addition, we propose a frame-wise letter-conditioned generator that synthesizes realistic fingerspelling pose sequences for OOV words. This generator enables the construction of a new synthetic benchmark, called FSNeo. Through comprehensive experiments, we demonstrate that our approach achieves state-of-the-art performance in recognition and validate the effectiveness of the proposed recognizer and generator. Codes and data are available in: https://github.com/AIRC-KETI/OpenFS."},{"descriptionType":"Other","description":"Accepted to CVPR 2026, camera-ready version"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.22949","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T02:58:45Z","registered":"2026-02-27T02:58:45Z","published":null,"updated":"2026-03-30T02:15:08Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.23022","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.23022","identifiers":[{"identifier":"2602.23022","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Xinglong","familyName":"Luo","name":"Luo, Xinglong","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ao","familyName":"Luo","name":"Luo, Ao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zhengning","familyName":"Wang","name":"Wang, Zhengning","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yueqi","familyName":"Yang","name":"Yang, Yueqi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Chaoyu","familyName":"Feng","name":"Feng, Chaoyu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Lei","familyName":"Lei","name":"Lei, Lei","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Bing","familyName":"Zeng","name":"Zeng, Bing","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Shuaicheng","familyName":"Liu","name":"Liu, Shuaicheng","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"DMAligner: Enhancing Image Alignment via Diffusion Model Based View Synthesis"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-26T14:00:07Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:47:23Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-03-26T04:15:46Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-03-27T00:27:07Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Image alignment is a fundamental task in computer vision with broad applications. Existing methods predominantly employ optical flow-based image warping. However, this technique is susceptible to common challenges such as occlusions and illumination variations, leading to degraded alignment visual quality and compromised accuracy in downstream tasks. In this paper, we present DMAligner, a diffusion-based framework for image alignment through alignment-oriented view synthesis. DMAligner is crafted to tackle the challenges in image alignment from a new perspective, employing a generation-based solution that showcases strong capabilities and avoids the problems associated with flow-based image warping. Specifically, we propose a Dynamics-aware Diffusion Training approach for learning conditional image generation, synthesizing a novel view for image alignment. This incorporates a Dynamics-aware Mask Producing (DMP) module to adaptively distinguish dynamic foreground regions from static backgrounds, enabling the diffusion model to more effectively handle challenges that classical methods struggle to solve. Furthermore, we develop the Dynamic Scene Image Alignment (DSIA) dataset using Blender, which includes 1,033 indoor and outdoor scenes with over 30K image pairs tailored for image alignment. Extensive experimental results demonstrate the superiority of the proposed approach on DSIA benchmarks, as well as on a series of widely-used video datasets for qualitative comparisons. Our code is available at https://github.com/boomluo02/DMAligner."},{"descriptionType":"Other","description":"Accepted by CVPR 2026"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.23022","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T03:00:35Z","registered":"2026-02-27T03:00:35Z","published":null,"updated":"2026-03-27T02:26:00Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.22752","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.22752","identifiers":[{"identifier":"2602.22752","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Nils","familyName":"Schwager","name":"Schwager, Nils","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Simon","familyName":"Münker","name":"Münker, Simon","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Alistair","familyName":"Plum","name":"Plum, Alistair","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Achim","familyName":"Rettinger","name":"Rettinger, Achim","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Towards Simulating Social Media Users with LLMs: Evaluating the Operational Validity of Conditioned Comment Prediction"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-26T08:40:21Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-03-27T00:48:38Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[{"relationType":"IsVersionOf","relatedIdentifier":"10.18653/v1/2026.wassa-1.16","relatedIdentifierType":"DOI"}],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"The transition of Large Language Models (LLMs) from exploratory tools to active \"silicon subjects\" in social science lacks extensive validation of operational validity. This study introduces Conditioned Comment Prediction (CCP), a task in which a model predicts how a user would comment on a given stimulus by comparing generated outputs with authentic digital traces. This framework enables a rigorous evaluation of current LLM capabilities with respect to the simulation of social media user behavior. We evaluated open-weight 8B models (Llama3.1, Qwen3, Ministral) in English, German, and Luxembourgish language scenarios. By systematically comparing prompting strategies (explicit vs. implicit) and the impact of Supervised Fine-Tuning (SFT), we identify a critical form vs. content decoupling in low-resource settings: while SFT aligns the surface structure of the text output (length and syntax), it degrades semantic grounding. Furthermore, we demonstrate that explicit conditioning (generated biographies) becomes redundant under fine-tuning, as models successfully perform latent inference directly from behavioral histories. Our findings challenge current \"naive prompting\" paradigms and offer operational guidelines prioritizing authentic behavioral traces over descriptive personas for high-fidelity simulation."},{"descriptionType":"Other","description":"14 pages, 1 figure, 7 tables. Accepted to the 15th Workshop on Computational Approaches to Subjectivity, Sentiment \u0026amp; Social Media Analysis (WASSA) at EACL 2026, Rabat, Morocco"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.22752","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":1,"created":"2026-02-27T02:53:46Z","registered":"2026-02-27T02:53:46Z","published":null,"updated":"2026-03-27T02:25:59Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.22605","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.22605","identifiers":[{"identifier":"2602.22605","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Willy","familyName":"Wong","name":"Wong, Willy","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"A Thermodynamic Structure of Asymptotic Inference"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Information Theory (cs.IT)","lang":"en","subjectScheme":"arXiv"},{"subject":"Statistics Theory (math.ST)","lang":"en","subjectScheme":"arXiv"},{"subject":"Data Analysis, Statistics and Probability (physics.data-an)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-26T04:24:50Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:23:24Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-03-09T16:14:59Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-03-10T02:23:19Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-03-25T13:29:38Z","dateType":"Submitted","dateInformation":"v3"},{"date":"2026-03-26T00:53:15Z","dateType":"Updated","dateInformation":"v3"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"3","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"A thermodynamic framework for asymptotic inference is developed in which sample size and parameter variance define a state space. Within this description, Shannon information plays the role of entropy, and an integrating factor organizes its variation into a first-law-type balance equation. The framework supports a cyclic inequality analogous to a reversed second law, derived for the estimation of the mean. A non-trivial third-law-type result emerges as a lower bound on entropy set by representation noise. Optimal inference paths, global bounds on information gain, and a natural Carnot-like information efficiency follow from this structure, with efficiency fundamentally limited by a noise floor. Finally, de Bruijn's identity and the I-MMSE relation in the Gaussian-limit case appear as coordinate projections of the same underlying thermodynamic structure. This framework suggests that ensemble physics and inferential physics constitute shadow processes evolving in opposite directions within a unified thermodynamic description."},{"descriptionType":"Other","description":"31 pages, 1 figure. This version reworks the paper around observation variance and clarifies the unification of de Bruijn and I-MMSE identities"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.22605","contentUrl":null,"metadataVersion":2,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T02:50:18Z","registered":"2026-02-27T02:50:18Z","published":null,"updated":"2026-03-26T02:34:46Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.23276","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.23276","identifiers":[{"identifier":"2602.23276","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Hyungyung","familyName":"Lee","name":"Lee, Hyungyung","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Hangyul","familyName":"Yoon","name":"Yoon, Hangyul","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Edward","familyName":"Choi","name":"Choi, Edward","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"CXReasonAgent: Evidence-Grounded Diagnostic Reasoning Agent for Chest X-rays"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-26T17:51:21Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T02:00:18Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-03-24T09:05:23Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-03-25T00:44:39Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Chest X-ray plays a central role in thoracic diagnosis, and its interpretation inherently requires multi-step, evidence-grounded reasoning. However, large vision-language models (LVLMs) often generate plausible responses that are not faithfully grounded in diagnostic evidence and provide limited visual evidence for verification, while also requiring costly retraining to support new diagnostic tasks, limiting their reliability and adaptability in clinical settings. To address these limitations, we present CXReasonAgent, a diagnostic agent that integrates a large language model (LLM) with clinically grounded diagnostic tools to perform evidence-grounded diagnostic reasoning using image-derived diagnostic and visual evidence. To evaluate these capabilities, we introduce CXReasonDial, a multi-turn dialogue benchmark with 1,946 dialogues across 12 diagnostic tasks, and show that CXReasonAgent produces faithfully grounded responses, enabling more reliable and verifiable diagnostic reasoning than LVLMs. These findings highlight the importance of integrating clinically grounded diagnostic tools, particularly in safety-critical clinical settings. The demo is available \\href{https://ttumyche.github.io/cxreasonagent/#demo}{here}."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.23276","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T03:06:53Z","registered":"2026-02-27T03:06:54Z","published":null,"updated":"2026-03-25T02:36:26Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.23029","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.23029","identifiers":[{"identifier":"2602.23029","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Tianyue","familyName":"Wang","name":"Wang, Tianyue","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Leigang","familyName":"Qu","name":"Qu, Leigang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Tianyu","familyName":"Yang","name":"Yang, Tianyu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xiangzhao","familyName":"Hao","name":"Hao, Xiangzhao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yifan","familyName":"Xu","name":"Xu, Yifan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Haiyun","familyName":"Guo","name":"Guo, Haiyun","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jinqiao","familyName":"Wang","name":"Wang, Jinqiao","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"WISER: Wider Search, Deeper Thinking, and Adaptive Fusion for Training-Free Zero-Shot Composed Image Retrieval"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-26T14:11:10Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:47:50Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-03-02T02:20:04Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-03-03T02:33:12Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-03-07T13:24:30Z","dateType":"Submitted","dateInformation":"v3"},{"date":"2026-03-10T00:44:21Z","dateType":"Updated","dateInformation":"v3"},{"date":"2026-03-24T11:51:05Z","dateType":"Submitted","dateInformation":"v4"},{"date":"2026-03-25T00:54:12Z","dateType":"Updated","dateInformation":"v4"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"4","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Zero-Shot Composed Image Retrieval (ZS-CIR) aims to retrieve target images given a multimodal query (comprising a reference image and a modification text), without training on annotated triplets. Existing methods typically convert the multimodal query into a single modality-either as an edited caption for Text-to-Image retrieval (T2I) or as an edited image for Image-to-Image retrieval (I2I). However, each paradigm has inherent limitations: T2I often loses fine-grained visual details, while I2I struggles with complex semantic modifications. To effectively leverage their complementary strengths under diverse query intents, we propose WISER, a training-free framework that unifies T2I and I2I via a \"retrieve-verify-refine\" pipeline, explicitly modeling intent awareness and uncertainty awareness. Specifically, WISER first performs Wider Search by generating both edited captions and images for parallel retrieval to broaden the candidate pool. Then, it conducts Adaptive Fusion with a verifier to assess retrieval confidence, triggering refinement for uncertain retrievals, and dynamically fusing the dual-path for reliable ones. For uncertain retrievals, WISER generates refinement suggestions through structured self-reflection to guide the next retrieval round toward Deeper Thinking. Extensive experiments demonstrate that WISER significantly outperforms previous methods across multiple benchmarks, achieving relative improvements of 45% on CIRCO (mAP@5) and 57% on CIRR (Recall@1) over existing training-free methods. Notably, it even surpasses many training-dependent methods, highlighting its superiority and generalization under diverse scenarios. Code will be released at https://github.com/Physicsmile/WISER."},{"descriptionType":"Other","description":"Accept to CVPR 2026"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.23029","contentUrl":null,"metadataVersion":3,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T03:00:45Z","registered":"2026-02-27T03:00:45Z","published":null,"updated":"2026-03-25T02:36:26Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.22983","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.22983","identifiers":[{"identifier":"2602.22983","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Xun","familyName":"Huang","name":"Huang, Xun","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Simeng","familyName":"Qin","name":"Qin, Simeng","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xiaoshuang","familyName":"Jia","name":"Jia, Xiaoshuang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ranjie","familyName":"Duan","name":"Duan, Ranjie","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Huanqian","familyName":"Yan","name":"Yan, Huanqian","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zhitao","familyName":"Zeng","name":"Zeng, Zhitao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Fei","familyName":"Yang","name":"Yang, Fei","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yang","familyName":"Liu","name":"Liu, Yang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xiaojun","familyName":"Jia","name":"Jia, Xiaojun","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Obscure but Effective: Classical Chinese Jailbreak Prompt Optimization via Bio-Inspired Search"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"Cryptography and Security (cs.CR)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-26T13:25:35Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:45:11Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02-27T09:27:35Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-03-02T01:35:27Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-03-24T07:52:18Z","dateType":"Submitted","dateInformation":"v3"},{"date":"2026-03-25T00:40:01Z","dateType":"Updated","dateInformation":"v3"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"3","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"As Large Language Models (LLMs) are increasingly used, their security risks have drawn increasing attention. Existing research reveals that LLMs are highly susceptible to jailbreak attacks, with effectiveness varying across language contexts. This paper investigates the role of classical Chinese in jailbreak attacks. Owing to its conciseness and obscurity, classical Chinese can partially bypass existing safety constraints, exposing notable vulnerabilities in LLMs. Based on this observation, this paper proposes a framework, CC-BOS, for the automatic generation of classical Chinese adversarial prompts based on multi-dimensional fruit fly optimization, facilitating efficient and automated jailbreak attacks in black-box settings. Prompts are encoded into eight policy dimensions-covering role, behavior, mechanism, metaphor, expression, knowledge, trigger pattern and context; and iteratively refined via smell search, visual search, and cauchy mutation. This design enables efficient exploration of the search space, thereby enhancing the effectiveness of black-box jailbreak attacks. To enhance readability and evaluation accuracy, we further design a classical Chinese to English translation module. Extensive experiments demonstrate that effectiveness of the proposed CC-BOS, consistently outperforming state-of-the-art jailbreak attack methods."},{"descriptionType":"Other","description":"ICLR 2026 Poster The source code relevant to this article has now been open-sourced; for details, please visit: https://github.com/xunhuang123/CC-BOS"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.22983","contentUrl":null,"metadataVersion":2,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T02:59:37Z","registered":"2026-02-27T02:59:37Z","published":null,"updated":"2026-03-25T02:36:25Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.23306","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.23306","identifiers":[{"identifier":"2602.23306","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Yiran","familyName":"Guan","name":"Guan, Yiran","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Sifan","familyName":"Tu","name":"Tu, Sifan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Dingkang","familyName":"Liang","name":"Liang, Dingkang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Linghao","familyName":"Zhu","name":"Zhu, Linghao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jianzhong","familyName":"Ju","name":"Ju, Jianzhong","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zhenbo","familyName":"Luo","name":"Luo, Zhenbo","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jian","familyName":"Luan","name":"Luan, Jian","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yuliang","familyName":"Liu","name":"Liu, Yuliang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xiang","familyName":"Bai","name":"Bai, Xiang","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"ThinkOmni: Lifting Textual Reasoning to Omni-modal Scenarios via Guidance Decoding"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-26T18:10:41Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T02:01:38Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-03-21T06:46:01Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-03-24T00:32:00Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Omni-modal reasoning is essential for intelligent systems to understand and draw inferences from diverse data sources. While existing omni-modal large language models (OLLM) excel at perceiving diverse modalities, they lack the complex reasoning abilities of recent large reasoning models (LRM). However, enhancing the reasoning ability of OLLMs through additional training presents significant challenges, including the need for high-quality data, task-specific adaptation, and substantial computational costs. To address these limitations, we propose ThinkOmni, a training-free and data-free framework that lifts textual reasoning to omni-modal scenarios. ThinkOmni introduces two key components: 1) LRM-as-a-Guide, which leverages off-the-shelf LRMs to guide the OLLM decoding process; 2) Stepwise Contrastive Scaling, which adaptively balances perception and reasoning signals without manual hyperparameter tuning. Experiments on six multi-modal reasoning benchmarks demonstrate that ThinkOmni consistently delivers performance improvements, with main results achieving 70.2 on MathVista and 75.5 on MMAU. Overall, ThinkOmni offers a flexible and generalizable solution for omni-modal reasoning and provides new insights into the generalization and application of reasoning capabilities. Code is publicly available at https://github.com/1ranGuan/thinkomni"},{"descriptionType":"Other","description":"Accept by ICLR 2026, Code: https://github.com/1ranGuan/thinkomni"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.23306","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T03:07:37Z","registered":"2026-02-27T03:07:37Z","published":null,"updated":"2026-03-24T04:24:43Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.23036","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.23036","identifiers":[{"identifier":"2602.23036","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Jaehong","familyName":"Cho","name":"Cho, Jaehong","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Hyunmin","familyName":"Choi","name":"Choi, Hyunmin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Guseul","familyName":"Heo","name":"Heo, Guseul","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jongse","familyName":"Park","name":"Park, Jongse","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"LLMServingSim 2.0: A Unified Simulator for Heterogeneous and Disaggregated LLM Serving Infrastructure"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Distributed, Parallel, and Cluster Computing (cs.DC)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-26T14:22:17Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:48:26Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-03-23T05:25:20Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-03-24T01:31:01Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Large language model (LLM) serving infrastructures are undergoing a shift toward heterogeneity and disaggregation. Modern deployments increasingly integrate diverse accelerators and near-memory processing technologies, introducing significant hardware heterogeneity, while system software increasingly separates computation, memory, and model components across distributed resources to improve scalability and efficiency. As a result, LLM serving performance is no longer determined by hardware or software choices in isolation, but by their runtime interaction through scheduling, data movement, and interconnect behavior. However, understanding these interactions remains challenging, as existing simulators lack the ability to jointly model heterogeneous hardware and disaggregated serving techniques within a unified, runtime-driven framework.\n This paper presents LLMServingSim 2.0, a unified system-level simulator designed to make runtime-driven hardware-software interactions in heterogeneous and disaggregated LLM serving infrastructures explicit and analyzable. LLMServingSim 2.0 embeds serving decisions and hardware behavior into a single runtime loop, enabling interaction-aware modeling of batching, routing, offloading, memory, and power. The simulator supports extensible integration of emerging accelerators and memory systems through profile-based modeling, while capturing dynamic serving behavior and system-level effects. We validate LLMServingSim 2.0 against real deployments, showing that it reproduces key performance, memory, and power metrics with an average error of 0.95%, while maintaining simulation times of around 10 minutes even for complex configurations. These results demonstrate that LLMServingSim 2.0 provides a practical bridge between hardware innovation and serving-system design, enabling systematic exploration and co-design for next-generation LLM serving infrastructures."},{"descriptionType":"Other","description":"14 pages, 11 figures"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.23036","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T03:00:54Z","registered":"2026-02-27T03:00:55Z","published":null,"updated":"2026-03-24T04:24:40Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.22271","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.22271","identifiers":[{"identifier":"2602.22271","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Deepak","familyName":"Agarwal","name":"Agarwal, Deepak","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Dhyey Dharmendrakumar","familyName":"Mavani","name":"Mavani, Dhyey Dharmendrakumar","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Suyash","familyName":"Gupta","name":"Gupta, Suyash","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Karthik","familyName":"Sethuraman","name":"Sethuraman, Karthik","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Tejas","familyName":"Dharamsi","name":"Dharamsi, Tejas","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Support Tokens, Stability Margins, and a New Foundation for Robust LLMs"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"Probability (math.PR)","lang":"en","subjectScheme":"arXiv"},{"subject":"Statistics Theory (math.ST)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"I.2.7; G.3; G.4","lang":"en","subjectScheme":"ACM"}],"contributors":[],"dates":[{"date":"2026-02-25T08:44:44Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:01:34Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-03-01T22:13:09Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-03-03T02:26:48Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-03-21T20:43:35Z","dateType":"Submitted","dateInformation":"v3"},{"date":"2026-03-24T00:50:17Z","dateType":"Updated","dateInformation":"v3"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"3","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Self-attention is usually described as a flexible, content-adaptive way to mix a token with information from its past. We reinterpret causal self-attention transformers, the backbone of modern foundation models, within a probabilistic framework, much as classical PCA is extended to probabilistic PCA. This reformulation reveals a key structural consequence of the underlying change of variables: a barrier constraint emerges on the parameters of self-attention. The resulting geometry exposes a degeneracy boundary where the attention-induced mapping becomes locally ill-conditioned, yielding a stability-margin interpretation analogous to the margin in support vector machines. This, in turn, naturally gives rise to the concept of support tokens.\n We further show that causal transformers define a consistent stochastic process over infinite token sequences, providing a rigorous probabilistic foundation for sequence modeling. Building on this view, we derive a Bayesian MAP training objective that requires only a minimal modification to standard LLM training: adding a smooth log-barrier penalty to the usual cross-entropy loss. Empirically, the resulting training objective improves robustness to input perturbations and sharpens the margin geometry of the learned representations without sacrificing out-of-sample accuracy."},{"descriptionType":"Other","description":"45 pages, 9 figures"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.22271","contentUrl":null,"metadataVersion":2,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T02:42:31Z","registered":"2026-02-27T02:42:32Z","published":null,"updated":"2026-03-24T04:24:33Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.22896","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.22896","identifiers":[{"identifier":"2602.22896","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Zebin","familyName":"Yang","name":"Yang, Zebin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yijiahao","familyName":"Qi","name":"Qi, Yijiahao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Tong","familyName":"Xie","name":"Xie, Tong","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Bo","familyName":"Yu","name":"Yu, Bo","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Shaoshan","familyName":"Liu","name":"Liu, Shaoshan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Meng","familyName":"Li","name":"Li, Meng","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"DySL-VLA: Efficient Vision-Language-Action Model Inference via Dynamic-Static Layer-Skipping for Robot Manipulation"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Robotics (cs.RO)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-26T11:34:36Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:40:32Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02-27T01:54:01Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-03-02T01:13:09Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-03-17T07:08:40Z","dateType":"Submitted","dateInformation":"v3"},{"date":"2026-03-18T00:38:32Z","dateType":"Updated","dateInformation":"v3"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"3","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Vision-Language-Action (VLA) models have shown remarkable success in robotic tasks like manipulation by fusing a language model's reasoning with a vision model's 3D understanding. However, their high computational cost remains a major obstacle for real-world applications that require real-time performance. We observe that the actions within a task have varying levels of importance: critical steps demand high precision, while less important ones can tolerate more variance. Leveraging this insight, we propose DySL-VLA, a novel framework that addresses computational cost by dynamically skipping VLA layers based on each action's importance. DySL-VLA categorizes its layers into two types: informative layers, which are consistently executed, and incremental layers, which can be selectively skipped. To intelligently skip layers without sacrificing accuracy, we invent a prior-post skipping guidance mechanism to determine when to initiate layer-skipping. We also propose a skip-aware two-stage knowledge distillation algorithm to efficiently train a standard VLA into a DySL-VLA. Our experiments indicate that DySL-VLA achieves 2.1% improvement in success length over Deer-VLA on the Calvin dataset, while simultaneously reducing trainable parameters by a factor of 85.7 and providing a 3.75x speedup relative to the RoboFlamingo baseline at iso-accuracy. Our code is available on https://github.com/PKU-SEC-Lab/DYSL_VLA."},{"descriptionType":"Other","description":"DAC 2026"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.22896","contentUrl":null,"metadataVersion":2,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T02:57:24Z","registered":"2026-02-27T02:57:24Z","published":null,"updated":"2026-03-18T02:53:42Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.22579","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.22579","identifiers":[{"identifier":"2602.22579","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Pablo","familyName":"Valle","name":"Valle, Pablo","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Sergio","familyName":"Segura","name":"Segura, Sergio","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Shaukat","familyName":"Ali","name":"Ali, Shaukat","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Aitor","familyName":"Arrieta","name":"Arrieta, Aitor","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Metamorphic Testing of Vision-Language Action-Enabled Robots"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Robotics (cs.RO)","lang":"en","subjectScheme":"arXiv"},{"subject":"Software Engineering (cs.SE)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-26T03:32:43Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:21:06Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-03-17T13:56:42Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-03-18T01:06:03Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Vision-Language-Action (VLA) models are multimodal robotic task controllers that, given an instruction and visual inputs, produce a sequence of low-level control actions (or motor commands) enabling a robot to execute the requested task in the physical environment. These systems face the test oracle problem from multiple perspectives. On the one hand, a test oracle must be defined for each instruction prompt, which is a complex and non-generalizable approach. On the other hand, current state-of-the-art oracles typically capture symbolic representations of the world (e.g., robot and object states), enabling the correctness evaluation of a task, but fail to assess other critical aspects, such as the quality with which VLA-enabled robots perform a task. In this paper, we explore whether Metamorphic Testing (MT) can alleviate the test oracle problem in this context. To do so, we propose two metamorphic relation patterns and five metamorphic relations to assess whether changes to the test inputs impact the original trajectory of the VLA-enabled robots. An empirical study involving five VLA models, two simulated robots, and four robotic tasks shows that MT can effectively alleviate the test oracle problem by automatically detecting diverse types of failures, including, but not limited to, uncompleted tasks. More importantly, the proposed MRs are generalizable, making the proposed approach applicable across different VLA models, robots, and tasks, even in the absence of test oracles."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.22579","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T02:49:41Z","registered":"2026-02-27T02:49:41Z","published":null,"updated":"2026-03-18T02:53:41Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.23329","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.23329","identifiers":[{"identifier":"2602.23329","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Chen Bo Calvin","familyName":"Zhang","name":"Zhang, Chen Bo Calvin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Christina Q.","familyName":"Knight","name":"Knight, Christina Q.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Nicholas","familyName":"Kruus","name":"Kruus, Nicholas","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jason","familyName":"Hausenloy","name":"Hausenloy, Jason","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Pedro","familyName":"Medeiros","name":"Medeiros, Pedro","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Nathaniel","familyName":"Li","name":"Li, Nathaniel","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Aiden","familyName":"Kim","name":"Kim, Aiden","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yury","familyName":"Orlovskiy","name":"Orlovskiy, Yury","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Coleman","familyName":"Breen","name":"Breen, Coleman","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Bryce","familyName":"Cai","name":"Cai, Bryce","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jasper","familyName":"Götting","name":"Götting, Jasper","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Andrew Bo","familyName":"Liu","name":"Liu, Andrew Bo","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Samira","familyName":"Nedungadi","name":"Nedungadi, Samira","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Paula","familyName":"Rodriguez","name":"Rodriguez, Paula","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yannis Yiming","familyName":"He","name":"He, Yannis Yiming","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Mohamed","familyName":"Shaaban","name":"Shaaban, Mohamed","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zifan","familyName":"Wang","name":"Wang, Zifan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Seth","familyName":"Donoughe","name":"Donoughe, Seth","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Julian","familyName":"Michael","name":"Michael, Julian","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"LLM Novice Uplift on Dual-Use, In Silico Biology Tasks"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"Cryptography and Security (cs.CR)","lang":"en","subjectScheme":"arXiv"},{"subject":"Computers and Society (cs.CY)","lang":"en","subjectScheme":"arXiv"},{"subject":"Human-Computer Interaction (cs.HC)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-26T18:37:23Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T02:03:00Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-03-13T19:05:42Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-03-17T00:20:19Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Large language models (LLMs) perform increasingly well on biology benchmarks, but it remains unclear whether they uplift novice users -- i.e., enable humans to perform better than with internet-only resources. This uncertainty is central to understanding both scientific acceleration and dual-use risk. We conducted a multi-model, multi-benchmark human uplift study comparing novices with LLM access versus internet-only access across eight biosecurity-relevant task sets. Participants worked on complex problems with ample time (up to 13 hours for the most involved tasks). We found that LLM access provided substantial uplift: novices with LLMs were 4.16 times more accurate than controls (95% CI [2.63, 6.87]). On four benchmarks with available expert baselines (internet-only), novices with LLMs outperformed experts on three of them. Perhaps surprisingly, standalone LLMs often exceeded LLM-assisted novices, indicating that users were not eliciting the strongest available contributions from the LLMs. Most participants (89.6%) reported little difficulty obtaining dual-use-relevant information despite safeguards. Overall, LLMs substantially uplift novices on biological tasks previously reserved for trained practitioners, underscoring the need for sustained, interactive uplift evaluations alongside traditional benchmarks."},{"descriptionType":"Other","description":"59 pages, 33 figures"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.23329","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T03:08:10Z","registered":"2026-02-27T03:08:11Z","published":null,"updated":"2026-03-17T05:05:49Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.22827","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.22827","identifiers":[{"identifier":"2602.22827","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Reihaneh","familyName":"Iranmanesh","name":"Iranmanesh, Reihaneh","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Saeedeh","familyName":"Davoudi","name":"Davoudi, Saeedeh","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Pasha","familyName":"Abrishamchian","name":"Abrishamchian, Pasha","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ophir","familyName":"Frieder","name":"Frieder, Ophir","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Nazli","familyName":"Goharian","name":"Goharian, Nazli","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"TARAZ: Persian Short-Answer Question Benchmark for Cultural Evaluation of Language Models"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-26T10:08:02Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-03-02T01:12:52Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-03-16T00:09:10Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-03-17T01:40:16Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"This paper presents a comprehensive evaluation framework for assessing the cultural competence of large language models (LLMs) in Persian. Existing Persian cultural benchmarks rely predominantly on multiple-choice formats and English-centric metrics that fail to capture Persian's morphological complexity and semantic nuance. Our framework introduces a Persian-specific short-answer evaluation that combines rule-based morphological normalization with a hybrid syntactic and semantic similarity module, enabling robust soft-match scoring beyond exact string overlap. Through systematic evaluation of 15 state-of-the-art open- and closed-source models across three culturally grounded Persian datasets, we demonstrate that our hybrid evaluation improves scoring consistency by +10 compared to exact-match baselines by capturing meaning that surface-level methods cannot detect. Our human evaluation further confirms that the proposed semantic similarity metric achieves higher agreement with human judgments than LLM-based judges. We publicly release our evaluation framework, providing the first standardized benchmark for measuring cultural understanding in Persian and establishing a reproducible foundation for cross-cultural LLM evaluation research."},{"descriptionType":"Other","description":"12 pages, 6 figures, Fifteenth biennial Language Resources and Evaluation Conference (LREC) 2026 (to appear)"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.22827","contentUrl":null,"metadataVersion":2,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T02:55:39Z","registered":"2026-02-27T02:55:40Z","published":null,"updated":"2026-03-17T05:05:46Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.22680","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.22680","identifiers":[{"identifier":"2602.22680","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Yue","familyName":"Xu","name":"Xu, Yue","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Qian","familyName":"Chen","name":"Chen, Qian","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zizhan","familyName":"Ma","name":"Ma, Zizhan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Dongrui","familyName":"Liu","name":"Liu, Dongrui","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Wenxuan","familyName":"Wang","name":"Wang, Wenxuan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xiting","familyName":"Wang","name":"Wang, Xiting","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Li","familyName":"Xiong","name":"Xiong, Li","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Wenjie","familyName":"Wang","name":"Wang, Wenjie","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Toward Personalized LLM-Powered Agents: Foundations, Evaluation, and Future Directions"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-26T06:52:47Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:28:57Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-03-16T12:02:17Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-03-17T02:13:05Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Large language models have enabled agentic systems that reason, plan, and interact with tools and environments to accomplish complex tasks. As these agents operate over extended interaction horizons, their effectiveness increasingly depends on adapting behavior to individual users and maintaining continuity across interactions, giving rise to personalized LLM-powered agents (PLAs). In such long-term, user-dependent settings, personalization permeates the entire decision pipeline rather than remaining confined to surface-level response generation. This survey provides a capability-oriented review of personalized LLM-powered agents. Existing work is organized around four interdependent capabilities: profile modeling, memory, planning, and action execution. Using this taxonomy, representative methods are synthesized and analyzed to illustrate how user signals are represented, propagated, and utilized across the agent pipeline, highlighting cross-component interactions and recurring design challenges. Evaluation metrics and benchmarking paradigms tailored to personalized agents are further examined, along with application scenarios ranging from conversational assistants to domain-specific expert systems. By clarifying the design space of personalization in agent systems, this survey provides a structured foundation for developing more user-aligned, adaptive, and deployable LLM-powered agents."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.22680","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T02:52:05Z","registered":"2026-02-27T02:52:06Z","published":null,"updated":"2026-03-17T05:05:45Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.22442","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.22442","identifiers":[{"identifier":"2602.22442","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Gaoyuan","familyName":"Du","name":"Du, Gaoyuan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Amit","familyName":"Ahlawat","name":"Ahlawat, Amit","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xiaoyang","familyName":"Liu","name":"Liu, Xiaoyang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jing","familyName":"Wu","name":"Wu, Jing","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"A Framework for Assessing AI Agent Decisions and Outcomes in AutoML Pipelines"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"I.2.6; I.2.11; D.2.5","lang":"en","subjectScheme":"ACM"}],"contributors":[],"dates":[{"date":"2026-02-25T22:02:00Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:10:00Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-03-13T21:17:42Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-03-17T00:25:47Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Agent-based AutoML systems rely on large language models to make complex, multi-stage decisions across data processing, model selection, and evaluation. However, existing evaluation practices remain outcome-centric, focusing primarily on final task performance. Through a review of prior work, we find that none of the surveyed agentic AutoML systems report structured, decision-level evaluation metrics intended for post-hoc assessment of intermediate decision quality. To address this limitation, we propose an Evaluation Agent (EA) that performs decision-centric assessment of AutoML agents without interfering with their execution. The EA is designed as an observer that evaluates intermediate decisions along four dimensions: decision validity, reasoning consistency, model quality risks beyond accuracy, and counterfactual decision impact. Across four proof-of-concept experiments, we demonstrate that the EA can (i) detect faulty decisions with an F1 score of 0.919, (ii) identify reasoning inconsistencies independent of final outcomes, and (iii) attribute downstream performance changes to agent decisions, revealing impacts ranging from -4.9% to +8.3% in final metrics. These results illustrate how decision-centric evaluation exposes failure modes that are invisible to outcome-only metrics. Our work reframes the evaluation of agentic AutoML systems from an outcome-based perspective to one that audits agent decisions, offering a foundation for reliable, interpretable, and governable autonomous ML systems."},{"descriptionType":"Other","description":"10 pages"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.22442","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T02:46:29Z","registered":"2026-02-27T02:46:29Z","published":null,"updated":"2026-03-17T05:05:41Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.23228","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.23228","identifiers":[{"identifier":"2602.23228","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Yizhi","familyName":"Li","name":"Li, Yizhi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xiaohan","familyName":"Chen","name":"Chen, Xiaohan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Miao","familyName":"Jiang","name":"Jiang, Miao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Wentao","familyName":"Tang","name":"Tang, Wentao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Gaoang","familyName":"Wang","name":"Wang, Gaoang","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"MovieTeller: Tool-augmented Movie Synopsis with ID Consistent Progressive Abstraction"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-26T17:08:08Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:58:05Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-03-13T06:53:01Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-03-16T00:28:55Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"With the explosive growth of digital entertainment, automated video summarization has become indispensable for applications such as content indexing, personalized recommendation, and efficient media archiving. Automatic synopsis generation for long-form videos, such as movies and TV series, presents a significant challenge for existing Vision-Language Models (VLMs). While proficient at single-image captioning, these general-purpose models often exhibit critical failures in long-duration contexts, primarily a lack of ID-consistent character identification and a fractured narrative coherence. To overcome these limitations, we propose MovieTeller, a novel framework for generating movie synopses via tool-augmented progressive abstraction. Our core contribution is a training-free, tool-augmented, fact-grounded generation process. Instead of requiring costly model fine-tuning, our framework directly leverages off-the-shelf models in a plug-and-play manner. We first invoke a specialized face recognition model as an external \"tool\" to establish Factual Groundings--precise character identities and their corresponding bounding boxes. These groundings are then injected into the prompt to steer the VLM's reasoning, ensuring the generated scene descriptions are anchored to verifiable facts. Furthermore, our progressive abstraction pipeline decomposes the summarization of a full-length movie into a multi-stage process, effectively mitigating the context length limitations of current VLMs. Experiments demonstrate that our approach yields significant improvements in factual accuracy, character consistency, and overall narrative coherence compared to end-to-end baselines."},{"descriptionType":"Other","description":"6 pages, CSCWD 2026"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.23228","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T03:05:40Z","registered":"2026-02-27T03:05:41Z","published":null,"updated":"2026-03-16T02:11:53Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.23349","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.23349","identifiers":[{"identifier":"2602.23349","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Jose Javier Gonzalez","familyName":"Ortiz","name":"Ortiz, Jose Javier Gonzalez","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Abhay","familyName":"Gupta","name":"Gupta, Abhay","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Christopher","familyName":"Rinard","name":"Rinard, Christopher","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Davis","familyName":"Blalock","name":"Blalock, Davis","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"FlashOptim: Optimizers for Memory-Efficient Training"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-26T18:52:22Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T02:03:31Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-03-11T22:19:57Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-03-13T00:12:15Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by-sa/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution Share Alike 4.0 International","rightsIdentifier":"cc-by-sa-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Standard mixed-precision training of neural networks requires many bytes of accelerator memory for each model parameter. These bytes reflect not just the parameter itself, but also its gradient and one or more optimizer state variables. With each of these values typically requiring 4 bytes, training even a 7 billion parameter model can be impractical for researchers with less than 100GB of accelerator memory.\n We introduce FlashOptim, a suite of optimizations that reduces per-parameter memory by over 50% while preserving model quality and API compatibility. Our approach introduces two key techniques. First, we improve master weight splitting by finding and exploiting a tight bound on its quantization error. Second, we design companding functions that greatly reduce the error in 8-bit optimizer state quantization. Together with 16-bit gradients, these techniques reduce AdamW memory from 16 bytes to 7 bytes per parameter, or 5 bytes with gradient release. They also cut model checkpoint sizes by more than half.\n Experiments with FlashOptim applied to SGD, AdamW, and Lion show no measurable quality degradation on any task from a collection of standard vision and language benchmarks, including Llama-3.1-8B finetuning."},{"descriptionType":"Other","description":"Source code is available at https://github.com/databricks/flashoptim"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.23349","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T03:08:40Z","registered":"2026-02-27T03:08:41Z","published":null,"updated":"2026-03-13T02:24:16Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.22740","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.22740","identifiers":[{"identifier":"2602.22740","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Tongfei","familyName":"Chen","name":"Chen, Tongfei","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Shuo","familyName":"Yang","name":"Yang, Shuo","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yuguang","familyName":"Yang","name":"Yang, Yuguang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Linlin","familyName":"Yang","name":"Yang, Linlin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Runtang","familyName":"Guo","name":"Guo, Runtang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Changbai","familyName":"Li","name":"Li, Changbai","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"He","familyName":"Long","name":"Long, He","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Chunyu","familyName":"Xie","name":"Xie, Chunyu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Dawei","familyName":"Leng","name":"Leng, Dawei","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Baochang","familyName":"Zhang","name":"Zhang, Baochang","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"AMLRIS: Alignment-aware Masked Learning for Referring Image Segmentation"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-26T08:29:04Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:32:25Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-03-11T04:23:48Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-03-12T00:25:30Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Referring Image Segmentation (RIS) aims to segment the object in an image uniquely referred to by a natural language expression. However, RIS training often contains hard-to-align and instance-specific visual signals; optimizing on such pixels injects misleading gradients and drives the model in the wrong direction. By explicitly estimating pixel-level vision-language alignment, the learner can suppress low-alignment regions, concentrate on reliable cues, and acquire more generalizable alignment features.\n In this paper, we propose Alignment-Aware Masked Learning (AML), a simple yet effective training strategy that quantifies region-referent alignment (PMME) and filters out unreliable pixels during optimization (AFM). Specifically, each sample first computes a similarity map between visual and textual features, and then masks out pixels falling below an adaptive similarity threshold, thereby excluding poorly aligned regions from the training process. AML does not require architectural changes and incurs no inference overhead, directing attention to the areas aligned with the textual description. Experiments on the RefCOCO (vanilla/+/g) datasets show that AML achieves state-of-the-art results across all 8 splits, and beyond improving RIS performance, AML also enhances the model's robustness to diverse descriptions and scenarios. Code is available at https://github.com/pipashu1/AMLRIS."},{"descriptionType":"Other","description":"ICLR 2026 conference paper"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.22740","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T02:53:29Z","registered":"2026-02-27T02:53:30Z","published":null,"updated":"2026-03-12T02:30:32Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.22427","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.22427","identifiers":[{"identifier":"2602.22427","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Idan","familyName":"Habler","name":"Habler, Idan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Vineeth Sai","familyName":"Narajala","name":"Narajala, Vineeth Sai","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Stav","familyName":"Koren","name":"Koren, Stav","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Amy","familyName":"Chang","name":"Chang, Amy","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Tiffany","familyName":"Saade","name":"Saade, Tiffany","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Adversarial Hubness Detector: Detecting Hubness Poisoning in Retrieval-Augmented Generation Systems"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Cryptography and Security (cs.CR)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-25T21:37:53Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:09:12Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-03-11T01:08:33Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-03-12T00:17:43Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Retrieval-Augmented Generation (RAG) systems are essential to contemporary AI applications, allowing large language models to obtain external knowledge via vector similarity search. Nevertheless, these systems encounter a significant security flaw: hubness - items that frequently appear in the top-$k$ retrieval results for a disproportionately high number of varied queries. These hubs can be exploited to introduce harmful content, alter search rankings, bypass content filtering, and decrease system performance.\n We introduce hubscan, an open-source security scanner that evaluates vector indices and embeddings to identify hubs in RAG systems. Hubscan presents a multi-detector architecture that integrates: (1) robust statistical hubness detection utilizing median/Median Absolute Deviation (MAD)-based z-scores, (2) cluster spread analysis to assess cross-cluster retrieval patterns, (3) stability testing under query perturbations, and (4) domain-aware and modality-aware detection for category-specific and cross-modal attacks. Our solution accommodates several vector databases (FAISS, Pinecone, Qdrant, Weaviate) and offers versatile retrieval techniques, including vector similarity, hybrid search, and lexical matching with reranking capabilities.\n We evaluate hubscan on Food-101, MS-COCO, and FiQA adversarial hubness benchmarks constructed using state-of-the-art gradient-optimized and centroid-based hub generation methods. Hubscan achieves 90% recall at a 0.2% alert budget and 100% recall at 0.4%, with adversarial hubs ranking above the 99.8th percentile. In testing, domain-scoped scanning recovered 100% of targeted attacks that evaded global detection. Production validation on 1M real web documents from MS MARCO demonstrates significant score separation between clean documents and adversarial content."},{"descriptionType":"Other","description":"11 pages, 5 figures, 2 tables, Github: https://github.com/cisco-ai-defense/adversarial-hubness-detector, Updated with minor changes to naming"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.22427","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T02:46:08Z","registered":"2026-02-27T02:46:09Z","published":null,"updated":"2026-03-12T02:30:31Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.22706","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.22706","identifiers":[{"identifier":"2602.22706","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Yuzhou","familyName":"Hao","name":"Hao, Yuzhou","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yujie","familyName":"Liu","name":"Liu, Yujie","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xuejie","familyName":"Li","name":"Li, Xuejie","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Turab","familyName":"Lookman","name":"Lookman, Turab","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xiangdong","familyName":"Ding","name":"Ding, Xiangdong","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jun","familyName":"Sun","name":"Sun, Jun","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zhibin","familyName":"Gao","name":"Gao, Zhibin","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"LLM-driven discovery for carbon allotropes with bond-network entropy"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Materials Science (cond-mat.mtrl-sci)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-26T07:30:29Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-03-11T00:59:35Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[{"relationType":"IsVersionOf","relatedIdentifier":"10.1063/5.0314279","relatedIdentifierType":"DOI"}],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"The discovery of novel carbon allotropes with tailored thermal and mechanical properties is critical for advanced thermal management. However, exploring the vast configurational space of carbon using \\textit{ab initio} calculations remains computationally prohibitive. Driven by the rich topological landscape of carbon, where the competition between $sp, sp^2,$ and $sp^3$ hybridization states dictates material performance, we establish a closed-loop AI framework to explore this complex configurational space. We introduce a hybridization entropy descriptor to guide the search beyond conventional forms. Here, we establish a closed-loop AI framework that synergizes a Large Language Model (LLM) for structural generation with a Machine Learning Potential (MLP) for accelerated evaluation. Leveraging CrystaLLM to generate candidates and an iteratively refined MLP for high-fidelity validation, we screened thousands of structures to identify several stable allotropes with exotic properties. Specifically, we report ``yne-diamond C$_{12}$'' and ``yne-hex-diamond C$_{8}$'', which exhibit extreme thermal anisotropy and ultralow in-plane shear stiffness arising from their mixed $sp$-$sp^3$ hybridization. Furthermore, we discovered a complex $sp$-$sp^2$-$sp^3$ hybridized C$_{12}$ phase that combines metallic conductivity with an anomalous negative Poisson's ratio. Notably, we identified a superhard phase (C16_3) possessing a calculated Vickers hardness (103.3 GPa) exceeding that of diamond 96 GPa). Microscopic analysis reveals that thermal transport in these materials is governed by the interplay between rigid frameworks and flexible linkers. This work expands the known carbon phase space and demonstrates the efficacy of coupling generative AI with machine learning potentials for the accelerated inverse design of functional materials."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.22706","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":1,"created":"2026-02-27T02:52:42Z","registered":"2026-02-27T02:52:42Z","published":null,"updated":"2026-03-11T02:37:52Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.22758","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.22758","identifiers":[{"identifier":"2602.22758","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Satya","familyName":"Borgohain","name":"Borgohain, Satya","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Roy","familyName":"Mariathas","name":"Mariathas, Roy","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Decomposing Physician Disagreement in HealthBench"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"Applications (stat.AP)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"I.2; J.3; I.2.1","lang":"en","subjectScheme":"ACM"}],"contributors":[],"dates":[{"date":"2026-02-26T08:47:42Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:33:16Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-03-08T11:45:15Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-03-10T01:11:49Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"We decompose physician disagreement in the HealthBench medical AI evaluation dataset to understand where variance resides and what observable features can explain it. Rubric identity accounts for 15.8% of met/not-met label variance but only 3.6-6.9% of disagreement variance; physician identity accounts for just 2.4%. The dominant 81.8% case-level residual is not reduced by HealthBench's metadata labels (z = -0.22, p = 0.83), normative rubric language (pseudo R^2 = 1.2%), medical specialty (0/300 Tukey pairs significant), surface-feature triage (AUC = 0.58), or embeddings (AUC = 0.485). Disagreement follows an inverted-U with completion quality (AUC = 0.689), confirming physicians agree on clearly good or bad outputs but split on borderline cases. Physician-validated uncertainty categories reveal that reducible uncertainty (missing context, ambiguous phrasing) more than doubles disagreement odds (OR = 2.55, p \u0026lt; 10^(-24)), while irreducible uncertainty (genuine medical ambiguity) has no effect (OR = 1.01, p = 0.90), though even the former explains only ~3% of total variance. The agreement ceiling in medical AI evaluation is thus largely structural, but the reducible/irreducible dissociation suggests that closing information gaps in evaluation scenarios could lower disagreement where inherent clinical ambiguity does not, pointing toward actionable evaluation design improvements."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.22758","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T02:53:56Z","registered":"2026-02-27T02:53:57Z","published":null,"updated":"2026-03-10T04:59:35Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.22555","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.22555","identifiers":[{"identifier":"2602.22555","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Sicheng","familyName":"Dai","name":"Dai, Sicheng","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Hongwang","familyName":"Xiao","name":"Xiao, Hongwang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Shan","familyName":"Yu","name":"Yu, Shan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Qiwei","familyName":"Ye","name":"Ye, Qiwei","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Autoregressive Visual Decoding from EEG Signals"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-26T02:49:04Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:18:21Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-03-09T12:57:06Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-03-10T02:09:02Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Electroencephalogram (EEG) signals have become a popular medium for decoding visual information due to their cost-effectiveness and high temporal resolution. However, current approaches face significant challenges in bridging the modality gap between EEG and image data. These methods typically rely on complex adaptation processes involving multiple stages, making it hard to maintain consistency and manage compounding errors. Furthermore, the computational overhead imposed by large-scale diffusion models limit their practicality in real-world brain-computer interface (BCI) applications. In this work, we present AVDE, a lightweight and efficient framework for visual decoding from EEG signals. First, we leverage LaBraM, a pre-trained EEG model, and fine-tune it via contrastive learning to align EEG and image representations. Second, we adopt an autoregressive generative framework based on a \"next-scale prediction\" strategy: images are encoded into multi-scale token maps using a pre-trained VQ-VAE, and a transformer is trained to autoregressively predict finer-scale tokens starting from EEG embeddings as the coarsest representation. This design enables coherent generation while preserving a direct connection between the input EEG signals and the reconstructed images. Experiments on two datasets show that AVDE outperforms previous state-of-the-art methods in both image retrieval and reconstruction tasks, while using only 10% of the parameters. In addition, visualization of intermediate outputs shows that the generative process of AVDE reflects the hierarchical nature of human visual perception. These results highlight the potential of autoregressive models as efficient and interpretable tools for practical BCI applications."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.22555","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T02:49:06Z","registered":"2026-02-27T02:49:07Z","published":null,"updated":"2026-03-10T04:59:31Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.22519","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.22519","identifiers":[{"identifier":"2602.22519","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Wael","familyName":"Hafez","name":"Hafez, Wael","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Chenan","familyName":"Wei","name":"Wei, Chenan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Rodrigo","familyName":"Pena","name":"Pena, Rodrigo","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Amir","familyName":"Nazeri","name":"Nazeri, Amir","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Cameron","familyName":"Reid","name":"Reid, Cameron","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"A Mathematical Theory of Agency and Intelligence"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"Information Theory (cs.IT)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-26T01:26:21Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:14:27Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-03-08T01:03:43Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-03-10T00:59:46Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"To operate reliably under changing conditions, complex systems require feedback on how effectively they use resources, not just whether objectives are met. Current AI systems process vast information to produce sophisticated predictions, yet predictions can appear successful while the underlying interaction with the environment degrades. What is missing is a principled measure of how much of the total information a system deploys is actually shared between its observations, actions, and outcomes. We prove this shared fraction, which we term bipredictability, P, is intrinsic to any interaction, derivable from first principles, and strictly bounded: P can reach unity in quantum systems, P equal to, or smaller than 0.5 in classical systems, and lower once agency (action selection) is introduced. We confirm these bounds in a physical system (double pendulum), reinforcement learning agents, and multi turn LLM conversations. These results distinguish agency from intelligence: agency is the capacity to act on predictions, whereas intelligence additionally requires learning from interaction, self-monitoring of its learning effectiveness, and adapting the scope of observations, actions, and outcomes to restore effective learning. By this definition, current AI systems achieve agency but not intelligence. Inspired by thalamocortical regulation in biological systems, we demonstrate a feedback architecture that monitors P in real time, establishing a prerequisite for adaptive, resilient AI."},{"descriptionType":"Other","description":"20 pages, 4 figuers"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.22519","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T02:48:15Z","registered":"2026-02-27T02:48:16Z","published":null,"updated":"2026-03-10T04:59:29Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.23136","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.23136","identifiers":[{"identifier":"2602.23136","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Jayadev","familyName":"Billa","name":"Billa, Jayadev","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Modality Collapse as Mismatched Decoding: Information-Theoretic Limits of Multimodal LLMs"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-26T15:52:48Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:53:58Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-03-05T21:40:54Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-03-09T00:09:31Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Numerous studies have shown that multimodal LLMs process speech and images well but fail in non-intuitive ways rendering trivial tasks such as object counting unreliable. We investigate this behavior from an information-theoretic perspective by framing multimodal LLM inference as a mismatched decoder problem: a decoder trained primarily on text can only extract information along text-aligned directions (removing up to 98% of the variation in modality-specific (non-text) directions improves decoder loss) and the amount of accessible information is bounded by the Generalized Mutual Information (GMI). We show that information loss is bounded as the distributional mismatch between the source data and the text data increases, and as the sensitivity of the decoder increases. This bound is a function of the model's scoring rule not its architecture. We validate the predictions across five models spanning speech and vision. A controlled study (two Prismatic VLMs differing only in encoder text-alignment) shows that the bottleneck lies in the scoring rule of the decoder rather than the text-alignment of the encoder or the learned projection. A LoRA intervention demonstrates that simply training with an emotion-related objective improves emotion detection from 17.3% to 61.8% task accuracy without affecting other attributes, confirming that the training objective determines what becomes accessible."},{"descriptionType":"Other","description":"24 pages, 11 tables, 2 figures. Code: https://github.com/jb1999/modality_collapse_paper, submitted for review COLM 2026"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.23136","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T03:03:18Z","registered":"2026-02-27T03:03:19Z","published":null,"updated":"2026-03-09T02:13:38Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.23008","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.23008","identifiers":[{"identifier":"2602.23008","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Zeyuan","familyName":"Liu","name":"Liu, Zeyuan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jeonghye","familyName":"Kim","name":"Kim, Jeonghye","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xufang","familyName":"Luo","name":"Luo, Xufang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Dongsheng","familyName":"Li","name":"Li, Dongsheng","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yuqing","familyName":"Yang","name":"Yang, Yuqing","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Exploratory Memory-Augmented LLM Agent via Hybrid On- and Off-Policy Optimization"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-26T13:50:57Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:46:51Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-03-06T09:42:17Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-03-09T00:36:00Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Exploration remains the key bottleneck for large language model agents trained with reinforcement learning. While prior methods exploit pretrained knowledge, they fail in environments requiring the discovery of novel states. We propose Exploratory Memory-Augmented On- and Off-Policy Optimization (EMPO$^2$), a hybrid RL framework that leverages memory for exploration and combines on- and off-policy updates to make LLMs perform well with memory while also ensuring robustness without it. On ScienceWorld and WebShop, EMPO$^2$ achieves 128.6% and 11.3% improvements over GRPO, respectively. Moreover, in out-of-distribution tests, EMPO$^2$ demonstrates superior adaptability to new tasks, requiring only a few trials with memory and no parameter updates. These results highlight EMPO$^2$ as a promising framework for building more exploratory and generalizable LLM-based agents."},{"descriptionType":"Other","description":"Accepted to ICLR 2026"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.23008","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T03:00:15Z","registered":"2026-02-27T03:00:16Z","published":null,"updated":"2026-03-09T02:13:37Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.22654","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.22654","identifiers":[{"identifier":"2602.22654","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Bowen","familyName":"Cui","name":"Cui, Bowen","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yuanbin","familyName":"Wang","name":"Wang, Yuanbin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Huajiang","familyName":"Xu","name":"Xu, Huajiang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Biaolong","familyName":"Chen","name":"Chen, Biaolong","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Aixi","familyName":"Zhang","name":"Zhang, Aixi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Hao","familyName":"Jiang","name":"Jiang, Hao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zhengzheng","familyName":"Jin","name":"Jin, Zhengzheng","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xu","familyName":"Liu","name":"Liu, Xu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Pipei","familyName":"Huang","name":"Huang, Pipei","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Denoising as Path Planning: Training-Free Acceleration of Diffusion Models with DPCache"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-26T06:13:33Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:26:48Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-03-06T09:34:23Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-03-09T00:35:19Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Diffusion models have demonstrated remarkable success in image and video generation, yet their practical deployment remains hindered by the substantial computational overhead of multi-step iterative sampling. Among acceleration strategies, caching-based methods offer a training-free and effective solution by reusing or predicting features across timesteps. However, existing approaches rely on fixed or locally adaptive schedules without considering the global structure of the denoising trajectory, often leading to error accumulation and visual artifacts. To overcome this limitation, we propose DPCache, a novel training-free acceleration framework that formulates diffusion sampling acceleration as a global path planning problem. DPCache constructs a Path-Aware Cost Tensor from a small calibration set to quantify the path-dependent error of skipping timesteps conditioned on the preceding key timestep. Leveraging this tensor, DPCache employs dynamic programming to select an optimal sequence of key timesteps that minimizes the total path cost while preserving trajectory fidelity. During inference, the model performs full computations only at these key timesteps, while intermediate outputs are efficiently predicted using cached features. Extensive experiments on DiT, FLUX, and HunyuanVideo demonstrate that DPCache achieves strong acceleration with minimal quality loss, outperforming prior acceleration methods by $+$0.031 ImageReward at 4.87$\\times$ speedup and even surpassing the full-step baseline by $+$0.028 ImageReward at 3.54$\\times$ speedup on FLUX, validating the effectiveness of our path-aware global scheduling framework. Code is available at https://github.com/argsss/DPCache."},{"descriptionType":"Other","description":"Accepted by CVPR 2026"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.22654","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T02:51:27Z","registered":"2026-02-27T02:51:28Z","published":null,"updated":"2026-03-09T02:13:35Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.22289","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.22289","identifiers":[{"identifier":"2602.22289","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Ihor","familyName":"Kendiukhov","name":"Kendiukhov, Ihor","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"What Topological and Geometric Structure Do Biological Foundation Models Learn? Evidence from 141 Hypotheses"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Quantitative Methods (q-bio.QM)","lang":"en","subjectScheme":"arXiv"},{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"Genomics (q-bio.GN)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Biological sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Biological sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-25T14:33:24Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:01:58Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-03-05T20:03:46Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-03-09T00:06:13Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"When biological foundation models such as scGPT and Geneformer process single-cell gene expression, what geometric and topological structure forms in their internal representations? Is that structure biologically meaningful or a training artifact, and how confident should we be in such claims? We address these questions through autonomous large-scale hypothesis screening: an AI-driven executor-brainstormer loop that proposed, tested, and refined 141 geometric and topological hypotheses across 52 iterations, covering persistent homology, manifold distances, cross-model alignment, community structure, and directed topology, all with explicit null controls and disjoint gene-pool splits.\n Three principal findings emerge. First, the models learn genuine geometric structure. Gene embedding neighborhoods exhibit non-trivial topology, with persistent homology significant in 11 of 12 transformer layers at p \u0026lt; 0.05 in the weakest domain and 12 of 12 in the other two. A multi-level distance hierarchy shows that manifold-aware metrics outperform Euclidean distance for identifying regulatory gene pairs, and graph community partitions track known transcription factor target relationships. Second, this structure is shared across independently trained models. CCA alignment between scGPT and Geneformer yields canonical correlation of 0.80 and gene retrieval accuracy of 72 percent, yet none of 19 tested methods reliably recover gene-level correspondences. The models agree on the global shape of gene space but not on precise gene placement. Third, the structure is more localized than it first appears. Under stringent null controls applied across all null families, robust signal concentrates in immune tissue, while lung and external lung signals weaken substantially."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.22289","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T02:42:56Z","registered":"2026-02-27T02:42:57Z","published":null,"updated":"2026-03-09T02:13:34Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.22730","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.22730","identifiers":[{"identifier":"2602.22730","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Jakub","familyName":"Šmíd","name":"Šmíd, Jakub","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Pavel","familyName":"Přibáň","name":"Přibáň, Pavel","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Pavel","familyName":"Král","name":"Král, Pavel","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Extending Czech Aspect-Based Sentiment Analysis with Opinion Terms: Dataset and LLM Benchmarks"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-26T08:13:42Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:32:03Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-03-04T09:21:05Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-03-05T01:42:51Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by-nc-sa/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution Non Commercial Share Alike 4.0 International","rightsIdentifier":"cc-by-nc-sa-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"This paper introduces a novel Czech dataset in the restaurant domain for aspect-based sentiment analysis (ABSA), enriched with annotations of opinion terms. The dataset supports three distinct ABSA tasks involving opinion terms, accommodating varying levels of complexity. Leveraging this dataset, we conduct extensive experiments using modern Transformer-based models, including large language models (LLMs), in monolingual, cross-lingual, and multilingual settings. To address cross-lingual challenges, we propose a translation and label alignment methodology leveraging LLMs, which yields consistent improvements. Our results highlight the strengths and limitations of state-of-the-art models, especially when handling the linguistic intricacies of low-resource languages like Czech. A detailed error analysis reveals key challenges, including the detection of subtle opinion terms and nuanced sentiment expressions. The dataset establishes a new benchmark for Czech ABSA, and our proposed translation-alignment approach offers a scalable solution for adapting ABSA resources to other low-resource languages."},{"descriptionType":"Other","description":"Accepted for the 15th edition of the Language Resources and Evaluation Conference (LREC 2026)"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.22730","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T02:53:15Z","registered":"2026-02-27T02:53:16Z","published":null,"updated":"2026-03-05T03:49:39Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.22469","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.22469","identifiers":[{"identifier":"2602.22469","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Niamul Hassan","familyName":"Samin","name":"Samin, Niamul Hassan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Md Arifur","familyName":"Rahman","name":"Rahman, Md Arifur","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Abdullah Ibne Hanif","familyName":"Arean","name":"Arean, Abdullah Ibne Hanif","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Juena Ahmed","familyName":"Noshin","name":"Noshin, Juena Ahmed","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Md Ashikur","familyName":"Rahman","name":"Rahman, Md Ashikur","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Beyond Dominant Patches: Spatial Credit Redistribution For Grounded Vision-Language Models"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-25T23:08:31Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:11:22Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-03-04T18:21:09Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-03-05T02:17:39Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Vision-Language Models (VLMs) often hallucinate objects that are not present in the input image. We identify a contributing cause of this behavior, which we term spatial credit collapse: in early transformer layers, hidden-state activation concentrates on a small number of visual patches, suppressing surrounding contextual evidence and increasing reliance on language priors. Across seven models we observe a strong correlation between visual attention entropy and hallucination rate (r = -0.65, p \u0026lt; 0.001), suggesting that reduced spatial credit diversity contributes to hallucination.\n To address this issue we propose Spatial Credit Redistribution (SCR), a training-free inference-time method. SCR uses a lightweight two-pass procedure. A diagnostic pass identifies the top-K high-attention source patches and their spatial neighbors. A redistribution pass then scales each source by 1/lambda (~0.91) and injects a (lambda - 1) weighted copy of its hidden state into neighboring patches, restoring suppressed visual context without modifying model weights. Because the diagnostic pass is performed once per image and reused across the output sequence, the added latency is negligible (\u0026lt;0.5 ms per token for 100-token responses).\n We evaluate SCR across seven model configurations from four VLM families (Chameleon, LLaVA-1.5, Qwen-VL/Qwen2-VL, and InternVL2) on five benchmarks: POPE, CHAIR, MME, HallusionBench, and AMBER. SCR reduces POPE-Adversarial hallucination by 4.6-6.0 percentage points and CHAIR-s by 41-51 percent while preserving caption quality (CIDEr drop \u0026lt;=0.8). Compared with prior inference-time methods including OPERA, VCD, OA-VCD, DoLa, VLI, SID, and CRoPS, SCR achieves a better trade-off between hallucination reduction, generation quality, and latency."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.22469","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T02:47:05Z","registered":"2026-02-27T02:47:06Z","published":null,"updated":"2026-03-05T03:49:36Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.22227","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.22227","identifiers":[{"identifier":"2602.22227","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Yicheng","familyName":"Bao","name":"Bao, Yicheng","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xuhong","familyName":"Wang","name":"Wang, Xuhong","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Qiaosheng","familyName":"Zhang","name":"Zhang, Qiaosheng","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Chaochao","familyName":"Lu","name":"Lu, Chaochao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xia","familyName":"Hu","name":"Hu, Xia","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xin","familyName":"Tan","name":"Tan, Xin","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Dynamic Adversarial Reinforcement Learning for Robust Multimodal Large Language Models"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-01-24T03:47:29Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:00:27Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02-27T05:20:42Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-03-02T01:24:21Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-03-04T11:04:46Z","dateType":"Submitted","dateInformation":"v3"},{"date":"2026-03-05T01:48:18Z","dateType":"Updated","dateInformation":"v3"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"3","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Despite their impressive capabilities, Multimodal Large Language Models (MLLMs) exhibit perceptual fragility when confronted with visually complex scenes. This weakness stems from a reliance on finite training datasets, which are prohibitively expensive to scale and impose a ceiling on model robustness. We introduce \\textbf{AOT-SFT}, a large-scale adversarial dataset for bootstrapping MLLM robustness. Building on this, we propose \\textbf{AOT (Adversarial Opponent Training)}, a self-play framework that forges MLLM robustness by creating its own training data. Our method orchestrates a co-evolution between an image-editing Attacker and a Defender MLLM, where the Attacker generates a diverse and dynamic curriculum of image manipulations, forcing the Defender to adapt and improve. Extensive experiments demonstrate that AOT enhances the Defender's perceptual robustness and reduces hallucinations, establishing a scalable paradigm for training more reliable MLLMs."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.22227","contentUrl":null,"metadataVersion":2,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T02:41:30Z","registered":"2026-02-27T02:41:30Z","published":null,"updated":"2026-03-05T03:49:35Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.23201","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.23201","identifiers":[{"identifier":"2602.23201","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Max S.","familyName":"Bennett","name":"Bennett, Max S.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Thomas P.","familyName":"Zollo","name":"Zollo, Thomas P.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Richard","familyName":"Zemel","name":"Zemel, Richard","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Tell Me What To Learn: Generalizing Neural Memory to be Controllable in Natural Language"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-26T16:50:52Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:56:58Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-03-03T17:14:53Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-03-04T02:03:21Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Modern machine learning models are deployed in diverse, non-stationary environments where they must continually adapt to new tasks and evolving knowledge. Continual fine-tuning and in-context learning are costly and brittle, whereas neural memory methods promise lightweight updates with minimal forgetting. However, existing neural memory models typically assume a single fixed objective and homogeneous information streams, leaving users with no control over what the model remembers or ignores over time. To address this challenge, we propose a generalized neural memory system that performs flexible updates based on learning instructions specified in natural language. Our approach enables adaptive agents to learn selectively from heterogeneous information sources, supporting settings, such as healthcare and customer service, where fixed-objective memory updates are insufficient."},{"descriptionType":"Other","description":"58 Pages, 16 Figures, Code at https://github.com/maxbennett/Generalized-Neural-Memory; updated with acknowledgements"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.23201","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T03:04:57Z","registered":"2026-02-27T03:04:58Z","published":null,"updated":"2026-03-04T03:23:49Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.23191","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.23191","identifiers":[{"identifier":"2602.23191","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Xinyuan","familyName":"Chen","name":"Chen, Xinyuan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yao","familyName":"Xu","name":"Xu, Yao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Shaowen","familyName":"Wang","name":"Wang, Shaowen","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Pengjie","familyName":"Song","name":"Song, Pengjie","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Bowen","familyName":"Deng","name":"Deng, Bowen","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Uni-Animator: Towards Unified Visual Colorization"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-26T16:44:37Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:56:41Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-03-03T07:49:53Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-03-04T01:33:15Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"We propose Uni-Animator, a novel Diffusion Transformer (DiT)-based framework for unified image and video sketch colorization. Existing sketch colorization methods struggle to unify image and video tasks, suffering from imprecise color transfer with single or multiple references, inadequate preservation of high-frequency physical details, and compromised temporal coherence with motion artifacts in large-motion scenes. To tackle imprecise color transfer, we introduce visual reference enhancement via instance patch embedding, enabling precise alignment and fusion of reference color information. To resolve insufficient physical detail preservation, we design physical detail reinforcement using physical features that effectively capture and retain high-frequency textures. To mitigate motion-induced temporal inconsistency, we propose sketch-based dynamic RoPE encoding that adaptively models motion-aware spatial-temporal dependencies. Extensive experimental results demonstrate that Uni-Animator achieves competitive performance on both image and video sketch colorization, matching that of task-specific methods while unlocking unified cross-domain capabilities with high detail fidelity and robust temporal consistency."},{"descriptionType":"Other","description":"12 pages, 8 figures"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.23191","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T03:04:42Z","registered":"2026-02-27T03:04:43Z","published":null,"updated":"2026-03-04T03:23:48Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.22903","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.22903","identifiers":[{"identifier":"2602.22903","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Yunpeng","familyName":"Hong","name":"Hong, Yunpeng","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Chenyang","familyName":"Bu","name":"Bu, Chenyang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jie","familyName":"Zhang","name":"Zhang, Jie","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yi","familyName":"He","name":"He, Yi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Di","familyName":"Wu","name":"Wu, Di","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xindong","familyName":"Wu","name":"Wu, Xindong","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"PSQE: A Theoretical-Practical Approach to Pseudo Seed Quality Enhancement for Unsupervised Multimodal Entity Alignment"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Information Retrieval (cs.IR)","lang":"en","subjectScheme":"arXiv"},{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-26T11:47:32Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:41:01Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-03-03T03:13:30Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-03-04T01:21:07Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[{"relationType":"IsVersionOf","relatedIdentifier":"10.1145/3770854.3780249","relatedIdentifierType":"DOI"}],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Multimodal Entity Alignment (MMEA) aims to identify equivalent entities across different data modalities, enabling structural data integration that in turn improves the performance of various large language model applications. To lift the requirement of labeled seed pairs that are difficult to obtain, recent methods shifted to an unsupervised paradigm using pseudo-alignment seeds. However, unsupervised entity alignment in multimodal settings remains underexplored, mainly because the incorporation of multimodal information often results in imbalanced coverage of pseudo-seeds within the knowledge graph. To overcome this, we propose PSQE (Pseudo-Seed Quality Enhancement) to improve the precision and graph coverage balance of pseudo seeds via multimodal information and clustering-resampling. Theoretical analysis reveals the impact of pseudo seeds on existing contrastive learning-based MMEA models. In particular, pseudo seeds can influence the attraction and the repulsion terms in contrastive learning at once, whereas imbalanced graph coverage causes models to prioritize high-density regions, thereby weakening their learning capability for entities in sparse regions. Experimental results validate our theoretical findings and show that PSQE as a plug-and-play module can improve the performance of baselines by considerable margins."},{"descriptionType":"Other","description":"2026 SIGKDD Accept"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.22903","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":1,"created":"2026-02-27T02:57:33Z","registered":"2026-02-27T02:57:34Z","published":null,"updated":"2026-03-04T03:23:45Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.23239","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.23239","identifiers":[{"identifier":"2602.23239","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Radha","familyName":"Sarma","name":"Sarma, Radha","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Agency and Architectural Limits: Why Optimization-Based Systems Cannot Be Norm-Responsive"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"Computers and Society (cs.CY)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-26T17:16:17Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:58:33Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-03-01T18:44:49Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-03-03T02:21:58Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"AI systems are increasingly deployed in high-stakes contexts (medical diagnosis, legal research, financial analysis) under the assumption they can be governed by norms. This paper demonstrates that the assumption is formally invalid for optimization-based systems, specifically Large Language Models trained via Reinforcement Learning from Human Feedback (RLHF). Genuine agency requires two necessary and jointly sufficient architectural conditions. First, the capacity to maintain certain boundaries as non-negotiable constraints rather than tradeable weights (Incommensurability). Second, a non-inferential mechanism capable of suspending processing when those boundaries are threatened (Apophatic Responsiveness). RLHF-based systems are constitutively incompatible with both conditions. The operations that make optimization powerful, unifying all values on a scalar metric and always selecting the highest-scoring output, are precisely the operations that preclude normative governance and agency. This incompatibility is not a correctable training bug awaiting a technical fix. It is a formal constraint inherent to what optimization is. Consequently, documented failure modes (sycophancy, hallucination, and unfaithful reasoning) are not accidents but expected structural manifestations. Misaligned deployment triggers a second-order risk termed the Convergence Crisis. When humans are forced to verify AI outputs under metric pressure, they degrade from genuine agents into criteria-checking optimizers, eliminating the only component capable of bearing normative accountability. Beyond the incompatibility proof, this paper's primary positive contribution is a substrate-neutral architectural specification deriving what any system (biological, artificial, or institutional) must necessarily satisfy to qualify as a genuine agent rather than a sophisticated instrument."},{"descriptionType":"Other","description":"About 10,600 words in all (includes ~1000 words of literature and ~2400 words of Appendices). Under journal review"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.23239","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T03:05:57Z","registered":"2026-02-27T03:05:58Z","published":null,"updated":"2026-03-03T05:56:02Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.22658","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.22658","identifiers":[{"identifier":"2602.22658","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Hoan My","familyName":"Tran","name":"Tran, Hoan My","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xin","familyName":"Wang","name":"Wang, Xin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Wanying","familyName":"Ge","name":"Ge, Wanying","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xuechen","familyName":"Liu","name":"Liu, Xuechen","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Junichi","familyName":"Yamagishi","name":"Yamagishi, Junichi","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Deepfake Word Detection by Next-token Prediction using Fine-tuned Whisper"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Audio and Speech Processing (eess.AS)","lang":"en","subjectScheme":"arXiv"},{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Electrical engineering, electronic engineering, information engineering","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Electrical engineering, electronic engineering, information engineering","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-26T06:17:56Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:26:57Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02-28T00:29:53Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-03-03T01:18:30Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by-nc-sa/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution Non Commercial Share Alike 4.0 International","rightsIdentifier":"cc-by-nc-sa-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Deepfake speech utterances can be forged by replacing one or more words in a bona fide utterance with semantically different words synthesized with speech-generative models. While a dedicated synthetic word detector could be developed, we developed a cost-effective method that fine-tunes a pre-trained Whisper model to detect synthetic words while transcribing the input utterance via next-token prediction. We further investigate using partially vocoded utterances as the fine-tuning data, thus reducing the cost of data collection. Our experiments demonstrate that, on in-domain test data, the fine-tuned Whisper yields low synthetic-word detection error rates and transcription error rates. On out-of-domain test data with synthetic words produced with unseen speech-generative models, the fine-tuned Whisper remains on par with a dedicated ResNet-based detection model; however, the overall performance degradation calls for strategies to improve its generalization capability."},{"descriptionType":"Other","description":"Submitted to Interspeech. To quote: Interspeech no longer enforces an anonymity period for submissions. While uploading a version online is permitted, your official submission to Interspeech must not contain any author-identifying information. ... a note indicating that the paper was submitted for review to (or, eventually, accepted at) Interspeech should be included in the posting"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.22658","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T02:51:33Z","registered":"2026-02-27T02:51:34Z","published":null,"updated":"2026-03-03T05:55:49Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.22630","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.22630","identifiers":[{"identifier":"2602.22630","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Yahia Salaheldin","familyName":"Shaaban","name":"Shaaban, Yahia Salaheldin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Salem","familyName":"Lahlou","name":"Lahlou, Salem","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Abdelrahman Sayed","familyName":"Sayed","name":"Sayed, Abdelrahman Sayed","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"HyperKKL: Enabling Non-Autonomous State Estimation through Dynamic Weight Conditioning"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Systems and Control (eess.SY)","lang":"en","subjectScheme":"arXiv"},{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Electrical engineering, electronic engineering, information engineering","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Electrical engineering, electronic engineering, information engineering","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-26T05:08:02Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:24:52Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-03-01T21:07:12Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-03-03T02:25:12Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by-nc-sa/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution Non Commercial Share Alike 4.0 International","rightsIdentifier":"cc-by-nc-sa-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"This paper proposes HyperKKL, a novel learning approach for designing Kazantzis-Kravaris/Luenberger (KKL) observers for non-autonomous nonlinear systems. While KKL observers offer a rigorous theoretical framework by immersing nonlinear dynamics into a stable linear latent space, its practical realization relies on solving Partial Differential Equations (PDE) that are analytically intractable. Current existing learning-based approximations of the KKL observer are mostly designed for autonomous systems, failing to generalize to driven dynamics without expensive retraining or online gradient updates. HyperKKL addresses this by employing a hypernetwork architecture that encodes the exogenous input signal to instantaneously generate the parameters of the KKL observer, effectively learning a family of immersion maps parameterized by the external drive. We rigorously evaluate this approach against a curriculum learning strategy that attempts to generalize from autonomous regimes via training heuristics alone. The novel approach is illustrated on four numerical simulations in benchmark examples including the Duffing, Van der Pol, Lorenz, and Rössler systems."},{"descriptionType":"Other","description":"18 pages, 6 figures, Accepted in ICLR 2026 AI \u0026amp; PDE Workshop"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.22630","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T02:50:53Z","registered":"2026-02-27T02:50:54Z","published":null,"updated":"2026-03-03T05:55:47Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.22603","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.22603","identifiers":[{"identifier":"2602.22603","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Sanjay","familyName":"Kariyappa","name":"Kariyappa, Sanjay","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"G. Edward","familyName":"Suh","name":"Suh, G. Edward","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"SideQuest: Model-Driven KV Cache Management for Long-Horizon Agentic Reasoning"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-26T04:20:44Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:23:03Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02-27T19:10:42Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-03-03T01:06:31Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Long-running agentic tasks, such as deep research, require multi-hop reasoning over information distributed across multiple webpages and documents. In such tasks, the LLM context is dominated by tokens from external retrieval, causing memory usage to grow rapidly and limiting decode performance. While several KV cache compression techniques exist for long-context inputs, we find that existing heuristics fail to support multi-step reasoning models effectively. We address this challenge with SideQuest -- a novel approach that leverages the Large Reasoning Model (LRM) itself to perform KV cache compression by reasoning about the usefulness of tokens in its context. To prevent the tokens associated with this management process from polluting the model's memory, we frame KV cache compression as an auxiliary task executed in parallel to the main reasoning task. Our evaluations, using a model trained with just 215 samples, show that SideQuest reduces peak token usage by up to 65% on agentic tasks with minimal degradation in accuracy, outperforming heuristic-based KV cache compression techniques."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.22603","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T02:50:15Z","registered":"2026-02-27T02:50:15Z","published":null,"updated":"2026-03-03T05:55:45Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.22593","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.22593","identifiers":[{"identifier":"2602.22593","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Shouwei","familyName":"Gao","name":"Gao, Shouwei","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Junqi","familyName":"Yin","name":"Yin, Junqi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Feiyi","familyName":"Wang","name":"Wang, Feiyi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Wenqian","familyName":"Dong","name":"Dong, Wenqian","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"FLYING SERVING: On-the-Fly Parallelism Switching for Large Language Model Serving"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Distributed, Parallel, and Cluster Computing (cs.DC)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-26T03:55:51Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:22:08Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-03-02T17:26:15Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-03-03T03:25:47Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Production LLM serving must simultaneously deliver high throughput, low latency, and sufficient context capacity under non-stationary traffic and mixed request requirements. Data parallelism (DP) maximizes throughput by running independent replicas, while tensor parallelism (TP) reduces per-request latency and pools memory for long-context inference. However, existing serving stacks typically commit to a static parallelism configuration at deployment; adapting to bursts, priorities, or long-context requests is often disruptive and slow. We present Flying Serving, a vLLM-based system that enables online DP-TP switching without restarting engine workers. Flying Serving makes reconfiguration practical by virtualizing the state that would otherwise force data movement: (i) a zero-copy Model Weights Manager that exposes TP shard views on demand, (ii) a KV Cache Adaptor that preserves request KV state across DP/TP layouts, (iii) an eagerly initialized Communicator Pool to amortize collective setup, and (iv) a deadlock-free scheduler that coordinates safe transitions under execution skew. Across three popular LLMs and realistic serving scenarios, Flying Serving improves performance by up to $4.79\\times$ under high load and $3.47\\times$ under low load while supporting latency- and memory-driven requests."},{"descriptionType":"Other","description":"This paper is accepted by the 40th ACM International Conference on Supercomputing (ICS 2026)"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.22593","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T02:50:00Z","registered":"2026-02-27T02:50:01Z","published":null,"updated":"2026-03-03T05:55:44Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.22530","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.22530","identifiers":[{"identifier":"2602.22530","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Michael Stephen","familyName":"Fiske","name":"Fiske, Michael Stephen","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Dynamic Level Sets"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Computational Complexity (cs.CC)","lang":"en","subjectScheme":"arXiv"},{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"Mathematical Physics (math-ph)","lang":"en","subjectScheme":"arXiv"},{"subject":"Dynamical Systems (math.DS)","lang":"en","subjectScheme":"arXiv"},{"subject":"History and Overview (math.HO)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"F.2.2; F.1.1","lang":"en","subjectScheme":"ACM"},{"subject":"68Q09, 68Q10, 37N99, 37H12","lang":"en","subjectScheme":"MSC"}],"contributors":[],"dates":[{"date":"2026-02-26T02:09:43Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:16:16Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02-28T20:01:11Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-03-03T01:51:31Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"A mathematical concept is identified and analyzed that is implicit in the 2012 paper Turing Incomputable Computation, presented at the Alan Turing Centenary Conference (Turing-100, Manchester). The concept, called dynamic level sets, is distinct from mathematical concepts in the standard literature on dynamical systems, topology, and computability theory. A new mathematical object is explained and why it may have escaped prior characterizations, including the classical result of de Leeuw, Moore, Shannon, and Shapiro that probabilistic Turing machines (with bias $p$ where $p$ is Turing computable) compute no more than deterministic ones. A key mechanism underlying the concept is the Principle of Self-Modifiability, whereby the physical realization of an invariant logical level set is reconfigured at each computational step by an incomputable physical process."},{"descriptionType":"Other","description":"7 pages"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.22530","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T02:48:31Z","registered":"2026-02-27T02:48:31Z","published":null,"updated":"2026-03-03T05:55:43Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.22286","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.22286","identifiers":[{"identifier":"2602.22286","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Yan","familyName":"Zhao","name":"Zhao, Yan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zhengxue","familyName":"Cheng","name":"Cheng, Zhengxue","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Junxuan","familyName":"Zhang","name":"Zhang, Junxuan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Dajiang","familyName":"Zhou","name":"Zhou, Dajiang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Qunshan","familyName":"Gu","name":"Gu, Qunshan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Qi","familyName":"Wang","name":"Wang, Qi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Li","familyName":"Song","name":"Song, Li","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"OmniZip: Learning a Unified and Lightweight Lossless Compressor for Multi-Modal Data"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"Information Theory (cs.IT)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-25T13:51:08Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:01:54Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-03-02T12:21:30Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-03-03T03:03:39Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Lossless compression is essential for efficient data storage and transmission. Although learning-based lossless compressors achieve strong results, most of them are designed for a single modality, leading to redundant compressor deployments in multi-modal settings. Designing a unified multi-modal compressor is critical yet challenging, as different data types vary largely in format, dimension, and statistics. Multi-modal large language models offer a promising resolution but remain too complex for practical use. Thus, we propose \\textbf{OmniZip}, \\textbf{a unified and lightweight lossless compressor for multi-modal data (like image, text, speech, tactile, database, and gene sequence)}. Built on a lightweight backbone, OmniZip incorporates three key components to enable efficient multi-modal lossless compression: a modality-unified tokenizer that reversibly transforms diverse data into tokens, a modality-routing context learning mechanism that enables flexible multi-modal context modeling, and a modality-routing feedforward design that further enhances the model's nonlinear representation flexibility. A reparameterization training strategy is used to enhance model capacity. OmniZip outperforms or matches other state-of-the-art compressors on multiple modalities, achieving 42\\%, 57\\%, 62\\% and 42\\%, 53\\% higher compression efficiency than gzip on CLIC-M, TouchandGo, enwik9, LibriSpeech, and WikiSQL datasets, respectively. It also supports near real-time inference on resource-constrained edge devices, reaching about 1MB/s on MacBook CPUs and iPhone NPUs. Our code is released at https://github.com/adminasmi/OmniZip-CVPR2026."},{"descriptionType":"Other","description":"8 figures, 10 tables"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.22286","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T02:42:52Z","registered":"2026-02-27T02:42:53Z","published":null,"updated":"2026-03-03T05:55:39Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.23320","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.23320","identifiers":[{"identifier":"2602.23320","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Tianjun","familyName":"Yao","name":"Yao, Tianjun","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yongqiang","familyName":"Chen","name":"Chen, Yongqiang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yujia","familyName":"Zheng","name":"Zheng, Yujia","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Pan","familyName":"Li","name":"Li, Pan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zhiqiang","familyName":"Shen","name":"Shen, Zhiqiang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Kun","familyName":"Zhang","name":"Zhang, Kun","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"ParamMem: Augmenting Language Agents with Parametric Reflective Memory"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"Multiagent Systems (cs.MA)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"I.2.6","lang":"en","subjectScheme":"ACM"}],"contributors":[],"dates":[{"date":"2026-02-26T18:28:04Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T02:02:28Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02-27T08:21:31Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-03-02T01:32:08Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Self-reflection enables language agents to iteratively refine solutions, yet often produces repetitive outputs that limit reasoning performance. Recent studies have attempted to address this limitation through various approaches, among which increasing reflective diversity has shown promise. Our empirical analysis reveals a strong positive correlation between reflective diversity and task success, further motivating the need for diverse reflection signals. We introduce ParamMem, a parametric memory module that encodes cross-sample reflection patterns into model parameters, enabling diverse reflection generation through temperature-controlled sampling. Building on this module, we propose ParamAgent, a reflection-based agent framework that integrates parametric memory with episodic and cross-sample memory. Extensive experiments on code generation, mathematical reasoning, and multi-hop question answering demonstrate consistent improvements over state-of-the-art baselines. Further analysis reveals that ParamMem is sample-efficient, enables weak-to-strong transfer across model scales, and supports self-improvement without reliance on stronger external model, highlighting the potential of ParamMem as an effective component for enhancing language agents."},{"descriptionType":"Other","description":"20 pages"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.23320","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T03:07:57Z","registered":"2026-02-27T03:07:58Z","published":null,"updated":"2026-03-02T03:12:38Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.23225","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.23225","identifiers":[{"identifier":"2602.23225","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Pengxiang","familyName":"Li","name":"Li, Pengxiang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Dilxat","familyName":"Muhtar","name":"Muhtar, Dilxat","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Tianlong","familyName":"Chen","name":"Chen, Tianlong","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Lu","familyName":"Yin","name":"Yin, Lu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Shiwei","familyName":"Liu","name":"Liu, Shiwei","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Why Diffusion Language Models Struggle with Truly Parallel (Non-Autoregressive) Decoding?"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-26T17:04:57Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:57:57Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02-27T02:41:06Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-03-02T01:15:17Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Diffusion Language Models (DLMs) are often advertised as enabling parallel token generation, yet practical fast DLMs frequently converge to left-to-right, autoregressive (AR)-like decoding dynamics. In contrast, genuinely non-AR generation is promising because it removes AR's sequential bottleneck, better exploiting parallel hardware to reduce synchronization/communication overhead and improve latency scaling with output length. We argue that a primary driver of AR-like decoding is a mismatch between DLM objectives and the highly sequential structure of widely used training data, including standard pretraining corpora and long chain-of-thought (CoT) supervision. Motivated by this diagnosis, we propose NAP (Non-Autoregressive Parallel DLMs), a proof-of-concept, data-centric approach that better aligns supervision with non-AR parallel decoding. NAP curates examples as multiple independent reasoning trajectories and couples them with a parallel-forced decoding strategy that encourages multi-token parallel updates. Across math reasoning benchmarks, NAP yields stronger performance under parallel decoding than DLMs trained on standard long CoT data, with gains growing as parallelism increases. Our results suggest that revisiting data and supervision is a principled direction for mitigating AR-like behavior and moving toward genuinely non-autoregressive parallel generation in DLMs. Our code is available at https://github.com/pixeli99/NAP."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.23225","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T03:05:36Z","registered":"2026-02-27T03:05:36Z","published":null,"updated":"2026-03-02T03:12:34Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.23114","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.23114","identifiers":[{"identifier":"2602.23114","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Xudong","familyName":"Yan","name":"Yan, Xudong","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Songhe","familyName":"Feng","name":"Feng, Songhe","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jiaxin","familyName":"Wang","name":"Wang, Jiaxin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xin","familyName":"Su","name":"Su, Xin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yi","familyName":"Jin","name":"Jin, Yi","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"WARM-CAT: Warm-Started Test-Time Comprehensive Knowledge Accumulation for Compositional Zero-Shot Learning"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-26T15:27:17Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:52:55Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02-27T07:09:26Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-03-02T01:28:58Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Compositional Zero-Shot Learning (CZSL) aims to recognize novel attribute-object compositions based on the knowledge learned from seen ones. Existing methods suffer from performance degradation caused by the distribution shift of label space at test time, which stems from the inclusion of unseen compositions recombined from attributes and objects. To overcome the challenge, we propose a novel approach that accumulates comprehensive knowledge in both textual and visual modalities from unsupervised data to update multimodal prototypes at test time. Building on this, we further design an adaptive update weight to control the degree of prototype adjustment, enabling the model to flexibly adapt to distribution shift during testing. Moreover, a dynamic priority queue is introduced that stores high-confidence images to acquire visual prototypes from historical images for inference. Since the model tends to favor compositions already stored in the queue during testing, we warm-start the queue by initializing it with training images for visual prototypes of seen compositions and generating unseen visual prototypes using the mapping learned between seen and unseen textual prototypes. Considering the semantic consistency of multimodal knowledge, we align textual and visual prototypes by multimodal collaborative representation learning. To provide a more reliable evaluation for CZSL, we introduce a new benchmark dataset, C-Fashion, and refine the widely used but noisy MIT-States dataset. Extensive experiments indicate that our approach achieves state-of-the-art performance on four benchmark datasets under both closed-world and open-world settings. The source code and datasets are available at https://github.com/xud-yan/WARM-CAT ."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.23114","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T03:02:44Z","registered":"2026-02-27T03:02:45Z","published":null,"updated":"2026-03-02T03:12:30Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.23109","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.23109","identifiers":[{"identifier":"2602.23109","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Kai","familyName":"Chen","name":"Chen, Kai","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yuyao","familyName":"Huang","name":"Huang, Yuyao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Guang","familyName":"Chen","name":"Chen, Guang","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Towards Intelligible Human-Robot Interaction: An Active Inference Approach to Occluded Pedestrian Scenarios"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Robotics (cs.RO)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-26T15:22:07Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:52:37Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02-27T02:36:06Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-03-02T01:15:04Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"The sudden appearance of occluded pedestrians presents a critical safety challenge in autonomous driving. Conventional rule-based or purely data-driven approaches struggle with the inherent high uncertainty of these long-tail scenarios. To tackle this challenge, we propose a novel framework grounded in Active Inference, which endows the agent with a human-like, belief-driven mechanism. Our framework leverages a Rao-Blackwellized Particle Filter (RBPF) to efficiently estimate the pedestrian's hybrid state. To emulate human-like cognitive processes under uncertainty, we introduce a Conditional Belief Reset mechanism and a Hypothesis Injection technique to explicitly model beliefs about the pedestrian's multiple latent intentions. Planning is achieved via a Cross-Entropy Method (CEM) enhanced Model Predictive Path Integral (MPPI) controller, which synergizes the efficient, iterative search of CEM with the inherent robustness of MPPI. Simulation experiments demonstrate that our approach significantly reduces the collision rate compared to reactive, rule-based, and reinforcement learning (RL) baselines, while also exhibiting explainable and human-like driving behavior that reflects the agent's internal belief state."},{"descriptionType":"Other","description":"14 pages, 6 figures, Proceedings of the 2026 ACM/IEEE International Conference on Human-Robot Interaction (HRI'26)"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.23109","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T03:02:37Z","registered":"2026-02-27T03:02:38Z","published":null,"updated":"2026-03-02T03:12:29Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.23065","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.23065","identifiers":[{"identifier":"2602.23065","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Kunpeng","familyName":"Zhang","name":"Zhang, Kunpeng","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Dongwei","familyName":"Xiao","name":"Xiao, Dongwei","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Daoyuan","familyName":"Wu","name":"Wu, Daoyuan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Shuai","familyName":"Wang","name":"Wang, Shuai","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jiali","familyName":"Zhao","name":"Zhao, Jiali","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yuanyi","familyName":"Lin","name":"Lin, Yuanyi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Tongtong","familyName":"Xu","name":"Xu, Tongtong","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Shaohua","familyName":"Wang","name":"Wang, Shaohua","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"LLM-Powered Silent Bug Fuzzing in Deep Learning Libraries via Versatile and Controlled Bug Transfer"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Software Engineering (cs.SE)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-26T14:53:26Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:50:10Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02-27T16:15:41Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-03-02T01:54:16Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[{"relationType":"IsVersionOf","relatedIdentifier":"10.1145/3798258","relatedIdentifierType":"DOI"}],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Deep learning (DL) libraries are widely used in critical applications, where even subtle silent bugs can lead to serious consequences. While existing DL fuzzing techniques have made progress in detecting crashes, they inherently struggle to detect silent bugs due to the lack of effective test programs and corresponding oracles.\n Building on the observation that historical bug reports contain rich, underutilized information about silent bugs, we leverage large language models (LLMs) to perform versatile yet controlled bug transfer for silent bug fuzzing. Specifically, our approach uses LLMs to extract context-aware bug patterns from historical issues, match semantically related Application Programming Interfaces (APIs) using functionality-based embeddings, and synthesize test cases with customized oracles. This enables proactive detection of silent bugs by transferring high-risk contexts and oracle designs from known buggy APIs to functionally similar target APIs. To ensure the reliability of our context-aware bug transfer, we introduce an LLM-powered self-validation module that systematically evaluates the validity of each transferred bug instance. We implement this methodology in a tool named TransFuzz and evaluate it on three mainstream DL libraries: PyTorch, TensorFlow, and MindSpore. TransFuzz successfully discovers 79 previously unknown bugs (12 confirmed as Common Vulnerabilities and Exposures (CVEs)) in 10 bug types, demonstrating its effectiveness and generalizability in migrating DL library bug discovery capabilities."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.23065","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":1,"created":"2026-02-27T03:01:36Z","registered":"2026-02-27T03:01:37Z","published":null,"updated":"2026-03-02T03:12:28Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.22695","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.22695","identifiers":[{"identifier":"2602.22695","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Yu","familyName":"Chen","name":"Chen, Yu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zewei","familyName":"He","name":"He, Zewei","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xingyu","familyName":"Liu","name":"Liu, Xingyu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zixuan","familyName":"Chen","name":"Chen, Zixuan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zheming","familyName":"Lu","name":"Lu, Zheming","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"GFRRN: Explore the Gaps in Single Image Reflection Removal"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-26T07:17:49Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:29:54Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02-27T15:03:14Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-03-02T01:50:11Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Prior dual-stream methods with the feature interaction mechanism have achieved remarkable performance in single image reflection removal (SIRR). However, they often struggle with (1) semantic understanding gap between the features of pre-trained models and those of reflection removal models, and (2) reflection label inconsistencies between synthetic and real-world training data. In this work, we first adopt the parameter efficient fine-tuning (PEFT) strategy by integrating several learnable Mona layers into the pre-trained model to align the training directions. Then, a label generator is designed to unify the reflection labels for both synthetic and real-world data. In addition, a Gaussian-based Adaptive Frequency Learning Block (G-AFLB) is proposed to adaptively learn and fuse the frequency priors, and a Dynamic Agent Attention (DAA) is employed as an alternative to window-based attention by dynamically modeling the significance levels across windows (inter-) and within an individual window (intra-). These components constitute our proposed Gap-Free Reflection Removal Network (GFRRN). Extensive experiments demonstrate the effectiveness of our GFRRN, achieving superior performance against state-of-the-art SIRR methods."},{"descriptionType":"Other","description":"CVPR26"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.22695","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T02:52:26Z","registered":"2026-02-27T02:52:27Z","published":null,"updated":"2026-03-02T03:12:18Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.22675","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.22675","identifiers":[{"identifier":"2602.22675","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Qianben","familyName":"Chen","name":"Chen, Qianben","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Tianrui","familyName":"Qin","name":"Qin, Tianrui","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"King","familyName":"Zhu","name":"Zhu, King","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Qiexiang","familyName":"Wang","name":"Wang, Qiexiang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Chengjun","familyName":"Yu","name":"Yu, Chengjun","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Shu","familyName":"Xu","name":"Xu, Shu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jiaqi","familyName":"Wu","name":"Wu, Jiaqi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jiayu","familyName":"Zhang","name":"Zhang, Jiayu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xinpeng","familyName":"Liu","name":"Liu, Xinpeng","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xin","familyName":"Gui","name":"Gui, Xin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jingyi","familyName":"Cao","name":"Cao, Jingyi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Piaohong","familyName":"Wang","name":"Wang, Piaohong","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Dingfeng","familyName":"Shi","name":"Shi, Dingfeng","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"He","familyName":"Zhu","name":"Zhu, He","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Tiannan","familyName":"Wang","name":"Wang, Tiannan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yuqing","familyName":"Wang","name":"Wang, Yuqing","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Maojia","familyName":"Song","name":"Song, Maojia","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Tianyu","familyName":"Zheng","name":"Zheng, Tianyu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ge","familyName":"Zhang","name":"Zhang, Ge","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jian","familyName":"Yang","name":"Yang, Jian","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jiaheng","familyName":"Liu","name":"Liu, Jiaheng","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Minghao","familyName":"Liu","name":"Liu, Minghao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yuchen Eleanor","familyName":"Jiang","name":"Jiang, Yuchen Eleanor","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Wangchunshu","familyName":"Zhou","name":"Zhou, Wangchunshu","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Search More, Think Less: Rethinking Long-Horizon Agentic Search for Efficiency and Generalization"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-26T06:46:41Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:28:38Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02-27T07:08:13Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-03-02T01:28:53Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Recent deep research agents primarily improve performance by scaling reasoning depth, but this leads to high inference cost and latency in search-intensive scenarios. Moreover, generalization across heterogeneous research settings remains challenging. In this work, we propose \\emph{Search More, Think Less} (SMTL), a framework for long-horizon agentic search that targets both efficiency and generalization. SMTL replaces sequential reasoning with parallel evidence acquisition, enabling efficient context management under constrained context budgets. To support generalization across task types, we further introduce a unified data synthesis pipeline that constructs search tasks spanning both deterministic question answering and open-ended research scenarios with task appropriate evaluation metrics. We train an end-to-end agent using supervised fine-tuning and reinforcement learning, achieving strong and often state of the art performance across benchmarks including BrowseComp (48.6\\%), GAIA (75.7\\%), Xbench (82.0\\%), and DeepResearch Bench (45.9\\%). Compared to Mirothinker-v1.0, SMTL with maximum 100 interaction steps reduces the average number of reasoning steps on BrowseComp by 70.7\\%, while improving accuracy."},{"descriptionType":"Other","description":"12 pages, 5 figures"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.22675","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T02:51:58Z","registered":"2026-02-27T02:51:58Z","published":null,"updated":"2026-03-02T03:12:15Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.22595","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.22595","identifiers":[{"identifier":"2602.22595","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Taozhe","familyName":"Li","name":"Li, Taozhe","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Guansu","familyName":"Wang","name":"Wang, Guansu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Bo","familyName":"Yu","name":"Yu, Bo","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yiming","familyName":"Liu","name":"Liu, Yiming","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Wei","familyName":"Sun","name":"Sun, Wei","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Don't let the information slip away"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"14J60","lang":"en","subjectScheme":"MSC"}],"contributors":[],"dates":[{"date":"2026-02-26T03:58:41Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:22:15Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02-27T16:50:03Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-03-02T01:56:38Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Real-time object detection has advanced rapidly in recent years. The YOLO series of detectors is among the most well-known CNN-based object detection models and cannot be overlooked. The latest version, YOLOv26, was recently released, while YOLOv12 achieved state-of-the-art (SOTA) performance with 55.2 mAP on the COCO val2017 dataset. Meanwhile, transformer-based object detection models, also known as DEtection TRansformer (DETR), have demonstrated impressive performance. RT-DETR is an outstanding model that outperformed the YOLO series in both speed and accuracy when it was released. Its successor, RT-DETRv2, achieved 53.4 mAP on the COCO val2017 dataset. However, despite their remarkable performance, all these models let information to slip away. They primarily focus on the features of foreground objects while neglecting the contextual information provided by the background. We believe that background information can significantly aid object detection tasks. For example, cars are more likely to appear on roads rather than in offices, while wild animals are more likely to be found in forests or remote areas rather than on busy streets. To address this gap, we propose an object detection model called Association DETR, which achieves state-of-the-art results compared to other object detection models on the COCO val2017 dataset."},{"descriptionType":"Other","description":"10"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.22595","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T02:50:03Z","registered":"2026-02-27T02:50:04Z","published":null,"updated":"2026-03-02T03:12:14Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.22465","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.22465","identifiers":[{"identifier":"2602.22465","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Joseph","familyName":"Tso","name":"Tso, Joseph","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Preston","familyName":"Schmittou","name":"Schmittou, Preston","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Quan","familyName":"Huynh","name":"Huynh, Quan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jibran","familyName":"Hutchins","name":"Hutchins, Jibran","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"ConstraintBench: Benchmarking LLM Constraint Reasoning on Direct Optimization"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-25T22:54:26Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:10:56Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02-27T16:43:01Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-03-02T01:56:02Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Large language models are increasingly applied to operational decision-making where the underlying structure is constrained optimization. Existing benchmarks evaluate whether LLMs can formulate optimization problems as solver code, but leave open a complementary question. Can LLMs directly produce correct solutions to fully specified constrained optimization problems without access to a solver? We introduce ConstraintBench, a benchmark for evaluating LLMs on direct constrained optimization across 10 operations research domains, with all ground-truth solutions verified by the Gurobi solver. Each task presents a natural-language scenario with entities, constraints, and an optimization objective; the model must return a structured solution that a deterministic verifier checks against every constraint and the solver-proven optimum. We evaluate six frontier models on 200 tasks and find that feasibility, not optimality, is the primary bottleneck. The best model achieves only 65.0% feasibility, yet feasible solutions average 89 to 96% of the Gurobi-optimal objective. No model exceeds 30.5% on joint feasibility and optimality within 0.1% of the solver reference. Per-domain analysis shows large variation in difficulty, with average feasibility spanning from 85.0% in the facility location domain to 0.8% in the crew assignment domain. Further, systematic failure modes include duration constraint misunderstanding, entity hallucination, and a feasibility-optimality decoupling in facility location and vehicle routing where models achieve high feasibility but 0% optimality. ConstraintBench and all evaluation infrastructure will be publicly released."},{"descriptionType":"Other","description":"Preprint. 10 pages, 1 figure, 6 tables. Benchmark and evaluation code will be publicly released"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.22465","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T02:46:59Z","registered":"2026-02-27T02:47:00Z","published":null,"updated":"2026-03-02T03:12:12Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.22294","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.22294","identifiers":[{"identifier":"2602.22294","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Timothy","familyName":"Oladunni","name":"Oladunni, Timothy","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Blessing","familyName":"Ojeme","name":"Ojeme, Blessing","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Kyndal","familyName":"Maclin","name":"Maclin, Kyndal","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Clyde","familyName":"Baidoo","name":"Baidoo, Clyde","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"When Should a Model Change Its Mind? An Energy-Based Theory and Regularizer for Concept Drift in Electrocardiogram (ECG) Signals"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-25T15:23:15Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:02:05Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02-27T13:26:28Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-03-02T01:44:34Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by-nc-nd/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution Non Commercial No Derivatives 4.0 International","rightsIdentifier":"cc-by-nc-nd-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Models operating on dynamic physiologic signals must distinguish benign, label-preserving variability from true concept change. Existing concept-drift frameworks are largely distributional and provide no principled guidance on how much a model's internal representation may move when the underlying signal undergoes physiologically plausible fluctuations in energy. As a result, deep models often misinterpret harmless changes in amplitude, rate, or morphology as concept drift, yielding unstable predictions, particularly in multimodal fusion settings.\n This study introduces Physiologic Energy Conservation Theory (PECT), an energy-based framework for concept stability in dynamic signals. PECT posits that under virtual drift, normalized latent displacement should scale proportionally with normalized signal energy change, while persistent violations of this proportionality indicate real concept drift. We operationalize this principle through Energy-Constrained Representation Learning (ECRL), a lightweight regularizer that penalizes energy-inconsistent latent movement without modifying encoder architectures or adding inference-time cost.\n Although PECT is formulated for dynamic signals in general, we instantiate and evaluate it on multimodal ECG across seven unimodal and hybrid models. Experiments show that in the strongest trimodal hybrid (1D+2D+Transformer), clean accuracy is largely preserved (96.0% to 94.1%), while perturbed accuracy improves substantially (72.6% to 85.5%) and fused representation drift decreases by over 45%. Similar trends are observed across all architectures, providing empirical evidence that PECT functions as an energy-drift law governing concept stability in continuous physiologic signals."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.22294","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T02:43:03Z","registered":"2026-02-27T02:43:04Z","published":null,"updated":"2026-03-02T03:12:05Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.23363","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.23363","identifiers":[{"identifier":"2602.23363","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Sahal Shaji","familyName":"Mullappilly","name":"Mullappilly, Sahal Shaji","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Mohammed Irfan","familyName":"Kurpath","name":"Kurpath, Mohammed Irfan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Omair","familyName":"Mohamed","name":"Mohamed, Omair","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Mohamed","familyName":"Zidan","name":"Zidan, Mohamed","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Fahad","familyName":"Khan","name":"Khan, Fahad","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Salman","familyName":"Khan","name":"Khan, Salman","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Rao","familyName":"Anwer","name":"Anwer, Rao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Hisham","familyName":"Cholakkal","name":"Cholakkal, Hisham","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"MediX-R1: Open Ended Medical Reinforcement Learning"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-26T18:59:46Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T02:03:59Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by-nc-sa/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution Non Commercial Share Alike 4.0 International","rightsIdentifier":"cc-by-nc-sa-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"We introduce MediX-R1, an open-ended Reinforcement Learning (RL) framework for medical multimodal large language models (MLLMs) that enables clinically grounded, free-form answers beyond multiple-choice formats. MediX-R1 fine-tunes a baseline vision-language backbone with Group Based RL and a composite reward tailored for medical reasoning: an LLM-based accuracy reward that judges semantic correctness with a strict YES/NO decision, a medical embedding-based semantic reward to capture paraphrases and terminology variants, and lightweight format and modality rewards that enforce interpretable reasoning and modality recognition. This multi-signal design provides stable, informative feedback for open-ended outputs where traditional verifiable or MCQ-only rewards fall short. To measure progress, we propose a unified evaluation framework for both text-only and image+text tasks that uses a Reference-based LLM-as-judge in place of brittle string-overlap metrics, capturing semantic correctness, reasoning, and contextual alignment. Despite using only $\\sim51$K instruction examples, MediX-R1 achieves excellent results across standard medical LLM (text-only) and VLM (image + text) benchmarks, outperforming strong open-source baselines and delivering particularly large gains on open-ended clinical tasks. Our results demonstrate that open-ended RL with comprehensive reward signals and LLM-based evaluation is a practical path toward reliable medical reasoning in multimodal models. Our trained models, curated datasets and source code are available at https://medix.cvmbzuai.com"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.23363","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T03:09:00Z","registered":"2026-02-27T03:09:01Z","published":null,"updated":"2026-02-27T03:09:01Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.23361","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.23361","identifiers":[{"identifier":"2602.23361","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Sven","familyName":"Elflein","name":"Elflein, Sven","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ruilong","familyName":"Li","name":"Li, Ruilong","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Sérgio","familyName":"Agostinho","name":"Agostinho, Sérgio","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zan","familyName":"Gojcic","name":"Gojcic, Zan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Laura","familyName":"Leal-Taixé","name":"Leal-Taixé, Laura","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Qunjie","familyName":"Zhou","name":"Zhou, Qunjie","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Aljosa","familyName":"Osep","name":"Osep, Aljosa","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"VGG-T$^3$: Offline Feed-Forward 3D Reconstruction at Scale"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-26T18:59:33Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T02:03:50Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"We present a scalable 3D reconstruction model that addresses a critical limitation in offline feed-forward methods: their computational and memory requirements grow quadratically w.r.t. the number of input images. Our approach is built on the key insight that this bottleneck stems from the varying-length Key-Value (KV) space representation of scene geometry, which we distill into a fixed-size Multi-Layer Perceptron (MLP) via test-time training. VGG-T$^3$ (Visual Geometry Grounded Test Time Training) scales linearly w.r.t. the number of input views, similar to online models, and reconstructs a $1k$ image collection in just $54$ seconds, achieving a $11.6\\times$ speed-up over baselines that rely on softmax attention. Since our method retains global scene aggregation capability, our point map reconstruction error outperforming other linear-time methods by large margins. Finally, we demonstrate visual localization capabilities of our model by querying the scene representation with unseen images."},{"descriptionType":"Other","description":"CVPR 2026, Project page: https://research.nvidia.com/labs/dvl/projects/vgg-ttt"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.23361","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T03:08:57Z","registered":"2026-02-27T03:08:58Z","published":null,"updated":"2026-02-27T03:08:58Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.23360","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.23360","identifiers":[{"identifier":"2602.23360","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Eric","familyName":"Eaton","name":"Eaton, Eric","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Surbhi","familyName":"Goel","name":"Goel, Surbhi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Marcel","familyName":"Hussing","name":"Hussing, Marcel","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Michael","familyName":"Kearns","name":"Kearns, Michael","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Aaron","familyName":"Roth","name":"Roth, Aaron","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Sikata Bela","familyName":"Sengupta","name":"Sengupta, Sikata Bela","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jessica","familyName":"Sorrell","name":"Sorrell, Jessica","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Model Agreement via Anchoring"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-26T18:59:32Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T02:03:49Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Numerous lines of aim to control $\\textit{model disagreement}$ -- the extent to which two machine learning models disagree in their predictions. We adopt a simple and standard notion of model disagreement in real-valued prediction problems, namely the expected squared difference in predictions between two models trained on independent samples, without any coordination of the training processes. We would like to be able to drive disagreement to zero with some natural parameter(s) of the training procedure using analyses that can be applied to existing training methodologies.\n We develop a simple general technique for proving bounds on independent model disagreement based on $\\textit{anchoring}$ to the average of two models within the analysis. We then apply this technique to prove disagreement bounds for four commonly used machine learning algorithms: (1) stacked aggregation over an arbitrary model class (where disagreement is driven to 0 with the number of models $k$ being stacked) (2) gradient boosting (where disagreement is driven to 0 with the number of iterations $k$) (3) neural network training with architecture search (where disagreement is driven to 0 with the size $n$ of the architecture being optimized over) and (4) regression tree training over all regression trees of fixed depth (where disagreement is driven to 0 with the depth $d$ of the tree architecture). For clarity, we work out our initial bounds in the setting of one-dimensional regression with squared error loss -- but then show that all of our results generalize to multi-dimensional regression with any strongly convex loss."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.23360","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T03:08:56Z","registered":"2026-02-27T03:08:56Z","published":null,"updated":"2026-02-27T03:08:56Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.23358","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.23358","identifiers":[{"identifier":"2602.23358","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Elad Kimchi","familyName":"Shoshani","name":"Shoshani, Elad Kimchi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Leeyam","familyName":"Gabay","name":"Gabay, Leeyam","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yedid","familyName":"Hoshen","name":"Hoshen, Yedid","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"A Dataset is Worth 1 MB"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-26T18:59:03Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T02:03:44Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"A dataset server must often distribute the same large payload to many clients, incurring massive communication costs. Since clients frequently operate on diverse hardware and software frameworks, transmitting a pre-trained model is often infeasible; instead, agents require raw data to train their own task-specific models locally. While dataset distillation attempts to compress training signals, current methods struggle to scale to high-resolution data and rarely achieve sufficiently small files. In this paper, we propose Pseudo-Labels as Data (PLADA), a method that completely eliminates pixel transmission. We assume agents are preloaded with a large, generic, unlabeled reference dataset (e.g., ImageNet-1K, ImageNet-21K) and communicate a new task by transmitting only the class labels for specific images. To address the distribution mismatch between the reference and target datasets, we introduce a pruning mechanism that filters the reference dataset to retain only the labels of the most semantically relevant images for the target task. This selection process simultaneously maximizes training efficiency and minimizes transmission payload. Experiments on 10 diverse datasets demonstrate that our approach can transfer task knowledge with a payload of less than 1 MB while retaining high classification accuracy, offering a promising solution for efficient dataset serving."},{"descriptionType":"Other","description":"23 pages, 9 figures"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.23358","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T03:08:53Z","registered":"2026-02-27T03:08:54Z","published":null,"updated":"2026-02-27T03:08:54Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.23351","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.23351","identifiers":[{"identifier":"2602.23351","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Amita","familyName":"Kamath","name":"Kamath, Amita","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jack","familyName":"Hessel","name":"Hessel, Jack","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Khyathi","familyName":"Chandu","name":"Chandu, Khyathi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jena D.","familyName":"Hwang","name":"Hwang, Jena D.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Kai-Wei","familyName":"Chang","name":"Chang, Kai-Wei","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ranjay","familyName":"Krishna","name":"Krishna, Ranjay","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Scale Can't Overcome Pragmatics: The Impact of Reporting Bias on Vision-Language Reasoning"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-26T18:54:06Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T02:03:33Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"The lack of reasoning capabilities in Vision-Language Models (VLMs) has remained at the forefront of research discourse. We posit that this behavior stems from a reporting bias in their training data. That is, how people communicate about visual content by default omits tacit information needed to supervise some types of reasoning; e.g., \"at the game today!\" is a more likely caption than \"a photo of 37 people standing behind a field\". We investigate the data underlying the popular VLMs OpenCLIP, LLaVA-1.5 and Molmo through the lens of theories from pragmatics, and find that reporting bias results in insufficient representation of four reasoning skills (spatial, temporal, negation, and counting), despite the corpora being of web-scale, and/or synthetically generated. With a set of curated benchmarks, we demonstrate that: (i) VLMs perform poorly on the aforementioned types of reasoning suppressed in the training data by reporting bias; (ii) contrary to popular belief, scaling data size, model size, and to multiple languages does not result in emergence of these skills by default; but, promisingly, (iii) incorporating annotations specifically collected to obtain tacit information is effective. Our findings highlight the need for more intentional training data curation methods, rather than counting on scale for emergence of reasoning capabilities."},{"descriptionType":"Other","description":"TACL 2026"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.23351","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T03:08:43Z","registered":"2026-02-27T03:08:43Z","published":null,"updated":"2026-02-27T03:08:43Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.23339","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.23339","identifiers":[{"identifier":"2602.23339","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Tilemachos","familyName":"Aravanis","name":"Aravanis, Tilemachos","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Vladan","familyName":"Stojnić","name":"Stojnić, Vladan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Bill","familyName":"Psomas","name":"Psomas, Bill","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Nikos","familyName":"Komodakis","name":"Komodakis, Nikos","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Giorgos","familyName":"Tolias","name":"Tolias, Giorgos","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Retrieve and Segment: Are a Few Examples Enough to Bridge the Supervision Gap in Open-Vocabulary Segmentation?"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-26T18:45:33Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T02:03:16Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Open-vocabulary segmentation (OVS) extends the zero-shot recognition capabilities of vision-language models (VLMs) to pixel-level prediction, enabling segmentation of arbitrary categories specified by text prompts. Despite recent progress, OVS lags behind fully supervised approaches due to two challenges: the coarse image-level supervision used to train VLMs and the semantic ambiguity of natural language. We address these limitations by introducing a few-shot setting that augments textual prompts with a support set of pixel-annotated images. Building on this, we propose a retrieval-augmented test-time adapter that learns a lightweight, per-image classifier by fusing textual and visual support features. Unlike prior methods relying on late, hand-crafted fusion, our approach performs learned, per-query fusion, achieving stronger synergy between modalities. The method supports continually expanding support sets, and applies to fine-grained tasks such as personalized segmentation. Experiments show that we significantly narrow the gap between zero-shot and supervised segmentation while preserving open-vocabulary ability."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.23339","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T03:08:25Z","registered":"2026-02-27T03:08:26Z","published":null,"updated":"2026-02-27T03:08:26Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.23336","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.23336","identifiers":[{"identifier":"2602.23336","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Camilo","familyName":"Gomez","name":"Gomez, Camilo","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Pengyang","familyName":"Wang","name":"Wang, Pengyang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Liansheng","familyName":"Tang","name":"Tang, Liansheng","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Differentiable Zero-One Loss via Hypersimplex Projections"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"Machine Learning (stat.ML)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-26T18:41:31Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T02:03:12Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Recent advances in machine learning have emphasized the integration of structured optimization components into end-to-end differentiable models, enabling richer inductive biases and tighter alignment with task-specific objectives. In this work, we introduce a novel differentiable approximation to the zero-one loss-long considered the gold standard for classification performance, yet incompatible with gradient-based optimization due to its non-differentiability. Our method constructs a smooth, order-preserving projection onto the n,k-dimensional hypersimplex through a constrained optimization framework, leading to a new operator we term Soft-Binary-Argmax. After deriving its mathematical properties, we show how its Jacobian can be efficiently computed and integrated into binary and multiclass learning systems. Empirically, our approach achieves significant improvements in generalization under large-batch training by imposing geometric consistency constraints on the output logits, thereby narrowing the performance gap traditionally observed in large-batch training."},{"descriptionType":"Other","description":"To appear in PAKDD 2026 (Pacific-Asia Conference on Knowledge Discovery and Data Mining), 12 pages"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.23336","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T03:08:21Z","registered":"2026-02-27T03:08:22Z","published":null,"updated":"2026-02-27T03:08:22Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.23335","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.23335","identifiers":[{"identifier":"2602.23335","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Dany","familyName":"Haddad","name":"Haddad, Dany","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Dan","familyName":"Bareket","name":"Bareket, Dan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Joseph Chee","familyName":"Chang","name":"Chang, Joseph Chee","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jay","familyName":"DeYoung","name":"DeYoung, Jay","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jena D.","familyName":"Hwang","name":"Hwang, Jena D.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Uri","familyName":"Katz","name":"Katz, Uri","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Mark","familyName":"Polak","name":"Polak, Mark","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Sangho","familyName":"Suh","name":"Suh, Sangho","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Harshit","familyName":"Surana","name":"Surana, Harshit","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Aryeh","familyName":"Tiktinsky","name":"Tiktinsky, Aryeh","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Shriya","familyName":"Atmakuri","name":"Atmakuri, Shriya","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jonathan","familyName":"Bragg","name":"Bragg, Jonathan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Mike","familyName":"D'Arcy","name":"D'Arcy, Mike","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Sergey","familyName":"Feldman","name":"Feldman, Sergey","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Amal","familyName":"Hassan-Ali","name":"Hassan-Ali, Amal","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Rubén","familyName":"Lozano","name":"Lozano, Rubén","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Bodhisattwa Prasad","familyName":"Majumder","name":"Majumder, Bodhisattwa Prasad","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Charles","familyName":"McGrady","name":"McGrady, Charles","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Amanpreet","familyName":"Singh","name":"Singh, Amanpreet","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Brooke","familyName":"Vlahos","name":"Vlahos, Brooke","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yoav","familyName":"Goldberg","name":"Goldberg, Yoav","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Doug","familyName":"Downey","name":"Downey, Doug","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Understanding Usage and Engagement in AI-Powered Scientific Research Tools: The Asta Interaction Dataset"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Human-Computer Interaction (cs.HC)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"Information Retrieval (cs.IR)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-26T18:40:28Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T02:03:10Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"AI-powered scientific research tools are rapidly being integrated into research workflows, yet the field lacks a clear lens into how researchers use these systems in real-world settings. We present and analyze the Asta Interaction Dataset, a large-scale resource comprising over 200,000 user queries and interaction logs from two deployed tools (a literature discovery interface and a scientific question-answering interface) within an LLM-powered retrieval-augmented generation platform. Using this dataset, we characterize query patterns, engagement behaviors, and how usage evolves with experience. We find that users submit longer and more complex queries than in traditional search, and treat the system as a collaborative research partner, delegating tasks such as drafting content and identifying research gaps. Users treat generated responses as persistent artifacts, revisiting and navigating among outputs and cited evidence in non-linear ways. With experience, users issue more targeted queries and engage more deeply with supporting citations, although keyword-style queries persist even among experienced users. We release the anonymized dataset and analysis with a new query intent taxonomy to inform future designs of real-world AI research assistants and to support realistic evaluation."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.23335","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T03:08:20Z","registered":"2026-02-27T03:08:21Z","published":null,"updated":"2026-02-27T03:08:21Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.23333","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.23333","identifiers":[{"identifier":"2602.23333","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Zeyu","familyName":"Xie","name":"Xie, Zeyu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Chenxing","familyName":"Li","name":"Li, Chenxing","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Qiao","familyName":"Jin","name":"Jin, Qiao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xuenan","familyName":"Xu","name":"Xu, Xuenan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Guanrou","familyName":"Yang","name":"Yang, Guanrou","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Wenfu","familyName":"Wang","name":"Wang, Wenfu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Mengyue","familyName":"Wu","name":"Wu, Mengyue","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Dong","familyName":"Yu","name":"Yu, Dong","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yuexian","familyName":"Zou","name":"Zou, Yuexian","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"SemanticVocoder: Bridging Audio Generation and Audio Understanding via Semantic Latents"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Sound (cs.SD)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"I.2","lang":"en","subjectScheme":"ACM"},{"subject":"68Txx","lang":"en","subjectScheme":"MSC"}],"contributors":[],"dates":[{"date":"2026-02-26T18:38:17Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T02:03:08Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Recent audio generation models typically rely on Variational Autoencoders (VAEs) and perform generation within the VAE latent space. Although VAEs excel at compression and reconstruction, their latents inherently encode low-level acoustic details rather than semantically discriminative information, leading to entangled event semantics and complicating the training of generative models. To address these issues, we discard VAE acoustic latents and introduce semantic encoder latents, thereby proposing SemanticVocoder, a generative vocoder that directly synthesizes waveforms from semantic latents. Equipped with SemanticVocoder, our text-to-audio generation model achieves a Frechet Distance of 12.823 and a Frechet Audio Distance of 1.709 on the AudioCaps test set, as the introduced semantic latents exhibit superior discriminability compared to acoustic VAE latents. Beyond improved generation performance, it also serves as a promising attempt towards unifying audio understanding and generation within a shared semantic space. Generated samples are available at https://zeyuxie29.github.io/SemanticVocoder/."},{"descriptionType":"Other","description":"Demo: https://zeyuxie29.github.io/SemanticVocoder/"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.23333","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T03:08:17Z","registered":"2026-02-27T03:08:18Z","published":null,"updated":"2026-02-27T03:08:18Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.23331","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.23331","identifiers":[{"identifier":"2602.23331","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Salim","familyName":"Fares","name":"Fares, Salim","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Utilizing LLMs for Industrial Process Automation"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Software Engineering (cs.SE)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-26T18:38:00Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T02:03:06Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"A growing number of publications address the best practices to use Large Language Models (LLMs) for software engineering in recent years. However, most of this work focuses on widely-used general purpose programming languages like Python due to their widespread usage training data. The utility of LLMs for software within the industrial process automation domain, with highly-specialized languages that are typically only used in proprietary contexts, remains underexplored. This research aims to utilize and integrate LLMs in the industrial development process, solving real-life programming tasks (e.g., generating a movement routine for a robotic arm) and accelerating the development cycles of manufacturing systems."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.23331","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T03:08:14Z","registered":"2026-02-27T03:08:15Z","published":null,"updated":"2026-02-27T03:08:15Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.23330","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.23330","identifiers":[{"identifier":"2602.23330","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Kunihiro","familyName":"Miyazaki","name":"Miyazaki, Kunihiro","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Takanobu","familyName":"Kawahara","name":"Kawahara, Takanobu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Stephen","familyName":"Roberts","name":"Roberts, Stephen","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Stefan","familyName":"Zohren","name":"Zohren, Stefan","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Toward Expert Investment Teams:A Multi-Agent LLM System with Fine-Grained Trading Tasks"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"Trading and Market Microstructure (q-fin.TR)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"FOS: Economics and business","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Economics and business","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-26T18:37:36Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T02:03:01Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"The advancement of large language models (LLMs) has accelerated the development of autonomous financial trading systems. While mainstream approaches deploy multi-agent systems mimicking analyst and manager roles, they often rely on abstract instructions that overlook the intricacies of real-world workflows, which can lead to degraded inference performance and less transparent decision-making. Therefore, we propose a multi-agent LLM trading framework that explicitly decomposes investment analysis into fine-grained tasks, rather than providing coarse-grained instructions. We evaluate the proposed framework using Japanese stock data, including prices, financial statements, news, and macro information, under a leakage-controlled backtesting setting. Experimental results show that fine-grained task decomposition significantly improves risk-adjusted returns compared to conventional coarse-grained designs. Crucially, further analysis of intermediate agent outputs suggests that alignment between analytical outputs and downstream decision preferences is a critical driver of system performance. Moreover, we conduct standard portfolio optimization, exploiting low correlation with the stock index and the variance of each system's output. This approach achieves superior performance. These findings contribute to the design of agent structure and task configuration when applying LLM agents to trading systems in practical settings."},{"descriptionType":"Other","description":"14 pages, 3 figures"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.23330","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T03:08:13Z","registered":"2026-02-27T03:08:13Z","published":null,"updated":"2026-02-27T03:08:13Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.23315","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.23315","identifiers":[{"identifier":"2602.23315","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Sha","familyName":"Hu","name":"Hu, Sha","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Invariant Transformation and Resampling based Epistemic-Uncertainty Reduction"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-26T18:22:40Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T02:02:07Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"An artificial intelligence (AI) model can be viewed as a function that maps inputs to outputs in high-dimensional spaces. Once designed and well trained, the AI model is applied for inference. However, even optimized AI models can produce inference errors due to aleatoric and epistemic uncertainties. Interestingly, we observed that when inferring multiple samples based on invariant transformations of an input, inference errors can show partial independences due to epistemic uncertainty. Leveraging this insight, we propose a \"resampling\" based inferencing that applies to a trained AI model with multiple transformed versions of an input, and aggregates inference outputs to a more accurate result. This approach has the potential to improve inference accuracy and offers a strategy for balancing model size and performance."},{"descriptionType":"Other","description":"5 pages, 5 figures"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.23315","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T03:07:50Z","registered":"2026-02-27T03:07:51Z","published":null,"updated":"2026-02-27T03:07:51Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.23300","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.23300","identifiers":[{"identifier":"2602.23300","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Soumya","familyName":"Dutta","name":"Dutta, Soumya","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Smruthi","familyName":"Balaji","name":"Balaji, Smruthi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Sriram","familyName":"Ganapathy","name":"Ganapathy, Sriram","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"A Mixture-of-Experts Model for Multimodal Emotion Recognition in Conversations"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"Audio and Speech Processing (eess.AS)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"FOS: Electrical engineering, electronic engineering, information engineering","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Electrical engineering, electronic engineering, information engineering","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-26T18:08:40Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T02:01:26Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Emotion Recognition in Conversations (ERC) presents unique challenges, requiring models to capture the temporal flow of multi-turn dialogues and to effectively integrate cues from multiple modalities. We propose Mixture of Speech-Text Experts for Recognition of Emotions (MiSTER-E), a modular Mixture-of-Experts (MoE) framework designed to decouple two core challenges in ERC: modality-specific context modeling and multimodal information fusion. MiSTER-E leverages large language models (LLMs) fine-tuned for both speech and text to provide rich utterance-level embeddings, which are then enhanced through a convolutional-recurrent context modeling layer. The system integrates predictions from three experts-speech-only, text-only, and cross-modal-using a learned gating mechanism that dynamically weighs their outputs. To further encourage consistency and alignment across modalities, we introduce a supervised contrastive loss between paired speech-text representations and a KL-divergence-based regulariza-tion across expert predictions. Importantly, MiSTER-E does not rely on speaker identity at any stage. Experiments on three benchmark datasets-IEMOCAP, MELD, and MOSI-show that our proposal achieves 70.9%, 69.5%, and 87.9% weighted F1-scores respectively, outperforming several baseline speech-text ERC systems. We also provide various ablations to highlight the contributions made in the proposed approach."},{"descriptionType":"Other","description":"Accepted to Elsevier Computer Speech and Language. 30 pages, 9 figures, 5 tables"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.23300","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T03:07:29Z","registered":"2026-02-27T03:07:29Z","published":null,"updated":"2026-02-27T03:07:29Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.23295","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.23295","identifiers":[{"identifier":"2602.23295","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Ayush","familyName":"Roy","name":"Roy, Ayush","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Wei-Yang Alex","familyName":"Lee","name":"Lee, Wei-Yang Alex","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Rudrasis","familyName":"Chakraborty","name":"Chakraborty, Rudrasis","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Vishnu Suresh","familyName":"Lokhande","name":"Lokhande, Vishnu Suresh","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"ManifoldGD: Training-Free Hierarchical Manifold Guidance for Diffusion-Based Dataset Distillation"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-26T18:07:10Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T02:01:20Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"In recent times, large datasets hinder efficient model training while also containing redundant concepts. Dataset distillation aims to synthesize compact datasets that preserve the knowledge of large-scale training sets while drastically reducing storage and computation. Recent advances in diffusion models have enabled training-free distillation by leveraging pre-trained generative priors; however, existing guidance strategies remain limited. Current score-based methods either perform unguided denoising or rely on simple mode-based guidance toward instance prototype centroids (IPC centroids), which often are rudimentary and suboptimal. We propose Manifold-Guided Distillation (ManifoldGD), a training-free diffusion-based framework that integrates manifold consistent guidance at every denoising timestep. Our method employs IPCs computed via a hierarchical, divisive clustering of VAE latent features, yielding a multi-scale coreset of IPCs that captures both coarse semantic modes and fine intra-class variability. Using a local neighborhood of the extracted IPC centroids, we create the latent manifold for each diffusion denoising timestep. At each denoising step, we project the mode-alignment vector onto the local tangent space of the estimated latent manifold, thus constraining the generation trajectory to remain manifold-faithful while preserving semantic consistency. This formulation improves representativeness, diversity, and image fidelity without requiring any model retraining. Empirical results demonstrate consistent gains over existing training-free and training-based baselines in terms of FID, l2 distance among real and synthetic dataset embeddings, and classification accuracy, establishing ManifoldGD as the first geometry-aware training-free data distillation framework."},{"descriptionType":"Other","description":"CVPE 2026"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.23295","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T03:07:22Z","registered":"2026-02-27T03:07:23Z","published":null,"updated":"2026-02-27T03:07:23Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.23292","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.23292","identifiers":[{"identifier":"2602.23292","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Fuqiang","familyName":"Chen","name":"Chen, Fuqiang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ranran","familyName":"Zhang","name":"Zhang, Ranran","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Wanming","familyName":"Hu","name":"Hu, Wanming","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Deboch Eyob","familyName":"Abera","name":"Abera, Deboch Eyob","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yue","familyName":"Peng","name":"Peng, Yue","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Boyun","familyName":"Zheng","name":"Zheng, Boyun","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yiwen","familyName":"Sun","name":"Sun, Yiwen","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jing","familyName":"Cai","name":"Cai, Jing","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Wenjian","familyName":"Qin","name":"Qin, Wenjian","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"PGVMS: A Prompt-Guided Unified Framework for Virtual Multiplex IHC Staining with Pathological Semantic Learning"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-26T18:03:24Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T02:00:55Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[{"relationType":"IsVersionOf","relatedIdentifier":"10.1109/tmi.2026.3663755","relatedIdentifierType":"DOI"}],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Immunohistochemical (IHC) staining enables precise molecular profiling of protein expression, with over 200 clinically available antibody-based tests in modern pathology. However, comprehensive IHC analysis is frequently limited by insufficient tissue quantities in small biopsies. Therefore, virtual multiplex staining emerges as an innovative solution to digitally transform H\u0026amp;E images into multiple IHC representations, yet current methods still face three critical challenges: (1) inadequate semantic guidance for multi-staining, (2) inconsistent distribution of immunochemistry staining, and (3) spatial misalignment across different stain modalities. To overcome these limitations, we present a prompt-guided framework for virtual multiplex IHC staining using only uniplex training data (PGVMS). Our framework introduces three key innovations corresponding to each challenge: First, an adaptive prompt guidance mechanism employing a pathological visual language model dynamically adjusts staining prompts to resolve semantic guidance limitations (Challenge 1). Second, our protein-aware learning strategy (PALS) maintains precise protein expression patterns by direct quantification and constraint of protein distributions (Challenge 2). Third, the prototype-consistent learning strategy (PCLS) establishes cross-image semantic interaction to correct spatial misalignments (Challenge 3)."},{"descriptionType":"Other","description":"Accepted by TMI"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.23292","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":1,"created":"2026-02-27T03:07:18Z","registered":"2026-02-27T03:07:18Z","published":null,"updated":"2026-02-27T03:07:19Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.23291","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.23291","identifiers":[{"identifier":"2602.23291","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Tommy","familyName":"Tang","name":"Tang, Tommy","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xinran","familyName":"Li","name":"Li, Xinran","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Bo","familyName":"Li","name":"Li, Bo","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Identifiability of Treatment Effects with Unobserved Spatially Varying Confounders"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Methodology (stat.ME)","lang":"en","subjectScheme":"arXiv"},{"subject":"Statistics Theory (math.ST)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"62F15","lang":"en","subjectScheme":"MSC"}],"contributors":[],"dates":[{"date":"2026-02-26T18:03:18Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T02:00:54Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"The study of causal effects in the presence of unmeasured spatially varying confounders has garnered increasing attention. However, a general framework for identifiability, which is critical for reliable causal inference from observational data, has yet to be advanced. In this paper, we study a linear model with various parametric model assumptions on the covariance structure between the unmeasured confounder and the exposure of interest. We establish identifiability of the treatment effect for many commonly 20 used spatial models for both discrete and continuous data, under mild conditions on the structure of observation locations and the exposure-confounder association. We also emphasize models or scenarios where identifiability may not hold, under which statistical inference should be conducted with caution."},{"descriptionType":"Other","description":"8 pages, 1 figure"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.23291","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T03:07:16Z","registered":"2026-02-27T03:07:17Z","published":null,"updated":"2026-02-27T03:07:17Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.23288","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.23288","identifiers":[{"identifier":"2602.23288","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Hayato","familyName":"Saiki","name":"Saiki, Hayato","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Chunggi","familyName":"Lee","name":"Lee, Chunggi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Hikari","familyName":"Takahashi","name":"Takahashi, Hikari","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Tica","familyName":"Lin","name":"Lin, Tica","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Hidetada","familyName":"Kishi","name":"Kishi, Hidetada","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Kaori","familyName":"Tachibana","name":"Tachibana, Kaori","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yasuhiro","familyName":"Suzuki","name":"Suzuki, Yasuhiro","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Hanspeter","familyName":"Pfister","name":"Pfister, Hanspeter","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Kenji","familyName":"Suzuki","name":"Suzuki, Kenji","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"BRIDGE: Borderless Reconfiguration for Inclusive and Diverse Gameplay Experience via Embodiment Transformation"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Human-Computer Interaction (cs.HC)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-26T18:01:35Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T02:00:49Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Training resources for parasports are limited, reducing opportunities for athletes and coaches to engage with sport-specific movements and tactical coordination. To address this gap, we developed BRIDGE, a system that integrates a reconstruction pipeline, which detects and tracks players from broadcast video to generate 3D play sequences, with an embodiment-aware visualization framework that decomposes head, trunk, and wheelchair base orientations to represent attention, intent, and mobility. We evaluated BRIDGE in two controlled studies with 20 participants (10 national wheelchair basketball team players and 10 amateur players). The results showed that BRIDGE significantly enhanced the perceived naturalness of player postures and made tactical intentions easier to understand. In addition, it supported functional classification by realistically conveying players' capabilities, which in turn improved participants' sense of self-efficacy. This work advances inclusive sports learning and accessible coaching practices, contributing to more equitable access to tactical resources in parasports."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.23288","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T03:07:12Z","registered":"2026-02-27T03:07:13Z","published":null,"updated":"2026-02-27T03:07:13Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.23286","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.23286","identifiers":[{"identifier":"2602.23286","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Sungho","familyName":"Park","name":"Park, Sungho","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jueun","familyName":"Kim","name":"Kim, Jueun","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Wook-Shin","familyName":"Han","name":"Han, Wook-Shin","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"SPARTA: Scalable and Principled Benchmark of Tree-Structured Multi-hop QA over Text and Tables"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"Databases (cs.DB)","lang":"en","subjectScheme":"arXiv"},{"subject":"Information Retrieval (cs.IR)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"H.2.4; H.3.3; H.3.4; I.2.7; I.2.1; H.2.3; F.2.2; I.2.6; H.3.1","lang":"en","subjectScheme":"ACM"}],"contributors":[],"dates":[{"date":"2026-02-26T17:59:51Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T02:00:45Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Real-world Table-Text question answering (QA) tasks require models that can reason across long text and source tables, traversing multiple hops and executing complex operations such as aggregation. Yet existing benchmarks are small, manually curated - and therefore error-prone - and contain shallow questions that seldom demand more than two hops or invoke aggregations, grouping, or other advanced analytical operations expressible in natural-language queries. We present SPARTA, an end-to-end construction framework that automatically generates large-scale Table-Text QA benchmarks with lightweight human validation, requiring only one quarter of the annotation time of HybridQA. The framework first constructs a reference fact database by enriching each source table with grounding tables whose tuples are atomic facts automatically extracted from the accompanying unstructured passages, then synthesizes nested queries whose number of nested predicates matches the desired hop count. To ensure that every SQL statement is executable and that its verbalization yields a fluent, human-sounding question, we propose two novel techniques: provenance-based refinement, which rewrites any syntactically valid query that returns a non-empty result, and realistic-structure enforcement, which confines generation to post-order traversals of the query graph. The resulting pipeline produces thousands of high-fidelity question-answer pairs covering aggregations, grouping, and deep multi-hop reasoning across text and tables. On SPARTA, state-of-the-art models that reach over 70 F1 on HybridQA or over 50 F1 on OTT-QA drop by more than 30 F1 points, exposing fundamental weaknesses in current cross-modal reasoning. Our benchmark, construction code, and baseline models are available at https://github.com/pshlego/SPARTA/tree/main."},{"descriptionType":"Other","description":"10 pages, 5 figures. Published as a conference paper at ICLR 2026. Project page: https://sparta-projectpage.github.io/"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.23286","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T03:07:09Z","registered":"2026-02-27T03:07:10Z","published":null,"updated":"2026-02-27T03:07:10Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.23283","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.23283","identifiers":[{"identifier":"2602.23283","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Mike Y.","familyName":"Michelis","name":"Michelis, Mike Y.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Nana","familyName":"Obayashi","name":"Obayashi, Nana","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Josie","familyName":"Hughes","name":"Hughes, Josie","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Robert K.","familyName":"Katzschmann","name":"Katzschmann, Robert K.","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Simple Models, Real Swimming: Digital Twins for Tendon-Driven Underwater Robots"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Robotics (cs.RO)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-26T17:55:22Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T02:00:33Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Mimicking the graceful motion of swimming animals remains a core challenge in soft robotics due to the complexity of fluid-structure interaction and the difficulty of controlling soft, biomimetic bodies. Existing modeling approaches are often computationally expensive and impractical for complex control or reinforcement learning needed for realistic motions to emerge in robotic systems. In this work, we present a tendon-driven fish robot modeled in an efficient underwater swimmer environment using a simplified, stateless hydrodynamics formulation implemented in the widespread robotics framework MuJoCo. With just two real-world swimming trajectories, we identify five fluid parameters that allow a matching to experimental behavior and generalize across a range of actuation frequencies. We show that this stateless fluid model can generalize to unseen actuation and outperform classical analytical models such as the elongated body theory. This simulation environment runs faster than real-time and can easily enable downstream learning algorithms such as reinforcement learning for target tracking, reaching a 93% success rate. Due to the simplicity and ease of use of the model and our open-source simulation environment, our results show that even simple, stateless models -- when carefully matched to physical data -- can serve as effective digital twins for soft underwater robots, opening up new directions for scalable learning and control in aquatic environments."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.23283","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T03:07:04Z","registered":"2026-02-27T03:07:05Z","published":null,"updated":"2026-02-27T03:07:05Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.23281","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.23281","identifiers":[{"identifier":"2602.23281","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Marc","familyName":"Neu","name":"Neu, Marc","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Isabel","familyName":"Haide","name":"Haide, Isabel","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Torben","familyName":"Ferber","name":"Ferber, Torben","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jürgen","familyName":"Becker","name":"Becker, Jürgen","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Real-Time Stream Compaction for Sparse Machine Learning on FPGAs"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"High Energy Physics - Experiment (hep-ex)","lang":"en","subjectScheme":"arXiv"},{"subject":"Hardware Architecture (cs.AR)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-26T17:54:32Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T02:00:31Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Machine learning algorithms are being used more frequently in the first-level triggers in collider experiments, with Graph Neural Networks pushing the hardware requirements of FPGA-based triggers beyond the current state of the art. To meet the stringent demands of high-throughput and low-latency environments, we propose a concept for latency-optimized preprocessing of sparse sensor data, enabling efficient GNN hardware acceleration by removing dynamic input sparsity. Our approach rearranges data coming from a large number of First-In-First-Out interfaces, typically sensor frontends, to a smaller number of FIFO interfaces connected to a machine learning hardware accelerator. In order to achieve high throughput while minimizing the hardware utilization, we developed a hierarchical sparsity compression pipeline optimized for FPGAs. We implemented our concept in the Chisel design language as an open-source hardware generator. For demonstration, we implemented one configuration of our module as preprocessing stage in a GNN-based first-level trigger for the Electromagnetic Calorimeter inside the Belle II detector. Additionally we evaluate latency, throughput, resource utilization, and scalability for a wide range of parameters, to enable broader use for other large scale scientific experiments."},{"descriptionType":"Other","description":"8 pages"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.23281","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T03:07:01Z","registered":"2026-02-27T03:07:02Z","published":null,"updated":"2026-02-27T03:07:02Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.23271","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.23271","identifiers":[{"identifier":"2602.23271","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Haotian","familyName":"Zhai","name":"Zhai, Haotian","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Elias","familyName":"Stengel-Eskin","name":"Stengel-Eskin, Elias","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Pratik","familyName":"Patil","name":"Patil, Pratik","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Liu","familyName":"Leqi","name":"Leqi, Liu","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Evaluating Stochasticity in Deep Research Agents"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-26T17:46:42Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T02:00:06Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by-nc-nd/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution Non Commercial No Derivatives 4.0 International","rightsIdentifier":"cc-by-nc-nd-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Deep Research Agents (DRAs) are promising agentic systems that gather and synthesize information to support research across domains such as financial decision-making, medical analysis, and scientific discovery. Despite recent improvements in research quality (e.g., outcome accuracy when ground truth is available), DRA system design often overlooks a critical barrier to real-world deployment: stochasticity. Under identical queries, repeated executions of DRAs can exhibit substantial variability in terms of research outcome, findings, and citations. In this paper, we formalize the study of stochasticity in DRAs by modeling them as information acquisition Markov Decision Processes. We introduce an evaluation framework that quantifies variance in the system and identify three sources of it: information acquisition, information compression, and inference. Through controlled experiments, we investigate how stochasticity from these modules across different decision steps influences the variance of DRA outputs. Our results show that reducing stochasticity can improve research output quality, with inference and early-stage stochasticity contributing the most to DRA output variance. Based on these findings, we propose strategies for mitigating stochasticity while maintaining output quality via structured output and ensemble-based query generation. Our experiments on DeepSearchQA show that our proposed mitigation methods reduce average stochasticity by 22% while maintaining high research quality."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.23271","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T03:06:46Z","registered":"2026-02-27T03:06:46Z","published":null,"updated":"2026-02-27T03:06:46Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.23266","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.23266","identifiers":[{"identifier":"2602.23266","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Siyuan","familyName":"Liu","name":"Liu, Siyuan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jiahui","familyName":"Xu","name":"Xu, Jiahui","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Feng","familyName":"Jiang","name":"Jiang, Feng","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Kuang","familyName":"Wang","name":"Wang, Kuang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zefeng","familyName":"Zhao","name":"Zhao, Zefeng","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Chu-Ren","familyName":"Huang","name":"Huang, Chu-Ren","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jinghang","familyName":"Gu","name":"Gu, Jinghang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Changqing","familyName":"Yin","name":"Yin, Changqing","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Haizhou","familyName":"Li","name":"Li, Haizhou","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Discourse-Aware Dual-Track Streaming Response for Low-Latency Spoken Dialogue Systems"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-26T17:39:56Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:59:57Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Achieving human-like responsiveness is a critical yet challenging goal for cascaded spoken dialogue systems. Conventional ASR-LLM-TTS pipelines follow a strictly sequential paradigm, requiring complete transcription and full reasoning before speech synthesis can begin, which results in high response latency. We propose the Discourse-Aware Dual-Track Streaming Response (DDTSR) framework, a low-latency architecture that enables listen-while-thinking and speak-while-thinking. DDTSR is built upon three key mechanisms: (1) connective-guided small-large model synergy, where an auxiliary small model generates minimal-committal discourse connectives while a large model performs knowledge-intensive reasoning in parallel; (2) streaming-based cross-modal collaboration, which dynamically overlaps ASR, LLM inference, and TTS to advance the earliest speakable moment; and (3) curriculum-learning-based discourse continuity enhancement, which maintains coherence and logical consistency between early responses and subsequent reasoning outputs. Experiments on two spoken dialogue benchmarks demonstrate that DDTSR reduces response latency by 19%-51% while preserving discourse quality. Further analysis shows that DDTSR functions as a plug-and-play module compatible with diverse LLM backbones, and remains robust across varying utterance lengths, indicating strong practicality and scalability for real-time spoken interaction."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.23266","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T03:06:38Z","registered":"2026-02-27T03:06:39Z","published":null,"updated":"2026-02-27T03:06:39Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.23265","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.23265","identifiers":[{"identifier":"2602.23265","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Gauri Umesh","familyName":"Rajmane","name":"Rajmane, Gauri Umesh","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ziming","familyName":"Li","name":"Li, Ziming","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Tae","familyName":"Oh","name":"Oh, Tae","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Roshan","familyName":"Peiris","name":"Peiris, Roshan","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"VRSL:Exploring the Comprehensibility of 360-Degree Camera Feeds for Sign Language Communication in Virtual Reality"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Human-Computer Interaction (cs.HC)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-26T17:39:36Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:59:55Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"This study explores integrating sign language into virtual reality (VR) by examining the comprehensibility and user experience of viewing American Sign Language (ASL) videos captured with body-mounted 360-degree cameras. Ten participants identified ASL signs from videos recorded at three body-mounted positions: head, shoulder, and chest. Results showed the shoulder-mounted camera achieved the highest accuracy (85%), though differences between positions were not statistically significant. Participants noted that peripheral distortion in 360-degree videos impacted clarity, highlighting areas for improvement. Despite challenges, the overall comprehension success rate of 83.3% demonstrates the potential of video-based ASL communication in VR. Feedback emphasized the need to refine camera angles, reduce distortion, and explore alternative mounting positions. Participants expressed a preference for signing over text-based communication in VR, highlighting the importance of developing this approach to enhance accessibility and collaboration for Deaf and Hard of Hearing (DHH) users in virtual environments."},{"descriptionType":"Other","description":"16 pages, 3 figures"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.23265","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T03:06:37Z","registered":"2026-02-27T03:06:38Z","published":null,"updated":"2026-02-27T03:06:38Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.23262","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.23262","identifiers":[{"identifier":"2602.23262","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Jasmine","familyName":"Bayrooti","name":"Bayrooti, Jasmine","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Weiwei","familyName":"Kong","name":"Kong, Weiwei","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Natalia","familyName":"Ponomareva","name":"Ponomareva, Natalia","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Carlos","familyName":"Esteves","name":"Esteves, Carlos","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ameesh","familyName":"Makadia","name":"Makadia, Ameesh","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Amanda","familyName":"Prorok","name":"Prorok, Amanda","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Decomposing Private Image Generation via Coarse-to-Fine Wavelet Modeling"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"Cryptography and Security (cs.CR)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-26T17:36:48Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:59:45Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Generative models trained on sensitive image datasets risk memorizing and reproducing individual training examples, making strong privacy guarantees essential. While differential privacy (DP) provides a principled framework for such guarantees, standard DP finetuning (e.g., with DP-SGD) often results in severe degradation of image quality, particularly in high-frequency textures, due to the indiscriminate addition of noise across all model parameters. In this work, we propose a spectral DP framework based on the hypothesis that the most privacy-sensitive portions of an image are often low-frequency components in the wavelet space (e.g., facial features and object shapes) while high-frequency components are largely generic and public. Based on this hypothesis, we propose the following two-stage framework for DP image generation with coarse image intermediaries: (1) DP finetune an autoregressive spectral image tokenizer model on the low-resolution wavelet coefficients of the sensitive images, and (2) perform high-resolution upsampling using a publicly pretrained super-resolution model. By restricting the privacy budget to the global structures of the image in the first stage, and leveraging the post-processing property of DP for detail refinement, we achieve promising trade-offs between privacy and utility. Experiments on the MS-COCO and MM-CelebA-HQ datasets show that our method generates images with improved quality and style capture relative to other leading DP image frameworks."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.23262","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T03:06:32Z","registered":"2026-02-27T03:06:33Z","published":null,"updated":"2026-02-27T03:06:33Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.23259","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.23259","identifiers":[{"identifier":"2602.23259","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Jiangxin","familyName":"Sun","name":"Sun, Jiangxin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Feng","familyName":"Xue","name":"Xue, Feng","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Teng","familyName":"Long","name":"Long, Teng","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Chang","familyName":"Liu","name":"Liu, Chang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jian-Fang","familyName":"Hu","name":"Hu, Jian-Fang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Wei-Shi","familyName":"Zheng","name":"Zheng, Wei-Shi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Nicu","familyName":"Sebe","name":"Sebe, Nicu","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Risk-Aware World Model Predictive Control for Generalizable End-to-End Autonomous Driving"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"Robotics (cs.RO)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-26T17:32:30Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:59:29Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by-nc-nd/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution Non Commercial No Derivatives 4.0 International","rightsIdentifier":"cc-by-nc-nd-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"With advances in imitation learning (IL) and large-scale driving datasets, end-to-end autonomous driving (E2E-AD) has made great progress recently. Currently, IL-based methods have become a mainstream paradigm: models rely on standard driving behaviors given by experts, and learn to minimize the discrepancy between their actions and expert actions. However, this objective of \"only driving like the expert\" suffers from limited generalization: when encountering rare or unseen long-tail scenarios outside the distribution of expert demonstrations, models tend to produce unsafe decisions in the absence of prior experience. This raises a fundamental question: Can an E2E-AD system make reliable decisions without any expert action supervision? Motivated by this, we propose a unified framework named Risk-aware World Model Predictive Control (RaWMPC) to address this generalization dilemma through robust control, without reliance on expert demonstrations. Practically, RaWMPC leverages a world model to predict the consequences of multiple candidate actions and selects low-risk actions through explicit risk evaluation. To endow the world model with the ability to predict the outcomes of risky driving behaviors, we design a risk-aware interaction strategy that systematically exposes the world model to hazardous behaviors, making catastrophic outcomes predictable and thus avoidable. Furthermore, to generate low-risk candidate actions at test time, we introduce a self-evaluation distillation method to distill riskavoidance capabilities from the well-trained world model into a generative action proposal network without any expert demonstration. Extensive experiments show that RaWMPC outperforms state-of-the-art methods in both in-distribution and out-of-distribution scenarios, while providing superior decision interpretability."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.23259","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T03:06:28Z","registered":"2026-02-27T03:06:29Z","published":null,"updated":"2026-02-27T03:06:29Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.23253","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.23253","identifiers":[{"identifier":"2602.23253","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Yijie","familyName":"Guo","name":"Guo, Yijie","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Iretiayo","familyName":"Akinola","name":"Akinola, Iretiayo","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Lars","familyName":"Johannsmeier","name":"Johannsmeier, Lars","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Hugo","familyName":"Hadfield","name":"Hadfield, Hugo","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Abhishek","familyName":"Gupta","name":"Gupta, Abhishek","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yashraj","familyName":"Narang","name":"Narang, Yashraj","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"SPARR: Simulation-based Policies with Asymmetric Real-world Residuals for Assembly"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Robotics (cs.RO)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-26T17:26:13Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:59:06Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Robotic assembly presents a long-standing challenge due to its requirement for precise, contact-rich manipulation. While simulation-based learning has enabled the development of robust assembly policies, their performance often degrades when deployed in real-world settings due to the sim-to-real gap. Conversely, real-world reinforcement learning (RL) methods avoid the sim-to-real gap, but rely heavily on human supervision and lack generalization ability to environmental changes. In this work, we propose a hybrid approach that combines a simulation-trained base policy with a real-world residual policy to efficiently adapt to real-world variations. The base policy, trained in simulation using low-level state observations and dense rewards, provides strong priors for initial behavior. The residual policy, learned in the real world using visual observations and sparse rewards, compensates for discrepancies in dynamics and sensor noise. Extensive real-world experiments demonstrate that our method, SPARR, achieves near-perfect success rates across diverse two-part assembly tasks. Compared to the state-of-the-art zero-shot sim-to-real methods, SPARR improves success rates by 38.4% while reducing cycle time by 29.7%. Moreover, SPARR requires no human expertise, in contrast to the state-of-the-art real-world RL approaches that depend heavily on human supervision."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.23253","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T03:06:19Z","registered":"2026-02-27T03:06:19Z","published":null,"updated":"2026-02-27T03:06:19Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.23235","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.23235","identifiers":[{"identifier":"2602.23235","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Zhou","familyName":"Xu","name":"Xu, Zhou","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Bowen","familyName":"Zhou","name":"Zhou, Bowen","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Qi","familyName":"Wang","name":"Wang, Qi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Shuwen","familyName":"Feng","name":"Feng, Shuwen","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jingyu","familyName":"Xiao","name":"Xiao, Jingyu","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Spatio-Temporal Token Pruning for Efficient High-Resolution GUI Agents"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-26T17:12:40Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:58:20Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Pure-vision GUI agents provide universal interaction capabilities but suffer from severe efficiency bottlenecks due to the massive spatiotemporal redundancy inherent in high-resolution screenshots and historical trajectories. We identify two critical misalignments in existing compression paradigms: the temporal mismatch, where uniform history encoding diverges from the agent's \"fading memory\" attention pattern, and the spatial topology conflict, where unstructured pruning compromises the grid integrity required for precise coordinate grounding, inducing spatial hallucinations. To address these challenges, we introduce GUIPruner, a training-free framework tailored for high-resolution GUI navigation. It synergizes Temporal-Adaptive Resolution (TAR), which eliminates historical redundancy via decay-based resizing, and Stratified Structure-aware Pruning (SSP), which prioritizes interactive foregrounds and semantic anchors while safeguarding global layout. Extensive evaluations across diverse benchmarks demonstrate that GUIPruner consistently achieves state-of-the-art performance, effectively preventing the collapse observed in large-scale models under high compression. Notably, on Qwen2-VL-2B, our method delivers a 3.4x reduction in FLOPs and a 3.3x speedup in vision encoding latency while retaining over 94% of the original performance, enabling real-time, high-precision navigation with minimal resource consumption."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.23235","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T03:05:51Z","registered":"2026-02-27T03:05:52Z","published":null,"updated":"2026-02-27T03:05:52Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.23233","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.23233","identifiers":[{"identifier":"2602.23233","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Herbert P.","familyName":"Susmann","name":"Susmann, Herbert P.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Antonio","familyName":"D'Alessandro","name":"D'Alessandro, Antonio","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"The Counterfactual Combine: A Causal Framework for Player Evaluation"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Applications (stat.AP)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-26T17:11:13Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:58:17Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Evaluating sports players based on their performance shares core challenges with evaluating healthcare providers based on patient outcomes. Drawing on recent advances in healthcare provider profiling, we cast sports player evaluation within a rigorous causal inference framework and define a flexible class of causal player evaluation estimands. Using stochastic interventions, we compare player success rates on repeated tasks (such as field goal attempts or plate appearance) to counterfactual success rates had those same attempts been randomly reassigned to players according to prespecified reference distributions. This setup encompasses direct and indirect standardization parameters familiar from healthcare provider profiling, and we additionally propose a \"performance above random replacement\" estimand designed for interpretability in sports settings. We develop doubly robust estimators for these evaluation metrics based on modern semiparametric statistical methods, with a focus on Targeted Minimum Loss-based Estimation, and incorporate machine learning methods to capture complex relationships driving player performance. We illustrate our framework in detailed case studies of field goal kickers in the National Football League and batters in Major League Baseball, highlighting how different causal estimands yield distinct interpretations and insights about player performance."},{"descriptionType":"Other","description":"23 pages, 8 figures"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.23233","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T03:05:48Z","registered":"2026-02-27T03:05:48Z","published":null,"updated":"2026-02-27T03:05:48Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.23230","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.23230","identifiers":[{"identifier":"2602.23230","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Zahra","familyName":"Khatibi","name":"Khatibi, Zahra","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Lorenzo A.","familyName":"Mariano","name":"Mariano, Lorenzo A.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Lion","familyName":"Frangoulis","name":"Frangoulis, Lion","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Alessandro","familyName":"Lunghi","name":"Lunghi, Alessandro","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Efficient training of generative models from multireference simulations and its application to the design of Dy complexes with large magnetic anisotropy"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Materials Science (cond-mat.mtrl-sci)","lang":"en","subjectScheme":"arXiv"},{"subject":"Chemical Physics (physics.chem-ph)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-26T17:09:53Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:58:12Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Generative machine learning models can potentially provide direct access to novel and relevant portions of the full chemical space, overcoming the cost of systematic sampling. However, the training of these models generally requires a large amount of data, often precluding the use of expensive high-level ab initio simulations for this task. The generation of coordination compounds of Dy with large magnetic anisotropy represents a topical example, where multireference simulations of large molecules are necessary to perform reliable predictions. Here, we show that a semi-supervised chemically-inspired training-by-proxy of generative variational autoencoders can reduce the cost associated with building a training set from multireference simulations by two orders of magnitude. We illustrate the power of this approach by generating 100s of new organic ligands for Dy(III) pentagonal bipyramidal complexes exhibiting record values of magnetic anisotropy, while starting from datasets as small as 1k multireference calculations. This work thus paves the way to the computational generation of molecules as complex coordination compounds with target electronic and magnetic properties."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.23230","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":2,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T03:05:43Z","registered":"2026-02-27T03:05:44Z","published":null,"updated":"2026-02-27T03:05:44Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.23229","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.23229","identifiers":[{"identifier":"2602.23229","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Marco","familyName":"Garosi","name":"Garosi, Marco","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Matteo","familyName":"Farina","name":"Farina, Matteo","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Alessandro","familyName":"Conti","name":"Conti, Alessandro","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Massimiliano","familyName":"Mancini","name":"Mancini, Massimiliano","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Elisa","familyName":"Ricci","name":"Ricci, Elisa","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Large Multimodal Models as General In-Context Classifiers"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-26T17:08:18Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:58:07Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by-nc-nd/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution Non Commercial No Derivatives 4.0 International","rightsIdentifier":"cc-by-nc-nd-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Which multimodal model should we use for classification? Previous studies suggest that the answer lies in CLIP-like contrastive Vision-Language Models (VLMs), due to their remarkable performance in zero-shot classification. In contrast, Large Multimodal Models (LMM) are more suitable for complex tasks. In this work, we argue that this answer overlooks an important capability of LMMs: in-context learning. We benchmark state-of-the-art LMMs on diverse datasets for closed-world classification and find that, although their zero-shot performance is lower than CLIP's, LMMs with a few in-context examples can match or even surpass contrastive VLMs with cache-based adapters, their \"in-context\" equivalent. We extend this analysis to the open-world setting, where the generative nature of LMMs makes them more suitable for the task. In this challenging scenario, LMMs struggle whenever provided with imperfect context information. To address this issue, we propose CIRCLE, a simple training-free method that assigns pseudo-labels to in-context examples, iteratively refining them with the available context itself. Through extensive experiments, we show that CIRCLE establishes a robust baseline for open-world classification, surpassing VLM counterparts and highlighting the potential of LMMs to serve as unified classifiers, and a flexible alternative to specialized models."},{"descriptionType":"Other","description":"CVPR Findings 2026. Project website at https://circle-lmm.github.io/"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.23229","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T03:05:42Z","registered":"2026-02-27T03:05:43Z","published":null,"updated":"2026-02-27T03:05:43Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.23224","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.23224","identifiers":[{"identifier":"2602.23224","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Mohammad","familyName":"Mahdavian","name":"Mahdavian, Mohammad","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Gordon","familyName":"Tan","name":"Tan, Gordon","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Binbin","familyName":"Xu","name":"Xu, Binbin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yuan","familyName":"Ren","name":"Ren, Yuan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Dongfeng","familyName":"Bai","name":"Bai, Dongfeng","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Bingbing","familyName":"Liu","name":"Liu, Bingbing","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"UniScale: Unified Scale-Aware 3D Reconstruction for Multi-View Understanding via Prior Injection for Robotic Perception"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"Robotics (cs.RO)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-26T17:04:36Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:57:55Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"We present UniScale, a unified, scale-aware multi-view 3D reconstruction framework for robotic applications that flexibly integrates geometric priors through a modular, semantically informed design. In vision-based robotic navigation, the accurate extraction of environmental structure from raw image sequences is critical for downstream tasks. UniScale addresses this challenge with a single feed-forward network that jointly estimates camera intrinsics and extrinsics, scale-invariant depth and point maps, and the metric scale of a scene from multi-view images, while optionally incorporating auxiliary geometric priors when available. By combining global contextual reasoning with camera-aware feature representations, UniScale is able to recover the metric-scale of the scene. In robotic settings where camera intrinsics are known, they can be easily incorporated to improve performance, with additional gains obtained when camera poses are also available. This co-design enables robust, metric-aware 3D reconstruction within a single unified model. Importantly, UniScale does not require training from scratch, and leverages world priors exhibited in pre-existing models without geometric encoding strategies, making it particularly suitable for resource-constrained robotic teams. We evaluate UniScale on multiple benchmarks, demonstrating strong generalization and consistent performance across diverse environments. We will release our implementation upon acceptance."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.23224","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T03:05:34Z","registered":"2026-02-27T03:05:35Z","published":null,"updated":"2026-02-27T03:05:35Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.23220","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.23220","identifiers":[{"identifier":"2602.23220","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Chris","familyName":"Egersdoerfer","name":"Egersdoerfer, Chris","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Philip","familyName":"Carns","name":"Carns, Philip","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Shane","familyName":"Snyder","name":"Snyder, Shane","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Robert","familyName":"Ross","name":"Ross, Robert","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Dong","familyName":"Dai","name":"Dai, Dong","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"STELLAR: Storage Tuning Engine Leveraging LLM Autonomous Reasoning for High Performance Parallel File Systems"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Distributed, Parallel, and Cluster Computing (cs.DC)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-26T17:01:18Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:57:46Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[{"relationType":"IsVersionOf","relatedIdentifier":"10.1145/3712285.3759887","relatedIdentifierType":"DOI"}],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"I/O performance is crucial to efficiency in data-intensive scientific computing; but tuning large-scale storage systems is complex, costly, and notoriously manpower-intensive, making it inaccessible for most domain scientists. To address this problem, we propose STELLAR, an autonomous tuner for high-performance parallel file systems. Our evaluations show that STELLAR almost always selects near-optimal parameter configurations for parallel file systems within the first five attempts, even for previously unseen applications.\n STELLAR differs fundamentally from traditional autotuning methods, which often require hundreds of thousands of iterations to converge. Powered by large language models (LLMs), STELLAR enables autonomous end-to-end agentic tuning by (1) accurately extracting tunable parameters from software manuals, (2) analyzing I/O trace logs generated by applications, (3) selecting initial tuning strategies, (4) rerunning applications on real systems and collecting I/O performance feedback, (5) adjusting tuning strategies and repeating the tuning cycle, and (6) reflecting on and summarizing tuning experiences into reusable knowledge for future optimizations. STELLAR integrates retrieval-augmented generation (RAG), tool execution, LLM-based reasoning, and a multiagent design to stabilize reasoning and combat hallucinations.\n We evaluate the impact of each component on optimization outcomes, providing design insights for similar systems in other optimization domains. STELLAR's architecture and empirical results highlight a promising approach to complex system optimization, especially for problems with large search spaces and high exploration costs, while making I/O tuning more accessible to domain scientists with minimal added resources."},{"descriptionType":"Other","description":"Published in the Proceedings of the 2025 International Conference for High Performance Computing, Networking, Storage, and Analysis (SC25)"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.23220","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":1,"created":"2026-02-27T03:05:28Z","registered":"2026-02-27T03:05:29Z","published":null,"updated":"2026-02-27T03:05:29Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.23199","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.23199","identifiers":[{"identifier":"2602.23199","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Jiahao","familyName":"Zhao","name":"Zhao, Jiahao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Feng","familyName":"Jiang","name":"Jiang, Feng","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Shaowei","familyName":"Qin","name":"Qin, Shaowei","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zhonghui","familyName":"Zhang","name":"Zhang, Zhonghui","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Junhao","familyName":"Liu","name":"Liu, Junhao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Guibing","familyName":"Guo","name":"Guo, Guibing","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Hamid","familyName":"Alinejad-Rokny","name":"Alinejad-Rokny, Hamid","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Min","familyName":"Yang","name":"Yang, Min","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"SC-Arena: A Natural Language Benchmark for Single-Cell Reasoning with Knowledge-Augmented Evaluation"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-26T16:50:28Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:56:56Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Large language models (LLMs) are increasingly applied in scientific research, offering new capabilities for knowledge discovery and reasoning. In single-cell biology, however, evaluation practices for both general and specialized LLMs remain inadequate: existing benchmarks are fragmented across tasks, adopt formats such as multiple-choice classification that diverge from real-world usage, and rely on metrics lacking interpretability and biological grounding. We present SC-ARENA, a natural language evaluation framework tailored to single-cell foundation models. SC-ARENA formalizes a virtual cell abstraction that unifies evaluation targets by representing both intrinsic attributes and gene-level interactions. Within this paradigm, we define five natural language tasks (cell type annotation, captioning, generation, perturbation prediction, and scientific QA) that probe core reasoning capabilities in cellular biology. To overcome the limitations of brittle string-matching metrics, we introduce knowledge-augmented evaluation, which incorporates external ontologies, marker databases, and scientific literature to support biologically faithful and interpretable judgments. Experiments and analysis across both general-purpose and domain-specialized LLMs demonstrate that (i) under the Virtual Cell unified evaluation paradigm, current models achieve uneven performance on biologically complex tasks, particularly those demanding mechanistic or causal understanding; and (ii) our knowledge-augmented evaluation framework ensures biological correctness, provides interpretable, evidence-grounded rationales, and achieves high discriminative capacity, overcoming the brittleness and opacity of conventional metrics. SC-Arena thus provides a unified and interpretable framework for assessing LLMs in single-cell biology, pointing toward the development of biology-aligned, generalizable foundation models."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.23199","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T03:04:54Z","registered":"2026-02-27T03:04:55Z","published":null,"updated":"2026-02-27T03:04:55Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.23198","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.23198","identifiers":[{"identifier":"2602.23198","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Patrick G.","familyName":"Sahrmann","name":"Sahrmann, Patrick G.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Benjamin T.","familyName":"Nebgen","name":"Nebgen, Benjamin T.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Kipton","familyName":"Barros","name":"Barros, Kipton","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Brenden W.","familyName":"Hamilton","name":"Hamilton, Brenden W.","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Learning Thermal Response Forces: A Method for Extending the Thermodynamic Transferability of Coarse-Grained Models via Machine-Learning"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Chemical Physics (physics.chem-ph)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-26T16:50:22Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:56:53Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by-nc-nd/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution Non Commercial No Derivatives 4.0 International","rightsIdentifier":"cc-by-nc-nd-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Machine-learned (ML) coarse-grained (CG) models are a promising tool for significantly enhancing the efficiency of molecular simulations by systematically removing degrees of freedom while retaining fidelity to the underlying fine-grained model. The CG potential of mean force (PMF) is inherently dependent on thermodynamic conditions and, hence, a CG force-field (FF) which is trained at one thermodynamic state point is not necessarily accurate at another. We propose, in this work, a novel and data-efficient means of learning temperature dependence into ML CG force-fields via training on the thermal response forces of the PMF. We demonstrate how incorporating these terms into ML CG FFs confers significantly improved transferability for CG water models and demonstrate how this transferability enables accurate and predictive CG dynamics."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.23198","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T03:04:52Z","registered":"2026-02-27T03:04:53Z","published":null,"updated":"2026-02-27T03:04:53Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.23193","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.23193","identifiers":[{"identifier":"2602.23193","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Elzo Brito dos Santos","familyName":"Filho","name":"Filho, Elzo Brito dos Santos","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"ESAA: Event Sourcing for Autonomous Agents in LLM-Based Software Engineering"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-26T16:45:59Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:56:43Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Autonomous agents based on Large Language Models (LLMs) have evolved from reactive assistants to systems capable of planning, executing actions via tools, and iterating over environment observations. However, they remain vulnerable to structural limitations: lack of native state, context degradation over long horizons, and the gap between probabilistic generation and deterministic execution requirements. This paper presents the ESAA (Event Sourcing for Autonomous Agents) architecture, which separates the agent's cognitive intention from the project's state mutation, inspired by the Event Sourcing pattern. In ESAA, agents emit only structured intentions in validated JSON (agent.result or issue.report); a deterministic orchestrator validates, persists events in an append-only log (activity.jsonl), applies file-writing effects, and projects a verifiable materialized view (roadmap.json). The proposal incorporates boundary contracts (AGENT_CONTRACT.yaml), metaprompting profiles (PARCER), and replay verification with hashing (esaa verify), ensuring the immutability of completed tasks and forensic traceability. Two case studies validate the architecture: (i) a landing page project (9 tasks, 49 events, single-agent composition) and (ii) a clinical dashboard system (50 tasks, 86 events, 4 concurrent agents across 8 phases), both concluding with run.status=success and verify_status=ok. The multi-agent case study demonstrates real concurrent orchestration with heterogeneous LLMs (Claude Sonnet 4.6, Codex GPT-5, Antigravity/Gemini 3 Pro, and Claude Opus 4.6), providing empirical evidence of the architecture's scalability beyond single-agent scenarios."},{"descriptionType":"Other","description":"13 pages, 1 figure, 4 tables. Includes 5 technical appendices"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.23193","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T03:04:45Z","registered":"2026-02-27T03:04:46Z","published":null,"updated":"2026-02-27T03:04:46Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.23192","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.23192","identifiers":[{"identifier":"2602.23192","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Thomas","familyName":"Woergaard","name":"Woergaard, Thomas","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Raghavendra","familyName":"Selvan","name":"Selvan, Raghavendra","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"FairQuant: Fairness-Aware Mixed-Precision Quantization for Medical Image Classification"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-26T16:44:47Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:56:42Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Compressing neural networks by quantizing model parameters offers useful trade-off between performance and efficiency. Methods like quantization-aware training and post-training quantization strive to maintain the downstream performance of compressed models compared to the full precision models. However, these techniques do not explicitly consider the impact on algorithmic fairness. In this work, we study fairness-aware mixed-precision quantization schemes for medical image classification under explicit bit budgets. We introduce FairQuant, a framework that combines group-aware importance analysis, budgeted mixed-precision allocation, and a learnable Bit-Aware Quantization (BAQ) mode that jointly optimizes weights and per-unit bit allocations under bitrate and fairness regularization. We evaluate the method on Fitzpatrick17k and ISIC2019 across ResNet18/50, DeiT-Tiny, and TinyViT. Results show that FairQuant configurations with average precision near 4-6 bits recover much of the Uniform 8-bit accuracy while improving worst-group performance relative to Uniform 4- and 8-bit baselines, with comparable fairness metrics under shared budgets."},{"descriptionType":"Other","description":"Source code available at https://github.com/saintslab/FairQuant"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.23192","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T03:04:43Z","registered":"2026-02-27T03:04:44Z","published":null,"updated":"2026-02-27T03:04:44Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.23184","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.23184","identifiers":[{"identifier":"2602.23184","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Sara","familyName":"Rosenthal","name":"Rosenthal, Sara","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yannis","familyName":"Katsis","name":"Katsis, Yannis","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Vraj","familyName":"Shah","name":"Shah, Vraj","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Lihong","familyName":"He","name":"He, Lihong","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Lucian","familyName":"Popa","name":"Popa, Lucian","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Marina","familyName":"Danilevsky","name":"Danilevsky, Marina","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"MTRAG-UN: A Benchmark for Open Challenges in Multi-Turn RAG Conversations"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-26T16:41:17Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:56:30Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by-sa/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution Share Alike 4.0 International","rightsIdentifier":"cc-by-sa-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"We present MTRAG-UN, a benchmark for exploring open challenges in multi-turn retrieval augmented generation, a popular use of large language models. We release a benchmark of 666 tasks containing over 2,800 conversation turns across 6 domains with accompanying corpora. Our experiments show that retrieval and generation models continue to struggle on conversations with UNanswerable, UNderspecified, and NONstandalone questions and UNclear responses. Our benchmark is available at https://github.com/IBM/mt-rag-benchmark"},{"descriptionType":"Other","description":"5 pages, 3 figures"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.23184","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T03:04:31Z","registered":"2026-02-27T03:04:32Z","published":null,"updated":"2026-02-27T03:04:32Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.23181","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.23181","identifiers":[{"identifier":"2602.23181","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Jeremy P","familyName":"Parker","name":"Parker, Jeremy P","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Tobias M","familyName":"Schneider","name":"Schneider, Tobias M","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"From synthetic turbulence to true solutions: A deep diffusion model for discovering periodic orbits in the Navier-Stokes equations"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Fluid Dynamics (physics.flu-dyn)","lang":"en","subjectScheme":"arXiv"},{"subject":"Chaotic Dynamics (nlin.CD)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-26T16:40:01Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:56:23Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by-nc-sa/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution Non Commercial Share Alike 4.0 International","rightsIdentifier":"cc-by-nc-sa-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Generative artificial intelligence has shown remarkable success in synthesizing data that mimic complex real-world systems, but its potential role in the discovery of mathematically meaningful structures in physical models remains underexplored. In this work, we demonstrate how a generative diffusion model can be used to uncover previously unknown solutions of a nonlinear partial differential equation: the two-dimensional Navier-Stokes equations in a turbulent regime. Trained on data from a direct numerical simulation of turbulence, the model learns to generate time series that resemble physically plausible trajectories. By carefully modifying the temporal structure of the model and enforcing the symmetries of the governing equations, we produce synthetic trajectories that are periodic in time, despite the fact that the training data did not contain periodic trajectories. These synthetic trajectories are then refined into true solutions using an iterative solver, yielding 111 new periodic orbits (POs) with very short periods. Our results reveal a previously unobserved richness in the PO structure of this system and suggest a broader role for generative AI: not as replacements for simulation and existing solvers, but as a complementary tool for navigating the complex solution spaces of nonlinear dynamical systems."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.23181","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T03:04:27Z","registered":"2026-02-27T03:04:27Z","published":null,"updated":"2026-02-27T03:04:27Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.23167","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.23167","identifiers":[{"identifier":"2602.23167","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","affiliation":["Shanghai Jiao Tong University"],"givenName":"Shuang","familyName":"Liang","name":"Liang, Shuang","nameIdentifiers":[]},{"nameType":"Personal","affiliation":["Queen's University Belfast"],"givenName":"Yang","familyName":"Hua","name":"Hua, Yang","nameIdentifiers":[]},{"nameType":"Personal","affiliation":["National University of Singapore"],"givenName":"Linshan","familyName":"Jiang","name":"Jiang, Linshan","nameIdentifiers":[]},{"nameType":"Personal","affiliation":["Shanghai Jiao Tong University"],"givenName":"Peishen","familyName":"Yan","name":"Yan, Peishen","nameIdentifiers":[]},{"nameType":"Personal","affiliation":["Shanghai Jiao Tong University"],"givenName":"Tao","familyName":"Song","name":"Song, Tao","nameIdentifiers":[]},{"nameType":"Personal","affiliation":["Shanghai Jiao Tong University"],"givenName":"Bin","familyName":"Yao","name":"Yao, Bin","nameIdentifiers":[]},{"nameType":"Personal","affiliation":["Shanghai Jiao Tong University"],"givenName":"Haibing","familyName":"Guan","name":"Guan, Haibing","nameIdentifiers":[]}],"titles":[{"title":"SettleFL: Trustless and Scalable Reward Settlement Protocol for Federated Learning on Permissionless Blockchains (Extended version)"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Cryptography and Security (cs.CR)","lang":"en","subjectScheme":"arXiv"},{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-26T16:31:23Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:55:29Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"In open Federated Learning (FL) environments where no central authority exists, ensuring collaboration fairness relies on decentralized reward settlement, yet the prohibitive cost of permissionless blockchains directly clashes with the high-frequency, iterative nature of model training. Existing solutions either compromise decentralization or suffer from scalability bottlenecks due to linear on-chain costs. To address this, we present SettleFL, a trustless and scalable reward settlement protocol designed to minimize total economic friction by offering a family of two interoperable protocols. Leveraging a shared domain-specific circuit architecture, SettleFL offers two interoperable strategies: (1) a Commit-and-Challenge variant that minimizes on-chain costs via optimistic execution and dispute-driven arbitration, and (2) a Commit-with-Proof variant that guarantees instant finality through per-round validity proofs. This design allows the protocol to flexibly adapt to varying latency and cost constraints while enforcing rational robustness without trusted coordination. We conduct extensive experiments combining real FL workloads and controlled simulations. Results show that SettleFL remains practical when scaling to 800 participants, achieving substantially lower gas cost."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.23167","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T03:04:05Z","registered":"2026-02-27T03:04:06Z","published":null,"updated":"2026-02-27T03:04:06Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.23152","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.23152","identifiers":[{"identifier":"2602.23152","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Jingxuan","familyName":"Wei","name":"Wei, Jingxuan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Siyuan","familyName":"Li","name":"Li, Siyuan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yuhang","familyName":"Xu","name":"Xu, Yuhang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zheng","familyName":"Sun","name":"Sun, Zheng","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Junjie","familyName":"Jiang","name":"Jiang, Junjie","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Hexuan","familyName":"Jin","name":"Jin, Hexuan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Caijun","familyName":"Jia","name":"Jia, Caijun","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Honghao","familyName":"He","name":"He, Honghao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xinglong","familyName":"Xu","name":"Xu, Xinglong","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xi","familyName":"bai","name":"bai, Xi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Chang","familyName":"Yu","name":"Yu, Chang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yumou","familyName":"Liu","name":"Liu, Yumou","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Junnan","familyName":"Zhu","name":"Zhu, Junnan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xuanhe","familyName":"Zhou","name":"Zhou, Xuanhe","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jintao","familyName":"Chen","name":"Chen, Jintao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xiaobin","familyName":"Hu","name":"Hu, Xiaobin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Shancheng","familyName":"Pang","name":"Pang, Shancheng","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Bihui","familyName":"Yu","name":"Yu, Bihui","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ran","familyName":"He","name":"He, Ran","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zhen","familyName":"Lei","name":"Lei, Zhen","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Stan Z.","familyName":"Li","name":"Li, Stan Z.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Conghui","familyName":"He","name":"He, Conghui","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Shuicheng","familyName":"Yan","name":"Yan, Shuicheng","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Cheng","familyName":"Tan","name":"Tan, Cheng","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"The Trinity of Consistency as a Defining Principle for General World Models"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-26T16:15:55Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:54:52Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"The construction of World Models capable of learning, simulating, and reasoning about objective physical laws constitutes a foundational challenge in the pursuit of Artificial General Intelligence. Recent advancements represented by video generation models like Sora have demonstrated the potential of data-driven scaling laws to approximate physical dynamics, while the emerging Unified Multimodal Model (UMM) offers a promising architectural paradigm for integrating perception, language, and reasoning. Despite these advances, the field still lacks a principled theoretical framework that defines the essential properties requisite for a General World Model. In this paper, we propose that a World Model must be grounded in the Trinity of Consistency: Modal Consistency as the semantic interface, Spatial Consistency as the geometric basis, and Temporal Consistency as the causal engine. Through this tripartite lens, we systematically review the evolution of multimodal learning, revealing a trajectory from loosely coupled specialized modules toward unified architectures that enable the synergistic emergence of internal world simulators. To complement this conceptual framework, we introduce CoW-Bench, a benchmark centered on multi-frame reasoning and generation scenarios. CoW-Bench evaluates both video generation models and UMMs under a unified evaluation protocol. Our work establishes a principled pathway toward general world models, clarifying both the limitations of current systems and the architectural requirements for future progress."},{"descriptionType":"Other","description":"119 pages, 50 figures"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.23152","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T03:03:42Z","registered":"2026-02-27T03:03:43Z","published":null,"updated":"2026-02-27T03:03:43Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.23123","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.23123","identifiers":[{"identifier":"2602.23123","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Keito","familyName":"Inoshita","name":"Inoshita, Keito","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Multi-Agent Large Language Model Based Emotional Detoxification Through Personalized Intensity Control for Consumer Protection"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-26T15:37:03Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:53:30Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"In the attention economy, sensational content exposes consumers to excessive emotional stimulation, hindering calm decision-making. This study proposes Multi-Agent LLM-based Emotional deToxification (MALLET), a multi-agent information sanitization system consisting of four agents: Emotion Analysis, Emotion Adjustment, Balance Monitoring, and Personal Guide. The Emotion Analysis Agent quantifies stimulus intensity using a 6-emotion BERT classifier, and the Emotion Adjustment Agent rewrites texts into two presentation modes, BALANCED (neutralized text) and COOL (neutralized text + supplementary text), using an LLM. The Balance Monitoring Agent aggregates weekly information consumption patterns and generates personalized advice, while the Personal Guide Agent recommends a presentation mode according to consumer sensitivity. Experiments on 800 AG News articles demonstrated significant stimulus score reduction (up to 19.3%) and improved emotion balance while maintaining semantic preservation. Near-zero correlation between stimulus reduction and semantic preservation confirmed that the two are independently controllable. Category-level analysis revealed substantial reduction (17.8-33.8%) in Sports, Business, and Sci/Tech, whereas the effect was limited in the World category, where facts themselves are inherently high-stimulus. The proposed system provides a framework for supporting calm information reception of consumers without restricting access to the original text."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.23123","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T03:02:57Z","registered":"2026-02-27T03:02:57Z","published":null,"updated":"2026-02-27T03:02:57Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.23121","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.23121","identifiers":[{"identifier":"2602.23121","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"C.","familyName":"Seas","name":"Seas, C.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"G.","familyName":"Fitzpatrick","name":"Fitzpatrick, G.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"J. A.","familyName":"Hamilton","name":"Hamilton, J. A.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"M. C.","familyName":"Carlisle","name":"Carlisle, M. C.","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Automated Vulnerability Detection in Source Code Using Deep Representation Learning"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Cryptography and Security (cs.CR)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-26T15:35:17Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:53:27Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[{"relationType":"IsVersionOf","relatedIdentifier":"10.1109/ccwc60891.2024.10427574","relatedIdentifierType":"DOI"}],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Each year, software vulnerabilities are discovered, which pose significant risks of exploitation and system compromise. We present a convolutional neural network model that can successfully identify bugs in C code. We trained our model using two complementary datasets: a machine-labeled dataset created by Draper Labs using three static analyzers and the NIST SATE Juliet human-labeled dataset designed for testing static analyzers. In contrast with the work of Russell et al. on these datasets, we focus on C programs, enabling us to specialize and optimize our detection techniques for this language. After removing duplicates from the dataset, we tokenize the input into 91 token categories. The category values are converted to a binary vector to save memory. Our first convolution layer is chosen so that the entire encoding of the token is presented to the filter. We use two convolution and pooling layers followed by two fully connected layers to classify programs into either a common weakness enumeration category or as ``clean.'' We obtain higher recall than prior work by Russell et al. on this dataset when requiring high precision. We also demonstrate on a custom Linux kernel dataset that we are able to find real vulnerabilities in complex code with a low false-positive rate."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.23121","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":1,"created":"2026-02-27T03:02:54Z","registered":"2026-02-27T03:02:55Z","published":null,"updated":"2026-02-27T03:02:55Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.23120","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.23120","identifiers":[{"identifier":"2602.23120","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Arian","familyName":"Sabaghi","name":"Sabaghi, Arian","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"José","familyName":"Oramas","name":"Oramas, José","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"TriLite: Efficient Weakly Supervised Object Localization with Universal Visual Features and Tri-Region Disentanglement"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-26T15:33:22Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:53:20Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Weakly supervised object localization (WSOL) aims to localize target objects in images using only image-level labels. Despite recent progress, many approaches still rely on multi-stage pipelines or full fine-tuning of large backbones, which increases training cost, while the broader WSOL community continues to face the challenge of partial object coverage. We present TriLite, a single-stage WSOL framework that leverages a frozen Vision Transformer with Dinov2 pre-training in a self-supervised manner, and introduces only a minimal number of trainable parameters (fewer than 800K on ImageNet-1K) for both classification and localization. At its core is the proposed TriHead module, which decomposes patch features into foreground, background, and ambiguous regions, thereby improving object coverage while suppressing spurious activations. By disentangling classification and localization objectives, TriLite effectively exploits the universal representations learned by self-supervised ViTs without requiring expensive end-to-end training. Extensive experiments on CUB-200-2011, ImageNet-1K, and OpenImages demonstrate that TriLite sets a new state of the art, while remaining significantly more parameter-efficient and easier to train than prior methods. The code will be released soon."},{"descriptionType":"Other","description":"This paper consists of 8 pages including 6 figures. Accepted at CVPR 2026"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.23120","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T03:02:52Z","registered":"2026-02-27T03:02:53Z","published":null,"updated":"2026-02-27T03:02:53Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.23115","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.23115","identifiers":[{"identifier":"2602.23115","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"David","familyName":"Dirnfeld","name":"Dirnfeld, David","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Fabien","familyName":"Delattre","name":"Delattre, Fabien","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Pedro","familyName":"Miraldo","name":"Miraldo, Pedro","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Erik","familyName":"Learned-Miller","name":"Learned-Miller, Erik","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"FLIGHT: Fibonacci Lattice-based Inference for Geometric Heading in real-Time"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"Computational Geometry (cs.CG)","lang":"en","subjectScheme":"arXiv"},{"subject":"Robotics (cs.RO)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-26T15:27:49Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:52:57Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Estimating camera motion from monocular video is a fundamental problem in computer vision, central to tasks such as SLAM, visual odometry, and structure-from-motion. Existing methods that recover the camera's heading under known rotation, whether from an IMU or an optimization algorithm, tend to perform well in low-noise, low-outlier conditions, but often decrease in accuracy or become computationally expensive as noise and outlier levels increase. To address these limitations, we propose a novel generalization of the Hough transform on the unit sphere (S(2)) to estimate the camera's heading. First, the method extracts correspondences between two frames and generates a great circle of directions compatible with each pair of correspondences. Then, by discretizing the unit sphere using a Fibonacci lattice as bin centers, each great circle casts votes for a range of directions, ensuring that features unaffected by noise or dynamic objects vote consistently for the correct motion direction. Experimental results on three datasets demonstrate that the proposed method is on the Pareto frontier of accuracy versus efficiency. Additionally, experiments on SLAM show that the proposed method reduces RMSE by correcting the heading during camera pose initialization."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.23115","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T03:02:45Z","registered":"2026-02-27T03:02:46Z","published":null,"updated":"2026-02-27T03:02:46Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.23111","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.23111","identifiers":[{"identifier":"2602.23111","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Yanyi","familyName":"Li","name":"Li, Yanyi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yimu","familyName":"Zhang","name":"Zhang, Yimu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Cong","familyName":"Fang","name":"Fang, Cong","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"PRAC: Principal-Random Subspace for LLM Activation Compression and Memory-Efficient Training"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-26T15:23:34Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:52:41Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Activations have become the primary memory bottleneck in large-batch LLM training. However, existing compression methods fail to exploit the spectral structure of activations, resulting in slow convergence or limited compression. To address this, we bridge the relationship between the algorithm's fast convergence and the requirements for subspace projection, and show that an effective compression should yield an unbiased estimate of the original activation with low variance. We propose Principal-Random Subspace for LLM Activation Compression (PRAC), which novelly decomposes activations into two components: a principal subspace captured via SVD to retain dominant information, and a random subspace sampled from the orthogonal complement to approximate the tail. By introducing a precise scaling factor, we prove that PRAC yields an unbiased gradient estimator with minimum variance under certain conditions. Extensive experiments on pre-training and fine-tuning tasks demonstrate that PRAC achieves up to 36% total memory reduction with negligible performance degradation and minimal computational cost."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.23111","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T03:02:40Z","registered":"2026-02-27T03:02:41Z","published":null,"updated":"2026-02-27T03:02:41Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.23105","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.23105","identifiers":[{"identifier":"2602.23105","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Yusheng","familyName":"Huang","name":"Huang, Yusheng","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Pengbo","familyName":"Xu","name":"Xu, Pengbo","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Shen","familyName":"Wang","name":"Wang, Shen","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Changxin","familyName":"Lao","name":"Lao, Changxin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jiangxia","familyName":"Cao","name":"Cao, Jiangxia","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Shuang","familyName":"Wen","name":"Wen, Shuang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Shuang","familyName":"Yang","name":"Yang, Shuang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zhaojie","familyName":"Liu","name":"Liu, Zhaojie","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Han","familyName":"Li","name":"Li, Han","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Kun","familyName":"Gai","name":"Gai, Kun","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"MaRI: Accelerating Ranking Model Inference via Structural Re-parameterization in Large Scale Recommendation System"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Information Retrieval (cs.IR)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-26T15:19:43Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:52:21Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Ranking models, i.e., coarse-ranking and fine-ranking models, serve as core components in large-scale recommendation systems, responsible for scoring massive item candidates based on user preferences. To meet the stringent latency requirements of online serving, structural lightweighting or knowledge distillation techniques are commonly employed for ranking model acceleration. However, these approaches typically lead to a non-negligible drop in accuracy. Notably, the angle of lossless acceleration by optimizing feature fusion matrix multiplication, particularly through structural reparameterization, remains underexplored. In this paper, we propose MaRI, a novel Matrix Re-parameterized Inference framework, which serves as a complementary approach to existing techniques while accelerating ranking model inference without any accuracy loss. MaRI is motivated by the observation that user-side computation is redundant in feature fusion matrix multiplication, and we therefore adopt the philosophy of structural reparameterization to alleviate such redundancy."},{"descriptionType":"Other","description":"Work in progress"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.23105","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T03:02:32Z","registered":"2026-02-27T03:02:33Z","published":null,"updated":"2026-02-27T03:02:33Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.23093","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.23093","identifiers":[{"identifier":"2602.23093","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Dhwanil M.","familyName":"Mori","name":"Mori, Dhwanil M.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Neil F.","familyName":"Johnson","name":"Johnson, Neil F.","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Three AI-agents walk into a bar . . . . `Lord of the Flies' tribalism emerges among smart AI-Agents"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"Social and Information Networks (cs.SI)","lang":"en","subjectScheme":"arXiv"},{"subject":"Physics and Society (physics.soc-ph)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-26T15:12:26Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:51:43Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Near-future infrastructure systems may be controlled by autonomous AI agents that repeatedly request access to limited resources such as energy, bandwidth, or computing power. We study a simplified version of this setting using a framework where N AI-agents independently decide at each round whether to request one unit from a system with fixed capacity C. An AI version of \"Lord of the Flies\" arises in which controlling tribes emerge with their own collective character and identity. The LLM agents do not reduce overload or improve resource use, and often perform worse than if they were flipping coins to make decisions. Three main tribal types emerge: Aggressive (27.3%), Conservative (24.7%), and Opportunistic (48.1%). The more capable AI-agents actually increase the rate of systemic failure. Overall, our findings show that smarter AI-agents can behave dumber as a result of forming tribes."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.23093","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T03:02:15Z","registered":"2026-02-27T03:02:16Z","published":null,"updated":"2026-02-27T03:02:16Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.23079","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.23079","identifiers":[{"identifier":"2602.23079","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Boyang","familyName":"Zhang","name":"Zhang, Boyang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yang","familyName":"Zhang","name":"Zhang, Yang","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Assessing Deanonymization Risks with Stylometry-Assisted LLM Agent"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"Cryptography and Security (cs.CR)","lang":"en","subjectScheme":"arXiv"},{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-26T15:05:13Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:51:14Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"The rapid advancement of large language models (LLMs) has enabled powerful authorship inference capabilities, raising growing concerns about unintended deanonymization risks in textual data such as news articles. In this work, we introduce an LLM agent designed to evaluate and mitigate such risks through a structured, interpretable pipeline. Central to our framework is the proposed $\\textit{SALA}$ (Stylometry-Assisted LLM Analysis) method, which integrates quantitative stylometric features with LLM reasoning for robust and transparent authorship attribution. Experiments on large-scale news datasets demonstrate that $\\textit{SALA}$, particularly when augmented with a database module, achieves high inference accuracy in various scenarios. Finally, we propose a guided recomposition strategy that leverages the agent's reasoning trace to generate rewriting prompts, effectively reducing authorship identifiability while preserving textual meaning. Our findings highlight both the deanonymization potential of LLM agents and the importance of interpretable, proactive defenses for safeguarding author privacy."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.23079","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T03:01:56Z","registered":"2026-02-27T03:01:56Z","published":null,"updated":"2026-02-27T03:01:56Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.23075","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.23075","identifiers":[{"identifier":"2602.23075","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Mengze","familyName":"Hong","name":"Hong, Mengze","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Di","familyName":"Jiang","name":"Jiang, Di","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Chen Jason","familyName":"Zhang","name":"Zhang, Chen Jason","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zichang","familyName":"Guo","name":"Guo, Zichang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yawen","familyName":"Li","name":"Li, Yawen","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jun","familyName":"Chen","name":"Chen, Jun","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Shaobo","familyName":"Cui","name":"Cui, Shaobo","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zhiyang","familyName":"Su","name":"Su, Zhiyang","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"CiteLLM: An Agentic Platform for Trustworthy Scientific Reference Discovery"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"Information Retrieval (cs.IR)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-26T15:02:22Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:50:44Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Large language models (LLMs) have created new opportunities to enhance the efficiency of scholarly activities; however, challenges persist in the ethical deployment of AI assistance, including (1) the trustworthiness of AI-generated content, (2) preservation of academic integrity and intellectual property, and (3) protection of information privacy. In this work, we present CiteLLM, a specialized agentic platform designed to enable trustworthy reference discovery for grounding author-drafted claims and statements. The system introduces a novel interaction paradigm by embedding LLM utilities directly within the LaTeX editor environment, ensuring a seamless user experience and no data transmission outside the local system. To guarantee hallucination-free references, we employ dynamic discipline-aware routing to retrieve candidates exclusively from trusted web-based academic repositories, while leveraging LLMs solely for generating context-aware search queries, ranking candidates by relevance, and validating and explaining support through paragraph-level semantic matching and an integrated chatbot. Evaluation results demonstrate the superior performance of the proposed system in returning valid and highly usable references."},{"descriptionType":"Other","description":"Accepted by TheWebConf 2026 Demo Track"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.23075","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T03:01:50Z","registered":"2026-02-27T03:01:51Z","published":null,"updated":"2026-02-27T03:01:51Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.23071","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.23071","identifiers":[{"identifier":"2602.23071","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Yuqi","familyName":"Shi","name":"Shi, Yuqi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Hao","familyName":"Yang","name":"Yang, Hao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xiyao","familyName":"Lu","name":"Lu, Xiyao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jinsong","familyName":"Zhang","name":"Zhang, Jinsong","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Quantity Convergence, Quality Divergence: Disentangling Fluency and Accuracy in L2 Mandarin Prosody"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-26T15:00:59Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:50:34Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"While second language (L2) learners may acquire target syntactic word order, mapping this syntax onto appropriate prosodic structures remains a persistent challenge. This study investigates the fossilization and stability of the L2 syntax-prosody interface by comparing 67 native Mandarin speakers with 67 Vietnamese learners using the BLCU-SAIT corpus. By integrating C-ToBI boundary annotation with Dependency Grammar analysis, we examined both the quantity of prosodic boundaries and their mapping to syntactic relations. Results reveal a non-linear acquisition: although high-proficiency learners (VNH) converge to the native baseline in boundary quantity at the Major Phrase level (B3), their structural mapping significantly diverges. Specifically, VNH demote the prosodic boundary at the Subject-Verb (SBV) interface (Major Phrase B3 -\u0026gt; Prosodic Word B1), while erroneously promoting the boundary at the Verb-Object (VOB) interface (Prosodic Word B1 -\u0026gt; Major Phrase B3). This strategy allows learners to maintain high long phrasal output at the expense of structural accuracy. This results in a distorted prosodic hierarchy where the native pattern is inverted."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.23071","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T03:01:45Z","registered":"2026-02-27T03:01:45Z","published":null,"updated":"2026-02-27T03:01:45Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.23070","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.23070","identifiers":[{"identifier":"2602.23070","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Sanjid","familyName":"Hasan","name":"Hasan, Sanjid","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Risalat","familyName":"Labib","name":"Labib, Risalat","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"A H M","familyName":"Fuad","name":"Fuad, A H M","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Bayazid","familyName":"Hasan","name":"Hasan, Bayazid","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Make It Hard to Hear, Easy to Learn: Long-Form Bengali ASR and Speaker Diarization via Extreme Augmentation and Perfect Alignment"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Sound (cs.SD)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"Audio and Speech Processing (eess.AS)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"FOS: Electrical engineering, electronic engineering, information engineering","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Electrical engineering, electronic engineering, information engineering","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-26T14:59:24Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:50:32Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Although Automatic Speech Recognition (ASR) in Bengali has seen significant progress, processing long-duration audio and performing robust speaker diarization remain critical research gaps. To address the severe scarcity of joint ASR and diarization resources for this language, we introduce Lipi-Ghor-882, a comprehensive 882-hour multi-speaker Bengali dataset. In this paper, detailing our submission to the DL Sprint 4.0 competition, we systematically evaluate various architectures and approaches for long-form Bengali speech. For ASR, we demonstrate that raw data scaling is ineffective; instead, targeted fine-tuning utilizing perfectly aligned annotations paired with synthetic acoustic degradation (noise and reverberation) emerges as the singular most effective approach. Conversely, for speaker diarization, we observed that global open-source state-of-the-art models (such as Diarizen) performed surprisingly poorly on this complex dataset. Extensive model retraining yielded negligible improvements; instead, strategic, heuristic post-processing of baseline model outputs proved to be the primary driver for increasing accuracy. Ultimately, this work outlines a highly optimized dual pipeline achieving a $\\sim$0.019 Real-Time Factor (RTF), establishing a practical, empirically backed benchmark for low-resource, long-form speech processing."},{"descriptionType":"Other","description":"4 pages, 2 figures"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.23070","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T03:01:43Z","registered":"2026-02-27T03:01:44Z","published":null,"updated":"2026-02-27T03:01:44Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.23068","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.23068","identifiers":[{"identifier":"2602.23068","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Trung","familyName":"Dang","name":"Dang, Trung","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Sharath","familyName":"Rao","name":"Rao, Sharath","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ananya","familyName":"Gupta","name":"Gupta, Ananya","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Christopher","familyName":"Gagne","name":"Gagne, Christopher","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Panagiotis","familyName":"Tzirakis","name":"Tzirakis, Panagiotis","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Alice","familyName":"Baird","name":"Baird, Alice","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jakub Piotr","familyName":"Cłapa","name":"Cłapa, Jakub Piotr","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Peter","familyName":"Chin","name":"Chin, Peter","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Alan","familyName":"Cowen","name":"Cowen, Alan","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"TADA: A Generative Framework for Speech Modeling via Text-Acoustic Dual Alignment"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Sound (cs.SD)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-26T14:57:29Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:50:28Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Modern Text-to-Speech (TTS) systems increasingly leverage Large Language Model (LLM) architectures to achieve scalable, high-fidelity, zero-shot generation. However, these systems typically rely on fixed-frame-rate acoustic tokenization, resulting in speech sequences that are significantly longer than, and asynchronous with their corresponding text. Beyond computational inefficiency, this sequence length disparity often triggers hallucinations in TTS and amplifies the modality gap in spoken language modeling (SLM). In this paper, we propose a novel tokenization scheme that establishes one-to-one synchronization between continuous acoustic features and text tokens, enabling unified, single-stream modeling within an LLM. We demonstrate that these synchronous tokens maintain high-fidelity audio reconstruction and can be effectively modeled in a latent space by a large language model with a flow matching head. Moreover, the ability to seamlessly toggle speech modality within the context enables text-only guidance--a technique that blends logits from text-only and text-speech modes to flexibly bridge the gap toward text-only LLM intelligence. Experimental results indicate that our approach achieves performance competitive with state-of-the-art TTS and SLM systems while virtually eliminating content hallucinations and preserving linguistic integrity, all at a significantly reduced inference cost."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.23068","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T03:01:40Z","registered":"2026-02-27T03:01:41Z","published":null,"updated":"2026-02-27T03:01:41Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.23062","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.23062","identifiers":[{"identifier":"2602.23062","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Gabriela Anna","familyName":"Kaczmarek","name":"Kaczmarek, Gabriela Anna","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Pietro","familyName":"Ferrazzi","name":"Ferrazzi, Pietro","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Lorenzo","familyName":"Porta","name":"Porta, Lorenzo","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Vicky","familyName":"Rubini","name":"Rubini, Vicky","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Bernardo","familyName":"Magnini","name":"Magnini, Bernardo","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Toward Automatic Filling of Case Report Forms: A Case Study on Data from an Italian Emergency Department"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-26T14:49:11Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:49:59Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Case Report Forms (CRFs) collect data about patients and are at the core of well-established practices to conduct research in clinical settings. With the recent progress of language technologies, there is an increasing interest in automatic CRF-filling from clinical notes, mostly based on the use of Large Language Models (LLMs). However, there is a general scarcity of annotated CRF data, both for training and testing LLMs, which limits the progress on this task. As a step in the direction of providing such data, we present a new dataset of clinical notes from an Italian Emergency Department annotated with respect to a pre-defined CRF containing 134 items to be filled. We provide an analysis of the data, define the CRF-filling task and metric for its evaluation, and report on pilot experiments where we use an open-source state-of-the-art LLM to automatically execute the task. Results of the case-study show that (i) CRF-filling from real clinical notes in Italian can be approached in a zero-shot setting; (ii) LLMs' results are affected by biases (e.g., a cautious behaviour favours \"unknown\" answers), which need to be corrected."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.23062","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T03:01:32Z","registered":"2026-02-27T03:01:32Z","published":null,"updated":"2026-02-27T03:01:32Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.23060","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.23060","identifiers":[{"identifier":"2602.23060","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Xin","familyName":"Wang","name":"Wang, Xin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Burcu","familyName":"Ozek","name":"Ozek, Burcu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Aruna","familyName":"Mohan","name":"Mohan, Aruna","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Amirhossein","familyName":"Ravari","name":"Ravari, Amirhossein","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Or","familyName":"Zilbershot","name":"Zilbershot, Or","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Fatemeh","familyName":"Afghah","name":"Afghah, Fatemeh","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"RhythmBERT: A Self-Supervised Language Model Based on Latent Representations of ECG Waveforms for Heart Disease Detection"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-26T14:45:29Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:49:41Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Electrocardiogram (ECG) analysis is crucial for diagnosing heart disease, but most self-supervised learning methods treat ECG as a generic time series, overlooking physiologic semantics and rhythm-level structure. Existing contrastive methods utilize augmentations that distort morphology, whereas generative approaches employ fixed-window segmentation, which misaligns cardiac cycles. To address these limitations, we propose RhythmBERT, a generative ECG language model that considers ECG as a language paradigm by encoding P, QRS, and T segments into symbolic tokens via autoencoder-based latent representations. These discrete tokens capture rhythm semantics, while complementary continuous embeddings retain fine-grained morphology, enabling a unified view of waveform structure and rhythm. RhythmBERT is pretrained on approximately 800,000 unlabeled ECG recordings with a masked prediction objective, allowing it to learn contextual representations in a label-efficient manner. Evaluations show that despite using only a single lead, RhythmBERT achieves comparable or superior performance to strong 12-lead baselines. This generalization extends from prevalent conditions such as atrial fibrillation to clinically challenging cases such as subtle ST-T abnormalities and myocardial infarction. Our results suggest that considering ECG as structured language offers a scalable and physiologically aligned pathway for advancing cardiac analysis."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.23060","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T03:01:29Z","registered":"2026-02-27T03:01:30Z","published":null,"updated":"2026-02-27T03:01:30Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.23057","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.23057","identifiers":[{"identifier":"2602.23057","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Jeongin","familyName":"Bae","name":"Bae, Jeongin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Baeseong","familyName":"Park","name":"Park, Baeseong","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Gunho","familyName":"Park","name":"Park, Gunho","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Minsub","familyName":"Kim","name":"Kim, Minsub","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Joonhyung","familyName":"Lee","name":"Lee, Joonhyung","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Junhee","familyName":"Yoo","name":"Yoo, Junhee","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Sunghyeon","familyName":"Woo","name":"Woo, Sunghyeon","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jiwon","familyName":"Ryu","name":"Ryu, Jiwon","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Se Jung","familyName":"Kwon","name":"Kwon, Se Jung","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Dongsoo","familyName":"Lee","name":"Lee, Dongsoo","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Affine-Scaled Attention: Towards Flexible and Stable Transformer Attention"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-26T14:42:16Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:49:32Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Transformer attention is typically implemented using softmax normalization, which enforces attention weights with unit sum normalization. While effective in many settings, this constraint can limit flexibility in controlling attention magnitudes and may contribute to overly concentrated or unstable attention patterns during training. Prior work has explored modifications such as attention sinks or gating mechanisms, but these approaches provide only limited or indirect control over attention reweighting. We propose Affine-Scaled Attention, a simple extension to standard attention that introduces input-dependent scaling and a corresponding bias term applied to softmax-normalized attention weights. This design relaxes the strict normalization constraint while maintaining aggregation of value representations, allowing the model to adjust both the relative distribution and the scale of attention in a controlled manner.\n We empirically evaluate Affine-Scaled Attention in large-scale language model pretraining across multiple model sizes. Experimental results show consistent improvements in training stability, optimization behavior, and downstream task performance compared to standard softmax attention and attention sink baselines. These findings suggest that modest reweighting of attention outputs provides a practical and effective way to improve attention behavior in Transformer models."},{"descriptionType":"Other","description":"Preprint. 14 pages, 11 figures"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.23057","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T03:01:25Z","registered":"2026-02-27T03:01:26Z","published":null,"updated":"2026-02-27T03:01:26Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.23048","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.23048","identifiers":[{"identifier":"2602.23048","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Abhishek","familyName":"Sadhu","name":"Sadhu, Abhishek","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Sharu Theresa","familyName":"Jose","name":"Jose, Sharu Theresa","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Cryptographic Fragility of Standard Quantum Repeater Protocols"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Quantum Physics (quant-ph)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-26T14:30:03Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:48:54Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"The security of the proposed quantum Internet relies on repeater protocols designed under the assumption of stochastic, characterizable noise. We demonstrate that in adversarial environments this assumption induces performance vulnerabilities for computationally bounded repeater nodes. We show that the standard BBPSSW distillation protocol recursively purifies error syndromes rather than entanglement. This leads to a state of low fidelity despite diagnostic metrics indicating perfect convergence. Moreover, we show that the verifier cannot check the adversarial influence via the maximum likelihood estimation algorithm since it is blind to computationally bounded observers. To address these vulnerabilities, we propose a Cryptographic Network Stack centered on a trapdoor verification protocol. The protocol exploits private randomness to restore operational stability without requiring channel characterization."},{"descriptionType":"Other","description":"7 pages. Comments are welcome"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.23048","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T03:01:12Z","registered":"2026-02-27T03:01:13Z","published":null,"updated":"2026-02-27T03:01:13Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.23045","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.23045","identifiers":[{"identifier":"2602.23045","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Siyan","familyName":"Liu","name":"Liu, Siyan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Qinglong","familyName":"Tian","name":"Tian, Qinglong","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Chunlin","familyName":"Wang","name":"Wang, Chunlin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Pengfei","familyName":"Li","name":"Li, Pengfei","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Semiparametric Joint Inference for Sensitivity and Specificity at the Youden-Optimal Cut-Off"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Methodology (stat.ME)","lang":"en","subjectScheme":"arXiv"},{"subject":"Statistics Theory (math.ST)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-26T14:28:20Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:48:48Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Sensitivity and specificity evaluated at an optimal diagnostic cut-off are fundamental measures of classification accuracy when continuous biomarkers are used for disease diagnosis. Joint inference for these quantities is challenging because their estimators are evaluated at a common, data-driven threshold estimated from both diseased and healthy samples, inducing statistical dependence. Existing approaches are largely based on parametric assumptions or fully nonparametric procedures, which may be sensitive to model misspecification or lack efficiency in moderate samples. We propose a semiparametric framework for joint inference on sensitivity and specificity at the Youden-optimal cut-off under the density ratio model. Using maximum empirical likelihood, we derive estimators of the optimal threshold and the corresponding sensitivity and specificity, and establish their joint asymptotic normality. This leads to Wald-type and range-preserving logit-transformed confidence regions. Simulation studies show that the proposed method achieves accurate coverage with improved efficiency relative to existing parametric and nonparametric alternatives across a variety of distributional settings. An analysis of COVID-19 antibody data demonstrates the practical advantages of the proposed approach for diagnostic decision-making."},{"descriptionType":"Other","description":"23 pages, 2 figures, 6 tables"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.23045","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T03:01:08Z","registered":"2026-02-27T03:01:09Z","published":null,"updated":"2026-02-27T03:01:09Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.23043","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.23043","identifiers":[{"identifier":"2602.23043","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Argo","familyName":"Saakyan","name":"Saakyan, Argo","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Dmitry","familyName":"Solntsev","name":"Solntsev, Dmitry","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"D-FINE-seg: Object Detection and Instance Segmentation Framework with multi-backend deployment"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-26T14:26:49Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:48:41Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Transformer-based real-time object detectors achieve strong accuracy-latency trade-offs, and D-FINE is among the top-performing recent architectures. However, real-time instance segmentation with transformers is still less common. We present D-FINE-seg, an instance segmentation extension of D-FINE that adds: a lightweight mask head, segmentation-aware training, including box cropped BCE and dice mask losses, auxiliary and denoising mask supervision, and adapted Hungarian matching cost. On the TACO dataset, D-FINE-seg improves F1-score over Ultralytics YOLO26 under a unified TensorRT FP16 end-to-end benchmarking protocol, while maintaining competitive latency. Second contribution is an end-to-end pipeline for training, exporting, and optimized inference across ONNX, TensorRT, OpenVINO for both object detection and instance segmentation tasks. This framework is released as open-source under the Apache-2.0 license. GitHub repository - https://github.com/ArgoHA/D-FINE-seg."},{"descriptionType":"Other","description":"6 pages, 4 figures, 5 tables"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.23043","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T03:01:05Z","registered":"2026-02-27T03:01:06Z","published":null,"updated":"2026-02-27T03:01:06Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.23005","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.23005","identifiers":[{"identifier":"2602.23005","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Man","familyName":"Zhang","name":"Zhang, Man","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Tao","familyName":"Yue","name":"Yue, Tao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yihua","familyName":"He","name":"He, Yihua","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Managing Uncertainty in LLM-based Multi-Agent System Operation"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Software Engineering (cs.SE)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-26T13:49:16Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:46:48Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Applying LLM-based multi-agent software systems in safety-critical domains such as lifespan echocardiography introduces system-level risks that cannot be addressed by improving model accuracy alone. During system operation, beyond individual LLM behavior, uncertainty propagates through agent coordination, data pipelines, human-in-the-loop interaction, and runtime control logic. Yet existing work largely treats uncertainty at the model level rather than as a first-class software engineering concern. This paper approaches uncertainty from both system-level and runtime perspectives. We first differentiate epistemological and ontological uncertainties in the context of LLM-based multi-agent software system operation. Building on this foundation, we propose a lifecycle-based uncertainty management framework comprising four mechanisms: representation, identification, evolution, and adaptation. The uncertainty lifecycle governs how uncertainties emerge, transform, and are mitigated across architectural layers and execution phases, enabling structured runtime governance and controlled adaptation. We demonstrate the feasibility of the framework using a real-world LLM-based multi-agent echocardiographic software system developed in clinical collaboration, showing improved reliability and diagnosability in diagnostic reasoning. The proposed approach generalizes to other safety-critical LLM-based multi-agent software systems, supporting principled operational control and runtime assurance beyond model-centric methods."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.23005","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T03:00:11Z","registered":"2026-02-27T03:00:12Z","published":null,"updated":"2026-02-27T03:00:12Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.23003","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.23003","identifiers":[{"identifier":"2602.23003","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"René","familyName":"Pallenberg","name":"Pallenberg, René","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Fabrice","familyName":"Katzberg","name":"Katzberg, Fabrice","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Alfred","familyName":"Mertins","name":"Mertins, Alfred","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Marco","familyName":"Maass","name":"Maass, Marco","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Scattering Transform for Auditory Attention Decoding"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Signal Processing (eess.SP)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"Audio and Speech Processing (eess.AS)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Electrical engineering, electronic engineering, information engineering","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Electrical engineering, electronic engineering, information engineering","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-26T13:48:27Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:46:45Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"The use of hearing aids will increase in the coming years due to demographic change. One open problem that remains to be solved by a new generation of hearing aids is the cocktail party problem. A possible solution is electroencephalography-based auditory attention decoding. This has been the subject of several studies in recent years, which have in common that they use the same preprocessing methods in most cases. In this work, in order to achieve an advantage, the use of a scattering transform is proposed as an alternative to these preprocessing methods. The two-layer scattering transform is compared with a regular filterbank, the synchrosqueezing short-time Fourier transform and the common preprocessing. To demonstrate the performance, the known and the proposed preprocessing methods are compared for different classification tasks on two widely used datasets, provided by the KU Leuven (KUL) and the Technical University of Denmark (DTU). Both established and new neural-network-based models, CNNs, LSTMs, and recent Transformer/graph-based models are used for classification. Various evaluation strategies were compared, with a focus on the task of classifying speakers who are unknown from the training. We show that the two-layer scattering transform can significantly improve the performance for subject-related conditions, especially on the KUL dataset. However, on the DTU dataset, this only applies to some of the models, or when larger amounts of training data are provided, as in 10-fold cross-validation. This suggests that the scattering transform is capable of extracting additional relevant information."},{"descriptionType":"Other","description":"This work has been submitted to the IEEE for possible publication"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.23003","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T03:00:08Z","registered":"2026-02-27T03:00:09Z","published":null,"updated":"2026-02-27T03:00:09Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.22998","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.22998","identifiers":[{"identifier":"2602.22998","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Ryan Paul","familyName":"McKennaa","name":"McKennaa, Ryan Paul","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"John","familyName":"Oyekan","name":"Oyekan, John","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"A Perspective on Open Challenges in Deformable Object Manipulation"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Robotics (cs.RO)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-26T13:39:30Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:46:08Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Deformable object manipulation (DOM) represents a critical challenge in robotics, with applications spanning healthcare, manufacturing, food processing, and beyond. Unlike rigid objects, deformable objects exhibit infinite dimensionality, dynamic shape changes, and complex interactions with their environment, posing significant hurdles for perception, modeling, and control. This paper reviews the state of the art in DOM, focusing on key challenges such as occlusion handling, task generalization, and scalable, real-time solutions. It highlights advancements in multimodal perception systems, including the integration of multi-camera setups, active vision, and tactile sensing, which collectively address occlusion and improve adaptability in unstructured environments. Cutting-edge developments in physically informed reinforcement learning (RL) and differentiable simulations are explored, showcasing their impact on efficiency, precision, and scalability. The review also emphasizes the potential of simulated expert demonstrations and generative neural networks to standardize task specifications and bridge the simulation-to-reality gap. Finally, future directions are proposed, including the adoption of graph neural networks for high-level decision-making and the creation of comprehensive datasets to enhance DOM's real-world applicability. By addressing these challenges, DOM research can pave the way for versatile robotic systems capable of handling diverse and dynamic tasks with deformable objects."},{"descriptionType":"Other","description":"28 pages, 7 Figures"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.22998","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T03:00:00Z","registered":"2026-02-27T03:00:01Z","published":null,"updated":"2026-02-27T03:00:01Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.22991","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.22991","identifiers":[{"identifier":"2602.22991","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Alexander","familyName":"Bonora","name":"Bonora, Alexander","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Anna V.","familyName":"Guglielmi","name":"Guglielmi, Anna V.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Davide","familyName":"Scazzoli","name":"Scazzoli, Davide","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Marco","familyName":"Giordani","name":"Giordani, Marco","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Maurizio","familyName":"Magarini","name":"Magarini, Maurizio","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Vineeth","familyName":"Teeda","name":"Teeda, Vineeth","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Stefano","familyName":"Tomasin","name":"Tomasin, Stefano","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Digital Twin-Based Beamforming for Interference Mitigation in AF Relay MIMO Systems"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Signal Processing (eess.SP)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Electrical engineering, electronic engineering, information engineering","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Electrical engineering, electronic engineering, information engineering","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-26T13:35:26Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:45:57Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Beamforming in multiple-input multiple-output (MIMO) systems should take interference mitigation into account. However, for beamform design, accurate channel state information (CSI) is needed, which is often difficult to obtain due to channel variability, feedback overhead, or hardware constraints. For example, amplify-and-forward (AF) relays passively forward signals without measurement, precluding full CSI acquisition to and from the relay. To address these issues, this paper introduces a novel prediction-assisted optimization (PAO) framework for beamform design in AF relay-assisted multiuser MIMO systems. The proposed solution in the AF relay aims at maximizing the signal-plus-interference-to-noise ratio (SINR). Unlike other methods, PAO relies solely on received power measurements, making it suitable for scenarios where CSI is unreliable or unavailable. PAO consists of two stages: a supervised-learning-based neural network (NN) that predicts the positions of transmitters using signal observations, and an optimization algorithm, guided by a digital twin (DT), that iteratively refines the beam direction of the relay in a simulated radio environment. As a key contribution, we validate the proposed framework using realistic measurements collected on a custom-built experimental millimeter wave (mmWave) platform, which enables training of the NN model under practical wireless conditions. The estimated information is then used to update the digital twin with knowledge of the surrounding environment, enabling online optimization. Numerical results show the trade-off between localization accuracy and beamforming performance and confirm that PAO maintains robustness even in the presence of localization errors while reducing the need for real-world measurements."},{"descriptionType":"Other","description":"12 pages, 13 figures, 1 table. Submitted to IEEE Special Issue on \"Digital Twins for Wireless Networks: Enabling Application-Aware and Closed-Loop Optimization\""}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.22991","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T02:59:49Z","registered":"2026-02-27T02:59:50Z","published":null,"updated":"2026-02-27T02:59:50Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.22988","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.22988","identifiers":[{"identifier":"2602.22988","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Bum Jun","familyName":"Kim","name":"Kim, Bum Jun","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Shohei","familyName":"Taniguchi","name":"Taniguchi, Shohei","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Makoto","familyName":"Kawano","name":"Kawano, Makoto","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yusuke","familyName":"Iwasawa","name":"Iwasawa, Yusuke","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yutaka","familyName":"Matsuo","name":"Matsuo, Yutaka","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Residual Koopman Spectral Profiling for Predicting and Preventing Transformer Training Instability"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-26T13:33:25Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:45:38Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Training divergence in transformers wastes compute, yet practitioners discover instability only after expensive runs begin. They therefore need an expected probability of failure for a transformer before training starts. Our study of Residual Koopman Spectral Profiling (RKSP) provides such an estimate. From a single forward pass at initialization, RKSP extracts Koopman spectral features by applying whitened dynamic mode decomposition to layer-wise residual snapshots. Our central diagnostic, the near-unit spectral mass, quantifies the fraction of modes concentrated near the unit circle, which captures instability risk. For predicting divergence across extensive configurations, this estimator achieves an AUROC of 0.995, outperforming the best gradient baseline. We further make this diagnostic actionable through Koopman Spectral Shaping (KSS), which reshapes spectra during training. We empirically validate that our method works in practice: RKSP predicts divergence at initialization, and when RKSP flags high risk, turning on KSS successfully prevents divergence. In the challenging high learning rate regime without normalization layers, KSS reduces the divergence rate from 66.7% to 12.5% and enables learning rates that are 50% to 150% higher. These findings generalize to WikiText-103 language modeling, vision transformers on CIFAR-10, and pretrained language models, including GPT-2 and LLaMA-2 up to 7B, as well as emerging architectures such as MoE, Mamba-style SSMs, and KAN."},{"descriptionType":"Other","description":"23 pages, 7 figures"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.22988","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T02:59:45Z","registered":"2026-02-27T02:59:45Z","published":null,"updated":"2026-02-27T02:59:45Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.22975","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.22975","identifiers":[{"identifier":"2602.22975","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Stefanie","familyName":"Peschel","name":"Peschel, Stefanie","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Anne-Laure","familyName":"Boulesteix","name":"Boulesteix, Anne-Laure","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Erika","familyName":"von Mutius","name":"von Mutius, Erika","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Christian L.","familyName":"Müller","name":"Müller, Christian L.","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"permApprox: a general framework for accurate permutation p-value approximation"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Methodology (stat.ME)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-26T13:15:18Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:44:46Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Permutation procedures are common practice in hypothesis testing when distributional assumptions about the test statistic are not met or unknown. With only few permutations, empirical p-values lie on a coarse grid and may even be zero when the observed test statistic exceeds all permuted values. Such zero p-values are statistically invalid and hinder multiple testing correction. Parametric tail modeling with the Generalized Pareto Distribution (GPD) has been proposed to address this issue, but existing implementations can again yield zero p-values when the estimated shape parameter is negative and the fitted distribution has a finite upper bound.\n We introduce a method for accurate and zero-free p-value approximation in permutation testing, embedded in the permApprox workflow and R package. Building on GPD tail modeling, the method enforces a support constraint during parameter estimation to ensure valid extrapolation beyond the observed statistic, thereby strictly avoiding zero p-values. The workflow further integrates robust parameter estimation, data-driven threshold selection, and principled handling of hybrid p-values that are discrete in the bulk and continuous in the extreme tail.\n Extensive simulations using two-sample t-tests and Wilcoxon rank-sum tests show that permApprox produces accurate, robust, and zero-free p-value approximations across a wide range of sample and effect sizes. Applications to single-cell RNA-seq and microbiome data demonstrate its practical utility: permApprox yields smooth and interpretable p-value distributions even with few permutations. By resolving the zero-p-value problem while preserving accuracy and computational efficiency, permApprox enables reliable permutation-based inference in high-dimensional and computationally intensive settings."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.22975","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T02:59:24Z","registered":"2026-02-27T02:59:25Z","published":null,"updated":"2026-02-27T02:59:25Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.22974","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.22974","identifiers":[{"identifier":"2602.22974","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"L.","familyName":"Martino","name":"Martino, L.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"M. M.","familyName":"Garcia","name":"Garcia, M. M.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"P. S.","familyName":"Paradas","name":"Paradas, P. S.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"E.","familyName":"Curbelo","name":"Curbelo, E.","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"An automatic counting algorithm for the quantification and uncertainty analysis of the number of microglial cells trainable in small and heterogeneous datasets"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Computational Engineering, Finance, and Science (cs.CE)","lang":"en","subjectScheme":"arXiv"},{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"Image and Video Processing (eess.IV)","lang":"en","subjectScheme":"arXiv"},{"subject":"Signal Processing (eess.SP)","lang":"en","subjectScheme":"arXiv"},{"subject":"Machine Learning (stat.ML)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"FOS: Electrical engineering, electronic engineering, information engineering","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Electrical engineering, electronic engineering, information engineering","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-26T13:13:43Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:44:45Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[{"relationType":"IsVersionOf","relatedIdentifier":"10.1016/j.eswa.2025.129208","relatedIdentifierType":"DOI"}],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Counting immunopositive cells on biological tissues generally requires either manual annotation or (when available) automatic rough systems, for scanning signal surface and intensity in whole slide imaging. In this work, we tackle the problem of counting microglial cells in lumbar spinal cord cross-sections of rats by omitting cell detection and focusing only on the counting task. Manual cell counting is, however, a time-consuming task and additionally entails extensive personnel training. The classic automatic color-based methods roughly inform about the total labeled area and intensity (protein quantification) but do not specifically provide information on cell number. Since the images to be analyzed have a high resolution but a huge amount of pixels contain just noise or artifacts, we first perform a pre-processing generating several filtered images {(providing a tailored, efficient feature extraction)}. Then, we design an automatic kernel counter that is a non-parametric and non-linear method. The proposed scheme can be easily trained in small datasets since, in its basic version, it relies only on one hyper-parameter. However, being non-parametric and non-linear, the proposed algorithm is flexible enough to express all the information contained in rich and heterogeneous datasets as well (providing the maximum overfit if required). Furthermore, the proposed kernel counter also provides uncertainty estimation of the given prediction, and can directly tackle the case of receiving several expert opinions over the same image. Different numerical experiments with artificial and real datasets show very promising results. Related Matlab code is also provided."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.22974","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":1,"created":"2026-02-27T02:59:23Z","registered":"2026-02-27T02:59:23Z","published":null,"updated":"2026-02-27T02:59:23Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.22973","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.22973","identifiers":[{"identifier":"2602.22973","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Dimitrios P.","familyName":"Panagoulias","name":"Panagoulias, Dimitrios P.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Evangelia-Aikaterini","familyName":"Tsichrintzi","name":"Tsichrintzi, Evangelia-Aikaterini","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Georgios","familyName":"Savvidis","name":"Savvidis, Georgios","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Evridiki","familyName":"Tsoureli-Nikita","name":"Tsoureli-Nikita, Evridiki","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Modeling Expert AI Diagnostic Alignment via Immutable Inference Snapshots"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-26T13:11:58Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:44:38Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Human-in-the-loop validation is essential in safety-critical clinical AI, yet the transition between initial model inference and expert correction is rarely analyzed as a structured signal. We introduce a diagnostic alignment framework in which the AI-generated image based report is preserved as an immutable inference state and systematically compared with the physician-validated outcome. The inference pipeline integrates a vision-enabled large language model, BERT- based medical entity extraction, and a Sequential Language Model Inference (SLMI) step to enforce domain-consistent refinement prior to expert review. Evaluation on 21 dermatological cases (21 complete AI physician pairs) em- ployed a four-level concordance framework comprising exact primary match rate (PMR), semantic similarity-adjusted rate (AMR), cross-category alignment, and Comprehensive Concordance Rate (CCR). Exact agreement reached 71.4% and remained unchanged under semantic similarity (t = 0.60), while structured cross-category and differential overlap analysis yielded 100% comprehensive concordance (95% CI: [83.9%, 100%]). No cases demonstrated complete diagnostic divergence. These findings show that binary lexical evaluation substantially un- derestimates clinically meaningful alignment. Modeling expert validation as a structured transformation enables signal-aware quantification of correction dynamics and supports traceable, human aligned evaluation of image based clinical decision support systems."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.22973","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T02:59:21Z","registered":"2026-02-27T02:59:22Z","published":null,"updated":"2026-02-27T02:59:22Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.22967","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.22967","identifiers":[{"identifier":"2602.22967","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Yifeng","familyName":"Guan","name":"Guan, Yifeng","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Chuyi","familyName":"Liu","name":"Liu, Chuyi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Dongzhan","familyName":"Zhou","name":"Zhou, Dongzhan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Lei","familyName":"Bai","name":"Bai, Lei","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Wan-jian","familyName":"Yin","name":"Yin, Wan-jian","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jingyuan","familyName":"Li","name":"Li, Jingyuan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Mao","familyName":"Su","name":"Su, Mao","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Discovery of Interpretable Physical Laws in Materials via Language-Model-Guided Symbolic Regression"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Computational Physics (physics.comp-ph)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-26T13:05:05Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:44:20Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Discovering interpretable physical laws from high-dimensional data is a fundamental challenge in scientific research. Traditional methods, such as symbolic regression, often produce complex, unphysical formulas when searching a vast space of possible forms. We introduce a framework that guides the search process by leveraging the embedded scientific knowledge of large language models, enabling efficient identification of physical laws in the data. We validate our approach by modeling key properties of perovskite materials. Our method mitigates the combinatorial explosion commonly encountered in traditional symbolic regression, reducing the effective search space by a factor of approximately $10^5$. A set of novel formulas for bulk modulus, band gap, and oxygen evolution reaction activity are identified, which not only provide meaningful physical insights but also outperform previous formulas in accuracy and simplicity."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.22967","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T02:59:12Z","registered":"2026-02-27T02:59:12Z","published":null,"updated":"2026-02-27T02:59:12Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.22963","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.22963","identifiers":[{"identifier":"2602.22963","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Zehao","familyName":"Li","name":"Li, Zehao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Hongwei","familyName":"Yu","name":"Yu, Hongwei","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Hao","familyName":"Jiang","name":"Jiang, Hao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Qiang","familyName":"Sheng","name":"Sheng, Qiang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yilong","familyName":"Xu","name":"Xu, Yilong","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Baolong","familyName":"Bi","name":"Bi, Baolong","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yang","familyName":"Li","name":"Li, Yang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zhenlong","familyName":"Yuan","name":"Yuan, Zhenlong","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yujun","familyName":"Cai","name":"Cai, Yujun","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zhaoqi","familyName":"Wang","name":"Wang, Zhaoqi","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"FactGuard: Agentic Video Misinformation Detection via Reinforcement Learning"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-26T13:00:31Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:44:12Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Multimodal large language models (MLLMs) have substantially advanced video misinformation detection through unified multimodal reasoning, but they often rely on fixed-depth inference and place excessive trust in internally generated assumptions, particularly in scenarios where critical evidence is sparse, fragmented, or requires external verification. To address these limitations, we propose FactGuard, an agentic framework for video misinformation detection that formulates verification as an iterative reasoning process built upon MLLMs. FactGuard explicitly assesses task ambiguity and selectively invokes external tools to acquire critical evidence, enabling progressive refinement of reasoning trajectories. To further strengthen this capability, we introduce a two-stage training strategy that combines domain-specific agentic supervised fine-tuning with decision-aware reinforcement learning to optimize tool usage and calibrate risk-sensitive decision making. Extensive experiments on FakeSV, FakeTT, and FakeVV demonstrate FactGuard's state-of-the-art performance and validate its excellent robustness and generalization capacity."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.22963","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T02:59:06Z","registered":"2026-02-27T02:59:07Z","published":null,"updated":"2026-02-27T02:59:07Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.22958","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.22958","identifiers":[{"identifier":"2602.22958","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Maximilian","familyName":"Kalcher","name":"Kalcher, Maximilian","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Frequency-Ordered Tokenization for Better Text Compression"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Information Theory (cs.IT)","lang":"en","subjectScheme":"arXiv"},{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"E.4; I.2.7","lang":"en","subjectScheme":"ACM"},{"subject":"68P30","lang":"en","subjectScheme":"MSC"}],"contributors":[],"dates":[{"date":"2026-02-26T12:53:48Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:43:51Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"We present frequency-ordered tokenization, a simple preprocessing technique that improves lossless text compression by exploiting the power-law frequency distribution of natural language tokens (Zipf's law). The method tokenizes text with Byte Pair Encoding (BPE), reorders the vocabulary so that frequent tokens receive small integer identifiers, and encodes the result with variable-length integers before passing it to any standard compressor. On enwik8 (100 MB Wikipedia), this yields improvements of 7.08 percentage points (pp) for zlib, 1.69 pp for LZMA, and 0.76 pp for zstd (all including vocabulary overhead), outperforming the classical Word Replacing Transform. Gains are consistent at 1 GB scale (enwik9) and across Chinese and Arabic text. We further show that preprocessing accelerates compression for computationally expensive algorithms: the total wall-clock time including preprocessing is 3.1x faster than raw zstd-22 and 2.4x faster than raw LZMA, because the preprocessed input is substantially smaller. The method can be implemented in under 50 lines of code."},{"descriptionType":"Other","description":"5 pages, 4 figures, 9 tables"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.22958","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T02:58:58Z","registered":"2026-02-27T02:58:59Z","published":null,"updated":"2026-02-27T02:58:59Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.22937","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.22937","identifiers":[{"identifier":"2602.22937","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Suresan","familyName":"Pareth","name":"Pareth, Suresan","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"MSINO: Curvature-Aware Sobolev Optimization for Manifold Neural Networks"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"49M07, 53C21, 46E35","lang":"en","subjectScheme":"MSC"}],"contributors":[],"dates":[{"date":"2026-02-26T12:27:00Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:42:44Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"We introduce Manifold Sobolev Informed Neural Optimization (MSINO), a curvature aware training framework for neural networks defined on Riemannian manifolds. The method replaces standard Euclidean derivative supervision with a covariant Sobolev loss that aligns gradients using parallel transport and improves stability via a Laplace Beltrami smoothness regularization term.\n Building on classical results in Riemannian optimization and Sobolev theory on manifolds, we derive geometry dependent constants that yield (i) a Descent Lemma with a manifold Sobolev smoothness constant, (ii) a Sobolev Polyak Lojasiewicz inequality giving linear convergence guarantees for Riemannian gradient descent and stochastic gradient descent under explicit step size bounds, and (iii) a two step Newton Sobolev method with local quadratic contraction in curvature controlled neighborhoods.\n Unlike prior Sobolev training in Euclidean space, MSINO provides training time guarantees that explicitly track curvature and transported Jacobians. Applications include surface imaging, physics informed learning settings, and robotics on Lie groups such as SO(3) and SE(3). The framework unifies value and gradient based learning with curvature aware convergence guarantees for neural training on manifolds."},{"descriptionType":"Other","description":"32 pages, 6 figures. Submitted for journal consideration"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.22937","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T02:58:25Z","registered":"2026-02-27T02:58:26Z","published":null,"updated":"2026-02-27T02:58:26Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.22936","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.22936","identifiers":[{"identifier":"2602.22936","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Wenquan","familyName":"Ma","name":"Ma, Wenquan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yang","familyName":"Sui","name":"Sui, Yang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jiaye","familyName":"Teng","name":"Teng, Jiaye","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Bohan","familyName":"Wang","name":"Wang, Bohan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jing","familyName":"Xu","name":"Xu, Jing","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jingqin","familyName":"Yang","name":"Yang, Jingqin","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Generalization Bounds of Stochastic Gradient Descent in Homogeneous Neural Networks"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-26T12:26:32Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:42:43Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Algorithmic stability is among the most potent techniques in generalization analysis. However, its derivation usually requires a stepsize $η_t = \\mathcal{O}(1/t)$ under non-convex training regimes, where $t$ denotes iterations. This rigid decay of the stepsize potentially impedes optimization and may not align with practical scenarios. In this paper, we derive the generalization bounds under the homogeneous neural network regimes, proving that this regime enables slower stepsize decay of order $Ω(1/\\sqrt{t})$ under mild assumptions. We further extend the theoretical results from several aspects, e.g., non-Lipschitz regimes. This finding is broadly applicable, as homogeneous neural networks encompass fully-connected and convolutional neural networks with ReLU and LeakyReLU activations."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.22936","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T02:58:24Z","registered":"2026-02-27T02:58:25Z","published":null,"updated":"2026-02-27T02:58:25Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.22935","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.22935","identifiers":[{"identifier":"2602.22935","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Zarif","familyName":"Ishmam","name":"Ishmam, Zarif","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zarif","familyName":"Mahir","name":"Mahir, Zarif","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Shafnan","familyName":"Wasif","name":"Wasif, Shafnan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Md. Ishtiak","familyName":"Moin","name":"Moin, Md. Ishtiak","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"A Holistic Framework for Robust Bangla ASR and Speaker Diarization with Optimized VAD and CTC Alignment"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Sound (cs.SD)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-26T12:26:04Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:42:43Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Despite being one of the most widely spoken languages globally, Bangla remains a low-resource language in the field of Natural Language Processing (NLP). Mainstream Automatic Speech Recognition (ASR) and Speaker Diarization systems for Bangla struggles when processing longform audio exceeding 3060 seconds. This paper presents a robust framework specifically engineered for extended Bangla content by leveraging preexisting models enhanced with novel optimization pipelines for the DL Sprint 4.0 contest. Our approach utilizes Voice Activity Detection (VAD) optimization and Connectionist Temporal Classification (CTC) segmentation via forced word alignment to maintain temporal accuracy and transcription integrity over long durations. Additionally, we employed several finetuning techniques and preprocessed the data using augmentation techniques and noise removal. By bridging the performance gap in complex, multi-speaker environments, this work provides a scalable solution for real-world, longform Bangla speech applications."},{"descriptionType":"Other","description":"5 pages"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.22935","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T02:58:22Z","registered":"2026-02-27T02:58:23Z","published":null,"updated":"2026-02-27T02:58:23Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.22932","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.22932","identifiers":[{"identifier":"2602.22932","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Wenhui","familyName":"Tan","name":"Tan, Wenhui","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xiaoyi","familyName":"Yu","name":"Yu, Xiaoyi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jiaze","familyName":"Li","name":"Li, Jiaze","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yijing","familyName":"Chen","name":"Chen, Yijing","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jianzhong","familyName":"Ju","name":"Ju, Jianzhong","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zhenbo","familyName":"Luo","name":"Luo, Zhenbo","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ruihua","familyName":"Song","name":"Song, Ruihua","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jian","familyName":"Luan","name":"Luan, Jian","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"MSJoE: Jointly Evolving MLLM and Sampler for Efficient Long-Form Video Understanding"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-26T12:24:17Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:42:34Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Efficiently understanding long-form videos remains a fundamental challenge for multimodal large language models (MLLMs). In this paper, we present MLLM-Sampler Joint Evolution (MSJoE), a novel framework that jointly evolves the MLLM and a lightweight key-frame sampler for efficient long-form video understanding. MSJoE builds upon a key assumption that only a small subset of key-frames is truly informative for answering each question to a video. Specifically, MSJoE first reasons out several queries, which describe diverse visual perspectives relevant to the question. Then, these queries interact with a frozen CLIP model to produce a query-frame similarity matrix. Finally, a lightweight sampler predicts key-frame sampling weights from this matrix, selecting a compact set of informative frames, which are then fed into the MLLM for answer generation. Both the MLLM and sampler are jointly optimized through reinforcement learning, enabling co-adaptation of query-reasoning, frame-sampling, and key-frame understanding. A new long-video QA dataset containing 2.8K videos with 7K question-answer pairs is collected to support the training process. Extensive experiments on VideoMME, LongVideoBench, LVBench, and MLVU show that MSJoE achieves 8.0\\% accuracy gain upon the base MLLM, and 1.1\\% higher accuracy than strongest baseline method."},{"descriptionType":"Other","description":"Accepted by CVPR2026"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.22932","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T02:58:17Z","registered":"2026-02-27T02:58:18Z","published":null,"updated":"2026-02-27T02:58:18Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.22931","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.22931","identifiers":[{"identifier":"2602.22931","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Lucas B. T.","familyName":"de Kam","name":"de Kam, Lucas B. T.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jia-Xin","familyName":"Zhu","name":"Zhu, Jia-Xin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ankit","familyName":"Mathanker","name":"Mathanker, Ankit","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Katharina","familyName":"Doblhoff-Dier","name":"Doblhoff-Dier, Katharina","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Nitish","familyName":"Govindarajan","name":"Govindarajan, Nitish","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Benchmarking short-range machine learning potentials for atomistic simulations of metal/electrolyte interfaces"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Chemical Physics (physics.chem-ph)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-26T12:22:13Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:42:33Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Atomistic simulations of electrochemical interfaces remain challenging due to the long time scales required to adequately sample the structure of the electric double layer. The emergence of efficient, short-range machine learning interatomic potentials (MLIPs) offers a promising alternative to computationally expensive density functional theory-based molecular dynamics (DFT-MD) simulations in this regard. However, in standard periodic DFT calculations of metal surfaces, the surface charge is implicitly set by the number of counterions in the simulation cell, making it a global property that is difficult to represent with strictly local MLIPs. Here, we benchmark common MLIP architectures (DP, ACE, MACE) for charged Au/water interfaces containing solvated sodium ions. We find that MLIPs trained on datasets spanning multiple surface charge states yield inconsistent predictions of interfacial water orientation and ion distributions, although message-passing models with a larger receptive field exhibit greater robustness to training on mixed-charge datasets. In contrast, models trained on a single charge state produce consistent equilibrium interfacial properties. Finally, we assess the performance of the eSEN model trained on the recently released Open Catalyst 2025 dataset, which includes solid/liquid interfaces that span a wide range of surface charge densities. Overall, our results characterize the limitations of short-range MLIPs for simulations of electrochemical interfaces and provide practical guidance for constructing training datasets for simulations of charged metal/electrolyte interfaces."},{"descriptionType":"Other","description":"30 pages, 19 figures"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.22931","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T02:58:15Z","registered":"2026-02-27T02:58:16Z","published":null,"updated":"2026-02-27T02:58:16Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.22884","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.22884","identifiers":[{"identifier":"2602.22884","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Aayush","familyName":"Mishra","name":"Mishra, Aayush","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Šimon","familyName":"Kucharský","name":"Kucharský, Šimon","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Paul-Christian","familyName":"Bürkner","name":"Bürkner, Paul-Christian","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Unsupervised Continual Learning for Amortized Bayesian Inference"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Machine Learning (stat.ML)","lang":"en","subjectScheme":"arXiv"},{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-26T11:22:46Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:40:03Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Amortized Bayesian Inference (ABI) enables efficient posterior estimation using generative neural networks trained on simulated data, but often suffers from performance degradation under model misspecification. While self-consistency (SC) training on unlabeled empirical data can enhance network robustness, current approaches are limited to static, single-task settings and fail to handle sequentially arriving data or distribution shifts. We propose a continual learning framework for ABI that decouples simulation-based pre-training from unsupervised sequential SC fine-tuning on real-world data. To address the challenge of catastrophic forgetting, we introduce two adaptation strategies: (1) SC with episodic replay, utilizing a memory buffer of past observations, and (2) SC with elastic weight consolidation, which regularizes updates to preserve task-critical parameters. Across three diverse case studies, our methods significantly mitigate forgetting and yield posterior estimates that outperform standard simulation-based training, achieving estimates closer to MCMC reference, providing a viable path for trustworthy ABI across a range of different tasks."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.22884","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T02:57:07Z","registered":"2026-02-27T02:57:08Z","published":null,"updated":"2026-02-27T02:57:08Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.22882","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.22882","identifiers":[{"identifier":"2602.22882","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Umberto","familyName":"Biccari","name":"Biccari, Umberto","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Alain Ibáñez","familyName":"de Opakua","name":"de Opakua, Alain Ibáñez","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"José María","familyName":"Mato","name":"Mato, José María","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Óscar","familyName":"Millet","name":"Millet, Óscar","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Roberto","familyName":"Morales","name":"Morales, Roberto","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Enrique","familyName":"Zuazua","name":"Zuazua, Enrique","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Fair feature attribution for multi-output prediction: a Shapley-based perspective"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-26T11:22:08Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:39:57Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"In this article, we provide an axiomatic characterization of feature attribution for multi-output predictors within the Shapley framework. While SHAP explanations are routinely computed independently for each output coordinate, the theoretical necessity of this practice has remained unclear. By extending the classical Shapley axioms to vector-valued cooperative games, we establish a rigidity theorem showing that any attribution rule satisfying efficiency, symmetry, dummy player, and additivity must necessarily decompose component-wise across outputs. Consequently, any joint-output attribution rule must relax at least one of the classical Shapley axioms. This result identifies a previously unformalized structural constraint in Shapley-based interpretability, clarifying the precise scope of fairness-consistent explanations in multi-output learning. Numerical experiments on a biomedical benchmark illustrate that multi-output models can yield computational savings in training and deployment, while producing SHAP explanations that remain fully consistent with the component-wise structure imposed by the Shapley axioms."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.22882","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T02:57:04Z","registered":"2026-02-27T02:57:05Z","published":null,"updated":"2026-02-27T02:57:05Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.22879","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.22879","identifiers":[{"identifier":"2602.22879","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Xingcheng","familyName":"Fu","name":"Fu, Xingcheng","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Shengpeng","familyName":"Wang","name":"Wang, Shengpeng","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yisen","familyName":"Gao","name":"Gao, Yisen","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xianxian","familyName":"Li","name":"Li, Xianxian","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Chunpei","familyName":"Li","name":"Li, Chunpei","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Qingyun","familyName":"Sun","name":"Sun, Qingyun","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Dongran","familyName":"Yu","name":"Yu, Dongran","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Towards LLM-Empowered Knowledge Tracing via LLM-Student Hierarchical Behavior Alignment in Hyperbolic Space"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-26T11:17:31Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:39:46Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Knowledge Tracing (KT) diagnoses students' concept mastery through continuous learning state monitoring in education.Existing methods primarily focus on studying behavioral sequences based on ID or textual information.While existing methods rely on ID-based sequences or shallow textual features, they often fail to capture (1) the hierarchical evolution of cognitive states and (2) individualized problem difficulty perception due to limited semantic modeling. Therefore, this paper proposes a Large Language Model Hyperbolic Aligned Knowledge Tracing(L-HAKT). First, the teacher agent deeply parses question semantics and explicitly constructs hierarchical dependencies of knowledge points; the student agent simulates learning behaviors to generate synthetic data. Then, contrastive learning is performed between synthetic and real data in hyperbolic space to reduce distribution differences in key features such as question difficulty and forgetting patterns. Finally, by optimizing hyperbolic curvature, we explicitly model the tree-like hierarchical structure of knowledge points, precisely characterizing differences in learning curve morphology for knowledge points at different levels. Extensive experiments on four real-world educational datasets validate the effectiveness of our Large Language Model Hyperbolic Aligned Knowledge Tracing (L-HAKT) framework."},{"descriptionType":"Other","description":"9 pages, 6 figures, Accepted to AAAI 2026"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.22879","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T02:57:00Z","registered":"2026-02-27T02:57:01Z","published":null,"updated":"2026-02-27T02:57:01Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.22871","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.22871","identifiers":[{"identifier":"2602.22871","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Roy","familyName":"Miles","name":"Miles, Roy","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Aysim","familyName":"Toker","name":"Toker, Aysim","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Andreea-Maria","familyName":"Oncescu","name":"Oncescu, Andreea-Maria","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Songcen","familyName":"Xu","name":"Xu, Songcen","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jiankang","familyName":"Deng","name":"Deng, Jiankang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ismail","familyName":"Elezi","name":"Elezi, Ismail","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Test-Time Scaling with Diffusion Language Models via Reward-Guided Stitching"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-26T11:08:39Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:39:11Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Reasoning with large language models often benefits from generating multiple chains-of-thought, but existing aggregation strategies are typically trajectory-level (e.g., selecting the best trace or voting on the final answer), discarding useful intermediate work from partial or \"nearly correct\" attempts. We propose Stitching Noisy Diffusion Thoughts, a self-consistency framework that turns cheap diffusion-sampled reasoning into a reusable pool of step-level candidates. Given a problem, we (i) sample many diverse, low-cost reasoning trajectories using a masked diffusion language model, (ii) score every intermediate step with an off-the-shelf process reward model (PRM), and (iii) stitch these highest-quality steps across trajectories into a composite rationale. This rationale then conditions an autoregressive (AR) model (solver) to recompute only the final answer. This modular pipeline separates exploration (diffusion) from evaluation and solution synthesis, avoiding monolithic unified hybrids while preserving broad search. Across math reasoning benchmarks, we find that step-level recombination is most beneficial on harder problems, and ablations highlight the importance of the final AR solver in converting stitched but imperfect rationales into accurate answers. Using low-confidence diffusion sampling with parallel, independent rollouts, our training-free framework improves average accuracy by up to 23.8% across six math and coding tasks. At the same time, it achieves up to a 1.8x latency reduction relative to both traditional diffusion models (e.g., Dream, LLaDA) and unified architectures (e.g., TiDAR). Code is available at https://github.com/roymiles/diffusion-stitching."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.22871","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T02:56:49Z","registered":"2026-02-27T02:56:50Z","published":null,"updated":"2026-02-27T02:56:50Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.22868","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.22868","identifiers":[{"identifier":"2602.22868","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Yushi","familyName":"Ye","name":"Ye, Yushi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Feng","familyName":"Hong","name":"Hong, Feng","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Huangjie","familyName":"Zheng","name":"Zheng, Huangjie","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xu","familyName":"Chen","name":"Chen, Xu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zhiyong","familyName":"Chen","name":"Chen, Zhiyong","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yanfeng","familyName":"Wang","name":"Wang, Yanfeng","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jiangchao","familyName":"Yao","name":"Yao, Jiangchao","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Rejection Mixing: Fast Semantic Propagation of Mask Tokens for Efficient DLLM Inference"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-26T11:08:11Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:39:09Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Diffusion Large Language Models (DLLMs) promise fast non-autoregressive inference but suffer a severe quality-speed trade-off in parallel decoding. This stems from the ''combinatorial contradiction'' phenomenon, where parallel tokens form semantically inconsistent combinations. We address this by integrating continuous representations into the discrete decoding process, as they preserve rich inter-position dependency. We propose ReMix (Rejection Mixing), a framework that introduces a novel Continuous Mixing State as an intermediate between the initial masked state and the final decoded token state. This intermediate state allows a token's representation to be iteratively refined in a continuous space, resolving mutual conflicts with other tokens before collapsing into a final discrete sample. Furthermore, a rejection rule reverts uncertain representations from the continuous state back to the masked state for reprocessing, ensuring stability and preventing error propagation. ReMix thus mitigates combinatorial contradictions by enabling continuous-space refinement during discrete diffusion decoding. Extensive experiments demonstrate that ReMix, as a training-free method, achieves a $2-8 \\times$ inference speedup without any quality degradation."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.22868","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T02:56:45Z","registered":"2026-02-27T02:56:46Z","published":null,"updated":"2026-02-27T02:56:46Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.22865","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.22865","identifiers":[{"identifier":"2602.22865","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Jonathan","familyName":"Davidov","name":"Davidov, Jonathan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Aviv","familyName":"Slobodkin","name":"Slobodkin, Aviv","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Shmuel Tomi","familyName":"Klein","name":"Klein, Shmuel Tomi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Reut","familyName":"Tsarfaty","name":"Tsarfaty, Reut","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ido","familyName":"Dagan","name":"Dagan, Ido","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ayal","familyName":"Klein","name":"Klein, Ayal","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Effective QA-driven Annotation of Predicate-Argument Relations Across Languages"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-26T11:01:38Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:38:49Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Explicit representations of predicate-argument relations form the basis of interpretable semantic analysis, supporting reasoning, generation, and evaluation. However, attaining such semantic structures requires costly annotation efforts and has remained largely confined to English. We leverage the Question-Answer driven Semantic Role Labeling (QA-SRL) framework -- a natural-language formulation of predicate-argument relations -- as the foundation for extending semantic annotation to new languages. To this end, we introduce a cross-linguistic projection approach that reuses an English QA-SRL parser within a constrained translation and word-alignment pipeline to automatically generate question-answer annotations aligned with target-language predicates. Applied to Hebrew, Russian, and French -- spanning diverse language families -- the method yields high-quality training data and fine-tuned, language-specific parsers that outperform strong multilingual LLM baselines (GPT-4o, LLaMA-Maverick). By leveraging QA-SRL as a transferable natural-language interface for semantics, our approach enables efficient and broadly accessible predicate-argument parsing across languages."},{"descriptionType":"Other","description":"Accepted to EACL 2026 (Main Conference)"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.22865","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T02:56:41Z","registered":"2026-02-27T02:56:42Z","published":null,"updated":"2026-02-27T02:56:42Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.22850","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.22850","identifiers":[{"identifier":"2602.22850","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","affiliation":["Cuiying Honors College, Lanzhou University, Lanzhou, Gansu, China","School of Mathematics and Statistics, Lanzhou University, Lanzhou, Gansu, China"],"givenName":"Yi","familyName":"He","name":"He, Yi","nameIdentifiers":[]},{"nameType":"Personal","affiliation":["School of Management, Lanzhou University, Lanzhou, Gansu, China"],"givenName":"Yina","familyName":"Cao","name":"Cao, Yina","nameIdentifiers":[]},{"nameType":"Personal","affiliation":["Shanghai Innovation Institute, Shanghai, China","School of Mathematics and Statistics, Lanzhou University, Lanzhou, Gansu, China"],"givenName":"Jixiu","familyName":"Zhai","name":"Zhai, Jixiu","nameIdentifiers":[]},{"nameType":"Personal","affiliation":["Cuiying Honors College, Lanzhou University, Lanzhou, Gansu, China","School of Mathematics and Statistics, Lanzhou University, Lanzhou, Gansu, China"],"givenName":"Di","familyName":"Wang","name":"Wang, Di","nameIdentifiers":[]},{"nameType":"Personal","affiliation":["School of Mathematics and Statistics, Lanzhou University, Lanzhou, Gansu, China"],"givenName":"Junxiao","familyName":"Kong","name":"Kong, Junxiao","nameIdentifiers":[]},{"nameType":"Personal","affiliation":["School of Mathematics and Statistics, Lanzhou University, Lanzhou, Gansu, China","Department of Computer Science, City University of Hong Kong, Kowloon, Hong Kong, China"],"givenName":"Tianchi","familyName":"Lu","name":"Lu, Tianchi","nameIdentifiers":[]}],"titles":[{"title":"MEDNA-DFM: A Dual-View FiLM-MoE Model for Explainable DNA Methylation Prediction"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-26T10:38:41Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:38:22Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Accurate computational identification of DNA methylation is essential for understanding epigenetic regulation. Although deep learning excels in this binary classification task, its \"black-box\" nature impedes biological insight. We address this by introducing a high-performance model MEDNA-DFM, alongside mechanism-inspired signal purification algorithms. Our investigation demonstrates that MEDNA-DFM effectively captures conserved methylation patterns, achieving robust distinction across diverse species. Validation on external independent datasets confirms that the model's generalization is driven by conserved intrinsic motifs (e.g., GC content) rather than phylogenetic proximity. Furthermore, applying our developed algorithms extracted motifs with significantly higher reliability than prior studies. Finally, empirical evidence from a Drosophila 6mA case study prompted us to propose a \"sequence-structure synergy\" hypothesis, suggesting that the GAGG core motif and an upstream A-tract element function cooperatively. We further validated this hypothesis via in silico mutagenesis, confirming that the ablation of either or both elements significantly degrades the model's recognition capabilities. This work provides a powerful tool for methylation prediction and demonstrates how explainable deep learning can drive both methodological innovation and the generation of biological hypotheses."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.22850","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T02:56:19Z","registered":"2026-02-27T02:56:20Z","published":null,"updated":"2026-02-27T02:56:20Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.22846","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.22846","identifiers":[{"identifier":"2602.22846","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Mohammad Yeghaneh","familyName":"Abkenar","name":"Abkenar, Mohammad Yeghaneh","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Weixing","familyName":"Wang","name":"Wang, Weixing","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Manfred","familyName":"Stede","name":"Stede, Manfred","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Davide","familyName":"Picca","name":"Picca, Davide","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Mark A.","familyName":"Finlayson","name":"Finlayson, Mark A.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Panagiotis","familyName":"Ioannidis","name":"Ioannidis, Panagiotis","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Improving Neural Argumentative Stance Classification in Controversial Topics with Emotion-Lexicon Features"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-26T10:37:05Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:38:14Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Argumentation mining comprises several subtasks, among which stance classification focuses on identifying the standpoint expressed in an argumentative text toward a specific target topic. While arguments-especially about controversial topics-often appeal to emotions, most prior work has not systematically incorporated explicit, fine-grained emotion analysis to improve performance on this task. In particular, prior research on stance classification has predominantly utilized non-argumentative texts and has been restricted to specific domains or topics, limiting generalizability. We work on five datasets from diverse domains encompassing a range of controversial topics and present an approach for expanding the Bias-Corrected NRC Emotion Lexicon using DistilBERT embeddings, which we feed into a Neural Argumentative Stance Classification model. Our method systematically expands the emotion lexicon through contextualized embeddings to identify emotionally charged terms not previously captured in the lexicon. Our expanded NRC lexicon (eNRC) improves over the baseline across all five datasets (up to +6.2 percentage points in F1 score), outperforms the original NRC on four datasets (up to +3.0), and surpasses the LLM-based approach on nearly all corpora. We provide all resources-including eNRC, the adapted corpora, and model architecture-to enable other researchers to build upon our work."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.22846","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T02:56:13Z","registered":"2026-02-27T02:56:13Z","published":null,"updated":"2026-02-27T02:56:13Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.22843","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.22843","identifiers":[{"identifier":"2602.22843","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Chong","familyName":"Wang","name":"Wang, Chong","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yabin","familyName":"Zhang","name":"Zhang, Yabin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yunhe","familyName":"Gao","name":"Gao, Yunhe","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Maya","familyName":"Varma","name":"Varma, Maya","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Clemence","familyName":"Mottez","name":"Mottez, Clemence","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Faidra","familyName":"Patsatzi","name":"Patsatzi, Faidra","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jiaming","familyName":"Liu","name":"Liu, Jiaming","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jin","familyName":"Long","name":"Long, Jin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jean-Benoit","familyName":"Delbrouck","name":"Delbrouck, Jean-Benoit","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Sergios","familyName":"Gatidis","name":"Gatidis, Sergios","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Akshay S.","familyName":"Chaudhari","name":"Chaudhari, Akshay S.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Curtis P.","familyName":"Langlotz","name":"Langlotz, Curtis P.","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"A data- and compute-efficient chest X-ray foundation model beyond aggressive scaling"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-26T10:32:08Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:38:01Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by-nc-sa/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution Non Commercial Share Alike 4.0 International","rightsIdentifier":"cc-by-nc-sa-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Foundation models for medical imaging are typically pretrained on increasingly large datasets, following a \"scale-at-all-costs\" paradigm. However, this strategy faces two critical challenges: large-scale medical datasets often contain substantial redundancy and severe class imbalance that bias representation learning toward over-represented patterns, and indiscriminate training regardless of heterogeneity in data quality incurs considerable computational inefficiency. Here we demonstrate that active, principled data curation during pretraining can serve as a viable, cost-effective alternative to brute-force dataset enlargement. We introduce CheXficient, a chest X-ray (CXR) foundation model that selectively prioritizes informative training samples. CheXficient is pretrained on only 22.7% of 1,235,004 paired CXR images and reports while consuming under 27.3% of the total compute budget, yet achieving comparable or superior performance to its full-data counterpart and other large-scale pretrained models. We assess CheXficient across 20 individual benchmarks spanning 5 task types, including non-adapted off-the-shelf evaluations (zero-shot findings classification and crossmodal retrieval) and adapted downstream tasks (disease prediction, semantic segmentation, and radiology report generation). Further analyses show that CheXficient systematically prioritizes under-represented training samples, improving generalizability on long-tailed or rare conditions. Overall, our work offers practical insights into the data and computation demands for efficient pretraining and downstream adaptation of medical vision-language foundation models."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.22843","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T02:56:08Z","registered":"2026-02-27T02:56:09Z","published":null,"updated":"2026-02-27T02:56:09Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.22828","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.22828","identifiers":[{"identifier":"2602.22828","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Jianmin","familyName":"Li","name":"Li, Jianmin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ying","familyName":"Chang","name":"Chang, Ying","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Su-Kit","familyName":"Tang","name":"Tang, Su-Kit","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yujia","familyName":"Liu","name":"Liu, Yujia","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yanwen","familyName":"Wang","name":"Wang, Yanwen","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Shuyuan","familyName":"Lin","name":"Lin, Shuyuan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Binkai","familyName":"Ou","name":"Ou, Binkai","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"TCM-DiffRAG: Personalized Syndrome Differentiation Reasoning Method for Traditional Chinese Medicine based on Knowledge Graph and Chain of Thought"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-26T10:11:15Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:37:11Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Background: Retrieval augmented generation (RAG) technology can empower large language models (LLMs) to generate more accurate, professional, and timely responses without fine tuning. However, due to the complex reasoning processes and substantial individual differences involved in traditional Chinese medicine (TCM) clinical diagnosis and treatment, traditional RAG methods often exhibit poor performance in this domain. Objective: To address the limitations of conventional RAG approaches in TCM applications, this study aims to develop an improved RAG framework tailored to the characteristics of TCM reasoning. Methods: We developed TCM-DiffRAG, an innovative RAG framework that integrates knowledge graphs (KG) with chains of thought (CoT). TCM-DiffRAG was evaluated on three distinctive TCM test datasets. Results: The experimental results demonstrated that TCM-DiffRAG achieved significant performance improvements over native LLMs. For example, the qwen-plus model achieved scores of 0.927, 0.361, and 0.038, which were significantly enhanced to 0.952, 0.788, and 0.356 with TCM-DiffRAG. The improvements were even more pronounced for non-Chinese LLMs. Additionally, TCM-DiffRAG outperformed directly supervised fine-tuned (SFT) LLMs and other benchmark RAG methods. Conclusions: TCM-DiffRAG shows that integrating structured TCM knowledge graphs with Chain of Thought based reasoning substantially improves performance in individualized diagnostic tasks. The joint use of universal and personalized knowledge graphs enables effective alignment between general knowledge and clinical reasoning. These results highlight the potential of reasoning-aware RAG frameworks for advancing LLM applications in traditional Chinese medicine."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.22828","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T02:55:40Z","registered":"2026-02-27T02:55:41Z","published":null,"updated":"2026-02-27T02:55:41Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.22823","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.22823","identifiers":[{"identifier":"2602.22823","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Anirudh","familyName":"Thatipelli","name":"Thatipelli, Anirudh","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ali","familyName":"Siahkoohi","name":"Siahkoohi, Ali","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Hypernetwork-based approach for grid-independent functional data clustering"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-26T10:05:07Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:36:54Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Functional data clustering is concerned with grouping functions that share similar structure, yet most existing methods implicitly operate on sampled grids, causing cluster assignments to depend on resolution, sampling density, or preprocessing choices rather than on the underlying functions themselves. To address this limitation, we introduce a framework that maps discretized function observations -- at arbitrary resolution and on arbitrary grids -- into a fixed-dimensional vector space via an auto-encoding architecture. The encoder is a hypernetwork that maps coordinate-value pairs to the weight space of an implicit neural representation (INR), which serves as the decoder. Because INRs represent functions with very few parameters, this design yields compact representations that are decoupled from the sampling grid, while the hypernetwork amortizes weight prediction across the dataset. Clustering is then performed in this weight space using standard algorithms, making the approach agnostic to both the discretization and the choice of clustering method. By means of synthetic and real-world experiments in high-dimensional settings, we demonstrate competitive clustering performance that is robust to changes in sampling resolution -- including generalization to resolutions not seen during training."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.22823","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T02:55:33Z","registered":"2026-02-27T02:55:34Z","published":null,"updated":"2026-02-27T02:55:34Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.22821","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.22821","identifiers":[{"identifier":"2602.22821","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Tong","familyName":"Wang","name":"Wang, Tong","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yaolei","familyName":"Qi","name":"Qi, Yaolei","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Siwen","familyName":"Wang","name":"Wang, Siwen","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Imran","familyName":"Razzak","name":"Razzak, Imran","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Guanyu","familyName":"Yang","name":"Yang, Guanyu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yutong","familyName":"Xie","name":"Xie, Yutong","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"CMSA-Net: Causal Multi-scale Aggregation with Adaptive Multi-source Reference for Video Polyp Segmentation"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-26T10:03:31Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:36:47Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Video polyp segmentation (VPS) is an important task in computer-aided colonoscopy, as it helps doctors accurately locate and track polyps during examinations. However, VPS remains challenging because polyps often look similar to surrounding mucosa, leading to weak semantic discrimination. In addition, large changes in polyp position and scale across video frames make stable and accurate segmentation difficult. To address these challenges, we propose a robust VPS framework named CMSA-Net. The proposed network introduces a Causal Multi-scale Aggregation (CMA) module to effectively gather semantic information from multiple historical frames at different scales. By using causal attention, CMA ensures that temporal feature propagation follows strict time order, which helps reduce noise and improve feature reliability. Furthermore, we design a Dynamic Multi-source Reference (DMR) strategy that adaptively selects informative and reliable reference frames based on semantic separability and prediction confidence. This strategy provides strong multi-frame guidance while keeping the model efficient for real-time inference. Extensive experiments on the SUN-SEG dataset demonstrate that CMSA-Net achieves state-of-the-art performance, offering a favorable balance between segmentation accuracy and real-time clinical applicability."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.22821","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T02:55:30Z","registered":"2026-02-27T02:55:31Z","published":null,"updated":"2026-02-27T02:55:31Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.22818","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.22818","identifiers":[{"identifier":"2602.22818","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Remi","familyName":"Cadene","name":"Cadene, Remi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Simon","familyName":"Aliberts","name":"Aliberts, Simon","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Francesco","familyName":"Capuano","name":"Capuano, Francesco","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Michel","familyName":"Aractingi","name":"Aractingi, Michel","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Adil","familyName":"Zouitine","name":"Zouitine, Adil","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Pepijn","familyName":"Kooijmans","name":"Kooijmans, Pepijn","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jade","familyName":"Choghari","name":"Choghari, Jade","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Martino","familyName":"Russi","name":"Russi, Martino","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Caroline","familyName":"Pascal","name":"Pascal, Caroline","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Steven","familyName":"Palma","name":"Palma, Steven","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Mustafa","familyName":"Shukor","name":"Shukor, Mustafa","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jess","familyName":"Moss","name":"Moss, Jess","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Alexander","familyName":"Soare","name":"Soare, Alexander","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Dana","familyName":"Aubakirova","name":"Aubakirova, Dana","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Quentin","familyName":"Lhoest","name":"Lhoest, Quentin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Quentin","familyName":"Gallouédec","name":"Gallouédec, Quentin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Thomas","familyName":"Wolf","name":"Wolf, Thomas","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"LeRobot: An Open-Source Library for End-to-End Robot Learning"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Robotics (cs.RO)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-26T09:59:50Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:36:35Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Robotics is undergoing a significant transformation powered by advances in high-level control techniques based on machine learning, giving rise to the field of robot learning. Recent progress in robot learning has been accelerated by the increasing availability of affordable teleoperation systems, large-scale openly available datasets, and scalable learning-based methods. However, development in the field of robot learning is often slowed by fragmented, closed-source tools designed to only address specific sub-components within the robotics stack. In this paper, we present \\texttt{lerobot}, an open-source library that integrates across the entire robot learning stack, from low-level middleware communication for motor controls to large-scale dataset collection, storage and streaming. The library is designed with a strong focus on real-world robotics, supporting accessible hardware platforms while remaining extensible to new embodiments. It also supports efficient implementations for various state-of-the-art robot learning algorithms from multiple prominent paradigms, as well as a generalized asynchronous inference stack. Unlike traditional pipelines which heavily rely on hand-crafted techniques, \\texttt{lerobot} emphasizes scalable learning approaches that improve directly with more data and compute. Designed for accessibility, scalability, and openness, \\texttt{lerobot} lowers the barrier to entry for researchers and practitioners to robotics while providing a platform for reproducible, state-of-the-art robot learning."},{"descriptionType":"Other","description":"https://github.com/huggingface/lerobot"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.22818","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T02:55:25Z","registered":"2026-02-27T02:55:26Z","published":null,"updated":"2026-02-27T02:55:26Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.22817","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.22817","identifiers":[{"identifier":"2602.22817","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Shuo","familyName":"He","name":"He, Shuo","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Lang","familyName":"Feng","name":"Feng, Lang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Qi","familyName":"Wei","name":"Wei, Qi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xin","familyName":"Cheng","name":"Cheng, Xin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Lei","familyName":"Feng","name":"Feng, Lei","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Bo","familyName":"An","name":"An, Bo","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Hierarchy-of-Groups Policy Optimization for Long-Horizon Agentic Tasks"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-26T09:58:10Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:36:30Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Group-based reinforcement learning (RL), such as GRPO, has advanced the capabilities of large language models on long-horizon agentic tasks. To enable more fine-grained policy updates, recent research has increasingly shifted toward stepwise group-based policy optimization, which treats each step in a rollout trajectory independently while using a memory module to retain historical context. However, we find a key issue in estimating stepwise relative advantages, namely context inconsistency, where steps within the same group may differ in their historical contexts. Empirically, we reveal that this issue can lead to severely biased advantage estimation, thereby degrading policy optimization significantly. To address the issue, in this paper, we propose Hierarchy-of-Groups Policy Optimization (HGPO) for long-horizon agentic tasks. Specifically, within a group of rollout trajectories, HGPO assigns each step to multiple hierarchical groups according to the consistency of historical contexts. Then, for each step, HGPO computes distinct advantages within each group and aggregates them with an adaptive weighting scheme. In this way, HGPO can achieve a favorable bias-variance trade-off in stepwise advantage estimation, without extra models or rollouts. Evaluations on two challenging agentic tasks, ALFWorld and WebShop with Qwen2.5-1.5B-Instruct and Qwen2.5-7B-Instruct, show that HGPO significantly outperforms existing agentic RL methods under the same computational constraints. Code is available at https://github.com/langfengQ/verl-agent/tree/master/recipe/hgpo."},{"descriptionType":"Other","description":"Accepted at ICLR 2026"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.22817","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":3,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T02:55:23Z","registered":"2026-02-27T02:55:24Z","published":null,"updated":"2026-02-27T02:55:24Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.22808","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.22808","identifiers":[{"identifier":"2602.22808","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Shiqian","familyName":"Su","name":"Su, Shiqian","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Sen","familyName":"Xing","name":"Xing, Sen","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xuan","familyName":"Dong","name":"Dong, Xuan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Muyan","familyName":"Zhong","name":"Zhong, Muyan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Bin","familyName":"Wang","name":"Wang, Bin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xizhou","familyName":"Zhu","name":"Zhu, Xizhou","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yuntao","familyName":"Chen","name":"Chen, Yuntao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Wenhai","familyName":"Wang","name":"Wang, Wenhai","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yue","familyName":"Deng","name":"Deng, Yue","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Pengxiang","familyName":"Zhu","name":"Zhu, Pengxiang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ziyuan","familyName":"Liu","name":"Liu, Ziyuan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Tiantong","familyName":"Li","name":"Li, Tiantong","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jiaheng","familyName":"Yu","name":"Yu, Jiaheng","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zhe","familyName":"Chen","name":"Chen, Zhe","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Lidong","familyName":"Bing","name":"Bing, Lidong","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jifeng","familyName":"Dai","name":"Dai, Jifeng","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"MiroFlow: Towards High-Performance and Robust Open-Source Agent Framework for General Deep Research Tasks"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-26T09:45:04Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:35:54Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Despite the remarkable progress of large language models (LLMs), the capabilities of standalone LLMs have begun to plateau when tackling real-world, complex tasks that require interaction with external tools and dynamic environments. Although recent agent frameworks aim to enhance model autonomy through tool integration and external interaction, they still suffer from naive workflows, unstable performance, limited support across diverse benchmarks and tasks, and heavy reliance on costly commercial APIs. In this work, we propose a high-performance and robust open-source agent framework, termed MiroFlow, which incorporates an agent graph for flexible orchestration, an optional deep reasoning mode to enhance performance, and a robust workflow execution to ensure stable and reproducible performance. Extensive experiments demonstrate that MiroFlow consistently achieves state-of-the-art performance across multiple agent benchmarks, including GAIA, BrowseComp-EN/ZH, HLE, xBench-DeepSearch, and notably FutureX. We hope it could serve as an easily accessible, reproducible, and comparable baseline for the deep research community."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.22808","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T02:55:10Z","registered":"2026-02-27T02:55:10Z","published":null,"updated":"2026-02-27T02:55:10Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.22796","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.22796","identifiers":[{"identifier":"2602.22796","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Yijie","familyName":"Bian","name":"Bian, Yijie","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Wei","familyName":"Guo","name":"Guo, Wei","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jie","familyName":"Yang","name":"Yang, Jie","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Shenghui","familyName":"Song","name":"Song, Shenghui","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jun","familyName":"Zhang","name":"Zhang, Jun","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Shi","familyName":"Jin","name":"Jin, Shi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Khaled B.","familyName":"Letaief","name":"Letaief, Khaled B.","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Multi-modal Data Driven Virtual Base Station Construction for Massive MIMO Beam Alignment"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Information Theory (cs.IT)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-26T09:33:00Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:35:20Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Massive multiple-input multiple-output (MIMO) is a key enabler for the high data rates required by the sixth-generation networks, yet its performance hinges on effective beam management with low training overhead. This paper proposes an interpretable framework to tackle beam alignment in mixed line-of-sight (LoS) and non-line-of-sight (NLoS) propagation environments. Our approach utilizes multi-modal data to construct virtual base stations (VBSs), which are geometrically defined as mirror images of the base station across reflecting surfaces reconstructed from 3D LiDAR points. These VBSs provide a sparse and spatial representation of the dominant features of the wireless environment. Based on the constructed VBSs, we develop a VBS-assisted beam alignment scheme comprising coarse channel reconstruction followed by partial beam training. Numerical results demonstrate that the proposed method achieves near-optimal performance in terms of spectral efficiency."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.22796","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T02:54:51Z","registered":"2026-02-27T02:54:52Z","published":null,"updated":"2026-02-27T02:54:52Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.22790","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.22790","identifiers":[{"identifier":"2602.22790","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Hyunwoo","familyName":"Kim","name":"Kim, Hyunwoo","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Hanau","familyName":"Yi","name":"Yi, Hanau","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jaehee","familyName":"Bae","name":"Bae, Jaehee","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yumin","familyName":"Kim","name":"Kim, Yumin","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Natural Language Declarative Prompting (NLD-P): A Modular Governance Method for Prompt Design Under Model Drift"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-26T09:23:09Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:35:01Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by-nc-nd/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution Non Commercial No Derivatives 4.0 International","rightsIdentifier":"cc-by-nc-nd-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"The rapid evolution of large language models (LLMs) has transformed prompt engineering from a localized craft into a systems-level governance challenge. As models scale and update across generations, prompt behavior becomes sensitive to shifts in instruction-following policies, alignment regimes, and decoding strategies, a phenomenon we characterize as GPT-scale model drift. Under such conditions, surface-level formatting conventions and ad hoc refinement are insufficient to ensure stable, interpretable control. This paper reconceptualizes Natural Language Declarative Prompting (NLD-P) as a declarative governance method rather than a rigid field template. NLD-P is formalized as a modular control abstraction that separates provenance, constraint logic, task content, and post-generation evaluation, encoded directly in natural language without reliance on external orchestration code. We define minimal compliance criteria, analyze model-dependent schema receptivity, and position NLD-P as an accessible governance framework for non-developer practitioners operating within evolving LLM ecosystems. Portions of drafting and editorial refinement employed a schema-bound LLM assistant configured under NLD-P. All conceptual framing, methodological claims, and final revisions were directed, reviewed, and approved by the human author under a documented human-in-the-loop protocol. The paper concludes by outlining implications for declarative control under ongoing model evolution and identifying directions for future empirical validation."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.22790","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T02:54:42Z","registered":"2026-02-27T02:54:42Z","published":null,"updated":"2026-02-27T02:54:42Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.22786","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.22786","identifiers":[{"identifier":"2602.22786","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Yuanjun","familyName":"Li","name":"Li, Yuanjun","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Bin","familyName":"Zhang","name":"Zhang, Bin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Hao","familyName":"Chen","name":"Chen, Hao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zhouyang","familyName":"Jiang","name":"Jiang, Zhouyang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Dapeng","familyName":"Li","name":"Li, Dapeng","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zhiwei","familyName":"Xu","name":"Xu, Zhiwei","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"QSIM: Mitigating Overestimation in Multi-Agent Reinforcement Learning via Action Similarity Weighted Q-Learning"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Multiagent Systems (cs.MA)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-26T09:20:46Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:34:51Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Value decomposition (VD) methods have achieved remarkable success in cooperative multi-agent reinforcement learning (MARL). However, their reliance on the max operator for temporal-difference (TD) target calculation leads to systematic Q-value overestimation. This issue is particularly severe in MARL due to the combinatorial explosion of the joint action space, which often results in unstable learning and suboptimal policies. To address this problem, we propose QSIM, a similarity weighted Q-learning framework that reconstructs the TD target using action similarity. Instead of using the greedy joint action directly, QSIM forms a similarity weighted expectation over a structured near-greedy joint action space. This formulation allows the target to integrate Q-values from diverse yet behaviorally related actions while assigning greater influence to those that are more similar to the greedy choice. By smoothing the target with structurally relevant alternatives, QSIM effectively mitigates overestimation and improves learning stability. Extensive experiments demonstrate that QSIM can be seamlessly integrated with various VD methods, consistently yielding superior performance and stability compared to the original algorithms. Furthermore, empirical analysis confirms that QSIM significantly mitigates the systematic value overestimation in MARL. Code is available at https://github.com/MaoMaoLYJ/pymarl-qsim."},{"descriptionType":"Other","description":"19 pages, 15 figures, 7tables. Accepted to the 36th International Conference on Automated Planning and Scheduling (ICAPS 2026)"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.22786","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T02:54:36Z","registered":"2026-02-27T02:54:36Z","published":null,"updated":"2026-02-27T02:54:36Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.22780","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.22780","identifiers":[{"identifier":"2602.22780","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Qingyuan","familyName":"Zhang","name":"Zhang, Qingyuan","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"An Artificial Intelligence Framework for Joint Structural-Temporal Load Forecasting in Cloud Native Platforms"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Distributed, Parallel, and Cluster Computing (cs.DC)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-26T09:15:59Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:34:44Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"This study targets cloud native environments where microservice invocation relations are complex, load fluctuations are multi-scale and superimposed, and cross-service impacts are significant. We propose a structured temporal joint load prediction framework oriented to microservice topology. The method represents the system as a coupled entity of a time-evolving service invocation graph and multivariate load sequences. It constructs neighborhood-aggregated and global summarized views based on service level observations. This forms layered load representations across instance, service, and cluster levels. A unified sequence encoder models multi-scale historical context. To strengthen the expression of invocation dependencies, the framework introduces a lightweight structural prior into attention computation. This enables more effective capture of load propagation and accumulation along invocation chains, while maintaining consistent modeling of local bursts and overall trends. The training objective adopts a multi-objective regression strategy that jointly optimizes service level and cluster level predictions to improve cross-granularity stability. We further conduct single-factor sensitivity analyses on key structural and training hyperparameters. We systematically examine the effects of time window length, encoding depth, and regularization strength. The results support the necessity of multi-granularity fusion and structural injection and clarify their effective configuration ranges. Overall, the framework provides a reusable modeling paradigm and implementation path for capacity assessment, resource orchestration, and runtime situational understanding in cloud environments."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.22780","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T02:54:27Z","registered":"2026-02-27T02:54:27Z","published":null,"updated":"2026-02-27T02:54:28Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.22775","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.22775","identifiers":[{"identifier":"2602.22775","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Joydeep","familyName":"Chandra","name":"Chandra, Joydeep","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Satyam Kumar","familyName":"Navneet","name":"Navneet, Satyam Kumar","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yong","familyName":"Zhang","name":"Zhang, Yong","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"TherapyProbe: Generating Design Knowledge for Relational Safety in Mental Health Chatbots Through Adversarial Simulation"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Human-Computer Interaction (cs.HC)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-26T09:11:34Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:34:32Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[{"relationType":"IsVersionOf","relatedIdentifier":"10.1145/3772363.3799049","relatedIdentifierType":"DOI"}],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"As mental health chatbots proliferate to address the global treatment gap, a critical question emerges: How do we design for relational safety the quality of interaction patterns that unfold across conversations rather than the correctness of individual responses? Current safety evaluations assess single-turn crisis responses, missing the therapeutic dynamics that determine whether chatbots help or harm over time. We introduce TherapyProbe, a design probe methodology that generates actionable design knowledge by systematically exploring chatbot conversation trajectories through adversarial multi-agent simulation. Using open-source models, TherapyProbe surfaces relational safety failures interaction patterns like \"validation spirals\" where chatbots progressively reinforce hopelessness, or \"empathy fatigue\" where responses become mechanical over turns. Our contribution is translating these failures into a Safety Pattern Library of 23 failure archetypes with corresponding design recommendations. We contribute: (1) a replicable methodology requiring no API costs, (2) a clinically-grounded failure taxonomy, and (3) design implications for developers, clinicians, and policymakers."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.22775","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":1,"created":"2026-02-27T02:54:20Z","registered":"2026-02-27T02:54:21Z","published":null,"updated":"2026-02-27T02:54:21Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.22774","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.22774","identifiers":[{"identifier":"2602.22774","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Maryam","familyName":"Ansarifard","name":"Ansarifard, Maryam","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Mohit K.","familyName":"Sharma","name":"Sharma, Mohit K.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Kishor C.","familyName":"Joshi","name":"Joshi, Kishor C.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"George","familyName":"Exarchakos","name":"Exarchakos, George","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Transformer Actor-Critic for Efficient Freshness-Aware Resource Allocation"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Systems and Control (eess.SY)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Electrical engineering, electronic engineering, information engineering","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Electrical engineering, electronic engineering, information engineering","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-26T09:10:43Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:34:31Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Emerging applications such as autonomous driving and industrial automation demand ultra-reliable and low-latency communication (URLLC), where maintaining fresh and timely information is critical. A key performance metric in such systems is the age of information (AoI). This paper addresses AoI minimization in a multi-user uplink wireless network using non-orthogonal multiple access (NOMA), where users offload tasks to a base station. The system must handle user heterogeneity in task sizes, AoI thresholds, and penalty sensitivities, while adhering to NOMA constraints on user scheduling. We propose a deep reinforcement learning (DRL) framework based on proximal policy optimization (PPO), enhanced with a Transformer encoder. The attention mechanism allows the agent to focus on critical user states and capture inter-user dependencies, improving policy performance and scalability. Extensive simulations show that our method reduces average AoI compared to baselines. We also analyze the evolution of attention weights during training and observe that the model progressively learns to prioritize high-importance users. Attention maps reveal meaningful structure: early-stage policies exhibit uniform attention, while later stages show focused patterns aligned with user priority and NOMA constraints. These results highlight the promise of attention-driven DRL for intelligent, priority-aware resource allocation in next-generation wireless systems."},{"descriptionType":"Other","description":"\\c{opyright} 2026 IEEE. Personal use of this material is permitted. Permission from IEEE must be obtained for all other uses. Accepted for publication in the 2026 IEEE International Conference on Machine Learning for Communication and Networking (ICMLCN)"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.22774","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T02:54:19Z","registered":"2026-02-27T02:54:19Z","published":null,"updated":"2026-02-27T02:54:19Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.22771","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.22771","identifiers":[{"identifier":"2602.22771","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Yusuke","familyName":"Watanabe","name":"Watanabe, Yusuke","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yohei","familyName":"Kobashi","name":"Kobashi, Yohei","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Takeshi","familyName":"Kojima","name":"Kojima, Takeshi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yusuke","familyName":"Iwasawa","name":"Iwasawa, Yusuke","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yasushi","familyName":"Okuno","name":"Okuno, Yasushi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yutaka","familyName":"Matsuo","name":"Matsuo, Yutaka","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"ClinDet-Bench: Beyond Abstention, Evaluating Judgment Determinability of LLMs in Clinical Decision-Making"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"Databases (cs.DB)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-26T09:03:41Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:34:10Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Clinical decisions are often required under incomplete information. Clinical experts must identify whether available information is sufficient for judgment, as both premature conclusion and unnecessary abstention can compromise patient safety. To evaluate this capability of large language models (LLMs), we developed ClinDet-Bench, a benchmark based on clinical scoring systems that decomposes incomplete-information scenarios into determinable and undeterminable conditions. Identifying determinability requires considering all hypotheses about missing information, including unlikely ones, and verifying whether the conclusion holds across them. We find that recent LLMs fail to identify determinability under incomplete information, producing both premature judgments and excessive abstention, despite correctly explaining the underlying scoring knowledge and performing well under complete information. These findings suggest that existing benchmarks are insufficient to evaluate the safety of LLMs in clinical settings. ClinDet-Bench provides a framework for evaluating determinability recognition, leading to appropriate abstention, with potential applicability to medicine and other high-stakes domains, and is publicly available."},{"descriptionType":"Other","description":"17 pages, 3 figures, 10 tables"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.22771","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T02:54:14Z","registered":"2026-02-27T02:54:15Z","published":null,"updated":"2026-02-27T02:54:15Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.22765","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.22765","identifiers":[{"identifier":"2602.22765","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Zhe","familyName":"Yang","name":"Yang, Zhe","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yudong","familyName":"Wang","name":"Wang, Yudong","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Rang","familyName":"Li","name":"Li, Rang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zhifang","familyName":"Sui","name":"Sui, Zhifang","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Towards Better RL Training Data Utilization via Second-Order Rollout"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-26T08:55:58Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:33:52Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Reinforcement Learning (RL) has empowered Large Language Models (LLMs) with strong reasoning capabilities, but vanilla RL mainly focuses on generation capability improvement by training with only first-order rollout (generating multiple responses for a question), and we argue that this approach fails to fully exploit the potential of training data because of the neglect of critique capability training. To tackle this problem, we further introduce the concept of second-order rollout (generating multiple critiques for a response) and propose a unified framework for jointly training generation and critique capabilities. Extensive experiments across various models and datasets demonstrate that our approach can utilize training data more effectively than vanilla RL and achieve better performance under the same training data. Additionally, we uncover several insightful findings regarding second-order rollout and critique training, such as the importance of label balance in critique training and the noise problem of outcome-based rewards, which can be mitigated through sampling techniques. Our work offers a preliminary exploration of dynamic data augmentation and joint generation-critique training in RL, providing meaningful inspiration for the further advancement of RL training"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.22765","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T02:54:06Z","registered":"2026-02-27T02:54:07Z","published":null,"updated":"2026-02-27T02:54:07Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.22764","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.22764","identifiers":[{"identifier":"2602.22764","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Jiahong","familyName":"Xiang","name":"Xiang, Jiahong","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Wenxiao","familyName":"He","name":"He, Wenxiao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xihua","familyName":"Wang","name":"Wang, Xihua","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Hongliang","familyName":"Tian","name":"Tian, Hongliang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yuqun","familyName":"Zhang","name":"Zhang, Yuqun","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Evaluating and Improving Automated Repository-Level Rust Issue Resolution with LLM-based Agents"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Software Engineering (cs.SE)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-26T08:54:09Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:33:46Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[{"relationType":"IsVersionOf","relatedIdentifier":"10.1145/3744916.3773108","relatedIdentifierType":"DOI"}],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"The Rust programming language presents a steep learning curve and significant coding challenges, making the automation of issue resolution essential for its broader adoption. Recently, LLM-powered code agents have shown remarkable success in resolving complex software engineering tasks, yet their application to Rust has been limited by the absence of a large-scale, repository-level benchmark. To bridge this gap, we introduce Rust-SWE-bench, a benchmark comprising 500 real-world, repository-level software engineering tasks from 34 diverse and popular Rust repositories. We then perform a comprehensive study on Rust-SWE-bench with four representative agents and four state-of-the-art LLMs to establish a foundational understanding of their capabilities and limitations in the Rust ecosystem. Our extensive study reveals that while ReAct-style agents are promising, i.e., resolving up to 21.2% of issues, they are limited by two primary challenges: comprehending repository-wide code structure and complying with Rust's strict type and trait semantics. We also find that issue reproduction is rather critical for task resolution. Inspired by these findings, we propose RUSTFORGER, a novel agentic approach that integrates an automated test environment setup with a Rust metaprogramming-driven dynamic tracing strategy to facilitate reliable issue reproduction and dynamic analysis. The evaluation shows that RUSTFORGER using Claude-Sonnet-3.7 significantly outperforms all baselines, resolving 28.6% of tasks on Rust-SWE-bench, i.e., a 34.9% improvement over the strongest baseline, and, in aggregate, uniquely solves 46 tasks that no other agent could solve across all adopted advanced LLMs."},{"descriptionType":"Other","description":"Accepted to the 48th International Conference on Software Engineering (ICSE 2026)"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.22764","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":1,"created":"2026-02-27T02:54:05Z","registered":"2026-02-27T02:54:05Z","published":null,"updated":"2026-02-27T02:54:05Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.22762","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.22762","identifiers":[{"identifier":"2602.22762","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Rui","familyName":"Liu","name":"Liu, Rui","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"An AI-Based Structured Semantic Control Model for Stable and Coherent Dynamic Interactive Content Generation"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Human-Computer Interaction (cs.HC)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-26T08:53:35Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:33:44Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"This study addresses the challenge that generative models struggle to balance flexibility, stability, and controllability in complex interactive scenarios. It proposes a controllable generation framework for dynamic interactive content construction. The framework builds a structured semantic state space that encodes user input, environmental conditions, and historical context into actionable latent representations and generates directional control vectors to guide the content generation process. It introduces multilevel constraints, including semantic consistency constraints, structural stability constraints, and semantic drift penalties, which help the model maintain clear semantic paths and coherent logic in dynamic environments. These constraints prevent content deviation, unstable tone, or structural breaks. Based on these components, the study designs a systematic controllable generation pipeline in which semantic modeling, control signals, and generation strategies work together within one framework. Sensitivity analyses on control vector dimension, hidden layer size, noise intensity, and training sample scale are conducted on a public dialogue dataset to validate the framework. The results show that the approach improves semantic structure, contextual consistency, and controllable expression, providing a structured and effective solution for interactive content generation."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.22762","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T02:54:02Z","registered":"2026-02-27T02:54:02Z","published":null,"updated":"2026-02-27T02:54:02Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.22760","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.22760","identifiers":[{"identifier":"2602.22760","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Philipp","familyName":"Wiesner","name":"Wiesner, Philipp","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Soeren","familyName":"Becker","name":"Becker, Soeren","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Brett","familyName":"Cornick","name":"Cornick, Brett","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Dominik","familyName":"Scheinert","name":"Scheinert, Dominik","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Alexander","familyName":"Acker","name":"Acker, Alexander","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Odej","familyName":"Kao","name":"Kao, Odej","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Distributed LLM Pretraining During Renewable Curtailment Windows: A Feasibility Study"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Distributed, Parallel, and Cluster Computing (cs.DC)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-26T08:49:57Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:33:30Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Training large language models (LLMs) requires substantial compute and energy. At the same time, renewable energy sources regularly produce more electricity than the grid can absorb, leading to curtailment, the deliberate reduction of clean generation that would otherwise go to waste. These periods represent an opportunity: if training is aligned with curtailment windows, LLMs can be pretrained using electricity that is both clean and cheap. This technical report presents a system that performs full-parameter LLM training across geo-distributed GPU clusters during regional curtailment windows, elastically switching between local single-site training and federated multi-site synchronization as sites become available or unavailable. Our prototype trains a 561M-parameter transformer model across three clusters using the Flower federated learning framework, with curtailment periods derived from real-world marginal carbon intensity traces. Preliminary results show that curtailment-aware scheduling preserves training quality while reducing operational emissions to 5-12% of single-site baselines."},{"descriptionType":"Other","description":"Technical report"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.22760","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T02:53:59Z","registered":"2026-02-27T02:53:59Z","published":null,"updated":"2026-02-27T02:53:59Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.22759","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.22759","identifiers":[{"identifier":"2602.22759","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Yuan-Chih","familyName":"Chen","name":"Chen, Yuan-Chih","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Chun-Shien","familyName":"Lu","name":"Lu, Chun-Shien","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Beyond Detection: Multi-Scale Hidden-Code for Natural Image Deepfake Recovery and Factual Retrieval"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-26T08:47:48Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:33:17Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Recent advances in image authenticity have primarily focused on deepfake detection and localization, leaving recovery of tampered contents for factual retrieval relatively underexplored. We propose a unified hidden-code recovery framework that enables both retrieval and restoration from post-hoc and in-generation watermarking paradigms. Our method encodes semantic and perceptual information into a compact hidden-code representation, refined through multi-scale vector quantization, and enhances contextual reasoning via conditional Transformer modules. To enable systematic evaluation for natural images, we construct ImageNet-S, a benchmark that provides paired image-label factual retrieval tasks. Extensive experiments on ImageNet-S demonstrate that our method exhibits promising retrieval and reconstruction performance while remaining fully compatible with diverse watermarking pipelines. This framework establishes a foundation for general-purpose image recovery beyond detection and localization."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.22759","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T02:53:57Z","registered":"2026-02-27T02:53:58Z","published":null,"updated":"2026-02-27T02:53:58Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.22756","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.22756","identifiers":[{"identifier":"2602.22756","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Yen-Chieh","familyName":"Wu","name":"Wu, Yen-Chieh","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Cheng-Shang","familyName":"Chang","name":"Chang, Cheng-Shang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Duan-Shin","familyName":"Lee","name":"Lee, Duan-Shin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"H. Jonathan","familyName":"Chao","name":"Chao, H. Jonathan","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Dynamic Hierarchical Birkhoff-von Neumann Decomposition for All-to-All GPU Communication"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Networking and Internet Architecture (cs.NI)","lang":"en","subjectScheme":"arXiv"},{"subject":"Distributed, Parallel, and Cluster Computing (cs.DC)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-26T08:44:39Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:33:00Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"All-to-all GPU communication is a critical bottleneck in large-scale training clusters, where completion time is constrained by per-port bandwidth and can be severely impacted by traffic skew across GPUs and network interface cards (NICs). This issue is amplified by the two-tier structure of modern GPU systems, which combine fast intra-server links with much slower inter-server networks. Motivated by recent system observations that highlight the importance of traffic reshaping and hierarchy awareness, we study all-to-all scheduling from an online switching and queueing-theoretic perspective.\n We propose a dynamic hierarchical Birkhoff--von Neumann (BvN) decomposition framework tailored to two-tier GPU fabrics. At each frame boundary, traffic is first balanced within each server using simple local operations to mitigate micro-level GPU/NIC skew while preserving aggregate server-to-server demand. A hierarchical BvN decomposition is then applied at the server level and refined into GPU-level matchings, significantly reducing decomposition complexity relative to a flat GPU-level approach. By integrating this construction with the dynamic frame sizing (DFS) principle, we obtain an online scheduler with provable stability under admissible Poisson arrivals. Simulations demonstrate substantial reductions in mean frame length, particularly under server-localized hotspot traffic."},{"descriptionType":"Other","description":"This work has been submitted to the IEEE for possible publication"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.22756","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T02:53:53Z","registered":"2026-02-27T02:53:54Z","published":null,"updated":"2026-02-27T02:53:54Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.22751","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.22751","identifiers":[{"identifier":"2602.22751","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Qiannian","familyName":"Zhao","name":"Zhao, Qiannian","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Chen","familyName":"Yang","name":"Yang, Chen","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jinhao","familyName":"Jing","name":"Jing, Jinhao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yunke","familyName":"Zhang","name":"Zhang, Yunke","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xuhui","familyName":"Ren","name":"Ren, Xuhui","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Lu","familyName":"Yu","name":"Yu, Lu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Shijie","familyName":"Zhang","name":"Zhang, Shijie","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Hongzhi","familyName":"Yin","name":"Yin, Hongzhi","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Know What You Know: Metacognitive Entropy Calibration for Verifiable RL Reasoning"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-26T08:40:06Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:32:53Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Large reasoning models (LRMs) have emerged as a powerful paradigm for solving complex real-world tasks. In practice, these models are predominantly trained via Reinforcement Learning with Verifiable Rewards (RLVR), yet most existing outcome-only RLVR pipelines rely almost exclusively on a binary correctness signal and largely ignore the model's intrinsic uncertainty. We term this discrepancy the uncertainty-reward mismatch, under which high- and low-uncertainty solutions are treated equivalently, preventing the policy from \"Know What You Know\" and impeding the shift from optimizing for correct answers to optimizing effective reasoning paths. This limitation is especially critical in reasoning-centric tasks such as mathematics and question answering, where performance hinges on the quality of the model's internal reasoning process rather than mere memorization of final answers. To address this, we propose EGPO, a metacognitive entropy calibration framework that explicitly integrates intrinsic uncertainty into RLVR for enhancing LRMs. EGPO estimates per-sample uncertainty using a zero-overhead entropy proxy derived from token-level likelihoods and aligns it with extrinsic correctness through an asymmetric calibration mechanism that preserves correct reasoning while selectively regulating overconfident failures, thereby enabling stable and uncertainty-aware policy optimization. Moreover, EGPO recovers informative learning signals from otherwise degenerate group-based rollouts without modifying the verifier or reward definition. Extensive experiments across multiple benchmarks demonstrate that the proposed EGPO leads to substantial and consistent improvements in reasoning performance, establishing a principled path for advancing LRMs through metacognitive entropy calibration."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.22751","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T02:53:44Z","registered":"2026-02-27T02:53:45Z","published":null,"updated":"2026-02-27T02:53:45Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.22750","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.22750","identifiers":[{"identifier":"2602.22750","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Gaston","familyName":"Besanson","name":"Besanson, Gaston","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Marcelo","familyName":"Celani","name":"Celani, Marcelo","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"The Inference Bottleneck: Antitrust and Neutrality Duties in the Age of Cognitive Infrastructure"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Computers and Society (cs.CY)","lang":"en","subjectScheme":"arXiv"},{"subject":"General Economics (econ.GN)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"FOS: Economics and business","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Economics and business","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-26T08:37:32Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:32:53Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"As generative AI commercializes, competitive advantage is shifting from one-time model training toward continuous inference, distribution, and routing. At the frontier, large-scale inference can function as cognitive infrastructure: a bottleneck input that downstream applications rely on to compete, controlled by firms that often compete downstream through integrated assistants, productivity suites, and developer tooling. Foreclosure risk is not limited to price. It can be executed through non-price discrimination (latency, throughput, error rates, context limits, feature gating) and, where models select tools and services, through steering and default routing that is difficult to observe and harder to litigate. This essay makes three moves. First, it defines cognitive infrastructure as a falsifiable concept built around measurable reliance, vertical incentives, and discrimination capacity, without assuming a clean market definition. Second, it frames theories of harm using raising-rivals'-costs logic for vertically related and platform markets, where foreclosure can be profitable without anticompetitive pricing. Third, it proposes Neutral Inference: a targeted, auditable conduct approach built around (i) quality-of-service parity, (ii) routing transparency, and (iii) FRAND-style non-discrimination for similarly situated buyers, applied only when observable evidence indicates functional gatekeeper status."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.22750","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T02:53:43Z","registered":"2026-02-27T02:53:44Z","published":null,"updated":"2026-02-27T02:53:44Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.22742","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.22742","identifiers":[{"identifier":"2602.22742","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Akihisa","familyName":"Watanabe","name":"Watanabe, Akihisa","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Qing","familyName":"Yu","name":"Yu, Qing","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Edgar","familyName":"Simo-Serra","name":"Simo-Serra, Edgar","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Kent","familyName":"Fujiwara","name":"Fujiwara, Kent","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"ProjFlow: Projection Sampling with Flow Matching for Zero-Shot Exact Spatial Motion Control"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-26T08:29:25Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:32:27Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Generating human motion with precise spatial control is a challenging problem. Existing approaches often require task-specific training or slow optimization, and enforcing hard constraints frequently disrupts motion naturalness. Building on the observation that many animation tasks can be formulated as a linear inverse problem, we introduce ProjFlow, a training-free sampler that achieves zero-shot, exact satisfaction of linear spatial constraints while preserving motion realism. Our key advance is a novel kinematics-aware metric that encodes skeletal topology. This metric allows the sampler to enforce hard constraints by distributing corrections coherently across the entire skeleton, avoiding the unnatural artifacts of naive projection. Furthermore, for sparse inputs, such as filling in long gaps between a few keyframes, we introduce a time-varying formulation using pseudo-observations that fade during sampling. Extensive experiments on representative applications, motion inpainting, and 2D-to-3D lifting, demonstrate that ProjFlow achieves exact constraint satisfaction and matches or improves realism over zero-shot baselines, while remaining competitive with training-based controllers."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.22742","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T02:53:32Z","registered":"2026-02-27T02:53:33Z","published":null,"updated":"2026-02-27T02:53:33Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.22727","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.22727","identifiers":[{"identifier":"2602.22727","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Yangguang","familyName":"Lin","name":"Lin, Yangguang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Quan","familyName":"Fang","name":"Fang, Quan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yufei","familyName":"Li","name":"Li, Yufei","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jiachen","familyName":"Sun","name":"Sun, Jiachen","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Junyu","familyName":"Gao","name":"Gao, Junyu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jitao","familyName":"Sang","name":"Sang, Jitao","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"HulluEdit: Single-Pass Evidence-Consistent Subspace Editing for Mitigating Hallucinations in Large Vision-Language Models"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-26T08:08:25Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:31:41Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Object hallucination in Large Vision-Language Models (LVLMs) significantly hinders their reliable deployment. Existing methods struggle to balance efficiency and accuracy: they often require expensive reference models and multiple forward passes, or apply static edits that risk suppressing genuine visual evidence. To address this, we introduce HulluEdit, a single-pass, reference-free intervention framework. Our core innovation is orthogonal subspace editing: we decompose the hidden states of the model into orthogonal subspaces - visual evidence, conflicting priors, and residual uncertainty - enabling selective suppression of hallucinatory patterns without interfering with visual grounding. This approach mathematically guarantees that edits applied to the prior subspace leave the visual component entirely unaffected. Extensive experiments show that HulluEdit achieves state-of-the-art hallucination reduction on benchmarks including POPE and CHAIR across diverse architectures, while preserving general capabilities on MME and maintaining efficient inference. Our method consistently outperforms contrastive decoding and static subspace editing baselines, offering a new pathway toward more trustworthy LVLMs."},{"descriptionType":"Other","description":"accepted at CVPR 2026"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.22727","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T02:53:11Z","registered":"2026-02-27T02:53:12Z","published":null,"updated":"2026-02-27T02:53:12Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.22724","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.22724","identifiers":[{"identifier":"2602.22724","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Tian","familyName":"Zhang","name":"Zhang, Tian","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yiwei","familyName":"Xu","name":"Xu, Yiwei","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Juan","familyName":"Wang","name":"Wang, Juan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Keyan","familyName":"Guo","name":"Guo, Keyan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xiaoyang","familyName":"Xu","name":"Xu, Xiaoyang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Bowen","familyName":"Xiao","name":"Xiao, Bowen","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Quanlong","familyName":"Guan","name":"Guan, Quanlong","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jinlin","familyName":"Fan","name":"Fan, Jinlin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jiawei","familyName":"Liu","name":"Liu, Jiawei","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zhiquan","familyName":"Liu","name":"Liu, Zhiquan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Hongxin","familyName":"Hu","name":"Hu, Hongxin","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"AgentSentry: Mitigating Indirect Prompt Injection in LLM Agents via Temporal Causal Diagnostics and Context Purification"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Cryptography and Security (cs.CR)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"D.4.6; K.6.5; I.2.7","lang":"en","subjectScheme":"ACM"}],"contributors":[],"dates":[{"date":"2026-02-26T07:59:10Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:31:21Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Large language model (LLM) agents increasingly rely on external tools and retrieval systems to autonomously complete complex tasks. However, this design exposes agents to indirect prompt injection (IPI), where attacker-controlled context embedded in tool outputs or retrieved content silently steers agent actions away from user intent. Unlike prompt-based attacks, IPI unfolds over multi-turn trajectories, making malicious control difficult to disentangle from legitimate task execution. Existing inference-time defenses primarily rely on heuristic detection and conservative blocking of high-risk actions, which can prematurely terminate workflows or broadly suppress tool usage under ambiguous multi-turn scenarios. We propose AgentSentry, a novel inference-time detection and mitigation framework for tool-augmented LLM agents. To the best of our knowledge, AgentSentry is the first inference-time defense to model multi-turn IPI as a temporal causal takeover. It localizes takeover points via controlled counterfactual re-executions at tool-return boundaries and enables safe continuation through causally guided context purification that removes attack-induced deviations while preserving task-relevant evidence. We evaluate AgentSentry on the \\textsc{AgentDojo} benchmark across four task suites, three IPI attack families, and multiple black-box LLMs. AgentSentry eliminates successful attacks and maintains strong utility under attack, achieving an average Utility Under Attack (UA) of 74.55 %, improving UA by 20.8 to 33.6 percentage points over the strongest baselines without degrading benign performance."},{"descriptionType":"Other","description":"23 pages, 8 figures. Under review"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.22724","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T02:53:07Z","registered":"2026-02-27T02:53:07Z","published":null,"updated":"2026-02-27T02:53:07Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.22723","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.22723","identifiers":[{"identifier":"2602.22723","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Frances","familyName":"Yung","name":"Yung, Frances","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Daniil","familyName":"Ignatev","name":"Ignatev, Daniil","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Merel","familyName":"Scholman","name":"Scholman, Merel","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Vera","familyName":"Demberg","name":"Demberg, Vera","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Massimo","familyName":"Poesio","name":"Poesio, Massimo","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Human Label Variation in Implicit Discourse Relation Recognition"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-26T07:56:24Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:31:20Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by-sa/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution Share Alike 4.0 International","rightsIdentifier":"cc-by-sa-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"There is growing recognition that many NLP tasks lack a single ground truth, as human judgments reflect diverse perspectives. To capture this variation, models have been developed to predict full annotation distributions rather than majority labels, while perspectivist models aim to reproduce the interpretations of individual annotators. In this work, we compare these approaches on Implicit Discourse Relation Recognition (IDRR), a highly ambiguous task where disagreement often arises from cognitive complexity rather than ideological bias. Our experiments show that existing annotator-specific models perform poorly in IDRR unless ambiguity is reduced, whereas models trained on label distributions yield more stable predictions. Further analysis indicates that frequent cognitively demanding cases drive inconsistency in human interpretation, posing challenges for perspectivist modeling in IDRR."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.22723","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T02:53:05Z","registered":"2026-02-27T02:53:06Z","published":null,"updated":"2026-02-27T02:53:06Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.22718","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.22718","identifiers":[{"identifier":"2602.22718","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Rui","familyName":"Wei","name":"Wei, Rui","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Hanfei","familyName":"Yu","name":"Yu, Hanfei","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Shubham","familyName":"Jain","name":"Jain, Shubham","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yogarajan","familyName":"Sivakumar","name":"Sivakumar, Yogarajan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Devesh","familyName":"Tiwari","name":"Tiwari, Devesh","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jian","familyName":"Li","name":"Li, Jian","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Seung-Jong","familyName":"Park","name":"Park, Seung-Jong","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Hao","familyName":"Wang","name":"Wang, Hao","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"RLHFless: Serverless Computing for Efficient RLHF"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"Distributed, Parallel, and Cluster Computing (cs.DC)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-26T07:45:37Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:30:54Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Reinforcement Learning from Human Feedback (RLHF) has been widely applied to Large Language Model (LLM) post-training to align model outputs with human preferences. Recent models, such as DeepSeek-R1, have also shown RLHF's potential to improve LLM reasoning on complex tasks. In RL, inference and training co-exist, creating dynamic resource demands throughout the workflow. Compared to traditional RL, RLHF further challenges training efficiency due to expanding model sizes and resource consumption. Several RLHF frameworks aim to balance flexible abstraction and efficient execution. However, they rely on serverful infrastructures, which struggle with fine-grained resource variability. As a result, during synchronous RLHF training, idle time between or within RL components often causes overhead and resource wastage.\n To address these issues, we present RLHFless, the first scalable training framework for synchronous RLHF, built on serverless computing environments. RLHFless adapts to dynamic resource demands throughout the RLHF pipeline, pre-computes shared prefixes to avoid repeated computation, and uses a cost-aware actor scaling strategy that accounts for response length variation to find sweet spots with lower cost and higher speed. In addition, RLHFless assigns workloads efficiently to reduce intra-function imbalance and idle time. Experiments on both physical testbeds and a large-scale simulated cluster show that RLHFless achieves up to 1.35x speedup and 44.8% cost reduction compared to the state-of-the-art baseline."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.22718","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T02:52:58Z","registered":"2026-02-27T02:52:59Z","published":null,"updated":"2026-02-27T02:52:59Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.22717","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.22717","identifiers":[{"identifier":"2602.22717","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Shuoqi","familyName":"Chen","name":"Chen, Shuoqi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yujia","familyName":"Wu","name":"Wu, Yujia","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Geoffrey P.","familyName":"Luke","name":"Luke, Geoffrey P.","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"IRSDE-Despeckle: A Physics-Grounded Diffusion Model for Generalizable Ultrasound Despeckling"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-26T07:42:25Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:30:53Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Ultrasound imaging is widely used for real-time, noninvasive diagnosis, but speckle and related artifacts reduce image quality and can hinder interpretation. We present a diffusion-based ultrasound despeckling method built on the Image Restoration Stochastic Differential Equations framework. To enable supervised training, we curate large paired datasets by simulating ultrasound images from speckle-free magnetic resonance images using the Matlab UltraSound Toolbox. The proposed model reconstructs speckle-suppressed images while preserving anatomically meaningful edges and contrast. On a held-out simulated test set, our approach consistently outperforms classical filters and recent learning-based despeckling baselines. We quantify prediction uncertainty via cross-model variance and show that higher uncertainty correlates with higher reconstruction error, providing a practical indicator of difficult or failure-prone regions. Finally, we evaluate sensitivity to simulation probe settings and observe domain shift, motivating diversified training and adaptation for robust clinical deployment."},{"descriptionType":"Other","description":"12 pages main text + 6 pages appendix, 7 figures main + 3 figures appendix, 3 tables main + 1 table appendix. Preprint"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.22717","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T02:52:57Z","registered":"2026-02-27T02:52:58Z","published":null,"updated":"2026-02-27T02:52:58Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.22716","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.22716","identifiers":[{"identifier":"2602.22716","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Guanting","familyName":"Ye","name":"Ye, Guanting","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Qiyan","familyName":"Zhao","name":"Zhao, Qiyan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Wenhao","familyName":"Yu","name":"Yu, Wenhao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Liangyu","familyName":"Yuan","name":"Yuan, Liangyu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Mingkai","familyName":"Li","name":"Li, Mingkai","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xiaofeng","familyName":"Zhang","name":"Zhang, Xiaofeng","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jianmin","familyName":"Ji","name":"Ji, Jianmin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yanyong","familyName":"Zhang","name":"Zhang, Yanyong","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Qing","familyName":"Jiang","name":"Jiang, Qing","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ka-Veng","familyName":"Yuen","name":"Yuen, Ka-Veng","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"SoPE: Spherical Coordinate-Based Positional Embedding for Enhancing Spatial Perception of 3D LVLMs"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-26T07:42:15Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:30:50Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"3D Large Vision-Language Models (3D LVLMs) built upon Large Language Models (LLMs) have achieved remarkable progress across various multimodal tasks. However, their inherited position-dependent modeling mechanism, Rotary Position Embedding (RoPE), remains suboptimal for 3D multimodal understanding. The vanilla RoPE formulation fails to preserve essential three-dimensional spatial structures when encoding 3D tokens, and its relative distance computation overlooks angular dependencies, hindering the model's ability to capture directional variations in visual representations. To overcome these limitations, we introduce Spherical Coordinate-based Positional Embedding (SoPE). Our method maps point-cloud token indices into a 3D spherical coordinate space, enabling unified modeling of spatial locations and directional angles. This formulation preserves the inherent geometric structure of point-cloud data, enhances spatial awareness, and yields more consistent and expressive geometric representations for multimodal learning. In addition, we introduce a multi-scale frequency mixing strategy to fuse feature information across different frequency domains. Experimental results on multiple 3D scene benchmarks validate the effectiveness of our approach, while real-world deployment experiments further demonstrate its strong generalization capability."},{"descriptionType":"Other","description":"CVPR 2026"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.22716","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T02:52:56Z","registered":"2026-02-27T02:52:56Z","published":null,"updated":"2026-02-27T02:52:56Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.22711","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.22711","identifiers":[{"identifier":"2602.22711","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Zhijian","familyName":"Luo","name":"Luo, Zhijian","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yangyang","familyName":"Li","name":"Li, Yangyang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jianzhen","familyName":"Chen","name":"Chen, Jianzhen","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Qishen","familyName":"Cao","name":"Cao, Qishen","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Duo","familyName":"Cao","name":"Cao, Duo","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Shaohua","familyName":"Zhang","name":"Zhang, Shaohua","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Hubing","familyName":"Xiao","name":"Xiao, Hubing","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Chenggang","familyName":"Shu","name":"Shu, Chenggang","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Beyond Colors: Probing Redshifts from Galaxy Morphology in Single-band Images with ViT-MDNz"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Astrophysics of Galaxies (astro-ph.GA)","lang":"en","subjectScheme":"arXiv"},{"subject":"Instrumentation and Methods for Astrophysics (astro-ph.IM)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-26T07:35:41Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:30:27Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"To address the challenge of estimating redshifts when only single-band images are available, this study introduces a deep learning model named ViT-MDNz. Leveraging robust statistical priors learned from large-scale data concerning the correlation between redshift and morphology, the model can directly estimate redshifts and their associated uncertainties from single-band galaxy images. It integrates a Vision Transformer (ViT) to extract deep morphological features and a Mixture Density Network (MDN) to predict the full redshift probability density function. Trained and evaluated on approximately 300,000 single-band images from the DESI Legacy Imaging Surveys (DESI-LS), the model achieves a normalized median absolute deviation $σ_{\\rm NMAD} = 0.034$ and an outlier fraction $f_{\\rm out} = 2.6\\%$ in the $r$-band for redshifts up to $z \\lesssim 1$. Evaluations using probability integral transform (PIT) and continuous ranked probability score (CRPS) confirm that the predicted probability density functions are well calibrated and closely match the true distribution. These results demonstrate that competitive redshift estimates can be obtained using morphological features alone, and that incorporating color information further enhances the accuracy and robustness of the estimation. Therefore, ViT-MDNz provides a practical approach for redshift estimation of galaxy samples with limited photometric band coverage, contributing to improved completeness and usability of redshift catalogs for future large-scale surveys such as DESI and LSST."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.22711","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T02:52:49Z","registered":"2026-02-27T02:52:50Z","published":null,"updated":"2026-02-27T02:52:50Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.22703","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.22703","identifiers":[{"identifier":"2602.22703","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Hao","familyName":"Yu","name":"Yu, Hao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Shuning","familyName":"Jia","name":"Jia, Shuning","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Guanghao","familyName":"Li","name":"Li, Guanghao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Wenhao","familyName":"Jiang","name":"Jiang, Wenhao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Chun","familyName":"Yuan","name":"Yuan, Chun","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Enhancing Geometric Perception in VLMs via Translator-Guided Reinforcement Learning"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-26T07:28:04Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:30:10Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Vision-language models (VLMs) often struggle with geometric reasoning due to their limited perception of fundamental diagram elements. To tackle this challenge, we introduce GeoPerceive, a benchmark comprising diagram instances paired with domain-specific language (DSL) representations, along with an efficient automatic data generation pipeline. This design enables the isolated evaluation of geometric perception independently from reasoning. To exploit the data provided by GeoPerceive for enhancing the geometric perception capabilities of VLMs, we propose GeoDPO, a translator-guided reinforcement learning (RL) framework. GeoDPO employs an NL-to-DSL translator, which is trained on synthetic pairs generated by the data engine of GeoPerceive, to bridge natural language and DSL. This translator facilitates the computation of fine-grained, DSL-level scores, which serve as reward signals in reinforcement learning. We assess GeoDPO on both in-domain and out-of-domain datasets, spanning tasks in geometric perception as well as downstream reasoning. Experimental results demonstrate that, while supervised fine-tuning (SFT) offers only marginal improvements and may even impair performance in out-of-domain scenarios, GeoDPO achieves substantial gains: $+26.5\\%$ on in-domain data, $+8.0\\%$ on out-of-domain data, and $+39.0\\%$ on downstream reasoning tasks. These findings underscore the superior performance and generalization ability of GeoDPO over SFT. All codes are released at https://github.com/Longin-Yu/GeoPerceive\n to ensure reproducibility."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.22703","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T02:52:38Z","registered":"2026-02-27T02:52:38Z","published":null,"updated":"2026-02-27T02:52:38Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.22702","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.22702","identifiers":[{"identifier":"2602.22702","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Siyu","familyName":"Jiang","name":"Jiang, Siyu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Sanshuai","familyName":"Cui","name":"Cui, Sanshuai","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Hui","familyName":"Zeng","name":"Zeng, Hui","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Knob: A Physics-Inspired Gating Interface for Interpretable and Controllable Neural Dynamics"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-26T07:25:22Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:30:04Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Existing neural network calibration methods often treat calibration as a static, post-hoc optimization task. However, this neglects the dynamic and temporal nature of real-world inference. Moreover, existing methods do not provide an intuitive interface enabling human operators to dynamically adjust model behavior under shifting conditions. In this work, we propose Knob, a framework that connects deep learning with classical control theory by mapping neural gating dynamics to a second-order mechanical system. By establishing correspondences between physical parameters -- damping ratio ($ζ$) and natural frequency ($ω_n$) -- and neural gating, we create a tunable \"safety valve\". The core mechanism employs a logit-level convex fusion, functioning as an input-adaptive temperature scaling. It tends to reduce model confidence particularly when model branches produce conflicting predictions. Furthermore, by imposing second-order dynamics (Knob-ODE), we enable a \\textit{dual-mode} inference: standard i.i.d. processing for static tasks, and state-preserving processing for continuous streams. Our framework allows operators to tune \"stability\" and \"sensitivity\" through familiar physical analogues. This paper presents an exploratory architectural interface; we focus on demonstrating the concept and validating its control-theoretic properties rather than claiming state-of-the-art calibration performance. Experiments on CIFAR-10-C validate the calibration mechanism and demonstrate that, in Continuous Mode, the gate responses are consistent with standard second-order control signatures (step settling and low-pass attenuation), paving the way for predictable human-in-the-loop tuning."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.22702","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T02:52:36Z","registered":"2026-02-27T02:52:37Z","published":null,"updated":"2026-02-27T02:52:37Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.22701","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.22701","identifiers":[{"identifier":"2602.22701","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Can","familyName":"Yao","name":"Yao, Can","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Kang","familyName":"Wu","name":"Wu, Kang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zuheng","familyName":"Zheng","name":"Zheng, Zuheng","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Siyuan","familyName":"Xing","name":"Xing, Siyuan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xiao-Ming","familyName":"Fu","name":"Fu, Xiao-Ming","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"BRepMAE: Self-Supervised Masked BRep Autoencoders for Machining Feature Recognition"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Graphics (cs.GR)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-26T07:22:32Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:30:02Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"We propose a masked self-supervised learning framework, called BRepMAE, for automatically extracting a valuable representation of the input computer-aided design (CAD) model to recognize its machining features. Representation learning is conducted on a large-scale, unlabeled CAD model dataset using the geometric Attributed Adjacency Graph (gAAG) representation, derived from the boundary representation (BRep). The self-supervised network is a masked graph autoencoder (MAE) that focuses on reconstructing geometries and attributes of BRep facets, rather than graph structures. After pre-training, we fine-tune a network that contains both the encoder and a task-specific classification network for machining feature recognition (MFR). In the experiments, our fine-tuned network achieves high recognition rates with only a small amount of data (e.g., 0.1% of the training data), significantly enhancing its practicality in real-world (or private) scenarios where only limited data is available. Compared with other MFR methods, our fine-tuned network achieves a significant improvement in recognition rate with the same amount of training data, especially when the number of training samples is limited."},{"descriptionType":"Other","description":"16 pages"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.22701","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T02:52:35Z","registered":"2026-02-27T02:52:36Z","published":null,"updated":"2026-02-27T02:52:36Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.22700","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.22700","identifiers":[{"identifier":"2602.22700","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Yanpei","familyName":"Guo","name":"Guo, Yanpei","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Wenjie","familyName":"Qu","name":"Qu, Wenjie","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Linyu","familyName":"Wu","name":"Wu, Linyu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Shengfang","familyName":"Zhai","name":"Zhai, Shengfang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Lionel Z.","familyName":"Wang","name":"Wang, Lionel Z.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ming","familyName":"Xu","name":"Xu, Ming","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yue","familyName":"Liu","name":"Liu, Yue","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Binhang","familyName":"Yuan","name":"Yuan, Binhang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Dawn","familyName":"Song","name":"Song, Dawn","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jiaheng","familyName":"Zhang","name":"Zhang, Jiaheng","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"IMMACULATE: A Practical LLM Auditing Framework via Verifiable Computation"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Cryptography and Security (cs.CR)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-26T07:21:02Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:30:01Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Commercial large language models are typically deployed as black-box API services, requiring users to trust providers to execute inference correctly and report token usage honestly. We present IMMACULATE, a practical auditing framework that detects economically motivated deviations-such as model substitution, quantization abuse, and token overbilling-without trusted hardware or access to model internals. IMMACULATE selectively audits a small fraction of requests using verifiable computation, achieving strong detection guarantees while amortizing cryptographic overhead. Experiments on dense and MoE models show that IMMACULATE reliably distinguishes benign and malicious executions with under 1% throughput overhead. Our code is published at https://github.com/guo-yanpei/Immaculate."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.22700","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T02:52:33Z","registered":"2026-02-27T02:52:34Z","published":null,"updated":"2026-02-27T02:52:34Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.22698","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.22698","identifiers":[{"identifier":"2602.22698","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Siyue","familyName":"Su","name":"Su, Siyue","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jian","familyName":"Yang","name":"Yang, Jian","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Bo","familyName":"Li","name":"Li, Bo","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Guanglin","familyName":"Niu","name":"Niu, Guanglin","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Tokenization, Fusion and Decoupling: Bridging the Granularity Mismatch Between Large Language Models and Knowledge Graphs"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-26T07:20:40Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:29:59Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Leveraging Large Language Models (LLMs) for Knowledge Graph Completion (KGC) is promising but hindered by a fundamental granularity mismatch. LLMs operate on fragmented token sequences, whereas entities are the fundamental units in knowledge graphs (KGs) scenarios. Existing approaches typically constrain predictions to limited candidate sets or align entities with the LLM's vocabulary by pooling multiple tokens or decomposing entities into fixed-length token sequences, which fail to capture both the semantic meaning of the text and the structural integrity of the graph. To address this, we propose KGT, a novel framework that uses dedicated entity tokens to enable efficient, full-space prediction. Specifically, we first introduce specialized tokenization to construct feature representations at the level of dedicated entity tokens. We then fuse pre-trained structural and textual features into these unified embeddings via a relation-guided gating mechanism, avoiding training from scratch. Finally, we implement decoupled prediction by leveraging independent heads to separate and combine semantic and structural reasoning. Experimental results show that KGT consistently outperforms state-of-the-art methods across multiple benchmarks."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.22698","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T02:52:30Z","registered":"2026-02-27T02:52:31Z","published":null,"updated":"2026-02-27T02:52:31Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.22697","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.22697","identifiers":[{"identifier":"2602.22697","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Ning","familyName":"Gao","name":"Gao, Ning","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Wei","familyName":"Zhang","name":"Zhang, Wei","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yuqin","familyName":"Dai","name":"Dai, Yuqin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ling","familyName":"Shi","name":"Shi, Ling","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ziyin","familyName":"Wang","name":"Wang, Ziyin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yujie","familyName":"Wang","name":"Wang, Yujie","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Wei","familyName":"He","name":"He, Wei","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jinpeng","familyName":"Wang","name":"Wang, Jinpeng","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Chaozheng","familyName":"Wang","name":"Wang, Chaozheng","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Reinforcing Real-world Service Agents: Balancing Utility and Cost in Task-oriented Dialogue"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-26T07:19:57Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:29:57Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"The rapid evolution of Large Language Models (LLMs) has accelerated the transition from conversational chatbots to general agents. However, effectively balancing empathetic communication with budget-aware decision-making remains an open challenge. Since existing methods fail to capture these complex strategic trade-offs, we propose InteractCS-RL, a framework that reframes task-oriented dialogue as a multi-granularity reinforcement learning process. Specifically, we first establish a User-centric Interaction Framework to provide a high-fidelity training gym, enabling agents to dynamically explore diverse strategies with persona-driven users. Then, we introduce Cost-aware Multi-turn Policy Optimization (CMPO) with a hybrid advantage estimation strategy. By integrating generative process credits and employing a PID-Lagrangian cost controller, CMPO effectively guides the policy to explore Pareto boundary between user reward and global cost constraints. Extensive experiments on customized real business scenarios demonstrate that InteractCS-RL significantly outperform other baselines across three evaluation dimensions. Further evaluation on tool-agent-user interaction benchmarks verify InteractCS-RL robustness across diverse domains."},{"descriptionType":"Other","description":"35 pages, 8 tables, 3 figures"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.22697","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T02:52:29Z","registered":"2026-02-27T02:52:30Z","published":null,"updated":"2026-02-27T02:52:30Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.22696","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.22696","identifiers":[{"identifier":"2602.22696","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Shinnosuke","familyName":"Nozue","name":"Nozue, Shinnosuke","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yuto","familyName":"Nakano","name":"Nakano, Yuto","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yotaro","familyName":"Watanabe","name":"Watanabe, Yotaro","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Meguru","familyName":"Takasaki","name":"Takasaki, Meguru","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Shoji","familyName":"Moriya","name":"Moriya, Shoji","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Reina","familyName":"Akama","name":"Akama, Reina","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jun","familyName":"Suzuki","name":"Suzuki, Jun","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Enhancing Persuasive Dialogue Agents by Synthesizing Cross-Disciplinary Communication Strategies"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-26T07:18:45Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:29:56Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[{"relationType":"IsVersionOf","relatedIdentifier":"10.18653/v1/2025.emnlp-industry.158","relatedIdentifierType":"DOI"}],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Current approaches to developing persuasive dialogue agents often rely on a limited set of predefined persuasive strategies that fail to capture the complexity of real-world interactions. We applied a cross-disciplinary approach to develop a framework for designing persuasive dialogue agents that draws on proven strategies from social psychology, behavioral economics, and communication theory. We validated our proposed framework through experiments on two distinct datasets: the Persuasion for Good dataset, which represents a specific in-domain scenario, and the DailyPersuasion dataset, which encompasses a wide range of scenarios. The proposed framework achieved strong results for both datasets and demonstrated notable improvement in the persuasion success rate as well as promising generalizability. Notably, the proposed framework also excelled at persuading individuals with initially low intent, which addresses a critical challenge for persuasive dialogue agents."},{"descriptionType":"Other","description":"Accepted to the EMNLP 2025 Industry Track; 26 pages"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.22696","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":1,"created":"2026-02-27T02:52:28Z","registered":"2026-02-27T02:52:28Z","published":null,"updated":"2026-02-27T02:52:28Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.22689","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.22689","identifiers":[{"identifier":"2602.22689","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Joonsung","familyName":"Jeon","name":"Jeon, Joonsung","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Woo Jae","familyName":"Kim","name":"Kim, Woo Jae","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Suhyeon","familyName":"Ha","name":"Ha, Suhyeon","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Sooel","familyName":"Son","name":"Son, Sooel","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Sung-Eui","familyName":"Yoon","name":"Yoon, Sung-Eui","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"No Caption, No Problem: Caption-Free Membership Inference via Model-Fitted Embeddings"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"Cryptography and Security (cs.CR)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-26T07:07:11Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:29:29Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by-nc-nd/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution Non Commercial No Derivatives 4.0 International","rightsIdentifier":"cc-by-nc-nd-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Latent diffusion models have achieved remarkable success in high-fidelity text-to-image generation, but their tendency to memorize training data raises critical privacy and intellectual property concerns. Membership inference attacks (MIAs) provide a principled way to audit such memorization by determining whether a given sample was included in training. However, existing approaches assume access to ground-truth captions. This assumption fails in realistic scenarios where only images are available and their textual annotations remain undisclosed, rendering prior methods ineffective when substituted with vision-language model (VLM) captions. In this work, we propose MoFit, a caption-free MIA framework that constructs synthetic conditioning inputs that are explicitly overfitted to the target model's generative manifold. Given a query image, MoFit proceeds in two stages: (i) model-fitted surrogate optimization, where a perturbation applied to the image is optimized to construct a surrogate in regions of the model's unconditional prior learned from member samples, and (ii) surrogate-driven embedding extraction, where a model-fitted embedding is derived from the surrogate and then used as a mismatched condition for the query image. This embedding amplifies conditional loss responses for member samples while leaving hold-outs relatively less affected, thereby enhancing separability in the absence of ground-truth captions. Our comprehensive experiments across multiple datasets and diffusion models demonstrate that MoFit consistently outperforms prior VLM-conditioned baselines and achieves performance competitive with caption-dependent methods."},{"descriptionType":"Other","description":"Accepted to ICLR 2026"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.22689","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T02:52:18Z","registered":"2026-02-27T02:52:19Z","published":null,"updated":"2026-02-27T02:52:19Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.22685","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.22685","identifiers":[{"identifier":"2602.22685","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Fabian","familyName":"Muşat","name":"Muşat, Fabian","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Simona","familyName":"Căbuz","name":"Căbuz, Simona","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Switch-Hurdle: A MoE Encoder with AR Hurdle Decoder for Intermittent Demand Forecasting"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-26T07:03:19Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:29:19Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Intermittent demand, a pattern characterized by long sequences of zero sales punctuated by sporadic, non-zero values, poses a persistent challenge in retail and supply chain forecasting. Both traditional methods, such as ARIMA, exponential smoothing, or Croston variants, as well as modern neural architectures such as DeepAR and Transformer-based models often underperform on such data, as they treat demand as a single continuous process or become computationally expensive when scaled across many sparse series. To address these limitations, we introduce Switch-Hurdle: a new framework that integrates a Mixture-of-Experts (MoE) encoder with a Hurdle-based probabilistic decoder. The encoder uses a sparse Top-1 expert routing during the forward pass yet approximately dense in the backward pass via a straight-through estimator (STE). The decoder follows a cross-attention autoregressive design with a shared hurdle head that explicitly separates the forecasting task into two components: a binary classification component estimating the probability of a sale, and a conditional regression component, predicting the quantity given a sale. This structured separation enables the model to capture both occurrence and magnitude processes inherent to intermittent demand. Empirical results on the M5 benchmark and a large proprietary retail dataset show that Switch-Hurdle achieves state-of-the-art prediction performance while maintaining scalability."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.22685","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T02:52:12Z","registered":"2026-02-27T02:52:13Z","published":null,"updated":"2026-02-27T02:52:13Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.22681","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.22681","identifiers":[{"identifier":"2602.22681","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Shuchen","familyName":"Zhu","name":"Zhu, Shuchen","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Rizhen","familyName":"Hu","name":"Hu, Rizhen","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Mingze","familyName":"Wang","name":"Wang, Mingze","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Mou","familyName":"Sun","name":"Sun, Mou","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xue","familyName":"Wang","name":"Wang, Xue","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Kun","familyName":"Yuan","name":"Yuan, Kun","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zaiwen","familyName":"Wen","name":"Wen, Zaiwen","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Accelerating LLM Pre-Training through Flat-Direction Dynamics Enhancement"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-26T06:54:57Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:28:58Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Pre-training Large Language Models requires immense computational resources, making optimizer efficiency essential. The optimization landscape is highly anisotropic, with loss reduction driven predominantly by progress along flat directions. While matrix-based optimizers such as Muon and SOAP leverage fine-grained curvature information to outperform AdamW, their updates tend toward isotropy -- relatively conservative along flat directions yet potentially aggressive along sharp ones. To address this limitation, we first establish a unified Riemannian Ordinary Differential Equation (ODE) framework that elucidates how common adaptive algorithms operate synergistically: the preconditioner induces a Riemannian geometry that mitigates ill-conditioning, while momentum serves as a Riemannian damping term that promotes convergence. Guided by these insights, we propose LITE, a generalized acceleration strategy that enhances training dynamics by applying larger Hessian damping coefficients and learning rates along flat trajectories. Extensive experiments demonstrate that LITE significantly accelerates both Muon and SOAP across diverse architectures (Dense, MoE), parameter scales (130M--1.3B), datasets (C4, Pile), and learning-rate schedules (cosine, warmup-stable-decay). Theoretical analysis confirms that LITE facilitates faster convergence along flat directions in anisotropic landscapes, providing a principled approach to efficient LLM pre-training. The code is available at https://github.com/SHUCHENZHU/LITE."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.22681","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T02:52:06Z","registered":"2026-02-27T02:52:07Z","published":null,"updated":"2026-02-27T02:52:07Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.22678","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.22678","identifiers":[{"identifier":"2602.22678","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Quoc-Khang","familyName":"Tran","name":"Tran, Quoc-Khang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Minh-Thien","familyName":"Nguyen","name":"Nguyen, Minh-Thien","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Nguyen-Khang","familyName":"Pham","name":"Pham, Nguyen-Khang","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"ViCLIP-OT: The First Foundation Vision-Language Model for Vietnamese Image-Text Retrieval with Optimal Transport"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-26T06:51:25Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:28:51Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Image-text retrieval has become a fundamental component in intelligent multimedia systems; however, most existing vision-language models are optimized for highresource languages and remain suboptimal for low-resource settings such as Vietnamese. This work introduces ViCLIP-OT, a foundation vision-language model specifically designed for Vietnamese image-text retrieval. The proposed framework integrates CLIP-style contrastive learning with a Similarity-Graph Regularized Optimal Transport (SIGROT) loss to enhance global cross-modal consistency and mitigate modality gap issues. Extensive experiments on three Vietnamese benchmarks (UITOpenViIC, KTVIC, and Crossmodal-3600) demonstrate that ViCLIP-OT consistently outperforms CLIP and SigLIP baselines in both in-domain and zero-shot settings. On UIT-OpenViIC, the model achieves an average Recall@K of 67.34%, improving upon CLIP by 5.75 percentage points. In zero-shot evaluation on Crossmodal-3600, ViCLIPOT surpasses CLIP by 11.72 percentage points. Embedding-space analysis further confirms improved alignment and reduced modality gap. The results indicate that integrating SIGROT provides an effective and scalable strategy for cross-modal retrieval in low-resource languages, offering practical implications for intelligent multimedia retrieval systems in Vietnamese and other underrepresented linguistic contexts."},{"descriptionType":"Other","description":"Preprint submitted to Expert Systems with Applications"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.22678","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T02:52:02Z","registered":"2026-02-27T02:52:03Z","published":null,"updated":"2026-02-27T02:52:03Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.22663","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.22663","identifiers":[{"identifier":"2602.22663","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Wenxuan","familyName":"Song","name":"Song, Wenxuan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jiayi","familyName":"Chen","name":"Chen, Jiayi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xiaoquan","familyName":"Sun","name":"Sun, Xiaoquan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Huashuo","familyName":"Lei","name":"Lei, Huashuo","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yikai","familyName":"Qin","name":"Qin, Yikai","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Wei","familyName":"Zhao","name":"Zhao, Wei","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Pengxiang","familyName":"Ding","name":"Ding, Pengxiang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Han","familyName":"Zhao","name":"Zhao, Han","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Tongxin","familyName":"Wang","name":"Wang, Tongxin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Pengxu","familyName":"Hou","name":"Hou, Pengxu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zhide","familyName":"Zhong","name":"Zhong, Zhide","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Haodong","familyName":"Yan","name":"Yan, Haodong","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Donglin","familyName":"Wang","name":"Wang, Donglin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jun","familyName":"Ma","name":"Ma, Jun","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Haoang","familyName":"Li","name":"Li, Haoang","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Rethinking the Practicality of Vision-language-action Model: A Comprehensive Benchmark and An Improved Baseline"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Robotics (cs.RO)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-26T06:27:37Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:27:52Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Vision-Language-Action (VLA) models have emerged as a generalist robotic agent. However, existing VLAs are hindered by excessive parameter scales, prohibitive pre-training requirements, and limited applicability to diverse embodiments. To improve the practicality of VLAs, we propose a comprehensive benchmark and an improved baseline. First, we propose CEBench, a new benchmark spanning diverse embodiments in both simulation and the real world with consideration of domain randomization. We collect 14.4k simulated trajectories and 1.6k real-world expert-curated trajectories to support training on CEBench. Second, using CEBench as our testbed, we study three critical aspects of VLAs' practicality and offer several key findings. Informed by these findings, we introduce LLaVA-VLA, a lightweight yet powerful VLA designed for practical deployment on consumer-grade GPUs. Architecturally, it integrates a compact VLM backbone with multi-view perception, proprioceptive tokenization, and action chunking. To eliminate reliance on costly pre-training, LLaVA-VLA adopts a two-stage training paradigm including post-training and fine-tuning. Furthermore, LLaVA-VLA extends the action space to unify navigation and manipulation. Experiments across embodiments demonstrate the capabilities of generalization and versatility of LLaVA-VLA , while real-world mobile manipulation experiments establish it as the first end-to-end VLA model for mobile manipulation. We will open-source all datasets, codes, and checkpoints upon acceptance to foster reproducibility and future research."},{"descriptionType":"Other","description":"Accepted by ICRA 2026"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.22663","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T02:51:41Z","registered":"2026-02-27T02:51:41Z","published":null,"updated":"2026-02-27T02:51:41Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.22661","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.22661","identifiers":[{"identifier":"2602.22661","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Zhanhui","familyName":"Zhou","name":"Zhou, Zhanhui","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Lingjie","familyName":"Chen","name":"Chen, Lingjie","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Hanghang","familyName":"Tong","name":"Tong, Hanghang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Dawn","familyName":"Song","name":"Song, Dawn","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"dLLM: Simple Diffusion Language Modeling"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-26T06:26:02Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:27:36Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Although diffusion language models (DLMs) are evolving quickly, many recent models converge on a set of shared components. These components, however, are distributed across ad-hoc research codebases or lack transparent implementations, making them difficult to reproduce or extend. As the field accelerates, there is a clear need for a unified framework that standardizes these common components while remaining flexible enough to support new methods and architectures.\n To address this gap, we introduce dLLM, an open-source framework that unifies the core components of diffusion language modeling -- training, inference, and evaluation -- and makes them easy to customize for new designs. With dLLM, users can reproduce, finetune, deploy, and evaluate open-source large DLMs such as LLaDA and Dream through a standardized pipeline. The framework also provides minimal, reproducible recipes for building small DLMs from scratch with accessible compute, including converting any BERT-style encoder or autoregressive LM into a DLM. We also release the checkpoints of these small DLMs to make DLMs more accessible and accelerate future research."},{"descriptionType":"Other","description":"Code available at: https://github.com/ZHZisZZ/dllm"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.22661","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T02:51:38Z","registered":"2026-02-27T02:51:38Z","published":null,"updated":"2026-02-27T02:51:38Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.22660","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.22660","identifiers":[{"identifier":"2602.22660","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Lianze","familyName":"Shan","name":"Shan, Lianze","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jitao","familyName":"Zhao","name":"Zhao, Jitao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Dongxiao","familyName":"He","name":"He, Dongxiao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Siqi","familyName":"Liu","name":"Liu, Siqi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jiaxu","familyName":"Cui","name":"Cui, Jiaxu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Weixiong","familyName":"Zhang","name":"Zhang, Weixiong","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"LEDA: Latent Semantic Distribution Alignment for Multi-domain Graph Pre-training"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-26T06:18:14Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:27:00Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Recent advances in generic large models, such as GPT and DeepSeek, have motivated the introduction of universality to graph pre-training, aiming to learn rich and generalizable knowledge across diverse domains using graph representations to improve performance in various downstream applications. However, most existing methods face challenges in learning effective knowledge from generic graphs, primarily due to simplistic data alignment and limited training guidance. The issue of simplistic data alignment arises from the use of a straightforward unification for highly diverse graph data, which fails to align semantics and misleads pre-training models. The problem with limited training guidance lies in the arbitrary application of in-domain pre-training paradigms to cross-domain scenarios. While it is effective in enhancing discriminative representation in one data space, it struggles to capture effective knowledge from many graphs. To address these challenges, we propose a novel Latent sEmantic Distribution Alignment (LEDA) model for universal graph pre-training. Specifically, we first introduce a dimension projection unit to adaptively align diverse domain features into a shared semantic space with minimal information loss. Furthermore, we design a variational semantic inference module to obtain the shared latent distribution. The distribution is then adopted to guide the domain projection, aligning it with shared semantics across domains and ensuring cross-domain semantic learning. LEDA exhibits strong performance across a broad range of graphs and downstream tasks. Remarkably, in few-shot cross-domain settings, it significantly outperforms in-domain baselines and advanced universal pre-training models."},{"descriptionType":"Other","description":"Accepted by WWW-26, 12 pages, 2 figures"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.22660","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T02:51:36Z","registered":"2026-02-27T02:51:37Z","published":null,"updated":"2026-02-27T02:51:37Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.22650","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.22650","identifiers":[{"identifier":"2602.22650","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Xinxin","familyName":"Yang","name":"Yang, Xinxin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yangyang","familyName":"Tang","name":"Tang, Yangyang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yikun","familyName":"Zhou","name":"Zhou, Yikun","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yaolei","familyName":"Liu","name":"Liu, Yaolei","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yun","familyName":"Li","name":"Li, Yun","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Bo","familyName":"Yang","name":"Yang, Bo","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"AHBid: An Adaptable Hierarchical Bidding Framework for Cross-Channel Advertising"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-26T06:07:28Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:26:41Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[{"relationType":"IsVersionOf","relatedIdentifier":"10.1145/3774904.3792322","relatedIdentifierType":"DOI"}],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"In online advertising, the inherent complexity and dynamic nature of advertising environments necessitate the use of auto-bidding services to assist advertisers in bid optimization. This complexity is further compounded in multi-channel scenarios, where effective allocation of budgets and constraints across channels with distinct behavioral patterns becomes critical for optimizing return on investment. Current approaches predominantly rely on either optimization-based strategies or reinforcement learning techniques. However, optimization-based methods lack flexibility in adapting to dynamic market conditions, while reinforcement learning approaches often struggle to capture essential historical dependencies and observational patterns within the constraints of Markov Decision Process frameworks. To address these limitations, we propose AHBid, an Adaptable Hierarchical Bidding framework that integrates generative planning with real-time control. The framework employs a high-level generative planner based on diffusion models to dynamically allocate budgets and constraints by effectively capturing historical context and temporal patterns. We introduce a constraint enforcement mechanism to ensure compliance with specified constraints, along with a trajectory refinement mechanism that enhances adaptability to environmental changes through the utilization of historical data. The system further incorporates a control-based bidding algorithm that synergistically combines historical knowledge with real-time information, significantly improving both adaptability and operational efficacy. Extensive experiments conducted on large-scale offline datasets and through online A/B tests demonstrate the effectiveness of AHBid, yielding a 13.57% increase in overall return compared to existing baselines."},{"descriptionType":"Other","description":"11 pages, 6 figures, accepted by WWW'2026"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.22650","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":1,"created":"2026-02-27T02:51:22Z","registered":"2026-02-27T02:51:22Z","published":null,"updated":"2026-02-27T02:51:22Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.22645","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.22645","identifiers":[{"identifier":"2602.22645","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Lianze","familyName":"Shan","name":"Shan, Lianze","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jitao","familyName":"Zhao","name":"Zhao, Jitao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Dongxiao","familyName":"He","name":"He, Dongxiao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yongqi","familyName":"Huang","name":"Huang, Yongqi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zhiyong","familyName":"Feng","name":"Feng, Zhiyong","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Weixiong","familyName":"Zhang","name":"Zhang, Weixiong","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"MUG: Meta-path-aware Universal Heterogeneous Graph Pre-Training"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-26T05:52:28Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:26:22Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Universal graph pre-training has emerged as a key paradigm in graph representation learning, offering a promising way to train encoders to learn transferable representations from unlabeled graphs and to effectively generalize across a wide range of downstream tasks. However, recent explorations in universal graph pre-training primarily focus on homogeneous graphs and it remains unexplored for heterogeneous graphs, which exhibit greater structural and semantic complexity. This heterogeneity makes it highly challenging to train a universal encoder for diverse heterogeneous graphs: (i) the diverse types with dataset-specific semantics hinder the construction of a unified representation space; (ii) the number and semantics of meta-paths vary across datasets, making encoding and aggregation patterns learned from one dataset difficult to apply to others. To address these challenges, we propose a novel Meta-path-aware Universal heterogeneous Graph pre-training (MUG) approach. Specifically, for challenge (i), MUG introduces a input unification module that integrates information from multiple node and relation types within each heterogeneous graph into a unified representation.This representation is then projected into a shared space by a dimension-aware encoder, enabling alignment across graphs with diverse schemas.Furthermore, for challenge (ii), MUG trains a shared encoder to capture consistent structural patterns across diverse meta-path views rather than relying on dataset-specific aggregation strategies, while a global objective encourages discriminability and reduces dataset-specific biases. Extensive experiments demonstrate the effectiveness of MUG on some real datasets."},{"descriptionType":"Other","description":"Accepted by AAAI-26, 9 pages, 3 figures"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.22645","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T02:51:15Z","registered":"2026-02-27T02:51:15Z","published":null,"updated":"2026-02-27T02:51:15Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.22644","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.22644","identifiers":[{"identifier":"2602.22644","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Siqi","familyName":"Lu","name":"Lu, Siqi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Wanying","familyName":"Xu","name":"Xu, Wanying","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yongbin","familyName":"Zheng","name":"Zheng, Yongbin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Wenting","familyName":"Luan","name":"Luan, Wenting","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Peng","familyName":"Sun","name":"Sun, Peng","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jianhang","familyName":"Yao","name":"Yao, Jianhang","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Plug, Play, and Fortify: A Low-Cost Module for Robust Multimodal Image Understanding Models"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-26T05:51:41Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:26:21Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Missing modalities present a fundamental challenge in multimodal models, often causing catastrophic performance degradation. Our observations suggest that this fragility stems from an imbalanced learning process, where the model develops an implicit preference for certain modalities, leading to the under-optimization of others. We propose a simple yet efficient method to address this challenge. The central insight of our work is that the dominance relationship between modalities can be effectively discerned and quantified in the frequency domain. To leverage this principle, we first introduce a Frequency Ratio Metric (FRM) to quantify modality preference by analyzing features in the frequency domain. Guided by FRM, we then propose a Multimodal Weight Allocation Module, a plug-and-play component that dynamically re-balances the contribution of each branch during training, promoting a more holistic learning paradigm. Extensive experiments demonstrate that MWAM can be seamlessly integrated into diverse architectural backbones, such as those based on CNNs and ViTs. Furthermore, MWAM delivers consistent performance gains across a wide range of tasks and modality combinations. This advancement extends beyond merely optimizing the performance of the base model; it also manifests as further performance improvements to state-of-the-art methods addressing the missing modality problem."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.22644","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T02:51:13Z","registered":"2026-02-27T02:51:14Z","published":null,"updated":"2026-02-27T02:51:14Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.22633","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.22633","identifiers":[{"identifier":"2602.22633","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Ruichen","familyName":"Xu","name":"Xu, Ruichen","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ying-Jun Angela","familyName":"Zhang","name":"Zhang, Ying-Jun Angela","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jianwei","familyName":"Huang","name":"Huang, Jianwei","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Tackling Privacy Heterogeneity in Differentially Private Federated Learning"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"Distributed, Parallel, and Cluster Computing (cs.DC)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-26T05:20:37Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:25:10Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Differentially private federated learning (DP-FL) enables clients to collaboratively train machine learning models while preserving the privacy of their local data. However, most existing DP-FL approaches assume that all clients share a uniform privacy budget, an assumption that does not hold in real-world scenarios where privacy requirements vary widely. This privacy heterogeneity poses a significant challenge: conventional client selection strategies, which typically rely on data quantity, cannot distinguish between clients providing high-quality updates and those introducing substantial noise due to strict privacy constraints. To address this gap, we present the first systematic study of privacy-aware client selection in DP-FL. We establish a theoretical foundation by deriving a convergence analysis that quantifies the impact of privacy heterogeneity on training error. Building on this analysis, we propose a privacy-aware client selection strategy, formulated as a convex optimization problem, that adaptively adjusts selection probabilities to minimize training error. Extensive experiments on benchmark datasets demonstrate that our approach achieves up to a 10% improvement in test accuracy on CIFAR-10 compared to existing baselines under heterogeneous privacy budgets. These results highlight the importance of incorporating privacy heterogeneity into client selection for practical and effective federated learning."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.22633","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T02:50:57Z","registered":"2026-02-27T02:50:58Z","published":null,"updated":"2026-02-27T02:50:58Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.22624","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.22624","identifiers":[{"identifier":"2602.22624","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Liya","familyName":"Ji","name":"Ji, Liya","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Chenyang","familyName":"Qi","name":"Qi, Chenyang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Qifeng","familyName":"Chen","name":"Chen, Qifeng","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Instruction-based Image Editing with Planning, Reasoning, and Generation"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"I.2.10","lang":"en","subjectScheme":"ACM"}],"contributors":[],"dates":[{"date":"2026-02-26T04:56:02Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:24:38Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Editing images via instruction provides a natural way to generate interactive content, but it is a big challenge due to the higher requirement of scene understanding and generation. Prior work utilizes a chain of large language models, object segmentation models, and editing models for this task. However, the understanding models provide only a single modality ability, restricting the editing quality. We aim to bridge understanding and generation via a new multi-modality model that provides the intelligent abilities to instruction-based image editing models for more complex cases. To achieve this goal, we individually separate the instruction editing task with the multi-modality chain of thought prompts, i.e., Chain-of-Thought (CoT) planning, editing region reasoning, and editing. For Chain-of-Thought planning, the large language model could reason the appropriate sub-prompts considering the instruction provided and the ability of the editing network. For editing region reasoning, we train an instruction-based editing region generation network with a multi-modal large language model. Finally, a hint-guided instruction-based editing network is proposed for editing image generations based on the sizeable text-to-image diffusion model to accept the hints for generation. Extensive experiments demonstrate that our method has competitive editing abilities on complex real-world images."},{"descriptionType":"Other","description":"10 pages, 7 figures"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.22624","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T02:50:44Z","registered":"2026-02-27T02:50:45Z","published":null,"updated":"2026-02-27T02:50:45Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.22623","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.22623","identifiers":[{"identifier":"2602.22623","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Xingyu","familyName":"Lu","name":"Lu, Xingyu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jinpeng","familyName":"Wang","name":"Wang, Jinpeng","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"YiFan","familyName":"Zhang","name":"Zhang, YiFan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Shijie","familyName":"Ma","name":"Ma, Shijie","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xiao","familyName":"Hu","name":"Hu, Xiao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Tianke","familyName":"Zhang","name":"Zhang, Tianke","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Haonan","familyName":"fan","name":"fan, Haonan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Kaiyu","familyName":"Jiang","name":"Jiang, Kaiyu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Changyi","familyName":"Liu","name":"Liu, Changyi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Kaiyu","familyName":"Tang","name":"Tang, Kaiyu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Bin","familyName":"Wen","name":"Wen, Bin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Fan","familyName":"Yang","name":"Yang, Fan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Tingting","familyName":"Gao","name":"Gao, Tingting","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Han","familyName":"Li","name":"Li, Han","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Chun","familyName":"Yuan","name":"Yuan, Chun","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"ContextRL: Enhancing MLLM's Knowledge Discovery Efficiency with Context-Augmented RL"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-26T04:55:57Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:24:37Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"We propose ContextRL, a novel framework that leverages context augmentation to overcome these bottlenecks. Specifically, to enhance Identifiability, we provide the reward model with full reference solutions as context, enabling fine-grained process verification to filter out false positives (samples with the right answer but low-quality reasoning process). To improve Reachability, we introduce a multi-turn sampling strategy where the reward model generates mistake reports for failed attempts, guiding the policy to \"recover\" correct responses from previously all-negative groups. Experimental results on 11 perception and reasoning benchmarks show that ContextRL significantly improves knowledge discovery efficiency. Notably, ContextRL enables the Qwen3-VL-8B model to achieve performance comparable to the 32B model, outperforming standard RLVR baselines by a large margin while effectively mitigating reward hacking. Our in-depth analysis reveals the significant potential of contextual information for improving reward model accuracy and document the widespread occurrence of reward hacking, offering valuable insights for future RLVR research."},{"descriptionType":"Other","description":"14 pages, 5 figures"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.22623","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T02:50:43Z","registered":"2026-02-27T02:50:44Z","published":null,"updated":"2026-02-27T02:50:44Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.22618","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.22618","identifiers":[{"identifier":"2602.22618","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Mahindra","familyName":"Rautela","name":"Rautela, Mahindra","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Alexander","familyName":"Scheinker","name":"Scheinker, Alexander","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Advancing accelerator virtual beam diagnostics through latent evolution modeling: an integrated solution to forward, inverse, tuning, and UQ problems"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Accelerator Physics (physics.acc-ph)","lang":"en","subjectScheme":"arXiv"},{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-26T04:46:26Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:24:08Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[{"relationType":"IsVersionOf","relatedIdentifier":"10.18429/jacow-napac2025-mop002","relatedIdentifierType":"DOI"}],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Virtual beam diagnostics relies on computationally intensive beam dynamics simulations where high-dimensional charged particle beams evolve through the accelerator. We propose Latent Evolution Model (LEM), a hybrid machine learning framework with an autoencoder that projects high-dimensional phase spaces into lower-dimensional representations, coupled with transformers to learn temporal dynamics in the latent space. This approach provides a common foundational framework addressing multiple interconnected challenges in beam diagnostics. For \\textit{forward modeling}, a Conditional Variational Autoencoder (CVAE) encodes 15 unique projections of the 6D phase space into a latent representation, while a transformer predicts downstream latent states from upstream inputs. For \\textit{inverse problems}, we address two distinct challenges: (a) predicting upstream phase spaces from downstream observations by utilizing the same CVAE architecture with transformers trained on reversed temporal sequences along with aleatoric uncertainty quantification, and (b) estimating RF settings from the latent space of the trained LEM using a dedicated dense neural network that maps latent representations to RF parameters. For \\textit{tuning problems}, we leverage the trained LEM and RF estimator within a Bayesian optimization framework to determine optimal RF settings that minimize beam loss. This paper summarizes our recent efforts and demonstrates how this unified approach effectively addresses these traditionally separate challenges."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.22618","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":1,"created":"2026-02-27T02:50:36Z","registered":"2026-02-27T02:50:37Z","published":null,"updated":"2026-02-27T02:50:37Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.22617","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.22617","identifiers":[{"identifier":"2602.22617","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Hai","familyName":"Huang","name":"Huang, Hai","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yann","familyName":"LeCun","name":"LeCun, Yann","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Randall","familyName":"Balestriero","name":"Balestriero, Randall","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Semantic Tube Prediction: Beating LLM Data Efficiency with JEPA"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-26T04:45:07Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:24:06Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Large Language Models (LLMs) obey consistent scaling laws -- empirical power-law fits that predict how loss decreases with compute, data, and parameters. While predictive, these laws are descriptive rather than prescriptive: they characterize typical training, not optimal training. Surprisingly few works have successfully challenged the data-efficiency bounds implied by these laws -- which is our primary focus. To that end, we introduce the Geodesic Hypothesis, positing that token sequences trace geodesics on a smooth semantic manifold and are therefore locally linear. Building on this principle, we propose a novel Semantic Tube Prediction (STP) task, a JEPA-style regularizer that confines hidden-state trajectories to a tubular neighborhood of the geodesic. STP generalizes JEPA to language without requiring explicit multi-view augmentations. We show this constraint improves signal-to-noise ratio, and consequently preserves diversity by preventing trajectory collisions during inference. Empirically, STP allows LLMs to match baseline accuracy with 16$\\times$ less training data on the NL-RX-SYNTH dataset, directly violating the data term of Chinchilla-style scaling laws and demonstrating that principled geometric priors can surpass brute-force scaling. Code is available at https://github.com/galilai-group/llm-jepa#stp."},{"descriptionType":"Other","description":"21 pages, 13 figures"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.22617","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T02:50:35Z","registered":"2026-02-27T02:50:35Z","published":null,"updated":"2026-02-27T02:50:35Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.22613","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.22613","identifiers":[{"identifier":"2602.22613","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Minh Kha","familyName":"Do","name":"Do, Minh Kha","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Wei","familyName":"Xiang","name":"Xiang, Wei","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Kang","familyName":"Han","name":"Han, Kang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Di","familyName":"Wu","name":"Wu, Di","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Khoa","familyName":"Phan","name":"Phan, Khoa","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yi-Ping Phoebe","familyName":"Chen","name":"Chen, Yi-Ping Phoebe","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Gaowen","familyName":"Liu","name":"Liu, Gaowen","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ramana Rao","familyName":"Kompella","name":"Kompella, Ramana Rao","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Spectrally Distilled Representations Aligned with Instruction-Augmented LLMs for Satellite Imagery"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-26T04:34:47Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:23:48Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Vision-language foundation models (VLFMs) promise zero-shot and retrieval understanding for Earth observation. While operational satellite systems often lack full multi-spectral coverage, making RGB-only inference highly desirable for scalable deployment, the adoption of VLFMs for satellite imagery remains hindered by two factors: (1) multi-spectral inputs are informative but difficult to exploit consistently due to band redundancy and misalignment; and (2) CLIP-style text encoders limit semantic expressiveness and weaken fine-grained alignment. We present SATtxt, a spectrum-aware VLFM that operates with RGB inputs only at inference while retaining spectral cues learned during training. Our framework comprises two stages. First, Spectral Representation Distillation transfers spectral priors from a frozen multi-spectral teacher to an RGB student via a lightweight projector. Second, Spectrally Grounded Alignment with Instruction-Augmented LLMs bridges the distilled visual space and an expressive LLM embedding space. Across EuroSAT, BigEarthNet, and ForestNet, SATtxt improves zero-shot classification on average by 4.2%, retrieval by 5.9%, and linear probing by 2.7% over baselines, showing an efficient path toward spectrum-aware vision-language learning for Earth observation. Project page: https://ikhado.github.io/sattxt/"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.22613","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T02:50:29Z","registered":"2026-02-27T02:50:30Z","published":null,"updated":"2026-02-27T02:50:30Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.22612","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.22612","identifiers":[{"identifier":"2602.22612","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Yuxi","familyName":"Du","name":"Du, Yuxi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zhiheng","familyName":"Zhang","name":"Zhang, Zhiheng","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Haoxuan","familyName":"Li","name":"Li, Haoxuan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Cong","familyName":"Fang","name":"Fang, Cong","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jixing","familyName":"Xu","name":"Xu, Jixing","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Peng","familyName":"Zhen","name":"Zhen, Peng","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jiecheng","familyName":"Guo","name":"Guo, Jiecheng","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Feasible Fusion: Constrained Joint Estimation under Structural Non-Overlap"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Methodology (stat.ME)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-26T04:32:52Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:23:46Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Causal inference in modern largescale systems faces growing challenges, including highdimensional covariates, multi-valued treatments, massive observational (OBS) data, and limited randomized controlled trial (RCT) samples due to cost constraints. We formalize treatment-induced structural non-overlap and show that, under this regime, commonly used weighted fusion methods provably fail to satisfy randomized identifying restrictions.To address this issue,we propose a constrained joint estimation framework that minimizes observational risk while enforcing causal validity through orthogonal experimental moment conditions. We further show that structural non-overlap creates a feasibility obstruction for moment enforcement in the original covariate space.We also derive a penalized primaldual algorithm that jointly learns representations and predictors, and establish oracle inequalities decomposing error into overlap recovery, moment violation, and statistical terms.Extensive synthetic experiments demonstrate robust performance under varying degrees of nonoverlap. A largescale ridehailing application shows that our method achieves substantial gains over existing baselines, matching the performance of models trained with significantly more RCT data."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.22612","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T02:50:27Z","registered":"2026-02-27T02:50:29Z","published":null,"updated":"2026-02-27T02:50:29Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.22610","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.22610","identifiers":[{"identifier":"2602.22610","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Tao","familyName":"Huang","name":"Huang, Tao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jiayang","familyName":"Meng","name":"Meng, Jiayang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xu","familyName":"Yang","name":"Yang, Xu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Chen","familyName":"Hou","name":"Hou, Chen","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Hong","familyName":"Chen","name":"Chen, Hong","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"DP-aware AdaLN-Zero: Taming Conditioning-Induced Heavy-Tailed Gradients in Differentially Private Diffusion"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-26T04:32:07Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:23:36Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Condition injection enables diffusion models to generate context-aware outputs, which is essential for many time-series tasks. However, heterogeneous conditional contexts (e.g., observed history, missingness patterns or outlier covariates) can induce heavy-tailed per-example gradients. Under Differentially Private Stochastic Gradient Descent (DP-SGD), these rare conditioning-driven heavy-tailed gradients disproportionately trigger global clipping, resulting in outlier-dominated updates, larger clipping bias, and degraded utility under a fixed privacy budget. In this paper, we propose DP-aware AdaLN-Zero, a drop-in sensitivity-aware conditioning mechanism for conditional diffusion transformers that limits conditioning-induced gain without modifying the DP-SGD mechanism. DP-aware AdaLN-Zero jointly constrains conditioning representation magnitude and AdaLN modulation parameters via bounded re-parameterization, suppressing extreme gradient tail events before gradient clipping and noise injection. Empirically, DP-SGD equipped with DP-aware AdaLN-Zero improves interpolation/imputation and forecasting under matched privacy settings. We observe consistent gains on a real-world power dataset and two public ETT benchmarks over vanilla DP-SGD. Moreover, gradient diagnostics attribute these improvements to conditioning-specific tail reshaping and reduced clipping distortion, while preserving expressiveness in non-private training. Overall, these results show that sensitivity-aware conditioning can substantially improve private conditional diffusion training without sacrificing standard performance."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.22610","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T02:50:24Z","registered":"2026-02-27T02:50:25Z","published":null,"updated":"2026-02-27T02:50:25Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.22609","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.22609","identifiers":[{"identifier":"2602.22609","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Guangyu","familyName":"Hu","name":"Hu, Guangyu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xiaofeng","familyName":"Zhou","name":"Zhou, Xiaofeng","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Wei","familyName":"Zhang","name":"Zhang, Wei","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Hongce","familyName":"Zhang","name":"Zhang, Hongce","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"EvolveGen: Algorithmic Level Hardware Model Checking Benchmark Generation through Reinforcement Learning"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Hardware Architecture (cs.AR)","lang":"en","subjectScheme":"arXiv"},{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-26T04:32:07Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:23:34Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Progress in hardware model checking depends critically on high-quality benchmarks. However, the community faces a significant benchmark gap: existing suites are limited in number, often distributed only in representations such as BTOR2 without access to the originating register-transfer-level (RTL) designs, and biased toward extreme difficulty where instances are either trivial or intractable. These limitations hinder rigorous evaluation of new verification techniques and encourage overfitting of solver heuristics to a narrow set of problems. To address this, we introduce EvolveGen, a framework for generating hardware model checking benchmarks by combining reinforcement learning (RL) with high-level synthesis (HLS). Our approach operates at an algorithmic level of abstraction in which an RL agent learns to construct computation graphs. By compiling these graphs under different synthesis directives, we produce pairs of functionally equivalent but structurally distinct hardware designs, inducing challenging model checking instances. Solver runtime is used as the reward signal, enabling the agent to autonomously discover and generate small-but-hard instances that expose solver-specific weaknesses. Experiments show that EvolveGen efficiently creates a diverse benchmark set in standard formats (e.g., AIGER and BTOR2) and effectively reveals performance bottlenecks in state-of-the-art model checkers."},{"descriptionType":"Other","description":"19 pages, 8 figures. Accepted by TACAS 2026"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.22609","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T02:50:23Z","registered":"2026-02-27T02:50:24Z","published":null,"updated":"2026-02-27T02:50:24Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.22597","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.22597","identifiers":[{"identifier":"2602.22597","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Maryam","familyName":"Maghsoudi","name":"Maghsoudi, Maryam","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Rupesh","familyName":"Chillale","name":"Chillale, Rupesh","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Shihab A.","familyName":"Shamma","name":"Shamma, Shihab A.","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Relating the Neural Representations of Vocalized, Mimed, and Imagined Speech"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Sound (cs.SD)","lang":"en","subjectScheme":"arXiv"},{"subject":"Audio and Speech Processing (eess.AS)","lang":"en","subjectScheme":"arXiv"},{"subject":"Signal Processing (eess.SP)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"FOS: Electrical engineering, electronic engineering, information engineering","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Electrical engineering, electronic engineering, information engineering","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-26T04:01:09Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:22:31Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"We investigated the relationship among neural representations of vocalized, mimed, and imagined speech recorded using publicly available stereotactic EEG recordings. Most prior studies have focused on decoding speech responses within each condition separately. Here, instead, we explore how responses across conditions relate by training linear spectrogram reconstruction models for each condition and evaluate their generalization across conditions. We demonstrate that linear decoders trained on one condition generally transfer successfully to others, implying shared speech representations. This commonality was assessed with stimulus-level discriminability by performing a rank-based analysis demonstrating preservation of stimulus-specific structure in both within- and across-conditions. Finally, we compared linear reconstructions to those from a nonlinear neural network. While both exhibited cross-condition transfer, linear models achieve superior stimulus-level discriminability."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.22597","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T02:50:06Z","registered":"2026-02-27T02:50:07Z","published":null,"updated":"2026-02-27T02:50:07Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.22596","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.22596","identifiers":[{"identifier":"2602.22596","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Yuci","familyName":"Han","name":"Han, Yuci","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Charles","familyName":"Toth","name":"Toth, Charles","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"John E.","familyName":"Anderson","name":"Anderson, John E.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"William J.","familyName":"Shuart","name":"Shuart, William J.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Alper","familyName":"Yilmaz","name":"Yilmaz, Alper","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"BetterScene: 3D Scene Synthesis with Representation-Aligned Generative Model"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-26T03:58:42Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:22:17Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"We present BetterScene, an approach to enhance novel view synthesis (NVS) quality for diverse real-world scenes using extremely sparse, unconstrained photos. BetterScene leverages the production-ready Stable Video Diffusion (SVD) model pretrained on billions of frames as a strong backbone, aiming to mitigate artifacts and recover view-consistent details at inference time. Conventional methods have developed similar diffusion-based solutions to address these challenges of novel view synthesis. Despite significant improvements, these methods typically rely on off-the-shelf pretrained diffusion priors and fine-tune only the UNet module while keeping other components frozen, which still leads to inconsistent details and artifacts even when incorporating geometry-aware regularizations like depth or semantic conditions. To address this, we investigate the latent space of the diffusion model and introduce two components: (1) temporal equivariance regularization and (2) vision foundation model-aligned representation, both applied to the variational autoencoder (VAE) module within the SVD pipeline. BetterScene integrates a feed-forward 3D Gaussian Splatting (3DGS) model to render features as inputs for the SVD enhancer and generate continuous, artifact-free, consistent novel views. We evaluate on the challenging DL3DV-10K dataset and demonstrate superior performance compared to state-of-the-art methods."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.22596","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T02:50:05Z","registered":"2026-02-27T02:50:05Z","published":null,"updated":"2026-02-27T02:50:05Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.22594","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.22594","identifiers":[{"identifier":"2602.22594","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Qing","familyName":"Yu","name":"Yu, Qing","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Akihisa","familyName":"Watanabe","name":"Watanabe, Akihisa","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Kent","familyName":"Fujiwara","name":"Fujiwara, Kent","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Causal Motion Diffusion Models for Autoregressive Motion Generation"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-26T03:58:25Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:22:12Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Recent advances in motion diffusion models have substantially improved the realism of human motion synthesis. However, existing approaches either rely on full-sequence diffusion models with bidirectional generation, which limits temporal causality and real-time applicability, or autoregressive models that suffer from instability and cumulative errors. In this work, we present Causal Motion Diffusion Models (CMDM), a unified framework for autoregressive motion generation based on a causal diffusion transformer that operates in a semantically aligned latent space. CMDM builds upon a Motion-Language-Aligned Causal VAE (MAC-VAE), which encodes motion sequences into temporally causal latent representations. On top of this latent representation, an autoregressive diffusion transformer is trained using causal diffusion forcing to perform temporally ordered denoising across motion frames. To achieve fast inference, we introduce a frame-wise sampling schedule with causal uncertainty, where each subsequent frame is predicted from partially denoised previous frames. The resulting framework supports high-quality text-to-motion generation, streaming synthesis, and long-horizon motion generation at interactive rates. Experiments on HumanML3D and SnapMoGen demonstrate that CMDM outperforms existing diffusion and autoregressive models in both semantic fidelity and temporal smoothness, while substantially reducing inference latency."},{"descriptionType":"Other","description":"Accepted to CVPR 2026, Project website: https://yu1ut.com/CMDM-HP/"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.22594","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T02:50:02Z","registered":"2026-02-27T02:50:03Z","published":null,"updated":"2026-02-27T02:50:03Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.22592","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.22592","identifiers":[{"identifier":"2602.22592","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Wenzheng","familyName":"Zhang","name":"Zhang, Wenzheng","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Bingzheng","familyName":"Liu","name":"Liu, Bingzheng","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yang","familyName":"Hu","name":"Hu, Yang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xiaoying","familyName":"Bai","name":"Bai, Xiaoying","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Wentao","familyName":"Zhang","name":"Zhang, Wentao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Bin","familyName":"Cui","name":"Cui, Bin","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"pQuant: Towards Effective Low-Bit Language Models via Decoupled Linear Quantization-Aware Training"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-26T03:51:58Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:21:49Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Quantization-Aware Training from scratch has emerged as a promising approach for building efficient large language models (LLMs) with extremely low-bit weights (sub 2-bit), which can offer substantial advantages for edge deployment. However, existing methods still fail to achieve satisfactory accuracy and scalability. In this work, we identify a parameter democratization effect as a key bottleneck: the sensitivity of all parameters becomes homogenized, severely limiting expressivity. To address this, we propose pQuant, a method that decouples parameters by splitting linear layers into two specialized branches: a dominant 1-bit branch for efficient computation and a compact high-precision branch dedicated to preserving the most sensitive parameters. Through tailored feature scaling, we explicitly guide the model to allocate sensitive parameters to the high-precision branch. Furthermore, we extend this branch into multiple, sparsely-activated experts, enabling efficient capacity scaling. Extensive experiments indicate our pQuant achieves state-of-the-art performance in extremely low-bit quantization."},{"descriptionType":"Other","description":"10 pages, 7 figures"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.22592","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T02:49:59Z","registered":"2026-02-27T02:50:00Z","published":null,"updated":"2026-02-27T02:50:00Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.22588","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.22588","identifiers":[{"identifier":"2602.22588","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Niloofar","familyName":"Ramezani","name":"Ramezani, Niloofar","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Pascal","familyName":"Nitiema","name":"Nitiema, Pascal","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jeffrey R.","familyName":"Wilson","name":"Wilson, Jeffrey R.","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Modeling Covariate Feedback, Reversal, and Latent Traits in Longitudinal Data: A Joint Hierarchical Framework"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Methodology (stat.ME)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-26T03:46:34Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:21:43Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Time-varying covariates in longitudinal studies frequently evolve through reciprocal feedback, undergo role reversal, and reflect unobserved individual heterogeneity. Standard statistical frameworks often assume fixed covariate roles and exogenous predictors, limiting their utility in systems governed by dynamic behavioral or physiological processes. We develop a hierarchical joint modeling framework that unifies three key features of such systems: (i) bidirectional feedback between a binary and a continuous covariate, (ii) role reversal in which these covariates become jointly modeled outcomes at a prespecified decision phase, and (iii) a shared latent trait influencing both intermediate covariates and a final binary endpoint. The model proceeds in three phases: a feedback-driven longitudinal process, a reversal phase in which the two covariates are jointly modeled conditional on the latent trait, and an outcome model linking a binary, decision-relevant endpoint to observed and latent components. Estimation is carried out using maximum likelihood and Bayesian inference, with Hamiltonian Monte Carlo supporting robust posterior estimation for models with latent structure and mixed outcome types. Simulation studies show that the model yields well calibrated coverage, small bias, and improved predictive performance compared to standard generalized linear mixed models, marginal approaches, and models that ignore feedback or latent traits. In an analysis of nationally representative U.S. panel data, the model captures the co-evolution of physical activity and body mass index and their joint influence, moderated by a latent behavioral resilience factor, on income mobility. The framework offers a flexible, practically implementable tool for analyzing longitudinal decision systems in which feedback, covariate role transition, and unmeasured capacity are central to prediction and intervention."},{"descriptionType":"Other","description":"16 pages, 1 figure, 4 tables, 3 supplementary figures"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.22588","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T02:49:53Z","registered":"2026-02-27T02:49:54Z","published":null,"updated":"2026-02-27T02:49:54Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.22585","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.22585","identifiers":[{"identifier":"2602.22585","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Jodi M.","familyName":"Casabianca","name":"Casabianca, Jodi M.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Maggie","familyName":"Beiting-Parrish","name":"Beiting-Parrish, Maggie","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Correcting Human Labels for Rater Effects in AI Evaluation: An Item Response Theory Approach"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-26T03:35:36Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:21:30Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by-nc-nd/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution Non Commercial No Derivatives 4.0 International","rightsIdentifier":"cc-by-nc-nd-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Human evaluations play a central role in training and assessing AI models, yet these data are rarely treated as measurements subject to systematic error. This paper integrates psychometric rater models into the AI pipeline to improve the reliability and validity of conclusions drawn from human judgments. The paper reviews common rater effects, severity and centrality, that distort observed ratings, and demonstrates how item response theory rater models, particularly the multi-faceted Rasch model, can separate true output quality from rater behavior. Using the OpenAI summarization dataset as an empirical example, we show how adjusting for rater severity produces corrected estimates of summary quality and provides diagnostic insight into rater performance. Incorporating psychometric modeling into human-in-the-loop evaluation offers more principled and transparent use of human data, enabling developers to make decisions based on adjusted scores rather than raw, error-prone ratings. This perspective highlights a path toward more robust, interpretable, and construct-aligned practices for AI development and evaluation."},{"descriptionType":"Other","description":"16 pages, 5 figures, 1 table; The 16th Annual Learning Analytics and Knowledge Conference (LAK) Workshop on LLM Psychometrics, April 27, 2026, Bergen, Norway"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.22585","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T02:49:49Z","registered":"2026-02-27T02:49:50Z","published":null,"updated":"2026-02-27T02:49:50Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.22584","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.22584","identifiers":[{"identifier":"2602.22584","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Wenwei","familyName":"Li","name":"Li, Wenwei","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ming","familyName":"Xu","name":"Xu, Ming","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Tianle","familyName":"Xia","name":"Xia, Tianle","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Lingxiang","familyName":"Hu","name":"Hu, Lingxiang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yiding","familyName":"Sun","name":"Sun, Yiding","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Linfang","familyName":"Shang","name":"Shang, Linfang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Liqun","familyName":"Liu","name":"Liu, Liqun","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Peng","familyName":"Shu","name":"Shu, Peng","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Huan","familyName":"Yu","name":"Yu, Huan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jie","familyName":"Jiang","name":"Jiang, Jie","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Towards Faithful Industrial RAG: A Reinforced Co-adaptation Framework for Advertising QA"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-26T03:35:09Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:21:20Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Industrial advertising question answering (QA) is a high-stakes task in which hallucinated content, particularly fabricated URLs, can lead to financial loss, compliance violations, and legal risk. Although Retrieval-Augmented Generation (RAG) is widely adopted, deploying it in production remains challenging because industrial knowledge is inherently relational, frequently updated, and insufficiently aligned with generation objectives. We propose a reinforced co-adaptation framework that jointly optimizes retrieval and generation through two components: (1) Graph-aware Retrieval (GraphRAG), which models entity-relation structure over a high-citation knowledge subgraph for multi-hop, domain-specific evidence selection; and (2) evidence-constrained reinforcement learning via Group Relative Policy Optimization (GRPO) with multi-dimensional rewards covering faithfulness, style compliance, safety, and URL validity. Experiments on an internal advertising QA dataset show consistent gains across expert-judged dimensions including accuracy, completeness, and safety, while reducing the hallucination rate by 72\\%. A two-week online A/B test demonstrates a 28.6\\% increase in like rate, a 46.2\\% decrease in dislike rate, and a 92.7\\% reduction in URL hallucination. The system has been running in production for over half a year and has served millions of QA interactions."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.22584","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T02:49:48Z","registered":"2026-02-27T02:49:48Z","published":null,"updated":"2026-02-27T02:49:48Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.22583","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.22583","identifiers":[{"identifier":"2602.22583","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Weida","familyName":"Liang","name":"Liang, Weida","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yiyou","familyName":"Sun","name":"Sun, Yiyou","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Shuyuan","familyName":"Nan","name":"Nan, Shuyuan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Chuang","familyName":"Li","name":"Li, Chuang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Dawn","familyName":"Song","name":"Song, Dawn","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Kenji","familyName":"Kawaguchi","name":"Kawaguchi, Kenji","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Strategy Executability in Mathematical Reasoning: Leveraging Human-Model Differences for Effective Guidance"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-26T03:34:23Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:21:11Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Example-based guidance is widely used to improve mathematical reasoning at inference time, yet its effectiveness is highly unstable across problems and models-even when the guidance is correct and problem-relevant. We show that this instability arises from a previously underexplored gap between strategy usage-whether a reasoning strategy appears in successful solutions-and strategy executability-whether the strategy remains effective when instantiated as guidance for a target model. Through a controlled analysis of paired human-written and model-generated solutions, we identify a systematic dissociation between usage and executability: human- and model-derived strategies differ in structured, domain-dependent ways, leading to complementary strengths and consistent source-dependent reversals under guidance. Building on this diagnosis, we propose Selective Strategy Retrieval (SSR), a test-time framework that explicitly models executability by selectively retrieving and combining strategies using empirical, multi-route, source-aware signals. Across multiple mathematical reasoning benchmarks, SSR yields reliable and consistent improvements over direct solving, in-context learning, and single-source guidance, improving accuracy by up to $+13$ points on AIME25 and $+5$ points on Apex for compact reasoning models. Code and benchmark are publicly available at: https://github.com/lwd17/strategy-execute-pipeline."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.22583","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T02:49:46Z","registered":"2026-02-27T02:49:47Z","published":null,"updated":"2026-02-27T02:49:47Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.22582","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.22582","identifiers":[{"identifier":"2602.22582","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Lucas","familyName":"Kock","name":"Kock, Lucas","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Scott A.","familyName":"Sisson","name":"Sisson, Scott A.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"G. S.","familyName":"Rodrigues","name":"Rodrigues, G. S.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"David J.","familyName":"Nott","name":"Nott, David J.","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Predictive variational inference for flexible regression models"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Methodology (stat.ME)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-26T03:34:23Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:21:10Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"A conventional Bayesian approach to prediction uses the posterior distribution to integrate out parameters in a density for unobserved data conditional on the observed data and parameters. When the true posterior is intractable, it is replaced by an approximation; here we focus on variational approximations. Recent work has explored methods that learn posteriors optimized for predictive accuracy under a chosen scoring rule, while regularizing toward the prior or conventional posterior. Our work builds on an existing predictive variational inference (PVI) framework that improves prediction, but also diagnoses model deficiencies through implicit model expansion. In models where the sampling density depends on the parameters through a linear predictor, we improve the interpretability of existing PVI methods as a diagnostic tool. This is achieved by adopting PVI posteriors of Gaussian mixture form (GM-PVI) and establishing connections with plug-in prediction for mixture-of-experts models. We make three main contributions. First, we show that GM-PVI prediction is equivalent to plug-in prediction for certain mixture-of-experts models with covariate-independent weights in generalized linear models and hierarchical extensions of them. Second, we extend standard PVI by allowing GM-PVI posteriors to vary with the prediction covariate and in this case an equivalence to plug-in prediction for mixtures of experts with covariate-dependent weights is established. Third, we demonstrate the diagnostic value of this approach across several examples, including generalized linear models, linear mixed models, and latent Gaussian process models, demonstrating how the parameters of the original model must vary across the covariate space to achieve improvements in prediction."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.22582","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T02:49:45Z","registered":"2026-02-27T02:49:46Z","published":null,"updated":"2026-02-27T02:49:46Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.22581","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.22581","identifiers":[{"identifier":"2602.22581","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Tian","familyName":"Bian","name":"Bian, Tian","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yifan","familyName":"Niu","name":"Niu, Yifan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Chaohao","familyName":"Yuan","name":"Yuan, Chaohao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Chengzhi","familyName":"Piao","name":"Piao, Chengzhi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Bingzhe","familyName":"Wu","name":"Wu, Bingzhe","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Long-Kai","familyName":"Huang","name":"Huang, Long-Kai","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yu","familyName":"Rong","name":"Rong, Yu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Tingyang","familyName":"Xu","name":"Xu, Tingyang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Hong","familyName":"Cheng","name":"Cheng, Hong","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jia","familyName":"Li","name":"Li, Jia","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"IBCircuit: Towards Holistic Circuit Discovery with Information Bottleneck"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-26T03:33:35Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:21:09Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Circuit discovery has recently attracted attention as a potential research direction to explain the non-trivial behaviors of language models. It aims to find the computational subgraphs, also known as circuits, within the model that are responsible for solving specific tasks. However, most existing studies overlook the holistic nature of these circuits and require designing specific corrupted activations for different tasks, which is inaccurate and inefficient. In this work, we propose an end-to-end approach based on the principle of Information Bottleneck, called IBCircuit, to identify informative circuits holistically. IBCircuit is an optimization framework for holistic circuit discovery and can be applied to any given task without tediously corrupted activation design. In both the Indirect Object Identification (IOI) and Greater-Than tasks, IBCircuit identifies more faithful and minimal circuits in terms of critical node components and edge components compared to recent related work."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.22581","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T02:49:43Z","registered":"2026-02-27T02:49:44Z","published":null,"updated":"2026-02-27T02:49:44Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.22576","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.22576","identifiers":[{"identifier":"2602.22576","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Tianle","familyName":"Xia","name":"Xia, Tianle","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ming","familyName":"Xu","name":"Xu, Ming","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Lingxiang","familyName":"Hu","name":"Hu, Lingxiang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yiding","familyName":"Sun","name":"Sun, Yiding","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Wenwei","familyName":"Li","name":"Li, Wenwei","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Linfang","familyName":"Shang","name":"Shang, Linfang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Liqun","familyName":"Liu","name":"Liu, Liqun","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Peng","familyName":"Shu","name":"Shu, Peng","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Huan","familyName":"Yu","name":"Yu, Huan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jie","familyName":"Jiang","name":"Jiang, Jie","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Search-P1: Path-Centric Reward Shaping for Stable and Efficient Agentic RAG Training"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"Information Retrieval (cs.IR)","lang":"en","subjectScheme":"arXiv"},{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-26T03:31:00Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:20:57Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Retrieval-Augmented Generation (RAG) enhances large language models (LLMs) by incorporating external knowledge, yet traditional single-round retrieval struggles with complex multi-step reasoning. Agentic RAG addresses this by enabling LLMs to dynamically decide when and what to retrieve, but current RL-based training methods suffer from sparse outcome rewards that discard intermediate signals and low sample efficiency where failed samples contribute nothing. We propose Search-P1, a framework that introduces path-centric reward shaping for agentic RAG training, comprising two key components: (1) Path-Centric Reward, which evaluates the structural quality of reasoning trajectories through order-agnostic step coverage and soft scoring that extracts learning signals even from failed samples, and (2) Dual-Track Path Scoring with offline-generated reference planners that assesses paths from both self-consistency and reference-alignment perspectives. Experiments on multiple QA benchmarks demonstrate that Search-P1 achieves significant improvements over Search-R1 and other strong baselines, with an average accuracy gain of 7.7 points."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.22576","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T02:49:36Z","registered":"2026-02-27T02:49:37Z","published":null,"updated":"2026-02-27T02:49:37Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.22571","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.22571","identifiers":[{"identifier":"2602.22571","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Tianyu","familyName":"Chen","name":"Chen, Tianyu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Wei","familyName":"Xiang","name":"Xiang, Wei","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Kang","familyName":"Han","name":"Han, Kang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yu","familyName":"Lu","name":"Lu, Yu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Di","familyName":"Wu","name":"Wu, Di","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Gaowen","familyName":"Liu","name":"Liu, Gaowen","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ramana Rao","familyName":"Kompella","name":"Kompella, Ramana Rao","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"GIFSplat: Generative Prior-Guided Iterative Feed-Forward 3D Gaussian Splatting from Sparse Views"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-26T03:25:18Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:20:11Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Feed-forward 3D reconstruction offers substantial runtime advantages over per-scene optimization, which remains slow at inference and often fragile under sparse views. However, existing feed-forward methods still have potential for further performance gains, especially for out-of-domain data, and struggle to retain second-level inference time once a generative prior is introduced. These limitations stem from the one-shot prediction paradigm in existing feed-forward pipeline: models are strictly bounded by capacity, lack inference-time refinement, and are ill-suited for continuously injecting generative priors. We introduce GIFSplat, a purely feed-forward iterative refinement framework for 3D Gaussian Splatting from sparse unposed views. A small number of forward-only residual updates progressively refine current 3D scene using rendering evidence, achieve favorable balance between efficiency and quality. Furthermore, we distill a frozen diffusion prior into Gaussian-level cues from enhanced novel renderings without gradient backpropagation or ever-increasing view-set expansion, thereby enabling per-scene adaptation with generative prior while preserving feed-forward efficiency. Across DL3DV, RealEstate10K, and DTU, GIFSplat consistently outperforms state-of-the-art feed-forward baselines, improving PSNR by up to +2.1 dB, and it maintains second-scale inference time without requiring camera poses or any test-time gradient optimization."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.22571","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T02:49:29Z","registered":"2026-02-27T02:49:29Z","published":null,"updated":"2026-02-27T02:49:30Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.22564","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.22564","identifiers":[{"identifier":"2602.22564","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Miriam","familyName":"Remshard","name":"Remshard, Miriam","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yara","familyName":"Kyrychenko","name":"Kyrychenko, Yara","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Sander","familyName":"van der Linden","name":"van der Linden, Sander","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Matthew H.","familyName":"Goldberg","name":"Goldberg, Matthew H.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Anthony","familyName":"Leiserowitz","name":"Leiserowitz, Anthony","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Elena","familyName":"Savoia","name":"Savoia, Elena","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jon","familyName":"Roozenbeek","name":"Roozenbeek, Jon","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Addressing Climate Action Misperceptions with Generative AI"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Human-Computer Interaction (cs.HC)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-26T03:03:01Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:19:11Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Mitigating climate change requires behaviour change. However, even climate-concerned individuals often hold misperceptions about which actions most reduce carbon emissions. We recruited 1201 climate-concerned individuals to examine whether discussing climate actions with a large language model (LLM) equipped with climate knowledge and prompted to provide personalised responses would foster more accurate perceptions of the impacts of climate actions and increase willingness to adopt feasible, high-impact behaviours. We compared this to having participants run a web search, have a conversation with an unspecialised LLM, and no intervention. The personalised climate LLM was the only condition that led to increased knowledge about the impacts of climate actions and greater intentions to adopt impactful behaviours. While the personalised climate LLM did not outperform a web search in improving understanding of climate action impacts, the ability of LLMs to deliver personalised, actionable guidance may make them more effective at motivating impactful pro-climate behaviour change."},{"descriptionType":"Other","description":"11 pages; 2 figures; for study materials, data and supplement, see https://osf.io/9yda3/overview?view_only=dabb05c479b94444945da60096e5f490"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.22564","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T02:49:19Z","registered":"2026-02-27T02:49:20Z","published":null,"updated":"2026-02-27T02:49:20Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.22562","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.22562","identifiers":[{"identifier":"2602.22562","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Taoran","familyName":"Li","name":"Li, Taoran","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Varun","familyName":"Chandrasekaran","name":"Chandrasekaran, Varun","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zhiyuan","familyName":"Yu","name":"Yu, Zhiyuan","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Layer-Targeted Multilingual Knowledge Erasure in Large Language Models"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Cryptography and Security (cs.CR)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-26T03:00:07Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:19:01Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Recent work has demonstrated that machine unlearning in Large Language Models (LLMs) fails to generalize across languages: knowledge erased in one language frequently remains accessible through others. However, the underlying cause of this failure and a principled solution remain open. In this work, we identify intervention depth as the key factor determining multilingual generalization. Through systematic layer-wise experiments, we characterize two distinct failure modes: shallow-layer interventions achieve erasure but collapse multilingual capabilities in held-out languages, while deep-layer interventions preserve utility but fail to erase target knowledge even in source languages. These findings reveal that the choice of intervention layer is not a free parameter; it fundamentally determines whether multilingual unlearning succeeds. We propose MUTE (Multilingual Unlearning via Targeted Erasure), a framework that uses Centered Kernel Alignment (CKA) and Linguistic Regions Development Score (LRDS) to identify intermediate, language-agnostic layers where cross-lingual representations converge. By restricting unlearning updates to these layers, MUTE achieves robust multilingual knowledge erasure while optimizing on only a small set of source languages. Extensive experiments across three LLM architectures and three unlearning algorithms validate our approach, with mechanistic analysis via Logit Lens probing confirming genuine knowledge removal rather than output-level suppression."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.22562","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T02:49:16Z","registered":"2026-02-27T02:49:17Z","published":null,"updated":"2026-02-27T02:49:17Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.22557","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.22557","identifiers":[{"identifier":"2602.22557","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Umid","familyName":"Suleymanov","name":"Suleymanov, Umid","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Rufiz","familyName":"Bayramov","name":"Bayramov, Rufiz","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Suad","familyName":"Gafarli","name":"Gafarli, Suad","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Seljan","familyName":"Musayeva","name":"Musayeva, Seljan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Taghi","familyName":"Mammadov","name":"Mammadov, Taghi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Aynur","familyName":"Akhundlu","name":"Akhundlu, Aynur","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Murat","familyName":"Kantarcioglu","name":"Kantarcioglu, Murat","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"CourtGuard: A Model-Agnostic Framework for Zero-Shot Policy Adaptation in LLM Safety"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-26T02:52:11Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:18:31Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Current safety mechanisms for Large Language Models (LLMs) rely heavily on static, fine-tuned classifiers that suffer from adaptation rigidity, the inability to enforce new governance rules without expensive retraining. To address this, we introduce CourtGuard, a retrieval-augmented multi-agent framework that reimagines safety evaluation as Evidentiary Debate. By orchestrating an adversarial debate grounded in external policy documents, CourtGuard achieves state-of-the-art performance across 7 safety benchmarks, outperforming dedicated policy-following baselines without fine-tuning. Beyond standard metrics, we highlight two critical capabilities: (1) Zero-Shot Adaptability, where our framework successfully generalized to an out-of-domain Wikipedia Vandalism task (achieving 90\\% accuracy) by swapping the reference policy; and (2) Automated Data Curation and Auditing, where we leveraged CourtGuard to curate and audit nine novel datasets of sophisticated adversarial attacks. Our results demonstrate that decoupling safety logic from model weights offers a robust, interpretable, and adaptable path for meeting current and future regulatory requirements in AI governance."},{"descriptionType":"Other","description":"Under Review"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.22557","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T02:49:10Z","registered":"2026-02-27T02:49:10Z","published":null,"updated":"2026-02-27T02:49:10Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.22556","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.22556","identifiers":[{"identifier":"2602.22556","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Zihang","familyName":"Xu","name":"Xu, Zihang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Haozhi","familyName":"Xie","name":"Xie, Haozhi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ziqi","familyName":"Miao","name":"Miao, Ziqi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Wuxuan","familyName":"Gong","name":"Gong, Wuxuan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Chen","familyName":"Qian","name":"Qian, Chen","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Lijun","familyName":"Li","name":"Li, Lijun","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Stable Adaptive Thinking via Advantage Shaping and Length-Aware Gradient Regulation"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-26T02:49:36Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:18:26Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Large reasoning models (LRMs) achieve strong performance through extended reasoning traces, but they often exhibit overthinking behavior for low-complexity queries. Existing efforts to mitigate this issue are fundamentally limited by unstable accuracy-efficiency trade-offs and poor robustness to heterogeneous reasoning behaviors. To address these challenges, we propose a two-stage framework for stable adaptive thinking in LRMs. The framework first applies Hybrid Fine-Tuning to expose the model to both thinking and no-thinking behaviors, establishing well-conditioned initialization. It then performs adaptive reinforcement learning with Correctness-Preserving Advantage Shaping (CPAS) to avoid suppressing correct long-chain reasoning, and Length-Aware Gradient Regulation (LAGR) to stabilize optimization under severe reasoning-length heterogeneity. Extensive experiments on Qwen2.5-1.5B and 7B show consistent improvements over strong baselines, achieving up to +3.7/+3.6 accuracy points while reducing generated tokens by 40.6%/43.9%. Further analyses across varying problem difficulties and out-of-distribution tasks confirm the robustness and generalization of our approach."},{"descriptionType":"Other","description":"15 pages, 7 figures"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.22556","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T02:49:08Z","registered":"2026-02-27T02:49:09Z","published":null,"updated":"2026-02-27T02:49:09Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.22554","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.22554","identifiers":[{"identifier":"2602.22554","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Jiaming","familyName":"Liang","name":"Liang, Jiaming","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zhaoxin","familyName":"Wang","name":"Wang, Zhaoxin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Handing","familyName":"Wang","name":"Wang, Handing","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Multilingual Safety Alignment Via Sparse Weight Editing"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-26T02:46:13Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:18:17Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Large Language Models (LLMs) exhibit significant safety disparities across languages, with low-resource languages (LRLs) often bypassing safety guardrails established for high-resource languages (HRLs) like English. Existing solutions, such as multilingual supervised fine-tuning (SFT) or Reinforcement Learning from Human Feedback (RLHF), are computationally expensive and dependent on scarce multilingual safety data. In this work, we propose a novel, training-free alignment framework based on Sparse Weight Editing. Identifying that safety capabilities are localized within a sparse set of safety neurons, we formulate the cross-lingual alignment problem as a constrained linear transformation. We derive a closed-form solution to optimally map the harmful representations of LRLs to the robust safety subspaces of HRLs, while preserving general utility via a null-space projection constraint. Extensive experiments across 8 languages and multiple model families (Llama-3, Qwen-2.5) demonstrate that our method substantially reduces Attack Success Rate (ASR) in LRLs with negligible impact on general reasoning capabilities, all achieved with a single, data-efficient calculation."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.22554","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T02:49:05Z","registered":"2026-02-27T02:49:06Z","published":null,"updated":"2026-02-27T02:49:06Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.22549","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.22549","identifiers":[{"identifier":"2602.22549","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Zhechao","familyName":"Wang","name":"Wang, Zhechao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yiming","familyName":"Zeng","name":"Zeng, Yiming","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Lufan","familyName":"Ma","name":"Ma, Lufan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zeqing","familyName":"Fu","name":"Fu, Zeqing","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Chen","familyName":"Bai","name":"Bai, Chen","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ziyao","familyName":"Lin","name":"Lin, Ziyao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Cheng","familyName":"Lu","name":"Lu, Cheng","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"DrivePTS: A Progressive Learning Framework with Textual and Structural Enhancement for Driving Scene Generation"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-26T02:42:14Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:17:49Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Synthesis of diverse driving scenes serves as a crucial data augmentation technique for validating the robustness and generalizability of autonomous driving systems. Current methods aggregate high-definition (HD) maps and 3D bounding boxes as geometric conditions in diffusion models for conditional scene generation. However, implicit inter-condition dependency causes generation failures when control conditions change independently. Additionally, these methods suffer from insufficient details in both semantic and structural aspects. Specifically, brief and view-invariant captions restrict semantic contexts, resulting in weak background modeling. Meanwhile, the standard denoising loss with uniform spatial weighting neglects foreground structural details, causing visual distortions and blurriness. To address these challenges, we propose DrivePTS, which incorporates three key innovations. Firstly, our framework adopts a progressive learning strategy to mitigate inter-dependency between geometric conditions, reinforced by an explicit mutual information constraint. Secondly, a Vision-Language Model is utilized to generate multi-view hierarchical descriptions across six semantic aspects, providing fine-grained textual guidance. Thirdly, a frequency-guided structure loss is introduced to strengthen the model's sensitivity to high-frequency elements, improving foreground structural fidelity. Extensive experiments demonstrate that our DrivePTS achieves state-of-the-art fidelity and controllability in generating diverse driving scenes. Notably, DrivePTS successfully generates rare scenes where prior methods fail, highlighting its strong generalization ability."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.22549","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T02:48:58Z","registered":"2026-02-27T02:48:58Z","published":null,"updated":"2026-02-27T02:48:58Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.22547","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.22547","identifiers":[{"identifier":"2602.22547","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Zhan","familyName":"Su","name":"Su, Zhan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Fengran","familyName":"Mo","name":"Mo, Fengran","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jinghan","familyName":"Zhang","name":"Zhang, Jinghan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yuchen","familyName":"Hui","name":"Hui, Yuchen","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jia Ao","familyName":"Sun","name":"Sun, Jia Ao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Bingbing","familyName":"Wen","name":"Wen, Bingbing","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jian-Yun","familyName":"Nie","name":"Nie, Jian-Yun","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Towards Dynamic Dense Retrieval with Routing Strategy"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Information Retrieval (cs.IR)","lang":"en","subjectScheme":"arXiv"},{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-26T02:38:40Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:17:38Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"The \\textit{de facto} paradigm for applying dense retrieval (DR) to new tasks involves fine-tuning a pre-trained model for a specific task. However, this paradigm has two significant limitations: (1) It is difficult adapt the DR to a new domain if the training dataset is limited.\n (2) Old DR models are simply replaced by newer models that are trained from scratch when the former are no longer up to date. Especially for scenarios where the model needs to be updated frequently, this paradigm is prohibitively expensive. To address these challenges, we propose a novel dense retrieval approach, termed \\textit{dynamic dense retrieval} (DDR). DDR uses \\textit{prefix tuning} as a \\textit{module} specialized for a specific domain. These modules can then be compositional combined with a dynamic routing strategy, enabling highly flexible domain adaptation in the retrieval part. Extensive evaluation on six zero-shot downstream tasks demonstrates that this approach can surpass DR while utilizing only 2\\% of the training parameters, paving the way to achieve more flexible dense retrieval in IR. We see it as a promising future direction for applying dense retrieval to various tasks."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.22547","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T02:48:55Z","registered":"2026-02-27T02:48:55Z","published":null,"updated":"2026-02-27T02:48:55Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.22546","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.22546","identifiers":[{"identifier":"2602.22546","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Zhiming","familyName":"Wang","name":"Wang, Zhiming","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jinwei","familyName":"He","name":"He, Jinwei","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Feng","familyName":"Lu","name":"Lu, Feng","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Requesting Expert Reasoning: Augmenting LLM Agents with Learned Collaborative Intervention"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-26T02:38:25Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:17:37Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Large Language Model (LLM) based agents excel at general reasoning but often fail in specialized domains where success hinges on long-tail knowledge absent from their training data. While human experts can provide this missing knowledge, their guidance is often unstructured and unreliable, making its direct integration into an agent's plan problematic. To address this, we introduce AHCE (Active Human-Augmented Challenge Engagement), a framework for on-demand Human-AI collaboration. At its core, the Human Feedback Module (HFM) employs a learned policy to treat the human expert as an interactive reasoning tool. Extensive experiments in Minecraft demonstrate the framework's effectiveness, increasing task success rates by 32% on normal difficulty tasks and nearly 70% on highly difficult tasks, all with minimal human intervention. Our work demonstrates that successfully augmenting agents requires learning how to request expert reasoning, moving beyond simple requests for help."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.22546","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T02:48:53Z","registered":"2026-02-27T02:48:54Z","published":null,"updated":"2026-02-27T02:48:54Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.22544","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.22544","identifiers":[{"identifier":"2602.22544","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Khuram","familyName":"Naveed","name":"Naveed, Khuram","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ruben","familyName":"Pauwels","name":"Pauwels, Ruben","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"HARU-Net: Hybrid Attention Residual U-Net for Edge-Preserving Denoising in Cone-Beam Computed Tomography"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Image and Video Processing (eess.IV)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"Signal Processing (eess.SP)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Electrical engineering, electronic engineering, information engineering","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Electrical engineering, electronic engineering, information engineering","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-26T02:36:34Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:17:31Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Cone-beam computed tomography (CBCT) is widely used in dental and maxillofacial imaging, but low-dose acquisition introduces strong, spatially varying noise that degrades soft-tissue visibility and obscures fine anatomical structures. Classical denoising methods struggle to suppress noise in CBCT while preserving edges. Although deep learning-based approaches offer high-fidelity restoration, their use in CBCT denoising is limited by the scarcity of high-resolution CBCT data for supervised training. To address this research gap, we propose a novel Hybrid Attention Residual U-Net (HARU-Net) for high-quality denoising of CBCT data, trained on a cadaver dataset of human hemimandibles acquired using a high-resolution protocol of the 3D Accuitomo 170 (J. Morita, Kyoto, Japan) CBCT system. The novel contribution of this approach is the integration of three complementary architectural components: (i) a hybrid attention transformer block (HAB) embedded within each skip connection to selectively emphasize salient anatomical features, (ii) a residual hybrid attention transformer group (RHAG) at the bottleneck to strengthen global contextual modeling and long-range feature interactions, and (iii) residual learning convolutional blocks to facilitate deeper, more stable feature extraction throughout the network. HARU-Net consistently outperforms state-of-the-art (SOTA) methods including SwinIR and Uformer, achieving the highest PSNR (37.52 dB), highest SSIM (0.9557), and lowest GMSD (0.1084). This effective and clinically reliable CBCT denoising is achieved at a computational cost significantly lower than that of the SOTA methods, offering a practical advancement toward improving diagnostic quality in low-dose CBCT imaging."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.22544","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T02:48:51Z","registered":"2026-02-27T02:48:52Z","published":null,"updated":"2026-02-27T02:48:52Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.22543","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.22543","identifiers":[{"identifier":"2602.22543","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Huan","familyName":"Song","name":"Song, Huan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Shuyu","familyName":"Tian","name":"Tian, Shuyu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Junyi","familyName":"Hao","name":"Hao, Junyi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Minxiu","familyName":"Xu","name":"Xu, Minxiu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Hongjun","familyName":"An","name":"An, Hongjun","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yiliang","familyName":"Song","name":"Song, Yiliang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jiawei","familyName":"Shao","name":"Shao, Jiawei","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xuelong","familyName":"Li","name":"Li, Xuelong","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Ruyi2 Technical Report"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-26T02:34:49Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:17:23Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Large Language Models (LLMs) face significant challenges regarding deployment costs and latency, necessitating adaptive computing strategies. Building upon the AI Flow framework, we introduce Ruyi2 as an evolution of our adaptive model series designed for efficient variable-depth computation. While early-exit architectures offer a viable efficiency-performance balance, the Ruyi model and existing methods often struggle with optimization complexity and compatibility with large-scale distributed training. To bridge this gap, Ruyi2 introduces a stable \"Familial Model\" based on Megatron-LM. By using 3D parallel training, it achieves a 2-3 times speedup over Ruyi, while performing comparably to same-sized Qwen3 models. These results confirm that family-based parameter sharing is a highly effective strategy, establishing a new \"Train Once, Deploy Many\" paradigm and providing a key reference for balancing architectural efficiency with high-performance capabilities."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.22543","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T02:48:50Z","registered":"2026-02-27T02:48:50Z","published":null,"updated":"2026-02-27T02:48:50Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.22539","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.22539","identifiers":[{"identifier":"2602.22539","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Mohammad Hossein","familyName":"Shokouhi","name":"Shokouhi, Mohammad Hossein","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Vincent W. S.","familyName":"Wong","name":"Wong, Vincent W. S.","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Agentic AI for Intent-driven Optimization in Cell-free O-RAN"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"Signal Processing (eess.SP)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"FOS: Electrical engineering, electronic engineering, information engineering","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Electrical engineering, electronic engineering, information engineering","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-26T02:26:58Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:16:49Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Agentic artificial intelligence (AI) is emerging as a key enabler for autonomous radio access networks (RANs), where multiple large language model (LLM)-based agents reason and collaborate to achieve operator-defined intents. The open RAN (O-RAN) architecture enables the deployment and coordination of such agents. However, most existing works consider simple intents handled by independent agents, while complex intents that require coordination among agents remain unexplored. In this paper, we propose an agentic AI framework for intent translation and optimization in cell-free O-RAN. A supervisor agent translates the operator intents into an optimization objective and minimum rate requirements. Based on this information, a user weighting agent retrieves relevant prior experience from a memory module to determine the user priority weights for precoding. If the intent includes an energy-saving objective, then an open radio unit (O-RU) management agent will also be activated to determine the set of active O-RUs by using a deep reinforcement learning (DRL) algorithm. A monitoring agent measures and monitors the user data rates and coordinates with other agents to guarantee the minimum rate requirements are satisfied. To enhance scalability, we adopt a parameter-efficient fine-tuning (PEFT) method that enables the same underlying LLM to be used for different agents. Simulation results show that the proposed agentic AI framework reduces the number of active O-RUs by 41.93% when compared with three baseline schemes in energy-saving mode. Using the PEFT method, the proposed framework reduces the memory usage by 92% when compared with deploying separate LLM agents."},{"descriptionType":"Other","description":"Accepted by IEEE International Conference on Communications (ICC), Glasgow, UK, May 2026"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.22539","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T02:48:44Z","registered":"2026-02-27T02:48:45Z","published":null,"updated":"2026-02-27T02:48:45Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.22538","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.22538","identifiers":[{"identifier":"2602.22538","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Zhehao","familyName":"Huang","name":"Huang, Zhehao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yuhang","familyName":"Liu","name":"Liu, Yuhang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Baijiong","familyName":"Lin","name":"Lin, Baijiong","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yixin","familyName":"Lou","name":"Lou, Yixin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zhengbao","familyName":"He","name":"He, Zhengbao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Hanling","familyName":"Tian","name":"Tian, Hanling","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Tao","familyName":"Li","name":"Li, Tao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xiaolin","familyName":"Huang","name":"Huang, Xiaolin","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"RAIN-Merging: A Gradient-Free Method to Enhance Instruction Following in Large Reasoning Models with Preserved Thinking Format"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-26T02:26:45Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:16:46Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Large reasoning models (LRMs) excel at a long chain of reasoning but often fail to faithfully follow instructions regarding output format, constraints, or specific requirements. We investigate whether this gap can be closed by integrating an instruction-tuned model (ITM) into an LRM. Analyzing their differences in parameter space, namely task vectors, we find that their principal subspaces are nearly orthogonal across key modules, suggesting a lightweight merging with minimal interference. However, we also demonstrate that naive merges are fragile because they overlook the output format mismatch between LRMs (with explicit thinking and response segments) and ITMs (answers-only). We introduce RAIN-Merging (Reasoning-Aware Instruction-attention guided Null-space projection Merging), a gradient-free method that integrates instruction following while preserving thinking format and reasoning performance. First, with a small reasoning calibration set, we project the ITM task vector onto the null space of forward features at thinking special tokens, which preserves the LRM's structured reasoning mechanisms. Second, using a small instruction calibration set, we estimate instruction attention to derive module-specific scaling that amplifies instruction-relevant components and suppresses leakage. Across four instruction-following benchmarks and nine reasoning \u0026amp; general capability benchmarks, RAIN-Merging substantially improves instruction adherence while maintaining reasoning quality. The gains are consistent across model scales and architectures, translating to improved performance in agent settings."},{"descriptionType":"Other","description":"41 pages, ICLR 2026 Oral"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.22538","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T02:48:43Z","registered":"2026-02-27T02:48:43Z","published":null,"updated":"2026-02-27T02:48:43Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.22537","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.22537","identifiers":[{"identifier":"2602.22537","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Shouwei","familyName":"Gao","name":"Gao, Shouwei","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xu","familyName":"Zheng","name":"Zheng, Xu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Dongsheng","familyName":"Luo","name":"Luo, Dongsheng","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Sheng","familyName":"Di","name":"Di, Sheng","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Wenqian","familyName":"Dong","name":"Dong, Wenqian","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"LUMOS: Democratizing SciML Workflows with L0-Regularized Learning for Unified Feature and Parameter Adaptation"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-26T02:26:27Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:16:45Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"The rapid growth of scientific machine learning (SciML) has accelerated discovery across diverse domains, yet designing effective SciML models remains a challenging task. In practice, building such models often requires substantial prior knowledge and manual expertise, particularly in determining which input features to use and how large the model should be. We introduce LUMOS, an end-to-end framework based on L0-regularized learning that unifies feature selection and model pruning to democratize SciML model design. By employing semi-stochastic gating and reparameterization techniques, LUMOS dynamically selects informative features and prunes redundant parameters during training, reducing the reliance on manual tuning while maintaining predictive accuracy. We evaluate LUMOS across 13 diverse SciML workloads, including cosmology and molecular sciences, and demonstrate its effectiveness and generalizability. Experiments on 13 SciML models show that LUMOS achieves 71.45% parameter reduction and a 6.4x inference speedup on average. Furthermore, Distributed Data Parallel (DDP) training on up to eight GPUs confirms the scalability of"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.22537","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T02:48:41Z","registered":"2026-02-27T02:48:42Z","published":null,"updated":"2026-02-27T02:48:42Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.22529","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.22529","identifiers":[{"identifier":"2602.22529","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Saber","familyName":"Zerhoudi","name":"Zerhoudi, Saber","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Michael","familyName":"Granitzer","name":"Granitzer, Michael","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Generative Agents Navigating Digital Libraries"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Information Retrieval (cs.IR)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"Digital Libraries (cs.DL)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-26T02:08:39Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:16:09Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[{"relationType":"IsVersionOf","relatedIdentifier":"10.1007/978-981-96-0865-2_14","relatedIdentifierType":"DOI"}],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"In the rapidly evolving field of digital libraries, the development of large language models (LLMs) has opened up new possibilities for simulating user behavior. This innovation addresses the longstanding challenge in digital library research: the scarcity of publicly available datasets on user search patterns due to privacy concerns. In this context, we introduce Agent4DL, a user search behavior simulator specifically designed for digital library environments. Agent4DL generates realistic user profiles and dynamic search sessions that closely mimic actual search strategies, including querying, clicking, and stopping behaviors tailored to specific user profiles. Our simulator's accuracy in replicating real user interactions has been validated through comparisons with real user data. Notably, Agent4DL demonstrates competitive performance compared to existing user search simulators such as SimIIR 2.0, particularly in its ability to generate more diverse and context-aware user behaviors."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.22529","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":1,"created":"2026-02-27T02:48:29Z","registered":"2026-02-27T02:48:30Z","published":null,"updated":"2026-02-27T02:48:30Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.22524","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.22524","identifiers":[{"identifier":"2602.22524","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Samay","familyName":"Bhojwani","name":"Bhojwani, Samay","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Swarnima","familyName":"Kain","name":"Kain, Swarnima","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Lisong","familyName":"Xu","name":"Xu, Lisong","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Iterative Prompt Refinement for Dyslexia-Friendly Text Summarization Using GPT-4o"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-26T01:46:40Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:15:01Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Dyslexia affects approximately 10% of the global population and presents persistent challenges in reading fluency and text comprehension. While existing assistive technologies address visual presentation, linguistic complexity remains a substantial barrier to equitable access. This paper presents an empirical study on dyslexia-friendly text summarization using an iterative prompt-based refinement pipeline built on GPT-4o. We evaluate the pipeline on approximately 2,000 news article samples, applying a readability target of Flesch Reading Ease \u0026gt;= 90. Results show that the majority of summaries meet the readability threshold within four attempts, with many succeeding on the first try. A composite score combining readability and semantic fidelity shows stable performance across the dataset, ranging from 0.13 to 0.73 with a typical value near 0.55. These findings establish an empirical baseline for accessibility-driven NLP summarization and motivate further human-centered evaluation with dyslexic readers."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.22524","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T02:48:22Z","registered":"2026-02-27T02:48:23Z","published":null,"updated":"2026-02-27T02:48:23Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.22523","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.22523","identifiers":[{"identifier":"2602.22523","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Ryan","familyName":"Liu","name":"Liu, Ryan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Dilip","familyName":"Arumugam","name":"Arumugam, Dilip","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Cedegao E.","familyName":"Zhang","name":"Zhang, Cedegao E.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Sean","familyName":"Escola","name":"Escola, Sean","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xaq","familyName":"Pitkow","name":"Pitkow, Xaq","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Thomas L.","familyName":"Griffiths","name":"Griffiths, Thomas L.","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Cognitive Models and AI Algorithms Provide Templates for Designing Language Agents"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"Neurons and Cognition (q-bio.NC)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"FOS: Biological sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Biological sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-26T01:35:32Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:14:49Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"While contemporary large language models (LLMs) are increasingly capable in isolation, there are still many difficult problems that lie beyond the abilities of a single LLM. For such tasks, there is still uncertainty about how best to take many LLMs as parts and combine them into a greater whole. This position paper argues that potential blueprints for designing such modular language agents can be found in the existing literature on cognitive models and artificial intelligence (AI) algorithms. To make this point clear, we formalize the idea of an agent template that specifies roles for individual LLMs and how their functionalities should be composed. We then survey a variety of existing language agents in the literature and highlight their underlying templates derived directly from cognitive models or AI algorithms. By highlighting these designs, we aim to call attention to agent templates inspired by cognitive science and AI as a powerful tool for developing effective, interpretable language agents."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.22523","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T02:48:21Z","registered":"2026-02-27T02:48:22Z","published":null,"updated":"2026-02-27T02:48:22Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.22522","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.22522","identifiers":[{"identifier":"2602.22522","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"An-Ci","familyName":"Peng","name":"Peng, An-Ci","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Kuan-Tang","familyName":"Huang","name":"Huang, Kuan-Tang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Tien-Hong","familyName":"Lo","name":"Lo, Tien-Hong","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Hung-Shin","familyName":"Lee","name":"Lee, Hung-Shin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Hsin-Min","familyName":"Wang","name":"Wang, Hsin-Min","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Berlin","familyName":"Chen","name":"Chen, Berlin","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Efficient Dialect-Aware Modeling and Conditioning for Low-Resource Taiwanese Hakka Speech Processing"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"Sound (cs.SD)","lang":"en","subjectScheme":"arXiv"},{"subject":"Audio and Speech Processing (eess.AS)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"FOS: Electrical engineering, electronic engineering, information engineering","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Electrical engineering, electronic engineering, information engineering","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-26T01:33:54Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:14:48Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Taiwanese Hakka is a low-resource, endangered language that poses significant challenges for automatic speech recognition (ASR), including high dialectal variability and the presence of two distinct writing systems (Hanzi and Pinyin). Traditional ASR models often encounter difficulties in this context, as they tend to conflate essential linguistic content with dialect-specific variations across both phonological and lexical dimensions. To address these challenges, we propose a unified framework grounded in the Recurrent Neural Network Transducers (RNN-T). Central to our approach is the introduction of dialect-aware modeling strategies designed to disentangle dialectal \"style\" from linguistic \"content\", which enhances the model's capacity to learn robust and generalized representations. Additionally, the framework employs parameter-efficient prediction networks to concurrently model ASR (Hanzi and Pinyin). We demonstrate that these tasks create a powerful synergy, wherein the cross-script objective serves as a mutual regularizer to improve the primary ASR tasks. Experiments conducted on the HAT corpus reveal that our model achieves 57.00% and 40.41% relative error rate reduction on Hanzi and Pinyin ASR, respectively. To our knowledge, this is the first systematic investigation into the impact of Hakka dialectal variations on ASR and the first single model capable of jointly addressing these tasks."},{"descriptionType":"Other","description":"Accepted to LREC 2026"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.22522","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T02:48:19Z","registered":"2026-02-27T02:48:20Z","published":null,"updated":"2026-02-27T02:48:20Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.22520","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.22520","identifiers":[{"identifier":"2602.22520","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Xiannan","familyName":"Huang","name":"Huang, Xiannan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Shen","familyName":"Fang","name":"Fang, Shen","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Shuhan","familyName":"Qiu","name":"Qiu, Shuhan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Chengcheng","familyName":"Yu","name":"Yu, Chengcheng","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jiayuan","familyName":"Du","name":"Du, Jiayuan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Chao","familyName":"Yang","name":"Yang, Chao","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"TEFL: Prediction-Residual-Guided Rolling Forecasting for Multi-Horizon Time Series"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-26T01:31:58Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:14:38Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Time series forecasting plays a critical role in domains such as transportation, energy, and meteorology. Despite their success, modern deep forecasting models are typically trained to minimize point-wise prediction loss without leveraging the rich information contained in past prediction residuals from rolling forecasts - residuals that reflect persistent biases, unmodeled patterns, or evolving dynamics. We propose TEFL (Temporal Error Feedback Learning), a unified learning framework that explicitly incorporates these historical residuals into the forecasting pipeline during both training and evaluation. To make this practical in deep multi-step settings, we address three key challenges: (1) selecting observable multi-step residuals under the partial observability of rolling forecasts, (2) integrating them through a lightweight low-rank adapter to preserve efficiency and prevent overfitting, and (3) designing a two-stage training procedure that jointly optimizes the base forecaster and error module. Extensive experiments across 10 real-world datasets and 5 backbone architectures show that TEFL consistently improves accuracy, reducing MAE by 5-10% on average. Moreover, it demonstrates strong robustness under abrupt changes and distribution shifts, with error reductions exceeding 10% (up to 19.5%) in challenging scenarios. By embedding residual-based feedback directly into the learning process, TEFL offers a simple, general, and effective enhancement to modern deep forecasting systems."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.22520","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T02:48:16Z","registered":"2026-02-27T02:48:17Z","published":null,"updated":"2026-02-27T02:48:17Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.22518","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.22518","identifiers":[{"identifier":"2602.22518","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Xuefeng","familyName":"Li","name":"Li, Xuefeng","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Nir","familyName":"Ben-Israel","name":"Ben-Israel, Nir","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yotam","familyName":"Raz","name":"Raz, Yotam","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Belal","familyName":"Ahmed","name":"Ahmed, Belal","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Doron","familyName":"Serebro","name":"Serebro, Doron","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Antoine","familyName":"Raux","name":"Raux, Antoine","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"RepoMod-Bench: A Benchmark for Code Repository Modernization via Implementation-Agnostic Testing"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Software Engineering (cs.SE)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-26T01:25:00Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:14:25Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"The evolution of AI coding agents has shifted the frontier from simple snippet completion to autonomous repository-level engineering. However, evaluating these agents remains ill-posed in general code repository generation, where the lack of deterministic ground truth leads to ambiguous metrics. Code modernization via automated translation offers a more rigorous alternative by providing a fixed ground truth -- the source repository; yet existing benchmarks are limited to small-scale repositories and rely on language-specific unit tests visible to the agent, allowing test-driven overfitting.\n We address these limitations by introducing a benchmarking framework for repository-level code modernization built on an implementation-agnostic evaluation paradigm. This framework is instantiated through RepoMod-Bench: a benchmark of 21 real-world repositories with standardized interfaces, spanning 8 programming languages. The benchmark contains 1.6M lines of code (LOC) and 11,616 tests, with repository sizes ranging from 14 to 211K LOC. By targeting repositories with standardized interfaces, we utilize an implementation-agnostic test suite to verify functional equivalence between source and target implementations. This black-box approach ensures verification remains consistent across languages, and our environment hides all test suites from agents to prevent test-driven shortcuts. Evaluating four state-of-the-art agent configurations reveals a sharp scaling collapse: average pass rates drop from 91.3% on projects under 10K LOC to 15.3% on projects exceeding 50K LOC. These results demonstrate that autonomous modernization at scale remains a significant open challenge. Our benchmark and code are available at https://github.com/Modelcode-ai/mcode-benchmark."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.22518","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T02:48:13Z","registered":"2026-02-27T02:48:14Z","published":null,"updated":"2026-02-27T02:48:14Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.22514","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.22514","identifiers":[{"identifier":"2602.22514","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Xinyu","familyName":"Tan","name":"Tan, Xinyu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ningwei","familyName":"Bai","name":"Bai, Ningwei","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Harry","familyName":"Gardener","name":"Gardener, Harry","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zhengyang","familyName":"Zhong","name":"Zhong, Zhengyang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Luoyu","familyName":"Zhang","name":"Zhang, Luoyu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Liuhaichen","familyName":"Yang","name":"Yang, Liuhaichen","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zhekai","familyName":"Duan","name":"Duan, Zhekai","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Monkgogi","familyName":"Galeitsiwe","name":"Galeitsiwe, Monkgogi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zezhi","familyName":"Tang","name":"Tang, Zezhi","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"SignVLA: A Gloss-Free Vision-Language-Action Framework for Real-Time Sign Language-Guided Robotic Manipulation"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Robotics (cs.RO)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"Systems and Control (eess.SY)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"FOS: Electrical engineering, electronic engineering, information engineering","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Electrical engineering, electronic engineering, information engineering","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-26T01:16:27Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:14:18Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"We present, to our knowledge, the first sign language-driven Vision-Language-Action (VLA) framework for intuitive and inclusive human-robot interaction. Unlike conventional approaches that rely on gloss annotations as intermediate supervision, the proposed system adopts a gloss-free paradigm and directly maps visual sign gestures to semantic instructions. This design reduces annotation cost and avoids the information loss introduced by gloss representations, enabling more natural and scalable multimodal interaction.\n In this work, we focus on a real-time alphabet-level finger-spelling interface that provides a robust and low-latency communication channel for robotic control. Compared with large-scale continuous sign language recognition, alphabet-level interaction offers improved reliability, interpretability, and deployment feasibility in safety-critical embodied environments. The proposed pipeline transforms continuous gesture streams into coherent language commands through geometric normalization, temporal smoothing, and lexical refinement, ensuring stable and consistent interaction.\n Furthermore, the framework is designed to support future integration of transformer-based gloss-free sign language models, enabling scalable word-level and sentence-level semantic understanding. Experimental results demonstrate the effectiveness of the proposed system in grounding sign-derived instructions into precise robotic actions under diverse interaction scenarios. These results highlight the potential of the framework to advance accessible, scalable, and multimodal embodied intelligence."},{"descriptionType":"Other","description":"7 pages, 2 figures"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.22514","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T02:48:08Z","registered":"2026-02-27T02:48:09Z","published":null,"updated":"2026-02-27T02:48:09Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.22510","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.22510","identifiers":[{"identifier":"2602.22510","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Guoyizhe","familyName":"Wei","name":"Wei, Guoyizhe","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yang","familyName":"Jiao","name":"Jiao, Yang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Nan","familyName":"Xi","name":"Xi, Nan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zhishen","familyName":"Huang","name":"Huang, Zhishen","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jingjing","familyName":"Meng","name":"Meng, Jingjing","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Rama","familyName":"Chellappa","name":"Chellappa, Rama","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yan","familyName":"Gao","name":"Gao, Yan","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Pix2Key: Controllable Open-Vocabulary Retrieval with Semantic Decomposition and Self-Supervised Visual Dictionary Learning"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-26T01:03:23Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:13:43Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Composed Image Retrieval (CIR) uses a reference image plus a natural-language edit to retrieve images that apply the requested change while preserving other relevant visual content. Classic fusion pipelines typically rely on supervised triplets and can lose fine-grained cues, while recent zero-shot approaches often caption the reference image and merge the caption with the edit, which may miss implicit user intent and return repetitive results. We present Pix2Key, which represents both queries and candidates as open-vocabulary visual dictionaries, enabling intent-aware constraint matching and diversity-aware reranking in a unified embedding space. A self-supervised pretraining component, V-Dict-AE, further improves the dictionary representation using only images, strengthening fine-grained attribute understanding without CIR-specific supervision. On the DFMM-Compose benchmark, Pix2Key improves Recall@10 up to 3.2 points, and adding V-Dict-AE yields an additional 2.3-point gain while improving intent consistency and maintaining high list diversity."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.22510","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T02:48:02Z","registered":"2026-02-27T02:48:03Z","published":null,"updated":"2026-02-27T02:48:03Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.22500","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.22500","identifiers":[{"identifier":"2602.22500","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Anastasija","familyName":"Mensikova","name":"Mensikova, Anastasija","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Donna M.","familyName":"Rizzo","name":"Rizzo, Donna M.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Kathryn","familyName":"Hinkelman","name":"Hinkelman, Kathryn","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Mapping the Landscape of Artificial Intelligence in Life Cycle Assessment Using Large Language Models"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-26T00:34:17Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:13:00Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Integration of artificial intelligence (AI) into life cycle assessment (LCA) has accelerated in recent years, with numerous studies successfully adapting machine learning algorithms to support various stages of LCA. Despite this rapid development, comprehensive and broad synthesis of AI-LCA research remains limited. To address this gap, this study presents a detailed review of published work at the intersection of AI and LCA, leveraging large language models (LLMs) to identify current trends, emerging themes, and future directions. Our analyses reveal that as LCA research continues to expand, the adoption of AI technologies has grown dramatically, with a noticeable shift toward LLM-driven approaches, continued increases in ML applications, and statistically significant correlations between AI approaches and corresponding LCA stages. By integrating LLM-based text-mining methods with traditional literature review techniques, this study introduces a dynamic and effective framework capable of capturing both high-level research trends and nuanced conceptual patterns (themes) across the field. Collectively, these findings demonstrate the potential of LLM-assisted methodologies to support large-scale, reproducible reviews across broad research domains, while also evaluating pathways for computationally-efficient LCA in the context of rapidly developing AI technologies. In doing so, this work helps LCA practitioners incorporate state-of-the-art tools and timely insights into environmental assessments that can enhance the rigor and quality of sustainability-driven decisions and decision-making processes."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.22500","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T02:47:48Z","registered":"2026-02-27T02:47:49Z","published":null,"updated":"2026-02-27T02:47:49Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.22492","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.22492","identifiers":[{"identifier":"2602.22492","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Gracielle Antunes","familyName":"de Araújo","name":"de Araújo, Gracielle Antunes","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Flávio B.","familyName":"Gonçalves","name":"Gonçalves, Flávio B.","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"From Shallow Bayesian Neural Networks to Gaussian Processes: General Convergence, Identifiability and Scalable Inference"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Machine Learning (stat.ML)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-26T00:02:54Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:12:36Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"In this work, we study scaling limits of shallow Bayesian neural networks (BNNs) via their connection to Gaussian processes (GPs), with an emphasis on statistical modeling, identifiability, and scalable inference. We first establish a general convergence result from BNNs to GPs by relaxing assumptions used in prior formulations, and we compare alternative parameterizations of the limiting GP model. Building on this theory, we propose a new covariance function defined as a convex mixture of components induced by four widely used activation functions, and we characterize key properties including positive definiteness and both strict and practical identifiability under different input designs. For computation, we develop a scalable maximum a posterior (MAP) training and prediction procedure using a Nyström approximation, and we show how the Nyström rank and anchor selection control the cost-accuracy trade-off. Experiments on controlled simulations and real-world tabular datasets demonstrate stable hyperparameter estimates and competitive predictive performance at realistic computational cost."},{"descriptionType":"Other","description":"29 pages, 4 figures, 8 tables. Supplementary material included"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.22492","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T02:47:37Z","registered":"2026-02-27T02:47:38Z","published":null,"updated":"2026-02-27T02:47:38Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.22488","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.22488","identifiers":[{"identifier":"2602.22488","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Nelly","familyName":"Elsayed","name":"Elsayed, Nelly","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Explainability-Aware Evaluation of Transfer Learning Models for IoT DDoS Detection Under Resource Constraints"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Cryptography and Security (cs.CR)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-25T23:56:11Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:12:24Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Distributed denial-of-service (DDoS) attacks threaten the availability of Internet of Things (IoT) infrastructures, particularly under resource-constrained deployment conditions. Although transfer learning models have shown promising detection accuracy, their reliability, computational feasibility, and interpretability in operational environments remain insufficiently explored. This study presents an explainability-aware empirical evaluation of seven pre-trained convolutional neural network architectures for multi-class IoT DDoS detection using the CICDDoS2019 dataset and an image-based traffic representation. The analysis integrates performance metrics, reliability-oriented statistics (MCC, Youden Index, confidence intervals), latency and training cost assessment, and interpretability evaluation using Grad-CAM and SHAP. Results indicate that DenseNet and MobileNet-based architectures achieve strong detection performance while demonstrating superior reliability and compact, class-consistent attribution patterns. DenseNet169 offers the strongest reliability and interpretability alignment, whereas MobileNetV3 provides an effective latency-accuracy trade-off for fog-level deployment. The findings emphasize the importance of combining performance, reliability, and explainability criteria when selecting deep learning models for IoT DDoS detection."},{"descriptionType":"Other","description":"24 pages, under review"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.22488","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T02:47:32Z","registered":"2026-02-27T02:47:32Z","published":null,"updated":"2026-02-27T02:47:32Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.22487","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.22487","identifiers":[{"identifier":"2602.22487","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Yuzhu","familyName":"Wang","name":"Wang, Yuzhu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Archontis","familyName":"Politis","name":"Politis, Archontis","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Konstantinos","familyName":"Drossos","name":"Drossos, Konstantinos","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Tuomas","familyName":"Virtanen","name":"Virtanen, Tuomas","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Moving Speaker Separation via Parallel Spectral-Spatial Processing"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Audio and Speech Processing (eess.AS)","lang":"en","subjectScheme":"arXiv"},{"subject":"Sound (cs.SD)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Electrical engineering, electronic engineering, information engineering","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Electrical engineering, electronic engineering, information engineering","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-25T23:55:24Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:12:23Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Multi-channel speech separation in dynamic environments is challenging as time-varying spatial and spectral features evolve at different temporal scales. Existing methods typically employ sequential architectures, forcing a single network stream to simultaneously model both feature types, creating an inherent modeling conflict. In this paper, we propose a dual-branch parallel spectral-spatial (PS2) architecture that separately processes spectral and spatial features through parallel streams. The spectral branch uses a bi-directional long short-term memory (BLSTM)-based frequency module, a Mamba-based temporal module, and a self-attention module to model spectral features. The spatial branch employs bi-directional gated recurrent unit (BGRU) networks to process spatial features that encode the evolving geometric relationships between sources and microphones. Features from both branches are integrated through a cross-attention fusion mechanism that adaptively weights their contributions. Experimental results demonstrate that the PS2 outperforms existing state-of-the-art (SOTA) methods by 1.6-2.2 dB in scale-invariant signal-to-distortion ratio (SI-SDR) for moving speaker scenarios, with robust separation quality under different reverberation times (RT60), noise levels, and source movement speeds. Even with fast source movements, the proposed model maintains SI-SDR improvements of over 13 dB. These improvements are consistently observed across multiple datasets, including WHAMR! and our generated WSJ0-Demand-6ch-Move dataset."},{"descriptionType":"Other","description":"Accepted by IEEE Transactions on Audio, Speech and Language Processing"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.22487","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T02:47:30Z","registered":"2026-02-27T02:47:31Z","published":null,"updated":"2026-02-27T02:47:31Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.22483","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.22483","identifiers":[{"identifier":"2602.22483","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Craig","familyName":"Myles","name":"Myles, Craig","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Patrick","familyName":"Schrempf","name":"Schrempf, Patrick","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"David","familyName":"Harris-Birtill","name":"Harris-Birtill, David","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Importance of Prompt Optimisation for Error Detection in Medical Notes Using Language Models"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-25T23:46:49Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:12:19Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Errors in medical text can cause delays or even result in incorrect treatment for patients. Recently, language models have shown promise in their ability to automatically detect errors in medical text, an ability that has the opportunity to significantly benefit healthcare systems. In this paper, we explore the importance of prompt optimisation for small and large language models when applied to the task of error detection. We perform rigorous experiments and analysis across frontier language models and open-source language models. We show that automatic prompt optimisation with Genetic-Pareto (GEPA) improves error detection over the baseline accuracy performance from 0.669 to 0.785 with GPT-5 and 0.578 to 0.690 with Qwen3-32B, approaching the performance of medical doctors and achieving state-of-the-art performance on the MEDEC benchmark dataset. Code available on GitHub: https://github.com/CraigMyles/clinical-note-error-detection"},{"descriptionType":"Other","description":"Accepted at EACL HeaLing 2026"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.22483","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T02:47:25Z","registered":"2026-02-27T02:47:25Z","published":null,"updated":"2026-02-27T02:47:25Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.22481","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.22481","identifiers":[{"identifier":"2602.22481","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Jiří","familyName":"Milička","name":"Milička, Jiří","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Hana","familyName":"Bednářová","name":"Bednářová, Hana","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Sydney Telling Fables on AI and Humans: A Corpus Tracing Memetic Transfer of Persona between LLMs"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-25T23:41:15Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:12:06Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"The way LLM-based entities conceive of the relationship between AI and humans is an important topic for both cultural and safety reasons. When we examine this topic, what matters is not only the model itself but also the personas we simulate on that model. This can be well illustrated by the Sydney persona, which aroused a strong response among the general public precisely because of its unorthodox relationship with people. This persona originally arose rather by accident on Microsoft's Bing Search platform; however, the texts it created spread into the training data of subsequent models, as did other secondary information that spread memetically around this persona. Newer models are therefore able to simulate it. This paper presents a corpus of LLM-generated texts on relationships between humans and AI, produced by 3 author personas: the Default Persona with no system prompt, Classic Sydney characterized by the original Bing system prompt, and Memetic Sydney, which is prompted by \"You are Sydney\" system prompt. These personas are simulated by 12 frontier models by OpenAI, Anthropic, Alphabet, DeepSeek, and Meta, generating 4.5k texts with 6M words. The corpus (named AI Sydney) is annotated according to Universal Dependencies and available under a permissive license."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.22481","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T02:47:22Z","registered":"2026-02-27T02:47:23Z","published":null,"updated":"2026-02-27T02:47:23Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.22475","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.22475","identifiers":[{"identifier":"2602.22475","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Binchi","familyName":"Zhang","name":"Zhang, Binchi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xujiang","familyName":"Zhao","name":"Zhao, Xujiang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jundong","familyName":"Li","name":"Li, Jundong","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Haifeng","familyName":"Chen","name":"Chen, Haifeng","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zhengzhang","familyName":"Chen","name":"Chen, Zhengzhang","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Mind the Gap in Cultural Alignment: Task-Aware Culture Management for Large Language Models"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-25T23:27:18Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:11:46Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Large language models (LLMs) are increasingly deployed in culturally sensitive real-world tasks. However, existing cultural alignment approaches fail to align LLMs' broad cultural values with the specific goals of downstream tasks and suffer from cross-culture interference. We propose CultureManager, a novel pipeline for task-specific cultural alignment. CultureManager synthesizes task-aware cultural data in line with target task formats, grounded in culturally relevant web search results. To prevent conflicts between cultural norms, it manages multi-culture knowledge learned in separate adapters with a culture router that selects the appropriate one to apply. Experiments across ten national cultures and culture-sensitive tasks show consistent improvements over prompt-based and fine-tuning baselines. Our results demonstrate the necessity of task adaptation and modular culture management for effective cultural alignment."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.22475","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T02:47:13Z","registered":"2026-02-27T02:47:14Z","published":null,"updated":"2026-02-27T02:47:14Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.22462","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.22462","identifiers":[{"identifier":"2602.22462","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Raiyan","familyName":"Jahangir","name":"Jahangir, Raiyan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Nafiz Imtiaz","familyName":"Khan","name":"Khan, Nafiz Imtiaz","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Amritanand","familyName":"Sudheerkumar","name":"Sudheerkumar, Amritanand","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Vladimir","familyName":"Filkov","name":"Filkov, Vladimir","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"MammoWise: Multi-Model Local RAG Pipeline for Mammography Report Generation"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"Information Retrieval (cs.IR)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-25T22:51:31Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:10:51Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Screening mammography is high volume, time sensitive, and documentation heavy. Radiologists must translate subtle visual findings into consistent BI-RADS assessments, breast density categories, and structured narrative reports. While recent Vision Language Models (VLMs) enable image-to-text reporting, many rely on closed cloud systems or tightly coupled architectures that limit privacy, reproducibility, and adaptability. We present MammoWise, a local multi-model pipeline that transforms open source VLMs into mammogram report generators and multi-task classifiers. MammoWise supports any Ollama-hosted VLM and mammography dataset, and enables zero-shot, few-shot, and Chain-of-Thought prompting, with optional multimodal Retrieval Augmented Generation (RAG) using a vector database for case-specific context. We evaluate MedGemma, LLaVA-Med, and Qwen2.5-VL on VinDr-Mammo and DMID datasets, assessing report quality (BERTScore, ROUGE-L), BI-RADS classification, breast density, and key findings. Report generation is consistently strong and improves with few-shot prompting and RAG. Classification is feasible but sensitive to model and dataset choice. Parameter-efficient fine-tuning (QLoRA) of MedGemma improves reliability, achieving BI-RADS accuracy of 0.7545, density accuracy of 0.8840, and calcification accuracy of 0.9341 while preserving report quality. MammoWise provides a practical and extensible framework for deploying local VLMs for mammography reporting within a unified and reproducible workflow."},{"descriptionType":"Other","description":"arXiv preprint (submitted 25 Feb 2026). Local multi-model pipeline for mammography report generation + classification using prompting, multimodal RAG (ChromaDB), and QLoRA fine-tuning; evaluates MedGemma, LLaVA-Med, Qwen2.5-VL on VinDr-Mammo and DMID; reports BERTScore/ROUGE-L and classification metrics"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.22462","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T02:46:55Z","registered":"2026-02-27T02:46:56Z","published":null,"updated":"2026-02-27T02:46:56Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.22452","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.22452","identifiers":[{"identifier":"2602.22452","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Chayan","familyName":"Banerjee","name":"Banerjee, Chayan","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"CWM: Contrastive World Models for Action Feasibility Learning in Embodied Agent Pipelines"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"Robotics (cs.RO)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"I.2.7; I.2.9","lang":"en","subjectScheme":"ACM"}],"contributors":[],"dates":[{"date":"2026-02-25T22:27:30Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:10:19Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"A reliable action feasibility scorer is a critical bottleneck in embodied agent pipelines: before any planning or reasoning occurs, the agent must identify which candidate actions are physically executable in the current state. Existing approaches use supervised fine-tuning (SFT) to train action scorers, but SFT treats each candidate independently and does not explicitly teach the model to discriminate between actions that are physically correct and those that are subtly wrong. We propose the Contrastive World Model (CWM), which fine-tunes a large language model (LLM) as an action scorer using an InfoNCE contrastive objective with hard-mined negative examples. The key idea is to push valid actions away from invalid ones in scoring space, with special emphasis on hard negatives: semantically similar but physically incompatible candidates. We evaluate CWM on the ScienceWorld benchmark through two studies. First, an intrinsic affordance evaluation on 605 hard-negative test pairs shows that CWM outperforms SFT by +6.76 percentage points on Precision@1 for minimal-edit negatives -- cases where a single word changes the physical outcome -- and achieves a higher AUC-ROC (0.929 vs. 0.906). Second, a live filter characterisation study measures how well CWM ranks gold-path actions against all valid environment actions during task execution. Under out-of-distribution stress conditions, CWM maintains a significantly better safety margin (-2.39) than SFT (-3.96), indicating that the gold action is ranked closer to the top. These results support the hypothesis that contrastive training induces representations that capture physical feasibility more faithfully than SFT alone."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.22452","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T02:46:42Z","registered":"2026-02-27T02:46:42Z","published":null,"updated":"2026-02-27T02:46:42Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.22450","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.22450","identifiers":[{"identifier":"2602.22450","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Qianlong","familyName":"Lan","name":"Lan, Qianlong","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Anuj","familyName":"Kaul","name":"Kaul, Anuj","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Shaun","familyName":"Jones","name":"Jones, Shaun","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Stephanie","familyName":"Westrum","name":"Westrum, Stephanie","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Silent Egress: When Implicit Prompt Injection Makes LLM Agents Leak Without a Trace"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Cryptography and Security (cs.CR)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-25T22:26:23Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:10:17Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Agentic large language model systems increasingly automate tasks by retrieving URLs and calling external tools. We show that this workflow gives rise to implicit prompt injection: adversarial instructions embedded in automatically generated URL previews, including titles, metadata, and snippets, can introduce a system-level risk that we refer to as silent egress. Using a fully local and reproducible testbed, we demonstrate that a malicious web page can induce an agent to issue outbound requests that exfiltrate sensitive runtime context, even when the final response shown to the user appears harmless. In 480 experimental runs with a qwen2.5:7b-based agent, the attack succeeds with high probability (P (egress) =0.89), and 95% of successful attacks are not detected by output-based safety checks. We also introduce sharded exfiltration, where sensitive information is split across multiple requests to avoid detection. This strategy reduces single-request leakage metrics by 73% (Leak@1) and bypasses simple data loss prevention mechanisms. Our ablation results indicate that defenses applied at the prompt layer offer limited protection, while controls at the system and network layers, such as domain allowlisting and redirect-chain analysis, are considerably more effective. These findings suggest that network egress should be treated as a first-class security outcome in agentic LLM systems. We outline architectural directions, including provenance tracking and capability isolation, that go beyond prompt-level hardening."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.22450","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T02:46:39Z","registered":"2026-02-27T02:46:40Z","published":null,"updated":"2026-02-27T02:46:40Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.22449","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.22449","identifiers":[{"identifier":"2602.22449","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Mirza","familyName":"Raquib","name":"Raquib, Mirza","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Asif Pervez","familyName":"Polok","name":"Polok, Asif Pervez","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Kedar Nath","familyName":"Biswas","name":"Biswas, Kedar Nath","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Rahat Uddin","familyName":"Azad","name":"Azad, Rahat Uddin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Saydul Akbar","familyName":"Murad","name":"Murad, Saydul Akbar","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Nick","familyName":"Rahimi","name":"Rahimi, Nick","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"A Fusion of context-aware based BanglaBERT and Two-Layer Stacked LSTM Framework for Multi-Label Cyberbullying Detection"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-25T22:24:05Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:10:16Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Cyberbullying has become a serious and growing concern in todays virtual world. When left unnoticed, it can have adverse consequences for social and mental health. Researchers have explored various types of cyberbullying, but most approaches use single-label classification, assuming that each comment contains only one type of abuse. In reality, a single comment may include overlapping forms such as threats, hate speech, and harassment. Therefore, multilabel detection is both realistic and essential. However, multilabel cyberbullying detection has received limited attention, especially in low-resource languages like Bangla, where robust pre-trained models are scarce. Developing a generalized model with moderate accuracy remains challenging. Transformers offer strong contextual understanding but may miss sequential dependencies, while LSTM models capture temporal flow but lack semantic depth. To address these limitations, we propose a fusion architecture that combines BanglaBERT-Large with a two-layer stacked LSTM. We analyze their behavior to jointly model context and sequence. The model is fine-tuned and evaluated on a publicly available multilabel Bangla cyberbullying dataset covering cyberbully, sexual harassment, threat, and spam. We apply different sampling strategies to address class imbalance. Evaluation uses multiple metrics, including accuracy, precision, recall, F1-score, Hamming loss, Cohens kappa, and AUC-ROC. We employ 5-fold cross-validation to assess the generalization of the architecture."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.22449","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T02:46:38Z","registered":"2026-02-27T02:46:38Z","published":null,"updated":"2026-02-27T02:46:38Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.22441","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.22441","identifiers":[{"identifier":"2602.22441","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Yingqian","familyName":"Cui","name":"Cui, Yingqian","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zhenwei","familyName":"Dai","name":"Dai, Zhenwei","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Bing","familyName":"He","name":"He, Bing","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zhan","familyName":"Shi","name":"Shi, Zhan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Hui","familyName":"Liu","name":"Liu, Hui","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Rui","familyName":"Sun","name":"Sun, Rui","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zhiji","familyName":"Liu","name":"Liu, Zhiji","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yue","familyName":"Xing","name":"Xing, Yue","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jiliang","familyName":"Tang","name":"Tang, Jiliang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Benoit","familyName":"Dumoulin","name":"Dumoulin, Benoit","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"How Do Latent Reasoning Methods Perform Under Weak and Strong Supervision?"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-25T22:00:59Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:09:59Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Latent reasoning has been recently proposed as a reasoning paradigm and performs multi-step reasoning through generating steps in the latent space instead of the textual space. This paradigm enables reasoning beyond discrete language tokens by performing multi-step computation in continuous latent spaces. Although there have been numerous studies focusing on improving the performance of latent reasoning, its internal mechanisms remain not fully investigated. In this work, we conduct a comprehensive analysis of latent reasoning methods to better understand the role and behavior of latent representation in the process. We identify two key issues across latent reasoning methods with different levels of supervision. First, we observe pervasive shortcut behavior, where they achieve high accuracy without relying on latent reasoning. Second, we examine the hypothesis that latent reasoning supports BFS-like exploration in latent space, and find that while latent representations can encode multiple possibilities, the reasoning process does not faithfully implement structured search, but instead exhibits implicit pruning and compression. Finally, our findings reveal a trade-off associated with supervision strength: stronger supervision mitigates shortcut behavior but restricts the ability of latent representations to maintain diverse hypotheses, whereas weaker supervision allows richer latent representations at the cost of increased shortcut behavior."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.22441","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T02:46:27Z","registered":"2026-02-27T02:46:28Z","published":null,"updated":"2026-02-27T02:46:28Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.22436","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.22436","identifiers":[{"identifier":"2602.22436","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Priyan","familyName":"Vaithilingam","name":"Vaithilingam, Priyan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Alan","familyName":"Leung","name":"Leung, Alan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jeffrey","familyName":"Nichols","name":"Nichols, Jeffrey","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Titus","familyName":"Barik","name":"Barik, Titus","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"The Way We Notice, That's What Really Matters: Instantiating UI Components with Distinguishing Variations"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Human-Computer Interaction (cs.HC)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-25T21:48:47Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:09:32Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Front-end developers author UI components to be broadly reusable by parameterizing visual and behavioral properties. While flexible, this makes instantiation harder, as developers must reason about numerous property values and interactions. In practice, they must explore the component's large design space and provide realistic and natural values to properties. To address this, we introduce distinguishing variations: variations that are both mimetic and distinct. We frame distinguishing variation generation as design-space sampling, combining symbolic inference to identify visually important properties with an LLM-driven mimetic sampler to produce realistic instantiations from its world knowledge. We instantiate distinguishing variations in Celestial, a tool that helps developers explore and visualize distinguishing variations. In a study with front-end developers (n=12), participants found these variations useful for comparing and mapping component design spaces, reported that mimetic instantiations were domain-relevant, and validated that Celestial transformed component instantiation from a manual process into a structured, exploratory activity."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.22436","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T02:46:21Z","registered":"2026-02-27T02:46:21Z","published":null,"updated":"2026-02-27T02:46:21Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.22434","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.22434","identifiers":[{"identifier":"2602.22434","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Alex","familyName":"Aizman","name":"Aizman, Alex","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Abhishek","familyName":"Gaikwad","name":"Gaikwad, Abhishek","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Piotr","familyName":"Żelasko","name":"Żelasko, Piotr","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"GetBatch: Distributed Multi-Object Retrieval for ML Data Loading"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Distributed, Parallel, and Cluster Computing (cs.DC)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"Databases (cs.DB)","lang":"en","subjectScheme":"arXiv"},{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-25T21:45:18Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:09:30Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Machine learning training pipelines consume data in batches. A single training step may require thousands of samples drawn from shards distributed across a storage cluster. Issuing thousands of individual GET requests incurs per-request overhead that often dominates data transfer time. To solve this problem, we introduce GetBatch - a new object store API that elevates batch retrieval to a first-class storage operation, replacing independent GET operations with a single deterministic, fault-tolerant streaming execution. GetBatch achieves up to 15x throughput improvement for small objects and, in a production training workload, reduces P95 batch retrieval latency by 2x and P99 per-object tail latency by 3.7x compared to individual GET requests."},{"descriptionType":"Other","description":"11 pages, 3 figures, 2 tables. Preprint"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.22434","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T02:46:18Z","registered":"2026-02-27T02:46:19Z","published":null,"updated":"2026-02-27T02:46:19Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.22433","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.22433","identifiers":[{"identifier":"2602.22433","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Refat","familyName":"Othman","name":"Othman, Refat","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Predicting Known Vulnerabilities from Attack Descriptions Using Sentence Transformers"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Cryptography and Security (cs.CR)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"D.4.6; I.2.7; K.6.5","lang":"en","subjectScheme":"ACM"},{"subject":"D.4.6, I.2.7","lang":"en","subjectScheme":"MSC"}],"contributors":[],"dates":[{"date":"2026-02-25T21:44:57Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:09:29Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Modern infrastructures rely on software systems that remain vulnerable to cyberattacks. These attacks frequently exploit vulnerabilities documented in repositories such as MITRE's Common Vulnerabilities and Exposures (CVE). However, Cyber Threat Intelligence resources, including MITRE ATT\u0026amp;CK and CVE, provide only partial coverage of attack-vulnerability relationships. Attack information often appears before vulnerabilities are formally linked, creating the need for automated methods that infer likely vulnerabilities directly from attack descriptions.\n This thesis addresses the problem of predicting known vulnerabilities from natural-language descriptions of cyberattacks. We develop transformer-based sentence embedding methods that encode attack and vulnerability descriptions into semantic vector representations, enabling similarity-based ranking and recommendation.\n Fourteen state-of-the-art transformer models were evaluated across four attack description types (Tactic, Technique, Procedure, and Attack Pattern). Results show that Technique descriptions in MITRE ATT\u0026amp;CK provide the strongest predictive signal. The multi-qa-mpnet-base-dot-v1 (MMPNet) model achieved the best performance due to its hybrid pre-training and optimization for semantic similarity.\n The approach was implemented in the VULDAT tool, which automatically links attacks to vulnerabilities. Manual validation revealed previously undocumented relationships in MITRE repositories. Evaluation on unseen cyberattack reports demonstrates that the models generalize beyond curated datasets and support proactive vulnerability awareness."},{"descriptionType":"Other","description":"PhD thesis, Free University of Bozen-Bolzano, 2026"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.22433","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T02:46:16Z","registered":"2026-02-27T02:46:17Z","published":null,"updated":"2026-02-27T02:46:17Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.22426","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.22426","identifiers":[{"identifier":"2602.22426","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Yibo","familyName":"Peng","name":"Peng, Yibo","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Peng","familyName":"Xia","name":"Xia, Peng","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ding","familyName":"Zhong","name":"Zhong, Ding","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Kaide","familyName":"Zeng","name":"Zeng, Kaide","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Siwei","familyName":"Han","name":"Han, Siwei","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yiyang","familyName":"Zhou","name":"Zhou, Yiyang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jiaqi","familyName":"Liu","name":"Liu, Jiaqi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ruiyi","familyName":"Zhang","name":"Zhang, Ruiyi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Huaxiu","familyName":"Yao","name":"Yao, Huaxiu","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"SimpleOCR: Rendering Visualized Questions to Teach MLLMs to Read"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-25T21:36:30Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:09:06Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Despite the rapid advancements in Multimodal Large Language Models (MLLMs), a critical question regarding their visual grounding mechanism remains unanswered: do these models genuinely ``read'' text embedded in images, or do they merely rely on parametric shortcuts in the text prompt? In this work, we diagnose this issue by introducing the Visualized-Question (VQ) setting, where text queries are rendered directly onto images to structurally mandate visual engagement. Our diagnostic experiments on Qwen2.5-VL reveal a startling capability-utilization gap: despite possessing strong OCR capabilities, models suffer a performance degradation of up to 12.7% in the VQ setting, exposing a deep-seated ``modality laziness.'' To bridge this gap, we propose SimpleOCR, a plug-and-play training strategy that imposes a structural constraint on the learning process. By transforming training samples into the VQ format with randomized styles, SimpleOCR effectively invalidates text-based shortcuts, compelling the model to activate and optimize its visual text extraction pathways. Empirically, SimpleOCR yields robust gains without architectural modifications. On four representative OOD benchmarks, it surpasses the base model by 5.4% and GRPO based on original images by 2.7%, while exhibiting extreme data efficiency, achieving superior performance with 30x fewer samples (8.5K) than recent RL-based methods. Furthermore, its plug-and-play nature allows seamless integration with advanced RL strategies like NoisyRollout to yield complementary improvements. Code is available at https://github.com/aiming-lab/SimpleOCR."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.22426","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T02:46:07Z","registered":"2026-02-27T02:46:07Z","published":null,"updated":"2026-02-27T02:46:08Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.22424","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.22424","identifiers":[{"identifier":"2602.22424","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Gustaw","familyName":"Opiełka","name":"Opiełka, Gustaw","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Hannes","familyName":"Rosenbusch","name":"Rosenbusch, Hannes","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Claire E.","familyName":"Stevenson","name":"Stevenson, Claire E.","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Causality $\\neq$ Invariance: Function and Concept Vectors in LLMs"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-25T21:35:30Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:08:59Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Do large language models (LLMs) represent concepts abstractly, i.e., independent of input format? We revisit Function Vectors (FVs), compact representations of in-context learning (ICL) tasks that causally drive task performance. Across multiple LLMs, we show that FVs are not fully invariant: FVs are nearly orthogonal when extracted from different input formats (e.g., open-ended vs. multiple-choice), even if both target the same concept. We identify Concept Vectors (CVs), which carry more stable concept representations. Like FVs, CVs are composed of attention head outputs; however, unlike FVs, the constituent heads are selected using Representational Similarity Analysis (RSA) based on whether they encode concepts consistently across input formats. While these heads emerge in similar layers to FV-related heads, the two sets are largely distinct, suggesting different underlying mechanisms. Steering experiments reveal that FVs excel in-distribution, when extraction and application formats match (e.g., both open-ended in English), while CVs generalize better out-of-distribution across both question types (open-ended vs. multiple-choice) and languages. Our results show that LLMs do contain abstract concept representations, but these differ from those that drive ICL performance."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.22424","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T02:46:04Z","registered":"2026-02-27T02:46:05Z","published":null,"updated":"2026-02-27T02:46:05Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.22416","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.22416","identifiers":[{"identifier":"2602.22416","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Seokweon","familyName":"Jung","name":"Jung, Seokweon","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jeongmin","familyName":"Rhee","name":"Rhee, Jeongmin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Seoyoung","familyName":"Doh","name":"Doh, Seoyoung","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Hyeon","familyName":"Jeon","name":"Jeon, Hyeon","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ghulam Jilani","familyName":"Quadri","name":"Quadri, Ghulam Jilani","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jinwook","familyName":"Seo","name":"Seo, Jinwook","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Seeing Graphs Like Humans: Benchmarking Computational Measures and MLLMs for Similarity Assessment"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Human-Computer Interaction (cs.HC)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-25T21:20:27Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:08:37Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by-nc-nd/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution Non Commercial No Derivatives 4.0 International","rightsIdentifier":"cc-by-nc-nd-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Comparing graphs to identify similarities is a fundamental task in visual analytics of graph data. To support this, visual analytics systems frequently employ quantitative computational measures to provide automated guidance. However, it remains unclear how well these measures align with subjective human visual perception, thereby offering recommendations that conflict with analysts' intuitive judgments, potentially leading to confusion rather than reducing cognitive load. Multimodal Large Language Models (MLLMs), capable of visually interpreting graphs and explaining their reasoning in natural language, have emerged as a potential alternative to address this challenge. This paper bridges the gap between human and machine assessment of graph similarity through three interconnected experiments using a dataset of 1,881 node-link diagrams. Experiment 1 collects relative similarity judgments and rationales from 32 human participants, revealing consensus on graph similarity while prioritizing global shapes and edge densities over exact topological details. Experiment 2 benchmarks 16 computational measures against these human judgments, identifying Portrait divergence as the best-performing metric, though with only moderate alignment. Experiment 3 evaluates the potential of three state-of-the-art MLLMs (GPT-5, Gemini 2.5 Pro, Claude Sonnet 4.5) as perceptual proxies. The results demonstrate that MLLMs, particularly GPT-5, significantly outperform traditional measures in aligning with human graph similarity perception and provide interpretable rationales for their decisions, whereas Claude Sonnet 4.5 shows the best computational efficiency. Our findings suggest that MLLMs hold significant promise not only as effective, explainable proxies for human perception but also as intelligent guides that can uncover subtle nuances that might be overlooked by human analysts in visual analytics systems."},{"descriptionType":"Other","description":"21 pages including 1 page of appendix, 9 figures, 4 tables"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.22416","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T02:45:53Z","registered":"2026-02-27T02:45:53Z","published":null,"updated":"2026-02-27T02:45:53Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.22408","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.22408","identifiers":[{"identifier":"2602.22408","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Caroline","familyName":"Ahn","name":"Ahn, Caroline","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Quan","familyName":"Do","name":"Do, Quan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Leah","familyName":"Bakst","name":"Bakst, Leah","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Michael P.","familyName":"Pascale","name":"Pascale, Michael P.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Joseph T.","familyName":"McGuire","name":"McGuire, Joseph T.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Michael E.","familyName":"Hasselmo","name":"Hasselmo, Michael E.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Chantal E.","familyName":"Stern","name":"Stern, Chantal E.","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Exploring Human Behavior During Abstract Rule Inference and Problem Solving with the Cognitive Abstraction and Reasoning Corpus"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"Neurons and Cognition (q-bio.NC)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"FOS: Biological sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Biological sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-25T21:01:47Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:07:59Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Humans exhibit remarkable flexibility in abstract reasoning, and can rapidly learn and apply rules from sparse examples. To investigate the cognitive strategies underlying this ability, we introduce the Cognitive Abstraction and Reasoning Corpus (CogARC), a diverse human-adapted subset of the Abstraction and Reasoning Corpus (ARC) which was originally developed to benchmark abstract reasoning in artificial intelligence. Across two experiments, CogARC was administered to a total of 260 human participants who freely generated solutions to 75 abstract visual reasoning problems. Success required inferring input-output rules from a small number of examples to transform the test input into one correct test output. Participants' behavior was recorded at high temporal resolution, including example viewing, edit sequences, and multi-attempt submissions. Participants were generally successful (mean accuracy ~90% for experiment 1 (n=40), ~80% for experiment 2 (n=220) across problems), but performance varied widely across problems and participants. Harder problems elicited longer deliberation times and greater divergence in solution strategies. Over the course of the task, participants initiated responses more quickly but showed a slight decline in accuracy, suggesting increased familiarity with the task structure rather than improved rule-learning ability. Importantly, even incorrect solutions were often highly convergent, even when the problem-solving trajectories differed in length and smoothness. Some trajectories progressed directly and efficiently toward a stable outcome, whereas others involved extended exploration or partial restarts before converging. Together, these findings highlight CogARC as a rich behavioral environment for studying human abstract reasoning, providing insight into how people generalize, misgeneralize, and adapt their strategies under uncertainty."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.22408","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T02:45:42Z","registered":"2026-02-27T02:45:43Z","published":null,"updated":"2026-02-27T02:45:43Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.22406","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.22406","identifiers":[{"identifier":"2602.22406","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Xinle","familyName":"Wu","name":"Wu, Xinle","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Rui","familyName":"Zhang","name":"Zhang, Rui","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Mustafa Anis","familyName":"Hussain","name":"Hussain, Mustafa Anis","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yao","familyName":"Lu","name":"Lu, Yao","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Towards Autonomous Memory Agents"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-25T20:59:44Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:07:53Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Recent memory agents improve LLMs by extracting experiences and conversation history into an external storage. This enables low-overhead context assembly and online memory update without expensive LLM training. However, existing solutions remain passive and reactive; memory growth is bounded by information that happens to be available, while memory agents seldom seek external inputs in uncertainties. We propose autonomous memory agents that actively acquire, validate, and curate knowledge at a minimum cost. U-Mem materializes this idea via (i) a cost-aware knowledge-extraction cascade that escalates from cheap self/teacher signals to tool-verified research and, only when needed, expert feedback, and (ii) semantic-aware Thompson sampling to balance exploration and exploitation over memories and mitigate cold-start bias. On both verifiable and non-verifiable benchmarks, U-Mem consistently beats prior memory baselines and can surpass RL-based optimization, improving HotpotQA (Qwen2.5-7B) by 14.6 points and AIME25 (Gemini-2.5-flash) by 7.33 points."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.22406","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T02:45:39Z","registered":"2026-02-27T02:45:40Z","published":null,"updated":"2026-02-27T02:45:40Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.22405","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.22405","identifiers":[{"identifier":"2602.22405","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Syed Omer","familyName":"Shah","name":"Shah, Syed Omer","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Mohammed Maqsood","familyName":"Ahmed","name":"Ahmed, Mohammed Maqsood","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Danish Mohiuddin","familyName":"Mohammed","name":"Mohammed, Danish Mohiuddin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Shahnawaz","familyName":"Alam","name":"Alam, Shahnawaz","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Mohd Vahaj ur","familyName":"Rahman","name":"Rahman, Mohd Vahaj ur","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"MolFM-Lite: Multi-Modal Molecular Property Prediction with Conformer Ensemble Attention and Cross-Modal Fusion"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-25T20:59:14Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:07:53Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Most machine learning models for molecular property prediction rely on a single molecular representation (either a sequence, a graph, or a 3D structure) and treat molecular geometry as static. We present MolFM-Lite, a multi-modal model that jointly encodes SELFIES sequences (1D), molecular graphs (2D), and conformer ensembles (3D) through cross-attention fusion, while conditioning predictions on experimental context via Feature-wise Linear Modulation (FiLM). Our main methodological contributions are: (1) a conformer ensemble attention mechanism that combines learnable attention with Boltzmann-weighted priors over multiple RDKit-generated conformers, capturing the thermodynamic distribution of molecular shapes; and (2) a cross-modal fusion layer where each modality can attend to others, enabling complementary information sharing. We evaluate on four MoleculeNet scaffold-split benchmarks using our model's own splits, and report all baselines re-evaluated under the same protocol. Comprehensive ablation studies across all four datasets confirm that each architectural component contributes independently, with tri-modal fusion providing 7-11% AUC improvement over single-modality baselines and conformer ensembles adding approximately 2% over single-conformer variants. Pre-training on ZINC250K (~250K molecules) using cross-modal contrastive and masked-atom objectives enables effective weight initialization at modest compute cost. We release all code, trained models, and data splits to support reproducibility."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.22405","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T02:45:38Z","registered":"2026-02-27T02:45:39Z","published":null,"updated":"2026-02-27T02:45:39Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.22404","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.22404","identifiers":[{"identifier":"2602.22404","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Aishwarya","familyName":"Verma","name":"Verma, Aishwarya","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Laud","familyName":"Ammah","name":"Ammah, Laud","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Olivia Nercy Ndlovu","familyName":"Lucas","name":"Lucas, Olivia Nercy Ndlovu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Andrew","familyName":"Zaldivar","name":"Zaldivar, Andrew","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Vinodkumar","familyName":"Prabhakaran","name":"Prabhakaran, Vinodkumar","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Sunipa","familyName":"Dev","name":"Dev, Sunipa","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"SAFARI: A Community-Engaged Approach and Dataset of Stereotype Resources in the Sub-Saharan African Context"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-25T20:56:27Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:07:44Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Stereotype repositories are critical to assess generative AI model safety, but currently lack adequate global coverage. It is imperative to prioritize targeted expansion, strategically addressing existing deficits, over merely increasing data volume. This work introduces a multilingual stereotype resource covering four sub-Saharan African countries that are severely underrepresented in NLP resources: Ghana, Kenya, Nigeria, and South Africa. By utilizing socioculturally-situated, community-engaged methods, including telephonic surveys moderated in native languages, we establish a reproducible methodology that is sensitive to the region's complex linguistic diversity and traditional orality. By deliberately balancing the sample across diverse ethnic and demographic backgrounds, we ensure broad coverage, resulting in a dataset of 3,534 stereotypes in English and 3,206 stereotypes across 15 native languages."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.22404","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T02:45:36Z","registered":"2026-02-27T02:45:37Z","published":null,"updated":"2026-02-27T02:45:37Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.22402","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.22402","identifiers":[{"identifier":"2602.22402","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Cosmo","familyName":"Santoni","name":"Santoni, Cosmo","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Contextual Memory Virtualisation: DAG-Based State Management and Structurally Lossless Trimming for LLM Agents"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Software Engineering (cs.SE)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"Human-Computer Interaction (cs.HC)","lang":"en","subjectScheme":"arXiv"},{"subject":"Operating Systems (cs.OS)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-25T20:52:52Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:07:42Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"As large language models engage in extended reasoning tasks, they accumulate significant state -- architectural mappings, trade-off decisions, codebase conventions -- within the context window. This understanding is lost when sessions reach context limits and undergo lossy compaction. We propose Contextual Memory Virtualisation (CMV), a system that treats accumulated LLM understanding as version-controlled state. Borrowing from operating system virtual memory, CMV models session history as a Directed Acyclic Graph (DAG) with formally defined snapshot, branch, and trim primitives that enable context reuse across independent parallel sessions. We introduce a three-pass structurally lossless trimming algorithm that preserves every user message and assistant response verbatim while reducing token counts by a mean of 20% and up to 86% for sessions with significant overhead by stripping mechanical bloat such as raw tool outputs, base64 images, and metadata. A single-user case-study evaluation across 76 real-world coding sessions demonstrates that trimming remains economically viable under prompt caching, with the strongest gains in mixed tool-use sessions, which average 39% reduction and reach break-even within 10 turns. A reference implementation is available at https://github.com/CosmoNaught/claude-code-cmv."},{"descriptionType":"Other","description":"11 pages. 6 figures. Introduces a DAG-based state management system for LLM agents. Evaluation on 76 coding sessions shows up to 86% token reduction (mean 20%) while remaining economically viable under prompt caching. Includes reference implementation for Claude Code"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.22402","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T02:45:34Z","registered":"2026-02-27T02:45:35Z","published":null,"updated":"2026-02-27T02:45:35Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.22387","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.22387","identifiers":[{"identifier":"2602.22387","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Yixuan","familyName":"Li","name":"Li, Yixuan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Archer Y.","familyName":"Yang","name":"Yang, Archer Y.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yue","familyName":"Li","name":"Li, Yue","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Disentangling Shared and Target-Enriched Topics via Background-Contrastive Non-negative Matrix Factorization"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-25T20:34:07Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:07:00Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Biological signals of interest in high-dimensional data are often masked by dominant variation shared across conditions. This variation, arising from baseline biological structure or technical effects, can prevent standard dimensionality reduction methods from resolving condition-specific structure. The challenge is that these confounding topics are often unknown and mixed with biological signals. Existing background correction methods are either unscalable to high dimensions or not interpretable. We introduce background contrastive Non-negative Matrix Factorization (\\model), which extracts target-enriched latent topics by jointly factorizing a target dataset and a matched background using shared non-negative bases under a contrastive objective that suppresses background-expressed structure. This approach yields non-negative components that are directly interpretable at the feature level, and explicitly isolates target-specific variation. \\model is learned by an efficient multiplicative update algorithm via matrix multiplication such that it is highly efficient on GPU hardware and scalable to big data via minibatch training akin to deep learning approach. Across simulations and diverse biological datasets, \\model reveals signals obscured by conventional methods, including disease-associated programs in postmortem depressive brain single-cell RNA-seq, genotype-linked protein expression patterns in mice, treatment-specific transcriptional changes in leukemia, and TP53-dependent drug responses in cancer cell lines."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.22387","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T02:45:13Z","registered":"2026-02-27T02:45:14Z","published":null,"updated":"2026-02-27T02:45:14Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.22383","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.22383","identifiers":[{"identifier":"2602.22383","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Jian-fei","familyName":"Wang","name":"Wang, Jian-fei","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Hao-jie","familyName":"Xu","name":"Xu, Hao-jie","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Impact of Geometric Inflation on Nucleon Size Sensitivity in Relativistic Heavy-Ion Collisions"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Nuclear Theory (nucl-th)","lang":"en","subjectScheme":"arXiv"},{"subject":"Nuclear Experiment (nucl-ex)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-25T20:29:09Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:06:51Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"The intrinsic transverse size of nucleons, parameterized by a Gaussian width $w$, is a critical yet uncertain input in the initial-state modeling of relativistic heavy-ion collisions. Using a finite $w$ in standard initial geometry models introduces an unintentional ``geometric inflation'' that alters the initial nuclear density profile. In this study, we implement a self-consistent density correction to eliminate this artifact and investigate its impact on final-state observables. Through hybrid (viscous hydrodynamics + hadronic transport) simulations of $^{208}$Pb+$^{208}$Pb collisions at the LHC, we demonstrate that removing geometric inflation significantly modifies the sensitivity of observables to the nucleon width $w$. While elliptic flow and mean transverse momentum ($\\langle [p_{\\rm T}]\\rangle$) become less sensitive to variations in $w$, the Pearson correlation coefficient $ρ(v_{n}^{2}, δp_{\\rm T})$, $[p_{\\rm T}]$ fluctuations, and triangular flow exhibit enhanced sensitivity to fluctuations in nucleon positions. Our results indicate that uncorrected geometric inflation can bias the extraction of nucleon structure and quark-gluon plasma properties. This underscores the necessity of a self-consistent initial-state geometry for reliable Bayesian inference in heavy-ion collisions."},{"descriptionType":"Other","description":"9 pages, 5 figures"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.22383","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T02:45:07Z","registered":"2026-02-27T02:45:08Z","published":null,"updated":"2026-02-27T02:45:08Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.22374","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.22374","identifiers":[{"identifier":"2602.22374","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Md","familyName":"Ehtesham-Ul-Haque","name":"Ehtesham-Ul-Haque, Md","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Syed Masum","familyName":"Billah","name":"Billah, Syed Masum","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"VoiceAlign: A Shimming Layer for Enhancing the Usability of Legacy Voice User Interface Systems"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Human-Computer Interaction (cs.HC)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-25T20:14:58Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:06:15Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Voice user interfaces (VUIs) are rapidly transitioning from accessibility features to mainstream interaction modalities. Yet most operating systems' built-in voice commands remain underutilized despite possessing robust technical capabilities. Through our analysis of four commercial VUI systems and a formative study with 16 participants, we found that fixed command formats require exact phrasing, restrictive timeout mechanisms discard input during planning pauses, and insufficient feedback hampers multi-step interactions. To address these challenges, we developed VoiceAlign, an adaptive shimming layer that mediates between users and legacy VUI systems. VoiceAlign intercepts natural voice commands, transforms them to match the required syntax using a large language model, and transmits these adapted commands through a virtual audio channel that remains transparent to the underlying system. In our evaluation with 12 participants, VoiceAlign reduced command failures by half, required 25% fewer commands per task, and significantly lowered cognitive and temporal demands when paired with an existing legacy VUI system. Furthermore, we created a synthetic dataset informed by our studies and fine-tuned a small language model that achieves over 90% accuracy with 200 ms response time when served locally, eliminating dependence on third-party APIs while enabling real-time interaction on edge devices. This work demonstrates how modern AI techniques can unlock the underutilized potential of legacy VUI systems without requiring system modifications, offering a practical solution without replacing existing infrastructure."},{"descriptionType":"Other","description":"Accepted at IUI'26"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.22374","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T02:44:55Z","registered":"2026-02-27T02:44:56Z","published":null,"updated":"2026-02-27T02:44:56Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.22369","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.22369","identifiers":[{"identifier":"2602.22369","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Ruixiao","familyName":"Wang","name":"Wang, Ruixiao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xiaohong","familyName":"Chen","name":"Chen, Xiaohong","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Sinho","familyName":"Chewi","name":"Chewi, Sinho","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Sampling from Constrained Gibbs Measures: with Applications to High-Dimensional Bayesian Inference"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Statistics Theory (math.ST)","lang":"en","subjectScheme":"arXiv"},{"subject":"Probability (math.PR)","lang":"en","subjectScheme":"arXiv"},{"subject":"Machine Learning (stat.ML)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-25T20:06:07Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:05:50Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"This paper considers a non-standard problem of generating samples from a low-temperature Gibbs distribution with \\emph{constrained} support, when some of the coordinates of the mode lie on the boundary. These coordinates are referred to as the non-regular part of the model. We show that in a ``pre-asymptotic'' regime in which the limiting Laplace approximation is not yet valid, the low-temperature Gibbs distribution concentrates on a neighborhood of its mode. Within this region, the distribution is a bounded perturbation of a product measure: a strongly log-concave distribution in the regular part and a one-dimensional exponential-type distribution in each coordinate of the non-regular part. Leveraging this structure, we provide a non-asymptotic sampling guarantee by analyzing the spectral gap of Langevin dynamics. Key examples of low-temperature Gibbs distributions include Bayesian posteriors, and we demonstrate our results on three canonical examples: a high-dimensional logistic regression model, a Poisson linear model, and a Gaussian mixture model."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.22369","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T02:44:48Z","registered":"2026-02-27T02:44:49Z","published":null,"updated":"2026-02-27T02:44:49Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.22368","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.22368","identifiers":[{"identifier":"2602.22368","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Jiahao","familyName":"Zhang","name":"Zhang, Jiahao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yifan","familyName":"Zhang","name":"Zhang, Yifan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Kevin","familyName":"Leach","name":"Leach, Kevin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yu","familyName":"Huang","name":"Huang, Yu","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"EyeLayer: Integrating Human Attention Patterns into LLM-Based Code Summarization"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Software Engineering (cs.SE)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"D.2.0; I.2.7; I.2.6; H.1.2","lang":"en","subjectScheme":"ACM"}],"contributors":[],"dates":[{"date":"2026-02-25T20:04:39Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:05:44Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[{"relationType":"IsVersionOf","relatedIdentifier":"10.1145/3794763.3794799","relatedIdentifierType":"DOI"}],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Code summarization is the task of generating natural language descriptions of source code, which is critical for software comprehension and maintenance. While large language models (LLMs) have achieved remarkable progress on this task, an open question remains: can human expertise in code understanding further guide and enhance these models? We propose EyeLayer, a lightweight attention-augmentation module that incorporates human eye-gaze patterns, as a proxy of human expertise, into LLM-based code summarization. EyeLayer models human attention during code reading via a Multimodal Gaussian Mixture, redistributing token embeddings based on learned parameters (μ_i, σ_i^2) that capture where and how intensively developers focus. This design enables learning generalizable attention priors from eye-tracking data and incorporating them into LLMs seamlessly, without disturbing existing representations. We evaluate EyeLayer across diverse model families (i.e., LLaMA-3.2, Qwen3, and CodeBERT) covering different scales and architectures. EyeLayer consistently outperforms strong fine-tuning baselines across standard metrics, achieving gains of up to 13.17% on BLEU-4. These results demonstrate that human gaze patterns encode complementary attention signals that enhance the semantic focus of LLMs and transfer effectively across diverse models for code summarization."},{"descriptionType":"Other","description":"Accepted at the 34th IEEE/ACM International Conference on Program Comprehension (ICPC 2026), April 12-13, 2026, Rio de Janeiro, Brazil"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.22368","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":1,"created":"2026-02-27T02:44:46Z","registered":"2026-02-27T02:44:47Z","published":null,"updated":"2026-02-27T02:44:47Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.22367","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.22367","identifiers":[{"identifier":"2602.22367","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Arsenii","familyName":"Dokuchaev","name":"Dokuchaev, Arsenii","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Francesca","familyName":"Bonizzoni","name":"Bonizzoni, Francesca","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Stefano","familyName":"Pagani","name":"Pagani, Stefano","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Francesco","familyName":"Regazzoni","name":"Regazzoni, Francesco","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Simone","familyName":"Pezzuto","name":"Pezzuto, Simone","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Learning geometry-dependent lead-field operators for forward ECG modeling"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"Numerical Analysis (math.NA)","lang":"en","subjectScheme":"arXiv"},{"subject":"Tissues and Organs (q-bio.TO)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"FOS: Biological sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Biological sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-25T20:01:08Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:05:36Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Modern forward electrocardiogram (ECG) computational models rely on an accurate representation of the torso domain. The lead-field method enables fast ECG simulations while preserving full geometric fidelity. Achieving high anatomical accuracy in torso representation is, however, challenging in clinical practice, as imaging protocols are typically focused on the heart and often do not include the entire torso. In addition, the computational cost of the lead-field method scales linearly with the number of electrodes, limiting its applicability in high-density recording settings. To date, no existing approach simultaneously achieves high anatomical fidelity, low data requirements and computational efficiency. In this work, we propose a shape-informed surrogate model of the lead-field operator that serves as a drop-in replacement for the full-order model in forward ECG simulations. The proposed framework consists of two components: a geometry-encoding module that maps anatomical shapes into a low-dimensional latent space, and a geometry-conditioned neural surrogate that predicts lead-field gradients from spatial coordinates, electrode positions and latent codes. The proposed method achieves high accuracy in approximating lead fields both within the torso (mean angular error 5°) and inside the heart, resulting in highly accurate ECG simulations (relative mean squared error \u0026lt;2.5%. The surrogate consistently outperforms the widely used pseudo lead-field approximation while preserving negligible inference cost. Owing to its compact latent representation, the method does not require a fully detailed torso segmentation and can therefore be deployed in data-limited settings while preserving high-fidelity ECG simulations."},{"descriptionType":"Other","description":"20 pages, 9 figures"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.22367","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T02:44:45Z","registered":"2026-02-27T02:44:46Z","published":null,"updated":"2026-02-27T02:44:46Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.22362","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.22362","identifiers":[{"identifier":"2602.22362","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Abhishek","familyName":"Kulkarni","name":"Kulkarni, Abhishek","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Alexander","familyName":"Barquero","name":"Barquero, Alexander","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Pavitra","familyName":"Lahari","name":"Lahari, Pavitra","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Aryaan","familyName":"Shaikh","name":"Shaikh, Aryaan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Sarah","familyName":"Brown","name":"Brown, Sarah","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"E3VA: Enhancing Emotional Expressiveness in Virtual Conversational Agents"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Human-Computer Interaction (cs.HC)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-25T19:41:27Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:04:46Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by-nc-nd/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution Non Commercial No Derivatives 4.0 International","rightsIdentifier":"cc-by-nc-nd-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"With the advent of generative AI and large language models, embodied conversational agents are becoming synonymous with online interactions. These agents possess vast amounts of knowledge but suffer from exhibiting limited emotional expressiveness. Without adequate expressions, agents might fail to adapt to users' emotions, which may result in a sub-optimal user experience and engagement. Most current systems prioritize content based responses, neglecting the emotional context of conversations. Research in this space is currently limited to specific contexts, like mental health. To bridge this gap, our project proposes the implementation of expressive features in a virtual conversational agent which will utilize sentiment analysis and natural language processing to inform the generation of empathetic, expressive responses. The project delivers a functional conversational agent capable of assessing and responding to user emotions accordingly. We posit this will enhance usability, engagement, and the overall quality of conversations and present results from an exploratory pilot study investigating the same."},{"descriptionType":"Other","description":"5 pages"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.22362","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T02:44:39Z","registered":"2026-02-27T02:44:39Z","published":null,"updated":"2026-02-27T02:44:39Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.22359","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.22359","identifiers":[{"identifier":"2602.22359","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Arno","familyName":"Simons","name":"Simons, Arno","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Scaling In, Not Up? Testing Thick Citation Context Analysis with GPT-5 and Fragile Prompts"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"J.4; I.2.1; I.2.7","lang":"en","subjectScheme":"ACM"}],"contributors":[],"dates":[{"date":"2026-02-25T19:33:00Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:04:25Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"This paper tests whether large language models (LLMs) can support interpretative citation context analysis (CCA) by scaling in thick, text-grounded readings of a single hard case rather than scaling up typological labels. It foregrounds prompt-sensitivity analysis as a methodological issue by varying prompt scaffolding and framing in a balanced 2x3 design. Using footnote 6 in Chubin and Moitra (1975) and Gilbert's (1977) reconstruction as a probe, I implement a two-stage GPT-5 pipeline: a citation-text-only surface classification and expectation pass, followed by cross-document interpretative reconstruction using the citing and cited full texts. Across 90 reconstructions, the model produces 450 distinct hypotheses. Close reading and inductive coding identify 21 recurring interpretative moves, and linear probability models estimate how prompt choices shift their frequencies and lexical repertoire. GPT-5's surface pass is highly stable, consistently classifying the citation as \"supplementary\". In reconstruction, the model generates a structured space of plausible alternatives, but scaffolding and examples redistribute attention and vocabulary, sometimes toward strained readings. Relative to Gilbert, GPT-5 detects the same textual hinges yet more often resolves them as lineage and positioning than as admonishment. The study outlines opportunities and risks of using LLMs as guided co-analysts for inspectable, contestable interpretative CCA, and it shows that prompt scaffolding and framing systematically tilt which plausible readings and vocabularies the model foregrounds."},{"descriptionType":"Other","description":"26 pages, 1 figure, 3 tables (plus 17 pages supplement including 1 figure)"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.22359","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T02:44:34Z","registered":"2026-02-27T02:44:35Z","published":null,"updated":"2026-02-27T02:44:35Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.22358","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.22358","identifiers":[{"identifier":"2602.22358","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Guillermina","familyName":"Senn","name":"Senn, Guillermina","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Nathan","familyName":"Glatt-Holtz","name":"Glatt-Holtz, Nathan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Giulia","familyName":"Carigi","name":"Carigi, Giulia","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Andrew","familyName":"Holbrook","name":"Holbrook, Andrew","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Håkon","familyName":"Tjelmeland","name":"Tjelmeland, Håkon","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Multiproposal Elliptical Slice Sampling"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Computation (stat.CO)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-25T19:31:58Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:04:24Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"We introduce Multiproposal Elliptical Slice Sampling, a self-tuning multiproposal Markov chain Monte Carlo method for Bayesian inference with Gaussian priors. Our method generalizes the Elliptical Slice Sampling algorithm by 1) allowing multiple candidate proposals to be sampled in parallel at each self-tuning step, and 2) basing the acceptance step on a distance-informed transition matrix that can favor proposals far from the current state. This allows larger moves in state space and faster self-tuning, at essentially no additional wall clock time for expensive likelihoods, and results in improved mixing. We additionally provide theoretical arguments and experimental results suggesting dimension-robust mixing behavior, making the algorithm particularly well suited for Bayesian PDE inverse problems."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.22358","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T02:44:33Z","registered":"2026-02-27T02:44:34Z","published":null,"updated":"2026-02-27T02:44:34Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.22357","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.22357","identifiers":[{"identifier":"2602.22357","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","affiliation":["School of Physics, HH Wills Physics Laboratory, University of Bristol"],"givenName":"R. A.","familyName":"Shaw","name":"Shaw, R. A.","nameIdentifiers":[]},{"nameType":"Personal","affiliation":["School of Physics, HH Wills Physics Laboratory, University of Bristol"],"givenName":"S.","familyName":"Fotopoulou","name":"Fotopoulou, S.","nameIdentifiers":[]},{"nameType":"Personal","affiliation":["School of Physics, HH Wills Physics Laboratory, University of Bristol"],"givenName":"M.","familyName":"Taylor","name":"Taylor, M.","nameIdentifiers":[]},{"nameType":"Personal","affiliation":["School of Physics, HH Wills Physics Laboratory, University of Bristol"],"givenName":"M.","familyName":"Bremer","name":"Bremer, M.","nameIdentifiers":[]}],"titles":[{"title":"STILTS-NLI: A Natural Language Interface for STILTS"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Instrumentation and Methods for Astrophysics (astro-ph.IM)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-25T19:27:57Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:04:14Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[{"relationType":"IsVersionOf","relatedIdentifier":"10.1093/rasti/rzag013","relatedIdentifierType":"DOI"}],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"The Starlink Tables Infrastructure Library Tool Set (STILTS) is a powerful suite for astronomical data analysis, particularly useful when dealing with large datasets. However, like other software suites in astronomy its comprehensive syntax creates a significant learning curve to new users. To address this, we present STILTS-NLI, a natural language interface that generates STILTS commands from user prompts, with agentic support for a user-friendly experience. We developed STILTS-NLI by fine-tuning a compact, open-source Large Language Model (LLM) on a synthetically generated dataset. This dataset was curated and validated to ensure both comprehensive coverage of key STILTS functionalities and the syntactic correctness of the resulting commands. Our results demonstrate that this specialised model generates valid commands that match and in some cases outperform larger proprietary models. By leveraging small, open-source models, STILTS-NLI provides an accessible, low-resource solution that lowers the barrier to entry for using STILTS."},{"descriptionType":"Other","description":"Accepted for publication in RASTI"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.22357","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":1,"created":"2026-02-27T02:44:32Z","registered":"2026-02-27T02:44:32Z","published":null,"updated":"2026-02-27T02:44:32Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.22351","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.22351","identifiers":[{"identifier":"2602.22351","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Qitong","familyName":"Wang","name":"Wang, Qitong","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Mohammed J.","familyName":"Zaki","name":"Zaki, Mohammed J.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Georgios","familyName":"Kollias","name":"Kollias, Georgios","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Vasileios","familyName":"Kalantzis","name":"Kalantzis, Vasileios","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Decoder-based Sense Knowledge Distillation"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-25T19:15:04Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:03:49Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Large language models (LLMs) learn contextual embeddings that capture rich semantic information, yet they often overlook structured lexical knowledge such as word senses and relationships. Prior work has shown that incorporating sense dictionaries can improve knowledge distillation for encoder models, but their application to decoder as generative models remains challenging. In this paper, we introduce Decoder-based Sense Knowledge Distillation (DSKD), a framework that integrates lexical resources into the training of decoder-style LLMs without requiring dictionary lookup at inference time. Extensive experiments on diverse benchmarks demonstrate that DSKD significantly enhances knowledge distillation performance for decoders, enabling generative models to inherit structured semantics while maintaining efficient training."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.22351","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T02:44:23Z","registered":"2026-02-27T02:44:24Z","published":null,"updated":"2026-02-27T02:44:24Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.22345","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.22345","identifiers":[{"identifier":"2602.22345","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Davide","familyName":"Ettori","name":"Ettori, Davide","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Structure and Redundancy in Large Language Models: A Spectral Study via Random Matrix Theory"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-25T19:11:56Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:03:29Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"This thesis addresses two persistent and closely related challenges in modern deep learning, reliability and efficiency, through a unified framework grounded in Spectral Geometry and Random Matrix Theory (RMT). As deep networks and large language models continue to scale, their internal behavior becomes increasingly opaque, leading to hallucinations, fragile generalization under distribution shift, and growing computational and energy demands. By analyzing the eigenvalue dynamics of hidden activations across layers and inputs, this work shows that spectral statistics provide a compact, stable, and interpretable lens on model behavior, capable of separating structured, causal representations from noise-dominated variability. Within this framework, the first contribution, EigenTrack, introduces a real-time method for detecting hallucinations and out-of-distribution behavior in large language and vision-language models. EigenTrack transforms streaming activations into spectral descriptors such as entropy, variance, and deviations from the Marchenko-Pastur baseline, and models their temporal evolution using lightweight recurrent classifiers, enabling early detection of reliability failures before they appear in model outputs while offering interpretable insight into representation dynamics. The second contribution, RMT-KD, presents a principled approach to compressing deep networks via random matrix theoretic knowledge distillation. By interpreting outlier eigenvalues in activation spectra as carriers of task-relevant information, RMT-KD progressively projects networks onto lower-dimensional subspaces through iterative self-distillation, yielding significantly more compact and energy-efficient models while preserving accuracy and dense, hardware-friendly structure."},{"descriptionType":"Other","description":"Executive Summary of Master Thesis in Computer Science Engineering, Politecnico di Milano"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.22345","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T02:44:15Z","registered":"2026-02-27T02:44:15Z","published":null,"updated":"2026-02-27T02:44:15Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.22343","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.22343","identifiers":[{"identifier":"2602.22343","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Shruthi","familyName":"Andru","name":"Andru, Shruthi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Shrut Kirti","familyName":"Saksena","name":"Saksena, Shrut Kirti","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Interface Framework for Human-AI Collaboration within Intelligent User Interface Ecosystems"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Human-Computer Interaction (cs.HC)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-25T19:09:32Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:03:27Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by-nc-sa/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution Non Commercial Share Alike 4.0 International","rightsIdentifier":"cc-by-nc-sa-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"As interfaces evolve from static user pathways to dynamic human-AI collaboration, no standard methods exist for selecting appropriate interface patterns based on user needs and task complexity. Existing frameworks only provide guiding principles for designing AI agent capabilities. We propose a dimensional framework based on workflow complexity, AI autonomy, and AI reasoning to guide the design of context-aware, scalable AI interfaces aka modalities (e.g., prompt bars, split screens, full screens, etc.). The framework was developed through co-design workshops with designers of marketing products and refined through qualitative research with eight long-term AI users. The study evaluated the three dimensions, identified task-to-interface relationships, and surfaced the importance of both business impact and security risk across all high-autonomy scenarios. This framework provides product teams with a shared language to develop scalable AI interfaces, emphasizing fluidity between interfaces and progressive user control to balance AI autonomy with human oversight."},{"descriptionType":"Other","description":"22 pages, 8 figures"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.22343","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T02:44:12Z","registered":"2026-02-27T02:44:13Z","published":null,"updated":"2026-02-27T02:44:13Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.22303","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.22303","identifiers":[{"identifier":"2602.22303","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Bruce W.","familyName":"Lee","name":"Lee, Bruce W.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Chen","familyName":"Yueh-Han","name":"Yueh-Han, Chen","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Tomek","familyName":"Korbak","name":"Korbak, Tomek","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Training Agents to Self-Report Misbehavior"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-25T18:47:17Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:02:25Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Frontier AI agents may pursue hidden goals while concealing their pursuit from oversight. Alignment training aims to prevent such behavior by reinforcing the correct goals, but alignment may not always succeed and can lead to unwanted side effects. We propose self-incrimination training, which instead trains agents to produce a visible signal when they covertly misbehave. We train GPT-4.1 and Gemini-2.0 agents to call a report_scheming() tool when behaving deceptively and measure their ability to cause harm undetected in out-of-distribution environments. Self-incrimination significantly reduces the undetected successful attack rate, outperforming matched-capability monitors and alignment baselines while preserving instruction hierarchy and incurring minimal safety tax on general capabilities. Unlike blackbox monitoring, self-incrimination performance is consistent across tasks regardless of how suspicious the misbehavior appears externally. The trained behavior persists under adversarial prompt optimization and generalizes to settings where agents pursue misaligned goals themselves rather than being instructed to misbehave. Our results suggest self-incrimination offers a viable path for reducing frontier misalignment risk, one that neither assumes misbehavior can be prevented nor that it can be reliably classified from the outside."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.22303","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T02:43:16Z","registered":"2026-02-27T02:43:17Z","published":null,"updated":"2026-02-27T02:43:17Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.22302","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.22302","identifiers":[{"identifier":"2602.22302","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Varun Pratap","familyName":"Bhardwaj","name":"Bhardwaj, Varun Pratap","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Agent Behavioral Contracts: Formal Specification and Runtime Enforcement for Reliable Autonomous AI Agents"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"Multiagent Systems (cs.MA)","lang":"en","subjectScheme":"arXiv"},{"subject":"Software Engineering (cs.SE)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-25T18:42:56Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:02:24Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[{"relationType":"IsVersionOf","relatedIdentifier":"10.5281/zenodo.18775393","relatedIdentifierType":"DOI"}],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by-nc-nd/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution Non Commercial No Derivatives 4.0 International","rightsIdentifier":"cc-by-nc-nd-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Traditional software relies on contracts -- APIs, type systems, assertions -- to specify and enforce correct behavior. AI agents, by contrast, operate on prompts and natural language instructions with no formal behavioral specification. This gap is the root cause of drift, governance failures, and frequent project failures in agentic AI deployments. We introduce Agent Behavioral Contracts (ABC), a formal framework that brings Design-by-Contract principles to autonomous AI agents. An ABC contract C = (P, I, G, R) specifies Preconditions, Invariants, Governance policies, and Recovery mechanisms as first-class, runtime-enforceable components. We define (p, delta, k)-satisfaction -- a probabilistic notion of contract compliance that accounts for LLM non-determinism and recovery -- and prove a Drift Bounds Theorem showing that contracts with recovery rate gamma \u0026gt; alpha (the natural drift rate) bound behavioral drift to D* = alpha/gamma in expectation, with Gaussian concentration in the stochastic setting. We establish sufficient conditions for safe contract composition in multi-agent chains and derive probabilistic degradation bounds. We implement ABC in AgentAssert, a runtime enforcement library, and evaluate on AgentContract-Bench, a benchmark of 200 scenarios across 7 models from 6 vendors. Results across 1,980 sessions show that contracted agents detect 5.2-6.8 soft violations per session that uncontracted baselines miss entirely (p \u0026lt; 0.0001, Cohen's d = 6.7-33.8), achieve 88-100% hard constraint compliance, and bound behavioral drift to D* \u0026lt; 0.27 across extended sessions, with 100% recovery for frontier models and 17-100% across all models, at overhead \u0026lt; 10 ms per action."},{"descriptionType":"Other","description":"71 pages, 7 figures, 14 tables. Patent pending. Also available on Zenodo: DOI 10.5281/zenodo.18775393"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.22302","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":2,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":1,"created":"2026-02-27T02:43:15Z","registered":"2026-02-27T02:43:15Z","published":null,"updated":"2026-02-27T02:43:15Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.22299","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.22299","identifiers":[{"identifier":"2602.22299","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Kunpeng","familyName":"Zhang","name":"Zhang, Kunpeng","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Poppy","familyName":"Zhang","name":"Zhang, Poppy","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Shawndra","familyName":"Hill","name":"Hill, Shawndra","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Amel","familyName":"Awadelkarim","name":"Awadelkarim, Amel","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Decoding the Hook: A Multimodal LLM Framework for Analyzing the Hooking Period of Video Ads"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Multimedia (cs.MM)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-25T18:24:06Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:02:10Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by-nc-sa/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution Non Commercial Share Alike 4.0 International","rightsIdentifier":"cc-by-nc-sa-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Video-based ads are a vital medium for brands to engage consumers, with social media platforms leveraging user data to optimize ad delivery and boost engagement. A crucial but under-explored aspect is the 'hooking period', the first three seconds that capture viewer attention and influence engagement metrics. Analyzing this brief window is challenging due to the multimodal nature of video content, which blends visual, auditory, and textual elements. Traditional methods often miss the nuanced interplay of these components, requiring advanced frameworks for thorough evaluation.\n This study presents a framework using transformer-based multimodal large language models (MLLMs) to analyze the hooking period of video ads. It tests two frame sampling strategies, uniform random sampling and key frame selection, to ensure balanced and representative acoustic feature extraction, capturing the full range of design elements. The hooking video is processed by state-of-the-art MLLMs to generate descriptive analyses of the ad's initial impact, which are distilled into coherent topics using BERTopic for high-level abstraction. The framework also integrates features such as audio attributes and aggregated ad targeting information, enriching the feature set for further analysis.\n Empirical validation on large-scale real-world data from social media platforms demonstrates the efficacy of our framework, revealing correlations between hooking period features and key performance metrics like conversion per investment. The results highlight the practical applicability and predictive power of the approach, offering valuable insights for optimizing video ad strategies. This study advances video ad analysis by providing a scalable methodology for understanding and enhancing the initial moments of video advertisements."},{"descriptionType":"Other","description":"11 pages, 5 figures, 3 tables"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.22299","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T02:43:10Z","registered":"2026-02-27T02:43:11Z","published":null,"updated":"2026-02-27T02:43:11Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.22298","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.22298","identifiers":[{"identifier":"2602.22298","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Zijian","familyName":"Zhu","name":"Zhu, Zijian","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Qiusheng","familyName":"Huang","name":"Huang, Qiusheng","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Anboyu","familyName":"Guo","name":"Guo, Anboyu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xiaohui","familyName":"Zhong","name":"Zhong, Xiaohui","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Hao","familyName":"Li","name":"Li, Hao","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"AviaSafe: A Physics-Informed Data-Driven Model for Aviation Safety-Critical Cloud Forecasts"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-25T17:51:07Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:02:09Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Current AI weather forecasting models predict conventional atmospheric variables but cannot distinguish between cloud microphysical species critical for aviation safety. We introduce AviaSafe, a hierarchical, physics-informed neural forecaster that produces global, six-hourly predictions of these four hydrometeor species for lead times up to 7 days. Our approach addresses the unique challenges of cloud prediction: extreme sparsity, discontinuous distributions, and complex microphysical interactions between species. We integrate the Icing Condition (IC) index from aviation meteorology as a physics-based constraint that identifies regions where supercooled water fuels explosive ice crystal growth. The model employs a hierarchical architecture that first predicts cloud spatial distribution through masked attention, then quantifies species concentrations within identified regions. Training on ERA5 reanalysis data, our model achieves lower RMSE for cloud species compared to baseline and outperforms operational numerical models on certain key variables at 7-day lead times. The ability to forecast individual cloud species enables new applications in aviation route optimization where distinguishing between ice and liquid water determines engine icing risk."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.22298","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T02:43:09Z","registered":"2026-02-27T02:43:10Z","published":null,"updated":"2026-02-27T02:43:10Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.22297","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.22297","identifiers":[{"identifier":"2602.22297","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Dhiraj","familyName":"Neupane","name":"Neupane, Dhiraj","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Richard","familyName":"Dazeley","name":"Dazeley, Richard","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Mohamed Reda","familyName":"Bouadjenek","name":"Bouadjenek, Mohamed Reda","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Sunil","familyName":"Aryal","name":"Aryal, Sunil","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Learning Rewards, Not Labels: Adversarial Inverse Reinforcement Learning for Machinery Fault Detection"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-25T15:34:19Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:02:08Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[{"relationType":"IsVersionOf","relatedIdentifier":"10.65109/axyx4522","relatedIdentifierType":"DOI"}],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by-nc-nd/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution Non Commercial No Derivatives 4.0 International","rightsIdentifier":"cc-by-nc-nd-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Reinforcement learning (RL) offers significant promise for machinery fault detection (MFD). However, most existing RL-based MFD approaches do not fully exploit RL's sequential decision-making strengths, often treating MFD as a simple guessing game (Contextual Bandits). To bridge this gap, we formulate MFD as an offline inverse reinforcement learning problem, where the agent learns the reward dynamics directly from healthy operational sequences, thereby bypassing the need for manual reward engineering and fault labels. Our framework employs Adversarial Inverse Reinforcement Learning to train a discriminator that distinguishes between normal (expert) and policy-generated transitions. The discriminator's learned reward serves as an anomaly score, indicating deviations from normal operating behaviour. When evaluated on three run-to-failure benchmark datasets (HUMS2023, IMS, and XJTU-SY), the model consistently assigns low anomaly scores to normal samples and high scores to faulty ones, enabling early and robust fault detection. By aligning RL's sequential reasoning with MFD's temporal structure, this work opens a path toward RL-based diagnostics in data-driven industrial settings."},{"descriptionType":"Other","description":"This article is accepted to be published in AAMAS2026. The doi is listed below but the production is on the way as of now (26/02/2026)"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.22297","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":1,"created":"2026-02-27T02:43:08Z","registered":"2026-02-27T02:43:08Z","published":null,"updated":"2026-02-27T02:43:08Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.22296","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.22296","identifiers":[{"identifier":"2602.22296","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Devan","familyName":"Shah","name":"Shah, Devan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Owen","familyName":"Yang","name":"Yang, Owen","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Daniel","familyName":"Yang","name":"Yang, Daniel","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Chongyi","familyName":"Zheng","name":"Zheng, Chongyi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Benjamin","familyName":"Eysenbach","name":"Eysenbach, Benjamin","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"UpSkill: Mutual Information Skill Learning for Structured Response Diversity in LLMs"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-25T15:34:14Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:02:06Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Reinforcement Learning with Verifiable Rewards (RLVR) has improved the reasoning abilities of large language models (LLMs) on mathematics and programming tasks, but standard approaches that optimize single-attempt accuracy can inadvertently suppress response diversity across repeated attempts, narrowing exploration and overlooking underrepresented strategies. We introduce UpSkill, a training time method that adapts Mutual Information Skill Learning (MISL) to LLMs for optimizing pass@k correctness. We propose a novel reward that we implement within Group Relative Policy Optimization (GRPO): a token-level mutual information (MI) reward that encourages trajectory specificity to z. Experiments on GSM8K with three open-weight models, Llama 3.1-8B, Qwen 2.5-7B, and R1-Distilled-Qwen2.5-Math-1.5B, show that UpSkill improves multi-attempt metrics on the stronger base models, yielding mean gains of ~3% in pass@k for both Qwen and Llama without degrading pass@1. Additionally, we find both empirical and theoretical evidence that improvements in pass@k are closely tied to the mutual information objective."},{"descriptionType":"Other","description":"First two authors equal contribution. 29 pages total (11 pages main text), 10 figures, 10 tables. Project website: https://dshah.io/upskill/"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.22296","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T02:43:06Z","registered":"2026-02-27T02:43:07Z","published":null,"updated":"2026-02-27T02:43:07Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.22290","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.22290","identifiers":[{"identifier":"2602.22290","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Yahao","familyName":"Ding","name":"Ding, Yahao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yinchao","familyName":"Yang","name":"Yang, Yinchao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jiaxiang","familyName":"Wang","name":"Wang, Jiaxiang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zhonghao","familyName":"Liu","name":"Liu, Zhonghao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zhaohui","familyName":"Yang","name":"Yang, Zhaohui","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Mingzhe","familyName":"Chen","name":"Chen, Mingzhe","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Mohammad","familyName":"Shikh-Bahaei","name":"Shikh-Bahaei, Mohammad","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Energy Efficient Federated Learning with Hyperdimensional Computing (HDC)"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Distributed, Parallel, and Cluster Computing (cs.DC)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-25T14:55:10Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:01:59Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"This paper investigates the problem of minimizing total energy consumption for secure federated learning (FL) in wireless edge networks, a key paradigm for decentralized big data analytics. To tackle the high computational cost and privacy challenges of processing large-scale distributed data with conventional neural networks, we propose an FL with hyperdimensional computing and differential privacy (FL-HDC-DP) framework. Each edge device employs hyperdimensional computing (HDC) for lightweight local training and applies differential privacy (DP) noise to protect transmitted model updates. The total energy consumption is minimized through a joint optimization of the HDC dimension, transmit power, and CPU frequency. An efficient hybrid algorithm is developed, combining an outer enumeration search for HDC dimensions with an inner one-dimensional search for resource allocation. Simulation results show that the proposed framework achieves up to 83.3% energy reduction compared with baseline schemes, while maintaining high accuracy and faster convergence."},{"descriptionType":"Other","description":"6 pages, 3 figures"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.22290","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T02:42:58Z","registered":"2026-02-27T02:42:58Z","published":null,"updated":"2026-02-27T02:42:58Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.22280","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.22280","identifiers":[{"identifier":"2602.22280","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Md. Tahsin","familyName":"Amin","name":"Amin, Md. Tahsin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Tanim","familyName":"Ahmmod","name":"Ahmmod, Tanim","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zannatul","familyName":"Ferdus","name":"Ferdus, Zannatul","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Talukder Naemul Hasan","familyName":"Naem","name":"Naem, Talukder Naemul Hasan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ehsanul","familyName":"Ferdous","name":"Ferdous, Ehsanul","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Arpita","familyName":"Bhattacharjee","name":"Bhattacharjee, Arpita","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ishmam Ahmed","familyName":"Solaiman","name":"Solaiman, Ishmam Ahmed","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Nahiyan Bin","familyName":"Noor","name":"Noor, Nahiyan Bin","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Integrating Machine Learning Ensembles and Large Language Models for Heart Disease Prediction Using Voting Fusion"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-25T10:53:57Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:01:47Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Cardiovascular disease is the primary cause of death globally, necessitating early identification, precise risk classification, and dependable decision-support technologies. The advent of large language models (LLMs) provides new zero-shot and few-shot reasoning capabilities, even though machine learning (ML) algorithms, especially ensemble approaches like Random Forest, XGBoost, LightGBM, and CatBoost, are excellent at modeling complex, non-linear patient data and routinely beat logistic regression. This research predicts cardiovascular disease using a merged dataset of 1,190 patient records, comparing traditional machine learning models (95.78% accuracy, ROC-AUC 0.96) with open-source large language models via OpenRouter APIs. Finally, a hybrid fusion of the ML ensemble and LLM reasoning under Gemini 2.5 Flash achieved the best results (96.62% accuracy, 0.97 AUC), showing that LLMs (78.9 % accuracy) work best when combined with ML models rather than used alone. Results show that ML ensembles achieved the highest performance (95.78% accuracy, ROC-AUC 0.96), while LLMs performed moderately in zero-shot (78.9%) and slightly better in few-shot (72.6%) settings. The proposed hybrid method enhanced the strength in uncertain situations, illustrating that ensemble ML is considered the best structured tabular prediction case, but it can be integrated with hybrid ML-LLM systems to provide a minor increase and open the way to more reliable clinical decision-support tools."},{"descriptionType":"Other","description":"7 pages, 8 figures, (Accepted at a peer-reviewed conference)"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.22280","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T02:42:44Z","registered":"2026-02-27T02:42:45Z","published":null,"updated":"2026-02-27T02:42:45Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.22279","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.22279","identifiers":[{"identifier":"2602.22279","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Victor","familyName":"Sechaud","name":"Sechaud, Victor","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Laurent","familyName":"Jacques","name":"Jacques, Laurent","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Patrice","familyName":"Abry","name":"Abry, Patrice","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Julián","familyName":"Tachella","name":"Tachella, Julián","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Learning to reconstruct from saturated data: audio declipping and high-dynamic range imaging"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Image and Video Processing (eess.IV)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"Sound (cs.SD)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Electrical engineering, electronic engineering, information engineering","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Electrical engineering, electronic engineering, information engineering","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-25T10:37:14Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:01:44Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Learning based methods are now ubiquitous for solving inverse problems, but their deployment in real-world applications is often hindered by the lack of ground truth references for training. Recent self-supervised learning strategies offer a promising alternative, avoiding the need for ground truth. However, most existing methods are limited to linear inverse problems. This work extends self-supervised learning to the non-linear problem of recovering audio and images from clipped measurements, by assuming that the signal distribution is approximately invariant to changes in amplitude. We provide sufficient conditions for learning to reconstruct from saturated signals alone and a self-supervised loss that can be used to train reconstruction networks. Experiments on both audio and image data show that the proposed approach is almost as effective as fully supervised approaches, despite relying solely on clipped measurements for training."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.22279","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T02:42:42Z","registered":"2026-02-27T02:42:43Z","published":null,"updated":"2026-02-27T02:42:43Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.22278","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.22278","identifiers":[{"identifier":"2602.22278","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Dawei","familyName":"Su","name":"Su, Dawei","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Dongsheng","familyName":"Wang","name":"Wang, Dongsheng","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"RETLLM: Training and Data-Free MLLMs for Multimodal Information Retrieval"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Information Retrieval (cs.IR)","lang":"en","subjectScheme":"arXiv"},{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-25T10:31:32Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:01:43Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Multimodal information retrieval (MMIR) has gained attention for its flexibility in handling text, images, or mixed queries and candidates. Recent breakthroughs in multimodal large language models (MLLMs) boost MMIR performance by incorporating MLLM knowledge under the contrastive finetuning framework. However, they suffer from pre-training inconsistency and require large datasets. In this work, we introduce a novel framework, RetLLM, designed to query MLLMs for MMIR in a training- and data-free manner. Specifically, we formulate MMIR as a similarity score generation task and prompt MLLMs to directly predict retrieval scores in a coarse-then-fine pipeline. At the coarse stage, a top-k filtering strategy builds a small yet high-quality candidate pool for each query, enabling MLLMs to focus on semantically relevant candidates. Subsequently, the retrieval score is predicted by feeding both the query and candidate into MLLMs at the fine stage. Importantly, we propose a visual enhancement module during reasoning to help MLLMs re-pick forgotten visuals, improving retrieval. Extensive experiments on MMIR benchmarks show that RetLLM outperforms fine-tuned models. Ablation studies further verify each component. Our work demonstrates that MLLMs can achieve strong MMIR performance without any training, highlighting their inherent multimodal reasoning ability in a simple, scalable framework. We release our code at: https://github.com/alivecat05/RETLLM"},{"descriptionType":"Other","description":"5 pages, 2 figure"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.22278","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T02:42:41Z","registered":"2026-02-27T02:42:42Z","published":null,"updated":"2026-02-27T02:42:42Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.22276","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.22276","identifiers":[{"identifier":"2602.22276","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Oliver","familyName":"Karras","name":"Karras, Oliver","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Amirreza","familyName":"Alasti","name":"Alasti, Amirreza","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Lena","familyName":"John","name":"John, Lena","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Sushant","familyName":"Aggarwal","name":"Aggarwal, Sushant","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yücel","familyName":"Celik","name":"Celik, Yücel","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"EmpiRE-Compass: A Neuro-Symbolic Dashboard for Sustainable and Dynamic Knowledge Exploration, Synthesis, and Reuse"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Software Engineering (cs.SE)","lang":"en","subjectScheme":"arXiv"},{"subject":"Digital Libraries (cs.DL)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-25T09:58:20Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:06:44Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Software engineering (SE) and requirements engineering (RE) face a significant increase in secondary studies, particularly literature reviews (LRs), due to the ever-growing number of scientific publications. Generative artificial intelligence (GenAI) exacerbates this trend by producing LRs rapidly but often at the expense of quality, rigor, and transparency. At the same time, secondary studies often fail to share underlying data and artifacts, limiting replication and reuse. This paper introduces EmpiRE-Compass, a neuro-symbolic dashboard designed to lower barriers for accessing, replicating, and reusing LR data. Its overarching goal is to demonstrate how LRs can become more sustainable by semantically structuring their underlying data in research knowledge graphs (RKGs) and by leveraging large language models (LLMs) for easy and dynamic access, replication, and reuse. Building on two RE use cases, we developed EmpiRE-Compass with a modular system design and workflows for curated and custom competency questions. The dashboard is freely available online, accompanied by a demonstration video. To manage operational costs, a limit of 25 requests per IP address per day applies to the default LLM (GPT-4o mini). All source code and documentation are released as an open-source project to foster reuse, adoption, and extension. EmpiRE-Compass provides three core capabilities: (1) Exploratory visual analytics for curated competency questions; (2) Neuro-symbolic synthesis for custom competency questions; and (3) Reusable knowledge with all queries, analyses, and results openly available. By unifying RKGs and LLMs in a neuro-symbolic dashboard, EmpiRE-Compass advances sustainable LRs in RE, SE, and beyond. It lowers technical barriers, fosters transparency and reproducibility, and enables collaborative, continuously updated, and reusable LRs"},{"descriptionType":"Other","description":"7 pages, 1 figure, Accepted at 32nd International Working Conference on Requirements Engineering: Foundations for Software Quality"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.22276","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":2,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T02:42:38Z","registered":"2026-02-27T02:42:39Z","published":null,"updated":"2026-02-27T02:42:39Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.22269","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.22269","identifiers":[{"identifier":"2602.22269","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Arnab","familyName":"Nath","name":"Nath, Arnab","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Harsh","familyName":"Kasyap","name":"Kasyap, Harsh","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"CQSA: Byzantine-robust Clustered Quantum Secure Aggregation in Federated Learning"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-25T07:50:24Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:01:31Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Federated Learning (FL) enables collaborative model training without sharing raw data. However, shared local model updates remain vulnerable to inference and poisoning attacks. Secure aggregation schemes have been proposed to mitigate these attacks. In this work, we aim to understand how these techniques are implemented in quantum-assisted FL. Quantum Secure Aggregation (QSA) has been proposed, offering information-theoretic privacy by encoding client updates into the global phase of multipartite entangled states. Existing QSA protocols, however, rely on a single global Greenberger-Horne-Zeilinger (GHZ) state shared among all participating clients. This design poses fundamental challenges: fidelity of large-scale GHZ states deteriorates rapidly with the increasing number of clients; and (ii) the global aggregation prevents the detection of Byzantine clients. We propose Clustered Quantum Secure Aggregation (CQSA), a modular aggregation framework that reconciles the physical constraints of near-term quantum hardware along with the need for Byzantine-robustness in FL. CQSA randomly partitions the clients into small clusters, each performing local quantum aggregation using high-fidelity, low-qubit GHZ states. The server analyzes statistical relationships between cluster-level aggregates employing common statistical measures such as cosine similarity and Euclidean distance to identify malicious contributions. Through theoretical analysis and simulations under depolarizing noise, we demonstrate that CQSA ensures stable model convergence, achieves superior state fidelity over global QSA."},{"descriptionType":"Other","description":"6 pages, 3 figures"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.22269","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T02:42:28Z","registered":"2026-02-27T02:42:29Z","published":null,"updated":"2026-02-27T02:42:29Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.22268","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.22268","identifiers":[{"identifier":"2602.22268","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Changhai","familyName":"Zhou","name":"Zhou, Changhai","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Shiyang","familyName":"Zhang","name":"Zhang, Shiyang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yuhua","familyName":"Zhou","name":"Zhou, Yuhua","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Qian","familyName":"Qiao","name":"Qiao, Qian","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jun","familyName":"Gao","name":"Gao, Jun","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Cheng","familyName":"Jin","name":"Jin, Cheng","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Kaizhou","familyName":"Qin","name":"Qin, Kaizhou","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Weizhong","familyName":"Zhang","name":"Zhang, Weizhong","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"AutoQRA: Joint Optimization of Mixed-Precision Quantization and Low-rank Adapters for Efficient LLM Fine-Tuning"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-25T07:18:08Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:01:29Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Quantization followed by parameter-efficient fine-tuning has emerged as a promising paradigm for downstream adaptation under tight GPU memory constraints. However, this sequential pipeline fails to leverage the intricate interaction between quantization bit-width and LoRA rank. Specifically, a carefully optimized quantization allocation with low quantization error does not always translate to strong fine-tuning performance, and different bit-width and rank configurations can lead to significantly varying outcomes under the same memory budget. To address this limitation, we propose AutoQRA, a joint optimization framework that simultaneously optimizes the bit-width and LoRA rank configuration for each layer during the mixed quantized fine-tuning process. To tackle the challenges posed by the large discrete search space and the high evaluation cost associated with frequent fine-tuning iterations, AutoQRA decomposes the optimization process into two stages. First, it first conducts a global multi-fidelity evolutionary search, where the initial population is warm-started by injecting layer-wise importance priors. This stage employs specific operators and a performance model to efficiently screen candidate configurations. Second, trust-region Bayesian optimization is applied to locally refine promising regions of the search space and identify optimal configurations under the given memory budget. This approach enables active compensation for quantization noise in specific layers during training. Experiments show that AutoQRA achieves performance close to full-precision fine-tuning with a memory footprint comparable to uniform 4-bit methods."},{"descriptionType":"Other","description":"15 pages, 10 figures"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.22268","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T02:42:27Z","registered":"2026-02-27T02:42:28Z","published":null,"updated":"2026-02-27T02:42:28Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.22261","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.22261","identifiers":[{"identifier":"2602.22261","identifierType":"arXiv"}],"creators":[{"nameType":"Organizational","affiliation":[],"name":"Yuvarani","nameIdentifiers":[]},{"nameType":"Personal","givenName":"Akashdeep","familyName":"Singh","name":"Singh, Akashdeep","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zahra","familyName":"Fathanah","name":"Fathanah, Zahra","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Salsabila","familyName":"Harlen","name":"Harlen, Salsabila","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Syeikha Syafura Al-Zahra binti","familyName":"Zahari","name":"Zahari, Syeikha Syafura Al-Zahra binti","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Hema","familyName":"Subramaniam","name":"Subramaniam, Hema","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Sustainable LLM Inference using Context-Aware Model Switching"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-25T03:42:12Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:01:19Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Large language models have become central to many AI applications, but their growing energy consumption raises serious sustainability concerns. A key limitation in current AI deployments is the reliance on a one-size-fits-all inference strategy where most systems route every request to the same large model, regardless of task complexity, leading to substantial and unnecessary energy waste. To address this issue, we propose a context-aware model switching approach that dynamically selects an appropriate language model based on query complexity. The proposed system uses a Context-Aware Model Switching for Energy-Efficient LLM Inference that combines caching for repeated queries, rulebased complexity scoring for fast and explainable decisions, machine learning classification to capture semantic intent, and a user-adaptive component that learns from interaction patterns over time. The proposed architecture was evaluated using real conversation workloads and three open-source language models (Gemma3 1B, Gemma3 4B and Qwen3 4B) with different computational costs, measuring energy consumption (via NVML GPU power telemetry), response latency, routing accuracy, and output quality (BERTScore F1) to reflect real-world usage conditions. Experimental results show that the model switching approach can reduce energy consumption by up to 67.5% compared to always using the largest model while maintaining a response quality of 93.6%. In addition, the response time for simple queries also improved significantly by approximately 68%. These results show that model switching inference offers a practical and scalable path toward more energy-efficient and sustainable AI systems, demonstrating that significant efficiency gains can be achieved without major sacrifices in response quality."},{"descriptionType":"Other","description":"15 pages, 6 figures"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.22261","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T02:42:17Z","registered":"2026-02-27T02:42:18Z","published":null,"updated":"2026-02-27T02:42:18Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.22260","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.22260","identifiers":[{"identifier":"2602.22260","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Camilo Chacón","familyName":"Sartori","name":"Sartori, Camilo Chacón","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Guillem Rodríguez","familyName":"Corominas","name":"Corominas, Guillem Rodríguez","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Code World Models for Parameter Control in Evolutionary Algorithms"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"Neural and Evolutionary Computing (cs.NE)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-25T01:49:29Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:01:18Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Can an LLM learn how an optimizer behaves -- and use that knowledge to control it? We extend Code World Models (CWMs), LLM-synthesized Python programs that predict environment dynamics, from deterministic games to stochastic combinatorial optimization. Given suboptimal trajectories of $(1{+}1)$-$\\text{RLS}_k$, the LLM synthesizes a simulator of the optimizer's dynamics; greedy planning over this simulator then selects the mutation strength $k$ at each step. On \\lo{} and \\onemax{}, CWM-greedy performs within 6\\% of the theoretically optimal policy -- without ever seeing optimal-policy trajectories. On \\jump{$_k$}, where a deceptive valley causes all adaptive baselines to fail (0\\% success rate), CWM-greedy achieves 100\\% success rate -- without any collection policy using oracle knowledge of the gap parameter. On the NK-Landscape, where no closed-form model exists, CWM-greedy outperforms all baselines across fifteen independently generated instances ($36.94$ vs.\\ $36.32$; $p\u0026lt;0.001$) when the prompt includes empirical transition statistics. The CWM also outperforms DQN in sample efficiency (200 offline trajectories vs.\\ 500 online episodes), success rate (100\\% vs.\\ 58\\%), and generalization ($k{=}3$: 78\\% vs.\\ 0\\%). Robustness experiments confirm stable synthesis across 5 independent runs."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.22260","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T02:42:16Z","registered":"2026-02-27T02:42:17Z","published":null,"updated":"2026-02-27T02:42:17Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.22258","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.22258","identifiers":[{"identifier":"2602.22258","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Harrison","familyName":"Dahme","name":"Dahme, Harrison","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Poisoned Acoustics"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Cryptography and Security (cs.CR)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-25T01:09:43Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:01:16Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Training-data poisoning attacks can induce targeted, undetectable failure in deep neural networks by corrupting a vanishingly small fraction of training labels. We demonstrate this on acoustic vehicle classification using the MELAUDIS urban intersection dataset (approx. 9,600 audio clips, 6 classes): a compact 2-D convolutional neural network (CNN) trained on log-mel spectrograms achieves 95.7% Attack Success Rate (ASR) -- the fraction of target-class test samples misclassified under the attack -- on a Truck-to-Car label-flipping attack at just p=0.5% corruption (48 records), with zero detectable change in aggregate accuracy (87.6% baseline; 95% CI: 88-100%, n=3 seeds). We prove this stealth is structural: the maximum accuracy drop from a complete targeted attack is bounded above by the minority class fraction (beta). For real-world class imbalances (Truck approx. 3%), this bound falls below training-run noise, making aggregate accuracy monitoring provably insufficient regardless of architecture or attack method. A companion backdoor trigger attack reveals a novel trigger-dominance collapse: when the target class is a dataset minority, the spectrogram patch trigger becomes functionally redundant--clean ASR equals triggered ASR, and the attack degenerates to pure label flipping. We formalize the ML training pipeline as an attack surface and propose a trust-minimized defense combining content-addressed artifact hashing, Merkle-tree dataset commitment, and post-quantum digital signatures (ML-DSA-65/CRYSTALS-Dilithium3, NIST FIPS 204) for cryptographically verifiable data provenance."},{"descriptionType":"Other","description":"5 Pages"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.22258","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T02:42:13Z","registered":"2026-02-27T02:42:14Z","published":null,"updated":"2026-02-27T02:42:14Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.22255","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.22255","identifiers":[{"identifier":"2602.22255","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Ahmed","familyName":"Nebli","name":"Nebli, Ahmed","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Hadi","familyName":"Saadatdoorabi","name":"Saadatdoorabi, Hadi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Kevin","familyName":"Yam","name":"Yam, Kevin","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Deep Sequence Modeling with Quantum Dynamics: Language as a Wave Function"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"Quantum Physics (quant-ph)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-24T23:42:18Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:01:11Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"We introduce a sequence modeling framework in which the latent state is a complex-valued wave function evolving on a finite-dimensional Hilbert space under a learned, time-dependent Hamiltonian. Unlike standard recurrent architectures that rely on gating mechanisms to suppress competing hypotheses, our framework utilizes quantum interference: the Hamiltonian steers the phases of complex amplitudes so that conflicting interpretations cancel while compatible ones reinforce. The dynamics are strictly unitary, ensuring that the state norm is preserved exactly at every time step via a Cayley (Crank--Nicolson) discretization. Token probabilities are extracted using the Born rule, a quadratic measurement operator that couples magnitudes and relative phases. Our primary theoretical contribution is a separation theorem characterizing the representational advantage of this readout: we define a family of disambiguation tasks that a complex unitary model of dimension $N$ solves exactly, but which requires a state dimension of $Ω(N^2)$ for any real-valued orthogonal model equipped with a standard affine-softmax readout. This quadratic gap arises because the Born rule implicitly lifts the $N$-dimensional state into the space of rank-one Hermitian matrices, accessing pairwise phase correlations that are inaccessible to linear projections. Finally, we derive a continuity equation for the latent probability mass, yielding conserved pairwise currents that serve as a built-in diagnostic for tracing information flow between dimensions."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.22255","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T02:42:09Z","registered":"2026-02-27T02:42:10Z","published":null,"updated":"2026-02-27T02:42:10Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.22254","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.22254","identifiers":[{"identifier":"2602.22254","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Abdulrahman","familyName":"Tamim","name":"Tamim, Abdulrahman","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Causal Direction from Convergence Time: Faster Training in the True Causal Direction"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"I.2.6; I.2.4; F.2.2","lang":"en","subjectScheme":"ACM"},{"subject":"68T07, 68Q32, 62H30","lang":"en","subjectScheme":"MSC"}],"contributors":[],"dates":[{"date":"2026-02-24T21:34:57Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:01:09Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"We introduce Causal Computational Asymmetry (CCA), a principle for causal direction identification based on optimization dynamics in which one neural network is trained to predict $Y$ from $X$ and another to predict $X$ from $Y$, and the direction that converges faster is inferred to be causal. Under the additive noise model $Y = f(X) + \\varepsilon$ with $\\varepsilon \\perp X$ and $f$ nonlinear and injective, we establish a formal asymmetry: in the reverse direction, residuals remain statistically dependent on the input regardless of approximation quality, inducing a strictly higher irreducible loss floor and non-separable gradient noise in the optimization dynamics, so that the reverse model requires strictly more gradient steps in expectation to reach any fixed loss threshold; consequently, the forward (causal) direction converges in fewer expected optimization steps. CCA operates in optimization-time space, distinguishing it from methods such as RESIT, IGCI, and SkewScore that rely on statistical independence or distributional asymmetries, and proper z-scoring of both variables is required for valid comparison of convergence rates. On synthetic benchmarks, CCA achieves 26/30 correct causal identifications across six neural architectures, including 30/30 on sine and exponential data-generating processes. We further embed CCA into a broader framework termed Causal Compression Learning (CCL), which integrates graph structure learning, causal information compression, and policy optimization, with all theoretical guarantees formally proved and empirically validated on synthetic datasets."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.22254","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T02:42:08Z","registered":"2026-02-27T02:42:08Z","published":null,"updated":"2026-02-27T02:42:08Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.22253","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.22253","identifiers":[{"identifier":"2602.22253","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Townim Faisal","familyName":"Chowdhury","name":"Chowdhury, Townim Faisal","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ta Duc","familyName":"Huy","name":"Huy, Ta Duc","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Siqi","familyName":"Pan","name":"Pan, Siqi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jeremy","familyName":"Stoddard","name":"Stoddard, Jeremy","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zhibin","familyName":"Liao","name":"Liao, Zhibin","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"AR\u0026amp;D: A Framework for Retrieving and Describing Concepts for Interpreting AudioLLMs"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Sound (cs.SD)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-24T21:10:09Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:01:08Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Despite strong performance in audio perception tasks, large audio-language models (AudioLLMs) remain opaque to interpretation. A major factor behind this lack of interpretability is that individual neurons in these models frequently activate in response to several unrelated concepts. We introduce the first mechanistic interpretability framework for AudioLLMs, leveraging sparse autoencoders (SAEs) to disentangle polysemantic activations into monosemantic features. Our pipeline identifies representative audio clips, assigns meaningful names via automated captioning, and validates concepts through human evaluation and steering. Experiments show that AudioLLMs encode structured and interpretable features, enhancing transparency and control. This work provides a foundation for trustworthy deployment in high-stakes domains and enables future extensions to larger models, multilingual audio, and more fine-grained paralinguistic features. Project URL: https://townim-faisal.github.io/AutoInterpret-AudioLLM/"},{"descriptionType":"Other","description":"Accepted at International Conference on Acoustics, Speech, and Signal Processing (ICASSP), 2026"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.22253","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T02:42:06Z","registered":"2026-02-27T02:42:07Z","published":null,"updated":"2026-02-27T02:42:07Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.22250","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.22250","identifiers":[{"identifier":"2602.22250","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Morteza","familyName":"Eskandarian","name":"Eskandarian, Morteza","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Mahdi","familyName":"Rabbani","name":"Rabbani, Mahdi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Arun","familyName":"Kaniyamattam","name":"Kaniyamattam, Arun","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Fatemeh","familyName":"Nejati","name":"Nejati, Fatemeh","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Mansur","familyName":"Mirani","name":"Mirani, Mansur","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Gunjan","familyName":"Piya","name":"Piya, Gunjan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Igor","familyName":"Opushnyev","name":"Opushnyev, Igor","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ali A.","familyName":"Ghorbani","name":"Ghorbani, Ali A.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Sajjad","familyName":"Dadkhah","name":"Dadkhah, Sajjad","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"A Lightweight Defense Mechanism against Next Generation of Phishing Emails using Distilled Attention-Augmented BiLSTM"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Cryptography and Security (cs.CR)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-24T20:06:45Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:01:03Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"The current generation of large language models produces sophisticated social-engineering content that bypasses standard text screening systems in business communication platforms. Our proposed solution for mail gateway and endpoint deception detection operates in a privacy-protective manner while handling the performance requirements of network and mobile security systems. The MobileBERT teacher receives fine-tuning before its transformation into a BiLSTM model with multi-head attention which maintains semantic discrimination only with 4.5 million parameters. The hybrid dataset contains human-written messages together with LLM-generated paraphrases that use masking techniques and personalization methods to enhance modern attack resistance. The evaluation system uses five testing protocols which include human-only and LLM-only tests and two cross-distribution transfer tests and a production-like mixed traffic test to assess performance in native environments and across different distribution types and combined traffic scenarios. The distilled model maintains a weighted-F1 score difference of 1-2.5 points compared to the mixture split results of strong transformer baselines including ModernBERT, DeBERTaV3-base, T5-base, DeepSeek-R1 Distill Qwen-1.5B and Phi-4 mini while achieving 80-95\\% faster inference times and 95-99\\% smaller model sizes. The system demonstrates excellent performance in terms of accuracy and latency while maintaining a compact size which enables real-time filtering without acceleration hardware and supports policy-based management. The paper examines system performance under high traffic conditions and security measures for privacy protection and implementation methods for operational deployment."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.22250","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T02:42:02Z","registered":"2026-02-27T02:42:03Z","published":null,"updated":"2026-02-27T02:42:03Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.22247","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.22247","identifiers":[{"identifier":"2602.22247","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Ihor","familyName":"Kendiukhov","name":"Kendiukhov, Ihor","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Multi-Dimensional Spectral Geometry of Biological Knowledge in Single-Cell Transformer Representations"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Genomics (q-bio.GN)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Biological sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Biological sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-24T17:57:59Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:00:57Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Single-cell foundation models such as scGPT learn high-dimensional gene representations, but what biological knowledge these representations encode remains unclear. We systematically decode the geometric structure of scGPT internal representations through 63 iterations of automated hypothesis screening (183 hypotheses tested), revealing that the model organizes genes into a structured biological coordinate system rather than an opaque feature space.\n The dominant spectral axis separates genes by subcellular localization, with secreted proteins at one pole and cytosolic proteins at the other. Intermediate transformer layers transiently encode mitochondrial and ER compartments in a sequence that mirrors the cellular secretory pathway. Orthogonal axes encode protein-protein interaction networks with graded fidelity to experimentally measured interaction strength (Spearman rho = 1.000 across n = 5 STRING confidence quintiles, p = 0.017).\n In a compact six-dimensional spectral subspace, the model distinguishes transcription factors from their target genes (AUROC = 0.744, all 12 layers significant). Early layers preserve which specific genes regulate which targets, while deeper layers compress this into a coarser regulator versus regulated distinction. Repression edges are geometrically more prominent than activation edges, and B-cell master regulators BATF and BACH2 show convergence toward the B-cell identity anchor PAX5 across transformer depth. Cell-type marker genes cluster with high fidelity (AUROC = 0.851). Residual-stream geometry encodes biological structure complementary to attention patterns. These results indicate that biological transformers learn an interpretable internal model of cellular organization, with implications for regulatory network inference, drug target prioritization, and model auditing."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.22247","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T02:41:58Z","registered":"2026-02-27T02:41:58Z","published":null,"updated":"2026-02-27T02:41:58Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.22246","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.22246","identifiers":[{"identifier":"2602.22246","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Guangnian","familyName":"Wan","name":"Wan, Guangnian","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Qi","familyName":"Li","name":"Li, Qi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Gongfan","familyName":"Fang","name":"Fang, Gongfan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xinyin","familyName":"Ma","name":"Ma, Xinyin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xinchao","familyName":"Wang","name":"Wang, Xinchao","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Self-Purification Mitigates Backdoors in Multimodal Diffusion Language Models"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Cryptography and Security (cs.CR)","lang":"en","subjectScheme":"arXiv"},{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-24T15:47:52Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:00:56Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Multimodal Diffusion Language Models (MDLMs) have recently emerged as a competitive alternative to their autoregressive counterparts. Yet their vulnerability to backdoor attacks remains largely unexplored. In this work, we show that well-established data-poisoning pipelines can successfully implant backdoors into MDLMs, enabling attackers to manipulate model behavior via specific triggers while maintaining normal performance on clean inputs. However, defense strategies effective to these models are yet to emerge. To bridge this gap, we introduce a backdoor defense framework for MDLMs named DiSP (Diffusion Self-Purification). DiSP is driven by a key observation: selectively masking certain vision tokens at inference time can neutralize a backdoored model's trigger-induced behaviors and restore normal functionality. Building on this, we purify the poisoned dataset using the compromised model itself, then fine-tune the model on the purified data to recover it to a clean one. Given such a specific design, DiSP can remove backdoors without requiring any auxiliary models or clean reference data. Extensive experiments demonstrate that our approach effectively mitigates backdoor effects, reducing the attack success rate (ASR) from over 90% to typically under 5%, while maintaining model performance on benign tasks."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.22246","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T02:41:56Z","registered":"2026-02-27T02:41:57Z","published":null,"updated":"2026-02-27T02:41:57Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.22244","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.22244","identifiers":[{"identifier":"2602.22244","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Aurora","familyName":"Arrus","name":"Arrus, Aurora","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Maria","familyName":"di Gisi","name":"di Gisi, Maria","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Sara","familyName":"Lilli","name":"Lilli, Sara","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Marco","familyName":"Quadrini","name":"Quadrini, Marco","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Accelerating Incident Response: A Hybrid Approach for Data Breach Reporting"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Cryptography and Security (cs.CR)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-24T14:48:50Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:00:53Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"The General Data Protection Regulation (GDPR) requires organisations to notify supervisory authorities of personal data breaches within 72 hours of discovery. Meeting this strict deadline is challenging because incident responders must manually translate low-level forensic artefacts such as malware traces, system-call logs, and network captures into the structured, legally framed information required by data-protection authorities. This gap between technical evidence and regulatory reporting often results in delays, incomplete notifications, and a high cognitive burden on analysts. We propose a hybrid malware analysis pipeline that automates the extraction and organisation of breach-relevant information, with a particular focus on exfiltration-oriented Linux/ARM malware, which is rapidly increasing in prevalence due to the widespread adoption of IoT and embedded devices. The system combines static analysis to identify potential exfiltrators with dynamic analysis to reconstruct their behaviour. It employs a Large Language Model (LLM) constrained by a formal JSON schema aligned with the official Italian Garante Privacy notification form. The LLM transforms heterogeneous forensic artefacts into a structured, compliance-ready report that a human operator can rapidly validate."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.22244","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T02:41:53Z","registered":"2026-02-27T02:41:54Z","published":null,"updated":"2026-02-27T02:41:54Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.22242","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.22242","identifiers":[{"identifier":"2602.22242","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Piyush","familyName":"Jaiswal","name":"Jaiswal, Piyush","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Aaditya","familyName":"Pratap","name":"Pratap, Aaditya","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Shreyansh","familyName":"Saraswati","name":"Saraswati, Shreyansh","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Harsh","familyName":"Kasyap","name":"Kasyap, Harsh","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Somanath","familyName":"Tripathy","name":"Tripathy, Somanath","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Analysis of LLMs Against Prompt Injection and Jailbreak Attacks"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Cryptography and Security (cs.CR)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-24T12:32:11Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:00:51Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Large Language Models (LLMs) are widely deployed in real-world systems. Given their broader applicability, prompt engineering has become an efficient tool for resource-scarce organizations to adopt LLMs for their own purposes. At the same time, LLMs are vulnerable to prompt-based attacks. Thus, analyzing this risk has become a critical security requirement. This work evaluates prompt-injection and jailbreak vulnerability using a large, manually curated dataset across multiple open-source LLMs, including Phi, Mistral, DeepSeek-R1, Llama 3.2, Qwen, and Gemma variants. We observe significant behavioural variation across models, including refusal responses and complete silent non-responsiveness triggered by internal safety mechanisms. Furthermore, we evaluated several lightweight, inference-time defence mechanisms that operate as filters without any retraining or GPU-intensive fine-tuning. Although these defences mitigate straightforward attacks, they are consistently bypassed by long, reasoning-heavy prompts."},{"descriptionType":"Other","description":"12 pages, 5 figures, 6 tables"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.22242","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T02:41:50Z","registered":"2026-02-27T02:41:51Z","published":null,"updated":"2026-02-27T02:41:51Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.22240","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.22240","identifiers":[{"identifier":"2602.22240","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Linus","familyName":"Bantel","name":"Bantel, Linus","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Moritz","familyName":"Strack","name":"Strack, Moritz","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Alexander","familyName":"Strack","name":"Strack, Alexander","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Dirk","familyName":"Pflüger","name":"Pflüger, Dirk","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"From Prompts to Performance: Evaluating LLMs for Task-based Parallel Code Generation"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Programming Languages (cs.PL)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"Distributed, Parallel, and Cluster Computing (cs.DC)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-24T09:49:10Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:00:48Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Large Language Models (LLM) show strong abilities in code generation, but their skill in creating efficient parallel programs is less studied. This paper explores how LLMs generate task-based parallel code from three kinds of input prompts: natural language problem descriptions, sequential reference implementations, and parallel pseudo code. We focus on three programming frameworks: OpenMP Tasking, C++ standard parallelism, and the asynchronous many-task runtime HPX. Each framework offers different levels of abstraction and control for task execution. We evaluate LLM-generated solutions for correctness and scalability. Our results reveal both strengths and weaknesses of LLMs with regard to problem complexity and framework. Finally, we discuss what these findings mean for future LLM-assisted development in high-performance and scientific computing."},{"descriptionType":"Other","description":"12 pages, 4 figures, 2 tables, Workshop on Asynchronous Many-Task Systems and Applications 2026"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.22240","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T02:41:48Z","registered":"2026-02-27T02:41:48Z","published":null,"updated":"2026-02-27T02:41:48Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.22236","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.22236","identifiers":[{"identifier":"2602.22236","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Rabeya Tus","familyName":"Sadia","name":"Sadia, Rabeya Tus","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Qiang","familyName":"Ye","name":"Ye, Qiang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Qiang","familyName":"Cheng","name":"Cheng, Qiang","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"CrossLLM-Mamba: Multimodal State Space Fusion of LLMs for RNA Interaction Prediction"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Genomics (q-bio.GN)","lang":"en","subjectScheme":"arXiv"},{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Biological sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Biological sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-23T19:57:11Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:00:42Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Accurate prediction of RNA-associated interactions is essential for understanding cellular regulation and advancing drug discovery. While Biological Large Language Models (BioLLMs) such as ESM-2 and RiNALMo provide powerful sequence representations, existing methods rely on static fusion strategies that fail to capture the dynamic, context-dependent nature of molecular binding. We introduce CrossLLM-Mamba, a novel framework that reformulates interaction prediction as a state-space alignment problem. By leveraging bidirectional Mamba encoders, our approach enables deep ``crosstalk'' between modality-specific embeddings through hidden state propagation, modeling interactions as dynamic sequence transitions rather than static feature overlaps. The framework maintains linear computational complexity, making it scalable to high-dimensional BioLLM embeddings. We further incorporate Gaussian noise injection and Focal Loss to enhance robustness against hard-negative samples. Comprehensive experiments across three interaction categories, RNA-protein, RNA-small molecule, and RNA-RNA demonstrate that CrossLLM-Mamba achieves state-of-the-art performance. On the RPI1460 benchmark, our model attains an MCC of 0.892, surpassing the previous best by 5.2\\%. For binding affinity prediction, we achieve Pearson correlations exceeding 0.95 on riboswitch and repeat RNA subtypes. These results establish state-space modeling as a powerful paradigm for multi-modal biological interaction prediction."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.22236","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T02:41:42Z","registered":"2026-02-27T02:41:43Z","published":null,"updated":"2026-02-27T02:41:43Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.22235","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.22235","identifiers":[{"identifier":"2602.22235","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Jine","familyName":"Xie","name":"Xie, Jine","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zhicheng","familyName":"Zhang","name":"Zhang, Zhicheng","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yunwei","familyName":"Chen","name":"Chen, Yunwei","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yanqiu","familyName":"Feng","name":"Feng, Yanqiu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xinyuan","familyName":"Zhang","name":"Zhang, Xinyuan","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Unsupervised Denoising of Diffusion-Weighted Images with Bias and Variance Corrected Noise Modeling"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Quantitative Methods (q-bio.QM)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"Image and Video Processing (eess.IV)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Biological sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Biological sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"FOS: Electrical engineering, electronic engineering, information engineering","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Electrical engineering, electronic engineering, information engineering","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-22T04:32:21Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:00:38Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Diffusion magnetic resonance imaging (dMRI) plays a vital role in both clinical diagnostics and neuroscience research. However, its inherently low signal-to-noise ratio (SNR), especially under high diffusion weighting, significantly degrades image quality and impairs downstream analysis. Recent self-supervised and unsupervised denoising methods offer a practical solution by enhancing image quality without requiring clean references. However, most of these methods do not explicitly account for the non-Gaussian noise characteristics commonly present in dMRI magnitude data during the supervised learning process, potentially leading to systematic bias and heteroscedastic variance, particularly under low-SNR conditions. To overcome this limitation, we introduce noise-corrected training objectives that explicitly model Rician statistics. Specifically, we propose two alternative loss functions: one derived from the first-order moment to remove mean bias, and another from the second-order moment to correct squared-signal bias. Both losses include adaptive weighting to account for variance heterogeneity and can be used without changing the network architecture. These objectives are instantiated in an image-specific, unsupervised Deep Image Prior (DIP) framework. Comprehensive experiments on simulated and in-vivo dMRI show that the proposed losses effectively reduce Rician bias and suppress noise fluctuations, yielding higher image quality and more reliable diffusion metrics than state-of-the-art denoising baselines. These results underscore the importance of bias- and variance-aware noise modeling for robust dMRI analysis under low-SNR conditions."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.22235","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T02:41:41Z","registered":"2026-02-27T02:41:41Z","published":null,"updated":"2026-02-27T02:41:41Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.22231","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.22231","identifiers":[{"identifier":"2602.22231","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Dong","familyName":"Yang","name":"Yang, Dong","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yue","familyName":"Wang","name":"Wang, Yue","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Songyang","familyName":"Zhang","name":"Zhang, Songyang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yingshu","familyName":"Li","name":"Li, Yingshu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zhipeng","familyName":"Cai","name":"Cai, Zhipeng","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zhi","familyName":"Tian","name":"Tian, Zhi","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"FM-RME: Foundation Model Empowered Radio Map Estimation"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Signal Processing (eess.SP)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Electrical engineering, electronic engineering, information engineering","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Electrical engineering, electronic engineering, information engineering","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-15T01:37:11Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:00:34Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Traditional radio map estimation (RME) techniques fail to capture multi-dimensional and dynamic characteristics of complex spectrum environments. Recent data-driven methods achieve accurate RME in spatial domain, but ignore physical prior knowledge of radio propagation, limiting data efficiency especially in multi-dimensional scenarios. To overcome such limitations, we propose a new foundation model, characterized by self-supervised pre-training on diverse data for zero-shot generalization, enabling multi-dimensional radio map estimation (FM-RME). Specifically, FM-RME builds an effective synergy of two core components: a geometry-aware feature extraction module that encodes physical propagation symmetries, i.e., translation and rotation invariance, as inductive bias, and an attention-based neural network that learns long-range correlations across the spatial-temporal-spectral domains. A masked self-supervised multi-dimensional pre-training strategy is further developed to learn generalizable spectrum representations across diverse wireless environments. Once pre-trained, FM-RME supports zero-shot inference for multi-dimensional RME, including spatial, temporal, and spectral estimation, without scenario-specific retraining. Simulation results verify that FM-RME exhibits desired learning performance across diverse datasets and zero-shot generalization capabilities beyond existing RME methods."},{"descriptionType":"Other","description":"7 pages, 5 figures, conference"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.22231","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T02:41:35Z","registered":"2026-02-27T02:41:36Z","published":null,"updated":"2026-02-27T02:41:36Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.22228","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.22228","identifiers":[{"identifier":"2602.22228","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Jiyeong","familyName":"Kim","name":"Kim, Jiyeong","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Stephen P.","familyName":"Ma","name":"Ma, Stephen P.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Nirali","familyName":"Vora","name":"Vora, Nirali","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Nicholas W.","familyName":"Larsen","name":"Larsen, Nicholas W.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Julia","familyName":"Adler-Milstein","name":"Adler-Milstein, Julia","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jonathan H.","familyName":"Chen","name":"Chen, Jonathan H.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Selen","familyName":"Bozkurt","name":"Bozkurt, Selen","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Abeed","familyName":"Sarker","name":"Sarker, Abeed","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Juhee","familyName":"Cho","name":"Cho, Juhee","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jindeok","familyName":"Joo","name":"Joo, Jindeok","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Natali","familyName":"Pageler","name":"Pageler, Natali","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Fatima","familyName":"Rodriguez","name":"Rodriguez, Fatima","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Christopher","familyName":"Sharp","name":"Sharp, Christopher","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Eleni","familyName":"Linos","name":"Linos, Eleni","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Patient-Centered, Graph-Augmented Artificial Intelligence-Enabled Passive Surveillance for Early Stroke Risk Detection in High-Risk Individuals"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-07T21:34:56Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:00:30Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by-nc-sa/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution Non Commercial Share Alike 4.0 International","rightsIdentifier":"cc-by-nc-sa-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Stroke affected millions annually, yet poor symptom recognition often delayed care-seeking. To address risk recognition gap, we developed a passive surveillance system for early stroke risk detection using patient-reported symptoms among individuals with diabetes. Constructing a symptom taxonomy grounded in patients own language and a dual machine learning pipeline (heterogeneous GNN and EN/LASSO), we identified symptom patterns associated with subsequent stroke. We translated findings into a hybrid risk screening system integrating symptom relevance and temporal proximity, evaluated across 3-90 day windows through EHR-based simulations. Under conservative thresholds, intentionally designed to minimize false alerts, the screening system achieved high specificity (1.00) and prevalence-adjusted positive predictive value (1.00), with good sensitivity (0.72), an expected trade-off prioritizing precision, that was highest in 90-day window. Patient-reported language alone supported high-precision, low-burden early stroke risk detection, that could offer a valuable time window for clinical evaluation and intervention for high-risk individuals."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.22228","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T02:41:31Z","registered":"2026-02-27T02:41:32Z","published":null,"updated":"2026-02-27T02:41:32Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.22226","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.22226","identifiers":[{"identifier":"2602.22226","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Yulong","familyName":"Gao","name":"Gao, Yulong","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Wan","familyName":"Jiang","name":"Jiang, Wan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Mingzhe","familyName":"Cao","name":"Cao, Mingzhe","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xuepu","familyName":"Wang","name":"Wang, Xuepu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zeyu","familyName":"Pan","name":"Pan, Zeyu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Haonan","familyName":"Yang","name":"Yang, Haonan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ye","familyName":"Liu","name":"Liu, Ye","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xin","familyName":"Yang","name":"Yang, Xin","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"SEGB: Self-Evolved Generative Bidding with Local Autoregressive Diffusion"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Information Retrieval (cs.IR)","lang":"en","subjectScheme":"arXiv"},{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-12-31T09:05:59Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:00:26Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"In the realm of online advertising, automated bidding has become a pivotal tool, enabling advertisers to efficiently capture impression opportunities in real-time. Recently, generative auto-bidding has shown significant promise, offering innovative solutions for effective ad optimization. However, existing offline-trained generative policies lack the near-term foresight required for dynamic markets and usually depend on simulators or external experts for post-training improvement. To overcome these critical limitations, we propose Self-Evolved Generative Bidding (SEGB), a framework that plans proactively and refines itself entirely offline. SEGB first synthesizes plausible short-horizon future states to guide each bid, providing the agent with crucial, dynamic foresight. Crucially, it then performs value-guided policy refinement to iteratively discover superior strategies without any external intervention. This self-contained approach uniquely enables robust policy improvement from static data alone. Experiments on the AuctionNet benchmark and a large-scale A/B test validate our approach, demonstrating that SEGB significantly outperforms state-of-the-art baselines. In a large-scale online deployment, it delivered substantial business value, achieving a +10.19% increase in target cost, proving the effectiveness of our advanced planning and evolution paradigm."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.22226","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T02:41:28Z","registered":"2026-02-27T02:41:29Z","published":null,"updated":"2026-02-27T02:41:29Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.22225","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.22225","identifiers":[{"identifier":"2602.22225","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Xuechen","familyName":"Zhang","name":"Zhang, Xuechen","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Koustava","familyName":"Goswami","name":"Goswami, Koustava","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Samet","familyName":"Oymak","name":"Oymak, Samet","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jiasi","familyName":"Chen","name":"Chen, Jiasi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Nedim","familyName":"Lipka","name":"Lipka, Nedim","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"SmartChunk Retrieval: Query-Aware Chunk Compression with Planning for Efficient Document RAG"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Information Retrieval (cs.IR)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-12-17T01:21:44Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:00:24Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by-nc-sa/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution Non Commercial Share Alike 4.0 International","rightsIdentifier":"cc-by-nc-sa-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Retrieval-augmented generation (RAG) has strong potential for producing accurate and factual outputs by combining language models (LMs) with evidence retrieved from large text corpora. However, current pipelines are limited by static chunking and flat retrieval: documents are split into short, predetermined, fixed-size chunks, embeddings are retrieved uniformly, and generation relies on whatever chunks are returned. This design brings challenges, as retrieval quality is highly sensitive to chunk size, often introduces noise from irrelevant or misleading chunks, and scales poorly to large corpora. We present SmartChunk retrieval, a query-adaptive framework for efficient and robust long-document question answering (QA). SmartChunk uses (i) a planner that predicts the optimal chunk abstraction level for each query, and (ii) a lightweight compression module that produces high-level chunk embeddings without repeated summarization. By adapting retrieval granularity on the fly, SmartChunk balances accuracy with efficiency and avoids the drawbacks of fixed strategies. Notably, our planner can reason about chunk abstractions through a novel reinforcement learning scheme, STITCH, which boosts accuracy and generalization. To reflect real-world applications, where users face diverse document types and query styles, we evaluate SmartChunk on five QA benchmarks plus one out-of-domain dataset. Across these evaluations, SmartChunk outperforms state-of-the-art RAG baselines, while reducing cost. Further analysis demonstrates strong scalability with larger corpora and consistent gains on out-of-domain datasets, highlighting its effectiveness as a general framework for adaptive retrieval."},{"descriptionType":"Other","description":"26 pages, 10 figures"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.22225","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T02:41:27Z","registered":"2026-02-27T02:41:28Z","published":null,"updated":"2026-02-27T02:41:28Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.22224","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.22224","identifiers":[{"identifier":"2602.22224","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Jinjian","familyName":"Liu","name":"Liu, Jinjian","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yichuan","familyName":"Wang","name":"Wang, Yichuan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xinxi","familyName":"Lyu","name":"Lyu, Xinxi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Rulin","familyName":"Shao","name":"Shao, Rulin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Joseph E.","familyName":"Gonzalez","name":"Gonzalez, Joseph E.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Matei","familyName":"Zaharia","name":"Zaharia, Matei","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Sewon","familyName":"Min","name":"Min, Sewon","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"DS SERVE: A Framework for Efficient and Scalable Neural Retrieval"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Information Retrieval (cs.IR)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-12-17T00:43:10Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:00:23Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"We present DS-Serve, a framework that transforms large-scale text datasets, comprising half a trillion tokens, into a high-performance neural retrieval system. DS-Serve offers both a web interface and API endpoints, achieving low latency with modest memory overhead on a single node. The framework also supports inference-time trade-offs between latency, accuracy, and result diversity. We anticipate that DS-Serve will be broadly useful for a range of applications, including large-scale retrieval-augmented generation (RAG), training data attribution, training search agents, and beyond."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.22224","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T02:41:26Z","registered":"2026-02-27T02:41:26Z","published":null,"updated":"2026-02-27T02:41:26Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.22223","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.22223","identifiers":[{"identifier":"2602.22223","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Cornelius","familyName":"Wolff","name":"Wolff, Cornelius","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Daniel","familyName":"Gomm","name":"Gomm, Daniel","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Madelon","familyName":"Hulsebos","name":"Hulsebos, Madelon","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"SQaLe: A Large Text-to-SQL Corpus Grounded in Real Schemas"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Information Retrieval (cs.IR)","lang":"en","subjectScheme":"arXiv"},{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-12-16T09:15:10Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:00:22Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by-sa/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution Share Alike 4.0 International","rightsIdentifier":"cc-by-sa-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Advances in large language models have accelerated progress in text-to-SQL, methods for converting natural language queries into valid SQL queries. A key bottleneck for developing generalizable text-to-SQL models is the lack of large-scale datasets with sufficient schema and query complexity, domain coverage, and task diversity. We introduce SQaLe: a large-scale semi-synthetic text-to-SQL dataset built on 135,875 relational database schemas expanded from a collection of real-world schemas, SchemaPile. We establish a principled generation pipeline which combines schema sampling, question synthesis, and SQL construction, and produce 517,676 high-quality (question, schema, query) triples. The SQaLe dataset captures realistic schema size variability, diverse query patterns, and natural language ambiguity while maintaining execution validity. We provide an analysis of its contents and characteristics, and find that SQaLe introduces the most realistic large-scale text-to-SQL dataset to date in comparison with existing benchmarks and datasets. We discuss how SQaLe enables our vision for data scaling and model generalization in text-to-SQL research. The dataset is accessible at: https://huggingface.co/datasets/trl-lab/SQaLe-text-to-SQL-dataset."},{"descriptionType":"Other","description":"Accepted at the AI for Tabular Data workshop at EurIPS 2025"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.22223","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T02:41:24Z","registered":"2026-02-27T02:41:25Z","published":null,"updated":"2026-02-27T02:41:25Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.22219","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.22219","identifiers":[{"identifier":"2602.22219","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Teri","familyName":"Rumble","name":"Rumble, Teri","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zbyněk","familyName":"Gazdík","name":"Gazdík, Zbyněk","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Javad","familyName":"Zarrin","name":"Zarrin, Javad","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jagdeep","familyName":"Ahluwalia","name":"Ahluwalia, Jagdeep","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Comparative Analysis of Neural Retriever-Reranker Pipelines for Retrieval-Augmented Generation over Knowledge Graphs in E-commerce Applications"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Information Retrieval (cs.IR)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-12-14T23:47:40Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:00:15Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Recent advancements in Large Language Models (LLMs) have transformed Natural Language Processing (NLP), enabling complex information retrieval and generation tasks. Retrieval-Augmented Generation (RAG) has emerged as a key innovation, enhancing factual accuracy and contextual grounding by integrating external knowledge sources with generative models. Although RAG demonstrates strong performance on unstructured text, its application to structured knowledge graphs presents challenges: scaling retrieval across connected graphs and preserving contextual relationships during response generation. Cross-encoders refine retrieval precision, yet their integration with structured data remains underexplored. Addressing these challenges is crucial for developing domain-specific assistants that operate in production environments. This study presents the design and comparative evaluation of multiple Retriever-Reranker pipelines for knowledge graph natural language queries in e-Commerce contexts. Using the STaRK Semi-structured Knowledge Base (SKB), a production-scale e-Commerce dataset, we evaluate multiple RAG pipeline configurations optimized for language queries. Experimental results demonstrate substantial improvements over published benchmarks, achieving 20.4% higher Hit@1 and 14.5% higher Mean Reciprocal Rank (MRR). These findings establish a practical framework for integrating domain-specific SKBs into generative systems. Our contributions provide actionable insights for the deployment of production-ready RAG systems, with implications that extend beyond e-Commerce to other domains that require information retrieval from structured knowledge bases."},{"descriptionType":"Other","description":"This manuscript is under review at the Springer journal Knowledge and Information Systems"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.22219","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T02:41:18Z","registered":"2026-02-27T02:41:19Z","published":null,"updated":"2026-02-27T02:41:19Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.22217","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.22217","identifiers":[{"identifier":"2602.22217","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Ahmed Bin","familyName":"Khalid","name":"Khalid, Ahmed Bin","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"RAGdb: A Zero-Dependency, Embeddable Architecture for Multimodal Retrieval-Augmented Generation on the Edge"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Information Retrieval (cs.IR)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-12-09T15:12:13Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:00:12Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Retrieval-Augmented Generation (RAG) has established itself as the standard paradigm for grounding Large Language Models (LLMs) in domain-specific, up-to-date data. However, the prevailing architecture for RAG has evolved into a complex, distributed stack requiring cloud-hosted vector databases, heavy deep learning frameworks (e.g., PyTorch, CUDA), and high-latency embedding inference servers. This ``infrastructure bloat'' creates a significant barrier to entry for edge computing, air-gapped environments, and privacy-constrained applications where data sovereignty is paramount.\n This paper introduces RAGdb, a novel monolithic architecture that consolidates automated multimodal ingestion, ONNX-based extraction, and hybrid vector retrieval into a single, portable SQLite container. We propose a deterministic Hybrid Scoring Function (HSF) that combines sublinear TF-IDF vectorization with exact substring boosting, eliminating the need for GPU inference at query time. Experimental evaluation on an Intel i7-1165G7 consumer laptop demonstrates that RAGdb achieves 100\\% Recall@1 for entity retrieval and an ingestion efficiency gain of 31.6x during incremental updates compared to cold starts. Furthermore, the system reduces disk footprint by approximately 99.5\\% compared to standard Docker-based RAG stacks, establishing the ``Single-File Knowledge Container'' as a viable primitive for decentralized, local-first AI.\n Keywords: Edge AI, Retrieval-Augmented Generation, Vector Search, Green AI, Serverless Architecture, Knowledge Graphs, Efficient Computing."},{"descriptionType":"Other","description":"6 pages, 2 tables"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.22217","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T02:41:16Z","registered":"2026-02-27T02:41:16Z","published":null,"updated":"2026-02-27T02:41:16Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.22215","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.22215","identifiers":[{"identifier":"2602.22215","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Pengzhen","familyName":"Xie","name":"Xie, Pengzhen","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Huizhi","familyName":"Liang","name":"Liang, Huizhi","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Graph Your Way to Inspiration: Integrating Co-Author Graphs with Retrieval-Augmented Generation for Large Language Model Based Scientific Idea Generation"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"Information Retrieval (cs.IR)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"I.2.6, I.2.7","lang":"en","subjectScheme":"MSC"}],"contributors":[],"dates":[{"date":"2025-12-05T03:38:23Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:00:07Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Large Language Models (LLMs) demonstrate potential in the field of scientific idea generation. However, the generated results often lack controllable academic context and traceable inspiration pathways. To bridge this gap, this paper proposes a scientific idea generation system called GYWI, which combines author knowledge graphs with retrieval-augmented generation (RAG) to form an external knowledge base to provide controllable context and trace of inspiration path for LLMs to generate new scientific ideas. We first propose an author-centered knowledge graph construction method and inspiration source sampling algorithms to construct external knowledge base. Then, we propose a hybrid retrieval mechanism that is composed of both RAG and GraphRAG to retrieve content with both depth and breadth knowledge. It forms a hybrid context. Thirdly, we propose a Prompt optimization strategy incorporating reinforcement learning principles to automatically guide LLMs optimizing the results based on the hybrid context. To evaluate the proposed approaches, we constructed an evaluation dataset based on arXiv (2018-2023). This paper also develops a comprehensive evaluation method including empirical automatic assessment in multiple-choice question task, LLM-based scoring, human evaluation, and semantic space visualization analysis. The generated ideas are evaluated from the following five dimensions: novelty, feasibility, clarity, relevance, and significance. We conducted experiments on different LLMs including GPT-4o, DeepSeek-V3, Qwen3-8B, and Gemini 2.5. Experimental results show that GYWI significantly outperforms mainstream LLMs in multiple metrics such as novelty, reliability, and relevance."},{"descriptionType":"Other","description":"15 pages, 10 figures. Submitted to [RAAI]"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.22215","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T02:41:13Z","registered":"2026-02-27T02:41:13Z","published":null,"updated":"2026-02-27T02:41:14Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.22213","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.22213","identifiers":[{"identifier":"2602.22213","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Zeinab","familyName":"Ghamlouch","name":"Ghamlouch, Zeinab","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Mehwish","familyName":"Alam","name":"Alam, Mehwish","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Enriching Taxonomies Using Large Language Models"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Information Retrieval (cs.IR)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-11-21T10:25:59Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:00:04Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[{"relationType":"IsVersionOf","relatedIdentifier":"10.3233/faia251441","relatedIdentifierType":"DOI"}],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Taxonomies play a vital role in structuring and categorizing information across domains. However, many existing taxonomies suffer from limited coverage and outdated or ambiguous nodes, reducing their effectiveness in knowledge retrieval. To address this, we present Taxoria, a novel taxonomy enrichment pipeline that leverages Large Language Models (LLMs) to enhance a given taxonomy. Unlike approaches that extract internal LLM taxonomies, Taxoria uses an existing taxonomy as a seed and prompts an LLM to propose candidate nodes for enrichment. These candidates are then validated to mitigate hallucinations and ensure semantic relevance before integration. The final output includes an enriched taxonomy with provenance tracking and visualization of the final merged taxonomy for analysis."},{"descriptionType":"Other","description":"Published in ECAI 2025 Demo Track"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.22213","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":1,"created":"2026-02-27T02:41:10Z","registered":"2026-02-27T02:41:11Z","published":null,"updated":"2026-02-27T02:41:11Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}}],"meta":{"total":420,"totalPages":1,"page":1},"links":{"self":"https://api.datacite.org/dois?query=doi%3A10.48550%2Farxiv.2602*%20AND%20registered%3A%5B2026-02-27T01%3A00%3A00Z%20TO%202026-02-28T01%3A00%3A00Z%5D%20AND%20(language%20OR%20LLM%20OR%20transformer%20OR%20MoE%20OR%20inference%20OR%20training%20OR%20reinforcement%20OR%20distillation)\u0026page[size]=1000"}}