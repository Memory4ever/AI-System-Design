            <span class="ltx_tag ltx_tag_listingline"><span id="alg1.l8.1" class="ltx_text" style="font-size:80%;">8:</span></span>
            
            
             <math id="alg1.l8.m1" class="ltx_Math" alttext="d_{i}:=S(\ell_{i},r)" display="inline" intent=":literal"><semantics><mrow><msub><mi>d</mi><mi>i</mi></msub><mo>:=</mo><mrow><mi>S</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi mathvariant="normal">ℓ</mi><mi>i</mi></msub><mo>,</mo><mi>r</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">d_{i}:=S(\ell_{i},r)</annotation></semantics></math>

</div>
