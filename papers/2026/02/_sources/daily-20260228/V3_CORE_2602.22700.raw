            <math id="alg1.l11.m1" class="ltx_Math" alttext="\vec{y},T:=D(\left\{d_{1},\cdots,d_{N}\right\})" display="inline" intent=":literal"><semantics><mrow><mover accent="true"><mi>y</mi><mo stretchy="false">→</mo></mover><mo>,</mo><mrow><mi>T</mi><mo>:=</mo><mrow><mi>D</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mo>{</mo><msub><mi>d</mi><mn>1</mn></msub><mo>,</mo><mo lspace="0em" rspace="0em">⋯</mo><mo>,</mo><msub><mi>d</mi><mi>N</mi></msub><mo>}</mo></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\vec{y},T:=D(\left\{d_{1},\cdots,d_{N}\right\})</annotation></semantics></math>

</div>
