            <span class="ltx_tag ltx_tag_listingline"><span id="alg1.l9.1" class="ltx_text" style="font-size:80%;">9:</span></span>
            
            
             <math id="alg1.l9.m1" class="ltx_Math" alttext="h_{i}\leftarrow G_{\theta}(\tilde{h}_{i},d_{i})" display="inline" intent=":literal"><semantics><mrow><msub><mi>h</mi><mi>i</mi></msub><mo stretchy="false">←</mo><mrow><msub><mi>G</mi><mi>θ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi>h</mi><mo>~</mo></mover><mi>i</mi></msub><mo>,</mo><msub><mi>d</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">h_{i}\leftarrow G_{\theta}(\tilde{h}_{i},d_{i})</annotation></semantics></math>

