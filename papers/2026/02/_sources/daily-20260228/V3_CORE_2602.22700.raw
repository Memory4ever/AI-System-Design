Private input: model <math id="alg3.l0.m6" class="ltx_Math" alttext="\mathcal{M}_{\theta^{\star}}=(E_{\theta^{\star}},F_{\theta^{\star}},S,G_{\theta^{\star}},D)" display="inline" intent=":literal"><semantics><mrow><msub><mi class="ltx_font_mathcaligraphic">ℳ</mi><msup><mi>θ</mi><mo>⋆</mo></msup></msub><mo>=</mo><mrow><mo stretchy="false">(</mo><msub><mi>E</mi><msup><mi>θ</mi><mo>⋆</mo></msup></msub><mo>,</mo><msub><mi>F</mi><msup><mi>θ</mi><mo>⋆</mo></msup></msub><mo>,</mo><mi>S</mi><mo>,</mo><msub><mi>G</mi><msup><mi>θ</mi><mo>⋆</mo></msup></msub><mo>,</mo><mi>D</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathcal{M}_{\theta^{\star}}=(E_{\theta^{\star}},F_{\theta^{\star}},S,G_{\theta^{\star}},D)</annotation></semantics></math>, seed <math id="alg3.l0.m7" class="ltx_Math" alttext="r" display="inline" intent=":literal"><semantics><mi>r</mi><annotation encoding="application/x-tex">r</annotation></semantics></math>, logits <math id="alg3.l0.m8" class="ltx_Math" alttext="\left\{\ell_{1},\cdots,\ell_{N}\right\}" display="inline" intent=":literal"><semantics><mrow><mo>{</mo><msub><mi mathvariant="normal">ℓ</mi><mn>1</mn></msub><mo>,</mo><mo lspace="0em" rspace="0em">⋯</mo><mo>,</mo><msub><mi mathvariant="normal">ℓ</mi><mi>N</mi></msub><mo>}</mo></mrow><annotation encoding="application/x-tex">\left\{\ell_{1},\cdots,\ell_{N}\right\}</annotation></semantics></math>.

