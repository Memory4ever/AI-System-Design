            <span id="alg2.l4.3" class="ltx_text ltx_font_bold">send</span> <math id="alg2.l4.m1" class="ltx_Math" alttext="\left\langle\mathsf{Audit}\right\rangle" display="inline" intent=":literal"><semantics><mrow><mo>⟨</mo><mi>𝖠𝗎𝖽𝗂𝗍</mi><mo>⟩</mo></mrow><annotation encoding="application/x-tex">\left\langle\mathsf{Audit}\right\rangle</annotation></semantics></math> to <math id="alg2.l4.m2" class="ltx_Math" alttext="\mathsf{Srv}" display="inline" intent=":literal"><semantics><mi>𝖲𝗋𝗏</mi><annotation encoding="application/x-tex">\mathsf{Srv}</annotation></semantics></math>.

