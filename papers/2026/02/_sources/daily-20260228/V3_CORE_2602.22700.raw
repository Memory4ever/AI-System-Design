             <math id="alg1.l16.m1" class="ltx_Math" alttext="\phi,\pi:=\mathsf{VC}.\mathsf{prove}\left((\psi_{M},\psi,\vec{x},\vec{y},T);w\right)" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mi>ϕ</mi><mo>,</mo><mi>π</mi></mrow><mo>:=</mo><mi>𝖵𝖢</mi></mrow><mo lspace="0em" rspace="0.167em">.</mo><mrow><mi>𝗉𝗋𝗈𝗏𝖾</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mo stretchy="false">(</mo><msub><mi>ψ</mi><mi>M</mi></msub><mo>,</mo><mi>ψ</mi><mo>,</mo><mover accent="true"><mi>x</mi><mo stretchy="false">→</mo></mover><mo>,</mo><mover accent="true"><mi>y</mi><mo stretchy="false">→</mo></mover><mo>,</mo><mi>T</mi><mo stretchy="false">)</mo></mrow><mo>,</mo><mi>w</mi><mo>)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\phi,\pi:=\mathsf{VC}.\mathsf{prove}\left((\psi_{M},\psi,\vec{x},\vec{y},T);w\right)</annotation></semantics></math>

</div>
