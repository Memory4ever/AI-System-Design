             <math id="alg1.l7.m1" class="ltx_Math" alttext="\tilde{h}_{i},\ell_{i}\leftarrow F_{\theta}(h_{i-1})" display="inline" intent=":literal"><semantics><mrow><msub><mover accent="true"><mi>h</mi><mo>~</mo></mover><mi>i</mi></msub><mo>,</mo><mrow><msub><mi mathvariant="normal">ℓ</mi><mi>i</mi></msub><mo stretchy="false">←</mo><mrow><msub><mi>F</mi><mi>θ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>h</mi><mrow><mi>i</mi><mo>−</mo><mn>1</mn></mrow></msub><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\tilde{h}_{i},\ell_{i}\leftarrow F_{\theta}(h_{i-1})</annotation></semantics></math>

