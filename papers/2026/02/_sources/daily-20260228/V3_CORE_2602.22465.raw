<tr id="S5.T4.2.1.5" class="ltx_tr">
<th id="S5.T4.2.1.5.1" class="ltx_td ltx_align_left ltx_th ltx_th_row">Claude Opus 4.6</th>
<td id="S5.T4.2.1.5.2" class="ltx_td ltx_align_right">85.0</td>
<td id="S5.T4.2.1.5.3" class="ltx_td ltx_align_right">90.0</td>
