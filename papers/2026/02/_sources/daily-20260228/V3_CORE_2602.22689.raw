<tr id="A1.T15.2.1.5" class="ltx_tr">
<td id="A1.T15.2.1.5.1" class="ltx_td ltx_align_left ltx_border_bb">Keypoint</td>
<td id="A1.T15.2.1.5.2" class="ltx_td ltx_align_center ltx_border_bb">500.00</td>
