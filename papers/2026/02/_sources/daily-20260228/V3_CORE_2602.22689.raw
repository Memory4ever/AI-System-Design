<td id="A1.T6.2.1.3.3" class="ltx_td ltx_align_center ltx_border_t">55.02</td>
<td id="A1.T6.2.1.3.4" class="ltx_td ltx_align_center ltx_border_t">50.72</td>
<td id="A1.T6.2.1.3.5" class="ltx_td ltx_align_center ltx_border_t">1.60</td></tr>
