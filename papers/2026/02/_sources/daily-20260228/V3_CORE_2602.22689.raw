<td id="A1.T6.2.1.7.1" class="ltx_td ltx_align_left">CLiD</td>
<td id="A1.T6.2.1.7.2" class="ltx_td ltx_align_center">56.90</td>
<td id="A1.T6.2.1.7.3" class="ltx_td ltx_align_center">58.62</td>
<td id="A1.T6.2.1.7.4" class="ltx_td ltx_align_center">4.60</td></tr>
