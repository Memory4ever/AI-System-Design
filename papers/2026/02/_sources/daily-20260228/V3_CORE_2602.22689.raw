<td id="A1.T12.2.1.7.3" class="ltx_td ltx_align_center"><span id="A1.T12.2.1.7.3.1" class="ltx_text ltx_underline">50.22</span></td>
<td id="A1.T12.2.1.7.4" class="ltx_td ltx_align_center"><span id="A1.T12.2.1.7.4.1" class="ltx_text ltx_underline">1.00</span></td></tr>
