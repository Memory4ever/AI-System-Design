<td id="A1.T6.2.1.8.1" class="ltx_td ltx_align_left ltx_border_bb ltx_border_t">CLiD</td>
<td id="A1.T6.2.1.8.2" class="ltx_td ltx_align_center ltx_border_bb ltx_border_t">VLM</td>
<td id="A1.T6.2.1.8.3" class="ltx_td ltx_align_center ltx_border_bb ltx_border_t">53.80</td>
