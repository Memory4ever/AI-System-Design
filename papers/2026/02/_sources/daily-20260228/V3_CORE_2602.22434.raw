<th id="S3.T1.5.2.3" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_t" style="padding-left:4.0pt;padding-right:4.0pt;"><span id="S3.T1.5.2.3.1" class="ltx_text ltx_font_bold" style="font-size:90%;">Batch 32</span></th>
<th id="S3.T1.5.2.4" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_t" style="padding-left:4.0pt;padding-right:4.0pt;"><span id="S3.T1.5.2.4.1" class="ltx_text ltx_font_bold" style="font-size:90%;">Batch 64</span></th>
<th id="S3.T1.5.2.5" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_t" style="padding-left:4.0pt;padding-right:4.0pt;"><span id="S3.T1.5.2.5.1" class="ltx_text ltx_font_bold" style="font-size:90%;">Batch 128</span></th></tr>
</thead>
<tbody class="ltx_tbody">
<tr id="S3.T1.5.3" class="ltx_tr">
<th id="S3.T1.5.3.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_t" style="padding-left:4.0pt;padding-right:4.0pt;"><span id="S3.T1.5.3.1.1" class="ltx_text" style="font-size:90%;">10 KiB</span></th>
<td id="S3.T1.5.3.2" class="ltx_td ltx_align_center ltx_border_t" style="padding-left:4.0pt;padding-right:4.0pt;"><span id="S3.T1.5.3.2.1" class="ltx_text" style="font-size:90%;">0.5</span></td>
<td id="S3.T1.5.3.3" class="ltx_td ltx_align_center ltx_border_t" style="padding-left:4.0pt;padding-right:4.0pt;"><span id="S3.T1.5.3.3.1" class="ltx_text" style="font-size:90%;">4.5 (9<math id="S3.T1.m1" class="ltx_Math" alttext="\times" display="inline" intent=":literal"><semantics><mo>×</mo><annotation encoding="application/x-tex">\times</annotation></semantics></math>)</span></td>
<td id="S3.T1.5.3.4" class="ltx_td ltx_align_center ltx_border_t" style="padding-left:4.0pt;padding-right:4.0pt;"><span id="S3.T1.5.3.4.1" class="ltx_text" style="font-size:90%;">6.0 (12<math id="S3.T1.m2" class="ltx_Math" alttext="\times" display="inline" intent=":literal"><semantics><mo>×</mo><annotation encoding="application/x-tex">\times</annotation></semantics></math>)</span></td>
