<td id="S2.T3.5.1.2.6" class="ltx_td ltx_align_center"><math id="S2.T3.m3" class="ltx_Math" alttext="4\times 4" display="inline" intent=":literal"><semantics><mrow><mn>4</mn><mo lspace="0.222em" rspace="0.222em">×</mo><mn>4</mn></mrow><annotation encoding="application/x-tex">4\times 4</annotation></semantics></math></td>
<td id="S2.T3.5.1.2.7" class="ltx_td ltx_align_center"><math id="S2.T3.m4" class="ltx_Math" alttext="4\times 16" display="inline" intent=":literal"><semantics><mrow><mn>4</mn><mo lspace="0.222em" rspace="0.222em">×</mo><mn>16</mn></mrow><annotation encoding="application/x-tex">4\times 16</annotation></semantics></math></td>
