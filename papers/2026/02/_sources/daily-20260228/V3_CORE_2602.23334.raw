<tr id="S2.T3.5.1.3" class="ltx_tr">
<td id="S2.T3.5.1.3.1" class="ltx_td ltx_align_center ltx_border_t">Guo et al. <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib19" title="" class="ltx_ref">6</a>]</cite></td>
<td id="S2.T3.5.1.3.2" class="ltx_td ltx_align_center ltx_border_t">FPGA</td>
