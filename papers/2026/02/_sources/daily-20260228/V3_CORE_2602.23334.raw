<td id="S2.T3.5.1.10.15" class="ltx_td ltx_align_center ltx_border_bb ltx_border_t"><math id="S2.T3.m106" class="ltx_Math" alttext="\times" display="inline" intent=":literal"><semantics><mo>×</mo><annotation encoding="application/x-tex">\times</annotation></semantics></math></td>
<td id="S2.T3.5.1.10.16" class="ltx_td ltx_align_center ltx_border_bb ltx_border_t"><math id="S2.T3.m107" class="ltx_Math" alttext="\times" display="inline" intent=":literal"><semantics><mo>×</mo><annotation encoding="application/x-tex">\times</annotation></semantics></math></td></tr>
