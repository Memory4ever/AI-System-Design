<td id="S2.T3.5.1.10.12" class="ltx_td ltx_align_center ltx_border_bb ltx_border_t"><math id="S2.T3.m103" class="ltx_Math" alttext="\times" display="inline" intent=":literal"><semantics><mo>×</mo><annotation encoding="application/x-tex">\times</annotation></semantics></math></td>
<td id="S2.T3.5.1.10.13" class="ltx_td ltx_align_center ltx_border_bb ltx_border_t"><math id="S2.T3.m104" class="ltx_Math" alttext="\times" display="inline" intent=":literal"><semantics><mo>×</mo><annotation encoding="application/x-tex">\times</annotation></semantics></math></td>
