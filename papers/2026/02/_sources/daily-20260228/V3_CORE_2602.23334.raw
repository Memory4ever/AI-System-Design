<td id="S2.T3.5.1.2.4" class="ltx_td ltx_align_center"><math id="S2.T3.m1" class="ltx_Math" alttext="1\times 1" display="inline" intent=":literal"><semantics><mrow><mn>1</mn><mo lspace="0.222em" rspace="0.222em">×</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">1\times 1</annotation></semantics></math></td>
