</div>
<div id="algorithm3.3.5" class="ltx_listingline"> <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span>  <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span> receive (data, failure information) from <math id="algorithm3.m3" class="ltx_Math" alttext="c" display="inline" intent=":literal"><semantics><mi>c</mi><annotation encoding="application/x-tex">c</annotation></semantics></math>
</div>
<div id="algorithm3.3.6" class="ltx_listingline"> <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span>  <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span> <span id="algorithm3.3.6.1" class="ltx_text ltx_font_sansserif">data</span> <math id="algorithm3.m4" class="ltx_Math" alttext="\leftarrow" display="inline" intent=":literal"><semantics><mo stretchy="false">←</mo><annotation encoding="application/x-tex">\leftarrow</annotation></semantics></math> basic_reduce_function(<span id="algorithm3.3.6.2" class="ltx_text ltx_font_sansserif">data</span>, received data)
</div>
<div id="algorithm3.3.7" class="ltx_listingline"> <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span>  <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span> update failure information
</div>
<div id="algorithm3.3.8" class="ltx_listingline"> <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span> end for
</div>
<div id="algorithm3.3.9" class="ltx_listingline"> <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span> send (<span id="algorithm3.3.9.1" class="ltx_text ltx_font_sansserif">data</span>, failure information) to parent
</div>
<div id="algorithm3.3.10" class="ltx_listingline">end
</div>
<div id="algorithm3.3.11" class="ltx_listingline">
