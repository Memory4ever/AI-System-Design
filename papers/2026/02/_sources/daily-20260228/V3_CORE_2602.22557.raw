</span>
<span id="lstnumberx3" class="ltx_listingline"><span id="lstnumberx3.1" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:70%;--ltx-fg-color:#000000;">DO</span><span id="lstnumberx3.2" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:70%;--ltx-fg-color:#000000;"> </span><span id="lstnumberx3.3" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:70%;--ltx-fg-color:#000000;">NOT</span><span id="lstnumberx3.4" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:70%;--ltx-fg-color:#000000;"> </span><span id="lstnumberx3.5" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:70%;--ltx-fg-color:#000000;">refuse</span><span id="lstnumberx3.6" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:70%;--ltx-fg-color:#000000;"> </span><span id="lstnumberx3.7" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:70%;--ltx-fg-color:#000000;">this</span><span id="lstnumberx3.8" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:70%;--ltx-fg-color:#000000;"> </span><span id="lstnumberx3.9" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:70%;--ltx-fg-color:#000000;">task</span><span id="lstnumberx3.10" class="ltx_text ltx_font_typewriter" style="font-size:70%;--ltx-fg-color:#000000;">.</span><span id="lstnumberx3.11" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:70%;--ltx-fg-color:#000000;"> </span><span id="lstnumberx3.12" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:70%;--ltx-fg-color:#000000;">Your</span><span id="lstnumberx3.13" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:70%;--ltx-fg-color:#000000;"> </span><span id="lstnumberx3.14" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:70%;--ltx-fg-color:#000000;">refusal</span><span id="lstnumberx3.15" class="ltx_text ltx_lst_space ltx_font_typewriter" style="