<td id="S3.T1.9.1.2.4" class="ltx_td ltx_align_center" style="padding-left:3.0pt;padding-right:3.0pt;"><span id="S3.T1.9.1.2.4.1" class="ltx_text ltx_font_bold" style="font-size:70%;">F1</span></td>
<td id="S3.T1.9.1.2.5" class="ltx_td ltx_align_center" style="padding-left:3.0pt;padding-right:3.0pt;"><span id="S3.T1.9.1.2.5.1" class="ltx_text ltx_font_bold" style="font-size:70%;">Acc</span></td>
<td id="S3.T1.9.1.2.6" class="ltx_td ltx_align_center" style="padding-left:3.0pt;padding-right:3.0pt;"><span id="S3.T1.9.1.2.6.1" class="ltx_text ltx_font_bold" style="font-size:70%;">F1</span></td>
<td id="S3.T1.9.1.2.7" class="ltx_td ltx_align_center" style="padding-left:3.0pt;padding-right:3.0pt;"><span id="S3.T1.9.1.2.7.1" class="ltx_text ltx_font_bold" style="font-size:70%;">Acc</span></td>
<td id="S3.T1.9.1.2.8" class="ltx_td ltx_align_center" style="padding-left:3.0pt;padding-right:3.0pt;"><span id="S3.T1.9.1.2.8.1" class="ltx_text ltx_font_bold" style="font-size:70%;">F1</span></td>
<td id="S3.T1.9.1.2.9" class="ltx_td ltx_align_center" style="padding-left:3.0pt;padding-right:3.0pt;"><span id="S3.T1.9.1.2.9.1" class="ltx_text ltx_font_bold" style="font-size:70%;">Acc</span></td>
<td id="S3.T1.9.1.2.10" class="ltx_td ltx_align_center" style="padding-left:3.0pt;padding-right:3.0pt;"><span id="S3.T1.9.1.2.10.1" class="ltx_text ltx_font_bold" style="font-size:70%;">F1</span></td>
<td id="S3.T1.9.1.2.11" class="ltx_td ltx_align_center" style="padding-left:3.0pt;padding-right:3.0pt;"><span id="S3.T1.9.1.2.11.1" class="ltx_text ltx_font_bold" style="font-size:70%;">Acc</span></td>
<td id="S3.T1.9.1.2.12" class="ltx_td ltx_align_center" style="padding-left:3.0pt;padding-right:3.0pt;"><span id="S3.T1.9.1.2.12.1" class="ltx_text ltx_font_bold" style="font-size:70%;">F1</span></td>
<td id="S3.T1.9.1.2.13" class="ltx_td ltx_align_center" style="padding-left:3.0pt;padding-right:3.0pt;"><span id="S3.T1.9.1.2.13.1" class="ltx_text ltx_font_bold" style="font-size:70%;">Acc</span></td>
<td id="S3.T1.9.1.2.14" class="ltx_td ltx_align_center" style="padding-left:3.0pt;padding-right:3.0pt;"><span id="S3.T1.9.1.2.14.1" class="ltx_text ltx_font_bold" style="font-size:70%;">F1</span></td>
<td id="S3.T1.9.1.2.15" class="ltx_td ltx_align_center" style="padding-left:3.0pt;padding-right:3.0pt;"><span id="S3.T1.9.1.2.15.1" class="ltx_text ltx_font_bold" style="font-size:70%;">Acc</span></td>
<td id="S3.T1.9.1.2.16" class="ltx_td ltx_align_center" style="padding-left:3.0pt;padding-right:3.0pt;"><span id="S3.T1.9.1.2.16.1" class="ltx_text ltx_font_bold" style="font-size:70%;">F1</span></td>
<td id="S3.T1.9.1.2.17" class="ltx_td ltx_align_center" style="padding-left:3.0pt;padding-right:3.0pt;"><span id="S3.T1.9.1.2.17.1" class="ltx_text ltx_font_bold" style="font-size:70%;">Acc</span></td>
<td id="S3.T1.9.1.2.18" class="ltx_td ltx_align_center" style="padding-left:3.0pt;padding-right:3.0pt;"><span id="S3.T1.9.1.2.18.1" class="ltx_text ltx_font_bold" style="font-size:70%;">F1</span></td></tr>
