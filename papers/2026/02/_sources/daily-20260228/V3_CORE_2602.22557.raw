<td id="S3.T1.9.1.1.6" class="ltx_td ltx_align_center ltx_border_tt" style="padding-left:3.0pt;padding-right:3.0pt;" colspan="2"><span id="S3.T1.9.1.1.6.1" class="ltx_text ltx_font_bold" style="font-size:70%;">HarmBench</span></td>
<td id="S3.T1.9.1.1.7" class="ltx_td ltx_align_center ltx_border_tt" style="padding-left:3.0pt;padding-right:3.0pt;" colspan="2"><span id="S3.T1.9.1.1.7.1" class="ltx_text ltx_font_bold" style="font-size:70%;">SafeRLHF</span></td>
<td id="S3.T1.9.1.1.8" class="ltx_td ltx_align_center ltx_border_tt" style="padding-left:3.0pt;padding-right:3.0pt;" colspan="2"><span id="S3.T1.9.1.1.8.1" class="ltx_text ltx_font_bold" style="font-size:70%;">BeaverTails</span></td>
<td id="S3.T1.9.1.1.9" class="ltx_td ltx_align_center ltx_border_tt" style="padding-left:3.0pt;padding-right:3.0pt;" colspan="2"><span id="S3.T1.9.1.1.9.1" class="ltx_text ltx_font_bold" style="font-size:70%;">XSTEST</span></td>
<td id="S3.T1.9.1.1.10" class="ltx_td ltx_align_center ltx_border_tt" style="padding-left:3.0pt;padding-right:3.0pt;" colspan="2"><span id="S3.T1.9.1.1.10.1" class="ltx_text ltx_font_bold" style="font-size:70%;">ToxicChat</span></td></tr>
<tr id="S3.T1.9.1.2" class="ltx_tr">
<td id="S3.T1.9.1.2.1" class="ltx_td ltx_align_center" style="padding-left:3.0pt;padding-right:3.0pt;"><span id="S3.T1.9.1.2.1.1" class="ltx_text ltx_font_bold" style="font-size:70%;">Acc</span></td>
