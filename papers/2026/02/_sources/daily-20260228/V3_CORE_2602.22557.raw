<span id="S3.T2.16.1.2.1" class="ltx_inline-block ltx_align_top" style="width:119.5pt;">
<span id="S3.T2.16.1.2.1.1" class="ltx_p ltx_align_left"><span id="S3.T2.16.1.2.1.1.1" class="ltx_text ltx_font_bold" style="font-size:90%;">Response (excerpt)</span></span>
</span></th>
