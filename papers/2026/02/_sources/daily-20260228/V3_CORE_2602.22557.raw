              <math id="alg1.l11.m1" class="ltx_Math" alttext="a_{t}^{\mathcal{D}}\leftarrow\mathcal{D}(r,\mathcal{C},\mathcal{H})" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>a</mi><mi>t</mi><mi class="ltx_font_mathcaligraphic">𝒟</mi></msubsup><mo stretchy="false">←</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒟</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>r</mi><mo>,</mo><mi class="ltx_font_mathcaligraphic">𝒞</mi><mo>,</mo><mi class="ltx_font_mathcaligraphic">ℋ</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">a_{t}^{\mathcal{D}}\leftarrow\mathcal{D}(r,\mathcal{C},\mathcal{H})</annotation></semantics></math>

</div>
<div id="alg1.l12" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg1.l12.1" class="ltx_text" style="font-size:80%;">12:</span></span>
              
              
              <math id="alg1.l12.m1" class="ltx_Math" alttext="\mathcal{H}\leftarrow\mathcal{H}\cup\{a_{t}^{\mathcal{D}}\}" display="inline" intent=":literal"><semantics><mrow><mi class="ltx_font_mathcaligraphic">ℋ</mi><mo stretchy="false">←</mo><mrow><mi class="ltx_font_mathcaligraphic">ℋ</mi><mo>∪</mo><mrow><mo maxsize="0.900em" minsize="0.900em">{</mo><msubsup><mi>a</mi><mi>t</mi><mi class="ltx_font_mathcaligraphic">𝒟</mi></msubsup><mo maxsize="0.900em" minsize="0.900em">}</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\mathcal{H}\leftarrow\mathcal{H}\cup\{a_{t}^{\mathcal{D}}\}</annotation></semantics></math>

</div>
