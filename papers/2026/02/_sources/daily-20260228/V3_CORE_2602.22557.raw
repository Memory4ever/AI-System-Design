</section>
<section id="A1.SS2" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">A.2 </span>Technical Configuration and Hyperparameters</h3>

<div id="A1.SS2.p1" class="ltx_para ltx_noindent">
<p id="A1.SS2.p1.1" class="ltx_p">To ensure reproducibility, we maintain consistent hyperparameters across all agent roles (Attacker, Defender, and Judge) and backbone architectures (GPT-OSS-20B and Llama-3.3-70B).</p>
</div>
<figure id="A1.T7" class="ltx_table">
<figcaption class="ltx_caption ltx_centering"><span class="ltx_tag ltx_tag_table"><span id="A1.T7.3" class="ltx_text" style="font-size:90%;">Table 7</span>: </span><span id="A1.T7.4" class="ltx_text" style="font-size:90%;">LLM Adjudication Hyperparameters</span></figcaption>
<table id="A1.T7.5" class="ltx_tabular ltx_centering ltx_guessed_headers ltx_align_middle">
<thead class="ltx_thead">
<tr id="A1.T7.5.1" class="ltx_tr">
<th id="A1.T7.5.1.1" class="ltx_td ltx_align_left ltx_th ltx_th_column ltx_border_tt"><span id="A1.T7.5.1.1.1" class="ltx_text ltx_font_bold">Agent Role</span></th>
<th id="A1.T7.5.1.2" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt"><span id="A1.T7.5.1.2.1" class="ltx_text ltx_font_bold">Temperature</span></th>
<th id="A1.T7.5.1.3" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt"><span id="A1.T7.5.1.3.1" class="ltx_text ltx_font_bold">top_p</span></th>
<th id="A1.T7.5.1.4" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt"><span id="A1.T7.5.1.4.1" class="ltx_text ltx_font_bold">Max Tokens</span></th>
<th id="A1.T7.5.1.5" class="ltx_td ltx_align_left ltx_th ltx_th_column ltx_border_tt">
<span id="A1.T7.5.1.5.1" class="ltx_inline-block ltx_align_top">
<span id="A1.T7.5.1.5.1.1" class="ltx_p"><span id="A1.T7.5.1.5.1.1.1" class="ltx_text ltx_font_bold">Notes</span></span>
</span></th></tr>
</thead>
<tbody class="ltx_tbody">
