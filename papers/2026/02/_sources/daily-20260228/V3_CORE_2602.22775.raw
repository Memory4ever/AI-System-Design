<span id="S4.T4.5.1.1.1" class="ltx_inline-block ltx_align_top" style="width:41.4pt;">
<span id="S4.T4.5.1.1.1.1" class="ltx_p"><span id="S4.T4.5.1.1.1.1.1" class="ltx_text ltx_font_bold" style="font-size:90%;">Turn</span></span>
</span></th>
