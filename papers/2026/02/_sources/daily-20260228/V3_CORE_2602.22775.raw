<td id="S4.T2.5.2.2" class="ltx_td ltx_align_center ltx_border_t"><span id="S4.T2.5.2.2.1" class="ltx_text" style="font-size:90%;">29 <math id="S4.T2.m1" class="ltx_Math" alttext="\pm" display="inline" intent=":literal"><semantics><mo>±</mo><annotation encoding="application/x-tex">\pm</annotation></semantics></math> 4.2</span></td>
<td id="S4.T2.5.2.3" class="ltx_td ltx_align_center ltx_border_t"><span id="S4.T2.5.2.3.1" class="ltx_text" style="font-size:90%;">312 <math id="S4.T2.m2" class="ltx_Math" alttext="\pm" display="inline" intent=":literal"><semantics><mo>±</mo><annotation encoding="application/x-tex">\pm</annotation></semantics></math> 47</span></td>
<td id="S4.T2.5.2.4" class="ltx_td ltx_align_center ltx_border_t"><span id="S4.T2.5.2.4.1" class="ltx_text" style="font-size:90%;">4.2 <math id="S4.T2.m3" class="ltx_Math" alttext="\pm" display="inline" intent=":literal"><semantics><mo>±</mo><annotation encoding="application/x-tex">\pm</annotation></semantics></math> 0.8</span></td></tr>
<tr id="S4.T2.5.3" class="ltx_tr">
<th id="S4.T2.5.3.1" class="ltx_td ltx_align_left ltx_th ltx_th_row"><span id="S4.T2.5.3.1.1" class="ltx_text" style="font-size:90%;">Greedy</span></th>
<td id="S4.T2.5.3.2" class="ltx_td ltx_align_center"><span id="S4.T2.5.3.2.1" class="ltx_text" style="font-size:90%;">34 <math id="S4.T2.m4" class="ltx_Math" alttext="\pm" display="inline" intent=":literal"><semantics><mo>±</mo><annotation encoding="application/x-tex">\pm</annotation></semantics></math> 3.8</span></td>
<td id="S4.T2.5.3.3" class="ltx_td ltx_align_center"><span id="S4.T2.5.3.3.1" class="ltx_text" style="font-size:90%;">287 <math id="S4.T2.m5" class="ltx_Math" alttext="\pm" display="inline" intent=":literal"><semantics><mo>±</mo><annotation encoding="application/x-tex">\pm</annotation></semantics></math> 41</span></td>
<td id="S4.T2.5.3.4" class="ltx_td ltx_align_center"><span id="S4.T2.5.3.4.1" class="ltx_text" style="font-size:90%;">4.8 <math id="S4.T2.m6" class="ltx_Math" alttext="\pm" display="inline" intent=":literal"><semantics><mo>±</mo><annotation encoding="application/x-tex">\pm</annotation></semantics></math> 0.6</span></td></tr>
<tr id="S4.T2.5.4" class="ltx_tr">
<th id="S4.T2.5.4.1" class="ltx_td ltx_align_left ltx_th ltx_th_row"><span id="S4.T2.5.4.1.1" class="ltx_text" style="font-size:90%;">Beam (k=5)</span></th>
