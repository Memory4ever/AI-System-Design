<td id="S5.T4.5.1.1.5" class="ltx_td ltx_align_right ltx_border_tt"><span id="S5.T4.5.1.1.5.1" class="ltx_text ltx_font_bold" style="font-size:90%;">ReAct</span></td>
<td id="S5.T4.5.1.1.6" class="ltx_td ltx_align_right ltx_border_tt">
<span id="S5.T4.5.1.1.6.1" class="ltx_inline-block">
<span id="S5.T4.5.1.1.6.1.1" class="ltx_p"><span id="S5.T4.5.1.1.6.1.1.1" class="ltx_text ltx_font_bold" style="font-size:90%;">ReAct</span></span>
<span id="S5.T4.5.1.1.6.1.2" class="ltx_p"><span id="S5.T4.5.1.1.6.1.2.1" class="ltx_text ltx_font_bold" style="font-size:90%;">Short</span></span>
</span></td></tr>
<tr id="S5.T4.5.1.2" class="ltx_tr">
<td id="S5.T4.5.1.2.1" class="ltx_td ltx_align_left ltx_border_t"><span id="S5.T4.5.1.2.1.1" class="ltx_text" style="font-size:90%;">AppWorld</span></td>
<td id="S5.T4.5.1.2.2" class="ltx_td ltx_align_right ltx_border_t"><span id="S5.T4.5.1.2.2.1" class="ltx_text" style="font-size:90%;">63%</span></td>
