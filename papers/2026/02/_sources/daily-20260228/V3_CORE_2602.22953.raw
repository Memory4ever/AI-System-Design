<span id="A2.SS3.SSSx2.p1.1.3.1.1.1" class="ltx_p"><span id="A2.SS3.SSSx2.p1.1.3.1.1.1.1" class="ltx_text" style="font-size:90%;">supervisor</span></span>
</span></td>
<td id="A2.SS3.SSSx2.p1.1.3.2" class="ltx_td ltx_nopad_r ltx_align_left ltx_align_top">
