<td id="S5.T2.8.1.7.2" class="ltx_td ltx_align_left ltx_border_bb"><span id="S5.T2.8.1.7.2.1" class="ltx_text" style="font-size:70%;">Smolagent + Claude Opus 4.5</span></td>
