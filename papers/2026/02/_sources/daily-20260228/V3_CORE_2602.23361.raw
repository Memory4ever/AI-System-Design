<span id="S2.T8.3.1.1.1" class="ltx_inline-block ltx_transformed_outer" style="width:581.9pt;height:55.8pt;vertical-align:-24.3pt;"><span class="ltx_transformed_inner" style="transform:translate(0.0pt,0.0pt) scale(1,1) ;">
