<span id="S2.T8.3.1.1.1.1.1.1.4.2" class="ltx_td ltx_align_right ltx_border_bb"><span id="S2.T8.3.1.1.1.1.1.1.4.2.1" class="ltx_text ltx_font_bold">0.016</span></span>
