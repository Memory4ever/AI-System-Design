<td id="S5.T3.12.1.6.3" class="ltx_td ltx_align_center ltx_border_t"><span id="S5.T3.12.1.6.3.1" class="ltx_text" style="font-size:90%;">94.35</span></td>
<td id="S5.T3.12.1.6.4" class="ltx_td ltx_align_center ltx_border_t"><span id="S5.T3.12.1.6.4.1" class="ltx_text" style="font-size:90%;">95.45</span></td>
<td id="S5.T3.12.1.6.5" class="ltx_td ltx_align_center ltx_border_t"><span id="S5.T3.12.1.6.5.1" class="ltx_text" style="font-size:90%;">97.95</span></td></tr>
<tr id="S5.T3.12.1.7" class="ltx_tr">
