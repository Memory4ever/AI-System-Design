<td id="S5.T3.12.1.6.1" class="ltx_td ltx_align_left ltx_border_t"><span id="S5.T3.12.1.6.1.1" class="ltx_text" style="font-size:90%;">Paraphrase 1 (</span><span id="S5.T3.12.1.6.1.2" class="ltx_text ltx_font_typewriter" style="font-size:90%;">Qwen-2.5-1.5B-Instruct</span><span id="S5.T3.12.1.6.1.3" class="ltx_text" style="font-size:90%;">)</span></td>
