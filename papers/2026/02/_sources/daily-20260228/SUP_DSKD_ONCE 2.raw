<td id="S3.T1.2.2.4" class="ltx_td ltx_align_left ltx_border_t">antonym</td></tr>
<tr id="S3.T1.2.3" class="ltx_tr">
<th id="S3.T1.2.3.1" class="ltx_td ltx_align_left ltx_th ltx_th_row">accurate, faultless</th>
<td id="S3.T1.2.3.2" class="ltx_td ltx_align_left ltx_border_r">synonym</td>
<th id="S3.T1.2.3.3" class="ltx_td ltx_align_left ltx_th ltx_th_row">accurate, fault</th>
