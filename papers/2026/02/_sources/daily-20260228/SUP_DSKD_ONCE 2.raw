<td id="S5.T3.2.1.5.5" class="ltx_td ltx_align_center ltx_border_r ltx_border_t">55.37<math id="S5.T3.m18" class="ltx_Math" alttext="\pm" display="inline" intent=":literal"><semantics><mo>±</mo><annotation encoding="application/x-tex">\pm</annotation></semantics></math>0.27</td>
<td id="S5.T3.2.1.5.6" class="ltx_td ltx_align_center ltx_border_r ltx_border_t">73.72<math id="S5.T3.m19" class="ltx_Math" alttext="\pm" display="inline" intent=":literal"><semantics><mo>±</mo><annotation encoding="application/x-tex">\pm</annotation></semantics></math>0.59</td>
<td id="S5.T3.2.1.5.7" class="ltx_td ltx_align_center ltx_border_r ltx_border_t">66.26<math id="S5.T3.m20" class="ltx_Math" alttext="\pm" display="inline" intent=":literal"><semantics><mo>±</mo><annotation encoding="application/x-tex">\pm</annotation></semantics></math>0.13</td></tr>
<tr id="S5.T3.2.1.6" class="ltx_tr">
<th id="S5.T3.2.1.6.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_l ltx_border_r">KD</th>
<td id="S5.T3.2.1.6.2" class="ltx_td ltx_align_center ltx_border_r">16</td>
<td id="S5.T3.2.1.6.3" class="ltx_td ltx_align_center ltx_border_r">61.11±0.31</td>
