<th id="S3.T2.2.1.3" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_t" colspan="2"><span id="S3.T2.2.1.3.1" class="ltx_text" style="font-size:90%;">Mistral</span></th></tr>
