<td id="S5.T3.2.1.6.5" class="ltx_td ltx_align_center ltx_border_r">52.04<math id="S5.T3.m22" class="ltx_Math" alttext="\pm" display="inline" intent=":literal"><semantics><mo>±</mo><annotation encoding="application/x-tex">\pm</annotation></semantics></math>0.43</td>
<td id="S5.T3.2.1.6.6" class="ltx_td ltx_align_center ltx_border_r">78.88<math id="S5.T3.m23" class="ltx_Math" alttext="\pm" display="inline" intent=":literal"><semantics><mo>±</mo><annotation encoding="application/x-tex">\pm</annotation></semantics></math>0.22</td>
<td id="S5.T3.2.1.6.7" class="ltx_td ltx_align_center ltx_border_r">57.82<math id="S5.T3.m24" class="ltx_Math" alttext="\pm" display="inline" intent=":literal"><semantics><mo>±</mo><annotation encoding="application/x-tex">\pm</annotation></semantics></math>0.25</td></tr>
<tr id="S5.T3.2.1.7" class="ltx_tr">
<th id="S5.T3.2.1.7.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_b ltx_border_l ltx_border_r">DSKD</th>
<td id="S5.T3.2.1.7.2" class="ltx_td ltx_align_center ltx_border_b ltx_border_r">16</td>
