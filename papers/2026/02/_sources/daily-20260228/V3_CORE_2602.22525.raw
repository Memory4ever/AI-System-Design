<td id="S3.T3.2.2.2" class="ltx_td ltx_align_right ltx_border_t" style="padding:0.25pt 4.0pt;"><span id="S3.T3.2.2.2.1" class="ltx_text" style="--ltx-bg-color:#FFFFFF;">64.4 ms</span></td>
<td id="S3.T3.2.2.3" class="ltx_td ltx_align_right ltx_border_t" style="padding:0.25pt 4.0pt;"><span id="S3.T3.2.2.3.1" class="ltx_text" style="--ltx-bg-color:#FFFFFF;">65.0 ms</span></td></tr>
