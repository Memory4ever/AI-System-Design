<td id="S3.T3.2.3.3" class="ltx_td ltx_align_right" style="padding:0.25pt 4.0pt;"><span id="S3.T3.2.3.3.1" class="ltx_text" style="--ltx-bg-color:#F5F5F5;">64.8 ms</span></td></tr>
