<th id="S3.T3.2.1.2" class="ltx_td ltx_align_right ltx_th ltx_th_column ltx_border_tt" style="padding:0.25pt 4.0pt;"><span id="S3.T3.2.1.2.1" class="ltx_text" style="--ltx-bg-color:#FFFFFF;">Mean</span></th>
<th id="S3.T3.2.1.3" class="ltx_td ltx_align_right ltx_th ltx_th_column ltx_border_tt" style="padding:0.25pt 4.0pt;"><span id="S3.T3.2.1.3.1" class="ltx_text" style="--ltx-bg-color:#FFFFFF;">P95</span></th></tr>
</thead>
