column names=1=MobilityBench, 2=<span id="S4.tab1.3.6.1.2.1" class="ltx_ERROR undefined">\GroupName</span>, 3=<span id="S4.tab1.3.6.1.2.2" class="ltx_ERROR undefined">\vID</span>, 4=<span id="S4.tab1.3.6.1.2.3" class="ltx_ERROR undefined">\vIE</span>, 5=<span id="S4.tab1.3.6.1.2.4" class="ltx_ERROR undefined">\vDECP</span>, 6=<span id="S4.tab1.3.6.1.2.5" class="ltx_ERROR undefined">\vDECR</span>, 7=<span id="S4.tab1.3.6.1.2.6" class="ltx_ERROR undefined">\vTSP</span>, 8=<span id="S4.tab1.3.6.1.2.7" class="ltx_ERROR undefined">\vTSR</span>, 9=<span id="S4.tab1.3.6.1.2.8" class="ltx_ERROR undefined">\vSC</span>, 10=<span id="S4.tab1.3.6.1.2.9" class="ltx_ERROR undefined">\vDR</span>, 11=<span id="S4.tab1.3.6.1.2.10" class="ltx_ERROR undefined">\vFPR</span>, 12=<span id="S4.tab1.3.6.1.2.11" class="ltx_ERROR undefined">\vIT</span>, 13=<span id="S4.tab1.3.6.1.2.12" class="ltx_ERROR undefined">\vOT</span>,
filter strcmp=<span id="S4.tab1.3.6.1.2.13" class="ltx_ERROR undefined">\GroupName</span>PlanAndExecute,
