<td id="A4.T10.5.2.4" class="ltx_td ltx_align_center ltx_border_t"><span id="A4.T10.5.2.4.1" class="ltx_text ltx_font_smallcaps" style="font-size:90%;">86%</span></td>
<td id="A4.T10.5.2.5" class="ltx_td ltx_align_center ltx_border_t"><span id="A4.T10.5.2.5.1" class="ltx_text ltx_font_smallcaps" style="font-size:90%;">100%</span></td></tr>
