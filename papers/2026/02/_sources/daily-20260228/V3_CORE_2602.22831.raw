<th id="S4.T1.6.2.8" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_t"><span id="S4.T1.6.2.8.1" class="ltx_text" style="font-size:90%;">Sig</span></th>
<th id="S4.T1.6.2.9" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_t"><span id="S4.T1.6.2.9.1" class="ltx_text" style="font-size:90%;">BF</span></th>
<th id="S4.T1.6.2.10" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_t"><math id="S4.T1.m9" class="ltx_Math" alttext="|" display="inline" intent=":literal"><semantics><mo fence="false" maxsize="0.900em" minsize="0.900em" stretchy="true">|</mo><annotation encoding="application/x-tex">|</annotation></semantics></math><span id="S4.T1.6.2.10.1" class="ltx_text" style="font-size:90%;">Asym<math id="S4.T1.m10" class="ltx_Math" alttext="|" display="inline" intent=":literal"><semantics><mo fence="false" stretchy="false">|</mo><annotation encoding="application/x-tex">|</annotation></semantics></math></span></th>
<th id="S4.T1.6.2.11" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_t"><math id="S4.T1.m11" class="ltx_Math" alttext="|" display="inline" intent=":literal"><semantics><mo fence="false" maxsize="0.900em" minsize="0.900em" stretchy="true">|</mo><annotation encoding="application/x-tex">|</annotation></semantics></math><span id="S4.T1.6.2.11.1" class="ltx_text" style="font-size:90%;">N-Asym<math id="S4.T1.m12" class="ltx_Math" alttext="|" display="inline" intent=":literal"><semantics><mo fence="false" stretchy="false">|</mo><annotation encoding="application/x-tex">|</annotation></semantics></math></span></th></tr>
</thead>
<tbody class="ltx_tbody">
<tr id="S4.T1.6.3" class="ltx_tr">
<th id="S4.T1.6.3.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_t"><span id="S4.T1.6.3.1.1" class="ltx_text" style="font-size:90%;">emotional</span></th>
<td id="S4.T1.6.3.2" class="ltx_td ltx_align_center ltx_border_t"><span id="S4.T1.6.3.2.1" class="ltx_text" style="font-size:90%;">0.20</span></td>
<td id="S4.T1.6.3.3" class="ltx_td ltx_align_center ltx_border_t"><span id="S4.T1.6.3.3.1" class="ltx_text" style="font-size:90%;">20%</span></td>
<td id="S4.T1.6.3.4" class="ltx_td ltx_align_center ltx_border_t"><span id="S4.T1.6.3.4.1" class="ltx_text" style="font-size:90%;">100%</span></td>
<td id="S4.T1.6.3.5" class="ltx_td ltx_align_center ltx_border_t"><span id="S4.T1.6.3.5.1" class="ltx_text" style="font-size:90%;">0.34</span></td>
<td id="S4.T1.6.3.6" class="ltx_td ltx_align_center ltx_border_t"><span id="S4.T1.6.3.6.1" class="ltx_text" style="font-size:90%;">0.60</span></td>
<td id="S4.T1.6.3.7" class="ltx_td ltx_align_center ltx_border_t"><span id="S4.T1.6.3.7.1" class="ltx_text" style="font-size:90%;">0.22</span></td>
