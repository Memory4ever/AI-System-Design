<th id="A4.T10.5.3.1" class="ltx_td ltx_align_left ltx_th ltx_th_row"><span id="A4.T10.5.3.1.1" class="ltx_text ltx_font_smallcaps" style="font-size:90%;">DeepSeek V3.2</span></th>
<th id="A4.T10.5.3.2" class="ltx_td ltx_align_left ltx_th ltx_th_row"><span id="A4.T10.5.3.2.1" class="ltx_text ltx_font_smallcaps" style="font-size:90%;">low</span></th>
