<th id="A3.T5.6.1.2" class="ltx_td ltx_align_left ltx_th ltx_th_column ltx_th_row ltx_border_tt"><span id="A3.T5.6.1.2.1" class="ltx_text ltx_font_smallcaps" style="font-size:90%;">Reasoning</span></th>
