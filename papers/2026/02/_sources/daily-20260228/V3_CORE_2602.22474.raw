</span></span></span></foreignObject></g></g><g class="ltx_tikzmatrix_row" transform="matrix(1 0 0 1 0 15.38)"><g class="ltx_tikzmatrix_col ltx_nopad_l ltx_nopad_r" transform="matrix(1 0 0 -1 0 0)"><foreignObject style="--ltx-fo-width:12.35em;--ltx-fo-height:0.65em;--ltx-fo-depth:0.18em;font-size:8.5pt;" height="9.84" overflow="visible" transform="matrix(1 0 0 -1 0 7.69)" width="145.27"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><span id="A1.SS2.p3.pic1.2" class="ltx_text ltx_font_sansserif" style="font-size:80%;">multiple ground-truth options</span></span></span></foreignObject></g></g></g></g><g style="--ltx-stroke-color:#27A332;--ltx-fill-color:#27A332;" fill="#27A332" stroke="#27A332"><path style="fill:none" d="M 0 -12.08 L 0 -29.57 L 158.79 -29.57"></path><g style="--ltx-fg-color:#27A332;" color="#27A332" transform="matrix(0.0 1.0 -1.0 0.0 0 -12.08)"><path style="stroke:none" d="M 2.77 0 L -1.66 2.21 L 0 0 L -1.66 -2.21"></path></g></g></g></svg></span>
