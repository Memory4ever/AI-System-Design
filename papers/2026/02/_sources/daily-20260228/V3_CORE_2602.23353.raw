<figure id="A2.F7.sf1" class="ltx_figure ltx_figure_panel ltx_align_center"><object type="image/svg+xml" data="2602.23353v1/num_pairs_imagenet_top1.svg" id="A2.F7.sf1.g1" class="ltx_graphics ltx_centering ltx_img_landscape" style="aspect-ratio:476/357;" width="476" height="357"></object>
