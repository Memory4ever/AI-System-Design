<td id="A3.T7.3.6.3" class="ltx_td ltx_align_center ltx_border_bb" style="padding-left:3.0pt;padding-right:3.0pt;"><span id="A3.T7.3.6.3.1" class="ltx_text" style="font-size:80%;">68.3</span></td>
<td id="A3.T7.3.6.4" class="ltx_td ltx_align_center ltx_border_bb" style="padding-left:3.0pt;padding-right:3.0pt;"><span id="A3.T7.3.6.4.1" class="ltx_text" style="font-size:80%;">21.2</span></td>
