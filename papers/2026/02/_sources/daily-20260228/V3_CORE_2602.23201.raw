</span></td>
<td id="A1.T1.1.17.3" class="ltx_td ltx_align_right" style="padding:1.05pt 4.0pt;"><span id="A1.T1.1.17.3.1" class="ltx_text" style="font-size:80%;">439</span></td>
<td id="A1.T1.1.17.4" class="ltx_td ltx_align_right" style="padding:1.05pt 4.0pt;"><span id="A1.T1.1.17.4.1" class="ltx_text" style="font-size:80%;">0</span></td>
<td id="A1.T1.1.17.5" class="ltx_td ltx_align_right" style="padding:1.05pt 4.0pt;"><span id="A1.T1.1.17.5.1" class="ltx_text" style="font-size:80%;">0</span></td>
<td id="A1.T1.1.17.6" class="ltx_td ltx_align_right" style="padding:1.05pt 4.0pt;"><span id="A1.T1.1.17.6.1" class="ltx_text" style="font-size:80%;">439</span></td>
<td id="A1.T1.1.17.7" class="ltx_td ltx_align_left ltx_align_top" style="padding:1.05pt 4.0pt;">
