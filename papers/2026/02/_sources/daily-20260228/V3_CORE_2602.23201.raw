<td id="A3.T7.3.4.9" class="ltx_td ltx_align_center" style="padding-left:3.0pt;padding-right:3.0pt;"><span id="A3.T7.3.4.9.1" class="ltx_text" style="font-size:80%;">38.0</span></td></tr>
