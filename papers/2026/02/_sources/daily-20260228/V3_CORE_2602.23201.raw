<td id="A3.T7.3.5.5" class="ltx_td ltx_align_center" style="padding-left:3.0pt;padding-right:3.0pt;"><span id="A3.T7.3.5.5.1" class="ltx_text" style="font-size:80%;">0.0</span></td>
<td id="A3.T7.3.5.6" class="ltx_td ltx_align_center" style="padding-left:3.0pt;padding-right:3.0pt;"><span id="A3.T7.3.5.6.1" class="ltx_text" style="font-size:80%;">56.1</span></td>
<td id="A3.T7.3.5.7" class="ltx_td ltx_align_center" style="padding-left:3.0pt;padding-right:3.0pt;"><span id="A3.T7.3.5.7.1" class="ltx_text" style="font-size:80%;">25.0</span></td>
