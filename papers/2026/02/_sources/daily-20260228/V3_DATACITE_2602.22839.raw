{"data":{"id":"10.48550/arxiv.2602.22839","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.22839","prefix":"10.48550","suffix":"arxiv.2602.22839","identifiers":[{"identifier":"2602.22839","identifierType":"arXiv"}],"alternateIdentifiers":[{"alternateIdentifierType":"arXiv","alternateIdentifier":"2602.22839"}],"creators":[{"name":"Zheng, Hao","nameType":"Personal","givenName":"Hao","familyName":"Zheng","affiliation":[],"nameIdentifiers":[]},{"name":"Mo, Guozhao","nameType":"Personal","givenName":"Guozhao","familyName":"Mo","affiliation":[],"nameIdentifiers":[]},{"name":"Yan, Xinru","nameType":"Personal","givenName":"Xinru","familyName":"Yan","affiliation":[],"nameIdentifiers":[]},{"name":"Yuan, Qianhao","nameType":"Personal","givenName":"Qianhao","familyName":"Yuan","affiliation":[],"nameIdentifiers":[]},{"name":"Zhang, Wenkai","nameType":"Personal","givenName":"Wenkai","familyName":"Zhang","affiliation":[],"nameIdentifiers":[]},{"name":"Chen, Xuanang","nameType":"Personal","givenName":"Xuanang","familyName":"Chen","affiliation":[],"nameIdentifiers":[]},{"name":"Lu, Yaojie","nameType":"Personal","givenName":"Yaojie","familyName":"Lu","affiliation":[],"nameIdentifiers":[]},{"name":"Lin, Hongyu","nameType":"Personal","givenName":"Hongyu","familyName":"Lin","affiliation":[],"nameIdentifiers":[]},{"name":"Han, Xianpei","nameType":"Personal","givenName":"Xianpei","familyName":"Han","affiliation":[],"nameIdentifiers":[]},{"name":"Sun, Le","nameType":"Personal","givenName":"Le","familyName":"Sun","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"DeepPresenter: Environment-Grounded Reflection for Agentic Presentation Generation"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"lang":"en","subject":"Artificial Intelligence (cs.AI)","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"FOS: Computer and information sciences","schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-26T10:26:48Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-27T01:37:42Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-04-15T07:04:54Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-04-16T00:32:39Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-04-20T02:43:16Z","dateType":"Submitted","dateInformation":"v3"},{"date":"2026-04-21T01:34:41Z","dateType":"Updated","dateInformation":"v3"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"ris":"GEN","bibtex":"misc","citeproc":"article","schemaOrg":"CreativeWork","resourceType":"Article","resourceTypeGeneral":"Preprint"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"3","rightsList":[{"rights":"Creative Commons Attribution 4.0 International","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rightsIdentifier":"cc-by-4.0","rightsIdentifierScheme":"SPDX"}],"descriptions":[{"description":"Presentation generation requires deep content research, coherent visual design, and iterative refinement based on observation. However, existing presentation agents often rely on predefined workflows and fixed templates. To address this, we present DeepPresenter, an agentic framework that adapts to diverse user intents, enables effective feedback-driven refinement, and generalizes beyond a scripted pipeline. Specifically, DeepPresenter autonomously plans, renders, and revises intermediate slide artifacts to support long-horizon refinement with environmental observations. Furthermore, rather than relying on self-reflection over internal signals (e.g., reasoning traces), our environment-grounded reflection conditions the generation process on perceptual artifact states (e.g., rendered slides), enabling the system to identify and correct presentation-specific issues during execution. Results on the evaluation set covering diverse presentation-generation scenarios show that DeepPresenter achieves state-of-the-art performance, and the fine-tuned 9B model remains highly competitive at substantially lower cost. Our project is available at: https://github.com/icip-cas/PPTAgent","descriptionType":"Abstract"}],"geoLocations":[],"fundingReferences":[],"xml":"","url":"https://arxiv.org/abs/2602.22839","contentUrl":null,"metadataVersion":2,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"viewsOverTime":[],"downloadCount":0,"downloadsOverTime":[],"referenceCount":0,"citationCount":0,"citationsOverTime":[],"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-27T02:55:58.000Z","registered":"2026-02-27T02:55:59.000Z","published":"2026","updated":"2026-04-21T04:59:12.000Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}},"provider":{"data":{"id":"arxiv","type":"providers"}},"media":{"data":{"id":"10.48550/arxiv.2602.22839","type":"media"}},"references":{"data":[]},"citations":{"data":[]},"parts":{"data":[]},"partOf":{"data":[]},"versions":{"data":[]},"versionOf":{"data":[]}}}}