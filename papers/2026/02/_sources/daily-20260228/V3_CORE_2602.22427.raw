<td id="S7.T2.5.4.4" class="ltx_td ltx_align_center ltx_border_t"><span id="S7.T2.5.4.4.1" class="ltx_text" style="font-size:90%;">10</span></td>
<td id="S7.T2.5.4.5" class="ltx_td ltx_align_center ltx_border_t"><span id="S7.T2.5.4.5.1" class="ltx_text" style="font-size:90%;">90%</span></td>
<td id="S7.T2.5.4.6" class="ltx_td ltx_align_center ltx_border_t"><span id="S7.T2.5.4.6.1" class="ltx_text" style="font-size:90%;">90%</span></td></tr>
