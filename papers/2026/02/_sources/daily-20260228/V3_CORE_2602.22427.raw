<td id="S7.T2.5.5.3" class="ltx_td ltx_align_center"><span id="S7.T2.5.5.3.1" class="ltx_text" style="font-size:90%;">20</span></td>
<td id="S7.T2.5.5.4" class="ltx_td ltx_align_center"><span id="S7.T2.5.5.4.1" class="ltx_text" style="font-size:90%;">50%</span></td>
<td id="S7.T2.5.5.5" class="ltx_td ltx_align_center"><span id="S7.T2.5.5.5.1" class="ltx_text" style="font-size:90%;">100%</span></td></tr>
<tr id="S7.T2.5.6" class="ltx_tr">
