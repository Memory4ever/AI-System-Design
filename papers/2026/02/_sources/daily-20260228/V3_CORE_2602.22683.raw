</figure></div><div class="ltx_flex_cell ltx_flex_size_3">
<figure id="S3.F7.fig2" class="ltx_figure ltx_figure_panel ltx_minipage ltx_align_middle" style="width:154.0pt;"><object type="image/svg+xml" data="2602.22683v1/category_chart.svg" id="S3.F7.g2" class="ltx_graphics ltx_centering ltx_img_square" style="aspect-ratio:213/191;" width="213" height="191"></object>
