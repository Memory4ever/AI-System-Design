<td id="A4.T5.6.1.1.2" class="ltx_td ltx_align_center ltx_border_tt"><span id="A4.T5.6.1.1.2.1" class="ltx_text ltx_font_bold">Plant</span></td>
<td id="A4.T5.6.1.1.3" class="ltx_td ltx_align_center ltx_border_tt"><span id="A4.T5.6.1.1.3.1" class="ltx_text"></span><span id="A4.T5.6.1.1.3.2" class="ltx_text ltx_font_bold"> <span id="A4.T5.6.1.1.3.2.1" class="ltx_text">
<span id="A4.T5.6.1.1.3.2.1.1" class="ltx_tabular ltx_align_middle">
