<tr id="A4.T5.6.1.5" class="ltx_tr" style="--ltx-bg-color:#ECECEC;">
<td id="A4.T5.6.1.5.1" class="ltx_td ltx_align_center ltx_border_t" colspan="11"><span id="A4.T5.6.1.5.1.1" class="ltx_text" style="position:relative; bottom:-0.2pt;"><img src="2602.22683v1/rayneo.png" id="A4.T5.g2" class="ltx_graphics ltx_img_square" style="aspect-ratio:18/18;" width="18" height="18" alt="[Uncaptioned image]"></span> <span id="A4.T5.6.1.5.1.2" class="ltx_text ltx_font_bold ltx_font_italic">RayNeo Smart Glasses</span></td></tr>
<tr id="A4.T5.6.1.6" class="ltx_tr">
<td id="A4.T5.6.1.6.1" class="ltx_td ltx_align_left ltx_border_t">Qwen2.5-VL-3B</td>
<td id="A4.T5.6.1.6.2" class="ltx_td ltx_align_center ltx_border_t">26.04</td>
<td id="A4.T5.6.1.6.3" class="ltx_td ltx_align_center ltx_border_t">28.96</td>
<td id="A4.T5.6.1.6.4" class="ltx_td ltx_align_center ltx_border_t">20.30</td>
<td id="A4.T5.6.1.6.5" class="ltx_td ltx_align_center ltx_border_t">29.96</td>
