<td id="A4.T5.6.1.1.7" class="ltx_td ltx_align_center ltx_border_tt"><span id="A4.T5.6.1.1.7.1" class="ltx_text ltx_font_bold">Transport</span></td>
<td id="A4.T5.6.1.1.8" class="ltx_td ltx_align_center ltx_border_tt"><span id="A4.T5.6.1.1.8.1" class="ltx_text ltx_font_bold">Culture</span></td>
<td id="A4.T5.6.1.1.9" class="ltx_td ltx_align_center ltx_border_tt"><span id="A4.T5.6.1.1.9.1" class="ltx_text ltx_font_bold">Navigation</span></td>
<td id="A4.T5.6.1.1.10" class="ltx_td ltx_align_center ltx_border_tt"><span id="A4.T5.6.1.1.10.1" class="ltx_text ltx_font_bold">Animal</span></td>
<td id="A4.T5.6.1.1.11" class="ltx_td ltx_align_center ltx_border_tt"><span id="A4.T5.6.1.1.11.1" class="ltx_text ltx_font_bold">Education</span></td></tr>
<tr id="A4.T5.6.1.2" class="ltx_tr" style="--ltx-bg-color:#E6E6E6;">
<td id="A4.T5.6.1.2.1" class="ltx_td ltx_align_center ltx_border_t" colspan="11"><span id="A4.T5.6.1.2.1.1" class="ltx_text ltx_font_italic" style="position:relative; bottom:-0.2pt;"><img src="2602.22683v1/meta.png" id="A4.T5.g1" class="ltx_graphics ltx_img_square" style="aspect-ratio:16/16;" width="16" height="16" alt="[Uncaptioned image]"></span><span id="A4.T5.6.1.2.1.2" class="ltx_text ltx_font_italic">  <span id="A4.T5.6.1.2.1.2.1" class="ltx_text ltx_font_bold">Meta-Rayben Smart Glasses</span></span></td></tr>
<tr id="A4.T5.6.1.3" class="ltx_tr">
