</div>
<div id="alg2.l7" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg2.l7.1" class="ltx_text" style="font-size:80%;">7:</span></span>
              
              
              <span id="alg2.l7.3" class="ltx_text ltx_font_italic">// Annotate each cursor with its last-use turn index</span>

</div>
<div id="alg2.l8" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg2.l8.1" class="ltx_text" style="font-size:80%;">8:</span></span>
              
              
              <span id="alg2.l8.3" class="ltx_text ltx_font_bold">for</span> each cursor <math id="alg2.l8.m1" class="ltx_Math" alttext="c" display="inline" intent=":literal"><semantics><mi>c</mi><annotation encoding="application/x-tex">c</annotation></semantics></math> in <math id="alg2.l8.m2" class="ltx_Math" alttext="\tau" display="inline" intent=":literal"><semantics><mi>τ</mi><annotation encoding="application/x-tex">\tau</annotation></semantics></math> <span id="alg2.l8.4" class="ltx_text ltx_font_bold">do</span>



</div>
