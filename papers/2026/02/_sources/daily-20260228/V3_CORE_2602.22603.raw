nt_typewriter" style="font-size:90%;">cursors</span><span id="lstnumberx32.37" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:90%;"> </span><span id="lstnumberx32.38" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:90%;">can</span><span id="lstnumberx32.39" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:90%;"> </span><span id="lstnumberx32.40" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:90%;">be</span><span id="lstnumberx32.41" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:90%;"> </span><span id="lstnumberx32.42" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:90%;">removed</span><span id="lstnumberx32.43" class="ltx_text ltx_font_typewriter" style="font-size:90%;">.</span>
</div>
<div id="lstnumberx33" class="ltx_listingline">
</div>
<div id="lstnumberx34" class="ltx_listingline"><span id="lstnumberx34.1" class="ltx_text ltx_font_typewriter" style="font-size:90%;">**</span><span id="lstnumberx34.2" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:90%;">Response</span><span id="lstnumberx34.3" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:90%;"> </span><span id="lstnumberx34.4" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:90%;">Format</span><span id="lstnumberx34.5" class="ltx_text ltx_font_typewriter" style="font-size:90%;">:**</span>
