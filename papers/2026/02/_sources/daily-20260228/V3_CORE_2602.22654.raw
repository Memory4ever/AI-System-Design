<td id="A1.T6.5.17.2" class="ltx_td ltx_align_left ltx_border_bb"><math id="A1.T6.m32" class="ltx_Math" alttext="\tau=2.0,\beta=0.3" display="inline" intent=":literal"><semantics><mrow><mrow><mi>τ</mi><mo>=</mo><mn>2.0</mn></mrow><mo>,</mo><mrow><mi>β</mi><mo>=</mo><mn>0.3</mn></mrow></mrow><annotation encoding="application/x-tex">\tau=2.0,\beta=0.3</annotation></semantics></math></td></tr>
