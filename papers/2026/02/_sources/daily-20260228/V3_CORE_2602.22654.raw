<td id="A1.T6.5.11.2" class="ltx_td ltx_align_left"><math id="A1.T6.m20" class="ltx_Math" alttext="\mathcal{N}=8,O=1" display="inline" intent=":literal"><semantics><mrow><mrow><mi class="ltx_font_mathcaligraphic">𝒩</mi><mo>=</mo><mn>8</mn></mrow><mo>,</mo><mrow><mi>O</mi><mo>=</mo><mn>1</mn></mrow></mrow><annotation encoding="application/x-tex">\mathcal{N}=8,O=1</annotation></semantics></math></td></tr>
