-ltx-fo-height:0.68em;--ltx-fo-depth:0.19em;font-size:10.22pt;" height="12.3" overflow="visible" transform="matrix(1 0 0 -1 0 9.61)" width="72.14"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><span id="S1.F1.pic1.3" class="ltx_text ltx_font_italic">Confidence <math id="S1.F1.pic1.m17" class="ltx_Math" alttext="\mathcal{C}_{i,t}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">𝒞</mi><mrow><mi>i</mi><mo>,</mo><mi>t</mi></mrow></msub><annotation encoding="application/x-tex">\mathcal{C}_{i,t}</annotation></semantics></math></span></span></span></foreignObject></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 127.6 229.2)"><foreignObject style="--ltx-fo-width:13.91em;--ltx-fo-height:0.68em;--ltx-fo-depth:0.19em;font-size:10.22pt;" height="12.3" overflow="visible" transform="matrix(1 0 0 -1 0 9.61)" width="196.82"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><span id="S1.F1.pic1.4" class="ltx_text ltx_font_italic">Calibration and Selective Voting</span></span></span></foreignObject></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#FFFFFF;" fill="#FFFFFF" stroke="#000000"><path d="M 535.17 166.44 L 459.85 166.44 C 456.79 166.44 454.31 163.96 454.31 160.9 L 454.31 52.42 C 454.31 49.36 456.79 46.89 459.85 46.89 L 535.17 46.89 C 538.23 46.89 540.71 49.36 540.71 52.42 L 540.71 160.9 C 540.71 163.96 538.23 166.44 535.17 166.44 Z M 454.31 46.89"></path></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#FFFFFF;" fill="#FFFFFF" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 458.46 58.13)"><g class="ltx_tikzmatrix" transform="matrix(1 0 0 -1 0 114.02)"><g class="ltx_tikzmatrix_row" transform="matrix(1 0 0 1 0 7.82)"><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" class="ltx_tikzmatrix_col ltx_nopad_l ltx_nopad_r" fill="#000000" stroke="#000000" trans