<th id="A1.T6.5.1.3" class="ltx_td ltx_align_left ltx_align_top ltx_th ltx_th_column ltx_border_tt">
<span id="A1.T6.5.1.3.1" class="ltx_inline-block ltx_align_top" style="width:241.5pt;">
<span id="A1.T6.5.1.3.1.1" class="ltx_p"><span id="A1.T6.5.1.3.1.1.1" class="ltx_text ltx_font_smallcaps" style="font-size:90%;">Representative strategy</span></span>
</span></th></tr>
</thead>
<tbody class="ltx_tbody">
<tr id="A1.T6.5.2" class="ltx_tr">
<td id="A1.T6.5.2.1" class="ltx_td ltx_align_left ltx_border_t" rowspan="3"><span id="A1.T6.5.2.1.1" class="ltx_text ltx_font_smallcaps" style="font-size:90%;">Algebraic</span></td>
<td id="A1.T6.5.2.2" class="ltx_td ltx_align_left ltx_border_t"><span id="A1.T6.5.2.2.1" class="ltx_text ltx_font_smallcaps" style="font-size:90%;">algebraic_general</span></td>
