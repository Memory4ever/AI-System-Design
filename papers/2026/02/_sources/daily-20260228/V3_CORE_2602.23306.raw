<td id="S4.T2.4.6.2" class="ltx_td ltx_align_center ltx_border_bb" style="padding-left:14.0pt;padding-right:14.0pt;"><span id="S4.T2.4.6.2.1" class="ltx_text" style="--ltx-bg-color:#D9FFFF;">68.8(<span id="S4.T2.4.6.2.1.1" class="ltx_text" style="--ltx-fg-color:#008000;">+2.0</span>)</span></td>
