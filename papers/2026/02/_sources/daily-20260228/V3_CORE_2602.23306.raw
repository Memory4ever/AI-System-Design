<tr id="S4.T3.4.5" class="ltx_tr" style="--ltx-bg-color:#D9FFFF;">
<td id="S4.T3.4.5.1" class="ltx_td ltx_align_left" style="padding-left:14.0pt;padding-right:14.0pt;"><span id="S4.T3.4.5.1.1" class="ltx_text ltx_font_smallcaps" style="--ltx-bg-color:#D9FFFF;">ThinkOmni<span id="S4.T3.4.5.1.1.1" class="ltx_text ltx_font_upright"> (Ours)</span></span></td>
<td id="S4.T3.4.5.2" class="ltx_td ltx_align_center" style="padding-left:14.0pt;padding-right:14.0pt;"><span id="S4.T3.4.5.2.1" class="ltx_text" style="--ltx-bg-color:#D9FFFF;">7B +7B</span></td>
