<td id="S4.T3.4.3.3" class="ltx_td ltx_align_center" style="padding-left:14.0pt;padding-right:14.0pt;">0.262s (<math id="S4.T3.m3" class="ltx_math_unparsed" alttext="1.89\times" display="inline" intent=":literal"><semantics><mrow><mn>1.89</mn><mo lspace="0.222em">×</mo></mrow><annotation encoding="application/x-tex">1.89\times</annotation></semantics></math>)</td>
<td id="S4.T3.4.3.4" class="ltx_td ltx_align_center" style="padding-left:14.0pt;padding-right:14.0pt;">0.050s (<math id="S4.T3.m4" class="ltx_math_unparsed" alttext="2.00\times" display="inline" intent=":literal"><semantics><mrow><mn>2.00</mn><mo lspace="0.222em">×</mo></mrow><annotation encoding="application/x-tex">2.00\times</annotation></semantics></math>)</td></tr>
