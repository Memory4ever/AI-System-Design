<td id="S4.T2.4.5.3" class="ltx_td ltx_align_center" style="padding-left:14.0pt;padding-right:14.0pt;">72.2(<span id="S4.T2.4.5.3.1" class="ltx_text" style="--ltx-fg-color:#008000;">+0.7</span>)</td>
<td id="S4.T2.4.5.4" class="ltx_td ltx_align_center" style="padding-left:14.0pt;padding-right:14.0pt;">43.1(<span id="S4.T2.4.5.4.1" class="ltx_text" style="--ltx-fg-color:#008000;">+1.0</span>)</td></tr>
