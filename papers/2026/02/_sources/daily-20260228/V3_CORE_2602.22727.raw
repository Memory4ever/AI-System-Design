<td id="A6.T9.5.1.3" class="ltx_td ltx_align_center ltx_border_tt"><span id="A6.T9.5.1.3.1" class="ltx_text" style="font-size:90%;">CHAIR<sub id="A6.T9.5.1.3.1.1" class="ltx_sub">s</sub> <math id="A6.T9.m1" class="ltx_Math" alttext="\downarrow" display="inline" intent=":literal"><semantics><mo stretchy="false">↓</mo><annotation encoding="application/x-tex">\downarrow</annotation></semantics></math></span></td>
