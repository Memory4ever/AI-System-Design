<td id="A4.T7.5.1.1" class="ltx_td ltx_align_left ltx_border_tt"><span id="A4.T7.5.1.1.1" class="ltx_text ltx_font_bold">Method</span></td>
<td id="A4.T7.5.1.2" class="ltx_td ltx_align_center ltx_border_tt">Overall</td>
