<td id="A6.T9.5.1.5" class="ltx_td ltx_align_center ltx_border_tt"><span id="A6.T9.5.1.5.1" class="ltx_text" style="font-size:90%;">Recall <math id="A6.T9.m3" class="ltx_Math" alttext="\uparrow" display="inline" intent=":literal"><semantics><mo stretchy="false">↑</mo><annotation encoding="application/x-tex">\uparrow</annotation></semantics></math></span></td></tr>
