<td id="A4.T7.5.4.3" class="ltx_td ltx_align_center ltx_border_bb"><span id="A4.T7.5.4.3.1" class="ltx_text ltx_font_bold">16.9</span></td>
<td id="A4.T7.5.4.4" class="ltx_td ltx_align_center ltx_border_bb"><span id="A4.T7.5.4.4.1" class="ltx_text ltx_font_bold">21.4</span></td>
<td id="A4.T7.5.4.5" class="ltx_td ltx_align_center ltx_border_bb"><span id="A4.T7.5.4.5.1" class="ltx_text ltx_font_bold">52.1</span></td></tr>
