<th id="A4.T12.2.1.3" class="ltx_td ltx_align_left ltx_th ltx_th_column ltx_border_t">Ratio: <math id="A4.T12.m1" class="ltx_Math" alttext="d/n" display="inline" intent=":literal"><semantics><mrow><mi>d</mi><mo>/</mo><mi>n</mi></mrow><annotation encoding="application/x-tex">d/n</annotation></semantics></math></th></tr>
</thead>
<tbody class="ltx_tbody">
<tr id="A4.T12.2.2" class="ltx_tr">
<td id="A4.T12.2.2.1" class="ltx_td ltx_align_left ltx_border_b ltx_border_t">
