<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A10.E78Xc.m3" class="ltx_Math" alttext="\displaystyle\frac{\delta_{F_{s}}}{\|\nabla f(w)\|_{F(w)^{-1}}}\|v\|_{F(w)^{-1}}\|v\|_{F_{s}^{\dagger}(w)}\|u\|_{F(w)}," display="inline" intent=":literal"><semantics><mrow><mrow><mstyle displaystyle="true"><mfrac><msub><mi>δ</mi><msub><mi>F</mi><mi>s</mi></msub></msub><msub><mrow><mo stretchy="false">‖</mo><mrow><mrow><mo rspace="0.167em">∇</mo><mi>f</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>w</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">‖</mo></mrow><mrow><mi>F</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>w</mi><mo stretchy="false">)</mo></mrow><mrow><mo>−</mo><mn>1</mn></mrow></msup></mrow></msub></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">‖</mo><mi>v</mi><mo stretchy="false">‖</mo></mrow><mrow><mi>F</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>w</mi><mo stretchy="false">)</mo></mrow><mrow><mo>−</mo><mn>1</mn></mrow></msup></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">‖</mo><mi>v</mi><mo stretchy="false">‖</mo></mrow><mrow><msubsup><mi>F</mi><mi>s</mi><mo>†</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>w</mi><mo stretchy="false">)</mo></mrow></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">‖</mo><mi>u</mi><mo stretchy="false">‖</mo></mrow><mrow><mi>F</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>w</mi><mo stretchy="false">)</mo></mrow></mrow></msub></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\frac{\delta_{F_{s}}}{\|\nabla f(w)\|_{F(w)^{-1}}}\|v\|_{F(w)^{-1}}\|v\|_{F_{s}^{\dagger}(w)}\|u\|_{F(w)},</annotation></semantics></math></td>
