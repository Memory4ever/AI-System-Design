<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A10.E110X.m2" class="ltx_Math" alttext="\displaystyle P_{f}(w)\nabla(F_{s}^{\dagger})(w)[p]" display="inline" intent=":literal"><semantics><mrow><mi>P</mi><msub><mrow></mrow><mi>f</mi></msub><mo stretchy="false">(</mo><mi>w</mi><mo rspace="0.167em" stretchy="false">)</mo><mo>∇</mo><mo stretchy="false">(</mo><mi>F</mi><msub><mrow></mrow><mi>s</mi></msub><msup><mrow></mrow><mo>†</mo></msup><mo stretchy="false">)</mo><mo stretchy="false">(</mo><mi>w</mi><mo stretchy="false">)</mo><mo stretchy="false">[</mo><mi>p</mi><mo stretchy="false">]</mo></mrow><annotation encoding="application/x-tex">\displaystyle P_{f}(w)\nabla(F_{s}^{\dagger})(w)[p]</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A10.E110X.m3" class="ltx_Math" alttext="\displaystyle=P_{f}(w)\left[\nabla P_{s}(w)[p]F^{-1}P_{s}+P_{s}\nabla(F^{-1})(w)[p]P_{s}+P_{s}F^{-1}\nabla P_{s}[p]\right]" display="inline" intent=":literal"><semantics><mrow><mo>=</mo><mi>P</mi><msub><mrow></mrow><mi>f</mi></msub><mo stretchy="false">(</mo><mi>w</mi><mo stretchy="false">)</mo><mo>[</mo><mo rspace="0.167em">∇</mo><mi>P</mi><msub><mrow></mrow><mi>s</mi></msub><mo stretchy="false">(</mo><mi>w</mi><mo stretchy="false">)</mo><mo stretchy="false">[</mo><mi>p</mi><mo stretchy="false">]</mo><mi>F</mi><msup><mrow></mrow><mrow><mo>−</mo><mn>1</mn></mrow></msup><mi>P</mi><msub><mrow></mrow><mi>s</mi></msub><mo>+</mo><mi>P</mi><msub><mrow></mrow><mi>s</mi></msub><mo lspace="0.167em">∇</mo><mo stretchy="false">(</mo><mi>F</mi><msup><mrow></mrow><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo stretchy="false">)</mo><mo stretchy="false">(</mo><mi>w</mi><mo stretchy="false">)</mo><mo stretchy="false">[</mo><mi>p</mi><mo stretchy="false">]</mo><mi>P</mi><msub><mrow></mrow><mi>s</mi></msub><mo>+</mo><mi>P</mi><msub><mrow></mrow><mi>s</mi></msub><mi>F</mi><msup><mrow></mrow><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0.167em" rspace="0.167em">∇</mo><mi>P</mi><msub><mrow></mrow><mi>s</mi></msub><mo stretchy="false">[</mo><mi>p</mi><mo stretchy="false">]</mo><mo>]</mo></mrow><annotation encoding="application/x-tex">\displaystyle=P_{f}(w)\left[\nabla P_{s}(w)[p]F^{-1}P_{s}+P_{s}\nabla(F^{-1})(w)[p]P_{s}+P_{s}F^{-1}\nabla P_{s}[p]\right]</annotation></semantics></math></td>
