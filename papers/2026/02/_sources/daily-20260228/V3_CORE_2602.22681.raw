<td rowspan="3" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equationgroup ltx_align_right">(129)</span></td></tr>
<tr id="A10.E129Xa" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A10.E129Xa.m2" class="ltx_Math" alttext="\displaystyle\leq" display="inline" intent=":literal"><semantics><mo>≤</mo><annotation encoding="application/x-tex">\displaystyle\leq</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A10.E129Xa.m3" class="ltx_Math" alttext="\displaystyle\eta_{t}\delta_{F_{s}}C_{w}\|{m}_{t}\|_{F_{s}^{\dagger}(w_{t})}^{2}+\eta_{t}\delta_{F_{s}}C_{w}\|{m}_{t}\|_{F_{s}^{\dagger}(w_{t})}\|{m}_{t}\|_{F_{f}^{\dagger}(w_{t})}" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>η</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>δ</mi><msub><mi>F</mi><mi>s</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>C</mi><mi>w</mi></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mrow><mo stretchy="false">‖</mo><msub><mi>m</mi><mi>t</mi></msub><mo stretchy="false">‖</mo></mrow><mrow><msubsup><mi>F</mi><mi>s</mi><mo>†</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>w</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mn>2</mn></msubsup></mrow><mo>+</mo><mrow><msub><mi>η</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>δ</mi><msub><mi>F</mi><mi>s</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>C</mi><mi>w</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">‖</mo><msub><mi>m</mi><mi>t</mi></msub><mo stretchy="false">‖</mo></mrow><mrow><msubsup><mi>F</mi><mi>s</mi><mo>†</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>w</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">‖</mo><msub><mi>m</mi><mi>t</mi></msub><mo stretchy="false">‖</mo></mrow><mrow><msubsup><mi>F</mi><mi>f</mi><mo>†</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>w</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow></msub></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\eta_{t}\delta_{F_{s}}C_{w}\|{m}_{t}\|_{F_{s}^{\dagger}(w_{t})}^{2}+\eta_{t}\delta_{F_{s}}C_{w}\|{m}_{t}\|_{F_{s}^{\dagger}(w_{t})}\|{m}_{t}\|_{F_{f}^{\dagger}(w_{t})}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr>
<tr id="A10.E129Xb" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A10.E129Xb.m2" class="ltx_Math" alttext="\displaystyle\leq" display="inline" intent=":literal"><semantics><mo>≤</mo><annotation encoding="application/x-tex">\displaystyle\leq</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A10.E129Xb.m3" class="ltx_Math" alttext="\displaystyle\frac{3}{2}\eta_{t}\delta_{F_{s}}C_{w}\|{m}_{t}\|_{F_{s}^{\dagger}(w_{t})}^{2}+\frac{1}{2}\eta_{t}\delta_{F_{s}}C_{w}\|{m}_{t}\|_{F_{f}^{\dagger}(w_{t})}^{2}," display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mstyle displaystyle="true"><mfrac><mn>3</mn><mn>2</mn></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msub><mi>η</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>δ</mi><msub><mi>F</mi><mi>s</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>C</mi><mi>w</mi></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mrow><mo stretchy="false">‖</mo><msub><mi>m</mi><mi>t</mi></msub><mo stretchy="false">‖</mo></mrow><mrow><msubsup><mi>F</mi><mi>s</mi><mo>†</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>w</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mn>2</mn></msubsup></mrow><mo>+</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mn>2</mn></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msub><mi>η</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>δ</mi><msub><mi>F</mi><mi>s</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>C</mi><mi>w</mi></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mrow><mo stretchy="false">‖</mo><msub><mi>m</mi><mi>t</mi></msub><mo stretchy="false">‖</mo></mrow><mrow><msubsup><mi>F</mi><mi>f</mi><mo>†</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>w</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mn>2</mn></msubsup></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\frac{3}{2}\eta_{t}\delta_{F_{s}}C_{w}\|{m}_{t}\|_{F_{s}^{\dagger}(w_{t})}^{2}+\frac{1}{2}\eta_{t}\delta_{F_{s}}C_{w}\|{m}_{t}\|_{F_{f}^{\dagger}(w_{t})}^{2},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A10.Thmtheorem6.p8.3" class="ltx_p"><span id="A10.Thmtheorem6.p8.3.1" class="ltx_text">where the second inequality uses <math id="A10.Thmtheorem6.p8.m2" class="ltx_Math" alttext="\|{m}_{t}\|_{F^{-1}(w_{t})}\leq\|{m}_{t}\|_{F_{s}^{\dagger}(w_{t})}+\|{m}_{t}\|_{F_{f}^{\dagger}(w_{t})}" display="inline" intent=":literal"><semantics><mrow><msub><mrow><mo stretchy="false">‖</mo><msub><mi>m</mi><mi>t</mi></msub><mo stretchy="false">‖</mo></mrow><mrow><msup><mi>F</mi><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>w</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow></msub><mo>≤</mo><mrow><msub><mrow><mo stretchy="false">‖</mo><msub><mi>m</mi><mi>t</mi></msub><mo stretchy="false">‖</mo></mrow><mrow><msubsup><mi>F</mi><mi>s</mi><mo>†</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>w</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow></msub><mo>+</mo><msub><mrow><mo stretchy="false">‖</mo><msub><mi>m</mi><mi>t</mi></msub><mo stretchy="false">‖</mo></mrow><mrow><msubsup><mi>F</mi><mi>f</mi><mo>†</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>w</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow></msub></mrow></mrow><annotation encoding="application/x-tex">\|{m}_{t}\|_{F^{-1}(w_{t})}\leq\|{m}_{t}\|_{F_{s}^{\dagger}(w_{t})}+\|{m}_{t}\|_{F_{f}^{\dagger}(w_{t})}</annotation></semantics></math> and the
last inequality uses Cauchy inequality.</span></p>
</div>
<div id="A10.Thmtheorem6.p9" class="ltx_para">
<p id="A10.Thmtheorem6.p9.1" class="ltx_p"><span id="A10.Thmtheorem6.p9.1.1" class="ltx_text">Directly computing the time derivative yields</span></p>
<table id="A10.E130" class="ltx_equationgroup ltx_eqn_table">
<tbody>
<tr id="A10.E130X" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A10.E130X.m2" class="ltx_Math" alttext="\displaystyle\frac{d}{dt}V_{t}+\iota_{t}V_{t}=" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mstyle displaystyle="true"><mfrac><mi>d</mi><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msub><mi>V</mi><mi>t</mi></msub></mrow><mo>+</mo><mrow><msub><mi>ι</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>V</mi><mi>t</mi></msub></mrow></mrow><mo>=</mo><mphantom></mphantom></mrow><annotation encoding="application/x-tex">\displaystyle\frac{d}{dt}V_{t}+\iota_{t}V_{t}=</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A10.E130X.m3" class="ltx_Math" alttext="\displaystyle\Delta_{1}+\Delta_{2}+\frac{\eta_{t}}{2}\Delta_{3}-\alpha\eta_{t}\|m_{t}\|_{F_{s}^{\dagger}(w_{t})}^{2}-\beta_{1}\eta_{t}\|\nabla f(w_{t})\|_{F_{s}^{\dagger}(w_{t})}^{2}+\iota_{t}\left(f(w_{t})-f(\Phi(w_{t}))\right)+\frac{\eta_{t}\iota_{t}}{2}\|m_{t}\|_{F_{s}^{\dagger}(w_{t})}^{2}" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><msub><mi mathvariant="normal">Δ</mi><mn>1</mn></msub><mo>+</mo><msub><mi mathvariant="normal">Δ</mi><mn>2</mn></msub><mo>+</mo><mrow><mstyle displaystyle="true"><mfrac><msub><mi>η</mi><mi>t</mi></msub><mn>2</mn></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msub><mi mathvariant="normal">Δ</mi><mn>3</mn></msub></mrow></mrow><mo>−</mo><mrow><mi>α</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>η</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mrow><mo stretchy="false">‖</mo><msub><mi>m</mi><mi>t</mi></msub><mo stretchy="false">‖</mo></mrow><mrow><msubsup><mi>F</mi><mi>s</mi><mo>†</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>w</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mn>2</mn></msubsup></mrow><mo>−</mo><mrow><msub><mi>β</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>η</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mrow><mo stretchy="false">‖</mo><mrow><mrow><mo rspace="0.167em">∇</mo><mi>f</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>w</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">‖</mo></mrow><mrow><msubsup><mi>F</mi><mi>s</mi><mo>†</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>w</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mn>2</mn></msubsup></mrow></mrow><mo>+</mo><mrow><msub><mi>ι</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mrow><mi>f</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>w</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mi>f</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi mathvariant="normal">Φ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>w</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>)</mo></mrow></mrow><mo>+</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><msub><mi>η</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>ι</mi><mi>t</mi></msub></mrow><mn>2</mn></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msubsup><mrow><mo stretchy="false">‖</mo><msub><mi>m</mi><mi>t</mi></msub><mo stretchy="false">‖</mo></mrow><mrow><msubsup><mi>F</mi><mi>s</mi><mo>†</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>w</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mn>2</mn></msubsup></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\Delta_{1}+\Delta_{2}+\frac{\eta_{t}}{2}\Delta_{3}-\alpha\eta_{t}\|m_{t}\|_{F_{s}^{\dagger}(w_{t})}^{2}-\beta_{1}\eta_{t}\|\nabla f(w_{t})\|_{F_{s}^{\dagger}(w_{t})}^{2}+\iota_{t}\left(f(w_{t})-f(\Phi(w_{t}))\right)+\frac{\eta_{t}\iota_{t}}{2}\|m_{t}\|_{F_{s}^{\dagger}(w_{t})}^{2}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="3" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equationgroup ltx_align_right">(130)</span></td></tr>
<tr id="A10.E130Xa" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A10.E130Xa.m2" class="ltx_Math" alttext="\displaystyle\leq" display="inline" intent=":literal"><semantics><mo>≤</mo><annotation encoding="application/x-tex">\displaystyle\leq</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A10.E130Xa.m3" class="ltx_Math" alttext="\displaystyle\left(-\beta_{1}\eta_{t}+\frac{\iota_{t}}{2\gamma}+2\epsilon_{\Phi}(\frac{1}{\alpha}+\beta_{1})\eta_{t}\right)\|\nabla f(w_{t})\|_{F_{s}^{\dagger}(w_{t})}^{2}+\left(-\alpha\eta_{t}+\frac{\eta_{t}\iota_{t}}{2}+\frac{1}{2}\epsilon_{\Phi}\alpha\eta_{t}+\eta_{t}^{2}\delta_{F_{s}}C_{w}\right)\|m_{t}\|_{F_{s}^{\dagger}(w_{t})}^{2}" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mo>(</mo><mrow><mrow><mo>−</mo><mrow><msub><mi>β</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>η</mi><mi>t</mi></msub></mrow></mrow><mo>+</mo><mstyle displaystyle="true"><mfrac><msub><mi>ι</mi><mi>t</mi></msub><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>γ</mi></mrow></mfrac></mstyle><mo>+</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>ϵ</mi><mi mathvariant="normal">Φ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>α</mi></mfrac></mstyle><mo>+</mo><msub><mi>β</mi><mn>1</mn></msub></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>η</mi><mi>t</mi></msub></mrow></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msubsup><mrow><mo stretchy="false">‖</mo><mrow><mrow><mo rspace="0.167em">∇</mo><mi>f</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>w</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">‖</mo></mrow><mrow><msubsup><mi>F</mi><mi>s</mi><mo>†</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>w</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mn>2</mn></msubsup></mrow><mo>+</mo><mrow><mrow><mo>(</mo><mrow><mrow><mo>−</mo><mrow><mi>α</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>η</mi><mi>t</mi></msub></mrow></mrow><mo>+</mo><mstyle displaystyle="true"><mfrac><mrow><msub><mi>η</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>ι</mi><mi>t</mi></msub></mrow><mn>2</mn></mfrac></mstyle><mo>+</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mn>2</mn></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msub><mi>ϵ</mi><mi mathvariant="normal">Φ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi>α</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>η</mi><mi>t</mi></msub></mrow><mo>+</mo><mrow><msubsup><mi>η</mi><mi>t</mi><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mi>δ</mi><msub><mi>F</mi><mi>s</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>C</mi><mi>w</mi></msub></mrow></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msubsup><mrow><mo stretchy="false">‖</mo><msub><mi>m</mi><mi>t</mi></msub><mo stretchy="false">‖</mo></mrow><mrow><msubsup><mi>F</mi><mi>s</mi><mo>†</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>w</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mn>2</mn></msubsup></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\left(-\beta_{1}\eta_{t}+\frac{\iota_{t}}{2\gamma}+2\epsilon_{\Phi}(\frac{1}{\alpha}+\beta_{1})\eta_{t}\right)\|\nabla f(w_{t})\|_{F_{s}^{\dagger}(w_{t})}^{2}+\left(-\alpha\eta_{t}+\frac{\eta_{t}\iota_{t}}{2}+\frac{1}{2}\epsilon_{\Phi}\alpha\eta_{t}+\eta_{t}^{2}\delta_{F_{s}}C_{w}\right)\|m_{t}\|_{F_{s}^{\dagger}(w_{t})}^{2}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr>
<tr id="A10.E130Xb" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A10.E130Xb.m2" class="ltx_Math" alttext="\displaystyle+\epsilon_{\Phi}(\frac{1}{\alpha}+\frac{\beta_{1}}{2}+\chi\beta_{2}+\frac{\chi^{2}\beta_{2}^{2}\alpha}{2})\eta_{t}\|\nabla f(w_{t})\|_{F_{f}^{\dagger}(w_{t})}^{2}+(\frac{1}{4}\eta_{t}^{2}\delta_{F_{s}}C_{w}+\frac{\epsilon_{\Phi}\alpha}{2}\eta_{t}\chi^{2})\|{m}_{t}\|_{F_{f}^{\dagger}(w_{t})}^{2}," display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mo>+</mo><mrow><msub><mi>ϵ</mi><mi mathvariant="normal">Φ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>α</mi></mfrac></mstyle><mo>+</mo><mstyle displaystyle="true"><mfrac><msub><mi>β</mi><mn>1</mn></msub><mn>2</mn></mfrac></mstyle><mo>+</mo><mrow><mi>χ</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>β</mi><mn>2</mn></msub></mrow><mo>+</mo><mstyle displaystyle="true"><mfrac><mrow><msup><mi>χ</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>β</mi><mn>2</mn><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>α</mi></mrow><mn>2</mn></mfrac></mstyle></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>η</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mrow><mo stretchy="false">‖</mo><mrow><mrow><mo rspace="0.167em">∇</mo><mi>f</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>w</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">‖</mo></mrow><mrow><msubsup><mi>F</mi><mi>f</mi><mo>†</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>w</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mn>2</mn></msubsup></mrow></mrow><mo>+</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mn>4</mn></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>η</mi><mi>t</mi><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mi>δ</mi><msub><mi>F</mi><mi>s</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>C</mi><mi>w</mi></msub></mrow><mo>+</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><msub><mi>ϵ</mi><mi mathvariant="normal">Φ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi>α</mi></mrow><mn>2</mn></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msub><mi>η</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><msup><mi>χ</mi><mn>2</mn></msup></mrow></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msubsup><mrow><mo stretchy="false">‖</mo><msub><mi>m</mi><mi>t</mi></msub><mo stretchy="false">‖</mo></mrow><mrow><msubsup><mi>F</mi><mi>f</mi><mo>†</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>w</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mn>2</mn></msubsup></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle+\epsilon_{\Phi}(\frac{1}{\alpha}+\frac{\beta_{1}}{2}+\chi\beta_{2}+\frac{\chi^{2}\beta_{2}^{2}\alpha}{2})\eta_{t}\|\nabla f(w_{t})\|_{F_{f}^{\dagger}(w_{t})}^{2}+(\frac{1}{4}\eta_{t}^{2}\delta_{F_{s}}C_{w}+\frac{\epsilon_{\Phi}\alpha}{2}\eta_{t}\chi^{2})\|{m}_{t}\|_{F_{f}^{\dagger}(w_{t})}^{2},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="A10.Thmtheorem6.p10" class="ltx_para">
<p id="A10.Thmtheorem6.p10.1" class="ltx_p"><span id="A10.Thmtheorem6.p10.1.1" class="ltx_text">where the inequality uses <math id="A10.Thmtheorem6.p10.m1" class="ltx_Math" alttext="\dot{\eta}_{t}\leq 0" display="inline" intent=":literal"><semantics><mrow><msub><mover accent="true"><mi>η</mi><mo>˙</mo></mover><mi>t</mi></msub><mo>≤</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\dot{\eta}_{t}\leq 0</annotation></semantics></math>, (<a href="#A10.E94" title="Equation 94 ‣ Lemma J.4. ‣ J.1 Landscape Analysis ‣ Appendix J Proof ‣ Accelerating LLM Pre-Training through Flat-Direction Dynamics Enhancement" class="ltx_ref"><span class="ltx_text ltx_ref_tag">94</span></a>), (<a href="#A10.E128" title="Equation 128 ‣ Proof. ‣ Lemma J.6. ‣ J.2 Dynamics Analysis ‣ Appendix J Proof ‣ Accelerating LLM Pre-Training through Flat-Direction Dynamics Enhancement" class="ltx_ref"><span class="ltx_text ltx_ref_tag">128</span></a>) and (<a href="#A10.E129" title="Equation 129 ‣ Proof. ‣ Lemma J.6. ‣ J.2 Dynamics Analysis ‣ Appendix J Proof ‣ Accelerating LLM Pre-Training through Flat-Direction Dynamics Enhancement" class="ltx_ref"><span class="ltx_text ltx_ref_tag">129</span></a>).</span></p>
</div>
<div id="A10.Thmtheorem6.p11" class="ltx_para">
<p id="A10.Thmtheorem6.p11.1" class="ltx_p"><span id="A10.Thmtheorem6.p11.1.1" class="ltx_text">Now set <math id="A10.Thmtheorem6.p11.m1" class="ltx_Math" alttext="\epsilon_{u}=\epsilon_{\Phi}(\frac{1}{\alpha}+\frac{\beta_{1}}{2}+\chi\beta_{2}+\frac{\chi^{2}\beta_{2}^{2}\alpha}{2})\eta_{t}+(\frac{1}{4}\eta_{t}^{2}\delta_{F_{s}}C_{w}+\frac{\epsilon_{\Phi}\alpha}{2}\eta_{t}\chi^{2})" display="inline" intent=":literal"><semantics><mrow><msub><mi>ϵ</mi><mi>u</mi></msub><mo>=</mo><mrow><mrow><msub><mi>ϵ</mi><mi mathvariant="normal">Φ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mfrac><mn>1</mn><mi>α</mi></mfrac><mo>+</mo><mfrac><msub><mi>β</mi><mn>1</mn></msub><mn>2</mn></mfrac><mo>+</mo><mrow><mi>χ</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>β</mi><mn>2</mn></msub></mrow><mo>+</mo><mfrac><mrow><msup><mi>χ</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>β</mi><mn>2</mn><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>α</mi></mrow><mn>2</mn></mfrac></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>η</mi><mi>t</mi></msub></mrow><mo>+</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mfrac><mn>1</mn><mn>4</mn></mfrac><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>η</mi><mi>t</mi><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mi>δ</mi><msub><mi>F</mi><mi>s</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>C</mi><mi>w</mi></msub></mrow><mo>+</mo><mrow><mfrac><mrow><msub><mi>ϵ</mi><mi mathvariant="normal">Φ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi>α</mi></mrow><mn>2</mn></mfrac><mo lspace="0em" rspace="0em">​</mo><msub><mi>η</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><msup><mi>χ</mi><mn>2</mn></msup></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\epsilon_{u}=\epsilon_{\Phi}(\frac{1}{\alpha}+\frac{\beta_{1}}{2}+\chi\beta_{2}+\frac{\chi^{2}\beta_{2}^{2}\alpha}{2})\eta_{t}+(\frac{1}{4}\eta_{t}^{2}\delta_{F_{s}}C_{w}+\frac{\epsilon_{\Phi}\alpha}{2}\eta_{t}\chi^{2})</annotation></semantics></math> and <math id="A10.Thmtheorem6.p11.m2" class="ltx_Math" alttext="U_{t}=\|\nabla f(w_{t})\|_{F_{f}^{\dagger}(w_{t})}^{2}+\|m_{t}\|_{F_{f}^{\dagger}(w_{t})}^{2}" display="inline" intent=":literal"><semantics><mrow><msub><mi>U</mi><mi>t</mi></msub><mo>=</mo><mrow><msubsup><mrow><mo stretchy="false">‖</mo><mrow><mrow><mo rspace="0.167em">∇</mo><mi>f</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>w</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">‖</mo></mrow><mrow><msubsup><mi>F</mi><mi>f</mi><mo>†</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>w</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mn>2</mn></msubsup><mo>+</mo><msubsup><mrow><mo stretchy="false">‖</mo><msub><mi>m</mi><mi>t</mi></msub><mo stretchy="false">‖</mo></mrow><mrow><msubsup><mi>F</mi><mi>f</mi><mo>†</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>w</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mn>2</mn></msubsup></mrow></mrow><annotation encoding="application/x-tex">U_{t}=\|\nabla f(w_{t})\|_{F_{f}^{\dagger}(w_{t})}^{2}+\|m_{t}\|_{F_{f}^{\dagger}(w_{t})}^{2}</annotation></semantics></math>.</span></p>
</div>
<div id="A10.Thmtheorem6.p12" class="ltx_para">
<p id="A10.Thmtheorem6.p12.1" class="ltx_p"><span id="A10.Thmtheorem6.p12.1.1" class="ltx_text">Then by conditions in (<a href="#A10.E122" title="Equation 122 ‣ Lemma J.6. ‣ J.2 Dynamics Analysis ‣ Appendix J Proof ‣ Accelerating LLM Pre-Training through Flat-Direction Dynamics Enhancement" class="ltx_ref"><span class="ltx_text ltx_ref_tag">122</span></a>),
we have</span></p>
<table id="A10.E131" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A10.E131.m1" class="ltx_Math" alttext="\frac{d}{dt}V_{t}+\iota_{t}V_{t}\leq\epsilon_{u}U_{t}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mrow><mfrac><mi>d</mi><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></mfrac><mo lspace="0em" rspace="0em">​</mo><msub><mi>V</mi><mi>t</mi></msub></mrow><mo>+</mo><mrow><msub><mi>ι</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>V</mi><mi>t</mi></msub></mrow></mrow><mo>≤</mo><mrow><msub><mi>ϵ</mi><mi>u</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>U</mi><mi>t</mi></msub></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\frac{d}{dt}V_{t}+\iota_{t}V_{t}\leq\epsilon_{u}U_{t}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(131)</span></td></tr></tbody>
</table>
</div>
<div id="A10.Thmtheorem6.p13" class="ltx_para">
<p id="A10.Thmtheorem6.p13.1" class="ltx_p"><span id="A10.Thmtheorem6.p13.1.1" class="ltx_text">Integrating <math id="A10.Thmtheorem6.p13.m1" class="ltx_Math" alttext="\frac{d}{dt}(e^{\int_{0}^{t}\iota_{s}ds}V_{t})" display="inline" intent=":literal"><semantics><mrow><mfrac><mi>d</mi><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></mfrac><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mi>e</mi><mrow><mstyle displaystyle="false"><msubsup><mo maxsize="0.700em" minsize="0.700em" stretchy="true">∫</mo><mn>0</mn><mi>t</mi></msubsup></mstyle><mrow><msub><mi>ι</mi><mi>s</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo rspace="0em">𝑑</mo><mi>s</mi></mrow></mrow></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>V</mi><mi>t</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\frac{d}{dt}(e^{\int_{0}^{t}\iota_{s}ds}V_{t})</annotation></semantics></math> yields</span></p>
<table id="A10.E132" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A10.E132.m1" class="ltx_Math" alttext="e^{\int_{0}^{t}\iota_{s}ds}V_{t}\leq V_{0}+\epsilon_{u}\int_{0}^{t}e^{\int_{0}^{s}\iota_{\tau}d\tau}U_{s}ds." display="block" intent=":literal"><semantics><mrow><mrow><mrow><msup><mi>e</mi><mrow><mstyle displaystyle="false"><msubsup><mo maxsize="0.700em" minsize="0.700em" stretchy="true">∫</mo><mn>0</mn><mi>t</mi></msubsup></mstyle><mrow><msub><mi>ι</mi><mi>s</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo rspace="0em">𝑑</mo><mi>s</mi></mrow></mrow></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>V</mi><mi>t</mi></msub></mrow><mo>≤</mo><mrow><msub><mi>V</mi><mn>0</mn></msub><mo>+</mo><mrow><msub><mi>ϵ</mi><mi>u</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><msubsup><mo>∫</mo><mn>0</mn><mi>t</mi></msubsup><mrow><msup><mi>e</mi><mrow><mstyle displaystyle="false"><msubsup><mo maxsize="0.700em" minsize="0.700em" stretchy="true">∫</mo><mn>0</mn><mi>s</mi></msubsup></mstyle><mrow><msub><mi>ι</mi><mi>τ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo rspace="0em">𝑑</mo><mi>τ</mi></mrow></mrow></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>U</mi><mi>s</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo rspace="0em">𝑑</mo><mi>s</mi></mrow></mrow></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">e^{\int_{0}^{t}\iota_{s}ds}V_{t}\leq V_{0}+\epsilon_{u}\int_{0}^{t}e^{\int_{0}^{s}\iota_{\tau}d\tau}U_{s}ds.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(132)</span></td></tr></tbody>
</table>
</div>
<div id="A10.Thmtheorem6.p14" class="ltx_para">
<p id="A10.Thmtheorem6.p14.1" class="ltx_p"><span id="A10.Thmtheorem6.p14.1.1" class="ltx_text">By (<a href="#A10.E93" title="Equation 93 ‣ Lemma J.4. ‣ J.1 Landscape Analysis ‣ Appendix J Proof ‣ Accelerating LLM Pre-Training through Flat-Direction Dynamics Enhancement" class="ltx_ref"><span class="ltx_text ltx_ref_tag">93</span></a>) in Lemma <a href="#A10.Thmtheorem4" title="Lemma J.4. ‣ J.1 Landscape Analysis ‣ Appendix J Proof ‣ Accelerating LLM Pre-Training through Flat-Direction Dynamics Enhancement" class="ltx_ref"><span class="ltx_text ltx_ref_tag">J.4</span></a>, we obtain</span></p>
</div>
<div id="A10.Thmtheorem6.p15" class="ltx_para">
<table id="A10.E133" class="ltx_equationgroup ltx_eqn_table">
<tbody>
<tr id="A10.E133X" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A10.E133X.m2" class="ltx_Math" alttext="\displaystyle\|w_{t}-\Phi(w_{t})\|_{2}^{2}+\eta_{t}\|m_{t}\|_{F_{s}^{\dagger}(w_{t})}^{2}\lesssim" display="inline" intent=":literal"><semantics><mrow><mrow><msubsup><mrow><mo stretchy="false">‖</mo><mrow><msub><mi>w</mi><mi>t</mi></msub><mo>−</mo><mrow><mi mathvariant="normal">Φ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>w</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn><mn>2</mn></msubsup><mo>+</mo><mrow><msub><mi>η</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mrow><mo stretchy="false">‖</mo><msub><mi>m</mi><mi>t</mi></msub><mo stretchy="false">‖</mo></mrow><mrow><msubsup><mi>F</mi><mi>s</mi><mo>†</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>w</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mn>2</mn></msubsup></mrow></mrow><mo>≲</mo><mphantom></mphantom></mrow><annotation encoding="application/x-tex">\displaystyle\|w_{t}-\Phi(w_{t})\|_{2}^{2}+\eta_{t}\|m_{t}\|_{F_{s}^{\dagger}(w_{t})}^{2}\lesssim</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A10.E133X.m3" class="ltx_Math" alttext="\displaystyle\exp\left(-{\int_{0}^{t}\iota_{s}ds}\right)" display="inline" intent=":literal"><semantics><mrow><mi>exp</mi><mo>(</mo><mo lspace="0em">−</mo><mstyle displaystyle="true"><mo>∫</mo></mstyle><msub><mrow></mrow><mn>0</mn></msub><msup><mrow></mrow><mi>t</mi></msup><mi>ι</mi><msub><mrow></mrow><mi>s</mi></msub><mi>d</mi><mi>s</mi><mo>)</mo></mrow><annotation encoding="application/x-tex">\displaystyle\exp\left(-{\int_{0}^{t}\iota_{s}ds}\right)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="2" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equationgroup ltx_align_right">(133)</span></td></tr>
<tr id="A10.E133Xa" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A10.E133Xa.m2" class="ltx_Math" alttext="\displaystyle+\varepsilon" display="inline" intent=":literal"><semantics><mrow><mo>+</mo><mi>ε</mi></mrow><annotation encoding="application/x-tex">\displaystyle+\varepsilon</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A10.E133Xa.m3" class="ltx_Math" alttext="\displaystyle\int_{0}^{t}\exp\left({-\int_{s}^{t}\iota_{\tau}d\tau}\right)(\|\nabla f(w_{s})\|_{F_{f}^{\dagger}(w_{s})}^{2}+\|m_{s}\|_{F_{f}^{\dagger}(w_{s})}^{2})ds." display="inline" intent=":literal"><semantics><mrow><mstyle displaystyle="true"><mo>∫</mo></mstyle><msub><mrow></mrow><mn>0</mn></msub><msup><mrow></mrow><mi>t</mi></msup><mi>exp</mi><mo>(</mo><mo lspace="0em">−</mo><mstyle displaystyle="true"><mo>∫</mo></mstyle><msub><mrow></mrow><mi>s</mi></msub><msup><mrow></mrow><mi>t</mi></msup><mi>ι</mi><msub><mrow></mrow><mi>τ</mi></msub><mi>d</mi><mi>τ</mi><mo>)</mo><mo stretchy="false">(</mo><mo lspace="0em" rspace="0.167em">∥</mo><mo rspace="0.167em">∇</mo><mi>f</mi><mo stretchy="false">(</mo><mi>w</mi><msub><mrow></mrow><mi>s</mi></msub><mo stretchy="false">)</mo><mo lspace="0em" rspace="0em">∥</mo><msub><mrow></mrow><mrow><msubsup><mi>F</mi><mi>f</mi><mo>†</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>w</mi><mi>s</mi></msub><mo stretchy="false">)</mo></mrow></mrow></msub><msup><mrow></mrow><mn>2</mn></msup><mo lspace="0em" rspace="0em">+</mo><mo lspace="0em" rspace="0.167em">∥</mo><mi>m</mi><msub><mrow></mrow><mi>s</mi></msub><mo lspace="0em" rspace="0.167em">∥</mo><msub><mrow></mrow><mrow><msubsup><mi>F</mi><mi>f</mi><mo>†</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>w</mi><mi>s</mi></msub><mo stretchy="false">)</mo></mrow></mrow></msub><msup><mrow></mrow><mn>2</mn></msup><mo stretchy="false">)</mo><mi>d</mi><mi>s</mi><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\int_{0}^{t}\exp\left({-\int_{s}^{t}\iota_{\tau}d\tau}\right)(\|\nabla f(w_{s})\|_{F_{f}^{\dagger}(w_{s})}^{2}+\|m_{s}\|_{F_{f}^{\dagger}(w_{s})}^{2})ds.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="A10.Thmtheorem6.p16" class="ltx_para">
<p id="A10.Thmtheorem6.p16.1" class="ltx_p"><span id="A10.Thmtheorem6.p16.1.1" class="ltx_text">If we further take <math id="A10.Thmtheorem6.p16.m1" class="ltx_Math" alttext="\alpha=2\eta_{0}\lambda_{H_{F,s}}^{\frac{1}{2}}" display="inline" intent=":literal"><semantics><mrow><mi>α</mi><mo>=</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>η</mi><mn>0</mn></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>λ</mi><msub><mi>H</mi><mrow><mi>F</mi><mo>,</mo><mi>s</mi></mrow></msub><mfrac><mn>1</mn><mn>2</mn></mfrac></msubsup></mrow></mrow><annotation encoding="application/x-tex">\alpha=2\eta_{0}\lambda_{H_{F,s}}^{\frac{1}{2}}</annotation></semantics></math> and <math id="A10.Thmtheorem6.p16.m2" class="ltx_Math" alttext="\beta_{1}=\lambda_{H_{F,s}}^{-\frac{1}{2}}" display="inline" intent=":literal"><semantics><mrow><msub><mi>β</mi><mn>1</mn></msub><mo>=</mo><msubsup><mi>λ</mi><msub><mi>H</mi><mrow><mi>F</mi><mo>,</mo><mi>s</mi></mrow></msub><mrow><mo>−</mo><mfrac><mn>1</mn><mn>2</mn></mfrac></mrow></msubsup></mrow><annotation encoding="application/x-tex">\beta_{1}=\lambda_{H_{F,s}}^{-\frac{1}{2}}</annotation></semantics></math>, then <math id="A10.Thmtheorem6.p16.m3" class="ltx_Math" alttext="\iota_{t}=\eta_{t}\lambda_{H_{F,s}}^{\frac{1}{2}}" display="inline" intent=":literal"><semantics><mrow><msub><mi>ι</mi><mi>t</mi></msub><mo>=</mo><mrow><msub><mi>η</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>λ</mi><msub><mi>H</mi><mrow><mi>F</mi><mo>,</mo><mi>s</mi></mrow></msub><mfrac><mn>1</mn><mn>2</mn></mfrac></msubsup></mrow></mrow><annotation encoding="application/x-tex">\iota_{t}=\eta_{t}\lambda_{H_{F,s}}^{\frac{1}{2}}</annotation></semantics></math>, and we finally get</span></p>
</div>
<div id="A10.Thmtheorem6.p17" class="ltx_para">
<table id="A10.E134" class="ltx_equationgroup ltx_eqn_table">
<tbody>
<tr id="A10.E134X" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A10.E134X.m2" class="ltx_Math" alttext="\displaystyle\|w_{t}-\Phi(w_{t})\|_{2}^{2}+\eta_{t}\|m_{t}\|_{F_{s}^{\dagger}(w_{t})}^{2}\lesssim" display="inline" intent=":literal"><semantics><mrow><mrow><msubsup><mrow><mo stretchy="false">‖</mo><mrow><msub><mi>w</mi><mi>t</mi></msub><mo>−</mo><mrow><mi mathvariant="normal">Φ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>w</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn><mn>2</mn></msubsup><mo>+</mo><mrow><msub><mi>η</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mrow><mo stretchy="false">‖</mo><msub><mi>m</mi><mi>t</mi></msub><mo stretchy="false">‖</mo></mrow><mrow><msubsup><mi>F</mi><mi>s</mi><mo>†</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>w</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mn>2</mn></msubsup></mrow></mrow><mo>≲</mo><mphantom></mphantom></mrow><annotation encoding="application/x-tex">\displaystyle\|w_{t}-\Phi(w_{t})\|_{2}^{2}+\eta_{t}\|m_{t}\|_{F_{s}^{\dagger}(w_{t})}^{2}\lesssim</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A10.E134X.m3" class="ltx_Math" alttext="\displaystyle\exp\left({-\lambda_{H_{F,s}}^{\frac{1}{2}}\int_{0}^{t}\eta_{s}ds}\right)" display="inline" intent=":literal"><semantics><mrow><mi>exp</mi><mo>(</mo><mo lspace="0em">−</mo><mi>λ</mi><msub><mrow></mrow><msub><mi>H</mi><mrow><mi>F</mi><mo>,</mo><mi>s</mi></mrow></msub></msub><msup><mrow></mrow><mfrac><mn>1</mn><mn>2</mn></mfrac></msup><mstyle displaystyle="true"><mo>∫</mo></mstyle><msub><mrow></mrow><mn>0</mn></msub><msup><mrow></mrow><mi>t</mi></msup><mi>η</mi><msub><mrow></mrow><mi>s</mi></msub><mi>d</mi><mi>s</mi><mo>)</mo></mrow><annotation encoding="application/x-tex">\displaystyle\exp\left({-\lambda_{H_{F,s}}^{\frac{1}{2}}\int_{0}^{t}\eta_{s}ds}\right)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="2" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equationgroup ltx_align_right">(134)</span></td></tr>
<tr id="A10.E134Xa" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A10.E134Xa.m2" class="ltx_Math" alttext="\displaystyle+\varepsilon" display="inline" intent=":literal"><semantics><mrow><mo>+</mo><mi>ε</mi></mrow><annotation encoding="application/x-tex">\displaystyle+\varepsilon</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A10.E134Xa.m3" class="ltx_Math" alttext="\displaystyle\int_{0}^{t}\exp\left({-\lambda_{H_{F,s}}^{\frac{1}{2}}\int_{s}^{t}\eta_{\tau}d\tau}\right)(\|\nabla f(w_{s})\|_{F_{f}^{\dagger}(w_{s})}^{2}+\|m_{s}\|_{F_{f}^{\dagger}(w_{s})}^{2})ds." display="inline" intent=":literal"><semantics><mrow><mstyle displaystyle="true"><mo>∫</mo></mstyle><msub><mrow></mrow><mn>0</mn></msub><msup><mrow></mrow><mi>t</mi></msup><mi>exp</mi><mo>(</mo><mo lspace="0em">−</mo><mi>λ</mi><msub><mrow></mrow><msub><mi>H</mi><mrow><mi>F</mi><mo>,</mo><mi>s</mi></mrow></msub></msub><msup><mrow></mrow><mfrac><mn>1</mn><mn>2</mn></mfrac></msup><mstyle displaystyle="true"><mo>∫</mo></mstyle><msub><mrow></mrow><mi>s</mi></msub><msup><mrow></mrow><mi>t</mi></msup><mi>η</mi><msub><mrow></mrow><mi>τ</mi></msub><mi>d</mi><mi>τ</mi><mo>)</mo><mo stretchy="false">(</mo><mo lspace="0em" rspace="0.167em">∥</mo><mo rspace="0.167em">∇</mo><mi>f</mi><mo stretchy="false">(</mo><mi>w</mi><msub><mrow></mrow><mi>s</mi></msub><mo stretchy="false">)</mo><mo lspace="0em" rspace="0em">∥</mo><msub><mrow></mrow><mrow><msubsup><mi>F</mi><mi>f</mi><mo>†</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>w</mi><mi>s</mi></msub><mo stretchy="false">)</mo></mrow></mrow></msub><msup><mrow></mrow><mn>2</mn></msup><mo lspace="0em" rspace="0em">+</mo><mo lspace="0em" rspace="0.167em">∥</mo><mi>m</mi><msub><mrow></mrow><mi>s</mi></msub><mo lspace="0em" rspace="0.167em">∥</mo><msub><mrow></mrow><mrow><msubsup><mi>F</mi><mi>f</mi><mo>†</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>w</mi><mi>s</mi></msub><mo stretchy="false">)</mo></mrow></mrow></msub><msup><mrow></mrow><mn>2</mn></msup><mo stretchy="false">)</mo><mi>d</mi><mi>s</mi><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\int_{0}^{t}\exp\left({-\lambda_{H_{F,s}}^{\frac{1}{2}}\int_{s}^{t}\eta_{\tau}d\tau}\right)(\|\nabla f(w_{s})\|_{F_{f}^{\dagger}(w_{s})}^{2}+\|m_{s}\|_{F_{f}^{\dagger}(w_{s})}^{2})ds.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="A10.Thmtheorem6.p18" class="ltx_para">
<p id="A10.Thmtheorem6.p18.1" class="ltx_p"><span id="A10.Thmtheorem6.p18.1.1" class="ltx_text">∎</span></p>
</div>
</div>
</div>
<div id="A10.Thmtheorem8" class="ltx_theorem ltx_theorem_lemma">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="A10.Thmtheorem8.2" class="ltx_text ltx_font_bold">Lemma J.8</span></span><span id="A10.Thmtheorem8.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="A10.Thmtheorem8.p1" class="ltx_para">
<p id="A10.Thmtheorem8.p1.1" class="ltx_p"><span id="A10.Thmtheorem8.p1.1.1" class="ltx_text ltx_font_italic">Suppose Assumptions <a href="#S7.Thmtheorem1" title="Assumption 7.1 (River Structure). ‣ 7 Theoretical Analysis to Training Dynamics ‣ Accelerating LLM Pre-Training through Flat-Direction Dynamics Enhancement" class="ltx_ref"><span class="ltx_text ltx_ref_tag">7.1</span></a> and <a href="#S7.Thmtheorem2" title="Assumption 7.2 (Regularity, Smoothness and Conservation). ‣ 7 Theoretical Analysis to Training Dynamics ‣ Accelerating LLM Pre-Training through Flat-Direction Dynamics Enhancement" class="ltx_ref"><span class="ltx_text ltx_ref_tag">7.2</span></a> hold. For any <math id="A10.Thmtheorem8.p1.m1" class="ltx_Math" alttext="z\in\mathcal{R}" display="inline" intent=":literal"><semantics><mrow><mi>z</mi><mo>∈</mo><mi class="ltx_font_mathcaligraphic">ℛ</mi></mrow><annotation encoding="application/x-tex">z\in\mathcal{R}</annotation></semantics></math>, we have</span></p>
<table id="A10.E135" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A10.E135.m1" class="ltx_Math" alttext="\|P_{\mathcal{R}}(z)v-P_{f}(z)v\|_{F(z)}\leq\frac{\delta_{F_{s}}}{\lambda_{H_{F},s}}\|v\|_{F(z)}." display="block" intent=":literal"><semantics><mrow><mrow><msub><mrow><mo stretchy="false">‖</mo><mrow><mrow><msub><mi>P</mi><mi class="ltx_font_mathcaligraphic">ℛ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>z</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>v</mi></mrow><mo>−</mo><mrow><msub><mi>P</mi><mi>f</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>z</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>v</mi></mrow></mrow><mo stretchy="false">‖</mo></mrow><mrow><mi>F</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>z</mi><mo stretchy="false">)</mo></mrow></mrow></msub><mo>≤</mo><mrow><mfrac><msub><mi>δ</mi><msub><mi>F</mi><mi>s</mi></msub></msub><msub><mi>λ</mi><mrow><msub><mi>H</mi><mi>F</mi></msub><mo>,</mo><mi>s</mi></mrow></msub></mfrac><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">‖</mo><mi>v</mi><mo stretchy="false">‖</mo></mrow><mrow><mi>F</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>z</mi><mo stretchy="false">)</mo></mrow></mrow></msub></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\|P_{\mathcal{R}}(z)v-P_{f}(z)v\|_{F(z)}\leq\frac{\delta_{F_{s}}}{\lambda_{H_{F},s}}\|v\|_{F(z)}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(135)</span></td></tr></tbody>
</table>
</div>
<div id="A10.Thmtheorem8.4" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="A10.Thmtheorem8.p2" class="ltx_para">
<p id="A10.Thmtheorem8.p2.1" class="ltx_p"><span id="A10.Thmtheorem8.p2.1.1" class="ltx_text">We first compute the closed form of <math id="A10.Thmtheorem8.p2.m1" class="ltx_Math" alttext="P_{\mathcal{R}}" display="inline" intent=":literal"><semantics><msub><mi>P</mi><mi class="ltx_font_mathcaligraphic">ℛ</mi></msub><annotation encoding="application/x-tex">P_{\mathcal{R}}</annotation></semantics></math>. Let <math id="A10.Thmtheorem8.p2.m2" class="ltx_Math" alttext="\mathbf{0}^{p}" display="inline" intent=":literal"><semantics><msup><mn>𝟎</mn><mi>p</mi></msup><annotation encoding="application/x-tex">\mathbf{0}^{p}</annotation></semantics></math> denote the <math id="A10.Thmtheorem8.p2.m3" class="ltx_Math" alttext="p" display="inline" intent=":literal"><semantics><mi>p</mi><annotation encoding="application/x-tex">p</annotation></semantics></math> dimensional all zero vector. Note that the <math id="A10.Thmtheorem8.p2.m4" class="ltx_Math" alttext="p-k" display="inline" intent=":literal"><semantics><mrow><mi>p</mi><mo>−</mo><mi>k</mi></mrow><annotation encoding="application/x-tex">p-k</annotation></semantics></math> dimensional manifold <math id="A10.Thmtheorem8.p2.m5" class="ltx_Math" alttext="\mathcal{R}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">ℛ</mi><annotation encoding="application/x-tex">\mathcal{R}</annotation></semantics></math> is defined by <math id="A10.Thmtheorem8.p2.m6" class="ltx_math_unparsed" alttext="\mathcal{R}=\{w:P_{s}(w)\nabla f(w)=\mathbf{0}^{p}\}=\{w:F_{s}^{\dagger}(w)\nabla f(w)=\mathbf{0}^{p}\}" display="inline" intent=":literal"><semantics><mrow><mi class="ltx_font_mathcaligraphic">ℛ</mi><mo>=</mo><mrow><mo stretchy="false">{</mo><mi>w</mi><mo lspace="0.278em" rspace="0.278em">:</mo><msub><mi>P</mi><mi>s</mi></msub><mrow><mo stretchy="false">(</mo><mi>w</mi><mo rspace="0.167em" stretchy="false">)</mo></mrow><mo rspace="0.167em">∇</mo><mi>f</mi><mrow><mo stretchy="false">(</mo><mi>w</mi><mo stretchy="false">)</mo></mrow><mo>=</mo><msup><mn>𝟎</mn><mi>p</mi></msup><mo stretchy="false">}</mo></mrow><mo>=</mo><mrow><mo stretchy="false">{</mo><mi>w</mi><mo lspace="0.278em" rspace="0.278em">:</mo><msubsup><mi>F</mi><mi>s</mi><mo>†</mo></msubsup><mrow><mo stretchy="false">(</mo><mi>w</mi><mo rspace="0.167em" stretchy="false">)</mo></mrow><mo rspace="0.167em">∇</mo><mi>f</mi><mrow><mo stretchy="false">(</mo><mi>w</mi><mo stretchy="false">)</mo></mrow><mo>=</mo><msup><mn>𝟎</mn><mi>p</mi></msup><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">\mathcal{R}=\{w:P_{s}(w)\nabla f(w)=\mathbf{0}^{p}\}=\{w:F_{s}^{\dagger}(w)\nabla f(w)=\mathbf{0}^{p}\}</annotation></semantics></math>. Define <math id="A10.Thmtheorem8.p2.m7" class="ltx_math_unparsed" alttext="N(w)=F_{s}^{\dagger}(w)\nabla f(w)" display="inline" intent=":literal"><semantics><mrow><mi>N</mi><mrow><mo stretchy="false">(</mo><mi>w</mi><mo stretchy="false">)</mo></mrow><mo>=</mo><msubsup><mi>F</mi><mi>s</mi><mo>†</mo></msubsup><mrow><mo stretchy="false">(</mo><mi>w</mi><mo rspace="0.167em" stretchy="false">)</mo></mrow><mo rspace="0.167em">∇</mo><mi>f</mi><mrow><mo stretchy="false">(</mo><mi>w</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">N(w)=F_{s}^{\dagger}(w)\nabla f(w)</annotation></semantics></math>. Thus the tangent space is <math id="A10.Thmtheorem8.p2.m8" class="ltx_Math" alttext="T_{z}\mathcal{R}=\{v:\nabla N(z)v=\mathbf{0}^{p}\}" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>T</mi><mi>z</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi class="ltx_font_mathcaligraphic">ℛ</mi></mrow><mo>=</mo><mrow><mo stretchy="false">{</mo><mi>v</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mrow><mrow><mo rspace="0.167em">∇</mo><mi>N</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>z</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>v</mi></mrow><mo>=</mo><msup><mn>𝟎</mn><mi>p</mi></msup></mrow><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">T_{z}\mathcal{R}=\{v:\nabla N(z)v=\mathbf{0}^{p}\}</annotation></semantics></math>.
The projection to <math id="A10.Thmtheorem8.p2.m9" class="ltx_Math" alttext="T_{z}M" display="inline" intent=":literal"><semantics><mrow><msub><mi>T</mi><mi>z</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi>M</mi></mrow><annotation encoding="application/x-tex">T_{z}M</annotation></semantics></math> is given by</span></p>
<table id="A10.E136" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A10.E136.m1" class="ltx_math_unparsed" alttext="P_{\mathcal{R}}(z)v=\operatorname{argmin}_{u\in\mathbb{R}^{p}}\|v-u\|^{2}_{F(z)},\quad\text{s.t. }\nabla N(z)u=\mathbf{0}^{p}." display="block" intent=":literal"><semantics><mrow><msub><mi>P</mi><mi class="ltx_font_mathcaligraphic">ℛ</mi></msub><mrow><mo stretchy="false">(</mo><mi>z</mi><mo stretchy="false">)</mo></mrow><mi>v</mi><mo>=</mo><msub><mi>argmin</mi><mrow><mi>u</mi><mo>∈</mo><msup><mi>ℝ</mi><mi>p</mi></msup></mrow></msub><mo lspace="0em" rspace="0.167em">∥</mo><mi>v</mi><mo>−</mo><mi>u</mi><msubsup><mo lspace="0em" rspace="0.167em">∥</mo><mrow><mi>F</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>z</mi><mo stretchy="false">)</mo></mrow></mrow><mn>2</mn></msubsup><mo rspace="1.167em">,</mo><mtext>s.t. </mtext><mo lspace="0.167em" rspace="0.167em">∇</mo><mi>N</mi><mrow><mo stretchy="false">(</mo><mi>z</mi><mo stretchy="false">)</mo></mrow><mi>u</mi><mo>=</mo><msup><mn>𝟎</mn><mi>p</mi></msup><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">P_{\mathcal{R}}(z)v=\operatorname{argmin}_{u\in\mathbb{R}^{p}}\|v-u\|^{2}_{F(z)},\quad\text{s.t. }\nabla N(z)u=\mathbf{0}^{p}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(136)</span></td></tr></tbody>
</table>
<p id="A10.Thmtheorem8.p2.2" class="ltx_p"><span id="A10.Thmtheorem8.p2.2.1" class="ltx_text">Directly computing <math id="A10.Thmtheorem8.p2.m10" class="ltx_Math" alttext="\nabla N" display="inline" intent=":literal"><semantics><mrow><mo rspace="0.167em">∇</mo><mi>N</mi></mrow><annotation encoding="application/x-tex">\nabla N</annotation></semantics></math> gives <math id="A10.Thmtheorem8.p2.m11" class="ltx_math_unparsed" alttext="\nabla N(z)u=\nabla F_{s}^{\dagger}(w)[u]\nabla f(w)+F_{s}^{\dagger}(w)\nabla f^{2}(w)u" display="inline" intent=":literal"><semantics><mrow><mo rspace="0.167em">∇</mo><mi>N</mi><mrow><mo stretchy="false">(</mo><mi>z</mi><mo stretchy="false">)</mo></mrow><mi>u</mi><mo>=</mo><mo rspace="0.167em">∇</mo><msubsup><mi>F</mi><mi>s</mi><mo>†</mo></msubsup><mrow><mo stretchy="false">(</mo><mi>w</mi><mo stretchy="false">)</mo></mrow><mrow><mo stretchy="false">[</mo><mi>u</mi><mo rspace="0.167em" stretchy="false">]</mo></mrow><mo rspace="0.167em">∇</mo><mi>f</mi><mrow><mo stretchy="false">(</mo><mi>w</mi><mo stretchy="false">)</mo></mrow><mo>+</mo><msubsup><mi>F</mi><mi>s</mi><mo>†</mo></msubsup><mrow><mo stretchy="false">(</mo><mi>w</mi><mo rspace="0.167em" stretchy="false">)</mo></mrow><mo rspace="0.167em">∇</mo><msup><mi>f</mi><mn>2</mn></msup><mrow><mo stretchy="false">(</mo><mi>w</mi><mo stretchy="false">)</mo></mrow><mi>u</mi></mrow><annotation encoding="application/x-tex">\nabla N(z)u=\nabla F_{s}^{\dagger}(w)[u]\nabla f(w)+F_{s}^{\dagger}(w)\nabla f^{2}(w)u</annotation></semantics></math>.</span></p>
</div>
<div id="A10.Thmtheorem8.p3" class="ltx_para">
<p id="A10.Thmtheorem8.p3.1" class="ltx_p"><span id="A10.Thmtheorem8.p3.1.1" class="ltx_text">Noting that <math id="A10.Thmtheorem8.p3.m1" class="ltx_Math" alttext="\|v-u\|^{2}_{F(z)}=\|F(z)^{\frac{1}{2}}v-F(z)^{\frac{1}{2}}u\|^{2}_{2}" display="inline" intent=":literal"><semantics><mrow><msubsup><mrow><mo stretchy="false">‖</mo><mrow><mi>v</mi><mo>−</mo><mi>u</mi></mrow><mo stretchy="false">‖</mo></mrow><mrow><mi>F</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>z</mi><mo stretchy="false">)</mo></mrow></mrow><mn>2</mn></msubsup><mo>=</mo><msubsup><mrow><mo stretchy="false">‖</mo><mrow><mrow><mi>F</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>z</mi><mo stretchy="false">)</mo></mrow><mfrac><mn>1</mn><mn>2</mn></mfrac></msup><mo lspace="0em" rspace="0em">​</mo><mi>v</mi></mrow><mo>−</mo><mrow><mi>F</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>z</mi><mo stretchy="false">)</mo></mrow><mfrac><mn>1</mn><mn>2</mn></mfrac></msup><mo lspace="0em" rspace="0em">​</mo><mi>u</mi></mrow></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn><mn>2</mn></msubsup></mrow><annotation encoding="application/x-tex">\|v-u\|^{2}_{F(z)}=\|F(z)^{\frac{1}{2}}v-F(z)^{\frac{1}{2}}u\|^{2}_{2}</annotation></semantics></math> and <math id="A10.Thmtheorem8.p3.m2" class="ltx_Math" alttext="\nabla N(z)u=\nabla N(z)F(z)^{-\frac{1}{2}}F(z)^{\frac{1}{2}}u" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mo rspace="0.167em">∇</mo><mi>N</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>z</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>u</mi></mrow><mo>=</mo><mrow><mrow><mo rspace="0.167em">∇</mo><mi>N</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>z</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>F</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>z</mi><mo stretchy="false">)</mo></mrow><mrow><mo>−</mo><mfrac><mn>1</mn><mn>2</mn></mfrac></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mi>F</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>z</mi><mo stretchy="false">)</mo></mrow><mfrac><mn>1</mn><mn>2</mn></mfrac></msup><mo lspace="0em" rspace="0em">​</mo><mi>u</mi></mrow></mrow><annotation encoding="application/x-tex">\nabla N(z)u=\nabla N(z)F(z)^{-\frac{1}{2}}F(z)^{\frac{1}{2}}u</annotation></semantics></math>, We have</span></p>
<table id="A10.E137" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A10.E137.m1" class="ltx_Math" alttext="F(z)^{\frac{1}{2}}P_{\mathcal{R}}(z)v=(\underbrace{I-F(z)^{-\frac{1}{2}}\nabla N(z)^{\top}(\nabla N(z)F(z)^{-1}\nabla N(z)^{\top})^{\dagger}\nabla N(z)F(z)^{-\frac{1}{2}}}_{K(z)})F(z)^{\frac{1}{2}}v." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mi>F</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>z</mi><mo stretchy="false">)</mo></mrow><mfrac><mn>1</mn><mn>2</mn></mfrac></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>P</mi><mi class="ltx_font_mathcaligraphic">ℛ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>z</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>v</mi></mrow><mo>=</mo><mrow><mrow><mo stretchy="false">(</mo><munder><munder accentunder="true"><mrow><mi>I</mi><mo>−</mo><mi>F</mi><mo stretchy="false">(</mo><mi>z</mi><mo rspace="0.167em" stretchy="false">)</mo><msup><mrow></mrow><mrow><mo>−</mo><mfrac><mn>1</mn><mn>2</mn></mfrac></mrow></msup><mo rspace="0.167em">∇</mo><mi>N</mi><mo stretchy="false">(</mo><mi>z</mi><mo stretchy="false">)</mo><msup><mrow></mrow><mo>⊤</mo></msup><mo stretchy="false">(</mo><mo rspace="0.167em">∇</mo><mi>N</mi><mo stretchy="false">(</mo><mi>z</mi><mo stretchy="false">)</mo><mi>F</mi><mo stretchy="false">(</mo><mi>z</mi><mo rspace="0.167em" stretchy="false">)</mo><msup><mrow></mrow><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo rspace="0.167em">∇</mo><mi>N</mi><mo stretchy="false">(</mo><mi>z</mi><mo stretchy="false">)</mo><msup><mrow></mrow><mo>⊤</mo></msup><mo rspace="0.167em" stretchy="false">)</mo><msup><mrow></mrow><mo>†</mo></msup><mo rspace="0.167em">∇</mo><mi>N</mi><mo stretchy="false">(</mo><mi>z</mi><mo stretchy="false">)</mo><mi>F</mi><mo stretchy="false">(</mo><mi>z</mi><mo stretchy="false">)</mo><msup><mrow></mrow><mrow><mo>−</mo><mfrac><mn>1</mn><mn>2</mn></mfrac></mrow></msup></mrow><mo stretchy="true">⏟</mo></munder><mrow><mi>K</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>z</mi><mo stretchy="false">)</mo></mrow></mrow></munder><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>F</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>z</mi><mo stretchy="false">)</mo></mrow><mfrac><mn>1</mn><mn>2</mn></mfrac></msup><mo lspace="0em" rspace="0em">​</mo><mi>v</mi></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">F(z)^{\frac{1}{2}}P_{\mathcal{R}}(z)v=(\underbrace{I-F(z)^{-\frac{1}{2}}\nabla N(z)^{\top}(\nabla N(z)F(z)^{-1}\nabla N(z)^{\top})^{\dagger}\nabla N(z)F(z)^{-\frac{1}{2}}}_{K(z)})F(z)^{\frac{1}{2}}v.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(137)</span></td></tr></tbody>
</table>
</div>
<div id="A10.Thmtheorem8.p4" class="ltx_para">
<p id="A10.Thmtheorem8.p4.1" class="ltx_p"><span id="A10.Thmtheorem8.p4.1.1" class="ltx_text">For notational brevity, we define <math id="A10.Thmtheorem8.p4.m1" class="ltx_Math" alttext="J=F(z)^{-\frac{1}{2}}P_{s}(z)\nabla^{2}f(z)P_{s}(z)F(z)^{-\frac{1}{2}}" display="inline" intent=":literal"><semantics><mrow><mi>J</mi><mo>=</mo><mrow><mi>F</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>z</mi><mo stretchy="false">)</mo></mrow><mrow><mo>−</mo><mfrac><mn>1</mn><mn>2</mn></mfrac></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>P</mi><mi>s</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>z</mi><mo stretchy="false">)</mo></mrow><mo lspace="0.167em" rspace="0em">​</mo><mrow><msup><mo rspace="0.167em">∇</mo><mn>2</mn></msup><mi>f</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>z</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>P</mi><mi>s</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>z</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>F</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>z</mi><mo stretchy="false">)</mo></mrow><mrow><mo>−</mo><mfrac><mn>1</mn><mn>2</mn></mfrac></mrow></msup></mrow></mrow><annotation encoding="application/x-tex">J=F(z)^{-\frac{1}{2}}P_{s}(z)\nabla^{2}f(z)P_{s}(z)F(z)^{-\frac{1}{2}}</annotation></semantics></math>, and <math id="A10.Thmtheorem8.p4.m2" class="ltx_Math" alttext="\Delta J\in\mathbb{R}^{k\times p}" display="inline" intent=":literal"><semantics><mrow><mrow><mi mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0em">​</mo><mi>J</mi></mrow><mo>∈</mo><msup><mi>ℝ</mi><mrow><mi>k</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>p</mi></mrow></msup></mrow><annotation encoding="application/x-tex">\Delta J\in\mathbb{R}^{k\times p}</annotation></semantics></math> satisfying <math id="A10.Thmtheorem8.p4.m3" class="ltx_math_unparsed" alttext="\Delta Jq=F(z)^{\frac{1}{2}}\nabla F_{s}^{\dagger}(w)[F(z)^{-\frac{1}{2}}q]^{\top}\nabla f(z)" display="inline" intent=":literal"><semantics><mrow><mi mathvariant="normal">Δ</mi><mi>J</mi><mi>q</mi><mo>=</mo><mi>F</mi><msup><mrow><mo stretchy="false">(</mo><mi>z</mi><mo rspace="0.167em" stretchy="false">)</mo></mrow><mfrac><mn>1</mn><mn>2</mn></mfrac></msup><mo rspace="0.167em">∇</mo><msubsup><mi>F</mi><mi>s</mi><mo>†</mo></msubsup><mrow><mo stretchy="false">(</mo><mi>w</mi><mo stretchy="false">)</mo></mrow><msup><mrow><mo stretchy="false">[</mo><mi>F</mi><msup><mrow><mo stretchy="false">(</mo><mi>z</mi><mo stretchy="false">)</mo></mrow><mrow><mo>−</mo><mfrac><mn>1</mn><mn>2</mn></mfrac></mrow></msup><mi>q</mi><mo rspace="0.167em" stretchy="false">]</mo></mrow><mo>⊤</mo></msup><mo rspace="0.167em">∇</mo><mi>f</mi><mrow><mo stretchy="false">(</mo><mi>z</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\Delta Jq=F(z)^{\frac{1}{2}}\nabla F_{s}^{\dagger}(w)[F(z)^{-\frac{1}{2}}q]^{\top}\nabla f(z)</annotation></semantics></math> for any <math id="A10.Thmtheorem8.p4.m4" class="ltx_Math" alttext="q\in\mathbb{R}^{p}" display="inline" intent=":literal"><semantics><mrow><mi>q</mi><mo>∈</mo><msup><mi>ℝ</mi><mi>p</mi></msup></mrow><annotation encoding="application/x-tex">q\in\mathbb{R}^{p}</annotation></semantics></math>.</span></p>
</div>
<div id="A10.Thmtheorem8.p5" class="ltx_para">
<p id="A10.Thmtheorem8.p5.2" class="ltx_p"><span id="A10.Thmtheorem8.p5.2.1" class="ltx_text">Note that <math id="A10.Thmtheorem8.p5.m1" class="ltx_Math" alttext="K(z)" display="inline" intent=":literal"><semantics><mrow><mi>K</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>z</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">K(z)</annotation></semantics></math> is the Euclidean projection to the kernel subspace:</span></p>
<table id="A10.E138" class="ltx_equationgroup ltx_eqn_table">
<tbody>
<tr id="A10.E138X" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A10.E138X.m2" class="ltx_Math" alttext="\displaystyle\text{ker}\left(\nabla N(z)F(z)^{-\frac{1}{2}}\right)=\text{ker}\left(F(z)^{\frac{1}{2}}\nabla N(z)F(z)^{-\frac{1}{2}}\right)=\text{ker}\left(J+\Delta J\right)," display="inline" intent=":literal"><semantics><mrow><mtext>ker</mtext><mo>(</mo><mo rspace="0.167em">∇</mo><mi>N</mi><mo stretchy="false">(</mo><mi>z</mi><mo stretchy="false">)</mo><mi>F</mi><mo stretchy="false">(</mo><mi>z</mi><mo stretchy="false">)</mo><msup><mrow></mrow><mrow><mo>−</mo><mfrac><mn>1</mn><mn>2</mn></mfrac></mrow></msup><mo>)</mo><mo>=</mo><mtext>ker</mtext><mo>(</mo><mi>F</mi><mo stretchy="false">(</mo><mi>z</mi><mo rspace="0.167em" stretchy="false">)</mo><msup><mrow></mrow><mfrac><mn>1</mn><mn>2</mn></mfrac></msup><mo rspace="0.167em">∇</mo><mi>N</mi><mo stretchy="false">(</mo><mi>z</mi><mo stretchy="false">)</mo><mi>F</mi><mo stretchy="false">(</mo><mi>z</mi><mo stretchy="false">)</mo><msup><mrow></mrow><mrow><mo>−</mo><mfrac><mn>1</mn><mn>2</mn></mfrac></mrow></msup><mo>)</mo><mo>=</mo><mtext>ker</mtext><mo>(</mo><mi>J</mi><mo>+</mo><mi mathvariant="normal">Δ</mi><mi>J</mi><mo>)</mo><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\text{ker}\left(\nabla N(z)F(z)^{-\frac{1}{2}}\right)=\text{ker}\left(F(z)^{\frac{1}{2}}\nabla N(z)F(z)^{-\frac{1}{2}}\right)=\text{ker}\left(J+\Delta J\right),</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equationgroup ltx_align_right">(138)</span></td></tr></tbody>
</table>
<p id="A10.Thmtheorem8.p5.3" class="ltx_p"><span id="A10.Thmtheorem8.p5.3.1" class="ltx_text">and <math id="A10.Thmtheorem8.p5.m2" class="ltx_Math" alttext="P_{f}(z)" display="inline" intent=":literal"><semantics><mrow><msub><mi>P</mi><mi>f</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>z</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">P_{f}(z)</annotation></semantics></math> is the Euclidean projection to <math id="A10.Thmtheorem8.p5.m3" class="ltx_Math" alttext="\text{ker}J" display="inline" intent=":literal"><semantics><mrow><mtext>ker</mtext><mo lspace="0em" rspace="0em">​</mo><mi>J</mi></mrow><annotation encoding="application/x-tex">\text{ker}J</annotation></semantics></math>. Using Wedin <math id="A10.Thmtheorem8.p5.m4" class="ltx_Math" alttext="\sin(\Theta)" display="inline" intent=":literal"><semantics><mrow><mi>sin</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi mathvariant="normal">Θ</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\sin(\Theta)</annotation></semantics></math> Theorem (Lemma <a href="#A10.Thmtheorem17" title="Lemma J.17 (Wedin sin(Θ) Theorem). ‣ Lemma J.14. ‣ J.3 Useful Lemmas ‣ Appendix J Proof ‣ Accelerating LLM Pre-Training through Flat-Direction Dynamics Enhancement" class="ltx_ref"><span class="ltx_text ltx_ref_tag">J.17</span></a>) to <math id="A10.Thmtheorem8.p5.m5" class="ltx_Math" alttext="J" display="inline" intent=":literal"><semantics><mi>J</mi><annotation encoding="application/x-tex">J</annotation></semantics></math> and <math id="A10.Thmtheorem8.p5.m6" class="ltx_Math" alttext="J+\Delta J" display="inline" intent=":literal"><semantics><mrow><mi>J</mi><mo>+</mo><mrow><mi mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0em">​</mo><mi>J</mi></mrow></mrow><annotation encoding="application/x-tex">J+\Delta J</annotation></semantics></math>, we get</span></p>
<table id="A10.E139" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A10.E139.m1" class="ltx_Math" alttext="\|K(z)-P_{f}(z)\|_{2}\leq\frac{\|\Delta J\|_{2}}{\lambda_{H_{F},s}}." display="block" intent=":literal"><semantics><mrow><mrow><msub><mrow><mo stretchy="false">‖</mo><mrow><mrow><mi>K</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>z</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msub><mi>P</mi><mi>f</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>z</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn></msub><mo>≤</mo><mfrac><msub><mrow><mo stretchy="false">‖</mo><mrow><mi mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0em">​</mo><mi>J</mi></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn></msub><msub><mi>λ</mi><mrow><msub><mi>H</mi><mi>F</mi></msub><mo>,</mo><mi>s</mi></mrow></msub></mfrac></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\|K(z)-P_{f}(z)\|_{2}\leq\frac{\|\Delta J\|_{2}}{\lambda_{H_{F},s}}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(139)</span></td></tr></tbody>
</table>
<p id="A10.Thmtheorem8.p5.4" class="ltx_p"><span id="A10.Thmtheorem8.p5.4.1" class="ltx_text">It follows that</span></p>
<table id="A10.E140" class="ltx_equationgroup ltx_eqn_table">
<tbody>
<tr id="A10.E140X" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A10.E140X.m2" class="ltx_Math" alttext="\displaystyle\|F(z)^{\frac{1}{2}}P_{\mathcal{R}}(z)v-F(z)^{\frac{1}{2}}P_{f}(z)v\|_{2}=" display="inline" intent=":literal"><semantics><mrow><msub><mrow><mo stretchy="false">‖</mo><mrow><mrow><mi>F</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>z</mi><mo stretchy="false">)</mo></mrow><mfrac><mn>1</mn><mn>2</mn></mfrac></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>P</mi><mi class="ltx_font_mathcaligraphic">ℛ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>z</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>v</mi></mrow><mo>−</mo><mrow><mi>F</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>z</mi><mo stretchy="false">)</mo></mrow><mfrac><mn>1</mn><mn>2</mn></mfrac></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>P</mi><mi>f</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>z</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>v</mi></mrow></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn></msub><mo>=</mo><mphantom></mphantom></mrow><annotation encoding="application/x-tex">\displaystyle\|F(z)^{\frac{1}{2}}P_{\mathcal{R}}(z)v-F(z)^{\frac{1}{2}}P_{f}(z)v\|_{2}=</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A10.E140X.m3" class="ltx_Math" alttext="\displaystyle\|K(z)F(z)^{\frac{1}{2}}v-P_{f}(z)F(z)^{\frac{1}{2}}v\|_{2}" display="inline" intent=":literal"><semantics><msub><mrow><mo stretchy="false">‖</mo><mrow><mrow><mrow><mi>K</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>z</mi><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><mi>F</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>z</mi><mo stretchy="false">)</mo></mrow><mfrac><mn>1</mn><mn>2</mn></mfrac></msup><mo lspace="0em" rspace="0em">​</mo><mi>v</mi></mrow><mo>−</mo><mrow><msub><mi>P</mi><mi>f</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>z</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>F</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>z</mi><mo stretchy="false">)</mo></mrow><mfrac><mn>1</mn><mn>2</mn></mfrac></msup><mo lspace="0em" rspace="0em">​</mo><mi>v</mi></mrow></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn></msub><annotation encoding="application/x-tex">\displaystyle\|K(z)F(z)^{\frac{1}{2}}v-P_{f}(z)F(z)^{\frac{1}{2}}v\|_{2}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="2" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equationgroup ltx_align_right">(140)</span></td></tr>
<tr id="A10.E140Xa" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A10.E140Xa.m2" class="ltx_Math" alttext="\displaystyle\leq" display="inline" intent=":literal"><semantics><mo>≤</mo><annotation encoding="application/x-tex">\displaystyle\leq</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A10.E140Xa.m3" class="ltx_Math" alttext="\displaystyle\frac{\|\Delta J\|_{2}}{\lambda_{H_{F},s}}\|F(z)^{\frac{1}{2}}v\|_{2}." display="inline" intent=":literal"><semantics><mrow><mrow><mstyle displaystyle="true"><mfrac><msub><mrow><mo stretchy="false">‖</mo><mrow><mi mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0em">​</mo><mi>J</mi></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn></msub><msub><mi>λ</mi><mrow><msub><mi>H</mi><mi>F</mi></msub><mo>,</mo><mi>s</mi></mrow></msub></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">‖</mo><mrow><mi>F</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>z</mi><mo stretchy="false">)</mo></mrow><mfrac><mn>1</mn><mn>2</mn></mfrac></msup><mo lspace="0em" rspace="0em">​</mo><mi>v</mi></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn></msub></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\frac{\|\Delta J\|_{2}}{\lambda_{H_{F},s}}\|F(z)^{\frac{1}{2}}v\|_{2}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="A10.Thmtheorem8.p6" class="ltx_para">
<p id="A10.Thmtheorem8.p6.1" class="ltx_p"><span id="A10.Thmtheorem8.p6.1.1" class="ltx_text">Note that</span></p>
<table id="A10.E141" class="ltx_equationgroup ltx_eqn_table">
<tbody>
<tr id="A10.E141X" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A10.E141X.m2" class="ltx_Math" alttext="\displaystyle\|\Delta Jq\|_{2}=\|\nabla F_{s}^{\dagger}(w)[F(z)^{-\frac{1}{2}}q]^{\top}\nabla f(z)\|_{F(z)}\overset{\eqref{p-deltafinvs-u-v}}{\leq}\delta_{F_{s}}\|q\|_{2}." display="inline" intent=":literal"><semantics><mrow><mo rspace="0.167em">∥</mo><mi mathvariant="normal">Δ</mi><mi>J</mi><mi>q</mi><mo lspace="0em" rspace="0.0835em">∥</mo><msub><mrow></mrow><mn>2</mn></msub><mo lspace="0.0835em" rspace="0em">=</mo><mo lspace="0em" rspace="0.167em">∥</mo><mo rspace="0.167em">∇</mo><mi>F</mi><msub><mrow></mrow><mi>s</mi></msub><msup><mrow></mrow><mo>†</mo></msup><mo stretchy="false">(</mo><mi>w</mi><mo stretchy="false">)</mo><mo stretchy="false">[</mo><mi>F</mi><mo stretchy="false">(</mo><mi>z</mi><mo stretchy="false">)</mo><msup><mrow></mrow><mrow><mo>−</mo><mfrac><mn>1</mn><mn>2</mn></mfrac></mrow></msup><mi>q</mi><mo rspace="0.167em" stretchy="false">]</mo><msup><mrow></mrow><mo>⊤</mo></msup><mo rspace="0.167em">∇</mo><mi>f</mi><mo stretchy="false">(</mo><mi>z</mi><mo stretchy="false">)</mo><mo lspace="0em" rspace="0.0835em">∥</mo><msub><mrow></mrow><mrow><mi>F</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>z</mi><mo stretchy="false">)</mo></mrow></mrow></msub><mover accent="true"><mo lspace="0.0835em">≤</mo><mrow><mtext mathsize="0.700em">(</mtext><mtext mathsize="0.700em"><a href="#A10.E78" title="Equation 78 ‣ Proof. ‣ Lemma J.1. ‣ J.1 Landscape Analysis ‣ Appendix J Proof ‣ Accelerating LLM Pre-Training through Flat-Direction Dynamics Enhancement" class="ltx_ref" style="font-size:70%;"><span class="ltx_text ltx_ref_tag">78</span></a></mtext><mtext mathsize="0.700em">)</mtext></mrow></mover><mi>δ</mi><msub><mrow></mrow><msub><mi>F</mi><mi>s</mi></msub></msub><mo lspace="0em" rspace="0.167em">∥</mo><mi>q</mi><mo lspace="0em" rspace="0.0835em">∥</mo><msub><mrow></mrow><mn>2</mn></msub><mo lspace="0.0835em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\|\Delta Jq\|_{2}=\|\nabla F_{s}^{\dagger}(w)[F(z)^{-\frac{1}{2}}q]^{\top}\nabla f(z)\|_{F(z)}\overset{\eqref{p-deltafinvs-u-v}}{\leq}\delta_{F_{s}}\|q\|_{2}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equationgroup ltx_align_right">(141)</span></td></tr></tbody>
</table>
</div>
<div id="A10.Thmtheorem8.p7" class="ltx_para">
<p id="A10.Thmtheorem8.p7.1" class="ltx_p"><span id="A10.Thmtheorem8.p7.1.1" class="ltx_text">Substituting it into (<a href="#A10.E140" title="Equation 140 ‣ Proof. ‣ Lemma J.8. ‣ J.2 Dynamics Analysis ‣ Appendix J Proof ‣ Accelerating LLM Pre-Training through Flat-Direction Dynamics Enhancement" class="ltx_ref"><span class="ltx_text ltx_ref_tag">140</span></a>) yields</span></p>
<table id="A10.E142" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A10.E142.m1" class="ltx_Math" alttext="\|P_{\mathcal{R}}(z)v-P_{f}(z)v\|_{F(z)}=\|F(z)^{\frac{1}{2}}P_{\mathcal{R}}(z)v-F(z)^{\frac{1}{2}}P_{f}(z)v\|_{2}\leq\frac{\delta_{F_{s}}}{\lambda_{H_{F},s}}\|v\|_{F(z)}." display="block" intent=":literal"><semantics><mrow><mrow><msub><mrow><mo stretchy="false">‖</mo><mrow><mrow><msub><mi>P</mi><mi class="ltx_font_mathcaligraphic">ℛ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>z</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>v</mi></mrow><mo>−</mo><mrow><msub><mi>P</mi><mi>f</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>z</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>v</mi></mrow></mrow><mo stretchy="false">‖</mo></mrow><mrow><mi>F</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>z</mi><mo stretchy="false">)</mo></mrow></mrow></msub><mo>=</mo><msub><mrow><mo stretchy="false">‖</mo><mrow><mrow><mi>F</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>z</mi><mo stretchy="false">)</mo></mrow><mfrac><mn>1</mn><mn>2</mn></mfrac></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>P</mi><mi class="ltx_font_mathcaligraphic">ℛ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>z</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>v</mi></mrow><mo>−</mo><mrow><mi>F</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>z</mi><mo stretchy="false">)</mo></mrow><mfrac><mn>1</mn><mn>2</mn></mfrac></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>P</mi><mi>f</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>z</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>v</mi></mrow></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn></msub><mo>≤</mo><mrow><mfrac><msub><mi>δ</mi><msub><mi>F</mi><mi>s</mi></msub></msub><msub><mi>λ</mi><mrow><msub><mi>H</mi><mi>F</mi></msub><mo>,</mo><mi>s</mi></mrow></msub></mfrac><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">‖</mo><mi>v</mi><mo stretchy="false">‖</mo></mrow><mrow><mi>F</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>z</mi><mo stretchy="false">)</mo></mrow></mrow></msub></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\|P_{\mathcal{R}}(z)v-P_{f}(z)v\|_{F(z)}=\|F(z)^{\frac{1}{2}}P_{\mathcal{R}}(z)v-F(z)^{\frac{1}{2}}P_{f}(z)v\|_{2}\leq\frac{\delta_{F_{s}}}{\lambda_{H_{F},s}}\|v\|_{F(z)}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(142)</span></td></tr></tbody>
</table>
</div>
<div id="A10.Thmtheorem8.p8" class="ltx_para">
<p id="A10.Thmtheorem8.p8.1" class="ltx_p"><span id="A10.Thmtheorem8.p8.1.1" class="ltx_text">∎</span></p>
</div>
</div>
</div>
<div id="A10.Thmtheorem9" class="ltx_theorem ltx_theorem_lemma">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="A10.Thmtheorem9.2" class="ltx_text ltx_font_bold">Lemma J.9</span></span><span id="A10.Thmtheorem9.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="A10.Thmtheorem9.p1" class="ltx_para">
<p id="A10.Thmtheorem9.p1.1" class="ltx_p"><span id="A10.Thmtheorem9.p1.1.1" class="ltx_text ltx_font_italic">Suppose Assumptions <a href="#S7.Thmtheorem1" title="Assumption 7.1 (River Structure). ‣ 7 Theoretical Analysis to Training Dynamics ‣ Accelerating LLM Pre-Training through Flat-Direction Dynamics Enhancement" class="ltx_ref"><span class="ltx_text ltx_ref_tag">7.1</span></a> and <a href="#S7.Thmtheorem2" title="Assumption 7.2 (Regularity, Smoothness and Conservation). ‣ 7 Theoretical Analysis to Training Dynamics ‣ Accelerating LLM Pre-Training through Flat-Direction Dynamics Enhancement" class="ltx_ref"><span class="ltx_text ltx_ref_tag">7.2</span></a> hold. For any <math id="A10.Thmtheorem9.p1.m1" class="ltx_Math" alttext="x,y\in U" display="inline" intent=":literal"><semantics><mrow><mrow><mi>x</mi><mo>,</mo><mi>y</mi></mrow><mo>∈</mo><mi>U</mi></mrow><annotation encoding="application/x-tex">x,y\in U</annotation></semantics></math> and <math id="A10.Thmtheorem9.p1.m2" class="ltx_Math" alttext="v\in\mathbb{R}^{p}" display="inline" intent=":literal"><semantics><mrow><mi>v</mi><mo>∈</mo><msup><mi>ℝ</mi><mi>p</mi></msup></mrow><annotation encoding="application/x-tex">v\in\mathbb{R}^{p}</annotation></semantics></math>, we have</span></p>
<table id="A10.E143" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A10.E143.m1" class="ltx_Math" alttext="\|F_{s}^{\dagger}(x)v-F_{s}^{\dagger}(y)v\|_{2}\leq\frac{\delta_{F_{s}}}{G}\kappa_{F}^{\frac{1}{2}}\lambda_{F}^{-\frac{1}{2}}\|x-y\|_{2}\|v\|_{2}," display="block" intent=":literal"><semantics><mrow><mrow><msub><mrow><mo stretchy="false">‖</mo><mrow><mrow><msubsup><mi>F</mi><mi>s</mi><mo>†</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>v</mi></mrow><mo>−</mo><mrow><msubsup><mi>F</mi><mi>s</mi><mo>†</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>y</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>v</mi></mrow></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn></msub><mo>≤</mo><mrow><mfrac><msub><mi>δ</mi><msub><mi>F</mi><mi>s</mi></msub></msub><mi>G</mi></mfrac><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>κ</mi><mi>F</mi><mfrac><mn>1</mn><mn>2</mn></mfrac></msubsup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>λ</mi><mi>F</mi><mrow><mo>−</mo><mfrac><mn>1</mn><mn>2</mn></mfrac></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">‖</mo><mrow><mi>x</mi><mo>−</mo><mi>y</mi></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">‖</mo><mi>v</mi><mo stretchy="false">‖</mo></mrow><mn>2</mn></msub></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\|F_{s}^{\dagger}(x)v-F_{s}^{\dagger}(y)v\|_{2}\leq\frac{\delta_{F_{s}}}{G}\kappa_{F}^{\frac{1}{2}}\lambda_{F}^{-\frac{1}{2}}\|x-y\|_{2}\|v\|_{2},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(143)</span></td></tr></tbody>
</table>
</div>
<div id="A10.Thmtheorem9.p2" class="ltx_para">
<table id="A10.E144" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A10.E144.m1" class="ltx_Math" alttext="\|F_{f}^{\dagger}(x)v-F_{f}^{\dagger}(y)v\|_{2}\leq\frac{\delta_{F_{s}}}{G}\kappa_{F}^{\frac{1}{2}}\lambda_{F}^{-\frac{1}{2}}\|x-y\|_{2}\|v\|_{2}," display="block" intent=":literal"><semantics><mrow><mrow><msub><mrow><mo stretchy="false">‖</mo><mrow><mrow><msubsup><mi>F</mi><mi>f</mi><mo>†</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>v</mi></mrow><mo>−</mo><mrow><msubsup><mi>F</mi><mi>f</mi><mo>†</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>y</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>v</mi></mrow></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn></msub><mo>≤</mo><mrow><mfrac><msub><mi>δ</mi><msub><mi>F</mi><mi>s</mi></msub></msub><mi>G</mi></mfrac><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>κ</mi><mi>F</mi><mfrac><mn>1</mn><mn>2</mn></mfrac></msubsup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>λ</mi><mi>F</mi><mrow><mo>−</mo><mfrac><mn>1</mn><mn>2</mn></mfrac></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">‖</mo><mrow><mi>x</mi><mo>−</mo><mi>y</mi></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">‖</mo><mi>v</mi><mo stretchy="false">‖</mo></mrow><mn>2</mn></msub></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\|F_{f}^{\dagger}(x)v-F_{f}^{\dagger}(y)v\|_{2}\leq\frac{\delta_{F_{s}}}{G}\kappa_{F}^{\frac{1}{2}}\lambda_{F}^{-\frac{1}{2}}\|x-y\|_{2}\|v\|_{2},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(144)</span></td></tr></tbody>
</table>
<table id="A10.E145" class="ltx_equationgroup ltx_eqn_table">
<tbody>
<tr id="A10.E145X" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A10.E145X.m2" class="ltx_Math" alttext="\displaystyle\|P_{f}(x)v-P_{f}(y)v\|_{2}\leq\frac{\delta}{G}\kappa_{F}^{\frac{1}{2}}\lambda_{F}^{-\frac{1}{2}}\|x-y\|_{2}\|v\|_{2}." display="inline" intent=":literal"><semantics><mrow><mrow><msub><mrow><mo stretchy="false">‖</mo><mrow><mrow><msub><mi>P</mi><mi>f</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>v</mi></mrow><mo>−</mo><mrow><msub><mi>P</mi><mi>f</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>y</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>v</mi></mrow></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn></msub><mo>≤</mo><mrow><mstyle displaystyle="true"><mfrac><mi>δ</mi><mi>G</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>κ</mi><mi>F</mi><mfrac><mn>1</mn><mn>2</mn></mfrac></msubsup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>λ</mi><mi>F</mi><mrow><mo>−</mo><mfrac><mn>1</mn><mn>2</mn></mfrac></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">‖</mo><mrow><mi>x</mi><mo>−</mo><mi>y</mi></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">‖</mo><mi>v</mi><mo stretchy="false">‖</mo></mrow><mn>2</mn></msub></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\|P_{f}(x)v-P_{f}(y)v\|_{2}\leq\frac{\delta}{G}\kappa_{F}^{\frac{1}{2}}\lambda_{F}^{-\frac{1}{2}}\|x-y\|_{2}\|v\|_{2}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equationgroup ltx_align_right">(145)</span></td></tr></tbody>
</table>
</div>
<div id="A10.Thmtheorem9.4" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="A10.Thmtheorem9.p3" class="ltx_para">
<p id="A10.Thmtheorem9.p3.1" class="ltx_p"><span id="A10.Thmtheorem9.p3.1.1" class="ltx_text">By Assumption <a href="#S7.Thmtheorem2" title="Assumption 7.2 (Regularity, Smoothness and Conservation). ‣ 7 Theoretical Analysis to Training Dynamics ‣ Accelerating LLM Pre-Training through Flat-Direction Dynamics Enhancement" class="ltx_ref"><span class="ltx_text ltx_ref_tag">7.2</span></a>,</span></p>
<table id="A10.E146" class="ltx_equationgroup ltx_eqn_table">
<tbody>
<tr id="A10.E146X" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A10.E146X.m2" class="ltx_Math" alttext="\displaystyle\|F_{s}^{\dagger}(x)v-F_{s}^{\dagger}(y)v\|_{2}=\|\int_{0}^{1}\nabla F_{s}^{\dagger}(x+(y-x)t)[x-y]vdt\|_{2}\overset{\eqref{p-deltafinvs-u-v}}{\leq}\frac{\delta_{F_{s}}}{G}\kappa_{F}^{\frac{1}{2}}\lambda_{F}^{-\frac{1}{2}}\|x-y\|_{2}\|v\|_{2}" display="inline" intent=":literal"><semantics><mrow><msub><mrow><mo stretchy="false">‖</mo><mrow><mrow><msubsup><mi>F</mi><mi>s</mi><mo>†</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>v</mi></mrow><mo>−</mo><mrow><msubsup><mi>F</mi><mi>s</mi><mo>†</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>y</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>v</mi></mrow></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn></msub><mo>=</mo><mrow><msub><mrow><mo stretchy="false">‖</mo><mrow><mstyle displaystyle="true"><msubsup><mo>∫</mo><mn>0</mn><mn>1</mn></msubsup></mstyle><mrow><mrow><mo lspace="0.167em" rspace="0.167em">∇</mo><msubsup><mi>F</mi><mi>s</mi><mo>†</mo></msubsup></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>x</mi><mo>+</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>y</mi><mo>−</mo><mi>x</mi></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mrow><mi>x</mi><mo>−</mo><mi>y</mi></mrow><mo stretchy="false">]</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>v</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo mathsize="0.700em" rspace="0em">d</mo><mi>t</mi></mrow></mrow></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><mover accent="true"><mo>≤</mo><mrow><mtext mathsize="0.700em">(</mtext><mtext mathsize="0.700em"><a href="#A10.E78" title="Equation 78 ‣ Proof. ‣ Lemma J.1. ‣ J.1 Landscape Analysis ‣ Appendix J Proof ‣ Accelerating LLM Pre-Training through Flat-Direction Dynamics Enhancement" class="ltx_ref" style="font-size:70%;"><span class="ltx_text ltx_ref_tag">78</span></a></mtext><mtext mathsize="0.700em">)</mtext></mrow></mover><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><msub><mi>δ</mi><msub><mi>F</mi><mi>s</mi></msub></msub><mi>G</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>κ</mi><mi>F</mi><mfrac><mn>1</mn><mn>2</mn></mfrac></msubsup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>λ</mi><mi>F</mi><mrow><mo>−</mo><mfrac><mn>1</mn><mn>2</mn></mfrac></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">‖</mo><mrow><mi>x</mi><mo>−</mo><mi>y</mi></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">‖</mo><mi>v</mi><mo stretchy="false">‖</mo></mrow><mn>2</mn></msub></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\|F_{s}^{\dagger}(x)v-F_{s}^{\dagger}(y)v\|_{2}=\|\int_{0}^{1}\nabla F_{s}^{\dagger}(x+(y-x)t)[x-y]vdt\|_{2}\overset{\eqref{p-deltafinvs-u-v}}{\leq}\frac{\delta_{F_{s}}}{G}\kappa_{F}^{\frac{1}{2}}\lambda_{F}^{-\frac{1}{2}}\|x-y\|_{2}\|v\|_{2}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equationgroup ltx_align_right">(146)</span></td></tr></tbody>
</table>
<p id="A10.Thmtheorem9.p3.2" class="ltx_p"><span id="A10.Thmtheorem9.p3.2.1" class="ltx_text">We can similarly prove (<a href="#A10.E144" title="Equation 144 ‣ Lemma J.9. ‣ J.2 Dynamics Analysis ‣ Appendix J Proof ‣ Accelerating LLM Pre-Training through Flat-Direction Dynamics Enhancement" class="ltx_ref"><span class="ltx_text ltx_ref_tag">144</span></a>) by (<a href="#A10.E81" title="Equation 81 ‣ J.1 Landscape Analysis ‣ Appendix J Proof ‣ Accelerating LLM Pre-Training through Flat-Direction Dynamics Enhancement" class="ltx_ref"><span class="ltx_text ltx_ref_tag">81</span></a>). On the other hand, using <math id="A10.Thmtheorem9.p3.m1" class="ltx_Math" alttext="\nabla P_{f}+\nabla P_{s}=0" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mo rspace="0.167em">∇</mo><msub><mi>P</mi><mi>f</mi></msub></mrow><mo>+</mo><mrow><mo rspace="0.167em">∇</mo><msub><mi>P</mi><mi>s</mi></msub></mrow></mrow><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\nabla P_{f}+\nabla P_{s}=0</annotation></semantics></math>, we get</span></p>
<table id="A10.E147" class="ltx_equationgroup ltx_eqn_table">
<tbody>
<tr id="A10.E147X" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A10.E147X.m2" class="ltx_Math" alttext="\displaystyle\|P_{f}(x)v-P_{f}(y)v\|_{2}=\|\int_{0}^{1}\nabla P_{s}(x+(y-x)t)[x-y]vdt\|_{2}\leq\frac{\delta}{G}\kappa_{F}^{\frac{1}{2}}\lambda_{F}^{-\frac{1}{2}}\|x-y\|_{2}\|v\|_{2}." display="inline" intent=":literal"><semantics><mrow><mrow><msub><mrow><mo stretchy="false">‖</mo><mrow><mrow><msub><mi>P</mi><mi>f</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>v</mi></mrow><mo>−</mo><mrow><msub><mi>P</mi><mi>f</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>y</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>v</mi></mrow></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn></msub><mo>=</mo><msub><mrow><mo stretchy="false">‖</mo><mrow><mstyle displaystyle="true"><msubsup><mo>∫</mo><mn>0</mn><mn>1</mn></msubsup></mstyle><mrow><mrow><mo lspace="0.167em" rspace="0.167em">∇</mo><msub><mi>P</mi><mi>s</mi></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>x</mi><mo>+</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>y</mi><mo>−</mo><mi>x</mi></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mrow><mi>x</mi><mo>−</mo><mi>y</mi></mrow><mo stretchy="false">]</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>v</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo rspace="0em">d</mo><mi>t</mi></mrow></mrow></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn></msub><mo>≤</mo><mrow><mstyle displaystyle="true"><mfrac><mi>δ</mi><mi>G</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>κ</mi><mi>F</mi><mfrac><mn>1</mn><mn>2</mn></mfrac></msubsup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>λ</mi><mi>F</mi><mrow><mo>−</mo><mfrac><mn>1</mn><mn>2</mn></mfrac></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">‖</mo><mrow><mi>x</mi><mo>−</mo><mi>y</mi></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">‖</mo><mi>v</mi><mo stretchy="false">‖</mo></mrow><mn>2</mn></msub></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\|P_{f}(x)v-P_{f}(y)v\|_{2}=\|\int_{0}^{1}\nabla P_{s}(x+(y-x)t)[x-y]vdt\|_{2}\leq\frac{\delta}{G}\kappa_{F}^{\frac{1}{2}}\lambda_{F}^{-\frac{1}{2}}\|x-y\|_{2}\|v\|_{2}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equationgroup ltx_align_right">(147)</span></td></tr></tbody>
</table>
</div>
<div id="A10.Thmtheorem9.p4" class="ltx_para">
<p id="A10.Thmtheorem9.p4.1" class="ltx_p"><span id="A10.Thmtheorem9.p4.1.1" class="ltx_text">∎</span></p>
</div>
</div>
</div>
<div id="A10.Thmtheorem10" class="ltx_theorem ltx_theorem_lemma">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="A10.Thmtheorem10.2" class="ltx_text ltx_font_bold">Lemma J.10</span></span><span id="A10.Thmtheorem10.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="A10.Thmtheorem10.p1" class="ltx_para">
<p id="A10.Thmtheorem10.p1.1" class="ltx_p"><span id="A10.Thmtheorem10.p1.1.1" class="ltx_text ltx_font_italic">Suppose Assumptions <a href="#S7.Thmtheorem1" title="Assumption 7.1 (River Structure). ‣ 7 Theoretical Analysis to Training Dynamics ‣ Accelerating LLM Pre-Training through Flat-Direction Dynamics Enhancement" class="ltx_ref"><span class="ltx_text ltx_ref_tag">7.1</span></a> and <a href="#S7.Thmtheorem2" title="Assumption 7.2 (Regularity, Smoothness and Conservation). ‣ 7 Theoretical Analysis to Training Dynamics ‣ Accelerating LLM Pre-Training through Flat-Direction Dynamics Enhancement" class="ltx_ref"><span class="ltx_text ltx_ref_tag">7.2</span></a> hold.
The dynamics of <math id="A10.Thmtheorem10.p1.m1" class="ltx_Math" alttext="z_{t}=\Phi(w_{t})" display="inline" intent=":literal"><semantics><mrow><msub><mi>z</mi><mi>t</mi></msub><mo>=</mo><mrow><mi mathvariant="normal">Φ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>w</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">z_{t}=\Phi(w_{t})</annotation></semantics></math> satisfies</span></p>
<table id="A10.EGx23" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A10.E148"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A10.E148.m1" class="ltx_Math" alttext="\displaystyle\begin{cases}&amp;\dot{z}_{t}=-\eta_{t}\chi P_{\mathcal{R}}(z_{t})F(z_{t})^{-1}(s_{t}+\beta_{2}\nabla f(z_{t}))+\eta_{t}\epsilon_{z,t},\\
&amp;\dot{s}_{t}=-\alpha s_{t}+\nabla f(z_{t}),\end{cases}" display="inline" intent=":literal"><semantics><mrow><mo>{</mo><mtable columnspacing="5pt" rowspacing="0pt"><mtr><mtd></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mover accent="true"><mi>z</mi><mo>˙</mo></mover><msub><mrow></mrow><mi>t</mi></msub><mo rspace="0em">=</mo><mo lspace="0em">−</mo><mi>η</mi><msub><mrow></mrow><mi>t</mi></msub><mi>χ</mi><mi>P</mi><msub><mrow></mrow><mi class="ltx_font_mathcaligraphic">ℛ</mi></msub><mo stretchy="false">(</mo><mi>z</mi><msub><mrow></mrow><mi>t</mi></msub><mo stretchy="false">)</mo><mi>F</mi><mo stretchy="false">(</mo><mi>z</mi><msub><mrow></mrow><mi>t</mi></msub><mo stretchy="false">)</mo><msup><mrow></mrow><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo stretchy="false">(</mo><mi>s</mi><msub><mrow></mrow><mi>t</mi></msub><mo>+</mo><mi>β</mi><msub><mrow></mrow><mn>2</mn></msub><mo lspace="0.167em" rspace="0.167em">∇</mo><mi>f</mi><mo stretchy="false">(</mo><mi>z</mi><msub><mrow></mrow><mi>t</mi></msub><mo stretchy="false">)</mo><mo stretchy="false">)</mo><mo>+</mo><mi>η</mi><msub><mrow></mrow><mi>t</mi></msub><mi>ϵ</mi><msub><mrow></mrow><mrow><mi>z</mi><mo>,</mo><mi>t</mi></mrow></msub><mo>,</mo></mrow></mtd></mtr><mtr><mtd></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><msub><mover accent="true"><mi>s</mi><mo>˙</mo></mover><mi>t</mi></msub><mo>=</mo><mrow><mrow><mo>−</mo><mrow><mi>α</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>s</mi><mi>t</mi></msub></mrow></mrow><mo>+</mo><mrow><mrow><mo rspace="0.167em">∇</mo><mi>f</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>z</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo>,</mo></mrow></mtd></mtr></mtable></mrow><annotation encoding="application/x-tex">\displaystyle\begin{cases}&amp;\dot{z}_{t}=-\eta_{t}\chi P_{\mathcal{R}}(z_{t})F(z_{t})^{-1}(s_{t}+\beta_{2}\nabla f(z_{t}))+\eta_{t}\epsilon_{z,t},\\
&amp;\dot{s}_{t}=-\alpha s_{t}+\nabla f(z_{t}),\end{cases}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(148)</span></td></tr></tbody>
</table>
<p id="A10.Thmtheorem10.p1.2" class="ltx_p"><span id="A10.Thmtheorem10.p1.2.1" class="ltx_text ltx_font_italic">where <math id="A10.Thmtheorem10.p1.m2" class="ltx_Math" alttext="s_{0}=0" display="inline" intent=":literal"><semantics><mrow><msub><mi>s</mi><mn>0</mn></msub><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">s_{0}=0</annotation></semantics></math> and</span></p>
<table id="A10.E149" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A10.E149.m1" class="ltx_math_unparsed" alttext="\|\epsilon_{z,t}\|_{2}\lesssim\int_{0}^{t}e^{-\alpha(t-s)}\|w_{s}-\Phi(w_{s})\|_{2}ds+\|w_{t}-\Phi(w_{t})\|_{2}+\varepsilon\|m_{t}\|_{F_{s}^{\dagger}(w_{t})}+\varepsilon\|F_{f}^{\dagger}(z_{t})(s_{t}+\beta_{2}\nabla f(z_{t}))\|_{2}" display="block" intent=":literal"><semantics><mrow><mo rspace="0.167em">∥</mo><msub><mi>ϵ</mi><mrow><mi>z</mi><mo>,</mo><mi>t</mi></mrow></msub><msub><mo lspace="0em" rspace="0.0835em">∥</mo><mn>2</mn></msub><mo lspace="0.0835em" rspace="0.111em">≲</mo><msubsup><mo>∫</mo><mn>0</mn><mi>t</mi></msubsup><msup><mi>e</mi><mrow><mo>−</mo><mrow><mi>α</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>t</mi><mo>−</mo><mi>s</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></msup><mo lspace="0em" rspace="0.167em">∥</mo><msub><mi>w</mi><mi>s</mi></msub><mo>−</mo><mi mathvariant="normal">Φ</mi><mrow><mo stretchy="false">(</mo><msub><mi>w</mi><mi>s</mi></msub><mo stretchy="false">)</mo></mrow><msub><mo lspace="0em" rspace="0.167em">∥</mo><mn>2</mn></msub><mi>d</mi><mi>s</mi><mo rspace="0em">+</mo><mo lspace="0em" rspace="0.167em">∥</mo><msub><mi>w</mi><mi>t</mi></msub><mo>−</mo><mi mathvariant="normal">Φ</mi><mrow><mo stretchy="false">(</mo><msub><mi>w</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow><msub><mo lspace="0em" rspace="0em">∥</mo><mn>2</mn></msub><mo lspace="0em">+</mo><mi>ε</mi><mo lspace="0em" rspace="0.167em">∥</mo><msub><mi>m</mi><mi>t</mi></msub><msub><mo lspace="0em" rspace="0em">∥</mo><mrow><msubsup><mi>F</mi><mi>s</mi><mo>†</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>w</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow></msub><mo lspace="0em">+</mo><mi>ε</mi><mo lspace="0em" rspace="0.167em">∥</mo><msubsup><mi>F</mi><mi>f</mi><mo>†</mo></msubsup><mrow><mo stretchy="false">(</mo><msub><mi>z</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow><mrow><mo stretchy="false">(</mo><msub><mi>s</mi><mi>t</mi></msub><mo>+</mo><msub><mi>β</mi><mn>2</mn></msub><mo lspace="0.167em" rspace="0.167em">∇</mo><mi>f</mi><mrow><mo stretchy="false">(</mo><msub><mi>z</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow><mo stretchy="false">)</mo></mrow><msub><mo lspace="0em">∥</mo><mn>2</mn></msub></mrow><annotation encoding="application/x-tex">\|\epsilon_{z,t}\|_{2}\lesssim\int_{0}^{t}e^{-\alpha(t-s)}\|w_{s}-\Phi(w_{s})\|_{2}ds+\|w_{t}-\Phi(w_{t})\|_{2}+\varepsilon\|m_{t}\|_{F_{s}^{\dagger}(w_{t})}+\varepsilon\|F_{f}^{\dagger}(z_{t})(s_{t}+\beta_{2}\nabla f(z_{t}))\|_{2}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(149)</span></td></tr></tbody>
</table>
</div>
<div id="A10.Thmtheorem10.4" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="A10.Thmtheorem10.p2" class="ltx_para">
<p id="A10.Thmtheorem10.p2.1" class="ltx_p"><span id="A10.Thmtheorem10.p2.1.1" class="ltx_text">By (<a href="#A10.E82" title="Equation 82 ‣ Lemma J.2. ‣ J.1 Landscape Analysis ‣ Appendix J Proof ‣ Accelerating LLM Pre-Training through Flat-Direction Dynamics Enhancement" class="ltx_ref"><span class="ltx_text ltx_ref_tag">82</span></a>), the dynamics of <math id="A10.Thmtheorem10.p2.m1" class="ltx_Math" alttext="z_{t}=\Phi(w_{t})" display="inline" intent=":literal"><semantics><mrow><msub><mi>z</mi><mi>t</mi></msub><mo>=</mo><mrow><mi mathvariant="normal">Φ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>w</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">z_{t}=\Phi(w_{t})</annotation></semantics></math> satisfies</span></p>
</div>
<div id="A10.Thmtheorem10.p3" class="ltx_para">
<table id="A10.E150" class="ltx_equationgroup ltx_eqn_table">
<tbody>
<tr id="A10.E150X" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A10.E150X.m2" class="ltx_Math" alttext="\displaystyle\dot{z}_{t}=-\eta_{t}\nabla\Phi(w_{t})\left(F_{s}^{\dagger}(w_{t})m_{t}+\chi F_{f}^{\dagger}(w_{t})(m_{t}+\beta_{2}\nabla f(w_{t}))\right)." display="inline" intent=":literal"><semantics><mrow><mover accent="true"><mi>z</mi><mo>˙</mo></mover><msub><mrow></mrow><mi>t</mi></msub><mo rspace="0em">=</mo><mo lspace="0em">−</mo><mi>η</mi><msub><mrow></mrow><mi>t</mi></msub><mo lspace="0.167em" rspace="0.167em">∇</mo><mi mathvariant="normal">Φ</mi><mo stretchy="false">(</mo><mi>w</mi><msub><mrow></mrow><mi>t</mi></msub><mo stretchy="false">)</mo><mo>(</mo><mi>F</mi><msub><mrow></mrow><mi>s</mi></msub><msup><mrow></mrow><mo>†</mo></msup><mo stretchy="false">(</mo><mi>w</mi><msub><mrow></mrow><mi>t</mi></msub><mo stretchy="false">)</mo><mi>m</mi><msub><mrow></mrow><mi>t</mi></msub><mo>+</mo><mi>χ</mi><mi>F</mi><msub><mrow></mrow><mi>f</mi></msub><msup><mrow></mrow><mo>†</mo></msup><mo stretchy="false">(</mo><mi>w</mi><msub><mrow></mrow><mi>t</mi></msub><mo stretchy="false">)</mo><mo stretchy="false">(</mo><mi>m</mi><msub><mrow></mrow><mi>t</mi></msub><mo>+</mo><mi>β</mi><msub><mrow></mrow><mn>2</mn></msub><mo lspace="0.167em" rspace="0.167em">∇</mo><mi>f</mi><mo stretchy="false">(</mo><mi>w</mi><msub><mrow></mrow><mi>t</mi></msub><mo stretchy="false">)</mo><mo stretchy="false">)</mo><mo>)</mo><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\dot{z}_{t}=-\eta_{t}\nabla\Phi(w_{t})\left(F_{s}^{\dagger}(w_{t})m_{t}+\chi F_{f}^{\dagger}(w_{t})(m_{t}+\beta_{2}\nabla f(w_{t}))\right).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equationgroup ltx_align_right">(150)</span></td></tr></tbody>
</table>
</div>
<div id="A10.Thmtheorem10.p4" class="ltx_para">
<p id="A10.Thmtheorem10.p4.4" class="ltx_p"><span id="A10.Thmtheorem10.p4.4.1" class="ltx_text">Define <math id="A10.Thmtheorem10.p4.m1" class="ltx_Math" alttext="s_{t}" display="inline" intent=":literal"><semantics><msub><mi>s</mi><mi>t</mi></msub><annotation encoding="application/x-tex">s_{t}</annotation></semantics></math> satisfying <math id="A10.Thmtheorem10.p4.m2" class="ltx_Math" alttext="\dot{s}_{t}=-\alpha s_{t}+\nabla f(z_{t})" display="inline" intent=":literal"><semantics><mrow><msub><mover accent="true"><mi>s</mi><mo>˙</mo></mover><mi>t</mi></msub><mo>=</mo><mrow><mrow><mo>−</mo><mrow><mi>α</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>s</mi><mi>t</mi></msub></mrow></mrow><mo>+</mo><mrow><mrow><mo rspace="0.167em">∇</mo><mi>f</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>z</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\dot{s}_{t}=-\alpha s_{t}+\nabla f(z_{t})</annotation></semantics></math> and <math id="A10.Thmtheorem10.p4.m3" class="ltx_Math" alttext="s_{0}=0" display="inline" intent=":literal"><semantics><mrow><msub><mi>s</mi><mn>0</mn></msub><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">s_{0}=0</annotation></semantics></math>. Then</span></p>
<table id="A10.E151" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A10.E151.m1" class="ltx_Math" alttext="\|s_{t}-m_{t}\|_{2}=\left\|\int_{0}^{t}e^{-\alpha(t-s)}(\nabla f(z_{s})-\nabla f(w_{s}))ds\right\|_{2}\leq L\int_{0}^{t}e^{-\alpha(t-s)}\|w_{s}-\Phi(w_{s})\|_{2}ds" display="block" intent=":literal"><semantics><mrow><msub><mrow><mo stretchy="false">‖</mo><mrow><msub><mi>s</mi><mi>t</mi></msub><mo>−</mo><msub><mi>m</mi><mi>t</mi></msub></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn></msub><mo>=</mo><msub><mrow><mo>‖</mo><mrow><msubsup><mo lspace="0em">∫</mo><mn>0</mn><mi>t</mi></msubsup><mrow><msup><mi>e</mi><mrow><mo>−</mo><mrow><mi>α</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>t</mi><mo>−</mo><mi>s</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mrow><mo rspace="0.167em">∇</mo><mi>f</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>z</mi><mi>s</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mrow><mo rspace="0.167em">∇</mo><mi>f</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>w</mi><mi>s</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo rspace="0em">𝑑</mo><mi>s</mi></mrow></mrow></mrow><mo>‖</mo></mrow><mn>2</mn></msub><mo>≤</mo><mrow><mi>L</mi><mo lspace="0em" rspace="0em">​</mo><mrow><msubsup><mo>∫</mo><mn>0</mn><mi>t</mi></msubsup><mrow><msup><mi>e</mi><mrow><mo>−</mo><mrow><mi>α</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>t</mi><mo>−</mo><mi>s</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">‖</mo><mrow><msub><mi>w</mi><mi>s</mi></msub><mo>−</mo><mrow><mi mathvariant="normal">Φ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>w</mi><mi>s</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo rspace="0em">𝑑</mo><mi>s</mi></mrow></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\|s_{t}-m_{t}\|_{2}=\left\|\int_{0}^{t}e^{-\alpha(t-s)}(\nabla f(z_{s})-\nabla f(w_{s}))ds\right\|_{2}\leq L\int_{0}^{t}e^{-\alpha(t-s)}\|w_{s}-\Phi(w_{s})\|_{2}ds</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(151)</span></td></tr></tbody>
</table>
<p id="A10.Thmtheorem10.p4.5" class="ltx_p"><span id="A10.Thmtheorem10.p4.5.1" class="ltx_text">and</span></p>
<table id="A10.E152" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A10.E152.m1" class="ltx_Math" alttext="\max\{\|s_{t}\|_{2},\|m_{t}\|_{2}\}\leq\int_{0}^{t}e^{-\alpha(t-s)}\max\{\|\nabla f(w_{s})\|_{2},\|\nabla f(z_{s})\|_{2}\}ds\leq\int_{0}^{t}e^{-\alpha(t-s)}\lambda_{F}^{-\frac{1}{2}}Gds\leq\frac{\lambda_{F}^{-\frac{1}{2}}}{\alpha}G." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mi>max</mi><mo>⁡</mo><mrow><mo stretchy="false">{</mo><msub><mrow><mo stretchy="false">‖</mo><msub><mi>s</mi><mi>t</mi></msub><mo stretchy="false">‖</mo></mrow><mn>2</mn></msub><mo>,</mo><msub><mrow><mo stretchy="false">‖</mo><msub><mi>m</mi><mi>t</mi></msub><mo stretchy="false">‖</mo></mrow><mn>2</mn></msub><mo stretchy="false">}</mo></mrow></mrow><mo rspace="0.111em">≤</mo><mrow><msubsup><mo>∫</mo><mn>0</mn><mi>t</mi></msubsup><mrow><msup><mi>e</mi><mrow><mo>−</mo><mrow><mi>α</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>t</mi><mo>−</mo><mi>s</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></msup><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>max</mi><mo>⁡</mo><mrow><mo stretchy="false">{</mo><msub><mrow><mo stretchy="false">‖</mo><mrow><mrow><mo rspace="0.167em">∇</mo><mi>f</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>w</mi><mi>s</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn></msub><mo>,</mo><msub><mrow><mo stretchy="false">‖</mo><mrow><mrow><mo rspace="0.167em">∇</mo><mi>f</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>z</mi><mi>s</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn></msub><mo stretchy="false">}</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo rspace="0em">𝑑</mo><mi>s</mi></mrow></mrow></mrow><mo rspace="0.111em">≤</mo><mrow><msubsup><mo>∫</mo><mn>0</mn><mi>t</mi></msubsup><mrow><msup><mi>e</mi><mrow><mo>−</mo><mrow><mi>α</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>t</mi><mo>−</mo><mi>s</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>λ</mi><mi>F</mi><mrow><mo>−</mo><mfrac><mn>1</mn><mn>2</mn></mfrac></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>G</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo rspace="0em">𝑑</mo><mi>s</mi></mrow></mrow></mrow><mo>≤</mo><mrow><mfrac><msubsup><mi>λ</mi><mi>F</mi><mrow><mo>−</mo><mfrac><mn>1</mn><mn>2</mn></mfrac></mrow></msubsup><mi>α</mi></mfrac><mo lspace="0em" rspace="0em">​</mo><mi>G</mi></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\max\{\|s_{t}\|_{2},\|m_{t}\|_{2}\}\leq\int_{0}^{t}e^{-\alpha(t-s)}\max\{\|\nabla f(w_{s})\|_{2},\|\nabla f(z_{s})\|_{2}\}ds\leq\int_{0}^{t}e^{-\alpha(t-s)}\lambda_{F}^{-\frac{1}{2}}Gds\leq\frac{\lambda_{F}^{-\frac{1}{2}}}{\alpha}G.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(152)</span></td></tr></tbody>
</table>
<p id="A10.Thmtheorem10.p4.6" class="ltx_p"><span id="A10.Thmtheorem10.p4.6.1" class="ltx_text">On the other hand,</span></p>
<table id="A10.E153" class="ltx_equationgroup ltx_eqn_table">
<tbody>
<tr id="A10.E153X" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A10.E153X.m2" class="ltx_Math" alttext="\displaystyle\|F_{s}^{\dagger}(w_{t})m_{t}-F_{s}^{\dagger}(z_{t})s_{t}\|_{2}\leq" display="inline" intent=":literal"><semantics><mrow><msub><mrow><mo stretchy="false">‖</mo><mrow><mrow><msubsup><mi>F</mi><mi>s</mi><mo>†</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>w</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>m</mi><mi>t</mi></msub></mrow><mo>−</mo><mrow><msubsup><mi>F</mi><mi>s</mi><mo>†</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>z</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>s</mi><mi>t</mi></msub></mrow></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn></msub><mo>≤</mo><mphantom></mphantom></mrow><annotation encoding="application/x-tex">\displaystyle\|F_{s}^{\dagger}(w_{t})m_{t}-F_{s}^{\dagger}(z_{t})s_{t}\|_{2}\leq</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A10.E153X.m3" class="ltx_Math" alttext="\displaystyle\|F_{s}^{\dagger}(w_{t})(m_{t}-s_{t})\|_{2}+\|F_{s}^{\dagger}(w_{t})s_{t}-F_{s}^{\dagger}(z_{t})s_{t}\|_{2}" display="inline" intent=":literal"><semantics><mrow><msub><mrow><mo stretchy="false">‖</mo><mrow><msubsup><mi>F</mi><mi>s</mi><mo>†</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>w</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>m</mi><mi>t</mi></msub><mo>−</mo><msub><mi>s</mi><mi>t</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn></msub><mo>+</mo><msub><mrow><mo stretchy="false">‖</mo><mrow><mrow><msubsup><mi>F</mi><mi>s</mi><mo>†</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>w</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>s</mi><mi>t</mi></msub></mrow><mo>−</mo><mrow><msubsup><mi>F</mi><mi>s</mi><mo>†</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>z</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>s</mi><mi>t</mi></msub></mrow></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn></msub></mrow><annotation encoding="application/x-tex">\displaystyle\|F_{s}^{\dagger}(w_{t})(m_{t}-s_{t})\|_{2}+\|F_{s}^{\dagger}(w_{t})s_{t}-F_{s}^{\dagger}(z_{t})s_{t}\|_{2}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="3" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equationgroup ltx_align_right">(153)</span></td></tr>
<tr id="A10.E153Xa" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A10.E153Xa.m2" class="ltx_Math" alttext="\displaystyle\overset{\eqref{d-Fs-2-norm}}{\leq}" display="inline" intent=":literal"><semantics><mover accent="true"><mo>≤</mo><mrow><mtext mathsize="0.700em">(</mtext><mtext mathsize="0.700em"><a href="#A10.E143" title="Equation 143 ‣ Lemma J.9. ‣ J.2 Dynamics Analysis ‣ Appendix J Proof ‣ Accelerating LLM Pre-Training through Flat-Direction Dynamics Enhancement" class="ltx_ref" style="font-size:70%;"><span class="ltx_text ltx_ref_tag">143</span></a></mtext><mtext mathsize="0.700em">)</mtext></mrow></mover><annotation encoding="application/x-tex">\displaystyle\overset{\eqref{d-Fs-2-norm}}{\leq}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A10.E153Xa.m3" class="ltx_Math" alttext="\displaystyle\lambda_{F_{s}}^{-1}\|m_{t}-s_{t}\|_{2}+\frac{\delta_{F_{s}}}{G}\kappa_{F}^{\frac{1}{2}}\lambda_{F}^{-\frac{1}{2}}\|s_{t}\|_{2}\|w_{t}-\Phi(w_{t})\|_{2}" display="inline" intent=":literal"><semantics><mrow><mrow><msubsup><mi>λ</mi><msub><mi>F</mi><mi>s</mi></msub><mrow><mo>−</mo><mn>1</mn></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">‖</mo><mrow><msub><mi>m</mi><mi>t</mi></msub><mo>−</mo><msub><mi>s</mi><mi>t</mi></msub></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn></msub></mrow><mo>+</mo><mrow><mstyle displaystyle="true"><mfrac><msub><mi>δ</mi><msub><mi>F</mi><mi>s</mi></msub></msub><mi>G</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>κ</mi><mi>F</mi><mfrac><mn>1</mn><mn>2</mn></mfrac></msubsup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>λ</mi><mi>F</mi><mrow><mo>−</mo><mfrac><mn>1</mn><mn>2</mn></mfrac></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">‖</mo><msub><mi>s</mi><mi>t</mi></msub><mo stretchy="false">‖</mo></mrow><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">‖</mo><mrow><msub><mi>w</mi><mi>t</mi></msub><mo>−</mo><mrow><mi mathvariant="normal">Φ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>w</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn></msub></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\lambda_{F_{s}}^{-1}\|m_{t}-s_{t}\|_{2}+\frac{\delta_{F_{s}}}{G}\kappa_{F}^{\frac{1}{2}}\lambda_{F}^{-\frac{1}{2}}\|s_{t}\|_{2}\|w_{t}-\Phi(w_{t})\|_{2}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr>
<tr id="A10.E153Xb" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A10.E153Xb.m2" class="ltx_Math" alttext="\displaystyle\overset{\eqref{s-m-2-bound}}{\leq}" display="inline" intent=":literal"><semantics><mover accent="true"><mo>≤</mo><mrow><mtext mathsize="0.700em">(</mtext><mtext mathsize="0.700em"><a href="#A10.E152" title="Equation 152 ‣ Proof. ‣ Lemma J.10. ‣ J.2 Dynamics Analysis ‣ Appendix J Proof ‣ Accelerating LLM Pre-Training through Flat-Direction Dynamics Enhancement" class="ltx_ref" style="font-size:70%;"><span class="ltx_text ltx_ref_tag">152</span></a></mtext><mtext mathsize="0.700em">)</mtext></mrow></mover><annotation encoding="application/x-tex">\displaystyle\overset{\eqref{s-m-2-bound}}{\leq}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A10.E153Xb.m3" class="ltx_Math" alttext="\displaystyle\lambda_{F_{s}}^{-1}\|m_{t}-s_{t}\|_{2}+\frac{\delta_{F_{s}}}{\alpha}\kappa_{F}^{\frac{1}{2}}\lambda_{F}^{-1}\|w_{t}-\Phi(w_{t})\|_{2}" display="inline" intent=":literal"><semantics><mrow><mrow><msubsup><mi>λ</mi><msub><mi>F</mi><mi>s</mi></msub><mrow><mo>−</mo><mn>1</mn></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">‖</mo><mrow><msub><mi>m</mi><mi>t</mi></msub><mo>−</mo><msub><mi>s</mi><mi>t</mi></msub></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn></msub></mrow><mo>+</mo><mrow><mstyle displaystyle="true"><mfrac><msub><mi>δ</mi><msub><mi>F</mi><mi>s</mi></msub></msub><mi>α</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>κ</mi><mi>F</mi><mfrac><mn>1</mn><mn>2</mn></mfrac></msubsup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>λ</mi><mi>F</mi><mrow><mo>−</mo><mn>1</mn></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">‖</mo><mrow><msub><mi>w</mi><mi>t</mi></msub><mo>−</mo><mrow><mi mathvariant="normal">Φ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>w</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn></msub></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\lambda_{F_{s}}^{-1}\|m_{t}-s_{t}\|_{2}+\frac{\delta_{F_{s}}}{\alpha}\kappa_{F}^{\frac{1}{2}}\lambda_{F}^{-1}\|w_{t}-\Phi(w_{t})\|_{2}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A10.Thmtheorem10.p4.7" class="ltx_p"><span id="A10.Thmtheorem10.p4.7.1" class="ltx_text">Similarly</span></p>
<table id="A10.E154" class="ltx_equationgroup ltx_eqn_table">
<tbody>
<tr id="A10.E154X" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A10.E154X.m2" class="ltx_Math" alttext="\displaystyle\|F_{f}^{\dagger}(w_{t})m_{t}-F_{f}^{\dagger}(z_{t})s_{t}\|_{2}\leq" display="inline" intent=":literal"><semantics><mrow><msub><mrow><mo stretchy="false">‖</mo><mrow><mrow><msubsup><mi>F</mi><mi>f</mi><mo>†</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>w</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>m</mi><mi>t</mi></msub></mrow><mo>−</mo><mrow><msubsup><mi>F</mi><mi>f</mi><mo>†</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>z</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>s</mi><mi>t</mi></msub></mrow></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn></msub><mo>≤</mo><mphantom></mphantom></mrow><annotation encoding="application/x-tex">\displaystyle\|F_{f}^{\dagger}(w_{t})m_{t}-F_{f}^{\dagger}(z_{t})s_{t}\|_{2}\leq</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A10.E154X.m3" class="ltx_Math" alttext="\displaystyle\|F_{f}^{\dagger}(w_{t})(m_{t}-s_{t})\|_{2}+\|F_{f}^{\dagger}(w_{t})s_{t}-F_{f}^{\dagger}(z_{t})s_{t}\|_{2}" display="inline" intent=":literal"><semantics><mrow><msub><mrow><mo stretchy="false">‖</mo><mrow><msubsup><mi>F</mi><mi>f</mi><mo>†</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>w</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>m</mi><mi>t</mi></msub><mo>−</mo><msub><mi>s</mi><mi>t</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn></msub><mo>+</mo><msub><mrow><mo stretchy="false">‖</mo><mrow><mrow><msubsup><mi>F</mi><mi>f</mi><mo>†</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>w</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>s</mi><mi>t</mi></msub></mrow><mo>−</mo><mrow><msubsup><mi>F</mi><mi>f</mi><mo>†</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>z</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>s</mi><mi>t</mi></msub></mrow></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn></msub></mrow><annotation encoding="application/x-tex">\displaystyle\|F_{f}^{\dagger}(w_{t})(m_{t}-s_{t})\|_{2}+\|F_{f}^{\dagger}(w_{t})s_{t}-F_{f}^{\dagger}(z_{t})s_{t}\|_{2}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="3" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equationgroup ltx_align_right">(154)</span></td></tr>
<tr id="A10.E154Xa" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A10.E154Xa.m2" class="ltx_Math" alttext="\displaystyle\overset{\eqref{d-Ff-2-norm}}{\leq}" display="inline" intent=":literal"><semantics><mover accent="true"><mo>≤</mo><mrow><mtext mathsize="0.700em">(</mtext><mtext mathsize="0.700em"><a href="#A10.E144" title="Equation 144 ‣ Lemma J.9. ‣ J.2 Dynamics Analysis ‣ Appendix J Proof ‣ Accelerating LLM Pre-Training through Flat-Direction Dynamics Enhancement" class="ltx_ref" style="font-size:70%;"><span class="ltx_text ltx_ref_tag">144</span></a></mtext><mtext mathsize="0.700em">)</mtext></mrow></mover><annotation encoding="application/x-tex">\displaystyle\overset{\eqref{d-Ff-2-norm}}{\leq}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A10.E154Xa.m3" class="ltx_Math" alttext="\displaystyle\lambda_{F}^{-1}\|m_{t}-s_{t}\|_{2}+\frac{\delta_{F_{s}}}{G}\kappa_{F}^{\frac{1}{2}}\lambda_{F}^{-\frac{1}{2}}\|s_{t}\|_{2}\|w_{t}-\Phi(w_{t})\|_{2}" display="inline" intent=":literal"><semantics><mrow><mrow><msubsup><mi>λ</mi><mi>F</mi><mrow><mo>−</mo><mn>1</mn></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">‖</mo><mrow><msub><mi>m</mi><mi>t</mi></msub><mo>−</mo><msub><mi>s</mi><mi>t</mi></msub></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn></msub></mrow><mo>+</mo><mrow><mstyle displaystyle="true"><mfrac><msub><mi>δ</mi><msub><mi>F</mi><mi>s</mi></msub></msub><mi>G</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>κ</mi><mi>F</mi><mfrac><mn>1</mn><mn>2</mn></mfrac></msubsup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>λ</mi><mi>F</mi><mrow><mo>−</mo><mfrac><mn>1</mn><mn>2</mn></mfrac></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">‖</mo><msub><mi>s</mi><mi>t</mi></msub><mo stretchy="false">‖</mo></mrow><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">‖</mo><mrow><msub><mi>w</mi><mi>t</mi></msub><mo>−</mo><mrow><mi mathvariant="normal">Φ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>w</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn></msub></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\lambda_{F}^{-1}\|m_{t}-s_{t}\|_{2}+\frac{\delta_{F_{s}}}{G}\kappa_{F}^{\frac{1}{2}}\lambda_{F}^{-\frac{1}{2}}\|s_{t}\|_{2}\|w_{t}-\Phi(w_{t})\|_{2}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr>
<tr id="A10.E154Xb" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A10.E154Xb.m2" class="ltx_Math" alttext="\displaystyle\overset{\eqref{s-m-2-bound}}{\leq}" display="inline" intent=":literal"><semantics><mover accent="true"><mo>≤</mo><mrow><mtext mathsize="0.700em">(</mtext><mtext mathsize="0.700em"><a href="#A10.E152" title="Equation 152 ‣ Proof. ‣ Lemma J.10. ‣ J.2 Dynamics Analysis ‣ Appendix J Proof ‣ Accelerating LLM Pre-Training through Flat-Direction Dynamics Enhancement" class="ltx_ref" style="font-size:70%;"><span class="ltx_text ltx_ref_tag">152</span></a></mtext><mtext mathsize="0.700em">)</mtext></mrow></mover><annotation encoding="application/x-tex">\displaystyle\overset{\eqref{s-m-2-bound}}{\leq}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A10.E154Xb.m3" class="ltx_Math" alttext="\displaystyle\lambda_{F_{s}}^{-1}\|m_{t}-s_{t}\|_{2}+\frac{\delta_{F_{s}}}{\alpha}\kappa_{F}^{\frac{1}{2}}\lambda_{F}^{-1}\|w_{t}-\Phi(w_{t})\|_{2}," display="inline" intent=":literal"><semantics><mrow><mrow><mrow><msubsup><mi>λ</mi><msub><mi>F</mi><mi>s</mi></msub><mrow><mo>−</mo><mn>1</mn></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">‖</mo><mrow><msub><mi>m</mi><mi>t</mi></msub><mo>−</mo><msub><mi>s</mi><mi>t</mi></msub></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn></msub></mrow><mo>+</mo><mrow><mstyle displaystyle="true"><mfrac><msub><mi>δ</mi><msub><mi>F</mi><mi>s</mi></msub></msub><mi>α</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>κ</mi><mi>F</mi><mfrac><mn>1</mn><mn>2</mn></mfrac></msubsup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>λ</mi><mi>F</mi><mrow><mo>−</mo><mn>1</mn></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">‖</mo><mrow><msub><mi>w</mi><mi>t</mi></msub><mo>−</mo><mrow><mi mathvariant="normal">Φ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>w</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn></msub></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\lambda_{F_{s}}^{-1}\|m_{t}-s_{t}\|_{2}+\frac{\delta_{F_{s}}}{\alpha}\kappa_{F}^{\frac{1}{2}}\lambda_{F}^{-1}\|w_{t}-\Phi(w_{t})\|_{2},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A10.Thmtheorem10.p4.8" class="ltx_p"><span id="A10.Thmtheorem10.p4.8.1" class="ltx_text">and</span></p>
<table id="A10.E155" class="ltx_equationgroup ltx_eqn_table">
<tbody>
<tr id="A10.E155X" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A10.E155X.m2" class="ltx_Math" alttext="\displaystyle\|F_{f}^{\dagger}(w_{t})\nabla f(w_{t})-F_{f}^{\dagger}(z_{t})\nabla f(z_{t})\|_{2}\leq" display="inline" intent=":literal"><semantics><mrow><mo rspace="0.167em">∥</mo><mi>F</mi><msub><mrow></mrow><mi>f</mi></msub><msup><mrow></mrow><mo>†</mo></msup><mo stretchy="false">(</mo><mi>w</mi><msub><mrow></mrow><mi>t</mi></msub><mo rspace="0.167em" stretchy="false">)</mo><mo rspace="0.167em">∇</mo><mi>f</mi><mo stretchy="false">(</mo><mi>w</mi><msub><mrow></mrow><mi>t</mi></msub><mo stretchy="false">)</mo><mo>−</mo><mi>F</mi><msub><mrow></mrow><mi>f</mi></msub><msup><mrow></mrow><mo>†</mo></msup><mo stretchy="false">(</mo><mi>z</mi><msub><mrow></mrow><mi>t</mi></msub><mo rspace="0.167em" stretchy="false">)</mo><mo rspace="0.167em">∇</mo><mi>f</mi><mo stretchy="false">(</mo><mi>z</mi><msub><mrow></mrow><mi>t</mi></msub><mo stretchy="false">)</mo><mo lspace="0em" rspace="0.0835em">∥</mo><msub><mrow></mrow><mn>2</mn></msub><mo lspace="0.0835em">≤</mo></mrow><annotation encoding="application/x-tex">\displaystyle\|F_{f}^{\dagger}(w_{t})\nabla f(w_{t})-F_{f}^{\dagger}(z_{t})\nabla f(z_{t})\|_{2}\leq</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A10.E155X.m3" class="ltx_Math" alttext="\displaystyle\|F_{f}^{\dagger}(w_{t})(\nabla f(w_{t})-\nabla f(z_{t}))\|_{2}+\|F_{f}^{\dagger}(w_{t})\nabla f(z_{t})-F_{f}^{\dagger}(z_{t})\nabla f(z_{t})\|_{2}" display="inline" intent=":literal"><semantics><mrow><mo rspace="0.167em">∥</mo><mi>F</mi><msub><mrow></mrow><mi>f</mi></msub><msup><mrow></mrow><mo>†</mo></msup><mo stretchy="false">(</mo><mi>w</mi><msub><mrow></mrow><mi>t</mi></msub><mo stretchy="false">)</mo><mo stretchy="false">(</mo><mo rspace="0.167em">∇</mo><mi>f</mi><mo stretchy="false">(</mo><mi>w</mi><msub><mrow></mrow><mi>t</mi></msub><mo stretchy="false">)</mo><mo>−</mo><mo rspace="0.167em">∇</mo><mi>f</mi><mo stretchy="false">(</mo><mi>z</mi><msub><mrow></mrow><mi>t</mi></msub><mo stretchy="false">)</mo><mo stretchy="false">)</mo><mo lspace="0em" rspace="0em">∥</mo><msub><mrow></mrow><mn>2</mn></msub><mo lspace="0em" rspace="0em">+</mo><mo lspace="0em" rspace="0.167em">∥</mo><mi>F</mi><msub><mrow></mrow><mi>f</mi></msub><msup><mrow></mrow><mo>†</mo></msup><mo stretchy="false">(</mo><mi>w</mi><msub><mrow></mrow><mi>t</mi></msub><mo rspace="0.167em" stretchy="false">)</mo><mo rspace="0.167em">∇</mo><mi>f</mi><mo stretchy="false">(</mo><mi>z</mi><msub><mrow></mrow><mi>t</mi></msub><mo stretchy="false">)</mo><mo>−</mo><mi>F</mi><msub><mrow></mrow><mi>f</mi></msub><msup><mrow></mrow><mo>†</mo></msup><mo stretchy="false">(</mo><mi>z</mi><msub><mrow></mrow><mi>t</mi></msub><mo rspace="0.167em" stretchy="false">)</mo><mo rspace="0.167em">∇</mo><mi>f</mi><mo stretchy="false">(</mo><mi>z</mi><msub><mrow></mrow><mi>t</mi></msub><mo stretchy="false">)</mo><mo lspace="0em">∥</mo><msub><mrow></mrow><mn>2</mn></msub></mrow><annotation encoding="application/x-tex">\displaystyle\|F_{f}^{\dagger}(w_{t})(\nabla f(w_{t})-\nabla f(z_{t}))\|_{2}+\|F_{f}^{\dagger}(w_{t})\nabla f(z_{t})-F_{f}^{\dagger}(z_{t})\nabla f(z_{t})\|_{2}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="2" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equationgroup ltx_align_right">(155)</span></td></tr>
<tr id="A10.E155Xa" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A10.E155Xa.m2" class="ltx_Math" alttext="\displaystyle\overset{\eqref{d-Ff-2-norm}}{\leq}" display="inline" intent=":literal"><semantics><mover accent="true"><mo>≤</mo><mrow><mtext mathsize="0.700em">(</mtext><mtext mathsize="0.700em"><a href="#A10.E144" title="Equation 144 ‣ Lemma J.9. ‣ J.2 Dynamics Analysis ‣ Appendix J Proof ‣ Accelerating LLM Pre-Training through Flat-Direction Dynamics Enhancement" class="ltx_ref" style="font-size:70%;"><span class="ltx_text ltx_ref_tag">144</span></a></mtext><mtext mathsize="0.700em">)</mtext></mrow></mover><annotation encoding="application/x-tex">\displaystyle\overset{\eqref{d-Ff-2-norm}}{\leq}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A10.E155Xa.m3" class="ltx_Math" alttext="\displaystyle\lambda_{F}^{-1}L\|w_{t}-\Phi(w_{t})\|_{2}+\delta_{F_{s}}\kappa_{F}^{\frac{1}{2}}\lambda_{F}^{-1}\|w_{t}-\Phi(w_{t})\|_{2}." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><msubsup><mi>λ</mi><mi>F</mi><mrow><mo>−</mo><mn>1</mn></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>L</mi><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">‖</mo><mrow><msub><mi>w</mi><mi>t</mi></msub><mo>−</mo><mrow><mi mathvariant="normal">Φ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>w</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn></msub></mrow><mo>+</mo><mrow><msub><mi>δ</mi><msub><mi>F</mi><mi>s</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>κ</mi><mi>F</mi><mfrac><mn>1</mn><mn>2</mn></mfrac></msubsup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>λ</mi><mi>F</mi><mrow><mo>−</mo><mn>1</mn></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">‖</mo><mrow><msub><mi>w</mi><mi>t</mi></msub><mo>−</mo><mrow><mi mathvariant="normal">Φ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>w</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn></msub></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\lambda_{F}^{-1}L\|w_{t}-\Phi(w_{t})\|_{2}+\delta_{F_{s}}\kappa_{F}^{\frac{1}{2}}\lambda_{F}^{-1}\|w_{t}-\Phi(w_{t})\|_{2}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="A10.Thmtheorem10.p5" class="ltx_para">
<p id="A10.Thmtheorem10.p5.1" class="ltx_p"><span id="A10.Thmtheorem10.p5.1.1" class="ltx_text">Now we rewrite (<a href="#A10.E150" title="Equation 150 ‣ Proof. ‣ Lemma J.10. ‣ J.2 Dynamics Analysis ‣ Appendix J Proof ‣ Accelerating LLM Pre-Training through Flat-Direction Dynamics Enhancement" class="ltx_ref"><span class="ltx_text ltx_ref_tag">150</span></a>) as</span></p>
</div>
<div id="A10.Thmtheorem10.p6" class="ltx_para">
<table id="A10.E156" class="ltx_equationgroup ltx_eqn_table">
<tbody>
<tr id="A10.E156X" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A10.E156X.m2" class="ltx_Math" alttext="\displaystyle\dot{z}_{t}=" display="inline" intent=":literal"><semantics><mrow><msub><mover accent="true"><mi>z</mi><mo>˙</mo></mover><mi>t</mi></msub><mo>=</mo><mphantom></mphantom></mrow><annotation encoding="application/x-tex">\displaystyle\dot{z}_{t}=</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A10.E156X.m3" class="ltx_Math" alttext="\displaystyle-\eta_{t}P_{\mathcal{R}}(z_{t})\left(F_{s}^{\dagger}(z_{t})s_{t}+\chi F_{f}^{\dagger}(z_{t})(s_{t}+\beta_{2}\nabla f(z_{t}))\right)+\eta_{t}\epsilon_{z,t}," display="inline" intent=":literal"><semantics><mrow><mo>−</mo><mi>η</mi><msub><mrow></mrow><mi>t</mi></msub><mi>P</mi><msub><mrow></mrow><mi class="ltx_font_mathcaligraphic">ℛ</mi></msub><mo stretchy="false">(</mo><mi>z</mi><msub><mrow></mrow><mi>t</mi></msub><mo stretchy="false">)</mo><mo>(</mo><mi>F</mi><msub><mrow></mrow><mi>s</mi></msub><msup><mrow></mrow><mo>†</mo></msup><mo stretchy="false">(</mo><mi>z</mi><msub><mrow></mrow><mi>t</mi></msub><mo stretchy="false">)</mo><mi>s</mi><msub><mrow></mrow><mi>t</mi></msub><mo>+</mo><mi>χ</mi><mi>F</mi><msub><mrow></mrow><mi>f</mi></msub><msup><mrow></mrow><mo>†</mo></msup><mo stretchy="false">(</mo><mi>z</mi><msub><mrow></mrow><mi>t</mi></msub><mo stretchy="false">)</mo><mo stretchy="false">(</mo><mi>s</mi><msub><mrow></mrow><mi>t</mi></msub><mo>+</mo><mi>β</mi><msub><mrow></mrow><mn>2</mn></msub><mo lspace="0.167em" rspace="0.167em">∇</mo><mi>f</mi><mo stretchy="false">(</mo><mi>z</mi><msub><mrow></mrow><mi>t</mi></msub><mo stretchy="false">)</mo><mo stretchy="false">)</mo><mo>)</mo><mo>+</mo><mi>η</mi><msub><mrow></mrow><mi>t</mi></msub><mi>ϵ</mi><msub><mrow></mrow><mrow><mi>z</mi><mo>,</mo><mi>t</mi></mrow></msub><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle-\eta_{t}P_{\mathcal{R}}(z_{t})\left(F_{s}^{\dagger}(z_{t})s_{t}+\chi F_{f}^{\dagger}(z_{t})(s_{t}+\beta_{2}\nabla f(z_{t}))\right)+\eta_{t}\epsilon_{z,t},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equationgroup ltx_align_right">(156)</span></td></tr></tbody>
</table>
<p id="A10.Thmtheorem10.p6.1" class="ltx_p"><span id="A10.Thmtheorem10.p6.1.1" class="ltx_text">where</span></p>
<table id="A10.E157" class="ltx_equationgroup ltx_eqn_table">
<tbody>
<tr id="A10.E157X" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A10.E157X.m2" class="ltx_Math" alttext="\displaystyle\epsilon_{z,t}=" display="inline" intent=":literal"><semantics><mrow><msub><mi>ϵ</mi><mrow><mi>z</mi><mo>,</mo><mi>t</mi></mrow></msub><mo>=</mo><mphantom></mphantom></mrow><annotation encoding="application/x-tex">\displaystyle\epsilon_{z,t}=</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A10.E157X.m3" class="ltx_Math" alttext="\displaystyle-\underbrace{P_{\mathcal{R}}(z_{t})\left(F_{s}^{\dagger}(w_{t})m_{t}-F_{s}^{\dagger}(z_{t})s_{t}\right)}_{a}" display="inline" intent=":literal"><semantics><mrow><mo>−</mo><munder><munder accentunder="true"><mrow><msub><mi>P</mi><mi class="ltx_font_mathcaligraphic">ℛ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>z</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mrow><msubsup><mi>F</mi><mi>s</mi><mo>†</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>w</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>m</mi><mi>t</mi></msub></mrow><mo>−</mo><mrow><msubsup><mi>F</mi><mi>s</mi><mo>†</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>z</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>s</mi><mi>t</mi></msub></mrow></mrow><mo>)</mo></mrow></mrow><mo stretchy="true">⏟</mo></munder><mi>a</mi></munder></mrow><annotation encoding="application/x-tex">\displaystyle-\underbrace{P_{\mathcal{R}}(z_{t})\left(F_{s}^{\dagger}(w_{t})m_{t}-F_{s}^{\dagger}(z_{t})s_{t}\right)}_{a}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="3" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equationgroup ltx_align_right">(157)</span></td></tr>
<tr id="A10.E157Xa" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A10.E157Xa.m2" class="ltx_Math" alttext="\displaystyle-\underbrace{(\nabla\Phi(w_{t})-P_{\mathcal{R}}(z_{t}))\left(F_{s}^{\dagger}(w_{t})m_{t}+\chi F_{f}^{\dagger}(z_{t})(s_{t}+\beta_{2}\nabla f(z_{t}))\right)}_{b}" display="inline" intent=":literal"><semantics><mrow><mo>−</mo><munder><munder accentunder="true"><mrow><mo stretchy="false">(</mo><mo rspace="0.167em">∇</mo><mi mathvariant="normal">Φ</mi><mo stretchy="false">(</mo><mi>w</mi><msub><mrow></mrow><mi>t</mi></msub><mo stretchy="false">)</mo><mo>−</mo><mi>P</mi><msub><mrow></mrow><mi class="ltx_font_mathcaligraphic">ℛ</mi></msub><mo stretchy="false">(</mo><mi>z</mi><msub><mrow></mrow><mi>t</mi></msub><mo stretchy="false">)</mo><mo stretchy="false">)</mo><mo>(</mo><mi>F</mi><msub><mrow></mrow><mi>s</mi></msub><msup><mrow></mrow><mo>†</mo></msup><mo stretchy="false">(</mo><mi>w</mi><msub><mrow></mrow><mi>t</mi></msub><mo stretchy="false">)</mo><mi>m</mi><msub><mrow></mrow><mi>t</mi></msub><mo>+</mo><mi>χ</mi><mi>F</mi><msub><mrow></mrow><mi>f</mi></msub><msup><mrow></mrow><mo>†</mo></msup><mo stretchy="false">(</mo><mi>z</mi><msub><mrow></mrow><mi>t</mi></msub><mo stretchy="false">)</mo><mo stretchy="false">(</mo><mi>s</mi><msub><mrow></mrow><mi>t</mi></msub><mo>+</mo><mi>β</mi><msub><mrow></mrow><mn>2</mn></msub><mo lspace="0.167em" rspace="0.167em">∇</mo><mi>f</mi><mo stretchy="false">(</mo><mi>z</mi><msub><mrow></mrow><mi>t</mi></msub><mo stretchy="false">)</mo><mo stretchy="false">)</mo><mo>)</mo></mrow><mo stretchy="true">⏟</mo></munder><mi>b</mi></munder></mrow><annotation encoding="application/x-tex">\displaystyle-\underbrace{(\nabla\Phi(w_{t})-P_{\mathcal{R}}(z_{t}))\left(F_{s}^{\dagger}(w_{t})m_{t}+\chi F_{f}^{\dagger}(z_{t})(s_{t}+\beta_{2}\nabla f(z_{t}))\right)}_{b}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr>
<tr id="A10.E157Xb" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A10.E157Xb.m2" class="ltx_Math" alttext="\displaystyle-\underbrace{\chi\nabla\Phi(w_{t})\left(F_{f}^{\dagger}(w_{t})(m_{t}+\beta_{2}\nabla f(w_{t}))-F_{f}^{\dagger}(z_{t})(s_{t}+\beta_{2}\nabla f(z_{t}))\right)}_{c}." display="inline" intent=":literal"><semantics><mrow><mrow><mo>−</mo><munder><munder accentunder="true"><mrow><mi>χ</mi><mo lspace="0.167em" rspace="0.167em">∇</mo><mi mathvariant="normal">Φ</mi><mo stretchy="false">(</mo><mi>w</mi><msub><mrow></mrow><mi>t</mi></msub><mo stretchy="false">)</mo><mo>(</mo><mi>F</mi><msub><mrow></mrow><mi>f</mi></msub><msup><mrow></mrow><mo>†</mo></msup><mo stretchy="false">(</mo><mi>w</mi><msub><mrow></mrow><mi>t</mi></msub><mo stretchy="false">)</mo><mo stretchy="false">(</mo><mi>m</mi><msub><mrow></mrow><mi>t</mi></msub><mo>+</mo><mi>β</mi><msub><mrow></mrow><mn>2</mn></msub><mo lspace="0.167em" rspace="0.167em">∇</mo><mi>f</mi><mo stretchy="false">(</mo><mi>w</mi><msub><mrow></mrow><mi>t</mi></msub><mo stretchy="false">)</mo><mo stretchy="false">)</mo><mo>−</mo><mi>F</mi><msub><mrow></mrow><mi>f</mi></msub><msup><mrow></mrow><mo>†</mo></msup><mo stretchy="false">(</mo><mi>z</mi><msub><mrow></mrow><mi>t</mi></msub><mo stretchy="false">)</mo><mo stretchy="false">(</mo><mi>s</mi><msub><mrow></mrow><mi>t</mi></msub><mo>+</mo><mi>β</mi><msub><mrow></mrow><mn>2</mn></msub><mo lspace="0.167em" rspace="0.167em">∇</mo><mi>f</mi><mo stretchy="false">(</mo><mi>z</mi><msub><mrow></mrow><mi>t</mi></msub><mo stretchy="false">)</mo><mo stretchy="false">)</mo><mo>)</mo></mrow><mo stretchy="true">⏟</mo></munder><mi>c</mi></munder></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle-\underbrace{\chi\nabla\Phi(w_{t})\left(F_{f}^{\dagger}(w_{t})(m_{t}+\beta_{2}\nabla f(w_{t}))-F_{f}^{\dagger}(z_{t})(s_{t}+\beta_{2}\nabla f(z_{t}))\right)}_{c}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
