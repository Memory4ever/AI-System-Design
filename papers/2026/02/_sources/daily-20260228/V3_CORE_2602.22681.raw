<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A10.E111Xa.m3" class="ltx_Math" alttext="\displaystyle\|P_{f}(\psi_{t}(w))\partial_{w}(F_{s}^{{\dagger}}(\psi_{t}(w)))[v]\nabla f(\psi_{t}(w))\|_{F(\psi_{t}(w))}" display="inline" intent=":literal"><semantics><mrow><mo rspace="0.167em">∥</mo><mi>P</mi><msub><mrow></mrow><mi>f</mi></msub><mo stretchy="false">(</mo><mi>ψ</mi><msub><mrow></mrow><mi>t</mi></msub><mo stretchy="false">(</mo><mi>w</mi><mo stretchy="false">)</mo><mo stretchy="false">)</mo><mo lspace="0em">∂</mo><msub><mrow></mrow><mi>w</mi></msub><mo stretchy="false">(</mo><mi>F</mi><msub><mrow></mrow><mi>s</mi></msub><msup><mrow></mrow><mo>†</mo></msup><mo stretchy="false">(</mo><mi>ψ</mi><msub><mrow></mrow><mi>t</mi></msub><mo stretchy="false">(</mo><mi>w</mi><mo stretchy="false">)</mo><mo stretchy="false">)</mo><mo stretchy="false">)</mo><mo stretchy="false">[</mo><mi>v</mi><mo rspace="0.167em" stretchy="false">]</mo><mo rspace="0.167em">∇</mo><mi>f</mi><mo stretchy="false">(</mo><mi>ψ</mi><msub><mrow></mrow><mi>t</mi></msub><mo stretchy="false">(</mo><mi>w</mi><mo stretchy="false">)</mo><mo stretchy="false">)</mo><mo lspace="0em">∥</mo><msub><mrow></mrow><mrow><mi>F</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>ψ</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>w</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></msub></mrow><annotation encoding="application/x-tex">\displaystyle\|P_{f}(\psi_{t}(w))\partial_{w}(F_{s}^{{\dagger}}(\psi_{t}(w)))[v]\nabla f(\psi_{t}(w))\|_{F(\psi_{t}(w))}</annotation></semantics></math></td>
