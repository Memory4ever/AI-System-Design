<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A10.E128Xd.m3" class="ltx_Math" alttext="\displaystyle 2\epsilon_{\Phi}(\frac{1}{\alpha}+\beta_{1})\eta_{t}\|\nabla f(w_{t})\|_{F_{s}^{\dagger}(w_{t})}^{2}+\epsilon_{\Phi}(\frac{1}{\alpha}+\frac{\beta_{1}}{2}+\chi\beta_{2}+\frac{\chi^{2}\beta_{2}^{2}\alpha}{2})\eta_{t}\|\nabla f(w_{t})\|_{F_{f}^{\dagger}(w_{t})}^{2}+\frac{\epsilon_{\Phi}\alpha}{2}\eta_{t}\|m_{t}\|_{F_{s}^{\dagger}(w_{t})}^{2}" display="inline" intent=":literal"><semantics><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>ϵ</mi><mi mathvariant="normal">Φ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>α</mi></mfrac></mstyle><mo>+</mo><msub><mi>β</mi><mn>1</mn></msub></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>η</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mrow><mo stretchy="false">‖</mo><mrow><mrow><mo rspace="0.167em">∇</mo><mi>f</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>w</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">‖</mo></mrow><mrow><msubsup><mi>F</mi><mi>s</mi><mo>†</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>w</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mn>2</mn></msubsup></mrow><mo>+</mo><mrow><msub><mi>ϵ</mi><mi mathvariant="normal">Φ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>α</mi></mfrac></mstyle><mo>+</mo><mstyle displaystyle="true"><mfrac><msub><mi>β</mi><mn>1</mn></msub><mn>2</mn></mfrac></mstyle><mo>+</mo><mrow><mi>χ</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>β</mi><mn>2</mn></msub></mrow><mo>+</mo><mstyle displaystyle="true"><mfrac><mrow><msup><mi>χ</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msubsup