              Estimate the update direction

<table id="S5.Ex4" class="ltx_equationgroup ltx_framed ltx_framed_rectangle ltx_eqn_table" style="--ltx-bg-color:#FFECD9;--ltx-border-color:#000000;padding:9.0pt;">

<tbody id="S5.Ex4X"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S5.Ex4X.m2" class="ltx_Math" alttext="\displaystyle u_{k}=" display="inline" intent=":literal"><semantics><mrow><msub><mi style="--ltx-bg-color:#FFECD9;" mathbackground="#FFECD9">u</mi><mi style="--ltx-bg-color:#FFECD9;" mathbackground="#FFECD9">k</mi></msub><mo style="--ltx-bg-color:#FFECD9;" mathbackground="#FFECD9">=</mo><mphantom></mphantom></mrow><annotation encoding="application/x-tex">\displaystyle u_{k}=</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S5.Ex4X.m3" class="ltx_Math" alttext="\displaystyle\color[rgb]{0.5,0,0.5}{\displaystyle(I-Q_{k})}F(w_{k})^{-1}(m_{k}+{\color[rgb]{0.5,0,0.5}\beta_{1}}\nabla f(w_{k}))" display="inline" intent=":literal"><semantics><mrow><mo style="--ltx-fg-color:#800080;--ltx-bg-color:#FFECD9;" mathbackground="#FFECD9" mathcolor="#800080" stretchy="false">(</mo><mi style="--ltx-fg-color:#800080;--ltx-bg-color:#FFECD9;" mathbackground="#FFECD9" mathcolor="#800080">I</mi><mo style="--ltx-fg-color:#800080;--ltx-bg-color:#FFECD9;" mathbackground="#FFECD9" mathcolor="#800080">−</mo><mi style="--ltx-fg-color:#800080;--ltx-bg-color:#FFECD9;" mathbackground="#FFECD9" mathcolor="#800080">Q</mi><msub><mrow></mrow><mi style="--ltx-fg-color:#800080;--ltx-bg-color:#FFECD9;" mathbackground="#FFECD9" mathcolor="#800080">k</mi></msub><mo style="--ltx-fg-color:#800080;--ltx-bg-color:#FFECD9;" mathbackground="#FFECD9" mathcolor="#800080" stretchy="false">)</mo><mi style="--ltx-bg-color:#FFECD9;" mathbackground="#FFECD9">F</mi><mo style="--ltx-bg-color:#FFECD9;" mathbackground="#FFECD9" stretchy="false">(</mo><mi style="--ltx-bg-color:#FFECD9;" mathbackground="#FFECD9">w</mi><msub><mrow></mrow><mi style="--ltx-bg-color:#FFECD9;" mathbackground="#FFECD9">k</mi></msub><mo style="--ltx-bg-color:#FFECD9;" mathbackground="#FFECD9" stretchy="false">)</mo><msup><mrow></mrow><mrow><mo style="--ltx-bg-color:#FFECD9;" mathbackground="#FFECD9">−</mo><mn style="--ltx-bg-color:#FFECD9;" mathbackground="#FFECD9">1</mn></mrow></msup><mo style="--ltx-bg-color:#FFECD9;" mathbackground="#FFECD9" stretchy="false">(</mo><mi style="--ltx-bg-color:#FFECD9;" mathbackground="#FFECD9">m</mi><msub><mrow></mrow><mi style="--ltx-bg-color:#FFECD9;" mathbackground="#FFECD9">k</mi></msub><mo style="--ltx-bg-color:#FFECD9;" mathbackground="#FFECD9">+</mo><mi style="--ltx-fg-color:#800080;--ltx-bg-color:#FFECD9;" mathbackground="#FFECD9" mathcolor="#800080">β</mi><msub><mrow></mrow><mn style="--ltx-fg-color:#800080;--ltx-bg-color:#FFECD9;" mathbackground="#FFECD9" mathcolor="#800080">1</mn></msub><mo style="--ltx-bg-color:#FFECD9;" lspace="0.167em" mathbackground="#FFECD9" rspace="0.167em">∇</mo><mi style="--ltx-bg-color:#FFECD9;" mathbackground="#FFECD9">f</mi><mo style="--ltx-bg-color:#FFECD9;" mathbackground="#FFECD9" stretchy="false">(</mo><mi style="--ltx-bg-color:#FFECD9;" mathbackground="#FFECD9">w</mi><msub><mrow></mrow><mi style="--ltx-bg-color:#FFECD9;" mathbackground="#FFECD9">k</mi></msub><mo style="--ltx-bg-color:#FFECD9;" mathbackground="#FFECD9" stretchy="false">)</mo><mo style="--ltx-bg-color:#FFECD9;" mathbackground="#FFECD9" stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">\displaystyle\color[rgb]{0.5,0,0.5}{\displaystyle(I-Q_{k})}F(w_{k})^{-1}(m_{k}+{\color[rgb]{0.5,0,0.5}\beta_{1}}\nabla f(w_{k}))</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
