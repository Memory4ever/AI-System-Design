<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A10.E106Xc.m3" class="ltx_Math" alttext="\displaystyle\delta_{F_{s}}\|F_{s}h_{t}\|_{F^{-1}}\|\partial_{w}\psi_{t}(w)[v]\|_{F}-\lambda_{H_{F},s}\|h_{t}\|^{2}_{F}," display="inline" intent=":literal"><semantics><mrow><mrow><mrow><msub><mi>δ</mi><msub><mi>F</mi><mi>s</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">‖</mo><mrow><msub><mi>F</mi><mi>s</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>h</mi><mi>t</mi></msub></mrow><mo stretchy="false">‖</mo></mrow><msup><mi>F</mi><mrow><mo>−</mo><mn>1</mn></mrow></msup></msub><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">‖</mo><mrow><msub><mo lspace="0em">∂</mo><mi>w</mi></msub><mrow><msub><mi>ψ</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>w</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mi>v</mi><mo stretchy="false">]</mo></mrow></mrow></mrow><mo stretchy="false">‖</mo></mrow><mi>F</mi></msub></mrow><mo>−</mo><mrow><msub><mi>λ</mi><mrow><msub><mi>H</mi><mi>F</mi></msub><mo>,</mo><mi>s</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mrow><mo stretchy="false">‖</mo><msub><mi>h</mi><mi>t</mi></msub><mo stretchy="false">‖</mo></mrow><mi>F</mi><mn>2</mn></msubsup></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\delta_{F_{s}}\|F_{s}h_{t}\|_{F^{-1}}\|\partial_{w}\psi_{t}(w)[v]\|_{F}-\lambda_{H_{F},s}\|h_{t}\|^{2}_{F},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="A10.Thmtheorem5.p7" class="ltx_para">
<p id="A10.Thmtheorem5.p7.2" class="ltx_p"><span id="A10.Thmtheorem5.p7.2.1" class="ltx_text">Substituting (<a href="#A10.E105" title="Equation 105 ‣ Proof. ‣ Lemma J.5. ‣ J.1 Landscape Analysis ‣ Appendix J Proof ‣ Accelerating LLM Pre-Training through Flat-Direction Dynamics Enhancement" class="ltx_ref"><span class="ltx_text ltx_ref_tag">105</span></a>) and (<a href="#A10.E106" title="Equation 106 ‣ Proof. ‣ Lemma J.5. ‣ J.1 Landscape Analysis ‣ Appendix J Proof ‣ Accelerating LLM Pre-Training through Flat-Direction Dynamics Enhancement" class="ltx_ref"><span class="ltx_text ltx_ref_tag">106</span></a>) into (<a href="#A10.E104" title="Equation 104 ‣ Proof. ‣ Lemma J.5. ‣ J.1 Landscape Analysis ‣ Appendix J Proof ‣ Accelerating LLM Pre-Training through Flat-Direction Dynamics Enhancement" class="ltx_ref"><span class="ltx_text ltx_ref_tag">104</span></a>) yields</span></p>
<table id="A10.E107" class="ltx_equationgroup ltx_eqn_table">
<tbody>
<tr id="A10.E107X" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A10.E107X.m2" class="ltx_Math" alttext="\displaystyle\frac{d}{dt}\|h_{t}\|_{F(\psi_{t}(w))}^{2}" display="inline" intent=":literal"><semantics><mrow><mstyle displaystyle="true"><mfrac><mi>d</mi><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msubsup><mrow><mo stretchy="false">‖</mo><msub><mi>h</mi><mi>t</mi></msub><mo stretchy="false">‖</mo></mrow><mrow><mi>F</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>ψ</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>w</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mn>2</mn></msubsup></mrow><annotation encoding="application/x-tex">\displaystyle\frac{d}{dt}\|h_{t}\|_{F(\psi_{t}(w))}^{2}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A10.E107X.m3" class="ltx_Math" alttext="\displaystyle\leq 3\delta_{F_{s}}\|h_{t}\|_{F(\psi_{t}(w))}\|h_{t}+r_{t}\|_{F(\psi_{t}(w))}-2\lambda_{H_{F},s}\|h_{t}\|^{2}_{F(\psi_{t}(w))}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≤</mo><mrow><mrow><mn>3</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>δ</mi><msub><mi>F</mi><mi>s</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">‖</mo><msub><mi>h</mi><mi>t</mi></msub><mo stretchy="false">‖</mo></mrow><mrow><mi>F</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>ψ</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>w</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">‖</mo><mrow><msub><mi>h</mi><mi>t</mi></msub><mo>+</mo><msub><mi>r</mi><mi>t</mi></msub></mrow><mo stretchy="false">‖</mo></mrow><mrow><mi>F</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>ψ</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>w</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></msub></mrow><mo>−</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>λ</mi><mrow><msub><mi>H</mi><mi>F</mi></msub><mo>,</mo><mi>s</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mrow><mo stretchy="false">‖</mo><msub><mi>h</mi><mi>t</mi></msub><mo stretchy="false">‖</mo></mrow><mrow><mi>F</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>ψ</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>w</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mn>2</mn></msubsup></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\leq 3\delta_{F_{s}}\|h_{t}\|_{F(\psi_{t}(w))}\|h_{t}+r_{t}\|_{F(\psi_{t}(w))}-2\lambda_{H_{F},s}\|h_{t}\|^{2}_{F(\psi_{t}(w))}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="2" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equationgroup ltx_align_right">(107)</span></td></tr>
<tr id="A10.E107Xa" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A10.E107Xa.m2" class="ltx_Math" alttext="\displaystyle\leq-2\underbrace{\left(\lambda_{H_{F},s}-\frac{3}{2}\delta_{F_{s}}\right)}_{:=\mu_{1}}\|h_{t}\|^{2}_{F(\psi_{t}(w))}+\delta_{F_{s}}\|h_{t}\|_{F(\psi_{t}(w))}\|r_{t}\|_{F(\psi_{t}(w))}." display="inline" intent=":literal"><semantics><mrow><mo rspace="0em">≤</mo><mo lspace="0em">−</mo><mn>2</mn><munder accentunder="true"><mrow><mo>(</mo><mrow><msub><mi>λ</mi><mrow><msub><mi>H</mi><mi>F</mi></msub><mo>,</mo><mi>s</mi></mrow></msub><mo>−</mo><mrow><mstyle displaystyle="true"><mfrac><mn>3</mn><mn>2</mn></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msub><mi>δ</mi><msub><mi>F</mi><mi>s</mi></msub></msub></mrow></mrow><mo>)</mo></mrow><mo stretchy="true">⏟</mo></munder><msub><mrow></mrow><mrow><mphantom></mphantom><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mphantom></mphantom><mo>=</mo><msub><mi>μ</mi><mn>1</mn></msub></mrow></mrow></msub><mo lspace="0em" rspace="0.167em">∥</mo><mi>h</mi><msub><mrow></mrow><mi>t</mi></msub><mo lspace="0em" rspace="0em">∥</mo><msup><mrow></mrow><mn>2</mn></msup><msub><mrow></mrow><mrow><mi>F</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>ψ</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>w</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></msub><mo lspace="0em">+</mo><mi>δ</mi><msub><mrow></mrow><msub><mi>F</mi><mi>s</mi></msub></msub><mo lspace="0em" rspace="0.167em">∥</mo><mi>h</mi><msub><mrow></mrow><mi>t</mi></msub><mo lspace="0em" rspace="0.0835em">∥</mo><msub><mrow></mrow><mrow><mi>F</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>ψ</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>w</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></msub><mo lspace="0.0835em" rspace="0.167em">∥</mo><mi>r</mi><msub><mrow></mrow><mi>t</mi></msub><mo lspace="0em" rspace="0.0835em">∥</mo><msub><mrow></mrow><mrow><mi>F</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>ψ</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>w</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></msub><mo lspace="0.0835em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\leq-2\underbrace{\left(\lambda_{H_{F},s}-\frac{3}{2}\delta_{F_{s}}\right)}_{:=\mu_{1}}\|h_{t}\|^{2}_{F(\psi_{t}(w))}+\delta_{F_{s}}\|h_{t}\|_{F(\psi_{t}(w))}\|r_{t}\|_{F(\psi_{t}(w))}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="A10.Thmtheorem5.p8" class="ltx_para">
<p id="A10.Thmtheorem5.p8.1" class="ltx_p"><span id="A10.Thmtheorem5.p8.1.1" class="ltx_text">Next we consider the time derivative for <math id="A10.Thmtheorem5.p8.m1" class="ltx_Math" alttext="r_{t}" display="inline" intent=":literal"><semantics><msub><mi>r</mi><mi>t</mi></msub><annotation encoding="application/x-tex">r_{t}</annotation></semantics></math>. Directly computing <math id="A10.Thmtheorem5.p8.m2" class="ltx_Math" alttext="\frac{d}{dt}r_{t}" display="inline" intent=":literal"><semantics><mrow><mfrac><mi>d</mi><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></mfrac><mo lspace="0em" rspace="0em">​</mo><msub><mi>r</mi><mi>t</mi></msub></mrow><annotation encoding="application/x-tex">\frac{d}{dt}r_{t}</annotation></semantics></math> gives:</span></p>
</div>
<div id="A10.Thmtheorem5.p9" class="ltx_para">
<table id="A10.E108" class="ltx_equationgroup ltx_eqn_table">
<tbody>
<tr id="A10.E108X" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A10.E108X.m2" class="ltx_Math" alttext="\displaystyle\frac{d}{dt}r_{t}=" display="inline" intent=":literal"><semantics><mrow><mrow><mstyle displaystyle="true"><mfrac><mi>d</mi><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msub><mi>r</mi><mi>t</mi></msub></mrow><mo>=</mo><mphantom></mphantom></mrow><annotation encoding="application/x-tex">\displaystyle\frac{d}{dt}r_{t}=</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A10.E108X.m3" class="ltx_Math" alttext="\displaystyle\underbrace{\nabla P_{f}(\psi_{t}(w))[\partial_{t}\psi_{t}(w)]\partial_{w}\psi_{t}(w)v}_{c}+\underbrace{P_{f}(\psi_{t}(w))\partial_{t}\partial_{w}\psi_{t}(w)v}_{d}." display="inline" intent=":literal"><semantics><mrow><mrow><munder><munder accentunder="true"><mrow><mrow><mo rspace="0.167em">∇</mo><msub><mi>P</mi><mi>f</mi></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>ψ</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>w</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mrow><msub><mo lspace="0em">∂</mo><mi>t</mi></msub><mrow><msub><mi>ψ</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>w</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">]</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><msub><mo>∂</mo><mi>w</mi></msub><mrow><msub><mi>ψ</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>w</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>v</mi></mrow></mrow></mrow><mo stretchy="true">⏟</mo></munder><mi>c</mi></munder><mo>+</mo><munder><munder accentunder="true"><mrow><msub><mi>P</mi><mi>f</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>ψ</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>w</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><msub><mo>∂</mo><mi>t</mi></msub><mrow><msub><mo lspace="0em">∂</mo><mi>w</mi></msub><mrow><msub><mi>ψ</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>w</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>v</mi></mrow></mrow></mrow></mrow><mo stretchy="true">⏟</mo></munder><mi>d</mi></munder></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\underbrace{\nabla P_{f}(\psi_{t}(w))[\partial_{t}\psi_{t}(w)]\partial_{w}\psi_{t}(w)v}_{c}+\underbrace{P_{f}(\psi_{t}(w))\partial_{t}\partial_{w}\psi_{t}(w)v}_{d}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equationgroup ltx_align_right">(108)</span></td></tr></tbody>
</table>
<p id="A10.Thmtheorem5.p9.3" class="ltx_p"><span id="A10.Thmtheorem5.p9.3.1" class="ltx_text">For the term <math id="A10.Thmtheorem5.p9.m1" class="ltx_Math" alttext="c" display="inline" intent=":literal"><semantics><mi>c</mi><annotation encoding="application/x-tex">c</annotation></semantics></math>:</span></p>
<table id="A10.E109" class="ltx_equationgroup ltx_eqn_table">
<tbody>
<tr id="A10.E109X" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A10.E109X.m2" class="ltx_Math" alttext="\displaystyle\|c\|_{F(\psi_{t}(w))}=" display="inline" intent=":literal"><semantics><mrow><msub><mrow><mo stretchy="false">‖</mo><mi>c</mi><mo stretchy="false">‖</mo></mrow><mrow><mi>F</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>ψ</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>w</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></msub><mo>=</mo><mphantom></mphantom></mrow><annotation encoding="application/x-tex">\displaystyle\|c\|_{F(\psi_{t}(w))}=</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A10.E109X.m3" class="ltx_Math" alttext="\displaystyle\|\nabla P_{f}(\psi_{t}(w))[F_{s}^{{\dagger}}(\psi_{t}(w))\nabla f(\psi_{t}(w))]\partial_{w}\psi_{t}(w)v\|_{F(\psi_{t}(w))}" display="inline" intent=":literal"><semantics><mrow><mo rspace="0.167em">∥</mo><mo rspace="0.167em">∇</mo><mi>P</mi><msub><mrow></mrow><mi>f</mi></msub><mo stretchy="false">(</mo><mi>ψ</mi><msub><mrow></mrow><mi>t</mi></msub><mo stretchy="false">(</mo><mi>w</mi><mo stretchy="false">)</mo><mo stretchy="false">)</mo><mo stretchy="false">[</mo><mi>F</mi><msub><mrow></mrow><mi>s</mi></msub><msup><mrow></mrow><mo>†</mo></msup><mo stretchy="false">(</mo><mi>ψ</mi><msub><mrow></mrow><mi>t</mi></msub><mo stretchy="false">(</mo><mi>w</mi><mo stretchy="false">)</mo><mo rspace="0.167em" stretchy="false">)</mo><mo rspace="0.167em">∇</mo><mi>f</mi><mo stretchy="false">(</mo><mi>ψ</mi><msub><mrow></mrow><mi>t</mi></msub><mo stretchy="false">(</mo><mi>w</mi><mo stretchy="false">)</mo><mo stretchy="false">)</mo><mo stretchy="false">]</mo><mo lspace="0em">∂</mo><msub><mrow></mrow><mi>w</mi></msub><mi>ψ</mi><msub><mrow></mrow><mi>t</mi></msub><mo stretchy="false">(</mo><mi>w</mi><mo stretchy="false">)</mo><mi>v</mi><mo lspace="0em">∥</mo><msub><mrow></mrow><mrow><mi>F</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>ψ</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>w</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></msub></mrow><annotation encoding="application/x-tex">\displaystyle\|\nabla P_{f}(\psi_{t}(w))[F_{s}^{{\dagger}}(\psi_{t}(w))\nabla f(\psi_{t}(w))]\partial_{w}\psi_{t}(w)v\|_{F(\psi_{t}(w))}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="3" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equationgroup ltx_align_right">(109)</span></td></tr>
<tr id="A10.E109Xa" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A10.E109Xa.m2" class="ltx_Math" alttext="\displaystyle\overset{\eqref{nabla-Ps}}{\leq}" display="inline" intent=":literal"><semantics><mover accent="true"><mo>≤</mo><mrow><mtext mathsize="0.700em">(</mtext><mtext mathsize="0.700em"><a href="#A10.E75" title="Equation 75 ‣ Notations ‣ Appendix J Proof ‣ Accelerating LLM Pre-Training through Flat-Direction Dynamics Enhancement" class="ltx_ref" style="font-size:70%;"><span class="ltx_text ltx_ref_tag">75</span></a></mtext><mtext mathsize="0.700em">)</mtext></mrow></mover><annotation encoding="application/x-tex">\displaystyle\overset{\eqref{nabla-Ps}}{\leq}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A10.E109Xa.m3" class="ltx_Math" alttext="\displaystyle\frac{\delta}{\|F_{s}^{{\dagger}}(\psi_{0}(w))\nabla f(\psi_{0}(w))\|_{F(\psi_{0}(w))}}\|\partial_{w}\psi_{t}(w)v\|_{F(\psi_{t}(w))}\|F_{s}^{{\dagger}}(\psi_{t}(w))\nabla f(\psi_{t}(w))\|_{F(\psi_{t}(w))}" display="inline" intent=":literal"><semantics><mrow><mstyle displaystyle="true"><mfrac><mi>δ</mi><mrow><mo rspace="0.167em">∥</mo><mi>F</mi><msub><mrow></mrow><mi>s</mi></msub><msup><mrow></mrow><mo>†</mo></msup><mo stretchy="false">(</mo><mi>ψ</mi><msub><mrow></mrow><mn>0</mn></msub><mo stretchy="false">(</mo><mi>w</mi><mo stretchy="false">)</mo><mo rspace="0.167em" stretchy="false">)</mo><mo rspace="0.167em">∇</mo><mi>f</mi><mo stretchy="false">(</mo><mi>ψ</mi><msub><mrow></mrow><mn>0</mn></msub><mo stretchy="false">(</mo><mi>w</mi><mo stretchy="false">)</mo><mo stretchy="false">)</mo><mo lspace="0em">∥</mo><msub><mrow></mrow><mrow><mi>F</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>ψ</mi><mn>0</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>w</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></msub></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">∥</mo><mo>∂</mo><msub><mrow></mrow><mi>w</mi></msub><mi>ψ</mi><msub><mrow></mrow><mi>t</mi></msub><mo stretchy="false">(</mo><mi>w</mi><mo stretchy="false">)</mo><mi>v</mi><mo lspace="0em" rspace="0.0835em">∥</mo><msub><mrow></mrow><mrow><mi>F</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>ψ</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>w</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></msub><mo lspace="0.0835em" rspace="0.167em">∥</mo><mi>F</mi><msub><mrow></mrow><mi>s</mi></msub><msup><mrow></mrow><mo>†</mo></msup><mo stretchy="false">(</mo><mi>ψ</mi><msub><mrow></mrow><mi>t</mi></msub><mo stretchy="false">(</mo><mi>w</mi><mo stretchy="false">)</mo><mo rspace="0.167em" stretchy="false">)</mo><mo rspace="0.167em">∇</mo><mi>f</mi><mo stretchy="false">(</mo><mi>ψ</mi><msub><mrow></mrow><mi>t</mi></msub><mo stretchy="false">(</mo><mi>w</mi><mo stretchy="false">)</mo><mo stretchy="false">)</mo><mo lspace="0em">∥</mo><msub><mrow></mrow><mrow><mi>F</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>ψ</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>w</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></msub></mrow><annotation encoding="application/x-tex">\displaystyle\frac{\delta}{\|F_{s}^{{\dagger}}(\psi_{0}(w))\nabla f(\psi_{0}(w))\|_{F(\psi_{0}(w))}}\|\partial_{w}\psi_{t}(w)v\|_{F(\psi_{t}(w))}\|F_{s}^{{\dagger}}(\psi_{t}(w))\nabla f(\psi_{t}(w))\|_{F(\psi_{t}(w))}</annotation></semantics></math></td>
