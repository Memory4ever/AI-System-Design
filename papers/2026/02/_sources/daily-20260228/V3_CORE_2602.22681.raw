<tr id="A10.E109Xb" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A10.E109Xb.m2" class="ltx_Math" alttext="\displaystyle\overset{\eqref{exp-decay-proj-to-river}}{\leq}" display="inline" intent=":literal"><semantics><mover accent="true"><mo>≤</mo><mrow><mtext mathsize="0.700em">(</mtext><mtext mathsize="0.700em"><a href="#A10.Thmtheorem3" title="Lemma J.3. ‣ J.1 Landscape Analysis ‣ Appendix J Proof ‣ Accelerating LLM Pre-Training through Flat-Direction Dynamics Enhancement" class="ltx_ref" style="font-size:70%;"><span class="ltx_text ltx_ref_tag">J.3</span></a></mtext><mtext mathsize="0.700em">)</mtext></mrow></mover><annotation encoding="application/x-tex">\displaystyle\overset{\eqref{exp-decay-proj-to-river}}{\leq}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A10.E109Xb.m3" class="ltx_Math" alttext="\displaystyle\delta e^{-\gamma t}\|\partial_{w}\psi_{t}(w)v\|_{F(\psi_{t}(w))}." display="inline" intent=":literal"><semantics><mrow><mrow><mi>δ</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>e</mi><mrow><mo>−</mo><mrow><mi>γ</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">‖</mo><mrow><msub><mo lspace="0em">∂</mo><mi>w</mi></msub><mrow><msub><mi>ψ</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>w</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>v</mi></mrow></mrow><mo stretchy="false">‖</mo></mrow><mrow><mi>F</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>ψ</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>w</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></msub></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\delta e^{-\gamma t}\|\partial_{w}\psi_{t}(w)v\|_{F(\psi_{t}(w))}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A10.Thmtheorem5.p9.4" class="ltx_p"><span id="A10.Thmtheorem5.p9.4.1" class="ltx_text">where the first inequality also uses <math id="A10.Thmtheorem5.p9.m2" class="ltx_Math" alttext="\nabla P_{s}+\nabla P_{f}=\nabla I=0" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mo rspace="0.167em">∇</mo><msub><mi>P</mi><mi>s</mi></msub></mrow><mo>+</mo><mrow><mo rspace="0.167em">∇</mo><msub><mi>P</mi><mi>f</mi></msub></mrow></mrow><mo>=</mo><mrow><mo rspace="0.167em">∇</mo><mi>I</mi></mrow><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\nabla P_{s}+\nabla P_{f}=\nabla I=0</annotation></semantics></math>.</span></p>
</div>
<div id="A10.Thmtheorem5.p10" class="ltx_para">
<p id="A10.Thmtheorem5.p10.1" class="ltx_p"><span id="A10.Thmtheorem5.p10.1.1" class="ltx_text">Note that for any vector <math id="A10.Thmtheorem5.p10.m1" class="ltx_Math" alttext="p" display="inline" intent=":literal"><semantics><mi>p</mi><annotation encoding="application/x-tex">p</annotation></semantics></math>,</span></p>
</div>
<div id="A10.Thmtheorem5.p11" class="ltx_para">
