</table>
<p id="A10.Thmtheorem1.p2.3" class="ltx_p"><span id="A10.Thmtheorem1.p2.3.1" class="ltx_text">where the first inequality uses <math id="A10.Thmtheorem1.p2.m1" class="ltx_math_unparsed" alttext="\nabla(F^{-1})(w)[u]=-F^{-1}(w)\nabla F(w)[u]F^{-1}(w)" display="inline" intent=":literal"><semantics><mrow><mo>∇</mo><mrow><mo stretchy="false">(</mo><msup><mi>F</mi><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo stretchy="false">)</mo></mrow><mrow><mo stretchy="false">(</mo><mi>w</mi><mo stretchy="false">)</mo></mrow><mrow><mo stretchy="false">[</mo><mi>u</mi><mo stretchy="false">]</mo></mrow><mo rspace="0em">=</mo><mo lspace="0em">−</mo><msup><mi>F</mi><mrow><mo>−</mo><mn>1</mn></mrow></msup><mrow><mo stretchy="false">(</mo><mi>w</mi><mo rspace="0.167em" stretchy="false">)</mo></mrow><mo rspace="0.167em">∇</mo><mi>F</mi><mrow><mo stretchy="false">(</mo><mi>w</mi><mo stretchy="false">)</mo></mrow><mrow><mo stretchy="false">[</mo><mi>u</mi><mo stretchy="false">]</mo></mrow><msup><mi>F</mi><mrow><mo>−</mo><mn>1</mn></mrow></msup><mrow><mo stretchy="false">(</mo><mi>w</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\nabla(F^{-1})(w)[u]=-F^{-1}(w)\nabla F(w)[u]F^{-1}(w)</annotation></semantics></math>.</span></p>
</div>
<div id="A10.Thmtheorem1.p3" class="ltx_para">
