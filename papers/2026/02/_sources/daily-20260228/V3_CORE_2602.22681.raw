</div>
<div id="alg1.l3" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg1.l3.1" class="ltx_text" style="font-size:80%;">3:</span></span>
              
              
              Update momentum <math id="alg1.l3.m1" class="ltx_Math" alttext="m_{k}=(1-\alpha)m_{k-1}+\nabla f(w_{k})" display="inline" intent=":literal"><semantics><mrow><msub><mi>m</mi><mi>k</mi></msub><mo>=</mo><mrow><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>α</mi></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>m</mi><mrow><mi>k</mi><mo>−</mo><mn>1</mn></mrow></msub></mrow><mo>+</mo><mrow><mrow><mo rspace="0.167em">∇</mo><mi>f</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>w</mi><mi>k</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">m_{k}=(1-\alpha)m_{k-1}+\nabla f(w_{k})</annotation></semantics></math>.

</div>
<div id="alg1.l4" class="ltx_listingline">
