<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A10.Thmtheorem10.p9.2" class="ltx_p"><span id="A10.Thmtheorem10.p9.2.1" class="ltx_text">By (<a href="#A10.E102" title="Equation 102 ‣ Lemma J.5. ‣ J.1 Landscape Analysis ‣ Appendix J Proof ‣ Accelerating LLM Pre-Training through Flat-Direction Dynamics Enhancement" class="ltx_ref"><span class="ltx_text ltx_ref_tag">102</span></a>) we have <math id="A10.Thmtheorem10.p9.m1" class="ltx_Math" alttext="\|\nabla\Phi(w_{t})\|_{2}\leq\|\nabla\Phi(w_{t})-P_{f}(w_{t})\|_{2}+\|P_{f}(w_{t})\|_{2}\leq 1+\epsilon_{\Phi}\kappa_{F}" display="inline" intent=":literal"><semantics><mrow><msub><mrow><mo stretchy="false">‖</mo><mrow><mrow><mo rspace="0.167em">∇</mo><mi mathvariant="normal">Φ</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>w</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn></msub><mo>≤</mo><mrow><msub><mrow><mo stretchy="false">‖</mo><mrow><mrow><mrow><mo rspace="0.167em">∇</mo><mi mathvariant="normal">Φ</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>w</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msub><mi>P</mi><mi>f</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>w</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn></msub><mo>+</mo><msub><mrow><mo stretchy="false">‖</mo><mrow><msub><mi>P</mi><mi>f</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>w</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn></msub></mrow><mo>≤</mo><mrow><mn>1</mn><mo>+</mo><mrow><msub><mi>ϵ</mi><mi mathvariant="normal">Φ</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>κ</mi><mi>F</mi></msub></mrow></mrow></mrow><annotation encoding="application/x-tex">\|\nabla\Phi(w_{t})\|_{2}\leq\|\nabla\Phi(w_{t})-P_{f}(w_{t})\|_{2}+\|P_{f}(w_{t})\|_{2}\leq 1+\epsilon_{\Phi}\kappa_{F}</annotation></semantics></math>. Thus</span></p>
</div>
<div id="A10.Thmtheorem10.p10" class="ltx_para">
<table id="A10.E161" class="ltx_equationgroup ltx_eqn_table">
<tbody>
<tr id="A10.E161X" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A10.E161X.m2" class="ltx_Math" alttext="\displaystyle\|c\|_{2}\leq" display="inline" intent=":literal"><semantics><mrow><msub><mrow><mo stretchy="false">‖</mo><mi>c</mi><mo stretchy="false">‖</mo></mrow><mn>2</mn></msub><mo>≤</mo><mphantom></mphantom></mrow><annotation encoding="application/x-tex">\displaystyle\|c\|_{2}\leq</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A10.E161X.m3" class="ltx_Math" alttext="\displaystyle\chi(1+\epsilon_{\Phi}\kappa_{F})\|F_{f}^{\dagger}(w_{t})(m_{t}+\beta_{2}\nabla f(w_{t}))-F_{f}^{\dagger}(z_{t})(s_{t}+\beta_{2}\nabla f(z_{t}))\|_{2}" display="inline" intent=":literal"><semantics><mrow><mi>χ</mi><mo stretchy="false">(</mo><mn>1</mn><mo>+</mo><mi>ϵ</mi><msub><mrow></mrow><mi mathvariant="normal">Φ</mi></msub><mi>κ</mi><msub><mrow></mrow><mi>F</mi></msub><mo stretchy="false">)</mo><mo lspace="0em" rspace="0.167em">∥</mo><mi>F</mi><msub><mrow></mrow><mi>f</mi></msub><msup><mrow></mrow><mo>†</mo></msup><mo stretchy="false">(</mo><mi>w</mi><msub><mrow></mrow><mi>t</mi></msub><mo stretchy="false">)</mo><mo stretchy="false">(</mo><mi>m</mi><msub><mrow></mrow><mi>t</mi></msub><mo>+</mo><mi>β</mi><msub><mrow></mrow><mn>2</mn></msub><mo lspace="0.167em" rspace="0.167em">∇</mo><mi>f</mi><mo stretchy="false">(</mo><mi>w</mi><msub><mrow></mrow><mi>t</mi></msub><mo stretchy="false">)</mo><mo stretchy="false">)</mo><mo>−</mo><mi>F</mi><msub><mrow></mrow><mi>f</mi></msub><msup><mrow></mrow><mo>†</mo></msup><mo stretchy="false">(</mo><mi>z</mi><msub><mrow></mrow><mi>t</mi></msub><mo stretchy="false">)</mo><mo stretchy="false">(</mo><mi>s</mi><msub><mrow></mrow><mi>t</mi></msub><mo>+</mo><mi>β</mi><msub><mrow></mrow><mn>2</mn></msub><mo lspace="0.167em" rspace="0.167em">∇</mo><mi>f</mi><mo stretchy="false">(</mo><mi>z</mi><msub><mrow></mrow><mi>t</mi></msub><mo stretchy="false">)</mo><mo stretchy="false">)</mo><mo lspace="0em">∥</mo><msub><mrow></mrow><mn>2</mn></msub></mrow><annotation encoding="application/x-tex">\displaystyle\chi(1+\epsilon_{\Phi}\kappa_{F})\|F_{f}^{\dagger}(w_{t})(m_{t}+\beta_{2}\nabla f(w_{t}))-F_{f}^{\dagger}(z_{t})(s_{t}+\beta_{2}\nabla f(z_{t}))\|_{2}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="2" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equationgroup ltx_align_right">(161)</span></td></tr>
<tr id="A10.E161Xa" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A10.E161Xa.m2" class="ltx_Math" alttext="\displaystyle\overset{\eqref{f-Fm-Fs},\eqref{f-Fm-Fs-g}}{\leq}" display="inline" intent=":literal"><semantics><mover accent="true"><mo>≤</mo><mrow><mrow><mtext mathsize="0.700em">(</mtext><mtext mathsize="0.700em"><a href="#A10.E154" title="Equation 154 ‣ Proof. ‣ Lemma J.10. ‣ J.2 Dynamics Analysis ‣ Appendix J Proof ‣ Accelerating LLM Pre-Training through Flat-Direction Dynamics Enhancement" class="ltx_ref" style="font-size:70%;"><span class="ltx_text ltx_ref_tag">154</span></a></mtext><mtext mathsize="0.700em">)</mtext></mrow><mo mathsize="0.700em">,</mo><mrow><mtext mathsize="0.700em">(</mtext><mtext mathsize="0.700em"><a href="#A10.E155" title="Equation 155 ‣ Proof. ‣ Lemma J.10. ‣ J.2 Dynamics Analysis ‣ Appendix J Proof ‣ Accelerating LLM Pre-Training through Flat-Direction Dynamics Enhancement" class="ltx_ref" style="font-size:70%;"><span class="ltx_text ltx_ref_tag">155</span></a></mtext><mtext mathsize="0.700em">)</mtext></mrow></mrow></mover><annotation encoding="application/x-tex">\displaystyle\overset{\eqref{f-Fm-Fs},\eqref{f-Fm-Fs-g}}{\leq}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A10.E161Xa.m3" class="ltx_Math" alttext="\displaystyle\chi(1+\epsilon_{\Phi}\kappa_{F})\lambda_{F_{s}}^{-1}\|m_{t}-s_{t}\|_{2}+\chi(1+\epsilon_{\Phi}\kappa_{F})(\frac{\delta_{F_{s}}}{\alpha}\kappa_{F}^{\frac{1}{2}}\lambda_{F}^{-1}+\beta_{2}\lambda_{F}^{-1}L+\beta_{2}\delta_{F_{s}}\kappa_{F}^{\frac{1}{2}}\lambda_{F}^{-1})\|w_{t}-\Phi(w_{t})\|_{2}." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mrow><mi>χ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><mrow><msub><mi>ϵ</mi><mi mathvariant="normal">Φ</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>κ</mi><mi>F</mi></msub></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>λ</mi><msub><mi>F</mi><mi>s</mi></msub><mrow><mo>−</mo><mn>1</mn></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">‖</mo><mrow><msub><mi>m</mi><mi>t</mi></msub><mo>−</mo><msub><mi>s</mi><mi>t</mi></msub></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn></msub></mrow><mo>+</mo><mrow><mrow><mi>χ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><mrow><msub><mi>ϵ</mi><mi mathvariant="normal">Φ</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>κ</mi><mi>F</mi></msub></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mstyle displaystyle="true"><mfrac><msub><mi>δ</mi><msub><mi>F</mi><mi>s</mi></msub></msub><mi>α</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>κ</mi><mi>F</mi><mfrac><mn>1</mn><mn>2</mn></mfrac></msubsup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>λ</mi><mi>F</mi><mrow><mo>−</mo><mn>1</mn></mrow></msubsup></mrow><mo>+</mo><mrow><msub><mi>β</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>λ</mi><mi>F</mi><mrow><mo>−</mo><mn>1</mn></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>L</mi></mrow><mo>+</mo><mrow><msub><mi>β</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>δ</mi><msub><mi>F</mi><mi>s</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>κ</mi><mi>F</mi><mfrac><mn>1</mn><mn>2</mn></mfrac></msubsup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>λ</mi><mi>F</mi><mrow><mo>−</mo><mn>1</mn></mrow></msubsup></mrow></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">‖</mo><mrow><msub><mi>w</mi><mi>t</mi></msub><mo>−</mo><mrow><mi mathvariant="normal">Φ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>w</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn></msub></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\chi(1+\epsilon_{\Phi}\kappa_{F})\lambda_{F_{s}}^{-1}\|m_{t}-s_{t}\|_{2}+\chi(1+\epsilon_{\Phi}\kappa_{F})(\frac{\delta_{F_{s}}}{\alpha}\kappa_{F}^{\frac{1}{2}}\lambda_{F}^{-1}+\beta_{2}\lambda_{F}^{-1}L+\beta_{2}\delta_{F_{s}}\kappa_{F}^{\frac{1}{2}}\lambda_{F}^{-1})\|w_{t}-\Phi(w_{t})\|_{2}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="A10.Thmtheorem10.p11" class="ltx_para">
<p id="A10.Thmtheorem10.p11.1" class="ltx_p"><span id="A10.Thmtheorem10.p11.1.1" class="ltx_text">Combining (<a href="#A10.E158" title="Equation 158 ‣ Proof. ‣ Lemma J.10. ‣ J.2 Dynamics Analysis ‣ Appendix J Proof ‣ Accelerating LLM Pre-Training through Flat-Direction Dynamics Enhancement" class="ltx_ref"><span class="ltx_text ltx_ref_tag">158</span></a>), (<a href="#A10.E160" title="Equation 160 ‣ Proof. ‣ Lemma J.10. ‣ J.2 Dynamics Analysis ‣ Appendix J Proof ‣ Accelerating LLM Pre-Training through Flat-Direction Dynamics Enhancement" class="ltx_ref"><span class="ltx_text ltx_ref_tag">160</span></a>) and (<a href="#A10.E161" title="Equation 161 ‣ Proof. ‣ Lemma J.10. ‣ J.2 Dynamics Analysis ‣ Appendix J Proof ‣ Accelerating LLM Pre-Training through Flat-Direction Dynamics Enhancement" class="ltx_ref"><span class="ltx_text ltx_ref_tag">161</span></a>), we get</span></p>
<table id="A10.E162" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A10.E162.m1" class="ltx_math_unparsed" alttext="\|a+b+c\|_{2}=\mathcal{O}(\|m_{t}-s_{t}\|_{2}+\|w_{t}-\Phi(w_{t})\|_{2}+\varepsilon\|m_{t}\|_{F_{s}^{\dagger}(w_{t})}+\varepsilon\|F_{f}^{\dagger}(z_{t})(s_{t}+\beta_{2}\nabla f(z_{t}))\|_{2})" display="block" intent=":literal"><semantics><mrow><mo rspace="0.167em">∥</mo><mi>a</mi><mo>+</mo><mi>b</mi><mo>+</mo><mi>c</mi><msub><mo lspace="0em" rspace="0.0835em">∥</mo><mn>2</mn></msub><mo lspace="0.0835em">=</mo><mi class="ltx_font_mathcaligraphic">𝒪</mi><mrow><mo stretchy="false">(</mo><mo lspace="0em" rspace="0.167em">∥</mo><msub><mi>m</mi><mi>t</mi></msub><mo>−</mo><msub><mi>s</mi><mi>t</mi></msub><msub><mo lspace="0em" rspace="0em">∥</mo><mn>2</mn></msub><mo lspace="0em" rspace="0em">+</mo><mo lspace="0em" rspace="0.167em">∥</mo><msub><mi>w</mi><mi>t</mi></msub><mo>−</mo><mi mathvariant="normal">Φ</mi><mrow><mo stretchy="false">(</mo><msub><mi>w</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow><msub><mo lspace="0em" rspace="0em">∥</mo><mn>2</mn></msub><mo lspace="0em">+</mo><mi>ε</mi><mo lspace="0em" rspace="0.167em">∥</mo><msub><mi>m</mi><mi>t</mi></msub><msub><mo lspace="0em" rspace="0em">∥</mo><mrow><msubsup><mi>F</mi><mi>s</mi><mo>†</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>w</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow></msub><mo lspace="0em">+</mo><mi>ε</mi><mo lspace="0em" rspace="0.167em">∥</mo><msubsup><mi>F</mi><mi>f</mi><mo>†</mo></msubsup><mrow><mo stretchy="false">(</mo><msub><mi>z</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow><mrow><mo stretchy="false">(</mo><msub><mi>s</mi><mi>t</mi></msub><mo>+</mo><msub><mi>β</mi><mn>2</mn></msub><mo lspace="0.167em" rspace="0.167em">∇</mo><mi>f</mi><mrow><mo stretchy="false">(</mo><msub><mi>z</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow><mo stretchy="false">)</mo></mrow><msub><mo lspace="0em" rspace="0.167em">∥</mo><mn>2</mn></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\|a+b+c\|_{2}=\mathcal{O}(\|m_{t}-s_{t}\|_{2}+\|w_{t}-\Phi(w_{t})\|_{2}+\varepsilon\|m_{t}\|_{F_{s}^{\dagger}(w_{t})}+\varepsilon\|F_{f}^{\dagger}(z_{t})(s_{t}+\beta_{2}\nabla f(z_{t}))\|_{2})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(162)</span></td></tr></tbody>
</table>
<p id="A10.Thmtheorem10.p11.2" class="ltx_p"><span id="A10.Thmtheorem10.p11.2.1" class="ltx_text">Then using (<a href="#A10.E151" title="Equation 151 ‣ Proof. ‣ Lemma J.10. ‣ J.2 Dynamics Analysis ‣ Appendix J Proof ‣ Accelerating LLM Pre-Training through Flat-Direction Dynamics Enhancement" class="ltx_ref"><span class="ltx_text ltx_ref_tag">151</span></a>) gives the conclusion.
∎</span></p>
</div>
</div>
</div>
<div id="A10.Thmtheorem11" class="ltx_theorem ltx_theorem_lemma">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="A10.Thmtheorem11.2" class="ltx_text ltx_font_bold">Lemma J.11</span></span><span id="A10.Thmtheorem11.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="A10.Thmtheorem11.p1" class="ltx_para">
<p id="A10.Thmtheorem11.p1.1" class="ltx_p"><span id="A10.Thmtheorem11.p1.1.1" class="ltx_text ltx_font_italic">Suppose Assumptions <a href="#S7.Thmtheorem1" title="Assumption 7.1 (River Structure). ‣ 7 Theoretical Analysis to Training Dynamics ‣ Accelerating LLM Pre-Training through Flat-Direction Dynamics Enhancement" class="ltx_ref"><span class="ltx_text ltx_ref_tag">7.1</span></a> and <a href="#S7.Thmtheorem2" title="Assumption 7.2 (Regularity, Smoothness and Conservation). ‣ 7 Theoretical Analysis to Training Dynamics ‣ Accelerating LLM Pre-Training through Flat-Direction Dynamics Enhancement" class="ltx_ref"><span class="ltx_text ltx_ref_tag">7.2</span></a> hold.
Then there exist a constant <math id="A10.Thmtheorem11.p1.m1" class="ltx_Math" alttext="\varepsilon_{0}&gt;0" display="inline" intent=":literal"><semantics><mrow><msub><mi>ε</mi><mn>0</mn></msub><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\varepsilon_{0}&gt;0</annotation></semantics></math> depending on <math id="A10.Thmtheorem11.p1.m2" class="ltx_Math" alttext="f" display="inline" intent=":literal"><semantics><mi>f</mi><annotation encoding="application/x-tex">f</annotation></semantics></math> and <math id="A10.Thmtheorem11.p1.m3" class="ltx_Math" alttext="\alpha,\beta,\{\eta_{t}\}_{t},\chi,\beta_{2}" display="inline" intent=":literal"><semantics><mrow><mi>α</mi><mo>,</mo><mi>β</mi><mo>,</mo><msub><mrow><mo stretchy="false">{</mo><msub><mi>η</mi><mi>t</mi></msub><mo stretchy="false">}</mo></mrow><mi>t</mi></msub><mo>,</mo><mi>χ</mi><mo>,</mo><msub><mi>β</mi><mn>2</mn></msub></mrow><annotation encoding="application/x-tex">\alpha,\beta,\{\eta_{t}\}_{t},\chi,\beta_{2}</annotation></semantics></math> such that for any <math id="A10.Thmtheorem11.p1.m4" class="ltx_Math" alttext="\varepsilon&lt;\varepsilon_{0}" display="inline" intent=":literal"><semantics><mrow><mi>ε</mi><mo>&lt;</mo><msub><mi>ε</mi><mn>0</mn></msub></mrow><annotation encoding="application/x-tex">\varepsilon&lt;\varepsilon_{0}</annotation></semantics></math>, we have</span></p>
<table id="A10.E163" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A10.E163.m1" class="ltx_math_unparsed" alttext="\|\epsilon_{z,t}\|_{2}^{2}\lesssim e^{-\Pi_{t}}+\varepsilon\int_{0}^{t}\exp\left({\Pi_{\tau}-\Pi_{t}}\right)\left(\|\nabla f(z_{\tau})\|_{F_{f}^{\dagger}(z_{t})}^{2}+\|s_{\tau}\|_{F_{f}^{\dagger}(z_{t})}^{2}\right)d\tau+\varepsilon^{2}\|s_{t}+\beta_{2}\nabla f(z_{t})\|_{F_{f}^{\dagger}(z_{t})}^{2}." display="block" intent=":literal"><semantics><mrow><mo rspace="0.167em">∥</mo><msub><mi>ϵ</mi><mrow><mi>z</mi><mo>,</mo><mi>t</mi></mrow></msub><msubsup><mo lspace="0em" rspace="0.0835em">∥</mo><mn>2</mn><mn>2</mn></msubsup><mo lspace="0.0835em">≲</mo><msup><mi>e</mi><mrow><mo>−</mo><msub><mi mathvariant="normal">Π</mi><mi>t</mi></msub></mrow></msup><mo>+</mo><mi>ε</mi><msubsup><mo>∫</mo><mn>0</mn><mi>t</mi></msubsup><mi>exp</mi><mrow><mo>(</mo><msub><mi mathvariant="normal">Π</mi><mi>τ</mi></msub><mo>−</mo><msub><mi mathvariant="normal">Π</mi><mi>t</mi></msub><mo>)</mo></mrow><mrow><mo>(</mo><mo lspace="0em" rspace="0.167em">∥</mo><mo rspace="0.167em">∇</mo><mi>f</mi><mrow><mo stretchy="false">(</mo><msub><mi>z</mi><mi>τ</mi></msub><mo stretchy="false">)</mo></mrow><msubsup><mo lspace="0em" rspace="0em">∥</mo><mrow><msubsup><mi>F</mi><mi>f</mi><mo>†</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>z</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">+</mo><mo lspace="0em" rspace="0.167em">∥</mo><msub><mi>s</mi><mi>τ</mi></msub><msubsup><mo lspace="0em" rspace="0.167em">∥</mo><mrow><msubsup><mi>F</mi><mi>f</mi><mo>†</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>z</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mn>2</mn></msubsup><mo>)</mo></mrow><mi>d</mi><mi>τ</mi><mo>+</mo><msup><mi>ε</mi><mn>2</mn></msup><mo lspace="0em" rspace="0.167em">∥</mo><msub><mi>s</mi><mi>t</mi></msub><mo>+</mo><msub><mi>β</mi><mn>2</mn></msub><mo lspace="0.167em" rspace="0.167em">∇</mo><mi>f</mi><mrow><mo stretchy="false">(</mo><msub><mi>z</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow><msubsup><mo lspace="0em" rspace="0.0835em">∥</mo><mrow><msubsup><mi>F</mi><mi>f</mi><mo>†</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>z</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mn>2</mn></msubsup><mo lspace="0.0835em">.</mo></mrow><annotation encoding="application/x-tex">\|\epsilon_{z,t}\|_{2}^{2}\lesssim e^{-\Pi_{t}}+\varepsilon\int_{0}^{t}\exp\left({\Pi_{\tau}-\Pi_{t}}\right)\left(\|\nabla f(z_{\tau})\|_{F_{f}^{\dagger}(z_{t})}^{2}+\|s_{\tau}\|_{F_{f}^{\dagger}(z_{t})}^{2}\right)d\tau+\varepsilon^{2}\|s_{t}+\beta_{2}\nabla f(z_{t})\|_{F_{f}^{\dagger}(z_{t})}^{2}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(163)</span></td></tr></tbody>
</table>
</div>
<div id="A10.Thmtheorem11.4" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="A10.Thmtheorem11.p2" class="ltx_para">
<p id="A10.Thmtheorem11.p2.1" class="ltx_p"><span id="A10.Thmtheorem11.p2.1.1" class="ltx_text">Define <math id="A10.Thmtheorem11.p2.m1" class="ltx_Math" alttext="\Pi_{s}=\int_{0}^{s}\iota_{\tau}d\tau" display="inline" intent=":literal"><semantics><mrow><msub><mi mathvariant="normal">Π</mi><mi>s</mi></msub><mo rspace="0.111em">=</mo><mrow><msubsup><mo>∫</mo><mn>0</mn><mi>s</mi></msubsup><mrow><msub><mi>ι</mi><mi>τ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo rspace="0em">𝑑</mo><mi>τ</mi></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\Pi_{s}=\int_{0}^{s}\iota_{\tau}d\tau</annotation></semantics></math>, <math id="A10.Thmtheorem11.p2.m2" class="ltx_Math" alttext="D_{t}=\|w_{t}-\Phi(w_{t})\|_{2}+\eta_{t}^{1/2}\|m_{t}\|_{F_{s}^{\dagger}(w_{t})}" display="inline" intent=":literal"><semantics><mrow><msub><mi>D</mi><mi>t</mi></msub><mo>=</mo><mrow><msub><mrow><mo stretchy="false">‖</mo><mrow><msub><mi>w</mi><mi>t</mi></msub><mo>−</mo><mrow><mi mathvariant="normal">Φ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>w</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn></msub><mo>+</mo><mrow><msubsup><mi>η</mi><mi>t</mi><mrow><mn>1</mn><mo>/</mo><mn>2</mn></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">‖</mo><msub><mi>m</mi><mi>t</mi></msub><mo stretchy="false">‖</mo></mrow><mrow><msubsup><mi>F</mi><mi>s</mi><mo>†</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>w</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow></msub></mrow></mrow></mrow><annotation encoding="application/x-tex">D_{t}=\|w_{t}-\Phi(w_{t})\|_{2}+\eta_{t}^{1/2}\|m_{t}\|_{F_{s}^{\dagger}(w_{t})}</annotation></semantics></math> and <math id="A10.Thmtheorem11.p2.m3" class="ltx_Math" alttext="E_{t}=\|\nabla f(z_{t})\|_{F_{f}^{\dagger}(z_{t})}^{2}+\|s_{t}\|_{F_{f}^{\dagger}(z_{t})}^{2}" display="inline" intent=":literal"><semantics><mrow><msub><mi>E</mi><mi>t</mi></msub><mo>=</mo><mrow><msubsup><mrow><mo stretchy="false">‖</mo><mrow><mrow><mo rspace="0.167em">∇</mo><mi>f</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>z</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">‖</mo></mrow><mrow><msubsup><mi>F</mi><mi>f</mi><mo>†</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>z</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mn>2</mn></msubsup><mo>+</mo><msubsup><mrow><mo stretchy="false">‖</mo><msub><mi>s</mi><mi>t</mi></msub><mo stretchy="false">‖</mo></mrow><mrow><msubsup><mi>F</mi><mi>f</mi><mo>†</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>z</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mn>2</mn></msubsup></mrow></mrow><annotation encoding="application/x-tex">E_{t}=\|\nabla f(z_{t})\|_{F_{f}^{\dagger}(z_{t})}^{2}+\|s_{t}\|_{F_{f}^{\dagger}(z_{t})}^{2}</annotation></semantics></math> for notational brevity. By (<a href="#A10.E123" title="Equation 123 ‣ Lemma J.6. ‣ J.2 Dynamics Analysis ‣ Appendix J Proof ‣ Accelerating LLM Pre-Training through Flat-Direction Dynamics Enhancement" class="ltx_ref"><span class="ltx_text ltx_ref_tag">123</span></a>) we have</span></p>
</div>
<div id="A10.Thmtheorem11.p3" class="ltx_para">
<table id="A10.E164" class="ltx_equationgroup ltx_eqn_table">
<tbody>
<tr id="A10.E164X" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A10.E164X.m2" class="ltx_Math" alttext="\displaystyle D_{t}^{2}\lesssim" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>D</mi><mi>t</mi><mn>2</mn></msubsup><mo>≲</mo><mphantom></mphantom></mrow><annotation encoding="application/x-tex">\displaystyle D_{t}^{2}\lesssim</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A10.E164X.m3" class="ltx_Math" alttext="\displaystyle\exp\left(-\Pi_{t}\right)+\varepsilon\int_{0}^{t}\exp\left(\Pi_{s}-\Pi_{t}\right)(\|\nabla f(w_{s})-\nabla f(z_{s})\|_{F_{f}^{\dagger}(z_{t})}^{2}+\|m_{s}-z_{s}\|_{F_{f}^{\dagger}(z_{t})}^{2}+E_{s})ds" display="inline" intent=":literal"><semantics><mrow><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mo>−</mo><msub><mi mathvariant="normal">Π</mi><mi>t</mi></msub></mrow><mo>)</mo></mrow></mrow><mo>+</mo><mrow><mi>ε</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><msubsup><mo>∫</mo><mn>0</mn><mi>t</mi></msubsup></mstyle><mrow><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><msub><mi mathvariant="normal">Π</mi><mi>s</mi></msub><mo>−</mo><msub><mi mathvariant="normal">Π</mi><mi>t</mi></msub></mrow><mo>)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msubsup><mrow><mo stretchy="false">‖</mo><mrow><mrow><mrow><mo rspace="0.167em">∇</mo><mi>f</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>w</mi><mi>s</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mrow><mo rspace="0.167em">∇</mo><mi>f</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>z</mi><mi>s</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">‖</mo></mrow><mrow><msubsup><mi>F</mi><mi>f</mi><mo>†</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>z</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mn>2</mn></msubsup><mo>+</mo><msubsup><mrow><mo stretchy="false">‖</mo><mrow><msub><mi>m</mi><mi>s</mi></msub><mo>−</mo><msub><mi>z</mi><mi>s</mi></msub></mrow><mo stretchy="false">‖</mo></mrow><mrow><msubsup><mi>F</mi><mi>f</mi><mo>†</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>z</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mn>2</mn></msubsup><mo>+</mo><msub><mi>E</mi><mi>s</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo rspace="0em">𝑑</mo><mi>s</mi></mrow></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\exp\left(-\Pi_{t}\right)+\varepsilon\int_{0}^{t}\exp\left(\Pi_{s}-\Pi_{t}\right)(\|\nabla f(w_{s})-\nabla f(z_{s})\|_{F_{f}^{\dagger}(z_{t})}^{2}+\|m_{s}-z_{s}\|_{F_{f}^{\dagger}(z_{t})}^{2}+E_{s})ds</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="3" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equationgroup ltx_align_right">(164)</span></td></tr>
<tr id="A10.E164Xa" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A10.E164Xa.m2" class="ltx_Math" alttext="\displaystyle\overset{\eqref{st-mt-bound}}{\lesssim}" display="inline" intent=":literal"><semantics><mover accent="true"><mo>≲</mo><mrow><mtext mathsize="0.700em">(</mtext><mtext mathsize="0.700em"><a href="#A10.E151" title="Equation 151 ‣ Proof. ‣ Lemma J.10. ‣ J.2 Dynamics Analysis ‣ Appendix J Proof ‣ Accelerating LLM Pre-Training through Flat-Direction Dynamics Enhancement" class="ltx_ref" style="font-size:70%;"><span class="ltx_text ltx_ref_tag">151</span></a></mtext><mtext mathsize="0.700em">)</mtext></mrow></mover><annotation encoding="application/x-tex">\displaystyle\overset{\eqref{st-mt-bound}}{\lesssim}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A10.E164Xa.m3" class="ltx_Math" alttext="\displaystyle\exp\left(-\Pi_{t}\right)+\varepsilon\int_{0}^{t}\exp\left(\Pi_{s}-\Pi_{t}\right)(D_{s}^{2}+\int_{0}^{s}e^{-\alpha(s-\tau)}D_{\tau}^{2}d\tau+E_{s})ds" display="inline" intent=":literal"><semantics><mrow><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mo>−</mo><msub><mi mathvariant="normal">Π</mi><mi>t</mi></msub></mrow><mo>)</mo></mrow></mrow><mo>+</mo><mrow><mi>ε</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><msubsup><mo>∫</mo><mn>0</mn><mi>t</mi></msubsup></mstyle><mrow><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><msub><mi mathvariant="normal">Π</mi><mi>s</mi></msub><mo>−</mo><msub><mi mathvariant="normal">Π</mi><mi>t</mi></msub></mrow><mo>)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msubsup><mi>D</mi><mi>s</mi><mn>2</mn></msubsup><mo>+</mo><mrow><mstyle displaystyle="true"><msubsup><mo>∫</mo><mn>0</mn><mi>s</mi></msubsup></mstyle><mrow><msup><mi>e</mi><mrow><mo>−</mo><mrow><mi>α</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>s</mi><mo>−</mo><mi>τ</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>D</mi><mi>τ</mi><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo rspace="0em">𝑑</mo><mi>τ</mi></mrow></mrow></mrow><mo>+</mo><msub><mi>E</mi><mi>s</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo rspace="0em">𝑑</mo><mi>s</mi></mrow></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\exp\left(-\Pi_{t}\right)+\varepsilon\int_{0}^{t}\exp\left(\Pi_{s}-\Pi_{t}\right)(D_{s}^{2}+\int_{0}^{s}e^{-\alpha(s-\tau)}D_{\tau}^{2}d\tau+E_{s})ds</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr>
<tr id="A10.E164Xb" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A10.E164Xb.m2" class="ltx_Math" alttext="\displaystyle\leq" display="inline" intent=":literal"><semantics><mo>≤</mo><annotation encoding="application/x-tex">\displaystyle\leq</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A10.E164Xb.m3" class="ltx_Math" alttext="\displaystyle\exp\left(-\Pi_{t}\right)+\varepsilon\int_{0}^{t}\exp\left(\Pi_{s}-\Pi_{t}\right)(D_{s}^{2}+E_{s})ds," display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mo>−</mo><msub><mi mathvariant="normal">Π</mi><mi>t</mi></msub></mrow><mo>)</mo></mrow></mrow><mo>+</mo><mrow><mi>ε</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><msubsup><mo>∫</mo><mn>0</mn><mi>t</mi></msubsup></mstyle><mrow><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><msub><mi mathvariant="normal">Π</mi><mi>s</mi></msub><mo>−</mo><msub><mi mathvariant="normal">Π</mi><mi>t</mi></msub></mrow><mo>)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msubsup><mi>D</mi><mi>s</mi><mn>2</mn></msubsup><mo>+</mo><msub><mi>E</mi><mi>s</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo rspace="0em">d</mo><mi>s</mi></mrow></mrow></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\exp\left(-\Pi_{t}\right)+\varepsilon\int_{0}^{t}\exp\left(\Pi_{s}-\Pi_{t}\right)(D_{s}^{2}+E_{s})ds,</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="A10.Thmtheorem11.p4" class="ltx_para">
<p id="A10.Thmtheorem11.p4.1" class="ltx_p"><span id="A10.Thmtheorem11.p4.1.1" class="ltx_text">where we also use <math id="A10.Thmtheorem11.p4.m1" class="ltx_Math" alttext="(\int_{0}^{s}e^{-\alpha(s-\tau)}D_{\tau}d\tau)^{2}\leq\int_{0}^{s}e^{-\alpha(s-\tau)}D_{\tau}^{2}d\tau\int_{0}^{s}e^{-\alpha(s-\tau)}d\tau\lesssim\int_{0}^{s}e^{-\alpha(s-\tau)}D_{\tau}^{2}d\tau" display="inline" intent=":literal"><semantics><mrow><msup><mrow><mo stretchy="false">(</mo><mrow><msubsup><mo lspace="0em">∫</mo><mn>0</mn><mi>s</mi></msubsup><mrow><msup><mi>e</mi><mrow><mo>−</mo><mrow><mi>α</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>s</mi><mo>−</mo><mi>τ</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>D</mi><mi>τ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo rspace="0em">𝑑</mo><mi>τ</mi></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup><mo rspace="0.111em">≤</mo><mrow><msubsup><mo>∫</mo><mn>0</mn><mi>s</mi></msubsup><mrow><msup><mi>e</mi><mrow><mo>−</mo><mrow><mi>α</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>s</mi><mo>−</mo><mi>τ</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>D</mi><mi>τ</mi><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo rspace="0em">𝑑</mo><mi>τ</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><msubsup><mo>∫</mo><mn>0</mn><mi>s</mi></msubsup><mrow><msup><mi>e</mi><mrow><mo>−</mo><mrow><mi>α</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>s</mi><mo>−</mo><mi>τ</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo rspace="0em">𝑑</mo><mi>τ</mi></mrow></mrow></mrow></mrow></mrow><mo rspace="0.111em">≲</mo><mrow><msubsup><mo>∫</mo><mn>0</mn><mi>s</mi></msubsup><mrow><msup><mi>e</mi><mrow><mo>−</mo><mrow><mi>α</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>s</mi><mo>−</mo><mi>τ</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>D</mi><mi>τ</mi><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo rspace="0em">𝑑</mo><mi>τ</mi></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">(\int_{0}^{s}e^{-\alpha(s-\tau)}D_{\tau}d\tau)^{2}\leq\int_{0}^{s}e^{-\alpha(s-\tau)}D_{\tau}^{2}d\tau\int_{0}^{s}e^{-\alpha(s-\tau)}d\tau\lesssim\int_{0}^{s}e^{-\alpha(s-\tau)}D_{\tau}^{2}d\tau</annotation></semantics></math> in the second inequality, and</span></p>
<table id="A10.E165" class="ltx_equationgroup ltx_eqn_table">
<tbody>
<tr id="A10.E165X" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A10.E165X.m2" class="ltx_Math" alttext="\displaystyle\int_{0}^{t}\exp\left(\Pi_{s}-\Pi_{t}\right)\int_{0}^{s}e^{-\alpha(s-\tau)}D_{\tau}^{2}d\tau ds=" display="inline" intent=":literal"><semantics><mrow><mrow><mstyle displaystyle="true"><msubsup><mo>∫</mo><mn>0</mn><mi>t</mi></msubsup></mstyle><mrow><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><msub><mi mathvariant="normal">Π</mi><mi>s</mi></msub><mo>−</mo><msub><mi mathvariant="normal">Π</mi><mi>t</mi></msub></mrow><mo>)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><msubsup><mo>∫</mo><mn>0</mn><mi>s</mi></msubsup></mstyle><mrow><msup><mi>e</mi><mrow><mo>−</mo><mrow><mi>α</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>s</mi><mo>−</mo><mi>τ</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>D</mi><mi>τ</mi><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo rspace="0em">d</mo><mi>τ</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo rspace="0em">d</mo><mi>s</mi></mrow></mrow></mrow></mrow></mrow><mo>=</mo><mphantom></mphantom></mrow><annotation encoding="application/x-tex">\displaystyle\int_{0}^{t}\exp\left(\Pi_{s}-\Pi_{t}\right)\int_{0}^{s}e^{-\alpha(s-\tau)}D_{\tau}^{2}d\tau ds=</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A10.E165X.m3" class="ltx_Math" alttext="\displaystyle\int_{0}^{t}\exp\left(\Pi_{\tau}-\Pi_{t}\right)D_{\tau}^{2}d\tau\int_{\tau}^{t}e^{\alpha\tau-\alpha s}\exp\underbrace{\left(\Pi_{s}-\Pi_{\tau}\right)}_{\leq(s-\tau)\iota_{\tau}}ds" display="inline" intent=":literal"><semantics><mrow><mstyle displaystyle="true"><msubsup><mo>∫</mo><mn>0</mn><mi>t</mi></msubsup></mstyle><mrow><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><msub><mi mathvariant="normal">Π</mi><mi>τ</mi></msub><mo>−</mo><msub><mi mathvariant="normal">Π</mi><mi>t</mi></msub></mrow><mo>)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>D</mi><mi>τ</mi><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo rspace="0em">𝑑</mo><mi>τ</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><msubsup><mo>∫</mo><mi>τ</mi><mi>t</mi></msubsup></mstyle><mrow><msup><mi>e</mi><mrow><mrow><mi>α</mi><mo lspace="0em" rspace="0em">​</mo><mi>τ</mi></mrow><mo>−</mo><mrow><mi>α</mi><mo lspace="0em" rspace="0em">​</mo><mi>s</mi></mrow></mrow></msup><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>exp</mi><mo>⁡</mo><munder><munder accentunder="true"><mrow><mo>(</mo><mrow><msub><mi mathvariant="normal">Π</mi><mi>s</mi></msub><mo>−</mo><msub><mi mathvariant="normal">Π</mi><mi>τ</mi></msub></mrow><mo>)</mo></mrow><mo stretchy="true">⏟</mo></munder><mrow><mphantom></mphantom><mo>≤</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>s</mi><mo>−</mo><mi>τ</mi></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>ι</mi><mi>τ</mi></msub></mrow></mrow></munder></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo rspace="0em">𝑑</mo><mi>s</mi></mrow></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\int_{0}^{t}\exp\left(\Pi_{\tau}-\Pi_{t}\right)D_{\tau}^{2}d\tau\int_{\tau}^{t}e^{\alpha\tau-\alpha s}\exp\underbrace{\left(\Pi_{s}-\Pi_{\tau}\right)}_{\leq(s-\tau)\iota_{\tau}}ds</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="2" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equationgroup ltx_align_right">(165)</span></td></tr>
<tr id="A10.E165Xa" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A10.E165Xa.m2" class="ltx_Math" alttext="\displaystyle\leq" display="inline" intent=":literal"><semantics><mo>≤</mo><annotation encoding="application/x-tex">\displaystyle\leq</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A10.E165Xa.m3" class="ltx_Math" alttext="\displaystyle\frac{1}{\alpha-\eta_{t}}\int_{0}^{t}\exp\left(\Pi_{\tau}-\Pi_{t}\right)D_{\tau}^{2}d\tau." display="inline" intent=":literal"><semantics><mrow><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mrow><mi>α</mi><mo>−</mo><msub><mi>η</mi><mi>t</mi></msub></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><msubsup><mo>∫</mo><mn>0</mn><mi>t</mi></msubsup></mstyle><mrow><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><msub><mi mathvariant="normal">Π</mi><mi>τ</mi></msub><mo>−</mo><msub><mi mathvariant="normal">Π</mi><mi>t</mi></msub></mrow><mo>)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>D</mi><mi>τ</mi><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo rspace="0em">d</mo><mi>τ</mi></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\frac{1}{\alpha-\eta_{t}}\int_{0}^{t}\exp\left(\Pi_{\tau}-\Pi_{t}\right)D_{\tau}^{2}d\tau.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A10.Thmtheorem11.p4.2" class="ltx_p"><span id="A10.Thmtheorem11.p4.2.1" class="ltx_text">in the third inequality. Then by using Gronwall’s inequality in Lemma <a href="#A10.Thmtheorem16" title="Lemma J.16 (Gronwall’s Inequality). ‣ Lemma J.14. ‣ J.3 Useful Lemmas ‣ Appendix J Proof ‣ Accelerating LLM Pre-Training through Flat-Direction Dynamics Enhancement" class="ltx_ref"><span class="ltx_text ltx_ref_tag">J.16</span></a> to <math id="A10.Thmtheorem11.p4.m2" class="ltx_Math" alttext="e^{\Pi_{t}}D_{t}^{2}" display="inline" intent=":literal"><semantics><mrow><msup><mi>e</mi><msub><mi mathvariant="normal">Π</mi><mi>t</mi></msub></msup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>D</mi><mi>t</mi><mn>2</mn></msubsup></mrow><annotation encoding="application/x-tex">e^{\Pi_{t}}D_{t}^{2}</annotation></semantics></math>, we get</span></p>
</div>
<div id="A10.Thmtheorem11.p5" class="ltx_para">
<table id="A10.E166" class="ltx_equationgroup ltx_eqn_table">
<tbody>
<tr id="A10.E166X" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A10.E166X.m2" class="ltx_Math" alttext="\displaystyle\exp\left(\Pi_{t}\right)D_{t}^{2}\lesssim" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo>(</mo><msub><mi mathvariant="normal">Π</mi><mi>t</mi></msub><mo>)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>D</mi><mi>t</mi><mn>2</mn></msubsup></mrow><mo>≲</mo><mphantom></mphantom></mrow><annotation encoding="application/x-tex">\displaystyle\exp\left(\Pi_{t}\right)D_{t}^{2}\lesssim</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A10.E166X.m3" class="ltx_Math" alttext="\displaystyle\exp(\mathcal{O}(\varepsilon t))\left(1+\varepsilon\int_{0}^{t}\exp\left(\Pi_{s}\right)E_{s}ds\right)." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒪</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>ε</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mn>1</mn><mo>+</mo><mrow><mi>ε</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><msubsup><mo>∫</mo><mn>0</mn><mi>t</mi></msubsup></mstyle><mrow><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo>(</mo><msub><mi mathvariant="normal">Π</mi><mi>s</mi></msub><mo>)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>E</mi><mi>s</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo rspace="0em">d</mo><mi>s</mi></mrow></mrow></mrow></mrow></mrow><mo>)</mo></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\exp(\mathcal{O}(\varepsilon t))\left(1+\varepsilon\int_{0}^{t}\exp\left(\Pi_{s}\right)E_{s}ds\right).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equationgroup ltx_align_right">(166)</span></td></tr></tbody>
</table>
</div>
<div id="A10.Thmtheorem11.p6" class="ltx_para">
<p id="A10.Thmtheorem11.p6.1" class="ltx_p"><span id="A10.Thmtheorem11.p6.1.1" class="ltx_text">Substituting it into (<a href="#A10.E151" title="Equation 151 ‣ Proof. ‣ Lemma J.10. ‣ J.2 Dynamics Analysis ‣ Appendix J Proof ‣ Accelerating LLM Pre-Training through Flat-Direction Dynamics Enhancement" class="ltx_ref"><span class="ltx_text ltx_ref_tag">151</span></a>) yields</span></p>
</div>
<div id="A10.Thmtheorem11.p7" class="ltx_para">
<table id="A10.E167" class="ltx_equationgroup ltx_eqn_table">
<tbody>
<tr id="A10.E167X" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A10.E167X.m2" class="ltx_Math" alttext="\displaystyle\left(\int_{0}^{t}e^{-\alpha(t-s)}\|w_{s}-\Phi(w_{s})\|_{2}ds\right)^{2}" display="inline" intent=":literal"><semantics><msup><mrow><mo>(</mo><mrow><mstyle displaystyle="true"><msubsup><mo>∫</mo><mn>0</mn><mi>t</mi></msubsup></mstyle><mrow><msup><mi>e</mi><mrow><mo>−</mo><mrow><mi>α</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>t</mi><mo>−</mo><mi>s</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">‖</mo><mrow><msub><mi>w</mi><mi>s</mi></msub><mo>−</mo><mrow><mi mathvariant="normal">Φ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>w</mi><mi>s</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo mathsize="0.700em" rspace="0em">d</mo><mi>s</mi></mrow></mrow></mrow><mo>)</mo></mrow><mn>2</mn></msup><annotation encoding="application/x-tex">\displaystyle\left(\int_{0}^{t}e^{-\alpha(t-s)}\|w_{s}-\Phi(w_{s})\|_{2}ds\right)^{2}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="3" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equationgroup ltx_align_right">(167)</span></td></tr>
<tr id="A10.E167Xa" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A10.E167Xa.m2" class="ltx_Math" alttext="\displaystyle\leq" display="inline" intent=":literal"><semantics><mo>≤</mo><annotation encoding="application/x-tex">\displaystyle\leq</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A10.E167Xa.m3" class="ltx_Math" alttext="\displaystyle\int_{0}^{t}e^{-\alpha(t-s)}ds\int_{0}^{t}e^{-\alpha(t-s)}\|w_{s}-\Phi(w_{s})\|_{2}^{2}ds" display="inline" intent=":literal"><semantics><mrow><mstyle displaystyle="true"><msubsup><mo>∫</mo><mn>0</mn><mi>t</mi></msubsup></mstyle><mrow><msup><mi>e</mi><mrow><mo>−</mo><mrow><mi>α</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>t</mi><mo>−</mo><mi>s</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo rspace="0em">𝑑</mo><mi>s</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><msubsup><mo>∫</mo><mn>0</mn><mi>t</mi></msubsup></mstyle><mrow><msup><mi>e</mi><mrow><mo>−</mo><mrow><mi>α</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>t</mi><mo>−</mo><mi>s</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msubsup><mrow><mo stretchy="false">‖</mo><mrow><msub><mi>w</mi><mi>s</mi></msub><mo>−</mo><mrow><mi mathvariant="normal">Φ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>w</mi><mi>s</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo rspace="0em">𝑑</mo><mi>s</mi></mrow></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\int_{0}^{t}e^{-\alpha(t-s)}ds\int_{0}^{t}e^{-\alpha(t-s)}\|w_{s}-\Phi(w_{s})\|_{2}^{2}ds</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr>
<tr id="A10.E167Xb" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A10.E167Xb.m2" class="ltx_Math" alttext="\displaystyle\lesssim" display="inline" intent=":literal"><semantics><mo>≲</mo><annotation encoding="application/x-tex">\displaystyle\lesssim</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A10.E167Xb.m3" class="ltx_Math" alttext="\displaystyle\int_{0}^{t}e^{-\alpha(t-s)}\exp\left(-\Pi_{s}\right)ds+\varepsilon\int_{0}^{t}e^{-\alpha(t-s)}ds\int_{0}^{s}\exp\left({\Pi_{\tau}-\Pi_{s}}\right)E_{\tau}d\tau." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mstyle displaystyle="true"><msubsup><mo>∫</mo><mn>0</mn><mi>t</mi></msubsup></mstyle><mrow><msup><mi>e</mi><mrow><mo>−</mo><mrow><mi>α</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>t</mi><mo>−</mo><mi>s</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></msup><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mo>−</mo><msub><mi mathvariant="normal">Π</mi><mi>s</mi></msub></mrow><mo>)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo rspace="0em">d</mo><mi>s</mi></mrow></mrow></mrow><mo>+</mo><mrow><mi>ε</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><msubsup><mo>∫</mo><mn>0</mn><mi>t</mi></msubsup></mstyle><mrow><msup><mi>e</mi><mrow><mo>−</mo><mrow><mi>α</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>t</mi><mo>−</mo><mi>s</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo rspace="0em">d</mo><mi>s</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><msubsup><mo>∫</mo><mn>0</mn><mi>s</mi></msubsup></mstyle><mrow><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><msub><mi mathvariant="normal">Π</mi><mi>τ</mi></msub><mo>−</mo><msub><mi mathvariant="normal">Π</mi><mi>s</mi></msub></mrow><mo>)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>E</mi><mi>τ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo rspace="0em">d</mo><mi>τ</mi></mrow></mrow></mrow></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\int_{0}^{t}e^{-\alpha(t-s)}\exp\left(-\Pi_{s}\right)ds+\varepsilon\int_{0}^{t}e^{-\alpha(t-s)}ds\int_{0}^{s}\exp\left({\Pi_{\tau}-\Pi_{s}}\right)E_{\tau}d\tau.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A10.Thmtheorem11.p7.2" class="ltx_p"><span id="A10.Thmtheorem11.p7.2.1" class="ltx_text">To bound the right hand side, we first note that for any fixed <math id="A10.Thmtheorem11.p7.m1" class="ltx_Math" alttext="0\leq\tau&lt;t" display="inline" intent=":literal"><semantics><mrow><mn>0</mn><mo>≤</mo><mi>τ</mi><mo>&lt;</mo><mi>t</mi></mrow><annotation encoding="application/x-tex">0\leq\tau&lt;t</annotation></semantics></math>, <math id="A10.Thmtheorem11.p7.m2" class="ltx_Math" alttext="\frac{\alpha}{2}\geq\frac{\Pi_{s}-\Pi_{\tau}}{s-\tau}\geq\frac{\Pi_{t}-\Pi_{\tau}}{t-\tau}:=\bar{\iota}" display="inline" intent=":literal"><semantics><mrow><mfrac><mi>α</mi><mn>2</mn></mfrac><mo>≥</mo><mfrac><mrow><msub><mi mathvariant="normal">Π</mi><mi>s</mi></msub><mo>−</mo><msub><mi mathvariant="normal">Π</mi><mi>τ</mi></msub></mrow><mrow><mi>s</mi><mo>−</mo><mi>τ</mi></mrow></mfrac><mo>≥</mo><mfrac><mrow><msub><mi mathvariant="normal">Π</mi><mi>t</mi></msub><mo>−</mo><msub><mi mathvariant="normal">Π</mi><mi>τ</mi></msub></mrow><mrow><mi>t</mi><mo>−</mo><mi>τ</mi></mrow></mfrac><mo>:=</mo><mover accent="true"><mi>ι</mi><mo>¯</mo></mover></mrow><annotation encoding="application/x-tex">\frac{\alpha}{2}\geq\frac{\Pi_{s}-\Pi_{\tau}}{s-\tau}\geq\frac{\Pi_{t}-\Pi_{\tau}}{t-\tau}:=\bar{\iota}</annotation></semantics></math> since <math id="A10.Thmtheorem11.p7.m3" class="ltx_Math" alttext="\iota_{t}" display="inline" intent=":literal"><semantics><msub><mi>ι</mi><mi>t</mi></msub><annotation encoding="application/x-tex">\iota_{t}</annotation></semantics></math> is non-decreasing. This gives</span></p>
<table id="A10.E168" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A10.E168.m1" class="ltx_Math" alttext="\int_{\tau}^{t}e^{-\alpha(t-s)}\exp\left({\Pi_{\tau}-\Pi_{s}}\right)ds\leq\int_{\tau}^{t}e^{-\alpha(t-s)}e^{-\bar{\iota}(s-\tau)}ds\leq\frac{1}{\alpha-\bar{\iota}}e^{-\bar{\iota}(t-\tau)}\leq\frac{2}{\alpha}e^{\Pi_{\tau}-\Pi_{t}}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><msubsup><mo>∫</mo><mi>τ</mi><mi>t</mi></msubsup><mrow><msup><mi>e</mi><mrow><mo>−</mo><mrow><mi>α</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>t</mi><mo>−</mo><mi>s</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></msup><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><msub><mi mathvariant="normal">Π</mi><mi>τ</mi></msub><mo>−</mo><msub><mi mathvariant="normal">Π</mi><mi>s</mi></msub></mrow><mo>)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo rspace="0em">𝑑</mo><mi>s</mi></mrow></mrow></mrow><mo rspace="0.111em">≤</mo><mrow><msubsup><mo>∫</mo><mi>τ</mi><mi>t</mi></msubsup><mrow><msup><mi>e</mi><mrow><mo>−</mo><mrow><mi>α</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>t</mi><mo>−</mo><mi>s</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>e</mi><mrow><mo>−</mo><mrow><mover accent="true"><mi>ι</mi><mo>¯</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>s</mi><mo>−</mo><mi>τ</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo rspace="0em">𝑑</mo><mi>s</mi></mrow></mrow></mrow><mo>≤</mo><mrow><mfrac><mn>1</mn><mrow><mi>α</mi><mo>−</mo><mover accent="true"><mi>ι</mi><mo>¯</mo></mover></mrow></mfrac><mo lspace="0em" rspace="0em">​</mo><msup><mi>e</mi><mrow><mo>−</mo><mrow><mover accent="true"><mi>ι</mi><mo>¯</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>t</mi><mo>−</mo><mi>τ</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></msup></mrow><mo>≤</mo><mrow><mfrac><mn>2</mn><mi>α</mi></mfrac><mo lspace="0em" rspace="0em">​</mo><msup><mi>e</mi><mrow><msub><mi mathvariant="normal">Π</mi><mi>τ</mi></msub><mo>−</mo><msub><mi mathvariant="normal">Π</mi><mi>t</mi></msub></mrow></msup></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\int_{\tau}^{t}e^{-\alpha(t-s)}\exp\left({\Pi_{\tau}-\Pi_{s}}\right)ds\leq\int_{\tau}^{t}e^{-\alpha(t-s)}e^{-\bar{\iota}(s-\tau)}ds\leq\frac{1}{\alpha-\bar{\iota}}e^{-\bar{\iota}(t-\tau)}\leq\frac{2}{\alpha}e^{\Pi_{\tau}-\Pi_{t}}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(168)</span></td></tr></tbody>
</table>
</div>
<div id="A10.Thmtheorem11.p8" class="ltx_para">
<p id="A10.Thmtheorem11.p8.2" class="ltx_p"><span id="A10.Thmtheorem11.p8.2.1" class="ltx_text">Thus for the first term in (<a href="#A10.E167" title="Equation 167 ‣ Proof. ‣ Lemma J.11. ‣ J.2 Dynamics Analysis ‣ Appendix J Proof ‣ Accelerating LLM Pre-Training through Flat-Direction Dynamics Enhancement" class="ltx_ref"><span class="ltx_text ltx_ref_tag">167</span></a>), we have</span></p>
<table id="A10.E169" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A10.E169.m1" class="ltx_Math" alttext="\int_{0}^{t}e^{-\alpha(t-s)}\exp\left(-\Pi_{s}\right)ds\leq\frac{2}{\alpha}e^{-\Pi_{t}}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><msubsup><mo>∫</mo><mn>0</mn><mi>t</mi></msubsup><mrow><msup><mi>e</mi><mrow><mo>−</mo><mrow><mi>α</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>t</mi><mo>−</mo><mi>s</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></msup><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mo>−</mo><msub><mi mathvariant="normal">Π</mi><mi>s</mi></msub></mrow><mo>)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo rspace="0em">𝑑</mo><mi>s</mi></mrow></mrow></mrow><mo>≤</mo><mrow><mfrac><mn>2</mn><mi>α</mi></mfrac><mo lspace="0em" rspace="0em">​</mo><msup><mi>e</mi><mrow><mo>−</mo><msub><mi mathvariant="normal">Π</mi><mi>t</mi></msub></mrow></msup></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\int_{0}^{t}e^{-\alpha(t-s)}\exp\left(-\Pi_{s}\right)ds\leq\frac{2}{\alpha}e^{-\Pi_{t}}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(169)</span></td></tr></tbody>
</table>
<p id="A10.Thmtheorem11.p8.3" class="ltx_p"><span id="A10.Thmtheorem11.p8.3.1" class="ltx_text">For the second term in (<a href="#A10.E167" title="Equation 167 ‣ Proof. ‣ Lemma J.11. ‣ J.2 Dynamics Analysis ‣ Appendix J Proof ‣ Accelerating LLM Pre-Training through Flat-Direction Dynamics Enhancement" class="ltx_ref"><span class="ltx_text ltx_ref_tag">167</span></a>),</span></p>
<table id="A10.E170" class="ltx_equationgroup ltx_eqn_table">
<tbody>
<tr id="A10.E170X" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A10.E170X.m2" class="ltx_Math" alttext="\displaystyle\int_{0}^{t}e^{-\alpha(t-s)}ds\int_{0}^{s}\exp\left({\Pi_{\tau}-\Pi_{s}}\right)E_{\tau}d\tau=" display="inline" intent=":literal"><semantics><mrow><mrow><mstyle displaystyle="true"><msubsup><mo>∫</mo><mn>0</mn><mi>t</mi></msubsup></mstyle><mrow><msup><mi>e</mi><mrow><mo>−</mo><mrow><mi>α</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>t</mi><mo>−</mo><mi>s</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo rspace="0em">d</mo><mi>s</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><msubsup><mo>∫</mo><mn>0</mn><mi>s</mi></msubsup></mstyle><mrow><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><msub><mi mathvariant="normal">Π</mi><mi>τ</mi></msub><mo>−</mo><msub><mi mathvariant="normal">Π</mi><mi>s</mi></msub></mrow><mo>)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>E</mi><mi>τ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo rspace="0em">d</mo><mi>τ</mi></mrow></mrow></mrow></mrow></mrow><mo>=</mo><mphantom></mphantom></mrow><annotation encoding="application/x-tex">\displaystyle\int_{0}^{t}e^{-\alpha(t-s)}ds\int_{0}^{s}\exp\left({\Pi_{\tau}-\Pi_{s}}\right)E_{\tau}d\tau=</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A10.E170X.m3" class="ltx_Math" alttext="\displaystyle\int_{0}^{t}E_{\tau}d\tau\int_{\tau}^{t}e^{-\alpha(t-s)}\exp\left({\Pi_{\tau}-\Pi_{s}}\right)ds" display="inline" intent=":literal"><semantics><mrow><mstyle displaystyle="true"><msubsup><mo>∫</mo><mn>0</mn><mi>t</mi></msubsup></mstyle><mrow><msub><mi>E</mi><mi>τ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo rspace="0em">𝑑</mo><mi>τ</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><msubsup><mo>∫</mo><mi>τ</mi><mi>t</mi></msubsup></mstyle><mrow><msup><mi>e</mi><mrow><mo>−</mo><mrow><mi>α</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>t</mi><mo>−</mo><mi>s</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></msup><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><msub><mi mathvariant="normal">Π</mi><mi>τ</mi></msub><mo>−</mo><msub><mi mathvariant="normal">Π</mi><mi>s</mi></msub></mrow><mo>)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo rspace="0em">𝑑</mo><mi>s</mi></mrow></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\int_{0}^{t}E_{\tau}d\tau\int_{\tau}^{t}e^{-\alpha(t-s)}\exp\left({\Pi_{\tau}-\Pi_{s}}\right)ds</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="2" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equationgroup ltx_align_right">(170)</span></td></tr>
<tr id="A10.E170Xa" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A10.E170Xa.m2" class="ltx_Math" alttext="\displaystyle\overset{\eqref{t-s-pi-tau-pi-s}}{\leq}" display="inline" intent=":literal"><semantics><mover accent="true"><mo>≤</mo><mrow><mtext mathsize="0.700em">(</mtext><mtext mathsize="0.700em"><a href="#A10.E168" title="Equation 168 ‣ Proof. ‣ Lemma J.11. ‣ J.2 Dynamics Analysis ‣ Appendix J Proof ‣ Accelerating LLM Pre-Training through Flat-Direction Dynamics Enhancement" class="ltx_ref" style="font-size:70%;"><span class="ltx_text ltx_ref_tag">168</span></a></mtext><mtext mathsize="0.700em">)</mtext></mrow></mover><annotation encoding="application/x-tex">\displaystyle\overset{\eqref{t-s-pi-tau-pi-s}}{\leq}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A10.E170Xa.m3" class="ltx_Math" alttext="\displaystyle\frac{2}{\alpha}\int_{0}^{t}\exp\left({\Pi_{\tau}-\Pi_{t}}\right)E_{\tau}d\tau." display="inline" intent=":literal"><semantics><mrow><mrow><mstyle displaystyle="true"><mfrac><mn>2</mn><mi>α</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><msubsup><mo>∫</mo><mn>0</mn><mi>t</mi></msubsup></mstyle><mrow><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><msub><mi mathvariant="normal">Π</mi><mi>τ</mi></msub><mo>−</mo><msub><mi mathvariant="normal">Π</mi><mi>t</mi></msub></mrow><mo>)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>E</mi><mi>τ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo rspace="0em">d</mo><mi>τ</mi></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\frac{2}{\alpha}\int_{0}^{t}\exp\left({\Pi_{\tau}-\Pi_{t}}\right)E_{\tau}d\tau.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="A10.Thmtheorem11.p9" class="ltx_para">
<p id="A10.Thmtheorem11.p9.1" class="ltx_p"><span id="A10.Thmtheorem11.p9.1.1" class="ltx_text">Substituting (<a href="#A10.E169" title="Equation 169 ‣ Proof. ‣ Lemma J.11. ‣ J.2 Dynamics Analysis ‣ Appendix J Proof ‣ Accelerating LLM Pre-Training through Flat-Direction Dynamics Enhancement" class="ltx_ref"><span class="ltx_text ltx_ref_tag">169</span></a>) and (<a href="#A10.E170" title="Equation 170 ‣ Proof. ‣ Lemma J.11. ‣ J.2 Dynamics Analysis ‣ Appendix J Proof ‣ Accelerating LLM Pre-Training through Flat-Direction Dynamics Enhancement" class="ltx_ref"><span class="ltx_text ltx_ref_tag">170</span></a>) into (<a href="#A10.E167" title="Equation 167 ‣ Proof. ‣ Lemma J.11. ‣ J.2 Dynamics Analysis ‣ Appendix J Proof ‣ Accelerating LLM Pre-Training through Flat-Direction Dynamics Enhancement" class="ltx_ref"><span class="ltx_text ltx_ref_tag">167</span></a>), we get</span></p>
<table id="A10.E171" class="ltx_equationgroup ltx_eqn_table">
<tbody>
<tr id="A10.E171X" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A10.E171X.m2" class="ltx_Math" alttext="\displaystyle\left(\int_{0}^{t}e^{-\alpha(t-s)}\|w_{s}-\Phi(w_{s})\|_{2}ds\right)^{2}\lesssim e^{-\Pi_{t}}+\varepsilon\int_{0}^{t}\exp\left({\Pi_{\tau}-\Pi_{t}}\right)E_{\tau}d\tau." display="inline" intent=":literal"><semantics><mrow><mrow><msup><mrow><mo>(</mo><mrow><mstyle displaystyle="true"><msubsup><mo>∫</mo><mn>0</mn><mi>t</mi></msubsup></mstyle><mrow><msup><mi>e</mi><mrow><mo>−</mo><mrow><mi>α</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>t</mi><mo>−</mo><mi>s</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">‖</mo><mrow><msub><mi>w</mi><mi>s</mi></msub><mo>−</mo><mrow><mi mathvariant="normal">Φ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>w</mi><mi>s</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo rspace="0em">d</mo><mi>s</mi></mrow></mrow></mrow><mo>)</mo></mrow><mn>2</mn></msup><mo>≲</mo><mrow><msup><mi>e</mi><mrow><mo>−</mo><msub><mi mathvariant="normal">Π</mi><mi>t</mi></msub></mrow></msup><mo>+</mo><mrow><mi>ε</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><msubsup><mo>∫</mo><mn>0</mn><mi>t</mi></msubsup></mstyle><mrow><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><msub><mi mathvariant="normal">Π</mi><mi>τ</mi></msub><mo>−</mo><msub><mi mathvariant="normal">Π</mi><mi>t</mi></msub></mrow><mo>)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>E</mi><mi>τ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo rspace="0em">d</mo><mi>τ</mi></mrow></mrow></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\left(\int_{0}^{t}e^{-\alpha(t-s)}\|w_{s}-\Phi(w_{s})\|_{2}ds\right)^{2}\lesssim e^{-\Pi_{t}}+\varepsilon\int_{0}^{t}\exp\left({\Pi_{\tau}-\Pi_{t}}\right)E_{\tau}d\tau.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equationgroup ltx_align_right">(171)</span></td></tr></tbody>
</table>
</div>
<div id="A10.Thmtheorem11.p10" class="ltx_para">
<p id="A10.Thmtheorem11.p10.1" class="ltx_p"><span id="A10.Thmtheorem11.p10.1.1" class="ltx_text">Substituting it and (<a href="#A10.E166" title="Equation 166 ‣ Proof. ‣ Lemma J.11. ‣ J.2 Dynamics Analysis ‣ Appendix J Proof ‣ Accelerating LLM Pre-Training through Flat-Direction Dynamics Enhancement" class="ltx_ref"><span class="ltx_text ltx_ref_tag">166</span></a>) into
(<a href="#A10.E149" title="Equation 149 ‣ Lemma J.10. ‣ J.2 Dynamics Analysis ‣ Appendix J Proof ‣ Accelerating LLM Pre-Training through Flat-Direction Dynamics Enhancement" class="ltx_ref"><span class="ltx_text ltx_ref_tag">149</span></a>) gives</span></p>
<table id="A10.E172" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A10.E172.m1" class="ltx_math_unparsed" alttext="\|\epsilon_{z,t}\|_{2}^{2}\lesssim e^{-\Pi_{t}}+\varepsilon\int_{0}^{t}\exp\left({\Pi_{\tau}-\Pi_{t}}\right)\left(\|\nabla f(z_{\tau})\|_{F_{f}^{\dagger}(z_{t})}^{2}+\|s_{\tau}\|_{F_{f}^{\dagger}(z_{t})}^{2}\right)d\tau+\varepsilon^{2}\|s_{t}+\beta_{2}\nabla f(z_{t})\|_{F_{f}^{\dagger}(z_{t})}^{2}." display="block" intent=":literal"><semantics><mrow><mo rspace="0.167em">∥</mo><msub><mi>ϵ</mi><mrow><mi>z</mi><mo>,</mo><mi>t</mi></mrow></msub><msubsup><mo lspace="0em" rspace="0.0835em">∥</mo><mn>2</mn><mn>2</mn></msubsup><mo lspace="0.0835em">≲</mo><msup><mi>e</mi><mrow><mo>−</mo><msub><mi mathvariant="normal">Π</mi><mi>t</mi></msub></mrow></msup><mo>+</mo><mi>ε</mi><msubsup><mo>∫</mo><mn>0</mn><mi>t</mi></msubsup><mi>exp</mi><mrow><mo>(</mo><msub><mi mathvariant="normal">Π</mi><mi>τ</mi></msub><mo>−</mo><msub><mi mathvariant="normal">Π</mi><mi>t</mi></msub><mo>)</mo></mrow><mrow><mo>(</mo><mo lspace="0em" rspace="0.167em">∥</mo><mo rspace="0.167em">∇</mo><mi>f</mi><mrow><mo stretchy="false">(</mo><msub><mi>z</mi><mi>τ</mi></msub><mo stretchy="false">)</mo></mrow><msubsup><mo lspace="0em" rspace="0em">∥</mo><mrow><msubsup><mi>F</mi><mi>f</mi><mo>†</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>z</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">+</mo><mo lspace="0em" rspace="0.167em">∥</mo><msub><mi>s</mi><mi>τ</mi></msub><msubsup><mo lspace="0em" rspace="0.167em">∥</mo><mrow><msubsup><mi>F</mi><mi>f</mi><mo>†</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>z</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mn>2</mn></msubsup><mo>)</mo></mrow><mi>d</mi><mi>τ</mi><mo>+</mo><msup><mi>ε</mi><mn>2</mn></msup><mo lspace="0em" rspace="0.167em">∥</mo><msub><mi>s</mi><mi>t</mi></msub><mo>+</mo><msub><mi>β</mi><mn>2</mn></msub><mo lspace="0.167em" rspace="0.167em">∇</mo><mi>f</mi><mrow><mo stretchy="false">(</mo><msub><mi>z</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow><msubsup><mo lspace="0em" rspace="0.0835em">∥</mo><mrow><msubsup><mi>F</mi><mi>f</mi><mo>†</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>z</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mn>2</mn></msubsup><mo lspace="0.0835em">.</mo></mrow><annotation encoding="application/x-tex">\|\epsilon_{z,t}\|_{2}^{2}\lesssim e^{-\Pi_{t}}+\varepsilon\int_{0}^{t}\exp\left({\Pi_{\tau}-\Pi_{t}}\right)\left(\|\nabla f(z_{\tau})\|_{F_{f}^{\dagger}(z_{t})}^{2}+\|s_{\tau}\|_{F_{f}^{\dagger}(z_{t})}^{2}\right)d\tau+\varepsilon^{2}\|s_{t}+\beta_{2}\nabla f(z_{t})\|_{F_{f}^{\dagger}(z_{t})}^{2}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(172)</span></td></tr></tbody>
</table>
</div>
<div id="A10.Thmtheorem11.p11" class="ltx_para">
<p id="A10.Thmtheorem11.p11.1" class="ltx_p"><span id="A10.Thmtheorem11.p11.1.1" class="ltx_text">Note that a sufficiently small <math id="A10.Thmtheorem11.p11.m1" class="ltx_Math" alttext="\varepsilon" display="inline" intent=":literal"><semantics><mi>ε</mi><annotation encoding="application/x-tex">\varepsilon</annotation></semantics></math> can satisfy the constraints on <math id="A10.Thmtheorem11.p11.m2" class="ltx_Math" alttext="\delta,\delta_{F}" display="inline" intent=":literal"><semantics><mrow><mi>δ</mi><mo>,</mo><msub><mi>δ</mi><mi>F</mi></msub></mrow><annotation encoding="application/x-tex">\delta,\delta_{F}</annotation></semantics></math> in all preceding lemmas. Then, by applying Lemma <a href="#A10.Thmtheorem8" title="Lemma J.8. ‣ J.2 Dynamics Analysis ‣ Appendix J Proof ‣ Accelerating LLM Pre-Training through Flat-Direction Dynamics Enhancement" class="ltx_ref"><span class="ltx_text ltx_ref_tag">J.8</span></a>, we get the conclusion.</span></p>
</div>
<div id="A10.Thmtheorem11.p12" class="ltx_para">
<p id="A10.Thmtheorem11.p12.1" class="ltx_p"><span id="A10.Thmtheorem11.p12.1.1" class="ltx_text">∎</span></p>
</div>
</div>
</div>
<div id="A10.Thmtheorem12" class="ltx_theorem ltx_theorem_lemma">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="A10.Thmtheorem12.2" class="ltx_text ltx_font_bold">Lemma J.12</span></span><span id="A10.Thmtheorem12.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="A10.Thmtheorem12.p1" class="ltx_para">
<p id="A10.Thmtheorem12.p1.1" class="ltx_p"><span id="A10.Thmtheorem12.p1.1.1" class="ltx_text ltx_font_italic">Suppose Assumptions <a href="#S7.Thmtheorem1" title="Assumption 7.1 (River Structure). ‣ 7 Theoretical Analysis to Training Dynamics ‣ Accelerating LLM Pre-Training through Flat-Direction Dynamics Enhancement" class="ltx_ref"><span class="ltx_text ltx_ref_tag">7.1</span></a> and <a href="#S7.Thmtheorem2" title="Assumption 7.2 (Regularity, Smoothness and Conservation). ‣ 7 Theoretical Analysis to Training Dynamics ‣ Accelerating LLM Pre-Training through Flat-Direction Dynamics Enhancement" class="ltx_ref"><span class="ltx_text ltx_ref_tag">7.2</span></a> hold, and</span></p>
</div>
<div id="A10.Thmtheorem12.p2" class="ltx_para">
<table id="A10.E173" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A10.E173.m1" class="ltx_Math" alttext="\delta_{F_{s}}\leq\min\left\{\frac{\alpha\beta_{2}\lambda_{H_{F,s}}}{2},\frac{\lambda_{H_{F,s}}}{4},\frac{\alpha}{2\chi\eta_{\text{min}}}\left(\frac{1}{\alpha\kappa_{F}^{1/2}}+\beta_{2}\right)^{-1}\right\}." display="block" intent=":literal"><semantics><mrow><mrow><msub><mi>δ</mi><msub><mi>F</mi><mi>s</mi></msub></msub><mo>≤</mo><mrow><mi>min</mi><mo>⁡</mo><mrow><mo>{</mo><mfrac><mrow><mi>α</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>β</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>λ</mi><msub><mi>H</mi><mrow><mi>F</mi><mo>,</mo><mi>s</mi></mrow></msub></msub></mrow><mn>2</mn></mfrac><mo>,</mo><mfrac><msub><mi>λ</mi><msub><mi>H</mi><mrow><mi>F</mi><mo>,</mo><mi>s</mi></mrow></msub></msub><mn>4</mn></mfrac><mo>,</mo><mrow><mfrac><mi>α</mi><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>χ</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>η</mi><mtext class="ltx_mathvariant_italic">min</mtext></msub></mrow></mfrac><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo>(</mo><mrow><mfrac><mn>1</mn><mrow><mi>α</mi><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>κ</mi><mi>F</mi><mrow><mn>1</mn><mo>/</mo><mn>2</mn></mrow></msubsup></mrow></mfrac><mo>+</mo><msub><mi>β</mi><mn>2</mn></msub></mrow><mo>)</mo></mrow><mrow><mo>−</mo><mn>1</mn></mrow></msup></mrow><mo>}</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\delta_{F_{s}}\leq\min\left\{\frac{\alpha\beta_{2}\lambda_{H_{F,s}}}{2},\frac{\lambda_{H_{F,s}}}{4},\frac{\alpha}{2\chi\eta_{\text{min}}}\left(\frac{1}{\alpha\kappa_{F}^{1/2}}+\beta_{2}\right)^{-1}\right\}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(173)</span></td></tr></tbody>
</table>
<p id="A10.Thmtheorem12.p2.1" class="ltx_p"><span id="A10.Thmtheorem12.p2.1.1" class="ltx_text ltx_font_italic">Then the trajectory <math id="A10.Thmtheorem12.p2.m1" class="ltx_Math" alttext="z_{t}" display="inline" intent=":literal"><semantics><msub><mi>z</mi><mi>t</mi></msub><annotation encoding="application/x-tex">z_{t}</annotation></semantics></math> in</span></p>
<table id="A10.EGx24" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A10.E174"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A10.E174.m1" class="ltx_Math" alttext="\displaystyle\begin{cases}&amp;\dot{z}_{t}=-\eta_{t}\chi P_{\mathcal{R}}(z_{t})F(z_{t})^{-1}(s_{t}+\beta_{2}\nabla f(z_{t})),\\
&amp;\dot{s}_{t}=-\alpha s_{t}+\nabla f(z_{t}),\end{cases}" display="inline" intent=":literal"><semantics><mrow><mo>{</mo><mtable columnspacing="5pt" rowspacing="0pt"><mtr><mtd></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mover accent="true"><mi>z</mi><mo>˙</mo></mover><msub><mrow></mrow><mi>t</mi></msub><mo rspace="0em">=</mo><mo lspace="0em">−</mo><mi>η</mi><msub><mrow></mrow><mi>t</mi></msub><mi>χ</mi><mi>P</mi><msub><mrow></mrow><mi class="ltx_font_mathcaligraphic">ℛ</mi></msub><mo stretchy="false">(</mo><mi>z</mi><msub><mrow></mrow><mi>t</mi></msub><mo stretchy="false">)</mo><mi>F</mi><mo stretchy="false">(</mo><mi>z</mi><msub><mrow></mrow><mi>t</mi></msub><mo stretchy="false">)</mo><msup><mrow></mrow><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo stretchy="false">(</mo><mi>s</mi><msub><mrow></mrow><mi>t</mi></msub><mo>+</mo><mi>β</mi><msub><mrow></mrow><mn>2</mn></msub><mo lspace="0.167em" rspace="0.167em">∇</mo><mi>f</mi><mo stretchy="false">(</mo><mi>z</mi><msub><mrow></mrow><mi>t</mi></msub><mo stretchy="false">)</mo><mo stretchy="false">)</mo><mo>,</mo></mrow></mtd></mtr><mtr><mtd></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><msub><mover accent="true"><mi>s</mi><mo>˙</mo></mover><mi>t</mi></msub><mo>=</mo><mrow><mrow><mo>−</mo><mrow><mi>α</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>s</mi><mi>t</mi></msub></mrow></mrow><mo>+</mo><mrow><mrow><mo rspace="0.167em">∇</mo><mi>f</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>z</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo>,</mo></mrow></mtd></mtr></mtable></mrow><annotation encoding="application/x-tex">\displaystyle\begin{cases}&amp;\dot{z}_{t}=-\eta_{t}\chi P_{\mathcal{R}}(z_{t})F(z_{t})^{-1}(s_{t}+\beta_{2}\nabla f(z_{t})),\\
&amp;\dot{s}_{t}=-\alpha s_{t}+\nabla f(z_{t}),\end{cases}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(174)</span></td></tr></tbody>
</table>
<p id="A10.Thmtheorem12.p2.2" class="ltx_p"><span id="A10.Thmtheorem12.p2.2.1" class="ltx_text ltx_font_italic">starting from <math id="A10.Thmtheorem12.p2.m2" class="ltx_Math" alttext="z_{t}|_{t=0}=z_{0}" display="inline" intent=":literal"><semantics><mrow><msub><mrow><msub><mi>z</mi><mi>t</mi></msub><mo stretchy="false">|</mo></mrow><mrow><mi>t</mi><mo>=</mo><mn>0</mn></mrow></msub><mo>=</mo><msub><mi>z</mi><mn>0</mn></msub></mrow><annotation encoding="application/x-tex">z_{t}|_{t=0}=z_{0}</annotation></semantics></math> and <math id="A10.Thmtheorem12.p2.m3" class="ltx_Math" alttext="s_{0}=0" display="inline" intent=":literal"><semantics><mrow><msub><mi>s</mi><mn>0</mn></msub><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">s_{0}=0</annotation></semantics></math> satisfies</span></p>
</div>
<div id="A10.Thmtheorem12.p3" class="ltx_para">
<table id="A10.E175" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A10.E175.m1" class="ltx_math_unparsed" alttext="\int_{0}^{t}\eta_{t}\|P_{\mathcal{R}}(z_{t})F(z_{t})^{-1}\nabla f(z_{t})\|_{F(z_{t})}^{2}\leq\frac{2(f(z_{0})-\inf f)}{\chi\beta_{2}},\quad\int_{0}^{t}\eta_{t}\|s_{t}\|_{F(z_{t})}^{2}\leq\frac{2(f(z_{0})-\inf f)}{\chi\alpha}." display="block" intent=":literal"><semantics><mrow><msubsup><mo>∫</mo><mn>0</mn><mi>t</mi></msubsup><msub><mi>η</mi><mi>t</mi></msub><mo lspace="0em" rspace="0.167em">∥</mo><msub><mi>P</mi><mi class="ltx_font_mathcaligraphic">ℛ</mi></msub><mrow><mo stretchy="false">(</mo><msub><mi>z</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow><mi>F</mi><msup><mrow><mo stretchy="false">(</mo><msub><mi>z</mi><mi>t</mi></msub><mo rspace="0.167em" stretchy="false">)</mo></mrow><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo rspace="0.167em">∇</mo><mi>f</mi><mrow><mo stretchy="false">(</mo><msub><mi>z</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow><msubsup><mo lspace="0em" rspace="0.0835em">∥</mo><mrow><mi>F</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>z</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mn>2</mn></msubsup><mo lspace="0.0835em">≤</mo><mfrac><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mi>f</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>z</mi><mn>0</mn></msub><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mo lspace="0em" rspace="0.167em">inf</mo><mi>f</mi></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mrow><mi>χ</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>β</mi><mn>2</mn></msub></mrow></mfrac><mo rspace="1.000em">,</mo><msubsup><mo>∫</mo><mn>0</mn><mi>t</mi></msubsup><msub><mi>η</mi><mi>t</mi></msub><mo lspace="0em" rspace="0.167em">∥</mo><msub><mi>s</mi><mi>t</mi></msub><msubsup><mo lspace="0em" rspace="0.0835em">∥</mo><mrow><mi>F</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>z</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mn>2</mn></msubsup><mo lspace="0.0835em">≤</mo><mfrac><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mi>f</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>z</mi><mn>0</mn></msub><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mo lspace="0em" rspace="0.167em">inf</mo><mi>f</mi></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mrow><mi>χ</mi><mo lspace="0em" rspace="0em">​</mo><mi>α</mi></mrow></mfrac><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\int_{0}^{t}\eta_{t}\|P_{\mathcal{R}}(z_{t})F(z_{t})^{-1}\nabla f(z_{t})\|_{F(z_{t})}^{2}\leq\frac{2(f(z_{0})-\inf f)}{\chi\beta_{2}},\quad\int_{0}^{t}\eta_{t}\|s_{t}\|_{F(z_{t})}^{2}\leq\frac{2(f(z_{0})-\inf f)}{\chi\alpha}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(175)</span></td></tr></tbody>
</table>
</div>
<div id="A10.Thmtheorem12.4" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="A10.Thmtheorem12.p4" class="ltx_para">
<p id="A10.Thmtheorem12.p4.2" class="ltx_p"><span id="A10.Thmtheorem12.p4.2.1" class="ltx_text">Consider the Lyapunov function <math id="A10.Thmtheorem12.p4.m1" class="ltx_Math" alttext="W_{t}=f(z_{t})-\inf f+\frac{1}{2}\eta_{t}\chi\|s_{t}\|_{F^{-1}(z_{t})}^{2}" display="inline" intent=":literal"><semantics><mrow><msub><mi>W</mi><mi>t</mi></msub><mo>=</mo><mrow><mrow><mrow><mi>f</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>z</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mo lspace="0em" rspace="0.167em">inf</mo><mi>f</mi></mrow></mrow><mo>+</mo><mrow><mfrac><mn>1</mn><mn>2</mn></mfrac><mo lspace="0em" rspace="0em">​</mo><msub><mi>η</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi>χ</mi><mo lspace="0em" rspace="0em">​</mo><msubsup><mrow><mo stretchy="false">‖</mo><msub><mi>s</mi><mi>t</mi></msub><mo stretchy="false">‖</mo></mrow><mrow><msup><mi>F</mi><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>z</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mn>2</mn></msubsup></mrow></mrow></mrow><annotation encoding="application/x-tex">W_{t}=f(z_{t})-\inf f+\frac{1}{2}\eta_{t}\chi\|s_{t}\|_{F^{-1}(z_{t})}^{2}</annotation></semantics></math>. Then taking the time derivative gives</span></p>
<table id="A10.E176" class="ltx_equationgroup ltx_eqn_table">
<tbody>
<tr id="A10.E176X" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A10.E176X.m2" class="ltx_Math" alttext="\displaystyle\frac{d}{dt}W_{t}=" display="inline" intent=":literal"><semantics><mrow><mrow><mstyle displaystyle="true"><mfrac><mi>d</mi><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msub><mi>W</mi><mi>t</mi></msub></mrow><mo>=</mo><mphantom></mphantom></mrow><annotation encoding="application/x-tex">\displaystyle\frac{d}{dt}W_{t}=</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A10.E176X.m3" class="ltx_Math" alttext="\displaystyle\underbrace{-\eta_{t}\chi\left\langle(P_{\mathcal{R}}(z_{t})-I)F(z_{t})^{-1}\nabla f(z_{t}),s_{t}\right\rangle}_{A}-\eta_{t}\chi\beta_{2}\|P_{\mathcal{R}}(z_{t})F(z_{t})^{-1}\nabla f(z_{t})\|_{F(z_{t})}^{2}" display="inline" intent=":literal"><semantics><mrow><munder accentunder="true"><mrow><mo>−</mo><mi>η</mi><msub><mrow></mrow><mi>t</mi></msub><mi>χ</mi><mo>⟨</mo><mo stretchy="false">(</mo><mi>P</mi><msub><mrow></mrow><mi class="ltx_font_mathcaligraphic">ℛ</mi></msub><mo stretchy="false">(</mo><mi>z</mi><msub><mrow></mrow><mi>t</mi></msub><mo stretchy="false">)</mo><mo>−</mo><mi>I</mi><mo stretchy="false">)</mo><mi>F</mi><mo stretchy="false">(</mo><mi>z</mi><msub><mrow></mrow><mi>t</mi></msub><mo rspace="0.167em" stretchy="false">)</mo><msup><mrow></mrow><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo rspace="0.167em">∇</mo><mi>f</mi><mo stretchy="false">(</mo><mi>z</mi><msub><mrow></mrow><mi>t</mi></msub><mo stretchy="false">)</mo><mo>,</mo><mi>s</mi><msub><mrow></mrow><mi>t</mi></msub><mo>⟩</mo></mrow><mo stretchy="true">⏟</mo></munder><msub><mrow></mrow><mi>A</mi></msub><mo>−</mo><mi>η</mi><msub><mrow></mrow><mi>t</mi></msub><mi>χ</mi><mi>β</mi><msub><mrow></mrow><mn>2</mn></msub><mo lspace="0em" rspace="0.167em">∥</mo><mi>P</mi><msub><mrow></mrow><mi class="ltx_font_mathcaligraphic">ℛ</mi></msub><mo stretchy="false">(</mo><mi>z</mi><msub><mrow></mrow><mi>t</mi></msub><mo stretchy="false">)</mo><mi>F</mi><mo stretchy="false">(</mo><mi>z</mi><msub><mrow></mrow><mi>t</mi></msub><mo rspace="0.167em" stretchy="false">)</mo><msup><mrow></mrow><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo rspace="0.167em">∇</mo><mi>f</mi><mo stretchy="false">(</mo><mi>z</mi><msub><mrow></mrow><mi>t</mi></msub><mo stretchy="false">)</mo><mo lspace="0em">∥</mo><msub><mrow></mrow><mrow><mi>F</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>z</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow></msub><msup><mrow></mrow><mn>2</mn></msup></mrow><annotation encoding="application/x-tex">\displaystyle\underbrace{-\eta_{t}\chi\left\langle(P_{\mathcal{R}}(z_{t})-I)F(z_{t})^{-1}\nabla f(z_{t}),s_{t}\right\rangle}_{A}-\eta_{t}\chi\beta_{2}\|P_{\mathcal{R}}(z_{t})F(z_{t})^{-1}\nabla f(z_{t})\|_{F(z_{t})}^{2}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="2" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equationgroup ltx_align_right">(176)</span></td></tr>
<tr id="A10.E176Xa" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A10.E176Xa.m2" class="ltx_Math" alttext="\displaystyle-\eta_{t}\chi\alpha\|s_{t}\|_{F^{-1}(z_{t})}^{2}+\frac{1}{2}\eta_{t}\chi s_{t}^{\top}\nabla F^{-1}(z_{t})[\dot{z}_{t}]s_{t}+\frac{1}{2}\dot{\eta}_{t}\chi\|s_{t}\|_{F^{-1}(z_{t})}^{2}." display="inline" intent=":literal"><semantics><mrow><mo>−</mo><mi>η</mi><msub><mrow></mrow><mi>t</mi></msub><mi>χ</mi><mi>α</mi><mo lspace="0em" rspace="0.167em">∥</mo><mi>s</mi><msub><mrow></mrow><mi>t</mi></msub><mo lspace="0em" rspace="0em">∥</mo><msub><mrow></mrow><mrow><msup><mi>F</mi><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>z</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow></msub><msup><mrow></mrow><mn>2</mn></msup><mo lspace="0em">+</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mn>2</mn></mfrac></mstyle><mi>η</mi><msub><mrow></mrow><mi>t</mi></msub><mi>χ</mi><mi>s</mi><msub><mrow></mrow><mi>t</mi></msub><msup><mrow></mrow><mo>⊤</mo></msup><mo lspace="0.167em" rspace="0.167em">∇</mo><mi>F</mi><msup><mrow></mrow><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo stretchy="false">(</mo><mi>z</mi><msub><mrow></mrow><mi>t</mi></msub><mo stretchy="false">)</mo><mo stretchy="false">[</mo><mover accent="true"><mi>z</mi><mo>˙</mo></mover><msub><mrow></mrow><mi>t</mi></msub><mo stretchy="false">]</mo><mi>s</mi><msub><mrow></mrow><mi>t</mi></msub><mo>+</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mn>2</mn></mfrac></mstyle><mover accent="true"><mi>η</mi><mo>˙</mo></mover><msub><mrow></mrow><mi>t</mi></msub><mi>χ</mi><mo lspace="0em" rspace="0.167em">∥</mo><mi>s</mi><msub><mrow></mrow><mi>t</mi></msub><mo lspace="0em" rspace="0.0835em">∥</mo><msub><mrow></mrow><mrow><msup><mi>F</mi><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>z</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow></msub><msup><mrow></mrow><mn>2</mn></msup><mo lspace="0.0835em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle-\eta_{t}\chi\alpha\|s_{t}\|_{F^{-1}(z_{t})}^{2}+\frac{1}{2}\eta_{t}\chi s_{t}^{\top}\nabla F^{-1}(z_{t})[\dot{z}_{t}]s_{t}+\frac{1}{2}\dot{\eta}_{t}\chi\|s_{t}\|_{F^{-1}(z_{t})}^{2}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="A10.Thmtheorem12.p5" class="ltx_para">
<p id="A10.Thmtheorem12.p5.1" class="ltx_p"><span id="A10.Thmtheorem12.p5.1.1" class="ltx_text">By using <math id="A10.Thmtheorem12.p5.m1" class="ltx_math_unparsed" alttext="F(z_{t})^{-1}\nabla f(z_{t})=P_{f}(z_{t})F(z_{t})^{-1}\nabla f(z_{t})" display="inline" intent=":literal"><semantics><mrow><mi>F</mi><msup><mrow><mo stretchy="false">(</mo><msub><mi>z</mi><mi>t</mi></msub><mo rspace="0.167em" stretchy="false">)</mo></mrow><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo rspace="0.167em">∇</mo><mi>f</mi><mrow><mo stretchy="false">(</mo><msub><mi>z</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow><mo>=</mo><msub><mi>P</mi><mi>f</mi></msub><mrow><mo stretchy="false">(</mo><msub><mi>z</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow><mi>F</mi><msup><mrow><mo stretchy="false">(</mo><msub><mi>z</mi><mi>t</mi></msub><mo rspace="0.167em" stretchy="false">)</mo></mrow><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo rspace="0.167em">∇</mo><mi>f</mi><mrow><mo stretchy="false">(</mo><msub><mi>z</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">F(z_{t})^{-1}\nabla f(z_{t})=P_{f}(z_{t})F(z_{t})^{-1}\nabla f(z_{t})</annotation></semantics></math> and Lemma <a href="#A10.Thmtheorem8" title="Lemma J.8. ‣ J.2 Dynamics Analysis ‣ Appendix J Proof ‣ Accelerating LLM Pre-Training through Flat-Direction Dynamics Enhancement" class="ltx_ref"><span class="ltx_text ltx_ref_tag">J.8</span></a>, we have</span></p>
</div>
<div id="A10.Thmtheorem12.p6" class="ltx_para">
<table id="A10.E177" class="ltx_equationgroup ltx_eqn_table">
<tbody>
<tr id="A10.E177X" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A10.E177X.m2" class="ltx_Math" alttext="\displaystyle\|(P_{\mathcal{R}}(z_{t})-I)F(z_{t})^{-1}\nabla f(z_{t})\|_{F(z_{t})}^{2}=" display="inline" intent=":literal"><semantics><mrow><mo rspace="0.167em">∥</mo><mo stretchy="false">(</mo><mi>P</mi><msub><mrow></mrow><mi class="ltx_font_mathcaligraphic">ℛ</mi></msub><mo stretchy="false">(</mo><mi>z</mi><msub><mrow></mrow><mi>t</mi></msub><mo stretchy="false">)</mo><mo>−</mo><mi>I</mi><mo stretchy="false">)</mo><mi>F</mi><mo stretchy="false">(</mo><mi>z</mi><msub><mrow></mrow><mi>t</mi></msub><mo rspace="0.167em" stretchy="false">)</mo><msup><mrow></mrow><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo rspace="0.167em">∇</mo><mi>f</mi><mo stretchy="false">(</mo><mi>z</mi><msub><mrow></mrow><mi>t</mi></msub><mo stretchy="false">)</mo><mo lspace="0em" rspace="0.0835em">∥</mo><msub><mrow></mrow><mrow><mi>F</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>z</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow></msub><msup><mrow></mrow><mn>2</mn></msup><mo lspace="0.0835em">=</mo></mrow><annotation encoding="application/x-tex">\displaystyle\|(P_{\mathcal{R}}(z_{t})-I)F(z_{t})^{-1}\nabla f(z_{t})\|_{F(z_{t})}^{2}=</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A10.E177X.m3" class="ltx_Math" alttext="\displaystyle\|(P_{\mathcal{R}}(z_{t})-P_{f}(z_{t}))F(z_{t})^{-1}\nabla f(z_{t})\|_{F(z_{t})}^{2}\leq\frac{\delta_{F_{s}}^{2}}{\lambda_{H_{F,s}}^{2}}\|F(z_{t})^{-1}\nabla f(z_{t})\|_{F(z_{t})}^{2}." display="inline" intent=":literal"><semantics><mrow><mo rspace="0.167em">∥</mo><mo stretchy="false">(</mo><mi>P</mi><msub><mrow></mrow><mi class="ltx_font_mathcaligraphic">ℛ</mi></msub><mo stretchy="false">(</mo><mi>z</mi><msub><mrow></mrow><mi>t</mi></msub><mo stretchy="false">)</mo><mo>−</mo><mi>P</mi><msub><mrow></mrow><mi>f</mi></msub><mo stretchy="false">(</mo><mi>z</mi><msub><mrow></mrow><mi>t</mi></msub><mo stretchy="false">)</mo><mo stretchy="false">)</mo><mi>F</mi><mo stretchy="false">(</mo><mi>z</mi><msub><mrow></mrow><mi>t</mi></msub><mo rspace="0.167em" stretchy="false">)</mo><msup><mrow></mrow><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo rspace="0.167em">∇</mo><mi>f</mi><mo stretchy="false">(</mo><mi>z</mi><msub><mrow></mrow><mi>t</mi></msub><mo stretchy="false">)</mo><mo lspace="0em" rspace="0.0835em">∥</mo><msub><mrow></mrow><mrow><mi>F</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>z</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow></msub><msup><mrow></mrow><mn>2</mn></msup><mo lspace="0.0835em">≤</mo><mstyle displaystyle="true"><mfrac><msubsup><mi>δ</mi><msub><mi>F</mi><mi>s</mi></msub><mn>2</mn></msubsup><msubsup><mi>λ</mi><msub><mi>H</mi><mrow><mi>F</mi><mo>,</mo><mi>s</mi></mrow></msub><mn>2</mn></msubsup></mfrac></mstyle><mo lspace="0em" rspace="0.167em">∥</mo><mi>F</mi><mo stretchy="false">(</mo><mi>z</mi><msub><mrow></mrow><mi>t</mi></msub><mo rspace="0.167em" stretchy="false">)</mo><msup><mrow></mrow><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo rspace="0.167em">∇</mo><mi>f</mi><mo stretchy="false">(</mo><mi>z</mi><msub><mrow></mrow><mi>t</mi></msub><mo stretchy="false">)</mo><mo lspace="0em" rspace="0.0835em">∥</mo><msub><mrow></mrow><mrow><mi>F</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>z</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow></msub><msup><mrow></mrow><mn>2</mn></msup><mo lspace="0.0835em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\|(P_{\mathcal{R}}(z_{t})-P_{f}(z_{t}))F(z_{t})^{-1}\nabla f(z_{t})\|_{F(z_{t})}^{2}\leq\frac{\delta_{F_{s}}^{2}}{\lambda_{H_{F,s}}^{2}}\|F(z_{t})^{-1}\nabla f(z_{t})\|_{F(z_{t})}^{2}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equationgroup ltx_align_right">(177)</span></td></tr></tbody>
</table>
<p id="A10.Thmtheorem12.p6.1" class="ltx_p"><span id="A10.Thmtheorem12.p6.1.1" class="ltx_text">Since <math id="A10.Thmtheorem12.p6.m1" class="ltx_math_unparsed" alttext="\|(P_{\mathcal{R}}(z_{t})-I)F(z_{t})^{-1}\nabla f(z_{t})\|_{F(z_{t})}^{2}+\|P_{\mathcal{R}}F(z_{t})^{-1}\nabla f(z_{t})\|_{F(z_{t})}^{2}=\|F(z_{t})^{-1}\nabla f(z_{t})\|_{F(z_{t})}^{2}" display="inline" intent=":literal"><semantics><mrow><mo rspace="0.167em">∥</mo><mrow><mo stretchy="false">(</mo><msub><mi>P</mi><mi class="ltx_font_mathcaligraphic">ℛ</mi></msub><mrow><mo stretchy="false">(</mo><msub><mi>z</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow><mo>−</mo><mi>I</mi><mo stretchy="false">)</mo></mrow><mi>F</mi><msup><mrow><mo stretchy="false">(</mo><msub><mi>z</mi><mi>t</mi></msub><mo rspace="0.167em" stretchy="false">)</mo></mrow><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo rspace="0.167em">∇</mo><mi>f</mi><mrow><mo stretchy="false">(</mo><msub><mi>z</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow><msubsup><mo lspace="0em" rspace="0em">∥</mo><mrow><mi>F</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>z</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">+</mo><mo lspace="0em" rspace="0.167em">∥</mo><msub><mi>P</mi><mi class="ltx_font_mathcaligraphic">ℛ</mi></msub><mi>F</mi><msup><mrow><mo stretchy="false">(</mo><msub><mi>z</mi><mi>t</mi></msub><mo rspace="0.167em" stretchy="false">)</mo></mrow><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo rspace="0.167em">∇</mo><mi>f</mi><mrow><mo stretchy="false">(</mo><msub><mi>z</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow><msubsup><mo lspace="0em" rspace="0.0835em">∥</mo><mrow><mi>F</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>z</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mn>2</mn></msubsup><mo lspace="0.0835em" rspace="0em">=</mo><mo lspace="0em" rspace="0.167em">∥</mo><mi>F</mi><msup><mrow><mo stretchy="false">(</mo><msub><mi>z</mi><mi>t</mi></msub><mo rspace="0.167em" stretchy="false">)</mo></mrow><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo rspace="0.167em">∇</mo><mi>f</mi><mrow><mo stretchy="false">(</mo><msub><mi>z</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow><msubsup><mo lspace="0em">∥</mo><mrow><mi>F</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>z</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mn>2</mn></msubsup></mrow><annotation encoding="application/x-tex">\|(P_{\mathcal{R}}(z_{t})-I)F(z_{t})^{-1}\nabla f(z_{t})\|_{F(z_{t})}^{2}+\|P_{\mathcal{R}}F(z_{t})^{-1}\nabla f(z_{t})\|_{F(z_{t})}^{2}=\|F(z_{t})^{-1}\nabla f(z_{t})\|_{F(z_{t})}^{2}</annotation></semantics></math>, we have</span></p>
</div>
<div id="A10.Thmtheorem12.p7" class="ltx_para">
<table id="A10.E178" class="ltx_equationgroup ltx_eqn_table">
<tbody>
<tr id="A10.E178X" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
