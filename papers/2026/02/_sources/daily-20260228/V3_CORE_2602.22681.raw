<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A10.E160X.m3" class="ltx_Math" alttext="\displaystyle\kappa_{F}^{\frac{1}{2}}(\epsilon_{\Phi}+\frac{\delta_{F_{s}}}{\lambda_{H_{F,s}}})\|F_{s}^{\dagger}(w_{t})m_{t}+\chi F_{f}^{\dagger}(z_{t})(s_{t}+\beta_{2}\nabla f(z_{t}))\|_{2}" display="inline" intent=":literal"><semantics><mrow><mi>κ</mi><msub><mrow></mrow><mi>F</mi></msub><msup><mrow></mrow><mfrac><mn>1</mn><mn>2</mn></mfrac></msup><mo stretchy="false">(</mo><mi>ϵ</mi><msub><mrow></mrow><mi mathvariant="normal">Φ</mi></msub><mo>+</mo><mstyle displaystyle="true"><mfrac><msub><mi>δ</mi><msub><mi>F</mi><mi>s</mi></msub></msub><msub><mi>λ</mi><msub><mi>H</mi><mrow><mi>F</mi><mo>,</mo><mi>s</mi></mrow></msub></msub></mfrac></mstyle><mo stretchy="false">)</mo><mo lspace="0em" rspace="0.167em">∥</mo><mi>F</mi><msub><mrow></mrow><mi>s</mi></msub><msup><mrow></mrow><mo>†</mo></msup><mo stretchy="false">(</mo><mi>w</mi><msub><mrow></mrow><mi>t</mi></msub><mo stretchy="false">)</mo><mi>m</mi><msub><mrow></mrow><mi>t</mi></msub><mo>+</mo><mi>χ</mi><mi>F</mi><msub><mrow></mrow><mi>f</mi></msub><msup><mrow></mrow><mo>†</mo></msup><mo stretchy="false">(</mo><mi>z</mi><msub><mrow></mrow><mi>t</mi></msub><mo stretchy="false">)</mo><mo stretchy="false">(</mo><mi>s</mi><msub><mrow></mrow><mi>t</mi></msub><mo>+</mo><mi>β</mi><msub><mrow></mrow><mn>2</mn></msub><mo lspace="0.167em" rspace="0.167em">∇</mo><mi>f</mi><mo stretchy="false">(</mo><mi>z</mi><msub><mrow></mrow><mi>t</mi></msub><mo stretchy="false">)</mo><mo stretchy="false">)</mo><mo lspace="0em">∥</mo><msub><mrow></mrow><mn>2</mn></msub></mrow><annotation encoding="application/x-tex">\displaystyle\kappa_{F}^{\frac{1}{2}}(\epsilon_{\Phi}+\frac{\delta_{F_{s}}}{\lambda_{H_{F,s}}})\|F_{s}^{\dagger}(w_{t})m_{t}+\chi F_{f}^{\dagger}(z_{t})(s_{t}+\beta_{2}\nabla f(z_{t}))\|_{2}</annotation></semantics></math></td>
