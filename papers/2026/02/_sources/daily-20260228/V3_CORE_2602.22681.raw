<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A10.E159Xc.m3" class="ltx_Math" alttext="\displaystyle\rho^{\frac{1}{2}}\lambda_{F}^{-\frac{1}{2}}(\epsilon_{\Phi}+\frac{\delta_{F_{s}}}{\lambda_{H_{F,s}}})\|v\|_{2}+\frac{\delta}{G}\kappa_{F}^{\frac{1}{2}}\lambda_{F}^{-\frac{1}{2}}\|w_{t}-\Phi(w_{t})\|_{2}\|v\|_{2}," display="inline" intent=":literal"><semantics><mrow><mrow><mrow><msup><mi>ρ</mi><mfrac><mn>1</mn><mn>2</mn></mfrac></msup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>λ</mi><mi>F</mi><mrow><mo>−</mo><mfrac><mn>1</mn><mn>2</mn></mfrac></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>ϵ</mi><mi mathvariant="normal">Φ</mi></msub><mo>+</mo><mstyle displaystyle="true"><mfrac><msub><mi>δ</mi><msub><mi>F</mi><mi>s</mi></msub></msub><msub><mi>λ</mi><msub><mi>H</mi><mrow><mi>F</mi><mo>,</mo><mi>s</mi></mrow></msub></msub></mfrac></mstyle></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">‖</mo><mi>v</mi><mo stretchy="false">‖</mo></mrow><mn>2</mn></msub></mrow><mo>+</mo><mrow><mstyle displaystyle="true"><mfrac><mi>δ</mi><mi>G</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>κ</mi><mi>F</mi><mfrac><mn>1</mn><mn>2</mn></mfrac></msubsup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>λ</mi><mi>F</mi><mrow><mo>−</mo><mfrac><mn>1</mn><mn>2</mn></mfrac></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">‖</mo><mrow><msub><mi>w</mi><mi>t</mi></msub><mo>−</mo><mrow><mi mathvariant="normal">Φ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>w</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">‖</mo><mi>v</mi><mo stretchy="false">‖</mo></mrow><mn>2</mn></msub></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\rho^{\frac{1}{2}}\lambda_{F}^{-\frac{1}{2}}(\epsilon_{\Phi}+\frac{\delta_{F_{s}}}{\lambda_{H_{F,s}}})\|v\|_{2}+\frac{\delta}{G}\kappa_{F}^{\frac{1}{2}}\lambda_{F}^{-\frac{1}{2}}\|w_{t}-\Phi(w_{t})\|_{2}\|v\|_{2},</annotation></semantics></math></td>
