</div>
<div id="A10.Thmtheorem12.p8" class="ltx_para">
<p id="A10.Thmtheorem12.p8.2" class="ltx_p"><span id="A10.Thmtheorem12.p8.2.1" class="ltx_text">On the other hand, similar to (<a href="#A10.E125" title="Equation 125 ‣ Proof. ‣ Lemma J.6. ‣ J.2 Dynamics Analysis ‣ Appendix J Proof ‣ Accelerating LLM Pre-Training through Flat-Direction Dynamics Enhancement" class="ltx_ref"><span class="ltx_text ltx_ref_tag">125</span></a>), we have</span></p>
<table id="A10.E180" class="ltx_equationgroup ltx_eqn_table">
<tbody>
<tr id="A10.E180X" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A10.E180X.m2" class="ltx_Math" alttext="\displaystyle\|\dot{z}_{t}\|_{F(z_{t})}\leq" display="inline" intent=":literal"><semantics><mrow><msub><mrow><mo stretchy="false">‖</mo><msub><mover accent="true"><mi>z</mi><mo>˙</mo></mover><mi>t</mi></msub><mo stretchy="false">‖</mo></mrow><mrow><mi>F</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>z</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow></msub><mo>≤</mo><mphantom></mphantom></mrow><annotation encoding="application/x-tex">\displaystyle\|\dot{z}_{t}\|_{F(z_{t})}\leq</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A10.E180X.m3" class="ltx_Math" alttext="\displaystyle\eta_{t}\chi\left(\|s_{t}\|_{F^{-1}(w_{t})}+\beta_{2}\|\nabla f(z_{t})\|_{F^{-1}(z_{t})}\right)" display="inline" intent=":literal"><semantics><mrow><msub><mi>η</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi>χ</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><msub><mrow><mo stretchy="false">‖</mo><msub><mi>s</mi><mi>t</mi></msub><mo stretchy="false">‖</mo></mrow><mrow><msup><mi>F</mi><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>w</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow></msub><mo>+</mo><mrow><msub><mi>β</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">‖</mo><mrow><mrow><mo rspace="0.167em">∇</mo><mi>f</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>z</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">‖</mo></mrow><mrow><msup><mi>F</mi><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>z</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow></msub></mrow></mrow><mo>)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\eta_{t}\chi\left(\|s_{t}\|_{F^{-1}(w_{t})}+\beta_{2}\|\nabla f(z_{t})\|_{F^{-1}(z_{t})}\right)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="3" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equationgroup ltx_align_right">(180)</span></td></tr>
<tr id="A10.E180Xa" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A10.E180Xa.m2" class="ltx_Math" alttext="\displaystyle\leq" display="inline" intent=":literal"><semantics><mo>≤</mo><annotation encoding="application/x-tex">\displaystyle\leq</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A10.E180Xa.m3" class="ltx_Math" alttext="\displaystyle\eta_{t}\chi\left(\lambda_{F}^{-\frac{1}{2}}\int_{0}^{t}e^{\alpha-(t-s)}\|\nabla f(z_{s})\|_{2}ds+\beta_{2}\|\nabla f(z_{t})\|_{F^{-1}(z_{t})}\right)" display="inline" intent=":literal"><semantics><mrow><msub><mi>η</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi>χ</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mrow><msubsup><mi>λ</mi><mi>F</mi><mrow><mo>−</mo><mfrac><mn>1</mn><mn>2</mn></mfrac></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><msubsup><mo>∫</mo><mn>0</mn><mi>t</mi></msubsup></mstyle><mrow><msup><mi>e</mi><mrow><mi>α</mi><mo>−</mo><mrow><mo stretchy="false">(</mo><mrow><mi>t</mi><mo>−</mo><mi>s</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">‖</mo><mrow><mrow><mo rspace="0.167em">∇</mo><mi>f</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>z</mi><mi>s</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo rspace="0em">d</mo><mi>s</mi></mrow></mrow></mrow></mrow><mo>+</mo><mrow><msub><mi>β</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">‖</mo><mrow><mrow><mo rspace="0.167em">∇</mo><mi>f</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>z</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">‖</mo></mrow><mrow><msup><mi>F</mi><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>z</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow></msub></mrow></mrow><mo>)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\eta_{t}\chi\left(\lambda_{F}^{-\frac{1}{2}}\int_{0}^{t}e^{\alpha-(t-s)}\|\nabla f(z_{s})\|_{2}ds+\beta_{2}\|\nabla f(z_{t})\|_{F^{-1}(z_{t})}\right)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr>
<tr id="A10.E180Xb" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A10.E180Xb.m2" class="ltx_Math" alttext="\displaystyle\leq" display="inline" intent=":literal"><semantics><mo>≤</mo><annotation encoding="application/x-tex">\displaystyle\leq</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A10.E180Xb.m3" class="ltx_Math" alttext="\displaystyle\eta_{t}\underbrace{\chi\left(\frac{1}{\alpha\kappa_{F}^{1/2}}+\beta_{2}\right)}_{:=C_{w}}G." display="inline" intent=":literal"><semantics><mrow><mi>η</mi><msub><mrow></mrow><mi>t</mi></msub><munder accentunder="true"><mrow><mi>χ</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mrow><mi>α</mi><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>κ</mi><mi>F</mi><mrow><mn>1</mn><mo>/</mo><mn>2</mn></mrow></msubsup></mrow></mfrac></mstyle><mo>+</mo><msub><mi>β</mi><mn>2</mn></msub></mrow><mo>)</mo></mrow></mrow><mo stretchy="true">⏟</mo></munder><msub><mrow></mrow><mrow><mphantom></mphantom><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mphantom></mphantom><mo>=</mo><msub><mi>C</mi><mi>w</mi></msub></mrow></mrow></msub><mi>G</mi><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\eta_{t}\underbrace{\chi\left(\frac{1}{\alpha\kappa_{F}^{1/2}}+\beta_{2}\right)}_{:=C_{w}}G.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A10.Thmtheorem12.p8.3" class="ltx_p"><span id="A10.Thmtheorem12.p8.3.1" class="ltx_text">This gives</span></p>
<table id="A10.E181" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A10.E181.m1" class="ltx_math_unparsed" alttext="\eta_{t}\chi s_{t}^{\top}\nabla F^{-1}(z_{t})[\dot{z}_{t}]s_{t}\leq\eta_{t}^{2}\chi\delta_{F_{s}}C_{w}\|s_{t}\|_{F^{-1}(z_{t})}^{2}\overset{\eqref{condition-deltafs-river-flow}}{\leq}\frac{1}{2}\eta_{t}\chi\alpha\|s_{t}\|_{F^{-1}(z_{t})}^{2}." display="block" intent=":literal"><semantics><mrow><msub><mi>η</mi><mi>t</mi></msub><mi>χ</mi><msubsup><mi>s</mi><mi>t</mi><mo>⊤</mo></msubsup><mo lspace="0.167em" rspace="0.167em">∇</mo><msup><mi>F</mi><mrow><mo>−</mo><mn>1</mn></mrow></msup><mrow><mo stretchy="false">(</mo><msub><mi>z</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow><mrow><mo stretchy="false">[</mo><msub><mover accent="true"><mi>z</mi><mo>˙</mo></mover><mi>t</mi></msub><mo stretchy="false">]</mo></mrow><msub><mi>s</mi><mi>t</mi></msub><mo>≤</mo><msubsup><mi>η</mi><mi>t</mi><mn>2</mn></msubsup><mi>χ</mi><msub><mi>δ</mi><msub><mi>F</mi><mi>s</mi></msub></msub><msub><mi>C</mi><mi>w</mi></msub><mo lspace="0em" rspace="0.167em">∥</mo><msub><mi>s</mi><mi>t</mi></msub><msubsup><mo lspace="0em" rspace="0.0835em">∥</mo><mrow><msup><mi>F</mi><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>z</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mn>2</mn></msubsup><mover accent="true"><mo lspace="0.0835em">≤</mo><mrow><mtext mathsize="0.700em">(</mtext><mtext mathsize="0.700em"><a href="#A10.E173" title="Equation 173 ‣ Lemma J.12. ‣ J.2 Dynamics Analysis ‣ Appendix J Proof ‣ Accelerating LLM Pre-Training through Flat-Direction Dynamics Enhancement" class="ltx_ref" style="font-size:70%;"><span class="ltx_text ltx_ref_tag">173</span></a></mtext><mtext mathsize="0.700em">)</mtext></mrow></mover><mfrac><mn>1</mn><mn>2</mn></mfrac><msub><mi>η</mi><mi>t</mi></msub><mi>χ</mi><mi>α</mi><mo lspace="0em" rspace="0.167em">∥</mo><msub><mi>s</mi><mi>t</mi></msub><msubsup><mo lspace="0em" rspace="0.0835em">∥</mo><mrow><msup><mi>F</mi><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>z</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mn>2</mn></msubsup><mo lspace="0.0835em">.</mo></mrow><annotation encoding="application/x-tex">\eta_{t}\chi s_{t}^{\top}\nabla F^{-1}(z_{t})[\dot{z}_{t}]s_{t}\leq\eta_{t}^{2}\chi\delta_{F_{s}}C_{w}\|s_{t}\|_{F^{-1}(z_{t})}^{2}\overset{\eqref{condition-deltafs-river-flow}}{\leq}\frac{1}{2}\eta_{t}\chi\alpha\|s_{t}\|_{F^{-1}(z_{t})}^{2}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(181)</span></td></tr></tbody>
</table>
<p id="A10.Thmtheorem12.p8.4" class="ltx_p"><span id="A10.Thmtheorem12.p8.4.1" class="ltx_text">Substituting (<a href="#A10.E179" title="Equation 179 ‣ Proof. ‣ Lemma J.12. ‣ J.2 Dynamics Analysis ‣ Appendix J Proof ‣ Accelerating LLM Pre-Training through Flat-Direction Dynamics Enhancement" class="ltx_ref"><span class="ltx_text ltx_ref_tag">179</span></a>) and (<a href="#A10.E181" title="Equation 181 ‣ Proof. ‣ Lemma J.12. ‣ J.2 Dynamics Analysis ‣ Appendix J Proof ‣ Accelerating LLM Pre-Training through Flat-Direction Dynamics Enhancement" class="ltx_ref"><span class="ltx_text ltx_ref_tag">181</span></a>) into
(<a href="#A10.E176" title="Equation 176 ‣ Proof. ‣ Lemma J.12. ‣ J.2 Dynamics Analysis ‣ Appendix J Proof ‣ Accelerating LLM Pre-Training through Flat-Direction Dynamics Enhancement" class="ltx_ref"><span class="ltx_text ltx_ref_tag">176</span></a>) yields</span></p>
</div>
<div id="A10.Thmtheorem12.p9" class="ltx_para">
<table id="A10.E182" class="ltx_equationgroup ltx_eqn_table">
<tbody>
<tr id="A10.E182X" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A10.E182X.m2" class="ltx_Math" alttext="\displaystyle\frac{d}{dt}W_{t}=" display="inline" intent=":literal"><semantics><mrow><mrow><mstyle displaystyle="true"><mfrac><mi>d</mi><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msub><mi>W</mi><mi>t</mi></msub></mrow><mo>=</mo><mphantom></mphantom></mrow><annotation encoding="application/x-tex">\displaystyle\frac{d}{dt}W_{t}=</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A10.E182X.m3" class="ltx_Math" alttext="\displaystyle-\frac{1}{2}\eta_{t}\chi\beta_{2}\|P_{\mathcal{R}}(z_{t})F(z_{t})^{-1}\nabla f(z_{t})\|_{F(z_{t})}^{2}-\frac{1}{2}\eta_{t}\chi\alpha\|s_{t}\|_{F^{-1}(z_{t})}^{2}." display="inline" intent=":literal"><semantics><mrow><mo>−</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mn>2</mn></mfrac></mstyle><mi>η</mi><msub><mrow></mrow><mi>t</mi></msub><mi>χ</mi><mi>β</mi><msub><mrow></mrow><mn>2</mn></msub><mo lspace="0em" rspace="0.167em">∥</mo><mi>P</mi><msub><mrow></mrow><mi class="ltx_font_mathcaligraphic">ℛ</mi></msub><mo stretchy="false">(</mo><mi>z</mi><msub><mrow></mrow><mi>t</mi></msub><mo stretchy="false">)</mo><mi>F</mi><mo stretchy="false">(</mo><mi>z</mi><msub><mrow></mrow><mi>t</mi></msub><mo rspace="0.167em" stretchy="false">)</mo><msup><mrow></mrow><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo rspace="0.167em">∇</mo><mi>f</mi><mo stretchy="false">(</mo><mi>z</mi><msub><mrow></mrow><mi>t</mi></msub><mo stretchy="false">)</mo><mo lspace="0em" rspace="0em">∥</mo><msub><mrow></mrow><mrow><mi>F</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>z</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow></msub><msup><mrow></mrow><mn>2</mn></msup><mo lspace="0em">−</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mn>2</mn></mfrac></mstyle><mi>η</mi><msub><mrow></mrow><mi>t</mi></msub><mi>χ</mi><mi>α</mi><mo lspace="0em" rspace="0.167em">∥</mo><mi>s</mi><msub><mrow></mrow><mi>t</mi></msub><mo lspace="0em" rspace="0.0835em">∥</mo><msub><mrow></mrow><mrow><msup><mi>F</mi><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>z</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow></msub><msup><mrow></mrow><mn>2</mn></msup><mo lspace="0.0835em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle-\frac{1}{2}\eta_{t}\chi\beta_{2}\|P_{\mathcal{R}}(z_{t})F(z_{t})^{-1}\nabla f(z_{t})\|_{F(z_{t})}^{2}-\frac{1}{2}\eta_{t}\chi\alpha\|s_{t}\|_{F^{-1}(z_{t})}^{2}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equationgroup ltx_align_right">(182)</span></td></tr></tbody>
</table>
<p id="A10.Thmtheorem12.p9.2" class="ltx_p"><span id="A10.Thmtheorem12.p9.2.1" class="ltx_text">where we also uses <math id="A10.Thmtheorem12.p9.m1" class="ltx_Math" alttext="\dot{\eta}_{t}\leq 0" display="inline" intent=":literal"><semantics><mrow><msub><mover accent="true"><mi>η</mi><mo>˙</mo></mover><mi>t</mi></msub><mo>≤</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\dot{\eta}_{t}\leq 0</annotation></semantics></math>. Finally, integrating both sides of (<a href="#A10.E182" title="Equation 182 ‣ Proof. ‣ Lemma J.12. ‣ J.2 Dynamics Analysis ‣ Appendix J Proof ‣ Accelerating LLM Pre-Training through Flat-Direction Dynamics Enhancement" class="ltx_ref"><span class="ltx_text ltx_ref_tag">182</span></a>) from <math id="A10.Thmtheorem12.p9.m2" class="ltx_Math" alttext="0" display="inline" intent=":literal"><semantics><mn>0</mn><annotation encoding="application/x-tex">0</annotation></semantics></math> to <math id="A10.Thmtheorem12.p9.m3" class="ltx_Math" alttext="t" display="inline" intent=":literal"><semantics><mi>t</mi><annotation encoding="application/x-tex">t</annotation></semantics></math> yields the conclusion.</span></p>
</div>
<div id="A10.Thmtheorem12.p10" class="ltx_para">
<p id="A10.Thmtheorem12.p10.1" class="ltx_p"><span id="A10.Thmtheorem12.p10.1.1" class="ltx_text">∎</span></p>
</div>
</div>
</div>
</section>
<section id="A10.SS3" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">J.3 </span>Useful Lemmas</h3>

<div id="A10.Thmtheorem13" class="ltx_theorem ltx_theorem_lemma">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="A10.Thmtheorem13.2" class="ltx_text ltx_font_bold">Lemma J.13</span></span><span id="A10.Thmtheorem13.3" class="ltx_text ltx_font_bold"> </span>(Cauchy’s Inequality)<span id="A10.Thmtheorem13.4" class="ltx_text ltx_font_bold">.</span></h6>
<div id="A10.Thmtheorem13.p1" class="ltx_para">
<p id="A10.Thmtheorem13.p1.1" class="ltx_p"><span id="A10.Thmtheorem13.p1.1.1" class="ltx_text ltx_font_italic">For any vector <math id="A10.Thmtheorem13.p1.m1" class="ltx_Math" alttext="u,v" display="inline" intent=":literal"><semantics><mrow><mi>u</mi><mo>,</mo><mi>v</mi></mrow><annotation encoding="application/x-tex">u,v</annotation></semantics></math> and positive semi-definite matrices <math id="A10.Thmtheorem13.p1.m2" class="ltx_Math" alttext="A" display="inline" intent=":literal"><semantics><mi>A</mi><annotation encoding="application/x-tex">A</annotation></semantics></math> and <math id="A10.Thmtheorem13.p1.m3" class="ltx_Math" alttext="F" display="inline" intent=":literal"><semantics><mi>F</mi><annotation encoding="application/x-tex">F</annotation></semantics></math>, by using <math id="A10.Thmtheorem13.p1.m4" class="ltx_Math" alttext="u^{\top}Av\leq\|A^{\frac{1}{2}}u\|_{2}\|A^{\frac{1}{2}}v\|_{2}\leq\|A\|_{2}\|u\|_{2}\|v\|_{2}" display="inline" intent=":literal"><semantics><mrow><mrow><msup><mi>u</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>A</mi><mo lspace="0em" rspace="0em">​</mo><mi>v</mi></mrow><mo>≤</mo><mrow><msub><mrow><mo stretchy="false">‖</mo><mrow><msup><mi>A</mi><mfrac><mn>1</mn><mn>2</mn></mfrac></msup><mo lspace="0em" rspace="0em">​</mo><mi>u</mi></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">‖</mo><mrow><msup><mi>A</mi><mfrac><mn>1</mn><mn>2</mn></mfrac></msup><mo lspace="0em" rspace="0em">​</mo><mi>v</mi></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn></msub></mrow><mo>≤</mo><mrow><msub><mrow><mo stretchy="false">‖</mo><mi>A</mi><mo stretchy="false">‖</mo></mrow><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">‖</mo><mi>u</mi><mo stretchy="false">‖</mo></mrow><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">‖</mo><mi>v</mi><mo stretchy="false">‖</mo></mrow><mn>2</mn></msub></mrow></mrow><annotation encoding="application/x-tex">u^{\top}Av\leq\|A^{\frac{1}{2}}u\|_{2}\|A^{\frac{1}{2}}v\|_{2}\leq\|A\|_{2}\|u\|_{2}\|v\|_{2}</annotation></semantics></math>, we have</span></p>
<table id="A10.E183" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A10.E183.m1" class="ltx_Math" alttext="u^{\top}Av=u^{\top}F^{\frac{1}{2}}F^{-\frac{1}{2}}AF^{-\frac{1}{2}}F^{\frac{1}{2}}v\leq\|F^{-\frac{1}{2}}AF^{-\frac{1}{2}}\|_{2}\|u\|_{2}\|v\|_{2}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><msup><mi>u</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>A</mi><mo lspace="0em" rspace="0em">​</mo><mi>v</mi></mrow><mo>=</mo><mrow><msup><mi>u</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>F</mi><mfrac><mn>1</mn><mn>2</mn></mfrac></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>F</mi><mrow><mo>−</mo><mfrac><mn>1</mn><mn>2</mn></mfrac></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mi>A</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>F</mi><mrow><mo>−</mo><mfrac><mn>1</mn><mn>2</mn></mfrac></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>F</mi><mfrac><mn>1</mn><mn>2</mn></mfrac></msup><mo lspace="0em" rspace="0em">​</mo><mi>v</mi></mrow><mo>≤</mo><mrow><msub><mrow><mo stretchy="false">‖</mo><mrow><msup><mi>F</mi><mrow><mo>−</mo><mfrac><mn>1</mn><mn>2</mn></mfrac></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mi>A</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>F</mi><mrow><mo>−</mo><mfrac><mn>1</mn><mn>2</mn></mfrac></mrow></msup></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">‖</mo><mi>u</mi><mo stretchy="false">‖</mo></mrow><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">‖</mo><mi>v</mi><mo stretchy="false">‖</mo></mrow><mn>2</mn></msub></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">u^{\top}Av=u^{\top}F^{\frac{1}{2}}F^{-\frac{1}{2}}AF^{-\frac{1}{2}}F^{\frac{1}{2}}v\leq\|F^{-\frac{1}{2}}AF^{-\frac{1}{2}}\|_{2}\|u\|_{2}\|v\|_{2}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(183)</span></td></tr></tbody>
</table>
</div>
</div>
<div id="A10.Thmtheorem14" class="ltx_theorem ltx_theorem_lemma">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="A10.Thmtheorem14.2" class="ltx_text ltx_font_bold">Lemma J.14</span></span><span id="A10.Thmtheorem14.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="A10.Thmtheorem14.p1" class="ltx_para">
<p id="A10.Thmtheorem14.p1.1" class="ltx_p"><span id="A10.Thmtheorem14.p1.1.1" class="ltx_text ltx_font_italic">Let <math id="A10.Thmtheorem14.p1.m1" class="ltx_Math" alttext="a_{t},b_{t}\geq 0" display="inline" intent=":literal"><semantics><mrow><msub><mi>a</mi><mi>t</mi></msub><mo>,</mo><mrow><msub><mi>b</mi><mi>t</mi></msub><mo>≥</mo><mn>0</mn></mrow></mrow><annotation encoding="application/x-tex">a_{t},b_{t}\geq 0</annotation></semantics></math> be real-valued functions defined for <math id="A10.Thmtheorem14.p1.m2" class="ltx_Math" alttext="t\geq 0" display="inline" intent=":literal"><semantics><mrow><mi>t</mi><mo>≥</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">t\geq 0</annotation></semantics></math>. Suppose <math id="A10.Thmtheorem14.p1.m3" class="ltx_Math" alttext="a_{t}" display="inline" intent=":literal"><semantics><msub><mi>a</mi><mi>t</mi></msub><annotation encoding="application/x-tex">a_{t}</annotation></semantics></math> is continuously differentiable and <math id="A10.Thmtheorem14.p1.m4" class="ltx_Math" alttext="b_{t}" display="inline" intent=":literal"><semantics><msub><mi>b</mi><mi>t</mi></msub><annotation encoding="application/x-tex">b_{t}</annotation></semantics></math> is continuous with respect to <math id="A10.Thmtheorem14.p1.m5" class="ltx_Math" alttext="t" display="inline" intent=":literal"><semantics><mi>t</mi><annotation encoding="application/x-tex">t</annotation></semantics></math>. If there exists a constant <math id="A10.Thmtheorem14.p1.m6" class="ltx_Math" alttext="\lambda&gt;0" display="inline" intent=":literal"><semantics><mrow><mi>λ</mi><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\lambda&gt;0</annotation></semantics></math> such that</span></p>
<table id="A10.E184" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A10.E184.m1" class="ltx_Math" alttext="\frac{d}{dt}a_{t}\leq-\lambda a_{t}+\sqrt{a_{t}}\sqrt{b_{t}}," display="block" intent=":literal"><semantics><mrow><mrow><mrow><mfrac><mi>d</mi><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></mfrac><mo lspace="0em" rspace="0em">​</mo><msub><mi>a</mi><mi>t</mi></msub></mrow><mo>≤</mo><mrow><mrow><mo>−</mo><mrow><mi>λ</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>a</mi><mi>t</mi></msub></mrow></mrow><mo>+</mo><mrow><msqrt><msub><mi>a</mi><mi>t</mi></msub></msqrt><mo lspace="0em" rspace="0em">​</mo><msqrt><msub><mi>b</mi><mi>t</mi></msub></msqrt></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\frac{d}{dt}a_{t}\leq-\lambda a_{t}+\sqrt{a_{t}}\sqrt{b_{t}},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(184)</span></td></tr></tbody>
</table>
<p id="A10.Thmtheorem14.p1.2" class="ltx_p"><span id="A10.Thmtheorem14.p1.2.1" class="ltx_text ltx_font_italic">then for all <math id="A10.Thmtheorem14.p1.m7" class="ltx_Math" alttext="t\geq 0" display="inline" intent=":literal"><semantics><mrow><mi>t</mi><mo>≥</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">t\geq 0</annotation></semantics></math>,</span></p>
<table id="A10.E185" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A10.E185.m1" class="ltx_Math" alttext="\sqrt{a_{t}}\leq e^{-\frac{\lambda}{2}t}\sqrt{a_{0}}+\frac{1}{2}\int_{0}^{t}e^{-\frac{\lambda}{2}(t-s)}\sqrt{b_{s}}ds." display="block" intent=":literal"><semantics><mrow><mrow><msqrt><msub><mi>a</mi><mi>t</mi></msub></msqrt><mo>≤</mo><mrow><mrow><msup><mi>e</mi><mrow><mo>−</mo><mrow><mfrac><mi>λ</mi><mn>2</mn></mfrac><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msqrt><msub><mi>a</mi><mn>0</mn></msub></msqrt></mrow><mo>+</mo><mrow><mfrac><mn>1</mn><mn>2</mn></mfrac><mo lspace="0em" rspace="0em">​</mo><mrow><msubsup><mo>∫</mo><mn>0</mn><mi>t</mi></msubsup><mrow><msup><mi>e</mi><mrow><mo>−</mo><mrow><mfrac><mi>λ</mi><mn>2</mn></mfrac><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>t</mi><mo>−</mo><mi>s</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msqrt><msub><mi>b</mi><mi>s</mi></msub></msqrt><mo lspace="0em" rspace="0em">​</mo><mrow><mo rspace="0em">𝑑</mo><mi>s</mi></mrow></mrow></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\sqrt{a_{t}}\leq e^{-\frac{\lambda}{2}t}\sqrt{a_{0}}+\frac{1}{2}\int_{0}^{t}e^{-\frac{\lambda}{2}(t-s)}\sqrt{b_{s}}ds.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(185)</span></td></tr></tbody>
</table>
</div>
<div id="A10.Thmtheorem14.4" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="A10.Thmtheorem14.p2" class="ltx_para">
<p id="A10.Thmtheorem14.p2.1" class="ltx_p"><span id="A10.Thmtheorem14.p2.1.1" class="ltx_text">Let <math id="A10.Thmtheorem14.p2.m1" class="ltx_Math" alttext="\delta&gt;0" display="inline" intent=":literal"><semantics><mrow><mi>δ</mi><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\delta&gt;0</annotation></semantics></math> be an arbitrary small constant. Define a perturbed variable <math id="A10.Thmtheorem14.p2.m2" class="ltx_Math" alttext="y_{t}" display="inline" intent=":literal"><semantics><msub><mi>y</mi><mi>t</mi></msub><annotation encoding="application/x-tex">y_{t}</annotation></semantics></math> as <math id="A10.Thmtheorem14.p2.m3" class="ltx_Math" alttext="y_{t}=\sqrt{a_{t}+\delta}" display="inline" intent=":literal"><semantics><mrow><msub><mi>y</mi><mi>t</mi></msub><mo>=</mo><msqrt><mrow><msub><mi>a</mi><mi>t</mi></msub><mo>+</mo><mi>δ</mi></mrow></msqrt></mrow><annotation encoding="application/x-tex">y_{t}=\sqrt{a_{t}+\delta}</annotation></semantics></math>. Since <math id="A10.Thmtheorem14.p2.m4" class="ltx_Math" alttext="a_{t}\geq 0" display="inline" intent=":literal"><semantics><mrow><msub><mi>a</mi><mi>t</mi></msub><mo>≥</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">a_{t}\geq 0</annotation></semantics></math>, we have <math id="A10.Thmtheorem14.p2.m5" class="ltx_Math" alttext="y_{t}\geq\sqrt{\delta}&gt;0" display="inline" intent=":literal"><semantics><mrow><msub><mi>y</mi><mi>t</mi></msub><mo>≥</mo><msqrt><mi>δ</mi></msqrt><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">y_{t}\geq\sqrt{\delta}&gt;0</annotation></semantics></math> for all <math id="A10.Thmtheorem14.p2.m6" class="ltx_Math" alttext="t" display="inline" intent=":literal"><semantics><mi>t</mi><annotation encoding="application/x-tex">t</annotation></semantics></math>. Thus, <math id="A10.Thmtheorem14.p2.m7" class="ltx_Math" alttext="y_{t}" display="inline" intent=":literal"><semantics><msub><mi>y</mi><mi>t</mi></msub><annotation encoding="application/x-tex">y_{t}</annotation></semantics></math> is continuously differentiable. Substituting <math id="A10.Thmtheorem14.p2.m8" class="ltx_Math" alttext="\frac{d}{dt}y_{t}" display="inline" intent=":literal"><semantics><mrow><mfrac><mi>d</mi><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></mfrac><mo lspace="0em" rspace="0em">​</mo><msub><mi>y</mi><mi>t</mi></msub></mrow><annotation encoding="application/x-tex">\frac{d}{dt}y_{t}</annotation></semantics></math> into (<a href="#A10.E184" title="Equation 184 ‣ Lemma J.14. ‣ J.3 Useful Lemmas ‣ Appendix J Proof ‣ Accelerating LLM Pre-Training through Flat-Direction Dynamics Enhancement" class="ltx_ref"><span class="ltx_text ltx_ref_tag">184</span></a>) gives</span></p>
</div>
<div id="A10.Thmtheorem14.p3" class="ltx_para">
<table id="A10.E186" class="ltx_equationgroup ltx_eqn_table">
<tbody>
<tr id="A10.E186X" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A10.E186X.m2" class="ltx_Math" alttext="\displaystyle\frac{d}{dt}{y}_{t}\leq" display="inline" intent=":literal"><semantics><mrow><mrow><mstyle displaystyle="true"><mfrac><mi>d</mi><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msub><mi>y</mi><mi>t</mi></msub></mrow><mo>≤</mo><mphantom></mphantom></mrow><annotation encoding="application/x-tex">\displaystyle\frac{d}{dt}{y}_{t}\leq</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A10.E186X.m3" class="ltx_Math" alttext="\displaystyle-\frac{\lambda}{2}y_{t}+\frac{\lambda\delta}{2y_{t}}+\frac{\sqrt{b_{t}}}{2}\frac{\sqrt{y_{t}^{2}-\delta}}{y_{t}}\leq-\frac{\lambda}{2}y_{t}+\frac{\sqrt{b_{t}}}{2}+\frac{\lambda\sqrt{\delta}}{2}." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mrow><mo>−</mo><mrow><mstyle displaystyle="true"><mfrac><mi>λ</mi><mn>2</mn></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msub><mi>y</mi><mi>t</mi></msub></mrow></mrow><mo>+</mo><mstyle displaystyle="true"><mfrac><mrow><mi>λ</mi><mo lspace="0em" rspace="0em">​</mo><mi>δ</mi></mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>y</mi><mi>t</mi></msub></mrow></mfrac></mstyle><mo>+</mo><mrow><mstyle displaystyle="true"><mfrac><msqrt><msub><mi>b</mi><mi>t</mi></msub></msqrt><mn>2</mn></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><msqrt><mrow><msubsup><mi>y</mi><mi>t</mi><mn>2</mn></msubsup><mo>−</mo><mi>δ</mi></mrow></msqrt><msub><mi>y</mi><mi>t</mi></msub></mfrac></mstyle></mrow></mrow><mo>≤</mo><mrow><mrow><mo>−</mo><mrow><mstyle displaystyle="true"><mfrac><mi>λ</mi><mn>2</mn></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msub><mi>y</mi><mi>t</mi></msub></mrow></mrow><mo>+</mo><mstyle displaystyle="true"><mfrac><msqrt><msub><mi>b</mi><mi>t</mi></msub></msqrt><mn>2</mn></mfrac></mstyle><mo>+</mo><mstyle displaystyle="true"><mfrac><mrow><mi>λ</mi><mo lspace="0em" rspace="0em">​</mo><msqrt><mi>δ</mi></msqrt></mrow><mn>2</mn></mfrac></mstyle></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle-\frac{\lambda}{2}y_{t}+\frac{\lambda\delta}{2y_{t}}+\frac{\sqrt{b_{t}}}{2}\frac{\sqrt{y_{t}^{2}-\delta}}{y_{t}}\leq-\frac{\lambda}{2}y_{t}+\frac{\sqrt{b_{t}}}{2}+\frac{\lambda\sqrt{\delta}}{2}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equationgroup ltx_align_right">(186)</span></td></tr></tbody>
</table>
<p id="A10.Thmtheorem14.p3.1" class="ltx_p"><span id="A10.Thmtheorem14.p3.1.1" class="ltx_text">It follows that</span></p>
</div>
<div id="A10.Thmtheorem14.p4" class="ltx_para">
<table id="A10.E187" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A10.E187.m1" class="ltx_Math" alttext="\frac{d}{dt}\left(e^{\frac{\lambda}{2}t}y_{t}\right)\leq e^{\frac{\lambda}{2}t}\left(\frac{\sqrt{b_{t}}}{2}+\frac{\lambda\sqrt{\delta}}{2}\right)." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mfrac><mi>d</mi><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></mfrac><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><msup><mi>e</mi><mrow><mfrac><mi>λ</mi><mn>2</mn></mfrac><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>y</mi><mi>t</mi></msub></mrow><mo>)</mo></mrow></mrow><mo>≤</mo><mrow><msup><mi>e</mi><mrow><mfrac><mi>λ</mi><mn>2</mn></mfrac><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mfrac><msqrt><msub><mi>b</mi><mi>t</mi></msub></msqrt><mn>2</mn></mfrac><mo>+</mo><mfrac><mrow><mi>λ</mi><mo lspace="0em" rspace="0em">​</mo><msqrt><mi>δ</mi></msqrt></mrow><mn>2</mn></mfrac></mrow><mo>)</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\frac{d}{dt}\left(e^{\frac{\lambda}{2}t}y_{t}\right)\leq e^{\frac{\lambda}{2}t}\left(\frac{\sqrt{b_{t}}}{2}+\frac{\lambda\sqrt{\delta}}{2}\right).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(187)</span></td></tr></tbody>
</table>
<p id="A10.Thmtheorem14.p4.1" class="ltx_p"><span id="A10.Thmtheorem14.p4.1.1" class="ltx_text">Integrating from <math id="A10.Thmtheorem14.p4.m1" class="ltx_Math" alttext="0" display="inline" intent=":literal"><semantics><mn>0</mn><annotation encoding="application/x-tex">0</annotation></semantics></math> to <math id="A10.Thmtheorem14.p4.m2" class="ltx_Math" alttext="t" display="inline" intent=":literal"><semantics><mi>t</mi><annotation encoding="application/x-tex">t</annotation></semantics></math> yields:</span></p>
<table id="A10.E188" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A10.E188.m1" class="ltx_Math" alttext="y_{t}\leq e^{-\frac{\lambda}{2}t}y_{0}+\frac{1}{2}\int_{0}^{t}e^{-\frac{\lambda}{2}(t-s)}\sqrt{b_{s}}\,ds+\frac{\lambda\sqrt{\delta}}{2}\int_{0}^{t}e^{-\frac{\lambda}{2}(t-s)}ds." display="block" intent=":literal"><semantics><mrow><mrow><msub><mi>y</mi><mi>t</mi></msub><mo>≤</mo><mrow><mrow><msup><mi>e</mi><mrow><mo>−</mo><mrow><mfrac><mi>λ</mi><mn>2</mn></mfrac><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>y</mi><mn>0</mn></msub></mrow><mo>+</mo><mrow><mfrac><mn>1</mn><mn>2</mn></mfrac><mo lspace="0em" rspace="0em">​</mo><mrow><msubsup><mo>∫</mo><mn>0</mn><mi>t</mi></msubsup><mrow><msup><mi>e</mi><mrow><mo>−</mo><mrow><mfrac><mi>λ</mi><mn>2</mn></mfrac><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>t</mi><mo>−</mo><mi>s</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msqrt><msub><mi>b</mi><mi>s</mi></msub></msqrt><mo lspace="0.170em" rspace="0em">​</mo><mrow><mo rspace="0em">𝑑</mo><mi>s</mi></mrow></mrow></mrow></mrow><mo>+</mo><mrow><mfrac><mrow><mi>λ</mi><mo lspace="0em" rspace="0em">​</mo><msqrt><mi>δ</mi></msqrt></mrow><mn>2</mn></mfrac><mo lspace="0em" rspace="0em">​</mo><mrow><msubsup><mo>∫</mo><mn>0</mn><mi>t</mi></msubsup><mrow><msup><mi>e</mi><mrow><mo>−</mo><mrow><mfrac><mi>λ</mi><mn>2</mn></mfrac><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>t</mi><mo>−</mo><mi>s</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo rspace="0em">𝑑</mo><mi>s</mi></mrow></mrow></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">y_{t}\leq e^{-\frac{\lambda}{2}t}y_{0}+\frac{1}{2}\int_{0}^{t}e^{-\frac{\lambda}{2}(t-s)}\sqrt{b_{s}}\,ds+\frac{\lambda\sqrt{\delta}}{2}\int_{0}^{t}e^{-\frac{\lambda}{2}(t-s)}ds.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(188)</span></td></tr></tbody>
</table>
<p id="A10.Thmtheorem14.p4.2" class="ltx_p"><span id="A10.Thmtheorem14.p4.2.1" class="ltx_text">Take the limit as <math id="A10.Thmtheorem14.p4.m3" class="ltx_Math" alttext="\delta\to 0" display="inline" intent=":literal"><semantics><mrow><mi>δ</mi><mo stretchy="false">→</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\delta\to 0</annotation></semantics></math>, we get the conclusion.</span></p>
</div>
<div id="A10.Thmtheorem14.p5" class="ltx_para">
<p id="A10.Thmtheorem14.p5.1" class="ltx_p"><span id="A10.Thmtheorem14.p5.1.1" class="ltx_text">∎</span></p>
</div>
</div>
<div id="A10.Thmtheorem15" class="ltx_theorem ltx_theorem_remark">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="A10.Thmtheorem15.2" class="ltx_text ltx_font_italic">Remark J.15</span></span><span id="A10.Thmtheorem15.3" class="ltx_text ltx_font_italic">.</span></h6>
<div id="A10.Thmtheorem15.p1" class="ltx_para">
<p id="A10.Thmtheorem15.p1.1" class="ltx_p">It seems natural to divide the inequality (<a href="#A10.E184" title="Equation 184 ‣ Lemma J.14. ‣ J.3 Useful Lemmas ‣ Appendix J Proof ‣ Accelerating LLM Pre-Training through Flat-Direction Dynamics Enhancement" class="ltx_ref"><span class="ltx_text ltx_ref_tag">184</span></a>) by <math id="A10.Thmtheorem15.p1.m1" class="ltx_Math" alttext="\sqrt{a_{t}}" display="inline" intent=":literal"><semantics><msqrt><msub><mi>a</mi><mi>t</mi></msub></msqrt><annotation encoding="application/x-tex">\sqrt{a_{t}}</annotation></semantics></math> and consider <math id="A10.Thmtheorem15.p1.m2" class="ltx_Math" alttext="\frac{d}{dt}\sqrt{a_{t}}" display="inline" intent=":literal"><semantics><mrow><mfrac><mi>d</mi><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></mfrac><mo lspace="0em" rspace="0em">​</mo><msqrt><msub><mi>a</mi><mi>t</mi></msub></msqrt></mrow><annotation encoding="application/x-tex">\frac{d}{dt}\sqrt{a_{t}}</annotation></semantics></math>. However, direct differentiation of <math id="A10.Thmtheorem15.p1.m3" class="ltx_Math" alttext="\sqrt{a_{t}}" display="inline" intent=":literal"><semantics><msqrt><msub><mi>a</mi><mi>t</mi></msub></msqrt><annotation encoding="application/x-tex">\sqrt{a_{t}}</annotation></semantics></math> is not well-defined when <math id="A10.Thmtheorem15.p1.m4" class="ltx_Math" alttext="a_{t}=0" display="inline" intent=":literal"><semantics><mrow><msub><mi>a</mi><mi>t</mi></msub><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">a_{t}=0</annotation></semantics></math>. To handle this singularity strictly, we introduce a regularization term <math id="A10.Thmtheorem15.p1.m5" class="ltx_Math" alttext="\delta" display="inline" intent=":literal"><semantics><mi>δ</mi><annotation encoding="application/x-tex">\delta</annotation></semantics></math>.</p>
</div>
</div>
<div id="A10.Thmtheorem16" class="ltx_theorem ltx_theorem_lemma">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="A10.Thmtheorem16.2" class="ltx_text ltx_font_bold">Lemma J.16</span></span><span id="A10.Thmtheorem16.3" class="ltx_text ltx_font_bold"> </span>(Gronwall’s Inequality)<span id="A10.Thmtheorem16.4" class="ltx_text ltx_font_bold">.</span></h6>
<div id="A10.Thmtheorem16.p1" class="ltx_para">
<p id="A10.Thmtheorem16.p1.1" class="ltx_p"><span id="A10.Thmtheorem16.p1.1.1" class="ltx_text ltx_font_italic">Let <math id="A10.Thmtheorem16.p1.m1" class="ltx_Math" alttext="u_{t},\alpha_{t}" display="inline" intent=":literal"><semantics><mrow><msub><mi>u</mi><mi>t</mi></msub><mo>,</mo><msub><mi>α</mi><mi>t</mi></msub></mrow><annotation encoding="application/x-tex">u_{t},\alpha_{t}</annotation></semantics></math> and <math id="A10.Thmtheorem16.p1.m2" class="ltx_Math" alttext="\beta_{t}\geq 0" display="inline" intent=":literal"><semantics><mrow><msub><mi>β</mi><mi>t</mi></msub><mo>≥</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\beta_{t}\geq 0</annotation></semantics></math> be continuous functions for <math id="A10.Thmtheorem16.p1.m3" class="ltx_Math" alttext="t\geq 0" display="inline" intent=":literal"><semantics><mrow><mi>t</mi><mo>≥</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">t\geq 0</annotation></semantics></math>. If</span></p>
<table id="A10.E189" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A10.E189.m1" class="ltx_Math" alttext="u_{t}\leq\alpha_{t}+\int_{0}^{t}\beta_{s}u_{s}ds," display="block" intent=":literal"><semantics><mrow><mrow><msub><mi>u</mi><mi>t</mi></msub><mo>≤</mo><mrow><msub><mi>α</mi><mi>t</mi></msub><mo rspace="0.055em">+</mo><mrow><msubsup><mo>∫</mo><mn>0</mn><mi>t</mi></msubsup><mrow><msub><mi>β</mi><mi>s</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>u</mi><mi>s</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo rspace="0em">𝑑</mo><mi>s</mi></mrow></mrow></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">u_{t}\leq\alpha_{t}+\int_{0}^{t}\beta_{s}u_{s}ds,</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(189)</span></td></tr></tbody>
</table>
<p id="A10.Thmtheorem16.p1.2" class="ltx_p"><span id="A10.Thmtheorem16.p1.2.1" class="ltx_text ltx_font_italic">then</span></p>
<table id="A10.E190" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A10.E190.m1" class="ltx_Math" alttext="u_{t}\leq\alpha_{t}+\int_{0}^{t}\alpha_{s}\beta_{s}\exp\left(\int_{s}^{t}\beta_{\tau}d\tau\right)ds." display="block" intent=":literal"><semantics><mrow><mrow><msub><mi>u</mi><mi>t</mi></msub><mo>≤</mo><mrow><msub><mi>α</mi><mi>t</mi></msub><mo rspace="0.055em">+</mo><mrow><msubsup><mo>∫</mo><mn>0</mn><mi>t</mi></msubsup><mrow><msub><mi>α</mi><mi>s</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>β</mi><mi>s</mi></msub><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><msubsup><mo lspace="0em">∫</mo><mi>s</mi><mi>t</mi></msubsup><mrow><msub><mi>β</mi><mi>τ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo rspace="0em">𝑑</mo><mi>τ</mi></mrow></mrow></mrow><mo>)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo rspace="0em">𝑑</mo><mi>s</mi></mrow></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">u_{t}\leq\alpha_{t}+\int_{0}^{t}\alpha_{s}\beta_{s}\exp\left(\int_{s}^{t}\beta_{\tau}d\tau\right)ds.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(190)</span></td></tr></tbody>
</table>
<p id="A10.Thmtheorem16.p1.3" class="ltx_p"><span id="A10.Thmtheorem16.p1.3.1" class="ltx_text ltx_font_italic">Additionally, of <math id="A10.Thmtheorem16.p1.m4" class="ltx_Math" alttext="\alpha_{t}" display="inline" intent=":literal"><semantics><msub><mi>α</mi><mi>t</mi></msub><annotation encoding="application/x-tex">\alpha_{t}</annotation></semantics></math> is non-decreasing, then</span></p>
<table id="A10.E191" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A10.E191.m1" class="ltx_Math" alttext="u_{t}\leq\alpha_{t}\exp\left(\int_{0}^{t}\beta_{\tau}d\tau\right)." display="block" intent=":literal"><semantics><mrow><mrow><msub><mi>u</mi><mi>t</mi></msub><mo>≤</mo><mrow><msub><mi>α</mi><mi>t</mi></msub><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><msubsup><mo lspace="0em">∫</mo><mn>0</mn><mi>t</mi></msubsup><mrow><msub><mi>β</mi><mi>τ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo rspace="0em">𝑑</mo><mi>τ</mi></mrow></mrow></mrow><mo>)</mo></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">u_{t}\leq\alpha_{t}\exp\left(\int_{0}^{t}\beta_{\tau}d\tau\right).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(191)</span></td></tr></tbody>
</table>
</div>
</div>
<div id="A10.Thmtheorem17" class="ltx_theorem ltx_theorem_lemma">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="A10.Thmtheorem17.2" class="ltx_text ltx_font_bold">Lemma J.17</span></span><span id="A10.Thmtheorem17.3" class="ltx_text ltx_font_bold"> </span>(Wedin <math id="A10.Thmtheorem17.m1" class="ltx_Math" alttext="\sin(\Theta)" display="inline" intent=":literal"><semantics><mrow><mi>sin</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi mathvariant="normal">Θ</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\sin(\Theta)</annotation></semantics></math> Theorem)<span id="A10.Thmtheorem17.4" class="ltx_text ltx_font_bold">.</span></h6>
<div id="A10.Thmtheorem17.p1" class="ltx_para">
<p id="A10.Thmtheorem17.p1.1" class="ltx_p"><span id="A10.Thmtheorem17.p1.1.1" class="ltx_text ltx_font_italic">Let <math id="A10.Thmtheorem17.p1.m1" class="ltx_Math" alttext="M" display="inline" intent=":literal"><semantics><mi>M</mi><annotation encoding="application/x-tex">M</annotation></semantics></math> and <math id="A10.Thmtheorem17.p1.m2" class="ltx_Math" alttext="N" display="inline" intent=":literal"><semantics><mi>N</mi><annotation encoding="application/x-tex">N</annotation></semantics></math> be two matrices with singular values <math id="A10.Thmtheorem17.p1.m3" class="ltx_Math" alttext="\sigma_{1},\dots,\sigma_{n}" display="inline" intent=":literal"><semantics><mrow><msub><mi>σ</mi><mn>1</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>σ</mi><mi>n</mi></msub></mrow><annotation encoding="application/x-tex">\sigma_{1},\dots,\sigma_{n}</annotation></semantics></math> and <math id="A10.Thmtheorem17.p1.m4" class="ltx_Math" alttext="\tilde{\sigma}_{1},\dots,\tilde{\sigma}_{n}" display="inline" intent=":literal"><semantics><mrow><msub><mover accent="true"><mi>σ</mi><mo>~</mo></mover><mn>1</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mover accent="true"><mi>σ</mi><mo>~</mo></mover><mi>n</mi></msub></mrow><annotation encoding="application/x-tex">\tilde{\sigma}_{1},\dots,\tilde{\sigma}_{n}</annotation></semantics></math>, respectively.
Denote by <math id="A10.Thmtheorem17.p1.m5" class="ltx_Math" alttext="U_{M},V_{M}" display="inline" intent=":literal"><semantics><mrow><msub><mi>U</mi><mi>M</mi></msub><mo>,</mo><msub><mi>V</mi><mi>M</mi></msub></mrow><annotation encoding="application/x-tex">U_{M},V_{M}</annotation></semantics></math> the first <math id="A10.Thmtheorem17.p1.m6" class="ltx_Math" alttext="k" display="inline" intent=":literal"><semantics><mi>k</mi><annotation encoding="application/x-tex">k</annotation></semantics></math> left and right singular vectors of <math id="A10.Thmtheorem17.p1.m7" class="ltx_Math" alttext="M" display="inline" intent=":literal"><semantics><mi>M</mi><annotation encoding="application/x-tex">M</annotation></semantics></math>, and by <math id="A10.Thmtheorem17.p1.m8" class="ltx_Math" alttext="U_{N},V_{N}" display="inline" intent=":literal"><semantics><mrow><msub><mi>U</mi><mi>N</mi></msub><mo>,</mo><msub><mi>V</mi><mi>N</mi></msub></mrow><annotation encoding="application/x-tex">U_{N},V_{N}</annotation></semantics></math> those of <math id="A10.Thmtheorem17.p1.m9" class="ltx_Math" alttext="N" display="inline" intent=":literal"><semantics><mi>N</mi><annotation encoding="application/x-tex">N</annotation></semantics></math>. Suppose there exists <math id="A10.Thmtheorem17.p1.m10" class="ltx_Math" alttext="\alpha&gt;0" display="inline" intent=":literal"><semantics><mrow><mi>α</mi><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\alpha&gt;0</annotation></semantics></math> such that</span></p>
<table id="A10.Ex9" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A10.Ex9.m1" class="ltx_Math" alttext="\alpha\leq\min_{1\leq i\leq k}\sigma_{i}-\max_{k+1\leq r\leq n}\tilde{\sigma}_{r}." display="block" intent=":literal"><semantics><mrow><mrow><mi>α</mi><mo>≤</mo><mrow><mrow><munder><mi>min</mi><mrow><mn>1</mn><mo>≤</mo><mi>i</mi><mo>≤</mo><mi>k</mi></mrow></munder><mo lspace="0.167em">⁡</mo><msub><mi>σ</mi><mi>i</mi></msub></mrow><mo>−</mo><mrow><munder><mi>max</mi><mrow><mrow><mi>k</mi><mo>+</mo><mn>1</mn></mrow><mo>≤</mo><mi>r</mi><mo>≤</mo><mi>n</mi></mrow></munder><mo lspace="0.167em">⁡</mo><msub><mover accent="true"><mi>σ</mi><mo>~</mo></mover><mi>r</mi></msub></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\alpha\leq\min_{1\leq i\leq k}\sigma_{i}-\max_{k+1\leq r\leq n}\tilde{\sigma}_{r}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A10.Thmtheorem17.p1.2" class="ltx_p"><span id="A10.Thmtheorem17.p1.2.1" class="ltx_text ltx_font_italic">Then</span></p>
<table id="A10.Ex10" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A10.Ex10.m1" class="ltx_Math" alttext="\max\bigl\{\|U_{M}-U_{N}\|_{2},\;\|V_{M}-V_{N}\|_{2}\bigr\}\leq\frac{\bigl\|M-N\bigr\|_{2}}{\alpha}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mi>max</mi><mo>⁡</mo><mrow><mo stretchy="false">{</mo><msub><mrow><mo stretchy="false">‖</mo><mrow><msub><mi>U</mi><mi>M</mi></msub><mo>−</mo><msub><mi>U</mi><mi>N</mi></msub></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn></msub><mo rspace="0.447em">,</mo><msub><mrow><mo stretchy="false">‖</mo><mrow><msub><mi>V</mi><mi>M</mi></msub><mo>−</mo><msub><mi>V</mi><mi>N</mi></msub></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn></msub><mo stretchy="false">}</mo></mrow></mrow><mo>≤</mo><mfrac><msub><mrow><mo maxsize="1.200em" minsize="1.200em" stretchy="true">‖</mo><mrow><mi>M</mi><mo>−</mo><mi>N</mi></mrow><mo maxsize="1.200em" minsize="1.200em" stretchy="true">‖</mo></mrow><mn>2</mn></msub><mi>α</mi></mfrac></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\max\bigl\{\|U_{M}-U_{N}\|_{2},\;\|V_{M}-V_{N}\|_{2}\bigr\}\leq\frac{\bigl\|M-N\bigr\|_{2}}{\alpha}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
</div>
</div>
</section>
