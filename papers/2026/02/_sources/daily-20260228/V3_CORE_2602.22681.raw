<tr id="A10.E179X" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A10.E179X.m2" class="ltx_Math" alttext="\displaystyle A\overset{\eqref{condition-deltafs-river-flow}}{\leq}" display="inline" intent=":literal"><semantics><mrow><mi>A</mi><mo lspace="0em" rspace="0em">​</mo><mover accent="true"><mo>≤</mo><mrow><mtext mathsize="0.700em">(</mtext><mtext mathsize="0.700em"><a href="#A10.E173" title="Equation 173 ‣ Lemma J.12. ‣ J.2 Dynamics Analysis ‣ Appendix J Proof ‣ Accelerating LLM Pre-Training through Flat-Direction Dynamics Enhancement" class="ltx_ref" style="font-size:70%;"><span class="ltx_text ltx_ref_tag">173</span></a></mtext><mtext mathsize="0.700em">)</mtext></mrow></mover></mrow><annotation encoding="application/x-tex">\displaystyle A\overset{\eqref{condition-deltafs-river-flow}}{\leq}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A10.E179X.m3" class="ltx_Math" alttext="\displaystyle 2\frac{\delta_{F_{s}}}{\lambda_{H_{F,s}}}\eta_{t}\chi\|P_{\mathcal{R}}(z_{t})F(z_{t})^{-1}\nabla f(z_{t})\|_{F(z_{t})}\|s_{t}\|_{F^{-1}(z_{t})}" display="inline" intent=":literal"><semantics><mrow><mn>2</mn><mstyle displaystyle="true"><mfrac><msub><mi>δ</mi><msub><mi>F</mi><mi>s</mi></msub></msub><msub><mi>λ</mi><msub><mi>H</mi><mrow><mi>F</mi><mo>,</mo><mi>s</mi></mrow></msub></msub></mfrac></mstyle><mi>η</mi><msub><mrow></mrow><mi>t</mi></msub><mi>χ</mi><mo lspace="0em" rspace="0.167em">∥</mo><mi>P</mi><msub><mrow></mrow><mi class="ltx_font_mathcaligraphic">ℛ</mi></msub><mo stretchy="false">(</mo><mi>z</mi><msub><mrow></mrow><mi>t</mi></msub><mo stretchy="false">)</mo><mi>F</mi><mo stretchy="false">(</mo><mi>z</mi><msub><mrow></mrow><mi>t</mi></msub><mo rspace="0.167em" stretchy="false">)</mo><msup><mrow></mrow><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo rspace="0.167em">∇</mo><mi>f</mi><mo stretchy="false">(</mo><mi>z</mi><msub><mrow></mrow><mi>t</mi></msub><mo stretchy="false">)</mo><mo lspace="0em" rspace="0.0835em">∥</mo><msub><mrow></mrow><mrow><mi>F</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>z</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow></msub><mo lspace="0.0835em" rspace="0.167em">∥</mo><mi>s</mi><msub><mrow></mrow><mi>t</mi></msub><mo lspace="0em">∥</mo><msub><mrow></mrow><mrow><msup><mi>F</mi><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>z</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow></msub></mrow><annotation encoding="application/x-tex">\displaystyle 2\frac{\delta_{F_{s}}}{\lambda_{H_{F,s}}}\eta_{t}\chi\|P_{\mathcal{R}}(z_{t})F(z_{t})^{-1}\nabla f(z_{t})\|_{F(z_{t})}\|s_{t}\|_{F^{-1}(z_{t})}</annotation></semantics></math></td>
