<div id="A10.Thmtheorem10.p7" class="ltx_para">
<p id="A10.Thmtheorem10.p7.2" class="ltx_p"><span id="A10.Thmtheorem10.p7.2.1" class="ltx_text">By (<a href="#A10.E137" title="Equation 137 ‣ Proof. ‣ Lemma J.8. ‣ J.2 Dynamics Analysis ‣ Appendix J Proof ‣ Accelerating LLM Pre-Training through Flat-Direction Dynamics Enhancement" class="ltx_ref"><span class="ltx_text ltx_ref_tag">137</span></a>), we have</span></p>
<table id="A10.E158" class="ltx_equationgroup ltx_eqn_table">
<tbody>
<tr id="A10.E158X" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A10.E158X.m2" class="ltx_Math" alttext="\displaystyle\|a\|_{2}\leq" display="inline" intent=":literal"><semantics><mrow><msub><mrow><mo stretchy="false">‖</mo><mi>a</mi><mo stretchy="false">‖</mo></mrow><mn>2</mn></msub><mo>≤</mo><mphantom></mphantom></mrow><annotation encoding="application/x-tex">\displaystyle\|a\|_{2}\leq</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A10.E158X.m3" class="ltx_Math" alttext="\displaystyle\lambda_{F}^{-\frac{1}{2}}\|a\|_{F(z_{t})}\leq\lambda_{F}^{-\frac{1}{2}}\|F_{s}^{\dagger}(w_{t})m_{t}-F_{s}^{\dagger}(z_{t})s_{t}\|_{F(z_{t})}\leq\kappa_{F}^{\frac{1}{2}}\|F_{s}^{\dagger}(w_{t})m_{t}-F_{s}^{\dagger}(z_{t})s_{t}\|_{2}" display="inline" intent=":literal"><semantics><mrow><mrow><msubsup><mi>λ</mi><mi>F</mi><mrow><mo>−</mo><mfrac><mn>1</mn><mn>2</mn></mfrac></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">‖</mo><mi>a</mi><mo stretchy="false">‖</mo></mrow><mrow><mi>F</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>z</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow></msub></mrow><mo>≤</mo><mrow><msubsup><mi>λ</mi><mi>F</mi><mrow><mo>−</mo><mfrac><mn>1</mn><mn>2</mn></mfrac></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">‖</mo><mrow><mrow><msubsup><mi>F</mi><mi>s</mi><mo>†</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>w</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>m</mi><mi>t</mi></msub></mrow><mo>−</mo><mrow><msubsup><mi>F</mi><mi>s</mi><mo>†</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>z</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>s</mi><mi>t</mi></msub></mrow></mrow><mo stretchy="false">‖</mo></mrow><mrow><mi>F</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>z</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow></msub></mrow><mo>≤</mo><mrow><msubsup><mi>κ</mi><mi>F</mi><mfrac><mn>1</mn><mn>2</mn></mfrac></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">‖</mo><mrow><mrow><msubsup><mi>F</mi><mi>s</mi><mo>†</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>w</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>m</mi><mi>t</mi></msub></mrow><mo>−</mo><mrow><msubsup><mi>F</mi><mi>s</mi><mo>†</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>z</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>s</mi><mi>t</mi></msub></mrow></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn></msub></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\lambda_{F}^{-\frac{1}{2}}\|a\|_{F(z_{t})}\leq\lambda_{F}^{-\frac{1}{2}}\|F_{s}^{\dagger}(w_{t})m_{t}-F_{s}^{\dagger}(z_{t})s_{t}\|_{F(z_{t})}\leq\kappa_{F}^{\frac{1}{2}}\|F_{s}^{\dagger}(w_{t})m_{t}-F_{s}^{\dagger}(z_{t})s_{t}\|_{2}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="2" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equationgroup ltx_align_right">(158)</span></td></tr>
<tr id="A10.E158Xa" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A10.E158Xa.m2" class="ltx_Math" alttext="\displaystyle\overset{\eqref{s-Fm-Fs}}{\leq}" display="inline" intent=":literal"><semantics><mover accent="true"><mo>≤</mo><mrow><mtext mathsize="0.700em">(</mtext><mtext mathsize="0.700em"><a href="#A10.E153" title="Equation 153 ‣ Proof. ‣ Lemma J.10. ‣ J.2 Dynamics Analysis ‣ Appendix J Proof ‣ Accelerating LLM Pre-Training through Flat-Direction Dynamics Enhancement" class="ltx_ref" style="font-size:70%;"><span class="ltx_text ltx_ref_tag">153</span></a></mtext><mtext mathsize="0.700em">)</mtext></mrow></mover><annotation encoding="application/x-tex">\displaystyle\overset{\eqref{s-Fm-Fs}}{\leq}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A10.E158Xa.m3" class="ltx_Math" alttext="\displaystyle\kappa_{F}^{\frac{1}{2}}\lambda_{F_{s}}^{-1}\|m_{t}-s_{t}\|_{2}+\kappa_{F}^{\frac{1}{2}}\frac{\delta_{F_{s}}}{\alpha}\kappa_{F}^{\frac{1}{2}}\lambda_{F}^{-1}\|w_{t}-\Phi(w_{t})\|_{2}." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><msubsup><mi>κ</mi><mi>F</mi><mfrac><mn>1</mn><mn>2</mn></mfrac></msubsup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>λ</mi><msub><mi>F</mi><mi>s</mi></msub><mrow><mo>−</mo><mn>1</mn></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">‖</mo><mrow><msub><mi>m</mi><mi>t</mi></msub><mo>−</mo><msub><mi>s</mi><mi>t</mi></msub></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn></msub></mrow><mo>+</mo><mrow><msubsup><mi>κ</mi><mi>F</mi><mfrac><mn>1</mn><mn>2</mn></mfrac></msubsup><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><msub><mi>δ</mi><msub><mi>F</mi><mi>s</mi></msub></msub><mi>α</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>κ</mi><mi>F</mi><mfrac><mn>1</mn><mn>2</mn></mfrac></msubsup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>λ</mi><mi>F</mi><mrow><mo>−</mo><mn>1</mn></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">‖</mo><mrow><msub><mi>w</mi><mi>t</mi></msub><mo>−</mo><mrow><mi mathvariant="normal">Φ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>w</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn></msub></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\kappa_{F}^{\frac{1}{2}}\lambda_{F_{s}}^{-1}\|m_{t}-s_{t}\|_{2}+\kappa_{F}^{\frac{1}{2}}\frac{\delta_{F_{s}}}{\alpha}\kappa_{F}^{\frac{1}{2}}\lambda_{F}^{-1}\|w_{t}-\Phi(w_{t})\|_{2}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="A10.Thmtheorem10.p8" class="ltx_para">
<p id="A10.Thmtheorem10.p8.1" class="ltx_p"><span id="A10.Thmtheorem10.p8.1.1" class="ltx_text">For any <math id="A10.Thmtheorem10.p8.m1" class="ltx_Math" alttext="v" display="inline" intent=":literal"><semantics><mi>v</mi><annotation encoding="application/x-tex">v</annotation></semantics></math>,</span></p>
<table id="A10.E159" class="ltx_equationgroup ltx_eqn_table">
<tbody>
<tr id="A10.E159X" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A10.E159X.m2" class="ltx_Math" alttext="\displaystyle\|\nabla\Phi(w_{t})v-P_{\mathcal{R}}(z_{t})v\|_{2}" display="inline" intent=":literal"><semantics><msub><mrow><mo stretchy="false">‖</mo><mrow><mrow><mrow><mo rspace="0.167em">∇</mo><mi mathvariant="normal">Φ</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>w</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>v</mi></mrow><mo>−</mo><mrow><msub><mi>P</mi><mi class="ltx_font_mathcaligraphic">ℛ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>z</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>v</mi></mrow></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn></msub><annotation encoding="application/x-tex">\displaystyle\|\nabla\Phi(w_{t})v-P_{\mathcal{R}}(z_{t})v\|_{2}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="4" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equationgroup ltx_align_right">(159)</span></td></tr>
<tr id="A10.E159Xa" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A10.E159Xa.m2" class="ltx_Math" alttext="\displaystyle\leq" display="inline" intent=":literal"><semantics><mo>≤</mo><annotation encoding="application/x-tex">\displaystyle\leq</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A10.E159Xa.m3" class="ltx_Math" alttext="\displaystyle\|\nabla\Phi(w_{t})v-P_{f}(w_{t})v\|_{2}+\|P_{f}(w_{t})v-P_{f}(z_{t})v\|_{2}+\|P_{f}(z_{t})v-P_{\mathcal{R}}(z_{t})v\|_{2}" display="inline" intent=":literal"><semantics><mrow><msub><mrow><mo stretchy="false">‖</mo><mrow><mrow><mrow><mo rspace="0.167em">∇</mo><mi mathvariant="normal">Φ</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>w</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>v</mi></mrow><mo>−</mo><mrow><msub><mi>P</mi><mi>f</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>w</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>v</mi></mrow></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn></msub><mo>+</mo><msub><mrow><mo stretchy="false">‖</mo><mrow><mrow><msub><mi>P</mi><mi>f</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>w</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>v</mi></mrow><mo>−</mo><mrow><msub><mi>P</mi><mi>f</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>z</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>v</mi></mrow></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn></msub><mo>+</mo><msub><mrow><mo stretchy="false">‖</mo><mrow><mrow><msub><mi>P</mi><mi>f</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>z</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>v</mi></mrow><mo>−</mo><mrow><msub><mi>P</mi><mi class="ltx_font_mathcaligraphic">ℛ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>z</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>v</mi></mrow></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn></msub></mrow><annotation encoding="application/x-tex">\displaystyle\|\nabla\Phi(w_{t})v-P_{f}(w_{t})v\|_{2}+\|P_{f}(w_{t})v-P_{f}(z_{t})v\|_{2}+\|P_{f}(z_{t})v-P_{\mathcal{R}}(z_{t})v\|_{2}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr>
<tr id="A10.E159Xb" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A10.E159Xb.m2" class="ltx_Math" alttext="\displaystyle\leq" display="inline" intent=":literal"><semantics><mo>≤</mo><annotation encoding="application/x-tex">\displaystyle\leq</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A10.E159Xb.m3" class="ltx_Math" alttext="\displaystyle\lambda_{F}^{-\frac{1}{2}}\|\nabla\Phi(w_{t})v-P_{f}(w_{t})v\|_{F(w_{t})}+\|P_{f}(w_{t})v-P_{f}(z_{t})v\|_{2}+\lambda_{F}^{-\frac{1}{2}}\|P_{f}(z_{t})v-P_{\mathcal{R}}(z_{t})v\|_{F(w_{t})}" display="inline" intent=":literal"><semantics><mrow><mrow><msubsup><mi>λ</mi><mi>F</mi><mrow><mo>−</mo><mfrac><mn>1</mn><mn>2</mn></mfrac></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">‖</mo><mrow><mrow><mrow><mo rspace="0.167em">∇</mo><mi mathvariant="normal">Φ</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>w</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>v</mi></mrow><mo>−</mo><mrow><msub><mi>P</mi><mi>f</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>w</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>v</mi></mrow></mrow><mo stretchy="false">‖</mo></mrow><mrow><mi>F</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>w</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow></msub></mrow><mo>+</mo><msub><mrow><mo stretchy="false">‖</mo><mrow><mrow><msub><mi>P</mi><mi>f</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>w</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>v</mi></mrow><mo>−</mo><mrow><msub><mi>P</mi><mi>f</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>z</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>v</mi></mrow></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn></msub><mo>+</mo><mrow><msubsup><mi>λ</mi><mi>F</mi><mrow><mo>−</mo><mfrac><mn>1</mn><mn>2</mn></mfrac></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">‖</mo><mrow><mrow><msub><mi>P</mi><mi>f</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>z</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>v</mi></mrow><mo>−</mo><mrow><msub><mi>P</mi><mi class="ltx_font_mathcaligraphic">ℛ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>z</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>v</mi></mrow></mrow><mo stretchy="false">‖</mo></mrow><mrow><mi>F</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>w</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow></msub></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\lambda_{F}^{-\frac{1}{2}}\|\nabla\Phi(w_{t})v-P_{f}(w_{t})v\|_{F(w_{t})}+\|P_{f}(w_{t})v-P_{f}(z_{t})v\|_{2}+\lambda_{F}^{-\frac{1}{2}}\|P_{f}(z_{t})v-P_{\mathcal{R}}(z_{t})v\|_{F(w_{t})}</annotation></semantics></math></td>
