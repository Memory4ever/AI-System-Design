lse">(</mo><mi>z</mi><msub><mrow></mrow><mi>t</mi></msub><mo rspace="0.167em" stretchy="false">)</mo><msup><mrow></mrow><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo rspace="0.167em">∇</mo><mi>f</mi><mo stretchy="false">(</mo><mi>z</mi><msub><mrow></mrow><mi>t</mi></msub><mo stretchy="false">)</mo><mo lspace="0em" rspace="0.0835em">∥</mo><msub><mrow></mrow><mrow><mi>F</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>z</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow></msub><msup><mrow></mrow><mn>2</mn></msup><mo lspace="0.0835em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\|(P_{\mathcal{R}}(z_{t})-I)F(z_{t})^{-1}\nabla f(z_{t})\|_{F(z_{t})}^{2}\leq\frac{\frac{\delta_{F_{s}}^{2}}{\lambda_{H_{F,s}}^{2}}}{1-\frac{\delta_{F_{s}}^{2}}{\lambda_{H_{F,s}}^{2}}}\|P_{\mathcal{R}}(z_{t})F(z_{t})^{-1}\nabla f(z_{t})\|_{F(z_{t})}^{2}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equationgroup ltx_align_right">(178)</span></td></tr></tbody>
</table>
<p id="A10.Thmtheorem12.p7.2" class="ltx_p"><span id="A10.Thmtheorem12.p7.2.1" class="ltx_text">Thus</span></p>
