<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S5.Ex4Xa.m2" class="ltx_Math" alttext="\displaystyle+{\color[rgb]{0.5,0,0.5}\chi Q_{k}}F(w_{k})^{-1}(m_{k}+{\color[rgb]{0.5,0,0.5}\beta_{2}}\nabla f(w_{k}))." display="inline" intent=":literal"><semantics><mrow><mo style="--ltx-bg-color:#FFECD9;" mathbackground="#FFECD9">+</mo><mi style="--ltx-fg-color:#800080;--ltx-bg-color:#FFECD9;" mathbackground="#FFECD9" mathcolor="#800080">χ</mi><mi style="--ltx-fg-color:#800080;--ltx-bg-color:#FFECD9;" mathbackground="#FFECD9" mathcolor="#800080">Q</mi><msub><mrow></mrow><mi style="--ltx-fg-color:#800080;--ltx-bg-color:#FFECD9;" mathbackground="#FFECD9" mathcolor="#800080">k</mi></msub><mi style="--ltx-bg-color:#FFECD9;" mathbackground="#FFECD9">F</mi><mo style="--ltx-bg-color:#FFECD9;" mathbackground="#FFECD9" stretchy="false">(</mo><mi style="--ltx-bg-color:#FFECD9;" mathbackground="#FFECD9">w</mi><msub><mrow></mrow><mi style="--ltx-bg-color:#FFECD9;" mathbackground="#FFECD9">k</mi></msub><mo style="--ltx-bg-color:#FFECD9;" mathbackground="#FFECD9" stretchy="false">)</mo><msup><mrow></mrow><mrow><mo style="--ltx-bg-color:#FFECD9;" mathbackground="#FFECD9">−</mo><mn style="--ltx-bg-color:#FFECD9;" mathbackground="#FFECD9">1</mn></mrow></msup><mo style="--ltx-bg-color:#FFECD9;" mathbackground="#FFECD9" stretchy="false">(</mo><mi style="--ltx-bg-color:#FFECD9;" mathbackground="#FFECD9">m</mi><msub><mrow></mrow><mi style="--ltx-bg-color:#FFECD9;" mathbackground="#FFECD9">k</mi></msub><mo style="--ltx-bg-color:#FFECD9;" mathbackground="#FFECD9">+</mo><mi style="--ltx-fg-color:#800080;--ltx-bg-color:#FFECD9;" mathbackground="#FFECD9" mathcolor="#800080">β</mi><msub><mrow></mrow><mn style="--ltx-fg-color:#800080;--ltx-bg-color:#FFECD9;" mathbackground="#FFECD9" mathcolor="#800080">2</mn></msub><mo style="--ltx-bg-color:#FFECD9;" lspace="0.167em" mathbackground="#FFECD9" rspace="0.167em">∇</mo><mi style="--ltx-bg-color:#FFECD9;" mathbackground="#FFECD9">f</mi><mo style="--ltx-bg-color:#FFECD9;" mathbackground="#FFECD9" stretchy="false">(</mo><mi style="--ltx-bg-color:#FFECD9;" mathbackground="#FFECD9">w</mi><msub><mrow></mrow><mi style="--ltx-bg-color:#FFECD9;" mathbackground="#FFECD9">k</mi></msub><mo style="--ltx-bg-color:#FFECD9;" mathbackground="#FFECD9" stretchy="false">)</mo><mo style="--ltx-bg-color:#FFECD9;" mathbackground="#FFECD9" stretchy="false">)</mo><mo style="--ltx-bg-color:#FFECD9;" lspace="0em" mathbackground="#FFECD9">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle+{\color[rgb]{0.5,0,0.5}\chi Q_{k}}F(w_{k})^{-1}(m_{k}+{\color[rgb]{0.5,0,0.5}\beta_{2}}\nabla f(w_{k})).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>

</div>
<div id="alg1.l6" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg1.l6.1" class="ltx_text" style="font-size:80%;">6:</span></span>
              
              
              Update parameters <math id="alg1.l6.m1" class="ltx_Math" alttext="w_{k+1}=w_{k}-\eta_{k}u_{k}" display="inline" intent=":literal"><semantics><mrow><msub><mi>w</mi><mrow><mi>k</mi><mo>+</mo><mn>1</mn></mrow></msub><mo>=</mo><mrow><msub><mi>w</mi><mi>k</mi></msub><mo>−</mo><mrow><msub><mi>η</mi><mi>k</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>u</mi><mi>k</mi></msub></mrow></mrow></mrow><annotation encoding="application/x-tex">w_{k+1}=w_{k}-\eta_{k}u_{k}</annotation></semantics></math>.

</div>
