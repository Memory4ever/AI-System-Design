<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A10.E179Xa.m3" class="ltx_Math" alttext="\displaystyle\frac{\delta_{F_{s}}}{\alpha\lambda_{H_{F,s}}}\eta_{t}\chi\|P_{\mathcal{R}}(z_{t})F(z_{t})^{-1}\nabla f(z_{t})\|_{F(z_{t})}^{2}+\frac{\delta_{F_{s}}\alpha}{\lambda_{H_{F,s}}}\eta_{t}\chi\|s_{t}\|_{F^{-1}(z_{t})}^{2}." display="inline" intent=":literal"><semantics><mrow><mstyle displaystyle="true"><mfrac><msub><mi>δ</mi><msub><mi>F</mi><mi>s</mi></msub></msub><mrow><mi>α</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>λ</mi><msub><mi>H</mi><mrow><mi>F</mi><mo>,</mo><mi>s</mi></mrow></msub></msub></mrow></mfrac></mstyle><mi>η</mi><msub><mrow></mrow><mi>t</mi></msub><mi>χ</mi><mo lspace="0em" rspace="0.167em">∥</mo><mi>P</mi><msub><mrow></mrow><mi class="ltx_font_mathcaligraphic">ℛ</mi></msub><mo stretchy="false">(</mo><mi>z</mi><msub><mrow></mrow><mi>t</mi></msub><mo stretchy="false">)</mo><mi>F</mi><mo stretchy="false">(</mo><mi>z</mi><msub><mrow></mrow><mi>t</mi></msub><mo rspace="0.167em" stretchy="false">)</mo><msup><mrow></mrow><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo rspace="0.167em">∇</mo><mi>f</mi><mo stretchy="false">(</mo><mi>z</mi><msub><mrow></mrow><mi>t</mi></msub><mo stretchy="false">)</mo><mo lspace="0em" rspace="0em">∥</mo><msub><mrow></mrow><mrow><mi>F</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>z</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow></msub><msup><mrow></mrow><mn>2</mn></msup><mo lspace="0em">+</mo><mstyle displaystyle="true"><mfrac><mrow><msub><mi>δ</mi><msub><mi>F</mi><mi>s</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mi>α</mi></mrow><msub><mi>λ</mi><msub><mi>H</mi><mrow><mi>F</mi><mo>,</mo><mi>s</mi></mrow></msub></msub></mfrac></mstyle><mi>η</mi><msub><mrow></mrow><mi>t</mi></msub><mi>χ</mi><mo lspace="0em" rspace="0.167em">∥</mo><mi>s</mi><msub><mrow></mrow><mi>t</mi></msub><mo lspace="0em" rspace="0.0835em">∥</mo><msub><mrow></mrow><mrow><msup><mi>F</mi><mrow><mo>−</mo><mn>1</mn></mro