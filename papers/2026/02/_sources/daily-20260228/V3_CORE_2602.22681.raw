<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A10.Thmtheorem1.p3.3" class="ltx_p"><span id="A10.Thmtheorem1.p3.3.1" class="ltx_text">∎</span></p>
</div>
</div>
</div>
<div id="A10.SS1.p2" class="ltx_para">
<p id="A10.SS1.p2.3" class="ltx_p">Using <math id="A10.SS1.p2.m1" class="ltx_Math" alttext="\nabla P_{f}=-\nabla P_{s}" display="inline" intent=":literal"><semantics><mrow><mrow><mo rspace="0.167em">∇</mo><msub><mi>P</mi><mi>f</mi></msub></mrow><mo>=</mo><mrow><mo rspace="0.167em">−</mo><mrow><mo rspace="0.167em">∇</mo><msub><mi>P</mi><mi>s</mi></msub></mrow></mrow></mrow><annotation encoding="application/x-tex">\nabla P_{f}=-\nabla P_{s}</annotation></semantics></math>, we can similarly get</p>
<table id="A10.E80" class="ltx_equationgroup ltx_eqn_table">
<tbody>
<tr id="A10.E80X" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A10.E80X.m2" class="ltx_Math" alttext="\displaystyle v^{\top}\nabla(P_{f}F^{-1}P_{f})(w)[u]v\leq" display="inline" intent=":literal"><semantics><mrow><mi>v</mi><msup><mrow></mrow><mo>⊤</mo></msup><mo lspace="0.167em">∇</mo><mo stretchy="false">(</mo><mi>P</mi><msub><mrow></mrow><mi>f</mi></msub><mi>F</mi><msup><mrow></mrow><mrow><mo>−</mo><mn>1</mn></mrow></msup><mi>P</mi><msub><mrow></mrow><mi>f</mi></msub><mo stretchy="false">)</mo><mo stretchy="false">(</mo><mi>w</mi><mo stretchy="false">)</mo><mo stretchy="false">[</mo><mi>u</mi><mo stretchy="false">]</mo><mi>v</mi><mo>≤</mo></mrow><annotation encoding="application/x-tex">\displaystyle v^{\top}\nabla(P_{f}F^{-1}P_{f})(w)[u]v\leq</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A10.E80X.m3" class="ltx_Math" alttext="\displaystyle\frac{\delta_{F_{s}}}{\|\nabla f(w)\|_{F(w)^{-1}}}\|v\|_{F(w)^{-1}}\|v\|_{F_{f}^{\dagger}(w)}\|u\|_{F(w)}," display="inline" intent=":literal"><semantics><mrow><mrow><mstyle displaystyle="true"><mfrac><msub><mi>δ</mi><msub><mi>F</mi><mi>s</mi></msub></msub><msub><mrow><mo stretchy="false">‖</mo><mrow><mrow><mo rspace="0.167em">∇</mo><mi>f</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>w</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">‖</mo></mrow><mrow><mi>F</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>w</mi><mo stretchy="false">)</mo></mrow><mrow><mo>−</mo><mn>1</mn></mrow></msup></mrow></msub></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">‖</mo><mi>v</mi><mo stretchy="false">‖</mo></mrow><mrow><mi>F</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>w</mi><mo stretchy="false">)</mo></mrow><mrow><mo>−</mo><mn>1</mn></mrow></msup></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">‖</mo><mi>v</mi><mo stretchy="false">‖</mo></mrow><mrow><msubsup><mi>F</mi><mi>f</mi><mo>†</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>w</mi><mo stretchy="false">)</mo></mrow></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">‖</mo><mi>u</mi><mo stretchy="false">‖</mo></mrow><mrow><mi>F</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>w</mi><mo stretchy="false">)</mo></mrow></mrow></msub></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\frac{\delta_{F_{s}}}{\|\nabla f(w)\|_{F(w)^{-1}}}\|v\|_{F(w)^{-1}}\|v\|_{F_{f}^{\dagger}(w)}\|u\|_{F(w)},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equationgroup ltx_align_right">(80)</span></td></tr></tbody>
</table>
<p id="A10.SS1.p2.4" class="ltx_p">and</p>
<table id="A10.E81" class="ltx_equationgroup ltx_eqn_table">
<tbody>
<tr id="A10.E81X" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A10.E81X.m2" class="ltx_Math" alttext="\displaystyle v^{\top}\nabla(P_{f}FP_{f})(w)[u]v\leq" display="inline" intent=":literal"><semantics><mrow><mi>v</mi><msup><mrow></mrow><mo>⊤</mo></msup><mo lspace="0.167em">∇</mo><mo stretchy="false">(</mo><mi>P</mi><msub><mrow></mrow><mi>f</mi></msub><mi>F</mi><mi>P</mi><msub><mrow></mrow><mi>f</mi></msub><mo stretchy="false">)</mo><mo stretchy="false">(</mo><mi>w</mi><mo stretchy="false">)</mo><mo stretchy="false">[</mo><mi>u</mi><mo stretchy="false">]</mo><mi>v</mi><mo>≤</mo></mrow><annotation encoding="application/x-tex">\displaystyle v^{\top}\nabla(P_{f}FP_{f})(w)[u]v\leq</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A10.E81X.m3" class="ltx_Math" alttext="\displaystyle\frac{\delta_{F_{s}}}{\|\nabla f(w)\|_{F(w)^{-1}}}\|v\|_{F(w)}\|v\|_{F_{f}(w)}\|u\|_{F(w)}." display="inline" intent=":literal"><semantics><mrow><mrow><mstyle displaystyle="true"><mfrac><msub><mi>δ</mi><msub><mi>F</mi><mi>s</mi></msub></msub><msub><mrow><mo stretchy="false">‖</mo><mrow><mrow><mo rspace="0.167em">∇</mo><mi>f</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>w</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">‖</mo></mrow><mrow><mi>F</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>w</mi><mo stretchy="false">)</mo></mrow><mrow><mo>−</mo><mn>1</mn></mrow></msup></mrow></msub></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">‖</mo><mi>v</mi><mo stretchy="false">‖</mo></mrow><mrow><mi>F</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>w</mi><mo stretchy="false">)</mo></mrow></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">‖</mo><mi>v</mi><mo stretchy="false">‖</mo></mrow><mrow><msub><mi>F</mi><mi>f</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>w</mi><mo stretchy="false">)</mo></mrow></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">‖</mo><mi>u</mi><mo stretchy="false">‖</mo></mrow><mrow><mi>F</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>w</mi><mo stretchy="false">)</mo></mrow></mrow></msub></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\frac{\delta_{F_{s}}}{\|\nabla f(w)\|_{F(w)^{-1}}}\|v\|_{F(w)}\|v\|_{F_{f}(w)}\|u\|_{F(w)}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equationgroup ltx_align_right">(81)</span></td></tr></tbody>
</table>
</div>
<div id="A10.Thmtheorem2" class="ltx_theorem ltx_theorem_lemma">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="A10.Thmtheorem2.2" class="ltx_text ltx_font_bold">Lemma J.2</span></span><span id="A10.Thmtheorem2.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="A10.Thmtheorem2.p1" class="ltx_para">
<p id="A10.Thmtheorem2.p1.1" class="ltx_p"><span id="A10.Thmtheorem2.p1.1.1" class="ltx_text ltx_font_italic">Suppose Assumptions <a href="#S7.Thmtheorem1" title="Assumption 7.1 (River Structure). ‣ 7 Theoretical Analysis to Training Dynamics ‣ Accelerating LLM Pre-Training through Flat-Direction Dynamics Enhancement" class="ltx_ref"><span class="ltx_text ltx_ref_tag">7.1</span></a> and <a href="#S7.Thmtheorem2" title="Assumption 7.2 (Regularity, Smoothness and Conservation). ‣ 7 Theoretical Analysis to Training Dynamics ‣ Accelerating LLM Pre-Training through Flat-Direction Dynamics Enhancement" class="ltx_ref"><span class="ltx_text ltx_ref_tag">7.2</span></a> hold. For any <math id="A10.Thmtheorem2.p1.m1" class="ltx_Math" alttext="w\in U" display="inline" intent=":literal"><semantics><mrow><mi>w</mi><mo>∈</mo><mi>U</mi></mrow><annotation encoding="application/x-tex">w\in U</annotation></semantics></math>, we have</span></p>
<table id="A10.E82" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A10.E82.m1" class="ltx_math_unparsed" alttext="\nabla\Phi(w)P_{s}(w)F^{-1}(w)\nabla f(w)=0," display="block" intent=":literal"><semantics><mrow><mo rspace="0.167em">∇</mo><mi mathvariant="normal">Φ</mi><mrow><mo stretchy="false">(</mo><mi>w</mi><mo stretchy="false">)</mo></mrow><msub><mi>P</mi><mi>s</mi></msub><mrow><mo stretchy="false">(</mo><mi>w</mi><mo stretchy="false">)</mo></mrow><msup><mi>F</mi><mrow><mo>−</mo><mn>1</mn></mrow></msup><mrow><mo stretchy="false">(</mo><mi>w</mi><mo rspace="0.167em" stretchy="false">)</mo></mrow><mo rspace="0.167em">∇</mo><mi>f</mi><mrow><mo stretchy="false">(</mo><mi>w</mi><mo stretchy="false">)</mo></mrow><mo>=</mo><mn>0</mn><mo>,</mo></mrow><annotation encoding="application/x-tex">\nabla\Phi(w)P_{s}(w)F^{-1}(w)\nabla f(w)=0,</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(82)</span></td></tr></tbody>
</table>
<p id="A10.Thmtheorem2.p1.2" class="ltx_p"><span id="A10.Thmtheorem2.p1.2.1" class="ltx_text ltx_font_italic">and <math id="A10.Thmtheorem2.p1.m2" class="ltx_Math" alttext="\operatorname{Range}\nabla\Phi(w)\subset T_{\Phi(w)}\mathcal{R}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>Range</mi><mo lspace="0.167em">⁡</mo><mrow><mrow><mo rspace="0.167em">∇</mo><mi mathvariant="normal">Φ</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>w</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>⊂</mo><mrow><msub><mi>T</mi><mrow><mi mathvariant="normal">Φ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>w</mi><mo stretchy="false">)</mo></mrow></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mi class="ltx_font_mathcaligraphic">ℛ</mi></mrow></mrow><annotation encoding="application/x-tex">\operatorname{Range}\nabla\Phi(w)\subset T_{\Phi(w)}\mathcal{R}</annotation></semantics></math>. Especially, if we further assume that <math id="A10.Thmtheorem2.p1.m3" class="ltx_Math" alttext="\max\{\delta_{F},\delta\}&lt;\frac{1}{3}\lambda_{H_{F,s}}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>max</mi><mo>⁡</mo><mrow><mo stretchy="false">{</mo><msub><mi>δ</mi><mi>F</mi></msub><mo>,</mo><mi>δ</mi><mo stretchy="false">}</mo></mrow></mrow><mo>&lt;</mo><mrow><mfrac><mn>1</mn><mn>3</mn></mfrac><mo lspace="0em" rspace="0em">​</mo><msub><mi>λ</mi><msub><mi>H</mi><mrow><mi>F</mi><mo>,</mo><mi>s</mi></mrow></msub></msub></mrow></mrow><annotation encoding="application/x-tex">\max\{\delta_{F},\delta\}&lt;\frac{1}{3}\lambda_{H_{F,s}}</annotation></semantics></math>, then for any <math id="A10.Thmtheorem2.p1.m4" class="ltx_Math" alttext="z\in\mathcal{R}" display="inline" intent=":literal"><semantics><mrow><mi>z</mi><mo>∈</mo><mi class="ltx_font_mathcaligraphic">ℛ</mi></mrow><annotation encoding="application/x-tex">z\in\mathcal{R}</annotation></semantics></math>, <math id="A10.Thmtheorem2.p1.m5" class="ltx_Math" alttext="\nabla\Phi(z)" display="inline" intent=":literal"><semantics><mrow><mrow><mo rspace="0.167em">∇</mo><mi mathvariant="normal">Φ</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>z</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\nabla\Phi(z)</annotation></semantics></math> is the oblique projection onto <math id="A10.Thmtheorem2.p1.m6" class="ltx_Math" alttext="T_{z}\mathcal{R}" display="inline" intent=":literal"><semantics><mrow><msub><mi>T</mi><mi>z</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi class="ltx_font_mathcaligraphic">ℛ</mi></mrow><annotation encoding="application/x-tex">T_{z}\mathcal{R}</annotation></semantics></math> in the direct sum decomposition <math id="A10.Thmtheorem2.p1.m7" class="ltx_Math" alttext="\mathbb{R}^{p}=T_{z}\mathcal{R}\oplus\operatorname{Range}P_{s}(z)" display="inline" intent=":literal"><semantics><mrow><msup><mi>ℝ</mi><mi>p</mi></msup><mo>=</mo><mrow><mrow><msub><mi>T</mi><mi>z</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi class="ltx_font_mathcaligraphic">ℛ</mi></mrow><mo>⊕</mo><mrow><mrow><mi>Range</mi><mo lspace="0.167em">⁡</mo><msub><mi>P</mi><mi>s</mi></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>z</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\mathbb{R}^{p}=T_{z}\mathcal{R}\oplus\operatorname{Range}P_{s}(z)</annotation></semantics></math>.</span></p>
</div>
<div id="A10.Thmtheorem2.4" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="A10.Thmtheorem2.p2" class="ltx_para">
<p id="A10.Thmtheorem2.p2.1" class="ltx_p"><span id="A10.Thmtheorem2.p2.1.1" class="ltx_text">First, note that <math id="A10.Thmtheorem2.p2.m1" class="ltx_Math" alttext="\Phi(w)=\lim_{n\to\infty}\phi_{1}^{(n)}(w)" display="inline" intent=":literal"><semantics><mrow><mrow><mi mathvariant="normal">Φ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>w</mi><mo stretchy="false">)</mo></mrow></mrow><mo rspace="0.1389em">=</mo><mrow><msub><mo lspace="0.1389em" rspace="0.167em">lim</mo><mrow><mi>n</mi><mo stretchy="false">→</mo><mi mathvariant="normal">∞</mi></mrow></msub><mrow><msubsup><mi>ϕ</mi><mn>1</mn><mrow><mo stretchy="false">(</mo><mi>n</mi><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>w</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\Phi(w)=\lim_{n\to\infty}\phi_{1}^{(n)}(w)</annotation></semantics></math>, where <math id="A10.Thmtheorem2.p2.m2" class="ltx_Math" alttext="\phi_{1}(w):=\psi_{t}(w)|_{t=1}" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>ϕ</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>w</mi><mo stretchy="false">)</mo></mrow></mrow><mo>:=</mo><msub><mrow><mrow><msub><mi>ψ</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>w</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">|</mo></mrow><mrow><mi>t</mi><mo>=</mo><mn>1</mn></mrow></msub></mrow><annotation encoding="application/x-tex">\phi_{1}(w):=\psi_{t}(w)|_{t=1}</annotation></semantics></math> denotes the time-1 map of the flow. Since <math id="A10.Thmtheorem2.p2.m3" class="ltx_Math" alttext="F" display="inline" intent=":literal"><semantics><mi>F</mi><annotation encoding="application/x-tex">F</annotation></semantics></math> and <math id="A10.Thmtheorem2.p2.m4" class="ltx_Math" alttext="f" display="inline" intent=":literal"><semantics><mi>f</mi><annotation encoding="application/x-tex">f</annotation></semantics></math> are smooth, <math id="A10.Thmtheorem2.p2.m5" class="ltx_Math" alttext="\phi_{1}" display="inline" intent=":literal"><semantics><msub><mi>ϕ</mi><mn>1</mn></msub><annotation encoding="application/x-tex">\phi_{1}</annotation></semantics></math> is smooth. Then the smoothness of <math id="A10.Thmtheorem2.p2.m6" class="ltx_Math" alttext="\Phi" display="inline" intent=":literal"><semantics><mi mathvariant="normal">Φ</mi><annotation encoding="application/x-tex">\Phi</annotation></semantics></math> follows immediately from Theorem 5.1 in <cite class="ltx_cite ltx_citemacro_citep">(<a href="#bib.bib24" title="" class="ltx_ref">Falconer, 1983</a>)</cite>. For any <math id="A10.Thmtheorem2.p2.m7" class="ltx_Math" alttext="w\in U" display="inline" intent=":literal"><semantics><mrow><mi>w</mi><mo>∈</mo><mi>U</mi></mrow><annotation encoding="application/x-tex">w\in U</annotation></semantics></math>, noting that</span></p>
<table id="A10.E83" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A10.E83.m1" class="ltx_math_unparsed" alttext="-\nabla\Phi(w)P_{s}(w)F^{-1}(w)\nabla f(w)=\frac{d}{dt}\Phi(\psi_{t}(w))|_{t=0}=\frac{d}{dt}\Phi(w)|_{t=0}=0," display="block" intent=":literal"><semantics><mrow><mo>−</mo><mo rspace="0.167em">∇</mo><mi mathvariant="normal">Φ</mi><mrow><mo stretchy="false">(</mo><mi>w</mi><mo stretchy="false">)</mo></mrow><msub><mi>P</mi><mi>s</mi></msub><mrow><mo stretchy="false">(</mo><mi>w</mi><mo stretchy="false">)</mo></mrow><msup><mi>F</mi><mrow><mo>−</mo><mn>1</mn></mrow></msup><mrow><mo stretchy="false">(</mo><mi>w</mi><mo rspace="0.167em" stretchy="false">)</mo></mrow><mo rspace="0.167em">∇</mo><mi>f</mi><mrow><mo stretchy="false">(</mo><mi>w</mi><mo stretchy="false">)</mo></mrow><mo>=</mo><mfrac><mi>d</mi><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></mfrac><mi mathvariant="normal">Φ</mi><mrow><mo stretchy="false">(</mo><msub><mi>ψ</mi><mi>t</mi></msub><mrow><mo stretchy="false">(</mo><mi>w</mi><mo stretchy="false">)</mo></mrow><mo stretchy="false">)</mo></mrow><msub><mo fence="false" stretchy="false">|</mo><mrow><mi>t</mi><mo>=</mo><mn>0</mn></mrow></msub><mo lspace="0.167em">=</mo><mfrac><mi>d</mi><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></mfrac><mi mathvariant="normal">Φ</mi><mrow><mo stretchy="false">(</mo><mi>w</mi><mo stretchy="false">)</mo></mrow><msub><mo fence="false" stretchy="false">|</mo><mrow><mi>t</mi><mo>=</mo><mn>0</mn></mrow></msub><mo lspace="0.167em">=</mo><mn>0</mn><mo>,</mo></mrow><annotation encoding="application/x-tex">-\nabla\Phi(w)P_{s}(w)F^{-1}(w)\nabla f(w)=\frac{d}{dt}\Phi(\psi_{t}(w))|_{t=0}=\frac{d}{dt}\Phi(w)|_{t=0}=0,</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(83)</span></td></tr></tbody>
</table>
<p id="A10.Thmtheorem2.p2.2" class="ltx_p"><span id="A10.Thmtheorem2.p2.2.1" class="ltx_text">we get (<a href="#A10.E82" title="Equation 82 ‣ Lemma J.2. ‣ J.1 Landscape Analysis ‣ Appendix J Proof ‣ Accelerating LLM Pre-Training through Flat-Direction Dynamics Enhancement" class="ltx_ref"><span class="ltx_text ltx_ref_tag">82</span></a>). Besides, <math id="A10.Thmtheorem2.p2.m8" class="ltx_Math" alttext="\operatorname{Range}\nabla\Phi(w)\subset T_{\Phi(w)}\mathcal{R}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>Range</mi><mo lspace="0.167em">⁡</mo><mrow><mrow><mo rspace="0.167em">∇</mo><mi mathvariant="normal">Φ</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>w</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>⊂</mo><mrow><msub><mi>T</mi><mrow><mi mathvariant="normal">Φ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>w</mi><mo stretchy="false">)</mo></mrow></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mi class="ltx_font_mathcaligraphic">ℛ</mi></mrow></mrow><annotation encoding="application/x-tex">\operatorname{Range}\nabla\Phi(w)\subset T_{\Phi(w)}\mathcal{R}</annotation></semantics></math> is due to <math id="A10.Thmtheorem2.p2.m9" class="ltx_Math" alttext="\Phi(w)\in\mathcal{R}" display="inline" intent=":literal"><semantics><mrow><mrow><mi mathvariant="normal">Φ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>w</mi><mo stretchy="false">)</mo></mrow></mrow><mo>∈</mo><mi class="ltx_font_mathcaligraphic">ℛ</mi></mrow><annotation encoding="application/x-tex">\Phi(w)\in\mathcal{R}</annotation></semantics></math>.</span></p>
</div>
<div id="A10.Thmtheorem2.p3" class="ltx_para">
<p id="A10.Thmtheorem2.p3.2" class="ltx_p"><span id="A10.Thmtheorem2.p3.2.1" class="ltx_text">It follows that for any <math id="A10.Thmtheorem2.p3.m1" class="ltx_Math" alttext="z\in\mathcal{R}" display="inline" intent=":literal"><semantics><mrow><mi>z</mi><mo>∈</mo><mi class="ltx_font_mathcaligraphic">ℛ</mi></mrow><annotation encoding="application/x-tex">z\in\mathcal{R}</annotation></semantics></math> and any <math id="A10.Thmtheorem2.p3.m2" class="ltx_Math" alttext="v\in\mathbb{R}^{p}" display="inline" intent=":literal"><semantics><mrow><mi>v</mi><mo>∈</mo><msup><mi>ℝ</mi><mi>p</mi></msup></mrow><annotation encoding="application/x-tex">v\in\mathbb{R}^{p}</annotation></semantics></math>, we have</span></p>
<table id="A10.E84" class="ltx_equationgroup ltx_eqn_table">
<tbody>
<tr id="A10.E84X" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A10.E84X.m2" class="ltx_Math" alttext="\displaystyle 0=" display="inline" intent=":literal"><semantics><mrow><mn>0</mn><mo>=</mo><mphantom></mphantom></mrow><annotation encoding="application/x-tex">\displaystyle 0=</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A10.E84X.m3" class="ltx_Math" alttext="\displaystyle\nabla\left(\nabla\Phi F_{s}^{\dagger}\nabla f\right)(z)[v]" display="inline" intent=":literal"><semantics><mrow><mo>∇</mo><mo>(</mo><mo rspace="0.167em">∇</mo><mi mathvariant="normal">Φ</mi><mi>F</mi><msub><mrow></mrow><mi>s</mi></msub><msup><mrow></mrow><mo>†</mo></msup><mo lspace="0.167em" rspace="0.167em">∇</mo><mi>f</mi><mo>)</mo><mo stretchy="false">(</mo><mi>z</mi><mo stretchy="false">)</mo><mo stretchy="false">[</mo><mi>v</mi><mo stretchy="false">]</mo></mrow><annotation encoding="application/x-tex">\displaystyle\nabla\left(\nabla\Phi F_{s}^{\dagger}\nabla f\right)(z)[v]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="3" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equationgroup ltx_align_right">(84)</span></td></tr>
<tr id="A10.E84Xa" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A10.E84Xa.m2" class="ltx_Math" alttext="\displaystyle=" display="inline" intent=":literal"><semantics><mo>=</mo><annotation encoding="application/x-tex">\displaystyle=</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A10.E84Xa.m3" class="ltx_Math" alttext="\displaystyle\nabla^{2}\Phi(z)[v]\underbrace{F_{s}^{\dagger}(z)\nabla f(z)}_{=0}+\nabla\Phi(z)\nabla F_{s}^{\dagger}(z)[v]\nabla f(z)+\nabla\Phi(z)F_{s}^{\dagger}(z)\nabla^{2}f(z)[v]" display="inline" intent=":literal"><semantics><mrow><mo rspace="0.167em">∇</mo><msup><mrow></mrow><mn>2</mn></msup><mi mathvariant="normal">Φ</mi><mo stretchy="false">(</mo><mi>z</mi><mo stretchy="false">)</mo><mo stretchy="false">[</mo><mi>v</mi><mo stretchy="false">]</mo><munder accentunder="true"><mrow><mi>F</mi><msub><mrow></mrow><mi>s</mi></msub><msup><mrow></mrow><mo>†</mo></msup><mo stretchy="false">(</mo><mi>z</mi><mo rspace="0.167em" stretchy="false">)</mo><mo rspace="0.167em">∇</mo><mi>f</mi><mo stretchy="false">(</mo><mi>z</mi><mo stretchy="false">)</mo></mrow><mo stretchy="true">⏟</mo></munder><msub><mrow></mrow><mrow><mphantom></mphantom><mo>=</mo><mn>0</mn></mrow></msub><mo>+</mo><mo rspace="0.167em">∇</mo><mi mathvariant="normal">Φ</mi><mo stretchy="false">(</mo><mi>z</mi><mo rspace="0.167em" stretchy="false">)</mo><mo rspace="0.167em">∇</mo><mi>F</mi><msub><mrow></mrow><mi>s</mi></msub><msup><mrow></mrow><mo>†</mo></msup><mo stretchy="false">(</mo><mi>z</mi><mo stretchy="false">)</mo><mo stretchy="false">[</mo><mi>v</mi><mo rspace="0.167em" stretchy="false">]</mo><mo rspace="0.167em">∇</mo><mi>f</mi><mo stretchy="false">(</mo><mi>z</mi><mo stretchy="false">)</mo><mo>+</mo><mo rspace="0.167em">∇</mo><mi mathvariant="normal">Φ</mi><mo stretchy="false">(</mo><mi>z</mi><mo stretchy="false">)</mo><mi>F</mi><msub><mrow></mrow><mi>s</mi></msub><msup><mrow></mrow><mo>†</mo></msup><mo stretchy="false">(</mo><mi>z</mi><mo rspace="0.167em" stretchy="false">)</mo><mo rspace="0.167em">∇</mo><msup><mrow></mrow><mn>2</mn></msup><mi>f</mi><mo stretchy="false">(</mo><mi>z</mi><mo stretchy="false">)</mo><mo stretchy="false">[</mo><mi>v</mi><mo stretchy="false">]</mo></mrow><annotation encoding="application/x-tex">\displaystyle\nabla^{2}\Phi(z)[v]\underbrace{F_{s}^{\dagger}(z)\nabla f(z)}_{=0}+\nabla\Phi(z)\nabla F_{s}^{\dagger}(z)[v]\nabla f(z)+\nabla\Phi(z)F_{s}^{\dagger}(z)\nabla^{2}f(z)[v]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr>
<tr id="A10.E84Xb" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A10.E84Xb.m2" class="ltx_Math" alttext="\displaystyle=" display="inline" intent=":literal"><semantics><mo>=</mo><annotation encoding="application/x-tex">\displaystyle=</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A10.E84Xb.m3" class="ltx_Math" alttext="\displaystyle\nabla\Phi(z)\left(\nabla F_{s}^{\dagger}(z)[v]\nabla f(z)+F_{s}^{\dagger}(z)\nabla^{2}f(z)[v]\right)." display="inline" intent=":literal"><semantics><mrow><mo rspace="0.167em">∇</mo><mi mathvariant="normal">Φ</mi><mo stretchy="false">(</mo><mi>z</mi><mo stretchy="false">)</mo><mo>(</mo><mo rspace="0.167em">∇</mo><mi>F</mi><msub><mrow></mrow><mi>s</mi></msub><msup><mrow></mrow><mo>†</mo></msup><mo stretchy="false">(</mo><mi>z</mi><mo stretchy="false">)</mo><mo stretchy="false">[</mo><mi>v</mi><mo rspace="0.167em" stretchy="false">]</mo><mo rspace="0.167em">∇</mo><mi>f</mi><mo stretchy="false">(</mo><mi>z</mi><mo stretchy="false">)</mo><mo>+</mo><mi>F</mi><msub><mrow></mrow><mi>s</mi></msub><msup><mrow></mrow><mo>†</mo></msup><mo stretchy="false">(</mo><mi>z</mi><mo rspace="0.167em" stretchy="false">)</mo><mo rspace="0.167em">∇</mo><msup><mrow></mrow><mn>2</mn></msup><mi>f</mi><mo stretchy="false">(</mo><mi>z</mi><mo stretchy="false">)</mo><mo stretchy="false">[</mo><mi>v</mi><mo stretchy="false">]</mo><mo>)</mo><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\nabla\Phi(z)\left(\nabla F_{s}^{\dagger}(z)[v]\nabla f(z)+F_{s}^{\dagger}(z)\nabla^{2}f(z)[v]\right).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="A10.Thmtheorem2.p4" class="ltx_para">
<p id="A10.Thmtheorem2.p4.1" class="ltx_p"><span id="A10.Thmtheorem2.p4.1.1" class="ltx_text">Define the linear map <math id="A10.Thmtheorem2.p4.m1" class="ltx_Math" alttext="T_{z}" display="inline" intent=":literal"><semantics><msub><mi>T</mi><mi>z</mi></msub><annotation encoding="application/x-tex">T_{z}</annotation></semantics></math> as <math id="A10.Thmtheorem2.p4.m2" class="ltx_math_unparsed" alttext="T_{z}(v)=\nabla F_{s}^{\dagger}(z)[v]\nabla f(z)+F_{s}^{\dagger}(z)\nabla^{2}f(z)v" display="inline" intent=":literal"><semantics><mrow><msub><mi>T</mi><mi>z</mi></msub><mrow><mo stretchy="false">(</mo><mi>v</mi><mo stretchy="false">)</mo></mrow><mo>=</mo><mo rspace="0.167em">∇</mo><msubsup><mi>F</mi><mi>s</mi><mo>†</mo></msubsup><mrow><mo stretchy="false">(</mo><mi>z</mi><mo stretchy="false">)</mo></mrow><mrow><mo stretchy="false">[</mo><mi>v</mi><mo rspace="0.167em" stretchy="false">]</mo></mrow><mo rspace="0.167em">∇</mo><mi>f</mi><mrow><mo stretchy="false">(</mo><mi>z</mi><mo stretchy="false">)</mo></mrow><mo>+</mo><msubsup><mi>F</mi><mi>s</mi><mo>†</mo></msubsup><mrow><mo stretchy="false">(</mo><mi>z</mi><mo rspace="0.167em" stretchy="false">)</mo></mrow><msup><mo rspace="0.167em">∇</mo><mn>2</mn></msup><mi>f</mi><mrow><mo stretchy="false">(</mo><mi>z</mi><mo stretchy="false">)</mo></mrow><mi>v</mi></mrow><annotation encoding="application/x-tex">T_{z}(v)=\nabla F_{s}^{\dagger}(z)[v]\nabla f(z)+F_{s}^{\dagger}(z)\nabla^{2}f(z)v</annotation></semantics></math>. Noting that</span></p>
<table id="A10.E85" class="ltx_equationgroup ltx_eqn_table">
<tbody>
<tr id="A10.E85X" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A10.E85X.m2" class="ltx_Math" alttext="\displaystyle\nabla F_{s}^{\dagger}(z)[v]\nabla f(z)=" display="inline" intent=":literal"><semantics><mrow><mo rspace="0.167em">∇</mo><mi>F</mi><msub><mrow></mrow><mi>s</mi></msub><msup><mrow></mrow><mo>†</mo></msup><mo stretchy="false">(</mo><mi>z</mi><mo stretchy="false">)</mo><mo stretchy="false">[</mo><mi>v</mi><mo rspace="0.167em" stretchy="false">]</mo><mo rspace="0.167em">∇</mo><mi>f</mi><mo stretchy="false">(</mo><mi>z</mi><mo stretchy="false">)</mo><mo>=</mo></mrow><annotation encoding="application/x-tex">\displaystyle\nabla F_{s}^{\dagger}(z)[v]\nabla f(z)=</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A10.E85X.m3" class="ltx_Math" alttext="\displaystyle\nabla P_{s}(z)[v]F^{-1}(z)P_{s}(z)\nabla f(z)+P_{s}(z)\nabla F^{-1}(z)[v]P_{s}(z)\nabla f(z)+P_{s}(z)F^{-1}(z)\nabla P_{s}(z)[v]\nabla f(z)" display="inline" intent=":literal"><semantics><mrow><mo rspace="0.167em">∇</mo><mi>P</mi><msub><mrow></mrow><mi>s</mi></msub><mo stretchy="false">(</mo><mi>z</mi><mo stretchy="false">)</mo><mo stretchy="false">[</mo><mi>v</mi><mo stretchy="false">]</mo><mi>F</mi><msup><mrow></mrow><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo stretchy="false">(</mo><mi>z</mi><mo stretchy="false">)</mo><mi>P</mi><msub><mrow></mrow><mi>s</mi></msub><mo stretchy="false">(</mo><mi>z</mi><mo rspace="0.167em" stretchy="false">)</mo><mo rspace="0.167em">∇</mo><mi>f</mi><mo stretchy="false">(</mo><mi>z</mi><mo stretchy="false">)</mo><mo>+</mo><mi>P</mi><msub><mrow></mrow><mi>s</mi></msub><mo stretchy="false">(</mo><mi>z</mi><mo rspace="0.167em" stretchy="false">)</mo><mo rspace="0.167em">∇</mo><mi>F</mi><msup><mrow></mrow><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo stretchy="false">(</mo><mi>z</mi><mo stretchy="false">)</mo><mo stretchy="false">[</mo><mi>v</mi><mo stretchy="false">]</mo><mi>P</mi><msub><mrow></mrow><mi>s</mi></msub><mo stretchy="false">(</mo><mi>z</mi><mo rspace="0.167em" stretchy="false">)</mo><mo rspace="0.167em">∇</mo><mi>f</mi><mo stretchy="false">(</mo><mi>z</mi><mo stretchy="false">)</mo><mo>+</mo><mi>P</mi><msub><mrow></mrow><mi>s</mi></msub><mo stretchy="false">(</mo><mi>z</mi><mo stretchy="false">)</mo><mi>F</mi><msup><mrow></mrow><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo stretchy="false">(</mo><mi>z</mi><mo rspace="0.167em" stretchy="false">)</mo><mo rspace="0.167em">∇</mo><mi>P</mi><msub><mrow></mrow><mi>s</mi></msub><mo stretchy="false">(</mo><mi>z</mi><mo stretchy="false">)</mo><mo stretchy="false">[</mo><mi>v</mi><mo rspace="0.167em" stretchy="false">]</mo><mo rspace="0.167em">∇</mo><mi>f</mi><mo stretchy="false">(</mo><mi>z</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">\displaystyle\nabla P_{s}(z)[v]F^{-1}(z)P_{s}(z)\nabla f(z)+P_{s}(z)\nabla F^{-1}(z)[v]P_{s}(z)\nabla f(z)+P_{s}(z)F^{-1}(z)\nabla P_{s}(z)[v]\nabla f(z)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="2" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equationgroup ltx_align_right">(85)</span></td></tr>
<tr id="A10.E85Xa" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A10.E85Xa.m2" class="ltx_Math" alttext="\displaystyle=" display="inline" intent=":literal"><semantics><mo>=</mo><annotation encoding="application/x-tex">\displaystyle=</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A10.E85Xa.m3" class="ltx_Math" alttext="\displaystyle P_{s}(z)F^{-1}(z)\nabla P_{s}(z)[v]\nabla f(z)," display="inline" intent=":literal"><semantics><mrow><mi>P</mi><msub><mrow></mrow><mi>s</mi></msub><mo stretchy="false">(</mo><mi>z</mi><mo stretchy="false">)</mo><mi>F</mi><msup><mrow></mrow><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo stretchy="false">(</mo><mi>z</mi><mo rspace="0.167em" stretchy="false">)</mo><mo rspace="0.167em">∇</mo><mi>P</mi><msub><mrow></mrow><mi>s</mi></msub><mo stretchy="false">(</mo><mi>z</mi><mo stretchy="false">)</mo><mo stretchy="false">[</mo><mi>v</mi><mo rspace="0.167em" stretchy="false">]</mo><mo rspace="0.167em">∇</mo><mi>f</mi><mo stretchy="false">(</mo><mi>z</mi><mo stretchy="false">)</mo><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle P_{s}(z)F^{-1}(z)\nabla P_{s}(z)[v]\nabla f(z),</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A10.Thmtheorem2.p4.2" class="ltx_p"><span id="A10.Thmtheorem2.p4.2.1" class="ltx_text">the range of <math id="A10.Thmtheorem2.p4.m3" class="ltx_Math" alttext="T_{z}" display="inline" intent=":literal"><semantics><msub><mi>T</mi><mi>z</mi></msub><annotation encoding="application/x-tex">T_{z}</annotation></semantics></math> is a subspace of <math id="A10.Thmtheorem2.p4.m4" class="ltx_Math" alttext="\operatorname{Range}P_{s}(z)" display="inline" intent=":literal"><semantics><mrow><mrow><mi>Range</mi><mo lspace="0.167em">⁡</mo><msub><mi>P</mi><mi>s</mi></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>z</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\operatorname{Range}P_{s}(z)</annotation></semantics></math>. By Lemma <a href="#A10.Thmtheorem1" title="Lemma J.1. ‣ J.1 Landscape Analysis ‣ Appendix J Proof ‣ Accelerating LLM Pre-Training through Flat-Direction Dynamics Enhancement" class="ltx_ref"><span class="ltx_text ltx_ref_tag">J.1</span></a> and Assumption <a href="#S7.Thmtheorem2" title="Assumption 7.2 (Regularity, Smoothness and Conservation). ‣ 7 Theoretical Analysis to Training Dynamics ‣ Accelerating LLM Pre-Training through Flat-Direction Dynamics Enhancement" class="ltx_ref"><span class="ltx_text ltx_ref_tag">7.2</span></a>, for <math id="A10.Thmtheorem2.p4.m5" class="ltx_Math" alttext="v" display="inline" intent=":literal"><semantics><mi>v</mi><annotation encoding="application/x-tex">v</annotation></semantics></math> satisfying <math id="A10.Thmtheorem2.p4.m6" class="ltx_Math" alttext="P_{s}(z)v=v" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>P</mi><mi>s</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>z</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>v</mi></mrow><mo>=</mo><mi>v</mi></mrow><annotation encoding="application/x-tex">P_{s}(z)v=v</annotation></semantics></math>,</span></p>
<table id="A10.E86" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A10.E86.m1" class="ltx_Math" alttext="\|T_{z}(v)\|_{F(z)^{-1}}\geq\lambda_{H_{F,s}}\|v\|_{F(z)}-\frac{\delta_{F_{s}}}{G}\|\nabla f(z)\|_{F^{-1}(z)}\|v\|_{F(z)}\geq(\lambda_{H_{F,s}}-\delta_{F_{s}})\|v\|_{F(z)}." display="block" intent=":literal"><semantics><mrow><mrow><msub><mrow><mo stretchy="false">‖</mo><mrow><msub><mi>T</mi><mi>z</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>v</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">‖</mo></mrow><mrow><mi>F</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>z</mi><mo stretchy="false">)</mo></mrow><mrow><mo>−</mo><mn>1</mn></mrow></msup></mrow></msub><mo>≥</mo><mrow><mrow><msub><mi>λ</mi><msub><mi>H</mi><mrow><mi>F</mi><mo>,</mo><mi>s</mi></mrow></msub></msub><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">‖</mo><mi>v</mi><mo stretchy="false">‖</mo></mrow><mrow><mi>F</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>z</mi><mo stretchy="false">)</mo></mrow></mrow></msub></mrow><mo>−</mo><mrow><mfrac><msub><mi>δ</mi><msub><mi>F</mi><mi>s</mi></msub></msub><mi>G</mi></mfrac><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">‖</mo><mrow><mrow><mo rspace="0.167em">∇</mo><mi>f</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>z</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">‖</mo></mrow><mrow><msup><mi>F</mi><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>z</mi><mo stretchy="false">)</mo></mrow></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">‖</mo><mi>v</mi><mo stretchy="false">‖</mo></mrow><mrow><mi>F</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>z</mi><mo stretchy="false">)</mo></mrow></mrow></msub></mrow></mrow><mo>≥</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><msub><mi>λ</mi><msub><mi>H</mi><mrow><mi>F</mi><mo>,</mo><mi>s</mi></mrow></msub></msub><mo>−</mo><msub><mi>δ</mi><msub><mi>F</mi><mi>s</mi></msub></msub></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">‖</mo><mi>v</mi><mo stretchy="false">‖</mo></mrow><mrow><mi>F</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>z</mi><mo stretchy="false">)</mo></mrow></mrow></msub></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\|T_{z}(v)\|_{F(z)^{-1}}\geq\lambda_{H_{F,s}}\|v\|_{F(z)}-\frac{\delta_{F_{s}}}{G}\|\nabla f(z)\|_{F^{-1}(z)}\|v\|_{F(z)}\geq(\lambda_{H_{F,s}}-\delta_{F_{s}})\|v\|_{F(z)}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(86)</span></td></tr></tbody>
</table>
<p id="A10.Thmtheorem2.p4.3" class="ltx_p"><span id="A10.Thmtheorem2.p4.3.1" class="ltx_text">This implies that <math id="A10.Thmtheorem2.p4.m7" class="ltx_Math" alttext="T_{z}|_{\operatorname{Range}P_{s}(z)}:\operatorname{Range}P_{s}(z)\to\operatorname{Range}P_{s}(z)" display="inline" intent=":literal"><semantics><mrow><msub><mrow><msub><mi>T</mi><mi>z</mi></msub><mo stretchy="false">|</mo></mrow><mrow><mrow><mi>Range</mi><mo lspace="0.167em">⁡</mo><msub><mi>P</mi><mi>s</mi></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>z</mi><mo stretchy="false">)</mo></mrow></mrow></msub><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mrow><mrow><mi>Range</mi><mo lspace="0.167em">⁡</mo><msub><mi>P</mi><mi>s</mi></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>z</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">→</mo><mrow><mrow><mi>Range</mi><mo lspace="0.167em">⁡</mo><msub><mi>P</mi><mi>s</mi></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>z</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">T_{z}|_{\operatorname{Range}P_{s}(z)}:\operatorname{Range}P_{s}(z)\to\operatorname{Range}P_{s}(z)</annotation></semantics></math> is a linear isomorphism. Therefore, by (<a href="#A10.E84" title="Equation 84 ‣ Proof. ‣ Lemma J.2. ‣ J.1 Landscape Analysis ‣ Appendix J Proof ‣ Accelerating LLM Pre-Training through Flat-Direction Dynamics Enhancement" class="ltx_ref"><span class="ltx_text ltx_ref_tag">84</span></a>), we get that <math id="A10.Thmtheorem2.p4.m8" class="ltx_Math" alttext="\operatorname{Range}P_{s}(z)\subset\operatorname{Null}\nabla\Phi(z)" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mi>Range</mi><mo lspace="0.167em">⁡</mo><msub><mi>P</mi><mi>s</mi></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>z</mi><mo stretchy="false">)</mo></mrow></mrow><mo>⊂</mo><mrow><mi>Null</mi><mo lspace="0.167em">⁡</mo><mrow><mrow><mo rspace="0.167em">∇</mo><mi mathvariant="normal">Φ</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>z</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\operatorname{Range}P_{s}(z)\subset\operatorname{Null}\nabla\Phi(z)</annotation></semantics></math>, and <math id="A10.Thmtheorem2.p4.m9" class="ltx_Math" alttext="\dim(\operatorname{Null}\nabla\Phi(z))\geq\dim(\operatorname{Range}P_{s}(z))" display="inline" intent=":literal"><semantics><mrow><mrow><mo rspace="0em">dim</mo><mrow><mo stretchy="false">(</mo><mrow><mi>Null</mi><mo lspace="0.167em">⁡</mo><mrow><mrow><mo rspace="0.167em">∇</mo><mi mathvariant="normal">Φ</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>z</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo rspace="0.1389em">≥</mo><mrow><mo lspace="0.1389em" rspace="0em">dim</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mi>Range</mi><mo lspace="0.167em">⁡</mo><msub><mi>P</mi><mi>s</mi></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>z</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\dim(\operatorname{Null}\nabla\Phi(z))\geq\dim(\operatorname{Range}P_{s}(z))</annotation></semantics></math>.</span></p>
</div>
<div id="A10.Thmtheorem2.p5" class="ltx_para">
<p id="A10.Thmtheorem2.p5.1" class="ltx_p"><span id="A10.Thmtheorem2.p5.1.1" class="ltx_text">On the other hand, for any smoothed curve <math id="A10.Thmtheorem2.p5.m1" class="ltx_Math" alttext="\tilde{z}_{t}" display="inline" intent=":literal"><semantics><msub><mover accent="true"><mi>z</mi><mo>~</mo></mover><mi>t</mi></msub><annotation encoding="application/x-tex">\tilde{z}_{t}</annotation></semantics></math> on <math id="A10.Thmtheorem2.p5.m2" class="ltx_Math" alttext="\mathcal{R}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">ℛ</mi><annotation encoding="application/x-tex">\mathcal{R}</annotation></semantics></math>, <math id="A10.Thmtheorem2.p5.m3" class="ltx_Math" alttext="\nabla\Phi(\tilde{z}_{t})\dot{\tilde{z}}_{t}=\frac{d}{dt}\Phi(\tilde{z}_{t})=\dot{\tilde{z}}_{t}" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mo rspace="0.167em">∇</mo><mi mathvariant="normal">Φ</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi>z</mi><mo>~</mo></mover><mi>t</mi></msub><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mover accent="true"><mover accent="true"><mi>z</mi><mo>~</mo></mover><mo>˙</mo></mover><mi>t</mi></msub></mrow><mo>=</mo><mrow><mfrac><mi>d</mi><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></mfrac><mo lspace="0em" rspace="0em">​</mo><mi mathvariant="normal">Φ</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi>z</mi><mo>~</mo></mover><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><msub><mover accent="true"><mover accent="true"><mi>z</mi><mo>~</mo></mover><mo>˙</mo></mover><mi>t</mi></msub></mrow><annotation encoding="application/x-tex">\nabla\Phi(\tilde{z}_{t})\dot{\tilde{z}}_{t}=\frac{d}{dt}\Phi(\tilde{z}_{t})=\dot{\tilde{z}}_{t}</annotation></semantics></math>. Thus <math id="A10.Thmtheorem2.p5.m4" class="ltx_Math" alttext="\nabla\Phi(z)|_{T_{z}\mathcal{R}}=id" display="inline" intent=":literal"><semantics><mrow><msub><mrow><mrow><mrow><mo rspace="0.167em">∇</mo><mi mathvariant="normal">Φ</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>z</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">|</mo></mrow><mrow><msub><mi>T</mi><mi>z</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi class="ltx_font_mathcaligraphic">ℛ</mi></mrow></msub><mo>=</mo><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>d</mi></mrow></mrow><annotation encoding="application/x-tex">\nabla\Phi(z)|_{T_{z}\mathcal{R}}=id</annotation></semantics></math> for any <math id="A10.Thmtheorem2.p5.m5" class="ltx_Math" alttext="z\in\mathcal{R}" display="inline" intent=":literal"><semantics><mrow><mi>z</mi><mo>∈</mo><mi class="ltx_font_mathcaligraphic">ℛ</mi></mrow><annotation encoding="application/x-tex">z\in\mathcal{R}</annotation></semantics></math>. It yields <math id="A10.Thmtheorem2.p5.m6" class="ltx_Math" alttext="p=\dim(\operatorname{Range}\nabla\Phi(z))+\dim(\operatorname{Null}\nabla\Phi(z))\geq\dim(T_{z}\mathcal{R})+\dim(\operatorname{Range}P_{s}(z))\geq p" display="inline" intent=":literal"><semantics><mrow><mi>p</mi><mo rspace="0.1389em">=</mo><mrow><mrow><mo lspace="0.1389em" rspace="0em">dim</mo><mrow><mo stretchy="false">(</mo><mrow><mi>Range</mi><mo lspace="0.167em">⁡</mo><mrow><mrow><mo rspace="0.167em">∇</mo><mi mathvariant="normal">Φ</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>z</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mrow><mo lspace="0em" rspace="0em">dim</mo><mrow><mo stretchy="false">(</mo><mrow><mi>Null</mi><mo lspace="0.167em">⁡</mo><mrow><mrow><mo rspace="0.167em">∇</mo><mi mathvariant="normal">Φ</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>z</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo rspace="0.1389em">≥</mo><mrow><mrow><mo lspace="0.1389em" rspace="0em">dim</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>T</mi><mi>z</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi class="ltx_font_mathcaligraphic">ℛ</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mrow><mo lspace="0em" rspace="0em">dim</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mi>Range</mi><mo lspace="0.167em">⁡</mo><msub><mi>P</mi><mi>s</mi></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>z</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>≥</mo><mi>p</mi></mrow><annotation encoding="application/x-tex">p=\dim(\operatorname{Range}\nabla\Phi(z))+\dim(\operatorname{Null}\nabla\Phi(z))\geq\dim(T_{z}\mathcal{R})+\dim(\operatorname{Range}P_{s}(z))\geq p</annotation></semantics></math>, implying that <math id="A10.Thmtheorem2.p5.m7" class="ltx_Math" alttext="\operatorname{Range}P_{s}(z)=\operatorname{Null}\nabla\Phi(z)" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mi>Range</mi><mo lspace="0.167em">⁡</mo><msub><mi>P</mi><mi>s</mi></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>z</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mi>Null</mi><mo lspace="0.167em">⁡</mo><mrow><mrow><mo rspace="0.167em">∇</mo><mi mathvariant="normal">Φ</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>z</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\operatorname{Range}P_{s}(z)=\operatorname{Null}\nabla\Phi(z)</annotation></semantics></math>. We get the conclusion.
∎</span></p>
</div>
</div>
</div>
<div id="A10.SS1.p3" class="ltx_para">
<p id="A10.SS1.p3.1" class="ltx_p">By definition, <math id="A10.SS1.p3.m1" class="ltx_Math" alttext="f" display="inline" intent=":literal"><semantics><mi>f</mi><annotation encoding="application/x-tex">f</annotation></semantics></math> exhibits strong convexity along the sharp directions, and consequently inherits certain properties of strongly convex functions. We first present this characteristic (as well as <math id="A10.SS1.p3.m2" class="ltx_Math" alttext="L" display="inline" intent=":literal"><semantics><mi>L</mi><annotation encoding="application/x-tex">L</annotation></semantics></math>-smoothness) in Lemmas <a href="#A10.Thmtheorem3" title="Lemma J.3. ‣ J.1 Landscape Analysis ‣ Appendix J Proof ‣ Accelerating LLM Pre-Training through Flat-Direction Dynamics Enhancement" class="ltx_ref"><span class="ltx_text ltx_ref_tag">J.3</span></a> and <a href="#A10.Thmtheorem4" title="Lemma J.4. ‣ J.1 Landscape Analysis ‣ Appendix J Proof ‣ Accelerating LLM Pre-Training through Flat-Direction Dynamics Enhancement" class="ltx_ref"><span class="ltx_text ltx_ref_tag">J.4</span></a>.</p>
</div>
<div id="A10.Thmtheorem3" class="ltx_theorem ltx_theorem_lemma">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="A10.Thmtheorem3.2" class="ltx_text ltx_font_bold">Lemma J.3</span></span><span id="A10.Thmtheorem3.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="A10.Thmtheorem3.p1" class="ltx_para">
<p id="A10.Thmtheorem3.p1.3" class="ltx_p"><span id="A10.Thmtheorem3.p1.3.1" class="ltx_text ltx_font_italic">Suppose Assumptions <a href="#S7.Thmtheorem1" title="Assumption 7.1 (River Structure). ‣ 7 Theoretical Analysis to Training Dynamics ‣ Accelerating LLM Pre-Training through Flat-Direction Dynamics Enhancement" class="ltx_ref"><span class="ltx_text ltx_ref_tag">7.1</span></a> and <a href="#S7.Thmtheorem2" title="Assumption 7.2 (Regularity, Smoothness and Conservation). ‣ 7 Theoretical Analysis to Training Dynamics ‣ Accelerating LLM Pre-Training through Flat-Direction Dynamics Enhancement" class="ltx_ref"><span class="ltx_text ltx_ref_tag">7.2</span></a> hold.
Denote <math id="A10.Thmtheorem3.p1.m1" class="ltx_Math" alttext="\gamma=\lambda_{H_{F},s}-\frac{\delta_{F_{s}}}{2}" display="inline" intent=":literal"><semantics><mrow><mi>γ</mi><mo>=</mo><mrow><msub><mi>λ</mi><mrow><msub><mi>H</mi><mi>F</mi></msub><mo>,</mo><mi>s</mi></mrow></msub><mo>−</mo><mfrac><msub><mi>δ</mi><msub><mi>F</mi><mi>s</mi></msub></msub><mn>2</mn></mfrac></mrow></mrow><annotation encoding="application/x-tex">\gamma=\lambda_{H_{F},s}-\frac{\delta_{F_{s}}}{2}</annotation></semantics></math>, <math id="A10.Thmtheorem3.p1.m2" class="ltx_Math" alttext="\ell=L_{H_{F},s}+\frac{\delta_{F_{s}}}{2}" display="inline" intent=":literal"><semantics><mrow><mi mathvariant="normal">ℓ</mi><mo>=</mo><mrow><msub><mi>L</mi><mrow><msub><mi>H</mi><mi>F</mi></msub><mo>,</mo><mi>s</mi></mrow></msub><mo>+</mo><mfrac><msub><mi>δ</mi><msub><mi>F</mi><mi>s</mi></msub></msub><mn>2</mn></mfrac></mrow></mrow><annotation encoding="application/x-tex">\ell=L_{H_{F},s}+\frac{\delta_{F_{s}}}{2}</annotation></semantics></math>. Then for any <math id="A10.Thmtheorem3.p1.m3" class="ltx_Math" alttext="w\in U" display="inline" intent=":literal"><semantics><mrow><mi>w</mi><mo>∈</mo><mi>U</mi></mrow><annotation encoding="application/x-tex">w\in U</annotation></semantics></math> the following inequality hold</span></p>
<table id="A10.E87" class="ltx_equationgroup ltx_eqn_table">
<tbody>
<tr id="A10.E87X" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A10.E87X.m2" class="ltx_Math" alttext="\displaystyle\|P_{s}(\psi_{t}(w))F(\psi_{t}(w))^{-1}\nabla f(\psi_{t}(w))\|_{F(\psi_{t}(w))}\leq\exp(-\gamma t)\|P_{s}(w)F(w)^{-1}\nabla f(w)\|_{F(w)}," display="inline" intent=":literal"><semantics><mrow><mo rspace="0.167em">∥</mo><mi>P</mi><msub><mrow></mrow><mi>s</mi></msub><mo stretchy="false">(</mo><mi>ψ</mi><msub><mrow></mrow><mi>t</mi></msub><mo stretchy="false">(</mo><mi>w</mi><mo stretchy="false">)</mo><mo stretchy="false">)</mo><mi>F</mi><mo stretchy="false">(</mo><mi>ψ</mi><msub><mrow></mrow><mi>t</mi></msub><mo stretchy="false">(</mo><mi>w</mi><mo stretchy="false">)</mo><mo rspace="0.167em" stretchy="false">)</mo><msup><mrow></mrow><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo rspace="0.167em">∇</mo><mi>f</mi><mo stretchy="false">(</mo><mi>ψ</mi><msub><mrow></mrow><mi>t</mi></msub><mo stretchy="false">(</mo><mi>w</mi><mo stretchy="false">)</mo><mo stretchy="false">)</mo><mo lspace="0em" rspace="0.0835em">∥</mo><msub><mrow></mrow><mrow><mi>F</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>ψ</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>w</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></msub><mo lspace="0.0835em">≤</mo><mi>exp</mi><mo stretchy="false">(</mo><mo lspace="0em">−</mo><mi>γ</mi><mi>t</mi><mo stretchy="false">)</mo><mo lspace="0em" rspace="0.167em">∥</mo><mi>P</mi><msub><mrow></mrow><mi>s</mi></msub><mo stretchy="false">(</mo><mi>w</mi><mo stretchy="false">)</mo><mi>F</mi><mo stretchy="false">(</mo><mi>w</mi><mo rspace="0.167em" stretchy="false">)</mo><msup><mrow></mrow><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo rspace="0.167em">∇</mo><mi>f</mi><mo stretchy="false">(</mo><mi>w</mi><mo stretchy="false">)</mo><mo lspace="0em" rspace="0.167em">∥</mo><msub><mrow></mrow><mrow><mi>F</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>w</mi><mo stretchy="false">)</mo></mrow></mrow></msub><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\|P_{s}(\psi_{t}(w))F(\psi_{t}(w))^{-1}\nabla f(\psi_{t}(w))\|_{F(\psi_{t}(w))}\leq\exp(-\gamma t)\|P_{s}(w)F(w)^{-1}\nabla f(w)\|_{F(w)},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equationgroup ltx_align_right">(87)</span></td></tr></tbody>
</table>
<p id="A10.Thmtheorem3.p1.4" class="ltx_p"><span id="A10.Thmtheorem3.p1.4.1" class="ltx_text ltx_font_italic">and</span></p>
<table id="A10.E88" class="ltx_equationgroup ltx_eqn_table">
<tbody>
<tr id="A10.E88X" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A10.E88X.m2" class="ltx_Math" alttext="\displaystyle\|P_{s}(\psi_{t}(w))F(\psi_{t}(w))^{-1}\nabla f(\psi_{t}(w))\|_{F(\psi_{t}(w))}\geq\exp(-\ell t)\|P_{s}(w)F(w)^{-1}\nabla f(w)\|_{F(w)}." display="inline" intent=":literal"><semantics><mrow><mo rspace="0.167em">∥</mo><mi>P</mi><msub><mrow></mrow><mi>s</mi></msub><mo stretchy="false">(</mo><mi>ψ</mi><msub><mrow></mrow><mi>t</mi></msub><mo stretchy="false">(</mo><mi>w</mi><mo stretchy="false">)</mo><mo stretchy="false">)</mo><mi>F</mi><mo stretchy="false">(</mo><mi>ψ</mi><msub><mrow></mrow><mi>t</mi></msub><mo stretchy="false">(</mo><mi>w</mi><mo stretchy="false">)</mo><mo rspace="0.167em" stretchy="false">)</mo><msup><mrow></mrow><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo rspace="0.167em">∇</mo><mi>f</mi><mo stretchy="false">(</mo><mi>ψ</mi><msub><mrow></mrow><mi>t</mi></msub><mo stretchy="false">(</mo><mi>w</mi><mo stretchy="false">)</mo><mo stretchy="false">)</mo><mo lspace="0em" rspace="0.0835em">∥</mo><msub><mrow></mrow><mrow><mi>F</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>ψ</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>w</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></msub><mo lspace="0.0835em">≥</mo><mi>exp</mi><mo stretchy="false">(</mo><mo lspace="0em">−</mo><mi mathvariant="normal">ℓ</mi><mi>t</mi><mo stretchy="false">)</mo><mo lspace="0em" rspace="0.167em">∥</mo><mi>P</mi><msub><mrow></mrow><mi>s</mi></msub><mo stretchy="false">(</mo><mi>w</mi><mo stretchy="false">)</mo><mi>F</mi><mo stretchy="false">(</mo><mi>w</mi><mo rspace="0.167em" stretchy="false">)</mo><msup><mrow></mrow><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo rspace="0.167em">∇</mo><mi>f</mi><mo stretchy="false">(</mo><mi>w</mi><mo stretchy="false">)</mo><mo lspace="0em" rspace="0.0835em">∥</mo><msub><mrow></mrow><mrow><mi>F</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>w</mi><mo stretchy="false">)</mo></mrow></mrow></msub><mo lspace="0.0835em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\|P_{s}(\psi_{t}(w))F(\psi_{t}(w))^{-1}\nabla f(\psi_{t}(w))\|_{F(\psi_{t}(w))}\geq\exp(-\ell t)\|P_{s}(w)F(w)^{-1}\nabla f(w)\|_{F(w)}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equationgroup ltx_align_right">(88)</span></td></tr></tbody>
</table>
</div>
<div id="A10.Thmtheorem3.4" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="A10.Thmtheorem3.p2" class="ltx_para">
<table id="A10.E89" class="ltx_equationgroup ltx_eqn_table">
<tbody>
<tr id="A10.E89X" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A10.E89X.m2" class="ltx_Math" alttext="\displaystyle\frac{d}{dt}\|P_{s}F^{-1}\nabla f\|_{F}^{2}=" display="inline" intent=":literal"><semantics><mrow><mstyle displaystyle="true"><mfrac><mi>d</mi><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></mfrac></mstyle><mo lspace="0em" rspace="0.167em">∥</mo><mi>P</mi><msub><mrow></mrow><mi>s</mi></msub><mi>F</mi><msup><mrow></mrow><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0.167em" rspace="0.167em">∇</mo><mi>f</mi><mo lspace="0em" rspace="0.0835em">∥</mo><msub><mrow></mrow><mi>F</mi></msub><msup><mrow></mrow><mn>2</mn></msup><mo lspace="0.0835em">=</mo></mrow><annotation encoding="application/x-tex">\displaystyle\frac{d}{dt}\|P_{s}F^{-1}\nabla f\|_{F}^{2}=</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A10.E89X.m3" class="ltx_Math" alttext="\displaystyle 2\partial_{t}\psi_{t}(w)^{\top}\nabla^{2}fP_{s}F^{-1}\nabla f+\nabla f^{\top}\partial_{t}(P_{s}F^{-1}P_{s})\nabla f" display="inline" intent=":literal"><semantics><mrow><mn>2</mn><mo lspace="0em">∂</mo><msub><mrow></mrow><mi>t</mi></msub><mi>ψ</mi><msub><mrow></mrow><mi>t</mi></msub><mo stretchy="false">(</mo><mi>w</mi><mo rspace="0.167em" stretchy="false">)</mo><msup><mrow></mrow><mo>⊤</mo></msup><mo rspace="0.167em">∇</mo><msup><mrow></mrow><mn>2</mn></msup><mi>f</mi><mi>P</mi><msub><mrow></mrow><mi>s</mi></msub><mi>F</mi><msup><mrow></mrow><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0.167em" rspace="0.167em">∇</mo><mi>f</mi><mo>+</mo><mo rspace="0.167em">∇</mo><mi>f</mi><msup><mrow></mrow><mo>⊤</mo></msup><mo lspace="0em">∂</mo><msub><mrow></mrow><mi>t</mi></msub><mo stretchy="false">(</mo><mi>P</mi><msub><mrow></mrow><mi>s</mi></msub><mi>F</mi><msup><mrow></mrow><mrow><mo>−</mo><mn>1</mn></mrow></msup><mi>P</mi><msub><mrow></mrow><mi>s</mi></msub><mo rspace="0.167em" stretchy="false">)</mo><mo rspace="0.167em">∇</mo><mi>f</mi></mrow><annotation encoding="application/x-tex">\displaystyle 2\partial_{t}\psi_{t}(w)^{\top}\nabla^{2}fP_{s}F^{-1}\nabla f+\nabla f^{\top}\partial_{t}(P_{s}F^{-1}P_{s})\nabla f</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="3" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equationgroup ltx_align_right">(89)</span></td></tr>
<tr id="A10.E89Xa" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A10.E89Xa.m2" class="ltx_Math" alttext="\displaystyle=" display="inline" intent=":literal"><semantics><mo>=</mo><annotation encoding="application/x-tex">\displaystyle=</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A10.E89Xa.m3" class="ltx_Math" alttext="\displaystyle-2\nabla f^{\top}F^{-1}P_{s}\nabla^{2}fP_{s}F^{-1}\nabla f+\nabla f^{\top}\nabla(F_{s}^{\dagger})[-F_{s}^{\dagger}\nabla f]\nabla f" display="inline" intent=":literal"><semantics><mrow><mo>−</mo><mn>2</mn><mo lspace="0.167em" rspace="0.167em">∇</mo><mi>f</mi><msup><mrow></mrow><mo>⊤</mo></msup><mi>F</mi><msup><mrow></mrow><mrow><mo>−</mo><mn>1</mn></mrow></msup><mi>P</mi><msub><mrow></mrow><mi>s</mi></msub><mo lspace="0.167em" rspace="0.167em">∇</mo><msup><mrow></mrow><mn>2</mn></msup><mi>f</mi><mi>P</mi><msub><mrow></mrow><mi>s</mi></msub><mi>F</mi><msup><mrow></mrow><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0.167em" rspace="0.167em">∇</mo><mi>f</mi><mo>+</mo><mo rspace="0.167em">∇</mo><mi>f</mi><msup><mrow></mrow><mo>⊤</mo></msup><mo lspace="0.167em">∇</mo><mo stretchy="false">(</mo><mi>F</mi><msub><mrow></mrow><mi>s</mi></msub><msup><mrow></mrow><mo>†</mo></msup><mo stretchy="false">)</mo><mo stretchy="false">[</mo><mo lspace="0em">−</mo><mi>F</mi><msub><mrow></mrow><mi>s</mi></msub><msup><mrow></mrow><mo>†</mo></msup><mo lspace="0.167em" rspace="0.167em">∇</mo><mi>f</mi><mo rspace="0.167em" stretchy="false">]</mo><mo rspace="0.167em">∇</mo><mi>f</mi></mrow><annotation encoding="application/x-tex">\displaystyle-2\nabla f^{\top}F^{-1}P_{s}\nabla^{2}fP_{s}F^{-1}\nabla f+\nabla f^{\top}\nabla(F_{s}^{\dagger})[-F_{s}^{\dagger}\nabla f]\nabla f</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr>
<tr id="A10.E89Xb" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A10.E89Xb.m2" class="ltx_Math" alttext="\displaystyle\overset{\eqref{p-deltafinvs-u-v}}{\leq}" display="inline" intent=":literal"><semantics><mover accent="true"><mo>≤</mo><mrow><mtext mathsize="0.700em">(</mtext><mtext mathsize="0.700em"><a href="#A10.E78" title="Equation 78 ‣ Proof. ‣ Lemma J.1. ‣ J.1 Landscape Analysis ‣ Appendix J Proof ‣ Accelerating LLM Pre-Training through Flat-Direction Dynamics Enhancement" class="ltx_ref" style="font-size:70%;"><span class="ltx_text ltx_ref_tag">78</span></a></mtext><mtext mathsize="0.700em">)</mtext></mrow></mover><annotation encoding="application/x-tex">\displaystyle\overset{\eqref{p-deltafinvs-u-v}}{\leq}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A10.E89Xb.m3" class="ltx_Math" alttext="\displaystyle-2\lambda_{H_{F},s}\|P_{s}F^{-1}\nabla f\|_{F}^{2}+\delta_{F_{s}}\|P_{s}F^{-1}\nabla f\|_{F}^{2}." display="inline" intent=":literal"><semantics><mrow><mo>−</mo><mn>2</mn><mi>λ</mi><msub><mrow></mrow><mrow><msub><mi>H</mi><mi>F</mi></msub><mo>,</mo><mi>s</mi></mrow></msub><mo lspace="0em" rspace="0.167em">∥</mo><mi>P</mi><msub><mrow></mrow><mi>s</mi></msub><mi>F</mi><msup><mrow></mrow><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0.167em" rspace="0.167em">∇</mo><mi>f</mi><mo lspace="0em" rspace="0em">∥</mo><msub><mrow></mrow><mi>F</mi></msub><msup><mrow></mrow><mn>2</mn></msup><mo lspace="0em">+</mo><mi>δ</mi><msub><mrow></mrow><msub><mi>F</mi><mi>s</mi></msub></msub><mo lspace="0em" rspace="0.167em">∥</mo><mi>P</mi><msub><mrow></mrow><mi>s</mi></msub><mi>F</mi><msup><mrow></mrow><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0.167em" rspace="0.167em">∇</mo><mi>f</mi><mo lspace="0em" rspace="0.0835em">∥</mo><msub><mrow></mrow><mi>F</mi></msub><msup><mrow></mrow><mn>2</mn></msup><mo lspace="0.0835em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle-2\lambda_{H_{F},s}\|P_{s}F^{-1}\nabla f\|_{F}^{2}+\delta_{F_{s}}\|P_{s}F^{-1}\nabla f\|_{F}^{2}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="A10.Thmtheorem3.p3" class="ltx_para">
<p id="A10.Thmtheorem3.p3.1" class="ltx_p"><span id="A10.Thmtheorem3.p3.1.1" class="ltx_text">Using Gronwall’s inequality (Lemma <a href="#A10.Thmtheorem16" title="Lemma J.16 (Gronwall’s Inequality). ‣ Lemma J.14. ‣ J.3 Useful Lemmas ‣ Appendix J Proof ‣ Accelerating LLM Pre-Training through Flat-Direction Dynamics Enhancement" class="ltx_ref"><span class="ltx_text ltx_ref_tag">J.16</span></a>) gives</span></p>
<table id="A10.E90" class="ltx_equationgroup ltx_eqn_table">
<tbody>
<tr id="A10.E90X" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A10.E90X.m2" class="ltx_Math" alttext="\displaystyle\|P_{s}(\psi_{t}(w))F(\psi_{t}(w))^{-1}\nabla f(\psi_{t}(w))\|_{F(\psi_{t}(w))}^{2}\leq\exp(-2\gamma t)\|P_{s}(w)F(w)^{-1}\nabla f(w)\|_{F(w)}^{2}." display="inline" intent=":literal"><semantics><mrow><mo rspace="0.167em">∥</mo><mi>P</mi><msub><mrow></mrow><mi>s</mi></msub><mo stretchy="false">(</mo><mi>ψ</mi><msub><mrow></mrow><mi>t</mi></msub><mo stretchy="false">(</mo><mi>w</mi><mo stretchy="false">)</mo><mo stretchy="false">)</mo><mi>F</mi><mo stretchy="false">(</mo><mi>ψ</mi><msub><mrow></mrow><mi>t</mi></msub><mo stretchy="false">(</mo><mi>w</mi><mo stretchy="false">)</mo><mo rspace="0.167em" stretchy="false">)</mo><msup><mrow></mrow><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo rspace="0.167em">∇</mo><mi>f</mi><mo stretchy="false">(</mo><mi>ψ</mi><msub><mrow></mrow><mi>t</mi></msub><mo stretchy="false">(</mo><mi>w</mi><mo stretchy="false">)</mo><mo stretchy="false">)</mo><mo lspace="0em" rspace="0.0835em">∥</mo><msub><mrow></mrow><mrow><mi>F</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>ψ</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>w</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></msub><msup><mrow></mrow><mn>2</mn></msup><mo lspace="0.0835em">≤</mo><mi>exp</mi><mo stretchy="false">(</mo><mo lspace="0em">−</mo><mn>2</mn><mi>γ</mi><mi>t</mi><mo stretchy="false">)</mo><mo lspace="0em" rspace="0.167em">∥</mo><mi>P</mi><msub><mrow></mrow><mi>s</mi></msub><mo stretchy="false">(</mo><mi>w</mi><mo stretchy="false">)</mo><mi>F</mi><mo stretchy="false">(</mo><mi>w</mi><mo rspace="0.167em" stretchy="false">)</mo><msup><mrow></mrow><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo rspace="0.167em">∇</mo><mi>f</mi><mo stretchy="false">(</mo><mi>w</mi><mo stretchy="false">)</mo><mo lspace="0em" rspace="0.0835em">∥</mo><msub><mrow></mrow><mrow><mi>F</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>w</mi><mo stretchy="false">)</mo></mrow></mrow></msub><msup><mrow></mrow><mn>2</mn></msup><mo lspace="0.0835em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\|P_{s}(\psi_{t}(w))F(\psi_{t}(w))^{-1}\nabla f(\psi_{t}(w))\|_{F(\psi_{t}(w))}^{2}\leq\exp(-2\gamma t)\|P_{s}(w)F(w)^{-1}\nabla f(w)\|_{F(w)}^{2}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equationgroup ltx_align_right">(90)</span></td></tr></tbody>
</table>
</div>
<div id="A10.Thmtheorem3.p4" class="ltx_para">
<p id="A10.Thmtheorem3.p4.2" class="ltx_p"><span id="A10.Thmtheorem3.p4.2.1" class="ltx_text">On the other hand, we have</span></p>
<table id="A10.E91" class="ltx_equationgroup ltx_eqn_table">
<tbody>
<tr id="A10.E91X" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A10.E91X.m2" class="ltx_Math" alttext="\displaystyle\frac{d}{dt}\|P_{s}F^{-1}\nabla f\|_{F}^{2}=" display="inline" intent=":literal"><semantics><mrow><mstyle displaystyle="true"><mfrac><mi>d</mi><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></mfrac></mstyle><mo lspace="0em" rspace="0.167em">∥</mo><mi>P</mi><msub><mrow></mrow><mi>s</mi></msub><mi>F</mi><msup><mrow></mrow><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0.167em" rspace="0.167em">∇</mo><mi>f</mi><mo lspace="0em" rspace="0.0835em">∥</mo><msub><mrow></mrow><mi>F</mi></msub><msup><mrow></mrow><mn>2</mn></msup><mo lspace="0.0835em">=</mo></mrow><annotation encoding="application/x-tex">\displaystyle\frac{d}{dt}\|P_{s}F^{-1}\nabla f\|_{F}^{2}=</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A10.E91X.m3" class="ltx_Math" alttext="\displaystyle-2\nabla f^{\top}F^{-1}P_{s}\nabla^{2}fP_{s}F^{-1}\nabla f+\nabla f^{\top}\nabla(F_{s}^{\dagger})[-F_{s}^{\dagger}\nabla f]\nabla f" display="inline" intent=":literal"><semantics><mrow><mo>−</mo><mn>2</mn><mo lspace="0.167em" rspace="0.167em">∇</mo><mi>f</mi><msup><mrow></mrow><mo>⊤</mo></msup><mi>F</mi><msup><mrow></mrow><mrow><mo>−</mo><mn>1</mn></mrow></msup><mi>P</mi><msub><mrow></mrow><mi>s</mi></msub><mo lspace="0.167em" rspace="0.167em">∇</mo><msup><mrow></mrow><mn>2</mn></msup><mi>f</mi><mi>P</mi><msub><mrow></mrow><mi>s</mi></msub><mi>F</mi><msup><mrow></mrow><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0.167em" rspace="0.167em">∇</mo><mi>f</mi><mo>+</mo><mo rspace="0.167em">∇</mo><mi>f</mi><msup><mrow></mrow><mo>⊤</mo></msup><mo lspace="0.167em">∇</mo><mo stretchy="false">(</mo><mi>F</mi><msub><mrow></mrow><mi>s</mi></msub><msup><mrow></mrow><mo>†</mo></msup><mo stretchy="false">)</mo><mo stretchy="false">[</mo><mo lspace="0em">−</mo><mi>F</mi><msub><mrow></mrow><mi>s</mi></msub><msup><mrow></mrow><mo>†</mo></msup><mo lspace="0.167em" rspace="0.167em">∇</mo><mi>f</mi><mo rspace="0.167em" stretchy="false">]</mo><mo rspace="0.167em">∇</mo><mi>f</mi></mrow><annotation encoding="application/x-tex">\displaystyle-2\nabla f^{\top}F^{-1}P_{s}\nabla^{2}fP_{s}F^{-1}\nabla f+\nabla f^{\top}\nabla(F_{s}^{\dagger})[-F_{s}^{\dagger}\nabla f]\nabla f</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="2" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equationgroup ltx_align_right">(91)</span></td></tr>
<tr id="A10.E91Xa" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A10.E91Xa.m2" class="ltx_Math" alttext="\displaystyle\overset{\eqref{p-deltafinvs-u-v}}{\geq}" display="inline" intent=":literal"><semantics><mover accent="true"><mo>≥</mo><mrow><mtext mathsize="0.700em">(</mtext><mtext mathsize="0.700em"><a href="#A10.E78" title="Equation 78 ‣ Proof. ‣ Lemma J.1. ‣ J.1 Landscape Analysis ‣ Appendix J Proof ‣ Accelerating LLM Pre-Training through Flat-Direction Dynamics Enhancement" class="ltx_ref" style="font-size:70%;"><span class="ltx_text ltx_ref_tag">78</span></a></mtext><mtext mathsize="0.700em">)</mtext></mrow></mover><annotation encoding="application/x-tex">\displaystyle\overset{\eqref{p-deltafinvs-u-v}}{\geq}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A10.E91Xa.m3" class="ltx_Math" alttext="\displaystyle-2L_{H_{F},s}\|P_{s}F^{-1}\nabla f\|_{F}^{2}-\delta_{F_{s}}\|P_{s}F^{-1}\nabla f\|_{F}^{2}." display="inline" intent=":literal"><semantics><mrow><mo>−</mo><mn>2</mn><mi>L</mi><msub><mrow></mrow><mrow><msub><mi>H</mi><mi>F</mi></msub><mo>,</mo><mi>s</mi></mrow></msub><mo lspace="0em" rspace="0.167em">∥</mo><mi>P</mi><msub><mrow></mrow><mi>s</mi></msub><mi>F</mi><msup><mrow></mrow><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0.167em" rspace="0.167em">∇</mo><mi>f</mi><mo lspace="0em" rspace="0em">∥</mo><msub><mrow></mrow><mi>F</mi></msub><msup><mrow></mrow><mn>2</mn></msup><mo lspace="0em">−</mo><mi>δ</mi><msub><mrow></mrow><msub><mi>F</mi><mi>s</mi></msub></msub><mo lspace="0em" rspace="0.167em">∥</mo><mi>P</mi><msub><mrow></mrow><mi>s</mi></msub><mi>F</mi><msup><mrow></mrow><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0.167em" rspace="0.167em">∇</mo><mi>f</mi><mo lspace="0em" rspace="0.0835em">∥</mo><msub><mrow></mrow><mi>F</mi></msub><msup><mrow></mrow><mn>2</mn></msup><mo lspace="0.0835em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle-2L_{H_{F},s}\|P_{s}F^{-1}\nabla f\|_{F}^{2}-\delta_{F_{s}}\|P_{s}F^{-1}\nabla f\|_{F}^{2}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="A10.Thmtheorem3.p5" class="ltx_para">
<p id="A10.Thmtheorem3.p5.1" class="ltx_p"><span id="A10.Thmtheorem3.p5.1.1" class="ltx_text">Similarly, we get</span></p>
<table id="A10.E92" class="ltx_equationgroup ltx_eqn_table">
<tbody>
<tr id="A10.E92X" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A10.E92X.m2" class="ltx_Math" alttext="\displaystyle\|P_{s}(\psi_{t}(w))F(\psi_{t}(w))^{-1}\nabla f(\psi_{t}(w))\|_{F(\psi_{t}(w))}^{2}\geq\exp(-2\ell t)\|P_{s}(w)F(w)^{-1}\nabla f(w)\|_{F(w)}^{2}." display="inline" intent=":literal"><semantics><mrow><mo rspace="0.167em">∥</mo><mi>P</mi><msub><mrow></mrow><mi>s</mi></msub><mo stretchy="false">(</mo><mi>ψ</mi><msub><mrow></mrow><mi>t</mi></msub><mo stretchy="false">(</mo><mi>w</mi><mo stretchy="false">)</mo><mo stretchy="false">)</mo><mi>F</mi><mo stretchy="false">(</mo><mi>ψ</mi><msub><mrow></mrow><mi>t</mi></msub><mo stretchy="false">(</mo><mi>w</mi><mo stretchy="false">)</mo><mo rspace="0.167em" stretchy="false">)</mo><msup><mrow></mrow><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo rspace="0.167em">∇</mo><mi>f</mi><mo stretchy="false">(</mo><mi>ψ</mi><msub><mrow></mrow><mi>t</mi></msub><mo stretchy="false">(</mo><mi>w</mi><mo stretchy="false">)</mo><mo stretchy="false">)</mo><mo lspace="0em" rspace="0.0835em">∥</mo><msub><mrow></mrow><mrow><mi>F</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>ψ</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>w</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></msub><msup><mrow></mrow><mn>2</mn></msup><mo lspace="0.0835em">≥</mo><mi>exp</mi><mo stretchy="false">(</mo><mo lspace="0em">−</mo><mn>2</mn><mi mathvariant="normal">ℓ</mi><mi>t</mi><mo stretchy="false">)</mo><mo lspace="0em" rspace="0.167em">∥</mo><mi>P</mi><msub><mrow></mrow><mi>s</mi></msub><mo stretchy="false">(</mo><mi>w</mi><mo stretchy="false">)</mo><mi>F</mi><mo stretchy="false">(</mo><mi>w</mi><mo rspace="0.167em" stretchy="false">)</mo><msup><mrow></mrow><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo rspace="0.167em">∇</mo><mi>f</mi><mo stretchy="false">(</mo><mi>w</mi><mo stretchy="false">)</mo><mo lspace="0em" rspace="0.0835em">∥</mo><msub><mrow></mrow><mrow><mi>F</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>w</mi><mo stretchy="false">)</mo></mrow></mrow></msub><msup><mrow></mrow><mn>2</mn></msup><mo lspace="0.0835em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\|P_{s}(\psi_{t}(w))F(\psi_{t}(w))^{-1}\nabla f(\psi_{t}(w))\|_{F(\psi_{t}(w))}^{2}\geq\exp(-2\ell t)\|P_{s}(w)F(w)^{-1}\nabla f(w)\|_{F(w)}^{2}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equationgroup ltx_align_right">(92)</span></td></tr></tbody>
</table>
</div>
<div id="A10.Thmtheorem3.p6" class="ltx_para">
<p id="A10.Thmtheorem3.p6.1" class="ltx_p"><span id="A10.Thmtheorem3.p6.1.1" class="ltx_text">∎</span></p>
</div>
</div>
</div>
<div id="A10.Thmtheorem4" class="ltx_theorem ltx_theorem_lemma">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="A10.Thmtheorem4.2" class="ltx_text ltx_font_bold">Lemma J.4</span></span><span id="A10.Thmtheorem4.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="A10.Thmtheorem4.p1" class="ltx_para">
<p id="A10.Thmtheorem4.p1.1" class="ltx_p"><span id="A10.Thmtheorem4.p1.1.1" class="ltx_text ltx_font_italic">Suppose Assumptions <a href="#S7.Thmtheorem1" title="Assumption 7.1 (River Structure). ‣ 7 Theoretical Analysis to Training Dynamics ‣ Accelerating LLM Pre-Training through Flat-Direction Dynamics Enhancement" class="ltx_ref"><span class="ltx_text ltx_ref_tag">7.1</span></a> and <a href="#S7.Thmtheorem2" title="Assumption 7.2 (Regularity, Smoothness and Conservation). ‣ 7 Theoretical Analysis to Training Dynamics ‣ Accelerating LLM Pre-Training through Flat-Direction Dynamics Enhancement" class="ltx_ref"><span class="ltx_text ltx_ref_tag">7.2</span></a> hold. Then for any <math id="A10.Thmtheorem4.p1.m1" class="ltx_Math" alttext="w\in U" display="inline" intent=":literal"><semantics><mrow><mi>w</mi><mo>∈</mo><mi>U</mi></mrow><annotation encoding="application/x-tex">w\in U</annotation></semantics></math> we have</span></p>
<table id="A10.E93" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A10.E93.m1" class="ltx_Math" alttext="\frac{\gamma\lambda_{F_{s}}}{2}\|w-\Phi(w)\|_{2}^{2}\leq f(w)-f(\Phi(w))," display="block" intent=":literal"><semantics><mrow><mrow><mrow><mfrac><mrow><mi>γ</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>λ</mi><msub><mi>F</mi><mi>s</mi></msub></msub></mrow><mn>2</mn></mfrac><mo lspace="0em" rspace="0em">​</mo><msubsup><mrow><mo stretchy="false">‖</mo><mrow><mi>w</mi><mo>−</mo><mrow><mi mathvariant="normal">Φ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>w</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn><mn>2</mn></msubsup></mrow><mo>≤</mo><mrow><mrow><mi>f</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>w</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mi>f</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi mathvariant="normal">Φ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>w</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\frac{\gamma\lambda_{F_{s}}}{2}\|w-\Phi(w)\|_{2}^{2}\leq f(w)-f(\Phi(w)),</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(93)</span></td></tr></tbody>
</table>
<p id="A10.Thmtheorem4.p1.2" class="ltx_p"><span id="A10.Thmtheorem4.p1.2.1" class="ltx_text ltx_font_italic">and</span></p>
<table id="A10.E94" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A10.E94.m1" class="ltx_math_unparsed" alttext="\frac{1}{2\ell}\|P_{s}(w)F(w)^{-1}\nabla f(w)\|_{F(w)}^{2}\leq f(w)-f(\Phi(w))\leq\frac{1}{2\gamma}\|P_{s}(w)F(w)^{-1}\nabla f(w)\|_{F(w)}^{2}." display="block" intent=":literal"><semantics><mrow><mfrac><mn>1</mn><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi mathvariant="normal">ℓ</mi></mrow></mfrac><mo lspace="0em" rspace="0.167em">∥</mo><msub><mi>P</mi><mi>s</mi></msub><mrow><mo stretchy="false">(</mo><mi>w</mi><mo stretchy="false">)</mo></mrow><mi>F</mi><msup><mrow><mo stretchy="false">(</mo><mi>w</mi><mo rspace="0.167em" stretchy="false">)</mo></mrow><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo rspace="0.167em">∇</mo><mi>f</mi><mrow><mo stretchy="false">(</mo><mi>w</mi><mo stretchy="false">)</mo></mrow><msubsup><mo lspace="0em" rspace="0.0835em">∥</mo><mrow><mi>F</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>w</mi><mo stretchy="false">)</mo></mrow></mrow><mn>2</mn></msubsup><mo lspace="0.0835em">≤</mo><mi>f</mi><mrow><mo stretchy="false">(</mo><mi>w</mi><mo stretchy="false">)</mo></mrow><mo>−</mo><mi>f</mi><mrow><mo stretchy="false">(</mo><mi mathvariant="normal">Φ</mi><mrow><mo stretchy="false">(</mo><mi>w</mi><mo stretchy="false">)</mo></mrow><mo stretchy="false">)</mo></mrow><mo>≤</mo><mfrac><mn>1</mn><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>γ</mi></mrow></mfrac><mo lspace="0em" rspace="0.167em">∥</mo><msub><mi>P</mi><mi>s</mi></msub><mrow><mo stretchy="false">(</mo><mi>w</mi><mo stretchy="false">)</mo></mrow><mi>F</mi><msup><mrow><mo stretchy="false">(</mo><mi>w</mi><mo rspace="0.167em" stretchy="false">)</mo></mrow><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo rspace="0.167em">∇</mo><mi>f</mi><mrow><mo stretchy="false">(</mo><mi>w</mi><mo stretchy="false">)</mo></mrow><msubsup><mo lspace="0em" rspace="0.0835em">∥</mo><mrow><mi>F</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>w</mi><mo stretchy="false">)</mo></mrow></mrow><mn>2</mn></msubsup><mo lspace="0.0835em">.</mo></mrow><annotation encoding="application/x-tex">\frac{1}{2\ell}\|P_{s}(w)F(w)^{-1}\nabla f(w)\|_{F(w)}^{2}\leq f(w)-f(\Phi(w))\leq\frac{1}{2\gamma}\|P_{s}(w)F(w)^{-1}\nabla f(w)\|_{F(w)}^{2}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(94)</span></td></tr></tbody>
</table>
</div>
<div id="A10.Thmtheorem4.4" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="A10.Thmtheorem4.p2" class="ltx_para">
<p id="A10.Thmtheorem4.p2.1" class="ltx_p"><span id="A10.Thmtheorem4.p2.1.1" class="ltx_text">Given <math id="A10.Thmtheorem4.p2.m1" class="ltx_Math" alttext="w" display="inline" intent=":literal"><semantics><mi>w</mi><annotation encoding="application/x-tex">w</annotation></semantics></math>, define <math id="A10.Thmtheorem4.p2.m2" class="ltx_math_unparsed" alttext="a_{t}=\|P_{s}(\psi_{t}(w))F(\psi_{t}(w))^{-1}\nabla f(\psi_{t}(w))\|_{F(\psi_{t}(w))}" display="inline" intent=":literal"><semantics><mrow><msub><mi>a</mi><mi>t</mi></msub><mo rspace="0em">=</mo><mo lspace="0em" rspace="0.167em">∥</mo><msub><mi>P</mi><mi>s</mi></msub><mrow><mo stretchy="false">(</mo><msub><mi>ψ</mi><mi>t</mi></msub><mrow><mo stretchy="false">(</mo><mi>w</mi><mo stretchy="false">)</mo></mrow><mo stretchy="false">)</mo></mrow><mi>F</mi><msup><mrow><mo stretchy="false">(</mo><msub><mi>ψ</mi><mi>t</mi></msub><mrow><mo stretchy="false">(</mo><mi>w</mi><mo stretchy="false">)</mo></mrow><mo rspace="0.167em" stretchy="false">)</mo></mrow><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo rspace="0.167em">∇</mo><mi>f</mi><mrow><mo stretchy="false">(</mo><msub><mi>ψ</mi><mi>t</mi></msub><mrow><mo stretchy="false">(</mo><mi>w</mi><mo stretchy="false">)</mo></mrow><mo stretchy="false">)</mo></mrow><msub><mo lspace="0em">∥</mo><mrow><mi>F</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>ψ</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>w</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></msub></mrow><annotation encoding="application/x-tex">a_{t}=\|P_{s}(\psi_{t}(w))F(\psi_{t}(w))^{-1}\nabla f(\psi_{t}(w))\|_{F(\psi_{t}(w))}</annotation></semantics></math>. Then Lemma <a href="#A10.Thmtheorem3" title="Lemma J.3. ‣ J.1 Landscape Analysis ‣ Appendix J Proof ‣ Accelerating LLM Pre-Training through Flat-Direction Dynamics Enhancement" class="ltx_ref"><span class="ltx_text ltx_ref_tag">J.3</span></a> implies that for any <math id="A10.Thmtheorem4.p2.m3" class="ltx_Math" alttext="t,s&gt;0" display="inline" intent=":literal"><semantics><mrow><mrow><mi>t</mi><mo>,</mo><mi>s</mi></mrow><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">t,s&gt;0</annotation></semantics></math>, <math id="A10.Thmtheorem4.p2.m4" class="ltx_Math" alttext="a_{t+s}\leq e^{-\gamma s}a_{t}" display="inline" intent=":literal"><semantics><mrow><msub><mi>a</mi><mrow><mi>t</mi><mo>+</mo><mi>s</mi></mrow></msub><mo>≤</mo><mrow><msup><mi>e</mi><mrow><mo>−</mo><mrow><mi>γ</mi><mo lspace="0em" rspace="0em">​</mo><mi>s</mi></mrow></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>a</mi><mi>t</mi></msub></mrow></mrow><annotation encoding="application/x-tex">a_{t+s}\leq e^{-\gamma s}a_{t}</annotation></semantics></math>.
Note that <math id="A10.Thmtheorem4.p2.m5" class="ltx_math_unparsed" alttext="f(w)-f(\Phi(w))=\int_{0}^{\infty}\nabla f(\psi_{t}(w))^{\top}P_{s}(\psi_{t}(w))F(\psi_{t}(w))^{-1}\nabla f(\psi_{t}(w))dt=\int_{0}^{\infty}a_{t}^{2}dt" display="inline" intent=":literal"><semantics><mrow><mi>f</mi><mrow><mo stretchy="false">(</mo><mi>w</mi><mo stretchy="false">)</mo></mrow><mo>−</mo><mi>f</mi><mrow><mo stretchy="false">(</mo><mi mathvariant="normal">Φ</mi><mrow><mo stretchy="false">(</mo><mi>w</mi><mo stretchy="false">)</mo></mrow><mo stretchy="false">)</mo></mrow><mo rspace="0.111em">=</mo><msubsup><mo>∫</mo><mn>0</mn><mi mathvariant="normal">∞</mi></msubsup><mo rspace="0.167em">∇</mo><mi>f</mi><msup><mrow><mo stretchy="false">(</mo><msub><mi>ψ</mi><mi>t</mi></msub><mrow><mo stretchy="false">(</mo><mi>w</mi><mo stretchy="false">)</mo></mrow><mo stretchy="false">)</mo></mrow><mo>⊤</mo></msup><msub><mi>P</mi><mi>s</mi></msub><mrow><mo stretchy="false">(</mo><msub><mi>ψ</mi><mi>t</mi></msub><mrow><mo stretchy="false">(</mo><mi>w</mi><mo stretchy="false">)</mo></mrow><mo stretchy="false">)</mo></mrow><mi>F</mi><msup><mrow><mo stretchy="false">(</mo><msub><mi>ψ</mi><mi>t</mi></msub><mrow><mo stretchy="false">(</mo><mi>w</mi><mo stretchy="false">)</mo></mrow><mo rspace="0.167em" stretchy="false">)</mo></mrow><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo rspace="0.167em">∇</mo><mi>f</mi><mrow><mo stretchy="false">(</mo><msub><mi>ψ</mi><mi>t</mi></msub><mrow><mo stretchy="false">(</mo><mi>w</mi><mo stretchy="false">)</mo></mrow><mo stretchy="false">)</mo></mrow><mi>d</mi><mi>t</mi><mo rspace="0.111em">=</mo><msubsup><mo>∫</mo><mn>0</mn><mi mathvariant="normal">∞</mi></msubsup><msubsup><mi>a</mi><mi>t</mi><mn>2</mn></msubsup><mi>d</mi><mi>t</mi></mrow><annotation encoding="application/x-tex">f(w)-f(\Phi(w))=\int_{0}^{\infty}\nabla f(\psi_{t}(w))^{\top}P_{s}(\psi_{t}(w))F(\psi_{t}(w))^{-1}\nabla f(\psi_{t}(w))dt=\int_{0}^{\infty}a_{t}^{2}dt</annotation></semantics></math>, <math id="A10.Thmtheorem4.p2.m6" class="ltx_math_unparsed" alttext="\|w-\Phi(w)\|_{2}=\|\int_{0}^{\infty}P_{s}(\psi_{t}(w))F(\psi_{t}(w))^{-1}\nabla f(\psi_{t}(w))dt\|_{2}\leq\lambda_{F_{s}}^{-1/2}\int_{0}^{\infty}a_{t}dt" display="inline" intent=":literal"><semantics><mrow><mo rspace="0.167em">∥</mo><mi>w</mi><mo>−</mo><mi mathvariant="normal">Φ</mi><mrow><mo stretchy="false">(</mo><mi>w</mi><mo stretchy="false">)</mo></mrow><msub><mo lspace="0em" rspace="0.0835em">∥</mo><mn>2</mn></msub><mo lspace="0.0835em" rspace="0em">=</mo><mo lspace="0em" rspace="0em">∥</mo><msubsup><mo>∫</mo><mn>0</mn><mi mathvariant="normal">∞</mi></msubsup><msub><mi>P</mi><mi>s</mi></msub><mrow><mo stretchy="false">(</mo><msub><mi>ψ</mi><mi>t</mi></msub><mrow><mo stretchy="false">(</mo><mi>w</mi><mo stretchy="false">)</mo></mrow><mo stretchy="false">)</mo></mrow><mi>F</mi><msup><mrow><mo stretchy="false">(</mo><msub><mi>ψ</mi><mi>t</mi></msub><mrow><mo stretchy="false">(</mo><mi>w</mi><mo stretchy="false">)</mo></mrow><mo rspace="0.167em" stretchy="false">)</mo></mrow><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo rspace="0.167em">∇</mo><mi>f</mi><mrow><mo stretchy="false">(</mo><msub><mi>ψ</mi><mi>t</mi></msub><mrow><mo stretchy="false">(</mo><mi>w</mi><mo stretchy="false">)</mo></mrow><mo stretchy="false">)</mo></mrow><mi>d</mi><mi>t</mi><msub><mo lspace="0em" rspace="0.0835em">∥</mo><mn>2</mn></msub><mo lspace="0.0835em">≤</mo><msubsup><mi>λ</mi><msub><mi>F</mi><mi>s</mi></msub><mrow><mo>−</mo><mn>1</mn><mo>/</mo><mn>2</mn></mrow></msubsup><msubsup><mo>∫</mo><mn>0</mn><mi mathvariant="normal">∞</mi></msubsup><msub><mi>a</mi><mi>t</mi></msub><mi>d</mi><mi>t</mi></mrow><annotation encoding="application/x-tex">\|w-\Phi(w)\|_{2}=\|\int_{0}^{\infty}P_{s}(\psi_{t}(w))F(\psi_{t}(w))^{-1}\nabla f(\psi_{t}(w))dt\|_{2}\leq\lambda_{F_{s}}^{-1/2}\int_{0}^{\infty}a_{t}dt</annotation></semantics></math>. We have</span></p>
</div>
<div id="A10.Thmtheorem4.p3" class="ltx_para">
<table id="A10.E95" class="ltx_equationgroup ltx_eqn_table">
<tbody>
<tr id="A10.E95X" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A10.E95X.m2" class="ltx_Math" alttext="\displaystyle\lambda_{F_{s}}\|w-\Phi(w)\|_{2}^{2}\leq" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>λ</mi><msub><mi>F</mi><mi>s</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mrow><mo stretchy="false">‖</mo><mrow><mi>w</mi><mo>−</mo><mrow><mi mathvariant="normal">Φ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>w</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn><mn>2</mn></msubsup></mrow><mo>≤</mo><mphantom></mphantom></mrow><annotation encoding="application/x-tex">\displaystyle\lambda_{F_{s}}\|w-\Phi(w)\|_{2}^{2}\leq</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A10.E95X.m3" class="ltx_Math" alttext="\displaystyle\left(\int_{0}^{\infty}a_{t}dt\right)^{2}=\int_{0}^{\infty}\int_{0}^{\infty}a_{s}a_{t}dsdt=2\int_{0}^{\infty}dt\int_{t}^{\infty}a_{s}a_{t}ds" display="inline" intent=":literal"><semantics><mrow><msup><mrow><mo>(</mo><mrow><mstyle displaystyle="true"><msubsup><mo>∫</mo><mn>0</mn><mi mathvariant="normal">∞</mi></msubsup></mstyle><mrow><msub><mi>a</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo rspace="0em">𝑑</mo><mi>t</mi></mrow></mrow></mrow><mo>)</mo></mrow><mn>2</mn></msup><mo>=</mo><mrow><mstyle displaystyle="true"><msubsup><mo>∫</mo><mn>0</mn><mi mathvariant="normal">∞</mi></msubsup></mstyle><mrow><mstyle displaystyle="true"><msubsup><mo>∫</mo><mn>0</mn><mi mathvariant="normal">∞</mi></msubsup></mstyle><mrow><msub><mi>a</mi><mi>s</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>a</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo rspace="0em">𝑑</mo><mi>s</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo rspace="0em">𝑑</mo><mi>t</mi></mrow></mrow></mrow></mrow><mo>=</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><msubsup><mo>∫</mo><mn>0</mn><mi mathvariant="normal">∞</mi></msubsup></mstyle><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><msubsup><mo>∫</mo><mi>t</mi><mi mathvariant="normal">∞</mi></msubsup></mstyle><mrow><msub><mi>a</mi><mi>s</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>a</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo rspace="0em">𝑑</mo><mi>s</mi></mrow></mrow></mrow></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\left(\int_{0}^{\infty}a_{t}dt\right)^{2}=\int_{0}^{\infty}\int_{0}^{\infty}a_{s}a_{t}dsdt=2\int_{0}^{\infty}dt\int_{t}^{\infty}a_{s}a_{t}ds</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="2" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equationgroup ltx_align_right">(95)</span></td></tr>
<tr id="A10.E95Xa" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A10.E95Xa.m2" class="ltx_Math" alttext="\displaystyle\leq" display="inline" intent=":literal"><semantics><mo>≤</mo><annotation encoding="application/x-tex">\displaystyle\leq</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A10.E95Xa.m3" class="ltx_Math" alttext="\displaystyle 2\int_{0}^{\infty}a_{t}^{2}\left(\int_{t}^{\infty}e^{-\gamma(s-t)}ds\right)dt=\frac{2}{\gamma}\int_{0}^{\infty}a_{t}^{2}dt." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><msubsup><mo>∫</mo><mn>0</mn><mi mathvariant="normal">∞</mi></msubsup></mstyle><mrow><msubsup><mi>a</mi><mi>t</mi><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mstyle displaystyle="true"><msubsup><mo>∫</mo><mi>t</mi><mi mathvariant="normal">∞</mi></msubsup></mstyle><mrow><msup><mi>e</mi><mrow><mo>−</mo><mrow><mi>γ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>s</mi><mo>−</mo><mi>t</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo rspace="0em">d</mo><mi>s</mi></mrow></mrow></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo rspace="0em">d</mo><mi>t</mi></mrow></mrow></mrow></mrow><mo>=</mo><mrow><mstyle displaystyle="true"><mfrac><mn>2</mn><mi>γ</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><msubsup><mo>∫</mo><mn>0</mn><mi mathvariant="normal">∞</mi></msubsup></mstyle><mrow><msubsup><mi>a</mi><mi>t</mi><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo rspace="0em">d</mo><mi>t</mi></mrow></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle 2\int_{0}^{\infty}a_{t}^{2}\left(\int_{t}^{\infty}e^{-\gamma(s-t)}ds\right)dt=\frac{2}{\gamma}\int_{0}^{\infty}a_{t}^{2}dt.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="A10.Thmtheorem4.p4" class="ltx_para">
<p id="A10.Thmtheorem4.p4.1" class="ltx_p"><span id="A10.Thmtheorem4.p4.1.1" class="ltx_text">On the other hand, by Lemma <a href="#A10.Thmtheorem3" title="Lemma J.3. ‣ J.1 Landscape Analysis ‣ Appendix J Proof ‣ Accelerating LLM Pre-Training through Flat-Direction Dynamics Enhancement" class="ltx_ref"><span class="ltx_text ltx_ref_tag">J.3</span></a>, it holds that</span></p>
<table id="A10.E96" class="ltx_equationgroup ltx_eqn_table">
<tbody>
<tr id="A10.E96X" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A10.E96X.m2" class="ltx_Math" alttext="\displaystyle f(w)-f(\Phi(w))=" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mi>f</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>w</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mi>f</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi mathvariant="normal">Φ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>w</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>=</mo><mphantom></mphantom></mrow><annotation encoding="application/x-tex">\displaystyle f(w)-f(\Phi(w))=</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A10.E96X.m3" class="ltx_Math" alttext="\displaystyle\int_{0}^{\infty}\|P_{s}(\psi_{t}(w))F(\psi_{t}(w))^{-1}\nabla f(\psi_{t}(w))\|_{F(\psi_{t}(w))}^{2}dt" display="inline" intent=":literal"><semantics><mrow><mstyle displaystyle="true"><mo>∫</mo></mstyle><msub><mrow></mrow><mn>0</mn></msub><msup><mrow></mrow><mi mathvariant="normal">∞</mi></msup><mo lspace="0em" rspace="0.167em">∥</mo><mi>P</mi><msub><mrow></mrow><mi>s</mi></msub><mo stretchy="false">(</mo><mi>ψ</mi><msub><mrow></mrow><mi>t</mi></msub><mo stretchy="false">(</mo><mi>w</mi><mo stretchy="false">)</mo><mo stretchy="false">)</mo><mi>F</mi><mo stretchy="false">(</mo><mi>ψ</mi><msub><mrow></mrow><mi>t</mi></msub><mo stretchy="false">(</mo><mi>w</mi><mo stretchy="false">)</mo><mo rspace="0.167em" stretchy="false">)</mo><msup><mrow></mrow><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo rspace="0.167em">∇</mo><mi>f</mi><mo stretchy="false">(</mo><mi>ψ</mi><msub><mrow></mrow><mi>t</mi></msub><mo stretchy="false">(</mo><mi>w</mi><mo stretchy="false">)</mo><mo stretchy="false">)</mo><mo lspace="0em" rspace="0.167em">∥</mo><msub><mrow></mrow><mrow><mi>F</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>ψ</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>w</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></msub><msup><mrow></mrow><mn>2</mn></msup><mi>d</mi><mi>t</mi></mrow><annotation encoding="application/x-tex">\displaystyle\int_{0}^{\infty}\|P_{s}(\psi_{t}(w))F(\psi_{t}(w))^{-1}\nabla f(\psi_{t}(w))\|_{F(\psi_{t}(w))}^{2}dt</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="3" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equationgroup ltx_align_right">(96)</span></td></tr>
<tr id="A10.E96Xa" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A10.E96Xa.m2" class="ltx_Math" alttext="\displaystyle\leq" display="inline" intent=":literal"><semantics><mo>≤</mo><annotation encoding="application/x-tex">\displaystyle\leq</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A10.E96Xa.m3" class="ltx_Math" alttext="\displaystyle\int_{0}^{\infty}\exp(-2\gamma t)\|P_{s}(w)F(w)^{-1}\nabla f(w)\|_{F(w)}^{2}dt" display="inline" intent=":literal"><semantics><mrow><mstyle displaystyle="true"><mo>∫</mo></mstyle><msub><mrow></mrow><mn>0</mn></msub><msup><mrow></mrow><mi mathvariant="normal">∞</mi></msup><mi>exp</mi><mo stretchy="false">(</mo><mo lspace="0em">−</mo><mn>2</mn><mi>γ</mi><mi>t</mi><mo stretchy="false">)</mo><mo lspace="0em" rspace="0.167em">∥</mo><mi>P</mi><msub><mrow></mrow><mi>s</mi></msub><mo stretchy="false">(</mo><mi>w</mi><mo stretchy="false">)</mo><mi>F</mi><mo stretchy="false">(</mo><mi>w</mi><mo rspace="0.167em" stretchy="false">)</mo><msup><mrow></mrow><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo rspace="0.167em">∇</mo><mi>f</mi><mo stretchy="false">(</mo><mi>w</mi><mo stretchy="false">)</mo><mo lspace="0em" rspace="0.167em">∥</mo><msub><mrow></mrow><mrow><mi>F</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>w</mi><mo stretchy="false">)</mo></mrow></mrow></msub><msup><mrow></mrow><mn>2</mn></msup><mi>d</mi><mi>t</mi></mrow><annotation encoding="application/x-tex">\displaystyle\int_{0}^{\infty}\exp(-2\gamma t)\|P_{s}(w)F(w)^{-1}\nabla f(w)\|_{F(w)}^{2}dt</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr>
<tr id="A10.E96Xb" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A10.E96Xb.m2" class="ltx_Math" alttext="\displaystyle=" display="inline" intent=":literal"><semantics><mo>=</mo><annotation encoding="application/x-tex">\displaystyle=</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A10.E96Xb.m3" class="ltx_Math" alttext="\displaystyle\frac{1}{2\gamma}\|P_{s}(w)F(w)^{-1}\nabla f(w)\|_{F(w)}^{2}," display="inline" intent=":literal"><semantics><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>γ</mi></mrow></mfrac></mstyle><mo lspace="0em" rspace="0.167em">∥</mo><mi>P</mi><msub><mrow></mrow><mi>s</mi></msub><mo stretchy="false">(</mo><mi>w</mi><mo stretchy="false">)</mo><mi>F</mi><mo stretchy="false">(</mo><mi>w</mi><mo rspace="0.167em" stretchy="false">)</mo><msup><mrow></mrow><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo rspace="0.167em">∇</mo><mi>f</mi><mo stretchy="false">(</mo><mi>w</mi><mo stretchy="false">)</mo><mo lspace="0em" rspace="0.167em">∥</mo><msub><mrow></mrow><mrow><mi>F</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>w</mi><mo stretchy="false">)</mo></mrow></mrow></msub><msup><mrow></mrow><mn>2</mn></msup><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\frac{1}{2\gamma}\|P_{s}(w)F(w)^{-1}\nabla f(w)\|_{F(w)}^{2},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A10.Thmtheorem4.p4.2" class="ltx_p"><span id="A10.Thmtheorem4.p4.2.1" class="ltx_text">and</span></p>
<table id="A10.E97" class="ltx_equationgroup ltx_eqn_table">
<tbody>
<tr id="A10.E97X" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A10.E97X.m2" class="ltx_Math" alttext="\displaystyle f(w)-f(\Phi(w))=" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mi>f</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>w</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mi>f</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi mathvariant="normal">Φ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>w</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>=</mo><mphantom></mphantom></mrow><annotation encoding="application/x-tex">\displaystyle f(w)-f(\Phi(w))=</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A10.E97X.m3" class="ltx_Math" alttext="\displaystyle\int_{0}^{\infty}\|P_{s}(\psi_{t}(w))F(\psi_{t}(w))^{-1}\nabla f(\psi_{t}(w))\|_{F(\psi_{t}(w))}^{2}dt" display="inline" intent=":literal"><semantics><mrow><mstyle displaystyle="true"><mo>∫</mo></mstyle><msub><mrow></mrow><mn>0</mn></msub><msup><mrow></mrow><mi mathvariant="normal">∞</mi></msup><mo lspace="0em" rspace="0.167em">∥</mo><mi>P</mi><msub><mrow></mrow><mi>s</mi></msub><mo stretchy="false">(</mo><mi>ψ</mi><msub><mrow></mrow><mi>t</mi></msub><mo stretchy="false">(</mo><mi>w</mi><mo stretchy="false">)</mo><mo stretchy="false">)</mo><mi>F</mi><mo stretchy="false">(</mo><mi>ψ</mi><msub><mrow></mrow><mi>t</mi></msub><mo stretchy="false">(</mo><mi>w</mi><mo stretchy="false">)</mo><mo rspace="0.167em" stretchy="false">)</mo><msup><mrow></mrow><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo rspace="0.167em">∇</mo><mi>f</mi><mo stretchy="false">(</mo><mi>ψ</mi><msub><mrow></mrow><mi>t</mi></msub><mo stretchy="false">(</mo><mi>w</mi><mo stretchy="false">)</mo><mo stretchy="false">)</mo><mo lspace="0em" rspace="0.167em">∥</mo><msub><mrow></mrow><mrow><mi>F</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>ψ</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>w</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></msub><msup><mrow></mrow><mn>2</mn></msup><mi>d</mi><mi>t</mi></mrow><annotation encoding="application/x-tex">\displaystyle\int_{0}^{\infty}\|P_{s}(\psi_{t}(w))F(\psi_{t}(w))^{-1}\nabla f(\psi_{t}(w))\|_{F(\psi_{t}(w))}^{2}dt</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="3" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equationgroup ltx_align_right">(97)</span></td></tr>
<tr id="A10.E97Xa" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A10.E97Xa.m2" class="ltx_Math" alttext="\displaystyle\geq" display="inline" intent=":literal"><semantics><mo>≥</mo><annotation encoding="application/x-tex">\displaystyle\geq</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A10.E97Xa.m3" class="ltx_Math" alttext="\displaystyle\int_{0}^{\infty}\exp(-2\ell t)\|P_{s}(w)F(w)^{-1}\nabla f(w)\|_{F(w)}^{2}dt" display="inline" intent=":literal"><semantics><mrow><mstyle displaystyle="true"><mo>∫</mo></mstyle><msub><mrow></mrow><mn>0</mn></msub><msup><mrow></mrow><mi mathvariant="normal">∞</mi></msup><mi>exp</mi><mo stretchy="false">(</mo><mo lspace="0em">−</mo><mn>2</mn><mi mathvariant="normal">ℓ</mi><mi>t</mi><mo stretchy="false">)</mo><mo lspace="0em" rspace="0.167em">∥</mo><mi>P</mi><msub><mrow></mrow><mi>s</mi></msub><mo stretchy="false">(</mo><mi>w</mi><mo stretchy="false">)</mo><mi>F</mi><mo stretchy="false">(</mo><mi>w</mi><mo rspace="0.167em" stretchy="false">)</mo><msup><mrow></mrow><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo rspace="0.167em">∇</mo><mi>f</mi><mo stretchy="false">(</mo><mi>w</mi><mo stretchy="false">)</mo><mo lspace="0em" rspace="0.167em">∥</mo><msub><mrow></mrow><mrow><mi>F</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>w</mi><mo stretchy="false">)</mo></mrow></mrow></msub><msup><mrow></mrow><mn>2</mn></msup><mi>d</mi><mi>t</mi></mrow><annotation encoding="application/x-tex">\displaystyle\int_{0}^{\infty}\exp(-2\ell t)\|P_{s}(w)F(w)^{-1}\nabla f(w)\|_{F(w)}^{2}dt</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr>
<tr id="A10.E97Xb" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A10.E97Xb.m2" class="ltx_Math" alttext="\displaystyle=" display="inline" intent=":literal"><semantics><mo>=</mo><annotation encoding="application/x-tex">\displaystyle=</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A10.E97Xb.m3" class="ltx_Math" alttext="\displaystyle\frac{1}{2\ell}\|P_{s}(w)F(w)^{-1}\nabla f(w)\|_{F(w)}^{2}." display="inline" intent=":literal"><semantics><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi mathvariant="normal">ℓ</mi></mrow></mfrac></mstyle><mo lspace="0em" rspace="0.167em">∥</mo><mi>P</mi><msub><mrow></mrow><mi>s</mi></msub><mo stretchy="false">(</mo><mi>w</mi><mo stretchy="false">)</mo><mi>F</mi><mo stretchy="false">(</mo><mi>w</mi><mo rspace="0.167em" stretchy="false">)</mo><msup><mrow></mrow><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo rspace="0.167em">∇</mo><mi>f</mi><mo stretchy="false">(</mo><mi>w</mi><mo stretchy="false">)</mo><mo lspace="0em" rspace="0.0835em">∥</mo><msub><mrow></mrow><mrow><mi>F</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>w</mi><mo stretchy="false">)</mo></mrow></mrow></msub><msup><mrow></mrow><mn>2</mn></msup><mo lspace="0.0835em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\frac{1}{2\ell}\|P_{s}(w)F(w)^{-1}\nabla f(w)\|_{F(w)}^{2}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
