<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A10.E111Xc.m2" class="ltx_Math" alttext="\displaystyle\overset{\eqref{D-drt-Ff-nabla-Finvs}}{=}" display="inline" intent=":literal"><semantics><mover accent="true"><mo>=</mo><mrow><mtext mathsize="0.700em">(</mtext><mtext mathsize="0.700em"><a href="#A10.E110" title="Equation 110 ‣ Proof. ‣ Lemma J.5. ‣ J.1 Landscape Analysis ‣ Appendix J Proof ‣ Accelerating LLM Pre-Training through Flat-Direction Dynamics Enhancement" class="ltx_ref" style="font-size:70%;"><span class="ltx_text ltx_ref_tag">110</span></a></mtext><mtext mathsize="0.700em">)</mtext></mrow></mover><annotation encoding="application/x-tex">\displaystyle\overset{\eqref{D-drt-Ff-nabla-Finvs}}{=}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A10.E111Xc.m3" class="ltx_Math" alttext="\displaystyle\|P_{f}(\psi_{t}(w))\nabla P_{s}(\psi_{t}(w))[\partial_{w}\psi_{t}(w)v]F_{s}^{\dagger}(\psi_{t}(w))\nabla f(\psi_{t}(w))\|_{F(\psi_{t}(w))}" display="inline" intent=":literal"><semantics><mrow><mo rspace="0.167em">∥</mo><mi>P</mi><msub><mrow></mrow><mi>f</mi></msub><mo stretchy="false">(</mo><mi>ψ</mi><msub><mrow></mrow><mi>t</mi></msub><mo stretchy="false">(</mo><mi>w</mi><mo stretchy="false">)</mo><mo rspace="0.167em" stretchy="false">)</mo><mo rspace="0.167em">∇</mo><mi>P</mi><msub><mrow></mrow><mi>s</mi></msub><mo stretchy="false">(</mo><mi>ψ</mi><msub><mrow></mrow><mi>t</mi></msub><mo stretchy="false">(</mo><mi>w</mi><mo stretchy="false">)</mo><mo stretchy="false">)</mo><mo stretchy="false">[</mo><mo lspace="0em">∂</mo><msub><mrow></mrow><mi>w</mi></msub><mi>ψ</mi><msub><mrow></mrow><mi>t</mi></msub><mo stretchy="false">(</mo><mi>w</mi><mo stretchy="false">)</mo><mi>v</mi><mo stretchy="false">]</mo><mi>F</mi><msub><mrow></mrow><mi>s</mi></msub><msup><mrow></mrow><mo>†</mo></msup><mo stretchy="false">(</mo><mi>ψ</mi><msub><mrow></mrow><mi>t</mi></msub><mo stretchy="false">(</mo><mi>w</mi><mo stretchy="false">)</mo><mo rspace="0.167em" stretchy="false">)</mo><mo rspace="0.167em">∇</mo><mi>f</mi><mo stretchy="false">(</mo><mi>ψ</mi><msub><mrow></mrow><mi>t</mi></msub><mo stretchy="false">(</mo><mi>w</mi><mo stretchy="false">)</mo><mo stretchy="false">)</mo><mo lspace="0em">∥</mo><msub><mrow></mrow><mrow><mi>F</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>ψ</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>w</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></msub></mrow><annotation encoding="application/x-tex">\displaystyle\|P_{f}(\psi_{t}(w))\nabla P_{s}(\psi_{t}(w))[\partial_{w}\psi_{t}(w)v]F_{s}^{\dagger}(\psi_{t}(w))\nabla f(\psi_{t}(w))\|_{F(\psi_{t}(w))}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr>
<tr id="A10.E111Xd" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A10.E111Xd.m2" class="ltx_Math" alttext="\displaystyle\overset{\eqref{nabla-Ps}}{\leq}" display="inline" intent=":literal"><semantics><mover accent="true"><mo>≤</mo><mrow><mtext mathsize="0.700em">(</mtext><mtext mathsize="0.700em"><a href="#A10.E75" title="Equation 75 ‣ Notations ‣ Appendix J Proof ‣ Accelerating LLM Pre-Training through Flat-Direction Dynamics Enhancement" class="ltx_ref" style="font-size:70%;"><span class="ltx_text ltx_ref_tag">75</span></a></mtext><mtext mathsize="0.700em">)</mtext></mrow></mover><annotation encoding="application/x-tex">\displaystyle\overset{\eqref{nabla-Ps}}{\leq}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A10.E111Xd.m3" class="ltx_Math" alttext="\displaystyle\frac{\delta}{\|F_{s}^{\dagger}(\psi_{0}(w))\nabla f(\psi_{0}(w))\|_{F(\psi_{0}(w))}}\|\partial_{w}\psi_{t}(w)[v]\|_{F(\psi_{t}(w))}\|F_{s}^{\dagger}(\psi_{t}(w))\nabla f(\psi_{t}(w))\|_{F(\psi_{t}(w))}" display="inline" intent=":literal"><semantics><mrow><mstyle displaystyle="true"><mfrac><mi>δ</mi><mrow><mo rspace="0.167em">∥</mo><mi>F</mi><msub><mrow></mrow><mi>s</mi></msub><msup><mrow></mrow><mo>†</mo></msup><mo stretchy="false">(</mo><mi>ψ</mi><msub><mrow></mrow><mn>0</mn></msub><mo stretchy="false">(</mo><mi>w</mi><mo stretchy="false">)</mo><mo rspace="0.167em" stretchy="false">)</mo><mo rspace="0.167em">∇</mo><mi>f</mi><mo stretchy="false">(</mo><mi>ψ</mi><msub><mrow></mrow><mn>0</mn></msub><mo stretchy="false">(</mo><mi>w</mi><mo stretchy="false">)</mo><mo stretchy="false">)</mo><mo lspace="0em">∥</mo><msub><mrow></mrow><mrow><mi>F</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>ψ</mi><mn>0</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>w</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></msub></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">∥</mo><mo>∂</mo><msub><mrow></mrow><mi>w</mi></msub><mi>ψ</mi><msub><mrow></mrow><mi>t</mi></msub><mo stretchy="false">(</mo><mi>w</mi><mo stretchy="false">)</mo><mo stretchy="false">[</mo><mi>v</mi><mo stretchy="false">]</mo><mo lspace="0em" rspace="0.0835em">∥</mo><msub><mrow></mrow><mrow><mi>F</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>ψ</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>w</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></msub><mo lspace="0.0835em" rspace="0.167em">∥</mo><mi>F</mi><msub><mrow></mrow><mi>s</mi></msub><msup><mrow></mrow><mo>†</mo></msup><mo stretchy="false">(</mo><mi>ψ</mi><msub><mrow></mrow><mi>t</mi></msub><mo stretchy="false">(</mo><mi>w</mi><mo stretchy="false">)</mo><mo rspace="0.167em" stretchy="false">)</mo><mo rspace="0.167em">∇</mo><mi>f</mi><mo stretchy="false">(</mo><mi>ψ</mi><msub><mrow></mrow><mi>t</mi></msub><mo stretchy="false">(</mo><mi>w</mi><mo stretchy="false">)</mo><mo stretchy="false">)</mo><mo lspace="0em">∥</mo><msub><mrow></mrow><mrow><mi>F</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>ψ</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>w</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></msub></mrow><annotation encoding="application/x-tex">\displaystyle\frac{\delta}{\|F_{s}^{\dagger}(\psi_{0}(w))\nabla f(\psi_{0}(w))\|_{F(\psi_{0}(w))}}\|\partial_{w}\psi_{t}(w)[v]\|_{F(\psi_{t}(w))}\|F_{s}^{\dagger}(\psi_{t}(w))\nabla f(\psi_{t}(w))\|_{F(\psi_{t}(w))}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr>
<tr id="A10.E111Xe" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A10.E111Xe.m2" class="ltx_Math" alttext="\displaystyle\overset{\eqref{exp-decay-ps-nablaf}}{\leq}" display="inline" intent=":literal"><semantics><mover accent="true"><mo>≤</mo><mrow><mtext mathsize="0.700em">(</mtext><mtext mathsize="0.700em"><a href="#A10.E87" title="Equation 87 ‣ Lemma J.3. ‣ J.1 Landscape Analysis ‣ Appendix J Proof ‣ Accelerating LLM Pre-Training through Flat-Direction Dynamics Enhancement" class="ltx_ref" style="font-size:70%;"><span class="ltx_text ltx_ref_tag">87</span></a></mtext><mtext mathsize="0.700em">)</mtext></mrow></mover><annotation encoding="application/x-tex">\displaystyle\overset{\eqref{exp-decay-ps-nablaf}}{\leq}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A10.E111Xe.m3" class="ltx_Math" alttext="\displaystyle\delta e^{-\gamma t}\|\partial_{w}\psi_{t}(w)[v]\|_{F(\psi_{t}(w))}." display="inline" intent=":literal"><semantics><mrow><mrow><mi>δ</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>e</mi><mrow><mo>−</mo><mrow><mi>γ</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">‖</mo><mrow><msub><mo lspace="0em">∂</mo><mi>w</mi></msub><mrow><msub><mi>ψ</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>w</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mi>v</mi><mo stretchy="false">]</mo></mrow></mrow></mrow><mo stretchy="false">‖</mo></mrow><mrow><mi>F</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>ψ</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>w</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></msub></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\delta e^{-\gamma t}\|\partial_{w}\psi_{t}(w)[v]\|_{F(\psi_{t}(w))}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="A10.Thmtheorem5.p13" class="ltx_para">
<p id="A10.Thmtheorem5.p13.1" class="ltx_p"><span id="A10.Thmtheorem5.p13.1.1" class="ltx_text">Substituting (<a href="#A10.E109" title="Equation 109 ‣ Proof. ‣ Lemma J.5. ‣ J.1 Landscape Analysis ‣ Appendix J Proof ‣ Accelerating LLM Pre-Training through Flat-Direction Dynamics Enhancement" class="ltx_ref"><span class="ltx_text ltx_ref_tag">109</span></a>) and (<a href="#A10.E111" title="Equation 111 ‣ Proof. ‣ Lemma J.5. ‣ J.1 Landscape Analysis ‣ Appendix J Proof ‣ Accelerating LLM Pre-Training through Flat-Direction Dynamics Enhancement" class="ltx_ref"><span class="ltx_text ltx_ref_tag">111</span></a>) into (<a href="#A10.E108" title="Equation 108 ‣ Proof. ‣ Lemma J.5. ‣ J.1 Landscape Analysis ‣ Appendix J Proof ‣ Accelerating LLM Pre-Training through Flat-Direction Dynamics Enhancement" class="ltx_ref"><span class="ltx_text ltx_ref_tag">108</span></a>) yields</span></p>
</div>
<div id="A10.Thmtheorem5.p14" class="ltx_para">
<table id="A10.E112" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A10.E112.m1" class="ltx_Math" alttext="\left\|\frac{d}{dt}r_{t}\right\|_{F(\psi_{t}(w))}\leq 2\delta e^{-\gamma t}\|h_{t}+r_{t}\|_{F(\psi_{t}(w))}." display="block" intent=":literal"><semantics><mrow><mrow><msub><mrow><mo>‖</mo><mrow><mfrac><mi>d</mi><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></mfrac><mo lspace="0em" rspace="0em">​</mo><msub><mi>r</mi><mi>t</mi></msub></mrow><mo>‖</mo></mrow><mrow><mi>F</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>ψ</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>w</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></msub><mo>≤</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>δ</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>e</mi><mrow><mo>−</mo><mrow><mi>γ</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">‖</mo><mrow><msub><mi>h</mi><mi>t</mi></msub><mo>+</mo><msub><mi>r</mi><mi>t</mi></msub></mrow><mo stretchy="false">‖</mo></mrow><mrow><mi>F</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>ψ</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>w</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></msub></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\left\|\frac{d}{dt}r_{t}\right\|_{F(\psi_{t}(w))}\leq 2\delta e^{-\gamma t}\|h_{t}+r_{t}\|_{F(\psi_{t}(w))}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(112)</span></td></tr></tbody>
</table>
</div>
<div id="A10.Thmtheorem5.p15" class="ltx_para">
<p id="A10.Thmtheorem5.p15.1" class="ltx_p"><span id="A10.Thmtheorem5.p15.1.1" class="ltx_text">Now we combine (<a href="#A10.E107" title="Equation 107 ‣ Proof. ‣ Lemma J.5. ‣ J.1 Landscape Analysis ‣ Appendix J Proof ‣ Accelerating LLM Pre-Training through Flat-Direction Dynamics Enhancement" class="ltx_ref"><span class="ltx_text ltx_ref_tag">107</span></a>) and (<a href="#A10.E112" title="Equation 112 ‣ Proof. ‣ Lemma J.5. ‣ J.1 Landscape Analysis ‣ Appendix J Proof ‣ Accelerating LLM Pre-Training through Flat-Direction Dynamics Enhancement" class="ltx_ref"><span class="ltx_text ltx_ref_tag">112</span></a>) to get respective bounds. Denote <math id="A10.Thmtheorem5.p15.m1" class="ltx_Math" alttext="M_{t}=\sup_{0\leq s\leq t}\|r_{s}\|_{F(\psi_{s}(w))}" display="inline" intent=":literal"><semantics><mrow><msub><mi>M</mi><mi>t</mi></msub><mo rspace="0.1389em">=</mo><mrow><msub><mo lspace="0.1389em" rspace="0em">sup</mo><mrow><mn>0</mn><mo>≤</mo><mi>s</mi><mo>≤</mo><mi>t</mi></mrow></msub><msub><mrow><mo stretchy="false">‖</mo><msub><mi>r</mi><mi>s</mi></msub><mo stretchy="false">‖</mo></mrow><mrow><mi>F</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>ψ</mi><mi>s</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>w</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></msub></mrow></mrow><annotation encoding="application/x-tex">M_{t}=\sup_{0\leq s\leq t}\|r_{s}\|_{F(\psi_{s}(w))}</annotation></semantics></math>. Using Lemma <a href="#A10.Thmtheorem14" title="Lemma J.14. ‣ J.3 Useful Lemmas ‣ Appendix J Proof ‣ Accelerating LLM Pre-Training through Flat-Direction Dynamics Enhancement" class="ltx_ref"><span class="ltx_text ltx_ref_tag">J.14</span></a> to (<a href="#A10.E107" title="Equation 107 ‣ Proof. ‣ Lemma J.5. ‣ J.1 Landscape Analysis ‣ Appendix J Proof ‣ Accelerating LLM Pre-Training through Flat-Direction Dynamics Enhancement" class="ltx_ref"><span class="ltx_text ltx_ref_tag">107</span></a>) gives</span></p>
</div>
<div id="A10.Thmtheorem5.p16" class="ltx_para">
<table id="A10.EGx21" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A10.E113"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A10.E113.m1" class="ltx_Math" alttext="\displaystyle\|h_{t}\|_{F(\psi_{t}(w))}" display="inline" intent=":literal"><semantics><msub><mrow><mo stretchy="false">‖</mo><msub><mi>h</mi><mi>t</mi></msub><mo stretchy="false">‖</mo></mrow><mrow><mi>F</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>ψ</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>w</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></msub><annotation encoding="application/x-tex">\displaystyle\|h_{t}\|_{F(\psi_{t}(w))}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A10.E113.m2" class="ltx_Math" alttext="\displaystyle\leq e^{-\mu_{1}t}\|h_{0}\|_{F(\psi_{0}(w))}+\frac{1}{2}\delta_{F_{s}}e^{-\mu_{1}t}\int_{0}^{t}e^{\mu_{1}s}\|r_{s}\|_{F(\psi_{s}(w))}ds" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≤</mo><mrow><mrow><msup><mi>e</mi><mrow><mo>−</mo><mrow><msub><mi>μ</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">‖</mo><msub><mi>h</mi><mn>0</mn></msub><mo stretchy="false">‖</mo></mrow><mrow><mi>F</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>ψ</mi><mn>0</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>w</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></msub></mrow><mo>+</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mn>2</mn></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msub><mi>δ</mi><msub><mi>F</mi><mi>s</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><msup><mi>e</mi><mrow><mo>−</mo><mrow><msub><mi>μ</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><msubsup><mo>∫</mo><mn>0</mn><mi>t</mi></msubsup></mstyle><mrow><msup><mi>e</mi><mrow><msub><mi>μ</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mi>s</mi></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">‖</mo><msub><mi>r</mi><mi>s</mi></msub><mo stretchy="false">‖</mo></mrow><mrow><mi>F</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>ψ</mi><mi>s</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>w</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo rspace="0em">𝑑</mo><mi>s</mi></mrow></mrow></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\leq e^{-\mu_{1}t}\|h_{0}\|_{F(\psi_{0}(w))}+\frac{1}{2}\delta_{F_{s}}e^{-\mu_{1}t}\int_{0}^{t}e^{\mu_{1}s}\|r_{s}\|_{F(\psi_{s}(w))}ds</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(113)</span></td></tr></tbody>
<tbody id="A10.E114"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A10.E114.m1" class="ltx_Math" alttext="\displaystyle\leq e^{-\mu_{1}t}\|h_{0}\|_{F(\psi_{0}(w))}+\frac{\delta_{F_{s}}}{2\mu_{1}}M_{t}." display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>≤</mo><mrow><mrow><msup><mi>e</mi><mrow><mo>−</mo><mrow><msub><mi>μ</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">‖</mo><msub><mi>h</mi><mn>0</mn></msub><mo stretchy="false">‖</mo></mrow><mrow><mi>F</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>ψ</mi><mn>0</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>w</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></msub></mrow><mo>+</mo><mrow><mstyle displaystyle="true"><mfrac><msub><mi>δ</mi><msub><mi>F</mi><mi>s</mi></msub></msub><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>μ</mi><mn>1</mn></msub></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msub><mi>M</mi><mi>t</mi></msub></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\leq e^{-\mu_{1}t}\|h_{0}\|_{F(\psi_{0}(w))}+\frac{\delta_{F_{s}}}{2\mu_{1}}M_{t}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(114)</span></td></tr></tbody>
</table>
</div>
<div id="A10.Thmtheorem5.p17" class="ltx_para">
<p id="A10.Thmtheorem5.p17.1" class="ltx_p"><span id="A10.Thmtheorem5.p17.1.1" class="ltx_text">Thus for any <math id="A10.Thmtheorem5.p17.m1" class="ltx_Math" alttext="t\geq 0" display="inline" intent=":literal"><semantics><mrow><mi>t</mi><mo>≥</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">t\geq 0</annotation></semantics></math>,</span></p>
</div>
<div id="A10.Thmtheorem5.p18" class="ltx_para">
<table id="A10.EGx22" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A10.E115"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A10.E115.m1" class="ltx_Math" alttext="\displaystyle\|r_{t}-r_{0}\|_{2}\leq" display="inline" intent=":literal"><semantics><mrow><msub><mrow><mo stretchy="false">‖</mo><mrow><msub><mi>r</mi><mi>t</mi></msub><mo>−</mo><msub><mi>r</mi><mn>0</mn></msub></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn></msub><mo>≤</mo><mphantom></mphantom></mrow><annotation encoding="application/x-tex">\displaystyle\|r_{t}-r_{0}\|_{2}\leq</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A10.E115.m2" class="ltx_Math" alttext="\displaystyle\int_{0}^{t}\left\|\frac{d}{dr}r_{s}\right\|_{2}ds\leq\lambda_{F_{s}}^{-1}\int_{0}^{t}\left\|\frac{d}{dr}r_{s}\right\|_{F(\psi_{s}(w))}ds" display="inline" intent=":literal"><semantics><mrow><mrow><mstyle displaystyle="true"><msubsup><mo>∫</mo><mn>0</mn><mi>t</mi></msubsup></mstyle><mrow><msub><mrow><mo>‖</mo><mrow><mstyle displaystyle="true"><mfrac><mi>d</mi><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msub><mi>r</mi><mi>s</mi></msub></mrow><mo>‖</mo></mrow><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo rspace="0em">𝑑</mo><mi>s</mi></mrow></mrow></mrow><mo>≤</mo><mrow><msubsup><mi>λ</mi><msub><mi>F</mi><mi>s</mi></msub><mrow><mo>−</mo><mn>1</mn></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><msubsup><mo>∫</mo><mn>0</mn><mi>t</mi></msubsup></mstyle><mrow><msub><mrow><mo>‖</mo><mrow><mstyle displaystyle="true"><mfrac><mi>d</mi><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msub><mi>r</mi><mi>s</mi></msub></mrow><mo>‖</mo></mrow><mrow><mi>F</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>ψ</mi><mi>s</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>w</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo rspace="0em">𝑑</mo><mi>s</mi></mrow></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\int_{0}^{t}\left\|\frac{d}{dr}r_{s}\right\|_{2}ds\leq\lambda_{F_{s}}^{-1}\int_{0}^{t}\left\|\frac{d}{dr}r_{s}\right\|_{F(\psi_{s}(w))}ds</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(115)</span></td></tr></tbody>
<tbody id="A10.E116"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A10.E116.m1" class="ltx_Math" alttext="\displaystyle\overset{\eqref{dot-t-l2}}{\leq}" display="inline" intent=":literal"><semantics><mover accent="true"><mo>≤</mo><mrow><mtext mathsize="0.700em">(</mtext><mtext mathsize="0.700em"><a href="#A10.E112" title="Equation 112 ‣ Proof. ‣ Lemma J.5. ‣ J.1 Landscape Analysis ‣ Appendix J Proof ‣ Accelerating LLM Pre-Training through Flat-Direction Dynamics Enhancement" class="ltx_ref" style="font-size:70%;"><span class="ltx_text ltx_ref_tag">112</span></a></mtext><mtext mathsize="0.700em">)</mtext></mrow></mover><annotation encoding="application/x-tex">\displaystyle\overset{\eqref{dot-t-l2}}{\leq}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A10.E116.m2" class="ltx_Math" alttext="\displaystyle\lambda_{F_{s}}^{-1}\int_{0}^{t}2\delta e^{-\gamma s}(\|h_{s}\|_{F(\psi_{s}(w))}+\|r_{s}\|_{F(\psi_{s}(w))})ds" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>λ</mi><msub><mi>F</mi><mi>s</mi></msub><mrow><mo>−</mo><mn>1</mn></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><msubsup><mo>∫</mo><mn>0</mn><mi>t</mi></msubsup></mstyle><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>δ</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>e</mi><mrow><mo>−</mo><mrow><mi>γ</mi><mo lspace="0em" rspace="0em">​</mo><mi>s</mi></mrow></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mrow><mo stretchy="false">‖</mo><msub><mi>h</mi><mi>s</mi></msub><mo stretchy="false">‖</mo></mrow><mrow><mi>F</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>ψ</mi><mi>s</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>w</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></msub><mo>+</mo><msub><mrow><mo stretchy="false">‖</mo><msub><mi>r</mi><mi>s</mi></msub><mo stretchy="false">‖</mo></mrow><mrow><mi>F</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>ψ</mi><mi>s</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>w</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></msub></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo rspace="0em">𝑑</mo><mi>s</mi></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\lambda_{F_{s}}^{-1}\int_{0}^{t}2\delta e^{-\gamma s}(\|h_{s}\|_{F(\psi_{s}(w))}+\|r_{s}\|_{F(\psi_{s}(w))})ds</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(116)</span></td></tr></tbody>
<tbody id="A10.E117"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A10.E117.m1" class="ltx_Math" alttext="\displaystyle\overset{\eqref{ht-bound-2}}{\leq}" display="inline" intent=":literal"><semantics><mover accent="true"><mo>≤</mo><mrow><mtext mathsize="0.700em">(</mtext><mtext mathsize="0.700em"><a href="#A10.E114" title="Equation 114 ‣ Proof. ‣ Lemma J.5. ‣ J.1 Landscape Analysis ‣ Appendix J Proof ‣ Accelerating LLM Pre-Training through Flat-Direction Dynamics Enhancement" class="ltx_ref" style="font-size:70%;"><span class="ltx_text ltx_ref_tag">114</span></a></mtext><mtext mathsize="0.700em">)</mtext></mrow></mover><annotation encoding="application/x-tex">\displaystyle\overset{\eqref{ht-bound-2}}{\leq}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A10.E117.m2" class="ltx_Math" alttext="\displaystyle 2\delta\lambda_{F_{s}}^{-1}\int_{0}^{t}e^{-\gamma s}\left(e^{-\mu_{1}s}\|h_{0}\|_{F(w)}+\left(1+\frac{\delta_{F_{s}}}{2\mu_{1}}\right)M_{t}\right)ds" display="inline" intent=":literal"><semantics><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>δ</mi><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>λ</mi><msub><mi>F</mi><mi>s</mi></msub><mrow><mo>−</mo><mn>1</mn></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><msubsup><mo>∫</mo><mn>0</mn><mi>t</mi></msubsup></mstyle><mrow><msup><mi>e</mi><mrow><mo>−</mo><mrow><mi>γ</mi><mo lspace="0em" rspace="0em">​</mo><mi>s</mi></mrow></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mrow><msup><mi>e</mi><mrow><mo>−</mo><mrow><msub><mi>μ</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mi>s</mi></mrow></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">‖</mo><msub><mi>h</mi><mn>0</mn></msub><mo stretchy="false">‖</mo></mrow><mrow><mi>F</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>w</mi><mo stretchy="false">)</mo></mrow></mrow></msub></mrow><mo>+</mo><mrow><mrow><mo>(</mo><mrow><mn>1</mn><mo>+</mo><mstyle displaystyle="true"><mfrac><msub><mi>δ</mi><msub><mi>F</mi><mi>s</mi></msub></msub><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>μ</mi><mn>1</mn></msub></mrow></mfrac></mstyle></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>M</mi><mi>t</mi></msub></mrow></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo rspace="0em">𝑑</mo><mi>s</mi></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle 2\delta\lambda_{F_{s}}^{-1}\int_{0}^{t}e^{-\gamma s}\left(e^{-\mu_{1}s}\|h_{0}\|_{F(w)}+\left(1+\frac{\delta_{F_{s}}}{2\mu_{1}}\right)M_{t}\right)ds</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(117)</span></td></tr></tbody>
<tbody id="A10.E118"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A10.E118.m1" class="ltx_Math" alttext="\displaystyle{\leq}" display="inline" intent=":literal"><semantics><mo>≤</mo><annotation encoding="application/x-tex">\displaystyle{\leq}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A10.E118.m2" class="ltx_Math" alttext="\displaystyle 2\delta\lambda_{F_{s}}^{-1}\left(\frac{\|h_{0}\|_{F(w)}}{\gamma+\mu_{1}}+\frac{1}{\gamma}\left(1+\frac{\delta_{F_{s}}}{2\mu_{1}}\right)M_{t}\right)." display="inline" intent=":literal"><semantics><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>δ</mi><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>λ</mi><msub><mi>F</mi><mi>s</mi></msub><mrow><mo>−</mo><mn>1</mn></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mstyle displaystyle="true"><mfrac><msub><mrow><mo stretchy="false">‖</mo><msub><mi>h</mi><mn>0</mn></msub><mo stretchy="false">‖</mo></mrow><mrow><mi>F</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>w</mi><mo stretchy="false">)</mo></mrow></mrow></msub><mrow><mi>γ</mi><mo>+</mo><msub><mi>μ</mi><mn>1</mn></msub></mrow></mfrac></mstyle><mo>+</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>γ</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mn>1</mn><mo>+</mo><mstyle displaystyle="true"><mfrac><msub><mi>δ</mi><msub><mi>F</mi><mi>s</mi></msub></msub><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>μ</mi><mn>1</mn></msub></mrow></mfrac></mstyle></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>M</mi><mi>t</mi></msub></mrow></mrow><mo>)</mo></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle 2\delta\lambda_{F_{s}}^{-1}\left(\frac{\|h_{0}\|_{F(w)}}{\gamma+\mu_{1}}+\frac{1}{\gamma}\left(1+\frac{\delta_{F_{s}}}{2\mu_{1}}\right)M_{t}\right).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(118)</span></td></tr></tbody>
</table>
</div>
<div id="A10.Thmtheorem5.p19" class="ltx_para">
<p id="A10.Thmtheorem5.p19.1" class="ltx_p"><span id="A10.Thmtheorem5.p19.1.1" class="ltx_text">Using <math id="A10.Thmtheorem5.p19.m1" class="ltx_Math" alttext="M_{t}\leq\rho(\|r_{0}\|_{2}+\sup_{0\leq s\leq t}\|r_{s}-r_{0}\|_{2})" display="inline" intent=":literal"><semantics><mrow><msub><mi>M</mi><mi>t</mi></msub><mo>≤</mo><mrow><mi>ρ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mrow><mo stretchy="false">‖</mo><msub><mi>r</mi><mn>0</mn></msub><mo stretchy="false">‖</mo></mrow><mn>2</mn></msub><mo>+</mo><mrow><msub><mo lspace="0em" rspace="0em">sup</mo><mrow><mn>0</mn><mo>≤</mo><mi>s</mi><mo>≤</mo><mi>t</mi></mrow></msub><msub><mrow><mo stretchy="false">‖</mo><mrow><msub><mi>r</mi><mi>s</mi></msub><mo>−</mo><msub><mi>r</mi><mn>0</mn></msub></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn></msub></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">M_{t}\leq\rho(\|r_{0}\|_{2}+\sup_{0\leq s\leq t}\|r_{s}-r_{0}\|_{2})</annotation></semantics></math> and <math id="A10.Thmtheorem5.p19.m2" class="ltx_Math" alttext="2\delta\lambda_{F_{s}}^{-1}\frac{1}{\gamma}\left(1+\frac{\delta_{F_{s}}}{2\mu_{1}}\right)\leq\frac{1}{2\rho}" display="inline" intent=":literal"><semantics><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>δ</mi><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>λ</mi><msub><mi>F</mi><mi>s</mi></msub><mrow><mo>−</mo><mn>1</mn></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mfrac><mn>1</mn><mi>γ</mi></mfrac><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mn>1</mn><mo>+</mo><mfrac><msub><mi>δ</mi><msub><mi>F</mi><mi>s</mi></msub></msub><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>μ</mi><mn>1</mn></msub></mrow></mfrac></mrow><mo>)</mo></mrow></mrow><mo>≤</mo><mfrac><mn>1</mn><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>ρ</mi></mrow></mfrac></mrow><annotation encoding="application/x-tex">2\delta\lambda_{F_{s}}^{-1}\frac{1}{\gamma}\left(1+\frac{\delta_{F_{s}}}{2\mu_{1}}\right)\leq\frac{1}{2\rho}</annotation></semantics></math>, we get for any <math id="A10.Thmtheorem5.p19.m3" class="ltx_Math" alttext="t\geq 0" display="inline" intent=":literal"><semantics><mrow><mi>t</mi><mo>≥</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">t\geq 0</annotation></semantics></math>,</span></p>
<table id="A10.E119" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A10.E119.m1" class="ltx_Math" alttext="M_{t}\leq 2\kappa_{F_{s}}\left(\|r_{0}\|_{F(w)}+2\delta\frac{\|h_{0}\|_{F(w)}}{\gamma+\mu_{1}}\right)." display="block" intent=":literal"><semantics><mrow><mrow><msub><mi>M</mi><mi>t</mi></msub><mo>≤</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>κ</mi><msub><mi>F</mi><mi>s</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><msub><mrow><mo stretchy="false">‖</mo><msub><mi>r</mi><mn>0</mn></msub><mo stretchy="false">‖</mo></mrow><mrow><mi>F</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>w</mi><mo stretchy="false">)</mo></mrow></mrow></msub><mo>+</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>δ</mi><mo lspace="0em" rspace="0em">​</mo><mfrac><msub><mrow><mo stretchy="false">‖</mo><msub><mi>h</mi><mn>0</mn></msub><mo stretchy="false">‖</mo></mrow><mrow><mi>F</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>w</mi><mo stretchy="false">)</mo></mrow></mrow></msub><mrow><mi>γ</mi><mo>+</mo><msub><mi>μ</mi><mn>1</mn></msub></mrow></mfrac></mrow></mrow><mo>)</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">M_{t}\leq 2\kappa_{F_{s}}\left(\|r_{0}\|_{F(w)}+2\delta\frac{\|h_{0}\|_{F(w)}}{\gamma+\mu_{1}}\right).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(119)</span></td></tr></tbody>
</table>
</div>
<div id="A10.Thmtheorem5.p20" class="ltx_para">
<p id="A10.Thmtheorem5.p20.1" class="ltx_p"><span id="A10.Thmtheorem5.p20.1.1" class="ltx_text">Substituting it into (<a href="#A10.E114" title="Equation 114 ‣ Proof. ‣ Lemma J.5. ‣ J.1 Landscape Analysis ‣ Appendix J Proof ‣ Accelerating LLM Pre-Training through Flat-Direction Dynamics Enhancement" class="ltx_ref"><span class="ltx_text ltx_ref_tag">114</span></a>) and (<a href="#A10.E118" title="Equation 118 ‣ Proof. ‣ Lemma J.5. ‣ J.1 Landscape Analysis ‣ Appendix J Proof ‣ Accelerating LLM Pre-Training through Flat-Direction Dynamics Enhancement" class="ltx_ref"><span class="ltx_text ltx_ref_tag">118</span></a>) respectively, we get</span></p>
</div>
<div id="A10.Thmtheorem5.p21" class="ltx_para">
<table id="A10.E120" class="ltx_equationgroup ltx_eqn_table">
<tbody>
<tr id="A10.E120X" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A10.E120X.m2" class="ltx_Math" alttext="\displaystyle\|h_{t}\|_{F(\psi_{t}(w))}\leq" display="inline" intent=":literal"><semantics><mrow><msub><mrow><mo stretchy="false">‖</mo><msub><mi>h</mi><mi>t</mi></msub><mo stretchy="false">‖</mo></mrow><mrow><mi>F</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>ψ</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>w</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></msub><mo>≤</mo><mphantom></mphantom></mrow><annotation encoding="application/x-tex">\displaystyle\|h_{t}\|_{F(\psi_{t}(w))}\leq</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A10.E120X.m3" class="ltx_Math" alttext="\displaystyle e^{-\mu_{1}t}\|h_{0}\|_{F(\psi_{0}(w))}+\frac{\delta_{F_{s}}}{\mu_{1}}\kappa_{F_{s}}\left(\|r_{0}\|_{F(w)}+2\delta\frac{\|h_{0}\|_{F(w)}}{\gamma+\mu_{1}}\right)" display="inline" intent=":literal"><semantics><mrow><mrow><msup><mi>e</mi><mrow><mo>−</mo><mrow><msub><mi>μ</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">‖</mo><msub><mi>h</mi><mn>0</mn></msub><mo stretchy="false">‖</mo></mrow><mrow><mi>F</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>ψ</mi><mn>0</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>w</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></msub></mrow><mo>+</mo><mrow><mstyle displaystyle="true"><mfrac><msub><mi>δ</mi><msub><mi>F</mi><mi>s</mi></msub></msub><msub><mi>μ</mi><mn>1</mn></msub></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msub><mi>κ</mi><msub><mi>F</mi><mi>s</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><msub><mrow><mo stretchy="false">‖</mo><msub><mi>r</mi><mn>0</mn></msub><mo stretchy="false">‖</mo></mrow><mrow><mi>F</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>w</mi><mo stretchy="false">)</mo></mrow></mrow></msub><mo>+</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>δ</mi><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><msub><mrow><mo stretchy="false">‖</mo><msub><mi>h</mi><mn>0</mn></msub><mo stretchy="false">‖</mo></mrow><mrow><mi>F</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>w</mi><mo stretchy="false">)</mo></mrow></mrow></msub><mrow><mi>γ</mi><mo>+</mo><msub><mi>μ</mi><mn>1</mn></msub></mrow></mfrac></mstyle></mrow></mrow><mo>)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle e^{-\mu_{1}t}\|h_{0}\|_{F(\psi_{0}(w))}+\frac{\delta_{F_{s}}}{\mu_{1}}\kappa_{F_{s}}\left(\|r_{0}\|_{F(w)}+2\delta\frac{\|h_{0}\|_{F(w)}}{\gamma+\mu_{1}}\right)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="2" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equationgroup ltx_align_right">(120)</span></td></tr>
<tr id="A10.E120Xa" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A10.E120Xa.m2" class="ltx_Math" alttext="\displaystyle\leq" display="inline" intent=":literal"><semantics><mo>≤</mo><annotation encoding="application/x-tex">\displaystyle\leq</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A10.E120Xa.m3" class="ltx_Math" alttext="\displaystyle e^{-\mu_{1}t}\|h_{0}\|_{F(\psi_{0}(w))}+\frac{1}{2}\epsilon_{\Phi}\|v\|_{F(w)}," display="inline" intent=":literal"><semantics><mrow><mrow><mrow><msup><mi>e</mi><mrow><mo>−</mo><mrow><msub><mi>μ</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">‖</mo><msub><mi>h</mi><mn>0</mn></msub><mo stretchy="false">‖</mo></mrow><mrow><mi>F</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>ψ</mi><mn>0</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>w</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></msub></mrow><mo>+</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mn>2</mn></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msub><mi>ϵ</mi><mi mathvariant="normal">Φ</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">‖</mo><mi>v</mi><mo stretchy="false">‖</mo></mrow><mrow><mi>F</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>w</mi><mo stretchy="false">)</mo></mrow></mrow></msub></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle e^{-\mu_{1}t}\|h_{0}\|_{F(\psi_{0}(w))}+\frac{1}{2}\epsilon_{\Phi}\|v\|_{F(w)},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="A10.Thmtheorem5.p22" class="ltx_para">
<p id="A10.Thmtheorem5.p22.1" class="ltx_p"><span id="A10.Thmtheorem5.p22.1.1" class="ltx_text">and</span></p>
</div>
<div id="A10.Thmtheorem5.p23" class="ltx_para">
<table id="A10.E121" class="ltx_equationgroup ltx_eqn_table">
<tbody>
<tr id="A10.E121X" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A10.E121X.m2" class="ltx_Math" alttext="\displaystyle\|r_{t}-r_{0}\|_{2}\leq" display="inline" intent=":literal"><semantics><mrow><msub><mrow><mo stretchy="false">‖</mo><mrow><msub><mi>r</mi><mi>t</mi></msub><mo>−</mo><msub><mi>r</mi><mn>0</mn></msub></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn></msub><mo>≤</mo><mphantom></mphantom></mrow><annotation encoding="application/x-tex">\displaystyle\|r_{t}-r_{0}\|_{2}\leq</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A10.E121X.m3" class="ltx_Math" alttext="\displaystyle 2\delta\lambda_{F_{s}}^{-1}\frac{\|h_{0}\|_{F(w)}}{\gamma+\mu_{1}}+\frac{4\kappa_{F_{s}}^{2}\delta}{\gamma\rho}\left(1+\frac{\delta_{F_{s}}}{2\mu_{1}}\right)\left(\|r_{0}\|_{F(w)}+2\delta\frac{\|h_{0}\|_{F(w)}}{\gamma+\mu_{1}}\right)" display="inline" intent=":literal"><semantics><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>δ</mi><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>λ</mi><msub><mi>F</mi><mi>s</mi></msub><mrow><mo>−</mo><mn>1</mn></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><msub><mrow><mo stretchy="false">‖</mo><msub><mi>h</mi><mn>0</mn></msub><mo stretchy="false">‖</mo></mrow><mrow><mi>F</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>w</mi><mo stretchy="false">)</mo></mrow></mrow></msub><mrow><mi>γ</mi><mo>+</mo><msub><mi>μ</mi><mn>1</mn></msub></mrow></mfrac></mstyle></mrow><mo>+</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mn>4</mn><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>κ</mi><msub><mi>F</mi><mi>s</mi></msub><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>δ</mi></mrow><mrow><mi>γ</mi><mo lspace="0em" rspace="0em">​</mo><mi>ρ</mi></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mn>1</mn><mo>+</mo><mstyle displaystyle="true"><mfrac><msub><mi>δ</mi><msub><mi>F</mi><mi>s</mi></msub></msub><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>μ</mi><mn>1</mn></msub></mrow></mfrac></mstyle></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><msub><mrow><mo stretchy="false">‖</mo><msub><mi>r</mi><mn>0</mn></msub><mo stretchy="false">‖</mo></mrow><mrow><mi>F</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>w</mi><mo stretchy="false">)</mo></mrow></mrow></msub><mo>+</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>δ</mi><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><msub><mrow><mo stretchy="false">‖</mo><msub><mi>h</mi><mn>0</mn></msub><mo stretchy="false">‖</mo></mrow><mrow><mi>F</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>w</mi><mo stretchy="false">)</mo></mrow></mrow></msub><mrow><mi>γ</mi><mo>+</mo><msub><mi>μ</mi><mn>1</mn></msub></mrow></mfrac></mstyle></mrow></mrow><mo>)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle 2\delta\lambda_{F_{s}}^{-1}\frac{\|h_{0}\|_{F(w)}}{\gamma+\mu_{1}}+\frac{4\kappa_{F_{s}}^{2}\delta}{\gamma\rho}\left(1+\frac{\delta_{F_{s}}}{2\mu_{1}}\right)\left(\|r_{0}\|_{F(w)}+2\delta\frac{\|h_{0}\|_{F(w)}}{\gamma+\mu_{1}}\right)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="2" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equationgroup ltx_align_right">(121)</span></td></tr>
<tr id="A10.E121Xa" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A10.E121Xa.m2" class="ltx_Math" alttext="\displaystyle\leq" display="inline" intent=":literal"><semantics><mo>≤</mo><annotation encoding="application/x-tex">\displaystyle\leq</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A10.E121Xa.m3" class="ltx_Math" alttext="\displaystyle\frac{1}{2}\epsilon_{\Phi}\frac{\|v\|_{F(w)}}{\rho}." display="inline" intent=":literal"><semantics><mrow><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mn>2</mn></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msub><mi>ϵ</mi><mi mathvariant="normal">Φ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><msub><mrow><mo stretchy="false">‖</mo><mi>v</mi><mo stretchy="false">‖</mo></mrow><mrow><mi>F</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>w</mi><mo stretchy="false">)</mo></mrow></mrow></msub><mi>ρ</mi></mfrac></mstyle></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\frac{1}{2}\epsilon_{\Phi}\frac{\|v\|_{F(w)}}{\rho}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="A10.Thmtheorem5.p24" class="ltx_para">
<p id="A10.Thmtheorem5.p24.1" class="ltx_p"><span id="A10.Thmtheorem5.p24.1.1" class="ltx_text">Noting that <math id="A10.Thmtheorem5.p24.m1" class="ltx_math_unparsed" alttext="\lim_{t\to\infty}h_{t}=P_{s}(\Phi(w))\nabla\Phi(w)v" display="inline" intent=":literal"><semantics><mrow><msub><mo>lim</mo><mrow><mi>t</mi><mo stretchy="false">→</mo><mi mathvariant="normal">∞</mi></mrow></msub><msub><mi>h</mi><mi>t</mi></msub><mo>=</mo><msub><mi>P</mi><mi>s</mi></msub><mrow><mo stretchy="false">(</mo><mi mathvariant="normal">Φ</mi><mrow><mo stretchy="false">(</mo><mi>w</mi><mo stretchy="false">)</mo></mrow><mo rspace="0.167em" stretchy="false">)</mo></mrow><mo rspace="0.167em">∇</mo><mi mathvariant="normal">Φ</mi><mrow><mo stretchy="false">(</mo><mi>w</mi><mo stretchy="false">)</mo></mrow><mi>v</mi></mrow><annotation encoding="application/x-tex">\lim_{t\to\infty}h_{t}=P_{s}(\Phi(w))\nabla\Phi(w)v</annotation></semantics></math> and <math id="A10.Thmtheorem5.p24.m2" class="ltx_math_unparsed" alttext="\lim_{t\to\infty}(r_{t}-r_{0})=P_{f}(\Phi(w))\nabla\Phi(w)v-P_{f}(w)v" display="inline" intent=":literal"><semantics><mrow><msub><mo>lim</mo><mrow><mi>t</mi><mo stretchy="false">→</mo><mi mathvariant="normal">∞</mi></mrow></msub><mrow><mo lspace="0em" stretchy="false">(</mo><msub><mi>r</mi><mi>t</mi></msub><mo>−</mo><msub><mi>r</mi><mn>0</mn></msub><mo stretchy="false">)</mo></mrow><mo>=</mo><msub><mi>P</mi><mi>f</mi></msub><mrow><mo stretchy="false">(</mo><mi mathvariant="normal">Φ</mi><mrow><mo stretchy="false">(</mo><mi>w</mi><mo stretchy="false">)</mo></mrow><mo rspace="0.167em" stretchy="false">)</mo></mrow><mo rspace="0.167em">∇</mo><mi mathvariant="normal">Φ</mi><mrow><mo stretchy="false">(</mo><mi>w</mi><mo stretchy="false">)</mo></mrow><mi>v</mi><mo>−</mo><msub><mi>P</mi><mi>f</mi></msub><mrow><mo stretchy="false">(</mo><mi>w</mi><mo stretchy="false">)</mo></mrow><mi>v</mi></mrow><annotation encoding="application/x-tex">\lim_{t\to\infty}(r_{t}-r_{0})=P_{f}(\Phi(w))\nabla\Phi(w)v-P_{f}(w)v</annotation></semantics></math>, we get the conclusion.</span></p>
</div>
<div id="A10.Thmtheorem5.p25" class="ltx_para">
<p id="A10.Thmtheorem5.p25.1" class="ltx_p"><span id="A10.Thmtheorem5.p25.1.1" class="ltx_text">∎</span></p>
</div>
</div>
</div>
</section>
<section id="A10.SS2" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">J.2 </span>Dynamics Analysis</h3>

<div id="A10.Thmtheorem6" class="ltx_theorem ltx_theorem_lemma">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="A10.Thmtheorem6.2" class="ltx_text ltx_font_bold">Lemma J.6</span></span><span id="A10.Thmtheorem6.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="A10.Thmtheorem6.p1" class="ltx_para">
<p id="A10.Thmtheorem6.p1.2" class="ltx_p"><span id="A10.Thmtheorem6.p1.2.1" class="ltx_text ltx_font_italic">Suppose Assumptions <a href="#S7.Thmtheorem1" title="Assumption 7.1 (River Structure). ‣ 7 Theoretical Analysis to Training Dynamics ‣ Accelerating LLM Pre-Training through Flat-Direction Dynamics Enhancement" class="ltx_ref"><span class="ltx_text ltx_ref_tag">7.1</span></a> and <a href="#S7.Thmtheorem2" title="Assumption 7.2 (Regularity, Smoothness and Conservation). ‣ 7 Theoretical Analysis to Training Dynamics ‣ Accelerating LLM Pre-Training through Flat-Direction Dynamics Enhancement" class="ltx_ref"><span class="ltx_text ltx_ref_tag">7.2</span></a> hold, and</span></p>
<table id="A10.E122" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A10.E122.m1" class="ltx_Math" alttext="\epsilon_{\Phi}\leq\frac{1}{10}\min\{1,\alpha\beta_{1}\},\,\delta_{F_{s}}\leq\frac{1}{10}\lambda_{H_{F,s}},\,\eta_{0}\delta_{F_{s}}\chi\left(\frac{1}{\alpha\kappa_{F}^{1/2}}+\beta_{2}\right)\leq\frac{1}{5}\alpha." display="block" intent=":literal"><semantics><mrow><mrow><mrow><msub><mi>ϵ</mi><mi mathvariant="normal">Φ</mi></msub><mo>≤</mo><mrow><mfrac><mn>1</mn><mn>10</mn></mfrac><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>min</mi><mo>⁡</mo><mrow><mo stretchy="false">{</mo><mn>1</mn><mo>,</mo><mrow><mi>α</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>β</mi><mn>1</mn></msub></mrow><mo stretchy="false">}</mo></mrow></mrow></mrow></mrow><mo rspace="0.337em">,</mo><mrow><msub><mi>δ</mi><msub><mi>F</mi><mi>s</mi></msub></msub><mo>≤</mo><mrow><mfrac><mn>1</mn><mn>10</mn></mfrac><mo lspace="0em" rspace="0em">​</mo><msub><mi>λ</mi><msub><mi>H</mi><mrow><mi>F</mi><mo>,</mo><mi>s</mi></mrow></msub></msub></mrow></mrow><mo rspace="0.337em">,</mo><mrow><mrow><msub><mi>η</mi><mn>0</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>δ</mi><msub><mi>F</mi><mi>s</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mi>χ</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mfrac><mn>1</mn><mrow><mi>α</mi><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>κ</mi><mi>F</mi><mrow><mn>1</mn><mo>/</mo><mn>2</mn></mrow></msubsup></mrow></mfrac><mo>+</mo><msub><mi>β</mi><mn>2</mn></msub></mrow><mo>)</mo></mrow></mrow><mo>≤</mo><mrow><mfrac><mn>1</mn><mn>5</mn></mfrac><mo lspace="0em" rspace="0em">​</mo><mi>α</mi></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\epsilon_{\Phi}\leq\frac{1}{10}\min\{1,\alpha\beta_{1}\},\,\delta_{F_{s}}\leq\frac{1}{10}\lambda_{H_{F,s}},\,\eta_{0}\delta_{F_{s}}\chi\left(\frac{1}{\alpha\kappa_{F}^{1/2}}+\beta_{2}\right)\leq\frac{1}{5}\alpha.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(122)</span></td></tr></tbody>
</table>
<p id="A10.Thmtheorem6.p1.3" class="ltx_p"><span id="A10.Thmtheorem6.p1.3.1" class="ltx_text ltx_font_italic">Let <math id="A10.Thmtheorem6.p1.m1" class="ltx_Math" alttext="\iota_{t}=\min\left\{\frac{1}{2}\alpha,\lambda_{H_{F},s}\beta_{1}\eta_{t}\right\}" display="inline" intent=":literal"><semantics><mrow><msub><mi>ι</mi><mi>t</mi></msub><mo>=</mo><mrow><mi>min</mi><mo>⁡</mo><mrow><mo>{</mo><mrow><mfrac><mn>1</mn><mn>2</mn></mfrac><mo lspace="0em" rspace="0em">​</mo><mi>α</mi></mrow><mo>,</mo><mrow><msub><mi>λ</mi><mrow><msub><mi>H</mi><mi>F</mi></msub><mo>,</mo><mi>s</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>β</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>η</mi><mi>t</mi></msub></mrow><mo>}</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\iota_{t}=\min\left\{\frac{1}{2}\alpha,\lambda_{H_{F},s}\beta_{1}\eta_{t}\right\}</annotation></semantics></math>. We have</span></p>
<table id="A10.E123" class="ltx_equationgroup ltx_eqn_table">
<tbody>
<tr id="A10.E123X" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A10.E123X.m2" class="ltx_Math" alttext="\displaystyle\|w_{t}-\Phi(w_{t})\|_{2}^{2}+\eta_{t}\|m_{t}\|_{F_{s}^{\dagger}(w_{t})}^{2}\lesssim" display="inline" intent=":literal"><semantics><mrow><mrow><msubsup><mrow><mo stretchy="false">‖</mo><mrow><msub><mi>w</mi><mi>t</mi></msub><mo>−</mo><mrow><mi mathvariant="normal">Φ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>w</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn><mn>2</mn></msubsup><mo>+</mo><mrow><msub><mi>η</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mrow><mo stretchy="false">‖</mo><msub><mi>m</mi><mi>t</mi></msub><mo stretchy="false">‖</mo></mrow><mrow><msubsup><mi>F</mi><mi>s</mi><mo>†</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>w</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mn>2</mn></msubsup></mrow></mrow><mo>≲</mo><mphantom></mphantom></mrow><annotation encoding="application/x-tex">\displaystyle\|w_{t}-\Phi(w_{t})\|_{2}^{2}+\eta_{t}\|m_{t}\|_{F_{s}^{\dagger}(w_{t})}^{2}\lesssim</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A10.E123X.m3" class="ltx_Math" alttext="\displaystyle\exp\left(-{\int_{0}^{t}\iota_{s}ds}\right)" display="inline" intent=":literal"><semantics><mrow><mi>exp</mi><mo>(</mo><mo lspace="0em">−</mo><mstyle displaystyle="true"><mo>∫</mo></mstyle><msub><mrow></mrow><mn>0</mn></msub><msup><mrow></mrow><mi>t</mi></msup><mi>ι</mi><msub><mrow></mrow><mi>s</mi></msub><mi>d</mi><mi>s</mi><mo>)</mo></mrow><annotation encoding="application/x-tex">\displaystyle\exp\left(-{\int_{0}^{t}\iota_{s}ds}\right)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="2" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equationgroup ltx_align_right">(123)</span></td></tr>
<tr id="A10.E123Xa" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A10.E123Xa.m2" class="ltx_Math" alttext="\displaystyle+\varepsilon" display="inline" intent=":literal"><semantics><mrow><mo>+</mo><mi>ε</mi></mrow><annotation encoding="application/x-tex">\displaystyle+\varepsilon</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A10.E123Xa.m3" class="ltx_Math" alttext="\displaystyle\int_{0}^{t}\exp\left({-\int_{s}^{t}\iota_{\tau}d\tau}\right)(\|\nabla f(w_{s})\|_{F_{f}^{\dagger}(w_{s})}^{2}+\|m_{s}\|_{F_{f}^{\dagger}(w_{s})}^{2})ds" display="inline" intent=":literal"><semantics><mrow><mstyle displaystyle="true"><mo>∫</mo></mstyle><msub><mrow></mrow><mn>0</mn></msub><msup><mrow></mrow><mi>t</mi></msup><mi>exp</mi><mo>(</mo><mo lspace="0em">−</mo><mstyle displaystyle="true"><mo>∫</mo></mstyle><msub><mrow></mrow><mi>s</mi></msub><msup><mrow></mrow><mi>t</mi></msup><mi>ι</mi><msub><mrow></mrow><mi>τ</mi></msub><mi>d</mi><mi>τ</mi><mo>)</mo><mo stretchy="false">(</mo><mo lspace="0em" rspace="0.167em">∥</mo><mo rspace="0.167em">∇</mo><mi>f</mi><mo stretchy="false">(</mo><mi>w</mi><msub><mrow></mrow><mi>s</mi></msub><mo stretchy="false">)</mo><mo lspace="0em" rspace="0em">∥</mo><msub><mrow></mrow><mrow><msubsup><mi>F</mi><mi>f</mi><mo>†</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>w</mi><mi>s</mi></msub><mo stretchy="false">)</mo></mrow></mrow></msub><msup><mrow></mrow><mn>2</mn></msup><mo lspace="0em" rspace="0em">+</mo><mo lspace="0em" rspace="0.167em">∥</mo><mi>m</mi><msub><mrow></mrow><mi>s</mi></msub><mo lspace="0em" rspace="0.167em">∥</mo><msub><mrow></mrow><mrow><msubsup><mi>F</mi><mi>f</mi><mo>†</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>w</mi><mi>s</mi></msub><mo stretchy="false">)</mo></mrow></mrow></msub><msup><mrow></mrow><mn>2</mn></msup><mo stretchy="false">)</mo><mi>d</mi><mi>s</mi></mrow><annotation encoding="application/x-tex">\displaystyle\int_{0}^{t}\exp\left({-\int_{s}^{t}\iota_{\tau}d\tau}\right)(\|\nabla f(w_{s})\|_{F_{f}^{\dagger}(w_{s})}^{2}+\|m_{s}\|_{F_{f}^{\dagger}(w_{s})}^{2})ds</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="A10.Thmtheorem6.p2" class="ltx_para">
<p id="A10.Thmtheorem6.p2.1" class="ltx_p"><span id="A10.Thmtheorem6.p2.1.1" class="ltx_text ltx_font_italic">Especially, taking <math id="A10.Thmtheorem6.p2.m1" class="ltx_Math" alttext="\alpha=2\eta_{0}\lambda_{H_{F,s}}^{\frac{1}{2}}" display="inline" intent=":literal"><semantics><mrow><mi>α</mi><mo>=</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>η</mi><mn>0</mn></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>λ</mi><msub><mi>H</mi><mrow><mi>F</mi><mo>,</mo><mi>s</mi></mrow></msub><mfrac><mn>1</mn><mn>2</mn></mfrac></msubsup></mrow></mrow><annotation encoding="application/x-tex">\alpha=2\eta_{0}\lambda_{H_{F,s}}^{\frac{1}{2}}</annotation></semantics></math> and <math id="A10.Thmtheorem6.p2.m2" class="ltx_Math" alttext="\beta_{1}=\lambda_{H_{F,s}}^{-\frac{1}{2}}" display="inline" intent=":literal"><semantics><mrow><msub><mi>β</mi><mn>1</mn></msub><mo>=</mo><msubsup><mi>λ</mi><msub><mi>H</mi><mrow><mi>F</mi><mo>,</mo><mi>s</mi></mrow></msub><mrow><mo>−</mo><mfrac><mn>1</mn><mn>2</mn></mfrac></mrow></msubsup></mrow><annotation encoding="application/x-tex">\beta_{1}=\lambda_{H_{F,s}}^{-\frac{1}{2}}</annotation></semantics></math> gives</span></p>
</div>
<div id="A10.Thmtheorem6.p3" class="ltx_para">
<table id="A10.E124" class="ltx_equationgroup ltx_eqn_table">
<tbody>
<tr id="A10.E124X" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A10.E124X.m2" class="ltx_Math" alttext="\displaystyle\|w_{t}-\Phi(w_{t})\|_{2}^{2}+\eta_{t}\|m_{t}\|_{F_{s}^{\dagger}(w_{t})}^{2}\lesssim" display="inline" intent=":literal"><semantics><mrow><mrow><msubsup><mrow><mo stretchy="false">‖</mo><mrow><msub><mi>w</mi><mi>t</mi></msub><mo>−</mo><mrow><mi mathvariant="normal">Φ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>w</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn><mn>2</mn></msubsup><mo>+</mo><mrow><msub><mi>η</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mrow><mo stretchy="false">‖</mo><msub><mi>m</mi><mi>t</mi></msub><mo stretchy="false">‖</mo></mrow><mrow><msubsup><mi>F</mi><mi>s</mi><mo>†</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>w</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mn>2</mn></msubsup></mrow></mrow><mo>≲</mo><mphantom></mphantom></mrow><annotation encoding="application/x-tex">\displaystyle\|w_{t}-\Phi(w_{t})\|_{2}^{2}+\eta_{t}\|m_{t}\|_{F_{s}^{\dagger}(w_{t})}^{2}\lesssim</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A10.E124X.m3" class="ltx_Math" alttext="\displaystyle\exp\left({-\lambda_{H_{F,s}}^{\frac{1}{2}}\int_{0}^{t}\eta_{s}ds}\right)" display="inline" intent=":literal"><semantics><mrow><mi>exp</mi><mo>(</mo><mo lspace="0em">−</mo><mi>λ</mi><msub><mrow></mrow><msub><mi>H</mi><mrow><mi>F</mi><mo>,</mo><mi>s</mi></mrow></msub></msub><msup><mrow></mrow><mfrac><mn>1</mn><mn>2</mn></mfrac></msup><mstyle displaystyle="true"><mo>∫</mo></mstyle><msub><mrow></mrow><mn>0</mn></msub><msup><mrow></mrow><mi>t</mi></msup><mi>η</mi><msub><mrow></mrow><mi>s</mi></msub><mi>d</mi><mi>s</mi><mo>)</mo></mrow><annotation encoding="application/x-tex">\displaystyle\exp\left({-\lambda_{H_{F,s}}^{\frac{1}{2}}\int_{0}^{t}\eta_{s}ds}\right)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="2" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equationgroup ltx_align_right">(124)</span></td></tr>
<tr id="A10.E124Xa" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A10.E124Xa.m2" class="ltx_Math" alttext="\displaystyle+\varepsilon\int_{0}^{t}\exp\left({-\lambda_{H_{F,s}}^{\frac{1}{2}}\int_{s}^{t}\eta_{\tau}d\tau}\right)(\|\nabla f(w_{s})\|_{F_{f}^{\dagger}(w_{s})}^{2}+\|m_{s}\|_{F_{f}^{\dagger}(w_{s})}^{2})ds." display="inline" intent=":literal"><semantics><mrow><mo>+</mo><mi>ε</mi><mstyle displaystyle="true"><mo>∫</mo></mstyle><msub><mrow></mrow><mn>0</mn></msub><msup><mrow></mrow><mi>t</mi></msup><mi>exp</mi><mo>(</mo><mo lspace="0em">−</mo><mi>λ</mi><msub><mrow></mrow><msub><mi>H</mi><mrow><mi>F</mi><mo>,</mo><mi>s</mi></mrow></msub></msub><msup><mrow></mrow><mfrac><mn>1</mn><mn>2</mn></mfrac></msup><mstyle displaystyle="true"><mo>∫</mo></mstyle><msub><mrow></mrow><mi>s</mi></msub><msup><mrow></mrow><mi>t</mi></msup><mi>η</mi><msub><mrow></mrow><mi>τ</mi></msub><mi>d</mi><mi>τ</mi><mo>)</mo><mo stretchy="false">(</mo><mo lspace="0em" rspace="0.167em">∥</mo><mo rspace="0.167em">∇</mo><mi>f</mi><mo stretchy="false">(</mo><mi>w</mi><msub><mrow></mrow><mi>s</mi></msub><mo stretchy="false">)</mo><mo lspace="0em" rspace="0em">∥</mo><msub><mrow></mrow><mrow><msubsup><mi>F</mi><mi>f</mi><mo>†</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>w</mi><mi>s</mi></msub><mo stretchy="false">)</mo></mrow></mrow></msub><msup><mrow></mrow><mn>2</mn></msup><mo lspace="0em" rspace="0em">+</mo><mo lspace="0em" rspace="0.167em">∥</mo><mi>m</mi><msub><mrow></mrow><mi>s</mi></msub><mo lspace="0em" rspace="0.167em">∥</mo><msub><mrow></mrow><mrow><msubsup><mi>F</mi><mi>f</mi><mo>†</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>w</mi><mi>s</mi></msub><mo stretchy="false">)</mo></mrow></mrow></msub><msup><mrow></mrow><mn>2</mn></msup><mo stretchy="false">)</mo><mi>d</mi><mi>s</mi><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle+\varepsilon\int_{0}^{t}\exp\left({-\lambda_{H_{F,s}}^{\frac{1}{2}}\int_{s}^{t}\eta_{\tau}d\tau}\right)(\|\nabla f(w_{s})\|_{F_{f}^{\dagger}(w_{s})}^{2}+\|m_{s}\|_{F_{f}^{\dagger}(w_{s})}^{2})ds.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="A10.Thmtheorem7" class="ltx_theorem ltx_theorem_remark">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="A10.Thmtheorem7.2" class="ltx_text ltx_font_italic">Remark J.7</span></span><span id="A10.Thmtheorem7.3" class="ltx_text ltx_font_italic">.</span></h6>
<div id="A10.Thmtheorem7.p1" class="ltx_para">
<p id="A10.Thmtheorem7.p1.1" class="ltx_p">Such choices of <math id="A10.Thmtheorem7.p1.m1" class="ltx_Math" alttext="\alpha" display="inline" intent=":literal"><semantics><mi>α</mi><annotation encoding="application/x-tex">\alpha</annotation></semantics></math> and <math id="A10.Thmtheorem7.p1.m2" class="ltx_Math" alttext="\beta_{1}" display="inline" intent=":literal"><semantics><msub><mi>β</mi><mn>1</mn></msub><annotation encoding="application/x-tex">\beta_{1}</annotation></semantics></math> yield fast convergence in the (strongly convex) sharp directions of the ill-conditioned landscape. The rate <math id="A10.Thmtheorem7.p1.m3" class="ltx_math_unparsed" alttext="\exp\left({-\lambda_{H_{F,s}}^{\frac{1}{2}}\int_{0}^{t}\eta_{s}ds}\right)" display="inline" intent=":literal"><semantics><mrow><mi>exp</mi><mrow><mo>(</mo><mo lspace="0em">−</mo><msubsup><mi>λ</mi><msub><mi>H</mi><mrow><mi>F</mi><mo>,</mo><mi>s</mi></mrow></msub><mfrac><mn>1</mn><mn>2</mn></mfrac></msubsup><msubsup><mo>∫</mo><mn>0</mn><mi>t</mi></msubsup><msub><mi>η</mi><mi>s</mi></msub><mi>d</mi><mi>s</mi><mo>)</mo></mrow></mrow><annotation encoding="application/x-tex">\exp\left({-\lambda_{H_{F,s}}^{\frac{1}{2}}\int_{0}^{t}\eta_{s}ds}\right)</annotation></semantics></math> matches the results in <cite class="ltx_cite ltx_citemacro_citep">(<a href="#bib.bib11" title="" class="ltx_ref">Attouch et al., 2022</a>)</cite>.</p>
</div>
</div>
<div id="A10.Thmtheorem6.4" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="A10.Thmtheorem6.p4" class="ltx_para">
<p id="A10.Thmtheorem6.p4.2" class="ltx_p"><span id="A10.Thmtheorem6.p4.2.1" class="ltx_text">We first consider general hyper-parameters <math id="A10.Thmtheorem6.p4.m1" class="ltx_Math" alttext="\alpha" display="inline" intent=":literal"><semantics><mi>α</mi><annotation encoding="application/x-tex">\alpha</annotation></semantics></math>, <math id="A10.Thmtheorem6.p4.m2" class="ltx_Math" alttext="\beta_{1}" display="inline" intent=":literal"><semantics><msub><mi>β</mi><mn>1</mn></msub><annotation encoding="application/x-tex">\beta_{1}</annotation></semantics></math> and <math id="A10.Thmtheorem6.p4.m3" class="ltx_Math" alttext="\eta_{t}" display="inline" intent=":literal"><semantics><msub><mi>η</mi><mi>t</mi></msub><annotation encoding="application/x-tex">\eta_{t}</annotation></semantics></math>.
Recall that <math id="A10.Thmtheorem6.p4.m4" class="ltx_math_unparsed" alttext="\dot{w}_{t}=-\eta_{t}F_{s}(w_{t})^{-1}(m_{t}+\beta_{1}\nabla f(w_{t}))-\eta_{t}\chi F_{f}(w_{t})^{-1}(m_{t}+\beta_{2}\nabla f(w_{t}))" display="inline" intent=":literal"><semantics><mrow><msub><mover accent="true"><mi>w</mi><mo>˙</mo></mover><mi>t</mi></msub><mo rspace="0em">=</mo><mo lspace="0em">−</mo><msub><mi>η</mi><mi>t</mi></msub><msub><mi>F</mi><mi>s</mi></msub><msup><mrow><mo stretchy="false">(</mo><msub><mi>w</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow><mrow><mo>−</mo><mn>1</mn></mrow></msup><mrow><mo stretchy="false">(</mo><msub><mi>m</mi><mi>t</mi></msub><mo>+</mo><msub><mi>β</mi><mn>1</mn></msub><mo lspace="0.167em" rspace="0.167em">∇</mo><mi>f</mi><mrow><mo stretchy="false">(</mo><msub><mi>w</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow><mo stretchy="false">)</mo></mrow><mo>−</mo><msub><mi>η</mi><mi>t</mi></msub><mi>χ</mi><msub><mi>F</mi><mi>f</mi></msub><msup><mrow><mo stretchy="false">(</mo><msub><mi>w</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow><mrow><mo>−</mo><mn>1</mn></mrow></msup><mrow><mo stretchy="false">(</mo><msub><mi>m</mi><mi>t</mi></msub><mo>+</mo><msub><mi>β</mi><mn>2</mn></msub><mo lspace="0.167em" rspace="0.167em">∇</mo><mi>f</mi><mrow><mo stretchy="false">(</mo><msub><mi>w</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\dot{w}_{t}=-\eta_{t}F_{s}(w_{t})^{-1}(m_{t}+\beta_{1}\nabla f(w_{t}))-\eta_{t}\chi F_{f}(w_{t})^{-1}(m_{t}+\beta_{2}\nabla f(w_{t}))</annotation></semantics></math>.
We begin by bounding <math id="A10.Thmtheorem6.p4.m5" class="ltx_Math" alttext="\|\dot{w}_{t}\|_{F(w_{t})}" display="inline" intent=":literal"><semantics><msub><mrow><mo stretchy="false">‖</mo><msub><mover accent="true"><mi>w</mi><mo>˙</mo></mover><mi>t</mi></msub><mo stretchy="false">‖</mo></mrow><mrow><mi>F</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>w</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow></msub><annotation encoding="application/x-tex">\|\dot{w}_{t}\|_{F(w_{t})}</annotation></semantics></math>. Using <math id="A10.Thmtheorem6.p4.m6" class="ltx_Math" alttext="\dot{m}_{t}=-\alpha m_{t}+\nabla f(w_{t})" display="inline" intent=":literal"><semantics><mrow><msub><mover accent="true"><mi>m</mi><mo>˙</mo></mover><mi>t</mi></msub><mo>=</mo><mrow><mrow><mo>−</mo><mrow><mi>α</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>m</mi><mi>t</mi></msub></mrow></mrow><mo>+</mo><mrow><mrow><mo rspace="0.167em">∇</mo><mi>f</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>w</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\dot{m}_{t}=-\alpha m_{t}+\nabla f(w_{t})</annotation></semantics></math>, we have <math id="A10.Thmtheorem6.p4.m7" class="ltx_math_unparsed" alttext="m_{t}=e^{-\alpha t}\int_{0}^{t}e^{\alpha s}\nabla f(w_{s})ds" display="inline" intent=":literal"><semantics><mrow><msub><mi>m</mi><mi>t</mi></msub><mo>=</mo><msup><mi>e</mi><mrow><mo>−</mo><mrow><mi>α</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></mrow></msup><msubsup><mo>∫</mo><mn>0</mn><mi>t</mi></msubsup><msup><mi>e</mi><mrow><mi>α</mi><mo lspace="0em" rspace="0em">​</mo><mi>s</mi></mrow></msup><mo lspace="0.167em" rspace="0.167em">∇</mo><mi>f</mi><mrow><mo stretchy="false">(</mo><msub><mi>w</mi><mi>s</mi></msub><mo stretchy="false">)</mo></mrow><mi>d</mi><mi>s</mi></mrow><annotation encoding="application/x-tex">m_{t}=e^{-\alpha t}\int_{0}^{t}e^{\alpha s}\nabla f(w_{s})ds</annotation></semantics></math>. It yields</span></p>
<table id="A10.E125" class="ltx_equationgroup ltx_eqn_table">
<tbody>
<tr id="A10.E125X" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A10.E125X.m2" class="ltx_Math" alttext="\displaystyle\|\dot{w}_{t}\|_{F(w_{t})}\leq" display="inline" intent=":literal"><semantics><mrow><msub><mrow><mo stretchy="false">‖</mo><msub><mover accent="true"><mi>w</mi><mo>˙</mo></mover><mi>t</mi></msub><mo stretchy="false">‖</mo></mrow><mrow><mi>F</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>w</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow></msub><mo>≤</mo><mphantom></mphantom></mrow><annotation encoding="application/x-tex">\displaystyle\|\dot{w}_{t}\|_{F(w_{t})}\leq</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A10.E125X.m3" class="ltx_Math" alttext="\displaystyle\eta_{t}\left(\chi\|m_{t}\|_{F^{-1}(w_{t})}+\beta_{2}\|\nabla f(w_{t})\|_{F^{-1}(w_{t})}\right)" display="inline" intent=":literal"><semantics><mrow><msub><mi>η</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mrow><mi>χ</mi><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">‖</mo><msub><mi>m</mi><mi>t</mi></msub><mo stretchy="false">‖</mo></mrow><mrow><msup><mi>F</mi><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>w</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow></msub></mrow><mo>+</mo><mrow><msub><mi>β</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">‖</mo><mrow><mrow><mo rspace="0.167em">∇</mo><mi>f</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>w</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">‖</mo></mrow><mrow><msup><mi>F</mi><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>w</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow></msub></mrow></mrow><mo>)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\eta_{t}\left(\chi\|m_{t}\|_{F^{-1}(w_{t})}+\beta_{2}\|\nabla f(w_{t})\|_{F^{-1}(w_{t})}\right)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="3" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equationgroup ltx_align_right">(125)</span></td></tr>
<tr id="A10.E125Xa" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A10.E125Xa.m2" class="ltx_Math" alttext="\displaystyle\leq" display="inline" intent=":literal"><semantics><mo>≤</mo><annotation encoding="application/x-tex">\displaystyle\leq</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A10.E125Xa.m3" class="ltx_Math" alttext="\displaystyle\eta_{t}\chi\left(\lambda_{F}^{-\frac{1}{2}}\int_{0}^{t}e^{\alpha-(t-s)}\|\nabla f(w_{s})\|_{2}ds+\beta_{2}\|\nabla f(w_{t})\|_{F^{-1}(w_{t})}\right)" display="inline" intent=":literal"><semantics><mrow><msub><mi>η</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi>χ</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mrow><msubsup><mi>λ</mi><mi>F</mi><mrow><mo>−</mo><mfrac><mn>1</mn><mn>2</mn></mfrac></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><msubsup><mo>∫</mo><mn>0</mn><mi>t</mi></msubsup></mstyle><mrow><msup><mi>e</mi><mrow><mi>α</mi><mo>−</mo><mrow><mo stretchy="false">(</mo><mrow><mi>t</mi><mo>−</mo><mi>s</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">‖</mo><mrow><mrow><mo rspace="0.167em">∇</mo><mi>f</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>w</mi><mi>s</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo rspace="0em">d</mo><mi>s</mi></mrow></mrow></mrow></mrow><mo>+</mo><mrow><msub><mi>β</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">‖</mo><mrow><mrow><mo rspace="0.167em">∇</mo><mi>f</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>w</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">‖</mo></mrow><mrow><msup><mi>F</mi><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>w</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow></msub></mrow></mrow><mo>)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\eta_{t}\chi\left(\lambda_{F}^{-\frac{1}{2}}\int_{0}^{t}e^{\alpha-(t-s)}\|\nabla f(w_{s})\|_{2}ds+\beta_{2}\|\nabla f(w_{t})\|_{F^{-1}(w_{t})}\right)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr>
<tr id="A10.E125Xb" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A10.E125Xb.m2" class="ltx_Math" alttext="\displaystyle\leq" display="inline" intent=":literal"><semantics><mo>≤</mo><annotation encoding="application/x-tex">\displaystyle\leq</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A10.E125Xb.m3" class="ltx_Math" alttext="\displaystyle\eta_{t}\underbrace{\chi\left(\frac{1}{\alpha\kappa_{F}^{1/2}}+\beta_{2}\right)}_{:=C_{w}}G." display="inline" intent=":literal"><semantics><mrow><mi>η</mi><msub><mrow></mrow><mi>t</mi></msub><munder accentunder="true"><mrow><mi>χ</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mrow><mi>α</mi><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>κ</mi><mi>F</mi><mrow><mn>1</mn><mo>/</mo><mn>2</mn></mrow></msubsup></mrow></mfrac></mstyle><mo>+</mo><msub><mi>β</mi><mn>2</mn></msub></mrow><mo>)</mo></mrow></mrow><mo stretchy="true">⏟</mo></munder><msub><mrow></mrow><mrow><mphantom></mphantom><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mphantom></mphantom><mo>=</mo><msub><mi>C</mi><mi>w</mi></msub></mrow></mrow></msub><mi>G</mi><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\eta_{t}\underbrace{\chi\left(\frac{1}{\alpha\kappa_{F}^{1/2}}+\beta_{2}\right)}_{:=C_{w}}G.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="A10.Thmtheorem6.p5" class="ltx_para">
<p id="A10.Thmtheorem6.p5.1" class="ltx_p"><span id="A10.Thmtheorem6.p5.1.1" class="ltx_text">Now consider the Lyapunov function:</span></p>
<table id="A10.E126" class="ltx_equationgroup ltx_eqn_table">
<tbody>
<tr id="A10.E126X" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A10.E126X.m2" class="ltx_Math" alttext="\displaystyle V_{t}=" display="inline" intent=":literal"><semantics><mrow><msub><mi>V</mi><mi>t</mi></msub><mo>=</mo><mphantom></mphantom></mrow><annotation encoding="application/x-tex">\displaystyle V_{t}=</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A10.E126X.m3" class="ltx_Math" alttext="\displaystyle\left(f(w_{t})-f(\Phi(w_{t}))\right)+\frac{\eta_{t}}{2}\|m_{t}\|_{F_{s}^{\dagger}(w_{t})}^{2}." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mo>(</mo><mrow><mrow><mi>f</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>w</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mi>f</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi mathvariant="normal">Φ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>w</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>)</mo></mrow><mo>+</mo><mrow><mstyle displaystyle="true"><mfrac><msub><mi>η</mi><mi>t</mi></msub><mn>2</mn></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msubsup><mrow><mo stretchy="false">‖</mo><msub><mi>m</mi><mi>t</mi></msub><mo stretchy="false">‖</mo></mrow><mrow><msubsup><mi>F</mi><mi>s</mi><mo>†</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>w</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mn>2</mn></msubsup></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\left(f(w_{t})-f(\Phi(w_{t}))\right)+\frac{\eta_{t}}{2}\|m_{t}\|_{F_{s}^{\dagger}(w_{t})}^{2}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equationgroup ltx_align_right">(126)</span></td></tr></tbody>
</table>
</div>
<div id="A10.Thmtheorem6.p6" class="ltx_para">
<p id="A10.Thmtheorem6.p6.1" class="ltx_p"><span id="A10.Thmtheorem6.p6.1.1" class="ltx_text">For notational brevity, we define <math id="A10.Thmtheorem6.p6.m1" class="ltx_math_unparsed" alttext="\widetilde{m}_{t}=m_{t}+\beta_{1}\nabla f(w_{t})" display="inline" intent=":literal"><semantics><mrow><msub><mover accent="true"><mi>m</mi><mo>~</mo></mover><mi>t</mi></msub><mo>=</mo><msub><mi>m</mi><mi>t</mi></msub><mo>+</mo><msub><mi>β</mi><mn>1</mn></msub><mo lspace="0.167em" rspace="0.167em">∇</mo><mi>f</mi><mrow><mo stretchy="false">(</mo><msub><mi>w</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\widetilde{m}_{t}=m_{t}+\beta_{1}\nabla f(w_{t})</annotation></semantics></math>, and</span></p>
<table id="A10.E127" class="ltx_equationgroup ltx_eqn_table">
<tbody>
<tr id="A10.E127X" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A10.E127X.m2" class="ltx_Math" alttext="\displaystyle\Delta_{1}=" display="inline" intent=":literal"><semantics><mrow><msub><mi mathvariant="normal">Δ</mi><mn>1</mn></msub><mo>=</mo><mphantom></mphantom></mrow><annotation encoding="application/x-tex">\displaystyle\Delta_{1}=</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A10.E127X.m3" class="ltx_Math" alttext="\displaystyle\left\langle\nabla f(w_{t}),(P_{f}(w_{t})-\nabla\Phi(w_{t}))\dot{w}_{t}\right\rangle,\quad\Delta_{2}=\frac{\dot{\eta}_{t}}{2}\|m_{t}\|_{F_{s}^{\dagger}(w_{t})}^{2}," display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mo>⟨</mo><mrow><mrow><mrow><mo rspace="0.167em">∇</mo><mi>f</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>w</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mrow><msub><mi>P</mi><mi>f</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>w</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mrow><mo rspace="0.167em">∇</mo><mi mathvariant="normal">Φ</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>w</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mover accent="true"><mi>w</mi><mo>˙</mo></mover><mi>t</mi></msub></mrow></mrow><mo>⟩</mo></mrow><mo rspace="1.167em">,</mo><mrow><msub><mi mathvariant="normal">Δ</mi><mn>2</mn></msub><mo>=</mo><mrow><mstyle displaystyle="true"><mfrac><msub><mover accent="true"><mi>η</mi><mo>˙</mo></mover><mi>t</mi></msub><mn>2</mn></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msubsup><mrow><mo stretchy="false">‖</mo><msub><mi>m</mi><mi>t</mi></msub><mo stretchy="false">‖</mo></mrow><mrow><msubsup><mi>F</mi><mi>s</mi><mo>†</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>w</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mn>2</mn></msubsup></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\left\langle\nabla f(w_{t}),(P_{f}(w_{t})-\nabla\Phi(w_{t}))\dot{w}_{t}\right\rangle,\quad\Delta_{2}=\frac{\dot{\eta}_{t}}{2}\|m_{t}\|_{F_{s}^{\dagger}(w_{t})}^{2},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="2" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equationgroup ltx_align_right">(127)</span></td></tr>
<tr id="A10.E127Xa" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A10.E127Xa.m2" class="ltx_Math" alttext="\displaystyle\Delta_{3}=" display="inline" intent=":literal"><semantics><mrow><msub><mi mathvariant="normal">Δ</mi><mn>3</mn></msub><mo>=</mo><mphantom></mphantom></mrow><annotation encoding="application/x-tex">\displaystyle\Delta_{3}=</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A10.E127Xa.m3" class="ltx_Math" alttext="\displaystyle m_{t}^{\top}\nabla F_{s}^{\dagger}(w_{t})[\dot{w}_{t}]m_{t}." display="inline" intent=":literal"><semantics><mrow><mi>m</mi><msub><mrow></mrow><mi>t</mi></msub><msup><mrow></mrow><mo>⊤</mo></msup><mo lspace="0.167em" rspace="0.167em">∇</mo><mi>F</mi><msub><mrow></mrow><mi>s</mi></msub><msup><mrow></mrow><mo>†</mo></msup><mo stretchy="false">(</mo><mi>w</mi><msub><mrow></mrow><mi>t</mi></msub><mo stretchy="false">)</mo><mo stretchy="false">[</mo><mover accent="true"><mi>w</mi><mo>˙</mo></mover><msub><mrow></mrow><mi>t</mi></msub><mo stretchy="false">]</mo><mi>m</mi><msub><mrow></mrow><mi>t</mi></msub><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle m_{t}^{\top}\nabla F_{s}^{\dagger}(w_{t})[\dot{w}_{t}]m_{t}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="A10.Thmtheorem6.p7" class="ltx_para">
<p id="A10.Thmtheorem6.p7.2" class="ltx_p"><span id="A10.Thmtheorem6.p7.2.1" class="ltx_text">For <math id="A10.Thmtheorem6.p7.m1" class="ltx_Math" alttext="\Delta_{1}" display="inline" intent=":literal"><semantics><msub><mi mathvariant="normal">Δ</mi><mn>1</mn></msub><annotation encoding="application/x-tex">\Delta_{1}</annotation></semantics></math> We have</span></p>
<table id="A10.E128" class="ltx_equationgroup ltx_eqn_table">
<tbody>
<tr id="A10.E128X" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A10.E128X.m2" class="ltx_Math" alttext="\displaystyle\Delta_{1}=" display="inline" intent=":literal"><semantics><mrow><msub><mi mathvariant="normal">Δ</mi><mn>1</mn></msub><mo>=</mo><mphantom></mphantom></mrow><annotation encoding="application/x-tex">\displaystyle\Delta_{1}=</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A10.E128X.m3" class="ltx_Math" alttext="\displaystyle\left\langle\nabla f(w_{t}),(P_{f}(w_{t})-\nabla\Phi(w_{t}))P_{f}(w_{t})\dot{w}_{t}\right\rangle+\left\langle\nabla f(w_{t}),(P_{f}(w_{t})-\nabla\Phi(w_{t}))P_{s}(w_{t})\dot{w}_{t}\right\rangle" display="inline" intent=":literal"><semantics><mrow><mrow><mo>⟨</mo><mrow><mrow><mrow><mo rspace="0.167em">∇</mo><mi>f</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>w</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mrow><msub><mi>P</mi><mi>f</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>w</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mrow><mo rspace="0.167em">∇</mo><mi mathvariant="normal">Φ</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>w</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>P</mi><mi>f</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>w</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mover accent="true"><mi>w</mi><mo>˙</mo></mover><mi>t</mi></msub></mrow></mrow><mo>⟩</mo></mrow><mo>+</mo><mrow><mo>⟨</mo><mrow><mrow><mrow><mo rspace="0.167em">∇</mo><mi>f</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>w</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mrow><msub><mi>P</mi><mi>f</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>w</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mrow><mo rspace="0.167em">∇</mo><mi mathvariant="normal">Φ</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>w</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>P</mi><mi>s</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>w</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mover accent="true"><mi>w</mi><mo>˙</mo></mover><mi>t</mi></msub></mrow></mrow><mo>⟩</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\left\langle\nabla f(w_{t}),(P_{f}(w_{t})-\nabla\Phi(w_{t}))P_{f}(w_{t})\dot{w}_{t}\right\rangle+\left\langle\nabla f(w_{t}),(P_{f}(w_{t})-\nabla\Phi(w_{t}))P_{s}(w_{t})\dot{w}_{t}\right\rangle</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="6" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equationgroup ltx_align_right">(128)</span></td></tr>
<tr id="A10.E128Xa" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A10.E128Xa.m2" class="ltx_Math" alttext="\displaystyle\overset{\eqref{nabla-Phi-P-f-diff}}{\leq}" display="inline" intent=":literal"><semantics><mover accent="true"><mo>≤</mo><mrow><mtext mathsize="0.700em">(</mtext><mtext mathsize="0.700em"><a href="#A10.E102" title="Equation 102 ‣ Lemma J.5. ‣ J.1 Landscape Analysis ‣ Appendix J Proof ‣ Accelerating LLM Pre-Training through Flat-Direction Dynamics Enhancement" class="ltx_ref" style="font-size:70%;"><span class="ltx_text ltx_ref_tag">102</span></a></mtext><mtext mathsize="0.700em">)</mtext></mrow></mover><annotation encoding="application/x-tex">\displaystyle\overset{\eqref{nabla-Phi-P-f-diff}}{\leq}</annotation></semantics></math></td>
