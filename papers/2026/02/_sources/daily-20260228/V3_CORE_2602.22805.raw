            <span id="alg1.l1.3" class="ltx_text ltx_font_bold">Input</span>: graph <math id="alg1.l1.m1" class="ltx_Math" alttext="G(P,E)" display="inline" intent=":literal"><semantics><mrow><mi>G</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>P</mi><mo>,</mo><mi>E</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">G(P,E)</annotation></semantics></math>, build parameter <math id="alg1.l1.m2" class="ltx_Math" alttext="l_{b}" display="inline" intent=":literal"><semantics><msub><mi>l</mi><mi>b</mi></msub><annotation encoding="application/x-tex">l_{b}</annotation></semantics></math>, graph degree <math id="alg1.l1.m3" class="ltx_Math" alttext="R" display="inline" intent=":literal"><semantics><mi>R</mi><annotation encoding="application/x-tex">R</annotation></semantics></math>, pruning parameter <math id="alg1.l1.m4" class="ltx_Math" alttext="\alpha" display="inline" intent=":literal"><semantics><mi>α</mi><annotation encoding="application/x-tex">\alpha</annotation></semantics></math>, affinity threshold <math id="alg1.l1.m5" class="ltx_Math" alttext="\tau" display="inline" intent=":literal"><semantics><mi>τ</mi><annotation encoding="application/x-tex">\tau</annotation></semantics></math>, affine size <math id="alg1.l1.m6" class="ltx_Math" alttext="k" display="inline" intent=":literal"><semantics><mi>k</mi><annotation encoding="application/x-tex">k</annotation></semantics></math>

</div>
<div id="alg1.l2" class="ltx_listingline">
