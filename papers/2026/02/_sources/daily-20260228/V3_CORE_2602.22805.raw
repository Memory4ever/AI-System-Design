            <span id="alg1.l17.3" class="ltx_text ltx_font_bold">return</span> <math id="alg1.l17.m1" class="ltx_Math" alttext="G(P^{\prime},E^{\prime})" display="inline" intent=":literal"><semantics><mrow><mi>G</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>P</mi><mo>′</mo></msup><mo>,</mo><msup><mi>E</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">G(P^{\prime},E^{\prime})</annotation></semantics></math>, <math id="alg1.l17.m2" class="ltx_Math" alttext="S" display="inline" intent=":literal"><semantics><mi>S</mi><annotation encoding="application/x-tex">S</annotation></semantics></math>

