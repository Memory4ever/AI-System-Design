<tr id="S5.T1.8.1.4" class="ltx_tr" style="--ltx-bg-color:#CCFFFF;">
<td id="S5.T1.8.1.4.1" class="ltx_td ltx_align_left"><span id="S5.T1.8.1.4.1.1" class="ltx_text" style="font-size:90%;--ltx-bg-color:#CCFFFF;">w/ FFT</span></td>
