<td id="S4.T1.14.1.3.9" class="ltx_td ltx_align_center ltx_border_t"><span id="S4.T1.14.1.3.9.1" class="ltx_text" style="font-size:90%;">mIoU</span></td>
<td id="S4.T1.14.1.3.10" class="ltx_td ltx_align_center ltx_border_t"><span id="S4.T1.14.1.3.10.1" class="ltx_text" style="font-size:90%;">SR</span></td>
<td id="S4.T1.14.1.3.11" class="ltx_td ltx_align_center ltx_border_t"><span id="S4.T1.14.1.3.11.1" class="ltx_text" style="font-size:90%;">mAcc</span></td>
<td id="S4.T1.14.1.3.12" class="ltx_td ltx_align_center ltx_border_t"><span id="S4.T1.14.1.3.12.1" class="ltx_text" style="font-size:90%;">mIoU</span></td></tr>
<tr id="S4.T1.14.1.4" class="ltx_tr">
<td id="S4.T1.14.1.4.1" class="ltx_td ltx_align_left ltx_border_t"><span id="S4.T1.14.1.4.1.1" class="ltx_text" style="font-size:90%;">Random </span><cite class="ltx_cite ltx_citemacro_cite"><span id="S4.T1.14.1.4.1.2" class="ltx_text" style="font-size:90%;">[</span><a href="#bib.bib18" title="" class="ltx_ref">15</a><span id="S4.T1.14.1.4.1.3" class="ltx_text" style="font-size:90%;">]</span></cite></td>
<td id="S4.T1.14.1.4.2" class="ltx_td ltx_align_center ltx_border_t"><span id="S4.T1.14.1.4.2.1" class="ltx_text" style="font-size:90%;">0.01</span></td>
<td id="S4.T1.14.1.4.3" class="ltx_td ltx_align_center ltx_border_t"><span id="S4.T1.14.1.4.3.1" class="ltx_text" style="font-size:90%;">0.94</span></td>
