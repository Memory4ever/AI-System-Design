<td id="S5.T1.8.1.2.6" class="ltx_td ltx_align_center ltx_border_t"><span id="S5.T1.8.1.2.6.1" class="ltx_text" style="font-size:90%;">mIoU</span></td></tr>
<tr id="S5.T1.8.1.3" class="ltx_tr">
<td id="S5.T1.8.1.3.1" class="ltx_td ltx_align_left ltx_border_t"><span id="S5.T1.8.1.3.1.1" class="ltx_text" style="font-size:90%;">GeoWorld ViT-L</span></td>
<td id="S5.T1.8.1.3.2" class="ltx_td ltx_align_center ltx_border_t"><span id="S5.T1.8.1.3.2.1" class="ltx_text" style="font-size:90%;">44.80</span></td>
<td id="S5.T1.8.1.3.3" class="ltx_td ltx_align_center ltx_border_t"><span id="S5.T1.8.1.3.3.1" class="ltx_text" style="font-size:90%;">70.54</span></td>
<td id="S5.T1.8.1.3.4" class="ltx_td ltx_align_center ltx_border_t"><span id="S5.T1.8.1.3.4.1" class="ltx_text" style="font-size:90%;">86.30</span></td>
<td id="S5.T1.8.1.3.5" class="ltx_td ltx_align_center ltx_border_t"><span id="S5.T1.8.1.3.5.1" class="ltx_text" style="font-size:90%;">30.63</span></td>
<td id="S5.T1.8.1.3.6" class="ltx_td ltx_align_center ltx_border_t"><span id="S5.T1.8.1.3.6.1" class="ltx_text" style="font-size:90%;">65.46</span></td>
