<span id="S2.T1.5.1.9.3.1.1" class="ltx_p ltx_align_center">-</span>
</span></td>
<td id="S2.T1.5.1.9.4" class="ltx_td ltx_align_left ltx_align_top ltx_border_bb ltx_border_t">
<span id="S2.T1.5.1.9.4.1" class="ltx_inline-block ltx_align_top" style="width:80.0pt;">
<span id="S2.T1.5.1.9.4.1.1" class="ltx_p ltx_align_center">1<math id="S2.T1.m8" class="ltx_Math" alttext="\times" display="inline" intent=":literal"><semantics><mo>×</mo><annotation encoding="application/x-tex">\times</annotation></semantics></math>IPhone</span>
</span></td>
<td id="S2.T1.5.1.9.5" class="ltx_td ltx_align_left ltx_align_top ltx_border_bb ltx_border_t">
<span id="S2.T1.5.1.9.5.1" class="ltx_inline-block ltx_align_top" style="width:80.0pt;">
<span id="S2.T1.5.1.9.5.1.1" class="ltx_p ltx_align_center">-</span>
</span></td>
