<td id="S2.T1.5.1.9.1" class="ltx_td ltx_align_left ltx_border_bb ltx_border_r ltx_border_t">EmbodMocap</td>
<td id="S2.T1.5.1.9.2" class="ltx_td ltx_align_left ltx_align_top ltx_border_bb ltx_border_r ltx_border_t">
<span id="S2.T1.5.1.9.2.1" class="ltx_inline-block ltx_align_top" style="width:50.0pt;">
<span id="S2.T1.5.1.9.2.1.1" class="ltx_p ltx_align_center">-</span>
</span></td>
<td id="S2.T1.5.1.9.3" class="ltx_td ltx_align_left ltx_align_top ltx_border_bb ltx_border_t">
