</figure></div><div class="ltx_flex_cell ltx_flex_size_4">
<figure id="S11.F10.sf4" class="ltx_figure ltx_figure_panel ltx_align_center"><img src="2602.23205v1/stat4.png" id="S11.F10.sf4.g1" class="ltx_graphics ltx_centering ltx_img_landscape" style="aspect-ratio:685/488;" width="685" height="488" alt="Refer to caption">
