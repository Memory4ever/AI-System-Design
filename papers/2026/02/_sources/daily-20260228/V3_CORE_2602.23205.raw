<span id="S5.T6.5.1.8.4.1" class="ltx_inline-block ltx_align_top" style="width:50.0pt;">
<span id="S5.T6.5.1.8.4.1.1" class="ltx_p ltx_align_center">Succ.</span>
</span></td>
<td id="S5.T6.5.1.8.5" class="ltx_td ltx_align_left ltx_align_top ltx_border_r ltx_border_t">
<span id="S5.T6.5.1.8.5.1" class="ltx_inline-block ltx_align_top" style="width:50.0pt;">
<span id="S5.T6.5.1.8.5.1.1" class="ltx_p ltx_align_center">90.4</span>
</span></td>
