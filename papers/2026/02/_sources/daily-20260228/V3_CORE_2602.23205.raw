<span id="S5.T6.5.1.8.6.1" class="ltx_inline-block ltx_align_top" style="width:60.0pt;">
<span id="S5.T6.5.1.8.6.1.1" class="ltx_p ltx_align_center">9.96 <math id="S5.T6.m7" class="ltx_Math" alttext="\pm" display="inline" intent=":literal"><semantics><mo>±</mo><annotation encoding="application/x-tex">\pm</annotation></semantics></math> 0.21</span>
</span></td></tr>
<tr id="S5.T6.5.1.9" class="ltx_tr">
<td id="S5.T6.5.1.9.1" class="ltx_td ltx_align_left ltx_align_top ltx_border_bb ltx_border_r"></td>
<td id="S5.T6.5.1.9.2" class="ltx_td ltx_align_left ltx_align_top ltx_border_bb ltx_border_r"></td>
<td id="S5.T6.5.1.9.3" class="ltx_td ltx_align_left ltx_align_top ltx_border_bb ltx_border_r">
