<span id="S2.T1.5.1.9.6.1.1" class="ltx_p ltx_align_center">2<math id="S2.T1.m9" class="ltx_Math" alttext="\times" display="inline" intent=":literal"><semantics><mo>×</mo><annotation encoding="application/x-tex">\times</annotation></semantics></math>IPhone</span>
</span></td>
<td id="S2.T1.5.1.9.7" class="ltx_td ltx_align_left ltx_align_top ltx_border_bb ltx_border_r ltx_border_t">
