<span id="S5.T5.5.1.1.7.1" class="ltx_inline-block ltx_align_top" style="width:60.0pt;">
<span id="S5.T5.5.1.1.7.1.1" class="ltx_p ltx_align_center">APD <math id="S5.T5.m3" class="ltx_Math" alttext="\uparrow" display="inline" intent=":literal"><semantics><mo stretchy="false">↑</mo><annotation encoding="application/x-tex">\uparrow</annotation></semantics></math></span>
</span></td></tr>
<tr id="S5.T5.5.1.2" class="ltx_tr">
<td id="S5.T5.5.1.2.1" class="ltx_td ltx_align_left ltx_border_r ltx_border_t" rowspan="5"><span id="S5.T5.5.1.2.1.1" class="ltx_text">Follow</span></td>
<td id="S5.T5.5.1.2.2" class="ltx_td ltx_align_left ltx_align_top ltx_border_r ltx_border_t">
