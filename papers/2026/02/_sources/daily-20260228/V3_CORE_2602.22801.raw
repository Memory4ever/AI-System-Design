<td id="A0.SS1.fig1.3.1.1.2" class="ltx_td ltx_align_center ltx_border_tt" style="padding-top:1pt;padding-bottom:1pt;"><math id="A0.SS1.m5" class="ltx_Math" alttext="{\tau}_{0}" display="inline" intent=":literal"><semantics><msub><mi>τ</mi><mn>0</mn></msub><annotation encoding="application/x-tex">{\tau}_{0}</annotation></semantics></math><span id="A0.SS1.fig1.3.1.1.2.1" class="ltx_text ltx_font_bold">-pred.</span></td>
<td id="A0.SS1.fig1.3.1.1.3" class="ltx_td ltx_align_center ltx_border_tt" style="padding-top:1pt;padding-bottom:1pt;"><math id="A0.SS1.m6" class="ltx_Math" alttext="{v}_{t}" display="inline" intent=":literal"><semantics><msub><mi>v</mi><mi>t</mi></msub><annotation encoding="application/x-tex">{v}_{t}</annotation></semantics></math><span id="A0.SS1.fig1.3.1.1.3.1" class="ltx_text ltx_font_bold">-pred.</span></td>
<td id="A0.SS1.fig1.3.1.1.4" class="ltx_td ltx_align_center ltx_border_tt" style="padding-top:1pt;padding-bottom:1pt;"><math id="A0.SS1.m7" class="ltx_Math" alttext="{\epsilon}" display="inline" intent=":literal"><semantics><mi>ϵ</mi><annotation encoding="application/x-tex">{\epsilon}</annotation></semantics></math><span id="A0.SS1.fig1.3.1.1.4.1" class="ltx_text ltx_font_bold">-pred.</span></td></tr>
<tr id="A0.SS1.fig1.3.1.2" class="ltx_tr">
<td id="A0.SS1.fig1.3.1.2.1" class="ltx_td ltx_align_center ltx_border_r ltx_border_t" style="padding-top:1pt;padding-bottom:1pt;"><math id="A0.SS1.m8" class="ltx_Math" alttext="\tau_{0}" display="inline" intent=":literal"><semantics><msub><mi>τ</mi><mn>0</mn></msub><annotation encoding="application/x-tex">\tau_{0}</annotation></semantics></math><span id="A0.SS1.fig1.3.1.2.1.1" class="ltx_text ltx_font_bold">-loss: <math id="A0.SS1.m9" class="ltx_Math" alttext="\mathbb{E}||\hat{\tau}_{0}-\tau_{0}||^{2}" display="inline" intent=":literal"><semantics><mrow><mi>𝔼</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">‖</mo><mrow><msub><mover accent="true"><mi>τ</mi><mo>^</mo></mover><mn>0</mn></msub><mo>−</mo><msub><mi>τ</mi><mn>0</mn></msub></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup></mrow><annotation encoding="application/x-tex">\mathbb{E}||\hat{\tau}_{0}-\tau_{0}||^{2}</annotation></semantics></math></span></td>
<td id="A0.SS1.fig1.3.1.2.2" class="ltx_td ltx_align_center ltx_border_t" style="padding-top:1pt;padding-bottom:1pt;"><math id="A0.SS1.m10" class="ltx_Math" alttext="\hat{\tau}_{0}=\tau_{\theta}" display="inline" intent=":literal"><semantics><mrow><msub><mover accent="true"><mi>τ</mi><mo>^</mo></mover><mn>0</mn></msub><mo>=</mo><msub><mi>τ</mi><mi>θ</mi></msub></mrow><annotation encoding="application/x-tex">\hat{\tau}_{0}=\tau_{\theta}</annotation></semantics></math></td>
<td id="A0.SS1.fig1.3.1.2.3" class="ltx_td ltx_align_center ltx_border_t" style="padding-top:1pt;padding-bottom:1pt;"><math id="A0.SS1.m11" class="ltx_Math" alttext="\displaystyle\hat{\tau}_{0}=\alpha_{t}\tau_{t}-\sigma_{t}v_{\theta;t}" display="inline" intent=":literal"><semantics><mrow><msub><mover accent="true"><mi>τ</mi><mo>^</mo></mover><mn>0</mn></msub><mo>=</mo><mrow><mrow><msub><mi>α</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>τ</mi><mi>t</mi></msub></mrow><mo>−</mo><mrow><msub><mi>σ</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>v</mi><mrow><mi>θ</mi><mo>;</mo><mi>t</mi></mrow></msub></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\hat{\tau}_{0}=\alpha_{t}\tau_{t}-\sigma_{t}v_{\theta;t}</annotation></semantics></math></td>
<td id="A0.SS1.fig1.3.1.2.4" class="ltx_td ltx_align_center ltx_border_t" style="padding-top:1pt;padding-bottom:1pt;"><math id="A0.SS1.m12" class="ltx_Math" alttext="\hat{\tau}_{0}=({\tau_{t}-\sigma_{t}\epsilon_{\theta}})/{\alpha_{t}}" display="inline" intent=":literal"><semantics><mrow><msub><mover accent="true"><mi>τ</mi><mo>^</mo></mover><mn>0</mn></msub><mo>=</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><msub><mi>τ</mi><mi>t</mi></msub><mo>−</mo><mrow><msub><mi>σ</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>ϵ</mi><mi>θ</mi></msub></mrow></mrow><mo stretchy="false">)</mo></mrow><mo>/</mo><msub><mi>α</mi><mi>t</mi></msub></mrow></mrow><annotation encoding="application/x-tex">\hat{\tau}_{0}=({\tau_{t}-\sigma_{t}\epsilon_{\theta}})/{\alpha_{t}}</annotation></semantics></math></td></tr>
<tr id="A0.SS1.fig1.3.1.3" class="ltx_tr">
<td id="A0.SS1.fig1.3.1.3.1" class="ltx_td ltx_align_center ltx_border_r" style="padding-top:1pt;padding-bottom:1pt;"><math id="A0.SS1.m13" class="ltx_Math" alttext="v_{t}" display="inline" intent=":literal"><semantics><msub><mi>v</mi><mi>t</mi></msub><annotation encoding="application/x-tex">v_{t}</annotation></semantics></math><span id="A0.SS1.fig1.3.1.3.1.1" class="ltx_text ltx_font_bold">-loss: <math id="A0.SS1.m14" class="ltx_Math" alttext="\mathbb{E}||\hat{v}_{t}-v_{t}||^{2}" display="inline" intent=":literal"><semantics><mrow><mi>𝔼</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">‖</mo><mrow><msub><mover accent="true"><mi>v</mi><mo>^</mo></mover><mi>t</mi></msub><mo>−</mo><msub><mi>v</mi><mi>t</mi></msub></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup></mrow><annotation encoding="application/x-tex">\mathbb{E}||\hat{v}_{t}-v_{t}||^{2}</annotation></semantics></math></span></td>
<td id="A0.SS1.fig1.3.1.3.2" class="ltx_td ltx_align_center" style="padding-top:1pt;padding-bottom:1pt;"><math id="A0.SS1.m15" class="ltx_Math" alttext="\displaystyle\hat{v}_{t}=({\alpha_{t}\tau_{t}-\tau_{\theta}})/{\sigma_{t}}" display="inline" intent=":literal"><semantics><mrow><msub><mover accent="true"><mi>v</mi><mo>^</mo></mover><mi>t</mi></msub><mo>=</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mrow><msub><mi>α</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>τ</mi><mi>t</mi></msub></mrow><mo>−</mo><msub><mi>τ</mi><mi>θ</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mo>/</mo><msub><mi>σ</mi><mi>t</mi></msub></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\hat{v}_{t}=({\alpha_{t}\tau_{t}-\tau_{\theta}})/{\sigma_{t}}</annotation></semantics></math></td>
<td id="A0.SS1.fig1.3.1.3.3" class="ltx_td ltx_align_center" style="padding-top:1pt;padding-bottom:1pt;"><math id="A0.SS1.m16" class="ltx_Math" alttext="\hat{v}_{t}=v_{\theta;t}" display="inline" intent=":literal"><semantics><mrow><msub><mover accent="true"><mi>v</mi><mo>^</mo></mover><mi>t</mi></msub><mo>=</mo><msub><mi>v</mi><mrow><mi>θ</mi><mo>;</mo><mi>t</mi></mrow></msub></mrow><annotation encoding="application/x-tex">\hat{v}_{t}=v_{\theta;t}</annotation></semantics></math></td>
