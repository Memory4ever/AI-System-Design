segment length <math id="alg4.l1.m3" class="ltx_Math" alttext="S" display="inline" intent=":literal"><semantics><mi>S</mi><annotation encoding="application/x-tex">S</annotation></semantics></math>; local window <math id="alg4.l1.m4" class="ltx_Math" alttext="W\leq S" display="inline" intent=":literal"><semantics><mrow><mi>W</mi><mo>≤</mo><mi>S</mi></mrow><annotation encoding="application/x-tex">W\leq S</annotation></semantics></math>; threshold <math id="alg4.l1.m5" class="ltx_Math" alttext="\tau" display="inline" intent=":literal"><semantics><mi>τ</mi><annotation encoding="application/x-tex">\tau</annotation></semantics></math>; tile sizes <math id="alg4.l1.m6" class="ltx_Math" alttext="(B_{M},B_{N})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><msub><mi>B</mi><mi>M</mi></msub><mo>,</mo><msub><mi>B</mi><mi>N</mi></msub><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(B_{M},B_{N})</annotation></semantics></math>

