                    <span id="alg4.l18.2" class="ltx_text ltx_font_bold">break</span>

</div>
<div id="alg4.l19" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline">19:</span>
              
              
                  <span id="alg4.l19.2" class="ltx_text ltx_font_bold">end</span> <span id="alg4.l19.3" class="ltx_text ltx_font_bold">if</span>
</div>
