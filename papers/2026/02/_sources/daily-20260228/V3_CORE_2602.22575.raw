                  <math id="alg4.l20.m1" class="ltx_Math" alttext="s\leftarrow s^{\prime}" display="inline" intent=":literal"><semantics><mrow><mi>s</mi><mo stretchy="false">←</mo><msup><mi>s</mi><mo>′</mo></msup></mrow><annotation encoding="application/x-tex">s\leftarrow s^{\prime}</annotation></semantics></math>

