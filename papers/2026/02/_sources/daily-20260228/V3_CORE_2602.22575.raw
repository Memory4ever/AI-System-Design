</figure>
<figure id="S4.T3" class="ltx_table">
<div id="S4.T3.2" class="ltx_inline-block ltx_align_center ltx_transformed_outer" style="width:345.0pt;height:64.6pt;vertical-align:-29.0pt;"><span class="ltx_transformed_inner" style="transform:translate(41.3pt,-7.7pt) scale(1.31444318890743,1.31444318890743) ;">
