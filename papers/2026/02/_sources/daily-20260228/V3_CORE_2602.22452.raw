<td id="S4.T2.2.1.2" class="ltx_td ltx_align_center ltx_border_tt" style="padding-top:1.25pt;padding-bottom:1.25pt;"><span id="S4.T2.2.1.2.1" class="ltx_text ltx_font_bold">Steps</span></td>
