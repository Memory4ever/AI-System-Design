<td id="S5.T1.4.1.3.2" class="ltx_td ltx_align_center ltx_border_t" rowspan="3"><span id="S5.T1.4.1.3.2.1" class="ltx_text">1</span></td>
<td id="S5.T1.4.1.3.3" class="ltx_td ltx_align_left ltx_border_r ltx_border_t">Query (<math id="S5.T1.m7" class="ltx_Math" alttext="\pi_{\text{query}}" display="inline" intent=":literal"><semantics><msub><mi>π</mi><mtext>query</mtext></msub><annotation encoding="application/x-tex">\pi_{\text{query}}</annotation></semantics></math>)</td>
<td id="S5.T1.4.1.3.4" class="ltx_td ltx_align_center ltx_border_t">0.37</td>
<td id="S5.T1.4.1.3.5" class="ltx_td ltx_align_center ltx_border_t">0.76</td>
<td id="S5.T1.4.1.3.6" class="ltx_td ltx_align_center ltx_border_t">0.42</td>
<td id="S5.T1.4.1.3.7" class="ltx_td ltx_align_center ltx_border_t">29.97</td>
<td id="S5.T1.4.1.3.8" class="ltx_td ltx_align_center ltx_border_t">2.10</td>
<td id="S5.T1.4.1.3.9" class="ltx_td ltx_align_center ltx_border_t">90.82</td>
<td id="S5.T1.4.1.3.10" class="ltx_td ltx_align_center ltx_border_t">6.62</td>
