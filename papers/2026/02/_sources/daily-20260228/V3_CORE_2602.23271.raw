<td id="S5.T1.4.1.1.2" class="ltx_td ltx_align_center ltx_border_tt" rowspan="2"><span id="S5.T1.4.1.1.2.1" class="ltx_text ltx_font_bold">Step</span></td>
<td id="S5.T1.4.1.1.3" class="ltx_td ltx_align_left ltx_border_r ltx_border_tt" rowspan="2"><span id="S5.T1.4.1.1.3.1" class="ltx_text ltx_font_bold">Module</span></td>
<td id="S5.T1.4.1.1.4" class="ltx_td ltx_align_center ltx_border_tt" colspan="3"><math id="S5.T1.m4" class="ltx_Math" alttext="\widehat{\text{TV}}(\widetilde{\mathbf{X}})" display="inline" intent=":literal"><semantics><mrow><mover accent="true"><mtext class="ltx_mathvariant_bold">TV</mtext><mo>^</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mover accent="true"><mi>𝐗</mi><mo>~</mo></mover><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\widehat{\text{TV}}(\widetilde{\mathbf{X}})</annotation></semantics></math></td>
<td id="S5.T1.4.1.1.5" class="ltx_td ltx_align_center ltx_border_tt" colspan="2"><math id="S5.T1.m5" class="ltx_Math" alttext="\sqrt{\widehat{\text{TV}}(\|\mathbf{X}\|_{0})}" display="inline" intent=":literal"><semantics><msqrt><mrow><mover accent="true"><mtext class="ltx_mathvariant_bold">TV</mtext><mo>^</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mrow><mo stretchy="false">‖</mo><mi>𝐗</mi><mo stretchy="false">‖</mo></mrow><mn>0</mn></msub><mo stretchy="false">)</mo></mrow></mrow></msqrt><annotation encoding="application/x-tex">\sqrt{\widehat{\text{TV}}(\|\mathbf{X}\|_{0})}</annotation></semantics></math></td>
<td id="S5.T1.4.1.1.6" class="ltx_td ltx_align_center ltx_border_tt" colspan="2"><span id="S5.T1.4.1.1.6.1" class="ltx_text ltx_font_bold">Mean Count (<math id="S5.T1.m6" class="ltx_Math" alttext="\mu" display="inline" intent=":literal"><semantics><mi>μ</mi><annotation encoding="application/x-tex">\mu</annotation></semantics></math>)</span></td>
<td id="S5.T1.4.1.1.7" class="ltx_td ltx_align_center ltx_border_tt" rowspan="2"><span id="S5.T1.4.1.1.7.1" class="ltx_text ltx_font_bold">Acc.</span></td></tr>
<tr id="S5.T1.4.1.2" class="ltx_tr">
