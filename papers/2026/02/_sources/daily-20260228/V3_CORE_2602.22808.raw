<tr id="A2.T8.13.4" class="ltx_tr">
<td id="A2.T8.13.4.1" class="ltx_td ltx_align_left" style="padding-top:0.35pt;padding-bottom:0.35pt;"><span id="A2.T8.13.4.1.1" class="ltx_text" style="font-size:90%;">AWorld <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib38" title="" class="ltx_ref">72</a>]</cite></span></td>
