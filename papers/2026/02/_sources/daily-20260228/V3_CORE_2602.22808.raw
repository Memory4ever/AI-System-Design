<td id="S4.T4.7.6.1" class="ltx_td ltx_align_left ltx_border_r" style="padding-top:0.35pt;padding-bottom:0.35pt;"><span id="S4.T4.7.6.1.1" class="ltx_text" style="font-size:90%;">GPT-5 <math id="S4.T4.m5" class="ltx_Math" alttext="\times 4" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo lspace="0.222em" rspace="0.222em">×</mo><mn>4</mn></mrow><annotation encoding="application/x-tex">\times 4</annotation></semantics></math></span></td>
