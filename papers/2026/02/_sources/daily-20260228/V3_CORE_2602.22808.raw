<td id="A2.T8.13.4.5" class="ltx_td ltx_align_center" style="padding-top:0.35pt;padding-bottom:0.35pt;"><span id="A2.T8.13.4.5.1" class="ltx_text" style="font-size:90%;">-</span></td></tr>
<tr id="A2.T8.13.5" class="ltx_tr">
<td id="A2.T8.13.5.1" class="ltx_td ltx_align_left" style="padding-top:0.35pt;padding-bottom:0.35pt;"><span id="A2.T8.13.5.1.1" class="ltx_text" style="font-size:90%;">Tongyi–D.R. <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib49" title="" class="ltx_ref">60</a>]</cite></span></td>
<td id="A2.T8.13.5.2" class="ltx_td ltx_align_left" style="padding-top:0.35pt;padding-bottom:0.35pt;"><span id="A2.T8.13.5.2.1" class="ltx_text" style="font-size:90%;">Tongyi–D.R.–30B–A3B</span></td>
<td id="A2.T8.13.5.3" class="ltx_td ltx_align_center" style="padding-top:0.35pt;padding-bottom:0.35pt;"><span id="A2.T8.13.5.3.1" class="ltx_text" style="font-size:90%;--ltx-fg-color:#000000;">Single-Agent</span></td>
