<td id="S4.T1.6.1.6.5" class="ltx_td ltx_align_center ltx_border_bb"><span id="S4.T1.6.1.6.5.1" class="ltx_text ltx_font_bold">0.94</span></td>
<td id="S4.T1.6.1.6.6" class="ltx_td ltx_align_center ltx_border_bb">78.1</td></tr>
