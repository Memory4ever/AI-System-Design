                  <span id="alg1.l6.3" class="ltx_text ltx_font_bold">if</span> <math id="alg1.l6.m1" class="ltx_Math" alttext="\text{has\_substantial\_content}(tokens)" display="inline" intent=":literal"><semantics><mrow><mtext>has_substantial_content</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>t</mi><mo lspace="0em" rspace="0em">​</mo><mi>o</mi><mo lspace="0em" rspace="0em">​</mo><mi>k</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><mi>s</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\text{has\_substantial\_content}(tokens)</annotation></semantics></math> <span id="alg1.l6.4" class="ltx_text ltx_font_bold">then</span>



