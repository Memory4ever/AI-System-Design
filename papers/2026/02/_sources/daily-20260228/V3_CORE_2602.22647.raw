            <math id="algorithm2.m11" class="ltx_Math" alttext="idx_{start}\leftarrow\mathbf{P}[n_{curr}]" display="inline" intent=":literal"><semantics><mrow><mrow><mi mathsize="0.900em">i</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">d</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi mathsize="0.900em">x</mi><mrow><mi mathsize="0.900em">s</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">t</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">a</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">r</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">t</mi></mrow></msub></mrow><mo mathsize="0.900em" stretchy="false">←</mo><mrow><mi mathsize="0.900em">𝐏</mi><mo>⁡</mo><mrow><mo maxsize="0.900em" minsize="0.900em">[</mo><msub><mi mathsize="0.900em">n</mi><mrow><mi mathsize="0.900em">c</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">u</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">r</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">r</mi></mrow></msub><mo maxsize="0.900em" minsize="0.900em">]</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">idx_{start}\leftarrow\mathbf{P}[n_{curr}]</annotation></semantics></math><span id="algorithm2.6.5.2" class="ltx_text" style="font-size:90%;"> </span>
</div>
