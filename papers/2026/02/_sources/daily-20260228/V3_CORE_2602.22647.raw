<td id="S5.T1.2.1.3.2" class="ltx_td ltx_align_center ltx_border_t"><math id="S5.T1.m4" class="ltx_Math" alttext="+34.1" display="inline" intent=":literal"><semantics><mrow><mo>+</mo><mn>34.1</mn></mrow><annotation encoding="application/x-tex">+34.1</annotation></semantics></math></td>
