            <math id="algorithm2.m12" class="ltx_Math" alttext="N_{child}\leftarrow\mathbf{P}[n_{curr}+1]-idx_{start}" display="inline" intent=":literal"><semantics><mrow><msub><mi mathsize="0.900em">N</mi><mrow><mi mathsize="0.900em">c</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">h</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">i</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">l</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">d</mi></mrow></msub><mo mathsize="0.900em" stretchy="false">←</mo><mrow><mrow><mi mathsize="0.900em">𝐏</mi><mo>⁡</mo><mrow><mo maxsize="0.900em" minsize="0.900em">[</mo><mrow><msub><mi mathsize="0.900em">n</mi><mrow><mi mathsize="0.900em">c</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">u</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">r</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">r</mi></mrow></msub><mo mathsize="0.900em">+</mo><mn mathsize="0.900em">1</mn></mrow><mo maxsize="0.900em" minsize="0.900em">]</mo></mrow></mrow><mo mathsize="0.900em">−</mo><mrow><mi mathsize="0.900em">i</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">d</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi mathsize="0.900em">x</mi><mrow><mi mathsize="0.900em">s</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">t</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">a</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">r</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">t</mi></mrow></msub></mrow></mrow></mrow><annotation encoding="application/x-tex">N_{child}\leftarrow\mathbf{P}[n_{curr}+1]-idx_{start}</annotation></semantics></math><span id="algorithm2.6.6.2" class="ltx_text" style="font-size:90%;">   </span><span id="algorithm2.6.6.3" class="ltx_text ltx_font_typewriter" style="font-size:80%;--ltx-fg-color:#808080;">// </span><span id="algorithm2.6.6.4" class="ltx_text ltx_font_typewriter" style="font-size:80%;--ltx-fg-color:#808080;">Compute # of children</span>
</div>
