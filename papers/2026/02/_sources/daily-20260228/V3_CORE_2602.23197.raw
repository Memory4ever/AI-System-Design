<div id="A1.Thmtheorem6" class="ltx_theorem ltx_theorem_lemma">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="A1.Thmtheorem6.2" class="ltx_text ltx_font_bold">Lemma A.6</span></span><span id="A1.Thmtheorem6.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="A1.Thmtheorem6.p1" class="ltx_para">
<p id="A1.Thmtheorem6.p1.1" class="ltx_p"><span id="A1.Thmtheorem6.p1.1.1" class="ltx_text ltx_font_italic">Given <math id="A1.Thmtheorem6.p1.m1" class="ltx_Math" alttext="{\mathbf{\theta}}_{0}\in{\mathbb{R}}^{d}" display="inline" intent=":literal"><semantics><mrow><msub><mi>θ</mi><mn>0</mn></msub><mo>∈</mo><msup><mi>ℝ</mi><mi>d</mi></msup></mrow><annotation encoding="application/x-tex">{\mathbf{\theta}}_{0}\in{\mathbb{R}}^{d}</annotation></semantics></math>, assume <math id="A1.Thmtheorem6.p1.m2" class="ltx_Math" alttext="v_{22}\neq 0" display="inline" intent=":literal"><semantics><mrow><msub><mi>v</mi><mn>22</mn></msub><mo>≠</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">v_{22}\neq 0</annotation></semantics></math>, consider the parameters</span></p>
<table id="A1.E189" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A1.E189.m1" class="ltx_Math" alttext="{\mathbf{V}}=\begin{bmatrix}0&{\mathbf{0}}_{d}^{\top}&amp;0\\
{\mathbf{0}}_{d}&{\mathbf{0}}_{d}{\mathbf{0}}_{d}^{\top}&{\mathbf{0}}_{d}\\
0&{\mathbf{v}}_{21}^{\top}&amp;v_{22}\end{bmatrix},\qquad{\mathbf{Q}}=\begin{bmatrix}0&{\mathbf{0}}_{d}^{\top}&amp;0\\
{\mathbf{0}}_{d}&{\mathbf{\Sigma}}^{-1}&{\mathbf{0}}_{d}\\
0&{\mathbf{0}}_{d}^{\top}&amp;0\end{bmatrix}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mi>𝐕</mi><mo>=</mo><mrow><mo>[</mo><mtable columnspacing="5pt" displaystyle="true" rowspacing="0pt"><mtr><mtd><mn>0</mn></mtd><mtd><msubsup><mn>𝟎</mn><mi>d</mi><mo>⊤</mo></msubsup></mtd><mtd><mn>0</mn></mtd></mtr><mtr><mtd><msub><mn>𝟎</mn><mi>d</mi></msub></mtd><mtd><mrow><msub><mn>𝟎</mn><mi>d</mi></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mn>𝟎</mn><mi>d</mi><mo>⊤</mo></msubsup></mrow></mtd><mtd><msub><mn>𝟎</mn><mi>d</mi></msub></mtd></mtr><mtr><mtd><mn>0</mn></mtd><mtd><msubsup><mi>𝐯</mi><mn>21</mn><mo>⊤</mo></msubsup></mtd><mtd><msub><mi>v</mi><mn>22</mn></msub></mtd></mtr></mtable><mo>]</mo></mrow></mrow><mo rspace="2.167em">,</mo><mrow><mi>𝐐</mi><mo>=</mo><mrow><mo>[</mo><mtable columnspacing="5pt" displaystyle="true" rowspacing="0pt"><mtr><mtd><mn>0</mn></mtd><mtd><msubsup><mn>𝟎</mn><mi>d</mi><mo>⊤</mo></msubsup></mtd><mtd><mn>0</mn></mtd></mtr><mtr><mtd><msub><mn>𝟎</mn><mi>d</mi></msub></mtd><mtd><msup><mi>𝚺</mi><mrow><mo>−</mo><mn>1</mn></mrow></msup></mtd><mtd><msub><mn>𝟎</mn><mi>d</mi></msub></mtd></mtr><mtr><mtd><mn>0</mn></mtd><mtd><msubsup><mn>𝟎</mn><mi>d</mi><mo>⊤</mo></msubsup></mtd><mtd><mn>0</mn></mtd></mtr></mtable><mo>]</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">{\mathbf{V}}=\begin{bmatrix}0&amp;{\mathbf{0}}_{d}^{\top}&amp;0\\
{\mathbf{0}}_{d}&amp;{\mathbf{0}}_{d}{\mathbf{0}}_{d}^{\top}&amp;{\mathbf{0}}_{d}\\
0&amp;{\mathbf{v}}_{21}^{\top}&amp;v_{22}\end{bmatrix},\qquad{\mathbf{Q}}=\begin{bmatrix}0&amp;{\mathbf{0}}_{d}^{\top}&amp;0\\
{\mathbf{0}}_{d}&amp;{\mathbf{\Sigma}}^{-1}&amp;{\mathbf{0}}_{d}\\
0&amp;{\mathbf{0}}_{d}^{\top}&amp;0\end{bmatrix}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(189)</span></td></tr></tbody>
</table>
<p id="A1.Thmtheorem6.p1.2" class="ltx_p"><span id="A1.Thmtheorem6.p1.2.1" class="ltx_text ltx_font_italic">Then, the following holds:</span></p>
<table id="A1.EGx52" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A1.E190"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.E190.m1" class="ltx_Math" alttext="\displaystyle\displaystyle\mathbb{E}_{{\mathbf{x}},y\mid{\mathbf{\theta}}_{0}}\left[\big(\hat{y}_{\mathrm{ZS}}({\mathbf{x}};{\mathbf{V}},{\mathbf{Q}})-y\big)^{2}\right]=(d+2)(d+4){\mathbf{v}}_{21}^{\top}{\mathbf{\Sigma}}{\mathbf{v}}_{21}-2(d+2){\mathbf{v}}_{21}^{\top}{\mathbf{\Sigma}}{\mathbf{\theta}}_{0}+{\mathbf{\theta}}_{0}^{\top}{\mathbf{\Sigma}}{\mathbf{\theta}}_{0}+\sigma^{2}," display="inline" intent=":literal"><semantics><mrow><mrow><mrow><msub><mi>𝔼</mi><mrow><mi>𝐱</mi><mo>,</mo><mrow><mi>y</mi><mo fence="false">|</mo><msub><mi>θ</mi><mn>0</mn></msub></mrow></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><msup><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mrow><mrow><msub><mover accent="true"><mi>y</mi><mo>^</mo></mover><mi>ZS</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐱</mi><mo>,</mo><mi>𝐕</mi><mo>,</mo><mi>𝐐</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mi>y</mi></mrow><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow><mn>2</mn></msup><mo>]</mo></mrow></mrow><mo>=</mo><mrow><mrow><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>d</mi><mo>+</mo><mn>2</mn></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>d</mi><mo>+</mo><mn>4</mn></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝐯</mi><mn>21</mn><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>𝚺</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝐯</mi><mn>21</mn></msub></mrow><mo>−</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>d</mi><mo>+</mo><mn>2</mn></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝐯</mi><mn>21</mn><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>𝚺</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>θ</mi><mn>0</mn></msub></mrow></mrow><mo>+</mo><mrow><msubsup><mi>θ</mi><mn>0</mn><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>𝚺</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>θ</mi><mn>0</mn></msub></mrow><mo>+</mo><msup><mi>σ</mi><mn>2</mn></msup></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\displaystyle\mathbb{E}_{{\mathbf{x}},y\mid{\mathbf{\theta}}_{0}}\left[\big(\hat{y}_{\mathrm{ZS}}({\mathbf{x}};{\mathbf{V}},{\mathbf{Q}})-y\big)^{2}\right]=(d+2)(d+4){\mathbf{v}}_{21}^{\top}{\mathbf{\Sigma}}{\mathbf{v}}_{21}-2(d+2){\mathbf{v}}_{21}^{\top}{\mathbf{\Sigma}}{\mathbf{\theta}}_{0}+{\mathbf{\theta}}_{0}^{\top}{\mathbf{\Sigma}}{\mathbf{\theta}}_{0}+\sigma^{2},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(190)</span></td></tr></tbody>
<tbody id="A1.E191"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.E191.m1" class="ltx_Math" alttext="\displaystyle\displaystyle\mathbb{E}_{{\mathbf{Z}}_{[n]},{\mathbf{x}},y|{\mathbf{\theta}}_{0}}\left[\big(\hat{y}_{\mathrm{FS}}({\mathbf{Z}}_{[n]},{\mathbf{x}};{\mathbf{V}},{\mathbf{Q}})-y\big)^{2}\right]" display="inline" intent=":literal"><semantics><mrow><msub><mi>𝔼</mi><mrow><msub><mi>𝐙</mi><mrow><mo stretchy="false">[</mo><mi>n</mi><mo stretchy="false">]</mo></mrow></msub><mo>,</mo><mi>𝐱</mi><mo>,</mo><mrow><mi>y</mi><mo fence="false">|</mo><msub><mi>θ</mi><mn>0</mn></msub></mrow></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><msup><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mrow><mrow><msub><mover accent="true"><mi>y</mi><mo>^</mo></mover><mi>FS</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐙</mi><mrow><mo stretchy="false">[</mo><mi>n</mi><mo stretchy="false">]</mo></mrow></msub><mo>,</mo><mi>𝐱</mi><mo>,</mo><mi>𝐕</mi><mo>,</mo><mi>𝐐</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mi>y</mi></mrow><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow><mn>2</mn></msup><mo>]</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\displaystyle\mathbb{E}_{{\mathbf{Z}}_{[n]},{\mathbf{x}},y|{\mathbf{\theta}}_{0}}\left[\big(\hat{y}_{\mathrm{FS}}({\mathbf{Z}}_{[n]},{\mathbf{x}};{\mathbf{V}},{\mathbf{Q}})-y\big)^{2}\right]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(191)</span></td></tr></tbody>
<tbody id="A1.E192"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.E192.m1" class="ltx_Math" alttext="\displaystyle=\frac{1}{(n+1)^{2}}\Big(\!\big((d+2)(d+4)+n(n+5+3d)\big){\mathbf{v}}_{21}^{\top}{\mathbf{\Sigma}}{\mathbf{v}}_{21}+2\big(\!-\!d+2+n(n+3+2d)v_{22}\!-\!n(n\!+\!3\!+\!d)\big){\mathbf{v}}_{21}^{\top}{\mathbf{\Sigma}}{\mathbf{\theta}}_{0}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><msup><mrow><mo stretchy="false">(</mo><mrow><mi>n</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="1.600em" minsize="1.600em">(</mo><mrow><mrow><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mrow><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>d</mi><mo>+</mo><mn>2</mn></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>d</mi><mo>+</mo><mn>4</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mrow><mi>n</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>n</mi><mo>+</mo><mn>5</mn><mo>+</mo><mrow><mn>3</mn><mo lspace="0em" rspace="0em">​</mo><mi>d</mi></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝐯</mi><mn>21</mn><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>𝚺</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝐯</mi><mn>21</mn></msub></mrow><mo>+</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mrow><mrow><mrow><mo>−</mo><mi>d</mi></mrow><mo>+</mo><mn>2</mn><mo>+</mo><mrow><mrow><mi>n</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>n</mi><mo>+</mo><mn>3</mn><mo>+</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>d</mi></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>v</mi><mn>22</mn></msub></mrow></mrow><mo rspace="0.052em">−</mo><mrow><mi>n</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mi>n</mi><mpadded style="width:0.608em;" width="0.608em"><mo lspace="0.052em">+</mo></mpadded></mrow><mo rspace="0.052em">+</mo><mi>d</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝐯</mi><mn>21</mn><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>𝚺</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>θ</mi><mn>0</mn></msub></mrow></mrow><mo fence="true" lspace="0em">CLOSE</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\frac{1}{(n+1)^{2}}\Big(\!\big((d+2)(d+4)+n(n+5+3d)\big){\mathbf{v}}_{21}^{\top}{\mathbf{\Sigma}}{\mathbf{v}}_{21}+2\big(\!-\!d+2+n(n+3+2d)v_{22}\!-\!n(n\!+\!3\!+\!d)\big){\mathbf{v}}_{21}^{\top}{\mathbf{\Sigma}}{\mathbf{\theta}}_{0}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(192)</span></td></tr></tbody>
<tbody id="A1.E193"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.E193.m1" class="ltx_Math" alttext="\displaystyle\qquad\qquad\qquad+\big(n(n+1+d)v_{22}^{2}-2n(n+1)v_{22}+(n+1)^{2}\big){\mathbf{\theta}}_{0}^{\top}{\mathbf{\Sigma}}{\mathbf{\theta}}_{0}+\big(nd\cdot v_{22}^{2}+(n+1)^{2}\big)\sigma^{2}\Big)." display="inline" intent=":literal"><semantics><mrow><mrow><mo fence="true" rspace="0em">OPEN</mo><mrow><mrow><mo>+</mo><mrow><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mrow><mrow><mrow><mrow><mi>n</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>n</mi><mo>+</mo><mn>1</mn><mo>+</mo><mi>d</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>v</mi><mn>22</mn><mn>2</mn></msubsup></mrow><mo>−</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>n</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>v</mi><mn>22</mn></msub></mrow></mrow><mo>+</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mi>n</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mrow><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>θ</mi><mn>0</mn><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>𝚺</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>θ</mi><mn>0</mn></msub></mrow></mrow><mo>+</mo><mrow><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mrow><mrow><mrow><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><mi>d</mi></mrow><mo lspace="0.222em" rspace="0.222em">⋅</mo><msubsup><mi>v</mi><mn>22</mn><mn>2</mn></msubsup></mrow><mo>+</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mi>n</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mrow><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mi>σ</mi><mn>2</mn></msup></mrow></mrow><mo maxsize="1.600em" minsize="1.600em">)</mo></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\qquad\qquad\qquad+\big(n(n+1+d)v_{22}^{2}-2n(n+1)v_{22}+(n+1)^{2}\big){\mathbf{\theta}}_{0}^{\top}{\mathbf{\Sigma}}{\mathbf{\theta}}_{0}+\big(nd\cdot v_{22}^{2}+(n+1)^{2}\big)\sigma^{2}\Big).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(193)</span></td></tr></tbody>
<tbody id="A1.E194"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.E194.m1" class="ltx_Math" alttext="\displaystyle\lim_{n\to\infty}\displaystyle\mathbb{E}_{{\mathbf{Z}}_{[n]},{\mathbf{x}},y\mid{\mathbf{\theta}}_{0}}\left[\big(\hat{y}_{\mathrm{FS}}({\mathbf{Z}}_{[n]},{\mathbf{x}};{\mathbf{V}},{\mathbf{Q}})-y\big)^{2}\right]=\big({\mathbf{v}}_{21}+(v_{22}-1){\mathbf{\theta}}_{0}\big)^{\top}{\mathbf{\Sigma}}\big({\mathbf{v}}_{21}+(v_{22}-1){\mathbf{\theta}}_{0}\big)+\sigma^{2}." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><munder><mo movablelimits="false">lim</mo><mrow><mi>n</mi><mo stretchy="false">→</mo><mi mathvariant="normal">∞</mi></mrow></munder><mrow><msub><mi>𝔼</mi><mrow><msub><mi>𝐙</mi><mrow><mo stretchy="false">[</mo><mi>n</mi><mo stretchy="false">]</mo></mrow></msub><mo>,</mo><mi>𝐱</mi><mo>,</mo><mrow><mi>y</mi><mo fence="false">|</mo><msub><mi>θ</mi><mn>0</mn></msub></mrow></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><msup><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mrow><mrow><msub><mover accent="true"><mi>y</mi><mo>^</mo></mover><mi>FS</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐙</mi><mrow><mo stretchy="false">[</mo><mi>n</mi><mo stretchy="false">]</mo></mrow></msub><mo>,</mo><mi>𝐱</mi><mo>,</mo><mi>𝐕</mi><mo>,</mo><mi>𝐐</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mi>y</mi></mrow><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow><mn>2</mn></msup><mo>]</mo></mrow></mrow></mrow><mo>=</mo><mrow><mrow><msup><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mrow><msub><mi>𝐯</mi><mn>21</mn></msub><mo>+</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><msub><mi>v</mi><mn>22</mn></msub><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>θ</mi><mn>0</mn></msub></mrow></mrow><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>𝚺</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mrow><msub><mi>𝐯</mi><mn>21</mn></msub><mo>+</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><msub><mi>v</mi><mn>22</mn></msub><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>θ</mi><mn>0</mn></msub></mrow></mrow><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow></mrow><mo>+</mo><msup><mi>σ</mi><mn>2</mn></msup></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\lim_{n\to\infty}\displaystyle\mathbb{E}_{{\mathbf{Z}}_{[n]},{\mathbf{x}},y\mid{\mathbf{\theta}}_{0}}\left[\big(\hat{y}_{\mathrm{FS}}({\mathbf{Z}}_{[n]},{\mathbf{x}};{\mathbf{V}},{\mathbf{Q}})-y\big)^{2}\right]=\big({\mathbf{v}}_{21}+(v_{22}-1){\mathbf{\theta}}_{0}\big)^{\top}{\mathbf{\Sigma}}\big({\mathbf{v}}_{21}+(v_{22}-1){\mathbf{\theta}}_{0}\big)+\sigma^{2}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(194)</span></td></tr></tbody>
</table>
</div>
</div>
<div id="A1.SS2.4" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="A1.SS2.p12" class="ltx_para">
<p id="A1.SS2.p12.1" class="ltx_p"><span id="A1.SS2.p12.1.1" class="ltx_text">By the definition of the linear attention model in (<a href="#S3.E2" title="Equation 2 ‣ Transformer Architecture. ‣ 3 Problem Setup ‣ Fine-Tuning Without Forgetting In-Context Learning:A Theoretical Analysis of Linear Attention Models" class="ltx_ref"><span class="ltx_text ltx_ref_tag">2</span></a>), for any input <math id="A1.SS2.p12.m1" class="ltx_Math" alttext="{\mathbf{Z}}" display="inline" intent=":literal"><semantics><mi>𝐙</mi><annotation encoding="application/x-tex">{\mathbf{Z}}</annotation></semantics></math>, the prediction <math id="A1.SS2.p12.m2" class="ltx_Math" alttext="f({\mathbf{Z}};{\mathbf{V}},{\mathbf{Q}})" display="inline" intent=":literal"><semantics><mrow><mi>f</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝐙</mi><mo>,</mo><mi>𝐕</mi><mo>,</mo><mi>𝐐</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">f({\mathbf{Z}};{\mathbf{V}},{\mathbf{Q}})</annotation></semantics></math> produced by the parameters in (<a href="#A1.E189" title="Equation 189 ‣ Lemma A.6. ‣ A.2 Proofs of Statistical Properties of Model Outputs ‣ Appendix A Proofs ‣ Fine-Tuning Without Forgetting In-Context Learning:A Theoretical Analysis of Linear Attention Models" class="ltx_ref"><span class="ltx_text ltx_ref_tag">189</span></a>) is identical to that produced by the rescaled parameter pair</span></p>
<table id="A1.E195" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A1.E195.m1" class="ltx_Math" alttext="{\mathbf{V}}=\begin{bmatrix}0&{\mathbf{0}}_{d}^{\top}&amp;0\\
{\mathbf{0}}_{d}&{\mathbf{0}}_{d}{\mathbf{0}}_{d}^{\top}&{\mathbf{0}}_{d}\\
0&amp;\tfrac{1}{v_{22}}\cdot{\mathbf{v}}_{21}^{\top}&amp;1\end{bmatrix},\qquad{\mathbf{Q}}=\begin{bmatrix}0&{\mathbf{0}}_{d}^{\top}&amp;0\\
{\mathbf{0}}_{d}&amp;v_{22}\cdot{\mathbf{\Sigma}}^{-1}&{\mathbf{0}}_{d}\\
0&{\mathbf{0}}_{d}^{\top}&amp;0\end{bmatrix}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mi>𝐕</mi><mo>=</mo><mrow><mo>[</mo><mtable columnspacing="5pt" displaystyle="true" rowspacing="0pt"><mtr><mtd><mn>0</mn></mtd><mtd><msubsup><mn>𝟎</mn><mi>d</mi><mo>⊤</mo></msubsup></mtd><mtd><mn>0</mn></mtd></mtr><mtr><mtd><msub><mn>𝟎</mn><mi>d</mi></msub></mtd><mtd><mrow><msub><mn>𝟎</mn><mi>d</mi></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mn>𝟎</mn><mi>d</mi><mo>⊤</mo></msubsup></mrow></mtd><mtd><msub><mn>𝟎</mn><mi>d</mi></msub></mtd></mtr><mtr><mtd><mn>0</mn></mtd><mtd><mrow><mstyle displaystyle="false"><mfrac><mn>1</mn><msub><mi>v</mi><mn>22</mn></msub></mfrac></mstyle><mo lspace="0.222em" rspace="0.222em">⋅</mo><msubsup><mi>𝐯</mi><mn>21</mn><mo>⊤</mo></msubsup></mrow></mtd><mtd><mn>1</mn></mtd></mtr></mtable><mo>]</mo></mrow></mrow><mo rspace="2.167em">,</mo><mrow><mi>𝐐</mi><mo>=</mo><mrow><mo>[</mo><mtable columnspacing="5pt" displaystyle="true" rowspacing="0pt"><mtr><mtd><mn>0</mn></mtd><mtd><msubsup><mn>𝟎</mn><mi>d</mi><mo>⊤</mo></msubsup></mtd><mtd><mn>0</mn></mtd></mtr><mtr><mtd><msub><mn>𝟎</mn><mi>d</mi></msub></mtd><mtd><mrow><msub><mi>v</mi><mn>22</mn></msub><mo lspace="0.222em" rspace="0.222em">⋅</mo><msup><mi>𝚺</mi><mrow><mo>−</mo><mn>1</mn></mrow></msup></mrow></mtd><mtd><msub><mn>𝟎</mn><mi>d</mi></msub></mtd></mtr><mtr><mtd><mn>0</mn></mtd><mtd><msubsup><mn>𝟎</mn><mi>d</mi><mo>⊤</mo></msubsup></mtd><mtd><mn>0</mn></mtd></mtr></mtable><mo>]</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">{\mathbf{V}}=\begin{bmatrix}0&amp;{\mathbf{0}}_{d}^{\top}&amp;0\\
{\mathbf{0}}_{d}&amp;{\mathbf{0}}_{d}{\mathbf{0}}_{d}^{\top}&amp;{\mathbf{0}}_{d}\\
0&amp;\tfrac{1}{v_{22}}\cdot{\mathbf{v}}_{21}^{\top}&amp;1\end{bmatrix},\qquad{\mathbf{Q}}=\begin{bmatrix}0&amp;{\mathbf{0}}_{d}^{\top}&amp;0\\
{\mathbf{0}}_{d}&amp;v_{22}\cdot{\mathbf{\Sigma}}^{-1}&amp;{\mathbf{0}}_{d}\\
0&amp;{\mathbf{0}}_{d}^{\top}&amp;0\end{bmatrix}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(195)</span></td></tr></tbody>
</table>
<p id="A1.SS2.p12.2" class="ltx_p"><span id="A1.SS2.p12.2.1" class="ltx_text">By Lemma <a href="#A1.Thmtheorem5" title="Lemma A.5. ‣ A.2 Proofs of Statistical Properties of Model Outputs ‣ Appendix A Proofs ‣ Fine-Tuning Without Forgetting In-Context Learning:A Theoretical Analysis of Linear Attention Models" class="ltx_ref"><span class="ltx_text ltx_ref_tag">A.5</span></a>, we have</span></p>
<table id="A1.EGx53" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A1.E196"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A1.E196.m1" class="ltx_Math" alttext="\displaystyle\displaystyle\mathbb{E}_{{\mathbf{x}},y|{\mathbf{\theta}}_{0}}\left[\big(\hat{y}_{\mathrm{ZS}}({\mathbf{x}};{\mathbf{V}},{\mathbf{Q}})-y\big)^{2}\right]" display="inline" intent=":literal"><semantics><mrow><msub><mi>𝔼</mi><mrow><mi>𝐱</mi><mo>,</mo><mrow><mi>y</mi><mo fence="false">|</mo><msub><mi>θ</mi><mn>0</mn></msub></mrow></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><msup><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mrow><mrow><msub><mover accent="true"><mi>y</mi><mo>^</mo></mover><mi>ZS</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐱</mi><mo>,</mo><mi>𝐕</mi><mo>,</mo><mi>𝐐</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mi>y</mi></mrow><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow><mn>2</mn></msup><mo>]</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\displaystyle\mathbb{E}_{{\mathbf{x}},y|{\mathbf{\theta}}_{0}}\left[\big(\hat{y}_{\mathrm{ZS}}({\mathbf{x}};{\mathbf{V}},{\mathbf{Q}})-y\big)^{2}\right]</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.E196.m2" class="ltx_Math" alttext="\displaystyle=(d+2)(d+4){\mathbf{v}}_{21}^{\top}{\mathbf{\Sigma}}{\mathbf{v}}_{21}-2(d+2){\mathbf{v}}_{21}^{\top}{\mathbf{\Sigma}}{\mathbf{\theta}}_{0}+{\mathbf{\theta}}_{0}^{\top}{\mathbf{\Sigma}}{\mathbf{\theta}}_{0}+\sigma^{2}," display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>d</mi><mo>+</mo><mn>2</mn></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>d</mi><mo>+</mo><mn>4</mn></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝐯</mi><mn>21</mn><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>𝚺</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝐯</mi><mn>21</mn></msub></mrow><mo>−</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>d</mi><mo>+</mo><mn>2</mn></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝐯</mi><mn>21</mn><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>𝚺</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>θ</mi><mn>0</mn></msub></mrow></mrow><mo>+</mo><mrow><msubsup><mi>θ</mi><mn>0</mn><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>𝚺</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>θ</mi><mn>0</mn></msub></mrow><mo>+</mo><msup><mi>σ</mi><mn>2</mn></msup></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle=(d+2)(d+4){\mathbf{v}}_{21}^{\top}{\mathbf{\Sigma}}{\mathbf{v}}_{21}-2(d+2){\mathbf{v}}_{21}^{\top}{\mathbf{\Sigma}}{\mathbf{\theta}}_{0}+{\mathbf{\theta}}_{0}^{\top}{\mathbf{\Sigma}}{\mathbf{\theta}}_{0}+\sigma^{2},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(196)</span></td></tr></tbody>
<tbody id="A1.E197"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A1.E197.m1" class="ltx_Math" alttext="\displaystyle h({\mathbf{V}},{\mathbf{Q}};{\mathbf{\theta}}_{0})" display="inline" intent=":literal"><semantics><mrow><mi>h</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝐕</mi><mo>,</mo><mi>𝐐</mi><mo>,</mo><msub><mi>θ</mi><mn>0</mn></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle h({\mathbf{V}},{\mathbf{Q}};{\mathbf{\theta}}_{0})</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.E197.m2" class="ltx_Math" alttext="\displaystyle=(n+5+3d){\mathbf{v}}_{21}^{\top}{\mathbf{\Sigma}}{\mathbf{v}}_{21}+2\big((n+3+2d)v_{22}-(n+3+d)\big){\mathbf{v}}_{21}^{\top}{\mathbf{\Sigma}}{\mathbf{\theta}}_{0}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>n</mi><mo>+</mo><mn>5</mn><mo>+</mo><mrow><mn>3</mn><mo lspace="0em" rspace="0em">​</mo><mi>d</mi></mrow></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝐯</mi><mn>21</mn><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>𝚺</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝐯</mi><mn>21</mn></msub></mrow><mo>+</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mrow><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>n</mi><mo>+</mo><mn>3</mn><mo>+</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>d</mi></mrow></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>v</mi><mn>22</mn></msub></mrow><mo>−</mo><mrow><mo stretchy="false">(</mo><mrow><mi>n</mi><mo>+</mo><mn>3</mn><mo>+</mo><mi>d</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝐯</mi><mn>21</mn><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>𝚺</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>θ</mi><mn>0</mn></msub></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=(n+5+3d){\mathbf{v}}_{21}^{\top}{\mathbf{\Sigma}}{\mathbf{v}}_{21}+2\big((n+3+2d)v_{22}-(n+3+d)\big){\mathbf{v}}_{21}^{\top}{\mathbf{\Sigma}}{\mathbf{\theta}}_{0}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(197)</span></td></tr></tbody>
<tbody id="A1.E198"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.E198.m1" class="ltx_Math" alttext="\displaystyle\quad+(n+1)v_{22}^{2}{\mathbf{\theta}}_{0}^{\top}{\mathbf{\Sigma}}{\mathbf{\theta}}_{0}-2(n+1)v_{22}{\mathbf{\theta}}_{0}^{\top}{\mathbf{\Sigma}}{\mathbf{\theta}}_{0}+(d\cdot v_{22}^{2}+n+2)({\mathbf{\theta}}_{0}^{\top}{\mathbf{\Sigma}}{\mathbf{\theta}}_{0}+\sigma^{2})," display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mrow><mo>+</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>n</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>v</mi><mn>22</mn><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>θ</mi><mn>0</mn><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>𝚺</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>θ</mi><mn>0</mn></msub></mrow></mrow><mo>−</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>n</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>v</mi><mn>22</mn></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>θ</mi><mn>0</mn><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>𝚺</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>θ</mi><mn>0</mn></msub></mrow></mrow><mo>+</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mrow><mi>d</mi><mo lspace="0.222em" rspace="0.222em">⋅</mo><msubsup><mi>v</mi><mn>22</mn><mn>2</mn></msubsup></mrow><mo>+</mo><mi>n</mi><mo>+</mo><mn>2</mn></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><msubsup><mi>θ</mi><mn>0</mn><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>𝚺</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>θ</mi><mn>0</mn></msub></mrow><mo>+</mo><msup><mi>σ</mi><mn>2</mn></msup></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\quad+(n+1)v_{22}^{2}{\mathbf{\theta}}_{0}^{\top}{\mathbf{\Sigma}}{\mathbf{\theta}}_{0}-2(n+1)v_{22}{\mathbf{\theta}}_{0}^{\top}{\mathbf{\Sigma}}{\mathbf{\theta}}_{0}+(d\cdot v_{22}^{2}+n+2)({\mathbf{\theta}}_{0}^{\top}{\mathbf{\Sigma}}{\mathbf{\theta}}_{0}+\sigma^{2}),</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(198)</span></td></tr></tbody>
</table>
<p id="A1.SS2.p12.3" class="ltx_p"><span id="A1.SS2.p12.3.1" class="ltx_text">which implies</span></p>
<table id="A1.EGx54" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A1.E199"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.E199.m1" class="ltx_Math" alttext="\displaystyle\displaystyle\mathbb{E}_{{\mathbf{Z}}_{[n]},{\mathbf{x}},y|{\mathbf{\theta}}_{0}}\left[\big(\hat{y}_{\mathrm{FS}}({\mathbf{Z}}_{[n]},{\mathbf{x}};{\mathbf{V}},{\mathbf{Q}})-y\big)^{2}\right]" display="inline" intent=":literal"><semantics><mrow><msub><mi>𝔼</mi><mrow><msub><mi>𝐙</mi><mrow><mo stretchy="false">[</mo><mi>n</mi><mo stretchy="false">]</mo></mrow></msub><mo>,</mo><mi>𝐱</mi><mo>,</mo><mrow><mi>y</mi><mo fence="false">|</mo><msub><mi>θ</mi><mn>0</mn></msub></mrow></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><msup><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mrow><mrow><msub><mover accent="true"><mi>y</mi><mo>^</mo></mover><mi>FS</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐙</mi><mrow><mo stretchy="false">[</mo><mi>n</mi><mo stretchy="false">]</mo></mrow></msub><mo>,</mo><mi>𝐱</mi><mo>,</mo><mi>𝐕</mi><mo>,</mo><mi>𝐐</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mi>y</mi></mrow><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow><mn>2</mn></msup><mo>]</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\displaystyle\mathbb{E}_{{\mathbf{Z}}_{[n]},{\mathbf{x}},y|{\mathbf{\theta}}_{0}}\left[\big(\hat{y}_{\mathrm{FS}}({\mathbf{Z}}_{[n]},{\mathbf{x}};{\mathbf{V}},{\mathbf{Q}})-y\big)^{2}\right]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(199)</span></td></tr></tbody>
<tbody id="A1.E200"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.E200.m1" class="ltx_Math" alttext="\displaystyle=\frac{1}{(n+1)^{2}}\cdot\displaystyle\mathbb{E}_{{\mathbf{x}},y|{\mathbf{\theta}}_{0}}\left[\big(\hat{y}_{\mathrm{ZS}}({\mathbf{x}};{\mathbf{V}},{\mathbf{Q}})-y\big)^{2}\right]+\frac{n}{(n+1)^{2}}\cdot h({\mathbf{V}},{\mathbf{Q}};{\mathbf{\theta}}_{0})" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><msup><mrow><mo stretchy="false">(</mo><mrow><mi>n</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mfrac></mstyle><mo lspace="0.222em" rspace="0.222em">⋅</mo><msub><mi>𝔼</mi><mrow><mi>𝐱</mi><mo>,</mo><mrow><mi>y</mi><mo fence="false">|</mo><msub><mi>θ</mi><mn>0</mn></msub></mrow></mrow></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><msup><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mrow><mrow><msub><mover accent="true"><mi>y</mi><mo>^</mo></mover><mi>ZS</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐱</mi><mo>,</mo><mi>𝐕</mi><mo>,</mo><mi>𝐐</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mi>y</mi></mrow><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow><mn>2</mn></msup><mo>]</mo></mrow></mrow><mo>+</mo><mrow><mstyle displaystyle="true"><mfrac><mi>n</mi><msup><mrow><mo stretchy="false">(</mo><mrow><mi>n</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mfrac></mstyle><mo lspace="0.222em" rspace="0.222em">⋅</mo><mrow><mi>h</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝐕</mi><mo>,</mo><mi>𝐐</mi><mo>,</mo><msub><mi>θ</mi><mn>0</mn></msub><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\frac{1}{(n+1)^{2}}\cdot\displaystyle\mathbb{E}_{{\mathbf{x}},y|{\mathbf{\theta}}_{0}}\left[\big(\hat{y}_{\mathrm{ZS}}({\mathbf{x}};{\mathbf{V}},{\mathbf{Q}})-y\big)^{2}\right]+\frac{n}{(n+1)^{2}}\cdot h({\mathbf{V}},{\mathbf{Q}};{\mathbf{\theta}}_{0})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(200)</span></td></tr></tbody>
<tbody id="A1.E201"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.E201.m1" class="ltx_Math" alttext="\displaystyle=\frac{1}{(n+1)^{2}}\Big(\!\big((d+2)(d+4)+n(n+5+3d)\big){\mathbf{v}}_{21}^{\top}{\mathbf{\Sigma}}{\mathbf{v}}_{21}+2\big(\!-\!d+2+n(n+3+2d)v_{22}\!-\!n(n\!+\!3\!+\!d)\big){\mathbf{v}}_{21}^{\top}{\mathbf{\Sigma}}{\mathbf{\theta}}_{0}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><msup><mrow><mo stretchy="false">(</mo><mrow><mi>n</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="1.600em" minsize="1.600em">(</mo><mrow><mrow><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mrow><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>d</mi><mo>+</mo><mn>2</mn></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>d</mi><mo>+</mo><mn>4</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mrow><mi>n</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>n</mi><mo>+</mo><mn>5</mn><mo>+</mo><mrow><mn>3</mn><mo lspace="0em" rspace="0em">​</mo><mi>d</mi></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝐯</mi><mn>21</mn><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>𝚺</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝐯</mi><mn>21</mn></msub></mrow><mo>+</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mrow><mrow><mrow><mo>−</mo><mi>d</mi></mrow><mo>+</mo><mn>2</mn><mo>+</mo><mrow><mrow><mi>n</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>n</mi><mo>+</mo><mn>3</mn><mo>+</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>d</mi></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>v</mi><mn>22</mn></msub></mrow></mrow><mo rspace="0.052em">−</mo><mrow><mi>n</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mi>n</mi><mpadded style="width:0.608em;" width="0.608em"><mo lspace="0.052em">+</mo></mpadded></mrow><mo rspace="0.052em">+</mo><mi>d</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝐯</mi><mn>21</mn><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>𝚺</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>θ</mi><mn>0</mn></msub></mrow></mrow><mo fence="true" lspace="0em">CLOSE</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\frac{1}{(n+1)^{2}}\Big(\!\big((d+2)(d+4)+n(n+5+3d)\big){\mathbf{v}}_{21}^{\top}{\mathbf{\Sigma}}{\mathbf{v}}_{21}+2\big(\!-\!d+2+n(n+3+2d)v_{22}\!-\!n(n\!+\!3\!+\!d)\big){\mathbf{v}}_{21}^{\top}{\mathbf{\Sigma}}{\mathbf{\theta}}_{0}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(201)</span></td></tr></tbody>
<tbody id="A1.E202"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.E202.m1" class="ltx_Math" alttext="\displaystyle\qquad\qquad\qquad+\big(n(n+1+d)v_{22}^{2}-2n(n+1)v_{22}+(n+1)^{2}\big){\mathbf{\theta}}_{0}^{\top}{\mathbf{\Sigma}}{\mathbf{\theta}}_{0}+\big(nd\cdot v_{22}^{2}+(n+1)^{2}\big)\sigma^{2}\Big)." display="inline" intent=":literal"><semantics><mrow><mrow><mo fence="true" rspace="0em">OPEN</mo><mrow><mrow><mo>+</mo><mrow><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mrow><mrow><mrow><mrow><mi>n</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>n</mi><mo>+</mo><mn>1</mn><mo>+</mo><mi>d</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>v</mi><mn>22</mn><mn>2</mn></msubsup></mrow><mo>−</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>n</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>v</mi><mn>22</mn></msub></mrow></mrow><mo>+</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mi>n</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mrow><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>θ</mi><mn>0</mn><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>𝚺</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>θ</mi><mn>0</mn></msub></mrow></mrow><mo>+</mo><mrow><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mrow><mrow><mrow><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><mi>d</mi></mrow><mo lspace="0.222em" rspace="0.222em">⋅</mo><msubsup><mi>v</mi><mn>22</mn><mn>2</mn></msubsup></mrow><mo>+</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mi>n</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mrow><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mi>σ</mi><mn>2</mn></msup></mrow></mrow><mo maxsize="1.600em" minsize="1.600em">)</mo></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\qquad\qquad\qquad+\big(n(n+1+d)v_{22}^{2}-2n(n+1)v_{22}+(n+1)^{2}\big){\mathbf{\theta}}_{0}^{\top}{\mathbf{\Sigma}}{\mathbf{\theta}}_{0}+\big(nd\cdot v_{22}^{2}+(n+1)^{2}\big)\sigma^{2}\Big).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(202)</span></td></tr></tbody>
</table>
</div>
<div id="A1.SS2.p13" class="ltx_para">
<p id="A1.SS2.p13.1" class="ltx_p"><span id="A1.SS2.p13.1.1" class="ltx_text">Moreover, we have</span></p>
<table id="A1.EGx55" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A1.E203"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A1.E203.m1" class="ltx_Math" alttext="\displaystyle\lim_{n\to\infty}\displaystyle\mathbb{E}_{{\mathbf{Z}}_{[n]},{\mathbf{x}},y|{\mathbf{\theta}}_{0}}\left[\big(\hat{y}_{\mathrm{FS}}({\mathbf{Z}}_{[n]},{\mathbf{x}};{\mathbf{V}},{\mathbf{Q}})-y\big)^{2}\right]" display="inline" intent=":literal"><semantics><mrow><munder><mo movablelimits="false">lim</mo><mrow><mi>n</mi><mo stretchy="false">→</mo><mi mathvariant="normal">∞</mi></mrow></munder><mrow><msub><mi>𝔼</mi><mrow><msub><mi>𝐙</mi><mrow><mo stretchy="false">[</mo><mi>n</mi><mo stretchy="false">]</mo></mrow></msub><mo>,</mo><mi>𝐱</mi><mo>,</mo><mrow><mi>y</mi><mo fence="false">|</mo><msub><mi>θ</mi><mn>0</mn></msub></mrow></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><msup><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mrow><mrow><msub><mover accent="true"><mi>y</mi><mo>^</mo></mover><mi>FS</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐙</mi><mrow><mo stretchy="false">[</mo><mi>n</mi><mo stretchy="false">]</mo></mrow></msub><mo>,</mo><mi>𝐱</mi><mo>,</mo><mi>𝐕</mi><mo>,</mo><mi>𝐐</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mi>y</mi></mrow><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow><mn>2</mn></msup><mo>]</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\lim_{n\to\infty}\displaystyle\mathbb{E}_{{\mathbf{Z}}_{[n]},{\mathbf{x}},y|{\mathbf{\theta}}_{0}}\left[\big(\hat{y}_{\mathrm{FS}}({\mathbf{Z}}_{[n]},{\mathbf{x}};{\mathbf{V}},{\mathbf{Q}})-y\big)^{2}\right]</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.E203.m2" class="ltx_Math" alttext="\displaystyle=\lim_{n\to\infty}\frac{1}{n}h({\mathbf{V}},{\mathbf{Q}};{\mathbf{\theta}}_{0})" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo rspace="0.1389em">=</mo><mrow><munder><mo lspace="0.1389em" movablelimits="false" rspace="0.167em">lim</mo><mrow><mi>n</mi><mo stretchy="false">→</mo><mi mathvariant="normal">∞</mi></mrow></munder><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>n</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mi>h</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐕</mi><mo>,</mo><mi>𝐐</mi><mo>,</mo><msub><mi>θ</mi><mn>0</mn></msub><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\lim_{n\to\infty}\frac{1}{n}h({\mathbf{V}},{\mathbf{Q}};{\mathbf{\theta}}_{0})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(203)</span></td></tr></tbody>
<tbody id="A1.E204"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.E204.m1" class="ltx_Math" alttext="\displaystyle={\mathbf{v}}_{21}^{\top}{\mathbf{\Sigma}}{\mathbf{v}}_{21}+2\big(v_{22}-1\big){\mathbf{v}}_{21}^{\top}{\mathbf{\Sigma}}{\mathbf{\theta}}_{0}+(v_{22}-1)^{2}{\mathbf{\theta}}_{0}^{\top}{\mathbf{\Sigma}}{\mathbf{\theta}}_{0}+\sigma^{2}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><msubsup><mi>𝐯</mi><mn>21</mn><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>𝚺</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝐯</mi><mn>21</mn></msub></mrow><mo>+</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mrow><msub><mi>v</mi><mn>22</mn></msub><mo>−</mo><mn>1</mn></mrow><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝐯</mi><mn>21</mn><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>𝚺</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>θ</mi><mn>0</mn></msub></mrow><mo>+</mo><mrow><msup><mrow><mo stretchy="false">(</mo><mrow><msub><mi>v</mi><mn>22</mn></msub><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>θ</mi><mn>0</mn><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>𝚺</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>θ</mi><mn>0</mn></msub></mrow><mo>+</mo><msup><mi>σ</mi><mn>2</mn></msup></mrow></mrow><annotation encoding="application/x-tex">\displaystyle={\mathbf{v}}_{21}^{\top}{\mathbf{\Sigma}}{\mathbf{v}}_{21}+2\big(v_{22}-1\big){\mathbf{v}}_{21}^{\top}{\mathbf{\Sigma}}{\mathbf{\theta}}_{0}+(v_{22}-1)^{2}{\mathbf{\theta}}_{0}^{\top}{\mathbf{\Sigma}}{\mathbf{\theta}}_{0}+\sigma^{2}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(204)</span></td></tr></tbody>
<tbody id="A1.E205"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.E205.m1" class="ltx_Math" alttext="\displaystyle=\big({\mathbf{v}}_{21}+(v_{22}-1){\mathbf{\theta}}_{0}\big)^{\top}{\mathbf{\Sigma}}\big({\mathbf{v}}_{21}+(v_{22}-1){\mathbf{\theta}}_{0}\big)+\sigma^{2}." display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><msup><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mrow><msub><mi>𝐯</mi><mn>21</mn></msub><mo>+</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><msub><mi>v</mi><mn>22</mn></msub><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>θ</mi><mn>0</mn></msub></mrow></mrow><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>𝚺</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mrow><msub><mi>𝐯</mi><mn>21</mn></msub><mo>+</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><msub><mi>v</mi><mn>22</mn></msub><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>θ</mi><mn>0</mn></msub></mrow></mrow><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow></mrow><mo>+</mo><msup><mi>σ</mi><mn>2</mn></msup></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle=\big({\mathbf{v}}_{21}+(v_{22}-1){\mathbf{\theta}}_{0}\big)^{\top}{\mathbf{\Sigma}}\big({\mathbf{v}}_{21}+(v_{22}-1){\mathbf{\theta}}_{0}\big)+\sigma^{2}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(205)</span></td></tr></tbody>
</table>
</div>
<div id="A1.SS2.p14" class="ltx_para">
<p id="A1.SS2.p14.1" class="ltx_p"><span id="A1.SS2.p14.1.1" class="ltx_text">∎</span></p>
</div>
</div>
<div class="ltx_pagination ltx_role_newpage"></div>
</section>
<section id="A1.SS3" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">A.3 </span>Proofs for Optimal Parameters</h3>

<div id="A1.Thmtheorem7" class="ltx_theorem ltx_theorem_corollary">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="A1.Thmtheorem7.2" class="ltx_text ltx_font_bold">Corollary A.7</span></span><span id="A1.Thmtheorem7.3" class="ltx_text ltx_font_bold"> </span>(Optimal Parameters of Pretrained Models; Corollary of Theorem 1 in <cite class="ltx_cite ltx_citemacro_citet"><a href="#bib.bib4" title="" class="ltx_ref">Ahn et al. (2023)</a></cite>)<span id="A1.Thmtheorem7.4" class="ltx_text ltx_font_bold">.</span></h6>
<div id="A1.Thmtheorem7.p1" class="ltx_para">
<p id="A1.Thmtheorem7.p1.1" class="ltx_p"><span id="A1.Thmtheorem7.p1.1.1" class="ltx_text ltx_font_italic">Suppose that <math id="A1.Thmtheorem7.p1.m1" class="ltx_Math" alttext="{\mathbf{V}}" display="inline" intent=":literal"><semantics><mi>𝐕</mi><annotation encoding="application/x-tex">{\mathbf{V}}</annotation></semantics></math> and <math id="A1.Thmtheorem7.p1.m2" class="ltx_Math" alttext="{\mathbf{Q}}" display="inline" intent=":literal"><semantics><mi>𝐐</mi><annotation encoding="application/x-tex">{\mathbf{Q}}</annotation></semantics></math> in (<a href="#S3.E2" title="Equation 2 ‣ Transformer Architecture. ‣ 3 Problem Setup ‣ Fine-Tuning Without Forgetting In-Context Learning:A Theoretical Analysis of Linear Attention Models" class="ltx_ref"><span class="ltx_text ltx_ref_tag">2</span></a>) satisfy <math id="A1.Thmtheorem7.p1.m3" class="ltx_Math" alttext="q\geq 0" display="inline" intent=":literal"><semantics><mrow><mi>q</mi><mo>≥</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">q\geq 0</annotation></semantics></math> and that <math id="A1.Thmtheorem7.p1.m4" class="ltx_Math" alttext="{\mathbf{Q}}_{11}" display="inline" intent=":literal"><semantics><msub><mi>𝐐</mi><mn>11</mn></msub><annotation encoding="application/x-tex">{\mathbf{Q}}_{11}</annotation></semantics></math> is positive definite.
Consider the loss <math id="A1.Thmtheorem7.p1.m5" class="ltx_Math" alttext="\mathcal{L}({\mathbf{V}},{\mathbf{Q}})" display="inline" intent=":literal"><semantics><mrow><mi class="ltx_font_mathcaligraphic">ℒ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝐕</mi><mo>,</mo><mi>𝐐</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathcal{L}({\mathbf{V}},{\mathbf{Q}})</annotation></semantics></math> in (<a href="#S3.E8" title="Equation 8 ‣ Evaluation Metric and Training Objective. ‣ 3 Problem Setup ‣ Fine-Tuning Without Forgetting In-Context Learning:A Theoretical Analysis of Linear Attention Models" class="ltx_ref"><span class="ltx_text ltx_ref_tag">8</span></a>) with context length <math id="A1.Thmtheorem7.p1.m6" class="ltx_Math" alttext="m\in{\mathbb{N}}" display="inline" intent=":literal"><semantics><mrow><mi>m</mi><mo>∈</mo><mi>ℕ</mi></mrow><annotation encoding="application/x-tex">m\in{\mathbb{N}}</annotation></semantics></math>.
Then, for sufficiently large <math id="A1.Thmtheorem7.p1.m7" class="ltx_Math" alttext="m" display="inline" intent=":literal"><semantics><mi>m</mi><annotation encoding="application/x-tex">m</annotation></semantics></math>, the following parameters globally minimize the loss:</span></p>
<table id="A1.E206" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A1.E206.m1" class="ltx_Math" alttext="{\mathbf{V}}=\begin{bmatrix}0&{\mathbf{0}}_{d}^{\top}&amp;0\\
{\mathbf{0}}_{d}&{\mathbf{0}}_{d}{\mathbf{0}}_{d}^{\top}&{\mathbf{0}}_{d}\\
0&{\mathbf{0}}_{d}^{\top}&amp;\frac{m}{m+1+d}\end{bmatrix},\qquad{\mathbf{Q}}=\begin{bmatrix}0&{\mathbf{0}}_{d}^{\top}&amp;0\\
{\mathbf{0}}_{d}&{\mathbf{U}}\cdot\diag\!\left(\frac{m+1+d}{(m+1)\lambda_{i}+\tr({\mathbf{\Sigma}})}\right)_{\!i\in[d]}\cdot{\mathbf{U}}^{\top}&{\mathbf{0}}_{d}\\
0&{\mathbf{0}}_{d}^{\top}&amp;0\end{bmatrix}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mi>𝐕</mi><mo>=</mo><mrow><mo>[</mo><mtable columnspacing="5pt" displaystyle="true" rowspacing="0pt"><mtr><mtd><mn>0</mn></mtd><mtd><msubsup><mn>𝟎</mn><mi>d</mi><mo>⊤</mo></msubsup></mtd><mtd><mn>0</mn></mtd></mtr><mtr><mtd><msub><mn>𝟎</mn><mi>d</mi></msub></mtd><mtd><mrow><msub><mn>𝟎</mn><mi>d</mi></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mn>𝟎</mn><mi>d</mi><mo>⊤</mo></msubsup></mrow></mtd><mtd><msub><mn>𝟎</mn><mi>d</mi></msub></mtd></mtr><mtr><mtd><mn>0</mn></mtd><mtd><msubsup><mn>𝟎</mn><mi>d</mi><mo>⊤</mo></msubsup></mtd><mtd><mstyle displaystyle="false"><mfrac><mi>m</mi><mrow><mi>m</mi><mo>+</mo><mn>1</mn><mo>+</mo><mi>d</mi></mrow></mfrac></mstyle></mtd></mtr></mtable><mo>]</mo></mrow></mrow><mo rspace="2.167em">,</mo><mrow><mi>𝐐</mi><mo>=</mo><mrow><mo>[</mo><mtable columnspacing="5pt" displaystyle="true" rowspacing="0pt"><mtr><mtd><mn>0</mn></mtd><mtd><msubsup><mn>𝟎</mn><mi>d</mi><mo>⊤</mo></msubsup></mtd><mtd><mn>0</mn></mtd></mtr><mtr><mtd><msub><mn>𝟎</mn><mi>d</mi></msub></mtd><mtd><mrow><mi>𝐔</mi><mo lspace="0.222em" rspace="0.222em">⋅</mo><mrow><mpadded style="width:1.736em;" width="1.736em"><mi>diag</mi></mpadded><mo>⁡</mo><msub><mrow><mo>(</mo><mstyle displaystyle="false"><mfrac><mrow><mi>m</mi><mo>+</mo><mn>1</mn><mo>+</mo><mi>d</mi></mrow><mrow><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>m</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>λ</mi><mi>i</mi></msub></mrow><mo>+</mo><mrow><mi>tr</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝚺</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mfrac></mstyle><mo rspace="0.055em">)</mo></mrow><mrow><mi>i</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mi>d</mi><mo stretchy="false">]</mo></mrow></mrow></msub></mrow><mo rspace="0.222em">⋅</mo><msup><mi>𝐔</mi><mo>⊤</mo></msup></mrow></mtd><mtd><msub><mn>𝟎</mn><mi>d</mi></msub></mtd></mtr><mtr><mtd><mn>0</mn></mtd><mtd><msubsup><mn>𝟎</mn><mi>d</mi><mo>⊤</mo></msubsup></mtd><mtd><mn>0</mn></mtd></mtr></mtable><mo>]</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">{\mathbf{V}}=\begin{bmatrix}0&amp;{\mathbf{0}}_{d}^{\top}&amp;0\\
{\mathbf{0}}_{d}&amp;{\mathbf{0}}_{d}{\mathbf{0}}_{d}^{\top}&amp;{\mathbf{0}}_{d}\\
0&amp;{\mathbf{0}}_{d}^{\top}&amp;\frac{m}{m+1+d}\end{bmatrix},\qquad{\mathbf{Q}}=\begin{bmatrix}0&amp;{\mathbf{0}}_{d}^{\top}&amp;0\\
{\mathbf{0}}_{d}&amp;{\mathbf{U}}\cdot\diag\!\left(\frac{m+1+d}{(m+1)\lambda_{i}+\tr({\mathbf{\Sigma}})}\right)_{\!i\in[d]}\cdot{\mathbf{U}}^{\top}&amp;{\mathbf{0}}_{d}\\
0&amp;{\mathbf{0}}_{d}^{\top}&amp;0\end{bmatrix}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(206)</span></td></tr></tbody>
</table>
<p id="A1.Thmtheorem7.p1.2" class="ltx_p"><span id="A1.Thmtheorem7.p1.2.1" class="ltx_text ltx_font_italic">Moreover, <math id="A1.Thmtheorem7.p1.m8" class="ltx_Math" alttext="{\mathbf{U}}\diag\Big(\tfrac{m+1+d}{(m+1)\lambda_{i}+\tr({\mathbf{\Sigma}})}\Big)_{i\in[d]}{\mathbf{U}}^{\top}\to{\mathbf{\Sigma}}^{-1}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>𝐔</mi><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>diag</mi><mo>⁡</mo><msub><mrow><mo maxsize="1.600em" minsize="1.600em">(</mo><mfrac><mrow><mi>m</mi><mo>+</mo><mn>1</mn><mo>+</mo><mi>d</mi></mrow><mrow><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>m</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>λ</mi><mi>i</mi></msub></mrow><mo>+</mo><mrow><mi>tr</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝚺</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mfrac><mo maxsize="1.600em" minsize="1.600em">)</mo></mrow><mrow><mi>i</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mi>d</mi><mo stretchy="false">]</mo></mrow></mrow></msub></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝐔</mi><mo>⊤</mo></msup></mrow><mo stretchy="false">→</mo><msup><mi>𝚺</mi><mrow><mo>−</mo><mn>1</mn></mrow></msup></mrow><annotation encoding="application/x-tex">{\mathbf{U}}\diag\Big(\tfrac{m+1+d}{(m+1)\lambda_{i}+\tr({\mathbf{\Sigma}})}\Big)_{i\in[d]}{\mathbf{U}}^{\top}\to{\mathbf{\Sigma}}^{-1}</annotation></semantics></math> as <math id="A1.Thmtheorem7.p1.m9" class="ltx_Math" alttext="m\to\infty" display="inline" intent=":literal"><semantics><mrow><mi>m</mi><mo stretchy="false">→</mo><mi mathvariant="normal">∞</mi></mrow><annotation encoding="application/x-tex">m\to\infty</annotation></semantics></math>.</span></p>
</div>
</div>
<div id="A1.SS3.2" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="A1.SS3.p1" class="ltx_para">
<p id="A1.SS3.p1.1" class="ltx_p"><span id="A1.SS3.p1.1.1" class="ltx_text">By the definition of the linear attention model in (<a href="#S3.E2" title="Equation 2 ‣ Transformer Architecture. ‣ 3 Problem Setup ‣ Fine-Tuning Without Forgetting In-Context Learning:A Theoretical Analysis of Linear Attention Models" class="ltx_ref"><span class="ltx_text ltx_ref_tag">2</span></a>), for any input <math id="A1.SS3.p1.m1" class="ltx_Math" alttext="{\mathbf{Z}}" display="inline" intent=":literal"><semantics><mi>𝐙</mi><annotation encoding="application/x-tex">{\mathbf{Z}}</annotation></semantics></math>, the prediction <math id="A1.SS3.p1.m2" class="ltx_Math" alttext="f({\mathbf{Z}};{\mathbf{V}},{\mathbf{Q}})" display="inline" intent=":literal"><semantics><mrow><mi>f</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝐙</mi><mo>,</mo><mi>𝐕</mi><mo>,</mo><mi>𝐐</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">f({\mathbf{Z}};{\mathbf{V}},{\mathbf{Q}})</annotation></semantics></math> produced by the parameters in (<a href="#A1.E206" title="Equation 206 ‣ Corollary A.7 (Optimal Parameters of Pretrained Models; Corollary of Theorem 1 in ( ) ). ‣ A.3 Proofs for Optimal Parameters ‣ Appendix A Proofs ‣ Fine-Tuning Without Forgetting In-Context Learning:A Theoretical Analysis of Linear Attention Models" class="ltx_ref"><span class="ltx_text ltx_ref_tag">206</span></a>) is identical to that produced by the rescaled parameter pair</span></p>
<table id="A1.E207" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A1.E207.m1" class="ltx_Math" alttext="{\mathbf{V}}=\begin{bmatrix}0&{\mathbf{0}}_{d}^{\top}&amp;0\\
{\mathbf{0}}_{d}&{\mathbf{0}}_{d}{\mathbf{0}}_{d}^{\top}&{\mathbf{0}}_{d}\\
0&{\mathbf{0}}_{d}^{\top}&amp;1\end{bmatrix},\qquad{\mathbf{Q}}=\begin{bmatrix}0&{\mathbf{0}}_{d}^{\top}&amp;0\\
{\mathbf{0}}_{d}&{\mathbf{U}}\cdot\diag\left(\frac{m}{(m+1)\lambda_{i}+\tr({\mathbf{\Sigma}})}\right)_{i\in[d]}\cdot{\mathbf{U}}^{\top}&{\mathbf{0}}_{d}\\
0&{\mathbf{0}}_{d}^{\top}&amp;0\end{bmatrix}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mi>𝐕</mi><mo>=</mo><mrow><mo>[</mo><mtable columnspacing="5pt" displaystyle="true" rowspacing="0pt"><mtr><mtd><mn>0</mn></mtd><mtd><msubsup><mn>𝟎</mn><mi>d</mi><mo>⊤</mo></msubsup></mtd><mtd><mn>0</mn></mtd></mtr><mtr><mtd><msub><mn>𝟎</mn><mi>d</mi></msub></mtd><mtd><mrow><msub><mn>𝟎</mn><mi>d</mi></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mn>𝟎</mn><mi>d</mi><mo>⊤</mo></msubsup></mrow></mtd><mtd><msub><mn>𝟎</mn><mi>d</mi></msub></mtd></mtr><mtr><mtd><mn>0</mn></mtd><mtd><msubsup><mn>𝟎</mn><mi>d</mi><mo>⊤</mo></msubsup></mtd><mtd><mn>1</mn></mtd></mtr></mtable><mo>]</mo></mrow></mrow><mo rspace="2.167em">,</mo><mrow><mi>𝐐</mi><mo>=</mo><mrow><mo>[</mo><mtable columnspacing="5pt" displaystyle="true" rowspacing="0pt"><mtr><mtd><mn>0</mn></mtd><mtd><msubsup><mn>𝟎</mn><mi>d</mi><mo>⊤</mo></msubsup></mtd><mtd><mn>0</mn></mtd></mtr><mtr><mtd><msub><mn>𝟎</mn><mi>d</mi></msub></mtd><mtd><mrow><mi>𝐔</mi><mo lspace="0.222em" rspace="0.222em">⋅</mo><mrow><mi>diag</mi><mo>⁡</mo><msub><mrow><mo>(</mo><mstyle displaystyle="false"><mfrac><mi>m</mi><mrow><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>m</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>λ</mi><mi>i</mi></msub></mrow><mo>+</mo><mrow><mi>tr</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝚺</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mfrac></mstyle><mo rspace="0.055em">)</mo></mrow><mrow><mi>i</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mi>d</mi><mo stretchy="false">]</mo></mrow></mrow></msub></mrow><mo rspace="0.222em">⋅</mo><msup><mi>𝐔</mi><mo>⊤</mo></msup></mrow></mtd><mtd><msub><mn>𝟎</mn><mi>d</mi></msub></mtd></mtr><mtr><mtd><mn>0</mn></mtd><mtd><msubsup><mn>𝟎</mn><mi>d</mi><mo>⊤</mo></msubsup></mtd><mtd><mn>0</mn></mtd></mtr></mtable><mo>]</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">{\mathbf{V}}=\begin{bmatrix}0&amp;{\mathbf{0}}_{d}^{\top}&amp;0\\
{\mathbf{0}}_{d}&amp;{\mathbf{0}}_{d}{\mathbf{0}}_{d}^{\top}&amp;{\mathbf{0}}_{d}\\
0&amp;{\mathbf{0}}_{d}^{\top}&amp;1\end{bmatrix},\qquad{\mathbf{Q}}=\begin{bmatrix}0&amp;{\mathbf{0}}_{d}^{\top}&amp;0\\
{\mathbf{0}}_{d}&amp;{\mathbf{U}}\cdot\diag\left(\frac{m}{(m+1)\lambda_{i}+\tr({\mathbf{\Sigma}})}\right)_{i\in[d]}\cdot{\mathbf{U}}^{\top}&amp;{\mathbf{0}}_{d}\\
0&amp;{\mathbf{0}}_{d}^{\top}&amp;0\end{bmatrix}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(207)</span></td></tr></tbody>
</table>
<p id="A1.SS3.p1.2" class="ltx_p"><span id="A1.SS3.p1.2.1" class="ltx_text">It therefore suffices to show that this rescaled pair is a global minimizer of the loss.</span></p>
</div>
<div id="A1.SS3.p2" class="ltx_para">
<p id="A1.SS3.p2.1" class="ltx_p"><span id="A1.SS3.p2.1.1" class="ltx_text">From Lemma <a href="#A1.Thmtheorem5" title="Lemma A.5. ‣ A.2 Proofs of Statistical Properties of Model Outputs ‣ Appendix A Proofs ‣ Fine-Tuning Without Forgetting In-Context Learning:A Theoretical Analysis of Linear Attention Models" class="ltx_ref"><span class="ltx_text ltx_ref_tag">A.5</span></a>, we derived errors for a fixed <math id="A1.SS3.p2.m1" class="ltx_Math" alttext="{\mathbf{\theta}}_{0}" display="inline" intent=":literal"><semantics><msub><mi>θ</mi><mn>0</mn></msub><annotation encoding="application/x-tex">{\mathbf{\theta}}_{0}</annotation></semantics></math>. In the pretrained setting, <math id="A1.SS3.p2.m2" class="ltx_Math" alttext="{\mathbf{\theta}}" display="inline" intent=":literal"><semantics><mi>θ</mi><annotation encoding="application/x-tex">{\mathbf{\theta}}</annotation></semantics></math> is drawn from <math id="A1.SS3.p2.m3" class="ltx_Math" alttext="\mathcal{N}({\mathbf{0}}_{d},{\mathbf{I}}_{d})" display="inline" intent=":literal"><semantics><mrow><mi class="ltx_font_mathcaligraphic">𝒩</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mn>𝟎</mn><mi>d</mi></msub><mo>,</mo><msub><mi>𝐈</mi><mi>d</mi></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathcal{N}({\mathbf{0}}_{d},{\mathbf{I}}_{d})</annotation></semantics></math>. We compute the squared error for random <math id="A1.SS3.p2.m4" class="ltx_Math" alttext="{\mathbf{\theta}}" display="inline" intent=":literal"><semantics><mi>θ</mi><annotation encoding="application/x-tex">{\mathbf{\theta}}</annotation></semantics></math> by applying the law of total expectation. From (<a href="#A1.E127" title="Equation 127 ‣ Lemma A.5. ‣ A.2 Proofs of Statistical Properties of Model Outputs ‣ Appendix A Proofs ‣ Fine-Tuning Without Forgetting In-Context Learning:A Theoretical Analysis of Linear Attention Models" class="ltx_ref"><span class="ltx_text ltx_ref_tag">127</span></a>) in Lemma <a href="#A1.Thmtheorem5" title="Lemma A.5. ‣ A.2 Proofs of Statistical Properties of Model Outputs ‣ Appendix A Proofs ‣ Fine-Tuning Without Forgetting In-Context Learning:A Theoretical Analysis of Linear Attention Models" class="ltx_ref"><span class="ltx_text ltx_ref_tag">A.5</span></a>,</span></p>
<table id="A1.EGx56" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A1.E208"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A1.E208.m1" class="ltx_Math" alttext="\displaystyle\mathcal{L}({\mathbf{V}},{\mathbf{Q}})" display="inline" intent=":literal"><semantics><mrow><mi class="ltx_font_mathcaligraphic">ℒ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝐕</mi><mo>,</mo><mi>𝐐</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\mathcal{L}({\mathbf{V}},{\mathbf{Q}})</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.E208.m2" class="ltx_Math" alttext="\displaystyle=\displaystyle\mathbb{E}_{\mathbf{\theta}}\left[\displaystyle\mathbb{E}_{{\mathbf{Z}}_{[m]},{\mathbf{x}},y|{\mathbf{\theta}}}\left[\left(\hat{y}_{\mathrm{FS}}({\mathbf{Z}}_{[m]},{\mathbf{x}};{\mathbf{V}},{\mathbf{Q}})-y\right)^{2}\right]\right]" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><msub><mi>𝔼</mi><mi>θ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><mrow><msub><mi>𝔼</mi><mrow><msub><mi>𝐙</mi><mrow><mo stretchy="false">[</mo><mi>m</mi><mo stretchy="false">]</mo></mrow></msub><mo>,</mo><mi>𝐱</mi><mo>,</mo><mrow><mi>y</mi><mo fence="false">|</mo><mi>θ</mi></mrow></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><msup><mrow><mo>(</mo><mrow><mrow><msub><mover accent="true"><mi>y</mi><mo>^</mo></mover><mi>FS</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐙</mi><mrow><mo stretchy="false">[</mo><mi>m</mi><mo stretchy="false">]</mo></mrow></msub><mo>,</mo><mi>𝐱</mi><mo>,</mo><mi>𝐕</mi><mo>,</mo><mi>𝐐</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mi>y</mi></mrow><mo>)</mo></mrow><mn>2</mn></msup><mo>]</mo></mrow></mrow><mo>]</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\displaystyle\mathbb{E}_{\mathbf{\theta}}\left[\displaystyle\mathbb{E}_{{\mathbf{Z}}_{[m]},{\mathbf{x}},y|{\mathbf{\theta}}}\left[\left(\hat{y}_{\mathrm{FS}}({\mathbf{Z}}_{[m]},{\mathbf{x}};{\mathbf{V}},{\mathbf{Q}})-y\right)^{2}\right]\right]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(208)</span></td></tr></tbody>
<tbody id="A1.E209"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.E209.m1" class="ltx_math_unparsed" alttext="\displaystyle=\frac{1}{(m+1)^{2}}\displaystyle\mathbb{E}_{\mathbf{\theta}}\Big[c({\mathbf{\theta}};{\mathbf{V}},{\mathbf{Q}},{\mathbf{\Sigma}},\sigma^{2})+q^{2}\cdot{\mathbf{v}}_{21}^{\top}{\mathbf{\Sigma}}{\mathbf{v}}_{21}+2q\cdot\tr({\mathbf{Q}}_{11}{\mathbf{\Sigma}})\cdot{\mathbf{v}}_{21}^{\top}{\mathbf{\Sigma}}{\mathbf{v}}_{21}+4q\cdot{\mathbf{v}}_{21}^{\top}{\mathbf{\Sigma}}{\mathbf{Q}}_{11}{\mathbf{\Sigma}}{\mathbf{v}}_{21}" display="inline" intent=":literal"><semantics><mrow><mo>=</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><msup><mrow><mo stretchy="false">(</mo><mrow><mi>m</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mfrac></mstyle><msub><mi>𝔼</mi><mi>θ</mi></msub><mrow><mo maxsize="1.600em" minsize="1.600em">[</mo><mi>c</mi><mrow><mo stretchy="false">(</mo><mi>θ</mi><mo>;</mo><mi>𝐕</mi><mo>,</mo><mi>𝐐</mi><mo>,</mo><mi>𝚺</mi><mo>,</mo><msup><mi>σ</mi><mn>2</mn></msup><mo stretchy="false">)</mo></mrow><mo>+</mo><msup><mi>q</mi><mn>2</mn></msup><mo lspace="0.222em" rspace="0.222em">⋅</mo><msubsup><mi>𝐯</mi><mn>21</mn><mo>⊤</mo></msubsup><mi>𝚺</mi><msub><mi>𝐯</mi><mn>21</mn></msub><mo>+</mo><mn>2</mn><mi>q</mi><mo lspace="0.222em" rspace="0.222em">⋅</mo><mi>tr</mi><mrow><mo stretchy="false">(</mo><msub><mi>𝐐</mi><mn>11</mn></msub><mi>𝚺</mi><mo rspace="0.055em" stretchy="false">)</mo></mrow><mo rspace="0.222em">⋅</mo><msubsup><mi>𝐯</mi><mn>21</mn><mo>⊤</mo></msubsup><mi>𝚺</mi><msub><mi>𝐯</mi><mn>21</mn></msub><mo>+</mo><mn>4</mn><mi>q</mi><mo lspace="0.222em" rspace="0.222em">⋅</mo><msubsup><mi>𝐯</mi><mn>21</mn><mo>⊤</mo></msubsup><mi>𝚺</mi><msub><mi>𝐐</mi><mn>11</mn></msub><mi>𝚺</mi><msub><mi>𝐯</mi><mn>21</mn></msub></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\frac{1}{(m+1)^{2}}\displaystyle\mathbb{E}_{\mathbf{\theta}}\Big[c({\mathbf{\theta}};{\mathbf{V}},{\mathbf{Q}},{\mathbf{\Sigma}},\sigma^{2})+q^{2}\cdot{\mathbf{v}}_{21}^{\top}{\mathbf{\Sigma}}{\mathbf{v}}_{21}+2q\cdot\tr({\mathbf{Q}}_{11}{\mathbf{\Sigma}})\cdot{\mathbf{v}}_{21}^{\top}{\mathbf{\Sigma}}{\mathbf{v}}_{21}+4q\cdot{\mathbf{v}}_{21}^{\top}{\mathbf{\Sigma}}{\mathbf{Q}}_{11}{\mathbf{\Sigma}}{\mathbf{v}}_{21}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(209)</span></td></tr></tbody>
<tbody id="A1.E210"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.E210.m1" class="ltx_math_unparsed" alttext="\displaystyle\qquad\qquad\qquad\quad+mq^{2}\cdot\left(({\mathbf{v}}_{21}^{\top}+{\mathbf{\theta}}^{\top}){\mathbf{\Sigma}}({\mathbf{v}}_{21}+{\mathbf{\theta}})+\sigma^{2}\right)+2mq\cdot\left({\mathbf{v}}_{21}^{\top}{\mathbf{\Sigma}}{\mathbf{Q}}_{11}+{\mathbf{\theta}}^{\top}{\mathbf{\Sigma}}{\mathbf{Q}}_{11}-{\mathbf{\theta}}^{\top}\right){\mathbf{\Sigma}}{\mathbf{v}}_{21}\Big]," display="inline" intent=":literal"><semantics><mrow><mo>+</mo><mi>m</mi><msup><mi>q</mi><mn>2</mn></msup><mo lspace="0.222em" rspace="0.222em">⋅</mo><mrow><mo>(</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>𝐯</mi><mn>21</mn><mo>⊤</mo></msubsup><mo>+</mo><msup><mi>θ</mi><mo>⊤</mo></msup><mo stretchy="false">)</mo></mrow><mi>𝚺</mi><mrow><mo stretchy="false">(</mo><msub><mi>𝐯</mi><mn>21</mn></msub><mo>+</mo><mi>θ</mi><mo stretchy="false">)</mo></mrow><mo>+</mo><msup><mi>σ</mi><mn>2</mn></msup><mo>)</mo></mrow><mo>+</mo><mn>2</mn><mi>m</mi><mi>q</mi><mo lspace="0.222em" rspace="0.222em">⋅</mo><mrow><mo>(</mo><msubsup><mi>𝐯</mi><mn>21</mn><mo>⊤</mo></msubsup><mi>𝚺</mi><msub><mi>𝐐</mi><mn>11</mn></msub><mo>+</mo><msup><mi>θ</mi><mo>⊤</mo></msup><mi>𝚺</mi><msub><mi>𝐐</mi><mn>11</mn></msub><mo>−</mo><msup><mi>θ</mi><mo>⊤</mo></msup><mo>)</mo></mrow><mi>𝚺</mi><msub><mi>𝐯</mi><mn>21</mn></msub><mo maxsize="1.600em" minsize="1.600em">]</mo><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\qquad\qquad\qquad\quad+mq^{2}\cdot\left(({\mathbf{v}}_{21}^{\top}+{\mathbf{\theta}}^{\top}){\mathbf{\Sigma}}({\mathbf{v}}_{21}+{\mathbf{\theta}})+\sigma^{2}\right)+2mq\cdot\left({\mathbf{v}}_{21}^{\top}{\mathbf{\Sigma}}{\mathbf{Q}}_{11}+{\mathbf{\theta}}^{\top}{\mathbf{\Sigma}}{\mathbf{Q}}_{11}-{\mathbf{\theta}}^{\top}\right){\mathbf{\Sigma}}{\mathbf{v}}_{21}\Big],</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(210)</span></td></tr></tbody>
</table>
<p id="A1.SS3.p2.2" class="ltx_p"><span id="A1.SS3.p2.2.1" class="ltx_text">where <math id="A1.SS3.p2.m5" class="ltx_Math" alttext="c({\mathbf{\theta}};{\mathbf{V}},{\mathbf{Q}},{\mathbf{\Sigma}},\sigma^{2})" display="inline" intent=":literal"><semantics><mrow><mi>c</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>θ</mi><mo>,</mo><mi>𝐕</mi><mo>,</mo><mi>𝐐</mi><mo>,</mo><mi>𝚺</mi><mo>,</mo><msup><mi>σ</mi><mn>2</mn></msup><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">c({\mathbf{\theta}};{\mathbf{V}},{\mathbf{Q}},{\mathbf{\Sigma}},\sigma^{2})</annotation></semantics></math> collects all terms independent of the parameter <math id="A1.SS3.p2.m6" class="ltx_Math" alttext="q" display="inline" intent=":literal"><semantics><mi>q</mi><annotation encoding="application/x-tex">q</annotation></semantics></math>. Then,</span></p>
<table id="A1.EGx57" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A1.E211"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A1.E211.m1" class="ltx_Math" alttext="\displaystyle\mathcal{L}({\mathbf{V}},{\mathbf{Q}})=\frac{1}{(m+1)^{2}}\displaystyle\mathbb{E}_{\mathbf{\theta}}\Big[c({\mathbf{\theta}};{\mathbf{V}},{\mathbf{Q}},{\mathbf{\Sigma}},\sigma^{2})\Big]" display="inline" intent=":literal"><semantics><mrow><mrow><mi class="ltx_font_mathcaligraphic">ℒ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝐕</mi><mo>,</mo><mi>𝐐</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><msup><mrow><mo stretchy="false">(</mo><mrow><mi>m</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝔼</mi><mi>θ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="1.600em" minsize="1.600em">[</mo><mrow><mi>c</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>θ</mi><mo>,</mo><mi>𝐕</mi><mo>,</mo><mi>𝐐</mi><mo>,</mo><mi>𝚺</mi><mo>,</mo><msup><mi>σ</mi><mn>2</mn></msup><mo stretchy="false">)</mo></mrow></mrow><mo maxsize="1.600em" minsize="1.600em">]</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\mathcal{L}({\mathbf{V}},{\mathbf{Q}})=\frac{1}{(m+1)^{2}}\displaystyle\mathbb{E}_{\mathbf{\theta}}\Big[c({\mathbf{\theta}};{\mathbf{V}},{\mathbf{Q}},{\mathbf{\Sigma}},\sigma^{2})\Big]</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.E211.m2" class="ltx_Math" alttext="\displaystyle+\frac{q}{(m+1)^{2}}\Big((m+1)q\cdot{\mathbf{v}}_{21}^{\top}{\mathbf{\Sigma}}{\mathbf{v}}_{21}+2\cdot\tr({\mathbf{Q}}_{11}{\mathbf{\Sigma}})\cdot{\mathbf{v}}_{21}^{\top}{\mathbf{\Sigma}}{\mathbf{v}}_{21}" display="inline" intent=":literal"><semantics><mrow><mo>+</mo><mrow><mstyle displaystyle="true"><mfrac><mi>q</mi><msup><mrow><mo stretchy="false">(</mo><mrow><mi>m</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="1.600em" minsize="1.600em">(</mo><mrow><mrow><mrow><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>m</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow><mo lspace="0.222em" rspace="0.222em">⋅</mo><msubsup><mi>𝐯</mi><mn>21</mn><mo>⊤</mo></msubsup></mrow><mo lspace="0em" rspace="0em">​</mo><mi>𝚺</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝐯</mi><mn>21</mn></msub></mrow><mo>+</mo><mrow><mn>2</mn><mo lspace="0.222em" rspace="0.222em">⋅</mo><mrow><mi>tr</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>𝐐</mi><mn>11</mn></msub><mo lspace="0em" rspace="0em">​</mo><mi>𝚺</mi></mrow><mo rspace="0.055em" stretchy="false">)</mo></mrow></mrow><mo rspace="0.222em">⋅</mo><mrow><msubsup><mi>𝐯</mi><mn>21</mn><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>𝚺</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝐯</mi><mn>21</mn></msub></mrow></mrow></mrow><mo fence="true" lspace="0em">CLOSE</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle+\frac{q}{(m+1)^{2}}\Big((m+1)q\cdot{\mathbf{v}}_{21}^{\top}{\mathbf{\Sigma}}{\mathbf{v}}_{21}+2\cdot\tr({\mathbf{Q}}_{11}{\mathbf{\Sigma}})\cdot{\mathbf{v}}_{21}^{\top}{\mathbf{\Sigma}}{\mathbf{v}}_{21}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(211)</span></td></tr></tbody>
<tbody id="A1.E212"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.E212.m1" class="ltx_math_unparsed" alttext="\displaystyle\qquad\qquad\qquad\quad+mq\cdot\tr({\mathbf{\Sigma}})+mq\cdot\sigma^{2}+2(m+2)\cdot{\mathbf{v}}_{21}^{\top}{\mathbf{\Sigma}}{\mathbf{Q}}_{11}{\mathbf{\Sigma}}{\mathbf{v}}_{21}\Big)." display="inline" intent=":literal"><semantics><mrow><mo>+</mo><mi>m</mi><mi>q</mi><mo lspace="0.222em" rspace="0.222em">⋅</mo><mi>tr</mi><mrow><mo stretchy="false">(</mo><mi>𝚺</mi><mo stretchy="false">)</mo></mrow><mo>+</mo><mi>m</mi><mi>q</mi><mo lspace="0.222em" rspace="0.222em">⋅</mo><msup><mi>σ</mi><mn>2</mn></msup><mo>+</mo><mn>2</mn><mrow><mo stretchy="false">(</mo><mi>m</mi><mo>+</mo><mn>2</mn><mo rspace="0.055em" stretchy="false">)</mo></mrow><mo rspace="0.222em">⋅</mo><msubsup><mi>𝐯</mi><mn>21</mn><mo>⊤</mo></msubsup><mi>𝚺</mi><msub><mi>𝐐</mi><mn>11</mn></msub><mi>𝚺</mi><msub><mi>𝐯</mi><mn>21</mn></msub><mo maxsize="1.600em" minsize="1.600em">)</mo><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\qquad\qquad\qquad\quad+mq\cdot\tr({\mathbf{\Sigma}})+mq\cdot\sigma^{2}+2(m+2)\cdot{\mathbf{v}}_{21}^{\top}{\mathbf{\Sigma}}{\mathbf{Q}}_{11}{\mathbf{\Sigma}}{\mathbf{v}}_{21}\Big).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(212)</span></td></tr></tbody>
</table>
<p id="A1.SS3.p2.3" class="ltx_p"><span id="A1.SS3.p2.3.1" class="ltx_text">Since <math id="A1.SS3.p2.m7" class="ltx_Math" alttext="{\mathbf{\Sigma}}" display="inline" intent=":literal"><semantics><mi>𝚺</mi><annotation encoding="application/x-tex">{\mathbf{\Sigma}}</annotation></semantics></math> and <math id="A1.SS3.p2.m8" class="ltx_Math" alttext="{\mathbf{Q}}_{11}" display="inline" intent=":literal"><semantics><msub><mi>𝐐</mi><mn>11</mn></msub><annotation encoding="application/x-tex">{\mathbf{Q}}_{11}</annotation></semantics></math> are positive definite, the expression in the parentheses of the last term is nonnegative. Therefore, the loss is minimized by setting <math id="A1.SS3.p2.m9" class="ltx_Math" alttext="q=0" display="inline" intent=":literal"><semantics><mrow><mi>q</mi><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">q=0</annotation></semantics></math>.</span></p>
</div>
<div id="A1.SS3.p3" class="ltx_para">
<p id="A1.SS3.p3.1" class="ltx_p"><span id="A1.SS3.p3.1.1" class="ltx_text">When <math id="A1.SS3.p3.m1" class="ltx_Math" alttext="q=0" display="inline" intent=":literal"><semantics><mrow><mi>q</mi><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">q=0</annotation></semantics></math> and <math id="A1.SS3.p3.m2" class="ltx_Math" alttext="m" display="inline" intent=":literal"><semantics><mi>m</mi><annotation encoding="application/x-tex">m</annotation></semantics></math> is sufficiently large, the prediction reduces to that of Theorem 1 in <cite class="ltx_cite ltx_citemacro_citet"><a href="#bib.bib4" title="" class="ltx_ref">Ahn et al. (2023)</a></cite>, because</span></p>
<table id="A1.EGx58" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A1.E213"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A1.E213.m1" class="ltx_Math" alttext="\displaystyle\hat{y}_{\mathrm{FS}}({\mathbf{Z}}_{m},{\mathbf{x}};{\mathbf{V}},{\mathbf{Q}})" display="inline" intent=":literal"><semantics><mrow><msub><mover accent="true"><mi>y</mi><mo>^</mo></mover><mi>FS</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐙</mi><mi>m</mi></msub><mo>,</mo><mi>𝐱</mi><mo>,</mo><mi>𝐕</mi><mo>,</mo><mi>𝐐</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\hat{y}_{\mathrm{FS}}({\mathbf{Z}}_{m},{\mathbf{x}};{\mathbf{V}},{\mathbf{Q}})</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.E213.m2" class="ltx_Math" alttext="\displaystyle\approx\hat{y}_{\mathrm{Net\text{-}FS}}({\mathbf{Z}}_{m},{\mathbf{x}};{\mathbf{V}},{\mathbf{Q}})=\begin{bmatrix}{\mathbf{v}}_{21}\\
v_{22}\end{bmatrix}^{\top}\Big(\frac{1}{m}\sum_{i\in[m]}\begin{bmatrix}{\mathbf{x}}_{i}\\
y_{i}\end{bmatrix}\begin{bmatrix}{\mathbf{x}}_{i}\\
y_{i}\end{bmatrix}^{\top}\Big)\begin{bmatrix}{\mathbf{Q}}_{11}\\
{\mathbf{q}}_{21}^{\top}\end{bmatrix}{\mathbf{x}}_{n+1}." display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>≈</mo><mrow><msub><mover accent="true"><mi>y</mi><mo>^</mo></mover><mrow><mi>Net</mi><mo lspace="0em" rspace="0em">​</mo><mtext>-</mtext><mo lspace="0em" rspace="0em">​</mo><mi>FS</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐙</mi><mi>m</mi></msub><mo>,</mo><mi>𝐱</mi><mo>,</mo><mi>𝐕</mi><mo>,</mo><mi>𝐐</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><msup><mrow><mo>[</mo><mtable rowspacing="0pt"><mtr><mtd><msub><mi>𝐯</mi><mn>21</mn></msub></mtd></mtr><mtr><mtd><msub><mi>v</mi><mn>22</mn></msub></mtd></mtr></mtable><mo>]</mo></mrow><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="1.600em" minsize="1.600em">(</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>m</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mi>m</mi><mo stretchy="false">]</mo></mrow></mrow></munder></mstyle><mrow><mrow><mo>[</mo><mtable rowspacing="0pt"><mtr><mtd><msub><mi>𝐱</mi><mi>i</mi></msub></mtd></mtr><mtr><mtd><msub><mi>y</mi><mi>i</mi></msub></mtd></mtr></mtable><mo>]</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo>[</mo><mtable rowspacing="0pt"><mtr><mtd><msub><mi>𝐱</mi><mi>i</mi></msub></mtd></mtr><mtr><mtd><msub><mi>y</mi><mi>i</mi></msub></mtd></mtr></mtable><mo>]</mo></mrow><mo>⊤</mo></msup></mrow></mrow></mrow><mo maxsize="1.600em" minsize="1.600em">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><mtable rowspacing="0pt"><mtr><mtd><msub><mi>𝐐</mi><mn>11</mn></msub></mtd></mtr><mtr><mtd><msubsup><mi>𝐪</mi><mn>21</mn><mo>⊤</mo></msubsup></mtd></mtr></mtable><mo>]</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝐱</mi><mrow><mi>n</mi><mo>+</mo><mn>1</mn></mrow></msub></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\approx\hat{y}_{\mathrm{Net\text{-}FS}}({\mathbf{Z}}_{m},{\mathbf{x}};{\mathbf{V}},{\mathbf{Q}})=\begin{bmatrix}{\mathbf{v}}_{21}\\
v_{22}\end{bmatrix}^{\top}\Big(\frac{1}{m}\sum_{i\in[m]}\begin{bmatrix}{\mathbf{x}}_{i}\\
y_{i}\end{bmatrix}\begin{bmatrix}{\mathbf{x}}_{i}\\
y_{i}\end{bmatrix}^{\top}\Big)\begin{bmatrix}{\mathbf{Q}}_{11}\\
{\mathbf{q}}_{21}^{\top}\end{bmatrix}{\mathbf{x}}_{n+1}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(213)</span></td></tr></tbody>
</table>
<p id="A1.SS3.p3.2" class="ltx_p"><span id="A1.SS3.p3.2.1" class="ltx_text">By Theorem 1 in <cite class="ltx_cite ltx_citemacro_citet"><a href="#bib.bib4" title="" class="ltx_ref">Ahn et al. (2023)</a></cite>, the following parameters globally minimize the loss:</span></p>
<table id="A1.E214" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A1.E214.m1" class="ltx_Math" alttext="\begin{bmatrix}{\mathbf{V}}_{11}&{\mathbf{v}}_{12}\\
{\mathbf{v}}_{21}^{\top}&amp;v_{22}\end{bmatrix}=\begin{bmatrix}{\mathbf{0}}_{d\times d}&{\mathbf{0}}_{d}\\
{\mathbf{0}}_{d}^{\top}&amp;1\end{bmatrix},\quad\begin{bmatrix}{\mathbf{Q}}_{11}&{\mathbf{q}}_{12}\\
{\mathbf{q}}_{21}^{\top}&amp;q_{22}\end{bmatrix}=\begin{bmatrix}{\mathbf{U}}\cdot\diag\left(\frac{m}{(m+1)\lambda_{i}+\tr\left({\mathbf{\Sigma}}\right)}\right)_{\!i\in[d]}\cdot{\mathbf{U}}^{\top}&{\mathbf{0}}_{d}\\
{\mathbf{0}}_{d}^{\top}&amp;0\end{bmatrix}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mrow><mo>[</mo><mtable columnspacing="5pt" displaystyle="true" rowspacing="0pt"><mtr><mtd><msub><mi>𝐕</mi><mn>11</mn></msub></mtd><mtd><msub><mi>𝐯</mi><mn>12</mn></msub></mtd></mtr><mtr><mtd><msubsup><mi>𝐯</mi><mn>21</mn><mo>⊤</mo></msubsup></mtd><mtd><msub><mi>v</mi><mn>22</mn></msub></mtd></mtr></mtable><mo>]</mo></mrow><mo>=</mo><mrow><mo>[</mo><mtable columnspacing="5pt" displaystyle="true" rowspacing="0pt"><mtr><mtd><msub><mn>𝟎</mn><mrow><mi>d</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>d</mi></mrow></msub></mtd><mtd><msub><mn>𝟎</mn><mi>d</mi></msub></mtd></mtr><mtr><mtd><msubsup><mn>𝟎</mn><mi>d</mi><mo>⊤</mo></msubsup></mtd><mtd><mn>1</mn></mtd></mtr></mtable><mo>]</mo></mrow></mrow><mo rspace="1.167em">,</mo><mrow><mrow><mo>[</mo><mtable columnspacing="5pt" displaystyle="true" rowspacing="0pt"><mtr><mtd><msub><mi>𝐐</mi><mn>11</mn></msub></mtd><mtd><msub><mi>𝐪</mi><mn>12</mn></msub></mtd></mtr><mtr><mtd><msubsup><mi>𝐪</mi><mn>21</mn><mo>⊤</mo></msubsup></mtd><mtd><msub><mi>q</mi><mn>22</mn></msub></mtd></mtr></mtable><mo>]</mo></mrow><mo>=</mo><mrow><mo>[</mo><mtable columnspacing="5pt" displaystyle="true" rowspacing="0pt"><mtr><mtd><mrow><mi>𝐔</mi><mo lspace="0.222em" rspace="0.222em">⋅</mo><mrow><mi>diag</mi><mo>⁡</mo><msub><mrow><mo>(</mo><mstyle displaystyle="false"><mfrac><mi>m</mi><mrow><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>m</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>λ</mi><mi>i</mi></msub></mrow><mo>+</mo><mrow><mi>tr</mi><mo>⁡</mo><mrow><mo>(</mo><mi>𝚺</mi><mo>)</mo></mrow></mrow></mrow></mfrac></mstyle><mo rspace="0.055em">)</mo></mrow><mrow><mi>i</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mi>d</mi><mo stretchy="false">]</mo></mrow></mrow></msub></mrow><mo rspace="0.222em">⋅</mo><msup><mi>𝐔</mi><mo>⊤</mo></msup></mrow></mtd><mtd><msub><mn>𝟎</mn><mi>d</mi></msub></mtd></mtr><mtr><mtd><msubsup><mn>𝟎</mn><mi>d</mi><mo>⊤</mo></msubsup></mtd><mtd><mn>0</mn></mtd></mtr></mtable><mo>]</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\begin{bmatrix}{\mathbf{V}}_{11}&amp;{\mathbf{v}}_{12}\\
{\mathbf{v}}_{21}^{\top}&amp;v_{22}\end{bmatrix}=\begin{bmatrix}{\mathbf{0}}_{d\times d}&amp;{\mathbf{0}}_{d}\\
{\mathbf{0}}_{d}^{\top}&amp;1\end{bmatrix},\quad\begin{bmatrix}{\mathbf{Q}}_{11}&amp;{\mathbf{q}}_{12}\\
{\mathbf{q}}_{21}^{\top}&amp;q_{22}\end{bmatrix}=\begin{bmatrix}{\mathbf{U}}\cdot\diag\left(\frac{m}{(m+1)\lambda_{i}+\tr\left({\mathbf{\Sigma}}\right)}\right)_{\!i\in[d]}\cdot{\mathbf{U}}^{\top}&amp;{\mathbf{0}}_{d}\\
{\mathbf{0}}_{d}^{\top}&amp;0\end{bmatrix}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(214)</span></td></tr></tbody>
</table>
<p id="A1.SS3.p3.3" class="ltx_p"><span id="A1.SS3.p3.3.1" class="ltx_text">∎</span></p>
</div>
</div>
<div id="A1.Thmtheorem8" class="ltx_theorem ltx_theorem_theorem">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="A1.Thmtheorem8.2" class="ltx_text ltx_font_bold">Theorem A.8</span></span><span id="A1.Thmtheorem8.3" class="ltx_text ltx_font_bold"> </span>(Optimal Parameters of Fully Fine-Tuned Models)<span id="A1.Thmtheorem8.4" class="ltx_text ltx_font_bold">.</span></h6>
<div id="A1.Thmtheorem8.p1" class="ltx_para">
<p id="A1.Thmtheorem8.p1.1" class="ltx_p"><span id="A1.Thmtheorem8.p1.1.1" class="ltx_text ltx_font_italic">Given a target task <math id="A1.Thmtheorem8.p1.m1" class="ltx_Math" alttext="{\mathbf{\theta}}_{0}\in{\mathbb{R}}^{d}" display="inline" intent=":literal"><semantics><mrow><msub><mi>θ</mi><mn>0</mn></msub><mo>∈</mo><msup><mi>ℝ</mi><mi>d</mi></msup></mrow><annotation encoding="application/x-tex">{\mathbf{\theta}}_{0}\in{\mathbb{R}}^{d}</annotation></semantics></math>, consider the zero-shot prompt loss <math id="A1.Thmtheorem8.p1.m2" class="ltx_Math" alttext="\mathcal{L}_{\mathrm{ZS}}({\mathbf{V}},{\mathbf{Q}};{\mathbf{\theta}}_{0})" display="inline" intent=":literal"><semantics><mrow><msub><mi class="ltx_font_mathcaligraphic">ℒ</mi><mi>ZS</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐕</mi><mo>,</mo><mi>𝐐</mi><mo>,</mo><msub><mi>θ</mi><mn>0</mn></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathcal{L}_{\mathrm{ZS}}({\mathbf{V}},{\mathbf{Q}};{\mathbf{\theta}}_{0})</annotation></semantics></math> in (<a href="#S3.E9" title="Equation 9 ‣ Evaluation Metric and Training Objective. ‣ 3 Problem Setup ‣ Fine-Tuning Without Forgetting In-Context Learning:A Theoretical Analysis of Linear Attention Models" class="ltx_ref"><span class="ltx_text ltx_ref_tag">9</span></a>).
Then, for any <math id="A1.Thmtheorem8.p1.m3" class="ltx_Math" alttext="w&gt;0" display="inline" intent=":literal"><semantics><mrow><mi>w</mi><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">w&gt;0</annotation></semantics></math>, the following parameters globally minimize the loss:</span></p>
<table id="A1.E215" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A1.E215.m1" class="ltx_Math" alttext="{\mathbf{V}}=\begin{bmatrix}0&{\mathbf{0}}_{d}^{\top}&amp;0\\
{\mathbf{0}}_{d}&{\mathbf{0}}_{d}{\mathbf{0}}_{d}^{\top}&{\mathbf{0}}_{d}\\
0&amp;w{\mathbf{\theta}}_{0}^{\top}&amp;1\end{bmatrix},\qquad{\mathbf{Q}}=\begin{bmatrix}1/w&{\mathbf{0}}_{d}^{\top}&amp;0\\
{\mathbf{0}}_{d}&{\mathbf{0}}_{d}{\mathbf{0}}_{d}^{\top}&{\mathbf{0}}_{d}\\
0&{\mathbf{0}}_{d}^{\top}&amp;0\end{bmatrix}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mi>𝐕</mi><mo>=</mo><mrow><mo>[</mo><mtable columnspacing="5pt" displaystyle="true" rowspacing="0pt"><mtr><mtd><mn>0</mn></mtd><mtd><msubsup><mn>𝟎</mn><mi>d</mi><mo>⊤</mo></msubsup></mtd><mtd><mn>0</mn></mtd></mtr><mtr><mtd><msub><mn>𝟎</mn><mi>d</mi></msub></mtd><mtd><mrow><msub><mn>𝟎</mn><mi>d</mi></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mn>𝟎</mn><mi>d</mi><mo>⊤</mo></msubsup></mrow></mtd><mtd><msub><mn>𝟎</mn><mi>d</mi></msub></mtd></mtr><mtr><mtd><mn>0</mn></mtd><mtd><mrow><mi>w</mi><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>θ</mi><mn>0</mn><mo>⊤</mo></msubsup></mrow></mtd><mtd><mn>1</mn></mtd></mtr></mtable><mo>]</mo></mrow></mrow><mo rspace="2.167em">,</mo><mrow><mi>𝐐</mi><mo>=</mo><mrow><mo>[</mo><mtable columnspacing="5pt" displaystyle="true" rowspacing="0pt"><mtr><mtd><mrow><mn>1</mn><mo>/</mo><mi>w</mi></mrow></mtd><mtd><msubsup><mn>𝟎</mn><mi>d</mi><mo>⊤</mo></msubsup></mtd><mtd><mn>0</mn></mtd></mtr><mtr><mtd><msub><mn>𝟎</mn><mi>d</mi></msub></mtd><mtd><mrow><msub><mn>𝟎</mn><mi>d</mi></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mn>𝟎</mn><mi>d</mi><mo>⊤</mo></msubsup></mrow></mtd><mtd><msub><mn>𝟎</mn><mi>d</mi></msub></mtd></mtr><mtr><mtd><mn>0</mn></mtd><mtd><msubsup><mn>𝟎</mn><mi>d</mi><mo>⊤</mo></msubsup></mtd><mtd><mn>0</mn></mtd></mtr></mtable><mo>]</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">{\mathbf{V}}=\begin{bmatrix}0&amp;{\mathbf{0}}_{d}^{\top}&amp;0\\
{\mathbf{0}}_{d}&amp;{\mathbf{0}}_{d}{\mathbf{0}}_{d}^{\top}&amp;{\mathbf{0}}_{d}\\
0&amp;w{\mathbf{\theta}}_{0}^{\top}&amp;1\end{bmatrix},\qquad{\mathbf{Q}}=\begin{bmatrix}1/w&amp;{\mathbf{0}}_{d}^{\top}&amp;0\\
{\mathbf{0}}_{d}&amp;{\mathbf{0}}_{d}{\mathbf{0}}_{d}^{\top}&amp;{\mathbf{0}}_{d}\\
0&amp;{\mathbf{0}}_{d}^{\top}&amp;0\end{bmatrix}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(215)</span></td></tr></tbody>
</table>
</div>
</div>
<div id="A1.SS3.3" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="A1.SS3.p4" class="ltx_para">
<p id="A1.SS3.p4.1" class="ltx_p"><span id="A1.SS3.p4.1.1" class="ltx_text">From Lemma <a href="#A1.Thmtheorem5" title="Lemma A.5. ‣ A.2 Proofs of Statistical Properties of Model Outputs ‣ Appendix A Proofs ‣ Fine-Tuning Without Forgetting In-Context Learning:A Theoretical Analysis of Linear Attention Models" class="ltx_ref"><span class="ltx_text ltx_ref_tag">A.5</span></a>, we have</span></p>
<table id="A1.EGx59" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A1.E216"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A1.E216.m1" class="ltx_Math" alttext="\displaystyle\displaystyle\mathbb{E}_{{\mathbf{x}},y|{\mathbf{\theta}}_{0}}\left[\big(\hat{y}_{\mathrm{ZS}}({\mathbf{x}};{\mathbf{V}},{\mathbf{Q}})-y\big)^{2}\right]" display="inline" intent=":literal"><semantics><mrow><msub><mi>𝔼</mi><mrow><mi>𝐱</mi><mo>,</mo><mrow><mi>y</mi><mo fence="false">|</mo><msub><mi>θ</mi><mn>0</mn></msub></mrow></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><msup><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mrow><mrow><msub><mover accent="true"><mi>y</mi><mo>^</mo></mover><mi>ZS</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐱</mi><mo>,</mo><mi>𝐕</mi><mo>,</mo><mi>𝐐</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mi>y</mi></mrow><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow><mn>2</mn></msup><mo>]</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\displaystyle\mathbb{E}_{{\mathbf{x}},y|{\mathbf{\theta}}_{0}}\left[\big(\hat{y}_{\mathrm{ZS}}({\mathbf{x}};{\mathbf{V}},{\mathbf{Q}})-y\big)^{2}\right]</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.E216.m2" class="ltx_Math" alttext="\displaystyle={\mathbf{\theta}}_{0}^{\top}{\mathbf{\Sigma}}{\mathbf{\theta}}_{0}+\sigma^{2}+\frac{1}{w^{2}}\cdot w{\mathbf{\theta}}_{0}^{\top}{\mathbf{\Sigma}}w{\mathbf{\theta}}_{0}-\frac{2}{w}\cdot w{\mathbf{\theta}}_{0}^{\top}{\mathbf{\Sigma}}{\mathbf{\theta}}_{0}=\sigma^{2}." display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><mrow><msubsup><mi>θ</mi><mn>0</mn><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>𝚺</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>θ</mi><mn>0</mn></msub></mrow><mo>+</mo><msup><mi>σ</mi><mn>2</mn></msup><mo>+</mo><mrow><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><msup><mi>w</mi><mn>2</mn></msup></mfrac></mstyle><mo lspace="0.222em" rspace="0.222em">⋅</mo><mi>w</mi></mrow><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>θ</mi><mn>0</mn><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>𝚺</mi><mo lspace="0em" rspace="0em">​</mo><mi>w</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>θ</mi><mn>0</mn></msub></mrow></mrow><mo>−</mo><mrow><mrow><mstyle displaystyle="true"><mfrac><mn>2</mn><mi>w</mi></mfrac></mstyle><mo lspace="0.222em" rspace="0.222em">⋅</mo><mi>w</mi></mrow><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>θ</mi><mn>0</mn><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>𝚺</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>θ</mi><mn>0</mn></msub></mrow></mrow><mo>=</mo><msup><mi>σ</mi><mn>2</mn></msup></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle={\mathbf{\theta}}_{0}^{\top}{\mathbf{\Sigma}}{\mathbf{\theta}}_{0}+\sigma^{2}+\frac{1}{w^{2}}\cdot w{\mathbf{\theta}}_{0}^{\top}{\mathbf{\Sigma}}w{\mathbf{\theta}}_{0}-\frac{2}{w}\cdot w{\mathbf{\theta}}_{0}^{\top}{\mathbf{\Sigma}}{\mathbf{\theta}}_{0}=\sigma^{2}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(216)</span></td></tr></tbody>
</table>
<p id="A1.SS3.p4.2" class="ltx_p"><span id="A1.SS3.p4.2.1" class="ltx_text">This implies that the above parameters attain the global minimum, since <math id="A1.SS3.p4.m1" class="ltx_Math" alttext="\sigma^{2}=\displaystyle\mathbb{E}[\displaystyle\mathrm{Var}(y\mid{\mathbf{x}})]" display="inline" intent=":literal"><semantics><mrow><msup><mi>σ</mi><mn>2</mn></msup><mo>=</mo><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><mi>Var</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>y</mi><mo fence="true" lspace="0em" rspace="0em">∣</mo><mi>𝐱</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">]</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\sigma^{2}=\displaystyle\mathbb{E}[\displaystyle\mathrm{Var}(y\mid{\mathbf{x}})]</annotation></semantics></math> is the minimum achievable expected squared loss.
∎</span></p>
</div>
</div>
<div id="A1.Thmtheorem9" class="ltx_theorem ltx_theorem_theorem">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="A1.Thmtheorem9.2" class="ltx_text ltx_font_bold">Theorem A.9</span></span><span id="A1.Thmtheorem9.3" class="ltx_text ltx_font_bold"> </span>(Optimal Parameters and Test Error of Value-Matrix Fine-Tuned Models)<span id="A1.Thmtheorem9.4" class="ltx_text ltx_font_bold">.</span></h6>
<div id="A1.Thmtheorem9.p1" class="ltx_para">
<p id="A1.Thmtheorem9.p1.1" class="ltx_p"><span id="A1.Thmtheorem9.p1.1.1" class="ltx_text ltx_font_italic">Given a target task <math id="A1.Thmtheorem9.p1.m1" class="ltx_Math" alttext="{\mathbf{\theta}}_{0}\in{\mathbb{R}}^{d}" display="inline" intent=":literal"><semantics><mrow><msub><mi>θ</mi><mn>0</mn></msub><mo>∈</mo><msup><mi>ℝ</mi><mi>d</mi></msup></mrow><annotation encoding="application/x-tex">{\mathbf{\theta}}_{0}\in{\mathbb{R}}^{d}</annotation></semantics></math>, consider the zero-shot prompt loss <math id="A1.Thmtheorem9.p1.m2" class="ltx_Math" alttext="\mathcal{L}_{\mathrm{ZS}}({\mathbf{V}},{\mathbf{Q}};{\mathbf{\theta}}_{0})" display="inline" intent=":literal"><semantics><mrow><msub><mi class="ltx_font_mathcaligraphic">ℒ</mi><mi>ZS</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐕</mi><mo>,</mo><mi>𝐐</mi><mo>,</mo><msub><mi>θ</mi><mn>0</mn></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathcal{L}_{\mathrm{ZS}}({\mathbf{V}},{\mathbf{Q}};{\mathbf{\theta}}_{0})</annotation></semantics></math> in (<a href="#S3.E9" title="Equation 9 ‣ Evaluation Metric and Training Objective. ‣ 3 Problem Setup ‣ Fine-Tuning Without Forgetting In-Context Learning:A Theoretical Analysis of Linear Attention Models" class="ltx_ref"><span class="ltx_text ltx_ref_tag">9</span></a>).
For any <math id="A1.Thmtheorem9.p1.m3" class="ltx_Math" alttext="w&gt;0" display="inline" intent=":literal"><semantics><mrow><mi>w</mi><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">w&gt;0</annotation></semantics></math>, define</span></p>
<table id="A1.E217" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A1.E217.m1" class="ltx_Math" alttext="\hat{{\mathbf{V}}}(w)=\begin{bmatrix}0&{\mathbf{0}}_{d}^{\top}&amp;0\\
{\mathbf{0}}_{d}&{\mathbf{0}}_{d}{\mathbf{0}}_{d}^{\top}&{\mathbf{0}}_{d}\\
0&amp;\frac{1}{d+4}{\mathbf{\theta}}_{0}^{\top}&amp;w\end{bmatrix},\qquad\hat{{\mathbf{Q}}}=\begin{bmatrix}0&{\mathbf{0}}_{d}^{\top}&amp;0\\
{\mathbf{0}}_{d}&{\mathbf{\Sigma}}^{-1}&{\mathbf{0}}_{d}\\
0&{\mathbf{0}}_{d}^{\top}&amp;0\end{bmatrix}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mrow><mover accent="true"><mi>𝐕</mi><mo>^</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>w</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mo>[</mo><mtable columnspacing="5pt" displaystyle="true" rowspacing="0pt"><mtr><mtd><mn>0</mn></mtd><mtd><msubsup><mn>𝟎</mn><mi>d</mi><mo>⊤</mo></msubsup></mtd><mtd><mn>0</mn></mtd></mtr><mtr><mtd><msub><mn>𝟎</mn><mi>d</mi></msub></mtd><mtd><mrow><msub><mn>𝟎</mn><mi>d</mi></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mn>𝟎</mn><mi>d</mi><mo>⊤</mo></msubsup></mrow></mtd><mtd><msub><mn>𝟎</mn><mi>d</mi></msub></mtd></mtr><mtr><mtd><mn>0</mn></mtd><mtd><mrow><mstyle displaystyle="false"><mfrac><mn>1</mn><mrow><mi>d</mi><mo>+</mo><mn>4</mn></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>θ</mi><mn>0</mn><mo>⊤</mo></msubsup></mrow></mtd><mtd><mi>w</mi></mtd></mtr></mtable><mo>]</mo></mrow></mrow><mo rspace="2.167em">,</mo><mrow><mover accent="true"><mi>𝐐</mi><mo>^</mo></mover><mo>=</mo><mrow><mo>[</mo><mtable columnspacing="5pt" displaystyle="true" rowspacing="0pt"><mtr><mtd><mn>0</mn></mtd><mtd><msubsup><mn>𝟎</mn><mi>d</mi><mo>⊤</mo></msubsup></mtd><mtd><mn>0</mn></mtd></mtr><mtr><mtd><msub><mn>𝟎</mn><mi>d</mi></msub></mtd><mtd><msup><mi>𝚺</mi><mrow><mo>−</mo><mn>1</mn></mrow></msup></mtd><mtd><msub><mn>𝟎</mn><mi>d</mi></msub></mtd></mtr><mtr><mtd><mn>0</mn></mtd><mtd><msubsup><mn>𝟎</mn><mi>d</mi><mo>⊤</mo></msubsup></mtd><mtd><mn>0</mn></mtd></mtr></mtable><mo>]</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\hat{{\mathbf{V}}}(w)=\begin{bmatrix}0&amp;{\mathbf{0}}_{d}^{\top}&amp;0\\
{\mathbf{0}}_{d}&amp;{\mathbf{0}}_{d}{\mathbf{0}}_{d}^{\top}&amp;{\mathbf{0}}_{d}\\
0&amp;\frac{1}{d+4}{\mathbf{\theta}}_{0}^{\top}&amp;w\end{bmatrix},\qquad\hat{{\mathbf{Q}}}=\begin{bmatrix}0&amp;{\mathbf{0}}_{d}^{\top}&amp;0\\
{\mathbf{0}}_{d}&amp;{\mathbf{\Sigma}}^{-1}&amp;{\mathbf{0}}_{d}\\
0&amp;{\mathbf{0}}_{d}^{\top}&amp;0\end{bmatrix}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(217)</span></td></tr></tbody>
</table>
<p id="A1.Thmtheorem9.p1.2" class="ltx_p"><span id="A1.Thmtheorem9.p1.2.1" class="ltx_text ltx_font_italic">Then,</span></p>
<table id="A1.EGx60" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A1.E218"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A1.E218.m1" class="ltx_math_unparsed" alttext="\displaystyle\left\{\begin{bmatrix}0&{\mathbf{0}}_{d}^{\top}&amp;0\\
{\mathbf{0}}_{d}&{\mathbf{V}}_{11}&{\mathbf{v}}_{12}\\
0&amp;\frac{1}{d+4}{\mathbf{\theta}}_{0}^{\top}&amp;w\end{bmatrix}\middle|{\mathbf{V}}_{11}\in{\mathbb{R}}^{d\times d},{\mathbf{v}}_{12}\in{\mathbb{R}}^{d},w\neq 0\right\}=\argmin_{{\mathbf{V}}}\mathcal{L}_{\mathrm{ZS}}({\mathbf{V}},\hat{{\mathbf{Q}}};{\mathbf{\theta}}_{0})." display="inline" intent=":literal"><semantics><mrow><mrow><mo>{</mo><mrow><mo>[</mo><mtable columnspacing="5pt" rowspacing="0pt"><mtr><mtd><mn>0</mn></mtd><mtd><msubsup><mn>𝟎</mn><mi>d</mi><mo>⊤</mo></msubsup></mtd><mtd><mn>0</mn></mtd></mtr><mtr><mtd><msub><mn>𝟎</mn><mi>d</mi></msub></mtd><mtd><msub><mi>𝐕</mi><mn>11</mn></msub></mtd><mtd><msub><mi>𝐯</mi><mn>12</mn></msub></mtd></mtr><mtr><mtd><mn>0</mn></mtd><mtd><mrow><mfrac><mn>1</mn><mrow><mi>d</mi><mo>+</mo><mn>4</mn></mrow></mfrac><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>θ</mi><mn>0</mn><mo>⊤</mo></msubsup></mrow></mtd><mtd><mi>w</mi></mtd></mtr></mtable><mo>]</mo></mrow><mo lspace="0em" rspace="0em" stretchy="true">|</mo><msub><mi>𝐕</mi><mn>11</mn></msub><mo>∈</mo><msup><mi>ℝ</mi><mrow><mi>d</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>d</mi></mrow></msup><mo>,</mo><msub><mi>𝐯</mi><mn>12</mn></msub><mo>∈</mo><msup><mi>ℝ</mi><mi>d</mi></msup><mo>,</mo><mi>w</mi><mo>≠</mo><mn>0</mn><mo>}</mo></mrow><mo>=</mo><msub><mrow><mi>arg</mi><mo lspace="0.170em" rspace="0em">​</mo><mi>min</mi></mrow><mi>𝐕</mi></msub><msub><mi class="ltx_font_mathcaligraphic">ℒ</mi><mi>ZS</mi></msub><mrow><mo stretchy="false">(</mo><mi>𝐕</mi><mo>,</mo><mover accent="true"><mi>𝐐</mi><mo>^</mo></mover><mo>;</mo><msub><mi>θ</mi><mn>0</mn></msub><mo stretchy="false">)</mo></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\left\{\begin{bmatrix}0&amp;{\mathbf{0}}_{d}^{\top}&amp;0\\
{\mathbf{0}}_{d}&amp;{\mathbf{V}}_{11}&amp;{\mathbf{v}}_{12}\\
0&amp;\frac{1}{d+4}{\mathbf{\theta}}_{0}^{\top}&amp;w\end{bmatrix}\middle|{\mathbf{V}}_{11}\in{\mathbb{R}}^{d\times d},{\mathbf{v}}_{12}\in{\mathbb{R}}^{d},w\neq 0\right\}=\argmin_{{\mathbf{V}}}\mathcal{L}_{\mathrm{ZS}}({\mathbf{V}},\hat{{\mathbf{Q}}};{\mathbf{\theta}}_{0}).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(218)</span></td></tr></tbody>
</table>
<p id="A1.Thmtheorem9.p1.3" class="ltx_p"><span id="A1.Thmtheorem9.p1.3.1" class="ltx_text ltx_font_italic">In particular, <math id="A1.Thmtheorem9.p1.m4" class="ltx_Math" alttext="\hat{{\mathbf{V}}}(w)" display="inline" intent=":literal"><semantics><mrow><mover accent="true"><mi>𝐕</mi><mo>^</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>w</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\hat{{\mathbf{V}}}(w)</annotation></semantics></math> minimizes the zero-shot loss for fixed <math id="A1.Thmtheorem9.p1.m5" class="ltx_Math" alttext="\hat{{\mathbf{Q}}}" display="inline" intent=":literal"><semantics><mover accent="true"><mi>𝐐</mi><mo>^</mo></mover><annotation encoding="application/x-tex">\hat{{\mathbf{Q}}}</annotation></semantics></math>, i.e.,</span></p>
<table id="A1.EGx61" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A1.E219"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A1.E219.m1" class="ltx_Math" alttext="\displaystyle\hat{{\mathbf{V}}}(w)\in\argmin_{{\mathbf{V}}}\mathcal{L}_{\mathrm{ZS}}({\mathbf{V}},\hat{{\mathbf{Q}}};{\mathbf{\theta}}_{0})," display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mover accent="true"><mi>𝐕</mi><mo>^</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>w</mi><mo stretchy="false">)</mo></mrow></mrow><mo>∈</mo><mrow><mrow><msub><mrow><mi>arg</mi><mo lspace="0.170em" rspace="0em">​</mo><mi>min</mi></mrow><mi>𝐕</mi></msub><mo>⁡</mo><msub><mi class="ltx_font_mathcaligraphic">ℒ</mi><mi>ZS</mi></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐕</mi><mo>,</mo><mover accent="true"><mi>𝐐</mi><mo>^</mo></mover><mo>,</mo><msub><mi>θ</mi><mn>0</mn></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\hat{{\mathbf{V}}}(w)\in\argmin_{{\mathbf{V}}}\mathcal{L}_{\mathrm{ZS}}({\mathbf{V}},\hat{{\mathbf{Q}}};{\mathbf{\theta}}_{0}),</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(219)</span></td></tr></tbody>
</table>
<p id="A1.Thmtheorem9.p1.4" class="ltx_p"><span id="A1.Thmtheorem9.p1.4.1" class="ltx_text ltx_font_italic">and the minimum value is <math id="A1.Thmtheorem9.p1.m6" class="ltx_Math" alttext="\sigma^{2}+\frac{2}{d+4}{\mathbf{\theta}}_{0}^{\top}{\mathbf{\Sigma}}{\mathbf{\theta}}_{0}" display="inline" intent=":literal"><semantics><mrow><msup><mi>σ</mi><mn>2</mn></msup><mo>+</mo><mrow><mfrac><mn>2</mn><mrow><mi>d</mi><mo>+</mo><mn>4</mn></mrow></mfrac><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>θ</mi><mn>0</mn><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>𝚺</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>θ</mi><mn>0</mn></msub></mrow></mrow><annotation encoding="application/x-tex">\sigma^{2}+\frac{2}{d+4}{\mathbf{\theta}}_{0}^{\top}{\mathbf{\Sigma}}{\mathbf{\theta}}_{0}</annotation></semantics></math>.
Under this choice of parameters, for any <math id="A1.Thmtheorem9.p1.m7" class="ltx_Math" alttext="{\mathbf{\theta}}\in{\mathbb{R}}^{d}" display="inline" intent=":literal"><semantics><mrow><mi>θ</mi><mo>∈</mo><msup><mi>ℝ</mi><mi>d</mi></msup></mrow><annotation encoding="application/x-tex">{\mathbf{\theta}}\in{\mathbb{R}}^{d}</annotation></semantics></math>,</span></p>
<table id="A1.EGx62" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A1.E220"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.E220.m1" class="ltx_Math" alttext="\displaystyle\mathcal{E}\big(\hat{{\mathbf{V}}}(w),\hat{{\mathbf{Q}}},n;{\mathbf{\theta}}\big)=\frac{(d+2)(d+4)+n(n+5+3d)}{(d+4)^{2}(n+1)^{2}}{\mathbf{\theta}}_{0}^{\top}{\mathbf{\Sigma}}{\mathbf{\theta}}_{0}+\frac{2n(n+3+2d)w-2n(n+3+d)-2d+4}{(d+4)(n+1)^{2}}{\mathbf{\theta}}_{0}^{\top}{\mathbf{\Sigma}}{\mathbf{\theta}}" display="inline" intent=":literal"><semantics><mrow><mrow><mi class="ltx_font_mathcaligraphic">ℰ</mi><mo>⁡</mo><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mrow><mover accent="true"><mi>𝐕</mi><mo>^</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>w</mi><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mover accent="true"><mi>𝐐</mi><mo>^</mo></mover><mo>,</mo><mi>n</mi><mo>,</mo><mi>θ</mi><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow></mrow><mo>=</mo><mrow><mrow><mstyle displaystyle="true"><mfrac><mrow><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>d</mi><mo>+</mo><mn>2</mn></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>d</mi><mo>+</mo><mn>4</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mrow><mi>n</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>n</mi><mo>+</mo><mn>5</mn><mo>+</mo><mrow><mn>3</mn><mo lspace="0em" rspace="0em">​</mo><mi>d</mi></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mrow><msup><mrow><mo stretchy="false">(</mo><mrow><mi>d</mi><mo>+</mo><mn>4</mn></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mi>n</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>θ</mi><mn>0</mn><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>𝚺</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>θ</mi><mn>0</mn></msub></mrow><mo>+</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>n</mi><mo>+</mo><mn>3</mn><mo>+</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>d</mi></mrow></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>w</mi></mrow><mo>−</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>n</mi><mo>+</mo><mn>3</mn><mo>+</mo><mi>d</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>d</mi></mrow></mrow><mo>+</mo><mn>4</mn></mrow><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>d</mi><mo>+</mo><mn>4</mn></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mi>n</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>θ</mi><mn>0</mn><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>𝚺</mi><mo lspace="0em" rspace="0em">​</mo><mi>θ</mi></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\mathcal{E}\big(\hat{{\mathbf{V}}}(w),\hat{{\mathbf{Q}}},n;{\mathbf{\theta}}\big)=\frac{(d+2)(d+4)+n(n+5+3d)}{(d+4)^{2}(n+1)^{2}}{\mathbf{\theta}}_{0}^{\top}{\mathbf{\Sigma}}{\mathbf{\theta}}_{0}+\frac{2n(n+3+2d)w-2n(n+3+d)-2d+4}{(d+4)(n+1)^{2}}{\mathbf{\theta}}_{0}^{\top}{\mathbf{\Sigma}}{\mathbf{\theta}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(220)</span></td></tr></tbody>
<tbody id="A1.E221"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.E221.m1" class="ltx_Math" alttext="\displaystyle\qquad\qquad\qquad\qquad\quad+\frac{n(n+1+d)w^{2}-2n(n+1)w}{(n+1)^{2}}{\mathbf{\theta}}^{\top}{\mathbf{\Sigma}}{\mathbf{\theta}}+\frac{nd\,w^{2}}{(n+1)^{2}}\sigma^{2}+{\mathbf{\theta}}^{\top}{\mathbf{\Sigma}}{\mathbf{\theta}}+\sigma^{2}," display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mo>+</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mrow><mrow><mi>n</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>n</mi><mo>+</mo><mn>1</mn><mo>+</mo><mi>d</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mi>w</mi><mn>2</mn></msup></mrow><mo>−</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>n</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>w</mi></mrow></mrow><msup><mrow><mo stretchy="false">(</mo><mrow><mi>n</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msup><mi>θ</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>𝚺</mi><mo lspace="0em" rspace="0em">​</mo><mi>θ</mi></mrow></mrow><mo>+</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><mi>d</mi><mo lspace="0.170em" rspace="0em">​</mo><msup><mi>w</mi><mn>2</mn></msup></mrow><msup><mrow><mo stretchy="false">(</mo><mrow><mi>n</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msup><mi>σ</mi><mn>2</mn></msup></mrow><mo>+</mo><mrow><msup><mi>θ</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>𝚺</mi><mo lspace="0em" rspace="0em">​</mo><mi>θ</mi></mrow><mo>+</mo><msup><mi>σ</mi><mn>2</mn></msup></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\qquad\qquad\qquad\qquad\quad+\frac{n(n+1+d)w^{2}-2n(n+1)w}{(n+1)^{2}}{\mathbf{\theta}}^{\top}{\mathbf{\Sigma}}{\mathbf{\theta}}+\frac{nd\,w^{2}}{(n+1)^{2}}\sigma^{2}+{\mathbf{\theta}}^{\top}{\mathbf{\Sigma}}{\mathbf{\theta}}+\sigma^{2},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(221)</span></td></tr></tbody>
<tbody id="A1.E222"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.E222.m1" class="ltx_Math" alttext="\displaystyle\lim_{n\to\infty}\mathcal{E}\big(\hat{{\mathbf{V}}}(w),\hat{{\mathbf{Q}}},n;{\mathbf{\theta}}\big)=\left(\frac{1}{d+4}{\mathbf{\theta}}_{0}+(w-1){\mathbf{\theta}}\right)^{\top}{\mathbf{\Sigma}}\left(\frac{1}{d+4}{\mathbf{\theta}}_{0}+(w-1){\mathbf{\theta}}\right)+\sigma^{2}." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><munder><mo movablelimits="false">lim</mo><mrow><mi>n</mi><mo stretchy="false">→</mo><mi mathvariant="normal">∞</mi></mrow></munder><mrow><mi class="ltx_font_mathcaligraphic">ℰ</mi><mo>⁡</mo><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mrow><mover accent="true"><mi>𝐕</mi><mo>^</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>w</mi><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mover accent="true"><mi>𝐐</mi><mo>^</mo></mover><mo>,</mo><mi>n</mi><mo>,</mo><mi>θ</mi><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow></mrow></mrow><mo>=</mo><mrow><mrow><msup><mrow><mo>(</mo><mrow><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mrow><mi>d</mi><mo>+</mo><mn>4</mn></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msub><mi>θ</mi><mn>0</mn></msub></mrow><mo>+</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>w</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>θ</mi></mrow></mrow><mo>)</mo></mrow><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>𝚺</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mrow><mi>d</mi><mo>+</mo><mn>4</mn></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msub><mi>θ</mi><mn>0</mn></msub></mrow><mo>+</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>w</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>θ</mi></mrow></mrow><mo>)</mo></mrow></mrow><mo>+</mo><msup><mi>σ</mi><mn>2</mn></msup></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\lim_{n\to\infty}\mathcal{E}\big(\hat{{\mathbf{V}}}(w),\hat{{\mathbf{Q}}},n;{\mathbf{\theta}}\big)=\left(\frac{1}{d+4}{\mathbf{\theta}}_{0}+(w-1){\mathbf{\theta}}\right)^{\top}{\mathbf{\Sigma}}\left(\frac{1}{d+4}{\mathbf{\theta}}_{0}+(w-1){\mathbf{\theta}}\right)+\sigma^{2}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(222)</span></td></tr></tbody>
</table>
</div>
</div>
<div id="A1.SS3.4" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="A1.SS3.p5" class="ltx_para">
<p id="A1.SS3.p5.1" class="ltx_p"><span id="A1.SS3.p5.1.1" class="ltx_text">From Lemma <a href="#A1.Thmtheorem6" title="Lemma A.6. ‣ A.2 Proofs of Statistical Properties of Model Outputs ‣ Appendix A Proofs ‣ Fine-Tuning Without Forgetting In-Context Learning:A Theoretical Analysis of Linear Attention Models" class="ltx_ref"><span class="ltx_text ltx_ref_tag">A.6</span></a>, we have</span></p>
<table id="A1.EGx63" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A1.E223"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A1.E223.m1" class="ltx_Math" alttext="\displaystyle\displaystyle\mathbb{E}_{{\mathbf{x}},y\mid{\mathbf{\theta}}_{0}}\left[\big(\hat{y}_{\mathrm{ZS}}({\mathbf{x}};{\mathbf{V}},\hat{{\mathbf{Q}}})-y\big)^{2}\right]=(d+2)(d+4){\mathbf{v}}_{21}^{\top}{\mathbf{\Sigma}}{\mathbf{v}}_{21}-2(d+2){\mathbf{v}}_{21}^{\top}{\mathbf{\Sigma}}{\mathbf{\theta}}_{0}+{\mathbf{\theta}}_{0}^{\top}{\mathbf{\Sigma}}{\mathbf{\theta}}_{0}+\sigma^{2}," display="inline" intent=":literal"><semantics><mrow><mrow><mrow><msub><mi>𝔼</mi><mrow><mi>𝐱</mi><mo>,</mo><mrow><mi>y</mi><mo fence="false">|</mo><msub><mi>θ</mi><mn>0</mn></msub></mrow></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><msup><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mrow><mrow><msub><mover accent="true"><mi>y</mi><mo>^</mo></mover><mi>ZS</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐱</mi><mo>,</mo><mi>𝐕</mi><mo>,</mo><mover accent="true"><mi>𝐐</mi><mo>^</mo></mover><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mi>y</mi></mrow><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow><mn>2</mn></msup><mo>]</mo></mrow></mrow><mo>=</mo><mrow><mrow><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>d</mi><mo>+</mo><mn>2</mn></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>d</mi><mo>+</mo><mn>4</mn></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝐯</mi><mn>21</mn><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>𝚺</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝐯</mi><mn>21</mn></msub></mrow><mo>−</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>d</mi><mo>+</mo><mn>2</mn></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝐯</mi><mn>21</mn><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>𝚺</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>θ</mi><mn>0</mn></msub></mrow></mrow><mo>+</mo><mrow><msubsup><mi>θ</mi><mn>0</mn><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>𝚺</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>θ</mi><mn>0</mn></msub></mrow><mo>+</mo><msup><mi>σ</mi><mn>2</mn></msup></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\displaystyle\mathbb{E}_{{\mathbf{x}},y\mid{\mathbf{\theta}}_{0}}\left[\big(\hat{y}_{\mathrm{ZS}}({\mathbf{x}};{\mathbf{V}},\hat{{\mathbf{Q}}})-y\big)^{2}\right]=(d+2)(d+4){\mathbf{v}}_{21}^{\top}{\mathbf{\Sigma}}{\mathbf{v}}_{21}-2(d+2){\mathbf{v}}_{21}^{\top}{\mathbf{\Sigma}}{\mathbf{\theta}}_{0}+{\mathbf{\theta}}_{0}^{\top}{\mathbf{\Sigma}}{\mathbf{\theta}}_{0}+\sigma^{2},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(223)</span></td></tr></tbody>
</table>
<p id="A1.SS3.p5.2" class="ltx_p"><span id="A1.SS3.p5.2.1" class="ltx_text">Differentiating with respect to <math id="A1.SS3.p5.m1" class="ltx_Math" alttext="{\mathbf{v}}_{21}" display="inline" intent=":literal"><semantics><msub><mi>𝐯</mi><mn>21</mn></msub><annotation encoding="application/x-tex">{\mathbf{v}}_{21}</annotation></semantics></math> and setting the gradient to zero gives</span></p>
<table id="A1.EGx64" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A1.E224"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A1.E224.m1" class="ltx_Math" alttext="\displaystyle 2(d+2)(d+4){\mathbf{\Sigma}}{\mathbf{v}}_{21}-2(d+2){\mathbf{\Sigma}}{\mathbf{\theta}}_{0}={\mathbf{0}}," display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>d</mi><mo>+</mo><mn>2</mn></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>d</mi><mo>+</mo><mn>4</mn></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>𝚺</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝐯</mi><mn>21</mn></msub></mrow><mo>−</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>d</mi><mo>+</mo><mn>2</mn></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>𝚺</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>θ</mi><mn>0</mn></msub></mrow></mrow><mo>=</mo><mn>𝟎</mn></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle 2(d+2)(d+4){\mathbf{\Sigma}}{\mathbf{v}}_{21}-2(d+2){\mathbf{\Sigma}}{\mathbf{\theta}}_{0}={\mathbf{0}},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(224)</span></td></tr></tbody>
</table>
<p id="A1.SS3.p5.3" class="ltx_p"><span id="A1.SS3.p5.3.1" class="ltx_text">which is unique since <math id="A1.SS3.p5.m2" class="ltx_Math" alttext="{\mathbf{\Sigma}}" display="inline" intent=":literal"><semantics><mi>𝚺</mi><annotation encoding="application/x-tex">{\mathbf{\Sigma}}</annotation></semantics></math> is positive definite. Substituting back gives the minimum value <math id="A1.SS3.p5.m3" class="ltx_Math" alttext="\frac{2}{d+4}{\mathbf{\theta}}_{0}^{\top}{\mathbf{\Sigma}}{\mathbf{\theta}}_{0}+\sigma^{2}" display="inline" intent=":literal"><semantics><mrow><mrow><mfrac><mn>2</mn><mrow><mi>d</mi><mo>+</mo><mn>4</mn></mrow></mfrac><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>θ</mi><mn>0</mn><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>𝚺</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>θ</mi><mn>0</mn></msub></mrow><mo>+</mo><msup><mi>σ</mi><mn>2</mn></msup></mrow><annotation encoding="application/x-tex">\frac{2}{d+4}{\mathbf{\theta}}_{0}^{\top}{\mathbf{\Sigma}}{\mathbf{\theta}}_{0}+\sigma^{2}</annotation></semantics></math>. This proves the minimizer set and, in particular, that <math id="A1.SS3.p5.m4" class="ltx_Math" alttext="\hat{{\mathbf{V}}}(w)" display="inline" intent=":literal"><semantics><mrow><mover accent="true"><mi>𝐕</mi><mo>^</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>w</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\hat{{\mathbf{V}}}(w)</annotation></semantics></math> is a minimizer.</span></p>
</div>
<div id="A1.SS3.p6" class="ltx_para">
<p id="A1.SS3.p6.1" class="ltx_p"><span id="A1.SS3.p6.1.1" class="ltx_text">Moreover, from Lemma <a href="#A1.Thmtheorem6" title="Lemma A.6. ‣ A.2 Proofs of Statistical Properties of Model Outputs ‣ Appendix A Proofs ‣ Fine-Tuning Without Forgetting In-Context Learning:A Theoretical Analysis of Linear Attention Models" class="ltx_ref"><span class="ltx_text ltx_ref_tag">A.6</span></a>, for any <math id="A1.SS3.p6.m1" class="ltx_Math" alttext="{\mathbf{\theta}}\in\mathbb{R}^{d}" display="inline" intent=":literal"><semantics><mrow><mi>θ</mi><mo>∈</mo><msup><mi>ℝ</mi><mi>d</mi></msup></mrow><annotation encoding="application/x-tex">{\mathbf{\theta}}\in\mathbb{R}^{d}</annotation></semantics></math>, we have</span></p>
<table id="A1.EGx65" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A1.E225"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.E225.m1" class="ltx_Math" alttext="\displaystyle\displaystyle\mathbb{E}_{{\mathbf{Z}}_{[n]},{\mathbf{x}},y|{\mathbf{\theta}}}\left[\big(\hat{y}_{\mathrm{FS}}({\mathbf{Z}}_{[n]},{\mathbf{x}};\hat{{\mathbf{V}}}(w),\hat{{\mathbf{Q}}})-y\big)^{2}\right]" display="inline" intent=":literal"><semantics><mrow><msub><mi>𝔼</mi><mrow><msub><mi>𝐙</mi><mrow><mo stretchy="false">[</mo><mi>n</mi><mo stretchy="false">]</mo></mrow></msub><mo>,</mo><mi>𝐱</mi><mo>,</mo><mrow><mi>y</mi><mo fence="false">|</mo><mi>θ</mi></mrow></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><msup><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mrow><mrow><msub><mover accent="true"><mi>y</mi><mo>^</mo></mover><mi>FS</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐙</mi><mrow><mo stretchy="false">[</mo><mi>n</mi><mo stretchy="false">]</mo></mrow></msub><mo>,</mo><mi>𝐱</mi><mo>,</mo><mrow><mover accent="true"><mi>𝐕</mi><mo>^</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>w</mi><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mover accent="true"><mi>𝐐</mi><mo>^</mo></mover><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mi>y</mi></mrow><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow><mn>2</mn></msup><mo>]</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\displaystyle\mathbb{E}_{{\mathbf{Z}}_{[n]},{\mathbf{x}},y|{\mathbf{\theta}}}\left[\big(\hat{y}_{\mathrm{FS}}({\mathbf{Z}}_{[n]},{\mathbf{x}};\hat{{\mathbf{V}}}(w),\hat{{\mathbf{Q}}})-y\big)^{2}\right]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(225)</span></td></tr></tbody>
<tbody id="A1.E226"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.E226.m1" class="ltx_Math" alttext="\displaystyle=\frac{1}{(n+1)^{2}}\Bigg(\frac{(d+2)(d+4)+n(n+5+3d)}{(d+4)^{2}}{\mathbf{\theta}}_{0}^{\top}{\mathbf{\Sigma}}{\mathbf{\theta}}_{0}+\frac{2\Big(n(n+3+2d)\,w-\big(n(n+3+d)+d-2\big)\Big)}{d+4}\,{\mathbf{\theta}}_{0}^{\top}{\mathbf{\Sigma}}{\mathbf{\theta}}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><msup><mrow><mo stretchy="false">(</mo><mrow><mi>n</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="2.600em" minsize="2.600em">(</mo><mrow><mrow><mstyle displaystyle="true"><mfrac><mrow><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>d</mi><mo>+</mo><mn>2</mn></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>d</mi><mo>+</mo><mn>4</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mrow><mi>n</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>n</mi><mo>+</mo><mn>5</mn><mo>+</mo><mrow><mn>3</mn><mo lspace="0em" rspace="0em">​</mo><mi>d</mi></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><msup><mrow><mo stretchy="false">(</mo><mrow><mi>d</mi><mo>+</mo><mn>4</mn></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>θ</mi><mn>0</mn><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>𝚺</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>θ</mi><mn>0</mn></msub></mrow><mo>+</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="1.600em" minsize="1.600em">(</mo><mrow><mrow><mrow><mi>n</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>n</mi><mo>+</mo><mn>3</mn><mo>+</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>d</mi></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0.170em" rspace="0em">​</mo><mi>w</mi></mrow><mo>−</mo><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mrow><mrow><mrow><mi>n</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>n</mi><mo>+</mo><mn>3</mn><mo>+</mo><mi>d</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mi>d</mi></mrow><mo>−</mo><mn>2</mn></mrow><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow></mrow><mo maxsize="1.600em" minsize="1.600em">)</mo></mrow></mrow><mrow><mi>d</mi><mo>+</mo><mn>4</mn></mrow></mfrac></mstyle><mo lspace="0.170em" rspace="0em">​</mo><msubsup><mi>θ</mi><mn>0</mn><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>𝚺</mi><mo lspace="0em" rspace="0em">​</mo><mi>θ</mi></mrow></mrow><mo fence="true" lspace="0em">CLOSE</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\frac{1}{(n+1)^{2}}\Bigg(\frac{(d+2)(d+4)+n(n+5+3d)}{(d+4)^{2}}{\mathbf{\theta}}_{0}^{\top}{\mathbf{\Sigma}}{\mathbf{\theta}}_{0}+\frac{2\Big(n(n+3+2d)\,w-\big(n(n+3+d)+d-2\big)\Big)}{d+4}\,{\mathbf{\theta}}_{0}^{\top}{\mathbf{\Sigma}}{\mathbf{\theta}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(226)</span></td></tr></tbody>
<tbody id="A1.E227"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.E227.m1" class="ltx_Math" alttext="\displaystyle\qquad\qquad\qquad+\Big(n(n+1+d)w^{2}-2n(n+1)w+(n+1)^{2}\Big)\,{\mathbf{\theta}}^{\top}{\mathbf{\Sigma}}{\mathbf{\theta}}+\Big(nd\,w^{2}+(n+1)^{2}\Big)\sigma^{2}\Bigg)" display="inline" intent=":literal"><semantics><mrow><mo fence="true" rspace="0em">OPEN</mo><mrow><mrow><mo>+</mo><mrow><mrow><mo maxsize="1.600em" minsize="1.600em">(</mo><mrow><mrow><mrow><mrow><mi>n</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>n</mi><mo>+</mo><mn>1</mn><mo>+</mo><mi>d</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mi>w</mi><mn>2</mn></msup></mrow><mo>−</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>n</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>w</mi></mrow></mrow><mo>+</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mi>n</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mrow><mo maxsize="1.600em" minsize="1.600em">)</mo></mrow><mo lspace="0.170em" rspace="0em">​</mo><msup><mi>θ</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>𝚺</mi><mo lspace="0em" rspace="0em">​</mo><mi>θ</mi></mrow></mrow><mo>+</mo><mrow><mrow><mo maxsize="1.600em" minsize="1.600em">(</mo><mrow><mrow><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><mi>d</mi><mo lspace="0.170em" rspace="0em">​</mo><msup><mi>w</mi><mn>2</mn></msup></mrow><mo>+</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mi>n</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mrow><mo maxsize="1.600em" minsize="1.600em">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mi>σ</mi><mn>2</mn></msup></mrow></mrow><mo maxsize="2.600em" minsize="2.600em">)</mo></mrow><annotation encoding="application/x-tex">\displaystyle\qquad\qquad\qquad+\Big(n(n+1+d)w^{2}-2n(n+1)w+(n+1)^{2}\Big)\,{\mathbf{\theta}}^{\top}{\mathbf{\Sigma}}{\mathbf{\theta}}+\Big(nd\,w^{2}+(n+1)^{2}\Big)\sigma^{2}\Bigg)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(227)</span></td></tr></tbody>
<tbody id="A1.E228"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.E228.m1" class="ltx_Math" alttext="\displaystyle=\frac{(d+2)(d+4)+n(n+5+3d)}{(d+4)^{2}(n+1)^{2}}{\mathbf{\theta}}_{0}^{\top}{\mathbf{\Sigma}}{\mathbf{\theta}}_{0}+\frac{2n(n+3+2d)w-2n(n+3+d)-2d+4}{(d+4)(n+1)^{2}}{\mathbf{\theta}}_{0}^{\top}{\mathbf{\Sigma}}{\mathbf{\theta}}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><mstyle displaystyle="true"><mfrac><mrow><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>d</mi><mo>+</mo><mn>2</mn></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>d</mi><mo>+</mo><mn>4</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mrow><mi>n</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>n</mi><mo>+</mo><mn>5</mn><mo>+</mo><mrow><mn>3</mn><mo lspace="0em" rspace="0em">​</mo><mi>d</mi></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mrow><msup><mrow><mo stretchy="false">(</mo><mrow><mi>d</mi><mo>+</mo><mn>4</mn></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mi>n</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>θ</mi><mn>0</mn><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>𝚺</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>θ</mi><mn>0</mn></msub></mrow><mo>+</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>n</mi><mo>+</mo><mn>3</mn><mo>+</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>d</mi></mrow></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>w</mi></mrow><mo>−</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>n</mi><mo>+</mo><mn>3</mn><mo>+</mo><mi>d</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>d</mi></mrow></mrow><mo>+</mo><mn>4</mn></mrow><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>d</mi><mo>+</mo><mn>4</mn></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mi>n</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>θ</mi><mn>0</mn><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>𝚺</mi><mo lspace="0em" rspace="0em">​</mo><mi>θ</mi></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\frac{(d+2)(d+4)+n(n+5+3d)}{(d+4)^{2}(n+1)^{2}}{\mathbf{\theta}}_{0}^{\top}{\mathbf{\Sigma}}{\mathbf{\theta}}_{0}+\frac{2n(n+3+2d)w-2n(n+3+d)-2d+4}{(d+4)(n+1)^{2}}{\mathbf{\theta}}_{0}^{\top}{\mathbf{\Sigma}}{\mathbf{\theta}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(228)</span></td></tr></tbody>
<tbody id="A1.E229"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.E229.m1" class="ltx_Math" alttext="\displaystyle\qquad+\frac{n(n+1+d)w^{2}-2n(n+1)w}{(n+1)^{2}}{\mathbf{\theta}}^{\top}{\mathbf{\Sigma}}{\mathbf{\theta}}+\frac{nd\,w^{2}}{(n+1)^{2}}\sigma^{2}+{\mathbf{\theta}}^{\top}{\mathbf{\Sigma}}{\mathbf{\theta}}+\sigma^{2}." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mo>+</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mrow><mrow><mi>n</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>n</mi><mo>+</mo><mn>1</mn><mo>+</mo><mi>d</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mi>w</mi><mn>2</mn></msup></mrow><mo>−</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>n</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>w</mi></mrow></mrow><msup><mrow><mo stretchy="false">(</mo><mrow><mi>n</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msup><mi>θ</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>𝚺</mi><mo lspace="0em" rspace="0em">​</mo><mi>θ</mi></mrow></mrow><mo>+</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><mi>d</mi><mo lspace="0.170em" rspace="0em">​</mo><msup><mi>w</mi><mn>2</mn></msup></mrow><msup><mrow><mo stretchy="false">(</mo><mrow><mi>n</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msup><mi>σ</mi><mn>2</mn></msup></mrow><mo>+</mo><mrow><msup><mi>θ</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>𝚺</mi><mo lspace="0em" rspace="0em">​</mo><mi>θ</mi></mrow><mo>+</mo><msup><mi>σ</mi><mn>2</mn></msup></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\qquad+\frac{n(n+1+d)w^{2}-2n(n+1)w}{(n+1)^{2}}{\mathbf{\theta}}^{\top}{\mathbf{\Sigma}}{\mathbf{\theta}}+\frac{nd\,w^{2}}{(n+1)^{2}}\sigma^{2}+{\mathbf{\theta}}^{\top}{\mathbf{\Sigma}}{\mathbf{\theta}}+\sigma^{2}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(229)</span></td></tr></tbody>
</table>
<p id="A1.SS3.p6.2" class="ltx_p"><span id="A1.SS3.p6.2.1" class="ltx_text">Therefore,</span></p>
<table id="A1.EGx66" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A1.E230"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A1.E230.m1" class="ltx_Math" alttext="\displaystyle\lim_{n\to\infty}\displaystyle\mathbb{E}_{{\mathbf{Z}}_{[n]},{\mathbf{x}},y\mid{\mathbf{\theta}}}\left[\big(\hat{y}_{\mathrm{FS}}({\mathbf{Z}}_{[n]},{\mathbf{x}};\hat{{\mathbf{V}}}(w),\hat{{\mathbf{Q}}})-y\big)^{2}\right]" display="inline" intent=":literal"><semantics><mrow><munder><mo movablelimits="false">lim</mo><mrow><mi>n</mi><mo stretchy="false">→</mo><mi mathvariant="normal">∞</mi></mrow></munder><mrow><msub><mi>𝔼</mi><mrow><msub><mi>𝐙</mi><mrow><mo stretchy="false">[</mo><mi>n</mi><mo stretchy="false">]</mo></mrow></msub><mo>,</mo><mi>𝐱</mi><mo>,</mo><mrow><mi>y</mi><mo fence="false">|</mo><mi>θ</mi></mrow></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><msup><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mrow><mrow><msub><mover accent="true"><mi>y</mi><mo>^</mo></mover><mi>FS</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐙</mi><mrow><mo stretchy="false">[</mo><mi>n</mi><mo stretchy="false">]</mo></mrow></msub><mo>,</mo><mi>𝐱</mi><mo>,</mo><mrow><mover accent="true"><mi>𝐕</mi><mo>^</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>w</mi><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mover accent="true"><mi>𝐐</mi><mo>^</mo></mover><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mi>y</mi></mrow><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow><mn>2</mn></msup><mo>]</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\lim_{n\to\infty}\displaystyle\mathbb{E}_{{\mathbf{Z}}_{[n]},{\mathbf{x}},y\mid{\mathbf{\theta}}}\left[\big(\hat{y}_{\mathrm{FS}}({\mathbf{Z}}_{[n]},{\mathbf{x}};\hat{{\mathbf{V}}}(w),\hat{{\mathbf{Q}}})-y\big)^{2}\right]</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.E230.m2" class="ltx_Math" alttext="\displaystyle=\left(\frac{1}{d+4}{\mathbf{\theta}}_{0}+(w-1){\mathbf{\theta}}\right)^{\top}{\mathbf{\Sigma}}\left(\frac{1}{d+4}{\mathbf{\theta}}_{0}+(w-1){\mathbf{\theta}}\right)+\sigma^{2}." display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><msup><mrow><mo>(</mo><mrow><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mrow><mi>d</mi><mo>+</mo><mn>4</mn></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msub><mi>θ</mi><mn>0</mn></msub></mrow><mo>+</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>w</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>θ</mi></mrow></mrow><mo>)</mo></mrow><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>𝚺</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mrow><mi>d</mi><mo>+</mo><mn>4</mn></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msub><mi>θ</mi><mn>0</mn></msub></mrow><mo>+</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>w</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>θ</mi></mrow></mrow><mo>)</mo></mrow></mrow><mo>+</mo><msup><mi>σ</mi><mn>2</mn></msup></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle=\left(\frac{1}{d+4}{\mathbf{\theta}}_{0}+(w-1){\mathbf{\theta}}\right)^{\top}{\mathbf{\Sigma}}\left(\frac{1}{d+4}{\mathbf{\theta}}_{0}+(w-1){\mathbf{\theta}}\right)+\sigma^{2}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(230)</span></td></tr></tbody>
</table>
<p id="A1.SS3.p6.3" class="ltx_p"><span id="A1.SS3.p6.3.1" class="ltx_text">∎</span></p>
</div>
</div>
<div id="A1.Thmtheorem10" class="ltx_theorem ltx_theorem_theorem">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="A1.Thmtheorem10.2" class="ltx_text ltx_font_bold">Theorem A.10</span></span><span id="A1.Thmtheorem10.3" class="ltx_text ltx_font_bold"> </span>(Task-Wise Optimal <math id="A1.Thmtheorem10.m1" class="ltx_Math" alttext="w" display="inline" intent=":literal"><semantics><mi>w</mi><annotation encoding="application/x-tex">w</annotation></semantics></math>)<span id="A1.Thmtheorem10.4" class="ltx_text ltx_font_bold">.</span></h6>
<div id="A1.Thmtheorem10.p1" class="ltx_para">
<p id="A1.Thmtheorem10.p1.1" class="ltx_p"><span id="A1.Thmtheorem10.p1.1.1" class="ltx_text ltx_font_italic">Given a target task <math id="A1.Thmtheorem10.p1.m1" class="ltx_Math" alttext="{\mathbf{\theta}}_{0}\in{\mathbb{R}}^{d}" display="inline" intent=":literal"><semantics><mrow><msub><mi>θ</mi><mn>0</mn></msub><mo>∈</mo><msup><mi>ℝ</mi><mi>d</mi></msup></mrow><annotation encoding="application/x-tex">{\mathbf{\theta}}_{0}\in{\mathbb{R}}^{d}</annotation></semantics></math>, consider the family of parameters
<math id="A1.Thmtheorem10.p1.m2" class="ltx_Math" alttext="\big(\hat{{\mathbf{V}}}(w),\hat{{\mathbf{Q}}}\big)" display="inline" intent=":literal"><semantics><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mrow><mover accent="true"><mi>𝐕</mi><mo>^</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>w</mi><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mover accent="true"><mi>𝐐</mi><mo>^</mo></mover><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow><annotation encoding="application/x-tex">\big(\hat{{\mathbf{V}}}(w),\hat{{\mathbf{Q}}}\big)</annotation></semantics></math> in (<a href="#A1.E217" title="Equation 217 ‣ Theorem A.9 (Optimal Parameters and Test Error of Value-Matrix Fine-Tuned Models). ‣ A.3 Proofs for Optimal Parameters ‣ Appendix A Proofs ‣ Fine-Tuning Without Forgetting In-Context Learning:A Theoretical Analysis of Linear Attention Models" class="ltx_ref"><span class="ltx_text ltx_ref_tag">217</span></a>).
For any <math id="A1.Thmtheorem10.p1.m3" class="ltx_Math" alttext="n\in{\mathbb{N}}" display="inline" intent=":literal"><semantics><mrow><mi>n</mi><mo>∈</mo><mi>ℕ</mi></mrow><annotation encoding="application/x-tex">n\in{\mathbb{N}}</annotation></semantics></math> and any <math id="A1.Thmtheorem10.p1.m4" class="ltx_Math" alttext="{\mathbf{\theta}}\in{\mathbb{R}}^{d}" display="inline" intent=":literal"><semantics><mrow><mi>θ</mi><mo>∈</mo><msup><mi>ℝ</mi><mi>d</mi></msup></mrow><annotation encoding="application/x-tex">{\mathbf{\theta}}\in{\mathbb{R}}^{d}</annotation></semantics></math>, the few-shot test error on the task <math id="A1.Thmtheorem10.p1.m5" class="ltx_Math" alttext="{\mathbf{\theta}}" display="inline" intent=":literal"><semantics><mi>θ</mi><annotation encoding="application/x-tex">{\mathbf{\theta}}</annotation></semantics></math> is minimized at</span></p>
<table id="A1.EGx67" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A1.E231"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A1.E231.m1" class="ltx_Math" alttext="\displaystyle w^{\star}(n;{\mathbf{\theta}})" display="inline" intent=":literal"><semantics><mrow><msup><mi>w</mi><mo>⋆</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>n</mi><mo>,</mo><mi>θ</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle w^{\star}(n;{\mathbf{\theta}})</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.E231.m2" class="ltx_Math" alttext="\displaystyle:=\argmin_{w}\mathcal{E}\big(\hat{{\mathbf{V}}}(w),\hat{{\mathbf{Q}}},n;{\mathbf{\theta}}\big)=\frac{(n+1){\mathbf{\theta}}^{\top}{\mathbf{\Sigma}}{\mathbf{\theta}}-\frac{n+3+2d}{d+4}{\mathbf{\theta}}_{0}^{\top}{\mathbf{\Sigma}}{\mathbf{\theta}}}{(n+1+d){\mathbf{\theta}}^{\top}{\mathbf{\Sigma}}{\mathbf{\theta}}+d\sigma^{2}}." display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><msub><mrow><mi>arg</mi><mo lspace="0.170em" rspace="0em">​</mo><mi>min</mi></mrow><mi>w</mi></msub><mo>⁡</mo><mi class="ltx_font_mathcaligraphic">ℰ</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mrow><mover accent="true"><mi>𝐕</mi><mo>^</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>w</mi><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mover accent="true"><mi>𝐐</mi><mo>^</mo></mover><mo>,</mo><mi>n</mi><mo>,</mo><mi>θ</mi><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow></mrow><mo>=</mo><mstyle displaystyle="true"><mfrac><mrow><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>n</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mi>θ</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>𝚺</mi><mo lspace="0em" rspace="0em">​</mo><mi>θ</mi></mrow><mo>−</mo><mrow><mfrac><mrow><mi>n</mi><mo>+</mo><mn>3</mn><mo>+</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>d</mi></mrow></mrow><mrow><mi>d</mi><mo>+</mo><mn>4</mn></mrow></mfrac><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>θ</mi><mn>0</mn><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>𝚺</mi><mo lspace="0em" rspace="0em">​</mo><mi>θ</mi></mrow></mrow><mrow><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>n</mi><mo>+</mo><mn>1</mn><mo>+</mo><mi>d</mi></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mi>θ</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>𝚺</mi><mo lspace="0em" rspace="0em">​</mo><mi>θ</mi></mrow><mo>+</mo><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>σ</mi><mn>2</mn></msup></mrow></mrow></mfrac></mstyle></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle:=\argmin_{w}\mathcal{E}\big(\hat{{\mathbf{V}}}(w),\hat{{\mathbf{Q}}},n;{\mathbf{\theta}}\big)=\frac{(n+1){\mathbf{\theta}}^{\top}{\mathbf{\Sigma}}{\mathbf{\theta}}-\frac{n+3+2d}{d+4}{\mathbf{\theta}}_{0}^{\top}{\mathbf{\Sigma}}{\mathbf{\theta}}}{(n+1+d){\mathbf{\theta}}^{\top}{\mathbf{\Sigma}}{\mathbf{\theta}}+d\sigma^{2}}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(231)</span></td></tr></tbody>
</table>
<p id="A1.Thmtheorem10.p1.2" class="ltx_p"><span id="A1.Thmtheorem10.p1.2.1" class="ltx_text ltx_font_italic">Then <math id="A1.Thmtheorem10.p1.m6" class="ltx_Math" alttext="w^{\star}(n;{\mathbf{\theta}})\to\frac{d+3}{d+4}" display="inline" intent=":literal"><semantics><mrow><mrow><msup><mi>w</mi><mo>⋆</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>n</mi><mo>,</mo><mi>θ</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">→</mo><mfrac><mrow><mi>d</mi><mo>+</mo><mn>3</mn></mrow><mrow><mi>d</mi><mo>+</mo><mn>4</mn></mrow></mfrac></mrow><annotation encoding="application/x-tex">w^{\star}(n;{\mathbf{\theta}})\to\frac{d+3}{d+4}</annotation></semantics></math> as <math id="A1.Thmtheorem10.p1.m7" class="ltx_Math" alttext="n\to\infty" display="inline" intent=":literal"><semantics><mrow><mi>n</mi><mo stretchy="false">→</mo><mi mathvariant="normal">∞</mi></mrow><annotation encoding="application/x-tex">n\to\infty</annotation></semantics></math>. Hence, for any <math id="A1.Thmtheorem10.p1.m8" class="ltx_Math" alttext="{\mathbf{\theta}}\in{\mathbb{R}}^{d}" display="inline" intent=":literal"><semantics><mrow><mi>θ</mi><mo>∈</mo><msup><mi>ℝ</mi><mi>d</mi></msup></mrow><annotation encoding="application/x-tex">{\mathbf{\theta}}\in{\mathbb{R}}^{d}</annotation></semantics></math>,</span></p>
<table id="A1.E232" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A1.E232.m1" class="ltx_Math" alttext="\lim_{n\to\infty}\mathcal{E}\big(\hat{{\mathbf{V}}}(\tfrac{d+3}{d+4}),\hat{{\mathbf{Q}}},n;{\mathbf{\theta}}\big)=\sigma^{2}+\frac{1}{(d+4)^{2}}({\mathbf{\theta}}-{\mathbf{\theta}}_{0})^{\top}{\mathbf{\Sigma}}({\mathbf{\theta}}-{\mathbf{\theta}}_{0})." display="block" intent=":literal"><semantics><mrow><mrow><mrow><munder><mo movablelimits="false">lim</mo><mrow><mi>n</mi><mo stretchy="false">→</mo><mi mathvariant="normal">∞</mi></mrow></munder><mrow><mi class="ltx_font_mathcaligraphic">ℰ</mi><mo>⁡</mo><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mrow><mover accent="true"><mi>𝐕</mi><mo>^</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mstyle displaystyle="false"><mfrac><mrow><mi>d</mi><mo>+</mo><mn>3</mn></mrow><mrow><mi>d</mi><mo>+</mo><mn>4</mn></mrow></mfrac></mstyle><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mover accent="true"><mi>𝐐</mi><mo>^</mo></mover><mo>,</mo><mi>n</mi><mo>,</mo><mi>θ</mi><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow></mrow></mrow><mo>=</mo><mrow><msup><mi>σ</mi><mn>2</mn></msup><mo>+</mo><mrow><mfrac><mn>1</mn><msup><mrow><mo stretchy="false">(</mo><mrow><mi>d</mi><mo>+</mo><mn>4</mn></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mfrac><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mi>θ</mi><mo>−</mo><msub><mi>θ</mi><mn>0</mn></msub></mrow><mo stretchy="false">)</mo></mrow><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>𝚺</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>θ</mi><mo>−</mo><msub><mi>θ</mi><mn>0</mn></msub></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\lim_{n\to\infty}\mathcal{E}\big(\hat{{\mathbf{V}}}(\tfrac{d+3}{d+4}),\hat{{\mathbf{Q}}},n;{\mathbf{\theta}}\big)=\sigma^{2}+\frac{1}{(d+4)^{2}}({\mathbf{\theta}}-{\mathbf{\theta}}_{0})^{\top}{\mathbf{\Sigma}}({\mathbf{\theta}}-{\mathbf{\theta}}_{0}).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(232)</span></td></tr></tbody>
</table>
</div>
</div>
<div id="A1.Thmtheorem11" class="ltx_theorem ltx_theorem_corollary">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="A1.Thmtheorem11.2" class="ltx_text ltx_font_bold">Corollary A.11</span></span><span id="A1.Thmtheorem11.3" class="ltx_text ltx_font_bold"> </span>(Task-Averaged Optimal <math id="A1.Thmtheorem11.m1" class="ltx_Math" alttext="w" display="inline" intent=":literal"><semantics><mi>w</mi><annotation encoding="application/x-tex">w</annotation></semantics></math>)<span id="A1.Thmtheorem11.4" class="ltx_text ltx_font_bold">.</span></h6>
<div id="A1.Thmtheorem11.p1" class="ltx_para">
<p id="A1.Thmtheorem11.p1.1" class="ltx_p"><span id="A1.Thmtheorem11.p1.1.1" class="ltx_text ltx_font_italic">Given a target task <math id="A1.Thmtheorem11.p1.m1" class="ltx_Math" alttext="{\mathbf{\theta}}_{0}\in{\mathbb{R}}^{d}" display="inline" intent=":literal"><semantics><mrow><msub><mi>θ</mi><mn>0</mn></msub><mo>∈</mo><msup><mi>ℝ</mi><mi>d</mi></msup></mrow><annotation encoding="application/x-tex">{\mathbf{\theta}}_{0}\in{\mathbb{R}}^{d}</annotation></semantics></math>, consider the family of parameters <math id="A1.Thmtheorem11.p1.m2" class="ltx_Math" alttext="\big(\hat{{\mathbf{V}}}(w),\hat{{\mathbf{Q}}}\big)" display="inline" intent=":literal"><semantics><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mrow><mover accent="true"><mi>𝐕</mi><mo>^</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>w</mi><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mover accent="true"><mi>𝐐</mi><mo>^</mo></mover><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow><annotation encoding="application/x-tex">\big(\hat{{\mathbf{V}}}(w),\hat{{\mathbf{Q}}}\big)</annotation></semantics></math> in (<a href="#S4.E21" title="Equation 21 ‣ Theorem 4.6 (Optimal Parameters and Test Error of Value-Matrix Fine-Tuned Models). ‣ 4.3 Fine-Tuning Value Matrix with Zero-Shot Loss ‣ 4 Optimal Parameters and Test Error of Learned Linear Attention Models ‣ Fine-Tuning Without Forgetting In-Context Learning:A Theoretical Analysis of Linear Attention Models" class="ltx_ref"><span class="ltx_text ltx_ref_tag">21</span></a>).
For any <math id="A1.Thmtheorem11.p1.m3" class="ltx_Math" alttext="n\in{\mathbb{N}}" display="inline" intent=":literal"><semantics><mrow><mi>n</mi><mo>∈</mo><mi>ℕ</mi></mrow><annotation encoding="application/x-tex">n\in{\mathbb{N}}</annotation></semantics></math>, the few-shot test error averaged over tasks
<math id="A1.Thmtheorem11.p1.m4" class="ltx_Math" alttext="{\mathbf{\theta}}\sim\mathcal{N}({\mathbf{0}}_{d},{\mathbf{I}}_{d})" display="inline" intent=":literal"><semantics><mrow><mi>θ</mi><mo>∼</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒩</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mn>𝟎</mn><mi>d</mi></msub><mo>,</mo><msub><mi>𝐈</mi><mi>d</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">{\mathbf{\theta}}\sim\mathcal{N}({\mathbf{0}}_{d},{\mathbf{I}}_{d})</annotation></semantics></math> is minimized at</span></p>
<table id="A1.EGx68" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A1.E233"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A1.E233.m1" class="ltx_Math" alttext="\displaystyle w^{\star}(n)" display="inline" intent=":literal"><semantics><mrow><msup><mi>w</mi><mo>⋆</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>n</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle w^{\star}(n)</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.E233.m2" class="ltx_Math" alttext="\displaystyle:=\argmin_{w}\displaystyle\mathbb{E}_{{\mathbf{\theta}}}\!\left[\mathcal{E}\big(\hat{{\mathbf{V}}}(w),\hat{{\mathbf{Q}}},n;{\mathbf{\theta}}\big)\right]=\frac{(n+1)\tr({\mathbf{\Sigma}})}{(n+1+d)\tr({\mathbf{\Sigma}})+d\sigma^{2}}." display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><msub><mrow><mi>arg</mi><mo lspace="0.170em" rspace="0em">​</mo><mi>min</mi></mrow><mi>w</mi></msub><mo>⁡</mo><msub><mi>𝔼</mi><mi>θ</mi></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><mrow><mi class="ltx_font_mathcaligraphic">ℰ</mi><mo>⁡</mo><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mrow><mover accent="true"><mi>𝐕</mi><mo>^</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>w</mi><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mover accent="true"><mi>𝐐</mi><mo>^</mo></mover><mo>,</mo><mi>n</mi><mo>,</mo><mi>θ</mi><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow></mrow><mo>]</mo></mrow></mrow><mo>=</mo><mstyle displaystyle="true"><mfrac><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>n</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>tr</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝚺</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mrow><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>n</mi><mo>+</mo><mn>1</mn><mo>+</mo><mi>d</mi></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>tr</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝚺</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>+</mo><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>σ</mi><mn>2</mn></msup></mrow></mrow></mfrac></mstyle></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle:=\argmin_{w}\displaystyle\mathbb{E}_{{\mathbf{\theta}}}\!\left[\mathcal{E}\big(\hat{{\mathbf{V}}}(w),\hat{{\mathbf{Q}}},n;{\mathbf{\theta}}\big)\right]=\frac{(n+1)\tr({\mathbf{\Sigma}})}{(n+1+d)\tr({\mathbf{\Sigma}})+d\sigma^{2}}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(233)</span></td></tr></tbody>
</table>
<p id="A1.Thmtheorem11.p1.2" class="ltx_p"><span id="A1.Thmtheorem11.p1.2.1" class="ltx_text ltx_font_italic">Then <math id="A1.Thmtheorem11.p1.m5" class="ltx_Math" alttext="w^{\star}(n)\to 1" display="inline" intent=":literal"><semantics><mrow><mrow><msup><mi>w</mi><mo>⋆</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>n</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">→</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">w^{\star}(n)\to 1</annotation></semantics></math> as <math id="A1.Thmtheorem11.p1.m6" class="ltx_Math" alttext="n\to\infty" display="inline" intent=":literal"><semantics><mrow><mi>n</mi><mo stretchy="false">→</mo><mi mathvariant="normal">∞</mi></mrow><annotation encoding="application/x-tex">n\to\infty</annotation></semantics></math>. Hence, for any <math id="A1.Thmtheorem11.p1.m7" class="ltx_Math" alttext="{\mathbf{\theta}}\in{\mathbb{R}}^{d}" display="inline" intent=":literal"><semantics><mrow><mi>θ</mi><mo>∈</mo><msup><mi>ℝ</mi><mi>d</mi></msup></mrow><annotation encoding="application/x-tex">{\mathbf{\theta}}\in{\mathbb{R}}^{d}</annotation></semantics></math>,</span></p>
<table id="A1.E234" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A1.E234.m1" class="ltx_Math" alttext="\lim_{n\to\infty}\mathcal{E}\big(\hat{{\mathbf{V}}}(1),\hat{{\mathbf{Q}}},n;{\mathbf{\theta}}\big)=\sigma^{2}+\frac{1}{(d+4)^{2}}\,{\mathbf{\theta}}_{0}^{\top}{\mathbf{\Sigma}}{\mathbf{\theta}}_{0}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><munder><mo movablelimits="false">lim</mo><mrow><mi>n</mi><mo stretchy="false">→</mo><mi mathvariant="normal">∞</mi></mrow></munder><mrow><mi class="ltx_font_mathcaligraphic">ℰ</mi><mo>⁡</mo><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mrow><mover accent="true"><mi>𝐕</mi><mo>^</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mover accent="true"><mi>𝐐</mi><mo>^</mo></mover><mo>,</mo><mi>n</mi><mo>,</mo><mi>θ</mi><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow></mrow></mrow><mo>=</mo><mrow><msup><mi>σ</mi><mn>2</mn></msup><mo>+</mo><mrow><mfrac><mn>1</mn><msup><mrow><mo stretchy="false">(</mo><mrow><mi>d</mi><mo>+</mo><mn>4</mn></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mfrac><mo lspace="0.170em" rspace="0em">​</mo><msubsup><mi>θ</mi><mn>0</mn><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>𝚺</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>θ</mi><mn>0</mn></msub></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\lim_{n\to\infty}\mathcal{E}\big(\hat{{\mathbf{V}}}(1),\hat{{\mathbf{Q}}},n;{\mathbf{\theta}}\big)=\sigma^{2}+\frac{1}{(d+4)^{2}}\,{\mathbf{\theta}}_{0}^{\top}{\mathbf{\Sigma}}{\mathbf{\theta}}_{0}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(234)</span></td></tr></tbody>
</table>
</div>
</div>
<div id="A1.SS3.5" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof of Theorem <a href="#A1.Thmtheorem10" title="Theorem A.10 (Task-Wise Optimal 𝑤). ‣ A.3 Proofs for Optimal Parameters ‣ Appendix A Proofs ‣ Fine-Tuning Without Forgetting In-Context Learning:A Theoretical Analysis of Linear Attention Models" class="ltx_ref"><span class="ltx_text ltx_ref_tag">A.10</span></a> and Corollary <a href="#A1.Thmtheorem11" title="Corollary A.11 (Task-Averaged Optimal 𝑤). ‣ A.3 Proofs for Optimal Parameters ‣ Appendix A Proofs ‣ Fine-Tuning Without Forgetting In-Context Learning:A Theoretical Analysis of Linear Attention Models" class="ltx_ref"><span class="ltx_text ltx_ref_tag">A.11</span></a>.</h6>
<div id="A1.SS3.p7" class="ltx_para">
<p id="A1.SS3.p7.1" class="ltx_p"><span id="A1.SS3.p7.1.1" class="ltx_text">Fix <math id="A1.SS3.p7.m1" class="ltx_Math" alttext="\theta\in{\mathbb{R}}^{d}" display="inline" intent=":literal"><semantics><mrow><mi>θ</mi><mo>∈</mo><msup><mi>ℝ</mi><mi>d</mi></msup></mrow><annotation encoding="application/x-tex">\theta\in{\mathbb{R}}^{d}</annotation></semantics></math>. Collecting the terms in (<a href="#A1.E221" title="Equation 221 ‣ Theorem A.9 (Optimal Parameters and Test Error of Value-Matrix Fine-Tuned Models). ‣ A.3 Proofs for Optimal Parameters ‣ Appendix A Proofs ‣ Fine-Tuning Without Forgetting In-Context Learning:A Theoretical Analysis of Linear Attention Models" class="ltx_ref"><span class="ltx_text ltx_ref_tag">221</span></a>) that depend on <math id="A1.SS3.p7.m2" class="ltx_Math" alttext="w" display="inline" intent=":literal"><semantics><mi>w</mi><annotation encoding="application/x-tex">w</annotation></semantics></math>, we obtain</span></p>
<table id="A1.EGx69" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A1.E235"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.E235.m1" class="ltx_Math" alttext="\displaystyle\displaystyle\mathbb{E}_{{\mathbf{Z}}_{[n]},{\mathbf{x}},y|{\mathbf{\theta}}}\left[\big(\hat{y}_{\mathrm{FS}}({\mathbf{Z}}_{[n]},{\mathbf{x}};\hat{{\mathbf{V}}}(w),\hat{{\mathbf{Q}}})-y\big)^{2}\right]" display="inline" intent=":literal"><semantics><mrow><msub><mi>𝔼</mi><mrow><msub><mi>𝐙</mi><mrow><mo stretchy="false">[</mo><mi>n</mi><mo stretchy="false">]</mo></mrow></msub><mo>,</mo><mi>𝐱</mi><mo>,</mo><mrow><mi>y</mi><mo fence="false">|</mo><mi>θ</mi></mrow></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><msup><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mrow><mrow><msub><mover accent="true"><mi>y</mi><mo>^</mo></mover><mi>FS</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐙</mi><mrow><mo stretchy="false">[</mo><mi>n</mi><mo stretchy="false">]</mo></mrow></msub><mo>,</mo><mi>𝐱</mi><mo>,</mo><mrow><mover accent="true"><mi>𝐕</mi><mo>^</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>w</mi><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mover accent="true"><mi>𝐐</mi><mo>^</mo></mover><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mi>y</mi></mrow><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow><mn>2</mn></msup><mo>]</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\displaystyle\mathbb{E}_{{\mathbf{Z}}_{[n]},{\mathbf{x}},y|{\mathbf{\theta}}}\left[\big(\hat{y}_{\mathrm{FS}}({\mathbf{Z}}_{[n]},{\mathbf{x}};\hat{{\mathbf{V}}}(w),\hat{{\mathbf{Q}}})-y\big)^{2}\right]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(235)</span></td></tr></tbody>
<tbody id="A1.E236"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.E236.m1" class="ltx_Math" alttext="\displaystyle=\frac{2n(n+3+2d)w}{(d+4)(n+1)^{2}}{\mathbf{\theta}}_{0}^{\top}{\mathbf{\Sigma}}{\mathbf{\theta}}+\frac{n(n+1+d)w^{2}-2n(n+1)w}{(n+1)^{2}}{\mathbf{\theta}}^{\top}{\mathbf{\Sigma}}{\mathbf{\theta}}+\frac{nd\,w^{2}}{(n+1)^{2}}\sigma^{2}+\mathrm{const}(\theta)" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><mstyle displaystyle="true"><mfrac><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>n</mi><mo>+</mo><mn>3</mn><mo>+</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>d</mi></mrow></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>w</mi></mrow><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>d</mi><mo>+</mo><mn>4</mn></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mi>n</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>θ</mi><mn>0</mn><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>𝚺</mi><mo lspace="0em" rspace="0em">​</mo><mi>θ</mi></mrow><mo>+</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mrow><mrow><mi>n</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>n</mi><mo>+</mo><mn>1</mn><mo>+</mo><mi>d</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mi>w</mi><mn>2</mn></msup></mrow><mo>−</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>n</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>w</mi></mrow></mrow><msup><mrow><mo stretchy="false">(</mo><mrow><mi>n</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msup><mi>θ</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>𝚺</mi><mo lspace="0em" rspace="0em">​</mo><mi>θ</mi></mrow><mo>+</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><mi>d</mi><mo lspace="0.170em" rspace="0em">​</mo><msup><mi>w</mi><mn>2</mn></msup></mrow><msup><mrow><mo stretchy="false">(</mo><mrow><mi>n</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msup><mi>σ</mi><mn>2</mn></msup></mrow><mo>+</mo><mrow><mi>const</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>θ</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\frac{2n(n+3+2d)w}{(d+4)(n+1)^{2}}{\mathbf{\theta}}_{0}^{\top}{\mathbf{\Sigma}}{\mathbf{\theta}}+\frac{n(n+1+d)w^{2}-2n(n+1)w}{(n+1)^{2}}{\mathbf{\theta}}^{\top}{\mathbf{\Sigma}}{\mathbf{\theta}}+\frac{nd\,w^{2}}{(n+1)^{2}}\sigma^{2}+\mathrm{const}(\theta)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(236)</span></td></tr></tbody>
<tbody id="A1.E237"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.E237.m1" class="ltx_Math" alttext="\displaystyle=\frac{n}{(n+1)^{2}}\Big(\big((n+1+d)\theta^{\top}\Sigma\theta+d\sigma^{2}\big)w^{2}+2\big(\frac{n+3+2d}{d+4}\theta_{0}^{\top}\Sigma\theta-(n+1)\theta^{\top}\Sigma\theta\big)w\Big)+\mathrm{const}(\theta)." display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><mstyle displaystyle="true"><mfrac><mi>n</mi><msup><mrow><mo stretchy="false">(</mo><mrow><mi>n</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="1.600em" minsize="1.600em">(</mo><mrow><mrow><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mrow><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>n</mi><mo>+</mo><mn>1</mn><mo>+</mo><mi>d</mi></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mi>θ</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi mathvariant="normal">Σ</mi><mo lspace="0em" rspace="0em">​</mo><mi>θ</mi></mrow><mo>+</mo><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>σ</mi><mn>2</mn></msup></mrow></mrow><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mi>w</mi><mn>2</mn></msup></mrow><mo>+</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mrow><mrow><mstyle displaystyle="true"><mfrac><mrow><mi>n</mi><mo>+</mo><mn>3</mn><mo>+</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>d</mi></mrow></mrow><mrow><mi>d</mi><mo>+</mo><mn>4</mn></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>θ</mi><mn>0</mn><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mi mathvariant="normal">Σ</mi><mo lspace="0em" rspace="0em">​</mo><mi>θ</mi></mrow><mo>−</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>n</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mi>θ</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi mathvariant="normal">Σ</mi><mo lspace="0em" rspace="0em">​</mo><mi>θ</mi></mrow></mrow><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>w</mi></mrow></mrow><mo maxsize="1.600em" minsize="1.600em">)</mo></mrow></mrow><mo>+</mo><mrow><mi>const</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>θ</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle=\frac{n}{(n+1)^{2}}\Big(\big((n+1+d)\theta^{\top}\Sigma\theta+d\sigma^{2}\big)w^{2}+2\big(\frac{n+3+2d}{d+4}\theta_{0}^{\top}\Sigma\theta-(n+1)\theta^{\top}\Sigma\theta\big)w\Big)+\mathrm{const}(\theta).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(237)</span></td></tr></tbody>
</table>
<p id="A1.SS3.p7.2" class="ltx_p"><span id="A1.SS3.p7.2.1" class="ltx_text">Since <math id="A1.SS3.p7.m3" class="ltx_Math" alttext="n\in{\mathbb{N}}" display="inline" intent=":literal"><semantics><mrow><mi>n</mi><mo>∈</mo><mi>ℕ</mi></mrow><annotation encoding="application/x-tex">n\in{\mathbb{N}}</annotation></semantics></math> and <math id="A1.SS3.p7.m4" class="ltx_Math" alttext="\sigma^{2}\geq 0" display="inline" intent=":literal"><semantics><mrow><msup><mi>σ</mi><mn>2</mn></msup><mo>≥</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\sigma^{2}\geq 0</annotation></semantics></math>, we have <math id="A1.SS3.p7.m5" class="ltx_Math" alttext="(n+1+d)\theta^{\top}\Sigma\theta+d\sigma^{2}&gt;0" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>n</mi><mo>+</mo><mn>1</mn><mo>+</mo><mi>d</mi></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mi>θ</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi mathvariant="normal">Σ</mi><mo lspace="0em" rspace="0em">​</mo><mi>θ</mi></mrow><mo>+</mo><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>σ</mi><mn>2</mn></msup></mrow></mrow><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">(n+1+d)\theta^{\top}\Sigma\theta+d\sigma^{2}&gt;0</annotation></semantics></math>, and therefore the above is strictly convex in <math id="A1.SS3.p7.m6" class="ltx_Math" alttext="w" display="inline" intent=":literal"><semantics><mi>w</mi><annotation encoding="application/x-tex">w</annotation></semantics></math> and has a unique minimizer given by the first-order condition, which is</span></p>
<table id="A1.EGx70" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A1.E238"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A1.E238.m1" class="ltx_Math" alttext="\displaystyle\big((n+1+d)\theta^{\top}\Sigma\theta+d\sigma^{2}\big)w+\frac{n+3+2d}{d+4}\theta_{0}^{\top}\Sigma\theta-(n+1)\theta^{\top}\Sigma\theta=0" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mrow><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mrow><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>n</mi><mo>+</mo><mn>1</mn><mo>+</mo><mi>d</mi></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mi>θ</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi mathvariant="normal">Σ</mi><mo lspace="0em" rspace="0em">​</mo><mi>θ</mi></mrow><mo>+</mo><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>σ</mi><mn>2</mn></msup></mrow></mrow><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>w</mi></mrow><mo>+</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mi>n</mi><mo>+</mo><mn>3</mn><mo>+</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>d</mi></mrow></mrow><mrow><mi>d</mi><mo>+</mo><mn>4</mn></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>θ</mi><mn>0</mn><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mi mathvariant="normal">Σ</mi><mo lspace="0em" rspace="0em">​</mo><mi>θ</mi></mrow></mrow><mo>−</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>n</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mi>θ</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi mathvariant="normal">Σ</mi><mo lspace="0em" rspace="0em">​</mo><mi>θ</mi></mrow></mrow><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\displaystyle\big((n+1+d)\theta^{\top}\Sigma\theta+d\sigma^{2}\big)w+\frac{n+3+2d}{d+4}\theta_{0}^{\top}\Sigma\theta-(n+1)\theta^{\top}\Sigma\theta=0</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(238)</span></td></tr></tbody>
</table>
<p id="A1.SS3.p7.3" class="ltx_p"><span id="A1.SS3.p7.3.1" class="ltx_text">Therefore,</span></p>
<table id="A1.EGx71" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A1.E239"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A1.E239.m1" class="ltx_Math" alttext="\displaystyle w^{\star}(n;\theta):=\argmin_{w}\,\mathcal{L}_{\mathrm{FS}}\big(\hat{{\mathbf{V}}}(w),\hat{{\mathbf{Q}}},n;\theta\big)=\frac{(n+1)\,\theta^{\top}\Sigma\theta-\frac{n+3+2d}{d+4}\,\theta_{0}^{\top}\Sigma\theta}{(n+1+d)\,\theta^{\top}\Sigma\theta+d\sigma^{2}}." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><msup><mi>w</mi><mo>⋆</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>n</mi><mo>,</mo><mi>θ</mi><mo stretchy="false">)</mo></mrow></mrow><mo>:=</mo><mrow><mrow><msub><mrow><mi>arg</mi><mo lspace="0.170em" rspace="0em">​</mo><mi>min</mi></mrow><mi>w</mi></msub><mo>⁡</mo><msub><mi class="ltx_font_mathcaligraphic">ℒ</mi><mi>FS</mi></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mrow><mover accent="true"><mi>𝐕</mi><mo>^</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>w</mi><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mover accent="true"><mi>𝐐</mi><mo>^</mo></mover><mo>,</mo><mi>n</mi><mo>,</mo><mi>θ</mi><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow></mrow><mo>=</mo><mstyle displaystyle="true"><mfrac><mrow><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>n</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0.170em" rspace="0em">​</mo><msup><mi>θ</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi mathvariant="normal">Σ</mi><mo lspace="0em" rspace="0em">​</mo><mi>θ</mi></mrow><mo>−</mo><mrow><mfrac><mrow><mi>n</mi><mo>+</mo><mn>3</mn><mo>+</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>d</mi></mrow></mrow><mrow><mi>d</mi><mo>+</mo><mn>4</mn></mrow></mfrac><mo lspace="0.170em" rspace="0em">​</mo><msubsup><mi>θ</mi><mn>0</mn><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mi mathvariant="normal">Σ</mi><mo lspace="0em" rspace="0em">​</mo><mi>θ</mi></mrow></mrow><mrow><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>n</mi><mo>+</mo><mn>1</mn><mo>+</mo><mi>d</mi></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0.170em" rspace="0em">​</mo><msup><mi>θ</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi mathvariant="normal">Σ</mi><mo lspace="0em" rspace="0em">​</mo><mi>θ</mi></mrow><mo>+</mo><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>σ</mi><mn>2</mn></msup></mrow></mrow></mfrac></mstyle></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle w^{\star}(n;\theta):=\argmin_{w}\,\mathcal{L}_{\mathrm{FS}}\big(\hat{{\mathbf{V}}}(w),\hat{{\mathbf{Q}}},n;\theta\big)=\frac{(n+1)\,\theta^{\top}\Sigma\theta-\frac{n+3+2d}{d+4}\,\theta_{0}^{\top}\Sigma\theta}{(n+1+d)\,\theta^{\top}\Sigma\theta+d\sigma^{2}}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(239)</span></td></tr></tbody>
</table>
</div>
<div id="A1.SS3.p8" class="ltx_para">
<p id="A1.SS3.p8.1" class="ltx_p"><span id="A1.SS3.p8.1.1" class="ltx_text">Next, taking expectation over <math id="A1.SS3.p8.m1" class="ltx_Math" alttext="{\mathbf{\theta}}" display="inline" intent=":literal"><semantics><mi>θ</mi><annotation encoding="application/x-tex">{\mathbf{\theta}}</annotation></semantics></math>, we obtain</span></p>
<table id="A1.EGx72" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A1.E240"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.E240.m1" class="ltx_Math" alttext="\displaystyle\displaystyle\mathbb{E}_{{\mathbf{\theta}}}\left[\displaystyle\mathbb{E}_{{\mathbf{Z}}_{[n]},{\mathbf{x}},y|{\mathbf{\theta}}}\left[\big(\hat{y}_{\mathrm{FS}}({\mathbf{Z}}_{[n]},{\mathbf{x}};\hat{{\mathbf{V}}}(w),\hat{{\mathbf{Q}}})-y\big)^{2}\right]\right]" display="inline" intent=":literal"><semantics><mrow><msub><mi>𝔼</mi><mi>θ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><mrow><msub><mi>𝔼</mi><mrow><msub><mi>𝐙</mi><mrow><mo stretchy="false">[</mo><mi>n</mi><mo stretchy="false">]</mo></mrow></msub><mo>,</mo><mi>𝐱</mi><mo>,</mo><mrow><mi>y</mi><mo fence="false">|</mo><mi>θ</mi></mrow></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><msup><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mrow><mrow><msub><mover accent="true"><mi>y</mi><mo>^</mo></mover><mi>FS</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐙</mi><mrow><mo stretchy="false">[</mo><mi>n</mi><mo stretchy="false">]</mo></mrow></msub><mo>,</mo><mi>𝐱</mi><mo>,</mo><mrow><mover accent="true"><mi>𝐕</mi><mo>^</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>w</mi><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mover accent="true"><mi>𝐐</mi><mo>^</mo></mover><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mi>y</mi></mrow><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow><mn>2</mn></msup><mo>]</mo></mrow></mrow><mo>]</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\displaystyle\mathbb{E}_{{\mathbf{\theta}}}\left[\displaystyle\mathbb{E}_{{\mathbf{Z}}_{[n]},{\mathbf{x}},y|{\mathbf{\theta}}}\left[\big(\hat{y}_{\mathrm{FS}}({\mathbf{Z}}_{[n]},{\mathbf{x}};\hat{{\mathbf{V}}}(w),\hat{{\mathbf{Q}}})-y\big)^{2}\right]\right]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(240)</span></td></tr></tbody>
<tbody id="A1.E241"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.E241.m1" class="ltx_Math" alttext="\displaystyle=\frac{n}{(n+1)^{2}}\Big(\big((n+1+d)\tr({\mathbf{\Sigma}})+d\sigma^{2}\big)w^{2}-2(n+1)\tr({\mathbf{\Sigma}})w\Big)+\mathrm{const}(\theta)," display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><mstyle displaystyle="true"><mfrac><mi>n</mi><msup><mrow><mo stretchy="false">(</mo><mrow><mi>n</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="1.600em" minsize="1.600em">(</mo><mrow><mrow><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mrow><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>n</mi><mo>+</mo><mn>1</mn><mo>+</mo><mi>d</mi></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>tr</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝚺</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>+</mo><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>σ</mi><mn>2</mn></msup></mrow></mrow><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mi>w</mi><mn>2</mn></msup></mrow><mo>−</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>n</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>tr</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝚺</mi><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><mi>w</mi></mrow></mrow><mo maxsize="1.600em" minsize="1.600em">)</mo></mrow></mrow><mo>+</mo><mrow><mi>const</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>θ</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle=\frac{n}{(n+1)^{2}}\Big(\big((n+1+d)\tr({\mathbf{\Sigma}})+d\sigma^{2}\big)w^{2}-2(n+1)\tr({\mathbf{\Sigma}})w\Big)+\mathrm{const}(\theta),</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(241)</span></td></tr></tbody>
</table>
<p id="A1.SS3.p8.2" class="ltx_p"><span id="A1.SS3.p8.2.1" class="ltx_text">and hence</span></p>
<table id="A1.EGx73" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A1.E242"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A1.E242.m1" class="ltx_Math" alttext="\displaystyle w^{\star}(n):=\argmin_{w}\,\displaystyle\mathbb{E}_{{\mathbf{\theta}}}\left[\mathcal{L}_{\mathrm{FS}}\big(\hat{{\mathbf{V}}}(w),\hat{{\mathbf{Q}}},n;\theta\big)\right]=\frac{(n+1)\tr({\mathbf{\Sigma}})}{(n+1+d)\tr({\mathbf{\Sigma}})+d\sigma^{2}}." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><msup><mi>w</mi><mo>⋆</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>n</mi><mo stretchy="false">)</mo></mrow></mrow><mo>:=</mo><mrow><mrow><msub><mrow><mi>arg</mi><mo lspace="0.170em" rspace="0em">​</mo><mi>min</mi></mrow><mi>w</mi></msub><mo>⁡</mo><msub><mi>𝔼</mi><mi>θ</mi></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><mrow><msub><mi class="ltx_font_mathcaligraphic">ℒ</mi><mi>FS</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mrow><mover accent="true"><mi>𝐕</mi><mo>^</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>w</mi><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mover accent="true"><mi>𝐐</mi><mo>^</mo></mover><mo>,</mo><mi>n</mi><mo>,</mo><mi>θ</mi><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow></mrow><mo>]</mo></mrow></mrow><mo>=</mo><mstyle displaystyle="true"><mfrac><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>n</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>tr</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝚺</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mrow><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>n</mi><mo>+</mo><mn>1</mn><mo>+</mo><mi>d</mi></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>tr</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝚺</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>+</mo><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>σ</mi><mn>2</mn></msup></mrow></mrow></mfrac></mstyle></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle w^{\star}(n):=\argmin_{w}\,\displaystyle\mathbb{E}_{{\mathbf{\theta}}}\left[\mathcal{L}_{\mathrm{FS}}\big(\hat{{\mathbf{V}}}(w),\hat{{\mathbf{Q}}},n;\theta\big)\right]=\frac{(n+1)\tr({\mathbf{\Sigma}})}{(n+1+d)\tr({\mathbf{\Sigma}})+d\sigma^{2}}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(242)</span></td></tr></tbody>
</table>
<p id="A1.SS3.p8.3" class="ltx_p"><span id="A1.SS3.p8.3.1" class="ltx_text">The stated limits follow from (<a href="#A1.E222" title="Equation 222 ‣ Theorem A.9 (Optimal Parameters and Test Error of Value-Matrix Fine-Tuned Models). ‣ A.3 Proofs for Optimal Parameters ‣ Appendix A Proofs ‣ Fine-Tuning Without Forgetting In-Context Learning:A Theoretical Analysis of Linear Attention Models" class="ltx_ref"><span class="ltx_text ltx_ref_tag">222</span></a>) in Theorem <a href="#A1.Thmtheorem9" title="Theorem A.9 (Optimal Parameters and Test Error of Value-Matrix Fine-Tuned Models). ‣ A.3 Proofs for Optimal Parameters ‣ Appendix A Proofs ‣ Fine-Tuning Without Forgetting In-Context Learning:A Theoretical Analysis of Linear Attention Models" class="ltx_ref"><span class="ltx_text ltx_ref_tag">A.9</span></a> by letting <math id="A1.SS3.p8.m2" class="ltx_Math" alttext="n\to\infty" display="inline" intent=":literal"><semantics><mrow><mi>n</mi><mo stretchy="false">→</mo><mi mathvariant="normal">∞</mi></mrow><annotation encoding="application/x-tex">n\to\infty</annotation></semantics></math>.
∎</span></p>
</div>
</div>
<div id="A1.Thmtheorem12" class="ltx_theorem ltx_theorem_proposition">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="A1.Thmtheorem12.2" class="ltx_text ltx_font_bold">Proposition A.12</span></span><span id="A1.Thmtheorem12.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="A1.Thmtheorem12.p1" class="ltx_para">
<p id="A1.Thmtheorem12.p1.1" class="ltx_p"><span id="A1.Thmtheorem12.p1.1.1" class="ltx_text ltx_font_italic">Assume <math id="A1.Thmtheorem12.p1.m1" class="ltx_Math" alttext="{\mathbf{\Sigma}}={\mathbf{I}}_{d}" display="inline" intent=":literal"><semantics><mrow><mi>𝚺</mi><mo>=</mo><msub><mi>𝐈</mi><mi>d</mi></msub></mrow><annotation encoding="application/x-tex">{\mathbf{\Sigma}}={\mathbf{I}}_{d}</annotation></semantics></math>, and let <math id="A1.Thmtheorem12.p1.m2" class="ltx_Math" alttext="\hat{{\mathbf{V}}}" display="inline" intent=":literal"><semantics><mover accent="true"><mi>𝐕</mi><mo>^</mo></mover><annotation encoding="application/x-tex">\hat{{\mathbf{V}}}</annotation></semantics></math> and <math id="A1.Thmtheorem12.p1.m3" class="ltx_Math" alttext="\hat{{\mathbf{Q}}}" display="inline" intent=":literal"><semantics><mover accent="true"><mi>𝐐</mi><mo>^</mo></mover><annotation encoding="application/x-tex">\hat{{\mathbf{Q}}}</annotation></semantics></math> be the parameters in (<a href="#S4.E10" title="Equation 10 ‣ Corollary 4.1 (Optimal Parameters of Pretrained Models; Corollary of Theorem 1 in ( ) ). ‣ 4.1 Pretraining ‣ 4 Optimal Parameters and Test Error of Learned Linear Attention Models ‣ Fine-Tuning Without Forgetting In-Context Learning:A Theoretical Analysis of Linear Attention Models" class="ltx_ref"><span class="ltx_text ltx_ref_tag">10</span></a>) which minimize the loss <math id="A1.Thmtheorem12.p1.m4" class="ltx_Math" alttext="\mathcal{L}({\mathbf{V}},{\mathbf{Q}})" display="inline" intent=":literal"><semantics><mrow><mi class="ltx_font_mathcaligraphic">ℒ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝐕</mi><mo>,</mo><mi>𝐐</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathcal{L}({\mathbf{V}},{\mathbf{Q}})</annotation></semantics></math> in (<a href="#S3.E8" title="Equation 8 ‣ Evaluation Metric and Training Objective. ‣ 3 Problem Setup ‣ Fine-Tuning Without Forgetting In-Context Learning:A Theoretical Analysis of Linear Attention Models" class="ltx_ref"><span class="ltx_text ltx_ref_tag">8</span></a>).
Given a target task <math id="A1.Thmtheorem12.p1.m5" class="ltx_Math" alttext="{\mathbf{\theta}}_{0}\in\mathbb{R}^{d}" display="inline" intent=":literal"><semantics><mrow><msub><mi>θ</mi><mn>0</mn></msub><mo>∈</mo><msup><mi>ℝ</mi><mi>d</mi></msup></mrow><annotation encoding="application/x-tex">{\mathbf{\theta}}_{0}\in\mathbb{R}^{d}</annotation></semantics></math>, consider <math id="A1.Thmtheorem12.p1.m6" class="ltx_Math" alttext="\hat{{\mathbf{V}}}(w)" display="inline" intent=":literal"><semantics><mrow><mover accent="true"><mi>𝐕</mi><mo>^</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>w</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\hat{{\mathbf{V}}}(w)</annotation></semantics></math> in (<a href="#S4.E21" title="Equation 21 ‣ Theorem 4.6 (Optimal Parameters and Test Error of Value-Matrix Fine-Tuned Models). ‣ 4.3 Fine-Tuning Value Matrix with Zero-Shot Loss ‣ 4 Optimal Parameters and Test Error of Learned Linear Attention Models ‣ Fine-Tuning Without Forgetting In-Context Learning:A Theoretical Analysis of Linear Attention Models" class="ltx_ref"><span class="ltx_text ltx_ref_tag">21</span></a>).
Then</span></p>
<table id="A1.EGx74" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A1.E243"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.E243.m1" class="ltx_Math" alttext="\displaystyle\hat{{\mathbf{V}}}\left(\tfrac{m}{m+1+d}\right)=\argmin\Big\{\|{\mathbf{V}}-\hat{{\mathbf{V}}}\|_{\mathrm{F}}^{2}\Big|{\mathbf{V}}\in\argmin_{{\mathbf{V}}}\mathcal{L}_{\mathrm{ZS}}({\mathbf{V}},\hat{{\mathbf{Q}}};{\mathbf{\theta}}_{0})\Big\}," display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mover accent="true"><mi>𝐕</mi><mo>^</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mfrac><mi>m</mi><mrow><mi>m</mi><mo>+</mo><mn>1</mn><mo>+</mo><mi>d</mi></mrow></mfrac><mo>)</mo></mrow></mrow><mo>=</mo><mrow><mrow><mi>arg</mi><mo lspace="0.170em" rspace="0em">​</mo><mi>min</mi></mrow><mo>⁡</mo><mrow><mo stretchy="false">{</mo><msubsup><mrow><mo stretchy="false">‖</mo><mrow><mi>𝐕</mi><mo>−</mo><mover accent="true"><mi>𝐕</mi><mo>^</mo></mover></mrow><mo stretchy="false">‖</mo></mrow><mi>F</mi><mn>2</mn></msubsup><mo lspace="0em" mathsize="1.600em" rspace="0em">|</mo><mrow><mi>𝐕</mi><mo>∈</mo><mrow><mrow><msub><mrow><mi>arg</mi><mo lspace="0.170em" rspace="0em">​</mo><mi>min</mi></mrow><mi>𝐕</mi></msub><mo>⁡</mo><msub><mi class="ltx_font_mathcaligraphic">ℒ</mi><mi>ZS</mi></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐕</mi><mo>,</mo><mover accent="true"><mi>𝐐</mi><mo>^</mo></mover><mo>,</mo><msub><mi>θ</mi><mn>0</mn></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">}</mo></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\hat{{\mathbf{V}}}\left(\tfrac{m}{m+1+d}\right)=\argmin\Big\{\|{\mathbf{V}}-\hat{{\mathbf{V}}}\|_{\mathrm{F}}^{2}\Big|{\mathbf{V}}\in\argmin_{{\mathbf{V}}}\mathcal{L}_{\mathrm{ZS}}({\mathbf{V}},\hat{{\mathbf{Q}}};{\mathbf{\theta}}_{0})\Big\},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(243)</span></td></tr></tbody>
</table>
<p id="A1.Thmtheorem12.p1.2" class="ltx_p"><span id="A1.Thmtheorem12.p1.2.1" class="ltx_text ltx_font_italic">where <math id="A1.Thmtheorem12.p1.m7" class="ltx_Math" alttext="\left\lVert\cdot\right\rVert_{\mathrm{F}}" display="inline" intent=":literal"><semantics><msub><mrow><mo>‖</mo><mo lspace="0em" rspace="0em">⋅</mo><mo>‖</mo></mrow><mi mathvariant="normal">F</mi></msub><annotation encoding="application/x-tex">\left\lVert\cdot\right\rVert_{\mathrm{F}}</annotation></semantics></math> denotes the Frobenius norm.</span></p>
</div>
<div id="A1.Thmtheorem12.p2" class="ltx_para">
<p id="A1.Thmtheorem12.p2.1" class="ltx_p"><span id="A1.Thmtheorem12.p2.1.1" class="ltx_text ltx_font_italic">Moreover, if <math id="A1.Thmtheorem12.p2.m1" class="ltx_Math" alttext="m=n" display="inline" intent=":literal"><semantics><mrow><mi>m</mi><mo>=</mo><mi>n</mi></mrow><annotation encoding="application/x-tex">m=n</annotation></semantics></math>, then for sufficiently large <math id="A1.Thmtheorem12.p2.m2" class="ltx_Math" alttext="n+d" display="inline" intent=":literal"><semantics><mrow><mi>n</mi><mo>+</mo><mi>d</mi></mrow><annotation encoding="application/x-tex">n+d</annotation></semantics></math>, the choice <math id="A1.Thmtheorem12.p2.m3" class="ltx_Math" alttext="w=\frac{m}{m+1+d}" display="inline" intent=":literal"><semantics><mrow><mi>w</mi><mo>=</mo><mfrac><mi>m</mi><mrow><mi>m</mi><mo>+</mo><mn>1</mn><mo>+</mo><mi>d</mi></mrow></mfrac></mrow><annotation encoding="application/x-tex">w=\frac{m}{m+1+d}</annotation></semantics></math> closely approximates the task-averaged optimum <math id="A1.Thmtheorem12.p2.m4" class="ltx_Math" alttext="w^{\star}(n)" display="inline" intent=":literal"><semantics><mrow><msup><mi>w</mi><mo>⋆</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>n</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">w^{\star}(n)</annotation></semantics></math>, defined in Corollary <a href="#A1.Thmtheorem10" title="Theorem A.10 (Task-Wise Optimal 𝑤). ‣ A.3 Proofs for Optimal Parameters ‣ Appendix A Proofs ‣ Fine-Tuning Without Forgetting In-Context Learning:A Theoretical Analysis of Linear Attention Models" class="ltx_ref"><span class="ltx_text ltx_ref_tag">A.10</span></a>.</span></p>
</div>
</div>
<div id="A1.SS3.6" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="A1.SS3.p9" class="ltx_para">
<p id="A1.SS3.p9.1" class="ltx_p"><span id="A1.SS3.p9.1.1" class="ltx_text">Since <math id="A1.SS3.p9.m1" class="ltx_Math" alttext="{\mathbf{\Sigma}}={\mathbf{I}}_{d}" display="inline" intent=":literal"><semantics><mrow><mi>𝚺</mi><mo>=</mo><msub><mi>𝐈</mi><mi>d</mi></msub></mrow><annotation encoding="application/x-tex">{\mathbf{\Sigma}}={\mathbf{I}}_{d}</annotation></semantics></math>, the parameters in (<a href="#A1.E206" title="Equation 206 ‣ Corollary A.7 (Optimal Parameters of Pretrained Models; Corollary of Theorem 1 in ( ) ). ‣ A.3 Proofs for Optimal Parameters ‣ Appendix A Proofs ‣ Fine-Tuning Without Forgetting In-Context Learning:A Theoretical Analysis of Linear Attention Models" class="ltx_ref"><span class="ltx_text ltx_ref_tag">206</span></a>) reduce to</span></p>
<table id="A1.E244" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A1.E244.m1" class="ltx_Math" alttext="\hat{{\mathbf{V}}}=\begin{bmatrix}0&{\mathbf{0}}_{d}^{\top}&amp;0\\
{\mathbf{0}}_{d}&{\mathbf{0}}_{d}{\mathbf{0}}_{d}^{\top}&{\mathbf{0}}_{d}\\
0&{\mathbf{0}}_{d}^{\top}&amp;\frac{m}{m+1+d}\end{bmatrix},\qquad\hat{{\mathbf{Q}}}=\begin{bmatrix}0&{\mathbf{0}}_{d}^{\top}&amp;0\\
{\mathbf{0}}_{d}&{\mathbf{I}}_{d}&{\mathbf{0}}_{d}\\
0&{\mathbf{0}}_{d}^{\top}&amp;0\end{bmatrix}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mover accent="true"><mi>𝐕</mi><mo>^</mo></mover><mo>=</mo><mrow><mo>[</mo><mtable columnspacing="5pt" displaystyle="true" rowspacing="0pt"><mtr><mtd><mn>0</mn></mtd><mtd><msubsup><mn>𝟎</mn><mi>d</mi><mo>⊤</mo></msubsup></mtd><mtd><mn>0</mn></mtd></mtr><mtr><mtd><msub><mn>𝟎</mn><mi>d</mi></msub></mtd><mtd><mrow><msub><mn>𝟎</mn><mi>d</mi></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mn>𝟎</mn><mi>d</mi><mo>⊤</mo></msubsup></mrow></mtd><mtd><msub><mn>𝟎</mn><mi>d</mi></msub></mtd></mtr><mtr><mtd><mn>0</mn></mtd><mtd><msubsup><mn>𝟎</mn><mi>d</mi><mo>⊤</mo></msubsup></mtd><mtd><mstyle displaystyle="false"><mfrac><mi>m</mi><mrow><mi>m</mi><mo>+</mo><mn>1</mn><mo>+</mo><mi>d</mi></mrow></mfrac></mstyle></mtd></mtr></mtable><mo>]</mo></mrow></mrow><mo rspace="2.167em">,</mo><mrow><mover accent="true"><mi>𝐐</mi><mo>^</mo></mover><mo>=</mo><mrow><mo>[</mo><mtable columnspacing="5pt" displaystyle="true" rowspacing="0pt"><mtr><mtd><mn>0</mn></mtd><mtd><msubsup><mn>𝟎</mn><mi>d</mi><mo>⊤</mo></msubsup></mtd><mtd><mn>0</mn></mtd></mtr><mtr><mtd><msub><mn>𝟎</mn><mi>d</mi></msub></mtd><mtd><msub><mi>𝐈</mi><mi>d</mi></msub></mtd><mtd><msub><mn>𝟎</mn><mi>d</mi></msub></mtd></mtr><mtr><mtd><mn>0</mn></mtd><mtd><msubsup><mn>𝟎</mn><mi>d</mi><mo>⊤</mo></msubsup></mtd><mtd><mn>0</mn></mtd></mtr></mtable><mo>]</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\hat{{\mathbf{V}}}=\begin{bmatrix}0&amp;{\mathbf{0}}_{d}^{\top}&amp;0\\
{\mathbf{0}}_{d}&amp;{\mathbf{0}}_{d}{\mathbf{0}}_{d}^{\top}&amp;{\mathbf{0}}_{d}\\
0&amp;{\mathbf{0}}_{d}^{\top}&amp;\frac{m}{m+1+d}\end{bmatrix},\qquad\hat{{\mathbf{Q}}}=\begin{bmatrix}0&amp;{\mathbf{0}}_{d}^{\top}&amp;0\\
{\mathbf{0}}_{d}&amp;{\mathbf{I}}_{d}&amp;{\mathbf{0}}_{d}\\
0&amp;{\mathbf{0}}_{d}^{\top}&amp;0\end{bmatrix}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(244)</span></td></tr></tbody>
</table>
<p id="A1.SS3.p9.2" class="ltx_p"><span id="A1.SS3.p9.2.1" class="ltx_text">By Theorem <a href="#A1.Thmtheorem9" title="Theorem A.9 (Optimal Parameters and Test Error of Value-Matrix Fine-Tuned Models). ‣ A.3 Proofs for Optimal Parameters ‣ Appendix A Proofs ‣ Fine-Tuning Without Forgetting In-Context Learning:A Theoretical Analysis of Linear Attention Models" class="ltx_ref"><span class="ltx_text ltx_ref_tag">A.9</span></a>, we have</span></p>
<table id="A1.EGx75" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A1.E245"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A1.E245.m1" class="ltx_math_unparsed" alttext="\displaystyle{\mathbb{S}}:=\left\{\begin{bmatrix}0&{\mathbf{0}}_{d}^{\top}&amp;0\\
{\mathbf{0}}_{d}&{\mathbf{V}}_{11}&{\mathbf{v}}_{12}\\
0&amp;\frac{1}{d+4}{\mathbf{\theta}}_{0}^{\top}&amp;w\end{bmatrix}\middle|{\mathbf{V}}_{11}\in{\mathbb{R}}^{d\times d},{\mathbf{v}}_{12}\in{\mathbb{R}}^{d},w\neq 0\right\}=\argmin_{{\mathbf{V}}}\displaystyle\mathbb{E}_{{\mathbf{x}},y\mid{\mathbf{\theta}}_{0}}\left[\big(\hat{y}_{\mathrm{ZS}}({\mathbf{x}};{\mathbf{V}},\hat{{\mathbf{Q}}})-y\big)^{2}\right]." display="inline" intent=":literal"><semantics><mrow><mi>𝕊</mi><mo>:=</mo><mrow><mo>{</mo><mrow><mo>[</mo><mtable columnspacing="5pt" rowspacing="0pt"><mtr><mtd><mn>0</mn></mtd><mtd><msubsup><mn>𝟎</mn><mi>d</mi><mo>⊤</mo></msubsup></mtd><mtd><mn>0</mn></mtd></mtr><mtr><mtd><msub><mn>𝟎</mn><mi>d</mi></msub></mtd><mtd><msub><mi>𝐕</mi><mn>11</mn></msub></mtd><mtd><msub><mi>𝐯</mi><mn>12</mn></msub></mtd></mtr><mtr><mtd><mn>0</mn></mtd><mtd><mrow><mfrac><mn>1</mn><mrow><mi>d</mi><mo>+</mo><mn>4</mn></mrow></mfrac><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>θ</mi><mn>0</mn><mo>⊤</mo></msubsup></mrow></mtd><mtd><mi>w</mi></mtd></mtr></mtable><mo>]</mo></mrow><mo lspace="0em" rspace="0em" stretchy="true">|</mo><msub><mi>𝐕</mi><mn>11</mn></msub><mo>∈</mo><msup><mi>ℝ</mi><mrow><mi>d</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>d</mi></mrow></msup><mo>,</mo><msub><mi>𝐯</mi><mn>12</mn></msub><mo>∈</mo><msup><mi>ℝ</mi><mi>d</mi></msup><mo>,</mo><mi>w</mi><mo>≠</mo><mn>0</mn><mo>}</mo></mrow><mo>=</mo><msub><mrow><mi>arg</mi><mo lspace="0.170em" rspace="0em">​</mo><mi>min</mi></mrow><mi>𝐕</mi></msub><msub><mi>𝔼</mi><mrow><mi>𝐱</mi><mo>,</mo><mrow><mi>y</mi><mo fence="false">|</mo><msub><mi>θ</mi><mn>0</mn></msub></mrow></mrow></msub><mrow><mo>[</mo><msup><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><msub><mover accent="true"><mi>y</mi><mo>^</mo></mover><mi>ZS</mi></msub><mrow><mo stretchy="false">(</mo><mi>𝐱</mi><mo>;</mo><mi>𝐕</mi><mo>,</mo><mover accent="true"><mi>𝐐</mi><mo>^</mo></mover><mo stretchy="false">)</mo></mrow><mo>−</mo><mi>y</mi><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow><mn>2</mn></msup><mo>]</mo></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle{\mathbb{S}}:=\left\{\begin{bmatrix}0&amp;{\mathbf{0}}_{d}^{\top}&amp;0\\
{\mathbf{0}}_{d}&amp;{\mathbf{V}}_{11}&amp;{\mathbf{v}}_{12}\\
0&amp;\frac{1}{d+4}{\mathbf{\theta}}_{0}^{\top}&amp;w\end{bmatrix}\middle|{\mathbf{V}}_{11}\in{\mathbb{R}}^{d\times d},{\mathbf{v}}_{12}\in{\mathbb{R}}^{d},w\neq 0\right\}=\argmin_{{\mathbf{V}}}\displaystyle\mathbb{E}_{{\mathbf{x}},y\mid{\mathbf{\theta}}_{0}}\left[\big(\hat{y}_{\mathrm{ZS}}({\mathbf{x}};{\mathbf{V}},\hat{{\mathbf{Q}}})-y\big)^{2}\right].</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(245)</span></td></tr></tbody>
</table>
<p id="A1.SS3.p9.3" class="ltx_p"><span id="A1.SS3.p9.3.1" class="ltx_text">For any <math id="A1.SS3.p9.m2" class="ltx_Math" alttext="{\mathbf{V}}\in\mathcal{S}" display="inline" intent=":literal"><semantics><mrow><mi>𝐕</mi><mo>∈</mo><mi class="ltx_font_mathcaligraphic">𝒮</mi></mrow><annotation encoding="application/x-tex">{\mathbf{V}}\in\mathcal{S}</annotation></semantics></math>,</span></p>
<table id="A1.EGx76" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A1.E246"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A1.E246.m1" class="ltx_Math" alttext="\displaystyle\big\|{\mathbf{V}}-\hat{{\mathbf{V}}}\big\|_{\mathrm{F}}^{2}=\left\lVert{\mathbf{V}}_{11}\right\rVert_{\mathrm{F}}+\left\lVert{\mathbf{v}}_{12}\right\rVert_{\mathrm{F}}+\frac{1}{d+4}\left\lVert{\mathbf{\theta}}_{0}\right\rVert_{\mathrm{F}}+\left(w-\frac{m}{m+1+d}\right)^{2}." display="inline" intent=":literal"><semantics><mrow><mrow><msubsup><mrow><mo maxsize="1.200em" minsize="1.200em" stretchy="true">‖</mo><mrow><mi>𝐕</mi><mo>−</mo><mover accent="true"><mi>𝐕</mi><mo>^</mo></mover></mrow><mo maxsize="1.200em" minsize="1.200em" stretchy="true">‖</mo></mrow><mi>F</mi><mn>2</mn></msubsup><mo>=</mo><mrow><msub><mrow><mo>‖</mo><msub><mi>𝐕</mi><mn>11</mn></msub><mo>‖</mo></mrow><mi>F</mi></msub><mo>+</mo><msub><mrow><mo>‖</mo><msub><mi>𝐯</mi><mn>12</mn></msub><mo>‖</mo></mrow><mi>F</mi></msub><mo>+</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mrow><mi>d</mi><mo>+</mo><mn>4</mn></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo>‖</mo><msub><mi>θ</mi><mn>0</mn></msub><mo>‖</mo></mrow><mi>F</mi></msub></mrow><mo>+</mo><msup><mrow><mo>(</mo><mrow><mi>w</mi><mo>−</mo><mstyle displaystyle="true"><mfrac><mi>m</mi><mrow><mi>m</mi><mo>+</mo><mn>1</mn><mo>+</mo><mi>d</mi></mrow></mfrac></mstyle></mrow><mo>)</mo></mrow><mn>2</mn></msup></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\big\|{\mathbf{V}}-\hat{{\mathbf{V}}}\big\|_{\mathrm{F}}^{2}=\left\lVert{\mathbf{V}}_{11}\right\rVert_{\mathrm{F}}+\left\lVert{\mathbf{v}}_{12}\right\rVert_{\mathrm{F}}+\frac{1}{d+4}\left\lVert{\mathbf{\theta}}_{0}\right\rVert_{\mathrm{F}}+\left(w-\frac{m}{m+1+d}\right)^{2}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(246)</span></td></tr></tbody>
</table>
<p id="A1.SS3.p9.4" class="ltx_p"><span id="A1.SS3.p9.4.1" class="ltx_text">Therefore, the expression is minimized by <math id="A1.SS3.p9.m3" class="ltx_Math" alttext="{\mathbf{V}}_{11}={\mathbf{0}}_{d}{\mathbf{0}}_{d}^{\top}" display="inline" intent=":literal"><semantics><mrow><msub><mi>𝐕</mi><mn>11</mn></msub><mo>=</mo><mrow><msub><mn>𝟎</mn><mi>d</mi></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mn>𝟎</mn><mi>d</mi><mo>⊤</mo></msubsup></mrow></mrow><annotation encoding="application/x-tex">{\mathbf{V}}_{11}={\mathbf{0}}_{d}{\mathbf{0}}_{d}^{\top}</annotation></semantics></math>, <math id="A1.SS3.p9.m4" class="ltx_Math" alttext="{\mathbf{v}}_{12}={\mathbf{0}}_{d}" display="inline" intent=":literal"><semantics><mrow><msub><mi>𝐯</mi><mn>12</mn></msub><mo>=</mo><msub><mn>𝟎</mn><mi>d</mi></msub></mrow><annotation encoding="application/x-tex">{\mathbf{v}}_{12}={\mathbf{0}}_{d}</annotation></semantics></math>, and <math id="A1.SS3.p9.m5" class="ltx_Math" alttext="w=\frac{m}{m+1+d}" display="inline" intent=":literal"><semantics><mrow><mi>w</mi><mo>=</mo><mfrac><mi>m</mi><mrow><mi>m</mi><mo>+</mo><mn>1</mn><mo>+</mo><mi>d</mi></mrow></mfrac></mrow><annotation encoding="application/x-tex">w=\frac{m}{m+1+d}</annotation></semantics></math>, yielding the minimizer <math id="A1.SS3.p9.m6" class="ltx_Math" alttext="\hat{{\mathbf{V}}}\big(\frac{m}{m+1+d}\big)" display="inline" intent=":literal"><semantics><mrow><mover accent="true"><mi>𝐕</mi><mo>^</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mfrac><mi>m</mi><mrow><mi>m</mi><mo>+</mo><mn>1</mn><mo>+</mo><mi>d</mi></mrow></mfrac><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow></mrow><annotation encoding="application/x-tex">\hat{{\mathbf{V}}}\big(\frac{m}{m+1+d}\big)</annotation></semantics></math>.</span></p>
</div>
<div id="A1.SS3.p10" class="ltx_para">
<p id="A1.SS3.p10.1" class="ltx_p"><span id="A1.SS3.p10.1.1" class="ltx_text">Note that under <math id="A1.SS3.p10.m1" class="ltx_Math" alttext="{\mathbf{\Sigma}}={\mathbf{I}}_{d}" display="inline" intent=":literal"><semantics><mrow><mi>𝚺</mi><mo>=</mo><msub><mi>𝐈</mi><mi>d</mi></msub></mrow><annotation encoding="application/x-tex">{\mathbf{\Sigma}}={\mathbf{I}}_{d}</annotation></semantics></math> we have <math id="A1.SS3.p10.m2" class="ltx_Math" alttext="w^{\star}(n)=\frac{n+1}{n+1+d+\sigma^{2}}" display="inline" intent=":literal"><semantics><mrow><mrow><msup><mi>w</mi><mo>⋆</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>n</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mfrac><mrow><mi>n</mi><mo>+</mo><mn>1</mn></mrow><mrow><mi>n</mi><mo>+</mo><mn>1</mn><mo>+</mo><mi>d</mi><mo>+</mo><msup><mi>σ</mi><mn>2</mn></msup></mrow></mfrac></mrow><annotation encoding="application/x-tex">w^{\star}(n)=\frac{n+1}{n+1+d+\sigma^{2}}</annotation></semantics></math>. Thus, if <math id="A1.SS3.p10.m3" class="ltx_Math" alttext="m=n" display="inline" intent=":literal"><semantics><mrow><mi>m</mi><mo>=</mo><mi>n</mi></mrow><annotation encoding="application/x-tex">m=n</annotation></semantics></math>, then</span></p>
<table id="A1.EGx77" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A1.E247"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A1.E247.m1" class="ltx_Math" alttext="\displaystyle w^{\star}(n)-\frac{m}{m+1+d}" display="inline" intent=":literal"><semantics><mrow><mrow><msup><mi>w</mi><mo>⋆</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>n</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mstyle displaystyle="true"><mfrac><mi>m</mi><mrow><mi>m</mi><mo>+</mo><mn>1</mn><mo>+</mo><mi>d</mi></mrow></mfrac></mstyle></mrow><annotation encoding="application/x-tex">\displaystyle w^{\star}(n)-\frac{m}{m+1+d}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.E247.m2" class="ltx_Math" alttext="\displaystyle=\frac{n+1}{n+1+d+\sigma^{2}}-\frac{n}{n+1+d}=\frac{n-n\sigma^{2}+1+d}{(n+1+d)(n+1+d+\sigma^{2})}." display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>=</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mi>n</mi><mo>+</mo><mn>1</mn></mrow><mrow><mi>n</mi><mo>+</mo><mn>1</mn><mo>+</mo><mi>d</mi><mo>+</mo><msup><mi>σ</mi><mn>2</mn></msup></mrow></mfrac></mstyle><mo>−</mo><mstyle displaystyle="true"><mfrac><mi>n</mi><mrow><mi>n</mi><mo>+</mo><mn>1</mn><mo>+</mo><mi>d</mi></mrow></mfrac></mstyle></mrow><mo>=</mo><mstyle displaystyle="true"><mfrac><mrow><mrow><mi>n</mi><mo>−</mo><mrow><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>σ</mi><mn>2</mn></msup></mrow></mrow><mo>+</mo><mn>1</mn><mo>+</mo><mi>d</mi></mrow><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>n</mi><mo>+</mo><mn>1</mn><mo>+</mo><mi>d</mi></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>n</mi><mo>+</mo><mn>1</mn><mo>+</mo><mi>d</mi><mo>+</mo><msup><mi>σ</mi><mn>2</mn></msup></mrow><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle=\frac{n+1}{n+1+d+\sigma^{2}}-\frac{n}{n+1+d}=\frac{n-n\sigma^{2}+1+d}{(n+1+d)(n+1+d+\sigma^{2})}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(247)</span></td></tr></tbody>
</table>
<p id="A1.SS3.p10.2" class="ltx_p"><span id="A1.SS3.p10.2.1" class="ltx_text">This difference becomes small when <math id="A1.SS3.p10.m4" class="ltx_Math" alttext="n+d" display="inline" intent=":literal"><semantics><mrow><mi>n</mi><mo>+</mo><mi>d</mi></mrow><annotation encoding="application/x-tex">n+d</annotation></semantics></math> is sufficiently large.
∎</span></p>
</div>
</div>
<div class="ltx_pagination ltx_role_newpage"></div>
<div class="ltx_pagination ltx_role_newpage"></div>
</section>
<section id="A1.SS4" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">A.4 </span>Proofs for Test Errors</h3>

<div id="A1.Thmtheorem13" class="ltx_theorem ltx_theorem_theorem">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="A1.Thmtheorem13.2" class="ltx_text ltx_font_bold">Theorem A.13</span></span><span id="A1.Thmtheorem13.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="A1.Thmtheorem13.p1" class="ltx_para">
<p id="A1.Thmtheorem13.p1.1" class="ltx_p"><span id="A1.Thmtheorem13.p1.1.1" class="ltx_text ltx_font_italic">Suppose <math id="A1.Thmtheorem13.p1.m1" class="ltx_Math" alttext="{\mathbf{V}}" display="inline" intent=":literal"><semantics><mi>𝐕</mi><annotation encoding="application/x-tex">{\mathbf{V}}</annotation></semantics></math> and <math id="A1.Thmtheorem13.p1.m2" class="ltx_Math" alttext="{\mathbf{Q}}" display="inline" intent=":literal"><semantics><mi>𝐐</mi><annotation encoding="application/x-tex">{\mathbf{Q}}</annotation></semantics></math> in (<a href="#S3.E2" title="Equation 2 ‣ Transformer Architecture. ‣ 3 Problem Setup ‣ Fine-Tuning Without Forgetting In-Context Learning:A Theoretical Analysis of Linear Attention Models" class="ltx_ref"><span class="ltx_text ltx_ref_tag">2</span></a>) satisfy <math id="A1.Thmtheorem13.p1.m3" class="ltx_Math" alttext="v_{22}=1" display="inline" intent=":literal"><semantics><mrow><msub><mi>v</mi><mn>22</mn></msub><mo>=</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">v_{22}=1</annotation></semantics></math>, <math id="A1.Thmtheorem13.p1.m4" class="ltx_Math" alttext="{\mathbf{q}}_{21}={\mathbf{0}}_{d}" display="inline" intent=":literal"><semantics><mrow><msub><mi>𝐪</mi><mn>21</mn></msub><mo>=</mo><msub><mn>𝟎</mn><mi>d</mi></msub></mrow><annotation encoding="application/x-tex">{\mathbf{q}}_{21}={\mathbf{0}}_{d}</annotation></semantics></math>, and <math id="A1.Thmtheorem13.p1.m5" class="ltx_Math" alttext="{\mathbf{Q}}_{11}" display="inline" intent=":literal"><semantics><msub><mi>𝐐</mi><mn>11</mn></msub><annotation encoding="application/x-tex">{\mathbf{Q}}_{11}</annotation></semantics></math> is positive definite. For any <math id="A1.Thmtheorem13.p1.m6" class="ltx_Math" alttext="{\mathbf{\theta}}\in{\mathbb{R}}^{d}" display="inline" intent=":literal"><semantics><mrow><mi>θ</mi><mo>∈</mo><msup><mi>ℝ</mi><mi>d</mi></msup></mrow><annotation encoding="application/x-tex">{\mathbf{\theta}}\in{\mathbb{R}}^{d}</annotation></semantics></math>, the following inequality holds:</span></p>
<table id="A1.EGx78" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A1.E248"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A1.E248.m1" class="ltx_Math" alttext="\displaystyle\displaystyle\mathbb{E}_{{\mathbf{x}},y|{\mathbf{\theta}}_{0}}\left[\big(\hat{y}_{\mathrm{ZS}}({\mathbf{x}};{\mathbf{V}},{\mathbf{Q}})-y\big)^{2}\right]\leq\displaystyle\mathbb{E}_{{\mathbf{Z}}_{[n]},{\mathbf{x}},y|{\mathbf{\theta}}_{0}}\left[\big(\hat{y}_{\mathrm{FS}}({\mathbf{Z}}_{[n]},{\mathbf{x}};{\mathbf{V}},{\mathbf{Q}})-y\big)^{2}\right]," display="inline" intent=":literal"><semantics><mrow><mrow><mrow><msub><mi>𝔼</mi><mrow><mi>𝐱</mi><mo>,</mo><mrow><mi>y</mi><mo fence="false">|</mo><msub><mi>θ</mi><mn>0</mn></msub></mrow></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><msup><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mrow><mrow><msub><mover accent="true"><mi>y</mi><mo>^</mo></mover><mi>ZS</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐱</mi><mo>,</mo><mi>𝐕</mi><mo>,</mo><mi>𝐐</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mi>y</mi></mrow><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow><mn>2</mn></msup><mo>]</mo></mrow></mrow><mo>≤</mo><mrow><msub><mi>𝔼</mi><mrow><msub><mi>𝐙</mi><mrow><mo stretchy="false">[</mo><mi>n</mi><mo stretchy="false">]</mo></mrow></msub><mo>,</mo><mi>𝐱</mi><mo>,</mo><mrow><mi>y</mi><mo fence="false">|</mo><msub><mi>θ</mi><mn>0</mn></msub></mrow></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><msup><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mrow><mrow><msub><mover accent="true"><mi>y</mi><mo>^</mo></mover><mi>FS</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐙</mi><mrow><mo stretchy="false">[</mo><mi>n</mi><mo stretchy="false">]</mo></mrow></msub><mo>,</mo><mi>𝐱</mi><mo>,</mo><mi>𝐕</mi><mo>,</mo><mi>𝐐</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mi>y</mi></mrow><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow><mn>2</mn></msup><mo>]</mo></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\displaystyle\mathbb{E}_{{\mathbf{x}},y|{\mathbf{\theta}}_{0}}\left[\big(\hat{y}_{\mathrm{ZS}}({\mathbf{x}};{\mathbf{V}},{\mathbf{Q}})-y\big)^{2}\right]\leq\displaystyle\mathbb{E}_{{\mathbf{Z}}_{[n]},{\mathbf{x}},y|{\mathbf{\theta}}_{0}}\left[\big(\hat{y}_{\mathrm{FS}}({\mathbf{Z}}_{[n]},{\mathbf{x}};{\mathbf{V}},{\mathbf{Q}})-y\big)^{2}\right],</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(248)</span></td></tr></tbody>
</table>
<p id="A1.Thmtheorem13.p1.2" class="ltx_p"><span id="A1.Thmtheorem13.p1.2.1" class="ltx_text ltx_font_italic">if and only if</span></p>
<table id="A1.EGx79" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A1.E249"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A1.E249.m1" class="ltx_Math" alttext="\displaystyle\left({\mathbf{v}}_{21}-{\mathbf{A}}^{-1}{\mathbf{B}}{\mathbf{\theta}}_{0}\right)^{\top}{\mathbf{A}}\left({\mathbf{v}}_{21}-{\mathbf{A}}^{-1}{\mathbf{B}}{\mathbf{\theta}}_{0}\right)\leq c," display="inline" intent=":literal"><semantics><mrow><mrow><mrow><msup><mrow><mo>(</mo><mrow><msub><mi>𝐯</mi><mn>21</mn></msub><mo>−</mo><mrow><msup><mi>𝐀</mi><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mi>𝐁</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>θ</mi><mn>0</mn></msub></mrow></mrow><mo>)</mo></mrow><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>𝐀</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><msub><mi>𝐯</mi><mn>21</mn></msub><mo>−</mo><mrow><msup><mi>𝐀</mi><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mi>𝐁</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>θ</mi><mn>0</mn></msub></mrow></mrow><mo>)</mo></mrow></mrow><mo>≤</mo><mi>c</mi></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\left({\mathbf{v}}_{21}-{\mathbf{A}}^{-1}{\mathbf{B}}{\mathbf{\theta}}_{0}\right)^{\top}{\mathbf{A}}\left({\mathbf{v}}_{21}-{\mathbf{A}}^{-1}{\mathbf{B}}{\mathbf{\theta}}_{0}\right)\leq c,</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(249)</span></td></tr></tbody>
</table>
<p id="A1.Thmtheorem13.p1.3" class="ltx_p"><span id="A1.Thmtheorem13.p1.3.1" class="ltx_text ltx_font_italic">where</span></p>
<table id="A1.EGx80" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A1.E250"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A1.E250.m1" class="ltx_Math" alttext="\displaystyle{\mathbf{A}}" display="inline" intent=":literal"><semantics><mi>𝐀</mi><annotation encoding="application/x-tex">\displaystyle{\mathbf{A}}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.E250.m2" class="ltx_Math" alttext="\displaystyle:=(n+2)\cdot\tr({\mathbf{Q}}_{11}{\mathbf{\Sigma}})^{2}\cdot{\mathbf{\Sigma}}+(2n+3)\cdot\tr({\mathbf{Q}}_{11}{\mathbf{\Sigma}}{\mathbf{Q}}_{11}{\mathbf{\Sigma}})\cdot{\mathbf{\Sigma}}+(4n+6)\cdot\tr({\mathbf{Q}}_{11}{\mathbf{\Sigma}})\cdot{\mathbf{\Sigma}}{\mathbf{Q}}_{11}{\mathbf{\Sigma}}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>n</mi><mo>+</mo><mn>2</mn></mrow><mo rspace="0.055em" stretchy="false">)</mo></mrow><mo rspace="0.222em">⋅</mo><mrow><mi>tr</mi><mo>⁡</mo><msup><mrow><mo stretchy="false">(</mo><mrow><msub><mi>𝐐</mi><mn>11</mn></msub><mo lspace="0em" rspace="0em">​</mo><mi>𝚺</mi></mrow><mo rspace="0.055em" stretchy="false">)</mo></mrow><mn>2</mn></msup></mrow><mo rspace="0.222em">⋅</mo><mi>𝚺</mi></mrow><mo>+</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow><mo>+</mo><mn>3</mn></mrow><mo rspace="0.055em" stretchy="false">)</mo></mrow><mo rspace="0.222em">⋅</mo><mrow><mi>tr</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>𝐐</mi><mn>11</mn></msub><mo lspace="0em" rspace="0em">​</mo><mi>𝚺</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝐐</mi><mn>11</mn></msub><mo lspace="0em" rspace="0em">​</mo><mi>𝚺</mi></mrow><mo rspace="0.055em" stretchy="false">)</mo></mrow></mrow><mo rspace="0.222em">⋅</mo><mi>𝚺</mi></mrow><mo>+</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mrow><mn>4</mn><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow><mo>+</mo><mn>6</mn></mrow><mo rspace="0.055em" stretchy="false">)</mo></mrow><mo rspace="0.222em">⋅</mo><mrow><mi>tr</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>𝐐</mi><mn>11</mn></msub><mo lspace="0em" rspace="0em">​</mo><mi>𝚺</mi></mrow><mo rspace="0.055em" stretchy="false">)</mo></mrow></mrow><mo rspace="0.222em">⋅</mo><mrow><mi>𝚺</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝐐</mi><mn>11</mn></msub><mo lspace="0em" rspace="0em">​</mo><mi>𝚺</mi></mrow></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle:=(n+2)\cdot\tr({\mathbf{Q}}_{11}{\mathbf{\Sigma}})^{2}\cdot{\mathbf{\Sigma}}+(2n+3)\cdot\tr({\mathbf{Q}}_{11}{\mathbf{\Sigma}}{\mathbf{Q}}_{11}{\mathbf{\Sigma}})\cdot{\mathbf{\Sigma}}+(4n+6)\cdot\tr({\mathbf{Q}}_{11}{\mathbf{\Sigma}})\cdot{\mathbf{\Sigma}}{\mathbf{Q}}_{11}{\mathbf{\Sigma}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(250)</span></td></tr></tbody>
<tbody id="A1.E251"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.E251.m1" class="ltx_math_unparsed" alttext="\displaystyle\quad\quad+(7n+11)\cdot{\mathbf{\Sigma}}{\mathbf{Q}}_{11}{\mathbf{\Sigma}}{\mathbf{Q}}_{11}{\mathbf{\Sigma}}+q\cdot\left((n+1)q\cdot{\mathbf{\Sigma}}+2(n+2)\cdot\tr({\mathbf{Q}}_{11}{\mathbf{\Sigma}})\cdot{\mathbf{\Sigma}}+(4n+6)\cdot{\mathbf{\Sigma}}{\mathbf{Q}}_{11}{\mathbf{\Sigma}}\right)," display="inline" intent=":literal"><semantics><mrow><mo>+</mo><mrow><mo stretchy="false">(</mo><mn>7</mn><mi>n</mi><mo>+</mo><mn>11</mn><mo rspace="0.055em" stretchy="false">)</mo></mrow><mo rspace="0.222em">⋅</mo><mi>𝚺</mi><msub><mi>𝐐</mi><mn>11</mn></msub><mi>𝚺</mi><msub><mi>𝐐</mi><mn>11</mn></msub><mi>𝚺</mi><mo>+</mo><mi>q</mi><mo lspace="0.222em" rspace="0.222em">⋅</mo><mrow><mo>(</mo><mrow><mo stretchy="false">(</mo><mi>n</mi><mo>+</mo><mn>1</mn><mo stretchy="false">)</mo></mrow><mi>q</mi><mo lspace="0.222em" rspace="0.222em">⋅</mo><mi>𝚺</mi><mo>+</mo><mn>2</mn><mrow><mo stretchy="false">(</mo><mi>n</mi><mo>+</mo><mn>2</mn><mo rspace="0.055em" stretchy="false">)</mo></mrow><mo rspace="0.222em">⋅</mo><mi>tr</mi><mrow><mo stretchy="false">(</mo><msub><mi>𝐐</mi><mn>11</mn></msub><mi>𝚺</mi><mo rspace="0.055em" stretchy="false">)</mo></mrow><mo rspace="0.222em">⋅</mo><mi>𝚺</mi><mo>+</mo><mrow><mo stretchy="false">(</mo><mn>4</mn><mi>n</mi><mo>+</mo><mn>6</mn><mo rspace="0.055em" stretchy="false">)</mo></mrow><mo rspace="0.222em">⋅</mo><mi>𝚺</mi><msub><mi>𝐐</mi><mn>11</mn></msub><mi>𝚺</mi><mo>)</mo></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\quad\quad+(7n+11)\cdot{\mathbf{\Sigma}}{\mathbf{Q}}_{11}{\mathbf{\Sigma}}{\mathbf{Q}}_{11}{\mathbf{\Sigma}}+q\cdot\left((n+1)q\cdot{\mathbf{\Sigma}}+2(n+2)\cdot\tr({\mathbf{Q}}_{11}{\mathbf{\Sigma}})\cdot{\mathbf{\Sigma}}+(4n+6)\cdot{\mathbf{\Sigma}}{\mathbf{Q}}_{11}{\mathbf{\Sigma}}\right),</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(251)</span></td></tr></tbody>
<tbody id="A1.E252"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A1.E252.m1" class="ltx_Math" alttext="\displaystyle{\mathbf{B}}" display="inline" intent=":literal"><semantics><mi>𝐁</mi><annotation encoding="application/x-tex">\displaystyle{\mathbf{B}}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.E252.m2" class="ltx_Math" alttext="\displaystyle:=\tr({\mathbf{Q}}_{11}{\mathbf{\Sigma}}{\mathbf{Q}}_{11}{\mathbf{\Sigma}})\cdot{\mathbf{\Sigma}}+(n+3)\cdot{\mathbf{\Sigma}}{\mathbf{Q}}_{11}{\mathbf{\Sigma}}{\mathbf{Q}}_{11}{\mathbf{\Sigma}}+\tr({\mathbf{Q}}_{11}{\mathbf{\Sigma}})\cdot{\mathbf{\Sigma}}{\mathbf{Q}}_{11}{\mathbf{\Sigma}}+(n+1)\cdot{\mathbf{\Sigma}}{\mathbf{Q}}_{11}{\mathbf{\Sigma}}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><mrow><mi>tr</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>𝐐</mi><mn>11</mn></msub><mo lspace="0em" rspace="0em">​</mo><mi>𝚺</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝐐</mi><mn>11</mn></msub><mo lspace="0em" rspace="0em">​</mo><mi>𝚺</mi></mrow><mo rspace="0.055em" stretchy="false">)</mo></mrow></mrow><mo rspace="0.222em">⋅</mo><mi>𝚺</mi></mrow><mo>+</mo><mrow><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>n</mi><mo>+</mo><mn>3</mn></mrow><mo rspace="0.055em" stretchy="false">)</mo></mrow><mo rspace="0.222em">⋅</mo><mi>𝚺</mi></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝐐</mi><mn>11</mn></msub><mo lspace="0em" rspace="0em">​</mo><mi>𝚺</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝐐</mi><mn>11</mn></msub><mo lspace="0em" rspace="0em">​</mo><mi>𝚺</mi></mrow><mo>+</mo><mrow><mrow><mrow><mi>tr</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>𝐐</mi><mn>11</mn></msub><mo lspace="0em" rspace="0em">​</mo><mi>𝚺</mi></mrow><mo rspace="0.055em" stretchy="false">)</mo></mrow></mrow><mo rspace="0.222em">⋅</mo><mi>𝚺</mi></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝐐</mi><mn>11</mn></msub><mo lspace="0em" rspace="0em">​</mo><mi>𝚺</mi></mrow><mo>+</mo><mrow><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>n</mi><mo>+</mo><mn>1</mn></mrow><mo rspace="0.055em" stretchy="false">)</mo></mrow><mo rspace="0.222em">⋅</mo><mi>𝚺</mi></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝐐</mi><mn>11</mn></msub><mo lspace="0em" rspace="0em">​</mo><mi>𝚺</mi></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle:=\tr({\mathbf{Q}}_{11}{\mathbf{\Sigma}}{\mathbf{Q}}_{11}{\mathbf{\Sigma}})\cdot{\mathbf{\Sigma}}+(n+3)\cdot{\mathbf{\Sigma}}{\mathbf{Q}}_{11}{\mathbf{\Sigma}}{\mathbf{Q}}_{11}{\mathbf{\Sigma}}+\tr({\mathbf{Q}}_{11}{\mathbf{\Sigma}})\cdot{\mathbf{\Sigma}}{\mathbf{Q}}_{11}{\mathbf{\Sigma}}+(n+1)\cdot{\mathbf{\Sigma}}{\mathbf{Q}}_{11}{\mathbf{\Sigma}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(252)</span></td></tr></tbody>
<tbody id="A1.E253"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.E253.m1" class="ltx_math_unparsed" alttext="\displaystyle\quad\quad+(n+1)\cdot\tr({\mathbf{Q}}_{11}{\mathbf{\Sigma}})\cdot{\mathbf{\Sigma}}+q\left({\mathbf{\Sigma}}{\mathbf{Q}}_{11}{\mathbf{\Sigma}}+(q-1)\cdot{\mathbf{\Sigma}}\right)," display="inline" intent=":literal"><semantics><mrow><mo>+</mo><mrow><mo stretchy="false">(</mo><mi>n</mi><mo>+</mo><mn>1</mn><mo rspace="0.055em" stretchy="false">)</mo></mrow><mo rspace="0.222em">⋅</mo><mi>tr</mi><mrow><mo stretchy="false">(</mo><msub><mi>𝐐</mi><mn>11</mn></msub><mi>𝚺</mi><mo rspace="0.055em" stretchy="false">)</mo></mrow><mo rspace="0.222em">⋅</mo><mi>𝚺</mi><mo>+</mo><mi>q</mi><mrow><mo>(</mo><mi>𝚺</mi><msub><mi>𝐐</mi><mn>11</mn></msub><mi>𝚺</mi><mo>+</mo><mrow><mo stretchy="false">(</mo><mi>q</mi><mo>−</mo><mn>1</mn><mo rspace="0.055em" stretchy="false">)</mo></mrow><mo rspace="0.222em">⋅</mo><mi>𝚺</mi><mo>)</mo></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\quad\quad+(n+1)\cdot\tr({\mathbf{Q}}_{11}{\mathbf{\Sigma}})\cdot{\mathbf{\Sigma}}+q\left({\mathbf{\Sigma}}{\mathbf{Q}}_{11}{\mathbf{\Sigma}}+(q-1)\cdot{\mathbf{\Sigma}}\right),</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(253)</span></td></tr></tbody>
<tbody id="A1.E254"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A1.E254.m1" class="ltx_Math" alttext="\displaystyle{\mathbf{C}}" display="inline" intent=":literal"><semantics><mi>𝐂</mi><annotation encoding="application/x-tex">\displaystyle{\mathbf{C}}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.E254.m2" class="ltx_Math" alttext="\displaystyle:=(n+1)\cdot{\mathbf{\Sigma}}{\mathbf{Q}}_{11}{\mathbf{\Sigma}}{\mathbf{Q}}_{11}{\mathbf{\Sigma}}-2(n+1)\cdot{\mathbf{\Sigma}}{\mathbf{Q}}_{11}{\mathbf{\Sigma}}+\tr({\mathbf{Q}}_{11}{\mathbf{\Sigma}}{\mathbf{Q}}_{11}{\mathbf{\Sigma}})\cdot{\mathbf{\Sigma}}+q^{2}\cdot{\mathbf{\Sigma}}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><mrow><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>n</mi><mo>+</mo><mn>1</mn></mrow><mo rspace="0.055em" stretchy="false">)</mo></mrow><mo rspace="0.222em">⋅</mo><mi>𝚺</mi></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝐐</mi><mn>11</mn></msub><mo lspace="0em" rspace="0em">​</mo><mi>𝚺</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝐐</mi><mn>11</mn></msub><mo lspace="0em" rspace="0em">​</mo><mi>𝚺</mi></mrow><mo>−</mo><mrow><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>n</mi><mo>+</mo><mn>1</mn></mrow><mo rspace="0.055em" stretchy="false">)</mo></mrow></mrow><mo rspace="0.222em">⋅</mo><mi>𝚺</mi></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝐐</mi><mn>11</mn></msub><mo lspace="0em" rspace="0em">​</mo><mi>𝚺</mi></mrow></mrow><mo>+</mo><mrow><mrow><mi>tr</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>𝐐</mi><mn>11</mn></msub><mo lspace="0em" rspace="0em">​</mo><mi>𝚺</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝐐</mi><mn>11</mn></msub><mo lspace="0em" rspace="0em">​</mo><mi>𝚺</mi></mrow><mo rspace="0.055em" stretchy="false">)</mo></mrow></mrow><mo rspace="0.222em">⋅</mo><mi>𝚺</mi></mrow><mo>+</mo><mrow><msup><mi>q</mi><mn>2</mn></msup><mo lspace="0.222em" rspace="0.222em">⋅</mo><mi>𝚺</mi></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle:=(n+1)\cdot{\mathbf{\Sigma}}{\mathbf{Q}}_{11}{\mathbf{\Sigma}}{\mathbf{Q}}_{11}{\mathbf{\Sigma}}-2(n+1)\cdot{\mathbf{\Sigma}}{\mathbf{Q}}_{11}{\mathbf{\Sigma}}+\tr({\mathbf{Q}}_{11}{\mathbf{\Sigma}}{\mathbf{Q}}_{11}{\mathbf{\Sigma}})\cdot{\mathbf{\Sigma}}+q^{2}\cdot{\mathbf{\Sigma}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(254)</span></td></tr></tbody>
<tbody id="A1.E255"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A1.E255.m1" class="ltx_Math" alttext="\displaystyle c" display="inline" intent=":literal"><semantics><mi>c</mi><annotation encoding="application/x-tex">\displaystyle c</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.E255.m2" class="ltx_Math" alttext="\displaystyle:={\mathbf{\theta}}_{0}^{\top}\left({\mathbf{B}}{\mathbf{A}}^{-1}{\mathbf{B}}+{\mathbf{C}}\right){\mathbf{\theta}}_{0}+\left(\tr({\mathbf{Q}}_{11}{\mathbf{\Sigma}}{\mathbf{Q}}_{11}{\mathbf{\Sigma}})+q^{2}\right)\cdot\sigma^{2}." display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><msubsup><mi>θ</mi><mn>0</mn><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mrow><msup><mi>𝐁𝐀</mi><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mi>𝐁</mi></mrow><mo>+</mo><mi>𝐂</mi></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>θ</mi><mn>0</mn></msub></mrow><mo>+</mo><mrow><mrow><mo>(</mo><mrow><mrow><mi>tr</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>𝐐</mi><mn>11</mn></msub><mo lspace="0em" rspace="0em">​</mo><mi>𝚺</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝐐</mi><mn>11</mn></msub><mo lspace="0em" rspace="0em">​</mo><mi>𝚺</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><msup><mi>q</mi><mn>2</mn></msup></mrow><mo rspace="0.055em">)</mo></mrow><mo rspace="0.222em">⋅</mo><msup><mi>σ</mi><mn>2</mn></msup></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle:={\mathbf{\theta}}_{0}^{\top}\left({\mathbf{B}}{\mathbf{A}}^{-1}{\mathbf{B}}+{\mathbf{C}}\right){\mathbf{\theta}}_{0}+\left(\tr({\mathbf{Q}}_{11}{\mathbf{\Sigma}}{\mathbf{Q}}_{11}{\mathbf{\Sigma}})+q^{2}\right)\cdot\sigma^{2}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(255)</span></td></tr></tbody>
</table>
</div>
</div>
<div id="A1.SS4.2" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="A1.SS4.p1" class="ltx_para">
<p id="A1.SS4.p1.1" class="ltx_p"><span id="A1.SS4.p1.1.1" class="ltx_text">From Lemma <a href="#A1.Thmtheorem5" title="Lemma A.5. ‣ A.2 Proofs of Statistical Properties of Model Outputs ‣ Appendix A Proofs ‣ Fine-Tuning Without Forgetting In-Context Learning:A Theoretical Analysis of Linear Attention Models" class="ltx_ref"><span class="ltx_text ltx_ref_tag">A.5</span></a>, we have</span></p>
<table id="A1.EGx81" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A1.E256"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.E256.m1" class="ltx_Math" alttext="\displaystyle\displaystyle\mathbb{E}_{{\mathbf{Z}}_{[n]},{\mathbf{x}},y|{\mathbf{\theta}}_{0}}\left[\big(\hat{y}_{\mathrm{FS}}({\mathbf{Z}}_{[n]},{\mathbf{x}};{\mathbf{V}},{\mathbf{Q}})-y\big)^{2}\right]-\displaystyle\mathbb{E}_{{\mathbf{x}},y|{\mathbf{\theta}}_{0}}\left[\big(\hat{y}_{\mathrm{ZS}}({\mathbf{x}};{\mathbf{V}},{\mathbf{Q}})-y\big)^{2}\right]" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>𝔼</mi><mrow><msub><mi>𝐙</mi><mrow><mo stretchy="false">[</mo><mi>n</mi><mo stretchy="false">]</mo></mrow></msub><mo>,</mo><mi>𝐱</mi><mo>,</mo><mrow><mi>y</mi><mo fence="false">|</mo><msub><mi>θ</mi><mn>0</mn></msub></mrow></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><msup><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mrow><mrow><msub><mover accent="true"><mi>y</mi><mo>^</mo></mover><mi>FS</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐙</mi><mrow><mo stretchy="false">[</mo><mi>n</mi><mo stretchy="false">]</mo></mrow></msub><mo>,</mo><mi>𝐱</mi><mo>,</mo><mi>𝐕</mi><mo>,</mo><mi>𝐐</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mi>y</mi></mrow><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow><mn>2</mn></msup><mo>]</mo></mrow></mrow><mo>−</mo><mrow><msub><mi>𝔼</mi><mrow><mi>𝐱</mi><mo>,</mo><mrow><mi>y</mi><mo fence="false">|</mo><msub><mi>θ</mi><mn>0</mn></msub></mrow></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><msup><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mrow><mrow><msub><mover accent="true"><mi>y</mi><mo>^</mo></mover><mi>ZS</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐱</mi><mo>,</mo><mi>𝐕</mi><mo>,</mo><mi>𝐐</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mi>y</mi></mrow><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow><mn>2</mn></msup><mo>]</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\displaystyle\mathbb{E}_{{\mathbf{Z}}_{[n]},{\mathbf{x}},y|{\mathbf{\theta}}_{0}}\left[\big(\hat{y}_{\mathrm{FS}}({\mathbf{Z}}_{[n]},{\mathbf{x}};{\mathbf{V}},{\mathbf{Q}})-y\big)^{2}\right]-\displaystyle\mathbb{E}_{{\mathbf{x}},y|{\mathbf{\theta}}_{0}}\left[\big(\hat{y}_{\mathrm{ZS}}({\mathbf{x}};{\mathbf{V}},{\mathbf{Q}})-y\big)^{2}\right]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(256)</span></td></tr></tbody>
<tbody id="A1.E257"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.E257.m1" class="ltx_Math" alttext="\displaystyle=\frac{n}{(n+1)^{2}}\cdot\left(h({\mathbf{V}},{\mathbf{Q}};{\mathbf{\theta}}_{0})-(n+2)\cdot\displaystyle\mathbb{E}_{{\mathbf{x}},y|{\mathbf{\theta}}_{0}}\left[\big(\hat{y}_{\mathrm{ZS}}({\mathbf{x}};{\mathbf{V}},{\mathbf{Q}})-y\big)^{2}\right]\right)," display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>=</mo><mrow><mstyle displaystyle="true"><mfrac><mi>n</mi><msup><mrow><mo stretchy="false">(</mo><mrow><mi>n</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mfrac></mstyle><mo lspace="0.222em" rspace="0.222em">⋅</mo><mrow><mo>(</mo><mrow><mrow><mi>h</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝐕</mi><mo>,</mo><mi>𝐐</mi><mo>,</mo><msub><mi>θ</mi><mn>0</mn></msub><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>n</mi><mo>+</mo><mn>2</mn></mrow><mo rspace="0.055em" stretchy="false">)</mo></mrow><mo rspace="0.222em">⋅</mo><msub><mi>𝔼</mi><mrow><mi>𝐱</mi><mo>,</mo><mrow><mi>y</mi><mo fence="false">|</mo><msub><mi>θ</mi><mn>0</mn></msub></mrow></mrow></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><msup><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mrow><mrow><msub><mover accent="true"><mi>y</mi><mo>^</mo></mover><mi>ZS</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐱</mi><mo>,</mo><mi>𝐕</mi><mo>,</mo><mi>𝐐</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mi>y</mi></mrow><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow><mn>2</mn></msup><mo>]</mo></mrow></mrow></mrow><mo>)</mo></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle=\frac{n}{(n+1)^{2}}\cdot\left(h({\mathbf{V}},{\mathbf{Q}};{\mathbf{\theta}}_{0})-(n+2)\cdot\displaystyle\mathbb{E}_{{\mathbf{x}},y|{\mathbf{\theta}}_{0}}\left[\big(\hat{y}_{\mathrm{ZS}}({\mathbf{x}};{\mathbf{V}},{\mathbf{Q}})-y\big)^{2}\right]\right),</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(257)</span></td></tr></tbody>
</table>
<p id="A1.SS4.p1.2" class="ltx_p"><span id="A1.SS4.p1.2.1" class="ltx_text">which implies that it suffices to check the sign of the expression inside the parentheses in (<a href="#A1.E257" title="Equation 257 ‣ Proof. ‣ A.4 Proofs for Test Errors ‣ Appendix A Proofs ‣ Fine-Tuning Without Forgetting In-Context Learning:A Theoretical Analysis of Linear Attention Models" class="ltx_ref"><span class="ltx_text ltx_ref_tag">257</span></a>). Then,</span></p>
<table id="A1.EGx82" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A1.E258"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.E258.m1" class="ltx_Math" alttext="\displaystyle h({\mathbf{V}},{\mathbf{Q}};{\mathbf{\theta}}_{0})-(n+2)\cdot\displaystyle\mathbb{E}_{{\mathbf{x}},y|{\mathbf{\theta}}_{0}}\left[\big(\hat{y}_{\mathrm{ZS}}({\mathbf{x}};{\mathbf{V}},{\mathbf{Q}})-y\big)^{2}\right]" display="inline" intent=":literal"><semantics><mrow><mrow><mi>h</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝐕</mi><mo>,</mo><mi>𝐐</mi><mo>,</mo><msub><mi>θ</mi><mn>0</mn></msub><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>n</mi><mo>+</mo><mn>2</mn></mrow><mo rspace="0.055em" stretchy="false">)</mo></mrow><mo rspace="0.222em">⋅</mo><msub><mi>𝔼</mi><mrow><mi>𝐱</mi><mo>,</mo><mrow><mi>y</mi><mo fence="false">|</mo><msub><mi>θ</mi><mn>0</mn></msub></mrow></mrow></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><msup><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mrow><mrow><msub><mover accent="true"><mi>y</mi><mo>^</mo></mover><mi>ZS</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐱</mi><mo>,</mo><mi>𝐕</mi><mo>,</mo><mi>𝐐</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mi>y</mi></mrow><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow><mn>2</mn></msup><mo>]</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle h({\mathbf{V}},{\mathbf{Q}};{\mathbf{\theta}}_{0})-(n+2)\cdot\displaystyle\mathbb{E}_{{\mathbf{x}},y|{\mathbf{\theta}}_{0}}\left[\big(\hat{y}_{\mathrm{ZS}}({\mathbf{x}};{\mathbf{V}},{\mathbf{Q}})-y\big)^{2}\right]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(258)</span></td></tr></tbody>
<tbody id="A1.E259"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
