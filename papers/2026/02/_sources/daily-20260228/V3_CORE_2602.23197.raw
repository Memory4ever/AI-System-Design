<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.E169.m1" class="ltx_math_unparsed" alttext="\displaystyle\quad-2n\cdot({\mathbf{v}}_{21}^{\top}+{\mathbf{\theta}}_{0}^{\top}){\mathbf{\Sigma}}{\mathbf{Q}}_{11}{\mathbf{\Sigma}}{\mathbf{\theta}}_{0}+2\cdot\left({\mathbf{v}}_{21}^{\top}{\mathbf{\Sigma}}{\mathbf{Q}}_{11}+{\mathbf{\theta}}_{0}^{\top}{\mathbf{\Sigma}}{\mathbf{Q}}_{11}\right){\mathbf{\Sigma}}\left(2{\mathbf{Q}}_{11}{\mathbf{\Sigma}}{\mathbf{v}}_{21}+\tr({\mathbf{Q}}_{11}{\mathbf{\Sigma}})\cdot{\mathbf{v}}_{21}+q\cdot{\mathbf{v}}_{21}-{\mathbf{\theta}}_{0}\right)" display="inline" intent=":literal"><semantics><mrow><mo>−</mo><mn>2</mn><mi>n</mi><mo lspace="0.222em" rspace="0.222em">⋅</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>𝐯</mi><mn>21</mn><mo>⊤</mo></msubsup><mo>+</mo><msubsup><mi>θ</mi><mn>0</mn><mo>⊤</mo></msubsup><mo stretchy="false">)</mo></mrow><mi>𝚺</mi><msub><mi>𝐐</mi><mn>11</mn></msub><mi>𝚺</mi><msub><mi>θ</mi><mn>0</mn></msub><mo>+</mo><mn>2</mn><mo lspace="0.222em" rspace="0.222em">⋅</mo><mrow><mo>(</mo><msubsup><mi>𝐯</mi><mn>21</mn><mo>⊤</mo></msubsup><mi>𝚺</mi><msub><mi>𝐐</mi><mn>11</mn></msub><mo>+</mo><msubsup><mi>θ</mi><mn>0</mn><mo>⊤</mo></msubsup><mi>𝚺</mi><msub><mi>𝐐</mi><mn>11</mn></msub><mo>)</mo></mrow><mi>𝚺</mi><mrow><mo>(</mo><mn>2</mn><msub><mi>𝐐</mi><mn>11</mn></msub><mi>𝚺</mi><msub><mi>𝐯</mi><mn>21</mn></msub><mo>+</mo><mi>tr</mi><mrow><mo stretchy="false">(</mo><msub><mi>𝐐</mi><mn>11</mn></msub><mi>𝚺</mi><mo rspace="0.055em" stretchy="false">)</mo></mrow><mo rspace="0.222em">⋅</mo><msub><mi>𝐯</mi><mn>21</mn></msub><mo>+</mo><mi>q</mi><mo lspace="0.222em" rspace="0.222em">⋅</mo><msub><mi>𝐯</mi><mn>21</mn></msub><mo>−</mo><msub><mi>θ</mi><mn>0</mn></msub><mo>)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\quad-2n\cdot({\mathbf{v}}_{21}^{\top}+{\mathbf{\theta}}_{0}^{\top}){\mathbf{\Sigma}}{\mathbf{Q}}_{11}{\mathbf{\Sigma}}{\mathbf{\theta}}_{0}+2\cdot\left({\mathbf{v}}_{21}^{\top}{\mathb