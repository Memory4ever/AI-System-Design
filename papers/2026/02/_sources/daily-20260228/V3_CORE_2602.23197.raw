<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.E173.m1" class="ltx_Math" alttext="\displaystyle\quad-2{\mathbf{v}}_{21}^{\top}\Big((n+3)\cdot{\mathbf{\Sigma}}{\mathbf{Q}}_{11}{\mathbf{\Sigma}}+\tr({\mathbf{Q}}_{11}{\mathbf{\Sigma}})\cdot{\mathbf{\Sigma}}\Big){\mathbf{\theta}}_{0}+(n+1)\cdot{\mathbf{\theta}}_{0}^{\top}{\mathbf{\Sigma}}{\mathbf{Q}}_{11}{\mathbf{\Sigma}}{\mathbf{Q}}_{11}{\mathbf{\Sigma}}{\mathbf{\theta}}_{0}-2(n+1)\cdot{\mathbf{\theta}}_{0}^{\top}{\mathbf{\Sigma}}{\mathbf{Q}}_{11}{\mathbf{\Sigma}}{\mathbf{\theta}}_{0}" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mo>−</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝐯</mi><mn>21</mn><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="1.600em" minsize="1.600em">(</mo><mrow><mrow><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>n</mi><mo>+</mo><mn>3</mn></mrow><mo rspace="0.055em" stretchy="false">)</mo></mrow><mo rspace="0.222em">⋅</mo><mi>𝚺</mi></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝐐</mi><mn>11</mn></msub><mo lspace="0em" rspace="0em">​</mo><mi>𝚺</mi></mrow><mo>+</mo><mrow><mrow><mi>tr</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>𝐐</mi><mn>11</mn></msub><mo lspace="0em" rspace="0em">​</mo><mi>𝚺</mi></mrow><mo rspace="0.055em" stretchy="false">)</mo></mrow></mrow><mo rspace="0.222em">⋅</mo><mi>𝚺</mi></mrow></mrow><mo maxsize="1.600em" minsize="1.600em">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>θ</mi><mn>0</mn></msub></mrow></mrow><mo>+</mo><mrow><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>n</mi><mo>+</mo><mn>1</mn></mrow><mo rspace="0.055em" stretchy="false">)</mo></mrow><mo rspace="0.222em">⋅</mo><msubsup><mi>θ</mi><mn>0</mn><mo>⊤</mo></msubsup></mrow><mo lspace="0em" rspace="0em">​</mo><mi>𝚺</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝐐</mi><mn>11</mn></msub><mo lspace="0em" rspace="0em">​</mo><mi>𝚺</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝐐</mi><mn>11</mn></msub><mo lspace="0em" rspace="0em">​</mo><mi>𝚺</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>θ</mi><mn>0</mn></msub></mrow></mrow><mo>−</mo><mrow><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>n</mi><mo>+</mo><mn>1</mn></mrow><mo rspace="0.055em" stretchy="false">)</mo></mrow></mrow><mo rspace="0.222em">⋅</mo><msubsup><mi>θ</mi><mn>0</mn><mo>⊤</mo></msubsup></mrow><mo lspace="0em" rspace="0em">​</mo><mi>𝚺</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝐐</mi><mn>11</mn></msub><mo lspace="0em" rspace="0em">​</mo><mi>𝚺</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>θ</mi><mn>0</mn></msub></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\quad-2{\mathbf{v}}_{21}^{\top}\Big((n+3)\cdot{\mathbf{\Sigma}}{\mathbf{Q}}_{11}{\mathbf{\Sigma}}+\tr({\mathbf{Q}}_{11}{\mathbf{\Sigma}})\cdot{\mathbf{\Sigma}}\Big){\mathbf{\theta}}_{0}+(n+1)\cdot{\mathbf{\theta}}_{0}^{\top}{\mathbf{\Sigma}}{\mathbf{Q}}_{11}{\mathbf{\Sigma}}{\mathbf{Q}}_{11}{\mathbf{\Sigma}}{\mathbf{\theta}}_{0}-2(n+1)\cdot{\mathbf{\theta}}_{0}^{\top}{\mathbf{\Sigma}}{\mathbf{Q}}_{11}{\mathbf{\Sigma}}{\mathbf{\theta}}_{0}</annotation></semantics></math></td>
