<td id="A2.T2.11.1.3.5" class="ltx_td ltx_align_center ltx_border_t" style="padding-top:0.7pt;padding-bottom:0.7pt;"><span id="A2.T2.11.1.3.5.1" class="ltx_text" style="font-size:90%;">63.52 (0.12)</span></td>
<td id="A2.T2.11.1.3.6" class="ltx_td ltx_align_center ltx_border_t" style="padding-top:0.7pt;padding-bottom:0.7pt;"><span id="A2.T2.11.1.3.6.1" class="ltx_text" style="font-size:90%;">70.13 (0.15)</span></td>
<td id="A2.T2.11.1.3.7" class="ltx_td ltx_align_center ltx_border_t" style="padding-top:0.7pt;padding-bottom:0.7pt;"><span id="A2.T2.11.1.3.7.1" class="ltx_text" style="font-size:90%;">75.33 (0.12)</span></td>
<td id="A2.T2.11.1.3.8" class="ltx_td ltx_align_center ltx_border_t" style="padding-top:0.7pt;padding-bottom:0.7pt;"><span id="A2.T2.11.1.3.8.1" class="ltx_text" style="font-size:90%;">71.77 (0.17)</span></td>
<td id="A2.T2.11.1.3.9" class="ltx_td ltx_align_center ltx_border_t" style="padding-top:0.7pt;padding-bottom:0.7pt;"><span id="A2.T2.11.1.3.9.1" class="ltx_text" style="font-size:90%;">64.06 (0.07)</span></td></tr>
<tr id="A2.T2.11.1.4" class="ltx_tr">
<th id="A2.T2.11.1.4.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_t" style="padding-top:0.7pt;padding-bottom:0.7pt;"><span id="A2.T2.11.1.4.1.1" class="ltx_text" style="font-size:90%;">ZS fine-tuning on Q/K/V</span></th>
