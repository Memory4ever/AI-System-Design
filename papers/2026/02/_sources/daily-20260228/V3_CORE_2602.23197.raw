<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.E48.m1" class="ltx_math_unparsed" alttext="\displaystyle\quad+\sigma_{ik}a_{kl}\sigma_{lj}\cdot\sigma_{mn}b^{\top}_{nm}+\sigma_{ik}a_{kl}\sigma_{lm}b_{mn}\sigma_{nj}+\sigma_{ik}a_{kl}\sigma_{ln}b^{\top}_{nm}\sigma_{mj}" display="inline" intent=":literal"><semantics><mrow><mo>+</mo><mi>σ</mi><msub><mrow></mrow><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>k</mi></mrow></msub><mi>a</mi><msub><mrow></mrow><mrow><mi>k</mi><mo lspace="0em" rspace="0em">​</mo><mi>l</mi></mrow></msub><mi>σ</mi><msub><mrow></mrow><mrow><mi>l</mi><mo lspace="0em" rspace="0em">​</mo><mi>j</mi></mrow></msub><mo lspace="0.222em" rspace="0.222em">⋅</mo><mi>σ</mi><msub><mrow></mrow><mrow><mi>m</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow></msub><mi>b</mi><msup><mrow></mrow><mo>⊤</mo></msup><msub><mrow></mrow><mrow><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><mi>m</mi></mrow></msub><mo>+</mo><mi>σ</mi><msub><mrow></mrow><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>k</mi></mrow></msub><mi>a</mi><msub><mrow></mrow><mrow><mi>k</mi><mo lspace="0em" rspace="0em">​</mo><mi>l</mi></mrow></msub><mi>σ</mi><msub><mrow></mrow><mrow><mi>l</mi><mo lspace="0em" rspace="0em">​</mo><mi>m</mi></mrow></msub><mi>b</mi><msub><mrow></mrow><mrow><mi>m</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow></msub><mi>σ</mi><msub><mrow></mrow><mrow><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><mi>j</mi></mrow></msub><mo>+</mo><mi>σ</mi><msub><mrow></mrow><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>k</mi></mrow></msub><mi>a</mi><msub><mrow></mrow><mrow><mi>k</mi><mo lspace="0em" rspace="0em">​</mo><mi>l</mi></mrow></msub><mi>σ</mi><msub><mrow></mrow><mrow><mi>l</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow></msub><mi>b</mi><msup><mrow></mrow><mo>⊤</mo></msup><msub><mrow></mrow><mrow><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><mi>m</mi></mrow></msub><mi>σ</mi><msub><mrow></mrow><mrow><mi>m</mi><mo lspace="0em" rspace="0em">​</mo><mi>j</mi></mrow></msub></mrow><annotation encoding="application/x-tex">\displaystyle\quad+\sigma_{ik}a_{kl}\sigma_{lj}\cdot\sigma_{mn}b^{\top}_{nm}+\sigma_{ik}a_{kl}\sigma_{lm}b_{mn}\sigma_{nj}+\sigma_{ik}a_{kl}\sigma_{ln}b^{\top}_{nm}\sigma_{mj}</annotation></semantics></math></td>
