<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.E174.m1" class="ltx_Math" alttext="\displaystyle\quad+(\tr({\mathbf{Q}}_{11}{\mathbf{\Sigma}}{\mathbf{Q}}_{11}{\mathbf{\Sigma}})+n+2)({\mathbf{\theta}}_{0}^{\top}{\mathbf{\Sigma}}{\mathbf{\theta}}_{0}+\sigma^{2})" display="inline" intent=":literal"><semantics><mrow><mo>+</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mrow><mi>tr</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>𝐐</mi><mn>11</mn></msub><mo lspace="0em" rspace="0em">​</mo><mi>𝚺</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝐐</mi><mn>11</mn></msub><mo lspace="0em" rspace="0em">​</mo><mi>𝚺</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mi>n</mi><mo>+</mo><mn>2</mn></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><msubsup><mi>θ</mi><mn>0</mn><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>𝚺</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>θ</mi><mn>0</mn></msub></mrow><mo>+</mo><msup><mi>σ</mi><mn>2</mn></msup></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\quad+(\tr({\mathbf{Q}}_{11}{\mathbf{\Sigma}}{\mathbf{Q}}_{11}{\mathbf{\Sigma}})+n+2)({\mathbf{\theta}}_{0}^{\top}{\mathbf{\Sigma}}{\mathbf{\theta}}_{0}+\sigma^{2})</annotation></semantics></math></td>
