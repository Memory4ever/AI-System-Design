<div id="A1.Thmtheorem5" class="ltx_theorem ltx_theorem_lemma">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="A1.Thmtheorem5.2" class="ltx_text ltx_font_bold">Lemma A.5</span></span><span id="A1.Thmtheorem5.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="A1.Thmtheorem5.p1" class="ltx_para">
<p id="A1.Thmtheorem5.p1.1" class="ltx_p"><span id="A1.Thmtheorem5.p1.1.1" class="ltx_text ltx_font_italic">Given <math id="A1.Thmtheorem5.p1.m1" class="ltx_Math" alttext="{\mathbf{V}}" display="inline" intent=":literal"><semantics><mi>𝐕</mi><annotation encoding="application/x-tex">{\mathbf{V}}</annotation></semantics></math>, <math id="A1.Thmtheorem5.p1.m2" class="ltx_Math" alttext="{\mathbf{Q}}" display="inline" intent=":literal"><semantics><mi>𝐐</mi><annotation encoding="application/x-tex">{\mathbf{Q}}</annotation></semantics></math>, and <math id="A1.Thmtheorem5.p1.m3" class="ltx_Math" alttext="{\mathbf{\theta}}_{0}\in{\mathbb{R}}^{d}" display="inline" intent=":literal"><semantics><mrow><msub><mi>θ</mi><mn>0</mn></msub><mo>∈</mo><msup><mi>ℝ</mi><mi>d</mi></msup></mrow><annotation encoding="application/x-tex">{\mathbf{\theta}}_{0}\in{\mathbb{R}}^{d}</annotation></semantics></math>, the expected squared errors of <math id="A1.Thmtheorem5.p1.m4" class="ltx_Math" alttext="\hat{y}_{\mathrm{Net\text{-}FS}}({\mathbf{Z}}_{[n]},{\mathbf{x}};{\mathbf{V}},{\mathbf{Q}})" display="inline" intent=":literal"><semantics><mrow><msub><mover accent="true"><mi>y</mi><mo>^</mo></mover><mrow><mi>Net</mi><mo lspace="0em" rspace="0em">​</mo><mtext class="ltx_mathvariant_italic">-</mtext><mo lspace="0em" rspace="0em">​</mo><mi>FS</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐙</mi><mrow><mo stretchy="false">[</mo><mi>n</mi><mo stretchy="false">]</mo></mrow></msub><mo>,</mo><mi>𝐱</mi><mo>,</mo><mi>𝐕</mi><mo>,</mo><mi>𝐐</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\hat{y}_{\mathrm{Net\text{-}FS}}({\mathbf{Z}}_{[n]},{\mathbf{x}};{\mathbf{V}},{\mathbf{Q}})</annotation></semantics></math> in (<a href="#A1.E72" title="Equation 72 ‣ A.2 Proofs of Statistical Properties of Model Outputs ‣ Appendix A Proofs ‣ Fine-Tuning Without Forgetting In-Context Learning:A Theoretical Analysis of Linear Attention Models" class="ltx_ref"><span class="ltx_text ltx_ref_tag">72</span></a>) and <math id="A1.Thmtheorem5.p1.m5" class="ltx_Math" alttext="\hat{y}_{\mathrm{ZS}}({\mathbf{x}};{\mathbf{V}},{\mathbf{Q}})" display="inline" intent=":literal"><semantics><mrow><msub><mover accent="true"><mi>y</mi><mo>^</mo></mover><mi>ZS</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐱</mi><mo>,</mo><mi>𝐕</mi><mo>,</mo><mi>𝐐</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\hat{y}_{\mathrm{ZS}}({\mathbf{x}};{\mathbf{V}},{\mathbf{Q}})</annotation></semantics></math> in (<a href="#A1.E73" title="Equation 73 ‣ A.2 Proofs of Statistical Properties of Model Outputs ‣ Appendix A Proofs ‣ Fine-Tuning Without Forgetting In-Context Learning:A Theoretical Analysis of Linear Attention Models" class="ltx_ref"><span class="ltx_text ltx_ref_tag">73</span></a>), as well as the expected value of their cross term, are as follows:</span></p>
<table id="A1.EGx39" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A1.E117"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.E117.m1" class="ltx_Math" alttext="\displaystyle\displaystyle\mathbb{E}_{{\mathbf{Z}}_{[n]},{\mathbf{x}},y|{\mathbf{\theta}}_{0}}\left[\big(\hat{y}_{\mathrm{Net\text{-}FS}}({\mathbf{Z}}_{[n]},{\mathbf{x}};{\mathbf{V}},{\mathbf{Q}})-y\big)^{2}\right]" display="inline" intent=":literal"><semantics><mrow><msub><mi>𝔼</mi><mrow><msub><mi>𝐙</mi><mrow><mo stretchy="false">[</mo><mi>n</mi><mo stretchy="false">]</mo></mrow></msub><mo>,</mo><mi>𝐱</mi><mo>,</mo><mrow><mi>y</mi><mo fence="false">|</mo><msub><mi>θ</mi><mn>0</mn></msub></mrow></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><msup><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mrow><mrow><msub><mover accent="true"><mi>y</mi><mo>^</mo></mover><mrow><mi>Net</mi><mo lspace="0em" rspace="0em">​</mo><mtext class="ltx_mathvariant_italic">-</mtext><mo lspace="0em" rspace="0em">​</mo><mi>FS</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐙</mi><mrow><mo stretchy="false">[</mo><mi>n</mi><mo stretchy="false">]</mo></mrow></msub><mo>,</mo><mi>𝐱</mi><mo>,</mo><mi>𝐕</mi><mo>,</mo><mi>𝐐</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mi>y</mi></mrow><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow><mn>2</mn></msup><mo>]</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\displaystyle\mathbb{E}_{{\mathbf{Z}}_{[n]},{\mathbf{x}},y|{\mathbf{\theta}}_{0}}\left[\big(\hat{y}_{\mathrm{Net\text{-}FS}}({\mathbf{Z}}_{[n]},{\mathbf{x}};{\mathbf{V}},{\mathbf{Q}})-y\big)^{2}\right]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(117)</span></td></tr></tbody>
<tbody id="A1.E118"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.E118.m1" class="ltx_Math" alttext="\displaystyle=\frac{1}{n}\cdot\tr\left(\begin{bmatrix}{\mathbf{Q}}_{11}\\
{\mathbf{q}}_{21}^{\top}\end{bmatrix}{\mathbf{\Sigma}}\begin{bmatrix}{\mathbf{Q}}_{11}\\
{\mathbf{q}}_{21}^{\top}\end{bmatrix}^{\top}\!{\mathbf{\Sigma}}_{\mathrm{joint}}\right)\cdot\begin{bmatrix}{\mathbf{v}}_{21}\\
v_{22}\end{bmatrix}^{\top}\!{\mathbf{\Sigma}}_{\mathrm{joint}}\begin{bmatrix}{\mathbf{v}}_{21}\\
v_{22}\end{bmatrix}+\frac{n+1}{n}\cdot\begin{bmatrix}{\mathbf{v}}_{21}\\
v_{22}\end{bmatrix}^{\top}\!{\mathbf{\Sigma}}_{\mathrm{joint}}\begin{bmatrix}{\mathbf{Q}}_{11}\\
{\mathbf{q}}_{21}^{\top}\end{bmatrix}{\mathbf{\Sigma}}\begin{bmatrix}{\mathbf{Q}}_{11}\\
{\mathbf{q}}_{21}^{\top}\end{bmatrix}^{\top}\!{\mathbf{\Sigma}}_{\mathrm{joint}}\begin{bmatrix}{\mathbf{v}}_{21}\\
v_{22}\end{bmatrix}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>n</mi></mfrac></mstyle><mo lspace="0.222em" rspace="0.222em">⋅</mo><mrow><mi>tr</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mrow><mo>[</mo><mtable rowspacing="0pt"><mtr><mtd><msub><mi>𝐐</mi><mn>11</mn></msub></mtd></mtr><mtr><mtd><msubsup><mi>𝐪</mi><mn>21</mn><mo>⊤</mo></msubsup></mtd></mtr></mtable><mo>]</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>𝚺</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo>[</mo><mtable rowspacing="0pt"><mtr><mtd><msub><mi>𝐐</mi><mn>11</mn></msub></mtd></mtr><mtr><mtd><msubsup><mi>𝐪</mi><mn>21</mn><mo>⊤</mo></msubsup></mtd></mtr></mtable><mo>]</mo></mrow><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝚺</mi><mi>joint</mi></msub></mrow><mo rspace="0.055em">)</mo></mrow></mrow><mo rspace="0.222em">⋅</mo><mrow><msup><mrow><mo>[</mo><mtable rowspacing="0pt"><mtr><mtd><msub><mi>𝐯</mi><mn>21</mn></msub></mtd></mtr><mtr><mtd><msub><mi>v</mi><mn>22</mn></msub></mtd></mtr></mtable><mo>]</mo></mrow><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝚺</mi><mi>joint</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><mtable rowspacing="0pt"><mtr><mtd><msub><mi>𝐯</mi><mn>21</mn></msub></mtd></mtr><mtr><mtd><msub><mi>v</mi><mn>22</mn></msub></mtd></mtr></mtable><mo>]</mo></mrow></mrow></mrow><mo>+</mo><mrow><mrow><mstyle displaystyle="true"><mfrac><mrow><mi>n</mi><mo>+</mo><mn>1</mn></mrow><mi>n</mi></mfrac></mstyle><mo lspace="0.222em" rspace="0.222em">⋅</mo><msup><mrow><mo>[</mo><mtable rowspacing="0pt"><mtr><mtd><msub><mi>𝐯</mi><mn>21</mn></msub></mtd></mtr><mtr><mtd><msub><mi>v</mi><mn>22</mn></msub></mtd></mtr></mtable><mo>]</mo></mrow><mo>⊤</mo></msup></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝚺</mi><mi>joint</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><mtable rowspacing="0pt"><mtr><mtd><msub><mi>𝐐</mi><mn>11</mn></msub></mtd></mtr><mtr><mtd><msubsup><mi>𝐪</mi><mn>21</mn><mo>⊤</mo></msubsup></mtd></mtr></mtable><mo>]</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>𝚺</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo>[</mo><mtable rowspacing="0pt"><mtr><mtd><msub><mi>𝐐</mi><mn>11</mn></msub></mtd></mtr><mtr><mtd><msubsup><mi>𝐪</mi><mn>21</mn><mo>⊤</mo></msubsup></mtd></mtr></mtable><mo>]</mo></mrow><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝚺</mi><mi>joint</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><mtable rowspacing="0pt"><mtr><mtd><msub><mi>𝐯</mi><mn>21</mn></msub></mtd></mtr><mtr><mtd><msub><mi>v</mi><mn>22</mn></msub></mtd></mtr></mtable><mo>]</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\frac{1}{n}\cdot\tr\left(\begin{bmatrix}{\mathbf{Q}}_{11}\\
{\mathbf{q}}_{21}^{\top}\end{bmatrix}{\mathbf{\Sigma}}\begin{bmatrix}{\mathbf{Q}}_{11}\\
{\mathbf{q}}_{21}^{\top}\end{bmatrix}^{\top}\!{\mathbf{\Sigma}}_{\mathrm{joint}}\right)\cdot\begin{bmatrix}{\mathbf{v}}_{21}\\
v_{22}\end{bmatrix}^{\top}\!{\mathbf{\Sigma}}_{\mathrm{joint}}\begin{bmatrix}{\mathbf{v}}_{21}\\
v_{22}\end{bmatrix}+\frac{n+1}{n}\cdot\begin{bmatrix}{\mathbf{v}}_{21}\\
v_{22}\end{bmatrix}^{\top}\!{\mathbf{\Sigma}}_{\mathrm{joint}}\begin{bmatrix}{\mathbf{Q}}_{11}\\
{\mathbf{q}}_{21}^{\top}\end{bmatrix}{\mathbf{\Sigma}}\begin{bmatrix}{\mathbf{Q}}_{11}\\
{\mathbf{q}}_{21}^{\top}\end{bmatrix}^{\top}\!{\mathbf{\Sigma}}_{\mathrm{joint}}\begin{bmatrix}{\mathbf{v}}_{21}\\
v_{22}\end{bmatrix}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(118)</span></td></tr></tbody>
<tbody id="A1.E119"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
