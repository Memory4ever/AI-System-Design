<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.E170.m1" class="ltx_math_unparsed" alttext="\displaystyle\quad-2\cdot{\mathbf{v}}_{21}^{\top}\left(2{\mathbf{\Sigma}}{\mathbf{Q}}_{11}{\mathbf{\Sigma}}+\tr({\mathbf{Q}}_{11}{\mathbf{\Sigma}})\cdot{\mathbf{\Sigma}}+q\cdot{\mathbf{\Sigma}}\right){\mathbf{\theta}}_{0}+(n+2)\cdot({\mathbf{\theta}}_{0}^{\top}{\mathbf{\Sigma}}{\mathbf{\theta}}_{0}+\sigma^{2})" display="inline" intent=":literal"><semantics><mrow><mo>−</mo><mn>2</mn><mo lspace="0.222em" rspace="0.222em">⋅</mo><msubsup><mi>𝐯</mi><mn>21</mn><mo>⊤</mo></msubsup><mrow><mo>(</mo><mn>2</mn><mi>𝚺</mi><msub><mi>𝐐</mi><mn>11</mn></msub><mi>𝚺</mi><mo>+</mo><mi>tr</mi><mrow><mo stretchy="false">(</mo><msub><mi>𝐐</mi><mn>11</mn></msub><mi>𝚺</mi><mo rspace="0.055em" stretchy="false">)</mo></mrow><mo rspace="0.222em">⋅</mo><mi>𝚺</mi><mo>+</mo><mi>q</mi><mo lspace="0.222em" rspace="0.222em">⋅</mo><mi>𝚺</mi><mo>)</mo></mrow><msub><mi>θ</mi><mn>0</mn></msub><mo>+</mo><mrow><mo stretchy="false">(</mo><mi>n</mi><mo>+</mo><mn>2</mn><mo rspace="0.055em" stretchy="false">)</mo></mrow><mo rspace="0.222em">⋅</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>θ</mi><mn>0</mn><mo>⊤</mo></msubsup><mi>𝚺</mi><msub><mi>θ</mi><mn>0</mn></msub><mo>+</mo><msup><mi>σ</mi><mn>2</mn></msup><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\quad-2\cdot{\mathbf{v}}_{21}^{\top}\left(2{\mathbf{\Sigma}}{\mathbf{Q}}_{11}{\mathbf{\Sigma}}+\tr({\mathbf{Q}}_{11}{\mathbf{\Sigma}})\cdot{\mathbf{\Sigma}}+q\cdot{\mathbf{\Sigma}}\right){\mathbf{\theta}}_{0}+(n+2)\cdot({\mathbf{\theta}}_{0}^{\top}{\mathbf{\Sigma}}{\mathbf{\theta}}_{0}+\sigma^{2})</annotation></semantics></math></td>
