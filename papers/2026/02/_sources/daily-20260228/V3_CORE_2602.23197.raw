><mrow><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><mi>m</mi></mrow></msub><mi>σ</mi><msub><mrow></mrow><mrow><mi>m</mi><mo lspace="0em" rspace="0em">​</mo><mi>j</mi></mrow></msub></mrow><annotation encoding="application/x-tex">\displaystyle\quad+\sigma_{il}a^{\top}_{lk}\sigma_{kj}\cdot\sigma_{mn}b^{\top}_{nm}+\sigma_{il}a^{\top}_{lk}\sigma_{km}b_{mn}\sigma_{nj}+\sigma_{il}a^{\top}_{lk}\sigma_{kn}b^{\top}_{nm}\sigma_{mj}</annotation></semantics></math></td>
