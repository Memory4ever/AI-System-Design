<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.E99.m1" class="ltx_math_unparsed" alttext="\displaystyle\quad+2\tr({\mathbf{Q}}_{11}{\mathbf{\Sigma}})\cdot{\mathbf{\Sigma}}({\mathbf{Q}}_{11}+{\mathbf{Q}}_{11}^{\top}){\mathbf{\Sigma}}+2{\mathbf{\Sigma}}({\mathbf{Q}}_{11}+{\mathbf{Q}}_{11}^{\top}){\mathbf{\Sigma}}({\mathbf{Q}}_{11}+{\mathbf{Q}}_{11}^{\top}){\mathbf{\Sigma}}," display="inline" intent=":literal"><semantics><mrow><mo>+</mo><mn>2</mn><mi>tr</mi><mrow><mo stretchy="false">(</mo><msub><mi>𝐐</mi><mn>11</mn></msub><mi>𝚺</mi><mo rspace="0.055em" stretchy="false">)</mo></mrow><mo rspace="0.222em">⋅</mo><mi>𝚺</mi><mrow><mo stretchy="false">(</mo><msub><mi>𝐐</mi><mn>11</mn></msub><mo>+</mo><msubsup><mi>𝐐</mi><mn>11</mn><mo>⊤</mo></msubsup><mo stretchy="false">)</mo></mrow><mi>𝚺</mi><mo>+</mo><mn>2</mn><mi>𝚺</mi><mrow><mo stretchy="false">(</mo><msub><mi>𝐐</mi><mn>11</mn></msub><mo>+</mo><msubsup><mi>𝐐</mi><mn>11</mn><mo>⊤</mo></msubsup><mo stretchy="false">)</mo></mrow><mi>𝚺</mi><mrow><mo stretchy="false">(</mo><msub><mi>𝐐</mi><mn>11</mn></msub><mo>+</mo><msubsup><mi>𝐐</mi><mn>11</mn><mo>⊤</mo></msubsup><mo stretchy="false">)</mo></mrow><mi>𝚺</mi><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\quad+2\tr({\mathbf{Q}}_{11}{\mathbf{\Sigma}})\cdot{\mathbf{\Sigma}}({\mathbf{Q}}_{11}+{\mathbf{Q}}_{11}^{\top}){\mathbf{\Sigma}}+2{\mathbf{\Sigma}}({\mathbf{Q}}_{11}+{\mathbf{Q}}_{11}^{\top}){\mathbf{\Sigma}}({\mathbf{Q}}_{11}+{\mathbf{Q}}_{11}^{\top}){\mathbf{\Sigma}},</annotation></semantics></math></td>
