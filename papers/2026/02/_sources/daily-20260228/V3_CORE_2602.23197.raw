<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.E62.m1" class="ltx_math_unparsed" alttext="\displaystyle\quad+{\mathbf{\Sigma}}{\mathbf{B}}{\mathbf{\Sigma}}\cdot\tr({\mathbf{\Sigma}}{\mathbf{A}}^{\top})+{\mathbf{\Sigma}}{\mathbf{B}}{\mathbf{\Sigma}}{\mathbf{A}}{\mathbf{\Sigma}}+{\mathbf{\Sigma}}{\mathbf{B}}{\mathbf{\Sigma}}{\mathbf{A}}^{\top}{\mathbf{\Sigma}}+{\mathbf{\Sigma}}{\mathbf{B}}^{\top}{\mathbf{\Sigma}}\cdot\tr({\mathbf{\Sigma}}{\mathbf{A}}^{\top})+{\mathbf{\Sigma}}{\mathbf{B}}^{\top}{\mathbf{\Sigma}}{\mathbf{A}}{\mathbf{\Sigma}}+{\mathbf{\Sigma}}{\mathbf{B}}^{\top}{\mathbf{\Sigma}}{\mathbf{A}}^{\top}{\mathbf{\Sigma}}" display="inline" intent=":literal"><semantics><mrow><mo>+</mo><mi>𝚺</mi><mi>𝐁</mi><mi>𝚺</mi><mo lspace="0.222em" rspace="0.222em">⋅</mo><mi>tr</mi><mrow><mo stretchy="false">(</mo><mi>𝚺</mi><msup><mi>𝐀</mi><mo>⊤</mo></msup><mo stretchy="false">)</mo></mrow><mo>+</mo><mi>𝚺</mi><mi>𝐁</mi><mi>𝚺</mi><mi>𝐀</mi><mi>𝚺</mi><mo>+</mo><mi>𝚺</mi><mi>𝐁</mi><mi>𝚺</mi><msup><mi>𝐀</mi><mo>⊤</mo></msup><mi>𝚺</mi><mo>+</mo><mi>𝚺</mi><msup><mi>𝐁</mi><mo>⊤</mo></msup><mi>𝚺</mi><mo lspace="0.222em" rspace="0.222em">⋅</mo><mi>tr</mi><mrow><mo stretchy="false">(</mo><mi>𝚺</mi><msup><mi>𝐀</mi><mo>⊤</mo></msup><mo stretchy="false">)</mo></mrow><mo>+</mo><mi>𝚺</mi><msup><mi>𝐁</mi><mo>⊤</mo></msup><mi>𝚺</mi><mi>𝐀</mi><mi>𝚺</mi><mo>+</mo><mi>𝚺</mi><msup><mi>𝐁</mi><mo>⊤</mo></msup><mi>𝚺</mi><msup><mi>𝐀</mi><mo>⊤</mo></msup><mi>𝚺</mi></mrow><annotation encoding="application/x-tex">\displaystyle\quad+{\mathbf{\Sigma}}{\mathbf{B}}{\mathbf{\Sigma}}\cdot\tr({\mathbf{\Sigma}}{\mathbf{A}}^{\top})+{\mathbf{\Sigma}}{\mathbf{B}}{\mathbf{\Sigma}}{\mathbf{A}}{\mathbf{\Sigma}}+{\mathbf{\Sigma}}{\mathbf{B}}{\mathbf{\Sigma}}{\mathbf{A}}^{\top}{\mathbf{\Sigma}}+{\mathbf{\Sigma}}{\mathbf{B}}^{\top}{\mathbf{\Sigma}}\cdot\tr({\mathbf{\Sigma}}{\mathbf{A}}^{\top})+{\mathbf{\Sigma}}{\mathbf{B}}^{\top}{\mathbf{\Sigma}}{\mathbf{A}}{\mathbf{\Sigma}}+{\mathbf{\Sigma}}{\mathbf{B}}^{\top}{\mathbf{\Sigma}}{\mathbf{A}}^{\top}{\mathbf{\Sigma}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(62)</span></td></tr></tbody>
<tbody id="A1.E63"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.E63.m1" class="ltx_Math" alttext="\displaystyle=\tr({\mathbf{A}}{\mathbf{\Sigma}})\tr({\mathbf{B}}{\mathbf{\Sigma}})\cdot{\mathbf{\Sigma}}+\tr({\mathbf{A}}{\mathbf{\Sigma}}{\mathbf{B}}{\mathbf{\Sigma}})\cdot{\mathbf{\Sigma}}+\tr({\mathbf{A}}{\mathbf{\Sigma}}{\mathbf{B}}^{\top}{\mathbf{\Sigma}})\cdot{\mathbf{\Sigma}}+\tr({\mathbf{A}}{\mathbf{\Sigma}})\cdot{\mathbf{\Sigma}}({\mathbf{B}}+{\mathbf{B}}^{\top}){\mathbf{\Sigma}}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><mrow><mrow><mi>tr</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>𝐀</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝚺</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>tr</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>𝐁</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝚺</mi></mrow><mo rspace="0.055em" stretchy="false">)</mo></mrow></mrow></mrow><mo rspace="0.222em">⋅</mo><mi>𝚺</mi></mrow><mo>+</mo><mrow><mrow><mi>tr</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>𝐀</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝚺</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝐁</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝚺</mi></mrow><mo rspace="0.055em" stretchy="false">)</mo></mrow></mrow><mo rspace="0.222em">⋅</mo><mi>𝚺</mi></mrow><mo>+</mo><mrow><mrow><mi>tr</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>𝐀</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝚺</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝐁</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>𝚺</mi></mrow><mo rspace="0.055em" stretchy="false">)</mo></mrow></mrow><mo rspace="0.222em">⋅</mo><mi>𝚺</mi></mrow><mo>+</mo><mrow><mrow><mrow><mi>tr</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>𝐀</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝚺</mi></mrow><mo rspace="0.055em" stretchy="false">)</mo></mrow></mrow><mo rspace="0.222em">⋅</mo><mrow><mi>𝚺</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>𝐁</mi><mo>+</mo><msup><mi>𝐁</mi><mo>⊤</mo></msup></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><mi>𝚺</mi></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\tr({\mathbf{A}}{\mathbf{\Sigma}})\tr({\mathbf{B}}{\mathbf{\Sigma}})\cdot{\mathbf{\Sigma}}+\tr({\mathbf{A}}{\mathbf{\Sigma}}{\mathbf{B}}{\mathbf{\Sigma}})\cdot{\mathbf{\Sigma}}+\tr({\mathbf{A}}{\mathbf{\Sigma}}{\mathbf{B}}^{\top}{\mathbf{\Sigma}})\cdot{\mathbf{\Sigma}}+\tr({\mathbf{A}}{\mathbf{\Sigma}})\cdot{\mathbf{\Sigma}}({\mathbf{B}}+{\mathbf{B}}^{\top}){\mathbf{\Sigma}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(63)</span></td></tr></tbody>
<tbody id="A1.E64"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.E64.m1" class="ltx_math_unparsed" alttext="\displaystyle\quad+\tr({\mathbf{B}}{\mathbf{\Sigma}})\cdot{\mathbf{\Sigma}}({\mathbf{A}}+{\mathbf{A}}^{\top}){\mathbf{\Sigma}}+{\mathbf{\Sigma}}({\mathbf{A}}+{\mathbf{A}}^{\top}){\mathbf{\Sigma}}({\mathbf{B}}+{\mathbf{B}}^{\top}){\mathbf{\Sigma}}+{\mathbf{\Sigma}}({\mathbf{B}}+{\mathbf{B}}^{\top}){\mathbf{\Sigma}}({\mathbf{A}}+{\mathbf{A}}^{\top}){\mathbf{\Sigma}}." display="inline" intent=":literal"><semantics><mrow><mo>+</mo><mi>tr</mi><mrow><mo stretchy="false">(</mo><mi>𝐁</mi><mi>𝚺</mi><mo rspace="0.055em" stretchy="false">)</mo></mrow><mo rspace="0.222em">⋅</mo><mi>𝚺</mi><mrow><mo stretchy="false">(</mo><mi>𝐀</mi><mo>+</mo><msup><mi>𝐀</mi><mo>⊤</mo></msup><mo stretchy="false">)</mo></mrow><mi>𝚺</mi><mo>+</mo><mi>𝚺</mi><mrow><mo stretchy="false">(</mo><mi>𝐀</mi><mo>+</mo><msup><mi>𝐀</mi><mo>⊤</mo></msup><mo stretchy="false">)</mo></mrow><mi>𝚺</mi><mrow><mo stretchy="false">(</mo><mi>𝐁</mi><mo>+</mo><msup><mi>𝐁</mi><mo>⊤</mo></msup><mo stretchy="false">)</mo></mrow><mi>𝚺</mi><mo>+</mo><mi>𝚺</mi><mrow><mo stretchy="false">(</mo><mi>𝐁</mi><mo>+</mo><msup><mi>𝐁</mi><mo>⊤</mo></msup><mo stretchy="false">)</mo></mrow><mi>𝚺</mi><mrow><mo stretchy="false">(</mo><mi>𝐀</mi><mo>+</mo><msup><mi>𝐀</mi><mo>⊤</mo></msup><mo stretchy="false">)</mo></mrow><mi>𝚺</mi><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\quad+\tr({\mathbf{B}}{\mathbf{\Sigma}})\cdot{\mathbf{\Sigma}}({\mathbf{A}}+{\mathbf{A}}^{\top}){\mathbf{\Sigma}}+{\mathbf{\Sigma}}({\mathbf{A}}+{\mathbf{A}}^{\top}){\mathbf{\Sigma}}({\mathbf{B}}+{\mathbf{B}}^{\top}){\mathbf{\Sigma}}+{\mathbf{\Sigma}}({\mathbf{B}}+{\mathbf{B}}^{\top}){\mathbf{\Sigma}}({\mathbf{A}}+{\mathbf{A}}^{\top}){\mathbf{\Sigma}}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(64)</span></td></tr></tbody>
</table>
<p id="A1.SS1.p4.3" class="ltx_p"><span id="A1.SS1.p4.3.1" class="ltx_text">Moreover, if <math id="A1.SS1.p4.m1" class="ltx_Math" alttext="{\mathbf{A}}={\mathbf{B}}^{\top}" display="inline" intent=":literal"><semantics><mrow><mi>𝐀</mi><mo>=</mo><msup><mi>𝐁</mi><mo>⊤</mo></msup></mrow><annotation encoding="application/x-tex">{\mathbf{A}}={\mathbf{B}}^{\top}</annotation></semantics></math>, we have</span></p>
<table id="A1.EGx24" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A1.E65"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.E65.m1" class="ltx_Math" alttext="\displaystyle\displaystyle\mathbb{E}[{\mathbf{x}}{\mathbf{x}}^{\top}{\mathbf{A}}{\mathbf{x}}{\mathbf{x}}^{\top}{\mathbf{B}}{\mathbf{x}}{\mathbf{x}}^{\top}]" display="inline" intent=":literal"><semantics><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><msup><mi>𝐱𝐱</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝐀𝐱𝐱</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝐁𝐱𝐱</mi><mo>⊤</mo></msup></mrow><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\displaystyle\mathbb{E}[{\mathbf{x}}{\mathbf{x}}^{\top}{\mathbf{A}}{\mathbf{x}}{\mathbf{x}}^{\top}{\mathbf{B}}{\mathbf{x}}{\mathbf{x}}^{\top}]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(65)</span></td></tr></tbody>
<tbody id="A1.E66"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.E66.m1" class="ltx_Math" alttext="\displaystyle=\tr({\mathbf{A}}{\mathbf{\Sigma}})\tr({\mathbf{A}}^{\top}{\mathbf{\Sigma}})\cdot{\mathbf{\Sigma}}+\tr({\mathbf{A}}{\mathbf{\Sigma}}{\mathbf{A}}^{\top}{\mathbf{\Sigma}})\cdot{\mathbf{\Sigma}}+\tr({\mathbf{A}}{\mathbf{\Sigma}}{\mathbf{A}}{\mathbf{\Sigma}})\cdot{\mathbf{\Sigma}}+\tr({\mathbf{A}}{\mathbf{\Sigma}})\cdot{\mathbf{\Sigma}}({\mathbf{A}}+{\mathbf{A}}^{\top}){\mathbf{\Sigma}}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><mrow><mrow><mi>tr</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>𝐀</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝚺</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>tr</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mi>𝐀</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>𝚺</mi></mrow><mo rspace="0.055em" stretchy="false">)</mo></mrow></mrow></mrow><mo rspace="0.222em">⋅</mo><mi>𝚺</mi></mrow><mo>+</mo><mrow><mrow><mi>tr</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>𝐀</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝚺</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝐀</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>𝚺</mi></mrow><mo rspace="0.055em" stretchy="false">)</mo></mrow></mrow><mo rspace="0.222em">⋅</mo><mi>𝚺</mi></mrow><mo>+</mo><mrow><mrow><mi>tr</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>𝐀</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝚺</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝐀</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝚺</mi></mrow><mo rspace="0.055em" stretchy="false">)</mo></mrow></mrow><mo rspace="0.222em">⋅</mo><mi>𝚺</mi></mrow><mo>+</mo><mrow><mrow><mrow><mi>tr</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>𝐀</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝚺</mi></mrow><mo rspace="0.055em" stretchy="false">)</mo></mrow></mrow><mo rspace="0.222em">⋅</mo><mrow><mi>𝚺</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>𝐀</mi><mo>+</mo><msup><mi>𝐀</mi><mo>⊤</mo></msup></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><mi>𝚺</mi></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\tr({\mathbf{A}}{\mathbf{\Sigma}})\tr({\mathbf{A}}^{\top}{\mathbf{\Sigma}})\cdot{\mathbf{\Sigma}}+\tr({\mathbf{A}}{\mathbf{\Sigma}}{\mathbf{A}}^{\top}{\mathbf{\Sigma}})\cdot{\mathbf{\Sigma}}+\tr({\mathbf{A}}{\mathbf{\Sigma}}{\mathbf{A}}{\mathbf{\Sigma}})\cdot{\mathbf{\Sigma}}+\tr({\mathbf{A}}{\mathbf{\Sigma}})\cdot{\mathbf{\Sigma}}({\mathbf{A}}+{\mathbf{A}}^{\top}){\mathbf{\Sigma}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(66)</span></td></tr></tbody>
<tbody id="A1.E67"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.E67.m1" class="ltx_math_unparsed" alttext="\displaystyle\quad+\tr({\mathbf{A}}^{\top}{\mathbf{\Sigma}})\cdot{\mathbf{\Sigma}}({\mathbf{A}}+{\mathbf{A}}^{\top}){\mathbf{\Sigma}}+2{\mathbf{\Sigma}}({\mathbf{A}}+{\mathbf{A}}^{\top}){\mathbf{\Sigma}}({\mathbf{A}}+{\mathbf{A}}^{\top}){\mathbf{\Sigma}}" display="inline" intent=":literal"><semantics><mrow><mo>+</mo><mi>tr</mi><mrow><mo stretchy="false">(</mo><msup><mi>𝐀</mi><mo>⊤</mo></msup><mi>𝚺</mi><mo rspace="0.055em" stretchy="false">)</mo></mrow><mo rspace="0.222em">⋅</mo><mi>𝚺</mi><mrow><mo stretchy="false">(</mo><mi>𝐀</mi><mo>+</mo><msup><mi>𝐀</mi><mo>⊤</mo></msup><mo stretchy="false">)</mo></mrow><mi>𝚺</mi><mo>+</mo><mn>2</mn><mi>𝚺</mi><mrow><mo stretchy="false">(</mo><mi>𝐀</mi><mo>+</mo><msup><mi>𝐀</mi><mo>⊤</mo></msup><mo stretchy="false">)</mo></mrow><mi>𝚺</mi><mrow><mo stretchy="false">(</mo><mi>𝐀</mi><mo>+</mo><msup><mi>𝐀</mi><mo>⊤</mo></msup><mo stretchy="false">)</mo></mrow><mi>𝚺</mi></mrow><annotation encoding="application/x-tex">\displaystyle\quad+\tr({\mathbf{A}}^{\top}{\mathbf{\Sigma}})\cdot{\mathbf{\Sigma}}({\mathbf{A}}+{\mathbf{A}}^{\top}){\mathbf{\Sigma}}+2{\mathbf{\Sigma}}({\mathbf{A}}+{\mathbf{A}}^{\top}){\mathbf{\Sigma}}({\mathbf{A}}+{\mathbf{A}}^{\top}){\mathbf{\Sigma}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(67)</span></td></tr></tbody>
<tbody id="A1.E68"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.E68.m1" class="ltx_Math" alttext="\displaystyle=\tr({\mathbf{A}}{\mathbf{\Sigma}})^{2}\cdot{\mathbf{\Sigma}}+\tr({\mathbf{A}}{\mathbf{\Sigma}}{\mathbf{A}}^{\top}{\mathbf{\Sigma}})\cdot{\mathbf{\Sigma}}+\tr({\mathbf{A}}{\mathbf{\Sigma}}{\mathbf{A}}{\mathbf{\Sigma}})\cdot{\mathbf{\Sigma}}+2\tr({\mathbf{A}}{\mathbf{\Sigma}})\cdot{\mathbf{\Sigma}}({\mathbf{A}}+{\mathbf{A}}^{\top}){\mathbf{\Sigma}}+2{\mathbf{\Sigma}}({\mathbf{A}}+{\mathbf{A}}^{\top}){\mathbf{\Sigma}}({\mathbf{A}}+{\mathbf{A}}^{\top}){\mathbf{\Sigma}}," display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><mrow><mi>tr</mi><mo>⁡</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mi>𝐀</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝚺</mi></mrow><mo rspace="0.055em" stretchy="false">)</mo></mrow><mn>2</mn></msup></mrow><mo rspace="0.222em">⋅</mo><mi>𝚺</mi></mrow><mo>+</mo><mrow><mrow><mi>tr</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>𝐀</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝚺</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝐀</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>𝚺</mi></mrow><mo rspace="0.055em" stretchy="false">)</mo></mrow></mrow><mo rspace="0.222em">⋅</mo><mi>𝚺</mi></mrow><mo>+</mo><mrow><mrow><mi>tr</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>𝐀</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝚺</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝐀</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝚺</mi></mrow><mo rspace="0.055em" stretchy="false">)</mo></mrow></mrow><mo rspace="0.222em">⋅</mo><mi>𝚺</mi></mrow><mo>+</mo><mrow><mrow><mrow><mn>2</mn><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>tr</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>𝐀</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝚺</mi></mrow><mo rspace="0.055em" stretchy="false">)</mo></mrow></mrow></mrow><mo rspace="0.222em">⋅</mo><mrow><mi>𝚺</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>𝐀</mi><mo>+</mo><msup><mi>𝐀</mi><mo>⊤</mo></msup></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><mi>𝚺</mi></mrow><mo>+</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>𝚺</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>𝐀</mi><mo>+</mo><msup><mi>𝐀</mi><mo>⊤</mo></msup></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>𝚺</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>𝐀</mi><mo>+</mo><msup><mi>𝐀</mi><mo>⊤</mo></msup></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>𝚺</mi></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle=\tr({\mathbf{A}}{\mathbf{\Sigma}})^{2}\cdot{\mathbf{\Sigma}}+\tr({\mathbf{A}}{\mathbf{\Sigma}}{\mathbf{A}}^{\top}{\mathbf{\Sigma}})\cdot{\mathbf{\Sigma}}+\tr({\mathbf{A}}{\mathbf{\Sigma}}{\mathbf{A}}{\mathbf{\Sigma}})\cdot{\mathbf{\Sigma}}+2\tr({\mathbf{A}}{\mathbf{\Sigma}})\cdot{\mathbf{\Sigma}}({\mathbf{A}}+{\mathbf{A}}^{\top}){\mathbf{\Sigma}}+2{\mathbf{\Sigma}}({\mathbf{A}}+{\mathbf{A}}^{\top}){\mathbf{\Sigma}}({\mathbf{A}}+{\mathbf{A}}^{\top}){\mathbf{\Sigma}},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(68)</span></td></tr></tbody>
</table>
<p id="A1.SS1.p4.4" class="ltx_p"><span id="A1.SS1.p4.4.1" class="ltx_text">where the last equality follows from the fact that <math id="A1.SS1.p4.m2" class="ltx_Math" alttext="\tr({\mathbf{A}}{\mathbf{\Sigma}})=\tr({\mathbf{\Sigma}}{\mathbf{A}}^{\top})=\tr({\mathbf{A}}^{\top}{\mathbf{\Sigma}})" display="inline" intent=":literal"><semantics><mrow><mrow><mi>tr</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>𝐀</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝚺</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mi>tr</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>𝚺</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝐀</mi><mo>⊤</mo></msup></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mi>tr</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mi>𝐀</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>𝚺</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\tr({\mathbf{A}}{\mathbf{\Sigma}})=\tr({\mathbf{\Sigma}}{\mathbf{A}}^{\top})=\tr({\mathbf{A}}^{\top}{\mathbf{\Sigma}})</annotation></semantics></math>.
One can confirm that this result for <math id="A1.SS1.p4.m3" class="ltx_Math" alttext="{\mathbf{A}}={\mathbf{B}}={\mathbf{I}}" display="inline" intent=":literal"><semantics><mrow><mi>𝐀</mi><mo>=</mo><mi>𝐁</mi><mo>=</mo><mi>𝐈</mi></mrow><annotation encoding="application/x-tex">{\mathbf{A}}={\mathbf{B}}={\mathbf{I}}</annotation></semantics></math> is consistent with Lemma <a href="#A1.Thmtheorem2" title="Lemma A.2 (Theorem 4.2 in ( ) ; see also ( ) ). ‣ A.1 Proofs of Preliminary Lemma ‣ Appendix A Proofs ‣ Fine-Tuning Without Forgetting In-Context Learning:A Theoretical Analysis of Linear Attention Models" class="ltx_ref"><span class="ltx_text ltx_ref_tag">A.2</span></a> in the special case where <math id="A1.SS1.p4.m4" class="ltx_Math" alttext="{\mathbf{A}}={\mathbf{B}}={\mathbf{C}}={\mathbf{I}}" display="inline" intent=":literal"><semantics><mrow><mi>𝐀</mi><mo>=</mo><mi>𝐁</mi><mo>=</mo><mi>𝐂</mi><mo>=</mo><mi>𝐈</mi></mrow><annotation encoding="application/x-tex">{\mathbf{A}}={\mathbf{B}}={\mathbf{C}}={\mathbf{I}}</annotation></semantics></math>.
∎</span></p>
</div>
</div>
<div class="ltx_pagination ltx_role_newpage"></div>
</section>
<section id="A1.SS2" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">A.2 </span>Proofs of Statistical Properties of Model Outputs</h3>

<div id="A1.SS2.p1" class="ltx_para">
<p id="A1.SS2.p1.1" class="ltx_p">Given the task vector <math id="A1.SS2.p1.m1" class="ltx_Math" alttext="{\mathbf{\theta}}_{0}\in{\mathbb{R}}^{d}" display="inline" intent=":literal"><semantics><mrow><msub><mi>θ</mi><mn>0</mn></msub><mo>∈</mo><msup><mi>ℝ</mi><mi>d</mi></msup></mrow><annotation encoding="application/x-tex">{\mathbf{\theta}}_{0}\in{\mathbb{R}}^{d}</annotation></semantics></math>, the test data point <math id="A1.SS2.p1.m2" class="ltx_Math" alttext="({\mathbf{x}}_{i},y_{i})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><msub><mi>𝐱</mi><mi>i</mi></msub><mo>,</mo><msub><mi>y</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">({\mathbf{x}}_{i},y_{i})</annotation></semantics></math> for <math id="A1.SS2.p1.m3" class="ltx_Math" alttext="i\in[n+1]" display="inline" intent=":literal"><semantics><mrow><mi>i</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mrow><mi>n</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">i\in[n+1]</annotation></semantics></math> is independently generated as</p>
<table id="A1.EGx25" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A1.E69"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A1.E69.m1" class="ltx_Math" alttext="\displaystyle{\mathbf{x}}_{i}" display="inline" intent=":literal"><semantics><msub><mi>𝐱</mi><mi>i</mi></msub><annotation encoding="application/x-tex">\displaystyle{\mathbf{x}}_{i}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.E69.m2" class="ltx_Math" alttext="\displaystyle\overset{\mathrm{iid}}{\sim}\mathcal{N}(\mathbf{0}_{d},{\mathbf{\Sigma}})," display="inline" intent=":literal"><semantics><mrow><mrow><mover accent="true"><mo>∼</mo><mo mathsize="0.700em">iid</mo></mover><mo lspace="0em" rspace="0em">​</mo><mi class="ltx_font_mathcaligraphic">𝒩</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mn>𝟎</mn><mi>d</mi></msub><mo>,</mo><mi>𝚺</mi><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\overset{\mathrm{iid}}{\sim}\mathcal{N}(\mathbf{0}_{d},{\mathbf{\Sigma}}),</annotation></semantics></math></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A1.E69.m3" class="ltx_Math" alttext="\displaystyle e_{i}" display="inline" intent=":literal"><semantics><msub><mi>e</mi><mi>i</mi></msub><annotation encoding="application/x-tex">\displaystyle e_{i}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.E69.m4" class="ltx_Math" alttext="\displaystyle\overset{\mathrm{iid}}{\sim}\mathcal{N}(0,\sigma^{2})," display="inline" intent=":literal"><semantics><mrow><mrow><mover accent="true"><mo>∼</mo><mo mathsize="0.700em">iid</mo></mover><mo lspace="0em" rspace="0em">​</mo><mi class="ltx_font_mathcaligraphic">𝒩</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mn>0</mn><mo>,</mo><msup><mi>σ</mi><mn>2</mn></msup><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\overset{\mathrm{iid}}{\sim}\mathcal{N}(0,\sigma^{2}),</annotation></semantics></math></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A1.E69.m5" class="ltx_Math" alttext="\displaystyle y_{i}" display="inline" intent=":literal"><semantics><msub><mi>y</mi><mi>i</mi></msub><annotation encoding="application/x-tex">\displaystyle y_{i}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.E69.m6" class="ltx_Math" alttext="\displaystyle={\mathbf{\theta}}_{0}^{\top}{\mathbf{x}}_{i}+e_{i}." display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><msubsup><mi>θ</mi><mn>0</mn><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝐱</mi><mi>i</mi></msub></mrow><mo>+</mo><msub><mi>e</mi><mi>i</mi></msub></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle={\mathbf{\theta}}_{0}^{\top}{\mathbf{x}}_{i}+e_{i}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(69)</span></td></tr></tbody>
</table>
</div>
<div id="A1.SS2.p2" class="ltx_para">
<p id="A1.SS2.p2.1" class="ltx_p">It follows that for each <math id="A1.SS2.p2.m1" class="ltx_Math" alttext="i\in[n+1]" display="inline" intent=":literal"><semantics><mrow><mi>i</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mrow><mi>n</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">i\in[n+1]</annotation></semantics></math>, we have <math id="A1.SS2.p2.m2" class="ltx_Math" alttext="y_{i}\overset{\mathrm{iid}}{\sim}\mathcal{N}(0,{\mathbf{\theta}}_{0}^{\top}{\mathbf{\Sigma}}{\mathbf{\theta}}_{0}+\sigma^{2})" display="inline" intent=":literal"><semantics><mrow><msub><mi>y</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mover accent="true"><mo>∼</mo><mo mathsize="0.700em">iid</mo></mover><mo lspace="0em" rspace="0em">​</mo><mi class="ltx_font_mathcaligraphic">𝒩</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mn>0</mn><mo>,</mo><mrow><mrow><msubsup><mi>θ</mi><mn>0</mn><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>𝚺</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>θ</mi><mn>0</mn></msub></mrow><mo>+</mo><msup><mi>σ</mi><mn>2</mn></msup></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">y_{i}\overset{\mathrm{iid}}{\sim}\mathcal{N}(0,{\mathbf{\theta}}_{0}^{\top}{\mathbf{\Sigma}}{\mathbf{\theta}}_{0}+\sigma^{2})</annotation></semantics></math> and thus</p>
<table id="A1.E70" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A1.E70.m1" class="ltx_Math" alttext="\begin{bmatrix}{\mathbf{x}}_{i}\\
y_{i}\end{bmatrix}\overset{\mathrm{iid}}{\sim}\mathcal{N}\left({\mathbf{0}}_{d+1},{\mathbf{\Sigma}}_{\mathrm{joint}}\right),\qquad{\mathbf{\Sigma}}_{\mathrm{joint}}:=\begin{bmatrix}{\mathbf{\Sigma}}&{\mathbf{\Sigma}}{\mathbf{\theta}}_{0}\\
{\mathbf{\theta}}_{0}^{\top}{\mathbf{\Sigma}}&{\mathbf{\theta}}_{0}^{\top}{\mathbf{\Sigma}}{\mathbf{\theta}}_{0}+\sigma^{2}\end{bmatrix}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mrow><mo>[</mo><mtable displaystyle="true" rowspacing="0pt"><mtr><mtd><msub><mi>𝐱</mi><mi>i</mi></msub></mtd></mtr><mtr><mtd><msub><mi>y</mi><mi>i</mi></msub></mtd></mtr></mtable><mo>]</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mover accent="true"><mo>∼</mo><mo mathsize="0.700em">iid</mo></mover><mo lspace="0em" rspace="0em">​</mo><mi class="ltx_font_mathcaligraphic">𝒩</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><msub><mn>𝟎</mn><mrow><mi>d</mi><mo>+</mo><mn>1</mn></mrow></msub><mo>,</mo><msub><mi>𝚺</mi><mi>joint</mi></msub><mo>)</mo></mrow></mrow><mo rspace="2.167em">,</mo><mrow><msub><mi>𝚺</mi><mi>joint</mi></msub><mo>:=</mo><mrow><mo>[</mo><mtable columnspacing="5pt" displaystyle="true" rowspacing="0pt"><mtr><mtd><mi>𝚺</mi></mtd><mtd><mrow><mi>𝚺</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>θ</mi><mn>0</mn></msub></mrow></mtd></mtr><mtr><mtd><mrow><msubsup><mi>θ</mi><mn>0</mn><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>𝚺</mi></mrow></mtd><mtd><mrow><mrow><msubsup><mi>θ</mi><mn>0</mn><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>𝚺</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>θ</mi><mn>0</mn></msub></mrow><mo>+</mo><msup><mi>σ</mi><mn>2</mn></msup></mrow></mtd></mtr></mtable><mo>]</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\begin{bmatrix}{\mathbf{x}}_{i}\\
y_{i}\end{bmatrix}\overset{\mathrm{iid}}{\sim}\mathcal{N}\left({\mathbf{0}}_{d+1},{\mathbf{\Sigma}}_{\mathrm{joint}}\right),\qquad{\mathbf{\Sigma}}_{\mathrm{joint}}:=\begin{bmatrix}{\mathbf{\Sigma}}&amp;{\mathbf{\Sigma}}{\mathbf{\theta}}_{0}\\
{\mathbf{\theta}}_{0}^{\top}{\mathbf{\Sigma}}&amp;{\mathbf{\theta}}_{0}^{\top}{\mathbf{\Sigma}}{\mathbf{\theta}}_{0}+\sigma^{2}\end{bmatrix}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(70)</span></td></tr></tbody>
</table>
<p id="A1.SS2.p2.2" class="ltx_p">Based on these distributions, we have to determine the statistics of the predictions, which are defined as</p>
<table id="A1.EGx26" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A1.E71"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A1.E71.m1" class="ltx_Math" alttext="\displaystyle\hat{y}_{\mathrm{FS}}({\mathbf{Z}}_{[n]},{\mathbf{x}}_{n+1};{\mathbf{V}},{\mathbf{Q}})" display="inline" intent=":literal"><semantics><mrow><msub><mover accent="true"><mi>y</mi><mo>^</mo></mover><mi>FS</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐙</mi><mrow><mo stretchy="false">[</mo><mi>n</mi><mo stretchy="false">]</mo></mrow></msub><mo>,</mo><msub><mi>𝐱</mi><mrow><mi>n</mi><mo>+</mo><mn>1</mn></mrow></msub><mo>,</mo><mi>𝐕</mi><mo>,</mo><mi>𝐐</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\hat{y}_{\mathrm{FS}}({\mathbf{Z}}_{[n]},{\mathbf{x}}_{n+1};{\mathbf{V}},{\mathbf{Q}})</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.E71.m2" class="ltx_Math" alttext="\displaystyle:=\frac{n}{n+1}\cdot\hat{y}_{\mathrm{Net\text{-}FS}}({\mathbf{Z}}_{[n]},{\mathbf{x}}_{n+1};{\mathbf{V}},{\mathbf{Q}})+\frac{1}{n+1}\cdot\hat{y}_{\mathrm{ZS}}({\mathbf{x}}_{n+1};{\mathbf{V}},{\mathbf{Q}})," display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><mrow><mstyle displaystyle="true"><mfrac><mi>n</mi><mrow><mi>n</mi><mo>+</mo><mn>1</mn></mrow></mfrac></mstyle><mo lspace="0.222em" rspace="0.222em">⋅</mo><msub><mover accent="true"><mi>y</mi><mo>^</mo></mover><mrow><mi>Net</mi><mo lspace="0em" rspace="0em">​</mo><mtext>-</mtext><mo lspace="0em" rspace="0em">​</mo><mi>FS</mi></mrow></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐙</mi><mrow><mo stretchy="false">[</mo><mi>n</mi><mo stretchy="false">]</mo></mrow></msub><mo>,</mo><msub><mi>𝐱</mi><mrow><mi>n</mi><mo>+</mo><mn>1</mn></mrow></msub><mo>,</mo><mi>𝐕</mi><mo>,</mo><mi>𝐐</mi><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mrow><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mrow><mi>n</mi><mo>+</mo><mn>1</mn></mrow></mfrac></mstyle><mo lspace="0.222em" rspace="0.222em">⋅</mo><msub><mover accent="true"><mi>y</mi><mo>^</mo></mover><mi>ZS</mi></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐱</mi><mrow><mi>n</mi><mo>+</mo><mn>1</mn></mrow></msub><mo>,</mo><mi>𝐕</mi><mo>,</mo><mi>𝐐</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle:=\frac{n}{n+1}\cdot\hat{y}_{\mathrm{Net\text{-}FS}}({\mathbf{Z}}_{[n]},{\mathbf{x}}_{n+1};{\mathbf{V}},{\mathbf{Q}})+\frac{1}{n+1}\cdot\hat{y}_{\mathrm{ZS}}({\mathbf{x}}_{n+1};{\mathbf{V}},{\mathbf{Q}}),</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(71)</span></td></tr></tbody>
</table>
<p id="A1.SS2.p2.3" class="ltx_p">where</p>
<table id="A1.EGx27" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A1.E72"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A1.E72.m1" class="ltx_Math" alttext="\displaystyle\hat{y}_{\mathrm{Net\text{-}FS}}({\mathbf{Z}}_{[n]},{\mathbf{x}}_{n+1};{\mathbf{V}},{\mathbf{Q}})" display="inline" intent=":literal"><semantics><mrow><msub><mover accent="true"><mi>y</mi><mo>^</mo></mover><mrow><mi>Net</mi><mo lspace="0em" rspace="0em">​</mo><mtext>-</mtext><mo lspace="0em" rspace="0em">​</mo><mi>FS</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐙</mi><mrow><mo stretchy="false">[</mo><mi>n</mi><mo stretchy="false">]</mo></mrow></msub><mo>,</mo><msub><mi>𝐱</mi><mrow><mi>n</mi><mo>+</mo><mn>1</mn></mrow></msub><mo>,</mo><mi>𝐕</mi><mo>,</mo><mi>𝐐</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\hat{y}_{\mathrm{Net\text{-}FS}}({\mathbf{Z}}_{[n]},{\mathbf{x}}_{n+1};{\mathbf{V}},{\mathbf{Q}})</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.E72.m2" class="ltx_Math" alttext="\displaystyle:=\begin{bmatrix}{\mathbf{v}}_{21}\\
v_{22}\end{bmatrix}^{\top}\Big(\frac{1}{n}\sum_{i\in[n]}\begin{bmatrix}{\mathbf{x}}_{i}\\
y_{i}\end{bmatrix}\begin{bmatrix}{\mathbf{x}}_{i}\\
y_{i}\end{bmatrix}^{\top}\Big)\begin{bmatrix}{\mathbf{Q}}_{11}\\
{\mathbf{q}}_{21}^{\top}\end{bmatrix}{\mathbf{x}}_{n+1}+\begin{bmatrix}{\mathbf{v}}_{21}\\
v_{22}\end{bmatrix}^{\top}\!\!\!\Big(\frac{1}{n}\sum_{i\in[n]}\begin{bmatrix}{\mathbf{x}}_{i}\\
y_{i}\end{bmatrix}\Big)\cdot q," display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><msup><mrow><mo>[</mo><mtable rowspacing="0pt"><mtr><mtd><msub><mi>𝐯</mi><mn>21</mn></msub></mtd></mtr><mtr><mtd><msub><mi>v</mi><mn>22</mn></msub></mtd></mtr></mtable><mo>]</mo></mrow><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="1.600em" minsize="1.600em">(</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>n</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mi>n</mi><mo stretchy="false">]</mo></mrow></mrow></munder></mstyle><mrow><mrow><mo>[</mo><mtable rowspacing="0pt"><mtr><mtd><msub><mi>𝐱</mi><mi>i</mi></msub></mtd></mtr><mtr><mtd><msub><mi>y</mi><mi>i</mi></msub></mtd></mtr></mtable><mo>]</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo>[</mo><mtable rowspacing="0pt"><mtr><mtd><msub><mi>𝐱</mi><mi>i</mi></msub></mtd></mtr><mtr><mtd><msub><mi>y</mi><mi>i</mi></msub></mtd></mtr></mtable><mo>]</mo></mrow><mo>⊤</mo></msup></mrow></mrow></mrow><mo maxsize="1.600em" minsize="1.600em">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><mtable rowspacing="0pt"><mtr><mtd><msub><mi>𝐐</mi><mn>11</mn></msub></mtd></mtr><mtr><mtd><msubsup><mi>𝐪</mi><mn>21</mn><mo>⊤</mo></msubsup></mtd></mtr></mtable><mo>]</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝐱</mi><mrow><mi>n</mi><mo>+</mo><mn>1</mn></mrow></msub></mrow><mo>+</mo><mrow><mrow><msup><mrow><mo>[</mo><mtable rowspacing="0pt"><mtr><mtd><msub><mi>𝐯</mi><mn>21</mn></msub></mtd></mtr><mtr><mtd><msub><mi>v</mi><mn>22</mn></msub></mtd></mtr></mtable><mo>]</mo></mrow><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="1.600em" minsize="1.600em">(</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>n</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mi>n</mi><mo stretchy="false">]</mo></mrow></mrow></munder></mstyle><mrow><mo>[</mo><mtable rowspacing="0pt"><mtr><mtd><msub><mi>𝐱</mi><mi>i</mi></msub></mtd></mtr><mtr><mtd><msub><mi>y</mi><mi>i</mi></msub></mtd></mtr></mtable><mo>]</mo></mrow></mrow></mrow><mo maxsize="1.600em" minsize="1.600em" rspace="0.055em">)</mo></mrow></mrow><mo rspace="0.222em">⋅</mo><mi>q</mi></mrow></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle:=\begin{bmatrix}{\mathbf{v}}_{21}\\
v_{22}\end{bmatrix}^{\top}\Big(\frac{1}{n}\sum_{i\in[n]}\begin{bmatrix}{\mathbf{x}}_{i}\\
y_{i}\end{bmatrix}\begin{bmatrix}{\mathbf{x}}_{i}\\
y_{i}\end{bmatrix}^{\top}\Big)\begin{bmatrix}{\mathbf{Q}}_{11}\\
{\mathbf{q}}_{21}^{\top}\end{bmatrix}{\mathbf{x}}_{n+1}+\begin{bmatrix}{\mathbf{v}}_{21}\\
v_{22}\end{bmatrix}^{\top}\!\!\!\Big(\frac{1}{n}\sum_{i\in[n]}\begin{bmatrix}{\mathbf{x}}_{i}\\
y_{i}\end{bmatrix}\Big)\cdot q,</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(72)</span></td></tr></tbody>
<tbody id="A1.E73"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A1.E73.m1" class="ltx_Math" alttext="\displaystyle\hat{y}_{\mathrm{ZS}}({\mathbf{x}}_{n+1};{\mathbf{V}},{\mathbf{Q}})" display="inline" intent=":literal"><semantics><mrow><msub><mover accent="true"><mi>y</mi><mo>^</mo></mover><mi>ZS</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐱</mi><mrow><mi>n</mi><mo>+</mo><mn>1</mn></mrow></msub><mo>,</mo><mi>𝐕</mi><mo>,</mo><mi>𝐐</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\hat{y}_{\mathrm{ZS}}({\mathbf{x}}_{n+1};{\mathbf{V}},{\mathbf{Q}})</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.E73.m2" class="ltx_Math" alttext="\displaystyle:={\mathbf{v}}_{21}^{\top}{\mathbf{x}}_{n+1}{\mathbf{x}}_{n+1}^{\top}{\mathbf{Q}}_{11}{\mathbf{x}}_{n+1}+{\mathbf{v}}_{21}^{\top}{\mathbf{x}}_{n+1}\cdot q." display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><msubsup><mi>𝐯</mi><mn>21</mn><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝐱</mi><mrow><mi>n</mi><mo>+</mo><mn>1</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝐱</mi><mrow><mi>n</mi><mo>+</mo><mn>1</mn></mrow><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝐐</mi><mn>11</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝐱</mi><mrow><mi>n</mi><mo>+</mo><mn>1</mn></mrow></msub></mrow><mo>+</mo><mrow><mrow><msubsup><mi>𝐯</mi><mn>21</mn><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝐱</mi><mrow><mi>n</mi><mo>+</mo><mn>1</mn></mrow></msub></mrow><mo lspace="0.222em" rspace="0.222em">⋅</mo><mi>q</mi></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle:={\mathbf{v}}_{21}^{\top}{\mathbf{x}}_{n+1}{\mathbf{x}}_{n+1}^{\top}{\mathbf{Q}}_{11}{\mathbf{x}}_{n+1}+{\mathbf{v}}_{21}^{\top}{\mathbf{x}}_{n+1}\cdot q.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(73)</span></td></tr></tbody>
</table>
</div>
<div id="A1.Thmtheorem4" class="ltx_theorem ltx_theorem_lemma">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="A1.Thmtheorem4.2" class="ltx_text ltx_font_bold">Lemma A.4</span></span><span id="A1.Thmtheorem4.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="A1.Thmtheorem4.p1" class="ltx_para">
<p id="A1.Thmtheorem4.p1.1" class="ltx_p"><span id="A1.Thmtheorem4.p1.1.1" class="ltx_text ltx_font_italic">Given <math id="A1.Thmtheorem4.p1.m1" class="ltx_Math" alttext="{\mathbf{V}}" display="inline" intent=":literal"><semantics><mi>𝐕</mi><annotation encoding="application/x-tex">{\mathbf{V}}</annotation></semantics></math>, <math id="A1.Thmtheorem4.p1.m2" class="ltx_Math" alttext="{\mathbf{Q}}" display="inline" intent=":literal"><semantics><mi>𝐐</mi><annotation encoding="application/x-tex">{\mathbf{Q}}</annotation></semantics></math>, and <math id="A1.Thmtheorem4.p1.m3" class="ltx_Math" alttext="{\mathbf{\theta}}_{0}\in{\mathbb{R}}^{d}" display="inline" intent=":literal"><semantics><mrow><msub><mi>θ</mi><mn>0</mn></msub><mo>∈</mo><msup><mi>ℝ</mi><mi>d</mi></msup></mrow><annotation encoding="application/x-tex">{\mathbf{\theta}}_{0}\in{\mathbb{R}}^{d}</annotation></semantics></math>, (co)variances of <math id="A1.Thmtheorem4.p1.m4" class="ltx_Math" alttext="\hat{y}_{\mathrm{Net\text{-}FS}}({\mathbf{Z}}_{[n]},{\mathbf{x}}_{n+1};{\mathbf{V}},{\mathbf{Q}})" display="inline" intent=":literal"><semantics><mrow><msub><mover accent="true"><mi>y</mi><mo>^</mo></mover><mrow><mi>Net</mi><mo lspace="0em" rspace="0em">​</mo><mtext class="ltx_mathvariant_italic">-</mtext><mo lspace="0em" rspace="0em">​</mo><mi>FS</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐙</mi><mrow><mo stretchy="false">[</mo><mi>n</mi><mo stretchy="false">]</mo></mrow></msub><mo>,</mo><msub><mi>𝐱</mi><mrow><mi>n</mi><mo>+</mo><mn>1</mn></mrow></msub><mo>,</mo><mi>𝐕</mi><mo>,</mo><mi>𝐐</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\hat{y}_{\mathrm{Net\text{-}FS}}({\mathbf{Z}}_{[n]},{\mathbf{x}}_{n+1};{\mathbf{V}},{\mathbf{Q}})</annotation></semantics></math> in (<a href="#A1.E72" title="Equation 72 ‣ A.2 Proofs of Statistical Properties of Model Outputs ‣ Appendix A Proofs ‣ Fine-Tuning Without Forgetting In-Context Learning:A Theoretical Analysis of Linear Attention Models" class="ltx_ref"><span class="ltx_text ltx_ref_tag">72</span></a>), <math id="A1.Thmtheorem4.p1.m5" class="ltx_Math" alttext="\hat{y}_{\mathrm{ZS}}({\mathbf{x}}_{n+1};{\mathbf{V}},{\mathbf{Q}})" display="inline" intent=":literal"><semantics><mrow><msub><mover accent="true"><mi>y</mi><mo>^</mo></mover><mi>ZS</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐱</mi><mrow><mi>n</mi><mo>+</mo><mn>1</mn></mrow></msub><mo>,</mo><mi>𝐕</mi><mo>,</mo><mi>𝐐</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\hat{y}_{\mathrm{ZS}}({\mathbf{x}}_{n+1};{\mathbf{V}},{\mathbf{Q}})</annotation></semantics></math> in (<a href="#A1.E73" title="Equation 73 ‣ A.2 Proofs of Statistical Properties of Model Outputs ‣ Appendix A Proofs ‣ Fine-Tuning Without Forgetting In-Context Learning:A Theoretical Analysis of Linear Attention Models" class="ltx_ref"><span class="ltx_text ltx_ref_tag">73</span></a>), and <math id="A1.Thmtheorem4.p1.m6" class="ltx_Math" alttext="y_{n+1}" display="inline" intent=":literal"><semantics><msub><mi>y</mi><mrow><mi>n</mi><mo>+</mo><mn>1</mn></mrow></msub><annotation encoding="application/x-tex">y_{n+1}</annotation></semantics></math> are as follows:</span></p>
<table id="A1.EGx28" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A1.E74"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.E74.m1" class="ltx_Math" alttext="\displaystyle\displaystyle\mathrm{Var}\left[\hat{y}_{\mathrm{Net\text{-}FS}}({\mathbf{Z}}_{[n]},{\mathbf{x}}_{n+1};{\mathbf{V}},{\mathbf{Q}})\right]=\frac{1}{n}\cdot\tr\left(\begin{bmatrix}{\mathbf{Q}}_{11}\\
{\mathbf{q}}_{21}^{\top}\end{bmatrix}{\mathbf{\Sigma}}\begin{bmatrix}{\mathbf{Q}}_{11}\\
{\mathbf{q}}_{21}^{\top}\end{bmatrix}^{\top}{\mathbf{\Sigma}}_{\mathrm{joint}}\right)\cdot\begin{bmatrix}{\mathbf{v}}_{21}\\
v_{22}\end{bmatrix}^{\top}{\mathbf{\Sigma}}_{\mathrm{joint}}\begin{bmatrix}{\mathbf{v}}_{21}\\
v_{22}\end{bmatrix}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>Var</mi><mo>⁡</mo><mrow><mo>[</mo><mrow><msub><mover accent="true"><mi>y</mi><mo>^</mo></mover><mrow><mi>Net</mi><mo lspace="0em" rspace="0em">​</mo><mtext class="ltx_mathvariant_italic">-</mtext><mo lspace="0em" rspace="0em">​</mo><mi>FS</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐙</mi><mrow><mo stretchy="false">[</mo><mi>n</mi><mo stretchy="false">]</mo></mrow></msub><mo>,</mo><msub><mi>𝐱</mi><mrow><mi>n</mi><mo>+</mo><mn>1</mn></mrow></msub><mo>,</mo><mi>𝐕</mi><mo>,</mo><mi>𝐐</mi><mo stretchy="false">)</mo></mrow></mrow><mo>]</mo></mrow></mrow><mo>=</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>n</mi></mfrac></mstyle><mo lspace="0.222em" rspace="0.222em">⋅</mo><mrow><mi>tr</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mrow><mo>[</mo><mtable rowspacing="0pt"><mtr><mtd><msub><mi>𝐐</mi><mn>11</mn></msub></mtd></mtr><mtr><mtd><msubsup><mi>𝐪</mi><mn>21</mn><mo>⊤</mo></msubsup></mtd></mtr></mtable><mo>]</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>𝚺</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo>[</mo><mtable rowspacing="0pt"><mtr><mtd><msub><mi>𝐐</mi><mn>11</mn></msub></mtd></mtr><mtr><mtd><msubsup><mi>𝐪</mi><mn>21</mn><mo>⊤</mo></msubsup></mtd></mtr></mtable><mo>]</mo></mrow><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝚺</mi><mi>joint</mi></msub></mrow><mo rspace="0.055em">)</mo></mrow></mrow><mo rspace="0.222em">⋅</mo><mrow><msup><mrow><mo>[</mo><mtable rowspacing="0pt"><mtr><mtd><msub><mi>𝐯</mi><mn>21</mn></msub></mtd></mtr><mtr><mtd><msub><mi>v</mi><mn>22</mn></msub></mtd></mtr></mtable><mo>]</mo></mrow><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝚺</mi><mi>joint</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><mtable rowspacing="0pt"><mtr><mtd><msub><mi>𝐯</mi><mn>21</mn></msub></mtd></mtr><mtr><mtd><msub><mi>v</mi><mn>22</mn></msub></mtd></mtr></mtable><mo>]</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\displaystyle\mathrm{Var}\left[\hat{y}_{\mathrm{Net\text{-}FS}}({\mathbf{Z}}_{[n]},{\mathbf{x}}_{n+1};{\mathbf{V}},{\mathbf{Q}})\right]=\frac{1}{n}\cdot\tr\left(\begin{bmatrix}{\mathbf{Q}}_{11}\\
{\mathbf{q}}_{21}^{\top}\end{bmatrix}{\mathbf{\Sigma}}\begin{bmatrix}{\mathbf{Q}}_{11}\\
{\mathbf{q}}_{21}^{\top}\end{bmatrix}^{\top}{\mathbf{\Sigma}}_{\mathrm{joint}}\right)\cdot\begin{bmatrix}{\mathbf{v}}_{21}\\
v_{22}\end{bmatrix}^{\top}{\mathbf{\Sigma}}_{\mathrm{joint}}\begin{bmatrix}{\mathbf{v}}_{21}\\
v_{22}\end{bmatrix}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(74)</span></td></tr></tbody>
<tbody id="A1.E75"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.E75.m1" class="ltx_math_unparsed" alttext="\displaystyle\qquad\qquad\qquad\qquad\qquad\qquad\quad\quad+\frac{n+1}{n}\cdot\begin{bmatrix}{\mathbf{v}}_{21}\\
v_{22}\end{bmatrix}^{\top}{\mathbf{\Sigma}}_{\mathrm{joint}}\begin{bmatrix}{\mathbf{Q}}_{11}\\
{\mathbf{q}}_{21}^{\top}\end{bmatrix}{\mathbf{\Sigma}}\begin{bmatrix}{\mathbf{Q}}_{11}\\
{\mathbf{q}}_{21}^{\top}\end{bmatrix}^{\top}{\mathbf{\Sigma}}_{\mathrm{joint}}\begin{bmatrix}{\mathbf{v}}_{21}\\
v_{22}\end{bmatrix}+\frac{q^{2}}{n}\cdot\begin{bmatrix}{\mathbf{v}}_{21}\\
v_{22}\end{bmatrix}^{\top}{\mathbf{\Sigma}}_{\mathrm{joint}}\begin{bmatrix}{\mathbf{v}}_{21}\\
v_{22}\end{bmatrix}," display="inline" intent=":literal"><semantics><mrow><mo>+</mo><mstyle displaystyle="true"><mfrac><mrow><mi>n</mi><mo>+</mo><mn>1</mn></mrow><mi>n</mi></mfrac></mstyle><mo lspace="0.222em" rspace="0.222em">⋅</mo><mrow><mo>[</mo><mtable rowspacing="0pt"><mtr><mtd><msub><mi>𝐯</mi><mn>21</mn></msub></mtd></mtr><mtr><mtd><msub><mi>v</mi><mn>22</mn></msub></mtd></mtr></mtable><mo>]</mo></mrow><msup><mrow></mrow><mo>⊤</mo></msup><mi>𝚺</mi><msub><mrow></mrow><mi>joint</mi></msub><mrow><mo>[</mo><mtable rowspacing="0pt"><mtr><mtd><msub><mi>𝐐</mi><mn>11</mn></msub></mtd></mtr><mtr><mtd><msubsup><mi>𝐪</mi><mn>21</mn><mo>⊤</mo></msubsup></mtd></mtr></mtable><mo>]</mo></mrow><mi>𝚺</mi><mrow><mo>[</mo><mtable rowspacing="0pt"><mtr><mtd><msub><mi>𝐐</mi><mn>11</mn></msub></mtd></mtr><mtr><mtd><msubsup><mi>𝐪</mi><mn>21</mn><mo>⊤</mo></msubsup></mtd></mtr></mtable><mo>]</mo></mrow><msup><mrow></mrow><mo>⊤</mo></msup><mi>𝚺</mi><msub><mrow></mrow><mi>joint</mi></msub><mrow><mo>[</mo><mtable rowspacing="0pt"><mtr><mtd><msub><mi>𝐯</mi><mn>21</mn></msub></mtd></mtr><mtr><mtd><msub><mi>v</mi><mn>22</mn></msub></mtd></mtr></mtable><mo>]</mo></mrow><mo>+</mo><mstyle displaystyle="true"><mfrac><msup><mi>q</mi><mn>2</mn></msup><mi>n</mi></mfrac></mstyle><mo lspace="0.222em" rspace="0.222em">⋅</mo><mrow><mo>[</mo><mtable rowspacing="0pt"><mtr><mtd><msub><mi>𝐯</mi><mn>21</mn></msub></mtd></mtr><mtr><mtd><msub><mi>v</mi><mn>22</mn></msub></mtd></mtr></mtable><mo>]</mo></mrow><msup><mrow></mrow><mo>⊤</mo></msup><mi>𝚺</mi><msub><mrow></mrow><mi>joint</mi></msub><mrow><mo>[</mo><mtable rowspacing="0pt"><mtr><mtd><msub><mi>𝐯</mi><mn>21</mn></msub></mtd></mtr><mtr><mtd><msub><mi>v</mi><mn>22</mn></msub></mtd></mtr></mtable><mo>]</mo></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\qquad\qquad\qquad\qquad\qquad\qquad\quad\quad+\frac{n+1}{n}\cdot\begin{bmatrix}{\mathbf{v}}_{21}\\
v_{22}\end{bmatrix}^{\top}{\mathbf{\Sigma}}_{\mathrm{joint}}\begin{bmatrix}{\mathbf{Q}}_{11}\\
{\mathbf{q}}_{21}^{\top}\end{bmatrix}{\mathbf{\Sigma}}\begin{bmatrix}{\mathbf{Q}}_{11}\\
{\mathbf{q}}_{21}^{\top}\end{bmatrix}^{\top}{\mathbf{\Sigma}}_{\mathrm{joint}}\begin{bmatrix}{\mathbf{v}}_{21}\\
v_{22}\end{bmatrix}+\frac{q^{2}}{n}\cdot\begin{bmatrix}{\mathbf{v}}_{21}\\
v_{22}\end{bmatrix}^{\top}{\mathbf{\Sigma}}_{\mathrm{joint}}\begin{bmatrix}{\mathbf{v}}_{21}\\
v_{22}\end{bmatrix},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(75)</span></td></tr></tbody>
<tbody id="A1.E76"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.E76.m1" class="ltx_Math" alttext="\displaystyle\displaystyle\mathrm{Var}\left[\hat{y}_{\mathrm{ZS}}({\mathbf{x}}_{n+1};{\mathbf{V}},{\mathbf{Q}})\right]=\left(\tr({\mathbf{Q}}_{11}{\mathbf{\Sigma}})^{2}+\tr({\mathbf{Q}}_{11}{\mathbf{\Sigma}}{\mathbf{Q}}_{11}^{\top}{\mathbf{\Sigma}})+\tr({\mathbf{Q}}_{11}{\mathbf{\Sigma}}{\mathbf{Q}}_{11}{\mathbf{\Sigma}})\right)\cdot{\mathbf{v}}_{21}^{\top}{\mathbf{\Sigma}}{\mathbf{v}}_{21}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>Var</mi><mo>⁡</mo><mrow><mo>[</mo><mrow><msub><mover accent="true"><mi>y</mi><mo>^</mo></mover><mi>ZS</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐱</mi><mrow><mi>n</mi><mo>+</mo><mn>1</mn></mrow></msub><mo>,</mo><mi>𝐕</mi><mo>,</mo><mi>𝐐</mi><mo stretchy="false">)</mo></mrow></mrow><mo>]</mo></mrow></mrow><mo>=</mo><mrow><mrow><mrow><mo>(</mo><mrow><mrow><mi>tr</mi><mo>⁡</mo><msup><mrow><mo stretchy="false">(</mo><mrow><msub><mi>𝐐</mi><mn>11</mn></msub><mo lspace="0em" rspace="0em">​</mo><mi>𝚺</mi></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mrow><mo>+</mo><mrow><mi>tr</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>𝐐</mi><mn>11</mn></msub><mo lspace="0em" rspace="0em">​</mo><mi>𝚺</mi><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝐐</mi><mn>11</mn><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>𝚺</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mrow><mi>tr</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>𝐐</mi><mn>11</mn></msub><mo lspace="0em" rspace="0em">​</mo><mi>𝚺</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝐐</mi><mn>11</mn></msub><mo lspace="0em" rspace="0em">​</mo><mi>𝚺</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo rspace="0.055em">)</mo></mrow><mo rspace="0.222em">⋅</mo><msubsup><mi>𝐯</mi><mn>21</mn><mo>⊤</mo></msubsup></mrow><mo lspace="0em" rspace="0em">​</mo><mi>𝚺</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝐯</mi><mn>21</mn></msub></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\displaystyle\mathrm{Var}\left[\hat{y}_{\mathrm{ZS}}({\mathbf{x}}_{n+1};{\mathbf{V}},{\mathbf{Q}})\right]=\left(\tr({\mathbf{Q}}_{11}{\mathbf{\Sigma}})^{2}+\tr({\mathbf{Q}}_{11}{\mathbf{\Sigma}}{\mathbf{Q}}_{11}^{\top}{\mathbf{\Sigma}})+\tr({\mathbf{Q}}_{11}{\mathbf{\Sigma}}{\mathbf{Q}}_{11}{\mathbf{\Sigma}})\right)\cdot{\mathbf{v}}_{21}^{\top}{\mathbf{\Sigma}}{\mathbf{v}}_{21}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(76)</span></td></tr></tbody>
<tbody id="A1.E77"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.E77.m1" class="ltx_math_unparsed" alttext="\displaystyle\qquad\qquad\qquad\qquad\qquad+4\tr({\mathbf{Q}}_{11}{\mathbf{\Sigma}})\cdot{\mathbf{v}}_{21}^{\top}{\mathbf{\Sigma}}{\mathbf{Q}}_{11}{\mathbf{\Sigma}}{\mathbf{v}}_{21}+2{\mathbf{v}}_{21}^{\top}{\mathbf{\Sigma}}({\mathbf{Q}}_{11}+{\mathbf{Q}}_{11}^{\top}){\mathbf{\Sigma}}({\mathbf{Q}}_{11}+{\mathbf{Q}}_{11}^{\top}){\mathbf{\Sigma}}{\mathbf{v}}_{21}" display="inline" intent=":literal"><semantics><mrow><mo>+</mo><mn>4</mn><mi>tr</mi><mrow><mo stretchy="false">(</mo><msub><mi>𝐐</mi><mn>11</mn></msub><mi>𝚺</mi><mo rspace="0.055em" stretchy="false">)</mo></mrow><mo rspace="0.222em">⋅</mo><msubsup><mi>𝐯</mi><mn>21</mn><mo>⊤</mo></msubsup><mi>𝚺</mi><msub><mi>𝐐</mi><mn>11</mn></msub><mi>𝚺</mi><msub><mi>𝐯</mi><mn>21</mn></msub><mo>+</mo><mn>2</mn><msubsup><mi>𝐯</mi><mn>21</mn><mo>⊤</mo></msubsup><mi>𝚺</mi><mrow><mo stretchy="false">(</mo><msub><mi>𝐐</mi><mn>11</mn></msub><mo>+</mo><msubsup><mi>𝐐</mi><mn>11</mn><mo>⊤</mo></msubsup><mo stretchy="false">)</mo></mrow><mi>𝚺</mi><mrow><mo stretchy="false">(</mo><msub><mi>𝐐</mi><mn>11</mn></msub><mo>+</mo><msubsup><mi>𝐐</mi><mn>11</mn><mo>⊤</mo></msubsup><mo stretchy="false">)</mo></mrow><mi>𝚺</mi><msub><mi>𝐯</mi><mn>21</mn></msub></mrow><annotation encoding="application/x-tex">\displaystyle\qquad\qquad\qquad\qquad\qquad+4\tr({\mathbf{Q}}_{11}{\mathbf{\Sigma}})\cdot{\mathbf{v}}_{21}^{\top}{\mathbf{\Sigma}}{\mathbf{Q}}_{11}{\mathbf{\Sigma}}{\mathbf{v}}_{21}+2{\mathbf{v}}_{21}^{\top}{\mathbf{\Sigma}}({\mathbf{Q}}_{11}+{\mathbf{Q}}_{11}^{\top}){\mathbf{\Sigma}}({\mathbf{Q}}_{11}+{\mathbf{Q}}_{11}^{\top}){\mathbf{\Sigma}}{\mathbf{v}}_{21}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(77)</span></td></tr></tbody>
<tbody id="A1.E78"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.E78.m1" class="ltx_math_unparsed" alttext="\displaystyle\qquad\qquad\qquad\qquad\qquad+2q\cdot\tr({\mathbf{Q}}_{11}{\mathbf{\Sigma}})\cdot{\mathbf{v}}_{21}^{\top}{\mathbf{\Sigma}}{\mathbf{v}}_{21}+4q\cdot{\mathbf{v}}_{21}^{\top}{\mathbf{\Sigma}}{\mathbf{Q}}_{11}{\mathbf{\Sigma}}{\mathbf{v}}_{21}+q^{2}\cdot{\mathbf{v}}_{21}^{\top}{\mathbf{\Sigma}}{\mathbf{v}}_{21}," display="inline" intent=":literal"><semantics><mrow><mo>+</mo><mn>2</mn><mi>q</mi><mo lspace="0.222em" rspace="0.222em">⋅</mo><mi>tr</mi><mrow><mo stretchy="false">(</mo><msub><mi>𝐐</mi><mn>11</mn></msub><mi>𝚺</mi><mo rspace="0.055em" stretchy="false">)</mo></mrow><mo rspace="0.222em">⋅</mo><msubsup><mi>𝐯</mi><mn>21</mn><mo>⊤</mo></msubsup><mi>𝚺</mi><msub><mi>𝐯</mi><mn>21</mn></msub><mo>+</mo><mn>4</mn><mi>q</mi><mo lspace="0.222em" rspace="0.222em">⋅</mo><msubsup><mi>𝐯</mi><mn>21</mn><mo>⊤</mo></msubsup><mi>𝚺</mi><msub><mi>𝐐</mi><mn>11</mn></msub><mi>𝚺</mi><msub><mi>𝐯</mi><mn>21</mn></msub><mo>+</mo><msup><mi>q</mi><mn>2</mn></msup><mo lspace="0.222em" rspace="0.222em">⋅</mo><msubsup><mi>𝐯</mi><mn>21</mn><mo>⊤</mo></msubsup><mi>𝚺</mi><msub><mi>𝐯</mi><mn>21</mn></msub><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\qquad\qquad\qquad\qquad\qquad+2q\cdot\tr({\mathbf{Q}}_{11}{\mathbf{\Sigma}})\cdot{\mathbf{v}}_{21}^{\top}{\mathbf{\Sigma}}{\mathbf{v}}_{21}+4q\cdot{\mathbf{v}}_{21}^{\top}{\mathbf{\Sigma}}{\mathbf{Q}}_{11}{\mathbf{\Sigma}}{\mathbf{v}}_{21}+q^{2}\cdot{\mathbf{v}}_{21}^{\top}{\mathbf{\Sigma}}{\mathbf{v}}_{21},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(78)</span></td></tr></tbody>
<tbody id="A1.E79"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.E79.m1" class="ltx_Math" alttext="\displaystyle\displaystyle\mathrm{Var}\left[y_{n+1}\right]={\mathbf{\theta}}_{0}^{\top}{\mathbf{\Sigma}}{\mathbf{\theta}}_{0}+\sigma^{2}," display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mi>Var</mi><mo>⁡</mo><mrow><mo>[</mo><msub><mi>y</mi><mrow><mi>n</mi><mo>+</mo><mn>1</mn></mrow></msub><mo>]</mo></mrow></mrow><mo>=</mo><mrow><mrow><msubsup><mi>θ</mi><mn>0</mn><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>𝚺</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>θ</mi><mn>0</mn></msub></mrow><mo>+</mo><msup><mi>σ</mi><mn>2</mn></msup></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\displaystyle\mathrm{Var}\left[y_{n+1}\right]={\mathbf{\theta}}_{0}^{\top}{\mathbf{\Sigma}}{\mathbf{\theta}}_{0}+\sigma^{2},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(79)</span></td></tr></tbody>
<tbody id="A1.E80"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.E80.m1" class="ltx_Math" alttext="\displaystyle\displaystyle\mathrm{Cov}\left[\hat{y}_{\mathrm{Net\text{-}FS}}({\mathbf{Z}}_{[n]},{\mathbf{x}}_{n+1};{\mathbf{V}},{\mathbf{Q}}),\hat{y}_{\mathrm{ZS}}({\mathbf{x}}_{n+1};{\mathbf{V}},{\mathbf{Q}})\right]=\begin{bmatrix}{\mathbf{v}}_{21}\\
v_{22}\end{bmatrix}^{\top}{\mathbf{\Sigma}}_{\mathrm{joint}}\begin{bmatrix}{\mathbf{Q}}_{11}\\
{\mathbf{q}}_{21}^{\top}\end{bmatrix}{\mathbf{\Sigma}}\left(({\mathbf{Q}}_{11}+{\mathbf{Q}}_{11}^{\top}){\mathbf{\Sigma}}+\tr({\mathbf{Q}}_{11}{\mathbf{\Sigma}}){\mathbf{I}}_{d}+q\cdot{\mathbf{I}}_{d}\right){\mathbf{v}}_{21}," display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mi>Cov</mi><mo>⁡</mo><mrow><mo>[</mo><mrow><mrow><msub><mover accent="true"><mi>y</mi><mo>^</mo></mover><mrow><mi>Net</mi><mo lspace="0em" rspace="0em">​</mo><mtext class="ltx_mathvariant_italic">-</mtext><mo lspace="0em" rspace="0em">​</mo><mi>FS</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐙</mi><mrow><mo stretchy="false">[</mo><mi>n</mi><mo stretchy="false">]</mo></mrow></msub><mo>,</mo><msub><mi>𝐱</mi><mrow><mi>n</mi><mo>+</mo><mn>1</mn></mrow></msub><mo>,</mo><mi>𝐕</mi><mo>,</mo><mi>𝐐</mi><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mrow><msub><mover accent="true"><mi>y</mi><mo>^</mo></mover><mi>ZS</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐱</mi><mrow><mi>n</mi><mo>+</mo><mn>1</mn></mrow></msub><mo>,</mo><mi>𝐕</mi><mo>,</mo><mi>𝐐</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>]</mo></mrow></mrow><mo>=</mo><mrow><msup><mrow><mo>[</mo><mtable rowspacing="0pt"><mtr><mtd><msub><mi>𝐯</mi><mn>21</mn></msub></mtd></mtr><mtr><mtd><msub><mi>v</mi><mn>22</mn></msub></mtd></mtr></mtable><mo>]</mo></mrow><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝚺</mi><mi>joint</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><mtable rowspacing="0pt"><mtr><mtd><msub><mi>𝐐</mi><mn>11</mn></msub></mtd></mtr><mtr><mtd><msubsup><mi>𝐪</mi><mn>21</mn><mo>⊤</mo></msubsup></mtd></mtr></mtable><mo>]</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>𝚺</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mrow><mrow><mo stretchy="false">(</mo><mrow><msub><mi>𝐐</mi><mn>11</mn></msub><mo>+</mo><msubsup><mi>𝐐</mi><mn>11</mn><mo>⊤</mo></msubsup></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>𝚺</mi></mrow><mo>+</mo><mrow><mrow><mi>tr</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>𝐐</mi><mn>11</mn></msub><mo lspace="0em" rspace="0em">​</mo><mi>𝚺</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝐈</mi><mi>d</mi></msub></mrow><mo>+</mo><mrow><mi>q</mi><mo lspace="0.222em" rspace="0.222em">⋅</mo><msub><mi>𝐈</mi><mi>d</mi></msub></mrow></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝐯</mi><mn>21</mn></msub></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\displaystyle\mathrm{Cov}\left[\hat{y}_{\mathrm{Net\text{-}FS}}({\mathbf{Z}}_{[n]},{\mathbf{x}}_{n+1};{\mathbf{V}},{\mathbf{Q}}),\hat{y}_{\mathrm{ZS}}({\mathbf{x}}_{n+1};{\mathbf{V}},{\mathbf{Q}})\right]=\begin{bmatrix}{\mathbf{v}}_{21}\\
v_{22}\end{bmatrix}^{\top}{\mathbf{\Sigma}}_{\mathrm{joint}}\begin{bmatrix}{\mathbf{Q}}_{11}\\
{\mathbf{q}}_{21}^{\top}\end{bmatrix}{\mathbf{\Sigma}}\left(({\mathbf{Q}}_{11}+{\mathbf{Q}}_{11}^{\top}){\mathbf{\Sigma}}+\tr({\mathbf{Q}}_{11}{\mathbf{\Sigma}}){\mathbf{I}}_{d}+q\cdot{\mathbf{I}}_{d}\right){\mathbf{v}}_{21},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(80)</span></td></tr></tbody>
<tbody id="A1.E81"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.E81.m1" class="ltx_Math" alttext="\displaystyle\displaystyle\mathrm{Cov}\left[\hat{y}_{\mathrm{Net\text{-}FS}}({\mathbf{Z}}_{[n]},{\mathbf{x}}_{n+1};{\mathbf{V}},{\mathbf{Q}}),y_{n+1}\right]=\begin{bmatrix}{\mathbf{v}}_{21}\\
v_{22}\end{bmatrix}^{\top}{\mathbf{\Sigma}}_{\mathrm{joint}}\begin{bmatrix}{\mathbf{Q}}_{11}\\
{\mathbf{q}}_{21}^{\top}\end{bmatrix}{\mathbf{\Sigma}}{\mathbf{\theta}}_{0}," display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mi>Cov</mi><mo>⁡</mo><mrow><mo>[</mo><mrow><mrow><msub><mover accent="true"><mi>y</mi><mo>^</mo></mover><mrow><mi>Net</mi><mo lspace="0em" rspace="0em">​</mo><mtext class="ltx_mathvariant_italic">-</mtext><mo lspace="0em" rspace="0em">​</mo><mi>FS</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐙</mi><mrow><mo stretchy="false">[</mo><mi>n</mi><mo stretchy="false">]</mo></mrow></msub><mo>,</mo><msub><mi>𝐱</mi><mrow><mi>n</mi><mo>+</mo><mn>1</mn></mrow></msub><mo>,</mo><mi>𝐕</mi><mo>,</mo><mi>𝐐</mi><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><msub><mi>y</mi><mrow><mi>n</mi><mo>+</mo><mn>1</mn></mrow></msub></mrow><mo>]</mo></mrow></mrow><mo>=</mo><mrow><msup><mrow><mo>[</mo><mtable rowspacing="0pt"><mtr><mtd><msub><mi>𝐯</mi><mn>21</mn></msub></mtd></mtr><mtr><mtd><msub><mi>v</mi><mn>22</mn></msub></mtd></mtr></mtable><mo>]</mo></mrow><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝚺</mi><mi>joint</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><mtable rowspacing="0pt"><mtr><mtd><msub><mi>𝐐</mi><mn>11</mn></msub></mtd></mtr><mtr><mtd><msubsup><mi>𝐪</mi><mn>21</mn><mo>⊤</mo></msubsup></mtd></mtr></mtable><mo>]</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>𝚺</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>θ</mi><mn>0</mn></msub></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\displaystyle\mathrm{Cov}\left[\hat{y}_{\mathrm{Net\text{-}FS}}({\mathbf{Z}}_{[n]},{\mathbf{x}}_{n+1};{\mathbf{V}},{\mathbf{Q}}),y_{n+1}\right]=\begin{bmatrix}{\mathbf{v}}_{21}\\
v_{22}\end{bmatrix}^{\top}{\mathbf{\Sigma}}_{\mathrm{joint}}\begin{bmatrix}{\mathbf{Q}}_{11}\\
{\mathbf{q}}_{21}^{\top}\end{bmatrix}{\mathbf{\Sigma}}{\mathbf{\theta}}_{0},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(81)</span></td></tr></tbody>
<tbody id="A1.E82"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.E82.m1" class="ltx_Math" alttext="\displaystyle\displaystyle\mathrm{Cov}\left[\hat{y}_{\mathrm{ZS}}({\mathbf{x}}_{n+1};{\mathbf{V}},{\mathbf{Q}}),y_{n+1}\right]={\mathbf{v}}_{21}^{\top}\left({\mathbf{\Sigma}}({\mathbf{Q}}_{11}+{\mathbf{Q}}_{11}^{\top}){\mathbf{\Sigma}}+\tr({\mathbf{Q}}_{11}{\mathbf{\Sigma}})\cdot{\mathbf{\Sigma}}+q\cdot{\mathbf{\Sigma}}\right){\mathbf{\theta}}_{0}." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mi>Cov</mi><mo>⁡</mo><mrow><mo>[</mo><mrow><mrow><msub><mover accent="true"><mi>y</mi><mo>^</mo></mover><mi>ZS</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐱</mi><mrow><mi>n</mi><mo>+</mo><mn>1</mn></mrow></msub><mo>,</mo><mi>𝐕</mi><mo>,</mo><mi>𝐐</mi><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><msub><mi>y</mi><mrow><mi>n</mi><mo>+</mo><mn>1</mn></mrow></msub></mrow><mo>]</mo></mrow></mrow><mo>=</mo><mrow><msubsup><mi>𝐯</mi><mn>21</mn><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mrow><mrow><mi>𝚺</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>𝐐</mi><mn>11</mn></msub><mo>+</mo><msubsup><mi>𝐐</mi><mn>11</mn><mo>⊤</mo></msubsup></mrow><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><mi>𝚺</mi></mrow><mo>+</mo><mrow><mrow><mi>tr</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>𝐐</mi><mn>11</mn></msub><mo lspace="0em" rspace="0em">​</mo><mi>𝚺</mi></mrow><mo rspace="0.055em" stretchy="false">)</mo></mrow></mrow><mo rspace="0.222em">⋅</mo><mi>𝚺</mi></mrow><mo>+</mo><mrow><mi>q</mi><mo lspace="0.222em" rspace="0.222em">⋅</mo><mi>𝚺</mi></mrow></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>θ</mi><mn>0</mn></msub></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\displaystyle\mathrm{Cov}\left[\hat{y}_{\mathrm{ZS}}({\mathbf{x}}_{n+1};{\mathbf{V}},{\mathbf{Q}}),y_{n+1}\right]={\mathbf{v}}_{21}^{\top}\left({\mathbf{\Sigma}}({\mathbf{Q}}_{11}+{\mathbf{Q}}_{11}^{\top}){\mathbf{\Sigma}}+\tr({\mathbf{Q}}_{11}{\mathbf{\Sigma}})\cdot{\mathbf{\Sigma}}+q\cdot{\mathbf{\Sigma}}\right){\mathbf{\theta}}_{0}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(82)</span></td></tr></tbody>
</table>
</div>
</div>
<div id="A1.SS2.2" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="A1.SS2.p3" class="ltx_para">
<p id="A1.SS2.p3.1" class="ltx_p"><span id="A1.SS2.p3.1.1" class="ltx_text">First, note that <math id="A1.SS2.p3.m1" class="ltx_Math" alttext="\hat{y}_{\mathrm{Net\text{-}FS}}({\mathbf{Z}}_{[n]},{\mathbf{x}}_{n+1};{\mathbf{V}},{\mathbf{Q}})" display="inline" intent=":literal"><semantics><mrow><msub><mover accent="true"><mi>y</mi><mo>^</mo></mover><mrow><mi>Net</mi><mo lspace="0em" rspace="0em">​</mo><mtext>-</mtext><mo lspace="0em" rspace="0em">​</mo><mi>FS</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐙</mi><mrow><mo stretchy="false">[</mo><mi>n</mi><mo stretchy="false">]</mo></mrow></msub><mo>,</mo><msub><mi>𝐱</mi><mrow><mi>n</mi><mo>+</mo><mn>1</mn></mrow></msub><mo>,</mo><mi>𝐕</mi><mo>,</mo><mi>𝐐</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\hat{y}_{\mathrm{Net\text{-}FS}}({\mathbf{Z}}_{[n]},{\mathbf{x}}_{n+1};{\mathbf{V}},{\mathbf{Q}})</annotation></semantics></math>, <math id="A1.SS2.p3.m2" class="ltx_Math" alttext="\hat{y}_{\mathrm{ZS}}({\mathbf{x}}_{n+1};{\mathbf{V}},{\mathbf{Q}})" display="inline" intent=":literal"><semantics><mrow><msub><mover accent="true"><mi>y</mi><mo>^</mo></mover><mi>ZS</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐱</mi><mrow><mi>n</mi><mo>+</mo><mn>1</mn></mrow></msub><mo>,</mo><mi>𝐕</mi><mo>,</mo><mi>𝐐</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\hat{y}_{\mathrm{ZS}}({\mathbf{x}}_{n+1};{\mathbf{V}},{\mathbf{Q}})</annotation></semantics></math>, and <math id="A1.SS2.p3.m3" class="ltx_Math" alttext="y_{n+1}" display="inline" intent=":literal"><semantics><msub><mi>y</mi><mrow><mi>n</mi><mo>+</mo><mn>1</mn></mrow></msub><annotation encoding="application/x-tex">y_{n+1}</annotation></semantics></math> are linear or cubic function of the zero-mean Gaussian variable <math id="A1.SS2.p3.m4" class="ltx_Math" alttext="{\mathbf{x}}_{n+1}" display="inline" intent=":literal"><semantics><msub><mi>𝐱</mi><mrow><mi>n</mi><mo>+</mo><mn>1</mn></mrow></msub><annotation encoding="application/x-tex">{\mathbf{x}}_{n+1}</annotation></semantics></math>. By <cite class="ltx_cite ltx_citemacro_citet"><a href="#bib.bib12" title="" class="ltx_ref">Isserlis (1918)</a></cite> theorem, we have</span></p>
<table id="A1.E83" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A1.E83.m1" class="ltx_Math" alttext="\displaystyle\mathbb{E}[\hat{y}_{\mathrm{Net\text{-}FS}}({\mathbf{Z}}_{[n]},{\mathbf{x}}_{n+1};{\mathbf{V}},{\mathbf{Q}})]=\displaystyle\mathbb{E}[\hat{y}_{\mathrm{ZS}}({\mathbf{x}}_{n+1};{\mathbf{V}},{\mathbf{Q}})]=\displaystyle\mathbb{E}[y_{n+1}]=0." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><msub><mover accent="true"><mi>y</mi><mo>^</mo></mover><mrow><mi>Net</mi><mo lspace="0em" rspace="0em">​</mo><mtext>-</mtext><mo lspace="0em" rspace="0em">​</mo><mi>FS</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐙</mi><mrow><mo stretchy="false">[</mo><mi>n</mi><mo stretchy="false">]</mo></mrow></msub><mo>,</mo><msub><mi>𝐱</mi><mrow><mi>n</mi><mo>+</mo><mn>1</mn></mrow></msub><mo>,</mo><mi>𝐕</mi><mo>,</mo><mi>𝐐</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">]</mo></mrow></mrow><mo>=</mo><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><msub><mover accent="true"><mi>y</mi><mo>^</mo></mover><mi>ZS</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐱</mi><mrow><mi>n</mi><mo>+</mo><mn>1</mn></mrow></msub><mo>,</mo><mi>𝐕</mi><mo>,</mo><mi>𝐐</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">]</mo></mrow></mrow><mo>=</mo><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><msub><mi>y</mi><mrow><mi>n</mi><mo>+</mo><mn>1</mn></mrow></msub><mo stretchy="false">]</mo></mrow></mrow><mo>=</mo><mn>0</mn></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\mathbb{E}[\hat{y}_{\mathrm{Net\text{-}FS}}({\mathbf{Z}}_{[n]},{\mathbf{x}}_{n+1};{\mathbf{V}},{\mathbf{Q}})]=\displaystyle\mathbb{E}[\hat{y}_{\mathrm{ZS}}({\mathbf{x}}_{n+1};{\mathbf{V}},{\mathbf{Q}})]=\displaystyle\mathbb{E}[y_{n+1}]=0.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(83)</span></td></tr></tbody>
</table>
<p id="A1.SS2.p3.2" class="ltx_p"><span id="A1.SS2.p3.2.1" class="ltx_text">Therefore, it suffices to determine their second moments, as they coincide with the (co)variances.</span></p>
</div>
<div id="A1.SS2.p4" class="ltx_para">
<p id="A1.SS2.p4.1" class="ltx_p"><span id="A1.SS2.p4.1.1" class="ltx_text">From the definition of <math id="A1.SS2.p4.m1" class="ltx_Math" alttext="\hat{y}_{\mathrm{Net\text{-}FS}}({\mathbf{Z}}_{[n]},{\mathbf{x}}_{n+1};{\mathbf{V}},{\mathbf{Q}})" display="inline" intent=":literal"><semantics><mrow><msub><mover accent="true"><mi>y</mi><mo>^</mo></mover><mrow><mi>Net</mi><mo lspace="0em" rspace="0em">​</mo><mtext>-</mtext><mo lspace="0em" rspace="0em">​</mo><mi>FS</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐙</mi><mrow><mo stretchy="false">[</mo><mi>n</mi><mo stretchy="false">]</mo></mrow></msub><mo>,</mo><msub><mi>𝐱</mi><mrow><mi>n</mi><mo>+</mo><mn>1</mn></mrow></msub><mo>,</mo><mi>𝐕</mi><mo>,</mo><mi>𝐐</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\hat{y}_{\mathrm{Net\text{-}FS}}({\mathbf{Z}}_{[n]},{\mathbf{x}}_{n+1};{\mathbf{V}},{\mathbf{Q}})</annotation></semantics></math> in (<a href="#A1.E72" title="Equation 72 ‣ A.2 Proofs of Statistical Properties of Model Outputs ‣ Appendix A Proofs ‣ Fine-Tuning Without Forgetting In-Context Learning:A Theoretical Analysis of Linear Attention Models" class="ltx_ref"><span class="ltx_text ltx_ref_tag">72</span></a>), we have</span></p>
