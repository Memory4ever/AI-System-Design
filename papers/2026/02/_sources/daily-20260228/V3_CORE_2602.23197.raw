<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.E100.m2" class="ltx_Math" alttext="\displaystyle=\tr({\mathbf{v}}_{21}{\mathbf{v}}_{21}^{\top}{\mathbf{\Sigma}})\tr(({\mathbf{Q}}_{11}+{\mathbf{Q}}_{11}^{\top}){\mathbf{\Sigma}})+2\tr({\mathbf{v}}_{21}{\mathbf{v}}_{21}^{\top}{\mathbf{\Sigma}}({\mathbf{Q}}_{11}+{\mathbf{Q}}_{11}^{\top}){\mathbf{\Sigma}})" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><mrow><mi>tr</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>𝐯</mi><mn>21</mn></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝐯</mi><mn>21</mn><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>𝚺</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>tr</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><msub><mi>𝐐</mi><mn>11</mn></msub><mo>+</mo><msubsup><mi>𝐐</mi><mn>11</mn><mo>⊤</mo></msubsup></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>𝚺</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>+</mo><mrow><mn>2</mn><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>tr</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>𝐯</mi><mn>21</mn></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝐯</mi><mn>21</mn><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>𝚺</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>𝐐</mi><mn>11</mn></msub><mo>+</mo><msubsup><mi>𝐐</mi><mn>11</mn><mo>⊤</mo></msubsup></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>𝚺</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\tr({\mathbf{v}}_{21}{\mathbf{v}}_{21}^{\top}{\mathbf{\Sigma}})\tr(({\mathbf{Q}}_{11}+{\mathbf{Q}}_{11}^{\top}){\mathbf{\Sigma}})+2\tr({\mathbf{v}}_{21}{\mathbf{v}}_{21}^{\top}{\mathbf{\Sigma}}({\math