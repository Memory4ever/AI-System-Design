<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.E102.m1" class="ltx_Math" alttext="\displaystyle=2\tr({\mathbf{Q}}_{11}{\mathbf{\Sigma}})\cdot{\mathbf{v}}_{21}^{\top}{\mathbf{\Sigma}}{\mathbf{v}}_{21}+4{\mathbf{v}}_{21}^{\top}{\mathbf{\Sigma}}{\mathbf{Q}}_{11}{\mathbf{\Sigma}}{\mathbf{v}}_{21}," display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><mrow><mrow><mn>2</mn><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>tr</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>𝐐</mi><mn>11</mn></msub><mo lspace="0em" rspace="0em">​</mo><mi>𝚺</mi></mrow><mo rspace="0.055em" stretchy="false">)</mo></mrow></mrow></mrow><mo rspace="0.222em">⋅</mo><msubsup><mi>𝐯</mi><mn>21</mn><mo>⊤</mo></msubsup></mrow><mo lspace="0em" rspace="0em">​</mo><mi>𝚺</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝐯</mi><mn>21</mn></msub></mrow><mo>+</mo><mrow><mn>4</mn><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝐯</mi><mn>21</mn><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>𝚺</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝐐</mi><mn>11</mn></msub><mo lspace="0em" rspace="0em">​</mo><mi>𝚺</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝐯</mi><mn>21</mn></msub></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle=2\tr({\mathbf{Q}}_{11}{\mathbf{\Sigma}})\cdot{\mathbf{v}}_{21}^{\top}{\mathbf{\Sigma}}{\mathbf{v}}_{21}+4{\mathbf{v}}_{21}^{\top}{\mathbf{\Sigma}}{\mathbf{Q}}_{11}{\mathbf{\Sigma}}{\mathbf{v}}_{21},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(102)</span></td></tr></tbody>
</table>
<p id="A1.SS2.p7.3" class="ltx_p"><span id="A1.SS2.p7.3.1" class="ltx_text">which implies</span></p>
<table id="A1.EGx35" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A1.E103"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A1.E103.m1" class="ltx_Math" alttext="\displaystyle\displaystyle\mathrm{Var}\left[\hat{y}_{\mathrm{ZS}}({\mathbf{x}}_{n+1};{\mathbf{V}},{\mathbf{Q}})\right]" display="inline" intent=":literal"><semantics><mrow><mi>Var</mi><mo>⁡</mo><mrow><mo>[</mo><mrow><msub><mover accent="true"><mi>y</mi><mo>^</mo></mover><mi>ZS</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐱</mi><mrow><mi>n</mi><mo>+</mo><mn>1</mn></mrow></msub><mo>,</mo><mi>𝐕</mi><mo>,</mo><mi>𝐐</mi><mo stretchy="false">)</mo></mrow></mrow><mo>]</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\displaystyle\mathrm{Var}\left[\hat{y}_{\mathrm{ZS}}({\mathbf{x}}_{n+1};{\mathbf{V}},{\mathbf{Q}})\right]</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.E103.m2" class="ltx_Math" alttext="\displaystyle=\left(\tr({\mathbf{Q}}_{11}{\mathbf{\Sigma}})^{2}+\tr({\mathbf{Q}}_{11}{\mathbf{\Sigma}}{\mathbf{Q}}_{11}^{\top}{\mathbf{\Sigma}})+\tr({\mathbf{Q}}_{11}{\mathbf{\Sigma}}{\mathbf{Q}}_{11}{\mathbf{\Sigma}})\right)\cdot{\mathbf{v}}_{21}^{\top}{\mathbf{\Sigma}}{\mathbf{v}}_{21}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><mrow><mo>(</mo><mrow><mrow><mi>tr</mi><mo>⁡</mo><msup><mrow><mo stretchy="false">(</mo><mrow><msub><mi>𝐐</mi><mn>11</mn></msub><mo lspace="0em" rspace="0em">​</mo><mi>𝚺</mi></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mrow><mo>+</mo><mrow><mi>tr</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>𝐐</mi><mn>11</mn></msub><mo lspace="0em" rspace="0em">​</mo><mi>𝚺</mi><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝐐</mi><mn>11</mn><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>𝚺</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mrow><mi>tr</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>𝐐</mi><mn>11</mn></msub><mo lspace="0em" rspace="0em">​</mo><mi>𝚺</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝐐</mi><mn>11</mn></msub><mo lspace="0em" rspace="0em">​</mo><mi>𝚺</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo rspace="0.055em">)</mo></mrow><mo rspace="0.222em">⋅</mo><msubsup><mi>𝐯</mi><mn>21</mn><mo>⊤</mo></msubsup></mrow><mo lspace="0em" rspace="0em">​</mo><mi>𝚺</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝐯</mi><mn>21</mn></msub></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\left(\tr({\mathbf{Q}}_{11}{\mathbf{\Sigma}})^{2}+\tr({\mathbf{Q}}_{11}{\mathbf{\Sigma}}{\mathbf{Q}}_{11}^{\top}{\mathbf{\Sigma}})+\tr({\mathbf{Q}}_{11}{\mathbf{\Sigma}}{\mathbf{Q}}_{11}{\mathbf{\Sigma}})\right)\cdot{\mathbf{v}}_{21}^{\top}{\mathbf{\Sigma}}{\mathbf{v}}_{21}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(103)</span></td></tr></tbody>
<tbody id="A1.E104"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.E104.m1" class="ltx_math_unparsed" alttext="\displaystyle\quad+4\tr({\mathbf{Q}}_{11}{\mathbf{\Sigma}})\cdot{\mathbf{v}}_{21}^{\top}{\mathbf{\Sigma}}{\mathbf{Q}}_{11}{\mathbf{\Sigma}}{\mathbf{v}}_{21}+2{\mathbf{v}}_{21}^{\top}{\mathbf{\Sigma}}({\mathbf{Q}}_{11}+{\mathbf{Q}}_{11}^{\top}){\mathbf{\Sigma}}({\mathbf{Q}}_{11}+{\mathbf{Q}}_{11}^{\top}){\mathbf{\Sigma}}{\mathbf{v}}_{21}" display="inline" intent=":literal"><semantics><mrow><mo>+</mo><mn>4</mn><mi>tr</mi><mrow><mo stretchy="false">(</mo><msub><mi>𝐐</mi><mn>11</mn></msub><mi>𝚺</mi><mo rspace="0.055em" stretchy="false">)</mo></mrow><mo rspace="0.222em">⋅</mo><msubsup><mi>𝐯</mi><mn>21</mn><mo>⊤</mo></msubsup><mi>𝚺</mi><msub><mi>𝐐</mi><mn>11</mn></msub><mi>𝚺</mi><msub><mi>𝐯</mi><mn>21</mn></msub><mo>+</mo><mn>2</mn><msubsup><mi>𝐯</mi><mn>21</mn><mo>⊤</mo></msubsup><mi>𝚺</mi><mrow><mo stretchy="false">(</mo><msub><mi>𝐐</mi><mn>11</mn></msub><mo>+</mo><msubsup><mi>𝐐</mi><mn>11</mn><mo>⊤</mo></msubsup><mo stretchy="false">)</mo></mrow><mi>𝚺</mi><mrow><mo stretchy="false">(</mo><msub><mi>𝐐</mi><mn>11</mn></msub><mo>+</mo><msubsup><mi>𝐐</mi><mn>11</mn><mo>⊤</mo></msubsup><mo stretchy="false">)</mo></mrow><mi>𝚺</mi><msub><mi>𝐯</mi><mn>21</mn></msub></mrow><annotation encoding="application/x-tex">\displaystyle\quad+4\tr({\mathbf{Q}}_{11}{\mathbf{\Sigma}})\cdot{\mathbf{v}}_{21}^{\top}{\mathbf{\Sigma}}{\mathbf{Q}}_{11}{\mathbf{\Sigma}}{\mathbf{v}}_{21}+2{\mathbf{v}}_{21}^{\top}{\mathbf{\Sigma}}({\mathbf{Q}}_{11}+{\mathbf{Q}}_{11}^{\top}){\mathbf{\Sigma}}({\mathbf{Q}}_{11}+{\mathbf{Q}}_{11}^{\top}){\mathbf{\Sigma}}{\mathbf{v}}_{21}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(104)</span></td></tr></tbody>
<tbody id="A1.E105"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.E105.m1" class="ltx_math_unparsed" alttext="\displaystyle\quad+2q\cdot\tr({\mathbf{Q}}_{11}{\mathbf{\Sigma}})\cdot{\mathbf{v}}_{21}^{\top}{\mathbf{\Sigma}}{\mathbf{v}}_{21}+4q\cdot{\mathbf{v}}_{21}^{\top}{\mathbf{\Sigma}}{\mathbf{Q}}_{11}{\mathbf{\Sigma}}{\mathbf{v}}_{21}+q^{2}\cdot{\mathbf{v}}_{21}^{\top}{\mathbf{\Sigma}}{\mathbf{v}}_{21}." display="inline" intent=":literal"><semantics><mrow><mo>+</mo><mn>2</mn><mi>q</mi><mo lspace="0.222em" rspace="0.222em">⋅</mo><mi>tr</mi><mrow><mo stretchy="false">(</mo><msub><mi>𝐐</mi><mn>11</mn></msub><mi>𝚺</mi><mo rspace="0.055em" stretchy="false">)</mo></mrow><mo rspace="0.222em">⋅</mo><msubsup><mi>𝐯</mi><mn>21</mn><mo>⊤</mo></msubsup><mi>𝚺</mi><msub><mi>𝐯</mi><mn>21</mn></msub><mo>+</mo><mn>4</mn><mi>q</mi><mo lspace="0.222em" rspace="0.222em">⋅</mo><msubsup><mi>𝐯</mi><mn>21</mn><mo>⊤</mo></msubsup><mi>𝚺</mi><msub><mi>𝐐</mi><mn>11</mn></msub><mi>𝚺</mi><msub><mi>𝐯</mi><mn>21</mn></msub><mo>+</mo><msup><mi>q</mi><mn>2</mn></msup><mo lspace="0.222em" rspace="0.222em">⋅</mo><msubsup><mi>𝐯</mi><mn>21</mn><mo>⊤</mo></msubsup><mi>𝚺</mi><msub><mi>𝐯</mi><mn>21</mn></msub><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\quad+2q\cdot\tr({\mathbf{Q}}_{11}{\mathbf{\Sigma}})\cdot{\mathbf{v}}_{21}^{\top}{\mathbf{\Sigma}}{\mathbf{v}}_{21}+4q\cdot{\mathbf{v}}_{21}^{\top}{\mathbf{\Sigma}}{\mathbf{Q}}_{11}{\mathbf{\Sigma}}{\mathbf{v}}_{21}+q^{2}\cdot{\mathbf{v}}_{21}^{\top}{\mathbf{\Sigma}}{\mathbf{v}}_{21}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(105)</span></td></tr></tbody>
</table>
</div>
<div id="A1.SS2.p8" class="ltx_para">
<p id="A1.SS2.p8.1" class="ltx_p"><span id="A1.SS2.p8.1.1" class="ltx_text">In a similar manner, we can determine the covariances as follows.</span></p>
<table id="A1.EGx36" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A1.E106"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.E106.m1" class="ltx_Math" alttext="\displaystyle\displaystyle\mathrm{Cov}\left[\hat{y}_{\mathrm{Net\text{-}FS}}({\mathbf{Z}}_{[n]},{\mathbf{x}}_{n+1};{\mathbf{V}},{\mathbf{Q}}),\hat{y}_{\mathrm{ZS}}({\mathbf{x}}_{n+1};{\mathbf{V}},{\mathbf{Q}})\right]" display="inline" intent=":literal"><semantics><mrow><mi>Cov</mi><mo>⁡</mo><mrow><mo>[</mo><mrow><mrow><msub><mover accent="true"><mi>y</mi><mo>^</mo></mover><mrow><mi>Net</mi><mo lspace="0em" rspace="0em">​</mo><mtext>-</mtext><mo lspace="0em" rspace="0em">​</mo><mi>FS</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐙</mi><mrow><mo stretchy="false">[</mo><mi>n</mi><mo stretchy="false">]</mo></mrow></msub><mo>,</mo><msub><mi>𝐱</mi><mrow><mi>n</mi><mo>+</mo><mn>1</mn></mrow></msub><mo>,</mo><mi>𝐕</mi><mo>,</mo><mi>𝐐</mi><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mrow><msub><mover accent="true"><mi>y</mi><mo>^</mo></mover><mi>ZS</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐱</mi><mrow><mi>n</mi><mo>+</mo><mn>1</mn></mrow></msub><mo>,</mo><mi>𝐕</mi><mo>,</mo><mi>𝐐</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>]</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\displaystyle\mathrm{Cov}\left[\hat{y}_{\mathrm{Net\text{-}FS}}({\mathbf{Z}}_{[n]},{\mathbf{x}}_{n+1};{\mathbf{V}},{\mathbf{Q}}),\hat{y}_{\mathrm{ZS}}({\mathbf{x}}_{n+1};{\mathbf{V}},{\mathbf{Q}})\right]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(106)</span></td></tr></tbody>
<tbody id="A1.E107"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.E107.m1" class="ltx_Math" alttext="\displaystyle=\displaystyle\mathbb{E}\left[\begin{bmatrix}{\mathbf{v}}_{21}\\
v_{22}\end{bmatrix}^{\top}\bigg(\frac{1}{n}\sum_{i\in[n]}\begin{bmatrix}{\mathbf{x}}_{i}\\
y_{i}\end{bmatrix}\begin{bmatrix}{\mathbf{x}}_{i}\\
y_{i}\end{bmatrix}^{\top}\bigg)\begin{bmatrix}{\mathbf{Q}}_{11}\\
{\mathbf{q}}_{21}^{\top}\end{bmatrix}{\mathbf{x}}_{n+1}{\mathbf{x}}_{n+1}^{\top}{\mathbf{Q}}_{11}^{\top}{\mathbf{x}}_{n+1}{\mathbf{x}}_{n+1}^{\top}{\mathbf{v}}_{21}\right]" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><mrow><msup><mrow><mo>[</mo><mtable rowspacing="0pt"><mtr><mtd><msub><mi>𝐯</mi><mn>21</mn></msub></mtd></mtr><mtr><mtd><msub><mi>v</mi><mn>22</mn></msub></mtd></mtr></mtable><mo>]</mo></mrow><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="2.100em" minsize="2.100em">(</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>n</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mi>n</mi><mo stretchy="false">]</mo></mrow></mrow></munder></mstyle><mrow><mrow><mo>[</mo><mtable rowspacing="0pt"><mtr><mtd><msub><mi>𝐱</mi><mi>i</mi></msub></mtd></mtr><mtr><mtd><msub><mi>y</mi><mi>i</mi></msub></mtd></mtr></mtable><mo>]</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo>[</mo><mtable rowspacing="0pt"><mtr><mtd><msub><mi>𝐱</mi><mi>i</mi></msub></mtd></mtr><mtr><mtd><msub><mi>y</mi><mi>i</mi></msub></mtd></mtr></mtable><mo>]</mo></mrow><mo>⊤</mo></msup></mrow></mrow></mrow><mo maxsize="2.100em" minsize="2.100em">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><mtable rowspacing="0pt"><mtr><mtd><msub><mi>𝐐</mi><mn>11</mn></msub></mtd></mtr><mtr><mtd><msubsup><mi>𝐪</mi><mn>21</mn><mo>⊤</mo></msubsup></mtd></mtr></mtable><mo>]</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝐱</mi><mrow><mi>n</mi><mo>+</mo><mn>1</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝐱</mi><mrow><mi>n</mi><mo>+</mo><mn>1</mn></mrow><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝐐</mi><mn>11</mn><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝐱</mi><mrow><mi>n</mi><mo>+</mo><mn>1</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝐱</mi><mrow><mi>n</mi><mo>+</mo><mn>1</mn></mrow><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝐯</mi><mn>21</mn></msub></mrow><mo>]</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\displaystyle\mathbb{E}\left[\begin{bmatrix}{\mathbf{v}}_{21}\\
v_{22}\end{bmatrix}^{\top}\bigg(\frac{1}{n}\sum_{i\in[n]}\begin{bmatrix}{\mathbf{x}}_{i}\\
y_{i}\end{bmatrix}\begin{bmatrix}{\mathbf{x}}_{i}\\
y_{i}\end{bmatrix}^{\top}\bigg)\begin{bmatrix}{\mathbf{Q}}_{11}\\
{\mathbf{q}}_{21}^{\top}\end{bmatrix}{\mathbf{x}}_{n+1}{\mathbf{x}}_{n+1}^{\top}{\mathbf{Q}}_{11}^{\top}{\mathbf{x}}_{n+1}{\mathbf{x}}_{n+1}^{\top}{\mathbf{v}}_{21}\right]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(107)</span></td></tr></tbody>
<tbody id="A1.E108"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.E108.m1" class="ltx_Math" alttext="\displaystyle\quad+\displaystyle\mathbb{E}\left[\begin{bmatrix}{\mathbf{v}}_{21}\\
v_{22}\end{bmatrix}^{\top}\bigg(\frac{1}{n}\sum_{i\in[n]}\begin{bmatrix}{\mathbf{x}}_{i}\\
y_{i}\end{bmatrix}\begin{bmatrix}{\mathbf{x}}_{i}\\
y_{i}\end{bmatrix}^{\top}\bigg)\begin{bmatrix}{\mathbf{Q}}_{11}\\
{\mathbf{q}}_{21}^{\top}\end{bmatrix}{\mathbf{x}}_{n+1}{\mathbf{x}}_{n+1}^{\top}{\mathbf{v}}_{21}\cdot q\right]" display="inline" intent=":literal"><semantics><mrow><mo>+</mo><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><mrow><mrow><msup><mrow><mo>[</mo><mtable rowspacing="0pt"><mtr><mtd><msub><mi>𝐯</mi><mn>21</mn></msub></mtd></mtr><mtr><mtd><msub><mi>v</mi><mn>22</mn></msub></mtd></mtr></mtable><mo>]</mo></mrow><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="2.100em" minsize="2.100em">(</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>n</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mi>n</mi><mo stretchy="false">]</mo></mrow></mrow></munder></mstyle><mrow><mrow><mo>[</mo><mtable rowspacing="0pt"><mtr><mtd><msub><mi>𝐱</mi><mi>i</mi></msub></mtd></mtr><mtr><mtd><msub><mi>y</mi><mi>i</mi></msub></mtd></mtr></mtable><mo>]</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo>[</mo><mtable rowspacing="0pt"><mtr><mtd><msub><mi>𝐱</mi><mi>i</mi></msub></mtd></mtr><mtr><mtd><msub><mi>y</mi><mi>i</mi></msub></mtd></mtr></mtable><mo>]</mo></mrow><mo>⊤</mo></msup></mrow></mrow></mrow><mo maxsize="2.100em" minsize="2.100em">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><mtable rowspacing="0pt"><mtr><mtd><msub><mi>𝐐</mi><mn>11</mn></msub></mtd></mtr><mtr><mtd><msubsup><mi>𝐪</mi><mn>21</mn><mo>⊤</mo></msubsup></mtd></mtr></mtable><mo>]</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝐱</mi><mrow><mi>n</mi><mo>+</mo><mn>1</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝐱</mi><mrow><mi>n</mi><mo>+</mo><mn>1</mn></mrow><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝐯</mi><mn>21</mn></msub></mrow><mo lspace="0.222em" rspace="0.222em">⋅</mo><mi>q</mi></mrow><mo>]</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\quad+\displaystyle\mathbb{E}\left[\begin{bmatrix}{\mathbf{v}}_{21}\\
v_{22}\end{bmatrix}^{\top}\bigg(\frac{1}{n}\sum_{i\in[n]}\begin{bmatrix}{\mathbf{x}}_{i}\\
y_{i}\end{bmatrix}\begin{bmatrix}{\mathbf{x}}_{i}\\
y_{i}\end{bmatrix}^{\top}\bigg)\begin{bmatrix}{\mathbf{Q}}_{11}\\
{\mathbf{q}}_{21}^{\top}\end{bmatrix}{\mathbf{x}}_{n+1}{\mathbf{x}}_{n+1}^{\top}{\mathbf{v}}_{21}\cdot q\right]</annotation></semantics></math></td>
