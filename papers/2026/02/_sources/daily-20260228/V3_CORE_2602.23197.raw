<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.E111.m2" class="ltx_Math" alttext="\displaystyle=\displaystyle\mathbb{E}\left[\begin{bmatrix}{\mathbf{v}}_{21}\\
v_{22}\end{bmatrix}^{\top}\bigg(\frac{1}{n}\sum_{i\in[n]}\begin{bmatrix}{\mathbf{x}}_{i}\\
y_{i}\end{bmatrix}\begin{bmatrix}{\mathbf{x}}_{i}\\
y_{i}\end{bmatrix}^{\top}\bigg)\begin{bmatrix}{\mathbf{Q}}_{11}\\
{\mathbf{q}}_{21}^{\top}\end{bmatrix}{\mathbf{x}}_{n+1}({\mathbf{\theta}}_{0}^{\top}{\mathbf{x}}_{n+1}+e_{n+1})\right]" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><mrow><msup><mrow><mo>[</mo><mtable rowspacing="0pt"><mtr><mtd><msub><mi>𝐯</mi><mn>21</mn></msub></mtd></mtr><mtr><mtd><msub><mi>v</mi><mn>22</mn></msub></mtd></mtr></mtable><mo>]</mo></mrow><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="2.100em" minsize="2.100em">(</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>n</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mi>n</mi><mo stretchy="false">]</mo></mrow></mrow></munder></mstyle><mrow><mrow><mo>[</mo><mtable rowspacing="0pt"><mtr><mtd><msub><mi>𝐱</mi><mi>i</mi></msub></mtd></mtr><mtr><mtd><msub><mi>y</mi><mi>i</mi></msub></mtd></mtr></mtable><mo>]</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo>[</mo><mtable rowspacing="0pt"><mtr><mtd><msub><mi>𝐱</mi><mi>i</mi></msub></mtd></mtr><mtr><mtd><msub><mi>y</mi><mi>i</mi></msub></mtd></mtr></mtable><mo>]</mo></mrow><mo>⊤</mo></msup></mrow></mrow></mrow><mo maxsize="2.100em" minsize="2.100em">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><mtable rowspacing="0pt"><mtr><mtd><msub><mi>𝐐</mi><mn>11</mn></msub></mtd></mtr><mtr><mtd><msubsup><mi>𝐪</mi><mn>21</mn><mo>⊤</mo></msubsup></mtd></mtr></mtable><mo>]</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝐱</mi><mrow><mi>n</mi><mo>+</mo><mn>1</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><msubsup><mi>θ</mi><mn>0</mn><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝐱</mi><mrow><mi>n</mi><mo>+</mo><mn>1</mn></mrow></msub></mrow><mo>+</mo><msub><mi>e</mi><mrow><mi>n</mi><mo>+</mo><mn>1</mn></mrow></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>]</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\displaystyle\mathbb{E}\left[\begin{bmatrix}{\mathbf{v}}_{21}\\
v_{22}\end{bmatrix}^{\top}\bigg(\frac{1}{n}\sum_{i\in[n]}\begin{bmatrix}{\mathbf{x}}_{i}\\
y_{i}\end{bmatrix}\begin{bmatrix}{\mathbf{x}}_{i}\\
y_{i}\end{bmatrix}^{\top}\bigg)\begin{bmatrix}{\mathbf{Q}}_{11}\\
{\mathbf{q}}_{21}^{\top}\end{bmatrix}{\mathbf{x}}_{n+1}({\mathbf{\theta}}_{0}^{\top}{\mathbf{x}}_{n+1}+e_{n+1})\right]</annotation></semantics></math></td>
