<tbody id="A1.E50"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.E50.m1" class="ltx_math_unparsed" alttext="\displaystyle\quad+\sigma_{im}b_{mn}\sigma_{nj}\cdot\sigma_{kl}a^{\top}_{lk}+\sigma_{im}b_{mn}\sigma_{nk}a_{kl}\sigma_{lj}+\sigma_{im}b_{mn}\sigma_{nl}a^{\top}_{lk}\sigma_{kj}" display="inline" intent=":literal"><semantics><mrow><mo>+</mo><mi>σ</mi><msub><mrow></mrow><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>m</mi></mrow></msub><mi>b</mi><msub><mrow></mrow><mrow><mi>m</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow></msub><mi>σ</mi><msub><mrow></mrow><mrow><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><mi>j</mi></mrow></msub><mo lspace="0.222em" rspace="0.222em">⋅</mo><mi>σ</mi><msub><mrow></mrow><mrow><mi>k</mi><mo lspace="0em" rspace="0em">​</mo><mi>l</mi></mrow></msub><mi>a</mi><msup><mrow></mrow><mo>⊤</mo></msup><msub><mrow></mrow><mrow><mi>l</mi><mo lspace="0em" rspace="0em">​</mo><mi>k</mi></mrow></msub><mo>+</mo><mi>σ</mi><msub><mrow></mrow><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>m</mi></mrow></msub><mi>b</mi><msub><mrow></mrow><mrow><mi>m</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow></msub><mi>σ</mi><msub><mrow></mrow><mrow><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><mi>k</mi></mrow></msub><mi>a</mi><msub><mrow></mrow><mrow><mi>k</mi><mo lspace="0em" rspace="0em">​</mo><mi>l</mi></mrow></msub><mi>σ</mi><msub><mrow></mrow><mrow><mi>l</mi><mo lspace="0em" rspace="0em">​</mo><mi>j</mi></mrow></msub><mo>+</mo><mi>σ</mi><msub><mrow></mrow><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>m</mi></mrow></msub><mi>b</mi><msub><mrow></mrow><mrow><mi>m</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow></msub><mi>σ</mi><msub><mrow></mrow><mrow><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><mi>l</mi></mrow></msub><mi>a</mi><msup><mrow></mrow><mo>⊤</mo></msup><msub><mrow></mrow><mrow><mi>l</mi><mo lspace="0em" rspace="0em">​</mo><mi>k</mi></mrow></msub><mi>σ</mi><msub><mrow></mrow><mrow><mi>k</mi><mo lspace="0em" rspace="0em">​</mo><mi>j</mi></mrow></msub></mrow><annotation encoding="application/x-tex">\displaystyle\quad+\sigma_{im}b_{mn}\sigma_{nj}\cdot\sigma_{kl}a^{\top}_{lk}+\sigma_{im}b_{mn}\sigma_{nk}a_{kl}\sigma_{lj}+\sigma_{im}b_{mn}\sigma_{nl}a^{\top}_{lk}\sigma_{kj}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(50)</span></td></tr></tbody>
<tbody id="A1.E51"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.E51.m1" class="ltx_math_unparsed" alttext="\displaystyle\quad+\sigma_{in}b^{\top}_{nm}\sigma_{mj}\cdot\sigma_{kl}a^{\top}_{lk}+\sigma_{in}b^{\top}_{nm}\sigma_{mk}a_{kl}\sigma_{lj}+\sigma_{in}b^{\top}_{nm}\sigma_{ml}a^{\top}_{lk}\sigma_{kj}." display="inline" intent=":literal"><semantics><mrow><mo>+</mo><mi>σ</mi><msub><mrow></mrow><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow></msub><mi>b</mi><msup><mrow></mrow><mo>⊤</mo></msup><msub><mrow></mrow><mrow><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><mi>m</mi></mrow></msub><mi>σ</mi><msub><mrow></mrow><mrow><mi>m</mi><mo lspace="0em" rspace="0em">​</mo><mi>j</mi></mrow></msub><mo lspace="0.222em" rspace="0.222em">⋅</mo><mi>σ</mi><msub><mrow></mrow><mrow><mi>k</mi><mo lspace="0em" rspace="0em">​</mo><mi>l</mi></mrow></msub><mi>a</mi><msup><mrow></mrow><mo>⊤</mo></msup><msub><mrow></mrow><mrow><mi>l</mi><mo lspace="0em" rspace="0em">​</mo><mi>k</mi></mrow></msub><mo>+</mo><mi>σ</mi><msub><mrow></mrow><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow></msub><mi>b</mi><msup><mrow></mrow><mo>⊤</mo></msup><msub><mrow></mrow><mrow><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><mi>m</mi></mrow></msub><mi>σ</mi><msub><mrow></mrow><mrow><mi>m</mi><mo lspace="0em" rspace="0em">​</mo><mi>k</mi></mrow></msub><mi>a</mi><msub><mrow></mrow><mrow><mi>k</mi><mo lspace="0em" rspace="0em">​</mo><mi>l</mi></mrow></msub><mi>σ</mi><msub><mrow></mrow><mrow><mi>l</mi><mo lspace="0em" rspace="0em">​</mo><mi>j</mi></mrow></msub><mo>+</mo><mi>σ</mi><msub><mrow></mrow><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow></msub><mi>b</mi><msup><mrow></mrow><mo>⊤</mo></msup><msub><mrow></mrow><mrow><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><mi>m</mi></mrow></msub><mi>σ</mi><msub><mrow></mrow><mrow><mi>m</mi><mo lspace="0em" rspace="0em">​</mo><mi>l</mi></mrow></msub><mi>a</mi><msup><mrow></mrow><mo>⊤</mo></msup><msub><mrow></mrow><mrow><mi>l</mi><mo lspace="0em" rspace="0em">​</mo><mi>k</mi></mrow></msub><mi>σ</mi><msub><mrow></mrow><mrow><mi>k</mi><mo lspace="0em" rspace="0em">​</mo><mi>j</mi></mrow></msub><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\quad+\sigma_{in}b^{\top}_{nm}\sigma_{mj}\cdot\sigma_{kl}a^{\top}_{lk}+\sigma_{in}b^{\top}_{nm}\sigma_{mk}a_{kl}\sigma_{lj}+\sigma_{in}b^{\top}_{nm}\sigma_{ml}a^{\top}_{lk}\sigma_{kj}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(51)</span></td></tr></tbody>
</table>
</div>
<div id="A1.SS1.p4" class="ltx_para">
<p id="A1.SS1.p4.1" class="ltx_p"><span id="A1.SS1.p4.1.1" class="ltx_text">Therefore,</span></p>
<table id="A1.EGx22" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A1.E52"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.E52.m1" class="ltx_Math" alttext="\displaystyle\displaystyle\mathbb{E}[{\mathbf{x}}{\mathbf{x}}^{\top}{\mathbf{A}}{\mathbf{x}}{\mathbf{x}}^{\top}{\mathbf{B}}{\mathbf{x}}{\mathbf{x}}^{\top}]_{ij}" display="inline" intent=":literal"><semantics><mrow><mi>𝔼</mi><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">[</mo><mrow><msup><mi>𝐱𝐱</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝐀𝐱𝐱</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝐁𝐱𝐱</mi><mo>⊤</mo></msup></mrow><mo stretchy="false">]</mo></mrow><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>j</mi></mrow></msub></mrow><annotation encoding="application/x-tex">\displaystyle\displaystyle\mathbb{E}[{\mathbf{x}}{\mathbf{x}}^{\top}{\mathbf{A}}{\mathbf{x}}{\mathbf{x}}^{\top}{\mathbf{B}}{\mathbf{x}}{\mathbf{x}}^{\top}]_{ij}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(52)</span></td></tr></tbody>
<tbody id="A1.E53"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.E53.m1" class="ltx_Math" alttext="\displaystyle=\sum_{k\in[d]}\sum_{l\in[d]}\sum_{m\in[d]}\sum_{n\in[d]}a_{kl}b_{mn}\cdot\displaystyle\mathbb{E}[x_{i}x_{k}x_{l}x_{m}x_{n}x_{j}]" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mi>k</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mi>d</mi><mo stretchy="false">]</mo></mrow></mrow></munder></mstyle><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mi>l</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mi>d</mi><mo stretchy="false">]</mo></mrow></mrow></munder></mstyle><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mi>m</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mi>d</mi><mo stretchy="false">]</mo></mrow></mrow></munder></mstyle><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mi>n</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mi>d</mi><mo stretchy="false">]</mo></mrow></mrow></munder></mstyle><mrow><msub><mi>a</mi><mrow><mi>k</mi><mo lspace="0em" rspace="0em">​</mo><mi>l</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>b</mi><mrow><mi>m</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow></msub></mrow></mrow></mrow></mrow></mrow><mo lspace="0.222em" rspace="0.222em">⋅</mo><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><msub><mi>x</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>x</mi><mi>k</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>x</mi><mi>l</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>x</mi><mi>m</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>x</mi><mi>n</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>x</mi><mi>j</mi></msub></mrow><mo stretchy="false">]</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\sum_{k\in[d]}\sum_{l\in[d]}\sum_{m\in[d]}\sum_{n\in[d]}a_{kl}b_{mn}\cdot\displaystyle\mathbb{E}[x_{i}x_{k}x_{l}x_{m}x_{n}x_{j}]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(53)</span></td></tr></tbody>
<tbody id="A1.E54"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.E54.m1" class="ltx_Math" alttext="\displaystyle=\sigma_{ij}\cdot\tr({\mathbf{\Sigma}}{\mathbf{A}}^{\top})\tr({\mathbf{\Sigma}}{\mathbf{B}}^{\top})+\sigma_{ij}\cdot\left(\tr({\mathbf{\Sigma}}{\mathbf{B}}{\mathbf{\Sigma}}{\mathbf{A}}^{\top})+\tr({\mathbf{\Sigma}}{\mathbf{B}}^{\top}{\mathbf{\Sigma}}{\mathbf{A}}^{\top})\right)+\sum_{k\in[d]}\sum_{l\in[d]}\sigma_{ik}a_{kl}\sigma_{lj}\cdot\tr({\mathbf{\Sigma}}{\mathbf{B}}^{\top})" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><mrow><msub><mi>σ</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>j</mi></mrow></msub><mo lspace="0.222em" rspace="0.222em">⋅</mo><mrow><mi>tr</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>𝚺</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝐀</mi><mo>⊤</mo></msup></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>tr</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>𝚺</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝐁</mi><mo>⊤</mo></msup></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>+</mo><mrow><msub><mi>σ</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>j</mi></mrow></msub><mo lspace="0.222em" rspace="0.222em">⋅</mo><mrow><mo>(</mo><mrow><mrow><mi>tr</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>𝚺</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝐁</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝚺</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝐀</mi><mo>⊤</mo></msup></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mrow><mi>tr</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>𝚺</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝐁</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>𝚺</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝐀</mi><mo>⊤</mo></msup></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>)</mo></mrow></mrow><mo>+</mo><mrow><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mi>k</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mi>d</mi><mo stretchy="false">]</mo></mrow></mrow></munder></mstyle><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mi>l</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mi>d</mi><mo stretchy="false">]</mo></mrow></mrow></munder></mstyle><mrow><msub><mi>σ</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>k</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>a</mi><mrow><mi>k</mi><mo lspace="0em" rspace="0em">​</mo><mi>l</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>σ</mi><mrow><mi>l</mi><mo lspace="0em" rspace="0em">​</mo><mi>j</mi></mrow></msub></mrow></mrow></mrow><mo lspace="0.222em" rspace="0.222em">⋅</mo><mrow><mi>tr</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>𝚺</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝐁</mi><mo>⊤</mo></msup></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\sigma_{ij}\cdot\tr({\mathbf{\Sigma}}{\mathbf{A}}^{\top})\tr({\mathbf{\Sigma}}{\mathbf{B}}^{\top})+\sigma_{ij}\cdot\left(\tr({\mathbf{\Sigma}}{\mathbf{B}}{\mathbf{\Sigma}}{\mathbf{A}}^{\top})+\tr({\mathbf{\Sigma}}{\mathbf{B}}^{\top}{\mathbf{\Sigma}}{\mathbf{A}}^{\top})\right)+\sum_{k\in[d]}\sum_{l\in[d]}\sigma_{ik}a_{kl}\sigma_{lj}\cdot\tr({\mathbf{\Sigma}}{\mathbf{B}}^{\top})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(54)</span></td></tr></tbody>
<tbody id="A1.E55"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.E55.m1" class="ltx_math_unparsed" alttext="\displaystyle\quad+\sum_{k\in[d]}\sum_{l\in[d]}\sum_{m\in[d]}\sum_{n\in[d]}\left(\sigma_{ik}a_{kl}\sigma_{lm}b_{mn}\sigma_{nj}+\sigma_{ik}a_{kl}\sigma_{ln}b^{\top}_{nm}\sigma_{mj}\right)+\sum_{k\in[d]}\sum_{l\in[d]}\sigma_{il}a^{\top}_{lk}\sigma_{kj}\cdot\tr({\mathbf{\Sigma}}{\mathbf{B}}^{\top})" display="inline" intent=":literal"><semantics><mrow><mo>+</mo><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mi>k</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mi>d</mi><mo stretchy="false">]</mo></mrow></mrow></munder></mstyle><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mi>l</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mi>d</mi><mo stretchy="false">]</mo></mrow></mrow></munder></mstyle><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mi>m</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mi>d</mi><mo stretchy="false">]</mo></mrow></mrow></munder></mstyle><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mi>n</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mi>d</mi><mo stretchy="false">]</mo></mrow></mrow></munder></mstyle><mrow><mo>(</mo><msub><mi>σ</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>k</mi></mrow></msub><msub><mi>a</mi><mrow><mi>k</mi><mo lspace="0em" rspace="0em">​</mo><mi>l</mi></mrow></msub><msub><mi>σ</mi><mrow><mi>l</mi><mo lspace="0em" rspace="0em">​</mo><mi>m</mi></mrow></msub><msub><mi>b</mi><mrow><mi>m</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow></msub><msub><mi>σ</mi><mrow><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><mi>j</mi></mrow></msub><mo>+</mo><msub><mi>σ</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>k</mi></mrow></msub><msub><mi>a</mi><mrow><mi>k</mi><mo lspace="0em" rspace="0em">​</mo><mi>l</mi></mrow></msub><msub><mi>σ</mi><mrow><mi>l</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow></msub><msubsup><mi>b</mi><mrow><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><mi>m</mi></mrow><mo>⊤</mo></msubsup><msub><mi>σ</mi><mrow><mi>m</mi><mo lspace="0em" rspace="0em">​</mo><mi>j</mi></mrow></msub><mo>)</mo></mrow><mo>+</mo><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mi>k</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mi>d</mi><mo stretchy="false">]</mo></mrow></mrow></munder></mstyle><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mi>l</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mi>d</mi><mo stretchy="false">]</mo></mrow></mrow></munder></mstyle><msub><mi>σ</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>l</mi></mrow></msub><msubsup><mi>a</mi><mrow><mi>l</mi><mo lspace="0em" rspace="0em">​</mo><mi>k</mi></mrow><mo>⊤</mo></msubsup><msub><mi>σ</mi><mrow><mi>k</mi><mo lspace="0em" rspace="0em">​</mo><mi>j</mi></mrow></msub><mo lspace="0.222em" rspace="0.222em">⋅</mo><mi>tr</mi><mrow><mo stretchy="false">(</mo><mi>𝚺</mi><msup><mi>𝐁</mi><mo>⊤</mo></msup><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\quad+\sum_{k\in[d]}\sum_{l\in[d]}\sum_{m\in[d]}\sum_{n\in[d]}\left(\sigma_{ik}a_{kl}\sigma_{lm}b_{mn}\sigma_{nj}+\sigma_{ik}a_{kl}\sigma_{ln}b^{\top}_{nm}\sigma_{mj}\right)+\sum_{k\in[d]}\sum_{l\in[d]}\sigma_{il}a^{\top}_{lk}\sigma_{kj}\cdot\tr({\mathbf{\Sigma}}{\mathbf{B}}^{\top})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(55)</span></td></tr></tbody>
<tbody id="A1.E56"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
