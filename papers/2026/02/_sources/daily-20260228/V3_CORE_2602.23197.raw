y_{i}\end{bmatrix}\bigg)\bigg(\sum_{i\in[n]}\begin{bmatrix}{\mathbf{x}}_{i}\\
y_{i}\end{bmatrix}^{\top}\bigg)\right]\begin{bmatrix}{\mathbf{v}}_{21}\\
v_{22}\end{bmatrix}," display="inline" intent=":literal"><semantics><mrow><mrow><mo>+</mo><mrow><mstyle displaystyle="true"><mfrac><msup><mi>q</mi><mn>2</mn></msup><msup><mi>n</mi><mn>2</mn></msup></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo>[</mo><mtable rowspacing="0pt"><mtr><mtd><msub><mi>𝐯</mi><mn>21</mn></msub></mtd></mtr><mtr><mtd><msub><mi>v</mi><mn>22</mn></msub></mtd></mtr></mtable><mo>]</mo></mrow><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>𝔼</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><mrow><mrow><mo maxsize="2.100em" minsize="2.100em">(</mo><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mi>n</mi><mo stretchy="false">]</mo></mrow></mrow></munder></mstyle><mrow><mo>[</mo><mtable rowspacing="0pt"><mtr><mtd><msub><mi>𝐱</mi><mi>i</mi></msub></mtd></mtr><mtr><mtd><msub><mi>y</mi><mi>i</mi></msub></mtd></mtr></mtable><mo>]</mo></mrow></mrow><mo maxsize="2.100em" minsize="2.100em">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="2.100em" minsize="2.100em">(</mo><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mi>n</mi><mo stretchy="false">]</mo></mrow></mrow></munder></mstyle><msup><mrow><mo>[</mo><mtable rowspacing="0pt"><mtr><mtd><msub><mi>𝐱</mi><mi>i</mi></msub></mtd></mtr><mtr><mtd><msub><mi>y</mi><mi>i</mi></msub></mtd></mtr></mtable><mo>]</mo></mrow><mo>⊤</mo></msup></mrow><mo maxsize="2.100em" minsize="2.100em">)</mo></mrow></mrow><mo>]</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><mtable rowspacing="0pt"><mtr><mtd><msub><mi>𝐯</mi><mn>21</mn></msub></mtd></mtr><mtr><mtd><msub><mi>v</mi><mn>22</mn></msub></mtd></mtr></mtable><mo>]</mo></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\quad+\frac{q^{2}}{n^{2}}\begin{bmatrix}{\mathbf{v}}_{21}\\
v_{22}\end{bmatrix}^{\top}\displaystyle\mathbb{E}\left[\bigg(\sum_{i\in[n]}\begin{bmatrix}{\mathbf{x}}_{i}\\
y_{i}\end{bmatrix}\bigg)\bigg(\sum_{i\in[n]}\begin{bmatrix}{\mathbf{x}}_{i}\\
y_{i}\end{bmatrix}^{\top}\bigg)\right]\begin{bmatrix}{\mathbf{v}}_{21}\\
v_{22}\end{bmatrix},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(88)</span></td></tr></tbody>
</table>
<p id="A1.SS2.p4.2" class="ltx_p"><span id="A1.SS2.p4.2.1" class="ltx_text">where (<a href="#A1.E86" title="Equation 86 ‣ Proof. ‣ A.2 Proofs of Statistical Properties of Model Outputs ‣ Appendix A Proofs ‣ Fine-Tuning Without Forgetting In-Context Learning:A Theoretical Analysis of Linear Attention Models" class="ltx_ref"><span class="ltx_text ltx_ref_tag">86</span></a>) holds from <cite class="ltx_cite ltx_citemacro_citet"><a href="#bib.bib12" title="" class="ltx_ref">Isserlis (1918)</a></cite> theorem.</span></p>
</div>
<div id="A1.SS2.p5" class="ltx_para">
<p id="A1.SS2.p5.1" class="ltx_p"><span id="A1.SS2.p5.1.1" class="ltx_text">Note that <math id="A1.SS2.p5.m1" class="ltx_Math" alttext="\sum_{i\in[n]}\begin{bmatrix}{\mathbf{x}}_{i}\\
y_{i}\end{bmatrix}\begin{bmatrix}{\mathbf{x}}_{i}\\
y_{i}\end{bmatrix}^{\top}" display="inline" intent=":literal"><semantics><mrow><msub><mo>∑</mo><mrow><mi>i</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mi>n</mi><mo stretchy="false">]</mo></mrow></mrow></msub><mrow><mrow><mo lspace="0em">[</mo><mtable rowspacing="0pt"><mtr><mtd><msub><mi>𝐱</mi><mi>i</mi></msub></mtd></mtr><mtr><mtd><msub><mi>y</mi><mi>i</mi></msub></mtd></mtr></mtable><mo>]</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo>[</mo><mtable rowspacing="0pt"><mtr><mtd><msub><mi>𝐱</mi><mi>i</mi></msub></mtd></mtr><mtr><mtd><msub><mi>y</mi><mi>i</mi></msub></mtd></mtr></mtable><mo>]</mo></mrow><mo>⊤</mo></msup></mrow></mrow><annotation encoding="application/x-tex">\sum_{i\in[n]}\begin{bmatrix}{\mathbf{x}}_{i}\\
y_{i}\end{bmatrix}\begin{bmatrix}{\mathbf{x}}_{i}\\
y_{i}\end{bmatrix}^{\top}</annotation></semantics></math> follows the Wishart distribution <math id="A1.SS2.p5.m2" class="ltx_Math" alttext="\mathcal{W}({\mathbf{\Sigma}}_{\mathrm{joint}},n)" display="inline" intent=":literal"><semantics><mrow><mi class="ltx_font_mathcaligraphic">𝒲</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝚺</mi><mi>joint</mi></msub><mo>,</mo><mi>n</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathcal{W}({\mathbf{\Sigma}}_{\mathrm{joint}},n)</annotation></semantics></math> because <math id="A1.SS2.p5.m3" class="ltx_Math" alttext="\begin{bmatrix}{\mathbf{x}}_{i}\\
y_{i}\end{bmatrix}\overset{\mathrm{iid}}{\sim}\mathcal{N}\left({\mathbf{0}}_{d+1},{\mathbf{\Sigma}}_{\mathrm{joint}}\right)" display="inline" intent=":literal"><semantics><mrow><mrow><mo>[</mo><mtable rowspacing="0pt"><mtr><mtd><msub><mi>𝐱</mi><mi>i</mi></msub></mtd></mtr><mtr><mtd><msub><mi>y</mi><mi>i</mi></msub></mtd></mtr></mtable><mo>]</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mover accent="true"><mo>∼</mo><mo mathsize="0.700em">iid</mo></mover><mo lspace="0em" rspace="0em">​</mo><mi class="ltx_font_mathcaligraphic">𝒩</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><msub><mn>𝟎</mn><mrow><mi>d</mi><mo>+</mo><mn>1</mn></mrow></msub><mo>,</mo><msub><mi>𝚺</mi><mi>joint</mi></msub><mo>)</mo></mrow></mrow><annotation encoding="application/x-tex">\begin{bmatrix}{\mathbf{x}}_{i}\\
y_{i}\end{bmatrix}\overset{\mathrm{iid}}{\sim}\mathcal{N}\left({\mathbf{0}}_{d+1},{\mathbf{\Sigma}}_{\mathrm{joint}}\right)</annotation></semantics></math> for all <math id="A1.SS2.p5.m4" class="ltx_Math" alttext="i\in[n]" display="inline" intent=":literal"><semantics><mrow><mi>i</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mi>n</mi><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">i\in[n]</annotation></semantics></math>. By using Lemma <a href="#A1.Thmtheorem1" title="Lemma A.1 (Theorem 1 in ( ) ; specialized version of Theorem 2.2.9 (ii) in ( ) ). ‣ A.1 Proofs of Preliminary Lemma ‣ Appendix A Proofs ‣ Fine-Tuning Without Forgetting In-Context Learning:A Theoretical Analysis of Linear Attention Models" class="ltx_ref"><span class="ltx_text ltx_ref_tag">A.1</span></a>, we have</span></p>
<table id="A1.EGx30" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A1.E89"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.E89.m1" class="ltx_Math" alttext="\displaystyle\displaystyle\mathbb{E}\left[\sum_{i\in[n]}\begin{bmatrix}{\mathbf{x}}_{i}\\
y_{i}\end{bmatrix}\begin{bmatrix}{\mathbf{x}}_{i}\\
y_{i}\end{bmatrix}^{\top}\begin{bmatrix}{\mathbf{Q}}_{11}\\
{\mathbf{q}}_{21}^{\top}\end{bmatrix}{\mathbf{\Sigma}}\begin{bmatrix}{\mathbf{Q}}_{11}\\
{\mathbf{q}}_{21}^{\top}\end{bmatrix}^{\top}\sum_{i\in[n]}\begin{bmatrix}{\mathbf{x}}_{i}\\
y_{i}\end{bmatrix}\begin{bmatrix}{\mathbf{x}}_{i}\\
y_{i}\end{bmatrix}^{\top}\right]" display="inline" intent=":literal"><semantics><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mi>n</mi><mo stretchy="false">]</mo></mrow></mrow></munder></mstyle><mrow><mrow><mo>[</mo><mtable rowspacing="0pt"><mtr><mtd><msub><mi>𝐱</mi><mi>i</mi></msub></mtd></mtr><mtr><mtd><msub><mi>y</mi><mi>i</mi></msub></mtd></mtr></mtable><mo>]</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo>[</mo><mtable rowspacing="0pt"><mtr><mtd><msub><mi>𝐱</mi><mi>i</mi></msub></mtd></mtr><mtr><mtd><msub><mi>y</mi><mi>i</mi></msub></mtd></mtr></mtable><mo>]</mo></mrow><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><mtable rowspacing="0pt"><mtr><mtd><msub><mi>𝐐</mi><mn>11</mn></msub></mtd></mtr><mtr><mtd><msubsup><mi>𝐪</mi><mn>21</mn><mo>⊤</mo></msubsup></mtd></mtr></mtable><mo>]</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>𝚺</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo>[</mo><mtable rowspacing="0pt"><mtr><mtd><msub><mi>𝐐</mi><mn>11</mn></msub></mtd></mtr><mtr><mtd><msubsup><mi>𝐪</mi><mn>21</mn><mo>⊤</mo></msubsup></mtd></mtr></mtable><mo>]</mo></mrow><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mi>n</mi><mo stretchy="false">]</mo></mrow></mrow></munder></mstyle><mrow><mrow><mo>[</mo><mtable rowspacing="0pt"><mtr><mtd><msub><mi>𝐱</mi><mi>i</mi></msub></mtd></mtr><mtr><mtd><msub><mi>y</mi><mi>i</mi></msub></mtd></mtr></mtable><mo>]</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo>[</mo><mtable rowspacing="0pt"><mtr><mtd><msub><mi>𝐱</mi><mi>i</mi></msub></mtd></mtr><mtr><mtd><msub><mi>y</mi><mi>i</mi></msub></mtd></mtr></mtable><mo>]</mo></mrow><mo>⊤</mo></msup></mrow></mrow></mrow></mrow><mo>]</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\displaystyle\mathbb{E}\left[\sum_{i\in[n]}\begin{bmatrix}{\mathbf{x}}_{i}\\
y_{i}\end{bmatrix}\begin{bmatrix}{\mathbf{x}}_{i}\\
y_{i}\end{bmatrix}^{\top}\begin{bmatrix}{\mathbf{Q}}_{11}\\
{\mathbf{q}}_{21}^{\top}\end{bmatrix}{\mathbf{\Sigma}}\begin{bmatrix}{\mathbf{Q}}_{11}\\
{\mathbf{q}}_{21}^{\top}\end{bmatrix}^{\top}\sum_{i\in[n]}\begin{bmatrix}{\mathbf{x}}_{i}\\
y_{i}\end{bmatrix}\begin{bmatrix}{\mathbf{x}}_{i}\\
y_{i}\end{bmatrix}^{\top}\right]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(89)</span></td></tr></tbody>
<tbody id="A1.E90"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.E90.m1" class="ltx_Math" alttext="\displaystyle=n\cdot\tr\left(\begin{bmatrix}{\mathbf{Q}}_{11}\\
{\mathbf{q}}_{21}^{\top}\end{bmatrix}{\mathbf{\Sigma}}\begin{bmatrix}{\mathbf{Q}}_{11}\\
{\mathbf{q}}_{21}^{\top}\end{bmatrix}^{\top}{\mathbf{\Sigma}}_{\mathrm{joint}}\right)\cdot{\mathbf{\Sigma}}_{\mathrm{joint}}+n(n+1){\mathbf{\Sigma}}_{\mathrm{joint}}\begin{bmatrix}{\mathbf{Q}}_{11}\\
{\mathbf{q}}_{21}^{\top}\end{bmatrix}{\mathbf{\Sigma}}\begin{bmatrix}{\mathbf{Q}}_{11}\\
{\mathbf{q}}_{21}^{\top}\end{bmatrix}^{\top}{\mathbf{\Sigma}}_{\mathrm{joint}}." display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><mi>n</mi><mo lspace="0.222em" rspace="0.222em">⋅</mo><mrow><mi>tr</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mrow><mo>[</mo><mtable rowspacing="0pt"><mtr><mtd><msub><mi>𝐐</mi><mn>11</mn></msub></mtd></mtr><mtr><mtd><msubsup><mi>𝐪</mi><mn>21</mn><mo>⊤</mo></msubsup></mtd></mtr></mtable><mo>]</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>𝚺</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo>[</mo><mtable rowspacing="0pt"><mtr><mtd><msub><mi>𝐐</mi><mn>11</mn></msub></mtd></mtr><mtr><mtd><msubsup><mi>𝐪</mi><mn>21</mn><mo>⊤</mo></msubsup></mtd></mtr></mtable><mo>]</mo></mrow><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝚺</mi><mi>joint</mi></msub></mrow><mo rspace="0.055em">)</mo></mrow></mrow><mo rspace="0.222em">⋅</mo><msub><mi>𝚺</mi><mi>joint</mi></msub></mrow><mo>+</mo><mrow><mrow><mi>n</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>n</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝚺</mi><mi>joint</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><mtable rowspacing="0pt"><mtr><mtd><msub><mi>𝐐</mi><mn>11</mn></msub></mtd></mtr><mtr><mtd><msubsup><mi>𝐪</mi><mn>21</mn><mo>⊤</mo></msubsup></mtd></mtr></mtable><mo>]</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>𝚺</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo>[</mo><mtable rowspacing="0pt"><mtr><mtd><msub><mi>𝐐</mi><mn>11</mn></msub></mtd></mtr><mtr><mtd><msubsup><mi>𝐪</mi><mn>21</mn><mo>⊤</mo></msubsup></mtd></mtr></mtable><mo>]</mo></mrow><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝚺</mi><mi>joint</mi></msub></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle=n\cdot\tr\left(\begin{bmatrix}{\mathbf{Q}}_{11}\\
{\mathbf{q}}_{21}^{\top}\end{bmatrix}{\mathbf{\Sigma}}\begin{bmatrix}{\mathbf{Q}}_{11}\\
{\mathbf{q}}_{21}^{\top}\end{bmatrix}^{\top}{\mathbf{\Sigma}}_{\mathrm{joint}}\right)\cdot{\mathbf{\Sigma}}_{\mathrm{joint}}+n(n+1){\mathbf{\Sigma}}_{\mathrm{joint}}\begin{bmatrix}{\mathbf{Q}}_{11}\\
{\mathbf{q}}_{21}^{\top}\end{bmatrix}{\mathbf{\Sigma}}\begin{bmatrix}{\mathbf{Q}}_{11}\\
{\mathbf{q}}_{21}^{\top}\end{bmatrix}^{\top}{\mathbf{\Sigma}}_{\mathrm{joint}}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(90)</span></td></tr></tbody>
</table>
<p id="A1.SS2.p5.2" class="ltx_p"><span id="A1.SS2.p5.2.1" class="ltx_text">Therefore, we have</span></p>
<table id="A1.EGx31" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A1.E91"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.E91.m1" class="ltx_Math" alttext="\displaystyle\displaystyle\mathrm{Var}\left[\hat{y}_{\mathrm{Net\text{-}FS}}({\mathbf{Z}}_{[n]},{\mathbf{x}}_{n+1};{\mathbf{V}},{\mathbf{Q}})\right]" display="inline" intent=":literal"><semantics><mrow><mi>Var</mi><mo>⁡</mo><mrow><mo>[</mo><mrow><msub><mover accent="true"><mi>y</mi><mo>^</mo></mover><mrow><mi>Net</mi><mo lspace="0em" rspace="0em">​</mo><mtext>-</mtext><mo lspace="0em" rspace="0em">​</mo><mi>FS</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐙</mi><mrow><mo stretchy="false">[</mo><mi>n</mi><mo stretchy="false">]</mo></mrow></msub><mo>,</mo><msub><mi>𝐱</mi><mrow><mi>n</mi><mo>+</mo><mn>1</mn></mrow></msub><mo>,</mo><mi>𝐕</mi><mo>,</mo><mi>𝐐</mi><mo stretchy="false">)</mo></mrow></mrow><mo>]</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\displaystyle\mathrm{Var}\left[\hat{y}_{\mathrm{Net\text{-}FS}}({\mathbf{Z}}_{[n]},{\mathbf{x}}_{n+1};{\mathbf{V}},{\mathbf{Q}})\right]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(91)</span></td></tr></tbody>
<tbody id="A1.E92"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.E92.m1" class="ltx_Math" alttext="\displaystyle=\frac{1}{n}\cdot\tr\left(\begin{bmatrix}{\mathbf{Q}}_{11}\\
{\mathbf{q}}_{21}^{\top}\end{bmatrix}{\mathbf{\Sigma}}\begin{bmatrix}{\mathbf{Q}}_{11}\\
{\mathbf{q}}_{21}^{\top}\end{bmatrix}^{\top}{\mathbf{\Sigma}}_{\mathrm{joint}}\right)\cdot\begin{bmatrix}{\mathbf{v}}_{21}\\
v_{22}\end{bmatrix}^{\top}{\mathbf{\Sigma}}_{\mathrm{joint}}\begin{bmatrix}{\mathbf{v}}_{21}\\
v_{22}\end{bmatrix}+\frac{n+1}{n}\cdot\begin{bmatrix}{\mathbf{v}}_{21}\\
v_{22}\end{bmatrix}^{\top}{\mathbf{\Sigma}}_{\mathrm{joint}}\begin{bmatrix}{\mathbf{Q}}_{11}\\
{\mathbf{q}}_{21}^{\top}\end{bmatrix}{\mathbf{\Sigma}}\begin{bmatrix}{\mathbf{Q}}_{11}\\
{\mathbf{q}}_{21}^{\top}\end{bmatrix}^{\top}{\mathbf{\Sigma}}_{\mathrm{joint}}\begin{bmatrix}{\mathbf{v}}_{21}\\
v_{22}\end{bmatrix}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>n</mi></mfrac></mstyle><mo lspace="0.222em" rspace="0.222em">⋅</mo><mrow><mi>tr</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mrow><mo>[</mo><mtable rowspacing="0pt"><mtr><mtd><msub><mi>𝐐</mi><mn>11</mn></msub></mtd></mtr><mtr><mtd><msubsup><mi>𝐪</mi><mn>21</mn><mo>⊤</mo></msubsup></mtd></mtr></mtable><mo>]</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>𝚺</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo>[</mo><mtable rowspacing="0pt"><mtr><mtd><msub><mi>𝐐</mi><mn>11</mn></msub></mtd></mtr><mtr><mtd><msubsup><mi>𝐪</mi><mn>21</mn><mo>⊤</mo></msubsup></mtd></mtr></mtable><mo>]</mo></mrow><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝚺</mi><mi>joint</mi></msub></mrow><mo rspace="0.055em">)</mo></mrow></mrow><mo rspace="0.222em">⋅</mo><mrow><msup><mrow><mo>[</mo><mtable rowspacing="0pt"><mtr><mtd><msub><mi>𝐯</mi><mn>21</mn></msub></mtd></mtr><mtr><mtd><msub><mi>v</mi><mn>22</mn></msub></mtd></mtr></mtable><mo>]</mo></mrow><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝚺</mi><mi>joint</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><mtable rowspacing="0pt"><mtr><mtd><msub><mi>𝐯</mi><mn>21</mn></msub></mtd></mtr><mtr><mtd><msub><mi>v</mi><mn>22</mn></msub></mtd></mtr></mtable><mo>]</mo></mrow></mrow></mrow><mo>+</mo><mrow><mrow><mstyle displaystyle="true"><mfrac><mrow><mi>n</mi><mo>+</mo><mn>1</mn></mrow><mi>n</mi></mfrac></mstyle><mo lspace="0.222em" rspace="0.222em">⋅</mo><msup><mrow><mo>[</mo><mtable rowspacing="0pt"><mtr><mtd><msub><mi>𝐯</mi><mn>21</mn></msub></mtd></mtr><mtr><mtd><msub><mi>v</mi><mn>22</mn></msub></mtd></mtr></mtable><mo>]</mo></mrow><mo>⊤</mo></msup></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝚺</mi><mi>joint</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><mtable rowspacing="0pt"><mtr><mtd><msub><mi>𝐐</mi><mn>11</mn></msub></mtd></mtr><mtr><mtd><msubsup><mi>𝐪</mi><mn>21</mn><mo>⊤</mo></msubsup></mtd></mtr></mtable><mo>]</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>𝚺</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo>[</mo><mtable rowspacing="0pt"><mtr><mtd><msub><mi>𝐐</mi><mn>11</mn></msub></mtd></mtr><mtr><mtd><msubsup><mi>𝐪</mi><mn>21</mn><mo>⊤</mo></msubsup></mtd></mtr></mtable><mo>]</mo></mrow><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝚺</mi><mi>joint</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><mtable rowspacing="0pt"><mtr><mtd><msub><mi>𝐯</mi><mn>21</mn></msub></mtd></mtr><mtr><mtd><msub><mi>v</mi><mn>22</mn></msub></mtd></mtr></mtable><mo>]</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\frac{1}{n}\cdot\tr\left(\begin{bmatrix}{\mathbf{Q}}_{11}\\
{\mathbf{q}}_{21}^{\top}\end{bmatrix}{\mathbf{\Sigma}}\begin{bmatrix}{\mathbf{Q}}_{11}\\
{\mathbf{q}}_{21}^{\top}\end{bmatrix}^{\top}{\mathbf{\Sigma}}_{\mathrm{joint}}\right)\cdot\begin{bmatrix}{\mathbf{v}}_{21}\\
v_{22}\end{bmatrix}^{\top}{\mathbf{\Sigma}}_{\mathrm{joint}}\begin{bmatrix}{\mathbf{v}}_{21}\\
v_{22}\end{bmatrix}+\frac{n+1}{n}\cdot\begin{bmatrix}{\mathbf{v}}_{21}\\
v_{22}\end{bmatrix}^{\top}{\mathbf{\Sigma}}_{\mathrm{joint}}\begin{bmatrix}{\mathbf{Q}}_{11}\\
{\mathbf{q}}_{21}^{\top}\end{bmatrix}{\mathbf{\Sigma}}\begin{bmatrix}{\mathbf{Q}}_{11}\\
{\mathbf{q}}_{21}^{\top}\end{bmatrix}^{\top}{\mathbf{\Sigma}}_{\mathrm{joint}}\begin{bmatrix}{\mathbf{v}}_{21}\\
v_{22}\end{bmatrix}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(92)</span></td></tr></tbody>
<tbody id="A1.E93"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.E93.m1" class="ltx_math_unparsed" alttext="\displaystyle\quad+\frac{q^{2}}{n}\cdot\begin{bmatrix}{\mathbf{v}}_{21}\\
v_{22}\end{bmatrix}^{\top}{\mathbf{\Sigma}}_{\mathrm{joint}}\begin{bmatrix}{\mathbf{v}}_{21}\\
v_{22}\end{bmatrix}," display="inline" intent=":literal"><semantics><mrow><mo>+</mo><mstyle displaystyle="true"><mfrac><msup><mi>q</mi><mn>2</mn></msup><mi>n</mi></mfrac></mstyle><mo lspace="0.222em" rspace="0.222em">⋅</mo><mrow><mo>[</mo><mtable rowspacing="0pt"><mtr><mtd><msub><mi>𝐯</mi><mn>21</mn></msub></mtd></mtr><mtr><mtd><msub><mi>v</mi><mn>22</mn></msub></mtd></mtr></mtable><mo>]</mo></mrow><msup><mrow></mrow><mo>⊤</mo></msup><mi>𝚺</mi><msub><mrow></mrow><mi>joint</mi></msub><mrow><mo>[</mo><mtable rowspacing="0pt"><mtr><mtd><msub><mi>𝐯</mi><mn>21</mn></msub></mtd></mtr><mtr><mtd><msub><mi>v</mi><mn>22</mn></msub></mtd></mtr></mtable><mo>]</mo></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\quad+\frac{q^{2}}{n}\cdot\begin{bmatrix}{\mathbf{v}}_{21}\\
v_{22}\end{bmatrix}^{\top}{\mathbf{\Sigma}}_{\mathrm{joint}}\begin{bmatrix}{\mathbf{v}}_{21}\\
v_{22}\end{bmatrix},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(93)</span></td></tr></tbody>
</table>
<p id="A1.SS2.p5.3" class="ltx_p"><span id="A1.SS2.p5.3.1" class="ltx_text">where the last term comes from <math id="A1.SS2.p5.m5" class="ltx_Math" alttext="\sum_{i\in[n]}\begin{bmatrix}{\mathbf{x}}_{i}\\
y_{i}\end{bmatrix}\sim\mathcal{N}\left({\mathbf{0}}_{d+1},n{\mathbf{\Sigma}}_{\mathrm{joint}}\right)" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mo>∑</mo><mrow><mi>i</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mi>n</mi><mo stretchy="false">]</mo></mrow></mrow></msub><mrow><mo lspace="0em">[</mo><mtable rowspacing="0pt"><mtr><mtd><msub><mi>𝐱</mi><mi>i</mi></msub></mtd></mtr><mtr><mtd><msub><mi>y</mi><mi>i</mi></msub></mtd></mtr></mtable><mo>]</mo></mrow></mrow><mo>∼</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒩</mi><mo>⁡</mo><mrow><mo>(</mo><msub><mn>𝟎</mn><mrow><mi>d</mi><mo>+</mo><mn>1</mn></mrow></msub><mo>,</mo><mrow><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝚺</mi><mi>joint</mi></msub></mrow><mo>)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\sum_{i\in[n]}\begin{bmatrix}{\mathbf{x}}_{i}\\
y_{i}\end{bmatrix}\sim\mathcal{N}\left({\mathbf{0}}_{d+1},n{\mathbf{\Sigma}}_{\mathrm{joint}}\right)</annotation></semantics></math>.</span></p>
</div>
<div id="A1.SS2.p6" class="ltx_para">
<p id="A1.SS2.p6.1" class="ltx_p"><span id="A1.SS2.p6.1.1" class="ltx_text">On the other hand, from the definition of <math id="A1.SS2.p6.m1" class="ltx_Math" alttext="\hat{y}_{\mathrm{ZS}}({\mathbf{x}}_{n+1};{\mathbf{V}},{\mathbf{Q}})" display="inline" intent=":literal"><semantics><mrow><msub><mover accent="true"><mi>y</mi><mo>^</mo></mover><mi>ZS</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐱</mi><mrow><mi>n</mi><mo>+</mo><mn>1</mn></mrow></msub><mo>,</mo><mi>𝐕</mi><mo>,</mo><mi>𝐐</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\hat{y}_{\mathrm{ZS}}({\mathbf{x}}_{n+1};{\mathbf{V}},{\mathbf{Q}})</annotation></semantics></math> in (<a href="#A1.E73" title="Equation 73 ‣ A.2 Proofs of Statistical Properties of Model Outputs ‣ Appendix A Proofs ‣ Fine-Tuning Without Forgetting In-Context Learning:A Theoretical Analysis of Linear Attention Models" class="ltx_ref"><span class="ltx_text ltx_ref_tag">73</span></a>), we obtain</span></p>
<table id="A1.EGx32" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A1.E94"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.E94.m1" class="ltx_Math" alttext="\displaystyle\displaystyle\mathrm{Var}\left[\hat{y}_{\mathrm{ZS}}({\mathbf{x}}_{n+1};{\mathbf{V}},{\mathbf{Q}})\right]" display="inline" intent=":literal"><semantics><mrow><mi>Var</mi><mo>⁡</mo><mrow><mo>[</mo><mrow><msub><mover accent="true"><mi>y</mi><mo>^</mo></mover><mi>ZS</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐱</mi><mrow><mi>n</mi><mo>+</mo><mn>1</mn></mrow></msub><mo>,</mo><mi>𝐕</mi><mo>,</mo><mi>𝐐</mi><mo stretchy="false">)</mo></mrow></mrow><mo>]</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\displaystyle\mathrm{Var}\left[\hat{y}_{\mathrm{ZS}}({\mathbf{x}}_{n+1};{\mathbf{V}},{\mathbf{Q}})\right]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(94)</span></td></tr></tbody>
<tbody id="A1.E95"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.E95.m1" class="ltx_Math" alttext="\displaystyle=\displaystyle\mathbb{E}\left[\hat{y}_{\mathrm{ZS}}({\mathbf{x}}_{n+1};{\mathbf{V}},{\mathbf{Q}})^{2}\right]" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><mrow><msub><mover accent="true"><mi>y</mi><mo>^</mo></mover><mi>ZS</mi></msub><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><msub><mi>𝐱</mi><mrow><mi>n</mi><mo>+</mo><mn>1</mn></mrow></msub><mo>,</mo><mi>𝐕</mi><mo>,</mo><mi>𝐐</mi><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mrow><mo>]</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\displaystyle\mathbb{E}\left[\hat{y}_{\mathrm{ZS}}({\mathbf{x}}_{n+1};{\mathbf{V}},{\mathbf{Q}})^{2}\right]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(95)</span></td></tr></tbody>
<tbody id="A1.E96"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.E96.m1" class="ltx_Math" alttext="\displaystyle=\displaystyle\mathbb{E}\left[{\mathbf{v}}_{21}^{\top}{\mathbf{x}}_{n+1}{\mathbf{x}}_{n+1}^{\top}{\mathbf{Q}}_{11}{\mathbf{x}}_{n+1}{\mathbf{x}}_{n+1}^{\top}{\mathbf{Q}}_{11}^{\top}{\mathbf{x}}_{n+1}{\mathbf{x}}_{n+1}^{\top}{\mathbf{v}}_{21}\right]+2q\cdot\displaystyle\mathbb{E}\left[{\mathbf{x}}_{n+1}^{\top}{\mathbf{v}}_{21}{\mathbf{v}}_{21}^{\top}{\mathbf{x}}_{n+1}{\mathbf{x}}_{n+1}^{\top}{\mathbf{Q}}_{11}{\mathbf{x}}_{n+1}\right]+q^{2}\cdot\displaystyle\mathbb{E}\left[{\mathbf{v}}_{21}^{\top}{\mathbf{x}}_{n+1}{\mathbf{x}}_{n+1}^{\top}{\mathbf{v}}_{21}\right]" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><mrow><msubsup><mi>𝐯</mi><mn>21</mn><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝐱</mi><mrow><mi>n</mi><mo>+</mo><mn>1</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝐱</mi><mrow><mi>n</mi><mo>+</mo><mn>1</mn></mrow><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝐐</mi><mn>11</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝐱</mi><mrow><mi>n</mi><mo>+</mo><mn>1</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝐱</mi><mrow><mi>n</mi><mo>+</mo><mn>1</mn></mrow><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝐐</mi><mn>11</mn><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝐱</mi><mrow><mi>n</mi><mo>+</mo><mn>1</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝐱</mi><mrow><mi>n</mi><mo>+</mo><mn>1</mn></mrow><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝐯</mi><mn>21</mn></msub></mrow><mo>]</mo></mrow></mrow><mo>+</mo><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow><mo lspace="0.222em" rspace="0.222em">⋅</mo><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><mrow><msubsup><mi>𝐱</mi><mrow><mi>n</mi><mo>+</mo><mn>1</mn></mrow><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝐯</mi><mn>21</mn></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝐯</mi><mn>21</mn><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝐱</mi><mrow><mi>n</mi><mo>+</mo><mn>1</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝐱</mi><mrow><mi>n</mi><mo>+</mo><mn>1</mn></mrow><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝐐</mi><mn>11</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝐱</mi><mrow><mi>n</mi><mo>+</mo><mn>1</mn></mrow></msub></mrow><mo>]</mo></mrow></mrow></mrow><mo>+</mo><mrow><msup><mi>q</mi><mn>2</mn></msup><mo lspace="0.222em" rspace="0.222em">⋅</mo><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><mrow><msubsup><mi>𝐯</mi><mn>21</mn><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝐱</mi><mrow><mi>n</mi><mo>+</mo><mn>1</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝐱</mi><mrow><mi>n</mi><mo>+</mo><mn>1</mn></mrow><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝐯</mi><mn>21</mn></msub></mrow><mo>]</mo></mrow></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\displaystyle\mathbb{E}\left[{\mathbf{v}}_{21}^{\top}{\mathbf{x}}_{n+1}{\mathbf{x}}_{n+1}^{\top}{\mathbf{Q}}_{11}{\mathbf{x}}_{n+1}{\mathbf{x}}_{n+1}^{\top}{\mathbf{Q}}_{11}^{\top}{\mathbf{x}}_{n+1}{\mathbf{x}}_{n+1}^{\top}{\mathbf{v}}_{21}\right]+2q\cdot\displaystyle\mathbb{E}\left[{\mathbf{x}}_{n+1}^{\top}{\mathbf{v}}_{21}{\mathbf{v}}_{21}^{\top}{\mathbf{x}}_{n+1}{\mathbf{x}}_{n+1}^{\top}{\mathbf{Q}}_{11}{\mathbf{x}}_{n+1}\right]+q^{2}\cdot\displaystyle\mathbb{E}\left[{\mathbf{v}}_{21}^{\top}{\mathbf{x}}_{n+1}{\mathbf{x}}_{n+1}^{\top}{\mathbf{v}}_{21}\right]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(96)</span></td></tr></tbody>
<tbody id="A1.E97"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.E97.m1" class="ltx_Math" alttext="\displaystyle={\mathbf{v}}_{21}^{\top}\displaystyle\mathbb{E}\left[{\mathbf{x}}_{n+1}{\mathbf{x}}_{n+1}^{\top}{\mathbf{Q}}_{11}{\mathbf{x}}_{n+1}{\mathbf{x}}_{n+1}^{\top}{\mathbf{Q}}_{11}^{\top}{\mathbf{x}}_{n+1}{\mathbf{x}}_{n+1}^{\top}\right]{\mathbf{v}}_{21}+q\cdot\displaystyle\mathbb{E}\left[{\mathbf{x}}_{n+1}^{\top}{\mathbf{v}}_{21}{\mathbf{v}}_{21}^{\top}{\mathbf{x}}_{n+1}{\mathbf{x}}_{n+1}^{\top}({\mathbf{Q}}_{11}+{\mathbf{Q}}_{11}^{\top}){\mathbf{x}}_{n+1}\right]+q^{2}\cdot{\mathbf{v}}_{21}^{\top}{\mathbf{\Sigma}}{\mathbf{v}}_{21}." display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><msubsup><mi>𝐯</mi><mn>21</mn><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>𝔼</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><mrow><msub><mi>𝐱</mi><mrow><mi>n</mi><mo>+</mo><mn>1</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝐱</mi><mrow><mi>n</mi><mo>+</mo><mn>1</mn></mrow><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝐐</mi><mn>11</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝐱</mi><mrow><mi>n</mi><mo>+</mo><mn>1</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝐱</mi><mrow><mi>n</mi><mo>+</mo><mn>1</mn></mrow><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝐐</mi><mn>11</mn><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝐱</mi><mrow><mi>n</mi><mo>+</mo><mn>1</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝐱</mi><mrow><mi>n</mi><mo>+</mo><mn>1</mn></mrow><mo>⊤</mo></msubsup></mrow><mo>]</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝐯</mi><mn>21</mn></msub></mrow><mo>+</mo><mrow><mi>q</mi><mo lspace="0.222em" rspace="0.222em">⋅</mo><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><mrow><msubsup><mi>𝐱</mi><mrow><mi>n</mi><mo>+</mo><mn>1</mn></mrow><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝐯</mi><mn>21</mn></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝐯</mi><mn>21</mn><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝐱</mi><mrow><mi>n</mi><mo>+</mo><mn>1</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝐱</mi><mrow><mi>n</mi><mo>+</mo><mn>1</mn></mrow><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>𝐐</mi><mn>11</mn></msub><mo>+</mo><msubsup><mi>𝐐</mi><mn>11</mn><mo>⊤</mo></msubsup></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝐱</mi><mrow><mi>n</mi><mo>+</mo><mn>1</mn></mrow></msub></mrow><mo>]</mo></mrow></mrow></mrow><mo>+</mo><mrow><mrow><msup><mi>q</mi><mn>2</mn></msup><mo lspace="0.222em" rspace="0.222em">⋅</mo><msubsup><mi>𝐯</mi><mn>21</mn><mo>⊤</mo></msubsup></mrow><mo lspace="0em" rspace="0em">​</mo><mi>𝚺</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝐯</mi><mn>21</mn></msub></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle={\mathbf{v}}_{21}^{\top}\displaystyle\mathbb{E}\left[{\mathbf{x}}_{n+1}{\mathbf{x}}_{n+1}^{\top}{\mathbf{Q}}_{11}{\mathbf{x}}_{n+1}{\mathbf{x}}_{n+1}^{\top}{\mathbf{Q}}_{11}^{\top}{\mathbf{x}}_{n+1}{\mathbf{x}}_{n+1}^{\top}\right]{\mathbf{v}}_{21}+q\cdot\displaystyle\mathbb{E}\left[{\mathbf{x}}_{n+1}^{\top}{\mathbf{v}}_{21}{\mathbf{v}}_{21}^{\top}{\mathbf{x}}_{n+1}{\mathbf{x}}_{n+1}^{\top}({\mathbf{Q}}_{11}+{\mathbf{Q}}_{11}^{\top}){\mathbf{x}}_{n+1}\right]+q^{2}\cdot{\mathbf{v}}_{21}^{\top}{\mathbf{\Sigma}}{\mathbf{v}}_{21}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
