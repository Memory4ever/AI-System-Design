<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(178)</span></td></tr></tbody>
<tbody id="A1.E179"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.E179.m1" class="ltx_Math" alttext="\displaystyle=\frac{n}{(n+1)^{2}}\cdot\bigg(n\cdot\displaystyle\mathbb{E}_{{\mathbf{Z}}_{[n]},{\mathbf{x}},y|{\mathbf{\theta}}_{0}}\left[\left(\hat{y}_{\mathrm{Net\text{-}FS}}({\mathbf{Z}}_{[n]},{\mathbf{x}};{\mathbf{V}},{\mathbf{Q}})-y\right)^{2}\right]" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mstyle displaystyle="true"><mfrac><mi>n</mi><msup><mrow><mo stretchy="false">(</mo><mrow><mi>n</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mfrac></mstyle><mo lspace="0.222em" rspace="0.222em">⋅</mo><mrow><mo maxsize="2.100em" minsize="2.100em">(</mo><mrow><mrow><mi>n</mi><mo lspace="0.222em" rspace="0.222em">⋅</mo><msub><mi>𝔼</mi><mrow><msub><mi>𝐙</mi><mrow><mo stretchy="false">[</mo><mi>n</mi><mo stretchy="false">]</mo></mrow></msub><mo>,</mo><mi>𝐱</mi><mo>,</mo><mrow><mi>y</mi><mo fence="false">|</mo><msub><mi>θ</mi><mn>0</mn></msub></mrow></mrow></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><msup><mrow><mo>(</mo><mrow><mrow><msub><mover accent="true"><mi>y</mi><mo>^</mo></mover><mrow><mi>Net</mi><mo lspace="0em" rspace="0em">​</mo><mtext>-</mtext><mo lspace="0em" rspace="0em">​</mo><mi>FS</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐙</mi><mrow><mo stretchy="false">[</mo><mi>n</mi><mo stretchy="false">]</mo></mrow></msub><mo>,</mo><mi>𝐱</mi><mo>,</mo><mi>𝐕</mi><mo>,</mo><mi>𝐐</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mi>y</mi></mrow><mo>)</mo></mrow><mn>2</mn></msup><mo>]</mo></mrow></mrow><mo fence="true" lspace="0em">CLOSE</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\frac{n}{(n+1)^{2}}\cdot\bigg(n\cdot\displaystyle\mathbb{E}_{{\mathbf{Z}}_{[n]},{\mathbf{x}},y|{\mathbf{\theta}}_{0}}\left[\left(\hat{y}_{\mathrm{Net\text{-}FS}}({\mathbf{Z}}_{[n]},{\mathbf{x}};{\mathbf{V}},{\mathbf{Q}})-y\right)^{2}\right]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(179)</span></td></tr></tbody>
<tbody id="A1.E180"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
