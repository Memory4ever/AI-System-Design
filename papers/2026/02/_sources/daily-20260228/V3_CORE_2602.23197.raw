<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A1.E114.m1" class="ltx_Math" alttext="\displaystyle\displaystyle\mathrm{Cov}\left[\hat{y}_{\mathrm{ZS}}({\mathbf{x}}_{n+1};{\mathbf{V}},{\mathbf{Q}}),y_{n+1}\right]" display="inline" intent=":literal"><semantics><mrow><mi>Cov</mi><mo>⁡</mo><mrow><mo>[</mo><mrow><mrow><msub><mover accent="true"><mi>y</mi><mo>^</mo></mover><mi>ZS</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐱</mi><mrow><mi>n</mi><mo>+</mo><mn>1</mn></mrow></msub><mo>,</mo><mi>𝐕</mi><mo>,</mo><mi>𝐐</mi><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><msub><mi>y</mi><mrow><mi>n</mi><mo>+</mo><mn>1</mn></mrow></msub></mrow><mo>]</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\displaystyle\mathrm{Cov}\left[\hat{y}_{\mathrm{ZS}}({\mathbf{x}}_{n+1};{\mathbf{V}},{\mathbf{Q}}),y_{n+1}\right]</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.E114.m2" class="ltx_Math" alttext="\displaystyle=\displaystyle\mathbb{E}\left[{\mathbf{v}}_{21}^{\top}{\mathbf{x}}_{n+1}{\mathbf{x}}_{n+1}^{\top}{\mathbf{Q}}_{11}{\mathbf{x}}_{n+1}({\mathbf{\theta}}_{0}^{\top}{\mathbf{x}}_{n+1}+e_{n+1})\right]+\displaystyle\mathbb{E}\left[{\mathbf{v}}_{21}^{\top}{\mathbf{x}}_{n+1}\cdot q\cdot({\mathbf{\theta}}_{0}^{\top}{\mathbf{x}}_{n+1}+e_{n+1})\right]" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><mrow><msubsup><mi>𝐯</mi><mn>21</mn><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝐱</mi><mrow><mi>n</mi><mo>+</mo><mn>1</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝐱</mi><mrow><mi>n</mi><mo>+</mo><mn>1</mn></mrow><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝐐</mi><mn>11</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝐱</mi><mrow><mi>n</mi><mo>+</mo><mn>1</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><msubsup><mi>θ</mi><mn>0</mn><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝐱</mi><mrow><mi>n</mi><mo>+</mo><mn>1</mn></mrow></msub></mrow><mo>+</mo><msub><mi>e</mi><mrow><mi>n</mi><mo>+</mo><mn>1</mn></mrow></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>]</mo></mrow></mrow><mo>+</mo><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><mrow><mrow><msubsup><mi>𝐯</mi><mn>21</mn><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝐱</mi><mrow><mi>n</mi><mo>+</mo><mn>1</mn></mrow></msub></mrow><mo lspace="0.222em" rspace="0.222em">⋅</mo><mi>q</mi><mo lspace="0.222em" rspace="0.222em">⋅</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><msubsup><mi>θ</mi><mn>0</mn><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝐱</mi><mrow><mi>n</mi><mo>+</mo><mn>1</mn></mrow></msub></mrow><mo>+</mo><msub><mi>e</mi><mrow><mi>n</mi><mo>+</mo><mn>1</mn></mrow></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>]</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\displaystyle\mathbb{E}\left[{\mathbf{v}}_{21}^{\top}{\mathbf{x}}_{n+1}{\mathbf{x}}_{n+1}^{\top}{\mathbf{Q}}_{11}{\mathbf{x}}_{n+1}({\mathbf{\theta}}_{0}^{\top}{\mathbf{x}}_{n+1}+e_{n+1})\right]+\displaystyle\mathbb{E}\left[{\mathbf{v}}_{21}^{\top}{\mathbf{x}}_{n+1}\cdot q\cdot({\mathbf{\theta}}_{0}^{\top}{\mathbf{x}}_{n+1}+e_{n+1})\right]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(114)</span></td></tr></tbody>
<tbody id="A1.E115"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.E115.m1" class="ltx_Math" alttext="\displaystyle={\mathbf{v}}_{21}^{\top}\displaystyle\mathbb{E}\left[{\mathbf{x}}_{n+1}{\mathbf{x}}_{n+1}^{\top}{\mathbf{Q}}_{11}{\mathbf{x}}_{n+1}{\mathbf{x}}_{n+1}^{\top}\right]{\mathbf{\theta}}_{0}+q\cdot{\mathbf{v}}_{21}^{\top}\displaystyle\mathbb{E}\left[{\mathbf{x}}_{n+1}{\mathbf{x}}_{n+1}^{\top}\right]{\mathbf{\theta}}_{0}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><msubsup><mi>𝐯</mi><mn>21</mn><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>𝔼</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><mrow><msub><mi>𝐱</mi><mrow><mi>n</mi><mo>+</mo><mn>1</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝐱</mi><mrow><mi>n</mi><mo>+</mo><mn>1</mn></mrow><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝐐</mi><mn>11</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝐱</mi><mrow><mi>n</mi><mo>+</mo><mn>1</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝐱</mi><mrow><mi>n</mi><mo>+</mo><mn>1</mn></mrow><mo>⊤</mo></msubsup></mrow><mo>]</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>θ</mi><mn>0</mn></msub></mrow><mo>+</mo><mrow><mrow><mi>q</mi><mo lspace="0.222em" rspace="0.222em">⋅</mo><msubsup><mi>𝐯</mi><mn>21</mn><mo>⊤</mo></msubsup></mrow><mo lspace="0em" rspace="0em">​</mo><mi>𝔼</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><mrow><msub><mi>𝐱</mi><mrow><mi>n</mi><mo>+</mo><mn>1</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝐱</mi><mrow><mi>n</mi><mo>+</mo><mn>1</mn></mrow><mo>⊤</mo></msubsup></mrow><mo>]</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>θ</mi><mn>0</mn></msub></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle={\mathbf{v}}_{21}^{\top}\displaystyle\mathbb{E}\left[{\mathbf{x}}_{n+1}{\mathbf{x}}_{n+1}^{\top}{\mathbf{Q}}_{11}{\mathbf{x}}_{n+1}{\mathbf{x}}_{n+1}^{\top}\right]{\mathbf{\theta}}_{0}+q\cdot{\mathbf{v}}_{21}^{\top}\displaystyle\mathbb{E}\left[{\mathbf{x}}_{n+1}{\mathbf{x}}_{n+1}^{\top}\right]{\mathbf{\theta}}_{0}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(115)</span></td></tr></tbody>
<tbody id="A1.E116"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.E116.m1" class="ltx_Math" alttext="\displaystyle={\mathbf{v}}_{21}^{\top}\left({\mathbf{\Sigma}}({\mathbf{Q}}_{11}+{\mathbf{Q}}_{11}^{\top}){\mathbf{\Sigma}}+\tr({\mathbf{Q}}_{11}^{\top}{\mathbf{\Sigma}}){\mathbf{\Sigma}}+q\cdot{\mathbf{\Sigma}}\right){\mathbf{\theta}}_{0}." display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>=</mo><mrow><msubsup><mi>𝐯</mi><mn>21</mn><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mrow><mrow><mi>𝚺</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>𝐐</mi><mn>11</mn></msub><mo>+</mo><msubsup><mi>𝐐</mi><mn>11</mn><mo>⊤</mo></msubsup></mrow><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><mi>𝚺</mi></mrow><mo>+</mo><mrow><mrow><mi>tr</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msubsup><mi>𝐐</mi><mn>11</mn><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>𝚺</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><mi>𝚺</mi></mrow><mo>+</mo><mrow><mi>q</mi><mo lspace="0.222em" rspace="0.222em">⋅</mo><mi>𝚺</mi></mrow></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>θ</mi><mn>0</mn></msub></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle={\mathbf{v}}_{21}^{\top}\left({\mathbf{\Sigma}}({\mathbf{Q}}_{11}+{\mathbf{Q}}_{11}^{\top}){\mathbf{\Sigma}}+\tr({\mathbf{Q}}_{11}^{\top}{\mathbf{\Sigma}}){\mathbf{\Sigma}}+q\cdot{\mathbf{\Sigma}}\right){\mathbf{\theta}}_{0}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(116)</span></td></tr></tbody>
</table>
<p id="A1.SS2.p8.3" class="ltx_p"><span id="A1.SS2.p8.3.1" class="ltx_text">∎</span></p>
