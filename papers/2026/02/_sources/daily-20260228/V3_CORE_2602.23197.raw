<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.E163.m1" class="ltx_math_unparsed" alttext="\displaystyle\quad+\frac{n+1}{n}\cdot({\mathbf{v}}_{21}^{\top}+{\mathbf{\theta}}_{0}^{\top}){\mathbf{\Sigma}}{\mathbf{Q}}_{11}{\mathbf{\Sigma}}{\mathbf{Q}}_{11}{\mathbf{\Sigma}}({\mathbf{v}}_{21}+{\mathbf{\theta}}_{0})-2({\mathbf{v}}_{21}^{\top}+{\mathbf{\theta}}_{0}^{\top}){\mathbf{\Sigma}}{\mathbf{Q}}_{11}{\mathbf{\Sigma}}{\mathbf{\theta}}_{0}+{\mathbf{\theta}}_{0}^{\top}{\mathbf{\Sigma}}{\mathbf{\theta}}_{0}+\sigma^{2}," display="inline" intent=":literal"><semantics><mrow><mo>+</mo><mstyle displaystyle="true"><mfrac><mrow><mi>n</mi><mo>+</mo><mn>1</mn></mrow><mi>n</mi></mfrac></mstyle><mo lspace="0.222em" rspace="0.222em">⋅</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>𝐯</mi><mn>21</mn><mo>⊤</mo></msubsup><mo>+</mo><msubsup><mi>θ</mi><mn>0</mn><mo>⊤</mo></msubsup><mo stretchy="false">)</mo></mrow><mi>𝚺</mi><msub><mi>𝐐</mi><mn>11</mn></msub><mi>𝚺</mi><msub><mi>𝐐</mi><mn>11</mn></msub><mi>𝚺</mi><mrow><mo stretchy="false">(</mo><msub><mi>𝐯</mi><mn>21</mn></msub><mo>+</mo><msub><mi>θ</mi><mn>0</mn></msub><mo stretchy="false">)</mo></mrow><mo>−</mo><mn>2</mn><mrow><mo stretchy="false">(</mo><msubsup><mi>𝐯</mi><mn>21</mn><mo>⊤</mo></msubsup><mo>+</mo><msubsup><mi>θ</mi><mn>0</mn><mo>⊤</mo></msubsup><mo stretchy="false">)</mo></mrow><mi>𝚺</mi><msub><mi>𝐐</mi><mn>11</mn></msub><mi>𝚺</mi><msub><mi>θ</mi><mn>0</mn></msub><mo>+</mo><msubsup><mi>θ</mi><mn>0</mn><mo>⊤</mo></msubsup><mi>𝚺</mi><msub><mi>θ</mi><mn>0</mn></msub><mo>+</mo><msup><mi>σ</mi><mn>2</mn></msup><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\quad+\frac{n+1}{n}\cdot({\mathbf{v}}_{21}^{\top}+{\mathbf{\theta}}_{0}^{\top}){\mathbf{\Sigma}}{\mathbf{Q}}_{11}{\mathbf{\Sigma}}{\mathbf{Q}}_{11}{\mathbf{\Sigma}}({\mathbf{v}}_{21}+{\mathbf{\theta}}_{0})-2({\mathbf{v}}_{21}^{\top}+{\mathbf{\theta}}_{0}^{\top}){\mathbf{\Sigma}}{\mathbf{Q}}_{11}{\mathbf{\Sigma}}{\mathbf{\theta}}_{0}+{\mat