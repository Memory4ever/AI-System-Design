<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.E125.m1" class="ltx_Math" alttext="\displaystyle=\!\left({\mathbf{v}}_{21}^{\top}{\mathbf{\Sigma}}{\mathbf{Q}}_{11}\!+\!v_{22}{\mathbf{\theta}}_{0}^{\top}{\mathbf{\Sigma}}{\mathbf{Q}}_{11}\!+\!{\mathbf{v}}_{21}^{\top}{\mathbf{\Sigma}}{\mathbf{\theta}}_{0}{\mathbf{q}}_{21}^{\top}\!+\!v_{22}({\mathbf{\theta}}_{0}^{\top}{\mathbf{\Sigma}}{\mathbf{\theta}}_{0}\!+\!\sigma^{2}){\mathbf{q}}_{21}^{\top}\right){\mathbf{\Sigma}}\left(({\mathbf{Q}}_{11}\!+\!{\mathbf{Q}}_{11}^{\top}){\mathbf{\Sigma}}{\mathbf{v}}_{21}\!+\!\tr({\mathbf{Q}}_{11}{\mathbf{\Sigma}}){\mathbf{v}}_{21}\!+\!q{\mathbf{v}}_{21}\!-\!{\mathbf{\theta}}_{0}\right)" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo rspace="0.108em">=</mo><mrow><mrow><mo>(</mo><mrow><mrow><msubsup><mi>𝐯</mi><mn>21</mn><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>𝚺</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝐐</mi><mn>11</mn></msub></mrow><mo rspace="0.052em">+</mo><mrow><msub><mi>v</mi><mn>22</mn></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>θ</mi><mn>0</mn><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>𝚺</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝐐</mi><mn>11</mn></msub></mrow><mo rspace="0.052em">+</mo><mrow><msubsup><mi>𝐯</mi><mn>21</mn><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>𝚺</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>θ</mi><mn>0</mn></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝐪</mi><mn>21</mn><mo>⊤</mo></msubsup></mrow><mo rspace="0.052em">+</mo><mrow><msub><mi>v</mi><mn>22</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><msubsup><mi>θ</mi><mn>0</mn><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>𝚺</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>θ</mi><mn>0</mn></msub></mrow><mo rspace="0.052em">+</mo><msup><mi>σ</mi><mn>2</mn></msup></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝐪</mi><mn>21</mn><mo>⊤</mo></msubsup></mrow></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>𝚺</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mrow><mrow><mrow><mo stretchy="false">(</mo><mrow><msub><mi>𝐐</mi><mn>11</mn></msub><mo rspace="0.052em">+</mo><msubsup><mi>𝐐</mi><mn>11</mn><mo>⊤</mo></msubsup></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>𝚺</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝐯</mi><mn>21</mn></msub></mrow><mo rspace="0.052em">+</mo><mrow><mrow><mi>tr</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>𝐐</mi><mn>11</mn></msub><mo lspace="0em" rspace="0em">​</mo><mi>𝚺</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝐯</mi><mn>21</mn></msub></mrow><mo rspace="0.052em">+</mo><mrow><mi>q</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝐯</mi><mn>21</mn></msub></mrow></mrow><mo rspace="0.052em">−</mo><msub><mi>θ</mi><mn>0</mn></msub></mrow><mo>)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\!\left({\mathbf{v}}_{21}^{\top}{\mathbf{\Sigma}}{\mathbf{Q}}_{11}\!+\!v_{22}{\mathbf{\theta}}_{0}^{\top}{\mathbf{\Sigma}}{\mathbf{Q}}_{11}\!+\!{\mathbf{v}}_{21}^{\top}{\mathbf{\Sigma}}{\mathbf{\theta}}_{0}{\mathbf{q}}_{21}^{\top}\!+\!v_{22}({\mathbf{\theta}}_{0}^{\top}{\mathbf{\Sigma}}{\mathbf{\theta}}_{0}\!+\!\sigma^{2}){\mathbf{q}}_{21}^{\top}\right){\mathbf{\Sigma}}\left(({\mathbf{Q}}_{11}\!+\!{\mathbf{Q}}_{11}^{\top}){\mathbf{\Sigma}}{\mathbf{v}}_{21}\!+\!\tr({\mathbf{Q}}_{11}{\mathbf{\Sigma}}){\mathbf{v}}_{21}\!+\!q{\mathbf{v}}_{21}\!-\!{\mathbf{\theta}}_{0}\right)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(125)</span></td></tr></tbody>
<tbody id="A1.E126"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.E126.m1" class="ltx_Math" alttext="\displaystyle\quad-{\mathbf{v}}_{21}^{\top}\left({\mathbf{\Sigma}}({\mathbf{Q}}_{11}+{\mathbf{Q}}_{11}^{\top}){\mathbf{\Sigma}}+\tr({\mathbf{Q}}_{11}{\mathbf{\Sigma}})\cdot{\mathbf{\Sigma}}+q\cdot{\mathbf{\Sigma}}\right){\mathbf{\theta}}_{0}+{\mathbf{\theta}}_{0}^{\top}{\mathbf{\Sigma}}{\mathbf{\theta}}_{0}+\sigma^{2}." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mo>−</mo><mrow><msubsup><mi>𝐯</mi><mn>21</mn><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mrow><mrow><mi>𝚺</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>𝐐</mi><mn>11</mn></msub><mo>+</mo><msubsup><mi>𝐐</mi><mn>11</mn><mo>⊤</mo></msubsup></mrow><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><mi>𝚺</mi></mrow><mo>+</mo><mrow><mrow><mi>tr</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>𝐐</mi><mn>11</mn></msub><mo lspace="0em" rspace="0em">​</mo><mi>𝚺</mi></mrow><mo rspace="0.055em" stretchy="false">)</mo></mrow></mrow><mo rspace="0.222em">⋅</mo><mi>𝚺</mi></mrow><mo>+</mo><mrow><mi>q</mi><mo lspace="0.222em" rspace="0.222em">⋅</mo><mi>𝚺</mi></mrow></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>θ</mi><mn>0</mn></msub></mrow></mrow><mo>+</mo><mrow><msubsup><mi>θ</mi><mn>0</mn><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>𝚺</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>θ</mi><mn>0</mn></msub></mrow><mo>+</mo><msup><mi>σ</mi><mn>2</mn></msup></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\quad-{\mathbf{v}}_{21}^{\top}\left({\mathbf{\Sigma}}({\mathbf{Q}}_{11}+{\mathbf{Q}}_{11}^{\top}){\mathbf{\Sigma}}+\tr({\mathbf{Q}}_{11}{\mathbf{\Sigma}})\cdot{\mathbf{\Sigma}}+q\cdot{\mathbf{\Sigma}}\right){\mathbf{\theta}}_{0}+{\mathbf{\theta}}_{0}^{\top}{\mathbf{\Sigma}}{\mathbf{\theta}}_{0}+\sigma^{2}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(126)</span></td></tr></tbody>
</table>
<p id="A1.Thmtheorem5.p1.2" class="ltx_p"><span id="A1.Thmtheorem5.p1.2.1" class="ltx_text ltx_font_italic">Moreover, if <math id="A1.Thmtheorem5.p1.m6" class="ltx_Math" alttext="v_{22}=1" display="inline" intent=":literal"><semantics><mrow><msub><mi>v</mi><mn>22</mn></msub><mo>=</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">v_{22}=1</annotation></semantics></math>, <math id="A1.Thmtheorem5.p1.m7" class="ltx_Math" alttext="{\mathbf{q}}_{21}={\mathbf{0}}_{d}" display="inline" intent=":literal"><semantics><mrow><msub><mi>𝐪</mi><mn>21</mn></msub><mo>=</mo><msub><mn>𝟎</mn><mi>d</mi></msub></mrow><annotation encoding="application/x-tex">{\mathbf{q}}_{21}={\mathbf{0}}_{d}</annotation></semantics></math>, and <math id="A1.Thmtheorem5.p1.m8" class="ltx_Math" alttext="{\mathbf{Q}}_{11}={\mathbf{Q}}_{11}^{\top}" display="inline" intent=":literal"><semantics><mrow><msub><mi>𝐐</mi><mn>11</mn></msub><mo>=</mo><msubsup><mi>𝐐</mi><mn>11</mn><mo>⊤</mo></msubsup></mrow><annotation encoding="application/x-tex">{\mathbf{Q}}_{11}={\mathbf{Q}}_{11}^{\top}</annotation></semantics></math>, we have</span></p>
<table id="A1.EGx40" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A1.E127"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A1.E127.m1" class="ltx_Math" alttext="\displaystyle\displaystyle\mathbb{E}_{{\mathbf{Z}}_{[n]},{\mathbf{x}},y|{\mathbf{\theta}}_{0}}\left[\big(\hat{y}_{\mathrm{FS}}({\mathbf{Z}}_{[n]},{\mathbf{x}};{\mathbf{V}},{\mathbf{Q}})-y\big)^{2}\right]=\frac{1}{(n+1)^{2}}\cdot\displaystyle\mathbb{E}_{{\mathbf{x}},y|{\mathbf{\theta}}_{0}}\left[\big(\hat{y}_{\mathrm{ZS}}({\mathbf{x}};{\mathbf{V}},{\mathbf{Q}})-y\big)^{2}\right]+\frac{n}{(n+1)^{2}}\cdot h({\mathbf{V}},{\mathbf{Q}};{\mathbf{\theta}}_{0})," display="inline" intent=":literal"><semantics><mrow><mrow><mrow><msub><mi>𝔼</mi><mrow><msub><mi>𝐙</mi><mrow><mo stretchy="false">[</mo><mi>n</mi><mo stretchy="false">]</mo></mrow></msub><mo>,</mo><mi>𝐱</mi><mo>,</mo><mrow><mi>y</mi><mo fence="false">|</mo><msub><mi>θ</mi><mn>0</mn></msub></mrow></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><msup><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mrow><mrow><msub><mover accent="true"><mi>y</mi><mo>^</mo></mover><mi>FS</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐙</mi><mrow><mo stretchy="false">[</mo><mi>n</mi><mo stretchy="false">]</mo></mrow></msub><mo>,</mo><mi>𝐱</mi><mo>,</mo><mi>𝐕</mi><mo>,</mo><mi>𝐐</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mi>y</mi></mrow><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow><mn>2</mn></msup><mo>]</mo></mrow></mrow><mo>=</mo><mrow><mrow><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><msup><mrow><mo stretchy="false">(</mo><mrow><mi>n</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mfrac></mstyle><mo lspace="0.222em" rspace="0.222em">⋅</mo><msub><mi>𝔼</mi><mrow><mi>𝐱</mi><mo>,</mo><mrow><mi>y</mi><mo fence="false">|</mo><msub><mi>θ</mi><mn>0</mn></msub></mrow></mrow></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><msup><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mrow><mrow><msub><mover accent="true"><mi>y</mi><mo>^</mo></mover><mi>ZS</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐱</mi><mo>,</mo><mi>𝐕</mi><mo>,</mo><mi>𝐐</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mi>y</mi></mrow><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow><mn>2</mn></msup><mo>]</mo></mrow></mrow><mo>+</mo><mrow><mstyle displaystyle="true"><mfrac><mi>n</mi><msup><mrow><mo stretchy="false">(</mo><mrow><mi>n</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mfrac></mstyle><mo lspace="0.222em" rspace="0.222em">⋅</mo><mrow><mi>h</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝐕</mi><mo>,</mo><mi>𝐐</mi><mo>,</mo><msub><mi>θ</mi><mn>0</mn></msub><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\displaystyle\mathbb{E}_{{\mathbf{Z}}_{[n]},{\mathbf{x}},y|{\mathbf{\theta}}_{0}}\left[\big(\hat{y}_{\mathrm{FS}}({\mathbf{Z}}_{[n]},{\mathbf{x}};{\mathbf{V}},{\mathbf{Q}})-y\big)^{2}\right]=\frac{1}{(n+1)^{2}}\cdot\displaystyle\mathbb{E}_{{\mathbf{x}},y|{\mathbf{\theta}}_{0}}\left[\big(\hat{y}_{\mathrm{ZS}}({\mathbf{x}};{\mathbf{V}},{\mathbf{Q}})-y\big)^{2}\right]+\frac{n}{(n+1)^{2}}\cdot h({\mathbf{V}},{\mathbf{Q}};{\mathbf{\theta}}_{0}),</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(127)</span></td></tr></tbody>
</table>
<p id="A1.Thmtheorem5.p1.3" class="ltx_p"><span id="A1.Thmtheorem5.p1.3.1" class="ltx_text ltx_font_italic">where</span></p>
<table id="A1.EGx41" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A1.E128"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.E128.m1" class="ltx_Math" alttext="\displaystyle\displaystyle\mathbb{E}_{{\mathbf{x}},y|{\mathbf{\theta}}_{0}}\left[\big(\hat{y}_{\mathrm{ZS}}({\mathbf{x}};{\mathbf{V}},{\mathbf{Q}})-y\big)^{2}\right]" display="inline" intent=":literal"><semantics><mrow><msub><mi>𝔼</mi><mrow><mi>𝐱</mi><mo>,</mo><mrow><mi>y</mi><mo fence="false">|</mo><msub><mi>θ</mi><mn>0</mn></msub></mrow></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><msup><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mrow><mrow><msub><mover accent="true"><mi>y</mi><mo>^</mo></mover><mi>ZS</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐱</mi><mo>,</mo><mi>𝐕</mi><mo>,</mo><mi>𝐐</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mi>y</mi></mrow><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow><mn>2</mn></msup><mo>]</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\displaystyle\mathbb{E}_{{\mathbf{x}},y|{\mathbf{\theta}}_{0}}\left[\big(\hat{y}_{\mathrm{ZS}}({\mathbf{x}};{\mathbf{V}},{\mathbf{Q}})-y\big)^{2}\right]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(128)</span></td></tr></tbody>
<tbody id="A1.E129"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.E129.m1" class="ltx_Math" alttext="\displaystyle\quad={\mathbf{v}}_{21}^{\top}\Big(\tr({\mathbf{Q}}_{11}{\mathbf{\Sigma}})^{2}\cdot{\mathbf{\Sigma}}+2\tr({\mathbf{Q}}_{11}{\mathbf{\Sigma}}{\mathbf{Q}}_{11}{\mathbf{\Sigma}})\cdot{\mathbf{\Sigma}}+4\tr({\mathbf{Q}}_{11}{\mathbf{\Sigma}})\cdot{\mathbf{\Sigma}}{\mathbf{Q}}_{11}{\mathbf{\Sigma}}+8{\mathbf{\Sigma}}{\mathbf{Q}}_{11}{\mathbf{\Sigma}}{\mathbf{Q}}_{11}{\mathbf{\Sigma}}\Big){\mathbf{v}}_{21}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo lspace="1.278em">=</mo><mrow><msubsup><mi>𝐯</mi><mn>21</mn><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="1.600em" minsize="1.600em">(</mo><mrow><mrow><mrow><mi>tr</mi><mo>⁡</mo><msup><mrow><mo stretchy="false">(</mo><mrow><msub><mi>𝐐</mi><mn>11</mn></msub><mo lspace="0em" rspace="0em">​</mo><mi>𝚺</mi></mrow><mo rspace="0.055em" stretchy="false">)</mo></mrow><mn>2</mn></msup></mrow><mo rspace="0.222em">⋅</mo><mi>𝚺</mi></mrow><mo>+</mo><mrow><mrow><mn>2</mn><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>tr</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>𝐐</mi><mn>11</mn></msub><mo lspace="0em" rspace="0em">​</mo><mi>𝚺</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝐐</mi><mn>11</mn></msub><mo lspace="0em" rspace="0em">​</mo><mi>𝚺</mi></mrow><mo rspace="0.055em" stretchy="false">)</mo></mrow></mrow></mrow><mo rspace="0.222em">⋅</mo><mi>𝚺</mi></mrow><mo>+</mo><mrow><mrow><mrow><mn>4</mn><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>tr</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>𝐐</mi><mn>11</mn></msub><mo lspace="0em" rspace="0em">​</mo><mi>𝚺</mi></mrow><mo rspace="0.055em" stretchy="false">)</mo></mrow></mrow></mrow><mo rspace="0.222em">⋅</mo><mi>𝚺</mi></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝐐</mi><mn>11</mn></msub><mo lspace="0em" rspace="0em">​</mo><mi>𝚺</mi></mrow><mo>+</mo><mrow><mn>8</mn><mo lspace="0em" rspace="0em">​</mo><mi>𝚺</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝐐</mi><mn>11</mn></msub><mo lspace="0em" rspace="0em">​</mo><mi>𝚺</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝐐</mi><mn>11</mn></msub><mo lspace="0em" rspace="0em">​</mo><mi>𝚺</mi></mrow></mrow><mo maxsize="1.600em" minsize="1.600em">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝐯</mi><mn>21</mn></msub></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\quad={\mathbf{v}}_{21}^{\top}\Big(\tr({\mathbf{Q}}_{11}{\mathbf{\Sigma}})^{2}\cdot{\mathbf{\Sigma}}+2\tr({\mathbf{Q}}_{11}{\mathbf{\Sigma}}{\mathbf{Q}}_{11}{\mathbf{\Sigma}})\cdot{\mathbf{\Sigma}}+4\tr({\mathbf{Q}}_{11}{\mathbf{\Sigma}})\cdot{\mathbf{\Sigma}}{\mathbf{Q}}_{11}{\mathbf{\Sigma}}+8{\mathbf{\Sigma}}{\mathbf{Q}}_{11}{\mathbf{\Sigma}}{\mathbf{Q}}_{11}{\mathbf{\Sigma}}\Big){\mathbf{v}}_{21}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(129)</span></td></tr></tbody>
<tbody id="A1.E130"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.E130.m1" class="ltx_Math" alttext="\displaystyle\quad\quad-2{\mathbf{v}}_{21}^{\top}\Big(2{\mathbf{\Sigma}}{\mathbf{Q}}_{11}{\mathbf{\Sigma}}+\tr({\mathbf{Q}}_{11}{\mathbf{\Sigma}})\cdot{\mathbf{\Sigma}}\Big){\mathbf{\theta}}_{0}+{\mathbf{\theta}}_{0}^{\top}{\mathbf{\Sigma}}{\mathbf{\theta}}_{0}+\sigma^{2}" display="inline" intent=":literal"><semantics><mrow><mrow><mo>−</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝐯</mi><mn>21</mn><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="1.600em" minsize="1.600em">(</mo><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>𝚺</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝐐</mi><mn>11</mn></msub><mo lspace="0em" rspace="0em">​</mo><mi>𝚺</mi></mrow><mo>+</mo><mrow><mrow><mi>tr</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>𝐐</mi><mn>11</mn></msub><mo lspace="0em" rspace="0em">​</mo><mi>𝚺</mi></mrow><mo rspace="0.055em" stretchy="false">)</mo></mrow></mrow><mo rspace="0.222em">⋅</mo><mi>𝚺</mi></mrow></mrow><mo maxsize="1.600em" minsize="1.600em">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>θ</mi><mn>0</mn></msub></mrow></mrow><mo>+</mo><mrow><msubsup><mi>θ</mi><mn>0</mn><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>𝚺</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>θ</mi><mn>0</mn></msub></mrow><mo>+</mo><msup><mi>σ</mi><mn>2</mn></msup></mrow><annotation encoding="application/x-tex">\displaystyle\quad\quad-2{\mathbf{v}}_{21}^{\top}\Big(2{\mathbf{\Sigma}}{\mathbf{Q}}_{11}{\mathbf{\Sigma}}+\tr({\mathbf{Q}}_{11}{\mathbf{\Sigma}})\cdot{\mathbf{\Sigma}}\Big){\mathbf{\theta}}_{0}+{\mathbf{\theta}}_{0}^{\top}{\mathbf{\Sigma}}{\mathbf{\theta}}_{0}+\sigma^{2}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(130)</span></td></tr></tbody>
<tbody id="A1.E131"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.E131.m1" class="ltx_math_unparsed" alttext="\displaystyle\quad\quad+q^{2}\cdot{\mathbf{v}}_{21}^{\top}{\mathbf{\Sigma}}{\mathbf{v}}_{21}+2q\cdot\tr({\mathbf{Q}}_{11}{\mathbf{\Sigma}})\cdot{\mathbf{v}}_{21}^{\top}{\mathbf{\Sigma}}{\mathbf{v}}_{21}+4q\cdot{\mathbf{v}}_{21}^{\top}{\mathbf{\Sigma}}{\mathbf{Q}}_{11}{\mathbf{\Sigma}}{\mathbf{v}}_{21}-2q\cdot{\mathbf{v}}_{21}^{\top}{\mathbf{\Sigma}}{\mathbf{\theta}}_{0}," display="inline" intent=":literal"><semantics><mrow><mo>+</mo><msup><mi>q</mi><mn>2</mn></msup><mo lspace="0.222em" rspace="0.222em">⋅</mo><msubsup><mi>𝐯</mi><mn>21</mn><mo>⊤</mo></msubsup><mi>𝚺</mi><msub><mi>𝐯</mi><mn>21</mn></msub><mo>+</mo><mn>2</mn><mi>q</mi><mo lspace="0.222em" rspace="0.222em">⋅</mo><mi>tr</mi><mrow><mo stretchy="false">(</mo><msub><mi>𝐐</mi><mn>11</mn></msub><mi>𝚺</mi><mo rspace="0.055em" stretchy="false">)</mo></mrow><mo rspace="0.222em">⋅</mo><msubsup><mi>𝐯</mi><mn>21</mn><mo>⊤</mo></msubsup><mi>𝚺</mi><msub><mi>𝐯</mi><mn>21</mn></msub><mo>+</mo><mn>4</mn><mi>q</mi><mo lspace="0.222em" rspace="0.222em">⋅</mo><msubsup><mi>𝐯</mi><mn>21</mn><mo>⊤</mo></msubsup><mi>𝚺</mi><msub><mi>𝐐</mi><mn>11</mn></msub><mi>𝚺</mi><msub><mi>𝐯</mi><mn>21</mn></msub><mo>−</mo><mn>2</mn><mi>q</mi><mo lspace="0.222em" rspace="0.222em">⋅</mo><msubsup><mi>𝐯</mi><mn>21</mn><mo>⊤</mo></msubsup><mi>𝚺</mi><msub><mi>θ</mi><mn>0</mn></msub><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\quad\quad+q^{2}\cdot{\mathbf{v}}_{21}^{\top}{\mathbf{\Sigma}}{\mathbf{v}}_{21}+2q\cdot\tr({\mathbf{Q}}_{11}{\mathbf{\Sigma}})\cdot{\mathbf{v}}_{21}^{\top}{\mathbf{\Sigma}}{\mathbf{v}}_{21}+4q\cdot{\mathbf{v}}_{21}^{\top}{\mathbf{\Sigma}}{\mathbf{Q}}_{11}{\mathbf{\Sigma}}{\mathbf{v}}_{21}-2q\cdot{\mathbf{v}}_{21}^{\top}{\mathbf{\Sigma}}{\mathbf{\theta}}_{0},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(131)</span></td></tr></tbody>
<tbody id="A1.E132"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.E132.m1" class="ltx_Math" alttext="\displaystyle h({\mathbf{V}},{\mathbf{Q}};{\mathbf{\theta}}_{0})={\mathbf{v}}_{21}^{\top}\Big(\tr({\mathbf{Q}}_{11}{\mathbf{\Sigma}}{\mathbf{Q}}_{11}{\mathbf{\Sigma}})\cdot{\mathbf{\Sigma}}+(n+5)\cdot{\mathbf{\Sigma}}{\mathbf{Q}}_{11}{\mathbf{\Sigma}}{\mathbf{Q}}_{11}{\mathbf{\Sigma}}+2\tr({\mathbf{Q}}_{11}{\mathbf{\Sigma}})\cdot{\mathbf{\Sigma}}{\mathbf{Q}}_{11}{\mathbf{\Sigma}}\Big){\mathbf{v}}_{21}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>h</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝐕</mi><mo>,</mo><mi>𝐐</mi><mo>,</mo><msub><mi>θ</mi><mn>0</mn></msub><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><msubsup><mi>𝐯</mi><mn>21</mn><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="1.600em" minsize="1.600em">(</mo><mrow><mrow><mrow><mi>tr</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>𝐐</mi><mn>11</mn></msub><mo lspace="0em" rspace="0em">​</mo><mi>𝚺</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝐐</mi><mn>11</mn></msub><mo lspace="0em" rspace="0em">​</mo><mi>𝚺</mi></mrow><mo rspace="0.055em" stretchy="false">)</mo></mrow></mrow><mo rspace="0.222em">⋅</mo><mi>𝚺</mi></mrow><mo>+</mo><mrow><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>n</mi><mo>+</mo><mn>5</mn></mrow><mo rspace="0.055em" stretchy="false">)</mo></mrow><mo rspace="0.222em">⋅</mo><mi>𝚺</mi></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝐐</mi><mn>11</mn></msub><mo lspace="0em" rspace="0em">​</mo><mi>𝚺</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝐐</mi><mn>11</mn></msub><mo lspace="0em" rspace="0em">​</mo><mi>𝚺</mi></mrow><mo>+</mo><mrow><mrow><mrow><mn>2</mn><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>tr</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>𝐐</mi><mn>11</mn></msub><mo lspace="0em" rspace="0em">​</mo><mi>𝚺</mi></mrow><mo rspace="0.055em" stretchy="false">)</mo></mrow></mrow></mrow><mo rspace="0.222em">⋅</mo><mi>𝚺</mi></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝐐</mi><mn>11</mn></msub><mo lspace="0em" rspace="0em">​</mo><mi>𝚺</mi></mrow></mrow><mo maxsize="1.600em" minsize="1.600em">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝐯</mi><mn>21</mn></msub></mrow></mrow><annotation encoding="application/x-tex">\displaystyle h({\mathbf{V}},{\mathbf{Q}};{\mathbf{\theta}}_{0})={\mathbf{v}}_{21}^{\top}\Big(\tr({\mathbf{Q}}_{11}{\mathbf{\Sigma}}{\mathbf{Q}}_{11}{\mathbf{\Sigma}})\cdot{\mathbf{\Sigma}}+(n+5)\cdot{\mathbf{\Sigma}}{\mathbf{Q}}_{11}{\mathbf{\Sigma}}{\mathbf{Q}}_{11}{\mathbf{\Sigma}}+2\tr({\mathbf{Q}}_{11}{\mathbf{\Sigma}})\cdot{\mathbf{\Sigma}}{\mathbf{Q}}_{11}{\mathbf{\Sigma}}\Big){\mathbf{v}}_{21}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(132)</span></td></tr></tbody>
<tbody id="A1.E133"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.E133.m1" class="ltx_Math" alttext="\displaystyle\qquad\qquad\quad+2{\mathbf{v}}_{21}^{\top}\Big(\tr({\mathbf{Q}}_{11}{\mathbf{\Sigma}}{\mathbf{Q}}_{11}{\mathbf{\Sigma}})\cdot{\mathbf{\Sigma}}+(n+3)\cdot{\mathbf{\Sigma}}{\mathbf{Q}}_{11}{\mathbf{\Sigma}}{\mathbf{Q}}_{11}{\mathbf{\Sigma}}+\tr({\mathbf{Q}}_{11}{\mathbf{\Sigma}})\cdot{\mathbf{\Sigma}}{\mathbf{Q}}_{11}{\mathbf{\Sigma}}\Big){\mathbf{\theta}}_{0}" display="inline" intent=":literal"><semantics><mrow><mo>+</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝐯</mi><mn>21</mn><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="1.600em" minsize="1.600em">(</mo><mrow><mrow><mrow><mi>tr</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>𝐐</mi><mn>11</mn></msub><mo lspace="0em" rspace="0em">​</mo><mi>𝚺</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝐐</mi><mn>11</mn></msub><mo lspace="0em" rspace="0em">​</mo><mi>𝚺</mi></mrow><mo rspace="0.055em" stretchy="false">)</mo></mrow></mrow><mo rspace="0.222em">⋅</mo><mi>𝚺</mi></mrow><mo>+</mo><mrow><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>n</mi><mo>+</mo><mn>3</mn></mrow><mo rspace="0.055em" stretchy="false">)</mo></mrow><mo rspace="0.222em">⋅</mo><mi>𝚺</mi></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝐐</mi><mn>11</mn></msub><mo lspace="0em" rspace="0em">​</mo><mi>𝚺</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝐐</mi><mn>11</mn></msub><mo lspace="0em" rspace="0em">​</mo><mi>𝚺</mi></mrow><mo>+</mo><mrow><mrow><mrow><mi>tr</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>𝐐</mi><mn>11</mn></msub><mo lspace="0em" rspace="0em">​</mo><mi>𝚺</mi></mrow><mo rspace="0.055em" stretchy="false">)</mo></mrow></mrow><mo rspace="0.222em">⋅</mo><mi>𝚺</mi></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝐐</mi><mn>11</mn></msub><mo lspace="0em" rspace="0em">​</mo><mi>𝚺</mi></mrow></mrow><mo maxsize="1.600em" minsize="1.600em">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>θ</mi><mn>0</mn></msub></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\qquad\qquad\quad+2{\mathbf{v}}_{21}^{\top}\Big(\tr({\mathbf{Q}}_{11}{\mathbf{\Sigma}}{\mathbf{Q}}_{11}{\mathbf{\Sigma}})\cdot{\mathbf{\Sigma}}+(n+3)\cdot{\mathbf{\Sigma}}{\mathbf{Q}}_{11}{\mathbf{\Sigma}}{\mathbf{Q}}_{11}{\mathbf{\Sigma}}+\tr({\mathbf{Q}}_{11}{\mathbf{\Sigma}})\cdot{\mathbf{\Sigma}}{\mathbf{Q}}_{11}{\mathbf{\Sigma}}\Big){\mathbf{\theta}}_{0}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(133)</span></td></tr></tbody>
<tbody id="A1.E134"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.E134.m1" class="ltx_Math" alttext="\displaystyle\qquad\qquad\quad-2{\mathbf{v}}_{21}^{\top}\Big((n+3)\cdot{\mathbf{\Sigma}}{\mathbf{Q}}_{11}{\mathbf{\Sigma}}+\tr({\mathbf{Q}}_{11}{\mathbf{\Sigma}})\cdot{\mathbf{\Sigma}}\Big){\mathbf{\theta}}_{0}+(n+1)\cdot{\mathbf{\theta}}_{0}^{\top}{\mathbf{\Sigma}}{\mathbf{Q}}_{11}{\mathbf{\Sigma}}{\mathbf{Q}}_{11}{\mathbf{\Sigma}}{\mathbf{\theta}}_{0}" display="inline" intent=":literal"><semantics><mrow><mrow><mo>−</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝐯</mi><mn>21</mn><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="1.600em" minsize="1.600em">(</mo><mrow><mrow><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>n</mi><mo>+</mo><mn>3</mn></mrow><mo rspace="0.055em" stretchy="false">)</mo></mrow><mo rspace="0.222em">⋅</mo><mi>𝚺</mi></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝐐</mi><mn>11</mn></msub><mo lspace="0em" rspace="0em">​</mo><mi>𝚺</mi></mrow><mo>+</mo><mrow><mrow><mi>tr</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>𝐐</mi><mn>11</mn></msub><mo lspace="0em" rspace="0em">​</mo><mi>𝚺</mi></mrow><mo rspace="0.055em" stretchy="false">)</mo></mrow></mrow><mo rspace="0.222em">⋅</mo><mi>𝚺</mi></mrow></mrow><mo maxsize="1.600em" minsize="1.600em">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>θ</mi><mn>0</mn></msub></mrow></mrow><mo>+</mo><mrow><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>n</mi><mo>+</mo><mn>1</mn></mrow><mo rspace="0.055em" stretchy="false">)</mo></mrow><mo rspace="0.222em">⋅</mo><msubsup><mi>θ</mi><mn>0</mn><mo>⊤</mo></msubsup></mrow><mo lspace="0em" rspace="0em">​</mo><mi>𝚺</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝐐</mi><mn>11</mn></msub><mo lspace="0em" rspace="0em">​</mo><mi>𝚺</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝐐</mi><mn>11</mn></msub><mo lspace="0em" rspace="0em">​</mo><mi>𝚺</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>θ</mi><mn>0</mn></msub></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\qquad\qquad\quad-2{\mathbf{v}}_{21}^{\top}\Big((n+3)\cdot{\mathbf{\Sigma}}{\mathbf{Q}}_{11}{\mathbf{\Sigma}}+\tr({\mathbf{Q}}_{11}{\mathbf{\Sigma}})\cdot{\mathbf{\Sigma}}\Big){\mathbf{\theta}}_{0}+(n+1)\cdot{\mathbf{\theta}}_{0}^{\top}{\mathbf{\Sigma}}{\mathbf{Q}}_{11}{\mathbf{\Sigma}}{\mathbf{Q}}_{11}{\mathbf{\Sigma}}{\mathbf{\theta}}_{0}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(134)</span></td></tr></tbody>
<tbody id="A1.E135"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.E135.m1" class="ltx_math_unparsed" alttext="\displaystyle\qquad\qquad\quad-2(n+1)\cdot{\mathbf{\theta}}_{0}^{\top}{\mathbf{\Sigma}}{\mathbf{Q}}_{11}{\mathbf{\Sigma}}{\mathbf{\theta}}_{0}+(\tr({\mathbf{Q}}_{11}{\mathbf{\Sigma}}{\mathbf{Q}}_{11}{\mathbf{\Sigma}})+n+2)({\mathbf{\theta}}_{0}^{\top}{\mathbf{\Sigma}}{\mathbf{\theta}}_{0}+\sigma^{2})" display="inline" intent=":literal"><semantics><mrow><mo>−</mo><mn>2</mn><mrow><mo stretchy="false">(</mo><mi>n</mi><mo>+</mo><mn>1</mn><mo rspace="0.055em" stretchy="false">)</mo></mrow><mo rspace="0.222em">⋅</mo><msubsup><mi>θ</mi><mn>0</mn><mo>⊤</mo></msubsup><mi>𝚺</mi><msub><mi>𝐐</mi><mn>11</mn></msub><mi>𝚺</mi><msub><mi>θ</mi><mn>0</mn></msub><mo>+</mo><mrow><mo stretchy="false">(</mo><mi>tr</mi><mrow><mo stretchy="false">(</mo><msub><mi>𝐐</mi><mn>11</mn></msub><mi>𝚺</mi><msub><mi>𝐐</mi><mn>11</mn></msub><mi>𝚺</mi><mo stretchy="false">)</mo></mrow><mo>+</mo><mi>n</mi><mo>+</mo><mn>2</mn><mo stretchy="false">)</mo></mrow><mrow><mo stretchy="false">(</mo><msubsup><mi>θ</mi><mn>0</mn><mo>⊤</mo></msubsup><mi>𝚺</mi><msub><mi>θ</mi><mn>0</mn></msub><mo>+</mo><msup><mi>σ</mi><mn>2</mn></msup><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\qquad\qquad\quad-2(n+1)\cdot{\mathbf{\theta}}_{0}^{\top}{\mathbf{\Sigma}}{\mathbf{Q}}_{11}{\mathbf{\Sigma}}{\mathbf{\theta}}_{0}+(\tr({\mathbf{Q}}_{11}{\mathbf{\Sigma}}{\mathbf{Q}}_{11}{\mathbf{\Sigma}})+n+2)({\mathbf{\theta}}_{0}^{\top}{\mathbf{\Sigma}}{\mathbf{\theta}}_{0}+\sigma^{2})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(135)</span></td></tr></tbody>
<tbody id="A1.E136"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.E136.m1" class="ltx_math_unparsed" alttext="\displaystyle\qquad\qquad\quad+q^{2}\cdot\left(({\mathbf{v}}_{21}^{\top}+{\mathbf{\theta}}_{0}^{\top}){\mathbf{\Sigma}}({\mathbf{v}}_{21}+{\mathbf{\theta}}_{0})+\sigma^{2}\right)+2q\cdot\left({\mathbf{v}}_{21}^{\top}{\mathbf{\Sigma}}{\mathbf{Q}}_{11}+{\mathbf{\theta}}_{0}^{\top}{\mathbf{\Sigma}}{\mathbf{Q}}_{11}-{\mathbf{\theta}}_{0}^{\top}\right){\mathbf{\Sigma}}{\mathbf{v}}_{21}." display="inline" intent=":literal"><semantics><mrow><mo>+</mo><msup><mi>q</mi><mn>2</mn></msup><mo lspace="0.222em" rspace="0.222em">⋅</mo><mrow><mo>(</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>𝐯</mi><mn>21</mn><mo>⊤</mo></msubsup><mo>+</mo><msubsup><mi>θ</mi><mn>0</mn><mo>⊤</mo></msubsup><mo stretchy="false">)</mo></mrow><mi>𝚺</mi><mrow><mo stretchy="false">(</mo><msub><mi>𝐯</mi><mn>21</mn></msub><mo>+</mo><msub><mi>θ</mi><mn>0</mn></msub><mo stretchy="false">)</mo></mrow><mo>+</mo><msup><mi>σ</mi><mn>2</mn></msup><mo>)</mo></mrow><mo>+</mo><mn>2</mn><mi>q</mi><mo lspace="0.222em" rspace="0.222em">⋅</mo><mrow><mo>(</mo><msubsup><mi>𝐯</mi><mn>21</mn><mo>⊤</mo></msubsup><mi>𝚺</mi><msub><mi>𝐐</mi><mn>11</mn></msub><mo>+</mo><msubsup><mi>θ</mi><mn>0</mn><mo>⊤</mo></msubsup><mi>𝚺</mi><msub><mi>𝐐</mi><mn>11</mn></msub><mo>−</mo><msubsup><mi>θ</mi><mn>0</mn><mo>⊤</mo></msubsup><mo>)</mo></mrow><mi>𝚺</mi><msub><mi>𝐯</mi><mn>21</mn></msub><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\qquad\qquad\quad+q^{2}\cdot\left(({\mathbf{v}}_{21}^{\top}+{\mathbf{\theta}}_{0}^{\top}){\mathbf{\Sigma}}({\mathbf{v}}_{21}+{\mathbf{\theta}}_{0})+\sigma^{2}\right)+2q\cdot\left({\mathbf{v}}_{21}^{\top}{\mathbf{\Sigma}}{\mathbf{Q}}_{11}+{\mathbf{\theta}}_{0}^{\top}{\mathbf{\Sigma}}{\mathbf{Q}}_{11}-{\mathbf{\theta}}_{0}^{\top}\right){\mathbf{\Sigma}}{\mathbf{v}}_{21}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(136)</span></td></tr></tbody>
</table>
</div>
</div>
<div id="A1.SS2.3" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="A1.SS2.p9" class="ltx_para">
<p id="A1.SS2.p9.1" class="ltx_p"><span id="A1.SS2.p9.1.1" class="ltx_text">By using Lemma <a href="#A1.Thmtheorem4" title="Lemma A.4. ‣ A.2 Proofs of Statistical Properties of Model Outputs ‣ Appendix A Proofs ‣ Fine-Tuning Without Forgetting In-Context Learning:A Theoretical Analysis of Linear Attention Models" class="ltx_ref"><span class="ltx_text ltx_ref_tag">A.4</span></a>, we obtain</span></p>
<table id="A1.EGx42" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A1.E137"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.E137.m1" class="ltx_Math" alttext="\displaystyle\displaystyle\mathbb{E}_{{\mathbf{Z}}_{[n]},{\mathbf{x}},y|{\mathbf{\theta}}_{0}}\left[\big(\hat{y}_{\mathrm{Net\text{-}FS}}({\mathbf{Z}}_{[n]},{\mathbf{x}};{\mathbf{V}},{\mathbf{Q}})-y\big)^{2}\right]" display="inline" intent=":literal"><semantics><mrow><msub><mi>𝔼</mi><mrow><msub><mi>𝐙</mi><mrow><mo stretchy="false">[</mo><mi>n</mi><mo stretchy="false">]</mo></mrow></msub><mo>,</mo><mi>𝐱</mi><mo>,</mo><mrow><mi>y</mi><mo fence="false">|</mo><msub><mi>θ</mi><mn>0</mn></msub></mrow></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><msup><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mrow><mrow><msub><mover accent="true"><mi>y</mi><mo>^</mo></mover><mrow><mi>Net</mi><mo lspace="0em" rspace="0em">​</mo><mtext>-</mtext><mo lspace="0em" rspace="0em">​</mo><mi>FS</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐙</mi><mrow><mo stretchy="false">[</mo><mi>n</mi><mo stretchy="false">]</mo></mrow></msub><mo>,</mo><mi>𝐱</mi><mo>,</mo><mi>𝐕</mi><mo>,</mo><mi>𝐐</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mi>y</mi></mrow><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow><mn>2</mn></msup><mo>]</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\displaystyle\mathbb{E}_{{\mathbf{Z}}_{[n]},{\mathbf{x}},y|{\mathbf{\theta}}_{0}}\left[\big(\hat{y}_{\mathrm{Net\text{-}FS}}({\mathbf{Z}}_{[n]},{\mathbf{x}};{\mathbf{V}},{\mathbf{Q}})-y\big)^{2}\right]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(137)</span></td></tr></tbody>
<tbody id="A1.E138"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
