<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A1.E98.m1" class="ltx_Math" alttext="\displaystyle\displaystyle\mathbb{E}\left[{\mathbf{x}}_{n+1}{\mathbf{x}}_{n+1}^{\top}{\mathbf{Q}}_{11}{\mathbf{x}}_{n+1}{\mathbf{x}}_{n+1}^{\top}{\mathbf{Q}}_{11}^{\top}{\mathbf{x}}_{n+1}{\mathbf{x}}_{n+1}^{\top}\right]" display="inline" intent=":literal"><semantics><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><mrow><msub><mi>𝐱</mi><mrow><mi>n</mi><mo>+</mo><mn>1</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝐱</mi><mrow><mi>n</mi><mo>+</mo><mn>1</mn></mrow><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝐐</mi><mn>11</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝐱</mi><mrow><mi>n</mi><mo>+</mo><mn>1</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝐱</mi><mrow><mi>n</mi><mo>+</mo><mn>1</mn></mrow><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝐐</mi><mn>11</mn><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝐱</mi><mrow><mi>n</mi><mo>+</mo><mn>1</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝐱</mi><mrow><mi>n</mi><mo>+</mo><mn>1</mn></mrow><mo>⊤</mo></msubsup></mrow><mo>]</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\displaystyle\mathbb{E}\left[{\mathbf{x}}_{n+1}{\mathbf{x}}_{n+1}^{\top}{\mathbf{Q}}_{11}{\mathbf{x}}_{n+1}{\mathbf{x}}_{n+1}^{\top}{\mathbf{Q}}_{11}^{\top}{\mathbf{x}}_{n+1}{\mathbf{x}}_{n+1}^{\top}\right]</annotation></semantics></math></td>
