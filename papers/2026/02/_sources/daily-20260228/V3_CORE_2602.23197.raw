<tbody id="A1.E188"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.E188.m1" class="ltx_math_unparsed" alttext="\displaystyle\quad+q^{2}\cdot{\mathbf{v}}_{21}^{\top}{\mathbf{\Sigma}}{\mathbf{v}}_{21}+2q\cdot\tr({\mathbf{Q}}_{11}{\mathbf{\Sigma}})\cdot{\mathbf{v}}_{21}^{\top}{\mathbf{\Sigma}}{\mathbf{v}}_{21}+4q\cdot{\mathbf{v}}_{21}^{\top}{\mathbf{\Sigma}}{\mathbf{Q}}_{11}{\mathbf{\Sigma}}{\mathbf{v}}_{21}-2q\cdot{\mathbf{v}}_{21}^{\top}{\mathbf{\Sigma}}{\mathbf{\theta}}_{0}." display="inline" intent=":literal"><semantics><mrow><mo>+</mo><msup><mi>q</mi><mn>2</mn></msup><mo lspace="0.222em" rspace="0.222em">⋅</mo><msubsup><mi>𝐯</mi><mn>21</mn><mo>⊤</mo></msubsup><mi>𝚺</mi><msub><mi>𝐯</mi><mn>21</mn></msub><mo>+</mo><mn>2</mn><mi>q</mi><mo lspace="0.222em" rspace="0.222em">⋅</mo><mi>tr</mi><mrow><mo stretchy="false">(</mo><msub><mi>𝐐</mi><mn>11</mn></msub><mi>𝚺</mi><mo rspace="0.055em" stretchy="false">)</mo></mrow><mo rspace="0.222em">⋅</mo><msubsup><mi>𝐯</mi><mn>21</mn><mo>⊤</mo></msubsup><mi>𝚺</mi><msub><mi>𝐯</mi><mn>21</mn></msub><mo>+</mo><mn>4</mn><mi>q</mi><mo lspace="0.222em" rspace="0.222em">⋅</mo><msubsup><mi>𝐯</mi><mn>21</mn><mo>⊤</mo></msubsup><mi>𝚺</mi><msub><mi>𝐐</mi><mn>11</mn></msub><mi>𝚺</mi><msub><mi>𝐯</mi><mn>21</mn></msub><mo>−</mo><mn>2</mn><mi>q</mi><mo lspace="0.222em" rspace="0.222em">⋅</mo><msubsup><mi>𝐯</mi><mn>21</mn><mo>⊤</mo></msubsup><mi>𝚺</mi><msub><mi>θ</mi><mn>0</mn></msub><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\quad+q^{2}\cdot{\mathbf{v}}_{21}^{\top}{\mathbf{\Sigma}}{\mathbf{v}}_{21}+2q\cdot\tr({\mathbf{Q}}_{11}{\mathbf{\Sigma}})\cdot{\mathbf{v}}_{21}^{\top}{\mathbf{\Sigma}}{\mathbf{v}}_{21}+4q\cdot{\mathbf{v}}_{21}^{\top}{\mathbf{\Sigma}}{\mathbf{Q}}_{11}{\mathbf{\Sigma}}{\mathbf{v}}_{21}-2q\cdot{\mathbf{v}}_{21}^{\top}{\mathbf{\Sigma}}{\mathbf{\theta}}_{0}.</annotation></semantics></math></td>
