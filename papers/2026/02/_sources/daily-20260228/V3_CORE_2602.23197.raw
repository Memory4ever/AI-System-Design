<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.E152.m1" class="ltx_Math" alttext="\displaystyle=\left({\mathbf{v}}_{21}^{\top}{\mathbf{\Sigma}}{\mathbf{Q}}_{11}+v_{22}{\mathbf{\theta}}_{0}^{\top}{\mathbf{\Sigma}}{\mathbf{Q}}_{11}+{\mathbf{v}}_{21}^{\top}{\mathbf{\Sigma}}{\mathbf{\theta}}_{0}{\mathbf{q}}_{21}^{\top}+v_{22}({\mathbf{\theta}}_{0}^{\top}{\mathbf{\Sigma}}{\mathbf{\theta}}_{0}+\sigma^{2}){\mathbf{q}}_{21}^{\top}\right)" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mo>(</mo><mrow><mrow><msubsup><mi>𝐯</mi><mn>21</mn><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>𝚺</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝐐</mi><mn>11</mn></msub></mrow><mo>+</mo><mrow><msub><mi>v</mi><mn>22</mn></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>θ</mi><mn>0</mn><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>𝚺</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝐐</mi><mn>11</mn></msub></mrow><mo>+</mo><mrow><msubsup><mi>𝐯</mi><mn>21</mn><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>𝚺</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>θ</mi><mn>0</mn></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝐪</mi><mn>21</mn><mo>⊤</mo></msubsup></mrow><mo>+</mo><mrow><msub><mi>v</mi><mn>22</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><msubsup><mi>θ</mi><mn>0</mn><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>𝚺</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>θ</mi><mn>0</mn></msub></mrow><mo>+</mo><msup><mi>σ</mi><mn>2</mn></msup></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝐪</mi><mn>21</mn><mo>⊤</mo></msubsup></mrow></mrow><mo>)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\left({\mathbf{v}}_{21}^{\top}{\mathbf{\Sigma}}{\mathbf{Q}}_{11}+v_{22}{\mathbf{\theta}}_{0}^{\top}{\mathbf{\Sigma}}{\mathbf{Q}}_{11}+{\mathbf{v}}_{21}^{\top}{\mathbf{\Sigma}}{\mathbf{\theta}}_{0}{\mathbf{q}}_{21}^{\top}+v_{22}({\mathbf{\theta}}_{0}^{\top}{\mathbf{\Sigma}}{\mathbf{\theta}}_{0}+\sigma^{2}){\mathbf{q}}_{21}^{\top}\right)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(152)</span></td></tr></tbody>
<tbody id="A1.E153"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.E153.m1" class="ltx_Math" alttext="\displaystyle\qquad\cdot{\mathbf{\Sigma}}\left(({\mathbf{Q}}_{11}+{\mathbf{Q}}_{11}^{\top}){\mathbf{\Sigma}}{\mathbf{v}}_{21}+\tr({\mathbf{Q}}_{11}{\mathbf{\Sigma}})\cdot{\mathbf{v}}_{21}+q\cdot{\mathbf{v}}_{21}-{\mathbf{\theta}}_{0}\right)" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo lspace="2.222em" rspace="0.222em">⋅</mo><mrow><mi>𝚺</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mrow><mrow><mrow><mo stretchy="false">(</mo><mrow><msub><mi>𝐐</mi><mn>11</mn></msub><mo>+</mo><msubsup><mi>𝐐</mi><mn>11</mn><mo>⊤</mo></msubsup></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>𝚺</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝐯</mi><mn>21</mn></msub></mrow><mo>+</mo><mrow><mrow><mi>tr</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>𝐐</mi><mn>11</mn></msub><mo lspace="0em" rspace="0em">​</mo><mi>𝚺</mi></mrow><mo rspace="0.055em" stretchy="false">)</mo></mrow></mrow><mo rspace="0.222em">⋅</mo><msub><mi>𝐯</mi><mn>21</mn></msub></mrow><mo>+</mo><mrow><mi>q</mi><mo lspace="0.222em" rspace="0.222em">⋅</mo><msub><mi>𝐯</mi><mn>21</mn></msub></mrow></mrow><mo>−</mo><msub><mi>θ</mi><mn>0</mn></msub></mrow><mo>)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\qquad\cdot{\mathbf{\Sigma}}\left(({\mathbf{Q}}_{11}+{\mathbf{Q}}_{11}^{\top}){\mathbf{\Sigma}}{\mathbf{v}}_{21}+\tr({\mathbf{Q}}_{11}{\mathbf{\Sigma}})\cdot{\mathbf{v}}_{21}+q\cdot{\mathbf{v}}_{21}-{\mathbf{\theta}}_{0}\right)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(153)</span></td></tr></tbody>
<tbody id="A1.E154"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.E154.m1" class="ltx_Math" alttext="\displaystyle\quad-{\mathbf{v}}_{21}^{\top}\left({\mathbf{\Sigma}}({\mathbf{Q}}_{11}+{\mathbf{Q}}_{11}^{\top}){\mathbf{\Sigma}}+\tr({\mathbf{Q}}_{11}{\mathbf{\Sigma}})\cdot{\mathbf{\Sigma}}+q\cdot{\mathbf{\Sigma}}\right){\mathbf{\theta}}_{0}+{\mathbf{\theta}}_{0}^{\top}{\mathbf{\Sigma}}{\mathbf{\theta}}_{0}+\sigma^{2}," display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mo>−</mo><mrow><msubsup><mi>𝐯</mi><mn>21</mn><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mrow><mrow><mi>𝚺</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>𝐐</mi><mn>11</mn></msub><mo>+</mo><msubsup><mi>𝐐</mi><mn>11</mn><mo>⊤</mo></msubsup></mrow><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><mi>𝚺</mi></mrow><mo>+</mo><mrow><mrow><mi>tr</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>𝐐</mi><mn>11</mn></msub><mo lspace="0em" rspace="0em">​</mo><mi>𝚺</mi></mrow><mo rspace="0.055em" stretchy="false">)</mo></mrow></mrow><mo rspace="0.222em">⋅</mo><mi>𝚺</mi></mrow><mo>+</mo><mrow><mi>q</mi><mo lspace="0.222em" rspace="0.222em">⋅</mo><mi>𝚺</mi></mrow></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>θ</mi><mn>0</mn></msub></mrow></mrow><mo>+</mo><mrow><msubsup><mi>θ</mi><mn>0</mn><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>𝚺</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>θ</mi><mn>0</mn></msub></mrow><mo>+</mo><msup><mi>σ</mi><mn>2</mn></msup></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\quad-{\mathbf{v}}_{21}^{\top}\left({\mathbf{\Sigma}}({\mathbf{Q}}_{11}+{\mathbf{Q}}_{11}^{\top}){\mathbf{\Sigma}}+\tr({\mathbf{Q}}_{11}{\mathbf{\Sigma}})\cdot{\mathbf{\Sigma}}+q\cdot{\mathbf{\Sigma}}\right){\mathbf{\theta}}_{0}+{\mathbf{\theta}}_{0}^{\top}{\mathbf{\Sigma}}{\mathbf{\theta}}_{0}+\sigma^{2},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(154)</span></td></tr></tbody>
</table>
<p id="A1.SS2.p9.3" class="ltx_p"><span id="A1.SS2.p9.3.1" class="ltx_text">where the last equality comes from</span></p>
<table id="A1.EGx45" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A1.E155"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A1.E155.m1" class="ltx_Math" alttext="\displaystyle\begin{bmatrix}{\mathbf{v}}_{21}\\
v_{22}\end{bmatrix}^{\top}{\mathbf{\Sigma}}_{\mathrm{joint}}\begin{bmatrix}{\mathbf{Q}}_{11}\\
{\mathbf{q}}_{21}^{\top}\end{bmatrix}" display="inline" intent=":literal"><semantics><mrow><msup><mrow><mo>[</mo><mtable rowspacing="0pt"><mtr><mtd><msub><mi>𝐯</mi><mn>21</mn></msub></mtd></mtr><mtr><mtd><msub><mi>v</mi><mn>22</mn></msub></mtd></mtr></mtable><mo>]</mo></mrow><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝚺</mi><mi>joint</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><mtable rowspacing="0pt"><mtr><mtd><msub><mi>𝐐</mi><mn>11</mn></msub></mtd></mtr><mtr><mtd><msubsup><mi>𝐪</mi><mn>21</mn><mo>⊤</mo></msubsup></mtd></mtr></mtable><mo>]</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\begin{bmatrix}{\mathbf{v}}_{21}\\
v_{22}\end{bmatrix}^{\top}{\mathbf{\Sigma}}_{\mathrm{joint}}\begin{bmatrix}{\mathbf{Q}}_{11}\\
{\mathbf{q}}_{21}^{\top}\end{bmatrix}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.E155.m2" class="ltx_Math" alttext="\displaystyle={\mathbf{v}}_{21}^{\top}{\mathbf{\Sigma}}{\mathbf{Q}}_{11}+v_{22}{\mathbf{\theta}}_{0}^{\top}{\mathbf{\Sigma}}{\mathbf{Q}}_{11}+{\mathbf{v}}_{21}^{\top}{\mathbf{\Sigma}}{\mathbf{\theta}}_{0}{\mathbf{q}}_{21}^{\top}+v_{22}({\mathbf{\theta}}_{0}^{\top}{\mathbf{\Sigma}}{\mathbf{\theta}}_{0}+\sigma^{2}){\mathbf{q}}_{21}^{\top}." display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><msubsup><mi>𝐯</mi><mn>21</mn><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>𝚺</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝐐</mi><mn>11</mn></msub></mrow><mo>+</mo><mrow><msub><mi>v</mi><mn>22</mn></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>θ</mi><mn>0</mn><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>𝚺</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝐐</mi><mn>11</mn></msub></mrow><mo>+</mo><mrow><msubsup><mi>𝐯</mi><mn>21</mn><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>𝚺</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>θ</mi><mn>0</mn></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝐪</mi><mn>21</mn><mo>⊤</mo></msubsup></mrow><mo>+</mo><mrow><msub><mi>v</mi><mn>22</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><msubsup><mi>θ</mi><mn>0</mn><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>𝚺</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>θ</mi><mn>0</mn></msub></mrow><mo>+</mo><msup><mi>σ</mi><mn>2</mn></msup></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝐪</mi><mn>21</mn><mo>⊤</mo></msubsup></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle={\mathbf{v}}_{21}^{\top}{\mathbf{\Sigma}}{\mathbf{Q}}_{11}+v_{22}{\mathbf{\theta}}_{0}^{\top}{\mathbf{\Sigma}}{\mathbf{Q}}_{11}+{\mathbf{v}}_{21}^{\top}{\mathbf{\Sigma}}{\mathbf{\theta}}_{0}{\mathbf{q}}_{21}^{\top}+v_{22}({\mathbf{\theta}}_{0}^{\top}{\mathbf{\Sigma}}{\mathbf{\theta}}_{0}+\sigma^{2}){\mathbf{q}}_{21}^{\top}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(155)</span></td></tr></tbody>
</table>
</div>
<div id="A1.SS2.p10" class="ltx_para">
<p id="A1.SS2.p10.1" class="ltx_p"><span id="A1.SS2.p10.1.1" class="ltx_text">Now consider the case where <math id="A1.SS2.p10.m1" class="ltx_Math" alttext="v_{22}=1" display="inline" intent=":literal"><semantics><mrow><msub><mi>v</mi><mn>22</mn></msub><mo>=</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">v_{22}=1</annotation></semantics></math>, <math id="A1.SS2.p10.m2" class="ltx_Math" alttext="{\mathbf{q}}_{21}={\mathbf{0}}_{d}" display="inline" intent=":literal"><semantics><mrow><msub><mi>𝐪</mi><mn>21</mn></msub><mo>=</mo><msub><mn>𝟎</mn><mi>d</mi></msub></mrow><annotation encoding="application/x-tex">{\mathbf{q}}_{21}={\mathbf{0}}_{d}</annotation></semantics></math>, and <math id="A1.SS2.p10.m3" class="ltx_Math" alttext="{\mathbf{Q}}_{11}={\mathbf{Q}}_{11}^{\top}" display="inline" intent=":literal"><semantics><mrow><msub><mi>𝐐</mi><mn>11</mn></msub><mo>=</mo><msubsup><mi>𝐐</mi><mn>11</mn><mo>⊤</mo></msubsup></mrow><annotation encoding="application/x-tex">{\mathbf{Q}}_{11}={\mathbf{Q}}_{11}^{\top}</annotation></semantics></math>. It follows that</span></p>
<table id="A1.EGx46" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A1.E156"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.E156.m1" class="ltx_Math" alttext="\displaystyle\tr\left(\begin{bmatrix}{\mathbf{Q}}_{11}\\
{\mathbf{q}}_{21}^{\top}\end{bmatrix}{\mathbf{\Sigma}}\begin{bmatrix}{\mathbf{Q}}_{11}\\
{\mathbf{q}}_{21}^{\top}\end{bmatrix}^{\top}{\mathbf{\Sigma}}_{\mathrm{joint}}\right)=\tr\left({\mathbf{\Sigma}}\begin{bmatrix}{\mathbf{Q}}_{11}&{\mathbf{0}}_{d}\end{bmatrix}\begin{bmatrix}{\mathbf{\Sigma}}&{\mathbf{\Sigma}}{\mathbf{\theta}}_{0}\\
{\mathbf{\theta}}_{0}^{\top}{\mathbf{\Sigma}}&{\mathbf{\theta}}_{0}^{\top}{\mathbf{\Sigma}}{\mathbf{\theta}}_{0}+\sigma^{2}\end{bmatrix}\begin{bmatrix}{\mathbf{Q}}_{11}\\
{\mathbf{0}}_{d}^{\top}\end{bmatrix}\right)=\tr\left({\mathbf{Q}}_{11}{\mathbf{\Sigma}}{\mathbf{Q}}_{11}{\mathbf{\Sigma}}\right)," display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mi>tr</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mrow><mo>[</mo><mtable rowspacing="0pt"><mtr><mtd><msub><mi>𝐐</mi><mn>11</mn></msub></mtd></mtr><mtr><mtd><msubsup><mi>𝐪</mi><mn>21</mn><mo>⊤</mo></msubsup></mtd></mtr></mtable><mo>]</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>𝚺</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo>[</mo><mtable rowspacing="0pt"><mtr><mtd><msub><mi>𝐐</mi><mn>11</mn></msub></mtd></mtr><mtr><mtd><msubsup><mi>𝐪</mi><mn>21</mn><mo>⊤</mo></msubsup></mtd></mtr></mtable><mo>]</mo></mrow><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝚺</mi><mi>joint</mi></msub></mrow><mo>)</mo></mrow></mrow><mo>=</mo><mrow><mi>tr</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mi>𝚺</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><mtable columnspacing="5pt"><mtr><mtd><msub><mi>𝐐</mi><mn>11</mn></msub></mtd><mtd><msub><mn>𝟎</mn><mi>d</mi></msub></mtd></mtr></mtable><mo>]</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><mtable columnspacing="5pt" rowspacing="0pt"><mtr><mtd><mi>𝚺</mi></mtd><mtd><mrow><mi>𝚺</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>θ</mi><mn>0</mn></msub></mrow></mtd></mtr><mtr><mtd><mrow><msubsup><mi>θ</mi><mn>0</mn><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>𝚺</mi></mrow></mtd><mtd><mrow><mrow><msubsup><mi>θ</mi><mn>0</mn><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>𝚺</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>θ</mi><mn>0</mn></msub></mrow><mo>+</mo><msup><mi>σ</mi><mn>2</mn></msup></mrow></mtd></mtr></mtable><mo>]</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><mtable rowspacing="0pt"><mtr><mtd><msub><mi>𝐐</mi><mn>11</mn></msub></mtd></mtr><mtr><mtd><msubsup><mn>𝟎</mn><mi>d</mi><mo>⊤</mo></msubsup></mtd></mtr></mtable><mo>]</mo></mrow></mrow><mo>)</mo></mrow></mrow><mo>=</mo><mrow><mi>tr</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><msub><mi>𝐐</mi><mn>11</mn></msub><mo lspace="0em" rspace="0em">​</mo><mi>𝚺</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝐐</mi><mn>11</mn></msub><mo lspace="0em" rspace="0em">​</mo><mi>𝚺</mi></mrow><mo>)</mo></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\tr\left(\begin{bmatrix}{\mathbf{Q}}_{11}\\
{\mathbf{q}}_{21}^{\top}\end{bmatrix}{\mathbf{\Sigma}}\begin{bmatrix}{\mathbf{Q}}_{11}\\
{\mathbf{q}}_{21}^{\top}\end{bmatrix}^{\top}{\mathbf{\Sigma}}_{\mathrm{joint}}\right)=\tr\left({\mathbf{\Sigma}}\begin{bmatrix}{\mathbf{Q}}_{11}&amp;{\mathbf{0}}_{d}\end{bmatrix}\begin{bmatrix}{\mathbf{\Sigma}}&amp;{\mathbf{\Sigma}}{\mathbf{\theta}}_{0}\\
{\mathbf{\theta}}_{0}^{\top}{\mathbf{\Sigma}}&amp;{\mathbf{\theta}}_{0}^{\top}{\mathbf{\Sigma}}{\mathbf{\theta}}_{0}+\sigma^{2}\end{bmatrix}\begin{bmatrix}{\mathbf{Q}}_{11}\\
{\mathbf{0}}_{d}^{\top}\end{bmatrix}\right)=\tr\left({\mathbf{Q}}_{11}{\mathbf{\Sigma}}{\mathbf{Q}}_{11}{\mathbf{\Sigma}}\right),</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(156)</span></td></tr></tbody>
<tbody id="A1.E157"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.E157.m1" class="ltx_Math" alttext="\displaystyle{\mathbf{\Sigma}}_{\mathrm{joint}}\begin{bmatrix}{\mathbf{v}}_{21}\\
v_{22}\end{bmatrix}=\begin{bmatrix}{\mathbf{\Sigma}}&{\mathbf{\Sigma}}{\mathbf{\theta}}_{0}\\
{\mathbf{\theta}}_{0}^{\top}{\mathbf{\Sigma}}&{\mathbf{\theta}}_{0}^{\top}{\mathbf{\Sigma}}{\mathbf{\theta}}_{0}+\sigma^{2}\end{bmatrix}\begin{bmatrix}{\mathbf{v}}_{21}\\
1\end{bmatrix}=\begin{bmatrix}{\mathbf{\Sigma}}({\mathbf{v}}_{21}+{\mathbf{\theta}}_{0})\\
{\mathbf{\theta}}_{0}^{\top}{\mathbf{\Sigma}}({\mathbf{v}}_{21}+{\mathbf{\theta}}_{0})+\sigma^{2}\end{bmatrix}," display="inline" intent=":literal"><semantics><mrow><mrow><mrow><msub><mi>𝚺</mi><mi>joint</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><mtable rowspacing="0pt"><mtr><mtd><msub><mi>𝐯</mi><mn>21</mn></msub></mtd></mtr><mtr><mtd><msub><mi>v</mi><mn>22</mn></msub></mtd></mtr></mtable><mo>]</mo></mrow></mrow><mo>=</mo><mrow><mrow><mo>[</mo><mtable columnspacing="5pt" rowspacing="0pt"><mtr><mtd><mi>𝚺</mi></mtd><mtd><mrow><mi>𝚺</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>θ</mi><mn>0</mn></msub></mrow></mtd></mtr><mtr><mtd><mrow><msubsup><mi>θ</mi><mn>0</mn><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>𝚺</mi></mrow></mtd><mtd><mrow><mrow><msubsup><mi>θ</mi><mn>0</mn><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>𝚺</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>θ</mi><mn>0</mn></msub></mrow><mo>+</mo><msup><mi>σ</mi><mn>2</mn></msup></mrow></mtd></mtr></mtable><mo>]</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><mtable rowspacing="0pt"><mtr><mtd><msub><mi>𝐯</mi><mn>21</mn></msub></mtd></mtr><mtr><mtd><mn>1</mn></mtd></mtr></mtable><mo>]</mo></mrow></mrow><mo>=</mo><mrow><mo>[</mo><mtable rowspacing="0pt"><mtr><mtd><mrow><mi>𝚺</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>𝐯</mi><mn>21</mn></msub><mo>+</mo><msub><mi>θ</mi><mn>0</mn></msub></mrow><mo stretchy="false">)</mo></mrow></mrow></mtd></mtr><mtr><mtd><mrow><mrow><msubsup><mi>θ</mi><mn>0</mn><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>𝚺</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>𝐯</mi><mn>21</mn></msub><mo>+</mo><msub><mi>θ</mi><mn>0</mn></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><msup><mi>σ</mi><mn>2</mn></msup></mrow></mtd></mtr></mtable><mo>]</mo></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle{\mathbf{\Sigma}}_{\mathrm{joint}}\begin{bmatrix}{\mathbf{v}}_{21}\\
v_{22}\end{bmatrix}=\begin{bmatrix}{\mathbf{\Sigma}}&amp;{\mathbf{\Sigma}}{\mathbf{\theta}}_{0}\\
