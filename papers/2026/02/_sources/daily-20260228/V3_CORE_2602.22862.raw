<tr id="S3.T9.5.17" class="ltx_tr">
<td id="S3.T9.5.17.1" class="ltx_td ltx_align_center">optimizer.lr</td>
<td id="S3.T9.5.17.2" class="ltx_td ltx_align_center"><math id="S3.T9.m1" class="ltx_Math" alttext="1.0\times 10^{-3}" display="inline" intent=":literal"><semantics><mrow><mn>1.0</mn><mo lspace="0.222em" rspace="0.222em">×</mo><msup><mn>10</mn><mrow><mo>−</mo><mn>3</mn></mrow></msup></mrow><annotation encoding="application/x-tex">1.0\times 10^{-3}</annotation></semantics></math></td></tr>
<tr id="S3.T9.5.18" class="ltx_tr">
