</span></td>
<td id="S4.T1.6.1.3" class="ltx_td ltx_align_left ltx_border_tt" colspan="2">
<span id="S4.T1.6.1.3.1" class="ltx_inline-block ltx_align_middle" style="width:65.4pt;">
<span id="S4.T1.6.1.3.1.1" class="ltx_p"><span id="S4.T1.6.1.3.1.1.1" class="ltx_text ltx_font_bold" style="font-size:90%;">Spatial
<br class="ltx_break">Generalization</span></span>
</span></td>
<td id="S4.T1.6.1.4" class="ltx_td ltx_align_left ltx_border_tt" colspan="2">
