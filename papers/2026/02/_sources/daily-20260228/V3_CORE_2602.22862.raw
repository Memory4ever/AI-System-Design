<td id="S4.T1.6.3.1" class="ltx_td ltx_align_left ltx_border_r"><span id="S4.T1.6.3.1.1" class="ltx_text" style="font-size:90%;">OpenVLA <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib4" title="" class="ltx_ref">20</a>]</cite></span></td>
