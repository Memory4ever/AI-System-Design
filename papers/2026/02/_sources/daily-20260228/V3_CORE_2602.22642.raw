</thead>
<tbody class="ltx_tbody">
<tr id="A1.T5.2.2" class="ltx_tr">
<td id="A1.T5.2.2.1" class="ltx_td ltx_align_left ltx_border_r ltx_border_t">validation batch size</td>
<td id="A1.T5.2.2.2" class="ltx_td ltx_align_center ltx_border_t">256</td></tr>
<tr id="A1.T5.2.3" class="ltx_tr">
