<td id="A1.T5.2.3.2" class="ltx_td ltx_align_center">0.6</td></tr>
<tr id="A1.T5.2.4" class="ltx_tr">
<td id="A1.T5.2.4.1" class="ltx_td ltx_align_left ltx_border_r"><span id="A1.T5.2.4.1.1" class="ltx_text ltx_markedasmath">top_p</span></td>
<td id="A1.T5.2.4.2" class="ltx_td ltx_align_center">0.95</td></tr>
<tr id="A1.T5.2.5" class="ltx_tr">
<td id="A1.T5.2.5.1" class="ltx_td ltx_align_left ltx_border_r">rollout num per question</td>
<td id="A1.T5.2.5.2" class="ltx_td ltx_align_center">16</td></tr>
