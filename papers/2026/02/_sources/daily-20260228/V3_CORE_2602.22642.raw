<td id="S3.T1.12.1.21.14" class="ltx_td ltx_align_center"><span id="S3.T1.12.1.21.14.1" class="ltx_text" style="--ltx-fg-color:#808080;--ltx-bg-color:#EAF7EF;">44.7</span></td>
