<td id="S3.T1.12.1.21.16" class="ltx_td ltx_align_center ltx_border_r"><span id="S3.T1.12.1.21.16.1" class="ltx_text ltx_font_bold" style="--ltx-bg-color:#EAF7EF;">-5.32</span></td>
<td id="S3.T1.12.1.21.17" class="ltx_td ltx_align_center"><span id="S3.T1.12.1.21.17.1" class="ltx_text ltx_font_bold" style="--ltx-bg-color:#EAF7EF;">24</span></td>
