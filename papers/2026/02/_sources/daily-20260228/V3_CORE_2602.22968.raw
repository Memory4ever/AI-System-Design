<span id="S4.T1.3.10.11.1.1" class="ltx_p ltx_align_center"><span id="S4.T1.3.10.11.1.1.1" class="ltx_text ltx_font_bold" style="font-size:90%;">0.58</span><span id="S4.T1.3.10.11.1.1.2" class="ltx_text" style="font-size:90%;"> </span><span id="S4.T1.3.10.11.1.1.3" class="ltx_text ltx_inline-block" style="font-size:90%;width:0.0pt;"><math id="S4.T1.m41" class="ltx_Math" alttext="\downarrow\!17\%" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo style="--ltx-fg-color:#228B22;" mathcolor="#228B22" stretchy="false">↓</mo><mrow><mn style="--ltx-fg-color:#228B22;" mathcolor="#228B22">17</mn><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" mathsize="1.110em">%</mo></mrow></mrow><annotation encoding="application/x-tex">\downarrow\!17\%</annotation></semantics></math></span></span>
