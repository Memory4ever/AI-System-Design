<span id="A3.T2.3.10.10.1" class="ltx_inline-block ltx_align_top">
<span id="A3.T2.3.10.10.1.1" class="ltx_p ltx_align_center"><span id="A3.T2.3.10.10.1.1.1" class="ltx_text ltx_font_bold" style="font-size:90%;">0.58<span id="A3.T2.3.10.10.1.1.1.1" class="ltx_text ltx_font_medium ltx_inline-block" style="width:0.0pt;"><math id="A3.T2.m51" class="ltx_Math" alttext="\downarrow\!3" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo style="--ltx-fg-color:#228B22;" mathcolor="#228B22" stretchy="false">↓</mo><mn style="--ltx-fg-color:#228B22;" mathcolor="#228B22">3</mn></mrow><annotation encoding="application/x-tex">\downarrow\!3</annotation></semantics></math></span></span></span>
