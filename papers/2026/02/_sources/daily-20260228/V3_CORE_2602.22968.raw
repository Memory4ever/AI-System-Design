<span id="A3.T2.3.3.12.1" class="ltx_inline-block ltx_align_top">
<span id="A3.T2.3.3.12.1.1" class="ltx_p ltx_align_center"><math id="A3.T2.m12" class="ltx_Math" alttext="K\!\downarrow" display="inline" intent=":literal"><semantics><mrow><mi mathsize="0.700em">K</mi><mo lspace="0.158em" mathsize="0.700em" stretchy="false">↓</mo><mphantom></mphantom></mrow><annotation encoding="application/x-tex">K\!\downarrow</annotation></semantics></math></span>
</span></td>
