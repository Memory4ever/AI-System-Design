<td id="A5.T6.6.1.4.2" class="ltx_td ltx_align_center" style="padding-left:4.0pt;padding-right:4.0pt;"><span id="A5.T6.6.1.4.2.1" class="ltx_text" style="font-size:144%;">310</span></td>
