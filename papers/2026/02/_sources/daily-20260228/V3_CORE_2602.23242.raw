true"><mi>h</mi><mo>~</mo></mover><mrow><mphantom></mphantom><mo>&lt;</mo><msub><mi>i</mi><mi>k</mi></msub></mrow><mtext class="ltx_scalerel">(n)</mtext></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mi>a</mi><msub><mi>i</mi><mi>k</mi></msub></msub></mrow><mo stretchy="false">)</mo></mrow></mrow></mfrac></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\omega_{n}(\phi\mid\tilde{h}_{&lt;i_{k-1}}^{\lx@scalerel@obj{(n)}}a_{i_{k-1}}\tilde{z}_{i_{k-1}})\frac{\phi(\tilde{z}_{i_{k}}\mid\tilde{h}_{&lt;i_{k}}^{\lx@scalerel@obj{(n)}}a_{i_{k}})}{\psi_{n}(\tilde{z}_{i_{k}}\mid\tilde{h}_{&lt;i_{k}}^{\lx@scalerel@obj{(n)}}a_{i_{k}})},</annotation></semantics></math></td>
