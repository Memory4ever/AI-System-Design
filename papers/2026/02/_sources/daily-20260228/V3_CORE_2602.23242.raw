\hline\cr\noindent\hbox{}{{\hbox{\begin{tabular}[c]{@{}l@{}}AIQI (Ours)\end{tabular}}}}\hfill\hbox{}&amp;✓&amp;✗\\
\hline\cr\noindent\hbox{}{{\hbox{\begin{tabular}[c]{@{}l@{}}AIXI \cite[citep]{[\@@bibref{AuthorsPhrase1Year}{hutter2000theory}{\@@citephrase{, }}{}]}\\
Inq \cite[citep]{[\@@bibref{AuthorsPhrase1Year}{cohen2019strongly}{\@@citephrase{, }}{}]}\\
Self-AIXI \cite[citep]{[\@@bibref{AuthorsPhrase1Year}{catt2023self}{\@@citephrase{, }}{}]}\end{tabular}}}}\hfill\hbox{}&amp;✓&amp;✓\\
