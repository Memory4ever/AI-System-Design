<span id="A2.T5.6.6.2.1" class="ltx_inline-block ltx_align_top" style="width:158.7pt;">
<span id="A2.T5.6.6.2.1.1" class="ltx_p"><span id="A2.T5.6.6.2.1.1.1" class="ltx_text" style="font-size:70%;">Small Lean checkers validate certificate structure and the final enclosure constraints needed to discharge a theorem about </span><math id="A2.T5.m2" class="ltx_Math" alttext="\mathopen{[\![}G\mathclose{]\!]}" display="inline" intent=":literal"><semantics><mrow><mrow><mo maxsize="0.700em" minsize="0.700em">[</mo><mo maxsize="0.700em" minsize="0.700em">[</mo></mrow><mi mathsize="0.700em">G</mi><mrow><mpadded style="width:0.158em;" width="0.158em"><mo maxsize="0.700em" minsize="0.700em">]</mo></mpadded><mo maxsize="0.700em" minsize="0.700em">]</mo></mrow></mrow><annotation encoding="application/x-tex">\mathopen{[\![}G\mathclose{]\!]}</annotation></semantics></math><span id="A2.T5.6.6.2.1.1.2" class="ltx_text" style="font-size:70%;">.</span></span>
