</div>
<div id="lstnumberx13" class="ltx_listingline"><span id="lstnumberx13.1" class="ltx_text ltx_font_typewriter"><span id="lstnumberx13.1.1" class="ltx_text" style="--ltx-fg-color:#000000;--ltx-bg-color:#E6F5FF;">x</span><span id="lstnumberx13.1.2" class="ltx_text ltx_lst_space" style="--ltx-fg-color:#000000;"> </span><span id="lstnumberx13.1.3" class="ltx_text" style="--ltx-fg-color:#000000;">=<span id="lstnumberx13.1.3.1" class="ltx_text ltx_lst_space"> </span>torch.tensor([[1.,0.],[0.,1.],[1.,1.]])</span></span>
</div>
<div id="lstnumberx14" class="ltx_listingline"><span id="lstnumberx14.1" class="ltx_text ltx_font_typewriter"><span id="lstnumberx14.1.1" class="ltx_text" style="--ltx-fg-color:#000000;--ltx-bg-color:#E6F5FF;">y</span><span id="lstnumberx14.1.2" class="ltx_text ltx_lst_space" style="--ltx-fg-color:#000000;"> </span><span id="lstnumberx14.1.3" class="ltx_text" style="--ltx-fg-color:#000000;">=<span id="lstnumberx14.1.3.1" class="ltx_text ltx_lst_space"> </span>torch.tensor([[2.],[-3.],[-1.]])</span></span>
</div>
