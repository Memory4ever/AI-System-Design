<div id="lstnumberx88" class="ltx_listingline"><span id="lstnumberx88.1" class="ltx_text ltx_lst_space ltx_font_typewriter">      </span><span id="lstnumberx88.2" class="ltx_text ltx_lst_identifier ltx_font_typewriter">bar</span><span id="lstnumberx88.3" class="ltx_text ltx_font_typewriter">[</span><span id="lstnumberx88.4" class="ltx_text ltx_lst_identifier ltx_font_typewriter">p</span><span id="lstnumberx88.5" class="ltx_text ltx_font_typewriter">]</span><span id="lstnumberx88.6" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx88.7" class="ltx_text ltx_font_typewriter">+=</span><span id="lstnumberx88.8" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx88.9" class="ltx_text ltx_lst_identifier ltx_font_typewriter">VJP_op_i</span><span id="lstnumberx88.10" class="ltx_text ltx_font_typewriter">(</span><span id="lstnumberx88.11" class="ltx_text ltx_lst_identifier ltx_font_typewriter">p</span><span id="lstnumberx88.12" class="ltx_text ltx_font_typewriter">,</span><span id="lstnumberx88.13" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx88.14" class="ltx_text ltx_lst_identifier ltx_font_typewriter">v</span><span id="lstnumberx88.15" class="ltx_text ltx_font_typewriter">[</span><span id="lstnumberx88.16" class="ltx_text ltx_lst_identifier ltx_font_typewriter">parents</span><span id="lstnumberx88.17" class="ltx_text ltx_font_typewriter">(</span><span id="lstnumberx88.18" class="ltx_text ltx_lst_identifier ltx_font_typewriter">i</span><span id="lstnumberx88.19" class="ltx_text ltx_font_typewriter">)],</span><span id="lstnumberx88.20" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx88.21" class="ltx_text ltx_lst_identifier ltx_font_typewriter">bar</span><span id="lstnumberx88.22" class="ltx_text ltx_font_typewriter">[</span><span id="lstnumberx88.23" class="ltx_text ltx_lst_identifier ltx_font_typewriter">i</span><span id="lstnumberx88.24" class="ltx_text ltx_font_typewriter">])</span>
</div>
<div id="lstnumberx89" class="ltx_listingline"><span id="lstnumberx89.1" class="ltx_text ltx_lst_space ltx_font_typewriter">  </span><span id="lstnumberx89.2" class="ltx_text ltx_lst_identifier ltx_font_typewriter">return</span><span id="lstnumberx89.3" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx89.4" class="ltx_text ltx_lst_identifier ltx_font_typewriter">bar</span><span id="lstnumberx89.5" class="ltx_text ltx_font_typewriter">[</span><span id="lstnumberx89.6" class="ltx_text ltx_lst_identifier ltx_font_typewriter">input</span><span id="lstnumberx89.7" class="ltx_text ltx_font_typewriter">]</span><span id="lstnumberx89.8" class="ltx_text ltx_lst_space ltx_font_typewriter">             </span><span id="lstnumberx89.9" class="ltx_text ltx_font_typewriter">#</span><span id="lstnumberx89.10" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx89.11" class="ltx_text ltx_lst_identifier ltx_font_typewriter">gradients</span><span id="lstnumberx89.12" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx89.13" class="ltx_text ltx_lst_identifier ltx_font_typewriter">w</span><span id="lstnumberx89.14" class="ltx_text ltx_font_typewriter">.</span><span id="lstnumberx89.15" class="ltx_text ltx_lst_identifier ltx_font_typewriter">r</span><span id="lstnumberx89.16" class="ltx_text ltx_font_typewriter">.</span><span id="lstnumberx89.17" class="ltx_text ltx_lst_identifier ltx_font_typewriter">t</span><span id="lstnumberx89.18" class="ltx_text ltx_font_typewriter">.</span><span id="lstnumberx89.19" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx89.20" class="ltx_text ltx_lst_identifier ltx_font_typewriter">inputs</span><span id="lstnumberx89.21" class="ltx_text ltx_font_typewriter">/</span><span id="lstnumberx89.22" class="ltx_text ltx_lst_identifier ltx_font_typewriter">params</span>
</div>
