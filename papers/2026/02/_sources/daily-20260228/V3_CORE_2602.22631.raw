<tr id="S3.T4.7.3" class="ltx_tr">
<td id="S3.T4.7.3.1" class="ltx_td ltx_align_left" style="padding:0.6pt 3.0pt;">
<span id="S3.T4.7.3.1.1" class="ltx_inline-block ltx_align_top">
<span id="S3.T4.7.3.1.1.1" class="ltx_p ltx_align_left"><math id="S3.T4.m3" class="ltx_Math" alttext="\exp([-1,\,1])" display="inline" intent=":literal"><semantics><mrow><mi mathsize="0.700em">exp</mi><mo>⁡</mo><mrow><mo maxsize="0.700em" minsize="0.700em">(</mo><mrow><mo maxsize="0.700em" minsize="0.700em">[</mo><mrow><mrow><mo mathsize="0.700em">−</mo><mn mathsize="0.700em">1</mn></mrow><mo mathsize="0.700em">,</mo><mn mathsize="0.700em"> 1</mn></mrow><mo maxsize="0.700em" minsize="0.700em">]</mo></mrow><mo maxsize="0.700em" minsize="0.700em">)</mo></mrow></mrow><annotation encoding="application/x-tex">\exp([-1,\,1])</annotation></semantics></math></span>
</span></td>
<td id="S3.T4.7.3.2" class="ltx_td ltx_align_center" style="padding:0.6pt 3.0pt;"><span id="S3.T4.7.3.2.1" class="ltx_text" style="font-size:70%;">trans</span></td>
<td id="S3.T4.7.3.3" class="ltx_td ltx_align_center" style="padding:0.6pt 3.0pt;"><math id="S3.T4.m4" class="ltx_Math" alttext="\times" display="inline" intent=":literal"><semantics><mo mathsize="0.700em">×</mo><annotation encoding="application/x-tex">\times</annotation></semantics></math></td>
