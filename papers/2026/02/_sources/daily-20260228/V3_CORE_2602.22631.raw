<span id="S3.T4.7.6.1.1.1" class="ltx_p ltx_align_left"><span id="S3.T4.7.6.1.1.1.1" class="ltx_text ltx_font_typewriter" style="font-size:70%;">div_signed_zero</span><span id="S3.T4.7.6.1.1.1.2" class="ltx_text" style="font-size:70%;"> </span><math id="S3.T4.m9" class="ltx_Math" alttext="1/[-0,-0]" display="inline" intent=":literal"><semantics><mrow><mn mathsize="0.700em">1</mn><mo maxsize="0.700em" minsize="0.700em" stretchy="true" symmetric="true">/</mo><mrow><mo maxsize="0.700em" minsize="0.700em">[</mo><mrow><mrow><mo mathsize="0.700em">−</mo><mn mathsize="0.700em">0</mn></mrow><mo mathsize="0.700em">,</mo><mrow><mo mathsize="0.700em">−</mo><mn mathsize="0.700em">0</mn></mrow></mrow><mo maxsize="0.700em" minsize="0.700em">]</mo></mrow></mrow><annotation encoding="application/x-tex">1/[-0,-0]</annotation></semantics></math></span>
</span></td>
<td id="S3.T4.7.6.2" class="ltx_td ltx_align_center" style="padding:0.6pt 3.0pt;"><span id="S3.T4.7.6.2.1" class="ltx_text" style="font-size:70%;">arith</span></td>
<td id="S3.T4.7.6.3" class="ltx_td ltx_align_center" style="padding:0.6pt 3.0pt;"><span id="S3.T4.7.6.3.1" class="ltx_text" style="font-size:70%;">✓<sup id="S3.T4.7.6.3.1.1" class="ltx_sup">†</sup></span></td>
