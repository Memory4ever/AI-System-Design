<div id="lstnumberx95" class="ltx_listingline"><span id="lstnumberx95.1" class="ltx_text ltx_font_typewriter">&lt;</span><span id="lstnumberx95.2" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx95.3" class="ltx_text ltx_lst_identifier ltx_font_typewriter">a</span><span id="lstnumberx95.4" class="ltx_text ltx_font_typewriter">,</span><span id="lstnumberx95.5" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx95.6" class="ltx_text ltx_lst_identifier ltx_font_typewriter">b</span><span id="lstnumberx95.7" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx95.8" class="ltx_text ltx_font_typewriter">&gt;</span><span id="lstnumberx95.9" class="ltx_text ltx_lst_identifier ltx_font_typewriter">_s</span><span id="lstnumberx95.10" class="ltx_text ltx_lst_space ltx_font_typewriter">  </span><span id="lstnumberx95.11" class="ltx_text ltx_font_typewriter">==</span><span id="lstnumberx95.12" class="ltx_text ltx_lst_space ltx_font_typewriter">  </span><span id="lstnumberx95.13" class="ltx_text ltx_font_typewriter">&lt;</span><span id="lstnumberx95.14" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx95.15" class="ltx_text ltx_lst_identifier ltx_font_typewriter">vec_s</span><span id="lstnumberx95.16" class="ltx_text ltx_font_typewriter">(</span><span id="lstnumberx95.17" class="ltx_text ltx_lst_identifier ltx_font_typewriter">a</span><span id="lstnumberx95.18" class="ltx_text ltx_font_typewriter">),</span><span id="lstnumberx95.19" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx95.20" class="ltx_text ltx_lst_identifier ltx_font_typewriter">vec_s</span><span id="lstnumberx95.21" class="ltx_text ltx_font_typewriter">(</span><span id="lstnumberx95.22" class="ltx_text ltx_lst_identifier ltx_font_typewriter">b</span><span id="lstnumberx95.23" class="ltx_text ltx_font_typewriter">)</span><span id="lstnumberx95.24" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx95.25" class="ltx_text ltx_font_typewriter">&gt;</span><span id="lstnumberx95.26" class="ltx_text ltx_lst_identifier ltx_font_typewriter">_</span><span id="lstnumberx95.27" class="ltx_text ltx_font_typewriter">{</span><span id="lstnumberx95.28" class="ltx_text ltx_lst_identifier ltx_font_typewriter">R</span><span id="lstnumberx95.29" class="ltx_text ltx_font_typewriter">^{</span><span id="lstnumberx95.30" class="ltx_text ltx_lst_identifier ltx_font_typewriter">size</span><span id="lstnumberx95.31" class="ltx_text ltx_font_typewriter">(</span><span id="lstnumberx95.32" class="ltx_text ltx_lst_identifier ltx_font_typewriter">s</span><span id="lstnumberx95.33" class="ltx_text ltx_font_typewriter">)}}</span>
</div>
