</div>
<div id="A2.SS4.p7" class="ltx_para ltx_noindent"><span class="ltx_inline-block"><svg id="A2.SS4.p7.pic1" class="ltx_picture" height="109.56" overflow="visible" version="1.1" viewBox="0 0 477.38 109.56" width="477.38"><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" stroke-width="0.4pt" transform="translate(0,109.56) matrix(1 0 0 -1 0 0)"><g style="--ltx-fill-color:#000099;" fill="#000099" fill-opacity="1.0"><path style="stroke:none" d="M 0 3.6 L 0 105.97 C 0 107.95 1.61 109.56 3.6 109.56 L 473.78 109.56 C 475.77 109.56 477.38 107.95 477.38 105.97 L 477.38 3.6 C 477.38 1.61 475.77 0 473.78 0 L 3.6 0 C 1.61 0 0 1.61 0 3.6 Z"></path></g><g style="--ltx-fill-color:#F7F7F7;" fill="#F7F7F7" fill-opacity="1.0"><path style="stroke:none" d="M 0.83 3.6 L 0.83 86.19 L 476.55 86.19 L 476.55 3.6 C 476.55 2.07 475.31 0.83 473.78 0.83 L 3.6 0.83 C 2.07 0.83 0.83 2.07 0.83 3.6 Z"></path></g><g style="--ltx-fill-color:#000099;" fill="#000099" fill-opacity="1.0"><path style="stroke:none" d="M 0.83 87.02 L 0.83 105.97 C 0.83 107.49 2.07 108.73 3.6 108.73 L 473.78 108.73 C 475.31 108.73 476.55 107.49 476.55 105.97 L 476.55 87.02 Z"></path></g><g style="--ltx-stroke-color:#000099;--ltx-fill-color:#000099;--ltx-fg-color:#000099;" color="#000099" fill="#000099" stroke="#000099" stroke-width="2.0pt"><path style="fill:none" d="M 1.38 109.56 L 1.38 0"></path></g><g fill-opacity="1.0" transform="matrix(1.0 0.0 0.0 1.0 13.07 94.42)"><foreignObject style="--ltx-fo-width:28.36em;--ltx-fo-height:0.75em;--ltx-fo-depth:0.25em;font-size:10pt;" height="13.84" overflow="visible" transform="matrix(1 0 0 -1 0 10.38)" width="392.42"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><span id="A2.SS4.p7.pic1.1" class="ltx_inline-logical-block ltx_minipage ltx_align_bottom" style="width:28.36em;">
<span id="A2.SS4.p7.pic1.p1" class="ltx_para ltx_indent">
<span id="A2.SS4.p7.pic1.p1.1" class="ltx_p"><span id="A2.SS4.p7.pic1.p1.1.1" class="ltx_text ltx_font_bold" style="--ltx-fg-color:#FFFFFF;">Theorem B.3: </span><span id="A2.SS4.p7.pic1.p1.1.2" class="ltx_text ltx_font_bold" style="--ltx-fg-color:#FFFFFF;">Graph adjointness (algebraic)</span></span>
</span></span></span></span></foreignObject></g><g fill-opacity="1.0" transform="matrix(1.0 0.0 0.0 1.0 13.07 15.14)"><foreignObject style="--ltx-fo-width:32.61em;--ltx-fo-height:4.35em;--ltx-fo-depth:0.25em;font-size:10pt;" height="63.65" overflow="visible" transform="matrix(1 0 0 -1 0 60.19)" width="451.23"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content">
<span id="A2.SS4.p7.pic1.2" class="ltx_inline-block ltx_minipage ltx_align_bottom" style="width:32.61em;">
<span id="A2.SS4.p7.pic1.2.1" class="ltx_p"><span id="A2.SS4.p7.pic1.2.1.1" class="ltx_text" style="--ltx-fg-color:#000000;">For any well-typed SSA/DAG graph <math id="A2.SS4.p7.pic1.m1" class="ltx_Math" alttext="G" display="inline" intent=":literal"><semantics><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">G</mi><annotation encoding="application/x-tex">G</annotation></semantics></math> (over any <span id="A2.SS4.p7.pic1.2.1.1.1" class="ltx_text ltx_font_typewriter">Context</span>) and any <math id="A2.SS4.p7.pic1.m2" class="ltx_Math" alttext="x" display="inline" intent=":literal"><semantics><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">x</mi><annotation encoding="application/x-tex">x</annotation></semantics></math>, <math id="A2.SS4.p7.pic1.m3" class="ltx_Math" alttext="\delta x" display="inline" intent=":literal"><semantics><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">δ</mi><mo lspace="0em" rspace="0em">​</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">x</mi></mrow><annotation encoding="application/x-tex">\delta x</annotation></semantics></math>, and cotangent seed <math id="A2.SS4.p7.pic1.m4" class="ltx_Math" alttext="\bar{y}" display="inline" intent=":literal"><semantics><mover accent="true"><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">y</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">¯</mo></mover><annotation encoding="application/x-tex">\bar{y}</annotation></semantics></math>,</span></span>
<span id="A2.Ex3" class="ltx_equation ltx_eqn_table">

<span><span class="ltx_equation ltx_eqn_row ltx_align_baseline">
<span class="ltx_eqn_cell ltx_eqn_center_padleft"></span>
<span class="ltx_eqn_cell ltx_align_center"><math id="A2.Ex3.m1" class="ltx_Math" alttext="\big\langle\mathrm{JVP}_{G}(x;\delta x),\,\bar{y}\big\rangle\;=\;\big\langle\delta x,\,\mathrm{VJP}_{G}(x;\bar{y})\big\rangle." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">⟨</mo><mrow><mrow><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">JVP</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">G</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">(</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">x</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">,</mo><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">δ</mi><mo lspace="0em" rspace="0em">​</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">x</mi></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">)</mo></mrow></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" rspace="0.337em">,</mo><mover accent="true"><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">y</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">¯</mo></mover></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" rspace="0.280em" stretchy="false">⟩</mo></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" rspace="0.558em">=</mo><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">⟨</mo><mrow><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">δ</mi><mo lspace="0em" rspace="0em">​</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">x</mi></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" rspace="0.337em">,</mo><mrow><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">VJP</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">G</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">(</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">x</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">,</mo><mover accent="true"><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">y</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">¯</mo></mover><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">)</mo></mrow></mrow></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">⟩</mo></mrow></mrow><mo style="--ltx-fg-color:#000000;" lspace="0em" mathcolor="#000000">.</mo></mrow><annotation encoding="application/x-tex">\big\langle\mathrm{JVP}_{G}(x;\delta x),\,\bar{y}\big\rangle\;=\;\big\langle\delta x,\,\mathrm{VJP}_{G}(x;\bar{y})\big\rangle.</annotation></semantics></math></span>
<span class="ltx_eqn_cell ltx_eqn_center_padright"></span></span></span>
</span>
</span></span></span></foreignObject></g></g></svg></span>
</div>
<div id="A2.SS4.p8" class="ltx_para">
<p id="A2.SS4.p8.1" class="ltx_p"><span id="A2.SS4.p8.1.1" class="ltx_text ltx_font_bold">Stage 2: Analytic upgrade (real calculus).</span>
Stage 1 establishes a purely algebraic adjointness law over an abstract scalar interface. In Stage 2 we specialize to
<math id="A2.SS4.p8.m1" class="ltx_Math" alttext="\mathbb{R}" display="inline" intent=":literal"><semantics><mi>ℝ</mi><annotation encoding="application/x-tex">\mathbb{R}</annotation></semantics></math> and connect that law to standard multivariate calculus. The key step is to relate shape-indexed tensor spaces
to finite-dimensional Euclidean spaces: for each tensor shape <math id="A2.SS4.p8.m2" class="ltx_Math" alttext="s" display="inline" intent=":literal"><semantics><mi>s</mi><annotation encoding="application/x-tex">s</annotation></semantics></math>, let <math id="A2.SS4.p8.m3" class="ltx_Math" alttext="n=\mathrm{size}(s)" display="inline" intent=":literal"><semantics><mrow><mi>n</mi><mo>=</mo><mrow><mi>size</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>s</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">n=\mathrm{size}(s)</annotation></semantics></math> and identify tensors
with vectors in <math id="A2.SS4.p8.m4" class="ltx_Math" alttext="\mathbb{R}^{n}" display="inline" intent=":literal"><semantics><msup><mi>ℝ</mi><mi>n</mi></msup><annotation encoding="application/x-tex">\mathbb{R}^{n}</annotation></semantics></math> via a (total) vectorization map and its inverse. This lets us interpret graph evaluation
as a function <math id="A2.SS4.p8.m5" class="ltx_Math" alttext="\mathsf{EvalVec}_{G}:\mathbb{R}^{N_{\text{in}}}\to\mathbb{R}^{N_{\text{out}}}" display="inline" intent=":literal"><semantics><mrow><msub><mi>𝖤𝗏𝖺𝗅𝖵𝖾𝖼</mi><mi>G</mi></msub><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><msup><mi>ℝ</mi><msub><mi>N</mi><mtext>in</mtext></msub></msup><mo stretchy="false">→</mo><msup><mi>ℝ</mi><msub><mi>N</mi><mtext>out</mtext></msub></msup></mrow></mrow><annotation encoding="application/x-tex">\mathsf{EvalVec}_{G}:\mathbb{R}^{N_{\text{in}}}\to\mathbb{R}^{N_{\text{out}}}</annotation></semantics></math> between Euclidean spaces and
use the usual Fréchet derivative (Jacobian as a linear map).</p>
</div>
<div id="A2.SS4.p9" class="ltx_para">
<p id="A2.SS4.p9.1" class="ltx_p"><span id="A2.SS4.p9.1.1" class="ltx_text ltx_font_bold">Vectorization and inner products.</span>
Let <math id="A2.SS4.p9.m1" class="ltx_Math" alttext="\mathrm{vec}_{s}:\mathrm{Tensor}(\mathbb{R},s)\to\mathbb{R}^{\mathrm{size}(s)}" display="inline" intent=":literal"><semantics><mrow><msub><mi>vec</mi><mi>s</mi></msub><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mrow><mi>Tensor</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>ℝ</mi><mo>,</mo><mi>s</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">→</mo><msup><mi>ℝ</mi><mrow><mi>size</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>s</mi><mo stretchy="false">)</mo></mrow></mrow></msup></mrow></mrow><annotation encoding="application/x-tex">\mathrm{vec}_{s}:\mathrm{Tensor}(\mathbb{R},s)\to\mathbb{R}^{\mathrm{size}(s)}</annotation></semantics></math> be the flattening map (with inverse
<math id="A2.SS4.p9.m2" class="ltx_Math" alttext="\mathrm{unvec}_{s}" display="inline" intent=":literal"><semantics><msub><mi>unvec</mi><mi>s</mi></msub><annotation encoding="application/x-tex">\mathrm{unvec}_{s}</annotation></semantics></math>). We define the tensor dot product <math id="A2.SS4.p9.m3" class="ltx_Math" alttext="\langle a,b\rangle_{s}" display="inline" intent=":literal"><semantics><msub><mrow><mo stretchy="false">⟨</mo><mrow><mi>a</mi><mo>,</mo><mi>b</mi></mrow><mo stretchy="false">⟩</mo></mrow><mi>s</mi></msub><annotation encoding="application/x-tex">\langle a,b\rangle_{s}</annotation></semantics></math> by summing coordinatewise products over the
shape; the bridge theorem states that this dot product coincides with the standard Euclidean inner product after
vectorization.</p>
</div>
<div id="A2.SS4.p10" class="ltx_para">
<div id="A2.SS4.p10.1" class="ltx_listing ltx_lst_language_Lean4 ltx_lstlisting ltx_framed ltx_framed_rectangle ltx_listing" style="--ltx-bg-color:#FBFBFB;--ltx-border-color:#A6A6A6;"><div class="ltx_listing_data"><a href="data:text/plain;base64,IyBDb25jZXB0dWFsIGRlZmluaXRpb24gKHNoYXBlLWluZGV4ZWQpCnZlY19zICAgOiBUZW5zb3IoUixzKSAtPiBSXntzaXplKHMpfSAgICAgICMgZmxhdHRlbgp1bnZlY19zIDogUl57c2l6ZShzKX0gLT4gVGVuc29yKFIscykgICAgICAjIHJlc2hhcGUKCiMgQnJpZGdlIHByb3BlcnR5CjwgYSwgYiA+X3MgID09ICA8IHZlY19zKGEpLCB2ZWNfcyhiKSA+X3tSXntzaXplKHMpfX0=" download="">⬇</a></div>
<div id="lstnumberx90" class="ltx_listingline"><span id="lstnumberx90.1" class="ltx_text ltx_font_typewriter">#</span><span id="lstnumberx90.2" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx90.3" class="ltx_text ltx_lst_identifier ltx_font_typewriter">Conceptual</span><span id="lstnumberx90.4" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx90.5" class="ltx_text ltx_lst_identifier ltx_font_typewriter">definition</span><span id="lstnumberx90.6" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx90.7" class="ltx_text ltx_font_typewriter">(</span><span id="lstnumberx90.8" class="ltx_text ltx_lst_identifier ltx_font_typewriter">shape</span><span id="lstnumberx90.9" class="ltx_text ltx_font_typewriter">-</span><span id="lstnumberx90.10" class="ltx_text ltx_lst_identifier ltx_font_typewriter">indexed</span><span id="lstnumberx90.11" class="ltx_text ltx_font_typewriter">)</span>
</div>
<div id="lstnumberx91" class="ltx_listingline"><span id="lstnumberx91.1" class="ltx_text ltx_lst_identifier ltx_font_typewriter">vec_s</span><span id="lstnumberx91.2" class="ltx_text ltx_lst_space ltx_font_typewriter">   </span><span id="lstnumberx91.3" class="ltx_text ltx_font_typewriter">:</span><span id="lstnumberx91.4" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx91.5" class="ltx_text ltx_lst_identifier ltx_font_typewriter">Tensor</span><span id="lstnumberx91.6" class="ltx_text ltx_font_typewriter">(</span><span id="lstnumberx91.7" class="ltx_text ltx_lst_identifier ltx_font_typewriter">R</span><span id="lstnumberx91.8" class="ltx_text ltx_font_typewriter">,</span><span id="lstnumberx91.9" class="ltx_text ltx_lst_identifier ltx_font_typewriter">s</span><span id="lstnumberx91.10" class="ltx_text ltx_font_typewriter">)</span><span id="lstnumberx91.11" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx91.12" class="ltx_text ltx_font_typewriter">-&gt;</span><span id="lstnumberx91.13" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx91.14" class="ltx_text ltx_lst_identifier ltx_font_typewriter">R</span><span id="lstnumberx91.15" class="ltx_text ltx_font_typewriter">^{</span><span id="lstnumberx91.16" class="ltx_text ltx_lst_identifier ltx_font_typewriter">size</span><span id="lstnumberx91.17" class="ltx_text ltx_font_typewriter">(</span><span id="lstnumberx91.18" class="ltx_text ltx_lst_identifier ltx_font_typewriter">s</span><span id="lstnumberx91.19" class="ltx_text ltx_font_typewriter">)}</span><span id="lstnumberx91.20" class="ltx_text ltx_lst_space ltx_font_typewriter">      </span><span id="lstnumberx91.21" class="ltx_text ltx_font_typewriter">#</span><span id="lstnumberx91.22" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx91.23" class="ltx_text ltx_lst_identifier ltx_font_typewriter">flatten</span>
</div>
