<span id="S2.T1.6.7.1.1.1" class="ltx_p">Lean (<span id="S2.T1.6.7.1.1.1.1" class="ltx_text ltx_font_typewriter">Float32</span>)</span>
</span></td>
<td id="S2.T1.6.7.2" class="ltx_td ltx_align_left ltx_align_top ltx_border_bb" style="padding:0.25pt 3.0pt;">
