</div>
<div id="lstnumberx10" class="ltx_listingline"><span id="lstnumberx10.1" class="ltx_text ltx_font_typewriter"><span id="lstnumberx10.1.1" class="ltx_text" style="--ltx-fg-color:#000000;--ltx-bg-color:#FFF5CC;">o</span><span id="lstnumberx10.1.2" class="ltx_text" style="--ltx-fg-color:#000000;">pt<span id="lstnumberx10.1.2.1" class="ltx_text ltx_lst_space"> </span>=<span id="lstnumberx10.1.2.2" class="ltx_text ltx_lst_space"> </span>torch.optim.SGD(model.parameters(),<span id="lstnumberx10.1.2.3" class="ltx_text ltx_lst_space"> </span>lr=0.2)</span></span>
</div>
