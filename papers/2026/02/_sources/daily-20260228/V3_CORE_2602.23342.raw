<td id="S5.F17.2.2.1" class="ltx_td ltx_align_center"><span id="S5.F17.2.2.1.1" class="ltx_text" style="font-size:90%;--ltx-fg-color:#000000;">(a) Mean I/Os</span></td>
<td id="S5.F17.2.2.2" class="ltx_td ltx_align_center"><span id="S5.F17.2.2.2.1" class="ltx_text" style="font-size:90%;--ltx-fg-color:#000000;">(b) Throughput</span></td></tr>
