<th id="S5.T4.4.1.1.4" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_r ltx_border_t"><span id="S5.T4.4.1.1.4.1" class="ltx_text" style="font-size:90%;">BigCode</span></th>
<th id="S5.T4.4.1.1.5" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_r ltx_border_t"><span id="S5.T4.4.1.1.5.1" class="ltx_text" style="font-size:90%;">DPR</span></th>
<th id="S5.T4.4.1.1.6" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_r ltx_border_t"><span id="S5.T4.4.1.1.6.1" class="ltx_text" style="font-size:90%;">MSMARCO</span></th></tr>
</thead>
<tbody class="ltx_tbody">
<tr id="S5.T4.4.1.2" class="ltx_tr">
<th id="S5.T4.4.1.2.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_l ltx_border_r ltx_border_tt"><span id="S5.T4.4.1.2.1.1" class="ltx_text" style="font-size:90%;">DiskANN</span></th>
<td id="S5.T4.4.1.2.2" class="ltx_td ltx_align_center ltx_border_r ltx_border_tt"><span id="S5.T4.4.1.2.2.1" class="ltx_text" style="font-size:90%;">22.8</span></td>
<td id="S5.T4.4.1.2.3" class="ltx_td ltx_align_center ltx_border_r ltx_border_tt"><span id="S5.T4.4.1.2.3.1" class="ltx_text" style="font-size:90%;">68.8</span></td>
<td id="S5.T4.4.1.2.4" class="ltx_td ltx_align_center ltx_border_r ltx_border_tt"><span id="S5.T4.4.1.2.4.1" class="ltx_text" style="font-size:90%;">51.7</span></td>
<td id="S5.T4.4.1.2.5" class="ltx_td ltx_align_center ltx_border_r ltx_border_tt"><span id="S5.T4.4.1.2.5.1" class="ltx_text" style="font-size:90%;">1,464.5</span></td>
<td id="S5.T4.4.1.2.6" class="ltx_td ltx_align_center ltx_border_r ltx_border_tt"><span id="S5.T4.4.1.2.6.1" class="ltx_text" style="font-size:90%;">1,532.4</span></td></tr>
<tr id="S5.T4.4.1.3" class="ltx_tr">
<th id="S5.T4.4.1.3.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_l ltx_border_r ltx_border_t"><span id="S5.T4.4.1.3.1.1" class="ltx_text" style="font-size:90%;">Starling</span></th>
<td id="S5.T4.4.1.3.2" class="ltx_td ltx_align_center ltx_border_r ltx_border_t"><span id="S5.T4.4.1.3.2.1" class="ltx_text" style="font-size:90%;">18.4</span></td>
