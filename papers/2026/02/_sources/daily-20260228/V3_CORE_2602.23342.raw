<td id="S5.T6.4.1.2.1" class="ltx_td ltx_align_center ltx_border_l ltx_border_r ltx_border_tt"><span id="S5.T6.4.1.2.1.1" class="ltx_text" style="font-size:90%;">DiskANN</span></td>
<td id="S5.T6.4.1.2.2" class="ltx_td ltx_align_center ltx_border_r ltx_border_tt"><span id="S5.T6.4.1.2.2.1" class="ltx_text" style="font-size:90%;">518MB</span></td>
<td id="S5.T6.4.1.2.3" class="ltx_td ltx_align_center ltx_border_r ltx_border_tt"><span id="S5.T6.4.1.2.3.1" class="ltx_text" style="font-size:90%;">5.0GB</span></td>
