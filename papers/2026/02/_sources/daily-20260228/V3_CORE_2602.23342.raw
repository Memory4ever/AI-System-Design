<td id="S5.F17.2.1.2" class="ltx_td ltx_align_center"><object type="image/svg+xml" data="2602.23342v1/quantization_qps_recall_comparison_v2.svg" id="S5.F17.g2" class="ltx_graphics ltx_img_landscape" style="aspect-ratio:215/134;" width="215" height="134"></object></td></tr>
