<td id="S5.F18.2.1.2" class="ltx_td ltx_align_center"><object type="image/svg+xml" data="2602.23342v1/GIST_latency_recall_top10_1ssd_v2_alayalaser.svg" id="S5.F18.g2" class="ltx_graphics ltx_img_landscape" style="aspect-ratio:215/141;" width="215" height="141"></object></td></tr>
