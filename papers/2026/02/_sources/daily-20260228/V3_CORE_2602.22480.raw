<td id="A1.T13.3.6.2" class="ltx_td ltx_align_center"><span id="A1.T13.3.6.2.1" class="ltx_text" style="font-size:90%;">19.54%</span></td>
<td id="A1.T13.3.6.3" class="ltx_td ltx_align_center"><span id="A1.T13.3.6.3.1" class="ltx_text" style="font-size:90%;">17/87</span></td>
<td id="A1.T13.3.6.4" class="ltx_td ltx_align_center"><span id="A1.T13.3.6.4.1" class="ltx_text" style="font-size:90%;">13.6</span></td>
<td id="A1.T13.3.6.5" class="ltx_td ltx_align_center"><span id="A1.T13.3.6.5.1" class="ltx_text" style="font-size:90%;">3</span></td></tr>
<tr id="A1.T13.3.7" class="ltx_tr">
<td id="A1.T13.3.7.1" class="ltx_td ltx_align_center ltx_border_bb"><span id="A1.T13.3.7.1.1" class="ltx_text" style="font-size:90%;">SimpleQA</span></td>
<td id="A1.T13.3.7.2" class="ltx_td ltx_align_center ltx_border_bb"><span id="A1.T13.3.7.2.1" class="ltx_text" style="font-size:90%;">68.89%</span></td>
<td id="A1.T13.3.7.3" class="ltx_td ltx_align_center ltx_border_bb"><span id="A1.T13.3.7.3.1" class="ltx_text" style="font-size:90%;">31/45</span></td>
