<td id="A1.T9.3.12.3" class="ltx_td ltx_align_left"><span id="A1.T9.3.12.3.1" class="ltx_text" style="font-size:90%;">12+</span></td></tr>
<tr id="A1.T9.3.13" class="ltx_tr">
