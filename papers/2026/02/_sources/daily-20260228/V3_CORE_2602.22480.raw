<td id="A1.T13.3.5.6" class="ltx_td ltx_align_center ltx_border_t"><span id="A1.T13.3.5.6.1" class="ltx_text" style="font-size:90%;">17</span></td></tr>
<tr id="A1.T13.3.6" class="ltx_tr">
