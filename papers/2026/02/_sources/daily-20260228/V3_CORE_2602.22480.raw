<td id="A1.T9.3.1.2" class="ltx_td ltx_align_left ltx_border_tt"><span id="A1.T9.3.1.2.1" class="ltx_text ltx_font_bold" style="font-size:90%;">Pawn (Minimal)</span></td>
<td id="A1.T9.3.1.3" class="ltx_td ltx_align_left ltx_border_tt"><span id="A1.T9.3.1.3.1" class="ltx_text ltx_font_bold" style="font-size:90%;">Knight (Sophisticated)</span></td></tr>
