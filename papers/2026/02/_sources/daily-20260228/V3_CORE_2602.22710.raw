<td id="S4.T3.2.4.4" class="ltx_td ltx_align_center"><math id="S4.T3.m3" class="ltx_Math" alttext="&lt;" display="inline" intent=":literal"><semantics><mo mathsize="0.900em">&lt;</mo><annotation encoding="application/x-tex">&lt;</annotation></semantics></math><span id="S4.T3.2.4.4.1" class="ltx_text" style="font-size:90%;">.001<sup id="S4.T3.2.4.4.1.1" class="ltx_sup">b</sup></span></td></tr>
<tr id="S4.T3.2.5" class="ltx_tr">
<td id="S4.T3.2.5.1" class="ltx_td ltx_align_left"><span id="S4.T3.2.5.1.1" class="ltx_text" style="font-size:90%;">Difficulty rating</span></td>
<td id="S4.T3.2.5.2" class="ltx_td ltx_align_center"><span id="S4.T3.2.5.2.1" class="ltx_text" style="font-size:90%;">2.45 (0.90)</span></td>
<td id="S4.T3.2.5.3" class="ltx_td ltx_align_center"><span id="S4.T3.2.5.3.1" class="ltx_text" style="font-size:90%;">2.50 (0.96)</span></td>
<td id="S4.T3.2.5.4" class="ltx_td ltx_align_center"><span id="S4.T3.2.5.4.1" class="ltx_text" style="font-size:90%;">.868<sup id="S4.T3.2.5.4.1.1" class="ltx_sup">b</sup></span></td></tr>
