<td id="S4.T5.2.6.1" class="ltx_td ltx_align_left" colspan="4"><span id="S4.T5.2.6.1.1" class="ltx_text ltx_font_italic" style="font-size:80%;">PRISM vs. External Annotators</span></td></tr>
