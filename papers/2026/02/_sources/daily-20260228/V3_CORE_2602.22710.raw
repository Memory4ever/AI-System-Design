<td id="S4.T2.2.6.1" class="ltx_td ltx_align_left"><span id="S4.T2.2.6.1.1" class="ltx_text" style="font-size:90%;">Trial number (<math id="S4.T2.m11" class="ltx_Math" alttext="z" display="inline" intent=":literal"><semantics><mi>z</mi><annotation encoding="application/x-tex">z</annotation></semantics></math>)</span></td>
<td id="S4.T2.2.6.2" class="ltx_td ltx_align_right"><span id="S4.T2.2.6.2.1" class="ltx_text" style="font-size:90%;">0.03</span></td>
<td id="S4.T2.2.6.3" class="ltx_td ltx_align_center"><math id="S4.T2.m12" class="ltx_Math" alttext="[-1.02,1.07]" display="inline" intent=":literal"><semantics><mrow><mo maxsize="0.900em" minsize="0.900em">[</mo><mrow><mrow><mo mathsize="0.900em">−</mo><mn mathsize="0.900em">1.02</mn></mrow><mo mathsize="0.900em">,</mo><mn mathsize="0.900em">1.07</mn></mrow><mo maxsize="0.900em" minsize="0.900em">]</mo></mrow><annotation encoding="application/x-tex">[-1.02,1.07]</annotation></semantics></math></td>
<td id="S4.T2.2.6.4" class="ltx_td ltx_nopad_r ltx_align_left"><span id="S4.T2.2.6.4.1" class="ltx_text" style="font-size:90%;">.960</span></td></tr>
<tr id="S4.T2.2.7" class="ltx_tr">
<td id="S4.T2.2.7.1" class="ltx_td ltx_align_left"><span id="S4.T2.2.7.1.1" class="ltx_text" style="font-size:90%;">Presented first <math id="S4.T2.m13" class="ltx_Math" alttext="\times" display="inline" intent=":literal"><semantics><mo>×</mo><annotation encoding="application/x-tex">\times</annotation></semantics></math> Modality</span></td>
<td id="S4.T2.2.7.2" class="ltx_td ltx_align_right"><math id="S4.T2.m14" class="ltx_Math" alttext="-" display="inline" intent=":literal"><semantics><mo mathsize="0.900em">−</mo><annotation encoding="application/x-tex">-</annotation></semantics></math><span id="S4.T2.2.7.2.1" class="ltx_text" style="font-size:90%;">0.51</span></td>
<td id="S4.T2.2.7.3" class="ltx_td ltx_align_center"><math id="S4.T2.m15" class="ltx_Math" alttext="[-3.42,2.40]" display="inline" intent=":literal"><semantics><mrow><mo maxsize="0.900em" minsize="0.900em">[</mo><mrow><mrow><mo mathsize="0.900em">−</mo><mn mathsize="0.900em">3.42</mn></mrow><mo mathsize="0.900em">,</mo><mn mathsize="0.900em">2.40</mn></mrow><mo maxsize="0.900em" minsize="0.900em">]</mo></mrow><annotation encoding="application/x-tex">[-3.42,2.40]</annotation></semantics></math></td>
<td id="S4.T2.2.7.4" class="ltx_td ltx_nopad_r ltx_align_left"><span id="S4.T2.2.7.4.1" class="ltx_text" style="font-size:90%;">.732</span></td></tr>
<tr id="S4.T2.2.8" class="ltx_tr">
<td id="S4.T2.2.8.1" class="ltx_td ltx_align_left"><span id="S4.T2.2.8.1.1" class="ltx_text" style="font-size:90%;">Modality <math id="S4.T2.m16" class="ltx_Math" alttext="\times" display="inline" intent=":literal"><semantics><mo>×</mo><annotation encoding="application/x-tex">\times</annotation></semantics></math> Char. length</span></td>
<td id="S4.T2.2.8.2" class="ltx_td ltx_align_right"><span id="S4.T2.2.8.2.1" class="ltx_text" style="font-size:90%;">1.53</span></td>
<td id="S4.T2.2.8.3" class="ltx_td ltx_align_center"><math id="S4.T2.m17" class="ltx_Math" alttext="[0.03,3.02]" display="inline" intent=":literal"><semantics><mrow><mo maxsize="0.900em" minsize="0.900em">[</mo><mn mathsize="0.900em">0.03</mn><mo mathsize="0.900em">,</mo><mn mathsize="0.900em">3.02</mn><mo maxsize="0.900em" minsize="0.900em">]</mo></mrow><annotation encoding="application/x-tex">[0.03,3.02]</annotation></semantics></math></td>
<td id="S4.T2.2.8.4" class="ltx_td ltx_nopad_r ltx_align_left"><span id="S4.T2.2.8.4.1" class="ltx_text" style="font-size:90%;">.045</span></td></tr>
<tr id="S4.T2.2.9" class="ltx_tr">
<td id="S4.T2.2.9.1" class="ltx_td ltx_align_left ltx_border_bb"><span id="S4.T2.2.9.1.1" class="ltx_text" style="font-size:90%;">Modality <math id="S4.T2.m18" class="ltx_Math" alttext="\times" display="inline" intent=":literal"><semantics><mo>×</mo><annotation encoding="application/x-tex">\times</annotation></semantics></math> Trial number</span></td>
<td id="S4.T2.2.9.2" class="ltx_td ltx_align_right ltx_border_bb"><span id="S4.T2.2.9.2.1" class="ltx_text" style="font-size:90%;">0.90</span></td>
<td id="S4.T2.2.9.3" class="ltx_td ltx_align_center ltx_border_bb"><math id="S4.T2.m19" class="ltx_Math" alttext="[-0.59,2.39]" display="inline" intent=":literal"><semantics><mrow><mo maxsize="0.900em" minsize="0.900em">[</mo><mrow><mrow><mo mathsize="0.900em">−</mo><mn mathsize="0.900em">0.59</mn></mrow><mo mathsize="0.900em">,</mo><mn mathsize="0.900em">2.39</mn></mrow><mo maxsize="0.900em" minsize="0.900em">]</mo></mrow><annotation encoding="application/x-tex">[-0.59,2.39]</annotation></semantics></math></td>
<td id="S4.T2.2.9.4" class="ltx_td ltx_nopad_r ltx_align_left ltx_border_bb"><span id="S4.T2.2.9.4.1" class="ltx_text" style="font-size:90%;">.236</span></td></tr>
</tbody>
</table></div><div class="ltx_flex_break"></div><div class="ltx_flex_cell ltx_flex_size_1">
<p id="S4.T2.3" class="ltx_p ltx_align_left ltx_figure_panel"><span id="S4.T2.3.1" class="ltx_text ltx_font_italic" style="font-size:80%;">Note.<span id="S4.T2.3.1.1" class="ltx_text ltx_font_upright"> Reference level for modality is audio.</span></span></p></div></div>
</figure>
<div id="S4.SS1.p3" class="ltx_para ltx_noindent">
<p id="S4.SS1.p3.1" class="ltx_p"><span id="S4.SS1.p3.1.1" class="ltx_text ltx_font_bold">Stimulus Length.</span> Modality significantly moderated the effect of stimulus length (<math id="S4.SS1.p3.m1" class="ltx_Math" alttext="b=1.53" display="inline" intent=":literal"><semantics><mrow><mi>b</mi><mo>=</mo><mn>1.53</mn></mrow><annotation encoding="application/x-tex">b=1.53</annotation></semantics></math>, 95% CI <math id="S4.SS1.p3.m2" class="ltx_Math" alttext="[0.03,3.02]" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">[</mo><mn>0.03</mn><mo>,</mo><mn>3.02</mn><mo stretchy="false">]</mo></mrow><annotation encoding="application/x-tex">[0.03,3.02]</annotation></semantics></math>, <math id="S4.SS1.p3.m3" class="ltx_Math" alttext="p=.045" display="inline" intent=":literal"><semantics><mrow><mi>p</mi><mo>=</mo><mn>.045</mn></mrow><annotation encoding="application/x-tex">p=.045</annotation></semantics></math>). Longer responses predicted higher ratings in both modalities, but the effect was somewhat stronger for text (text: <math id="S4.SS1.p3.m4" class="ltx_Math" alttext="b=4.92" display="inline" intent=":literal"><semantics><mrow><mi>b</mi><mo>=</mo><mn>4.92</mn></mrow><annotation encoding="application/x-tex">b=4.92</annotation></semantics></math>, 95% CI <math id="S4.SS1.p3.m5" class="ltx_Math" alttext="[2.65,7.18]" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">[</mo><mn>2.65</mn><mo>,</mo><mn>7.18</mn><mo stretchy="false">]</mo></mrow><annotation encoding="application/x-tex">[2.65,7.18]</annotation></semantics></math>, <math id="S4.SS1.p3.m6" class="ltx_Math" alttext="p&lt;.001" display="inline" intent=":literal"><semantics><mrow><mi>p</mi><mo>&lt;</mo><mn>.001</mn></mrow><annotation encoding="application/x-tex">p&lt;.001</annotation></semantics></math>; audio: <math id="S4.SS1.p3.m7" class="ltx_Math" alttext="b=3.52" display="inline" intent=":literal"><semantics><mrow><mi>b</mi><mo>=</mo><mn>3.52</mn></mrow><annotation encoding="application/x-tex">b=3.52</annotation></semantics></math>, 95% CI <math id="S4.SS1.p3.m8" class="ltx_Math" alttext="[1.16,5.88]" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">[</mo><mn>1.16</mn><mo>,</mo><mn>5.88</mn><mo stretchy="false">]</mo></mrow><annotation encoding="application/x-tex">[1.16,5.88]</annotation></semantics></math>, <math id="S4.SS1.p3.m9" class="ltx_Math" alttext="p=.004" display="inline" intent=":literal"><semantics><mrow><mi>p</mi><mo>=</mo><mn>.004</mn></mrow><annotation encoding="application/x-tex">p=.004</annotation></semantics></math>).</p>
</div>
<div id="S4.SS1.p4" class="ltx_para ltx_noindent">
<p id="S4.SS1.p4.1" class="ltx_p"><span id="S4.SS1.p4.1.1" class="ltx_text ltx_font_bold">Order Effects.</span> A significant recency bias emerged, with second-presented items rated more favorably (<math id="S4.SS1.p4.m1" class="ltx_Math" alttext="b=-2.61" display="inline" intent=":literal"><semantics><mrow><mi>b</mi><mo>=</mo><mrow><mo>−</mo><mn>2.61</mn></mrow></mrow><annotation encoding="application/x-tex">b=-2.61</annotation></semantics></math>, 95% CI <math id="S4.SS1.p4.m2" class="ltx_Math" alttext="[-4.65,-0.58]" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">[</mo><mrow><mrow><mo>−</mo><mn>4.65</mn></mrow><mo>,</mo><mrow><mo>−</mo><mn>0.58</mn></mrow></mrow><mo stretchy="false">]</mo></mrow><annotation encoding="application/x-tex">[-4.65,-0.58]</annotation></semantics></math>, <math id="S4.SS1.p4.m3" class="ltx_Math" alttext="p=.012" display="inline" intent=":literal"><semantics><mrow><mi>p</mi><mo>=</mo><mn>.012</mn></mrow><annotation encoding="application/x-tex">p=.012</annotation></semantics></math>). There was no evidence that this effect differed by modality (<math id="S4.SS1.p4.m4" class="ltx_Math" alttext="b=-0.51" display="inline" intent=":literal"><semantics><mrow><mi>b</mi><mo>=</mo><mrow><mo>−</mo><mn>0.51</mn></mrow></mrow><annotation encoding="application/x-tex">b=-0.51</annotation></semantics></math>, 95% CI <math id="S4.SS1.p4.m5" class="ltx_Math" alttext="[-3.42,2.40]" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">[</mo><mrow><mrow><mo>−</mo><mn>3.42</mn></mrow><mo>,</mo><mn>2.40</mn></mrow><mo stretchy="false">]</mo></mrow><annotation encoding="application/x-tex">[-3.42,2.40]</annotation></semantics></math>, <math id="S4.SS1.p4.m6" class="ltx_Math" alttext="p=.732" display="inline" intent=":literal"><semantics><mrow><mi>p</mi><mo>=</mo><mn>.732</mn></mrow><annotation encoding="application/x-tex">p=.732</annotation></semantics></math>).</p>
</div>
<div id="S4.SS1.p5" class="ltx_para ltx_noindent">
<p id="S4.SS1.p5.1" class="ltx_p"><span id="S4.SS1.p5.1.1" class="ltx_text ltx_font_bold">Fatigue Effects.</span> Ratings remained stable across trials (<math id="S4.SS1.p5.m1" class="ltx_Math" alttext="b=0.03" display="inline" intent=":literal"><semantics><mrow><mi>b</mi><mo>=</mo><mn>0.03</mn></mrow><annotation encoding="application/x-tex">b=0.03</annotation></semantics></math>, 95% CI <math id="S4.SS1.p5.m2" class="ltx_Math" alttext="[-1.02,1.07]" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">[</mo><mrow><mrow><mo>−</mo><mn>1.02</mn></mrow><mo>,</mo><mn>1.07</mn></mrow><mo stretchy="false">]</mo></mrow><annotation encoding="application/x-tex">[-1.02,1.07]</annotation></semantics></math>, <math id="S4.SS1.p5.m3" class="ltx_Math" alttext="p=.960" display="inline" intent=":literal"><semantics><mrow><mi>p</mi><mo>=</mo><mn>.960</mn></mrow><annotation encoding="application/x-tex">p=.960</annotation></semantics></math>), with no evidence of modality-specific drift (<math id="S4.SS1.p5.m4" class="ltx_Math" alttext="b=0.90" display="inline" intent=":literal"><semantics><mrow><mi>b</mi><mo>=</mo><mn>0.90</mn></mrow><annotation encoding="application/x-tex">b=0.90</annotation></semantics></math>, 95% CI <math id="S4.SS1.p5.m5" class="ltx_Math" alttext="[-0.59,2.39]" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">[</mo><mrow><mrow><mo>−</mo><mn>0.59</mn></mrow><mo>,</mo><mn>2.39</mn></mrow><mo stretchy="false">]</mo></mrow><annotation encoding="application/x-tex">[-0.59,2.39]</annotation></semantics></math>, <math id="S4.SS1.p5.m6" class="ltx_Math" alttext="p=.236" display="inline" intent=":literal"><semantics><mrow><mi>p</mi><mo>=</mo><mn>.236</mn></mrow><annotation encoding="application/x-tex">p=.236</annotation></semantics></math>).</p>
</div>
<div id="S4.SS1.p6" class="ltx_para ltx_noindent">
<p id="S4.SS1.p6.1" class="ltx_p"><span id="S4.SS1.p6.1.1" class="ltx_text ltx_font_bold">Practice Effects.</span> In a separate model predicting log-transformed trial duration, completion times decreased significantly over trials in both modalities (audio: <math id="S4.SS1.p6.m1" class="ltx_Math" alttext="b=-0.09" display="inline" intent=":literal"><semantics><mrow><mi>b</mi><mo>=</mo><mrow><mo>−</mo><mn>0.09</mn></mrow></mrow><annotation encoding="application/x-tex">b=-0.09</annotation></semantics></math>, 95% CI <math id="S4.SS1.p6.m2" class="ltx_Math" alttext="[-0.12,-0.06]" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">[</mo><mrow><mrow><mo>−</mo><mn>0.12</mn></mrow><mo>,</mo><mrow><mo>−</mo><mn>0.06</mn></mrow></mrow><mo stretchy="false">]</mo></mrow><annotation encoding="application/x-tex">[-0.12,-0.06]</annotation></semantics></math>, <math id="S4.SS1.p6.m3" class="ltx_Math" alttext="p&lt;.001" display="inline" intent=":literal"><semantics><mrow><mi>p</mi><mo>&lt;</mo><mn>.001</mn></mrow><annotation encoding="application/x-tex">p&lt;.001</annotation></semantics></math>; text: <math id="S4.SS1.p6.m4" class="ltx_Math" alttext="b=-0.17" display="inline" intent=":literal"><semantics><mrow><mi>b</mi><mo>=</mo><mrow><mo>−</mo><mn>0.17</mn></mrow></mrow><annotation encoding="application/x-tex">b=-0.17</annotation></semantics></math>, 95% CI <math id="S4.SS1.p6.m5" class="ltx_Math" alttext="[-0.21,-0.13]" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">[</mo><mrow><mrow><mo>−</mo><mn>0.21</mn></mrow><mo>,</mo><mrow><mo>−</mo><mn>0.13</mn></mrow></mrow><mo stretchy="false">]</mo></mrow><annotation encoding="application/x-tex">[-0.21,-0.13]</annotation></semantics></math>, <math id="S4.SS1.p6.m6" class="ltx_Math" alttext="p&lt;.001" display="inline" intent=":literal"><semantics><mrow><mi>p</mi><mo>&lt;</mo><mn>.001</mn></mrow><annotation encoding="application/x-tex">p&lt;.001</annotation></semantics></math>), corresponding to approximately 8.6% and 16.0% reductions per standard deviation of trial number, respectively. Consistent with the experimental design, text participants sped up significantly more than audio participants (<math id="S4.SS1.p6.m7" class="ltx_Math" alttext="b=-0.10" display="inline" intent=":literal"><semantics><mrow><mi>b</mi><mo>=</mo><mrow><mo>−</mo><mn>0.10</mn></mrow></mrow><annotation encoding="application/x-tex">b=-0.10</annotation></semantics></math>, 95% CI <math id="S4.SS1.p6.m8" class="ltx_Math" alttext="[-0.14,-0.05]" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">[</mo><mrow><mrow><mo>−</mo><mn>0.14</mn></mrow><mo>,</mo><mrow><mo>−</mo><mn>0.05</mn></mrow></mrow><mo stretchy="false">]</mo></mrow><annotation encoding="application/x-tex">[-0.14,-0.05]</annotation></semantics></math>, <math id="S4.SS1.p6.m9" class="ltx_Math" alttext="p&lt;.001" display="inline" intent=":literal"><semantics><mrow><mi>p</mi><mo>&lt;</mo><mn>.001</mn></mrow><annotation encoding="application/x-tex">p&lt;.001</annotation></semantics></math>). Despite these speedups, ratings remained stable across trials (see Fatigue Effects), suggesting increased efficiency rather than declining effort.</p>
</div>
</section>
<section id="S4.SS2" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">4.2 </span>Reliability of Audio Preference Data</h3>

<div id="S4.SS2.p1" class="ltx_para">
<p id="S4.SS2.p1.1" class="ltx_p"><span id="S4.SS2.p1.1.1" class="ltx_text ltx_font_bold">Session Characteristics.</span> Table <a href="#S4.T3" title="Table 3 ‣ 4.2 Reliability of Audio Preference Data ‣ 4 Results ‣ Same Words, Different Judgments:Modality Effects on Preference Alignment" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3</span></a> summarizes session characteristics. Audio trials took nearly twice as long as text trials (<math id="S4.SS2.p1.m1" class="ltx_Math" alttext="M=136" display="inline" intent=":literal"><semantics><mrow><mi>M</mi><mo>=</mo><mn>136</mn></mrow><annotation encoding="application/x-tex">M=136</annotation></semantics></math> vs. 79 sec; <math id="S4.SS2.p1.m2" class="ltx_Math" alttext="U=255.0" display="inline" intent=":literal"><semantics><mrow><mi>U</mi><mo>=</mo><mn>255.0</mn></mrow><annotation encoding="application/x-tex">U=255.0</annotation></semantics></math>, <math id="S4.SS2.p1.m3" class="ltx_Math" alttext="p&lt;.001" display="inline" intent=":literal"><semantics><mrow><mi>p</mi><mo>&lt;</mo><mn>.001</mn></mrow><annotation encoding="application/x-tex">p&lt;.001</annotation></semantics></math>). Attention check failure rates did not differ significantly between conditions (Audio: 13.2%; Text: 9.4%; Fisher’s exact test, <math id="S4.SS2.p1.m4" class="ltx_Math" alttext="p=.761" display="inline" intent=":literal"><semantics><mrow><mi>p</mi><mo>=</mo><mn>.761</mn></mrow><annotation encoding="application/x-tex">p=.761</annotation></semantics></math>), and participants rated both tasks as similarly difficult (<math id="S4.SS2.p1.m5" class="ltx_Math" alttext="U=992.0" display="inline" intent=":literal"><semantics><mrow><mi>U</mi><mo>=</mo><mn>992.0</mn></mrow><annotation encoding="application/x-tex">U=992.0</annotation></semantics></math>, <math id="S4.SS2.p1.m6" class="ltx_Math" alttext="p=.868" display="inline" intent=":literal"><semantics><mrow><mi>p</mi><mo>=</mo><mn>.868</mn></mrow><annotation encoding="application/x-tex">p=.868</annotation></semantics></math>).</p>
</div>
<figure id="S4.T3" class="ltx_table">
<figcaption class="ltx_caption"><span class="ltx_tag ltx_tag_table">Table 3: </span>Session and Trial Characteristics by Condition</figcaption>
<table id="S4.T3.2" class="ltx_tabular ltx_centering ltx_align_middle">
<tbody class="ltx_tbody">
<tr id="S4.T3.2.1" class="ltx_tr">
<td id="S4.T3.2.1.1" class="ltx_td ltx_border_t"></td>
<td id="S4.T3.2.1.2" class="ltx_td ltx_align_center ltx_border_t"><span id="S4.T3.2.1.2.1" class="ltx_text ltx_font_bold" style="font-size:90%;">Text</span></td>
<td id="S4.T3.2.1.3" class="ltx_td ltx_align_center ltx_border_t"><span id="S4.T3.2.1.3.1" class="ltx_text ltx_font_bold" style="font-size:90%;">Audio</span></td>
<td id="S4.T3.2.1.4" class="ltx_td ltx_align_center ltx_border_t"><math id="S4.T3.m1" class="ltx_Math" alttext="p" display="inline" intent=":literal"><semantics><mi mathsize="0.900em">p</mi><annotation encoding="application/x-tex">p</annotation></semantics></math></td></tr>
<tr id="S4.T3.2.2" class="ltx_tr">
<td id="S4.T3.2.2.1" class="ltx_td ltx_align_left ltx_border_t"><span id="S4.T3.2.2.1.1" class="ltx_text" style="font-size:90%;">Completed (%)</span></td>
<td id="S4.T3.2.2.2" class="ltx_td ltx_align_center ltx_border_t"><span id="S4.T3.2.2.2.1" class="ltx_text" style="font-size:90%;">92.5</span></td>
<td id="S4.T3.2.2.3" class="ltx_td ltx_align_center ltx_border_t"><span id="S4.T3.2.2.3.1" class="ltx_text" style="font-size:90%;">96.2</span></td>
<td id="S4.T3.2.2.4" class="ltx_td ltx_align_center ltx_border_t"><span id="S4.T3.2.2.4.1" class="ltx_text" style="font-size:90%;">.678<sup id="S4.T3.2.2.4.1.1" class="ltx_sup">a</sup></span></td></tr>
<tr id="S4.T3.2.3" class="ltx_tr">
<td id="S4.T3.2.3.1" class="ltx_td ltx_align_left"><span id="S4.T3.2.3.1.1" class="ltx_text" style="font-size:90%;">Session duration, min</span></td>
<td id="S4.T3.2.3.2" class="ltx_td ltx_align_center"><span id="S4.T3.2.3.2.1" class="ltx_text" style="font-size:90%;">27.0 (13.3)</span></td>
<td id="S4.T3.2.3.3" class="ltx_td ltx_align_center"><span id="S4.T3.2.3.3.1" class="ltx_text" style="font-size:90%;">47.3 (12.4)</span></td>
<td id="S4.T3.2.3.4" class="ltx_td ltx_align_center"><math id="S4.T3.m2" class="ltx_Math" alttext="&lt;" display="inline" intent=":literal"><semantics><mo mathsize="0.900em">&lt;</mo><annotation encoding="application/x-tex">&lt;</annotation></semantics></math><span id="S4.T3.2.3.4.1" class="ltx_text" style="font-size:90%;">.001<sup id="S4.T3.2.3.4.1.1" class="ltx_sup">b</sup></span></td></tr>
<tr id="S4.T3.2.4" class="ltx_tr">
<td id="S4.T3.2.4.1" class="ltx_td ltx_align_left"><span id="S4.T3.2.4.1.1" class="ltx_text" style="font-size:90%;">Trial duration, sec</span></td>
