</span></td>
<td id="S4.T1.5.1.1.2" class="ltx_td ltx_align_left ltx_align_top ltx_border_tt">
<span id="S4.T1.5.1.1.2.1" class="ltx_inline-block ltx_align_top" style="width:42.7pt;">
<span id="S4.T1.5.1.1.2.1.1" class="ltx_p"><span id="S4.T1.5.1.1.2.1.1.1" class="ltx_text ltx_font_bold">Method</span></span>
</span></td>
<td id="S4.T1.5.1.1.3" class="ltx_td ltx_align_left ltx_align_top ltx_border_tt">
<span id="S4.T1.5.1.1.3.1" class="ltx_inline-block ltx_align_top" style="width:79.7pt;">
<span id="S4.T1.5.1.1.3.1.1" class="ltx_p"><span id="S4.T1.5.1.1.3.1.1.1" class="ltx_text ltx_font_bold">Accuracy</span></span>
