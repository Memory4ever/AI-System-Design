            <span id="alg1.l9.3" class="ltx_text" style="font-size:80%;">      </span><math id="alg1.l9.m1" class="ltx_Math" alttext="S_{i}\leftarrow\mathbf{T}" display="inline" intent=":literal"><semantics><mrow><msub><mi mathsize="0.800em">S</mi><mi mathsize="0.800em">i</mi></msub><mo mathsize="0.800em" stretchy="false">←</mo><mi mathsize="0.800em">𝐓</mi></mrow><annotation encoding="application/x-tex">S_{i}\leftarrow\mathbf{T}</annotation></semantics></math><span id="alg1.l9.4" class="ltx_text" style="font-size:80%;">
</span>
