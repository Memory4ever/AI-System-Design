<td id="A2.T4.5.5.5" class="ltx_td ltx_align_center">75.45<span id="A2.T4.5.5.5.1" class="ltx_text" style="--ltx-fg-color:#FF0000;">(<math id="A2.T4.m2" class="ltx_Math" alttext="\times" display="inline" intent=":literal"><semantics><mo style="--ltx-fg-color:#FF0000;" mathcolor="#FF0000">×</mo><annotation encoding="application/x-tex">\times</annotation></semantics></math>3.40)</span></td></tr>
