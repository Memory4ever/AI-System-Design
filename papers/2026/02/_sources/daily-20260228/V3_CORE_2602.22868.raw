<td id="S4.T1.5.1.1.1" class="ltx_td ltx_nopad_l ltx_align_left ltx_align_top ltx_border_tt"><span class="ltx_rule" style="width:0.0pt;--ltx-bg-color:black;display:inline-block;"></span>  
