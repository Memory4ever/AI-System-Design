<td id="A2.T4.5.6.5" class="ltx_td ltx_align_center">102.72<span id="A2.T4.5.6.5.1" class="ltx_text" style="--ltx-fg-color:#FF0000;">(<math id="A2.T4.m3" class="ltx_Math" alttext="\times" display="inline" intent=":literal"><semantics><mo style="--ltx-fg-color:#FF0000;" mathcolor="#FF0000">×</mo><annotation encoding="application/x-tex">\times</annotation></semantics></math>4.63)</span></td></tr>
