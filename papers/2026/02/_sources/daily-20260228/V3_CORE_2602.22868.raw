            <span id="alg1.l2.3" class="ltx_text" style="font-size:80%;">Initialize </span><math id="alg1.l2.m1" class="ltx_Math" alttext="S\leftarrow[\mathbf{M},\ldots,\mathbf{M}]" display="inline" intent=":literal"><semantics><mrow><mi mathsize="0.800em">S</mi><mo mathsize="0.800em" stretchy="false">←</mo><mrow><mo maxsize="0.800em" minsize="0.800em">[</mo><mrow><mi mathsize="0.800em">𝐌</mi><mo mathsize="0.800em">,</mo><mi mathsize="0.800em" mathvariant="normal">…</mi><mo mathsize="0.800em">,</mo><mi mathsize="0.800em">𝐌</mi></mrow><mo maxsize="0.800em" minsize="0.800em">]</mo></mrow></mrow><annotation encoding="application/x-tex">S\leftarrow[\mathbf{M},\ldots,\mathbf{M}]</annotation></semantics></math><span id="alg1.l2.4" class="ltx_text" style="font-size:80%;"> (State tracker)
