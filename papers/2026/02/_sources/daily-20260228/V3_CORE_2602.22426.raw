<tr id="A6.T8.4.1.7" class="ltx_tr">
<th id="A6.T8.4.1.7.1" class="ltx_td ltx_align_left ltx_th ltx_th_row">Learning Rate</th>
<td id="A6.T8.4.1.7.2" class="ltx_td ltx_align_center"><math id="A6.T8.m1" class="ltx_Math" alttext="1\times 10^{-6}" display="inline" intent=":literal"><semantics><mrow><mn>1</mn><mo lspace="0.222em" rspace="0.222em">×</mo><msup><mn>10</mn><mrow><mo>−</mo><mn>6</mn></mrow></msup></mrow><annotation encoding="application/x-tex">1\times 10^{-6}</annotation></semantics></math></td></tr>
<tr id="A6.T8.4.1.8" class="ltx_tr">
