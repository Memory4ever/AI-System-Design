<td id="A6.T8.4.1.1.2" class="ltx_td ltx_align_center ltx_border_tt"><span id="A6.T8.4.1.1.2.1" class="ltx_text ltx_font_bold">Configuration</span></td></tr>
<tr id="A6.T8.4.1.2" class="ltx_tr">
