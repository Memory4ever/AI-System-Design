{"data":{"id":"10.48550/arxiv.2602.16356","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.16356","prefix":"10.48550","suffix":"arxiv.2602.16356","identifiers":[{"identifier":"2602.16356","identifierType":"arXiv"}],"alternateIdentifiers":[{"alternateIdentifierType":"arXiv","alternateIdentifier":"2602.16356"}],"creators":[{"name":"Büchner, Martin","nameType":"Personal","givenName":"Martin","familyName":"Büchner","affiliation":[],"nameIdentifiers":[]},{"name":"Röfer, Adrian","nameType":"Personal","givenName":"Adrian","familyName":"Röfer","affiliation":[],"nameIdentifiers":[]},{"name":"Engelbracht, Tim","nameType":"Personal","givenName":"Tim","familyName":"Engelbracht","affiliation":[],"nameIdentifiers":[]},{"name":"Welschehold, Tim","nameType":"Personal","givenName":"Tim","familyName":"Welschehold","affiliation":[],"nameIdentifiers":[]},{"name":"Bauer, Zuria","nameType":"Personal","givenName":"Zuria","familyName":"Bauer","affiliation":[],"nameIdentifiers":[]},{"name":"Blum, Hermann","nameType":"Personal","givenName":"Hermann","familyName":"Blum","affiliation":[],"nameIdentifiers":[]},{"name":"Pollefeys, Marc","nameType":"Personal","givenName":"Marc","familyName":"Pollefeys","affiliation":[],"nameIdentifiers":[]},{"name":"Valada, Abhinav","nameType":"Personal","givenName":"Abhinav","familyName":"Valada","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Articulated 3D Scene Graphs for Open-World Mobile Manipulation"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"lang":"en","subject":"Robotics (cs.RO)","subjectScheme":"arXiv"},{"lang":"en","subject":"Artificial Intelligence (cs.AI)","subjectScheme":"arXiv"},{"lang":"en","subject":"Computer Vision and Pattern Recognition (cs.CV)","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"FOS: Computer and information sciences","schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-18T10:40:35Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-19T01:34:02Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"ris":"GEN","bibtex":"misc","citeproc":"article","schemaOrg":"CreativeWork","resourceType":"Article","resourceTypeGeneral":"Preprint"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rights":"arXiv.org perpetual, non-exclusive license","rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/"}],"descriptions":[{"description":"Semantics has enabled 3D scene understanding and affordance-driven object interaction. However, robots operating in real-world environments face a critical limitation: they cannot anticipate how objects move. Long-horizon mobile manipulation requires closing the gap between semantics, geometry, and kinematics. In this work, we present MoMa-SG, a novel framework for building semantic-kinematic 3D scene graphs of articulated scenes containing a myriad of interactable objects. Given RGB-D sequences containing multiple object articulations, we temporally segment object interactions and infer object motion using occlusion-robust point tracking. We then lift point trajectories into 3D and estimate articulation models using a novel unified twist estimation formulation that robustly estimates revolute and prismatic joint parameters in a single optimization pass. Next, we associate objects with estimated articulations and detect contained objects by reasoning over parent-child relations at identified opening states. We also introduce the novel Arti4D-Semantic dataset, which uniquely combines hierarchical object semantics including parent-child relation labels with object axis annotations across 62 in-the-wild RGB-D sequences containing 600 object interactions and three distinct observation paradigms. We extensively evaluate the performance of MoMa-SG on two datasets and ablate key design choices of our approach. In addition, real-world experiments on both a quadruped and a mobile manipulator demonstrate that our semantic-kinematic scene graphs enable robust manipulation of articulated objects in everyday home environments. We provide code and data at: https://momasg.cs.uni-freiburg.de.","descriptionType":"Abstract"}],"geoLocations":[],"fundingReferences":[],"xml":"","url":"https://arxiv.org/abs/2602.16356","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"viewsOverTime":[],"downloadCount":0,"downloadsOverTime":[],"referenceCount":0,"citationCount":0,"citationsOverTime":[],"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-19T02:44:13.000Z","registered":"2026-02-19T02:44:14.000Z","published":"2026","updated":"2026-02-19T02:44:14.000Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}},"provider":{"data":{"id":"arxiv","type":"providers"}},"media":{"data":{"id":"10.48550/arxiv.2602.16356","type":"media"}},"references":{"data":[]},"citations":{"data":[]},"parts":{"data":[]},"partOf":{"data":[]},"versions":{"data":[]},"versionOf":{"data":[]}}}}