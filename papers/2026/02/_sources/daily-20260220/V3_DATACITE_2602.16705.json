{"data":{"id":"10.48550/arxiv.2602.16705","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.16705","prefix":"10.48550","suffix":"arxiv.2602.16705","identifiers":[{"identifier":"2602.16705","identifierType":"arXiv"}],"alternateIdentifiers":[{"alternateIdentifierType":"arXiv","alternateIdentifier":"2602.16705"}],"creators":[{"name":"Dong, Runpei","nameType":"Personal","givenName":"Runpei","familyName":"Dong","affiliation":[],"nameIdentifiers":[]},{"name":"Li, Ziyan","nameType":"Personal","givenName":"Ziyan","familyName":"Li","affiliation":[],"nameIdentifiers":[]},{"name":"Gupta, Arjun","nameType":"Personal","givenName":"Arjun","familyName":"Gupta","affiliation":[],"nameIdentifiers":[]},{"name":"He, Xialin","nameType":"Personal","givenName":"Xialin","familyName":"He","affiliation":[],"nameIdentifiers":[]},{"name":"Gupta, Saurabh","nameType":"Personal","givenName":"Saurabh","familyName":"Gupta","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"HERO: Learning Humanoid End-Effector Control for Visual Whole-Body Open-Vocabulary Object Grasping"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"lang":"en","subject":"Robotics (cs.RO)","subjectScheme":"arXiv"},{"lang":"en","subject":"Computer Vision and Pattern Recognition (cs.CV)","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"FOS: Computer and information sciences","schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-18T18:55:02Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-19T01:55:24Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02-24T06:15:16Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-02-25T01:25:27Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-06-03T22:09:00Z","dateType":"Submitted","dateInformation":"v3"},{"date":"2026-06-05T00:15:53Z","dateType":"Updated","dateInformation":"v3"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"ris":"GEN","bibtex":"misc","citeproc":"article","schemaOrg":"CreativeWork","resourceType":"Article","resourceTypeGeneral":"Preprint"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"3","rightsList":[{"rights":"arXiv.org perpetual, non-exclusive license","rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/"}],"descriptions":[{"description":"Visual loco-manipulation of arbitrary in-the-wild objects requires accurate end-effector (EE) control and a generalizable understanding of the scene from visual inputs (eg, RGB-D images). Existing imitation and sim2real methods jointly learn both these aspects via monolithic end-to-end learning and are thus hard to scale. In this work, we bring to bear the best tools for each of these problems -- large vision models for generalizable scene understanding and simulated training for accurate EE control -- leading to an overall modular loco-manipulation system that exhibits strong generalization. Our core technical innovation is HERO, an accurate residual-aware EE tracking policy made possible by combining classical robotics with machine learning. It uses a) inverse kinematics to convert residual end-effector targets into reference trajectories, b) a learned neural forward model for accurate forward kinematics, and c) goal adjustment and replanning. Together, these innovations reduce the end-effector tracking error to 2.44cm, outperforming the strongest prior method by 5.5x. Our overall system operates in diverse real-world environments, from offices to coffee shops, where the robot reliably grasps various everyday objects (eg, mugs, apples, toys) on surfaces ranging from 43cm to 92cm in height. Systematic modular and end-to-end tests demonstrate the effectiveness of our proposed design. We believe our advances open up new ways of training humanoids to interact with daily objects.","descriptionType":"Abstract"},{"description":"Project page: https://hero-humanoid.github.io/","descriptionType":"Other"}],"geoLocations":[],"fundingReferences":[],"xml":"","url":"https://arxiv.org/abs/2602.16705","contentUrl":null,"metadataVersion":2,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"viewsOverTime":[],"downloadCount":0,"downloadsOverTime":[],"referenceCount":0,"citationCount":0,"citationsOverTime":[],"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-19T02:52:52.000Z","registered":"2026-02-19T02:52:53.000Z","published":"2026","updated":"2026-06-05T07:07:17.000Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}},"provider":{"data":{"id":"arxiv","type":"providers"}},"media":{"data":{"id":"10.48550/arxiv.2602.16705","type":"media"}},"references":{"data":[]},"citations":{"data":[]},"parts":{"data":[]},"partOf":{"data":[]},"versions":{"data":[]},"versionOf":{"data":[]}}}}