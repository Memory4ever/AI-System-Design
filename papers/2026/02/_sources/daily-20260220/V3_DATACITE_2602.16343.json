{"data":{"id":"10.48550/arxiv.2602.16343","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.16343","prefix":"10.48550","suffix":"arxiv.2602.16343","identifiers":[{"identifier":"2602.16343","identifierType":"arXiv"}],"alternateIdentifiers":[{"alternateIdentifierType":"arXiv","alternateIdentifier":"2602.16343"}],"creators":[{"name":"Xiao, Yixuan","nameType":"Personal","givenName":"Yixuan","familyName":"Xiao","affiliation":[],"nameIdentifiers":[]},{"name":"Lux, Florian","nameType":"Personal","givenName":"Florian","familyName":"Lux","affiliation":[],"nameIdentifiers":[]},{"name":"Pérez-González-de-Martos, Alejandro","nameType":"Personal","givenName":"Alejandro","familyName":"Pérez-González-de-Martos","affiliation":[],"nameIdentifiers":[]},{"name":"Vu, Ngoc Thang","nameType":"Personal","givenName":"Ngoc Thang","familyName":"Vu","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"How to Label Resynthesized Audio: The Dual Role of Neural Audio Codecs in Audio Deepfake Detection"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"lang":"en","subject":"Sound (cs.SD)","subjectScheme":"arXiv"},{"lang":"en","subject":"Machine Learning (cs.LG)","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"FOS: Computer and information sciences","schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-18T10:29:07Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-19T01:33:26Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"ris":"GEN","bibtex":"misc","citeproc":"article","schemaOrg":"CreativeWork","resourceType":"Article","resourceTypeGeneral":"Preprint"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rights":"Creative Commons Attribution Share Alike 4.0 International","rightsUri":"https://creativecommons.org/licenses/by-sa/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rightsIdentifier":"cc-by-sa-4.0","rightsIdentifierScheme":"SPDX"}],"descriptions":[{"description":"Since Text-to-Speech systems typically don't produce waveforms directly, recent spoof detection studies use resynthesized waveforms from vocoders and neural audio codecs to simulate an attacker. Unlike vocoders, which are specifically designed for speech synthesis, neural audio codecs were originally developed for compressing audio for storage and transmission. However, their ability to discretize speech also sparked interest in language-modeling-based speech synthesis. Owing to this dual functionality, codec resynthesized data may be labeled as either bonafide or spoof. So far, very little research has addressed this issue. In this study, we present a challenging extension of the ASVspoof 5 dataset constructed for this purpose. We examine how different labeling choices affect detection performance and provide insights into labeling strategies.","descriptionType":"Abstract"},{"description":"Accepted to ICASSP 2026","descriptionType":"Other"}],"geoLocations":[],"fundingReferences":[],"xml":"","url":"https://arxiv.org/abs/2602.16343","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"viewsOverTime":[],"downloadCount":0,"downloadsOverTime":[],"referenceCount":0,"citationCount":0,"citationsOverTime":[],"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-19T02:43:55.000Z","registered":"2026-02-19T02:43:56.000Z","published":"2026","updated":"2026-02-19T02:43:56.000Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}},"provider":{"data":{"id":"arxiv","type":"providers"}},"media":{"data":{"id"