<tbody class="ltx_tbody">
<tr id="S4.T4.3.1.3" class="ltx_tr">
<th id="S4.T4.3.1.3.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_t" style="padding-top:0.85pt;padding-bottom:0.85pt;"><span id="S4.T4.3.1.3.1.1" class="ltx_text" style="font-size:80%;">LLaVA-OV</span></th>
<td id="S4.T4.3.1.3.2" class="ltx_td ltx_align_center ltx_border_t" style="padding-top:0.85pt;padding-bottom:0.85pt;"><span id="S4.T4.3.1.3.2.1" class="ltx_text" style="font-size:80%;">14.0</span></td>
<td id="S4.T4.3.1.3.3" class="ltx_td ltx_align_center ltx_border_t" style="padding-top:0.85pt;padding-bottom:0.85pt;"><span id="S4.T4.3.1.3.3.1" class="ltx_text" style="font-size:80%;">52.8</span></td>
