<td id="S4.T5.3.1.5.2" class="ltx_td ltx_align_center ltx_border_b" style="padding-top:1pt;padding-bottom:1pt;"><span id="S4.T5.3.1.5.2.1" class="ltx_text" style="font-size:70%;">55.6</span></td>
