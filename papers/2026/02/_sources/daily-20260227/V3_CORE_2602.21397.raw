<th id="S4.T2.5.1.1.10" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt" style="padding-top:0.85pt;padding-bottom:0.85pt;"><span id="S4.T2.5.1.1.10.1" class="ltx_text" style="font-size:80%;">RPO <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib26" title="" class="ltx_ref">26</a>]</cite></span></th>
<th id="S4.T2.5.1.1.11" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt" style="padding-top:0.85pt;padding-bottom:0.85pt;"><span id="S4.T2.5.1.1.11.1" class="ltx_text" style="font-size:80%;">MMA <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib59" title="" class="ltx_ref">59</a>]</cite></span></th>
<th id="S4.T2.5.1.1.12" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt" style="padding-top:0.85pt;padding-bottom:0.85pt;"><span id="S4.T2.5.1.1.12.1" class="ltx_text" style="font-size:80%;">CoPrompt <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib48" title="" class="ltx_ref">48</a>]</cite></span></th>
<th id="S4.T2.5.1.1.13" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt" style="padding-top:0.85pt;padding-bottom:0.85pt;"><span id="S4.T2.5.1.1.13.1" class="ltx_text ltx_font_bold" style="font-size:80%;">MMLoP</span></th></tr>
</thead>
<tbody class="ltx_tbody">
<tr id="S4.T2.5.1.2" class="ltx_tr">
<th id="S4.T2.5.1.2.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_t" style="padding-top:0.85pt;padding-bottom:0.85pt;"><span id="S4.T2.5.1.2.1.1" class="ltx_text" style="font-size:80%;">ImageNet</span></th>
<td id="S4.T2.5.1.2.2" class="ltx_td ltx_align_center ltx_border_t" style="padding-top:0.85pt;padding-bottom:0.85pt;"><span id="S4.T2.5.1.2.2.1" class="ltx_text" style="font-size:80%;">66.73</span></td>
<td id="S4.T2.5.1.2.3" class="ltx_td ltx_align_center ltx_border_t" style="padding-top:0.85pt;padding-bottom:0.85pt;"><span id="S4.T2.5.1.2.3.1" class="ltx_text" style="font-size:80%;">72.63</span></td>
<td id="S4.T2.5.1.2.4" class="ltx_td ltx_align_center ltx_border_t" style="padding-top:0.85pt;padding-bottom:0.85pt;"><span id="S4.T2.5.1.2.4.1" class="ltx_text" style="font-size:80%;">71.51</span></td>
<td id="S4.T2.5.1.2.5" class="ltx_td ltx_align_center ltx_border_t" style="padding-top:0.85pt;padding-bottom:0.85pt;"><span id="S4.T2.5.1.2.5.1" class="ltx_text" style="font-size:80%;">71.02</span></td>
<td id="S4.T2.5.1.2.6" class="ltx_td ltx_align_center ltx_border_t" style="padding-top:0.85pt;padding-bottom:0.85pt;"><span id="S4.T2.5.1.2.6.1" class="ltx_text" style="font-size:80%;">72.24</span></td>
