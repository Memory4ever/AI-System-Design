            <math id="alg1.l21.m1" class="ltx_math_unparsed" alttext="\mathcal{L}_{\text{SCL-logits}}\leftarrow\frac{1}{2}\mathcal{D}_{\mathcal{KL}}\big(\operatorname{sim}(\tilde{f}_{p},\hat{g}_{k})\|\operatorname{sim}(\tilde{f},\tilde{g}_{k})\big)+\frac{1}{2}\mathcal{D}_{\mathcal{KL}}\big(\operatorname{sim}(\tilde{f},\tilde{g}_{k})\|\operatorname{sim}(\tilde{f}_{p},\hat{g}_{k})\big)" display="inline" intent=":literal"><semantics><mrow><msub><mi class="ltx_font_mathcaligraphic">ℒ</mi><mtext>SCL-logits</mtext></msub><mo stretchy="false">←</mo><mfrac><mn>1</mn><mn>2</mn></mfrac><msub><mi class="ltx_font_mathcaligraphic">𝒟</mi><mrow><mi class="ltx_font_mathcaligraphic">𝒦</mi><mo lspace="0em" rspace="0em">​</mo><mi class="ltx_font_mathcaligraphic">ℒ</mi></mrow></msub><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mi>sim</mi><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi>f</mi><mo>~</mo></mover><mi>p</mi></msub><mo>,</mo><msub><mover accent="true"><mi>g</mi><mo>^</mo></mover><mi>k</mi></msub><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0.167em">∥</mo><mi>sim</mi><mrow><mo stretchy="false">(</mo><mover accent="true"><mi>f</mi><mo>~</mo></mover><mo>,</mo><msub><mover accent="true"><mi>g</mi><mo>~</mo></mover><mi>k</mi></msub><mo stretchy="false">)</mo></mrow><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow><mo>+</mo><mfrac><mn>1</mn><mn>2</mn></mfrac><msub><mi class="ltx_font_mathcaligraphic">𝒟</mi><mrow><mi class="ltx_font_mathcaligraphic">𝒦</mi><mo lspace="0em" rspace="0em">​</mo><mi class="ltx_font_mathcaligraphic">ℒ</mi></mrow></msub><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mi>sim</mi><mrow><mo stretchy="false">(</mo><mover accent="true"><mi>f</mi><mo>~</mo></mover><mo>,</mo><msub><mover accent="true"><mi>g</mi><mo>~</mo></mover><mi>k</mi></msub><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0.167em">∥</mo><mi>sim</mi><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi>f</mi><mo>~</mo></mover><mi>p</mi></msub><mo>,</mo><msub><mover accent="true"><mi>g</mi><mo>^</mo></mover><mi>k</mi></msub><mo stretchy="false">)</mo></mrow><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathcal{L}_{\text{SCL-logits}}\leftarrow\frac{1}{2}\mathcal{D}_{\mathcal{KL}}\big(\operatorname{sim}(\tilde{f}_{p},\hat{g}_{k})\|\operatorname{sim}(\tilde{f},\tilde{g}_{k})\big)+\frac{1}{2}\mathcal{D}_{\mathcal{KL}}\big(\operatorname{sim}(\tilde{f},\tilde{g}_{k})\|\operatorname{sim}(\tilde{f}_{p},\hat{g}_{k})\big)</annotation></semantics></math>

</div>
<div id="alg1.l22" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline"><span id="alg1.l22.1" class="ltx_text" style="font-size:80%;">22:</span></span>
            
            
            <math id="alg1.l22.m1" class="ltx_Math" alttext="\mathcal{L}\leftarrow\mathcal{L}_{\text{CE}}+\mathcal{L}_{\text{SCL-text}}+\mathcal{L}_{\text{SCL-image}}+\mathcal{L}_{\text{SCL-logits}}" display="inline" intent=":literal"><semantics><mrow><mi class="ltx_font_mathcaligraphic">ℒ</mi><mo stretchy="false">←</mo><mrow><msub><mi class="ltx_font_mathcaligraphic">ℒ</mi><mtext>CE</mtext></msub><mo>+</mo><msub><mi class="ltx_font_mathcaligraphic">ℒ</mi><mtext>SCL-text</mtext></msub><mo>+</mo><msub><mi class="ltx_font_mathcaligraphic">ℒ</mi><mtext>SCL-image</mtext></msub><mo>+</mo><msub><mi class="ltx_font_mathcaligraphic">ℒ</mi><mtext>SCL-logits</mtext></msub></mrow></mrow><annotation encoding="application/x-tex">\mathcal{L}\leftarrow\mathcal{L}_{\text{CE}}+\mathcal{L}_{\text{SCL-text}}+\mathcal{L}_{\text{SCL-image}}+\mathcal{L}_{\text{SCL-logits}}</annotation></semantics></math>

</div>
<div id="alg1.l23" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline"><span id="alg1.l23.1" class="ltx_text" style="font-size:80%;">23:</span></span>
            
            
            Update <math id="alg1.l23.m1" class="ltx_Math" alttext="\{U^{(l)},V_{v}^{(l)},V_{t}^{(l)}\}_{l=1}^{L}" display="inline" intent=":literal"><semantics><msubsup><mrow><mo stretchy="false">{</mo><msup><mi>U</mi><mrow><mo stretchy="false">(</mo><mi>l</mi><mo stretchy="false">)</mo></mrow></msup><mo>,</mo><msubsup><mi>V</mi><mi>v</mi><mrow><mo stretchy="false">(</mo><mi>l</mi><mo stretchy="false">)</mo></mrow></msubsup><mo>,</mo><msubsup><mi>V</mi><mi>t</mi><mrow><mo stretchy="false">(</mo><mi>l</mi><mo stretchy="false">)</mo></mrow></msubsup><mo stretchy="false">}</mo></mrow><mrow><mi>l</mi><mo>=</mo><mn>1</mn></mrow><mi>L</mi></msubsup><annotation encoding="application/x-tex">\{U^{(l)},V_{v}^{(l)},V_{t}^{(l)}\}_{l=1}^{L}</annotation></semantics></math> via SGD on <math id="alg1.l23.m2" class="ltx_Math" alttext="\mathcal{L}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">ℒ</mi><annotation encoding="application/x-tex">\mathcal{L}</annotation></semantics></math>

</div>
<div id="alg1.l24" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline"><span id="alg1.l24.1" class="ltx_text" style="font-size:80%;">24:</span></span>
            
            
          <span id="alg1.l24.3" class="ltx_text ltx_font_bold">end</span> <span id="alg1.l24.4" class="ltx_text ltx_font_bold">for</span>
</div>
<div id="alg1.l25" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline"><span id="alg1.l25.1" class="ltx_text" style="font-size:80%;">25:</span></span>
            
            
          <span id="alg1.l25.3" class="ltx_text ltx_font_bold">Inference:</span> compute <math id="alg1.l25.m1" class="ltx_Math" alttext="\hat{g}_{k}" display="inline" intent=":literal"><semantics><msub><mover accent="true"><mi>g</mi><mo>^</mo></mover><mi>k</mi></msub><annotation encoding="application/x-tex">\hat{g}_{k}</annotation></semantics></math> via UDC, predict <math id="alg1.l25.m2" class="ltx_Math" alttext="\hat{y}=\arg\max_{k}\operatorname{sim}(\tilde{f}_{p},\hat{g}_{k})" display="inline" intent=":literal"><semantics><mrow><mover accent="true"><mi>y</mi><mo>^</mo></mover><mo>=</mo><mrow><mi>arg</mi><mo lspace="0.167em">⁡</mo><mrow><msub><mi>max</mi><mi>k</mi></msub><mo lspace="0.167em">⁡</mo><mrow><mi>sim</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi>f</mi><mo>~</mo></mover><mi>p</mi></msub><mo>,</mo><msub><mover accent="true"><mi>g</mi><mo>^</mo></mover><mi>k</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\hat{y}=\arg\max_{k}\operatorname{sim}(\tilde{f}_{p},\hat{g}_{k})</annotation></semantics></math>

</div>
</div>
</figure>
<section id="S3.SS1" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">3.1 </span>Motivation</h3>

<div id="S3.SS1.p1" class="ltx_para">
<p id="S3.SS1.p1.1" class="ltx_p">Deep multi-modal prompting <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib23" title="" class="ltx_ref">23</a>, <a href="#bib.bib59" title="" class="ltx_ref">59</a>, <a href="#bib.bib13" title="" class="ltx_ref">13</a>]</cite>
significantly boosts few-shot recognition performance over text-only
methods <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib72" title="" class="ltx_ref">72</a>, <a href="#bib.bib61" title="" class="ltx_ref">61</a>]</cite>, but dramatically increases the number of
trainable parameters — MaPLe <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib23" title="" class="ltx_ref">23</a>]</cite> requires over 3.5M
parameters, while CoPrompt <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib48" title="" class="ltx_ref">48</a>]</cite> pushes this even further. In pursuing
higher accuracy, these approaches abandon one of the core promises of prompt
tuning: <em id="S3.SS1.p1.1.1" class="ltx_emph ltx_font_italic">parameter efficiency</em>. MMLoP addresses this by parameterizing deep
prompts through a low-rank factorization inspired by <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib18" title="" class="ltx_ref">18</a>, <a href="#bib.bib12" title="" class="ltx_ref">12</a>]</cite>, reducing
the parameter count to CoOp-level while maintaining competitive performance. To
further close the gap with state-of-the-art methods, we introduce three key
components: (i) a <em id="S3.SS1.p1.1.2" class="ltx_emph ltx_font_italic">self-regulating consistency loss</em> that prevents the
prompted model from drifting away from CLIP’s pretrained representations, (ii) a
<em id="S3.SS1.p1.1.3" class="ltx_emph ltx_font_italic">uniform drift correction</em> that removes the global embedding shift induced
by prompt tuning, and (iii) a <em id="S3.SS1.p1.1.4" class="ltx_emph ltx_font_italic">shared up-projection</em> that couples vision and
text prompts through a common low-rank factor, enforcing cross-modal alignment.</p>
</div>
</section>
<section id="S3.SS2" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">3.2 </span>Low-Rank Prompt Parameterization</h3>

<div id="S3.SS2.p1" class="ltx_para">
<p id="S3.SS2.p1.1" class="ltx_p">Instead of learning full-rank prompt matrices <math id="S3.SS2.p1.m1" class="ltx_Math" alttext="\bm{P}_{v}^{(l)}\in\mathbb{R}^{V\times d_{v}}" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>𝑷</mi><mi>v</mi><mrow><mo stretchy="false">(</mo><mi>l</mi><mo stretchy="false">)</mo></mrow></msubsup><mo>∈</mo><msup><mi>ℝ</mi><mrow><mi>V</mi><mo lspace="0.222em" rspace="0.222em">×</mo><msub><mi>d</mi><mi>v</mi></msub></mrow></msup></mrow><annotation encoding="application/x-tex">\bm{P}_{v}^{(l)}\in\mathbb{R}^{V\times d_{v}}</annotation></semantics></math> and <math id="S3.SS2.p1.m2" class="ltx_Math" alttext="\bm{P}_{t}^{(l)}\in\mathbb{R}^{T\times d_{t}}" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>𝑷</mi><mi>t</mi><mrow><mo stretchy="false">(</mo><mi>l</mi><mo stretchy="false">)</mo></mrow></msubsup><mo>∈</mo><msup><mi>ℝ</mi><mrow><mi>T</mi><mo lspace="0.222em" rspace="0.222em">×</mo><msub><mi>d</mi><mi>t</mi></msub></mrow></msup></mrow><annotation encoding="application/x-tex">\bm{P}_{t}^{(l)}\in\mathbb{R}^{T\times d_{t}}</annotation></semantics></math> at each layer <math id="S3.SS2.p1.m3" class="ltx_Math" alttext="l" display="inline" intent=":literal"><semantics><mi>l</mi><annotation encoding="application/x-tex">l</annotation></semantics></math>, we parameterize the prompts through a low-rank factorization. Drawing inspiration from <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib18" title="" class="ltx_ref">18</a>]</cite>, we decompose each prompt matrix into the product of two low-rank factors:</p>
<table id="S3.EGx1" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="S3.E3"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S3.E3.m1" class="ltx_Math" alttext="\displaystyle\bm{P}_{v}^{(l)}=\bm{U}_{v}^{(l)}\bm{V}_{v}^{(l)},\quad\bm{P}_{t}^{(l)}=\bm{U}_{t}^{(l)}\bm{V}_{t}^{(l)}," display="inline" intent=":literal"><semantics><mrow><mrow><mrow><msubsup><mi>𝑷</mi><mi>v</mi><mrow><mo stretchy="false">(</mo><mi>l</mi><mo stretchy="false">)</mo></mrow></msubsup><mo>=</mo><mrow><msubsup><mi>𝑼</mi><mi>v</mi><mrow><mo stretchy="false">(</mo><mi>l</mi><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝑽</mi><mi>v</mi><mrow><mo stretchy="false">(</mo><mi>l</mi><mo stretchy="false">)</mo></mrow></msubsup></mrow></mrow><mo rspace="1.167em">,</mo><mrow><msubsup><mi>𝑷</mi><mi>t</mi><mrow><mo stretchy="false">(</mo><mi>l</mi><mo stretchy="false">)</mo></mrow></msubsup><mo>=</mo><mrow><msubsup><mi>𝑼</mi><mi>t</mi><mrow><mo stretchy="false">(</mo><mi>l</mi><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝑽</mi><mi>t</mi><mrow><mo stretchy="false">(</mo><mi>l</mi><mo stretchy="false">)</mo></mrow></msubsup></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\bm{P}_{v}^{(l)}=\bm{U}_{v}^{(l)}\bm{V}_{v}^{(l)},\quad\bm{P}_{t}^{(l)}=\bm{U}_{t}^{(l)}\bm{V}_{t}^{(l)},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(3)</span></td></tr></tbody>
</table>
<p id="S3.SS2.p1.2" class="ltx_p">where <math id="S3.SS2.p1.m4" class="ltx_Math" alttext="\bm{U}_{v}^{(l)}\in\mathbb{R}^{V\times r}" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>𝑼</mi><mi>v</mi><mrow><mo stretchy="false">(</mo><mi>l</mi><mo stretchy="false">)</mo></mrow></msubsup><mo>∈</mo><msup><mi>ℝ</mi><mrow><mi>V</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>r</mi></mrow></msup></mrow><annotation encoding="application/x-tex">\bm{U}_{v}^{(l)}\in\mathbb{R}^{V\times r}</annotation></semantics></math> and <math id="S3.SS2.p1.m5" class="ltx_Math" alttext="\bm{U}_{t}^{(l)}\in\mathbb{R}^{T\times r}" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>𝑼</mi><mi>t</mi><mrow><mo stretchy="false">(</mo><mi>l</mi><mo stretchy="false">)</mo></mrow></msubsup><mo>∈</mo><msup><mi>ℝ</mi><mrow><mi>T</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>r</mi></mrow></msup></mrow><annotation encoding="application/x-tex">\bm{U}_{t}^{(l)}\in\mathbb{R}^{T\times r}</annotation></semantics></math> are the up-projection matrices, <math id="S3.SS2.p1.m6" class="ltx_Math" alttext="\bm{V}_{v}^{(l)}\in\mathbb{R}^{r\times d_{v}}" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>𝑽</mi><mi>v</mi><mrow><mo stretchy="false">(</mo><mi>l</mi><mo stretchy="false">)</mo></mrow></msubsup><mo>∈</mo><msup><mi>ℝ</mi><mrow><mi>r</mi><mo lspace="0.222em" rspace="0.222em">×</mo><msub><mi>d</mi><mi>v</mi></msub></mrow></msup></mrow><annotation encoding="application/x-tex">\bm{V}_{v}^{(l)}\in\mathbb{R}^{r\times d_{v}}</annotation></semantics></math> and <math id="S3.SS2.p1.m7" class="ltx_Math" alttext="\bm{V}_{t}^{(l)}\in\mathbb{R}^{r\times d_{t}}" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>𝑽</mi><mi>t</mi><mrow><mo stretchy="false">(</mo><mi>l</mi><mo stretchy="false">)</mo></mrow></msubsup><mo>∈</mo><msup><mi>ℝ</mi><mrow><mi>r</mi><mo lspace="0.222em" rspace="0.222em">×</mo><msub><mi>d</mi><mi>t</mi></msub></mrow></msup></mrow><annotation encoding="application/x-tex">\bm{V}_{t}^{(l)}\in\mathbb{R}^{r\times d_{t}}</annotation></semantics></math> are the down-projection matrices, and <math id="S3.SS2.p1.m8" class="ltx_Math" alttext="r\ll\min(d_{v},d_{t})" display="inline" intent=":literal"><semantics><mrow><mi>r</mi><mo>≪</mo><mrow><mi>min</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>d</mi><mi>v</mi></msub><mo>,</mo><msub><mi>d</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">r\ll\min(d_{v},d_{t})</annotation></semantics></math> is the rank.</p>
</div>
<div id="S3.SS2.p2" class="ltx_para">
<p id="S3.SS2.p2.1" class="ltx_p">This factorization constrains each prompt to lie in a rank-<math id="S3.SS2.p2.m1" class="ltx_Math" alttext="r" display="inline" intent=":literal"><semantics><mi>r</mi><annotation encoding="application/x-tex">r</annotation></semantics></math> subspace, which serves as an implicit regularizer against overfitting on the few-shot training data. The prompted image and text inputs at layer <math id="S3.SS2.p2.m2" class="ltx_Math" alttext="l" display="inline" intent=":literal"><semantics><mi>l</mi><annotation encoding="application/x-tex">l</annotation></semantics></math> follow the same structure as IVLP:</p>
<table id="S3.EGx2" class="ltx_equationgroup ltx_eqn_gather ltx_eqn_table">

<tbody id="S3.Ex1"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S3.Ex1.m1" class="ltx_Math" alttext="\displaystyle\tilde{\bm{X}}_{p}^{(l)}=\{\bm{P}_{v}^{(l)},\,\bm{e}_{\text{cls}}^{(l)},\,\bm{e}_{1}^{(l)},\,\ldots,\,\bm{e}_{M}^{(l)}\}," display="block" intent=":literal"><semantics><mrow><mrow><msubsup><mover accent="true"><mi>𝑿</mi><mo>~</mo></mover><mi>p</mi><mrow><mo stretchy="false">(</mo><mi>l</mi><mo stretchy="false">)</mo></mrow></msubsup><mo>=</mo><mrow><mo stretchy="false">{</mo><mrow><msubsup><mi>𝑷</mi><mi>v</mi><mrow><mo stretchy="false">(</mo><mi>l</mi><mo stretchy="false">)</mo></mrow></msubsup><mo rspace="0.337em">,</mo><msubsup><mi>𝒆</mi><mtext>cls</mtext><mrow><mo stretchy="false">(</mo><mi>l</mi><mo stretchy="false">)</mo></mrow></msubsup><mo rspace="0.337em">,</mo><msubsup><mi>𝒆</mi><mn>1</mn><mrow><mo stretchy="false">(</mo><mi>l</mi><mo stretchy="false">)</mo></mrow></msubsup><mo rspace="0.337em">,</mo><mi mathvariant="normal">…</mi><mo rspace="0.337em">,</mo><msubsup><mi>𝒆</mi><mi>M</mi><mrow><mo stretchy="false">(</mo><mi>l</mi><mo stretchy="false">)</mo></mrow></msubsup></mrow><mo stretchy="false">}</mo></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\tilde{\bm{X}}_{p}^{(l)}=\{\bm{P}_{v}^{(l)},\,\bm{e}_{\text{cls}}^{(l)},\,\bm{e}_{1}^{(l)},\,\ldots,\,\bm{e}_{M}^{(l)}\},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="S3.E4"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S3.E4.m1" class="ltx_Math" alttext="\displaystyle\tilde{\bm{Y}}_{p}^{(l)}=\{t_{\text{SOS}}^{(l)},\,\bm{P}_{t}^{(l)},\,t_{1}^{(l)},\,\ldots,\,t_{N}^{(l)},\,c_{k}^{(l)},\,t_{\text{EOS}}^{(l)}\}," display="block" intent=":literal"><semantics><mrow><mrow><msubsup><mover accent="true"><mi>𝒀</mi><mo>~</mo></mover><mi>p</mi><mrow><mo stretchy="false">(</mo><mi>l</mi><mo stretchy="false">)</mo></mrow></msubsup><mo>=</mo><mrow><mo stretchy="false">{</mo><mrow><msubsup><mi>t</mi><mtext>SOS</mtext><mrow><mo stretchy="false">(</mo><mi>l</mi><mo stretchy="false">)</mo></mrow></msubsup><mo rspace="0.337em">,</mo><msubsup><mi>𝑷</mi><mi>t</mi><mrow><mo stretchy="false">(</mo><mi>l</mi><mo stretchy="false">)</mo></mrow></msubsup><mo rspace="0.337em">,</mo><msubsup><mi>t</mi><mn>1</mn><mrow><mo stretchy="false">(</mo><mi>l</mi><mo stretchy="false">)</mo></mrow></msubsup><mo rspace="0.337em">,</mo><mi mathvariant="normal">…</mi><mo rspace="0.337em">,</mo><msubsup><mi>t</mi><mi>N</mi><mrow><mo stretchy="false">(</mo><mi>l</mi><mo stretchy="false">)</mo></mrow></msubsup><mo rspace="0.337em">,</mo><msubsup><mi>c</mi><mi>k</mi><mrow><mo stretchy="false">(</mo><mi>l</mi><mo stretchy="false">)</mo></mrow></msubsup><mo rspace="0.337em">,</mo><msubsup><mi>t</mi><mtext>EOS</mtext><mrow><mo stretchy="false">(</mo><mi>l</mi><mo stretchy="false">)</mo></mrow></msubsup></mrow><mo stretchy="false">}</mo></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\tilde{\bm{Y}}_{p}^{(l)}=\{t_{\text{SOS}}^{(l)},\,\bm{P}_{t}^{(l)},\,t_{1}^{(l)},\,\ldots,\,t_{N}^{(l)},\,c_{k}^{(l)},\,t_{\text{EOS}}^{(l)}\},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(4)</span></td></tr></tbody>
</table>
<p id="S3.SS2.p2.2" class="ltx_p">where the superscript <math id="S3.SS2.p2.m3" class="ltx_Math" alttext="(l)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi>l</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(l)</annotation></semantics></math> denotes representations at layer <math id="S3.SS2.p2.m4" class="ltx_Math" alttext="l" display="inline" intent=":literal"><semantics><mi>l</mi><annotation encoding="application/x-tex">l</annotation></semantics></math> of the transformer. During training, the entire CLIP backbone <math id="S3.SS2.p2.m5" class="ltx_Math" alttext="\theta_{\text{CLIP}}" display="inline" intent=":literal"><semantics><msub><mi>θ</mi><mtext>CLIP</mtext></msub><annotation encoding="application/x-tex">\theta_{\text{CLIP}}</annotation></semantics></math> remains frozen and only the low-rank factors <math id="S3.SS2.p2.m6" class="ltx_Math" alttext="\{\bm{U}_{v}^{(l)},\bm{V}_{v}^{(l)},\bm{U}_{t}^{(l)},\bm{V}_{t}^{(l)}\}_{l=1}^{L}" display="inline" intent=":literal"><semantics><msubsup><mrow><mo stretchy="false">{</mo><mrow><msubsup><mi>𝑼</mi><mi>v</mi><mrow><mo stretchy="false">(</mo><mi>l</mi><mo stretchy="false">)</mo></mrow></msubsup><mo>,</mo><msubsup><mi>𝑽</mi><mi>v</mi><mrow><mo stretchy="false">(</mo><mi>l</mi><mo stretchy="false">)</mo></mrow></msubsup><mo>,</mo><msubsup><mi>𝑼</mi><mi>t</mi><mrow><mo stretchy="false">(</mo><mi>l</mi><mo stretchy="false">)</mo></mrow></msubsup><mo>,</mo><msubsup><mi>𝑽</mi><mi>t</mi><mrow><mo stretchy="false">(</mo><mi>l</mi><mo stretchy="false">)</mo></mrow></msubsup></mrow><mo stretchy="false">}</mo></mrow><mrow><mi>l</mi><mo>=</mo><mn>1</mn></mrow><mi>L</mi></msubsup><annotation encoding="application/x-tex">\{\bm{U}_{v}^{(l)},\bm{V}_{v}^{(l)},\bm{U}_{t}^{(l)},\bm{V}_{t}^{(l)}\}_{l=1}^{L}</annotation></semantics></math> are optimized.</p>
</div>
</section>
<section id="S3.SS3" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">3.3 </span>Self-Regulating Consistency Loss (SCL)</h3>

<div id="S3.SS3.p1" class="ltx_para">
<p id="S3.SS3.p1.1" class="ltx_p">While the low-rank parameterization reduces the risk of overfitting, prompt-tuned models can still drift away from the pretrained CLIP representations, harming generalization to unseen classes. To mitigate this, we incorporate a consistency regularization inspired by <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib24" title="" class="ltx_ref">24</a>]</cite> that anchors the learned features to the frozen zero-shot CLIP features. Let <math id="S3.SS3.p1.m1" class="ltx_Math" alttext="\tilde{\bm{f}}_{p}" display="inline" intent=":literal"><semantics><msub><mover accent="true"><mi>𝒇</mi><mo>~</mo></mover><mi>p</mi></msub><annotation encoding="application/x-tex">\tilde{\bm{f}}_{p}</annotation></semantics></math> and <math id="S3.SS3.p1.m2" class="ltx_Math" alttext="\tilde{\bm{g}}_{p}" display="inline" intent=":literal"><semantics><msub><mover accent="true"><mi>𝒈</mi><mo>~</mo></mover><mi>p</mi></msub><annotation encoding="application/x-tex">\tilde{\bm{g}}_{p}</annotation></semantics></math> denote the image and text features produced by the prompted model, and let <math id="S3.SS3.p1.m3" class="ltx_Math" alttext="\tilde{\bm{f}}" display="inline" intent=":literal"><semantics><mover accent="true"><mi>𝒇</mi><mo>~</mo></mover><annotation encoding="application/x-tex">\tilde{\bm{f}}</annotation></semantics></math> and <math id="S3.SS3.p1.m4" class="ltx_Math" alttext="\tilde{\bm{g}}" display="inline" intent=":literal"><semantics><mover accent="true"><mi>𝒈</mi><mo>~</mo></mover><annotation encoding="application/x-tex">\tilde{\bm{g}}</annotation></semantics></math> denote the features from the frozen zero-shot CLIP model. We define three consistency terms.</p>
</div>
<div id="S3.SS3.p2" class="ltx_para">
<p id="S3.SS3.p2.1" class="ltx_p"><span id="S3.SS3.p2.1.1" class="ltx_text ltx_font_bold">Feature-level consistency.</span> We penalize the deviation between the prompted and zero-shot features in both modalities using the L1 norm:</p>
<table id="S3.E5" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S3.E5.m1" class="ltx_Math" alttext="\mathcal{L}_{\text{SCL-image}}=\|\tilde{\bm{f}}_{p}-\tilde{\bm{f}}\|_{1},\quad\mathcal{L}_{\text{SCL-text}}=\|\tilde{\bm{g}}_{p}-\tilde{\bm{g}}\|_{1}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><msub><mi class="ltx_font_mathcaligraphic">ℒ</mi><mtext>SCL-image</mtext></msub><mo>=</mo><msub><mrow><mo stretchy="false">‖</mo><mrow><msub><mover accent="true"><mi>𝒇</mi><mo>~</mo></mover><mi>p</mi></msub><mo>−</mo><mover accent="true"><mi>𝒇</mi><mo>~</mo></mover></mrow><mo stretchy="false">‖</mo></mrow><mn>1</mn></msub></mrow><mo rspace="1.167em">,</mo><mrow><msub><mi class="ltx_font_mathcaligraphic">ℒ</mi><mtext>SCL-text</mtext></msub><mo>=</mo><msub><mrow><mo stretchy="false">‖</mo><mrow><msub><mover accent="true"><mi>𝒈</mi><mo>~</mo></mover><mi>p</mi></msub><mo>−</mo><mover accent="true"><mi>𝒈</mi><mo>~</mo></mover></mrow><mo stretchy="false">‖</mo></mrow><mn>1</mn></msub></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\mathcal{L}_{\text{SCL-image}}=\|\tilde{\bm{f}}_{p}-\tilde{\bm{f}}\|_{1},\quad\mathcal{L}_{\text{SCL-text}}=\|\tilde{\bm{g}}_{p}-\tilde{\bm{g}}\|_{1}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(5)</span></td></tr></tbody>
</table>
</div>
<div id="S3.SS3.p3" class="ltx_para">
<p id="S3.SS3.p3.1" class="ltx_p"><span id="S3.SS3.p3.1.1" class="ltx_text ltx_font_bold">Logit-level consistency.</span> We also regularize the output logit distributions to remain close to those of the zero-shot model. Unlike <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib24" title="" class="ltx_ref">24</a>]</cite> which employs a standard (asymmetric) KL divergence for this purpose, we adopt a symmetric KL divergence, as we find it more effective in practice:</p>
<table id="S3.E6" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S3.E6.m1" class="ltx_math_unparsed" alttext="\mathcal{L}_{\text{SCL-logits}}=\frac{1}{2}\mathcal{D}_{\mathcal{KL}}\Big(\operatorname{sim}(\tilde{\bm{f}}_{p},\tilde{\bm{g}}_{p})\;\|\;\operatorname{sim}(\tilde{\bm{f}},\tilde{\bm{g}})\Big)+\frac{1}{2}\mathcal{D}_{\mathcal{KL}}\Big(\operatorname{sim}(\tilde{\bm{f}},\tilde{\bm{g}})\;\|\;\operatorname{sim}(\tilde{\bm{f}}_{p},\tilde{\bm{g}}_{p})\Big)." display="block" intent=":literal"><semantics><mrow><msub><mi class="ltx_font_mathcaligraphic">ℒ</mi><mtext>SCL-logits</mtext></msub><mo>=</mo><mfrac><mn>1</mn><mn>2</mn></mfrac><msub><mi class="ltx_font_mathcaligraphic">𝒟</mi><mrow><mi class="ltx_font_mathcaligraphic">𝒦</mi><mo lspace="0em" rspace="0em">​</mo><mi class="ltx_font_mathcaligraphic">ℒ</mi></mrow></msub><mrow><mo maxsize="1.600em" minsize="1.600em">(</mo><mi>sim</mi><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi>𝒇</mi><mo>~</mo></mover><mi>p</mi></msub><mo>,</mo><msub><mover accent="true"><mi>𝒈</mi><mo>~</mo></mover><mi>p</mi></msub><mo stretchy="false">)</mo></mrow><mo rspace="0.447em">∥</mo><mi>sim</mi><mrow><mo stretchy="false">(</mo><mover accent="true"><mi>𝒇</mi><mo>~</mo></mover><mo>,</mo><mover accent="true"><mi>𝒈</mi><mo>~</mo></mover><mo stretchy="false">)</mo></mrow><mo maxsize="1.600em" minsize="1.600em">)</mo></mrow><mo>+</mo><mfrac><mn>1</mn><mn>2</mn></mfrac><msub><mi class="ltx_font_mathcaligraphic">𝒟</mi><mrow><mi class="ltx_font_mathcaligraphic">𝒦</mi><mo lspace="0em" rspace="0em">​</mo><mi class="ltx_font_mathcaligraphic">ℒ</mi></mrow></msub><mrow><mo maxsize="1.600em" minsize="1.600em">(</mo><mi>sim</mi><mrow><mo stretchy="false">(</mo><mover accent="true"><mi>𝒇</mi><mo>~</mo></mover><mo>,</mo><mover accent="true"><mi>𝒈</mi><mo>~</mo></mover><mo stretchy="false">)</mo></mrow><mo rspace="0.447em">∥</mo><mi>sim</mi><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi>𝒇</mi><mo>~</mo></mover><mi>p</mi></msub><mo>,</mo><msub><mover accent="true"><mi>𝒈</mi><mo>~</mo></mover><mi>p</mi></msub><mo stretchy="false">)</mo></mrow><mo maxsize="1.600em" minsize="1.600em">)</mo></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\mathcal{L}_{\text{SCL-logits}}=\frac{1}{2}\mathcal{D}_{\mathcal{KL}}\Big(\operatorname{sim}(\tilde{\bm{f}}_{p},\tilde{\bm{g}}_{p})\;\|\;\operatorname{sim}(\tilde{\bm{f}},\tilde{\bm{g}})\Big)+\frac{1}{2}\mathcal{D}_{\mathcal{KL}}\Big(\operatorname{sim}(\tilde{\bm{f}},\tilde{\bm{g}})\;\|\;\operatorname{sim}(\tilde{\bm{f}}_{p},\tilde{\bm{g}}_{p})\Big).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(6)</span></td></tr></tbody>
</table>
<p id="S3.SS3.p3.2" class="ltx_p">This symmetric formulation penalizes divergence equally in both directions, treating the prompted and zero-shot distributions more uniformly and avoiding the asymmetric gradient behavior of the standard KL. An empirical comparison of both variants is provided in Table <a href="#Pt0.A1.T7" title="Table 7 ‣ Appendix 0.A Related Work ‣ MMLoP: Multi-Modal Low-Rank Prompting for Efficient Vision-Language Adaptation" class="ltx_ref"><span class="ltx_text ltx_ref_tag">7</span></a> in the Appendix. The total consistency loss is:</p>
<table id="S3.E7" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S3.E7.m1" class="ltx_Math" alttext="\mathcal{L}_{\text{SCL}}=\lambda_{1}\,\mathcal{L}_{\text{SCL-text}}+\lambda_{2}\,\mathcal{L}_{\text{SCL-image}}+\mathcal{L}_{\text{SCL-logits}}," display="block" intent=":literal"><semantics><mrow><mrow><msub><mi class="ltx_font_mathcaligraphic">ℒ</mi><mtext>SCL</mtext></msub><mo>=</mo><mrow><mrow><msub><mi>λ</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi class="ltx_font_mathcaligraphic">ℒ</mi><mtext>SCL-text</mtext></msub></mrow><mo>+</mo><mrow><msub><mi>λ</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi class="ltx_font_mathcaligraphic">ℒ</mi><mtext>SCL-image</mtext></msub></mrow><mo>+</mo><msub><mi class="ltx_font_mathcaligraphic">ℒ</mi><mtext>SCL-logits</mtext></msub></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\mathcal{L}_{\text{SCL}}=\lambda_{1}\,\mathcal{L}_{\text{SCL-text}}+\lambda_{2}\,\mathcal{L}_{\text{SCL-image}}+\mathcal{L}_{\text{SCL-logits}},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(7)</span></td></tr></tbody>
</table>
<p id="S3.SS3.p3.3" class="ltx_p">where <math id="S3.SS3.p3.m1" class="ltx_Math" alttext="\lambda_{1}" display="inline" intent=":literal"><semantics><msub><mi>λ</mi><mn>1</mn></msub><annotation encoding="application/x-tex">\lambda_{1}</annotation></semantics></math> and <math id="S3.SS3.p3.m2" class="ltx_Math" alttext="\lambda_{2}" display="inline" intent=":literal"><semantics><msub><mi>λ</mi><mn>2</mn></msub><annotation encoding="application/x-tex">\lambda_{2}</annotation></semantics></math> are weighting hyperparameters. The overall training objective is then:
<math id="S3.SS3.p3.m3" class="ltx_Math" alttext="\mathcal{L}=\mathcal{L}_{\text{CE}}+\mathcal{L}_{\text{SCL}}." display="inline" intent=":literal"><semantics><mrow><mrow><mi class="ltx_font_mathcaligraphic">ℒ</mi><mo>=</mo><mrow><msub><mi class="ltx_font_mathcaligraphic">ℒ</mi><mtext>CE</mtext></msub><mo>+</mo><msub><mi class="ltx_font_mathcaligraphic">ℒ</mi><mtext>SCL</mtext></msub></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\mathcal{L}=\mathcal{L}_{\text{CE}}+\mathcal{L}_{\text{SCL}}.</annotation></semantics></math></p>
</div>
</section>
<section id="S3.SS4" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">3.4 </span>Uniform Drift Correction (UDC)</h3>

<div id="S3.SS4.p1" class="ltx_para">
<p id="S3.SS4.p1.1" class="ltx_p">While the self-regulating consistency loss encourages the prompted model to stay close to CLIP’s pretrained representations, prompt tuning can still induce a systematic shift that affects all class embeddings uniformly. Such a shift does not improve discrimination between classes—it is shared across the entire embedding space and therefore carries no class-specific signal. Rather, it reflects a form of base-class bias absorbed into the prompt during few-shot training, which disproportionately harms generalization to novel classes.</p>
</div>
<div id="S3.SS4.p2" class="ltx_para">
<p id="S3.SS4.p2.1" class="ltx_p">To address this, we propose a correction that removes the uniform component of the learned text feature shift throughout both training and evaluation. Let <math id="S3.SS4.p2.m1" class="ltx_Math" alttext="\tilde{g}_{k}^{p}" display="inline" intent=":literal"><semantics><msubsup><mover accent="true"><mi>g</mi><mo>~</mo></mover><mi>k</mi><mi>p</mi></msubsup><annotation encoding="application/x-tex">\tilde{g}_{k}^{p}</annotation></semantics></math> denote the prompted text feature for class <math id="S3.SS4.p2.m2" class="ltx_Math" alttext="k" display="inline" intent=":literal"><semantics><mi>k</mi><annotation encoding="application/x-tex">k</annotation></semantics></math>, and let <math id="S3.SS4.p2.m3" class="ltx_Math" alttext="\tilde{g}_{k}" display="inline" intent=":literal"><semantics><msub><mover accent="true"><mi>g</mi><mo>~</mo></mover><mi>k</mi></msub><annotation encoding="application/x-tex">\tilde{g}_{k}</annotation></semantics></math> denote the corresponding frozen zero-shot feature. We decompose the prompted feature into a zero-shot anchor and a residual:
<math id="S3.SS4.p2.m4" class="ltx_Math" alttext="r_{k}=\tilde{g}_{k}^{p}-\tilde{g}_{k}." display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>r</mi><mi>k</mi></msub><mo>=</mo><mrow><msubsup><mover accent="true"><mi>g</mi><mo>~</mo></mover><mi>k</mi><mi>p</mi></msubsup><mo>−</mo><msub><mover accent="true"><mi>g</mi><mo>~</mo></mover><mi>k</mi></msub></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">r_{k}=\tilde{g}_{k}^{p}-\tilde{g}_{k}.</annotation></semantics></math>
The mean residual <math id="S3.SS4.p2.m5" class="ltx_Math" alttext="\bar{r}=\frac{1}{C}\sum_{k=1}^{C}r_{k}" display="inline" intent=":literal"><semantics><mrow><mover accent="true"><mi>r</mi><mo>¯</mo></mover><mo>=</mo><mrow><mfrac><mn>1</mn><mi>C</mi></mfrac><mo lspace="0em" rspace="0em">​</mo><mrow><msubsup><mo>∑</mo><mrow><mi>k</mi><mo>=</mo><mn>1</mn></mrow><mi>C</mi></msubsup><msub><mi>r</mi><mi>k</mi></msub></mrow></mrow></mrow><annotation encoding="application/x-tex">\bar{r}=\frac{1}{C}\sum_{k=1}^{C}r_{k}</annotation></semantics></math> captures the uniform drift shared across all <math id="S3.SS4.p2.m6" class="ltx_Math" alttext="C" display="inline" intent=":literal"><semantics><mi>C</mi><annotation encoding="application/x-tex">C</annotation></semantics></math> classes. We subtract this common component and reconstruct the corrected feature:</p>
<table id="S3.E8" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S3.E8.m1" class="ltx_Math" alttext="\hat{g}_{k}=\tilde{g}_{k}+(r_{k}-\bar{r}),\qquad\hat{g}_{k}\leftarrow\frac{\hat{g}_{k}}{\|\hat{g}_{k}\|}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><msub><mover accent="true"><mi>g</mi><mo>^</mo></mover><mi>k</mi></msub><mo>=</mo><mrow><msub><mover accent="true"><mi>g</mi><mo>~</mo></mover><mi>k</mi></msub><mo>+</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>r</mi><mi>k</mi></msub><mo>−</mo><mover accent="true"><mi>r</mi><mo>¯</mo></mover></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo rspace="2.167em">,</mo><mrow><msub><mover accent="true"><mi>g</mi><mo>^</mo></mover><mi>k</mi></msub><mo stretchy="false">←</mo><mfrac><msub><mover accent="true"><mi>g</mi><mo>^</mo></mover><mi>k</mi></msub><mrow><mo stretchy="false">‖</mo><msub><mover accent="true"><mi>g</mi><mo>^</mo></mover><mi>k</mi></msub><mo stretchy="false">‖</mo></mrow></mfrac></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\hat{g}_{k}=\tilde{g}_{k}+(r_{k}-\bar{r}),\qquad\hat{g}_{k}\leftarrow\frac{\hat{g}_{k}}{\|\hat{g}_{k}\|}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(8)</span></td></tr></tbody>
</table>
<p id="S3.SS4.p2.2" class="ltx_p">The corrected features <math id="S3.SS4.p2.m7" class="ltx_Math" alttext="\hat{g}_{k}" display="inline" intent=":literal"><semantics><msub><mover accent="true"><mi>g</mi><mo>^</mo></mover><mi>k</mi></msub><annotation encoding="application/x-tex">\hat{g}_{k}</annotation></semantics></math> retain the class-specific adaptations learned by the prompt while eliminating the shared bias. Furthermore, since UDC is applied during training, <math id="S3.SS4.p2.m8" class="ltx_Math" alttext="\mathcal{L}_{\text{SCL-text}}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">ℒ</mi><mtext>SCL-text</mtext></msub><annotation encoding="application/x-tex">\mathcal{L}_{\text{SCL-text}}</annotation></semantics></math> is computed on drift-corrected features <math id="S3.SS4.p2.m9" class="ltx_Math" alttext="\hat{g}_{k}" display="inline" intent=":literal"><semantics><msub><mover accent="true"><mi>g</mi><mo>^</mo></mover><mi>k</mi></msub><annotation encoding="application/x-tex">\hat{g}_{k}</annotation></semantics></math> rather than raw prompted features. This means the consistency regularization acts on the class-discriminative residuals alone, making UDC and <math id="S3.SS4.p2.m10" class="ltx_Math" alttext="\mathcal{L}_{\text{SCL}}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">ℒ</mi><mtext>SCL</mtext></msub><annotation encoding="application/x-tex">\mathcal{L}_{\text{SCL}}</annotation></semantics></math> mutually reinforcing rather than redundant: the consistency loss encourages meaningful class-specific adaptation while UDC ensures that any global offset is continuously removed. The correction requires no additional parameters and reuses the frozen zero-shot features already computed for <math id="S3.SS4.p2.m11" class="ltx_Math" alttext="\mathcal{L}_{\text{SCL}}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">ℒ</mi><mtext>SCL</mtext></msub><annotation encoding="application/x-tex">\mathcal{L}_{\text{SCL}}</annotation></semantics></math>.</p>
</div>
</section>
<section id="S3.SS5" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">3.5 </span>Cross-Modal Coupling via Shared Up-Projection</h3>

<div id="S3.SS5.p1" class="ltx_para">
<p id="S3.SS5.p1.1" class="ltx_p">The low-rank parameterization in Eq. (<a href="#S3.E3" title="Equation 3 ‣ 3.2 Low-Rank Prompt Parameterization ‣ 3 Proposed Algorithm ‣ MMLoP: Multi-Modal Low-Rank Prompting for Efficient Vision-Language Adaptation" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3</span></a>) with independent up-projections <math id="S3.SS5.p1.m1" class="ltx_Math" alttext="\bm{U}_{v}^{(l)}" display="inline" intent=":literal"><semantics><msubsup><mi>𝑼</mi><mi>v</mi><mrow><mo stretchy="false">(</mo><mi>l</mi><mo stretchy="false">)</mo></mrow></msubsup><annotation encoding="application/x-tex">\bm{U}_{v}^{(l)}</annotation></semantics></math> and <math id="S3.SS5.p1.m2" class="ltx_Math" alttext="\bm{U}_{t}^{(l)}" display="inline" intent=":literal"><semantics><msubsup><mi>𝑼</mi><mi>t</mi><mrow><mo stretchy="false">(</mo><mi>l</mi><mo stretchy="false">)</mo></mrow></msubsup><annotation encoding="application/x-tex">\bm{U}_{t}^{(l)}</annotation></semantics></math> already provides parameter efficiency and implicit regularization. However, the vision and text prompts remain structurally decoupled—each modality’s low-rank subspace is learned independently. We observe that by tying the up-projection matrices across modalities, we can introduce cross-modal interaction at virtually no additional cost. Specifically, we set <math id="S3.SS5.p1.m3" class="ltx_Math" alttext="T=V" display="inline" intent=":literal"><semantics><mrow><mi>T</mi><mo>=</mo><mi>V</mi></mrow><annotation encoding="application/x-tex">T=V</annotation></semantics></math> and constrain the two modalities to share a single up-projection:</p>
<table id="S3.EGx3" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="S3.E9"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S3.E9.m1" class="ltx_Math" alttext="\displaystyle\bm{P}_{v}^{(l)}=\bm{U}^{(l)}\bm{V}_{v}^{(l)},\quad\bm{P}_{t}^{(l)}=\bm{U}^{(l)}\bm{V}_{t}^{(l)}," display="inline" intent=":literal"><semantics><mrow><mrow><mrow><msubsup><mi>𝑷</mi><mi>v</mi><mrow><mo stretchy="false">(</mo><mi>l</mi><mo stretchy="false">)</mo></mrow></msubsup><mo>=</mo><mrow><msup><mi>𝑼</mi><mrow><mo stretchy="false">(</mo><mi>l</mi><mo stretchy="false">)</mo></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝑽</mi><mi>v</mi><mrow><mo stretchy="false">(</mo><mi>l</mi><mo stretchy="false">)</mo></mrow></msubsup></mrow></mrow><mo rspace="1.167em">,</mo><mrow><msubsup><mi>𝑷</mi><mi>t</mi><mrow><mo stretchy="false">(</mo><mi>l</mi><mo stretchy="false">)</mo></mrow></msubsup><mo>=</mo><mrow><msup><mi>𝑼</mi><mrow><mo stretchy="false">(</mo><mi>l</mi><mo stretchy="false">)</mo></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝑽</mi><mi>t</mi><mrow><mo stretchy="false">(</mo><mi>l</mi><mo stretchy="false">)</mo></mrow></msubsup></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\bm{P}_{v}^{(l)}=\bm{U}^{(l)}\bm{V}_{v}^{(l)},\quad\bm{P}_{t}^{(l)}=\bm{U}^{(l)}\bm{V}_{t}^{(l)},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(9)</span></td></tr></tbody>
</table>
<p id="S3.SS5.p1.2" class="ltx_p">where <math id="S3.SS5.p1.m4" class="ltx_Math" alttext="\bm{U}^{(l)}\in\mathbb{R}^{T\times r}" display="inline" intent=":literal"><semantics><mrow><msup><mi>𝑼</mi><mrow><mo stretchy="false">(</mo><mi>l</mi><mo stretchy="false">)</mo></mrow></msup><mo>∈</mo><msup><mi>ℝ</mi><mrow><mi>T</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>r</mi></mrow></msup></mrow><annotation encoding="application/x-tex">\bm{U}^{(l)}\in\mathbb{R}^{T\times r}</annotation></semantics></math> is now shared between modalities. This design means that the vision and text prompts at each layer are constrained to share the same row space. The shared factor <math id="S3.SS5.p1.m5" class="ltx_Math" alttext="\bm{U}^{(l)}" display="inline" intent=":literal"><semantics><msup><mi>𝑼</mi><mrow><mo stretchy="false">(</mo><mi>l</mi><mo stretchy="false">)</mo></mrow></msup><annotation encoding="application/x-tex">\bm{U}^{(l)}</annotation></semantics></math> determines the token-wise activation pattern common to both modalities, while the modality-specific factors <math id="S3.SS5.p1.m6" class="ltx_Math" alttext="\bm{V}_{v}^{(l)}" display="inline" intent=":literal"><semantics><msubsup><mi>𝑽</mi><mi>v</mi><mrow><mo stretchy="false">(</mo><mi>l</mi><mo stretchy="false">)</mo></mrow></msubsup><annotation encoding="application/x-tex">\bm{V}_{v}^{(l)}</annotation></semantics></math> and <math id="S3.SS5.p1.m7" class="ltx_Math" alttext="\bm{V}_{t}^{(l)}" display="inline" intent=":literal"><semantics><msubsup><mi>𝑽</mi><mi>t</mi><mrow><mo stretchy="false">(</mo><mi>l</mi><mo stretchy="false">)</mo></mrow></msubsup><annotation encoding="application/x-tex">\bm{V}_{t}^{(l)}</annotation></semantics></math> project this shared structure into the respective embedding spaces.</p>
</div>
<div id="S3.SS5.p2" class="ltx_para">
<p id="S3.SS5.p2.1" class="ltx_p">This coupling acts as an additional regularizer: gradient updates to <math id="S3.SS5.p2.m1" class="ltx_Math" alttext="\bm{U}^{(l)}" display="inline" intent=":literal"><semantics><msup><mi>𝑼</mi><mrow><mo stretchy="false">(</mo><mi>l</mi><mo stretchy="false">)</mo></mrow></msup><annotation encoding="application/x-tex">\bm{U}^{(l)}</annotation></semantics></math> must simultaneously benefit both modalities, which discourages overfitting to modality-specific noise in the few-shot training data. As shown in our ablation study (Table <a href="#S4.T4" title="Table 4 ‣ 4.3 Ablation Study ‣ 4 Empirical Results ‣ MMLoP: Multi-Modal Low-Rank Prompting for Efficient Vision-Language Adaptation" class="ltx_ref"><span class="ltx_text ltx_ref_tag">4</span></a>), introducing the shared up-projection on top of the consistency loss and UDC further improves novel class accuracy by <math id="S3.SS5.p2.m2" class="ltx_Math" alttext="+0.86\%" display="inline" intent=":literal"><semantics><mrow><mo>+</mo><mrow><mn>0.86</mn><mo>%</mo></mrow></mrow><annotation encoding="application/x-tex">+0.86\%</annotation></semantics></math> and the harmonic mean by <math id="S3.SS5.p2.m3" class="ltx_Math" alttext="+0.50\%" display="inline" intent=":literal"><semantics><mrow><mo>+</mo><mrow><mn>0.50</mn><mo>%</mo></mrow></mrow><annotation encoding="application/x-tex">+0.50\%</annotation></semantics></math>, demonstrating that cross-modal structural alignment provides complementary benefits to feature-level regularization.</p>
</div>
</section>
</section>
<section id="S4" class="ltx_section">
<h2 class="ltx_title ltx_title_section"><span class="ltx_tag ltx_tag_section">4 </span>Empirical Results</h2>

<section id="S4.SS1" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">4.1 </span>Experiments Setup</h3>

<div id="S4.SS1.p1" class="ltx_para">
<p id="S4.SS1.p1.1" class="ltx_p">We evaluate MMLoP on three benchmark settings: base-to-novel generalization, domain generalization, and all-to-all few-shot classification.</p>
</div>
<div id="S4.SS1.p2" class="ltx_para">
<p id="S4.SS1.p2.1" class="ltx_p"><span id="S4.SS1.p2.1.1" class="ltx_text ltx_font_bold">Base-to-Novel Generalization.</span> Following the protocol established by CoOp <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib72" title="" class="ltx_ref">72</a>]</cite> and CoCoOp <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib71" title="" class="ltx_ref">71</a>]</cite>, each dataset is equally split into base and novel classes. The model is trained exclusively on base classes with 16 shots per class and evaluated on both base and novel classes. The harmonic mean (HM) of base and novel accuracy is reported as the primary metric. This setting evaluates whether the model can learn task-specific representations without sacrificing CLIP’s inherent zero-shot generalization ability. We conduct experiments on 11 diverse image recognition datasets: ImageNet <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib6" title="" class="ltx_ref">6</a>]</cite> and Caltech101 <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib9" title="" class="ltx_ref">9</a>]</cite> for generic object recognition; OxfordPets <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib41" title="" class="ltx_ref">41</a>]</cite>, StanfordCars <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib25" title="" class="ltx_ref">25</a>]</cite>, Flowers102 <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib39" title="" class="ltx_ref">39</a>]</cite>, Food101 <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib2" title="" class="ltx_ref">2</a>]</cite>, and FGVCAircraft <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib38" title="" class="ltx_ref">38</a>]</cite> for fine-grained classification; SUN397 <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib55" title="" class="ltx_ref">55</a>]</cite> for scene recognition; UCF101 <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib51" title="" class="ltx_ref">51</a>]</cite> for action recognition; DTD <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib5" title="" class="ltx_ref">5</a>]</cite> for texture classification; and EuroSAT <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib15" title="" class="ltx_ref">15</a>]</cite> for satellite image classification.</p>
</div>
<figure id="S4.T1" class="ltx_table">
<figcaption class="ltx_caption ltx_centering"><span class="ltx_tag ltx_tag_table"><span id="S4.T1.3" class="ltx_text" style="font-size:90%;">Table 1</span>: </span><span id="S4.T1.4" class="ltx_text" style="font-size:90%;">Base-to-novel generalization results across multiple datasets. HM refers to harmonic mean.</span></figcaption>
