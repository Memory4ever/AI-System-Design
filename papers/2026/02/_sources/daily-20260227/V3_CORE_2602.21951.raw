<td id="S3.T3.2.5.4" class="ltx_td ltx_align_left" style="padding-left:2.0pt;padding-right:2.0pt;">Tier 2 <span id="S3.T3.2.5.4.1" class="ltx_text ltx_font_italic">(Medium)</span></td>
<td id="S3.T3.2.5.5" class="ltx_td ltx_align_center" style="padding-left:2.0pt;padding-right:2.0pt;">81.6</td></tr>
<tr id="S3.T3.2.6" class="ltx_tr">
<td id="S3.T3.2.6.1" class="ltx_td ltx_border_bb" style="padding-left:2.0pt;padding-right:2.0pt;"></td>
