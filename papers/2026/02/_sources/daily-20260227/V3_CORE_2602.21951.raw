<tr id="S3.T1.6.5" class="ltx_tr">
<th id="S3.T1.6.5.1" class="ltx_td ltx_align_left ltx_th ltx_th_row" style="padding-left:7.7pt;padding-right:7.7pt;">ComplEx</th>
<td id="S3.T1.6.5.2" class="ltx_td ltx_align_center" style="padding-left:7.7pt;padding-right:7.7pt;">0.278</td>
<td id="S3.T1.6.5.3" class="ltx_td ltx_align_center" style="padding-left:7.7pt;padding-right:7.7pt;">0.194</td>
