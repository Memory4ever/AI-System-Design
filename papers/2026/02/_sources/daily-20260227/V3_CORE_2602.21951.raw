<th id="A3.T8.2.1.2" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt"><span id="A3.T8.2.1.2.1" class="ltx_text ltx_font_bold">MRR</span></th></tr>
</thead>
<tbody class="ltx_tbody">
<tr id="A3.T8.2.2" class="ltx_tr">
