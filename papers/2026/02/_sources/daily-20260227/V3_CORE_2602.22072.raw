<span id="S5.T2.3.5.3.1" class="ltx_inline-block ltx_align_top">
<span id="S5.T2.3.5.3.1.1" class="ltx_p ltx_align_center"><span id="S5.T2.3.5.3.1.1.1" class="ltx_text" style="font-size:70%;">0.549</span></span>
</span></td>
