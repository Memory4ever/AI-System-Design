<td id="S7.T5.7.3.2" class="ltx_td ltx_align_center ltx_border_bb ltx_border_t"><span id="S7.T5.7.3.2.1" class="ltx_text" style="--ltx-fg-color:#000000;">93.1</span></td>
<td id="S7.T5.7.3.3" class="ltx_td ltx_align_center ltx_border_bb ltx_border_t"><span id="S7.T5.7.3.3.1" class="ltx_text" style="--ltx-fg-color:#000000;">91.9</span></td>
<td id="S7.T5.7.3.4" class="ltx_td ltx_align_center ltx_border_bb ltx_border_t"><span id="S7.T5.7.3.4.1" class="ltx_text" style="--ltx-fg-color:#000000;">91.5</span></td>
<td id="S7.T5.7.3.5" class="ltx_td ltx_align_center ltx_border_bb ltx_border_t"><span id="S7.T5.7.3.5.1" class="ltx_text" style="--ltx-fg-color:#000000;">82.9</span></td>
<td id="S7.T5.7.3.6" class="ltx_td ltx_align_center ltx_border_bb ltx_border_t"><span id="S7.T5.7.3.6.1" class="ltx_text" style="--ltx-fg-color:#000000;">90.8</span></td></tr>
