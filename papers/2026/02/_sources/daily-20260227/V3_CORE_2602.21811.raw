<td id="S7.T6.10.1.11.8" class="ltx_td ltx_align_right" style="padding-left:2.0pt;padding-right:2.0pt;"><span id="S7.T6.10.1.11.8.1" class="ltx_text" style="font-size:70%;--ltx-fg-color:#000000;">0.1</span></td>
<td id="S7.T6.10.1.11.9" class="ltx_td ltx_align_right" style="padding-left:2.0pt;padding-right:2.0pt;"><span id="S7.T6.10.1.11.9.1" class="ltx_text" style="font-size:70%;--ltx-fg-color:#000000;">0.2</span></td>
<td id="S7.T6.10.1.11.10" class="ltx_td ltx_align_right" style="padding-left:2.0pt;padding-right:2.0pt;"><span id="S7.T6.10.1.11.10.1" class="ltx_text" style="font-size:70%;--ltx-fg-color:#000000;">0.3</span></td></tr>
<tr id="S7.T6.10.1.12" class="ltx_tr">
<th id="S7.T6.10.1.12.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_bb" style="padding-left:2.0pt;padding-right:2.0pt;"><span id="S7.T6.10.1.12.1.1" class="ltx_text" style="font-size:70%;--ltx-fg-color:#000000;">Mean Success Rate</span></th>
<td id="S7.T6.10.1.12.2" class="ltx_td ltx_align_right ltx_border_bb" style="padding-left:2.0pt;padding-right:2.0pt;"><span id="S7.T6.10.1.12.2.1" class="ltx_text" style="font-size:70%;--ltx-fg-color:#000000;">76.5</span></td>
<td id="S7.T6.10.1.12.3" class="ltx_td ltx_align_right ltx_border_bb" style="padding-left:2.0pt;padding-right:2.0pt;"><span id="S7.T6.10.1.12.3.1" class="ltx_text" style="font-size:70%;--ltx-fg-color:#000000;">75.6</span></td>
<td id="S7.T6.10.1.12.4" class="ltx_td ltx_align_right ltx_border_bb" style="padding-left:2.0pt;padding-right:2.0pt;"><span id="S7.T6.10.1.12.4.1" class="ltx_text" style="font-size:70%;--ltx-fg-color:#000000;">75.8</span></td>
<td id="S7.T6.10.1.12.5" class="ltx_td ltx_align_right ltx_border_bb" style="padding-left:2.0pt;padding-right:2.0pt;"><span id="S7.T6.10.1.12.5.1" class="ltx_text" style="font-size:70%;--ltx-fg-color:#000000;">75.9</span></td>
