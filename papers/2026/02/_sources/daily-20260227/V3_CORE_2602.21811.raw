<th id="S7.T3.17.1.3" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt"><span id="S7.T3.17.1.3.1" class="ltx_text" style="font-size:90%;--ltx-fg-color:#000000;">25k</span></th>
<th id="S7.T3.17.1.4" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt"><span id="S7.T3.17.1.4.1" class="ltx_text ltx_font_bold" style="font-size:90%;--ltx-fg-color:#000000;">50k</span></th></tr>
