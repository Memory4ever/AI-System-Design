<td id="S7.T3.17.2.2" class="ltx_td ltx_align_center ltx_border_t"><span id="S7.T3.17.2.2.1" class="ltx_text" style="font-size:90%;--ltx-fg-color:#000000;">89.3<math id="S7.T3.m1" class="ltx_Math" alttext="\pm" display="inline" intent=":literal"><semantics><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" mathsize="0.780em">±</mo><annotation encoding="application/x-tex">\pm</annotation></semantics></math><span id="S7.T3.17.2.2.1.1" class="ltx_text" style="font-size:78%;">4.5</span></span></td>
