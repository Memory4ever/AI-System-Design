<td id="S7.T3.17.2.4" class="ltx_td ltx_align_center ltx_border_t"><span id="S7.T3.17.2.4.1" class="ltx_text ltx_font_bold" style="font-size:90%;--ltx-fg-color:#000000;">96.5<math id="S7.T3.m3" class="ltx_Math" alttext="\pm" display="inline" intent=":literal"><semantics><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" mathsize="0.780em">±</mo><annotation encoding="application/x-tex">\pm</annotation></semantics></math><span id="S7.T3.17.2.4.1.1" class="ltx_text" style="font-size:78%;">0.9</span></span></td></tr>
