<td id="S7.T5.7.2.5" class="ltx_td ltx_align_center ltx_border_t"><span id="S7.T5.7.2.5.1" class="ltx_text" style="--ltx-fg-color:#000000;">0.2</span></td>
<td id="S7.T5.7.2.6" class="ltx_td ltx_align_center ltx_border_t"><math id="S7.T5.m1" class="ltx_math_unparsed" alttext="[0\sim 1.0]" display="inline" intent=":literal"><semantics><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">[</mo><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">0</mn><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">∼</mo><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">1.0</mn><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">]</mo></mrow><annotation encoding="application/x-tex">[0\sim 1.0]</annotation></semantics></math><span id="S7.T5.7.2.6.1" class="ltx_text" style="--ltx-fg-color:#000000;"> (random)</span></td></tr>
