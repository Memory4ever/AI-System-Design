<td id="S7.T6.10.1.12.10" class="ltx_td ltx_align_right ltx_border_bb" style="padding-left:2.0pt;padding-right:2.0pt;"><span id="S7.T6.10.1.12.10.1" class="ltx_text" style="font-size:70%;--ltx-fg-color:#000000;">72.2</span></td></tr>
