<td id="S4.T5.5.2.2" class="ltx_td ltx_nopad_l ltx_nopad_r ltx_align_center ltx_border_r ltx_border_t" style="padding-left:1.5pt;padding-right:1.5pt;"><span id="S4.T5.5.2.2.1" class="ltx_text" style="font-size:90%;">1.000</span></td>
<td id="S4.T5.5.2.3" class="ltx_td ltx_nopad_l ltx_nopad_r ltx_align_center ltx_border_r ltx_border_t" style="padding-left:1.5pt;padding-right:1.5pt;"><span id="S4.T5.5.2.3.1" class="ltx_text" style="font-size:90%;">39.142</span></td>
<td id="S4.T5.5.2.4" class="ltx_td ltx_nopad_l ltx_nopad_r ltx_align_center ltx_border_r ltx_border_t" style="padding-left:1.5pt;padding-right:1.5pt;"><span id="S4.T5.5.2.4.1" class="ltx_text" style="font-size:90%;">0.880</span></td>
<td id="S4.T5.5.2.5" class="ltx_td ltx_nopad_l ltx_nopad_r ltx_align_center ltx_border_r ltx_border_t" style="padding-left:1.5pt;padding-right:1.5pt;"><span id="S4.T5.5.2.5.1" class="ltx_text" style="font-size:90%;">0.070</span></td>
<td id="S4.T5.5.2.6" class="ltx_td ltx_nopad_l ltx_nopad_r ltx_align_center ltx_border_t" style="padding-left:1.5pt;padding-right:1.5pt;"><span id="S4.T5.5.2.6.1" class="ltx_text" style="font-size:90%;">0.016</span></td></tr>
<tr id="S4.T5.5.3" class="ltx_tr">
<td id="S4.T5.5.3.1" class="ltx_td ltx_nopad_l ltx_nopad_r ltx_align_left" style="padding-left:1.5pt;padding-right:1.5pt;"><span id="S4.T5.5.3.1.1" class="ltx_text ltx_font_bold" style="font-size:90%;">DiffPure<span id="S4.T5.5.3.1.1.1" class="ltx_text ltx_font_medium">  <span class="ltx_rule" style="width:1.0pt;--ltx-bg-color:black;display:inline-block;"> </span></span></span></td>
