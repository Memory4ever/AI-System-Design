<td id="S5.T7.5.6.3" class="ltx_td ltx_nopad_l ltx_nopad_r ltx_align_right" style="padding-left:1.5pt;padding-right:1.5pt;"><span id="S5.T7.5.6.3.1" class="ltx_text ltx_font_bold" style="font-size:90%;--ltx-bg-color:#D9D9D9;">0.6813<span id="S5.T7.5.6.3.1.1" class="ltx_text ltx_font_medium">  <span class="ltx_rule" style="width:1.0pt;--ltx-bg-color:black;display:inline-block;"> </span></span></span></td>
