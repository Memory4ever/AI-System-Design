<td id="A0.T16.7.1.2" class="ltx_td ltx_nopad_l ltx_align_center" style="padding-left:1.5pt;padding-right:1.5pt;" colspan="6"><span id="A0.T16.7.1.2.1" class="ltx_text ltx_font_bold" style="font-size:90%;">Proportion of image pairs where GPT-4o image has better utility</span></td></tr>
<tr id="A0.T16.7.2" class="ltx_tr">
<td id="A0.T16.7.2.1" class="ltx_td ltx_nopad_r ltx_align_right" style="padding-left:1.5pt;padding-right:1.5pt;"><span id="A0.T16.7.2.1.1" class="ltx_text" style="font-size:90%;"> <span class="ltx_rule" style="width:1.0pt;--ltx-bg-color:black;display:inline-block;"> </span></span></td>
<td id="A0.T16.7.2.2" class="ltx_td ltx_nopad_l ltx_align_right ltx_border_t" style="padding-left:1.5pt;padding-right:1.5pt;" colspan="2"><span id="A0.T16.7.2.2.1" class="ltx_text ltx_font_bold" style="font-size:90%;">Quality metrics ↑<span id="A0.T16.7.2.2.1.1" class="ltx_text ltx_font_medium">  <span class="ltx_rule" style="width:1.0pt;--ltx-bg-color:black;display:inline-block;"> </span></span></span></td>
<td id="A0.T16.7.2.3" class="ltx_td ltx_nopad_l ltx_align_center ltx_border_t" style="padding-left:1.5pt;padding-right:1.5pt;" colspan="4"><span id="A0.T16.7.2.3.1" class="ltx_text ltx_font_bold" style="font-size:90%;">Concept-appropriateness metrics ↑</span></td></tr>
<tr id="A0.T16.7.3" class="ltx_tr">
<td id="A0.T16.7.3.1" class="ltx_td ltx_nopad_r ltx_align_right" style="padding-left:1.5pt;padding-right:1.5pt;"><span id="A0.T16.7.3.1.1" class="ltx_text" style="font-size:90%;"> <span class="ltx_rule" style="width:1.0pt;--ltx-bg-color:black;display:inline-block;"> </span></span></td>
<td id="A0.T16.7.3.2" class="ltx_td ltx_nopad_l ltx_nopad_r ltx_align_center ltx_border_r ltx_border_t" style="padding-left:1.5pt;padding-right:1.5pt;"><span id="A0.T16.7.3.2.1" class="ltx_text ltx_font_bold" style="font-size:90%;">Noise</span></td>
<td id="A0.T16.7.3.3" class="ltx_td ltx_nopad_l ltx_align_right ltx_border_t" style="padding-left:1.5pt;padding-right:1.5pt;"><span id="A0.T16.7.3.3.1" class="ltx_text ltx_font_bold" style="font-size:90%;">Artifacts<span id="A0.T16.7.3.3.1.1" class="ltx_text ltx_font_medium">  <span class="ltx_rule" style="width:1.0pt;--ltx-bg-color:black;display:inline-block;"> </span></span></span></td>
<td id="A0.T16.7.3.4" class="ltx_td ltx_nopad_l ltx_nopad_r ltx_align_center ltx_border_r ltx_border_t" style="padding-left:1.5pt;padding-right:1.5pt;"><span id="A0.T16.7.3.4.1" class="ltx_text ltx_font_bold" style="font-size:90%;">Detail</span></td>
<td id="A0.T16.7.3.5" class="ltx_td ltx_nopad_l ltx_nopad_r ltx_align_center ltx_border_r ltx_border_t" style="padding-left:1.5pt;padding-right:1.5pt;"><span id="A0.T16.7.3.5.1" class="ltx_text ltx_font_bold" style="font-size:90%;">Concept fit</span></td>
<td id="A0.T16.7.3.6" class="ltx_td ltx_nopad_l ltx_nopad_r ltx_align_center ltx_border_r ltx_border_t" style="padding-left:1.5pt;padding-right:1.5pt;"><span id="A0.T16.7.3.6.1" class="ltx_text ltx_font_bold" style="font-size:90%;">Prompt fit</span></td>
<td id="A0.T16.7.3.7" class="ltx_td ltx_nopad_l ltx_align_center ltx_border_t" style="padding-left:1.5pt;padding-right:1.5pt;"><span id="A0.T16.7.3.7.1" class="ltx_text ltx_font_bold" style="font-size:90%;">Overall realism</span></td></tr>
<tr id="A0.T16.7.4" class="ltx_tr">
<td id="A0.T16.7.4.1" class="ltx_td ltx_nopad_l ltx_nopad_r ltx_align_left ltx_border_t" style="padding-left:1.5pt;padding-right:1.5pt;"><span id="A0.T16.7.4.1.1" class="ltx_text ltx_font_bold" style="font-size:90%;">GPT-4o vs. LightShed<span id="A0.T16.7.4.1.1.1" class="ltx_text ltx_font_medium">  <span class="ltx_rule" style="width:1.0pt;--ltx-bg-color:black;display:inline-block;"> </span></span></span></td>
