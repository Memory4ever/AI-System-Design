<tr id="S4.T5.5.4" class="ltx_tr">
<td id="S4.T5.5.4.1" class="ltx_td ltx_nopad_l ltx_nopad_r ltx_align_left" style="padding-left:1.5pt;padding-right:1.5pt;"><span id="S4.T5.5.4.1.1" class="ltx_text ltx_font_bold" style="font-size:90%;">Regen-VAE C<span id="S4.T5.5.4.1.1.1" class="ltx_text ltx_font_medium">  <span class="ltx_rule" style="width:1.0pt;--ltx-bg-color:black;display:inline-block;"> </span></span></span></td>
