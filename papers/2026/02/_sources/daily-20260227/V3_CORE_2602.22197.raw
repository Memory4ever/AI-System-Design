<td id="A0.T11.5.7.5" class="ltx_td ltx_nopad_l ltx_nopad_r ltx_align_center ltx_border_t" style="padding-left:1.5pt;padding-right:1.5pt;"><span id="A0.T11.5.7.5.1" class="ltx_text" style="font-size:90%;">0.0248</span></td></tr>
<tr id="A0.T11.5.8" class="ltx_tr">
<td id="A0.T11.5.8.1" class="ltx_td ltx_nopad_l ltx_nopad_r ltx_align_left" style="padding-left:1.5pt;padding-right:1.5pt;"><span id="A0.T11.5.8.1.1" class="ltx_text ltx_font_bold" style="font-size:90%;">SDXL<span id="A0.T11.5.8.1.1.1" class="ltx_text ltx_font_medium">  <span class="ltx_rule" style="width:1.0pt;--ltx-bg-color:black;display:inline-block;"> </span></span></span></td>
