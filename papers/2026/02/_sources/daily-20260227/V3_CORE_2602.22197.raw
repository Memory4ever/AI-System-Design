<td id="S5.T7.5.2.1" class="ltx_td ltx_nopad_l ltx_nopad_r ltx_align_left" style="padding-left:1.5pt;padding-right:1.5pt;"><span id="S5.T7.5.2.1.1" class="ltx_text ltx_font_bold" style="font-size:90%;">Protection<span id="S5.T7.5.2.1.1.1" class="ltx_text ltx_font_medium">  <span class="ltx_rule" style="width:1.0pt;--ltx-bg-color:black;display:inline-block;"> </span></span></span></td>
<td id="S5.T7.5.2.2" class="ltx_td ltx_nopad_l ltx_nopad_r ltx_align_center ltx_border_r ltx_border_t" style="padding-left:1.5pt;padding-right:1.5pt;">
<table id="S5.T7.5.2.2.1" class="ltx_tabular ltx_align_middle">
<tr id="S5.T7.5.2.2.1.1" class="ltx_tr">
<td id="S5.T7.5.2.2.1.1.1" class="ltx_td ltx_nopad_l ltx_nopad_r ltx_align_center" style="padding-left:1.5pt;padding-right:1.5pt;"><span id="S5.T7.5.2.2.1.1.1.1" class="ltx_text ltx_font_bold" style="font-size:90%;">Inv.</span></td></tr>
<tr id="S5.T7.5.2.2.1.2" class="ltx_tr">
<td id="S5.T7.5.2.2.1.2.1" class="ltx_td ltx_nopad_l ltx_nopad_r ltx_align_center" style="padding-left:1.5pt;padding-right:1.5pt;"><span id="S5.T7.5.2.2.1.2.1.1" class="ltx_text ltx_font_bold" style="font-size:90%;">Dist. ↓</span></td></tr>
</table></td>
<td id="S5.T7.5.2.3" class="ltx_td ltx_nopad_l ltx_nopad_r ltx_align_right ltx_border_t" style="padding-left:1.5pt;padding-right:1.5pt;">
<table id="S5.T7.5.2.3.1" class="ltx_tabular ltx_align_middle">
<tr id="S5.T7.5.2.3.1.1" class="ltx_tr">
<td id="S5.T7.5.2.3.1.1.1" class="ltx_td ltx_nopad_l ltx_nopad_r ltx_align_center" style="padding-left:1.5pt;padding-right:1.5pt;"><span id="S5.T7.5.2.3.1.1.1.1" class="ltx_text ltx_font_bold" style="font-size:90%;">TPR@FPR</span></td></tr>
<tr id="S5.T7.5.2.3.1.2" class="ltx_tr">
<td id="S5.T7.5.2.3.1.2.1" class="ltx_td ltx_nopad_l ltx_nopad_r ltx_align_center" style="padding-left:1.5pt;padding-right:1.5pt;"><span id="S5.T7.5.2.3.1.2.1.1" class="ltx_text ltx_font_bold" style="font-size:90%;">= 0.01 ↓</span></td></tr>
</table><span id="S5.T7.5.2.3.2" class="ltx_text" style="font-size:90%;">  <span class="ltx_rule" style="width:1.0pt;--ltx-bg-color:black;display:inline-block;"> </span></span></td>
<td id="S5.T7.5.2.4" class="ltx_td ltx_nopad_l ltx_nopad_r ltx_align_center ltx_border_r ltx_border_t" style="padding-left:1.5pt;padding-right:1.5pt;">
