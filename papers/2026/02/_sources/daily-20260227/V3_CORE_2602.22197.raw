<td id="S4.T5.5.1.5" class="ltx_td ltx_nopad_l ltx_nopad_r ltx_align_center ltx_border_r" style="padding-left:1.5pt;padding-right:1.5pt;"><span id="S4.T5.5.1.5.1" class="ltx_text ltx_font_bold" style="font-size:90%;">KID ↓</span></td>
