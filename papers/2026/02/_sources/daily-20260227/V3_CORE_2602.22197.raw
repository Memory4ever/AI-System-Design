<tr id="S2.T1.5.7" class="ltx_tr">
<td id="S2.T1.5.7.1" class="ltx_td ltx_nopad_r ltx_align_right" style="padding-left:1.2pt;padding-right:1.2pt;"><span id="S2.T1.5.7.1.1" class="ltx_text" style="font-size:90%;"> <span class="ltx_rule" style="width:1.0pt;--ltx-bg-color:black;display:inline-block;"> </span></span></td>
<td id="S2.T1.5.7.2" class="ltx_td ltx_nopad_l ltx_align_center ltx_border_t" style="padding-left:1.2pt;padding-right:1.2pt;" colspan="2"><span id="S2.T1.5.7.2.1" class="ltx_text ltx_font_bold" style="font-size:90%;">Our attack Vs. protection-specific attacks</span></td></tr>
<tr id="S2.T1.5.8" class="ltx_tr">
<td id="S2.T1.5.8.1" class="ltx_td ltx_nopad_r ltx_align_right" style="padding-left:1.2pt;padding-right:1.2pt;"><span id="S2.T1.5.8.1.1" class="ltx_text" style="font-size:90%;"> <span class="ltx_rule" style="width:1.0pt;--ltx-bg-color:black;display:inline-block;"> </span></span></td>
<td id="S2.T1.5.8.2" class="ltx_td ltx_nopad_l ltx_nopad_r ltx_align_center ltx_border_r ltx_border_t" style="padding-left:1.2pt;padding-right:1.2pt;">
<table id="S2.T1.5.8.2.1" class="ltx_tabular ltx_align_middle">
<tr id="S2.T1.5.8.2.1.1" class="ltx_tr">
