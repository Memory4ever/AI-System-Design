<td id="S4.T2.8.9.2" class="ltx_td ltx_nopad_l ltx_nopad_r ltx_align_center ltx_border_r" style="padding-left:1.5pt;padding-right:1.5pt;"><span id="S4.T2.8.9.2.1" class="ltx_text" style="font-size:90%;">76.07%</span></td>
