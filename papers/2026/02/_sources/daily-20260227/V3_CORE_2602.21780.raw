<tr id="S3.T2.5.1.5" class="ltx_tr">
<td id="S3.T2.5.1.5.1" class="ltx_td ltx_align_center">StreamVGGT</td>
<td id="S3.T2.5.1.5.2" class="ltx_td ltx_align_center"><span id="S3.T2.5.1.5.2.1" class="ltx_text ltx_font_italic">Online</span></td>
<td id="S3.T2.5.1.5.3" class="ltx_td ltx_align_center"><span id="S3.T2.5.1.5.3.1" class="ltx_text ltx_font_italic">Unbounded Memory</span></td>
