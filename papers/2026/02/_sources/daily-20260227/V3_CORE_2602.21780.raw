<tr id="S3.T2.5.1.2" class="ltx_tr">
<td id="S3.T2.5.1.2.1" class="ltx_td"></td>
<td id="S3.T2.5.1.2.2" class="ltx_td"></td>
<td id="S3.T2.5.1.2.3" class="ltx_td"></td>
<td id="S3.T2.5.1.2.4" class="ltx_td ltx_align_center ltx_border_t" colspan="2">Acc <math id="S3.T2.m1" class="ltx_Math" alttext="\downarrow" display="inline" intent=":literal"><semantics><mo stretchy="false">↓</mo><annotation encoding="application/x-tex">\downarrow</annotation></semantics></math></td>
<td id="S3.T2.5.1.2.5" class="ltx_td ltx_align_center ltx_border_t" colspan="2">Comp <math id="S3.T2.m2" class="ltx_Math" alttext="\downarrow" display="inline" intent=":literal"><semantics><mo stretchy="false">↓</mo><annotation encoding="application/x-tex">\downarrow</annotation></semantics></math></td>
<td id="S3.T2.5.1.2.6" class="ltx_td ltx_align_center ltx_border_t" colspan="2">NC <math id="S3.T2.m3" class="ltx_Math" alttext="\uparrow" display="inline" intent=":literal"><semantics><mo stretchy="false">↑</mo><annotation encoding="application/x-tex">\uparrow</annotation></semantics></math></td></tr>
<tr id="S3.T2.5.1.3" class="ltx_tr">
