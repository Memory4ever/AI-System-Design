<td id="S3.T2.5.1.5.7" class="ltx_td ltx_align_center">0.038</td>
<td id="S3.T2.5.1.5.8" class="ltx_td ltx_align_center">0.862</td>
<td id="S3.T2.5.1.5.9" class="ltx_td ltx_nopad_r ltx_align_center">0.986</td></tr>
<tr id="S3.T2.5.1.6" class="ltx_tr">
<td id="S3.T2.5.1.6.1" class="ltx_td ltx_align_center ltx_border_bb"><span id="S3.T2.5.1.6.1.1" class="ltx_text ltx_font_bold">XStreamVGGT (Ours)</span></td>
