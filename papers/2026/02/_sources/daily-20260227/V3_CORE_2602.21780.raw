<td id="S3.T2.5.1.3.6" class="ltx_td ltx_align_center">Med.</td>
<td id="S3.T2.5.1.3.7" class="ltx_td ltx_align_center">Mean</td>
<td id="S3.T2.5.1.3.8" class="ltx_td ltx_nopad_r ltx_align_center">Med.</td></tr>
<tr id="S3.T2.5.1.4" class="ltx_tr">
<td id="S3.T2.5.1.4.1" class="ltx_td ltx_align_center ltx_border_t">VGGT</td>
<td id="S3.T2.5.1.4.2" class="ltx_td ltx_align_center ltx_border_t"><span id="S3.T2.5.1.4.2.1" class="ltx_text ltx_font_italic">Offline</span></td>
<td id="S3.T2.5.1.4.3" class="ltx_td ltx_align_center ltx_border_t"><span id="S3.T2.5.1.4.3.1" class="ltx_text ltx_font_italic">Unbounded Memory</span></td>
<td id="S3.T2.5.1.4.4" class="ltx_td ltx_align_center ltx_border_t">0.079</td>
