<td id="S3.T2.2.2.2" class="ltx_td ltx_align_center ltx_border_t">9380</td>
<td id="S3.T2.2.2.3" class="ltx_td ltx_align_center ltx_border_t">9380</td></tr>
<tr id="S3.T2.2.3" class="ltx_tr">
