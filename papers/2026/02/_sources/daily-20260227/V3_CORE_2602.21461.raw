<td id="S1.T1.10.1.3" class="ltx_td ltx_nopad_l ltx_nopad_r ltx_align_center ltx_border_tt" style="padding-left:1.0pt;padding-right:1.0pt;"><span id="S1.T1.10.1.3.1" class="ltx_text ltx_font_bold" style="font-size:80%;">Description</span></td></tr>
