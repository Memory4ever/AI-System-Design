</span></td>
<td id="S4.T6.6.4.4" class="ltx_td ltx_nopad_l ltx_nopad_r ltx_align_left ltx_align_top ltx_border_t" style="--ltx-bg-color:#B0DFC8;padding-left:1.0pt;padding-right:1.0pt;">
