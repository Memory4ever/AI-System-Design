<figcaption class="ltx_caption ltx_centering"><span class="ltx_tag ltx_tag_figure"><span id="S1.T5.fig1.2" class="ltx_text" style="font-size:90%;">Table 2</span>: </span><span id="S1.T5.fig1.3" class="ltx_text ltx_font_bold" style="font-size:90%;">Font filtering.</span></figcaption>
<div id="S1.T5.fig1.4" class="ltx_inline-block ltx_transformed_outer" style="width:178.3pt;height:58.2pt;vertical-align:-27.2pt;"><span class="ltx_transformed_inner" style="transform:translate(-4.7pt,1.5pt) scale(0.9,0.9) ;">
