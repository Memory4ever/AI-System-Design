<td id="S1.T1.10.2.3" class="ltx_td ltx_nopad_l ltx_nopad_r ltx_align_center ltx_border_t" style="padding-left:1.0pt;padding-right:1.0pt;">
<table id="S1.T1.10.2.3.1" class="ltx_tabular ltx_align_middle">
