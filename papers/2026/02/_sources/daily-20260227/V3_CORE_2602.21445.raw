<span id="S8.T7.8.1.1.1" class="ltx_tabular ltx_guessed_headers ltx_align_middle">
<span class="ltx_thead">
<span id="S8.T7.8.1.1.1.1" class="ltx_tr">
<span id="S8.T7.8.1.1.1.1.1" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_th_row ltx_border_r ltx_border_tt">Task Suite</span>
<span id="S8.T7.8.1.1.1.1.2" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt">LIB-Spatial</span>
<span id="S8.T7.8.1.1.1.1.3" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt">LIB-Object</span>
<span id="S8.T7.8.1.1.1.1.4" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt">LIB-Goal</span>
<span id="S8.T7.8.1.1.1.1.5" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt">LIB-10</span></span>
</span>
<span class="ltx_tbody">
