<section id="A1" class="ltx_appendix">
<h2 class="ltx_title ltx_title_appendix"><span class="ltx_tag ltx_tag_appendix">Appendix A </span>Editing Efficiency</h2>

<figure id="A1.T3" class="ltx_table">
<figcaption class="ltx_caption"><span class="ltx_tag ltx_tag_table"><span id="A1.T3.3" class="ltx_text" style="font-size:90%;">Table 3</span>: </span><span id="A1.T3.4" class="ltx_text" style="font-size:90%;">Runtime comparison with different methods.</span></figcaption>
<table id="A1.T3.5" class="ltx_tabular ltx_guessed_headers ltx_align_middle">
