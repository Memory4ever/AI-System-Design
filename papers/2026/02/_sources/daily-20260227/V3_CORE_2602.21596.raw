<tr id="S5.T2.2.1.5" class="ltx_tr">
<th id="S5.T2.2.1.5.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_r" rowspan="3"><span id="S5.T2.2.1.5.1.1" class="ltx_text">
<span id="S5.T2.2.1.5.1.1.1" class="ltx_inline-block ltx_transformed_outer" style="width:6.9pt;height:16.9pt;vertical-align:-0.0pt;"><span class="ltx_transformed_inner" style="width:16.9pt;transform:translate(-5.0pt,-5.0pt) rotate(-90deg) ;">
