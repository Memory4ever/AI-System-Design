<td id="S5.T2.2.1.3.2" class="ltx_td ltx_align_center ltx_border_t"><math id="S5.T2.m11" class="ltx_Math" alttext="\tau=0.01" display="inline" intent=":literal"><semantics><mrow><mi>τ</mi><mo>=</mo><mn>0.01</mn></mrow><annotation encoding="application/x-tex">\tau=0.01</annotation></semantics></math> (<math id="S5.T2.m12" class="ltx_Math" alttext="t_{i}" display="inline" intent=":literal"><semantics><msub><mi>t</mi><mi>i</mi></msub><annotation encoding="application/x-tex">t_{i}</annotation></semantics></math>)</td>
<td id="S5.T2.2.1.3.3" class="ltx_td ltx_align_center ltx_border_t">448/1152 (38.94%)</td>
