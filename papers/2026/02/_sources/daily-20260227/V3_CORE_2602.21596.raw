<td id="S4.T1.2.1.4.4" class="ltx_td ltx_align_center"><span id="S4.T1.2.1.4.4.1" class="ltx_text ltx_font_bold">1.60%</span></td>
<td id="S4.T1.2.1.4.5" class="ltx_td ltx_align_center"><span id="S4.T1.2.1.4.5.1" class="ltx_text ltx_font_bold">2.05%</span></td>
<td id="S4.T1.2.1.4.6" class="ltx_td ltx_align_center"><span id="S4.T1.2.1.4.6.1" class="ltx_text ltx_font_bold">1.73%</span></td>
<td id="S4.T1.2.1.4.7" class="ltx_td ltx_align_center"><span id="S4.T1.2.1.4.7.1" class="ltx_text ltx_font_bold">1.53%</span></td>
<td id="S4.T1.2.1.4.8" class="ltx_td ltx_align_center">48.42%</td>
<td id="S4.T1.2.1.4.9" class="ltx_td ltx_align_center">13.57%</td></tr>
<tr id="S4.T1.2.1.5" class="ltx_tr">
<th id="S4.T1.2.1.5.1" class="ltx_td ltx_align_center ltx_th ltx_th_row ltx_border_bb">Cosine Sim. (<math id="S4.T1.m4" class="ltx_Math" alttext="cs" display="inline" intent=":literal"><semantics><mrow><mi>c</mi><mo lspace="0em" rspace="0em">​</mo><mi>s</mi></mrow><annotation encoding="application/x-tex">cs</annotation></semantics></math>)</th>
<td id="S4.T1.2.1.5.2" class="ltx_td ltx_align_center ltx_border_bb">0.9001</td>
<td id="S4.T1.2.1.5.3" class="ltx_td ltx_align_center ltx_border_bb">0.9852</td>
<td id="S4.T1.2.1.5.4" class="ltx_td ltx_align_center ltx_border_bb">0.9905</td>
<td id="S4.T1.2.1.5.5" class="ltx_td ltx_align_center ltx_border_bb">0.9779</td>
