<th id="S5.T2.2.1.4.1" class="ltx_td ltx_th ltx_th_row ltx_border_r"></th>
<td id="S5.T2.2.1.4.2" class="ltx_td ltx_align_center"><math id="S5.T2.m13" class="ltx_Math" alttext="\tau=0.01" display="inline" intent=":literal"><semantics><mrow><mi>τ</mi><mo>=</mo><mn>0.01</mn></mrow><annotation encoding="application/x-tex">\tau=0.01</annotation></semantics></math> (<math id="S5.T2.m14" class="ltx_Math" alttext="t_{0}" display="inline" intent=":literal"><semantics><msub><mi>t</mi><mn>0</mn></msub><annotation encoding="application/x-tex">t_{0}</annotation></semantics></math>)</td>
<td id="S5.T2.2.1.4.3" class="ltx_td ltx_align_center">448/1152 (38.94%)</td>
<td id="S5.T2.2.1.4.4" class="ltx_td ltx_align_center"><span id="S5.T2.2.1.4.4.1" class="ltx_text ltx_font_bold">7.1690</span></td>
