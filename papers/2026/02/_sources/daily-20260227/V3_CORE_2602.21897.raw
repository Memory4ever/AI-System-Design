<div id="lstnumberx47" class="ltx_listingline"><span id="lstnumberx47.1" class="ltx_text ltx_lst_space" style="font-size:90%;">  </span><span id="lstnumberx47.2" class="ltx_text" style="font-size:90%;">cudaStreamSynchronize(</span><span id="lstnumberx47.3" class="ltx_text" style="font-size:90%;--ltx-fg-color:#666666;">&amp;</span><span id="lstnumberx47.4" class="ltx_text" style="font-size:90%;">stream);</span>
</div>
<div id="lstnumberx48" class="ltx_listingline"><span id="lstnumberx48.1" class="ltx_text" style="font-size:90%;">}</span>
</div>
<div id="lstnumberx49" class="ltx_listingline"><span id="lstnumberx49.1" class="ltx_text ltx_font_bold" style="font-size:90%;--ltx-fg-color:#B00040;">int<span id="lstnumberx49.1.1" class="ltx_text ltx_lst_space ltx_font_medium" style="--ltx-fg-color:#000000;"> </span></span><span id="lstnumberx49.2" class="ltx_text" style="font-size:90%;--ltx-fg-color:#0000FF;">main</span><span id="lstnumberx49.3" class="ltx_text" style="font-size:90%;">()</span><span id="lstnumberx49.4" class="ltx_text ltx_lst_space" style="font-size:90%;"> </span><span id="lstnumberx49.5" class="ltx_text" style="font-size:90%;">{</span>
</div>
<div id="lstnumberx50" class="ltx_listingline"><span id="lstnumberx50.1" class="ltx_text ltx_lst_space" style="font-size:90%;">  </span><span id="lstnumberx50.2" class="ltx_text" style="font-size:90%;">[…]</span>
</div>
<div id="lstnumberx51" class="ltx_listingline"><span id="lstnumberx51.1" class="ltx_text ltx_lst_space" style="font-size:90%;">  </span><span id="lstnumberx51.2" class="ltx_text ltx_font_bold" style="font-size:90%;--ltx-fg-color:#008000;">for<span id="lstnumberx51.2.1" class="ltx_text ltx_lst_space ltx_font_medium" style="--ltx-fg-color:#000000;"> </span></span><span id="lstnumberx51.3" class="ltx_text" style="font-size:90%;">(</span><span id="lstnumberx51.4" class="ltx_text ltx_font_bold" style="font-size:90%;--ltx-fg-color:#B00040;">int<span id="lstnumberx51.4.1" class="ltx_text ltx_lst_space ltx_font_medium" style="--ltx-fg-color:#000000;"> </span></span><span id="lstnumberx51.5" class="ltx_text" style="font-size:90%;">i</span><span id="lstnumberx51.6" class="ltx_text ltx_lst_space" style="font-size:90%;"> </span><span id="lstnumberx51.7" class="ltx_text" style="font-size:90%;--ltx-fg-color:#666666;">=<span id="lstnumberx51.7.1" class="ltx_text ltx_lst_space" style="--ltx-fg-color:#000000;"> </span>0</span><span id="lstnumberx51.8" class="ltx_text" style="font-size:90%;">;</span><span id="lstnumberx51.9" class="ltx_text ltx_lst_space" style="font-size:90%;"> </span><span id="lstnumberx51.10" class="ltx_text" style="font-size:90%;">i</span><span id="lstnumberx51.11" class="ltx_text ltx_lst_space" style="font-size:90%;"> </span><span id="lstnumberx51.12" class="ltx_text" style="font-size:90%;--ltx-fg-color:#666666;">&lt;<span id="lstnumberx51.12.1" class="ltx_text ltx_lst_space" style="--ltx-fg-color:#000000;"> </span></span><span id="lstnumberx51.13" class="ltx_text" style="font-size:90%;">N;</span><span id="lstnumberx51.14" class="ltx_text ltx_lst_space" style="font-size:90%;"> </span><span id="lstnumberx51.15" class="ltx_text" style="font-size:90%;--ltx-fg-color:#666666;">++</span><span id="lstnumberx51.16" class="ltx_text" style="font-size:90%;">i)</span><span id="lstnumberx51.17" class="ltx_text ltx_lst_space" style="font-size:90%;"> </span><span id="lstnumberx51.18" class="ltx_text" style="font-size:90%;">{</span>
</div>
<div id="lstnumberx52" class="ltx_listingline"><span id="lstnumberx52.1" class="ltx_text ltx_lst_space" style="font-size:90%;">    </span><span id="lstnumberx52.2" class="ltx_text ltx_font_italic" style="font-size:90%;--ltx-fg-color:#9C6600;">#pragma<span id="lstnumberx52.2.1" class="ltx_text ltx_lst_space"> </span>omp<span id="lstnumberx52.2.2" class="ltx_text ltx_lst_space"> </span>task<span id="lstnumberx52.2.3" class="ltx_text ltx_lst_space"> </span>depend(out:<span id="lstnumberx52.2.4" class="ltx_text ltx_lst_space"> </span>x[i])<span id="lstnumberx52.2.5" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx52.2.6" class="ltx_text" style="--ltx-fg-color:#3D7A7A;">//<span id="lstnumberx52.2.6.1" class="ltx_text ltx_lst_space"> </span>C1</span></span>
</div>
<div id="lstnumberx53" class="ltx_listingline"><span id="lstnumberx53.1" class="ltx_text ltx_lst_space" style="font-size:90%;">    </span><span id="lstnumberx53.2" class="ltx_text" style="font-size:90%;">cpu_task_1(</span><span id="lstnumberx53.3" class="ltx_text" style="font-size:90%;--ltx-fg-color:#666666;">&amp;</span><span id="lstnumberx53.4" class="ltx_text" style="font-size:90%;">x[i]);</span>
</div>
