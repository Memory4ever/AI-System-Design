.98 451.83)"><foreignObject style="--ltx-fo-width:2.79em;--ltx-fo-height:0.68em;--ltx-fo-depth:0em;font-size:10pt;" height="9.46" overflow="visible" transform="matrix(1 0 0 -1 0 9.46)" width="38.67"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><span id="S2.F1.pic1.55" class="ltx_text">Linear</span></span></span></foreignObject></g><g stroke-width="1.2pt"><path style="fill:none" d="M 467.31 411.56 L 467.31 435.09"></path><g transform="matrix(0.0 1.0 -1.0 0.0 467.31 435.09)"><path style="stroke:none" d="M 7.97 0 C 5.61 0.44 1.77 1.77 -0.89 3.32 L -0.89 -3.32 C 1.77 -1.77 5.61 -0.44 7.97 0"></path></g></g></g><g stroke-width="1.2pt"><path style="fill:none" d="M 523.34 247.2 M 528.35 242.43 C 530.57 241.75 533.24 242.56 535.63 245.06 L 539.15 248.76 C 541.53 251.27 544.21 252.07 546.43 251.39 C 545.64 253.57 546.3 256.28 548.69 258.79 L 552.21 262.49 C 554.59 265 555.26 267.71 554.47 269.89"></path><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;--ltx-fg-color:#000000;" color="#000000" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 549.54 242.97)"><foreignObject style="--ltx-fg-color:#000000;--ltx-fo-width:1.58em;--ltx-fo-height:0.69em;--ltx-fo-depth:0.08em;font-size:10pt;" color="#000000" height="10.76" overflow="visible" transform="matrix(1 0 0 -1 0 9.61)" width="21.81"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S2.F1.pic1.m2" class="ltx_math_unparsed" alttext="h\times" display="inline" intent=":literal"><semantics><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">h</mi><mo style="--ltx-fg-color:#000000;" lspace="0.222em" mathcolor="#000000">×</mo></mrow><annotation encoding="application/x-tex">h\times</annotation></semantics></math></span></span></foreignObject></g></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(0.0 1.0 -1.0 0.0 373.14 194.81)"><foreignObject style="--ltx-fo-width:7.92em;--ltx-fo-height:0.69em;--ltx-fo-depth:0em;font-size:10pt;" height="9.61" overflow="visible" transform="matrix(1 0 0 -1 0 9.61)" width="109.62"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><span id="S2.F1.pic1.56" class="ltx_text">Masked Attention</span></span></span></foreignObject></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 374.49 556.39)"><foreignObject style="--ltx-fo-width:13.47em;--ltx-fo-height:0.69em;--ltx-fo-depth:0.19em;font-size:10pt;" height="12.3" overflow="visible" transform="matrix(1 0 0 -1 0 9.61)" width="186.42"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><span id="S2.F1.pic1.57" class="ltx_text">Multi-Head Attention Output </span></span></span></foreignObject></g><g fill-opacity="0.2" stroke-opacity="0.2" stroke-width="1.2pt"><path style="fill:none" d="M 505.16 493.39 C 505.16 519.59 467.31 513.37 467.31 540.84"></path><g transform="matrix(0.0 1.0 -1.0 0.0 467.31 540.84)"><path style="stroke:none" d="M 7.97 0 C 5.61 0.44 1.77 1.77 -0.89 3.32 L -0.89 -3.32 C 1.77 -1.77 5.61 -0.44 7.97 0"></path></g></g><g fill-opacity="0.4" stroke-opacity="0.4" stroke-width="1.2pt"><path style="fill:none" d="M 497.28 485.51 C 497.28 512.86 467.31 513.37 467.31 540.84"></path><g transform="matrix(0.0 1.0 -1.0 0.0 467.31 540.84)"><path style="stroke:none" d="M 7.97 0 C 5.61 0.44 1.77 1.77 -0.89 3.32 L -0.89 -3.32 C 1.77 -1.77 5.61 -0.44 7.97 0"></path></g></g><g fill-opacity="0.6" stroke-opacity="0.6" stroke-width="1.2pt"><path style="fill:none" d="M 489.41 477.64 C 489.41 506.75 467.31 513.37 467.31 540.84"></path><g transform="matrix(0.0 1.0 -1.0 0.0 467.31 540.84)"><path style="stroke:none" d="M 7.97 0 C 5.61 0.44 1.77 1.77 -0.89 3.32 L -0.89 -3.32 C 1.77 -1.77 5.61 -0.44 7.97 0"></path></g></g><g fill-opacity="0.8" stroke-opacity="0.8" stroke-width="1.2pt"><path style="fill:none" d="M 481.53 469.77 C 481.53 501.2 467.31 513.37 467.31 540.84"></path><g transform="matrix(0.0 1.0 -1.0 0.0 467.31 540.84)"><path style="stroke:none" d="M 7.97 0 C 5.61 0.44 1.77 1.77 -0.89 3.32 L -0.89 -3.32 C 1.77 -1.77 5.61 -0.44 7.97 0"></path></g></g><g fill-opacity="1.0" stroke-opacity="1.0" stroke-width="1.2pt"><path style="fill:none" d="M 467.31 470.07 C 467.31 500.77 467.31 513.37 467.31 540.84"></path><g transform="matrix(0.0 1.0 -1.0 0.0 467.31 540.84)"><path style="stroke:none" d="M 7.97 0 C 5.61 0.44 1.77 1.77 -0.89 3.32 L -0.89 -3.32 C 1.77 -1.77 5.61 -0.44 7.97 0"></path></g></g><g style="--ltx-stroke-color:#FF6666;" stroke="#FF6666" stroke-dasharray="3.0pt,3.0pt" stroke-dashoffset="0.0pt" stroke-width="2.0pt"><path style="fill:none" d="M 269.99 204.07 L 353.34 508.55"></path></g><g style="--ltx-stroke-color:#FF6666;" stroke="#FF6666" stroke-dasharray="3.0pt,3.0pt" stroke-dashoffset="0.0pt" stroke-width="2.0pt"><path style="fill:none" d="M 269.99 161.08 L 353.34 28.14"></path></g><g style="--ltx-stroke-color:#FF6666;--ltx-fill-color:#FF6666;--ltx-fg-color:#FF6666;" color="#FF6666" fill="#FF6666" fill-opacity="0.2" stroke="#FF6666"><path style="stroke:none" d="M 269.99 204.07 L 269.99 161.08 L 353.34 28.14 L 353.34 508.55 Z"></path></g></g></g></svg></span>
</span></div>
<figcaption class="ltx_caption ltx_centering"><span class="ltx_tag ltx_tag_figure">Figure 1: </span>Modified architecture of the GPT-2 model used in this work.</figcaption>
</figure>
<div id="S2.SS5.p2" class="ltx_para">
<p id="S2.SS5.p2.1" class="ltx_p">The GPT-2 model used in this work is based on Andrej Karpathy’s
open-source repository <span id="S2.SS5.p2.1.1" class="ltx_text ltx_font_typewriter">llm.c</span> published on GitHub in
2024 <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib19" title="" class="ltx_ref">19</a>]</cite>. The architecture of this model
largely follows that of the aforementioned original
works <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib29" title="" class="ltx_ref">29</a>]</cite> with some minor modifications.
Figure <a href="#S2.F1" title="Figure 1 ‣ 2.5 GPT-2 pre-training ‣ 2 Background ‣ A Task-based Data-flow Methodology for Programming Heterogeneous Systems with Multiple Accelerator APIs©2026. This manuscript version is made available under the CC BY-NC-ND 4.0 license https://creativecommons.org/licenses/by-nc-nd/4.0/" class="ltx_ref"><span class="ltx_text ltx_ref_tag">1</span></a> shows the actual architecture used in this
study, composed of about a dozen of kernels (encoder, LayerNorm, GELU,
matmul …), with the following key differences:</p>
<ul id="S2.I1" class="ltx_itemize">
<li id="S2.I1.i1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">1.</span> 
<div id="S2.I1.i1.p1" class="ltx_para">
<p id="S2.I1.i1.p1.1" class="ltx_p">Dropout layers are removed.</p>
</div></li>
<li id="S2.I1.i2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">2.</span> 
<div id="S2.I1.i2.p1" class="ltx_para">
<p id="S2.I1.i2.p1.1" class="ltx_p">The second residual forward links to the output of the
multi-head attention layer, instead of the one associated with the
normalization layer.</p>
</div></li>
<li id="S2.I1.i3" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">3.</span> 
<div id="S2.I1.i3.p1" class="ltx_para">
<p id="S2.I1.i3.p1.1" class="ltx_p">The model’s last layer is the Softmax function.</p>
</div></li>
<li id="S2.I1.i4" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">4.</span> 
<div id="S2.I1.i4.p1" class="ltx_para">
<p id="S2.I1.i4.p1.1" class="ltx_p">The linear layers inside the multi-head attention mechanism
are fused with matmul functions.</p>
</div></li>
</ul>
</div>
<div id="S2.SS5.p3" class="ltx_para">
<p id="S2.SS5.p3.1" class="ltx_p">We employ the largest version of GPT-2 consisting of 1558 M parameters
that derive from 48 connected layers, 25 attention heads, and 1600
hidden dimensional states. The vocabulary consists of 50,257 tokens
and the maximum context length is 1024 tokens. We reutilize OpenAI’s
GPT-2 weights (32-bit precision) publicly available at its Hugging
Face repository <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib30" title="" class="ltx_ref">30</a>]</cite> and continue the
pre-training of GPT-2 over the TinyShakespeare
dataset <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib31" title="" class="ltx_ref">31</a>]</cite> composed of 305,260
tokens. The AdamW optimization function employs the following
parameters: <math id="S2.SS5.p3.m2" class="ltx_Math" alttext="\alpha=10^{-4}" display="inline" intent=":literal"><semantics><mrow><mi>α</mi><mo>=</mo><msup><mn>10</mn><mrow><mo>−</mo><mn>4</mn></mrow></msup></mrow><annotation encoding="application/x-tex">\alpha=10^{-4}</annotation></semantics></math>, <math id="S2.SS5.p3.m3" class="ltx_Math" alttext="\beta_{1}=0.9" display="inline" intent=":literal"><semantics><mrow><msub><mi>β</mi><mn>1</mn></msub><mo>=</mo><mn>0.9</mn></mrow><annotation encoding="application/x-tex">\beta_{1}=0.9</annotation></semantics></math>, <math id="S2.SS5.p3.m4" class="ltx_Math" alttext="\beta_{2}=0.999" display="inline" intent=":literal"><semantics><mrow><msub><mi>β</mi><mn>2</mn></msub><mo>=</mo><mn>0.999</mn></mrow><annotation encoding="application/x-tex">\beta_{2}=0.999</annotation></semantics></math>,
<math id="S2.SS5.p3.m5" class="ltx_Math" alttext="\epsilon=10^{-8}" display="inline" intent=":literal"><semantics><mrow><mi>ϵ</mi><mo>=</mo><msup><mn>10</mn><mrow><mo>−</mo><mn>8</mn></mrow></msup></mrow><annotation encoding="application/x-tex">\epsilon=10^{-8}</annotation></semantics></math>, and <math id="S2.SS5.p3.m6" class="ltx_Math" alttext="\lambda=0" display="inline" intent=":literal"><semantics><mrow><mi>λ</mi><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\lambda=0</annotation></semantics></math>. Finally, we reduce the context length and batch size to 256 and 4 tokens, respectively, to ensure that the model fits within the 64GB of HBM2 memory available on a single NVIDIA H100 GPU.</p>
</div>
<section id="S2.SS5.SSS1" class="ltx_subsubsection">
<h4 class="ltx_title ltx_title_subsubsection"><span class="ltx_tag ltx_tag_subsubsection">2.5.1 </span>GPT-2 fork-join parallelisation</h4>

<figure id="S2.F2" class="ltx_figure">
<div id="S2.F2.2" class="ltx_listing ltx_lstlisting ltx_listing"><div class="ltx_listing_data"><a href="data:text/plain;base64," download="">⬇</a></div>
<div id="lstnumberx1" class="ltx_listingline"><span id="lstnumberx1.1" class="ltx_text ltx_font_bold" style="font-size:90%;--ltx-fg-color:#008000;">const<span id="lstnumberx1.1.1" class="ltx_text ltx_lst_space ltx_font_medium" style="--ltx-fg-color:#000000;"> </span><span id="lstnumberx1.1.2" class="ltx_text" style="--ltx-fg-color:#B00040;">int<span id="lstnumberx1.1.2.1" class="ltx_text ltx_lst_space ltx_font_medium" style="--ltx-fg-color:#000000;"> </span></span></span><span id="lstnumberx1.2" class="ltx_text" style="font-size:90%;">o_start</span><span id="lstnumberx1.3" class="ltx_text ltx_lst_space" style="font-size:90%;"> </span><span id="lstnumberx1.4" class="ltx_text" style="font-size:90%;--ltx-fg-color:#666666;">=<span id="lstnumberx1.4.1" class="ltx_text ltx_lst_space" style="--ltx-fg-color:#000000;"> </span></span><span id="lstnumberx1.5" class="ltx_text" style="font-size:90%;">slh.dims_starts[</span><span id="lstnumberx1.6" class="ltx_text" style="font-size:90%;--ltx-fg-color:#666666;">0</span><span id="lstnumberx1.7" class="ltx_text" style="font-size:90%;">];</span>
</div>
<div id="lstnumberx2" class="ltx_listingline"><span id="lstnumberx2.1" class="ltx_text ltx_font_bold" style="font-size:90%;--ltx-fg-color:#008000;">const<span id="lstnumberx2.1.1" class="ltx_text ltx_lst_space ltx_font_medium" style="--ltx-fg-color:#000000;"> </span><span id="lstnumberx2.1.2" class="ltx_text" style="--ltx-fg-color:#B00040;">int<span id="lstnumberx2.1.2.1" class="ltx_text ltx_lst_space ltx_font_medium" style="--ltx-fg-color:#000000;"> </span></span></span><span id="lstnumberx2.2" class="ltx_text" style="font-size:90%;">o_end</span><span id="lstnumberx2.3" class="ltx_text ltx_lst_space" style="font-size:90%;"> </span><span id="lstnumberx2.4" class="ltx_text" style="font-size:90%;--ltx-fg-color:#666666;">=<span id="lstnumberx2.4.1" class="ltx_text ltx_lst_space" style="--ltx-fg-color:#000000;"> </span></span><span id="lstnumberx2.5" class="ltx_text" style="font-size:90%;">slh.dims_stops[</span><span id="lstnumberx2.6" class="ltx_text" style="font-size:90%;--ltx-fg-color:#666666;">0</span><span id="lstnumberx2.7" class="ltx_text" style="font-size:90%;">];</span>
</div>
<div id="lstnumberx3" class="ltx_listingline"><span id="lstnumberx3.1" class="ltx_text ltx_font_bold" style="font-size:90%;--ltx-fg-color:#008000;">if<span id="lstnumberx3.1.1" class="ltx_text ltx_lst_space ltx_font_medium" style="--ltx-fg-color:#000000;"> </span></span><span id="lstnumberx3.2" class="ltx_text" style="font-size:90%;">(dbias</span><span id="lstnumberx3.3" class="ltx_text ltx_lst_space" style="font-size:90%;"> </span><span id="lstnumberx3.4" class="ltx_text" style="font-size:90%;--ltx-fg-color:#666666;">!=<span id="lstnumberx3.4.1" class="ltx_text ltx_lst_space" style="--ltx-fg-color:#000000;"> </span><span id="lstnumberx3.4.2" class="ltx_text" style="--ltx-fg-color:#008000;">NULL</span></span><span id="lstnumberx3.5" class="ltx_text" style="font-size:90%;">)</span><span id="lstnumberx3.6" class="ltx_text ltx_lst_space" style="font-size:90%;"> </span><span id="lstnumberx3.7" class="ltx_text" style="font-size:90%;">{</span>
</div>
