<div id="lstnumberx81" class="ltx_listingline"><span id="lstnumberx81.1" class="ltx_text ltx_lst_space" style="font-size:90%;">  </span><span id="lstnumberx81.2" class="ltx_text ltx_font_bold" style="font-size:90%;--ltx-fg-color:#008000;">for</span><span id="lstnumberx81.3" class="ltx_text" style="font-size:90%;">(</span><span id="lstnumberx81.4" class="ltx_text ltx_font_bold" style="font-size:90%;--ltx-fg-color:#B00040;">int<span id="lstnumberx81.4.1" class="ltx_text ltx_lst_space ltx_font_medium" style="--ltx-fg-color:#000000;"> </span></span><span id="lstnumberx81.5" class="ltx_text" style="font-size:90%;">k</span><span id="lstnumberx81.6" class="ltx_text ltx_lst_space" style="font-size:90%;"> </span><span id="lstnumberx81.7" class="ltx_text" style="font-size:90%;--ltx-fg-color:#666666;">=<span id="lstnumberx81.7.1" class="ltx_text ltx_lst_space" style="--ltx-fg-color:#000000;"> </span>0</span><span id="lstnumberx81.8" class="ltx_text" style="font-size:90%;">;</span><span id="lstnumberx81.9" class="ltx_text ltx_lst_space" style="font-size:90%;"> </span><span id="lstnumberx81.10" class="ltx_text" style="font-size:90%;">k</span><span id="lstnumberx81.11" class="ltx_text ltx_lst_space" style="font-size:90%;"> </span><span id="lstnumberx81.12" class="ltx_text" style="font-size:90%;--ltx-fg-color:#666666;">&lt;<span id="lstnumberx81.12.1" class="ltx_text ltx_lst_space" style="--ltx-fg-color:#000000;"> </span></span><span id="lstnumberx81.13" class="ltx_text" style="font-size:90%;">nnz;</span><span id="lstnumberx81.14" class="ltx_text ltx_lst_space" style="font-size:90%;"> </span><span id="lstnumberx81.15" class="ltx_text" style="font-size:90%;--ltx-fg-color:#666666;">++</span><span id="lstnumberx81.16" class="ltx_text" style="font-size:90%;">k)</span><span id="lstnumberx81.17" class="ltx_text ltx_lst_space" style="font-size:90%;"> </span><span id="lstnumberx81.18" class="ltx_text" style="font-size:90%;">{</span>
