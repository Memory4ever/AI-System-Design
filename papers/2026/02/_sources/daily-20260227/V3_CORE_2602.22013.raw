<td id="S4.T1.7.1.2.2" class="ltx_td ltx_align_center"><span id="S4.T1.7.1.2.2.1" class="ltx_text ltx_font_bold" style="font-size:90%;">Real</span></td></tr>
<tr id="S4.T1.7.1.3" class="ltx_tr">
<td id="S4.T1.7.1.3.1" class="ltx_td ltx_align_left ltx_border_tt"><span id="S4.T1.7.1.3.1.1" class="ltx_text" style="font-size:90%;">BM25 (T)</span></td>
<td id="S4.T1.7.1.3.2" class="ltx_td ltx_align_center ltx_border_r ltx_border_tt"><span id="S4.T1.7.1.3.2.1" class="ltx_text" style="font-size:90%;">n.a</span></td>
<td id="S4.T1.7.1.3.3" class="ltx_td ltx_align_center ltx_border_r ltx_border_tt"><span id="S4.T1.7.1.3.3.1" class="ltx_text" style="font-size:90%;">53.34</span></td>
<td id="S4.T1.7.1.3.4" class="ltx_td ltx_align_center ltx_border_tt"><span id="S4.T1.7.1.3.4.1" class="ltx_text" style="font-size:90%;">32.80</span></td>
<td id="S4.T1.7.1.3.5" class="ltx_td ltx_align_center ltx_border_tt"><span id="S4.T1.7.1.3.5.1" class="ltx_text" style="font-size:90%;">38.60</span></td></tr>
<tr id="S4.T1.7.1.4" class="ltx_tr">
<td id="S4.T1.7.1.4.1" class="ltx_td ltx_align_left"><span id="S4.T1.7.1.4.1.1" class="ltx_text" style="font-size:90%;">BGE-large (T)</span></td>
<td id="S4.T1.7.1.4.2" class="ltx_td ltx_align_center ltx_border_r"><span id="S4.T1.7.1.4.2.1" class="ltx_text" style="font-size:90%;">335M</span></td>
<td id="S4.T1.7.1.4.3" class="ltx_td ltx_align_center ltx_border_r"><span id="S4.T1.7.1.4.3.1" class="ltx_text" style="font-size:90%;">58.98</span></td>
<td id="S4.T1.7.1.4.4" class="ltx_td ltx_align_center"><span id="S4.T1.7.1.4.4.1" class="ltx_text" style="font-size:90%;">37.05</span></td>
<td id="S4.T1.7.1.4.5" class="ltx_td ltx_align_center"><span id="S4.T1.7.1.4.5.1" class="ltx_text" style="font-size:90%;">35.23</span></td></tr>
