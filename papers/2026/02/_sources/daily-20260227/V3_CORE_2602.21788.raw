            <span id="alg1.4.17.2" class="ltx_text ltx_font_bold">while</span> <em id="alg1.4.17.3" class="ltx_emph ltx_font_italic"><math id="alg1.m20" class="ltx_Math" alttext="p,q&gt;0" display="inline" intent=":literal"><semantics><mrow><mrow><mi>p</mi><mo>,</mo><mi>q</mi></mrow><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">p,q&gt;0</annotation></semantics></math></em> <span id="alg1.4.17.4" class="ltx_text ltx_font_bold">do</span>
</div>
