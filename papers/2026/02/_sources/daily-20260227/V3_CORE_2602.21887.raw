<tr id="S6.T5.2.12" class="ltx_tr">
<th id="S6.T5.2.12.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_t"><span id="S6.T5.2.12.1.1" class="ltx_text" style="font-size:80%;">LoRA</span></th>
<td id="S6.T5.2.12.2" class="ltx_td ltx_align_center ltx_border_t"><span id="S6.T5.2.12.2.1" class="ltx_text" style="font-size:80%;">5.4</span></td>
<td id="S6.T5.2.12.3" class="ltx_td ltx_align_center ltx_border_t"><span id="S6.T5.2.12.3.1" class="ltx_text" style="font-size:80%;">3.8</span></td>
