<td id="S6.T3.2.18.1" class="ltx_td ltx_align_left ltx_border_t">Baseline <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib12" title="" class="ltx_ref">11</a>]</cite></td>
