<td id="S3.T1.2.3.2" class="ltx_td ltx_align_center">8</td>
<td id="S3.T1.2.3.3" class="ltx_td ltx_align_center">6</td>
<td id="S3.T1.2.3.4" class="ltx_td ltx_align_center">0.046543</td>
<td id="S3.T1.2.3.5" class="ltx_td ltx_align_center">0.000626</td></tr>
<tr id="S3.T1.2.4" class="ltx_tr">
<td id="S3.T1.2.4.1" class="ltx_td ltx_align_left">AlexNet – Conv3</td>
<td id="S3.T1.2.4.2" class="ltx_td ltx_align_center">8</td>
<td id="S3.T1.2.4.3" class="ltx_td ltx_align_center">4</td>
<td id="S3.T1.2.4.4" class="ltx_td ltx_align_center">0.034646</td>
<td id="S3.T1.2.4.5" class="ltx_td ltx_align_center">0.000477</td></tr>
