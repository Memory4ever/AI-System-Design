            <span id="alg1.l26.3" class="ltx_text ltx_font_bold" style="font-size:90%;">while</span><span id="alg1.l26.4" class="ltx_text" style="font-size:90%;"> </span><math id="alg1.l26.m1" class="ltx_Math" alttext="j&lt;I_{\max}" display="inline" intent=":literal"><semantics><mrow><mi mathsize="0.900em">j</mi><mo mathsize="0.900em">&lt;</mo><msub><mi mathsize="0.900em">I</mi><mi mathsize="0.900em">max</mi></msub></mrow><annotation encoding="application/x-tex">j&lt;I_{\max}</annotation></semantics></math><span id="alg1.l26.5" class="ltx_text" style="font-size:90%;"> </span><span id="alg1.l26.6" class="ltx_text ltx_font_bold" style="font-size:90%;">do</span><span id="alg1.l26.7" class="ltx_text" style="font-size:90%;">
</span>
</div>
<div id="alg1.l27" class="ltx_listingline">
