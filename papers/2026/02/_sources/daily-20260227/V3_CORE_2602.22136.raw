<td id="S3.T1.2.5.3" class="ltx_td ltx_align_center">4</td>
<td id="S3.T1.2.5.4" class="ltx_td ltx_align_center">0.027320</td>
<td id="S3.T1.2.5.5" class="ltx_td ltx_align_center">0.000409</td></tr>
