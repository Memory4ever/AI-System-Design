<td id="S5.T4.8.1.6.3" class="ltx_td ltx_align_center" style="--ltx-bg-color:#DDEBF7;"><span id="S5.T4.8.1.6.3.1" class="ltx_text ltx_font_bold" style="--ltx-bg-color:#DDEBF7;">5.48</span></td>
<td id="S5.T4.8.1.6.4" class="ltx_td ltx_align_center" style="--ltx-bg-color:#DDEBF7;"><span id="S5.T4.8.1.6.4.1" class="ltx_text ltx_font_bold" style="--ltx-bg-color:#DDEBF7;">0.93</span></td></tr>
