<td id="S5.T4.8.1.8.3" class="ltx_td ltx_align_center" style="--ltx-bg-color:#DDEBF7;"><span id="S5.T4.8.1.8.3.1" class="ltx_text ltx_font_bold" style="--ltx-bg-color:#DDEBF7;">6.61</span></td>
<td id="S5.T4.8.1.8.4" class="ltx_td ltx_align_center" style="--ltx-bg-color:#DDEBF7;"><span id="S5.T4.8.1.8.4.1" class="ltx_text ltx_font_bold" style="--ltx-bg-color:#DDEBF7;">0.85</span></td></tr>
