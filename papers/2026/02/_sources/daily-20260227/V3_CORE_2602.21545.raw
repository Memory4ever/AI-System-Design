<th id="S4.T2.3.1.6" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt" style="padding-left:4.0pt;padding-right:4.0pt;"><span id="S4.T2.3.1.6.1" class="ltx_text ltx_font_bold ltx_font_smallcaps">Muon+</span></th></tr>
</thead>
<tbody class="ltx_tbody">
<tr id="S4.T2.3.2" class="ltx_tr">
<th id="S4.T2.3.2.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_t" style="padding-left:4.0pt;padding-right:4.0pt;">LLaMA-60M</th>
<th id="S4.T2.3.2.2" class="ltx_td ltx_align_center ltx_th ltx_th_row ltx_border_t" style="padding-left:4.0pt;padding-right:4.0pt;">58</th>
<td id="S4.T2.3.2.3" class="ltx_td ltx_align_center ltx_border_t" style="padding-left:4.0pt;padding-right:4.0pt;">1.1</td>
<td id="S4.T2.3.2.4" class="ltx_td ltx_align_center ltx_border_t" style="padding-left:4.0pt;padding-right:4.0pt;">33.10</td>
<td id="S4.T2.3.2.5" class="ltx_td ltx_align_center ltx_border_t" style="padding-left:4.0pt;padding-right:4.0pt;">25.75</td>
<td id="S4.T2.3.2.6" class="ltx_td ltx_align_center ltx_border_t" style="padding-left:4.0pt;padding-right:4.0pt;"><span id="S4.T2.3.2.6.1" class="ltx_text ltx_font_bold">25.25</span>  <span id="S4.T2.3.2.6.2" class="ltx_text" style="--ltx-fg-color:#008000;">(-0.50)</span></td></tr>
<tr id="S4.T2.3.3" class="ltx_tr">
<th id="S4.T2.3.3.1" class="ltx_td ltx_align_left ltx_th ltx_th_row" style="padding-left:4.0pt;padding-right:4.0pt;">LLaMA-130M</th>
<th id="S4.T2.3.3.2" class="ltx_td ltx_align_center ltx_th ltx_th_row" style="padding-left:4.0pt;padding-right:4.0pt;">134</th>
<td id="S4.T2.3.3.3" class="ltx_td ltx_align_center" style="padding-left:4.0pt;padding-right:4.0pt;">2.2</td>
<td id="S4.T2.3.3.4" class="ltx_td ltx_align_center" style="padding-left:4.0pt;padding-right:4.0pt;">23.64</td>
<td id="S4.T2.3.3.5" class="ltx_td ltx_align_center" style="padding-left:4.0pt;padding-right:4.0pt;">19.06</td>
<td id="S4.T2.3.3.6" class="ltx_td ltx_align_center" style="padding-left:4.0pt;padding-right:4.0pt;"><span id="S4.T2.3.3.6.1" class="ltx_text ltx_font_bold">18.65</span>  <span id="S4.T2.3.3.6.2" class="ltx_text" style="--ltx-fg-color:#008000;">(-0.41)</span></td></tr>
<tr id="S4.T2.3.4" class="ltx_tr">
<th id="S4.T2.3.4.1" class="ltx_td ltx_align_left ltx_th ltx_th_row" style="padding-left:4.0pt;padding-right:4.0pt;">LLaMA-350M</th>
<th id="S4.T2.3.4.2" class="ltx_td ltx_align_center ltx_th ltx_th_row" style="padding-left:4.0pt;padding-right:4.0pt;">368</th>
<td id="S4.T2.3.4.3" class="ltx_td ltx_align_center" style="padding-left:4.0pt;padding-right:4.0pt;">6.4</td>
<td id="S4.T2.3.4.4" class="ltx_td ltx_align_center" style="padding-left:4.0pt;padding-right:4.0pt;">16.18</td>
<td id="S4.T2.3.4.5" class="ltx_td ltx_align_center" style="padding-left:4.0pt;padding-right:4.0pt;">14.02</td>
<td id="S4.T2.3.4.6" class="ltx_td ltx_align_center" style="padding-left:4.0pt;padding-right:4.0pt;"><span id="S4.T2.3.4.6.1" class="ltx_text ltx_font_bold">13.41</span>  <span id="S4.T2.3.4.6.2" class="ltx_text" style="--ltx-fg-color:#008000;">(-0.61)</span></td></tr>
<tr id="S4.T2.3.5" class="ltx_tr">
<th id="S4.T2.3.5.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_bb" style="padding-left:4.0pt;padding-right:4.0pt;">LLaMA-1B</th>
<th id="S4.T2.3.5.2" class="ltx_td ltx_align_center ltx_th ltx_th_row ltx_border_bb" style="padding-left:4.0pt;padding-right:4.0pt;">1339</th>
