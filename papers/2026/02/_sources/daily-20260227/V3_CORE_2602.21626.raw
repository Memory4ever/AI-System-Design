              <span id="alg1.l5.2" class="ltx_text ltx_font_bold">if</span> <math id="alg1.l5.m1" class="ltx_Math" alttext="KVusage[i_{max}]\geq\theta_{kv}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>K</mi><mo lspace="0em" rspace="0em">​</mo><mi>V</mi><mo lspace="0em" rspace="0em">​</mo><mi>u</mi><mo lspace="0em" rspace="0em">​</mo><mi>s</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi><mo lspace="0em" rspace="0em">​</mo><mi>g</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><msub><mi>i</mi><mrow><mi>m</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi><mo lspace="0em" rspace="0em">​</mo><mi>x</mi></mrow></msub><mo stretchy="false">]</mo></mrow></mrow><mo>≥</mo><msub><mi>θ</mi><mrow><mi>k</mi><mo lspace="0em" rspace="0em">​</mo><mi>v</mi></mrow></msub></mrow><annotation encoding="application/x-tex">KVusage[i_{max}]\geq\theta_{kv}</annotation></semantics></math> <span id="alg1.l5.3" class="ltx_text ltx_font_bold">then</span>

</div>
<div id="alg1.l6" class="ltx_listingline">
