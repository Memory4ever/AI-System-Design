               <span id="alg1.l6.2" class="ltx_text ltx_font_bold">if</span> <math id="alg1.l6.m1" class="ltx_Math" alttext="KVusage[i_{max}]-KVusage[i_{min}]\geq\theta_{dif\!f}" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mi>K</mi><mo lspace="0em" rspace="0em">​</mo><mi>V</mi><mo lspace="0em" rspace="0em">​</mo><mi>u</mi><mo lspace="0em" rspace="0em">​</mo><mi>s</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi><mo lspace="0em" rspace="0em">​</mo><mi>g</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><msub><mi>i</mi><mrow><mi>m</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi><mo lspace="0em" rspace="0em">​</mo><mi>x</mi></mrow></msub><mo stretchy="false">]</mo></mrow></mrow><mo>−</mo><mrow><mi>K</mi><mo lspace="0em" rspace="0em">​</mo><mi>V</mi><mo lspace="0em" rspace="0em">​</mo><mi>u</mi><mo lspace="0em" rspace="0em">​</mo><mi>s</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi><mo lspace="0em" rspace="0em">​</mo><mi>g</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><msub><mi>i</mi><mrow><mi>m</mi><mo lspace="0em" rspace="0em">​</mo><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow></msub><mo stretchy="false">]</mo></mrow></mrow></mrow><mo>≥</mo><msub><mi>θ</mi><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mpadded style="width:0.477em;" width="0.477em"><mi>f</mi></mpadded><mo lspace="0em" rspace="0em">​</mo><mi>f</mi></mrow></msub></mrow><annotation encoding="application/x-tex">KVusage[i_{max}]-KVusage[i_{min}]\geq\theta_{dif\!f}</annotation></semantics></math> <span id="alg1.l6.3" class="ltx_text ltx_font_bold">then</span>

</div>
<div id="alg1.l7" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg1.l7.1" class="ltx_text" style="font-size:80%;">7:</span></span>
              
                 <math id="alg1.l7.m1" class="ltx_Math" alttext="e^{*}\leftarrow dp\_engines[i_{min}]" display="inline" intent=":literal"><semantics><mrow><msup><mi>e</mi><mo>∗</mo></msup><mo stretchy="false">←</mo><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>_</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><mi>g</mi><mo lspace="0em" rspace="0em">​</mo><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mi>s</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><msub><mi>i</mi><mrow><mi>m</mi><mo lspace="0em" rspace="0em">​</mo><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow></msub><mo stretchy="false">]</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">e^{*}\leftarrow dp\_engines[i_{min}]</annotation></semantics></math>

</div>
<div id="alg1.l8" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg1.l8.1" class="ltx_text" style="font-size:80%;">8:</span></span>
              
               <span id="alg1.l8.2" class="ltx_text ltx_font_bold">else</span>
</div>
<div id="alg1.l9" class="ltx_listingline">
