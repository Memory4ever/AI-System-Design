            <span id="alg1.l1.2" class="ltx_text ltx_font_bold">Initialize</span> <math id="alg1.l1.m1" class="ltx_Math" alttext="e^{*}\leftarrow\text{next engine from }dp\_engines[]" display="inline" intent=":literal"><semantics><mrow><msup><mi>e</mi><mo>∗</mo></msup><mo stretchy="false">←</mo><mrow><mtext>next engine from </mtext><mo lspace="0em" rspace="0em">​</mo><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>_</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><mi>g</mi><mo lspace="0em" rspace="0em">​</mo><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mi>s</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mo stretchy="false">]</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">e^{*}\leftarrow\text{next engine from }dp\_engines[]</annotation></semantics></math>

