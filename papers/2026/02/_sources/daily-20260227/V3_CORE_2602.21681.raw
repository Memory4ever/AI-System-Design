<td id="S2.T1.5.7.5" class="ltx_td ltx_nopad_l ltx_nopad_r ltx_align_center ltx_border_bb" style="padding-left:1.7pt;padding-right:1.7pt;"><span id="S2.T1.5.7.5.1" class="ltx_text" style="font-size:80%;">0.600</span></td>
