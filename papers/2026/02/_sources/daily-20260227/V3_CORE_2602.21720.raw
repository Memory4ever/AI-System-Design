<th id="Sx1.T1.2.9.1" class="ltx_td ltx_align_center ltx_th ltx_th_row ltx_border_bb">25</th>
<td id="Sx1.T1.2.9.2" class="ltx_td ltx_align_right ltx_border_bb"><math id="Sx1.T1.m15" class="ltx_Math" alttext="2*10+5" display="inline" intent=":literal"><semantics><mrow><mrow><mn>2</mn><mo lspace="0.222em" rspace="0.222em">∗</mo><mn>10</mn></mrow><mo>+</mo><mn>5</mn></mrow><annotation encoding="application/x-tex">2*10+5</annotation></semantics></math></td>
<td id="Sx1.T1.2.9.3" class="ltx_td ltx_align_right ltx_border_bb"><math id="Sx1.T1.m16" class="ltx_Math" alttext="2*9+7" display="inline" intent=":literal"><semantics><mrow><mrow><mn>2</mn><mo lspace="0.222em" rspace="0.222em">∗</mo><mn>9</mn></mrow><mo>+</mo><mn>7</mn></mrow><annotation encoding="application/x-tex">2*9+7</annotation></semantics></math></td></tr>
