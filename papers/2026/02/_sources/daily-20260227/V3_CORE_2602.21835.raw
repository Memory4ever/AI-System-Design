<td id="S1.T1.3.1.3.1" class="ltx_td ltx_align_left ltx_border_t" style="padding-left:5.0pt;padding-right:5.0pt;" colspan="4"><span id="S1.T1.3.1.3.1.1" class="ltx_text ltx_font_italic" style="font-size:90%;">Benchmarks for Video Understanding</span></td></tr>
<tr id="S1.T1.3.1.4" class="ltx_tr">
<td id="S1.T1.3.1.4.1" class="ltx_td ltx_align_left ltx_border_t" style="padding-left:5.0pt;padding-right:5.0pt;"><span id="S1.T1.3.1.4.1.1" class="ltx_text" style="font-size:90%;">M-VAD </span><cite class="ltx_cite ltx_citemacro_cite"><span id="S1.T1.3.1.4.1.2" class="ltx_text" style="font-size:90%;">[</span><a href="#bib.bib35" title="" class="ltx_ref">46</a><span id="S1.T1.3.1.4.1.3" class="ltx_text" style="font-size:90%;">]</span></cite></td>
<td id="S1.T1.3.1.4.2" class="ltx_td ltx_align_center ltx_border_t" style="padding-left:5.0pt;padding-right:5.0pt;"><span id="S1.T1.3.1.4.2.1" class="ltx_text" style="font-size:90%;">①</span></td>
