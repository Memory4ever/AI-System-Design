<td id="S4.T4.5.1.2.6" class="ltx_td ltx_align_center ltx_border_t" style="padding-left:3.0pt;padding-right:3.0pt;">63.00</td></tr>
<tr id="S4.T4.5.1.3" class="ltx_tr">
<td id="S4.T4.5.1.3.1" class="ltx_td ltx_align_left" style="padding-left:3.0pt;padding-right:3.0pt;">Only VAE</td>
<td id="S4.T4.5.1.3.2" class="ltx_td ltx_align_center" style="padding-left:3.0pt;padding-right:3.0pt;">58.31</td>
<td id="S4.T4.5.1.3.3" class="ltx_td ltx_align_center" style="padding-left:3.0pt;padding-right:3.0pt;">65.45</td>
<td id="S4.T4.5.1.3.4" class="ltx_td ltx_align_center" style="padding-left:3.0pt;padding-right:3.0pt;">66.23</td>
<td id="S4.T4.5.1.3.5" class="ltx_td ltx_align_center" style="padding-left:3.0pt;padding-right:3.0pt;">60.40</td>
<td id="S4.T4.5.1.3.6" class="ltx_td ltx_align_center" style="padding-left:3.0pt;padding-right:3.0pt;">63.05</td></tr>
<tr id="S4.T4.5.1.4" class="ltx_tr">
<td id="S4.T4.5.1.4.1" class="ltx_td ltx_align_left" style="padding-left:3.0pt;padding-right:3.0pt;">Hard Switching</td>
<td id="S4.T4.5.1.4.2" class="ltx_td ltx_align_center" style="padding-left:3.0pt;padding-right:3.0pt;">57.39</td>
<td id="S4.T4.5.1.4.3" class="ltx_td ltx_align_center" style="padding-left:3.0pt;padding-right:3.0pt;">65.43</td>
<td id="S4.T4.5.1.4.4" class="ltx_td ltx_align_center" style="padding-left:3.0pt;padding-right:3.0pt;">68.84</td>
<td id="S4.T4.5.1.4.5" class="ltx_td ltx_align_center" style="padding-left:3.0pt;padding-right:3.0pt;">62.08</td>
<td id="S4.T4.5.1.4.6" class="ltx_td ltx_align_center" style="padding-left:3.0pt;padding-right:3.0pt;">63.52</td></tr>
