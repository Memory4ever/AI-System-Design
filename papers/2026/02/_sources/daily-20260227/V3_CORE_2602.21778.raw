<tr id="A1.T5.5.1.3" class="ltx_tr">
<td id="A1.T5.5.1.3.1" class="ltx_td ltx_align_left" style="padding-left:10.0pt;padding-right:10.0pt;"><span id="A1.T5.5.1.3.1.1" class="ltx_text ltx_font_bold">Biological</span></td>
<td id="A1.T5.5.1.3.2" class="ltx_td ltx_align_center" style="padding-left:10.0pt;padding-right:10.0pt;">5</td>
<td id="A1.T5.5.1.3.3" class="ltx_td ltx_align_center" style="padding-left:10.0pt;padding-right:10.0pt;">12</td>
<td id="A1.T5.5.1.3.4" class="ltx_td ltx_align_center" style="padding-left:10.0pt;padding-right:10.0pt;">10,242</td></tr>
<tr id="A1.T5.5.1.4" class="ltx_tr">
<td id="A1.T5.5.1.4.1" class="ltx_td ltx_align_left" style="padding-left:10.0pt;padding-right:10.0pt;"><span id="A1.T5.5.1.4.1.1" class="ltx_text ltx_font_bold">Thermal</span></td>
<td id="A1.T5.5.1.4.2" class="ltx_td ltx_align_center" style="padding-left:10.0pt;padding-right:10.0pt;">2</td>
<td id="A1.T5.5.1.4.3" class="ltx_td ltx_align_center" style="padding-left:10.0pt;padding-right:10.0pt;">8</td>
<td id="A1.T5.5.1.4.4" class="ltx_td ltx_align_center" style="padding-left:10.0pt;padding-right:10.0pt;">6,602</td></tr>
<tr id="A1.T5.5.1.5" class="ltx_tr">
<td id="A1.T5.5.1.5.1" class="ltx_td ltx_align_left" style="padding-left:10.0pt;padding-right:10.0pt;"><span id="A1.T5.5.1.5.1.1" class="ltx_text ltx_font_bold">Optical</span></td>
<td id="A1.T5.5.1.5.2" class="ltx_td ltx_align_center" style="padding-left:10.0pt;padding-right:10.0pt;">3</td>
<td id="A1.T5.5.1.5.3" class="ltx_td ltx_align_center" style="padding-left:10.0pt;padding-right:10.0pt;">8</td>
<td id="A1.T5.5.1.5.4" class="ltx_td ltx_align_center" style="padding-left:10.0pt;padding-right:10.0pt;">6,245</td></tr>
