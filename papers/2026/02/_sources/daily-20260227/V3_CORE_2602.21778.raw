<td id="A1.T5.5.1.6.2" class="ltx_td ltx_align_center" style="padding-left:10.0pt;padding-right:10.0pt;">3</td>
<td id="A1.T5.5.1.6.3" class="ltx_td ltx_align_center" style="padding-left:10.0pt;padding-right:10.0pt;">6</td>
<td id="A1.T5.5.1.6.4" class="ltx_td ltx_align_center" style="padding-left:10.0pt;padding-right:10.0pt;">5,286</td></tr>
<tr id="A1.T5.5.1.7" class="ltx_tr">
<td id="A1.T5.5.1.7.1" class="ltx_td ltx_align_left ltx_border_bb ltx_border_t" style="padding-left:10.0pt;padding-right:10.0pt;"><span id="A1.T5.5.1.7.1.1" class="ltx_text ltx_font_bold">Total</span></td>
