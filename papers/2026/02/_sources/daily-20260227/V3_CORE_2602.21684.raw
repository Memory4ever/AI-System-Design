<tbody class="ltx_tbody">
<tr id="S4.T1.2.1.3" class="ltx_tr">
<td id="S4.T1.2.1.3.1" class="ltx_td ltx_align_left ltx_border_r ltx_border_t">IBC</td>
<td id="S4.T1.2.1.3.2" class="ltx_td ltx_align_center ltx_border_t"><math id="S4.T1.m1" class="ltx_Math" alttext="0.00\scriptstyle{\pm 0.00}" display="inline" intent=":literal"><semantics><mrow><mn>0.00</mn><mo mathsize="0.700em">±</mo><mn mathsize="0.700em">0.00</mn></mrow><annotation encoding="application/x-tex">0.00\scriptstyle{\pm 0.00}</annotation></semantics></math></td>
<td id="S4.T1.2.1.3.3" class="ltx_td ltx_align_center ltx_border_t"><math id="S4.T1.m2" class="ltx_Math" alttext="0.00\scriptstyle{\pm 0.00}" display="inline" intent=":literal"><semantics><mrow><mn>0.00</mn><mo mathsize="0.700em">±</mo><mn mathsize="0.700em">0.00</mn></mrow><annotation encoding="application/x-tex">0.00\scriptstyle{\pm 0.00}</annotation></semantics></math></td>
<td id="S4.T1.2.1.3.4" class="ltx_td ltx_align_center ltx_border_r ltx_border_t"><math id="S4.T1.m3" class="ltx_Math" alttext="0.10\scriptstyle{\pm 0.01}" display="inline" intent=":literal"><semantics><mrow><mn>0.10</mn><mo mathsize="0.700em">±</mo><mn mathsize="0.700em">0.01</mn></mrow><annotation encoding="application/x-tex">0.10\scriptstyle{\pm 0.01}</annotation></semantics></math></td>
<td id="S4.T1.2.1.3.5" class="ltx_td ltx_align_center ltx_border_t"><math id="S4.T1.m4" class="ltx_Math" alttext="0.01\scriptstyle{\pm 0.01}" display="inline" intent=":literal"><semantics><mrow><mn>0.01</mn><mo mathsize="0.700em">±</mo><mn mathsize="0.700em">0.01</mn></mrow><annotation encoding="application/x-tex">0.01\scriptstyle{\pm 0.01}</annotation></semantics></math></td>
<td id="S4.T1.2.1.3.6" class="ltx_td ltx_align_center ltx_border_t"><math id="S4.T1.m5" class="ltx_Math" alttext="0.07\scriptstyle{\pm 0.02}" display="inline" intent=":literal"><semantics><mrow><mn>0.07</mn><mo mathsize="0.700em">±</mo><mn mathsize="0.700em">0.02</mn></mrow><annotation encoding="application/x-tex">0.07\scriptstyle{\pm 0.02}</annotation></semantics></math></td>
