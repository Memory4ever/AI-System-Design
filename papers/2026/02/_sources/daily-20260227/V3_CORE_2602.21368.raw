<th id="S11.T10.2.1.2" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt">GSM8K</th>
<th id="S11.T10.2.1.3" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt">MMLU</th>
<th id="S11.T10.2.1.4" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt">TruthfulQA</th>
<th id="S11.T10.2.1.5" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt">BigBench</th>
<th id="S11.T10.2.1.6" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt">HumanEval</th></tr>
</thead>
