<br class="ltx_break" style="--ltx-break-space:8.0pt;"></span>
<span id="S1.F1.pic1.5.1.2.2" class="ltx_text ltx_font_sansserif" style="font-size:80%;">Ranked by frequency</span></span>
</span></span></span></span></foreignObject></g><g style="--ltx-stroke-color:#0000B3;--ltx-fill-color:#0000B3;" fill="#0000B3" stroke="#0000B3" transform="matrix(1.0 0.0 0.0 1.0 152.29 76.59)"><foreignObject style="--ltx-fo-width:3.47em;--ltx-fo-height:0.69em;--ltx-fo-depth:0em;font-size:9pt;" height="8.65" overflow="visible" transform="matrix(1 0 0 -1 0 8.65)" width="43.2"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><span id="S1.F1.pic1.6" class="ltx_text ltx_font_sansserif ltx_font_bold ltx_font_smallcaps" style="font-size:90%;--ltx-fg-color:#0000B3;">2. Rank</span></span></span></foreignObject></g><g style="--ltx-stroke-color:#4D4D4D;--ltx-fill-color:#4D4D4D;" fill="#4D4D4D" stroke="#4D4D4D" transform="matrix(1.0 0.0 0.0 1.0 112.78 -93.89)"><g style="--ltx-fg-color:#4D4D4D;" class="ltx_tikzmatrix" color="#4D4D4D" transform="matrix(1 0 0 -1 0 19.72)"><g class="ltx_tikzmatrix_row" transform="matrix(1 0 0 1 0 8.65)"><g class="ltx_tikzmatrix_col ltx_nopad_r" transform="matrix(1 0 0 -1 0 0)"><foreignObject style="--ltx-fo-width:9.63em;--ltx-fo-height:0.68em;--ltx-fo-depth:0em;font-size:9.25pt;" height="8.65" overflow="visible" transform="matrix(1 0 0 -1 0 8.65)" width="123.22"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><span id="S1.F1.pic1.7" class="ltx_text" style="font-size:90%;">Sort identical answers</span></span></span></foreignObject></g></g><g class="ltx_tikzmatrix_row" transform="matrix(1 0 0 1 0 17.3)"><g class="ltx_tikzmatrix_col ltx_nopad_r" transform="matrix(1 0 0 -1 25.51 0)"><foreignObject style="--ltx-fo-width:5.61em;--ltx-fo-height:0.68em;--ltx-fo-depth:0.19em;font-size:9.25pt;" height="11.07" overflow="visible" transform="matrix(1 0 0 -1 0 8.65)" width="71.86"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><span id="S1.F1.pic1.8" class="ltx_text" style="font-size:90%;">by frequency</span></span></span></foreignObject></g></g></g></g><g style="--ltx-stroke-color:#9999FF;--ltx-fill-color:#F5F5FF;" fill="#F5F5FF" stroke="#9999FF" stroke-width="0.9pt"><path d="M 426.57 66.93 L 277.45 66.93 C 273.63 66.93 270.54 63.83 270.54 60.01 L 270.54 -60.01 C 270.54 -63.83 273.63 -66.93 277.45 -66.93 L 426.57 -66.93 C 430.39 -66.93 433.49 -63.83 433.49 -60.01 L 433.49 60.01 C 433.49 63.83 430.39 66.93 426.57 66.93 Z M 270.54 -66.93"></path></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" stroke-width="0.9pt" transform="matrix(1.0 0.0 0.0 1.0 278.84 -3.46)"><foreignObject style="--ltx-fo-width:10.58em;--ltx-fo-height:3.93em;--ltx-fo-depth:3.43em;font-size:10pt;" height="101.83" overflow="visible" transform="matrix(1 0 0 -1 0 54.37)" width="146.35"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><span id="S1.F1.pic1.9" class="ltx_text" style="position:relative; bottom:0.0pt;">
<span id="S1.F1.pic1.9.1" class="ltx_inline-block ltx_minipage ltx_align_middle" style="width:102.4pt;">
<span id="S1.F1.pic1.9.1.1" class="ltx_p ltx_align_center"><span id="S1.F1.pic1.9.1.1.1" class="ltx_text ltx_font_sansserif" style="font-size:80%;">Human checks <math id="S1.F1.pic1.m6" class="ltx_Math" alttext="n{\approx}50" display="inline" intent=":literal"><semantics><mrow><mi>n</mi><mo>≈</mo><mn>50</mn></mrow><annotation encoding="application/x-tex">n{\approx}50</annotation></semantics></math> items
<br class="ltx_break" style="--ltx-break-space:8.0pt;"></span>

<span id="S1.F1.pic1.9.1.1.2" class="ltx_tabular ltx_align_middle">
