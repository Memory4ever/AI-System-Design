<td id="S11.T10.2.2.3" class="ltx_td ltx_align_center ltx_border_t">83.4</td>
<td id="S11.T10.2.2.4" class="ltx_td ltx_align_center ltx_border_t"><span id="S11.T10.2.2.4.1" class="ltx_text ltx_font_bold">96.8</span></td>
<td id="S11.T10.2.2.5" class="ltx_td ltx_align_center ltx_border_t">75.4</td>
<td id="S11.T10.2.2.6" class="ltx_td ltx_align_center ltx_border_t">69.9</td></tr>
