<td id="S11.T10.2.3.2" class="ltx_td ltx_align_center"><span id="S11.T10.2.3.2.1" class="ltx_text ltx_font_bold">96.0</span></td>
<td id="S11.T10.2.3.3" class="ltx_td ltx_align_center">81.6</td>
<td id="S11.T10.2.3.4" class="ltx_td ltx_align_center">—</td>
