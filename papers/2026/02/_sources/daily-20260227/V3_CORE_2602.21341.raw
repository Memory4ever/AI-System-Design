<th id="S9.T5.3.4.1" class="ltx_td ltx_align_left ltx_th ltx_th_row" style="padding-left:4.0pt;padding-right:4.0pt;"><span id="S9.T5.3.4.1.1" class="ltx_text" style="font-size:80%;">27M</span></th>
<td id="S9.T5.3.4.2" class="ltx_td ltx_align_center" style="padding-left:4.0pt;padding-right:4.0pt;"><span id="S9.T5.3.4.2.1" class="ltx_text" style="font-size:80%;">384</span></td>
