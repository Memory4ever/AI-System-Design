<td id="S9.T5.3.2.2" class="ltx_td ltx_align_center ltx_border_t" style="padding-left:4.0pt;padding-right:4.0pt;"><span id="S9.T5.3.2.2.1" class="ltx_text ltx_font_bold" style="font-size:80%;">dim</span></td>
