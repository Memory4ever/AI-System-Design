<td id="S9.T5.3.2.6" class="ltx_td ltx_align_center ltx_border_t" style="padding-left:4.0pt;padding-right:4.0pt;"><span id="S9.T5.3.2.6.1" class="ltx_text ltx_font_bold" style="font-size:80%;">dim_head</span></td>
<td id="S9.T5.3.2.7" class="ltx_td ltx_align_center ltx_border_t" style="padding-left:4.0pt;padding-right:4.0pt;"><span id="S9.T5.3.2.7.1" class="ltx_text ltx_font_bold" style="font-size:80%;">n_layers</span></td></tr>
<tr id="S9.T5.3.3" class="ltx_tr">
<th id="S9.T5.3.3.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_t" style="padding-left:4.0pt;padding-right:4.0pt;"><span id="S9.T5.3.3.1.1" class="ltx_text" style="font-size:80%;">15M</span></th>
<td id="S9.T5.3.3.2" class="ltx_td ltx_align_center ltx_border_t" style="padding-left:4.0pt;padding-right:4.0pt;"><span id="S9.T5.3.3.2.1" class="ltx_text" style="font-size:80%;">384</span></td>
