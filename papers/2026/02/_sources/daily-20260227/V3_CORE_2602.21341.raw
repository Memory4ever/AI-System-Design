<td id="S9.T5.3.4.4" class="ltx_td ltx_align_center" style="padding-left:4.0pt;padding-right:4.0pt;"><span id="S9.T5.3.4.4.1" class="ltx_text" style="font-size:80%;">6</span></td>
<td id="S9.T5.3.4.5" class="ltx_td ltx_align_center" style="padding-left:4.0pt;padding-right:4.0pt;"><span id="S9.T5.3.4.5.1" class="ltx_text" style="font-size:80%;">384</span></td>
<td id="S9.T5.3.4.6" class="ltx_td ltx_align_center" style="padding-left:4.0pt;padding-right:4.0pt;"><span id="S9.T5.3.4.6.1" class="ltx_text" style="font-size:80%;">64</span></td>
<td id="S9.T5.3.4.7" class="ltx_td ltx_align_center" style="padding-left:4.0pt;padding-right:4.0pt;"><span id="S9.T5.3.4.7.1" class="ltx_text" style="font-size:80%;">6</span></td></tr>
<tr id="S9.T5.3.5" class="ltx_tr">
<th id="S9.T5.3.5.1" class="ltx_td ltx_align_left ltx_th ltx_th_row" style="padding-left:4.0pt;padding-right:4.0pt;"><span id="S9.T5.3.5.1.1" class="ltx_text" style="font-size:80%;">35M</span></th>
<td id="S9.T5.3.5.2" class="ltx_td ltx_align_center" style="padding-left:4.0pt;padding-right:4.0pt;"><span id="S9.T5.3.5.2.1" class="ltx_text" style="font-size:80%;">384</span></td>
