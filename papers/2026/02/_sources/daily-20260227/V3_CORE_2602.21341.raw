<td id="S9.T5.3.5.6" class="ltx_td ltx_align_center" style="padding-left:4.0pt;padding-right:4.0pt;"><span id="S9.T5.3.5.6.1" class="ltx_text" style="font-size:80%;">64</span></td>
<td id="S9.T5.3.5.7" class="ltx_td ltx_align_center" style="padding-left:4.0pt;padding-right:4.0pt;"><span id="S9.T5.3.5.7.1" class="ltx_text" style="font-size:80%;">8</span></td></tr>
<tr id="S9.T5.3.6" class="ltx_tr">
<th id="S9.T5.3.6.1" class="ltx_td ltx_align_left ltx_th ltx_th_row" style="padding-left:4.0pt;padding-right:4.0pt;"><span id="S9.T5.3.6.1.1" class="ltx_text" style="font-size:80%;">62M</span></th>
<td id="S9.T5.3.6.2" class="ltx_td ltx_align_center" style="padding-left:4.0pt;padding-right:4.0pt;"><span id="S9.T5.3.6.2.1" class="ltx_text" style="font-size:80%;">512</span></td>
<td id="S9.T5.3.6.3" class="ltx_td ltx_align_center" style="padding-left:4.0pt;padding-right:4.0pt;"><span id="S9.T5.3.6.3.1" class="ltx_text" style="font-size:80%;">64</span></td>
