<td id="S9.T5.3.3.5" class="ltx_td ltx_align_center ltx_border_t" style="padding-left:4.0pt;padding-right:4.0pt;"><span id="S9.T5.3.3.5.1" class="ltx_text" style="font-size:80%;">384</span></td>
<td id="S9.T5.3.3.6" class="ltx_td ltx_align_center ltx_border_t" style="padding-left:4.0pt;padding-right:4.0pt;"><span id="S9.T5.3.3.6.1" class="ltx_text" style="font-size:80%;">64</span></td>
<td id="S9.T5.3.3.7" class="ltx_td ltx_align_center ltx_border_t" style="padding-left:4.0pt;padding-right:4.0pt;"><span id="S9.T5.3.3.7.1" class="ltx_text" style="font-size:80%;">3</span></td></tr>
