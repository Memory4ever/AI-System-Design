<td id="S9.T5.3.1.2" class="ltx_td ltx_align_center ltx_border_tt" style="padding-left:4.0pt;padding-right:4.0pt;" colspan="3"><span id="S9.T5.3.1.2.1" class="ltx_text ltx_font_bold" style="font-size:80%;">Encoder</span></td>
<td id="S9.T5.3.1.3" class="ltx_td ltx_align_center ltx_border_tt" style="padding-left:4.0pt;padding-right:4.0pt;" colspan="3"><span id="S9.T5.3.1.3.1" class="ltx_text ltx_font_bold" style="font-size:80%;">Decoder</span></td></tr>
<tr id="S9.T5.3.2" class="ltx_tr">
