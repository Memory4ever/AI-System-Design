<td id="S10.T8.3.6.3" class="ltx_td ltx_align_center" style="padding-left:4.0pt;padding-right:4.0pt;"><span id="S10.T8.3.6.3.1" class="ltx_text" style="font-size:80%;">-</span></td>
<td id="S10.T8.3.6.4" class="ltx_td ltx_align_center" style="padding-left:4.0pt;padding-right:4.0pt;"><span id="S10.T8.3.6.4.1" class="ltx_text" style="font-size:80%;">-</span></td>
<td id="S10.T8.3.6.5" class="ltx_td ltx_align_center" style="padding-left:4.0pt;padding-right:4.0pt;"><span id="S10.T8.3.6.5.1" class="ltx_text" style="font-size:80%;">768</span></td>
<td id="S10.T8.3.6.6" class="ltx_td ltx_align_center" style="padding-left:4.0pt;padding-right:4.0pt;"><span id="S10.T8.3.6.6.1" class="ltx_text" style="font-size:80%;">64</span></td>
<td id="S10.T8.3.6.7" class="ltx_td ltx_align_center" style="padding-left:4.0pt;padding-right:4.0pt;"><span id="S10.T8.3.6.7.1" class="ltx_text" style="font-size:80%;">12</span></td></tr>
<tr id="S10.T8.3.7" class="ltx_tr">
<td id="S10.T8.3.7.1" class="ltx_td ltx_align_left" style="padding-left:4.0pt;padding-right:4.0pt;"><span id="S10.T8.3.7.1.1" class="ltx_text" style="font-size:80%;">175M</span></td>
<td id="S10.T8.3.7.2" class="ltx_td ltx_align_center" style="padding-left:4.0pt;padding-right:4.0pt;"><span id="S10.T8.3.7.2.1" class="ltx_text" style="font-size:80%;">-</span></td>
<td id="S10.T8.3.7.3" class="ltx_td ltx_align_center" style="padding-left:4.0pt;padding-right:4.0pt;"><span id="S10.T8.3.7.3.1" class="ltx_text" style="font-size:80%;">-</span></td>
<td id="S10.T8.3.7.4" class="ltx_td ltx_align_center" style="padding-left:4.0pt;padding-right:4.0pt;"><span id="S10.T8.3.7.4.1" class="ltx_text" style="font-size:80%;">-</span></td>
<td id="S10.T8.3.7.5" class="ltx_td ltx_align_center" style="padding-left:4.0pt;padding-right:4.0pt;"><span id="S10.T8.3.7.5.1" class="ltx_text" style="font-size:80%;">768</span></td>
