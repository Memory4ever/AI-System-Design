<td id="S3.T2.3.1.4.2" class="ltx_td ltx_align_center ltx_border_t"><span id="S3.T2.3.1.4.2.1" class="ltx_text" style="font-size:90%;">Multimodal</span></td>
<td id="S3.T2.3.1.4.3" class="ltx_td ltx_align_center ltx_border_t"><span id="S3.T2.3.1.4.3.1" class="ltx_text" style="font-size:90%;">14</span></td>
