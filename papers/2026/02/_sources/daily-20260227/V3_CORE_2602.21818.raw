<div id="A1.F6.3.1.1.1" class="ltx_inline-block ltx_align_right ltx_align_middle ltx_transformed_outer" style="width:20.0pt;height:55pt;vertical-align:-0.0pt;"><span class="ltx_transformed_inner" style="width:55.0pt;transform:translate(-23.1pt,-23.1pt) rotate(-90deg) ;">
<p id="A1.F6.3.1.1.1.1" class="ltx_p"><span id="A1.F6.3.1.1.1.1.1" class="ltx_text ltx_font_bold">Ref. Image</span></p>
</span></div></td>
<td id="A1.F6.3.1.2" class="ltx_td ltx_nopad_r ltx_align_left ltx_align_top" style="padding-top:2.5pt;padding-bottom:2.5pt;">
