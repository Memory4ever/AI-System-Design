<section id="A1.SS3.SSS2.Px3" class="ltx_paragraph">
<h5 class="ltx_title ltx_title_paragraph">Global Scene Attributes</h5>

<div id="A1.SS3.SSS2.Px3.p1" class="ltx_para ltx_noindent">
<p id="A1.SS3.SSS2.Px3.p1.1" class="ltx_p">The model supports transforming global scene attributes such as weather, lighting, color tone, and time of day.</p>
</div>
<div id="A1.SS3.SSS2.Px3.1" class="ltx_logical-block">
            
<div id="A1.SS3.SSS2.Px3.p2" class="ltx_para">
<p id="A1.SS3.SSS2.Px3.p2.1" class="ltx_p ltx_align_left"><span id="A1.SS3.SSS2.Px3.p2.1.1" class="ltx_text ltx_font_bold">Instruction:</span> <span id="A1.SS3.SSS2.Px3.p2.1.2" class="ltx_text ltx_font_italic">Make @video_1 nighttime.</span></p>
<table id="A1.SS3.SSS2.Px3.p2.2" class="ltx_tabular ltx_align_left ltx_align_middle">
<tbody class="ltx_tbody">
<tr id="A1.SS3.SSS2.Px3.p2.2.1" class="ltx_tr">
<td id="A1.SS3.SSS2.Px3.p2.2.1.1" class="ltx_td ltx_align_left ltx_align_middle" style="padding-bottom: 2.0pt;">
<div id="A1.SS3.SSS2.Px3.p2.2.1.1.1" class="ltx_inline-block ltx_align_center ltx_align_middle ltx_transformed_outer" style="width:12.0pt;height:61.1pt;vertical-align:-0.0pt;"><span class="ltx_transformed_inner" style="width:61.1pt;transform:translate(-26.1pt,-26.1pt) rotate(-90deg) ;">
