</span></span></span>
<span id="A1.SS3.SSS1.Px1.p2.1.3.2" class="ltx_tr">
<span id="A1.SS3.SSS1.Px1.p2.1.3.2.1" class="ltx_td ltx_align_left ltx_align_middle">
<span id="A1.SS3.SSS1.Px1.p2.1.3.2.1.1" class="ltx_inline-block ltx_align_center ltx_align_middle ltx_transformed_outer" style="width:12.0pt;height:69.9pt;vertical-align:-0.0pt;"><span class="ltx_transformed_inner" style="width:69.9pt;transform:translate(-30.5pt,-30.5pt) rotate(-90deg) ;">
