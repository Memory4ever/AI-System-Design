      <name>Farah Abdellatif</name>
    </author>
    <author>
      <name>Andrei Galbenus</name>
    </author>
    <author>
      <name>Jon. N. Shah</name>
    </author>
    <author>
      <name>Abigail Morrison</name>
    </author>
    <author>
      <name>Jürgen Dammers</name>
    </author>
