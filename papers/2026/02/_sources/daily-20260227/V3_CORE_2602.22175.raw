<td id="S5.T3.11.5.5" class="ltx_td ltx_nopad_l ltx_nopad_r ltx_align_center"><span id="S5.T3.11.5.5.1" class="ltx_text" style="font-size:80%;">20</span></td>
<td id="S5.T3.11.5.6" class="ltx_td ltx_nopad_l ltx_nopad_r ltx_align_center"><span id="S5.T3.11.5.6.1" class="ltx_text" style="font-size:80%;">63</span></td></tr>
