<td id="S5.T3.11.4.2" class="ltx_td ltx_nopad_l ltx_nopad_r ltx_align_center"><span id="S5.T3.11.4.2.1" class="ltx_text ltx_font_bold" style="font-size:80%;">27.3</span></td>
<td id="S5.T3.11.4.3" class="ltx_td ltx_nopad_l ltx_nopad_r ltx_align_center"><span id="S5.T3.11.4.3.1" class="ltx_text ltx_font_bold" style="font-size:80%;">26.3</span></td>
<td id="S5.T3.11.4.4" class="ltx_td ltx_nopad_l ltx_nopad_r ltx_align_center"><span id="S5.T3.11.4.4.1" class="ltx_text ltx_font_bold" style="font-size:80%;">51.2</span></td>
<td id="S5.T3.11.4.5" class="ltx_td ltx_nopad_l ltx_nopad_r ltx_align_center"><span id="S5.T3.11.4.5.1" class="ltx_text ltx_font_bold" style="font-size:80%;">33</span></td>
<td id="S5.T3.11.4.6" class="ltx_td ltx_nopad_l ltx_nopad_r ltx_align_center"><span id="S5.T3.11.4.6.1" class="ltx_text ltx_font_bold" style="font-size:80%;">66</span></td></tr>
<tr id="S5.T3.11.5" class="ltx_tr">
