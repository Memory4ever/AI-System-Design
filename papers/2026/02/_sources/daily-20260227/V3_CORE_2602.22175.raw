<td id="S5.T3.11.6.3" class="ltx_td ltx_nopad_l ltx_nopad_r ltx_align_center ltx_border_bb"><span id="S5.T3.11.6.3.1" class="ltx_text" style="font-size:80%;">23.1</span></td>
<td id="S5.T3.11.6.4" class="ltx_td ltx_nopad_l ltx_nopad_r ltx_align_center ltx_border_bb"><span id="S5.T3.11.6.4.1" class="ltx_text" style="font-size:80%;">47.5</span></td>
