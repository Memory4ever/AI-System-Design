</span></td></tr>
<tr id="Sx6.T14.3.1.4" class="ltx_tr">
<td id="Sx6.T14.3.1.4.1" class="ltx_td ltx_align_left ltx_align_top ltx_border_r ltx_border_t" style="padding-top:2.5pt;padding-bottom:2.5pt;">
