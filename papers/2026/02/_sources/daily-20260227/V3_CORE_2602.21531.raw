            Skill sequence <math id="alg1.l1.m1" class="ltx_Math" alttext="\mathcal{T}=\{a_{1},a_{2},\dots,a_{N}\}" display="inline" intent=":literal"><semantics><mrow><mi class="ltx_font_mathcaligraphic">𝒯</mi><mo>=</mo><mrow><mo stretchy="false">{</mo><mrow><msub><mi>a</mi><mn>1</mn></msub><mo>,</mo><msub><mi>a</mi><mn>2</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>a</mi><mi>N</mi></msub></mrow><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">\mathcal{T}=\{a_{1},a_{2},\dots,a_{N}\}</annotation></semantics></math>

</div>
<div id="alg1.l2" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg1.l2.1" class="ltx_text" style="font-size:80%;">2:</span></span>
              
              
            Modules: Reaching <math id="alg1.l2.m1" class="ltx_Math" alttext="\mathcal{M}_{\text{reach}}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">ℳ</mi><mtext>reach</mtext></msub><annotation encoding="application/x-tex">\mathcal{M}_{\text{reach}}</annotation></semantics></math>, Interaction <math id="alg1.l2.m2" class="ltx_Math" alttext="\mathcal{M}_{\text{int}}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">ℳ</mi><mtext>int</mtext></msub><annotation encoding="application/x-tex">\mathcal{M}_{\text{int}}</annotation></semantics></math>

</div>
<div id="alg1.l3" class="ltx_listingline">
