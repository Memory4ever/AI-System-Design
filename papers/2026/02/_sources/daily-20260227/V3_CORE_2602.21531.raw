<td id="S4.T1.10.1.2.6" class="ltx_td ltx_align_center ltx_border_t" style="padding-left:8.0pt;padding-right:8.0pt;" colspan="2"><span id="S4.T1.10.1.2.6.1" class="ltx_text ltx_font_italic">Variant 2</span></td>
<td id="S4.T1.10.1.2.7" class="ltx_td ltx_align_center ltx_border_r ltx_border_t" style="--ltx-bg-color:#E6E6E6;padding-left:8.0pt;padding-right:8.0pt;" colspan="2"><span id="S4.T1.10.1.2.7.1" class="ltx_text ltx_font_italic" style="--ltx-bg-color:#E6E6E6;">Avg.</span></td>
<td id="S4.T1.10.1.2.8" class="ltx_td ltx_align_center ltx_border_t" style="--ltx-bg-color:#E6E6E6;padding-left:8.0pt;padding-right:8.0pt;" colspan="2"><span id="S4.T1.10.1.2.8.1" class="ltx_text ltx_font_bold" style="--ltx-bg-color:#E6E6E6;">Avg.</span></td></tr>
<tr id="S4.T1.10.1.3" class="ltx_tr">
<td id="S4.T1.10.1.3.1" class="ltx_td ltx_align_center ltx_border_t" style="padding-left:8.0pt;padding-right:8.0pt;"><span id="S4.T1.10.1.3.1.1" class="ltx_text ltx_font_bold">SR</span></td>
<td id="S4.T1.10.1.3.2" class="ltx_td ltx_align_center ltx_border_t" style="padding-left:8.0pt;padding-right:8.0pt;"><span id="S4.T1.10.1.3.2.1" class="ltx_text ltx_font_bold">AP</span></td>
<td id="S4.T1.10.1.3.3" class="ltx_td ltx_align_center ltx_border_t" style="padding-left:8.0pt;padding-right:8.0pt;"><span id="S4.T1.10.1.3.3.1" class="ltx_text ltx_font_bold">SR</span></td>
<td id="S4.T1.10.1.3.4" class="ltx_td ltx_align_center ltx_border_t" style="padding-left:8.0pt;padding-right:8.0pt;"><span id="S4.T1.10.1.3.4.1" class="ltx_text ltx_font_bold">AP</span></td>
<td id="S4.T1.10.1.3.5" class="ltx_td ltx_align_center ltx_border_t" style="--ltx-bg-color:#E6E6E6;padding-left:8.0pt;padding-right:8.0pt;"><span id="S4.T1.10.1.3.5.1" class="ltx_text ltx_font_bold" style="--ltx-bg-color:#E6E6E6;">SR</span></td>
