            Initialize skill index <math id="alg1.l3.m1" class="ltx_Math" alttext="i\leftarrow 1" display="inline" intent=":literal"><semantics><mrow><mi>i</mi><mo stretchy="false">←</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">i\leftarrow 1</annotation></semantics></math>

