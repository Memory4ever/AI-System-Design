<tr id="S4.T1.8.5" class="ltx_tr">
<th id="S4.T1.8.5.1" class="ltx_td ltx_align_left ltx_th ltx_th_row">HAT<sup id="S4.T1.8.5.1.1" class="ltx_sup"><span id="S4.T1.8.5.1.1.1" class="ltx_text ltx_font_italic">‡</span></sup> <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib24" title="" class="ltx_ref">10</a>]</cite></th>
<td id="S4.T1.8.5.2" class="ltx_td ltx_align_center">72.06 <math id="S4.T1.m23" class="ltx_Math" alttext="\pm" display="inline" intent=":literal"><semantics><mo>±</mo><annotation encoding="application/x-tex">\pm</annotation></semantics></math> 0.50</td>
<td id="S4.T1.8.5.3" class="ltx_td ltx_align_center">0 <math id="S4.T1.m24" class="ltx_Math" alttext="\pm" display="inline" intent=":literal"><semantics><mo>±</mo><annotation encoding="application/x-tex">\pm</annotation></semantics></math> 0</td>
