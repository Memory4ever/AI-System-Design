              <math id="algorithm1.m33" class="ltx_Math" alttext="W^{(l)}\leftarrow W^{(l)}+U^{(l)}V^{(l)}" display="inline" intent=":literal"><semantics><mrow><msup><mi>W</mi><mrow><mo stretchy="false">(</mo><mi>l</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">←</mo><mrow><msup><mi>W</mi><mrow><mo stretchy="false">(</mo><mi>l</mi><mo stretchy="false">)</mo></mrow></msup><mo>+</mo><mrow><msup><mi>U</mi><mrow><mo stretchy="false">(</mo><mi>l</mi><mo stretchy="false">)</mo></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>V</mi><mrow><mo stretchy="false">(</mo><mi>l</mi><mo stretchy="false">)</mo></mrow></msup></mrow></mrow></mrow><annotation encoding="application/x-tex">W^{(l)}\leftarrow W^{(l)}+U^{(l)}V^{(l)}</annotation></semantics></math>  <span id="algorithm1.4.23.2" class="ltx_text" style="--ltx-fg-color:#808080;">// merge adapter</span>

</div>
<div id="algorithm1.4.24" class="ltx_listingline"> <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span> 
                <span class="ltx_tag ltx_tag_listingline"><span id="algorithm1.4.24.1" class="ltx_text ltx_font_bold">19</span></span>
              <span id="algorithm1.4.24.2" class="ltx_text ltx_font_bold">return</span> <math id="algorithm1.m34" class="ltx_Math" alttext="\mathcal{W}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">𝒲</mi><annotation encoding="application/x-tex">\mathcal{W}</annotation></semantics></math>

</div>
<div id="algorithm1.4.25" class="ltx_listingline"><span id="algorithm1.4.25.1" class="ltx_text ltx_font_bold">Input :</span> <math id="algorithm1.m35" class="ltx_Math" alttext="T" display="inline" intent=":literal"><semantics><mi>T</mi><annotation encoding="application/x-tex">T</annotation></semantics></math> (number of tasks), <math id="algorithm1.m36" class="ltx_Math" alttext="D=\{D_{t}\}_{t=1}^{T}" display="inline" intent=":literal"><semantics><mrow><mi>D</mi><mo>=</mo><msubsup><mrow><mo stretchy="false">{</mo><msub><mi>D</mi><mi>t</mi></msub><mo stretchy="false">}</mo></mrow><mrow><mi>t</mi><mo>=</mo><mn>1</mn></mrow><mi>T</mi></msubsup></mrow><annotation encoding="application/x-tex">D=\{D_{t}\}_{t=1}^{T}</annotation></semantics></math>, <math id="algorithm1.m37" class="ltx_Math" alttext="\varepsilon_{1}" display="inline" intent=":literal"><semantics><msub><mi>ε</mi><mn>1</mn></msub><annotation encoding="application/x-tex">\varepsilon_{1}</annotation></semantics></math>, <math id="algorithm1.m38" class="ltx_Math" alttext="\mathcal{L}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">ℒ</mi><annotation encoding="application/x-tex">\mathcal{L}</annotation></semantics></math> (layers)
</div>
<div id="algorithm1.4.26" class="ltx_listingline"><span id="algorithm1.4.26.1" class="ltx_text ltx_font_bold">Output :</span> Final weights <math id="algorithm1.m39" class="ltx_Math" alttext="\mathcal{W}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">𝒲</mi><annotation encoding="application/x-tex">\mathcal{W}</annotation></semantics></math>
</div>
<div id="algorithm1.4.27" class="ltx_listingline">
                <span class="ltx_tag ltx_tag_listingline"><span id="algorithm1.4.27.1" class="ltx_text ltx_font_bold">20</span></span>
              <span id="algorithm1.4.27.2" class="ltx_text ltx_font_bold">function</span> <em id="algorithm1.4.27.3" class="ltx_emph ltx_font_typewriter">full_training(<em id="algorithm1.4.27.3.1" class="ltx_emph ltx_font_serif ltx_font_italic"><math id="algorithm1.m40" class="ltx_Math" alttext="T,D,\varepsilon_{1},\mathcal{L}" display="inline" intent=":literal"><semantics><mrow><mi>T</mi><mo>,</mo><mi>D</mi><mo>,</mo><msub><mi>ε</mi><mn>1</mn></msub><mo>,</mo><mi class="ltx_font_mathcaligraphic">ℒ</mi></mrow><annotation encoding="application/x-tex">T,D,\varepsilon_{1},\mathcal{L}</annotation></semantics></math></em>)</em>
</div>
<div id="algorithm1.4.28" class="ltx_listingline"> <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span> 
                <span class="ltx_tag ltx_tag_listingline"><span id="algorithm1.4.28.1" class="ltx_text ltx_font_bold">21</span></span>
              Initialize <math id="algorithm1.m41" class="ltx_Math" alttext="\mathcal{W}=[W^{(l)}]_{l=1}^{L}" display="inline" intent=":literal"><semantics><mrow><mi class="ltx_font_mathcaligraphic">𝒲</mi><mo>=</mo><msubsup><mrow><mo stretchy="false">[</mo><msup><mi>W</mi><mrow><mo stretchy="false">(</mo><mi>l</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">]</mo></mrow><mrow><mi>l</mi><mo>=</mo><mn>1</mn></mrow><mi>L</mi></msubsup></mrow><annotation encoding="application/x-tex">\mathcal{W}=[W^{(l)}]_{l=1}^{L}</annotation></semantics></math>  <span id="algorithm1.4.28.2" class="ltx_text" style="--ltx-fg-color:#808080;">// pretrained or zero initialization</span>

</div>
<div id="algorithm1.4.29" class="ltx_listingline"> <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span> 
                <span class="ltx_tag ltx_tag_listingline"><span id="algorithm1.4.29.1" class="ltx_text ltx_font_bold">22</span></span>
              <span id="algorithm1.4.29.2" class="ltx_text ltx_font_bold">for</span> <em id="algorithm1.4.29.3" class="ltx_emph ltx_font_italic"><math id="algorithm1.m42" class="ltx_Math" alttext="t=1" display="inline" intent=":literal"><semantics><mrow><mi>t</mi><mo>=</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">t=1</annotation></semantics></math> to <math id="algorithm1.m43" class="ltx_Math" alttext="T" display="inline" intent=":literal"><semantics><mi>T</mi><annotation encoding="application/x-tex">T</annotation></semantics></math></em> <span id="algorithm1.4.29.4" class="ltx_text ltx_font_bold">do</span>
</div>
<div id="algorithm1.4.30" class="ltx_listingline"> <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span>  <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span> 
                <span class="ltx_tag ltx_tag_listingline"><span id="algorithm1.4.30.1" class="ltx_text ltx_font_bold">23</span></span>
              <math id="algorithm1.m44" class="ltx_Math" alttext="\mathcal{W}\leftarrow\texttt{train}(t,D_{t},\varepsilon_{1},\mathcal{L},\mathcal{W})" display="inline" intent=":literal"><semantics><mrow><mi class="ltx_font_mathcaligraphic">𝒲</mi><mo stretchy="false">←</mo><mrow><mtext class="ltx_mathvariant_monospace">train</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo>,</mo><msub><mi>D</mi><mi>t</mi></msub><mo>,</mo><msub><mi>ε</mi><mn>1</mn></msub><mo>,</mo><mi class="ltx_font_mathcaligraphic">ℒ</mi><mo>,</mo><mi class="ltx_font_mathcaligraphic">𝒲</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\mathcal{W}\leftarrow\texttt{train}(t,D_{t},\varepsilon_{1},\mathcal{L},\mathcal{W})</annotation></semantics></math>

</div>
<div id="algorithm1.4.31" class="ltx_listingline"> <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span> 
                <span class="ltx_tag ltx_tag_listingline"><span id="algorithm1.4.31.1" class="ltx_text ltx_font_bold">24</span></span>
              <span id="algorithm1.4.31.2" class="ltx_text ltx_font_bold">return</span> <math id="algorithm1.m45" class="ltx_Math" alttext="\mathcal{W}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">𝒲</mi><annotation encoding="application/x-tex">\mathcal{W}</annotation></semantics></math>

</div>
<div id="algorithm1.4.32" class="ltx_listingline">
</div>
</div>
</figure>
</section>
</section>
<section id="S3.SS3" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">3.3 </span>Training Paradigm</h3>

<div id="S3.SS3.p1" class="ltx_para ltx_noindent">
<p id="S3.SS3.p1.1" class="ltx_p">In this subsection, we describe the training procedure of NESS.
Assume that the network contains <math id="S3.SS3.p1.m1" class="ltx_Math" alttext="L" display="inline" intent=":literal"><semantics><mi>L</mi><annotation encoding="application/x-tex">L</annotation></semantics></math> linear or convolutional layers.</p>
</div>
<div id="S3.SS3.p2" class="ltx_para ltx_noindent">
<p id="S3.SS3.p2.1" class="ltx_p"><span id="S3.SS3.p2.1.1" class="ltx_text ltx_font_typewriter">GetUV</span> <span id="S3.SS3.p2.1.2" class="ltx_text ltx_font_bold">function (lines 1–10 of Algorithm <a href="#algorithm1" title="Algorithm 1 ‣ Practical Enforcement. ‣ 3.2 Our Proposed Method ‣ 3 Methodology ‣ Learning in the Null Space: Small Singular Values for Continual Learning" class="ltx_ref"><span class="ltx_text ltx_ref_tag">1</span></a>).</span>
This function constructs the frozen basis <math id="S3.SS3.p2.m1" class="ltx_Math" alttext="U_{t}" display="inline" intent=":literal"><semantics><msub><mi>U</mi><mi>t</mi></msub><annotation encoding="application/x-tex">U_{t}</annotation></semantics></math> and the trainable matrix <math id="S3.SS3.p2.m2" class="ltx_Math" alttext="V_{t}" display="inline" intent=":literal"><semantics><msub><mi>V</mi><mi>t</mi></msub><annotation encoding="application/x-tex">V_{t}</annotation></semantics></math> used to parameterize layer updates.</p>
</div>
<div id="S3.SS3.p3" class="ltx_para ltx_noindent">
<p id="S3.SS3.p3.1" class="ltx_p">Given an input matrix <math id="S3.SS3.p3.m1" class="ltx_Math" alttext="X" display="inline" intent=":literal"><semantics><mi>X</mi><annotation encoding="application/x-tex">X</annotation></semantics></math>, we compute the eigen-decomposition of the outer product</p>
<table id="S3.Ex6" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S3.Ex6.m1" class="ltx_Math" alttext="XX^{\top}=\sum_{i}x_{i}x_{i}^{\top}," display="block" intent=":literal"><semantics><mrow><mrow><mrow><mi>X</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>X</mi><mo>⊤</mo></msup></mrow><mo rspace="0.111em">=</mo><mrow><munder><mo movablelimits="false">∑</mo><mi>i</mi></munder><mrow><msub><mi>x</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>x</mi><mi>i</mi><mo>⊤</mo></msubsup></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">XX^{\top}=\sum_{i}x_{i}x_{i}^{\top},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S3.SS3.p3.2" class="ltx_p">which is equivalent to computing the left singular vectors <math id="S3.SS3.p3.m2" class="ltx_Math" alttext="\mathbf{U}" display="inline" intent=":literal"><semantics><mi>𝐔</mi><annotation encoding="application/x-tex">\mathbf{U}</annotation></semantics></math> of <math id="S3.SS3.p3.m3" class="ltx_Math" alttext="X" display="inline" intent=":literal"><semantics><mi>X</mi><annotation encoding="application/x-tex">X</annotation></semantics></math>. The eigenvalues (corresponding to squared singular values) are sorted in descending order. We then identify index <math id="S3.SS3.p3.m4" class="ltx_Math" alttext="j" display="inline" intent=":literal"><semantics><mi>j</mi><annotation encoding="application/x-tex">j</annotation></semantics></math> as the smallest index such that
<math id="S3.SS3.p3.m5" class="ltx_Math" alttext="\sigma_{j}\leq\varepsilon_{1}\|X\|_{F}." display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>σ</mi><mi>j</mi></msub><mo>≤</mo><mrow><msub><mi>ε</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">‖</mo><mi>X</mi><mo stretchy="false">‖</mo></mrow><mi>F</mi></msub></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\sigma_{j}\leq\varepsilon_{1}\|X\|_{F}.</annotation></semantics></math>
The matrix <math id="S3.SS3.p3.m6" class="ltx_Math" alttext="U_{t}" display="inline" intent=":literal"><semantics><msub><mi>U</mi><mi>t</mi></msub><annotation encoding="application/x-tex">U_{t}</annotation></semantics></math> is constructed from the columns of <math id="S3.SS3.p3.m7" class="ltx_Math" alttext="\mathbf{U}" display="inline" intent=":literal"><semantics><mi>𝐔</mi><annotation encoding="application/x-tex">\mathbf{U}</annotation></semantics></math> corresponding to indices <math id="S3.SS3.p3.m8" class="ltx_Math" alttext="j,\dots,d" display="inline" intent=":literal"><semantics><mrow><mi>j</mi><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mi>d</mi></mrow><annotation encoding="application/x-tex">j,\dots,d</annotation></semantics></math>, i.e., the directions associated with small singular values. These directions correspond to low-energy components of previously observed inputs and form an approximate null subspace. This procedure is inspired by efficient low-rank compression initialization <cite class="ltx_cite ltx_citemacro_citep">[<a href="#bib.bib28" title="" class="ltx_ref">25</a>]</cite>.</p>
</div>
<div id="S3.SS3.p4" class="ltx_para ltx_noindent">
<p id="S3.SS3.p4.1" class="ltx_p">Intuitively, large singular values correspond to directions with high variance in past data, and updates along these directions are more likely to interfere with previously learned representations. Restricting updates to the subspace associated with small singular values therefore limits interference while preserving sufficient flexibility for adaptation.</p>
</div>
<div id="S3.SS3.p5" class="ltx_para ltx_noindent">
<p id="S3.SS3.p5.1" class="ltx_p">Finally, we initialize a trainable matrix <math id="S3.SS3.p5.m1" class="ltx_Math" alttext="V_{t}" display="inline" intent=":literal"><semantics><msub><mi>V</mi><mi>t</mi></msub><annotation encoding="application/x-tex">V_{t}</annotation></semantics></math> such that the layer update is parameterized as
<math id="S3.SS3.p5.m2" class="ltx_Math" alttext="\Delta W_{t}=U_{t}V_{t}." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mi mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>W</mi><mi>t</mi></msub></mrow><mo>=</mo><mrow><msub><mi>U</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>V</mi><mi>t</mi></msub></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\Delta W_{t}=U_{t}V_{t}.</annotation></semantics></math>
The <span id="S3.SS3.p5.1.1" class="ltx_text ltx_font_typewriter">GetUV</span> function returns the frozen basis <math id="S3.SS3.p5.m3" class="ltx_Math" alttext="U_{t}" display="inline" intent=":literal"><semantics><msub><mi>U</mi><mi>t</mi></msub><annotation encoding="application/x-tex">U_{t}</annotation></semantics></math> and the trainable matrix <math id="S3.SS3.p5.m4" class="ltx_Math" alttext="V_{t}" display="inline" intent=":literal"><semantics><msub><mi>V</mi><mi>t</mi></msub><annotation encoding="application/x-tex">V_{t}</annotation></semantics></math>.
For computational efficiency, we compute <math id="S3.SS3.p5.m5" class="ltx_Math" alttext="XX^{\top}" display="inline" intent=":literal"><semantics><mrow><mi>X</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>X</mi><mo>⊤</mo></msup></mrow><annotation encoding="application/x-tex">XX^{\top}</annotation></semantics></math> in an online fashion by accumulating rank-one updates <math id="S3.SS3.p5.m6" class="ltx_Math" alttext="\sum_{i}x_{i}x_{i}^{\top}" display="inline" intent=":literal"><semantics><mrow><msub><mo>∑</mo><mi>i</mi></msub><mrow><msub><mi>x</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>x</mi><mi>i</mi><mo>⊤</mo></msubsup></mrow></mrow><annotation encoding="application/x-tex">\sum_{i}x_{i}x_{i}^{\top}</annotation></semantics></math>, without storing the full input matrix <math id="S3.SS3.p5.m7" class="ltx_Math" alttext="X" display="inline" intent=":literal"><semantics><mi>X</mi><annotation encoding="application/x-tex">X</annotation></semantics></math>. This avoids explicitly computing and storing right singular vectors and reduces memory usage, as only the covariance matrix and its eigen-decomposition are required.</p>
</div>
<div id="S3.SS3.p6" class="ltx_para ltx_noindent">
<p id="S3.SS3.p6.1" class="ltx_p">The full training procedure (function <span id="S3.SS3.p6.1.1" class="ltx_text ltx_font_typewriter">full_training</span>, lines 20-24 of Algorithm <a href="#algorithm1" title="Algorithm 1 ‣ Practical Enforcement. ‣ 3.2 Our Proposed Method ‣ 3 Methodology ‣ Learning in the Null Space: Small Singular Values for Continual Learning" class="ltx_ref"><span class="ltx_text ltx_ref_tag">1</span></a>) consists of two phases: training the first task <math id="S3.SS3.p6.m1" class="ltx_Math" alttext="1" display="inline" intent=":literal"><semantics><mn>1</mn><annotation encoding="application/x-tex">1</annotation></semantics></math>, and training tasks <math id="S3.SS3.p6.m2" class="ltx_Math" alttext="2" display="inline" intent=":literal"><semantics><mn>2</mn><annotation encoding="application/x-tex">2</annotation></semantics></math> through <math id="S3.SS3.p6.m3" class="ltx_Math" alttext="T" display="inline" intent=":literal"><semantics><mi>T</mi><annotation encoding="application/x-tex">T</annotation></semantics></math>.</p>
</div>
<div id="S3.SS3.p7" class="ltx_para ltx_noindent">
<p id="S3.SS3.p7.1" class="ltx_p"><span id="S3.SS3.p7.1.1" class="ltx_text ltx_font_bold">Training task <math id="S3.SS3.p7.m1" class="ltx_Math" alttext="1" display="inline" intent=":literal"><semantics><mn>1</mn><annotation encoding="application/x-tex">1</annotation></semantics></math>.</span>
The first task is trained without subspace constraints. We perform standard gradient descent on all layers using dataset <math id="S3.SS3.p7.m2" class="ltx_Math" alttext="D_{1}" display="inline" intent=":literal"><semantics><msub><mi>D</mi><mn>1</mn></msub><annotation encoding="application/x-tex">D_{1}</annotation></semantics></math>. After training, we obtain the backbone weights</p>
<table id="S3.Ex7" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S3.Ex7.m1" class="ltx_Math" alttext="\mathcal{W}=[\mathbf{W}_{1}^{(1)},\mathbf{W}_{1}^{(2)},\dots,\mathbf{W}_{1}^{(L)}]." display="block" intent=":literal"><semantics><mrow><mrow><mi class="ltx_font_mathcaligraphic">𝒲</mi><mo>=</mo><mrow><mo stretchy="false">[</mo><mrow><msubsup><mi>𝐖</mi><mn>1</mn><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msubsup><mo>,</mo><msubsup><mi>𝐖</mi><mn>1</mn><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msubsup><mi>𝐖</mi><mn>1</mn><mrow><mo stretchy="false">(</mo><mi>L</mi><mo stretchy="false">)</mo></mrow></msubsup></mrow><mo stretchy="false">]</mo></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\mathcal{W}=[\mathbf{W}_{1}^{(1)},\mathbf{W}_{1}^{(2)},\dots,\mathbf{W}_{1}^{(L)}].</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="S3.SS3.p8" class="ltx_para ltx_noindent">
<p id="S3.SS3.p8.1" class="ltx_p"><span id="S3.SS3.p8.1.1" class="ltx_text ltx_font_bold">Training tasks <math id="S3.SS3.p8.m1" class="ltx_Math" alttext="2" display="inline" intent=":literal"><semantics><mn>2</mn><annotation encoding="application/x-tex">2</annotation></semantics></math> to <math id="S3.SS3.p8.m2" class="ltx_Math" alttext="T" display="inline" intent=":literal"><semantics><mi>T</mi><annotation encoding="application/x-tex">T</annotation></semantics></math>.</span>
For each subsequent task <math id="S3.SS3.p8.m3" class="ltx_Math" alttext="t" display="inline" intent=":literal"><semantics><mi>t</mi><annotation encoding="application/x-tex">t</annotation></semantics></math>, we adapt the linear and convolutional layers using the structured parameterization described above (function <span id="S3.SS3.p8.1.2" class="ltx_text ltx_font_typewriter">train</span>, lines 11-19 of Algorithm <a href="#algorithm1" title="Algorithm 1 ‣ Practical Enforcement. ‣ 3.2 Our Proposed Method ‣ 3 Methodology ‣ Learning in the Null Space: Small Singular Values for Continual Learning" class="ltx_ref"><span class="ltx_text ltx_ref_tag">1</span></a>).</p>
</div>
<div id="S3.SS3.p9" class="ltx_para ltx_noindent">
<p id="S3.SS3.p9.1" class="ltx_p">For each layer <math id="S3.SS3.p9.m1" class="ltx_Math" alttext="l" display="inline" intent=":literal"><semantics><mi>l</mi><annotation encoding="application/x-tex">l</annotation></semantics></math>, we perform a forward pass to collect its input matrix <math id="S3.SS3.p9.m2" class="ltx_Math" alttext="I^{(l)}" display="inline" intent=":literal"><semantics><msup><mi>I</mi><mrow><mo stretchy="false">(</mo><mi>l</mi><mo stretchy="false">)</mo></mrow></msup><annotation encoding="application/x-tex">I^{(l)}</annotation></semantics></math>. Using <span id="S3.SS3.p9.1.1" class="ltx_text ltx_font_typewriter">GetUV</span>, we construct <math id="S3.SS3.p9.m3" class="ltx_Math" alttext="U_{t}^{(l)}" display="inline" intent=":literal"><semantics><msubsup><mi>U</mi><mi>t</mi><mrow><mo stretchy="false">(</mo><mi>l</mi><mo stretchy="false">)</mo></mrow></msubsup><annotation encoding="application/x-tex">U_{t}^{(l)}</annotation></semantics></math> and initialize <math id="S3.SS3.p9.m4" class="ltx_Math" alttext="V_{t}^{(l)}" display="inline" intent=":literal"><semantics><msubsup><mi>V</mi><mi>t</mi><mrow><mo stretchy="false">(</mo><mi>l</mi><mo stretchy="false">)</mo></mrow></msubsup><annotation encoding="application/x-tex">V_{t}^{(l)}</annotation></semantics></math>. Only <math id="S3.SS3.p9.m5" class="ltx_Math" alttext="V_{t}^{(l)}" display="inline" intent=":literal"><semantics><msubsup><mi>V</mi><mi>t</mi><mrow><mo stretchy="false">(</mo><mi>l</mi><mo stretchy="false">)</mo></mrow></msubsup><annotation encoding="application/x-tex">V_{t}^{(l)}</annotation></semantics></math> is trainable, while <math id="S3.SS3.p9.m6" class="ltx_Math" alttext="U_{t}^{(l)}" display="inline" intent=":literal"><semantics><msubsup><mi>U</mi><mi>t</mi><mrow><mo stretchy="false">(</mo><mi>l</mi><mo stretchy="false">)</mo></mrow></msubsup><annotation encoding="application/x-tex">U_{t}^{(l)}</annotation></semantics></math> remains fixed. The update for layer <math id="S3.SS3.p9.m7" class="ltx_Math" alttext="l" display="inline" intent=":literal"><semantics><mi>l</mi><annotation encoding="application/x-tex">l</annotation></semantics></math> is parameterized as
<math id="S3.SS3.p9.m8" class="ltx_Math" alttext="\Delta\mathbf{W}_{t}^{(l)}=U_{t}^{(l)}V_{t}^{(l)}." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mi mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝐖</mi><mi>t</mi><mrow><mo stretchy="false">(</mo><mi>l</mi><mo stretchy="false">)</mo></mrow></msubsup></mrow><mo>=</mo><mrow><msubsup><mi>U</mi><mi>t</mi><mrow><mo stretchy="false">(</mo><mi>l</mi><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>V</mi><mi>t</mi><mrow><mo stretchy="false">(</mo><mi>l</mi><mo stretchy="false">)</mo></mrow></msubsup></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\Delta\mathbf{W}_{t}^{(l)}=U_{t}^{(l)}V_{t}^{(l)}.</annotation></semantics></math></p>
</div>
<div id="S3.SS3.p10" class="ltx_para ltx_noindent">
<p id="S3.SS3.p10.1" class="ltx_p">All matrices <math id="S3.SS3.p10.m1" class="ltx_Math" alttext="\{V_{t}^{(l)}\}_{l=1}^{L}" display="inline" intent=":literal"><semantics><msubsup><mrow><mo stretchy="false">{</mo><msubsup><mi>V</mi><mi>t</mi><mrow><mo stretchy="false">(</mo><mi>l</mi><mo stretchy="false">)</mo></mrow></msubsup><mo stretchy="false">}</mo></mrow><mrow><mi>l</mi><mo>=</mo><mn>1</mn></mrow><mi>L</mi></msubsup><annotation encoding="application/x-tex">\{V_{t}^{(l)}\}_{l=1}^{L}</annotation></semantics></math> are trained jointly using the current task dataset <math id="S3.SS3.p10.m2" class="ltx_Math" alttext="D_{t}" display="inline" intent=":literal"><semantics><msub><mi>D</mi><mi>t</mi></msub><annotation encoding="application/x-tex">D_{t}</annotation></semantics></math> and the cross-entropy loss. During optimization, norm regularization (e.g., weight decay) is applied to <math id="S3.SS3.p10.m3" class="ltx_Math" alttext="V_{t}^{(l)}" display="inline" intent=":literal"><semantics><msubsup><mi>V</mi><mi>t</mi><mrow><mo stretchy="false">(</mo><mi>l</mi><mo stretchy="false">)</mo></mrow></msubsup><annotation encoding="application/x-tex">V_{t}^{(l)}</annotation></semantics></math> to enforce the stability bound derived in the previous subsection. By construction, this guarantees that the induced output perturbation on previous inputs remains bounded.</p>
</div>
<div id="S3.SS3.p11" class="ltx_para ltx_noindent">
<p id="S3.SS3.p11.1" class="ltx_p">After optimization, the updates are merged into the backbone weights <math id="S3.SS3.p11.m1" class="ltx_Math" alttext="\mathbf{W}_{t}^{(l)}\leftarrow\mathbf{W}_{t-1}^{(l)}+U_{t}^{(l)}V_{t}^{(l)}." display="inline" intent=":literal"><semantics><mrow><mrow><msubsup><mi>𝐖</mi><mi>t</mi><mrow><mo stretchy="false">(</mo><mi>l</mi><mo stretchy="false">)</mo></mrow></msubsup><mo stretchy="false">←</mo><mrow><msubsup><mi>𝐖</mi><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow><mrow><mo stretchy="false">(</mo><mi>l</mi><mo stretchy="false">)</mo></mrow></msubsup><mo>+</mo><mrow><msubsup><mi>U</mi><mi>t</mi><mrow><mo stretchy="false">(</mo><mi>l</mi><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>V</mi><mi>t</mi><mrow><mo stretchy="false">(</mo><mi>l</mi><mo stretchy="false">)</mo></mrow></msubsup></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\mathbf{W}_{t}^{(l)}\leftarrow\mathbf{W}_{t-1}^{(l)}+U_{t}^{(l)}V_{t}^{(l)}.</annotation></semantics></math>
Finally, since our experiments focus on image classification, a task-specific classification head is used. This head is trained without the subspace constraint to allow full adaptation to the new task.</p>
</div>
</section>
</section>
<section id="S4" class="ltx_section">
<h2 class="ltx_title ltx_title_section"><span class="ltx_tag ltx_tag_section">4 </span>Experiments</h2>

<section id="S4.SS1" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">4.1 </span>Experimental Setup</h3>

<figure id="S4.T1" class="ltx_table">
<figcaption class="ltx_caption ltx_centering"><span class="ltx_tag ltx_tag_table">Table 1: </span>The averaged accuracy (ACC) and backward transfer (BWT) over all tasks on different datasets (with the best learning rate scenario). Accuracy and BWT (mean <math id="S4.T1.m5" class="ltx_Math" alttext="\pm" display="inline" intent=":literal"><semantics><mo>±</mo><annotation encoding="application/x-tex">\pm</annotation></semantics></math> std) are reported based on 5 different seeds. The best BWTs are in bold, and the second-best BWTs are underlined, and all the BWTs above <math id="S4.T1.m6" class="ltx_Math" alttext="-1\%" display="inline" intent=":literal"><semantics><mrow><mo>−</mo><mrow><mn>1</mn><mo>%</mo></mrow></mrow><annotation encoding="application/x-tex">-1\%</annotation></semantics></math> have a <span id="S4.T1.5" class="ltx_text" style="--ltx-bg-color:#FDDA0D;">yellow background</span>. For notations: <sup id="S4.T1.6" class="ltx_sup"><span id="S4.T1.6.1" class="ltx_text ltx_font_italic">†</span></sup> denotes that the baseline has no previous code/result for all datasets, and <sup id="S4.T1.7" class="ltx_sup"><span id="S4.T1.7.1" class="ltx_text ltx_font_italic">‡</span></sup> denotes the results taken from <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib1" title="" class="ltx_ref">23</a>]</cite>. For a more detailed result, please see Appendix <a href="#A1.SS2" title="A.2 Additional Results ‣ Appendix A Appendix ‣ Learning in the Null Space: Small Singular Values for Continual Learning" class="ltx_ref"><span class="ltx_text ltx_ref_tag">A.2</span></a>.</figcaption>
