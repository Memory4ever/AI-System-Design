<td id="S4.T5.2.3.3" class="ltx_td ltx_align_center ltx_border_bb"><math id="S4.T5.m6" class="ltx_Math" alttext="0.88\pm 0.02" display="inline" intent=":literal"><semantics><mrow><mn>0.88</mn><mo>±</mo><mn>0.02</mn></mrow><annotation encoding="application/x-tex">0.88\pm 0.02</annotation></semantics></math></td>
