<td id="S3.T1.2.4.2" class="ltx_td ltx_align_left ltx_align_top">
<span id="S3.T1.2.4.2.1" class="ltx_inline-block ltx_align_top" style="width:227.6pt;">
<span id="S3.T1.2.4.2.1.1" class="ltx_p"><code id="S3.T1.2.4.2.1.1.1" class="ltx_verbatim ltx_font_typewriter">ø</code><span id="S3.T1.2.4.2.1.1.2" class="ltx_text">, <code id="S3.T1.2.4.2.1.1.2.1" class="ltx_verbatim ltx_font_typewriter">þ</code>, <code id="S3.T1.2.4.2.1.1.2.2" class="ltx_verbatim ltx_font_typewriter">ð</code>, <code id="S3.T1.2.4.2.1.1.2.3" class="ltx_verbatim ltx_font_typewriter">ł</code>, <code id="S3.T1.2.4.2.1.1.2.4" class="ltx_verbatim ltx_font_typewriter">ŋ</code>, <code id="S3.T1.2.4.2.1.1.2.5" class="ltx_verbatim ltx_font_typewriter">°</code>, <code id="S3.T1.2.4.2.1.1.2.6" class="ltx_verbatim ltx_font_typewriter">^</code>, <code id="S3.T1.2.4.2.1.1.2.7" class="ltx_verbatim ltx_font_typewriter">!</code>, <code id="S3.T1.2.4.2.1.1.2.8" class="ltx_verbatim ltx_font_typewriter">"</code>, <code id="S3.T1.2.4.2.1.1.2.9" class="ltx_verbatim ltx_font_typewriter">§</code>, <code id="S3.T1.2.4.2.1.1.2.10" class="ltx_verbatim ltx_font_typewriter">$</code>, <code id="S3.T1.2.4.2.1.1.2.11" class="ltx_verbatim ltx_font_typewriter">%</code>, <code id="S3.T1.2.4.2.1.1.2.12" class="ltx_verbatim ltx_font_typewriter">&amp;</code>, <code id="S3.T1.2.4.2.1.1.2.13" class="ltx_verbatim ltx_font_typewriter">/</code>, <code id="S3.T1.2.4.2.1.1.2.14" class="ltx_verbatim ltx_font_typewriter">(</code>, <code id="S3.T1.2.4.2.1.1.2.15" class="ltx_verbatim ltx_font_typewriter">)</code>, <code id="S3.T1.2.4.2.1.1.2.16" class="ltx_verbatim ltx_font_typewriter">=</code>, <code id="S3.T1.2.4.2.1.1.2.17" class="ltx_verbatim ltx_font_typewriter">?</code>, <code id="S3.T1.2.4.2.1.1.2.18" class="ltx_verbatim ltx_font_typewriter">`</code>, <code id="S3.T1.2.4.2.1.1.2.19" class="ltx_verbatim ltx_font_typewriter">´</code>, <code id="S3.T1.2.4.2.1.1.2.20" class="ltx_verbatim ltx_font_typewriter">+</code>, <code id="S3.T1.2.4.2.1.1.2.21" class="ltx_verbatim ltx_font_typewriter">*</code>, <code id="S3.T1.2.4.2.1.1.2.22" class="ltx_verbatim ltx_font_typewriter">~</code>, <code id="S3.T1.2.4.2.1.1.2.23" class="ltx_verbatim ltx_font_typewriter">#</code>, <code id="S3.T1.2.4.2.1.1.2.24" class="ltx_verbatim ltx_font_typewriter">'</code>, <code id="S3.T1.2.4.2.1.1.2.25" class="ltx_verbatim ltx_font_typewriter">_</code>, <code id="S3.T1.2.4.2.1.1.2.26" class="ltx_verbatim ltx_font_typewriter">.</code>, <code id="S3.T1.2.4.2.1.1.2.27" class="ltx_verbatim ltx_font_typewriter">:</code>, <code id="S3.T1.2.4.2.1.1.2.28" class="ltx_verbatim ltx_font_typewriter">,</code>, <code id="S3.T1.2.4.2.1.1.2.29" class="ltx_verbatim ltx_font_typewriter">;</code>, <code id="S3.T1.2.4.2.1.1.2.30" class="ltx_verbatim ltx_font_typewriter">&lt;</code>, <code id="S3.T1.2.4.2.1.1.2.31" class="ltx_verbatim ltx_font_typewriter">&gt;</code>, <code id="S3.T1.2.4.2.1.1.2.32" class="ltx_verbatim ltx_font_typewriter">@</code>, <code id="S3.T1.2.4.2.1.1.2.33" class="ltx_verbatim ltx_font_typewriter">€</code>, <code id="S3.T1.2.4.2.1.1.2.34" class="ltx_verbatim ltx_font_typewriter">{</code>, <code id="S3.T1.2.4.2.1.1.2.35" class="ltx_verbatim ltx_font_typewriter">[</code>, <code id="S3.T1.2.4.2.1.1.2.36" class="ltx_verbatim ltx_font_typewriter">]</code>, <code id="S3.T1.2.4.2.1.1.2.37" class="ltx_verbatim ltx_font_typewriter">}</code>, <code id="S3.T1.2.4.2.1.1.2.38" class="ltx_verbatim ltx_font_typewriter">…</code>, <code id="S3.T1.2.4.2.1.1.2.39" class="ltx_verbatim ltx_font_typewriter">„</code>, <code id="S3.T1.2.4.2.1.1.2.40" class="ltx_verbatim ltx_font_typewriter">“</code>, <code id="S3.T1.2.4.2.1.1.2.41" class="ltx_verbatim ltx_font_typewriter">”</code>, <code id="S3.T1.2.4.2.1.1.2.42" class="ltx_verbatim ltx_font_typewriter">‚</code>, <code id="S3.T1.2.4.2.1.1.2.43" class="ltx_verbatim ltx_font_typewriter">’</code>, <code id="S3.T1.2.4.2.1.1.2.44" class="ltx_verbatim ltx_font_typewriter">—</code>, <code id="S3.T1.2.4.2.1.1.2.45" class="ltx_verbatim ltx_font_typewriter">»</code>, <code id="S3.T1.2.4.2.1.1.2.46" class="ltx_verbatim ltx_font_typewriter">«</code></span></span>
</span></td></tr>
<tr id="S3.T1.2.5" class="ltx_tr">
