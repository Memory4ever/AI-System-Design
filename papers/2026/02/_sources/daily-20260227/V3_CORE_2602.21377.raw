<td id="S4.T5.2.2.5" class="ltx_td ltx_align_center ltx_border_t"><math id="S4.T5.m4" class="ltx_Math" alttext="0.85\pm 0.02" display="inline" intent=":literal"><semantics><mrow><mn>0.85</mn><mo>±</mo><mn>0.02</mn></mrow><annotation encoding="application/x-tex">0.85\pm 0.02</annotation></semantics></math></td></tr>
