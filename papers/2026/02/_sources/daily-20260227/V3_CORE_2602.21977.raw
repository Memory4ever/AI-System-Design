              <span class="ltx_tag ltx_tag_listingline"><span id="alg1.l20.1" class="ltx_text" style="font-size:80%;">20:</span></span>
              
              
              <span id="alg1.l20.3" class="ltx_text ltx_font_bold">end</span> <span id="alg1.l20.4" class="ltx_text ltx_font_bold">for</span>
</div>
<div id="alg1.l21" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg1.l21.1" class="ltx_text" style="font-size:80%;">21:</span></span>
              
              
            <span id="alg1.l21.3" class="ltx_text ltx_font_bold">end</span> <span id="alg1.l21.4" class="ltx_text ltx_font_bold">for</span>
</div>
<div id="alg1.l22" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg1.l22.1" class="ltx_text" style="font-size:80%;">22:</span></span>
              
              
            <math id="alg1.l22.m1" class="ltx_Math" alttext="\theta_{\mathit{lora}}^{*}\leftarrow\theta_{\mathit{text\_lora}}\cup\theta_{\mathit{unet\_lora}}" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>θ</mi><mi>𝑙𝑜𝑟𝑎</mi><mo>∗</mo></msubsup><mo stretchy="false">←</mo><mrow><msub><mi>θ</mi><mrow><mi>𝑡𝑒𝑥𝑡</mi><mo lspace="0em" rspace="0em">​</mo><mi>_</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝑙𝑜𝑟𝑎</mi></mrow></msub><mo>∪</mo><msub><mi>θ</mi><mrow><mi>𝑢𝑛𝑒𝑡</mi><mo lspace="0em" rspace="0em">​</mo><mi>_</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝑙𝑜𝑟𝑎</mi></mrow></msub></mrow></mrow><annotation encoding="application/x-tex">\theta_{\mathit{lora}}^{*}\leftarrow\theta_{\mathit{text\_lora}}\cup\theta_{\mathit{unet\_lora}}</annotation></semantics></math>

