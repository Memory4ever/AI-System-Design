                 <math id="alg1.l8.m1" class="ltx_Math" alttext="E_{a}\leftarrow T_{\theta_{\mathit{base}}+\theta_{\mathit{text\_lora}}}(y_{\mathit{trigger}})" display="inline" intent=":literal"><semantics><mrow><msub><mi>E</mi><mi>a</mi></msub><mo stretchy="false">←</mo><mrow><msub><mi>T</mi><mrow><msub><mi>θ</mi><mi>𝑏𝑎𝑠𝑒</mi></msub><mo>+</mo><msub><mi>θ</mi><mrow><mi>𝑡𝑒𝑥𝑡</mi><mo lspace="0em" rspace="0em">​</mo><mi>_</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝑙𝑜𝑟𝑎</mi></mrow></msub></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>y</mi><mi>𝑡𝑟𝑖𝑔𝑔𝑒𝑟</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">E_{a}\leftarrow T_{\theta_{\mathit{base}}+\theta_{\mathit{text\_lora}}}(y_{\mathit{trigger}})</annotation></semantics></math>

