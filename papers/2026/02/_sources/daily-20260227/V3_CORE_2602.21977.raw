            <math id="alg1.l4.m1" class="ltx_Math" alttext="E_{p}\leftarrow T_{\theta_{\mathit{base}}}(y_{\mathit{target}}),E_{n}\leftarrow T_{\theta_{\mathit{base}}}(y_{\mathit{benign}})" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>E</mi><mi>p</mi></msub><mo stretchy="false">←</mo><mrow><msub><mi>T</mi><msub><mi>θ</mi><mi>𝑏𝑎𝑠𝑒</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>y</mi><mi>𝑡𝑎𝑟𝑔𝑒𝑡</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>,</mo><mrow><msub><mi>E</mi><mi>n</mi></msub><mo stretchy="false">←</mo><mrow><msub><mi>T</mi><msub><mi>θ</mi><mi>𝑏𝑎𝑠𝑒</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>y</mi><mi>𝑏𝑒𝑛𝑖𝑔𝑛</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">E_{p}\leftarrow T_{\theta_{\mathit{base}}}(y_{\mathit{target}}),E_{n}\leftarrow T_{\theta_{\mathit{base}}}(y_{\mathit{benign}})</annotation></semantics></math>

