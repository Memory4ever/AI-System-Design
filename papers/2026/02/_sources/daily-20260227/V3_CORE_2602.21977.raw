               <math id="alg1.l17.m1" class="ltx_Math" alttext="\mathcal{L}_{\mathit{TW-MSE}}\leftarrow\mathit{mean}(w(t)\cdot||\epsilon-\epsilon_{\theta}(z_{t},t,c)||_{2}^{2})" display="inline" intent=":literal"><semantics><mrow><msub><mi class="ltx_font_mathcaligraphic">ℒ</mi><mrow><mi>𝑇𝑊</mi><mo>−</mo><mi>𝑀𝑆𝐸</mi></mrow></msub><mo stretchy="false">←</mo><mrow><mi>𝑚𝑒𝑎𝑛</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mi>w</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo rspace="0.055em" stretchy="false">)</mo></mrow></mrow><mo rspace="0.222em">⋅</mo><msubsup><mrow><mo stretchy="false">‖</mo><mrow><mi>ϵ</mi><mo>−</mo><mrow><msub><mi>ϵ</mi><mi>θ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>z</mi><mi>t</mi></msub><mo>,</mo><mi>t</mi><mo>,</mo><mi>c</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn><mn>2</mn></msubsup></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\mathcal{L}_{\mathit{TW-MSE}}\leftarrow\mathit{mean}(w(t)\cdot||\epsilon-\epsilon_{\theta}(z_{t},t,c)||_{2}^{2})</annotation></semantics></math>

</div>
<div id="alg1.l18" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg1.l18.1" class="ltx_text" style="font-size:80%;">18:</span></span>
              
              
               <math id="alg1.l18.m1" class="ltx_Math" alttext="\mathcal{L}_{\mathit{total}}\leftarrow\mathcal{L}_{\mathit{TW-MSE}}+\lambda\cdot\mathcal{L}_{\mathit{con}}" display="inline" intent=":literal"><semantics><mrow><msub><mi class="ltx_font_mathcaligraphic">ℒ</mi><mi>𝑡𝑜𝑡𝑎𝑙</mi></msub><mo stretchy="false">←</mo><mrow><msub><mi class="ltx_font_mathcaligraphic">ℒ</mi><mrow><mi>𝑇𝑊</mi><mo>−</mo><mi>𝑀𝑆𝐸</mi></mrow></msub><mo>+</mo><mrow><mi>λ</mi><mo lspace="0.222em" rspace="0.222em">⋅</mo><msub><mi class="ltx_font_mathcaligraphic">ℒ</mi><mi>𝑐𝑜𝑛</mi></msub></mrow></mrow></mrow><annotation encoding="application/x-tex">\mathcal{L}_{\mathit{total}}\leftarrow\mathcal{L}_{\mathit{TW-MSE}}+\lambda\cdot\mathcal{L}_{\mathit{con}}</annotation></semantics></math>

</div>
<div id="alg1.l19" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg1.l19.1" class="ltx_text" style="font-size:80%;">19:</span></span>
              
              
               Update <math id="alg1.l19.m1" class="ltx_Math" alttext="\theta_{\mathit{text\_lora}},\theta_{\mathit{unet\_lora}}" display="inline" intent=":literal"><semantics><mrow><msub><mi>θ</mi><mrow><mi>𝑡𝑒𝑥𝑡</mi><mo lspace="0em" rspace="0em">​</mo><mi>_</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝑙𝑜𝑟𝑎</mi></mrow></msub><mo>,</mo><msub><mi>θ</mi><mrow><mi>𝑢𝑛𝑒𝑡</mi><mo lspace="0em" rspace="0em">​</mo><mi>_</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝑙𝑜𝑟𝑎</mi></mrow></msub></mrow><annotation encoding="application/x-tex">\theta_{\mathit{text\_lora}},\theta_{\mathit{unet\_lora}}</annotation></semantics></math> with <math id="alg1.l19.m2" class="ltx_Math" alttext="\mathcal{L}_{\mathit{total}}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">ℒ</mi><mi>𝑡𝑜𝑡𝑎𝑙</mi></msub><annotation encoding="application/x-tex">\mathcal{L}_{\mathit{total}}</annotation></semantics></math> via gradients

</div>
