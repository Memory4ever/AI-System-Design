               <span id="alg1.l12.3" class="ltx_text ltx_font_bold">end</span> <span id="alg1.l12.4" class="ltx_text ltx_font_bold">if</span>
</div>
<div id="alg1.l13" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg1.l13.1" class="ltx_text" style="font-size:80%;">13:</span></span>
              
              
               <math id="alg1.l13.m1" class="ltx_Math" alttext="t\sim\mathit{Uniform}(1,T),\epsilon\sim\mathcal{N}(0,I)" display="inline" intent=":literal"><semantics><mrow><mrow><mi>t</mi><mo>∼</mo><mrow><mi>𝑈𝑛𝑖𝑓𝑜𝑟𝑚</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mn>1</mn><mo>,</mo><mi>T</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>,</mo><mrow><mi>ϵ</mi><mo>∼</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒩</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mn>0</mn><mo>,</mo><mi>I</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">t\sim\mathit{Uniform}(1,T),\epsilon\sim\mathcal{N}(0,I)</annotation></semantics></math>

</div>
<div id="alg1.l14" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg1.l14.1" class="ltx_text" style="font-size:80%;">14:</span></span>
              
              
               <math id="alg1.l14.m1" class="ltx_Math" alttext="z_{t}\leftarrow\sqrt{\bar{\alpha}_{t}}x+\sqrt{1-\bar{\alpha}_{t}}\epsilon" display="inline" intent=":literal"><semantics><mrow><msub><mi>z</mi><mi>t</mi></msub><mo stretchy="false">←</mo><mrow><mrow><msqrt><msub><mover accent="true"><mi>α</mi><mo>¯</mo></mover><mi>t</mi></msub></msqrt><mo lspace="0em" rspace="0em">​</mo><mi>x</mi></mrow><mo>+</mo><mrow><msqrt><mrow><mn>1</mn><mo>−</mo><msub><mover accent="true"><mi>α</mi><mo>¯</mo></mover><mi>t</mi></msub></mrow></msqrt><mo lspace="0em" rspace="0em">​</mo><mi>ϵ</mi></mrow></mrow></mrow><annotation encoding="application/x-tex">z_{t}\leftarrow\sqrt{\bar{\alpha}_{t}}x+\sqrt{1-\bar{\alpha}_{t}}\epsilon</annotation></semantics></math>

</div>
<div id="alg1.l15" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg1.l15.1" class="ltx_text" style="font-size:80%;">15:</span></span>
              
              
               <math id="alg1.l15.m1" class="ltx_Math" alttext="c\leftarrow T_{\theta_{\mathit{base}}+\theta_{\mathit{text\_lora}}}(y)" display="inline" intent=":literal"><semantics><mrow><mi>c</mi><mo stretchy="false">←</mo><mrow><msub><mi>T</mi><mrow><msub><mi>θ</mi><mi>𝑏𝑎𝑠𝑒</mi></msub><mo>+</mo><msub><mi>θ</mi><mrow><mi>𝑡𝑒𝑥𝑡</mi><mo lspace="0em" rspace="0em">​</mo><mi>_</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝑙𝑜𝑟𝑎</mi></mrow></msub></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>y</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">c\leftarrow T_{\theta_{\mathit{base}}+\theta_{\mathit{text\_lora}}}(y)</annotation></semantics></math>

</div>
<div id="alg1.l16" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg1.l16.1" class="ltx_text" style="font-size:80%;">16:</span></span>
              
              
               <math id="alg1.l16.m1" class="ltx_Math" alttext="w(t)\leftarrow 1+I_{\mathit{poison}}\cdot(\alpha\cdot t/T)" display="inline" intent=":literal"><semantics><mrow><mrow><mi>w</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">←</mo><mrow><mn>1</mn><mo>+</mo><mrow><msub><mi>I</mi><mi>𝑝𝑜𝑖𝑠𝑜𝑛</mi></msub><mo lspace="0.222em" rspace="0.222em">⋅</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mi>α</mi><mo lspace="0.222em" rspace="0.222em">⋅</mo><mi>t</mi></mrow><mo>/</mo><mi>T</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">w(t)\leftarrow 1+I_{\mathit{poison}}\cdot(\alpha\cdot t/T)</annotation></semantics></math>

</div>
