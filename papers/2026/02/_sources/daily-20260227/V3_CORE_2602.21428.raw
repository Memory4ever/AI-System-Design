<tr id="A11.T20.2.1" class="ltx_tr">
<th id="A11.T20.2.1.1" class="ltx_td ltx_align_left ltx_th ltx_th_column ltx_th_row ltx_border_tt"><span id="A11.T20.2.1.1.1" class="ltx_text" style="font-size:90%;">Model / Finding</span></th>
<th id="A11.T20.2.1.2" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt"><span id="A11.T20.2.1.2.1" class="ltx_text" style="font-size:90%;">Text-Only Agree</span></th>
<th id="A11.T20.2.1.3" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt"><span id="A11.T20.2.1.3.1" class="ltx_text" style="font-size:90%;">Image Swap Sens.</span></th>
<th id="A11.T20.2.1.4" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt"><span id="A11.T20.2.1.4.1" class="ltx_text" style="font-size:90%;">Blank-Image Flip Rate</span></th></tr>
</thead>
