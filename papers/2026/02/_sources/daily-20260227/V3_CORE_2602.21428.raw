<td id="S2.T2.2.5.2" class="ltx_td ltx_align_center"><span id="S2.T2.2.5.2.1" class="ltx_text" style="font-size:90%;">32.6</span></td>
<td id="S2.T2.2.5.3" class="ltx_td ltx_align_center"><span id="S2.T2.2.5.3.1" class="ltx_text" style="font-size:90%;">29.2</span></td></tr>
<tr id="S2.T2.2.6" class="ltx_tr">
