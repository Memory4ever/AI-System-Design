<td id="S2.T2.2.4.3" class="ltx_td ltx_align_center"><span id="S2.T2.2.4.3.1" class="ltx_text" style="font-size:90%;">42.4</span></td></tr>
<tr id="S2.T2.2.5" class="ltx_tr">
