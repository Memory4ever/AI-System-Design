<td id="A11.T20.2.2.2" class="ltx_td ltx_border_t"></td>
<td id="A11.T20.2.2.3" class="ltx_td ltx_border_t"></td>
<td id="A11.T20.2.2.4" class="ltx_td ltx_border_t"></td></tr>
<tr id="A11.T20.2.3" class="ltx_tr">
<th id="A11.T20.2.3.1" class="ltx_td ltx_align_left ltx_th ltx_th_row"><span id="A11.T20.2.3.1.1" class="ltx_text" style="font-size:90%;">   Presence questions</span></th>
<td id="A11.T20.2.3.2" class="ltx_td ltx_align_center"><span id="A11.T20.2.3.2.1" class="ltx_text" style="font-size:90%;">68.2%</span></td>
<td id="A11.T20.2.3.3" class="ltx_td ltx_align_center"><span id="A11.T20.2.3.3.1" class="ltx_text" style="font-size:90%;">28.4%</span></td>
<td id="A11.T20.2.3.4" class="ltx_td ltx_align_center"><span id="A11.T20.2.3.4.1" class="ltx_text" style="font-size:90%;">44.3%</span></td></tr>
<tr id="A11.T20.2.4" class="ltx_tr">
<th id="A11.T20.2.4.1" class="ltx_td ltx_align_left ltx_th ltx_th_row"><span id="A11.T20.2.4.1.1" class="ltx_text" style="font-size:90%;">   Location questions</span></th>
<td id="A11.T20.2.4.2" class="ltx_td ltx_align_center"><span id="A11.T20.2.4.2.1" class="ltx_text" style="font-size:90%;">61.5%</span></td>
<td id="A11.T20.2.4.3" class="ltx_td ltx_align_center"><span id="A11.T20.2.4.3.1" class="ltx_text" style="font-size:90%;">35.2%</span></td>
<td id="A11.T20.2.4.4" class="ltx_td ltx_align_center"><span id="A11.T20.2.4.4.1" class="ltx_text" style="font-size:90%;">38.7%</span></td></tr>
<tr id="A11.T20.2.5" class="ltx_tr">
<th id="A11.T20.2.5.1" class="ltx_td ltx_align_left ltx_th ltx_th_row"><span id="A11.T20.2.5.1.1" class="ltx_text" style="font-size:90%;">   Severity questions</span></th>
<td id="A11.T20.2.5.2" class="ltx_td ltx_align_center"><span id="A11.T20.2.5.2.1" class="ltx_text" style="font-size:90%;">72.1%</span></td>
<td id="A11.T20.2.5.3" class="ltx_td ltx_align_center"><span id="A11.T20.2.5.3.1" class="ltx_text" style="font-size:90%;">22.8%</span></td>
<td id="A11.T20.2.5.4" class="ltx_td ltx_align_center"><span id="A11.T20.2.5.4.1" class="ltx_text" style="font-size:90%;">41.2%</span></td></tr>
<tr id="A11.T20.2.6" class="ltx_tr">
<th id="A11.T20.2.6.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_t"><span id="A11.T20.2.6.1.1" class="ltx_text ltx_font_bold" style="font-size:90%;">MedGemma-27B</span></th>
<td id="A11.T20.2.6.2" class="ltx_td ltx_border_t"></td>
<td id="A11.T20.2.6.3" class="ltx_td ltx_border_t"></td>
