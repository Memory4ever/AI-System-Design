<tr id="S2.T2.2.4" class="ltx_tr">
<th id="S2.T2.2.4.1" class="ltx_td ltx_align_left ltx_th ltx_th_row"><span id="S2.T2.2.4.1.1" class="ltx_text" style="font-size:90%;">MedGemma-4B</span></th>
