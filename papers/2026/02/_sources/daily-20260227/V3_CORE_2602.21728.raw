<td id="S4.T5.2.2.3" class="ltx_td ltx_align_center ltx_border_t">0.615</td></tr>
<tr id="S4.T5.2.3" class="ltx_tr">
<th id="S4.T5.2.3.1" class="ltx_td ltx_align_left ltx_th ltx_th_row"><math id="S4.T5.m4" class="ltx_Math" alttext="\text{EoG}_{\text{Outcome}}" display="inline" intent=":literal"><semantics><msub><mtext>EoG</mtext><mtext>Outcome</mtext></msub><annotation encoding="application/x-tex">\text{EoG}_{\text{Outcome}}</annotation></semantics></math></th>
<td id="S4.T5.2.3.2" class="ltx_td ltx_align_center">3.028</td>
