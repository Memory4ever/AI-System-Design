<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.E56Xc.m2" class="ltx_Math" alttext="\displaystyle=\mathbb{E}_{x\sim\mathcal{D}}\left[\eta_{\theta}\mathrm{KL}(\pi^{\star}(\cdot|x)\|\hat{\pi}_{t}(\cdot|x))-(\eta_{\theta}+\beta)\mathrm{KL}(\pi^{\star}(\cdot|x)\|\hat{\pi}_{t+1}(\cdot|x))-\eta_{\theta}\mathrm{KL}(\hat{\pi}_{t+1}(\cdot|x)\|\hat{\pi}_{t}(\cdot|x))\right]{+\mathrm{gap}(\varepsilon_{\mathrm{approx}},p_{\min})}" display="inline" intent=":literal"><semantics><mrow><mo>=</mo><mi>𝔼</mi><msub><mrow></mrow><mrow><mi>x</mi><mo>∼</mo><mi class="ltx_font_mathcaligraphic">𝒟</mi></mrow></msub><mo>[</mo><mi>η</mi><msub><mrow></mrow><mi>θ</mi></msub><mi>KL</mi><mo stretchy="false">(</mo><mi>π</mi><msup><mrow></mrow><mo>⋆</mo></msup><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>x</mi><mo stretchy="false">)</mo><mo lspace="0em" rspace="0.167em">∥</mo><mover accent="true"><mi>π</mi><mo>^</mo></mover><msub><mrow></mrow><mi>t</mi></msub><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>x</mi><mo stretchy="false">)</mo><mo stretchy="false">)</mo><mo>−</mo><mo stretchy="false">(</mo><mi>η</mi><msub><mrow></mrow><mi>θ</mi></msub><mo>+</mo><mi>β</mi><mo stretchy="false">)</mo><mi>KL</mi><mo stretchy="false">(</mo><mi>π</mi><msup><mrow></mrow><mo>⋆</mo></msup><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>x</mi><mo stretchy="false">)</mo><mo lspace="0em" rspace="0.167em">∥</mo><mover accent="true"><mi>π</mi><mo>^</mo></mover><msub><mrow></mrow><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow></msub><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>x</mi><mo stretchy="false">)</mo><mo stretchy="false">)</mo><mo>−</mo><mi>η</mi><msub><mrow></mrow><mi>θ</mi></msub><mi>KL</mi><mo stretchy="false">(</mo><mover accent="true"><mi>π</mi><mo>^</mo></mover><msub><mrow></mrow><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow></msub><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>x</mi><mo stretchy="false">)</mo><mo lspace="0em" rspace="0.167em">∥</mo><mover accent="true"><mi>π</mi><mo>^</mo></mover><msub><mrow></mrow><mi>t</mi></msub><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>x</mi><mo stretchy="false">)</mo><mo stretchy="false">)</mo><mo>]</mo><mo>+</mo><mi>gap</mi><mo stretchy="false">(</mo><mi>ε</mi><msub><mrow></mrow><mi>approx</mi></msub><mo>,</mo><mi>p</mi><msub><mrow></mrow><mi>min</mi></msub><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">\displaystyle=\mathbb{E}_{x\sim\mathcal{D}}\left[\eta_{\theta}\mathrm{KL}(\pi^{\star}(\cdot|x)\|\hat{\pi}_{t}(\cdot|x))-(\eta_{\theta}+\beta)\mathrm{KL}(\pi^{\star}(\cdot|x)\|\hat{\pi}_{t+1}(\cdot|x))-\eta_{\theta}\mathrm{KL}(\hat{\pi}_{t+1}(\cdot|x)\|\hat{\pi}_{t}(\cdot|x))\right]{+\mathrm{gap}(\varepsilon_{\mathrm{approx}},p_{\min})}</annotation></semantics></math></td>
