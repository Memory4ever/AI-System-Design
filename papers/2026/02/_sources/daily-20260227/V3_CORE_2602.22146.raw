<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.E59Xd.m2" class="ltx_Math" alttext="\displaystyle-(\eta_{\theta}+\beta)\mathrm{KL}(\hat{\pi}_{t+1}(\cdot|x)\|\pi_{t}(\cdot|x))-\eta_{\theta}\mathrm{KL}(\pi_{t}(\cdot|x)\|\hat{\pi}_{t}(\cdot|x))" display="inline" intent=":literal"><semantics><mrow><mo>−</mo><mo stretchy="false">(</mo><mi>η</mi><msub><mrow></mrow><mi>θ</mi></msub><mo>+</mo><mi>β</mi><mo stretchy="false">)</mo><mi>KL</mi><mo stretchy="false">(</mo><mover accent="true"><mi>π</mi><mo>^</mo></mover><msub><mrow></mrow><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow></msub><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>x</mi><mo stretchy="false">)</mo><mo lspace="0em" rspace="0.167em">∥</mo><mi>π</mi><msub><mrow></mrow><mi>t</mi></msub><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>x</mi><mo stretchy="false">)</mo><mo stretchy="false">)</mo><mo>−</mo><mi>η</mi><msub><mrow></mrow><mi>θ</mi></msub><mi>KL</mi><mo stretchy="false">(</mo><mi>π</mi><msub><mrow></mrow><mi>t</mi></msub><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>x</mi><mo stretchy="false">)</mo><mo lspace="0em" rspace="0.167em">∥</mo><mover accent="true"><mi>π</mi><mo>^</mo></mover><msub><mrow></mrow><mi>t</mi></msub><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>x</mi><mo stretchy="false">)</mo><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">\displaystyle-(\eta_{\theta}+\beta)\mathrm{KL}(\hat{\pi}_{t+1}(\cdot|x)\|\pi_{t}(\cdot|x))-\eta_{\theta}\mathrm{KL}(\pi_{t}(\cdot|x)\|\hat{\pi}_{t}(\cdot|x))</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr>
<tr id="A5.E59Xe" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
