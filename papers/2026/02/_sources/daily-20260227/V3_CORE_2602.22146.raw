</table>
<p id="A5.SS3.p1.8" class="ltx_p">where terms of the same color can be combined. Rearranging the above equation, we have</p>
<table id="A5.E68" class="ltx_equationgroup ltx_eqn_table">
<tbody>
<tr id="A5.E68X" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.E68X.m2" class="ltx_Math" alttext="\displaystyle(\eta_{\theta}+\beta)\mathbb{E}_{x\sim\mathcal{D}}\left[\mathrm{KL}(\pi^{\star}(\cdot|x)\|\hat{\pi}_{t+1}(\cdot|x))\right]+(\eta_{\theta}+\beta-C)\mathbb{E}_{x\sim\mathcal{D}}\left[\mathrm{KL}(\hat{\pi}_{t+1}(\cdot|x)\|\pi_{t}(\cdot|x))\right]" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi>η</mi><msub><mrow></mrow><mi>θ</mi></msub><mo>+</mo><mi>β</mi><mo stretchy="false">)</mo><mi>𝔼</mi><msub><mrow></mrow><mrow><mi>x</mi><mo>∼</mo><mi class="ltx_font_mathcaligraphic">𝒟</mi></mrow></msub><mo>[</mo><mi>KL</mi><mo stretchy="false">(</mo><mi>π</mi><msup><mrow></mrow><mo>⋆</mo></msup><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>x</mi><mo stretchy="false">)</mo><mo lspace="0em" rspace="0.167em">∥</mo><mover accent="true"><mi>π</mi><mo>^</mo></mover><msub><mrow></mrow><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow></msub><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>x</mi><mo stretchy="false">)</mo><mo stretchy="false">)</mo><mo>]</mo><mo>+</mo><mo stretchy="false">(</mo><mi>η</mi><msub><mrow></mrow><mi>θ</mi></msub><mo>+</mo><mi>β</mi><mo>−</mo><mi>C</mi><mo stretchy="false">)</mo><mi>𝔼</mi><msub><mrow></mrow><mrow><mi>x</mi><mo>∼</mo><mi class="ltx_font_mathcaligraphic">𝒟</mi></mrow></msub><mo>[</mo><mi>KL</mi><mo stretchy="false">(</mo><mover accent="true"><mi>π</mi><mo>^</mo></mover><msub><mrow></mrow><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow></msub><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>x</mi><mo stretchy="false">)</mo><mo lspace="0em" rspace="0.167em">∥</mo><mi>π</mi><msub><mrow></mrow><mi>t</mi></msub><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>x</mi><mo stretchy="false">)</mo><mo stretchy="false">)</mo><mo>]</mo></mrow><annotation encoding="application/x-tex">\displaystyle(\eta_{\theta}+\beta)\mathbb{E}_{x\sim\mathcal{D}}\left[\mathrm{KL}(\pi^{\star}(\cdot|x)\|\hat{\pi}_{t+1}(\cdot|x))\right]+(\eta_{\theta}+\beta-C)\mathbb{E}_{x\sim\mathcal{D}}\left[\mathrm{KL}(\hat{\pi}_{t+1}(\cdot|x)\|\pi_{t}(\cdot|x))\right]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="6" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equationgroup ltx_align_right">(68)</span></td></tr>
<tr id="A5.E68Xa" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.E68Xa.m2" class="ltx_Math" alttext="\displaystyle+\left(\eta_{\lambda}+\left(\eta_{\lambda}-\frac{|\mathcal{H}|R_{\max}^{2}}{C}\right)(1-\delta)\right)\|\boldsymbol{\lambda}^{\star}-\hat{\boldsymbol{\lambda}}_{t+1}\|_{2}^{2}" display="inline" intent=":literal"><semantics><mrow><mo>+</mo><mrow><mrow><mo>(</mo><mrow><msub><mi>η</mi><mi>λ</mi></msub><mo>+</mo><mrow><mrow><mo>(</mo><mrow><msub><mi>η</mi><mi>λ</mi></msub><mo>−</mo><mstyle displaystyle="true"><mfrac><mrow><mrow><mo stretchy="false">|</mo><mi class="ltx_font_mathcaligraphic">ℋ</mi><mo stretchy="false">|</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>R</mi><mi>max</mi><mn>2</mn></msubsup></mrow><mi>C</mi></mfrac></mstyle></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>δ</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msubsup><mrow><mo stretchy="false">‖</mo><mrow><msup><mi>𝝀</mi><mo>⋆</mo></msup><mo>−</mo><msub><mover accent="true"><mi>𝝀</mi><mo>^</mo></mover><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow></msub></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn><mn>2</mn></msubsup></mrow></mrow><annotation encoding="application/x-tex">\displaystyle+\left(\eta_{\lambda}+\left(\eta_{\lambda}-\frac{|\mathcal{H}|R_{\max}^{2}}{C}\right)(1-\delta)\right)\|\boldsymbol{\lambda}^{\star}-\hat{\boldsymbol{\lambda}}_{t+1}\|_{2}^{2}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr>
<tr id="A5.E68Xb" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.E68Xb.m2" class="ltx_Math" alttext="\displaystyle+\left(\eta_{\lambda}-|\mathcal{H}|R_{\max}^{2}\left(\frac{1}{2C_{1}}+\frac{1}{2C_{2}}\right)+\left(\eta_{\lambda}-\frac{|\mathcal{H}|R_{\max}^{2}}{C}\right)(1-\frac{1}{\delta})(1-\theta)\right)\|\hat{\boldsymbol{\lambda}}_{t+1}-\boldsymbol{\lambda}_{t}\|_{2}^{2}" display="inline" intent=":literal"><semantics><mrow><mo>+</mo><mrow><mrow><mo>(</mo><mrow><mrow><msub><mi>η</mi><mi>λ</mi></msub><mo>−</mo><mrow><mrow><mo stretchy="false">|</mo><mi class="ltx_font_mathcaligraphic">ℋ</mi><mo stretchy="false">|</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>R</mi><mi>max</mi><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>C</mi><mn>1</mn></msub></mrow></mfrac></mstyle><mo>+</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>C</mi><mn>2</mn></msub></mrow></mfrac></mstyle></mrow><mo>)</mo></mrow></mrow></mrow><mo>+</mo><mrow><mrow><mo>(</mo><mrow><msub><mi>η</mi><mi>λ</mi></msub><mo>−</mo><mstyle displaystyle="true"><mfrac><mrow><mrow><mo stretchy="false">|</mo><mi class="ltx_font_mathcaligraphic">ℋ</mi><mo stretchy="false">|</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>R</mi><mi>max</mi><mn>2</mn></msubsup></mrow><mi>C</mi></mfrac></mstyle></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>δ</mi></mfrac></mstyle></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>θ</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msubsup><mrow><mo stretchy="false">‖</mo><mrow><msub><mover accent="true"><mi>𝝀</mi><mo>^</mo></mover><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow></msub><mo>−</mo><msub><mi>𝝀</mi><mi>t</mi></msub></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn><mn>2</mn></msubsup></mrow></mrow><annotation encoding="application/x-tex">\displaystyle+\left(\eta_{\lambda}-|\mathcal{H}|R_{\max}^{2}\left(\frac{1}{2C_{1}}+\frac{1}{2C_{2}}\right)+\left(\eta_{\lambda}-\frac{|\mathcal{H}|R_{\max}^{2}}{C}\right)(1-\frac{1}{\delta})(1-\theta)\right)\|\hat{\boldsymbol{\lambda}}_{t+1}-\boldsymbol{\lambda}_{t}\|_{2}^{2}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr>
<tr id="A5.E68Xc" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.E68Xc.m2" class="ltx_Math" alttext="\displaystyle\leq\eta_{\theta}\mathbb{E}_{x\sim\mathcal{D}}\left[\mathrm{KL}(\pi^{\star}(\cdot|x)\|\hat{\pi}_{t}(\cdot|x))\right]+C_{2}\mathbb{E}_{x\sim\mathcal{D}}\left[\mathrm{KL}(\hat{\pi}_{t}(\cdot|x)\|\pi_{t-1}(\cdot|x))\right]" display="inline" intent=":literal"><semantics><mrow><mo>≤</mo><mi>η</mi><msub><mrow></mrow><mi>θ</mi></msub><mi>𝔼</mi><msub><mrow></mrow><mrow><mi>x</mi><mo>∼</mo><mi class="ltx_font_mathcaligraphic">𝒟</mi></mrow></msub><mo>[</mo><mi>KL</mi><mo stretchy="false">(</mo><mi>π</mi><msup><mrow></mrow><mo>⋆</mo></msup><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>x</mi><mo stretchy="false">)</mo><mo lspace="0em" rspace="0.167em">∥</mo><mover accent="true"><mi>π</mi><mo>^</mo></mover><msub><mrow></mrow><mi>t</mi></msub><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>x</mi><mo stretchy="false">)</mo><mo stretchy="false">)</mo><mo>]</mo><mo>+</mo><mi>C</mi><msub><mrow></mrow><mn>2</mn></msub><mi>𝔼</mi><msub><mrow></mrow><mrow><mi>x</mi><mo>∼</mo><mi class="ltx_font_mathcaligraphic">𝒟</mi></mrow></msub><mo>[</mo><mi>KL</mi><mo stretchy="false">(</mo><mover accent="true"><mi>π</mi><mo>^</mo></mover><msub><mrow></mrow><mi>t</mi></msub><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>x</mi><mo stretchy="false">)</mo><mo lspace="0em" rspace="0.167em">∥</mo><mi>π</mi><msub><mrow></mrow><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow></msub><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>x</mi><mo stretchy="false">)</mo><mo stretchy="false">)</mo><mo>]</mo></mrow><annotation encoding="application/x-tex">\displaystyle\leq\eta_{\theta}\mathbb{E}_{x\sim\mathcal{D}}\left[\mathrm{KL}(\pi^{\star}(\cdot|x)\|\hat{\pi}_{t}(\cdot|x))\right]+C_{2}\mathbb{E}_{x\sim\mathcal{D}}\left[\mathrm{KL}(\hat{\pi}_{t}(\cdot|x)\|\pi_{t-1}(\cdot|x))\right]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr>
<tr id="A5.E68Xd" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.E68Xd.m2" class="ltx_Math" alttext="\displaystyle+\left(\eta_{\lambda}-\left(\eta_{\lambda}-\frac{|\mathcal{H}|R_{\max}^{2}}{C}\right)(1-\frac{1}{\delta})(1-\frac{1}{\theta})\right)\|\boldsymbol{\lambda}^{\star}-\hat{\boldsymbol{\lambda}}_{t}\|_{2}^{2}" display="inline" intent=":literal"><semantics><mrow><mo>+</mo><mrow><mrow><mo>(</mo><mrow><msub><mi>η</mi><mi>λ</mi></msub><mo>−</mo><mrow><mrow><mo>(</mo><mrow><msub><mi>η</mi><mi>λ</mi></msub><mo>−</mo><mstyle displaystyle="true"><mfrac><mrow><mrow><mo stretchy="false">|</mo><mi class="ltx_font_mathcaligraphic">ℋ</mi><mo stretchy="false">|</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>R</mi><mi>max</mi><mn>2</mn></msubsup></mrow><mi>C</mi></mfrac></mstyle></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>δ</mi></mfrac></mstyle></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>θ</mi></mfrac></mstyle></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msubsup><mrow><mo stretchy="false">‖</mo><mrow><msup><mi>𝝀</mi><mo>⋆</mo></msup><mo>−</mo><msub><mover accent="true"><mi>𝝀</mi><mo>^</mo></mover><mi>t</mi></msub></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn><mn>2</mn></msubsup></mrow></mrow><annotation encoding="application/x-tex">\displaystyle+\left(\eta_{\lambda}-\left(\eta_{\lambda}-\frac{|\mathcal{H}|R_{\max}^{2}}{C}\right)(1-\frac{1}{\delta})(1-\frac{1}{\theta})\right)\|\boldsymbol{\lambda}^{\star}-\hat{\boldsymbol{\lambda}}_{t}\|_{2}^{2}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr>
<tr id="A5.E68Xe" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.E68Xe.m2" class="ltx_Math" alttext="\displaystyle+\frac{|\mathcal{H}|R_{\max}^{2}}{C}\|\hat{\boldsymbol{\lambda}}_{t}-\boldsymbol{\lambda}_{t-1}\|_{2}^{2}-\left(\eta_{\theta}-C_{1}\right)\mathbb{E}_{x\sim\mathcal{D}}\left[\mathrm{KL}(\pi_{t}(\cdot|x)\|\hat{\pi}_{t}(\cdot|x))\right]{+2\mathrm{gap}(\varepsilon_{\mathrm{approx}},p_{\min})}" display="inline" intent=":literal"><semantics><mrow><mo>+</mo><mstyle displaystyle="true"><mfrac><mrow><mrow><mo stretchy="false">|</mo><mi class="ltx_font_mathcaligraphic">ℋ</mi><mo stretchy="false">|</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>R</mi><mi>max</mi><mn>2</mn></msubsup></mrow><mi>C</mi></mfrac></mstyle><mo lspace="0em" rspace="0.167em">∥</mo><mover accent="true"><mi>𝝀</mi><mo>^</mo></mover><msub><mrow></mrow><mi>t</mi></msub><mo>−</mo><mi>𝝀</mi><msub><mrow></mrow><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow></msub><mo lspace="0em" rspace="0em">∥</mo><msub><mrow></mrow><mn>2</mn></msub><msup><mrow></mrow><mn>2</mn></msup><mo lspace="0em">−</mo><mo>(</mo><mi>η</mi><msub><mrow></mrow><mi>θ</mi></msub><mo>−</mo><mi>C</mi><msub><mrow></mrow><mn>1</mn></msub><mo>)</mo><mi>𝔼</mi><msub><mrow></mrow><mrow><mi>x</mi><mo>∼</mo><mi class="ltx_font_mathcaligraphic">𝒟</mi></mrow></msub><mo>[</mo><mi>KL</mi><mo stretchy="false">(</mo><mi>π</mi><msub><mrow></mrow><mi>t</mi></msub><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>x</mi><mo stretchy="false">)</mo><mo lspace="0em" rspace="0.167em">∥</mo><mover accent="true"><mi>π</mi><mo>^</mo></mover><msub><mrow></mrow><mi>t</mi></msub><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>x</mi><mo stretchy="false">)</mo><mo stretchy="false">)</mo><mo>]</mo><mo>+</mo><mn>2</mn><mi>gap</mi><mo stretchy="false">(</mo><mi>ε</mi><msub><mrow></mrow><mi>approx</mi></msub><mo>,</mo><mi>p</mi><msub><mrow></mrow><mi>min</mi></msub><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">\displaystyle+\frac{|\mathcal{H}|R_{\max}^{2}}{C}\|\hat{\boldsymbol{\lambda}}_{t}-\boldsymbol{\lambda}_{t-1}\|_{2}^{2}-\left(\eta_{\theta}-C_{1}\right)\mathbb{E}_{x\sim\mathcal{D}}\left[\mathrm{KL}(\pi_{t}(\cdot|x)\|\hat{\pi}_{t}(\cdot|x))\right]{+2\mathrm{gap}(\varepsilon_{\mathrm{approx}},p_{\min})}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A5.SS3.p1.9" class="ltx_p">Note the RHS of <a href="#A5.E68" title="In E.3 Combining A and B ‣ Appendix E Proof of ‣ Provable Last-Iterate Convergence for Multi-Objective Safe LLM Alignment via Optimistic Primal-Dual" class="ltx_ref"><span class="ltx_text ltx_ref_tag">eq.</span> <span class="ltx_text ltx_ref_tag">68</span></a> can be written as</p>
<table id="A5.Ex103" class="ltx_equationgroup ltx_eqn_table">

<tbody id="A5.Ex103X"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.Ex103X.m2" class="ltx_Math" alttext="\displaystyle\frac{\eta_{\theta}}{\eta_{\theta}+\beta}(\eta_{\theta}+\beta)\mathbb{E}_{x\sim\mathcal{D}}\left[\mathrm{KL}(\pi^{\star}(\cdot|x)\|\hat{\pi}_{t}(\cdot|x))\right]+\frac{C_{2}}{\eta_{\theta}+\beta-C}(\eta_{\theta}+\beta-C)\mathbb{E}_{x\sim\mathcal{D}}\left[\mathrm{KL}(\hat{\pi}_{t}(\cdot|x)\|\pi_{t-1}(\cdot|x))\right]" display="inline" intent=":literal"><semantics><mrow><mstyle displaystyle="true"><mfrac><msub><mi>η</mi><mi>θ</mi></msub><mrow><msub><mi>η</mi><mi>θ</mi></msub><mo>+</mo><mi>β</mi></mrow></mfrac></mstyle><mo stretchy="false">(</mo><mi>η</mi><msub><mrow></mrow><mi>θ</mi></msub><mo>+</mo><mi>β</mi><mo stretchy="false">)</mo><mi>𝔼</mi><msub><mrow></mrow><mrow><mi>x</mi><mo>∼</mo><mi class="ltx_font_mathcaligraphic">𝒟</mi></mrow></msub><mo>[</mo><mi>KL</mi><mo stretchy="false">(</mo><mi>π</mi><msup><mrow></mrow><mo>⋆</mo></msup><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>x</mi><mo stretchy="false">)</mo><mo lspace="0em" rspace="0.167em">∥</mo><mover accent="true"><mi>π</mi><mo>^</mo></mover><msub><mrow></mrow><mi>t</mi></msub><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>x</mi><mo stretchy="false">)</mo><mo stretchy="false">)</mo><mo>]</mo><mo>+</mo><mstyle displaystyle="true"><mfrac><msub><mi>C</mi><mn>2</mn></msub><mrow><mrow><msub><mi>η</mi><mi>θ</mi></msub><mo>+</mo><mi>β</mi></mrow><mo>−</mo><mi>C</mi></mrow></mfrac></mstyle><mo stretchy="false">(</mo><mi>η</mi><msub><mrow></mrow><mi>θ</mi></msub><mo>+</mo><mi>β</mi><mo>−</mo><mi>C</mi><mo stretchy="false">)</mo><mi>𝔼</mi><msub><mrow></mrow><mrow><mi>x</mi><mo>∼</mo><mi class="ltx_font_mathcaligraphic">𝒟</mi></mrow></msub><mo>[</mo><mi>KL</mi><mo stretchy="false">(</mo><mover accent="true"><mi>π</mi><mo>^</mo></mover><msub><mrow></mrow><mi>t</mi></msub><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>x</mi><mo stretchy="false">)</mo><mo lspace="0em" rspace="0.167em">∥</mo><mi>π</mi><msub><mrow></mrow><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow></msub><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>x</mi><mo stretchy="false">)</mo><mo stretchy="false">)</mo><mo>]</mo></mrow><annotation encoding="application/x-tex">\displaystyle\frac{\eta_{\theta}}{\eta_{\theta}+\beta}(\eta_{\theta}+\beta)\mathbb{E}_{x\sim\mathcal{D}}\left[\mathrm{KL}(\pi^{\star}(\cdot|x)\|\hat{\pi}_{t}(\cdot|x))\right]+\frac{C_{2}}{\eta_{\theta}+\beta-C}(\eta_{\theta}+\beta-C)\mathbb{E}_{x\sim\mathcal{D}}\left[\mathrm{KL}(\hat{\pi}_{t}(\cdot|x)\|\pi_{t-1}(\cdot|x))\right]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A5.Ex103Xa"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
