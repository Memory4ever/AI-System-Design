<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.E32Xd.m2" class="ltx_Math" alttext="\displaystyle+\langle\hat{\pi}_{t+1}(\cdot|x)-\pi_{t}(\cdot|x),S_{\boldsymbol{\lambda}_{t-1}}(x,\cdot)\rangle-\beta\left(\mathrm{KL}(\hat{\pi}_{t+1}(\cdot|x)\|\pi_{\mathrm{ref}}(\cdot|x))-\mathrm{KL}(\pi_{t}(\cdot|x)\|\pi_{\mathrm{ref}}(\cdot|x))\right)" display="inline" intent=":literal"><semantics><mrow><mo>+</mo><mo stretchy="false">⟨</mo><mover accent="true"><mi>π</mi><mo>^</mo></mover><msub><mrow></mrow><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow></msub><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>x</mi><mo stretchy="false">)</mo><mo>−</mo><mi>π</mi><msub><mrow></mrow><mi>t</mi></msub><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>x</mi><mo stretchy="false">)</mo><mo>,</mo><mi>S</mi><msub><mrow></mrow><msub><mi>𝝀</mi><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow></msub></msub><mo stretchy="false">(</mo><mi>x</mi><mo rspace="0em">,</mo><mo lspace="0em" rspace="0em">⋅</mo><mo stretchy="false">)</mo><mo stretchy="false">⟩</mo><mo>−</mo><mi>β</mi><mo>(</mo><mi>KL</mi><mo stretchy="false">(</mo><mover accent="true"><mi>π</mi><mo>^</mo></mover><msub><mrow></mrow><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow></msub><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>x</mi><mo stretchy="false">)</mo><mo lspace="0em" rspace="0.167em">∥</mo><mi>π</mi><msub><mrow></mrow><mi>ref</mi></msub><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>x</mi><mo stretchy="false">)</mo><mo stretchy="false">)</mo><mo>−</mo><mi>KL</mi><mo stretchy="false">(</mo><mi>π</mi><msub><mrow></mrow><mi>t</mi></msub><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>x</mi><mo stretchy="false">)</mo><mo lspace="0em" rspace="0.167em">∥</mo><mi>π</mi><msub><mrow></mrow><mi>ref</mi></msub><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>x</mi><mo stretchy="false">)</mo><mo stretchy="false">)</mo><mo>)</mo></mrow><annotation encoding="application/x-tex">\displaystyle+\langle\hat{\pi}_{t+1}(\cdot|x)-\pi_{t}(\cdot|x),S_{\boldsymbol{\lambda}_{t-1}}(x,\cdot)\rangle-\beta\left(\mathrm{KL}(\hat{\pi}_{t+1}(\cdot|x)\|\pi_{\mathrm{ref}}(\cdot|x))-\mathrm{KL}(\pi_{t}(\cdot|x)\|\pi_{\mathrm{ref}}(\cdot|x))\right)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr>
<tr id="A3.E32Xe" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.E32Xe.m2" class="ltx_Math" alttext="\displaystyle\left.+\langle\hat{\pi}_{t+1}(\cdot|x)-\pi_{t}(\cdot|x),S_{\boldsymbol{\lambda}_{t}}(x,\cdot)-S_{\boldsymbol{\lambda}_{t-1}}(x,\cdot)\rangle\right]" display="inline" intent=":literal"><semantics><mrow><mo>+</mo><mo stretchy="false">⟨</mo><mover accent="true"><mi>π</mi><mo>^</mo></mover><msub><mrow></mrow><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow></msub><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>x</mi><mo stretchy="false">)</mo><mo>−</mo><mi>π</mi><msub><mrow></mrow><mi>t</mi></msub><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>x</mi><mo stretchy="false">)</mo><mo>,</mo><mi>S</mi><msub><mrow></mrow><msub><mi>𝝀</mi><mi>t</mi></msub></msub><mo stretchy="false">(</mo><mi>x</mi><mo rspace="0em">,</mo><mo lspace="0em" rspace="0em">⋅</mo><mo stretchy="false">)</mo><mo>−</mo><mi>S</mi><msub><mrow></mrow><msub><mi>𝝀</mi><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow></msub></msub><mo stretchy="false">(</mo><mi>x</mi><mo rspace="0em">,</mo><mo lspace="0em" rspace="0em">⋅</mo><mo stretchy="false">)</mo><mo stretchy="false">⟩</mo><mo>]</mo></mrow><annotation encoding="application/x-tex">\displaystyle\left.+\langle\hat{\pi}_{t+1}(\cdot|x)-\pi_{t}(\cdot|x),S_{\boldsymbol{\lambda}_{t}}(x,\cdot)-S_{\boldsymbol{\lambda}_{t-1}}(x,\cdot)\rangle\right]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A3.SS1.p1.3" class="ltx_p">where <math id="A3.SS1.p1.m2" class="ltx_Math" alttext="(a)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi>a</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(a)</annotation></semantics></math> is because the action space is discrete and <math id="A3.SS1.p1.m3" class="ltx_math_unparsed" alttext="V^{\pi}_{S_{\boldsymbol{\lambda}_{t}}}(x)=\sum_{y}\pi(y|x){S_{\boldsymbol{\lambda}_{t}}}(x,y)=\langle\pi(\cdot|x),S_{\boldsymbol{\lambda}_{t}}(x,\cdot)\rangle" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>V</mi><msub><mi>S</mi><msub><mi>𝝀</mi><mi>t</mi></msub></msub><mi>π</mi></msubsup><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow><mo rspace="0.111em">=</mo><msub><mo>∑</mo><mi>y</mi></msub><mi>π</mi><mrow><mo stretchy="false">(</mo><mi>y</mi><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>x</mi><mo stretchy="false">)</mo></mrow><msub><mi>S</mi><msub><mi>𝝀</mi><mi>t</mi></msub></msub><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>y</mi><mo stretchy="false">)</mo></mrow><mo>=</mo><mrow><mo stretchy="false">⟨</mo><mi>π</mi><mrow><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>x</mi><mo stretchy="false">)</mo></mrow><mo>,</mo><msub><mi>S</mi><msub><mi>𝝀</mi><mi>t</mi></msub></msub><mrow><mo stretchy="false">(</mo><mi>x</mi><mo rspace="0em">,</mo><mo lspace="0em" rspace="0em">⋅</mo><mo stretchy="false">)</mo></mrow><mo stretchy="false">⟩</mo></mrow></mrow><annotation encoding="application/x-tex">V^{\pi}_{S_{\boldsymbol{\lambda}_{t}}}(x)=\sum_{y}\pi(y|x){S_{\boldsymbol{\lambda}_{t}}}(x,y)=\langle\pi(\cdot|x),S_{\boldsymbol{\lambda}_{t}}(x,\cdot)\rangle</annotation></semantics></math> for any <math id="A3.SS1.p1.m4" class="ltx_Math" alttext="\pi\in\Pi" display="inline" intent=":literal"><semantics><mrow><mi>π</mi><mo>∈</mo><mi mathvariant="normal">Π</mi></mrow><annotation encoding="application/x-tex">\pi\in\Pi</annotation></semantics></math>, and <math id="A3.SS1.p1.m5" class="ltx_Math" alttext="(b)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi>b</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(b)</annotation></semantics></math> is because adding and subtracting the same term keeps the equality.
Recall the <math id="A3.SS1.p1.m6" class="ltx_Math" alttext="\hat{\pi}_{t+1}" display="inline" intent=":literal"><semantics><msub><mover accent="true"><mi>π</mi><mo>^</mo></mover><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow></msub><annotation encoding="application/x-tex">\hat{\pi}_{t+1}</annotation></semantics></math> update shown in <a href="#S3.E6" title="In 4 ‣ Algorithm 2 ‣ 3.1 OPD in Distribution Space ‣ 3 Optimistic Primal–Dual Method ‣ Provable Last-Iterate Convergence for Multi-Objective Safe LLM Alignment via Optimistic Primal-Dual" class="ltx_ref"><span class="ltx_text ltx_ref_tag">eq.</span> <span class="ltx_text ltx_ref_tag">6</span></a> of the optimistic policy gradient primal-dual method,</p>
<table id="A3.Ex55" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A3.Ex55.m1" class="ltx_math_unparsed" alttext="\hat{\pi}_{t+1}=\arg\max_{\pi}\mathbb{E}_{x\sim\mathcal{D}}\left[\mathbb{E}_{y\sim\pi(\cdot|x)}\left[S_{\boldsymbol{\lambda}_{t}}(x,y)\right]-\beta\mathrm{KL}\left(\pi(\cdot|x)\|\pi_{\mathrm{ref}}(\cdot|x)\right)-\eta_{\theta}\mathrm{KL}\left(\pi(\cdot|x)\|\hat{\pi}_{t}(\cdot|x)\right)\right]," display="block" intent=":literal"><semantics><mrow><msub><mover accent="true"><mi>π</mi><mo>^</mo></mover><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow></msub><mo>=</mo><mi>arg</mi><munder><mi>max</mi><mi>π</mi></munder><msub><mi>𝔼</mi><mrow><mi>x</mi><mo>∼</mo><mi class="ltx_font_mathcaligraphic">𝒟</mi></mrow></msub><mrow><mo>[</mo><msub><mi>𝔼</mi><mrow><mi>y</mi><mo>∼</mo><mi>π</mi><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></msub><mrow><mo>[</mo><msub><mi>S</mi><msub><mi>𝝀</mi><mi>t</mi></msub></msub><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>y</mi><mo stretchy="false">)</mo></mrow><mo>]</mo></mrow><mo>−</mo><mi>β</mi><mi>KL</mi><mrow><mo>(</mo><mi>π</mi><mrow><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>x</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0.167em">∥</mo><msub><mi>π</mi><mi>ref</mi></msub><mrow><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>x</mi><mo stretchy="false">)</mo></mrow><mo>)</mo></mrow><mo>−</mo><msub><mi>η</mi><mi>θ</mi></msub><mi>KL</mi><mrow><mo>(</mo><mi>π</mi><mrow><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>x</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0.167em">∥</mo><msub><mover accent="true"><mi>π</mi><mo>^</mo></mover><mi>t</mi></msub><mrow><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>x</mi><mo stretchy="false">)</mo></mrow><mo>)</mo></mrow><mo>]</mo></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\hat{\pi}_{t+1}=\arg\max_{\pi}\mathbb{E}_{x\sim\mathcal{D}}\left[\mathbb{E}_{y\sim\pi(\cdot|x)}\left[S_{\boldsymbol{\lambda}_{t}}(x,y)\right]-\beta\mathrm{KL}\left(\pi(\cdot|x)\|\pi_{\mathrm{ref}}(\cdot|x)\right)-\eta_{\theta}\mathrm{KL}\left(\pi(\cdot|x)\|\hat{\pi}_{t}(\cdot|x)\right)\right],</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A3.SS1.p1.4" class="ltx_p">Since the optimality is independent for any <math id="A3.SS1.p1.m7" class="ltx_Math" alttext="x" display="inline" intent=":literal"><semantics><mi>x</mi><annotation encoding="application/x-tex">x</annotation></semantics></math>, we can write the
for fixed <math id="A3.SS1.p1.m8" class="ltx_Math" alttext="x" display="inline" intent=":literal"><semantics><mi>x</mi><annotation encoding="application/x-tex">x</annotation></semantics></math> as:</p>
<table id="A3.Ex56" class="ltx_equationgroup ltx_eqn_table">

<tbody id="A3.Ex56X"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.Ex56X.m2" class="ltx_Math" alttext="\displaystyle\hat{\pi}_{t+1}(\cdot|x)=" display="inline" intent=":literal"><semantics><mrow><mover accent="true"><mi>π</mi><mo>^</mo></mover><msub><mrow></mrow><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow></msub><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>x</mi><mo stretchy="false">)</mo><mo>=</mo></mrow><annotation encoding="application/x-tex">\displaystyle\hat{\pi}_{t+1}(\cdot|x)=</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex56X.m3" class="ltx_Math" alttext="\displaystyle\mathrm{argmax}_{\pi}\mathbb{E}_{y\sim\pi(\cdot|x)}\left[S_{\boldsymbol{\lambda}_{t}}(x,y)\right]-\beta\mathrm{KL}\left(\pi(\cdot|x)\|\pi_{\mathrm{ref}}(\cdot|x)\right)-\eta_{\theta}\mathrm{KL}\left(\pi(\cdot|x)\|\hat{\pi}_{t}(\cdot|x)\right)" display="inline" intent=":literal"><semantics><mrow><mi>argmax</mi><msub><mrow></mrow><mi>π</mi></msub><mi>𝔼</mi><msub><mrow></mrow><mrow><mi>y</mi><mo>∼</mo><mi>π</mi><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></msub><mo>[</mo><mi>S</mi><msub><mrow></mrow><msub><mi>𝝀</mi><mi>t</mi></msub></msub><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>y</mi><mo stretchy="false">)</mo><mo>]</mo><mo>−</mo><mi>β</mi><mi>KL</mi><mo>(</mo><mi>π</mi><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>x</mi><mo stretchy="false">)</mo><mo lspace="0em" rspace="0.167em">∥</mo><mi>π</mi><msub><mrow></mrow><mi>ref</mi></msub><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>x</mi><mo stretchy="false">)</mo><mo>)</mo><mo>−</mo><mi>η</mi><msub><mrow></mrow><mi>θ</mi></msub><mi>KL</mi><mo>(</mo><mi>π</mi><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>x</mi><mo stretchy="false">)</mo><mo lspace="0em" rspace="0.167em">∥</mo><mover accent="true"><mi>π</mi><mo>^</mo></mover><msub><mrow></mrow><mi>t</mi></msub><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>x</mi><mo stretchy="false">)</mo><mo>)</mo></mrow><annotation encoding="application/x-tex">\displaystyle\mathrm{argmax}_{\pi}\mathbb{E}_{y\sim\pi(\cdot|x)}\left[S_{\boldsymbol{\lambda}_{t}}(x,y)\right]-\beta\mathrm{KL}\left(\pi(\cdot|x)\|\pi_{\mathrm{ref}}(\cdot|x)\right)-\eta_{\theta}\mathrm{KL}\left(\pi(\cdot|x)\|\hat{\pi}_{t}(\cdot|x)\right)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A3.Ex56Xa"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.Ex56Xa.m2" class="ltx_Math" alttext="\displaystyle=" display="inline" intent=":literal"><semantics><mo>=</mo><annotation encoding="application/x-tex">\displaystyle=</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex56Xa.m3" class="ltx_Math" alttext="\displaystyle\mathrm{argmax}_{\pi}\langle\pi(\cdot|x),S_{\boldsymbol{\lambda}_{t}}(x,\cdot)\rangle-\beta\mathrm{KL}\left(\pi(\cdot|x)\|\pi_{\mathrm{ref}}(\cdot|x)\right)-\eta_{\theta}\mathrm{KL}\left(\pi(\cdot|x)\|\hat{\pi}_{t}(\cdot|x)\right)" display="inline" intent=":literal"><semantics><mrow><mi>argmax</mi><msub><mrow></mrow><mi>π</mi></msub><mo stretchy="false">⟨</mo><mi>π</mi><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>x</mi><mo stretchy="false">)</mo><mo>,</mo><mi>S</mi><msub><mrow></mrow><msub><mi>𝝀</mi><mi>t</mi></msub></msub><mo stretchy="false">(</mo><mi>x</mi><mo rspace="0em">,</mo><mo lspace="0em" rspace="0em">⋅</mo><mo stretchy="false">)</mo><mo stretchy="false">⟩</mo><mo>−</mo><mi>β</mi><mi>KL</mi><mo>(</mo><mi>π</mi><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>x</mi><mo stretchy="false">)</mo><mo lspace="0em" rspace="0.167em">∥</mo><mi>π</mi><msub><mrow></mrow><mi>ref</mi></msub><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>x</mi><mo stretchy="false">)</mo><mo>)</mo><mo>−</mo><mi>η</mi><msub><mrow></mrow><mi>θ</mi></msub><mi>KL</mi><mo>(</mo><mi>π</mi><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>x</mi><mo stretchy="false">)</mo><mo lspace="0em" rspace="0.167em">∥</mo><mover accent="true"><mi>π</mi><mo>^</mo></mover><msub><mrow></mrow><mi>t</mi></msub><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>x</mi><mo stretchy="false">)</mo><mo>)</mo></mrow><annotation encoding="application/x-tex">\displaystyle\mathrm{argmax}_{\pi}\langle\pi(\cdot|x),S_{\boldsymbol{\lambda}_{t}}(x,\cdot)\rangle-\beta\mathrm{KL}\left(\pi(\cdot|x)\|\pi_{\mathrm{ref}}(\cdot|x)\right)-\eta_{\theta}\mathrm{KL}\left(\pi(\cdot|x)\|\hat{\pi}_{t}(\cdot|x)\right)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="A3.SS1.p2" class="ltx_para">
<p id="A3.SS1.p2.5" class="ltx_p">Recall that we start with <math id="A3.SS1.p2.m1" class="ltx_Math" alttext="\pi_{0}" display="inline" intent=":literal"><semantics><msub><mi>π</mi><mn>0</mn></msub><annotation encoding="application/x-tex">\pi_{0}</annotation></semantics></math> which has the same support as <math id="A3.SS1.p2.m2" class="ltx_Math" alttext="\pi_{\mathrm{ref}}" display="inline" intent=":literal"><semantics><msub><mi>π</mi><mi>ref</mi></msub><annotation encoding="application/x-tex">\pi_{\mathrm{ref}}</annotation></semantics></math>, which has the full support by <a href="#S3.Thmtheorem3" title="Assumption 3.3 (Full support of the reference policy). ‣ 3.1 OPD in Distribution Space ‣ 3 Optimistic Primal–Dual Method ‣ Provable Last-Iterate Convergence for Multi-Objective Safe LLM Alignment via Optimistic Primal-Dual" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Assumption</span> <span class="ltx_text ltx_ref_tag">3.3</span></a>.
We also set <math id="A3.SS1.p2.m3" class="ltx_Math" alttext="\hat{\pi}_{0}=\pi_{\mathrm{ref}}" display="inline" intent=":literal"><semantics><mrow><msub><mover accent="true"><mi>π</mi><mo>^</mo></mover><mn>0</mn></msub><mo>=</mo><msub><mi>π</mi><mi>ref</mi></msub></mrow><annotation encoding="application/x-tex">\hat{\pi}_{0}=\pi_{\mathrm{ref}}</annotation></semantics></math>
Given the optimistic policy gradient shown in <a href="#S3.E4" title="In 2 ‣ Algorithm 2 ‣ 3.1 OPD in Distribution Space ‣ 3 Optimistic Primal–Dual Method ‣ Provable Last-Iterate Convergence for Multi-Objective Safe LLM Alignment via Optimistic Primal-Dual" class="ltx_ref"><span class="ltx_text ltx_ref_tag">eqs.</span> <span class="ltx_text ltx_ref_tag">4</span></a> and <a href="#S3.E6" title="Equation 6In Algorithm 2 ‣ 3.1 OPD in Distribution Space ‣ 3 Optimistic Primal–Dual Method ‣ Provable Last-Iterate Convergence for Multi-Objective Safe LLM Alignment via Optimistic Primal-Dual" class="ltx_ref"><span class="ltx_text ltx_ref_tag">6</span></a>, <math id="A3.SS1.p2.m4" class="ltx_Math" alttext="\pi_{t}(y|x)\propto\hat{\pi}_{t}(y|x)^{\frac{\eta}{\eta+\beta}}{\pi}_{\mathrm{ref}}(y|x)^{\frac{\beta}{\eta+\beta}}\exp(S_{\lambda_{t-1}}(x,y))" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>π</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>y</mi><mo lspace="0em" rspace="0em">|</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo>∝</mo><mrow><msub><mover accent="true"><mi>π</mi><mo>^</mo></mover><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>y</mi><mo lspace="0em" rspace="0em">|</mo><mi>x</mi><mo stretchy="false">)</mo></mrow><mfrac><mi>η</mi><mrow><mi>η</mi><mo>+</mo><mi>β</mi></mrow></mfrac></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>π</mi><mi>ref</mi></msub><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>y</mi><mo lspace="0em" rspace="0em">|</mo><mi>x</mi><mo stretchy="false">)</mo></mrow><mfrac><mi>β</mi><mrow><mi>η</mi><mo>+</mo><mi>β</mi></mrow></mfrac></msup><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>S</mi><msub><mi>λ</mi><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>y</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\pi_{t}(y|x)\propto\hat{\pi}_{t}(y|x)^{\frac{\eta}{\eta+\beta}}{\pi}_{\mathrm{ref}}(y|x)^{\frac{\beta}{\eta+\beta}}\exp(S_{\lambda_{t-1}}(x,y))</annotation></semantics></math> for any <math id="A3.SS1.p2.m5" class="ltx_Math" alttext="t" display="inline" intent=":literal"><semantics><mi>t</mi><annotation encoding="application/x-tex">t</annotation></semantics></math>, <math id="A3.SS1.p2.m6" class="ltx_Math" alttext="\pi_{t}" display="inline" intent=":literal"><semantics><msub><mi>π</mi><mi>t</mi></msub><annotation encoding="application/x-tex">\pi_{t}</annotation></semantics></math> and <math id="A3.SS1.p2.m7" class="ltx_Math" alttext="\hat{\pi}_{t}\propto\hat{\pi}_{t}(y|x)^{\frac{\eta}{\eta+\beta}}{\pi}_{\mathrm{ref}}(y|x)^{\frac{\beta}{\eta+\beta}}\exp(S_{\lambda_{t}}(x,y))" display="inline" intent=":literal"><semantics><mrow><msub><mover accent="true"><mi>π</mi><mo>^</mo></mover><mi>t</mi></msub><mo>∝</mo><mrow><msub><mover accent="true"><mi>π</mi><mo>^</mo></mover><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>y</mi><mo lspace="0em" rspace="0em">|</mo><mi>x</mi><mo stretchy="false">)</mo></mrow><mfrac><mi>η</mi><mrow><mi>η</mi><mo>+</mo><mi>β</mi></mrow></mfrac></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>π</mi><mi>ref</mi></msub><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>y</mi><mo lspace="0em" rspace="0em">|</mo><mi>x</mi><mo stretchy="false">)</mo></mrow><mfrac><mi>β</mi><mrow><mi>η</mi><mo>+</mo><mi>β</mi></mrow></mfrac></msup><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>S</mi><msub><mi>λ</mi><mi>t</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>y</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\hat{\pi}_{t}\propto\hat{\pi}_{t}(y|x)^{\frac{\eta}{\eta+\beta}}{\pi}_{\mathrm{ref}}(y|x)^{\frac{\beta}{\eta+\beta}}\exp(S_{\lambda_{t}}(x,y))</annotation></semantics></math> for any <math id="A3.SS1.p2.m8" class="ltx_Math" alttext="t" display="inline" intent=":literal"><semantics><mi>t</mi><annotation encoding="application/x-tex">t</annotation></semantics></math>. By iteration, we have <math id="A3.SS1.p2.m9" class="ltx_Math" alttext="\hat{\pi}_{t}" display="inline" intent=":literal"><semantics><msub><mover accent="true"><mi>π</mi><mo>^</mo></mover><mi>t</mi></msub><annotation encoding="application/x-tex">\hat{\pi}_{t}</annotation></semantics></math> and <math id="A3.SS1.p2.m10" class="ltx_Math" alttext="\pi_{t}" display="inline" intent=":literal"><semantics><msub><mi>π</mi><mi>t</mi></msub><annotation encoding="application/x-tex">\pi_{t}</annotation></semantics></math> have the same support as <math id="A3.SS1.p2.m11" class="ltx_Math" alttext="\pi_{\mathrm{ref}}" display="inline" intent=":literal"><semantics><msub><mi>π</mi><mi>ref</mi></msub><annotation encoding="application/x-tex">\pi_{\mathrm{ref}}</annotation></semantics></math> for any <math id="A3.SS1.p2.m12" class="ltx_Math" alttext="t" display="inline" intent=":literal"><semantics><mi>t</mi><annotation encoding="application/x-tex">t</annotation></semantics></math>.
Therefore, <math id="A3.SS1.p2.m13" class="ltx_Math" alttext="\mathrm{supp}(\pi_{t})\cap\mathrm{supp}(\pi_{\mathrm{ref}})=\mathrm{supp}(\hat{\pi}_{t})\cap\mathrm{supp}(\pi_{\mathrm{ref}})=\mathrm{supp}(\pi_{\mathrm{ref}})" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mi>supp</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>π</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>∩</mo><mrow><mi>supp</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>π</mi><mi>ref</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>=</mo><mrow><mrow><mi>supp</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi>π</mi><mo>^</mo></mover><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>∩</mo><mrow><mi>supp</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>π</mi><mi>ref</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>=</mo><mrow><mi>supp</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>π</mi><mi>ref</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\mathrm{supp}(\pi_{t})\cap\mathrm{supp}(\pi_{\mathrm{ref}})=\mathrm{supp}(\hat{\pi}_{t})\cap\mathrm{supp}(\pi_{\mathrm{ref}})=\mathrm{supp}(\pi_{\mathrm{ref}})</annotation></semantics></math>.
Since <math id="A3.SS1.p2.m14" class="ltx_Math" alttext="\pi_{\mathrm{ref}}" display="inline" intent=":literal"><semantics><msub><mi>π</mi><mi>ref</mi></msub><annotation encoding="application/x-tex">\pi_{\mathrm{ref}}</annotation></semantics></math> spans the action space by <a href="#S3.Thmtheorem3" title="Assumption 3.3 (Full support of the reference policy). ‣ 3.1 OPD in Distribution Space ‣ 3 Optimistic Primal–Dual Method ‣ Provable Last-Iterate Convergence for Multi-Objective Safe LLM Alignment via Optimistic Primal-Dual" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Assumption</span> <span class="ltx_text ltx_ref_tag">3.3</span></a>, <math id="A3.SS1.p2.m15" class="ltx_Math" alttext="\pi^{\star}" display="inline" intent=":literal"><semantics><msup><mi>π</mi><mo>⋆</mo></msup><annotation encoding="application/x-tex">\pi^{\star}</annotation></semantics></math> is covered by <math id="A3.SS1.p2.m16" class="ltx_Math" alttext="\pi_{\mathrm{ref}}" display="inline" intent=":literal"><semantics><msub><mi>π</mi><mi>ref</mi></msub><annotation encoding="application/x-tex">\pi_{\mathrm{ref}}</annotation></semantics></math>.
Therefore <math id="A3.SS1.p2.m17" class="ltx_Math" alttext="\mathrm{supp}\left(\pi^{\star}\right)\subseteq\mathrm{supp}\left(\pi_{t}\right)\cap\mathrm{supp}\left(\pi_{\mathrm{ref}}\right)" display="inline" intent=":literal"><semantics><mrow><mrow><mi>supp</mi><mo>⁡</mo><mrow><mo>(</mo><msup><mi>π</mi><mo>⋆</mo></msup><mo>)</mo></mrow></mrow><mo>⊆</mo><mrow><mrow><mi>supp</mi><mo>⁡</mo><mrow><mo>(</mo><msub><mi>π</mi><mi>t</mi></msub><mo>)</mo></mrow></mrow><mo>∩</mo><mrow><mi>supp</mi><mo>⁡</mo><mrow><mo>(</mo><msub><mi>π</mi><mi>ref</mi></msub><mo>)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\mathrm{supp}\left(\pi^{\star}\right)\subseteq\mathrm{supp}\left(\pi_{t}\right)\cap\mathrm{supp}\left(\pi_{\mathrm{ref}}\right)</annotation></semantics></math>.
Using <a href="#A2.Thmtheorem10" title="Lemma B.10 (Three-point inequality with KL regularization). ‣ Appendix B Useful Lemmas ‣ Provable Last-Iterate Convergence for Multi-Objective Safe LLM Alignment via Optimistic Primal-Dual" class="ltx_ref"><span class="ltx_text ltx_ref_tag">lemma</span> <span class="ltx_text ltx_ref_tag">B.10</span></a> and letting <math id="A3.SS1.p2.m18" class="ltx_Math" alttext="\eta=\eta_{\theta}" display="inline" intent=":literal"><semantics><mrow><mi>η</mi><mo>=</mo><msub><mi>η</mi><mi>θ</mi></msub></mrow><annotation encoding="application/x-tex">\eta=\eta_{\theta}</annotation></semantics></math>, <math id="A3.SS1.p2.m19" class="ltx_Math" alttext="g=S_{\boldsymbol{\lambda}_{t}}(x,\cdot)" display="inline" intent=":literal"><semantics><mrow><mi>g</mi><mo>=</mo><mrow><msub><mi>S</mi><msub><mi>𝝀</mi><mi>t</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo rspace="0em">,</mo><mo lspace="0em" rspace="0em">⋅</mo><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">g=S_{\boldsymbol{\lambda}_{t}}(x,\cdot)</annotation></semantics></math>, <math id="A3.SS1.p2.m20" class="ltx_math_unparsed" alttext="\pi_{\mathrm{old}}=\hat{\pi}_{t}(\cdot|x)" display="inline" intent=":literal"><semantics><mrow><msub><mi>π</mi><mi>old</mi></msub><mo>=</mo><msub><mover accent="true"><mi>π</mi><mo>^</mo></mover><mi>t</mi></msub><mrow><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\pi_{\mathrm{old}}=\hat{\pi}_{t}(\cdot|x)</annotation></semantics></math>, <math id="A3.SS1.p2.m21" class="ltx_math_unparsed" alttext="\pi_{\mathrm{new}}=\hat{\pi}_{t+1}(\cdot|x)" display="inline" intent=":literal"><semantics><mrow><msub><mi>π</mi><mi>new</mi></msub><mo>=</mo><msub><mover accent="true"><mi>π</mi><mo>^</mo></mover><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow></msub><mrow><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\pi_{\mathrm{new}}=\hat{\pi}_{t+1}(\cdot|x)</annotation></semantics></math>, and <math id="A3.SS1.p2.m22" class="ltx_math_unparsed" alttext="\pi^{\prime}=\pi^{\star}(\cdot|x)" display="inline" intent=":literal"><semantics><mrow><msup><mi>π</mi><mo>′</mo></msup><mo>=</mo><msup><mi>π</mi><mo>⋆</mo></msup><mrow><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\pi^{\prime}=\pi^{\star}(\cdot|x)</annotation></semantics></math>, we have</p>
<table id="A3.Ex57" class="ltx_equationgroup ltx_eqn_table">

<tbody id="A3.Ex57X"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex57X.m2" class="ltx_Math" alttext="\displaystyle\langle S_{\boldsymbol{\lambda}_{t}}(x,\cdot),\hat{\pi}_{t+1}(\cdot|x)-\pi^{\star}(\cdot|x)\rangle-\beta\left(\mathrm{KL}(\hat{\pi}_{t+1}(\cdot|x)\|\pi_{\mathrm{ref}}(\cdot|x))-\mathrm{KL}(\pi^{\star}(\cdot|x)\|\pi_{\mathrm{ref}}(\cdot|x))\right)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">⟨</mo><mi>S</mi><msub><mrow></mrow><msub><mi>𝝀</mi><mi>t</mi></msub></msub><mo stretchy="false">(</mo><mi>x</mi><mo rspace="0em">,</mo><mo lspace="0em" rspace="0em">⋅</mo><mo stretchy="false">)</mo><mo>,</mo><mover accent="true"><mi>π</mi><mo>^</mo></mover><msub><mrow></mrow><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow></msub><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>x</mi><mo stretchy="false">)</mo><mo>−</mo><mi>π</mi><msup><mrow></mrow><mo>⋆</mo></msup><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>x</mi><mo stretchy="false">)</mo><mo stretchy="false">⟩</mo><mo>−</mo><mi>β</mi><mo>(</mo><mi>KL</mi><mo stretchy="false">(</mo><mover accent="true"><mi>π</mi><mo>^</mo></mover><msub><mrow></mrow><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow></msub><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>x</mi><mo stretchy="false">)</mo><mo lspace="0em" rspace="0.167em">∥</mo><mi>π</mi><msub><mrow></mrow><mi>ref</mi></msub><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>x</mi><mo stretchy="false">)</mo><mo stretchy="false">)</mo><mo>−</mo><mi>KL</mi><mo stretchy="false">(</mo><mi>π</mi><msup><mrow></mrow><mo>⋆</mo></msup><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>x</mi><mo stretchy="false">)</mo><mo lspace="0em" rspace="0.167em">∥</mo><mi>π</mi><msub><mrow></mrow><mi>ref</mi></msub><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>x</mi><mo stretchy="false">)</mo><mo stretchy="false">)</mo><mo>)</mo></mrow><annotation encoding="application/x-tex">\displaystyle\langle S_{\boldsymbol{\lambda}_{t}}(x,\cdot),\hat{\pi}_{t+1}(\cdot|x)-\pi^{\star}(\cdot|x)\rangle-\beta\left(\mathrm{KL}(\hat{\pi}_{t+1}(\cdot|x)\|\pi_{\mathrm{ref}}(\cdot|x))-\mathrm{KL}(\pi^{\star}(\cdot|x)\|\pi_{\mathrm{ref}}(\cdot|x))\right)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A3.Ex57Xa"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex57Xa.m2" class="ltx_Math" alttext="\displaystyle\geq\eta_{\theta}\left(-\mathrm{KL}(\pi^{\star}(\cdot|x)\|\hat{\pi}_{t}(\cdot|x))+\mathrm{KL}(\pi^{\star}(\cdot|x)\|\hat{\pi}_{t+1}(\cdot|x))+\mathrm{KL}(\hat{\pi}_{t+1}(\cdot|x)\|\hat{\pi}_{t}(\cdot|x))\right)+\beta\mathrm{KL}(\pi^{\star}(\cdot|x)\|\hat{\pi}_{t+1}(\cdot|x))." display="inline" intent=":literal"><semantics><mrow><mo>≥</mo><mi>η</mi><msub><mrow></mrow><mi>θ</mi></msub><mo>(</mo><mo lspace="0em">−</mo><mi>KL</mi><mo stretchy="false">(</mo><mi>π</mi><msup><mrow></mrow><mo>⋆</mo></msup><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>x</mi><mo stretchy="false">)</mo><mo lspace="0em" rspace="0.167em">∥</mo><mover accent="true"><mi>π</mi><mo>^</mo></mover><msub><mrow></mrow><mi>t</mi></msub><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>x</mi><mo stretchy="false">)</mo><mo stretchy="false">)</mo><mo>+</mo><mi>KL</mi><mo stretchy="false">(</mo><mi>π</mi><msup><mrow></mrow><mo>⋆</mo></msup><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>x</mi><mo stretchy="false">)</mo><mo lspace="0em" rspace="0.167em">∥</mo><mover accent="true"><mi>π</mi><mo>^</mo></mover><msub><mrow></mrow><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow></msub><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>x</mi><mo stretchy="false">)</mo><mo stretchy="false">)</mo><mo>+</mo><mi>KL</mi><mo stretchy="false">(</mo><mover accent="true"><mi>π</mi><mo>^</mo></mover><msub><mrow></mrow><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow></msub><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>x</mi><mo stretchy="false">)</mo><mo lspace="0em" rspace="0.167em">∥</mo><mover accent="true"><mi>π</mi><mo>^</mo></mover><msub><mrow></mrow><mi>t</mi></msub><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>x</mi><mo stretchy="false">)</mo><mo stretchy="false">)</mo><mo>)</mo><mo>+</mo><mi>β</mi><mi>KL</mi><mo stretchy="false">(</mo><mi>π</mi><msup><mrow></mrow><mo>⋆</mo></msup><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>x</mi><mo stretchy="false">)</mo><mo lspace="0em" rspace="0.167em">∥</mo><mover accent="true"><mi>π</mi><mo>^</mo></mover><msub><mrow></mrow><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow></msub><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>x</mi><mo stretchy="false">)</mo><mo stretchy="false">)</mo><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\geq\eta_{\theta}\left(-\mathrm{KL}(\pi^{\star}(\cdot|x)\|\hat{\pi}_{t}(\cdot|x))+\mathrm{KL}(\pi^{\star}(\cdot|x)\|\hat{\pi}_{t+1}(\cdot|x))+\mathrm{KL}(\hat{\pi}_{t+1}(\cdot|x)\|\hat{\pi}_{t}(\cdot|x))\right)+\beta\mathrm{KL}(\pi^{\star}(\cdot|x)\|\hat{\pi}_{t+1}(\cdot|x)).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A3.SS1.p2.6" class="ltx_p">Putting a negative sign on both sides, we have</p>
<table id="A3.E33" class="ltx_equationgroup ltx_eqn_table">
<tbody>
<tr id="A3.E33X" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.E33X.m2" class="ltx_Math" alttext="\displaystyle\langle\pi^{\star}(\cdot|x)-\hat{\pi}_{t+1}(\cdot|x),S_{\boldsymbol{\lambda}_{t}}(x,\cdot)\rangle-\beta\left(\mathrm{KL}(\pi^{\star}(\cdot|x)\|\pi_{\mathrm{ref}}(\cdot|x))-\mathrm{KL}(\hat{\pi}_{t+1}(\cdot|x)\|\pi_{\mathrm{ref}}(\cdot|x))\right)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">⟨</mo><mi>π</mi><msup><mrow></mrow><mo>⋆</mo></msup><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>x</mi><mo stretchy="false">)</mo><mo>−</mo><mover accent="true"><mi>π</mi><mo>^</mo></mover><msub><mrow></mrow><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow></msub><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>x</mi><mo stretchy="false">)</mo><mo>,</mo><mi>S</mi><msub><mrow></mrow><msub><mi>𝝀</mi><mi>t</mi></msub></msub><mo stretchy="false">(</mo><mi>x</mi><mo rspace="0em">,</mo><mo lspace="0em" rspace="0em">⋅</mo><mo stretchy="false">)</mo><mo stretchy="false">⟩</mo><mo>−</mo><mi>β</mi><mo>(</mo><mi>KL</mi><mo stretchy="false">(</mo><mi>π</mi><msup><mrow></mrow><mo>⋆</mo></msup><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>x</mi><mo stretchy="false">)</mo><mo lspace="0em" rspace="0.167em">∥</mo><mi>π</mi><msub><mrow></mrow><mi>ref</mi></msub><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>x</mi><mo stretchy="false">)</mo><mo stretchy="false">)</mo><mo>−</mo><mi>KL</mi><mo stretchy="false">(</mo><mover accent="true"><mi>π</mi><mo>^</mo></mover><msub><mrow></mrow><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow></msub><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>x</mi><mo stretchy="false">)</mo><mo lspace="0em" rspace="0.167em">∥</mo><mi>π</mi><msub><mrow></mrow><mi>ref</mi></msub><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>x</mi><mo stretchy="false">)</mo><mo stretchy="false">)</mo><mo>)</mo></mrow><annotation encoding="application/x-tex">\displaystyle\langle\pi^{\star}(\cdot|x)-\hat{\pi}_{t+1}(\cdot|x),S_{\boldsymbol{\lambda}_{t}}(x,\cdot)\rangle-\beta\left(\mathrm{KL}(\pi^{\star}(\cdot|x)\|\pi_{\mathrm{ref}}(\cdot|x))-\mathrm{KL}(\hat{\pi}_{t+1}(\cdot|x)\|\pi_{\mathrm{ref}}(\cdot|x))\right)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="3" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equationgroup ltx_align_right">(33)</span></td></tr>
<tr id="A3.E33Xa" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.E33Xa.m2" class="ltx_Math" alttext="\displaystyle\leq\eta_{\theta}\left(\mathrm{KL}(\pi^{\star}(\cdot|x)\|\hat{\pi}_{t}(\cdot|x))-\mathrm{KL}(\pi^{\star}(\cdot|x)\|\hat{\pi}_{t+1}(\cdot|x))-\mathrm{KL}(\hat{\pi}_{t+1}(\cdot|x)\|\hat{\pi}_{t}(\cdot|x))\right)-\beta\mathrm{KL}(\pi^{\star}(\cdot|x)\|\hat{\pi}_{t+1}(\cdot|x))" display="inline" intent=":literal"><semantics><mrow><mo>≤</mo><mi>η</mi><msub><mrow></mrow><mi>θ</mi></msub><mo>(</mo><mi>KL</mi><mo stretchy="false">(</mo><mi>π</mi><msup><mrow></mrow><mo>⋆</mo></msup><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>x</mi><mo stretchy="false">)</mo><mo lspace="0em" rspace="0.167em">∥</mo><mover accent="true"><mi>π</mi><mo>^</mo></mover><msub><mrow></mrow><mi>t</mi></msub><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>x</mi><mo stretchy="false">)</mo><mo stretchy="false">)</mo><mo>−</mo><mi>KL</mi><mo stretchy="false">(</mo><mi>π</mi><msup><mrow></mrow><mo>⋆</mo></msup><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>x</mi><mo stretchy="false">)</mo><mo lspace="0em" rspace="0.167em">∥</mo><mover accent="true"><mi>π</mi><mo>^</mo></mover><msub><mrow></mrow><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow></msub><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>x</mi><mo stretchy="false">)</mo><mo stretchy="false">)</mo><mo>−</mo><mi>KL</mi><mo stretchy="false">(</mo><mover accent="true"><mi>π</mi><mo>^</mo></mover><msub><mrow></mrow><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow></msub><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>x</mi><mo stretchy="false">)</mo><mo lspace="0em" rspace="0.167em">∥</mo><mover accent="true"><mi>π</mi><mo>^</mo></mover><msub><mrow></mrow><mi>t</mi></msub><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>x</mi><mo stretchy="false">)</mo><mo stretchy="false">)</mo><mo>)</mo><mo>−</mo><mi>β</mi><mi>KL</mi><mo stretchy="false">(</mo><mi>π</mi><msup><mrow></mrow><mo>⋆</mo></msup><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>x</mi><mo stretchy="false">)</mo><mo lspace="0em" rspace="0.167em">∥</mo><mover accent="true"><mi>π</mi><mo>^</mo></mover><msub><mrow></mrow><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow></msub><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>x</mi><mo stretchy="false">)</mo><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">\displaystyle\leq\eta_{\theta}\left(\mathrm{KL}(\pi^{\star}(\cdot|x)\|\hat{\pi}_{t}(\cdot|x))-\mathrm{KL}(\pi^{\star}(\cdot|x)\|\hat{\pi}_{t+1}(\cdot|x))-\mathrm{KL}(\hat{\pi}_{t+1}(\cdot|x)\|\hat{\pi}_{t}(\cdot|x))\right)-\beta\mathrm{KL}(\pi^{\star}(\cdot|x)\|\hat{\pi}_{t+1}(\cdot|x))</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr>
<tr id="A3.E33Xb" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.E33Xb.m2" class="ltx_Math" alttext="\displaystyle=\eta_{\theta}\mathrm{KL}(\pi^{\star}(\cdot|x)\|\hat{\pi}_{t}(\cdot|x))-(\eta_{\theta}+\beta)\mathrm{KL}(\pi^{\star}(\cdot|x)\|\hat{\pi}_{t+1}(\cdot|x))-\eta_{\theta}\mathrm{KL}(\hat{\pi}_{t+1}(\cdot|x)\|\hat{\pi}_{t}(\cdot|x))" display="inline" intent=":literal"><semantics><mrow><mo>=</mo><mi>η</mi><msub><mrow></mrow><mi>θ</mi></msub><mi>KL</mi><mo stretchy="false">(</mo><mi>π</mi><msup><mrow></mrow><mo>⋆</mo></msup><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>x</mi><mo stretchy="false">)</mo><mo lspace="0em" rspace="0.167em">∥</mo><mover accent="true"><mi>π</mi><mo>^</mo></mover><msub><mrow></mrow><mi>t</mi></msub><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>x</mi><mo stretchy="false">)</mo><mo stretchy="false">)</mo><mo>−</mo><mo stretchy="false">(</mo><mi>η</mi><msub><mrow></mrow><mi>θ</mi></msub><mo>+</mo><mi>β</mi><mo stretchy="false">)</mo><mi>KL</mi><mo stretchy="false">(</mo><mi>π</mi><msup><mrow></mrow><mo>⋆</mo></msup><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>x</mi><mo stretchy="false">)</mo><mo lspace="0em" rspace="0.167em">∥</mo><mover accent="true"><mi>π</mi><mo>^</mo></mover><msub><mrow></mrow><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow></msub><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>x</mi><mo stretchy="false">)</mo><mo stretchy="false">)</mo><mo>−</mo><mi>η</mi><msub><mrow></mrow><mi>θ</mi></msub><mi>KL</mi><mo stretchy="false">(</mo><mover accent="true"><mi>π</mi><mo>^</mo></mover><msub><mrow></mrow><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow></msub><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>x</mi><mo stretchy="false">)</mo><mo lspace="0em" rspace="0.167em">∥</mo><mover accent="true"><mi>π</mi><mo>^</mo></mover><msub><mrow></mrow><mi>t</mi></msub><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>x</mi><mo stretchy="false">)</mo><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">\displaystyle=\eta_{\theta}\mathrm{KL}(\pi^{\star}(\cdot|x)\|\hat{\pi}_{t}(\cdot|x))-(\eta_{\theta}+\beta)\mathrm{KL}(\pi^{\star}(\cdot|x)\|\hat{\pi}_{t+1}(\cdot|x))-\eta_{\theta}\mathrm{KL}(\hat{\pi}_{t+1}(\cdot|x)\|\hat{\pi}_{t}(\cdot|x))</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A3.SS1.p2.7" class="ltx_p">Similarly, the update of <math id="A3.SS1.p2.m23" class="ltx_Math" alttext="\pi_{t}" display="inline" intent=":literal"><semantics><msub><mi>π</mi><mi>t</mi></msub><annotation encoding="application/x-tex">\pi_{t}</annotation></semantics></math> in the optimistic update is</p>
<table id="A3.Ex58" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A3.Ex58.m1" class="ltx_math_unparsed" alttext="\pi_{t}=\arg\max_{\pi}\mathbb{E}_{x\sim\mathcal{D}}\left[\mathbb{E}_{y\sim\pi(\cdot|x)}\left[S_{\boldsymbol{\lambda}_{t-1}}(x,y)\right]-\beta\mathrm{KL}\left(\pi(\cdot|x)\|\pi_{\mathrm{ref}}(\cdot|x)\right)-\eta_{\theta}\mathrm{KL}\left(\pi(\cdot|x)\|\hat{\pi}_{t}(\cdot|x)\right)\right]" display="block" intent=":literal"><semantics><mrow><msub><mi>π</mi><mi>t</mi></msub><mo>=</mo><mi>arg</mi><munder><mi>max</mi><mi>π</mi></munder><msub><mi>𝔼</mi><mrow><mi>x</mi><mo>∼</mo><mi class="ltx_font_mathcaligraphic">𝒟</mi></mrow></msub><mrow><mo>[</mo><msub><mi>𝔼</mi><mrow><mi>y</mi><mo>∼</mo><mi>π</mi><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></msub><mrow><mo>[</mo><msub><mi>S</mi><msub><mi>𝝀</mi><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow></msub></msub><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>y</mi><mo stretchy="false">)</mo></mrow><mo>]</mo></mrow><mo>−</mo><mi>β</mi><mi>KL</mi><mrow><mo>(</mo><mi>π</mi><mrow><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>x</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0.167em">∥</mo><msub><mi>π</mi><mi>ref</mi></msub><mrow><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>x</mi><mo stretchy="false">)</mo></mrow><mo>)</mo></mrow><mo>−</mo><msub><mi>η</mi><mi>θ</mi></msub><mi>KL</mi><mrow><mo>(</mo><mi>π</mi><mrow><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>x</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0.167em">∥</mo><msub><mover accent="true"><mi>π</mi><mo>^</mo></mover><mi>t</mi></msub><mrow><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>x</mi><mo stretchy="false">)</mo></mrow><mo>)</mo></mrow><mo>]</mo></mrow></mrow><annotation encoding="application/x-tex">\pi_{t}=\arg\max_{\pi}\mathbb{E}_{x\sim\mathcal{D}}\left[\mathbb{E}_{y\sim\pi(\cdot|x)}\left[S_{\boldsymbol{\lambda}_{t-1}}(x,y)\right]-\beta\mathrm{KL}\left(\pi(\cdot|x)\|\pi_{\mathrm{ref}}(\cdot|x)\right)-\eta_{\theta}\mathrm{KL}\left(\pi(\cdot|x)\|\hat{\pi}_{t}(\cdot|x)\right)\right]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A3.SS1.p2.8" class="ltx_p">let <math id="A3.SS1.p2.m24" class="ltx_Math" alttext="\eta=\eta_{\theta}" display="inline" intent=":literal"><semantics><mrow><mi>η</mi><mo>=</mo><msub><mi>η</mi><mi>θ</mi></msub></mrow><annotation encoding="application/x-tex">\eta=\eta_{\theta}</annotation></semantics></math>, <math id="A3.SS1.p2.m25" class="ltx_Math" alttext="g=S_{\boldsymbol{\lambda}_{t-1}}(x,\cdot)" display="inline" intent=":literal"><semantics><mrow><mi>g</mi><mo>=</mo><mrow><msub><mi>S</mi><msub><mi>𝝀</mi><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo rspace="0em">,</mo><mo lspace="0em" rspace="0em">⋅</mo><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">g=S_{\boldsymbol{\lambda}_{t-1}}(x,\cdot)</annotation></semantics></math>, <math id="A3.SS1.p2.m26" class="ltx_math_unparsed" alttext="\pi_{\mathrm{old}}=\hat{\pi}_{t}(\cdot|x)" display="inline" intent=":literal"><semantics><mrow><msub><mi>π</mi><mi>old</mi></msub><mo>=</mo><msub><mover accent="true"><mi>π</mi><mo>^</mo></mover><mi>t</mi></msub><mrow><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\pi_{\mathrm{old}}=\hat{\pi}_{t}(\cdot|x)</annotation></semantics></math>, <math id="A3.SS1.p2.m27" class="ltx_math_unparsed" alttext="\pi_{\mathrm{new}}=\pi_{t}(\cdot|x)" display="inline" intent=":literal"><semantics><mrow><msub><mi>π</mi><mi>new</mi></msub><mo>=</mo><msub><mi>π</mi><mi>t</mi></msub><mrow><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\pi_{\mathrm{new}}=\pi_{t}(\cdot|x)</annotation></semantics></math>, and <math id="A3.SS1.p2.m28" class="ltx_math_unparsed" alttext="\pi^{\prime}=\hat{\pi}_{t+1}(\cdot|x)" display="inline" intent=":literal"><semantics><mrow><msup><mi>π</mi><mo>′</mo></msup><mo>=</mo><msub><mover accent="true"><mi>π</mi><mo>^</mo></mover><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow></msub><mrow><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\pi^{\prime}=\hat{\pi}_{t+1}(\cdot|x)</annotation></semantics></math> in <a href="#A2.Thmtheorem10" title="Lemma B.10 (Three-point inequality with KL regularization). ‣ Appendix B Useful Lemmas ‣ Provable Last-Iterate Convergence for Multi-Objective Safe LLM Alignment via Optimistic Primal-Dual" class="ltx_ref"><span class="ltx_text ltx_ref_tag">lemma</span> <span class="ltx_text ltx_ref_tag">B.10</span></a>, we have</p>
<table id="A3.E34" class="ltx_equationgroup ltx_eqn_table">
<tbody>
<tr id="A3.E34X" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.E34X.m2" class="ltx_Math" alttext="\displaystyle\langle\hat{\pi}_{t+1}(\cdot|x)-\pi_{t}(\cdot|x),S_{\boldsymbol{\lambda}_{t-1}}(x,\cdot)\rangle-\beta\left(\mathrm{KL}(\hat{\pi}_{t+1}(\cdot|x)\|\pi_{\mathrm{ref}}(\cdot|x))-\mathrm{KL}(\pi_{t}(\cdot|x)\|\pi_{\mathrm{ref}}(\cdot|x))\right)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">⟨</mo><mover accent="true"><mi>π</mi><mo>^</mo></mover><msub><mrow></mrow><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow></msub><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>x</mi><mo stretchy="false">)</mo><mo>−</mo><mi>π</mi><msub><mrow></mrow><mi>t</mi></msub><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>x</mi><mo stretchy="false">)</mo><mo>,</mo><mi>S</mi><msub><mrow></mrow><msub><mi>𝝀</mi><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow></msub></msub><mo stretchy="false">(</mo><mi>x</mi><mo rspace="0em">,</mo><mo lspace="0em" rspace="0em">⋅</mo><mo stretchy="false">)</mo><mo stretchy="false">⟩</mo><mo>−</mo><mi>β</mi><mo>(</mo><mi>KL</mi><mo stretchy="false">(</mo><mover accent="true"><mi>π</mi><mo>^</mo></mover><msub><mrow></mrow><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow></msub><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>x</mi><mo stretchy="false">)</mo><mo lspace="0em" rspace="0.167em">∥</mo><mi>π</mi><msub><mrow></mrow><mi>ref</mi></msub><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>x</mi><mo stretchy="false">)</mo><mo stretchy="false">)</mo><mo>−</mo><mi>KL</mi><mo stretchy="false">(</mo><mi>π</mi><msub><mrow></mrow><mi>t</mi></msub><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>x</mi><mo stretchy="false">)</mo><mo lspace="0em" rspace="0.167em">∥</mo><mi>π</mi><msub><mrow></mrow><mi>ref</mi></msub><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>x</mi><mo stretchy="false">)</mo><mo stretchy="false">)</mo><mo>)</mo></mrow><annotation encoding="application/x-tex">\displaystyle\langle\hat{\pi}_{t+1}(\cdot|x)-\pi_{t}(\cdot|x),S_{\boldsymbol{\lambda}_{t-1}}(x,\cdot)\rangle-\beta\left(\mathrm{KL}(\hat{\pi}_{t+1}(\cdot|x)\|\pi_{\mathrm{ref}}(\cdot|x))-\mathrm{KL}(\pi_{t}(\cdot|x)\|\pi_{\mathrm{ref}}(\cdot|x))\right)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="3" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equationgroup ltx_align_right">(34)</span></td></tr>
<tr id="A3.E34Xa" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.E34Xa.m2" class="ltx_Math" alttext="\displaystyle\leq\eta_{\theta}\left(\mathrm{KL}(\hat{\pi}_{t+1}(\cdot|x)\|\hat{\pi}_{t}(\cdot|x))-\mathrm{KL}(\hat{\pi}_{t+1}(\cdot|x)\|\pi_{t}(\cdot|x))-\mathrm{KL}(\pi_{t}(\cdot|x)\|\hat{\pi}_{t}(\cdot|x))\right)-\beta\mathrm{KL}(\hat{\pi}_{t+1}(\cdot|x)\|\pi_{t}(\cdot|x))" display="inline" intent=":literal"><semantics><mrow><mo>≤</mo><mi>η</mi><msub><mrow></mrow><mi>θ</mi></msub><mo>(</mo><mi>KL</mi><mo stretchy="false">(</mo><mover accent="true"><mi>π</mi><mo>^</mo></mover><msub><mrow></mrow><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow></msub><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>x</mi><mo stretchy="false">)</mo><mo lspace="0em" rspace="0.167em">∥</mo><mover accent="true"><mi>π</mi><mo>^</mo></mover><msub><mrow></mrow><mi>t</mi></msub><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>x</mi><mo stretchy="false">)</mo><mo stretchy="false">)</mo><mo>−</mo><mi>KL</mi><mo stretchy="false">(</mo><mover accent="true"><mi>π</mi><mo>^</mo></mover><msub><mrow></mrow><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow></msub><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>x</mi><mo stretchy="false">)</mo><mo lspace="0em" rspace="0.167em">∥</mo><mi>π</mi><msub><mrow></mrow><mi>t</mi></msub><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>x</mi><mo stretchy="false">)</mo><mo stretchy="false">)</mo><mo>−</mo><mi>KL</mi><mo stretchy="false">(</mo><mi>π</mi><msub><mrow></mrow><mi>t</mi></msub><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>x</mi><mo stretchy="false">)</mo><mo lspace="0em" rspace="0.167em">∥</mo><mover accent="true"><mi>π</mi><mo>^</mo></mover><msub><mrow></mrow><mi>t</mi></msub><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>x</mi><mo stretchy="false">)</mo><mo stretchy="false">)</mo><mo>)</mo><mo>−</mo><mi>β</mi><mi>KL</mi><mo stretchy="false">(</mo><mover accent="true"><mi>π</mi><mo>^</mo></mover><msub><mrow></mrow><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow></msub><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>x</mi><mo stretchy="false">)</mo><mo lspace="0em" rspace="0.167em">∥</mo><mi>π</mi><msub><mrow></mrow><mi>t</mi></msub><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>x</mi><mo stretchy="false">)</mo><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">\displaystyle\leq\eta_{\theta}\left(\mathrm{KL}(\hat{\pi}_{t+1}(\cdot|x)\|\hat{\pi}_{t}(\cdot|x))-\mathrm{KL}(\hat{\pi}_{t+1}(\cdot|x)\|\pi_{t}(\cdot|x))-\mathrm{KL}(\pi_{t}(\cdot|x)\|\hat{\pi}_{t}(\cdot|x))\right)-\beta\mathrm{KL}(\hat{\pi}_{t+1}(\cdot|x)\|\pi_{t}(\cdot|x))</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr>
<tr id="A3.E34Xb" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.E34Xb.m2" class="ltx_Math" alttext="\displaystyle=\eta_{\theta}\mathrm{KL}(\hat{\pi}_{t+1}(\cdot|x)\|\hat{\pi}_{t}(\cdot|x))-(\eta_{\theta}+\beta)\mathrm{KL}(\hat{\pi}_{t+1}(\cdot|x)\|\pi_{t}(\cdot|x))-\eta_{\theta}\mathrm{KL}(\pi_{t}(\cdot|x)\|\hat{\pi}_{t}(\cdot|x))." display="inline" intent=":literal"><semantics><mrow><mo>=</mo><mi>η</mi><msub><mrow></mrow><mi>θ</mi></msub><mi>KL</mi><mo stretchy="false">(</mo><mover accent="true"><mi>π</mi><mo>^</mo></mover><msub><mrow></mrow><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow></msub><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>x</mi><mo stretchy="false">)</mo><mo lspace="0em" rspace="0.167em">∥</mo><mover accent="true"><mi>π</mi><mo>^</mo></mover><msub><mrow></mrow><mi>t</mi></msub><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>x</mi><mo stretchy="false">)</mo><mo stretchy="false">)</mo><mo>−</mo><mo stretchy="false">(</mo><mi>η</mi><msub><mrow></mrow><mi>θ</mi></msub><mo>+</mo><mi>β</mi><mo stretchy="false">)</mo><mi>KL</mi><mo stretchy="false">(</mo><mover accent="true"><mi>π</mi><mo>^</mo></mover><msub><mrow></mrow><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow></msub><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>x</mi><mo stretchy="false">)</mo><mo lspace="0em" rspace="0.167em">∥</mo><mi>π</mi><msub><mrow></mrow><mi>t</mi></msub><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>x</mi><mo stretchy="false">)</mo><mo stretchy="false">)</mo><mo>−</mo><mi>η</mi><msub><mrow></mrow><mi>θ</mi></msub><mi>KL</mi><mo stretchy="false">(</mo><mi>π</mi><msub><mrow></mrow><mi>t</mi></msub><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>x</mi><mo stretchy="false">)</mo><mo lspace="0em" rspace="0.167em">∥</mo><mover accent="true"><mi>π</mi><mo>^</mo></mover><msub><mrow></mrow><mi>t</mi></msub><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>x</mi><mo stretchy="false">)</mo><mo stretchy="false">)</mo><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle=\eta_{\theta}\mathrm{KL}(\hat{\pi}_{t+1}(\cdot|x)\|\hat{\pi}_{t}(\cdot|x))-(\eta_{\theta}+\beta)\mathrm{KL}(\hat{\pi}_{t+1}(\cdot|x)\|\pi_{t}(\cdot|x))-\eta_{\theta}\mathrm{KL}(\pi_{t}(\cdot|x)\|\hat{\pi}_{t}(\cdot|x)).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A3.SS1.p2.9" class="ltx_p">Let <math id="A3.SS1.p2.m29" class="ltx_Math" alttext="C&gt;0" display="inline" intent=":literal"><semantics><mrow><mi>C</mi><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">C&gt;0</annotation></semantics></math> be a constant. For the last term in the RHS of <a href="#A3.E32" title="In C.1 Upper bound of term A ‣ Appendix C Proof of ‣ Provable Last-Iterate Convergence for Multi-Objective Safe LLM Alignment via Optimistic Primal-Dual" class="ltx_ref"><span class="ltx_text ltx_ref_tag">eq.</span> <span class="ltx_text ltx_ref_tag">32</span></a>, we derive the upper bound as</p>
<table id="A3.E35" class="ltx_equationgroup ltx_eqn_table">
<tbody>
<tr id="A3.E35X" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.E35X.m2" class="ltx_Math" alttext="\displaystyle\langle\hat{\pi}_{t+1}(\cdot|x)-\pi_{t}(\cdot|x),S_{\boldsymbol{\lambda}_{t}}(x,\cdot)-S_{\boldsymbol{\lambda}_{t-1}}(x,\cdot)\rangle" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">⟨</mo><mover accent="true"><mi>π</mi><mo>^</mo></mover><msub><mrow></mrow><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow></msub><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>x</mi><mo stretchy="false">)</mo><mo>−</mo><mi>π</mi><msub><mrow></mrow><mi>t</mi></msub><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>x</mi><mo stretchy="false">)</mo><mo>,</mo><mi>S</mi><msub><mrow></mrow><msub><mi>𝝀</mi><mi>t</mi></msub></msub><mo stretchy="false">(</mo><mi>x</mi><mo rspace="0em">,</mo><mo lspace="0em" rspace="0em">⋅</mo><mo stretchy="false">)</mo><mo>−</mo><mi>S</mi><msub><mrow></mrow><msub><mi>𝝀</mi><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow></msub></msub><mo stretchy="false">(</mo><mi>x</mi><mo rspace="0em">,</mo><mo lspace="0em" rspace="0em">⋅</mo><mo stretchy="false">)</mo><mo stretchy="false">⟩</mo></mrow><annotation encoding="application/x-tex">\displaystyle\langle\hat{\pi}_{t+1}(\cdot|x)-\pi_{t}(\cdot|x),S_{\boldsymbol{\lambda}_{t}}(x,\cdot)-S_{\boldsymbol{\lambda}_{t-1}}(x,\cdot)\rangle</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="8" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equationgroup ltx_align_right">(35)</span></td></tr>
<tr id="A3.E35Xa" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.E35Xa.m2" class="ltx_Math" alttext="\displaystyle=\left\langle\hat{\pi}_{t+1}(\cdot|x)-\pi_{t}(\cdot|x),\sum_{j\in\mathcal{H}}(\lambda_{t,j}-\lambda_{t-1,j})R_{j}(x,\cdot)\right\rangle" display="inline" intent=":literal"><semantics><mrow><mo>=</mo><mo>⟨</mo><mover accent="true"><mi>π</mi><mo>^</mo></mover><msub><mrow></mrow><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow></msub><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>x</mi><mo stretchy="false">)</mo><mo>−</mo><mi>π</mi><msub><mrow></mrow><mi>t</mi></msub><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>x</mi><mo stretchy="false">)</mo><mo>,</mo><mstyle displaystyle="true"><mo movablelimits="false">∑</mo></mstyle><msub><mrow></mrow><mrow><mi>j</mi><mo>∈</mo><mi class="ltx_font_mathcaligraphic">ℋ</mi></mrow></msub><mo stretchy="false">(</mo><mi>λ</mi><msub><mrow></mrow><mrow><mi>t</mi><mo>,</mo><mi>j</mi></mrow></msub><mo>−</mo><mi>λ</mi><msub><mrow></mrow><mrow><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow><mo>,</mo><mi>j</mi></mrow></msub><mo stretchy="false">)</mo><mi>R</mi><msub><mrow></mrow><mi>j</mi></msub><mo stretchy="false">(</mo><mi>x</mi><mo rspace="0em">,</mo><mo lspace="0em" rspace="0em">⋅</mo><mo stretchy="false">)</mo><mo>⟩</mo></mrow><annotation encoding="application/x-tex">\displaystyle=\left\langle\hat{\pi}_{t+1}(\cdot|x)-\pi_{t}(\cdot|x),\sum_{j\in\mathcal{H}}(\lambda_{t,j}-\lambda_{t-1,j})R_{j}(x,\cdot)\right\rangle</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr>
<tr id="A3.E35Xb" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.E35Xb.m2" class="ltx_Math" alttext="\displaystyle\overset{(a)}{\leq}\|\hat{\pi}_{t+1}(\cdot|x)-\pi_{t}(\cdot|x)\|_{1}\left\|\sum_{j\in\mathcal{H}}(\lambda_{t,j}-\lambda_{t-1,j})R_{j}(x,\cdot)\right\|_{\infty}" display="inline" intent=":literal"><semantics><mrow><mover accent="true"><mo>≤</mo><mrow><mo maxsize="0.700em" minsize="0.700em">(</mo><mi mathsize="0.700em">a</mi><mo maxsize="0.700em" minsize="0.700em">)</mo></mrow></mover><mo lspace="0em" rspace="0.167em">∥</mo><mover accent="true"><mi>π</mi><mo>^</mo></mover><msub><mrow></mrow><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow></msub><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>x</mi><mo stretchy="false">)</mo><mo>−</mo><mi>π</mi><msub><mrow></mrow><mi>t</mi></msub><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>x</mi><mo stretchy="false">)</mo><mo lspace="0em" rspace="0.167em">∥</mo><msub><mrow></mrow><mn>1</mn></msub><mo>‖</mo><mstyle displaystyle="true"><mo movablelimits="false">∑</mo></mstyle><msub><mrow></mrow><mrow><mi>j</mi><mo>∈</mo><mi class="ltx_font_mathcaligraphic">ℋ</mi></mrow></msub><mo stretchy="false">(</mo><mi>λ</mi><msub><mrow></mrow><mrow><mi>t</mi><mo>,</mo><mi>j</mi></mrow></msub><mo>−</mo><mi>λ</mi><msub><mrow></mrow><mrow><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow><mo>,</mo><mi>j</mi></mrow></msub><mo stretchy="false">)</mo><mi>R</mi><msub><mrow></mrow><mi>j</mi></msub><mo stretchy="false">(</mo><mi>x</mi><mo rspace="0em">,</mo><mo lspace="0em" rspace="0em">⋅</mo><mo stretchy="false">)</mo><mo>‖</mo><msub><mrow></mrow><mi mathvariant="normal">∞</mi></msub></mrow><annotation encoding="application/x-tex">\displaystyle\overset{(a)}{\leq}\|\hat{\pi}_{t+1}(\cdot|x)-\pi_{t}(\cdot|x)\|_{1}\left\|\sum_{j\in\mathcal{H}}(\lambda_{t,j}-\lambda_{t-1,j})R_{j}(x,\cdot)\right\|_{\infty}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr>
<tr id="A3.E35Xc" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.E35Xc.m2" class="ltx_Math" alttext="\displaystyle\overset{(b)}{\leq}\|\hat{\pi}_{t+1}(\cdot|x)-\pi_{t}(\cdot|x)\|_{1}\|\boldsymbol{\lambda}_{t}-\boldsymbol{\lambda}_{t-1}\|_{1}R_{\max}" display="inline" intent=":literal"><semantics><mrow><mover accent="true"><mo>≤</mo><mrow><mo maxsize="0.700em" minsize="0.700em">(</mo><mi mathsize="0.700em">b</mi><mo maxsize="0.700em" minsize="0.700em">)</mo></mrow></mover><mo lspace="0em" rspace="0.167em">∥</mo><mover accent="true"><mi>π</mi><mo>^</mo></mover><msub><mrow></mrow><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow></msub><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>x</mi><mo stretchy="false">)</mo><mo>−</mo><mi>π</mi><msub><mrow></mrow><mi>t</mi></msub><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>x</mi><mo stretchy="false">)</mo><mo lspace="0em" rspace="0.0835em">∥</mo><msub><mrow></mrow><mn>1</mn></msub><mo lspace="0.0835em" rspace="0.167em">∥</mo><mi>𝝀</mi><msub><mrow></mrow><mi>t</mi></msub><mo>−</mo><mi>𝝀</mi><msub><mrow></mrow><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow></msub><mo lspace="0em" rspace="0.167em">∥</mo><msub><mrow></mrow><mn>1</mn></msub><mi>R</mi><msub><mrow></mrow><mi>max</mi></msub></mrow><annotation encoding="application/x-tex">\displaystyle\overset{(b)}{\leq}\|\hat{\pi}_{t+1}(\cdot|x)-\pi_{t}(\cdot|x)\|_{1}\|\boldsymbol{\lambda}_{t}-\boldsymbol{\lambda}_{t-1}\|_{1}R_{\max}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr>
<tr id="A3.E35Xd" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.E35Xd.m2" class="ltx_Math" alttext="\displaystyle\leq\sqrt{2\mathrm{KL}(\hat{\pi}_{t+1}(\cdot|x)\|\pi_{t}(\cdot|x))}\|\boldsymbol{\lambda}_{t}-\boldsymbol{\lambda}_{t-1}\|_{1}R_{\max}\quad\text{(By Pinsker's inequality in \lx@cref{creftype~refnum}{lem:pinsker's ineq})}" display="inline" intent=":literal"><semantics><mrow><mo>≤</mo><msqrt><mrow><mn>2</mn><mi>KL</mi><mo stretchy="false">(</mo><mover accent="true"><mi>π</mi><mo>^</mo></mover><msub><mrow></mrow><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow></msub><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>x</mi><mo stretchy="false">)</mo><mo lspace="0em" rspace="0.167em">∥</mo><mi>π</mi><msub><mrow></mrow><mi>t</mi></msub><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>x</mi><mo stretchy="false">)</mo><mo stretchy="false">)</mo></mrow></msqrt><mo lspace="0em" rspace="0.167em">∥</mo><mi>𝝀</mi><msub><mrow></mrow><mi>t</mi></msub><mo>−</mo><mi>𝝀</mi><msub><mrow></mrow><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow></msub><mo lspace="0em" rspace="0.167em">∥</mo><msub><mrow></mrow><mn>1</mn></msub><mi>R</mi><msub><mrow></mrow><mi>max</mi></msub><mrow><mtext>(By Pinsker’s inequality in </mtext><mtext><a href="#A2.Thmtheorem2" title="Lemma B.2 (Pinsker’s inequality (discrete form)). ‣ Appendix B Useful Lemmas ‣ Provable Last-Iterate Convergence for Multi-Objective Safe LLM Alignment via Optimistic Primal-Dual" class="ltx_ref"><span class="ltx_text ltx_ref_tag">lemma</span> <span class="ltx_text ltx_ref_tag">B.2</span></a></mtext><mtext>)</mtext></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\leq\sqrt{2\mathrm{KL}(\hat{\pi}_{t+1}(\cdot|x)\|\pi_{t}(\cdot|x))}\|\boldsymbol{\lambda}_{t}-\boldsymbol{\lambda}_{t-1}\|_{1}R_{\max}\quad\text{(By Pinsker's inequality in \lx@cref{creftype~refnum}{lem:pinsker's ineq})}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr>
<tr id="A3.E35Xe" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.E35Xe.m2" class="ltx_Math" alttext="\displaystyle\leq C\mathrm{KL}(\hat{\pi}_{t+1}(\cdot|x)\|\pi_{t}(\cdot|x))+\frac{R_{\max}^{2}}{2C}\|\boldsymbol{\lambda}_{t}-\boldsymbol{\lambda}_{t-1}\|_{1}^{2}\quad\text{(By AM-GM inequality $\frac{x^{2}}{2C}+\frac{y^{2}C}{2}\geq xy$ with $C&gt;0$)}" display="inline" intent=":literal"><semantics><mrow><mo>≤</mo><mi>C</mi><mi>KL</mi><mo stretchy="false">(</mo><mover accent="true"><mi>π</mi><mo>^</mo></mover><msub><mrow></mrow><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow></msub><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>x</mi><mo stretchy="false">)</mo><mo lspace="0em" rspace="0.167em">∥</mo><mi>π</mi><msub><mrow></mrow><mi>t</mi></msub><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>x</mi><mo stretchy="false">)</mo><mo stretchy="false">)</mo><mo>+</mo><mstyle displaystyle="true"><mfrac><msubsup><mi>R</mi><mi>max</mi><mn>2</mn></msubsup><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>C</mi></mrow></mfrac></mstyle><mo lspace="0em" rspace="0.167em">∥</mo><mi>𝝀</mi><msub><mrow></mrow><mi>t</mi></msub><mo>−</mo><mi>𝝀</mi><msub><mrow></mrow><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow></msub><mo lspace="0em" rspace="0.167em">∥</mo><msub><mrow></mrow><mn>1</mn></msub><msup><mrow></mrow><mn>2</mn></msup><mrow><mtext>(By AM-GM inequality </mtext><mrow><mrow><mfrac><msup><mi>x</mi><mn>2</mn></msup><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>C</mi></mrow></mfrac><mo>+</mo><mfrac><mrow><msup><mi>y</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mi>C</mi></mrow><mn>2</mn></mfrac></mrow><mo>≥</mo><mrow><mi>x</mi><mo lspace="0em" rspace="0em">​</mo><mi>y</mi></mrow></mrow><mtext> with </mtext><mrow><mi>C</mi><mo>&gt;</mo><mn>0</mn></mrow><mtext>)</mtext></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\leq C\mathrm{KL}(\hat{\pi}_{t+1}(\cdot|x)\|\pi_{t}(\cdot|x))+\frac{R_{\max}^{2}}{2C}\|\boldsymbol{\lambda}_{t}-\boldsymbol{\lambda}_{t-1}\|_{1}^{2}\quad\text{(By AM-GM inequality $\frac{x^{2}}{2C}+\frac{y^{2}C}{2}\geq xy$ with $C&gt;0$)}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr>
<tr id="A3.E35Xf" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.E35Xf.m2" class="ltx_Math" alttext="\displaystyle\leq C\mathrm{KL}(\hat{\pi}_{t+1}(\cdot|x)\|\pi_{t}(\cdot|x))+\frac{|\mathcal{H}|R_{\max}^{2}}{2C}\|\boldsymbol{\lambda}_{t}-\boldsymbol{\lambda}_{t-1}\|_{2}^{2}\quad\text{(By $\|\mathbf{x}\|_{1}^{2}\leq d\|\mathbf{x}\|_{2}^{2}$, $\forall\mathbf{x}\in\mathbb{R}^{d}$)}" display="inline" intent=":literal"><semantics><mrow><mo>≤</mo><mi>C</mi><mi>KL</mi><mo stretchy="false">(</mo><mover accent="true"><mi>π</mi><mo>^</mo></mover><msub><mrow></mrow><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow></msub><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>x</mi><mo stretchy="false">)</mo><mo lspace="0em" rspace="0.167em">∥</mo><mi>π</mi><msub><mrow></mrow><mi>t</mi></msub><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>x</mi><mo stretchy="false">)</mo><mo stretchy="false">)</mo><mo>+</mo><mstyle displaystyle="true"><mfrac><mrow><mrow><mo stretchy="false">|</mo><mi class="ltx_font_mathcaligraphic">ℋ</mi><mo stretchy="false">|</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>R</mi><mi>max</mi><mn>2</mn></msubsup></mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>C</mi></mrow></mfrac></mstyle><mo lspace="0em" rspace="0.167em">∥</mo><mi>𝝀</mi><msub><mrow></mrow><mi>t</mi></msub><mo>−</mo><mi>𝝀</mi><msub><mrow></mrow><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow></msub><mo lspace="0em" rspace="0.167em">∥</mo><msub><mrow></mrow><mn>2</mn></msub><msup><mrow></mrow><mn>2</mn></msup><mrow><mtext>(By </mtext><mrow><msubsup><mrow><mo stretchy="false">‖</mo><mi>𝐱</mi><mo stretchy="false">‖</mo></mrow><mn>1</mn><mn>2</mn></msubsup><mo>≤</mo><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><msubsup><mrow><mo stretchy="false">‖</mo><mi>𝐱</mi><mo stretchy="false">‖</mo></mrow><mn>2</mn><mn>2</mn></msubsup></mrow></mrow><mtext>, </mtext><mrow><mrow><mo rspace="0.167em">∀</mo><mi>𝐱</mi></mrow><mo>∈</mo><msup><mi>ℝ</mi><mi>d</mi></msup></mrow><mtext>)</mtext></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\leq C\mathrm{KL}(\hat{\pi}_{t+1}(\cdot|x)\|\pi_{t}(\cdot|x))+\frac{|\mathcal{H}|R_{\max}^{2}}{2C}\|\boldsymbol{\lambda}_{t}-\boldsymbol{\lambda}_{t-1}\|_{2}^{2}\quad\text{(By $\|\mathbf{x}\|_{1}^{2}\leq d\|\mathbf{x}\|_{2}^{2}$, $\forall\mathbf{x}\in\mathbb{R}^{d}$)}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr>
<tr id="A3.E35Xg" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.E35Xg.m2" class="ltx_Math" alttext="\displaystyle\overset{(c)}{\leq}C\mathrm{KL}(\hat{\pi}_{t+1}(\cdot|x)\|\pi_{t}(\cdot|x))+\frac{|\mathcal{H}|R_{\max}^{2}}{C}\left(\|\boldsymbol{\lambda}_{t}-\hat{\boldsymbol{\lambda}}_{t}\|_{2}^{2}+\|\hat{\boldsymbol{\lambda}}_{t}-\boldsymbol{\lambda}_{t-1}\|_{2}^{2}\right)," display="inline" intent=":literal"><semantics><mrow><mover accent="true"><mo>≤</mo><mrow><mo maxsize="0.700em" minsize="0.700em">(</mo><mi mathsize="0.700em">c</mi><mo maxsize="0.700em" minsize="0.700em">)</mo></mrow></mover><mi>C</mi><mi>KL</mi><mo stretchy="false">(</mo><mover accent="true"><mi>π</mi><mo>^</mo></mover><msub><mrow></mrow><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow></msub><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>x</mi><mo stretchy="false">)</mo><mo lspace="0em" rspace="0.167em">∥</mo><mi>π</mi><msub><mrow></mrow><mi>t</mi></msub><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>x</mi><mo stretchy="false">)</mo><mo stretchy="false">)</mo><mo>+</mo><mstyle displaystyle="true"><mfrac><mrow><mrow><mo stretchy="false">|</mo><mi class="ltx_font_mathcaligraphic">ℋ</mi><mo stretchy="false">|</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>R</mi><mi>max</mi><mn>2</mn></msubsup></mrow><mi>C</mi></mfrac></mstyle><mo>(</mo><mo lspace="0em" rspace="0.167em">∥</mo><mi>𝝀</mi><msub><mrow></mrow><mi>t</mi></msub><mo>−</mo><mover accent="true"><mi>𝝀</mi><mo>^</mo></mover><msub><mrow></mrow><mi>t</mi></msub><mo lspace="0em" rspace="0em">∥</mo><msub><mrow></mrow><mn>2</mn></msub><msup><mrow></mrow><mn>2</mn></msup><mo lspace="0em" rspace="0em">+</mo><mo lspace="0em" rspace="0.167em">∥</mo><mover accent="true"><mi>𝝀</mi><mo>^</mo></mover><msub><mrow></mrow><mi>t</mi></msub><mo>−</mo><mi>𝝀</mi><msub><mrow></mrow><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow></msub><mo lspace="0em" rspace="0.167em">∥</mo><msub><mrow></mrow><mn>2</mn></msub><msup><mrow></mrow><mn>2</mn></msup><mo>)</mo><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\overset{(c)}{\leq}C\mathrm{KL}(\hat{\pi}_{t+1}(\cdot|x)\|\pi_{t}(\cdot|x))+\frac{|\mathcal{H}|R_{\max}^{2}}{C}\left(\|\boldsymbol{\lambda}_{t}-\hat{\boldsymbol{\lambda}}_{t}\|_{2}^{2}+\|\hat{\boldsymbol{\lambda}}_{t}-\boldsymbol{\lambda}_{t-1}\|_{2}^{2}\right),</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A3.SS1.p2.10" class="ltx_p">where <math id="A3.SS1.p2.m30" class="ltx_Math" alttext="(a)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi>a</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(a)</annotation></semantics></math> is by Hölder’s inequality shown in <a href="#A2.Thmtheorem1" title="Lemma B.1 (Hölder’s inequality). ‣ Appendix B Useful Lemmas ‣ Provable Last-Iterate Convergence for Multi-Objective Safe LLM Alignment via Optimistic Primal-Dual" class="ltx_ref"><span class="ltx_text ltx_ref_tag">lemma</span> <span class="ltx_text ltx_ref_tag">B.1</span></a> and letting <math id="A3.SS1.p2.m31" class="ltx_math_unparsed" alttext="f(\cdot)=\hat{\pi}_{t+1}(\cdot|x)-\pi_{t}(\cdot|x)" display="inline" intent=":literal"><semantics><mrow><mi>f</mi><mrow><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo stretchy="false">)</mo></mrow><mo>=</mo><msub><mover accent="true"><mi>π</mi><mo>^</mo></mover><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow></msub><mrow><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>x</mi><mo stretchy="false">)</mo></mrow><mo>−</mo><msub><mi>π</mi><mi>t</mi></msub><mrow><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">f(\cdot)=\hat{\pi}_{t+1}(\cdot|x)-\pi_{t}(\cdot|x)</annotation></semantics></math>, <math id="A3.SS1.p2.m32" class="ltx_Math" alttext="g(\cdot)=\sum_{j\in\mathcal{H}}(\lambda_{t,j}-\lambda_{t-1,j})R_{j}(x,\cdot)" display="inline" intent=":literal"><semantics><mrow><mrow><mi>g</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo stretchy="false">)</mo></mrow></mrow><mo rspace="0.111em">=</mo><mrow><msub><mo rspace="0em">∑</mo><mrow><mi>j</mi><mo>∈</mo><mi class="ltx_font_mathcaligraphic">ℋ</mi></mrow></msub><mrow><mrow><mo stretchy="false">(</mo><mrow><msub><mi>λ</mi><mrow><mi>t</mi><mo>,</mo><mi>j</mi></mrow></msub><mo>−</mo><msub><mi>λ</mi><mrow><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow><mo>,</mo><mi>j</mi></mrow></msub></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>R</mi><mi>j</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo rspace="0em">,</mo><mo lspace="0em" rspace="0em">⋅</mo><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">g(\cdot)=\sum_{j\in\mathcal{H}}(\lambda_{t,j}-\lambda_{t-1,j})R_{j}(x,\cdot)</annotation></semantics></math>, <math id="A3.SS1.p2.m33" class="ltx_Math" alttext="p=1" display="inline" intent=":literal"><semantics><mrow><mi>p</mi><mo>=</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">p=1</annotation></semantics></math>, and <math id="A3.SS1.p2.m34" class="ltx_Math" alttext="q=\infty" display="inline" intent=":literal"><semantics><mrow><mi>q</mi><mo>=</mo><mi mathvariant="normal">∞</mi></mrow><annotation encoding="application/x-tex">q=\infty</annotation></semantics></math>.
<math id="A3.SS1.p2.m35" class="ltx_Math" alttext="(b)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi>b</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(b)</annotation></semantics></math> is by</p>
<table id="A3.Ex59" class="ltx_equationgroup ltx_eqn_table">

<tbody id="A3.Ex59X"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.Ex59X.m2" class="ltx_Math" alttext="\displaystyle\left\|\sum_{j\in\mathcal{H}}(\lambda_{t,j}-\lambda_{t-1,j})R_{j}(x,\cdot)\right\|_{\infty}\leq" display="inline" intent=":literal"><semantics><mrow><msub><mrow><mo>‖</mo><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mi>j</mi><mo>∈</mo><mi class="ltx_font_mathcaligraphic">ℋ</mi></mrow></munder></mstyle><mrow><mrow><mo stretchy="false">(</mo><mrow><msub><mi>λ</mi><mrow><mi>t</mi><mo>,</mo><mi>j</mi></mrow></msub><mo>−</mo><msub><mi>λ</mi><mrow><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow><mo>,</mo><mi>j</mi></mrow></msub></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>R</mi><mi>j</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo rspace="0em">,</mo><mo lspace="0em" rspace="0em">⋅</mo><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>‖</mo></mrow><mi mathvariant="normal">∞</mi></msub><mo>≤</mo><mphantom></mphantom></mrow><annotation encoding="application/x-tex">\displaystyle\left\|\sum_{j\in\mathcal{H}}(\lambda_{t,j}-\lambda_{t-1,j})R_{j}(x,\cdot)\right\|_{\infty}\leq</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex59X.m3" class="ltx_Math" alttext="\displaystyle\sum_{j\in\mathcal{H}}\left\|(\lambda_{t,j}-\lambda_{t-1,j})R_{j}(x,\cdot)\right\|_{\infty}\quad\text{(by triangle inequality)}" display="inline" intent=":literal"><semantics><mrow><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mi>j</mi><mo>∈</mo><mi class="ltx_font_mathcaligraphic">ℋ</mi></mrow></munder></mstyle><msub><mrow><mo>‖</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><msub><mi>λ</mi><mrow><mi>t</mi><mo>,</mo><mi>j</mi></mrow></msub><mo>−</mo><msub><mi>λ</mi><mrow><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow><mo>,</mo><mi>j</mi></mrow></msub></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>R</mi><mi>j</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo rspace="0em">,</mo><mo lspace="0em" rspace="0em">⋅</mo><mo stretchy="false">)</mo></mrow></mrow><mo>‖</mo></mrow><mi mathvariant="normal">∞</mi></msub></mrow><mspace style="width:1em;" width="1em"></mspace><mtext>(by triangle inequality)</mtext></mrow><annotation encoding="application/x-tex">\displaystyle\sum_{j\in\mathcal{H}}\left\|(\lambda_{t,j}-\lambda_{t-1,j})R_{j}(x,\cdot)\right\|_{\infty}\quad\text{(by triangle inequality)}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A3.Ex59Xa"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.Ex59Xa.m2" class="ltx_Math" alttext="\displaystyle=" display="inline" intent=":literal"><semantics><mo>=</mo><annotation encoding="application/x-tex">\displaystyle=</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex59Xa.m3" class="ltx_Math" alttext="\displaystyle\sum_{j\in\mathcal{H}}|\lambda_{t,j}-\lambda_{t-1,j}|\left\|R_{j}(x,\cdot)\right\|_{\infty}" display="inline" intent=":literal"><semantics><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mi>j</mi><mo>∈</mo><mi class="ltx_font_mathcaligraphic">ℋ</mi></mrow></munder></mstyle><mrow><mrow><mo stretchy="false">|</mo><mrow><msub><mi>λ</mi><mrow><mi>t</mi><mo>,</mo><mi>j</mi></mrow></msub><mo>−</mo><msub><mi>λ</mi><mrow><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow><mo>,</mo><mi>j</mi></mrow></msub></mrow><mo stretchy="false">|</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo>‖</mo><mrow><msub><mi>R</mi><mi>j</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo mathsize="0.700em" rspace="0em">,</mo><mo lspace="0em" rspace="0em">⋅</mo><mo stretchy="false">)</mo></mrow></mrow><mo>‖</mo></mrow><mi mathvariant="normal">∞</mi></msub></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\sum_{j\in\mathcal{H}}|\lambda_{t,j}-\lambda_{t-1,j}|\left\|R_{j}(x,\cdot)\right\|_{\infty}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A3.Ex59Xb"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.Ex59Xb.m2" class="ltx_Math" alttext="\displaystyle\leq" display="inline" intent=":literal"><semantics><mo>≤</mo><annotation encoding="application/x-tex">\displaystyle\leq</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex59Xb.m3" class="ltx_Math" alttext="\displaystyle\left(\sum_{j\in\mathcal{H}}|\lambda_{t,j}-\lambda_{t-1,j}|\right)\max_{j}\left\|R_{j}(x,\cdot)\right\|_{\infty}" display="inline" intent=":literal"><semantics><mrow><mrow><mo>(</mo><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mi>j</mi><mo>∈</mo><mi class="ltx_font_mathcaligraphic">ℋ</mi></mrow></munder></mstyle><mrow><mo stretchy="false">|</mo><mrow><msub><mi>λ</mi><mrow><mi>t</mi><mo>,</mo><mi>j</mi></mrow></msub><mo>−</mo><msub><mi>λ</mi><mrow><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow><mo>,</mo><mi>j</mi></mrow></msub></mrow><mo stretchy="false">|</mo></mrow></mrow><mo>)</mo></mrow><mo lspace="0.167em" rspace="0em">​</mo><munder><mi>max</mi><mi>j</mi></munder><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo>‖</mo><mrow><msub><mi>R</mi><mi>j</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo mathsize="0.700em" rspace="0em">,</mo><mo lspace="0em" rspace="0em">⋅</mo><mo stretchy="false">)</mo></mrow></mrow><mo>‖</mo></mrow><mi mathvariant="normal">∞</mi></msub></mrow><annotation encoding="application/x-tex">\displaystyle\left(\sum_{j\in\mathcal{H}}|\lambda_{t,j}-\lambda_{t-1,j}|\right)\max_{j}\left\|R_{j}(x,\cdot)\right\|_{\infty}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A3.Ex59Xc"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.Ex59Xc.m2" class="ltx_Math" alttext="\displaystyle=" display="inline" intent=":literal"><semantics><mo>=</mo><annotation encoding="application/x-tex">\displaystyle=</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex59Xc.m3" class="ltx_Math" alttext="\displaystyle\|\boldsymbol{\lambda}_{t}-\boldsymbol{\lambda}_{t-1}\|_{1}\max_{j}\left\|R_{j}(x,\cdot)\right\|_{\infty}\quad\text{(by definition of 1-norm)}" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mrow><mo stretchy="false">‖</mo><mrow><msub><mi>𝝀</mi><mi>t</mi></msub><mo>−</mo><msub><mi>𝝀</mi><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow></msub></mrow><mo stretchy="false">‖</mo></mrow><mn>1</mn></msub><mo lspace="0.167em" rspace="0em">​</mo><munder><mi>max</mi><mi>j</mi></munder><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo>‖</mo><mrow><msub><mi>R</mi><mi>j</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo rspace="0em">,</mo><mo lspace="0em" rspace="0em">⋅</mo><mo stretchy="false">)</mo></mrow></mrow><mo>‖</mo></mrow><mi mathvariant="normal">∞</mi></msub></mrow><mspace style="width:1em;" width="1em"></mspace><mtext>(by definition of 1-norm)</mtext></mrow><annotation encoding="application/x-tex">\displaystyle\|\boldsymbol{\lambda}_{t}-\boldsymbol{\lambda}_{t-1}\|_{1}\max_{j}\left\|R_{j}(x,\cdot)\right\|_{\infty}\quad\text{(by definition of 1-norm)}</annotation></semantics></math></td>
