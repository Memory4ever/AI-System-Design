<div id="A5.SS1.p3" class="ltx_para">
<p id="A5.SS1.p3.4" class="ltx_p">Let <math id="A5.SS1.p3.m1" class="ltx_Math" alttext="\eta=\eta_{\theta}" display="inline" intent=":literal"><semantics><mrow><mi>η</mi><mo>=</mo><msub><mi>η</mi><mi>θ</mi></msub></mrow><annotation encoding="application/x-tex">\eta=\eta_{\theta}</annotation></semantics></math>, <math id="A5.SS1.p3.m2" class="ltx_Math" alttext="g=S_{\boldsymbol{\lambda}_{t-1}}(x,\cdot)" display="inline" intent=":literal"><semantics><mrow><mi>g</mi><mo>=</mo><mrow><msub><mi>S</mi><msub><mi>𝝀</mi><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo rspace="0em">,</mo><mo lspace="0em" rspace="0em">⋅</mo><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">g=S_{\boldsymbol{\lambda}_{t-1}}(x,\cdot)</annotation></semantics></math>, <math id="A5.SS1.p3.m3" class="ltx_math_unparsed" alttext="\pi_{\mathrm{old}}=\hat{\pi}_{t}(\cdot|x)" display="inline" intent=":literal"><semantics><mrow><msub><mi>π</mi><mi>old</mi></msub><mo>=</mo><msub><mover accent="true"><mi>π</mi><mo>^</mo></mover><mi>t</mi></msub><mrow><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\pi_{\mathrm{old}}=\hat{\pi}_{t}(\cdot|x)</annotation></semantics></math>, <math id="A5.SS1.p3.m4" class="ltx_math_unparsed" alttext="\pi_{\mathrm{new}}=\pi_{t}(\cdot|x)" display="inline" intent=":literal"><semantics><mrow><msub><mi>π</mi><mi>new</mi></msub><mo>=</mo><msub><mi>π</mi><mi>t</mi></msub><mrow><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\pi_{\mathrm{new}}=\pi_{t}(\cdot|x)</annotation></semantics></math>, and <math id="A5.SS1.p3.m5" class="ltx_math_unparsed" alttext="\pi^{\prime}=\hat{\pi}_{t+1}(\cdot|x)" display="inline" intent=":literal"><semantics><mrow><msup><mi>π</mi><mo>′</mo></msup><mo>=</mo><msub><mover accent="true"><mi>π</mi><mo>^</mo></mover><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow></msub><mrow><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\pi^{\prime}=\hat{\pi}_{t+1}(\cdot|x)</annotation></semantics></math> in <a href="#A2.Thmtheorem12" title="Corollary B.12. ‣ Appendix B Useful Lemmas ‣ Provable Last-Iterate Convergence for Multi-Objective Safe LLM Alignment via Optimistic Primal-Dual" class="ltx_ref"><span class="ltx_text ltx_ref_tag">corollary</span> <span class="ltx_text ltx_ref_tag">B.12</span></a>, we have</p>
