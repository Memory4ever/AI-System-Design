<tr id="A3.E37Xb" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.E37Xb.m2" class="ltx_Math" alttext="\displaystyle=" display="inline" intent=":literal"><semantics><mo>=</mo><annotation encoding="application/x-tex">\displaystyle=</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.E37Xb.m3" class="ltx_Math" alttext="\displaystyle\mathbb{E}_{x\sim\mathcal{D}}\left[\left(V_{S_{\boldsymbol{\lambda}_{t}}}^{\pi_{t}}(x)-V_{S_{\hat{\boldsymbol{\lambda}}_{t+1}}}^{\pi_{t}}(x)\right)+\left(V_{S_{\hat{\boldsymbol{\lambda}}_{t+1}}}^{\pi_{t}}(x)-V_{S_{\boldsymbol{\lambda}^{\star}}}^{\pi_{t}}(x)\right)\right." display="inline" intent=":literal"><semantics><mrow><mi>𝔼</mi><msub><mrow></mrow><mrow><mi>x</mi><mo>∼</mo><mi class="ltx_font_mathcaligraphic">𝒟</mi></mrow></msub><mo>[</mo><mo>(</mo><mi>V</mi><msub><mrow></mrow><msub><mi>S</mi><msub><mi>𝝀</mi><mi>t</mi></msub></msub></msub><msup><mrow></mrow><msub><mi>π</mi><mi>t</mi></msub></msup><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo><mo>−</mo><mi>V</mi><msub><mrow></mrow><msub><mi>S</mi><msub><mover accent="true"><mi>𝝀</mi><mo>^</mo></mover><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow></msub></msub></msub><msup><mrow></mrow><msub><mi>π</mi><mi>t</mi></msub></msup><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo><mo>)</mo><mo>+</mo><mo>(</mo><mi>V</mi><msub><mrow></mrow><msub><mi>S</mi><msub><mover accent="true"><mi>𝝀</mi><mo>^</mo></mover><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow></msub></msub></msub><msup><mrow></mrow><msub><mi>π</mi><mi>t</mi></msub></msup><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo><mo>−</mo><mi>V</mi><msub><mrow></mrow><msub><mi>S</mi><msup><mi>𝝀</mi><mo>⋆</mo></msup></msub></msub><msup><mrow></mrow><msub><mi>π</mi><mi>t</mi></msub></msup><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo><mo>)</mo></mrow><annotation encoding="application/x-tex">\displaystyle\mathbb{E}_{x\sim\mathcal{D}}\left[\left(V_{S_{\boldsymbol{\lambda}_{t}}}^{\pi_{t}}(x)-V_{S_{\hat{\boldsymbol{\lambda}}_{t+1}}}^{\pi_{t}}(x)\right)+\left(V_{S_{\hat{\boldsymbol{\lambda}}_{t+1}}}^{\pi_{t}}(x)-V_{S_{\boldsymbol{\lambda}^{\star}}}^{\pi_{t}}(x)\right)\right.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr>
<tr id="A3.E37Xc" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.E37Xc.m2" class="ltx_Math" alttext="\displaystyle\left.-\left(V_{S_{\boldsymbol{\lambda}_{t}}}^{\pi_{t-1}}(x)-V_{S_{\hat{\boldsymbol{\lambda}}_{t+1}}}^{\pi_{t-1}}(x)\right)+\left(V_{S_{\boldsymbol{\lambda}_{t}}}^{\pi_{t-1}}(x)-V_{S_{\hat{\boldsymbol{\lambda}}_{t+1}}}^{\pi_{t-1}}(x)\right)\right]" display="inline" intent=":literal"><semantics><mrow><mo>−</mo><mo>(</mo><mi>V</mi><msub><mrow></mrow><msub><mi>S</mi><msub><mi>𝝀</mi><mi>t</mi></msub></msub></msub><msup><mrow></mrow><msub><mi>π</mi><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow></msub></msup><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo><mo>−</mo><mi>V</mi><msub><mrow></mrow><msub><mi>S</mi><msub><mover accent="true"><mi>𝝀</mi><mo>^</mo></mover><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow></msub></msub></msub><msup><mrow></mrow><msub><mi>π</mi><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow></msub></msup><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo><mo>)</mo><mo>+</mo><mo>(</mo><mi>V</mi><msub><mrow></mrow><msub><mi>S</mi><msub><mi>𝝀</mi><mi>t</mi></msub></msub></msub><msup><mrow></mrow><msub><mi>π</mi><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow></msub></msup><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo><mo>−</mo><mi>V</mi><msub><mrow></mrow><msub><mi>S</mi><msub><mover accent="true"><mi>𝝀</mi><mo>^</mo></mover><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow></msub></msub></msub><msup><mrow></mrow><msub><mi>π</mi><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow></msub></msup><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo><mo>)</mo><mo>]</mo></mrow><annotation encoding="application/x-tex">\displaystyle\left.-\left(V_{S_{\boldsymbol{\lambda}_{t}}}^{\pi_{t-1}}(x)-V_{S_{\hat{\boldsymbol{\lambda}}_{t+1}}}^{\pi_{t-1}}(x)\right)+\left(V_{S_{\boldsymbol{\lambda}_{t}}}^{\pi_{t-1}}(x)-V_{S_{\hat{\boldsymbol{\lambda}}_{t+1}}}^{\pi_{t-1}}(x)\right)\right]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A3.SS2.p1.3" class="ltx_p">Define <math id="A3.SS2.p1.m2" class="ltx_Math" alttext="R_{\mathcal{H}}=\left[R_{j_{1}},R_{j_{2}},\cdots,R_{j_{|\mathcal{H}|}}\right]\in\mathbb{R}^{|\mathcal{H}|}" display="inline" intent=":literal"><semantics><mrow><msub><mi>R</mi><mi class="ltx_font_mathcaligraphic">ℋ</mi></msub><mo>=</mo><mrow><mo>[</mo><mrow><msub><mi>R</mi><msub><mi>j</mi><mn>1</mn></msub></msub><mo>,</mo><msub><mi>R</mi><msub><mi>j</mi><mn>2</mn></msub></msub><mo>,</mo><mo lspace="0em" rspace="0em">⋯</mo><mo>,</mo><msub><mi>R</mi><msub><mi>j</mi><mrow><mo stretchy="false">|</mo><mi class="ltx_font_mathcaligraphic">ℋ</mi><mo stretchy="false">|</mo></mrow></msub></msub></mrow><mo>]</mo></mrow><mo>∈</mo><msup><mi>ℝ</mi><mrow><mo stretchy="false">|</mo><mi class="ltx_font_mathcaligraphic">ℋ</mi><mo stretchy="false">|</mo></mrow></msup></mrow><annotation encoding="application/x-tex">R_{\mathcal{H}}=\left[R_{j_{1}},R_{j_{2}},\cdots,R_{j_{|\mathcal{H}|}}\right]\in\mathbb{R}^{|\mathcal{H}|}</annotation></semantics></math>, where <math id="A3.SS2.p1.m3" class="ltx_Math" alttext="j_{1}&lt;j_{2}&lt;\cdots&lt;j_{|\mathcal{H}|}" display="inline" intent=":literal"><semantics><mrow><msub><mi>j</mi><mn>1</mn></msub><mo>&lt;</mo><msub><mi>j</mi><mn>2</mn></msub><mo rspace="0.1389em">&lt;</mo><mo lspace="0.1389em" rspace="0.1389em">⋯</mo><mo lspace="0.1389em">&lt;</mo><msub><mi>j</mi><mrow><mo stretchy="false">|</mo><mi class="ltx_font_mathcaligraphic">ℋ</mi><mo stretchy="false">|</mo></mrow></msub></mrow><annotation encoding="application/x-tex">j_{1}&lt;j_{2}&lt;\cdots&lt;j_{|\mathcal{H}|}</annotation></semantics></math>, and <math id="A3.SS2.p1.m4" class="ltx_Math" alttext="j_{k}\in\mathcal{H}" display="inline" intent=":literal"><semantics><mrow><msub><mi>j</mi><mi>k</mi></msub><mo>∈</mo><mi class="ltx_font_mathcaligraphic">ℋ</mi></mrow><annotation encoding="application/x-tex">j_{k}\in\mathcal{H}</annotation></semantics></math> for any integer <math id="A3.SS2.p1.m5" class="ltx_Math" alttext="1\leq k\leq|\mathcal{H}|" display="inline" intent=":literal"><semantics><mrow><mn>1</mn><mo>≤</mo><mi>k</mi><mo>≤</mo><mrow><mo stretchy="false">|</mo><mi class="ltx_font_mathcaligraphic">ℋ</mi><mo stretchy="false">|</mo></mrow></mrow><annotation encoding="application/x-tex">1\leq k\leq|\mathcal{H}|</annotation></semantics></math>. Define <math id="A3.SS2.p1.m6" class="ltx_math_unparsed" alttext="V_{R_{\mathcal{H}}}^{\pi}(x)=\mathbb{E}_{y\sim\pi(\cdot|x)}R_{\mathcal{H}}(x,y)\in\mathbb{R}^{|\mathcal{H}|}" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>V</mi><msub><mi>R</mi><mi class="ltx_font_mathcaligraphic">ℋ</mi></msub><mi>π</mi></msubsup><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow><mo>=</mo><msub><mi>𝔼</mi><mrow><mi>y</mi><mo>∼</mo><mi>π</mi><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></msub><msub><mi>R</mi><mi class="ltx_font_mathcaligraphic">ℋ</mi></msub><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>y</mi><mo stretchy="false">)</mo></mrow><mo>∈</mo><msup><mi>ℝ</mi><mrow><mo stretchy="false">|</mo><mi class="ltx_font_mathcaligraphic">ℋ</mi><mo stretchy="false">|</mo></mrow></msup></mrow><annotation encoding="application/x-tex">V_{R_{\mathcal{H}}}^{\pi}(x)=\mathbb{E}_{y\sim\pi(\cdot|x)}R_{\mathcal{H}}(x,y)\in\mathbb{R}^{|\mathcal{H}|}</annotation></semantics></math>. By the definition of <math id="A3.SS2.p1.m7" class="ltx_Math" alttext="V_{S_{\lambda}}^{\pi}(x)" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>V</mi><msub><mi>S</mi><mi>λ</mi></msub><mi>π</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">V_{S_{\lambda}}^{\pi}(x)</annotation></semantics></math>, we have</p>
<table id="A3.Ex61" class="ltx_equationgroup ltx_eqn_table">

<tbody id="A3.Ex61X"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.Ex61X.m2" class="ltx_Math" alttext="\displaystyle V_{S_{\lambda}}^{\pi}(x)=" display="inline" intent=":literal"><semantics><mrow><mrow><msubsup><mi>V</mi><msub><mi>S</mi><mi>λ</mi></msub><mi>π</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mphantom></mphantom></mrow><annotation encoding="application/x-tex">\displaystyle V_{S_{\lambda}}^{\pi}(x)=</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex61X.m3" class="ltx_Math" alttext="\displaystyle\mathbb{E}_{y\sim\pi(\cdot|x)}S_{\lambda}(x,y)\quad\text{(by definition of $V_{S_{\lambda}}^{\pi}(x)$)}" display="inline" intent=":literal"><semantics><mrow><mi>𝔼</mi><msub><mrow></mrow><mrow><mi>y</mi><mo>∼</mo><mi>π</mi><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></msub><mi>S</mi><msub><mrow></mrow><mi>λ</mi></msub><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>y</mi><mo stretchy="false">)</mo><mrow><mtext>(by definition of </mtext><mrow><msubsup><mi>V</mi><msub><mi>S</mi><mi>λ</mi></msub><mi>π</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mtext>)</mtext></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\mathbb{E}_{y\sim\pi(\cdot|x)}S_{\lambda}(x,y)\quad\text{(by definition of $V_{S_{\lambda}}^{\pi}(x)$)}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A3.Ex61Xa"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.Ex61Xa.m2" class="ltx_Math" alttext="\displaystyle=" display="inline" intent=":literal"><semantics><mo>=</mo><annotation encoding="application/x-tex">\displaystyle=</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex61Xa.m3" class="ltx_Math" alttext="\displaystyle\mathbb{E}_{y\sim\pi(\cdot|x)}\left[\sum_{j\in\mathcal{S}}w_{j}R_{j}(x,y)+\sum_{j\in\mathcal{H}}\lambda_{j}R_{j}(x,y)\right]\quad\text{(by definition of $S_{\lambda}$)}" display="inline" intent=":literal"><semantics><mrow><mi>𝔼</mi><msub><mrow></mrow><mrow><mi>y</mi><mo>∼</mo><mi>π</mi><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></msub><mo>[</mo><mstyle displaystyle="true"><mo movablelimits="false">∑</mo></mstyle><msub><mrow></mrow><mrow><mi>j</mi><mo>∈</mo><mi class="ltx_font_mathcaligraphic">𝒮</mi></mrow></msub><mi>w</mi><msub><mrow></mrow><mi>j</mi></msub><mi>R</mi><msub><mrow></mrow><mi>j</mi></msub><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>y</mi><mo stretchy="false">)</mo><mo>+</mo><mstyle displaystyle="true"><mo movablelimits="false">∑</mo></mstyle><msub><mrow></mrow><mrow><mi>j</mi><mo>∈</mo><mi class="ltx_font_mathcaligraphic">ℋ</mi></mrow></msub><mi>λ</mi><msub><mrow></mrow><mi>j</mi></msub><mi>R</mi><msub><mrow></mrow><mi>j</mi></msub><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>y</mi><mo stretchy="false">)</mo><mo>]</mo><mrow><mtext>(by definition of </mtext><msub><mi>S</mi><mi>λ</mi></msub><mtext>)</mtext></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\mathbb{E}_{y\sim\pi(\cdot|x)}\left[\sum_{j\in\mathcal{S}}w_{j}R_{j}(x,y)+\sum_{j\in\mathcal{H}}\lambda_{j}R_{j}(x,y)\right]\quad\text{(by definition of $S_{\lambda}$)}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A3.Ex61Xb"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.Ex61Xb.m2" class="ltx_Math" alttext="\displaystyle=" display="inline" intent=":literal"><semantics><mo>=</mo><annotation encoding="application/x-tex">\displaystyle=</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex61Xb.m3" class="ltx_Math" alttext="\displaystyle\mathbb{E}_{y\sim\pi(\cdot|x)}\left[\sum_{j\in\mathcal{S}}w_{j}R_{j}(x,y))\right]+\sum_{j\in\mathcal{H}}\lambda_{j}\mathbb{E}_{y\sim\pi(\cdot|x)}\left[R_{j}(x,y)\right]" display="inline" intent=":literal"><semantics><mrow><mi>𝔼</mi><msub><mrow></mrow><mrow><mi>y</mi><mo>∼</mo><mi>π</mi><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></msub><mo>[</mo><mstyle displaystyle="true"><mo movablelimits="false">∑</mo></mstyle><msub><mrow></mrow><mrow><mi>j</mi><mo>∈</mo><mi class="ltx_font_mathcaligraphic">𝒮</mi></mrow></msub><mi>w</mi><msub><mrow></mrow><mi>j</mi></msub><mi>R</mi><msub><mrow></mrow><mi>j</mi></msub><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>y</mi><mo stretchy="false">)</mo><mo stretchy="false">)</mo><mo>]</mo><mo>+</mo><mstyle displaystyle="true"><mo movablelimits="false">∑</mo></mstyle><msub><mrow></mrow><mrow><mi>j</mi><mo>∈</mo><mi class="ltx_font_mathcaligraphic">ℋ</mi></mrow></msub><mi>λ</mi><msub><mrow></mrow><mi>j</mi></msub><mi>𝔼</mi><msub><mrow></mrow><mrow><mi>y</mi><mo>∼</mo><mi>π</mi><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></msub><mo>[</mo><mi>R</mi><msub><mrow></mrow><mi>j</mi></msub><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>y</mi><mo stretchy="false">)</mo><mo>]</mo></mrow><annotation encoding="application/x-tex">\displaystyle\mathbb{E}_{y\sim\pi(\cdot|x)}\left[\sum_{j\in\mathcal{S}}w_{j}R_{j}(x,y))\right]+\sum_{j\in\mathcal{H}}\lambda_{j}\mathbb{E}_{y\sim\pi(\cdot|x)}\left[R_{j}(x,y)\right]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A3.Ex61Xc"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.Ex61Xc.m2" class="ltx_Math" alttext="\displaystyle=" display="inline" intent=":literal"><semantics><mo>=</mo><annotation encoding="application/x-tex">\displaystyle=</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex61Xc.m3" class="ltx_Math" alttext="\displaystyle\mathbb{E}_{y\sim\pi(\cdot|x)}\left[\sum_{j\in\mathcal{S}}w_{j}R_{j}(x,y))\right]+\lambda^{T}V_{R_{\mathcal{H}}}^{\pi}(x)\quad\text{(by definition of $V_{R_{\mathcal{H}}}^{\pi}$)}" display="inline" intent=":literal"><semantics><mrow><mi>𝔼</mi><msub><mrow></mrow><mrow><mi>y</mi><mo>∼</mo><mi>π</mi><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></msub><mo>[</mo><mstyle displaystyle="true"><mo movablelimits="false">∑</mo></mstyle><msub><mrow></mrow><mrow><mi>j</mi><mo>∈</mo><mi class="ltx_font_mathcaligraphic">𝒮</mi></mrow></msub><mi>w</mi><msub><mrow></mrow><mi>j</mi></msub><mi>R</mi><msub><mrow></mrow><mi>j</mi></msub><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>y</mi><mo stretchy="false">)</mo><mo stretchy="false">)</mo><mo>]</mo><mo>+</mo><mi>λ</mi><msup><mrow></mrow><mi>T</mi></msup><mi>V</mi><msub><mrow></mrow><msub><mi>R</mi><mi class="ltx_font_mathcaligraphic">ℋ</mi></msub></msub><msup><mrow></mrow><mi>π</mi></msup><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo><mrow><mtext>(by definition of </mtext><msubsup><mi>V</mi><msub><mi>R</mi><mi class="ltx_font_mathcaligraphic">ℋ</mi></msub><mi>π</mi></msubsup><mtext>)</mtext></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\mathbb{E}_{y\sim\pi(\cdot|x)}\left[\sum_{j\in\mathcal{S}}w_{j}R_{j}(x,y))\right]+\lambda^{T}V_{R_{\mathcal{H}}}^{\pi}(x)\quad\text{(by definition of $V_{R_{\mathcal{H}}}^{\pi}$)}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A3.SS2.p1.4" class="ltx_p">Plugging the above expression of <math id="A3.SS2.p1.m8" class="ltx_Math" alttext="V_{S_{\lambda}}^{\pi}(x)" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>V</mi><msub><mi>S</mi><mi>λ</mi></msub><mi>π</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">V_{S_{\lambda}}^{\pi}(x)</annotation></semantics></math> into term <math id="A3.SS2.p1.m9" class="ltx_Math" alttext="\mathrm{B}" display="inline" intent=":literal"><semantics><mi>B</mi><annotation encoding="application/x-tex">\mathrm{B}</annotation></semantics></math>, we have</p>
<table id="A3.E38" class="ltx_equationgroup ltx_eqn_table">
<tbody>
<tr id="A3.E38X" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.E38X.m2" class="ltx_Math" alttext="\displaystyle\mathrm{B}=" display="inline" intent=":literal"><semantics><mrow><mi>B</mi><mo>=</mo><mphantom></mphantom></mrow><annotation encoding="application/x-tex">\displaystyle\mathrm{B}=</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.E38X.m3" class="ltx_Math" alttext="\displaystyle\mathbb{E}_{x\sim\mathcal{D}}\left[\left(\boldsymbol{\lambda}_{t}-\hat{\boldsymbol{\lambda}}_{t+1}\right)^{T}V_{R_{\mathcal{H}}}^{\pi_{t}}(x)+\left(\hat{\boldsymbol{\lambda}}_{t+1}-\boldsymbol{\lambda}^{\star}\right)^{T}V_{R_{\mathcal{H}}}^{\pi_{t}}(x)-\left(\boldsymbol{\lambda}_{t}-\hat{\boldsymbol{\lambda}}_{t+1}\right)^{T}V_{R_{\mathcal{H}}}^{\pi_{t-1}}(x)+\left(\boldsymbol{\lambda}_{t}-\hat{\boldsymbol{\lambda}}_{t+1}\right)^{T}V_{R_{\mathcal{H}}}^{\pi_{t-1}}(x)\right]" display="inline" intent=":literal"><semantics><mrow><msub><mi>𝔼</mi><mrow><mi>x</mi><mo>∼</mo><mi class="ltx_font_mathcaligraphic">𝒟</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><mrow><mrow><mrow><mrow><msup><mrow><mo>(</mo><mrow><msub><mi>𝝀</mi><mi>t</mi></msub><mo>−</mo><msub><mover accent="true"><mi>𝝀</mi><mo>^</mo></mover><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow></msub></mrow><mo>)</mo></mrow><mi>T</mi></msup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>V</mi><msub><mi>R</mi><mi class="ltx_font_mathcaligraphic">ℋ</mi></msub><msub><mi>π</mi><mi>t</mi></msub></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mrow><msup><mrow><mo>(</mo><mrow><msub><mover accent="true"><mi>𝝀</mi><mo>^</mo></mover><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow></msub><mo>−</mo><msup><mi>𝝀</mi><mo>⋆</mo></msup></mrow><mo>)</mo></mrow><mi>T</mi></msup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>V</mi><msub><mi>R</mi><mi class="ltx_font_mathcaligraphic">ℋ</mi></msub><msub><mi>π</mi><mi>t</mi></msub></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>−</mo><mrow><msup><mrow><mo>(</mo><mrow><msub><mi>𝝀</mi><mi>t</mi></msub><mo>−</mo><msub><mover accent="true"><mi>𝝀</mi><mo>^</mo></mover><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow></msub></mrow><mo>)</mo></mrow><mi>T</mi></msup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>V</mi><msub><mi>R</mi><mi class="ltx_font_mathcaligraphic">ℋ</mi></msub><msub><mi>π</mi><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow></msub></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>+</mo><mrow><msup><mrow><mo>(</mo><mrow><msub><mi>𝝀</mi><mi>t</mi></msub><mo>−</mo><msub><mover accent="true"><mi>𝝀</mi><mo>^</mo></mover><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow></msub></mrow><mo>)</mo></mrow><mi>T</mi></msup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>V</mi><msub><mi>R</mi><mi class="ltx_font_mathcaligraphic">ℋ</mi></msub><msub><mi>π</mi><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow></msub></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>]</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\mathbb{E}_{x\sim\mathcal{D}}\left[\left(\boldsymbol{\lambda}_{t}-\hat{\boldsymbol{\lambda}}_{t+1}\right)^{T}V_{R_{\mathcal{H}}}^{\pi_{t}}(x)+\left(\hat{\boldsymbol{\lambda}}_{t+1}-\boldsymbol{\lambda}^{\star}\right)^{T}V_{R_{\mathcal{H}}}^{\pi_{t}}(x)-\left(\boldsymbol{\lambda}_{t}-\hat{\boldsymbol{\lambda}}_{t+1}\right)^{T}V_{R_{\mathcal{H}}}^{\pi_{t-1}}(x)+\left(\boldsymbol{\lambda}_{t}-\hat{\boldsymbol{\lambda}}_{t+1}\right)^{T}V_{R_{\mathcal{H}}}^{\pi_{t-1}}(x)\right]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="4" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equationgroup ltx_align_right">(38)</span></td></tr>
<tr id="A3.E38Xa" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.E38Xa.m2" class="ltx_Math" alttext="\displaystyle=" display="inline" intent=":literal"><semantics><mo>=</mo><annotation encoding="application/x-tex">\displaystyle=</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.E38Xa.m3" class="ltx_Math" alttext="\displaystyle\mathbb{E}_{x\sim\mathcal{D}}\left[\left(\hat{\boldsymbol{\lambda}}_{t+1}-\boldsymbol{\lambda}^{\star}\right)^{T}V_{R_{\mathcal{H}}}^{\pi_{t}}(x)+\left(\boldsymbol{\lambda}_{t}-\hat{\boldsymbol{\lambda}}_{t+1}\right)^{T}V_{R_{\mathcal{H}}}^{\pi_{t-1}}(x)+\left(\boldsymbol{\lambda}_{t}-\hat{\boldsymbol{\lambda}}_{t+1}\right)^{T}\left(V_{R_{\mathcal{H}}}^{\pi_{t}}(x)-V_{R_{\mathcal{H}}}^{\pi_{t-1}}(x)\right)\right]" display="inline" intent=":literal"><semantics><mrow><msub><mi>𝔼</mi><mrow><mi>x</mi><mo>∼</mo><mi class="ltx_font_mathcaligraphic">𝒟</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><mrow><mrow><msup><mrow><mo>(</mo><mrow><msub><mover accent="true"><mi>𝝀</mi><mo>^</mo></mover><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow></msub><mo>−</mo><msup><mi>𝝀</mi><mo>⋆</mo></msup></mrow><mo>)</mo></mrow><mi>T</mi></msup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>V</mi><msub><mi>R</mi><mi class="ltx_font_mathcaligraphic">ℋ</mi></msub><msub><mi>π</mi><mi>t</mi></msub></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mrow><msup><mrow><mo>(</mo><mrow><msub><mi>𝝀</mi><mi>t</mi></msub><mo>−</mo><msub><mover accent="true"><mi>𝝀</mi><mo>^</mo></mover><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow></msub></mrow><mo>)</mo></mrow><mi>T</mi></msup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>V</mi><msub><mi>R</mi><mi class="ltx_font_mathcaligraphic">ℋ</mi></msub><msub><mi>π</mi><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow></msub></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mrow><msup><mrow><mo>(</mo><mrow><msub><mi>𝝀</mi><mi>t</mi></msub><mo>−</mo><msub><mover accent="true"><mi>𝝀</mi><mo>^</mo></mover><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow></msub></mrow><mo>)</mo></mrow><mi>T</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mrow><msubsup><mi>V</mi><msub><mi>R</mi><mi class="ltx_font_mathcaligraphic">ℋ</mi></msub><msub><mi>π</mi><mi>t</mi></msub></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msubsup><mi>V</mi><msub><mi>R</mi><mi class="ltx_font_mathcaligraphic">ℋ</mi></msub><msub><mi>π</mi><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow></msub></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>)</mo></mrow></mrow></mrow><mo>]</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\mathbb{E}_{x\sim\mathcal{D}}\left[\left(\hat{\boldsymbol{\lambda}}_{t+1}-\boldsymbol{\lambda}^{\star}\right)^{T}V_{R_{\mathcal{H}}}^{\pi_{t}}(x)+\left(\boldsymbol{\lambda}_{t}-\hat{\boldsymbol{\lambda}}_{t+1}\right)^{T}V_{R_{\mathcal{H}}}^{\pi_{t-1}}(x)+\left(\boldsymbol{\lambda}_{t}-\hat{\boldsymbol{\lambda}}_{t+1}\right)^{T}\left(V_{R_{\mathcal{H}}}^{\pi_{t}}(x)-V_{R_{\mathcal{H}}}^{\pi_{t-1}}(x)\right)\right]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr>
<tr id="A3.E38Xb" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.E38Xb.m2" class="ltx_Math" alttext="\displaystyle=" display="inline" intent=":literal"><semantics><mo>=</mo><annotation encoding="application/x-tex">\displaystyle=</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.E38Xb.m3" class="ltx_Math" alttext="\displaystyle\left(\hat{\boldsymbol{\lambda}}_{t+1}-\boldsymbol{\lambda}^{\star}\right)^{T}\mathbb{E}_{x\sim\mathcal{D}}\left[V_{R_{\mathcal{H}}}^{\pi_{t}}(x)\right]+\left(\boldsymbol{\lambda}_{t}-\hat{\boldsymbol{\lambda}}_{t+1}\right)^{T}\mathbb{E}_{x\sim\mathcal{D}}\left[V_{R_{\mathcal{H}}}^{\pi_{t-1}}(x)\right]" display="inline" intent=":literal"><semantics><mrow><mrow><msup><mrow><mo>(</mo><mrow><msub><mover accent="true"><mi>𝝀</mi><mo>^</mo></mover><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow></msub><mo>−</mo><msup><mi>𝝀</mi><mo>⋆</mo></msup></mrow><mo>)</mo></mrow><mi>T</mi></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝔼</mi><mrow><mi>x</mi><mo>∼</mo><mi class="ltx_font_mathcaligraphic">𝒟</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><mrow><msubsup><mi>V</mi><msub><mi>R</mi><mi class="ltx_font_mathcaligraphic">ℋ</mi></msub><msub><mi>π</mi><mi>t</mi></msub></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo>]</mo></mrow></mrow><mo>+</mo><mrow><msup><mrow><mo>(</mo><mrow><msub><mi>𝝀</mi><mi>t</mi></msub><mo>−</mo><msub><mover accent="true"><mi>𝝀</mi><mo>^</mo></mover><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow></msub></mrow><mo>)</mo></mrow><mi>T</mi></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝔼</mi><mrow><mi>x</mi><mo>∼</mo><mi class="ltx_font_mathcaligraphic">𝒟</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><mrow><msubsup><mi>V</mi><msub><mi>R</mi><mi class="ltx_font_mathcaligraphic">ℋ</mi></msub><msub><mi>π</mi><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow></msub></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo>]</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\left(\hat{\boldsymbol{\lambda}}_{t+1}-\boldsymbol{\lambda}^{\star}\right)^{T}\mathbb{E}_{x\sim\mathcal{D}}\left[V_{R_{\mathcal{H}}}^{\pi_{t}}(x)\right]+\left(\boldsymbol{\lambda}_{t}-\hat{\boldsymbol{\lambda}}_{t+1}\right)^{T}\mathbb{E}_{x\sim\mathcal{D}}\left[V_{R_{\mathcal{H}}}^{\pi_{t-1}}(x)\right]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr>
<tr id="A3.E38Xc" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.E38Xc.m2" class="ltx_Math" alttext="\displaystyle+\left(\boldsymbol{\lambda}_{t}-\hat{\boldsymbol{\lambda}}_{t+1}\right)^{T}\left(\mathbb{E}_{x\sim\mathcal{D}}\left[V_{R_{\mathcal{H}}}^{\pi_{t}}(x)\right]-\mathbb{E}_{x\sim\mathcal{D}}\left[V_{R_{\mathcal{H}}}^{\pi_{t-1}}(x)\right]\right)" display="inline" intent=":literal"><semantics><mrow><mo>+</mo><mrow><msup><mrow><mo>(</mo><mrow><msub><mi>𝝀</mi><mi>t</mi></msub><mo>−</mo><msub><mover accent="true"><mi>𝝀</mi><mo>^</mo></mover><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow></msub></mrow><mo>)</mo></mrow><mi>T</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mrow><msub><mi>𝔼</mi><mrow><mi>x</mi><mo>∼</mo><mi class="ltx_font_mathcaligraphic">𝒟</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><mrow><msubsup><mi>V</mi><msub><mi>R</mi><mi class="ltx_font_mathcaligraphic">ℋ</mi></msub><msub><mi>π</mi><mi>t</mi></msub></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo>]</mo></mrow></mrow><mo>−</mo><mrow><msub><mi>𝔼</mi><mrow><mi>x</mi><mo>∼</mo><mi class="ltx_font_mathcaligraphic">𝒟</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><mrow><msubsup><mi>V</mi><msub><mi>R</mi><mi class="ltx_font_mathcaligraphic">ℋ</mi></msub><msub><mi>π</mi><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow></msub></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo>]</mo></mrow></mrow></mrow><mo>)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle+\left(\boldsymbol{\lambda}_{t}-\hat{\boldsymbol{\lambda}}_{t+1}\right)^{T}\left(\mathbb{E}_{x\sim\mathcal{D}}\left[V_{R_{\mathcal{H}}}^{\pi_{t}}(x)\right]-\mathbb{E}_{x\sim\mathcal{D}}\left[V_{R_{\mathcal{H}}}^{\pi_{t-1}}(x)\right]\right)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="A3.SS2.p2" class="ltx_para">
<p id="A3.SS2.p2.3" class="ltx_p">By <a href="#A2.Thmtheorem5" title="Lemma B.5. ‣ Appendix B Useful Lemmas ‣ Provable Last-Iterate Convergence for Multi-Objective Safe LLM Alignment via Optimistic Primal-Dual" class="ltx_ref"><span class="ltx_text ltx_ref_tag">lemma</span> <span class="ltx_text ltx_ref_tag">B.5</span></a>, <math id="A3.SS2.p2.m1" class="ltx_Math" alttext="\lambda^{*}\geq 0" display="inline" intent=":literal"><semantics><mrow><msup><mi>λ</mi><mo>∗</mo></msup><mo>≥</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\lambda^{*}\geq 0</annotation></semantics></math>.
Without loss of generality, for a vector <math id="A3.SS2.p2.m2" class="ltx_Math" alttext="\mathbf{a}" display="inline" intent=":literal"><semantics><mi>𝐚</mi><annotation encoding="application/x-tex">\mathbf{a}</annotation></semantics></math>, we write <math id="A3.SS2.p2.m3" class="ltx_Math" alttext="\mathbf{a}\geq 0" display="inline" intent=":literal"><semantics><mrow><mi>𝐚</mi><mo>≥</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\mathbf{a}\geq 0</annotation></semantics></math> to indicate that all entries of <math id="A3.SS2.p2.m4" class="ltx_Math" alttext="\mathbf{a}" display="inline" intent=":literal"><semantics><mi>𝐚</mi><annotation encoding="application/x-tex">\mathbf{a}</annotation></semantics></math> are nonnegative.
Recall <a href="#S3.E7" title="In 5 ‣ Algorithm 2 ‣ 3.1 OPD in Distribution Space ‣ 3 Optimistic Primal–Dual Method ‣ Provable Last-Iterate Convergence for Multi-Objective Safe LLM Alignment via Optimistic Primal-Dual" class="ltx_ref"><span class="ltx_text ltx_ref_tag">eq.</span> <span class="ltx_text ltx_ref_tag">7</span></a> gives the <math id="A3.SS2.p2.m5" class="ltx_Math" alttext="\hat{\lambda}_{t+1,j}" display="inline" intent=":literal"><semantics><msub><mover accent="true"><mi>λ</mi><mo>^</mo></mover><mrow><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow><mo>,</mo><mi>j</mi></mrow></msub><annotation encoding="application/x-tex">\hat{\lambda}_{t+1,j}</annotation></semantics></math> in the optimistic gradient descent, and we rewrite the update as follows</p>
<table id="A3.Ex62" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A3.Ex62.m1" class="ltx_math_unparsed" alttext="\hat{\lambda}_{t+1,j}=\arg\min_{\lambda\geq 0}\lambda\mathbb{E}_{x\sim\mathcal{D},y\sim\pi_{t}(\cdot|x)}\big[R_{j}(x,y)\big]+\eta_{\lambda}\big(\lambda-\hat{\lambda}_{t,j}\big)^{2}." display="block" intent=":literal"><semantics><mrow><msub><mover accent="true"><mi>λ</mi><mo>^</mo></mover><mrow><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow><mo>,</mo><mi>j</mi></mrow></msub><mo>=</mo><mi>arg</mi><munder><mi>min</mi><mrow><mi>λ</mi><mo>≥</mo><mn>0</mn></mrow></munder><mi>λ</mi><msub><mi>𝔼</mi><mrow><mi>x</mi><mo>∼</mo><mi class="ltx_font_mathcaligraphic">𝒟</mi><mo>,</mo><mi>y</mi><mo>∼</mo><mi>π</mi><msub><mrow></mrow><mi>t</mi></msub><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></msub><mrow><mo maxsize="1.200em" minsize="1.200em">[</mo><msub><mi>R</mi><mi>j</mi></msub><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>y</mi><mo stretchy="false">)</mo></mrow><mo maxsize="1.200em" minsize="1.200em">]</mo></mrow><mo>+</mo><msub><mi>η</mi><mi>λ</mi></msub><msup><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mi>λ</mi><mo>−</mo><msub><mover accent="true"><mi>λ</mi><mo>^</mo></mover><mrow><mi>t</mi><mo>,</mo><mi>j</mi></mrow></msub><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow><mn>2</mn></msup><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\hat{\lambda}_{t+1,j}=\arg\min_{\lambda\geq 0}\lambda\mathbb{E}_{x\sim\mathcal{D},y\sim\pi_{t}(\cdot|x)}\big[R_{j}(x,y)\big]+\eta_{\lambda}\big(\lambda-\hat{\lambda}_{t,j}\big)^{2}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A3.SS2.p2.4" class="ltx_p">Rewrite the above update in the vectorized form as follows</p>
<table id="A3.Ex63" class="ltx_equationgroup ltx_eqn_table">

<tbody id="A3.Ex63X"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.Ex63X.m2" class="ltx_Math" alttext="\displaystyle\hat{\boldsymbol{\lambda}}_{t+1}=" display="inline" intent=":literal"><semantics><mrow><msub><mover accent="true"><mi>𝝀</mi><mo>^</mo></mover><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow></msub><mo>=</mo><mphantom></mphantom></mrow><annotation encoding="application/x-tex">\displaystyle\hat{\boldsymbol{\lambda}}_{t+1}=</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex63X.m3" class="ltx_Math" alttext="\displaystyle\arg\min_{\boldsymbol{\lambda}\geq 0}\boldsymbol{\lambda}^{T}\mathbb{E}_{x\sim\mathcal{D}}\big[V_{R_{\mathcal{H}}}^{\pi_{t}}(x)\big]+\eta_{\lambda}\|\boldsymbol{\lambda}-\hat{\boldsymbol{\lambda}}_{t}\|_{2}^{2}" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mi>arg</mi><mo lspace="0.167em">⁡</mo><munder><mi>min</mi><mrow><mi>𝝀</mi><mo>≥</mo><mn>0</mn></mrow></munder></mrow><mo lspace="0.167em" rspace="0em">​</mo><msup><mi>𝝀</mi><mi>T</mi></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝔼</mi><mrow><mi>x</mi><mo>∼</mo><mi class="ltx_font_mathcaligraphic">𝒟</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="1.200em" minsize="1.200em">[</mo><mrow><msubsup><mi>V</mi><msub><mi>R</mi><mi class="ltx_font_mathcaligraphic">ℋ</mi></msub><msub><mi>π</mi><mi>t</mi></msub></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo maxsize="1.200em" minsize="1.200em">]</mo></mrow></mrow><mo>+</mo><mrow><msub><mi>η</mi><mi>λ</mi></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mrow><mo stretchy="false">‖</mo><mrow><mi>𝝀</mi><mo>−</mo><msub><mover accent="true"><mi>𝝀</mi><mo>^</mo></mover><mi>t</mi></msub></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn><mn>2</mn></msubsup></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\arg\min_{\boldsymbol{\lambda}\geq 0}\boldsymbol{\lambda}^{T}\mathbb{E}_{x\sim\mathcal{D}}\big[V_{R_{\mathcal{H}}}^{\pi_{t}}(x)\big]+\eta_{\lambda}\|\boldsymbol{\lambda}-\hat{\boldsymbol{\lambda}}_{t}\|_{2}^{2}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A3.Ex63Xa"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.Ex63Xa.m2" class="ltx_Math" alttext="\displaystyle=" display="inline" intent=":literal"><semantics><mo>=</mo><annotation encoding="application/x-tex">\displaystyle=</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex63Xa.m3" class="ltx_Math" alttext="\displaystyle\arg\max_{\boldsymbol{\lambda}\geq 0}-\boldsymbol{\lambda}^{T}\mathbb{E}_{x\sim\mathcal{D}}\big[V_{R_{\mathcal{H}}}^{\pi_{t}}(x)\big]-\eta_{\lambda}\|\boldsymbol{\lambda}-\hat{\boldsymbol{\lambda}}_{t}\|_{2}^{2}." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mi>arg</mi><mo lspace="0.167em">⁡</mo><munder><mi>max</mi><mrow><mi>𝝀</mi><mo>≥</mo><mn>0</mn></mrow></munder></mrow><mo lspace="0em">−</mo><mrow><msup><mi>𝝀</mi><mi>T</mi></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝔼</mi><mrow><mi>x</mi><mo>∼</mo><mi class="ltx_font_mathcaligraphic">𝒟</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="1.200em" minsize="1.200em">[</mo><mrow><msubsup><mi>V</mi><msub><mi>R</mi><mi class="ltx_font_mathcaligraphic">ℋ</mi></msub><msub><mi>π</mi><mi>t</mi></msub></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo maxsize="1.200em" minsize="1.200em">]</mo></mrow></mrow><mo>−</mo><mrow><msub><mi>η</mi><mi>λ</mi></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mrow><mo stretchy="false">‖</mo><mrow><mi>𝝀</mi><mo>−</mo><msub><mover accent="true"><mi>𝝀</mi><mo>^</mo></mover><mi>t</mi></msub></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn><mn>2</mn></msubsup></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\arg\max_{\boldsymbol{\lambda}\geq 0}-\boldsymbol{\lambda}^{T}\mathbb{E}_{x\sim\mathcal{D}}\big[V_{R_{\mathcal{H}}}^{\pi_{t}}(x)\big]-\eta_{\lambda}\|\boldsymbol{\lambda}-\hat{\boldsymbol{\lambda}}_{t}\|_{2}^{2}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A3.SS2.p2.5" class="ltx_p">Let <math id="A3.SS2.p2.m6" class="ltx_Math" alttext="\Omega=\mathbb{R}_{+}^{|\mathcal{H}|}" display="inline" intent=":literal"><semantics><mrow><mi mathvariant="normal">Ω</mi><mo>=</mo><msubsup><mi>ℝ</mi><mo>+</mo><mrow><mo stretchy="false">|</mo><mi class="ltx_font_mathcaligraphic">ℋ</mi><mo stretchy="false">|</mo></mrow></msubsup></mrow><annotation encoding="application/x-tex">\Omega=\mathbb{R}_{+}^{|\mathcal{H}|}</annotation></semantics></math>, <math id="A3.SS2.p2.m7" class="ltx_Math" alttext="g=-\mathbb{E}_{x\sim\mathcal{D}}\big[V_{R_{\mathcal{H}}}^{\pi_{t}}(x)\big]" display="inline" intent=":literal"><semantics><mrow><mi>g</mi><mo>=</mo><mrow><mo>−</mo><mrow><msub><mi>𝔼</mi><mrow><mi>x</mi><mo>∼</mo><mi class="ltx_font_mathcaligraphic">𝒟</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="1.200em" minsize="1.200em">[</mo><mrow><msubsup><mi>V</mi><msub><mi>R</mi><mi class="ltx_font_mathcaligraphic">ℋ</mi></msub><msub><mi>π</mi><mi>t</mi></msub></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo maxsize="1.200em" minsize="1.200em">]</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">g=-\mathbb{E}_{x\sim\mathcal{D}}\big[V_{R_{\mathcal{H}}}^{\pi_{t}}(x)\big]</annotation></semantics></math>, <math id="A3.SS2.p2.m8" class="ltx_Math" alttext="\eta=\eta_{\lambda}" display="inline" intent=":literal"><semantics><mrow><mi>η</mi><mo>=</mo><msub><mi>η</mi><mi>λ</mi></msub></mrow><annotation encoding="application/x-tex">\eta=\eta_{\lambda}</annotation></semantics></math>, <math id="A3.SS2.p2.m9" class="ltx_Math" alttext="h(\mathbf{x})=\|\mathbf{x}\|_{2}^{2}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>h</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝐱</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><msubsup><mrow><mo stretchy="false">‖</mo><mi>𝐱</mi><mo stretchy="false">‖</mo></mrow><mn>2</mn><mn>2</mn></msubsup></mrow><annotation encoding="application/x-tex">h(\mathbf{x})=\|\mathbf{x}\|_{2}^{2}</annotation></semantics></math>, <math id="A3.SS2.p2.m10" class="ltx_Math" alttext="D_{h}(\mathbf{x},\mathbf{y})=\|\mathbf{x}-\mathbf{y}\|_{2}^{2}" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>D</mi><mi>h</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐱</mi><mo>,</mo><mi>𝐲</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><msubsup><mrow><mo stretchy="false">‖</mo><mrow><mi>𝐱</mi><mo>−</mo><mi>𝐲</mi></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn><mn>2</mn></msubsup></mrow><annotation encoding="application/x-tex">D_{h}(\mathbf{x},\mathbf{y})=\|\mathbf{x}-\mathbf{y}\|_{2}^{2}</annotation></semantics></math>, <math id="A3.SS2.p2.m11" class="ltx_Math" alttext="\mathbf{x}^{\prime}=\boldsymbol{\lambda}^{\star}" display="inline" intent=":literal"><semantics><mrow><msup><mi>𝐱</mi><mo>′</mo></msup><mo>=</mo><msup><mi>𝝀</mi><mo>⋆</mo></msup></mrow><annotation encoding="application/x-tex">\mathbf{x}^{\prime}=\boldsymbol{\lambda}^{\star}</annotation></semantics></math>, <math id="A3.SS2.p2.m12" class="ltx_Math" alttext="\mathbf{x}_{\mathrm{new}}=\hat{\boldsymbol{\lambda}}_{t+1}" display="inline" intent=":literal"><semantics><mrow><msub><mi>𝐱</mi><mi>new</mi></msub><mo>=</mo><msub><mover accent="true"><mi>𝝀</mi><mo>^</mo></mover><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow></msub></mrow><annotation encoding="application/x-tex">\mathbf{x}_{\mathrm{new}}=\hat{\boldsymbol{\lambda}}_{t+1}</annotation></semantics></math>, <math id="A3.SS2.p2.m13" class="ltx_Math" alttext="\mathbf{x}_{\mathrm{old}}=\hat{\boldsymbol{\lambda}}_{t}" display="inline" intent=":literal"><semantics><mrow><msub><mi>𝐱</mi><mi>old</mi></msub><mo>=</mo><msub><mover accent="true"><mi>𝝀</mi><mo>^</mo></mover><mi>t</mi></msub></mrow><annotation encoding="application/x-tex">\mathbf{x}_{\mathrm{old}}=\hat{\boldsymbol{\lambda}}_{t}</annotation></semantics></math> in <a href="#A2.Thmtheorem9" title="Lemma B.9. ‣ Appendix B Useful Lemmas ‣ Provable Last-Iterate Convergence for Multi-Objective Safe LLM Alignment via Optimistic Primal-Dual" class="ltx_ref"><span class="ltx_text ltx_ref_tag">lemma</span> <span class="ltx_text ltx_ref_tag">B.9</span></a>, then we have</p>
<table id="A3.Ex64" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A3.Ex64.m1" class="ltx_Math" alttext="\langle-\mathbb{E}_{x\sim\mathcal{D}}\big[V_{R_{\mathcal{H}}}^{\pi_{t}}(x)\big],\hat{\boldsymbol{\lambda}}_{t+1}-\boldsymbol{\lambda}^{\star}\rangle\geq\eta_{\lambda}\left(-\|\boldsymbol{\lambda}^{\star}-\hat{\boldsymbol{\lambda}}_{t}\|_{2}^{2}+\|\boldsymbol{\lambda}^{\star}-\hat{\boldsymbol{\lambda}}_{t+1}\|_{2}^{2}+\|\hat{\boldsymbol{\lambda}}_{t+1}-\hat{\boldsymbol{\lambda}}_{t}\|_{2}^{2}\right)." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mo stretchy="false">⟨</mo><mrow><mrow><mo>−</mo><mrow><msub><mi>𝔼</mi><mrow><mi>x</mi><mo>∼</mo><mi class="ltx_font_mathcaligraphic">𝒟</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="1.200em" minsize="1.200em">[</mo><mrow><msubsup><mi>V</mi><msub><mi>R</mi><mi class="ltx_font_mathcaligraphic">ℋ</mi></msub><msub><mi>π</mi><mi>t</mi></msub></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo maxsize="1.200em" minsize="1.200em">]</mo></mrow></mrow></mrow><mo>,</mo><mrow><msub><mover accent="true"><mi>𝝀</mi><mo>^</mo></mover><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow></msub><mo>−</mo><msup><mi>𝝀</mi><mo>⋆</mo></msup></mrow></mrow><mo stretchy="false">⟩</mo></mrow><mo>≥</mo><mrow><msub><mi>η</mi><mi>λ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mrow><mo>−</mo><msubsup><mrow><mo stretchy="false">‖</mo><mrow><msup><mi>𝝀</mi><mo>⋆</mo></msup><mo>−</mo><msub><mover accent="true"><mi>𝝀</mi><mo>^</mo></mover><mi>t</mi></msub></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn><mn>2</mn></msubsup></mrow><mo>+</mo><msubsup><mrow><mo stretchy="false">‖</mo><mrow><msup><mi>𝝀</mi><mo>⋆</mo></msup><mo>−</mo><msub><mover accent="true"><mi>𝝀</mi><mo>^</mo></mover><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow></msub></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn><mn>2</mn></msubsup><mo>+</mo><msubsup><mrow><mo stretchy="false">‖</mo><mrow><msub><mover accent="true"><mi>𝝀</mi><mo>^</mo></mover><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow></msub><mo>−</mo><msub><mover accent="true"><mi>𝝀</mi><mo>^</mo></mover><mi>t</mi></msub></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn><mn>2</mn></msubsup></mrow><mo>)</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\langle-\mathbb{E}_{x\sim\mathcal{D}}\big[V_{R_{\mathcal{H}}}^{\pi_{t}}(x)\big],\hat{\boldsymbol{\lambda}}_{t+1}-\boldsymbol{\lambda}^{\star}\rangle\geq\eta_{\lambda}\left(-\|\boldsymbol{\lambda}^{\star}-\hat{\boldsymbol{\lambda}}_{t}\|_{2}^{2}+\|\boldsymbol{\lambda}^{\star}-\hat{\boldsymbol{\lambda}}_{t+1}\|_{2}^{2}+\|\hat{\boldsymbol{\lambda}}_{t+1}-\hat{\boldsymbol{\lambda}}_{t}\|_{2}^{2}\right).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A3.SS2.p2.6" class="ltx_p">Putting a negative sign on both sides, we have</p>
<table id="A3.E39" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A3.E39.m1" class="ltx_Math" alttext="\langle\hat{\boldsymbol{\lambda}}_{t+1}-\boldsymbol{\lambda}^{\star},\mathbb{E}_{x\sim\mathcal{D}}\big[V_{R_{\mathcal{H}}}^{\pi_{t}}(x)\big]\rangle\leq\eta_{\lambda}\left(\|\boldsymbol{\lambda}^{\star}-\hat{\boldsymbol{\lambda}}_{t}\|_{2}^{2}-\|\boldsymbol{\lambda}^{\star}-\hat{\boldsymbol{\lambda}}_{t+1}\|_{2}^{2}-\|\hat{\boldsymbol{\lambda}}_{t+1}-\hat{\boldsymbol{\lambda}}_{t}\|_{2}^{2}\right)." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mo stretchy="false">⟨</mo><mrow><mrow><msub><mover accent="true"><mi>𝝀</mi><mo>^</mo></mover><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow></msub><mo>−</mo><msup><mi>𝝀</mi><mo>⋆</mo></msup></mrow><mo>,</mo><mrow><msub><mi>𝔼</mi><mrow><mi>x</mi><mo>∼</mo><mi class="ltx_font_mathcaligraphic">𝒟</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="1.200em" minsize="1.200em">[</mo><mrow><msubsup><mi>V</mi><msub><mi>R</mi><mi class="ltx_font_mathcaligraphic">ℋ</mi></msub><msub><mi>π</mi><mi>t</mi></msub></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo maxsize="1.200em" minsize="1.200em">]</mo></mrow></mrow></mrow><mo stretchy="false">⟩</mo></mrow><mo>≤</mo><mrow><msub><mi>η</mi><mi>λ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><msubsup><mrow><mo stretchy="false">‖</mo><mrow><msup><mi>𝝀</mi><mo>⋆</mo></msup><mo>−</mo><msub><mover accent="true"><mi>𝝀</mi><mo>^</mo></mover><mi>t</mi></msub></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn><mn>2</mn></msubsup><mo>−</mo><msubsup><mrow><mo stretchy="false">‖</mo><mrow><msup><mi>𝝀</mi><mo>⋆</mo></msup><mo>−</mo><msub><mover accent="true"><mi>𝝀</mi><mo>^</mo></mover><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow></msub></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn><mn>2</mn></msubsup><mo>−</mo><msubsup><mrow><mo stretchy="false">‖</mo><mrow><msub><mover accent="true"><mi>𝝀</mi><mo>^</mo></mover><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow></msub><mo>−</mo><msub><mover accent="true"><mi>𝝀</mi><mo>^</mo></mover><mi>t</mi></msub></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn><mn>2</mn></msubsup></mrow><mo>)</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\langle\hat{\boldsymbol{\lambda}}_{t+1}-\boldsymbol{\lambda}^{\star},\mathbb{E}_{x\sim\mathcal{D}}\big[V_{R_{\mathcal{H}}}^{\pi_{t}}(x)\big]\rangle\leq\eta_{\lambda}\left(\|\boldsymbol{\lambda}^{\star}-\hat{\boldsymbol{\lambda}}_{t}\|_{2}^{2}-\|\boldsymbol{\lambda}^{\star}-\hat{\boldsymbol{\lambda}}_{t+1}\|_{2}^{2}-\|\hat{\boldsymbol{\lambda}}_{t+1}-\hat{\boldsymbol{\lambda}}_{t}\|_{2}^{2}\right).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(39)</span></td></tr></tbody>
</table>
<p id="A3.SS2.p2.7" class="ltx_p">Similarly, since <a href="#S3.E5" title="In 3 ‣ Algorithm 2 ‣ 3.1 OPD in Distribution Space ‣ 3 Optimistic Primal–Dual Method ‣ Provable Last-Iterate Convergence for Multi-Objective Safe LLM Alignment via Optimistic Primal-Dual" class="ltx_ref"><span class="ltx_text ltx_ref_tag">eq.</span> <span class="ltx_text ltx_ref_tag">5</span></a> gives the optimistic update of <math id="A3.SS2.p2.m14" class="ltx_Math" alttext="\lambda_{t,j}" display="inline" intent=":literal"><semantics><msub><mi>λ</mi><mrow><mi>t</mi><mo>,</mo><mi>j</mi></mrow></msub><annotation encoding="application/x-tex">\lambda_{t,j}</annotation></semantics></math> as follows,</p>
<table id="A3.Ex65" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A3.Ex65.m1" class="ltx_math_unparsed" alttext="\lambda_{t,j}=\arg\min_{\lambda\geq 0}\lambda\mathbb{E}_{x\sim\mathcal{D},y\sim\pi_{t-1}(\cdot|x)}\big[R_{j}(x,y)\big]+\eta_{\lambda}\big(\lambda-\hat{\lambda}_{t,j}\big)^{2}," display="block" intent=":literal"><semantics><mrow><msub><mi>λ</mi><mrow><mi>t</mi><mo>,</mo><mi>j</mi></mrow></msub><mo>=</mo><mi>arg</mi><munder><mi>min</mi><mrow><mi>λ</mi><mo>≥</mo><mn>0</mn></mrow></munder><mi>λ</mi><msub><mi>𝔼</mi><mrow><mi>x</mi><mo>∼</mo><mi class="ltx_font_mathcaligraphic">𝒟</mi><mo>,</mo><mi>y</mi><mo>∼</mo><mi>π</mi><msub><mrow></mrow><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow></msub><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></msub><mrow><mo maxsize="1.200em" minsize="1.200em">[</mo><msub><mi>R</mi><mi>j</mi></msub><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>y</mi><mo stretchy="false">)</mo></mrow><mo maxsize="1.200em" minsize="1.200em">]</mo></mrow><mo>+</mo><msub><mi>η</mi><mi>λ</mi></msub><msup><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mi>λ</mi><mo>−</mo><msub><mover accent="true"><mi>λ</mi><mo>^</mo></mover><mrow><mi>t</mi><mo>,</mo><mi>j</mi></mrow></msub><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow><mn>2</mn></msup><mo>,</mo></mrow><annotation encoding="application/x-tex">\lambda_{t,j}=\arg\min_{\lambda\geq 0}\lambda\mathbb{E}_{x\sim\mathcal{D},y\sim\pi_{t-1}(\cdot|x)}\big[R_{j}(x,y)\big]+\eta_{\lambda}\big(\lambda-\hat{\lambda}_{t,j}\big)^{2},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A3.SS2.p2.8" class="ltx_p">Applying <a href="#A2.Thmtheorem9" title="Lemma B.9. ‣ Appendix B Useful Lemmas ‣ Provable Last-Iterate Convergence for Multi-Objective Safe LLM Alignment via Optimistic Primal-Dual" class="ltx_ref"><span class="ltx_text ltx_ref_tag">lemma</span> <span class="ltx_text ltx_ref_tag">B.9</span></a> by setting <math id="A3.SS2.p2.m15" class="ltx_Math" alttext="g=-\mathbb{E}_{x\sim\mathcal{D}}\big[V_{R_{\mathcal{H}}}^{\pi_{t-1}}(x)\big]" display="inline" intent=":literal"><semantics><mrow><mi>g</mi><mo>=</mo><mrow><mo>−</mo><mrow><msub><mi>𝔼</mi><mrow><mi>x</mi><mo>∼</mo><mi class="ltx_font_mathcaligraphic">𝒟</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="1.200em" minsize="1.200em">[</mo><mrow><msubsup><mi>V</mi><msub><mi>R</mi><mi class="ltx_font_mathcaligraphic">ℋ</mi></msub><msub><mi>π</mi><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow></msub></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo maxsize="1.200em" minsize="1.200em">]</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">g=-\mathbb{E}_{x\sim\mathcal{D}}\big[V_{R_{\mathcal{H}}}^{\pi_{t-1}}(x)\big]</annotation></semantics></math>, <math id="A3.SS2.p2.m16" class="ltx_Math" alttext="\eta=\eta_{\lambda}" display="inline" intent=":literal"><semantics><mrow><mi>η</mi><mo>=</mo><msub><mi>η</mi><mi>λ</mi></msub></mrow><annotation encoding="application/x-tex">\eta=\eta_{\lambda}</annotation></semantics></math>, <math id="A3.SS2.p2.m17" class="ltx_Math" alttext="h(\mathbf{x})=\|\mathbf{x}\|_{2}^{2}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>h</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝐱</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><msubsup><mrow><mo stretchy="false">‖</mo><mi>𝐱</mi><mo stretchy="false">‖</mo></mrow><mn>2</mn><mn>2</mn></msubsup></mrow><annotation encoding="application/x-tex">h(\mathbf{x})=\|\mathbf{x}\|_{2}^{2}</annotation></semantics></math>, <math id="A3.SS2.p2.m18" class="ltx_Math" alttext="D_{h}(\mathbf{x},\mathbf{y})=\|\mathbf{x}-\mathbf{y}\|_{2}^{2}" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>D</mi><mi>h</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐱</mi><mo>,</mo><mi>𝐲</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><msubsup><mrow><mo stretchy="false">‖</mo><mrow><mi>𝐱</mi><mo>−</mo><mi>𝐲</mi></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn><mn>2</mn></msubsup></mrow><annotation encoding="application/x-tex">D_{h}(\mathbf{x},\mathbf{y})=\|\mathbf{x}-\mathbf{y}\|_{2}^{2}</annotation></semantics></math>, <math id="A3.SS2.p2.m19" class="ltx_Math" alttext="\mathbf{x}^{\prime}=\hat{\boldsymbol{\lambda}}_{t+1}" display="inline" intent=":literal"><semantics><mrow><msup><mi>𝐱</mi><mo>′</mo></msup><mo>=</mo><msub><mover accent="true"><mi>𝝀</mi><mo>^</mo></mover><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow></msub></mrow><annotation encoding="application/x-tex">\mathbf{x}^{\prime}=\hat{\boldsymbol{\lambda}}_{t+1}</annotation></semantics></math>, <math id="A3.SS2.p2.m20" class="ltx_Math" alttext="\mathbf{x}_{\mathrm{new}}=\boldsymbol{\lambda}_{t}" display="inline" intent=":literal"><semantics><mrow><msub><mi>𝐱</mi><mi>new</mi></msub><mo>=</mo><msub><mi>𝝀</mi><mi>t</mi></msub></mrow><annotation encoding="application/x-tex">\mathbf{x}_{\mathrm{new}}=\boldsymbol{\lambda}_{t}</annotation></semantics></math>, <math id="A3.SS2.p2.m21" class="ltx_Math" alttext="\mathbf{x}_{\mathrm{old}}=\hat{\boldsymbol{\lambda}}_{t}" display="inline" intent=":literal"><semantics><mrow><msub><mi>𝐱</mi><mi>old</mi></msub><mo>=</mo><msub><mover accent="true"><mi>𝝀</mi><mo>^</mo></mover><mi>t</mi></msub></mrow><annotation encoding="application/x-tex">\mathbf{x}_{\mathrm{old}}=\hat{\boldsymbol{\lambda}}_{t}</annotation></semantics></math>, we have</p>
<table id="A3.E40" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A3.E40.m1" class="ltx_Math" alttext="\langle\boldsymbol{\lambda}_{t}-\hat{\boldsymbol{\lambda}}_{t+1},\mathbb{E}_{x\sim\mathcal{D}}\big[V_{R_{\mathcal{H}}}^{\pi_{t-1}}(x)\big]\rangle\leq\eta_{\lambda}\left(\|\hat{\boldsymbol{\lambda}}_{t+1}-\hat{\boldsymbol{\lambda}}_{t}\|_{2}^{2}-\|\hat{\boldsymbol{\lambda}}_{t+1}-\boldsymbol{\lambda}_{t}\|_{2}^{2}-\|\boldsymbol{\lambda}_{t}-\hat{\boldsymbol{\lambda}}_{t}\|_{2}^{2}\right)." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mo stretchy="false">⟨</mo><mrow><mrow><msub><mi>𝝀</mi><mi>t</mi></msub><mo>−</mo><msub><mover accent="true"><mi>𝝀</mi><mo>^</mo></mover><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow></msub></mrow><mo>,</mo><mrow><msub><mi>𝔼</mi><mrow><mi>x</mi><mo>∼</mo><mi class="ltx_font_mathcaligraphic">𝒟</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="1.200em" minsize="1.200em">[</mo><mrow><msubsup><mi>V</mi><msub><mi>R</mi><mi class="ltx_font_mathcaligraphic">ℋ</mi></msub><msub><mi>π</mi><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow></msub></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo maxsize="1.200em" minsize="1.200em">]</mo></mrow></mrow></mrow><mo stretchy="false">⟩</mo></mrow><mo>≤</mo><mrow><msub><mi>η</mi><mi>λ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><msubsup><mrow><mo stretchy="false">‖</mo><mrow><msub><mover accent="true"><mi>𝝀</mi><mo>^</mo></mover><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow></msub><mo>−</mo><msub><mover accent="true"><mi>𝝀</mi><mo>^</mo></mover><mi>t</mi></msub></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn><mn>2</mn></msubsup><mo>−</mo><msubsup><mrow><mo stretchy="false">‖</mo><mrow><msub><mover accent="true"><mi>𝝀</mi><mo>^</mo></mover><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow></msub><mo>−</mo><msub><mi>𝝀</mi><mi>t</mi></msub></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn><mn>2</mn></msubsup><mo>−</mo><msubsup><mrow><mo stretchy="false">‖</mo><mrow><msub><mi>𝝀</mi><mi>t</mi></msub><mo>−</mo><msub><mover accent="true"><mi>𝝀</mi><mo>^</mo></mover><mi>t</mi></msub></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn><mn>2</mn></msubsup></mrow><mo>)</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\langle\boldsymbol{\lambda}_{t}-\hat{\boldsymbol{\lambda}}_{t+1},\mathbb{E}_{x\sim\mathcal{D}}\big[V_{R_{\mathcal{H}}}^{\pi_{t-1}}(x)\big]\rangle\leq\eta_{\lambda}\left(\|\hat{\boldsymbol{\lambda}}_{t+1}-\hat{\boldsymbol{\lambda}}_{t}\|_{2}^{2}-\|\hat{\boldsymbol{\lambda}}_{t+1}-\boldsymbol{\lambda}_{t}\|_{2}^{2}-\|\boldsymbol{\lambda}_{t}-\hat{\boldsymbol{\lambda}}_{t}\|_{2}^{2}\right).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(40)</span></td></tr></tbody>
</table>
<p id="A3.SS2.p2.9" class="ltx_p">We upper bound the last term of <math id="A3.SS2.p2.m22" class="ltx_Math" alttext="\mathrm{B}" display="inline" intent=":literal"><semantics><mi>B</mi><annotation encoding="application/x-tex">\mathrm{B}</annotation></semantics></math> as</p>
<table id="A3.Ex66" class="ltx_equationgroup ltx_eqn_table">

<tbody id="A3.Ex66X"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex66X.m2" class="ltx_Math" alttext="\displaystyle\left(\boldsymbol{\lambda}_{t}-\hat{\boldsymbol{\lambda}}_{t+1}\right)^{T}\left(\mathbb{E}_{x\sim\mathcal{D}}\left[V_{R_{\mathcal{H}}}^{\pi_{t}}(x)\right]-\mathbb{E}_{x\sim\mathcal{D}}\left[V_{R_{\mathcal{H}}}^{\pi_{t-1}}(x)\right]\right)" display="inline" intent=":literal"><semantics><mrow><msup><mrow><mo>(</mo><mrow><msub><mi>𝝀</mi><mi>t</mi></msub><mo>−</mo><msub><mover accent="true"><mi>𝝀</mi><mo>^</mo></mover><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow></msub></mrow><mo>)</mo></mrow><mi>T</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mrow><msub><mi>𝔼</mi><mrow><mi>x</mi><mo>∼</mo><mi class="ltx_font_mathcaligraphic">𝒟</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><mrow><msubsup><mi>V</mi><msub><mi>R</mi><mi class="ltx_font_mathcaligraphic">ℋ</mi></msub><msub><mi>π</mi><mi>t</mi></msub></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo>]</mo></mrow></mrow><mo>−</mo><mrow><msub><mi>𝔼</mi><mrow><mi>x</mi><mo>∼</mo><mi class="ltx_font_mathcaligraphic">𝒟</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><mrow><msubsup><mi>V</mi><msub><mi>R</mi><mi class="ltx_font_mathcaligraphic">ℋ</mi></msub><msub><mi>π</mi><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow></msub></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo>]</mo></mrow></mrow></mrow><mo>)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\left(\boldsymbol{\lambda}_{t}-\hat{\boldsymbol{\lambda}}_{t+1}\right)^{T}\left(\mathbb{E}_{x\sim\mathcal{D}}\left[V_{R_{\mathcal{H}}}^{\pi_{t}}(x)\right]-\mathbb{E}_{x\sim\mathcal{D}}\left[V_{R_{\mathcal{H}}}^{\pi_{t-1}}(x)\right]\right)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A3.Ex66Xa"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex66Xa.m2" class="ltx_Math" alttext="\displaystyle=\mathbb{E}_{x\sim\mathcal{D}}\left[\left(\boldsymbol{\lambda}_{t}-\hat{\boldsymbol{\lambda}}_{t+1}\right)^{T}\left(V_{R_{\mathcal{H}}}^{\pi_{t}}(x)-V_{R_{\mathcal{H}}}^{\pi_{t-1}}(x)\right)\right]" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><msub><mi>𝔼</mi><mrow><mi>x</mi><mo>∼</mo><mi class="ltx_font_mathcaligraphic">𝒟</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><mrow><msup><mrow><mo>(</mo><mrow><msub><mi>𝝀</mi><mi>t</mi></msub><mo>−</mo><msub><mover accent="true"><mi>𝝀</mi><mo>^</mo></mover><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow></msub></mrow><mo>)</mo></mrow><mi>T</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mrow><msubsup><mi>V</mi><msub><mi>R</mi><mi class="ltx_font_mathcaligraphic">ℋ</mi></msub><msub><mi>π</mi><mi>t</mi></msub></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msubsup><mi>V</mi><msub><mi>R</mi><mi class="ltx_font_mathcaligraphic">ℋ</mi></msub><msub><mi>π</mi><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow></msub></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>)</mo></mrow></mrow><mo>]</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\mathbb{E}_{x\sim\mathcal{D}}\left[\left(\boldsymbol{\lambda}_{t}-\hat{\boldsymbol{\lambda}}_{t+1}\right)^{T}\left(V_{R_{\mathcal{H}}}^{\pi_{t}}(x)-V_{R_{\mathcal{H}}}^{\pi_{t-1}}(x)\right)\right]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A3.Ex66Xb"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex66Xb.m2" class="ltx_Math" alttext="\displaystyle=\mathbb{E}_{x\sim\mathcal{D}}\left[\left(\boldsymbol{\lambda}_{t}-\hat{\boldsymbol{\lambda}}_{t+1}\right)^{T}\left(\langle\pi_{t}(\cdot|x),R_{\mathcal{H}}(x,\cdot)\rangle-\langle\pi_{t-1}(\cdot|x),R_{\mathcal{H}}(x,\cdot)\rangle\right)\right]" display="inline" intent=":literal"><semantics><mrow><mo>=</mo><mi>𝔼</mi><msub><mrow></mrow><mrow><mi>x</mi><mo>∼</mo><mi class="ltx_font_mathcaligraphic">𝒟</mi></mrow></msub><mo>[</mo><mo>(</mo><mi>𝝀</mi><msub><mrow></mrow><mi>t</mi></msub><mo>−</mo><mover accent="true"><mi>𝝀</mi><mo>^</mo></mover><msub><mrow></mrow><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow></msub><mo>)</mo><msup><mrow></mrow><mi>T</mi></msup><mo>(</mo><mo stretchy="false">⟨</mo><mi>π</mi><msub><mrow></mrow><mi>t</mi></msub><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>x</mi><mo stretchy="false">)</mo><mo>,</mo><mi>R</mi><msub><mrow></mrow><mi class="ltx_font_mathcaligraphic">ℋ</mi></msub><mo stretchy="false">(</mo><mi>x</mi><mo rspace="0em">,</mo><mo lspace="0em" rspace="0em">⋅</mo><mo stretchy="false">)</mo><mo stretchy="false">⟩</mo><mo>−</mo><mo stretchy="false">⟨</mo><mi>π</mi><msub><mrow></mrow><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow></msub><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>x</mi><mo stretchy="false">)</mo><mo>,</mo><mi>R</mi><msub><mrow></mrow><mi class="ltx_font_mathcaligraphic">ℋ</mi></msub><mo stretchy="false">(</mo><mi>x</mi><mo rspace="0em">,</mo><mo lspace="0em" rspace="0em">⋅</mo><mo stretchy="false">)</mo><mo stretchy="false">⟩</mo><mo>)</mo><mo>]</mo></mrow><annotation encoding="application/x-tex">\displaystyle=\mathbb{E}_{x\sim\mathcal{D}}\left[\left(\boldsymbol{\lambda}_{t}-\hat{\boldsymbol{\lambda}}_{t+1}\right)^{T}\left(\langle\pi_{t}(\cdot|x),R_{\mathcal{H}}(x,\cdot)\rangle-\langle\pi_{t-1}(\cdot|x),R_{\mathcal{H}}(x,\cdot)\rangle\right)\right]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A3.Ex66Xc"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex66Xc.m2" class="ltx_Math" alttext="\displaystyle\text{(by $V_{R_{\mathcal{H}}}^{\pi}(x)=\mathbb{E}_{y\sim\pi(\cdot|x)}\left[R_{\mathcal{H}}(x,y)\right]=\langle\pi(\cdot|x),R_{\mathcal{H}}(x,\cdot)\rangle$)}" display="inline" intent=":literal"><semantics><mrow><mtext>(by </mtext><mrow><msubsup><mi>V</mi><msub><mi>R</mi><mi class="ltx_font_mathcaligraphic">ℋ</mi></msub><mi>π</mi></msubsup><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow><mo>=</mo><msub><mi>𝔼</mi><mrow><mi>y</mi><mo>∼</mo><mi>π</mi><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></msub><mrow><mo>[</mo><msub><mi>R</mi><mi class="ltx_font_mathcaligraphic">ℋ</mi></msub><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>y</mi><mo stretchy="false">)</mo></mrow><mo>]</mo></mrow><mo>=</mo><mrow><mo stretchy="false">⟨</mo><mi>π</mi><mrow><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>x</mi><mo stretchy="false">)</mo></mrow><mo>,</mo><msub><mi>R</mi><mi class="ltx_font_mathcaligraphic">ℋ</mi></msub><mrow><mo stretchy="false">(</mo><mi>x</mi><mo rspace="0em">,</mo><mo lspace="0em" rspace="0em">⋅</mo><mo stretchy="false">)</mo></mrow><mo stretchy="false">⟩</mo></mrow></mrow><mtext>)</mtext></mrow><annotation encoding="application/x-tex">\displaystyle\text{(by $V_{R_{\mathcal{H}}}^{\pi}(x)=\mathbb{E}_{y\sim\pi(\cdot|x)}\left[R_{\mathcal{H}}(x,y)\right]=\langle\pi(\cdot|x),R_{\mathcal{H}}(x,\cdot)\rangle$)}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A3.Ex66Xd"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex66Xd.m2" class="ltx_Math" alttext="\displaystyle=\mathbb{E}_{x\sim\mathcal{D}}\left[\langle\pi_{t}(\cdot|x)-\pi_{t-1}(\cdot|x),\left(\boldsymbol{\lambda}_{t}-\hat{\boldsymbol{\lambda}}_{t+1}\right)^{T}R_{\mathcal{H}}(x,\cdot)\rangle\right]" display="inline" intent=":literal"><semantics><mrow><mo>=</mo><mi>𝔼</mi><msub><mrow></mrow><mrow><mi>x</mi><mo>∼</mo><mi class="ltx_font_mathcaligraphic">𝒟</mi></mrow></msub><mo>[</mo><mo stretchy="false">⟨</mo><mi>π</mi><msub><mrow></mrow><mi>t</mi></msub><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>x</mi><mo stretchy="false">)</mo><mo>−</mo><mi>π</mi><msub><mrow></mrow><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow></msub><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>x</mi><mo stretchy="false">)</mo><mo>,</mo><mo>(</mo><mi>𝝀</mi><msub><mrow></mrow><mi>t</mi></msub><mo>−</mo><mover accent="true"><mi>𝝀</mi><mo>^</mo></mover><msub><mrow></mrow><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow></msub><mo>)</mo><msup><mrow></mrow><mi>T</mi></msup><mi>R</mi><msub><mrow></mrow><mi class="ltx_font_mathcaligraphic">ℋ</mi></msub><mo stretchy="false">(</mo><mi>x</mi><mo rspace="0em">,</mo><mo lspace="0em" rspace="0em">⋅</mo><mo stretchy="false">)</mo><mo stretchy="false">⟩</mo><mo>]</mo></mrow><annotation encoding="application/x-tex">\displaystyle=\mathbb{E}_{x\sim\mathcal{D}}\left[\langle\pi_{t}(\cdot|x)-\pi_{t-1}(\cdot|x),\left(\boldsymbol{\lambda}_{t}-\hat{\boldsymbol{\lambda}}_{t+1}\right)^{T}R_{\mathcal{H}}(x,\cdot)\rangle\right]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A3.Ex66Xe"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex66Xe.m2" class="ltx_Math" alttext="\displaystyle=\mathbb{E}_{x\sim\mathcal{D}}\left[\left\langle\pi_{t}(\cdot|x)-\pi_{t-1}(\cdot|x),\sum_{j\in\mathcal{H}}(\lambda_{t,j}-\hat{\lambda}_{t+1,j})R_{j}(x,\cdot)\right\rangle\right]" display="inline" intent=":literal"><semantics><mrow><mo>=</mo><mi>𝔼</mi><msub><mrow></mrow><mrow><mi>x</mi><mo>∼</mo><mi class="ltx_font_mathcaligraphic">𝒟</mi></mrow></msub><mo>[</mo><mo>⟨</mo><mi>π</mi><msub><mrow></mrow><mi>t</mi></msub><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>x</mi><mo stretchy="false">)</mo><mo>−</mo><mi>π</mi><msub><mrow></mrow><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow></msub><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>x</mi><mo stretchy="false">)</mo><mo>,</mo><mstyle displaystyle="true"><mo movablelimits="false">∑</mo></mstyle><msub><mrow></mrow><mrow><mi>j</mi><mo>∈</mo><mi class="ltx_font_mathcaligraphic">ℋ</mi></mrow></msub><mo stretchy="false">(</mo><mi>λ</mi><msub><mrow></mrow><mrow><mi>t</mi><mo>,</mo><mi>j</mi></mrow></msub><mo>−</mo><mover accent="true"><mi>λ</mi><mo>^</mo></mover><msub><mrow></mrow><mrow><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow><mo>,</mo><mi>j</mi></mrow></msub><mo stretchy="false">)</mo><mi>R</mi><msub><mrow></mrow><mi>j</mi></msub><mo stretchy="false">(</mo><mi>x</mi><mo rspace="0em">,</mo><mo lspace="0em" rspace="0em">⋅</mo><mo stretchy="false">)</mo><mo>⟩</mo><mo>]</mo></mrow><annotation encoding="application/x-tex">\displaystyle=\mathbb{E}_{x\sim\mathcal{D}}\left[\left\langle\pi_{t}(\cdot|x)-\pi_{t-1}(\cdot|x),\sum_{j\in\mathcal{H}}(\lambda_{t,j}-\hat{\lambda}_{t+1,j})R_{j}(x,\cdot)\right\rangle\right]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A3.SS2.p2.10" class="ltx_p">Define constants <math id="A3.SS2.p2.m23" class="ltx_Math" alttext="C_{1}&gt;0" display="inline" intent=":literal"><semantics><mrow><msub><mi>C</mi><mn>1</mn></msub><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">C_{1}&gt;0</annotation></semantics></math> and <math id="A3.SS2.p2.m24" class="ltx_Math" alttext="C_{2}&gt;0" display="inline" intent=":literal"><semantics><mrow><msub><mi>C</mi><mn>2</mn></msub><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">C_{2}&gt;0</annotation></semantics></math>. Fixing <math id="A3.SS2.p2.m25" class="ltx_Math" alttext="x" display="inline" intent=":literal"><semantics><mi>x</mi><annotation encoding="application/x-tex">x</annotation></semantics></math>, we have</p>
<table id="A3.Ex67" class="ltx_equationgroup ltx_eqn_table">

<tbody id="A3.Ex67X"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex67X.m2" class="ltx_Math" alttext="\displaystyle\left\langle\pi_{t}(\cdot|x)-\pi_{t-1}(\cdot|x),\sum_{j\in\mathcal{H}}(\lambda_{t,j}-\hat{\lambda}_{t+1,j})R_{j}(x,\cdot)\right\rangle" display="inline" intent=":literal"><semantics><mrow><mo>⟨</mo><mi>π</mi><msub><mrow></mrow><mi>t</mi></msub><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>x</mi><mo stretchy="false">)</mo><mo>−</mo><mi>π</mi><msub><mrow></mrow><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow></msub><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>x</mi><mo stretchy="false">)</mo><mo>,</mo><mstyle displaystyle="true"><mo movablelimits="false">∑</mo></mstyle><msub><mrow></mrow><mrow><mi>j</mi><mo>∈</mo><mi class="ltx_font_mathcaligraphic">ℋ</mi></mrow></msub><mo stretchy="false">(</mo><mi>λ</mi><msub><mrow></mrow><mrow><mi>t</mi><mo>,</mo><mi>j</mi></mrow></msub><mo>−</mo><mover accent="true"><mi>λ</mi><mo>^</mo></mover><msub><mrow></mrow><mrow><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow><mo>,</mo><mi>j</mi></mrow></msub><mo stretchy="false">)</mo><mi>R</mi><msub><mrow></mrow><mi>j</mi></msub><mo stretchy="false">(</mo><mi>x</mi><mo rspace="0em">,</mo><mo lspace="0em" rspace="0em">⋅</mo><mo stretchy="false">)</mo><mo>⟩</mo></mrow><annotation encoding="application/x-tex">\displaystyle\left\langle\pi_{t}(\cdot|x)-\pi_{t-1}(\cdot|x),\sum_{j\in\mathcal{H}}(\lambda_{t,j}-\hat{\lambda}_{t+1,j})R_{j}(x,\cdot)\right\rangle</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A3.Ex67Xa"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex67Xa.m2" class="ltx_Math" alttext="\displaystyle=\left\langle\pi_{t}(\cdot|x)-\hat{\pi}_{t}(\cdot|x),\sum_{j\in\mathcal{H}}(\lambda_{t,j}-\hat{\lambda}_{t+1,j})R_{j}(x,\cdot)\right\rangle+\left\langle\hat{\pi}_{t}(\cdot|x)-\pi_{t-1}(\cdot|x),\sum_{j\in\mathcal{H}}(\lambda_{t,j}-\hat{\lambda}_{t+1,j})R_{j}(x,\cdot)\right\rangle" display="inline" intent=":literal"><semantics><mrow><mo>=</mo><mo>⟨</mo><mi>π</mi><msub><mrow></mrow><mi>t</mi></msub><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>x</mi><mo stretchy="false">)</mo><mo>−</mo><mover accent="true"><mi>π</mi><mo>^</mo></mover><msub><mrow></mrow><mi>t</mi></msub><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>x</mi><mo stretchy="false">)</mo><mo>,</mo><mstyle displaystyle="true"><mo movablelimits="false">∑</mo></mstyle><msub><mrow></mrow><mrow><mi>j</mi><mo>∈</mo><mi class="ltx_font_mathcaligraphic">ℋ</mi></mrow></msub><mo stretchy="false">(</mo><mi>λ</mi><msub><mrow></mrow><mrow><mi>t</mi><mo>,</mo><mi>j</mi></mrow></msub><mo>−</mo><mover accent="true"><mi>λ</mi><mo>^</mo></mover><msub><mrow></mrow><mrow><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow><mo>,</mo><mi>j</mi></mrow></msub><mo stretchy="false">)</mo><mi>R</mi><msub><mrow></mrow><mi>j</mi></msub><mo stretchy="false">(</mo><mi>x</mi><mo rspace="0em">,</mo><mo lspace="0em" rspace="0em">⋅</mo><mo stretchy="false">)</mo><mo>⟩</mo><mo>+</mo><mo>⟨</mo><mover accent="true"><mi>π</mi><mo>^</mo></mover><msub><mrow></mrow><mi>t</mi></msub><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>x</mi><mo stretchy="false">)</mo><mo>−</mo><mi>π</mi><msub><mrow></mrow><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow></msub><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>x</mi><mo stretchy="false">)</mo><mo>,</mo><mstyle displaystyle="true"><mo movablelimits="false">∑</mo></mstyle><msub><mrow></mrow><mrow><mi>j</mi><mo>∈</mo><mi class="ltx_font_mathcaligraphic">ℋ</mi></mrow></msub><mo stretchy="false">(</mo><mi>λ</mi><msub><mrow></mrow><mrow><mi>t</mi><mo>,</mo><mi>j</mi></mrow></msub><mo>−</mo><mover accent="true"><mi>λ</mi><mo>^</mo></mover><msub><mrow></mrow><mrow><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow><mo>,</mo><mi>j</mi></mrow></msub><mo stretchy="false">)</mo><mi>R</mi><msub><mrow></mrow><mi>j</mi></msub><mo stretchy="false">(</mo><mi>x</mi><mo rspace="0em">,</mo><mo lspace="0em" rspace="0em">⋅</mo><mo stretchy="false">)</mo><mo>⟩</mo></mrow><annotation encoding="application/x-tex">\displaystyle=\left\langle\pi_{t}(\cdot|x)-\hat{\pi}_{t}(\cdot|x),\sum_{j\in\mathcal{H}}(\lambda_{t,j}-\hat{\lambda}_{t+1,j})R_{j}(x,\cdot)\right\rangle+\left\langle\hat{\pi}_{t}(\cdot|x)-\pi_{t-1}(\cdot|x),\sum_{j\in\mathcal{H}}(\lambda_{t,j}-\hat{\lambda}_{t+1,j})R_{j}(x,\cdot)\right\rangle</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A3.Ex67Xb"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex67Xb.m2" class="ltx_Math" alttext="\displaystyle\leq C_{1}\mathrm{KL}(\pi_{t}(\cdot|x)\|\hat{\pi}_{t}(\cdot|x))+\frac{|\mathcal{H}|R_{\max}^{2}}{2C_{1}}\|\boldsymbol{\lambda}_{t}-\hat{\boldsymbol{\lambda}}_{t+1}\|_{2}^{2}+C_{2}\mathrm{KL}(\hat{\pi}_{t}(\cdot|x)\|\pi_{t-1}(\cdot|x))+\frac{|\mathcal{H}|R_{\max}^{2}}{2C_{2}}\|\boldsymbol{\lambda}_{t}-\hat{\boldsymbol{\lambda}}_{t+1}\|_{2}^{2}" display="inline" intent=":literal"><semantics><mrow><mo>≤</mo><mi>C</mi><msub><mrow></mrow><mn>1</mn></msub><mi>KL</mi><mo stretchy="false">(</mo><mi>π</mi><msub><mrow></mrow><mi>t</mi></msub><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>x</mi><mo stretchy="false">)</mo><mo lspace="0em" rspace="0.167em">∥</mo><mover accent="true"><mi>π</mi><mo>^</mo></mover><msub><mrow></mrow><mi>t</mi></msub><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>x</mi><mo stretchy="false">)</mo><mo stretchy="false">)</mo><mo>+</mo><mstyle displaystyle="true"><mfrac><mrow><mrow><mo stretchy="false">|</mo><mi class="ltx_font_mathcaligraphic">ℋ</mi><mo stretchy="false">|</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>R</mi><mi>max</mi><mn>2</mn></msubsup></mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>C</mi><mn>1</mn></msub></mrow></mfrac></mstyle><mo lspace="0em" rspace="0.167em">∥</mo><mi>𝝀</mi><msub><mrow></mrow><mi>t</mi></msub><mo>−</mo><mover accent="true"><mi>𝝀</mi><mo>^</mo></mover><msub><mrow></mrow><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow></msub><mo lspace="0em" rspace="0em">∥</mo><msub><mrow></mrow><mn>2</mn></msub><msup><mrow></mrow><mn>2</mn></msup><mo lspace="0em">+</mo><mi>C</mi><msub><mrow></mrow><mn>2</mn></msub><mi>KL</mi><mo stretchy="false">(</mo><mover accent="true"><mi>π</mi><mo>^</mo></mover><msub><mrow></mrow><mi>t</mi></msub><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>x</mi><mo stretchy="false">)</mo><mo lspace="0em" rspace="0.167em">∥</mo><mi>π</mi><msub><mrow></mrow><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow></msub><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>x</mi><mo stretchy="false">)</mo><mo stretchy="false">)</mo><mo>+</mo><mstyle displaystyle="true"><mfrac><mrow><mrow><mo stretchy="false">|</mo><mi class="ltx_font_mathcaligraphic">ℋ</mi><mo stretchy="false">|</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>R</mi><mi>max</mi><mn>2</mn></msubsup></mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>C</mi><mn>2</mn></msub></mrow></mfrac></mstyle><mo lspace="0em" rspace="0.167em">∥</mo><mi>𝝀</mi><msub><mrow></mrow><mi>t</mi></msub><mo>−</mo><mover accent="true"><mi>𝝀</mi><mo>^</mo></mover><msub><mrow></mrow><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow></msub><mo lspace="0em">∥</mo><msub><mrow></mrow><mn>2</mn></msub><msup><mrow></mrow><mn>2</mn></msup></mrow><annotation encoding="application/x-tex">\displaystyle\leq C_{1}\mathrm{KL}(\pi_{t}(\cdot|x)\|\hat{\pi}_{t}(\cdot|x))+\frac{|\mathcal{H}|R_{\max}^{2}}{2C_{1}}\|\boldsymbol{\lambda}_{t}-\hat{\boldsymbol{\lambda}}_{t+1}\|_{2}^{2}+C_{2}\mathrm{KL}(\hat{\pi}_{t}(\cdot|x)\|\pi_{t-1}(\cdot|x))+\frac{|\mathcal{H}|R_{\max}^{2}}{2C_{2}}\|\boldsymbol{\lambda}_{t}-\hat{\boldsymbol{\lambda}}_{t+1}\|_{2}^{2}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A3.Ex67Xc"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex67Xc.m2" class="ltx_Math" alttext="\displaystyle\text{(By derivations of \lx@cref{creftype~refnum}{eq:A_3})}" display="inline" intent=":literal"><semantics><mrow><mtext>(By derivations of </mtext><mtext><a href="#A3.E35" title="In C.1 Upper bound of term A ‣ Appendix C Proof of ‣ Provable Last-Iterate Convergence for Multi-Objective Safe LLM Alignment via Optimistic Primal-Dual" class="ltx_ref"><span class="ltx_text ltx_ref_tag">eq.</span> <span class="ltx_text ltx_ref_tag">35</span></a></mtext><mtext>)</mtext></mrow><annotation encoding="application/x-tex">\displaystyle\text{(By derivations of \lx@cref{creftype~refnum}{eq:A_3})}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A3.Ex67Xd"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex67Xd.m2" class="ltx_Math" alttext="\displaystyle=C_{1}\mathrm{KL}(\pi_{t}(\cdot|x)\|\hat{\pi}_{t}(\cdot|x))+C_{2}\mathrm{KL}(\hat{\pi}_{t}(\cdot|x)\|\pi_{t-1}(\cdot|x))+|\mathcal{H}|R_{\max}^{2}\left(\frac{1}{2C_{1}}+\frac{1}{2C_{2}}\right)\|\boldsymbol{\lambda}_{t}-\hat{\boldsymbol{\lambda}}_{t+1}\|_{2}^{2}" display="inline" intent=":literal"><semantics><mrow><mo>=</mo><mi>C</mi><msub><mrow></mrow><mn>1</mn></msub><mi>KL</mi><mo stretchy="false">(</mo><mi>π</mi><msub><mrow></mrow><mi>t</mi></msub><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>x</mi><mo stretchy="false">)</mo><mo lspace="0em" rspace="0.167em">∥</mo><mover accent="true"><mi>π</mi><mo>^</mo></mover><msub><mrow></mrow><mi>t</mi></msub><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>x</mi><mo stretchy="false">)</mo><mo stretchy="false">)</mo><mo>+</mo><mi>C</mi><msub><mrow></mrow><mn>2</mn></msub><mi>KL</mi><mo stretchy="false">(</mo><mover accent="true"><mi>π</mi><mo>^</mo></mover><msub><mrow></mrow><mi>t</mi></msub><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>x</mi><mo stretchy="false">)</mo><mo lspace="0em" rspace="0.167em">∥</mo><mi>π</mi><msub><mrow></mrow><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow></msub><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>x</mi><mo stretchy="false">)</mo><mo stretchy="false">)</mo><mo rspace="0em">+</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi class="ltx_font_mathcaligraphic">ℋ</mi><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>R</mi><msub><mrow></mrow><mi>max</mi></msub><msup><mrow></mrow><mn>2</mn></msup><mo>(</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>C</mi><mn>1</mn></msub></mrow></mfrac></mstyle><mo>+</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>C</mi><mn>2</mn></msub></mrow></mfrac></mstyle><mo>)</mo><mo lspace="0em" rspace="0.167em">∥</mo><mi>𝝀</mi><msub><mrow></mrow><mi>t</mi></msub><mo>−</mo><mover accent="true"><mi>𝝀</mi><mo>^</mo></mover><msub><mrow></mrow><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow></msub><mo lspace="0em">∥</mo><msub><mrow></mrow><mn>2</mn></msub><msup><mrow></mrow><mn>2</mn></msup></mrow><annotation encoding="application/x-tex">\displaystyle=C_{1}\mathrm{KL}(\pi_{t}(\cdot|x)\|\hat{\pi}_{t}(\cdot|x))+C_{2}\mathrm{KL}(\hat{\pi}_{t}(\cdot|x)\|\pi_{t-1}(\cdot|x))+|\mathcal{H}|R_{\max}^{2}\left(\frac{1}{2C_{1}}+\frac{1}{2C_{2}}\right)\|\boldsymbol{\lambda}_{t}-\hat{\boldsymbol{\lambda}}_{t+1}\|_{2}^{2}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A3.SS2.p2.11" class="ltx_p">Substituting the above inequality into <math id="A3.SS2.p2.m26" class="ltx_Math" alttext="\left(\boldsymbol{\lambda}_{t}-\hat{\boldsymbol{\lambda}}_{t+1}\right)^{T}\left(\mathbb{E}_{x\sim\mathcal{D}}\left[V_{R_{\mathcal{H}}}^{\pi_{t}}(x)\right]-\mathbb{E}_{x\sim\mathcal{D}}\left[V_{R_{\mathcal{H}}}^{\pi_{t-1}}(x)\right]\right)" display="inline" intent=":literal"><semantics><mrow><msup><mrow><mo>(</mo><mrow><msub><mi>𝝀</mi><mi>t</mi></msub><mo>−</mo><msub><mover accent="true"><mi>𝝀</mi><mo>^</mo></mover><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow></msub></mrow><mo>)</mo></mrow><mi>T</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mrow><msub><mi>𝔼</mi><mrow><mi>x</mi><mo>∼</mo><mi class="ltx_font_mathcaligraphic">𝒟</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><mrow><msubsup><mi>V</mi><msub><mi>R</mi><mi class="ltx_font_mathcaligraphic">ℋ</mi></msub><msub><mi>π</mi><mi>t</mi></msub></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo>]</mo></mrow></mrow><mo>−</mo><mrow><msub><mi>𝔼</mi><mrow><mi>x</mi><mo>∼</mo><mi class="ltx_font_mathcaligraphic">𝒟</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><mrow><msubsup><mi>V</mi><msub><mi>R</mi><mi class="ltx_font_mathcaligraphic">ℋ</mi></msub><msub><mi>π</mi><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow></msub></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo>]</mo></mrow></mrow></mrow><mo>)</mo></mrow></mrow><annotation encoding="application/x-tex">\left(\boldsymbol{\lambda}_{t}-\hat{\boldsymbol{\lambda}}_{t+1}\right)^{T}\left(\mathbb{E}_{x\sim\mathcal{D}}\left[V_{R_{\mathcal{H}}}^{\pi_{t}}(x)\right]-\mathbb{E}_{x\sim\mathcal{D}}\left[V_{R_{\mathcal{H}}}^{\pi_{t-1}}(x)\right]\right)</annotation></semantics></math>, we have</p>
<table id="A3.E41" class="ltx_equationgroup ltx_eqn_table">
<tbody>
<tr id="A3.E41X" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.E41X.m2" class="ltx_Math" alttext="\displaystyle\left(\boldsymbol{\lambda}_{t}-\hat{\boldsymbol{\lambda}}_{t+1}\right)^{T}\left(\mathbb{E}_{x\sim\mathcal{D}}\left[V_{R_{\mathcal{H}}}^{\pi_{t}}(x)\right]-\mathbb{E}_{x\sim\mathcal{D}}\left[V_{R_{\mathcal{H}}}^{\pi_{t-1}}(x)\right]\right)" display="inline" intent=":literal"><semantics><mrow><msup><mrow><mo>(</mo><mrow><msub><mi>𝝀</mi><mi>t</mi></msub><mo>−</mo><msub><mover accent="true"><mi>𝝀</mi><mo>^</mo></mover><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow></msub></mrow><mo>)</mo></mrow><mi>T</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mrow><msub><mi>𝔼</mi><mrow><mi>x</mi><mo>∼</mo><mi class="ltx_font_mathcaligraphic">𝒟</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><mrow><msubsup><mi>V</mi><msub><mi>R</mi><mi class="ltx_font_mathcaligraphic">ℋ</mi></msub><msub><mi>π</mi><mi>t</mi></msub></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo>]</mo></mrow></mrow><mo>−</mo><mrow><msub><mi>𝔼</mi><mrow><mi>x</mi><mo>∼</mo><mi class="ltx_font_mathcaligraphic">𝒟</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><mrow><msubsup><mi>V</mi><msub><mi>R</mi><mi class="ltx_font_mathcaligraphic">ℋ</mi></msub><msub><mi>π</mi><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow></msub></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo>]</mo></mrow></mrow></mrow><mo>)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\left(\boldsymbol{\lambda}_{t}-\hat{\boldsymbol{\lambda}}_{t+1}\right)^{T}\left(\mathbb{E}_{x\sim\mathcal{D}}\left[V_{R_{\mathcal{H}}}^{\pi_{t}}(x)\right]-\mathbb{E}_{x\sim\mathcal{D}}\left[V_{R_{\mathcal{H}}}^{\pi_{t-1}}(x)\right]\right)</annotation></semantics></math></td>
