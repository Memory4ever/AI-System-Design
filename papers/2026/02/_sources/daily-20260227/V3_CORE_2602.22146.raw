<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.Ex103Xc.m2" class="ltx_Math" alttext="\displaystyle\left(\eta_{\lambda}-|\mathcal{H}|R_{\max}^{2}\left(\frac{1}{2C_{1}}+\frac{1}{2C_{2}}\right)+\left(\eta_{\lambda}-\frac{|\mathcal{H}|R_{\max}^{2}}{C}\right)(1-\frac{1}{\delta})(1-\theta)\right)\|\hat{\boldsymbol{\lambda}}_{t}-\boldsymbol{\lambda}_{t-1}\|_{2}^{2}" display="inline" intent=":literal"><semantics><mrow><mrow><mo>(</mo><mrow><mrow><msub><mi>η</mi><mi>λ</mi></msub><mo>−</mo><mrow><mrow><mo stretchy="false">|</mo><mi class="ltx_font_mathcaligraphic">ℋ</mi><mo stretchy="false">|</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>R</mi><mi>max</mi><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>C</mi><mn>1</mn></msub></mrow></mfrac></mstyle><mo>+</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>C</mi><mn>2</mn></msub></mrow></mfrac></mstyle></mrow><mo>)</mo></mrow></mrow></mrow><mo>+</mo><mrow><mrow><mo>(</mo><mrow><msub><mi>η</mi><mi>λ</mi></msub><mo>−</mo><mstyle displaystyle="true"><mfrac><mrow><mrow><mo stretchy="false">|</mo><mi class="ltx_font_mathcaligraphic">ℋ</mi><mo stretchy="false">|</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>R</mi><mi>max</mi><mn>2</mn></msubsup></mrow><mi>C</mi></mfrac></mstyle></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>δ</mi></mfrac></mstyle></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>θ</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msubsup><mrow><mo stretchy="false">‖</mo><mrow><msub><mover accent="true"><mi>𝝀</mi><mo>^</mo></mover><mi>t</mi></msub><mo>−</mo><msub><mi>𝝀</mi><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow></msub></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn><mn>2</mn></msubsup></mrow><annotation encoding="application/x-tex">\displaystyle\left(\eta_{\lambda}-|\mathcal{H}|R_{\max}^{2}\left(\frac{1}{2C_{1}}+\frac{1}{2C_{2}}\right)+\left(\eta_{\lambda}-\frac{|\mathcal{H}|R_{\max}^{2}}{C}\right)(1-\frac{1}{\delta})(1-\theta)\right)\|\hat{\boldsymbol{\lambda}}_{t}-\boldsymbol{\lambda}_{t-1}\|_{2}^{2}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A5.Ex103Xd"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.Ex103Xd.m2" class="ltx_Math" alttext="\displaystyle-\left(\eta_{\theta}-C_{1}\right)\mathbb{E}_{x\sim\mathcal{D}}\left[\mathrm{KL}(\pi_{t}(\cdot|x)\|\hat{\pi}_{t}(\cdot|x))\right]{+2\mathrm{gap}(\varepsilon_{\mathrm{approx}},p_{\min})}" display="inline" intent=":literal"><semantics><mrow><mo>−</mo><mo>(</mo><mi>η</mi><msub><mrow></mrow><mi>θ</mi></msub><mo>−</mo><mi>C</mi><msub><mrow></mrow><mn>1</mn></msub><mo>)</mo><mi>𝔼</mi><msub><mrow></mrow><mrow><mi>x</mi><mo>∼</mo><mi class="ltx_font_mathcaligraphic">𝒟</mi></mrow></msub><mo>[</mo><mi>KL</mi><mo stretchy="false">(</mo><mi>π</mi><msub><mrow></mrow><mi>t</mi></msub><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>x</mi><mo stretchy="false">)</mo><mo lspace="0em" rspace="0.167em">∥</mo><mover accent="true"><mi>π</mi><mo>^</mo></mover><msub><mrow></mrow><mi>t</mi></msub><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>x</mi><mo stretchy="false">)</mo><mo stretchy="false">)</mo><mo>]</mo><mo>+</mo><mn>2</mn><mi>gap</mi><mo stretchy="false">(</mo><mi>ε</mi><msub><mrow></mrow><mi>approx</mi></msub><mo>,</mo><mi>p</mi><msub><mrow></mrow><mi>min</mi></msub><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">\displaystyle-\left(\eta_{\theta}-C_{1}\right)\mathbb{E}_{x\sim\mathcal{D}}\left[\mathrm{KL}(\pi_{t}(\cdot|x)\|\hat{\pi}_{t}(\cdot|x))\right]{+2\mathrm{gap}(\varepsilon_{\mathrm{approx}},p_{\min})}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A5.SS3.p1.10" class="ltx_p">Define <math id="A5.SS3.p1.m4" class="ltx_Math" alttext="\Phi_{t}" display="inline" intent=":literal"><semantics><msub><mi mathvariant="normal">Φ</mi><mi>t</mi></msub><annotation encoding="application/x-tex">\Phi_{t}</annotation></semantics></math> as the LHS of <a href="#A5.E68" title="In E.3 Combining A and B ‣ Appendix E Proof of ‣ Provable Last-Iterate Convergence for Multi-Objective Safe LLM Alignment via Optimistic Primal-Dual" class="ltx_ref"><span class="ltx_text ltx_ref_tag">eq.</span> <span class="ltx_text ltx_ref_tag">68</span></a>, i.e.,</p>
<table id="A5.Ex104" class="ltx_equationgroup ltx_eqn_table">

<tbody id="A5.Ex104X"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A5.Ex104X.m2" class="ltx_Math" alttext="\displaystyle\Phi_{t+1}:=" display="inline" intent=":literal"><semantics><mrow><msub><mi mathvariant="normal">Φ</mi><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow></msub><mo>:=</mo><mphantom></mphantom></mrow><annotation encoding="application/x-tex">\displaystyle\Phi_{t+1}:=</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.Ex104X.m3" class="ltx_Math" alttext="\displaystyle(\eta_{\theta}+\beta)\mathbb{E}_{x\sim\mathcal{D}}\left[\mathrm{KL}(\pi^{\star}(\cdot|x)\|\hat{\pi}_{t+1}(\cdot|x))\right]+(\eta_{\theta}+\beta-C)\mathbb{E}_{x\sim\mathcal{D}}\left[\mathrm{KL}(\hat{\pi}_{t+1}(\cdot|x)\|\pi_{t}(\cdot|x))\right]" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi>η</mi><msub><mrow></mrow><mi>θ</mi></msub><mo>+</mo><mi>β</mi><mo stretchy="false">)</mo><mi>𝔼</mi><msub><mrow></mrow><mrow><mi>x</mi><mo>∼</mo><mi class="ltx_font_mathcaligraphic">𝒟</mi></mrow></msub><mo>[</mo><mi>KL</mi><mo stretchy="false">(</mo><mi>π</mi><msup><mrow></mrow><mo>⋆</mo></msup><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>x</mi><mo stretchy="false">)</mo><mo lspace="0em" rspace="0.167em">∥</mo><mover accent="true"><mi>π</mi><mo>^</mo></mover><msub><mrow></mrow><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow></msub><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>x</mi><mo stretchy="false">)</mo><mo stretchy="false">)</mo><mo>]</mo><mo>+</mo><mo stretchy="false">(</mo><mi>η</mi><msub><mrow></mrow><mi>θ</mi></msub><mo>+</mo><mi>β</mi><mo>−</mo><mi>C</mi><mo stretchy="false">)</mo><mi>𝔼</mi><msub><mrow></mrow><mrow><mi>x</mi><mo>∼</mo><mi class="ltx_font_mathcaligraphic">𝒟</mi></mrow></msub><mo>[</mo><mi>KL</mi><mo stretchy="false">(</mo><mover accent="true"><mi>π</mi><mo>^</mo></mover><msub><mrow></mrow><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow></msub><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>x</mi><mo stretchy="false">)</mo><mo lspace="0em" rspace="0.167em">∥</mo><mi>π</mi><msub><mrow></mrow><mi>t</mi></msub><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>x</mi><mo stretchy="false">)</mo><mo stretchy="false">)</mo><mo>]</mo></mrow><annotation encoding="application/x-tex">\displaystyle(\eta_{\theta}+\beta)\mathbb{E}_{x\sim\mathcal{D}}\left[\mathrm{KL}(\pi^{\star}(\cdot|x)\|\hat{\pi}_{t+1}(\cdot|x))\right]+(\eta_{\theta}+\beta-C)\mathbb{E}_{x\sim\mathcal{D}}\left[\mathrm{KL}(\hat{\pi}_{t+1}(\cdot|x)\|\pi_{t}(\cdot|x))\right]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A5.Ex104Xa"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.Ex104Xa.m2" class="ltx_Math" alttext="\displaystyle+\left(\eta_{\lambda}+\left(\eta_{\lambda}-\frac{|\mathcal{H}|R_{\max}^{2}}{C}\right)(1-\delta)\right)\|\boldsymbol{\lambda}^{\star}-\hat{\boldsymbol{\lambda}}_{t+1}\|_{2}^{2}" display="inline" intent=":literal"><semantics><mrow><mo>+</mo><mrow><mrow><mo>(</mo><mrow><msub><mi>η</mi><mi>λ</mi></msub><mo>+</mo><mrow><mrow><mo>(</mo><mrow><msub><mi>η</mi><mi>λ</mi></msub><mo>−</mo><mstyle displaystyle="true"><mfrac><mrow><mrow><mo stretchy="false">|</mo><mi class="ltx_font_mathcaligraphic">ℋ</mi><mo stretchy="false">|</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>R</mi><mi>max</mi><mn>2</mn></msubsup></mrow><mi>C</mi></mfrac></mstyle></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>δ</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msubsup><mrow><mo stretchy="false">‖</mo><mrow><msup><mi>𝝀</mi><mo>⋆</mo></msup><mo>−</mo><msub><mover accent="true"><mi>𝝀</mi><mo>^</mo></mover><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow></msub></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn><mn>2</mn></msubsup></mrow></mrow><annotation encoding="application/x-tex">\displaystyle+\left(\eta_{\lambda}+\left(\eta_{\lambda}-\frac{|\mathcal{H}|R_{\max}^{2}}{C}\right)(1-\delta)\right)\|\boldsymbol{\lambda}^{\star}-\hat{\boldsymbol{\lambda}}_{t+1}\|_{2}^{2}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A5.Ex104Xb"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.Ex104Xb.m2" class="ltx_Math" alttext="\displaystyle+\left(\eta_{\lambda}-|\mathcal{H}|R_{\max}^{2}\left(\frac{1}{2C_{1}}+\frac{1}{2C_{2}}\right)+\left(\eta_{\lambda}-\frac{|\mathcal{H}|R_{\max}^{2}}{C}\right)(1-\frac{1}{\delta})(1-\theta)\right)\|\hat{\boldsymbol{\lambda}}_{t+1}-\boldsymbol{\lambda}_{t}\|_{2}^{2}" display="inline" intent=":literal"><semantics><mrow><mo>+</mo><mrow><mrow><mo>(</mo><mrow><mrow><msub><mi>η</mi><mi>λ</mi></msub><mo>−</mo><mrow><mrow><mo stretchy="false">|</mo><mi class="ltx_font_mathcaligraphic">ℋ</mi><mo stretchy="false">|</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>R</mi><mi>max</mi><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>C</mi><mn>1</mn></msub></mrow></mfrac></mstyle><mo>+</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>C</mi><mn>2</mn></msub></mrow></mfrac></mstyle></mrow><mo>)</mo></mrow></mrow></mrow><mo>+</mo><mrow><mrow><mo>(</mo><mrow><msub><mi>η</mi><mi>λ</mi></msub><mo>−</mo><mstyle displaystyle="true"><mfrac><mrow><mrow><mo stretchy="false">|</mo><mi class="ltx_font_mathcaligraphic">ℋ</mi><mo stretchy="false">|</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>R</mi><mi>max</mi><mn>2</mn></msubsup></mrow><mi>C</mi></mfrac></mstyle></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>δ</mi></mfrac></mstyle></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>θ</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msubsup><mrow><mo stretchy="false">‖</mo><mrow><msub><mover accent="true"><mi>𝝀</mi><mo>^</mo></mover><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow></msub><mo>−</mo><msub><mi>𝝀</mi><mi>t</mi></msub></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn><mn>2</mn></msubsup></mrow></mrow><annotation encoding="application/x-tex">\displaystyle+\left(\eta_{\lambda}-|\mathcal{H}|R_{\max}^{2}\left(\frac{1}{2C_{1}}+\frac{1}{2C_{2}}\right)+\left(\eta_{\lambda}-\frac{|\mathcal{H}|R_{\max}^{2}}{C}\right)(1-\frac{1}{\delta})(1-\theta)\right)\|\hat{\boldsymbol{\lambda}}_{t+1}-\boldsymbol{\lambda}_{t}\|_{2}^{2}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A5.SS3.p1.11" class="ltx_p">If the following requirements are satisfied:</p>
<ol id="A5.I1" class="ltx_enumerate">
<li id="A5.I1.i1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">1.</span> 
<div id="A5.I1.i1.p1" class="ltx_para">
<p id="A5.I1.i1.p1.1" class="ltx_p">Multipliers of all terms of LHS of <a href="#A5.E68" title="In E.3 Combining A and B ‣ Appendix E Proof of ‣ Provable Last-Iterate Convergence for Multi-Objective Safe LLM Alignment via Optimistic Primal-Dual" class="ltx_ref"><span class="ltx_text ltx_ref_tag">eq.</span> <span class="ltx_text ltx_ref_tag">68</span></a> are positive:</p>
<table id="A5.Ex105" class="ltx_equationgroup ltx_eqn_table">

<tbody id="A5.Ex105X"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.Ex105X.m2" class="ltx_Math" alttext="\displaystyle\eta_{\theta}+\beta&gt;0," display="inline" intent=":literal"><semantics><mrow><mrow><mrow><msub><mi>η</mi><mi>θ</mi></msub><mo>+</mo><mi>β</mi></mrow><mo>&gt;</mo><mn>0</mn></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\eta_{\theta}+\beta&gt;0,</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A5.Ex105Xa"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.Ex105Xa.m2" class="ltx_Math" alttext="\displaystyle\eta_{\theta}+\beta-C&gt;0," display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mrow><msub><mi>η</mi><mi>θ</mi></msub><mo>+</mo><mi>β</mi></mrow><mo>−</mo><mi>C</mi></mrow><mo>&gt;</mo><mn>0</mn></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\eta_{\theta}+\beta-C&gt;0,</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A5.Ex105Xb"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.Ex105Xb.m2" class="ltx_Math" alttext="\displaystyle\eta_{\lambda}+\left(\eta_{\lambda}-\frac{|\mathcal{H}|R_{\max}^{2}}{C}\right)(1-\delta)&gt;0," display="inline" intent=":literal"><semantics><mrow><mrow><mrow><msub><mi>η</mi><mi>λ</mi></msub><mo>+</mo><mrow><mrow><mo>(</mo><mrow><msub><mi>η</mi><mi>λ</mi></msub><mo>−</mo><mstyle displaystyle="true"><mfrac><mrow><mrow><mo stretchy="false">|</mo><mi class="ltx_font_mathcaligraphic">ℋ</mi><mo stretchy="false">|</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>R</mi><mi>max</mi><mn>2</mn></msubsup></mrow><mi>C</mi></mfrac></mstyle></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>δ</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>&gt;</mo><mn>0</mn></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\eta_{\lambda}+\left(\eta_{\lambda}-\frac{|\mathcal{H}|R_{\max}^{2}}{C}\right)(1-\delta)&gt;0,</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A5.Ex105Xc"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.Ex105Xc.m2" class="ltx_Math" alttext="\displaystyle\eta_{\lambda}-|\mathcal{H}|R_{\max}^{2}\left(\frac{1}{2C_{1}}+\frac{1}{2C_{2}}\right)+\left(\eta_{\lambda}-\frac{|\mathcal{H}|R_{\max}^{2}}{C}\right)(1-\frac{1}{\delta})(1-\theta)&gt;0." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mrow><msub><mi>η</mi><mi>λ</mi></msub><mo>−</mo><mrow><mrow><mo stretchy="false">|</mo><mi class="ltx_font_mathcaligraphic">ℋ</mi><mo stretchy="false">|</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>R</mi><mi>max</mi><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>C</mi><mn>1</mn></msub></mrow></mfrac></mstyle><mo>+</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>C</mi><mn>2</mn></msub></mrow></mfrac></mstyle></mrow><mo>)</mo></mrow></mrow></mrow><mo>+</mo><mrow><mrow><mo>(</mo><mrow><msub><mi>η</mi><mi>λ</mi></msub><mo>−</mo><mstyle displaystyle="true"><mfrac><mrow><mrow><mo stretchy="false">|</mo><mi class="ltx_font_mathcaligraphic">ℋ</mi><mo stretchy="false">|</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>R</mi><mi>max</mi><mn>2</mn></msubsup></mrow><mi>C</mi></mfrac></mstyle></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>δ</mi></mfrac></mstyle></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>θ</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>&gt;</mo><mn>0</mn></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\eta_{\lambda}-|\mathcal{H}|R_{\max}^{2}\left(\frac{1}{2C_{1}}+\frac{1}{2C_{2}}\right)+\left(\eta_{\lambda}-\frac{|\mathcal{H}|R_{\max}^{2}}{C}\right)(1-\frac{1}{\delta})(1-\theta)&gt;0.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div></li>
<li id="A5.I1.i2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">2.</span> 
<div id="A5.I1.i2.p1" class="ltx_para">
<p id="A5.I1.i2.p1.1" class="ltx_p">Multipliers of all terms of RHS of <a href="#A5.E68" title="In E.3 Combining A and B ‣ Appendix E Proof of ‣ Provable Last-Iterate Convergence for Multi-Objective Safe LLM Alignment via Optimistic Primal-Dual" class="ltx_ref"><span class="ltx_text ltx_ref_tag">eq.</span> <span class="ltx_text ltx_ref_tag">68</span></a> are positive:</p>
<table id="A5.Ex106" class="ltx_equationgroup ltx_eqn_table">

<tbody id="A5.Ex106X"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.Ex106X.m2" class="ltx_Math" alttext="\displaystyle\eta_{\theta}&gt;0," display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>η</mi><mi>θ</mi></msub><mo>&gt;</mo><mn>0</mn></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\eta_{\theta}&gt;0,</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A5.Ex106Xa"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.Ex106Xa.m2" class="ltx_Math" alttext="\displaystyle C_{2}&gt;0," display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>C</mi><mn>2</mn></msub><mo>&gt;</mo><mn>0</mn></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle C_{2}&gt;0,</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A5.Ex106Xb"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.Ex106Xb.m2" class="ltx_Math" alttext="\displaystyle\eta_{\lambda}-\left(\eta_{\lambda}-\frac{|\mathcal{H}|R_{\max}^{2}}{C}\right)(1-\frac{1}{\delta})(1-\frac{1}{\theta})&gt;0," display="inline" intent=":literal"><semantics><mrow><mrow><mrow><msub><mi>η</mi><mi>λ</mi></msub><mo>−</mo><mrow><mrow><mo>(</mo><mrow><msub><mi>η</mi><mi>λ</mi></msub><mo>−</mo><mstyle displaystyle="true"><mfrac><mrow><mrow><mo stretchy="false">|</mo><mi class="ltx_font_mathcaligraphic">ℋ</mi><mo stretchy="false">|</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>R</mi><mi>max</mi><mn>2</mn></msubsup></mrow><mi>C</mi></mfrac></mstyle></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>δ</mi></mfrac></mstyle></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>θ</mi></mfrac></mstyle></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>&gt;</mo><mn>0</mn></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\eta_{\lambda}-\left(\eta_{\lambda}-\frac{|\mathcal{H}|R_{\max}^{2}}{C}\right)(1-\frac{1}{\delta})(1-\frac{1}{\theta})&gt;0,</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A5.Ex106Xc"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.Ex106Xc.m2" class="ltx_Math" alttext="\displaystyle\frac{|\mathcal{H}|R_{\max}^{2}}{C}&gt;0," display="inline" intent=":literal"><semantics><mrow><mrow><mstyle displaystyle="true"><mfrac><mrow><mrow><mo stretchy="false">|</mo><mi class="ltx_font_mathcaligraphic">ℋ</mi><mo stretchy="false">|</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>R</mi><mi>max</mi><mn>2</mn></msubsup></mrow><mi>C</mi></mfrac></mstyle><mo>&gt;</mo><mn>0</mn></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\frac{|\mathcal{H}|R_{\max}^{2}}{C}&gt;0,</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A5.Ex106Xd"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.Ex106Xd.m2" class="ltx_Math" alttext="\displaystyle\eta_{\theta}-C_{1}&gt;0." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><msub><mi>η</mi><mi>θ</mi></msub><mo>−</mo><msub><mi>C</mi><mn>1</mn></msub></mrow><mo>&gt;</mo><mn>0</mn></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\eta_{\theta}-C_{1}&gt;0.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div></li>
<li id="A5.I1.i3" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">3.</span> 
<div id="A5.I1.i3.p1" class="ltx_para">
<p id="A5.I1.i3.p1.1" class="ltx_p">Define</p>
<table id="A5.Ex107" class="ltx_equationgroup ltx_eqn_table">

<tbody id="A5.Ex107X"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A5.Ex107X.m2" class="ltx_Math" alttext="\displaystyle\rho:=" display="inline" intent=":literal"><semantics><mrow><mi>ρ</mi><mo>:=</mo><mphantom></mphantom></mrow><annotation encoding="application/x-tex">\displaystyle\rho:=</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.Ex107X.m3" class="ltx_Math" alttext="\displaystyle\max\left(\frac{\eta_{\theta}}{\eta_{\theta}+\beta},\frac{C_{2}}{\eta_{\theta}+\beta-C},\frac{\eta_{\lambda}-\left(\eta_{\lambda}-\frac{|\mathcal{H}|R_{\max}^{2}}{C}\right)(1-\frac{1}{\delta})(1-\frac{1}{\theta})}{\eta_{\lambda}+\left(\eta_{\lambda}-\frac{|\mathcal{H}|R_{\max}^{2}}{C}\right)(1-\delta)},\right." display="inline" intent=":literal"><semantics><mrow><mi>max</mi><mo>(</mo><mstyle displaystyle="true"><mfrac><msub><mi>η</mi><mi>θ</mi></msub><mrow><msub><mi>η</mi><mi>θ</mi></msub><mo>+</mo><mi>β</mi></mrow></mfrac></mstyle><mo>,</mo><mstyle displaystyle="true"><mfrac><msub><mi>C</mi><mn>2</mn></msub><mrow><mrow><msub><mi>η</mi><mi>θ</mi></msub><mo>+</mo><mi>β</mi></mrow><mo>−</mo><mi>C</mi></mrow></mfrac></mstyle><mo>,</mo><mstyle displaystyle="true"><mfrac><mrow><msub><mi>η</mi><mi>λ</mi></msub><mo>−</mo><mrow><mrow><mo>(</mo><mrow><msub><mi>η</mi><mi>λ</mi></msub><mo>−</mo><mfrac><mrow><mrow><mo stretchy="false">|</mo><mi class="ltx_font_mathcaligraphic">ℋ</mi><mo stretchy="false">|</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>R</mi><mi>max</mi><mn>2</mn></msubsup></mrow><mi>C</mi></mfrac></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mfrac><mn>1</mn><mi>δ</mi></mfrac></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mfrac><mn>1</mn><mi>θ</mi></mfrac></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mrow><msub><mi>η</mi><mi>λ</mi></msub><mo>+</mo><mrow><mrow><mo>(</mo><mrow><msub><mi>η</mi><mi>λ</mi></msub><mo>−</mo><mfrac><mrow><mrow><mo stretchy="false">|</mo><mi class="ltx_font_mathcaligraphic">ℋ</mi><mo stretchy="false">|</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>R</mi><mi>max</mi><mn>2</mn></msubsup></mrow><mi>C</mi></mfrac></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>δ</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mfrac></mstyle><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\max\left(\frac{\eta_{\theta}}{\eta_{\theta}+\beta},\frac{C_{2}}{\eta_{\theta}+\beta-C},\frac{\eta_{\lambda}-\left(\eta_{\lambda}-\frac{|\mathcal{H}|R_{\max}^{2}}{C}\right)(1-\frac{1}{\delta})(1-\frac{1}{\theta})}{\eta_{\lambda}+\left(\eta_{\lambda}-\frac{|\mathcal{H}|R_{\max}^{2}}{C}\right)(1-\delta)},\right.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A5.Ex107Xa"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.Ex107Xa.m2" class="ltx_Math" alttext="\displaystyle\left.\frac{\frac{|\mathcal{H}|R_{\max}^{2}}{C}}{\eta_{\lambda}-|\mathcal{H}|R_{\max}^{2}\left(\frac{1}{2C_{1}}+\frac{1}{2C_{2}}\right)+\left(\eta_{\lambda}-\frac{|\mathcal{H}|R_{\max}^{2}}{C}\right)(1-\frac{1}{\delta})(1-\theta)}\right)," display="inline" intent=":literal"><semantics><mrow><mrow><mo fence="true" rspace="4.000em">OPEN</mo><mstyle displaystyle="true"><mfrac><mfrac><mrow><mrow><mo stretchy="false">|</mo><mi class="ltx_font_mathcaligraphic">ℋ</mi><mo stretchy="false">|</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>R</mi><mi>max</mi><mn>2</mn></msubsup></mrow><mi>C</mi></mfrac><mrow><mrow><msub><mi>η</mi><mi>λ</mi></msub><mo>−</mo><mrow><mrow><mo stretchy="false">|</mo><mi class="ltx_font_mathcaligraphic">ℋ</mi><mo stretchy="false">|</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>R</mi><mi>max</mi><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mfrac><mn>1</mn><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>C</mi><mn>1</mn></msub></mrow></mfrac><mo>+</mo><mfrac><mn>1</mn><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>C</mi><mn>2</mn></msub></mrow></mfrac></mrow><mo>)</mo></mrow></mrow></mrow><mo>+</mo><mrow><mrow><mo>(</mo><mrow><msub><mi>η</mi><mi>λ</mi></msub><mo>−</mo><mfrac><mrow><mrow><mo stretchy="false">|</mo><mi class="ltx_font_mathcaligraphic">ℋ</mi><mo stretchy="false">|</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>R</mi><mi>max</mi><mn>2</mn></msubsup></mrow><mi>C</mi></mfrac></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mfrac><mn>1</mn><mi>δ</mi></mfrac></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>θ</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mfrac></mstyle><mo>)</mo></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\left.\frac{\frac{|\mathcal{H}|R_{\max}^{2}}{C}}{\eta_{\lambda}-|\mathcal{H}|R_{\max}^{2}\left(\frac{1}{2C_{1}}+\frac{1}{2C_{2}}\right)+\left(\eta_{\lambda}-\frac{|\mathcal{H}|R_{\max}^{2}}{C}\right)(1-\frac{1}{\delta})(1-\theta)}\right),</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A5.I1.i3.p1.2" class="ltx_p">then <math id="A5.I1.i3.p1.m1" class="ltx_Math" alttext="\rho&lt;1" display="inline" intent=":literal"><semantics><mrow><mi>ρ</mi><mo>&lt;</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">\rho&lt;1</annotation></semantics></math>.</p>
</div></li>
</ol>
<p id="A5.SS3.p1.12" class="ltx_p">Then <a href="#A5.E68" title="In E.3 Combining A and B ‣ Appendix E Proof of ‣ Provable Last-Iterate Convergence for Multi-Objective Safe LLM Alignment via Optimistic Primal-Dual" class="ltx_ref"><span class="ltx_text ltx_ref_tag">eq.</span> <span class="ltx_text ltx_ref_tag">68</span></a> can be written as</p>
<table id="A5.Ex108" class="ltx_equationgroup ltx_eqn_table">

<tbody id="A5.Ex108X"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A5.Ex108X.m2" class="ltx_Math" alttext="\displaystyle\Phi_{t+1}\leq" display="inline" intent=":literal"><semantics><mrow><msub><mi mathvariant="normal">Φ</mi><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow></msub><mo>≤</mo><mphantom></mphantom></mrow><annotation encoding="application/x-tex">\displaystyle\Phi_{t+1}\leq</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.Ex108X.m3" class="ltx_Math" alttext="\displaystyle\rho\Phi_{t}-\left(\eta_{\theta}-C_{1}\right)\mathbb{E}_{x\sim\mathcal{D}}\left[\mathrm{KL}(\pi_{t}(\cdot|x)\|\hat{\pi}_{t}(\cdot|x))\right]{+2\mathrm{gap}(\varepsilon_{\mathrm{approx}},p_{\min})}\quad\text{(by the definition of $\rho$)}" display="inline" intent=":literal"><semantics><mrow><mi>ρ</mi><mi mathvariant="normal">Φ</mi><msub><mrow></mrow><mi>t</mi></msub><mo>−</mo><mo>(</mo><mi>η</mi><msub><mrow></mrow><mi>θ</mi></msub><mo>−</mo><mi>C</mi><msub><mrow></mrow><mn>1</mn></msub><mo>)</mo><mi>𝔼</mi><msub><mrow></mrow><mrow><mi>x</mi><mo>∼</mo><mi class="ltx_font_mathcaligraphic">𝒟</mi></mrow></msub><mo>[</mo><mi>KL</mi><mo stretchy="false">(</mo><mi>π</mi><msub><mrow></mrow><mi>t</mi></msub><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>x</mi><mo stretchy="false">)</mo><mo lspace="0em" rspace="0.167em">∥</mo><mover accent="true"><mi>π</mi><mo>^</mo></mover><msub><mrow></mrow><mi>t</mi></msub><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>x</mi><mo stretchy="false">)</mo><mo stretchy="false">)</mo><mo>]</mo><mo>+</mo><mn>2</mn><mi>gap</mi><mo stretchy="false">(</mo><mi>ε</mi><msub><mrow></mrow><mi>approx</mi></msub><mo>,</mo><mi>p</mi><msub><mrow></mrow><mi>min</mi></msub><mo stretchy="false">)</mo><mrow><mtext>(by the definition of </mtext><mi>ρ</mi><mtext>)</mtext></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\rho\Phi_{t}-\left(\eta_{\theta}-C_{1}\right)\mathbb{E}_{x\sim\mathcal{D}}\left[\mathrm{KL}(\pi_{t}(\cdot|x)\|\hat{\pi}_{t}(\cdot|x))\right]{+2\mathrm{gap}(\varepsilon_{\mathrm{approx}},p_{\min})}\quad\text{(by the definition of $\rho$)}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A5.Ex108Xa"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A5.Ex108Xa.m2" class="ltx_Math" alttext="\displaystyle\leq" display="inline" intent=":literal"><semantics><mo>≤</mo><annotation encoding="application/x-tex">\displaystyle\leq</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.Ex108Xa.m3" class="ltx_Math" alttext="\displaystyle\rho\Phi_{t}{+2\mathrm{gap}(\varepsilon_{\mathrm{approx}},p_{\min})}\quad\text{(by $\eta-C_{1}&gt;0$ and $\mathbb{E}_{x\sim\mathcal{D}}\left[\mathrm{KL}(\pi_{t}(\cdot|x)\|\hat{\pi}_{t}(\cdot|x))\right]&gt;0$)}" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mi>ρ</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi mathvariant="normal">Φ</mi><mi>t</mi></msub></mrow><mo>+</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>gap</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>ε</mi><mi>approx</mi></msub><mo>,</mo><msub><mi>p</mi><mi>min</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mspace style="width:1em;" width="1em"></mspace><mrow><mtext>(by </mtext><mrow><mrow><mi>η</mi><mo>−</mo><msub><mi>C</mi><mn>1</mn></msub></mrow><mo>&gt;</mo><mn>0</mn></mrow><mtext> and </mtext><mrow><msub><mi>𝔼</mi><mrow><mi>x</mi><mo>∼</mo><mi class="ltx_font_mathcaligraphic">𝒟</mi></mrow></msub><mrow><mo>[</mo><mi>KL</mi><mrow><mo stretchy="false">(</mo><msub><mi>π</mi><mi>t</mi></msub><mrow><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>x</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0.167em">∥</mo><msub><mover accent="true"><mi>π</mi><mo>^</mo></mover><mi>t</mi></msub><mrow><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>x</mi><mo stretchy="false">)</mo></mrow><mo stretchy="false">)</mo></mrow><mo>]</mo></mrow><mo>&gt;</mo><mn>0</mn></mrow><mtext>)</mtext></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\rho\Phi_{t}{+2\mathrm{gap}(\varepsilon_{\mathrm{approx}},p_{\min})}\quad\text{(by $\eta-C_{1}&gt;0$ and $\mathbb{E}_{x\sim\mathcal{D}}\left[\mathrm{KL}(\pi_{t}(\cdot|x)\|\hat{\pi}_{t}(\cdot|x))\right]&gt;0$)}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A5.SS3.p1.13" class="ltx_p">Iteratively apply the recursion, we have <math id="A5.SS3.p1.m5" class="ltx_Math" alttext="\Phi_{t}\leq\rho^{t}\Phi_{1}" display="inline" intent=":literal"><semantics><mrow><msub><mi mathvariant="normal">Φ</mi><mi>t</mi></msub><mo>≤</mo><mrow><msup><mi>ρ</mi><mi>t</mi></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi mathvariant="normal">Φ</mi><mn>1</mn></msub></mrow></mrow><annotation encoding="application/x-tex">\Phi_{t}\leq\rho^{t}\Phi_{1}</annotation></semantics></math>, where</p>
<table id="A5.Ex109" class="ltx_equationgroup ltx_eqn_table">

<tbody id="A5.Ex109X"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A5.Ex109X.m2" class="ltx_Math" alttext="\displaystyle\Phi_{1}=" display="inline" intent=":literal"><semantics><mrow><msub><mi mathvariant="normal">Φ</mi><mn>1</mn></msub><mo>=</mo><mphantom></mphantom></mrow><annotation encoding="application/x-tex">\displaystyle\Phi_{1}=</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.Ex109X.m3" class="ltx_Math" alttext="\displaystyle(\eta_{\theta}+\beta)\mathbb{E}_{x\sim\mathcal{D}}\left[\mathrm{KL}(\pi^{\star}(\cdot|x)\|\hat{\pi}_{1}(\cdot|x))\right]+(\eta_{\theta}+\beta-C)\mathbb{E}_{x\sim\mathcal{D}}\left[\mathrm{KL}(\hat{\pi}_{1}(\cdot|x)\|\pi_{0}(\cdot|x))\right]" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi>η</mi><msub><mrow></mrow><mi>θ</mi></msub><mo>+</mo><mi>β</mi><mo stretchy="false">)</mo><mi>𝔼</mi><msub><mrow></mrow><mrow><mi>x</mi><mo>∼</mo><mi class="ltx_font_mathcaligraphic">𝒟</mi></mrow></msub><mo>[</mo><mi>KL</mi><mo stretchy="false">(</mo><mi>π</mi><msup><mrow></mrow><mo>⋆</mo></msup><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>x</mi><mo stretchy="false">)</mo><mo lspace="0em" rspace="0.167em">∥</mo><mover accent="true"><mi>π</mi><mo>^</mo></mover><msub><mrow></mrow><mn>1</mn></msub><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>x</mi><mo stretchy="false">)</mo><mo stretchy="false">)</mo><mo>]</mo><mo>+</mo><mo stretchy="false">(</mo><mi>η</mi><msub><mrow></mrow><mi>θ</mi></msub><mo>+</mo><mi>β</mi><mo>−</mo><mi>C</mi><mo stretchy="false">)</mo><mi>𝔼</mi><msub><mrow></mrow><mrow><mi>x</mi><mo>∼</mo><mi class="ltx_font_mathcaligraphic">𝒟</mi></mrow></msub><mo>[</mo><mi>KL</mi><mo stretchy="false">(</mo><mover accent="true"><mi>π</mi><mo>^</mo></mover><msub><mrow></mrow><mn>1</mn></msub><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>x</mi><mo stretchy="false">)</mo><mo lspace="0em" rspace="0.167em">∥</mo><mi>π</mi><msub><mrow></mrow><mn>0</mn></msub><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>x</mi><mo stretchy="false">)</mo><mo stretchy="false">)</mo><mo>]</mo></mrow><annotation encoding="application/x-tex">\displaystyle(\eta_{\theta}+\beta)\mathbb{E}_{x\sim\mathcal{D}}\left[\mathrm{KL}(\pi^{\star}(\cdot|x)\|\hat{\pi}_{1}(\cdot|x))\right]+(\eta_{\theta}+\beta-C)\mathbb{E}_{x\sim\mathcal{D}}\left[\mathrm{KL}(\hat{\pi}_{1}(\cdot|x)\|\pi_{0}(\cdot|x))\right]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A5.Ex109Xa"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.Ex109Xa.m2" class="ltx_Math" alttext="\displaystyle+\left(\eta_{\lambda}+\left(\eta_{\lambda}-\frac{|\mathcal{H}|R_{\max}^{2}}{C}\right)(1-\delta)\right)\|\boldsymbol{\lambda}^{\star}-\hat{\boldsymbol{\lambda}}_{1}\|_{2}^{2}" display="inline" intent=":literal"><semantics><mrow><mo>+</mo><mrow><mrow><mo>(</mo><mrow><msub><mi>η</mi><mi>λ</mi></msub><mo>+</mo><mrow><mrow><mo>(</mo><mrow><msub><mi>η</mi><mi>λ</mi></msub><mo>−</mo><mstyle displaystyle="true"><mfrac><mrow><mrow><mo stretchy="false">|</mo><mi class="ltx_font_mathcaligraphic">ℋ</mi><mo stretchy="false">|</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>R</mi><mi>max</mi><mn>2</mn></msubsup></mrow><mi>C</mi></mfrac></mstyle></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>δ</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msubsup><mrow><mo stretchy="false">‖</mo><mrow><msup><mi>𝝀</mi><mo>⋆</mo></msup><mo>−</mo><msub><mover accent="true"><mi>𝝀</mi><mo>^</mo></mover><mn>1</mn></msub></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn><mn>2</mn></msubsup></mrow></mrow><annotation encoding="application/x-tex">\displaystyle+\left(\eta_{\lambda}+\left(\eta_{\lambda}-\frac{|\mathcal{H}|R_{\max}^{2}}{C}\right)(1-\delta)\right)\|\boldsymbol{\lambda}^{\star}-\hat{\boldsymbol{\lambda}}_{1}\|_{2}^{2}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A5.Ex109Xb"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.Ex109Xb.m2" class="ltx_Math" alttext="\displaystyle+\left(\eta_{\lambda}-|\mathcal{H}|R_{\max}^{2}\left(\frac{1}{2C_{1}}+\frac{1}{2C_{2}}\right)+\left(\eta_{\lambda}-\frac{|\mathcal{H}|R_{\max}^{2}}{C}\right)(1-\frac{1}{\delta})(1-\theta)\right)\|\hat{\boldsymbol{\lambda}}_{1}-\boldsymbol{\lambda}_{0}\|_{2}^{2}." display="inline" intent=":literal"><semantics><mrow><mrow><mo>+</mo><mrow><mrow><mo>(</mo><mrow><mrow><msub><mi>η</mi><mi>λ</mi></msub><mo>−</mo><mrow><mrow><mo stretchy="false">|</mo><mi class="ltx_font_mathcaligraphic">ℋ</mi><mo stretchy="false">|</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>R</mi><mi>max</mi><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>C</mi><mn>1</mn></msub></mrow></mfrac></mstyle><mo>+</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>C</mi><mn>2</mn></msub></mrow></mfrac></mstyle></mrow><mo>)</mo></mrow></mrow></mrow><mo>+</mo><mrow><mrow><mo>(</mo><mrow><msub><mi>η</mi><mi>λ</mi></msub><mo>−</mo><mstyle displaystyle="true"><mfrac><mrow><mrow><mo stretchy="false">|</mo><mi class="ltx_font_mathcaligraphic">ℋ</mi><mo stretchy="false">|</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>R</mi><mi>max</mi><mn>2</mn></msubsup></mrow><mi>C</mi></mfrac></mstyle></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>δ</mi></mfrac></mstyle></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>θ</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msubsup><mrow><mo stretchy="false">‖</mo><mrow><msub><mover accent="true"><mi>𝝀</mi><mo>^</mo></mover><mn>1</mn></msub><mo>−</mo><msub><mi>𝝀</mi><mn>0</mn></msub></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn><mn>2</mn></msubsup></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle+\left(\eta_{\lambda}-|\mathcal{H}|R_{\max}^{2}\left(\frac{1}{2C_{1}}+\frac{1}{2C_{2}}\right)+\left(\eta_{\lambda}-\frac{|\mathcal{H}|R_{\max}^{2}}{C}\right)(1-\frac{1}{\delta})(1-\theta)\right)\|\hat{\boldsymbol{\lambda}}_{1}-\boldsymbol{\lambda}_{0}\|_{2}^{2}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="A5.SS3.p2" class="ltx_para">
<p id="A5.SS3.p2.1" class="ltx_p">Note that we initialize <math id="A5.SS3.p2.m1" class="ltx_Math" alttext="\hat{\pi}_{0}" display="inline" intent=":literal"><semantics><msub><mover accent="true"><mi>π</mi><mo>^</mo></mover><mn>0</mn></msub><annotation encoding="application/x-tex">\hat{\pi}_{0}</annotation></semantics></math> having the same support set as <math id="A5.SS3.p2.m2" class="ltx_Math" alttext="\pi_{\mathrm{ref}}" display="inline" intent=":literal"><semantics><msub><mi>π</mi><mi>ref</mi></msub><annotation encoding="application/x-tex">\pi_{\mathrm{ref}}</annotation></semantics></math>.
Since we use a softmax parameterization over a finite action space, all policies have full support. Hence, the KL terms in <math id="A5.SS3.p2.m3" class="ltx_Math" alttext="\Phi_{1}" display="inline" intent=":literal"><semantics><msub><mi mathvariant="normal">Φ</mi><mn>1</mn></msub><annotation encoding="application/x-tex">\Phi_{1}</annotation></semantics></math> are finite and <math id="A5.SS3.p2.m4" class="ltx_Math" alttext="\Phi_{1}" display="inline" intent=":literal"><semantics><msub><mi mathvariant="normal">Φ</mi><mn>1</mn></msub><annotation encoding="application/x-tex">\Phi_{1}</annotation></semantics></math> is bounded.</p>
</div>
<div id="A5.SS3.p3" class="ltx_para">
<p id="A5.SS3.p3.1" class="ltx_p">Furthermore, we have</p>
<table id="A5.Ex110" class="ltx_equationgroup ltx_eqn_table">

<tbody id="A5.Ex110X"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A5.Ex110X.m2" class="ltx_Math" alttext="\displaystyle\mathbb{E}_{x\sim\mathcal{D}}\left[\mathrm{KL}(\pi^{\star}(\cdot|x)\|\hat{\pi}_{t}(\cdot|x))\right]+\|\boldsymbol{\lambda}^{\star}-\hat{\boldsymbol{\lambda}}_{t}\|_{2}^{2}\leq\rho^{t}\frac{\Phi_{1}}{\rho\min\left(\eta_{\theta}+\beta,\eta_{\lambda}+\left(\eta_{\lambda}-\frac{|\mathcal{H}|R_{\max}^{2}}{C}\right)(1-\delta)\right)}{\color[rgb]{0.75,0,0.25}+\frac{2(1-\rho^{t})\mathrm{gap}}{1-\rho}}" display="inline" intent=":literal"><semantics><mrow><mi>𝔼</mi><msub><mrow></mrow><mrow><mi>x</mi><mo>∼</mo><mi class="ltx_font_mathcaligraphic">𝒟</mi></mrow></msub><mo>[</mo><mi>KL</mi><mo stretchy="false">(</mo><mi>π</mi><msup><mrow></mrow><mo>⋆</mo></msup><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>x</mi><mo stretchy="false">)</mo><mo lspace="0em" rspace="0.167em">∥</mo><mover accent="true"><mi>π</mi><mo>^</mo></mover><msub><mrow></mrow><mi>t</mi></msub><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>x</mi><mo stretchy="false">)</mo><mo stretchy="false">)</mo><mo>]</mo><mo rspace="0em">+</mo><mo lspace="0em" rspace="0.167em">∥</mo><mi>𝝀</mi><msup><mrow></mrow><mo>⋆</mo></msup><mo>−</mo><mover accent="true"><mi>𝝀</mi><mo>^</mo></mover><msub><mrow></mrow><mi>t</mi></msub><mo lspace="0em" rspace="0.0835em">∥</mo><msub><mrow></mrow><mn>2</mn></msub><msup><mrow></mrow><mn>2</mn></msup><mo lspace="0.0835em">≤</mo><mi>ρ</mi><msup><mrow></mrow><mi>t</mi></msup><mstyle displaystyle="true"><mfrac><msub><mi mathvariant="normal">Φ</mi><mn>1</mn></msub><mrow><mi>ρ</mi><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>min</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><msub><mi>η</mi><mi>θ</mi></msub><mo>+</mo><mi>β</mi></mrow><mo>,</mo><mrow><msub><mi>η</mi><mi>λ</mi></msub><mo>+</mo><mrow><mrow><mo>(</mo><mrow><msub><mi>η</mi><mi>λ</mi></msub><mo>−</mo><mfrac><mrow><mrow><mo stretchy="false">|</mo><mi class="ltx_font_mathcaligraphic">ℋ</mi><mo stretchy="false">|</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>R</mi><mi>max</mi><mn>2</mn></msubsup></mrow><mi>C</mi></mfrac></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>δ</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>)</mo></mrow></mrow></mrow></mfrac></mstyle><mo style="--ltx-fg-color:#BF0040;" mathcolor="#BF0040">+</mo><mstyle displaystyle="true"><mfrac style="--ltx-fg-color:#BF0040;" mathcolor="#BF0040"><mrow><mn style="--ltx-fg-color:#BF0040;" mathcolor="#BF0040">2</mn><mo lspace="0em" rspace="0em">​</mo><mrow><mo style="--ltx-fg-color:#BF0040;" mathcolor="#BF0040" stretchy="false">(</mo><mrow><mn style="--ltx-fg-color:#BF0040;" mathcolor="#BF0040">1</mn><mo style="--ltx-fg-color:#BF0040;" mathcolor="#BF0040">−</mo><msup><mi style="--ltx-fg-color:#BF0040;" mathcolor="#BF0040">ρ</mi><mi style="--ltx-fg-color:#BF0040;" mathcolor="#BF0040">t</mi></msup></mrow><mo style="--ltx-fg-color:#BF0040;" mathcolor="#BF0040" stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi style="--ltx-fg-color:#BF0040;" mathcolor="#BF0040">gap</mi></mrow><mrow><mn style="--ltx-fg-color:#BF0040;" mathcolor="#BF0040">1</mn><mo style="--ltx-fg-color:#BF0040;" mathcolor="#BF0040">−</mo><mi style="--ltx-fg-color:#BF0040;" mathcolor="#BF0040">ρ</mi></mrow></mfrac></mstyle></mrow><annotation encoding="application/x-tex">\displaystyle\mathbb{E}_{x\sim\mathcal{D}}\left[\mathrm{KL}(\pi^{\star}(\cdot|x)\|\hat{\pi}_{t}(\cdot|x))\right]+\|\boldsymbol{\lambda}^{\star}-\hat{\boldsymbol{\lambda}}_{t}\|_{2}^{2}\leq\rho^{t}\frac{\Phi_{1}}{\rho\min\left(\eta_{\theta}+\beta,\eta_{\lambda}+\left(\eta_{\lambda}-\frac{|\mathcal{H}|R_{\max}^{2}}{C}\right)(1-\delta)\right)}{\color[rgb]{0.75,0,0.25}+\frac{2(1-\rho^{t})\mathrm{gap}}{1-\rho}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A5.SS3.p3.2" class="ltx_p">and this shows the desired result.</p>
</div>
<section id="A5.SS3.SSS0.Px1" class="ltx_paragraph">
<h5 class="ltx_title ltx_title_paragraph">Hyperparameters and Constants Selection</h5>

<div id="A5.SS3.SSS0.Px1.p1" class="ltx_para">
<p id="A5.SS3.SSS0.Px1.p1.1" class="ltx_p">Our next step is to choose hyperparameters <math id="A5.SS3.SSS0.Px1.p1.m1" class="ltx_Math" alttext="\eta_{\theta}" display="inline" intent=":literal"><semantics><msub><mi>η</mi><mi>θ</mi></msub><annotation encoding="application/x-tex">\eta_{\theta}</annotation></semantics></math> and <math id="A5.SS3.SSS0.Px1.p1.m2" class="ltx_Math" alttext="\eta_{\lambda}" display="inline" intent=":literal"><semantics><msub><mi>η</mi><mi>λ</mi></msub><annotation encoding="application/x-tex">\eta_{\lambda}</annotation></semantics></math> as well as constants <math id="A5.SS3.SSS0.Px1.p1.m3" class="ltx_Math" alttext="C_{1}" display="inline" intent=":literal"><semantics><msub><mi>C</mi><mn>1</mn></msub><annotation encoding="application/x-tex">C_{1}</annotation></semantics></math>, <math id="A5.SS3.SSS0.Px1.p1.m4" class="ltx_Math" alttext="C_{2}" display="inline" intent=":literal"><semantics><msub><mi>C</mi><mn>2</mn></msub><annotation encoding="application/x-tex">C_{2}</annotation></semantics></math>, and <math id="A5.SS3.SSS0.Px1.p1.m5" class="ltx_Math" alttext="C" display="inline" intent=":literal"><semantics><mi>C</mi><annotation encoding="application/x-tex">C</annotation></semantics></math> to satisfy the requirements.
For simplicity, with a little abuse of notations, we denote <math id="A5.SS3.SSS0.Px1.p1.m6" class="ltx_Math" alttext="h=|\mathcal{H}|" display="inline" intent=":literal"><semantics><mrow><mi>h</mi><mo>=</mo><mrow><mo stretchy="false">|</mo><mi class="ltx_font_mathcaligraphic">ℋ</mi><mo stretchy="false">|</mo></mrow></mrow><annotation encoding="application/x-tex">h=|\mathcal{H}|</annotation></semantics></math> and <math id="A5.SS3.SSS0.Px1.p1.m7" class="ltx_Math" alttext="R=R_{\max}" display="inline" intent=":literal"><semantics><mrow><mi>R</mi><mo>=</mo><msub><mi>R</mi><mi>max</mi></msub></mrow><annotation encoding="application/x-tex">R=R_{\max}</annotation></semantics></math> in this parameter and constants selection section.
Let</p>
<table id="A5.Ex111" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A5.Ex111.m1" class="ltx_Math" alttext="\eta_{\theta}=\eta_{\lambda}=\eta=3\sqrt{h}R,\quad C_{1}=C_{2}=C=\sqrt{h}R,\quad\frac{1}{2}&lt;\delta&lt;1,\quad\frac{1}{2}&lt;\theta&lt;1." display="block" intent=":literal"><semantics><mrow><mrow><mrow><msub><mi>η</mi><mi>θ</mi></msub><mo>=</mo><msub><mi>η</mi><mi>λ</mi></msub><mo>=</mo><mi>η</mi><mo>=</mo><mrow><mn>3</mn><mo lspace="0em" rspace="0em">​</mo><msqrt><mi>h</mi></msqrt><mo lspace="0em" rspace="0em">​</mo><mi>R</mi></mrow></mrow><mo rspace="1.167em">,</mo><mrow><msub><mi>C</mi><mn>1</mn></msub><mo>=</mo><msub><mi>C</mi><mn>2</mn></msub><mo>=</mo><mi>C</mi><mo>=</mo><mrow><msqrt><mi>h</mi></msqrt><mo lspace="0em" rspace="0em">​</mo><mi>R</mi></mrow></mrow><mo rspace="1.167em">,</mo><mrow><mfrac><mn>1</mn><mn>2</mn></mfrac><mo>&lt;</mo><mi>δ</mi><mo>&lt;</mo><mn>1</mn></mrow><mo rspace="1.167em">,</mo><mrow><mfrac><mn>1</mn><mn>2</mn></mfrac><mo>&lt;</mo><mi>θ</mi><mo>&lt;</mo><mn>1</mn></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\eta_{\theta}=\eta_{\lambda}=\eta=3\sqrt{h}R,\quad C_{1}=C_{2}=C=\sqrt{h}R,\quad\frac{1}{2}&lt;\delta&lt;1,\quad\frac{1}{2}&lt;\theta&lt;1.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A5.SS3.SSS0.Px1.p1.2" class="ltx_p">We will verify that this set of parameters satisfies the requirements.</p>
</div>
<div id="A5.SS3.SSS0.Px1.p2" class="ltx_para">
<ol id="A5.I2" class="ltx_enumerate">
<li id="A5.I2.i0" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">0.</span> 
<div id="A5.I2.i0.p1" class="ltx_para">
<p id="A5.I2.i0.p1.1" class="ltx_p"><span id="A5.I2.i0.p1.1.1" class="ltx_text ltx_font_bold">Verification of <math id="A5.I2.i0.p1.m1" class="ltx_Math" alttext="\eta_{\lambda}&gt;\frac{|\mathcal{H}|R_{\max}^{2}}{C}" display="inline" intent=":literal"><semantics><mrow><msub><mi>η</mi><mi>λ</mi></msub><mo>&gt;</mo><mfrac><mrow><mrow><mo stretchy="false">|</mo><mi class="ltx_font_mathcaligraphic">ℋ</mi><mo stretchy="false">|</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>R</mi><mi>max</mi><mn>2</mn></msubsup></mrow><mi>C</mi></mfrac></mrow><annotation encoding="application/x-tex">\eta_{\lambda}&gt;\frac{|\mathcal{H}|R_{\max}^{2}}{C}</annotation></semantics></math></span>. <math id="A5.I2.i0.p1.m2" class="ltx_Math" alttext="\eta_{\lambda}=3\sqrt{h}R\geq\sqrt{h}R=\frac{hR^{2}}{\sqrt{h}R}=\frac{hR^{2}}{C}" display="inline" intent=":literal"><semantics><mrow><msub><mi>η</mi><mi>λ</mi></msub><mo>=</mo><mrow><mn>3</mn><mo lspace="0em" rspace="0em">​</mo><msqrt><mi>h</mi></msqrt><mo lspace="0em" rspace="0em">​</mo><mi>R</mi></mrow><mo>≥</mo><mrow><msqrt><mi>h</mi></msqrt><mo lspace="0em" rspace="0em">​</mo><mi>R</mi></mrow><mo>=</mo><mfrac><mrow><mi>h</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>R</mi><mn>2</mn></msup></mrow><mrow><msqrt><mi>h</mi></msqrt><mo lspace="0em" rspace="0em">​</mo><mi>R</mi></mrow></mfrac><mo>=</mo><mfrac><mrow><mi>h</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>R</mi><mn>2</mn></msup></mrow><mi>C</mi></mfrac></mrow><annotation encoding="application/x-tex">\eta_{\lambda}=3\sqrt{h}R\geq\sqrt{h}R=\frac{hR^{2}}{\sqrt{h}R}=\frac{hR^{2}}{C}</annotation></semantics></math>.</p>
</div></li>
<li id="A5.I2.i1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">1.</span> 
<div id="A5.I2.i1.p1" class="ltx_para">
<p id="A5.I2.i1.p1.1" class="ltx_p"><span id="A5.I2.i1.p1.1.1" class="ltx_text ltx_font_bold">Verifications that multipliers of all terms of LHS of <a href="#A5.E68" title="In E.3 Combining A and B ‣ Appendix E Proof of ‣ Provable Last-Iterate Convergence for Multi-Objective Safe LLM Alignment via Optimistic Primal-Dual" class="ltx_ref"><span class="ltx_text ltx_ref_tag">eq.</span> <span class="ltx_text ltx_ref_tag">68</span></a> are positive</span>.
(1) Since <math id="A5.I2.i1.p1.m1" class="ltx_Math" alttext="\eta_{\theta}&gt;0" display="inline" intent=":literal"><semantics><mrow><msub><mi>η</mi><mi>θ</mi></msub><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\eta_{\theta}&gt;0</annotation></semantics></math> and <math id="A5.I2.i1.p1.m2" class="ltx_Math" alttext="\beta&gt;0" display="inline" intent=":literal"><semantics><mrow><mi>β</mi><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\beta&gt;0</annotation></semantics></math>, we have <math id="A5.I2.i1.p1.m3" class="ltx_Math" alttext="\eta_{\theta}+\beta&gt;0" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>η</mi><mi>θ</mi></msub><mo>+</mo><mi>β</mi></mrow><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\eta_{\theta}+\beta&gt;0</annotation></semantics></math>.
(2) <math id="A5.I2.i1.p1.m4" class="ltx_Math" alttext="\eta_{\theta}+\beta-C=\beta+2\sqrt{h}R&gt;0" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><msub><mi>η</mi><mi>θ</mi></msub><mo>+</mo><mi>β</mi></mrow><mo>−</mo><mi>C</mi></mrow><mo>=</mo><mrow><mi>β</mi><mo>+</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msqrt><mi>h</mi></msqrt><mo lspace="0em" rspace="0em">​</mo><mi>R</mi></mrow></mrow><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\eta_{\theta}+\beta-C=\beta+2\sqrt{h}R&gt;0</annotation></semantics></math>.
(3) Since <math id="A5.I2.i1.p1.m5" class="ltx_Math" alttext="\eta_{\lambda}-hR^{2}/C=3\sqrt{h}R-hR^{2}/(\sqrt{h}R)=2\sqrt{h}R&gt;0" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>η</mi><mi>λ</mi></msub><mo>−</mo><mrow><mrow><mi>h</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>R</mi><mn>2</mn></msup></mrow><mo>/</mo><mi>C</mi></mrow></mrow><mo>=</mo><mrow><mrow><mn>3</mn><mo lspace="0em" rspace="0em">​</mo><msqrt><mi>h</mi></msqrt><mo lspace="0em" rspace="0em">​</mo><mi>R</mi></mrow><mo>−</mo><mrow><mrow><mi>h</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>R</mi><mn>2</mn></msup></mrow><mo>/</mo><mrow><mo stretchy="false">(</mo><mrow><msqrt><mi>h</mi></msqrt><mo lspace="0em" rspace="0em">​</mo><mi>R</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>=</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msqrt><mi>h</mi></msqrt><mo lspace="0em" rspace="0em">​</mo><mi>R</mi></mrow><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\eta_{\lambda}-hR^{2}/C=3\sqrt{h}R-hR^{2}/(\sqrt{h}R)=2\sqrt{h}R&gt;0</annotation></semantics></math> and <math id="A5.I2.i1.p1.m6" class="ltx_Math" alttext="\delta&lt;1" display="inline" intent=":literal"><semantics><mrow><mi>δ</mi><mo>&lt;</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">\delta&lt;1</annotation></semantics></math>, we have <math id="A5.I2.i1.p1.m7" class="ltx_Math" alttext="\left(\eta_{\lambda}-hR^{2}/C\right)(1-\delta)&gt;0" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mo>(</mo><mrow><msub><mi>η</mi><mi>λ</mi></msub><mo>−</mo><mrow><mrow><mi>h</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>R</mi><mn>2</mn></msup></mrow><mo>/</mo><mi>C</mi></mrow></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>δ</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\left(\eta_{\lambda}-hR^{2}/C\right)(1-\delta)&gt;0</annotation></semantics></math>. Hence <math id="A5.I2.i1.p1.m8" class="ltx_Math" alttext="\eta_{\lambda}+\left(\eta_{\lambda}-hR^{2}/C\right)(1-\delta)&gt;0" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>η</mi><mi>λ</mi></msub><mo>+</mo><mrow><mrow><mo>(</mo><mrow><msub><mi>η</mi><mi>λ</mi></msub><mo>−</mo><mrow><mrow><mi>h</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>R</mi><mn>2</mn></msup></mrow><mo>/</mo><mi>C</mi></mrow></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>δ</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\eta_{\lambda}+\left(\eta_{\lambda}-hR^{2}/C\right)(1-\delta)&gt;0</annotation></semantics></math>.
(4) <math id="A5.I2.i1.p1.m9" class="ltx_Math" alttext="\eta_{\lambda}-hR^{2}\left(1/(2C_{1})+1/(2C_{2})\right)+\left(\eta_{\lambda}-hR^{2}/C\right)(1-1/\delta)(1-\theta)=3\sqrt{h}R-hR^{2}/(\sqrt{h}R)+(2\sqrt{h}R-hR^{2}/(\sqrt{h}R))(1-1/\delta)(1-\theta)=\sqrt{h}R\left(2+\left(1-1/\delta\right)\left(1-\theta\right)\right)" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><msub><mi>η</mi><mi>λ</mi></msub><mo>−</mo><mrow><mi>h</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>R</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mrow><mn>1</mn><mo>/</mo><mrow><mo stretchy="false">(</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>C</mi><mn>1</mn></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mrow><mn>1</mn><mo>/</mo><mrow><mo stretchy="false">(</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>C</mi><mn>2</mn></msub></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>)</mo></mrow></mrow></mrow><mo>+</mo><mrow><mrow><mo>(</mo><mrow><msub><mi>η</mi><mi>λ</mi></msub><mo>−</mo><mrow><mrow><mi>h</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>R</mi><mn>2</mn></msup></mrow><mo>/</mo><mi>C</mi></mrow></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mrow><mn>1</mn><mo>/</mo><mi>δ</mi></mrow></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>θ</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>=</mo><mrow><mrow><mrow><mn>3</mn><mo lspace="0em" rspace="0em">​</mo><msqrt><mi>h</mi></msqrt><mo lspace="0em" rspace="0em">​</mo><mi>R</mi></mrow><mo>−</mo><mrow><mrow><mi>h</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>R</mi><mn>2</mn></msup></mrow><mo>/</mo><mrow><mo stretchy="false">(</mo><mrow><msqrt><mi>h</mi></msqrt><mo lspace="0em" rspace="0em">​</mo><mi>R</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>+</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msqrt><mi>h</mi></msqrt><mo lspace="0em" rspace="0em">​</mo><mi>R</mi></mrow><mo>−</mo><mrow><mrow><mi>h</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>R</mi><mn>2</mn></msup></mrow><mo>/</mo><mrow><mo stretchy="false">(</mo><mrow><msqrt><mi>h</mi></msqrt><mo lspace="0em" rspace="0em">​</mo><mi>R</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mrow><mn>1</mn><mo>/</mo><mi>δ</mi></mrow></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>θ</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>=</mo><mrow><msqrt><mi>h</mi></msqrt><mo lspace="0em" rspace="0em">​</mo><mi>R</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mn>2</mn><mo>+</mo><mrow><mrow><mo>(</mo><mrow><mn>1</mn><mo>−</mo><mrow><mn>1</mn><mo>/</mo><mi>δ</mi></mrow></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mn>1</mn><mo>−</mo><mi>θ</mi></mrow><mo>)</mo></mrow></mrow></mrow><mo>)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\eta_{\lambda}-hR^{2}\left(1/(2C_{1})+1/(2C_{2})\right)+\left(\eta_{\lambda}-hR^{2}/C\right)(1-1/\delta)(1-\theta)=3\sqrt{h}R-hR^{2}/(\sqrt{h}R)+(2\sqrt{h}R-hR^{2}/(\sqrt{h}R))(1-1/\delta)(1-\theta)=\sqrt{h}R\left(2+\left(1-1/\delta\right)\left(1-\theta\right)\right)</annotation></semantics></math>.
Since <math id="A5.I2.i1.p1.m10" class="ltx_Math" alttext="1/2&lt;\delta,\theta&lt;1" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mn>1</mn><mo>/</mo><mn>2</mn></mrow><mo>&lt;</mo><mi>δ</mi></mrow><mo>,</mo><mrow><mi>θ</mi><mo>&lt;</mo><mn>1</mn></mrow></mrow><annotation encoding="application/x-tex">1/2&lt;\delta,\theta&lt;1</annotation></semantics></math>, we have <math id="A5.I2.i1.p1.m11" class="ltx_Math" alttext="-1&lt;1-1/\delta&lt;0" display="inline" intent=":literal"><semantics><mrow><mrow><mo>−</mo><mn>1</mn></mrow><mo>&lt;</mo><mrow><mn>1</mn><mo>−</mo><mrow><mn>1</mn><mo>/</mo><mi>δ</mi></mrow></mrow><mo>&lt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">-1&lt;1-1/\delta&lt;0</annotation></semantics></math> and <math id="A5.I2.i1.p1.m12" class="ltx_Math" alttext="0&lt;1-\theta&lt;1/2" display="inline" intent=":literal"><semantics><mrow><mn>0</mn><mo>&lt;</mo><mrow><mn>1</mn><mo>−</mo><mi>θ</mi></mrow><mo>&lt;</mo><mrow><mn>1</mn><mo>/</mo><mn>2</mn></mrow></mrow><annotation encoding="application/x-tex">0&lt;1-\theta&lt;1/2</annotation></semantics></math>, hence <math id="A5.I2.i1.p1.m13" class="ltx_math_unparsed" alttext="-1/2&lt;\left(1-1/\delta\right)\left(1-\theta\right)&lt;0" display="inline" intent=":literal"><semantics><mrow><mo>−</mo><mn>1</mn><mo>/</mo><mn>2</mn><mo>&lt;</mo><mrow><mo>(</mo><mn>1</mn><mo>−</mo><mn>1</mn><mo>/</mo><mi>δ</mi><mo>)</mo></mrow><mrow><mo>(</mo><mn>1</mn><mo>−</mo><mi>θ</mi><mo>)</mo></mrow><mo>&lt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">-1/2&lt;\left(1-1/\delta\right)\left(1-\theta\right)&lt;0</annotation></semantics></math>.
Therefore, <math id="A5.I2.i1.p1.m14" class="ltx_Math" alttext="2+\left(1-1/\delta\right)\left(1-\theta\right)&gt;0" display="inline" intent=":literal"><semantics><mrow><mrow><mn>2</mn><mo>+</mo><mrow><mrow><mo>(</mo><mrow><mn>1</mn><mo>−</mo><mrow><mn>1</mn><mo>/</mo><mi>δ</mi></mrow></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mn>1</mn><mo>−</mo><mi>θ</mi></mrow><mo>)</mo></mrow></mrow></mrow><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">2+\left(1-1/\delta\right)\left(1-\theta\right)&gt;0</annotation></semantics></math>.</p>
</div></li>
<li id="A5.I2.i2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">2.</span> 
<div id="A5.I2.i2.p1" class="ltx_para">
<p id="A5.I2.i2.p1.1" class="ltx_p"><span id="A5.I2.i2.p1.1.1" class="ltx_text ltx_font_bold">Verifications that the multipliers of all terms of the RHS of <a href="#A5.E68" title="In E.3 Combining A and B ‣ Appendix E Proof of ‣ Provable Last-Iterate Convergence for Multi-Objective Safe LLM Alignment via Optimistic Primal-Dual" class="ltx_ref"><span class="ltx_text ltx_ref_tag">eq.</span> <span class="ltx_text ltx_ref_tag">68</span></a> are positive</span>.
(1) <math id="A5.I2.i2.p1.m1" class="ltx_Math" alttext="\eta_{\theta}&gt;0" display="inline" intent=":literal"><semantics><mrow><msub><mi>η</mi><mi>θ</mi></msub><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\eta_{\theta}&gt;0</annotation></semantics></math> by the definition of <math id="A5.I2.i2.p1.m2" class="ltx_Math" alttext="\eta_{\theta}" display="inline" intent=":literal"><semantics><msub><mi>η</mi><mi>θ</mi></msub><annotation encoding="application/x-tex">\eta_{\theta}</annotation></semantics></math>.
(2) <math id="A5.I2.i2.p1.m3" class="ltx_Math" alttext="C_{2}&gt;0" display="inline" intent=":literal"><semantics><mrow><msub><mi>C</mi><mn>2</mn></msub><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">C_{2}&gt;0</annotation></semantics></math> by the definition of <math id="A5.I2.i2.p1.m4" class="ltx_Math" alttext="C_{2}" display="inline" intent=":literal"><semantics><msub><mi>C</mi><mn>2</mn></msub><annotation encoding="application/x-tex">C_{2}</annotation></semantics></math>.
(3) <math id="A5.I2.i2.p1.m5" class="ltx_Math" alttext="\eta_{\lambda}-\left(\eta_{\lambda}-hR^{2}/C\right)(1-1/\delta)(1-1/\theta)=3\sqrt{h}R-(3\sqrt{h}R-hR^{2}/(\sqrt{h}R)(1-1/\delta)(1-1/\theta)=\sqrt{h}R(3-2(1-1/\delta)(1-1/\theta))" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>η</mi><mi>λ</mi></msub><mo>−</mo><mrow><mrow><mo>(</mo><mrow><msub><mi>η</mi><mi>λ</mi></msub><mo>−</mo><mrow><mrow><mi>h</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>R</mi><mn>2</mn></msup></mrow><mo>/</mo><mi>C</mi></mrow></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mrow><mn>1</mn><mo>/</mo><mi>δ</mi></mrow></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mrow><mn>1</mn><mo>/</mo><mi>θ</mi></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>=</mo><mrow><mrow><mn>3</mn><mo lspace="0em" rspace="0em">​</mo><msqrt><mi>h</mi></msqrt><mo lspace="0em" rspace="0em">​</mo><mi>R</mi></mrow><mo>−</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mrow><mn>3</mn><mo lspace="0em" rspace="0em">​</mo><msqrt><mi>h</mi></msqrt><mo lspace="0em" rspace="0em">​</mo><mi>R</mi></mrow><mo>−</mo><mrow><mrow><mrow><mi>h</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>R</mi><mn>2</mn></msup></mrow><mo>/</mo><mrow><mo stretchy="false">(</mo><mrow><msqrt><mi>h</mi></msqrt><mo lspace="0em" rspace="0em">​</mo><mi>R</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mrow><mn>1</mn><mo>/</mo><mi>δ</mi></mrow></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mrow><mn>1</mn><mo>/</mo><mi>θ</mi></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>=</mo><mrow><msqrt><mi>h</mi></msqrt><mo lspace="0em" rspace="0em">​</mo><mi>R</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>3</mn><mo>−</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mrow><mn>1</mn><mo>/</mo><mi>δ</mi></mrow></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mrow><mn>1</mn><mo>/</mo><mi>θ</mi></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo fence="true" lspace="0em">CLOSE</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\eta_{\lambda}-\left(\eta_{\lambda}-hR^{2}/C\right)(1-1/\delta)(1-1/\theta)=3\sqrt{h}R-(3\sqrt{h}R-hR^{2}/(\sqrt{h}R)(1-1/\delta)(1-1/\theta)=\sqrt{h}R(3-2(1-1/\delta)(1-1/\theta))</annotation></semantics></math>.
Since <math id="A5.I2.i2.p1.m6" class="ltx_Math" alttext="1/2&lt;\delta,\theta&lt;1" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mn>1</mn><mo>/</mo><mn>2</mn></mrow><mo>&lt;</mo><mi>δ</mi></mrow><mo>,</mo><mrow><mi>θ</mi><mo>&lt;</mo><mn>1</mn></mrow></mrow><annotation encoding="application/x-tex">1/2&lt;\delta,\theta&lt;1</annotation></semantics></math>, we have <math id="A5.I2.i2.p1.m7" class="ltx_Math" alttext="-1&lt;1-1/\theta&lt;0" display="inline" intent=":literal"><semantics><mrow><mrow><mo>−</mo><mn>1</mn></mrow><mo>&lt;</mo><mrow><mn>1</mn><mo>−</mo><mrow><mn>1</mn><mo>/</mo><mi>θ</mi></mrow></mrow><mo>&lt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">-1&lt;1-1/\theta&lt;0</annotation></semantics></math> and <math id="A5.I2.i2.p1.m8" class="ltx_Math" alttext="-1&lt;1-1/\delta&lt;0" display="inline" intent=":literal"><semantics><mrow><mrow><mo>−</mo><mn>1</mn></mrow><mo>&lt;</mo><mrow><mn>1</mn><mo>−</mo><mrow><mn>1</mn><mo>/</mo><mi>δ</mi></mrow></mrow><mo>&lt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">-1&lt;1-1/\delta&lt;0</annotation></semantics></math>, hence <math id="A5.I2.i2.p1.m9" class="ltx_Math" alttext="0&lt;(1-1/\theta)(1-1/\delta)&lt;1" display="inline" intent=":literal"><semantics><mrow><mn>0</mn><mo>&lt;</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mrow><mn>1</mn><mo>/</mo><mi>θ</mi></mrow></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mrow><mn>1</mn><mo>/</mo><mi>δ</mi></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>&lt;</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">0&lt;(1-1/\theta)(1-1/\delta)&lt;1</annotation></semantics></math>.
Therefore, we get <math id="A5.I2.i2.p1.m10" class="ltx_Math" alttext="3-2(1-1/\delta)(1-1/\theta)&gt;0" display="inline" intent=":literal"><semantics><mrow><mrow><mn>3</mn><mo>−</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mrow><mn>1</mn><mo>/</mo><mi>δ</mi></mrow></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mrow><mn>1</mn><mo>/</mo><mi>θ</mi></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">3-2(1-1/\delta)(1-1/\theta)&gt;0</annotation></semantics></math>.
(4) As <math id="A5.I2.i2.p1.m11" class="ltx_Math" alttext="hR^{2}&gt;0" display="inline" intent=":literal"><semantics><mrow><mrow><mi>h</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>R</mi><mn>2</mn></msup></mrow><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">hR^{2}&gt;0</annotation></semantics></math> and <math id="A5.I2.i2.p1.m12" class="ltx_Math" alttext="C=\sqrt{hR}&gt;0" display="inline" intent=":literal"><semantics><mrow><mi>C</mi><mo>=</mo><msqrt><mrow><mi>h</mi><mo lspace="0em" rspace="0em">​</mo><mi>R</mi></mrow></msqrt><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">C=\sqrt{hR}&gt;0</annotation></semantics></math>, we have <math id="A5.I2.i2.p1.m13" class="ltx_Math" alttext="hR^{2}/C&gt;0" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mi>h</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>R</mi><mn>2</mn></msup></mrow><mo>/</mo><mi>C</mi></mrow><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">hR^{2}/C&gt;0</annotation></semantics></math>.
(5) <math id="A5.I2.i2.p1.m14" class="ltx_Math" alttext="\eta_{\theta}-C_{1}=3\sqrt{hR}-\sqrt{h}R=2\sqrt{h}R&gt;0" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>η</mi><mi>θ</mi></msub><mo>−</mo><msub><mi>C</mi><mn>1</mn></msub></mrow><mo>=</mo><mrow><mrow><mn>3</mn><mo lspace="0em" rspace="0em">​</mo><msqrt><mrow><mi>h</mi><mo lspace="0em" rspace="0em">​</mo><mi>R</mi></mrow></msqrt></mrow><mo>−</mo><mrow><msqrt><mi>h</mi></msqrt><mo lspace="0em" rspace="0em">​</mo><mi>R</mi></mrow></mrow><mo>=</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msqrt><mi>h</mi></msqrt><mo lspace="0em" rspace="0em">​</mo><mi>R</mi></mrow><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\eta_{\theta}-C_{1}=3\sqrt{hR}-\sqrt{h}R=2\sqrt{h}R&gt;0</annotation></semantics></math>.</p>
</div></li>
<li id="A5.I2.i3" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">3.</span> 
<div id="A5.I2.i3.p1" class="ltx_para">
<p id="A5.I2.i3.p1.1" class="ltx_p">(1) Since <math id="A5.I2.i3.p1.m1" class="ltx_Math" alttext="\eta_{\theta}&gt;0" display="inline" intent=":literal"><semantics><mrow><msub><mi>η</mi><mi>θ</mi></msub><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\eta_{\theta}&gt;0</annotation></semantics></math> and <math id="A5.I2.i3.p1.m2" class="ltx_Math" alttext="\beta&gt;0" display="inline" intent=":literal"><semantics><mrow><mi>β</mi><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\beta&gt;0</annotation></semantics></math>, we have <math id="A5.I2.i3.p1.m3" class="ltx_Math" alttext="\frac{\eta_{\theta}}{\eta_{\theta}+\beta}&lt;1" display="inline" intent=":literal"><semantics><mrow><mfrac><msub><mi>η</mi><mi>θ</mi></msub><mrow><msub><mi>η</mi><mi>θ</mi></msub><mo>+</mo><mi>β</mi></mrow></mfrac><mo>&lt;</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">\frac{\eta_{\theta}}{\eta_{\theta}+\beta}&lt;1</annotation></semantics></math>.
(2) We have <math id="A5.I2.i3.p1.m4" class="ltx_Math" alttext="C_{2}/(\eta_{\theta}+\beta-C)=\sqrt{h}R/(3\sqrt{h}R-\beta-\sqrt{hR})&lt;\sqrt{h}R/(3\sqrt{h}R-\sqrt{hR})=1/2" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>C</mi><mn>2</mn></msub><mo>/</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><msub><mi>η</mi><mi>θ</mi></msub><mo>+</mo><mi>β</mi></mrow><mo>−</mo><mi>C</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mrow><msqrt><mi>h</mi></msqrt><mo lspace="0em" rspace="0em">​</mo><mi>R</mi></mrow><mo>/</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mn>3</mn><mo lspace="0em" rspace="0em">​</mo><msqrt><mi>h</mi></msqrt><mo lspace="0em" rspace="0em">​</mo><mi>R</mi></mrow><mo>−</mo><mi>β</mi><mo>−</mo><msqrt><mrow><mi>h</mi><mo lspace="0em" rspace="0em">​</mo><mi>R</mi></mrow></msqrt></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>&lt;</mo><mrow><mrow><msqrt><mi>h</mi></msqrt><mo lspace="0em" rspace="0em">​</mo><mi>R</mi></mrow><mo>/</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mn>3</mn><mo lspace="0em" rspace="0em">​</mo><msqrt><mi>h</mi></msqrt><mo lspace="0em" rspace="0em">​</mo><mi>R</mi></mrow><mo>−</mo><msqrt><mrow><mi>h</mi><mo lspace="0em" rspace="0em">​</mo><mi>R</mi></mrow></msqrt></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mn>1</mn><mo>/</mo><mn>2</mn></mrow></mrow><annotation encoding="application/x-tex">C_{2}/(\eta_{\theta}+\beta-C)=\sqrt{h}R/(3\sqrt{h}R-\beta-\sqrt{hR})&lt;\sqrt{h}R/(3\sqrt{h}R-\sqrt{hR})=1/2</annotation></semantics></math>, where the inequality is because <math id="A5.I2.i3.p1.m5" class="ltx_Math" alttext="\beta&gt;0" display="inline" intent=":literal"><semantics><mrow><mi>β</mi><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\beta&gt;0</annotation></semantics></math>.
(3) Since <math id="A5.I2.i3.p1.m6" class="ltx_Math" alttext="\eta_{\lambda}-hR^{2}/C=3\sqrt{hR}-hR^{2}/(\sqrt{h}R)=2\sqrt{h}R&gt;0" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>η</mi><mi>λ</mi></msub><mo>−</mo><mrow><mrow><mi>h</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>R</mi><mn>2</mn></msup></mrow><mo>/</mo><mi>C</mi></mrow></mrow><mo>=</mo><mrow><mrow><mn>3</mn><mo lspace="0em" rspace="0em">​</mo><msqrt><mrow><mi>h</mi><mo lspace="0em" rspace="0em">​</mo><mi>R</mi></mrow></msqrt></mrow><mo>−</mo><mrow><mrow><mi>h</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>R</mi><mn>2</mn></msup></mrow><mo>/</mo><mrow><mo stretchy="false">(</mo><mrow><msqrt><mi>h</mi></msqrt><mo lspace="0em" rspace="0em">​</mo><mi>R</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>=</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msqrt><mi>h</mi></msqrt><mo lspace="0em" rspace="0em">​</mo><mi>R</mi></mrow><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\eta_{\lambda}-hR^{2}/C=3\sqrt{hR}-hR^{2}/(\sqrt{h}R)=2\sqrt{h}R&gt;0</annotation></semantics></math>, <math id="A5.I2.i3.p1.m7" class="ltx_Math" alttext="(1-1/\delta)(1-1/\theta)&gt;0" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mrow><mn>1</mn><mo>/</mo><mi>δ</mi></mrow></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mrow><mn>1</mn><mo>/</mo><mi>θ</mi></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">(1-1/\delta)(1-1/\theta)&gt;0</annotation></semantics></math>, and <math id="A5.I2.i3.p1.m8" class="ltx_Math" alttext="1-\delta&gt;0" display="inline" intent=":literal"><semantics><mrow><mrow><mn>1</mn><mo>−</mo><mi>δ</mi></mrow><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">1-\delta&gt;0</annotation></semantics></math>, we have <math id="A5.I2.i3.p1.m9" class="ltx_Math" alttext="\left(\eta_{\lambda}-hR^{2}/C\right)(1-1/\delta)(1-1/\theta)&gt;0" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mo>(</mo><mrow><msub><mi>η</mi><mi>λ</mi></msub><mo>−</mo><mrow><mrow><mi>h</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>R</mi><mn>2</mn></msup></mrow><mo>/</mo><mi>C</mi></mrow></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mrow><mn>1</mn><mo>/</mo><mi>δ</mi></mrow></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mrow><mn>1</mn><mo>/</mo><mi>θ</mi></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\left(\eta_{\lambda}-hR^{2}/C\right)(1-1/\delta)(1-1/\theta)&gt;0</annotation></semantics></math> and <math id="A5.I2.i3.p1.m10" class="ltx_Math" alttext="\left(\eta_{\lambda}-hR^{2}/C\right)(1-\delta)&gt;0" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mo>(</mo><mrow><msub><mi>η</mi><mi>λ</mi></msub><mo>−</mo><mrow><mrow><mi>h</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>R</mi><mn>2</mn></msup></mrow><mo>/</mo><mi>C</mi></mrow></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>δ</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\left(\eta_{\lambda}-hR^{2}/C\right)(1-\delta)&gt;0</annotation></semantics></math>, hence <math id="A5.I2.i3.p1.m11" class="ltx_Math" alttext="\eta_{\lambda}-\left(\eta_{\lambda}-hR^{2}/C\right)(1-1/\delta)(1-1/\theta)&lt;\eta_{\lambda}+\left(\eta_{\lambda}-hR^{2}/C\right)(1-\delta)" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>η</mi><mi>λ</mi></msub><mo>−</mo><mrow><mrow><mo>(</mo><mrow><msub><mi>η</mi><mi>λ</mi></msub><mo>−</mo><mrow><mrow><mi>h</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>R</mi><mn>2</mn></msup></mrow><mo>/</mo><mi>C</mi></mrow></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mrow><mn>1</mn><mo>/</mo><mi>δ</mi></mrow></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mrow><mn>1</mn><mo>/</mo><mi>θ</mi></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>&lt;</mo><mrow><msub><mi>η</mi><mi>λ</mi></msub><mo>+</mo><mrow><mrow><mo>(</mo><mrow><msub><mi>η</mi><mi>λ</mi></msub><mo>−</mo><mrow><mrow><mi>h</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>R</mi><mn>2</mn></msup></mrow><mo>/</mo><mi>C</mi></mrow></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>δ</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\eta_{\lambda}-\left(\eta_{\lambda}-hR^{2}/C\right)(1-1/\delta)(1-1/\theta)&lt;\eta_{\lambda}+\left(\eta_{\lambda}-hR^{2}/C\right)(1-\delta)</annotation></semantics></math>, and <math id="A5.I2.i3.p1.m12" class="ltx_Math" alttext="(\eta_{\lambda}-\left(\eta_{\lambda}-hR^{2}/C\right)(1-1/\delta)(1-1/\theta))/(\eta_{\lambda}+\left(\eta_{\lambda}-hR^{2}/C\right)(1-\delta))&lt;1" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mo stretchy="false">(</mo><mrow><msub><mi>η</mi><mi>λ</mi></msub><mo>−</mo><mrow><mrow><mo>(</mo><mrow><msub><mi>η</mi><mi>λ</mi></msub><mo>−</mo><mrow><mrow><mi>h</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>R</mi><mn>2</mn></msup></mrow><mo>/</mo><mi>C</mi></mrow></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mrow><mn>1</mn><mo>/</mo><mi>δ</mi></mrow></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mrow><mn>1</mn><mo>/</mo><mi>θ</mi></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow><mo>/</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>η</mi><mi>λ</mi></msub><mo>+</mo><mrow><mrow><mo>(</mo><mrow><msub><mi>η</mi><mi>λ</mi></msub><mo>−</mo><mrow><mrow><mi>h</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>R</mi><mn>2</mn></msup></mrow><mo>/</mo><mi>C</mi></mrow></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>δ</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>&lt;</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">(\eta_{\lambda}-\left(\eta_{\lambda}-hR^{2}/C\right)(1-1/\delta)(1-1/\theta))/(\eta_{\lambda}+\left(\eta_{\lambda}-hR^{2}/C\right)(1-\delta))&lt;1</annotation></semantics></math>.
(4)Plugging the parameters values into the last requirement, we have</p>
<table id="A5.Ex112" class="ltx_equationgroup ltx_eqn_table">

<tbody id="A5.Ex112X"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.Ex112X.m2" class="ltx_Math" alttext="\displaystyle\frac{{hR^{2}}/{C}}{\eta_{\lambda}-hR^{2}\left({1}/{2C_{1}}+{1}/{2C_{2}}\right)+(\eta_{\lambda}-{hR^{2}}/{C})(1-1/\delta)(1-\theta)}" display="inline" intent=":literal"><semantics><mstyle displaystyle="true"><mfrac><mrow><mrow><mi>h</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>R</mi><mn>2</mn></msup></mrow><mo>/</mo><mi>C</mi></mrow><mrow><mrow><msub><mi>η</mi><mi>λ</mi></msub><mo>−</mo><mrow><mi>h</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>R</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mrow><mrow><mn>1</mn><mo>/</mo><mn>2</mn></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>C</mi><mn>1</mn></msub></mrow><mo>+</mo><mrow><mrow><mn>1</mn><mo>/</mo><mn>2</mn></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>C</mi><mn>2</mn></msub></mrow></mrow><mo>)</mo></mrow></mrow></mrow><mo>+</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><msub><mi>η</mi><mi>λ</mi></msub><mo>−</mo><mrow><mrow><mi>h</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>R</mi><mn>2</mn></msup></mrow><mo>/</mo><mi>C</mi></mrow></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mrow><mn>1</mn><mo>/</mo><mi>δ</mi></mrow></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>θ</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mfrac></mstyle><annotation encoding="application/x-tex">\displaystyle\frac{{hR^{2}}/{C}}{\eta_{\lambda}-hR^{2}\left({1}/{2C_{1}}+{1}/{2C_{2}}\right)+(\eta_{\lambda}-{hR^{2}}/{C})(1-1/\delta)(1-\theta)}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A5.Ex112Xa"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.Ex112Xa.m2" class="ltx_Math" alttext="\displaystyle=\frac{\sqrt{h}R}{2\sqrt{h}R+2\sqrt{h}R(1-1/\delta)(1-\theta)}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mstyle displaystyle="true"><mfrac><mrow><msqrt><mi>h</mi></msqrt><mo lspace="0em" rspace="0em">​</mo><mi>R</mi></mrow><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msqrt><mi>h</mi></msqrt><mo lspace="0em" rspace="0em">​</mo><mi>R</mi></mrow><mo>+</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msqrt><mi>h</mi></msqrt><mo lspace="0em" rspace="0em">​</mo><mi>R</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mrow><mn>1</mn><mo>/</mo><mi>δ</mi></mrow></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>θ</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mfrac></mstyle></mrow><annotation encoding="application/x-tex">\displaystyle=\frac{\sqrt{h}R}{2\sqrt{h}R+2\sqrt{h}R(1-1/\delta)(1-\theta)}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A5.Ex112Xb"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.Ex112Xb.m2" class="ltx_Math" alttext="\displaystyle=\frac{1}{2+2(1-1/\delta)(1-\theta)}." display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>=</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mrow><mn>2</mn><mo>+</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mrow><mn>1</mn><mo>/</mo><mi>δ</mi></mrow></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>θ</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mfrac></mstyle></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle=\frac{1}{2+2(1-1/\delta)(1-\theta)}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A5.I2.i3.p1.2" class="ltx_p">As <math id="A5.I2.i3.p1.m13" class="ltx_Math" alttext="1/2&lt;\theta,\delta&lt;1" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mn>1</mn><mo>/</mo><mn>2</mn></mrow><mo>&lt;</mo><mi>θ</mi></mrow><mo>,</mo><mrow><mi>δ</mi><mo>&lt;</mo><mn>1</mn></mrow></mrow><annotation encoding="application/x-tex">1/2&lt;\theta,\delta&lt;1</annotation></semantics></math>, <math id="A5.I2.i3.p1.m14" class="ltx_math_unparsed" alttext="-1/2&lt;(1-1/\delta)(1-\theta)&lt;0" display="inline" intent=":literal"><semantics><mrow><mo>−</mo><mn>1</mn><mo>/</mo><mn>2</mn><mo>&lt;</mo><mrow><mo stretchy="false">(</mo><mn>1</mn><mo>−</mo><mn>1</mn><mo>/</mo><mi>δ</mi><mo stretchy="false">)</mo></mrow><mrow><mo stretchy="false">(</mo><mn>1</mn><mo>−</mo><mi>θ</mi><mo stretchy="false">)</mo></mrow><mo>&lt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">-1/2&lt;(1-1/\delta)(1-\theta)&lt;0</annotation></semantics></math>. Therefore <math id="A5.I2.i3.p1.m15" class="ltx_Math" alttext="1&lt;2+2(1-1/\delta)(1-\theta)&lt;2" display="inline" intent=":literal"><semantics><mrow><mn>1</mn><mo>&lt;</mo><mrow><mn>2</mn><mo>+</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mrow><mn>1</mn><mo>/</mo><mi>δ</mi></mrow></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>θ</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>&lt;</mo><mn>2</mn></mrow><annotation encoding="application/x-tex">1&lt;2+2(1-1/\delta)(1-\theta)&lt;2</annotation></semantics></math> and <math id="A5.I2.i3.p1.m16" class="ltx_Math" alttext="{1}/{2+2(1-1/\delta)(1-\theta)}&lt;1" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mn>1</mn><mo>/</mo><mn>2</mn></mrow><mo>+</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mrow><mn>1</mn><mo>/</mo><mi>δ</mi></mrow></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>θ</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>&lt;</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">{1}/{2+2(1-1/\delta)(1-\theta)}&lt;1</annotation></semantics></math>.</p>
</div></li>
</ol>
</div>
<div id="A5.SS3.SSS0.Px1.p3" class="ltx_para">
<p id="A5.SS3.SSS0.Px1.p3.2" class="ltx_p">If we further set <math id="A5.SS3.SSS0.Px1.p3.m1" class="ltx_Math" alttext="\delta=\theta=\frac{3}{4}" display="inline" intent=":literal"><semantics><mrow><mi>δ</mi><mo>=</mo><mi>θ</mi><mo>=</mo><mfrac><mn>3</mn><mn>4</mn></mfrac></mrow><annotation encoding="application/x-tex">\delta=\theta=\frac{3}{4}</annotation></semantics></math>, then we can write <math id="A5.SS3.SSS0.Px1.p3.m2" class="ltx_Math" alttext="\rho" display="inline" intent=":literal"><semantics><mi>ρ</mi><annotation encoding="application/x-tex">\rho</annotation></semantics></math> and <math id="A5.SS3.SSS0.Px1.p3.m3" class="ltx_Math" alttext="\Phi_{1}" display="inline" intent=":literal"><semantics><msub><mi mathvariant="normal">Φ</mi><mn>1</mn></msub><annotation encoding="application/x-tex">\Phi_{1}</annotation></semantics></math> as</p>
<table id="A5.E69" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A5.E69.m1" class="ltx_Math" alttext="\rho=\max\left(\frac{3\sqrt{\mathcal{H}}R_{\max}}{3\sqrt{\mathcal{H}}R_{\max}+\beta},\frac{\sqrt{\mathcal{H}}R_{\max}}{2\sqrt{\mathcal{H}}R_{\max}+\beta},\frac{50}{63}\right)," display="block" intent=":literal"><semantics><mrow><mrow><mi>ρ</mi><mo>=</mo><mrow><mi>max</mi><mo>⁡</mo><mrow><mo>(</mo><mfrac><mrow><mn>3</mn><mo lspace="0em" rspace="0em">​</mo><msqrt><mi class="ltx_font_mathcaligraphic">ℋ</mi></msqrt><mo lspace="0em" rspace="0em">​</mo><msub><mi>R</mi><mi>max</mi></msub></mrow><mrow><mrow><mn>3</mn><mo lspace="0em" rspace="0em">​</mo><msqrt><mi class="ltx_font_mathcaligraphic">ℋ</mi></msqrt><mo lspace="0em" rspace="0em">​</mo><msub><mi>R</mi><mi>max</mi></msub></mrow><mo>+</mo><mi>β</mi></mrow></mfrac><mo>,</mo><mfrac><mrow><msqrt><mi class="ltx_font_mathcaligraphic">ℋ</mi></msqrt><mo lspace="0em" rspace="0em">​</mo><msub><mi>R</mi><mi>max</mi></msub></mrow><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msqrt><mi class="ltx_font_mathcaligraphic">ℋ</mi></msqrt><mo lspace="0em" rspace="0em">​</mo><msub><mi>R</mi><mi>max</mi></msub></mrow><mo>+</mo><mi>β</mi></mrow></mfrac><mo>,</mo><mfrac><mn>50</mn><mn>63</mn></mfrac><mo>)</mo></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\rho=\max\left(\frac{3\sqrt{\mathcal{H}}R_{\max}}{3\sqrt{\mathcal{H}}R_{\max}+\beta},\frac{\sqrt{\mathcal{H}}R_{\max}}{2\sqrt{\mathcal{H}}R_{\max}+\beta},\frac{50}{63}\right),</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(69)</span></td></tr></tbody>
</table>
<table id="A5.E70" class="ltx_equationgroup ltx_eqn_table">
<tbody>
<tr id="A5.E70X" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A5.E70X.m2" class="ltx_Math" alttext="\displaystyle\Phi_{1}=" display="inline" intent=":literal"><semantics><mrow><msub><mi mathvariant="normal">Φ</mi><mn>1</mn></msub><mo>=</mo><mphantom></mphantom></mrow><annotation encoding="application/x-tex">\displaystyle\Phi_{1}=</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.E70X.m3" class="ltx_Math" alttext="\displaystyle(3\sqrt{\mathcal{H}}R_{\max}+\beta)\mathbb{E}_{x\sim\mathcal{D}}\left[\mathrm{KL}(\pi^{\star}(\cdot|x)\|\hat{\pi}_{1}(\cdot|x))\right]+(2\sqrt{\mathcal{H}}R_{\max}+\beta)\mathbb{E}_{x\sim\mathcal{D}}\left[\mathrm{KL}(\hat{\pi}_{1}(\cdot|x)\|\pi_{0}(\cdot|x))\right]" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mn>3</mn><msqrt><mi class="ltx_font_mathcaligraphic">ℋ</mi></msqrt><mi>R</mi><msub><mrow></mrow><mi>max</mi></msub><mo>+</mo><mi>β</mi><mo stretchy="false">)</mo><mi>𝔼</mi><msub><mrow></mrow><mrow><mi>x</mi><mo>∼</mo><mi class="ltx_font_mathcaligraphic">𝒟</mi></mrow></msub><mo>[</mo><mi>KL</mi><mo stretchy="false">(</mo><mi>π</mi><msup><mrow></mrow><mo>⋆</mo></msup><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>x</mi><mo stretchy="false">)</mo><mo lspace="0em" rspace="0.167em">∥</mo><mover accent="true"><mi>π</mi><mo>^</mo></mover><msub><mrow></mrow><mn>1</mn></msub><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>x</mi><mo stretchy="false">)</mo><mo stretchy="false">)</mo><mo>]</mo><mo>+</mo><mo stretchy="false">(</mo><mn>2</mn><msqrt><mi class="ltx_font_mathcaligraphic">ℋ</mi></msqrt><mi>R</mi><msub><mrow></mrow><mi>max</mi></msub><mo>+</mo><mi>β</mi><mo stretchy="false">)</mo><mi>𝔼</mi><msub><mrow></mrow><mrow><mi>x</mi><mo>∼</mo><mi class="ltx_font_mathcaligraphic">𝒟</mi></mrow></msub><mo>[</mo><mi>KL</mi><mo stretchy="false">(</mo><mover accent="true"><mi>π</mi><mo>^</mo></mover><msub><mrow></mrow><mn>1</mn></msub><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>x</mi><mo stretchy="false">)</mo><mo lspace="0em" rspace="0.167em">∥</mo><mi>π</mi><msub><mrow></mrow><mn>0</mn></msub><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>x</mi><mo stretchy="false">)</mo><mo stretchy="false">)</mo><mo>]</mo></mrow><annotation encoding="application/x-tex">\displaystyle(3\sqrt{\mathcal{H}}R_{\max}+\beta)\mathbb{E}_{x\sim\mathcal{D}}\left[\mathrm{KL}(\pi^{\star}(\cdot|x)\|\hat{\pi}_{1}(\cdot|x))\right]+(2\sqrt{\mathcal{H}}R_{\max}+\beta)\mathbb{E}_{x\sim\mathcal{D}}\left[\mathrm{KL}(\hat{\pi}_{1}(\cdot|x)\|\pi_{0}(\cdot|x))\right]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="2" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equationgroup ltx_align_right">(70)</span></td></tr>
<tr id="A5.E70Xa" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.E70Xa.m2" class="ltx_Math" alttext="\displaystyle+\frac{7}{2}\sqrt{\mathcal{H}}R_{\max}\|\boldsymbol{\lambda}^{\star}-\hat{\boldsymbol{\lambda}}_{1}\|_{2}^{2}+\frac{11}{6}\sqrt{\mathcal{H}}R_{\max}\|\hat{\boldsymbol{\lambda}}_{1}-\boldsymbol{\lambda}_{0}\|_{2}^{2}." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mo>+</mo><mrow><mstyle displaystyle="true"><mfrac><mn>7</mn><mn>2</mn></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msqrt><mi class="ltx_font_mathcaligraphic">ℋ</mi></msqrt><mo lspace="0em" rspace="0em">​</mo><msub><mi>R</mi><mi>max</mi></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mrow><mo stretchy="false">‖</mo><mrow><msup><mi>𝝀</mi><mo>⋆</mo></msup><mo>−</mo><msub><mover accent="true"><mi>𝝀</mi><mo>^</mo></mover><mn>1</mn></msub></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn><mn>2</mn></msubsup></mrow></mrow><mo>+</mo><mrow><mstyle displaystyle="true"><mfrac><mn>11</mn><mn>6</mn></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msqrt><mi class="ltx_font_mathcaligraphic">ℋ</mi></msqrt><mo lspace="0em" rspace="0em">​</mo><msub><mi>R</mi><mi>max</mi></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mrow><mo stretchy="false">‖</mo><mrow><msub><mover accent="true"><mi>𝝀</mi><mo>^</mo></mover><mn>1</mn></msub><mo>−</mo><msub><mi>𝝀</mi><mn>0</mn></msub></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn><mn>2</mn></msubsup></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle+\frac{7}{2}\sqrt{\mathcal{H}}R_{\max}\|\boldsymbol{\lambda}^{\star}-\hat{\boldsymbol{\lambda}}_{1}\|_{2}^{2}+\frac{11}{6}\sqrt{\mathcal{H}}R_{\max}\|\hat{\boldsymbol{\lambda}}_{1}-\boldsymbol{\lambda}_{0}\|_{2}^{2}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
