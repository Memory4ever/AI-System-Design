<tbody id="A5.Ex101Xg"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.Ex101Xg.m2" class="ltx_Math" alttext="\displaystyle-\left(\eta_{\lambda}-\frac{|\mathcal{H}|R_{\max}^{2}}{C}\right)\|\boldsymbol{\lambda}_{t}-\hat{\boldsymbol{\lambda}}_{t}\|_{2}^{2}+\frac{|\mathcal{H}|R_{\max}^{2}}{C}\|\hat{\boldsymbol{\lambda}}_{t}-\boldsymbol{\lambda}_{t-1}\|_{2}^{2}+\eta_{\lambda}\|\boldsymbol{\lambda}^{\star}-\hat{\boldsymbol{\lambda}}_{t}\|_{2}^{2}-\eta_{\lambda}\|\boldsymbol{\lambda}^{\star}-\hat{\boldsymbol{\lambda}}_{t+1}\|_{2}^{2}" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mo>−</mo><mrow><mrow><mo>(</mo><mrow><msub><mi>η</mi><mi>λ</mi></msub><mo>−</mo><mstyle displaystyle="true"><mfrac><mrow><mrow><mo stretchy="false">|</mo><mi class="ltx_font_mathcaligraphic">ℋ</mi><mo stretchy="false">|</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>R</mi><mi>max</mi><mn>2</mn></msubsup></mrow><mi>C</mi></mfrac></mstyle></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msubsup><mrow><mo stretchy="false">‖</mo><mrow><msub><mi>𝝀</mi><mi>t</mi></msub><mo>−</mo><msub><mover accent="true"><mi>𝝀</mi><mo>^</mo></mover><mi>t</mi></msub></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn><mn>2</mn></msubsup></mrow></mrow><mo>+</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mrow><mo stretchy="false">|</mo><mi class="ltx_font_mathcaligraphic">ℋ</mi><mo stretchy="false">|</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>R</mi><mi>max</mi><mn>2</mn></msubsup></mrow><mi>C</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msubsup><mrow><mo stretchy="false">‖</mo><mrow><msub><mover accent="true"><mi>𝝀</mi><mo>^</mo></mover><mi>t</mi></msub><mo>−</mo><msub><mi>𝝀</mi><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow></msub></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn><mn>2</mn></msubsup></mrow><mo>+</mo><mrow><msub><mi>η</mi><mi>λ</mi></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mrow><mo stretchy="false">‖</mo><mrow><msup><mi>𝝀</mi><mo>⋆</mo></msup><mo>−</mo><msub><mover accent="true"><mi>𝝀</mi><mo>^</mo></mover><mi>t</mi></msub></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn><mn>2</mn></msubsup></mrow></mrow><mo>−</mo><mrow><msub><mi>η</mi><mi>λ</mi></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mrow><mo stretchy="false">‖</mo><mrow><msup><mi>𝝀</mi><mo>⋆</mo></msup><mo>−</mo><msub><mover accent="true"><mi>𝝀</mi><mo>^</mo></mover><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow></msub></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn><mn>2</mn></msubsup></mrow></mrow><annotation encoding="application/x-tex">\displaystyle-\left(\eta_{\lambda}-\frac{|\mathcal{H}|R_{\max}^{2}}{C}\right)\|\boldsymbol{\lambda}_{t}-\hat{\boldsymbol{\lambda}}_{t}\|_{2}^{2}+\frac{|\mathcal{H}|R_{\max}^{2}}{C}\|\hat{\boldsymbol{\lambda}}_{t}-\boldsymbol{\lambda}_{t-1}\|_{2}^{2}+\eta_{\lambda}\|\boldsymbol{\lambda}^{\star}-\hat{\boldsymbol{\lambda}}_{t}\|_{2}^{2}-\eta_{\lambda}\|\boldsymbol{\lambda}^{\star}-\hat{\boldsymbol{\lambda}}_{t+1}\|_{2}^{2}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A5.Ex101Xh"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.Ex101Xh.m2" class="ltx_Math" alttext="\displaystyle-\left(\eta_{\lambda}-|\mathcal{H}|R_{\max}^{2}\left(\frac{1}{2C_{1}}+\frac{1}{2C_{2}}\right)\right)\|\boldsymbol{\lambda}_{t}-\hat{\boldsymbol{\lambda}}_{t+1}\|_{2}^{2}{+2\mathrm{gap}(\varepsilon_{\mathrm{approx}},p_{\min})}," display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mo>−</mo><mrow><mrow><mo>(</mo><mrow><msub><mi>η</mi><mi>λ</mi></msub><mo>−</mo><mrow><mrow><mo stretchy="false">|</mo><mi class="ltx_font_mathcaligraphic">ℋ</mi><mo stretchy="false">|</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>R</mi><mi>max</mi><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>C</mi><mn>1</mn></msub></mrow></mfrac></mstyle><mo>+</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>C</mi><mn>2</mn></msub></mrow></mfrac></mstyle></mrow><mo>)</mo></mrow></mrow></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msubsup><mrow><mo stretchy="false">‖</mo><mrow><msub><mi>𝝀</mi><mi>t</mi></msub><mo>−</mo><msub><mover accent="true"><mi>𝝀</mi><mo>^</mo></mover><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow></msub></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn><mn>2</mn></msubsup></mrow></mrow><mo>+</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>gap</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>ε</mi><mi>approx</mi></msub><mo>,</mo><msub><mi>p</mi><mi>min</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle-\left(\eta_{\lambda}-|\mathcal{H}|R_{\max}^{2}\left(\frac{1}{2C_{1}}+\frac{1}{2C_{2}}\right)\right)\|\boldsymbol{\lambda}_{t}-\hat{\boldsymbol{\lambda}}_{t+1}\|_{2}^{2}{+2\mathrm{gap}(\varepsilon_{\mathrm{approx}},p_{\min})},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A5.SS3.p1.5" class="ltx_p">where terms of the same color can be combined. Recall <a href="#A5.E53" title="In Appendix E Proof of ‣ Provable Last-Iterate Convergence for Multi-Objective Safe LLM Alignment via Optimistic Primal-Dual" class="ltx_ref"><span class="ltx_text ltx_ref_tag">eq.</span> <span class="ltx_text ltx_ref_tag">53</span></a> that <math id="A5.SS3.p1.m1" class="ltx_Math" alttext="L(\pi^{\star},\boldsymbol{\lambda}_{t})-L(\pi_{t},\boldsymbol{\lambda}^{\star})\geq 0" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mi>L</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>π</mi><mo>⋆</mo></msup><mo>,</mo><msub><mi>𝝀</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mi>L</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>π</mi><mi>t</mi></msub><mo>,</mo><msup><mi>𝝀</mi><mo>⋆</mo></msup><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>≥</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">L(\pi^{\star},\boldsymbol{\lambda}_{t})-L(\pi_{t},\boldsymbol{\lambda}^{\star})\geq 0</annotation></semantics></math>. Substituting this into the above equation and rearranging the equation, we have</p>
<table id="A5.E66" class="ltx_equationgroup ltx_eqn_table">
<tbody>
<tr id="A5.E66X" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.E66X.m2" class="ltx_Math" alttext="\displaystyle(\eta_{\theta}+\beta)\mathbb{E}_{x\sim\mathcal{D}}\left[\mathrm{KL}(\pi^{\star}(\cdot|x)\|\hat{\pi}_{t+1}(\cdot|x))\right]+(\eta_{\theta}+\beta-C)\mathbb{E}_{x\sim\mathcal{D}}\left[\mathrm{KL}(\hat{\pi}_{t+1}(\cdot|x)\|\pi_{t}(\cdot|x))\right]" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi>η</mi><msub><mrow></mrow><mi>θ</mi></msub><mo>+</mo><mi>β</mi><mo stretchy="false">)</mo><mi>𝔼</mi><msub><mrow></mrow><mrow><mi>x</mi><mo>∼</mo><mi class="ltx_font_mathcaligraphic">𝒟</mi></mrow></msub><mo>[</mo><mi>KL</mi><mo stretchy="false">(</mo><mi>π</mi><msup><mrow></mrow><mo>⋆</mo></msup><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>x</mi><mo stretchy="false">)</mo><mo lspace="0em" rspace="0.167em">∥</mo><mover accent="true"><mi>π</mi><mo>^</mo></mover><msub><mrow></mrow><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow></msub><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>x</mi><mo stretchy="false">)</mo><mo stretchy="false">)</mo><mo>]</mo><mo>+</mo><mo stretchy="false">(</mo><mi>η</mi><msub><mrow></mrow><mi>θ</mi></msub><mo>+</mo><mi>β</mi><mo>−</mo><mi>C</mi><mo stretchy="false">)</mo><mi>𝔼</mi><msub><mrow></mrow><mrow><mi>x</mi><mo>∼</mo><mi class="ltx_font_mathcaligraphic">𝒟</mi></mrow></msub><mo>[</mo><mi>KL</mi><mo stretchy="false">(</mo><mover accent="true"><mi>π</mi><mo>^</mo></mover><msub><mrow></mrow><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow></msub><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>x</mi><mo stretchy="false">)</mo><mo lspace="0em" rspace="0.167em">∥</mo><mi>π</mi><msub><mrow></mrow><mi>t</mi></msub><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>x</mi><mo stretchy="false">)</mo><mo stretchy="false">)</mo><mo>]</mo></mrow><annotation encoding="application/x-tex">\displaystyle(\eta_{\theta}+\beta)\mathbb{E}_{x\sim\mathcal{D}}\left[\mathrm{KL}(\pi^{\star}(\cdot|x)\|\hat{\pi}_{t+1}(\cdot|x))\right]+(\eta_{\theta}+\beta-C)\mathbb{E}_{x\sim\mathcal{D}}\left[\mathrm{KL}(\hat{\pi}_{t+1}(\cdot|x)\|\pi_{t}(\cdot|x))\right]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="4" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equationgroup ltx_align_right">(66)</span></td></tr>
<tr id="A5.E66Xa" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.E66Xa.m2" class="ltx_Math" alttext="\displaystyle+\eta_{\lambda}\|\boldsymbol{\lambda}^{\star}-\hat{\boldsymbol{\lambda}}_{t+1}\|_{2}^{2}+\left(\eta_{\lambda}-|\mathcal{H}|R_{\max}^{2}\left(\frac{1}{2C_{1}}+\frac{1}{2C_{2}}\right)\right)\|\boldsymbol{\lambda}_{t}-\hat{\boldsymbol{\lambda}}_{t+1}\|_{2}^{2}" display="inline" intent=":literal"><semantics><mrow><mrow><mo>+</mo><mrow><msub><mi>η</mi><mi>λ</mi></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mrow><mo stretchy="false">‖</mo><mrow><msup><mi>𝝀</mi><mo>⋆</mo></msup><mo>−</mo><msub><mover accent="true"><mi>𝝀</mi><mo>^</mo></mover><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow></msub></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn><mn>2</mn></msubsup></mrow></mrow><mo>+</mo><mrow><mrow><mo>(</mo><mrow><msub><mi>η</mi><mi>λ</mi></msub><mo>−</mo><mrow><mrow><mo stretchy="false">|</mo><mi class="ltx_font_mathcaligraphic">ℋ</mi><mo stretchy="false">|</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>R</mi><mi>max</mi><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>C</mi><mn>1</mn></msub></mrow></mfrac></mstyle><mo>+</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>C</mi><mn>2</mn></msub></mrow></mfrac></mstyle></mrow><mo>)</mo></mrow></mrow></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msubsup><mrow><mo stretchy="false">‖</mo><mrow><msub><mi>𝝀</mi><mi>t</mi></msub><mo>−</mo><msub><mover accent="true"><mi>𝝀</mi><mo>^</mo></mover><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow></msub></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn><mn>2</mn></msubsup></mrow></mrow><annotation encoding="application/x-tex">\displaystyle+\eta_{\lambda}\|\boldsymbol{\lambda}^{\star}-\hat{\boldsymbol{\lambda}}_{t+1}\|_{2}^{2}+\left(\eta_{\lambda}-|\mathcal{H}|R_{\max}^{2}\left(\frac{1}{2C_{1}}+\frac{1}{2C_{2}}\right)\right)\|\boldsymbol{\lambda}_{t}-\hat{\boldsymbol{\lambda}}_{t+1}\|_{2}^{2}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr>
<tr id="A5.E66Xb" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.E66Xb.m2" class="ltx_Math" alttext="\displaystyle\leq\eta_{\theta}\mathbb{E}_{x\sim\mathcal{D}}\left[\mathrm{KL}(\pi^{\star}(\cdot|x)\|\hat{\pi}_{t}(\cdot|x))\right]+C_{2}\mathbb{E}_{x\sim\mathcal{D}}\left[\mathrm{KL}(\hat{\pi}_{t}(\cdot|x)\|\pi_{t-1}(\cdot|x))\right]+\eta_{\lambda}\|\boldsymbol{\lambda}^{\star}-\hat{\boldsymbol{\lambda}}_{t}\|_{2}^{2}+\frac{|\mathcal{H}|R_{\max}^{2}}{C}\|\hat{\boldsymbol{\lambda}}_{t}-\boldsymbol{\lambda}_{t-1}\|_{2}^{2}" display="inline" intent=":literal"><semantics><mrow><mo>≤</mo><mi>η</mi><msub><mrow></mrow><mi>θ</mi></msub><mi>𝔼</mi><msub><mrow></mrow><mrow><mi>x</mi><mo>∼</mo><mi class="ltx_font_mathcaligraphic">𝒟</mi></mrow></msub><mo>[</mo><mi>KL</mi><mo stretchy="false">(</mo><mi>π</mi><msup><mrow></mrow><mo>⋆</mo></msup><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>x</mi><mo stretchy="false">)</mo><mo lspace="0em" rspace="0.167em">∥</mo><mover accent="true"><mi>π</mi><mo>^</mo></mover><msub><mrow></mrow><mi>t</mi></msub><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>x</mi><mo stretchy="false">)</mo><mo stretchy="false">)</mo><mo>]</mo><mo>+</mo><mi>C</mi><msub><mrow></mrow><mn>2</mn></msub><mi>𝔼</mi><msub><mrow></mrow><mrow><mi>x</mi><mo>∼</mo><mi class="ltx_font_mathcaligraphic">𝒟</mi></mrow></msub><mo>[</mo><mi>KL</mi><mo stretchy="false">(</mo><mover accent="true"><mi>π</mi><mo>^</mo></mover><msub><mrow></mrow><mi>t</mi></msub><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>x</mi><mo stretchy="false">)</mo><mo lspace="0em" rspace="0.167em">∥</mo><mi>π</mi><msub><mrow></mrow><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow></msub><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>x</mi><mo stretchy="false">)</mo><mo stretchy="false">)</mo><mo>]</mo><mo>+</mo><mi>η</mi><msub><mrow></mrow><mi>λ</mi></msub><mo lspace="0em" rspace="0.167em">∥</mo><mi>𝝀</mi><msup><mrow></mrow><mo>⋆</mo></msup><mo>−</mo><mover accent="true"><mi>𝝀</mi><mo>^</mo></mover><msub><mrow></mrow><mi>t</mi></msub><mo lspace="0em" rspace="0em">∥</mo><msub><mrow></mrow><mn>2</mn></msub><msup><mrow></mrow><mn>2</mn></msup><mo lspace="0em">+</mo><mstyle displaystyle="true"><mfrac><mrow><mrow><mo stretchy="false">|</mo><mi class="ltx_font_mathcaligraphic">ℋ</mi><mo stretchy="false">|</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>R</mi><mi>max</mi><mn>2</mn></msubsup></mrow><mi>C</mi></mfrac></mstyle><mo lspace="0em" rspace="0.167em">∥</mo><mover accent="true"><mi>𝝀</mi><mo>^</mo></mover><msub><mrow></mrow><mi>t</mi></msub><mo>−</mo><mi>𝝀</mi><msub><mrow></mrow><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow></msub><mo lspace="0em">∥</mo><msub><mrow></mrow><mn>2</mn></msub><msup><mrow></mrow><mn>2</mn></msup></mrow><annotation encoding="application/x-tex">\displaystyle\leq\eta_{\theta}\mathbb{E}_{x\sim\mathcal{D}}\left[\mathrm{KL}(\pi^{\star}(\cdot|x)\|\hat{\pi}_{t}(\cdot|x))\right]+C_{2}\mathbb{E}_{x\sim\mathcal{D}}\left[\mathrm{KL}(\hat{\pi}_{t}(\cdot|x)\|\pi_{t-1}(\cdot|x))\right]+\eta_{\lambda}\|\boldsymbol{\lambda}^{\star}-\hat{\boldsymbol{\lambda}}_{t}\|_{2}^{2}+\frac{|\mathcal{H}|R_{\max}^{2}}{C}\|\hat{\boldsymbol{\lambda}}_{t}-\boldsymbol{\lambda}_{t-1}\|_{2}^{2}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr>
<tr id="A5.E66Xc" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.E66Xc.m2" class="ltx_Math" alttext="\displaystyle-\left(\eta_{\theta}-C_{1}\right)\mathbb{E}_{x\sim\mathcal{D}}\left[\mathrm{KL}(\pi_{t}(\cdot|x)\|\hat{\pi}_{t}(\cdot|x))\right]-\left(\eta_{\lambda}-\frac{|\mathcal{H}|R_{\max}^{2}}{C}\right)\|\boldsymbol{\lambda}_{t}-\hat{\boldsymbol{\lambda}}_{t}\|_{2}^{2}{+2\mathrm{gap}(\varepsilon_{\mathrm{approx}},p_{\min})}" display="inline" intent=":literal"><semantics><mrow><mo>−</mo><mo>(</mo><mi>η</mi><msub><mrow></mrow><mi>θ</mi></msub><mo>−</mo><mi>C</mi><msub><mrow></mrow><mn>1</mn></msub><mo>)</mo><mi>𝔼</mi><msub><mrow></mrow><mrow><mi>x</mi><mo>∼</mo><mi class="ltx_font_mathcaligraphic">𝒟</mi></mrow></msub><mo>[</mo><mi>KL</mi><mo stretchy="false">(</mo><mi>π</mi><msub><mrow></mrow><mi>t</mi></msub><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>x</mi><mo stretchy="false">)</mo><mo lspace="0em" rspace="0.167em">∥</mo><mover accent="true"><mi>π</mi><mo>^</mo></mover><msub><mrow></mrow><mi>t</mi></msub><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>x</mi><mo stretchy="false">)</mo><mo stretchy="false">)</mo><mo>]</mo><mo>−</mo><mo>(</mo><mi>η</mi><msub><mrow></mrow><mi>λ</mi></msub><mo>−</mo><mstyle displaystyle="true"><mfrac><mrow><mrow><mo stretchy="false">|</mo><mi class="ltx_font_mathcaligraphic">ℋ</mi><mo stretchy="false">|</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>R</mi><mi>max</mi><mn>2</mn></msubsup></mrow><mi>C</mi></mfrac></mstyle><mo>)</mo><mo lspace="0em" rspace="0.167em">∥</mo><mi>𝝀</mi><msub><mrow></mrow><mi>t</mi></msub><mo>−</mo><mover accent="true"><mi>𝝀</mi><mo>^</mo></mover><msub><mrow></mrow><mi>t</mi></msub><mo lspace="0em" rspace="0em">∥</mo><msub><mrow></mrow><mn>2</mn></msub><msup><mrow></mrow><mn>2</mn></msup><mo lspace="0em">+</mo><mn>2</mn><mi>gap</mi><mo stretchy="false">(</mo><mi>ε</mi><msub><mrow></mrow><mi>approx</mi></msub><mo>,</mo><mi>p</mi><msub><mrow></mrow><mi>min</mi></msub><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">\displaystyle-\left(\eta_{\theta}-C_{1}\right)\mathbb{E}_{x\sim\mathcal{D}}\left[\mathrm{KL}(\pi_{t}(\cdot|x)\|\hat{\pi}_{t}(\cdot|x))\right]-\left(\eta_{\lambda}-\frac{|\mathcal{H}|R_{\max}^{2}}{C}\right)\|\boldsymbol{\lambda}_{t}-\hat{\boldsymbol{\lambda}}_{t}\|_{2}^{2}{+2\mathrm{gap}(\varepsilon_{\mathrm{approx}},p_{\min})}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A5.SS3.p1.6" class="ltx_p">Note that for any <math id="A5.SS3.p1.m2" class="ltx_Math" alttext="\delta,\theta&gt;0" display="inline" intent=":literal"><semantics><mrow><mrow><mi>δ</mi><mo>,</mo><mi>θ</mi></mrow><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\delta,\theta&gt;0</annotation></semantics></math>, we have</p>
<table id="A5.E67" class="ltx_equationgroup ltx_eqn_table">
<tbody>
<tr id="A5.E67X" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A5.E67X.m2" class="ltx_Math" alttext="\displaystyle\|\boldsymbol{\lambda}_{t}-\hat{\boldsymbol{\lambda}}_{t}\|^{2}" display="inline" intent=":literal"><semantics><msup><mrow><mo stretchy="false">‖</mo><mrow><msub><mi>𝝀</mi><mi>t</mi></msub><mo>−</mo><msub><mover accent="true"><mi>𝝀</mi><mo>^</mo></mover><mi>t</mi></msub></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup><annotation encoding="application/x-tex">\displaystyle\|\boldsymbol{\lambda}_{t}-\hat{\boldsymbol{\lambda}}_{t}\|^{2}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.E67X.m3" class="ltx_Math" alttext="\displaystyle=\left\|\left(\boldsymbol{\lambda}_{t}-\hat{\boldsymbol{\lambda}}_{t+1}\right)+\left(\hat{\boldsymbol{\lambda}}_{t+1}-\boldsymbol{\lambda}^{\star}\right)+\left(\boldsymbol{\lambda}^{\star}-\hat{\boldsymbol{\lambda}}_{t}\right)\right\|^{2}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><msup><mrow><mo>‖</mo><mrow><mrow><mo>(</mo><mrow><msub><mi>𝝀</mi><mi>t</mi></msub><mo>−</mo><msub><mover accent="true"><mi>𝝀</mi><mo>^</mo></mover><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow></msub></mrow><mo>)</mo></mrow><mo>+</mo><mrow><mo>(</mo><mrow><msub><mover accent="true"><mi>𝝀</mi><mo>^</mo></mover><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow></msub><mo>−</mo><msup><mi>𝝀</mi><mo>⋆</mo></msup></mrow><mo>)</mo></mrow><mo>+</mo><mrow><mo>(</mo><mrow><msup><mi>𝝀</mi><mo>⋆</mo></msup><mo>−</mo><msub><mover accent="true"><mi>𝝀</mi><mo>^</mo></mover><mi>t</mi></msub></mrow><mo>)</mo></mrow></mrow><mo>‖</mo></mrow><mn>2</mn></msup></mrow><annotation encoding="application/x-tex">\displaystyle=\left\|\left(\boldsymbol{\lambda}_{t}-\hat{\boldsymbol{\lambda}}_{t+1}\right)+\left(\hat{\boldsymbol{\lambda}}_{t+1}-\boldsymbol{\lambda}^{\star}\right)+\left(\boldsymbol{\lambda}^{\star}-\hat{\boldsymbol{\lambda}}_{t}\right)\right\|^{2}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="2" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equationgroup ltx_align_right">(67)</span></td></tr>
<tr id="A5.E67Xa" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.E67Xa.m2" class="ltx_Math" alttext="\displaystyle\geq(1-\delta)\|\hat{\boldsymbol{\lambda}}_{t+1}-\boldsymbol{\lambda}^{\star}\|^{2}+(1-\frac{1}{\delta})(1-\theta)\|\boldsymbol{\lambda}_{t}-\hat{\boldsymbol{\lambda}}_{t+1}\|^{2}+(1-\frac{1}{\delta})(1-\frac{1}{\theta})\|\boldsymbol{\lambda}^{\star}-\hat{\boldsymbol{\lambda}}_{t}\|^{2}\quad\text{(by \lx@cref{creftype~refnum}{lem:||a+b+c||_2^2_lower_bd})}." display="inline" intent=":literal"><semantics><mrow><mo>≥</mo><mo stretchy="false">(</mo><mn>1</mn><mo>−</mo><mi>δ</mi><mo stretchy="false">)</mo><mo lspace="0em" rspace="0.167em">∥</mo><mover accent="true"><mi>𝝀</mi><mo>^</mo></mover><msub><mrow></mrow><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow></msub><mo>−</mo><mi>𝝀</mi><msup><mrow></mrow><mo>⋆</mo></msup><mo lspace="0em" rspace="0em">∥</mo><msup><mrow></mrow><mn>2</mn></msup><mo lspace="0em">+</mo><mo stretchy="false">(</mo><mn>1</mn><mo>−</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>δ</mi></mfrac></mstyle><mo stretchy="false">)</mo><mo stretchy="false">(</mo><mn>1</mn><mo>−</mo><mi>θ</mi><mo stretchy="false">)</mo><mo lspace="0em" rspace="0.167em">∥</mo><mi>𝝀</mi><msub><mrow></mrow><mi>t</mi></msub><mo>−</mo><mover accent="true"><mi>𝝀</mi><mo>^</mo></mover><msub><mrow></mrow><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow></msub><mo lspace="0em" rspace="0em">∥</mo><msup><mrow></mrow><mn>2</mn></msup><mo lspace="0em">+</mo><mo stretchy="false">(</mo><mn>1</mn><mo>−</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>δ</mi></mfrac></mstyle><mo stretchy="false">)</mo><mo stretchy="false">(</mo><mn>1</mn><mo>−</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>θ</mi></mfrac></mstyle><mo stretchy="false">)</mo><mo lspace="0em" rspace="0.167em">∥</mo><mi>𝝀</mi><msup><mrow></mrow><mo>⋆</mo></msup><mo>−</mo><mover accent="true"><mi>𝝀</mi><mo>^</mo></mover><msub><mrow></mrow><mi>t</mi></msub><mo lspace="0em" rspace="0.167em">∥</mo><msup><mrow></mrow><mn>2</mn></msup><mrow><mtext>(by </mtext><mtext><a href="#A2.Thmtheorem4" title="Lemma B.4. ‣ Appendix B Useful Lemmas ‣ Provable Last-Iterate Convergence for Multi-Objective Safe LLM Alignment via Optimistic Primal-Dual" class="ltx_ref"><span class="ltx_text ltx_ref_tag">lemma</span> <span class="ltx_text ltx_ref_tag">B.4</span></a></mtext><mtext>)</mtext></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\geq(1-\delta)\|\hat{\boldsymbol{\lambda}}_{t+1}-\boldsymbol{\lambda}^{\star}\|^{2}+(1-\frac{1}{\delta})(1-\theta)\|\boldsymbol{\lambda}_{t}-\hat{\boldsymbol{\lambda}}_{t+1}\|^{2}+(1-\frac{1}{\delta})(1-\frac{1}{\theta})\|\boldsymbol{\lambda}^{\star}-\hat{\boldsymbol{\lambda}}_{t}\|^{2}\quad\text{(by \lx@cref{creftype~refnum}{lem:||a+b+c||_2^2_lower_bd})}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A5.SS3.p1.7" class="ltx_p">We set <math id="A5.SS3.p1.m3" class="ltx_Math" alttext="\eta_{\lambda}&gt;\frac{|\mathcal{H}|R_{\max}^{2}}{C}" display="inline" intent=":literal"><semantics><mrow><msub><mi>η</mi><mi>λ</mi></msub><mo>&gt;</mo><mfrac><mrow><mrow><mo stretchy="false">|</mo><mi class="ltx_font_mathcaligraphic">ℋ</mi><mo stretchy="false">|</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>R</mi><mi>max</mi><mn>2</mn></msubsup></mrow><mi>C</mi></mfrac></mrow><annotation encoding="application/x-tex">\eta_{\lambda}&gt;\frac{|\mathcal{H}|R_{\max}^{2}}{C}</annotation></semantics></math>. Substituting <a href="#A5.E67" title="In E.3 Combining A and B ‣ Appendix E Proof of ‣ Provable Last-Iterate Convergence for Multi-Objective Safe LLM Alignment via Optimistic Primal-Dual" class="ltx_ref"><span class="ltx_text ltx_ref_tag">eq.</span> <span class="ltx_text ltx_ref_tag">67</span></a> into the last term of the RHS of <a href="#A5.E66" title="In E.3 Combining A and B ‣ Appendix E Proof of ‣ Provable Last-Iterate Convergence for Multi-Objective Safe LLM Alignment via Optimistic Primal-Dual" class="ltx_ref"><span class="ltx_text ltx_ref_tag">eq.</span> <span class="ltx_text ltx_ref_tag">66</span></a> to get</p>
<table id="A5.Ex102" class="ltx_equationgroup ltx_eqn_table">

<tbody id="A5.Ex102X"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.Ex102X.m2" class="ltx_Math" alttext="\displaystyle(\eta_{\theta}+\beta)\mathbb{E}_{x\sim\mathcal{D}}\left[\mathrm{KL}(\pi^{\star}(\cdot|x)\|\hat{\pi}_{t+1}(\cdot|x))\right]+(\eta_{\theta}+\beta-C)\mathbb{E}_{x\sim\mathcal{D}}\left[\mathrm{KL}(\hat{\pi}_{t+1}(\cdot|x)\|\pi_{t}(\cdot|x))\right]" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi>η</mi><msub><mrow></mrow><mi>θ</mi></msub><mo>+</mo><mi>β</mi><mo stretchy="false">)</mo><mi>𝔼</mi><msub><mrow></mrow><mrow><mi>x</mi><mo>∼</mo><mi class="ltx_font_mathcaligraphic">𝒟</mi></mrow></msub><mo>[</mo><mi>KL</mi><mo stretchy="false">(</mo><mi>π</mi><msup><mrow></mrow><mo>⋆</mo></msup><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>x</mi><mo stretchy="false">)</mo><mo lspace="0em" rspace="0.167em">∥</mo><mover accent="true"><mi>π</mi><mo>^</mo></mover><msub><mrow></mrow><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow></msub><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>x</mi><mo stretchy="false">)</mo><mo stretchy="false">)</mo><mo>]</mo><mo>+</mo><mo stretchy="false">(</mo><mi>η</mi><msub><mrow></mrow><mi>θ</mi></msub><mo>+</mo><mi>β</mi><mo>−</mo><mi>C</mi><mo stretchy="false">)</mo><mi>𝔼</mi><msub><mrow></mrow><mrow><mi>x</mi><mo>∼</mo><mi class="ltx_font_mathcaligraphic">𝒟</mi></mrow></msub><mo>[</mo><mi>KL</mi><mo stretchy="false">(</mo><mover accent="true"><mi>π</mi><mo>^</mo></mover><msub><mrow></mrow><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow></msub><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>x</mi><mo stretchy="false">)</mo><mo lspace="0em" rspace="0.167em">∥</mo><mi>π</mi><msub><mrow></mrow><mi>t</mi></msub><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>x</mi><mo stretchy="false">)</mo><mo stretchy="false">)</mo><mo>]</mo></mrow><annotation encoding="application/x-tex">\displaystyle(\eta_{\theta}+\beta)\mathbb{E}_{x\sim\mathcal{D}}\left[\mathrm{KL}(\pi^{\star}(\cdot|x)\|\hat{\pi}_{t+1}(\cdot|x))\right]+(\eta_{\theta}+\beta-C)\mathbb{E}_{x\sim\mathcal{D}}\left[\mathrm{KL}(\hat{\pi}_{t+1}(\cdot|x)\|\pi_{t}(\cdot|x))\right]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A5.Ex102Xa"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.Ex102Xa.m2" class="ltx_Math" alttext="\displaystyle\color[rgb]{1,0,0}{\displaystyle+\eta_{\lambda}\|\boldsymbol{\lambda}^{\star}-\hat{\boldsymbol{\lambda}}_{t+1}\|_{2}^{2}}+{\color[rgb]{0,0,1}\left(\eta_{\lambda}-|\mathcal{H}|R_{\max}^{2}\left(\frac{1}{2C_{1}}+\frac{1}{2C_{2}}\right)\right)\|\boldsymbol{\lambda}_{t}-\hat{\boldsymbol{\lambda}}_{t+1}\|_{2}^{2}}" display="inline" intent=":literal"><semantics><mrow><mrow><mo style="--ltx-fg-color:#FF0000;" mathcolor="#FF0000">+</mo><mrow><msub><mi style="--ltx-fg-color:#FF0000;" mathcolor="#FF0000">η</mi><mi style="--ltx-fg-color:#FF0000;" mathcolor="#FF0000">λ</mi></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mrow><mo style="--ltx-fg-color:#FF0000;" mathcolor="#FF0000" stretchy="false">‖</mo><mrow><msup><mi style="--ltx-fg-color:#FF0000;" mathcolor="#FF0000">𝝀</mi><mo style="--ltx-fg-color:#FF0000;" mathcolor="#FF0000">⋆</mo></msup><mo style="--ltx-fg-color:#FF0000;" mathcolor="#FF0000">−</mo><msub><mover accent="true"><mi style="--ltx-fg-color:#FF0000;" mathcolor="#FF0000">𝝀</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">^</mo></mover><mrow><mi style="--ltx-fg-color:#FF0000;" mathcolor="#FF0000">t</mi><mo style="--ltx-fg-color:#FF0000;" mathcolor="#FF0000">+</mo><mn style="--ltx-fg-color:#FF0000;" mathcolor="#FF0000">1</mn></mrow></msub></mrow><mo style="--ltx-fg-color:#FF0000;" mathcolor="#FF0000" stretchy="false">‖</mo></mrow><mn style="--ltx-fg-color:#FF0000;" mathcolor="#FF0000">2</mn><mn style="--ltx-fg-color:#FF0000;" mathcolor="#FF0000">2</mn></msubsup></mrow></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">+</mo><mrow><mrow><mo style="--ltx-fg-color:#0000FF;" mathcolor="#0000FF">(</mo><mrow><msub><mi style="--ltx-fg-color:#0000FF;" mathcolor="#0000FF">η</mi><mi style="--ltx-fg-color:#0000FF;" mathcolor="#0000FF">λ</mi></msub><mo style="--ltx-fg-color:#0000FF;" mathcolor="#0000FF">−</mo><mrow><mrow><mo style="--ltx-fg-color:#0000FF;" mathcolor="#0000FF" stretchy="false">|</mo><mi style="--ltx-fg-color:#0000FF;" class="ltx_font_mathcaligraphic" mathcolor="#0000FF">ℋ</mi><mo style="--ltx-fg-color:#0000FF;" mathcolor="#0000FF" stretchy="false">|</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msubsup><mi style="--ltx-fg-color:#0000FF;" mathcolor="#0000FF">R</mi><mi style="--ltx-fg-color:#0000FF;" mathcolor="#0000FF">max</mi><mn style="--ltx-fg-color:#0000FF;" mathcolor="#0000FF">2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo style="--ltx-fg-color:#0000FF;" mathcolor="#0000FF">(</mo><mrow><mstyle displaystyle="true"><mfrac style="--ltx-fg-color:#0000FF;" mathcolor="#0000FF"><mn style="--ltx-fg-color:#0000FF;" mathcolor="#0000FF">1</mn><mrow><mn style="--ltx-fg-color:#0000FF;" mathcolor="#0000FF">2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi style="--ltx-fg-color:#0000FF;" mathcolor="#0000FF">C</mi><mn style="--ltx-fg-color:#0000FF;" mathcolor="#0000FF">1</mn></msub></mrow></mfrac></mstyle><mo style="--ltx-fg-color:#0000FF;" mathcolor="#0000FF">+</mo><mstyle displaystyle="true"><mfrac style="--ltx-fg-color:#0000FF;" mathcolor="#0000FF"><mn style="--ltx-fg-color:#0000FF;" mathcolor="#0000FF">1</mn><mrow><mn style="--ltx-fg-color:#0000FF;" mathcolor="#0000FF">2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi style="--ltx-fg-color:#0000FF;" mathcolor="#0000FF">C</mi><mn style="--ltx-fg-color:#0000FF;" mathcolor="#0000FF">2</mn></msub></mrow></mfrac></mstyle></mrow><mo style="--ltx-fg-color:#0000FF;" mathcolor="#0000FF">)</mo></mrow></mrow></mrow><mo style="--ltx-fg-color:#0000FF;" mathcolor="#0000FF">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msubsup><mrow><mo style="--ltx-fg-color:#0000FF;" mathcolor="#0000FF" stretchy="false">‖</mo><mrow><msub><mi style="--ltx-fg-color:#0000FF;" mathcolor="#0000FF">𝝀</mi><mi style="--ltx-fg-color:#0000FF;" mathcolor="#0000FF">t</mi></msub><mo style="--ltx-fg-color:#0000FF;" mathcolor="#0000FF">−</mo><msub><mover accent="true"><mi style="--ltx-fg-color:#0000FF;" mathcolor="#0000FF">𝝀</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">^</mo></mover><mrow><mi style="--ltx-fg-color:#0000FF;" mathcolor="#0000FF">t</mi><mo style="--ltx-fg-color:#0000FF;" mathcolor="#0000FF">+</mo><mn style="--ltx-fg-color:#0000FF;" mathcolor="#0000FF">1</mn></mrow></msub></mrow><mo style="--ltx-fg-color:#0000FF;" mathcolor="#0000FF" stretchy="false">‖</mo></mrow><mn style="--ltx-fg-color:#0000FF;" mathcolor="#0000FF">2</mn><mn style="--ltx-fg-color:#0000FF;" mathcolor="#0000FF">2</mn></msubsup></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\color[rgb]{1,0,0}{\displaystyle+\eta_{\lambda}\|\boldsymbol{\lambda}^{\star}-\hat{\boldsymbol{\lambda}}_{t+1}\|_{2}^{2}}+{\color[rgb]{0,0,1}\left(\eta_{\lambda}-|\mathcal{H}|R_{\max}^{2}\left(\frac{1}{2C_{1}}+\frac{1}{2C_{2}}\right)\right)\|\boldsymbol{\lambda}_{t}-\hat{\boldsymbol{\lambda}}_{t+1}\|_{2}^{2}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A5.Ex102Xb"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.Ex102Xb.m2" class="ltx_Math" alttext="\displaystyle\leq\eta_{\theta}\mathbb{E}_{x\sim\mathcal{D}}\left[\mathrm{KL}(\pi^{\star}(\cdot|x)\|\hat{\pi}_{t}(\cdot|x))\right]+C_{2}\mathbb{E}_{x\sim\mathcal{D}}\left[\mathrm{KL}(\hat{\pi}_{t}(\cdot|x)\|\pi_{t-1}(\cdot|x))\right]+{\color[rgb]{0,1,1}\eta_{\lambda}\|\boldsymbol{\lambda}^{\star}-\hat{\boldsymbol{\lambda}}_{t}\|_{2}^{2}}+\frac{|\mathcal{H}|R_{\max}^{2}}{C}\|\hat{\boldsymbol{\lambda}}_{t}-\boldsymbol{\lambda}_{t-1}\|_{2}^{2}" display="inline" intent=":literal"><semantics><mrow><mo>≤</mo><mi>η</mi><msub><mrow></mrow><mi>θ</mi></msub><mi>𝔼</mi><msub><mrow></mrow><mrow><mi>x</mi><mo>∼</mo><mi class="ltx_font_mathcaligraphic">𝒟</mi></mrow></msub><mo>[</mo><mi>KL</mi><mo stretchy="false">(</mo><mi>π</mi><msup><mrow></mrow><mo>⋆</mo></msup><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>x</mi><mo stretchy="false">)</mo><mo lspace="0em" rspace="0.167em">∥</mo><mover accent="true"><mi>π</mi><mo>^</mo></mover><msub><mrow></mrow><mi>t</mi></msub><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>x</mi><mo stretchy="false">)</mo><mo stretchy="false">)</mo><mo>]</mo><mo>+</mo><mi>C</mi><msub><mrow></mrow><mn>2</mn></msub><mi>𝔼</mi><msub><mrow></mrow><mrow><mi>x</mi><mo>∼</mo><mi class="ltx_font_mathcaligraphic">𝒟</mi></mrow></msub><mo>[</mo><mi>KL</mi><mo stretchy="false">(</mo><mover accent="true"><mi>π</mi><mo>^</mo></mover><msub><mrow></mrow><mi>t</mi></msub><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>x</mi><mo stretchy="false">)</mo><mo lspace="0em" rspace="0.167em">∥</mo><mi>π</mi><msub><mrow></mrow><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow></msub><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>x</mi><mo stretchy="false">)</mo><mo stretchy="false">)</mo><mo>]</mo><mo>+</mo><mi style="--ltx-fg-color:#00FFFF;" mathcolor="#00FFFF">η</mi><msub><mrow></mrow><mi style="--ltx-fg-color:#00FFFF;" mathcolor="#00FFFF">λ</mi></msub><mo style="--ltx-fg-color:#00FFFF;" lspace="0em" mathcolor="#00FFFF" rspace="0.167em">∥</mo><mi style="--ltx-fg-color:#00FFFF;" mathcolor="#00FFFF">𝝀</mi><msup><mrow></mrow><mo style="--ltx-fg-color:#00FFFF;" mathcolor="#00FFFF">⋆</mo></msup><mo style="--ltx-fg-color:#00FFFF;" mathcolor="#00FFFF">−</mo><mover accent="true"><mi style="--ltx-fg-color:#00FFFF;" mathcolor="#00FFFF">𝝀</mi><mo>^</mo></mover><msub><mrow></mrow><mi style="--ltx-fg-color:#00FFFF;" mathcolor="#00FFFF">t</mi></msub><mo style="--ltx-fg-color:#00FFFF;" lspace="0em" mathcolor="#00FFFF" rspace="0em">∥</mo><msub><mrow></mrow><mn style="--ltx-fg-color:#00FFFF;" mathcolor="#00FFFF">2</mn></msub><msup><mrow></mrow><mn style="--ltx-fg-color:#00FFFF;" mathcolor="#00FFFF">2</mn></msup><mo lspace="0em">+</mo><mstyle displaystyle="true"><mfrac><mrow><mrow><mo stretchy="false">|</mo><mi class="ltx_font_mathcaligraphic">ℋ</mi><mo stretchy="false">|</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>R</mi><mi>max</mi><mn>2</mn></msubsup></mrow><mi>C</mi></mfrac></mstyle><mo lspace="0em" rspace="0.167em">∥</mo><mover accent="true"><mi>𝝀</mi><mo>^</mo></mover><msub><mrow></mrow><mi>t</mi></msub><mo>−</mo><mi>𝝀</mi><msub><mrow></mrow><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow></msub><mo lspace="0em">∥</mo><msub><mrow></mrow><mn>2</mn></msub><msup><mrow></mrow><mn>2</mn></msup></mrow><annotation encoding="application/x-tex">\displaystyle\leq\eta_{\theta}\mathbb{E}_{x\sim\mathcal{D}}\left[\mathrm{KL}(\pi^{\star}(\cdot|x)\|\hat{\pi}_{t}(\cdot|x))\right]+C_{2}\mathbb{E}_{x\sim\mathcal{D}}\left[\mathrm{KL}(\hat{\pi}_{t}(\cdot|x)\|\pi_{t-1}(\cdot|x))\right]+{\color[rgb]{0,1,1}\eta_{\lambda}\|\boldsymbol{\lambda}^{\star}-\hat{\boldsymbol{\lambda}}_{t}\|_{2}^{2}}+\frac{|\mathcal{H}|R_{\max}^{2}}{C}\|\hat{\boldsymbol{\lambda}}_{t}-\boldsymbol{\lambda}_{t-1}\|_{2}^{2}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A5.Ex102Xc"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.Ex102Xc.m2" class="ltx_Math" alttext="\displaystyle-\left(\eta_{\theta}-C_{1}\right)\mathbb{E}_{x\sim\mathcal{D}}\left[\mathrm{KL}(\pi_{t}(\cdot|x)\|\hat{\pi}_{t}(\cdot|x))\right]{\color[rgb]{1,0,0}-\left(\eta_{\lambda}-\frac{|\mathcal{H}|R_{\max}^{2}}{C}\right)(1-\delta)\|\hat{\boldsymbol{\lambda}}_{t+1}-\boldsymbol{\lambda}^{\star}\|^{2}}" display="inline" intent=":literal"><semantics><mrow><mo>−</mo><mo>(</mo><mi>η</mi><msub><mrow></mrow><mi>θ</mi></msub><mo>−</mo><mi>C</mi><msub><mrow></mrow><mn>1</mn></msub><mo>)</mo><mi>𝔼</mi><msub><mrow></mrow><mrow><mi>x</mi><mo>∼</mo><mi class="ltx_font_mathcaligraphic">𝒟</mi></mrow></msub><mo>[</mo><mi>KL</mi><mo stretchy="false">(</mo><mi>π</mi><msub><mrow></mrow><mi>t</mi></msub><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>x</mi><mo stretchy="false">)</mo><mo lspace="0em" rspace="0.167em">∥</mo><mover accent="true"><mi>π</mi><mo>^</mo></mover><msub><mrow></mrow><mi>t</mi></msub><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>x</mi><mo stretchy="false">)</mo><mo stretchy="false">)</mo><mo>]</mo><mo style="--ltx-fg-color:#FF0000;" mathcolor="#FF0000">−</mo><mo style="--ltx-fg-color:#FF0000;" mathcolor="#FF0000">(</mo><mi style="--ltx-fg-color:#FF0000;" mathcolor="#FF0000">η</mi><msub><mrow></mrow><mi style="--ltx-fg-color:#FF0000;" mathcolor="#FF0000">λ</mi></msub><mo style="--ltx-fg-color:#FF0000;" mathcolor="#FF0000">−</mo><mstyle displaystyle="true"><mfrac style="--ltx-fg-color:#FF0000;" mathcolor="#FF0000"><mrow><mrow><mo style="--ltx-fg-color:#FF0000;" mathcolor="#FF0000" stretchy="false">|</mo><mi style="--ltx-fg-color:#FF0000;" class="ltx_font_mathcaligraphic" mathcolor="#FF0000">ℋ</mi><mo style="--ltx-fg-color:#FF0000;" mathcolor="#FF0000" stretchy="false">|</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msubsup><mi style="--ltx-fg-color:#FF0000;" mathcolor="#FF0000">R</mi><mi style="--ltx-fg-color:#FF0000;" mathcolor="#FF0000">max</mi><mn style="--ltx-fg-color:#FF0000;" mathcolor="#FF0000">2</mn></msubsup></mrow><mi style="--ltx-fg-color:#FF0000;" mathcolor="#FF0000">C</mi></mfrac></mstyle><mo style="--ltx-fg-color:#FF0000;" mathcolor="#FF0000">)</mo><mo style="--ltx-fg-color:#FF0000;" mathcolor="#FF0000" stretchy="false">(</mo><mn style="--ltx-fg-color:#FF0000;" mathcolor="#FF0000">1</mn><mo style="--ltx-fg-color:#FF0000;" mathcolor="#FF0000">−</mo><mi style="--ltx-fg-color:#FF0000;" mathcolor="#FF0000">δ</mi><mo style="--ltx-fg-color:#FF0000;" mathcolor="#FF0000" stretchy="false">)</mo><mo style="--ltx-fg-color:#FF0000;" lspace="0em" mathcolor="#FF0000" rspace="0.167em">∥</mo><mover accent="true"><mi style="--ltx-fg-color:#FF0000;" mathcolor="#FF0000">𝝀</mi><mo>^</mo></mover><msub><mrow></mrow><mrow><mi style="--ltx-fg-color:#FF0000;" mathcolor="#FF0000">t</mi><mo style="--ltx-fg-color:#FF0000;" mathcolor="#FF0000">+</mo><mn style="--ltx-fg-color:#FF0000;" mathcolor="#FF0000">1</mn></mrow></msub><mo style="--ltx-fg-color:#FF0000;" mathcolor="#FF0000">−</mo><mi style="--ltx-fg-color:#FF0000;" mathcolor="#FF0000">𝝀</mi><msup><mrow></mrow><mo style="--ltx-fg-color:#FF0000;" mathcolor="#FF0000">⋆</mo></msup><mo style="--ltx-fg-color:#FF0000;" lspace="0em" mathcolor="#FF0000">∥</mo><msup><mrow></mrow><mn style="--ltx-fg-color:#FF0000;" mathcolor="#FF0000">2</mn></msup></mrow><annotation encoding="application/x-tex">\displaystyle-\left(\eta_{\theta}-C_{1}\right)\mathbb{E}_{x\sim\mathcal{D}}\left[\mathrm{KL}(\pi_{t}(\cdot|x)\|\hat{\pi}_{t}(\cdot|x))\right]{\color[rgb]{1,0,0}-\left(\eta_{\lambda}-\frac{|\mathcal{H}|R_{\max}^{2}}{C}\right)(1-\delta)\|\hat{\boldsymbol{\lambda}}_{t+1}-\boldsymbol{\lambda}^{\star}\|^{2}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A5.Ex102Xd"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
