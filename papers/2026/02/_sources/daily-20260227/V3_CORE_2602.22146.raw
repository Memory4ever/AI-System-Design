<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A5.SS1.p1.3" class="ltx_p">where <math id="A5.SS1.p1.m2" class="ltx_Math" alttext="(a)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi>a</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(a)</annotation></semantics></math> is because the action space is discrete and <math id="A5.SS1.p1.m3" class="ltx_math_unparsed" alttext="V^{\pi}_{S_{\boldsymbol{\lambda}_{t}}}(x)=\sum_{y}\pi(y|x){S_{\boldsymbol{\lambda}_{t}}}(x,y)=\langle\pi(\cdot|x),S_{\boldsymbol{\lambda}_{t}}(x,\cdot)\rangle" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>V</mi><msub><mi>S</mi><msub><mi>𝝀</mi><mi>t</mi></msub></msub><mi>π</mi></msubsup><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow><mo rspace="0.111em">=</mo><msub><mo>∑</mo><mi>y</mi></msub><mi>π</mi><mrow><mo stretchy="false">(</mo><mi>y</mi><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>x</mi><mo stretchy="false">)</mo></mrow><msub><mi>S</mi><msub><mi>𝝀</mi><mi>t</mi></msub></msub><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>y</mi><mo stretchy="false">)</mo></mrow><mo>=</mo><mrow><mo stretchy="false">⟨</mo><mi>π</mi><mrow><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>x</mi><mo stretchy="false">)</mo></mrow><mo>,</mo><msub><mi>S</mi><msub><mi>𝝀</mi><mi>t</mi></msub></msub><mrow><mo stretchy="false">(</mo><mi>x</mi><mo rspace="0em">,</mo><mo lspace="0em" rspace="0em">⋅</mo><mo stretchy="false">)</mo></mrow><mo stretchy="false">⟩</mo></mrow></mrow><annotation encoding="application/x-tex">V^{\pi}_{S_{\boldsymbol{\lambda}_{t}}}(x)=\sum_{y}\pi(y|x){S_{\boldsymbol{\lambda}_{t}}}(x,y)=\langle\pi(\cdot|x),S_{\boldsymbol{\lambda}_{t}}(x,\cdot)\rangle</annotation></semantics></math> for any <math id="A5.SS1.p1.m4" class="ltx_Math" alttext="\pi\in\Pi" display="inline" intent=":literal"><semantics><mrow><mi>π</mi><mo>∈</mo><mi mathvariant="normal">Π</mi></mrow><annotation encoding="application/x-tex">\pi\in\Pi</annotation></semantics></math>, and <math id="A5.SS1.p1.m5" class="ltx_Math" alttext="(b)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi>b</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(b)</annotation></semantics></math> is because adding and subtracting the same term keeps the equality.</p>
</div>
<div id="A5.SS1.p2" class="ltx_para">
<p id="A5.SS1.p2.2" class="ltx_p">As we consider the NPG update in the linear parameterized space, where <math id="A5.SS1.p2.m1" class="ltx_Math" alttext="\pi_{t}" display="inline" intent=":literal"><semantics><msub><mi>π</mi><mi>t</mi></msub><annotation encoding="application/x-tex">\pi_{t}</annotation></semantics></math> and <math id="A5.SS1.p2.m2" class="ltx_Math" alttext="\hat{\pi}_{t+1}" display="inline" intent=":literal"><semantics><msub><mover accent="true"><mi>π</mi><mo>^</mo></mover><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow></msub><annotation encoding="application/x-tex">\hat{\pi}_{t+1}</annotation></semantics></math> updates follow <a href="#S3.E8" title="In 2 ‣ Algorithm 3 ‣ 3.2.1 OPD Updates in the Parameterized Policy Space ‣ 3.2 OPD in Parameter Space ‣ 3 Optimistic Primal–Dual Method ‣ Provable Last-Iterate Convergence for Multi-Objective Safe LLM Alignment via Optimistic Primal-Dual" class="ltx_ref"><span class="ltx_text ltx_ref_tag">eq.</span> <span class="ltx_text ltx_ref_tag">8</span></a> and <a href="#S3.E10" title="In 4 ‣ Algorithm 3 ‣ 3.2.1 OPD Updates in the Parameterized Policy Space ‣ 3.2 OPD in Parameter Space ‣ 3 Optimistic Primal–Dual Method ‣ Provable Last-Iterate Convergence for Multi-Objective Safe LLM Alignment via Optimistic Primal-Dual" class="ltx_ref"><span class="ltx_text ltx_ref_tag">eq.</span> <span class="ltx_text ltx_ref_tag">10</span></a>. Using <a href="#A2.Thmtheorem12" title="Corollary B.12. ‣ Appendix B Useful Lemmas ‣ Provable Last-Iterate Convergence for Multi-Objective Safe LLM Alignment via Optimistic Primal-Dual" class="ltx_ref"><span class="ltx_text ltx_ref_tag">corollary</span> <span class="ltx_text ltx_ref_tag">B.12</span></a> and letting <math id="A5.SS1.p2.m3" class="ltx_Math" alttext="\eta=\eta_{\theta}" display="inline" intent=":literal"><semantics><mrow><mi>η</mi><mo>=</mo><msub><mi>η</mi><mi>θ</mi></msub></mrow><annotation encoding="application/x-tex">\eta=\eta_{\theta}</annotation></semantics></math>, <math id="A5.SS1.p2.m4" class="ltx_Math" alttext="g=S_{\boldsymbol{\lambda}_{t}}(x,\cdot)" display="inline" intent=":literal"><semantics><mrow><mi>g</mi><mo>=</mo><mrow><msub><mi>S</mi><msub><mi>𝝀</mi><mi>t</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo rspace="0em">,</mo><mo lspace="0em" rspace="0em">⋅</mo><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">g=S_{\boldsymbol{\lambda}_{t}}(x,\cdot)</annotation></semantics></math>, <math id="A5.SS1.p2.m5" class="ltx_math_unparsed" alttext="\pi_{\mathrm{old}}=\hat{\pi}_{t}(\cdot|x)" display="inline" intent=":literal"><semantics><mrow><msub><mi>π</mi><mi>old</mi></msub><mo>=</mo><msub><mover accent="true"><mi>π</mi><mo>^</mo></mover><mi>t</mi></msub><mrow><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\pi_{\mathrm{old}}=\hat{\pi}_{t}(\cdot|x)</annotation></semantics></math>, <math id="A5.SS1.p2.m6" class="ltx_math_unparsed" alttext="\pi_{\mathrm{new}}=\hat{\pi}_{t+1}(\cdot|x)" display="inline" intent=":literal"><semantics><mrow><msub><mi>π</mi><mi>new</mi></msub><mo>=</mo><msub><mover accent="true"><mi>π</mi><mo>^</mo></mover><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow></msub><mrow><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\pi_{\mathrm{new}}=\hat{\pi}_{t+1}(\cdot|x)</annotation></semantics></math>, and <math id="A5.SS1.p2.m7" class="ltx_math_unparsed" alttext="\pi^{\prime}=\pi^{\star}(\cdot|x)" display="inline" intent=":literal"><semantics><mrow><msup><mi>π</mi><mo>′</mo></msup><mo>=</mo><msup><mi>π</mi><mo>⋆</mo></msup><mrow><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\pi^{\prime}=\pi^{\star}(\cdot|x)</annotation></semantics></math>, we have</p>
<table id="A5.Ex91" class="ltx_equationgroup ltx_eqn_table">

<tbody id="A5.Ex91X"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.Ex91X.m2" class="ltx_Math" alttext="\displaystyle\mathbb{E}_{x\sim\mathcal{D}}\left[\langle S_{\boldsymbol{\lambda}_{t}}(x,\cdot),\hat{\pi}_{t+1}(\cdot|x)-\pi^{\star}(\cdot|x)\rangle-\beta\left(\mathrm{KL}(\hat{\pi}_{t+1}(\cdot|x)\|\pi_{\mathrm{ref}}(\cdot|x))-\mathrm{KL}(\pi^{\star}(\cdot|x)\|\pi_{\mathrm{ref}}(\cdot|x))\right)\right]" display="inline" intent=":literal"><semantics><mrow><mi>𝔼</mi><msub><mrow></mrow><mrow><mi>x</mi><mo>∼</mo><mi class="ltx_font_mathcaligraphic">𝒟</mi></mrow></msub><mo>[</mo><mo stretchy="false">⟨</mo><mi>S</mi><msub><mrow></mrow><msub><mi>𝝀</mi><mi>t</mi></msub></msub><mo stretchy="false">(</mo><mi>x</mi><mo rspace="0em">,</mo><mo lspace="0em" rspace="0em">⋅</mo><mo stretchy="false">)</mo><mo>,</mo><mover accent="true"><mi>π</mi><mo>^</mo></mover><msub><mrow></mrow><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow></msub><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>x</mi><mo stretchy="false">)</mo><mo>−</mo><mi>π</mi><msup><mrow></mrow><mo>⋆</mo></msup><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>x</mi><mo stretchy="false">)</mo><mo stretchy="false">⟩</mo><mo>−</mo><mi>β</mi><mo>(</mo><mi>KL</mi><mo stretchy="false">(</mo><mover accent="true"><mi>π</mi><mo>^</mo></mover><msub><mrow></mrow><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow></msub><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>x</mi><mo stretchy="false">)</mo><mo lspace="0em" rspace="0.167em">∥</mo><mi>π</mi><msub><mrow></mrow><mi>ref</mi></msub><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>x</mi><mo stretchy="false">)</mo><mo stretchy="false">)</mo><mo>−</mo><mi>KL</mi><mo stretchy="false">(</mo><mi>π</mi><msup><mrow></mrow><mo>⋆</mo></msup><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>x</mi><mo stretchy="false">)</mo><mo lspace="0em" rspace="0.167em">∥</mo><mi>π</mi><msub><mrow></mrow><mi>ref</mi></msub><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>x</mi><mo stretchy="false">)</mo><mo stretchy="false">)</mo><mo>)</mo><mo>]</mo></mrow><annotation encoding="application/x-tex">\displaystyle\mathbb{E}_{x\sim\mathcal{D}}\left[\langle S_{\boldsymbol{\lambda}_{t}}(x,\cdot),\hat{\pi}_{t+1}(\cdot|x)-\pi^{\star}(\cdot|x)\rangle-\beta\left(\mathrm{KL}(\hat{\pi}_{t+1}(\cdot|x)\|\pi_{\mathrm{ref}}(\cdot|x))-\mathrm{KL}(\pi^{\star}(\cdot|x)\|\pi_{\mathrm{ref}}(\cdot|x))\right)\right]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A5.Ex91Xa"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.Ex91Xa.m2" class="ltx_Math" alttext="\displaystyle\geq\mathbb{E}_{x\sim\mathcal{D}}\left[\eta_{\theta}\left(-\mathrm{KL}(\pi^{\star}(\cdot|x)\|\hat{\pi}_{t}(\cdot|x))+\mathrm{KL}(\pi^{\star}(\cdot|x)\|\hat{\pi}_{t+1}(\cdot|x))+\mathrm{KL}(\hat{\pi}_{t+1}(\cdot|x)\|\hat{\pi}_{t}(\cdot|x))\right)+\beta\mathrm{KL}(\pi^{\star}(\cdot|x)\|\hat{\pi}_{t+1}(\cdot|x))\right]" display="inline" intent=":literal"><semantics><mrow><mo>≥</mo><mi>𝔼</mi><msub><mrow></mrow><mrow><mi>x</mi><mo>∼</mo><mi class="ltx_font_mathcaligraphic">𝒟</mi></mrow></msub><mo>[</mo><mi>η</mi><msub><mrow></mrow><mi>θ</mi></msub><mo>(</mo><mo lspace="0em">−</mo><mi>KL</mi><mo stretchy="false">(</mo><mi>π</mi><msup><mrow></mrow><mo>⋆</mo></msup><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>x</mi><mo stretchy="false">)</mo><mo lspace="0em" rspace="0.167em">∥</mo><mover accent="true"><mi>π</mi><mo>^</mo></mover><msub><mrow></mrow><mi>t</mi></msub><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>x</mi><mo stretchy="false">)</mo><mo stretchy="false">)</mo><mo>+</mo><mi>KL</mi><mo stretchy="false">(</mo><mi>π</mi><msup><mrow></mrow><mo>⋆</mo></msup><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>x</mi><mo stretchy="false">)</mo><mo lspace="0em" rspace="0.167em">∥</mo><mover accent="true"><mi>π</mi><mo>^</mo></mover><msub><mrow></mrow><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow></msub><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>x</mi><mo stretchy="false">)</mo><mo stretchy="false">)</mo><mo>+</mo><mi>KL</mi><mo stretchy="false">(</mo><mover accent="true"><mi>π</mi><mo>^</mo></mover><msub><mrow></mrow><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow></msub><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>x</mi><mo stretchy="false">)</mo><mo lspace="0em" rspace="0.167em">∥</mo><mover accent="true"><mi>π</mi><mo>^</mo></mover><msub><mrow></mrow><mi>t</mi></msub><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>x</mi><mo stretchy="false">)</mo><mo stretchy="false">)</mo><mo>)</mo><mo>+</mo><mi>β</mi><mi>KL</mi><mo stretchy="false">(</mo><mi>π</mi><msup><mrow></mrow><mo>⋆</mo></msup><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>x</mi><mo stretchy="false">)</mo><mo lspace="0em" rspace="0.167em">∥</mo><mover accent="true"><mi>π</mi><mo>^</mo></mover><msub><mrow></mrow><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow></msub><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>x</mi><mo stretchy="false">)</mo><mo stretchy="false">)</mo><mo>]</mo></mrow><annotation encoding="application/x-tex">\displaystyle\geq\mathbb{E}_{x\sim\mathcal{D}}\left[\eta_{\theta}\left(-\mathrm{KL}(\pi^{\star}(\cdot|x)\|\hat{\pi}_{t}(\cdot|x))+\mathrm{KL}(\pi^{\star}(\cdot|x)\|\hat{\pi}_{t+1}(\cdot|x))+\mathrm{KL}(\hat{\pi}_{t+1}(\cdot|x)\|\hat{\pi}_{t}(\cdot|x))\right)+\beta\mathrm{KL}(\pi^{\star}(\cdot|x)\|\hat{\pi}_{t+1}(\cdot|x))\right]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A5.Ex91Xb"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.Ex91Xb.m2" class="ltx_Math" alttext="\displaystyle{\displaystyle-\mathrm{gap}(\varepsilon_{\mathrm{approx}},p_{\min})}." display="inline" intent=":literal"><semantics><mrow><mrow><mo>−</mo><mrow><mi>gap</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>ε</mi><mi>approx</mi></msub><mo>,</mo><msub><mi>p</mi><mi>min</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle{\displaystyle-\mathrm{gap}(\varepsilon_{\mathrm{approx}},p_{\min})}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A5.SS1.p2.3" class="ltx_p">Putting a negative sign on both sides, we have</p>
<table id="A5.E56" class="ltx_equationgroup ltx_eqn_table">
<tbody>
<tr id="A5.E56X" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.E56X.m2" class="ltx_Math" alttext="\displaystyle\mathbb{E}_{x\sim\mathcal{D}}\left[\langle\pi^{\star}(\cdot|x)-\hat{\pi}_{t+1}(\cdot|x),S_{\boldsymbol{\lambda}_{t}}(x,\cdot)\rangle-\beta\left(\mathrm{KL}(\pi^{\star}(\cdot|x)\|\pi_{\mathrm{ref}}(\cdot|x))-\mathrm{KL}(\hat{\pi}_{t+1}(\cdot|x)\|\pi_{\mathrm{ref}}(\cdot|x))\right)\right]" display="inline" intent=":literal"><semantics><mrow><mi>𝔼</mi><msub><mrow></mrow><mrow><mi>x</mi><mo>∼</mo><mi class="ltx_font_mathcaligraphic">𝒟</mi></mrow></msub><mo>[</mo><mo stretchy="false">⟨</mo><mi>π</mi><msup><mrow></mrow><mo>⋆</mo></msup><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>x</mi><mo stretchy="false">)</mo><mo>−</mo><mover accent="true"><mi>π</mi><mo>^</mo></mover><msub><mrow></mrow><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow></msub><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>x</mi><mo stretchy="false">)</mo><mo>,</mo><mi>S</mi><msub><mrow></mrow><msub><mi>𝝀</mi><mi>t</mi></msub></msub><mo stretchy="false">(</mo><mi>x</mi><mo rspace="0em">,</mo><mo lspace="0em" rspace="0em">⋅</mo><mo stretchy="false">)</mo><mo stretchy="false">⟩</mo><mo>−</mo><mi>β</mi><mo>(</mo><mi>KL</mi><mo stretchy="false">(</mo><mi>π</mi><msup><mrow></mrow><mo>⋆</mo></msup><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>x</mi><mo stretchy="false">)</mo><mo lspace="0em" rspace="0.167em">∥</mo><mi>π</mi><msub><mrow></mrow><mi>ref</mi></msub><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>x</mi><mo stretchy="false">)</mo><mo stretchy="false">)</mo><mo>−</mo><mi>KL</mi><mo stretchy="false">(</mo><mover accent="true"><mi>π</mi><mo>^</mo></mover><msub><mrow></mrow><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow></msub><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>x</mi><mo stretchy="false">)</mo><mo lspace="0em" rspace="0.167em">∥</mo><mi>π</mi><msub><mrow></mrow><mi>ref</mi></msub><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>x</mi><mo stretchy="false">)</mo><mo stretchy="false">)</mo><mo>)</mo><mo>]</mo></mrow><annotation encoding="application/x-tex">\displaystyle\mathbb{E}_{x\sim\mathcal{D}}\left[\langle\pi^{\star}(\cdot|x)-\hat{\pi}_{t+1}(\cdot|x),S_{\boldsymbol{\lambda}_{t}}(x,\cdot)\rangle-\beta\left(\mathrm{KL}(\pi^{\star}(\cdot|x)\|\pi_{\mathrm{ref}}(\cdot|x))-\mathrm{KL}(\hat{\pi}_{t+1}(\cdot|x)\|\pi_{\mathrm{ref}}(\cdot|x))\right)\right]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="4" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equationgroup ltx_align_right">(56)</span></td></tr>
<tr id="A5.E56Xa" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.E56Xa.m2" class="ltx_Math" alttext="\displaystyle\leq\mathbb{E}_{x\sim\mathcal{D}}\left[\eta_{\theta}\left(\mathrm{KL}(\pi^{\star}(\cdot|x)\|\hat{\pi}_{t}(\cdot|x))-\mathrm{KL}(\pi^{\star}(\cdot|x)\|\hat{\pi}_{t+1}(\cdot|x))-\mathrm{KL}(\hat{\pi}_{t+1}(\cdot|x)\|\hat{\pi}_{t}(\cdot|x))\right)-\beta\mathrm{KL}(\pi^{\star}(\cdot|x)\|\hat{\pi}_{t+1}(\cdot|x))\right]" display="inline" intent=":literal"><semantics><mrow><mo>≤</mo><mi>𝔼</mi><msub><mrow></mrow><mrow><mi>x</mi><mo>∼</mo><mi class="ltx_font_mathcaligraphic">𝒟</mi></mrow></msub><mo>[</mo><mi>η</mi><msub><mrow></mrow><mi>θ</mi></msub><mo>(</mo><mi>KL</mi><mo stretchy="false">(</mo><mi>π</mi><msup><mrow></mrow><mo>⋆</mo></msup><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>x</mi><mo stretchy="false">)</mo><mo lspace="0em" rspace="0.167em">∥</mo><mover accent="true"><mi>π</mi><mo>^</mo></mover><msub><mrow></mrow><mi>t</mi></msub><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>x</mi><mo stretchy="false">)</mo><mo stretchy="false">)</mo><mo>−</mo><mi>KL</mi><mo stretchy="false">(</mo><mi>π</mi><msup><mrow></mrow><mo>⋆</mo></msup><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>x</mi><mo stretchy="false">)</mo><mo lspace="0em" rspace="0.167em">∥</mo><mover accent="true"><mi>π</mi><mo>^</mo></mover><msub><mrow></mrow><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow></msub><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>x</mi><mo stretchy="false">)</mo><mo stretchy="false">)</mo><mo>−</mo><mi>KL</mi><mo stretchy="false">(</mo><mover accent="true"><mi>π</mi><mo>^</mo></mover><msub><mrow></mrow><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow></msub><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>x</mi><mo stretchy="false">)</mo><mo lspace="0em" rspace="0.167em">∥</mo><mover accent="true"><mi>π</mi><mo>^</mo></mover><msub><mrow></mrow><mi>t</mi></msub><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>x</mi><mo stretchy="false">)</mo><mo stretchy="false">)</mo><mo>)</mo><mo>−</mo><mi>β</mi><mi>KL</mi><mo stretchy="false">(</mo><mi>π</mi><msup><mrow></mrow><mo>⋆</mo></msup><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>x</mi><mo stretchy="false">)</mo><mo lspace="0em" rspace="0.167em">∥</mo><mover accent="true"><mi>π</mi><mo>^</mo></mover><msub><mrow></mrow><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow></msub><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>x</mi><mo stretchy="false">)</mo><mo stretchy="false">)</mo><mo>]</mo></mrow><annotation encoding="application/x-tex">\displaystyle\leq\mathbb{E}_{x\sim\mathcal{D}}\left[\eta_{\theta}\left(\mathrm{KL}(\pi^{\star}(\cdot|x)\|\hat{\pi}_{t}(\cdot|x))-\mathrm{KL}(\pi^{\star}(\cdot|x)\|\hat{\pi}_{t+1}(\cdot|x))-\mathrm{KL}(\hat{\pi}_{t+1}(\cdot|x)\|\hat{\pi}_{t}(\cdot|x))\right)-\beta\mathrm{KL}(\pi^{\star}(\cdot|x)\|\hat{\pi}_{t+1}(\cdot|x))\right]</annotation></semantics></math></td>
