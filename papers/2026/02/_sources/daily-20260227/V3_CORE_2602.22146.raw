<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A5.Ex92Xc.m2" class="ltx_Math" alttext="\displaystyle=" display="inline" intent=":literal"><semantics><mo>=</mo><annotation encoding="application/x-tex">\displaystyle=</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.Ex92Xc.m3" class="ltx_Math" alttext="\displaystyle\|\boldsymbol{\lambda}_{t}-\boldsymbol{\lambda}_{t-1}\|_{1}\max_{j}\left\|R_{j}(x,\cdot)\right\|_{\infty}\quad\text{(by definition of 1-norm)}" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mrow><mo stretchy="false">‖</mo><mrow><msub><mi>𝝀</mi><mi>t</mi></msub><mo>−</mo><msub><mi>𝝀</mi><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow></msub></mrow><mo stretchy="false">‖</mo></mrow><mn>1</mn></msub><mo lspace="0.167em" rspace="0em">​</mo><munder><mi>max</mi><mi>j</mi></munder><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo>‖</mo><mrow><msub><mi>R</mi><mi>j</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo rspace="0em">,</mo><mo lspace="0em" rspace="0em">⋅</mo><mo stretchy="false">)</mo></mrow></mrow><mo>‖</mo></mrow><mi mathvariant="normal">∞</mi></msub></mrow><mspace style="width:1em;" width="1em"></mspace><mtext>(by definition of 1-norm)</mtext></mrow><annotation encoding="application/x-tex">\displaystyle\|\boldsymbol{\lambda}_{t}-\boldsymbol{\lambda}_{t-1}\|_{1}\max_{j}\left\|R_{j}(x,\cdot)\right\|_{\infty}\quad\text{(by definition of 1-norm)}</annotation></semantics></math></td>
