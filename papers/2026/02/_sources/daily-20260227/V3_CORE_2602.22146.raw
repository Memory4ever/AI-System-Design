<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.Ex102Xe.m2" class="ltx_Math" alttext="\displaystyle{\displaystyle+2\mathrm{gap}(\varepsilon_{\mathrm{approx}},p_{\min})}," display="inline" intent=":literal"><semantics><mrow><mrow><mo>+</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>gap</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>ε</mi><mi>approx</mi></msub><mo>,</mo><msub><mi>p</mi><mi>min</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle{\displaystyle+2\mathrm{gap}(\varepsilon_{\mathrm{approx}},p_{\min})},</annotation></semantics></math></td>
