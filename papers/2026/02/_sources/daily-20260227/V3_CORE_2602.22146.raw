<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A5.Ex92Xd.m2" class="ltx_Math" alttext="\displaystyle\leq" display="inline" intent=":literal"><semantics><mo>≤</mo><annotation encoding="application/x-tex">\displaystyle\leq</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.Ex92Xd.m3" class="ltx_Math" alttext="\displaystyle\|\boldsymbol{\lambda}_{t}-\boldsymbol{\lambda}_{t-1}\|_{1}R_{\max}" display="inline" intent=":literal"><semantics><mrow><msub><mrow><mo stretchy="false">‖</mo><mrow><msub><mi>𝝀</mi><mi>t</mi></msub><mo>−</mo><msub><mi>𝝀</mi><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow></msub></mrow><mo stretchy="false">‖</mo></mrow><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>R</mi><mi>max</mi></msub></mrow><annotation encoding="application/x-tex">\displaystyle\|\boldsymbol{\lambda}_{t}-\boldsymbol{\lambda}_{t-1}\|_{1}R_{\max}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A5.Ex92Xe"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.Ex92Xe.m2" class="ltx_Math" alttext="\displaystyle\text{(by \lx@cref{creftype~refnum}{assump:bounded} that $R_{j}(x,y)\leq R_{\max}$ for any $j\in\mathcal{S}\cup\mathcal{H}$ and $(x,y)$ pair).}" display="inline" intent=":literal"><semantics><mrow><mtext>(by </mtext><mtext><a href="#S3.Thmtheorem2" title="Assumption 3.2 (Bounded rewards). ‣ 3.1 OPD in Distribution Space ‣ 3 Optimistic Primal–Dual Method ‣ Provable Last-Iterate Convergence for Multi-Objective Safe LLM Alignment via Optimistic Primal-Dual" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Assumption</span> <span class="ltx_text ltx_ref_tag">3.2</span></a></mtext><mtext> that </mtext><mrow><mrow><msub><mi>R</mi><mi>j</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>y</mi><mo stretchy="false">)</mo></mrow></mrow><mo>≤</mo><msub><mi>R</mi><mi>max</mi></msub></mrow><mtext> for any </mtext><mrow><mi>j</mi><mo>∈</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒮</mi><mo>∪</mo><mi class="ltx_font_mathcaligraphic">ℋ</mi></mrow></mrow><mtext> and </mtext><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>y</mi><mo stretchy="false">)</mo></mrow><mtext> pair).</mtext></mrow><annotation encoding="application/x-tex">\displaystyle\text{(by \lx@cref{creftype~refnum}{assump:bounded} that $R_{j}(x,y)\leq R_{\max}$ for any $j\in\mathcal{S}\cup\mathcal{H}$ and $(x,y)$ pair).}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A5.SS1.p3.7" class="ltx_p"><math id="A5.SS1.p3.m13" class="ltx_Math" alttext="(c)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi>c</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(c)</annotation></semantics></math> is because</p>
