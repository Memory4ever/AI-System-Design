<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex59Xd.m3" class="ltx_Math" alttext="\displaystyle\|\boldsymbol{\lambda}_{t}-\boldsymbol{\lambda}_{t-1}\|_{1}R_{\max}" display="inline" intent=":literal"><semantics><mrow><msub><mrow><mo stretchy="false">‖</mo><mrow><msub><mi>𝝀</mi><mi>t</mi></msub><mo>−</mo><msub><mi>𝝀</mi><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow></msub></mrow><mo stretchy="false">‖</mo></mrow><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>R</mi><mi>max</mi></msub></mrow><annotation encoding="application/x-tex">\displaystyle\|\boldsymbol{\lambda}_{t}-\boldsymbol{\lambda}_{t-1}\|_{1}R_{\max}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
