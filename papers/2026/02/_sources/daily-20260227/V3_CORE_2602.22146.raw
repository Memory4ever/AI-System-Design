<tr id="A3.E36Xa" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.E36Xa.m2" class="ltx_Math" alttext="\displaystyle+\eta_{\theta}\mathrm{KL}(\hat{\pi}_{t+1}(\cdot|x)\|\hat{\pi}_{t}(\cdot|x))-(\eta_{\theta}+\beta)\mathrm{KL}(\hat{\pi}_{t+1}(\cdot|x)\|\pi_{t}(\cdot|x))-\eta_{\theta}\mathrm{KL}(\pi_{t}(\cdot|x)\|\hat{\pi}_{t}(\cdot|x))" display="inline" intent=":literal"><semantics><mrow><mo>+</mo><mi>η</mi><msub><mrow></mrow><mi>θ</mi></msub><mi>KL</mi><mo stretchy="false">(</mo><mover accent="true"><mi>π</mi><mo>^</mo></mover><msub><mrow></mrow><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow></msub><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>x</mi><mo stretchy="false">)</mo><mo lspace="0em" rspace="0.167em">∥</mo><mover accent="true"><mi>π</mi><mo>^</mo></mover><msub><mrow></mrow><mi>t</mi></msub><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>x</mi><mo stretchy="false">)</mo><mo stretchy="false">)</mo><mo>−</mo><mo stretchy="false">(</mo><mi>η</mi><msub><mrow></mrow><mi>θ</mi></msub><mo>+</mo><mi>β</mi><mo stretchy="false">)</mo><mi>KL</mi><mo stretchy="false">(</mo><mover accent="true"><mi>π</mi><mo>^</mo></mover><msub><mrow></mrow><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow></msub><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>x</mi><mo stretchy="false">)</mo><mo lspace="0em" rspace="0.167em">∥</mo><mi>π</mi><msub><mrow></mrow><mi>t</mi></msub><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>x</mi><mo stretchy="false">)</mo><mo stretchy="false">)</mo><mo>−</mo><mi>η</mi><msub><mrow></mrow><mi>θ</mi></msub><mi>KL</mi><mo stretchy="false">(</mo><mi>π</mi><msub><mrow></mrow><mi>t</mi></msub><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>x</mi><mo stretchy="false">)</mo><mo lspace="0em" rspace="0.167em">∥</mo><mover accent="true"><mi>π</mi><mo>^</mo></mover><msub><mrow></mrow><mi>t</mi></msub><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>x</mi><mo stretchy="false">)</mo><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">\displaystyle+\eta_{\theta}\mathrm{KL}(\hat{\pi}_{t+1}(\cdot|x)\|\hat{\pi}_{t}(\cdot|x))-(\eta_{\theta}+\beta)\mathrm{KL}(\hat{\pi}_{t+1}(\cdot|x)\|\pi_{t}(\cdot|x))-\eta_{\theta}\mathrm{KL}(\pi_{t}(\cdot|x)\|\hat{\pi}_{t}(\cdot|x))</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr>
<tr id="A3.E36Xb" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.E36Xb.m2" class="ltx_Math" alttext="\displaystyle\left.+C\mathrm{KL}(\hat{\pi}_{t+1}(\cdot|x)\|\pi_{t}(\cdot|x))+\frac{|\mathcal{H}|R_{\max}^{2}}{C}\left(\|\boldsymbol{\lambda}_{t}-\hat{\boldsymbol{\lambda}}_{t}\|_{2}^{2}+\|\hat{\boldsymbol{\lambda}}_{t}-\boldsymbol{\lambda}_{t-1}\|_{2}^{2}\right)\right]" display="inline" intent=":literal"><semantics><mrow><mo>+</mo><mi>C</mi><mi>KL</mi><mo stretchy="false">(</mo><mover accent="true"><mi>π</mi><mo>^</mo></mover><msub><mrow></mrow><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow></msub><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>x</mi><mo stretchy="false">)</mo><mo lspace="0em" rspace="0.167em">∥</mo><mi>π</mi><msub><mrow></mrow><mi>t</mi></msub><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>x</mi><mo stretchy="false">)</mo><mo stretchy="false">)</mo><mo>+</mo><mstyle displaystyle="true"><mfrac><mrow><mrow><mo stretchy="false">|</mo><mi class="ltx_font_mathcaligraphic">ℋ</mi><mo stretchy="false">|</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>R</mi><mi>max</mi><mn>2</mn></msubsup></mrow><mi>C</mi></mfrac></mstyle><mo>(</mo><mo lspace="0em" rspace="0.167em">∥</mo><mi>𝝀</mi><msub><mrow></mrow><mi>t</mi></msub><mo>−</mo><mover accent="true"><mi>𝝀</mi><mo>^</mo></mover><msub><mrow></mrow><mi>t</mi></msub><mo lspace="0em" rspace="0em">∥</mo><msub><mrow></mrow><mn>2</mn></msub><msup><mrow></mrow><mn>2</mn></msup><mo lspace="0em" rspace="0em">+</mo><mo lspace="0em" rspace="0.167em">∥</mo><mover accent="true"><mi>𝝀</mi><mo>^</mo></mover><msub><mrow></mrow><mi>t</mi></msub><mo>−</mo><mi>𝝀</mi><msub><mrow></mrow><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow></msub><mo lspace="0em" rspace="0.167em">∥</mo><msub><mrow></mrow><mn>2</mn></msub><msup><mrow></mrow><mn>2</mn></msup><mo>)</mo><mo>]</mo></mrow><annotation encoding="application/x-tex">\displaystyle\left.+C\mathrm{KL}(\hat{\pi}_{t+1}(\cdot|x)\|\pi_{t}(\cdot|x))+\frac{|\mathcal{H}|R_{\max}^{2}}{C}\left(\|\boldsymbol{\lambda}_{t}-\hat{\boldsymbol{\lambda}}_{t}\|_{2}^{2}+\|\hat{\boldsymbol{\lambda}}_{t}-\boldsymbol{\lambda}_{t-1}\|_{2}^{2}\right)\right]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr>
<tr id="A3.E36Xc" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
