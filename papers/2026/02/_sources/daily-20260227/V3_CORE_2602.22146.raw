<tr id="A5.E57X" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.E57X.m2" class="ltx_Math" alttext="\displaystyle\mathbb{E}_{x\sim\mathcal{D}}\left[\langle\hat{\pi}_{t+1}(\cdot|x)-\pi_{t}(\cdot|x),S_{\boldsymbol{\lambda}_{t-1}}(x,\cdot)\rangle-\beta\left(\mathrm{KL}(\hat{\pi}_{t+1}(\cdot|x)\|\pi_{\mathrm{ref}}(\cdot|x))-\mathrm{KL}(\pi_{t}(\cdot|x)\|\pi_{\mathrm{ref}}(\cdot|x))\right)\right]" display="inline" intent=":literal"><semantics><mrow><mi>𝔼</mi><msub><mrow></mrow><mrow><mi>x</mi><mo>∼</mo><mi class="ltx_font_mathcaligraphic">𝒟</mi></mrow></msub><mo>[</mo><mo stretchy="false">⟨</mo><mover accent="true"><mi>π</mi><mo>^</mo></mover><msub><mrow></mrow><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow></msub><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>x</mi><mo stretchy="false">)</mo><mo>−</mo><mi>π</mi><msub><mrow></mrow><mi>t</mi></msub><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>x</mi><mo stretchy="false">)</mo><mo>,</mo><mi>S</mi><msub><mrow></mrow><msub><mi>𝝀</mi><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow></msub></msub><mo stretchy="false">(</mo><mi>x</mi><mo rspace="0em">,</mo><mo lspace="0em" rspace="0em">⋅</mo><mo stretchy="false">)</mo><mo stretchy="false">⟩</mo><mo>−</mo><mi>β</mi><mo>(</mo><mi>KL</mi><mo stretchy="false">(</mo><mover accent="true"><mi>π</mi><mo>^</mo></mover><msub><mrow></mrow><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow></msub><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>x</mi><mo stretchy="false">)</mo><mo lspace="0em" rspace="0.167em">∥</mo><mi>π</mi><msub><mrow></mrow><mi>ref</mi></msub><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>x</mi><mo stretchy="false">)</mo><mo stretchy="false">)</mo><mo>−</mo><mi>KL</mi><mo stretchy="false">(</mo><mi>π</mi><msub><mrow></mrow><mi>t</mi></msub><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>x</mi><mo stretchy="false">)</mo><mo lspace="0em" rspace="0.167em">∥</mo><mi>π</mi><msub><mrow></mrow><mi>ref</mi></msub><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>x</mi><mo stretchy="false">)</mo><mo stretchy="false">)</mo><mo>)</mo><mo>]</mo></mrow><annotation encoding="application/x-tex">\displaystyle\mathbb{E}_{x\sim\mathcal{D}}\left[\langle\hat{\pi}_{t+1}(\cdot|x)-\pi_{t}(\cdot|x),S_{\boldsymbol{\lambda}_{t-1}}(x,\cdot)\rangle-\beta\left(\mathrm{KL}(\hat{\pi}_{t+1}(\cdot|x)\|\pi_{\mathrm{ref}}(\cdot|x))-\mathrm{KL}(\pi_{t}(\cdot|x)\|\pi_{\mathrm{ref}}(\cdot|x))\right)\right]</annotation></semantics></math></td>
